// jingping.c 罗汉堂 静平

inherit NPC;
inherit F_MASTER;

void create() {
  set_name("静平", ({ "jing ping master", "jing ping", "master", }));
  set("long",
    "这是一位高大魁梧的僧人，象一座铁塔站在那里。\n"
  );


  set("gender", "男性");
  set("attitude", "heroism");
  set("class", "shaolin");

  set("inquiry", ([
    "明晦大师": "明晦大师你都不知道？他是我的师傅，是[达摩院]首座！\n",
    "智下": "你说智下呀，他是我的得意弟子，主持悟道堂。\n",
  ]));

  set("age", 50);

  set("max_gin", 1000);
  set("max_kee", 2500);
  set("max_sen", 1000);
  set("force", 6000);
  set("max_force", 3000);
  set("force_factor", 100);
  set("combat_exp", 4000000);


  set_skill("force", 200);
  set_skill("damo-force", 200);
  set_skill("dodge", 200);
  set_skill("shaolin-dodge", 200);
  set_skill("yecha_stick", 200);
  set_skill("stick", 200);
  set_skill("boluo_strike", 200);
  set_skill("parry", 200);
  set_skill("unarmed", 200);
  set_skill("blade", 200);
  set_skill("sword", 200);

  set_skill("essencemagic", 90);
  set_skill("buddhism", 180);
  set_skill("magic", 90);
  set_skill("literate", 90);
  set_skill("zuochanshu", 90);

  map_skill("force", "damo-force");
  map_skill("dodge", "shaolin-dodge");
  map_skill("stick", "yecha_stick");
  map_skill("unarmed", "boluo_strike");


  set("title", "少林寺罗汉堂首座");
  create_family("少林寺", 5, "弟子");
  set("no_teach", 1);
  set("family/privs", 1);

  setup();
  carry_object(__DIR__ "weapon/stick")->wield();
  carry_object(__DIR__ "obj/qing_jiasha")->wear();
}

void die() {
  int exp, pot, score;
  object killer, victim;

  if (!killer = query_temp("last_damage_from"))
    killer = this_player(1);

  if (!victim) victim = this_object();

  if (!userp(victim) && victim->query("NKreward_MASTER")) {
    exp = random(victim->query("combat_exp") - killer->query("combat_exp")) / 100;
    pot = random(exp) / 2;
    if (exp <= 0) exp = 20;
    if (pot <= 0) pot = 10;
    if (exp > 2000) exp = 2000;
    if (pot > 1000) pot = 1000;
    score = random(pot / 100) + 1;
    if (killer->query("id_type") != victim->query("id_type")) {
      killer->add("combat_exp", exp);
      killer->add("potential", pot);
      killer->add("life_exp", score);
      killer->add("score", score);
      tell_object(killer, HIY "你获得了：\n" +
        chinese_number(exp) + "点经验\n" +
        chinese_number(pot) + "点潜能\n" +
        chinese_number(score) + "点江湖阅历\n" +
        chinese_number(score) + "点声望\n" NOR);
    }
  }
  ::die();
}
