// magic_weapon  created by Baiwt@Sjpl 07/11/1999

#include <ansi.h>
#include <weapon.h>

inherit WHIP;

void create() {
  string *order1 = ({ "神圣", "荣耀", "祝福", "凯旋", "幻影", "乙木", "空明",
    "正义", "胜利", "蟒蛇", "巨龙", "火焰", "神水", "土行", "天雷", "地狱", "太古", "追风" });
  string *order2 = ({ "珊瑚", "玄丝", "金铃", "精钢", "水晶",
    "玉石", "翡翠", "五金", "紫檀", "乌蚕" });
  string *order3 = ({ "云帚", "拂尘", "软索", "锦绳", "长鞭",
    "软鞭", "降龙锁", "皮鞭", "九节鞭" });
  set_name(
    HIC + order1[random(17)] + HIY + order2[random(9)] + order3[random(8)] + NOR,
    ({ "whip" })
  );
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "条");
    set("m_ap_rank", 8);
    set("m_dp_rank", 8);
    set("value", random(8) * random(100) * 100 + 1000);
    set("material", "skin");
  }
  init_whip(random(90) + 10);

  set("wield_msg", "$N从腰间摸出一条$n握在手中。\n");
  set("unwield_msg", "$N将手中的$n束在腰间。\n");

  setup();
}
