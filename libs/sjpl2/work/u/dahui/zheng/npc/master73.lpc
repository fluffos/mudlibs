// eleventh npc by poor

#include <ansi.h>
inherit NPC;

void create() {
  set_name("神光", ({ "shen guang", "shen", "guang" }));
  set("gender", "男性");
  set("title", "丐帮长老");
  set("nickname", HIY "飘渺神僧" NOR);
  set("age", 65);
  set("long",
    "他本是位高僧，后因为对老帮主的景仰加入了丐帮，但是现在他武功全失。\n");
  set("inquiry", ([
    "拜师": "想拜我为师？我怎么干当呢？",
    "污衣帮": "随便说是要死人的。",
    "加入污衣帮": "你没开玩笑吧。",
    "老帮主": "哎，老帮主已经失踪多年。但是..........",
    "商殷宝藏": "这宝藏里有什么谁都不知道，但是已经流传很久了。",
    "商殷藏宝图": "我的好友刘长老已经去找地图了。",
    "翡翠匕首": "我的功夫就是被这柄匕首废的，刘长老说：老帮主的失踪和匕首有关。",
  ]));
  set("chat_chance", 1);
  set("chat_msg", ({
    "神光叹了口气，说道：师祖总说我悟不到无我的境界，无我到底是什么境界呢？\n",
    "神光自言自语道：商殷宝藏不知道害死了多少人。\n",
    "神光说道：刘长老上次来说，他已经打探到老帮主的踪迹了。\n",
  }));
  set("str", 36);
  set("max_kee", 4000);
  set("kee", 4000);
  set("force", 3000);
  set("max_force", 3000);
  set("force_factor", 100);
  set("combat_exp", 500000);

  set_skill("unarmed", 200);
  set_skill("force", 200);
  set_skill("parry", 200);
  set_skill("dodge", 200);
  set_skill("begging", 200);
  set_skill("xianglong_strike", 180);
  set_skill("sanhua-strike", 200);
  set_skill("stick", 200);
  set_skill("yecha_stick", 200);

  set_skill("hidden_dodge", 200);
  set_skill("canyun_force", 200);
  set_skill("literate", 180);

  map_skill("dodge", "hidden_dodge");
  map_skill("unarmed", "xianglong_strike");
  map_skill("force", "canyun_force");

  create_family("丐帮污衣帮", 2, "弟子");

  setup();

  carry_object(__DIR__ "obj/wuyi")->wear();
}

void die() {
  int exp, pot, score;
  object killer, victim;

  if (!killer = query_temp("last_damage_from"))
    killer = this_player(1);

  if (!victim) victim = this_object();

  if (!userp(victim) && victim->query("NKreward_MASTER")) {
    exp = random(victim->query("combat_exp") - killer->query("combat_exp")) / 100;
    pot = random(exp) / 2;
    if (exp <= 0) exp = 20;
    if (pot <= 0) pot = 10;
    if (exp > 2000) exp = 2000;
    if (pot > 1000) pot = 1000;
    score = random(pot / 100) + 1;
    if (killer->query("id_type") != victim->query("id_type")) {
      killer->add("combat_exp", exp);
      killer->add("potential", pot);
      killer->add("life_exp", score);
      killer->add("score", score);
      tell_object(killer, HIY "你获得了：\n" +
        chinese_number(exp) + "点经验\n" +
        chinese_number(pot) + "点潜能\n" +
        chinese_number(score) + "点江湖阅历\n" +
        chinese_number(score) + "点声望\n" NOR);
    }
  }
  ::die();
}
