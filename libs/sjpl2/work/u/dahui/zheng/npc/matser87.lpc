//sunbuer.c 孙不二

#include <ansi.h>
inherit NPC;
void create() {
  set_name("孙不二", ({ "sun buer", "sun", "buer" }));
  set("nickname", HIR "清静散人" NOR);
  set("gender", "女性");
  set("age", 39);
  set("long",
    "她明目皓齿，肤色白腻，虽穿一身灰色道袍，也掩盖不了她的姿色。\n"
    "她就是全真七子中唯一的女性“清静散人”孙不二。\n");
  set("attitude", "friendly");
  set("class", "quanzhen");


  set("chat_chance", 1);
  set("chat_msg", ({
    "孙不二说道：“非本教弟子不要乱走。”\n",
  }));

  set("max_gin", 4200);
  set("max_kee", 4500);
  set("max_sen", 4200);
  set("force", 4000);
  set("max_force", 4000);
  set("force_factor", 300);
  set("combat_exp", 4500000);

  set_skill("force", 130);             // 基本内功
  set_skill("ziliu-force", 130);    //
  set_skill("unarmed", 130);           // 基本拳脚
  set_skill("tiangang-quanfa", 130);
  set_skill("dodge", 150);            // 基本躲闪
  set_skill("qixing-huanwei", 140);        //七星换位
  set_skill("parry", 160);             // 基本招架
  set_skill("sword", 130);             // 基本剑法
  set_skill("quanzhen-jian", 130);        //全真剑法 
  set_skill("daoxue-xinfa", 130);            //道学心法  
  set_skill("literate", 120);           //读书写字  

  map_skill("force", "ziliu-force");
  map_skill("unarmed", "tiangang-quanfa");
  map_skill("dodge", "qixing-huanwei");
  map_skill("parry", "quanzhen-jian");
  map_skill("sword", "quanzhen-jian");


  create_family("全真教", 2, "长老");

  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "qixinggongyue" :),
    (: exert_function, "recover" :),
  }));

  set("wan_count", 2 + random(2));
  set("dan_count", 2 + random(2));
  setup();
  carry_object(__DIR__ "weapon/sword")->wield();
  carry_object(__DIR__ "obj/greyrobe")->wear();

}

void die() {
  int exp, pot, score;
  object killer, victim;

  if (!killer = query_temp("last_damage_from"))
    killer = this_player(1);

  if (!victim) victim = this_object();

  if (!userp(victim) && victim->query("NKreward_MASTER")) {
    exp = random(victim->query("combat_exp") - killer->query("combat_exp")) / 100;
    pot = random(exp) / 2;
    if (exp <= 0) exp = 20;
    if (pot <= 0) pot = 10;
    if (exp > 2000) exp = 2000;
    if (pot > 1000) pot = 1000;
    score = random(pot / 100) + 1;
    if (killer->query("id_type") != victim->query("id_type")) {
      killer->add("combat_exp", exp);
      killer->add("potential", pot);
      killer->add("life_exp", score);
      killer->add("score", score);
      tell_object(killer, HIY "你获得了：\n" +
        chinese_number(exp) + "点经验\n" +
        chinese_number(pot) + "点潜能\n" +
        chinese_number(score) + "点江湖阅历\n" +
        chinese_number(score) + "点声望\n" NOR);
    }
  }
  ::die();
}
