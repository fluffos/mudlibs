#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create() {
  set_name("铁肩道人", ({ "master tiejian", "tiejian", "master" }));
  set("title", "青城派掌门");
  set("gender", "男性");
  set("age", 66);
  //	set("nickname", HIG "" NOR);
  set("long",
    "铁肩道人是青城派第四代掌门，在五大门派中威望颇高。\n");
  set("attitude", "peaceful");
  set("str", 30);
  set("int", 30);
  set("cor", 30);
  set("spi", 30);
  set("max_kee", 2000);
  set("max_gin", 2000);
  set("max_sen", 2000);
  set("kee", 2000);
  set("gin", 2000);
  set("sen", 2000);

  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 20);

  set("combat_exp", 7000000);
  set("score", 50000);

  set_temp("apply/attack", 30);
  set_temp("apply/defense", 30);
  set_temp("apply/move", 30);

  set_skill("dodge", 190);
  set_skill("move", 190);
  set_skill("literate", 200);
  set_skill("parry", 190);
  set_skill("unarmed", 190);
  set_skill("force", 190);
  set_skill("sword", 200);
  set_skill("dormancy", 200);

  set_skill("rain_sword", 200);
  set_skill("rain_strike", 190);
  set_skill("siri_force", 190);
  set_skill("five-steps", 180);

  map_skill("dodge", "five-steps");
  map_skill("unarmed", "rain_strike");
  map_skill("force", "siri_force");
  map_skill("parry", "rain_sword");
  map_skill("sword", "rain_sword");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "sword.pangtuo" :),
  }));

  create_family("青城派", 4, "掌门");
  set("class", "qingcheng");

  setup();
  carry_object(__DIR__ "weapon/sword")->wield();
  carry_object(__DIR__ "obj/daopao")->wear();
}
void die() {
  int exp, pot, score;
  object killer, victim;

  if (!killer = query_temp("last_damage_from"))
    killer = this_player(1);

  if (!victim) victim = this_object();

  if (!userp(victim) && victim->query("NKreward_MASTER")) {
    exp = random(victim->query("combat_exp") - killer->query("combat_exp")) / 100;
    pot = random(exp) / 2;
    if (exp <= 0) exp = 20;
    if (pot <= 0) pot = 10;
    if (exp > 2000) exp = 2000;
    if (pot > 1000) pot = 1000;
    score = random(pot / 100) + 1;
    if (killer->query("id_type") != victim->query("id_type")) {
      killer->add("combat_exp", exp);
      killer->add("potential", pot);
      killer->add("life_exp", score);
      killer->add("score", score);
      tell_object(killer, HIY "你获得了：\n" +
        chinese_number(exp) + "点经验\n" +
        chinese_number(pot) + "点潜能\n" +
        chinese_number(score) + "点江湖阅历\n" +
        chinese_number(score) + "点声望\n" NOR);
    }
  }
  ::die();
}
