// bailiyun.c
#include <ansi.h>
inherit NPC;

void create() {
  set_name("百里云", ({ "baili yun", "yun", "baili" }));
  set("gender", "男性");
  set("age", 49);
  set("nickname", HIG "剑痴" NOR);
  set("long", @LONG
百里云是莫天雄的师弟，据说是华山使剑的第一高手，一生浸淫于剑
术之中，除此之外别无所爱，故人称剑痴。
LONG
  );
  set("attitude", "peaceful");
  set("int", 25);
  set("cor", 25);
  set("agi", 25);
  set("con", 20);
  set("str", 20);
  set("tol", 20);
  set("spi", 20);
  set("dur", 20);
  set("per", 30);
  set("fle", 20);
  set("cps", 20);
  set("max_force", 2800);
  set("force", 4000);
  set("force_factor", 120);
  set("combat_exp", 2000000);
  set("score", 70000);
  //      set("daode", 49000);

  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "sword.taiyue" :),
  }));
  set_skill("dodge", 150);
  set_skill("parry", 150);
  set_skill("sword", 250);
  set_skill("force", 150);
  set_skill("unarmed", 40);
  set_skill("literate", 20);
  set_skill("hs-zhengqi", 100);
  set_skill("huashan-force", 200);
  set_skill("zixia-shengong", 150);
  set_skill("huashan-sword", 250);
  set_skill("huashan-strike", 70);
  set_skill("tianluo-steps", 150);

  map_skill("sword", "huashan-sword");
  map_skill("parry", "huashan-sword");
  map_skill("force", "zixia-shengong");
  map_skill("unarmed", "huashan-strike");
  map_skill("dodge", "tianluo-steps");
  set("perform/huashan/taiyue", 3000);     //perform lvl = 3

  create_family("华山派", 15, "长老");

  setup();
  carry_object(__DIR__ "weapon/sword");
  carry_object(__DIR__ "obj/jinzhuang")->wear();
}
void die() {
  int exp, pot, score;
  object killer, victim;

  if (!killer = query_temp("last_damage_from"))
    killer = this_player(1);

  if (!victim) victim = this_object();

  if (!userp(victim) && victim->query("NKreward_MASTER")) {
    exp = random(victim->query("combat_exp") - killer->query("combat_exp")) / 100;
    pot = random(exp) / 2;
    if (exp <= 0) exp = 20;
    if (pot <= 0) pot = 10;
    if (exp > 2000) exp = 2000;
    if (pot > 1000) pot = 1000;
    score = random(pot / 100) + 1;
    if (killer->query("id_type") != victim->query("id_type")) {
      killer->add("combat_exp", exp);
      killer->add("potential", pot);
      killer->add("life_exp", score);
      killer->add("score", score);
      tell_object(killer, HIY "你获得了：\n" +
        chinese_number(exp) + "点经验\n" +
        chinese_number(pot) + "点潜能\n" +
        chinese_number(score) + "点江湖阅历\n" +
        chinese_number(score) + "点声望\n" NOR);
    }
  }
  ::die();
}
