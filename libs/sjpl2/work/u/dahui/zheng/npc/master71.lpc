// twelvth npc by poor

#include <ansi.h>
inherit NPC;

void create() {
  set_name("肖空鸣", ({ "xiao mingkong", "master", "xiao" }));
  set("gender", "男性");
  set("title", "丐帮执法长老");
  set("nickname", WHT "铁面艺人" NOR);
  set("age", 65);
  set("long",
    "他就是丐帮的执法长老，石海风的师弟，对于犯帮规的丐帮弟子都是严惩不待。\n");
  set("inquiry", ([
    "拜师": "想拜我为师？我怎么干当呢？",
    "污衣帮": "随便说是要死人的。",
    "加入污衣帮": "你没开玩笑吧。",
    "穿污衣，行侠义": (: ask_me :),
    "升级": (: ask_me1 :),
    "key": (: ask_key :),
    "钥匙": (: ask_key :),
    "老帮主": "哎，老帮主已经失踪多年。",
  ]));
  set("chat_chance", 1);
  set("chat_msg", ({
    "肖鸣空自言自语道：老帮主留下的这把钥匙有什么用呢？\n",
  }));
  set("str", 36);
  set("max_kee", 5000);
  set("kee", 5000);
  set("force", 4000);
  set("max_force", 4000);
  set("force_factor", 150);
  set("combat_exp", 800000);

  set_skill("unarmed", 220);
  set_skill("force", 220);
  set_skill("parry", 220);
  set_skill("dodge", 220);
  set_skill("begging", 220);
  set_skill("xianglong_strike", 200);
  set_skill("hitdog_stick", 220);
  set_skill("stick", 220);
  set_skill("qingyun_stick", 220);
  set_skill("iron_strike", 220);

  set_skill("hitdog_zhen", 50);
  set_skill("hidden_dodge", 200);
  set_skill("canyun_force", 200);
  set_skill("literate", 200);

  map_skill("dodge", "hidden_dodge");
  map_skill("unarmed", "xianglong_strike");
  map_skill("force", "canyun_force");
  map_skill("stick", "hitdog_stick");
  map_skill("parry", "hitdog_stick");

  create_family("丐帮污衣帮", 2, "弟子");

  setup();

  carry_object(__DIR__ "obj/wuyi")->wear();
  carry_object(__DIR__ "weapon/stick")->wield();
}

void die() {
  int exp, pot, score;
  object killer, victim;

  if (!killer = query_temp("last_damage_from"))
    killer = this_player(1);

  if (!victim) victim = this_object();

  if (!userp(victim) && victim->query("NKreward_MASTER")) {
    exp = random(victim->query("combat_exp") - killer->query("combat_exp")) / 100;
    pot = random(exp) / 2;
    if (exp <= 0) exp = 20;
    if (pot <= 0) pot = 10;
    if (exp > 2000) exp = 2000;
    if (pot > 1000) pot = 1000;
    score = random(pot / 100) + 1;
    if (killer->query("id_type") != victim->query("id_type")) {
      killer->add("combat_exp", exp);
      killer->add("potential", pot);
      killer->add("life_exp", score);
      killer->add("score", score);
      tell_object(killer, HIY "你获得了：\n" +
        chinese_number(exp) + "点经验\n" +
        chinese_number(pot) + "点潜能\n" +
        chinese_number(score) + "点江湖阅历\n" +
        chinese_number(score) + "点声望\n" NOR);
    }
  }
  ::die();
}
