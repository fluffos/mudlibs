// zhishang.c 证道院 智上

inherit NPC;
inherit F_MASTER;

void create() {
  set_name("智上", ({ "zhi shang master", "zhi shang", "master", }));
  set("long",
    "这是一位慈眉善目的老僧，令人倍感亲切。\n"
  );


  set("gender", "男性");
  set("attitude", "heroism");
  set("class", "shaolin1");

  set("inquiry", ([
    "静思大师": "静思大师你都不知道？他是我的师傅，是[菩提院]首座！\n",
    "虚方": "你说虚方呀，他是我的得意弟子，主持藏经阁。\n",
  ]));

  set("age", 50);

  set("max_gin", 800);
  set("max_kee", 2000);
  set("max_sen", 800);
  set("force", 5000);
  set("max_force", 3000);
  set("force_factor", 80);
  set("combat_exp", 3000000);

  set_skill("force", 180);
  set_skill("shaoyang_force", 180);
  set_skill("dodge", 180);
  set_skill("shaolin-dodge", 180);
  set_skill("yecha_stick", 180);
  set_skill("nianhua-zhi", 180);
  set_skill("parry", 180);
  set_skill("unarmed", 180);
  set_skill("hammer", 180);
  set_skill("stick", 180);

  set_skill("zuochanshu", 80);
  set_skill("buddhism", 160);
  set_skill("magic", 80);
  set_skill("literate", 80);

  map_skill("force", "shaoyang_force");
  map_skill("dodge", "shaolin-dodge");
  map_skill("unarmed", "nianhua-zhi");

  set("title", "少林寺证道院首座");
  create_family("少林寺", 6, "弟子");
  set("no_teach", 1);
  set("family/privs", 1);

  setup();

  carry_object(__DIR__ "obj/qing_jiasha")->wear();
}

void die() {
  int exp, pot, score;
  object killer, victim;

  if (!killer = query_temp("last_damage_from"))
    killer = this_player(1);

  if (!victim) victim = this_object();

  if (!userp(victim) && victim->query("NKreward_MASTER")) {
    exp = random(victim->query("combat_exp") - killer->query("combat_exp")) / 100;
    pot = random(exp) / 2;
    if (exp <= 0) exp = 20;
    if (pot <= 0) pot = 10;
    if (exp > 2000) exp = 2000;
    if (pot > 1000) pot = 1000;
    score = random(pot / 100) + 1;
    if (killer->query("id_type") != victim->query("id_type")) {
      killer->add("combat_exp", exp);
      killer->add("potential", pot);
      killer->add("life_exp", score);
      killer->add("score", score);
      tell_object(killer, HIY "你获得了：\n" +
        chinese_number(exp) + "点经验\n" +
        chinese_number(pot) + "点潜能\n" +
        chinese_number(score) + "点江湖阅历\n" +
        chinese_number(score) + "点声望\n" NOR);
    }
  }
  ::die();
}
