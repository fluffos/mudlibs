#include <ansi.h>
inherit NPC;
void create() {
  set_name("裘剑飞", ({ "master qiu", "qiu jianfei", "master", "qiu" }));
  set("title", "泰山派掌门");
  set("gender", "男性");
  set("age", 26);
  set("nickname", HIC "满天星云" NOR);
  set("long",
    "裘剑飞是三侠剑子之一，年纪青青就当上了泰山派第一代掌门，是当今武林最出类拔萃的新人。\n");
  set("attitude", "peaceful");
  set("str", 30);
  set("int", 30);
  set("cor", 30);
  set("spi", 30);
  set("max_kee", 2000);
  set("max_gin", 2000);
  set("max_sen", 2000);
  set("kee", 2000);
  set("gin", 2000);
  set("sen", 2000);

  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 20);

  set("combat_exp", 9000000);
  set("score", 60000);
  set_temp("apply/attack", 30);
  set_temp("apply/defense", 30);
  set_temp("apply/move", 30);

  set_skill("dodge", 250);
  set_skill("move", 200);
  set_skill("literate", 180);
  set_skill("parry", 200);
  set_skill("unarmed", 250);
  set_skill("force", 250);
  set_skill("sword", 250);

  set_skill("three-sword", 250);
  set_skill("pine_strike", 250);
  set_skill("liumai_force", 250);
  set_skill("star_dodge", 250);

  map_skill("dodge", "star_dodge");
  map_skill("unarmed", "pine_strike");
  map_skill("force", "liumai_force");
  map_skill("parry", "three-sword");
  map_skill("sword", "three-sword");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "dodge.liuxing" :),
    (: perform_action, "unarmed.songzhen" :),
  }));

  create_family("泰山派", 1, "掌门");
  set("class", "taishan");

  setup();
  carry_object(__DIR__ "weapon/sword");
  carry_object(__DIR__ "obj/jinzhuang")->wear();
}

void die() {
  int exp, pot, score;
  object killer, victim;

  if (!killer = query_temp("last_damage_from"))
    killer = this_player(1);

  if (!victim) victim = this_object();

  if (!userp(victim) && victim->query("NKreward_MASTER")) {
    exp = random(victim->query("combat_exp") - killer->query("combat_exp")) / 100;
    pot = random(exp) / 2;
    if (exp <= 0) exp = 20;
    if (pot <= 0) pot = 10;
    if (exp > 2000) exp = 2000;
    if (pot > 1000) pot = 1000;
    score = random(pot / 100) + 1;
    if (killer->query("id_type") != victim->query("id_type")) {
      killer->add("combat_exp", exp);
      killer->add("potential", pot);
      killer->add("life_exp", score);
      killer->add("score", score);
      tell_object(killer, HIY "你获得了：\n" +
        chinese_number(exp) + "点经验\n" +
        chinese_number(pot) + "点潜能\n" +
        chinese_number(score) + "点江湖阅历\n" +
        chinese_number(score) + "点声望\n" NOR);
    }
  }
  ::die();
}
