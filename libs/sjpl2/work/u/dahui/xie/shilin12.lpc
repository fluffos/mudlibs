// more /d/evilland/evil00.c
inherit ROOM;
//int do_gogo(string dir);

void create() {
  int i;
  set("short", "石牛古洞");
  set("long", @LONG
这里是石牛古洞，洞里曲折不平，加上阴暗潮湿。实在让人看不清楚
景物，远处似乎隐隐传来人走动的脚步声，很轻的脚步声。
    这里明显的出口是 south、north、west、east 和 down 。
LONG);

  set("hell", 1);
  set("auto_maps", 1);
  set("master_xyz", random(90) * 10 + 0);
  set("next_exit_xyz", random(90) * 10 + 0);
  /*
       set("objects",([
                      __DIR__"npc/master01" : 1 + random(2),
                      __DIR__"npc/master02" : 1 + random(2),
                ]));
*/
  setup();
}

void init() {
  add_action("do_gogo", "go");
}

int do_gogo(string dir) {
  object me, room;
  me = this_player();
  me->set("map_xyz", 000);
  if (!dir)
    return notify_fail("你要往哪里去？\n");

  switch (dir) {
    case "north":
      me->add("map_xyz", 10);
      room = new(__DIR__ "shilin11.lpc");
      break;
    case "south":
      me->add("map_xyz", -10);
      room = new(__DIR__ "shilin11.lpc");
      break;
    case "east":
      me->add("map_xyz", 100);
      room = new(__DIR__ "shilin11.lpc");
      break;
    case "west":
      me->add("map_xyz", -100);
      room = new(__DIR__ "shilin11.lpc");
      break;
    case "down":
      room = new(__DIR__ "shilin20.lpc");
      break;
    default:
  }

  if (dir == "up" || !room)
    return notify_fail("这里没有这个方向的出口。\n");
  me->move(room);
  write("\n你走了过来。\n");
  destruct(this_object());
  return 1;
}
