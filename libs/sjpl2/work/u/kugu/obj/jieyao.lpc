// jieyao.c

#include <ansi.h>
inherit COMBINED_ITEM;

void create() {
  set_name("冰蟾解毒散", ({ "jie yao", "yao" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "这是一种枯骨寺的独门秘方，能解百毒。你可以把它倒(pour)在酒水之中使用。\n");
    set("unit", "包");
    set("base_value", 700);
    set("base_unit", "份");
    set("base_weight", 30);
  }
  set_amount(1);
}

void init() {
  add_action("do_pour", "pour");
}

int do_pour(string arg) {
  string me, what;
  object ob;
  function f;

  if (!arg
    || sscanf(arg, "%s in %s", me, what) != 2
    || !id(me))
    return notify_fail("指令格式: pour <药粉> in <物品>\n");

  ob = present(what, this_player());
  if (!ob)
    return notify_fail("你身上没有 " + what + " 这样东西。\n");
  if (!ob->query("liquid/remaining"))
    return notify_fail(ob->name() + "里什麽也没有，先装些水酒才能溶化药粉。\n");
  f = (: call_other, __FILE__, "drink_drug" :);
  ob->set("liquid/drink_func", bind(f, ob));
  ob->add("liquid/slumber_effect", 100);
  message_vision("$N将一些" + name() + "倒进" + ob->name()
    + "，摇晃了几下。\n", this_player());
  add_amount(-1);
  return 1;
}

int drink_drug(object ob) {

  if (this_player()->query_condition("rose_poison")) {
    this_player()->apply_condition("rose_poison", 0);
    message_vision("$N使用冰蟾解毒散将身上的火玫瑰毒解了。\n", this_player());
    return 0;
  }
  if (this_player()->query_condition("snake_poison")) {
    this_player()->apply_condition("snake_poison", 0);
    message_vision("$N使用冰蟾解毒散将身上的蛇毒解了。\n", this_player());
    return 0;
  }
  if (this_player()->query_condition("slumber_drug")) {
    this_player()->apply_condition("slumber_drug", 0);
    message_vision("$N使用冰蟾解毒散将身上的迷药解了。\n", this_player());
    return 0;
  }
  if (this_player()->query_condition("iceshock")) {
    this_player()->apply_condition("iceshock", 0);
    message_vision("$N使用冰蟾解毒散将身上的寒毒解了。\n", this_player());
    return 0;
  }
  message_vision("$N使用冰蟾解毒散，但什么也没有发生。\n", this_player());
  return 0;

}
