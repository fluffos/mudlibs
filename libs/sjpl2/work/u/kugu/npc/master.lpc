// master.c

#include <ansi.h>

inherit NPC;
inherit F_MASTER;
int about_quest();
string ask_for_join();

void create() {
  set_name("枯骨如来", ({ "master bonze", "master", "bonze" }));

  set("gender", "男性");
  set("age", 74);
  set("attitude", "peaceful");
  set("class", "bonze");
  set("apprentice_available", 10);

  set("str", 70);
  set("int", 30);
  set("spi", 30);
  set("con", 30);
  set("cps", 30);
  set("cor", 20);

  set("atman", 6000);
  set("max_atman", 6000);
  set("atman_factor", 50);

  set("force", 15000);
  set("max_force", 15000);
  set("force_factor", 50);

  set("mana", 6000);
  set("max_mana", 6000);
  set("mana_factor", 50);

  set("combat_exp", 9000000);
  set("score", 9000);

  set("inquiry", ([
    "quest": (: about_quest :),
    "剃度": (: ask_for_join :),
    "出家": (: ask_for_join :),
  ]));

  set_skill("staff", 250);
  set_skill("unarmed", 250);
  set_skill("force", 250);
  set_skill("dodge", 250);
  set_skill("literate", 170);
  set_skill("chanting", 150);
  set_skill("parry", 250);
  set_skill("move", 220);

  set_skill("kurong-force", 250);
  set_skill("jiangshi-steps", 250);
  set_skill("yimu-strike", 250);

  map_skill("unarmed", "yimu-strike");
  map_skill("dodge", "jiangshi-steps");
  map_skill("force", "kurong-force");
  map_skill("move", "jiangshi-steps");

  create_family("枯骨寺", 1, "住持");

  setup();

  //	carry_object(__DIR__"obj/brass_staff")->wield();
}

void init() {
  add_action("do_kneel", "kneel");
}

string ask_for_join() {
  object me;

  me = this_player();

  if ((string)me->query("class") == "shaolin1")
    return "阿弥陀佛！你我同是出家人，何故跟老衲开这等玩笑？\n";
  if ((string)me->query("gender") != "男性")
    return "阿弥陀佛！女施主，这里是寺庙，请□到尼庵去剃度吧。\n";

  me->set_temp("pending/join_bonze", 1);
  return "阿弥陀佛！善哉！善哉！施主若真心皈依我佛，请跪下(kneel)受戒。\n";
}

int do_kneel() {
  string *prename = ({ "空", "明", "圆", "净", "虚", "悟",
    "方", "渡", "慧", "法" });
  string name, new_name;

  if (!this_player()->query_temp("pending/join_bonze")) return 0;
  message_vision(
    HIC "$N双手合十，恭恭敬敬地跪了下来。\n\n"
    "$n伸出手掌，在$N头顶轻轻地摩挲了几下，将$N的头发尽数剃去。\n\n" NOR,
    this_player(), this_object());
  name = this_player()->query("name");
  new_name = prename[random(sizeof(prename))] + name[0..1];
  command("say 从今以後你的法名叫做" + new_name + "。");
  command("smile");
  this_player()->delete_temp("pending/join_bonze");
  this_player()->set("name", new_name);
  this_player()->set("class", "bonze");

  return 1;
}

void attempt_apprentice(object ob) {
  if (query("apprentice_available")) {
    if (this_player()->query("betrayer")) {
      command("say 你我无缘，施主请回吧。\n");
      return;
    }
    if (find_call_out("do_recruit") != -1)
      command("say 慢著，一个一个来。");
    else
      call_out("do_recruit", 2, ob);
  } else {
    command("say 老纳今天已经收了十个弟子，不想再收徒了。");
  }
}

void do_recruit(object ob) {
  if ((string)ob->query("gender") != "男性")
    command("say 阿弥陀佛，女施主不要跟老纳开玩笑。");
  else if ((string)ob->query("class") != "bonze")
    command("say 阿弥陀佛，施主愿入佛门，请先到小寺剃度出家。");
  else {
    command("say 阿弥陀佛，善哉！善哉！");
    command("recruit " + ob->query("id"));
    this_player()->set("id_type", 2);
  }
}

int recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob)) {
    add("apprentice_availavble", -1);
    return 1;
  }
}

int accept_fight(object me) {
  if ((string)me->query("class") == "bonze")
    command("say 阿弥陀佛！出家人戒逞强恶斗！老衲不敢违反清规。");
  else
    command("say 施主既然身负绝艺，老衲佩服便是，也不必较量了。");

  return 0;
}
int about_quest() {
  object me = this_player();
  if (random(9) < 5 && !me->query("marks/kgjob")) {
    command("say 你去药圃里帮忙种植些草药吧。");
    me->set("marks/kgjob", "hoe");
    me->set_temp("workobj_name", "hoe");
    return 1;
  } else if (!me->query("marks/kgjob")) {
    command("say 你去本寺后院的塔林打扫一下吧。");
    me->set("marks/kgjob", "broom");
    me->set_temp("workobj_name", "broom");
    return 1;
  } else {
    command("say 你还站在这里干什么？好好用功才是啊！");
    return 1;
  }
  return 1;
}
int accept_object(object who, object ob) {
  int exp, pot;
  object me;
  me = this_player();
  exp = (int)me->query("combat_exp");
  pot = (int)me->query("potential");
  if (ob->query("id") == (string)me->query_temp("workobj_name") && ob->query("objattrib")) {
    say(CYN "枯骨如来微笑点头，说道：很好，继续努力。\n" NOR);
    me->set("combat_exp", (int)exp + random(20) + 10);
    me->set("potential", (int)pot + random(10) + 5);
    me->add("score", random(5));
    me->add("life_exp", random(10));
    if (me->query("marks/kgjob"))
      me->delete("marks/kgjob");
    if (me->query_temp("workobj_name"))
      me->delete_temp("workobj_name");
    return 1;
  } else {
    say(CYN "枯骨如来说道：多谢你的好意，但这东西对我没用。\n" NOR);
    return 0;
  }
  return 1;
}
