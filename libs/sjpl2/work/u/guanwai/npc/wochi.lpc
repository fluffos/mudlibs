#include <ansi.h>

inherit NPC;
inherit F_MASTER;
int about_quest();

void create() {
  set_name("握赤", ({ "master wochi", "master", "wochi" }));
  set("gender", "男性");
  set("age", 50);
  set("int", 20);
  set("apprentice_available", 20);
  create_family("塔尔寺", 6, "法师");
  set("long",
    "握赤是石摩柯的得意弟子。\n"
  );
  set("inquiry", ([
    "阿叠多杖阵": (: about_quest :),
    "进阵": (: about_quest :),
    "闯阵": (: about_quest :),
  ]));

  set("combat_exp", 1000000);
  set("score", 50000);
  set_skill("unarmed", 120);
  set_skill("dodge", 90);
  set_skill("move", 90);
  set_skill("staff", 90);
  set_skill("force", 90);
  set_skill("parry", 90);
  set_skill("literate", 90);
  set_skill("iron-cloth", 90);

  set_skill("tianzhu_finger", 120);
  set_skill("kongling_staff", 90);
  set_skill("xuanzang_force", 90);
  set_skill("yoga", 100);
  set_skill("jinzhong_zhao", 90);
  set_skill("yixing_huanwei", 90);
  set_skill("chanting", 70);

  map_skill("unarmed", "tianzhu_finger");
  map_skill("force", "xuanzang_force");
  map_skill("dodge", "yixing_huanwei");
  map_skill("iron-cloth", "jinzhong_zhao");
  map_skill("staff", "kongling_staff");
  map_skill("parry", "kongling_staff");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "staff.wanxiang" :),
  }));
  setup();
  carry_object(__DIR__ "obj/redcloth")->wear();
  carry_object(__DIR__ "obj/3staff")->wield();
}
void init() {
  add_action("do_gogo", "go");
}

int do_gogo(string arg) {
  object me;
  me = this_player();
  if (arg == "west") {
    command("say 这是本派阿叠多杖阵，请勿乱闯！\n");
    write("这个方向的路被握赤法师挡住了 。\n");
    return 1;
  } else
    return 0;
}
int about_quest() {
  object me = this_player();
  /*
	if( this_object()->query_temp("lama/counter") )
	{
	command("say 有人正在闯阵，请明天再来。\n");
	return 1;
	}
*/
  if (me->query("id_type") == 2) {
    command("say 嘿嘿，正邪势不两立，你要来破阵，且看你有没有这个本事！\n");
    me->move("/u/guanwai/lama_zhen");
    message_vision(HIR "\n握赤法师领$N进入了阿叠多杖阵，随后冷笑着走开了。\n" NOR, me);
    this_object()->set_temp("lama/counter", 1);
    return 1;
  }
  if (me->query("class") != "lama") {
    command("say 这是本派阿叠多杖阵，非黄教弟子请勿入内！\n");
    return 1;
  }
  if ((int)me->query("combat_exp") < 900000) {
    command("say 你的武功太差了，进入本派阿叠多杖阵会有性命危险！\n");
    return 1;
  }
  if ((int)me->query("combat_exp") > 1500000) {
    command("say 你武艺超群，闯本派阿叠多杖阵已经没有意义了！\n");
    return 1;
  } else {
    command("say 难得你有这般胆识，那就进去闯一闯吧！\n");
    me->set_temp("lama/jianzhen", 1);
    me->move("/u/guanwai/lama_zhen");
    this_object()->set_temp("lama/counter", 1);
    message_vision(CYN "\n握赤法师领$N进入了阿叠多杖阵，随后微笑着走开了。\n" NOR, me);
    return 1;
  }
  return 1;
}
void reset() {
  delete_temp("learned");
  set("apprentice_available", 20);
}
void attempt_apprentice(object ob) {
  if (query("apprentice_available")) {

    if (ob->query("class") != "lama") {
      command("say 这位" + RANK_D->query_respect(ob) + "还是去拜我的弟子吧。\n");
      return;
    }

    if (ob->query_skill("xuanzang_force", 1) < 50) {
      command("say 你本门内功修为尚浅，拜师之事还是以后再说吧。\n");
      return;
    }

    if (ob->query_skill("yoga", 1) < 50) {
      command("say 你瑜珈功修为尚浅，拜师之事还是以后再说吧。\n");
      return;
    }
    if (find_call_out("do_recruit") != -1)
      command("say 慢著，一个一个来。");
    else
      call_out("do_recruit", 2, ob);
  } else {
    command("say 本法师今天已经收了二十个弟子，不想再收徒了。");
  }
}

void do_recruit(object ob) {
  command("smile");
  command("say 很好，很好，很好。");
  command("recruit " + ob->query("id"));
}
int recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "lama");
  ob->set("id_type", 1);
  add("apprentice_availavble", -1);
}
void re_rank(object student) {
  int exp;
  exp = (int)student->query("combat_exp");
  if (exp <= 32000) {
    student->set("title", "塔尔寺弟子");
    return;
  } else if (exp <= 128000) {
    student->set("title", "塔尔寺罗汉");
    return;
  } else if (exp <= 512000) {
    student->set("title", "塔尔寺高僧");
    return;
  } else student->set("title", "塔尔寺圣僧");
  return;
}
