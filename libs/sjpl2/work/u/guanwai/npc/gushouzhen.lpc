#include <ansi.h>
inherit NPC;
int do_identify(string arg);

void create() {
  set_name("谷守真", ({ "gu shouzhen", "gu" }));
  set("long",
    "他是江湖第一名医，鉴定（identify）各种奇形怪状的草药更是一绝。\n");
  set("gender", "男性");
  set("title", "江湖名医");
  set("nickname", GRN "蓑衣丈人" NOR);
  set("age", 60);
  set("attitude", "peaceful");

  set("str", 220);
  set("int", 25);
  set("force", 15000);
  set("combat_exp", 9000000);
  set("max_kee", 9000);
  set("max_gin", 9000);
  set("max_sen", 9000);
  set("kee", 9000);
  set("gin", 9000);
  set("sen", 9000);

  set("inquiry", ([
    "鉴定": "鉴定草药一次要一两银子。",
  ]));

  set_skill("unarmed", 200);
  set_skill("dodge", 200);
  set_skill("parry", 200);
  set_skill("force", 200);
  set_skill("xiaochengforce", 200);
  set_skill("literate", 150);
  set_skill("sword", 200);
  set_skill("duzhuo_sword", 200);

  map_skill("force", "xiaochengforce");
  map_skill("sword", "duzhuo_sword");
  map_skill("parry", "duzhuo_sword");

  setup();
  carry_object("/obj/cloth")->wear();
  carry_object("/obj/longsword")->wield();
  add_money("silver", 50);
}
void init() {
  add_action("do_identify", "identify");
}

int accept_object(object me, object ob) {
  if (ob->query("money_id") && ob->value() >= 100) {
    if (me->query_temp("ready_appraise")) {
      tell_object(me, "谷守真说道：你已经给过我钱了，快把东西拿出来我看。\n");
      return 0;
    }
    me->set_temp("ready_appraise", 1);
    tell_object(me, "谷守真说道：把东西拿出来我看（identify <物品名称>）。\n");
    return 1;
  } else
    tell_object(me, "谷守真说道：鉴定草药一次要一两银子。\n");
  return 0;
}

int accept_fight(object me) {
  return 0;
}

int do_identify(string arg) {
  object me = this_player(), ob;
  if (!arg)
    return notify_fail("你要鉴定什么？\n");
  if (!me->query_temp("ready_appraise"))
    return notify_fail("谷守真说道：你还没有给我鉴定费用呢。\n");
  if (!ob = present(arg, me))
    return notify_fail("你身上没有这个东西。\n");
  ob = present(arg, me);
  if (!ob->query("identify_name"))
    return notify_fail("这个东西不需要鉴定。\n");
  arg = ob->query("identify_name");
  message_vision(CYN "\n$N把" + ob->query("name") + "递给了谷守真。\n", me);
  message_vision("谷守真端详了一会儿，对$N点了点头，说道：这个是［" + arg + "］。\n", me);
  message_vision("谷守真把" + arg + "还给了$N。\n\n" NOR, me);
  ob->set("name", arg);
  me->delete_temp("ready_appraise");
  me->add("combat_exp", 1);
  me->add("life_exp", 1);
  me->add("potential", random(1));
  return 1;
}
int recognize_apprentice(object ob) {
  if (this_player()->query("life_exp") < 100000) return 0;
  return 1;
}
