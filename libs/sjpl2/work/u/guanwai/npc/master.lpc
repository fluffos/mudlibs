inherit NPC;
inherit F_MASTER;
void re_rank(object student);

void create() {
  set_name("黄教法王", ({ "master huang", "master", "fawang" }));
  set("gender", "男性");
  set("age", 90);
  set("str", 30);
  set("agi", 25);
  set("int", 30);
  set("cor", 30);
  set("spi", 30);
  set("max_kee", 2000);
  set("max_gin", 2000);
  set("max_sen", 2000);
  set("kee", 2000);
  set("gin", 2000);
  set("sen", 2000);
  set("apprentice_available", 20);
  set("force", 3000);
  set("max_force", 3000);
  set("force_factor", 30);
  set("class", "lama");
  create_family("塔尔寺", 4, "主持");
  set("long",
    "黄教法王已在塔尔寺主持多年。男女弟子遍布关外。\n"
  );
  set("combat_exp", 7000000);
  set("score", 90000);

  set_temp("apply/attack", 30);
  set_temp("apply/defense", 30);
  set_temp("apply/move", 30);

  set_skill("unarmed", 250);
  set_skill("dodge", 250);
  set_skill("move", 250);
  set_skill("staff", 250);
  set_skill("force", 250);
  set_skill("parry", 250);
  set_skill("literate", 200);
  set_skill("iron-cloth", 250);
  set_skill("yoga", 200);

  set_skill("blood_strike", 250);
  set_skill("tianzhu_finger", 250);
  set_skill("kongling_staff", 250);
  set_skill("xuanzang_force", 250);
  set_skill("chanting", 200);
  set_skill("jinzhong_zhao", 250);
  set_skill("yixing_huanwei", 250);

  map_skill("unarmed", "blood_strike");
  map_skill("force", "xuanzang_force");
  map_skill("dodge", "yixing_huanwei");
  map_skill("iron-cloth", "jinzhong_zhao");
  map_skill("staff", "kongling_staff");
  map_skill("parry", "kongling_staff");

  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "staff.wanxiang" :),
  }));
  setup();
  carry_object(__DIR__ "obj/redcloth")->wear();
  carry_object(__DIR__ "obj/9staff")->wield();
}
void reset() {
  delete_temp("learned");
  set("apprentice_available", 20);
}
void attempt_apprentice(object ob) {
  if (query("apprentice_available")) {

    if (ob->query("class") != "lama") {
      command("say 这位" + RANK_D->query_respect(ob) + "还是去拜老僧的弟子吧。\n");
      return;
    }

    if (ob->query_skill("xuanzang_force", 1) < 180) {
      command("say 本门武功均以大迷玄藏功作为基础，你修为尚浅，应先在内功方面多下功夫。\n");
      return;
    }
    if (find_call_out("do_recruit") != -1)
      command("say 慢著，一个一个来。");
    else
      call_out("do_recruit", 2, ob);
  } else {
    command("say 本主持今天已经收了二十个弟子，不想再收徒了。");
  }
}

void do_recruit(object ob) {
  command("smile");
  command("say 很好，很好，很好。");
  command("recruit " + ob->query("id"));
}
int recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "lama");
  ob->set("id_type", 1);
  add("apprentice_availavble", -1);
}
/*
void init()
{
        add_action("give_quest", "quest");
}
*/
void re_rank(object student) {
  int exp;
  exp = (int)student->query("combat_exp");
  if (exp <= 32000) {
    student->set("title", "塔尔寺弟子");
    return;
  } else if (exp <= 128000) {
    student->set("title", "塔尔寺罗汉");
    return;
  } else if (exp <= 512000) {
    student->set("title", "塔尔寺高僧");
    return;
  } else if (exp <= 1536000) {
    student->set("title", "塔尔寺圣僧");
    return;
  } else if (exp <= 3456000) {
    student->set("title", "塔尔寺法师");
    return;
  } else if (exp <= 5187000) {
    student->set("title", "塔尔寺大法师");
    return;
  } else if (exp <= 26244000) {
    student->set("title", "塔尔寺活佛");
    return;
  } else
    student->set("title", "塔尔寺副主持");
  return;

}
