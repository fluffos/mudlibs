#include <ansi.h>

inherit NPC;
int about_tes();

void create() {
  set_name("铁沙龙", ({ "tie shalong", "tie", "shalong" }));
  set("gender", "男性");
  set("age", 28);
  set("long",
    "铁沙龙是中原人士，后因江湖恩怨来到西域，加入了塔尔寺。\n");
  set("attitude", "peaceful");
  set("str", 26);
  set("force", 200);
  set("max_force", 200);
  set("force_factor", 10);
  set("combat_exp", 200000);
  set("score", 10000);
  set_skill("unarmed", 50);
  set_skill("dodge", 40);
  set_skill("move", 40);
  set_skill("staff", 40);
  set_skill("force", 40);
  set_skill("parry", 40);
  set_skill("literate", 30);
  set_skill("iron-cloth", 40);

  set_skill("tianzhu_finger", 50);
  set_skill("kongling_staff", 40);
  set_skill("xuanzang_force", 40);
  set_skill("yoga", 30);
  set_skill("chanting", 30);
  set_skill("jinzhong_zhao", 40);
  set_skill("yixing_huanwei", 40);

  map_skill("unarmed", "tianzhu_finger");
  map_skill("force", "xuanzang_force");
  map_skill("dodge", "yixing_huanwei");
  map_skill("iron-cloth", "jinzhong_zhao");
  map_skill("staff", "kongling_staff");
  map_skill("parry", "kongling_staff");

  create_family("塔尔寺", 8, "弟子");
  set("inquiry", ([
    "塔尔寺": (: about_tes :),
  ]));


  setup();

  carry_object(__DIR__ "obj/1staff")->wield();
  carry_object(__DIR__ "obj/redcloth")->wear();
}


int about_tes() {
  say("铁沙龙哈哈大笑几声。\n");
  say("铁沙龙说道：难得你想加入我们塔尔寺，那我就告诉你吧。你先找到牧羊女，然后西走，\n");
  say("再南走，最后一直往西走便是。\n");
  return 1;

}
