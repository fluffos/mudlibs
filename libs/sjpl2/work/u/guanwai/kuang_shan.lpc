inherit ROOM;

void create() {
  set("short", "矿山");
  set("long", @LONG
这是一座高高的矿山，据说山上矿藏资源相当丰富，每一块
石头都是宝，故已被朝廷列为特殊保护区，不准寻常百姓开采。
LONG
  );

  set("exits", ([
    "west": __DIR__ "qutansi",
    "east": __DIR__ "suishiroad",
  ]));
  set("objects",
    ([  //sizeof() == 1
    "/obj/npc/worker3": 2,
    ]));
  set("hell", 1);
  set("no_fight", 1);
  set("no_study", 1);
  set("no_magic", 1);
  set("NONPC", 1);
  set("outdoors", "xueshan");
  setup();
}

int valid_leave(object me, string dir) {

  if (me->query_temp("doing_work") <= 1)
    return notify_fail("你的工作还没有完成，怎么就想走了？\n");
  me->set_temp("doing_work", 0);
  return ::valid_leave(me, dir);
}
