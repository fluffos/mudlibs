inherit ROOM;

void create() {
  set("short", "大经堂");
  set("long", @LONG
大经堂十寺庙里最老的建筑，雕刻精美的班禅宝座、佛像、壁画，令
人目不暇接。
LONG
  );
  set("exits", ([
    "west": __DIR__ "dalingta",
    "east": __DIR__ "dajindian",
    "north": __DIR__ "wensi",
    "south": __DIR__ "chanfang",
  ]));
  set("objects", ([
    __DIR__ "npc/master": 1,
    __DIR__ "npc/lama": 2,
  ]));
  set("outdoors", "guanwai");
  setup();
}
int valid_leave(object me, string dir) {
  object ob;
  if (dir != "east" && present("master huang", environment(me)) &&
    me->query("class") != "lama")
    return notify_fail("黄教法王低沉的声音说道：“本寺重地，请勿擅进！”\n");
  return ::valid_leave(me, dir);
}
