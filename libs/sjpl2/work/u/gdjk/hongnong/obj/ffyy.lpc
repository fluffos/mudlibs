#include <ansi.h>
#include <armor.h>

inherit CLOTH;
inherit F_AUTOLOAD;
void create() {
  set_name(HIC "凤羽龙衣" NOR, ({ "fengyu longyi", "cloth" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 40000);
    set("material", "cloth");
    set("armor_prop/armor", 100);
    set("armor_prop/dodge", 100);
  }
  setup();
}
int query_autoload() {
  string name;
  if (this_player()->query("class", "xiaoyao")) {
    name = this_player()->query("name");
    this_object()->set("owner", name);
    return 1;
  }
  return 0;

}
