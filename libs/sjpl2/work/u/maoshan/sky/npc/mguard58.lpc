// taoist_guard.c  by baiwt@sjpl 5,17,2000
//法术：［水妖聚］ 属性：召唤  对象：水妖  克星：无
//法术：［洛神凌波］ 属性：heal,busy9  对象：me,all  克星：无
#include <ansi.h>
inherit NPC;
int magic_more(object who);

void create() {
  set_name("洛神", ({ "water god", "taoist guard" }));
  set("gender", "女性");
  set("age", 25);
  set("attitude", "peaceful");
  set("long", "天界之水神，掌管百川之水。\n");

  set("mguard", "mguard58");
  set("mguard_level", 58);
  set("magic_power", 3000);
  set("last_load_time", uptime());

  set("str", 92);
  set("cor", 52);
  set("cps", 22);
  set("per", 52);

  set("max_kee", 4000);
  set("max_gin", 4000);
  set("max_sen", 4000);
  set("max_mana", 2500);
  set("mana", 2500);

  set("combat_exp", 10000000);
  set_skill("dodge", 200);
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: magic_more(this_object()) :),
  }));
  set_temp("super_damage", 86400 * 7);

  set_temp("apply/attack", 20);
  set_temp("apply/damage", 20);
  set_temp("apply/defence", 20);
  set_temp("apply/armor", 20);
  setup();

}
int magic_more(object who) {
  int i, mwp;
  object *enemy, mygod;
  seteuid(getuid());
  enemy = who->query_enemy();
  mwp = who->query("magic_power");
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      if (who->query("mana") < 50) return 1;
      if (!objectp(present("shuiyao", environment(who)))) {
        mygod = new("/daemon/troop/maoshan/shuiyao");
        message_vision(HIC "\n$N喃喃念动咒语，只见一张符纸缓缓飘上半空。" NOR, who, enemy[i]);
        message_vision(HIC "\n不久只见地上哗啦啦地冒出了水花，水越涌越多，眨眼汇成了一条浅河！" NOR, who, enemy[i]);
        message_vision(HIC "\n随着水花渐渐升高，水妖的身影在水中浮现出来。\n" NOR, who, enemy[i]);
        message_vision(HIG "［水妖聚］！\n\n" NOR, who, enemy[i]);
        mygod->move(environment(who));
        mygod->set("player_guard", "water god");
        if (userp(enemy[i]) || enemy[i]->query("id") != "shuiyao")
          mygod->kill_ob(enemy[i]);
        if (who->query("mana") >= 50)
          who->add("mana", -50);
        return 1;
      } else {
        mygod = present("shuiyao", environment(who));
        if (enemy[i]->query("id") != "shuiyao" && mygod->query("player_guard") == "water god")
          mygod->kill_ob(enemy[i]);
        else mygod->remove_all_killer();
      }
      if (who->query("kee") < who->query("max_kee") * 3 / 4) {
        message_vision(HIC "\n$N念动咒语，只见其脚下涌起一片片水花。" NOR, who);
        message_vision(HIC "\n水花忽然跃高，宛若升起无数水柱，在$N身周扩展开来！" NOR, who);
        message_vision(HIC "\n神奇的水柱冲洗着$N的伤口，转眼$N的伤口完全愈合了。" NOR, who);
        message_vision(HIC "\n水柱升腾跳跃，又不断扩散开来，直溅向$N全身！\n" NOR, enemy[i]);
        message_vision(HIG "［洛神凌波］！\n\n" NOR, who);
        who->receive_curing("kee", 1000);
        who->receive_heal("kee", 1000);
        who->receive_curing("sen", 1000);
        who->receive_heal("sen", 1000);
        who->receive_curing("gin", 1000);
        who->receive_heal("gin", 1000);
        if (who->query("mana") >= 50)
          who->add("mana", -50);
        if (!who->query_soft_powerup())
          who->soft_powerup(30, 30);
        if (!enemy[i]->is_busy()) enemy[i]->start_busy(9);
        COMBAT_D->report_status(who, 1);
      }
      if (enemy[i]->query("force") > 100) enemy[i]->add("force", -100);

    }
  }
  return 1;
}

int heal_up() {
  object who = this_object();
  if (!who->is_fighting() && (uptime() - (int)who->query("last_load_time")) > (random(500) + 300)) {
    call_out("leave", 1);
    return 1;
  }
  return ::heal_up() + 1;
}

void leave() {
  message("vision",
    HIW + name() + "的身影渐渐虚化，变做了一道白烟。\n\n"
    "白烟随风飘散，很快消失了......\n" NOR, environment(),
    this_object());
  destruct(this_object());
}

void die() {
  object who;
  seteuid(getuid());
  who = this_object();
  if (who->query_temp("already_die") < 3) {
    message_vision(HIW "\n$N念动咒语，只见其脚下涌起一片片水花。" NOR, who);
    message_vision(HIW "\n水花忽然跃高，宛若升起无数水柱，在$N身周扩展开来！" NOR, who);
    message_vision(HIW "\n神奇的水柱冲洗着$N的伤口，转眼$N的伤口完全愈合了。\n" NOR, who);
    message_vision(HIG "［洛神凌波］！\n\n" NOR, who);
    who->receive_curing("kee", 1000);
    who->receive_heal("kee", 1000);
    who->receive_curing("sen", 1000);
    who->receive_heal("sen", 1000);
    who->receive_curing("gin", 1000);
    who->receive_heal("gin", 1000);
    who->add_temp("already_die", 1);
    who->remove_busy();
    if (!who->query_soft_powerup())
      who->soft_powerup(30, 30);

  } else
    ::die();
}
