// taoist_guard.c  by baiwt@sjpl 5,17,2000
//法术：［元神归心术］ 属性：heal  对象：me  克星：无
//法术：［丧妖斩鬼煞罡］ 属性：attack  对象：player  克星：火神
//法术：［断魔心法］ 属性：busy7  对象：npc  克星：火神
#include <ansi.h>
inherit NPC;
int magic_more(object who);

void create() {
  set_name("大黑天神", ({ "daheitianshen", "taoist guard" }));
  set("gender", "男性");
  set("age", 20);
  set("attitude", "peaceful");

  set("mguard", "mguard51");
  set("mguard_level", 51);
  set("magic_power", 250);

  set("str", 32);
  set("cor", 52);
  set("cps", 22);

  set("max_kee", 1000);
  set("max_gin", 1000);
  set("max_sen", 1000);

  set("last_load_time", uptime());
  set("max_mana", 2500);
  set("mana", 2500);

  set("combat_exp", 510000);
  set_skill("dodge", 200);
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: magic_more(this_object()) :),
  }));
  set_temp("super_damage", 86400 * 7);

  set_temp("apply/attack", 20);
  set_temp("apply/damage", 20);
  set_temp("apply/defence", 20);
  set_temp("apply/armor", 20);
  setup();

}
int magic_more(object who) {
  int i, mwp;
  object *enemy;
  seteuid(getuid());
  enemy = who->query_enemy();
  mwp = who->query("magic_power");
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      if (who->query("mana") < 50) return 1;
      if (present("fire god", environment(who))) return 1;
      if (who->query("kee") < who->query("max_kee") * 3 / 4) {
        message_vision(HIC "\n$N喃喃念动咒语，顿时四周一切生物的元神都飞出窍外，被$N吸入体内。" NOR, who, enemy[i]);
        message_vision(HIC "\n随着$N心境越来越平和，$N的一切伤势都痊愈了。\n" NOR, who, enemy[i]);
        message_vision(HIG "［元神归心术］！\n\n" NOR, who);
        who->receive_curing("kee", mwp);
        who->receive_heal("kee", mwp);
        who->receive_curing("sen", mwp);
        who->receive_heal("sen", mwp);
        if (who->query("mana") >= 50)
          who->add("mana", -50);
        COMBAT_D->report_status(who, 1);
        return 1;
      }
      if (userp(enemy[i])) {
        message_vision(HIR "\n$N喃喃念动咒语，突然间四周变得一片漆黑，黑暗中一柄斩妖除魔剑" NOR, who, enemy[i]);
        message_vision(HIR "\n从天而降，直落到$n的头顶之上，随之一声霹雳巨响，登时鲜血飞溅！\n" NOR, who, enemy[i]);
        message_vision(HIG "［丧妖斩鬼煞罡］！\n\n" NOR, who);
        if (random(enemy[i]->query("magic_defense")) < random(1000))
          enemy[i]->receive_wound("kee", enemy[i]->query("max_kee"), who);
        if (who->query("mana") >= 50)
          who->add("mana", -50);
        COMBAT_D->report_status(enemy[i], 1);
      } else if (random(enemy[i]->query("magic_defense")) < random(1000) && !enemy[i]->is_busy()) {
        message_vision(HIB "\n$N喃喃念动咒语，突然间四周变得一片漆黑，伸手不见五指，" NOR, who, enemy[i]);
        message_vision(HIB "\n$n只感到心力交瘁，一时间斗志全失。\n" NOR, who, enemy[i]);
        message_vision(HIG "［断魔心法］！\n\n" NOR, who);
        enemy[i]->start_busy(7);
        if (who->query("mana") >= 50)
          who->add("mana", -50);
        COMBAT_D->report_status(enemy[i], 1);
      }
    }
  }
  return 1;
}

int heal_up() {
  object who = this_object();
  if (!who->is_fighting() && (uptime() - (int)who->query("last_load_time")) > (random(500) + 300)) {
    call_out("leave", 1);
    return 1;
  }
  return ::heal_up() + 1;
}

void leave() {
  message("vision",
    HIW + name() + "的身影渐渐虚化，变做了一道白烟。\n\n"
    "白烟随风飘散，很快消失了......\n" NOR, environment(),
    this_object());
  destruct(this_object());
}
