//fakedan.c 假生生再造丹

#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIM "生生再造丹" NOR, ({ "shengsheng dan", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set_weight(100);
    set("long", "这好象是一颗生生再造丹。\n");
    set("unit", "颗");
    set("value", 1);
    set("identify_name", "假生生再造丹");
  }
  setup();
}

void init() {
  add_action("do_eat", "eat");
}

int do_eat(string arg) {
  object me, ob;
  me = this_player();
  ob = this_object();

  if (!ob->id(arg)) return 0;
  if (me->is_busy())
    return notify_fail("你上一个动作还没有完成。\n");
  if (me->query("class") != "taoist")
    return notify_fail("你不是道士，吃了丹药也不能运功消化，还是不要吃了吧！\n");
  message_vision("$N一口吞下了个$n，接着盘膝坐下将真气在全身游走一周，运功消化了$n！\n", me, ob);
  tell_object(me, "你似乎感到身上忽冷忽热，气血不畅，接着眼前一黑……\n");
  if (me->query("max_force") > 10) me->add("max_force", -10);
  else me->set("max_force", 0);
  me->unconcious();
  destruct(ob);
  return 1;
}
