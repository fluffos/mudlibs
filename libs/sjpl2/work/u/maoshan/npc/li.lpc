//li fantian

inherit NPC;
inherit F_MASTER;

void create() {
  set_name("李凡天", ({ "li fantian", "li" }));
  set("nickname", "丹炉侍卫");
  set("title", "茅山派第五代弟子");
  set("gender", "男性");
  set("age", 34);
  set("long", @LONG
李凡天是前任掌门谷姬子的关门弟子，对炼丹之术也颇有造诣，因此担任了为师父看守丹炉的任务。
LONG
  );
  set("attitude", "peaceful");
  set("str", 23);
  set("int", 32);
  set("spi", 22);
  set("per", 21);
  set("cps", 26);
  set("max_kee", 2500);
  set("max_gin", 2500);
  set("max_sen", 2500);
  set("kee", 2500);
  set("gin", 2500);
  set("sen", 2500);

  set("max_atman", 2500);
  set("atman", 2500);

  set("max_mana", 6000);
  set("mana", 6000);
  set("mana_factor", 10);

  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 20);

  set("combat_exp", 2500000);
  set("score", 12000);
  set_temp("apply/attack", 5);
  set_temp("apply/defense", 5);
  set_temp("apply/move", 5);

  set_skill("literate", 160);
  set_skill("magic", 110);
  set_skill("force", 150);
  set_skill("move", 110);
  set_skill("scratching", 140);
  set_skill("spells", 150);
  set_skill("unarmed", 100);
  set_skill("sword", 90);
  set_skill("parry", 120);
  set_skill("dodge", 150);
  set_skill("gouyee", 150);
  set_skill("sanqing-jian", 80);
  set_skill("taoism", 220);
  set_skill("scratmancy", 140);
  set_skill("necromancy", 150);
  set_skill("liandanshu", 150);

  map_skill("literate", "liandanshu");
  map_skill("scratching", "scratmancy");
  map_skill("spells", "necromancy");
  map_skill("parry", "sanqing-jian");
  map_skill("sword", "sanqing-jian");
  map_skill("force", "gouyee");

  set("inquiry", ([
    "师父": "我师父谷姬子正在内房炼丹修道，外人一律不见！",
    "生生再造丹": "师父让我炼一颗生生再造丹做药引，但我怎么炼也炼不出来，真是急死人了！",
    "炼丹入门": "这是师父送给我的一本书，上面有怎么炼丹的说明，可是我上次去山下采药时不小心弄丢了。"
  ]));
  set("chat_chance", 10);
  set("chat_msg", ({
    "李凡天自言自语地说道：不知道生生再造丹可是这样炼的……\n",
    "李凡天取出两颗丹药，投入炼丹炉内，炉火一下子旺了起来。\n",
    "李凡天焦急地说道：如果炼不出生生再造丹，我可怎么向师父交代啊！\n",
    "李凡天说道：如果那本炼丹入门还在就好了，上面一定有生生再造丹的炼法的！\n",
  }));
  set("chat_chance_combat", 70);
  set("chat_msg_combat", ({
    (: cast_spell, "invocation" :),
    (: cast_spell, "netherbolt" :),
    (: cast_spell, "feeblebolt" :),
  }));
  setup();

  carry_object("/obj/longsword")->wield();
  carry_object(__DIR__ "obj/robe")->wear();
}

int recognize_apprentice(object ob) {
  return (int)(ob->query("maoshan/李凡天"));
}

int accept_object(object me, object obj) {
  if (obj->id("shengsheng dan") && obj->query("kind") == 10
    && me->query_skill("liandanshu", 1) > 120 && me->query("family/master_name") == "温道乙"
    && !me->query("maoshan/生生再造丹") && !me->query("maoshan/谷姬子")) {
    command("smile");
    command("say 师弟竟能炼出生生再造丹，资质远超过我，这下我在师父面前也好交代了！");
    command("say 看起来师弟你似乎对炼丹之术很感兴趣，但我却已经没什么可以教你的了。");
    command("say 这样吧，我这就将你引见给师父，说不定师父一高兴会指点你几手的！");
    message_vision("李凡天快步走进内房，不一会儿就出来了，说道：师父有请！\n", me);
    me->add("combat_exp", 10);
    me->add("potential", 5);
    me->add("life_exp", 20);
    me->set("maoshan/生生再造丹", 1);
    return 1;
  } else if (obj->id("liandan book") && me->query("family/master_name") == "温道乙") {
    command("smile");
    message_vision("李凡天说道：师弟你找到这本书了，实在太好了！我正在找这本书呢，太感谢你了！为表示
我的谢意，我就教你一些关于炼丹术的知识(liandanshu)吧，其他武功法术如果你看得上眼
也尽管跟我学吧！另外，今后你想到我这里来，只要在後殿敲张天师的宝剑(knock sword)，
我就会叫小道童来开门接你的。\n", me);
    if (!me->query("maoshan/李凡天")) {
      me->add("combat_exp", 7);
      me->add("potential", 3);
      me->add("life_exp", 10);
      me->set("maoshan/李凡天", 1);
    }
    return 1;
  } else if (obj->query("identify_name") == "假生生再造丹") {
    command("angry");
    command("say 你竟然敢用假丹来骗我！\n");
    me->add("combat_exp", -10);
    me->unconcious();
    me->delete("maoshan/李凡天");
    return 1;
  }
  {
    command("shake");
    command("say 我不要你的东西。");
    return 0;
  }
}

int accept_fight(object me) {
  command("say 这位" + RANK_D->query_respect(me) +
    "既然赐教，在下就奉陪几手！\n");
  return 1;
}
