#include <ansi.h>
#include <room.h>

inherit ROOM;

void create() {
  set("short", "地狱之门");
  set("long", @LONG
这里是灵心观後殿外的一座小屋子, 正中央的神坛上放着一只白
玉净瓶，微微发出淡金色的光芒。神坛后坐着一位道人，正在闭目养
神。正面的墙壁上挂着一张巨大的两仪八卦印，时而泛出蓝光。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "south": __DIR__ "temple2",
    "enter": "/d/earth/gate",
  ]));
  set("item_desc", ([ /* sizeof() == 2 */
    "两仪八卦印": "一个神奇的法印，据说是阴阳界的通道。\n",
  ]));
  set("objects", ([
    __DIR__ "npc/lvdongshi": 1,
    "/daemon/class/lianyaohu": 1,
  ]));
  set("NONPC", 1);
  setup();
}
int valid_leave(object me, string dir) {
  if (present("lianyao hu", me) && me->query("class") == "taoist") {
    if (dir == "enter")
      message_vision(HIC "\n只见两仪八卦印放出耀眼的蓝光，$N纵身跃了进去。\n\n" NOR, me);
    return ::valid_leave(me, dir);
  }
  if (dir == "enter") {
    if (!objectp(present("lv dongshi", environment(me))))
      return notify_fail("你想进入到八卦印里去，但一阵阴风将你挡了出来。\n");
    if (!present("lianyao hu", me) || me->query("class") != "taoist")
      return notify_fail("吕洞实看了你一眼，说道：没有炼妖壶，就想去阴间？\n");
  }
  return ::valid_leave(me, dir);
}
