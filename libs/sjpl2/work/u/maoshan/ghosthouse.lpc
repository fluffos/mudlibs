//ghosthouse.c 鬼屋

#include <room.h>

inherit ROOM;

void create() {
  set("short", "鬼屋");
  set("long", @LONG
你站在一间阴森森的屋子里，四周的陈设上积满了灰尘，显然很
长时间没人动过了。屋子里还回荡着一种骇人的声音，好象是从地狱
里发出来的一样，令人不禁毛骨悚然。突然间，一阵阴风穿过，你只
觉得黑暗中似乎有人在盯着你看，自己就象是被谁看穿了似的，非常
地不舒服。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "out": __DIR__ "temple1",
  ]));

  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/ghost": 1,
  ]));

  setup();
}
