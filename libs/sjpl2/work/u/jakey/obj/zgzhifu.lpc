#include <armor.h>

inherit CLOTH;

void create() {
  set_name("总管制服", ({ "zhifu cloth", "cloth" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "落月山庄总管的特制服装，挺好看的。\n");
    set("unit", "件");
    set("value", 100);
    set("material", "cloth");
    set("armor_prop/armor", 2);
    set("armor_prop/dodge", 2);
  }
  setup();
}
