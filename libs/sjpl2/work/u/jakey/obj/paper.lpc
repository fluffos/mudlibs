inherit ITEM;

void create() {
  set_name("纸片", ({ "paper" }));
  set_weight(400);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "一张发黄的纸片，上面用血写着几行字：\n\n"
      "    老夫陈逸飞，在此闭关，不慎为逆子成斌所伤，伤势甚重，\n"
      "恐时日无多，已无法生出此地。若能有人到此见此字，望能寻至\n"
      "吾次子成少卓，告之此事，命其清理门户，吾甚为感激。\n\n"
      "                               陈逸飞    绝笔\n");
    set("unit", "张");
    set("material", "paper");
  }
  setup();
}
