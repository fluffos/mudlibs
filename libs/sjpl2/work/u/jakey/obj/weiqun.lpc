#include <armor.h>

inherit CLOTH;

void create() {
  set_name("围裙", ({ "weiqun" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "一件脏兮兮油腻腻的围裙。\n");
    set("unit", "件");
    set("value", 20);
    set("material", "cloth");
    set("armor_prop/armor", 1);
    set("armor_prop/dodge", 1);
  }
  setup();
}
