// bamboo_sword.c

#include <weapon.h>

inherit SWORD;

void create() {
  set_name("扫把", ({ "saoba" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 100);
    set("material", "bamboo");
    set("long", "这是一把扫地用的大扫把，用竹子做成。\n");
    set("wield_msg", "$N拿出一把青竹$n，握在手中。\n");
    set("unequip_msg", "$N放下手中的$n。\n");
  }
  init_sword(2);
  setup();
}
