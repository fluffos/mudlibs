#include <armor.h>

inherit CLOTH;

void create() {
  set_name("员外服", ({ "yuanwaifu" }));
  set_weight(400);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "这是一件员外服，包括员外帽和丝绸长衫和小褂。\n");
    set("unit", "件");
    set("value", 350);
    set("material", "cloth");
    set("armor_prop/armor", 2);
    set("armor_prop/attack", -1);
  }
  setup();
}
