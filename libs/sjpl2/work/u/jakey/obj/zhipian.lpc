inherit ITEM;

void create() {
  set_name("纸片", ({ "paper" }));
  set_weight(400);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "一张小小的纸片，上面写了些字：\n\n"
      "棋桌有鬼，暗棋圣手。\n\n"
      "                               燕    留\n");
    set("unit", "张");
    set("material", "paper");
  }
  setup();
}
