#include <ansi.h>
inherit COMBINED_ITEM;

void create() {
  set_name("饱饱丸", ({ "baobao wan", "pill", "wan" }));
  set("long",
    "一个小小的胶囊，里面是压缩食品。\n");
  set("unit", "颗");
  set("base_unit", "颗");
  set("value", 700000);
  set("base_weight", 200);
  set_amount(1);
}

void init() {
  if (this_player() == environment())
    add_action("do_eat", "eat");
}

int do_eat(string arg) {
  if (!this_object()->id(arg)) return notify_fail("你要吃什么? \n");
  if (this_player()->query_temp("block_msg/all"));
  return notify_fail("什么？\n");
  message_vision("$N拿出一颗饱饱丸，一口给吞了下去。\n$N的肚子立刻像个鼓足的汽球一样大啦！\n", this_player());
  write("你吃下了药丸，感觉肚子涨的难受。\n",);
  this_player()->set("food", 9500);
  this_player()->set("water", 9500);
  //	this_player()->add("max_force",5);
  //	add_amount(-1);
  return 1;
}
