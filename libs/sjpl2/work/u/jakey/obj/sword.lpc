#include <mudlib.h>
#include <ansi.h>
#include <armor.h>
#include <command.h>
#include <globals.h>

inherit ARMOR;
inherit F_SAVE;
inherit F_AUTOLOAD;
inherit F_DAMAGE;

string inputstr, verb;

void create() {
  seteuid(getuid());
  set("unit", "把");
  set_name("长剑", ({ "changjian", "sword" }));
  set("no_get", 1);
  set("material", "cloth");
  set("armor_prop/armor", 300);
  set("armor_type", "cloth");
  set("weight", 1);
  setup();
}

void init() {
  object ob;
  seteuid(geteuid());
  add_action("more2", "morehere");
}


int more1(string *text) {
  int i, j, line;
  line = 0;

  for (i = sizeof(text); line < i; line++)
    write(text[line] + "\n");
  return 1;
}

int more2(string msg) {
  string files;
  files = read_file(msg);
  more1(explode(files, "\n"));
  return 1;
}


int query_autoload() {
  return 1;
}
