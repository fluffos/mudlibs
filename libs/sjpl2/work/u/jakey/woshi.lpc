inherit ROOM;

void create() {
  set("short", "卧室");
  set("long", @LONG
这就是成斌的卧室，里面摆放着几个柜子，一张桌子和三把
椅子。墙上挂着一幅狂草体的字幅。在桌子的左右两边各挂着一
副水墨画。一幅是“踏雪寻梅图”，另一幅是“独钓江雪图”。
桌子上有一个香炉，焚着不知名的香，屋子里面充满了奇异的香
气。床边放着几本书，由于成斌唯一的女儿病了，成夫人并不在
这里住了。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "east": __DIR__ "houyuan",
  ]));
  set("item_desc", ([
    "柜子": "一个红木的柜子，从上到下共有五个抽屉。\n",
  ]));
  set("no_clean_up", 0);
  setup();
}

void init() {
  add_action("do_search", "search");
}

int do_search(string arg) {
  object ob;
  if (arg == "抽屉") {
    write("你打开最上面的抽屉翻了翻，发现除了几件衣服外没有别的东西。\n");
    this_player()->add_temp("searched", 1); return 1;
  }
  if (arg == "衣服") {
    if ((int)this_player()->query_temp("searched") == 0)
      return notify_fail("抽屉是关着的。\n");
    else {
      if ((int)query("geted") > 0) return notify_fail("衣服里什么也没有。\n");
      else {
        write("你在衣服里发现一本书和一卷绳子。\n");
        ob = new("/u/jakey/special/xuanbook");
        ob->move(this_player());
        ob = new("/u/jakey/obj/qingsi");
        ob->move(this_player());
        add("geted", 1);
        return 1;
      }
    }
  }
  return 0;
}
