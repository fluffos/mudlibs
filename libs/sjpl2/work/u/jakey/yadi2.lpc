inherit ROOM;

void create() {
  set("short", "崖底");
  set("long", @LONG
这里是悬崖的崖底，四面绝壁。很明显，这里没有办法回到
上面去了。这里生长着几株合抱粗的老树，上面爬着藤蔓。在四
周是一些荆棘和灌木丛。在不远的地方是个水潭，潭很大。四面
长着过胸的杂草。里面偶尔传来几声清脆的鸟鸣。
LONG
  );
  //	set("exits", ([ /* sizeof() == x */
  //	"" : __DIR__"",
  //	]));
  set("no_clean_up", 0);
  set("outdoors", "jakey");
  setup();
}

void init() {
  add_action("do_search", "search");
  add_action("do_climb", "climb");
}

int do_search(string arg) {
  if (arg != "杂草") return 0;
  write("你走近水潭边，用手分开杂草，出现了一条若隐若现的小径。\n");
  add("exits/north", "/u/jakey/xiaojing");
  call_out("close_passage", 5);
  return 1;
}

int do_climb(string arg) {
  object me;
  me = this_player();
  if (arg != "绝壁") return 0;
  write("你用手攀着绝壁上的石头，开始往上爬。\n");
  me->move(__DIR__ "xuanya");
  message("vision", me->name() + "走了过来。\n", environment(me), me);
  return 1;
}

void close_passage() {
  object room;

  delete("exits/north");
  tell_room("/u/jakey/yadi2", "分开的杂草经风一吹，一阵晃动，将小径又掩盖了起来。\n");
  tell_room("/u/jakey/xiaojing", "分开的杂草经风一吹，一阵晃动，将小径又掩盖了起来。\n");
}
