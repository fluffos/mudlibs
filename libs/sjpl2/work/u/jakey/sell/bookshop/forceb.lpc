inherit ITEM;

void create() {
  set_name("内功入门", ({ "force book", "book" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "这是一本学习内功的入门书籍。\n");
    set("value", 200);
    set("material", "paper");
    set("skill", ([
      "name": "force",
      "exp_required": 0,
      "sen_cost": 10,
      "difficulty": 30,
      "max_skill": 20
    ]));
  }
}
