inherit ITEM;

void create() {
  set_name("读书识字", ({ "literate book", "book" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "这是一本学习知识的入门书籍。\n");
    set("value", 100);
    set("material", "paper");
    set("skill", ([
      "name": "literate",
      "exp_required": 0,
      "sen_cost": 10,
      "difficulty": 10,
      "max_skill": 20
    ]));
  }
}
