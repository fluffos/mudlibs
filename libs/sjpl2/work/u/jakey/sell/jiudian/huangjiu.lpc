inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name("酒盅", ({ "huangjiu", "jiu" }));
  set_weight(7000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "装着一盅采用土法酿制而成的酒，混浊不清，辛辣。\n");
    set("unit", "个");
    set("value", 200);
    set("max_liquid", 7);
  }
  set("liquid", ([
    "name": "黄酒",
    "remaining": 7,
    "type": "alcohol",
    "drunk_apply": 5,
  ]));
  setup();
}
