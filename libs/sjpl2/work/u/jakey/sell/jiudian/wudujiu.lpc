inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name("五毒酒", ({ "wudu jiu", "jiu" }));
  set_weight(7000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "装着一坛子用五毒酿成的酒，很补的。\n");
    set("unit", "坛");
    set("value", 40000);
    set("max_liquid", 10);
  }
  set("liquid", ([
    "name": "五毒酒",
    "remaining": 10,
    "type": "alcohol",
    "drunk_apply": 6,
  ]));
  setup();
}
