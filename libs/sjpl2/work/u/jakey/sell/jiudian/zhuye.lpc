inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name("大竹筒", ({ "zhu tong", "zhu" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "一个装有竹叶清的大竹筒。\n");
    set("unit", "个");
    set("value", 20000);
    set("max_liquid", 10);
  }
  set("liquid", ([
    "name": "竹叶清酒",
    "remaining": 10,
    "type": "alcohol",
    "drunk_apply": 10,
  ]));
  setup();
}
