//shaoji.c
inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("道口烧鸡", ({ "daokou shaoji", "shaoji" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "河南的名吃，香喷喷，好吃看的见。\n");
    set("unit", "只");
    set("value", 500);
    set("food_remaining", 7);
    set("food_supply", 100);
  }
}
