inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name("猴儿酒壶", ({ "houer jiu", "jiu" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "装着由猴子酿造的酒，一股酒香扑面而来。\n");
    set("unit", "个");
    set("value", 50000);
    set("max_liquid", 15);
  }
  set("liquid", ([
    "name": "猴儿酒",
    "remaining": 15,
    "type": "alcohol",
    "drunk_apply": 10,
  ]));
  setup();
}
