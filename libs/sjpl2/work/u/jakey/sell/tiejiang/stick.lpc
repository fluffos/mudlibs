// stick.c

#include <ansi.h>
#include <weapon.h>

inherit STICK;

void create() {
  set_name("铁棒", ({ "stick" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "条");
    set("long", "一条乌黑发亮的铁棒。\n");
    set("value", 200);
    set("material", "steel");
    set("wield_msg", "$N拿出一根$n抄在手中。\n");
    set("unwield_msg", "$N放下手中的$n。\n");
  }

  init_stick(20);
  setup();
}
