// face off.c

#include <armor.h>

inherit HEAD;

void create() {
  set_name("挑夫面具", ({ "tiaofu face", "face" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "一张用人皮制作的挑夫面具。\n");
    set("material", "cloth");
    set("armor_prop/armor", 3);
    set("armor_prop/id", ({ "tiaofu" }));
    set("armor_prop/name", ({ "挑夫" }));
    set("armor_prop/short", ({ "挑夫(Tiaofu)" }));
    set("armor_prop/long", ({
      "一个身体结实的挑夫。\n"
    }));
  }
  setup();
}
