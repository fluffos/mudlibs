// face off.c

#include <armor.h>

inherit HEAD;

void create() {
  set_name("流氓面具", ({ "rascal face", "face" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "一张用人皮制作的流氓面具。\n");
    set("material", "cloth");
    set("armor_prop/armor", 3);
    set("armor_prop/id", ({ "rascal" }));
    set("armor_prop/name", ({ "流氓" }));
    set("armor_prop/short", ({ "流氓(Rascal)" }));
    set("armor_prop/long", ({
      "一个嘻皮笑脸的小流氓。\n"
    }));
  }
  setup();
}
