// face off.c

#include <armor.h>

inherit HEAD;

void create() {
  set_name("和尚面具", ({ "heshang face", "face" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "一张用人皮制作的和尚面具。\n");
    set("material", "cloth");
    set("armor_prop/armor", 3);
    set("armor_prop/id", ({ "heshang" }));
    set("armor_prop/name", ({ "和尚" }));
    set("armor_prop/short", ({ "和尚(Heshang)" }));
    set("armor_prop/long", ({
      "一个光头的化缘和尚。\n"
    }));
  }
  setup();
}
