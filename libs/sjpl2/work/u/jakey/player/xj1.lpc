inherit ROOM;

void create() {
  set("short", "小径");
  set("long", @LONG
这里是一条清幽小径，通往卧虎轩。路旁种了许多翠竹。很
是清幽。看来卧虎轩的主人也是很有雅致的人呢。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "north": __DIR__ "road1",
    "west": __DIR__ "jint1",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    "/u/jakey/npc/hufa": 1,
  ]));
  set("no_clean_up", 0);

  setup();
}



int valid_leave(object me, string dir) {
  object ob;
  if (dir == "west" && present("hufa", environment(me)) &&
    me->query("id") != "jint" && me->query("id") != "tips" && !wizardp(me))
    return notify_fail("护法伸手一拦“前面是卧虎轩，闲人免进。”\n");
  return ::valid_leave(me, dir);
}
