inherit ROOM;

void create() {
  set("short", "山洞");
  set("long", @LONG
这里是一个隐蔽的洞口，入口处被爬山的山藤、石罅隙中长
出的草木而遮挡，从外面真的很难发现。洞中一股潮气，地面上
的泥土半干半湿的。往里面还可以走下去，不过里面有些阴暗。
LONG
  );
  set("exits", ([
    "out": __DIR__ "pine",
    "east": __DIR__ "hole2",
  ]));
  set("no_clean_up", 0);
  setup();
}
