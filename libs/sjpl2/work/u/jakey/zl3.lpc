inherit ROOM;

void create() {
  set("short", "走廊");
  set("long", @LONG
这是一条走廊，左右有许多厢房，陈逸飞在时，落月山庄为
江湖第一大庄，声誉如日中天，各处武林豪杰纷纷慕名来投，可
自从陈老失踪以后，落月山庄日见势衰，住在这里的客人也走了
很多，现在这里空空荡荡，再也没有原来的热闹景象了。 
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "east": __DIR__ "menting",
    "west": __DIR__ "zl2",
    "north": __DIR__ "xiangfang1",
    "south": __DIR__ "xiangfang2",
  ]));
  set("no_clean_up", 0);

  setup();
  replace_program(ROOM);
}
