inherit ROOM;

void create() {
  set("short", "走廊");
  set("long", @LONG
这里已经没有东西遮挡你的上方，两旁是大红色的院墙，青
色的砖铺在地上，两旁每隔几尺就有一个石人，石人或哭或笑，
或嗔或怒，每个石人都不同，共有九个。再往前走几步就到小院
了。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "north": __DIR__ "xyuan2",
    "southwest": __DIR__ "zl5",
  ]));
  set("no_clean_up", 0);
  setup();
}

void init() {
  add_action("do_move", "move");
}

int do_move(string arg) {
  int number;
  object room;
  if (!room = find_object(__DIR__ "chen/midao5")) {
    load_object(__DIR__ "chen/midao5");
    room = find_object(__DIR__ "chen/midao5");
  }
  if (!arg || arg == "") return 0;
  if (arg == "石人") return notify_fail("你试着扳了下石人，好象可以动。\n");
  if (sscanf(arg, "石人 %d", number) == 1)
    switch (number) {
      case 1: if ((string)room->query("sign1") == "●") room->set("sign1", "○");
      else room->set("sign1", "●");
      return notify_fail("你扳了一下第一个石人，石人动了一下，发出了“咔”的一声轻响。\n");
      case 2: if ((string)room->query("sign2") == "●") room->set("sign2", "○");
      else room->set("sign2", "●");
      return notify_fail("你扳了一下第二个石人，石人动了一下，发出了“咔”的一声轻响。\n");
      case 3: if ((string)room->query("sign3") == "●") room->set("sign3", "○");
      else room->set("sign3", "●");
      return notify_fail("你扳了一下第三个石人，石人动了一下，发出了“咔”的一声轻响。\n");
      case 4: if ((string)room->query("sign4") == "●") room->set("sign4", "○");
      else room->set("sign4", "●");
      return notify_fail("你扳了一下第四个石人，石人动了一下，发出了“咔”的一声轻响。\n");
      case 5: if ((string)room->query("sign5") == "●") room->set("sign5", "○");
      else room->set("sign5", "●");
      return notify_fail("你扳了一下第五个石人，石人动了一下，发出了“咔”的一声轻响。\n");
      case 6: if ((string)room->query("sign6") == "●") room->set("sign6", "○");
      else room->set("sign6", "●");
      return notify_fail("你扳了一下第六个石人，石人动了一下，发出了“咔”的一声轻响。\n");
      case 7: if ((string)room->query("sign7") == "●") room->set("sign7", "○");
      else room->set("sign7", "●");
      return notify_fail("你扳了一下第七个石人，石人动了一下，发出了“咔”的一声轻响。\n");
      case 8: if ((string)room->query("sign8") == "●") room->set("sign8", "○");
      else room->set("sign8", "●");
      return notify_fail("你扳了一下第八个石人，石人动了一下，发出了“咔”的一声轻响。\n");
      case 9: if ((string)room->query("sign9") == "●") room->set("sign9", "○");
      else room->set("sign9", "●");
      return notify_fail("你扳了一下第九个石人，石人动了一下，发出了“咔”的一声轻响。\n");
      default: return notify_fail("只有九个石人可以扳。\n");
    } else return notify_fail("你想扳哪个石人？\n");
}
