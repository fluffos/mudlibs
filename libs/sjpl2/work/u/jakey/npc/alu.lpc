inherit NPC;

void create() {
  set_name("阿禄", ({ "alu" }));
  set("title", "落月山庄");
  set("gender", "男性");
  set("age", 40);
  set("long", "阿禄做事向来很稳重，深得庄主的信赖。\n");
  set("combat_exp", 50000);
  set("attitude", "heroism");
  set_skill("unarmed", 80);
  set_skill("dodge", 80);
  set_skill("parry", 80);
  set_skill("force", 80);

  set("force", 800);
  set("max_force", 800);
  set("force_foctor", 20);
  setup();
  carry_object("/u/jakey/obj/jpzhifu")->wear();
}
