inherit NPC;
void hide();

void create() {
  set_name("红蟾蜍", ({ "red frog", "frog" }));
  set("race", "野兽");
  set("age", 1);
  set("long", "一只全身赤红的蟾蜍。 \n");

  set("combat_exp", 7000);
  set("score", 2);
  set_skill("dodge", 10);


  set("limbs", ({ "头部", "身体", "前腿", "后腿" }));
  set("verbs", ({ "bite" }));
  set_temp("armor", 50);
  set("chat_chance", 6);
  set("chat_msg", ({
    (: hide :),
  }));

  setup();
}

void hide() {
  if (!environment()) return;
  message("vision", "红色的蟾蜍跳了几下，隐没到花丛中不见了。\n", environment());
  call_out("disappear", 1, this_player());
}

void disappear() {
  destruct(this_object());
}
