inherit NPC;

void create() {
  set_name("寒天", ({ "han tian", "han" }));
  set("title", "落月山庄总管");
  set("gender", "男性");
  set("age", 32);
  set("long", "山庄的总管，庄内的大小事务都归他管。\n");
  set("combat_exp", 100000);
  set("attitude", "heroism");
  set_skill("unarmed", 80);
  set_skill("dodge", 80);
  set_skill("force", 80);
  set_skill("sword", 80);
  set_skill("parry", 80);
  set_skill("xuanyue-force", 80);
  set_skill("qingfeng-steps", 80);
  set_skill("luoyue-sword", 80);
  set_skill("luanyu-strike", 80);

  map_skill("sword", "luoyue-sword");
  map_skill("parry", "luoyue-sword");
  map_skill("force", "xuanyue-force");
  map_skill("dodge", "qingfeng-steps");
  map_skill("unarmed", "luanyu-strike");
  set("force", 1600);
  set("max_force", 1600);
  set("force_factor", 60);

  set("chat_chance", 3);
  set("chat_msg", ({
    "寒天笑赞道：“这一章回写的倒好。”\n",
  }));

  set("force", 2000);
  set("max_force", 2000);

  setup();
  carry_object("/u/jakey/obj/zgzhifu")->wear();
  carry_object("/u/jakey/obj/shan")->wield();
}
