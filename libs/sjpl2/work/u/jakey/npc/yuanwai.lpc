inherit NPC;

void create() {
  set_name("李员外", ({ "yuan wai", "li", "yuanwai" }));
  set("title", "土财主");
  set("gender", "男性");
  set("age", 44);
  set("long", "一个白白胖胖的中年人，一笑两眼眯成一条缝。此人乐善\n"
    "好施，是个难得的好员外。很受庄里人的尊敬。\n");
  set("combat_exp", 20000);
  set("attitude", "friendly");
  set_skill("unarmed", 20);
  set_skill("dodge", 100);
  set_skill("move", 100);
  set_skill("force", 200);
  set("max_force", 2000);
  set("force", 3000);
  setup();
  carry_object("/u/jakey/obj/yuanwaifu")->wear();
  add_money("gold", 5);
}
