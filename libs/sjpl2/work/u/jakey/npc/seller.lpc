inherit NPC;
inherit F_VENDOR;

void create() {
  object ob;

  set_name("大姑娘", ({ "seller" }));
  set("gender", "女性");
  set("age", 22);
  set("long",
    "这位大姑娘在货架前忙着。\n");
  set("combat_exp", 150);
  set("attitude", "friendly");
  set("rank_info/respect", "小姐");
  set("chat_chance", 5);
  set("chat_msg", ({
    "大姑娘擦了擦汗。\n"
  }));
  setup();
  ob = carry_object("/u/jakey/obj/bluegua")->wear();
}


void init() {
  object ob;

  ::init();
  add_action("do_list", "list");
  add_action("do_buy", "buy");
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}
void greeting(object ob) {
  if (!ob || !present(ob, environment(this_object()))) return;
  say("大姑娘说道：这位" + RANK_D->query_respect(ob)
    + "，要不要买些东西呀。\n");
}


int do_list(string arg) {
  write("这里店小，东西不多，您慢慢挑吧。 \n"
    "口袋(bag)                  一两\n"
    "符咒(seal)                 三两\n"
    "匕首(dagger)               一两\n"
    "化尸粉(dust)               五两\n"
    "蒙汗药(drug)               五两\n"
    "麻绳(rope)                 一两\n \n"
  );
  return 1;
}

int do_buy(string arg) {
  string name, unit, objname;
  int amount, bv;
  object obj, player, from_ob, who_ob;

  amount = 10;

  player = this_player();
  if (!arg)
    return notify_fail("您要点什么酒菜？ \n");
  else {
    switch (arg) {
      case "bag": obj = new("/u/jakey/sell/zahuo/bag");
      amount = 2;
      break;
      case "seal": obj = new("/u/jakey/sell/zahuo/seal");
      amount = 10;
      break;
      case "dagger": obj = new("/u/jakey/sell/zahuo/dagger");
      amount = 5;
      break;
      case "dust": obj = new("/u/jakey/sell/zahuo/dust");
      amount = 2;
      break;
      case "drug": obj = new("/u/jakey/sell/zahuo/drug");
      amount = 5;
      break;
      case "rope": obj = new("/u/jakey/sell/zahuo/rope");
      amount = 5;
      break;
      default: return notify_fail("您要什么？\n");
      break;
    }
    from_ob = present("silver_money", this_player());
    if (!from_ob) return notify_fail("你身上没有银两呀。\n");
    if ((int)from_ob->query_amount() < amount)
      return notify_fail("您的钱不够呀，挑点别的吧。\n");
    from_ob->add_amount(-amount);
    obj->move(player);
  }
  name = (string)this_player()->query("name");
  unit = (string)obj->query("unit");
  objname = (string)obj->query("name");

  tell_room(environment(this_object()), "大姑娘给" + name
    + "一" + unit + objname + "\n");
  say("大姑娘说道：谢谢您了。 \n");

  return 1;
}
