inherit NPC;

void create() {
  set_name("护法", ({ "hufa" }));
  set("gender", "男性");
  set("age", 27);
  set("attitude", "heroism");
  set("str", 19);
  set("cor", 22);
  set("cps", 22);
  set("con", 27);
  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 40);

  set("long", "    一个很厉害的护法。你可别去招惹他。\n");

  set("combat_exp", 200000);

  set_skill("sword", 120);
  set_skill("force", 120);
  set_skill("dodge", 120);
  set_skill("parry", 120);
  set_skill("unarmed", 120);
  set_skill("taiji-force", 100);
  set_skill("taiji-ken", 120);
  set_skill("taiji-sword", 150);
  set_skill("tiyunzong", 120);

  map_skill("unarmed", "taiji-ken");
  map_skill("sword", "taiji-sword");
  map_skill("parry", "taiji-sword");
  map_skill("dodge", "tiyunzong");
  map_skill("force", "taiji-force");

  setup();
  carry_object("/u/jakey/obj/baicloth1")->wear();
  carry_object("/u/jakey/obj/changjian")->wield();
}
