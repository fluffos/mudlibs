inherit NPC;

void create() {
  set_name("白发老人", ({ "old man", "man", "old" }));
  set("gender", "男性");
  set("age", 72);
  set("long", @long
一个白发须眉的老人，两只眼睛里放出锐利的光芒，太阳穴
鼓鼓着。容貌清秀，依稀可以看出年轻时必定是个英俊的人。
long
  );
  set("combat_exp", 1000000);
  set("attitude", "heroism");
  set_skill("unarmed", 200);
  set_skill("dodge", 200);
  set_skill("force", 200);
  set_skill("blade", 250);
  set_skill("parry", 200);
  set_skill("winds-blade", 250);
  set_skill("qingfeng-steps", 200);
  set_skill("luanyu-strike", 200);
  set_skill("xuanyue-force", 200);

  map_skill("dodge", "qingfeng-steps");
  map_skill("unarmed", "luanyu-strike");
  map_skill("force", "xuanyue-force");
  map_skill("blade", "winds-blade");
  map_skill("parry", "winds-blade");

  set("force", 4000);
  set("max_force", 4000);
  set("force_factor", 150);
  set("chat_chance", 3);
  set("chat_msg", ({
    "白发老人自语道：“二十年了，还没有人拿着信物来。”\n",
    "白发老人翻了一页书。\n",
  }));

  set("inquiry", ([
    "陈逸飞": "哈哈，他是老夫的好友，我们有二十年没有见了，不知他现在如何？\n",
    "紫木牌": "是山庄庄主的信物，当年陈逸飞和我约定，山庄的下一任\n"
    "庄主凭此牌可以找我学一套威力无穷的刀法。到现在也没有人来，看来陈\n"
    "老头还活着，哈哈。\n",
    "刀法": "老夫自创的一套刀法，威力很大哟。\n",
    "霹雳刀法": "哈哈，你也知道老夫的这套刀法？不错，霹雳刀法又称十里狂刀，是我最拿手的功夫。\n",
    "信物": "什么？你不知道？那就算了。\n",
  ]));
  setup();
  carry_object("/u/jakey/obj/blade")->wield();
  carry_object("/u/jakey/obj/baicloth1")->wear();
}

int recognize_apprentice(object ob) {
  if (ob->query("marks/winds-blade")) return 1;
  return 0;
}

int accept_object(object me, object ob) {
  if (!((string)ob->query("name") == "紫木牌" &&
    (string)ob->query("id") == "zimu pai")) return 0;
  if (!ob->query_temp("marks/real")) {
    command("heng");
    command("say 你是什么人？竟敢拿个假的来骗我，快给我滚！");
    return 1;
  }
  command("haha");
  command("say 终于有人来了。好，老夫就传你一套十里狂刀(winds-blade)。");
  me->set("marks/winds-blade", 1);
  return 1;
}
