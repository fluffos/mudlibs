// fish.c

inherit NPC;

void create() {
  set_name("银色小鱼", ({ "silver fish", "fish" }));
  set("race", "野兽");
  set("age", 1);
  set("long", "一只全身闪着点点银光的小鱼。 \n");
  set("combat_exp", 700);
  set("limbs", ({ "头部", "身体", "尾巴" }));
  set("verbs", ({ "bite" }));
  set_temp("armor", 5);
  setup();
}
void init() {
  add_action("do_eat", "eat");
}

int do_eat(string arg) {
  if (arg != "fish") return 0;
  if (random(9) > 4) {
    this_player()->add("combat_exp", 20);
    this_player()->add("potential", 10);
  }
  write("你吃下一条银色小鱼。\n");
  destruct(this_object());
  return 1;
}
