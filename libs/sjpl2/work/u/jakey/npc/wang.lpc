inherit NEW_VENDOR;
string ask_xueqin();

void create() {
  set_name("王老板", ({ "wang boss", "wang", "boss" }));
  set("gender", "男性");
  set("age", 45);
  set("long",
    "这位王老板正在记账。\n");
  set("combat_exp", 15);
  set("attitude", "friendly");
  set("rank_info/respect", "老板");
  set("chat_chance", 4);
  set("chat_msg", ({
    //	"王老板叹道：“什么时候才能自己接手呀？”\n",
    "王老板在帐本上写着帐目。\n" }));
  set("merchandise", ([
    "/u/jakey/sell/yaodian/wuhuaguo": 20,
    "/u/jakey/sell/yaodian/bohecao": 20,
    "/u/jakey/sell/yaodian/renshen": 20,
  ]));
  set("inquiry", ([
    "王勤": (: ask_xueqin :),
    "接手": "老当家就是不让位，急死人了。\n",
    "老当家": "那可是这里大名鼎鼎的医生，家父——王勤\n",
    "批发": "本店欢迎药材批发，目前有以下药物可以批发。\n\n"
    "无花果(五十枚)     批发价：一百一十两\n"
    "老人参(五十棵)     批发价：一百二十两\n"
    "薄荷草(五十株)     批发价：一百三十两\n",
  ]));
  setup();
  carry_object("/u/jakey/obj/baicloth1")->wear();
  add_money("gold", 1);
}

string ask_xueqin() {
  call_out("go_home", 1, this_player());
  return "您要找家父呀？跟我来。\n";
}


void go_home(object ob) {
  remove_call_out("go_home");
  if (!ob || ob->is_fighting() || environment(ob) != environment()) return;
  tell_object(ob, "王老板一掀帘子，把你带入内堂。\n");
  ob->move("/u/jakey/minzhai3");
  return;
}

void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
  add_action("do_buy", "buy");

}

void greeting(object ob) {
  if (!ob || !present(ob, environment(this_object()))) return;
  say("王老板道：这位" + RANK_D->query_respect(ob)
    + "，要不要买些药材呀？\n");
}

int accept_object(object who, object ob) {
  object yao;
  if (ob->value() == 11000) {
    yao = new("/u/jakey/sell/yaodian/wuhuaguo");
    yao->set_amount(50);
    yao->move(this_player());
    write("王老板笑道：“这是您的" + yao->name() + "，您收好。\n");
    return 1;
  }
  if (ob->value() == 12000) {
    yao = new("/u/jakey/sell/yaodian/renshen");
    yao->set_amount(50);
    yao->move(this_player());
    write("王老板笑道：“这是您的" + yao->name() + "，您收好。\n");
    return 1;
  }
  if (ob->value() == 13000) {
    yao = new("/u/jakey/sell/yaodian/bohecao");
    yao->set_amount(50);
    yao->move(this_player());
    write("王老板笑道：“这是您的" + yao->name() + "，您收好。\n");
    return 1;
  }
  return 0;
}
