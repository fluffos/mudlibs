inherit NPC;
string ask_miss();

void create() {
  set_name("余护法", ({ "yu hufa", "yu", "hufa" }));
  set("nickname", "百变刀王");
  set("gender", "男性");
  set("age", 32);
  set("attitude", "heroism");
  set("str", 24);
  set("cor", 24);
  set("cps", 22);
  set("con", 23);
  set("force", 3000);
  set("max_force", 3000);
  set("force_factor", 75);

  set("long",
    "外号“百变刀王”的余海身高一米七，身子很瘦，不是很精神的样子，\n"
    "但是他的武功着实不弱。不少武林高手都在他的五虎断门刀下吃了亏。\n");

  set("combat_exp", 370000);

  set_skill("blade", 130);
  set_skill("xuanyue-force", 150);
  set_skill("force", 150);
  set_skill("dodge", 130);
  set_skill("parry", 130);
  set_skill("unarmed", 130);
  set_skill("qingfeng-steps", 130);
  set_skill("spring-blade", 130);
  set_skill("luanyu-strike", 130);

  map_skill("blade", "spring-blade");
  map_skill("force", "xuanyue-force");
  map_skill("parry", "spring-blade");
  map_skill("unarmed", "luanyu-strike");
  map_skill("dodge", "qingfeng-steps");

  set("chat_chance", 1);
  set("chat_msg", ({
    "余护法赞道：“那可真是把好剑呀。”\n",
  }));
  set("inquiry", ([
    "好剑": "那是庄主的成名宝剑，以前有幸见过此剑一次，果真\n"
    "不是凡品。不过庄主有很长时间没有用那把剑了。\n",
    "无极剑": "不错，那就是庄主赖以成名的宝剑。现在庄主不用了，\n"
    "应该放在剑室吧。\n",
    "治病": (: ask_miss :),
    "看病": (: ask_miss :),
  ]));
  setup();
  carry_object("/u/jakey/obj/baicloth1")->wear();
  carry_object("/u/jakey/obj/blade")->wear();
}

int accept_object(object me, object ob) {
  if (!((string)ob->query("name") == "无极剑" &&
    (string)ob->query("id") == "wuji sword")) return 0;
  command("ah");
  command("say 真不敢相信，我能亲手拿到这把剑。这次我一定好好看看。");
  me->set_temp("hufa2/xue", 1);
  return 1;
}

int recognize_apprentice(object ob) {
  if (ob->query_temp("hufa2/xue")) return 1;
  return 0;
}

string ask_miss() {
  this_player()->set_temp("治病", 1);
  return "哦？你是来给小姐治病的吗？进去吧，不准乱跑呀！\n";
}

int accept_fight(object ob) {
  if (ob->query("combat_exp") > 400000) {
    command("say " + RANK_D->query_self(this_object())
      + "武艺低微，怎么可能是" + RANK_D->query_respect(ob)
      + "的对手？\n");
    return 0;
  }

  if (ob->query("combat_exp") < 50000) {
    command("say " + RANK_D->query_self_rude(this_object())
      + "没空呢，你这" + RANK_D->query_rude(ob)
      + "给我滚开！\n");
    return 0;
  }
  return 1;
}
