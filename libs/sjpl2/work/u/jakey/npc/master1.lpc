inherit NPC;

void create() {
  set_name("成斌", ({ "luoyue master", "master" }));
  set("gender", "男性");
  set("age", 45);
  set("long",
    "成斌是落月山庄的庄主，光从外表上真的很难看出来他是个什么样的人。\n"
    "中等身材，身体比较瘦，但是透着一股精明的气质。脸有点尖，但是皮肤\n"
    "很白，蓄着三绺美髯。头发有一些发白了，眼角的鱼尾纹挺深的。\n");
  set("combat_exp", 2000000);
  set("attitude", "heroism");
  set("score", 80000);
  set("title", "落月山庄庄主");
  create_family("落月山庄", 1, "庄主");

  set("max_force", 6000);
  set("force", 6000);
  set("force_factor", 220);
  set("max_gin", 200);
  set("max_sen", 200);
  set("str", 30);
  set("cps", 27);
  set("int", 25);
  set("con", 28);
  set("cor", 30);

  set("inquiry", ([
    "陈逸飞": "那是我的家父，七年前突然失踪了。唉。\n",
    "成少卓": "那是舍弟，家父失踪不久他也不知去向。\n",
    "紫木牌": "什么？什么紫木牌？我不知道。\n",
  ]));

  set_skill("unarmed", 250);
  set_skill("dodge", 250);
  set_skill("force", 300);
  set_skill("sword", 280);
  set_skill("parry", 250);
  set_skill("xuanyue-force", 300);
  set_skill("qingfeng-steps", 250);
  set_skill("luoyue-sword", 280);
  set_skill("luanyu-strike", 250);
  set_skill("literate", 120);

  map_skill("sword", "luoyue-sword");
  map_skill("parry", "luoyue-sword");
  map_skill("force", "xuanyue-force");
  map_skill("dodge", "qingfeng-steps");
  map_skill("unarmed", "luanyu-strike");
  setup();
  carry_object("/u/jakey/obj/goldguan")->wear();
  carry_object("/u/jakey/obj/changjian")->wield();
  carry_object("/u/jakey/obj/zshoe")->wear();
  carry_object("/u/jakey/obj/zjbhcloth")->wear();
}

void attempt_apprentice(object ob) {
  if (ob->query("betrayer") >= 10) {
    command("say 你这个" + RANK_D->query_rude(ob) + "，如此频繁的背叛师门，实在是不忠不义！！！");
    this_object()->kill_ob(this_player());
    return;
  }
  if (ob->query("betrayer")) {
    command("sigh " + ob->query("id"));
    command("say 这位" + RANK_D->query_respect(ob) + "，你既已拜过名师，我就不能收你了。");
    return;
  }
  command("haha");
  command("say 很好，这位" + RANK_D->query_respect(ob) +
    "，你从今以后就是我庄的人了。\n");
  command("recruit " + ob->query("id"));
}


void recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "luoyue");
}

void good_boy() {
  command("spank " + (string)this_player()->query("id"));
  command("say 嗯，不错，我想想奖励你点什么呢？");
  message_vision("成斌想了想，从怀里拿出了一个东西给了$N。\n", this_player());
  command("say 这是我精心炼制的灵药，对我女儿的病没有什么大用，可对习武之人大有助益。");
  command("say 我这里还有不少各方面的书籍，你愿意的话可以在这里看看。");
  message_vision("成斌走了出去。\n", this_player());
  destruct(this_object());
}
