inherit NPC;
string ask_didian();

void create() {
  object ob;
  set_name("郑屠户", ({ "zheng" }));
  set("gender", "男性");
  set("age", 42);
  set("long",
    "一个满脸横肉的屠户，手里还拿了把大菜刀。。。好可怕。\n");
  set("combat_exp", 15);
  set("attitude", "friendly");
  set("rank_info/respect", "屠户");
  set("inquiry", ([
    "山庄庄院": (: ask_didian :),
  ]));
  setup();
  carry_object("/u/jakey/obj/caidao")->wear();
  setup();

  ob = carry_object("/u/jakey/obj/caidao")->wear();
}

string ask_didian() {
  call_out("go_zhufang", 1, this_player());
  return "您要找谁？我带你去。\n";
}


void go_zhufang(object ob) {
  remove_call_out("go_zhufang");
  if (!ob || ob->is_fighting() || environment(ob) != environment()) return;
  tell_object(ob, "郑屠户带着你跑了一会儿，走到了一条小街上。\n");
  ob->move("/u/jakey/player/road1");
  return;
}
