inherit NPC;

void create() {
  set_name("李白", ({ "teacher", "li bai", "li" }));
  set("title", "教书先生");
  set("gender", "男性");
  set("age", 45);
  set("long", "这是一个博学多才的儒生，其实本名姓李，因极其喜爱\n"
    "唐代诗人李白的诗词，所以都让别人叫他李白，时间长\n"
    "了，真名反到被人忘却了。你只要给他一笔学费，就可\n"
    "以在他这里学习读书写字。\n");
  set("inquiry", ([
    "学费": "嗯....知识是无价的，不过如果你有心的话——只要五两银子。\n",
    "读书识字": "对，读书识字。",
  ]));
  set("chat_chance", 2);
  set("chat_msg", ({
    "李白纵声长吟道：“将进酒\n"
    "君不见黄河之水天上来，奔流到海不复回。\n"
    "君不见高堂明镜悲白发，朝如青丝暮成雪。\n"
    "人生得意须尽欢，莫使金樽空对月。      \n"
    "天生我材必有用，千金散尽还复来。      \n"
    "烹羊宰牛且为乐，会须一饮三百杯。      \n"
    "芩夫子，丹丘生，将进酒，杯莫停。      \n"
    "与君歌一曲，请君为我倾耳听。          \n"
    "钟鼓馔玉不足贵，但愿长醉不复醒。      \n"
    "古来圣贤多寂寞，惟有饮者留其名。      \n"
    "陈王昔时宴平乐，斗酒十千恣欢谑。      \n"
    "主人为何言钱少。径须沽取对君酌。      \n"
    "五花马，千金裘，呼儿将出换美酒，      \n"
    "与尔同销万古愁。”\n",
    "李白长吟道：“峨眉山月歌\n"
    "峨眉山月半轮秋，影入平羌江水流，\n"
    "夜发清溪向三峡，思君不见下渝州。\n",
    "李白吟道：“行路难\n"
    "金樽清酒斗十千，玉盘珍馐直万钱。\n"
    "停杯投箸不能食，拔剑四顾心茫然。\n"
    "欲渡黄河冰塞川，将登太行雪满山。\n"
    "闲来垂钓碧溪上，忽复乘舟梦日边。\n"
    "行路难！行路难！多歧路，今安在？\n"
    "长风破浪会有时，直挂云帆济沧海。\n",
  }));

  set("combat_exp", 10);
  set("attitude", "peaceful");
  set_skill("literate", 100);
  setup();
  carry_object("/u/jakey/obj/baicloth1")->wear();
  carry_object("/u/jakey/obj/yandai");
}

int recognize_apprentice(object ob) {
  if (!ob->query("marks/李白")) {
    say("李白说道：咦？我不记得收过你这个学生啊....\n");
    return 0;
  }

  return 1;
}

int accept_object(object who, object ob) {
  if (!who->query("marks/李白")) {
    if (ob->value() >= 500) {
      command("say 很好，从今天起你随时可以来问我有关
          读书识字(literate)的任何问题。");
      who->set("marks/李白", 1);
      return 1;
    } else {
      say("李白说道：学费请一次交清，不可以分期付款。\n");
      return notify_fail("\n");
    }
  } else
    command("say 哦，向你这麽有孝心的学生还真是不多见
，好好努力将来必定前途无量，谢了。");
  return 1;
}
