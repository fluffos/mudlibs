inherit ROOM;

void create() {
  set("short", "枫楼");
  set("long", @LONG
进了门，一阵奇香迎面而来，原来在这楼中立着四个大大的
龛样的东西，里面没有焚香，却铺满了鲜花瓣，香气四溢却令人
精神为之一爽。厅前摆着一张黑漆方桌，旁边摆着两把椅子，在
靠窗的地方放着几个立凳，上面摆着几个长颈水瓶，里面插着蓝
色的花。在一道垂帘后面是通往二层的红漆楼梯。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "out": __DIR__ "feng1",
    "up": __DIR__ "feng3",
  ]));
  set("no_clean_up", 0);
  setup();
  replace_program(ROOM);
}
