inherit ROOM;

void create() {
  set("short", "水潭");
  set("long", @LONG
这里四面是用大小的石块堆砌成为边缘，水潭的底下是一层
黑色的淤泥。在泥中有大大小小的几个泉眼带着气泡喷着温温的
水。荷花的茎从泥中钻出来，在水里象一个个翠玉色的小柱子。
七色的鲤鱼在这些翠柱间游来游去，自在的很。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "up": __DIR__ "garden",
  ]));
  set("objects", ([ /* sizeof() == 2 */
    __DIR__ "npc/liyu": 2,
  ]));
  set("no_clean_up", 0);
  setup();
}

void init() {
  add_action("do_push", "push");
  add_action("do_search", "search");
}

int do_push(string arg) {
  //	set("havepushed",0);
  if (!arg || arg == "") return 0;
  else if (arg == "石块") {
    if ((int)query("havepushed") < 2) {
      message_vision("$N用力推了推石块，石块纹丝不动。\n", this_player());
      add("havepushed", 1);
    } else {
      message_vision("$N慢慢把石块推开，出现了一条水道，一股水流把$N送了进去。\n", this_player());
      delete("havepushed");
      this_player()->move(__DIR__ "shuitan2");
    }
    return 1;
  }
}

int do_search(string arg) {
  object ob;
  if (arg == "淤泥") {
    switch (random(6)) {
      case 0: if ((int)query("got1") > 0) {
        write("你用手在淤泥里摸了一阵，什么也没有找到。\n");
        return 1;
      } else {
        message_vision("$N用手在淤泥里摸了一阵，掏出了一件物事放入怀中。\n", this_player());
        ob = new("/u/jakey/special/towerkey");
        ob->move(this_player());
        add("got1", 1);
        return 1;
      }
      case 1: if ((int)query("got2") > 0) {
        write("你用手在淤泥里摸了一阵，什么也没有找到。\n");
        return 1;
      } else {
        message_vision("$N用手在淤泥里摸了一阵，掏出了一件物事放入怀中。\n", this_player());
        ob = new("/u/jakey/obj/wastrel1");
        ob->move(this_player());
        add("got2", 1);
        return 1;
      }
      case 2: if ((int)query("got3") > 0) {
        write("你用手在淤泥里摸了一阵，什么也没有找到。\n");
        return 1;
      } else {
        message_vision("$N用手在淤泥里摸了一阵，掏出了一件物事放入怀中。\n", this_player());
        ob = new("/u/jakey/obj/wastrel2");
        ob->move(this_player());
        add("got3", 1);
        return 1;
      }
      case 3: if ((int)query("got4") > 0) {
        write("你用手在淤泥里摸了一阵，什么也没有找到。\n");
        return 1;
      } else {
        message_vision("$N用手在淤泥里摸了一阵，掏出了一件物事放入怀中。\n", this_player());
        ob = new("/u/jakey/obj/wastrel3");
        ob->move(this_player());
        add("got4", 1);
        return 1;
      }
      default: write("你用手在淤泥里摸了一阵，什么也没有找到。\n");
      return 1;
    }
  } else return 0;
}
