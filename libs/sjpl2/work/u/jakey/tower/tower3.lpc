inherit ROOM;

void create() {
  set("short", "塔内二层");
  set("long", @LONG
这里是塔的第二层，里面摆设的是个几个牌位，上面写着的
名字都是当初在江湖上赫赫有名的名人，在靠近供桌的地方有一
个石窗，风从窗口吹进来，把地上刮的干干净净。
LONG
  );
  set("exits", ([ /* sizeof() == x */
    "down": __DIR__ "tower2",
  ]));
  set("no_clean_up", 0);
  setup();
}

void init() {
  add_action("do_climb", "climb");
}

int do_climb(string arg) {
  if (arg == "石窗") {
    message_vision("$N推开石窗，身子一矮，从石窗里钻了出去。\n", this_player());
    this_player()->move(__DIR__ "tower4");
    return 1;
  } else return 0;
}
