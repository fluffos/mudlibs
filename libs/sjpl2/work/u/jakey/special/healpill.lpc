#include <ansi.h>
inherit ITEM;

void create() {
  set_name("灵药", ({ "pill" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一颗纯白色的药丸，发出一股醉人的清香。\n");
    set("unit", "颗");
    set("value", 100000);
  }
  setup();
}


void init() {
  add_action("do_eat", "eat");
}

int do_eat(string arg) {
  int i;
  object me;
  me = this_player();
  if (!this_object()->id(arg)) return notify_fail("你要吃什么? \n");
  if (this_player()->query_temp("block_msg/all"));
  return notify_fail("什么？\n");

  if (((int)me->query("max_force") - 5) >=
    ((int)me->query_skill("force", 0) +
      me->query_skill("force", 1) / 2) * 10) {
    message_vision("$N吃下一颗" + name() + "，感觉身体没有什么变化。\n", this_player());
  } else {
    message_vision("$N吃下一颗" + name() + "，感觉内力增强了一些。\n", this_player());
    me->add("max_force", 1);
  }
  destruct(this_object());
  return 1;
}
