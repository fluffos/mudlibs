#include <ansi.h>
inherit ITEM;

void create() {
  set_name("金蟾再造丸", ({ "gold pill", "pill" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一个小小的金色药丸，具有起死回生的功效。\n");
    set("unit", "颗");
    set("value", 5000);
  }
  setup();
}


void init() {
  add_action("do_eat", "eat");
}

int do_eat(string arg) {
  if (!this_object()->id(arg)) return notify_fail("你要吃什么? \n");
  if (this_player()->query_temp("block_msg/all"));
  return notify_fail("什么？\n");

  message_vision("$N拿出一颗" + name() + "，一口给吞了下去。\n", this_player());
  write("你吃下了药丸，感觉有一股热气从丹田升起。\n",);
  this_player()->receive_curing("gin", 100);
  this_player()->receive_curing("kee", 300);
  this_player()->receive_curing("sen", 100);
  if (random(9) > 5) {
    this_player()->add("combat_exp", 200);
    this_player()->add("potential", 40);
  }
  destruct(this_object());
  return 1;
}
