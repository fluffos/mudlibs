//  ninemoon_book.c

inherit ITEM;

void create() {
  set_name("玉女心经", ({ "beauty book", "book" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long",
      "这是一本看起来很旧的书，封面上写着四个篆字：玉女心经。\n");
    set("value", 1000);
    set("material", "paper");
    set("skill", ([
      "name": "beauty-force",
      "exp_required": 50000,
      "difficulty": 30,
      "sen_cost": 40,
      "max_skill": 64,
      "min_skill": 0
    ]));
  }
}
