inherit ITEM;

void create() {
  set_name("手绢", ({ "silk", "book" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "束");
    set("long",
      "这是伤心小剑用过的手绢。\n"
      "里面密密麻麻的绣着许多翩翩起舞的美女。\n");
    set("value", 500);
    set("material", "silk");
    set("skill", ([
      "name": "dodge",
      "exp_required": 0,
      "sen_cost": 10,
      "difficulty": 20,
      "max_skill": 20
    ]));
  }
}
