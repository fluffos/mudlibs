inherit ITEM;

void create() {
  set_name("纸片", ({ "paper", "book" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "这是本旧书，似乎是前代掌门所留下来的剑法。\n");
    set("value", 500);
    set("material", "silk");
    set("skill", ([
      "name": "sword",
      "exp_required": 0,
      "sen_cost": 20,
      "difficulty": 20,
      "max_skill": 14
    ]));
  }
}
