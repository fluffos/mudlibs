#include <room.h>

inherit ROOM;

void create() {
  set("short", "古墓");
  set("long", @LONG
这里已经是尽头了，前面的墙上赫然是一副巨画(drawing)。
你试着敲了敲石壁，传来“空空”声，似乎是空心的。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "south": __DIR__ "path2",
  ]));
  set("item_desc", ([
    "drawing": "画上是一个年轻美貌的女子。 \n"
    "右下角写着三个字： 林朝英 \n"
  ]));
  set("objects", ([
    "/obj/weapon/short_sword": 4,

  ]));

  set("no_clean_up", 0);

  setup();

}

void init() {

  add_action("do_ketou", ({ "ketou", "bai" }));
}
int do_ketou(string arg) {
  message_vision("$N跪在地上，恭恭敬敬地磕了三个头。\n", this_player());
  message_vision("轰的一声，只听$N一声惨叫，摔了下去...... \n", this_player());
  this_player()->move(__DIR__ "mimi");
  this_player()->unconcious();
  return 1;
}
