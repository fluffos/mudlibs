inherit ROOM;

void create() {
  set("short", "地底隧道");
  set("long", @LONG
这是古墓的地下隧道。漆黑而又潮湿，当你进入后彷佛迷失了方向！
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "west": __DIR__ "channel3",
    "east": __DIR__ "channel",
    "north": __DIR__ "channel1",
    "south": __DIR__ "channel2",

  ]));
  set("objects", ([
    __DIR__ "obj/stone": 1,
  ]));
  set("no_clean_up", 0);
  setup();

}
void init() {
  add_action("do_rotate", "rotate");
  add_action("do_rotate", "zhuan");
}

int do_rotate(string arg) {

  if (arg == "石头") {
    message_vision("$N小心翼翼的拧了几下，只听“嘎”的一声，出现了一扇门。 \n", this_player());
    message_vision("$N犹豫了一下，还是走了进去。\n", this_player());
    this_player()->move(__DIR__ "corridor");
    message_vision("$N从外面走了进来。\n", this_player());
  } else write("你想干什么？\n");
  return 1;
}
