#include <room.h>

inherit ROOM;

void create() {
  set("short", "内洞");
  set("long", @LONG
你进了内洞，抬头一看，只见四面石壁，玲珑剔透，琴剑书画，
挂于壁上。地上铺的是大理硬砖，左一书架，右一石桌，旁边一凳。
北面的石壁上似乎有一道缝隙。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "north": __DIR__ "hole",
    "south": __DIR__ "channel4",
    "northwest": __DIR__ "kitchen",
    "east": __DIR__ "path",
  ]));


  set("objects", ([
    __DIR__ "obj/guancai": 1,
    __DIR__ "npc/weibao": 1,
  ]));


  set("no_clean_up", 0);

  create_door("north", "石壁", "south", DOOR_CLOSED);

  setup();

}
