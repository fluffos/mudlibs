#include <room.h>

inherit ROOM;

void create() {
  set("short", "大石洞");
  set("long", @LONG
这里是个高约数丈的大石洞，洞的四个角上个挂着一个烛台，
但烛台上放的不是蜡烛，而是一颗龙眼夜明珠。照亮了整个山洞。
西面放着一张石床，相隔甚远都能感觉到阵阵寒气，难道这就是
传说中的水晶床？
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "south": __DIR__ "corridor",
    "north": __DIR__ "yunvhole",

  ]));

  set("objects", ([
    __DIR__ "obj/guancai": 1,
    __DIR__ "book/unarmedbook": 1,

  ]));

  set("no_clean_up", 0);

  create_door("south", "石壁", "north", DOOR_CLOSED);

  setup();
  replace_program(ROOM);
}
