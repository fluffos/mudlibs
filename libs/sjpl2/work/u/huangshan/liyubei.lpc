//huangshan liyubei.c
inherit ROOM;
int do_tiao(string str);

void create() {
  set("short", "鲤鱼背");
  set("long", @LONG
鲤鱼背，顾名思义，就是一块象鲤鱼背一样的巨石，通过鲤鱼背即可以到达
猴子望海，那里有个江湖奇侠武林异人隐居着，但是要上鲤鱼背可不是件容易的
事，必须是真正的武林强者才能上得鲤鱼背见到那位奇人。
LONG);


  set("exits",
    ([  //sizeof() == 4
    "northup": __DIR__ "wanghai",
    ]));

  set("objects",
    ([  //sizeof() == 1
    //		__DIR__"npc/huang" : 2,
    ]));


  set("outdoors", "huangshan");
  set("no_clean_up", 0);
  setup();
}
void init() {
  add_action("do_tiao", "jump");
}

int do_tiao(string str) {
  object room, me = this_player();

  if (str != "石下") return 0;
  if (me->query_skill("dodge", 1) < 10)
    message_vision("$N往下一跃，结果扑通一声摔到地上！\n", me);
  else
    message_vision("$N纵身一跃，从巨石的顶上轻飘飘地跃下去了。\n", me);
  if (!(room = find_object(__DIR__ "wangyue")))
    room = load_object(__DIR__ "wangyue");
  me->move(room);
  return 1;
}
