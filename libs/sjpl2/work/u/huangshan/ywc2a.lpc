inherit ROOM;

void create() {
  set("short", "天都峰顶");
  set("long", @LONG
天都峰顶与莲花峰遥遥相对，群山环抱之中只见十丈见方的场地上
整整齐齐地铺着一圈彩色玛瑙石，架着香烟袅绕的四个巨大金银铜铁鼎，
场地中间是软松的皮绒织锦毯。
LONG);

  set("exits", ([
    "east": __DIR__ "ywc2b.lpc",
  ]));
  set("objects", ([
    __DIR__ "npc/wu22": 1,
  ]));
  set("outdoors", "/u/huangshan");

  setup();
}
