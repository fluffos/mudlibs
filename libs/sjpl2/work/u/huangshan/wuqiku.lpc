inherit ROOM;

void create() {
  set("short", "武器库");
  set("long", @LONG
这里是万松山庄的武器库，库内的武器架上摆满了兵器，不论你需要什么，
这里都能找到，在犀牛望月比武的高手可以到这里找到自己趁手的武器。巫师
可从檀木架子上拿(take)武器分发给参加大会的赛手。架子上放有：
  大板斧：    axe
  钢刀：      blade
  钢叉：      fork
  熟铜锏：    mace
  钢耙：      rake
  长枪：      spear
  禅杖：      staff
  镔铁棍：    stick
  长剑：      sword
  飞璜石：    throwing
  皮鞭：      whip
  匕首：      dagger
  铁锤：      hammer

LONG);

  set("exits", ([
    "east": __DIR__ "dating",
  ]));

  setup();
}

void init() {
  add_action("do_take", "take");
  add_action("do_take", "na");
}

int do_take(string arg) {
  object who = this_player();
  object ob;

  if (!wizardp(who))
    return notify_fail("对不起，请让巫师替您来拿东西。\n");

  if (!arg)
    return notify_fail("您要拿什么？\n");
  if (arg == "axe")
    ob = new("/d/city/obj/weapon/standard/axe");
  else if (arg == "blade")
    ob = new("/d/city/obj/weapon/standard/blade");
  else if (arg == "dagger")
    ob = new("/d/city/obj/weapon/standard/dagger");
  else if (arg == "fork")
    ob = new("/d/city/obj/weapon/standard/fork");
  else if (arg == "hammer")
    ob = new("/d/city/obj/weapon/standard/hammer");
  else if (arg == "mace")
    ob = new("/d/city/obj/weapon/standard/mace");
  else if (arg == "rake")
    ob = new("/d/city/obj/weapon/standard/rake");
  else if (arg == "spear")
    ob = new("/d/city/obj/weapon/standard/spear");
  else if (arg == "staff")
    ob = new("/d/city/obj/weapon/standard/staff");
  else if (arg == "stick")
    ob = new("/d/city/obj/weapon/standard/stick");
  else if (arg == "sword")
    ob = new("/d/city/obj/weapon/standard/sword");
  else if (arg == "throwing")
    ob = new("/d/city/obj/weapon/standard/throwing");
  else if (arg == "whip")
    ob = new("/d/city/obj/weapon/standard/whip");
  else
    return notify_fail("您要拿什么？\n");
  message_vision("$N从架子上拿起$n。\n", who, ob);
  ob->move(who);
  return 1;
}
