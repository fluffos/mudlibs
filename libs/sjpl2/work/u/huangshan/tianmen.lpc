//huangshan tianmen.c
inherit ROOM;

void create() {
  set("short", "金鸡叫天门");
  set("long", @LONG
这里是黄山有名的金鸡叫天门,也可以说是黄山的门户,是黄山的一奇,可以
看到一块金鸡形的巨石象是要扣开天门,由此而上就是黄山的主峰了,向上望去
可以看到一块巨石。
LONG);


  set("exits",
    ([  //sizeof() == 4
    "northup": __DIR__ "shanhuawu",
      "southdown": __DIR__ "shijie1",
    ]));

  set("objects",
    ([  //sizeof() == 1
    "/npc/nknpc": 1,
    ]));


  set("outdoors", "huangshan");
  set("no_clean_up", 0);
  setup();
}
