// by baiwt 

inherit NPC;
string reward_more(object who);

string *names = ({
  "僧人",
  "和尚",
  "道士",
  "道长",
  "祭师",
});

string *ids = ({
  "seng ren",
  "he shang",
  "dao shi",
  "dao zhang",
  "ji shi",
});

string *genders = ({
  "男性",
  "男性",
  "男性",
  "男性",
  "男性",
});

void create() {
  int i = random(sizeof(names));
  set_name(names[i], ({ ids[i] }));
  set("gender", genders[i]);
  set("combat_exp", 400 + random(4000));
  set("age", 50 + random(50));
  set("per", 24 + random(20));
  set("attitude", "friendly");
  set("str", 20 + random(20));
  set_skill("unarmed", 30 + random(50));
  set_skill("dodge", 30 + random(50));
  set_skill("parry", 30 + random(50));
  set("chat_chance", 10);
  set("chat_msg", ({
    (: random_move :)
  }));
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: reward_more(this_object()) :),
  }));
  setup();
  carry_object("/d/city/obj/cloth/changpao")->wear();
  add_money("silver", random(5));
}
string reward_more(object who) {
  int i;
  object *enemy;
  seteuid(getuid());
  enemy = who->query_enemy();
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      if (enemy[i]->query("combat_exp") < 5000) return "1";
      if (enemy[i]->query("combat_exp") > 10000) return "1";
      enemy[i]->add("combat_exp", 1);
      if (enemy[i]->query("potential") - enemy[i]->query("learned_points") > 200) return "1";
      enemy[i]->add("potential", 1);
    }
  }
  return "1";
}
