#include <ansi.h>
#include <room.h>

inherit ROOM;

void create() {
  set("short", "冰天雪地");
  set("long", @LONG
这是一片漫无边际的冰天雪地，到处可见冰川和冰斗。雪地高原气势
磅礴，终年积雪不化，厚厚的雪层足有数十尺深，白茫茫地渺无人烟。刺
骨的寒风夹带着雪花冰珠时不时向你袭来，让你难以呼吸和行走。脚下的
积雪软绵绵的无处着力，你不由得心中发毛，禁不住感叹天地间自然力量
的可怕。
LONG
  );
  set("exits", ([
    "west": "/u/baiwt/xueshan/huangyie0",
    "east": __DIR__ "desert9",
  ]));
  set("item_desc", ([
    "积雪": "这是一片厚厚的积雪层，软软的一脚就能踩个深坑，让人有种如履薄冰的感觉。\n",
  ]));

  set("outdoors", "quicksand");

  setup();
}
