#include <ansi.h>

inherit NPC;
int about_baohu();

void create() {
  set_name("张三丰", ({ "master zhang", "master" }));
  set("long",
    "她是江湖盛传的[一剑、双拐]中的双拐樊长江的老伴.\n" +
    "她两鬓班白,饱经风霜.\n");
  set("title", "流星拐");
  set("gender", "男性");
  set("age", 60);
  set("attitude", "peaceful");
  set("inquiry", ([
    "随行": (: about_baohu :),
  ]));

  set("str", 30);
  set("int", 25);
  set("combat_exp", 1200000);

  set("max_kee", 1000);
  set("kee", 1000);
  set("sen", 500);
  set("max_sen", 500);
  set("force", 1000);
  set("max_force", 1000);

  set_skill("force", 100);
  set_skill("unarmed", 100);
  set_skill("dodge", 100);
  set_skill("parry", 100);
  set_skill("staff", 150);

  set_skill("starstaff", 150);
  set_skill("mystforce", 100);
  set_skill("yueying-wubu", 100);
  set_skill("liuh-ken", 100);
  map_skill("unarmed", "liuh-ken");

  map_skill("force", "mystforce");
  map_skill("dodge", "yueying-wubu");
  map_skill("staff", "starstaff");
  setup();
}

int accept_fight(object me) {
  command("say 琼宫圣地不准动武。");
  return 0;
}
int about_baohu() {
  object me, soldier;
  object *t;
  me = this_player();
  //if 你不是武当弟子！
  if (pointerp(t = me->query_team())) {
    command("say 已经有师兄弟保护你了，好自为之！\n");
    return;
  }
  command("say 好吧，我让你的师兄弟与你同行。\n");
  message_vision(CYN "\n从门外走进来一名武当弟子，躬身说道：师父请吩咐！\n" NOR, me);
  message_vision(HIM "\n张三丰说道：武当弟子保护$N一起下山吧！\n" NOR, me);
  message_vision(CYN "\n武当弟子躬身说道：谨遵师命！\n" NOR, me);
  soldier = new(__DIR__ "wddizi.lpc");
  soldier->move(environment(me));
  me->add_team_member(soldier);
  soldier->add_team_member(me);
  soldier->set_leader(me);
  return 1;
}
