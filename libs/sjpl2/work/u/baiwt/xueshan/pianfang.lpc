inherit ROOM;
void create() {
  set("short", "放鹤厅偏房");
  set("long", @LONG
这是雪山放鹤厅的偏房。房间不大，正对着你的墙壁上挂着一幅琼宫
地图(map)。雪山弟子只有在最初行拜师礼的时候才能进入这间房间。由于
雪山弟子一生中只能来这里一次，所以每一个来这里的弟子都应该将琼宫
地图记录下来，以免今后在宫中迷失方向。
LONG);
  set("exits", ([
    "out": __DIR__ "dating",
  ]));
  set("no_fight", 1);
  set("item_desc", ([
    "map":
    "这是一张记录琼宫各内宫方位的地图，乃琼宫弟子所必备。\n" +
    "\n" +
    "　　　琼宫回廊－彩凤宫－琼宫回廊－洗剑池－琼宫回廊\n" +
    "　　／　　　　　　｜　　　　｜　　　｜　　　　　　＼　\n" +
    "睡莲宫　　　　琼宫回廊　　小天湖　琼宫回廊　　　　翠萍宫\n" +
    "　　＼　　　／　　　　　　　　　　　　　　＼　　　／\n" +
    "　　琼宫回廊　　　　　　　　　　　　　　　　琼宫回廊\n" +
    "　　　｜　　＼　　　　　　　　　　　　　　／　　｜\n" +
    "　　瑶竹宫　智慧宫　　　　　　　　　　寒冰洞　玉藕宫\n" +
    "　　　　　＼　　　　　　　　　　　　　　　　　／\n" +
    "　　　　　　琼宫回廊　　　　　　　　　琼宫回廊\n" +
    "　　　　　　　　　　＼　　　　　　　／\n" +
    "　　　　　　　　　　　　放　鹤　厅\n" +
    "\n",
  ]));
  setup();
}
