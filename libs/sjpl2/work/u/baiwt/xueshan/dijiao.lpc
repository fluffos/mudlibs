#include <ansi.h>

inherit ROOM;
void init();
int do_push(string);
void create() {
  set("short", "地窖");
  set("long", @LONG
这是一个阴暗潮湿的地窖，只有顶上被干草覆盖的洞口透下一点光亮。
LONG
  );
  set("sleep_room", 1);
  //  set("exits",([
  //      "westdown" : __DIR__"shanlu1",
  //     ]));
  set("objects", ([
    __DIR__ "obj/jade1": 1,
    __DIR__ "npc/obj/xuebook": 1,
    __DIR__ "obj/shuzhi": 1,
    __DIR__ "npc/obj/silver": 1,
  ]));

  setup();
  //replace_program(ROOM);
}

void init() {
  add_action("do_push", "push");
}

int do_push(string arg) {
  object me = this_player(), room;

  if (!arg || arg != "干草")
    return notify_fail("你要推什么？\n");

  if (!(room = find_object(__DIR__ "xiaowu")))
    room = load_object(__DIR__ "xiaowu");

  if (!objectp(room))
    return notify_fail("ERROR:not found 'dijiao.c' \n");
  message_vision("\n$N顶着满头的杂草钻了出来。\n", me);
  message_vision(NOR "\n", me);
  me->move(room);
  return 1;
}
