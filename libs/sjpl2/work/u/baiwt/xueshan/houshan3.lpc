#include <ansi.h>
#include <room.h>

inherit ROOM;

void init();
int do_zuan(string);

void create() {
  set("short", "雪山后山");
  set("long", @LONG
这里是雪山后山。由于长年大雪纷飞，这里始终是白雪皑皑，寒风在
山间呼啸掠过，使人呼吸困难，浑身打颤。据说后山人迹稀少，又常有野
兽出没。山间还有一段冻结了的冰河，有一个白发野人经常站在冰河之上
浩叹长空。你面前是悬崖峭壁，已没有前进之路。山壁上隐约有一个冰洞.
LONG
  );
  set("outdoors", "xueshan");
  set("exits", ([
    "southdown": __DIR__ "houshan2",
  ]));
  set("item_desc", ([
    "冰洞": "这是一个神秘的小冰洞，你也许可以钻(zuan)进去。\n",
  ]));
  set("NONPC", 1);

  set("objects", ([
    __DIR__ "npc/mastergu": 1,
  ]));

  setup();
}

void init() {
  add_action("do_zuan", "zuan");
}

int do_zuan(string arg) {
  object me = this_player(), room;

  if (!arg || arg != "冰洞")
    return notify_fail("你要钻什么？\n");

  if (!(room = find_object(__DIR__ "bdong")))
    room = load_object(__DIR__ "bdong");

  if (!objectp(room))
    return notify_fail("ERROR:not found 'bdong.c' \n");
  message_vision("$N小心翼翼从山壁旁的小冰洞钻了进去。\n\n", me);
  me->move(room);
  return 1;
}
