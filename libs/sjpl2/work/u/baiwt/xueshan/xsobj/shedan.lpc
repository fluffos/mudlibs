inherit ITEM;
inherit F_FOOD;
void create() {
  int i;
  string *names = ({
    "竹叶青蛇胆", "眼镜蛇胆", "蝮蛇胆", "大蟒蛇胆",
  });
  i = random(4);
  set_name(names[i], ({ "shedan" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一颗奇苦无比的蛇胆。\n");
    set("unit", "颗");
    set("value", 0);
    set("objattrib", 1);
    set("food_remaining", 1);
    set("food_supply", 10);
  }
}
