inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("野生植物", ({ "zhiwu" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一株名贵的野生植物。\n");
    set("unit", "株");
    set("objattrib", 1);
    set("identify_name", "何首乌");
    set("food_remaining", 1);
    set("food_supply", 10);
  }
}
