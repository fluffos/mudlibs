#include <ansi.h>

inherit NPC;
string ask_me();
string mark_you();

void create() {
  set_name("墨无为", ({ "mo wuwei", "mo" }));
  set("long", @LONG
他就是名动江湖的墨无为，由于作恶江湖而被囚禁于此。他已被冻僵了。
LONG
  );
  set("title", "武林四恶之一");
  set("gender", "男性");
  set("nickname", HIG "恶道人" NOR);
  set("age", 40);
  set("shen_type", -1);
  set("attitude", "peaceful");

  set("str", 27);
  set("int", 23);

  set("max_kee", 1000);
  set("kee", 1000);
  set("gin", 500);
  set("max_gin", 500);
  set("force", 1000);
  set("max_force", 1000);

  set("combat_exp", 1200000);
  set("score", 100000);
  set_skill("parry", 100);
  set_skill("dodge", 100);
  set_skill("unarmed", 150);
  set_skill("force", 100);
  set_skill("black_claw", 160);
  map_skill("unarmed", "black_claw");

  set("inquiry", ([
    "星河帖": (: ask_me :),
  ]));
  set("chat_chance", 3);
  set("chat_msg", ({
    "墨无为喃喃道：我一定要揭开星河宫之谜！\n",
  }));
  set("wan_count", 1);
  setup();
}

string ask_me() {
  object ob;
  object me = this_player();
  if (query("wan_count") < 1)
    return "不好意思，已经有人捷足先登了，你下次再来吧。";
  add("wan_count", -1);
  ob = new("/u/baiwt/xueshan/obj/bomb");
  ob->move(this_player());
  me->set("marks/墨无为", 1);
  say("墨无为说道：这位" + RANK_D->query_respect(me)
    + "，你去雪山冰瀑，把它炸（ｂｏｍｂ）出来．\n");
  return "唉，看在你舍身救我的份上，这颗[碧焰阴雷]就给你吧。";
}
