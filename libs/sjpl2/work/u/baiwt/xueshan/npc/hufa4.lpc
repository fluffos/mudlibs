// NPC yupopo.c

#include <ansi.h>

inherit NPC;
int about_he();

void create() {
  set_name("邝振天", ({ "kuang" }));
  set("long",
    "这是一个四十五六岁的中年人, 浓眉大眼,\n" +
    "身穿一件华贵雅致的长袍, 倒使他更显几分精神.\n" +
    "他位居四大护法之一.\n");
  set("title", "雪山琼宫四大护法之一");
  set("gender", "男性");
  set("age", 46);
  set("nickname", HIC "苍龙" NOR);
  set("shen_type", 1);
  set("attitude", "peaceful");

  set("str", 20);
  set("int", 30);
  set("cor", 20);
  set("cps", 30);
  set("spi", 30);
  set("kee", 1000);
  set("max_kee", 1000);
  set("sen", 500);
  set("max_sen", 500);
  set("force", 1000);
  set("max_force", 1000);

  set("force", 3000);
  set("max_force", 3000);
  set("force_factor", 50);

  set("atman", 2000);
  set("max_atman", 2000);

  set("mana", 4000);
  set("max_mana", 2000);
  set("mana_factor", 50);

  set("inquiry", ([
    "琼宫": (: about_he :),
  ]));

  set("combat_exp", 5000000);
  set("score", 20000);

  set_skill("literate", 180);
  set_skill("force", 180);
  set_skill("unarmed", 180);
  set_skill("whip", 200);
  set_skill("parry", 180);
  set_skill("dodge", 180);
  set_skill("xuanyinforce", 180);
  set_skill("snowwhip", 200);
  set_skill("xuanyinforce", 180);
  set_skill("fengxue-steps", 180);

  map_skill("force", "xuanyinforce");
  map_skill("parry", "snowwhip");
  map_skill("whip", "snowwhip");
  map_skill("unarmed", "piaoxue-strike");
  map_skill("dodge", "fengxue-steps");

  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    //                (: perform_action, "whip.hunranyijian" :),
    (: exert_function, "recover" :),
  }));

  create_family("雪山琼宫", 3, "弟子");

  setup();
  carry_object(__DIR__ "obj/cloth")->wear();
  carry_object(__DIR__ "obj/whip")->wield();
  add_money("silver", 40);
}

int about_he() {
  command("say 好吧，我成全你，你可以坐仙鹤过去，要好自为之！(ride) \n");
  this_player()->add_temp("xueshan/allow_fly", 1);
  return 1;
}
