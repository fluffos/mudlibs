#include <ansi.h>
inherit NPC;

void create() {
  set_name("崔如风", ({ "langjun" }));
  set("gender", "男性");
  set("age", 34);
  set("long",
    "他是武林四恶中最阴毒的[恶郎君]崔如风，与琼宫公主有不共戴天之仇。\n"
  );
  set("title", "武林四恶之一");
  set("nickname", HIG "恶郎君" NOR);
  set("max_kee", 700);
  set("kee", 700);
  set("sen", 500);
  set("max_sen", 500);
  set("force", 1000);
  set("max_force", 1000);

  set("combat_exp", 1200000);
  set("score", 100000);
  set_skill("sword", 150);
  set_skill("shedu-sword", 150);
  set_skill("parry", 100);
  set_skill("dodge", 100);
  set_skill("unarmed", 100);
  set_skill("liuh-ken", 150);
  map_skill("unarmed", "liuh-ken");
  map_skill("sword", "shedu-sword");
  setup();
  carry_object(__DIR__ "obj/cloth")->wear();
  carry_object(__DIR__ "obj/longsword")->wield();
}
