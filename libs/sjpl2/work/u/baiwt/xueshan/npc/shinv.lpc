#include <ansi.h>

inherit NPC;

void create() {

  set_name("琼宫侍女", ({ "shinv", "nv" }));
  set("long", "这是一个清丽可人的琼宫侍女。\n");
  set("attitude", "friendly");

  set("str", 40);
  set("cor", 30);
  set("cps", 25);

  set("combat_exp", 800000);
  set("chat_chance", 1);
  set("chat_msg_combat", ({
    "琼宫侍女喝道：竟敢在琼宫撒野！活得不耐烦了！\n",
  }));
  set_skill("sword", 30 + random(50));
  set_skill("unarmed", 30 + random(50));
  set_skill("dodge", 30 + random(70));

  setup();

  carry_object(__DIR__ "obj/qingyi")->wear();
  carry_object(__DIR__ "obj/longsword")->wield();
}

int heal_up() {
  if (environment() && !is_fighting()) {
    call_out("leave", 1);
    return 1;
  }
  return ::heal_up() + 1;
}

void leave() {
  message("vision",
    HIW + name() + "杏眼一瞪，说道：还不快下山去！\n\n"
    +name() + "跺了跺脚，一溜烟跑了。\n" NOR, environment(),
    this_object());
  destruct(this_object());
}
