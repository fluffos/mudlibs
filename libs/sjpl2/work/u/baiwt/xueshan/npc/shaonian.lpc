// dtz.c

inherit NPC;
string reward_more(object who);

void create() {
  set_name("江湖少年", ({ "shaonian" }));
  set("gender", "男性");
  set("age", 22);
  set("long", "一个英豪的江湖少年.\n");

  set("combat_exp", 2000);
  set("attitude", "heroism");
  set_skill("unarmed", 20);
  set("chat_chance", 10);
  set("chat_msg", ({
    "少年坚定地说道：尽管上雪山难于登天，我也一定要找到琼宫主人！\n",
    "少年无限向往地说道：我要是能成为琼宫弟子就好了！\n",
    "少年若有所思地说道：莲儿这小姑娘好象有点来头...\n",
    (: random_move :)
  }));
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: reward_more(this_object()) :),
  }));

  setup();
  add_money("silver", 1);
  carry_object(__DIR__ "obj/cloth")->wear();

}
string reward_more(object who) {
  int i;
  object *enemy;
  seteuid(getuid());
  enemy = who->query_enemy();
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      if (enemy[i]->query("combat_exp") < 100) return "1";
      if (enemy[i]->query("combat_exp") > 1000) return "1";
      enemy[i]->add("combat_exp", 1);
      if (enemy[i]->query("potential") - enemy[i]->query("learned_points") > 100) return "1";
      else
        enemy[i]->add("potential", 1);
    }
  }
  return "1";
}
int accept_fight(object me) {
  return 1;
}
