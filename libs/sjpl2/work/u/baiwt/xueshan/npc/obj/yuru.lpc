// medicine.c

inherit ITEM;

void create() {
  set_name("琼宫玉乳", ({ "yuru" }));
  set_weight(60);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "一支雪山灵芝，可以服用（yong）来治伤 。\n");
    set("unit", "支");
    set("value", 2000);
  }
}

void init() {
  if (this_player() == environment())
    add_action("apply_medicine", "yong");
}

int apply_medicine() {
  int value = 100;
  int diff;

  if (this_player()->is_fighting())
    return notify_fail("战斗中不能服用灵芝！！\n");
  diff = this_player()->query("max_kee") - this_player()->query("eff_kee");
  if (!(diff)) return notify_fail("你没有受伤！\n");
  if (value > diff) value = diff;

  message_vision("$N服用雪山灵芝疗伤 ．\n", this_player());
  this_player()->add("eff_kee", value);
  destruct(this_object());
  return 1;
}
