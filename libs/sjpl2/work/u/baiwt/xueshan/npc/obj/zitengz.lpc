#include <weapon.h>
#include <ansi.h>
inherit DAGGER;

void create() {
  set_name(HIM "紫藤" NOR + "拐杖" NOR, ({ "ziteng zhang" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是一把紫色的鹿筋藤杖，传说土地之神用来测知风水的。\n");
    set("value", 4000);
    set("material", "steel");
    set("wield_msg", "$N「呼」地一声把$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n拄在地上。\n");
  }
  init_dagger(25);
  setup();
}
