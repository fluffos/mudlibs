#include <ansi.h>

inherit ITEM;

void create() {
  set_name("地灵符", ({ "earth sheet" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("material", "steel");
    set("long", "一块铜制小牌，上面刻着[地灵符]三个字。你可以祭(ji)\n");
  }
}

void init() {
  add_action("do_ji", "ji");
}

int do_ji(string arg) {
  object tudi;
  object me = this_player(), room;
  if (arg != "earth sheet") return 0;
  seteuid(getuid());
  tudi = new("/u/xueshan/npc/tudi");
  tudi->move(environment(me));
  //        me->remove_all_killer();
  message_vision(HIC "$N拿起" + this_object()->name() + "往空一举，口中念念有词：山灵灵，地灵灵，土地老儿快显灵！\n" NOR, me);
  message_vision(HIB "\n只见一阵烟雾过后，$N咳嗽一声从地下钻了出来！\n" NOR, tudi);

  //        environment(this_player())->earth_notify();

  return 1;
}
