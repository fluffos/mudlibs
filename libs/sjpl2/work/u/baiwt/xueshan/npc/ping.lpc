#include <ansi.h>
inherit NPC;
string summon_more(object who);

void create() {
  set_name("萍儿", ({ "ping er", "ping" }));
  set("long",
    "她是「翠兰倚萍」四大侍女之一.\n" +
    "眼如点漆, 清秀绝俗.\n");
  set("gender", "女性");
  set("age", 17);
  set("shen_type", 1);
  set("attitude", "peaceful");
  set("max_gin", 9000);
  set("max_kee", 9000);
  set("max_sen", 9000);
  set("eff_gin", 9000);
  set("eff_kee", 9000);
  set("eff_sen", 9000);
  set("gin", 9000);
  set("kee", 9000);
  set("sen", 9000);
  set("max_atman", 300);
  set("atman", 300);
  set("max_mana", 300);
  set("mana", 300);

  set("max_force", 1000);
  set("force", 1000);
  set("force_factor", 10);

  set("combat_exp", 1000000);
  set("score", 10000);
  set_skill("force", 100);
  set_skill("unarmed", 100);
  set_skill("dodge", 100);
  set_skill("parry", 100);
  set_skill("sword", 100);

  set_skill("bingchuan-sword", 100);
  set_skill("fengxue-steps", 100);
  set_skill("xuanyinforce", 100);
  set_skill("piaoxue-strike", 100);
  set_skill("stealing", 900);

  map_skill("force", "xuanyinforce");
  map_skill("dodge", "fengxue-steps");
  map_skill("unarmed", "piaoxue-strike");
  map_skill("parry", "bingchuan-sword");
  map_skill("sword", "bingchuan-sword");
  set("chat_chance_combat", 100);
  set("chat_msg_combat", ({
    (: summon_more(this_object()) :),
  }));

  create_family("雪山琼宫", 3, "侍女");
  setup();
  carry_object(__DIR__ "obj/qingyi")->wear();
  carry_object(__DIR__ "obj/doupeng")->wear();
  carry_object(__DIR__ "obj/longsword")->wield();
  add_money("gold", 15);
}

void init() {
  add_action("do_gogo", "go");
}

int do_gogo(string arg) {
  object me;
  me = this_player();
  if (arg == "east") {
    if (me->query("class"))
      if (me->query("class") != "noname") {
        command("say 把[星河帖]拿来，才能让你进去。");
        write("这个方向的路被萍儿挡住了 。\n");
        return 1;
      } else
        return 0;
  } else
    return 0;
}

int accept_object(object who, object ob) {
  object me, room;
  me = this_player();
  if (!(room = find_object("/u/baiwt/xueshan/shufang")))
    room = load_object("/u/baiwt/xueshan/shufang");
  if (!objectp(room))
    return notify_fail("ERROR:not found 'shufang.c' \n");

  if (ob->name() == "星河帖") {
    if ((int)ob->query("objattrib") != 1) return 0;
    message_vision(HIC "\n萍儿微笑着点了点头，说道：进去吧！\n\n" NOR, me);
    me->move(room);
    message_vision(HIC "\n萍儿领着$N走了进来，然后转身出去了。\n\n" NOR, me);
    return 1;
  } else {
    say("萍儿冷哼一声，说道：你有什么企图？\n");
    return 0;
  }

  return 1;
}

string summon_more(object who) {
  int i;
  object *enemy;
  object another;
  seteuid(getuid());
  another = new(__DIR__ "shinv");
  another->move(environment(who));
  message_vision(another->name() + "走了过来。\n"
    , this_object());
  enemy = who->query_enemy();
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      another->kill_ob(enemy[i]);
      another->set_leader(enemy[i]);
      enemy[i]->unconcious();
    }
  }
  return "1";
}

int accept_fight(object me) {
  command("say 琼宫圣地不准动武。");
  return 0;
}
