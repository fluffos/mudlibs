#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create() {
  set_name("冷凝珠", ({ "master leng", "leng", "master" }));
  set("long",
    "这是一个看上去三十五六岁的少妇, 丰韵美丽,\n" +
    "但是十多年前不幸遗失了自己的孩子，使她这些年来憔悴了不少.\n" +
    "她是雪珠连的妻子.\n");
  set("title", "雪山琼宫夫人");
  set("gender", "女性");
  set("age", 39);
  set("nickname", HIW "冰圣母" NOR);
  set("shen_type", 1);
  set("attitude", "peaceful");

  set("str", 20);
  set("int", 30);
  set("per", 50);
  set("cps", 30);
  set("spi", 30);
  set("max_kee", 4000);
  set("max_gin", 4000);
  set("max_sen", 4000);
  set("kee", 4000);
  set("gin", 4000);
  set("sen", 4000);

  set("force", 3000);
  set("max_force", 3000);
  set("force_factor", 50);

  set("combat_exp", 50000000);
  set("score", 200000);

  set_skill("literate", 250);
  set_skill("force", 250);
  set_skill("unarmed", 250);
  set_skill("sword", 250);
  set_skill("parry", 250);
  set_skill("dodge", 250);
  set_skill("mystforce", 250);
  set_skill("mystsword", 250);
  set_skill("piaoxue-strike", 250);
  set_skill("mysterrier", 250);
  set_skill("konghegong", 250);
  set_skill("xuanyinforce", 250);

  map_skill("force", "mystforce");
  map_skill("parry", "mystsword");
  map_skill("sword", "mystsword");
  map_skill("unarmed", "piaoxue-strike");
  map_skill("dodge", "mysterrier");

  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "dodge.miejue" :),
    (: exert_function, "recover" :),
  }));

  create_family("雪山琼宫", 2, "弟子");
  set("class", "snowman");

  setup();
  carry_object(__DIR__ "obj/icy_cloth")->wear();
  carry_object(__DIR__ "obj/longsword")->wield();
  add_money("silver", 50);
}

void attempt_apprentice(object ob) {
  if ((int)ob->query_skill("mysterrier", 1) < 40) {
    command("say " + RANK_D->query_respect(ob) + "是否还应该多练练步玄七诀？");
    return;
  }
  if ((string)ob->query("gender") == "女性") {
    message_vision("冷凝珠垂目沉思片刻, 说道：“好吧, 我就收下你了。”\n", ob);
    command("recruit " + ob->query("id"));
    if ((string)ob->query("class") != "snowman")
      ob->set("class", "snowman");
    if (ob->query("betrayer") < 10)
      ob->add("potential", 300);
    ob->move("/u/baiwt/xueshan/pianfang.lpc");
    return;
  } else {
    message_vision("冷凝珠冷冷说道：“阁下本领非凡，哪里会诚心拜师？”\n", ob);
    return;
  }
}

int accept_object(object who, object ob) {
  object me;
  object yinlian;
  me = this_player();
  if (ob->name() == "玉莲佩") {
    if ((int)ob->query("objattrib") != 1) return 0;
    if ((int)me->query_temp("lianjian") == 1) return 0;
    yinlian = new(__DIR__ "obj/yinlian");
    yinlian->move(me);
    say("冷凝珠眼中含泪，说道：啊，这是我给小女的玉佩啊！\n");
    say("冷凝珠说道：多谢这位" + RANK_D->query_respect(who)
      + "告诉我女儿的消息，这把剑作为酬劳送给你吧！\n");
    me->set_temp("lianjian", 1);
    return 1;
  } else {
    say("冷凝珠冷哼一声，说道：你有什么企图？\n");
    return 0;
  }

  return 1;
}
int do_unwie() {
  if (!this_object()->is_fighting()) {
    command("unwield sword");
    command("smile");
    return 1;
  } else
    call_out("do_unwie", 3);
}

void init() {
  add_action("do_killing", "kill");

}

int do_killing(string arg) {

  object player, victim, weapon;
  string name;
  player = this_player();
  if (objectp(victim = present(arg, environment(this_object()))) && living(victim)) {
    name = victim->name();
    if (name == "雪珠连") {
      message_vision("$N皱皱眉头。\n", this_object());
      weapon = present("sword", this_object());
      weapon->wield();
      this_object()->kill_ob(player);
      player->kill_ob(this_object());
      call_out("do_unwie", 3);
      return 0;
    }
    if (name == "冷凝珠") {
      message_vision("$N皱皱眉头。\n", this_object());
      weapon = present("sword", this_object());
      weapon->wield();
      call_out("do_unwie", 3);
      return 0;
    }
    return 0;
  }
  return 0;
}
int accept_fight(object me) {
  command("say 琼宫圣地不准动武。");
  return 0;
}
