#include <ansi.h>

inherit NPC;
inherit F_MASTER;
int about_he1();
int about_he2();
int about_he3();
int about_he4();

void create() {
  set_name("司徒昌明", ({ "situ", "master" }));
  set("long",
    "这是个身形伟岸，长髯飘胸的剑客，大名鼎鼎的神州剑客的嫡传.\n" +
    "江湖盛传的[一剑、双拐、三奇、四恶]中的一剑就是他。\n" +
    "传说[风雷一剑]虽只一招，却是武林一大绝技。\n");
  set("gender", "男性");
  set("age", 48);
  set("shen_type", 1);
  set("nickname", HIC "神州一剑" NOR);
  set("attitude", "peaceful");
  set("chat_chance", 10);
  set("chat_msg", ({
    "司徒昌明说道：虽然我只学到了无名老人的一招剑法，也要把它发扬光大！\n",
    "司徒昌明傲然说道：学成雪山琼宫的任何一种武功就足以纵横天下！\n",
  }));
  set("inquiry", ([
    "一剑": (: about_he1 :),
    "双拐": (: about_he2 :),
    "三奇": (: about_he3 :),
    "四恶": (: about_he4 :),
  ]));

  set("str", 30);
  set("int", 30);
  set("cor", 30);
  set("spi", 30);
  set("agi", 30);
  //	set_temp("apply/damage",50);
  set_temp("apply/attack", 50);
  set_temp("apply/defense", 50);
  set_temp("apply/move", 50);
  set("max_kee", 900);
  set("max_gin", 900);
  set("max_sen", 900);
  set("kee", 900);
  set("gin", 900);
  set("sen", 900);

  set("force", 1000);
  set("max_force", 1000);
  set("force_factor", 20);

  set("combat_exp", 2500000);
  set("score", 100000);
  set_skill("literate", 70);
  set_skill("force", 160);
  set_skill("unarmed", 150);
  set_skill("dodge", 150);
  set_skill("parry", 100);
  set_skill("sword", 160);
  set_skill("xingyi-ken", 150);
  set_skill("xuanyinforce", 80);
  set_skill("one-sword", 160);
  set_skill("mysterrier", 100);
  set_skill("mystforce", 50);
  map_skill("unarmed", "xingyi-ken");
  map_skill("dodge", "mysterrier");
  map_skill("force", "xuanyinforce");
  map_skill("parry", "one-sword");
  map_skill("sword", "one-sword");

  create_family("雪山琼宫", 4, "记名弟子");
  setup();
  carry_object(__DIR__ "obj/longsword")->wield();
  carry_object(__DIR__ "obj/cloth")->wear();
  add_money("silver", 15);
}
void attempt_apprentice(object me) {
  if (me->query("id_type") == 2) {
    command("say 我不收邪道中人。\n");
    return;
  }
  command("recruit " + me->query("id"));
}

void recruit_apprentice(object ob) {
  if (ob->query("class") == "snowman") {
    ob->add("betrayer", 1);
    command("say 阁下已经是琼宫弟子了，竟然判师出宫，来拜我这不成器的老人吗？\n");
  }
  if ( ::recruit_apprentice(ob))
    ob->set("class", "snowman");
  ob->set("id_type", 1);
}

int about_he1() {
  command("say [一剑]不才正是老夫。\n");
  return 1;
}
int about_he2() {
  command("say [双拐]樊长江以一手流星拐名动江湖，后不幸身亡。\n");
  return 1;
}
int about_he3() {
  command("say [三奇]已经隐退江湖了。\n");
  return 1;
}
int about_he4() {
  command("say [四恶]是恶穷神归驼子、恶道人墨无为、恶郎君崔如风和生死笔独孤恶。\n");
  return 1;
}
