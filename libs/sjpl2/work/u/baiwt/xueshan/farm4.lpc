inherit ROOM;

void create() {
  set("short", "庄稼地");
  set("long", @LONG
无边无际的庄稼地。田中半人高的麦杆儿随风而动，正如江湖中
的你，随著江湖之中汹涌的波涛，四处飘摇。你想到江湖中的无奈,
不仅沧然泪下。 
LONG
  );
  set("exits", ([
    "south": __DIR__ "farm3",
    "west": __DIR__ "farm4",
    "east": __DIR__ "farm4",
    "north": __DIR__ "farm4",
  ]));
  set("outdoors", "xueshan");
  setup();

}
