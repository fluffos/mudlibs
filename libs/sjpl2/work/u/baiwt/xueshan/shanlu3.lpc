#include <ansi.h>
#include <room.h>

inherit ROOM;
void init();

void create() {
  set("short", "雪山山麓");
  set("long", @LONG
你已经来到了雪山山麓，空气到此变得稀薄起来，日间骄阳似火，到
了晚间却又是奇寒彻骨，冷气袭人。山上虽是积雪皑皑，但纵是本领再高
的人，也不敢冒那天大奇险，去凿那冰雪，须知冰雪一受震动，就可能引
起雪崩之灾，人畜俱受活埋。所以在山区赶路的旅人，空对矗立的冰峰，
却是难止口中的干渴。
LONG
  );
  set("outdoors", "xueshan");
  set("exits", ([
    "northup": __DIR__ "shanlu3",
    "southdown": __DIR__ "shanlu2",
  ]));
  set("objects", ([
    __DIR__ "npc/flygirl": 1,
  ]));

  setup();
}


void init() {
  object ob;
  if (interactive(ob = this_player()))
    call_out("blowing", random(10) + 1, ob);
}

int blowing(object ob)

{
  int i;
  int damage;
  if (ob && environment(ob) == this_object()) {
    tell_object(this_object(), HIW "\n\n突然一股刺骨的寒风猛烈地刮来，你只觉浑身发抖，站都站不住！！\n\n" NOR);
    COMBAT_D->report_status(ob, 1);
    ob->receive_wound("kee", random(20) + 10);
    if (environment(ob) == this_object())
      call_out("blowing", random(10) + 1, ob);
  } else

    return 1;
}
