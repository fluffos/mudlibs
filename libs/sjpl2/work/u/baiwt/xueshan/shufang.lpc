inherit ROOM;

void create() {
  set("short", "智慧宫");
  set("long", @LONG
这是雪山藏书的宝地。宫中的书架晶莹透亮，仿佛都是冰雕的，一眼望
去，尽是些研究基本武功和棋道心法的书籍。看来琼宫主人也颇爱下棋。中
间放着一个蒲团，据说琼宫主人就是经常坐在这个蒲团上看书的。
LONG
  );
  set("exits", ([
    "west": __DIR__ "men2",
  ]));
  set("item_desc", ([
    "蒲团": "蒲团上左边写着[武林三逸]，右边写着[棋门双怪]。你似乎可以转动它(zhuan)。\n"
  ]));

  setup();
}

void init() {
  add_action("do_zhuan", "zhuan");
}

void check_trigger() {
  object room;

  if ((int)query("left_trigger") == 3
    && (int)query("right_trigger") == 2
    && !query("exits/down")) {
    message("vision",
      "地板忽然发出轧轧的声音，一块地面缓缓移动著，露出一个向下的阶梯。\n",
      this_object());
    set("exits/down", __DIR__ "secrect_hut");
    if (room = find_object(__DIR__ "secrect_hut")) {
      room->set("exits/up", __FILE__);
      message("vision",
        "天花板忽然发出轧轧的声音，露出一个向上的阶梯。\n",
        room);
    }
    delete("left_trigger");
    delete("right_trigger");
    call_out("close_passage", 10);
  }
}

void close_passage() {
  object room;

  if (!query("exits/down")) return;
  message("vision",
    "地板忽然发出轧轧的声音，一块地面缓缓移动著，将向下的通道盖住了。\n",
    this_object());
  if (room = find_object(__DIR__ "secrect_hut")) {
    room->delete("exits/up");
    message("vision",
      "天花板忽然发出轧轧的声音，向上的阶梯又缓缓地收了回去。\n",
      room);
  }
  delete("exits/down");
}


int do_zhuan(string arg) {
  string dir;

  if (!arg || arg == "") return 0;

  if (arg == "蒲团") {
    write("你试著推动这个蒲团，似乎可以左右滑动....\n");
    return 1;
  }
  if (sscanf(arg, "蒲团 %s", dir) == 1) {
    if (dir == "right") {

      message_vision("$N将蒲团往右推...，忽然「喀」一声蒲团又移回原位。\n",
        this_player());
      add("right_trigger", 1);
      check_trigger();
      return 1;
    } else if (dir == "left") {

      message_vision("$N将蒲团往左推...，忽然「喀」一声蒲团又移回原位。\n",
        this_player());
      add("left_trigger", 1);
      check_trigger();
      return 1;
    } else {
      write("你要将蒲团推向那个方向？\n");
      return 1;
    }
  }
}


void reset() {
  ::reset();
  delete("left_trigger");
  delete("right_trigger");
}
