#include <ansi.h>
#include <room.h>
inherit ROOM;
void create() {
  object silver;
  set("short", GRN "后院花园" NOR);
  set("long", @LONG
这里是一个小小的花园，几座形态奇兀的假山，环着一个十步见方的池塘，
塘中种着荷花，菱角；几条金鲤鱼悠闲地游来游去。头顶上是高大的榆树，池
边几块青石，一张白玉石桌，别有风趣。南墙角上有一口井，井台上立着一只
木雕彩绘的仙鹤；乍看上去，还真以为是活物呢!!
LONG);
  set("exits", ([
    "northwest": __DIR__ "dxiangf",
  ]));
  set("objects", ([
    "/u/baiwt/xueshan/obj/silver": 1
  ]));
  set("resource/water", 1);
  set("fillplace", "青石井");
  set("watername", "井水");
  create_door("northwest", "垂花青缎门帘", "southeast", DOOR_CLOSED);
  set("oldarea", "nanyang");
  setup();
  silver = present("silver", this_object());
  silver->set_amount(random(10000) + 1000);
  silver->set("name", "白银");
}
