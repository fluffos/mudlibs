#include <ansi.h>
inherit NPC;
int about_here1();
void create() {
  set_name("厨娘", ({ "chu niang" }));
  set("gender", "女性");
  set("age", 44);
  set("combat_exp", 400);
  set_skill("stealing", 900);
  set("max_kee", 200);
  set("eff_kee", 20);
  set("kee", 20);
  set("inquiry", ([
    "强盗": (: about_here1 :),
  ]));
  set("no_kill", "funiu");
  setup();
  carry_object(__DIR__ "obj/cloth1")->wear();
}
int accept_object(object who, object ob) {
  object me;
  if (ob->name() == "金创药") {
    me = this_player();
    say("厨娘说道：多谢这位" + RANK_D->query_respect(who)
      + "救我。今天早上有一伙强盗来到杨家，老爷夫人都被打伤了，幸亏小姐不在家，否则. . .\n");
    return 1;
  } else {
    say("厨娘摇了摇头，说道：这东西有什么用呀？\n");
    return 0;
  }
  return 1;
}

int about_here1() {
  say("厨娘说道：据说这伙强人为首的是一个青衣书生，他的山寨在城北伏牛山上的青松冈.\n");
  return 1;
}
