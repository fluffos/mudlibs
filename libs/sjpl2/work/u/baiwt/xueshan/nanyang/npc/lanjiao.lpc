inherit NPC;

void create() {
  set_name("杨兰娇", ({ "lanjiao" }));
  set("title", "侠女");
  set("gender", "女性");
  set("age", 20);
  set("str", 10);
  set("per", 30);
  set("long", @LONG
杨兰娇，是这里杨员外的独生女。今年二十岁，人长的漂靓又大方。
你也许想和她谈谈(talk)。
LONG
  );
  set_skill("unarmed", 40);
  set_skill("liuh-ken", 40);
  map_skill("unarmed", "liuh-ken");
  set("combat_exp", 50000);
  set("attitude", "friendly");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    "唉！ 没料到你和崔如风是一伙的！\n",
  }));

  setup();

  carry_object(__DIR__ "obj/pink_cloth")->wear();
}


int accept_fight(object me) {
  command("say 小女子哪里是您的对手？");
  return 0;
}


void init() {
  add_action("do_contact", "talk");
}

int do_contact(string arg) {
  write(" 杨兰娇脸泛红潮，悠然神往。\n");
  command("say 我天天到这里来是在等一个人，他叫何云峰，他答应过有一天会来接我的.");
  call_out("kidnaping", 10);
  return 1;
}

void kidnaping() {
  object me, room;
  me = this_player();
  if (room = find_object("/u/baiwt/xueshan/nanyang/zhengd"))
    room->set("exits/south", "/u/baiwt/xueshan/nanyang/wuhou_ci");
  else return;
  message("vision", "突然走来一个青衣书生，嘿嘿奸笑了几声，出手如电，一下便点中了杨兰娇的穴道.\n", room);
  message("vision", "青衣书生挟起杨兰娇，飞身往祠外蹿去。\n", room);
  message("vision", "杨兰娇无力的挣扎着，向你高叫着：“救命啊，救命啊！\n ", room);
  message("vision", "青衣书生突然反手在你背上按了一下，你还来不及反应，那一男一女两条人影便在门口消失了. . .\n", room);
  me->add("kee", -100);
  destruct(this_object());
}
