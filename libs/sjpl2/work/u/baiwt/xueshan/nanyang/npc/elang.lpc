#include <ansi.h>
inherit NPC;

string kill_passenger(object who);

void create() {
  set_name("崔如风", ({ "cui rufeng", "cui" }));
  set("gender", "男性");
  set("age", 34);
  set("long",
    "他是武林四恶中最阴毒的[恶郎君]崔如风。\n"
  );
  set("title", "武林四恶之一");
  set("nickname", HIG "恶郎君" NOR);
  set("attitude", "killer");

  set("str", 27);
  set("int", 22);
  set("per", 20);
  set("max_kee", 1000);
  set("kee", 700);
  set("sen", 500);
  set("max_sen", 500);

  set("combat_exp", 250000);
  set("bellicosity", 3000);
  set("chat_chance", 50);
  set("chat_msg", ({
    "崔如风喝道：呔！你竟敢坏大爷的好事！\n",
  }));
  set_skill("sword", 150);
  set_skill("shedu-sword", 150);
  set_skill("parry", 100);
  set_skill("dodge", 100);
  set_skill("unarmed", 100);
  set_skill("liuh-ken", 100);
  map_skill("unarmed", "liuh-ken");
  map_skill("sword", "shedu-sword");
  set("score", 1000);

  setup();

  add_money("gold", 2);
  carry_object("/u/baiwt/xueshan/obj/cloth")->wear();
  carry_object("/u/baiwt/xueshan/obj/longsword")->wield();
}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player())) {
    message_vision("崔如风喝道：呔！你竟敢坏大爷的好事！\n", ob);
    kill_ob(ob);
  }
}
