inherit NPC;

void create() {
  set_name("杨兰娇", ({ "lanjiao" }));
  set("title", "侠女");
  set("gender", "女性");
  set("age", 20);
  set("str", 10);
  set("per", 30);
  set("long", @LONG
杨兰娇姓刘，是这里杨员外的独生女。今年二十岁，人长的漂靓又大方。
杨兰娇已经被折磨的遍体鳞伤。
LONG
  );
  set("max_gin", 500);
  set("eff_gin", 1);
  set("gin", 1);
  set("max_kee", 500);
  set("eff_kee", 1);
  set("kee", 1);
  set("max_sen", 500);
  set("eff_sen", 1);
  set("sen", 1);
  set("score", -500);
  set_skill("unarmed", 40);
  set_skill("liuh-ken", 40);
  map_skill("unarmed", "liuh-ken");
  set("combat_exp", 50000);
  set("attitude", "friendly");
  set_skill("move", 300);
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    "杨兰娇说道：唉！ 没料道你和崔如风是一伙的！\n",
  }));

  setup();

  carry_object(__DIR__ "obj/torn_pink_cloth")->wear();
}


int accept_fight(object me) {
  command("say 小女子哪里是您的对手？");
  return 0;
}


void init() {
  object ob;
  if (interactive(ob = this_player()))
    remove_call_out("followhim");
  if ((int)ob->query("marks/杨森本人") == 1) {
    set_leader(0);
    call_out("goaway", 5);
  } else {
    call_out("messageing", 3);
    call_out("followhim", 6, ob);
  }
}
void messageing() {
  object room;
  room = find_object("/u/baiwt/xueshan/nanyang/weihu");
  if (environment() == room) {
    command("emote 杏眼圆睁，叱道：崔如风，你若害我，云峰他不会放过你的！");
    command("emote 竭力挣扎，渐渐从绳索里摆脱出来……。");
  }
}
void followhim(object ob) {
  object room;
  room = find_object("/u/baiwt/xueshan/nanyang/weihu");
  if (environment() == room)
    if (present(ob, environment())) {
      set_leader(ob);
      ob->set("marks/杨森", 1);
    }
}

void goaway() {
  destruct(this_object());
}

void die() {
  int i;
  object killer;

  if (objectp(killer = query_temp("last_damage_from")))
    killer->set("marks/murder", 1);

  ::die();

}
