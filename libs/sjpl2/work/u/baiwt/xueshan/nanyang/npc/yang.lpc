#include <ansi.h>
inherit NPC;

string kill_passenger(object who);

void create() {
  set_name("杨森", ({ "yang sen", "yang" }));
  set("gender", "男性");
  set("nickname", HIC "东鹤" NOR);
  set("age", 57);
  set("str", 27);
  set("max_kee", 2000);
  set("int", 22);
  set("per", 20);
  set("long", @LONG
杨森是江湖前辈，与胞弟[西鹤]杨万云并称[武林双鹤]。
LONG
  );
  set("attitude", "peaceful");

  set("combat_exp", 100000);
  set("bellicosity", 0);
  set("marks/杨森本人", 1);
  set_skill("sword", 150);
  set_skill("unarmed", 100);
  set_skill("dodge", 120);
  set_skill("parry", 120);
  set_skill("liuh-ken", 70);
  set_skill("six-chaos-sword", 150);
  set_skill("chaos-steps", 120);
  map_skill("unarmed", "liuh-ken");
  map_skill("dodge", "pyrobat-steps");
  map_skill("sword", "six-chaos-sword");
  setup();

  carry_object("/u/baiwt/xueshan/obj/cloth")->wear();
  //	if( random(5) == 1 )
}
int accept_fight(object me) {
  command("say 老头子哪里是您的对手？");
  return 0;
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 2, ob);
  }
}
void greeting(object ob) {
  object me = this_player(), room;
  int bonus;
  if ((int)ob->query("marks/murder") == 0) {
    if ((int)ob->query("marks/杨森") == 0)
      say("杨森说道：“这位" + RANK_D->query_respect(ob)
        + "是否是小女兰娇的朋友？” \n");
    else {
      say("杨森说道：“这位" + RANK_D->query_respect(ob)
        + "，多谢答救小女兰娇。” \n");
      say("杨森说道：“这处非久留之地，你快走吧。” \n");
      say("杨兰娇泪光莹莹，颤声说道：是云峰托你来救我的吗？他在哪里？你带我去吧. . .\n");

      ob->set("marks/杨森", 0);

      // Let's give out some bouns for this done!
      if (!(room = find_object("/u/baiwt/xueshan/yading")))
        room = load_object("/u/baiwt/xueshan/yading");

      bonus = random(300);
      ob->add("combat_exp", bonus);
      bonus += random(700) + 1000;
      ob->add("potential", bonus - 1000);
      message_vision(HIC "\n$N只觉眼前一阵烟雾飘过，使$N不知身在何处。\n\n" NOR, me);
      me->move(room);
      message_vision(HIG "\n$N似乎从梦中醒了过来。\n\n" NOR, me);
      destruct(this_object());
    }
  } else
    call_out("killhim", 1, ob);
}

int killhim(object ob) {
  ob->set("marks/murder", 0);
  ob->set("marks/杨森", 0);
  set("title", "悲愤欲绝");

  say("杨森悲愤欲绝的骂道：你．．你．．你居然杀了我女儿，纳命来！\n");

  set("chat_chance", 10);
  set("chat_msg", ({
    "杨森悲愤欲绝的骂道：你．．你．．你居然杀了我女儿，纳命来！",
    //                (: random_move :),
  }));
  set_temp("apply/force", 4000);
  set_temp("apply/max_force", 2200);
  set_temp("apply/force_factor", 30);
  set_temp("apply/combat_exp", 1000000);
  set_temp("apply/damage", 250);
  carry_object("/u/baiwt/xueshan/obj/longsword")->wield();
  kill_ob(ob);
  ob->kill_ob(this_object());

}
