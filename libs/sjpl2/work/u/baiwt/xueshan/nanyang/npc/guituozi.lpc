#include <ansi.h>
inherit NPC;

void create() {
  set_name("归驼子", ({ "gui tuozi", "gui" }));
  set("gender", "男性");
  set("age", 34);
  set("long",
    "他是武林四恶中的[恶穷神]归驼子。\n"
  );
  set("title", "武林四恶之一");
  set("nickname", HIG "恶穷神" NOR);
  set("str", 27);
  set("int", 22);
  set("per", 20);
  set("max_kee", 700);
  set("eff_kee", 20);
  set("kee", 20);
  set("sen", 500);
  set("max_sen", 500);
  set("combat_exp", 300000);
  set("chat_chance", 20);
  set("chat_msg", ({
    "归驼子恨恨说道：崔如风这个狗贼，竟然在我的酒里下毒。老叫化就算变作了鬼，也要向他索命！\n",
  }));
  set_skill("parry", 100);
  set_skill("dodge", 100);
  set_skill("unarmed", 100);
  set_skill("stealing", 900);
  set_skill("liuh-ken", 200);
  map_skill("unarmed", "liuh-ken");
  set("score", 1000);
  setup();
  carry_object("/u/baiwt/xueshan/obj/cloth")->wear();
}
int accept_object(object who, object ob) {
  object tuozi;
  tuozi = this_object();
  if (ob->name() == "雪山灵芝") {
    if ((int)ob->query("objattrib") != 1) return 0;
    say("归驼子吐出一口鲜血，说道：多谢这位" + RANK_D->query_respect(who)
      + "。只是老叫化已经不行了. . .\n");
    say("归驼子说道：" + RANK_D->query_respect(who)
      + "与化子有缘，我老化子就把一身的内功都传与你吧！\n");
    if ((int)ob->query("max_force") > 800) {
      command("say " + RANK_D->query_respect(who) + "内功修为颇高，看来是不在乎老叫化的这点功力了.");
      return 1;
    } else {
      who->set_skill("zhanyidie", 100);
      who->add("force", 500);
      message_vision(HIC "\n归驼子一把抓住$N的手腕，$N顿觉一股浑厚的力道传入体内,\n$N不多时便大汗淋漓。\n" NOR, who);
      message_vision(HIC "归驼子仰天长笑道：没想到我老叫化临死时一身武功竟有传人！哈哈！\n" NOR, who);
      tuozi->add("kee", -20);
    }
    say("归驼子匆匆离开了。\n");
    this_object()->move("/u/baiwt/npc_hut.lpc");
    command("drop all");
    return 1;
  } else {
    say("归驼子摇了摇头，说道：这东西对我没用。\n");
    return 0;
  }
  return 1;
}
