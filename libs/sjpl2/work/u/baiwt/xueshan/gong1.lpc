//room: gong1.c [baiwt]
inherit ROOM;

void create() {
  set("short", "琼宫");
  set("long", @LONG
这里已是雪峰绝顶，山上建筑如同宫殿，那些屋宇都是水晶、云石
、晶岩或者坚冰所造，通体透明，在阳光返照之下，只觉霞彩夺目，闪
闪生光，端的是人间罕见的奇景。你本已疲倦非常，见此奇景，不由得
精神一振。
LONG
  );
  set("outdoors", "xueshan");
  set("exits", ([
    "north": __DIR__ "dadao2",
    "westdown": __DIR__ "beique",
  ]));
  set("objects", ([
    __DIR__ "npc/yun": 1,
    __DIR__ "npc/xia": 1,
  ]));
  setup();
}

int valid_leave(object me, string dir) {

  if ((dir == "north")
    && ((string)me->query("family/family_name") != "雪山琼宫")
    && (objectp(present("yun", environment(me)))
      || objectp(present("xia", environment(me)))))

    return notify_fail("云霞双姝伸手拦住你，说道：“非琼宫弟子请回！”\n");
  return ::valid_leave(me, dir);
}
