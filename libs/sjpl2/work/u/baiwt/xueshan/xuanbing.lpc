inherit ROOM;

void init();
void create() {
  set("short", "洗剑池");
  set("long", @LONG
来到这里你只觉眼前空阔，一片光亮，山顶上一股清泉，注入方圆十
数丈的冰池之中，池中有闪光的浮冰和零落的雪莲花瓣，给人一种祥和清
纯的感觉。
LONG
  );

  set("exits", ([
    "east": __DIR__ "changl9",
    "west": __DIR__ "changl10",
    "south": __DIR__ "changl8",

  ]));

  set("item_desc", ([
    "冰池": "一个飘有浮冰和花瓣的水池，池水清可见底.\n据说琼宫主人曾经到这里来洗剑(wash).\n",
  ]));

  setup();
}

void init() {
  add_action("do_wash", "wash");
}
int do_wash(string arg) {
  object who, ob;
  who = this_player();
  if ((int)who->query("sen") <= 50)
    return notify_fail("你的神不够。\n");
  if (!(ob = who->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword")
    return notify_fail("你想在冰池中洗手？手会冻僵的呀。\n");

  message_vision("$N将手中的剑浸入冰池之中，很快剑刃上就结上了一层晶莹的冰绡。\n", who);
  who->receive_damage("sen", 50);
  if ((int)who->query("bellicosity") > 0)
    who->add("bellicosity", -(random((int)who->query("kar")) + 7));
  message_vision("冰水渐渐洗去了剑上的血迹，也洗去了$N的恩怨荣辱。\n", who);
  return 1;
}
