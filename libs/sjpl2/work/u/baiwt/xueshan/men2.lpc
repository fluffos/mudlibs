inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "智慧宫大门");
  set("long", @LONG
这是通往雪山文库[智慧宫]的大门。只见一扇精致的白木门上雕着一
张巨大的棋盘，大门两旁贴着一副对联(duilian)，抬头上望，门楣上一块
大匾(bian)上写着几个大字。
LONG
  );
  set("exits", ([
    "east": __DIR__ "shufang",
    "northwest": __DIR__ "changl4",
  ]));
  set("no_fight", 1);
  set("no_steal", 1);
  set("no_magic", 1);
  set("NONPC", 1);
  set("no_fight", 1);

  set("objects", ([
    __DIR__ "npc/ping": 1,
  ]));

  set("item_desc", ([
    "duilian": "斗转星移，银河暗渡\n",
    "bian": HIC "星河慧光\n" NOR,
  ]));

  setup();
}

int valid_leave(object me, string dir) {

  if ((dir == "east")
    && ((string)me->query("family/family_name") != "星河宫")
    && objectp(present("ping", environment(me))))
    return notify_fail("萍儿伸手拦住你，说道：“把[星河帖]拿来，才能让你进去！”\n");
  return ::valid_leave(me, dir);
}
