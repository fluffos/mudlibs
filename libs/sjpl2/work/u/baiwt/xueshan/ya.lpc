inherit ROOM;

void create() {
  set("short", "飞雪崖");
  set("long", @LONG
这是通向[雪山琼宫]的必经之路，一条小道蜿蜒曲折地通向雪峰峰顶。
路的右侧是一条陡峭的山崖，峰顶漂泊的大雪被山风吹到这里，在崖上婉
转飞舞，煞是奇妙好看，故当地人称这里为[飞雪崖]。
LONG
  );
  set("outdoors", "xueshan");
  set("exits", ([
    "westup": __DIR__ "yan",
    "eastdown": __DIR__ "shanpo",
  ]));
  //set("objects",([
  //  __DIR__"npc/snowmen" : 4 ]));

  setup();
}
