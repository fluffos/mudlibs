#include <ansi.h>

inherit ROOM;
void init();
int do_move(string arg);
int do_enter(object me);
int do_swim(string arg);

string look_water();
void create() {
  set("short", "小天湖");
  set("long", @LONG
这是一个小湖，一眼望去，但见湖水(water)清澈，碧波荡漾，湖中有
片片闪光的浮冰，湖边水连天，天连水，恍如湖泊就在天上。所以当地人
称为[纳木错]，即汉人所说的[天湖]。(lake)
LONG
  );
  set("exits", ([
    "north": __DIR__ "changl10",
    //		"south" : __DIR__"men3",
  ]));

  set("item_desc", ([
    "lake": (: look_water :),
    "water": (: look_water :),
  ]));

  setup();
}

string look_water() {
  object me = this_player();

  message_vision("$N偷眼看着湖水中的自己。\n", me);
  if ((string)me->query("gender") == "女性")
    return "你抬眼往湖水中瞧去，只见一个貌若春花的女子脉脉含情地凝望着你。\n你脸上一热，羞涩地低下了头，心想：那就是我吗？\n";
  if ((string)me->query("gender") == "男性")
    return "你抬眼往湖水中瞧去，只见一个五大三粗的男子在湖水中直瞪着你。\n你不觉心想：咦，我原来是这样的吗？\n";
  if ((string)me->query("gender") == "无性")
    return "你抬眼往湖水中瞧去，只见一个不男不女的人影恍惚湖水中。\n你不觉心想：唉，为什么爹妈没给我一个女儿身呢？\n";
}

void init() {
  add_action("do_dive", "dive");
  add_action("do_swim", "swim");
  add_action("do_enter", "enter");
}

int do_dive(string arg) {
  object me = this_player();
  if (!arg || arg != "water")
    return notify_fail("你要潜入哪里？\n");
  if ((int)me->query_str() > 28) {
    message_vision("$N潜入水中，只见水深处都结成了冰状，$N奋力划开冰水，发现了一个水底密洞。\n", this_player());
    set("dive_water", 1);
  } else
    message_vision("$N潜入水中，只觉湖水奇寒彻骨，水深处都结成了冰状，划不动水。\n", this_player());
  return 1;
}

int do_enter(object me) {
  object room;
  object where;
  me = this_player();
  where = environment(me);
  if (!where->query("dive_water"))
    return notify_fail("你要进哪去？\n");
  if (!(room = find_object(__DIR__ "midao1")))
    room = load_object(__DIR__ "midao1");
  message_vision("$N“咕咚”一声，跳进洞中。\n", me);
  me->move(room);
  set("dive_water", 0);
  return 1;
}
int do_swim(string arg) {
  object me = this_player(), room;
  if (!arg || arg != "lake")
    return notify_fail("你要游什么？\n");

  if (!(room = find_object(__DIR__ "men3")))
    room = load_object(__DIR__ "men3");

  if (!objectp(room))
    return notify_fail("ERROR:not found 'men3.c' \n");
  message_vision(HIC "\n$N纵身跃入湖中，向湖对面游去。\n", me);
  message_vision(NOR "\n", me);
  me->move(room);
  return 1;
}
