inherit ROOM;

void create() {
  set("short", "雪山山麓");
  set("long", @LONG
你已经来到了雪山山麓，空气到此变得稀薄起来，日间骄阳似火，到
了晚间却又是奇寒彻骨，冷气袭人。山上虽是积雪皑皑，但纵是本领再高
的人，也不敢冒那天大奇险，去凿那冰雪，须知冰雪一受震动，就可能引
起雪崩之灾，人畜俱受活埋。所以在山区赶路的旅人，空对矗立的冰峰，
却是难止口中的干渴。
LONG
  );
  set("outdoors", "xueshan");
  set("exits", ([
    "northup": __DIR__ "shanlu2",
    "westup": __DIR__ "jian",
    "eastup": __DIR__ "xiaowu",
    "southdown": __DIR__ "yan",
  ]));
  set("objects", ([
    __DIR__ "npc/situ": 1,
  ]));

  set("outdoors", "xueshan");

  setup();
}
