#include <ansi.h>

inherit ROOM;
void init();
int do_search(string);
void create() {
  set("short", "小木屋");
  set("long", @LONG
这是一个简陋的小木屋，只有角落里铺了一层干草，别的什么也没有。
小屋的后门敞开着，可以看见有一条小路从屋后通向后山。
LONG
  );
  set("sleep_room", 1);
  set("exits", ([
    "westdown": __DIR__ "shanlu1",
    "northup": __DIR__ "shanroad",

  ]));

  setup();
  // replace_program(ROOM);
}

void init() {
  add_action("do_search", "search");
}

int do_search(string arg) {
  object me = this_player(), room;

  if (!arg || arg != "干草")
    return notify_fail("你要搜什么？\n");

  if (!(room = find_object(__DIR__ "dijiao")))
    room = load_object(__DIR__ "dijiao");

  if (!objectp(room))
    return notify_fail("ERROR:not found 'dijiao.c' \n");
  message_vision("\n$N翻开了那堆干草，发现下面地板是空的，$N一不小心跌了下去。\n", me);
  message_vision(NOR "\n", me);
  me->move(room);
  return 1;
}
