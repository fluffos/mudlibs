inherit ROOM;
#include <room.h>
void create() {
  set("short", "宝莲院");
  set("long", @LONG
香雪海中，一院巍然。你看到院门上挂着一块石匾，上写[宝莲院]三字，清秀挺
拔。一枝白梅从墙上探出头来，显得十分抢眼。院的两侧陈列着一些奇花异草。
LONG
  );
  set("exits", ([
    "north": __DIR__ "binggu",
    "west": __DIR__ "lianchi",
  ]));
  set("objects", ([
    __DIR__ "npc/oldgod": 1,
  ]));
  set("no_magic", 1);
  set("no_steal", 1);
  set("NONPC", 1);

  setup();
  create_door("west", "石门", "east", DOOR_CLOSED);

}
int valid_leave(object me, string dir) {
  object *inv;
  object ob;
  int i;
  int withfeather = 0;
  if (dir == "west" && ob = present("oldgod", this_object())) {
    inv = all_inventory(me);
    for (i = 0; i < sizeof(inv); i++) {
      if ((string)(inv[i]->query("id")) != "white feather")
        return notify_fail(ob->name() + "说道：把身上的东西留在这儿，才能让你进去。\n");
      if ((string)(inv[i]->query("id")) == "white feather")
        withfeather = 1;
    }
    if (!withfeather)
      return notify_fail(ob->name() + "说道：原来不是莲儿叫你来的。你怎么找到这里的？快回去吧！\n");
  }
  if (dir == "north" && ob = present("oldgod", this_object())) {
    inv = all_inventory(me);
    for (i = 0; i < sizeof(inv); i++) {
      if ((string)(inv[i]->query("id")) == "white feather") {
        tell_object(me, ob->name() + "微笑着将你身上的" +
          inv[i]->name() + "拿了回去．\n\n\n");
        destruct(inv[i]);
      }
    }


  }
  return 1;
}
