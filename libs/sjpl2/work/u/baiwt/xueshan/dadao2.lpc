inherit ROOM;

void create() {
  set("short", "琼宫大道");
  set("long", @LONG
这是一条云石铺成的宽敞大道，每块青石都是长约八尺，宽约三尺，
甚是整齐，堪称巧夺天工。道旁有好几处喷泉，飞珠溅玉，泛起一圈圈
的彩虹。还有小溪曲折，贯穿其中，不时可以看到一两只雪貂蹦蹦跳跳
地跃向溪水对岸。再往前走就到了放鹤厅了。
LONG
  );
  set("outdoors", "xueshan");
  set("exits", ([
    "northwest": __DIR__ "damen1",
    "northeast": __DIR__ "damen2",
    "south": __DIR__ "gong1",
  ]));
  set("objects", ([
    __DIR__ "npc/xuediao": 2,
  ]));
  setup();
}
