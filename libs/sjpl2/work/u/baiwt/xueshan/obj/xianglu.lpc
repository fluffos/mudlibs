inherit ITEM;

void create() {
  set_name("香炉", ({ "xianglu", "lu" }));
  set_weight(2000000);
  set_max_encumbrance(800);
  set("no_get", 1);
  //set("no_shown", 1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("prep", "under");
    set("unit", "个");
    set("long", "一个破香炉。\n");
    set("no_get", 1);
    //set("no_shown", 1);
    set("value", 1);
  }
}

int is_container() { return 1; }
