#include <weapon.h>

inherit FORK;

void create() {
  set_name("骷髅旗", ({ "death flag", "flag", "fork" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "面");
    set("value", 1);
    set("material", "steel");
  }
  init_fork(10);
  setup();
}
