inherit ITEM;

void create() {
  set_name("冰窟窿", ({ "ice hole" }));
  set("no_get", 1);
  set_weight(2000000);
  //       set("no_shown", 1);
  set_max_encumbrance(100);

  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "一个冰窟窿\n");
    set("value", 0);
  }
}

int is_container() { return 1; }
