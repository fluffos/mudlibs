inherit ITEM;
void create() {
  set_name("剑痕", ({ "剑痕", "jianhen" }));
  set_weight(2000000);
  set("no_get", 1);
  set("no_shown", 1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "道");
    set("value", 70);
    set("material", "wood");
    set("no_shown", 1);
    set("no_get", 1);
    set("no_drop", 1);
    set("skill", ([
      "name": "fenglei-sword",
      "exp_required": 50000,
      "sen_cost": 30,
      "difficulty": 40,
      "max_skill": 50
    ]));
  }
}
