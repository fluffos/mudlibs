inherit ITEM;

void create() {
  set_name("银汉牌", ({ "throwing pai", "pai" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("long", "这是一块黑玉牌，上面密密麻麻刻着许多字.\n");
    set("skill", ([
      "name": "fantianqi",
      "exp_required": 200000,  // minimum combat experience required
      "sen_cost": 70,  // jing cost every time study this
      "difficulty": 90,  // the base int to learn this skill
      "max_skill": 251,  // the maximum level you can learn
    ]));
  }
}
