#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create() {
  set_name("黑衣客", ({ "blackman" }));
  set("long",
    "这是一个头发花白、容貌清癯的老人\n" +
    "他正全神贯注地与对手下着围棋，常陷入冥思苦想之中.\n" +
    "他会不会是传说中的[武林三逸]中的南棋？\n");
  set("age", 75);
  set("attitude", "peaceful");
  set("title", "　");
  set("chat_chance", 10);
  set("chat_msg", ({
    "黑衣客皱眉说道：这步棋有点奥妙，该怎么下呢？\n",
    "黑衣客叹了口气，说道：胜则生怨，负则自鄙，去胜负心，无诤自安。武功棋道都是一样.\n",
  }));

  set("str", 130);
  set("int", 30);
  set("per", 50);
  set("cor", 50);
  set("spi", 30);
  set("max_kee", 6000);
  set("max_gin", 6000);
  set("max_sen", 6000);
  set("kee", 6000);
  set("gin", 6000);
  set("sen", 6000);

  set("force", 30000);
  set("max_force", 30000);
  set("force_factor", 50);

  set("atman", 2000);
  set("max_atman", 2000);
  set("atman_factor", 50);

  set("mana", 4000);
  set("max_mana", 2000);
  set("mana_factor", 50);

  set("combat_exp", 40000000);
  set("score", 200000);

  set_skill("literate", 200);
  set_skill("force", 200);
  set_skill("unarmed", 150);
  set_skill("throwing", 200);
  set_skill("parry", 200);
  set_skill("dodge", 150);
  set_skill("liuhe-force", 150);
  set_skill("fantianqi", 250);
  set_skill("dk-xubu", 150);
  set_skill("liuh-ken", 150);
  map_skill("unarmed", "liuh-ken");
  map_skill("force", "liuhe-force");
  map_skill("throwing", "fantianqi");
  map_skill("dodge", "dk-xubu");

  //        set("chat_chance_combat", 50);
  //        set("chat_msg_combat", ({
  //                (: perform_action, "throwing.xingluoqibu" :),
  //        }) );
  create_family("星河宫", 2, "弟子");

  setup();
  carry_object("/u/baiwt/xueshan/obj/clothb")->wear();
  carry_object("/u/baiwt/xueshan/xsobj/bqi")->wield();
  add_money("silver", 50);
}

void attempt_apprentice(object ob) {
  message_vision("黑衣客头也不抬，挥手说道：我老人家没空收徒弟。快走开！\n", ob);
}

int accept_object(object who, object ob) {
  object me;
  object yinlian;
  if (ob->name() == "黑棋子") {
    me = this_player();
    yinlian = new("/u/baiwt/xueshan/obj/throwbook1");
    yinlian->move(me);
    say("黑衣客抬头看了你一眼，突然双目精光四射，说道：你居然找到了我的棋子！\n");
    say("黑衣客说道：看来老夫和这位" + RANK_D->query_respect(who)
      + "有缘，但是我发过誓不收弟子，这本书送给你自己去钻研钻研吧！\n");
    return 1;
  } else {
    say("黑衣客冷哼一声，随手把你给的东西仍下了山谷。\n");
    return 1;
  }

  return 1;
}
int accept_fight(object me) {
  command("say 我老人家没空，快走开！");
  return 0;
}
