#include <ansi.h>
inherit NPC;

void create() {
  set_name("牧马人", ({ "horseman", "man" }));
  set("gender", "男性");
  set("nickname", HIW "雪山是我家" NOR);
  set("combat_exp", 20000);
  set("age", 36);
  set("per", 34);
  set("attitude", "friendly");
  set_skill("unarmed", 30);
  set_skill("dodge", 30);
  set_skill("parry", 30);

  setup();
  add_money("gold", 1);
}

void init() {
  object ob;
  ::init();
  add_action("do_work", "work");
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || !visible(ob) || environment(ob) != environment()) return;
  switch (random(3)) {  // 1/3 chance to greet.
    case 0:
      say("牧马人一鞠躬说道：这位" + RANK_D->query_respect(ob)
        + "请进！\n");
      break;
  }
}
int do_work(string arg) {
  object ob;
  object me;
  me = this_player();
  if (me->is_busy()) return notify_fail("你的动作还没有完成，不能工作。\n");
  message_vision("$N辛辛苦苦地喂了半天草料，可人也累的要死。\n", me);
  me->add("gin", -30);
  me->add("sen", -30);
  ob = new("/u/baiwt/xueshan/obj/money/silver");
  ob->move(me);
  message_vision("牧马人对$N说道：这是你的工钱。\n", me);
  me->start_busy(2);
  return 1;
}
