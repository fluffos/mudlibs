//room: restroom.c
//restroom
inherit ROOM;

void create() {
  set("short", "睡莲宫");
  set("long", @LONG
这里是专供琼宫弟子休息的睡莲宫。那一张张冰床就如同一朵朵莲花，
花芯宽敞，花瓣绽开，内铺白缎，睡来非但不觉寒冷，反觉浑身血液流畅，
十分舒适。
LONG
  );

  set("exits", ([
    "southeast": __DIR__ "changl4",
    "northeast": __DIR__ "changl5",
  ]));

  set("sleep_room", 1);
  set("no_fight", 1);
  set("no_steal", 1);
  set("no_magic", 1);
  set("NONPC", 1);

  setup();
}
