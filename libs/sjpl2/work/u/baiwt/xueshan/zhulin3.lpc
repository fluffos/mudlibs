inherit ROOM;

void create() {
  set("short", "竹林");
  set("long", @LONG
这里是一片郁郁葱葱的翠竹林。青竹林立，碧绿挺拔，一眼望不到边
，好似一幅巨大的绿色屏障。微风吹动着竹梢(bamboo)发出沙沙的轻响，
在这幽静的氛围中，使人不禁产生一种返朴归真的感觉。
LONG
  );
  set("exits", ([
    "west": __DIR__ "zhulin4",
    "east": __DIR__ "qingliuxi2",
  ]));
  set("item_desc", ([
    "bamboo": "这是绿油油的竹子，你禁不住顽皮地想打(strike)一下竹梢。\n",
  ]));
  set("outdoors", "xueshan");
  setup();
}
void init() {
  add_action("do_strike", "strike");
}
int do_strike(string arg) {
  object me = this_player(), snake;
  if (!arg || arg != "bamboo")
    return notify_fail("你要击打什么？\n");
  if (present("skeleton", environment(me)))
    return notify_fail("你用力打了一下竹梢，只听见竹枝沙沙一阵响。\n");
  if (present("corpse", environment(me)))
    return notify_fail("你用力打了一下竹梢，只听见竹枝沙沙一阵响。\n");
  if (present("snake", environment(me)))
    return notify_fail("你用力打了一下竹梢，只听见竹枝沙沙一阵响。\n");
  snake = new("/u/baiwt/xueshan/xsnpc/cynsnake");
  message_vision("\n$N用力打了一下竹梢，突然从竹枝上嗤地一声蹿起一条$n。\n\n", me, snake);
  snake->move(environment(me));
  return 1;
}
