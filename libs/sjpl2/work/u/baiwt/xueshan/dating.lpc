//ROOM dating.c

inherit ROOM;

void create() {
  set("short", "放鹤厅");
  set("long", @LONG
这就是『雪山琼宫』放鹤厅。传说雪山神尼原先在这里隐居时以豢养雪
山特有飞禽丹顶鹤度日，没想到日后不仅从仙鹤的扑击姿态中领悟了许多武
学妙谛，还将仙鹤训练成为既通人性又具备上乘格斗之技的灵禽。
LONG
  );
  set("exits", ([
    "north": __DIR__ "changl1",
    "northwest": __DIR__ "changl2",
    "northeast": __DIR__ "changl3",
    "southwest": __DIR__ "damen1",
    "southeast": __DIR__ "damen2",
  ]));

  set("objects", ([
    __DIR__ "npc/master": 1,
    __DIR__ "npc/master2": 1,
  ]));
  //	set("valid_startroom", 1);
  setup();
}
