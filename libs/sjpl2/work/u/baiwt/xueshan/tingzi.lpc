inherit ROOM;

void create() {
  set("short", "吹雪亭");
  set("long", @LONG
这是半山的一个小亭子, 亭子顶上不知是用什么做的，山上的飞雪飘
到上面，怎么也积不起来，雪花一沾亭顶便自动滑落到地上，就象是有人
站在上面往下吹雪一般，故名[吹雪亭]。有两个老人经常在这里下棋。
LONG
  );
  set("outdoors", "xueshan");
  set("exits", ([
    "west": __DIR__ "yan",
  ]));
  set("objects", ([
    "/u/baiwt/xueshan/xsnpc/southqi": 1,
    "/u/baiwt/xueshan/xsnpc/northdou": 1,
  ]));
  setup();
  replace_program(ROOM);
}
