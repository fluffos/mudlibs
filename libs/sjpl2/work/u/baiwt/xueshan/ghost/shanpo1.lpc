inherit ROOM;

void create() {
  set("short", "陡坡");
  set("long", @LONG
这里是一处陡峭的山坡，山坡上长着一些青藤，让你勉强可以扶着那
些青藤走过去。从这里一路上山就是念青唐古拉山了。
LONG
  );
  set("exits", ([
    "southwest": __DIR__ "shanroad2",
    "eastup": __DIR__ "xueyu3",
  ]));
  set("outdoors", "xueshan");
  set("no_study", 1);
  set("no_steal", 1);
  set("no_fight", 1);
  set("no_magic", 1);

  set("objects", ([
    "/u/baiwt/xueshan/xsnpc/xiayiqi": 1,
  ]));
  setup();
}

void init() {
  add_action("do_quit", "quit");
}

int do_quit() { return 1; }


int valid_leave(object me) {
  if (me->query("gamble/amount"))
    return notify_fail("夏艺棋把手一拦，说道：还没赌完呢，就想走啦？\n");
  return ::valid_leave(me);
}
