#include <ansi.h>
inherit ROOM;
int do_split(string arg);

void create() {
  set("short", "生死峪");
  set("long", @LONG
来到这里你觉得眼前一亮，山壁四周到处挂满了大红的纸灯笼，把整
个山谷照得如同白昼。一个两鬓斑白的黑衣中年人静悄悄地坐在一具石棺
之前，不时地发出叹息之声。石棺上整齐地刻了一行字，写道：此生了无
生死念。
LONG
  );
  set("exits", ([
    "northwest": __DIR__ "mingwang",
    "southwest": __DIR__ "yanwang",
  ]));
  set("objects", ([
    __DIR__ "npc/master": 1,
  ]));
  set("outdoors", "xueshan");
  setup();
  set("sleep_room", "1");
}
void init() {
  add_action("do_split", "split");
}

int do_split(string arg) {
  object sword, blade;
  object me, woman;
  me = this_player();
  sword = first_inventory(me);
  blade = next_inventory(me);
  if (!arg || arg != "石棺")
    return notify_fail("你要劈开什么？\n");
  if ((string)sword->query("id") != "yinlian")
    return notify_fail("这具石棺无法劈开。\n");
  destruct(sword);
  blade = first_inventory(me);
  if ((int)me->query("force") < 1000 || (int)me->query("p_power_rank") < (me->query("age") * 10))
    return notify_fail("你举起银炼剑往石棺上劈去，结果你被震得虎口发麻，剑脱手飞去！\n");
  if ((string)blade->query("id") != "goldblade")
    return notify_fail("你举起银炼剑往石棺上劈去，结果啪的一声，银炼剑断为两截。\n");
  message_vision(CYN "\n$N左手拿金翅刀，右手拿银炼剑，对准石棺的中央猛劈过去！\n" NOR, me);
  woman = new("/u/baiwt/xueshan/ghost/npc/siniang");
  woman->move(environment(me));
  message_vision(CYN "\n你只见石棺哗啦一声巨响从中裂开，一个窈窕的身影突然出现在一阵烟雾中！\n" NOR, me);
  message_vision(HIW "\n$N手中的刀剑转眼间化作了一片光幕，向那个身影飞了过去。\n" NOR, me);
  message_vision(YEL "\n刀剑的光幕飞到那个身影的头顶，渐渐合成了一轮闪亮的圆月。\n" NOR, me);
  destruct(blade);
  return 1;
}
int valid_leave(object me, string dir) {
  object lady;
  me->clear_condition();
  if (objectp(present("si niang", environment(me)))) {
    lady = present("si niang", environment(me));
    destruct(lady);
  }
  return 1;
}
