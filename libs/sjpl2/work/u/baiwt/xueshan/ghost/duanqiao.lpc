inherit ROOM;

void create() {
  set("short", "断魂桥");
  set("long", @LONG
这是一座独木小桥，桥身似乎已经腐烂，桥下是万丈深渊，深不见底
。有一个黑影一动不动站在桥上，挡住了你的去路。四周越发昏暗，从南
边还不时飘来一股腥臭之气，令人毛骨悚然。
LONG
  );
  set("exits", ([
    "west": __DIR__ "xdao1",
    //		"east" : __DIR__"yougu",
    "south": __DIR__ "tomb0",
    "northwest": __DIR__ "xdao2",
    "southwest": __DIR__ "xdao3",
  ]));
  set("objects", ([
    __DIR__ "npc/duwuchang": 1,
    __DIR__ "npc/ghost1": 1,
    __DIR__ "npc/ghost2": 1,
    __DIR__ "npc/ghost3": 1,
    __DIR__ "npc/ghost4": 1,
  ]));
  set("outdoors", "xueshan");
  setup();
}
int valid_leave(object me, string dir) {
  object *inv;
  object ob;
  if ((dir == "south")
    && ((string)me->query("family/family_name") != "幽冥教")
    && objectp(present("du wuchang", environment(me))))
    return notify_fail("毒无常的身影捷如鬼魅般地飘了过来，冷冷说道：要进坟地先拜我为师！”\n");
  return ::valid_leave(me, dir);

  if (userp(me)) {
    switch (random(9)) {
      case 0:
        message_vision("$N脚下一滑，在断魂桥上晃了晃．．\n", me);
        return notify_fail("还好，没掉下去！\n");
        break;
      case 1:
        inv = all_inventory(me);
        if (sizeof(inv) >= 1) {
          ob = inv[random(sizeof(inv))];
          message_vision(ob->name() + "从$N身上滑了出来，落入万丈深渊．\n", me);
          destruct(ob);
        }
        return notify_fail("你在断魂桥上前仰后合地晃着．．．\n");
        break;
      default:
        return 1;
        break;
    }
  } else
    return 1;
}
