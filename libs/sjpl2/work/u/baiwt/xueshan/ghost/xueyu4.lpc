inherit ROOM;

void create() {
  set("short", "雪域冰瀑");
  set("long", @LONG
你走到这里便觉得眼前一亮，巨大的冰瀑从山峰顶上倒挂而下，发出
隆隆巨响，声势极为惊人。这里仍是阳光普照，但冰壁并不因此而融化，
在冰瀑的冲击下腾起蒙蒙白雾，景色蔚为壮观。
LONG
  );
  set("exits", ([
    "eastup": __DIR__ "nankou",
    "westdown": __DIR__ "shanpo2",
  ]));
  set("outdoors", "xueshan");

  setup();
}
void init() {
  add_action("do_go", "go");

}

int do_go() {
  if (random(5)) {
    this_player()->move(this_object());
    return 1;
  }
}
