inherit ROOM;

void create() {
  set("short", "迷茫小道");
  set("long", @LONG
你走在一条狭窄的石子小道上，道旁难得可见一两株枯黄的野草，四
周寂静无声，灰蒙蒙地看不清前方的道路。你不由得心中发毛，脑海里一
片迷茫。
LONG
  );
  set("exits", ([
    "east": __DIR__ "duanqiao",
    "west": __DIR__ "sancha1",
  ]));
  set("outdoors", "xueshan");
  setup();
}
