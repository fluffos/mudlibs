#include <weapon.h>
inherit WHIP;
void create() {
  set_name("铁枷赤索", ({ "whip" }));
  set_weight(30000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("value", 500);
    set("material", "stone");
    set("long", "一把极沉的赤索。\n");
    set("weapon_prop/constitution", 1);
  }
  init_whip(5);
  setup();
}
