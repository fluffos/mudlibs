#include <ansi.h>
inherit NPC;
void backattack();
void create() {
  int i, amun;
  string *order = ({ "张", "王", "李", "赵", "孙", "徐", "郑", "周", "吴",
    "蒋", "沈", "杨", "苗", "尹", "金", "魏", "陶" });
  string *orderr = ({ "依风", "送终", "孤魂", "不死", "还阳",
    "披麻", "带孝", "守灵" });
  set_name(order[random(17)] + orderr[random(8)], ({ "ghost" }));
  set("gender", "男性");
  set("age", random(20) + 20);
  //	set("env/wimpy",90);
  set("str", 30);
  set("cor", 50);
  set("bellicosity", 100);
  set("long",
    "他是幽冥教已故弟子．\n借了别人的尸体还魂．\n他面无表情，脸色看上去阴森可怖．\n");
  set("attitude", "friendly");
  set("class", "deadman");
  set("combat_exp", 0);
  set_skill("ghostflag", 10);
  set_skill("parry", 10);
  set_skill("dodge", 10);
  set_skill("unarmed", 10);
  set_skill("fork", 10);
  set_skill("ghostclaw", 20);
  map_skill("unarmed", "ghostclaw");
  map_skill("parry", "ghostflag");
  map_skill("fork", "ghostflag");
  setup();
  carry_object("/u/baiwt/xueshan/obj/cloth")->wear();
  carry_object("/u/baiwt/xueshan/obj/dieflag")->wield();
}

int heal_up() {
  if (environment() && !is_fighting()) {
    call_out("leave", 1);
    return 1;
  }
  if (is_fighting() && (int)this_object()->query("kee") <= 100)
    backattack();
  return ::heal_up() + 1;
}

void leave() {
  object me, owner;
  me = this_player();
  owner = this_object();
  //       if(objectp(owner=this_object()->query("possessed")))
  if ((int)me->query("sen") < 50) {
    owner->add_temp("max_guard", -1);
    message("vision",
      name() + "喃喃道：我. . .的. . .使. . .命. . .结. . .束. . .了. . .\n\n"
      +name() + "渐渐的虚化，消失了．．．\n", environment(),
      this_object());
    destruct(this_object());
    me->dismiss_team();
  } else {}
}

void invocation(object who, int level) {
  int i;
  object *enemy;
  message("vision",
    name() + "发出阴森森的冷笑，令人毛骨悚然！\n" NOR,
    environment(), this_object());
  enemy = who->query_enemy();
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      kill_ob(enemy[i]);
      if (userp(enemy[i])) enemy[i]->fight_ob(this_object());
      else enemy[i]->kill_ob(this_object());
    }
  }
  set_leader(who);
  set("possessed", who);
}
void backattack() {
  int i;
  object owner, *enemy;
  if (objectp(owner = this_object()->query("possessed"))) {
    enemy = this_object()->query_enemy();
    i = sizeof(enemy);
    while (i--) {
      if (enemy[i] && living(enemy[i])) {
        owner->kill_ob(enemy[i]);
        enemy[i]->kill_ob(owner);
      }
    }

  }

}

void die() {
  object owner;
  if (objectp(owner = this_object()->query("possessed")))
    owner->add_temp("max_guard", -1);
  ::die();
}
