#include <ansi.h>
inherit NPC;
//inherit F_VENDOR;
void create() {
  set_name("马老千", ({ "laoqian" }));
  set("gender", "男性");
  set("age", 36);
  set("long",
    "这是一个终日游手好闲、不学无术的人.\n"
  );
  set("attitude", "friendly");
  set("combat_exp", 100);
  set_skill("unarmed", 50);
  set("chat_chance", 10);
  set("chat_msg", ({
    GRN "马老千(laoqian)告诉你：给我十两金子，就告诉你幽冥谷的真正秘密。\n" NOR,
    GRN "马老千(laoqian)告诉你：江湖上的传闻都是骗人的，进幽冥谷其实只要什么都不带就可以了.\n" NOR,
  }));
  setup();
  carry_object(__DIR__ "obj/cloth")->wear();

}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}
void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  say(GRN "马老千(laoqian)告诉你：江湖险恶，千万不要被人骗了！\n" NOR);

}
int accept_object(object who, object ob) {
  int val;
  val = ob->value();
  if (!val)
    return 0;
  else if (val = 100000) {
    message_vision(GRN "马老千回答$N：哈哈，你上当啦！哪有这样容易的事？真是个傻蛋！\n" NOR, who);
  }
  return 1;
}
