#include <armor.h>

inherit CLOTH;

void create() {
  set_name("黑色长袍", ({ "blackpao" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "这是一件印有白色斑点的黑色长袍。\n");
    set("value", 1000);
    set("material", "cloth");
    set("armor_prop/armor", 10);
  }
  setup();
}
