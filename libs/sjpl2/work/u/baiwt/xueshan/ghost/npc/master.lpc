#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int about_ren1();
int about_ren2();
int about_ren3();
int about_ren4();
void create() {
  set_name("姬子洛", ({ "master ji", "ji", "master" }));
  set("long",
    "这是一个四十五六岁的中年人, \n" +
    "他心事重重，满脸风霜憔悴之色。\n" +
    "传说他隐居幽冥谷已经十多年了。\n");
  set("title", "幽冥教教主");
  set("gender", "男性");
  set("age", 46);
  set("nickname", HIC "死谷幽灵" NOR);
  set("attitude", "peaceful");
  set("str", 30);
  set("int", 30);
  set("cor", 30);
  set("spi", 30);
  set("max_kee", 3000);
  set("max_gin", 3000);
  set("max_sen", 3000);
  set("kee", 3000);
  set("gin", 3000);
  set("sen", 3000);

  set("force", 3000);
  set("max_force", 3000);
  set("force_factor", 60);

  set("combat_exp", 60000000);
  set("score", 20000);

  set_skill("literate", 250);
  set_skill("force", 250);
  set_skill("unarmed", 250);
  set_skill("fork", 250);
  set_skill("sword", 250);
  set_skill("parry", 250);
  set_skill("dodge", 250);
  set_skill("ghostflag", 250);
  set_skill("ghostsword", 250);
  set_skill("ghoststeps", 250);
  set_skill("hotforce", 250);
  set_skill("sunclaw", 250);
  map_skill("sword", "ghostsword");
  map_skill("force", "hotforce");
  map_skill("parry", "ghostsword");
  map_skill("unarmed", "sunclaw");
  map_skill("dodge", "ghoststeps");

  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed.sunshine" :),
  }));
  create_family("幽冥教", 1, "祖师");
  set("class", "deadman");
  set("inquiry", ([
    "叹息": (: about_ren1 :),
    "四娘": (: about_ren2 :),
    "石棺": (: about_ren3 :),
    "天香三宝": (: about_ren4 :),
  ]));

  setup();
  carry_object(__DIR__ "obj/clothb")->wear();
}
int accept_fight(object me) {
  command("say 姬某久未与人动手，早已去了争胜之心了。");
  return 0;
}

void attempt_apprentice(object ob) {
  if ((int)ob->query_skill("ghostsword", 1) < 60) {
    command("say " + RANK_D->query_respect(ob) + "的招魂剑术还不够。");
    return;
  }
  if ((string)ob->query("class") == "deadman") {
    message_vision("姬子洛垂目沉思片刻, 说道：“好吧, 我就收下你了。”\n", ob);
    command("recruit " + ob->query("id"));
    if ((string)ob->query("class") != "deadman")
      ob->set("class", "deadman");
    return;
  } else {
    message_vision("姬子洛挥了挥手，说道：“阁下与姬某无缘。”\n", ob);
    return;
  }
}

void init() {
  add_action("do_killing", "kill");
}

int do_killing(string arg) {

  object player, victim;
  string name;
  player = this_player();
  if (objectp(victim = present(arg, environment(this_object()))) && living(victim)) {
    name = victim->name();
    if (name == "魏四娘") {
      message_vision("$N皱皱眉头。\n", this_object());
      this_object()->kill_ob(player);
      player->kill_ob(this_object());
      return 0;
    }
    if (name == "姬子洛") {
      message_vision("$N皱皱眉头。\n", this_object());
      return 0;
    }
    return 0;
  }
  return 0;
}
int about_ren1() {
  say("姬子洛叹了口气，道：四娘一生中唯一的遗憾就是没能找回失落的天香三宝，我\n");
  say("在这里为她守着尸体，希望有朝一日能用天香三宝为她劈开石棺，让她重见天日。\n");
  return 1;
}
int about_ren2() {
  say("姬子洛说道：她就是当年轰传武林的[天香仙子]魏四娘，后来因三宝遗失，由愁\n");
  say("生病，在她二十九岁时就失去了年青的生命。\n");
  return 1;
}
int about_ren3() {
  say("姬子洛说道：四娘虽然死了，但她的尸体还保存得完好无缺。这具石棺由万丈深\n");
  say("渊底下得寒石做成，没有缝隙和盖子，可以将尸体永远保存。要打开它，只有用\n");
  say("天香三宝才行。\n");
  return 1;
}
int about_ren4() {
  say("姬子洛说道：天香三宝是传说中得金翅刀、银炼剑和玉龙镯。必须带齐这三件宝物\n");
  say("然后用刀和剑劈开石棺（split），再把玉龙镯交给四娘戴上，她就可以死而复生了。\n");
  return 1;
}
