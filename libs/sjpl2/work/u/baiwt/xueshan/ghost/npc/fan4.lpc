#include <ansi.h>
inherit NPC;
//inherit F_VENDOR;
void create() {
  set_name("吴十四", ({ "seller" }));
  set("gender", "男性");
  set("age", 36);
  set("long",
    "这是一个卖灯笼的小贩.\n"
  );
  set("attitude", "friendly");
  set("combat_exp", 100);
  set_skill("unarmed", 50);
  setup();
  carry_object(__DIR__ "obj/cloth")->wear();

}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}
void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  command("say 我的琉璃灯笼乃传家之宝，进幽冥谷没问题。五十两银子一盏。\n");

}
int accept_object(object who, object ob) {
  int val;
  object paper;
  val = ob->value();
  if (!val)
    return 0;
  else if (val = 5000) {
    paper = new(__DIR__ "obj/glass_light");
    if (paper) {
      paper->set("targetprice", val);
      paper->move(who);
    }
  }
  say("吴十四说道：相信我没错的！\n");
  return 1;
}
