// xiaolu1.c 林间小径
// by baiwt
#include <ansi.h>
inherit ROOM;
int do_log(string arg);
int complete_cutting(object me);

void create() {
  set("short", "林间小径");
  set("long", @LONG
你走在一条小径上，两旁种满了竹子，修篁森森，绿荫满地，除了竹叶
声和鸟鸣声，听不到别的动静。
LONG
  );

  set("exits", ([
    "westup": __DIR__ "hongchun",
    "east": __DIR__ "qingyinge",
  ]));
  set("no_fight", 1);
  set("hell", 1);
  set("no_study", 1);
  set("no_magic", 1);
  set("no_spells", 1);
  set("outdoors", "emei");
  setup();
}

void init() {
  object ob;
  if (interactive(ob = this_player()))
    call_out("complete_cutting", random(10) + 3, ob);
  add_action("do_log", "log");
  add_action("close_cmds", "fight");
  add_action("close_cmds", "exert");
  add_action("close_cmds", "perform");
}
int close_cmds(object me, string arg) {
  return 1;
}

int do_log(string arg) {
  object me = this_player();
  if (arg != "bamboo")
    return notify_fail("你要砍什么？\n");
  if (me->query("marks/emjob") != "bamboo")
    return notify_fail("你并没有伐竹的任务。\n");
  if (me->query_temp("cut_bamboo") > 20)
    return notify_fail("你的工作已经完成了。\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢。\n");
  if (me->query("sen") < 22)
    return notify_fail("你心神不定，无法静下心来砍伐。\n");
  if (!me->query_temp("cut_bamboo"))
    message_vision(CYN "$N拿出柴刀，用足气力，对准一棵葱绿的粗竹砍了过去。\n" NOR, me);
  else
    message_vision(CYN "$N砍倒了近前的竹子，又往竹林深处走了几步，继续砍伐。\n
$N拿出柴刀，用足气力，对准一棵葱绿的粗竹砍了过去。\n" NOR, me);
  me->start_busy(6);
  me->receive_damage("sen", random(20) + 1);
  if (me->query_skill("unarmed", 1) < 20) {
    me->improve_skill("unarmed", random((int)me->query("kar")) + 10);
    me->add("potential", 1);
  }
  me->add("life_exp", random(10) + 1);
  me->set_temp("cutting_now", 1);
  return 1;
}
int complete_cutting(object ob) {
  int i;
  int damage;
  object bamboo;
  if (!ob->query_temp("cutting_now")) {
    call_out("complete_cutting", random(20) + 1, ob);
    return 0;
  }
  if (ob->query_temp("cut_bamboo") < 20 && environment(ob) == this_object()) {
    tell_object(this_object(), "\n竹林郁郁葱葱，好似一片绿色屏障，一眼望不到边。\n");
    ob->add_temp("cut_bamboo", 1);
    if (environment(ob) == this_object())
      call_out("complete_cutting", random(20) + 1, ob);
  } else {
    ob->remove_call_out("complete_cutting");
    tell_object(this_object(), CYN "\n随着一棵又一棵的竹子倒下，你的任务终于完成了。\n\n" NOR);
    bamboo = new("/obj/toy/bamboo");
    bamboo->move(ob);
    ob->delete_temp("cut_bamboo");
    ob->delete_temp("cutting_now");
    ob->delete("marks/emjob");
    //	ob->move("/u/emei/xiaolu22");
  }
  return 1;
}
int valid_leave(object me, string dir) {
  object ob;
  if (me->query_temp("cutting_now"))
    return notify_fail("你的伐竹工作还没有做完，怎么就离开了呢？\n");
  return ::valid_leave(me, dir);
}
