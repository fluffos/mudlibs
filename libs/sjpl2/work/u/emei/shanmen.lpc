inherit ROOM;

void create() {
  set("short", "山门");
  set("long", @LONG
这是峨眉山的山门，十分高大雄伟。门檐作飞檐蹿角式结构，矗
立在山道中央。门边有一石碑，上书八个大字：“青灯宝莲，普照众
生”。左边门柱刻着“剑指天南”，右边门柱刻着“峨眉披风”。
LONG
  );
  set("exits", ([
    "southdown": __DIR__ "shanroad2",
    "westup": __DIR__ "shanlu1",
  ]));
  set("objects", ([
    __DIR__ "npc/shao": 1,
  ]));
  set("outdoors", "emei");
  setup();
}
