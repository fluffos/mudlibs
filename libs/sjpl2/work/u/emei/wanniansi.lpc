inherit ROOM;

void create() {
  set("short", "万年寺");
  set("long", @LONG
万年寺天王殿内，左右塑像高大庄严，那是天界护法四大金刚，
中间是满脸慈祥的普贤菩萨,在案上摆着各种供品。殿中还有一
尊铜铸普贤骑象像，通高七米，重十二万四千斤，为镇寺之宝。
在案上摆着各种供品。
LONG
  );
  set("exits", ([
    "north": __DIR__ "xiaolu12",
    "west": __DIR__ "sleeproom",
  ]));
  set("objects", ([
    __DIR__ "npc/baiyun": 1,
  ]));
  set("item_desc", ([
    "供品": "案子上摆着各种各样的水果,有苹果、香蕉、桃子。\n",
  ]));

  setup();
}

int valid_leave(object me, string dir) {
  object ob;
  if (dir == "west" && present("bai yun", environment(me)) &&
    me->query("class") != "emei")
    return notify_fail("白云子伸手一拦，说道：“非本派弟子请回！”\n");
  return ::valid_leave(me, dir);
}

void init() {
  add_action("do_steal", "steal");

}

int do_steal(string arg) {
  object me, lu;

  if (arg != "桃子")
    return notify_fail("什么？\n");
  me = this_player();
  lu = new(__DIR__ "obj/taozi");
  lu->move(me);

  message_vision("\n$N趁人不注意从案子上偷了一个桃子赶紧放进怀里。\n", me);
  return 1;
}
