inherit ROOM;

void create() {
  set("short", "洗象池");
  set("long", @LONG
这是一泓清澈见底的池水，每当清晨朝露时分，池面会渐起一层
白白的水雾，犹如天上云海，瑶池仙境一般。传说普贤菩萨曾在此洗
过他的坐骑白象。由于这一带气候宜人，果植丰富，因此常有猴群出
没。
LONG
  );
  set("exits", ([
    "northwest": __DIR__ "xiaolu23",
  ]));
  set("objects", ([
    __DIR__ "npc/tongyun": 1,
  ]));
  set("outdoors", "emei");
  setup();
  replace_program(ROOM);
}
