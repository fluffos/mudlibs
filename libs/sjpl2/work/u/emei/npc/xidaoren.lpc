#include <ansi.h>
inherit NPC;
string reward_more(object who);

void create() {

  set_name("西象道长", ({ "xi daoren", "xi", "daoren" }));
  set("long", "这是一位峨眉弟子，主守四象剑阵的“西象”位。\n");
  set("attitude", "friendly");

  set("str", 40);
  set("cor", 30);
  set("cps", 25);
  set("class", "emei");
  set("max_kee", 1000);
  set("max_sen", 1000);

  set("combat_exp", 300000);
  set_skill("sword", 100);
  set_skill("parry", 100);
  set_skill("dodge", 100);
  set_skill("unarmed", 100);
  set_skill("force", 100);

  set_skill("wind_sword", 100);
  set_skill("mian_strike", 100);
  set_skill("taiqing_force", 100);
  set_skill("ganchan_steps", 100);

  map_skill("dodge", "ganchan_steps");
  map_skill("unarmed", "mian_strike");
  map_skill("force", "taiqing_force");
  map_skill("parry", "wind_sword");
  map_skill("sword", "wind_sword");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: reward_more(this_object()) :),
  }));
  setup();
  carry_object("/obj/longsword")->wield();
  carry_object("/obj/cloth")->wear();
}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  object me = this_object();
  if (!ob || environment(ob) != environment()) return;
  if (ob->query("class") != "emei" && ob->query_temp("emei/jianzhen") < 1) {
    command("say 好大的胆子，竟敢擅闯四象剑阵，拿命来吧！\n");
    message_vision(CYN "$N长剑一振，展开了四象剑阵！\n" NOR, me, ob);
    message_vision(CYN "但见人影翻飞，剑光如虹，交织错落，登时将$n罩在一片剑网之中！\n" NOR, me, ob);
    me->set("combat_exp", (int)ob->query("combat_exp") * 3 / 2);
    if (ob->query("combat_exp") < 300000) me->set("combat_exp", 500000);
    me->kill_ob(ob);
    ob->kill_ob(me);
    ob->set("break_jianzhen", 0);
  } else {
    command("say 有人来闯阵了，四象就位！\n");
    message_vision(CYN "$N长剑一振，展开了四象剑阵！\n" NOR, me, ob);
    message_vision(CYN "但见人影翻飞，剑光如虹，交织错落，登时将$n罩在一片剑网之中！\n" NOR, me, ob);
    me->set("combat_exp", (int)ob->query("combat_exp"));
    if (ob->query("combat_exp") < 300000) me->set("combat_exp", 500000);
    me->fight_ob(ob);
    ob->fight_ob(me);
  }
}
string reward_more(object who) {
  int i;
  object *enemy;
  seteuid(getuid());
  enemy = who->query_enemy();
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      if (enemy[i]->query("combat_exp") > 600000) return "1";
      enemy[i]->add("combat_exp", random(2) + 1);
      if (enemy[i]->query("potential") - enemy[i]->query("learned_points") > 500) return "1";
      else
        enemy[i]->add("potential", random(2) + 1);
    }
  }
  return "1";
}
int accept_fight(object me) {
  return 0;
}
void die() {
  object me = this_player();
  if (me->query("id_type") == 2) me->add("break_jianzhen", 1);
  ::die();
}
