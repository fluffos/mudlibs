#include <ansi.h>
inherit NPC;
void create() {


  set_name("小猴子", ({ "monkey" }));
  set("race", "野兽");
  set("age", 5);
  set("long", "一只非常机灵的小猴子。 \n");
  set("combat_exp", 30000);
  set("limbs", ({ "头部", "身体", "尾巴" }));
  set("verbs", ({ "bite" }));

  set_skill("dodge", 100);
  set_skill("unarmed", 100);
  setup();
}
int accept_object(object who, object ob) {
  object room;
  if (ob->name() == "桃子") {

    //        if(!( room = find_object("/u/losey/shandong")) )
    //                room = load_object("/u/losey/shandong");
    message_vision(HIC "\n小猴子吱吱叫着牵着$N的手，朝着秘林跑了过去。\n" NOR, who);
    //        who->move(room);
    //        message_vision(HIC"\n小猴子牵着$N的手走了过来，又吱吱的叫了几声，就跑开了。\n"NOR,who);
    return 1;
  } else {
    say("小猴子朝着你吱的叫了一声。\n");
    return 0;
  }
  return 1;
}
