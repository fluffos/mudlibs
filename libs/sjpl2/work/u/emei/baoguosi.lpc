inherit ROOM;

void create() {
  set("short", "报国寺");
  set("long", @LONG
这是峨眉第一古刹报国寺。寺院建筑宏伟，三坐大殿耸立在正中，
大雄宝殿上有容貌端庄，体态安详的释迦牟尼佛像，背面是“慈航普
渡”的群塑。殿后法堂上悬挂一口青铜大钟，一槌下去，那洪亮的声
音震撼四方，二十里内可以清晰地听到。
LONG
  );
  set("exits", ([
    "west": __DIR__ "xiaolu11",
    "south": __DIR__ "wuwujing",
    "northeast": __DIR__ "shanroad4",
  ]));
  set("objects", ([
    __DIR__ "npc/yuqihui": 1,
    __DIR__ "npc/yuqihuang": 1,
  ]));
  setup();
}
