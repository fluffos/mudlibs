inherit ROOM;

void create() {
  set("short", "舍身崖");
  set("long", @LONG
舍身崖石壁突兀，是全山最险要之地。传说峨眉山原来地势平畴
，常伴有山洪，危害周围山村生灵。普贤菩萨经过此地，闻知后从舍
身崖跳下，化作一片突起的断块山脉，镇住了山洪，从此峨眉山葱茏
翠绿，清幽秀雅，舍身崖和普贤菩萨舍身救世的动人故事也广为流传。
LONG
  );
  set("exits", ([
    "southup": __DIR__ "xiaolu13",
    "northeast": __DIR__ "hongchun",
  ]));
  set("outdoors", "emei");
  setup();
}
