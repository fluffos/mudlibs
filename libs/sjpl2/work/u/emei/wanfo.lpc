inherit ROOM;

void create() {
  set("short", "万佛顶");
  set("long", @LONG
峨眉山主峰万佛顶，海拔三千零九十九米，又称金顶，登金顶可
观云海、日出、佛光、圣灯四大奇观。从这里往南是睹光岩，往北可
观金顶宝光。身处万佛顶，你不禁有种立地成佛的感觉。
LONG
  );
  set("exits", ([
    "northwest": __DIR__ "longmen",
    "southeast": __DIR__ "shengdeng",
    "northeast": __DIR__ "baoguang",
  ]));
  set("objects", ([
    __DIR__ "npc/master1": 1,
  ]));
  set("outdoors", "emei");
  setup();
  replace_program(ROOM);
}
