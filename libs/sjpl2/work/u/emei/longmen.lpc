inherit ROOM;

void create() {
  set("short", "龙门洞");
  set("long", @LONG
你来到了群山环抱的龙门洞前。只见一座天然石门凌空飞架，巍
然耸立，上刻“龙门”二字。洞顶突兀深郁，高不可测，洞内霞光灿
烂，雾蔼氤氲，笼罩着一派神秘的气氛。
LONG
  );
  set("exits", ([
    "enter": __DIR__ "longgong",
    "southeast": __DIR__ "wanfo",
    "north": __DIR__ "xiaolu13",
  ]));
  set("objects", ([
    __DIR__ "npc/yongji": 1,
  ]));
  set("outdoors", "emei");
  setup();
}
