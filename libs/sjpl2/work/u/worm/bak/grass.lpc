//road.c
#include <ansi.h>
inherit ROOM;
void over(object who);
void keep(object who);
void create() {
  set("short", "缥缈山麓");
  set("long", @LONG
这里是飘渺峰的脚下，山势平缓阳光从山峰的缝隙中透射过来，远远近近的
丘陵，在柔和的光影中生息，葛草叶子和着丁香在风中繁芜，
前面好象是一片村落，笼罩在弥漫的蒸汽般的光芒中。山坡
上几只绵羊正在安静的咀嚼着嫩嫩的青草。
LONG
  );
  set("exits", ([
    "northwest": __DIR__ "road1",
    "westdown": __DIR__ "road",
  ]));
  set("objects", ([
    __DIR__ "npc/sheep": 10,
  ]));
  setup();

}

void init() {
  object *ob;
  int i, n;
  if (this_player()->query_temp("grass"))
    add_action("do_cut", "cut");



  if (this_player()->query_temp("sheep")) {
    message_vision(HIW "$N看着连绵的青山，嫩绿的草原，天上浮动的白云，不禁\n"
      "心情畅快的高声唱到:在那遥远的地方有位好姑娘，。。。。。。她那火红的笑\n"
      "脸好象红太阳。。。。我愿变成一只小羊跟在她身后，让她细细的鞭子轻轻\n"
      "打在我的身上.......\n" NOR, this_player());

    remove_call_out("over");
    call_out("over", 100, this_player());
    remove_call_out("keep");
    call_out("keep", 1, this_player());

  }


}



void keep(object who) {
  int n = random(5);
  object ob, sheep;

  if (n == 1) {
    message_vision("不知从什么地方窜出来一只 。。。。豺狗!，迅猛的扑向了羊群\n", who);
    sheep = present("sheep", this_object());
    ob = new(__DIR__ "npc/wolfdog");
    ob->move(this_object());
    ob->kill_ob(sheep);
    remove_call_out("keep");
    call_out("keep", 10, who);
    return;
  }
  /*  if(x==2){
  message_vision("从草丛后面窜出一条狼，冲着羊群冲了过去\n",who);
  sheep=present("sheep",this_object());
  ob=new(__DIR__"npc/wolf");
  ob->move(this_object());
  ob->kill_ob(sheep);
  return;
  }
  if(x==3){
  message_vision("faint!!!!老虎!!!!!!\n",who);
  sheep=present("sheep",this_object());
  ob=new(__DIR__"npc/tiger");
  ob->move(this_object());
  ob->kill_ob(sheep);
  ob->kill_ob(this_player());
  return;
  }
*/
  remove_call_out("keep");
  call_out("keep", 5, who);

}
int do_cut(string arg) {
  int n;
  object ob;
  if (this_player()->query_temp("over"))
    return notify_fail("别假积极了。\n");
  if (!arg)
    return notify_fail("要割草么？(cut grass)\n");
  if (this_player()->query_temp("busy"))
    return notify_fail(RED "一个字: 急!\n" NOR);
  this_player()->set_temp("busy", 1);
  if (this_player()->query_temp("num") == this_player()->query_temp("grass")) {
    write(YEL "你擦了擦额头的汗水，该收工了！\n" NOR);
    message_vision("$N擦了擦额头的汗水，收拾起一大捆嫩嫩的青草放到背后的竹筐里。收工了!\n", this_player());
    ob = new(__DIR__ "obj/zhucao");
    ob->move(this_player());
    this_player()->delete_temp("grass");
    this_player()->delete_temp("num");
    this_player()->set_temp("okg", 1);
    this_player()->delete_temp("busy");
    return 1;
  }
  message_vision("$N佝偻着身子，细心的割着地上的嫩草。\n", this_player());
  remove_call_out("improve");
  call_out("improve", 1, this_player());
  this_player()->start_busy(1);
  return 1;
}



void improve(object who) {

  object ob;

  who->improve_skill("sword", random((int)who->query("int")));
  who->add("sen", -(35 - (int)who->query_skill("sword", 1) / 5));
  who->add("gin", -(35 - (int)who->query_skill("swrod", 1) / 5));

  who->add_temp("num", 1);
  who->set_temp("busy", 0);
}

void over(object who) {
  int i, x;
  object *ob;
  write(HIW "差不多了虽然这样的生活很惬意，但我们的前路上还要经历的风雨还要自己去一个个面对,收工了\n" NOR);
  ob = all_inventory();

  remove_call_out("keep");
  for (i = 0; i < sizeof(ob); i++) {
    if (ob[i]->query("id") == "sheep")
      this_player()->add_temp("nume", 1);
    x = this_player()->query_temp("nume");
    write("Nu:" + x);
  }
  who->delete_temp("sheep");
  who->set_temp("over", 1);
}

void refresh() {

  object ob;
  if (ob = present("dog", this_object()))
    destruct(ob);

}
