#include <armor.h>

inherit CLOTH;

void create() {
  set_name("女套装", ({ "tao zhuang", "zhuang" }));
  set("long", "这是一件崭新漂亮的粉红色女套装,做工精细，显然出自名家之手。\n");
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("material", "cloth");
    set("unit", "件");
    set("value", 100000);
    set("armor_prop/armor", 200);
  }
  setup();
}
