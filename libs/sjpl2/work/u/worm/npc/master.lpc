// guotai.c
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string give();
int xiaoyao();
void send();
void create() {
  set_name("逍遥子", ({ "xiaoyao zi", "master xiaoyao", "xiaoyao" }));
  set("attitude", "friendly");
  create_family("逍遥派", 10, "弟子");
  set("age", 100);
  set("long", "他就是逍遥派第十代掌门，神功深不可测，从外形上很难分辨他的年岁.\n");
  set("str", 30);
  set("per", 30);
  set("cps", 30);
  set("int", 30);
  set("spi", 30);

  set("title", "普通百姓");
  set("max_kee", 9000);
  set("kee", 9000);
  set("food", 1000);
  set("water", 1000);
  set("force", 9000);
  set("max_force", 9000);
  set("force_factor", 50);
  set("chat_chance", 3);
  set("chat_msg", ({
    (: command("consider") :),
    (: command("say 。。。人和人是一种什么关系呢？为什么有人富有，有人却在问一顿饱饭苦苦挣扎。。。。\n") :),
    (: command("sigh") :),
    (: command("say ....也许只有社会的统一富裕才能弥合这贫富上的偏差,才能让人类社会共同进步。。。。\n") :),
    (: command("nod") :),
    (: command("say 。。。。可为什么人民的权利总是被某些当权者忽视呢？。。。  难道人民的呼声一无是处？....\n") :),
    (: command("say ....社会的人都处于一种群体，这个群体为了压迫其他群体必然会使用一切手段，包括暴力。。。。\n") :),
    (: command("say 苦难的人类。。。。。。。苦难的生命。。。。。。\n") :),
    (: command("say 。。。。必须要建立一个万物共有的社会体系，才能使权利分配达到公平。。。。。\n") :),
    (: command("say 可是。。。。。谈何容易呢？\n") :),

  }));
  set("combat_exp", 99999999);
  set_skill("dodge", 300);
  set_skill("unarmed", 300);
  set_skill("parry", 300);
  set_skill("ymei_strike", 300);
  set_skill("wave_steps", 300);
  set_skill("bm_force", 300);
  map_skill("force", "bm_force");
  map_skill("unarmed", "ymei_strike");
  map_skill("parry", "ymei_strike");
  map_skill("dodge", "wave_steps");
  set_skill("qidao", 300);
  set_skill("honey", 300);
  set_skill("music", 300);
  set_skill("fy_finger", 300);
  set_skill("gaoge_sword", 300);

  set("inquiry", ([



    "琅寰福地": "我在这里三十余年了，就是为了寻找世事无常的根源所在\n",

    "高歌子": (: xiaoyao :),
    "逍遥派": (: give :),
    "离开": (: send :),

  ]));

  setup();
  carry_object("/obj/cloth")->wear();
  //add_money("gold", 1);
}

void init() {
  object ob;

  ::init();

  if (interactive(ob = this_player())
    && !is_fighting()) {
    call_out("greet", 1, ob);
  }
  if (this_player()->query_temp("permit"))
    add_action("do_kneel", "apprentice");

}

void greet(object ob) {
  if (!ob || environment(ob) != environment()) return;
  if (ob->query("win")) {
    command("smile");
    command("say " + RANK_D->query_respect(ob)
      + "天赐英才，竟然能破解我的珍珑棋局.看来老天真的助我。来来来！快给我磕三个响头!!!");
    ob->set_temp("permit", 1);
    return;
  }
  if (ob->query("mark/逍遥子")) {
    command("smile");
    command("say 怎么样现在社会局势稳定么？革命的时机是否成熟，人民群众是否发动起来了?。。。\n");
    return;
  }
  message_vision(
    "逍遥子微微抬了抬头，对着$N一笑：“你们终于找到这里了,\n"
    "一个坚定的革命者随时准备着为自己的信仰牺牲，我早就等待着这一天了。出手吧。\n"
    , ob);
  return;
}

int do_kneel() {
  if (this_player()->query_temp("ketou") < 3) {
    message_vision("$N跪在$n的面前，屁股抬高，头不靠近地面，咚...一个响头\n", this_player(), this_object());
    this_player()->add_temp("ketou", 1);
    return 1;
  }
  message_vision("$N轻捋长髯，微笑点头看着$n道:不错不错 ,我的事业终于有人能够继承了。\n", this_object(), this_player());
  command("recruit " + this_player()->query("id"));
  this_player()->delete_temp("permit");
  this_player()->delete_temp("ketou");
  return 1;
}

void attempt_apprentice(object ob) {
  if (ob->query("win") && ob->query_temp("ketou") == 3) {
    message_vision("满意的地看着$N道: 同志，为了我们共同的事业努力吧！\n",
      ob);

    command("smile");

    command("recruit " + ob->query("id"));
  }
  return notify_fail("逍遥子摇了摇头道:组织的建设必须讲究程序性，你的手续不完备啊。\n");
}

int recruit_apprentice(object ob) {
  //   object yupei;
  //   string name;
  //   name=this_player()->query("name");
  //   yupei=new("/u/lark/xiaoyao/npc/obj/yupei");
  if ( ::recruit_apprentice(ob)) {
    message_vision("逍遥子对$N又道:我们不能为了狭隘的自己主义而盲目的生存"
      "我们必须以中国乃至人类社会的进步为己任，以后你投身到社会中去，\n"
      "一定要学会与人民群众打成一片，帮助他们认识到自己的利益所在，激发他们\n"
      "保护自己权利的意愿，等待革命时机成熟的时刻，用我们的知识体系来建立并\n"
      "规范一个新的世纪，但在此之前我们要保护好我们的组织，现在的革命形势还比较\n"
      "严峻，反革命势力还比较猖狂，记住，一定不要暴露身份，更不能泄露组织的秘密\n"
      "关键时刻要用自己的生命来保护它，明白么？\n", this_player());

    this_player()->delete("win");
    this_player()->set("mark/逍遥子");
    this_player()->set("class", "cccp");
    this_player()->set("title", "普通百姓");
    this_player()->set_temp("new", 1);
    //                yupei->set("owner",name);
    //                yupei->move(this_player());
    tell_object(this_player(), "逍遥子低声对你说:为了能让你更好的开展工作，我现在用\n"
      "我们逍遥派的密技《倒行逆施》大法，用我的神功激发你的潜能，来提高你的战斗力\n"
      "但是要先废去你身上原有的内功\n");
    message_vision("逍遥子脸色凝重，伸手比比画画的不知道在作些什么，半晌，额头渐渐出现了黄豆大的汗珠。\n", ob);
    command("say 注意!来了\n");
    call_out("prize", 1, this_player());


    return 1;
  }
}


void prize() {
  string skill;
  int n, e, p;
  skill = (string)this_player()->query_skill_mapped("force");
  n = (int)this_player()->query("force");
  e = (int)this_player()->query("combat_exp");
  p = (int)this_player()->query("potential");
  message_vision(HIC "$N轻轻地捧起$n的脸，给了$n一个无限温柔的吻.\n" NOR, this_object(), this_player());

  command("ya");
  command("say 大功告成\n");
  this_player()->delete_skill(skill);
  this_player()->set_skill("bm_force", 250);
  this_player()->set("max_force", n + 2000);
  this_player()->set("force", n + 2000);
  this_player()->set("combat_exp", e + 1000000);
  this_player()->set("potential", p + 20000);
  tell_object(this_player(), "你觉得体内真气突然澎湃不可抑制，身体飘然如云，又沉重似铅，\n"
    "一阵阵撕裂感让你不能忍受。。。。。。\n");
  this_player()->unconcious();
}
string give() {
  command("sigh");
  return "虽然说先师把逍遥派传给我是希望我能发扬光大\n"
    "可是我慢慢的发现，即使逍遥派在强大也不能改变人民大众的苦难生活丝毫\n"
    "只有找到一种新的道路，一种普遍的真理才能是全体人民，整个中国富强起来\n"
    "所以我把逍遥交给了高歌子，到这里来隐居,谁知道前几年回去看看，这小子\n"
    "竟然也不知踪影，听说是和那个丁丫头有关，哎，这小子实在是个多情种子\n"
    "我本来也知道他感情脆弱而泛滥，可惜呀，本来是块掌门的好材料。。。。\n"
    "现在那个掌门师兄 。。sigh。。。丁师兄还是和五十年前一样\n"
    "太过贪图功利，安插了那个姓楚的小子，无非还是想要掌门这个位置，实现野心\n"
    "其实我何尝不知，我实在是没有时间理会这样的俗务，希望先师有灵\n"
    "不要怪罪\n";



}

int xiaoyao() {
  command("say 他这小子什么都好，就是太过多情，而且还不自制\n");
  command("sigh");
  command("say 他从小就和丁丫头青梅竹马，两情相悦，可这也成了他唯一的弱点\n");
  command("say 只是我没有想到丁师兄会把女儿嫁给姓楚的那个小子，从心理上制约他\n");
  command("say 否则那一战胜负难料....算了，算了，随它去吧，反正本来掌门这个位置也该是丁师兄的。不提了\n");
  return 1;
}

void send() {
  object ob;
  ob = new("/u/lark/xiaoyao/obj/honghua");
  if (this_player()->query("mark/逍遥子")) {
    if (this_player()->query_temp("new")) {
      tell_object(this_player(), HIC "逍遥子低声说：作为一个职业的革命者，我们是属于世界人民的，所以\n"
        "从今后我们不再有派别的区别，但为了组织的需要和辨别的方便，这里有一朵红花，这个就是我们的\n"
        "标记，凡是带在左胸上的都是我们的同志，以后到了革命的洪流中要时刻牢记我们的志向,\n"
        "为了新生活！前进！！！！\n" NOR);
      ob->move(this_player());
      command("sob");
      command("say 同志!保重！\n");
      command("wave");
      tell_object(this_player(), "请type <leave>离开这里\n");
      this_player()->delete_temp("new");
      this_player()->set_temp("leave", 1);
      this_player()->delete_temp("kill");
      return;
    }
    command("nod");
    command("say 同志!保重！\n");
    this_player()->set_temp("leave", 1);
    return;
  }
  if (this_player()->query_temp("kill")) {
    command("sigh");
    command("say 好吧。。。如今之计不容我不狠心了\n");
    command("say 其实我挺欣赏你的，但为了事业的最后成功，对不住了\n");
    kill_ob(this_player());
    return;
  }
  command("heng");
  command("say 既然来到这里还想那么容易就走么？\n");
  command("say 除非你加入我们，否则我们不会这么轻易暴露组织的，迫不得已我只能......\n");
  command("grin");
  this_player()->set_temp("kill", 1);
  return;
}

int recognize_apprentice(object ob) {
  if (!ob->query("marks/逍遥子")) return 0;
  return 1;
}
