//xy.c
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "缥缈山麓");
  set("long", @LONG
道左一座座新修缮的小屋，新换的葛草屋顶美观，清爽，雅洁
温暖，干净。完全融合到了周围一片静谧安宁的田园风光中，恬
淡而与士无争的气氛让你的心安定不已。右手是一片等待收获的
稻田形成了缓缓起伏的小丘。曲折的道路贯穿其中。
LONG
  );
  set("exits", ([
    "eastup": __DIR__ "ground",
    "west": __DIR__ "daotian",
    "east": __DIR__ "house",
    "southdown": __DIR__ "road1",
  ]));
  set("objects", ([
    __DIR__ "npc/saux": 1,
  ]));
  setup();

}

int valid_leave(object who, string exit) {
  object ob, saux;
  string name;
  name = who->query("name");
  if (exit == "east") return 1;
  if (exit == "southdown") return 1;
  if (!present("saux", this_object())) return 1;
  saux = present("saux", this_object());
  if (ob = present("yupei", who)) {
    if (ob->query("owner") == name) {
      //        message_vision(HIW "韩江雪亲热的和$N的打了个招呼：“嗨！你好啊回来了？”\n" NOR,who);
      return 1;
    } else {
      message_vision("韩江雪拦住了$N，卸下了你的玉佩，仔细看了看：你是从那里得到的？你是谁？敢来冒充？\n", who);
      saux->kill_ob(who);
      return 0;
    }
  }
  if (ob = present("canguanpai", who)) {
    if ((time() - ob->query("shijian")) <= 300) {
      return 1;
    } else {
      message_vision("韩江雪拦住了$N，参观牌已经过期，谢绝参观!\n", who);

    }

  }




  return notify_fail("韩江雪摇了摇头说：“" + RANK_D->query_respect(who) +
    "大师哥不愿意外人打扰呀，请回吧。”\n");

}
