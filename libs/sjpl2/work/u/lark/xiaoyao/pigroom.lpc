//room:pigroom.c
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "猪舍");
  set("long", @LONG
这是一排用茅草和泥胚搭起来的猪圈，几头又肥又壮的pig，
正在泥巴里打着滚，并不停的发出了xx的叫声，似乎十分惬
意。
LONG
  );
  set("exits", ([
    "south": __DIR__ "daotian",
  ])),
    set("objects", ([
      __DIR__ "npc/pig": 4,
    ]));
  setup();
}

void init() {
  add_action("do_clear", "clear");
}

int do_clear(string arg) {
  int n;
  n = random(5) + 8;
  if (this_player()->query_temp("xiaoyao/quest") != 14)
    return notify_fail("什么？\n");

  if (arg)
    return notify_fail("要打扫猪圈么？(clear)\n");
  if (this_player()->query_temp("xiaoyao/over"))
    return notify_fail("别假积极了。\n");
  if (this_player()->query_temp("xiaoyao/busy"))
    return notify_fail(RED "一个字: 急!\n" NOR);
  if (this_player()->query("sen") < 40 || this_player()->query("gin") < 40)
    return notify_fail(RED "你够累的了，休息一下吧!\n" NOR);
  this_player()->set_temp("xiaoyao/busy", 1);
  if (this_player()->query_temp("xiaoyao/num") >= n) {
    write(HIC "总算掏完了，该收工了！\n" NOR);
    message_vision("$N直起身子摸摸有些酸痛的腰，用蘸满泥水的手擦了擦额头的汗水，收工了!\n", this_player());
    this_player()->delete_temp("xiaoyao/num");
    this_player()->set_temp("xiaoyao/over", 1);
    this_player()->delete_temp("xiaoyao/busy");
    return 1;
  }


  message_vision("$N躬下身子，用铲锹掏着圈里的污泥，脸色却越来越显的铁青.\n", this_player());
  write(HIC "第一次开始真正面对生活，既然是活，就一定要活好,为自己，为了她。\n" NOR);
  this_player()->start_busy(1);
  call_out("improve", 1, this_player());

  return 1;
}

void improve(object who) {

  if (!who) return;
  if (who->query_skill("parry", 1) < 200)
    who->improve_skill("parry", random((int)who->query("int")));
  who->add("sen", -(30 - (int)who->query_skill("unarmed", 1) / 8));
  who->add("gin", -(30 - (int)who->query_skill("unarmed", 1) / 8));

  who->add_temp("xiaoyao/num", 1);
  who->set_temp("xiaoyao/busy", 0);
}
