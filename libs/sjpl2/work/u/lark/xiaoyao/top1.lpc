//room:top1.c

inherit ROOM;

void create() {
  set("short", "飘渺峰顶");
  set("long", @LONG
沿着长满青苔的石板路，漫步向前，面前飘荡的雾气被你挤开两旁，
弥漫的花香却止不住的使你怀疑自己是否来到仙境，而这时候你发现，
前面不远处似乎出现了一片朦胧的楼阁。。。。。。。
LONG
  );
  set("exits", ([
    "south": __DIR__ "top",
    "north": __DIR__ "top2",
  ]));
  setup();
  replace_program(ROOM);
}
