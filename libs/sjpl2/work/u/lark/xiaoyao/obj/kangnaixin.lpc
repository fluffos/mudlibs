// dingx.c

#include <armor.h>
#include <ansi.h>
inherit HEAD;

void create() {
  set_name(YEL "康乃馨" NOR, ({ "moli" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "黄色的康乃馨那是爱情平静和幸福\n");
    set("unit", "枝");
    set("value", 100);
    set("armor_prop/personality", 2);
  }
  set("wear_msg", "$N细心地把康乃馨别在鬓角\n");
  set("unequip_msg", "$N从发间取下康乃馨\n");
  setup();
}
