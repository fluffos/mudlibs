//qdx.c

#include <ansi.h>
inherit ROOM;
void give(object who);
void create() {
  set("short", "草舍");
  set("long", @LONG
这里是逍遥派三师兄秦断弦的住舍，陈设简单朴素，从打开的窗
子可以看到远处缥缈峰烟云缭绕的山峦，窗下长案上横放这一副
瑶琴。案旁的香炉里缈然凫起一缕轻烟。
LONG
  );
  set("exits", ([
    "east": __DIR__ "xy4",
  ]));
  set("objects", ([
    __DIR__ "npc/qdx": 1,
  ]));
  setup();
}

void init() {
  if (present("qdx", this_object()))
    write(HIC "秦断弦轻拂琴弦，一股幽幽的曲调流畅而出。动人心涟\n" NOR);
  if (this_player()->query_temp("house"))
    add_action("do_clear", "clear");

}

int do_clear(string arg) {
  if (arg)
    return notify_fail("打扫？(clear)\n");
  if (this_player()->query_temp("busy"))
    return notify_fail(RED "一个字: 急!\n" NOR);
  if (this_player()->query_temp("over"))
    return notify_fail("别假积极了。\n");
  if (this_player()->query("sen") < 40 && this_player()->query("gin") < 40)
    return notify_fail(RED "你够累的了，休息一下吧!\n" NOR);
  this_player()->set_temp("busy", 1);
  if (this_player()->query_temp("num") == this_player()->query_temp("house")) {

    write(HIC "总算扫完了，该收工了！\n" NOR);
    message_vision("$N直起身子摸摸有些酸痛的腰，擦了擦额头的汗水收工了!\n", this_player());
    this_player()->delete_temp("busy");
    this_player()->set_temp("good", 1);
    this_player()->delete_temp("house");
    this_player()->delete_temp("num");
    this_player()->set_temp("over", 1);
    return 1;
  }


  message_vision("$N拿起扫把认真的打扫屋子\n", this_player());
  call_out("improve", 1, this_player());
  this_player()->start_busy(1);
  return 1;
}

void improve(object who) {

  object ob;

  who->improve_skill("dodge", random((int)who->query("int")));
  who->add("sen", -(35 - (int)who->query_skill("dodge", 1) / 5));
  who->add("gin", -(35 - (int)who->query_skill("dodge", 1) / 5));

  who->add_temp("num", 1);
  who->set_temp("busy", 0);
}


int valid_leave(object who, string exit) {
  int x, kar;
  kar = who->query("kar") / 2;
  x = random(kar);
  if (!present("qdx", this_object()))
    return 1;
  if (!who->query_temp("good")) return 1;
  if (who->query_skill("music", 1) > 1) {
    who->delete_temp("good");
    return 1;
  }
  if (x == 1) {
    tell_object(who, WHT "秦断弦抬起头向你微笑道：“不错不错打扫的挺干净的呦”\n" NOR);
    tell_object(who, WHT "秦断弦看了看你，摇了摇头看样子你对于音乐似乎很麻木哦?\n"
      "苦练武功当然是习武的要义，但是有些其他东西特别是音乐的培养同样也是重要的\n"
      "不仅可以陶冶性情，还可以对于内息的修炼有很大裨益.你等等。。。。。\n" NOR);
    remove_call_out("give");
    call_out("give", 1, who);
    return 0;
  }
  tell_object(who, WHT "秦断弦抬起头向你微笑道：“不错不错打扫的挺干净的呦,谢谢了。”\n" NOR);

  who->delete_temp("good");
  return 1;


}
void give(object who) {
  object book;
  tell_object(who, "正好我这里有本乐谱，你拿回去好好读读吧。\n");
  book = new(__DIR__ "obj/musicbook");
  book->move(who);
  who->delete_temp("good");
  return;
}
