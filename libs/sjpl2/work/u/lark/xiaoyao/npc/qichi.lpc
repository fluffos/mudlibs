#include <ansi.h>

inherit NPC;
int do_ask();
int do_qi();
int ok();
void over(object who, object ob);
int do_app(string arg);

void create() {
  set_name("棋痴子", ({ "qi chizi", "qi" }));
  set("long", "一个形容枯槁的男人。\n");
  set("attitude", "friendly");
  set("age", 30);
  set("str", 20);
  set("cor", 20);
  set("cps", 20);
  set("per", 10);
  set("inquiry", ([
    "上面": (: do_ask :),
    "棋局": "珍珑，珍珑。。。。。人间竟然真的存在那样的棋手么？\n"
    "但要是没有。。那又有谁能摆出那样的。。。珍珑....\n",
    "比试": (: ok :),
    "下棋": (: ok :),

  ]));
  set("chat_chance", 3);
  set("chat_msg", ({
    "棋痴子抬头看了看云雾笼罩的山峰摇了摇头，沮丧的叹了口气\n",
    "棋痴子喃喃道:那盘棋局。。。。。怎么可能呢？\n",
  }));
  set("combat_exp", 2000000);
  set_skill("qidao", 200);
  set_temp("apply/attack", 20);
  set_temp("apply/defense", 20);
  set_temp("apply/move", 20);

  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({

    (: perform_action, "unarmed.rain" :),
    (: perform_action, "unarmed.flower" :),
    (: perform_action, "dodge.walk" :),

  }));

  set("relation_exp", 90000);     //设置人际关系
  set("life_exp", 50000);         //设置江湖阅历

  set_skill("ymei_strike", 100);
  set_skill("unarmed", 100);
  set_skill("force", 100);
  set_skill("parry", 100);
  set_skill("dodge", 100);
  set_skill("bm_force", 100);
  set_skill("wave_steps", 100);

  map_skill("force", "bm_force");
  map_skill("unarmed", "ymei_strike");
  map_skill("parry", "ymei_strike");
  map_skill("dodge", "wave_steps");
  set_skill("move", 100);
  set_skill("literate", 100);
  setup();

  carry_object("/obj/cloth")->wear();

}

int do_ask() {
  if (this_player()->query("class") != "xiaoyao") {
    command("hmm");
    command("say 那里是逍遥派的重地,你是外人不适合知道,你还是快点离开这里吧。\n");
    return 1;
  }
  command("say 那里是逍遥派的重地。。。。。太师父他老人家就在那上面的飘渺峰隐居。。。。\n");
  command("sigh");
  command("say 我好不容易才到了上面。。。却破不了那棋局。。。无缘得见\n");
  command("say 我在这里面壁三年了仍然毫无头绪。。。。。。可笑我一直以为已经得到棋道真髓。。\n");
  command("shake");
  return 1;

}
void init() {
  add_action("do_app", ({ "apprentice" }));
  add_action("do_play", ({ "play" }));
}

int do_play() {
  if (this_object()->query("start_weiqi"))
    return notify_fail("你没有看到别人已经开始下了么？\n");
  if (this_player()->query("xiaoyao/winqi"))
    return notify_fail("棋痴子急忙起身道:阁下棋艺已非小子所能望攀\n");
  this_object()->set("start_weiqi", 1);
  message_vision("$N坐到了石座旁，伸手执起一枚棋子，开始和棋痴子对弈\n", this_player());
  this_player()->start_busy(20);
  remove_call_out("over");
  call_out("over", 10, this_player(), this_object());
}

void over(object who, object ob) {
  int n;
  if (!who || !ob) return;
  n = who->query_skill("qidao", 1);
  n = (int)(300 - n) / 10;
  n = random(n);
  who->start_busy(1);

  if (n == 1 && who->query_skill("qidao", 1) >= 150) {
    message_vision("棋痴子长舒一口气，缓缓抬起头对$N道：“一山更比一山高，阁下棋艺高绝，在下佩服了\n
   希望阁下能有机会破解珍珑，也算告慰在下痴心一片\n", who);
    command("bow");
    command("sigh");
    ob->set("start_weiqi", 0);
    who->set("xiaoyao/winqi", 1);
    return;
  } else
    message_vision("$N脸色突然一变，显得有些沮丧，缓缓站立起来对$n作揖道：“阁下棋艺高超，在下佩服！”\n", who, ob);
  command("bow");
  command("say 围棋一道博大精深，阁下不要灰心，能够由心入道，何必强求胜负。\n");
  who->improve_skill("qidao", random((int)who->query("int")));
  who->add("sen", -n);
  who->add("gin", -n);
  ob->set("start_weiqi", 0);
  return;
}

int do_app(string arg) {
  object ob = this_player();

  if (arg == "qi" || arg == "qi chizi") {
    message_vision("$N向棋痴子请教关于棋道的疑问.\n", this_player());


    command("say 围棋一道包罗万象，实非一朝一昔之功啊！既然你有心学习。。。。我就教教你吧。\n");
    ob->set("marks/棋痴子", 1);
    return 1;

  }
  "/cmds/std/apprentice"->main(ob, arg);
  //        return (int)call_other("/cmds/std/apprentice", "main", ob, arg);
  return 1;
}

int recognize_apprentice(object ob) {
  if (!ob->query("marks/棋痴子")) return 0;
  return 1;
}

int accept_object(object who, object ob) {
  if (ob->query("name") == "什锦炒饭" && who->query_temp("xiaoyao/quest") == 7) {
    who->set_temp("xiaoyao/over", 1);
    command("say 我可怎么吃的下.....\n");

    return 1;
  }
  return 0;
}

int ok() {

  message_vision("棋痴子抬头看了看$N,点了点头，道:好吧我们来摆一盘(play).\n", this_player());
  return 1;
}
