// kid.c
#include <ansi.h>
inherit NPC;

void create() {
  set_name("孩童", ({ "child" }));

  set("gender", "女性");
  set("age", 10);
  set("str", 10);
  set("cor", 10);
  set("cps", 11);
  set("per", 30);
  set("int", 21);



  set("long", "一个玩耍的孩童，可爱天真。\n");

  set("combat_exp", 800);
  set("chat_chance_combat", 15);
  set("chat_msg_combat", ({
    "你敢欺负我？高哥哥知道了不会饶了你。\n"
  }));
  set("chat_chance", 5);
  set("chat_msg", ({
    "孩童说道:“丁香姐姐已经好久没有唱歌了哦。”\n"
    "孩童点了点头叹了口气\n",
  }));

  set_skill("unarmed", 10);
  set_skill("parry", 10);
  set_skill("dodge", 10);
  set_skill("sword", 10);
  set_skill("force", 10);
  set_skill("literate", 10);


  setup();
  carry_object("/obj/cloth")->wear();
}
