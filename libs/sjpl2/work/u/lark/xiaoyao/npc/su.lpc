// guotai.c
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string give();
int xiaoyao();
void send();
void create() {
  set_name("苏星河", ({ "su xinghe", "su" }));
  set("attitude", "friendly");
  create_family("逍遥派", 12, "弟子");
  set("age", 54);
  set("long", "一个清瘦的老者，深邃的目光显得有些落寞 \n");
  set("str", 15);
  set("per", 30);
  set("cps", 29);
  set("int", 20);
  set("title", "聪辩子");
  set("max_kee", 3000);
  set("kee", 3000);
  set("food", 400);
  set("water", 400);
  set("force", 5000);
  set("max_force", 5000);
  set("force_factor", 30);
  set("chat_chance", 3);
  set("chat_msg", ({
    (: command("consider") :),
    (: command("sigh") :),
  }));
  set("combat_exp", 9999999);
  set_skill("dodge", 250);
  set_skill("unarmed", 250);
  set_skill("parry", 250);
  set_skill("ymei_strike", 250);
  set_skill("wave_steps", 250);
  set_skill("bm_force", 250);
  map_skill("force", "bm_force");
  map_skill("unarmed", "ymei_strike");
  map_skill("parry", "ymei_strike");
  map_skill("dodge", "wave_steps");
  set_skill("qidao", 250);
  set_skill("honey", 250);
  set_skill("music", 250);
  set_skill("fy_finger", 250);
  set_skill("gaoge_sword", 250);

  set("inquiry", ([
    "楼阁": "那就是琅寰福地了\n",
    "棋局": (: give :),
    "珍珑棋局": (: give :),
    "琅寰福地": "那里是师父避世隐居的地方\n"
    "不能随便打扰。\n",
    "破解": (: xiaoyao :),
    "有兴趣": (: xiaoyao :),
    "拜见师父": (: send :),

  ]));

  setup();
  carry_object("/obj/cloth")->wear();
  //add_money("gold", 1);
}

void init() {
  object ob;

  ::init();

  if (interactive(ob = this_player())
    && !is_fighting()) {
    call_out("greet", 1, ob);
  }
}

void greet(object ob) {
  if (!ob || environment(ob) != environment()) return;
  if (ob->query("mark/逍遥子")) {
    command("smile");
    command("say 师弟近来可好？来见师父么？\n");
    return;
  }
  message_vision(HIC
    "苏星河微微抬了抬头，对着$N漠然一笑：“阁下千辛万苦，一身臭汗到了这里也算不容易，可惜这里没有\n"
    "什么神丹迷药，也没有什么武功秘籍，只有一盘珍珑棋局，不知阁下有否兴趣破解？\n" NOR
    , ob);
  return;
}

string give() {
  command("nod");
  return "这盘棋是一位高人摆下的，他老人家说这个珍珑几乎无懈可击\n"
    "只有一个破绽，可以破解，老夫精研棋道三十余载,自以为学究\n"
    "天人，可。。。。。哎。。。十五了老夫依然不能破解，不知\n"
    "阁下可有兴趣？\n";

}

int xiaoyao() {
  object ob;
  if (this_player()->query("mark/逍遥子")) {
    command("say 师弟不必麻烦了，师父他老人家就在上面我送你一程.\n");
    call_out("send", 1, this_player());
    return 1;
  }
  if (this_player()->query("fail") == 3)
    return notify_fail("苏星河摇了摇头，说道：“机会不会是永恒的，下一个id再来试试吧”\n");

  command("smile");
  command("nod");
  command("say 可是有话在先，阁下只有三次机会，并且棋局内涵凶险甚至会有性命之虞，阁下可要想好了啊？\n");
  command("say 如果阁下真的有此信心，就落子吧。记住只有三次机会哦？\n");

  this_player()->set_temp("test", 1);
  return 1;

}

void send() {

  message_vision("$n小心翼翼的坐到石几前的石凳上，$N对$n叮嘱说道：“师弟坐稳了啊，今天刚换的阀门力道可不小，注意。。。走!\n\n",
    this_object(), this_player());
  message_vision("苏星河伸手不知在棋盘的什么地方按了一下，只见从$N的座位底下冒出了一股浓浓白烟\n"
    "然后飕。。。。的一声，$N冲天而起，画着一条完美的轨道向着山壁上的楼阁投去,不见了\n\n\n", this_player());
  tell_object(this_player(), "你觉得自己耳旁生风，好象正在展翅翱翔，不禁高唱道：
“i believe i can fly......”，突然你觉得眼前好象有个什么东西黑糊糊的。。。。一块木墙。。。faint\n\n\n");
  this_player()->move("/u/lark/xiaoyao/langhuan");
  tell_room("/u/lark/xiaoyao/langhuan", "一个人影不知道从什么方向撞破了三寸厚的墙板，成扭曲状倒栽了进到房间里，默默不语，显得很文静的样子\n");

  this_player()->unconcious();
}

void attempt_apprentice(object me) {
  if (this_player()->query("mark/逍遥子")) {
    command("say 师弟天资聪颖不要取笑了，我送你去见师父老人家吧\n");
    call_out("send", 1, me);
    return;
  }
  if (this_player()->query("fail") == 3) {
    if (this_player()->query("class") == "xiaoyao") {
      command("nod");
      command("sigh");
      command("say 你也怪不容易的，以后就指点你几招吧。\n");
      return;
      command("recruit " + me->query("id"));
    }
  }

  command("hmm");
  command("say 没工夫，对不住了.");
}
