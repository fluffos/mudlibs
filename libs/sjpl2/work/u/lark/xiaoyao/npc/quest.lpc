#include "quest.h"

void doquest(object me) {
  int exp;
  int i, x;
  mapping qu;
  x = random(sizeof(quest));

  exp = (int)me->query("combat_exp");



  if (exp > 100000) {
    write("檀香子笑了笑说：“热爱劳动当然是美德，但是你现在好象不适合再干这些低档次的活了，fight npc如何？”\n");
    return;
  }




  if (!me->query_temp("finished")) {

    message_vision("檀香子微微抬了抬眼皮，看看$N\n", me);
    message_vision("檀香子对$N说道: “交代给你的完成了么?”\n", me);
    return;
  }

  qu = quest[x];
  if (me->query("combat_exp") < qu["exp_required"]) {
    message_vision("$N说道：“有没有要帮忙的？”", me);
    message_vision("檀香子想了想：“本来有件事情，但是我想你做不来。所以还是算了”\n", me);
    return;
  }

  message_vision("$N说道：“今天有没有需要干的？”\n", me);
  message_vision("檀香子对$N点点头, 正好缺人手呢。\n", me);
  me->set_temp("finished", 0);
  me->set_temp("xiaoyao/quest", x);
  me->set_temp(qu["temp"], 1);
  tell_object(me, "「你去把" + qu["name"] + "」\n");
  return;
}
