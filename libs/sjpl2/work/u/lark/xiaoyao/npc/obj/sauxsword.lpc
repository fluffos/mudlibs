// yinsword.c

#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create() {
  set_name(WHT "落雪" NOR, ({ "saux" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "三尺的长剑，是韩江雪的佩剑\n");
    set("value", 5000);
    set("material", "stell");
  }

  init_sword(40);
  set("weapon_prop/personality", 1);
  setup();
}
