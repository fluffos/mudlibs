// waterskin.c

inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name("牛奶", ({ "milk" }));
  set_weight(700);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一桶装满鲜奶的木桶。\n");
    set("unit", "桶");
    set("value", 20);
    set("max_liquid", 15);
  }

  // The liquid contained in the container is independent, we set a copy
  // in each cloned copy.
  set("liquid", ([
    "type": "water",
    "name": "鲜奶",
    "remaining": 15,
    "drunk_apply": 6,
  ]));
}
