// boy.c
#include <ansi.h>
inherit NPC;

void create() {
  set_name("小宝宝", ({ "boy" }));
  set("title", MAG "淘气" NOR);
  set("gender", "男性");
  set("age", 9);
  set("str", 10);
  set("cor", 14);
  set("cps", 11);
  set("per", 30);
  set("int", 21);


  set("long", "一个天真的小宝宝\n");

  set("combat_exp", 100);

  set("chat_chance", 10);
  set("chat_msg", ({
    "小宝宝说：“美美，我把花花给你带上吧，好漂亮的哦。”\n",
    "小宝宝毛手毛脚的给小美美带上了花，赞叹道：“好美哦！”\n",
    "小宝宝偷偷的在小美美脸颊上香了一下：“美美，以后作我老婆好不好？”\n",
    "小宝宝笑嘻嘻的说：“好啊好啊，那宝宝也象那个小哥哥每天送花给你好不好？”\n",
  }));

  set_skill("unarmed", 10);
  set_skill("parry", 10);
  set_skill("dodge", 10);
  set_skill("sword", 10);
  set_skill("force", 10);
  set_skill("literate", 10);


  setup();
  carry_object("/obj/cloth")->wear();
}

void init() {

  tell_object(this_player(), MAG "小宝宝从花丛中采下一朵刚刚展开的丁香花\n" NOR);
}
