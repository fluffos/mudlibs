// girl.c
#include <ansi.h>
inherit NPC;

void create() {
  set_name("小美美", ({ "girl" }));
  set("title", MAG "可爱" NOR);
  set("gender", "女性");
  set("age", 6);
  set("str", 10);
  set("cor", 10);
  set("cps", 11);
  set("per", 30);
  set("int", 21);



  set("long", "一个漂亮的小妹妹\n");

  set("combat_exp", 100);

  set("chat_chance", 10);
  set("chat_msg", ({
    "小美美点了点头，脸上露出了一个可爱的酒窝。\n"
    "小美美说：“骗人，不理你啦。哼”\n",
    "小美美脸上微微的红：“讨厌死了啦。以后我也要象巧巧姐姐一样美。嘻嘻”\n",
    "小美美对着小宝宝可爱的笑，“谁信啦，嘻嘻。”\n"

  }));

  set_skill("unarmed", 10);
  set_skill("parry", 10);
  set_skill("dodge", 10);
  set_skill("sword", 10);
  set_skill("force", 10);
  set_skill("literate", 10);


  setup();
  carry_object("/obj/cloth")->wear();
}
