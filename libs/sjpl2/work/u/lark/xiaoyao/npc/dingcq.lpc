#include <ansi.h>
#include <combat.h>
inherit NPC;
void perform_more(object who);
int custom();
void create() {
  set_name("丁春秋", ({ "ding chunqiu", "ding" }));
  set("gender", "男性");
  set("age", 70);
  set("combat_exp", (random(90) * random(10) + 1) * 100000);
  set("title", "须发戟张");
  set("str", 100);
  set("cor", 50);
  set("env/wimpy", 10);
  set("potential", 10);
  set("NKreward_NPC", 1);
  set("attitude", "heroism");
  set("gin", random(500) + 300);
  set("kee", random(500) + 300);
  set("sen", random(500) + 300);
  set("max_force", 1000);
  set("force", 2000);
  set("force_factor", 100);
  set("atman", 500);
  set("mana", 600);
  set("no_shown", 1);
  set("last_load_time", uptime());
  /*
        set("chat_chance", 50);
        set("chat_msg", ({
		(: random_move :),
		(: custom :)	
        }) );
*/
  set_skill("force", random(100) + 200);
  set_skill("unarmed", random(100) + 200);
  set_skill("parry", random(100) + 200);
  set_skill("dodge", random(100) + 200);
  set_skill("move", random(100) + 200);
  set_skill("literate", random(100) + 200);
  set_skill("zhanyidie", random(100) + 200);
  set_temp("apply/iron-cloth", random(100) + 100);
  set_temp("apply/damage", random(100) + 50);
  set_temp("apply/armor", random(30) + 20);
  set("id_type", 2);
  set_skill("wave_steps", random(100) + 150);
  set_skill("ymei_strike", random(100) + 150);
  map_skill("unarmed", "ymei_strike");
  map_skill("dodge", "wave_steps");

  set("perform_msg", "$N使出逍遥折梅手的绝招“花落知多少”，向$n攻来！");

  set("chat_chance_combat", 20);
  set("chat_msg_combat", ({
    (: perform_more(this_object()) :),
  }));

  setup();
  carry_object("/obj/cloth/belt")->wear();
  carry_object("/obj/cloth/jinzhuang")->wear();
}


void perform_more(object who) {
  int i;
  string msg;
  object *enemy;
  seteuid(getuid());
  who = this_object();
  enemy = who->query_enemy();
  msg = HIR + who->query("perform_msg") + "\n" NOR;
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      who->set_temp("apply/attack", 10);
      COMBAT_D->do_attack(who, enemy[i], who->query_temp("weapon"), TYPE_REGULAR, msg);
      who->set_temp("apply/attack", -10);
    }
  }
  return;
}
int custom() {
  this_object()->set("food", 100);
  this_object()->set("water", 100);
  return 1;
}

int heal_up() {
  object who = this_object();
  if (!who->is_fighting() && (uptime() - (int)who->query("last_load_time")) > 1000) {
    call_out("leave", 1);
    return 1;
  }
  return ::heal_up() + 1;
}

void leave() {
  string loadname = base_name(this_object());
  object loadplace;
  object frushob;
  message("vision", name() + "急急忙忙地离开了。\n" NOR, environment(), this_object());
  if (random(90) > 40) {
    frushob = new(loadname);
    loadplace = environment();
    message("vision", frushob->name() + "走了过来。\n" NOR, environment(), this_object());
    frushob->move(loadplace);
  }
  destruct(this_object());
}
