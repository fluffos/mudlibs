// guotai.c
#include <ansi.h>
inherit NPC;
inherit F_VENDOR;
void greet(object ob);
string give();
int xiaoyao();
void create() {
  set_name("巧巧", ({ "qiaoqiao" }));
  set("attitude", "friendly");
  set("gender", "女性");
  set("age", 19);
  set("long", "一个俏丽不可方物的女孩子,清新健康。却呆呆不知在想些什么。 \n");
  set("str", 15);
  set("per", 30);
  set("cps", 29);
  set("int", 20);

  set("max_kee", 300);
  set("kee", 300);
  set("food", 400);
  set("water", 400);
  set("chat_chance", 3);
  set("chat_msg", ({
    "巧巧轻声说道：“他好久不来了。。。。不知道出了什么事情？”\n",
    "巧巧轻声的叹了口气。\n",
  }));
  set("combat_exp", 2000);
  set_skill("dodge", 30);
  set_skill("unarmed", 30);

  set("inquiry", ([
    "紫丁香": "这是刚从紫薇平原采来的，好新鲜的\n",
    "韩江雪": (: give :),
    "他": (: give :),
    "紫薇平原": "紫薇平原在城南是个好美的地方，到处开满了紫丁香花\n"
    "我的花都是从那里采来得。。。。。我也是在那里\n"
    "认识他的。。。。。。。\n",
    "村子": (: xiaoyao :),


  ]));

  set("vendor_goods", ([
    "/u/lark/xiaoyao/obj/moli": 40,
    "/u/lark/xiaoyao/obj/kangnaixin": 40,
    "/u/lark/xiaoyao/obj/dingx": 100,
    "/u/lark/xiaoyao/obj/rose": 40,

  ]));






  setup();
  carry_object("/obj/cloth")->wear();
  //add_money("gold", 1);
}

void init() {
  object ob;

  ::init();
  add_action("do_vendor_list", "list");
  if (interactive(ob = this_player())
    && !is_fighting()) {
    call_out("greet", 1, ob);
  }
}

void greet(object ob) {
  if (!ob || environment(ob) != environment()) return;
  message_vision(
    "巧巧对着$N一个可爱的笑容：“您来朵花么？刚刚才采来的紫丁香,好美的哦”\n"
    , ob);
  return;
}

string give() {
  command("sigh");
  return "也许是命运的安排吧，要不然怎么会那么巧？我在平原上迷了路，\n"
    "无意中走到了一个无名的村子，也就碰到了他，他把我送了回来\n"
    "从此每天都到我这里来买花，然后。。。。再送给我。。。blush\n";
}

int xiaoyao() {
  object ob;

  if (this_player()->query("per") > 20 || this_player()->query_temp("ask")) {
    command("?");
    command("say 你要去那里么？\n");
    command("hmm");
    command("say 本来他不让我随便告诉别人那个村子的方位的。\n");

    command("say 不过看样子你也不象个坏人\n");
    tell_object(this_player(), "巧巧在你耳边轻声说：“从紫薇山口进到平原上然后向北5里，向东南2里，"
      "再向东北1里,就能到了\n"
      "你可不能告诉别人哦\n");
    command("hmm");
    command("say 还想求你件事情，帮我把这朵丁香花带给他好么？\n");
    ob = new("/u/lark/xiaoyao/obj/dingx");
    ob->move(this_player());
    this_player()->set_temp("nina", 1);
    command("thank");
    return 1;
  } else {
    command("hmm");
    command("sorry" + this_player()->query("id"));
    command("say 我忘了具体位置了\n");
    command("xixi");
    return 1;
  }
}

int accept_object(object who, object ob) {
  if (ob->query("name") == "紫丁香") {
    command("blush");
    command("thank");
    command("xixi");
    command("say 真想他呀，要不是他说不能随便到哪个村子去找他。。。\n");
    command("sigh");
    who->set_temp("ask", 1);
    return 1;
  } else return 0;
}
