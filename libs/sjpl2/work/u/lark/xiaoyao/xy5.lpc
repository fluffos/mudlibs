//bingqi.c
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "林子");
  set("long", @LONG
这里是一片茂密的红杉林，树木高大而径直，看来都是建筑的好
材料。
LONG
  );
  set("exites", ([
    "west": __DIR__ "xy3",
  ]));

  setup();
}

void init() {
  if (this_player()->query_temp("wood"))
    add_action("do_hammer", "cut");
}

int do_hammer(string arg) {
  object ob;
  if (this_player()->query_temp("over"))
    return notify_fail("别假积极了。\n");

  if (!arg)
    return notify_fail("要伐木么？(cut wood)\n");
  if (this_player()->query_temp("busy"))
    return notify_fail(RED "一个字: 急!\n" NOR);
  this_player()->set_temp("busy", 1);
  if (this_player()->query_temp("num") == this_player()->query_temp("wood")) {
    write(YEL "你擦了擦额头的汗水，该收工了！\n" NOR);
    message_vision("$N高喊了一声：红杉倒喽。。。一棵巨大的衫木应声倒下!\n", this_player());
    ob = new(__DIR__ "obj/wood");
    ob->move(this_object());
    this_player()->delete_temp("wood");
    this_player()->delete_temp("num");
    this_player()->set_temp("okw", 1);
    this_player()->delete_temp("busy");
  }
  message_vision("$N从腰间掏出一把斧头，轮圆了往树身上砍去\n", this_player());
  write(BLU "看着渐渐深入的开口，你知道事物只有不停的努力才能达到贯通\n" NOR);
  remove_call_out("improve");
  call_out("improve", 1, this_player());
  this_player()->start_busy(1);

  return 1;
}

void improve(object who) {

  object ob;

  who->improve_skill("sword", random((int)who->query("int")));
  who->add("sen", -(35 - (int)who->query_skill("parry", 1) / 5));
  who->add("gin", -(35 - (int)who->query_skill("parry", 1) / 5));

  who->add_temp("num", 1);
  who->set_temp("busy", 0);
}
