//dian.c

inherit ROOM;

void create() {
  set("short", "瓦房");
  set("long", @LONG
一间宽敞的瓦房，房间干净整洁，门口一个青布幌子(sign)在
风中摇摆。
LONG);
  set("item_desc", ([
    "sign":
    @LONG
    疗治外伤，指到病除。兼售密制家传鸡汤。
LONG
  ]));
  set("objects", ([
    __DIR__ "npc/ren": 1
  ]));
  set("exits", ([
    "north": __DIR__ "town2",
  ]));
  setup();
}
