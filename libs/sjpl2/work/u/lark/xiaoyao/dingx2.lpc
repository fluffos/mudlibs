// dingx2.c
#include <ansi.h>
inherit ROOM;

create() {
  set("short", MAG "紫薇平原" NOR);
  set("long", @LONG
漫步在如毯的花丛中，呼吸着沁人肺腑的香，感受这这静谧天地间或有的温柔，雾霭流动
细雨初降，花瓣上的露珠透着眩目的光，让你浑然忘物，渐渐迷失了自我和世界的存在。
LONG);
  set("exits", ([
    "north": __DIR__ "dingx2",
    "east": __DIR__ "dingx2",
    "south": __DIR__ "dingx2",
    "northeast": __DIR__ "dingx2",
    "southeast": __DIR__ "dingx2",
    "west": __DIR__ "dingx2",
    "northwest": __DIR__ "dingx2",
    "southwest": __DIR__ "dingx2",
  ]));

  setup();
}

void init() {
  object who;
  who = this_player();
  if (who->query_temp("nt") == 5 && who->query_temp("set") == 2 && who->query_temp("net") == 1) {
    if (who->query("class") == "xiaoyao" || who->query_temp("nina") || random(who->query("kar")) > 15) {
      who->move(__DIR__ "road");
      who->delete_temp("net");
      who->delete_temp("set");
      who->delete_temp("nt");
    } else {
      write(MAG "远方的山峦似远似近，可好象是永远无法得到的爱情那样不可企及\n" NOR);
    }
  }

}


int valid_leave(object who, string exit) {
  if (exit == "north") {
    who->add_temp("nt", 1);

  }

  if (exit == "northeast") {
    who->add_temp("net", 1);

  }

  if (exit == "southeast") {
    who->add_temp("set", 1);

  }
  return 1;
}
