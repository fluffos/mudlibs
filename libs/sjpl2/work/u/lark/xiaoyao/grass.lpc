//road.c
#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "缥缈山麓");
  set("long", @LONG
这里是飘渺峰的脚下，山势平缓阳光从山峰的缝隙中透射过来，远远近近的
丘陵，在柔和的光影中生息，葛草叶子和着丁香在风中繁芜，
前面好象是一片村落，笼罩在弥漫的蒸汽般的光芒中。山坡
上几只绵羊正在安静的咀嚼着嫩嫩的青草。
LONG
  );
  set("exits", ([
    "northwest": __DIR__ "road1",
    "westdown": __DIR__ "road",
  ]));
  set("objects", ([
    __DIR__ "npc/sheep": 4,
  ]));
  set("outdoors", "xiaoyao");
  setup();
}

void init() {
  object *ob;
  int i, n;
  add_action("do_cut", "cut");
}

int do_cut(string arg) {
  int n;
  object ob;
  n = random(5) + 5;
  if (this_player()->query_temp("xiaoyao/quest") != 13)
    return notify_fail("什么？\n");
  if (this_player()->query_temp("xiaoyao/over"))
    return notify_fail("别假积极了。\n");
  if (!arg)
    return notify_fail("要割草么？(cut grass)\n");
  if (this_player()->query_temp("xiaoyao/busy"))
    return notify_fail(RED "一个字: 急!\n" NOR);
  if (this_player()->query("sen") < 40 || this_player()->query("gin") < 40)
    return notify_fail(RED "你够累的了，休息一下吧!\n" NOR);
  this_player()->set_temp("xiaoyao/busy", 1);
  if (this_player()->query_temp("xiaoyao/num") >= n) {
    write(YEL "你擦了擦额头的汗水，该收工了！\n" NOR);
    message_vision("$N擦了擦额头的汗水，收拾起一大捆嫩嫩的青草放到背后的竹筐里。收工了!\n", this_player());
    ob = new(__DIR__ "obj/zhucao");
    ob->move(this_player());
    this_player()->delete_temp("xiaoyao/num");
    this_player()->set_temp("xiaoyao/okg", 1);
    this_player()->delete_temp("xiaoyao/busy");
    return 1;
  }
  message_vision("$N佝偻着身子，细心的割着地上的嫩草。\n", this_player());
  call_out("improve", 1, this_player());
  this_player()->start_busy(1);
  return 1;
}



void improve(object who) {

  if (!who) return;
  who->improve_skill("sword", random((int)who->query("int")));
  who->add("sen", -(30 - (int)who->query_skill("sword", 1) / 8));
  who->add("gin", -(30 - (int)who->query_skill("sword", 1) / 8));

  who->add_temp("xiaoyao/num", 1);
  who->set_temp("xiaoyao/busy", 0);
}
