#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "缥缈山麓");
  set("long", @LONG
这里是飘渺峰的脚下，山势平缓阳光从山峰的缝隙中透射过来，远远近近的
丘陵，在柔和的光影中生息，葛草叶子和着丁香在风中繁芜.
北面的小园子里传出阵阵花香好象是一个花圃。西面是一间
草舍。
LONG
  );
  set("exits", ([
    "west": __DIR__ "qdx",
    "north": __DIR__ "ding",
    "east": __DIR__ "xy3",
  ]));
  set("objects", ([
    __DIR__ "npc/child": 2,
  ]));
  setup();
}
