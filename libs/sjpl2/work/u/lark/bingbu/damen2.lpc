inherit ROOM;

void create() {
  set("short", "二门");
  set("long", @LONG
这里是兵部府的二门,它将外院和内院分开,在往里就是尚书
府的大堂了. 那里是路大人办公的地方.只有公务人员才能进入.
闲杂人等一律禁止入内.
LONG
  );
  set("exits", ([
    "west": __DIR__ "damen",
    "east": __DIR__ "yardm",
    "south": __DIR__ "yards",
    "north": __DIR__ "yardn",
  ]));
  set("objects", ([
    __DIR__ "npc/guarder": 2,
    //     __DIR__"npc/sun":1,
  ]));
  set("outdoors", "changan");
  setup();
}

int valid_leave(object who, string exit) {
  int exp;
  object huwei;
  string title;
  title = who->query("title");
  exp = (int)who->query("relation_exp") * 10 + (int)who->query("combat_exp");
  if (exit != "east" || exit != "south") return 1;
  if (who->query_temp("weapon")->id() == "jia") return 1;
  if (who->query("wuzy")) {
    tell_object(who, title + "恭喜恭喜请进请进！");
    return 1;
  }

  if (!present("huwei", this_object()) && !present("sun tongling", this_object())) return 1;

  if (who->query("class") == "official") {
    if (exp > 1200000) {
      message_vision("孙俊微微一抱拳，对着$n恭声说道：“" + title + "大人请进。”\n",
        who);
      return 1;
    } else {
      if (who->query("id_type") == 4) return 1;
      message_vision("孙俊微微摇了摇头，说道：“兵部乃军机重地，普通官员如无特许不得入内。”。\n",
        who);
      return 0;
    }
  }
  return notify_fail("铁甲虎卫不耐烦的挥了挥手，这里是尚书府不要乱闯\n");
}
