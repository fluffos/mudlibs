//sleeproom.c

inherit ROOM;

void create() {
  set("short", "休息室");
  set("long", @LONG
这里是兵部官员的休息室可以让他们在劳累的工作后得到疲劳缓
解，这里并排摆着几张床，看上去很舒适的样子。干了这么长时
间倒下来放松一下倒也不错。
LONG
  );
  set("exits", ([
    "west": __DIR__ "yardn",
  ]));
  set("sleep_room", 1);
  set("no_clean_up", 1);
  set("no_fight", 1);
  set("no_steal", 1);
  set("no_magic", 1);
  set("NONPC", 1);
  setup();
}
