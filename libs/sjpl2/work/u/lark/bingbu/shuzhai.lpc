string lookdesk(object me) {
  if (query("nopaper")) return ("一张上等的红木书桌.\n");
  else return ("一张上等的红木书桌(desk)上放着几张写满文字的纸(paper)\n");
}

string lookshelf(object me) {
  if (query("nobook")) return ("一副高大的红木书架(shelf)\n");
  else return ("一副高大的红木书架(shelf)上面排满了各种书籍(book)\n");
}

int do_get(string arg) {
  int n = 2;
  object ob;
  string from;
  if (sscanf(arg, "%s from %s", arg, from) == 2
    && arg == "papger"
    && from == "desk"
    && !query("nopaper")) {
    message_vision("$N从书桌上拿起了一张写满文字的纸片。\n", this_player());
    set("nopaper", 1);
    __DIR__ "obj/paper"->move(this_player());
    return 1;
  }
  if (sscanf(arg, "%s from %s", arg, from) == 2
    && arg == "book"
    && from == "shelf"
    && !query("nobook")) {
    message_vision("$N从书架上拿下一本书.\n", this_player());
    __DIR__ "obj/book(random(2))"->move(this_player());
    if (!(ob = present("shu", this_object())))
      set("nobook", 1);
    return 1;
  }
}

