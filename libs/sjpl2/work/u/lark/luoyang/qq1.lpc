inherit ROOM;

void create() {
  set("short", "清泉浴场");
  set("long", @LONG
一人多高，只容两人并行的檀香木走廊，廊中的两侧陈列着一些奇花异草。滚滚
热气从走廊的一头冒出，将檀木地板打得又湿又滑，你几乎要扶着栏杆才不会滑倒。
LONG
  );
  set("exits", ([
    "west": __DIR__ "boy",
    "east": __DIR__ "girl",
    "south": __DIR__ "qingquan",
  ]));
  set("no_fight", 1);
  set("no_magic", 1);
  set("no_study", 1);
  setup();
}
void init() {
  add_action("do_quit", "quit");
}
int do_quit() { return 1; }
int valid_leave(object me, string dir) {
  if (dir == "west" && me->query("gender") != "男性")
    return notify_fail("这是男人浴室，你冲进去作什么？\n");
  if (dir == "east" && me->query("gender") != "女性")
    return notify_fail("这是女人浴室，你冲进去作什么？\n");
  return 1;
}
