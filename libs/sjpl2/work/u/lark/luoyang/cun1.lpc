inherit ROOM;
void create() {
  set("short", "草房");
  set("long", @LONG
不大的一间草房，门口放着几件农具，炕头上几个新纳的鞋底
还插着针线，主人似乎上工去了.灶台上锅里冒出丝丝炊烟好象正
蒸着什么东西。
LONG);

  //set("item_desc", ([" *** " : " *** ", ]));

  set("exits",
    ([  //sizeof() == 4

    "east": __DIR__ "cunzi",  //goto luoyang
    ]));

  //        set("objects", 
  //        ([ //sizeof() == 1
  //                "/u/poor/gaibang/npc/farmer" : 3,
  //         ]));



  set("no_clean_up", 0);
  setup();
}

void init() {
  add_action("do_open", ({ "jie" }));
  add_action("do_get", ({ "get" }));


}

int do_open(string arg) {
  if (!arg) return notify_fail("打开什么?\n");
  if (arg != "锅") return notify_fail("打不开?\n");
  message_vision("$N轻轻的揭开了锅盖，里面放着许多馒头。似乎很香的样子\n", this_player());
  this_player()->set_temp("open", 1);
  return 1;
}

int do_get(string arg) {
  object ob;
  string from;
  if (!arg)
    return notify_fail("什么？");
  if (sscanf(arg, "%s from %s", arg, from) == 2
    && arg == "馒头"
    && from == "锅"
    && this_player()->query_temp("open")) {
    message_vision("$N蹑手蹑脚的从锅里拿出个馒头,又悄悄盖上了。。。。wa 偷东西吃？\n", this_player());
    ob = new(__DIR__ "obj/mantou");
    ob->move(this_player());
    this_player()->add("score", -50);
    this_player()->delete_temp("open");
    return 1;
  }
  return 1;
}
