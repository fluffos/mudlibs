#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "洛阳府");
  set("long", @LONG
这里是朝廷的洛阳管理衙门,洛阳上到税收,下到治安都由这里负责,
堂上站着几个衙役,一副威严的气氛,让人不禁肃穆.堂头高挂一块
额匾:

                                洛阳府

LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "south": __DIR__ "lyw1",
    "east": __DIR__ "dalao1",
    //  "" : __DIR__"shufang",
  ]));
  set("objects", ([
    //        __DIR__"npc/yayi1" : 3,
    __DIR__ "npc/yayi": 4,
    __DIR__ "npc/luoyang_guan": 1,

  ]));
  set("NONPC", 1);
  setup();

}
void init() {
  object ob;
  add_action("do_arrest", "arrest");
  add_action("do_loan", "loan");
  add_action("do_withdraw", "withdraw");
  add_action("do_balance", "balance");
  add_action("do_deposit", "deposit");
  add_action("do_convert", "convert");
  add_action("do_kill", "kill");
  if (this_player()->query("zuiren") && ob = present("阮吾能", this_object())) {
    message_vision("$N对着$n点了点头:算你识相,本大人网开一面给你刑期减半吧,来人呀!带他去大牢\n", ob, this_player());
    CHANNEL_D->do_channel(ob, "rumor", sprintf("%s到洛阳府投案自首了.\n", this_player()->name(1)));
    tell_room("/u/lark/luoyang/dalao", "衙役押进一个人来\n");
    this_player()->move("/u/lark/luoyang/dalao");
    this_player()->set("zuiren", 1);
    this_player()->set("beget", time());
    this_player()->set("time", (int)this_player()->query("time") / 2);
    return;
  }



}
int gethim(object target, object me) {
  message_vision("$N一句话不说，匆匆忙忙地离开了。\n", target);
  target->move(this_object());
  message_vision("$N被衙役押了进来。\n", target);
  if (me) {
    me->kill_ob(target);
    target->kill_ob(me);
  }
  return 1;
}
int do_loan(string arg) { return 1; }
int do_withdraw(string arg) { return 1; }
int do_deposit(string arg) { return 1; }
int do_convert(string arg) { return 1; }
int do_balance(string arg) { return 1; }
int do_kill(string arg) {

  object ob;
  if (!arg)
    return notify_fail("你要杀谁?\n");

  if ((string)this_player()->query("class") != "official" && (int)this_player()->query("id_type") != 5)
    return 1;
  if (ob = present("阮吾能", this_object())) {
    message_vision(RED "$N大喝一声:竟然感在大堂之上公然杀人!给我拿下了\n" NOR, ob);
    CHANNEL_D->do_channel(ob, "rumor", sprintf("%s因公然杀人被洛阳府收监了\n", this_player()->name(1)));

    this_player()->set("zuiren", 1);
    this_player()->set("time", 30);
    this_player()->set("beget", time());
    tell_room("/u/lark/luoyang/dalao", "突然从门外扔进一个人来,倒在地上昏迷不醒了\n");
    this_player()->move("/u/lark/luoyang/dalao");
    this_player()->unconcious();
    return 1;
  }
  return 1;
}


int do_arrest(string arg) {
  int i;
  object me, target, ob;
  int exp, stra, leader, factor;
  object *user;
  if (!arg)
    return notify_fail("你要下令缉拿谁？\n");
  me = this_player();
  if ((string)me->query("class") != "official" && (int)me->query("id_type") != 5)
    return notify_fail("你不是刑部的官员不能捉拿！\n");
  if (!present("yayi", this_object()))
    return notify_fail("现在人手不够,不能捉拿\n");

  if (!present("ruan wuneng", this_object()))
    return notify_fail("大人不在,一会再来吧\n");

  if ((int)me->query("sen") < 50)
    return notify_fail("你的心神不够！\n");
  me->add("sen", -50);
  if ((string)me->query("title") != RED "洛阳府神捕" NOR)
    return notify_fail("你的职务还不够使唤别人,要抓自己抓去!\n");
  user = users();
  for (i = 0; i < sizeof(user); i++) {
    if (user[i]->query("id") == arg) target = user[i];
    else continue;
  }
  if (!target) return notify_fail("找不到你想要的疑犯！\n");

  if (!objectp(target = find_living(arg)))
    return notify_fail("找不到你想要的疑犯！\n");
  if (interactive(target))
    return notify_fail("找不到你想要的疑犯！\n");
  if (target->query("no_arrest"))
    return notify_fail("找不到你想要的疑犯！\n");
  message_vision("$N大声下令道：来人那．．把$n给我拿来！！\n", me, target);
  exp = (int)target->query("combat_exp");
  stra = (int)me->query_skill("officialism", 1);
  leader = (int)me->query_skill("leadership", 1);
  factor = stra * stra * leader * leader;
  factor = (factor + ((int)me->query("combat_exp")) - 2000) / 1000;
  if (random(factor) <= exp)
    return notify_fail("衙役回报到" + target->query("name") + "点子太硬跑掉了.\n");
  call_out("gethim", 5, target, me);
  return 1;
}
