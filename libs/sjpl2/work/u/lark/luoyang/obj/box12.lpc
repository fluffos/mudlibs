// bag.c

inherit ITEM;

void create() {
  set_name("十二号衣箱", ({ "box12" }));
  set_weight(500);
  set("no_get", 1);
  set_max_encumbrance(10000000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "你洗澡的时候可以把杂物放在里面。\n");
    set("value", 100);
  }
}

int is_container() { return 1; }

void init() {
  add_action("do_get", "get");
  add_action("do_put", "put");
}

int do_get() {
  object me = this_player();
  if (!present("yaoshi", this_player())) {
    write("你没有钥匙\n");
    return 1;
  }
  if (this_player()->query("num") != 12) {
    write("这不是你的衣箱\n");
    return 1;
  }
  //        message_vision("$N用钥匙打开了衣箱\n",me);
  return 0;
}

int do_put() {
  object me = this_player();
  if (!present("yaoshi", this_player())) {
    write("你没有钥匙\n");
    return 1;
  }
  if (this_player()->query("num") != 12) {
    write("这不是你的衣箱\n");
    return 1;
  }
  //        message_vision("$N把什么东西放了进衣箱里\n",me);
  return 0;
}
