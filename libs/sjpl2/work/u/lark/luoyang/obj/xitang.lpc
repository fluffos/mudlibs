// dumpling.c
#include <ansi.h>
inherit ITEM;
inherit F_FOOD;

void create() {
  set_name(RED "喜糖" NOR, ({ "tang" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "看来有人结婚了\n");
    set("unit", "块");
    set("value", 15);
    set("food_remaining", 3);
    set("food_supply", 60);
  }
}
