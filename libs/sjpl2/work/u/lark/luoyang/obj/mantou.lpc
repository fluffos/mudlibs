// dumpling.c
#include <ansi.h>
inherit ITEM;
inherit F_FOOD;

void create() {
  set_name(HIW "馒头" NOR, ({ "mantou" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一各粗面馒头\n");
    set("unit", "个");
    set("value", 15);
    set("food_remaining", 30);
    set("food_supply", 80);
  }
}
