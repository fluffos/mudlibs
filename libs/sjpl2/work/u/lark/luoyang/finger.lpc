//room:lake.c
#include <ansi.h>
inherit ROOM;
void get(object who);
void create() {
  set("short", "千层纸");
  set("long", @LONG
几本厚厚的千层纸挂在院墙上,几个弟子站在那里不时用指头指点,
有几本已经被戳出了个深深的凹痕.
LONG
  );
  set("exits", ([
    "west": __DIR__ "jw2",
  ]));
  set("objects", ([
    __DIR__ "npc/dizi": 2,
  ]));
  set("outdoor", "luoyang");
  setup();
}

void init() {
  add_action("do_step", "chuo");
}

int do_step(string arg) {
  int skill;
  skill = this_player()->query_skill("finger", 1);
  if (!arg)
    return notify_fail("你要和谁练习指法？\n");
  if (arg != "千层纸")
    return notify_fail("和什么练\n");
  if (this_player()->query("sen") < 30 || this_player()->query("gin") < 30)
    return notify_fail("你太累了休息休息吧!\n");


  /*
  if(skill<100){
  message_vision("$N踩在了浮萍上，摇摇晃晃的走了几步。。象个秤砣一样沉底。。。不见了\n",this_player());
  this_player()->move("/u/lark/xiaoyao/water");
  return 1;
  }
*/
  message_vision("$N和木人比画了了几下.\n", this_player());
  if (skill < 50) {
    this_player()->improve_skill("finger", (int)this_player()->query("int"));
    this_player()->add("sen", -(30 - (int)this_player()->query_skill("finger", 1) / 5));
    this_player()->add("gin", -(30 - (int)this_player()->query_skill("finger", 1) / 5));
    return 1;
  }
  return 1;
}
