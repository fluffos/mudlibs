inherit NPC;
inherit F_VENDOR;

void greeting(object ob);
int do_ok();
void create() {
  set_name("甄甘静", ({ "zhen ganjing", "zhen" }));
  set("nickname", "浴场小姐");
  set("gender", "女性");
  set("age", 12 + random(6));
  set("long",
    "这是个年年龄不大的小姑娘，但宽松的道袍也遮不住她过早发育的身体。\n"
    "一脸聪明乖巧，满口伶牙俐齿。\n");
  set("attitude", "friendly");
  //        set("shen_type", 1);
  //        set("class", "taoist");
  // 龙四说道：if ( !((local[3])%2 )) kaoshi()
  set("vendor_goods", ([
    __DIR__ "obj/xiangzao": 50,
    __DIR__ "obj/maojin": 50,
    __DIR__ "obj/qishui": 50,


  ]));

  set("str", 20);
  set("int", 28);
  set("con", 24);
  set("dex", 20);

  set("max_gin", 150);
  set("max_kee", 100);
  //        set("neili", 150);
  //        set("max_neili", 150);

  set("combat_exp", 1000 + random(800));
  set("score", 1000);
  //        set("tea_count", 5);

  set_skill("force", 30);
  set_skill("dodge", 20);
  set_skill("unarmed", 15 + random(10));
  set_skill("parry", 20);
  set_temp("apply/attack", 10);
  set_temp("apply/defense", 15);
  set_temp("apply/damage", 3);


  //        create_family("武当派", 5, "弟子");

  set("inquiry", ([
    "洗澡": (: do_ok :),
    "bath": (: do_ok :),

  ]));
  set("box1", 0);
  set("box2", 0);
  set("box3", 0);
  set("box4", 0);
  set("box5", 0);
  set("box6", 0);
  set("box7", 0);
  set("box8", 0);
  set("box9", 0);
  set("box10", 0);
  set("box11", 0);
  set("box12", 0);
  set("box13", 0);
  set("box14", 0);
  set("box15", 0);


  set("box16", 0);
  set("box17", 0);
  set("box18", 0);
  set("box19", 0);
  set("box20", 0);





  setup();
  carry_object(__DIR__ "obj/greencloth")->wear();
  //        carry_object("/d/city/obj/necklace");
}
void init() {
  object ob;

  ::init();

  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);

  }
}

void greeting(object ob) {
  if (!ob || (environment(ob) != environment())) return;
  say("这位" + RANK_D->query_respect(ob)
    + "欢迎光临\n");
}

int accept_object(object who, object ob) {
  int som;
  object yaoshi;
  object obj = this_object();
  object me = this_player();
  som = ob->value();
  //        if(who->query("xizao")) return notify_fail("你可以进去洗澡了\n")
  //       if(this_object()->query("keren")>=20)
  //   return notify_fail("甄甘静抱歉的说：对不起了这位客官，已经客满了呀\n");

  if (som >= 1000) {
    if (who->query("xizao")) return notify_fail("你可以进去洗澡了\n");
    if (!obj->query("box1")) {
      obj->set("box1", 1);
      me->set("num", 1);
      yaoshi = new("/u/lark/luoyang/npc/obj/yaoshi1");
      yaoshi->set("num", 1);
      yaoshi->move(this_player());
    } else if (!obj->query("box2")) {
      obj->set("box2", 1);
      me->set("num", 2);
      yaoshi = new("/u/lark/luoyang/npc/obj/yaoshi2");
      yaoshi->set("num", 2);
      yaoshi->move(this_player());
    } else if (!obj->query("box3")) {
      obj->set("box3", 1);
      me->set("num", 3);
      yaoshi = new("/u/lark/luoyang/npc/obj/yaoshi3");
      yaoshi->set("num", 3);
      yaoshi->move(this_player());
    } else if (!obj->query("box4")) {
      obj->set("box4", 1);
      me->set("num", 4);
      yaoshi = new("/u/lark/luoyang/npc/obj/yaoshi4");
      yaoshi->set("num", 4);
      yaoshi->move(this_player());
    } else if (!obj->query("box5")) {
      obj->set("box5", 1);
      me->set("num", 5);
      yaoshi = new("/u/lark/luoyang/npc/obj/yaoshi5");
      yaoshi->set("num", 5);
      yaoshi->move(this_player());
    } else if (!obj->query("box6")) {
      obj->set("box6", 1);
      me->set("num", 6);
      yaoshi = new("/u/lark/luoyang/npc/obj/yaoshi6");
      yaoshi->set("num", 6);
      yaoshi->move(this_player());
    } else if (!obj->query("box7")) {
      obj->set("box7", 1);
      me->set("num", 7);
      yaoshi = new("/u/lark/luoyang/npc/obj/yaoshi7");
      yaoshi->set("num", 7);
      yaoshi->move(this_player());
    } else if (!obj->query("box8")) {
      obj->set("box8", 1);
      me->set("num", 8);
      yaoshi = new("/u/lark/luoyang/npc/obj/yaoshi8");
      yaoshi->set("num", 8);
      yaoshi->move(this_player());

    } else if (!obj->query("box9")) {
      obj->set("box9", 1);
      me->set("num", 9);
      yaoshi = new("/u/lark/luoyang/npc/obj/yaoshi9");
      yaoshi->set("num", 9);
      yaoshi->move(this_player());
    } else if (!obj->query("box10")) {
      obj->set("box10", 1);
      me->set("num", 10);
      yaoshi = new("/u/lark/luoyang/npc/obj/yaoshi10");
      yaoshi->set("num", 10);
      yaoshi->move(this_player());
    } else if (!obj->query("box11")) {
      obj->set("box11", 1);
      me->set("num", 11);
      yaoshi = new("/u/lark/luoyang/npc/obj/yaoshi11");
      yaoshi->set("num", 11);
      yaoshi->move(this_player());
    } else if (!obj->query("box12")) {
      obj->set("box12", 1);
      me->set("num", 12);
      yaoshi = new("/u/lark/luoyang/npc/obj/yaoshi12");
      yaoshi->set("num", 12);

      yaoshi->move(this_player());
    } else if (!obj->query("box13")) {
      obj->set("box13", 1);
      me->set("num", 13);
      yaoshi = new("/u/lark/luoyang/npc/obj/yaoshi13");
      yaoshi->set("num", 13);
      yaoshi->move(this_player());
    } else if (!obj->query("box14")) {
      obj->set("box14", 1);
      me->set("num", 14);
      yaoshi = new("/u/lark/luoyang/npc/obj/yaoshi14");
      yaoshi->set("num", 14);
      yaoshi->move(this_player());
    } else if (!obj->query("box15")) {
      obj->set("box15", 1);
      me->set("num", 15);
      yaoshi = new("/u/lark/luoyang/npc/obj/yaoshi15");
      yaoshi->set("num", 15);
      yaoshi->move(this_player());
    } else if (!obj->query("box16")) {
      obj->set("box16", 1);
      me->set("num", 16);
      yaoshi = new("/u/lark/luoyang/npc/obj/yaoshi16");

      yaoshi->set("num", 16);
      yaoshi->move(this_player());
    } else if (!obj->query("box17")) {
      obj->set("box17", 1);
      me->set("num", 17);
      yaoshi = new("/u/lark/luoyang/npc/obj/yaoshi17");
      yaoshi->set("num", 17);
      yaoshi->move(this_player());
    } else if (!obj->query("box18")) {
      obj->set("box18", 1);
      me->set("num", 18);
      yaoshi = new("/u/lark/luoyang/npc/obj/yaoshi18");
      yaoshi->set("num", 18);
      yaoshi->move(this_player());
    } else if (!obj->query("box19")) {
      obj->set("box19", 1);
      me->set("num", 19);
      yaoshi = new("/u/lark/luoyang/npc/obj/yaoshi19");
      yaoshi->set("num", 19);
      yaoshi->move(this_player());
    } else if (!obj->query("box20")) {
      obj->set("box20", 1);
      me->set("num", 20);
      yaoshi = new("/u/lark/luoyang/npc/obj/yaoshi20");
      yaoshi->set("num", 20);
      yaoshi->move(this_player());
    }

    else return notify_fail("甄甘静歉意道：这位客官真是不好意思，本店刚刚客满。\n");
    say("甄甘静微笑说道：多谢这位" + RANK_D->query_respect(me) + "，请到后面沐浴。\n");
    message_vision("甄甘静说完，递给$N一把钥匙。\n", this_player());

    command("smile");

    this_player()->set("xizao", 1);
    this_object()->add("keren", 1);
    this_player()->delete("qq/ok");


    return 1;
  }
  if (ob->query("id") == "yaoshi") {
    message_vision("$N把衣箱钥匙交还给了甄甘静\n", this_player());
    command("say 服务还满意么？希望下次光临\n");
    if (me->query("num") == 1) obj->set("box1", 0);
    else if (me->query("num") == 2) obj->set("box2", 0);

    else if (me->query("num") == 3) obj->set("box3", 0);
    else if (me->query("num") == 4) obj->set("box4", 0);
    else if (me->query("num") == 5) obj->set("box5", 0);
    else if (me->query("num") == 6) obj->set("box6", 0);
    else if (me->query("num") == 7) obj->set("box7", 0);
    else if (me->query("num") == 8) obj->set("box8", 0);
    else if (me->query("num") == 9) obj->set("box9", 0);
    else if (me->query("num") == 10) obj->set("box10", 0);
    else if (me->query("num") == 11) obj->set("box11", 0);
    else if (me->query("num") == 12) obj->set("box12", 0);
    else if (me->query("num") == 13) obj->set("box13", 0);
    else if (me->query("num") == 14) obj->set("box14", 0);
    else if (me->query("num") == 15) obj->set("box15", 0);
    else if (me->query("num") == 16) obj->set("box16", 0);
    else if (me->query("num") == 17) obj->set("box17", 0);
    else if (me->query("num") == 18) obj->set("box18", 0);
    else if (me->query("num") == 19) obj->set("box19", 0);
    else obj->set("box20", 0);

    this_player()->delete("xizao");
    this_player()->delete("num");
    this_object()->add("keren", -1);
    return 1;

  }

  return 0;
}

int do_ok() {
  if (this_object()->query("keren") >= 20)
    return notify_fail("甄甘静抱歉的说：对不起了这位客官，已经客满了呀\n");
  if (this_player()->query("xizao"))
    return notify_fail("这里不是bug,heihei\n");
  if (this_player()->query("qq/ok"))
    return notify_fail("这里不是bug,heihei\n");

  command("say 欢迎光临，一位10 silver\n");
  //  this_player()->set("qq/ok",1);

  return 1;
}
