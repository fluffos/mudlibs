inherit NPC;

void create() {
  set_name("小李", ({ "xiao li", "李寻欢", "li xunhuan" }));
  set("str", 50);
  set("gender", "男性");
  set("age", 45);
  set("long", "一个含笑喝酒的中年汉子，虽然喝得慢，看上去却很能喝。\n");
  set("combat_exp", 1000000);
  set("max_kee", 4000);
  set("attitude", "friendly");
  set_skill("unarmed", 260);
  set_skill("dodge", 260);
  set_skill("move", 200);
  set_temp("apply/attack", 300);
  set_temp("apply/defense", 300);

  setup();
  carry_object(__DIR__ "obj/cloth")->wear();
}
