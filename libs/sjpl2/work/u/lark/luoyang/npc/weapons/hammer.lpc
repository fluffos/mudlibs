//axe.c 斧的模版  wirtten by john darks

#include <ansi.h>
#include <weapon.h>

inherit HAMMER;

string query_autoload() { return 1 + ""; }  //autoload weapon

void create() {
  object me;
  string cname, cid, owner, ccolor, clong, cwield, cunwield, cwear, cremove;
  int weight, rigidity, damage, max_en, base;
  int weaponsnum;
  me = this_player();

  if (me->query("weapon1/type") == "hammer" && !me->query_temp("weapon1/loaded")) {
    cname = me->query("weapon1/name");   //武器名
    cid = me->query("weapon1/id");     //武器id
    ccolor = me->query("weapon1/color");   //武器颜色
    owner = me->query("weapon1/owner");   //武器主人id
    weight = me->query("weapon1/weight");   //缺省的重量
    rigidity = me->query("weapon1/rigidity");    //缺省的锋利度
    damage = me->query("weapon1/damage");         //缺省的杀伤力.缺省必须与 base_damage同
    max_en = me->query("weapon1/max_enchant");             //缺省的附加属性，可加五点 
    base = me->query("weapon1/base_damage");             //缺省的基本杀伤力
    clong = me->query("weapon1/desc");
    cwield = me->query("weapon1/wield_msg");
    cunwield = me->query("weapon1/unwield_msg");
    //cwear   = me->query("weapon1/wear_msg");
    //cremove = me->query("weapon1/remove_msg");
    me->set_temp("weapon1/loaded", 1);
    weaponsnum = 1;
  } else if (me->query("weapon2/type") == "hammer" && !me->query_temp("weapon2/loaded")) {
    cname = me->query("weapon2/name");
    cid = me->query("weapon2/id");
    ccolor = me->query("weapon2/color");
    owner = me->query("weapon2/owner");
    weight = me->query("weapon2/weight");
    rigidity = me->query("weapon2/rigidity");
    damage = me->query("weapon2/damage");
    max_en = me->query("weapon2/max_enchant");
    base = me->query("weapon2/base_damage");
    clong = me->query("weapon1/desc");
    cwield = me->query("weapon1/wield_msg");
    cunwield = me->query("weapon1/unwield_msg");
    me->set_temp("weapon2/loaded", 1);
    weaponsnum = 2;
  } else if (me->query("weapon3/type") == "hammer" && !me->query_temp("weapon3/loaded")) {
    cname = me->query("weapon3/name");
    cid = me->query("weapon3/id");
    ccolor = me->query("weapon3/color");
    owner = me->query("weapon3/owner");
    weight = me->query("weapon3/weight");
    rigidity = me->query("weapon3/rigidity");
    damage = me->query("weapon3/damage");
    max_en = me->query("weapon3/max_enchant");
    base = me->query("weapon3/base_damage");
    clong = me->query("weapon1/desc");
    cwield = me->query("weapon1/wield_msg");
    cunwield = me->query("weapon1/unwield_msg");
    me->set_temp("weapon3/loaded", 1);
    weaponsnum = 3;
  } else {
    cname = "垃圾";
    cid = "laji";
    ccolor = "$NOR$";
    owner = me->query("id");
    weight = 1;
    rigidity = 1;
    damage = 0;
    max_en = 0;
    base = 1;
    me->set("weapons/loaded", 1);
    weaponsnum = 4;
  }


  switch (ccolor) {
    case "$BLK$":
      set_name("[30m" + cname + "[2;37;0m", ({ cid, cname }));
      break;
    case "$RED$":
      set_name("[31m" + cname + "[2;37;0m", ({ cid, cname }));
      break;
    case "$GRN$":
      set_name("[32m" + cname + "[2;37;0m", ({ cid, cname }));
      break;
    case "$YEL$":
      set_name("[33m" + cname + "[2;37;0m", ({ cid, cname }));
      break;
    case "$BLU$":
      set_name("[34m" + cname + "[2;37;0m", ({ cid, cname }));
      break;
    case "$MAG$":
      set_name("[35m" + cname + "[2;37;0m", ({ cid, cname }));
      break;
    case "$CYN$":
      set_name("[36m" + cname + "[2;37;0m", ({ cid, cname }));
      break;
    case "$WHT$":
      set_name("[37m" + cname + "[2;37;0m", ({ cid, cname }));
      break;
    case "$HIR$":
      set_name("[1;31m" + cname + "[2;37;0m", ({ cid, cname }));
      break;
    case "$HIG$":
      set_name("[1;32m" + cname + "[2;37;0m", ({ cid, cname }));
      break;
    case "$HIY$":
      set_name("[1;33m" + cname + "[2;37;0m", ({ cid, cname }));
      break;
    case "$HIB$":
      set_name("[1;34m" + cname + "[2;37;0m", ({ cid, cname }));
      break;
    case "$HIM$":
      set_name("[1;35m" + cname + "[2;37;0m", ({ cid, cname }));
      break;
    case "$HIC$":
      set_name("[1;36m" + cname + "[2;37;0m", ({ cid, cname }));
      break;
    case "$HIW$":
      set_name("[1;37m" + cname + "[2;37;0m", ({ cid, cname }));
      break;
    case "$NOR$":
      set_name(cname, ({ cid, cname }));
    default:
      set_name(cname, ({ cid, cname }));
      break;
  }
  if (!clong) set("long", "这是一把铁锤，沉甸甸的。\n");
  else set("long", clong);
  set("owner", owner);
  set("unit", "把");
  set("no_get", 1);
  set("material", "iron");
  set("weaponsnum", weaponsnum);
  set("weight", weight);     //缺省的重量
  set("rigidity", rigidity);        //缺省的锋利度
  set("weapon_prop/damage", damage);         //缺省的杀伤力.缺省必须与 base_damage同
  set("max_enchant", max_en);                 //缺省的附加属性，可加五点 
  set("base_damage", base);                 //缺省的基本杀伤力

  if (!cwield) set("wield_msg", "$N拿出一把$n，试了试重量，然後握在手中。\n");
  else set("wield_msg", cwield);
  if (!cunwield) set("unequip_msg", "$N放下手中的$n。\n");
  else set("unequip_msg", cunwield);

  init_hammer(30);
  setup();
}

void init() {
  add_action("do_change", "cgweapon");
}

int do_change(string arg) {
  object obj;
  object me = this_player();
  string id, verb, replace;
  string tmp;
  if (!arg)
    return notify_fail("指令格式 : cgweapon <欲改的东西> <欲改的款项> <改变的内容>\n");
  if (sscanf(arg, "%s %s %s", id, verb, replace) != 3)
    return notify_fail("指令格式 : cgweapon <欲改的东西> <欲改的款项> <改变的内容>\n");
  if (!objectp(obj = present(id, me)))
    return notify_fail("你身上没有这样东西。\n");
  if (obj->query("owner") != me->query("id"))
    return notify_fail("这不是你私人的东西。\n");
  switch (verb) {
    case "desc":
      if (!CHINESE_D->check_chinese(replace)) return notify_fail("描述必须是中文。\n");
      me->set("weapon" + obj->query("weaponsmnum") + "/desc", replace + "\n");
      obj->set("long", replace + "\n");
      break;
    case "wield_msg":
      if (strsrch(replace, "$N") == -1 || strsrch(replace, "$n") == -1)
        return notify_fail("描述必须含有$N和$n。\n");
      tmp = replace_string(replace, "$N", "");
      tmp = replace_string(tmp, "$n", "");
      if (!CHINESE_D->check_chinese(tmp)) return notify_fail("描述必须是中文。\n");
      me->set("weapon" + obj->query("weaponsmnum") + "/wield_msg", replace + "\n");
      obj->set("wield_msg", replace + "\n");
      break;
    case "unwield_msg":
      if (strsrch(replace, "$N") == -1 || strsrch(replace, "$n") == -1)
        return notify_fail("描述必须含有$N和$n。\n");
      tmp = replace_string(replace, "$N", "");
      tmp = replace_string(tmp, "$n", "");
      if (!CHINESE_D->check_chinese(tmp)) return notify_fail("描述必须是中文。\n");
      me->set("weapon" + obj->query("weaponsmnum") + "/unwield_msg", replace + "\n");
      obj->set("unwield_msg", replace + "\n");
      break;
    default:
      return notify_fail("指令格式 : cgweapon <欲改的东西> <欲改的款项> <改变的内容>\n");

  }
  reload_object(obj);
  write("改变成功！\n");
  return 1;
}
