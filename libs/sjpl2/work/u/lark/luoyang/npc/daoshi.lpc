#include <ansi.h>
inherit NPC;

void create() {
  set_name("天道人", ({ "tian", "daoshi", "天道人" }));
  set("title", HIC "悠闲道士" NOR);
  set("str", 200);
  set("gender", "男性");
  set("age", 57);
  set("long", "一个喝得烂醉的老道士，脏兮兮的。\n");
  set("combat_exp", 3000000);
  set("max_kee", 5000);
  set("attitude", "friendly");
  set_skill("unarmed", 500);
  set_skill("dodge", 500);
  set_skill("move", 500);
  set_temp("apply/attack", 500);
  setup();
  carry_object(__DIR__ "obj/cloth")->wear();
}
