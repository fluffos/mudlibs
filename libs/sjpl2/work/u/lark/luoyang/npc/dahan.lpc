inherit NPC;
object offensive_target(object me);
void create() {
  int i, amun;
  string *order = ({ "张", "王", "李", "赵", "孙", "徐", "郑", "周", "吴",
    "蒋", "沈", "杨", "苗", "尹", "金", "魏", "陶", "俞", "柳", "朱" });
  string *orderr = ({ "阿发", "耀宗", "小明", "阿狗", "宏图", "小幅", "富贵", "才是" });

  set_name(order[random(20)] + orderr[random(8)], ({ "dahan", "大汉" }));
  set("title", "江湖大汉");
  set("long", "一个大口大口喝酒的豪客。\n");
  set("gender", "男性");
  set("age", 30 + random(10));
  set("combat_exp", 20000 + random(50000));
  set("str", 10 + random(10));
  set("cps", 10);
  set("int", 10);
  set("cor", 10);
  set("con", 10);
  set("spi", 20);
  set("per", 10);
  set("kar", 10);
  set("agi", 30);
  set("max_kee", 5000);
  set_skill("dodge", 200);
  set_skill("move", 200);
  set_skill("unarmed", 100);

  setup();
  carry_object(__DIR__ "obj/cloth")->wear();
}

object offensive_target(object me) {
  int sz;
  object *enemy;

  enemy = me->query_enemy();
  if (!enemy || !arrayp(enemy)) return 0;

  sz = sizeof(enemy);
  if (sz > 4) sz = 4;

  if (sz > 0) return enemy[random(sz)];
  else return 0;
}

void heart_beat() {
  object me = this_object();
  object target;
  if (me->is_fighting())
    target = offensive_target(me);          //有效对手
    if (userp(target)) {                     //是player
      if (target->query("comabt_exp") > me->query("combat_exp") * 4 / 5
        && target->query("comabt_exp") < me->query("combat_exp") * 8 / 5)  //设定玩家范围
        target->add("combat_exp", 1);   //这个函数每一秒执行一次,也就是每秒 add exp 1 .
    }                                  //这个npc 每秒只给 1 exp . no pot. 如果对手一多,玩家并不是
  //每秒得到 1 exp. *heihei
  //要让npc 可以fight. 去掉友好的态度
  return ::heart_beat();
}
