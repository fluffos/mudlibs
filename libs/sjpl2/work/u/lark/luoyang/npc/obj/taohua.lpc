// dingx.c
#include <ansi.h>
#include <armor.h>

inherit HEAD;

void create() {
  set_name(HIM "桃花" NOR, ({ "flower" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "桃花象征发达,花语为宏图大展\n");
    set("unit", "枝");
    set("value", 100);
    set("armor_prop/personality", 5);
  }
  set("wear_msg", "$N细心地把桃花别在鬓角\n");
  set("unequip_msg", "$N从发间取下桃花\n");
  setup();
}
