// dart.c
#include <ansi.h>
#include <weapon.h>
inherit THROWING;

void create() {
  set_name(BLU "似水" NOR, ({ "dart" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "象水一样，慢慢的沁透，慢慢的割断你的喉咙\n"
      "纤细的形状一点也不让人觉得脆弱，反而展现出惊人的透射立，刃身暗刻“厉”，证明是干将坊的产品\n");
    set("unit", "些");
    set("base_unit", "枝");
    set("base_weight", 40);
    set("value", 10000);
  }
  set_amount(1);
  init_throwing(50);
  setup();
}
