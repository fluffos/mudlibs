// sixhammer.c
#include <ansi.h>
#include <weapon.h>

inherit HAMMER;

void create() {
  set_name(HIY "撼天八棱锤" NOR, ({ "hammer" }));
  set_weight(15000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "圆浑的锤身凹了八条清晰的纹路，直径1尺三寸，看起来不轻，却摧毁力惊人手柄处暗刻“厉”，证明是干将坊的产品。\n");
    set("value", 70000);
    set("material", "steel");
    set("wield_msg", CYN "$N浑身肌肉纠结突起开声吐气“哈”的一声提起一把$n,\n" NOR
      CYN "掂了掂重量握在手重，气势宛若金刚降临\n" NOR);
    set("unwield_msg", CYN "$N放下手中的$n。\n" NOR);
  }

  init_hammer(50);
  setup();
}
