// shield.c
#include <ansi.h>
#include <armor.h>

inherit SHIELD;

void create() {
  set_name(CYN "混元盾" NOR, ({ "shield" }));
  set_weight(12000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("material", "steel");
    set("long", "圆形的盾面光滑密实，纯钢铸造显得异常结实,正面中心暗刻“厉”，证明是干将坊的产品\n");
    set("unit", "面");
    set("value", 50000);
    set("armor_prop/dodge", -20);
    set("armor_prop/armor", 150);
    set("armor_prop/defense", 50);
    set("wear_msg", CYN "$N从背后卸下一面$n,持在身前正好护住了周身要害\n" NOR);
    //                set("unequip_msg", CYN "$N\n"NOR);
  }
  setup();
}
