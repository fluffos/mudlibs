#include <ansi.h>
#include <weapon.h>

inherit STAFF;

void create() {
  set_name(HIY "鸾凤杖" NOR, ({ "staff" }));
  set_weight(80000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "条");
    set("long", "一条粹金钢杖，凸刻龙凤花纹栩栩如生，盘绕杖身直至杖头做戏珠状，杖顶暗刻“厉”，证明是干将坊的产品。\n");
    set("value", 1000);
    set("rigidity", 80);
    set("material", "steel");
    set("wield_msg", CYN "$N掳起袖子，执起一条$n,旋了一周，激起满地尘埃。\n" NOR);
    set("unwield_msg", CYN "$N放下手中的$n。\n" NOR);
  }

  init_staff(50);
  setup();
}
