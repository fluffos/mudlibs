// rope.c

#include <ansi.h>
#include <weapon.h>

inherit WHIP;

void create() {
  set_name(HIC "九连钢鞭" NOR, ({ "whip" }));
  set_weight(800);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "条");
    set("long", "钢索连环节节相扣，九环都是精钢锻造，第三环上暗刻“厉”，证明是干将坊的产品\n");
    set("value", 70000);
    set("material", "steel");
  }
  init_whip(20);

  set("wield_msg", CYN "$N从腰间一抹，刷拉抽出一条$n，宛若毒蛇般低垂下来.\n" NOR);
  set("unwield_msg", CYN "$N将手中的$n束在腰间。\n" NOR);

  setup();
}
