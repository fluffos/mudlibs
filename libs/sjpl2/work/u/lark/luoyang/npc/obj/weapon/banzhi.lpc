inherit RING;
void create() {
  set_name(HIB "泪" NOR, ({ "ring" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "上好的青田玉打造而成，好象情人了泪水凝铸，圆浑而光泽，\n"

      "散发着暖暖的光晕，暗刻“厉”应该是干将坊的产品.\n");



    set("value", 50000);
    set("rigidity", 50);
    set("material", "stone");
    set("wield_msg", "$N从怀中摸出一个$n小心翼翼的戴在手上。\n");
    set("unwield_msg", "$N将手上的$n藏入怀中。\n");
  }
  init_ring(50);
  setup();
}
