#include <ansi.h>

inherit NPC;
//inherit F_PAWNOWNER;
//inherit F_VENDOR;

void create() {
  set_name("舒不讳", ({ "shu buhui", "shu", "boss" }));
  set("gender", "男性");
  set("age", 39);
  set("title", "有钱");
  set("long",
    "可能是长期算计太甚的原因，一副尖嘴猴腮的样子。\n");
  set("combat_exp", 50000);
  set("attitude", "friendly");
  set("per", 1);
  set("no_arrest", 1);
  set_skill("unarmed", 200);
  set_skill("dodge", 200);
  setup();
  carry_object("/obj/cloth/changpao")->wear();
}
