inherit ROOM;
void create() {
  set("short", "洛阳西门");
  set("long", @LONG
青色的藤蔓蜿蜒攀满的城门的四周，充塞了墙上的缝隙，从城头
剑阁上破损的痕迹还依然能看到往日征战的痕迹，高大厚实的墙
身，坚硬沉重的城门还依稀能看到往昔故都的风采。旁边有一条
狭窄而陡峭的阶梯可以通向护城墙上的箭楼.
LONG
  );
  set("no_npc", 1);
  set("exits", ([ /* sizeof() == 4 */
    "west": __DIR__ "road10",
    //"east" : __DIR__"lyw2",
    //"up":__DIR__"upn",

  ]));
  set("objects", ([
    __DIR__ "npc/bing": 4,
    __DIR__ "npc/jiang": 1,
  ]));
  set("outdoors", "changan");
  setup();
}
int valid_leave(object me, string dir) {
  object *inv;
  object ob;
  int i;
  ob = present("bing", this_object());
  if (userp(me)) {



    if (dir == "south"
      //        && !random(10) 
      && ob = present("bing", this_object())) {
      inv = all_inventory(me);
      for (i = 0; i < sizeof(inv); i++) {
        if ((int)(inv[i]->query("weapon_prop")) && (int)(inv[i]->query("equipped")))
          return notify_fail(ob->name() + "向你喝道：不可手持兵器入城！\n");

      }
    }

    if (dir == "up" && ob = present("bing", this_object())) {
      inv = all_inventory(me);

      for (i = 0; i < sizeof(inv); i++) {
        if (((string)(inv[i]->name()) == "兵服")
          && (int)(inv[i]->query("equipped")))
          return 1;

      }

      if (me->query("class") == "official" && me->query("id_type") == 4) return 1;



      return notify_fail(ob->name() + "向你喝道：闲杂人等不可上登护城墙！\n");
    }

    if (dir == "south" &&
      (string)(NATURE_D->outdoor_room_description()) == "    " + "夜幕低垂，满天繁星。") {
      if (!me->query_temp("ok")) {
        message_vision("$N摇了摇头说：“ 洛阳城门已经关闭了，要想进城等明天早起吧”\n", ob);
        return 0;
      } else {
        message_vision("$N点了点头，低声说：快点进去。别磨磨蹭蹭的.\n", ob);
        me->delete_temp("ok");
        return 1;

      }
    }
    if (dir == "north" &&
      (string)(NATURE_D->outdoor_room_description()) == "    " + "夜幕低垂，满天繁星。") {
      if (!me->query_temp("ok")) {
        message_vision("$N摇了摇头说：“ 洛阳城门已经关闭了，要想出城等明天早起吧”\n", ob);
        return 0;
      } else {
        message_vision("$N点了点头，低声说：快点出去。别磨磨蹭蹭的.\n", ob);
        me->delete_temp("ok");
        return 1;

      }
    }
    return 1;
  } else
    return 1;
}
