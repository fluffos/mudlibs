//chufang.c

inherit ROOM;

void create() {
  set("short", "食堂");
  set("long", @LONG
这里是兵部的食堂，为在这里工作的兵部官员提供免费的饮
食,里面放着几十张食桌，屋里弥漫着诱人的香气不禁让人食欲
大动，你可一在这里吃饭（chifan)或者解渴(drink pot).
LONG
  );
  set("exits", ([
    "west": __DIR__ "yards",
  ]));
  set("objects", ([
    __DIR__ "obj/pot": 1,
  ]));
  setup();

}

void init() {
  add_action("do_chifan", "chifan");
}

int do_chifan(string arg) {
  object food;
  if (arg)
    return notify_fail("想吃饭？直接type chifan 就行了。\n");
  if (!this_player()->query("id_type") == 4)
    return notify_fail("这里只为兵部官员提供食物\n");
  food = new("/u/lark/libu/obj/rice");
  write("仆人不一会端上了一盘香喷喷的什锦炒饭\n");
  food->move(this_player());
  return 1;
}
