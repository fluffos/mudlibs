//damen2.c

inherit ROOM;

void create() {
  set("short", "二门");
  set("long", @LONG
这里是吏部尚书府的二门，是分割外院和内院的门户，再往里就是
尚书府的堂院除了尚书府的官员和受到特别容许的人，是不准入内的。
LONG
  );
  set("exits", ([
    "west": __DIR__ "qianyuan",
    "enter": __DIR__ "tangyuan",
  ]));
  set("objects", ([
    __DIR__ "npc/weishi": 2,
  ]));
  setup();
}

int valid_leave(object who, string exit) {
  int exp;
  object weishi;
  string title;
  title = who->query("title");
  exp = (int)who->query("relation_exp") * 10 + (int)who->query("life_exp");
  if (exit != "enter") return 1;
  if (who->query("wenzy")) {
    tell_object(who, title + "恭喜恭喜请进请进！");
    return 1;
  }
  if (who->query("job")) return 1;
  if (!weishi = present("guard", this_object())) return 1;
  weishi = present("weishi", this_object());
  if (who->query("class") == "official") {
    if (exp > 1200000) {
      message_vision("$N微微一抱拳，对着$n恭声说道：“" + title + "大人请进。”\n",
        weishi, who);
      return 1;
    } else {
      message_vision("$N微微点了点头，说道：“进去吧，不要乱走”。\n",
        weishi, who);
      return 1;
    }
  }


  return notify_fail("卫士不耐烦的挥了挥手，这里是尚书府不要乱闯\n");
}
