//zongguanfang.c

inherit ROOM;

void create() {
  set("short", "总管房");
  set("long", @LONG
这里是吏部尚书府的总管房，东面墙壁上挂着一幅字画，房中央
是一张长案，案上排放着文房四宝，堆落一些文件，靠着西面是
一幅书架，百宝格上摆着放着一些瓷器玉皿。
LONG
  );
  set("item_desc", ([
    "字画": @TEXT
东汉张骞的手笔山水，画意飘洒，笔墨卓然，乃是精品。
但是挂的好象略微有些歪斜。
TEXT,
    "瓷器玉皿": @TEXT
一看就知道是景德镇皇窑出产的极品供物，很难搞的到，不知是
怎么搞到的。有一撙“近光紫鱼瓶”十分扎眼，看来弥足珍贵，
因此被拂拭的光华亮泽.
TEXT,
    "文件": @TEXT
一些吏部内务的日常文件，不知道记载着些什么.
TEXT
  ]));
  set("exits", ([
    "south": __DIR__ "tangyuan",
  ]));
  set("objects", ([
    __DIR__ "npc/tian": 1,
  ]));
  setup();
}

void init() {
  add_action("do_push", "tui");
  add_action("do_quf", "get");
  add_action("do_get", "getdown");
}

int do_push(string arg) {
  object ob;
  if (!arg)
    return notify_fail("你要推什么？\n");
  if (arg != "近光紫鱼瓶")
    return notify_fail("推了推没有什么效果.\n");
  message_vision("$N走上前轻轻推了推“近光紫鱼瓶”,突然\n", this_player());
  tell_room(this_object(),
    "墙上的字画缓缓的移开了，出现了一个暗格,里面好象有一个薄册。\n"
  );
  if (ob = present("tian shiye", this_object())) {
    ob->set_leader(this_player());
    ob->kill_ob(this_player());
    message_vision("$N脸色慌张，怒声叫道：“你是何人，胆敢。。。如何知。。”\n",
      ob);

  }
  this_object()->set("ange", 1);
  return 1;
}

int do_quf(string arg) {
  object ob;
  string from;
  if (!arg) return notify_fail("拿什么?\n");
  if (sscanf(arg, "%s from %s", arg, from) == 2
    && arg == "文件"
    && from == "长案") {
    if (ob = present("tian shiye", this_object()) && living(ob))
      message_vision("$N瞥了你一眼，怒声说道：“你有没有规矩怎么能乱翻我的东西？给我放下！”。\n", ob);


    message_vision("$N从长案上拿起了一摞文件。\n", this_player());
    __DIR__ "obj/file"->move(this_player());
    return 1;
  } else return notify_fail("没什么可拿的\n");
}


int do_get(string arg) {
  object ob;
  string from;
  if (!arg) return notify_fail("拿什么?\n");
  if (sscanf(arg, "%s from %s", arg, from) == 2
    && arg == "薄册"
    && from == "暗格"
    && !query("nobook")
    && query("ange")) {
    if (ob = present("tian shiye", this_object()) && living(ob)) {
      ob->set_leader(this_player());
      ob->kill_ob(this_player());
      return notify_fail("田师爷纵身一跳拦在了你的面前。\n");
    }
    message_vision("$N从暗格中取出一个薄册.\n", this_player());
    __DIR__ "obj/boce"->move(this_player());

    set("nobook", 1);
    return 1;
  } else
    return notify_fail("没什么可拿的\n");
}

void reset() {
  object ob;
  set("ange", 0);
  set("nobook", 0);
  ob = new(__DIR__ "npc/tian");
  ob->move(this_object());
}

int valid_leave(object who, string exit) {
  object ob, ev;
  if (present("file", who) || present("boce", who)) {
    if (ob = present("tian shiye", this_object())) {
      message_vision("$N双手一拦，挡在你的面前，哪里走把东西给我放下.\n", ob);
      ob->set_leader(who);
      ob->kill_ob(who);
      who->set_temp("stealer");
      if ((int)who->query_skill("dodge") > (int)ob->query_skill("dodge")) {
        message_vision("$N坐脚斜踏，身形灵活，从$n身旁的空隙窜了出去.\n", who, ob);
        ev = find_object(__DIR__ "tangyuan");
        tell_room(ev, "有个人从总管房里惶惶张张的跑出来。\n");
        return 1;
      } else

        return notify_fail("张师爷拦在你的身前:来得容易去的难!\n");
    } else return 1;
  }
  return 1;
}
