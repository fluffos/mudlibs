//hall.c
#include <room.h>
inherit ROOM;

void create() {
  set("short", "吏部大堂");
  set("long", @LONG
这里就是吏部大堂了，是吏部尚书大人处理日常事务的所在，朝廷
官员的升迁贬降都在这里完成。堂台上放着一张宽大的红木书桌，
堂头高挂一块长匾“廉治清政”。右手有一道红木门却是禁闭的。
LONG
  );
  set("exits", ([
    "out": __DIR__ "tangyuan2",
    "south": __DIR__ "neitang",
  ]));
  set("objects", ([
    //	__DIR__"npc/zhang":1,
    __DIR__ "npc/libu_master": 1,
    __DIR__ "npc/shutong": 2,
  ]));
  set("item_desc", ([
    "红木门": @TEXT
一道坚固的红木门，可以通向内堂，平时都是紧紧的关闭的。
TEXT
  ]));
  create_door("south", "红木门", "north", DOOR_CLOSED);
  setup();
}
