//juzitang.c

inherit ROOM;

void create() {
  set("short", "举子堂");
  set("long", @LONG
再往里就是尚书府的举子堂了，这里是为赶考的举子们提供食宿
的场所，可以让举子们在这里安心复习等待高考的来临。红木院
门上贴着一张告示。
LONG
  );
  set("item_desc", ([
    "告示": @TEXT
这里为举子门提供食宿如果有意可以到门口王师爷那里去办理手
续(ask wang about room)。
TEXT
  ]));
  set("exits", ([
    "enter": __DIR__ "juzitang2",
    "south": __DIR__ "qianyuan",
  ]));
  set("objects", ([
    __DIR__ "npc/weishi": 2,
  ]));
  setup();

}

int valid_leave(object who, string exit) {
  object ob;
  if (exit != "enter") return 1;
  if (!present("guard", this_object())) return 1;
  if (ob = present("guard", this_object())) {
    if (who->query("bed")) return 1;
    return notify_fail("卫士不屑的瞥了你一眼，你没有交钱想白住呀？\n");
  }
}
