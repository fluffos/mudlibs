#include <ansi.h>
inherit ROOM;
void improve(object me);
void create() {
  set("short", "秘书房");
  set("long", @LONG
这里是尚书府的秘书房，房中接挨着放着不少书桌，这里是起草
文书和书写文件的所在，一些人正在埋头工作着。
LONG
  );
  set("exits", ([
    "north": __DIR__ "tangyuan2",
  ]));
  set("objects", ([
    __DIR__ "npc/yang": 1,
  ]));
  setup();
}

void init() {
  add_action("do_copy", "copy");
}

int do_copy(string arg) {
  int n;
  (int)n = 1000 / this_player()->query_skill("literate", 1);
  if (!arg || arg != "文件") return notify_fail("抄什么？\n");
  if (!this_player()->query("job"))
    return notify_fail("你没有在吏部申请工作.\n");
  if ((int)this_player()->query("gin") < 30 || (int)this_player()->query("sen") < 30)
    return notify_fail("你昏昏欲睡连笔都拿不住了。\n");
  tell_object(this_player(), "你坐在桌前开始抄写。。。写着写这你突然想：原来当官的就是这样糊弄人的呀.\n");
  if ((int)this_player()->query_skill("leadership", 1) < 50) {
    remove_call_out("improve");
    call_out("improve", n + 3, this_player());
  }
  this_player()->start_busy(n);
  this_player()->set("finish", 1);
  return 1;
}

void improve(object me) {
  write(WHT "你下笔如风,忙忙叨叨的总算是写完了.\n" NOR);
  me->improve_skill("leadership", random((int)me->query("int")));
  me->add("gin", -20);
  me->add("sen", -20);
  __DIR__ "obj/paper"->move(this_player());
}
