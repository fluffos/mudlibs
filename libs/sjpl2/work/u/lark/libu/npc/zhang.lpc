#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string summon_more(object who);

void create() {
  set_name("张宗胜", ({ "zhang zongsheng", "zhang", "master" }));
  set("long",
    "张宗胜是当朝吏部尚书，也是开国元勋之一。\n");
  set("nickname", YEL "运筹帷幄" NOR);
  set("attitude", "heroism");
  set("student_title", "官员");
  create_family("朝廷", 6, "官员");
  set("title", "吏部尚书");
  set("id_type", 3);
  set("vendetta_mark", "authority");
  set("str", 30);
  set("int", 30);
  set("cor", 30);
  set("spi", 30);
  set("agi", 30);
  set("max_kee", 1000);
  set("max_gin", 1000);
  set("max_sen", 1000);
  set("kee", 1000);
  set("gin", 1000);
  set("sen", 1000);
  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 20);
  set("score", 900000);
  set_temp("apply/defense", 50);
  set_temp("apply/move", 50);

  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: summon_more(this_object()) :),
    (: command, "escort" :),
  }));
  set("combat_exp", 3900000);
  set("relation_exp", 90000);
  set("life_exp", 50000);

  set_skill("force", 110);
  set_skill("parry", 80);
  set_skill("unarmed", 70);
  set_skill("dodge", 120);
  set_skill("bixueforce", 90);
  set_skill("move", 100);
  set_skill("literate", 250);
  set_skill("leadership", 250);
  set_skill("economics", 250);
  set_skill("officialism", 250);
  map_skill("literate", "economics");
  map_skill("force", "bixueforce");
  setup();

  carry_object(__DIR__ "obj/guanfu")->wear();
}




void init() {
  object where;
  where = find_object("/u/lark/libu/neitang");
  if (this_player()->query_temp("stealer")) {
    kill_ob(this_player());
    command("say 到尚书府来找茬？\n");
    return;
  }
  if (this_player()->query_temp("come") && environment()->query("short") == "吏部大堂" && living(this_object())) {
    message_vision("$N微微的对着$n点了点头，低声说道：“随我来,随我来....”\n", this_object(), this_player());
    message_vision("$N带着$n鬼鬼祟祟的走进了内堂\n", this_object(), this_player());

    this_player()->move(where);
    this_object()->move(where);
  }
}


void attempt_apprentice(object me) {
  object where;
  where = find_object(__DIR__ "hall");
  if (this_object()->is_fighting())
    return notify_fail("尚书大人看来现在自顾不暇\n");

  if (!me->query("class") && me->query("wenzy")) {
    command("smile");
    command("say 朝廷正当用人之际，努力吧！\n");
    command("recruit " + me->query("id"));

    remove_call_out("re_rank");
    call_out("re_rank", 1, me);
    me->del("wenzy", 0);
  }

  if (!me->query("class")) {
    if (!this_player()->query_temp("money")) {
      message_vision("$N皮笑肉不笑的说道：“好说好说一切好说”.\n", this_object());
      return notify_fail("你是真傻还是假的？没见过世面的农民呀？这个时候。。。。hehe\n");
    }
    if (this_player()->query_temp("money") && environment()->query("short") == "内堂" && living(this_object())) {

      command("haha");
      command("say 很好很好！有前途,有前途。。。。。\n");
      command("pat" + me->query("id"));
      command("recruit " + me->query("id"));
      remove_call_out("re_rank");
      call_out("re_rank", 1, me);
      destruct(this_object());
      this_object()->move(where);
      me->move(where);
      tell_room(where, "尚书大人和一个人神秘兮兮的从内堂里闪了出来，看来没干什么好事!\n");
    }
    if (me->query("id_type") == 4) {
      command("say 你已经是兵部的武将了！\n");
    }
    if (me->query("id_type") == 5) {
      command("say 你已经是刑部的官员了！\n");
    } else
      command("say 朝廷不需要你这种不三不四，来历不明之人！\n");
  }
}
void recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "official");
  ob->set("vendetta_mark", "authority");
  ob->set("id_type", 3);
}




void re_rank(object student) {
  int exp;
  exp = (int)student->query("relation_exp") * 10 + (int)student->query("life_exp");
  if (exp <= 32000) {
    student->set("title", "吏部书童");
    return;
  } else if (exp <= 64000) {
    student->set("title", "吏部管带");
    return;
  } else if (exp <= 128000) {
    student->set("title", "吏部总管");
    return;
  } else if (exp <= 256000) {
    student->set("title", "吏部侍郎");
    return;
  } else if (exp <= 512000) {
    student->set("title", "中书令");
    return;
  } else if (exp <= 1024000) {
    student->set("title", "内阁大学士");
    return;
  } else if (exp <= 1536000) {
    student->set("title", "御赐钦差");
    return;
  } else if (exp <= 2304000) {
    student->set("title", "镇南侯");
    return;
  } else if (exp <= 3456000) {
    student->set("title", "当朝太尉");
    return;
  } else if (exp <= 5187000) {
    student->set("title", "当朝宰相");
    return;
  } else if (exp <= 16000000) {
    student->set("title", "定国公");
    return;
  }
}
string summon_more(object who) {
  object soldier;
  seteuid(getuid());
  soldier = new("/obj/npc/bodyguard");
  soldier->move(environment(who));
  command("escort");
  return "1";
}

int accept_object(object who, object ob) {
  int som;
  som = ob->value();
  som /= 10000;
  if (this_object()->is_fighting() || !living(this_object()))
    return notify_fail("尚书大人看来现在自顾不暇\n");

  if (environment()->query("short") != "内堂")
    return notify_fail("张大人皱了皱眉头，说道：“你这是干什么？我可是个清官呀！”。说完抬头看了看堂头高挂的长匾.\n");
  if (som < 1000) {
    tell_object(who, "尚书大人掂量掂量手里的金子一脸不屑的样子，呵呵一笑：“谢谢谢谢，还够买个烤白薯的。。。”\n");

    return 1;
  } else {
    who->add("relation_exp", som);
    who->add("life_exp", som / 2);
    who->set_temp("money", 1);
    tell_object(who, "尚书大人笑眯眯的看着你，说道：“好，好，好。。。。”.\n");
    destruct(ob);


    return 1;
  }
}
