#include "quest.h"
#include <ansi.h>
void doquest(object me) {
  int i, x, exp;
  mapping qu;
  int n;
  n = me->query("libu/quest");
  x = random(sizeof(quest));
  exp = (int)me->query("relation_exp") * 10 + (int)me->query("life_exp");

  if (exp > 1536000)
    return notify_fail("张宗胜急忙站起来行礼道：“大人取笑了！”\n");



  qu = quest[n];

  if (!me->query("finished")) {
    message_vision("$N恭恭敬敬地向张宗胜磕头请安，叫道：「大人安好」\n", me);
    message_vision("张宗胜微微抬了抬眼皮，看看$N.\n", this_player());
    message_vision("张宗胜说道: 交代给你的完成了么? 怎么！！！\n" + qu["name"]
      + "还没有办好? 你是干什么吃的!还不快去？！要是干不了早说！！！\n", me);
    return;
  }




  qu = quest[x];
  if ((int)me->query("gin") < 100 || (int)me->query("sen") < 100)
    return notify_fail("张宗胜冷哼了一声：这么没精打采的回去休息吧！\n");


  if (exp < qu["exp_required"]) {
    message_vision("$N恭恭敬敬地向张宗胜磕头请安，叫道：「大人安好」\n", me);
    message_vision("张宗胜欣慰地笑起来, 说道：「免礼, 免礼」\n", me);
    message_vision("张宗胜想了想，本来有件事情，但看来你干不来，还是算了吧。\n", me);
    return;
  }
  message_vision("$N恭恭敬敬地向张宗胜磕头请安，叫道：「大人安好」\n", me);
  message_vision("张宗胜对$N点点头, 微笑道：「很好, 我这里正好有件事交给你办」\n", me);
  me->set("finished", 0);
  me->set("libu/quest", x);
  tell_object(me, RED "「你去" + qu["name"] + "」\n" NOR);
  return;
}
