//guanfu.c

#include <armor.h>

inherit CLOTH;

void create() {
  set_name("官袍", ({ "guanfu" }));
  set_weight(3000);
  set("value", 100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "江南制造府的极品丝绸缝制，上绣“青龙白鸾”，生气活现。\n");
    set("material", "cloth");
    set("armor_prop/armor", 2);
  }
  setup();
}
