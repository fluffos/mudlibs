//ymei_strike perform
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target) {
  string msg, dodskill;
  int damage, attack, dodge;
  if (!target) target = offensive_target(me);
  if ((int)me->query("bellicosity") > 100)
    return notify_fail("你的杀机太甚，不能体会逍遥自在的意境。\n");
  dodskill = (string)me->query_skill_mapped("dodge");
  if (dodskill != "wave_steps")
    return notify_fail("需要凌波微步身法的配和！\n");

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("必杀技法只能对战斗中的对手使用。\n");

  if (me->query_skill("wave_steps", 1) < 80
    && me->query_skill("ymei_strike", 1) < 80)
    return notify_fail("你的武功显然火候不够!\n");

  if ((int)me->query("force") - (int)me->query("max_force") < 60)
    return notify_fail("你的真气不够。\n");
  me->add("force", -60);


  msg = BLU "$N身形急转,一招「花落知多少」漫天掌影宛若疾风落花向$n飘洒迩来\n";

  me->start_busy(3);
  if (random(me->query("combat_exp")) >
    (int)target->query("combat_exp") * 3 / 5
    || target->is_busy()) {
    attack = COMBAT_D->skill_power(me, "unarmed", SKILL_USAGE_ATTACK);
    dodge = COMBAT_D->skill_power(target, "dodge", SKILL_USAGE_DEFENSE);
    if (random(attack) > dodge / 2) {
      damage = (int)me->query_skill("ymei_strike") * 3 - (int)target->query_skill("unarmed") * 2;
      damage += (int)me->query_skill("parry") * 3 - (int)target->query_skill("parry") * 2;
      damage = random(damage) + random(me->query("kar"));
      if (wizardp(me)) printf("damage = %d\n", damage);
      if (damage > 0) {
        msg += "$n显然被眼前凄美的一切惊呆了，刹那间笼罩在掌影中，一声惨叫倒飞了出去. \n" NOR;
        target->receive_damage("kee", damage);
        target->receive_wound("kee", damage / 2);
        target->receive_wound("sen", damage / 2);
        target->receive_damage("sen", damage);
        target->start_busy(5);
      } else {
        msg += "$n为眼前凄美的景象行动为之一窒但很快恢复了镇静.\n" NOR;
        target->start_busy(2);

      }
    }
  }
  message_vision(msg, me, target);

  return 1;
}
