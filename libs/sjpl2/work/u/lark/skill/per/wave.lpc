// wave.c

#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me, int amount, int amount2);

int exert(object me, object target) {
  int skill;

  if (target != me) return notify_fail("你只能提升自己的速度。\n");

  if (me->query_skill("bm_force", 1) < 70) return notify_fail("你的内功还没到那个地步\n");

  if ((int)me->query("force") < 100) return notify_fail("你的内力不够。\n");
  if ((int)me->query_temp("speedup")) return notify_fail("你身法速度不可能再提升了。\n");

  skill = me->query_skill("wave_steps");


  me->add("force", -100);

  message_vision(HIC "$N嘴角露出一丝淡然洒脱的微笑,身形展开RED 翩如惊鸿，宛若游龙！NOR\n" NOR, me);

  me->add_temp("apply/attack", skill / 5);
  me->add_temp("apply/dodge", skill * 2);
  me->set_temp("speedup", 1);

  me->start_call_out((: call_other, __FILE__, "remove_effect", me,
    skill / 5, skill * 2 :), skill);

  if (me->is_fighting()) me->start_busy(3);

  return 1;
}

void remove_effect(object me, int amount, int amount2) {
  me->add_temp("apply/attack", -amount);
  me->add_temp("apply/dodge", -amount2);
  me->delete_temp("speedup");
  tell_object(me, "你气息渐浊，身形随之缓慢下来。\n");
}
