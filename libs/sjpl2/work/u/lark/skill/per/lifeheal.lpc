#include <ansi.h>

int exert(object me, object target) {
  if (!target || target == me)
    return notify_fail("你要用北冥真气为谁疗伤？\n");

  if (me->is_fighting() || target->is_fighting())
    return notify_fail("战斗中无法运功疗伤！\n");

  if ((int)me->query("force") < 200)
    return notify_fail("你的真气不够。\n");

  if ((int)target->query("eff_kee") < (int)target->query("max_kee") / 5)
    return notify_fail(target->name() + "已经受伤过重，经受不起你的真气震荡！\n");

  message_vision(
    BLU "$N立即盘膝坐在地上，默念心诀，左手贴于$n的「天突穴」将北冥真气缓缓的输入$n体内....过了一会儿，\n"
    "$N的身旁涌出了一层淡青，$n脸色由苍白转红润，突然吐出一口瘀血，看起来精神多了。\n" NOR,
    me, target);

  target->receive_curing("kee", 15 + (int)me->query_skill("force") / 3);
  me->add("force", -150);
  me->set("force_factor", 0);
  return 1;
}
