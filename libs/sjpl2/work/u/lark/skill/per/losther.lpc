//无他思
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string dodskill, msg;
  int extra, love, kiss;
  object weapon, ob;
  extra = me->query_skill("gaoge_sword", 1);

  if (!me->query("saux"))
    return notify_fail("你无法自行领会，必须向韩江雪请教\n");
  if (extra <= 60) return notify_fail("你的剑法还不够纯熟！\n");
  if (me->query_skill("wave_steps", 1) < 60)
    return notify_fail("你的轻功太低了，速度不够\n");
  dodskill = (string)me->query_skill_mapped("dodge");
  if (dodskill != "wave_steps")
    return notify_fail("需要凌波微步身法的配和！\n");
  if (!target) target = offensive_target(me);
  if ((int)me->query("bellicosity") > 100)
    return notify_fail("你的杀机太甚，不能体会逍遥自在的意境。\n");
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("只能对战斗中的对手使用。\n");
  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword")
    return notify_fail("你手里必须有一把剑才能使用。\n");

  if (love = (int)me->query("gin") < 100 || kiss = (int)me->query("sen") < 100)
    return notify_fail("你的精神涣散不能进入意境。\n");
  weapon = me->query_temp("weapon");
  message_vision(MAG "$N露出了一丝恬淡的微笑, 轻弹长剑幻出点点剑影烂漫宛若丁香花雨\n"
    "风中婀娜的轻舞,长发飞扬的神采,也许完美并非存在,却能在这一个瞬间永恒,一个轻舞\n"
    " 飞扬幻想\n\n\n「无她思」", me);

  msg = MAG "$N衣襟迎风微微飞扬,剑式圆滑若满月,$N眼光深远望对长空轻吟道:\n" NOR;
  msg += MAG "习习清风明月夜，通宵共舞惜华年\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);

  msg = MAG "$N长剑顺势斜画而下,蓦的静止剑尖斜指于地,静静沉思,似乎忘记了$n和世间\n" NOR;
  msg += MAG "的一切,神情似怨似喜,似愁似欢,低声诵道\n" NOR;
  msg += MAG "绛唇珠袖两寂寞，愿逐月华流照君\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);

  msg = MAG "$N突然叹了口气踱步向前,衣袖轻挥,长剑在身周运转点点画画若闻歌而舞,轻歌道:\n" NOR;
  msg += MAG "霓裳翻飞飘摇举，莲步轻移尘不起\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = MAG "$N身形蓦然停缓,长剑在空中挽出翩翩剑花,汇成一条完美的弧,好象银河倒泻而下\n";
  msg += MAG "光彩流华,是在场的人好象置身梦境,$N脸上浮现无限向往的神情纵声长歌道:\n";
  msg += MAG "舞罢宫花颤未休，纵是不语也动人\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);

  me->start_busy(random(2) + 1 + random(2));
  me->add("gin", -100);
  me->add("sen", -100);
  return 1;
}
