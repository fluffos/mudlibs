// taiji.c
#include <ansi.h>
inherit SKILL;
object offensive_target(object me);
void remove_enemy(object me, object target);
mapping *action = ({
  ([ "action": "$N左手轻击右臂关节,右掌突然奇异的颤动化出无数掌影拍向$n\n",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N右手轻击左臂关节,左掌突然奇异的颤动化出无数掌影拍向$n\n",
    "damage_type": "瘀伤"
  ]),
});

string *parry_msg = ({
  "$n双掌不断圆转，将$N的攻势封在外面。\n",
});

string *unarmed_parry_msg = ({
  "$n脚步癫乱、却以静制动，$N迷迷糊糊竟被$n带出好远。\n",
});

string *mizong_msg = ({

  CYN "$N拳势突然一变，抢先一步，一拳从一个不可能的角度击出！\n" NOR,
});

string *winner_msg = ({
  CYN "\n$N哈哈大笑，说道：承让了！\n\n" NOR,
  CYN "\n$N双手一拱，笑著说道：承让！\n\n" NOR,
  CYN "\n$N胜了这招，向后跃开三尺，叹道：真是拔剑四顾心茫然！\n\n" NOR,
  CYN "\n$n脸色微变，说道：佩服，佩服！\n\n" NOR,
  CYN "\n$n向後一纵，躬身做揖说道：阁下武艺不凡，果然高明！\n\n" NOR,
  CYN "\n$n向后一纵，恨恨地说道：君子报仇，十年不晚！\n\n" NOR,
});

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练迷踪拳法必须空手。\n");
  return 1;
}

int valid_enable(string usage) {
  return usage == "unarmed";
}


mapping query_action(object me, object weapon) {
  string msg;
  int level, dodge;
  object target;
  msg = mizong_msg[random(sizeof(mizong_msg))];
  target = offensive_target(me);
  level = me->query_skill("mizongquan", 1);
  if (me->query_temp("luoyang/mizong"))
    me->set_temp("luoyang/mizong", 0);
  else me->set_temp("luoyang/mizong", 1);
  if (me->query_temp("luoyang/mizong") && random(level) > 50)
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 2, msg);
  else if (!me->query_temp("luoyang/mizong") && random(level) > 50) {
    target->set_temp("guarding", 1);
    me->receive_heal("kee", level);
  } else if (random(10) > 7) {
    call_out("remove_enemy", 1, me, target);
  }
  return action[random(sizeof(action))];
}


int practice_skill(object me) {
  if ((int)me->query("kee") < 30)
    return notify_fail("你的体力不够了，休息一下再练吧。\n");
  me->receive_damage("kee", 30);
  return 1;
}

int effective_level() { return 10; }

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int learn_bonus() {
  return 10;
}


int practice_bonus() {
  return -20;
}

int black_white_ness() {
  return 30;
}

object offensive_target(object me) {
  int sz;
  object *enemy;

  enemy = me->query_enemy();
  if (!enemy || !arrayp(enemy)) return 0;

  sz = sizeof(enemy);
  if (sz > 4) sz = 4;

  if (sz > 0) return enemy[random(sz)];
  else return 0;

}

void remove_enemy(object me, object target) {
  message_vision(CYN "$N" + CYN "突然一闪身，欺入$n" + CYN "中宫，一掌击在$n" + CYN "胸口。\n" NOR, me, target);
  message_vision(HIR "$n" + HIR "被$N" + HIR "震得气血翻腾，大惊失色。\n" NOR, me, target);
  me->remove_all_killer();
  message_vision(winner_msg[random(sizeof(winner_msg))], me, target);
}
