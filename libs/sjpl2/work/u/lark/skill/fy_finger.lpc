int valid_learn(object me) {
  string dodskill;
  dodskill = (string)me->query_skill_mapped("dodge");
  if (dodskill != "wave_steps" || (int)me->query_skill("wave_steps", 1) < 70)
    return notify_fail("逍遥武功必须要凌波微步的配合.\n");
  if ((int)me->query("max_force") < 500)
    return notify_fail("你的内力修为不够，无法修习更高深的指法。\n");
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练指必须空手。\n");
  if ((int)me->query_skill("unarmed", 1) / 2 < (int)me->query_skill("fy_finger", 1) / 3)
    return notify_fail("你的徒手功夫根基不够，无法练习「浮月流云指」。\n");

  return 1;
}

int valid_enable(string usage) {

  return usage == "unarmed";


}

mapping query_action(object me, object weapon) {

  string xuewei, actionn;
  int i, level;
  string *name = ({
    "「天突穴」",
    "「廉泉穴」",
    "「承浆穴」",
    "「鱼府穴」",
    "「孔最穴」",
    "「天府穴」",
    "「侠白穴」",
    "「中府穴」",
    "「经渠穴」",
    "「尺泽穴」",
    "「大渊穴」",
    "「云门穴」",
    "「环跳穴」",
    "「肩井穴」",
    "「百汇穴」",
    "「列缺穴」",
    "「玉枕穴」",
    "「偏历穴",
    "「神门穴」",
    "「灵道穴」",
    "「少海穴」",
    "「少府穴」",
    "「通理穴」"
  });
  xuewei = name[random(sizeof(name))];

  level = (int)me->query_skill("fy_finger", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      action[random(i)][action] = replace_string(action[random(i)][action], "MSG", xuewei);
  return action[random(i)];

}

int practice_skill(object me) {

  int skill, combat_exp;
  skill = me->query_skill("fy_finger", 1);
  if ((skill >= 99 && skill < 106) || (skill >= 145 && skill < 151))
    return notify_fail("你于细微处无法理解，需要向师父继续学习精妙招式。\n");
  combat_exp = (int)me->query("combat_exp");
  skill = (int)me->query_skill("fy_finger", 1);
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练指必须空手。\n");

  if (skill * skill * skill / 10 > combat_exp)
    return notify_fail("你的实战经验不够，无法练习「浮月流云指」\n");


  if ((int)me->query("kee") < 30
    || (int)me->query("force") < 3)
    return notify_fail("你的内力或气不够，无法练习「浮月流云指」\n");
  me->receive_damage("kee", 30);
  me->add("force", -3);
  write("你按著所学练了一遍「浮月流云指」，似乎有些心得。\n");
  return 1;
}
int effective_level() { return 20; }
int learn_bonus() {
  return -30;
}
int practice_bonus() {
  return -30;
}
int black_white_ness() {
  return -30;
}
string perform_action_file(string action) {
  return CLASS_D("xiaoyao") + "/fy_finger/" + action;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

void skill_improved(object me) {
  if (me->query_skill("fy_finger", 1) == 20) {
    tell_object(me, HIW "你对浮月流云指的领悟更上一层楼领悟了「梦回轻拂琴」这一招.\n" NOR);
    return;
  }
  if (me->query_skill("fy_finger", 1) == 30) {
    tell_object(me, HIW "你对浮月流云指的领悟更上一层楼领悟了「聚散总如云」这一招.\n" NOR);
    return;
  }
  if (me->query_skill("fy_finger", 1) == 40) {
    tell_object(me, HIW "你对浮月流云指的领悟更上一层楼领悟了「斜月半窗还少睡」这一招.\n" NOR);
    return;
  }
  if (me->query_skill("fy_finger", 1) == 50) {
    tell_object(me, HIW "你对浮月流云指的领悟更上一层楼领悟了「画屏闲展吴山翠」这一招.\n" NOR);
    return;
  }
  if (me->query_skill("fy_finger", 1) == 60) {
    tell_object(me, HIW "你对浮月流云指的领悟更上一层楼领悟了「衣裳泪痕诗里字」这一招.\n" NOR);
    return;
  }
  if (me->query_skill("fy_finger", 1) == 70) {
    tell_object(me, HIW "你对浮月流云指的领悟更上一层楼领悟了「点点行行」这一招.\n" NOR);
    return;
  }
  if (me->query_skill("fy_finger", 1) == 80) {
    tell_object(me, HIW "你对浮月流云指的领悟更上一层楼领悟了「总是凄凉意」这一招.\n" NOR);
    return;
  }
  if (me->query_skill("fy_finger", 1) == 90) {
    tell_object(me, HIW "你对浮月流云指的领悟更上一层楼领悟了「却不如随意来去」这一招.\n" NOR);
    return;
  }
  if (me->query_skill("fy_finger", 1) == 100) {
    tell_object(me, HIW "你对浮月流云指的领悟更上一层楼领悟了「寒夜轻歌是逍遥」这一招.\n" NOR);
    return;
  }
}
