#include <ansi.h>     

inherit NEW_NPC;
int restore();
int save();

void create()
{
        string * worn,* wielded;
        int i,j;
        set_name( "可爱", ({ "pretty" }) );
        if( !restore() ) {
            write("Error: 读取档案错误！\n"); 
        }
//    set("chat_chance", 10);
//    set("chat_msg", ({
//              (: random_move :),
//    }) );
        set("mingzhu",0);
        set("env/wimpy",0);
        setup();
        NEWNPC_D->refresh();
        NEWNPC_D->add_npc("pretty",this_object());

    carry_object("/obj/cloth/color_pants")->wear();
    carry_object("/obj/cloth/silk_bra")->wear();
    carry_object("/obj/cloth/color_cloth")->wear();
    carry_object("/obj/weapon/steelsword")->wield();
}

string query_save_file()
{
        return "/data/user/p/pretty";
}


int restore()
{
        string file;

        if( stringp(file = this_object()->query_save_file()) )
                return restore_object(file);
        return 0;
}

int accept_fight(object me)
{
     command("say 咦... 你也想来玩两手？好啊！");
         return 1;
}
