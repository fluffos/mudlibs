//ROOM:/u/changan/street1.c

inherit ROOM;

void create() {
  set("short", "朱雀大街");
  set("long", @LONG
街道的右侧是兵部尚书的官邸，两边有两头威武的石狮，台阶下有一块三丈高的
石碑(shibei)高高的石阶上有四名虎背熊腰的卫士分立两旁，门口安安静静，因为这
里是不准许停留的。红漆镶金的大门上悬一块额匾(ebian)大门禁闭着，只开着旁边的
一个偏门。往西面是长安棋院，南通明德门，北往朱雀门。
LONG
  );
  set("item_desc", ([
    "shibei": @TEXT
只见上面金漆楷书三个大字:下马碑.这是先帝感念
兵部尚书路大人,开国的赫赫战功特令所立,见碑如见圣上,文官下轿
武官下马.违者斩立绝.
TEXT,
    "ebian":
    "敕立应天护国大将军一字并肩王路府。乃是先帝手书\n",
  ]));
  set("exits", ([
    "south": "/d/city/zhuque-n2",
    "north": "/d/city/zhuque-n4",
    "west": "/d/city/qiyuan",
    "east": __DIR__ "menwei",
  ]));
  set("objects", ([
    __DIR__ "npc/ye": 1,
  ]));
  set("outdoors", "changan");
  setup();
}
