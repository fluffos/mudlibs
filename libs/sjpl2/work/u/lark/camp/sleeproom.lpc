//sleeproom.c

inherit ROOM;

void create() {
  set("short", "营房");
  set("long", @LONG
这里是军营的营房，这里面排放了整齐的床铺，看来内务作的不错。
一整天的训练一定精疲力竭，好好睡一觉，放松放松吧。
这里面排放了整齐的床铺，看来内务作的不错。
LONG
  );
  set("exits", ([
    "south": __DIR__ "jiaochang",
  ]));
  set("valid_startroom", 1);
  set("sleep_room", 1);
  set("no_clean_up", 1);
  setup();

}

void init() {
  add_action("do_save", "save");
  add_action("do_sleep", "sleep");
}

int do_save() {
  if (!this_player()->query("solider")) {
    write("别妄想了,bug 已经没有了,heihei---lark\n");
    return 1;
  }

  return 0;

}

int do_sleep() {
  if (!this_player()->query("solider")) {



    write("别妄想了,bug 已经没有了,heihei---lark\n");
    return 1;
  }

  return 0;


}
