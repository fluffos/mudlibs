//jiaochang2.c

inherit ROOM;

void create() {
  set("short", "校场");
  set("long", @LONG
这里是军营内的校场，是兵士们日常训练的地方，整齐的方队，
划一的步伐，嘹亮的口号，闪亮的盔甲，让你不禁热血沸腾。
正有一队兵士正在操练武艺。北面是伙房，东面是兵器库.
LONG
  );
  set("exits", ([
    "west": __DIR__ "jiaochang",
    "north": __DIR__ "huofang",
    "east": __DIR__ "bingqiku",
    "south": __DIR__ "jiaochang3",
  ]));
  set("objects", ([
    __DIR__ "npc/zhangz": 1,
    __DIR__ "npc/bing2": 4,
  ]));
  setup();
  replace_program(ROOM);
}
