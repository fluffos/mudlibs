#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string summon_more(object who);
void re_rank(object student);
void create() {
  set_name("张智", ({ "zhang zhi", "zhang" }));
  set("long", "负责操练士兵武艺的军官。\n");
  set("title", RED "司隶校尉" NOR);
  set("attitude", "heroism");
  set("student_title", "官员");
  create_family("朝廷", 7, "官员");
  set("vendetta_mark", "authority");
  set("str", 20);
  set("int", 20);
  set("cor", 20);
  set("spi", 20);
  set("agi", 20);
  set("max_kee", 1000);
  set("max_gin", 2000);
  set("max_sen", 2000);
  set("kee", 500);
  set("gin", 2000);
  set("sen", 2000);
  set("force", 1000);
  set("max_force", 1000);
  set("force_factor", 10);
  set("score", 90000);
  set_temp("apply/attack", 20);
  set_temp("apply/defense", 20);
  set_temp("apply/move", 20);

  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "spear.huima" :),

  }));

  set("combat_exp", 1000000);
  set_skill("unarmed", 60);
  set_skill("dagger", 60);
  set_skill("force", 60);
  set_skill("parry", 60);
  set_skill("dodge", 60);
  set_skill("spear", 60);
  set_skill("blade", 60);
  set_skill("duanmen_blade", 40);
  set_skill("xingyi-ken", 40);
  set_skill("nezha_dagger", 40);
  set_skill("bixueforce", 40);
  set_skill("move", 80);
  set_skill("yang_spear", 40);


  map_skill("blade", "duanmen_blade");
  map_skill("unarmed", "xingyi-ken");
  map_skill("force", "bixueforce");
  map_skill("dagger", "nezha_dagger");
  map_skill("spear", "yang_spear");
  setup();

  carry_object("/obj/cloth/tiejia")->wear();
  carry_object("/obj/weapon/longspear")->wield();
}

void attempt_apprentice(object me) {
  if (!me->query("solider", 1)) {
    command("say 我这两下子沙场砍两个人还行，要是防身你还是找个高明的武师吧。\n");
    return;
  }
  if (me->query("id_type") == 4) {

    command("blush");
    command("say 大人取笑了。在下怎敢班门弄斧？\n");
    return;
  }
  if (me->query("id_type") == 3) {
    command("haha");
    command("say 大人真爱开玩笑。文官就是舞文弄墨什么的干吗要学这粗活？\n");
    return;
  }
  if (me->query("id_type") == 5) {
    command("haha");
    command("say 大人言重了！抓个地痞流氓什么的不需要这么大动干戈的吧。\n");
    return;
  }


  command("pat" + me->query("id"));
  command("say 平时多流汗，战时少流血！好好用功，会派上用场。\n");
  command("recruit " + me->query("id"));
  remove_call_out("re_rank");
  call_out("re_rank", 1, me);
  return;

}

int accept_object(object who, object ob) {
  int som;
  som = ob->value();
  who->add("relation_exp", som / 100);
  who->add("life_exp", som / 100);
  tell_object(who, "张志暧昧的看了你一眼，：“有前途，将来一定吃得开。。呵呵”\n");
  return 1;
}

/*
void init()
{
        add_action("give_quest", "quest");
}
*/

int prevent_learn(object me, string skill) {

  mapping my_family, family;

  int mylvl, lvl;

  lvl = this_object()->query_skill(skill, 1);
  mylvl = me->query_skill(skill, 1);



  if (!me->is_apprentice_of(this_object())) {
    if (!mapp(my_family = me->query("family")))
      return 0;
    if (!mapp(family = this_object()->query("family")))
      return 0;
    if ((my_family["family_name"] == family["family_name"]) && (lvl <= mylvl * 3)) {
      command("hmm");
      command("pat " + me->query("id"));
      write(RED "张智笑了笑：“人往高处走，水往低处流，你现在应该换换环境了，为什么不到兵部谋个职？\n" NOR);
      me->set_temp("arra", 1);

      return 1;
    }
  }

  return 0;
}

void re_rank(object student) {
  student->set("title", RED "长安军兵" NOR);
  return;
}
