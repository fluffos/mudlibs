#include <ansi.h>

inherit NPC;

void create() {
  set_name(RED "长安军兵" NOR, ({ "bing" }));
  set("long", "一个威武强壮的士兵。\n");
  set("attitude", "heroism");
  set("age", 20);
  set("str", 27);
  set("cor", 26);
  set("cps", 25);
  set("vendetta_mark", "authority");
  set("combat_exp", 5000);
  set_skill("spear", 50);
  set_skill("unarmed", 50);
  set_skill("blade", 50);
  set_skill("parry", 50);
  set_skill("dodge", 50);
  set_skill("move", 50);
  set_skill("yang_spear", 30);     //杨家枪法
  set_skill("xingyi-ken", 30);     //形意拳
  set_temp("apply/dammage", 10);
  set_temp("apply/defense", 10);
  set_temp("apply/attack", 10);
  map_skill("unarmed", "xingyi-ken");
  map_skill("spear", "yang_spear");
  setup();
  carry_object("/d/city/obj/cloth/bingfu")->wear();

  carry_object("/obj/weapon/longspear")->wield();
}

int accept_fight(object me) {
  int x;
  object ob;
  command("heng");
  command("say 胆敢到这里来闹事，你吃错药了？找死！\n");
  kill_ob(me);
  return 1;
}
