#include <ansi.h>
inherit NPC;



void create() {

  set_name(HIW "火头" NOR, ({ "huotou" }));
  set("long", "这是羊鸣寨的火头,原来是山下村子里的一个老人。\n"
    "只是擅长烹饪，就被捉来当了火夫。\n");
  set("gender", "男性");
  set("attitude", "peaceful");
  set("age", 68);
  set("title", HIW "羊鸣塞" NOR);
  set(
    "str",
    5
  ); /* = 膂力*/ set(
    "cor",
    5
  ); /* = 胆识*/ set(
    "int",
    15
  ); /* = 悟性*/ set(
    "spi",
    15
  ); /* = 灵性*/ set(
    "cps",
    10
  ); /* = 定力*/ set("per", 20); /* = 容貌*/ set("con", 10); /* = 根骨*/ set("kar", 10); /* = 福缘*/

  set("max_kee", 300);
  set("eff_kee", 300);
  set("kee", 300);

  set("combat_exp", 5000);
  set_skill("force", 50);
  set_skill("unarmed", 50);
  set_skill("dodge", 50);
  set_skill("parry", 50);
  setup();
  carry_object("/obj/cloth")->wear();

}


void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }

}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;

  say("火头慢慢地说道：这位" + RANK_D->query_respect(ob)
    + "快吃吧，不知道下次还吃不吃的到!\n");
}
