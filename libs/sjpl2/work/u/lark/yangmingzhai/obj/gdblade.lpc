#include <ansi.h>
#include <weapon.h>
inherit BLADE;
void create() {
  set_name(HIC "古锭刀" NOR, ({ "guding_blade", "blade" }));
  set_weight(4000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("value", 2000000);
    set("material", "steel");
    set("long", "这是一柄三国时期遗留下来的宝刀,重达八十二斤,锋利无比。\n");
    set("wield_msg", "$N抽出一把明晃晃的$n握在手中。\n");
    set("unequip_msg", "$N将手中的$n插入腰间的刀鞘。\n");
  }
  init_blade(100);
  setup();
}
