inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("干肉", ({ "gan rou", "rou" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一块已经风干的肉，看起来并不太好吃。\n");
    set("unit", "块");
    set("value", 20);
    set("food_remaining", 3);
    set("food_supply", 60);
  }
}
