// xie.c

inherit NPC;
string summon_more(object who);
void create() {
  set_name("谢飞鸿", ({ "xie feihong", "xie", "pan" }));
  set("gender", "男性");
  set("title", "兵部文书");
  set("age", 30);
  set("str", 30);
  set("cor", 30);
  set("cps", 30);
  set("per", 30);
  set("int", 35);
  set("attitude", "heroism");
  set("student_title", "官员");
  create_family("朝廷", 6, "官员");

  set("id_type", 4);                      //此处设置NPC身份为武将
  set("vendetta_mark", "authority");  //设置自动追杀反官府的敌人

  set("max_force", 2200);
  set("force", 4200);
  set("force_factor", 4);

  set("long",
    "思维缜密,头脑冷静呵呵！你想认识他finger pan.\n");


  set("combat_exp", 800000);
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "spear.huima" :),       //杨家枪的绝招“回马枪”
    (: summon_more(this_object()) :),
    (: command, "escort" :),                        //上两行呼叫亲兵保护
  }));
  set("water", 600);
  set("food", 600);
  set("combat_exp", 4000000);
  set("relation_exp", 90000);     //设置人际关系
  set("life_exp", 50000);         //设置江湖阅历

  set_skill("unarmed", 230);
  set_skill("spear", 250);
  set_skill("force", 180);
  set_skill("parry", 120);
  set_skill("dodge", 110);
  set_skill("xingyi-ken", 200);    //形意拳
  set_skill("yang_spear", 220);    //杨家枪法
  set_skill("bixueforce", 150);    //碧血心法
  set_skill("move", 100);
  set_skill("literate", 190);
  set_skill("officialism", 150);   //为官之道
  set_skill("strategy", 150);              //兵法战策
  map_skill("unarmed", "xingyi-ken");
  map_skill("force", "bixueforce");
  map_skill("spear", "yang_spear");

  setup();

  //     carry_object("/d/city/obj/spear/gangqiang")->wield();
  carry_object(__DIR__ "obj/guanfu")->wear();
}

string summon_more(object who) {
  object soldier;
  seteuid(getuid());
  soldier = new("/obj/npc/bodyguard");
  soldier->move(environment(who));
  command("escort");              //以上函数对应呼叫亲兵保护
  return "1";
}
