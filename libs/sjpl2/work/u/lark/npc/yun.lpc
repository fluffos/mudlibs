// yun.c

inherit NPC;

void create() {
  set_name("云皓池", ({ "yun haochi", "yun" }));
  set("gender", "男性");
  set("title", "裨将军");
  set("vendetta_mark", "authority");
  set("attitude", "heroism");
  set("class", "official");  //设置玩家阶级为朝廷官员
  set("id_type", 4);
  set("age", 25);
  set("str", 26);
  set("cor", 24);
  set("cps", 11);
  set("per", 27);
  set("int", 27);


  set("max_force", 200);
  set("force", 200);
  set("force_factor", 2);

  set("long", "云皓池怎么看也不象一个行伍出身的将军，看身手起来到象个武林高手。\n");


  set("combat_exp", 500000);
  set("chat_chance", 2);
  set("chat_msg", ({
    "这么多年不出手早痒痒了。。。受死吧!!!\n"
  }));
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed.flower" :),
    (: perform_action, "sword.raya" :),
    (: perform_action, "unarmed.rain" :),
  }));
  set("chat_chance", 3);  // 随机动作概率 25%
  set("chat_msg", ({
    "云皓池说道：唉当年和师哥出来闯荡江湖，快意恩仇，何等快活。\n"
    "就算是纵横疆场，撒血黄沙也是痛快的。\n",
    "云皓池说道：可自从师哥当个这个见鬼的尚书。。。那里还有一点以前洒脱的风采。。。\n",
    "云皓池叹了口气，往门里偷偷张望了一下，嫂子最近都很少有笑。。\n",
    "又在胡思乱想了。。。该死该死。。。\n"
    "云皓池脸上突然抹过一丝迷醉的神情。。。。。但转瞬即逝。。。\n",

  }));

  set_skill("unarmed", 80);
  set_skill("parry", 120);
  set_skill("dodge", 80);
  set_skill("sword", 80);
  set_skill("force", 80);
  set_skill("literate", 80);

  set_skill("bm_force", 100);
  set_skill("gaoge_sword", 150);
  set_skill("ymei_strike", 80);
  set_skill("wave_steps", 100);

  map_skill("unarmed", "ymei_strike");
  map_skill("sword", "gaoge_sword");
  map_skill("parry", "gaoge_sword");
  map_skill("dodge", "wave_step");

  setup();

  carry_object("/obj/example/sword")->wield();
  carry_object(__DIR__ "obj/zcloth")->wear();
}
