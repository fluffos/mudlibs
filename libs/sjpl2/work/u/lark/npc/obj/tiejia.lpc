//tiejia.c
#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create() {
  set_name(BLK "黑铁护甲" NOR, ({ "tiejia" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 3000);
    set("material", "iron");
    set("armor_prop/armor", 100);
    set("armor_prop/dodge", -30);
  }
  setup();
}
