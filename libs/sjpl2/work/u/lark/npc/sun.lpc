//liu.c

#include <ansi.h>
inherit NPC;
string summon_more(object who);

void create() {
  set_name("孙俊", ({ "sun tongling", "sun" }));
  set("long",
    "跟随路尚书征战多年的猛将，精明强干。\n");

  set("attitude", "heroism");
  set("student_title", "官员");

  set("title", "虎卫统领");
  set("id_type", 4);                      //此处设置NPC身份为武将
  set("vendetta_mark", "authority");  //设置自动追杀反官府的敌人
  set("str", 20);
  set("int", 20);
  set("cor", 20);
  set("spi", 20);
  set("agi", 20);
  set("max_kee", 300);
  set("max_gin", 300);
  set("max_sen", 300);
  set("kee", 300);
  set("gin", 300);
  set("sen", 300);
  set("force", 400);
  set("max_force", 400);
  set("force_factor", 30);
  set("score", 100000);
  set_temp("apply/attack", 30);
  set_temp("apply/defense", 30);
  set_temp("apply/move", 30);

  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "spear.huima" :),       //杨家枪的绝招“回马枪”

  }));
  set("combat_exp", 200000);
  set("relation_exp", 30000);     //设置人际关系
  set("life_exp", 10000);         //设置江湖阅历

  set_skill("unarmed", 70);
  set_skill("spear", 50);
  set_skill("force", 80);
  set_skill("parry", 80);
  set_skill("dodge", 70);
  set_skill("xingyi-ken", 160);    //形意拳
  set_skill("yang_spear", 180);    //杨家枪法
  set_skill("bixueforce", 150);    //碧血心法
  set_skill("move", 100);
  set_skill("literate", 30);
  set_skill("officialism", 50);    //为官之道
  set_skill("strategy", 50);               //兵法战策
  map_skill("unarmed", "xingyi-ken");
  map_skill("force", "bixueforce");
  map_skill("spear", "yang_spear");
  setup();

  //     carry_object("/d/city/obj/spear/gangqiang")->wield();
  carry_object(__DIR__ "obj/zcloth")->wear();
}
