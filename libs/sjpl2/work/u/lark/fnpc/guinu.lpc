// boaer.c

inherit NPC;
inherit F_VENDOR;


void create() {
  set_name("龟奴", ({ "guinu", "nu" }));
  set("long", "满脸媚笑的可悲的家伙。\n");

  set("age", 27);
  set("max_kee", 1000);
  set("max_force", 1000);
  set("force_factor", 3);
  set("water", 600);
  set("food", 600);
  set_skill("unarmed", 80);
  set_skill("dodge", 80);
  set_skill("force", 80);
  set_temp("apply/attack", 30);
  set_temp("apply/defense", 30);
  set("combat_exp", 30000);
  set("chat_chance", 3);

  set("chat_msg", ({
    "大爷您来了,今天不知找哪为姑娘？\n",
  }));
  setup();
  carry_object("/obj/cloth")->wear();


}


int accept_fight(object ob) {
  return 1;
}
