// Room: /u/yanzi/huashan/house2.c

inherit ROOM;
int count = 0;
int ct_ok = 0;

void create() {
  set("short", " [0;1;36m[1m[1m[1m[0m");
  set("long", @LONG
一间用茅草，干柴制成的小屋，墙边是一张粗木大床，一张简陋的小
桌放在窗前，桌上的烧到一半的蜡烛显示这里现还有人居住桌上还放着
个花瓶，里面稀疏地插着几朵小花。主人似乎出门去了，还没有回来。
LONG
  );

  set("exits", ([ /* sizeof() == 1 */
    "out": __DIR__ "gudi3",
  ]));
  set("no_clean_up", 0);

  setup();
}
void init() {
  add_action("do_wait", "wait");
}
int do_wait() {
  object ob, me;
  me = this_player();
  count++;
  if (ct_ok == 1) return notify_fail("他不是已经在了吗？\n");
  if (count < 2) {
    tell_object(me, "你等了一个时辰，但是一点动静也没有。\n");
    return 1;
  }
  if (count == 2) {
    tell_object(me, "你又等了一个时辰，但主人还没有回来的迹象。\n");
    return 1;
  }
  if (count == 3) {
    tell_object(me, "你再等了一个时辰，但主人仍然没有回来，今天也许他不回来吧。\n");
    return 1;
  }
  if (ct_ok == 0) {
    write("随着“吱”地一声开门声，一个白发老者走了进来。\n");
    ob = new(__DIR__ "npc/lizhip");
    ob->move(environment(me));
    ct_ok = 1;
    count = 0;
    return 1;
  }
}
