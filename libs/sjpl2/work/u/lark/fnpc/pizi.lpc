// boaer.c

inherit NPC;


void create() {
  set_name("痞子", ({ "pizi", "pi" }));
  set("long", "一个街头混混\n");

  set("age", 27);
  set("max_kee", 800);
  set("max_force", 1000);
  set("force_factor", 1);
  set("water", 600);
  set("food", 600);
  set_skill("unarmed", 50);
  set_skill("dodge", 50);
  set_skill("force", 50);
  set_temp("apply/attack", 13);
  set_temp("apply/defense", 13);
  set("combat_exp", 13000);
  set("chat_chance", 30);

  set("chat_msg", ({
    "痞子斜眼看着你：找茬？\n",
  }));
  setup();
  carry_object("/obj/cloth")->wear();


}


int accept_fight(object ob) {
  return 1;
}
