// wu.c

inherit NPC;

create() {
  set_name("赵半仙", ({ "zhao banxian", "zhao" }));
  set("title", "算命先生");
  set("gender", "男性");
  set("long", "一个仙风道骨的江湖术士");
  set("age", 80);
  set("attitude", "friendly");
  set("combat_exp", 1000);

  set_skill("unarmed", 10);
  set_skill("dodge", 10);
  set("inquiry", ([
    "算命": "您要算命么(suanming)? 五十个铜板就够了!"
  ]));
  setup();
  carry_object("/obj/cloth")->wear();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()))
    call_out("greeting", 1, ob);
  add_action("suanming", "suanming");
}

void greeting(object ob) {
  remove_call_out("greeting");
  if (!ob || environment() != environment(ob)) return;
  command("say " + RANK_D->query_respect(ob) +
    "来算一卦吧, 能知前生后世!");
  return;
}

int suanming(string arg) {
  int amount;
  object money, ob;
  if (arg) return 0;

  if (!(money = present("coin_money", this_player())) || (amount = (int)money->value()) < 50)
    return notify_fail("你身上的铜板不够!\n");
  destruct(money);
  money = new("/obj/money/coin");
  money->set_amount(amount - 50);
  money->move(this_player());
  message_vision("$N对赵半仙言道: 请先生给算个命\n", this_player());
  if (random(2) == 1) {
    command(":P");
    command("say " + RANK_D->query_respect(this_player()) +
      "前程未可限量, 未可限量!");
    command("praise " + this_player()->query("id"));
  } else {
    command("shake");
    command("sigh");
    command("say " + RANK_D->query_respect(this_player()) +
      "前程不幸之至, 不幸之至啊!");
    command("say 可怜实在可怜啊");
  }
  return 1;
}
