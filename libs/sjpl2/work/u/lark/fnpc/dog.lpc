// mind_beast.c

inherit NPC;

void create() {
  set_name("野狗", ({ "dog" }));
  set("race", "野兽");
  set("gender", "雄性");
  set("age", 3);
  set("long", "这是一只凶猛无比，半人多高的狼犬\n");

  set("cor", 52);
  set("str", 32);

  set("cps", 22);

  set("max_kee", 300);
  set("max_gin", 300);
  set("max_sen", 400);
  set("attitude", "aggressive");
  set("limbs", ({ "头部", "身体", "前脚", "後脚", "尾巴" }));
  set("verbs", ({ "bite", "claw" }));

  set("chat_chance", 15);
  set("chat_msg", ({
    "野狗向你疯狂的哮道：呜汪！呜汪！呜汪！呜汪！",
  }));
  set("chat_msg_combat", ({
    "野狗向你疯狂的哮道：呜汪！呜汪！呜汪！呜汪！",
  }));
  set("chat_msg", ({
    (: random_move :)
  }));

  set("combat_exp", 5000);
  set("bellicosity", 3000);

  set_temp("apply/attack", 10);
  set_temp("apply/armor", 40);

  setup();
}
