// hjiaren.c
#include <ansi.h>
inherit NPC;


void do_permit();
create() {
  set_name("游客", ({ "youke" }));
  set("gender", "男性");
  set("long", "一个游山玩水的人\n");
  set("age", 20);
  set("attitude", "friendly");
  set("combat_exp", 1800);
  set("score", 200);
  set_skill("parry", 15);
  set_skill("unarmed", 15);
  set_skill("dodge", 15);
  setup();
  carry_object("/obj/cloth");
}

int accept_fight(object ob) {
  return 1;
}
