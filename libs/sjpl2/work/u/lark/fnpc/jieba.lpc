// boaer.c

inherit NPC;

void create() {
  set_name("街霸", ({ "jie ba", "jie" }));
  set("long", "一个街头的流氓头目\n");

  set("age", 37);
  set("max_kee", 800);
  set("max_force", 1000);
  set("force_factor", 1);
  set("water", 600);
  set("food", 600);
  set_skill("unarmed", 70);
  set_skill("dodge", 70);
  set_skill("force", 70);
  set("combat_exp", 50000);
  set("chat_chance", 30);

  set("chat_msg", ({
    "街霸冷冷的看着你\n",
  }));
  setup();
  carry_object("/obj/cloth")->wear();


}


int accept_fight(object ob) {
  return 1;
}
