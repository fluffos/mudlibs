// hjiaren.c
#include <ansi.h>
inherit NPC;


void do_permit();
create() {
  set_name("书生", ({ "shu sheng", "sheng" }));
  set("gender", "男性");
  set("long", "他看起来文质彬彬\n");
  set("age", 25);
  set("attitude", "friendly");
  set("combat_exp", 1500);
  set("score", 500);

  set_skill("unarmed", 10);
  set_skill("dodge", 10);

  setup();
  carry_object("/obj/cloth");
}
