//changan city
#include <ansi.h>
inherit ROOM;
int zet(object who);
void create() {
  set("short", HIW "黑松林" NOR);
  set("long", @LONG
黑松林的枝叶森罗密布遮盖了天日,三步之内即不见五指,
松涛的声响宛若波浪汹涌,阵阵寒气从四周的林逢间透射
出来,那里似乎有什么东西注视着你.
LONG);


  set("exits",
    ([  //sizeof() == 4
    "northeast": __DIR__ "luan4",
      "south": __DIR__ "luan2",
    ]));




  set("outdoors", "hongnong");
  set("no_clean_up", 0);
  setup();

}

void init() {
  int n;
  object ob;
  object tiger, zei, wolf;
  //  object *gold;
  //  gold=all_inventory(this_player());
  //    if( !interactive(ob = this_player()) && !living(this_player())) return;   

  zei = present("zei", environment(this_player()));
  wolf = present("wolf", environment(this_player()));
  tiger = present("tiger", environment(this_player()));
  if ((objectp(tiger)) || (objectp(wolf)) || (objectp(zei))) return;

  n = random(10);
  //  write(HIW "this is" NOR+n);
  if (n == 1) {
    //    for(i=sizeof(gold)-1; i>=0; i--) {
    //    if(gold[i]->query("name")=="黄金") continue;

    message_vision(HIR "突然从树后跳出个白衣贼人对着$N大喝道:老子就是羊鸣塞的英雄,锄恶济贫\n"
      "行侠仗义,最近大爷们手头紧,阁下能否孝敬一二?\n" NOR, this_player());

    ob = new(__DIR__ "npc/dao");
    ob->move(environment(this_player()));


    this_player()->set("noway", 1);
    ob->set("luan", 1);
    return;
    //  }
  }
  if (n == 2) {
    message_vision(HIR "突然从树丛里窜出一条灰毛饿狼,猛的扑向$N\n" NOR, this_player());
    ob = new("/u/lark/xiaoyao/npc/wolf");
    ob->move(this_object());
    ob->set_leader(this_player());
    ob->set("luan", 1);
    ob->kill_ob(this_player());
    return;
  }
  if (n == 3) {
    message_vision(HIR "猛然从林子后面冲出一条猛虎,张开血盆大口咬向$N的喉咙\n" NOR, this_player());
    ob = new("/u/poor/gaibang/jigong/npc/tiger.lpc");
    ob->move(this_object());
    ob->set_leader(this_player());
    ob->set("luan", 1);
    ob->kill_ob(this_player());
    return;
  }
}

int valid_leave(object me, string exit) {
  object ob;
  if (this_player()->query("noway") && ob = present("zei ren", this_object())) {
    message_vision("贼人一声冷笑:想走没那么容易!\n", this_player());
    ob->set_leader(this_player());
    ob->kill_ob(this_player());
    return 0;
  }
  return 1;
}
