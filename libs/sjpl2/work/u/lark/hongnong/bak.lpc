//changan city

inherit ROOM;

void create() {
  set("short", "乱石岗");
  set("long", @LONG
一片片参差不齐的卵石一簇簇的散布在一个黄土小岗上.
黑松林在有风吹过的时候发出沙沙的响声,显得阴森,看来
并非善地,还是离开比较好.路边的草丛里有一块衫木版(ban)
好象贴着什么东西.       
LONG);

  set("item_desc", ([
    "ban": @TEXT
              通告
   此地乃贼人,野兽出没之地,
   过往客商,请绕道而行.
   否则所出意外概不负责.
                 兵部弘农大营立
TEXT,
  ]));

  set("exits",
    ([  //sizeof() == 4
    "west": __DIR__ "luan4",
      "eastdown": __DIR__ "road4",
    ]));

  //         set("objects", 
  //           ([ //sizeof() == 1
  //               "/u/lark/fnpc/tiaofu" : 2,

  //        ]));


  set("outdoors", "hongnong");
  set("no_clean_up", 0);
  setup();

}

void init() {
  object wolf, tiger;
  if (objectp(wolf))
    destruct(wolf);
  if (objectp(tiger))
    destruct(tiger);
}
