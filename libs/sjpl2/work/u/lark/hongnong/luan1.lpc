//changan city
#include <ansi.h> 
inherit ROOM;

void create ()
{
        set ("short", "乱石岗");
        set ("long", @LONG
一片片参差不齐的卵石一簇簇的散布在一个黄土小岗上.
黑松林在有风吹过的时候发出沙沙的响声,显得阴森,看来
并非善地,还是离开比较好.路边的草丛里有一块衫木版(ban)
好象贴着什么东西.       
LONG);

        set("item_desc",([
"ban":@TEXT
              通告
   此地乃贼人,野兽出没之地,
   过往客商,请绕道而行.
   否则所出意外概不负责.
                 兵部弘农大营立
TEXT,
]));

         set("exits", 
        ([ //sizeof() == 4
                "northeast": __DIR__"luan2",
                "southdown" : __DIR__"road3",
        ]));


//         set("objects", 
//           ([ //sizeof() == 1
//               "/u/lark/fnpc/tiaofu" : 2,
                
//        ]));


        set("outdoors", "hongnong");
        set("no_clean_up", 0);
        setup();
 
}
 int valid_leave(object me,string dir)
{
        object wolf,tiger;
        wolf=present("wolf",environment(me));
        tiger=present("tiger",environment(me));
        if ( (dir=="southdown") && (objectp(tiger)) ) {
        message_vision(HIR "老虎恶狼悻悻的窜回到了树林里\n" NOR,this_player());
        destruct(wolf);
        return 1;
        }
       if ( (dir=="southdown") && (objectp(wolf)) ) {
       message_vision(HIR "灰毛恶狼一声长嚎,消失在了林子深处\n" NOR,this_player());
       destruct(tiger);
       return 1;
       }
       return 1;

}
      

