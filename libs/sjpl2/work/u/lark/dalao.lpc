#include <ansi.h>
inherit ROOM;
void test_me(object me);
void create() {
  set("short", CYN "海青大牢" NOR);
  set("long", @LONG
漆黑的四壁,剥落的墙皮,从三丈高的大墙上的天窗上透露一丝阴暗的光,
依稀可以看见几个红漆大字
          坦白从宽     抗拒从严
LONG
  );
  //         set("valid_startroom", 1);

  set("no_fight", 1);
  set("no_magic", 1);
  set("no_study", 1);
  set("no_steal", 1);
  set("no_spells", 1);
  setup();
}

void init() {
  object ob;
  add_action("do_quit", "quit");
  add_action("do_sjpl", "sjpl");
  add_action("do_chat", "chat");
  add_action("do_tell", "tell");

  if (interactive(ob = this_player()))
    test_me(ob);
}

int do_quit() { return 1; }
int do_sjpl() { return 1; }
int do_chat() { return 1; }
int do_tell() { return 1; }

void test_me(object me) {
  me->set_temp("old_startroom", me->query("startroom"));
  me->set("startroom", __FILE__);
  if (!wizardp(me))
    me->set_temp("block_msg/all", 1);
}
