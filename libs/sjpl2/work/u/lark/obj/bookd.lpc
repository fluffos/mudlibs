// unarmed_b.c
#include <skill.h>
inherit ITEM;

void create() {
  set_name("后汉书", ({ "book" }));
  set_weight(600);

  set("unit", "本");
  set("long",
    "《后汉书》通过对汉朝的兴衰的总结，为官的道理。。。\n");
  set("material", "paper");
  set("skill", ([
    "name": "officialism",
    "exp_required": 10000,
    "sen_cost": 30,
    "difficulty": 30,

    "max_skill": 70,
  ]));
}
