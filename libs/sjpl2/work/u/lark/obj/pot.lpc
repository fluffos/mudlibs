// teapot.c

inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name("水缸", ({ "pot" }));
  set_weight(500);
  set("no_get", 1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一个盛满清水的大缸\n");
    set("unit", "个");
    set("value", 30);
    set("max_liquid", 10000000);
  }

  // The liquid contained in the container is independent, we set a copy
  // in each cloned copy.
  set("liquid", ([
    "type": "water",
    "name": "清水",
    "remaining": 100,
    "drunk_apply": 100,
  ]));
}
