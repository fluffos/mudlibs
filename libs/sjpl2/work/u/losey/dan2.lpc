//baicaodan.c

#include <ansi.h>


inherit ITEM;

void create() {
  set_name(HIC "百草丹" NOR, ({ "dan" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      GRN "这就是峨眉派怡然师太研制出来的可以增长内力的神丹,百草丹.\n" NOR);
    set("unit", "颗");
    set("value", 400000);
  }
}
void init() {
  add_action("eat_dan", "eat");
}
int eat_dan(string arg) {
  int m_kee;
  int m_sen;
  int m_gin;
  int m_force;
  object me;
  int score, pot;
  me = this_player();
  score = (int)me->query("max_force");
  pot = (int)me->query("force");

  if (arg == "dan") {
    m_kee = this_player()->query("max_kee");
    m_sen = this_player()->query("max_sen");
    m_gin = this_player()->query("max_gin");
    m_force = this_player()->query("max_force");
    message_vision(GRN "$N狼吞虎咽的吃了一颗百草丹,只觉得一股热流在丹田处乱窜。\n" NOR, this_player());
    this_player()->set("eff_kee", m_kee);
    this_player()->set("kee", m_kee);
    this_player()->set("eff_gin", m_gin);
    this_player()->set("gin", m_gin);
    this_player()->set("eff_sen", m_sen);
    this_player()->set("sen", m_sen);
    this_player()->set("force", m_force);
    this_player()->set("food", 200);
    this_player()->set("water", 200);
    me->set("max_force", (int)score + 1);
    me->set("force", (int)pot + 1);
    destruct(this_object());
    return 1;
  }
  return 0;
}
