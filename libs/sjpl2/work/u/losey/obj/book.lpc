// book.c

inherit ITEM;

void create() {
  int i;

  string *names = ({
    "「鞭法入门」", "「内功简介」", "「拳法入门」", "「刀法简介」",
    "「拆招秘决」", "「法术指南」", "「暗器秘要」"
  });

  string *skills = ({
    "whip", "force", "unarmed", "blade", "parry", "spells", "throwing"
  });

  i = random(7);
  set_name(names[i], ({ "book" }));
  set_weight(100);
  set("unit", "本");
  set("long", "这是一本修练基本武功的书籍。\n");
  set("skill", ([
    "name": skills[i],
    "exp_required": 100000,
    "sen_cost": 20,
    "difficulty": 20,
    "max_skill": 150,

  ]));
}
