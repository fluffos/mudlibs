#include <ansi.h>
inherit ITEM;
void create() {
  set_name("破纸", ({ "pozhi", "zhi" }));
  set_weight(500);
  set_max_encumbrance(400);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("long", HIW "余乃峨眉派第十五代掌门人怡然师太，\n
余平生所好乃炼制各种丹药，但多年来因为本派教务所限，\n
一直未能得偿所愿，幸余徒得吾真传，且青出于蓝而胜于蓝\n
，终使余放心将本派掌门之位传之。余自卸任掌门人之位后\n
便独自一人隐居于此，一心炼制丹药，经余多年研究终研制\n
成一种可增长内力之神丹，余取名为百草丹，但由于余多年\n
苦思冥想，所耗精力甚巨，自知大限将至，已不及将百草丹\n
传于吾门人，乃留书于此，望有缘者得之。\n

百草丹配方：需白莲藕、乌龙白凤汤、紫色小草、野生鹿茸、\n
松蘑、鸟蛋，在此锅中炼即得。
\n" NOR);
    set("value", 1);
  }
}
int is_container() { return 1; ; }
