inherit ROOM;

void create() {
  set("short", "随心堂后院");
  set("long", @LONG
 出了随心大殿，这里就是通往四大分部的主要道路了，后院里种了好些梧桐
和茶花，茶花不喜阳光直射，所以都种在树阴下，现在正是开花的时节，满园芳
香，虽说这里没有什么特别好的品种，但像“抓破美人脸”和“落第秀才”之类
的二流品种还是有的。往北便天部所在，东西则是地部和人部，随心堂魔部坐落
在西南方。
LONG
  );
  set("exits", ([
    "east": __DIR__ "srge",
    "west": __DIR__ "sdge",
    "south": __DIR__ "sxdian",
    "north": __DIR__ "stge",
    "southwest": __DIR__ "road2",
    "northwest": __DIR__ "yujroom",



  ]));

  setup();

}
