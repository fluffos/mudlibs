inherit ROOM;

void create() {
  set("short", "走廊");
  set("long", @LONG
    这里是通往拱猪房的走廊，四周墙壁上贴着文人墨客们写的字画
，你只听见楼上传来阵阵说笑的声音,你不禁加快了脚步。

LONG
  );

  set("exits", ([
    "up": "/u/losey/piggy",
    "out": "/u/losey/bedroom",
  ]));
  set("outdoors", "changan");
  setup();
  replace_program(ROOM);
}
