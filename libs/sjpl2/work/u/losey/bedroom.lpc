#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "浮云阁");
  set("long", @LONG 
这里是醉梦山庄庄主随意休息的房间。轻柔的丝竹之声在房间里飘荡，
随意正躺在一张大大的床上小憩，旁边的两位丫鬟正在给随意扇风、
按摩。睡梦中随意那张英俊潇洒的脸上，露出幸福，满足的微笑。墙
上挂着几幅出自随意之手的字画(picture1,2)，墙的两边是一副对
联(duilian),显示出主人的文武全才。
LONG);
  //set("valid_startroom",1);
  set("no_steal", "1");
  set("exits", ([ /* sizeof() == 2 */
    /*
"huayuan": "/u/losey/huayuan",
  "down" : "/d/city/ciensi",
"piggy":"/u/losey/piggy",
"xueshan" : "/u/baiwt/xueshan/tudimiao",
"shaolin" : "/u/tian/shaolin/dcdian",
"taohua" :"/u/taohua/dating",
"maoshan" :"/u/maoshan/temple1",
"qingcheng" :"/u/qingcheng/shangqing",
"gaibang" :"/u/poor/gaibang/gbtqt",
"emei" :"/u/emei/qingyinge",
"wudang" : "/u/wudang/sqdian",
"youming" : "/u/baiwt/xueshan/ghost/yougu",
"xiaoyao" : "/u/lark/xiaoyao/player",
*/
  ]));

  set("item_desc", ([
    "duilian": HIC "\n      人生在世不称意，\n\n\n      明朝散发弄扁舟。\n" NOR,
    "picture1": HIR
    "      ****           ****     ****           ****\n"
    "    *********     ********* *********     *********\n"
    "  ************* *********************** *************\n"
    " *****************************************************\n"
    " ************" HIW "心 心" HIR "*******************" HIW "心 心" HIR "************\n"
    "  ***********" HIW "相 映" HIR "*******************" HIW "相 映" HIR "***********\n"
    "   *************************************************\n"
    "     *********************   *********************\n"
    "       *****************       *****************\n"
    "        *************           *************\n"
    "          *********               *********\n"
    "            *****                   *****\n"
    "              *                       *\n" NOR,

    "picture2": HIW
    "　　　　　　　　　　　　　　　******\n"
    "　　　　　　　　　　　　　　　　*　*\n"
    "　　　　　　　　　　　　　　　*　　*\n"
    "　　　　　　　　　　　　　　*           " HIR "一" HIW " \n"
    "　　　　　　　　　　　　　*     \n"
    "　　　　　 　　　　　　*                " HIR "箭" HIW " \n"
    "　　　　　　　 *******    \n"
    "　　　　　　*******　*                   " HIR "钟" HIW " \n"
    "　　　　 *******　*　*\n"
    "　　　*******　*　*　*                  " HIR "情" HIW " \n"
    "　　　 　　　*　*　*　    \n"
    "　　　 　　　*　*\n"
    "　　　　　　 *\n" NOR,

  ]));
  setup();
}
void init() {
  add_action("do_press", "press");

}

int do_press(string arg) {

  if (arg == "绿键") {
    message_vision(HIC "$N走到电梯门前,在绿色键上按了一下，\n只听嘎的一声，电梯门缓缓的打开，你走了进去。\n" NOR, this_player());
    this_player()->move("/u/losey/dianti");
  } else write("你想按什么？\n");
  return 1;
}
