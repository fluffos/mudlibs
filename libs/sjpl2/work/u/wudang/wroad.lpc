// Room: /u/wudang/wroad.c

inherit ROOM;

void create() {
  set("short", "小径");
  set("long", @LONG
这是复真观和玄武门之间的一条小径。几个书童正抱着一大堆经书从你的
身旁擦过。东面是玄武门，西面是复真观。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "west": __DIR__ "fuzhen1",
    "east": __DIR__ "xuanwumen",
  ]));
  set("outdoors", "wudang");
  set("objects", ([
    __DIR__ "npc/shouzhenzi": 1,
  ]));

  setup();
}
int valid_leave(object me, string dir) {
  object ob;
  if (dir == "west" && present("shouzhen zi", environment(me)) &&
    me->query("class") != "wudang")
    return notify_fail("守真子一手拦住，恭身说道：“西面是我派重地，恕不接待外来人士！”\n");
  return ::valid_leave(me, dir);
}
