#include <ansi.h>
string reward_more(object who);

inherit NPC;
void create() {

  set_name("武当弟子", ({ "wudang dizi", "dizi" }));
  set("long", "这是一位武当弟子，专门担任保护之责。\n");
  set("attitude", "friendly");
  set("max_atman", 100);
  set("atman", 100);
  set("max_mana", 100);
  set("mana", 100);

  set("str", 20);
  set("cor", 30);
  set("cps", 25);

  set("combat_exp", 90000);
  set_skill("sword", 30);
  set_skill("parry", 30);
  set_skill("dodge", 30);
  set_skill("unarmed", 30);
  set_skill("force", 30);

  set_skill("tiyunzong", 30);
  set_skill("taiji-ken", 30);
  set_skill("taiji-sword", 30);
  set_skill("taiji-force", 30);

  map_skill("force", "taiji-force");
  map_skill("unarmed", "taiji-ken");
  map_skill("dodge", "tiyunzong");
  map_skill("parry", "taiji-sword");
  map_skill("sword", "taiji-sword");
  set("chat_chance", 10);
  set("chat_msg", ({
    (: random_move :)
  }));
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: reward_more(this_object()) :),
  }));
  setup();
  //        carry_object("/obj/longsword")->wield();
  carry_object(__DIR__ "obj/daopao")->wear();
}

string reward_more(object who) {
  int i;
  object *enemy;
  seteuid(getuid());
  enemy = who->query_enemy();
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      if (enemy[i]->query("combat_exp") < 50000) return "1";
      if (enemy[i]->query("combat_exp") > 90000) return "1";
      enemy[i]->add("combat_exp", 1);
      if (enemy[i]->query("potential") - enemy[i]->query("learned_points") > 900) return "1";
      if (random(9) < 5)
        enemy[i]->add("potential", 1);
      else
        enemy[i]->add("life_exp", 1);
    }
  }
  return "1";
}
int accept_fight(object me) {
  return 1;
}
