#include <ansi.h>
int do_detect(object me);

inherit NPC;
void create() {

  set_name("武当弟子", ({ "wudang dizi", "dizi" }));
  set("long", "这是一位武当弟子，专门担任保护之责。\n");
  set("attitude", "friendly");
  set("max_atman", 100);
  set("atman", 100);
  set("max_mana", 100);
  set("mana", 100);

  set("str", 40);
  set("cor", 30);
  set("cps", 25);
  set("food", 500);
  set("water", 500);

  set("combat_exp", 90000);
  set_skill("sword", 30);
  set_skill("parry", 30);
  set_skill("dodge", 30);
  set_skill("unarmed", 30);
  set_skill("force", 30);

  set_skill("tiyunzong", 30);
  set_skill("taiji-ken", 30);
  set_skill("taiji-sword", 30);
  set_skill("taiji-force", 30);

  map_skill("force", "taiji-force");
  map_skill("unarmed", "taiji-ken");
  map_skill("dodge", "tiyunzong");
  map_skill("parry", "taiji-sword");
  map_skill("sword", "taiji-sword");
  set("chat_chance", 50);
  set("chat_msg", ({
    (: do_detect :),
  }));
  setup();
  carry_object("/obj/longsword")->wield();
  carry_object(__DIR__ "obj/daopao")->wear();
}
int do_detect(object me) {
  string str;
  //	object owner, player;
  me = this_object();
  //	owner = me->query("possessed");
  if (me->query("water") < 1) {
    me->dismiss_team();
    destruct(me);
    return 1;
  }
  return 1;
}
