inherit NPC;
inherit F_MASTER;
string summon_more(object who);

void create() {
  set_name("守真子", ({ "shouzhen zi", "shouzhen", "master" }));
  set("gender", "男性");
  set("age", 35);
  set("long",
    "守真子是武当派第六代弟子中比较杰出的人物。\n");
  set("inquiry", ([
    "here": "这里是闻名天下的武当山。",
  ]));
  set("attitude", "peaceful");
  set("str", 60);
  set("int", 30);
  set("cor", 30);
  set("spi", 30);
  set("class", "wudang");

  set("max_kee", 1500);
  set("max_gin", 1500);
  set("max_sen", 1500);
  set("kee", 1500);
  set("gin", 1500);
  set("sen", 1500);

  set("force", 1500);
  set("max_force", 1500);
  set("force_factor", 20);

  set("combat_exp", 2500000);
  set("score", 20000);

  set_skill("move", 90);
  set_skill("dodge", 90);
  set_skill("literate", 90);
  set_skill("unarmed", 110);
  set_skill("parry", 100);
  set_skill("force", 100);
  set_skill("sword", 90);

  set_skill("taiji-sword", 90);
  set_skill("taiji-ken", 110);
  set_skill("taiji-force", 100);
  set_skill("tiyunzong", 90);

  map_skill("dodge", "tiyunzong");
  map_skill("unarmed", "taiji-ken");
  map_skill("parry", "taiji-sword");
  map_skill("force", "taiji-force");
  map_skill("sword", "taiji-sword");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed.nian" :),
    (: summon_more(this_object()) :),
  }));

  create_family("武当派", 6, "弟子");

  setup();

  //        carry_object("obj/longsword")->wield();
  carry_object(__DIR__ "obj/daopao")->wear();
}

void attempt_apprentice(object ob) {
  if (ob->query("class") != "wudang") {
    command("say 这位" + RANK_D->query_respect(ob) + "还是去拜贫道的弟子吧。\n");
    return;
  }

  if (ob->query_skill("taiji-force", 1) < 50) {
    command("say 你的太极神功修为尚浅，拜师之事还是以后再说吧。\n");
    return;
  }
  if (ob->query_skill("taiji-ken", 1) < 50) {
    command("say 你的太极拳法修为尚浅，拜师之事还是以后再说吧。\n");
    return;
  }
  command("smile");
  command("say 好吧，" + RANK_D->query_respect(ob) + "以后要更加勤习武功，把武当发扬光大！\n");
  command("recruit " + ob->query("id"));
}

void recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "wudang");
  ob->set("id_type", 1);
}
string summon_more(object who) {
  int i;
  object *enemy;
  object another;
  seteuid(getuid());
  another = new(__DIR__ "wddizi2");
  if ((int)who->query_temp("summon_more") > 2) return "　";
  another->move(environment(who));
  message_vision(another->name() + "走了过来。\n"
    , this_object());
  who->add_temp("summon_more", 1);
  enemy = who->query_enemy();
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      another->kill_ob(enemy[i]);
      enemy[i]->kill_ob(another);
      another->set_leader(enemy[i]);
    }
  }
  return "　";
}
int accept_fight(object me) {
  command("say 请不要在这里惹是生非。");
  return 0;
}
