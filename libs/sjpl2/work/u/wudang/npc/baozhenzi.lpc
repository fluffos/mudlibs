#include <ansi.h>

inherit NPC;
inherit F_MASTER;
int about_quest();

void create() {
  set_name("抱真子", ({ "baozhen zi", "baozhen", "master" }));
  set("gender", "男性");
  set("age", 46);
  set("long",
    "抱真子是武当派第六代弟子中比较杰出的人物。\n");
  set("inquiry", ([
    "here": "这里是闻名天下的武当山。",
    "五行剑阵": (: about_quest :),
    "进阵": (: about_quest :),
    "闯阵": (: about_quest :),
  ]));
  set("attitude", "peaceful");
  set("str", 30);
  set("int", 30);
  set("cor", 30);
  set("spi", 30);
  set("class", "wudang");

  set("max_kee", 1500);
  set("max_gin", 1500);
  set("max_sen", 1500);
  set("kee", 1500);
  set("gin", 1500);
  set("sen", 1500);

  set("force", 1500);
  set("max_force", 1500);
  set("force_factor", 20);

  set("combat_exp", 3000000);
  set("score", 20000);

  set_skill("move", 110);
  set_skill("dodge", 100);
  set_skill("literate", 90);
  set_skill("unarmed", 70);
  set_skill("parry", 90);
  set_skill("force", 100);
  set_skill("sword", 100);

  set_skill("taiji-sword", 110);
  set_skill("taiji-ken", 70);
  set_skill("taiji-force", 110);
  set_skill("tiyunzong", 110);

  map_skill("dodge", "tiyunzong");
  map_skill("unarmed", "taiji-ken");
  map_skill("parry", "taiji-sword");
  map_skill("force", "taiji-force");
  map_skill("sword", "taiji-sword");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "sword.chan" :),
    (: perform_action, "sword.fengbi" :),
  }));

  create_family("武当派", 6, "弟子");

  setup();

  carry_object("obj/longsword")->wield();
  carry_object(__DIR__ "obj/daopao")->wear();
}
void init() {
  add_action("do_gogo", "go");
}

int do_gogo(string arg) {
  object me;
  me = this_player();
  if (arg == "east") {
    command("say 这是本派五行剑阵，请勿乱闯！\n");
    write("这个方向的路被抱真子挡住了 。\n");
    return 1;
  } else
    return 0;
}
int about_quest() {
  object me = this_player();
  /*
	if( this_object()->query_temp("wudang/counter") )
	{
	command("say 有人正在闯阵，请明天再来。\n");
	return 1;
	}
*/
  if (me->query("id_type") == 2) {
    command("say 嘿嘿，正邪势不两立，你要来破阵，且看你有没有这个本事！\n");
    me->move("/u/wudang/wuxing");
    message_vision(HIR "\n抱真子领$N进入了五行剑阵，随后冷笑着走开了。\n" NOR, me);
    this_object()->set_temp("wudang/counter", 1);
    return 1;
  }
  if (me->query("class") != "wudang") {
    command("say 这是本派五行剑阵，非武当弟子请勿入内！\n");
    return 1;
  }
  if ((int)me->query("combat_exp") < 600000) {
    command("say 你的武功太差了，进入本派五行剑阵会有性命危险！\n");
    return 1;
  }
  if ((int)me->query("combat_exp") > 1000000) {
    command("say 你武艺超群，闯本派五行剑阵已经没有意义了！\n");
    return 1;
  } else {
    command("say 难得你有这般胆识，那就进去闯一闯吧！\n");
    me->set_temp("wudang/jianzhen", 1);
    me->move("/u/wudang/wuxing");
    this_object()->set_temp("wudang/counter", 1);
    message_vision(CYN "\n抱真子领$N进入了五行剑阵，随后微笑着走开了。\n" NOR, me);
    return 1;
  }
  return 1;
}

void attempt_apprentice(object ob) {
  if (ob->query("class") != "wudang") {
    command("say 这位" + RANK_D->query_respect(ob) + "还是去拜贫道的弟子吧。\n");
    return;
  }

  if (ob->query_skill("taiji-force", 1) < 70) {
    command("say 你的太极神功修为尚浅，拜师之事还是以后再说吧。\n");
    return;
  }
  if (ob->query_skill("taiji-sword", 1) < 70) {
    command("say 你的太极剑法修为尚浅，拜师之事还是以后再说吧。\n");
    return;
  }
  command("smile");
  command("say 好吧，" + RANK_D->query_respect(ob) + "以后要更加勤习武功，把武当发扬光大！\n");
  command("recruit " + ob->query("id"));
}

void recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "wudang");
  ob->set("id_type", 1);
}
int accept_fight(object me) {
  command("say 请不要在这里惹是生非。");
  return 0;
}
