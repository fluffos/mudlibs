inherit NPC;

void create() {
  set_name("女道童", ({ "daotong" }));
  set("title", "武当派");
  set("gender", "女性");
  set("age", 15);
  set("long",
    "一个眉清目秀的小女孩，还带着几分天真烂漫。\n");
  set("inquiry", ([
    "here": "这里是闻名天下的武当山。",
  ]));
  set("attitude", "peaceful");
  set("str", 26);
  set("int", 22);
  set("spi", 25);
  set("per", 23);
  set("cps", 23);
  set("water", 300);
  set("food", 300);
  set("force", 100);
  set("max_force", 100);
  set("force_factor", 1);
  set("combat_exp", 300 + random(300));

  set_skill("unarmed", 20);
  set_skill("sword", 20);
  set_skill("force", 10);
  set_skill("parry", 20);
  set_skill("dodge", 10);

  set_skill("taiji-ken", 20);
  set_skill("taiji-force", 10);
  set_skill("tiyunzong", 10);

  map_skill("unarmed", "taiji-ken");
  map_skill("force", "taiji-force");

  set("chat_chance", 10);
  set("chat_msg", ({
    (: random_move :)
  }));

  setup();

  carry_object(__DIR__ "obj/wood_sword")->wield();
  carry_object(__DIR__ "obj/daopao")->wear();
}
