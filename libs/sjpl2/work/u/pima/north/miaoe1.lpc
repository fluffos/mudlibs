inherit ROOM;

void create() {
  set("short", "莽林边缘");
  set("long", @LONG
越走树林越密，树缝中洒下来的阳光也变得斑斑点点。茅草渐厚，灌木
丛生，路径漫灭。吹来的风也越发的阴冷潮湿。远方密林的天空上有几只盘
旋的秃鹰，发出撕心裂肺的叫声，令人毛骨耸然。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "west": __DIR__ "edge3",
  ]));
  set("outdoors", "manglin");
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "obj/hole": 1,
  ]));
  setup();
  //        replace_program(ROOM);
}
void reset() {
  object con, item, *inv;
  ::reset();
  if (con = present("hole", this_object()))
    if (inv = all_inventory(con))
      if (!sizeof(inv)) {
        item = new(__DIR__ "obj/shilianbox.lpc");
        item->move(con);
      }
}
