// banker.c

#include <ansi.h>

inherit NPC;
inherit F_BANKOWNER;

void create() {
  set_name("董阴曹", ({ "dong yincao", "dong", "boss" }));
  set("gender", "男性");
  set("age", 37);

  set("str", 62);
  set("cor", 30);
  set("cps", 30);
  set("int", 26);
  set("per", 23);
  set("con", 24);
  set("spi", 30);
  set("kar", 25);
  set("no_arrest", 1);
  set("combat_exp", 2000000);
  set("attitude", "friendly");
  create_family("披麻教", 2, "护法");
  set("class", "pima");

  set("max_kee", 1200);
  set("eff_kee", 800);
  set("max_force", 1000);
  set("force", 1000);
  set("force_factor", 3);
  set("max_mana", 1000);
  set("mana", 1000);
  set("mana_factor", 3);
  set_skill("move", 100);
  set_skill("parry", 100);
  set_skill("stick", 100);
  set_skill("unarmed", 100);
  set_skill("kusang-bang", 70);
  set_skill("black_claw", 90);
  set_skill("dodge", 100);
  set_skill("force", 100);
  set_skill("blood_force", 100);
  set_skill("literate", 40);
  set_skill("cursism", 100);
  set_skill("celecurse", 100);
  map_skill("force", "blood_force");
  map_skill("cursism", "celecurse");
  map_skill("unarmed", "black_claw");
  map_skill("stick", "kusang-bang");
  set("chat_chance_combat", 30);
  set("chat_msg_combat", ({
    (: command, "curse redblood" :),
  }));
  set("inquiry", ([
    "存款": "看看树上挂的牌子就知道了（look sign）。\n",
    "存钱": "看看树上挂的牌子就知道了（look sign）。\n",
  ]));
  setup();

  carry_object("/obj/cloth")->wear();
}

void init() {
  ::init();
  add_action("do_convert", "convert");
  add_action("do_deposit", "deposit");
  add_action("do_balance", "balance");
  add_action("do_withdraw", "withdraw");
  // add_action("do_loan","loan");
}
