inherit ROOM;

void create() {
  set("short", "农田");
  set("long", @LONG
稻田里金灿灿的稻穗迎风摇摆．一片一片的农田连结成网，小沟小渠
密布其中．
LONG
  );

  set("exits", ([
    "north": __DIR__ "daotian2",
    "south": __DIR__ "tulu",
  ]));
  set("objects",
    ([  //sizeof() == 1
    "/obj/npc/worker2": 2,
    ]));
  set("hell", 1);
  set("no_fight", 1);
  set("no_study", 1);
  set("no_magic", 1);
  set("NONPC", 1);
  set("outdoors", "xueshan");
  setup();
}

int valid_leave(object me, string dir) {

  if (me->query_temp("doing_work") <= 1)
    return notify_fail("你的工作还没有完成，怎么就想走了？\n");
  me->set_temp("doing_work", 0);
  return ::valid_leave(me, dir);
}
