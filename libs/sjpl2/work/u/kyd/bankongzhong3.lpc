inherit ROOM;
void create() {
  set("short", "半空中");
  set("long", @LONG
你现在是在半空中，身子还在不停的往下坠，虽然心中充满了恐惧和后悔，
但到了此时此刻也只能听天由命了。
LONG
  );
  set("outdoors", "quanzhen");
  setup();
}

void init() {
  if (interactive(this_player()))
    call_out("do_flush", 3, this_player());

}

void do_flush(object me) {
  object room;
  me = this_player();

  if (!me || environment(me) != this_object())
    return;
  if (me->query_temp("fu_dan")) {
    tell_object(me, "。。。。。。\n");
  } else {
    tell_object(me, "耳边都是呼呼的风声，你的身体不停的往下坠。。。。。。\n");
  }
  room = load_object(__DIR__ "bankongzhong4");
  me->move(room);
  //	me->die();
}
