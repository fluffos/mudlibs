#include <room.h>
inherit ROOM;

void create() {
  set("short", "潭底");
  set("long", @LONG
一只八丈来大的章鱼就在你的面前，正用它那双血红的大眼睛盯着你。它仿
佛已经把你看做是它的点心。你已经没有了退路，不是你杀死他，就是你变成他
的点心。在它的身后好象有个洞穴，但被它遮住了，你无法看清到底是什么。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "enter": __DIR__ "bydt",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "全真教");
  set("objects", ([
    (__DIR__ "npc/zhangyu"): 1,
  ]));

  setup();

}
int valid_leave(object me, string dir) {
  object ob;
  if (dir == "enter" && ob = present("zhang yu", this_object())) {
    return notify_fail("这个方向的路被" + ob->name() + "挡住了 。\n");
  }
  return 1;
}
