#include <ansi.h>
#include <combat.h>

inherit SSERVER;
int perform(object me, object target) {
  int damage, attack, dodge, i, j;
  string msg;
  object ob, weapon;
  i = me->query_skill("quanzhen-jian") / 2;
  j = me->query_skill("sword") / 2;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("[刀人和一]只能对战斗中的对手使用。\n");

  if ((int)me->query_skill("qisha-daofa", 1) < 200)
    return notify_fail("你的七杀刀法火侯不够，不能使用[刀人和一]。\n");
  if ((int)me->query_skill("blade", 1) < 200)
    return notify_fail("你的基本刀法不够娴熟，不能用[刀人和一]。\n");
  if ((int)me->query("max_force") < 1500)
    return notify_fail("你现在内力太弱，不能使用[刀人和一]。\n");
  if ((int)me->query("force") < 700)
    return notify_fail("你的真气不足，不能使用[刀人和一]。\n");
  if ((int)me->query("bellicosity") < 500000)
    return notify_fail("你的杀气不够，无法使出[刀人和一]。\n");


  msg = HIY "     $N使出一招「网凝红」猛的推展，而「飞千流」「血染刃」「侧夺魄」叁式\n" +
    "并为一招倏施向左，「尘归土」「星落寂」「七欲减」「九泉水」融合着齐出向\n" +
    "右，八式惊鬼泣神的刀招交织成漫天盖地的金光刀流，无尽无绝的纵横飞旋，有\n" +
    "如烈阳的毫光万道逼射，又像天河的群星崩落，彷佛长江的水流咆哮，宛如东海\n" +
    "的浪涛号哭，空气互相凝荡排挤，发出惊心动魄的狂啸，四周的每一处空间，每\n" +
    "一分隙缝，都完全被刀刃的光彩布满，都完全被耀眼的光芒充斥，而在此时，$N\n" +
    "「七杀刀法」中的最後一式「金轮渺」也在他猝然仰身下施展而出。\n" NOR;

  message_vision(msg, me, target);

  me->add_temp("apply/attack", i);

  msg = HIY "网凝红" NOR;
  msg += HIY "飞千流" NOR;
  msg += HIY "血染刃" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIY "倒夺魄" NOR;
  msg += HIY "尘归土" NOR;
  msg += HIY "星落寂" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIY "七欲减" NOR;
  msg += HIY "九泉水" NOR;
  msg += HIY "金轮渺" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);

  me->add_temp("apply/attack", -i);
  me->add("force", -900 - random(((me->query_skill("force") + (j + i))) / 3));
  me->add("gin", -150 - random(i + j) / 4);
  me->start_busy(6);
  target->start_busy(1);

  return 1;

}
