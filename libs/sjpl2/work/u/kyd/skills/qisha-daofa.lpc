#include <ansi.h>

inherit SKILL;
mapping *action = ({
  ([ "action": HIY "$N蓦然长笑如雷，弹跃而起，一招「血染刃」手中$w滚动着层层重重的辉流由空中压砍而下，\n" +
    "「削」「削」的锋刃似缠身的厉鬼，一次次的在$n的要害险险擦遇，一连串的金铁交击之声衬\n" +
    "着$n流淌的汗珠。$N萧索的一笑，身形欲左倏右，$w挽起叁条流影，眩人心神的暴斩向$n\n" +
    "的$l。" NOR,
    "force": 200,
    "damage_type": "割伤"
  ]),

  ([ "action": HIY "$N手一抖，一招「飞千流」手中$w「削」「削」如飞，已经看不见刀身的舞动，只\n" +
    "见金光千条，万道蓬散纵横，倘握刀的手掌如此熟练，转动得这般迅速，时而正握，\n" +
    "时而反折，时而横斩，时而直戮，幻成一片片刀花，散向$n的$l。" NOR,
    "force": 300,
    "damage_type": "割伤"
  ]),
  ([ "action": HIY "$N双目中煞气顿现，手中$w在强烈抖动中，上身蓦地偏斜使出$w在斜身之际扬冲而起，\n" +
    "却在刀首指天的刹那，猝然自左臂之下反穿而出，斩向$n的$l。这出刀之时，又快又\n" +
    "狠，迅捷得似一下子追戮上千百年以前流去的时光！这斜身反手出刀之式正是七杀刀法中\n" +
    "的第三式「倒夺魄」。" NOR,
    "force": 400,
    "damage_type": "割伤"
  ]),
  ([ "action": HIY "$N身影晃动，一招「尘归土」，手中的$w「削」的飞起，立见金光扬射，刀锋又金蛇似\n" +
    "的倏忽左右闪斩，眼看身形向左，却在往左边一移之隙暴闪至右，锐风在金芒里如飞猝闪，\n" +
    "从中路突然砍至$n的$l。「削」「削」之声彷佛魔鬼的嘲笑，冤魂的哭泣。" NOR,
    "force": 500,
    "damage_type": "割伤"
  ]),
  ([ "action": HIY "$N的双脚点地，刀背贴身，一招「星落寂」刀芒豁然布成了一面千刃万叉的刺网，有如\n" +
    "席卷了天地间可融的空隙，算不清有多少刀影，有多少刃锋，滚向$n的$l。" NOR,
    "force": 600,
    "damage_type": "割伤"
  ]),
  ([ "action": HIY "$N刀刃向上，一招「七欲减」全蛇猝闪，刀光有如同时出自千百名手，布成一个千\n" +
    "万刃，参差不整的苦练，在一个时间里往无数个六白飞花而出。，从一个意想不的\n" +
    "角度撩向$n的$l。" NOR,
    "force": 700,
    "damage_type": "割伤"
  ]),
  ([ "action": HIY "$N一招「网凝红」刀刃斜着削出，在光影方现之时，又倒斩而回，刹那间宛如结成了\n" +
    "一面金芒绚烂的网，以锋利的刀刃做为经纬所织成的网，血淋淋的，来来回回地狂扫\n" +
    "向$n的$l。" NOR,
    "force": 800,
    "damage_type": "割伤"
  ]),
  ([ "action": HIY "$N手中的$w猛然「嗡」的长鸣，刀身骤然颤舞，只见成千上万个金线翻撞浮沉，眩目的金\n" +
    "光映得四野一片烁亮，像漫天燃起了怒火，像宇宙的豪光紧集在此一焦点，而风啸如泣，空\n" +
    "气排荡如浪……$N「七杀刀法」中法中最为歹毒的一招「金轮渺」已然展出，迅捷无比地砍\n" +
    "向$n的全身。" NOR,
    "force": 900,
    "damage_type": "割伤"
  ]),
});

int valid_learn(object me) {
  return notify_fail("「七杀刀法」只能能通过刀谱来提高。\n");
}

int valid_enable(string usage) {
  return (usage == "blade") || (usage == "parry");
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
    return notify_fail("你必须先找一把刀，才能练刀法。\n");

  if ((int)me->query("kee") < 40)
    return notify_fail("你的体力不够练这门刀法，还是先休息休息吧。\n");
  if ((int)me->query("bellicosity") < (int)me->query_skill("qisha-daofa", 1) * 1000)
    return notify_fail("你的杀气不够，无法练「七杀刀法]。\n");
  if ((int)me->query_skill("qisha-daofa", 1) > 100)
    return notify_fail("你感道所学的七杀道法缺了至高心法，无法再提高了。\n");
  me->receive_damage("kee", 40);
  return 1;
}
int effective_level() { return 20; }

string *parry_msg = ({
  HIY "$n使出「七杀刀法」的「九泉水」手中的$v化成九重刀幕护住全身。\n" NOR,
});

string *unarmed_parry_msg = ({
  HIY "$n使出「七杀刀法」中的「九泉水」手中的$v化成九重刀幕护住全身。\n" NOR,
});

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

void skill_improved(object me) {
  if ((int)me->query_skill("qisha-daofa", 1) % 10 == 0) {
    tell_object(me,
      RED "\n你突然觉得一股恶气冲上心头，只觉得想杀人祭刀....\n\n" NOR);
    me->add("bellicosity", 10000);
  } else
    me->add("bellicosity", 2000);
}

int learn_bonus() {
  return 0;
}
int practice_bonus() {
  return -5;
}
int black_white_ness() {
  return 20;
}

string perform_action_file(string action) {
  return CLASS_D("quanzhen") + "/qisha-daofa/" + action;
}
