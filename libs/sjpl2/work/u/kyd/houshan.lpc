//houshan.c 后山 

#include <room.h>
inherit ROOM;

void create() {
  set("short", "后山");
  set("long", @LONG
这里是全真教的后山，二边是全真第子自己开发的农田，种着各种蔬菜。
好几个全真第子正在埋头锄草和浇水。东面是一片片青松林，林前立着一块
牌子(paizi)。
LONG
  );
  set("outdoors", "quanzhen");

  set("exits", ([
    "east": __DIR__ "qingsonglin1",
    "southdown": __DIR__ "xiaolu2",

  ]));

  set("item_desc", ([
    "paizi": "\n\t\t\t：\n\n\n"
    "\t\t∷∷∷∷∷∷∷∷∷\n"
    "\t\t∷　后     擅   ∷\n"
    "\t\t∷　            ∷\n"
    "\t\t∷　山     入   ∷\n"
    "\t\t∷　            ∷\n"
    "\t\t∷　禁     者   ∷\n"
    "\t\t∷　            ∷\n"
    "\t\t∷　地     死   ∷\n"
    " \t\t∷∷∷∷∷∷∷∷∷\n\n\n",

  ]));




  setup();

}

int valid_leave(object me, string dir) {

  if (!present("di tu", this_player())) {
    if (dir == "east") {
      return notify_fail("后山禁地，未经许可不得入内！！！\n");
    }
  }
  return ::valid_leave(me, dir);
}
