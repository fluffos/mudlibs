// fengdong.c 风洞 

#include <room.h>
inherit ROOM;

void create() {
  set("short", "风洞");
  set("long", @LONG
这里是风洞。洞高一十五米，深四十米，是有二大花岗夹峙而成。洞
内清风习习，凉气飕飕。不时的吹出一阵阵的阴风，如非本身有一点根基，
根本无法在这里久待。
LONG
  );
  set("outdoors", "quanzhen");

  set("exits", ([
    "out": __DIR__ "shanlu8",
  ]));
  setup();

}

void init() {
  object ob;
  if (interactive(ob = this_player())) {
    remove_call_out("flush");
    call_out("flush", random(5), ob);

  }


}
int flush(object ob) {

  if (ob || environment(ob) == this_object()) {
    message_vision("迎面突然吹来一阵阴风，$N心里一惊，马上运功抵挡。\n", ob);
    ob->receive_damage("kee", 35 + random(10));
    ob->receive_damage("gin", 35 + random(10));

    //        ob->receive_damage("eff_qi", 1+random(10));
    ob->improve_skill("force", (int)(ob->query_int()) +
      (int)(ob->query_skill("force", 1)));
    ob->improve_skill("dodge", (int)(ob->query_int()) +
      (int)(ob->query_skill("dodge", 1)));
    if (environment(ob) == this_object())

      call_out("flush", random(5) + 5, ob);
  } else
    return 1;
}
