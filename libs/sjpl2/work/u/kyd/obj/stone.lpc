#include <weapon.h>

inherit HAMMER;

void create() {
  set_name("小石块", ({ "stone", "ju shi" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("long", "一块平淡无奇的小石块。\n");
    set("material", "stone");
  }
  init_hammer(1);
  setup();
}
