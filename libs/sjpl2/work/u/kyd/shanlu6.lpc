#include <room.h>
inherit ROOM;

void create() {
  set("short", "山路");
  set("long", @LONG
山路弯弯曲曲盘旋起伏。路面坎坷凸凹不平。路边早已是乱草丛生，杂石
竖横。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    //"north" : __DIR__"shangu",
    "southwest": __DIR__ "shanlu5",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "quanzhen");

  setup();


}
void init() {
  add_action("do_chop", "chop");
}

int do_chop(string arg) {
  object con, obj, weapon;
  object me = this_player();
  object ob1, ob2, room;
  if (!arg || arg != "乱草") {
    write("你要砍什么？\n");
    return 1;
  }

  if (!present("lian dao", me))
    return notify_fail("没有镰刀难道用手砍？\n");
  if (!objectp(weapon = me->query_temp("weapon")))
    return notify_fail("你必须把镰刀装备起来。\n");


  message_vision("$N拿起镰刀,对着路边的乱草丛一阵乱砍。\n", this_player());

  if (this_player()->query("force") > 100) {
    set("exits/enter", __DIR__ "shangu");
    message_vision(
      "$N累得气喘吁吁,终于砍出一条小路。\n", this_player());
    this_player()->add("force", -50);
    remove_call_out("close");
    call_out("close", 20, this_object());
  } else {
    message_vision(
      "$N累得气喘吁吁,也没砍开一条路来。\n", this_player());
    this_player()->set("force", 0);
  }
  return 1;
}

void close(object room) {
  message("vision", "乱草丛渐渐合拢起来,终于又恢复了原状。\n", room);
  room->delete("exits/enter");
}
