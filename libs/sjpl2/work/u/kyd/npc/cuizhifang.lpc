inherit NPC;
inherit F_MASTER;

void consider();

void create() {
  set_name("崔志方", ({ "cui zhifang", "cui", "zhifang" }));
  set("master", "王处一");
  set("gender", "男性");
  set("age", 22);
  set("long",
    "他容貌英挺，高高的个子，体格很健壮。\n"
    "他是王处一第子，也是全真教第三代中的高手。\n");
  set("attitude", "friendly");
  set("class", "quanzhen");

  set("kee", 3500);
  set("max_kee", 3500);
  set("force", 3500);
  set("max_force", 3500);
  set("force_factor", 150);

  set("combat_exp", 900000);


  set_skill("force", 80);             // 基本内功
  set_skill("ziliu-force", 60);    //
  set_skill("unarmed", 80);           // 基本拳脚
  set_skill("tiangang-quanfa", 60);
  set_skill("dodge", 80);            // 基本躲闪
  set_skill("qixing-huanwei", 60);        //七星换位
  set_skill("parry", 80);             // 基本招架
  set_skill("sword", 90);             // 基本剑法
  set_skill("quanzhen-jian", 70);        //全真剑法 
  set_skill("daoxue-xinfa", 70);           //道学心法  
  set_skill("literate", 80);           //读书写字  




  map_skill("force", "ziliu-force");
  map_skill("unarmed", "tiangang-quanfa");
  map_skill("dodge", "qixing-huanwei");
  map_skill("parry", "quanzhen-jian");
  map_skill("sword", "quanzhen-jian");
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "qixinggongyue" :),
    (: exert_function, "recover" :),
  }));




  create_family("全真教", 3, "弟子");
  setup();

  carry_object(__DIR__ "obj/changjian")->wield();
  carry_object(__DIR__ "obj/yellowrobe")->wear();


}
void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(2)) {
    case 0:
      say("崔志方笑咪咪地说道：这位" + RANK_D->query_respect(ob)
        + "，欢迎你来终南山。\n");
      break;
    case 1:
      say("崔志方双手一拱，说道：这位" + RANK_D->query_respect(ob)
        + "是来终南山拜师学武的吗？\n");
      break;
  }
}
