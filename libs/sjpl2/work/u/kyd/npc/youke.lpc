// guest.c 游客

inherit NPC;

void create() {
  set_name("游客", ({ "youke" }));
  set("gender", "男性");
  set("age", 20 + random(30));

  set_skill("unarmed", 40);
  set_skill("dodge", 40);
  set("apply/attack", 25);
  set("apply/defense", 25);
  set("apply/damage", 15);
  set("combat_exp", 15000);
  //	set("shen_type", 1);

  setup();
  carry_object(__DIR__ "obj/cloth")->wear();
  //	add_money("silver", 5);
}
