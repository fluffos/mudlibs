inherit NPC;

void create() {
  set_name("黑蜘蛛", ({ "hei zhizhu", "zhizhu" }));
  set("race", "野兽");
  set("age", 5);
  set("long", "一只箩筐大的黑蜘蛛，带着丈余长的大毛腿，见了使人不寒而慄。\n");
  set("attitude", "aggressive");

  set("kee", 2000);
  set("max_kee", 2000);
  set("gin", 1500);
  set("max_gin", 1500);
  set("str", 36);
  set("cor", 30);

  set("limbs", ({ "头部", "身体", "大毛腿" }));
  set("verbs", ({ "bite" }));

  set("combat_exp", 1500000);

  set("chat_chance", 50);

  set_temp("apply/attack", 50);
  set_temp("apply/damage", 40);
  set_temp("apply/armor", 36);
  set_temp("apply/defence", 40);

  setup();
}

void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player())) {
    remove_call_out("kill_ob");
    call_out("kill_ob", 1, ob);
  }
}
