//liuchuxuan.c 刘处玄
#include <ansi.h>

inherit NPC;
inherit F_MASTER;

// void consider();
void do_drink();

void create() {
  set_name("刘处玄", ({ "liu chuxuan", "liu", "chuxuan" }));
  set("nickname", HIB "长生子" NOR);
  set("gender", "男性");
  set("age", 41);
  set("long",
    "他身形矮小，面目宛似猿候，一身道袍破烂不堪。\n"
    "他就是全真七子中的“长生子”刘处玄。\n");
  set("attitude", "friendly");
  set("class", "quanzhen");

  set("chat_chance", 5);
  set("chat_msg", ({
    "刘处玄说道：“酒瘾又上来了......。”\n",
    "刘处玄说道：“叫鹿清笃去买酒，到先在还没送来..。”\n",
    (: do_drink :),
    (: random_move :),
    (: random_move :),

  }));

  set("inquiry", ([
    "内园": "内园是掌教修练的地方，只有三代以上的第子才有资格拜见掌教。\n",
    "玉虚洞": "玉虚洞乃我师傅闭关的地方，就在后山青竹林后面。\n",
  ]));

  set("map_count", 1);

  set("max_kee", 3500);
  set("force", 3500);
  set("max_force", 3500);
  set("force_factor", 300);
  set("combat_exp", 4600000);

  set_skill("force", 150);                // 基本内功
  set_skill("ziliu-force", 150);      //
  set_skill("unarmed", 150);              // 基本拳脚
  set_skill("tiangang-quanfa", 150);
  set_skill("dodge", 150);             // 基本躲闪
  set_skill("qixing-huanwei", 150);      //七星换位
  set_skill("parry", 150);              // 基本招架
  set_skill("sword", 150);              // 基本剑法
  set_skill("quanzhen-jian", 150);      //全真剑法 
  set_skill("daoxue-xinfa", 150);             //道学心法  
  set_skill("literate", 150);          //读书写字  

  map_skill("force", "ziliu-force");
  map_skill("unarmed", "tiangang-quanfa");
  map_skill("dodge", "qixing-huanwei");
  map_skill("parry", "quanzhen-jian");
  map_skill("sword", "quanzhen-jian");


  create_family("全真教", 2, "长老");

  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "qixinggongyue" :),
    (: exert_function, "recover" :),
  }));

  setup();

  carry_object(__DIR__ "obj/changjian")->wield();
  carry_object(__DIR__ "obj/greyrobe")->wear();



}
void do_drink() {
  object *list, ob;
  int i, can_drink;
  if ((int)this_object()->query("water") >= 380) return;
  list = all_inventory(this_object());
  i = sizeof(list);
  can_drink = 0;
  while (i--) {
    if ((string)list[i]->query("liquid/type") == "alcohol") {
      ob = list[i];
      can_drink = 1;
    }
  }
  if (can_drink) {
    command("drink " + (string)ob->query("id"));
    if ((int)ob->query("liquid/remaining") == 0)
      command("drop wineskin");
  } else
    message_vision("$N用力吸了吸发红的鼻子．\n", this_object());
  return;
}

int accept_object(object who, object ob) {
  mapping names;
  object ob1;

  if (!this_player()->query_temp("lu_give")) {
    tell_object(who, "刘处玄说道：我又没叫你去买酒，你如何帮我买来了，是不是想。。。？\n");
    return 0;
  }
  if (query("map_count") < 1) {
    tell_object(who, "刘处玄说道：又想用酒来骗我的东西，门都没有。\n");
    return 0;
  }


  if ((string)ob->query("liquid/type") == "alcohol") {
    if ((int)ob->query("liquid/remaining") == 0) {
      command("shake");
      command("say 空的我不要...");
      return 0;
    } else if (ob->query("liquid/name") != "全真酒") {
      command("sigh");
      command("say 这不是我想要喝的酒...");
      return 0;
    }

    else {
      command("smile");
      command("say 多谢，这个给你!");
      ob1 = new(__DIR__ "obj/map3");
      ob1->move(this_player());
      add("map_count", -1);

      return 1;
    }
  } else return 0;
}
