inherit NPC;
inherit F_MASTER;

void consider();

void create() {
  set_name("护山道士", ({ "dao shi" }));
  set("gender", "男性");
  set("age", 25);
  set("long",
    "他是全真教的护山道士，专门守护山门。 \n");
  set("attitude", "friendly");
  set("class", "taoist");


  set("chat_chance", 1);
  set("chat_msg", ({
    "护山道士说道：“活死人墓千万别乱闯，会有生命危险的。”\n",
    (: random_move :),
  }));

  set("kee", 2000);
  set("max_kee", 2000);
  set("gin", 2000);
  set("max_gin", 2000);
  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 150);


  set("combat_exp", 150000);

  set_skill("force", 180);             // 基本内功
  set_skill("ziliu-force", 180);    //
  set_skill("unarmed", 180);           // 基本拳脚
  set_skill("tiangang-quanfa", 180);
  set_skill("dodge", 180);            // 基本躲闪
  set_skill("qixing-huanwei", 180);        //七星换位
  set_skill("parry", 180);             // 基本招架
  set_skill("sword", 180);             // 基本剑法
  set_skill("quanzhen-jian", 180);        //全真剑法 
  set_skill("literate", 80);           //读书写字  

  map_skill("force", "ziliu-force");
  map_skill("unarmed", "tiangang-quanfa");
  map_skill("dodge", "qixing-huanwei");
  map_skill("parry", "quanzhen-jian");
  map_skill("sword", "quanzhen-jian");

  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "qixinggongyue" :),
    (: exert_function, "recover" :),
  }));



  create_family("全真教", 4, "第子");
  setup();

  carry_object(__DIR__ "obj/changjian")->wield();
  carry_object(__DIR__ "obj/greenrobe")->wear();
}
