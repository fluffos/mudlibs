#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void consider();

void create() {
  set_name("郝大通", ({ "hao datong", "hao", "datong" }));
  set("nickname", CYN "广宁子" NOR);
  set("gender", "男性");
  set("age", 45);
  set("long",
    "他白发白眉，脸孔极长，身着灰色道袍，看模样是全真教的高手。\n"
    "他就是王重阳座下七大第子之一“广宁子”郝大通。\n");
  set("attitude", "friendly");
  set("class", "quanzhen");

  set("chat_chance", 1);
  set("chat_msg", ({
    "郝大通说道：“好。。。痛。。。，看来我中的玉蜂毒解不掉了。”\n",
    "郝大通说道：“哎。。。呀。。。，如此痛苦不如死了算了。”\n",

    //	(: random_move :),
  }));
  set("zhi_count", 1);

  set("max_kee", 3500);
  set("force", 4000);
  set("max_force", 4000);
  set("force_factor", 300);
  set("combat_exp", 4500000);

  set_skill("force", 150);             // 基本内功
  set_skill("ziliu-force", 140);    //
  set_skill("unarmed", 150);           // 基本拳脚
  set_skill("tiangang-quanfa", 140);
  set_skill("dodge", 160);            // 基本躲闪
  set_skill("qixing-huanwei", 150);        //七星换位
  set_skill("parry", 150);             // 基本招架
  set_skill("sword", 150);             // 基本剑法
  set_skill("quanzhen-jian", 140);        //全真剑法 
  set_skill("daoxue-xinfa", 130);            //道学心法  
  set_skill("literate", 120);           //读书写字  

  map_skill("force", "ziliu-force");
  map_skill("unarmed", "tiangang-quanfa");
  map_skill("dodge", "qixing-huanwei");
  map_skill("parry", "quanzhen-jian");
  map_skill("sword", "quanzhen-jian");

  create_family("全真教", 2, "长老");

  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "qixinggongyue" :),
    (: exert_function, "recover" :),
  }));

  setup();

  carry_object(__DIR__ "obj/changjian")->wield();
  carry_object(__DIR__ "obj/greyrobe")->wear();


}
int accept_object(object me, object obj)

{
  object ob1, zhi;
  mapping fam;


  if (!this_player()->query_temp("zhang_give")) {
    tell_object(obj, "郝大通说道：我和你素不相识，这东西我不能要。。。？\n");
    return 0;
  }

  if (query("zhi_count") < 1) {
    tell_object(obj, "郝大通说道：谢谢你，我的毒已经有人帮我解了。\n");
    return 1;
  }

  if ((string)obj->query("name") == "玉蜂蜜") {
    command("touch");
    command("say 太谢谢你了！这个给你！\n");
    zhi = new(__DIR__ "/obj/map5");
    if (zhi)
      zhi->move(this_player());
    //   message_vision("$N给了$n一张牛皮纸。\n",this_object(),this_player());
    add("zhi_count", -1);
    return 1;
  }
}
void destroying(object obj) {
  destruct(obj);
  return;
}
