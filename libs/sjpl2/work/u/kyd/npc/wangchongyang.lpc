#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void consider();
int ask_me();
void create() {
  set_name("王喆", ({ "wang zhe", "wang", "chongyang", "master" }));
  set("nickname", HIR "重阳真人" NOR);
  set("gender", "男性");
  set("age", 52);
  set("long",
    "他精神抖擞，长须垂胸，脸如婴儿般血红。\n"
    "他就是全真教的开派祖师王重阳。\n");
  set("attitude", "peaceful");
  set("class", "quanzhen");
  set("chat_chance", 1);


  set("max_gin", 8000);
  set("max_kee", 8000);
  set("max_sen", 5000);
  set("force", 10000);
  set("max_force", 10000);
  set("force_factor", 500);
  set("combat_exp", 10000000);


  set_skill("force", 200);                 // 基本内功
  set_skill("ziliu-force", 200);     //紫流气功
  set_skill("unarmed", 200);             // 基本拳脚
  set_skill("tiangang-quanfa", 200);
  set_skill("dodge", 200);            // 基本躲闪
  set_skill("qixing-huanwei", 200);        //七星换位
  set_skill("parry", 200);             // 基本招架
  set_skill("sword", 200);             // 基本剑法
  set_skill("quanzhen-jian", 250);        //全真剑法 
  set_skill("daoxue-xinfa", 200);            //道学心法  
  set_skill("literate", 200);           //读书写字
  set_skill("sanhuajuding", 200);
  set_skill("move", 180);           //轻功

  map_skill("force", "ziliu-force");
  map_skill("unarmed", "sanhuajuding");
  map_skill("dodge", "qixing-huanwei");
  map_skill("parry", "quanzhen-jian");
  map_skill("sword", "quanzhen-jian");

  set("no_shown", 1);
  create_family("全真教", 1, "祖师");

  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "qixinggongyue" :),
    (: exert_function, "recover" :),
  }));





  setup();

  carry_object(__DIR__ "obj/changjian")->wield();
  carry_object(__DIR__ "obj/greyrobe")->wear();

}

void attempt_apprentice(object ob) {
  object me = this_object();
  mapping ob_fam = ob->query("family");
  mapping my_fam = me->query("family");


  if ((int)ob->query_str() < 20 || (int)ob->query_con() < 20) {
    command("say 当道士需能吃苦耐劳，六根清静，依我看" + RANK_D->query_respect(ob) + "的资质似乎不适合当道士？");
    return;
  }

  if ((string)ob->query("family/family_name") != "" &&
    (string)ob->query("family/family_name") != "全真教") {
    command("say " + RANK_D->query_respect(ob) + "既然已有名师指点，何必又来拜本真人呢？");
    return;
  }
  if ((int)ob->query_skill("ziliu-force", 1) < 120) {
    command("say 我全真教乃内家武功，最重视内功心法。");
    command("say " + RANK_D->query_respect(ob) +
      "是否还应该在紫流气功上多下点功夫？");
    return;
  }
  if ((int)ob->query_skill("quanzhen-jian", 1) < 120) {
    command("say 我全真教剑法扬名天下，天下无双。");
    command("say " + RANK_D->query_respect(ob) +
      "是否还应该在全真剑法上多下点功夫？");
    return;
  }
  command("smile");
  command("say 好吧，贫道就收下你了。");
  command("recruit " + ob->query("id"));

}
