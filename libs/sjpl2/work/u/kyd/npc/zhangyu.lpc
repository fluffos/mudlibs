inherit NPC;

void create() {
  set_name("大章鱼", ({ "zhang yu", "octopus", "yu" }));
  set("race", "野兽");
  set("age", 5);
  set("long", "一只八丈来大的章鱼，两只眼睛又红又大，见了使人不寒而慄。\n");
  set("attitude", "aggressive");

  set("kee", 10000);
  set("max_kee", 10000);
  set("gin", 1000);
  set("sen", 1000);
  set("str", 250);
  set("cor", 250);

  set("limbs", ({ "头部", "身体", "须" }));
  set("verbs", ({ "bite" }));

  set("combat_exp", 500000);

  set("chat_chance", 50);

  set_temp("apply/attack", 200);
  set_temp("apply/damage", 200);
  set_temp("apply/armor", 200);
  set_temp("apply/defence", 200);

  setup();
}

void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player())) {
    remove_call_out("kill_ob");
    call_out("kill_ob", 1, ob);
  }
}
