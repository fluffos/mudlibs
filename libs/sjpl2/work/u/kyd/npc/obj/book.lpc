// book.c

inherit ITEM;

void create() {
  int i;

  string *names = ({
    "「法术图解」", "「内功心法」", "「拳法入门」", "「剑法简介」",
    "「轻功摡要」" });

  string *skills = ({
    "magic", "force", "unarmed", "sword", "dodge"
  });

  i = random(5);
  set_name(names[i], ({ "book" }));
  set_weight(100);
  set("unit", "本");
  set("long", "这是一本修练基本武功的秘籍。\n");
  set("skill", ([
    "name": skills[i],
    "exp_required": 30000,
    "sen_cost": 20,
    "difficulty": 30,
    "max_skill": 51,

  ]));
}
