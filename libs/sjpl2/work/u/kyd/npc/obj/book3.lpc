// book.c
#include <ansi.h>
inherit ITEM;
int do_tear(string arg);
void create() {

  set_name(WHT "七杀刀经" NOR, ({ "book" }));
  set_weight(100);
  set_max_encumbrance(800);

  set("unit", "本");
  set("long", "一本黑面的画籍，上面两个白色的骷髅，十份刺眼，底面却画着把金光灿然的金刀。\n");
  set("no_drop", "这样东西不能离开你。\n");
  set("no_give", "这样东西不能随便给人。\n");

  set("closed", 1);
  set("treasure", 1);



}

int is_container() { return 1; }
void init() {
  if (this_player() == environment())
    add_action("do_open", "open");
  add_action("do_open", "tear");
  add_action("do_close", "close");
  add_action("do_du", "du");
  add_action("do_du", "study");

}

int do_close(string arg) {
  object me, ob;

  me = this_player();
  ob = this_object();
  if (!arg || arg != "book")
    return notify_fail("你要合上什么？\n");
  message_vision("$N把$n合上了。\n", me, ob);
  ob->set("closed", 1);
  return 1;
}

int do_open(string arg) {
  object me, ob, book;
  int kar;

  if (!arg || arg != "book")
    return notify_fail("你要撕开什么？\n");
  if (this_object()->query("hasgot"))
    message_vision("$N发先这本书的最后一页已经被撕开过了。\n", this_player());
  //	if ( me->query("int") <24  &&  me->query("kar") <30)
  //          return notify_fail("你仔细的把书从头到尾翻了一番，也没有发现奇特之处。\n");
  me = this_player();
  ob = this_object();
  message_vision("$N发现书的最后一页是有两页夹贴起来的，$N想要把$n的夹页撕开．．．。\n", me, ob);
  this_object()->set("hasgot", 1);
  ob->set("closed", 0);
  message_vision("$N终于把$n撕开了。\n", me, ob);
  return 1;
}

int is_closed() {
  return ((int)this_object()->query("closed"));
}

int do_du(string arg) {
  object me = this_player();
  //object where = environment(me);
  object ob;
  //        ob = jianfa;
  mapping skill;
  int jlevel;
  int zlevel;
  int neili_lost;
  if (arg == "" || !arg)
    return 0;

  if (arg == "book") {

    if (me->is_busy()) {
      write("你现在正忙着呢。\n");
      return 1;
    }

    if (me->is_fighting()) {
      write("你很难在战斗中分心研读秘籍！\n");
      return 1;
    }


    if (!me->query_skill("literate", 1)) {
      write("你这个文盲，先去学点文化(literate)吧。\n");
      return 1;
    }
    if ((int)me->query_("str", 1) > 20) {
      write("你无法领悟《七杀刀经》的要领。\n");
      return 1;
    }

    if ((int)me->query("sen") < 50) {
      write("你太疲倦了，无法研读武学秘籍。\n");
      return 1;
    }
    if (me->query_skill("blade", 1) < 30) {
      write("你的基础功没有打好，不能学习七杀刀法。\n");
      return 1;
    }
    if ((int)me->query("bellicosity") < 100000) {
      write("你的杀气不足，无法研读《七杀刀经》。\n");
      return 1;
    }

    if ((int)me->query("force") < neili_lost) {
      write("你内力不够，无法钻研这么高深的武功。\n");
      return 1;
    }

    jlevel = me->query_skill("qisha-daofa", 1);
    if ((int)me->query("combat_exp") < (int)jlevel * jlevel * jlevel / 10) {
      write("你的实战经验不足，再怎么读也没用。\n");
      return 1;
    }

    if (me->query_skill("qisha-daofa", 1) >= 31) {
      write("你已经无法再从秘籍中学到什么，要想更高的修为必须靠自已苦练。\n");
      return 1;
    }
    neili_lost = (int)(me->query_skill("qisha-daofa", 1) / 15);
    me->receive_damage("sen", 50);
    me->set("force", (int)me->query("force") - neili_lost);
    me->improve_skill("qisha-daofa", (int)me->query_skill("literate", 1) / 3 + 1);
    message("vision", me->name() + "拿着一本秘籍认真研读。\n", environment(me), me);
    write("你研读《七杀刀经》，颇有心得。\n");
    return 1;

  }
}
