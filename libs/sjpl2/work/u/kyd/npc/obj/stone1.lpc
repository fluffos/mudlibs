#include <weapon.h>

inherit HAMMER;

void create() {
  set_name("鹅卵石", ({ "stone", "e luanshi" }));
  set_weight(1000000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("long", "一块滑溜溜的鹅卵石。\n");
    set("material", "stone");
  }
  init_hammer(1);
  setup();
}
