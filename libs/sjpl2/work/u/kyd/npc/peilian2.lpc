#include <ansi.h>
string reward_more(object who);
inherit NPC;
void create() {

  set_name("全真陪练弟子", ({ "peilian dizi", "dizi" }));
  set("gender", "男性");
  set("attitude", "friendly");

  set("str", 25);
  set("cor", 30);
  set("cps", 25);
  set("chat_chance", 2);
  set("chat_msg", ({
    "陪练弟子练了一遍拳法，武功似乎略有增长。\n",
  }));
  set("combat_exp", 30000);
  set("food", 3000);
  set("water", 3000);
  set("force", 3000);
  set_skill("sword", 30);
  set_skill("parry", 30);
  set_skill("dodge", 30);
  set_skill("unarmed", 30);
  set_skill("force", 100);
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: reward_more(this_object()) :),
  }));
  setup();
  carry_object("/obj/changjian");
  carry_object("/obj/cloth")->wear();
}

string reward_more(object who) {
  int i;
  object *enemy;
  seteuid(getuid());
  enemy = who->query_enemy();
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      if (enemy[i]->query("combat_exp") < 10000) return "1";
      if (enemy[i]->query("combat_exp") > 30000) return "1";
      enemy[i]->add("combat_exp", 1);
      if (enemy[i]->query("potential") - enemy[i]->query("learned_points") > 200) return "1";
      if (random(9) < 5)
        enemy[i]->add("potential", 1);
      else
        enemy[i]->add("life_exp", 1);
    }
  }
  return "1";
}

void init() {
  add_action("dokill", ({ "kill" }));
}

int accept_fight(object ob) {
  object weapon;

  if (ob->query("class") == "quanzhen") {
    command("nod");
    command("say 好吧，贫道就陪你练练身手");
    if (weapon = query_temp("weapon"))
      command("unwield sword");
    set("force_factor", 0);
    return 1;
  }
  return notify_fail("陪练弟子摇了摇头：“你非本门弟子，贫道不便出手”\n");
}

int dokill(string arg) {
  object weapon;

  if (!this_object()->id(arg)) return 0;
  message_vision("\n$N对著$n喝道：「"
    +RANK_D->query_rude(this_object())
    + "！今日不是你死就是我活！」\n\n", this_player(), this_object());

  command("laugh");
  set("force_factor", 50);
  if (weapon = present("sword", this_object()))
    command("wield sword");
  this_object()->kill_ob(this_player());
  this_player()->kill_ob(this_object());
  return 1;
}
