// yuxudong.c 玉虚洞 /u/kyd/npc/sunbuer

#include <room.h>
inherit ROOM;

void create() {
  set("short", "玉虚洞");
  set("long", @LONG
眼前是一个半天然，半人工的山洞，四周点着几盏长命灯，正中放着一张桌子，
上面放这几本书。靠墙有一石床，上面放着一蒲团(putuan)。地上零乱的放着七个供
人打坐用的蒲团。如果仔细的观察一下，仿佛感到洞中的摆设藏着什么玄机。

LONG
  );

  set("exits", ([
    "out": __DIR__ "yadi",
  ]));
  add("paper_count", 1);
  add("zhi_count", 1);
  set("item_desc", ([
    "putuan": "用稻草编成的蒲团，你可以试着跪(kneel)下来，虔诚的膜拜(mobai)",

  ]));

  setup();

}
void init() {
  add_action("do_mobai", "mobai");
  add_action("do_kneel", "kneel");

}
int do_kneel() {
  object me, room, weapon;
  me = this_player();
  //	if ( !arg || arg == "") return 0;
  //	if ( arg != "蒲团") return 0;
  //	if (!present("蒲团",environment(me))) return 0;
  //	if (me->query_temp("marks/kneel") == 1 )
  //		return notify_fail("你已经跪下来了。\n");
  message_vision("$N双膝一屈，跪了下来。\n", me);
  me->add_temp("marks/kneel", 1);
  return 1;
}

int do_mobai() {
  object who, ob;
  who = this_player();
  if ((int)who->query("sen") <= 50)
    return notify_fail("你的神不够。\n");
  if (!this_player()->query_temp("marks/kneel")) return 0;
  if (this_player()->query_temp("mobai_pass")) return 0;
  if (this_player()->query_temp("bai_pass")) return 0;
  if (query("zhi_count") < 1) return 0;
  if (query("paper_count") < 1) return 0;

  message_vision("$N虔诚地跪在地上磕了个头。\n", who);
  who->receive_damage("sen", 50);
  if ((int)who->query("bellicosity") > 0)
    who->add("bellicosity", -(random((int)who->query("kar")) + 7));
  message_vision("$N身上的杀孽之气似乎轻了。 \n", who);
  add("number", 1);
  if ((int)query("number") == random(40) + 20 && (int)who->query("kar") > 30) {
    message_vision("\n\n$N觉得眼前一花，床上的蒲团似乎动了一下！！！！\n\n", who);
    if (!objectp(who = present("wang chongyang", this_object()))) {
      who = new(__DIR__ "npc/wangchongyang");
      who->move(this_object());
    }
  }
  if ((int)query("number") == random(40) + 20 && (int)who->query("tol") > 20 && random(9) > 4) {
    add("paper_count", -1);
    seteuid(geteuid(this_player()));
    ob = new(__DIR__ "obj/quanzhenjiu");
    ob->move(this_player());
    write("你仿佛听见耳边有人对着你说道，入的此洞，即为有缘，无物已赠，送尔全真酒一袋！\n");
    write("你双眼一花，怀中已经多了一袋酒。\n");
    this_player()->set_temp("mobai_pass");
  } else if ((int)query("number") == random(40) + 20 && (int)who->query_skill(
    "ziliu-force",
    1
  ) > 101) {
    add("zhi_count", -1);
    seteuid(geteuid(this_player()));
    ob = new(__DIR__ "obj/book2");
    ob->move(this_player());
    write("你仿佛听见耳边有人对着你说道，入的此洞，即为有缘，赠你一阳指谱，妄尔好自为之．．．！\n");
    write("你眼前一花，只见你的手上突然多了一本书．．．．！\n");
    this_player()->set_temp("bai_pass");
  }
  return 1;
}

void reset() {
  object obj;
  ::reset();
  delete("number");
  if (objectp(obj = present("wang changyang", this_object())))
    destruct(obj);
}
