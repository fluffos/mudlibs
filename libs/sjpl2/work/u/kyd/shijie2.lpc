// shijie2.c 石阶

#include <room.h>
inherit ROOM;

void create() {
  set("short", "石阶");
  set("long", @LONG
你走在一条坚实的石阶上，不时地有进香客从你的身边走过。一边是峭壁，
一边是悬崖，抬头隐约可见笼罩在云雾中的山峰，听着流水淙淙，令人心旷神
怡。
LONG
  );
  set("outdoors", "quanzhen");

  set("exits", ([
    "eastdown": __DIR__ "shijie1",
    "northup": __DIR__ "cuihuamiao",
  ]));
  set("objects", ([
    __DIR__ "npc/guest": 1,
    __DIR__ "npc/youke": 1,

  ]));

  setup();
}
