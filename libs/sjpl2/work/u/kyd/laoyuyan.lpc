// laoyuyan.c 老妪岩 

#include <room.h>
inherit ROOM;

void create() {
  set("short", "老妪岩");
  set("long", @LONG
山道此处遽然变窄，遮天古木令天地顿暗。迎面又一大岩石当道，形状阴
森可怖，自空凭临，宛似一个老妪弯腰俯视。说不出的鬼气弥漫，岩后昏黑中
不知藏有多少杀机。
LONG
  );
  set("outdoors", "quanzhen");

  set("exits", ([
    "southdown": __DIR__ "riyueyan",
    "eastup": __DIR__ "baoquan",
  ]));
  set("objects", ([
    (__DIR__ "npc/monkey"): 2,
  ]));

  setup();
}
