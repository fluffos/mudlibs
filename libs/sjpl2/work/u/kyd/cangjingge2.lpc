// cangjingge2.c 藏经阁

#include <room.h>
inherit ROOM;

void create() {
  set("short", "藏经阁二楼");
  set("long", @LONG
这里是藏经阁二楼，靠墙是几排书架，全真教历代道藏、王重阳和七第子
的著作，以及教中机密文卷尽数藏在这里。阁后有一条深达数十丈的溪涧。
LONG
  );

  set("exits", ([
    "down": __DIR__ "cangjingge1",
  ]));


  set("objects", ([
    (__DIR__ "npc/qiuchuji"): 1,
  ]));

  setup();

}
