inherit ROOM;
void create() {
  set("short", "半空中");
  set("long", @LONG
愈往下落，愈见宽广，目力还可以看出壁面的形状，因为隙下依然明亮，这真
是天地间的奇景。你仿佛看见下面横着一道长长的东西。
LONG
  );
  set("outdoors", "全真教");
  setup();
}

void init() {
  if (interactive(this_player()))
    call_out("do_flush", 2, this_player());

}
void do_flush(object me) {
  object room;
  me = this_player();

  if (!me || environment(me) != this_object())
    return;
  tell_object(me, "耳边都是呼呼的风声，你的身体不停的往下坠。。。。。。\n");
  room = load_object(__DIR__ "naiheqiao");
  me->move(room);
  message_vision("[砰]的一声，$N结结实实的摔在了石桥上，紧跟着就失去了知觉。\n", me);
  this_player()->unconcious();
}
