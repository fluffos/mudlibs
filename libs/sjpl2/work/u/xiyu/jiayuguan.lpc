// Room: /d/xingxiu/jiayuguan.c
// baiwt

inherit ROOM;

void create() {
  set("short", "玉门关");
  set("long", @LONG
玉门关历来便是军事重地，是西域通往中原的主要关塞。登楼远望，
塞外风光，戈壁瀚海，尽收眼底。长城似游龙，若隐若现，时隐时现，
雄伟壮观。这里壁垒森严，堡楼林立，更显出关城的肃穆威严。有诗为
证：“明月出天山，苍茫云海间，长风几万里，吹度玉门关。”
LONG
  );
  set("outdoors", "xiyu");
  set("exits", ([
    "eastup": __DIR__ "xxroad3.lpc",
    "west": __DIR__ "battle1.lpc",
  ]));

  set("objects", ([
    __DIR__ "npc/zhang": 1,
    __DIR__ "npc/army_1": 1,
    __DIR__ "npc/army_2": 1,
    __DIR__ "npc/army_3": 1,
    __DIR__ "npc/army_4": 1,
    __DIR__ "npc/army_5": 1,
  ]));
  setup();
}
int valid_leave(object me, string dir) {
  if (me->query("quest/battle") && me->query("quest/battle") != 0)
    return ::valid_leave(me, dir);
  if (dir == "west") {
    if (!objectp(present("bai weitang", environment(me))))
      return notify_fail("边关战事正紧，寻常人等不得出关。\n");
  }
  return ::valid_leave(me, dir);
}
