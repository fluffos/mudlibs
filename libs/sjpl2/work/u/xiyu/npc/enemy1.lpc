inherit NPC;
int eff_kees(object me);
int do_detect(object me);
void create() {
  object me = this_player();
  set_name("匈奴兵", ({ "xiongnu bing" }));
  set("title", "一百名");
  set("attitude", "heroism");
  set("pursuer", 1);
  set("bellicosity", 100);
  set("str", 50 + random(50));
  set("long",
    "这是一队军容整齐的匈奴兵，约有一百人之多。\n");
  set("max_kee", 10000);
  set("max_sen", 10000);
  set("max_gin", 10000);
  set("kee", 10000);
  set("sen", 10000);
  set("gin", 10000);
  set("combat_exp", 1000000);
  set("score", 1000);
  set_skill("blade", 50 + random(50));
  set_skill("unarmed", 50 + random(50));
  set_skill("parry", 50 + random(50));
  set_skill("move", 50 + random(50));
  set_skill("dodge", 50 + random(50));
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: eff_kees(this_object()) :),
  }));
  set("chat_chance", 50);
  set("chat_msg", ({
    (: do_detect :),
  }));
  setup();
  carry_object("/u/xiyu/obj/roundblade")->wield();
  carry_object("/u/xiyu/obj/tiejia")->wear();
}
void init() {
  add_action("do_look", "look");
  add_action("do_gogo", "go");
}

int do_look(string arg) {

  if (arg == "xiongnu bing") {
    write("这是一队军容整齐的匈奴兵，约有一百人之多。\n");
    write("他们军纪严明，刀枪林立。\n");
    write("匈奴兵旗号在风中飘扬，猎猎作响，煞是威风。\n");
    return 1;
  }
  return 0;
}

int eff_kees(object me) {
  object mguard = this_object();
  mguard->set("title", chinese_number(mguard->query("kee") / 100) + "名");
  return 1;
}
int do_detect(object me) {
  me = this_object();
  if (present("army men", environment(me))) {
    command("kill army men");
    return 1;
  }
  return 1;
}

int do_gogo(string arg) {
  object me;
  me = this_player();
  if (arg != "east") {
    if (me->query("class") != "xiongnu_jiang") {
      command("say 敌将往哪里走！");
      this_object()->kill_ob(me);
      me->kill_ob(this_object());
      write("这个方向的路被匈奴兵挡住了 。\n");
      return 1;
    } else
      return 0;
  } else
    return 0;
}
int accept_fight(object me) {
  command("say 我们正忙于训练，不敢违反军纪。\n");
  return 0;
}
