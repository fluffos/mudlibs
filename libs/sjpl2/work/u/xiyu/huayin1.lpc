inherit ROOM;

void create() {
  set("short", "华阴县");
  set("long", @LONG
这里是陕西省华阴县，在华山之北。华山，古称西岳，是我国著名的
五岳之一。前濒黄河，后接秦岭，奇峰突兀，气势雄伟。《水经注》说它
“远而望之若花状”，因名华山。又以西有少华山，故又称太华山。　
LONG
  );
  set("exits", ([
    "east": __DIR__ "huaroad1",
    "west": __DIR__ "huayin2",
    "south": __DIR__ "huaroad2",
  ]));

  set("objects",
    ([
      "/npc/nknpc": 1,
    ]));
  set("outdoors", "xiyu");

  setup();
  replace_program(ROOM);
}
