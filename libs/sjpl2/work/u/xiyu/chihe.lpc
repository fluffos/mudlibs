inherit ROOM;

void create() {
  set("short", "赤河");
  set("long", @LONG
出乎你的意料之外，在沙漠中竟然有泉水。一泓清澈的泉水形成一个月牙的
形状，因而得名月儿泉。南面是一片峭壁(cliff)，东边传来嗡嗡的声响。
LONG
  );
  set("resource/water", 1);

  set("exits", ([
    "east": __DIR__ "shashan",
  ]));

  set("item_desc", ([
    "cliff": "峭壁上似乎有一个洞(hole)。\n"
  ]));

  setup();
}
