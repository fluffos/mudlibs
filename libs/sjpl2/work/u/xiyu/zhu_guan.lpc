inherit ROOM;

void create() {
  set("short", "城关");
  set("long", @LONG
这是一座正在建设的城关，依山势而修建，高大雄伟，险峻
异常，给人一夫当关万将莫敌的感觉。
LONG
  );

  set("exits", ([
    "eastup": __DIR__ "xxroad3.lpc",
  ]));
  set("objects",
    ([  //sizeof() == 1
    "/obj/npc/worker4": 2,
    ]));
  set("no_fight", 1);
  set("no_study", 1);
  set("no_magic", 1);
  set("hell", 1);
  set("NONPC", 1);
  set("outdoors", "xueshan");
  setup();
}

int valid_leave(object me, string dir) {

  if (me->query_temp("doing_work") <= 1)
    return notify_fail("你的工作还没有完成，怎么就想走了？\n");
  me->set_temp("doing_work", 0);
  return ::valid_leave(me, dir);
}
