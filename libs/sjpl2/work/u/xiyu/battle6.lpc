inherit ROOM;

void create() {
  set("short", "古战场");
  set("long", @LONG
这是一片无边无际的开阔地，由于长年硝烟弥漫，已经变得杂草
丛生，到处都可看见马蹄战车所留下的痕迹。遥望两边是绵延的祁连
山脉，东面隐约可见烽火笼罩下的玉门关。处在这样一种苍凉的景象
中，让人不得不有“由来征战地，不见有人还。戌客望边邑，思归多
苦颜”的感慨。
LONG
  );
  set("outdoors", "xiyu");

  set("exits", ([
    "east": __DIR__ "battle5",
    "west": __DIR__ "battle6",
    "south": __DIR__ "battle6",
    "north": __DIR__ "battle6",
  ]));
  set("objects", ([
    __DIR__ "npc/xiongnu1": 1,
  ]));

  setup();
  replace_program(ROOM);
}
