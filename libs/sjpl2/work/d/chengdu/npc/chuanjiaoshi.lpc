inherit KZZNPC;
#include <ansi.h>

string query_save_file() { return DATA_DIR + "npc/约翰斯"; }
void create() {
#include <kzznpc.h>

  set("area_name", "成都教堂");
  set("area_file", "/d/chengdu/jiaotang.lpc");
  set("ziyuan", "西药");
  set("jizhi", 70);
  set("kaifa", 15);
  setup();
  {
    object carried_ob = carry_object("/d/suzhou/npc/obj/xifu");
    if (carried_ob) carried_ob->wear();
  }
  {
    object carried_ob = carry_object("/obj/std/armor/pixue");
    if (carried_ob) carried_ob->wear();
  }
  add_money("gold", 1);
}
#include <die.h>
