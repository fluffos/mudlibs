inherit NPC;

#include <ansi.h>

void create() {
  set_name("吕振", ({ "lv zhen", "lv" }));
  set("gender", "男性");
  set("age", 25);
  set("long", "吕振是长安城皇城巡守，金枪将吕史的次子，负责皇城内外安全。\n");
  set("combat_exp", 350000);
  set("title", "皇城巡守");
  set("nickname", HIB "铁枪将" NOR);
  set("attitude", "friendly");
  set("per", 25);
  set("str", 35);
  set("max_kee", 850);
  set("max_gin", 600);
  set("max_mana", 500);
  set("mana", 500);
  set("force", 600);
  set("max_force", 600);
  set("force_factor", 35);
  set_skill("spear", 80);
  set_skill("unarmed", 80);
  set_skill("changquan", 70);
  set_skill("parry", 80);
  set_skill("dodge", 80);
  set_skill("yang_spear", 70);
  map_skill("spear", "yang_spear");
  map_skill("parry", "yang_spear");
  map_skill("unarmed", "changquan");
  setup();

  carry_object("/d/city/obj/weapon/spear/tiespear")->wield();
  carry_object("/d/city/obj/armor/tongjia")->wear();
}

int accept_fight(object me) {
  command("say 我为殿前将军，岂能与你村野匹夫较艺！");
  return 0;
}
