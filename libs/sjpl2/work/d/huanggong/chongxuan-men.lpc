inherit ROOM;

void create() {
  set("short", "重玄门");
  set("long", @LONG

这是通向大明宫的重玄门，庄严肃穆，金壁辉煌，宫墙里面
殿阁高大雄伟，层层叠叠，琉璃瓦白玉掾富丽堂皇。此刻宫门紧
闭，门前守卫着几位金甲武士。

LONG);

  set("objects", ([ /* sizeof() == 2 */
    __DIR__ "npc/weishi": 3,
    __DIR__ "npc/lvshi": 1,
  ]));
  set("outdoors", 1);
  set("exits", ([ /* sizeof() == 2 */
    "northup": __DIR__ "baiyujie",
    "south": __DIR__ "guangchang",
  ]));

  setup();
}

int valid_leave(object me, string dir) {
  if (me->query("class") == "official")
    return ::valid_leave(me, dir);
  if (dir == "northup") {
    if (objectp(present("lv shi", environment(me))))
      return notify_fail("吕史金枪一横，喝道：此乃皇宫，禁行！\n");
    if (objectp(present("wei shi", environment(me))))
      return notify_fail("金甲卫士喊道：我家将军不在，小人不敢放您进去！\n");
  }
  return ::valid_leave(me, dir);
}
