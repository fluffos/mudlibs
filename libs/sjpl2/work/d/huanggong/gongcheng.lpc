inherit ROOM;

void create() {
  set("short", "宫城");
  set("long", @LONG
这是被皇城高大城墙包围的宫城。宫城从建筑气势上来看虽然
不如皇城宏伟，但无处不显示出精雕细琢和金碧辉煌。高高的黄色
飞龙旗遍插城头，别有一番威严。
LONG);

  set("objects", ([ /* sizeof() == 2 */
    __DIR__ "npc/weishi": 3,
    __DIR__ "npc/lvkuang": 1,
  ]));
  set("outdoors", 1);
  set("exits", ([ /* sizeof() == 4 */
    "south": __DIR__ "chengtian-men",
    "northeast": __DIR__ "danfeng-men",
    "northwest": __DIR__ "xuanwu-men",
  ]));

  setup();
}

int valid_leave(object me, string dir) {
  if (me->query("class") == "official")
    return ::valid_leave(me, dir);
  if (dir == "northwest" || dir == "northeast") {
    if (objectp(present("lv kuang", environment(me))))
      return notify_fail("吕旷银枪一横，喝道：此乃皇宫，禁行！\n");
    if (objectp(present("wei shi", environment(me))))
      return notify_fail("金甲卫士喊道：我家将军不在，小人不敢放您进去！\n");
  }
  return ::valid_leave(me, dir);
}
