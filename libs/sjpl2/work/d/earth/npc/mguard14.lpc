// taoist_guard.c  by baiwt@sjpl 5,17,2000
//法术：［祭云符］ 属性：召唤  对象：雷神  克星：无
//法术：［放雨符］ 属性：雨  对象：all  克星：无
#include <ansi.h>
inherit NPC;
int magic_more(object who);

void create() {
  set_name("龙人", ({ "longren", "taoist guard" }));
  set("gender", "男性");
  set("age", 20);
  set("attitude", "peaceful");

  set("mguard", "mguard14");
  set("mguard_level", 14);
  set("magic_power", 70);

  set("str", 42);
  set("cor", 52);
  set("cps", 22);

  set("max_kee", 1000);
  set("max_gin", 1000);
  set("max_sen", 1000);

  set("limbs", ({ "头部", "身体", "爪子", "尾巴" }));
  set("verbs", ({ "claw" }));
  set("last_load_time", uptime());
  set("max_mana", 700);
  set("mana", 700);

  set("combat_exp", 140000);
  set_skill("dodge", 200);
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: magic_more(this_object()) :),
  }));

  set_temp("apply/attack", 20);
  set_temp("apply/damage", 20);
  set_temp("apply/defence", 20);
  set_temp("apply/armor", 20);
  setup();

}
int magic_more(object who) {
  int i, mwp;
  object *enemy, mygod;
  seteuid(getuid());
  enemy = who->query_enemy();
  mwp = who->query("magic_power");
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      if (who->query("mana") < 50) return 1;
      if (!objectp(present("cloud god", environment(who)))) {
        mygod = new("/daemon/troop/maoshan/cloudgod");
        message_vision(HIC "\n$N喃喃念动咒语，只见一张符纸缓缓飘上半空。" NOR, who, enemy[i]);
        message_vision(HIC "\n不久只见天上云层滚滚，遮天蔽日，天色立时变了！" NOR, who, enemy[i]);
        message_vision(HIC "\n随着一声闷雷响过，雷神的身影渐渐在云层中浮现出来。\n" NOR, who, enemy[i]);
        message_vision(HIG "［祭云符］！\n\n" NOR, who, enemy[i]);
        mygod->move(environment(who));
        if (who->query("mana") >= 50)
          who->add("mana", -50);
        return 1;
      }
      message_vision(HIR "\n$N对满天的云层拜了几拜，只见天色立时变黑，云层开处，" NOR, who, enemy[i]);
      message_vision(HIR "\n倾盆的大雨哗哗地直倒了下来，顷刻间暴雨如注！\n" NOR, who, enemy[i]);
      message_vision(HIG "［放雨符］！\n\n" NOR, who, enemy[i]);
      if (random(enemy[i]->query("magic_defense")) < random(500))
        enemy[i]->receive_wound("kee", mwp);
      if (who->query("mana") >= 50)
        who->add("mana", -50);
      COMBAT_D->report_status(enemy[i], 1);
    }
  }
  return 1;
}

int heal_up() {
  object who = this_object();
  if (!who->is_fighting() && (uptime() - (int)who->query("last_load_time")) > (random(500) + 300)) {
    call_out("leave", 1);
    return 1;
  }
  return ::heal_up() + 1;
}

void leave() {
  message("vision",
    HIW + name() + "的身影渐渐虚化，变做了一道白烟。\n\n"
    "白烟随风飘散，很快消失了......\n" NOR, environment(),
    this_object());
  destruct(this_object());
}
