// taoist_guard.c  by baiwt@sjpl 5,17,2000
//法术：［风沙甘霖咒］ 属性：heal  对象：me  克星：无
//法术：［狐气聚］ 属性：attack  对象：all  克星：无
#include <ansi.h>
inherit NPC;
int magic_more(object who);

void create() {
  set_name("狐狸精", ({ "hulijing", "taoist guard" }));
  set("gender", "女性");
  set("age", 20);
  set("attitude", "peaceful");

  set("mguard", "mguard35");
  set("mguard_level", 35);
  set("magic_power", 170);

  set("str", 32);
  set("cor", 52);
  set("cps", 22);

  set("max_kee", 1000);
  set("max_gin", 1000);
  set("max_sen", 1000);

  set("limbs", ({ "头部", "身体", "爪子", "尾巴" }));
  set("verbs", ({ "claw" }));
  set("last_load_time", uptime());
  set("max_mana", 1700);
  set("mana", 1700);

  set("combat_exp", 350000);
  set_skill("dodge", 200);
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: magic_more(this_object()) :),
  }));

  set_temp("apply/attack", 20);
  set_temp("apply/damage", 20);
  set_temp("apply/defence", 20);
  set_temp("apply/armor", 20);
  setup();

}
int magic_more(object who) {
  int i, mwp;
  object *enemy;
  seteuid(getuid());
  enemy = who->query_enemy();
  mwp = who->query("magic_power");
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      if (who->query("mana") < 50) return 1;
      if (who->query("kee") < who->query("max_kee") * 3 / 4) {
        message_vision(HIC "\n$N喃喃念动咒语，不久只见春风乍起，地上沙尘飞舞，树枝摇动，" NOR, who, enemy[i]);
        message_vision(HIC "\n那些树叶上的露水被风一吹都飘洒在空气中，到处是一片生机盎然。\n" NOR, who, enemy[i]);
        message_vision(HIG "［风沙甘霖咒］！\n\n" NOR, who);
        who->receive_curing("kee", mwp);
        who->receive_heal("kee", mwp);
        who->receive_curing("sen", mwp);
        who->receive_heal("sen", mwp);
        if (who->query("mana") >= 50)
          who->add("mana", -50);
        COMBAT_D->report_status(who, 1);
        return 1;
      }
      message_vision(HIM "\n$N摇身一变，竟然变成一只白色狐狸，尾巴朝$n一挥，" NOR, who, enemy[i]);
      message_vision(HIM "\n顿时一股腥臭弥漫在空气中，令人难以忍受！！\n" NOR, who, enemy[i]);
      message_vision(HIG "［狐气聚］！\n\n" NOR, who);
      if (random(enemy[i]->query("magic_defense")) < random(500))
        enemy[i]->receive_wound("kee", mwp);
      if (who->query("mana") >= 50)
        who->add("mana", -50);
      COMBAT_D->report_status(enemy[i], 1);
    }
  }
  return 1;
}

int heal_up() {
  object who = this_object();
  if (!who->is_fighting() && (uptime() - (int)who->query("last_load_time")) > (random(500) + 300)) {
    call_out("leave", 1);
    return 1;
  }
  return ::heal_up() + 1;
}

void leave() {
  message("vision",
    HIW + name() + "的身影渐渐虚化，变做了一道白烟。\n\n"
    "白烟随风飘散，很快消失了......\n" NOR, environment(),
    this_object());
  destruct(this_object());
}
