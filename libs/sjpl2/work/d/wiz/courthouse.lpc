// Room: /d/wiz/courthouse.c

#include <ansi.h>
void test_me(object me);
inherit ROOM;

void create() {
  set("short", "法院");
  set("long", @LONG
这里是[31m书剑飘零[37m的巫师审问[33m机器人[37m的法院，你一定是被人检举或是
行为太像机器人，才会来到这里，如果你答不出审判官的三个问题，会
被做上记号，超过三次的人将会被处以极刑，好好回答吧。
LONG
  );
  set("no_fight", 1);
  set("hell", 1);
  set("no_study", 1);
  set("no_magic", 1);
  set("no_spells", 1);
  set("objects", ([
    __DIR__ "npc/judge": 1 ]));

  setup();
}
void init() {
  object ob;
  if (interactive(ob = this_player()))
    test_me(ob);
  add_action("close_cmds", "burn");
  add_action("close_cmds", "drop");
  add_action("close_cmds", "get");
  add_action("close_cmds", "give");
  add_action("close_cmds", "fight");
  add_action("close_cmds", "sjpl");
  add_action("close_cmds", "sjpl*");
  add_action("close_cmds", "rumor");
  add_action("close_cmds", "rumor*");
}
void test_me(object me) {
  me->set_temp("old_startroom", me->query("startroom"));
  me->set("startroom", __FILE__);
  /*
	if( userp(me) && (int)me->query("daode") < -1000 && (int)me->query("combat_exp") > 20000 )
	{
	me->apply_condition("force_disease", 1);
	me->set("startroom", "/d/city/ciensi");
	}
	if( userp(me) && (int)me->query("combat_exp") < 10000 )
	{
	me->set("startroom", "/d/fuzhou/duchang");
	}
	*/
}
int close_cmds(object me, string arg) {
  return 1;
}
