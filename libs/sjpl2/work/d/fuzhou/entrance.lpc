// Room: /u/fuzhou/entrance.c

inherit ROOM;

string look_sign(object me);

void create() {
  set("short", "福州城");
  set("long", @LONG
这里是福州城的入口.
    福州城坐落在福建省的东部，闽江北岸的一个重要港口城
市, 以其商业发达和盛产茶叶而为来往客商们所青睐。北边沿
着官道一直走可以进入浙江境内，城南有个渡口, 过了闽江再
往南走就是传说中的世外桃源。
    镇上很是热闹, 在这里就能听到南边集市上传来的叫卖声。
    入口处有个公告(sign), 不知是写了些什么。 
LONG
  );
  set("exits", ([ /* sizeof() == 3 */
    "north": __DIR__ "guanroad1",
    "south": __DIR__ "nwroad1",
  ]));
  set("item_desc", ([ /* sizeof() == 1 */
    "sign": (: look_sign :),
  ]));
  set("no_clean_up", 0);
  set("objects",
    ([  //sizeof() == 1
    "/npc/newnpc/niu": 1,
    ]));
  set("hell", 1);

  setup();
  //	replace_program(ROOM);
}
string look_sign(object me) {
  return "公告上写着:  振远镖局招聘镖师\n";
}
