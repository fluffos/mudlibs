inherit ROOM;

void create() {
  set("short", "青石官道");
  set("long", @LONG
这是一条宽敞坚实的青石大道，向北延伸。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "south": __DIR__ "guanroad1",
    "north": "/d/shandong/ta/boat_south",
  ]));
  set("outdoors", "shandong");
  set("hell", 1);

  setup();
