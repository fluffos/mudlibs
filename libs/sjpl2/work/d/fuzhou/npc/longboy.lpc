#include <ansi.h>
inherit NPC;
int custom();
void create() {
  set_name("男孩", ({ "boy long", "boy" }));
  set("gender", "男性");
  set("age", 11);
  set("combat_exp", 20000);
  set("title", "普通百姓");
  set("chat_chance", 10);
  set("chat_msg", ({
    "男孩一脸的迷茫，幽幽道：我爹爹真是魔教天玄坛主吗？\n",
    "男孩天真的脸上时而流露出一丝忧伤。\n",
    "男孩忽然一脸的坚毅，说道：我将来一定要替焦大哥和月姐姐报仇！\n",
    "男孩说道：大哥哥，你几时带我上天柱山呀？\n",
  }));
  set("str", 90);
  set("id_type", 0);

  set("max_force", 11270);
  set("force", 11226);
  set("force_factor", 1);
  set("max_atman", 5000);
  set("atman", 5731);
  set("atman_factor", 100);
  set("mana", 5592);
  set_skill("unarmed", 20);
  set_skill("dodge", 20);
  set_skill("move", 20);
  set_skill("force", 20);
  set_skill("parry", 20);

  setup();
  carry_object("/obj/cloth")->wear();
}
