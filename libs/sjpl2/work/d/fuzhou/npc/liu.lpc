#include <ansi.h>
inherit NPC;
int custom();
void create() {
  set_name("柳愠孤", ({ "liu yungu", "liu" }));
  set("gender", "男性");
  set("age", 25);
  set("combat_exp", 3000000);
  set("title", "黄衣青年");
  set("chat_chance", 10);
  set("chat_msg", ({
    "黄衣青年自言自语道：爹，你放心，我会为你报仇的。\n",
    "黄衣青年说道：白蛛白紫桦的儿子不知是否尚在人世，否则与他联手，大仇应可得报。\n",
    "黄衣青年深深地叹了口气。\n",
    "黄衣青年轻轻抚摩着那堆乱石堆，忽然一滴泪珠滴在了石头上。\n",
  }));
  set("str", 90);
  set("id_type", 1);

  set("attitude", "heroism");
  set("max_force", 11270);
  set("force", 11226);
  set("force_factor", 10);
  set("max_atman", 5000);
  set("atman", 5731);
  set("atman_factor", 100);
  set("mana", 5592);
  set_skill("unarmed", 200);
  set_skill("dodge", 200);
  set_skill("move", 200);
  set_skill("force", 200);
  set_skill("parry", 200);
  set_skill("literate", 200);
  set_skill("iron-cloth", 200);
  set_skill("yoga", 200);

  set_skill("blood_strike", 200);
  set_skill("xuanzang_force", 200);
  set_skill("jinzhong_zhao", 200);
  set_skill("yixing_huanwei", 200);

  map_skill("unarmed", "blood_strike");
  map_skill("force", "xuanzang_force");
  map_skill("dodge", "yixing_huanwei");
  map_skill("iron-cloth", "jinzhong_zhao");
  map_skill("parry", "kongling_staff");

  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed.shuaibei" :),
  }));

  setup();
  carry_object("/obj/cloth")->wear();
}
