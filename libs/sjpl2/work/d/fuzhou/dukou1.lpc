inherit ROOM;

void create() {
  set("short", "闽江边");
  set("long", @LONG
这里就是凤凰山的山脚了。往北去是福州城和无风亦起浪的闽江了。
江面有艘快船,你只要大叫一声(chuhai)就能过江了.
岸边有块木牌,上面写着"暂不开放"
(洪字)
LONG
  );
  //	set("objects", ([ /* sizeof() == 2 */
  //    __DIR__"npc/xiaoling" : 1,
  //]));
  set("outdoors", "fuzhou");
  //	set("exits", ([ /* sizeof() == 1 */
  //  "north" : __DIR__"sroad1",
  //]));
  set("no_clean_up", 0);
  set("hell", 1);

  setup();
  //	replace_program(ROOM);
}

void init() {
  add_action("do_chuhai", "chuhai");
}

int do_chuhai() {
  object me = this_player();
  message_vision("$N架着小舟出海去了...\n", this_player());
  tell_object(me, "经过一段时间的海上漂泊，你终于看到了一个小岛.......靠岸了!\n");
  me->move("/d/fuzhou/dukou");
  message_vision("$N从小舟走了出来...\n", this_player());
  return 1;

}
