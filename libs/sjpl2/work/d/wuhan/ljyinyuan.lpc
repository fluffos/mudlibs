// Room: /u/wuhan/ljyinyuan.c

inherit ROOM;

void create() {
  set("short", "樱园");
  set("long", @LONG
你的四周是高高低低的樱花树。正是花期。花儿重重叠叠地
堆成各种样子, 世界如同穿着一件雍容华贵的礼服。花瓣儿在你
身旁纷纷绕绕地飞舞着, 宛如万千只粉蝶。
LONG
  );
  set("item_desc", ([
    "tree": @LONG
你发现一棵五人合抱的老树上隐隐刻着些字。那显然是很久远的
事了, 字已随着树的成长变得模糊不清, 辨得出的字是
      X与鹃携手同游于此XX  
                XX之字
      X携子之手与子携老XX
                XX
LONG
  ]));
  set("exits", ([ /* sizeof() == 2 */
    "southdown": __DIR__ "ljin2",
    "eastup": __DIR__ "ljjianya",
  ]));
  set("no_clean_up", 0);

  setup();
}
