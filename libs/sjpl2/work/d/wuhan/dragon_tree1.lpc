// dragon_tree1.c

inherit ROOM;

void create() {
  set("short", "梧桐树上");
  set("long", @LONG
你爬上梧桐, 置身于一个很大的支杈. 树枝及力的向四周伸展, 宽大的梧桐叶
完全遮住了树下人的视线. 
LONG
  );
  set("exits", ([
    "down": __DIR__ "dragon_yard",
  ]));
  set("objects", ([
    __DIR__ "npc/spy": 1,
  ]));
  set("item_desc", ([
    "树枝": "你仔细观察一下树枝, 发现有一根非常有弹性.\n"
  ]));
  setup();
}

void init() {
  add_action("do_swing", ({ "swing", "dang", "tan" }));
}

int do_swing(string arg) {
  object ob;

  if (arg != "树枝" && arg != "vine")
    return notify_fail("你荡什么?\n");
  tell_room(__DIR__ "dragon_wuding1",
    this_player()->query("name") + "荡过来.\n");
  if (ob = find_object(__DIR__ "dragon_wuding1")) {
    message_vision("$N在树枝一荡, 飞向空中.\n", this_player());
    this_player()->move(ob);
  }
  return 1;
}
