// dragon_strike.c

inherit SKILL;

mapping *action = ({
  ([ "action":
    "$N使一招「乱石穿空」, 两只手掌上下翻飞, 击向$n的$1",
    "dodge": 0,
    "damage": 50,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N使一招「惊涛拍岸」, 双掌带着隆隆雷声, 撞向$n的$1",
    "dodge": 20,
    "damage": 50,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N左手一个虚晃, 右手从肋下穿出, 使一招「樯橹灰飞烟灭」击向$n的$1",
    "dodge": -20,
    "damage": 50,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N长身而立, 目光忧郁地射向远方, 左手衣袖轻轻一挥, $n只觉得一股劲风\n"
    "迎面扑来, 击向自己的$1, 好一招「故垒西边」",
    "dodge": 0,
    "damage": 20,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N使一招「卷起千堆雪」击向$n的$1, $n只觉得满天都是掌影, 尽不知其来\n"
    "自何处击向何处!",
    "dodge": -10,
    "damage": 60,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N悠闲地举起右手, 使一招「还酹江月」默默地拍向$n的$1",
    "dodge": 50,
    "damage": 30,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N大吼一声, 腾空而起, 攻向$n的$1. 只见铺天盖地都是$N的人影\n"
    "正是望川之掌中的杀着「多少英雄人物」",
    "dodge": 100,
    "damage": 200,
    "damage_type": "瘀伤"
  ]),

});

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练望川之掌必须空手。\n");
  return 1;
}

int valid_enable(string usage) {
  return usage == "unarmed";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 30)
    return notify_fail("你的体力不够了，休息一下再练吧。\n");
  me->receive_damage("kee", 30);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "drag_strike" + action;
}
