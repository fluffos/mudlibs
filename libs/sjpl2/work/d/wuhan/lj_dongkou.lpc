// Room: /u/wuhan/lj_dongkou.c

inherit ROOM;
inherit F_ATTACK;

string she_out();
void create() {
  set("short", "珞珈山");
  set("long", @LONG
你来到一片开阔地, 前面竟然是块陡壁, 虽不太高, 却已是到了路
的尽头. 这里林木森森，茅草齐腰，草丛中隐约可见一泓泉水，水声叮
咚，甚为悦耳. 你突然觉得浑身不自在起来, 不禁抬起头来, 只见一棵
大树上分明停着一只大鸟正一眨不眨的盯着你.
LONG
  );
  //        set("hide_exits", ([
  //	"enter" : __DIR__"lj_dong",
  //]) );
  set("item_desc", ([
    "泉水": (: she_out :),
    "茅草": "你拨开齐腰的茅草, 却见山壁之中居然有一个黑黝黝的洞,\n"
    "不知道进去(enter)会有什么结果\n",
    "草丛": "你拨开齐腰的茅草, 却见山壁之中居然有一个黑黝黝的洞,\n"
    "不知道进去(enter)会有什么结果\n",
  ]));
  set("exits", ([
    "east": __DIR__ "ljup",
  ]));
  set("objects", ([
    __DIR__ "npc/diao": 1,
  ]));
  set("resource/water", 1);
  set("outdoors", "wuhan");
  setup();
}

void init() {
  add_action("do_enter", "enter");
}

string she_out() {
  object ob, diao;
  if (this_player()->query_temp("wuhan/she")) {
    return "那是一汪清泉, 清得看不见底。\n";
  }
  tell_object(this_player(), "那是一汪清泉, 清得看不见底。\n");
  tell_object(this_player(), "只见泉水中竟然斯斯然游出一条青蛇来!\n");
  message("vision", "突然不知从哪儿钻出一条青蛇来!\n", this_object(),
    this_player());
  ob = new(__DIR__ "hankou/npc/qingshe");
  ob->move(this_object());
  this_player()->set_temp("wuhan/she", 1);
  if (diao = present("diao", this_object())) {
    diao->kill_ob(ob);
    delete("she");
  }
  return "\n";
}

int do_enter() {
  object ob;
  object *ene;

  if (ob = present("diao", this_object())) {
    if (!ob->is_fighting())
      return notify_fail("忽然一股劲风卷来, 你不由得退了两步, 定神看时, 却见大雕站在你面前\n冷冷地看着你!\n");
    else {
      ene = ob->query_enemy();
      if (sizeof(ene) != 1)
        return notify_fail("大雕忽然一股劲风卷来, 使你不由得退了两步.\n");
      if (!ene[0]->id("shan qingshe"))
        return notify_fail("大雕忽然一股劲风卷来, 使你不由得退了两步.\n");
    }
  }
  tell_object(this_player(), "你拨开齐腰的茅草, 钻进洞去。\n");

  message("vision", "$N拨开齐腰的茅草, 突然不见了。\n",
    this_object(), this_player());
  tell_room(__DIR__ "lj_dong", this_player()->query("name") + "走过来。\n");
  this_player()->move(__DIR__ "lj_dong");
  return 1;
}
