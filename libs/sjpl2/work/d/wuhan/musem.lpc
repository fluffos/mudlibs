// musem.c

inherit ROOM;

void create() {
  set("short", "陈列室");
  set("long", @LONG
这里是萧通的陈列室。正中墙上挂着两幅画像(portrait)。两边各放着几个
桌案(desk)，上面放着展品。
LONG
  );

  set("item_desc", ([
    "portrait 1":
    @LONG
画像上面只写着“玄黄教主”四字，并无其名其姓。画像上也看不出玄黄教主
有多大年纪，只见他身穿一袭皱皱巴巴的长衫，无精打采地坐在一把椅子上，
象是刚刚睡醒，又象是在为什么犯愁。
LONG,

    "portrait 2":
    @LONG
画像上面写着“大侠方玉琪”五字。大侠看起来二十多岁年纪，只见他长发披肩，
双目如开似闭，炯然有神。他身穿一件极宽松的绿色长袍，卓然而立。一条丝带
在腰间很随便的一扎，带上歪歪斜斜地挂了把极长的宝剑，一直拖到地上。
LONG,
    "desk":
    "桌上放着颗黑不溜湫的丹丸。\n",
  ]));
  set("exits", ([ /* sizeof() == 1 */
    "south": __DIR__ "xyard",
  ]));


  set("objects", ([
    __DIR__ "npc/cguard": 2,
  ]));
  setup();
}
