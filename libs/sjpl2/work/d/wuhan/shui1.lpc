// shui1.c

inherit ROOM;

void create() {
  set("short", "江下");
  set("long", @LONG
这里水流湍急, 一个不小心你就会被冲得不知去向.
LONG);
  set("exits", ([
    "up": __DIR__ "jiangbian2",
    "down": __DIR__ "shui2",
  ]));
  set("objects", ([
    __DIR__ "npc/fish": 1,
  ]));
  set("outdoors", "wuhan");
  set("no_clean_up", 0);
  setup();
}

int valid_leave(object who, string exit) {
  if (exit == "down")
    if ((int)who->query_skill("diving", 1) < 20) {
      tell_object(who, "你的水下功夫不够!\n");
      return 0;
    }
  return 1;
}
