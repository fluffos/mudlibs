// Room: /d/wuhan/jiangb1.c

inherit ROOM;

void create() {
  set("short", "长江南岸");
  set("long", @LONG
“大江东去，浪淘尽，几许风云人物。”这里曾经是三国时的古战
场，阵阵清风从江面吹来，使人感到几分凉意。江面上有几叶轻舟，主
要是打鱼的。东面是紫金山，西南沿着江边小径走可以到达武昌。
LONG
  );
  set("objects", ([ /* sizeof() == 2 */
    __DIR__ "npc/daoke": 2,
    __DIR__ "npc/jianke1": 2,
  ]));
  set("outdoors", "jinling");
  set("exits", ([ /* sizeof() == 2 */
    "eastup": "/d/jinling/shanroad1",
    "west": __DIR__ "chuanwu",
    "southwest": __DIR__ "jiangb2",
  ]));
  set("no_clean_up", 0);
  setup();
  //        replace_program(ROOM);
}
void init() {
  add_action("do_chuhai", "chuhai");
}

int do_chuhai() {
  object boat;
  object me = this_player();
  if (!me->query_temp("fuzhou_boat"))
    return notify_fail("你没有船只，如何出海？\n");
  tell_object(me, "你将渔网、渔钩等捕鱼工具搬上了渔船。\n");
  message_vision("$N架着小舟出海去了...\n\n", this_player());
  boat = new(__DIR__ "yuzhou");
  me->move(boat);
  message_vision("\n$N扬起了风帆，迎着轻柔的海风，渔船缓缓驶入了东海海域。\n", this_player());
  return 1;
}
