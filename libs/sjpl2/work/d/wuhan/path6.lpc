// Room: /d/wuhan/shanzai/path6.c

inherit ROOM;

void create() {
  set("short", "山崖边");
  set("long", @LONG
你仍旧处于山崖边。脚下的崖壁爬附着藤蔓，几棵青松倔强地
挺立着。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "up": __DIR__ "path7",
    "westdown": __DIR__ "path5",
  ]));

  setup();
}

void init() {
  add_action("do_climb", "climb");
}

int do_climb(string arg) {
  if (arg != "down") return 0;

  message_vision("$N攀着藤蔓向山崖下爬去\n", this_player());
  tell_room(__DIR__ "downcliff", "有人从山上爬下来。\n");
  this_player()->move(__DIR__ "downcliff");
  return 1;
}
