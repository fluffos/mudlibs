// parry_book.c
#include <skill.h>
inherit ITEM;

void create() {
  set_name("拆招要旨", ({ "book" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("material", "paper");
    set("skill", ([
      "name": "parry",
      "exp_required": 100,
      "sen_cost": 30,
      "difficulty": 30,
      "max_skill": 81,
    ]));
  }
}
