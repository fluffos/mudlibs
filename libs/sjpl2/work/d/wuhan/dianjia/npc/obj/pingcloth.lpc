// pingcloth.c

#include <armor.h>

inherit CLOTH;

void create() {
  set_name("绣花丝裙", ({ "huaskirt" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一件手感绝佳的绣花丝裙\n");
    set("unit", "件");
    set("value", 600);
    set("material", "cloth");
    set("armor_prop/personality", 3);
    set("female_only", 1);
  }
  setup();
}
