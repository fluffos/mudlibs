*/
void drink() {
  object ob;
  /*
    if(environment()->query("short") == "点龙印家的内室"){
	command("go south");
	return;
    }
*/
  if (ob = present("dianskin", environment())) {
    ob->set("liquid/remaining", 15);
    command("get dianskin");
    command("drink dianskin");
    command("drop skin");
  } else
    command("say 谁把我的酒给拿走了!\n");
  return;
}

int map() {
  this_player()->set_temp("longyinmap", 1);
  return 0;
}

int accept_object(object who, object ob) {
  if (query_condition("duanchang_drug"))
    if (ob->query("name") == "断肠散的解药") {
      if (who->query_temp("longyinmap")
        && query("map")) {
        command("say 我不要脸，我不要脸"
          "我竟敢利欲熏心，我把地图交给你，你还给萍姑吧");
        __DIR__ "obj/map5"->move(who);
        delete("map");
      } else
        command("say 谢谢谢谢");
      call_out("chiyao", 1);
      return 1;
    }
  return 0;
}

void chiyao() {
  command("eat jieyao");
}
