// longyin.c

inherit NPC;
void movemove();
void drink();
int map();
void create() {
  set_name("点龙印", ({ "dian", "dian longyin" }));
  set("gender", "男性");
  set("title", "点家庄");
  set("long", "一个枯瘦的人\n");
  set("age", 50);
  set("str", 25);
  set("cor", 30);
  set("cps", 27);
  set("int", 10);
  set("attitude", "peaceful");

  set("max_force", 1000);
  set("force", 1000);
  set("force_factor", 2);

  set("inquiry", ([
    "地图": (: map :),
  ]));
  set("combat_exp", 200000);

  set_skill("unarmed", 60);
  set_skill("dodge", 60);
  set_skill("parry", 80);
  set_temp("apply/attack", 150);
  set_temp("apply/defense", 50);

  set("chat_chance", 10);
  set("chat_msg", ({
    (: movemove :),
    (: drink :),
  }));
  setup();

  carry_object("/obj/cloth")->wear();
}

