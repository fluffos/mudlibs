// xiaohong.c

inherit NPC;

void create() {
  set_name("小红", ({ "xiaohong" }));
  set("title", "点家庄");
  set("gender", "女性");
  set("age", 15);
  set("str", 10);
  set("cor", 24);
  set("cps", 11);
  set("per", 27);
  set("int", 21);

  set("max_force", 100);
  set("force", 100);

  set("long", "小红是点萍姑的贴身丫头\n");

  set("combat_exp", 5000);

  set("chat_chance_combat", 5);
  set("chat_msg_combat", ({
    "你还是走吧，萍太太看见了会打得你头破血流的！\n" }));

  set_skill("unarmed", 60);
  set_skill("parry", 40);
  set_skill("dodge", 50);
  set_skill("sword", 30);
  set_skill("force", 30);
  set_skill("literate", 10);


  setup();
  carry_object(__DIR__ "obj/pinksword")->wield();
}
