// lou3.c

inherit ROOM;

create() {
  set("short", "黄鹤楼--三楼");
  set("long", @LONG
这是传说中仙人画鹤而舞的地方, 如今墙上早已空空如也. 逝者如斯, 多少
古老的故事皆成渔樵闲话.
LONG);
  set("exits", ([
    "up": __DIR__ "lou4",
    "down": __DIR__ "lou2"
  ]));
  set("objects", ([
    __DIR__ "npc/gaolao": 1,
    __DIR__ "npc/ailao": 1,
  ]));
  setup();
}
