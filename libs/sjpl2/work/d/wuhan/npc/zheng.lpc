// girl-2.c

inherit NPC;

void create() {
  set_name("郑寡妇", ({ "zheng" }));
  set("gender", "女性");
  set("age", 36);
  set("str", 17);
  set("per", 29);
  set("long", @LONG
    郑寡妇看上去三十出头，颇有风韵，打扮得让人觉得不知在哪里过了
一点头。外面关于她的风言风语有不少，看她那样子，大概都是真的吧。
LONG
  );
  set("combat_exp", 30);
  set("attitude", "friendly");

  set("inquiry", ([
    "卢会南": "你是问那个憨憨的道长吗? 他倒是来问过烂铁剑的事情.",

    "烂铁剑": "这么一把破剑！我还是仔细藏在床底下的呢。怎么就会不见了呢？那天我也就出去了那么一会儿！一定是被哪个小偷给偷去了",
  ]));

  setup();
}
