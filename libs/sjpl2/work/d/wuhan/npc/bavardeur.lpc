// gaolao.c

inherit NPC;
void dochou();
void create() {
  set_name("吃茶客", ({ "man" }));
  set("long", "一位清瘦的老者\n");
  set("age", 60);
  set("chat_chance", 10);
  set("chat_msg", ({
    "吃茶客叹口气道：人心不古啊\n",
    "吃茶客神秘兮兮地说：您知道吗，当今皇上将前兵部尚书古谦古大人满门\n"
    "抄斩了！听说古大人倒是逃了出来\n",
  }));
  setup();
  carry_object("/obj/cloth")->wear();
}
