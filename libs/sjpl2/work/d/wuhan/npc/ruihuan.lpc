// ruihuan.c

inherit NEW_VENDOR;

int on_service = 0;

void create() {
  set_name("老陈头", ({ "waiter chen", "chen", "waiter" }));
  set("long", @LONG
老陈头是海鲸帮帮主的好友, 为人很是和蔼可亲. 他功夫据说很高
但没有人见他用过. 他不愿加入帮内俗事, 就帮余志枭开了这家酒楼
也自是悠闲自在. 
LONG);
  set("age", 51);
  set("merchandise", ([
    "/obj/food/baozi": 50,
    "/obj/food/jitui": 20,
    "/obj/food/jiudai": 20,
  ]));
  set("attitude", "friendly");
  set("str", 67);
  set("int", 30);
  set("spi", 30);
  set("con", 30);
  set("force", 1500);
  set("max_force", 1500);
  set("force_factor", 5);

  set_skill("unarmed", 80);
  set_skill("force", 100);
  set_skill("dodge", 30);
  set_skill("literate", 100);
  //	set_skill("celestrike", 100);
  set_skill("pyrobat-steps", 100);
  //        set_skill("celestial", 100);

  set("combat_exp", 1000000);
  set("score", 20000);

  //        map_skill("force", "celestial");
  //        map_skill("unarmed", "celestrike");
  map_skill("dodge", "pyrobat-steps");

  setup();

  carry_object("/obj/cloth")->wear();
}

void init() {
  ::init();
  add_action("do_vendor_list", "list");
  add_action("do_buy", "buy");

}
