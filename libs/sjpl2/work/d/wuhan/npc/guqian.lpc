// guqian2.C

inherit NPC;
string guqian();
create() {
  set_name("古谦", ({ "guqian" }));
  set("age", 56);

  set("str", 31);
  set("cor", 30);
  set("combat_exp", 1000000);
  set("max_force", 4000);
  set("force", 5000);
  set("force_factor", 10);

  set("max_kee", 3000);
  set("eff_kee", 3000);
  set_skill("dodge", 100);
  set_skill("blade", 150);
  set_skill("spring-blade", 150);
  set_skill("unarmed", 100);
  set_skill("parry", 150);
  set_skill("force", 100);
  map_skill("blade", "spring-blade");
  map_skill("parry", "spring-blade");

  set_temp("apply/attack", 30);
  set_temp("apply/defense", 30);
  set_temp("apply/dammage", 60);

  setup();
  carry_object("/d/wuhan/hankou/npc/obj/mabuc.lpc")->wear();
  carry_object("/d/wuhan/hankou/npc/obj/qingblade.lpc")->wield();
}
