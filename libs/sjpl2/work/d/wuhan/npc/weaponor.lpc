// weaponor.c

inherit NEW_VENDOR;

void create() {
  set_name("建封", ({ "weaponor" }));
  set("title", "兵器铺老板");
  set("gender", "男性");
  set("age", 41);
  set("long", "风流潇洒的中年人\n");
  set("combat_exp", 20000);
  set_skill("unarmed", 100);
  set_skill("dodge", 100);
  set_skill("sword", 60);

  set("merchandise", ([
    "/obj/weapon/whip": 10,
    "/obj/weapon/longsword": 20,
    "/obj/weapon/dart": 100,
    "/obj/weapon/shield": 20,
    "/obj/weapon/sixhammer": 20,
    "/obj/weapon/thin_sword": 20,
    "/obj/weapon/dagger.lpc": 20,
  ]));

  setup();
  add_money("silver", 25);
  carry_object("/obj/cloth")->wear();
  carry_object("/obj/weapon/longsword")->wield();
}

void init() {
  ::init();
  add_action("do_vendor_list", "list");
  add_action("do_buy", "buy");
}
