// linglong.c


inherit NPC;
string givejiu(object me);
void create() {
  set_name("玲珑子", ({ "linglong" }));
  set("title", "桂园主人");
  set("gender", "男性");
  set("age", 73);
  set("int", 26);
  set("long",
    "鹤发童颜的老者\n");
  set("inquiry", ([
    "桂花醇酒": (: givejiu :),
  ]));
  set("combat_exp", 1000000);
  set_skill("literate", 60);
  set("jiu", 1);
  setup();
}

string givejiu(object me) {
  if (is_fighting() || !living(this_object())) return 0;
  if (query("jiu")) {
    delete("jiu");
    command("smile");
    command("say " + "您居然知道老朽的这门手艺? 来来!!尝尝味道如何?");
    __DIR__ "obj/guijiu"->move(this_object());
    command("give jiudai to " + this_player()->query("id"));
  } else
    command("shrug");
  return "呵呵\n";
}

void reset() {
  set("jiu", 1);
}
