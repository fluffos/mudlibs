// spy.c

inherit NPC;

void create() {
  object ob;

  set_name("黑衣人", ({ "spy" }));
  set("gender", "男性");
  set("age", 24);
  set("long",
    "这个男人看起来鬼鬼祟祟的，想必不是什麽好东西。他神情很紧张。\n");
  set("combat_exp", 6000);
  set("score", 400);
  set_skill("throwing", 50);
  set_skill("unarmed", 20);
  set_skill("sword", 20);
  set_skill("parry", 20);
  set_skill("dodge", 60);
  setup();
  ob = carry_object("/d/oldpine/obj/throwing_knife");
  ob->set_amount(30);
  ob->wield();
  carry_object("/d/oldpine/obj/black_suit")->wear();
  //	carry_object("/obj/dust")->set_amount(30);
  carry_object(__DIR__ "obj/key1");
}


void killed_enemy(object who) {
  command("say 哈哈哈哈哈哈...");
  call_out("dissolve", 1);
}

void dissolve() {
  command("dissolve corpse");
}
