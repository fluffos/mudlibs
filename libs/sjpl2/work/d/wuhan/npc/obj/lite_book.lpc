// lite_book.c

inherit ITEM;

void create() {
  set_name("诗词详解", ({ "literate book", "book" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long",
      "这是学习读书识字的书\n");
    set("material", "paper");
    set("skill", ([
      "name": "literate",
      "exp_required": 100,
      "sen_cost": 40,    // gin cost every time study this
      "difficulty": 30,    // the base int to learn this skill
      // modify is gin_cost's (difficulty - int)*5%
      "max_skill": 61  // the maximum level you can learn
      // from this object.
    ]));
  }
}
