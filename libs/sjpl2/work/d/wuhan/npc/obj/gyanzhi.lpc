// yanzhi.c

inherit ITEM;

void create() {
  set_name("贡品胭脂", ({ "yanzhi" }));
  set("long", "这是一盒包装精美华丽的胭脂, 乃是夷国佛廊希的贡品.\n"
    "涂(tu)在脸上会令你增色不少\n");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("value", 1000);
    set("weight", 50000);
    set("unit", "盒");
  }
  setup();
}

void init() {
  add_action("do_tu", ({ "tu" }));
}

int do_tu(string arg) {
  if (arg != "yanzhi")
    return notify_fail("你涂什么?\n");
  if (this_player()->query("gender") != "女性") {
    CHANNEL_D->do_channel(this_player(), "rumor", "大家来看"
      +this_player()->query("name") + "抹胭脂啊! 羞羞羞!!!");
    return notify_fail("你个大男人, 羞也不羞?\n");
  }
  if (this_player()->query_temp("mark/gyanzhi"))
    return notify_fail("你已经搽过胭脂了\n");
  message_vision("$N含羞带笑地把胭脂涂在脸上\n", this_player());

  this_player()->set_temp("mark/gyanzhi", 1);
  this_player()->add_temp("apply/personality", 10);
  return 1;
}
