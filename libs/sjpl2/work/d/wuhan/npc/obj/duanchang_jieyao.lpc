// duanchang_jieyao.c

inherit ITEM;
inherit F_FOOD;

void create() {
  function f;
  object ob;

  set_name("断肠散的解药", ({ "jieyao" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是断肠散的解药\n");
    set("unit", "粒");
    set("food_remaining", 1);
    set("food_supply", 1);
  }
  setup();
}

void init() {
  add_action("do_eat", "eat");
}

int do_eat(string arg) {
  object drug;
  function f; object me = this_player();
  drug = present(arg, this_player());
  if (!drug || drug != this_object()) return 0;

  message_vision("$N将断肠散的解药吃下去\n", me);
  if (this_player()->query_condition("duanchang_drug")) {
    me->apply_condition("duanchang_drug", 0);
    tell_object(me, "你的断肠散毒被解除了\n");
  }
  destruct(drug);
  return 1;
}
