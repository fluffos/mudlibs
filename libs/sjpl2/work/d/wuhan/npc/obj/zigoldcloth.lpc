// zicloth.c

#include <armor.h>

inherit CLOTH;

void create() {
  set_name("镶金紫龙袍", ({ "zi cloth", "cloth" }));
  set_weight(3000);
  set("value", 5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "cloth");
    set("armor_prop/armor", 5);
    set("armor_prop/dodge", 1);
  }
  setup();
}
