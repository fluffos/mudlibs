// jasmine_hat.c

#include <armor.h>

inherit HEAD;

void create() {
  set_name("紫云盘龙冠", ({ "jasmine hat", "hat" }));
  set_weight(1000);
  set("value", 10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "顶");
    //		set("material", "hat");
    set("armor_prop/armor", 10);
    set("armor_prop/dodge", 1);
  }
  setup();
}
