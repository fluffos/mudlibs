  set("water", 400);
  set("food", 400);

  set_skill("unarmed", 40);
  set_skill("dodge", 30);
  set_skill("dragon-steps", 30);
  set_skill("force", 60);
  set_skill("dragonforce", 40);
  set_skill("dragon_strike", 40);
  set_skill("diving", 60);
  set_skill("fonxansword", 40);
  set_skill("parry", 40);
  set_skill("sword", 40);

  map_skill("sword", "fonxansword");
  map_skill("parry", "fonxansword");

