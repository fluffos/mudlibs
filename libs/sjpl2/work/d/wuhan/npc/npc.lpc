  carry_object("/obj/example/sword")->wield();
  carry_object(__DIR__ "obj/zigoldcloth")->wear();
}

void init() {
  add_action("do_app", ({ "apprentice" }));
}

int accept_fight(object ob) {
  if (ob->query("class") == "zilongbang") {
    command("say 好, 自帮兄弟点到为止!");
    return 1;
  }
  return 0;
}

int do_app(string arg) {
  object ob = this_player();

  if (arg == "hufa")
    if (ob->query("class") == "zilongbang") {
      message_vision("柳护法对$N说道：你我既然同是一家人, 我这身武艺, " + RANK_D->query_respect(ob) +
        "就随便学吧!\n", this_player());
      ob->set("marks/柳护法", 1);
      return 1;
    }
  //         call_other("/cmds/std/apprentice", "main", this_player(),arg);
  return 1;
}

int recognize_apprentice(object ob) {
  if (!ob->query("marks/柳护法")) return 0;
  return 1;
}
// hufa2.c

#include <ansi.h>

inherit NPC;

void use_poison();

void create() {
  set_name("蓝宫柳", ({ "lan hufa", "lan", "hufa" }));

  set("nickname", "飞花仙子");
  set("gender", "女性");
  set("age", 22);
  set("long",
    "蓝宫柳是晚月庄的弟子, 刚加入紫龙帮不久. 她美得刺你的眼.\n");
  set("attitude", "peaceful");
  set("class", "zilongbang");

  set("str", 21);
  set("int", 28);
  set("spi", 26);
  set("per", 30);
  set("cps", 30);

  set("force", 800);
  set("max_force", 800);
  set("force_factor", 8);

  set("combat_exp", 100000);
  set("score", 90000);

  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: use_poison :),
    (: exert_function, "chillgaze" :),
  }));

  set_skill("unarmed", 40);
  set_skill("sword", 70);
  set_skill("throwing", 150);
  set_skill("force", 30);
  set_skill("parry", 70);
  set_skill("dodge", 100);
  set_skill("literate", 100);
  set_skill("whip", 100);

  set_skill("stormdance", 130);
  set_skill("tenderzhi", 130);
  set_skill("iceforce", 150);
  set_skill("snowwhip", 150);

  map_skill("dodge", "stormdance");
  map_skill("unarmed", "tenderzhi");
  map_skill("force", "iceforce");
  map_skill("whip", "snowwhip");
  map_skill("parry", "snowwhip");

  set_temp("apply/defense", 100);

  setup();

  carry_object("/obj/weapon/whip")->wield();
  carry_object(__DIR__ "obj/zigoldcloth")->wear();
}

void init() {
  add_action("do_app", ({ "apprentice" }));
}

void use_poison() {
  object *enemy, ob;
  string msg;

  enemy = query_enemy();
  if (sizeof(enemy)) ob = enemy[random(sizeof(enemy))];

  if (ob->query_condition("rose_poison")) return;

  tell_object(ob,
    "你觉得脸上似乎沾上了什麽东西，伸手一摸却什麽也没有。\n");
  if (random(query("combat_exp")) > (int)ob->query("combat_exp"))
    ob->apply_condition("rose_poison", 20);
}

int do_app(string arg) {
  object ob = this_player();
  if (arg == "hufa")
    if (ob->query("class") == "zilongbang") {
      if (ob->query("gender") == "女性") {
        command("pat" + ob->query("id"));
        command("say 你我既然同是一家人, 我这身武艺, 小姑娘就随便学吧!");
        ob->set("marks/蓝宫柳", 1);
        return 1;
      }
      command(":D");
      return notify_fail(" 男人们都走开点!\n");
    }
  //        return ::attemp_apprentice(this_object());
}

int recognize_apprentice(object ob) {
  if (!ob->query("marks/蓝宫柳")) return 0;
  return 1;
}
int accept_fight(object ob) {
  if (ob->query("class") == "zilongbang") {
    command("say 好, 自帮兄弟点到为止!");
    return 1;
  }
  return 0;
}

// drangon_hufa3.c

inherit NPC;

void create() {
  set_name("杨凤亭", ({ "yang hufa", "yang", "hufa" }));
  set("gender", "男性");
  set("title", "紫龙帮刑堂堂主");
  set("age", 40);
  set("str", 30);
  set("cor", 30);
  set("cps", 30);
  set("per", 30);
  set("int", 35);


  set("max_force", 2200);
  set("force", 4200);
  set("force_factor", 4);

  set("long",
    "杨凤亭乃天邪弟子, 一生浸淫春风快意刀法, 武功还在於兰天武之上.\n");


  set("combat_exp", 800000);
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: exert_function, "powerup" :),
    (: exert_function, "recover" :),
  }));
  set("water", 600);
  set("food", 600);
  set_skill("force", 100);
  set_skill("blade", 80);
  set_skill("parry", 150);
  set_skill("dodge", 80);

  set_skill("celestial", 100);
  set_skill("spring-blade", 180);
  set_skill("pyrobat-steps", 90);

  map_skill("force", "celestial");
  map_skill("blade", "spring-blade");
  map_skill("dodge", "pyrobat-steps");

  setup();

  carry_object(__DIR__ "obj/yangblade")->wield();
  carry_object(__DIR__ "obj/zigoldcloth")->wear();
}

void init() {
  add_action("do_app", ({ "apprentice" }));
}

int accept_fight(object ob) {
  if (ob->query("class") == "zilongbang") {
    command("say 好, 自帮兄弟点到为止!");
    return 1;
  }
  return 0;
}

int do_app(string arg) {
  object ob = this_player();

  if (arg == "hufa") {
    message_vision("$N向杨凤亭请教武学的疑问.\n", this_player());
    if (ob->query("class") == "zilongbang") {
      if (ob->query_kar() >= 28) {
        command("say " + RANK_D->query_respect(ob) +
          "和我有缘, 我这身功夫你好好学吧!\n");
        ob->set("marks/杨凤亭", 1);
        return 1;
      } else {
        command("say " + RANK_D->query_respect(ob) +
          "缘份不够, 就不用勉强了吧..\n");
        return 1;
      }
    }
  }
  return (int)call_other("/cmds/std/apprentice", "main", ob, arg);
}

int recognize_apprentice(object ob) {
  if (!ob->query("marks/杨凤亭")) return 0;
  return 1;
}
