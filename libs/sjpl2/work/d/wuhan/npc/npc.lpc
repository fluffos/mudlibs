// gaolao.c

inherit NPC;
void dochou();
void create() {
  set_name("高老者", ({ "oldman" }));
  set("long", "一位清瘦的老者\n");
  set("age", 101);
  set("chat_chance", 5);
  set("chat_msg", ({
    (: dochou :),
    "高老者说道：当年玄妙教可谓盛极天下，那教主姓甚名谁却也无人能知。\n",
    "高老者说道：那大侠凌云之却是天下第一大侠，听得天下竟然有如此一大邪教，顿时只身前往\n"
    "玄妙浙江舟山总坛。那一仗玄妙教主恰好不在，凌大侠把个玄妙教弄得人仰马翻。\n",
    "高老者说道：却说天下第一大侠凌云之和天下第一异人玄妙教主这一战共斗了七天七夜，只杀\n"
    "得天昏地暗难解难分，这一战后两人竟然前嫌尽释，从此成了密友。那玄妙教主本也是\n"
    "个洒脱的人，当即就把玄妙教给散了，留在武汉与凌大侠共研武功奇术。\n",
    "高老者说道：凌大侠的这位恋人是姓王还是姓黄，后人倒是众说纷芸，闺名却是无人能晓。\n",
    "高老者说道：想那王女侠乃是天仙般的人物，凌大侠对其也爱护备至，不料有情人终难成眷属，\n"
    "实在是可叹可惜。\n",
    "高老者说道：其实感情的事往往因人而异，那王女侠论容貌自可称的上人间仙子，论性情也可\n"
    "谓温柔体贴，却因为出身富贵，不免眼高于顶，小姐脾气不小。其实于情爱间如何能使\n"
    "的了性子呢，相信女侠若干年后也终于是明白的。\n",
    "高老者说道：凌大侠玄妙教主离去时，留下的经书珠宝藏在一处，又将地图分为若干，散落人\n"
    "间。两人留话云：后世有缘者得之！这两派的弟子门人也随之隐姓埋名，再也没在江湖\n"
    "中露过脸。\n",
  }));
  setup();
  carry_object(__DIR__ "obj/yandou")->wield();
  carry_object("/obj/cloth")->wear();
}

void init() {
  object me;
  ::init();
  if (interactive(me = this_player())) call_out("dosign", 1);
}

void dosign() {
  command("sigh");
  command("say 这两位先人退隐江湖算来也有千儿八百年了吧");
}

void dochou() {
  if (present("yandou", this_object()))
    command("chou yandou");
}
