int accept_fight(object me) {
  command("say 阁下又在说笑话了，在下一介书生，哪会什么武功。");
  return 0;
}

int accept_object(object who, object ob) {
  object pill;
  int n;

  if (ob->value() >= 50000)
    if ((pill = present("pill", who))
      && pill->query("name") == "丹丸"
      && !pill->query("special")) {
      destruct(pill);

      n = random(10000);
      if (n < 1000)
        pill = new(__DIR__ "obj/pill1");
      else if (n < 2000)
        pill = new(__DIR__ "obj/pill2");
      else if (n < 3200)
        pill = new(__DIR__ "obj/pill3");
      else if (n < 4000)
        pill = new(__DIR__ "obj/pill4");
      else if (n < 4003)
        pill = new(__DIR__ "obj/pill5");
      else if (n < 7000)
        pill = new(__DIR__ "obj/pill6");
      else if (n < 7020)
        pill = new(__DIR__ "obj/pill7");
      else if (n < 7030)
        pill = new(__DIR__ "obj/pill8");
      else if (n < 7040)
        pill = new(__DIR__ "obj/pill9");
      else if (n < 7045)
        pill = new(__DIR__ "obj/pill10");
      else if (n < 9000)
        pill = new(__DIR__ "obj/pill11");
      else
        pill = new(__DIR__ "obj/pill12");
      pill->set("special", 1);
      pill->move(who);
      command("say 好了我在丹丸上面作了标签");
      return 1;
    }
  //
  if (ob->query("name") == "无名纸卷") {
    command("say 这是大侠凌云之的武功心得啊！据说大侠与教主有次\n"
      "乘船出游，覆于江中，许多物品都遗落了\n");
    return 1;
  }
  //	    
  if (ob->query("id") == "zhipian") {
    command("say 哎呀！这可是稀罕物啊！你是什么地方发现的？也难怪你不认识上面的字？\n"
      "这可是教主的手迹！说什么某年某月某日藏书鹦鹉洲下刻字处前走(qian)二十步\n"
      "右走(you)三十步掘地(jue)可得乱掘者死也．．．这是何意？什么刻字处藏的又是\n"
      "什么书？这我得想一想．．．\n");
    return 1;
  }
  return 0;
}
#include <ansi.h>
inherit NPC;

void create() {
  set_name("瞎老头", ({ "xiazi" }));
  set("long", "这是一个形容憔粹的老头子, 双目灰蒙蒙的, 好象是被什么药物"
    "给弄瞎的\n");
  set("attitude", "aggresive");
  set("kee", 1000);
  set("max_force", 4000);
  set("force", 6000);
  set("force_factor", 5);
  set("str", 29);
  set_skill("dodge", 80);
  set_skill("unarmed", 120);
  set("combat_exp", 300000);
  set("water", 600);
  set("food", 1000);
  set_temp("apply/attack", 100);
  set_temp("apply/defense", 45);
  set_temp("apply/damage", 40);
  setup();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && living(this_object())) {
    tell_object(ob, HIR "\n瞎老头吼道：又有人想要来害我吗?\n\n");
    message("vision", HIR "\n瞎老头吼道：又有人想要来害我吗?\n\n" HIR
      , environment(), ob);
    kill_ob(ob);
    ob->fight_ob(this_object());
    call_out("addexp", 10);
  }
}

int addexp() {
  object ob;
  int i, n = sizeof(enemy);
  int value;

  remove_call_out("addexp");
  value = (int)4 / n;

  for (i = 0; i < n; i++) {
    ob = enemy[i];
    if (userp(ob) && environment(ob) == environment()
      && living(ob) && ob->query("combat_exp") < 150000) {
      ob->add("combat_exp", value);
    }
  }
  call_out("addexp", 10);
}

// yedong.c
#include <ansi.h>
#include <dbase.h>
#include <login.h>
#include <move.h>

inherit NPC;


void do_drink();
void create() {
  set_name("冬叶", ({ "dong ye", "dong" }));
  set("gender", "男性");
  set("age", 29);
  set("long", "一个文质彬彬的年青书生, 看起来满腹心事\n");
  set("str", 10);
  set("cor", 14);
  set("cps", 29);
  set("int", 40);

  set("combat_exp", 100);
  set("chat_chance", 6);
  set("chat_msg", ({
    "冬叶喃喃地说: 明天就要与黄家小姐相见, 我却如何找不着胭脂了呢? 这可如何是好?\n",
    "冬叶叹了口气: 今天连去抄书的心情都没有了...\n",
    (: do_drink :),
  }));
  set("attitude", "friendly");
  set_skill("unarmed", 20);
  set_skill("dodge", 60);

  set("inquiry", ([
    "黄家小姐": "黄家小姐是我的未婚妻子!\n",
    "胭脂": "胭脂是黄小姐送我的定情信物, 丢了可如何是好?\n",
    "抄书": "这两天我都在郭东家家里抄书.\n",
  ]));
  setup();
  carry_object("/obj/cloth")->wear();
  add_money("coin", 200);
  carry_object("/obj/example/wineskin");
}

void do_drink() {
  object *list, ob;
  int i, can_drink;
  if ((int)this_object()->query("water") >= 100) return;
  list = all_inventory(this_object());
  i = sizeof(list);
  can_drink = 0;
  while (i--) {
    if ((string)list[i]->query("liquid/type") == "alcohol") {
      ob = list[i];
      can_drink = 1;
    }
  }
  if (can_drink) {
    command("drink " + (string)ob->query("id"));
    if ((int)ob->query("liquid/remaining") == 0) {
      command("drop wineskin");
      ob = new("obj/example/wineskin");
      ob->move(this_object());
    }
  }
}

int accept_object(object who, object ob) {
  if (ob->name() != "贡品胭脂") return 0;
  command(":P");
  command("thank " + who->id());
  command("say 这太好了... 太好了... 您怎么找到的?");
  command("say 这样吧, 我带你去见锦, 她一定很高兴认识你.");
  call_out("huangjia", 1, who);
  return 1;
}

void huangjia(object ob) {
  if (!living(this_object()) || !ob || environment(ob) != environment()) return;

  this_object()->move("/u/wuhan/hankou/hxbr");

  ob->move("/u/wuhan/hankou/hxbr");
  command("say 锦, 我来看你了. 给你介绍一个好朋友, 你知道...");
  message("vision",
    "黄家小姐听完冬叶的叙说, 不由得拧这他的耳朵娇怒道: 我看你还...\n"
    "冬叶轻轻的拥著黄家小姐。\n"
    "黄家小姐对着" + ob->name() + "大笑道: 这可要多谢" + RANK_D->query_respect(ob)
    + ". 这杯酒非喝不可.\n"
    "黄家小姐把一壶酒塞给" + ob->name() + "...\n"
    +ob->name() + "一高兴仰脖子把整壶酒都给喝了.\n"
    +ob->name() + "脚下一个不稳，跌在地上一动也不动了。\n"
    "冬叶叹了口气: 你就喜欢喝酒, 又总爱把人家灌醉\n"
    "黄家小姐笑得嘴巴都合不起来.\n"
    "黄家小姐叫了几个丫头, 说道: 北厢房不是空着吗? 送这位"
    +RANK_D->query_respect(ob) + "去歇息罢\n"
    "冬叶在黄家小姐的额头上吻了一下说道: 那我们明天还是老地方?\n"
    "一朵红云飞上了黄家小姐的面颊\n",
    "/u/wuhan/hankou/hxbr", ob);

  tell_object(ob,
    "黄家小姐听完冬叶的叙说, 不由得拧这他的耳朵娇怒道: 我看你还...\n"
    "冬叶轻轻的拥著黄家小姐。\n"
    "黄家小姐对着你大笑道: 这可要多谢" + RANK_D->query_respect(ob)
    + ". 这杯酒非喝不可.\n"
    "黄家小姐把一壶酒塞给你...\n"
    "你一高兴仰脖子把整壶酒都给喝了.\n",
    "/u/wuhan/hankou/hxbr", ob);
  ob->set_temp("block_msg/all", 1);
  ob->move("/u/wuhan/hankou/hngr");

  tell_room("/u/wuhan/hankou/hngr",
    "两个丫头把" + ob->name() + "放抬进来, 在床上\n");
  ob->set_temp("block_msg/all", 0);
  ob->unconcious();
  command("wave");
  this_object()->move("/u/wuhan/lou2");
  return;
}
