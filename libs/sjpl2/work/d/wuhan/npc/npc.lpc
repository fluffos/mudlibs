void init() {
  add_action("dokill", ({ "kill" }));
}

int accept_fight(object ob) {
  object weapon;

  if (ob->query("class") == "zilongbang") {
    command("say 好, 自帮兄弟点到为止!");
    if (weapon = query_temp("weapon"))
      command("unwield sword");
    set("force_factor", 0);
    return 1;
  }
  return 0;
}

int dokill(string arg) {
  object weapon;

  if (!this_object()->id(arg)) return 0;
  message_vision("\n$N对著$n喝道：「"
    +RANK_D->query_rude(this_object())
    + "！今日不是你死就是我活！」\n\n", this_player(), this_object());

  command("laugh");
  set("force_factor", 3);
  if (weapon = present("sword", this_object()))
    command("wield sword");
  this_object()->kill_ob(this_player());
  this_player()->kill_ob(this_object());
  return 1;
}
inherit NEW_VENDOR;
string feng();
string jieyao();

void create() {
  set("title", "江湖朗中");
  set_name("风大仙", ({ "feng" }));
  set("longer", "一个江湖朗中\n");
  set("combat_exp", 1000);
  set("unarmed", 20);
  set("chat_msg", ({
    "风大仙大声叫道：嗨！卖药罗！卖药罗！祖传秘方！祖传秘方！\n",
    "风大仙恨恨道：他妈的，你可以当老板，我却只能跑江湖！\n"
  })
  );
  set("chat_chance", 10);
  set("inquiry", ([
    "祖传秘方": "您要不要毒药，祖传秘方特灵，只要一两金子\n",
    "断肠散的解药": (: jieyao :),
    "风拂柳": (: feng :),
  ]));
  set("merchandise", ([
    __DIR__ "obj/medicine": 100,
    __DIR__ "obj/duan": 30,
  ]));
  setup();
  carry_object("/obj/cloth")->wear();
}

void init() {
  ::init();
  add_action("do_vendor_list", "list");
  add_action("do_buy", "buy");
}

int accept_object(object who, object ob) {
  object drug;

  if (ob->value() != 10000) return 0;
  drug = new(__DIR__ "obj/duanchang");
  drug->move(who);
  command("say 好好！这个您拿着！\n");
  tell_object(who, "风大仙偷偷地塞给你个东西\n");
  return 1;
}

string jieyao() {
  object money, ob, me;
  int amount;

  me = this_player();
  if (!(money = present("gold_money", me)))
    return "您得带点金子啊！\n";
  amount = (int)money->query_amount();
  if (amount == 1) destruct(money);
  else money->set_amount(amount - 1);
  __DIR__ "obj/duanchang_jieyao"->move(me);
  message_vision("风大仙从$N身上拿走一两金子，又塞给$N个东西\n", me);
  return "很好！很好！\n";
}

string feng() {
  this_player()->set_temp("fengfuliu", 1);
  return "哼！不错，那是我大哥，要不是他占着那本毒经\n"
    "我现在也当老板了．．．\n";
}
// dukous.c

inherit ROOM;

void create() {
  set("short", "长江大渡口--武昌");
  set("long", @LONG
这里是著名的长江大渡口。长江浩荡东去，蔚为壮观，你不禁有诗兴大发
之感。一位商贾立时看出端详, 连忙对你说: 您且打住吧! 咱们过江可是要把
半条性命丢在江面上的, 莫要再用之乎者也来烦我。要吟诗您尽可以去蛇山黄
鹤楼。那里什么疯子都有。
    这里人多口杂, 有各种来历的人。一根柱子上贴着张告示(sign).
LONG
  );
  set("item_desc", ([
    "sign":
    @LONG
                告示
   最近大渡口不断发生抢劫事件, 请客人们注意好     
身边行李.
   客人们可以喊船过江(guojiang).
   特此通告!
                        长江大渡口
LONG
  ]));
  set("exits", ([ /* sizeof() == 2 */
    "south": __DIR__ "snakec1",
    "west": __DIR__ "jiangbian1",
  ]));
  set("objects", ([
    __DIR__ "npc/shangren": 1,
    __DIR__ "npc/youngman": 1,
    __DIR__ "obj/boat": 1
  ]));
  setup();
}

void init() {
  add_action("do_shang", ({ "shangchuan" }));
  add_action("do_jiaochuan", ({ "guojiang" }));
}

int do_shang() {
  object ob, ob1;

  if (!(ob1 = present("boat", this_object())))
    return notify_fail("船还没来呢!!\n");
  if (ob = find_object(__DIR__ "boatin")) {
    destruct(ob1);
    this_player()->move(ob);
    tell_object(this_player(), "你上了船。\n");
    ob->delete("exits/out");

    if (ob1 = present("boater", ob)) destruct(ob1);

    ob1 = new(__DIR__ "npc/boater1");
    ob1->move(ob);
    ob = new(__DIR__ "npc/obj/nticket");
    ob->move(ob1);
  }
  return 1;
}


int do_jiaochuan() {
  object ob, ob1;
  message_vision("$N对着江面喊道: 过江...\n", this_player());
  if (present("boat", this_object()))
    return notify_fail("船已经在这儿了, 你可以上船(shangchuan).\n");
  if (ob = find_object(__DIR__ "dukoun")) {
    if (!ob = present("boat", ob))
      return notify_fail("请等一会再叫! 船还在江上.\n");
    destruct(ob);
    if (ob = find_object(__DIR__ "boatin")) {
      // 		if( !ob->sizeof(exits) )
      //			return notify_fail("请等一会再叫! 船还在江上.\n");
      if (!ob1 = present("boater", ob)) ob1 = new(__DIR__ "npc/boater1");
      ob1->move(ob);

      ob = new(__DIR__ "npc/obj/sticket");
      ob->move(ob1);
    }
  }
  return 1;
}
