void kill();
void create() {
  set_name("蘅大爷", ({ "heng" }));
  set("long", "蘅大爷很气派的样子，双目有神，两耳垂肩。\n");
  set("gender", "男性");

  set("attitude", "friendly");
  set("food", 500);
  set("water", 500);
  set("str", 20);
  set("per", 30);
  set("con", 20);
  set("int", 20);
  set("cps", 20);

  set("combat_exp", 2000000);
  set("force", 10000);
  set("max_force", 10000);
  set("force_factor", 150);

  set("max_sen", 10000);
  set("sen", 10000);
  set("max_kee", 10000);
  set("kee", 10000);
  set("max_gin", 10000);
  set("gin", 10000);
  set_skill("dodge", 400);

  set_temp("apply/attack", 100);
  set_temp("apply/defense", 100);
  set_temp("apply/damage", 100);
  set_temp("apply/armor", 10);

  set("chat_chance", 5);
  set("chat_msg", ({
    (: recover :),
    "蘅大爷道：嗨！看那个小姑娘，模样挺水灵嘛！\n",
    "蘅大爷说道：武昌也就这黄鹤楼还可以看看，大能你说是不是？\n",
    "蘅大爷道：若不是当年喝了贡来的桂花醇酒，正...呃...\n"
    "这次也不会在武汉呆这么久。只可惜一直找不到。\n",
  }));
  set("chat_chance_combat", 5);
  set("chat_msg_combat", ({ (: kill :) }));
  setup();
}

void reset() {
  int i;
  object *list;

  delete("jiudai");
  list = all_inventory(this_object());
  i = sizeof(list);
  while (i--)
    destruct(list[i]);

}

void recover() {

  set("eff_sen", 10000);
  set("sen", 10000);
  set("eff_kee", 10000);
  set("kee", 10000);
  set("eff_gin", 10000);
  set("gin", 10000);
}

int accept_object(object who, object ob) {
  if (ob->query("name") == "桂花醇酒" && ob->id("jiudai")) {
    if (query("jiudai") < 5) {
      command("say 太好了！这真是急正...呃...我之所需啊，来！赏你二两金子");
      ob = new("/obj/money/gold");
      ob->set_amount(2);
      ob->move(who);
      add("jiudai", 1);
      return 1;
    } else {
      command("say 真是正...呃...所需的酒！可是我已经快喝醉了！");
      return 0;
    }
  }
  return 0;
}

void kill() {
  int n = sizeof(enemy), i;
  object ob, me;

  if (!(ob = present("peng daneng", environment()))) {
    ob = new(__DIR__ "baobiao");
    ob->move(environment());
  }

  for (i = 0; i < n; i++) {
    me = enemy[i];
    if (userp(me) && environment(me) == environment()) {
      ob->kill_ob(me);
      me->fight_ob(ob);
    }
  }
}

