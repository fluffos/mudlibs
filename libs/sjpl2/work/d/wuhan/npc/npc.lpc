// cllectr.c

inherit NPC;

void create() {
  set_name("萧通", ({ "xiao", "collector" }));
  set("title", "收藏家");
  set("gender", "男性");
  set("age", 46);

  set("inquiry", ([
    "玄妙教主": "玄妙教主乃是千百年来罕见的人才，据说有人在西方一\n"
    "块乐土上见过他的仙踪，不知是否是真的\n",
    "凌云之": "大侠凌云之武功上的境界千百年来世人只可仰止，据说\n"
    "有人在西方一块乐土还见过他老人家的侠踪，不知是否是真的\n",
    "大侠凌云之": "大侠凌云之武功上的境界千百年来世人只可仰止，据说\n"
    "有人在西方一块乐土还见过他老人家的侠踪，不知是否是真的\n",
    "纸片": "什么？你给我看看！\n",
    "平龙认": "没听说过\n",
    "丹丸": @LONG
这种丹丸和玄妙教主有大大的关系。当年有一段时间教主致力于
练丹术，不料教主也有做不成的事情，终于没有练成长生不老的丹药。教主
不久就有新的兴趣，随之把练丹的事忘得一干二净。他老人家练过的丹丸也
就散落人间。这些丹丸有的吃了虽不能长生不老却能强身健体，有的吃了则
大病不起。老夫对此到有研究，天下恐怕只有我一人能鉴别。不过鉴别一次
我是要收五两金子的。
LONG,
    //
    "文卜": "哈哈！想不到你对玄妙教主也有如此的兴趣，文卜是\n"
    "玄妙教主的四大弟子之一！\n",
    "郭佤": "郭佤是玄妙教主的四大弟子之一！此人信佛，自称伏\n"
    "虎罗汉，又号弘灵禅师，据说使一手好禅杖。\n",
    "师基": "师基是玄妙教主的四大弟子之一！据说此人凶捍无比\n",
    "非叶": "非叶是玄妙教主的四大弟子之一！此人信道，据说深\n"
    "得教主真传\n",
    "玄妙教主的四大弟子":
    "话说玄妙教主遣散教众之后，有四个弟子追随他来到武汉。待到\n"
    "教主与凌大侠西去后，就在没有这四个人的消息了。这四个人各叫做文卜，郭佤，\n"
    "师基，非叶。\n",
    //
    "点点": "哈哈！想不到你对凌大侠也有如此的研究，点点是凌大侠\n"
    "的三大弟子之一！\n",
    "田一": "田一是凌大侠的三大弟子之一。他使一口宝剑叫映月梅花\n",
    "屠双": "屠双是凌大侠的大弟子\n",
    "凌大侠的三大弟子":
    "凌大侠只收了三个弟子，分别叫做点点，田一，屠双\n",
    //
    "映月梅花": "那是田一的兵器啊！\n",
    //
    "真毒经": "哦！毒经其实不分真假，只是据说玄妙教主曾著有一本\n"
    "「毒经」，和平常的毒经大不相同。听说有人在归元寺藏经阁里见\n"
    "过，不过自从清涟那老和尚不知去哪儿修行后就再没人看见过了\n",
  ]));
  set("str", 22);
  set("cor", 30);
  set("cps", 30);
  set("int", 26);
  set("per", 23);
  set("con", 24);
  set("spi", 30);
  set("kar", 25);

  set("long",

    "萧通是有名的收藏家。不但收藏，他还搞研究，对于玄妙教主和大侠凌云之，\n" "当今世上可能没有人比他更有了解了，远近八方不少人都来向他请教。据说\n"
    "他手头有玄妙教主所著《平龙认》的头三页，是以练得雄厚内力。不过他平\n"
    "时足不出户，没有谁真看见过他和别人比试。\n"

    "现在萧通正拿着一面水晶小透镜，细细观察着桌上的一片锈铁。\n");

  set("combat_exp", 100000);
  set("attitude", "friendly");
  set("env/wimpy", 70);

