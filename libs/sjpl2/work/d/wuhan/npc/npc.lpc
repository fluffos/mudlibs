void use_poison() {
  object *enemy, ob;
  string msg;

  enemy = query_enemy();
  if (sizeof(enemy)) ob = enemy[random(sizeof(enemy))];

  if (ob->query_condition("rose_poison")) return;

  tell_object(ob,
    "你觉得脸上似乎沾上了什麽东西，伸手一摸却什麽也没有。\n");
  if (random(query("combat_exp")) > (int)ob->query("combat_exp"))
    ob->apply_condition("rose_poison", 20);
}

int accept_object(object who, object ob) {
  if (ob->value() < 10000) {
    command("say 这东西不值钱 ！");
    command(":D");
    return 0;
  }
  if (ob->value() < 200000) {
    command("say 对不起，你的钱不够 ！");
    command(":D");
    return 0;
  }

  tell_object(this_player(),
    "穷说道： 桌子(desk)上有一点儿狗食, 你可以找找(search)看还在不在!\n");
  command(":D");
  return 1;
}


#include "quest.h"

void doquest(object me) {
  int i;
  mapping qu;
  int n;
  n = me->query("zilong/quest");

  qu = quest[n];
  if (me->query("zilong/finished") != qu["name"]) {
    if (qu["name"] == "暂无任务") {
      message_vision("$N恭恭敬敬地向张学林磕头请安，叫道：「师父！」\n", me);
      message_vision("张学林欣慰地笑起来, 说道：「免礼, 免礼」\n", me);
      return;
    } else {
      message_vision("$N恭恭敬敬地向张学林磕头请安，叫道：「师父！」\n", me);
      message_vision("张学林微微一笑.\n", this_player());
      message_vision("张学林说道: 功夫练得如何啦? 怎么\n" + qu["name"] +
        "(" + qu["id"] + ")" + "还没有给我找来? 要多多努力才是啊!\n", me);
      return;
    }
  }
  qu = quest[n + 1];
  if (me->query("combat_exp") < qu["exp_required"]) {
    message_vision("$N恭恭敬敬地向张学林磕头请安，叫道：「师父！」\n", me);
    message_vision("张学林欣慰地笑起来, 说道：「免礼, 免礼」\n", me);
    return;
  }
  message_vision("$N恭恭敬敬地向张学林磕头请安，叫道：「师父！」\n", me);
  message_vision("张学林对$N点点头, 微笑道：「很好, 很好」\n", me);
  n++;
  me->set("zilong/quest", n);
  tell_object(me, "「你去把" + qu["name"] + "(" + qu["id"] + ")" + "找来给我！」\n");
  return;
}

