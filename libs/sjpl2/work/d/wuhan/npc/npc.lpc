// master.c
#include <ansi.h>
#include "quest.h"
inherit NPC;
inherit F_MASTER;

void create() {
  set_name("张学林", ({ "master dragon", "master", "dragon" }));
  set("nickname", "一笑威龙");
  set("gender", "男性");
  set("attitude", "friendly");
  set("class", "zilongbang");
  set("age", 27);
  set("str", 50);
  set("cor", 30);
  set("cps", 27);
  set("int", 30);

  set("max_force", 6000);
  set("force", 9000);
  set("force_factor", 200);

  set("water", 700);
  set("food", 700);

  set("rank_info/respect", "张帮主");

  set("long", @LONG
张学林是一个不高不矮的年轻人, 粗看一眼好象觉得他也很普通, 仔细一打量
你却发现他浑身上下都充满了魅力. 难怪他三十岁不到居然能独创紫龙帮, 崛
起江湖, 作了长江十八盘连营三十六环水寨的总头领. 
LONG
  );
  create_family("紫龙帮", 1, "帮主");

  set("combat_exp", 1900000);
  set("score", 200000);

  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    "张学林轻笑道: 阁下自己来找麻烦, 就别怪我手下不留情了!!!\n",

    (: perform_action, "unarmed.kongshou" :),
    (: perform_action, "dodge.youlong" :),
    (: perform_action, "unarmed.gulang" :),
  }));


  set_skill("unarmed", 290);
  set_skill("dodge", 290);
  set_skill("force", 290);
  set_skill("literate", 150);

  set_skill("dragonforce", 250);
  set_skill("dragon_strike", 280);
  set_skill("dragon-steps", 280);
  set_skill("diving", 85);

  map_skill("force", "dragonforce");
  map_skill("unarmed", "dragon_strike");
  map_skill("dodge", "dragon-steps");

  set("inquiry", ([
    "name": "你既然知道我张帮主，怎麽不知道我是张学林？",
    "here": "这里便是紫龙帮总舵。",
    "瞎老头": "唉！这件事你就不要问了！不过这位老先生功夫\n"
    "惊世骇俗，和他交交手会大有进益的！\n",
  ]));

  setup();
  carry_object(__DIR__ "obj/jasmine_hat")->wear();
  carry_object(__DIR__ "obj/jasmine_cloth")->wear();
  carry_object(__DIR__ "obj/jasmine_boots")->wear();
}


void attempt_apprentice(object ob) {
  if (ob->query("betrayer"))
    message_vision("张学林轻蔑地看着$N道: 我帮不收不忠之徒!\n",
      ob);
  else {
    command("smile");
    command("say " + RANK_D->query_respect(ob)
      + "愿为鄙帮效力, 在下自是求之不得!!!"
    );
    command("recruit " + ob->query("id"));
  }
}

int recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob)) {
    message_vision("张学林又道: 入得我帮, 当知论功而行赏"
      "有德有才而据高位, 切记切记!!!\n", this_player());
    if (!ob->query("zilong/finished")) {
      tell_object(ob, "你第一个任务: 将长剑找来给我!\n");
      ob->set("class", "zilongbang");
      ob->set("title", "紫龙帮记名弟子");
      ob->set("zilong/quest", 0);
    } else
      ob->set("class", "zilongbang");
    return 1;
  }
}

int accept_object(object who, object ob) {
  int n;
  mapping qu;
  if (who->query("class") != "zilongbang") return 0;


  n = who->query("zilong/quest");
  qu = quest[n];

  if (ob->query("name") == qu["name"]
    && ob->id(qu["id"])
    && who->query("zilong/finished") != qu["name"]) {
    command("smile");
    command("pat " + ob->query("id"));
    command("say 从现在起你就是我帮" + qu["tit"] + "了！\n");
    who->set("title", "紫龙帮" + qu["tit"]);
    tell_object(who,
      sprintf(HIY "你被奖励了：\n%s点潜能\n%s点经验,\n" NOR,
        chinese_number(qu["pot"]),
        chinese_number(qu["exp"])));
    who->add("combat_exp", qu["exp"]);
    who->add("potential", qu["pot"]);
    who->set("zilong/finished", qu["name"]);
    return 1;
  }
  return 0;
}

int accept_fight(object ob) {
  object token;

  if ((int)ob->query("combat_exp") < 10000) {
    command("say " + RANK_D->query_respect(ob) +
      "功夫还得练练, 要动手去找本帮香主去吧!!");
    command("pat " + ob->query("id"));
    return 0;
  }
  if ((int)ob->query("combat_exp") < 100000) {
    command("say " + RANK_D->query_respect(ob) +
      "功夫还得练练, 要动手去找本帮舵主去吧!!");
    command("pat " + ob->query("id"));
    return 0;
  }
  if ((int)ob->query("combat_exp") < 200000) {
    command("say " + RANK_D->query_respect(ob) +
      "功夫还得练练, 要动手去找本帮护法去吧!!");
    command("pat " + ob->query("id"));
    return 0;
  } else {
    if (query("fight/" + ob->query("id")) < 10) {
      command("say 好！你接我一招！");
      add("fight/" + ob->query("id"), 1);
      COMBAT_D->do_attack(this_object(), ob);
      if ((int)ob->query("kee") < 1
        || environment(ob) != environment())
        command("say 哈哈！又一个自不量力的家伙");
      else {
        command("say 哈哈！你不错！来！我给你一块保命金牌，"
          "可不要随便给人");
        token = new(__DIR__ "obj/token3");
        token->set("owner", ob->query("id"));
        token->move(ob);
      }
    } else {
      command("say 哈哈！你已经接过我九招了");
      return 0;
    }
  }
}

