inherit NPC;

void create() {
  set_name("林太生", ({ "teacher", "lin" }));
  set("title", "教书先生");
  set("gender", "男性");
  set("age", 47);
  set("int", 26);
  set("long",
    "林太生是个博学多闻的教书先生，他自己写了不少关于\n"
    "诗文的书, 在武汉三镇流传甚广.\n"
    "他以教书为业，如果你付他\n"
    "一笔学费，就可以成为他的弟子学习读书识字。\n");
  set("inquiry", ([
    "学费": "嗯....知识是无价的，不过如果你有心的话——只要五两银子。\n",
    "书": "区区的薄文三两银子可以买到。",
    "诗文的书": "区区的薄文三两银子可以买到。",
  ]));
  set("attitude", "peaceful");
  set_skill("literate", 60);
  setup();
}

int recognize_apprentice(object ob) {
  if (!ob->query("marks/林太生")) {
    say("林太生说道：咦？我不记得收过你这个学生啊....\n");
    return 0;
  }

  return 1;
}

int accept_object(object who, object ob) {
  if (ob->value() == 300) {
    ob = new(__DIR__ "obj/lite_book");
    ob->move(who);
    say("林太生把一本书送给" + who->query("name") + ".\n");
    return 1;
  }
  if (!who->query("marks/林太生")) {
    if (ob->value() >= 500) {
      say("林太生点点头，说道：很好，从今天起你随时可以来问我有关读书识字(literate)\n"
        "                      的任何问题。\n");
      who->set("marks/林太生", 1);
      return 1;
    } else {
      say("林太生说道：你的诚意不够，这钱还是拿回去吧。\n");
      return 0;
    }
  } else
    say("林太生点了点头，说道：哦，向你这麽有心的学生还真是不多见，好好努力\n"
      "                      将来必定前途无量，谢了。\n");
  return 1;
}
