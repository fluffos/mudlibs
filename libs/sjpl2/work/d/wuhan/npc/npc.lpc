}

int accept_fight(object me) {
  object ob = environment();

  //	if( !( ob = present("young man", ob)))
  if (!(ob = present("youngman", ob)))
    return 0;
  ob->kill_ob(me);
  fight_ob(me);
  return 0;
}

int dokill(string arg) {
  object ob, me = this_player();
  if (!this_object()->id(arg)) return 0;
  if (ob = present("youngman", environment()))
    ob->kill_ob(me);
  return "/cmds/std/kill"->main(me, this_object());
}
