      tell_room("/u/wuhan/gbedroom", "郭太太突然惊叫道: 杀人啦!!!救命啊!!!再看她时, 竟然疯了.\n");
      ob->set("title", "疯了的");
      ob->set("chat_chance", 15);
      ob->set("chat_msg", ({ "郭太太失神落魄道: 杀人了...杀人了...\n" }));
    }
  ::die();
}
// guotai.c

inherit NPC;
void greet(object ob);
string yanzhi();
string give();

void create() {
  set_name("郭太太", ({ "guotai" }));
  set("attitude", "friendly");
  set("gender", "女性");
  set("age", 35);
  set("long", "郭太太要比郭老爷年轻得多, 生得端庄秀丽. \n"
    "此刻她脸上不知抹了些什么, 娇艳得无可方物\n");
  set("str", 15);
  set("per", 30);
  set("cps", 29);
  set("int", 20);

  set("max_kee", 300);
  set("kee", 300);
  set("food", 400);
  set("water", 400);

  set("combat_exp", 2000);
  set_skill("dodge", 30);
  set_skill("unarmed", 30);

  set("inquiry", ([
    "胭脂": (: yanzhi :),
    "脸上抹的什么": (: give :),
    "脸上不知抹了些什么": (: give :),
    "好东西": "好东西多的是啊，你问得好没来由",  //(: give :),
  ]));
  setup();
  //add_money("gold", 1);
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !query("title")
    && !is_fighting()) {
    call_out("greet", 1, ob);
  }
}

void greet(object ob) {
  if (!ob || environment(ob) != environment()) return;
  message_vision(
    "郭太太正对镜梳妆, 听到脚步声进来, 喜道:老爷您这次倒是真给我弄着\n"
    "个好东西, 您看...这时才抬起头来, 见是$N进来, 微微一惊, 急忙收口\n",
    ob);
  return;
}

string yanzhi() {
  if (query("title")) return "杀人了...杀人了...";
  message_vision("郭太太神色有些慌乱\n", this_player());
  return "您也喜欢胭脂吗? 汉口有一家香粉店卖胭脂特别有名的";
}

string give() {
  if (query("title")) return "杀人了...杀人了...";
  if (query("yanzhi")) return "我已经还叫人还给冬秀才了\n";
  set("yanzhi", 1);
  command("hmm");
  command("sigh");
  __DIR__ "obj/gyanzhi"->move(this_player());
  return "终究不是自己的东西终归得不到, 胭脂就凡请您转交给冬秀才罢\n"
    "郭太太从墙上一个暗盒里取出一盒胭脂交给" + this_player()->name() + "\n";
}

void die() {
  object *ulist, me, ob;
  int idx;
  tell_object(environment(), "\n郭太太惨叫一声：我死了化作鬼也不会放过你的!\n\n");

  ulist = all_inventory(environment());
  for (idx = sizeof(ulist) - 1; idx >= 0; idx--) {
    me = ulist[idx];
    if (!userp(me))
      continue;
    me->move("/u/wuhan/wnroad1");
  }
  __FILE__->move(environment());
  if (ob = find_object("/u/wuhan/ghall"))
    if (!(present("guo hong", ob)))
      __DIR__ "guohong"->move(ob);
  ::die();
  return;
}

void reset() {
  delete("yanzhi");
}
