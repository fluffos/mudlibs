// ailao.c

inherit NPC;
void do__chou();
void create() {
  set_name("矮老者", ({ "oldman" }));
  set("long", "一个胖胖的老头子.\n");
  set("age", 101);
  set("chat_chance", 5);
  set("chat_msg", ({
    "矮老者说道: 据说这两位原先可是对头, 后来不打不相识, 竟成了挚友.\n",
    "矮老者说道：那玄妙教主可是位不世出的奇才，精研各种奇门杂术，却对教务默不关心，教内\n"
    "鱼龙混杂，一时被江湖中称为天下第一邪教。\n",
    "矮老者说道：凌大侠舟山一战之后数日，玄妙教主便气势汹汹地杀到武汉要找凌大侠报毁总坛\n"
    "之耻。\n",
    "矮老者说道：传说中凌大侠去浙江时结识了一位女侠，竟然一见钟情。后来这位女侠也来到武\n"
    "汉，在珞珈山结庐而居。\n",
    "矮老者说道：珞珈山上这三位前辈仙人的旧居现在是无迹可寻了，但当年凌大侠手植的樱花和\n"
    "女侠栽种的梅花如今却是美丽的紧啊！\n",
    "矮老者说道：唉！情这个字，千万年来又有谁能堪得透呢？话说回来，当时若的的是情真意切，\n"
    "那黄女侠怎会误会于凌大侠呢？凌大侠便是看不穿这一层终于悄然离别江湖。\n",
    "矮老者说道：那庄误会却也没有人知道是什么，传说中黄女侠最终也明白凌大侠爱他的心意，\n"
    "知道错怪于他，但终于没有回头。凌大侠伤心之余，见事不可为，便要远离这伤心地，\n"
    "玄妙教主亦随之远行，不知仙踪何处。\n",
    "矮老者说道：这么多年过去了，还没有人能找到这分地图，这有缘者会是谁呢？如今武林正逢\n"
    "乱世，也许正是此人现身的时候了吧！\n",
    (: do__chou :),
  }));
  setup();
  carry_object(__DIR__ "obj/yanqiang")->wield();
  carry_object("/obj/cloth")->wear();
}

void init() {
  object me;
  ::init();
  if (interactive(me = this_player())) call_out("doagree", 2);
}

void doagree() {
  command("nod");
  command("say 是啊, 近千年来再没有任何人的武功能有出此二人其右者!");
}

void do__chou() {
  if (present("yanqiang", this_object()))
    command("chou yanqiang");
}
