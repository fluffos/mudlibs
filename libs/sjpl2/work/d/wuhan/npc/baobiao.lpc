// baobiao.c

inherit NPC;

void create() {
  set_name("彭大能", ({ "peng daneng", "peng" }));
  set("long", "这个人结实得象头牛，看手上的力气打死头老虎不成问题\n"
    "最好不要惹他生气");
  set("title", "随从");
  set("gender", "男性");

  set("attitude", "friendly");
  set("food", 500);
  set("water", 500);
  set("str", 40);
  set("per", 20);
  set("con", 20);
  set("int", 20);
  set("cps", 20);

  set("combat_exp", 2000000);
  set("force", 10000);
  set("max_force", 10000);
  set("force_factor", 150);

  set("max_sen", 10000);
  set("sen", 10000);
  set("max_kee", 10000);
  set("kee", 10000);
  set("max_gin", 10000);
  set("gin", 10000);

  set_skill("unarmed", 200);
  set_skill("parry", 200);
  set_skill("sword", 200);
  set_skill("crazy_sword", 150);
  set_skill("dodge", 200);

  map_skill("sword", "crazy_sword");
  map_skill("parry", "crazy_sword");

  set_temp("apply/dodge", 200);

  setup();
  carry_object("/obj/sword")->wield();
}
