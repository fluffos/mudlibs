// butou.c

#include <ansi.h>

inherit NPC;

void create() {
  set_name("锦衣卫", ({ "jinyiwei" }));
  set("long",
    "这是朝廷秘密组织的锦衣卫，武功之高不是一般江湖人士可以相比。\n");

  set("attitude", "heroism");
  set("vendetta_mark", "authority");
  set("pursuer", 1);

  set("str", 27);
  set("cor", 26);
  set("cps", 25);

  set("combat_exp", 1500000);
  set("score", 2000);
  set("daode", 400);
  set("max_force", 4000);
  set("force", 8000);
  set("force_factor", 150);
  set("chat_chance", 10);
  set("chat_msg", ({
    (: random_move :),
  }));

  set_skill("unarmed", 200);
  set_skill("blade", 200);
  set_skill("parry", 200);
  set_skill("dodge", 200);

  set_temp("apply/attack", 170);
  set_temp("apply/defense", 170);
  set_temp("apply/damage", 130);
  set_temp("apply/armor", 170);

  setup();

  carry_object("/obj/cloth")->wear();
  carry_object("/obj/blade")->wield();
}
