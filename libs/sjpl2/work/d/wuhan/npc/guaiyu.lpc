// serpent.c

inherit NPC;

void create() {
  set_name("怪鱼", ({ "guaiyu" }));
  set("long", "一条奇形怪状的大鱼, 有两个人那么长. 从一个石缝里\n"
    "游出来游进去\n");

  set("race", "野兽");
  set("age", 200);
  set("attitude", "aggressive");

  set("max_gin", 900);
  set("max_kee", 1300);
  set("max_sen", 500);

  set("str", 35);
  set("cor", 70);
  set("spi", 20);
  set("int", 10);

  set("limbs", ({ "头部", "躯干", "尾巴" }));
  set("verbs", ({ "bite" }));

  set_temp("apply/attack", 105);
  set_temp("apply/damage", 20);
  set_temp("apply/dodge", 100);
  set_temp("apply/armor", 30);

  set("combat_exp", 100000);
  set("score", 1000);
  setup();
}
