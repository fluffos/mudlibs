#include "/d/wuhan/npc/quest.h"

void doquest(object me) {
  int i;
  mapping qu;
  int n;
  n = me->query("haijing/quest");

  qu = quest[n];
  if (me->query("haijing/finished") != qu["name"]) {
    if (qu["name"] == "暂无任务") {
      message_vision("$N恭恭敬敬地向余志枭磕头请安，叫道：「师父！」\n", me);
      message_vision("余志枭欣慰地笑起来, 说道：「免礼, 免礼」\n", me);
      return;
    } else {
      message_vision("$N恭恭敬敬地向余志枭磕头请安，叫道：「师父！」\n", me);
      message_vision("余志枭微微一笑.\n", this_player());
      message_vision("余志枭说道: 功夫练得如何啦? 怎么\n" + qu["name"] +
        "(" + qu["id"] + ")" + "还没有给我找来? 要多多努力才是啊!\n", me);
      return;
    }
  }
  qu = quest[n + 1];
  if (me->query("combat_exp") < qu["exp_required"]) {
    message_vision("$N恭恭敬敬地向余志枭磕头请安，叫道：「师父！」\n", me);
    message_vision("余志枭欣慰地笑起来, 说道：「免礼, 免礼」\n", me);
    return;
  }
  message_vision("$N恭恭敬敬地向余志枭磕头请安，叫道：「师父！」\n", me);
  message_vision("余志枭对$N点点头, 微笑道：「很好, 很好」\n", me);
  n++;
  me->set("haijing/quest", n);
  tell_object(me, "「你去把" + qu["name"] + "(" + qu["id"] + ")" + "找来给我！」\n");
  return;
}
