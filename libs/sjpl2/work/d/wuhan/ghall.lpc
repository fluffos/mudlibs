// Room: /u/wuhan/ghall.c

inherit ROOM;

void create() {
  set("short", "客厅");
  set("long", @LONG
这里是郭家的客厅. 摆设却也简单的很, 让人觉不出是走进了大户人家.
厅里备有酒水, 郭老爷谦和得很, 常在这儿和下人们喝酒.
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "west": __DIR__ "gbedroom",
    "east": __DIR__ "wnroad1",
  ]));
  set("objects", ([
    __DIR__ "npc/guohong": 1,
  ]));
  setup();
}

int valid_leave(object me, string arg) {
  object ob;

  if (arg == "west")
    if ((ob = present("guo hong", this_object())) && living(ob))
      return notify_fail("郭宏笑着栏住你说: 那是在下的卧房, 您还是不要进去的好.\n");
  return ::valid_leave(me, arg);
}
