// Room: /u/wuhan/shanzai/path4.c

inherit ROOM;

void create() {
  set("short", "山崖边");
  set("long", @LONG
路好象在这里止住了，要仔细辨认才能发现崖边有条刚够踏脚
的石坎，一路向东延伸过去。你向山崖下望了一眼，忍不住一阵旋
晕。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "eastup": __DIR__ "path5",
    "northwest": __DIR__ "path3",
  ]));
  set("item_desc", ([
    "山崖": "你向山崖下望了一眼，忍不住一阵旋晕。要想爬下去恐怕不可能\n",
  ]));

  setup();
}

void init() {
  add_action("do_climb", "climb");
}

int do_climb(string arg) {
  if (arg == "山崖") return notify_fail("你往哪个方向爬?\n");
  if (arg == "down") return notify_fail("你试着往崖下爬，"
    "结果发现根本不可能\n");
  return 0;
}

int valid_leave(object who, string exit) {
  if (exit == "eastup") who->start_busy(2);
  return ::valid_leave(who, exit);
}
