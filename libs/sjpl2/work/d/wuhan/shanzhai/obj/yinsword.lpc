// yinsword.c

#include <weapon.h>

inherit SWORD;

void create() {
  set_name("映月梅花", ({ "yingyue" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是一把奇形古剑, 剑尖分出五道岔来, 作梅花状.\n");
    set("value", 50000);
    set("material", "stell");
  }

  init_sword(45);
  set("weapon_prop/personality", 1);
  setup();
}
