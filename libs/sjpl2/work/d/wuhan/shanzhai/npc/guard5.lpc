#include <ansi.h>

inherit NPC;

void create() {
  set_name("山寨头领", ({ "guard" }));
  set("long", "这是七大山寨的头领\n");
  set("attitude", "heroism");

  set("str", 27);
  set("cor", 26);
  set("cps", 25);
  set("per", 25);
  set("combat_exp", 250000);
  set("max_force", 2000);
  set("force", 2000);
  set_skill("unarmed", 20);
  set_skill("sword", 120);
  set_skill("parry", 120);
  set_skill("dodge", 120);
  set_skill("move", 100);
  set_skill("force", 200);

  set_temp("apply/dammage", 60);
  set_temp("apply/defense", 80);
  set_temp("apply/attack", 80);

  setup();

  carry_object("/obj/cloth")->wear();
  carry_object("/obj/longsword")->wield();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && living(this_object())) {
    kill_ob(ob);
  }
}

void unconcious() {
  object killer;
  if (objectp(killer = query_temp("last_damage_from"))) {
    set_temp("fainter", killer->query("id"));
  }
  ::unconcious();
}

void revive() {
  delete_temp("fainter");
  ::revive();
}

void die() {
  string id;
  if (objectp(killer = query_temp("last_damage_from"))) {
    if (!(id = query_temp("fainter"))
      || killer->query("id") == id)
      if (killer->query("combat_exp")
        < query("combat_exp"))
        killer->add("combat_exp", 100);
  }
  ::die();
}
