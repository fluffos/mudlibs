// Room: /u/wuhan/shanzhai/hall.c

inherit ROOM;

void create() {
  set("short", "聚义厅");
  set("long", @LONG
这里是山寨头领们议事的地方，摆设很简单，却显得很有气魄
。北边是寨主的书房，一扇门紧紧地关着。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "east": __DIR__ "square",
  ]));
  set("item_desc", ([
    "门": "这扇门(door)紧紧地关着。",
    "door": "这扇门紧紧地关着。",
  ]));
  set("objects", ([
    __DIR__ "guard5": 2,
  ]));
  setup();
}

void init() {
  add_action("do_knock", "knock");
}

int do_knock(string arg) {
  if (arg != "door")
    return 0;
  if (this_player()->is_fighting()) return notify_fail("打完架再说\n");

  message_vision("$N在门上敲了两下，过了一会儿，门上方开了一扇小窗，\n"
    "露出一双眼镜，", this_player());
  if (!present("pork", this_player())
    || !present("qskin", this_player())) {
    message_vision("然后小窗啪的一声关上，一个声音传出来\n"
      "没事别乱敲\n", this_player());
    return 1;
  }
  message_vision("接着一个声音传出来：原来是给寨主送饭来了\n"
    "小窗啪的一声关上，门旋即被打开\n", this_player());
  set("exits/north", __DIR__ "library");
  return 1;
}

void reset() {
  ::reset();
  delete("exits/north");
}
