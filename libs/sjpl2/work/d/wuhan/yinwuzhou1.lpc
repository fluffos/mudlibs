// yinwuzhou1.c

inherit ROOM;

void create() {
  set("short", "鹦鹉洲头");
  set("long", @LONG
你到了一个很大的岛. 平坦的沙滩上横七竖八躺着不少断碑.
LONG);
  set("item_desc", ([
    "断碑": "看来这是什么人用掌力震断的, 上面附满了青苔\n"
    "这显然是很早以前的事了\n"
  ]));
  set("exits", ([
    "east": __DIR__ "yinwuzhou2",
  ]));
  set("no_clean_up", 0);
  setup();
}


void init() {
  add_action("do_dive", ({ "dive" }));
}

int do_dive() {
  object ob;
  message_vision("$N纵身跳入江中\n", this_player());
  this_player()->move(__DIR__ "jiangbian3");
  return 1;
}
