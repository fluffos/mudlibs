// silverclub.c

inherit ITEM;

void create() {
  set_name("柱子", ({ "zhuzi", "yin zhuzi" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("long", "这是一根不知什么材料作成的矮柱，被牢牢的埋\n"
      "在地下，中轴的位置是一个洞\n");
    set("value", 100);
    set("no_get", 1);
  }
  setup();
}
