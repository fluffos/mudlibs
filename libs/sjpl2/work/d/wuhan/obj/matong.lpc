// matong.c

inherit ITEM;

void create() {
  set_name("粗木马桶", ({ "matong" }));
  set_weight(1000);
  set_max_encumbrance(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("value", 10);
    set("long", "这是一个很干净的马桶, 很大.");
  }
}

int is_container() { return 1; }
