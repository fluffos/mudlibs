// blade_book.c

inherit ITEM;

void create() {
  set_name("残破书卷", ({ "book" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long",
      "这本书已经被咬得不成样子, 但是依旧能看出些名堂来, 上面尽是些教主曰的句子.\n");
    set("material", "paper");
    set("skill", ([
      "name": "magic",
      "exp_required": 200,
      "sen_cost": 30,    // gin cost every time study this
      "difficulty": 20,    // the base int to learn this skill
      // modify is gin_cost's (difficulty - int)*5%
      "max_skill": 40    // the maximum level you can learn
      // from this object.
    ]));
  }
}
