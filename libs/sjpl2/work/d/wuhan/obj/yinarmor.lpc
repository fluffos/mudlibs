// yinarmor.c

#include <armor.h>

inherit CLOTH;

void create() {
  set_name("银盔甲", ({ "armor" }));
  set_weight(10000);
  set("value", 10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "silver");
    set("armor_prop/armor", 80);
    set("armor_prop/dodge", -20);
  }
  setup();
}
