// zsword.c

#include <weapon.h>
inherit SWORD;

void create() {
  set_name("梨鸶毗蹊", ({ "sword" }));
  set_weight(22000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是一把锋利无比的宝剑, 上面若隐若无的浮现出些奇怪的纹路\n");
    set("value", 200000);
    set("wield_msg", "$N拿出一把锋利无比的梨鸶毗蹊握在手中。\n");
    set("unwield_msg", "$N放下手中的$n。\n");
  }
  init_sword(100);
  setup();
}

void init() {
  add_action("do_study", "study");
}

int do_study(string arg) {
  object me = this_player(), ob = this_object();
  int cost;
  int my_skill;
  if (!id(arg)) return 0;
  if (me->is_fighting())
    return notify_fail("你无法在战斗中专心下来研读新知！\n");

  my_skill = me->query_skill("sword", 1) / 2;

  if (my_skill * my_skill * my_skill >
    (int)me->query("combat_exp")) {
    write("也许是缺乏实战经验，再怎麽读也没用。\n");
    return 1;
  }


  if (!me->query_skill("literate", 1))
    return notify_fail("你是个文盲，先学学读书识字(literate)吧。\n");

  message("vision", me->name() + "正专心地研读" + ob->name()
    + "。\n", environment(me), me);

  if ((int)me->query("combat_exp") < 100000) {
    write("你的实战经验不足，再怎麽读也没用。\n");
    return 1;
  }

  //      zjun

  cost = 30 + 30 * (30 - (int)me->query_int()) / 20;

  if (cost < 1)
    cost = 1;

  if ((int)me->query("sen") < cost) {
    write("你现在过於疲倦，无法专心下来研读新知。\n");
    return 1;
  }

  if (me->query_skill("sword", 1) > 200) {
    write("你研读了一会儿，但是发现上面所说的对你而言都太浅了，没有学到任何东西。\n");
    return 1;
  }

  me->receive_damage("sen", cost);

  if (!me->query_skill("sword", 1))
    me->set_skill("sword", 0);
  me->improve_skill("sword", (int)me->query_skill("literate", 1) / 5 + 1);
  write("你研读有关" + to_chinese("sword") + "的技巧，似乎有点心得。\n");
  return 1;
}
