// goushi.c

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("剩饭", ({ "rice" }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "一块脏兮兮黑乎乎的剩饭, 看来可以扔出去(throw),不知道狗吃不吃?\n");
    set("unit", "个");
    set("value", 15);
    set("food_remaining", 1);
    set("food_supply", 60);
  }
}
