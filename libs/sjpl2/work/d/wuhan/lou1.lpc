// lou1.c

inherit ROOM;

create() {
  set("short", "黄鹤楼--一楼");
  set("long", @LONG
这里画梁雕栋, 墙上悬挂着各式各样的条幅, 都是先人留下的墨宝. 地上
摆放着不少古碑. 向东的一面窗子是开着的, 阳光洒进来, 照得角落里亮堂堂
的. 
LONG);
  set("exits", ([
    "up": __DIR__ "lou2.lpc",
    "out": __DIR__ "snakec2.lpc",
  ]));
  set("valid_startroom", 1);
  setup();
  //	"/obj/board/shibei_b"->foo();
}

void init() {
  add_action("do_search", ({ "search" }));
}

int do_search(string arg) {
  object ob;

  if (arg != "角落")
    return notify_fail("你在什么地方找\n");
  if ((int)query("search_time") == 1)
    return notify_fail("东西被人捡走了\n");
  set("search_time", 1);
  message_vision("$N从地上捡起一个东西放在怀里\n", this_player());
  ob = new(__DIR__ "obj/token1");
  ob->move(this_player());
  return 1;
}

void reset() {
  ::reset();
  delete("search_time");
}
