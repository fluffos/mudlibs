// Room: /u/wuhan/lj_dong2.c     修改：禁止有引起玩家惰性的暴增经验活动

inherit ROOM;
string do_book();
void create() {
  set("short", "洞内");
  set("long", @LONG
这里已是一个天然的岩洞. 洞顶垂下数根粗大的钟乳, 一条
地下河静静地流过. 洞中间立着一座一人高的丹炉, 看不出造它
用的材料. 炉内依旧火光熊熊, 也不知烧的是什么, 又已经烧了
多少年头儿. 地上还散落着些金银, 此外再也看不出什么人类用
过的东西.
LONG
  );
  set("item_desc", ([
    "丹炉": "这是一座先古时代的丹炉, 你有什么不用的东西可以扔进去烧掉(burn).\n",
    "钟乳": (: do_book :),
  ]));
  set("exits", ([ /* sizeof() == 1 */
    "up": __DIR__ "lj_dong",
  ]));
  set("objects", ([
    "/obj/money/gold": 1,
    "/obj/money/silver": 1,
    __DIR__ "obj/silverclub": 1,
  ]));
  set("no_clean_up", 0);

  setup();
}

void init() {
  add_action("do_burn", "burn");
  add_action("do_get", "get");
}

int do_burn(string arg) {
  object ob;
  int amount;

  if (!arg)
    return notify_fail("你要烧什么?\n");
  if (!(ob = present(arg, this_player())))
    return notify_fail("你身上没有这样东西!\n");
  message_vision("$N把" + ob->name() + "投入丹炉中, 只见火光一闪, "
    +ob->name() + "顿时化为灰烬!\n", this_player());
  amount = (int)ob->value() / 10000;
  if (amount > 200) amount = 200;
  if (random(9) > 4) {
    switch (random(4)) {
      case 0:
        this_player()->add("life_exp", amount);
        this_player()->add("p_power_rank", amount);
        break;
      case 1:
        this_player()->add("combat_exp", amount / 2);
        this_player()->add("potential", amount / 2);
        break;
      case 2:
        if (this_player()->query("combat_exp") > amount)
          this_player()->add("combat_exp", -amount);
        this_player()->add("potential", -amount);
        break;
      case 3:
        this_player()->add("life_exp", -amount / 2);
        this_player()->add("potential", -amount / 2);
        break;
    }
    if (this_player()->query("combat_exp") <= 0)
      this_player()->set("combat_exp", 1);
    if (this_player()->query("potential") < this_player()->query("learned_points"))
      this_player()->set("potential", this_player()->query("learned_points"));
  }
  destruct(ob);
  return 1;
}

int do_get(string arg) {
  string book, from;
  object ob;
  if (!arg || sscanf(arg, "%s from %s", book, from) != 2) return 0;
  if (book != "纸片" || from != "钟乳" || query("no_book")) return 0;

  message_vision("$N从钟乳中拿出一页纸片!\n", this_player());
  ob = new(__DIR__ "obj/dongindice");
  ob->move(this_player());
  set("no_book", 1);
  return 1;
}

string do_book() {
  if (query("no_book")) return "你发现一根钟乳居然被挖了个洞!\n";
  return "你发现一根钟乳居然被挖了个洞!\n"
    "里面有一页纸片\n";
}

void reset() {
  ::reset();
  delete("no_book");
}
