// wjiulou.c
#include <room.h>

inherit ROOM;

void create() {
  set("short", "云之楼");
  set("long", @LONG
这里热闹得很. 各式打扮的武林人物大大咧咧地喝着酒, 粗着
嗓门大喊大叫. 周围的市民也喜欢来这里吃吃酒, 听听最近武林中
发生的故事.
    西面一个肥大的柜台, 后面站着个慈祥的老头, 再后面的柜橱
里除了酒还是酒. 墙上挂了一幅匾, 狂草写着
	
		云之楼

    往上是海鲸帮招呼武林高手的雅座, 一道珠帘低垂.
LONG);
  set("item_desc", ([
    "珠帘": (: look_door, "up" :),
  ]));
  set("exits", ([
    "north": __DIR__ "wroad1",
    "up": __DIR__ "wjyazuo",
  ]));
  set("objects", ([
    __DIR__ "npc/ruihuan": 1,
  ]));
  create_door("up", "珠帘", "down", DOOR_CLOSED);
  setup();
}

int valid_leave(object who, string exit) {
  if (exit == "up" || exit == "u") {
    if (who->query("combat_exp") < 80000)
      return notify_fail("小二笑着招呼道: 这一位请楼下用酒!\n");
  }
  return ::valid_leave(who, exit);
}
