//  coolman.cc

inherit ROOM;

void create() {
  set("short", "玄烨的家");
  set("long", @LONG
你正站在海鲸帮弟子玄烨的房间里，屋子宽敞明亮，房间中间有一张
圆桌和几把椅子，显然是主人用来待客和平时吃饭用的。正面墙上是一
个条幅，上书四个大字“难得糊涂”，笔法不凡，一看即知出自名家之
手。条幅靠左一些是一扇窗户（window），从这里可以看见玄烨家的后
院。房间的北边有一张大床，宽宽大大，上面的寝具铺的松软异常，让
人看见就想在上面躺一会儿。南面靠墙放着一排书柜(bookcase)，里面
摆满了藏书，早有风闻此间主人学识不凡，由此可见一斑。
LONG);
  set("exits", ([
    "out": "/d/wuhan/dragon_residence" ]));
  set("owner", "coolman");
  set("item_desc", ([
    "window":
    "你从窗户里看出，视线不禁一亮，院子不大，却收拾的井井\n"
    "有条，左面还种了一些花草，看上去让人自然的感觉心旷神怡。右边的\n"
    "空地上停了一辆火红的法拉力跑车，流线的车身，完美的造型，让你羡\n"
    "慕不已。\n"
    ,
    "bookcase":
    "一排书柜，里面放满了书籍，你想看看有些什么书，发现\n"
    "柜门上锁了，柜子上还有个条子，上面写着“私人藏书，概不外借”。\n"
    ,
  ]));
  set("refusemsg",
    "你推了推玄烨家的门，没锁！你心中一阵窃喜，正要往里走，猛然间抬\n"
    "头，发现两个御前带刀侍卫不知什么时候已站在你面前，正冷冷的看着你\n"
    "，你被看的发毛，做贼心虚的退了几步，然后一转身没命的逃掉了。\n"
  );
  set("sleep_room", 1);
  setup();
}

void init() {
  object ob;

  add_action("allowin", "allowin");
  add_action("privatehere", "privatehere");
  add_action("preventin", "preventin");
  add_action("savehere", "savehere");
}

int savehere(string arg) {
  string meid = this_player()->query("id");

  if (meid != query("owner"))
    return notify_fail("你没有权利这样做！\n");
  if (arg) return notify_fail("Error: type only  savehere!\n");
  this_player()->set("startroom", __FILE__);
  write("当你下次连线进来时，会从这里开始。\n");
  return 1;
}

int allowin(string arg) {
  string meid = this_player()->query("id");

  if (!wizardp(this_player()) && meid != query("owner"))
    return notify_fail("你没有权利这样做！\n");
  if (!arg) return notify_fail("让谁进?\n");
  set("right/" + arg, 1);
  message_vision("$N给" + arg + "以来串门的权利\n", this_player());
  return 1;
}

int preventin(string arg) {
  string meid = this_player()->query("id");

  if (!wizardp(this_player()) && meid != query("owner"))
    return notify_fail("你没有权利这样做！\n");
  if (!arg) return notify_fail("不让谁进?\n");
  delete("right/" + arg);
  message_vision("$N取消" + arg + "来串门的权利\n", this_player());
  return 1;
}

int privatehere(string arg) {
  string meid = this_player()->query("id");

  if (!wizardp(this_player()) && meid != query("owner"))
    return notify_fail("你没有权利这样做！\n");
  delete("right");
  message_vision("$N取消了所有人来串门的权利\n", this_player());
  return 1;
}
void reset() {}
