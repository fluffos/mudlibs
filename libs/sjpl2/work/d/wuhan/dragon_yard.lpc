// dragon_yard.c

inherit ROOM;

void create() {
  set("short", "大院");
  set("long", @LONG
你走进一个很大的院子, 中间是一大块空地, 一左一右种着一棵白杨一棵梧桐.
院子周围摆着些花盆, 一丛丛紫罗兰绚烂夺目.
LONG);
  set("exits", ([
    "north": __DIR__ "dragon_hall",
    "south": __DIR__ "dragon_entrance",
    "west": __DIR__ "dragon_school",
    "east": __DIR__ "dragon_residence1",
  ]));
  set("objects", ([
    __DIR__ "npc/dragon_hufa1": 1,
    __DIR__ "npc/dragon_commander": 1,
  ]));
  set("item_desc", ([
    "花盆": "非常干净的花盆",
  ]));
  set("valid_startroom", 1);
  setup();
}


void init() {
  add_action("do_climb", ({ "climb" }));
  add_action("do_push", ({ "push" }));
  //	add_action("do_apprentice",  ({"apprentice"}) );
  if (this_player())
    tell_room(__DIR__ "dragon_tree1",
      this_player()->name() + "往树下走了过来。\n");
}

int do_climb(string arg) {
  object shu;
  if (!arg) return notify_fail("你爬什么?\n");
  if (arg != "梧桐") return notify_fail("这东西不能爬!\n");
  message_vision("$N往树上爬去.\n", this_player());
  this_player()->move(__DIR__ "dragon_tree1");
  message_vision("$N爬上树来.\n", this_player());
  return 1;
}


int do_push(string arg) {
  object room;

  if (arg != "花盆") return notify_fail("你推什么?\n");
  message_vision("$N板了一下花盆\n", this_player());
  if (this_player()->query("max_force") < 500)
    return notify_fail("\n你怎么板也扳不动\n\n");
  tell_room(__FILE__,
    "\n只听\"咔嚓\"一声, 墙下露出一个暗道\n\n");
  add("exits/westdown", __DIR__ "dragon_secret_room");
  __DIR__ "dragon_secret_room"->add("exits/eastup", __FILE__);
  call_out("close_passage", 5);
  return 1;
}

void close_passage() {
  object room;

  delete("exits/westdown");
  tell_room(__FILE__, "\n只听\"咔嚓\"一声, 暗道又合上了!\n\n");
  if (room = find_object(__DIR__ "dragon_secret_room")) {
    room->delete("exits/eastup");
  }
}

int valid_leave(object me, string dir) {
  tell_room(__DIR__ "dragon_tree1",
    "树下的" + me->name() + "往" + to_chinese(dir) + "离开了。\n");
  me->delete("marks/柳护法");
  return 1;
}
