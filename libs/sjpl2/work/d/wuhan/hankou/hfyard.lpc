// hfyard.C

inherit ROOM;

create() {
  set("short", "前院");
  set("long", @LONG
这里是黄家前院。正中用花岗石围了一个小池，池子里树着座假山，其上
点缀着树木、庙宇、人物，说的好象是朝圣的场面。
    南北是黄家客人们休息的厢房。北厢房已经好久没用过了。
LONG);
  set("exits", ([
    "south": __DIR__ "hsgr",
    "west": __DIR__ "hhall",
    "east": __DIR__ "henter"
  ]));
  set("objects", ([
    __DIR__ "npc/hjiad": 2,
  ]));
  setup();
}
