// duke.c

inherit NPC;
void create() {
  set_name("壮汉", ({ "man" }));
  set("long", "这是一个好象很失意的年轻人\n");
  set("age", 32);
  set("combat_exp", 200);
  set("str", 20);
  set("unarmed", 5);
  set("chat_chance", 5);
  set("chat_msg", ({
    "壮汉叹道: 唉！最近手气老不好, 再这样下去只怕连剩下的这条裤子也要卖掉了!\n",
  }));
  setup();
  carry_object(__DIR__ "obj/duanku")->wear();
}
