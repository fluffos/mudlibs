// qingshe.c

inherit NPC;

void create() {
  set_name("青蛇", ({ "qingshe", "shan qingshe"
  }));
  set("long", "一条四指粗的大青蛇\n");

  set("race", "野兽");
  set("age", 100);
  set("attitude", "peaceful");

  set("max_gin", 900);
  set("max_kee", 900);
  set("max_sen", 500);

  set("str", 20);
  set("cor", 30);
  set("spi", 20);
  set("int", 10);
  set("limbs", ({ "头部", "躯干", "尾巴" }));
  set("verbs", ({ "bite" }));

  set_temp("apply/attack", 50);
  set_temp("apply/damage", 20);
  set_temp("apply/defense", 70);

  set("combat_exp", 15000);
  set("score", 1000);
  setup();
  carry_object(__DIR__ "obj/qingshedan");
}

void init() {
  object me;
  ::init();
  if (interactive(me = this_player()) &&
    (environment(this_object()))->query("short") == "龟山") {
    call_out("escape", 1);
  }

}

void escape() {
  remove_call_out("escape");
  call_other("/d/wuhan/hankou/guic2", "do_escape");
  return;
}
