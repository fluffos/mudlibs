// dyayi.C

inherit NPC;
void create() {
  set_name("知府", ({ "zhifu" }));
  set("title", "武汉府");
  set("long", "一脸长髯满面红光的知府大人\n");
  set("age", 39);

  set("str", 20);
  set("cor", 30);
  set("combat_exp", 2000);
  set("max_force", 200);
  set("force", 200);
  set_temp("apply/attack", 20);

  setup();
  carry_object(__DIR__ "obj/zcloth")->wear();
}

int accept_object(object who, object ob) {
  if (ob->query("id") != "7yan") return 0;
  message_vision("知府大人冷冷地看了一眼$N\n", this_player());
  call_out("lao", 1, who);
  return 1;
}

void lao(object who) {
  object ob, *list;
  int i;
  if (living(this_object()) && environment() == environment(who)) {
    command("say 原来就是你偷了我的宝砚. 哼, 也算你知时务投案自首, 免了杀头之罪.");
    command("say 来人啊. 拉下去痛打二十, 丢入大牢, 关上两日.");
    message_vision("两个衙役走上前来, 将$N按倒, 在屁股上打了二十大棍.\n",
      who);
    who->command("fear");
    message_vision("两个衙役将$N带下堂去\n", who);
    who->move("/d/wuhan/hankou/yamenl");
    message("vision", "两个衙役将" + who->query("name") +
      "往牢里一扔, 转身出去.\n", "/d/wuhan/hankou/yamenl", who);
    who->receive_wound("kee", 30);
    who->receive_damage("kee", 60);
    who->set_temp("zuolao", 1);
    list = all_inventory(who);
    i = sizeof(list);
    while (i--)
      destruct(list[i]);
    ob = new(__DIR__ "obj/qcloth");
    ob->move(who);
    ob->wear();
    who->start_busy(5);
  }
  return;
}
