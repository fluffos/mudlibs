// wu.c

inherit NPC;

void create() {
  set_name("吴不值", ({ "wu" }));
  set("title", "算命先生");
  set("gender", "男性");
  set("long", "这是一个清瘦的道人, 据说算命是总是胡说八道, 但是"
    "寻他问前程的人依旧不少\n");
  set("age", 80);
  set("attitude", "friendly");
  set("combat_exp", 500);

  set_skill("unarmed", 10);
  set_skill("dodge", 10);
  set("inquiry", ([
    "算命": "您要算命么(suanming)? 五十个铜板就够了!"
  ]));
  setup();
  carry_object(__DIR__ "obj/daocloth")->wear();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()))
    call_out("greeting", 1, ob);
  add_action("suanming", "suanming");
}

void greeting(object ob) {
  remove_call_out("greeting");
  if (!ob || environment() != environment(ob)) return;
  command("say " + RANK_D->query_respect(ob) +
    "来算一卦吧, 能知前生后世!");
  return;
}

int suanming(string arg) {
  int amount;
  object money, ob;
  if (arg) return 0;

  if (!(money = present("coin_money", this_player())) || (amount = (int)money->value()) < 50)
    return notify_fail("你身上的铜板不够!\n");
  destruct(money);
  money = new("/obj/money/coin");
  money->set_amount(amount - 50);
  money->move(this_player());
  message_vision("$N对吴不值言道: 请先生给算个命\n", this_player());
  if (random(2) == 1) {
    command(":P");
    command("say " + RANK_D->query_respect(this_player()) +
      "前程未可限量, 未可限量!");
    command("praise " + this_player()->query("id"));
  } else {
    command("shake");
    command("sigh");
    command("say " + RANK_D->query_respect(this_player()) +
      "前程不幸之至, 不幸之至啊!");
    command("say 鄙人有一本书, 便赠于你罢, 希望于你有用");
    command("sigh");
    ob = new(__DIR__ "obj/magicb16");
    ob->move(this_player());
  }
  return 1;
}
