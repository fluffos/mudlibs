inherit NPC;

void create() {
  set_name("挑夫", ({ "tiaofu" }));
  set("gender", "男性");
  set("long", "一个四肢健壮的大汉，专门从事挑夫工作。\n");
  set("age", 28);
  set("str", 22);
  set("cor", 30);
  set("cps", 20);
  set("con", 50);
  set("per", 27);
  set("int", 10);
  set("max_kee", 900);
  set("kee", 900);
  set("food", 500);
  set("water", 500);
  set("attitude", "peaceful");
  set("max_force", 800);
  set("force", 800);
  set("force_factor", 10);
  set_temp("apply/attack", 5000);
  set_temp("apply/defense", 5000);
  set("score", 200);
  set("daode", 10);
  setup();
  carry_object("/obj/cloth")->wear();
}


int accept_fight(object ob) {
  object weapon;
  string skill_type;
  int ob_attack, ob_dodge, ob_parry;
  if (this_object()->is_fighting()) {
    command("say 想以多取胜？我不干！！！\n");
    return 0;
  }
  if (ob->query("combat_exp") > 130000) {
    command("say " + RANK_D->query_self(this_object())
      + "武艺低微，怎么可能是" + RANK_D->query_respect(ob)
      + "的对手？\n");
    return 0;
  }
  if (ob->query("combat_exp") < 5000) {
    command("say " + RANK_D->query_self_rude(this_object())
      + "没空呢，你这" + RANK_D->query_rude(ob)
      + "给我滚开！\n");
    return 0;
  }

  if (objectp(weapon = ob->query_temp("weapon")))
    skill_type = weapon->query("skill_type");
  else
    skill_type = "unarmed";

  ob_attack = ob->query_skill(skill_type, 0) + ob->query_temp("apply/attack");
  ob_dodge = ob->query_skill("dodge", 0) + ob->query_temp("apply/defense");
  ob_parry = ob->query_skill("parry", 0) + ob->query_temp("apply/defense");

  set("eff_kee", query("max_kee"));
  set("kee", query("max_kee"));
  set("max_force", ob->query("max_force"));
  set("force", ob->query("force"));
  set("combat_exp", ob->query("combat_exp") + 50);
  if (query("combat_exp") > 100000) set("combat_exp", 100000);
  set_temp("apply/attack", ob_dodge + ob_dodge / 20 + 10);
  set_temp("apply/defense", ob_attack + ob_attack / 20 + 10);

  //	if( !ob->query("env/no_msg") ) {
  //	    write("系统暂时把你战斗信息关闭，打开战斗信息请用 msg 命令。\n");
  //	    ob->set("env/no_msg",1); }	
  return 1;
}
