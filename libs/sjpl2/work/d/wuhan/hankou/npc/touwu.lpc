// daoliu.c

inherit NPC;


void create() {
  set_name("吴大麻子", ({ "wu" }));
  set("title", "小偷");
  set("gender", "男性");
  set("long", "这个人黄不拉叽的, 脸上长满了麻子\n");
  set("age", 25);
  set("per", 10);

  set("inquiry", ([
    "烂铁剑": "嘻嘻，你是问郑寡妇家的那把？一把烂剑谁要，那天我手气不好，给输掉了"
  ]));
  set("attitude", "agressive");
  set("combat_exp", 300);

  set_skill("unarmed", 20);
  set_skill("dodge", 20);
  setup();
  carry_object(__DIR__ "obj/qcloth")->wear();
}
