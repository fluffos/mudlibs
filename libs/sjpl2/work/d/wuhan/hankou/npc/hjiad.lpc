// hjiad.C

inherit NPC;
void create() {
  set_name("家丁", ({ "jiadin" }));
  set("title", "黄府");
  set("long", "很威武的家丁\n");
  set("age", 25);

  set("str", 25);
  set("cor", 30);
  set("combat_exp", 50000);
  set("max_force", 1000);
  set("force", 1000);

  set_skill("dodge", 100);
  set_skill("blade", 150);
  set_skill("unarmed", 100);
  set_skill("force", 100);
  set_temp("apply/attack", 70);
  set_temp("apply/defense", 30);
  set_temp("apply/damage", 40);

  setup();
  carry_object(__DIR__ "obj/hcloth.lpc")->wear();
}
