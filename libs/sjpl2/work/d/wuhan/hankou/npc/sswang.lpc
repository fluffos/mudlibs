// hjiaren.c
#include <ansi.h>
inherit NPC;
int do_permit();

void create() {
  set_name("王老二", ({ "wang", "sswang" }));
  set("gender", "男性");
  set("long", "他看起来好象很忠厚\n");
  set("age", 25);
  set("attitude", "friendly");
  set("combat_exp", 200000);

  set_skill("unarmed", 200);
  set_skill("dodge", 200);
  set("inquiry", ([
    "join": (: do_permit :),
  ]));
  set_temp("apply/dammage", 100);
  set_temp("apply/dodge", 100);
  set_temp("apply/defense", 50);
  setup();
  carry_object(__DIR__ "obj/token2");
}

int do_permit() {
  if (this_player()->query("combat_exp") < 10000)
    command("say 哈哈，你功夫这么臭...");
  else if (this_player()->query("wuhankiller"))
    command("hammer " + this_player()->query("id"));
  else {
    command("say 哈哈！你想加入我们！知道我们是干什么的吗？");
    this_player()->set_temp("joinkiller", 1);
  }
  return 1;
}

void relay_whisper(object me, string msg) {
  if (msg != "杀手") return;
  if (!me->query_temp("joinkiller")) return;
  command("say 好，既然你知道，那么从此以后你就是我们中的一员");
  command("say 这是你的铜牌");
  __DIR__ "obj/token2"->move(me);
  me->set("wuhankiller", 1);
  return;
}

int accept_object(object who, object ob) {
  object yu;
  if (!(yu = present("yupei", who))) return 0;
  if (!yu->query("equipped")) return 0;
  if (ob->name() != "密信" || ob->query("id") != "letter") return 0;
  call_out("laoda", 1, who);
  command("say 老大说过，佩此玉佩之人，他是一定要见的\n");
  return 0;
}

void laoda(object who) {
  if (!who) return;
  tell_object(who, "王老二把你带进院子里\n");
  who->move("/d/wuhan/hankou/sshall");
}
