//sskillercloth.c

#include <armor.h>

inherit CLOTH;

void create() {
  set_name("黄衣", ({ "yellow suit", "suit" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 1100);
    set("material", "cloth");
    set("armor_prop/armor", 1);
    set("armor_prop/id", ({ "killer" }));
    set("armor_prop/name", ({ "杀手" }));
    set("armor_prop/short", ({ "杀手(Killer)" }));
    set("armor_prop/long", ({
      "一个要命的家伙。\n"
    }));
  }
  setup();
}
