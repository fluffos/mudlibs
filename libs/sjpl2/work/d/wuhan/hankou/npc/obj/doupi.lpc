// baotang.c
inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("家常豆皮", ({ "doupi" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一碗香脆可口的豆皮.\n");
    set("value", 50);
    set("unit", "碗");
    set("food_remaining", 5);
    set("food_supply", 30);
  }
  setup();
}
