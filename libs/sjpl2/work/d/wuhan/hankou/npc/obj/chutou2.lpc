// tieqiao.c
#include <weapon.h>

inherit STAFF;

void create() {
  set_name("锄头", ({ "chutou" }));
  set_weight(22000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "一把坚硬的花锄\n");
    set("value", 400);
  }
  init_staff(35, TWO_HANDED);
  setup();
}
