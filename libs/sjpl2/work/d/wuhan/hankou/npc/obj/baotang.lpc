// baotang.c
inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("一包糖", ({ "yibaotang" }));
  set_weight(350);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一包用纸包起的糖粒\n");
    set("value", 10);
    set("food_remaining", 1);
    set("food_supply", 10);
  }
  setup();
}

void init() {
  add_action("do_eat", ({ "eat" }));
  add_action("do_open", ({ "open" }));
}


int do_eat(string arg) {
  if (id(arg)) {
    if ((int)this_player()->query("food") >= (int)this_player()->max_food_capacity())
      return notify_fail("你已经吃太饱了，再也塞不下任何东西了。\n");
    tell_object(this_player(), "你吃得如此之急, 以至于连糖纸都吃进去了.\n");
  }
  return ::do_eat(arg);
}

int do_open(string arg) {
  object ob;
  if (arg != "纸" && arg != "糖纸") return 0;
  tell_object(this_player(), "你把包糖纸细心地展开, 只见上面弯弯曲曲的画了些图形, 却是张地图的一部分.\n");
  ob = new(__DIR__ "map1");
  ob->move(this_player());
  ob = new(__DIR__ "tang");
  ob->move(this_player());
  destruct(this_object());
  return 1;
}
