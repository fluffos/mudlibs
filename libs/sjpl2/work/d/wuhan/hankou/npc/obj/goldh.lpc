// goldh.c

#include <armor.h>

inherit HEAD;

void create() {
  set_name("黄冠", ({ "gold hat", "hat" }));
  set("long", "一顶别致的黄冠\n");
  set_weight(1000);
  set("value", 10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "顶");
    set("armor_prop/armor", 5);
    set("armor_prop/dodge", 1);
  }
  setup();
}
