// mengran.c

#include <armor.h>

inherit HEAD;

void create() {
  set_name("灵威冠", ({ "hat" }));
  set_weight(0);
  set("value", 0);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "顶");
    set("material", "silk");
    set("armor_prop/strength", 10);
    set("armor_prop/spirituality", 5);
  }
  setup();
}
