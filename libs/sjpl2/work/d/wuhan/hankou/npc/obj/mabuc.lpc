// mubuc.c


#include <armor.h>

inherit CLOTH;

void create() {
  set_name("麻布长袍", ({ "mabu cloth", "cloth" }));
  set("long", "这件衣服是用一种很结实的麻缝的\n");
  set_weight(3000);
  set("value", 100000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "cloth");
    set("armor_prop/armor", 10);
  }
  setup();
}
