// ycloth.c

#include <armor.h>

inherit CLOTH;

void create() {
  set_name("知府官袍", ({ "zifu cloth" }));
  set_weight(3000);
  set("value", 100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "知府官袍  上绣鸾鸟一条\n");
    set("material", "cloth");
    set("armor_prop/armor", 2);
  }
  setup();
}
