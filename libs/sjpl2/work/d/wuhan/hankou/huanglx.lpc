// huanglx.c

inherit NPC;

create()
{
        set_name("黄历之", ({"huang lizhi", "huang"}) );
        set("title", "黄老先生");
        set("long", 
        "黄历之老先生归隐在家已经有三四个年头了，但在朝中依然很有声望，连"
        "皇上有时也会向他请教一些问题。\n");
        
        set("statue", "friendly");
        set("age", 67");
        
        set("str", 20);
        set("int", 30);
        set("combat_exp", 300000);
        set("max_force", 500);
        set("force", 700);
        
        set_skill("force", 50);
        set_skill("unarmed", 70);
        set_skill("sword", 100);
        set_skill("dodge", 60);
        
        set("inquiry", ([
        "金狂"  :       "金先生是老夫的旧友。我们好久没见了，他在这儿正要"
                        "都住些时候。\n"
        "金先生":       "金先生是老夫的客人。你们既然不识，就不用多问了。\n"
]) );
        setup();
        carry_object(__DIR__"obj/goldc")->wear();
        carry_object(__DIR__"obj/goldh")->wear();
}