// pill.c
inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("丹丸", ({ "blackpill" }));
  set_weight(250);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "粒");
    set("long", "这是一颗黑不溜湫的丹丸, 好象已有很多年的历史了.\n"
      "看样子在弄清楚他的来历之前最好不要吃, 否则是好是\n"
      "坏你都只有认了!\n");
    set("value", 0);
    set("food_remaining", 1);
    set("food_supply", 1);
  }
  setup();
}

void init() {
  add_action("do_eat", ({ "eat" }));
}


int do_eat(string arg) {
  int n;
  if ((int)this_player()->query_temp("block_msg/all") > 0)
    return notify_fail("什么？\n");

  if (arg == "blackpill") {
    if ((int)this_player()->query("food") >= (int)this_player()->max_food_capacity())
      return notify_fail("你已经吃太饱了，再也塞不下任何东西了。\n");
    if ((int)this_player()->query("combat_exp") <= 50000)
      return notify_fail("你刚将丹丸放进嘴里，突然感到一阵恶心，又连忙吐了出来。\n");
    message_vision("$N闭上眼睛, 胆战心惊地把丹丸吞下肚去.\n", this_player());
    destruct(this_object());
    if (random(9) > 4) {
      n = random(10000);
      if (n < 1000) {
        int limit;
        limit = ((int)this_player()->query_skill("force", 1) +
          this_player()->query_skill("force") / 5) * 13 - (int)this_player()->query("max_force");
        if (limit > 2) limit = 2;
        if (limit < 0) limit = 0;
        this_player()->add("max_force", limit);
      } else if (n < 2000)
        this_player()->add("max_force", -10);
      else if (n < 3200) {
        this_player()->add("combat_exp", 100);
        this_player()->add("potential", 25);
      } else if (n < 4000)
        this_player()->add("combat_exp", -100);
      else if (n < 4003) {
        this_player()->add("combat_exp", 10000);
        this_player()->add(
          "potential",
          (this_player()->query("learned_points") - this_player()->query("potential")) / 3
        );
      } else if (n < 7000) {
        this_player()->add("combat_exp", 200);
        this_player()->add("potential", 10);
      } else if (n < 7020) {
        this_player()->add("combat_exp", 5000);
        this_player()->add("potential", 15);
      } else if (n < 7030)
        this_player()->add("combat_exp", -10000);
      else if (n < 7040) {
        this_player()->add("combat_exp", 15000);
        this_player()->add(
          "potential",
          (this_player()->query("learned_points") - this_player()->query("potential")) / 2
        );
      } else if (n < 7045) {
        this_player()->add("combat_exp", -20000);
      } else if (n < 9000)
        this_player()->add("combat_exp", -20);
      else
        this_player()->unconcious();
    }
    this_player()->add("food", query("food_supply"));
    if (this_player()->is_fighting()) this_player()->start_busy(2);
    message_vision("$N将剩下的" + name() + "吃得乾乾净净。\n", this_player());
    return 1;
  }
  return 0;

}
