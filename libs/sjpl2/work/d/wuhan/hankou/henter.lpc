// henter.c

inherit ROOM;

create() {
  set("short", "黄家门厅");
  set("long", @LONG
这里是黄家迎来送往的地方，一个老家人在这儿应酬着。
LONG);
  set("exits", ([
    "west": __DIR__ "hfyard",
    "east": __DIR__ "proad2"
  ]));
  set("objects", ([
    __DIR__ "npc/hjiaren": 1,
  ]));
  set("no_fight", 1);
  setup();
}

int valid_leave(object me, string exit) {
  if (exit == "west") {
    if (me->query_temp("wes_tigger") || !present("huang an", environment(me))) {
      me->delete_temp("wes_tigger");
      return 1;
    }
    message_vision("黄安拦住$N问道: "
      +RANK_D->query_respect(me) +
      "您找哪一位？\n", this_player());
    return notify_fail("");

  }
  if (me->query_temp("wes_tigger"))
    me->delete_temp("wes_tigger");
  return 1;
}
