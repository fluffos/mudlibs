// wwenroom.c

inherit ROOM;

create() {
  set("short", "卧室");
  set("long", @LONG
这间房子已经许久没动过了，到处都是灰尘，家具都已显出些老态来。墙上
挂了把宝剑和几副镖囊。
LONG);
  set("exits", ([
    "south": __DIR__ "wyard",
  ]));
  set("outdoors", "hankou");
  set("no_clean_up", 0);
  setup();
}

void init() {
  add_action("do_open", ({ "open" }));
}

int do_open(string arg) {
  object ob;
  if (arg == "镖囊") {
    if (!query("_found_")) {
      message_vision("$N打开镖囊，里面掉出些东西来。\n", this_player());
      ob = new(__DIR__ "obj/yanwei");
      ob->move(this_object());
      set("_found_", 1);
      return 1;
    }
    return notify_fail("里面是空的!\n");
  }
  return 0;
}

void reset() {
  ::reset();
  delete("_found_");
}
