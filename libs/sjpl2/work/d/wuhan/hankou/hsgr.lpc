// include hankou/hsgr.c

inherit ROOM;

create() {
  set("short", "南厢房");
  set("long", @LONG
这里是黄家客人留宿的地方。地上铺着棕色的地毯，米黄的墙壁上挂着几副
水彩花草。一张八仙桌摆在正中。墙角的书架上整整齐齐放了一些书籍，供
客人们无事时消遣。床上架着黄褐色的帐子，铺着床粉红的锦被。
LONG);
  set("exits", ([
    "north": __DIR__ "hfyard",
  ]));
  set("objects", ([
    __DIR__ "npc/guqian": 1,
  ]));
  set("outdoors", "hankou");
  setup();
}
