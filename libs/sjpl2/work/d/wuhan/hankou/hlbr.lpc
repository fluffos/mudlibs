// hlbr.c

inherit ROOM;

create() {
  set("short", "书房");
  set("long", @LONG
老爷的书房四壁都是书, 南北各挂一副大楷, 写的分别是 静 无为
一张红杉书桌摆在正中, 整齐的摞着一堆老爷近来常读的书, 文房四
宝旁放着一叠信签. 桌角放着一盏烛灯, 黄老先生读书总是要读得很
晚的, 蜡烛是粗粗益善的.
    南边是老爷的卧室, 老太太过去以后, 当然就只有老爷才能进去
了.
LONG);
  set("exits", ([
    "north": __DIR__ "hbyard"
  ]));
  set("outdoors", "hankou");

  setup();
}
