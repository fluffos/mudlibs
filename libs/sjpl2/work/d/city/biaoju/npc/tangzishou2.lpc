inherit NPC;

void create() {
  set_name("趟子手", ({ "tang", "zhi" }));
  set("gender", "男性");
  set("age", 32);
  set("long", "这是一位体态轻盈的趟子手。\n");
  set("combat_exp", random(20) * 1000 + 10000);
  set("attitude", "friendly");
  set_skill("unarmed", 90);
  set_skill("dodge", 100);
  set("chat_chance", 5);
  set("chat_msg", ({
    "趟子手一声大喊: 大～～展～～红～～旗～～！\n",
  }));

  setup();
  add_money("silver", 50);
  carry_object(__DIR__ "obj/jinzhuang")->wear();
}
