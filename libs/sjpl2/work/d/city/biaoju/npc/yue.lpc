inherit NPC;
inherit F_MASTER;
void create() {
  set_name("岳九公", ({ "yue jiugong", "yue" }));
  set("title", "红旗镖局管帐");
  set("gender", "男性");
  set("age", 56);
  set("long",
    "岳九公主要负责红旗镖局日常帐务事宜，在镖局里德高望重。\n
若要加入镖局可以（shenqing），离开镖局可以（tuichu）\n");
  set("attitude", "peaceful");
  set("force", 700);
  set("max_force", 700);
  set("force_factor", 20);
  set("combat_exp", 400000);

  set_skill("unarmed", 70);
  set_skill("yuanyang_tui", 70);
  set_skill("literate", 70);
  set_skill("force", 70);
  set_skill("move", 70);
  set_skill("dodge", 70);
  set_skill("parry", 70);
  set_skill("spear", 70);
  set_skill("bainiao_spear", 70);
  set_skill("bixueforce", 70);
  map_skill("unarmed", "yuanyang_tui");
  map_skill("force", "bixueforce");
  map_skill("spear", "bainiao_spear");
  map_skill("parry", "bainiao_spear");

  create_family("红旗镖局", 3, "镖师");

  setup();

  carry_object("/obj/weapon/longspear")->wield();
  carry_object("/obj/cloth")->wear();
}
void init() {
  add_action("biaoju_sq", "shenqing");
  add_action("biaoju_tc", "tuichu");
}

int biaoju_sq(string arg) {
  object me = this_player();
  if ((string)me->query("class1") != "biaoju") {
    if ((string)me->query("class") == "official") {
      command("fear");
      command("say " + RANK_D->query_respect(me) + "是朝廷命官，我们怎敢劳驾呢？ \n");
      return 1;
    } else
      command("smile");
    command("say 好吧，" + RANK_D->query_respect(me) + "你以后要多为镖局出力！\n");
    me->set("class1", "biaoju");

    return 1;
  } else
    command("say 你已经是镖师了! \n");
  return 1;
}
int biaoju_tc(string arg) {
  object me = this_player();
  if ((string)me->query("class1") == "biaoju") {
    command("sigh");
    command("say 好吧，" + RANK_D->query_respect(me) + "希望以后多来镖局坐坐！\n");
    me->delete("class1");
    return 1;
  }
  command("say 你并不是我们的镖师呀！ \n");
  return 1;
}
void attempt_apprentice(object ob) {
  command("smile");
  command("say 好吧，" + RANK_D->query_respect(ob) + "以后要多为镖局出力！\n");
  command("recruit " + ob->query("id"));
}

void recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "biaoju");
  ob->set("class1", "biaoju");
  ob->set("id_type", 1);
  ob->set("title", "红旗镖局镖师");
}
