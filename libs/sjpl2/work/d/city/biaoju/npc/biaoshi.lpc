inherit NPC;
string reward_more(object who);

void create() {
  set_name("镖师", ({ "biaoshi", "biao" }));
  set("gender", "男性");
  set("age", 32);
  set("long", "这是一位高达六尺的镖师。\n");
  set("combat_exp", random(20) * 1000 + 20000);
  set("attitude", "friendly");
  set_skill("hammer", 90);
  set_skill("dodge", 100);
  set("iron-cloth", 200);
  set("chat_chance", 10);
  set("chat_msg", ({
    "镖师又将手中的石锁一口气连举了七八十下。\n",
    "镖师望了望自己粗壮的胳膊，又捏了两下，脸上露出得意之色。\n",
  }));
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: reward_more(this_object()) :),
  }));

  setup();
  add_money("silver", 50);
  carry_object(__DIR__ "obj/jinzhuang")->wear();
  carry_object(__DIR__ "obj/stonehammer")->wield();
}
string reward_more(object who) {
  int i;
  object *enemy;
  seteuid(getuid());
  enemy = who->query_enemy();
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      if (enemy[i]->query("combat_exp") < 20000) return "1";
      if (enemy[i]->query("combat_exp") > 30000) return "1";
      enemy[i]->add("combat_exp", 1);
      if (enemy[i]->query("potential") - enemy[i]->query("learned_points") > 200) return "1";
      enemy[i]->add("potential", 1);
    }
  }
  return "1";
}
int accept_fight(object me) {
  return 1;
}
