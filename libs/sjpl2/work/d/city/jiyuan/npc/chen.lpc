inherit NPC;
#include <ansi.h>
void create() {
  set_name("陈芸生", ({ "chen yunsheng", "chen", "yunsheng" }));
  set("gender", "男性");
  set("title", HIG "游戏风尘" NOR);
  set("age", 24);
  set("int", 30);
  set("per", 30);
  set("long",
    "这是一个衣衫褴褛的乞丐，但长得却有一股英豪之气。\n"
  );
  set("max_gin", 3000);
  set("max_kee", 3000);
  set("max_sen", 3000);
  set("eff_gin", 3000);
  set("eff_kee", 3000);
  set("eff_sen", 3000);
  set("gin", 3000);
  set("kee", 3000);
  set("sen", 3000);
  set("max_force", 30000);
  set("force", 30000);
  set("force_factor", 200);
  set("cor", 200);
  set("combat_exp", 4999999);
  set("score", 90000);
  set_skill("staff", 400);
  set_skill("force", 400);
  set_skill("parry", 400);
  set_skill("literate", 200);
  set_skill("dodge", 400);
  set("agi", 25);
  set("int", 30);
  setup();
  carry_object("/obj/cloth")->wear();
  carry_object(__DIR__ "obj/goldstaff")->wield();
}
int accept_fight(object me) {
  command("grin");
  command("say 我的拐是用来杀人的，不是用来比划着玩的．");
  return 0;
}
void init() {
  add_action("do_killing", "kill");
}

int do_killing(string arg) {

  object player, victim, weapon;
  string name;
  player = this_player();
  if (!arg) return 0;
  if (objectp(victim = present(arg, environment(this_object()))) && living(victim)) {
    name = (string)victim->name();
    if ((string)name == "关盼盼") {
      message_vision("$N冷笑一声道：我看你活得太长了。\n", this_object());
      this_object()->kill_ob(player);
      player->kill_ob(this_object());
      return 1;
    }
  }
  return 0;
}
