#include <ansi.h>

inherit NPC;
string reward_more(object who);

void create() {
  set_name("甲兴文", ({ "jia xingwen", "jia" }));
  set("gender", "男性");
  set("age", 32);
  set("long", "这是一位高达六尺的镖师。\n");
  set("combat_exp", 50000);
  set("title", "红旗镖局镖师");
  //	set("nickname", "");
  set("attitude", "friendly");
  set_skill("hammer", 90);
  set_skill("dodge", 100);
  set("iron-cloth", 200);
  set("chat_chance", 10);
  set("chat_msg", ({
    (: random_move :)
  }));
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: reward_more(this_object()) :),
  }));

  setup();
  add_money("silver", 50);
  carry_object(__DIR__ "obj/jinzhuang")->wear();
  carry_object("/obj/weapon/longspear")->wield();
}
string reward_more(object who) {
  int i;
  object *enemy;
  seteuid(getuid());
  enemy = who->query_enemy();
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      if (enemy[i]->query("combat_exp") < 120000) return "1";
      if (enemy[i]->query("combat_exp") > 150000) return "1";
      enemy[i]->add("combat_exp", 1);
      if (enemy[i]->query("potential") - enemy[i]->query("learned_points") > 200) return "1";
      enemy[i]->add("potential", 1);
    }
  }
  return "1";
}
int accept_fight(object me) {
  return 1;
}
