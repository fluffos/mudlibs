inherit NPC;

void create() {
  set_name("斗鸡", ({ "dou ji", "ji" }));
  set("race", "野兽");
  set("gender", "雄性");
  set("age", 2);
  set("long", "一只雄赳赳的斗鸡。\n");
  set("attitude", "friendly");
  set("max_kee", 100 + random(100));
  set("combat_exp", random(200) + random(200));
  set("str", 12 + random(22));
  set("spi", 2 + random(22));
  set("cor", 2 + random(22));
  set("con", 2 + random(22));
  set("cps", 2 + random(22));
  set_skill("unarmed", random(22) + 10);
  set_skill("dodge", random(22) + 10);
  set_skill("parry", random(22) + 10);
  set("limbs", ({ "头部", "身体", "尾巴" }));
  set("verbs", ({ "bite" }));

  setup();
}
