void create() {
  set_name("红眉老怪", ({ "master hongmei", "master", "hongmei" }));
  set("long",
    "这是一个五十多岁的怪人, 长着一对赤红的眉毛,\n" +
    "他衣衫上沾满了油污，目光贪婪地扫视着四周。\n");
  set("title", "饿鬼帮" HIR "帮主" NOR);
  set("gender", "男性");
  set("age", 54);
  set("attitude", "peaceful");
  create_family("饿鬼帮", 1, "帮主");

  set("str", 50);
  set("int", 30);
  set("cor", 20);
  set("spi", 30);
  set("max_kee", 5000);
  set("max_gin", 5000);
  set("max_sen", 5000);
  set("kee", 5000);
  set("gin", 5000);
  set("sen", 5000);

  set("force", 3000);
  set("max_force", 3000);
  set("force_factor", 100);

  set("combat_exp", 4000000);
  set("score", 20000);

  set_skill("literate", 100);
  set_skill("force", 300);
  set_skill("unarmed", 300);
  set_skill("axe", 240);
  set_skill("parry", 220);
  set_skill("dodge", 220);
  set_skill("guiyu_force", 300);
  set_skill("shengui_axe", 240);
  set_skill("sanlianhuan", 300);
  set_skill("chaos-steps", 220);

  map_skill("force", "guiyu_force");
  map_skill("parry", "shengui_axe");
  map_skill("axe", "shengui_axe");
  map_skill("unarmed", "sanlianhuan");
  map_skill("dodge", "chaos-steps");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: exert_function, "guiying" :),
  }));
  set("inquiry", ([
    "quest": (: about_quest :),
  ]));

  setup();
  carry_object("/d/city/obj/weapon/axe/bigaxe")->wield();
  carry_object("/obj/cloth")->wear();
}
void init() {
  add_action("do_cancel", "cancel");
}

void attempt_apprentice(object ob) {
  if (ob->query("id_type") == 1) {
    command("say 本派乃绿林帮会，不收正道人物。\n");
    return;
  }
  if (ob->query("class") != "egui") {
    command("say 这位" + RANK_D->query_respect(ob) + "还是去拜宁左使吧。\n");
    return;
  }
  if (ob->query_skill("guiyu_force", 1) < 90) {
    command("say 你本帮功夫修为尚浅，应先在内功方面多下功夫。\n");
    return;
  }
  command("recruit " + ob->query("id"));
}

void recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "egui");
  ob->set("title", "饿鬼帮帮众");
}

int do_cancel(string arg) {
  object me = this_player();
  if (!arg || arg != "quest")
    return notify_fail("你要取消什么？\n");
  if (!me->query("marks/egjob"))
    return notify_fail("你现在没有任务。\n");
  say(CYN "红眉老怪叹道：不想做了吗？好吧，你自己反省一下。\n" NOR);
  if ((int)me->query("combat_exp") <= 100) {
    me->delete("marks/egjob");
    me->unconcious();
    return 1;
  }
  me->add("combat_exp", -random(100));
  me->delete("marks/egjob");
  me->unconcious();
  return 1;
}

int about_quest() {
  int task;
  object me = this_player();
  string questname = names[random(sizeof(names))];
  if (!me->query("marks/egjob")) {
    say(CYN "红眉老怪说道：我老人家要吃［" + questname + "］，你去给我找来。\n" NOR);
    me->set("marks/egjob", questname);
    return 1;
  } else {
    command("say 你还站在这里干什么？要帮里白养活你可不行！");
    return 1;
  }
  return 1;
}

int accept_object(object who, object ob) {
  int exp, pot;
  object me;
  me = this_player();
  exp = (int)me->query("combat_exp");
  pot = (int)me->query("potential");
  if (ob->name() == (string)me->query("marks/egjob")) {
    say(CYN "红眉老怪微笑点头，说道：很好，继续努力。\n" NOR);
    me->set("combat_exp", (int)exp + random(50) + 30);
    me->set("potential", (int)pot + random(50) + 30);
    me->add("score", random(20));
    me->add("life_exp", random(20));
    me->delete("marks/egjob");
    return 1;
  } else {
    say(CYN "红眉老怪说道：多谢你的好意，但这东西对我没用。\n" NOR);
    return 0;
  }
  return 1;
}
int accept_fight(object me) {
  return 0;
}
