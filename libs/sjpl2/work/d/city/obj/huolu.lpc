#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIR "大火炉" NOR, ({ "huo lu", "lu" }));
  set_weight(2000000);
  set_max_encumbrance(800);
  set("no_get", 1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("prep", "under");
    set("unit", "个");
    set("long", "一个烧得通红的大火炉，可以用来锻造（forge）武器。\n");
    set("no_get", 1);
    set("value", 1);
  }
}

int is_container() { return 1; }
