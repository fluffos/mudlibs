//changan city

inherit ROOM;

void create() {
  set("short", "白虎大街");
  set("long", @LONG
这里已是白虎大街的北段，西面隐约看到一座大的府第，那是吏部
尚书大人的官邸。南面是东市中心，是个热闹的场所。耍把式卖艺的，
卖小吃糕点的，都可以看到。是个三教九流，鱼龙浑杂之地。
LONG);

  //set("item_desc", ([" *** " : " *** ", ]));

  set("exits",
    ([  //sizeof() == 4
    "south": __DIR__ "dongshi-center",
      "north": __DIR__ "baihu-n2",
      "east": "/u/lark/libu/damen",
    ]));

  set("objects",
    ([  //sizeof() == 1
    __DIR__ "npc/yeqiuhuang": 1,
      __DIR__ "npc/lidoubai": 1,
    ]));


  set("outdoors", "changan");
  set("no_clean_up", 0);
  setup();
  replace_program(ROOM);
}
