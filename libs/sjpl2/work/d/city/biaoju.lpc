//changan city

inherit ROOM;

void create() {
  set("short", "红旗镖局");
  set("long", @LONG
你来到一座建构宏伟的宅第之前，在大宅之前的左右两座石坛中各竖
一根两丈来高的旗杆，杆顶飘扬青旗。右首旗上黄色丝线绣著一头张牙舞
爪、神态威猛的雄狮，旗子随风招展，显得雄狮更奕奕若生。左首旗上绣
著「红旗镖局」四个黑字，银钩铁划，刚劲非凡。大宅朱漆大门，门上茶
杯大小的铜钉闪闪发光，门顶匾额写著「红旗镖局」四个金漆大字。门口
站着两名劲装结束的汉子，腰板笔挺，显出一股英悍之气。
LONG);

  //set("item_desc", ([" *** " : " *** ", ]));

  set("exits",
    ([  //sizeof() == 4
    "east": __DIR__ "baihu-s1",
    ]));

  set("objects",
    ([  //sizeof() == 1
    __DIR__ "npc/masterqiu": 1,
      //		__DIR__"npc/biaotou" : 2,
    ]));

  set("outdoors", "changan");
  set("no_clean_up", 0);
  setup();
  replace_program(ROOM);
}
