//changan city

inherit ROOM;

void create() {
  set("short", "朱雀门");
  set("long", @LONG
朱雀门是皇城正门，城门五阙，重楼九楹，在汉白玉须弥基
座上是十余米高的红色墩台，台上是皇城城楼，重檐飞翘，黄瓦
红墙，长梁雕龙，飞檐画凤，异常壮丽。
LONG);

  //set("item_desc", ([" *** " : " *** ", ]));

  set("exits",
    ([  //sizeof() == 4
    "north": "/d/huanggong/huangcheng",  //goto huanggong
    "south": __DIR__ "zhuque-n4",
    ]));

  set("objects",
    ([  //sizeof() == 1
    __DIR__ "npc/tongjian": 1,
      __DIR__ "npc/bing": 3,
    ]));

  set("outdoors", "changan");
  set("no_clean_up", 0);
  setup();
  //	replace_program(ROOM);
}
int valid_leave(object me, string dir) {
  if ((int)me->query("combat_exp") > 10000)
    return ::valid_leave(me, dir);
  if (dir == "north") {
    if (objectp(present("tong jian", environment(me))))
      return notify_fail("童健单刀一横，喝道：此乃皇宫，禁行！\n");
    if (objectp(present("wei shi", environment(me))))
      return notify_fail("金甲卫士喊道：我家将军不在，小人不敢放您进去！\n");
  }
  return ::valid_leave(me, dir);
}
