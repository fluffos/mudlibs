// blade.c

#include <weapon.h>

inherit SWORD;

void create() {
  set_name("长剑", ({ "sword" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "口");
    set("value", 500);
    set("material", "stell");
    set("wield_msg", "$N抽出一把锋利的$n握在手中。\n");
    set("unequip_msg", "$N将手中的$n插入腰间的刀鞘。\n");
  }
  init_sword(30);
  setup();
}
