//ROOM:/u/changan/bingbu/lou2.c

inherit ROOM;

void create() {
  set("short", "二楼");
  set("long", @LONG
楼上是路大人的起居室,陈设十分简单而随意没有华丽的点缀却一点也没有寒酸
的味道,一位美丽的少妇静静的坐在窗前,右手支着下颚,如剪的双眸呆呆地望着窗
外风中飘摇不定的风铃,若有所思,微风吹乱了她额头的长发,露出她均匀美好的面
容.突然她轻声的叹了口气.眼中露出了一丝落寞的忧伤.
LONG
  );
  set("item_desc", ([
    "少妇": "路夫人据说以前是江湖女侠,不仅武功高卓,而且更有着令所有武林中
人拜倒的绝世容颜,也许是缘分吧安排,当她遇到了当年正在游侠江湖的路大人,两
人一见钟情并终成眷属,她也就此挂剑江湖.\n",
  ]));
  set("exits", ([
    "down": __DIR__ "lou1",
  ]));
  setup();
  replace_program(ROOM);
}
