//tiejia.c

#include <armor.h>

inherit CLOTH;

void create() {
  set_name("黑铁护甲", ({ "tiejia" }));
  set_weight(3000);
  set("value", 3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "stell");
    set("armor_prop/armor", 1);
    set("armor_prop/dodge", 1);
  }
  setup();
}
