void create() {
  set("short", "中跨院");
  set("long", @LONG
 这里是尚书府的重地,是路大人处理机要的所在,禁止大声喧哗,
庭中央有一棵白兰树,正好花开季节,弥漫着沁人的幽香.暗香浮动
的沉浸中让你稍微缓解的压抑的感觉.
LONG
  );
  set("exits", ([
    "north": __DIR__ "zoulang1",
    "south": __DIR__ "zoulang7",
    "east": __DIR__ "hall",
    "west": __DIR__ "damen2",
  ]));
  set("item_desc", ([
    "白兰树": "洁白的花朵在风中轻轻摇摆着腰肢,婀娜的丰姿,沁人芬芳让人朦胧了感觉,忘记了身处何处.\n",
  ]));
  set("outdoors", "changan");
  setup();
  replace_program(ROOM);
}
