#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "知府书房");
  set("long", @LONG
这书室庭户虚敞，正中挂一幅名人山水。供一个古铜香炉，炉里
香烟飘渺。左边设一张湘妃竹榻，右边架上堆满若干图书。沿窗一只
几上，摆列文房四宝。窗外庭中种植许多花木，铺设得十分清雅，凡
刑部官员都可在这申请缉拿疑犯（jina）。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "north": __DIR__ "datang",
  ]));
  set("objects", ([
    __DIR__ "npc/yamen_master": 1,
    __DIR__ "npc/nianxf": 1,
  ]));

  set("NONPC", 1);
  setup();
}

void init() {
  add_action("do_arrest", "jina");
}
int gethim(object target, object me) {
  message_vision("$N一句话不说，匆匆忙忙地离开了。\n", target);
  target->move(this_object());
  message_vision("$N被官兵押了进来。\n", target);
  if (me) {
    me->kill_ob(target);
    target->kill_ob(me);
  }
  return 1;
}
int do_arrest(string arg) {
  object me, target, env, xu;
  int exp, stra, leader, factor;
  if (!arg)
    return notify_fail("你要下令缉拿谁？\n");
  me = this_player();
  if ((string)me->query("class") != "official")
    return notify_fail("你不是朝廷官员，不可缉拿疑犯！\n");
  if (me->query("id_type") != 5)
    return notify_fail("你不是刑部官员，不可缉拿疑犯！\n");

  if (!objectp(target = find_living(arg)))
    return notify_fail("找不到你想要的疑犯！\n");

  if (target->query("family") && (target->query("family/family_name") == "朝廷"))
    return notify_fail("你不可缉拿朝廷官员！\n");
  if (target->query("class") == "official")
    return notify_fail("你不可缉拿朝廷官员！\n");
  if (userp(target))
    return notify_fail("你不可缉拿其他玩家！\n");

  if (me->query_quest_time())
    return notify_fail("刚发出过缉拿令，请过会儿再来！\n");

  if (me->query_wait())
    return notify_fail("你现在不可随意行动！\n");
  if ((int)me->query("sen") < 50)
    return notify_fail("你的心神不够！\n");
  if (target->query("no_arrest"))
    return notify_fail("找不到你想要的疑犯！\n");
  me->add("sen", -50);
  if (present(arg, environment(me)))
    return notify_fail("你想要的疑犯就在这里！\n");
  if (!present("xu zhongliang", environment(me)))
    return notify_fail("知府大人不在这里，无法发出缉拿令！\n");
  else xu = present("xu zhongliang", environment(me));
  //	if( interactive(target))
  env = environment(target);
  if (!env || env->query("hell") || env->query("oldarea"))
    return notify_fail("找不到你想要的疑犯！\n");

  if (target->query("family") && (target->query("family/generation") >= me->query("family/generation")))
    return notify_fail("以你现在的能力，还不足以申请缉拿" + target->query("name") + "！\n");

  message_vision(HIR "$N大声下令道：来人那．．．把$n给我拿来！！\n" NOR, xu, target);
  exp = (int)target->query("combat_exp");
  stra = (int)me->query_skill("officialism", 1);
  leader = (int)me->query_skill("leadership", 1);
  factor = stra * stra * leader * leader;
  factor = (factor + ((int)me->query("combat_exp")) - 1000) / 1000;
  if (random((int)me->query("combat_exp")) < (int)target->query("combat_exp") / 2)
    stra = stra + random(100), leader = leader + random(100);
  if (((int)target->query("combat_exp") - (int)me->query("combat_exp")) < 1000)
    stra = leader = 10;
  me->set_temp("arrest/reward", random(leader + stra));
  me->set_wait(5);
  me->set_quest_time(random(120) + 60);
  if (random(factor) <= exp)
    return notify_fail(CYN "\n捕快匆匆赶来，拜道：大人，" + target->query("name") + "拒捕，请到" + env->query("short") + "察看！\n" NOR);
  call_out("gethim", 5, target, me);
  return 1;
}
