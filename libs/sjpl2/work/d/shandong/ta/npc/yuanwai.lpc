inherit NPC;

void create() {
  set_name("赵员外", ({ "zhao yuanwai", "yuanwai", "zhao" }));
  set("gender", "男性");
  set("age", 32 + random(10));
  set("str", 42 + random(10));
  set("long", "赵员外是方圆百里内有名的富豪。\n");
  set("combat_exp", 10000);
  set("attitude", "aggrensive");
  set_skill("unarmed", 30 + random(100));
  setup();
  add_money("silver", 50);
  carry_object("/d/city/obj/cloth/choupao")->wear();
}
