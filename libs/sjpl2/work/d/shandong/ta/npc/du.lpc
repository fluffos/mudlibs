#include <ansi.h>
inherit NPC;
void create() {
  set_name("杜守仓", ({ "du shoucang", "du" }));
  set("long", "
原大甲镖局的大镖头，镖局散伙后在此落脚。
\n");
  set("attitude", "friendly");
  set("title", HIY "金丸铁剑" NOR);
  set("max_gin", 500);
  set("max_kee", 500);
  set("max_sen", 500);
  set("age", 37);
  set("gender", "男性");
  set("str", 135);
  set("cor", 70);
  set("cps", 25);
  set("per", 14);
  set("combat_exp", 500000);
  set("chat_chance", 5);
  set("chat_msg", ({
    "杜守仓喃喃道：霍师父至今下落不明，莫非有什么不测？\n",
  }));
  set_skill("unarmed", 100 + random(100));
  set_skill("sword", 100 + random(100));
  set_skill("parry", 100 + random(100));
  set_skill("dodge", 100 + random(100));
  setup();
  carry_object("/obj/cloth")->wear();
  carry_object("/obj/longsword")->wield();
}
