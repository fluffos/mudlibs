#include <room.h>
inherit HOCKSHOP;

void create() {
  set("short", "泰安当铺");
  set("long", @LONG
这是一家中等规模的当铺。由于年代已经相当久远了，屋里的桌椅
柜台等物件都相当陈旧。这里的老板是药店何掌柜的堂哥，性情却完全
不同，可以说是爱财如命。泰安的老百姓如不遇到级个别情况谁也不愿
意来这里典当东西。但如果你没银子花了，找点值钱的东西当在这里或
许可以解一解燃眉之急。柜台上放着一块木牌(sign)。
LONG
  );
  set("item_desc", ([
    "sign": @TEXT
本当铺财力雄厚，童叟无欺，欢迎惠顾，绝对保密。
客倌可以在这里典当(pawn)、卖断(sell)各种货物，也可以在这里赎回
(redeem)自己的物品或购买(buy)别人典当的物品。

玩家可把物品估价(value)，或列出(list)可出售的物品。
TEXT
  ]));
  set("exits", ([
    "north": __DIR__ "ta-road7",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/dangpu_boss": 1,
  ]));
  set("hell", 1);
  setup();

}
void init() {
  add_action("do_value", "value");
  add_action("do_pawn", "pawn");
  add_action("do_sell", "sell");
  add_action("do_redeem", "redeem");
  add_action("do_buy", "buy");
  add_action("do_list", "list");
}
