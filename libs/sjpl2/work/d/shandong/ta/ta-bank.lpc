// ROOM:/u/shandong/ta-bank.c

inherit BANK;

void create() {
  set("short", "昌盛钱庄");
  set("long", @LONG
这是一家普通的钱庄。由于通存通兑业务的开展，生意也逐渐好了
起来。这里的掌柜姓周，与赵员外的独子赵宏业乃是同窗同学，又结为
异姓兄弟。所以连知府大人对他也是另眼向看。现在周掌柜正坐在柜台
后面一口接一口的裹着手里的水烟袋。柜台上摆着一块牌子。(sign)  
    往东走是一个丁字路口。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "east": __DIR__ "ta-road5",
  ]));

  set("item_desc", ([
    "sign": @TEXT
这里是钱庄，目前我们提供的服务有：
deposit       存款
withdraw      取款 
convert       兑换钱币。
balance       察寻存款。

货币种类:
coin  铜钱  silver  银子  gold   黄金
例如：
            convert 1 silver to coin     把一两银子换成铜钱
            deposit 100 silver           存十两银子入钱庄 
            withdraw 20 gold             从钱庄取出二十两金子

TEXT
  ]));
  set("objects", ([
    __DIR__ "npc/bank_boss": 1,
  ]));
  set("hell", 1);

  setup();
}
