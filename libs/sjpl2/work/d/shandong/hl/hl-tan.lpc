// Room: /d/shandong/hl-tan.c
inherit ROOM;
int do_hole(string str);

void create() {
  set("short", "黑龙潭");
  set("long", @LONG
这里就是黑龙潭了。坦水果然是黑的，据说有黑龙经常出没于此，
所以得名黑龙潭。这里群山环绕静地连一丝风也没有。你心里不禁又紧
张起来。看那潭水附近三尺以内寸草不生，怕是这潭水有毒。黑龙潭也
见到了，该往回走了。
    往西北走是一条用石子铺成的小径。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */

    "northwest": __DIR__ "hl-xiaojing5",
  ]));

  set("item_desc", ([ /* sizeof() == 1 */
    "附近": "这里竟然有一个洞口！试试能不能爬进去(hole in)。
",
  ]));
  set("outdoors", "shandong");
  set("hell", 1);
  setup();
}
void init() {
  add_action("do_hole", "hole");
}

int do_hole(string str) {
  object room, me = this_player();

  if (str != "in") return 0;
  if (me->query_skill("move", 1) < 10) {
    message_vision("$N缩身往里一钻，结果通地一声头撞在石壁上，起了个大包！\n", me);
    return 1;
  } else
    message_vision("$N缩身往里一钻，从狭小的洞口钻进去了。\n", me);
  if (!(room = find_object(__DIR__ "hl-dong3")))
    room = load_object(__DIR__ "hl-dong3");
  me->move(room);
  return 1;
}
