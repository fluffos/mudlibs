// Room: /u/shandong/hl-pubu.c

inherit ROOM;
int do_climb(string str);

void create() {
  set("short", "黑龙潭的瀑布");
  set("long", @LONG
这里是黑龙潭的瀑布了。这瀑布虽然没有黄果树瀑布般的宽阔。但
就其雄伟而言却也独树一帆。百花花的浪花从天而降，爆雷般的声音，
绮丽的彩虹，你不禁有点傻了。忽然你眼睛一亮，瀑布旁的半山腰上竟
然有一个黑黝黝的洞口，几根长藤(teng)从洞口一直垂到你的脚边，洞
口下的地上还散落着一堆白骨，你心里一惊：“真有黑龙、黑蛇？！”
    往西北走是一个石台。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "west": __DIR__ "hl-shitai",
  ]));
  set("item_desc", ([ /* sizeof() == 1 */
    "teng": "这是一条长藤，你可以试着(climb teng)爬上去。
",
  ]));
  set("outdoors", "shandong");

  set("hell", 1);

  setup();
}
void init() {
  add_action("do_climb", "climb");
}
int do_climb(string str) {
  object room, me = this_player();

  if (str != "teng") return 0;
  if (me->query_skill("move", 1) < 2) {
    message_vision("$N抓住长藤往上爬去，结果手一滑跌下来，摔了个四脚朝天！\n", me);
    return 1;
  } else
    message_vision("$N抓住长藤往上爬去，攀上了半山腰的石崖。\n", me);
  if (!(room = find_object(__DIR__ "hl-dong1")))
    room = load_object(__DIR__ "hl-dong1");
  me->move(room);
  return 1;
}
