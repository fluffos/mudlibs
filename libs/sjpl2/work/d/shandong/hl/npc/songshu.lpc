#include <ansi.h>

inherit NPC;
void reward_more(object who);

void create() {
  set_name("小松鼠", ({ "song shu", "shu" }));
  set("race", "野兽");
  set("gender", "雄性");
  set("age", 5);
  set("long", "这是一只可爱的松鼠，正在找松果吃. \n");

  set("str", 20);
  set("cor", 20);
  set("cps", 22);

  set("max_kee", 50);
  set("max_gin", 50);
  set("max_sen", 50);
  set("limbs", ({ "头部", "身体", "前脚", "後脚", "尾巴" }));
  set("verbs", ({ "bite", "claw" }));
  set_skill("move", 30);
  set_skill("dodge", 30);
  set("attitude", "friendly");
  set("env/wimpy", 70);
  set("chat_chance", 50);
  set("chat_msg", ({
    (: random_move :),
  }));

  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: reward_more(this_object()) :),
  }));
  set("combat_exp", 100);
  setup();
  carry_object(__DIR__ "meat");
}
void reward_more(object who) {
  int i;
  object *enemy;
  seteuid(getuid());
  enemy = who->query_enemy();
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      if (random(9) > 6) {
        if (enemy[i]->query("combat_exp") < 5000)
          enemy[i]->add("combat_exp", 1);
      } else if (enemy[i]->query_skill("move", 1) < 20)
        enemy[i]->improve_skill("move", 2);
    }
  }
  return;
}
int accept_fight(object me) {
  return 0;
}
