inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("煎饼果子", ({ "guozi" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "天津的著名小吃，哈哈！香着呢！\n");
    set("unit", "个");
    set("value", 80);
    set("food_remaining", 6);
    set("food_supply", 120);
  }
}
