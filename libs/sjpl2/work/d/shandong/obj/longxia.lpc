inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("红烧龙虾", ({ "longxia" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "现在，有钱就可以吃到龙虾，但古时候那可是精品中的精品呀！\n");
    set("unit", "盘");
    set("value", 4000);
    set("food_remaining", 50);
    set("food_supply", 400);
  }
}
