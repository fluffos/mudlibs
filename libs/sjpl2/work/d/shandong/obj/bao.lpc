inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("小笼蒸包", ({ "baozi", "bao" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一笼香喷喷的小笼蒸包\n");
    set("unit", "笼");
    set("value", 200);
    set("food_remaining", 10);
    set("food_supply", 120);
  }
}
