#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string summon_more(object who);
int about_quest();

void create() {
  set_name("萧之羽", ({ "xiao zhiyu", "xiao" }));
  set("long",
    "太湖水军统领，负责太湖水军的日常调度和训练。\n");
  set("nickname", CYN "五湖龙王" NOR);
  set("attitude", "heroism");
  set("student_title", "官员");
  create_family("朝廷", 6, "官员");
  set("title", "太湖水师统领");
  set("vendetta_mark", "authority");
  set("age", 43);
  set("str", 50);
  set("int", 30);
  set("cor", 30);
  set("spi", 30);
  set("agi", 30);
  set("max_kee", 1000);
  set("max_gin", 1000);
  set("max_sen", 1000);
  set("kee", 1000);
  set("gin", 1000);
  set("sen", 1000);
  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 20);
  set("score", 90000);
  set_temp("apply/attack", 30);
  set_temp("apply/defense", 30);
  set_temp("apply/move", 30);
  set("inquiry", ([
    "quest": (: about_quest :),
  ]));

  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: summon_more(this_object()) :),
    (: command, "escort" :),
  }));

  set("combat_exp", 3500000);
  set_skill("unarmed", 200);
  set_skill("dagger", 250);
  set_skill("force", 180);
  set_skill("parry", 120);
  set_skill("dodge", 110);
  set_skill("xingyi-ken", 200);
  set_skill("nezha_dagger", 220);
  set_skill("bixueforce", 150);
  set_skill("move", 100);
  set_skill("literate", 90);
  set_skill("officialism", 150);
  set_skill("strategy", 150);
  map_skill("unarmed", "xingyi-ken");
  map_skill("force", "bixueforce");
  map_skill("dagger", "nezha_dagger");
  setup();

  carry_object("/obj/cloth/tiejia")->wear();
  carry_object("/obj/weapon/longdagger")->wield();
}

int about_quest() {
  object me = this_player();
  int rate;

  if (me->query("guanfu/delay") == "navy") {
    command("say 我没有兵可以借给你，你去玉门关问张大人试试。\n");
    return 1;
  }

  if (me->query("quest/guanfu") != "navy1") {
    command("say 目前我管辖的沿海一带没有战事。\n");
    return 1;
  }
  if (random(9) > 4) {
    command("say 战船还没有准备好，请稍候再来。\n");
    return 1;
  }

  if (!me->query("battle/equip")) {
    command("say 大人，战船已经准备就绪，请装备武器(equip)。\n");
    return 1;
  } else
    command("say 大人，马上就要出征了，准备好了吗(ready)？\n");
  return 1;
}

void init() {
  add_action("give_equip", "equip");
  add_action("do_ready", "ready");
}

string summon_more(object who) {
  object soldier;
  seteuid(getuid());
  soldier = new("/obj/npc/bodyguard");
  soldier->move(environment(who));
  command("escort");
  return "1";
}

int give_equip(string arg) {
  object me = this_player();
  if (!arg)
    return notify_fail("请选择装备：\n
火箭（firebow）连弩（longbow）破舱标（javelin）投石器（stone）火炮（barbette）\n");
  if (arg == "firebow" || arg == "火箭") {
    me->set("battle/equip", "火箭");
    me->set("battle/damage", 50);
    write("火箭装备完毕。\n");
    return 1;
  }
  if (arg == "longbow" || arg == "连弩") {
    if (me->query_skill("strategy", 1) < 50)
      return notify_fail("你目前还不具备装备该武器的能力。\n");
    me->set("battle/equip", "连弩");
    me->set("battle/damage", 70);
    write("连弩装备完毕。\n");
    return 1;
  }
  if (arg == "javelin" || arg == "破舱标") {
    if (me->query_skill("strategy", 1) < 100)
      return notify_fail("你目前还不具备装备该武器的能力。\n");
    me->set("battle/equip", "破舱标");
    me->set("battle/damage", 90);
    write("破舱标装备完毕。\n");
    return 1;
  }
  if (arg == "stone" || arg == "投石器") {
    if (me->query_skill("strategy", 1) < 150)
      return notify_fail("你目前还不具备装备该武器的能力。\n");
    me->set("battle/equip", "投石器");
    me->set("battle/damage", 120);
    write("投石器装备完毕。\n");
    return 1;
  }
  if (arg == "barbette" || arg == "火炮") {
    if (me->query_skill("strategy", 1) < 200)
      return notify_fail("你目前还不具备装备该武器的能力。\n");
    me->set("battle/equip", "火炮");
    me->set("battle/damage", 150);
    write("火炮装备完毕。\n");
    return 1;
  }

  return 1;
}
int do_ready(object me) {
  object ship;
  me = this_player();
  if (me->query("quest/guanfu") != "navy1") {
    command("say 目前我管辖的沿海一带没有战事。\n");
    return 1;
  }
  if (!me->query("battle/equip"))
    return notify_fail("你还没有装备武器，请使用equip指令。\n");
  me->set("navy_type", "太湖水师");
  me->set("guanfu/battle", "navy");
  me->set("food", 0);
  me->set("water", me->max_water_capacity());
  if (random(9) > 4)
    ship = new("/obj/guanfu/ship1");
  else
    ship = new("/obj/guanfu/ship2");
  ship->set("already_battle", 1);
  me->move(ship);
  message_vision(HIC "\n$N登上了战舰。\n" NOR, me);
  message_vision(HIC "\n军士们吹起了号角，水师船队扬帆出发了。\n\n" NOR, me);
  write("（请使用status指令查看状态。）\n\n");
  return 1;
}
