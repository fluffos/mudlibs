// bettingbook.c
inherit ITEM;
void create() {
  set_name("赌术大全", ({ "bettingbook" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long",
      "这本旧书的纸张都已经泛黄了，上面只有一些字迹模糊的字句，似乎\n"
      "提到一些手法方法什麽的。\n");
    set("value", 70);
    set("material", "paper");
  }
}

void init() {
  add_action("do_du", "du");
  add_action("do_du", "study");
}

int do_du(string arg) {
  object me = this_player();
  object ob;
  string book;
  int level, sena;

  if (me->is_fighting()) {
    write("你无法在战斗中专心下来研读新知！\n");
    return 1;
  }
  if (me->is_busy()) {
    write("你上一个动作还没有完成，不能研读新知。\n");
    return 1;
  }
  if (!arg || sscanf(arg, "%s %d", book, sena) != 2) {
    write("指令格式：study <物品> <神数量>\n");
    return 1;
  }
  if (!objectp(ob = present(book, me))) {
    return 0;
  }
  if (!me->query_skill("literate", 1)) {
    write("你看不懂耶．．，先学学识字吧。\n");
    return 1;
  }
  level = me->query_skill("betting", 1);
  if (level < 7) {
    write("你连赌术最基本的东西都还不懂？如何能看得懂这本书？\n");
    return 1;
  }
  if ((int)me->query("combat_exp") < (int)level * level * level / 10) {
    write("你的实战经验不足，再怎么读也没用。\n");
    return 1;
  }
  if (sena < 20) {
    write("你至少要花二十点神\n");
    return 1;
  }
  if (me->query("sen") < sena) {
    write("你现在过於疲倦，无法专心下来研读次书。\n");
    return 1;
  } else me->receive_damage("sen", sena);
  if (level < 50) {
    write("你研读《赌术大全》入门篇，颇有心得。\n");
    me->improve_skill("betting", (int)me->query_skill("literate", 1) / 3 + sena);
    return 1;
  }
  if (level < 100) {
    write("你研读《赌术大全》进阶篇，颇有心得。\n");
    me->improve_skill("betting", (int)me->query_skill("literate", 1) / 3 + sena);
    return 1;
  }
  if (level < 150) {
    write("你研读《赌术大全》提高篇，颇有心得。\n");
    me->improve_skill("betting", (int)me->query_skill("literate", 1) / 3 + sena);
    return 1;
  }
  if (level < 200) {
    write("你研读《赌术大全》高级篇，颇有心得。\n");
    me->improve_skill("betting", (int)me->query_skill("literate", 1) / 3 + sena);
    return 1;
  }
  if (level < 250) {
    write("你研读《赌术大全》登峰造级篇，颇有心得。\n");
    me->improve_skill("betting", (int)me->query_skill("literate", 1) / 3 + sena);
    return 1;
  } else {
    write("你研读《赌术大全》通篇，苦苦思索，颇有心得。\n");
    me->improve_skill("betting", (int)me->query_skill("literate", 1) / 10 + sena);
    return 1;
  }
}
