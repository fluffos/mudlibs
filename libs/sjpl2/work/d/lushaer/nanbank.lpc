inherit ROOM;
void create() {
  set("short", "钱庄");
  set("long", @LONG
这是西域绝无仅有的一家钱庄，所以存贮着青藏人民大部分的才产。掌柜的
也相当受到当地人民的信任。钱庄中央有一红木柜台，半人多高，上有牌（sign）
一块。
LONG
  );

  set("exits", ([
    "east": __DIR__ "cxcenter",
  ]));
  set("item_desc", ([
    "sign": @TEXT
这里是钱庄，目前我们提供的服务有：

convert     兑换钱币。
withdraw    提取存款。
deposit     存入钱币。
balance     察寻存款。
loan        向钱庄借钱。
TEXT
  ]));


  set("objects", ([
    __DIR__ "npc/bankowner": 1,

  ]));


  setup();
}
