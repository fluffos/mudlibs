inherit ROOM;

void create() {
  set("short", "四桥烟雨");
  set("long", @LONG
这里就是扬州赫赫有名的四桥烟雨了。四桥乃虹桥，长春桥，春波
桥，莲花桥，其中莲花桥又称五亭桥，每当风雨萧萧，烟水苍苍时，四
桥笼罩在雨丝烟蔼之中，若隐若现，极烟云之趣。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "north": __DIR__ "qiao",
    "south": __DIR__ "zhongxin",
    "east": __DIR__ "jiulou",
    //           "west" : "/u/set/room/tiger_room",
  ]));
  set("objects", ([
    "/u/lark/fnpc/youke": 2,
  ]));
  set("no_clean_up", 0);

  setup();
  replace_program(ROOM);
}
