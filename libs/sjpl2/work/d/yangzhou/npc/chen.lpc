//NPC: yangzhou/chen.c
inherit NEW_VENDOR;
void create() {
  set_name("陈广泰", ({ "chen guangtai", "chen" }));
  set("title", "陈记布庄");
  set("gender", "男性");
  set("age", 42);
  set("long", "一位看上去很富态的老人，正在清点货物。\n");
  set("str", 12);
  set("int", 24);
  set("combat_exp", 500000);
  set("attitude", "friendly");
  set_skill("sword", 30);
  set_skill("parry", 30);
  set_skill("dodge", 30);

  set("inquiry", ([
    "布庄": "小店专卖各类布匹，请随便选。",
  ]));
  set("merchandise", ([
    "/obj/cloth/silk-cloth": 20,
    "/obj/cloth/color_cloth": 20,
  ]));
  setup();
  add_money("silver", 2);
  add_money("coin", 50);
  carry_object("/obj/cloth")->wear();
}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(4)) {
    case 0:
      say("老板抬起头看了你一眼，问道：客官想买什么布?\n");
      break;
    case 1:
      say("老板忙着清点货物，没有留意到你。\n");
  }
}
