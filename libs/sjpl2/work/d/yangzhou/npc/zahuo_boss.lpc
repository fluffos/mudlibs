#include <ansi.h>

inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("饶暗昌", ({ "rao anchang", "rao", "boss" }));
  set("gender", "男性");
  set("age", 43);
  set("nickname", HIC "及时雨" NOR);
  set("long", "这是一位乐善好施的店掌柜\n");
  set("combat_exp", 300000);
  set("str", 300);
  set("attitude", "friendly");
  set_skill("dodge", 100);
  set_skill("parry", 120);
  set("vendor_goods", ([
    __DIR__ "obj/shiyan": 7,
    __DIR__ "obj/jiangyou": 7,
    __DIR__ "obj/caiyou": 7,
    __DIR__ "obj/baitang": 7,
  ]));

  setup();
  carry_object("/obj/cloth")->wear();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
}
void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(10)) {
    case 0:
      say(" 饶暗昌笑着道：这位"
        +RANK_D->query_respect(ob)
        + "，买东西吗？ \n");
      break;
    case 1:
      say(" 饶暗昌笑着道：这位"
        +RANK_D->query_respect(ob)
        + "，买点杂货吧。 \n");
      break;

  }
}
