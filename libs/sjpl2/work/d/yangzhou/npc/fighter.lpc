// NPC: yecha/fighter.c
inherit NPC;
void create() {
  set_name("趟子手", ({ "fighter" }));
  set("gender", "男性");
  set("age", 30);
  set("str", 30);
  set("cor", 30);
  set("cps", 30);
  set("int", 30);
  set("long", "这是一个虎背熊腰的男子。\n");
  set("combat_exp", 800000);
  set("env/wimpy", 2);
  set("force", 5000);
  set("max_force", 3000);
  set_skill("literate", 50);
  set_skill("dodge", 150);
  set_skill("parry", 150);
  set_skill("unarmed", 250);
  set_skill("sword", 250);
  set_skill("chaos-steps", 150);
  map_skill("dodge", "chaos-steps");
  setup();
  carry_object("/obj/longsword")->wield();
  carry_object("/obj/cloth")->wear();
}
