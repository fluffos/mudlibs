#include <ansi.h>

inherit NPC;
int about_bai();
void create() {
  set_name("欧阳修", ({ "ouyang xiu", "xiu" }));
  set("age", 25);
  set("long",
    "大内扬州知府");
  create_family("朝廷", 7, "官员");

  set("str", 27);
  set("cor", 26);
  set("cps", 25);

  set("combat_exp", random(50) * 10000);
  set("inquiry", ([
    "白为堂": (: about_bai :),
  ]));

  set_skill("force", 50 + random(70));
  set_skill("bixueforce", 100);
  set_skill("chaos-steps", 100);
  set_skill("unarmed", 50 + random(70));
  set_skill("xingyi-ken", 88);
  set_skill("parry", 50 + random(70));
  set_skill("dodge", 50 + random(70));
  set_skill("move", 80 + random(70));
  set_skill("blade", 50 + random(70));
  set_skill("spring-blade", 50);
  map_skill("blade", "spring-blade");
  map_skill("unarmed", "xingyi-ken");
  map_skill("parry", "spring-blade");
  map_skill("dodge", "chaos-steps");
  map_skill("force", "bixueforce");

  set_temp("apply/attack", 30);
  set_temp("apply/defense", 30);
  set_temp("apply/damage", 10 + random(20));
  set_temp("apply/armor", 30);
  set_temp("apply/move", 30);
  set("chat_chance", 10);
  set("chat_msg", ({

    "欧阳修对你拱了拱手，说道：这位好汉，看你也是江湖中人，可曾看见一位穿白袍的公子？\n"
  }));

  setup();

  carry_object(__DIR__ "obj/yafu")->wear();
  carry_object(__DIR__ "obj/blade")->wield();
}
int about_bai() {
  object me;
  object book;
  int score, pot;
  me = this_player();
  score = (int)me->query("combat_exp");
  pot = (int)me->query("potential");
  if (pot < 2) {
    command("say 啊，你认识白大哥呀！来，来，咱俩好好叙叙！ \n");
    me->set("combat_exp", (int)score + 1);
    me->set("potential", (int)pot + 1);
    return 1;
  }

  else {
    say("欧阳修说道：这位" + RANK_D->query_respect(me) + "，这本书是当年白大哥留给我的，现在送给你吧。\n");
    book = new("/d/obj/old_book");
    book->move(me);
    return 1;
  }
  return 0;
}
