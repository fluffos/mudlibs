// bladebook.c

inherit ITEM;

void create() {
  int i;

  string *names = ({
    "「控鹤功」"
  });

  string *skills = ({
    "driving"
  });

  i = random(1);
  set_name(names[i], ({ "book" }));
  set_weight(100);
  set("no_transfer", 1);
  set("unit", "本");
  set("long", "这是一本修练驾驭飞禽的书籍。\n");
  set("skill", ([
    "name": skills[i],
    "exp_required": 0,
    "sen_cost": 20,
    "difficulty": 20,
    "max_skill": 20

  ]));
}
