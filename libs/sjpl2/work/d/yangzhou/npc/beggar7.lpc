// beggar.c

inherit NPC;

void create() {
  set_name("中年乞丐", ({ "beggar" }));
  set("gender", "男性");
  set("age", 38);
  set("long", "一个满脸泥污的中年乞丐，身上背着七个布袋。\n");
  set("combat_exp", 200000);
  set("str", 27);
  set("force", 2100);
  set("max_force", 2100);
  set("force_factor", 80);
  set_skill("dodge", 250);
  set_skill("force", 250);
  set_skill("unarmed", 120);
  set_skill("hl18-strike", 80);
  map_skill("unarmed", "hl18-strike");
  setup();
  carry_object("/obj/beg_cloth")->wear();
  carry_object("/obj/bag");
  carry_object("/obj/bag");
  carry_object("/obj/bag");
  carry_object("/obj/bag");
  carry_object("/obj/bag");
  carry_object("/obj/bag");
  carry_object("/obj/bag");
}

int accept_fight(object me) {
  command("say " + RANK_D->query_respect(me) +
    "想玩两手？我奉陪就是。\n");
  set("force_factor", 10);
  return 1;
}
