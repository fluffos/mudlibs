#include <ansi.h>
inherit NPC;
int about_he();
void create() {
  set_name("中年妇女", ({ "woman" }));
  set("gender", "女性");
  set("age", 45);
  set("long",
    "这是一个慈祥的中年妇人\n"
  );
  set("attitude", "friendly");
  set("combat_exp", 100);
  set("inquiry", ([
    "help": (: about_he :),
  ]));
  setup();
  carry_object(__DIR__ "obj/cloth")->wear();

}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}
void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  command("say 孩子，你在江湖上闯荡要自己照顾好自己啊！。\n");

}
