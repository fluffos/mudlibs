// bandit_chief.c

inherit NPC;

void create() {
  set_name("土匪喽罗", ({ "chief", "tufei" }));
  set("gender", "男性");
  set("age", 29);
  set("long",
    "这家伙眼神凶恶，一双精光四射的眼珠正盯著你的脖子。\n");
  set("combat_exp", 100000);
  set("score", 700);
  set("daode", -500);
  set_skill("blade", 80);
  set_skill("parry", 80);
  set_skill("dodge", 80);

  // Because the chief's 武功 is not done yet, set apply to replace it.
  set_temp("apply/attack", 50);
  set_temp("apply/dodge", 30);

  setup();
  carry_object("/obj/blade")->wield();
  carry_object("/obj/cloth")->wear();
  add_money("silver", 20);
}
