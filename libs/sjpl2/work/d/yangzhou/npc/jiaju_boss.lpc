#include <ansi.h>

inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("齐明阳", ({ "qi mingyang", "qi", "boss" }));
  set("gender", "男性");
  set("age", 43);
  set("nickname", HIG "闹市侠隐" NOR);
  set("long", "这是一位面色青紫的店掌柜\n");
  set("combat_exp", 700000);
  set("str", 30);
  set("agi", 30);
  set("max_kee", 1000);
  set("max_gin", 1000);
  set("max_sen", 1000);
  set("kee", 1000);
  set("gin", 1000);
  set("sen", 1000);
  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 20);
  set("score", 90000);
  set("attitude", "friendly");
  set_skill("dodge", 100);
  set_skill("parry", 120);
  set_skill("unarmed", 120);
  set_skill("iron_strike", 120);
  map_skill("unarmed", "iron_strike");
  set("vendor_goods", ([
    "/d/city/obj/misc/table": 7,
    "/d/city/obj/misc/seat": 7,
    "/d/city/obj/misc/woodseat": 7,
    "/d/city/obj/misc/woodtable": 7,
  ]));

  setup();
  carry_object("/obj/cloth")->wear();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
}
void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(10)) {
    case 0:
      say(" 齐明阳笑着道：这位"
        +RANK_D->query_respect(ob)
        + "，买家具吗？ \n");
      break;
    case 1:
      say(" 齐明阳笑着道：这位"
        +RANK_D->query_respect(ob)
        + "，本店的家具都是上品，买吧。 \n");
      break;

  }
}
