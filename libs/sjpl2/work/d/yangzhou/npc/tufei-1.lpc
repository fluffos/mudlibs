// bandit_chief.c

inherit NPC;

void create() {
  set_name("土匪头目", ({ "chief", "tufei" }));
  set("gender", "男性");
  set("age", 39);
  set("long",
    "这家伙眼神凶恶，一双精光四射的眼珠正盯著你的脖子。\n");
  set("combat_exp", 200000);
  set("score", 700);
  set("daode", -500);
  set("chat_chance", 10);
  set("chat_msg_combat", ({
    "\n土匪头目阴恻恻地说道：乖乖地躺下吧！\n",
    "\n土匪头目虎吼一声，欺身上前。\n"
  }));
  set_skill("blade", 120);
  set_skill("parry", 120);
  set_skill("dodge", 120);

  // Because the chief's 武功 is not done yet, set apply to replace it.
  set_temp("apply/attack", 50);
  set_temp("apply/dodge", 30);

  setup();
  carry_object("/obj/blade")->wield();
  carry_object("/obj/cloth")->wear();
  add_money("silver", 50);
}

void start_help() {
  say("一条人影从树林间跃出，身手矫健，显是武功不弱。\n");
  command("say 哈哈哈... 连这几个小角色也打发不了，站开一点！\n");
}
