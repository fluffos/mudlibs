#include <ansi.h>
#include <combat.h>
void weapon_break(object me, object victim, object weapon, object ob);
int rigidity(object me, object victim, int wap, int wdp, object weapon, object ob);

void parry(object me, object victim, object weapon) {
  object ob;
  int w_r, w_s, o_s, o_r, wap, wdp;

  ob = victim->query_temp("weapon");
  // 情况一：双方都没武器
  if (!objectp(ob) && !objectp(weapon)) {}
  // 情况二：双方都有武器
  else if (objectp(ob) && objectp(weapon)) {
    w_s = (int)weapon->weight() / 500 + (int)weapon->query("sharpness");
    w_r = (int)weapon->weight() / 500 + (int)weapon->query("rigidity");
    o_s = (int)ob->weight() / 500 + (int)ob->query("sharpness");
    o_r = (int)ob->weight() / 500 + (int)ob->query("rigidity");

    wap = (int)weapon->weight() / 500 + (int)weapon->query("rigidity") + (int)me->query_str();
    wdp = (int)ob->weight() / 500 + (int)ob->query("rigidity") + (int)victim->query_str();
    wap = random(wap);
    wap = random(wap);
    if (w_s > o_r && random(w_s) > o_r)
      weapon_break(me, victim, weapon, ob);
    else if (o_s > w_r && random(o_s) > w_r)
      weapon_break(victim, me, ob, weapon);
    else if (!rigidity(me, victim, wap, wdp, weapon, ob))
      message_vision("$N的" + weapon->name() + "和$n的" + ob->name()
        + "相击，冒出点点的火星。\n", me, victim);
  }
  // 情况三：防守方有武器，攻击方没有
  else if (objectp(ob) && !objectp(weapon)) {}
  // 情况四：攻击方有武器，防守方没有，不招架
  return;
}

void weapon_break(object me, object victim, object weapon, object ob) {
  message_vision(HIW "不料$N的" + ob->name() + "和$n手中" + weapon->name()
    + "一碰，「啪」地一声被削断！\n" NOR, victim, me);
  ob->unequip();
  ob->move(environment(victim));
  ob->set("name", "断掉的" + ob->query("name"));
  ob->set("value", (int)ob->query("value") / 10);
  ob->set("weapon_prop", 0);
  victim->reset_action();
}

int rigidity(object me, object victim, int wap, int wdp, object weapon, object ob) {
  if (wap > 2 * wdp) {
    message_vision(HIW "$N只觉得手中" + ob->name() + "把持不定，脱手飞出！\n" NOR, victim);
    ob->unequip();
    ob->move(environment(victim));
    victim->reset_action();
    return 1;
  } else if (wap > wdp) {
    message_vision("$N只觉得手中" + ob->name() + "一震，险些脱手！\n", victim);
    return 1;
  } else if (wap > wdp / 2) {
    message_vision(HIW "只听见「啪」地一声，$N手中的" + ob->name()
      + "已经断为两截！\n" NOR, victim);
    ob->unequip();
    ob->move(environment(victim));
    ob->set("name", "断掉的" + ob->query("name"));
    ob->set("value", (int)ob->query("value") / 10);
    ob->set("weapon_prop", 0);
    victim->reset_action();
    return 1;
  }
  return 0;
}
