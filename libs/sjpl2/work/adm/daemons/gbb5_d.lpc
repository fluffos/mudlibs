// gbb5_d.c
// A BIG5-GB code converter.
// by Mai@神剑魔刀  10-31-97

#pragma save_binary

#define DICTIONARY DATA_DIR + "gbb5"

inherit F_CLEAN_UP;
inherit F_SAVE;
mapping gbb5 = ([]);
void create() {
  seteuid(getuid());
  restore();
}


string query_save_file() { return DICTIONARY; }

string gbb5(string gb) {
  if (!undefinedp(gbb5[gb])) return gbb5[gb];
  else return gb;
}

void add_translate(string gb, string big5) {
  gbb5[gb] = big5;
  save();
}

string to_b5(string str) {
  int i = 0;
  string b5 = "";
  string tmp = "  ";
  string en = " ";
  if (strlen(str) >= 2) {
    while (i < strlen(str) - 1) {
      if (str[i] > 160 && str[i] < 255) {
        tmp[0] = str[i];
        i++;
        tmp[1] = str[i];
        b5 = b5 + gbb5(tmp);
      } else {
        en[0] = str[i];
        b5 = b5 + en;
      }
      i++;
    }
    if (i < strlen(str)) {
      en[0] = str[i];
      b5 = b5 + en;
    }
    return b5;
  } else return str;
}

mapping query_all_gb() { return gbb5; }
