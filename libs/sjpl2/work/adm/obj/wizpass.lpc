// Room: /adm/wizpass.c    baiwt@sjpl  12,13,1999

inherit ROOM;
void create() {
  set("short", "巫师身份验证处");
  set("long", @LONG
这里是检查正式巫师身份的地方。“书剑飘零”的正式巫师各自拥有自己
的“巫师验证码”，该码是唯一的，目的在于防止巫师密码被人盗窃以至于对
系统造成伤害。请正确输入巫师验证码（input <验证码>）。
LONG
  );
  set("no_clean_up", 0);
  set("no_fight", 1);
  set("no_magic", 1);
  set("no_steal", 1);
  set("no_study", 1);
  set("oldarea", 1);
  set("hell", 1);
  setup();
  //	replace_program(ROOM);
}

void init() {
  add_action("input_wizpass", "input");
  add_action("close_cmds", "goto");
  add_action("close_cmds", "clone");
  add_action("close_cmds", "cat");
  add_action("close_cmds", "edit");
  add_action("close_cmds", "call");
  add_action("close_cmds", "callouts");
  add_action("close_cmds", "more");
  add_action("close_cmds", "set");
  add_action("close_cmds", "chblk");
  add_action("close_cmds", "unchblk");
  add_action("close_cmds", "summon");
  add_action("close_cmds", "to");
  add_action("close_cmds", "suicide");
  add_action("close_cmds", "shout");
  add_action("close_cmds", "reboot");
  add_action("close_cmds", "edemote");
  add_action("close_cmds", "kickout");
  add_action("close_cmds", "shutdown");
  add_action("close_cmds", "purge");
  add_action("close_cmds", "ban");
  add_action("close_cmds", "snoop");
  add_action("close_cmds", "tell");
  add_action("close_cmds", "rumor");
  add_action("close_cmds", "sjpl");
  add_action("close_cmds", "sjpl*");
  add_action("close_cmds", "rumor*");
  add_action("close_cmds", "chat*");
  add_action("close_cmds", "chat");
  add_action("close_cmds", "sys");
  add_action("close_cmds", "smash");
  add_action("close_cmds", "bt");
  add_action("close_cmds", "bangtalk");
  add_action("close_cmds", "wizlock");
}

int input_wizpass(string arg) {
  int status;
  string wizpass;
  object me = this_player();
  status = me->query("kee") + me->query("gin") + me->query("sen");
  wizpass = (string)me->query("id") + (string)status + chinese_number(me->query("age"));
  me->set("wiz_passport", wizpass);
  if (!arg) return notify_fail("请输入验证码。\n");
  if (arg == (string)me->query("wiz_passport")) {
    message_vision("\n检验中...OK！\n\n", this_player());
    me->move("/d/wiz/jobroom");
    return 1;
  } else
    tell_object(me, "\n巫师验证码检验失败！\n\n");
  "/cmds/usr/quit"->main(me);
  return 1;

}
int close_cmds(object me, string arg) {
  return 1;
}
