//玄冰奇寒
#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration) {
  me->receive_wound("gin", 30);
  me->receive_wound("kee", 30);
  me->receive_wound("sen", 30);
  me->apply_condition("icesick", duration - 1);
  if (duration < 1)
    tell_object(me, YEL "你中的" HIW "玄冰奇寒" YEL "终于发作光了！\n" NOR);
  else
    tell_object(me, YEL "你中的" HIW "玄冰奇寒" YEL "发作了！\n" NOR);
  if (duration < 1)
    return 0;
  return 1;
}
