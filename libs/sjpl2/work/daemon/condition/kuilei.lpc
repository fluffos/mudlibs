// kuileigu.c

#include <ansi.h>
#include <combat.h>

int update_condition(object me, int duration) {
  string msg, fakename;
  object target;
  target = environment(me);
  fakename = me->query("fake_name");
  if (userp(target)) {
    msg = HIB + fakename + "嘿嘿冷笑，黑暗中向$n发起突然攻击！\n" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  }
  me->apply_condition("kuilei", duration - 1);
  if (duration < 1) {
    tell_object(target, BLU + fakename + "的声音“哼”了一声，渐渐远去了！\n" NOR);
    if (!userp(me)) destruct(me);
    return 1;
  } else
    tell_object(target, BLU "你只听到一个声音在耳边说道：你就算逃到天涯海角，也逃不出我的掌心！\n" NOR);
  if (duration < 1)
    return 0;
  return 1;
}
