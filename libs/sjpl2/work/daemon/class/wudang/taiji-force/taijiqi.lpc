//太和内劲
#include <ansi.h>

inherit SSERVER;

int exert(object me, object target) {
  string msg;
  object weapon;
  int skill, ap, dp, damage;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［太和内劲］只能对战斗中的对手使用。\n");
  skill = me->query_skill("taiji-force", 1);

  if (skill < 50)
    return notify_fail("你的太极神功等级不够, 不能使用「太和内劲」！\n");
  if (me->query_skill_mapped("unarmed") != "taiji-ken")
    return notify_fail("「太和内劲」只有配合太极拳才能发挥威力。\n");
  if (me->query_skill_mapped("sword") != "taiji-sword")
    return notify_fail("「太和内劲」只有配合太极剑才能发挥威力。\n");

  if ((int)me->query("force") < 200)
    return notify_fail("你的内力不够，无法运用「太和内劲」！\n");
  if (me->query_soft_powerup())
    return notify_fail("你不能再同时施展「太和内劲」了！\n");

  msg = CYN "\n$N内劲鼓动，默潜太极神功之「太和内劲」, 顿时内力绵绵不绝，向$n疾卷而去。\n";
  message_vision(msg, me, target);

  damage = 10 + random(skill / 2);
  ap = me->query_skill("force") + skill;
  dp = target->query_skill("force") / 2;
  if (dp < 1)
    dp = 1;
  if (random(ap) > dp) {
    if (objectp(weapon = target->query_temp("weapon"))) {
      weapon = target->query_temp("weapon");
      if (random(ap) > dp) {
        msg = "$n顿时觉得手腕一沉，手中";
        msg += weapon->name();
        msg += "被一股大力绞住，再也拿捏不定，竟然脱手飞出！\n" NOR;
        weapon->move(environment(me));
      } else {
        msg = "\n可是$n气灌丹田，立刻将手中" + weapon->name() + "拿得坚如磐石，抵住了$N的「太和内劲」。\n" NOR;
      }
    }
    me->soft_powerup(damage, 30);
    if (!target->query_delay()) {
      target->set_delay(damage / 2);
      if (userp(target)) target->add("p_power_rank", -skill * 3);
    }
    msg = CYN "\n$N圆转如意的「太和内劲」将$n压迫得难以施展武功。\n";
  } else {
    msg = "\n可是$n运起神功，抵住了$N的「太和内劲」。\n" NOR;
  }
  message_vision(msg, me, target);
  if (userp(me))
    me->add("force", -30);
  me->set_delay(6);
  return 1;
}
