//乱环诀
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target) {
  object soldier, soldier2;
  string arg;
  int quan, qi, exp, MAX_TAIJI;
  if ((int)me->query("sen") < 100)
    return notify_fail("你的神太差了！\n");
  if ((int)me->query("force") < 200)
    return notify_fail("你的内力不够！\n");
  if (!me->is_fighting())
    return notify_fail("［乱环诀］只能在战斗中使用。\n");

  quan = (int)me->query_skill("taiji-ken");
  qi = (int)me->query_skill("taiji-force");
  exp = (int)me->query("combat_exp");
  if (quan < 30 || qi < 30)
    return notify_fail("你的[太极拳]和[太极神功]太差了，没法施展[乱环诀]！\n");
  if (me->query_skill_mapped("force") != "taiji-force")
    return notify_fail("太极拳只有配合「太极神功」才能发挥威力。\n");

  MAX_TAIJI = quan * qi / 10000 + 1;
  if ((int)me->query_temp("max_taiji") >= 2)
    return notify_fail("你已经在施展［乱环诀］了。\n");
  seteuid(getuid());
  me->receive_damage("sen", 100);
  me->add("force", -100);
  soldier = new("/daemon/class/wudang/tjshadow");
  soldier2 = new("/daemon/class/wudang/tjshadow");
  soldier->move(environment(me));
  soldier2->move(environment(me));
  soldier->invocation(me, (quan + qi));
  soldier2->invocation(me, (quan + qi));
  soldier->set("possessed", me);
  soldier2->set("possessed", me);
  soldier->set("combat_exp", exp);
  soldier2->set("combat_exp", exp);
  me->add_temp("max_taiji", 2);
  message_vision(YEL "\n$N双拳突然连续画出了无数太极拳影，向四面八方扩散开来 ！\n" NOR, me);
  message_vision(CYN "\n$N施展出了太极拳中最高深的[乱环诀]！\n" NOR, me);
  return 1;
}
