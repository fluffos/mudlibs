// bo.c 太极拳「四两拔千斤」   麦永佳  1997.06.18 baiwt@sjpl 2000
#include <ansi.h>
inherit SSERVER;

int perform(object me, object target) {
  int damage;
  string msg;

  if (!target) target = offensive_target(me);

  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("「四两拔千斤」只能对战斗中的对手使用。\n");

  if (objectp(me->query_temp("weapon")))
    return notify_fail("你必须空手才能使用「四两拔千斤」！\n");

  if ((int)me->query_skill("taiji-ken", 1) < 30)
    return notify_fail("你的太极拳不够娴熟，不会使用「四两拔千斤」。\n");

  if ((int)me->query_skill("taiji-force", 1) < 30)
    return notify_fail("你的太极神功不够高，不能用「四两拔千斤」。\n");

  if (me->query_skill_mapped("force") != "taiji-force")
    return notify_fail("太极拳只有配合「太极神功」才能发挥威力。\n");

  if ((int)me->query("force", 1) < 100)
    return notify_fail("你现在内力太弱，不能使用「四两拔千斤」。\n");

  msg = CYN "$N默运神功，使出太极拳「四两拔千斤」绝技，企图以巧妙的劲力把$n摔出去。\n" NOR;

  if ((target->query_skill_mapped("whip") == "huangsha-whip") &&
    ((int)target->query_skill("whip", 1) > (int)me->query_skill("taiji-ken"))) {
    message_vision(msg, me, target);
    message_vision(CYN "\n但是$n怪招迭出，将$N的攻势全部化解了！\n" NOR, me, target);
    return 1;
  }

  if (random(me->query_skill("force")) > target->query_skill("force") / 2) {
    me->start_busy(2);
    target->start_busy(1 + random(3));

    damage = (int)me->query_skill("taiji-force", 1);

    damage = damage / 2 + random(damage);

    target->receive_damage("kee", damage / 2);
    target->receive_damage("sen", damage / 5);
    me->add("force", -damage / 10);
    if (!target->query_delay())
      target->set_delay(10);
    if (damage < 20) msg += HIY "结果$n受到$N的内力牵引，闷哼一声，身体晃了几下。\n" NOR;
    else if (damage < 40) msg += HIY "结果$n被$N以内力牵引，身体竟被甩在五六步外，几乎站不稳。\n" NOR;
    else if (damage < 80) msg += RED "结果$n被$N以内力牵引，只觉一阵麻木，身体不由自主飞出丈许，重重摔在地上！\n" NOR;
    else msg += HIR "结果$N被$n的内力牵引，眼前一黑，身子象稻草般飞了出去！！\n" NOR;

  } else {
    me->start_busy(1);
    msg += CYN "可是被$n轻轻避开了。\n" NOR;
  }
  message_vision(msg, me, target);

  return 1;
}
