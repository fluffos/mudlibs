// 缩骨人形

#include <ansi.h>

inherit NPC;
void backattack();
void create() {

  set_name("缩骨人形", ({ "suogu ren", "suogu" }));
  set("long", "这是一个用瑜珈功缩小的人形。\n");
  set("attitude", "friendly");
  set("max_atman", 100);
  set("atman", 100);
  set("max_mana", 100);
  set("mana", 100);
  set("str", 40);
  set("cor", 30);
  set("cps", 25);
  set("combat_exp", 20000);
  set_skill("unarmed", 20);
  set_skill("parry", 20);
  set_skill("dodge", 100);
  set_skill("move", 100);
  setup();
}

int heal_up() {
  if (environment() && !is_fighting()) {
    call_out("leave", 1);
    return 1;
  }
  if (is_fighting() && (int)this_object()->query("kee") <= 100)
    backattack();
  return ::heal_up() + 1;
}

void leave() {
  message("vision",
    "地上飘起了一阵尘烟，小人形眨眼消失了。。。\n", environment(),
    this_object());
  destruct(this_object());
}

void invocation(object who, int level) {
  int i;
  object *enemy;
  set_skill("unarmed", 20 + random(level / 2));
  set_skill("parry", 20 + random(level / 2));
  set_skill("dodge", 100 + random(level / 2));
  set_skill("move", 100 + random(level / 2));
  set("combat_exp", 20000 + random(level / 4 * level * level));
  message("vision",
    "地上飘起了一阵尘烟。。。\n" NOR,
    environment(), this_object());
  enemy = who->query_enemy();
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      kill_ob(enemy[i]);
      if (userp(enemy[i])) enemy[i]->fight_ob(this_object());
      else enemy[i]->kill_ob(this_object());
    }
  }
  set_leader(who);
  set("possessed", who);
}
void backattack() {
  int i;
  object owner, *enemy;
  if (objectp(owner = this_object()->query("possessed"))) {
    enemy = this_object()->query_enemy();
    i = sizeof(enemy);
    while (i--) {
      if (enemy[i] && living(enemy[i])) {
        owner->kill_ob(enemy[i]);
        enemy[i]->kill_ob(owner);
      }
    }

  }

}

void die() {
  message("vision",
    "地上飘起了一阵尘烟，小人形眨眼消失了。。。\n" NOR,
    environment(), this_object());
  destruct(this_object());
}
