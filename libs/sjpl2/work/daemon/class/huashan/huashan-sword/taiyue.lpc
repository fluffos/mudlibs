// taiyue.c  太岳三青峰

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target) {
  object weapon, ob;
  string msg, string1;
  int count;

  if (!me->is_fighting())
    return notify_fail("「太岳三青峰」只能在战斗中使用。\n");
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("「太岳三青峰」开始时必须拿着一把剑！\n");
  if (me->query_skill_mapped("sword") != "huashan-sword")
    return notify_fail("你现在并没有用华山剑法！\n");
  if ((int)me->query("perform/huashan/taiyue") < 1000)
    return notify_fail("你还没有学会「太岳三青峰」！\n");
  else if ((int)me->query("perform/huashan/taiyue") < 2000) {
    if ((int)me->query("force") < 100)
      return notify_fail("你的内力不足！\n");
    msg = HIY "$N使出华山派绝技「太岳三青峰」，手中" + weapon->name() + HIY "接连攻出！\n" NOR;
    message_vision(msg, me);
    me->clean_up_enemy();
    ob = me->select_opponent();
    me->add_temp("apply/attack", -3);

    if (ob->query_skill(
      "iron-cloth",
      1
    ) && ob->query_skill("iron-cloth") < random(me->query_skill("sword") * 2)) {
      message_vision(HIR "\n结果$N强大的剑气摧破了$n的真元！\n" NOR, me, ob);
      ob->receive_wound("kee", (int)me->query_skill("huashan-sword", 1) * 3);
      COMBAT_D->report_status(ob, 1);
      me->add_temp("apply/attack", 3);
      me->start_busy(2);
      return 1;
    }
    message_vision(HIG "玉女！\n" NOR, me);
    COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
    message_vision(HIW "芙蓉！\n" NOR, me);
    COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
    message_vision(HIR "朝阳！\n" NOR, me);
    COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
    message_vision(HIY "$N似乎所学不精，出招之后漏出好大一个破绽。\n" NOR, me);
    me->add_temp("apply/attack", 3);

    me->add("force", -100);
    me->start_busy(3 + random(2));
    return 1;
  } else if ((int)me->query("perform/huashan/taiyue") < 3000) {
    if ((int)me->query("force") < 150)
      return notify_fail("你的内力不足！\n");
    msg = HIY "$N使出华山派绝技「太岳三青峰」，手中" + weapon->name() + HIY "接连攻出！\n" NOR;
    message_vision(msg, me);
    me->clean_up_enemy();
    ob = me->select_opponent();
    me->add_temp("apply/attack", -3);
    message_vision(HIG "玉女！\n" NOR, me);
    COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
    message_vision(HIW "芙蓉！\n" NOR, me);
    COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
    message_vision(HIR "朝阳！\n" NOR, me);
    COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
    me->add_temp("apply/attack", 3);

    me->add("force", -150);
    me->start_busy(2);
    return 1;
  } else {
    if ((int)me->query("force") < 200)
      return notify_fail("你的内力不足！\n");
    msg = HIY "$N以意使剑，将华山派绝技「太岳三青峰」发挥到极至，手中" + weapon->name() + HIY "接连攻出！\n" NOR;
    message_vision(msg, me);
    me->clean_up_enemy();
    ob = me->select_opponent();
    me->add_temp("apply/attack", -6);

    message_vision(HIG "玉女！\n" NOR, me);
    COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
    message_vision(HIW "芙蓉！\n" NOR, me);
    COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
    message_vision(HIR "朝阳！\n" NOR, me);
    COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
    message_vision(HIY "$N剑法已至剑随人意的地步，前招未止，后势又至，顺手将「太岳三青峰」反过来再连环使出！\n" NOR, me);
    message_vision(HIR "朝阳！\n" NOR, me);
    COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
    message_vision(HIW "芙蓉！\n" NOR, me);
    COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
    message_vision(HIG "玉女！\n" NOR, me);
    COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
    me->add_temp("apply/attack", 6);

    me->add("force", -200);
    me->start_busy(3 + random(2));
    return 1;
  }

}
