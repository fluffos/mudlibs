// swordgod.c

#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me, int amount1, int amount2, int amount3);

int exert(object me, object target, object weapon) {
  int sk1, sk2, performlvl;
  sk1 = (int)me->query_skill("huashan-force");
  performlvl = me->query("perform/huashan/swordgod");

  if (target != me)
    return notify_fail("「剑神决」只能对自己起作用。\n");
  if (!me->is_fighting())
    return notify_fail("「剑神决」只能在战斗中使用。\n");

  if ((int)me->query_temp("swordgod"))
    return notify_fail("你已经在运功中了。\n");

  if (!objectp(weapon = target->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你所持武器不对。\n");

  if (performlvl < 1000)
    return notify_fail("你还没有学会「剑神决」！\n");

  else if (performlvl < 2000) {
    if ((int)me->query("force") < 150)
      return notify_fail("你的内力不够。\n");
    me->add("force", -150);
    message_vision(HIB "$N使出剑宗绝学「剑神决」，但似乎使得有些拙劣！\n" NOR, me);
    me->add_temp("apply/sword", sk1 / 5);
    me->add_temp("apply/attack", sk1 / 5);
    me->add_temp("apply/dodge", -sk1 / 3);
    me->set_temp("swordgod", 1);
    me->start_call_out(
      (: call_other, __FILE__, "remove_effect", me, sk1 / 5, sk1 / 5, sk1 / 3 :),
      sk1 / 2
    );
    me->start_busy(2);
    return 1;
  } else if ((int)me->query("perform/huashan/swordgod") < 3000) {
    if ((int)me->query("force") < 200)
      return notify_fail("你的内力不够。\n");
    me->add("force", -200);
    message_vision(HIB "$N略一凝神，手中$n" + HIB "平举于胸，使出剑宗绝学「剑神决」，剑法一下子精妙起来！\n" NOR, me, weapon);
    me->add_temp("apply/sword", sk1 / 4);
    me->add_temp("apply/attack", sk1 / 4);
    me->add_temp("apply/dodge", -sk1 / 5);
    me->set_temp("swordgod", 1);
    me->start_call_out(
      (: call_other, __FILE__, "remove_effect", me, sk1 / 4, sk1 / 4, sk1 / 5 :),
      sk1 / 2
    );
    me->start_busy(2);
    return 1;
  } else {
    if ((int)me->query("force") < 250)
      return notify_fail("你的内力不够。\n");
    me->add("force", -250);
    message_vision(HIB "$N手中$n" + HIB "轻轻一举起,伴随着一声「剑神决」！$n已幻作漫天银光！\n"
      + "$N的出招也甚是飘逸洒脱，想是已经达到剑法中人剑合一，无剑无我的境界！\n" NOR, me, weapon);
    me->add_temp("apply/sword", sk1 / 3);
    me->add_temp("apply/attack", sk1 / 3);
    me->set_temp("swordgod", 1);
    me->start_call_out(
      (: call_other, __FILE__, "remove_effect", me, sk1 / 3, sk1 / 3, 0 :),
      sk1 / 2
    );
    me->start_busy(2);
    return 1;
  }
}

void remove_effect(object me, int amount1, int amount2, int amount3) {
  if (!me) return;
  me->add_temp("apply/sword", -amount1);
  me->add_temp("apply/attack", -amount2);
  me->add_temp("apply/dodge", amount3);
  me->delete_temp("swordgod");
  tell_object(me, "你的「剑神决」已运功完毕。\n");
}
