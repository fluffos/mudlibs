//草上飞  written by john darks , modified by Baiwt@sjpl
#include <ansi.h>
inherit SSERVER;
int check_flee(object me);

int perform(object me, object target) {
  return notify_fail("你的轻功里没有这项功能！\n");
  if (me->query_skill("dodge") < 150)
    return notify_fail("你的轻功不够！\n");
  if (me->query_skill_mapped("dodge") != "jl-shibagua")
    return notify_fail("你的轻功里没有这项功能！\n");
  if ((int)me->query("force") - (int)me->query("max_force") < 150)
    return notify_fail("你的真气不够。\n");
  if (target)
    return notify_fail("你只能自己施展草上飞轻功！\n");
  write("你要移动到哪一个人身边？\n");
  input_to((: call_other, __FILE__, "select_target", me :));
  return 1;
}

void select_target(object me, string name) {
  object ob;
  if (!name || name == "") {
    write("你改变主意不施展轻功了。\n");
    return;
  }
  ob = find_player(name);
  if (!ob || !me->visible(ob))
    ob = find_living(name);
  if (!ob || !me->visible(ob) || !environment(ob)
    || random(ob->query("force")) > me->query("force")) {
    write("你无法感受到这个人的内息 ....\n");
    return;
  }
  if (!environment(ob)->query("outdoors"))
    return notify_fail("你无法感受到这个人的内息 ....\n");

  if (me->is_fighting()) {
    if (!check_flee(me)) return;
  } else if ((int)me->query("force") - (int)me->query("max_force") < 150) {
    write("你的真气不够。\n");
    return;
  }
  me->add("force", -150);
  message_vision(HIY "$N深吸口气，突然施展草上飞的绝世轻功 ....\n" NOR, me);
  message(
    "vision",
    HIY "\n只见" + me->name() + "一掠而起，转眼间消失得无影无踪！\n\n" NOR,
    environment(me),
    ({ me })
  );
  me->move(environment(ob));
  message("vision", HIY "\n你的前方远处突然出现个人影，只转眼间那人影已到了眼前！\n\n" NOR, environment(ob), ({ me }));
}

int check_flee(object me) {
  object *enemy;
  int fp, bp, i;
  enemy = me->query_enemy();
  for (i = 0; i < sizeof(enemy); i++) {
    if (objectp(enemy[i]) && environment(enemy[i]) == environment(me) && living(enemy[i])) {
      fp = COMBAT_D->skill_power(me, "move", 3);
      if (fp < 1) fp = 1;
      bp = COMBAT_D->skill_power(enemy[i], "move", 3);
      if (bp < 1) bp = 1;
      if (random(fp * 2 + bp) > fp * 2) {
        message_vision(HIY "$N深吸口气，欲施展轻功逃走！\n" NOR, me);
        message_vision(RED "但$N身影一闪，早已挡在了$n的面前！\n" NOR, enemy[i], me);
        return 0;
      }
    }
  }
  return 1;
}
