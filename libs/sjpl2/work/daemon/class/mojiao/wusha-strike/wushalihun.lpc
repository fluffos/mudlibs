//五煞离魂
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int damage;
  object weapon;
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［五煞离魂］只能对战斗中的对手使用。\n");
  weapon = me->query_temp("weapon");
  damage = me->query_skill("wusha-strike", 1);
  if (damage < 70) return notify_fail("你的五煞神掌还不够熟练！\n");
  if ((int)me->query("force") < 300)
    return notify_fail("你的内力不够！\n");
  msg = HIR "$N掌影闪处，同时现出了赤、青、紫、黑、白五团煞气！\n" NOR;
  msg += HIR "五团煞气交织融合，化为一团五色斑斓的气球疾向$n撞去！" NOR;
  COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR, msg);

  if ((target->query_skill_mapped("force") == "liheforce") &&
    ((int)target->query_skill("liheforce") > (int)me->query_skill("wusha-strike"))) {
    message_vision(CYN "\n$n全身真气充盈，将那股无形力量化解了开去！\n" NOR, me, target);
    me->start_busy(2);
    return 1;
  }

  if (random(6) == 1) {
    message_vision(HIR "赤色煞气透过$N身体，带出了一条长长的血箭！\n" NOR, target);
    target->receive_damage("kee", damage);
    me->add("force", -300);
    me->start_busy(4);
    return 1;
  }
  if (random(6) == 2) {
    message_vision(HIC "青色煞气透过$N身体，$N忽然感到一阵精力困乏！\n" NOR, target);
    target->receive_damage("gin", damage * 3);
    me->add("force", -300);
    me->start_busy(3);
    return 1;
  }
  if (random(6) == 3) {
    message_vision(HIM "紫色煞气透过$N身体，$N忽然感到一阵头晕目眩！\n" NOR, target);
    target->receive_damage("sen", damage * 3);
    me->add("force", -300);
    me->start_busy(3);
    return 1;
  }
  if (random(6) == 4) {
    message_vision(HIB "黑色煞气透过$N身体，$N忽然感到气海一片空冥！\n" NOR, target);
    target->add("force", -damage * 10);
    if (target->query("force") < 0)
      target->set("force", 0);
    me->start_busy(3);
    return 1;
  }
  if (random(6) == 5) {
    message_vision(HIW "白色煞气透过$N身体，$N忽然感到眼花缭乱，茫然无措！\n" NOR, target);
    if (me->query("combat_exp") * 2 > random((int)target->query("combat_exp")))
      target->start_busy(5);
    else
      target->start_busy(2);
    me->add("force", -50);
    return 1;
  } else {
    message_vision(NOR "煞气透过$N身体，却没有造成任何伤害。\n" NOR, target);
    me->start_busy(5);
  }
  return 1;
}
