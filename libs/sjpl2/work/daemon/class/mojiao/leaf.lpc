// leaf.c

#include <armor.h>
#include <ansi.h>

inherit HEAD;

void create() {
  set_name(RED "红枫叶" NOR, ({ "maple leaf" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一片手掌大小的红枫叶。\n");
    set("unit", "片");
    set("value", 1);
    set("material", "plant");
    set("armor_prop/armor", 0);
    set("armor_prop/personality", 0);
    set("wear_msg", "$N轻轻地把一片$n盖在头上。\n");
    set("unwield_msg", "$N轻轻地把$n从头上摘了下来。\n");
    set("female_only", 1);

  }
  setup();
}
