//written by john darks
#include <ansi.h>
inherit F_CLEAN_UP;
int exert(object me, object target, int amount) {
  int skill, force;
  skill = me->query_skill("thforce", 1);
  force = (int)me->query("wangsha/thforce");
  if (skill < 99 + force) return notify_fail("你的天和内气太差了，不能将内力传给别人！\n");
  if (me->query("class") != "wangsha") {
    tell_object(me, HIR "\n你体内真气振荡，一股气流走入叉道，啊！！....\n\n" NOR);
    me->set_skill("thforce", skill / 2);
    me->unconcious();
  }
  if (!target || target == me) return notify_fail("你要将内力传给谁？\n");
  if (me->is_fighting() || target->is_fighting())
    return notify_fail("战斗中无法使用传内力！\n");
  if ((int)me->query("max_force") < 400)
    return notify_fail("你的内力不够强。\n");
  message_vision(
    HIY "$N" + HIY "坐了下来运起内功，将手掌贴在$n" + HIY "背心，缓缓地将真气输入$n" + HIY "体内....\n\n"
    "过了不久，$n" + HIY "浑身泛起红光，$N" + HIY "却昏倒在地。\n" NOR,
    me, target);
  me->set_skill("thforce", 1);
  if (skill == 99 + force) {
    me->set("wangsha/thforce", ((int)me->query("wangsha/thlvl") + 1) * 100);
  }
  me->add("max_force", -400);
  me->set("force", 0);
  target->add("max_force", 200);
  me->unconcious();
  return 1;
}
