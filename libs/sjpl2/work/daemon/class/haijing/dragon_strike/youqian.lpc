#include <ansi.h>
#include <combat.h>
inherit SSERVER;
void return_busy(object me, object target);
void dest_weapon(object me, object target);

int perform(object me, object target) {
  int force, zhang;
  if ((int)me->query("force") < 500)
    return notify_fail("你的内力太差了！\n");
  force = (int)me->query_skill("dragonforce");
  zhang = (int)me->query_skill("dragon_strike");

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［护身游潜］只能对战斗中的对手使用。\n");

  if (force < 50 || zhang < 50)
    return notify_fail("你的龙舞九天手和潜龙护宝心法太差了，无法施展“护身游潜”！\n");
  if ((int)me->query_temp("whale/youqian"))
    return notify_fail("你正在施展“护身游潜”！\n");
  if (me->query_skill_mapped("force") != "dragonforce")
    return notify_fail("龙舞九天手必须配合潜龙护宝心法使用。\n");
  if (me->query_skill_mapped("dodge") != "dragon-steps")
    return notify_fail("龙舞九天手必须配合游龙身法使用。\n");
  me->start_busy(1);
  me->add("force", -500);
  me->set_temp("whale/youqian", 1);
  message_vision(HIR "$N身形飘忽不定，施展出龙舞九天手的精华招式“护身游潜”！\n\n" NOR, me);
  call_out("return_busy", 1, me, target);
  return 1;
}

void return_busy(object me, object target) {
  string msg;
  object weapon;
  if (!target
    || !target->is_character()
    || !me->is_fighting(target)) {
    if (me->query_temp("whale/youqian"))
      me->delete_temp("whale/youqian");
    message_vision(HIC "$N的［护身游潜］施展完毕，把功力收回丹田！\n" NOR, me);
    return;
  }
  if ((weapon = target->query_temp("weapon"))) {
    call_out("dest_weapon", 2, me, target);
  }
  if (me->is_busy()) {
    msg = HIR "$N稳住身形，暗运“龙门鼓浪”，全身内力好似惊涛拍岸，朝$n汹涌而来！\n" NOR;
    target->add_temp("apply/iron-cloth", -100);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    target->add_temp("apply/iron-cloth", 100);

  }
  call_out("return_busy", 5, me, target);
}


void dest_weapon(object me, object target) {
  string msg;
  object weapon;
  int my_exp, ob_exp, my_skl, ob_skl, tot_att, ob_def;

  if (!target
    || !target->is_character()
    || !me->is_fighting(target)) {
    if (me->query_temp("whale/youqian"))
      me->delete_temp("whale/youqian");
    message_vision(HIC "$N的［怒龙吟］施展完毕，把功力收回丹田！\n" NOR, me);
    return;
  }

  if (!(weapon = target->query_temp("weapon"))) {
    me->start_busy(1);
    return notify_fail("你欲施展“怒龙吟”，但是对手并没有用武器。\n");
  }

  if (me->query_skill("unarmed") < 30
    && me->query_skill("dodge") < 30) {
    printf("%d %d", me->query_skill("dragon_strike"),
      me->query_skill("dragon-steps"));
    return notify_fail("你的武功不足以使用怒龙吟!\n");
  }

  msg = RED "$N忽然长声暴喝, 不知怎么就欺入$n兵器的圈子里, 张口吐出一股凌厉的真气，向" + weapon->query("name") + "射去！\n";
  my_exp = (int)me->query("combat_exp");
  ob_exp = (int)target->query("combat_exp");
  my_skl = me->query_skill("unarmed", 0) + me->query_temp("apply/attack");
  ob_skl = target->query_skill(
    weapon->query("skill_type"),
    0
  ) + target->query_temp("apply/defense");
  ob_def = ob_skl * ob_skl * ob_skl / 3 + ob_exp;
  tot_att = my_skl * my_skl * my_skl / 3 + my_exp + ob_def;
  if (random(tot_att) > ob_def * 10 / 7
    || (target->is_busy() && random(tot_att) > ob_def)) {
    msg += "结果$n手腕巨震, " + weapon->query("name") + "竟在$N的真气压迫之下“噼啪噼啪”地震为了碎片！\n" NOR;
    "/cmds/std/unwield"->main(target, weapon);
    //	    target->delete_temp("weapon");
    destruct(weapon);
    target->start_busy(2);
  } else {
    msg += "但是$n处变不惊, 避过这招, $N顿时露出破绽\n" NOR;
    me->start_busy(3);
  }
  message_vision(msg, me, target);
  return;
}
