//五气重阳
#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  string msg;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("「五气重阳」只能对战斗中的对手使用。\n");

  if ((int)me->query_skill("sunclaw") < 70)
    return notify_fail("你的太阳神抓不够高！\n");
  if ((int)me->query_skill("hotforce") < 50)
    return notify_fail("你的赤阳煞气不够高！\n");

  if ((int)me->query("force") < 1000)
    return notify_fail("你的内力不够！\n");
  if ((target->query_skill_mapped("force") == "xuanyinforce") &&
    ((int)target->query_skill("xuanyinforce") > (int)me->query_skill("hotforce")))
    return notify_fail("你施展出[五气重阳]，但是你发出的热气被对方的寒气化解了。\n");

  if ((target->query_skill_mapped("force") == "beauty-force") &&
    ((int)target->query_skill("beauty-force") > (int)me->query_skill("hotforce")))
    return notify_fail("你施展出[五气重阳]，但是你发出的热气被对方的寒气化解了。\n");

  if ((target->query_skill_mapped("force") == "xuanyue-force") &&
    ((int)target->query_skill("xuanyue-force") > (int)me->query_skill("hotforce")))
    return notify_fail("你施展出[五气重阳]，但是你发出的热气被对方的寒气化解了。\n");

  message_vision(HIR "$N忽然感到热气扑面，浑身犹如烈火般燃烧起来。\n\n" NOR, target);
  if (!target->query_condition("hotsick"))
    target->apply_condition("hotsick", random(5) + 5);

  msg = HIR "$N掌心通红，使出太阳神抓的绝命招式「五气重阳」，";

  if (random(me->query("combat_exp")) > (int)target->query("combat_exp") / 3) {
    msg += "结果$p被$P击个正着。\n\n$p只觉得眼前一黑，“哇”的一声喷出一口鲜血！\n" NOR;
    target->receive_wound("kee", (int)me->query("max_kee"));
    me->set("force", 0);
  } else {
    msg += "可是$p还是躲过了$P的绝命一击！！\n" NOR;
  }
  message_vision(msg, me, target);
  if ((int)me->query("force") > 1000)
    me->add("force", -1000);
  if (userp(target))
    me->add("kill_player_record", random(10));
  me->start_busy(3);
  return 1;
}
