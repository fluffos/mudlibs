//星罗棋布
#include <ansi.h>

inherit SSERVER;
void surekill(object me, object target);
int perform(object me, object target) {
  string msg;

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("[星罗棋布]只能对战斗中的对手使用。\n");
  if ((int)me->query_skill("qidaoxinfa", 1) < 10)
    return notify_fail("你的棋道心法不够高！\n");

  if ((int)me->query_skill("fantianqi", 1) <= 250)
    return notify_fail("你的星河棋道还不够精纯，不能发出星罗棋布。\n");

  if ((int)me->query("bellicosity") > 1)
    return notify_fail("你心不正，无法融会星河棋道的最高境界。\n");
  if ((int)me->query("force") < 300)
    return notify_fail("你的内力不够，没有办法发出星罗棋布。\n");
  if ((int)target->query("bellicosity") < 1)
    return notify_fail("你发出星罗棋布，但奇怪的是飞出的暗器莫名其妙拐了个弯，钻入了地下。\n");

  message_vision(RED "$N目不转睛地盯着$n，准备发出致命一击。\n" NOR, me, target);
  msg = HIY "$N使出星河棋道中的" + HIR "星罗棋布" + HIY "，$n只觉得眼前星星点点全是棋子，让人无法躲藏！";
  msg += "\n转眼间一股股血箭从$n的身体喷涌而出．．$n惨叫一声倒在了血泊中．．\n" NOR;

  message_vision(msg, me, target);
  target->die();
  me->set_skill("fantianqi", 240);
  me->add("max_force", -50);
  me->set("force", 0);
  me->add("bellicosity", 500);
  return 1;
}
