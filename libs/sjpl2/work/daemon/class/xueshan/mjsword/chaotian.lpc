//朝天阙
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int extra;
  object weapon;
  if (!target) target = offensive_target(me);
  if ((int)me->query_skill("mjsword") < 60)
    return notify_fail("你的满江红剑法不够高！\n");
  if ((int)me->query_skill("force") < 50)
    return notify_fail("你的内功不够高！\n");

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［朝天阙］只能对战斗中的对手使用。\n");
  weapon = me->query_temp("weapon");
  extra = me->query_skill("mjsword", 1) / 5;
  me->add_temp("apply/attack", extra);
  me->add_temp("apply/damage", extra);
  msg = HIR "$N错步上前，手中的" + weapon->name() + "一式［朝天阙］，剑芒由下而上尖啸着向$n挥去！" NOR;
  if (target->query_skill(
    "iron-cloth",
    1
  ) && target->query_skill("iron-cloth") < random(me->query_skill("sword") * 2)) {
    message_vision(msg, me, target);
    message_vision(HIR "\n结果$N强大的剑气摧破了$n的真元！\n" NOR, me, target);
    target->receive_wound("kee", (int)me->query_skill("mjsword", 1) * 3);
    COMBAT_D->report_status(target, 1);
    me->add_temp("apply/attack", -extra);
    me->add_temp("apply/damage", -extra);
    me->start_busy(2);
    return 1;
  }
  COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR, msg);
  me->add_temp("apply/attack", -extra);
  me->add_temp("apply/damage", -extra);
  me->start_busy(2);
  return 1;
}
