//山崩地裂
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int extra;
  object weapon;
  extra = me->query_skill("hanshan", 1);
  weapon = me->query_temp("weapon");

  if (extra <= 150) return notify_fail("你的［撼山八法］还不够纯熟！\n");
  if ((int)me->query_skill("yuanyouforce") < 50)
    return notify_fail("你的猿犹神功不够高！\n");

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("「山崩地裂」只能对战斗中的对手使用。\n");

  if ((int)me->query("force") < 300)
    return notify_fail("你的内力不够，没有办法施展「山崩地裂」。\n");

  msg = HIR "$N大喝一声，顿时神威凛凛，鼓足全力使出撼山八法的最后一式「山崩地裂」!
\n只见$N手中的" + weapon->name() + "轰轰作响，以毁天灭地之势朝$n挥了过去！" NOR;

  if (target->query_skill(
    "iron-cloth",
    1
  ) && target->query_skill("iron-cloth") < random(me->query_skill("hammer") * 2)) {
    extra = random(me->query_skill("hammer") * 2) + 1;
    message_vision(msg, me, target);
    target->receive_wound("kee", extra);
    COMBAT_D->report_status(target, 1);
    msg = HIC "\n$n在$N的大力压迫下只感到胸口郁闷之极，内功都无从运用！\n\n" NOR;
    message_vision(msg, me, target);
    target->map_skill("force");
    target->reset_action();
    if (!target->query_delay())
      target->set_delay(10);
    me->add("force", -300);
    me->start_busy(3);
    return 1;
  }

  me->add_temp("apply/attack", extra / 2);
  me->add_temp("apply/damage", extra / 2);
  COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR, msg);
  me->add_temp("apply/attack", -extra / 2);
  me->add_temp("apply/damage", -extra / 2);

  msg = HIC "\n$n在$N的大力压迫下只感到胸口郁闷之极，内功都无从运用！\n\n" NOR;
  message_vision(msg, me, target);
  target->map_skill("force");
  target->reset_action();
  if (!target->query_delay())
    target->set_delay(10);
  me->add("force", -300);
  me->start_busy(3);
  return 1;
}
