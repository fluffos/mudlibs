//化功术
#include <ansi.h>
inherit SSERVER;
int cast(object me, object target) {
  int skill, damage;
  string msg;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("化功术只能对战斗中的对手使用。\n");
  if ((int)me->query_skill("zuodaoshu", 1) <= 90)
    return notify_fail("你的旁门左道术还不够精纯。\n");
  if ((int)me->query("mana") < 50)
    return notify_fail("你的法力不够！\n");
  if (!me->is_fighting())
    return notify_fail("你只能在战斗中作法！\n");

  if ((int)me->query("sen") < 30)
    return notify_fail("你的精神没有办法有效集中！\n");
  if ((int)target->query("force") <= 0)
    return notify_fail("这个人没有内力。\n");

  skill = me->query_skill("zuodaoshu") * 5;
  me->add("mana", -50);
  me->receive_damage("sen", 30);
  message_vision(HIB "$N目不转睛地盯着$n，口中喃喃地念了几句咒语。\n" NOR, me, target);
  if ((int)me->query_skill("spell") > (int)target->query_skill("force")) {
    msg = MAG "$N猛地吐了口长气，双臂左右一圈，$n只觉得面前突然起了一阵旋涡，强烈的气流造成一股吸力！";
    msg += "\n$n立刻感到全身的内力喷涌而出，无声无息地卷入那一阵旋涡之中。\n" NOR;
    message_vision(msg, me, target);
    target->add("force", -skill);
    if ((int)target->query("force") <= 0) target->set("force", 0);
  } else {
    msg = MAG "$N猛地吐了口长气，双臂左右一圈，$n只觉得面前突然起了一阵旋涡，强烈的气流造成一股吸力！";
    msg += "\n$n立即鼓起内力向外一震，结果将那一阵旋涡消解于无形之中。\n" NOR;
    message_vision(msg, me, target);
  }
  if (random((int)me->query("magic_attack")) > (int)target->query("magic_defense")) {
    damage = ((int)me->query("magic_attack") - (int)target->query("magic_defense")) / 10;
    if (damage > 180) damage = 180;
    if (!target->query_delay())
      target->set_delay(random(damage));
  }
  me->start_busy(5);
  return 1;
}
