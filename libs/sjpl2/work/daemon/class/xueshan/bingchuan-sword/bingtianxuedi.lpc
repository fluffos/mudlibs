//冰天雪地
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string dodskill, msg;
  int extra;
  object weapon;
  extra = me->query_skill("bingchuan-sword", 1);
  if (extra < 160) return notify_fail("你的［冰天雪地］还不够纯熟！\n");
  if (me->query("force") < 300) return notify_fail("你的内力不够！\n");
  dodskill = (string)me->query_skill_mapped("dodge");
  if (dodskill != "fengxue-steps")
    return notify_fail("［冰天雪地］需要风灵雪舞身法的配和！\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［冰天雪地］只能对战斗中的对手使用。\n");
  weapon = me->query_temp("weapon");
  //	if( target->query_skill("iron-cloth")>100 )
  target->add_temp("apply/iron-cloth", -extra / 2);
  msg = HIY "$N神气贯通，施展出冰川剑法的绝招[冰天雪地]连环剑！\n\n积水凝冰！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);

  msg = HIY "雪花六出！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);

  msg = HIY "雪拥蓝关！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);

  msg = HIY "怒卷霜雪！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);

  msg = HIY "寒潮匝地！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);

  msg = HIY "倒卷冰河！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);

  msg = HIY "冰河解冻！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);

  msg = HIY "飞瀑流泉！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  //	if( target->query_skill("iron-cloth")>100 )
  target->add_temp("apply/iron-cloth", extra / 2);
  me->add("force", -200);
  me->start_busy(6);
  return 1;
}
