//百兽狂奔
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
void brave_up(object me, object target);
void stop_atk(object me);
int perform(object me, object target) {
  int skill;
  if ((int)me->query_temp("baishou"))
    return notify_fail("你已经在施展［百兽狂奔］了。\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［百兽狂奔］只能对战斗中的对手使用。\n");
  skill = me->query_skill("shouquan", 1);
  if (skill <= 90) return notify_fail("你的九兽神拳还不够纯熟！\n");
  if ((int)me->query_skill("yuanyouforce") < 30)
    return notify_fail("你的猿犹神功不够高！\n");

  if ((int)me->query("force") < 300)
    return notify_fail("你的内力不够。\n");
  if (skill <= (int)target->query_skill("training", 1))
    return notify_fail("你使出［百兽狂奔］，但是周围毫无反应。\n");
  message_vision(RED "$N使出［百兽狂奔］，刹那间地动山摇，一拳化作狮虎狼豹熊各种野兽同时扑向$n！\n" NOR, me, target);
  if ((int)target->query_skill("training") > (int)me->query_skill("shouquan")) {
    message_vision(CYN "\n但是$n发出呵呵怪声，转眼化解了$N的攻势！\n" NOR, me, target);
    return 1;
  }
  me->set_temp("baishou", 1);
  me->add("force", -120);
  me->start_busy(2);
  call_out("brave_up", 2, me, target);
  call_out("brave_up", 10, me, target);
  call_out("brave_up", 20, me, target);
  call_out("stop_atk", 25, me);
  return 1;
}

void brave_up(object me, object target) {
  string msg;
  if (!target || !me
    || !target->is_character()
    || !me->is_fighting(target))
    return;

  msg = HIR "\n$N眼前一花，只见一头恶狼瞪着发绿的眼珠朝自己胸前直撞过来！\n\n" NOR;
  message_vision(msg, target);
  COMBAT_D->report_status(target, 1);
  target->receive_wound("kee", random(10));

  msg = HIR "\n忽然一头猎豹箭一般蹿上来对$N又嘶又咬！$N不禁手忙脚乱. . .\n\n" NOR;
  message_vision(msg, target);
  COMBAT_D->report_status(target, 1);
  target->receive_wound("kee", 10 + random(10));

  msg = HIR "\n$N愕然回头，只见一头黑熊张开蒲扇般巨掌对自己脸上狠狠掴了一下！\n\n" NOR;
  message_vision(msg, target);
  COMBAT_D->report_status(target, 1);
  target->receive_wound("kee", 10 + random(20));

  msg = HIR "\n只见一头狮子张开血盆大口猛地向$N的大腿咬来！$N拼命闪避. . .\n\n" NOR;
  message_vision(msg, target);
  COMBAT_D->report_status(target, 1);
  target->receive_wound("kee", 10 + random(30));

  msg = HIR "\n忽然一头猛虎凶残地扑上来，双爪搭上$N肩头，尖利的牙齿向$N的咽喉狠狠地咬了下去！\n\n" NOR;
  message_vision(msg, target);
  COMBAT_D->report_status(target, 1);
  target->receive_wound("kee", 10 + random(40));
  target->start_busy(3);
}
void stop_atk(object me) {
  if (!me) return;
  me->delete_temp("baishou");
  tell_object(me, CYN "你的［百兽狂奔］施展完毕，各种野兽的身形都在一瞬间消失了。\n" NOR);
}
