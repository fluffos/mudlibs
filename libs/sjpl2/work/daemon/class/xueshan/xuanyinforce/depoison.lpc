//玄冰诀
#include <ansi.h>
inherit SSERVER;

int exert(object me, object target, int amount) {
  int force, lvl;
  if ((string)me->query("class") != "snowman")
    return notify_fail("你不是琼宫弟子，无法使用解毒功能！\n");
  if (target != me) return notify_fail("你只能用真气将自己体内毒素逼出。\n");
  force = (int)me->query("force") - (int)me->query("max_force");
  if (force <= 300) return notify_fail("你的真气不足。\n");
  if (me->query("kill_player_record"))
    return notify_fail(HIR "你内有心魔，无法化解身上的奇毒！\n" NOR);
  lvl = me->query_skill("xuanyinforce", 1);
  if (random(lvl) < 50) {
    me->add("force", -300);
    me->start_busy(1);
    message_vision(HIW "$N运功抗毒，头上冒出豆大的汗珠．．．\n" NOR, me);
    return notify_fail("你失败了。\n");
  } else {
    me->clear_condition();
    me->start_busy(1);
    message_vision(HIW "$N运功抗毒，头上冒出豆大的汗珠．．．\n" NOR, me);
    write("你成功了！\n");
    return 1;
  }
}
