//隔空点穴
#include <ansi.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int tm;
  if (!target)
    return notify_fail("你想点谁的穴道？\n");

  if (environment(me)->query("no_fight"))
    return notify_fail("这里禁止战斗。\n");

  if (target == me)

    return notify_fail("你不能点自己的穴道。\n");

  if (me->query_temp("sleeping")) return notify_fail("你正在睡眠中。\n");

  if (!target->is_character() || target->is_corpse())
    return notify_fail("看清楚一点，那并不是活物。\n");
  if (!target) target = offensive_target(me);

  if ((int)me->query("force") < 200)
    return notify_fail("你的内力不够，没有办法隔空点穴。\n");
  if ((int)me->query_skill("wuxing-zhi", 1) <= 150)
    return notify_fail("你的无形指还不够精纯，不能隔空点穴。\n");
  if ((int)me->query_skill("liuhe-force") < 50)
    return notify_fail("你的六合真气不够高！\n");
  if ((int)me->query("force") < (int)target->query("force") / 3)
    return notify_fail("你施展出[隔空点穴]，但是你发出的劲力全被弹开了。\n");
  if (target->is_busy())
    return notify_fail(target->name() + "已经无法动弹了！\n");
  if (target->query_wait())
    return notify_fail(target->name() + "还没有完全恢复行动！\n");

  tm = (int)me->query_skill("wuxing-zhi", 1) / 10;
  message_vision(HIC "$N施展出神技[隔空点穴]，对着$n遥遥点出一指。\n" NOR, me, target);

  if ((int)target->query_skill("yoga") > (int)me->query_skill("wuxing-zhi")) {
    message_vision(CYN "\n但是$n全身经脉穴道逆转，根本不为所动！\n" NOR, me, target);
    return 1;
  }
  if ((int)target->query_skill("liumai_force") > (int)me->query_skill("wuxing-zhi")) {
    message_vision(CYN "\n但是$n内力流转，很快冲开了被封的穴道！\n" NOR, me, target);
    return 1;
  }
  if ((int)target->query_skill("jzxj-force") > (int)me->query_skill("wuxing-zhi")) {
    message_vision(CYN "\n但是$n运起穴位转移大法，根本不为所动！\n" NOR, me, target);
    return 1;
  }
  if ((int)target->query_skill("liuhe-force") > (int)me->query_skill("wuxing-zhi")) {
    message_vision(CYN "\n但是$n真气鼓动，眨眼冲开了被封的穴道！\n" NOR, me, target);
    return 1;
  }

  if ((target->query_skill_mapped("unarmed") == "leaf-strike") || (target->query_skill_mapped("force") == "hansha-force")) {
    message_vision(HIR "\n结果$N强大的内劲催破了$n的真元！\n" NOR, me, target);
    target->receive_wound("kee", tm * 10);
    COMBAT_D->report_status(target, 1);
    return 1;
  }

  msg = YEL "$N指尖一股无形指力破空而出，接连点中了$n的三处大穴！";
  msg += "\n$n只觉浑身一麻，登时动弹不得。\n" NOR;
  message_vision(msg, me, target);
  target->start_busy(tm);
  target->set_wait(tm * 2);
  me->add("force", -200);
  return 1;
}
