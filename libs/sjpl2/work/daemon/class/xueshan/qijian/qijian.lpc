//无形气剑
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int extra;
  object weapon;
  if (me->is_busy())
    return notify_fail("你现在没空！！\n");
  extra = me->query_skill("wuxing-zhi", 1);
  if (extra < 150) return notify_fail("你的无形指还不够纯熟！\n");
  if ((int)me->query_skill("liuhe-force") < 50)
    return notify_fail("你的六合真气不够高！\n");
  if ((int)me->query("force") < 500)
    return notify_fail("你的内力不够！\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［无形气剑］只能对战斗中的对手使用。\n");
  me->add_temp("apply/attack", extra / 10);
  //	if( target->query_skill("iron-cloth")>100 )
  target->add_temp("apply/iron-cloth", -extra);
  weapon = me->query_temp("weapon");
  msg = HIY "$N使出旷世绝学［无形气剑］，撒出漫天剑气向$n攻出！\n" NOR;
  message_vision(msg, me, target);
  msg = HIY "上一路剑气射出！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIY "下一路剑气射出！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIY "左一路剑气射出！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIY "右一路剑气射出！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIY "前一路剑气射出！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIY "后一路剑气射出！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIY "中间一路剑气射出！！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  me->start_busy(7);
  me->add("force", -300);
  me->add_temp("apply/attack", -extra / 10);
  //	if( target->query_skill("iron-cloth")>100 )
  target->add_temp("apply/iron-cloth", extra);
  return 1;
}
