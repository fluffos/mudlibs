//赤阳煞气
#include <ansi.h>
inherit SSERVER;
int exert(object me, object target) {
  string msg;
  int damage, ap, dp;
  int extradam;

  if (!target) target = offensive_target(me);

  if ((int)me->query_skill("hotforce") < 70)
    return notify_fail("你的赤伽阳煞功不够高！\n");
  if (environment(me)->query("no_fight"))
    return notify_fail("这里禁止战斗。\n");

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展［赤阳煞气］？\n");

  if ((int)me->query("kee") < 25)
    return notify_fail("你的气血不够！\n");

  me->receive_wound("kee", 25);
  msg = HIC "$N的掌心红光一闪，一团赤色的火焰闪电般地射向$n！\n\n" NOR;

  if ((target->query_skill_mapped("force") == "xuanyinforce") &&
    ((int)target->query_skill("xuanyinforce") > (int)me->query_skill("hotforce")))
    return notify_fail("你施展出[赤阳煞气]，但是你发出的热气被对方的寒气化解了。\n");

  if ((target->query_skill_mapped("force") == "beauty-force") &&
    ((int)target->query_skill("beauty-force") > (int)me->query_skill("hotforce")))
    return notify_fail("你施展出[赤阳煞气]，但是你发出的热气被对方的寒气化解了。\n");

  if ((target->query_skill_mapped("force") == "xuanyue-force") &&
    ((int)target->query_skill("xuanyue-force") > (int)me->query_skill("hotforce")))
    return notify_fail("你施展出[赤阳煞气]，但是你发出的热气被对方的寒气化解了。\n");

  if (target->query("mguard_level") > 50)
    return notify_fail("你施展出[赤阳煞气]，但是对方一口气便吹散了你的热气。\n");

  ap = me->query_skill("force");
  extradam = ap / 2;
  ap = (ap * ap / 100 * ap / 4) * (int)me->query("sen");
  dp = target->query("combat_exp");
  if (random(ap + dp) > dp) {
    damage = me->query("bellicosity") / 20;
    if (damage > 1000) damage = 1000;
    msg += HIR "火焰无声无息地撞上$p的身体．．．\n" NOR;
    message_vision(msg, me, target);
    target->receive_damage("kee", damage, me);
    target->receive_wound("kee", damage / 3, me);
    if (damage > 0) COMBAT_D->report_status(target);
    if (userp(target))
      me->add("kill_player_record", random(100));
  } else {
    msg += "但是被$n发现了！！\n";
    message_vision(msg, me, target);
    target->kill_ob(me);
    me->kill_ob(target);
  }
  me->start_busy(2);
  log_file(
    "EXERT_LOG",
    sprintf("(%s) %s exert bloodsun to %s\n", ctime(time()), me->query("id"), target->query("id"))
  );
  return 1;
}
