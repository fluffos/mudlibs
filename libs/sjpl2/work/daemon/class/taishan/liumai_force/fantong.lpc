//返老还童

#include <ansi.h>

inherit F_CLEAN_UP;

int exert(object me, object target, int amount) {
  mapping my;
  int skill;
  string msg2;
  if (target != me) return notify_fail("你只能使自己返老还童。\n");

  if ((int)me->query("max_force") < 1000) return notify_fail("你的内力不够。\n");
  if (me->query_skill("liumai_force", 1) < 100)
    return notify_fail("你的六脉神功太差了。\n");
  if (me->query("sen") < 100)
    return notify_fail("你的心神不够。\n");
  if (me->query("force") < 1000)
    return notify_fail("你的内力不够。\n");
  my = me->query_entire_dbase();
  if ((int)me->query("int") <= 10)
    return notify_fail("你的才智不足。\n");
  if ((int)me->query("spi") <= 10)
    return notify_fail("你的灵性不足。\n");
  if ((int)me->query("cps") <= 10)
    return notify_fail("你的定力不足。\n");
  if ((int)me->query("fle") <= 10)
    return notify_fail("你的韧性不足。\n");
  if ((int)me->query("kar") <= 10)
    return notify_fail("你的运气不足。\n");
  if ((int)me->query("tol") <= 10)
    return notify_fail("你的气量不足。\n");

  if ((int)me->query("age") < 40)
    return notify_fail("按你目前的岁数，还不需要返老还童。\n");

  if (me->query_skill("liumai_force", 1) <= 10) amount = 1;
  if (me->query_skill("liumai_force", 1) > 10)
    skill = me->query_skill("liumai_force", 1);
  amount = me->query_skill("liumai_force", 1) / 10;
  me->add("daode_point", amount);
  amount = me->query("daode_point");
  if (amount - my["MKS"] > 0) amount = my["MKS"] + 1;
  me->set("daode_point", amount);
  me->start_busy(1);
  me->add("force", -1000);
  me->receive_damage("sen", 100);
  msg2 = "\n又过了一会儿，$N脸上皱纹开始褪去，$N回复童颜了！\n";
  message_vision(WHT "$N凝神静坐，头顶冒出丝丝白雾......\n\n" NOR, me);
  if (me->query("gender") == "男性")
    message_vision(WHT "过了良久，$N只感到颌下一阵刺痛，胡子居然缩短了几分！\n" + msg2 + NOR, me);
  else if (me->query("gender") == "女性")
    message_vision(WHT "过了良久，$N只感到鬓角一阵发麻，白发居然少了几根！\n" + msg2 + NOR, me);
  else {
    message_vision(WHT "过了良久，$N的身体居然没有任何变化！\n" NOR, me);
    return 1;
  }
  me->add("int", -1);
  me->add("spi", -1);
  me->add("cps", -1);
  me->add("fle", -1);
  me->add("kar", -1);
  me->add("tol", -1);
  me->add("max_force", -100);
  me->add("age_modify", -(random(4) + 1));
  me->update_age();
  me->set("mojiao/xtkid", 2);

  return 1;
}
