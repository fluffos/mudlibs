#include <ansi.h>
#include <combat.h>
inherit F_CLEAN_UP;
void remove_effect(object me, int amount);
int perform(object me, object target) {
  int skill;
  if (target != me) return notify_fail("你只能将［行尸走肉］用在自己的身上。\n");
  if ((int)me->query("force") < 100) return notify_fail("你的内力不够。\n");
  if ((int)me->query_temp("kugu/xingshi")) return notify_fail("你已经在施展［行尸走肉］了。\n");
  skill = me->query_skill_eff_lvl("jiangshi-steps");
  if (skill < 100) return notify_fail("你的僵尸步法太差了！\n");
  me->add("force", -100);
  me->add("bellicosity", skill + 10);
  message_vision(HIR "$N僵直着身子一跳，使出僵尸步法中的［行尸走肉］，身影好似冤魂，在风中飘荡！\n" NOR, me);
  me->add_temp("apply/dodge", skill / 5);
  me->set_temp("kugu/xingshi", 1);
  me->start_call_out((: call_other, __FILE__, "remove_effect", me,
    skill / 5 :), skill / 5);
  if (me->is_fighting()) me->start_busy(3);
  return 1;
}

void remove_effect(object me, int amount) {
  if (!me) return;
  me->add_temp("apply/dodge", -amount);
  me->delete_temp("kugu/xingshi");
  tell_object(me, "你的［行尸走肉］施展完毕，身行稳定了下来。\n");
}
