//八臂招实

#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target) {
  string msg;
  int i, extra;
  object weapon, ride;
  object env;
  object *inv;

  if (me->is_busy())
    return notify_fail("你现在没空！！\n");
  extra = me->query_skill("nezha_dagger", 1);
  if (extra < 70) return notify_fail("你的八臂哪吒戟法还不够纯熟！\n");


  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))  //		return notify_fail("八臂招实只能对战斗中的对手使用。\n");
  {
    message_vision(CYN "\n$N将八臂哪吒戟法的绝技［八臂招实］施展了一遍！\n" NOR, me);
    if (me->query("force_factor") >= 60 && (int)me->query("daode") >= 0) {
      message_vision(CYN "\n无数道戟影从$N身周向四面八方回旋飞舞，带起一片尘埃！\n" NOR, me);
      seteuid(geteuid(me));
      env = environment(me);
      inv = all_inventory(env);
      for (i = 0; i < sizeof(inv); i++) {
        if (inv[i] == me) continue;
        if (!inv[i]->is_character() || inv[i]->is_corpse()) continue;
        if (inv[i]->query_temp("armor/mask") && present("skinmask", inv[i])) {
          weapon = present("skinmask", inv[i]);
          message_vision(HIC "\n$N戟影所到之处，刷地将$n脸上的面具揭了下来！\n\n" NOR, me, inv[i]);
          "/cmds/std/remove"->do_remove(inv[i], weapon);
          inv[i]->set_delay(1);
        }
      }
    }
    return 1;
  }

  weapon = me->query_temp("weapon");
  ride = me->query_temp("ridee");
  if (ride) msg = ride->query("id"); else msg = "\n";
  if (msg != "\n" && (ride->query_temp("rider") == me) && present(msg, environment(me))) {
    me->add_temp("apply/damage", extra / 2);
    me->add_temp("apply/dodge", extra / 2);
    me->add_temp("apply/dagger", extra / 2);
  }
  target->add_temp("apply/iron-cloth", -extra / 2);

  msg = RED "$N手中" + weapon->name() + "突然晃出八条影子，凌空一绞，同时向$n激射而去！";
  msg += "\n第一道戟影！\n第二道戟影！\n第三道戟影！\n第四道戟影！\n第五道戟影！
\n第六道戟影！\n第七道戟影！\n第八道戟影！\n" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  if (ride) msg = ride->query("id"); else msg = "\n";
  if (msg != "\n" && (ride->query_temp("rider") == me) && present(msg, environment(me))) {
    me->add_temp("apply/damage", -extra / 2);
    me->add_temp("apply/dodge", -extra / 2);
    me->add_temp("apply/dagger", -extra / 2);
  }
  target->add_temp("apply/iron-cloth", extra / 2);
  if (weapon->unequip()) weapon->move(environment(me));
  me->start_busy(2);
  return 1;
}
