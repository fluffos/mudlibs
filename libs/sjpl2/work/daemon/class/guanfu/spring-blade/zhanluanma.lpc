// 快刀斩乱麻
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int extra, i, lmt;
  object weapon;
  extra = me->query_skill("spring-blade", 1);
  if (extra < 70) return notify_fail("你的春风快意刀法还不够纯熟！\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［快刀斩乱麻］只能对战斗中的对手使用。\n");
  weapon = me->query_temp("weapon");
  msg = HIR "\n$N使出“快刀斩乱麻”绝技，手中的" + weapon->name() + "狂风暴雨般地向$n卷来！" NOR;
  message_vision(msg, me, target);
  if (userp(me)) {
    me->add_temp("apply/attack", -extra / 2);
    me->add_temp("apply/damage", -extra / 2);
  } else {
    target->add_temp("apply/iron-cloth", -extra);
    me->add_temp("apply/attack", extra / 10);
    me->add_temp("apply/damage", extra / 10);
  }

  lmt = random(5) + 3;
  for (i = 1; i <= lmt; i++) {
    msg = HIR "第" + chinese_number(i) + "刀！" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  }

  if (userp(me)) {
    me->add_temp("apply/attack", extra / 2);
    me->add_temp("apply/damage", extra / 2);
    me->start_busy(5);
  } else {
    target->add_temp("apply/iron-cloth", extra);
    me->add_temp("apply/attack", -extra / 10);
    me->add_temp("apply/damage", -extra / 10);
    me->start_busy(3);
  }
  return 1;
}
