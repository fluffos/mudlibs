//夜战八方

#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int i, extra;
  object weapon;
  object env;
  object *inv;
  if (me->is_busy())
    return notify_fail("你现在没空！！\n");

  extra = me->query_skill("duanmen_blade", 1) / 10;
  if (extra * 10 < 70) return notify_fail("你的五虎断门刀法还不够纯熟！\n");

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))  //		return notify_fail("［夜战八方］只能对战斗中的对手使用。\n");
  {
    message_vision(CYN "\n$N将五虎断门刀法的绝技［夜战八方］施展了一遍！\n" NOR, me);
    if (me->query("force_factor") >= 60 && (int)me->query("daode") >= 0) {
      message_vision(CYN "\n雄浑的刀风从$N身周向四面八方扩散开来，带起一片尘埃！\n" NOR, me);
      seteuid(geteuid(me));
      env = environment(me);
      inv = all_inventory(env);
      for (i = 0; i < sizeof(inv); i++) {
        if (inv[i] == me) continue;
        if (!inv[i]->is_character() || inv[i]->is_corpse()) continue;
        if (inv[i]->query_temp("armor/mask") && present("skinmask", inv[i])) {
          weapon = present("skinmask", inv[i]);
          message_vision(HIC "\n$N刀风所到之处，刷地将$n脸上的面具揭了下来！\n\n" NOR, me, inv[i]);
          "/cmds/std/remove"->do_remove(inv[i], weapon);
          inv[i]->set_delay(1);
        }
      }
    }
    return 1;
  } else
    weapon = me->query_temp("weapon");
  if (me->query("id_type") == 5) {
    me->add_temp("apply/damage", extra * 5);
    me->add_temp("apply/dodge", extra * 5);
    me->add_temp("apply/blade", extra * 5);
  }
  target->add_temp("apply/iron-cloth", -extra * 5);
  msg = RED "$N横刀一掠，使出［夜战八方］，顿时只见四面八方都是$N的身影，同时向$n攻了过来！" NOR;
  COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR, msg);
  if (me->query("id_type") == 5) {
    me->add_temp("apply/damage", -extra * 5);
    me->add_temp("apply/dodge", -extra * 5);
    me->add_temp("apply/blade", -extra * 5);
  }
  me->start_busy(2);
  target->add_temp("apply/iron-cloth", extra * 5);
  return 1;
}
