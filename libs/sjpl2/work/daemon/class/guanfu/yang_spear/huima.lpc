//回马枪

#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int extra;
  object weapon, ride;
  if (me->is_busy())
    return notify_fail("你现在没空！！\n");
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［回马枪］只能对战斗中的对手使用。\n");
  weapon = me->query_temp("weapon");
  if (!weapon)
    return notify_fail("你手中没有使用长枪。\n");
  extra = me->query_skill("yang_spear", 1) / 10;
  if (extra * 10 < 70) return notify_fail("你的杨家枪法还不够纯熟！\n");
  target->add_temp("apply/iron-cloth", -extra * 5);

  ride = me->query_temp("ridee");
  if (ride) msg = ride->query("id"); else msg = "\n";
  if (msg != "\n" && (ride->query_temp("rider") == me) && present(msg, environment(me))) {
    me->add_temp("apply/damage", extra * 5);
    me->add_temp("apply/dodge", extra * 5);
    me->add_temp("apply/spear", extra * 5);
  }
  msg = RED "$N倒拖枪尖，转身欲走，突然一个翻身，使出［回马枪］，手中" + weapon->name() + "闪电般朝$n冷不防就是一枪！" NOR;
  COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR, msg);
  if (ride) msg = ride->query("id"); else msg = "\n";
  if (msg != "\n" && (ride->query_temp("rider") == me) && present(msg, environment(me))) {
    me->add_temp("apply/damage", -extra * 5);
    me->add_temp("apply/dodge", -extra * 5);
    me->add_temp("apply/spear", -extra * 5);
  }
  target->add_temp("apply/iron-cloth", extra * 5);

  me->start_busy(2);
  return 1;
}
