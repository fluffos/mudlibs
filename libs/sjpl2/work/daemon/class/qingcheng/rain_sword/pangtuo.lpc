// 滂沱六式
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string forskill, msg;
  int extra;
  object weapon;
  extra = me->query_skill("rain_sword", 1);
  if (extra < 90) return notify_fail("你的［急雨剑法］还不够纯熟！\n");
  forskill = (string)me->query_skill_mapped("force");
  if (forskill != "siri_force")
    return notify_fail("［滂沱六式］需要四日玄功的配和！\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［滂沱六式］只能对战斗中的对手使用。\n");
  weapon = me->query_temp("weapon");
  me->add_temp("apply/attack", -6);
  msg = HIC "$N手中" + weapon->name() + "急速挥动，剑光洒落之处有如大雨倾盆，刷刷刷一连刺出六剑！\n\n" NOR;

  if (target->query_skill(
    "iron-cloth",
    1
  ) && target->query_skill("iron-cloth") < random(me->query_skill("sword") * 2)) {
    message_vision(msg, me, target);
    message_vision(HIR "\n结果$N强大的剑气摧破了$n的真元！\n" NOR, me, target);
    target->receive_wound("kee", (int)me->query_skill("rain_sword", 1) * 2);
    COMBAT_D->report_status(target, 1);
    me->add_temp("apply/attack", 6);
    me->start_busy(2);
    return 1;
  }

  msg += HIC "滂沱第一式！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);

  msg = HIC "滂沱第二式！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);

  msg = HIC "滂沱第三式！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);

  msg = HIC "滂沱第四式！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);

  msg = HIC "滂沱第五式！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);

  msg = HIC "滂沱第六式！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);

  me->add_temp("apply/attack", 6);
  me->add("bellicosity", random(600));
  me->start_busy(6);
  return 1;
}
