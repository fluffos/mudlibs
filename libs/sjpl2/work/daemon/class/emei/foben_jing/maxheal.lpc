// maxheal.c  涅槃心经

#include <ansi.h>

int conjure(object me, object target) {
  int myatman, cost = 200, cure;
  string msg;
  myatman = me->query("atman");
  if (me->is_busy())
    return notify_fail("你正忙着呢，过会儿再念经吧！\n");
  //	if( me->is_fighting() )
  //		return notify_fail("战斗中无法使用涅槃心经！\n");
  if (me->query("gin") <= 35)
    return notify_fail("你的精不够！\n");
  if (me->is_ghost())
    return notify_fail("鬼魂无法使用涅槃心经！\n");

  if (myatman < cost * 2)
    return notify_fail("你的灵力不够。\n");

  if (cost < myatman / 2) cost = myatman / 2 - 1;

  if ((int)me->query("eff_kee") < (int)me->query("max_kee") / 2)
    cost = cost * 2;

  cure = me->query("max_kee") - me->query("eff_kee");
  cure = cure / 2;

  if (!me->is_fighting()) {
    cost = cost / 2;
    msg = HIY "只见$N双手合什，盘膝而坐，念起涅槃心经来。\n" NOR,
      msg += HIY "过不多久$N头顶渐渐升起一轮佛光，佛光越来越亮，照得$N发出一片祥和光辉！\n" NOR;
    myatman = random(8 - me->query_kar() / 5);
    if (myatman <= 1) myatman = 1;
    me->start_busy(myatman);
  } else {
    msg = HIY "$N突然越出战圈，双手合什，盘膝而坐，念起涅槃心经来。\n" NOR;
    msg += HIY "一瞬间，$N头顶升起一轮佛光，佛光越来越亮，照得$N脸上发出一片祥和光辉！\n" NOR;
    me->start_busy(1);
  }
  if (cure < 1) cure = 1;
  if (cost < 1) cost = 1;
  me->receive_curing("kee", cure);
  me->add("atman", -cost);
  message_vision(msg, me);
  return 1;
}
