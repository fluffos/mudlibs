//佛光普照
#include <ansi.h>

inherit SSERVER;
int bbqthem(object me, object obj);
int exert(object me, object target) {
  int lvl, i;
  object env, *inv;
  lvl = (int)me->query_skill("force");
  lvl += (int)me->query("spi");
  if ((int)me->query_skill("taiqing_force") < 60)
    return notify_fail("你的太清神功不够高！\n");
  if (environment(me)->query("no_fight"))
    return notify_fail("这里禁止战斗。\n");

  if (me->query("force") < 500)
    return notify_fail("你的内力不够！\n");
  if (me->query("gin") <= 100)
    return notify_fail("你的精不够！\n");
  me->add("force", -100);
  me->receive_damage("gin", 80);
  message_vision(HIY "$N内劲鼓动，猛然全身发出一道道真气，犹如佛光四射．．．\n" NOR, me);
  if (lvl <= random(200))
    return notify_fail("你因真气不够而失败了！\n");
  message_vision(HIR "．．．$N身体周围的佛光四处照射！！！\n" NOR, me);
  env = environment(me);
  inv = all_inventory(env);
  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i] == me) continue;
    if (inv[i]->is_corpse()) continue;
    if (!inv[i]->is_character()) continue;
    bbqthem(me, inv[i]);
  }
  me->start_busy(4);
  return 1;

}

int bbqthem(object me, object obj) {
  int force;
  force = (int)me->query_skill("force") / 2;
  message_vision(HIR "\n佛光象利剑般射向$N，\n" NOR, obj);
  obj->receive_damage("sen", 0, me);
  if (obj->is_ghost() == 1) {
    message_vision(YEL "$N浑身一震，登时晕了过去！\n" NOR, obj);
    obj->unconcious();
    return 1;
  }
  if (obj->is_zombie() == 1) {
    message_vision(YEL "$N浑身一震，登时晕了过去！\n" NOR, obj);
    obj->unconcious();
    return 1;
  }
  force = random(force / 2) + force / 2;
  if (userp(obj) && (((int)obj->query("combat_exp")) >= 2000)) {
    obj->receive_damage("kee", force, me);
    COMBAT_D->report_status(obj);
    obj->kill_ob(me);
    me->kill_ob(obj);
  } else {
    obj->receive_damage("kee", force, me);
    COMBAT_D->report_status(obj);
    obj->kill_ob(me);
    me->kill_ob(obj);
  }
  return 1;
}
