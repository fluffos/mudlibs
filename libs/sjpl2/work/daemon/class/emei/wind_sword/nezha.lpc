// 观音画符--哪吒召唤符  baiwt@sjpl 5,25,2000

#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  int i, extra;
  object *inv;
  object weapon, yourgod, paper;
  if (me->is_busy())
    return notify_fail("你现在没空！！\n");
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［哪吒召唤符］只能对战斗中的对手使用。\n");
  weapon = me->query_temp("weapon");
  extra = me->query_skill("foben_jing", 1);
  if (extra < 40)
    return notify_fail("你的［佛本行经］还不够。\n");
  if (me->query_skill("buddhism", 1) < 60)
    return notify_fail("你的［大乘佛法］还不够。\n");
  if (!me->query_skill("taiqing_force", 1))
    return notify_fail("你没有学会太清神功。\n");
  if (!objectp(present("paper seal", me)))
    return notify_fail("你没有桃符纸，无法施展符术。\n");
  if ((int)me->query("atman") <= 30)
    return notify_fail("你的灵力不够。\n");

  inv = all_inventory(me);
  for (i = 0; i < sizeof(inv); i++) {
    if ((string)(inv[i]->query("id")) != "paper seal")
      continue;
    if ((string)(inv[i]->query("id")) == "paper seal")
      inv[i]->add_amount(-1);
  }

  if (objectp(present("fire god", environment(me)))) {
    yourgod = present("fire god", environment(me));
    message_vision(HIC "\n$N喃喃念动咒语，只见一张符纸缓缓飘上半空。" NOR, me, target);
    message_vision(HIC "\n不久天上云开雾绽，哪吒脚踏风火轮出现在云头。" NOR, me, target);
    message_vision(HIC "\n只见哪吒将火尖枪一抖，登时一股烈焰直向$n喷射了过来！" NOR, me, target);
    message_vision(HIG "\n［哪吒召唤符］！\n\n" NOR, me, target);
    if (random(target->query("magic_defense")) < 100)
      target->receive_wound("kee", extra / 2);
    COMBAT_D->report_status(target, 1);
  } else {
    message_vision(CYN "\n$N喃喃念动咒语，只见一张符纸缓缓飘上半空。" NOR, me, target);
    message_vision(CYN "\n过了一会符纸便落了下来。\n\n" NOR, me, target);
  }
  if (me->query("atman") >= 30)
    me->add("atman", -30);
  me->start_busy(1);
  return 1;
}
