//  luanyu-strike.c乱玉掌法

#include <ansi.h>

inherit SKILL;
mapping *action = ({
  ([ "action": "$N左手一挥，右手握拳状向前一打，打出一招「瑶草何碧」，击向$n的$l。",
    "dodge": -10,
    "parry": -10,
    "damage_type": "内伤"
  ]),
  ([ "action": "$N双臂一摆，身形微晃，转到$n身后，一招「春入武溪」，双拳连拍向$n的$l。",
    "dodge": 10,
    "parry": 10,
    "force": 30,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N双拳一架，左拳向上一冲，右肘往前一顶，使出「寻花问路」，击向$n的$l。",
    "dodge": -20,
    "parry": -30,
    "force": -50,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N跳起身来，虚踢一脚，紧接着双手向$n的$l打去，使的正是「枝上黄鹂」。",
    "dodge": 20,
    "parry": -20,
    "damage": 50,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N大喝一声，拍出无数掌影，使出「桃花无数」，$n的$l被罩在层层掌影之中。",
    "dodge": -20,
    "parry": 30,
    "damage": 30,
    "damage_type": "内伤"
  ]),
  ([ "action": "$N左手凭空一拦，一招「红露沾衣」，右手手背拍向$n的$l。",
    "dodge": -70,
    "parry": -40,
    "force": 50,
    "damage": 80,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N仰天长啸，双掌运红，拍出一招「浩气红霓」，带出几道红弧，向$n的$l袭来。",
    "dodge": -80,
    "damage_type": "内伤"
  ]),
});

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练乱玉掌法必须空手。\n");
  if ((int)me->query("max_force") < 100)
    return notify_fail("你的内力太弱，无法练习乱玉掌法。\n");
  return 1;
}

int valid_enable(string usage) { return usage == "unarmed"; }

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 25)
    return notify_fail("你的体力不够了，休息一下再练吧。\n");
  me->receive_damage("kee", 25);
  return 1;
}
int effective_level() { return 10; }

int learn_bonus() {
  return 10;
}
int practice_bonus() {
  return 5;
}
int black_white_ness() {
  return 100;
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  if (damage_bonus < 100) return 0;

  if (random(damage_bonus / 2) > victim->query_str()) {
    victim->receive_wound("kee", (damage_bonus - 100) / 2);
    switch (random(4)) {
      case 0: return "$N听到「喀啦」一声脆响，好似是骨头折碎的声音！\n";
      case 1: return "$N劲力一吐，$n的$l发出「喀」地一声脆响！\n";
      case 2: return "只听见$n闷哼了一声 ...气血一阵翻腾，嘴角溢出血丝。\n";
      case 3: return "$N用上绵绵内力，把$n震退了几步，口中喷出一股鲜血！\n";
    }
  }
}
string perform_action_file(string action) {
  return CLASS_D("luoyue") + "/luanyu-strike/" + action;
}
