// luoyue-sword.c落月剑法

#include <ansi.h>

inherit SKILL;

mapping *action = ({
  ([ "name": "落拓不羁",
    "action": "$N一阵狂笑，剑招散乱，使出「落拓不羁」手中$w狂风骤雨般地向$n的$l连攻数剑",
    "dodge": 50,
    "damage": 120,
    "damage_type": "刺伤"
  ]),
  ([ "name": "落落晨星",
    "action": "$N将手中的$w一抖，使一招「落落晨星」出，$w发出一阵龙吟，$w抖出七点寒星袭向$n的$l",
    "dodge": -50,
    "damage": 20,
    "damage_type": "刺伤"
  ]),
  ([ "name": "落英缤纷",
    "action": "$N将身子拔高数尺，使出「落英缤纷」，$w挽出剑花一片，层层罩住$n的$l。",
    "dodge": -40,
    "damage": 30,
    "damage_type": "划伤"
  ]),
  ([ "name": "落花芳草无寻处",
    "action": "$N将$w往前一递，一招「" + HIB "落花芳草无寻处" NOR + "」，将$w反身一划，带出一道弧光，再接连三划，荡出一片银弧，$n的$l被罩在光弧之中。",
    "dodge": -50,
    "damage": 50,
    "damage_type": "刺伤"
  ]),
  ([ "name": "月白风清",
    "action": "$N右手持$w，微弓身子,突然身子暴起，左手虚晃，右手将$w向前一递，刺向$n的$l，使出「月白风清」。",
    "dodge": -60,
    "damage": 10,
    "damage_type": "刺伤"
  ]),
  ([ "name": "月露风云",
    "action": "$N悠然一笑，右手$w轻巧的向四周点去，一招「月露风云」，指出点点剑光,刺向$n的$l。",
    "dodge": -20,
    "damage": 30,
    "damage_type": "刺伤"
  ]),
  ([ "name": "月缺花残",
    "action": "$N冷哼一声，身子绕着$n急转，手中$w大开大阖，使出杀招「月缺花残」，斜划向$n的$l。",
    "dodge": -30,
    "damage": 50,
    "damage_type": "刺伤"
  ]),
  ([ "name": "月落星沉",
    "action": "$N暴喝一声，身子拔高数尺，$w递出，一招「月落星沉」荡出一片剑网，罩住$n的$l。",
    "dodge": 30,
    "damage": 30,
    "damage_type": "刺伤"
  ]),
  ([ "name": "月中聚雪",
    "action": "$N长啸一声，身形急转，$w舞动，使出「" + HIW "月中聚雪" NOR + "」，剑影层层包围，光环越聚越大，划向$n的$l。",
    "dodge": -70,
    "damage": 60,
    "damage_type": "刺伤"
  ]),
});

int valid_learn(object me) {
  object ob;
  if ((int)me->query("max_force") < 100)
    return notify_fail("你的内力不够，没有办法练落月剑法。\n");

  if ((string)me->query_skill_mapped("force") != "xuanyue-force")
    return notify_fail("落月剑法必须配合才能练。\n");

  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword")
    return notify_fail("你必须先找一把剑才能练剑法。\n");

  return 1;
}

int valid_enable(string usage) {
  return (usage == "sword") || (usage == "parry");
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 20
    || (int)me->query("force") < 5)
    return notify_fail("你的内力或气不够，没有办法练习落月剑法。\n");
  me->receive_damage("kee", 20);
  me->add("force", -5);
  write("你按著所学练了一遍落月剑法。\n");
  return 1;
}

int valid_effect(object me, object weapon, string name, int skill) {}

string *parry_msg = ({
  "结果$n用手中的$v格开了$N的$w。\n",
});

string *unarmed_parry_msg = ({
  "$n将手中的$v舞得密不透风，封住了$N的攻势。\n",
});
string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}
int effective_level() { return 13; }

int learn_bonus() {
  return 5;
}
int practice_bonus() {
  return 5;
}
int black_white_ness() {
  return 10;
}
string perform_action_file(string action) {
  return CLASS_D("luoyue") + "/luoyue-sword/" + action;
}
