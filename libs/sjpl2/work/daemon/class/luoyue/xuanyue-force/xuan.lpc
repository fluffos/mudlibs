// 玄字决
//written by baiwt

#include <ansi.h>

int exert(object me, object target, int amount) {
  int skill, force;
  skill = me->query_skill("xuanyue-force", 1);
  if (skill < 60) return notify_fail("你的玄月心法太差了，不能使用玄字决！\n");
  if (!target) return notify_fail("你要对谁使用玄字决？\n");
  //	if(me->is_busy())
  //		return notify_fail("你现在没空！！\n");
  if (me->is_fighting() || target->is_fighting())
    return notify_fail("战斗中无法使用玄字决！\n");
  if ((int)me->query("force") - (int)me->query("max_force") < 400)
    return notify_fail("你的真气不够。\n");
  message_vision(
    YEL "$N坐下来运起玄月心法中的「玄字决」，将手掌贴在$n背心，缓缓地将真气输入$n体内....\n\n"
    "过了不久，$n浑身泛起红光，$N却昏倒在地。\n" NOR,
    me, target);
  force = target->query_skill("force") / 4;
  target->set("force_factor", force + (int)(skill * skill * skill / 20000));
  me->add("max_force", -(int)(skill * skill * skill / 400));
  if (me->query("max_force") < 0) me->set("max_force", 0);
  me->set("force", 0);
  me->unconcious();
  return 1;
}
