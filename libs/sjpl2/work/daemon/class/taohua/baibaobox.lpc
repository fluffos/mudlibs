// baibaobox.c
#include <ansi.h>
inherit ITEM;

void create() {
  set_name("百宝箱", ({ "baibao box", "baibao" }));
  set_weight(300);
  set("unit", "个");
  set("long",
    "这是一个桃花岛神奇的百宝箱。你可以对箱中的部件进行
机关拆卸(jgrepair)、机关装配(jgmake)、机关护驾(jgprotect)。
只有会提箱术(jgpick box)的人才能控制它。\n");
  set("no_get", 1);
  set("no_drop", 1);
}

void init() {
  add_action("do_jgrepair", "jgrepair");
  add_action("do_jgmake", "jgmake");
  add_action("do_jgprotect", "jgprotect");
  add_action("do_jgpick", "jgpick");
}

int do_jgpick(string arg) {
  object me, box;
  me = this_player();
  if (!arg)
    return notify_fail("你想提起什么？\n");
  if (arg != "box")
    return notify_fail("你想提起什么？\n");
  if (present("baibao box", me))
    return notify_fail("你已经携带了百宝箱。\n");
  if ((int)me->query("gin") < 90)
    return notify_fail("你的精神没有办法有效集中！\n");
  if ((int)me->query("sen") < 90)
    return notify_fail("你的精神没有办法有效集中！\n");
  if (me->query("class") != "taohua")
    return notify_fail("你不是桃花岛弟子，无法施展［提箱术］。\n");
  if ((int)me->query_skill("jiguanshu", 1) < 30)
    return notify_fail("你不会［提箱术］。\n");
  seteuid(getuid());
  message_vision(CYN "$N提气沉身，一个马步，施展［提箱术］，登时便把百宝箱提在手中！\n" NOR, me);
  box = new("/daemon/class/taohua/baibaobox");
  box->move(me);
  me->set_temp("use_jiguan_ren", "taohua");
  me->receive_damage("gin", 50);
  me->receive_damage("sen", 50);
  return 1;
}

int do_jgrepair(string arg) {
  object me, target;
  int number, glvl, mtroops;
  string gname;
  string *mname = ({
    "head-iron", "body-iron", "arm-iron", "leg-iron",
    "head-silver", "body-silver", "arm-silver", "leg-silver",
    "head-steel", "body-steel", "arm-steel", "leg-steel",
    "head-copper", "body-copper", "arm-copper", "leg-copper",
    "head-wood", "body-wood", "arm-wood", "leg-wood",
    "head-straw", "body-straw", "arm-straw", "leg-straw",
    "head-stone", "body-stone", "arm-stone", "leg-stone",
    "head-glaze", "body-glaze", "arm-glaze", "leg-glaze",
  });

  me = this_player();
  if (!arg)
    return notify_fail("你想对谁用百宝箱？\n");
  target = present(arg, environment(me));
  if (!target)
    return notify_fail("这里没有这个机关。\n");
  if (environment(me)->query("no_fight"))
    return notify_fail("这里无法使用百宝箱！\n");
  if (environment(me)->query("no_magic"))
    return notify_fail("这里无法使用百宝箱！\n");
  if (!present("baibao box", me))
    return notify_fail("你没有携带百宝箱。\n");
  if (present("baibao box", environment(me)))
    return notify_fail("请勿在这里使用百宝箱。\n");
  if (present("zhushi ji", environment(me)))
    return notify_fail("请勿在这里使用百宝箱。\n");

  if (!target->is_character() || target->is_corpse())
    return notify_fail("百宝箱没有起作用。\n");
  //	if(!(string)target->query("jgguard") && (object)target->query_temp("pending/fight")!=me ) 
  //		return notify_fail("百宝箱被打了开来，但是什么也没有发生。\n");
  if (!(string)target->query("jgguard"))
    return notify_fail("百宝箱被打了开来，但是什么也没有发生。\n");
  if (!me->is_fighting(target))
    return notify_fail("百宝箱被打了开来，但是什么也没有发生。\n");

  if ((int)me->query("gin") < 50)
    return notify_fail("你的精神没有办法有效集中！\n");
  if ((int)me->query("sen") < 50)
    return notify_fail("你的精神没有办法有效集中！\n");
  mtroops = me->query_troops();
  if (sizeof(mtroops) >= 30)
    return notify_fail("你的百宝箱已经满了，无法再放新的机关部件。\n");
  if (target->query("jiguan_owner") == me->query("id")) number = 1;
  else number = target->query("kee");
  if (number < target->query("max_kee") / 2) {
    message_vision(HIC "\n$N打开了百宝箱，只见箱中伸出一对机械手，直取$n。\n" NOR, me, target);
    message_vision(HIC "那机械手快如闪电，一阵叮当乱响，转眼将$n拆成了一堆零件！\n" NOR, me, target);
    message_vision(HIC "机械手迅速捧起那堆零件放回入箱中，百宝箱重新关上了！\n" NOR, me, target);
    glvl = target->query("jgguard_level");
    gname = mname[random(31) + 1];
    if (!me->query_troop(gname))
      me->set_troop(gname, glvl);
    gname = mname[random(31) + 1];
    if (!me->query_troop(gname))
      me->set_troop(gname, glvl);
    gname = mname[random(31) + 1];
    if (!me->query_troop(gname))
      me->set_troop(gname, glvl);

    me->receive_damage("gin", 30);
    me->receive_damage("sen", 30);
    destruct(target);
    me->add("potential", random(1));
    me->add("combat_exp", random(2));
    me->start_busy(2);
    return 1;
  } else
    return notify_fail(YEL "\n百宝箱被打了开来，但是没有发生效用。\n" NOR);
  return 1;
}

int do_jgmake(string arg) {
  object me, obj;
  int newrank, lvl;
  string attrib;
  me = this_player();
  obj = this_object();
  if (!arg)
    return notify_fail("你想装入什么配件？\n");
  if (!present("baibao box", me))
    return notify_fail("你没有携带百宝箱。\n");
  if (present("baibao box", environment(me)))
    return notify_fail("请勿在这里使用百宝箱。\n");
  if (present("zhushi ji", environment(me)))
    return notify_fail("请勿在这里使用百宝箱。\n");

  if (!(int)me->query_troop(arg, 1))
    return notify_fail("你没有这个机关部件。\n");
  if ((int)me->query("gin") < 50)
    return notify_fail("你的精神没有办法有效集中！\n");
  if ((int)me->query("sen") < 50)
    return notify_fail("你的精神没有办法有效集中！\n");
  if (!TROOP_D(arg)->effective_type())
    return notify_fail("这个不是机关部件。\n");
  if (TROOP_D(arg)->effective_type() == "body") {
    obj->set("jgmake/body", arg);
    obj->add("jgmake/rank", TROOP_D(arg)->effective_level());
    attrib = TROOP_D(arg)->effective_attrib();
    obj->set("jgmake/attrib", attrib);
    me->delete_troop(arg);
  }
  if (!obj->query("jgmake/body"))
    return notify_fail("请先装配机关躯体。\n");
  attrib = obj->query("jgmake/attrib");
  if (TROOP_D(arg)->effective_type() == "head") {
    if (TROOP_D(arg)->effective_attrib() != obj->query("jgmake/attrib"))
      return notify_fail("这个装配机关的属性“" + attrib + "”与你的零部件属性不符合。\n");
    obj->set("jgmake/head", arg);
    obj->add("jgmake/rank", TROOP_D(arg)->effective_level());
    me->delete_troop(arg);
  }
  if (!obj->query("jgmake/head"))
    return notify_fail("装配机关还需要头部的配件。\n");
  if (TROOP_D(arg)->effective_type() == "arm") {
    if (TROOP_D(arg)->effective_attrib() != obj->query("jgmake/attrib"))
      return notify_fail("这个装配机关的属性“" + attrib + "”与你的零部件属性不符合。\n");
    obj->set("jgmake/arm", arg);
    obj->add("jgmake/rank", TROOP_D(arg)->effective_level());
    me->delete_troop(arg);
  }
  if (!obj->query("jgmake/arm"))
    return notify_fail("装配机关还需要手臂的配件。\n");
  if (TROOP_D(arg)->effective_type() == "leg") {
    if (TROOP_D(arg)->effective_attrib() != obj->query("jgmake/attrib"))
      return notify_fail("这个装配机关的属性“" + attrib + "”与你的零部件属性不符合。\n");
    obj->set("jgmake/leg", arg);
    obj->add("jgmake/rank", TROOP_D(arg)->effective_level());
    me->delete_troop(arg);
  }
  if (!obj->query("jgmake/leg"))
    return notify_fail("装配机关还需要腿部的配件。\n");
  if (TROOP_D(arg)->effective_type() == "heart") {
    obj->set("jgmake/heart", arg);
    //		obj->add("jgmake/rank",TROOP_D(arg)->effective_level());
    me->delete_troop(arg);
  }

  if (!obj->query("jgmake/heart"))
    return notify_fail("装配机关还需要心脏的配件。\n");

  newrank = ((int)me->query_skill("jiguanshu", 1) + (int)obj->query("jgmake/rank")) / 5;
  if (newrank <= 1) newrank = 1;
  if (newrank > 30) newrank = random(20) + 10;
  lvl = TROOP_D("jgguard" + (string)newrank)->effective_level();
  message_vision(HIC "$N迅速从百宝箱中翻出铁钳、锤子、扳手、铁钉等工具，扶起机关配件装配起来。\n" NOR, me);
  message_vision(HIC "随着叮叮当当一阵乱响，很快一个会活动的机关出现在$N的面前。\n" NOR, me);
  message_vision(HIC "那机关正唤做［" + to_chinese("jgguard" + (string)newrank) + "］。\n" NOR, me);
  me->set_troop("jgguard" + (string)newrank, lvl);
  obj->delete("jgmake/head");
  obj->delete("jgmake/body");
  obj->delete("jgmake/arm");
  obj->delete("jgmake/leg");
  obj->delete("jgmake/heart");
  me->receive_damage("gin", 30);
  me->receive_damage("sen", 30);
  me->start_busy(3);
  return 1;
}

int do_jgprotect(string arg) {
  string mfile;
  int mpower, mkee, mexp, mskill;
  int i;
  object *enemy;
  object me, jgguard;
  me = this_player();
  if (!arg)
    return notify_fail("你想放什么机关出来？\n");
  if (present("baibao box", environment(me)))
    return notify_fail("请勿在这里使用百宝箱。\n");
  if (present("zhushi ji", environment(me)))
    return notify_fail("请勿在这里使用百宝箱。\n");

  if (!me->query_troop(arg))
    return notify_fail("你没有携带这个机关。\n");
  if (present("jiguan guard", environment(me)))
    return notify_fail("你身边已经有一个机关保护了。\n");
  seteuid(getuid());
  mfile = TROOP_D(arg)->taohua_troop_file();
  jgguard = new(mfile);
  mpower = TROOP_D(arg)->effective_level() * 20;
  mkee = TROOP_D(arg)->effective_level() * 400;
  mexp = TROOP_D(arg)->effective_level() * 30000;
  mskill = TROOP_D(arg)->effective_level() * 10;
  jgguard->set("magic_power", mpower);
  jgguard->set("max_kee", mkee);
  jgguard->set("max_sen", mkee);
  jgguard->set("max_gin", mkee);
  jgguard->set("eff_kee", mkee);
  jgguard->set("eff_sen", mkee);
  jgguard->set("eff_gin", mkee);
  jgguard->set("kee", mkee);
  jgguard->set("sen", mkee);
  jgguard->set("gin", mkee);
  jgguard->set("max_mana", me->query_troop(arg) * 100);
  jgguard->set("mana", me->query_troop(arg) * 100);
  jgguard->set("combat_exp", mexp);
  jgguard->set("player_guard", me->query("id"));
  jgguard->set_skill("unarmed", mskill);
  jgguard->set_skill("dodge", mskill);
  jgguard->set_skill("parry", mskill);
  jgguard->set_skill("move", 500);
  jgguard->set_temp("apply/armor", 50 + mskill / 2);
  message_vision(HIC "\n$N打开百宝箱，只听见啪地一声一个机关从里面弹了出来。\n" NOR, me, jgguard);
  message_vision(HIC "那机关迅速移动到$N面前，正是［$n］！\n" NOR, me, jgguard);
  jgguard->move(environment(me));
  jgguard->set_leader(me);
  jgguard->set("jiguan_owner", me->query("id"));
  if (me->is_fighting()) {
    enemy = me->query_enemy();
    i = sizeof(enemy);
    while (i--) {
      if (enemy[i] && living(enemy[i])) {
        enemy[i]->kill_ob(jgguard);
        jgguard->kill_ob(enemy[i]);
      }
    }
  }
  if (me->query("kill_player_record") >= 300) {
    write("你忽然感到身体一阵抽蓄，你无法再控制心魔了！\n");
    message_vision(HIR "\n$n突然发出奇怪的喀哒声，转身朝$N扑了过来！\n\n" NOR, me, jgguard);
    jgguard->kill_ob(me);
  }
  if (me->query_troop(arg, 1))
    me->delete_troop(arg);
  me->start_busy(1);
  return 1;
}
