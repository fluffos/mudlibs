//鬼影现形  by baiwt@sjpl 6/10/1999
#include <ansi.h>

//inherit F_CLEAN_UP;
inherit SSERVER;
int exert(object me, object target) {
  string msg;
  int skill, damage;
  object weapon;
  if (!target)
    target = offensive_target(me);
  if (!me->is_fighting())
    return notify_fail("鬼影现形只能在战斗中使用！\n");

  if ((int)me->query("force") < 400)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_skill("guiyu_force") < 55)
    return notify_fail("你的“鬼蜮秘技”不够纯熟。\n");
  if (me->query_skill_mapped("unarmed") != "sanlianhuan")
    return notify_fail("“鬼影现形”必须配合“神倒鬼跌三连环”使用。\n");

  skill = me->query_skill("force");
  weapon = target->query_temp("weapon");

  msg = HIR
    "\n$N突然脸色一变，现出一个鬼头，嘴里伸出又尖又长的利齿向$n的颈部刺去！\n";
  me->start_busy(2);
  me->receive_damage("kee", 50);
  me->add("force", -100);

  if (weapon && target->query_skill(
    "dg9-sword",
    1
  ) && target->query_skill("sword") < random(me->query_skill("force") * 3)) {
    msg = HIR
      "\n$N突然脸色一变，现出一个鬼头，嘴里伸出又尖又长的利齿向$n的" + weapon->name() + "咬去！\n";
    message_vision(msg, me, target);
    message_vision(HIR "\n$N出其不意地咬住" + weapon->name() + "往旁边一甩！\n" NOR, me, target);
    message_vision(HIR "\n$n只觉得手中" + weapon->name() + "拿捏不住，脱手飞上半空！\n" NOR, me, target);
    "/cmds/std/unwield"->main(target, weapon);
    weapon->move(environment(me));
    target->set_delay(10);
    me->start_busy(1);
    return 1;
  }

  if (target->query_skill(
    "iron-cloth",
    1
  ) && target->query_skill("iron-cloth") < random(me->query_skill("force") * 2)) {
    message_vision(msg, me, target);
    message_vision(HIR "\n只见一片肉血飞扬，$n的颈部被咬出一个血洞！\n" NOR, me, target);
    target->receive_wound("kee", (int)me->query_skill("guiyu_force", 1) * 3);
    COMBAT_D->report_status(target, 1);
    me->start_busy(2);
    return 1;
  }

  if ((int)me->query_tol() > (int)target->query_tol() / 2 + random(30)) {
    damage = skill - ((int)target->query("force") / 10);
    if (damage > 0) {
      msg += "(只见一片肉血飞扬，$n的颈部被咬出一个血洞！)\n\n" NOR;
      target->receive_wound("kee", damage);
      me->add("bellicosity", damage / 2);
    } else msg += "结果连皮都没划破！\n" NOR;
  } else msg += "结果被$n躲开了！\n" NOR;
  message_vision(msg, me, target);
  me->start_busy(1);
  return 1;
}
