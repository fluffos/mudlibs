//天下无狗
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int extra;
  object weapon, weapon2;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［天下无狗］只能对战斗中的对手使用。\n");
  weapon = me->query_temp("weapon");
  weapon2 = target->query_temp("weapon");
  extra = me->query_skill("hitdog_stick", 1);
  if (extra < 100) return notify_fail("你的打狗棒法还不够纯熟！\n");
  if ((int)me->query("force") < 100)
    return notify_fail("你的内力不够，没有办法施展［天下无狗］。\n");

  msg = HIR "\n$N内力聚于双臂，手中的" + weapon->name() + "化成一片杖幕向四周横扫开来！\n" NOR;

  if (target->query("force_factor") && (target->query_skill("force") < random(me->query_skill("force") * 2))) {
    target->set("force_factor", 0);
    msg += HIR "$n只觉得面前杖风呼啸，迫得人难以运功相抗！\n" NOR;
    message_vision(msg, me, target);
  } else if (weapon2 && (target->query_skill("parry") < random(me->query_skill("stick") * 2))) {
    weapon2->move(environment(target));
    target->set_temp("weapon", 0);
    msg += HIR "$n只觉得手腕被一阵绞痛，兵刃竟然脱手飞出！\n" NOR;
    message_vision(msg, me, target);
  } else {
    target->add_temp("apply/iron-cloth", -extra / 2);
    target->add_temp("apply/dodge", -extra / 2);
    COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR, msg);
    target->add_temp("apply/iron-cloth", extra / 2);
    target->add_temp("apply/dodge", extra / 2);
  }
  me->add("force", -100);
  me->start_busy(2);
  return 1;
}
