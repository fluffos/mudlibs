//漫天酒雨

#include <ansi.h>

inherit SSERVER;

int exert(object me, object target) {
  object *ob;
  int skill;

  if (!me->is_fighting())
    return notify_fail("「漫天酒雨」只能在战斗中使用。\n");
  if ((int)me->query_skill("penyuntuwu", 1) < 20)
    return notify_fail("你的喷云吐雾洒酒绝技不够高，不能施展酒雨诀！\n");

  if ((int)me->query("force") < 600)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query("water") < 200)
    return notify_fail("你还没有喝饱酒水，无法施展酒雨绝技。\n");

  if (!target || target == me) {
    target = offensive_target(me);
    if (!target) return notify_fail("你要对谁施展「酒雨」诀？\n");
  }

  skill = me->query_skill("penyuntuwu", 1);

  me->add("force", -400);
  me->add("water", -100);
  message_vision(
    CYN "$N猛吸一口真气，忽然张嘴疾吐，顿时满空酒雨，好似无数细针，劈头盖脑向$n罩去！\n" NOR, me, target);
  if ((target->query_skill_mapped("force") == "bm_force") &&
    ((int)target->query_skill("bm_force") < (int)me->query_skill("penyuntuwu", 1))) {
    message_vision(HIR "\n结果$N强大的劲力摧破了$n的真元！\n" NOR, me, target);
    target->receive_wound("kee", (int)me->query_skill("penyuntuwu", 1) * 3);
    COMBAT_D->report_status(target, 1);
    me->start_busy(2);
    return 1;
  }
  if (target->query_skill("dodge") / 2 < me->query_skill("dodge")) {
    target->receive_damage("gin", skill / 2);
    target->receive_wound("kee", skill);
    COMBAT_D->report_status(target, 1);
  }
  me->start_busy(2);
  return 1;
}
