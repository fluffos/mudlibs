//赤血蛊
#include <ansi.h>
inherit SSERVER;
int curse(object me, object target) {
  int rate;
  string msg;
  if (!target) target = offensive_target(me);
  if (!target)
    return notify_fail("你要对谁下蛊？\n");
  if (!target
    || !target->is_character())
    return notify_fail("「赤血蛊」只能对活物使用。\n");
  if ((int)me->query_skill("celecurse") < 40)
    return notify_fail("你的“万蛊蚀天”不够高！\n");
  if ((int)me->query("force") < 200)
    return notify_fail("你的内力不够！\n");
  rate = me->query("max_kee") - me->query("eff_kee");
  if (rate < 200)
    return notify_fail("你还没有炼成这个蛊！\n");
  if (me->query("class") != "pima") {
    message_vision(HIR "\n$N突然挥出一团毒雾，但是这团毒雾很快便倒注入$N的体内。\n" NOR, me);
    if (!me->query_condition("noname_poison"))
      me->apply_condition("noname_poison", random(10) + 10);
    return 1;
  }

  if ((int)me->query_skill("celecurse") * random(rate) < (int)target->query_skill("force"))
    return notify_fail("你阴森地发出了[赤血蛊]，但是被对方的内力逼开了。\n");

  message_vision(HIR "\n$N的双手发出一种腐臭，突然向$n的面门挥出一团红雾。\n" NOR, me, target);
  message_vision(GRN "$N闻到一股恶腥气，刹那间感到难受之极，皮肤上竟然渗出了一粒粒可怕的红色汗液！\n\n" NOR, target);
  if (!target->query_condition("red_blood"))
    target->apply_condition("red_blood", random(10) + (int)me->query_skill("celecurse") / 10);
  target->add("kill_player_record", 2);
  me->add("force", -200);
  target->kill_ob(me);
  return 1;
}
