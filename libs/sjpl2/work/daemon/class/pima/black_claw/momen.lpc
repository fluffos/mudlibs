//墨门毒抓

#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int extra;
  object weapon;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［墨门毒抓］只能对战斗中的对手使用。\n");
  if (userp(me))
    return notify_fail("没有这种招式。\n");
  weapon = me->query_temp("weapon");
  extra = me->query_skill("black_claw", 1) / 10;
  if (extra < 10) return notify_fail("你的黑煞四十九爪还不够纯熟！\n");
  msg = HIG "$N骨骼一阵暴响，五指齐张，黑森森地略带腥味朝$n抓了过来！" NOR;
  if ((int)target->query_skill("iron-cloth", 1) > 20) {
    message_vision(msg, me, target);
    message_vision(HIR "\n结果$N强大的内劲摧破了$n的真元！\n" NOR, me, target);
    target->receive_wound("kee", (int)me->query_skill("black_claw", 1) * 3);
    COMBAT_D->report_status(target, 1);
    me->start_busy(2);
    return 1;
  }
  target->add_temp("apply/defense", -extra);
  COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR, msg);
  target->add_temp("apply/defense", extra);
  me->start_busy(2);
  return 1;
}
