//腥风血雨
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int extra;
  extra = me->query_skill("black_claw", 1);

  if (extra < 100) return notify_fail("你的［黑煞四十九爪］还不够纯熟！\n");
  if ((int)me->query_skill("blood_force", 1) < 90)
    return notify_fail("你的丧血毒煞功不够高！\n");

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("「腥风血雨」只能对战斗中的对手使用。\n");

  if ((int)me->query("force") < 300)
    return notify_fail("你的内力不够，没有办法施展「腥风血雨」。\n");

  extra = me->query("max_kee") - me->query("kee");
  if (extra <= 0) extra = 1;

  msg = HIB "$N喉咙里突然发出撕心裂肺的怪叫，双爪爪心通红，十根手指
\n黑如炭墨，挥起一团「腥风血雨」朝$n抓来! " NOR;
  message_vision(msg, me, target);

  if (target->query_skill("parry") + target->query_skill("dodge")
    < random((me->query_skill("unarmed") + me->query_skill("dodge")) * 2))
    target->receive_wound("kee", random(extra) + 10);
  COMBAT_D->report_status(target, 1);
  me->add("force", -300);
  me->start_busy(3);
  return 1;
}
