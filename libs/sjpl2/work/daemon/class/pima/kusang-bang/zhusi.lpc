//丧魂蛛丝  created by baiwt@sjpl 11,2,1999
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
void return_busy(object me, object target);

int perform(object me, object target) {
  int force, lvl;
  object weapon;
  if ((int)me->query("force") < 250)
    return notify_fail("你的内力太差了！\n");
  force = (int)me->query_skill("blood_force");
  lvl = (int)me->query_skill("kusang-bang");
  weapon = me->query_temp("weapon");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［丧魂蛛丝］只能对战斗中的对手使用。\n");

  if (force < 30 || lvl < 30)
    return notify_fail("你的哭丧棒法和丧血毒煞功太差了，无法施展“丧魂蛛丝”！\n");
  if ((int)me->query_temp("kusang/zhusi"))
    return notify_fail("你正在施展“丧魂蛛丝”！\n");
  if (me->query("class") != "pima") {
    message_vision(HIW "\n突然从$N的" + weapon->name() + HIW "上喷出一团毒雾，毒雾很快便倒注入$N的体内。\n" NOR, me);
    if (!me->query_condition("noname_poison"))
      me->apply_condition("noname_poison", random(10) + 10);
    return 1;
  }
  me->start_busy(1);
  me->add("force", -200);
  lvl = (int)(target->query_int() + target->query_per() - me->query_int() - me->query_per());
  if (lvl <= 1) lvl = 1;
  me->set_temp("kusang/zhusi", lvl);
  target->set_delay(lvl);
  target->map_skill("dodge");
  target->reset_action();
  message_vision(HIW "\n$N用力一抖" + weapon->name() + HIW "，只听兹兹连声怪响，\n" NOR, me);
  message_vision(HIW "\n" + weapon->name() + HIW "的一头突然裂了开来，从里面射出无数蜘蛛细丝！\n" NOR, me);
  message_vision(HIW "\n那蜘丝又粘又稠，转眼缠上了$N的身体，吓得$N魂飞魄散！\n" NOR, target);
  call_out("return_busy", 3, me, target);
  return 1;
}

void return_busy(object me, object target) {
  int lvl;
  object weapon;
  if (!me) return;
  if (!target
    || !target->is_character()
    || !me->is_fighting(target)) {
    if (me->query_temp("kusang/zhusi"))
      me->delete_temp("kusang/zhusi");
    message_vision(HIC "$N的［丧魂蛛丝］施展完毕，把功力收回丹田！\n" NOR, me);
    return;
  } else if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "stick") {
    message_vision(HIW "$N身上缠绕的蛛丝渐渐松弛下来，被风吹散了！\n" NOR, target);
    if (me->query_temp("kusang/zhusi"))
      me->delete_temp("kusang/zhusi");
    return;
  }
  lvl = (int)me->query_temp("kusang/zhusi");
  if (lvl <= 1) lvl = 1;
  target->receive_damage("kee", random(lvl) + 2);
  message_vision(WHT "$N牵引着丧魂蛛丝，将它紧紧缠绕在$n身上，令其难以施展绝技！\n" NOR, me, target);
  if (!target->query_delay())
    target->set_delay(lvl);
  call_out("return_busy", 3, me, target);
}
