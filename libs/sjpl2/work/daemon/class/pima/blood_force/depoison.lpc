//还生照
#include <ansi.h>
inherit SSERVER;

int exert(object me, object target, int amount) {
  int force, lvl;
  if (target != me) return notify_fail("你只能用真气将自己体内毒素逼出。\n");
  force = (int)me->query("force") - (int)me->query("max_force");
  if (force <= 300) return notify_fail("你的真气不足。\n");
  if (me->query("class") != "pima") {
    if (!me->query_condition("noname_poison"))
      me->apply_condition("noname_poison", random(10) + 10);
    return notify_fail("你体内的“无名奇蛊”活动了！\n");
  }
  if (me->query("kill_player_record"))
    return notify_fail(HIR "你内有心魔，无法化解身上的奇毒！\n" NOR);

  lvl = me->query_skill("blood_force", 1);
  if (random(lvl) < 50) {
    me->add("force", -300);
    me->start_busy(1);
    message_vision(HIB "$N运功抗毒，头上冒出豆大的汗．．．\n" NOR, me);
    return notify_fail("你失败了。\n");
  } else {
    me->clear_condition();
    me->start_busy(1);
    message_vision(HIB "$N运功抗毒，头上冒出豆大的汗．．．\n" NOR, me);
    write("你成功了！\n");
    return 1;
  }
}
