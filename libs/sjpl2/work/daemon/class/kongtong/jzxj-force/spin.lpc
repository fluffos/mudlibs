// 天绅倒悬

#include <ansi.h>

int exert(object me, object target) {
  int extra;
  if (me->is_fighting())
    return notify_fail("战斗中练“天绅倒悬”，找死吗。\n");
  //	if(me->is_busy())
  //		return notify_fail("你正忙着呢！\n");

  if ((int)me->query("force") - (int)me->query("max_force") < 50)
    return notify_fail("你的真气不够。\n");

  if ((int)me->query("eff_kee") < (int)me->query("max_kee") / 3)
    return notify_fail("你已经受伤过重，只怕一运真气便有生命危险。\n");

  extra = me->query_skill("jzxj-force", 1);
  if (extra < 20) return notify_fail("你的［甲子玄机心法］还不够纯熟！\n");
  if (!target) target = me;

  if (me->query_temp("kt/fivespin")) {
    extra = me->query_temp("kt/fivespin");
    if (extra > me->query_skill("jzxj-force") / 10)
      return notify_fail("你已经达到你所能练的最高境界了！\n");
  }
  message("vision",
    HIC + me->name() + "一跃而起，身形奇怪无比地旋转上升，又头上脚下地俯冲下来。\n" NOR,
    environment(me), me);
  message("vision",
    HIC + me->name() + "身子未落地，便一个筋斗翻了过来，平稳落下。\n" NOR,
    environment(me), me);
  write(CYN "你的“天地五转”进步了。\n" NOR);
  me->add("force", -50);
  me->add_temp("kt/fivespin", 1);
  me->start_busy(1);
  return 1;
}
