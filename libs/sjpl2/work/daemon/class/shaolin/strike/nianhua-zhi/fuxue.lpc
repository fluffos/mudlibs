// fuxue.c「拈花拂穴」

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  int damage;

  if (me->is_busy())
    return notify_fail("你上个动作还没结束呢。\n");
  if (environment(me)->query("no_fight"))
    return notify_fail("这里禁止战斗。\n");

  if (!target)
    return notify_fail("你要点谁的穴？\n");
  if (!target->is_character() || target->is_corpse())
    return notify_fail("看清楚一点，那并不是活物。\n");
  if (target == me)
    return notify_fail("你脑子有病呀？点自己干什么？\n");
  if ((int)me->query("force") - (int)me->query("max_force") < 100)
    return notify_fail("你的真气不够。\n");
  if ((string)me->query("class") != "shaolin")
    return notify_fail("你不是少林佛门弟子，无法体会佛祖拈花微笑的本意！\n");
  if ((int)me->query("force") < (int)target->query("force") / 3)
    return notify_fail("你施展出[拈花拂穴]，但是你发出的劲力全被弹开了。\n");

  me->add("force", -100);
  message_vision(CYN "$N使出拈花指的绝招「拈花拂穴」，一股真气极快地点向$n的大穴\n" NOR, me, target);

  me->start_busy(2);

  if ((int)target->query_skill("yoga") > (int)me->query_skill("nianhua-zhi")) {
    message_vision(CYN "\n但是$n全身经脉穴道逆转，根本不为所动！\n" NOR, me, target);
    return 1;
  }
  if ((int)target->query_skill("liumai_force") > (int)me->query_skill("nianhua-zhi")) {
    message_vision(CYN "\n但是$n内力流转，很快冲开了被封的穴道！\n" NOR, me, target);
    return 1;
  }
  if ((int)target->query_skill("jzxj-force") > (int)me->query_skill("nianhua-zhi")) {
    message_vision(CYN "\n但是$n运起穴位转移大法，根本不为所动！\n" NOR, me, target);
    return 1;
  }
  if ((int)target->query_skill("liuhe-force") > (int)me->query_skill("nianhua-zhi")) {
    message_vision(CYN "\n但是$n真气鼓动，眨眼冲开了被封的穴道！\n" NOR, me, target);
    return 1;
  }

  if (random(me->query("kar") + 5) > target->query("kar") &&
    (random(me->query_skill("dodge") + target->query_skill("dodge")) > target->query_skill("dodge"))) {
    message_vision(CYN "$n身上的大穴被$N点中，一时动弹不得\n" NOR, me, target);
    target->start_busy((int)me->query_skill("nianhua-zhi") / 10);
  } else if (random(me->query_skill("dodge")) + 10 > random(target->query_skill("dodge"))) {
    message_vision(CYN "$n身子微微一闪，$N虽然点到$n身上，但没有点中穴位\n" NOR, me, target);
    damage = (int)me->query_skill("unarmed") * 3 - (int)target->query_skill("dodge") * 2;
    if (wizardp(me)) printf("damage = %d\n", damage);
    if (damage > 0) {
      target->receive_wound("kee", damage / 5);
      COMBAT_D->report_status(target, 1);
    }
  } else {
    message_vision(CYN "$n飞快地闪到一边，$N点了个空，差点摔到地上，神情很狼狈\n" NOR, me, target);
  }
  target->kill_ob(me);
  me->fight_ob(target);

  return 1;
}
