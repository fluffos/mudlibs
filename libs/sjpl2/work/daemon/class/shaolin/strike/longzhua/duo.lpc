//duo.c

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  object weapon;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("空手夺白刃只能对战斗中的对手使用\n");

  if (!(weapon = target->query_temp("weapon")))
    return notify_fail("对手并没有用武器啊!\n");

  message_vision(CYN "$N猛地一侧身，躲过$n的进攻，伸手就去夺$n的兵器\n" NOR, me, target);
  if (random(me->query("kar") + 5) > target->query("kar") &&
    (random(me->query_skill("dodge") + target->query_skill("dodge")) > target->query_skill("dodge"))) {
    message_vision(CYN "$n一不小心，手中的兵器竟被$N夺走，$n不由得一阵慌乱\n" NOR, me, target);
    target->start_busy(3);
    weapon->move(me);
  } else {
    message_vision(CYN "$n眼疾手快，一个变招，$N马上处于被动\n" NOR, me, target);
    me->start_busy(2);
  }
  target->kill_ob(me);
  me->fight_ob(target);

  return 1;
}
