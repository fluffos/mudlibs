//光明永存  created by baiwt@sjpl 11,2,1999
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
void return_busy(object me, object target);
string *sp_msg = ({
  YEL "\n你忽然感到身前有一股柔和的劲力，所有招式都卷入了这股劲力之中。\n" NOR,
  YEL "\n$N劲力一吐，$n只感到眼前金光闪耀，眩目欲花！\n" NOR,
  YEL "\n只见$N身上佛光乍现，$n的招式竟然尽数不知去向 ...\n" NOR,
});

int perform(object me, object target) {
  int force, lvl;
  if ((int)me->query("force") < 500)
    return notify_fail("你的内力太差了！\n");
  force = (int)me->query_skill("shaoyang_force");
  lvl = (int)me->query_skill("luohan_force");

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［光明永存］只能对战斗中的对手使用。\n");

  if (force < 50 || lvl < 50)
    return notify_fail("你的少阳神功和阿罗汉神功太差了，无法施展“光明永存”！\n");
  if ((int)me->query_temp("bright_ken"))
    return notify_fail("你正在施展“光明永存”！\n");
  me->start_busy(1);
  me->add("force", -500);
  me->set_temp("bright_ken", 1);
  message_vision(HIY "\n$N拳法起处，身上竟然现出一片佛光，佛光很快罩住了$N全身！\n\n" NOR, me);
  call_out("return_busy", 1, me, target);
  return 1;
}

void return_busy(object me, object target) {
  string msg;
  int extrad;
  if (!target || !me
    || !target->is_character()
    || !me->is_fighting(target)) {
    if (me->query_temp("bright_ken"))
      me->delete_temp("bright_ken");
    message_vision(YEL "$N的“光明永存”施展完毕，身上的佛光渐渐隐去了。。。\n" NOR, me);
    return;
  }
  if (me->is_busy()) {
    message_vision(sp_msg[random(sizeof(sp_msg))], me, target);
    target->start_busy(3);
  }
  if (me->query_skill("bright_ken", 1) > random(300)) {
    message_vision(YEL "$N双臂一展，忽然门户大开，胸前聚起一团光芒，似乎便是传说中的“光明磊落”！\n" NOR, me, target);
    message_vision(YEL "$n乘隙攻去，却感到全身劲力如潮水般卷入那团光芒之中。。。\n" NOR, me, target);
    target->set("force", target->query("force") / 2);
  } else if ((target->query("daode") < me->query("daode")) && (random(10) < 7)
    && (me->query_skill("bright_ken", 1) >= 200)) {
    extrad = (me->query("daode") - target->query("daode")) / 2;
    if (extrad < 0) extrad = -extrad;
    if (extrad > 600) extrad = 600;
    extrad = extrad + me->query("cps") + me->query("con") + me->query("fle");
    message_vision(YEL "\n只见$N双拳合抱成圆，呼地一声将圆圈中积蓄的内力一并推出，气势宏大的劲力向$n源源涌来！\n\n" NOR, me, target);
    target->receive_wound("kee", extrad);
    COMBAT_D->report_status(target, 1);
  }
  call_out("return_busy", 4, me, target);
}
