// 神魔归位
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int extra;
  object weapon;
  if (me->is_busy())
    return notify_fail("你现在没空！！\n");
  extra = me->query("force") / 10;
  if (extra < 90) return notify_fail("你的内力太弱，还运用不出［神魔归位］这绝招！\n");
  if (extra > 300) extra = 300;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［神魔归位］只能对战斗中的对手使用。\n");
  weapon = me->query_temp("weapon");
  me->add("force", -500);
  me->add_temp("apply/damage", extra);
  target->add_temp("apply/dodge", -extra);
  target->add_temp("apply/iron-cloth", -extra / 2);

  msg = HIY "$N高声诵出佛号，手中的" + weapon->name() + "集全身之内力，向$n猛然挥去！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  me->add_temp("apply/damage", -extra);
  target->add_temp("apply/dodge", extra);
  target->add_temp("apply/iron-cloth", extra / 2);

  me->start_busy(2);
  return 1;
}
