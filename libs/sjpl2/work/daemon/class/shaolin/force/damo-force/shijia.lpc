//释迦重生  created by baiwt@sjpl 11,2,1999
#include <ansi.h>
inherit F_CLEAN_UP;
void return_busy(object me, object target);

int exert(object me, object target) {
  int force, damo;
  if ((int)me->query("gin") < 50)
    return notify_fail("你的精太差了！\n");
  force = (int)me->query_skill("force");
  damo = (int)me->query_skill("damo-force");

  if (!target)
    //		target = offensive_target(me);
    return notify_fail("你要对谁施展［释迦重生］？\n");
  if (!target->is_character() || !me->is_fighting(target))
    return notify_fail("［释迦重生］只能对战斗中的对手使用。\n");

  if (force < 50 || damo < 50)
    return notify_fail("你的达摩闭息功和内功太差了，无法运“释迦重生”！\n");
  if ((int)me->query_temp("shaolin/shijia"))
    return notify_fail("你正在运行“释迦重生”！\n");
  me->receive_damage("gin", 50);
  me->start_busy(1);
  me->add("force", -50);
  me->set_temp("shaolin/shijia", 1);
  message_vision(YEL "$N运起［释迦重生］，刹那间打通了全身经脉，头顶现出一轮圆月，达到了三花聚顶的境界！\n\n" NOR, me);
  call_out("return_busy", 2, me, target);
  return 1;
}

void return_busy(object me, object target) {
  if (!target
    || !target->is_character()
    || !me->is_fighting(target)) {
    if (me->query_temp("shaolin/shijia"))
      me->delete_temp("shaolin/shijia");
    message_vision(HIC "$N头顶的圆月消失，把功力收回丹田！\n" NOR, me);
    return;
  }
  if (me->is_busy()) {
    target->start_busy(3);
    me->start_busy(1);
    message_vision(HIC "$N不为所动，$n反而自己乱了手脚！\n" NOR, me, target);
    COMBAT_D->do_attack(target, target, target->query_temp("weapon"));
  }
  call_out("return_busy", 5, me, target);
}
