//童子拜佛

#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me, int amount);

int exert(object me, object target, int amount) {
  int skill;

  if (target != me) return notify_fail("你只能用少林童子功压制自己的杀气。\n");

  if ((int)me->query("force") < 100) return notify_fail("你的内力不够。\n");
  if ((int)me->query("sen") < 100) return notify_fail("你的心神不够。\n");
  if (me->query_temp("powerup")) return notify_fail("你已经在运功中了。\n");

  //        if( (int)me->query("bellicosity") <= 0 )
  //                return notify_fail("你现在毫无杀气。\n");

  skill = me->query_skill("force");

  if ((int)me->query("bellicosity") > 100)
    me->add("bellicosity", -100 - skill / 3);

  me->add("force", -100);
  me->receive_damage("sen", 100);
  if (me->query("food") < 180)
    me->add("food", 20);
  if (me->query("water") < 180)
    me->add("water", 20);

  message_vision(
    HIC "$N双手合十，盘膝坐地，虔诚地念起了佛经，身上渐渐起了一层佛光 
....\n" NOR, me);

  if (me->is_fighting()
    && (random(skill) < (int)me->query("cps") * 3))
    me->unconcious();

  return 1;
}

void remove_effect(object me, int amount) {
  if (!me) return;
  me->add_temp("apply/attack", -amount);
  me->add_temp("apply/dodge", -amount);
  me->add_temp("apply/damage", -amount);
  me->delete_temp("powerup");
  tell_object(me, "你的少林童子功运行完毕，将内力收回丹田。\n");
}
