#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  object weapon;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展这一招「三入地狱」？\n");

  if (!me->is_fighting())
    return notify_fail("「三入地狱」只能在战斗中使用！\n");

  if ((int)me->query("force") < 600)
    return notify_fail("你的内力不够！\n");

  if ((int)me->query("kee") < 200)
    return notify_fail("你的气血不足，没法子施用外功！\n");

  if ((int)me->query_skill("hammer", 1) < 50)
    return notify_fail("你的基本锤法级别还不够，使用这一招会有困难！\n");

  if ((int)me->query_skill("luohan_force", 1) < 50)
    return notify_fail("你的阿罗汉神功级别还不够，使用这一招会有困难！\n");

  if ((int)me->query_skill("weituo_chu", 1) < 50)
    return notify_fail("你的大韦陀杵级别还不够，使用这一招会有困难！\n");
  target->add_temp("apply/iron-cloth", -100);

  weapon = me->query_temp("weapon");
  me->delete("env/brief_message");
  target->delete("env/brief_message");
  message_vision(HIR "\n$N手中兵器划一大圆，猛然托天而举，犹如韦陀降世，使出了「三入地狱」绝招。\n" NOR, me);

  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  target->add_temp("apply/iron-cloth", 100);

  me->receive_damage("kee", 30);
  me->add("force", -200);

  me->start_busy(3);
  return 1;
}
