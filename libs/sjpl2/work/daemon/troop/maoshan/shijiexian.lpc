// taoist_guard.c  by baiwt@sjpl 5,17,2000
//法术：［妖气聚］ 属性：heal  对象：me  克星：无
//法术：［拆骨离肉术］ 属性：attack  对象：all  克星：无
#include <ansi.h>
inherit NPC;
int magic_more(object who);

void create() {
  set_name("尸解仙", ({ "shijiexian", "taoist guard" }));
  set("gender", "男性");
  set("age", 20);
  set("attitude", "peaceful");

  set("mguard", "mguard46");
  set("mguard_level", 46);
  set("magic_power", 3000);

  set("str", 42);
  set("cor", 52);
  set("cps", 22);

  set("max_kee", 1000);
  set("max_gin", 1000);
  set("max_sen", 1000);

  set("combat_exp", 1000000);
  set_skill("dodge", 200);
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: magic_more(this_object()) :),
  }));
  set_temp("super_damage", 86400 * 7);

  set_temp("apply/attack", 20);
  set_temp("apply/damage", 20);
  set_temp("apply/defence", 20);
  set_temp("apply/armor", 20);
  setup();

}
int magic_more(object who) {
  int i, mwp;
  object *enemy;
  seteuid(getuid());
  enemy = who->query_enemy();
  mwp = who->query("magic_power");
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      if (who->query("mana") < 50) return 1;
      if (who->query("kee") < who->query("max_kee") * 3 / 4) {
        message_vision(HIB "\n$N喃喃念动咒语，只见四周升起一团又一团妖气，" NOR, who, enemy[i]);
        message_vision(HIB "\n妖气飘散开来，又渐渐在$N身上聚拢。\n" NOR, who, enemy[i]);
        message_vision(HIG "［妖气聚］！\n\n" NOR, who);
        who->receive_curing("kee", mwp);
        who->receive_heal("kee", mwp);
        who->receive_curing("sen", mwp);
        who->receive_heal("sen", mwp);
        if (who->query("mana") >= 50)
          who->add("mana", -50);
        COMBAT_D->report_status(who, 1);
        return 1;
      }
      message_vision(HIR "\n$N伸手一指，变出了一具尸体，只见$N喃喃念动咒语，双手挥动之间，" NOR, who, enemy[i]);
      message_vision(HIR "\n尸体便骨肉横飞，转眼被拆成了一堆腐肉白骨，$N怪叫一声，那些骨" NOR, who, enemy[i]);
      message_vision(HIR "\n肉便从地上跳起，一股脑向$n砸了过来！！\n" NOR, who, enemy[i]);
      message_vision(HIG "［拆骨离肉术］！\n\n" NOR, who);
      if (random(enemy[i]->query("magic_defense")) < random(600))
        enemy[i]->receive_wound("kee", mwp, who);
      if (who->query("mana") >= 50)
        who->add("mana", -50);
      COMBAT_D->report_status(enemy[i], 1);
    }
  }
  return 1;
}

int heal_up() {
  object mguard = this_object();
  if (!present(
    (string)mguard->query("player_guard"),
    environment(mguard)
  ) && !userp(environment(mguard))) {
    call_out("leave", 1);
    return 1;
  }
  return ::heal_up() + 1;
}

void leave() {
  message("vision",
    HIW + name() + "的身影渐渐虚化，变做了一道白烟。\n\n"
    "白烟随风飘散，很快消失了......\n" NOR, environment(),
    this_object());
  destruct(this_object());
}
