// taoist_guard.c  by baiwt@sjpl 5,17,2000
//法术：［还魂大法］ 属性：heal  对象：me  克星：无
//法术：［拘魂役］ 属性：busy5  对象：all  克星：无
#include <ansi.h>
inherit NPC;
int magic_more(object who);

void create() {
  set_name("黑无常", ({ "heiwuchang", "taoist guard" }));
  set("gender", "男性");
  set("age", 20);
  set("attitude", "peaceful");

  set("mguard", "mguard48");
  set("mguard_level", 48);
  set("magic_power", 3000);

  set("str", 42);
  set("cor", 52);
  set("cps", 22);

  set("max_kee", 1000);
  set("max_gin", 1000);
  set("max_sen", 1000);

  set("combat_exp", 1000000);
  set_skill("dodge", 200);
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: magic_more(this_object()) :),
  }));
  set_temp("super_damage", 86400 * 7);

  set_temp("apply/attack", 20);
  set_temp("apply/damage", 20);
  set_temp("apply/defence", 20);
  set_temp("apply/armor", 20);
  setup();

}
int magic_more(object who) {
  int i, mwp;
  object *enemy;
  seteuid(getuid());
  enemy = who->query_enemy();
  mwp = who->query("magic_power");
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      if (who->query("mana") < 50) return 1;
      if (who->query("kee") < who->query("max_kee") * 3 / 4) {
        message_vision(HIB "\n$N伸手一指，变出一本生死簿，顿时无数死去的灵魂都聚拢来被" NOR, who, enemy[i]);
        message_vision(HIB "\n$N吸入体内，$N的伤势眨眼间完全恢复了。\n" NOR, who, enemy[i]);
        message_vision(HIG "［还魂大法］！\n\n" NOR, who);
        who->receive_curing("kee", mwp);
        who->receive_heal("kee", mwp);
        who->receive_curing("sen", mwp);
        who->receive_heal("sen", mwp);
        if (who->query("mana") >= 50)
          who->add("mana", -50);
        COMBAT_D->report_status(who, 1);
        return 1;
      }
      message_vision(HIR "\n$N从腰间取出吸星枷锁，放手一抖，便将$n套在枷锁之中，动弹不得。" NOR, who, enemy[i]);
      message_vision(HIR "\n$N拿出一根鬼役长鞭，狠狠地朝$n一鞭鞭地抽了过去！！\n" NOR, who, enemy[i]);
      message_vision(HIG "［拘魂役］！\n\n" NOR, who);
      if (random(enemy[i]->query("magic_defense")) < random(700))
        enemy[i]->receive_wound("kee", mwp, who);
      if (who->query("mana") >= 50)
        who->add("mana", -50);
      COMBAT_D->report_status(enemy[i], 1);
    }
  }
  return 1;
}

int heal_up() {
  object mguard = this_object();
  if (!present(
    (string)mguard->query("player_guard"),
    environment(mguard)
  ) && !userp(environment(mguard))) {
    call_out("leave", 1);
    return 1;
  }
  return ::heal_up() + 1;
}

void leave() {
  message("vision",
    HIW + name() + "的身影渐渐虚化，变做了一道白烟。\n\n"
    "白烟随风飘散，很快消失了......\n" NOR, environment(),
    this_object());
  destruct(this_object());
}
