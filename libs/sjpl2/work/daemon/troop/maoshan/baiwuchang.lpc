// taoist_guard.c  by baiwt@sjpl 5,17,2000
//法术：［鬼哭符］ 属性：attack  对象：all  克星：无
//法术：［透骨正气符］ 属性：heal  对象：me  克星：无
#include <ansi.h>
inherit NPC;
int magic_more(object who);

void create() {
  set_name("白无常", ({ "baiwuchang", "taoist guard" }));
  set("gender", "男性");
  set("age", 30);
  set("attitude", "peaceful");

  set("mguard", "mguard49");
  set("mguard_level", 49);
  set("magic_power", 3000);

  set("str", 42);
  set("cor", 52);
  set("cps", 22);

  set("max_kee", 1000);
  set("max_gin", 1000);
  set("max_sen", 1000);

  set("combat_exp", 1000000);
  set_skill("dodge", 200);
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: magic_more(this_object()) :),
  }));
  set_temp("super_damage", 86400 * 7);

  set_temp("apply/attack", 20);
  set_temp("apply/damage", 20);
  set_temp("apply/defence", 20);
  set_temp("apply/armor", 20);
  setup();

}
int magic_more(object who) {
  int i, mwp;
  object *enemy;
  seteuid(getuid());
  enemy = who->query_enemy();
  mwp = who->query("magic_power");
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      if (who->query("mana") < 50) return 1;
      if (who->query("kee") < who->query("max_kee") * 3 / 4) {
        message_vision(HIW "\n$N伸手变出一张符纸，迎风一招，那符纸忽然化作了一根白骨，" NOR, who, enemy[i]);
        message_vision(HIW "\n$N一口将白骨吞了下去，顿时身上所有的伤势都痊愈了。\n" NOR, who, enemy[i]);
        message_vision(HIG "［透骨正气符］！\n\n" NOR, who);
        who->receive_curing("kee", mwp);
        who->receive_heal("kee", mwp);
        who->receive_curing("sen", mwp);
        who->receive_heal("sen", mwp);
        if (who->query("mana") >= 50)
          who->add("mana", -50);
        COMBAT_D->report_status(who, 1);
        return 1;
      }
      message_vision(HIR "\n$N信手拈来一张符纸，迎风一招，那符纸唿地一声化作了一口大钟，" NOR, who, enemy[i]);
      message_vision(HIR "\n$N直飞到$n头顶罩了下去。随着$n一声惨叫，那口大钟正将$n罩住，" NOR, who, enemy[i]);
      message_vision(HIR "\n钟里传来无数孤魂野鬼的哭泣嚎叫之声！\n" NOR, who, enemy[i]);
      message_vision(HIG "［鬼哭符］！\n\n" NOR, who);
      if (random(enemy[i]->query("magic_defense")) < random(800))
        enemy[i]->receive_wound("kee", mwp, who);
      if (who->query("mana") >= 50)
        who->add("mana", -50);
      COMBAT_D->report_status(enemy[i], 1);
    }
  }
  return 1;
}

int heal_up() {
  object mguard = this_object();
  if (!present(
    (string)mguard->query("player_guard"),
    environment(mguard)
  ) && !userp(environment(mguard))) {
    call_out("leave", 1);
    return 1;
  }
  return ::heal_up() + 1;
}

void leave() {
  message("vision",
    HIW + name() + "的身影渐渐虚化，变做了一道白烟。\n\n"
    "白烟随风飘散，很快消失了......\n" NOR, environment(),
    this_object());
  destruct(this_object());
}
