// taoist_guard.c  by baiwt@sjpl 5,17,2000
//法术：［蟠桃符］ 属性：heal  对象：me  克星：无
//法术：［猕猿扑打］ 属性：attack  对象：all  克星：无
#include <ansi.h>
inherit NPC;
int magic_more(object who);

void create() {
  set_name("长右", ({ "changyou", "taoist guard" }));
  set("race", "野兽");
  set("gender", "雄性");
  set("age", 20);
  set("attitude", "peaceful");

  set("mguard", "mguard30");
  set("mguard_level", 30);
  set("magic_power", 3000);

  set("str", 42);
  set("cor", 52);
  set("cps", 22);

  set("max_kee", 1000);
  set("max_gin", 1000);
  set("max_sen", 1000);

  set("limbs", ({ "头部", "身体", "爪子", "尾巴" }));
  set("verbs", ({ "claw" }));

  set("combat_exp", 1000000);
  set_skill("dodge", 200);
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: magic_more(this_object()) :),
  }));

  set_temp("apply/attack", 20);
  set_temp("apply/damage", 20);
  set_temp("apply/defence", 20);
  set_temp("apply/armor", 20);
  setup();

}
int magic_more(object who) {
  int i, mwp;
  object *enemy;
  seteuid(getuid());
  enemy = who->query_enemy();
  mwp = who->query("magic_power");
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      if (who->query("mana") < 50) return 1;
      if (who->query("kee") < who->query("max_kee") * 3 / 4) {
        message_vision(HIC "\n$N仰天念了几句咒语，突然天上传来阵阵仙乐声，九天仙女挎着竹篮" NOR, who, enemy[i]);
        message_vision(HIC "\n在云头出现，将一只蟠桃撒了下来，$N伸手接住几口就吞了下去。\n" NOR, who, enemy[i]);
        message_vision(HIG "［蟠桃符］！\n\n" NOR, who);
        who->receive_curing("kee", mwp);
        who->receive_heal("kee", mwp);
        who->receive_curing("sen", mwp);
        who->receive_heal("sen", mwp);
        if (who->query("mana") >= 50)
          who->add("mana", -50);
        COMBAT_D->report_status(who, 1);
        return 1;
      }
      message_vision(HIR "\n$N尖声嘶叫，猛地扑上来一阵乱打乱抓，身法却极其灵活多变，" NOR, who, enemy[i]);
      message_vision(HIR "\n$n登时被抓得遍体鳞伤。\n" NOR, who, enemy[i]);
      message_vision(HIG "［猕猿扑打］！\n\n" NOR, who);
      if (random(enemy[i]->query("magic_defense")) < random(500))
        enemy[i]->receive_wound("kee", mwp);
      if (who->query("mana") >= 50)
        who->add("mana", -50);
      COMBAT_D->report_status(enemy[i], 1);
    }
  }
  return 1;
}

int heal_up() {
  object mguard = this_object();
  if (!present(
    (string)mguard->query("player_guard"),
    environment(mguard)
  ) && !userp(environment(mguard))) {
    call_out("leave", 1);
    return 1;
  }
  return ::heal_up() + 1;
}

void leave() {
  message("vision",
    HIW + name() + "的身影渐渐虚化，变做了一道白烟。\n\n"
    "白烟随风飘散，很快消失了......\n" NOR, environment(),
    this_object());
  destruct(this_object());
}
