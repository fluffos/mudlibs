// 枯荣禅功

#include <ansi.h>
inherit FORCE;
string skill_cname() {
  return "枯荣禅功";
}

int valid_enable(string usage) { return usage == "force"; }
string force_type() { return "yang_force"; }

int valid_learn(object me) {
  if ((int)me->query_skill("force", 1) < (int)me->query_skill("kurong-force", 1))
    return notify_fail("你的基本内功修为不够，无法领会更高深的枯荣禅功。\n");


  return 1;
}

int practice_skill(object me) {
  return notify_fail("枯荣禅功只能用学习，或是从运用(exert)中增加熟练度。\n");
}

string exert_function_file(string func) {

  return CLASS_D("kugu") + "/kurong-force/" + func;
}
int effective_level() { return 25; }

int learn_bonus() {
  return -60;
}
int practice_bonus() {
  return -60;
}
int black_white_ness() {
  return -60;
}
