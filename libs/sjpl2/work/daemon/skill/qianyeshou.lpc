// qianyeshou.c  如来千叶手

inherit SKILL;
string skill_cname() {
  return "如来千叶手";
}

mapping *action = ({
  ([ "action": "$N一式「南海礼佛」，右手虚晃，左手扬起，突然拍向$n的背后二穴！",
    "dodge": 20,
    "parry": -20,
    "force": 200,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N侧身一晃，一式「金玉瓦砾」，左手拿向$n的肩头，右拳打向$p的胸口！",
    "dodge": -30,
    "parry": -30,
    "force": 100,

    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N一式「人命呼吸」，右手环拢成爪，一出手就向扣$n的咽喉要害！",
    "dodge": -30,
    "parry": -30,
    "force": 150,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N左手虚招，右掌直立，一式「镜里观影」，错步飘出，疾拍$n的面门！",
    "dodge": -30,
    "parry": -30,
    "force": 200,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N使一式「水中捉月」，左拳上格，右手探底突出，抓向$n的裆部！",
    "dodge": -30,
    "parry": 70,
    "force": 500,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N双拳挥舞，一式「浮云去来」，两手环扣，拢成圈状，猛击$n的下颌！",
    "dodge": -30,
    "parry": 20,
    "force": 200,

    "damage_type": "瘀伤"
  ]),
});


int valid_learn(object me) {
  if ((int)me->query("force") < 200)
    return notify_fail("你的内功修为不够，无法修习更高深的如来千叶手。\n");
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练如来千叶手必须空手。\n");
  return 1;
}

int valid_enable(string usage) {
  return usage == "unarmed";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}
string *parry_msg = ({
  "$n以守为攻，猛击$N握$w的手腕。\n",
});

string *unarmed_parry_msg = ({
  "$n左掌击下，右掌自保，将$N封于尺外。\n",

});

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int practice_skill(object me) {

  if ((int)me->query("kee") < 40)
    return notify_fail("你的体力不够练, 还是先休息休息吧。\n");
  me->receive_damage("kee", 40);
  return 1;
}
int effective_level() { return 19; }

int learn_bonus() {
  return 10;
}
int practice_bonus() {
  return 10;
}
int black_white_ness() {
  return 20;
}
string perform_action_file(string action) {
  return CLASS_D("shaolin") + "/strike/qianyeshou/" + action;
}
