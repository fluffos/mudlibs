// 【神工鬼斧】
#include <ansi.h>;

inherit SKILL;
string skill_cname() {
  return "神工鬼斧";
}
mapping *action = ({
  ([ "action":
    "$N大喝一声，施展一招「开山」，手中$w带着这一吼的威猛之势，朝$n当头劈下",
    "damage": 45,
    "dodge": 20,
    "parry": -15,
    "post_action": (: call_other, WEAPON_D, "bash_weapon" :),
    "damage_type": "劈伤",
    "name": "开山",
  ]),
  ([ "action":
    "$N施展一招「破玉」，顺势带过大斧，趁$n一愣之际，以斧尾护手刀向$n面门疾戳",
    "damage": 25,
    "dodge": 20,
    "parry": -15,
    "post_action": (: call_other, WEAPON_D, "bash_weapon" :),
    "damage_type": "刺伤",
    "name": "破玉",
  ]),
  ([ "action":
    "$N施展一招「劈石」，翻转斧头，手中$w划出一道银弧，奔着$n的脑袋横劈",
    "damage": 40,
    "dodge": 20,
    "parry": -15,
    "post_action": (: call_other, WEAPON_D, "bash_weapon" :),
    "damage_type": "劈伤",
    "name": "劈石",
  ]),
  ([ "action":
    "$N施展一招「精雕细琢」，趁$n换招中的空隙，以斧尾护手刀向$n的$l狠狠戳了下去",
    "damage": 30,
    "dodge": -20,
    "parry": 15,
    "damage_type": "刺伤",
    "name": "精雕细琢",
  ]),
});

mapping last_action1 = ([ "action":
  BLU "$N手中$w在半空来回拖动，划出一道暗赤光华，一招「劈石破玉雕琢斧」，连劈带刺袭向$n的$l" NOR,
  "dodge": -90,
  "parry": -90,
  "damage": 90,
  "damage_type": "割伤"
]);

mapping last_action2 = ([ "action":
  HIB "$N使出「三神五鬼开山斧」，$w在黑暗中带着一片鬼神的呼啸声横扫向$n的$l" NOR,
  "dodge": -30,
  "parry": -30,
  "damage": 120,
  "damage_type": "刺伤"
]);

int valid_learn(object me) {
  object ob;

  if ((string)me->query_skill_mapped("force") != "guiyu_force")
    return notify_fail("神工鬼斧需配合鬼蜮秘技才可发挥威力。\n");
  if ((int)me->query("max_force") < 100)
    return notify_fail("你的内力不够，无法随意挥动一柄大斧。\n");
  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "axe")
    return notify_fail("手里没有斧头怎么能领悟师父所教的奥妙呢？\n");
  return 1;
}
int effective_level() { return 11; }

int valid_enable(string usage) {
  return (usage == "axe") || (usage == "parry");
}
mapping query_action(object me, object weapon) {
  int total = 2, current;

  if (NATURE_D->query_brightness() < 30)
    return last_action2;
  if (NATURE_D->query_brightness() < 50)
    return last_action1;

  if (me->query_skill("shengui_axe", 1) > 60)
    total = 3;
  return action[random(total)];
}

int practice_skill(object me) {
  object weapon;

  if ((string)me->query_skill_mapped("force") != "guiyu_force")
    return notify_fail("神工鬼斧需配合鬼蜮秘技才可发挥威力。\n");
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "axe")
    return notify_fail("手中无斧，如何练习斧法？\n");

  if ((int)me->query("kee") < 50
    || (int)me->query("force") < 30)
    return notify_fail("你的体力不够练神工鬼斧，还是先休息休息吧。\n");
  me->receive_damage("kee", 50);
  me->add("force", -30);
  write("你按着所学练了一遍神工鬼斧。\n");
  return 1;
}

string perform_action_file(string action) {
  return CLASS_D("egui") + "/shengui_axe/" + action;
}

void skill_improved(object me) {
  if ((int)me->query_skill("shengui_axe", 1) % 10 == 0) {
    tell_object(me, "\n你练斧过勤，受了点内伤。");
    me->add("max_force", -(int)(me->query_skill("shengui_axe", 1) / 10));
  }
  return;
}

