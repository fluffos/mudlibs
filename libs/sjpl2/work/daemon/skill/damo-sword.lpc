// damo-sword.c

inherit SKILL;
string skill_cname() {
  return "达摩剑法";
}

mapping *action = ({
  ([ "action":
    "$N手中$w斜指苍天，剑芒吞吐，一式「云绕嵩岳顶」，对准$n的$l斜斜击出！",
    "dodge": -60,
    "parry": -70,
    "damage": 50,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N合掌跌坐，一式「峦回少室峰」，$w自怀中跃出，如疾电般射向$n的$l",
    "dodge": -50,
    "parry": -40,
    "damage": 70,
    "damage_type": "割伤"
  ]),
  ([ "action":
    "$N手中$w中宫直进，一式「草垂仙露降」，无声无息地对准$n的$l刺出一剑！",
    "dodge": -40,
    "parry": -60,
    "damage": 50,
    "damage_type": "割伤"
  ]),
  ([ "action":
    "$N错步上前，使出「林静佛日升」，剑意若有若无，$w淡淡地向$n的$l挥去！",
    "dodge": -80,
    "parry": -50,
    "damage": 70,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N左指凌空虚点，右手$w逼出丈许雪亮剑芒，一式「慈悲亦降魔」刺向$n的$l！",
    "dodge": -100,
    "parry": -120,
    "damage": 130,
    "damage_type": "刺伤"
  ]),
});

int valid_learn(object me) {
  object ob;

  if ((int)me->query("max_force") < 1000)
    return notify_fail("你的内力不够，没有办法练达摩剑法。\n");

  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword")
    return notify_fail("你必须先找一把剑才能练达摩剑法。\n");

  return 1;
}

int valid_enable(string usage) {
  return usage == "sword" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 30
    || (int)me->query("force") < 3)
    return notify_fail("你的内力或气不够，没有办法练习达摩剑法。\n");
  me->receive_damage("kee", 30);
  me->add("force", -5);
  write("你按著所学练了一遍达摩剑法。\n");
  return 1;
}

string perform_action_file(string action) {
  return CLASS_D("shaolin") + "/sword/damo-sword/" + action;
}

string *parry_msg = ({
  "只听见「锵」一声，$n手中的$v荡开了$N的$w。\n",
  "$n挥动手中$v连消带打，令$N的$w无法靠近。\n",
  "$n手中的$v化做一团寒光，荡开了$N的$w。\n",
  "结果「当」地一声，被$n手中的$v格开了。\n",
});

string *unarmed_parry_msg = ({
  "$n将手中的$v舞得密不透风，封住了$N的攻势。\n",
  "$n不退反进，$v直刺$N的双手。\n",
  "$n将手中的$v一抖，迫得$N连连后退。\n",
});
int effective_level() { return 17; }

int learn_bonus() {
  return 0;
}
int practice_bonus() {
  return 0;
}
int black_white_ness() {
  return 20;
}

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}
