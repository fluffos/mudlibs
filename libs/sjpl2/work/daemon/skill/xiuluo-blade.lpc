//修罗狂刀
#include <ansi.h>
inherit SKILL;
string skill_cname() {
  return "修罗绝命刀法";
}

mapping *action = ({
  ([ "action": "$N藏刀内收，刀锋自下而上划了个半弧，向$n的$l挥去",
    "damage": 60,
    "dodge": 100,
    "parry": 50,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N左掌虚托右肘，手中$w笔直划向$n的$l",
    "damage": 70,
    "dodge": 100,
    "parry": 100,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N右手反执刀柄，猛一挫身，$w直向$n的颈中斩去",
    "damage": 80,
    "dodge": 50,
    "parry": 50,
    "damage_type": "割伤",
  ]),
  ([ "action": "$N手中$w一颤，无数刀尖化作点点繁星，向$n的$l挑去",
    "damage": 90,
    "dodge": 100,
    "parry": 50,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N手中$w划出一个大平十字，向$n纵横劈去",
    "damage": 100,
    "dodge": 150,
    "parry": 150,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N手中$w的刀光仿佛化成一簇簇烈焰，将$n团团围绕",
    "damage": 110,
    "dodge": 100,
    "parry": 200,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N刀尖平指，一片片切骨刀气如飓风般裹向$n的全身",
    "damage": 120,
    "dodge": -50,
    "parry": 250,
    "damage_type": "割伤"
  ]),
});

int valid_learn(object me) {
  if ((int)me->query_skill("force", 1) < 50)
    return notify_fail("你的内功心法火候不足，无法练修罗刀法。\n");
  if ((int)me->query("max_force") < 200)
    return notify_fail("你的内力不足，无法练修罗刀法。\n");
  if ((int)me->query_skill("blade", 1) < 150)
    return notify_fail("你的基本刀法火候不足，无法参悟修罗刀法。\n");
  return 1;
}

int valid_enable(string usage) {
  return (usage == "blade") || (usage == "parry");
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
    return notify_fail("你必须先找一把刀，才能练刀法。\n");
  if ((int)me->query("kee") < 40)
    return notify_fail("你的体力不够练这门刀法，还是先休息休息吧。\n");
  me->receive_damage("kee", 40);
  return 1;
}

int effective_level() { return 25; }

string *parry_msg = ({
  "$n使出修罗狂刀中的“魔障无边”，手中的$v化成九重刀幕护住全身。\n",
});

string *unarmed_parry_msg = ({
  "$n使出修罗狂刀中的“魔障无边”，手中的$v化成九重刀幕护住全身。\n",
});

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int learn_bonus() {
  return -100;
}

int practice_bonus() {
  return -500;
}

int black_white_ness() {
  return 70;
}

string perform_action_file(string action) {
  return CLASS_D("mojiao") + "/xiuluo-blade/" + action;
}

void skill_improved(object me) {
  int s;
  s = me->query_skill("xiuluo-blade", 1);
  if (s == 0) return;
  if (s == 1) {
    tell_object(me, HIW "\n修罗刀法乃七指魔君在金顶山一役被人斩断三指后所悟，\n刀法霸道而充满了邪气！\n" NOR);
  }
  if (s == 101)
    tell_object(me, HIW "由于你苦练武功，领悟绝技一刀闪(Perform Yidaoshan)！\n\n" NOR);
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  if (damage_bonus < 110) return 0;
  message_vision(HIG "$N眼中突然映出灼热的神色，透着疯狂的杀气，一时间刀光大盛！！\n" NOR, me);
  victim->receive_damage("gin", damage_bonus, me);
  victim->receive_damage("kee", damage_bonus / 2, me);
  victim->receive_damage("sen", damage_bonus, me);
  me->receive_damage("kee", damage_bonus, victim);
  me->add("bellicosity", 1000);
}
