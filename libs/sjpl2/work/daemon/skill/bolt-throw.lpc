// bolt-throw.c

#include <ansi.h>;
inherit SKILL;
string skill_cname() {
  return "青电紫雷";
}

mapping *action = ({
  ([ "action":
    "$N一挥手，一枚$w向$n的$l激射过去",
    "dodge": -20,
    "damage": 40,
    "damage_type": "刺伤",
    "post_action": (: call_other, WEAPON_D, "throw_weapon" :),
  ]),
  ([ "action":
    "$N中指轻弹，伴随着一阵破空之声，$w直飞向$n",
    "dodge": -20,
    "damage": 30,
    "damage_type": "刺伤",
    "post_action": (: call_other, WEAPON_D, "throw_weapon" :),
  ]),
});

int valid_learn(object me) {
  object ob;

  if ((int)me->query("max_force") < 800)
    return notify_fail("你的内力不够，无法练习青电紫雷。\n");

  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "throwing")
    return notify_fail("你身上没带有暗器，无法练习青电紫雷。\n");

  return 1;
}

int valid_enable(string usage) {
  return usage == "throwing";
}

mapping query_action(object me) {

  object qizi, weapon;
  int sk, i, amount;
  sk = (int)me->query_skill("bolt-throw", 1);
  qizi = present("yushi qizi", me);
  amount = (int)qizi->query_amount();
  weapon = me->query_temp("weapon");

  if ((string)weapon->query("id") != "yushi qizi")
    return action[random(sizeof(action))];

  if (sk > 120 && amount > 32) i = random(10);
  else if (sk > 90 && amount > 32) i = random(9);
  else if (sk > 60 && amount > 16) i = random(7);
  else if (sk > 30 && amount > 8) i = random(4);
  else if (amount > 4) i = random(2);
  else return action[random(sizeof(action))];
  switch (i) {
    case 0:
      qizi->add_amount(-4);
      return ([
        "action":  //4
        "$N身子一转，幌然之间，手上已扣了四枚$w，随即一挥手，一招「四雷齐发」，$w便向$n电射而去",
        "dodge": 30,
        "damage": 100,
        "damage_type": "刺伤"
      ]);
    case 1:
      qizi->add_amount(-4);
      return ([
        "action":  //4
        "$N中指连弹，一招「四雷齐发」，两青两紫，四道光芒，立时激射而出，带起凌厉无比的破空之声",
        "dodge": 50,
        "damage": 100,
        "damage_type": "刺伤"
      ]);
    case 2:
      qizi->add_amount(-8);
      return ([  //8
      "action":
        "忽听得$N哈哈大笑，同时“嗤嗤”连声，从$N手中飞出八道光芒来，化作一张青紫二色，交组二成的大网，向$n罩去",
        "dodge": 60,
        "damage": 140,
        "damage_type": "刺伤"
      ]);
    case 3:
      qizi->add_amount(-8);
      return ([
        "action":  //8
        "$N力透掌心，手腕一翻，使了招「八卦互生」，八枚$w，陡地化为八道冷电，向$n电射而出",
        "dodge": 40,
        "damage": 140,
        "damage_type": "刺伤"
      ]);
    case 4:
      qizi->add_amount(-16);
      return ([
        "action":  //16
        "$N中指连弹，一招「青电霍霍」，十六枚$w顿时飞射而出，如十六条猛龙，交剪电射，漫空飞舞，只向$n罩去",
        "dodge": 60,
        "damage": 180,
        "damage_type": "刺伤"
      ]);
    case 5:
      qizi->add_amount(-16);
      return ([
        "action":  //16
        "$N踏前一步，手扬处，一招「青电闪闪」，顿时只见十六道青色光华，星芒流转，一起向$n急袭而出",
        "dodge": 50,
        "damage": 180,
        "damage_type": "刺伤"
      ]);
    case 6:
      qizi->add_amount(-16);
      return ([
        "action":  //16
        "$N一招「紫雷隆隆」，五指连弹，已然弹出十六枚$w，似十六道紫色光华，又如一片紫云，飞向$n",
        "dodge": 80,
        "damage": 170,
        "damage_type": "刺伤"
      ]);
    case 7:
      qizi->add_amount(-32);
      return ([
        "action":  //32
        "$N往怀里一探，已然抓了三十二枚$w在手中，紧接着右手一挥，一招「电光石火」，将手中$w一起电射而出",
        "dodge": 80,
        "damage": 210,
        "damage_type": "刺伤"
      ]);
    case 8:
      qizi->add_amount(-32);
      return ([
        "action":  //32 
        "$N左手一挥，手扬处，一招「雷动九天」，三十二枚$w，已然挟着极锐利的破空之声，直向$n飞去。",
        "dodge": 30,
        "damage": 230,
        "damage_type": "刺伤"
      ]);
    case 9:
      qizi->add_amount(-1);
      return ([
        "action":  //1
        "$N身形微侧，中指一弹，“铮”地一声，一招「一片混沌」，一枚$w疾如紫电，直射$n的$l",
        "dodge": 100,
        "damage": 250,
        "damage_type": "刺伤"
      ]);
  }
}

int practice_skill(object me) {
  return notify_fail("青电紫雷只能通过学习秘籍来提高。\n");
}

string perform_action_file(string action) {
  return CLASS_D("huashan") + "/bolt-throw/" + action;
}
int effective_level() {
  return 18;
}

int learn_bonus() {
  return -10;
}
int black_white_ness() {
  return 70;
}
void skill_improved(object me) {
  int sk = (int)me->query_skill("bolt-throw", 1);

  if (sk == 30) {
    tell_object(me, HIC "你可以一次弹出八枚棋子了！\n" NOR);
    return;
  }
  if (sk == 60) {
    tell_object(me, HIC "你可以一次弹出十六枚棋子了！\n" NOR);
    return;
  }
  if (sk == 90) {
    tell_object(me, HIC "你可以一次弹出三十二枚棋子了！\n" NOR);
    return;
  }
  if (sk == 120) {
    tell_object(me, HIC "你可以使用青电紫雷中最高深招式「一片混沌」的了！\n" NOR);
    return;
  }
}
