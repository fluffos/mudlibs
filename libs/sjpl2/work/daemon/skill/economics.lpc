//治国之方

#include <ansi.h>

inherit SKILL;
string skill_cname() {
  return "治国之方";
}

string type() { return "knowledge"; }
int valid_enable(string usage) { return usage == "literate"; }

void skill_improved(object me) {
  int s;

  s = me->query_skill("economics", 1);
  if ((int)me->query("score") < s / 5) {
    tell_object(me, HIW "由於你勤学治国之方，你的声望提高了。\n" NOR);
    me->add("score", 100);
  }
}
int effective_level() {
  return 20;
}

int learn_bonus() {
  return 20;
}
int practice_bonus() {
  return 0;
}
int black_white_ness() {
  return 0;
}
