// dragon_strike.c龙舞九天手

inherit SKILL;
string skill_cname() {
  return "龙舞九天手";
}

mapping *action = ({
  ([ "action":
    "$N使一招「乱石穿空」, 两只手掌上下翻飞, 击向$n的$l",
    "dodge": 0,
    "parry": -30,
    "force": 80,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N使一招「惊涛拍岸」, 双掌带着隆隆雷声, 撞向$n的$l",
    "dodge": -20,
    "parry": -30,
    "force": 100,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N左手一个虚晃, 右手从肋下穿出, 使一招「樯橹灰飞烟灭」击向$n的$l",
    "dodge": -20,
    "parry": -30,
    "force": 100,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N长身而立, 目光忧郁地射向远方, 左手衣袖轻轻一挥, $n只觉得一股劲风\n"
    "迎面扑来, 击向自己的$l, 好一招「故垒西边」",
    "dodge": -100,
    "damage": 20,
    "parry": -30,
    "force": 100,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N使一招「卷起千堆雪」击向$n的$l, $n只觉得满天都是掌影, 尽不知其来\n"
    "自何处击向何处!",
    "dodge": -50,
    "damage": 60,
    "parry": -50,
    "force": 150,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N悠闲地举起右手, 使一招「还酹江月」默默地拍向$n的$l",
    "dodge": 20,
    "parry": -30,
    "force": 100,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N大吼一声, 腾空而起, 攻向$n的$l. 只见铺天盖地都是$N的人影\n"
    "正是龙舞九天手中的杀着「多少英雄人物」",
    "dodge": -100,
    "parry": -50,
    "force": 200,
    "damage_type": "瘀伤"
  ]),

});

