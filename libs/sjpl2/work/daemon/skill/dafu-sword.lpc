// dafu-sword.c五大夫剑

inherit SKILL;
string skill_cname() {
  return "五大夫剑";
}

mapping *action = ({
  ([ "action":
    "$N忽然使一招「登峰观日」，箭步飞出，手中$w自下而上刺向$n的$l！",
    "dodge": -30,
    "damage": 40,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N使出泰山剑法中的「泰山云海」，剑气如潮，手中$w泛出阵阵银光，从四面八方斩向$n的$l！",
    "dodge": -50,
    "damage": 80,
    "damage_type": "割伤"
  ]),
  ([ "action":
    "$N一招「七星拜月」，身形恍惚如鬼魅，手中$w快捷无比的斩向$n周身的七处大穴！",
    "dodge": -40,
    "damage": 70,
    "damage_type": "割伤"
  ]),
  ([ "action":
    "$N手中$w忽的挽出几朵剑花，银光星星点点，一式「碧霞佛光」顿时将$n的$l笼罩在茫茫剑影之中！",
    "dodge": -40,
    "damage": 70,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N身子一矮，向左飘出数尺，手中$w一招「峻岭横空」对准$n的$l斜斜刺出一剑！",
    "dodge": -20,
    "damage": 40,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N左手单掌虚晃，右手$w立即飞出，一招「苍松迎客」快不可当的向$n的$l连刺数剑！",
    "dodge": -10,
    "damage": 40,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N凝神不动，举光远眺，忽然右手$w斜指，使一招「石关回马」正好对准$n$l刺到！",
    "dodge": -50,
    "damage": 80,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N剑锋指地，安然不动，忽然身形爆起，手中$w，使一招「九雷落地」九道光箭直刺向$n的$l",
    "dodge": -80,
    "damage": 150,
    "damage_type": "割伤"
  ]),
});

/* 学习和联系技能的条件 */
int valid_learn(object me) {
  object ob;

  if ((int)me->query("max_force") < 50)
    return notify_fail("你的内力不够，没有办法练泰山剑法。\n");

  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword")
    return notify_fail("你必须先找一把剑才能练剑法。\n");

  return 1;
}

/* 这种武功可以 enable 为 sword 和 parry */
int valid_enable(string usage) {
  return usage == "sword" || usage == "parry";
}

/* 不用修改 */
mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

/* 练习提高技能的条件: 通常是消耗气和内力*/
int practice_skill(object me) {
  if ((int)me->query("kee") < 30
    || (int)me->query("force") < 3)
    return notify_fail("你的内力或气不够，没有办法练习泰山剑法。\n");
  me->receive_damage("kee", 30);
  me->add("force", -3);
  write("你按著所学练了一遍泰山剑法。\n");
  return 1;
}

/* 定义特殊招式存放的目录 */
string perform_action_file(string action) {
  return CLASS_D("taishan") + "/ts-sword/" + action;
}
/* 当对方有兵器时的招架信息 (不同的武功最好不同)*/
string *parry_msg = ({
  "只听见「锵」一声，$n手中的$v荡开了$N的$w。\n",
  "$n挥动手中$v连削带打，令$N的$w无法靠近。\n",
  "$n手中的$v化做一团寒光，荡开了$N的$w。\n",
  "结果「当」地一声，被$n手中的$v格开了。\n",
});

/* 当对方无兵器时的招架信息 */
string *unarmed_parry_msg = ({
  "$n将手中的$v舞得密不透风，封住了$N的攻势。\n",
  "$n不退反进，$v直刺$N的双手。\n",
  "$n将手中的$v一抖，迫得$N连连后退。\n",
});

/* 请求招架信息  (无须修改）*/
string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int learn_bonus() {
  return -50;
}
int practice_bonus() {
  return -50;
}
int black_white_ness() {
  return -50;
}
