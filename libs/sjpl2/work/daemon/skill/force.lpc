// force.c

#include <ansi.h>

inherit SKILL;
string skill_cname() {
  return "基本内功";
}

string exert_function_file(string func) {
  return "/d/force/" + func;
}

void skill_improved(object me) {
  int s;

  s = me->query_skill("force", 1);
  if ((int)me->query("con") < s / 4) {
    tell_object(me, HIW
      "由於你的内功修炼有成，你的体质改善了。\n" NOR);
    me->add("con", 1);
  }
}
int valid_learn(object me) {
  if ((int)me->query("p_power_rank") < (int)me->query_skill("force", 1) * 3
    && (int)me->query_skill("force", 1) > 30)
    return notify_fail("你的武学积累不足，没有办法领会更高的内功修炼之法。\n");
  return 1;
}

int learn_bonus() {
  return 0;
}
int practice_bonus() {
  return 0;
}
int black_white_ness() {
  return 0;
}
