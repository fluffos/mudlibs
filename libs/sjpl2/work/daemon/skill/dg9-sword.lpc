// dugu-9sword 独孤九剑

inherit SKILL;
object offensive_target(object me);
string skill_cname() {
  return "独孤九剑";
}

mapping *action_hit = ({               //偷袭
([ "action":
  "$N乘$n不备，手中$w突然化作万点寒星激射而出，袭向$n的全身",
  "dodge": -20,
  "damage": 100,
  "damage_type": "刺伤"
]),
  ([ "action":
    "$N$w一抖，闪电般刺出一百零八剑，全部刺向$n的全身的要害",
    "dodge": -20,
    "damage": 100,
    "damage_type": "刺伤"
  ]),
});

mapping *action_sword = ({  //破剑式
([ "action":
  "$N运起「破剑式」，乱无章地向$n接连刺出数剑，却剑剑攻的是$n剑法的破绽",
  "dodge": 20,
  "damage": 100,
  "damage_type": "刺伤"
]),
  ([ "action":
    "$N一眼便看出$n剑招中的破绽，口中大喝一声「破剑式」！，剑尖斜挑，缓慢地刺向$n的$l",
    "dodge": 40,
    "damage": 150,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N提剑向$n$l刺去，这一剑出招并不迅捷，但部位却妙到巅毫，正是「破剑式」中的绝招",
    "dodge": 60,
    "damage": 180,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N$w倒挑，刷的一声，剑锋贴着$n的剑锋斜削而上，「破剑式」",
    "dodge": 30,
    "damage": 250,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N一式「破剑式」，$w轻扬，飘身而进，姿态飘飘若仙，剑锋向$n的$l连点数点",
    "dodge": 30,
    "damage": 250,
    "damage_type": "刺伤"
  ]),
});

mapping *action_blade = ({  //破刀式
([ "action":
  "$N一式「破刀式」，剑尖轻颤，竟然从$n刀法的破绽处直刺过去",
  "dodge": -20,
  "damage": 80,
  "damage_type": "刺伤"
]),
  ([ "dodge": 70,
    "damage": 220,
    "damage_type": "刺伤"
  ]),
});

mapping *action_staff = ({  //破枪式
([ "action":
  "$N一式「破枪式」，剑法突变，剑势伸缩不定，奔腾矫夭，刺向$n",
  "dodge": 20,
  "damage": 100,
  "damage_type": "刺伤"
]),
  ([ "action":
    "$N举剑画弧，潜运独孤九剑之「破枪式」, 绵绵剑意，漫天铺地袭向$n",
    "dodge": 50,
    "damage": 150,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N剑随身转，续而刺出十九剑，招招攻都是$n的破绽，但奇的是这十九\n剑便如一招，此式「破枪式」真是匪夷所思",
    "dodge": 80,
    "damage": 210,
    "damge_type": "刺伤"
  ]),
  ([ "action":
    "$N一式独孤九剑「破枪式」，剑势灵巧地顺着$n手中$v削落，划向$l",  //need modify
    "dodge": 10,
    "damage": 230,
    "damage_type": "割伤"
  ]),
});

mapping *action_hammer = ({  //破鞭式
([ "action":
  "$N一式「破鞭式」，剑势中已发出隐隐风声，$N出剑越来越快，风声也是渐响",
  "dodge": 20,
  "damage": 100,
  "damage_type": "刺伤"
]),
  ([ "action":
    "$N早料到此着，右臂轻提，$w提起了两尺，剑尖一抬，一式「破鞭式」指向$n$l",
    "dodge": 50,
    "damage": 150,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N运起「破鞭式」，右手捏着剑诀，左手$w不住抖动，突然平刺，剑尖急颤，看不出攻向何处",
    "dodge": 80,
    "damage": 210,
    "damge_type": "刺伤"
  ]),
  ([ "action":
    "$N静心运气，一式「破鞭式」，$w凝在空中停得片刻，只是缓缓向$n移去",
    "dodge": 10,
    "damage": 230,
    "damage_type": "刺伤"
  ]),
});

mapping *action_whip = ({  //破索式
([ "action":
  "$N$w连划三个弧形，从$n的破绽之出伸出，向$n的$l斩落，好一式「破索式」",
  "dodge": 20,
  "damage": 100,
  "damage_type": "刺伤"
]),
  ([ "action":
    "$N突然一剑点向$n的$l，虽一剑却暗藏无数后着，乃是「破索式」中的一招",
    "dodge": 50,
    "damage": 150,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "突然之间，$N一喝「破索式」，剑交右手，寒光一闪，向$N$l划出。这一下快速无伦",
    "dodge": 80,
    "damage": 210,
    "damge_type": "割伤"
  ]),
  ([ "action":
    "$N手中$w递出，对准了$n$l。这一剑方位时刻，拿捏得妙到颠毫，正是「破索式」中的妙招",
    "dodge": 10,
    "damage": 230,
    "damage_type": "刺伤"
  ]),
});
mapping *action_throwing = ({  //破箭式
([ "action":
  "$N丝毫不理会满天暗器，运起「破箭式」，$w在身前连划三个圆圈，幻作三个光圈，向$n罩去",
  "dodge": 20,
  "damage": 100,
  "damage_type": "刺伤"
]),
  ([ "action":
    "$N剑法变化繁复，$w东刺西削，使人眼花缭乱，一式「破箭式」，直刺向$n",
    "dodge": 50,
    "damage": 150,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N使出「破箭式」，左手$w缓缓向前划出，成一弧形。$l只觉一股森森寒气，直逼过来",
    "dodge": 80,
    "damage": 210,
    "damge_type": "割伤"
  ]),
  ([ "action":
    "$N$w倏出，使出“独孤九剑”的「破箭式」，剑尖颤动，向$n的$l点去。",
    "dodge": 80,
    "damage": 210,
    "damge_type": "割伤"
  ]),
});
mapping *action_unarmed = ({  //破掌式
([ "action":
  "$N将$w随手一摆，但见$n竟然自己将手掌送了上来，使的正是「破掌式」的绝招之一",
  "dodge": 40,
  "damage": 120,
  "damage_type": "刺伤"
]),
  ([ "action":
    "但见$N不闪不避，举剑闪电般使出「破掌式」中的一招，反削$n的$l",
    "dodge": 20,
    "damage": 160,
    "damage_type": "割伤"
  ]),
  ([ "action":
    "$N运起「破掌式」，只进不退，凝神运气向$n猛攻快打地挥出三剑",
    "dodge": -10,
    "damage": 200,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N使出独孤九剑之「破掌式」, 将劲力聚在剑尖，以意使剑，直刺$n",
    "dodge": -30,
    "damage": 260,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N$w慢慢指出，突然间在空中一颤，发出嗡嗡之声，跟着便是嗡嗡两剑，直刺$n，使的正是「破掌式」",
    "dodge": 10,
    "damage": 230,
    "damage_type": "刺伤"
  ]),
});

mapping last_action = ([ "action":  //last action
"$N轻吁一口长气，斜斜刺出一剑，这一剑不属于任何招数，甚至也不是\n"
  "「独孤九剑」中的剑法，剑尖歪斜，出剑全然无力，根本不知指向何方",
  "dodge": 80,
  "damage": 550,
  "damage_type": "刺伤"
]);
// 总决式是练习，破气式只在perform中
int valid_learn(object me) {
  object ob;
  int max_force = me->query("max_force");

  if ((int)me->query_skill("dg9-sword", 1) == 149)
    return notify_fail("李志平叹了口气，你的所学似乎已经到了瓶颈，若无法参透“无招胜有招”，恐怕无法再提高了。\n");
  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword")
    return notify_fail("你必须先找一把剑才能学独孤九剑。\n");

  return 1;
}
int valid_enable(string usage) {
  return usage == "sword";
}
mapping query_action(object me, object weapon) {
  object target;
  target = offensive_target(me);

  if (!target)        //偷袭
    return action_hit[random(sizeof(action_hit))];

  if (objectp(weapon = target->query_temp("weapon"))
    && (string)weapon->query("skill_type") == "sword") {  //对手如果使剑，用破剑式
    if ((int)me->query_skill("dg9-sword", 1) >= 150 && random(3) > 1)
      return last_action;    //last action
      return action_sword[random(sizeof(action_sword))];
  }

  if (objectp(weapon = target->query_temp("weapon"))
    && (string)weapon->query("skill_type") == "blade") {   //对手如果使刀，用破刀式
    if ((int)me->query_skill("dg9-sword", 1) >= 150 && random(3) > 1)
      return last_action;    //last action
      return action_blade[random(sizeof(action_blade))];
  }

  if (objectp(weapon = target->query_temp("weapon"))
    && ((string)weapon->query("skill_type") == "staff"  //对手如果使长兵刃，用破枪式
    || (string)weapon->query("skill_type") == "stick"
      || (string)weapon->query("skill_type") == "fork"
      || (string)weapon->query("skill_type") == "spear")) {
    if ((int)me->query_skill("dg9-sword", 1) >= 150 && random(3) > 1)
      return last_action;    //last action
      return action_staff[random(sizeof(action_staff))];
  }

  if (objectp(weapon = target->query_temp("weapon"))
    && ((string)weapon->query("skill_type") == "hammer"   //对手如果使短兵刃，用破鞭式
    || (string)weapon->query("skill_type") == "axe"
      || (string)weapon->query("skill_type") == "dagger")) {
    if ((int)me->query_skill("dg9-sword", 1) >= 150 && random(3) > 1)
      return last_action;    //last action
      return action_hammer[random(sizeof(action_hammer))];
  }

  if (objectp(weapon = target->query_temp("weapon"))
    && (string)weapon->query("skill_type") == "whip") {   //对手如果使鞭，用破索式
    if ((int)me->query_skill("dg9-sword", 1) >= 150 && random(3) > 1)
      return last_action;    //last action
      return action_whip[random(sizeof(action_whip))];
  }

  if (objectp(weapon = target->query_temp("weapon"))
    && (string)weapon->query("skill_type") == "throwing") {  //对手如果使暗器，用破箭式
    if ((int)me->query_skill("dg9-sword", 1) >= 150 && random(3) > 1)
      return last_action;    //last action
      return action_throwing[random(sizeof(action_throwing))];
  }

  if (!objectp(weapon = target->query_temp("weapon"))) {  //对手如果没有武器，用破掌式
    if ((int)me->query_skill("dg9-sword", 1) >= 150 && random(3) > 1)
      return last_action;    //last action
      return action_unarmed[random(sizeof(action_unarmed))];
  }
}

int practice_skill(object me) {
  int sk = me->query_skill("dg9-sword", 1);
  if (sk < 100)
    return notify_fail("以你现在的所学，还没有办法自己练习独孤九剑。\n");
  if (sk == 149)
    return notify_fail("你的所学似乎已经达到了瓶颈，无法继续练习下去。\n");
  if ((int)me->query("kee") < 40 || (int)me->query("force") < 10)
    return notify_fail("你的内力或气不够，没有办法操练「总决式」。\n");
  me->receive_damage("kee", 40);
  me->add("force", -10);
  write("你按着「总决式」将独孤九剑操练了一遍。\n");
  return 1;
}
string perform_action_file(string action) {
  return CLASS_D("huashan") + "/dg9-sword/" + action;
}
int effective_level() { return 19; }
int learn_bonus() {
  return 0;
}
int practice_bonus() {
  int sk = this_player()->query_skill("dg9-sword", 1);
  if (sk < 150) return -70;
  else return 20;
}
int black_white_ness() {
  return 40;
}
void skill_improved(object me) {
  if ((int)me->query_skill("dg9-sword", 1) == 100) {
    tell_object(me, "你学会了「总决式」！以后可以通过练习(practic)来提高了。\n");
    return;
  }
}
object offensive_target(object me) {
  int sz;
  object *enemy;

  enemy = me->query_enemy();
  if (!enemy || !arrayp(enemy)) return 0;

  sz = sizeof(enemy);
  if (sz > 4) sz = 4;

  if (sz > 0) return enemy[random(sz)];
  else return 0;

}
