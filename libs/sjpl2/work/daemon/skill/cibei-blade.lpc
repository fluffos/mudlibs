// cibei-blade.c 慈悲刀法

inherit SKILL;
string skill_cname() {
  return "慈悲刀法";
}

mapping *action = ({
  ([ "action": "$N手中$w斜指，一招「穿云破雾」，反身一顿，一刀向$n的$l撩去！",
    "dodge": -30,
    "parry": -40,
    "damage": 60,
    "force": 200,
    //		"post_action":  (: call_other, PARRY_D, "bash_weapon" :),
    "damage_type": "割伤"
  ]),
  ([ "action": "$N一招「推山揽海」，左右腿虚点，$w一提一收，平刃挥向$n的$l！",
    "dodge": -40,
    "parry": -30,
    "damage": 50,
    "force": 150,
    //		"post_action":  (: call_other, PARRY_D, "bash_weapon" :),
    "damage_type": "割伤"
  ]),
  ([ "action": "$N展身虚步，提腰跃落，一招「开天辟地」，刀锋一卷，拦腰斩向$n！",
    "dodge": -60,
    "parry": -20,
    "damage": 80,
    "force": 200,
    //		"post_action":  (: call_other, PARRY_D, "bash_weapon" :),
    "damage_type": "割伤"
  ]),
  ([ "action": "$N一招「风满长空」，$w大开大阖，自上而下划出一个大弧，笔直劈向$n！",
    "dodge": -80,
    "parry": -70,
    "damage": 90,
    "force": 250,
    //		"post_action":  (: call_other, PARRY_D, "bash_weapon" :),
    "damage_type": "割伤"
  ]),
  ([ "action": "$N手中$w一沉，一招「彩虹贯日」，双手持刃拦腰反切，劈向$n的$l！",
    "dodge": -60,
    "parry": -80,
    "damage": 50,
    "force": 300,
    //		"post_action":  (: call_other, PARRY_D, "bash_weapon" :),
    "damage_type": "割伤"
  ]),
  ([ "action": "$N挥舞$w，使出一招「流星赶月」，上劈下撩，左挡右开，齐齐罩向$n！",
    "dodge": -70,
    "parry": -80,
    "damage": 50,
    "force": 190,
    //		"post_action":  (: call_other, PARRY_D, "bash_weapon" :),
    "damage_type": "割伤"
  ]),
  ([ "action": "$N一招「慈悲为怀」，左脚跃步落地，$w顺势往前，挟风声劈向$n的$l！",
    "dodge": -80,
    "parry": -80,
    "damage": 90,
    "force": 300,
    //		"post_action":  (: call_other, PARRY_D, "bash_weapon" :),
    "damage_type": "割伤"
  ]),
  ([ "action": "$N手中$w画出一个圆弧，一招「霞光满天」，直劈向$n的$l！",
    "dodge": -100,
    "parry": -110,
    "damage": 120,
    "force": 350,
    //		"post_action":  (: call_other, PARRY_D, "bash_weapon" :),
    "damage_type": "割伤"
  ]),
});

int valid_learn(object me) {
  return 1;
}

int valid_enable(string usage) {
  return (usage == "blade") || (usage == "parry");
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
    return notify_fail("你必须先找一把刀，才能练习慈悲刀法。\n");

  if ((int)me->query("kee") < 40)
    return notify_fail("你的体力不够练这门刀法，还是先休息休息吧。\n");
  me->receive_damage("kee", 40);
  return 1;
}

string *parry_msg = ({
  "只听见「锵」一声，$n手中的$v荡开了$N的$w。\n",
  "$n挥动手中$v连消带打，令$N的$w无法靠近。\n",
  "$n手中的$v化做一团寒光，荡开了$N的$w。\n",
  "结果「当」地一声，被$n手中的$v格开了。\n",
});

string *unarmed_parry_msg = ({
  "$n将手中的$v舞得密不透风，封住了$N的攻势。\n",
  "$n不退反进，$v直刺$N的双手。\n",
  "$n将手中的$v一抖，迫得$N连连后退。\n",
});

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}
int effective_level() { return 16; }

int learn_bonus() {
  return -20;
}
int practice_bonus() {
  return -20;
}
int black_white_ness() {
  return -20;
}

string perform_action_file(string action) {
  return CLASS_D("shaolin") + "/blade/cibei-blade/" + action;
}
