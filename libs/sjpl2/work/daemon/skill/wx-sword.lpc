// wx-sword.c 逍遥无相剑法

inherit SKILL;
string skill_cname() {
  return "逍遥无相剑法";
}

mapping *action = ({
  ([ "action":
    "$N一抖手中的$w，几点寒星从不同方位射向$n的$l",
    "dodge": -180,
    "damage": 120,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N手中的$w轻轻地斩向$n，途中忽然剑锋一转，反削$n的$l",
    "dodge": -60,
    "damage": 70,
    "damage_type": "割伤"
  ]),
  ([ "action":
    "只见$N一招「天旋地转」，身子骤然拔起，手挥$w盘旋而下向$n的$l砍去",
    "dodge": -20,
    "damage": 80,
    "damage_type": "割伤"
  ]),
  ([ "action":
    "$N陡然大喝一声,手中$w快如闪电，对准$n的$l猛地刺出一剑",
    "dodge": -40,
    "damage": 90,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N身形一晃，$w飘拂不定，对着$n的$l斜斜刺出一剑",
    "dodge": -40,
    "damage": 110,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N向左边一闪，手中$w反手挑向$n的$l",
    "dodge": -20,
    "damage": 100,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N高高跃起，一招「天外流星」，身剑合一,直刺向$n$l",
    "dodge": 50,
    "damage": 60,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N身形飘忽不定，身体突然化作一道剑光，正是一招「无相无我」直射向$n$l",
    "dodge": -150,
    "parry": -150,
    "damage": 250,
    "damage_type": "刺伤"
  ]),
});

int valid_learn(object me) {
  object ob;

  if ((int)me->query("max_force") < 100)
    return notify_fail("你的内力不够，无法练习逍遥无相剑法。\n");

  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword")
    return notify_fail("你必须先找一把剑才能练剑法。\n");

  return 1;
}
int effective_level() { return 15; }

int valid_enable(string usage) {
  return usage == "sword" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  int skill, combat_exp;

  combat_exp = (int)me->query("combat_exp");
  skill = (int)me->query_skill("tianluo-steps", 1);

  if (skill * skill * skill / 10 > combat_exp)
    return notify_fail("你的实战经验不够，无法练习逍遥无相剑法。\n");


  if ((int)me->query("kee") < 30
    || (int)me->query("force") < 3)
    return notify_fail("你的内力或气不够，无法练习逍遥无相剑法。\n");
  me->receive_damage("kee", 30);
  me->add("force", -3);
  write("你按著所学练了一遍逍遥无相剑法。\n");
  return 1;
}

string perform_action_file(string action) {
  return CLASS_D("xiaoyao") + "/wx-sword/" + action;
}
string *parry_msg = ({
  "只听见「锵」一声，$n手中的$v荡开了$N的$w。\n",
  "$n挥动手中$v连消带打，令$N的$w无法靠近。\n",
  "$n手中的$v化做一团寒光，荡开了$N的$w。\n",
  "结果「当」地一声，被$n手中的$v格开了。\n",
});

string *unarmed_parry_msg = ({
  "$n将手中的$v舞得密不透风，封住了$N的攻势。\n",
  "$n不退反进，$v直刺$N的双手。\n",
  "$n将手中的$v一抖，迫得$N连连后退。\n",
});

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}
