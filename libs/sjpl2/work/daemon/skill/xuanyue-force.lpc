//玄月心法
inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }
string skill_cname() {
  return "玄月心法";
}

int valid_learn(object me) { return 1; }
string force_type() { return "yin_force"; }

int practice_skill(object me) {
  return notify_fail("玄月心法只能用学的，或是从运用(exert)中增加熟练度。\n");
}

string exert_function_file(string func) {
  return CLASS_D("luoyue") + "/xuanyue-force/" + func;
}
int effective_level() { return 20; }

int learn_bonus() {
  return 20;
}
int black_white_ness() {
  return 20;
}
