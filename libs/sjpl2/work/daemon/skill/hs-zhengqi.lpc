// hs-zhengqi.c

#include <ansi.h>
inherit SKILL;

string skill_cname() {
  return "华山正气诀";
}

void create() { seteuid(getuid()); }

string type() { return "knowledge"; }

int practice_skill(object me) {
  return notify_fail("华山正气诀只能靠学(learn)来提高。\n");
}
void skill_improved(object me) {
  int s;
  //	tell_object(me, HIR "你心里鼓荡着一股侠义之气！\n" NOR );
  //	me->add("daode", 200);

  s = me->query_skill("hs-zhengqi", 1);
  if (s % 10 == 9 && (int)me->query("cps") < s / 4) {
    tell_object(me, HIW "由於你勤练华山正气诀，你的定力提高了。\n" NOR);
    me->add("cps", 1 + random(2));
  }
}
int learn_bonus() {
  return 0;
}
int practice_bonus() {
  return 0;
}
int black_white_ness() {
  return 0;
}
