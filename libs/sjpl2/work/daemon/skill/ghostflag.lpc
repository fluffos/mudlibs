//十二地煞旗
inherit SKILL;
string skill_cname() {
  return "十二地煞旗";
}

mapping *action = ({
  ([ "action": "$N使一招「血雨腥风」，手中$w风似地向$n的$l卷去！",
    "damage": 70,
    "dodge": 70,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N身如枯木，$w随著一招「死灰槁木」由下而上撩往$n的$l",
    "damage": 40,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N身形一转，一招「死灰复燃」$w如妖魔现形，戳向$n的$l",
    "damage": 20,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N舞动$w，一招「死有余辜」往$n的$l斜斜挥出一旗",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N手中$w一晃，一招「恶贯满盈」迅捷无伦地盖向$n的$l",
    "damage": 70,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N提气丹田，身型咋展，一招「死生有命」直戳$n$l",
    "damage": 30,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N移步侧身，使一招「血海尸山」旗风猎猎挥向$n的$l",
    "damage": 50,
    "damage_type": "割伤"
  ]),
});

int valid_learn(object me) {
  object ob;

  if ((int)me->query("max_force") < 100)
    return notify_fail("你的内力不够，没有办法练十二地煞旗。\n");

  if ((string)me->query_skill_mapped("force") != "hotforce")
    return notify_fail("十二地煞旗必须配合赤阳内功才能练。\n");

  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "fork")
    return notify_fail("你必须先找一面旗子，才能练旗法。\n");
  return 1;
}

int valid_enable(string usage) {
  return (usage == "fork") || (usage == "parry");
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "fork")
    return notify_fail("你必须先找一面旗子，才能练旗法。\n");

  if ((int)me->query("kee") < 40)
    return notify_fail("你的体力不够练这门旗法，还是先休息休息吧。\n");
  me->receive_damage("kee", 40);
  return 1;
}
int effective_level() { return 19; }

string *parry_msg = ({
  "$n使出一招「死不瞑目」，用手中的$v急卷$N的五指。\n",
  "$n左脚踏前一步，一招「死地求生」，手中的$v从侧面飘向$N之必救。\n",
  "$n手中的$v一抖，挽出一片旗云，一招「死无遗忧」，撒向$N的全身。\n",
  "$n微退一步，手中的$v划出一片旗云，一招「死去活来」，将$N的全身围住。\n",
});

string *unarmed_parry_msg = ({
  "$n使出一招「死不瞑目」，用手中的$v急卷$N。\n",
  "$n左脚踏前踏，一招「死不旋踵」，手中的$v挥向$N之必救。\n",
  "$n手中的$v一抖，一招「死而复生」，奔向$N。\n",
  "$n手中的$v划出一招「死去活来」，将$N的全身围住。\n",
});

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int learn_bonus() {
  return -100;
}
int practice_bonus() {
  return -50;
}
int black_white_ness() {
  return 30;
}

string perform_action_file(string action) {
  return CLASS_D("xueshan") + "/ghostflag/" + action;
}
