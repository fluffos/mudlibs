//九兽神拳

inherit SKILL;
string skill_cname() {
  return "九兽神拳";
}

mapping *action = ({
  ([ "action": "$N使一招「搏狮手」，面露杀气，对准$n的$l「呼」地一拳",
    "force": 160,
    "parry": 20,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N由拳变爪，双臂伸展，森森十指使出「飞鸿爪」便往$n的$l招呼过去",
    "force": 130,
    "parry": 30,
    "damage_type": "抓伤"
  ]),
  ([ "action": "$N忽然抓耳挠腮，发出一声猿啼，猛地一记「白猿臂」便往$n的$l扫来",
    "force": 150,
    "parry": 10,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N步履一沉，蒲扇般的手乱拍胸脯，突然一记「熊照掌」击向$n$l",
    "force": 180,
    "parry": 20,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N双目如电，双手化为鹰嘴形状，使出「天鹰嘴」，对准$n的$l钩了过来",
    "force": 140,
    "parry": 20,
    "damage_type": "抓伤"
  ]),
  ([ "action": "$N斜身滚倒在地，突然朝天蹬出一脚「花豹脚」，对准$n的$l「呼」地踢来",
    "force": 150,
    "parry": 20,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N双眼血红，壮若疯虎，张开大口对准$n的$l狠狠咬了下去，正是怪招「虎扑斩」",
    "force": 170,
    "parry": 20,
    "damage_type": "抓伤"
  ]),
  ([ "action": "$N头一低，双手架于头顶两边，突然俯身蹿起，对准$n的$l一头撞来，好一招「鹿犄角」",
    "force": 140,
    "parry": 20,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "只见$N身体剧烈扭动，双拳飘忽不定，如毒蛇般游走，使出九兽神拳的精华「游蛇绕拳」",
    "force": 180,
    "parry": 20,
    "damage_type": "瘀伤"
  ]),
});

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练九兽神拳必须空手。\n");
  return 1;
}

int valid_enable(string usage) {
  return usage == "unarmed";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 30)
    return notify_fail("你的体力不够了，休息一下再练吧。\n");
  me->receive_damage("kee", 30);
  return 1;
}
int effective_level() { return 9; }

string *parry_msg = ({
  "$n以守为攻，拳招化为「游蛇绕拳」，如毒蛇般猛击$N握$w的手腕。\n",
});

string *unarmed_parry_msg = ({
  "$n运起猿犹神功，身体变得坚如岩石，用后背硬接了$N一招。\n",

});

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int learn_bonus() {
  return 0;
}
int practice_bonus() {
  return 0;
}
int black_white_ness() {
  return 0;
}

string perform_action_file(string action) {
  return CLASS_D("xueshan") + "/shouquan/" + action;
}
