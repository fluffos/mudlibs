// cunstomskill.c  written by john darks
#include <ansi.h>
#include <combat.h>
#include <skill.h>
#include <weapon.h>
inherit SKILL;
int valid_learn(object me) {
  return notify_fail("自创技只能通过参悟或在实战应用中提高。\n");
}
string skill_cname() {
  return "自创技";
}

int valid_enable(string usage) {
  object me = this_player();
  if (me->query("my_skill/skill_type") == "staff")
    return (usage == "staff") || (usage == "stick") || (usage == "parry");
  if (me->query("my_skill/skill_type") == "spear")
    return (usage == "spear") || (usage == "fork") || (usage == "parry");
  else return (usage == me->query("my_skill/skill_type")) || (usage == "parry");
}

mapping query_action(object me, object weapon) {
  mapping action;
  string *actions;
  int dodge, parry, damage, force;
  weapon = me->query_temp("weapon");
  action = ([]);
  if (!objectp(weapon)) {
    dodge = 100 + random(me->query_skill("unarmed") / 10);
    parry = -100 + random(me->query_skill("unarmed") / 10);
    force = random(60) + me->query_skill("unarmed", 1) / 5;
    action["damage_type"] = "瘀伤";
  } else {
    switch (weapon->query("skill_type")) {
      case "axe":
        dodge = -200 + random(me->query_skill("axe") / 20);
        parry = 200 + random(me->query_skill("axe") / 10);
        damage = random(100) + me->query_skill("axe", 1) / 2;
        action["damage_type"] = "割伤";
        break;
      case "blade":
        dodge = 60 + random(me->query_skill("blade") / 20);
        parry = 70 + random(me->query_skill("blade") / 20);
        damage = random(40) + me->query_skill("blade", 1) / 6;
        action["damage_type"] = "割伤";
        break;
      case "dagger":
        dodge = 140 + random(me->query_skill("dagger") / 10);
        parry = 10 + random(me->query_skill("dagger") / 20);
        damage = random(10) + me->query_skill("dagger", 1) / 10;
        action["damage_type"] = "刺伤";
        break;
      case "fork":
        dodge = -10 + random(me->query_skill("fork") / 20);
        parry = -10 + random(me->query_skill("fork") / 20);
        damage = random(50) + me->query_skill("fork", 1) / 5;
        action["damage_type"] = "刺伤";
        break;
      case "hammer":
        dodge = -20 + random(me->query_skill("hammer") / 10);
        parry = 120 + random(me->query_skill("hammer") / 10);
        damage = random(80) + me->query_skill("hammer", 1) / 3;
        action["post_action"] = (: call_other, WEAPON_D, "bash_weapon" :);
        action["damage_type"] = "挫伤";
        break;
      case "staff":
        dodge = 50 + random(me->query_skill("staff") / 10);
        parry = 50 + random(me->query_skill("staff") / 10);
        damage = random(50) + me->query_skill("staff", 1) / 5;
        action["post_action"] = (: call_other, WEAPON_D, "bash_weapon" :);
        action["damage_type"] = "挫伤";
        break;
      case "stick":
        dodge = 50 + random(me->query_skill("stick") / 20);
        parry = 50 + random(me->query_skill("stick") / 10);
        damage = random(60) + me->query_skill("stick", 1) / 5;
        action["post_action"] = (: call_other, WEAPON_D, "bash_weapon" :);
        action["damage_type"] = "挫伤";
        break;
      case "sword":
        dodge = 20 + random(me->query_skill("sword") / 10);
        parry = -50 + random(me->query_skill("sword") / 30);
        damage = random(30) + me->query_skill("sword", 1) / 7;
        action["damage_type"] = "割伤";
        break;
      case "throwing":
        dodge = 300 + random(me->query_skill("throwing") / 5);
        parry = 500 + random(me->query_skill("throwing"));
        damage = random(10) + me->query_skill("throwing", 1) / 10;
        action["post_action"] = (: call_other, WEAPON_D, "throw_weapon" :);
        action["damage_type"] = "刺伤";
        break;
      case "whip":
        dodge = 150 + random(me->query_skill("whip") / 10);
        parry = 200 + random(me->query_skill("whip") / 5);
        damage = random(30) + me->query_skill("whip", 1) / 8;
        action["damage_type"] = "瘀伤";
        break;
      default:
        dodge = -50 + random(150);
        parry = -50 + random(150);
        damage = -50 + random(150);
        break;
    }
  }
  actions = me->query("my_skill/skill_actions");
  if (!sizeof(actions)) {
    if (me->query("gender") == "男性")
      action["action"] = "$N狠狠的向$n攻出一招！";
    else if (me->query("gender") == "女性")
      action["action"] = "$N凶霸霸的向$n攻出一招！";
    else action["action"] = "$N咬牙切齿的向$n攻出一招！";
  } else action["action"] = actions[random(sizeof(actions))];
  action["dodge"] = dodge;
  action["parry"] = parry;
  if (objectp(weapon)) {
    action["damage"] = damage;
    if (weapon->weight() >= 50000 ||
      weapon->query("rigidity") >= 100)
      action["post_action"] = (: call_other, WEAPON_D, "bash_weapon" :);
  } else action["force"] = force;
  return action;
}

int practice_skill(object me) {
  object weapon;
  if ((me->query("my_skill/skill_type") == "unarmed")
    && (me->query_temp("weapon") || me->query_temp("secondary_weapon")))
    return notify_fail("练拳脚功夫必须空手。\n");
  else if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != me->query("my_skill/skill_type"))
    return notify_fail("你必须找对武器，才能练这门武功。\n");
  if ((int)me->query("kee") < 50)
    return notify_fail("你的体力不够练这门武功，还是先休息休息吧。\n");
  me->receive_damage("kee", 50);
  return 1;
}

int effective_level() {
  object me = this_player();
  return me->query("my_skill/eff_level");
}

string *unarmed_parry_msg = ({
  "但是被$p格开了。\n",
  "结果被$p挡开了。\n",
});

string *parry_msg = ({
  "只听见「锵」一声，被$p格开了。\n",
  "结果「当」地一声被$p挡开了。\n",
  "但是被$n用手中兵刃架开。\n",
  "但是$n身子一侧，用手中兵刃格开。\n",
});

string query_parry_msg(object weapon) {
  object me = this_player()->query_temp("last_opponent");
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else {
    if (me && !objectp(me->query_temp("weapon")) &&
      me->query("force") > this_player()->query("force") / 2) {
      call_out("attack_force", 1, me, this_player());
      return "$n不避不让，一掌相迎！\n";
    } else return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
  }
}

string perform_action_file(string action) {
  return CLASS_D("mojiao") + "/customskill/" + action;
}

int learn_bonus() {
  return 0;
}
int practice_bonus() {
  return -100;
}
int black_white_ness() {
  return 70;
}

void attack_force(object me, object target) {
  if (environment(me) == environment(target) && me->is_fighting(target))
    message_vision(HIY "\n$N" + HIY "与$n" + HIY "双掌相抵，居然拚起内力！\n" NOR, me, target);
  call_out("attack_force2", 0, me, target);
  call_out("attack_force2", 1, me, target);
  call_out("attack_force2", 2, me, target);
  call_out("attack_force2", 3, me, target);
  call_out("attack_force2", 4, me, target);
}

void attack_force2(object me, object target) {
  string msg;
  if (environment(me) == environment(target) && me->is_fighting(target)) {
    me->start_busy(1);
    target->start_busy(1);
    if (me->query("force") < 150) {
      if (target->query("force") >= 150) {
        target->add("force", -150);
        tell_object(me, HIB "你只觉对方内力源源不断的传来．．．\n" NOR);
        me->receive_damage("kee", 150, target);
        tell_object(target, HIG "你突然觉得对方的内力减弱了。\n" NOR);
        message_vision(HIR "$N" + HIR "抵不住$n" + HIR "的内力，禁不住全身颤抖起来。\n" NOR, me, target);
        COMBAT_D->report_status(me);
      }
      if (target->query("force") < 150) {
        message_vision(HIR "$N" + HIR "与$n" + HIR "都闷哼了一声，各退了几步。\n" NOR, me, target);
      }
    }
    if (me->query("force") >= 150) {
      if (target->query("force") >= 150) {
        me->add("force", -150);
        tell_object(target, HIB "你只觉对方内力源源不断的传来．．．\n" NOR);
        target->add("force", -150);
        tell_object(me, HIB "你只觉对方内力源源不断的传来．．．\n" NOR);
      }
      if (target->query("force") < 150) {
        me->add("force", -150);
        tell_object(target, HIB "你只觉对方内力源源不断的传来．．．\n" NOR);
        target->receive_damage("kee", 150, me);
        tell_object(me, HIG "你突然觉得对方的内力减弱了。\n" NOR);
        message_vision(HIR "$N" + HIR "抵不住$n" + HIR "的内力，禁不住全身颤抖起来。\n" NOR, target, me);
        COMBAT_D->report_status(target);
      }
    }
  }
  return;
}


mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  int skill, basic_skill;
  string attack_skill;
  object weapon;
  weapon = me->query_temp("weapon");
  if (objectp(weapon)) attack_skill = weapon->query("skill_type");
  else attack_skill = "unarmed";
  basic_skill = me->query_skill_eff_lvl(attack_skill) + 1;
  skill = me->query_skill_eff_lvl("customskill") + 1;
  me->improve_skill("customskill", 1, basic_skill > skill ? 0 : 1);
  if (random(damage_bonus) < 250) return;
  if (random(3 * (me->query_skill_eff_lvl("customskill"))) > (damage_bonus)) {
    victim->receive_wound("kee", damage_bonus / 2, me);
    victim->receive_wound("gin", damage_bonus / 2, me);
    victim->receive_wound("sen", damage_bonus / 2, me);
    victim->set("force", random(100) + 1);
    victim->add("max_force", -damage_bonus);
    victim->add("max_atman", -damage_bonus);
    victim->add("max_mana", -damage_bonus);
    if (victim->query("max_force") < 0)
      victim->set("max_force", 0);
    if (victim->query("max_atman") < 0)
      victim->set("max_atman", 0);
    if (victim->query("max_mana") < 0)
      victim->set("max_mana", 0);
    return HIR "$N" + HIR "发出无比强劲的罡气，重重的击中了$n" + HIR "！！！！\n" NOR;
  }
  return damage_bonus / 10;
}
