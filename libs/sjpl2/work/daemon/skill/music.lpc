// literate.c

#include <ansi.h>

inherit SKILL;
string skill_cname() {
  return "乐理";
}

string type() { return "knowledge"; }

void skill_improved(object me) {
  int s;

  s = me->query_skill("music", 1);
  if ((int)me->query("spi") < s / 5) {
    tell_object(me, HIW "通过对乐理的修习，你的灵性增加了。\n" NOR);
    me->add("spi", 1);
  }
}

int learn_bonus() {
  return 20;
}
int practice_bonus() {
  return 0;
}
int black_white_ness() {
  return 0;
}
