// 打造技术

inherit SKILL;
string skill_cname() {
  return "打造技术";
}
// make huopao here
mapping *action1 = ({
  ([ "action": "$N拉起风箱，将炼铁炉的火烧得旺旺的，兹兹地冒着浓烟",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N将铁块烧得通红，然后举起锤子敲打起来",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N们将通红的融化了的铁水注入模具之中，压制成形",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N们合力将制造成的火炮底座推到场地中央",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N们合力将沉重的火炮炮身扛到底座上，安装就位",
    "damage_type": "瘀伤"
  ]),
});
// make gongjian here
mapping *action2 = ({
  ([ "action": "$N拉起风箱，将炼铁炉的火烧得旺旺的，兹兹地冒着浓烟",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N将铁条烧得通红，然后举起锤子敲打起来",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N们将通红的融化了的铁水注入模具之中，压制成形",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N将打造好的锋利的箭头装到箭杆上，立时便成了一支利箭",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N们将制造完成的箭捆起来堆放到场地中央",
    "damage_type": "瘀伤"
  ]),
});
// make toushiji here (default)
mapping *action3 = ({
  ([ "action": "$N将运来的木料锯成各种形状的配件，堆放到场地中央",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N们用刨子将树干去皮磨光，做成一块块整齐的木料",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N们将配件装配起来，很快做成了一个个高大的投石机",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N给装配好的投石机按上车轮，并在表面钉上铁皮",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N们将各种巨大的石块打磨成形状统一的圆石，装配到投石车上",
    "damage_type": "瘀伤"
  ]),
});

int valid_learn(object me) {
  object ob;

  if ((int)me->query("max_force") < 0)
    return notify_fail("你的不够，没有办法练法。\n");
  return 1;
}

int valid_enable(string usage) {
  return usage == "unarmed" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  if ((string)me->query("guanfu/work_attrib") == "huopao")
    return action1[random(sizeof(action1))];
  else if ((string)me->query("guanfu/work_attrib") == "gongjian")
    return action2[random(sizeof(action2))];
  else
    return action3[random(sizeof(action3))];
}

int effective_level() { return 1; }

string *parry_msg = ({
  "$n们情绪高涨，大家热火朝天地干了起来。\n",
  "$n擦着头上的汗水，嚷道：再加把劲，快干完了！\n",
  "$n嘴里吆喝着：嗨哟～～嗨哟～～\n",
  "$n们奔波劳碌，忙得不亦乐乎。\n",
  "$n忙中偷闲，对你说道：大人敬请放心，我们决不让您失望！\n",
});

string *unarmed_parry_msg = ({
  "$n们情绪高涨，大家热火朝天地干了起来。\n",
  "$n擦着头上的汗水，嚷道：再加把劲，快干完了！\n",
  "$n嘴里吆喝着：嗨哟～～嗨哟～～\n",
  "$n们奔波劳碌，忙得不亦乐乎。\n",
  "$n忙中偷闲，对你说道：大人敬请放心，我们决不让您失望！\n",
});

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string perform_action_file(string action) {
  return CLASS_D("guanfu") + "/other_skills/" + action;
}
