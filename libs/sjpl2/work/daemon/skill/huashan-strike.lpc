// huashan-strike.c

inherit SKILL;
string skill_cname() {
  return "华山掌法";
}

mapping *action = ({
  ([ "action":
    "$N使一招「晚月朗星」, 两掌一左一右, 向$n的$l击去",
    "dodge": -30,
    "force": 170,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N使一招「却别苍松」, 双掌一合, 向$n的$l直拍过去",
    "dodge": -10,
    "force": 120,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N双掌一错, 右掌自左掌底下穿出, 使一招「无边落木」击向$n的$l",
    "dodge": 20,
    "force": 180,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N身形一长, 衣袖飘飘, 向$n拍去, 姿势潇洒之极，好一招「高山流水」",
    "dodge": 40,
    "damage": 200,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N使一招「天坤倒悬」, $n只觉得满天都是掌影, 不知道如何应付才好!",
    "dodge": -100,
    "force": 230,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N左掌往前一探, 使一招「青松翠催」缓缓地拍向$n的$l",
    "dodge": 70,
    "force": 180,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N猛地纵身一跃, 象一只大鸟般, 攻向$n的$l. 只见铺天盖地都是掌影\n"
    "正是华山掌法中的绝招「烟雨飘渺」",
    "dodge": 80,
    "parry": 80,
    "force": 220,
    "damage_type": "瘀伤"
  ]),

});

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练华山掌法必须空手。\n");
  return 1;
}

int valid_enable(string usage) {
  return usage == "unarmed";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  int skill, combat_exp;

  combat_exp = (int)me->query("combat_exp");
  skill = (int)me->query_skill("tianluo-steps", 1);

  if (skill * skill * skill / 10 > combat_exp)
    return notify_fail("你的实战经验不够，无法练习华山掌法。\n");

  if ((int)me->query("max_force") < 100)
    return notify_fail("你的内力不足,无法练习华山掌法。\n");
  if ((int)me->query("kee") < 30)
    return notify_fail("你的体力不够！\n");
  me->receive_damage("kee", 30);
  return 1;
}
int effective_level() {
  if ((string)this_player()->query_skill_mapped("force") == "zixia-shengong")
    return 15;
  else
    return 10;
}

int learn_bonus() {
  return 10;
}
int practice_bonus() {
  return -5;
}
int black_white_ness() {
  return 70;
}
