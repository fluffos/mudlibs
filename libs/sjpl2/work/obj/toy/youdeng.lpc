// item: /obj/toy/fire.c
// baiwt@sjpl 3/17/2001
#include <ansi.h>

inherit ITEM;

void create() {
  set_name("油灯", ({ "youdeng", "deng" }));
  set_weight(180);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一盏用于照明的油灯，到了黑暗的地方就用(use)得着了。\n");
    set("unit", "盏");
    set("value", 1000);
    set("lightness", 15);
  }
  setup();
}

void init() {
  add_action("do_use", "use");
}
int do_use(string arg) {
  object me;
  me = this_player();
  if (!arg || arg != "youdeng") {
    tell_object(me, "你要用什么？\n");
    return 1;
  }
  if (this_object()->query("lightness") <= 0) {
    tell_object(me, "这盏油灯已经用完了。\n");
    return 1;
  }
  message_vision(HIY "$N点亮了油灯，四周立时亮了起来。\n" NOR, me);
  environment(me)->set("use_lighting", uptime());
  me->set_temp("use_fire_time", uptime());
  this_object()->add("lightness", -1);
  return 1;
}
