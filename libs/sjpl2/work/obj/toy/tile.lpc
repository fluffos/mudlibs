// tile.c

#include <weapon.h>

inherit THROWING;

void create() {
  set_name("砖瓦", ({ "tile" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一种普通的用来修建房屋的砖瓦。\n");
    set("unit", "叠");
    set("base_unit", "块");
    set("base_weight", 2);
    set("base_value", 1);
    set("objattrib", 1);
  }
  set_amount(1);
  init_throwing(2);
  setup();
}
