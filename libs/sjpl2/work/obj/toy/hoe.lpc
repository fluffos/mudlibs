// hoe.c

#include <weapon.h>

inherit STAFF;

void create() {
  set_name("锄头", ({ "hoe" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是一把粗短的锄头。");
    set("value", 270);
    set("objattrib", 1);
    set("material", "wood");
  }
  init_staff(7);

  // These properties are optional, if you don't set them, it will use the
  // default values.

  set("wield_msg", "$N把$n紧紧地握在手中。\n");
  set("unwield_msg", "$N松开了手中的$n。\n");

  // The setup() is required.

  setup();
}
