//ship   created by baowt@sjpl 08,22,1999
#include <ansi.h>
#include <room.h>

inherit ROOM;
int do_assault(object me);
void create() {
  set("short", "蟠龙号");
  set("long", @LONG
这是一艘庞大的战船，船舱有三层高，上有了望塔。巨大的船
帆顺风鼓起，帆的两边飘扬着朝廷水军大旗，猎猎生风。船舷四周
有炮口和箭垛，旁边堆放着武器弹药。军士们精神矍铄，威风凛凛
，无不透露出我中华大国的威严。
LONG
  );
  set("objects", ([
    "/obj/guanfu/npc/navyoff": 1,
    "/obj/guanfu/npc/navyenemy": 1,
  ]));
  set("hell", 1);
  set("NONPC", 1);
  setup();
}

void init() {
  object ob;
  if (interactive(ob = this_player()))
    call_out("seasight", random(20) + 1, ob);
  call_out("findenemy", 120, ob);
  add_action("do_firebow", "firebow");
  add_action("do_longbow", "longbow");
  add_action("do_javelin", "javelin");
  add_action("do_stone", "stone");
  add_action("do_barbette", "barbette");
}

int seasight(object ob) {
  int damage;
  string *seamsg = ({ "\n海面上风平浪静，时不时有一两条鱼儿跃出水面，相互嬉戏。\n\n",
    "\n战船劈波斩浪，顺风前进着。\n\n",
    "\n战船已驶入了东海海域。\n\n",
    "\n蔚蓝色的大海一望无边，登船头眺望远处，好一番水天一色的景象。\n\n",
    "\n战船迎着风浪，缓缓行驶着。\n\n",
    "\n远处白帆点点，那是沿海一带渔民在出海捕鱼。\n\n",
    "\n远处的海滩隐约可见渔民们在晒着渔网，风中仿佛飘来一曲曲渔歌。\n\n",
    "\n海面上波澜不兴，阳光洒在水面上，泛着点点金光。\n\n",
    "\n战船向东行驶着，新鲜的海风迎面吹来，令人精神为之一振。\n\n",
    "\n战船驶过一片孤岛，岛上树木郁郁葱葱，百鸟鸣唱，令人心旷神怡。\n\n" });
  if (ob && environment(ob) == this_object()) {
    tell_object(this_object(), seamsg[random(9)]);
    if (environment(ob) == this_object()) {
      if (!ob->query_temp("is_in_battle"))
        call_out("seasight", random(20) + 1, ob);
      return 1;
    } else
      return 1;
  }
}

int findenemy(object ob) {
  ob = this_player();
  message_vision(YEL "\n了望塔发现了敌船踪影！请大人火速下令作战（assault）！\n\n" NOR, ob);
  ob->set_temp("is_in_battle", 1);
  ob->remove_call_out("seasight");
  return 1;
}

int do_firebow(object me) {
  string *battlemsg = ({ "\n我军火箭射中敌船，敌倭船立刻变成了一条火龙。\n\n",
    "\n我军火箭射中敌船帆，敌倭船立时着起火来。\n\n",
    "\n火箭飕飕地在敌船舱顶飞过，令无数敌人葬身火海。\n\n",
    "\n火箭在距敌倭船两米之处掉下江中，没有击中敌寇。\n\n" });
  int spdp;
  me = this_player();
  spdp = me->query("battle/damage");
  if (!me->query_temp("is_in_battle"))
    return notify_fail("我军并未遭遇敌人。\n");
  if (!me->query_temp("doing_assault"))
    return notify_fail("我军并未投入战斗。\n");
  if (me->query("battle/equip") != "火箭")
    return notify_fail("船上没有装备这种武器。\n");
  if (me->is_busy())
    return notify_fail("我军士兵正忙着将弓箭上弦。\n");
  message_vision(HIR "\n我军水师战船向敌倭船发射火箭。\n\n" NOR, me);
  message_vision(HIR + battlemsg[random(3)] + NOR, me);
  me->add("enemy_kee", -random(spdp) - 1);
  me->start_busy(2);
  return 1;
}
int do_longbow(object me) {
  string *battlemsg = ({ "\n倭寇纷纷举起盾牌，挡住了我军发射的连弩。\n\n",
    "\n我军连弩纷纷射中敌寇，敌将士从船上纷纷跌落水中，被射伤淹死的不计其数。\n\n",
    "\n我军连弩射中敌船帆，巨大的船帆哗啦啦地跌落下来。\n\n",
    "\n弩箭在距敌倭船两米之处掉下江中，没有击中敌寇。\n\n" });
  int spdp;
  me = this_player();
  spdp = me->query("battle/damage");
  if (!me->query_temp("is_in_battle"))
    return notify_fail("我军并未遭遇敌人。\n");
  if (!me->query_temp("doing_assault"))
    return notify_fail("我军并未投入战斗。\n");
  if (me->query("battle/equip") != "连弩")
    return notify_fail("船上没有装备这种武器。\n");
  if (me->is_busy())
    return notify_fail("我军士兵正忙着将弓箭上弦。\n");
  message_vision(HIR "\n我军水师战船向敌倭船发射连弩。\n\n" NOR, me);
  message_vision(HIR + battlemsg[random(3)] + NOR, me);
  me->add("enemy_kee", -random(spdp) - 1);
  me->start_busy(3);
  return 1;
}
int do_javelin(object me) {
  string *battlemsg = ({ "\n敌军战船向左船舷急速闪避，躲开了我军的标枪。\n\n",
    "\n我军标枪击中敌寇战船，船桅立刻折为两段。\n\n",
    "\n破舱标击中倭寇船舷，立时将船舱撞破了一个洞。\n\n",
    "\n破舱标飕飕地在敌船舱顶飞过，令敌寇惊出一身冷汗。\n\n" });
  int spdp;
  me = this_player();
  spdp = me->query("battle/damage");
  if (!me->query_temp("is_in_battle"))
    return notify_fail("我军并未遭遇敌人。\n");
  if (!me->query_temp("doing_assault"))
    return notify_fail("我军并未投入战斗。\n");
  if (me->query("battle/equip") != "破舱标")
    return notify_fail("船上没有装备这种武器。\n");
  if (me->is_busy())
    return notify_fail("我军士兵正忙着装破舱标。\n");
  message_vision(HIR "\n我军水师战船向敌倭船发射破舱标。\n\n" NOR, me);
  message_vision(HIR + battlemsg[random(3)] + NOR, me);
  me->add("enemy_kee", -random(spdp) - 1);
  me->start_busy(5);
  return 1;
}
int do_stone(object me) {
  string *battlemsg = ({ "\n巨大的石块在敌船船头附近坠落，险些砸到了船板。\n\n",
    "\n我军投石器发射的石块击中敌船尾，船尾立时折断。\n\n",
    "\n砰地一声，巨石击中倭寇船舷，立时将船身撞了个大洞。\n\n",
    "\n敌军一艘战船进水过多，终于渐渐沉入了海底。\n\n" });
  int spdp;
  me = this_player();
  spdp = me->query("battle/damage");
  if (!me->query_temp("is_in_battle"))
    return notify_fail("我军并未遭遇敌人。\n");
  if (!me->query_temp("doing_assault"))
    return notify_fail("我军并未投入战斗。\n");
  if (me->query("battle/equip") != "投石器")
    return notify_fail("船上没有装备这种武器。\n");
  if (me->is_busy())
    return notify_fail("我军士兵正忙着装石块。\n");
  message_vision(HIR "\n我军水师战船向敌倭船发射投石。\n\n" NOR, me);
  message_vision(HIR + battlemsg[random(3)] + NOR, me);
  me->add("enemy_kee", -random(spdp) - 1);
  me->start_busy(7);
  return 1;
}
int do_barbette(object me) {
  string *battlemsg = ({ "\n我军炮火击中敌军战船，顿时将敌军将士打得血肉模糊。\n\n",
    "\n敌一艘倭船冒着浓烟，仓皇逃遁。\n\n",
    "\n轰地一声，炮弹击中倭寇船舷，立时将船身炸了个大洞。\n\n",
    "\n我军炮弹击中敌倭船船舱，将敌船打得碎片纷飞，船员伤亡严重。\n\n",
    "\n炮弹在敌倭船周围开花，爆炸声响彻云霄。\n\n" });
  int spdp;
  me = this_player();
  spdp = me->query("battle/damage");
  if (!me->query_temp("is_in_battle"))
    return notify_fail("我军并未遭遇敌人。\n");
  if (!me->query_temp("doing_assault"))
    return notify_fail("我军并未投入战斗。\n");
  if (me->query("battle/equip") != "火炮")
    return notify_fail("船上没有装备这种武器。\n");
  if (me->is_busy())
    return notify_fail("我军士兵正忙着装炮弹。\n");
  message_vision(HIR "\n我军水师战船向敌倭船发射火炮。\n\n" NOR, me);
  message_vision(HIR + battlemsg[random(4)] + NOR, me);
  me->add("enemy_kee", -random(spdp) - 1);
  me->start_busy(9);
  return 1;
}
