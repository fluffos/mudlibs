#include <ansi.h>
inherit NPC;
string eff_kees(object me);
void create() {
  object me = this_player();
  set_name("倭船", ({ "enemy ship", "enemy" }));
  set("str", 5);
  set("long",
    "这是一艘倭寇战船。\n");
  set("max_kee", 9000);
  set("max_sen", 9000);
  set("max_gin", 9000);
  set("kee", 9000);
  set("sen", 9000);
  set("gin", 9000);
  set("combat_exp", 1000);
  set("guanfu/work_attrib", 1);
  set("no_shown", 1);

  set_skill("unarmed", 10);
  set_skill("parry", 10);
  set_skill("move", 10);
  set_skill("dodge", 10);
  set_skill("skill_ship", 10);
  set_skill("skill_navy", 10);
  map_skill("dodge", "skill_ship");
  map_skill("unarmed", "skill_navy");
  map_skill("parry", "skill_navy");
  setup();
}
void init() {
  ::init();
  add_action("do_fight", "fight");
  add_action("do_kill", "kill");
  add_action("do_steal", "steal");
  add_action("do_conjure", "conjure");
  add_action("do_cast", "cast");
  add_action("do_ji", "ji");
  add_action("do_exert", "exert");
  add_action("do_perform", "perform");
  add_action("do_hp", "hp");
  add_action("do_practice", "practice");
  add_action("do_lian", "lian");
  add_action("do_exercise", "exercise");
  add_action("do_yun", "yun");
  add_action("do_study", "study");
  add_action("do_eat", "eat");
  add_action("do_drink", "drink");
}

