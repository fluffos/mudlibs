// heaven_soldier.c

#include <ansi.h>

inherit NPC;
void backattack();
void huaming(object me);
void create() {

  set_name("分身化影", ({ "shadow" }));
  set("long", "这是一个影子。\n");
  set("attitude", "friendly");

  set("int", 30);
  set("cor", 20);
  set("cps", 30);
  set("spi", 30);

  set("max_kee", 9000);
  set("max_gin", 9000);
  set("max_sen", 9000);

  set("force", 3000);
  set("max_force", 3000);
  set("force_factor", 10);

  set("atman", 2000);
  set("max_atman", 2000);

  set("mana", 4000);
  set("max_mana", 2000);
  set("mana_factor", 10);


  set("combat_exp", 100000);
  set_skill("force", 200);
  huaming(this_object());

  setup();

  carry_object("/obj/cloth")->wear();
}


int heal_up() {
  if (environment() && !is_fighting()) {
    call_out("leave", 1);
    return 1;
  }
  if (is_fighting() && (int)this_object()->query("kee") <= 100)
    backattack();
  return ::heal_up() + 1;
}

void huaming(object me) {
  string name, id, title, nickname;
  name = this_player()->query("name");
  id = this_player()->query("id");
  title = this_player()->query("title");
  nickname = this_player()->query("nickname");
  this_object()->set("id", id);
  this_object()->set("name", name);
  this_object()->set("nickname", nickname);
  this_object()->set("title", title);
}


void leave() {
  object owner;
  message("vision",
    name() + HIW "的影子停了下来。\n\n"
    +name() + HIW "的影子晃了晃，转眼消失不见了。\n", environment(),
    this_object());
  if (objectp(owner = this_object()->query("possessed")))
    owner->add_temp("max_guard", -1);
  destruct(this_object());
}

void invocation(object who, int level) {
  int i;
  object *enemy;
  set_skill("parry", 300 + random(level / 2));
  set_skill("dodge", 300 + random(level / 2));
  set_skill("move", 300 + random(level / 2));
  set("combat_exp", 100000 + random(level / 4 * level * level));
  message("vision",
    name() + "突然化出另一条身影！\n" NOR,
    environment(), this_object());
  enemy = who->query_enemy();
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      kill_ob(enemy[i]);
      if (userp(enemy[i])) enemy[i]->fight_ob(this_object());
      else enemy[i]->kill_ob(this_object());
    }
  }
  set_leader(who);
  set("possessed", who);
}
void backattack() {
  int i;
  object owner, *enemy;
  if (objectp(owner = this_object()->query("possessed"))) {
    enemy = this_object()->query_enemy();
    i = sizeof(enemy);
    while (i--) {
      if (enemy[i] && living(enemy[i])) {
        owner->kill_ob(enemy[i]);
        enemy[i]->kill_ob(owner);
      }
    }

  }

}

void die() {
  object owner;
  if (objectp(owner = this_object()->query("possessed")))
    owner->add_temp("max_guard", -1);
  ::die();
}
