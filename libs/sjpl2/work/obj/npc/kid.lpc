// girl.c

inherit NPC;

void create() {
  set_name("小孩", ({ "kid" }));
  set("gender", "男性");
  set("age", 12);
  set("str", 25);
  set("cor", 21);
  set("cps", 20);
  set("int", 25);

  set("attitude", "friendly");

  set("long", @LONG
这是一位衣着朴素的小孩。
LONG);

  set("combat_exp", 10);


  setup();
  carry_object("/obj/cloth")->wear();
}
int accept_fight(object who) {
  return 1;
}
