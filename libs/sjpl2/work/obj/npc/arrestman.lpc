//  /obj/npc/arrestman.c
#include <ansi.h>
inherit NPC;

void create() {
  set_name("人犯", ({ "arrested man" }));
  set("long", "这是一个戴着手铐脚镣的人犯。\n");
  set("age", 20 + random(20));
  set("gender", "男性");
  seteuid(getuid());
  set("combat_exp", 1000);
  setup();
  carry_object("/obj/cloth")->wear();
}

int heal_up() {
  if (environment() && !is_fighting()) {
    call_out("leave", 1);
    return 1;
  }
  return ::heal_up() + 1;
}
void leave() {
  message("vision", HIC
    "\n几个捕快匆匆赶来，说道：大人辛苦了，把人犯交给我们吧！\n\n" NOR,
    environment(), this_object());
  message("vision", HIC + name() + "被押着离开了。\n" NOR,
    environment(), this_object());
  destruct(this_object());
}

void init() {
  add_action("do_kill", "kill");
  add_action("do_fight", "fight");
}

int do_kill(string arg) {
  if (arg == "arrested man") {
    write("你不能随便杀犯人。\n");
    return 1;
  }
  return 0;
}

int do_fight(string arg) {
  if (arg == "arrested man") {
    write("你不能和一个犯人较量。\n");
    return 1;
  }
  return 0;
}
