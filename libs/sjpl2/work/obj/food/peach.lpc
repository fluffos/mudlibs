// peach.c

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("桃子", ({ "peach" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一个新鲜的刚从树上掉下来的桃子。\n");
    set("unit", "个");
    set("value", 10);
    set("objattrib", 1);
    set("food_remaining", 3);
    set("food_supply", 60);
  }
}
