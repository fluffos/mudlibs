// dumpling.c

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("鱼香肉丝", ({ "rousi" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一盆鱼香肉丝。\n");
    set("unit", "个");
    set("value", 1500);
    set("food_remaining", 3);
    set("food_supply", 60);
  }
}
