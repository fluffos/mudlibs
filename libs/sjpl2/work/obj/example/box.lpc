// bag.c

inherit ITEM;

void create() {
  set_name("木箱子", ({ "box" }));
  set_weight(600);
  set_max_encumbrance(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "只");
    set("long", "这是一只寻常的木箱子，可以用来装一些杂物。\n");
    set("value", 500);
  }
}

int is_container() { return 1; }
