// subskill.c

inherit F_CLEAN_UP;

int main(object me, string arg) {
  int replace, i;
  mapping subskill;
  string verb, *vrbs;

  /*
	if( userp(me) && !wizardp(me) )
	{
		write("什么？\n");
		return 1;
	}
*/

  if (!arg) {
    subskill = me->query_all_subskill();
    if (!sizeof(subskill)) {
      write("你目前并没有传授任何技能。\n");
      return 1;
    } else {
      write("你目前传授的技能有：\n\n");
      vrbs = keys(subskill);
      for (i = 0; i < sizeof(vrbs); i++)
        printf("%-20s  %-20s = %d\n", to_chinese(vrbs[i]), vrbs[i], subskill[vrbs[i]]);
      return 1;
    }
  }

  else if (arg != "subskill" && !wizardp(me))
    return notify_fail("什麽？\n");

  if (sscanf(arg, "%s %d", verb, replace) != 2)
    me->set_subskill(arg, 0);
  else if (verb == "subskill")
    return notify_fail("你不能将 \"subskill\" 指令设定其他用途。\n");
  else if (verb == "")
    return notify_fail("你要设什麽 subskill？\n");
  else
    return me->set_subskill(verb, replace);

  //	write("Ok.\n");
  return 1;
}
