// help.c    modified by baiwt 1999,2

#include "/doc/help.h"

inherit F_CLEAN_UP;

//string *default_search = DEFAULT_SEARCH_PATHS;

int main(object me, string arg) {
  int i;
  string file, *search;
  string HELPdir;
  HELPdir = "/doc/";
  // If no topic specified, give the topics.
  if (!arg) {
    me->start_more(read_file(HELPdir + "help/topics.txt"));
    //		cat(HELPdir + "help/topics.txt");
    return 1;
  }
  file = resolve_path(me->query("cwd"), HELPdir + "help/" + arg + ".txt");
  if (file_size(file) < 0) return notify_fail("没有针对这项主题的说明文件。\n");

  // Else, try if a command name is specified.
  seteuid(getuid());
  if (stringp(file = me->find_command(arg))) {
    notify_fail("有这个指令存在，但是并没有详细的说明文件。\n");
    return file->help(me);
  }
  me->start_more(read_file(HELPdir + "help/" + arg + ".txt"));
  //		cat(HELPdir + "help/"+arg+".txt");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式：help <主题>              例如：> help cmds

这个指令提供你针对某一主题的详细说明文件，若是不指定主题，则提供你有关
主题的文件。
HELP
  );
  return 1;
}
