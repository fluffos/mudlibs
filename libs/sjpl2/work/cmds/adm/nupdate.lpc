// /cmds/arch/nupdate
inherit F_CLEAN_UP;
int main(object me, string str) {
  object *ob_list;
  int i;

  if (!str)
    return notify_fail("指令格式：nupdate <档名>\n");

  str = resolve_path(me->query("cwd"), str);
  ob_list = children(str);
  for (i = 0; i < sizeof(ob_list); i++) {
    destruct(ob_list[i]);
  }
  return 1;
}

int help(object me) {
  write(@HELP
指令格式: nupdate <FILE>

这个指令是用来更新一个文件的所有clone。

HELP
  );
  return 1;
}
