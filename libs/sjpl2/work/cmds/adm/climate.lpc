/*
#include "/doc/help.h"
#include <ansi.h>
#include <command.h>
*/
inherit F_CLEAN_UP;

int main(object me, string arg) {
  int bright, temp, humidity;
  string output, season;
  arg = "now";
  //	if(!player) return notify_fail("这个。\n");
  bright = NATURE_D->query_brightness();
  temp = NATURE_D->query_temperature();
  humidity = NATURE_D->query_humidity();
  season = NATURE_D->query_season();
  output = NATURE_D->outdoor_room_description();
  write("\n现在气候情况：" + season + "\n" + output + "\n");
  printf("光照：%d  温度：%d  湿度：%d \n\n", bright, temp, humidity);
  return 1;
}
