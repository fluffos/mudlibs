#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  object ob;
  string name, func, oldstate;
  if (!arg || sscanf(arg, "%s %s", name, func) != 2)
    return notify_fail("指令格式：checkcall <人名> <old或new> 其中old检查当前状态，new打开其call函数功能。\n");
  if (name == "me") {
    if (func == "old") {
      oldstate = me->query("last_call_other");
      write(me->name() + "曾经对" + oldstate + "使用过call指令。\n");
      return 1;
    }
    if (func == "new") {
      me->set("last_call_other", 0);
      write("打开" + me->name() + "的call指令功能。\n");
      return 1;
    } else return 1;
  }

  ob = present(name, environment(me));
  if (!objectp(ob)) return notify_fail("这里没有这个人。\n");
  if (!ob->is_character() || ob->is_corpse())
    return notify_fail("看清楚一点，那并不是活物。\n");
  if (func == "old") {
    oldstate = ob->query("last_call_other");
    write(ob->name() + "曾经对" + oldstate + "使用过call指令。\n");
    return 1;
  }
  if (func == "new") {
    ob->set("last_call_other", 0);
    write("打开" + ob->name() + "的call指令功能。\n");
    return 1;
  } else return 1;
}
