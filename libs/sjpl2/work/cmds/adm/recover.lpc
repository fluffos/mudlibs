// recover.c

#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  object obj;
  string tar, opt;
  int pot;

  if (!arg)
    return notify_fail("你想给谁恢复数据？\n");
  if (!wizardp(me))
    return notify_fail("你没有恢复玩家数据的权限。\n");

  if (!arg || sscanf(arg, "%s %s %d", tar, opt, pot) != 3)
    return notify_fail("指令格式：recover <玩家> <选项> <数量>\n");

  if (me->query("id") != "baiwt" && me->query("id") != "cayenne")
    return notify_fail("你没有恢复玩家数据的权限。\n");

  if (!objectp(obj = present(tar, environment(me))))
    return notify_fail("这里没有这个人。\n");

  if (!userp(obj))
    return notify_fail("只能恢复玩家数据。\n");

  if (opt != "panshi" && opt != "exp" && opt != "qn" && opt != "daode")
    return notify_fail("选项内容：panshi 减除判师记录  exp 恢复经验  qn 恢复潜能  daode 恢复道德。\n");

  if (pot <= 0)
    return notify_fail("数据点数只能是大于0的正数。\n");

  if (opt == "panshi") {
    if ((int)obj->query("betrayer") < pot)
      return notify_fail("这个人没有那么多判师记录。\n");
    //		bp=obj->query("betrayer");
    obj->add("betrayer", -pot);
    message_vision(WHT "\n$N为$n恢复了" + pot + "点判师记录。\n\n" NOR, me, obj);
    log_file("Recover_LOG", sprintf("(%s)
%s recover %s %s %d\n", ctime(time()), me->query("id"), obj->query("id"), opt, pot));
    return 1;
  } else if (opt == "exp") {
    if (obj->query("combat_exp") >= 90000000)
      return notify_fail("这个人无法再恢复经验了。\n");
    obj->add("combat_exp", pot);
    message_vision(WHT "\n$N为$n恢复了" + pot + "点战斗经验。\n\n" NOR, me, obj);
    log_file("Recover_LOG", sprintf("(%s)
%s recover %s %s %d\n", ctime(time()), me->query("id"), obj->query("id"), opt, pot));
    return 1;
  } else if (opt == "qn") {
    if (obj->query("potential") - obj->query("learned_points") >= 10000000)
      return notify_fail("这个人无法再恢复潜能了。\n");
    obj->add("potential", pot);
    message_vision(WHT "\n$N为$n恢复了" + pot + "点潜能。\n\n" NOR, me, obj);
    log_file("Recover_LOG", sprintf("(%s)
%s recover %s %s %d\n", ctime(time()), me->query("id"), obj->query("id"), opt, pot));
    return 1;
  } else if (opt == "daode") {
    if (obj->query("daode") >= 0)
      return notify_fail("这个人无法再恢复道德了。\n");
    obj->add("daode_point", pot);
    message_vision(WHT "\n$N为$n恢复了" + pot + "点道德。\n\n" NOR, me, obj);
    log_file("Recover_LOG", sprintf("(%s)
%s recover %s %s %d\n", ctime(time()), me->query("id"), obj->query("id"), opt, pot));
    return 1;
  } else
    message_vision(MAG "\n$N为$n恢复记录，但是没有成功。\n\n" NOR, me, obj);
  return 1;
}
