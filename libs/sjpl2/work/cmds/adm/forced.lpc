#include <ansi.h>

inherit F_CLEAN_UP;


void create() { seteuid(getuid()); }

int main(object me, string arg) {
  string from, cmd, str;
  object obj;

  if (!arg) return notify_fail("你要强迫谁执行什么命令？\n");

  // Check if a container is specified.
  if (sscanf(arg, "%s to %s %s", from, cmd, str) == 3) {
    obj = present(from, environment(me));
    if (!obj) obj = find_player(from);
    if (!obj) return notify_fail("这里没有 " + from + " 这个生物。\n");
  }
  //	else return notify_fail("你要强迫谁?\n");
  //	if(!obj->forced(arg))
  if (!read_file("/cmds/std/" + cmd + ".lpc"))
    return notify_fail("命令参数错误或者没有这条基本命令。\n");
  if (!str) return notify_fail("你要强迫" + obj->name() + "执行什么命令？\n");
  if (!("/cmds/std/" + cmd)->main(obj, str))
    return notify_fail("你无法强迫" + obj->name() + "执行这个命令。\n");
  else return 1;

}

int help(object me) {
  write(@HELP
指令格式 : force <某人> to <命令>
 
这个指令可以让你强迫某人执行某条命令.
kill <sb>  get <sth>
fight <sb> drop <sth>
HELP
  );
  return 1;
}
