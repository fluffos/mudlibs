// /d/cmds/adm/check复制档案.c  created by Baiwt@Sjpl  (05/30/99)
#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  object ob;
  string name, func;
  if (!arg || sscanf(arg, "%s %s", name, func) != 2)
    return notify_fail("格式：setcp <人名> <open或close> 。\n");
  if (name == "me") {
    if (func == "close") {
      me->set("cp_permission", 0);
      write("关闭" + me->name() + "的复制档案功能。\n");
      return 1;
    }
    if (func == "open") {
      me->add("cp_permission", 1);
      write("增加" + me->name() + "的复制档案功能。\n");
      return 1;
    } else return 1;
  }

  ob = present(name, environment(me));
  if (!objectp(ob)) return notify_fail("这里没有这个人。\n");
  if (!ob->is_character() || ob->is_corpse())
    return notify_fail("看清楚一点，那并不是活物。\n");
  if (func == "close") {
    me->set("cp_permission", 0);
    write("关闭" + me->name() + "的复制档案功能。\n");
    return 1;
  }
  if (func == "open") {
    ob->add("cp_permission", 1);
    write("打开" + ob->name() + "的复制档案功能。\n");
    return 1;
  } else return 1;
}
