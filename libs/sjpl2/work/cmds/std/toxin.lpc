#include <ansi.h>
#include <skill.h>

inherit F_CLEAN_UP;
void toxin_up(object me);

int main(object me, string arg) {
  int rate, efdt;
  string red, green, noname, noshadow, hualiu, curse;
  object corp;

  seteuid(getuid());

  if (me->is_busy())
    return notify_fail(" 你上一个动作还没有完成，不能查蛊。\n");
  if (me->query("biguan_begin"))
    return notify_fail("正在闭关修行中，无法执行该动作。\n");

  rate = me->query("max_kee") - me->query("eff_kee");
  if (!arg) {
    if (rate > 50) hualiu = "花柳蛊";
    else hualiu = "：";
    if (rate > 100) green = "碧血蛊";
    else green = "：";
    if (rate > 150) noshadow = "无影蛊";
    else noshadow = "：";
    if (rate > 200) red = "赤血蛊";
    else red = "：";
    if (rate > 250) noname = "无名奇蛊";
    else noname = "：";
    write("\n你目前炼成的蛊有：\n\n");
    write(hualiu + "：" + green + "：" + noshadow + "：" + red + "：" + noname + "\n\n");
    write("你必须保持现有身体状况以维持蛊的存在！\n\n");
    return 1;
  }
  if (arg != "me")
    return notify_fail("你只能凭自己的能力炼蛊！\n");
  if (!corp = present("corpse", environment(me)))
    return notify_fail("你的周围没有尸体，无法炼蛊！\n");

  if (!stringp(curse = me->query_skill_mapped("cursism")))
    return notify_fail("你请先用 enable cursism指令选择你要使用的蛊术体系。\n");

  efdt = (int)me->query_skill("celecurse") / 2;

  /*   add for『蛊魔附体』          baiwt@sjpl 2001,6,14  */
  if (rate > 300 && !me->query_temp("toxin_nodie") && efdt > 10 && me->query("class") == "pima") {
    message_vision(WHT "\n忽然$n全身冒起青烟，那青烟渐渐聚拢，围在$N身周。\n" NOR, me, corp);
    message_vision(WHT "\n$N发出一股腐臭，突然爆裂出一个蛊魔！\n" NOR, corp);
    message_vision(WHT "\n那蛊魔被浓烈的青烟裹起迅速钻入了$N体内！\n\n" NOR, me);

    if (random(30) > 20 && me->query_skill("blood_force", 1) < 100) {
      me->receive_damage("gin", random(10));
      me->receive_wound("kee", random(50));
    }
    me->start_busy(1);
    me->set_temp("toxin_nodie", 1);
    call_out("toxin_up", efdt, me);
    return 1;
  }
  message_vision(RED "\n$N割开手腕，将自身毒血注入$n之中。\n" NOR, me, corp);
  message_vision(RED "\n。。。。。。\n" NOR, me, corp);
  message_vision(RED "\n随着$n渐渐被毒血腐化，$N的毒蛊炼成了！\n\n" NOR, me, corp);
  me->receive_damage("gin", random(30));
  me->receive_wound("kee", random(60));
  me->start_busy(3);
  return 1;
}

void toxin_up(object me) {
  if (!me) return;
  me->delete_temp("toxin_nodie");
  message_vision(WHT "\n$N全身冒起青烟，不断向上蒸发。。。\n" NOR, me);
  message_vision(WHT "\n过了许久，青烟渐渐消失，$N已经虚汗淋漓了。\n\n" NOR, me);
  if (random(30) > 20 && me->query_skill("blood_force", 1) < 200) me->receive_damage("kee", 20);
  return;
}
