#include <ansi.h>
inherit F_CLEAN_UP;
int main(object me, string arg) {
  object soldier;
  int yuanyouforce, training, exp, MAX_GUARD;
  if ((string)me->query("class") != "yeren")
    return notify_fail("你不是深山野人，还是自己照顾自己吧！\n");
  if (!environment(me)->query("outdoors"))
    return notify_fail("这里无法召唤野兽！\n");
  if (!me->is_fighting())
    return notify_fail("好象没有人要杀你！\n");
  if ((int)me->query("kee") < 100)
    return notify_fail("你的气太差了！\n");
  if (me->query_delay() > 0 && me->query_delay() < 4)
    return notify_fail("(你上一个动作还没有完成，不能进行召唤。)\n");
  if (me->query("biguan_begin"))
    return notify_fail("正在闭关修行中，无法执行该动作。\n");

  yuanyouforce = (int)me->query_skill("yuanyouforce");
  training = (int)me->query_skill("training");
  exp = (int)me->query("combat_exp");
  if (yuanyouforce < 20 || training < 20)
    return notify_fail("你的驭兽术和猿犹神功太差了，无法召唤野兽！\n");
  MAX_GUARD = yuanyouforce * training / 10000 + 1;
  if ((int)me->query_temp("max_guard") >= 3)
    return notify_fail("你已经施展过［驭兽术］了。\n");
  seteuid(getuid());
  me->receive_damage("kee", 50);
  soldier = new("/u/baiwt/xueshan/xsnpc/wolf");
  soldier->move(environment(me));
  soldier->invocation(me, (training + yuanyouforce));
  soldier->set("possessed", me);
  soldier->add("combat_exp", me->query("combat_exp") / 5);
  soldier->set_temp("apply/damage", 60);
  me->add_temp("max_guard", 1);
  me->remove_all_killer();
  message_vision(HIR "\n$N发出一声嘶心裂腑的尖啸,啸声震人耳鼓，远远传了开去...\n" NOR, me);
  message_vision(HIG "\n只听见一声嚎叫，$N奔了过来。\n" NOR, soldier);
  return 1;
}

int help(object me) {
  write(@HELP
指令格式：rein
 
这个指令让玩家呼唤野兽来保护自己.
 
HELP
  );
  return 1;
}
