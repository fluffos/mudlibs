// kill.c

#include <ansi.h>
#define LOWER_LIMIT 50000
inherit F_CLEAN_UP;

int main(object me, string arg) {
  object obj, man;
  string *killer, callname;
  if (me->query("battle_slg_mode"))
    return notify_fail("正在战略模式中，没有提供该指令。\n");

  if (environment(me)->query("no_fight"))
    return notify_fail("这里不准战斗。\n");
  if (me->query_temp("sleeping")) return notify_fail("你正在睡眠中。\n");

  if (!arg)
    return notify_fail("你想杀谁？\n");
  if (me->query("biguan_begin"))
    return notify_fail("正在闭关修行中，无法执行该动作。\n");

  if (!objectp(obj = present(arg, environment(me))))
    return notify_fail("这里没有这个人。\n");

  if (!obj->is_character() || obj->is_corpse())
    return notify_fail("看清楚一点，那并不是活物。\n");

  if (obj == me)
    return notify_fail("用 suicide 指令会比较快:P。\n");

  if (me->query_wait()) return notify_fail("你现在无法杀人。\n");

  if (obj->query("daode") >= 2000)
    return notify_fail("你刚动了杀机，忽然感到对方身上透出一股凛然正气，令你难以靠近！\n");
  if (me->query("kill_player_record") >= 300) {
    write("你刚动了杀机，忽然感到身体一阵抽蓄，你的心魔发作了！\n");
    me->set("force", 0);
    me->set("force_factor", 0);
    me->set_temp("weapon", 0);
    me->add("kill_player_record", 10);
  }
  if (present("waiter", environment(me))) {
    man = present("waiter", environment(me));
    if (!userp(man))
      message_vision(HIC "$n指着$N大叫：青天白日竟敢行凶，还有没有王法！\n" NOR, me, man);
    write("你的心魔增加了！\n");
    me->add("kill_player_record", random(1));
  }
  if (present("boss", environment(me))) {
    man = present("boss", environment(me));
    if (!userp(man))
      message_vision(HIC "$n指着$N大叫：青天白日竟敢行凶，还有没有王法！\n" NOR, me, man);
    write("你的心魔增加了！\n");
    me->add("kill_player_record", random(1));
  }
  if (present("jiubao", environment(me))) {
    man = present("jiubao", environment(me));
    if (!userp(man))
      message_vision(HIC "$n指着$N大叫：青天白日竟敢行凶，还有没有王法！\n" NOR, me, man);
    write("你的心魔增加了！\n");
    me->add("kill_player_record", random(1));
  }

  if (present("body guard", environment(me)) && obj->query("class") == "official") {
    if (!userp(present("body guard", environment(me))))
      obj = present("body guard", environment(me));
  }
  if (present("taoist guard", environment(me)) && obj->query("class") == "taoist") {
    if (!userp(present("taoist guard", environment(me))))
      obj = present("taoist guard", environment(me));
  }
  if (present("jiguan guard", environment(me)) && (string)obj->query_temp("use_jiguan_ren")) {
    if (!userp(present("jiguan guard", environment(me))))
      obj = present("jiguan guard", environment(me));
  }
  callname = RANK_D->query_rude(obj);
  //        callname = " 地 方";
  if (userp(obj) &&
    (int)obj->query("combat_exp") < LOWER_LIMIT &&
    (int)me->query("combat_exp") > LOWER_LIMIT
  )
    me->add("kill_player_record", random(100));
  if (userp(obj) && ((int)me->query("combat_exp") - (int)obj->query("combat_exp")) > 5000)
    me->add("kill_player_record", random(99) + 1);
  //		return notify_fail("唉！你可不可以改掉以强凌弱的恶习？\n");
  if (userp(obj))
    log_file("KILL_LOG", sprintf("(%s)
%s tried to kill %s\n", ctime(time()), me->query("name"), obj->query("name")));
  message_vision("\n$N对著$n喝道：「"
    +callname + "！今日不是你死就是我活！」\n\n", me, obj);

  me->kill_ob(obj);

  if (!userp(obj) && obj->query("mguard")) obj->remove_busy();
  if (!userp(obj) && obj->query("jgguard")) obj->remove_busy();

  if (!userp(obj)) {
    if (obj->query("daode") > 0 &&
      me->query("life_exp") > 10) me->add("life_exp", -1);
    obj->kill_ob(me);
  } else {
    obj->fight_ob(me);
    tell_object(obj, HIR "如果你要和" + me->name()
      + "性命相搏，请你也对这个人下一次 kill 指令。\n" NOR);
  }
  if (!me->query_delay()) me->set_delay(1);
  if (!obj->query_delay()) obj->set_delay(1);
  return 1;
}
int help(object me) {
  write(@HELP
指令格式 : kill <人物>
 
这个指令让你主动开始攻击一个人物，并且□试杀死对方，kill 和 fight 最大的
不同在於双方将会真刀实枪地打斗，也就是说，会真的受伤。由於 kill 只需单方
面一厢情愿就可以成立，因此你对任何人使用 kill 指令都会开始战斗，通常如果
对方是 NPC 的话，他们也会同样对你使用 kill。

当有人对你使用 kill 指令时会出现红色的字样警告你，对於一个玩家而言，如果
你没有对一名敌人使用过 kill 指令，就不会将对方真的打伤或杀死( 使用法术除
外)。

其他相关指令: fight

有关 fight 跟 kill 的区分请看 'help combat'.
HELP
  );
  return 1;
}
