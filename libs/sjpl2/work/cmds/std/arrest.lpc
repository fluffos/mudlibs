//拘捕  /d/cmds/std/arrest.c
#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string str) {
  object ob, where, fakeob;
  int reward;
  if ((string)me->query("class") != "official")
    return notify_fail("干什么？\n");
  if ((int)me->query("id_type") != 5)
    return notify_fail("什么？\n");
  if (me->query("battle_slg_mode"))
    return notify_fail("正在战略模式中，没有提供该指令。\n");
  if (environment(me)->query("no_arrest"))
    //	if( environment(me)->query("no_fight") )
    return notify_fail("这里不准战斗。\n");
  if (!str)
    return notify_fail("你要拘捕谁？\n");
  if (str == "biao che")
    return notify_fail("你要拘捕谁？\n");
  if (str == "toushi che")
    return notify_fail("你要拘捕谁？\n");
  if ((int)me->query("sen") < 30)
    return notify_fail("你的精神没有办法有效集中！\n");
  me->receive_damage("sen", 20);

  if (me->query_temp("sleeping")) return notify_fail("你正在睡眠中。\n");
  if (me->query_delay())
    return notify_fail("你现在心绪紊乱，不能拘捕。\n");
  if (me->query_wait())
    return notify_fail("你现在无法实施拘捕。\n");

  if (!objectp(ob = present(str, environment(me))))
    return notify_fail("这里没有这个人。\n");
  ob = present(str, environment(me));
  if (!ob->is_character() || ob->is_corpse())
    return notify_fail("看清楚一点，那并不是活物。\n");

  if ((string)ob->query("id") == "wulin renshi" || (string)ob->query("id") == "jin shi")
    return notify_fail("你无法进行拘捕。\n");
  if (ob == me)
    return notify_fail("你想拘捕自己？\n");
  where = environment(ob);
  if (!where) return notify_fail("你现在没法实施拘捕。\n");
  if (ob->query("family/family_name") == "朝廷")
    return notify_fail("你不可拘捕朝廷官员！\n");
  if (ob->query("class") == "official")
    return notify_fail("你不可拘捕朝廷官员！\n");

  message_vision(HIR "\n$N取出手铐脚镣，大喝一声，冲上去就要拘捕$n！\n" NOR, me, ob);
  me->kill_ob(ob);
  if ((int)me->query("combat_exp") * 3 < (int)ob->query("combat_exp")) {
    me->set_delay(1); return 1;
  }
  if ((int)ob->query("kee") < (int)ob->query("max_kee") / 2) {
    message_vision(HIC "\n$N将$n掀翻在地，哗啦啦地给$n戴上了手铐脚镣！\n" NOR, me, ob);
    seteuid(getuid());
    if ((int)me->query_temp("arrest/reward") > 0) {
      reward = (int)me->query_temp("arrest/reward");
      me->add("combat_exp", reward);
      me->add("potential", reward / 5);
      me->set_temp("arrest/reward", 0);
    }
    me->remove_all_killer();
    fakeob = new("/obj/npc/arrestman");
    fakeob->move(where);
    fakeob->set("name", (string)ob->name());
    fakeob->set("id", (string)ob->query("id"));
    fakeob->set("gender", (string)ob->query("gender"));
    fakeob->set("age", (string)ob->query("age"));
    fakeob->set("title", "朝廷钦犯");
    fakeob->set("nickname", (string)ob->query("nickname"));
    fakeob->set_leader(me);
    if (!ob) return 1;
    ob->move("/d/city/dilao0");
    message_vision(HIR "\n$N被押了进来。\n" NOR, ob);
    ob->remove_all_killer();
    if (!userp(ob)) { ob->die(); return 1; }
    ob->start_busy(1);
    ob->set_wait(60);
    ob->set_delay(60);
    //	ob->unconcious();
    return 1;
  }
  me->set_delay(1);
  return 1;
}
