//     /cmds/std/walk.c

#include <ansi.h>

inherit F_CLEAN_UP;


int main(object me, string arg) {

  if (!me->query_temp("sleeping")) return notify_fail("你揉揉眼睛，好象有点累了。\n");

  message_vision(
    HIC "$N你揉揉眼睛，清醒了过来。\n" NOR, me);
  me->delete_temp("sleeping");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : wake
    从睡梦中醒过来。当你正在睡眠中遇到危险，一定要尽快醒过来。
HELP
  );
  return 1;
}
