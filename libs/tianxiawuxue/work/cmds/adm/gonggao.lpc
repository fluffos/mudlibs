
// gonggao.c
#include <ansi.h>;
inherit F_CLEAN_UP;

int main(object me, string arg)
{
   if( !wizardp(me) )
       return notify_fail("玩家不能使用巫师专用公告系统。\n");
   if (!arg) return notify_fail("你想要大叫什么?\n");
   shout( me->name() +HIY"发出巫师公告：" + arg + "\n"NOR);
   write( me->name() +HIY"发出巫师公告：" + arg + "\n"NOR);
   return 1;
}
int help(object me)
{
  write(@HELP
 指令格式 :gonggao <讯息>
 
这个指令让你将 <讯息> 传送出去, 所有正在游戏中的人都
会听见你的话.
 
see also : tune
HELP
    );
    return 1;
}
 

