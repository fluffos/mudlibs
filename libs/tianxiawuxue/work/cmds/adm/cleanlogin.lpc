inherit F_CLEAN_UP;
int main(object me) {
  object *ob;
  int i = 0;
  ob = children(LOGIN_OB);
  i = sizeof(ob);
  while (i--) {
    if (!interactive(ob[i]))
      ob[i]->time_out();
    if (!(i % 50)) reset_eval_cost();
  }
  return 1;
}
