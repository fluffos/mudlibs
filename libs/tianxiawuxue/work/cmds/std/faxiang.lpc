#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  object *bh = ({}), lp, *ulist;
  string banghui;
  int k, count, piece, rest_money, reward_money, reward;

  if (!stringp(banghui = me->query("banghui"))
    || me->query("bh/rank_lv") < 7)
    return notify_fail("你无权在帮会内进行发饷。\n");

  if (NATURE_D->query_dipan_check())
    return notify_fail("请稍侯，目前各地盘正在清点中，请过会使用该指令。\n");

  lp = new("/clone/misc/lingpai");
  lp->create(banghui);
  if (lp->query("no_use")) {
    destruct(lp);
    return notify_fail("你的帮会文件有问题，请与巫师联系。\n");
  }

  if (!arg || !sscanf(arg, "%d", rest_money) || rest_money < 1)
    return notify_fail("你准备用多少钱(gold)来进行此次发饷？\n");

  rest_money = rest_money * 10000;
  if (rest_money < 0) rest_money = 0;
  if (rest_money > 2000000000) rest_money = 2000000000;

  if (lp->query("money") <
    //                      rest_money+(sizeof(lp->query("area"))+1)*100000000 )
    rest_money + 100000000)
    return notify_fail("帮中现在没有这么多钱可供调用。\n");

  lp->add("money", -rest_money);
  lp->set("last_money", rest_money);
  lp->save();
  destruct(lp);

  ulist = users();
  for (k = 0, piece = 0, count = 0; k < sizeof(ulist); k++) {
    if (!environment(ulist[k]) || !ulist[k]->query("banghui")
      || ulist[k]->query("banghui") != banghui)
      continue;
    bh += ({ ulist[k] });
    count++;
    piece += 1 + ulist[k]->query("bh/rank_lv");
  }

  if (count) {
    rest_money = rest_money / piece;
    for (k = 0; k < count; k++) {
      reward_money = rest_money * (bh[k]->query("bh/rank_lv") + 1);
      tell_object(bh[k], "「" + banghui
        + "」" + "发饷，你的帐上增加了"
        +MONEY_D->money_str(reward_money) + "！\n");

      if (bh[k]->query("bunch/quest") >= 4) {
        reward = reward_money / 10000;
        reward = reward * (random(4) + 1);
        bh[k]->add("combat_exp", reward);
        bh[k]->add("potential", reward / 3);
        bh[k]->add("score", reward / 50);
        tell_object(bh[k], HIG "由于你积极为帮会振兴"
          + "做贡献，「" + banghui + "」" + "奖励你\n"
          +chinese_number(reward) + "点经验、"
          +chinese_number(reward / 3) + "点潜能和"
          +chinese_number(reward / 50) + "点综合评价！\n" NOR);
        bh[k]->set("bunch/quest", 0);
      }
      reward_money = bh[k]->query("money") + reward_money;
      if (reward_money > 2000000000 || reward_money < 0) {
        bh[k]->set("money", 2000000000);
      } else
        bh[k]->set("money", reward_money);
    }
  }
  for (k = 0; k < sizeof(ulist); k++) {
    if ((int)ulist[k]->query("money") > 2100000000) {
      ulist[k]->set("money", 2100000000);
      tell_object(ulist[k], RED "你在钱庄的钱已达到二一万两黄金，快点花吧！\n" NOR);
    }
  }

  return 1;
}

int help(object me) {
  write(@HELP

指令格式：faxiang [黄金数量] 

用于在本帮内发饷，所有在线帮会成员将获得一定的帮会收入。

HELP
  );
  return 1;
}
