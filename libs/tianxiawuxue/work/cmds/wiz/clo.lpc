 // checklogob.c
// writen by wings@HC

inherit F_CLEAN_UP;

int main(object me)
{
        object *obTemp;
        string szOutput;
   int nCnt;
   int nTotal,nInteractive = 0,nHavenobody = 0;
   
   szOutput = "";
   obTemp = children(LOGIN_OB);
   nTotal = nCnt = sizeof(obTemp);
   
   while(nCnt--){
        if ( !interactive(obTemp[nCnt]) ){
                if ( !obTemp[nCnt]->query_temp("body_ob") )
                        nHavenobody ++;
                else
                        szOutput += sprintf("%O\n",obTemp[nCnt]->query_temp("body_ob"));
                nInteractive++;
        }
        }
           
        write(sprintf("Total:%d\tNo Interactive:%d\t:Have No Body:%d\n",nTotal,nInteractive,nHavenobody));
        write(szOutput);
        
        return 1;
}
