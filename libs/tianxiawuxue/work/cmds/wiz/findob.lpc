// findob.c

inherit F_CLEAN_UP;

int main(object me,string arg)
{
        object ob;
        
        ob = find_object(arg);
        
        if ( ob ){
                write(sprintf("物件:%O\n环境:%O\n",ob,environment(ob)));
                return 1;
        }
        
        return notify_fail("没有这样的物件！\n");
}
