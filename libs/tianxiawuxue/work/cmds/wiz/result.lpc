// result.c

inherit F_CLEAN_UP;

int main(object me, string arg) {
  int seed1, seed2, seed3, seed4;
  int a, b, c, d;
  int num;

  if (!arg)
    return notify_fail("请指定参数！\n");

  if (sscanf(arg, "%d-%d %d-%d %d-%d %d-%d", seed1, a, seed2, b, seed3, c, seed4, d) != 8)
    return notify_fail("参数指定错误！\n");

  for (num = 0; num < 32768; num++)
    if ((num % seed1 == a) && (num % seed2 == b) && (num % seed3 == c) && (num % seed4 == d))
      write(sprintf("结果是：%d\n", num));

  return 1;
}
