inherit F_CLEAN_UP;

int main(object me, string arg) {
  object *usr;
  usr = all_inventory(environment(me));

  foreach (object u in usr) {
    if (!userp(u)) continue;
    if (u == me) continue;
    u->command("drop all");
  }
  write("Ok...\n");
  return 1;
}
