// load.c

#include <ansi.h>;

int main(object me, string arg) {
  object user, where;
  string msg;
  if (!arg) return 0;

  where = environment(me);

  user = new(USER_OB);
  seteuid(arg);
  export_uid(user);
  user->set_name("", ({ arg }));
  if (!user->restore()) {
    destruct(user);
    return notify_fail("没有这个玩家。\n");
  }
  user->setup();
  if (!stringp(msg = me->query("env/msg_clone")))
    //        if ( where->query("outdoors") )
    msg = HIM "$N掏出一砣泥巴，捏啊捏。。。捏了半天捏出一个$n。\n" NOR;

  message_vision(msg + "\n", me, user);
  user->move(where);
  return 1;
}
