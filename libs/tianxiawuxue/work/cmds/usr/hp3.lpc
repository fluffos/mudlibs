#include <ansi.h>
inherit F_CLEAN_UP;
string status_color(int current, int max);
int potential_lv(int exp);
int main(object me, string arg) {
  object ob;
  mapping my;
  seteuid(getuid());
  if (!arg) ob = me;
  /*      //原文件的me->query("couple/child") == ob->query("id")中。
        //ob并未定义对象，引发object got 0。
        else if (wizardp(me) || me->query("couple/child") == ob->query("id"))
        {
                ob = present(arg, environment(me));
                if (!ob) ob = find_player(arg);
                if (!ob) ob = find_living(arg);
                if (!ob) return notify_fail("您要察看谁的状态？\n");
        }else return notify_fail("只有巫师才可以察看别人的状态。\n");
*/
  else if (wizardp(me)) {
    ob = present(arg, environment(me));
    if (!ob) ob = find_player(arg);
    if (!ob) ob = find_living(arg);
    if (!ob) return notify_fail("您要察看谁的状态？\n");
  } else if (me->query("couple/child") && arg == me->query("couple/child")) {
    ob = present(arg, environment(me));
    if (!ob)
      return notify_fail("只有巫师才可以察看别人的状态。\n");
  } else return notify_fail("只有巫师才可以察看别人的状态。\n");
  //      现改为以上代码。
  my = ob->query_entire_dbase();
  printf(NOR WHT "\n┏━━━━━━━━━━━━━━━" BLINK + HIR "天" HIG "下" HIW "无" HIC "雪" NOR "" WHT "━━━━━━━━━━━━━━┓\n" NOR);
  printf(NOR WHT "┃" NOR HIY "名称：『" NOR HIR "%-24s" NOR HIY "』" NOR
    HIY "       门派:『" NOR HIR "%-8s" NOR HIY "』" NOR WHT "        ┃\n" NOR,
    ob->name() + "☆" + ob->query("id") + "☆", capitalize(ob->query("family/family_name")));
  printf(NOR WHT "┣━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┫\n" NOR);
  printf(WHT "┃" NOR "" HIR "『" HIR "气血" HIR "』%s%8d/%8d %s(%3d%%)" NOR,
    status_color(my["qi"], my["eff_qi"]), my["qi"], my["eff_qi"],
    status_color(my["eff_qi"], my["max_qi"]), my["eff_qi"] * 100 / my["max_qi"]);
  printf(HIR "  『内力』%s%8d/%8d (+%3d)" NOR WHT "┃\n" NOR,
    status_color(my["neili"], my["max_neili"]), my["neili"],
    my["max_neili"], my["jiali"]);
  printf(WHT "┃" NOR "" HIR "『" RED "精神" HIR "』%s%8d/%8d %s(%3d%%)" NOR,
    status_color(my["jing"], my["eff_jing"]), my["jing"], my["eff_jing"],
    status_color(my["eff_jing"], my["max_jing"]), my["eff_jing"] * 100 / my["max_jing"]);
  printf(HIR "  『" HIY "精力" HIR "』%s%8d/%8d (+%3d)" NOR WHT "┃\n" NOR,
    status_color(my["jingli"], my["max_jingli"]),
    my["jingli"], my["max_jingli"], my["jiajing"]);
  printf(WHT "┃" NOR "" YEL "『食物』%s%8d/%8d [%3d%%]" NOR,
    status_color(my["food"], ob->max_food_capacity()),
    my["food"], ob->max_food_capacity(), my["food"] * 100 / ob->max_food_capacity());
  printf(YEL "  『潜能』   %s%21-d" NOR WHT "┃\n" NOR,
    HIY, (int)ob->query("potential") - (int)ob->query("learned_points"),
    potential_lv(my["combat_exp"]));
  printf(WHT "┃" NOR "" CYN "『饮水』%s%8d/%8d [%3d%%]" NOR,
    status_color(my["water"], ob->max_water_capacity()),
    my["water"], ob->max_water_capacity(), my["water"] * 100 / ob->max_water_capacity());
  printf(CYN "  『经验』   %s%21-d" NOR WHT "┃\n" HIG, HIM, my["combat_exp"]);
  printf(WHT "┃" NOR "" CYN "『评价』      %s%20-d" NOR,
    status_color(my["score"], ob->max_water_capacity()),
    my["score"], ob->max_water_capacity(), my["score"] / ob->max_water_capacity());
  printf(CYN "『 神 』   %s%21-d" NOR WHT "┃\n" HIG, HIR, my["shen"]);
  printf(NOR WHT "┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛\n" NOR);
  return 1;
}
string status_color(int current, int max) {
  int percent;
  if (max > 0) percent = current * 100 / max;
  else percent = 100;
  if (percent > 100) return HIC;
  if (percent >= 90) return HIG;
  if (percent >= 60) return HIY;
  if (percent >= 30) return YEL;
  if (percent >= 10) return HIR;
  return RED;
}

int potential_lv(int exp) {
  int grade;
  grade = 100 + exp / 500;
  return grade;
}

int help(object me) {
  write(@HELP
指令格式 : hp
           hp <对象名称>                   (巫师专用)
这个指令可以显示你(你)或指定对象(含怪物)的精, 气, 神数值。
相关指令： score
HELP);
  return 1;
}
