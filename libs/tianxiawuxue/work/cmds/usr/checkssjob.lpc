// checkssjob command..
// knightly
// 检测玩家当前嵩山派任务数据


#include <ansi.h>
inherit F_CLEAN_UP;
int main(object me, string arg) {
  object player, askob;
  string bh;
  int all, done, exp, pot, fcount, losspay, getpay, leave, loopcount;
  string name, id, family, area, pos;

  if (!arg) {
    player = me;
  } else {
    if (!wizardp(me)) {
      player = me;
    } else {
      player = find_living(arg);
      if (!player)
        return notify_fail("你要查看谁的嵩山任务状态？\n");
    }
  }

  all = player->query("family_job/songshan/getcount");
  done = player->query("family_job/songshan/donecount");
  exp = player->query("family_job/songshan/reward_exp");
  pot = player->query("family_job/songshan/reward_potential");
  fcount = player->query("family_job/songshan/losscount");
  losspay = player->query("family_job/songshan/losspay");
  getpay = player->query("family_job/songshan/getpay");
  loopcount = player->query_temp("family_job/songshan/loopcount");

  write("----------" + HIG + player->query("name") + "(" + player->query("id") + ")的嵩山任务情况如下" NOR + "-----------\n");
  write("共领取任务" HIY + CHINESE_D->chinese_number(all) + NOR "个\n");
  write("成功" HIY + CHINESE_D->chinese_number(done) + NOR "个\n");
  write("获取经验" HIY + CHINESE_D->chinese_number(exp) + NOR "点\n");
  write("获取潜能" HIY + CHINESE_D->chinese_number(pot) + NOR "点\n");
  write("失败" HIR + CHINESE_D->chinese_number(fcount) + NOR "个\n");
  write("损失师门忠诚" HIR + CHINESE_D->chinese_number(losspay) + NOR "点\n");
  write("当前师门忠诚" HIY + CHINESE_D->chinese_number(getpay) + NOR "点\n");
  write("目前连续完成" + HIY + CHINESE_D->chinese_number(loopcount) + NOR "个任务\n");
  if ((int)player->query("family_job/songshan/getjob") == 1) {
    if ((int)player->query("family_job/songshan/done") == 1) {
      write(HIY "当前已领取任务，并已完成，尚未复命\n" NOR);
    } else if (player->query("family_job/songshan/npcflee", 1)) {
      write(HIG "任务NPC已经溜掉了\n" NOR);
    } else if (player->query_temp("family_job/songshan/needfanxing", 1)) {
      write(HIG "任务npc溜掉了，正处于反省期\n" NOR);
    } else if ((int)player->query("family_job/songshan/done") == 0) {
      write(HIR "当前已领取任务，尚未完成。\n" NOR);
      if (wizardp(me)) {
        name = player->query_temp("family_job/songshan/killername");
        id = player->query_temp("family_job/songshan/killerid");
        family = player->query_temp("family_job/songshan/family");
        area = player->query_temp("family_job/songshan/area");

        write(HIW "当前任务状态\n" NOR);
        write("任务 NPC：" + name + "(" + id + ")\n");
        write("出现门派：" + family + "\n");
        write("初始地点：" + area + "\n");

        askob = present(id, environment(me));
        if (!askob)
          askob = find_living(id);
        if (!askob) {
          leave = 1;
        } else {
          leave = 0;
        }

        if (leave == 1) {
          write(HIB "NPC已经消失\n" NOR);
        } else {
          pos = environment(askob)->query("short");
          write(HIC "当前位置：" + pos + "\n" NOR);
        }
      }
    }
  } else {
    write(HIW "当前未领取任务。\n" NOR);
  }

  write("-------------------------END-----------------------\n");

  return 1;
}
int help(object me) {
  write(@HELP
指令格式 : bh <内容>

本指令用于查看嵩山门派任务状态。

HELP
  );
  return 1;
}
