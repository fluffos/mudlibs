#include <ansi.h>

inherit F_CLEAN_UP;

string tribar_graph(int val, int eff, int max, string bcolor, string fcolor, string dcolor)
{
        string ret;
        int i, n, eff_n, max_n = 5;

        if( max == 0 ) max = 1;
        n = val * 100 / max / 20;
        eff_n = eff * 100 / max / 20;

        if( n < 0 ) n = 0;
        if( eff_n < 0 ) eff_n = 0;
        if( n > max_n ) n = max_n;
        if( eff_n > max_n ) eff_n = max_n;

        ret = NOR "[" NOR;
        for( i = 0 ; i < max_n; i ++ ) {
        if( i > eff_n ) ret += GRN;
        if( i < n )  ret += BLU"─"NOR;
                else ret += RED"─"NOR;
        }
        ret += HIG + NOR"]" NOR;
        return ret;
}

