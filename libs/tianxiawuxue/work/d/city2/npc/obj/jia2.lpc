
#include <armor.h>
inherit CLOTH;
void create()
{
        set_name(HIW"琉银甲"NOR, ({ "liuyin jia", "jia" }) );
        set_weight(10000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "块");
                set("material", "cloth");
                set("for_create_cloth",1);
		set("base_armor",20);
                set("armor_prop/armor", 500);
		set("long","这是皇宫侍卫用的琉银甲, 看起来非常坚硬。\n");
		set("value",2000000);
        }
        setup();
}