// gangdao.c

#include <weapon.h>
inherit BLADE;

void create() {
  set_name(HIY "琉金刀" NOR, ({ "liujin blade", "blade" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "这是一柄亮金金的琉金刀，是大内卫士的专有武器。\n");
    set("value", 5000000);
    set("material", "steel");
    set("wield_msg", HIG "$N「唰」的一声抽出一柄$n" + HIG "握在手中。\n" NOR);
    set("unwield_msg", HIG "$N将手中的$n" + HIG "插回背上刀鞘。\n" NOR);
  }
  init_blade(800);
  setup();
}
