#include <armor.h>
inherit CLOTH;
void create() {
  set_name(HIY "琉金甲" NOR, ({ "liujin jia", "jia" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("material", "cloth");
    set("for_create_cloth", 1);
    set("base_armor", 20);
    set("armor_prop/armor", 1000);
    set("long", "这是皇宫侍卫用的琉金甲, 看起来非常坚硬。\n");
    set("value", 5000000);
  }
  setup();
}
