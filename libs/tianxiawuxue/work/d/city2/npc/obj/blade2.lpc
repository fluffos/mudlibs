// gangdao.c

#include <weapon.h>
inherit BLADE;

void create()
{
	set_name(HIW"琉银刀"NOR, ({ "liuyin blade", "blade" }));
	set_weight(10000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "柄");
		set("long", "这是一柄亮金金的琉银刀，是大内卫士的专有武器。\n");
		set("value", 2000000);
		set("material", "steel");
		set("wield_msg", HIC"$N「唰」的一声抽出一柄$n" +HIC"握在手中。\n"NOR);
		set("unwield_msg", HIC"$N将手中的$n" +HIC"插回背上的刀鞘。\n"NOR);
	}
	init_blade(400);
	setup();
}
