inherit NPC;
void create()
{
    set_name("御前带刀侍卫", ({ "shi wei", "shi", "wei" }));
    set("nickname",HIR"四品"NOR);
    set("gender", "男性");
    set("age", random(20) + 30);
    set("str", 300);
    set("dex", 50);
    set("long", "他手握琉金刀，目视前方，真是威风凛凛。\n");
    set("combat_exp", 600000000);
    set("attitude", "peaceful");
    set_skill("unarmed", 2500);
   set("max_qi",700000);
   set("max_jing",700000);
    set_skill("force", 5001);
    set_skill("blade", 2500);
    set_skill("dodge", 3400);
    set_skill("parry", 2500);
    set_skill("wuhu-duanmendao", 2500);
    set_skill("sougu", 2500);
    set_skill("yunlong-shenfa", 2500);
    map_skill("blade", "wuhu-duanmendao");
    map_skill("unarmed", "sougu");
    map_skill("dodge", "yunlong-shenfa");
    map_skill("parry","wuhu-duanmendao");
    set_temp("apply/attack", 100);
    set_temp("apply/defense", 100);
    set("neili", 10000000); 
    set("max_neili", 20000);
    set("max_jingli", 20000);
    set("jingli", 50000);
    set("jiali", 3000);
    set("chat_chance_combat", 50);  
    set("chat_msg_combat", ({
                (: perform_action, "unarmed.muyeyingyang" :),
		  (: perform_action, "blade.duan" :),
                        }) );
  
    setup();
    carry_object(__DIR__"obj/blade1")->wield();
    carry_object(__DIR__"obj/jia1")->wear();
    add_money("gold", random(300));
}
void init()
{
    object ob;
    if ( ! environment() ) return;
    ::init();
    if (interactive(ob = this_player()) && 
        (int)ob->query_condition("killer")) {
        remove_call_out("kill_ob");
        call_out("kill_ob", 1, ob);
    }
        add_action("do_kill","kill");
        add_action("do_kill","hit");
}

int do_kill(string arg)
{
        object ob;
        if (living(this_object()) && this_object()->id(arg)){
                command("say 想打架？兄弟们，上！");
                if (ob=present("shi wei",environment()))
                        ob->kill_ob(this_player());
                if (ob=present("jinwei bing",environment()))
                        ob->kill_ob(this_player());
        }
        return 0;
}
int accept_fight(object me)
{
        command("say 大爷我正想找人杀呐，今天算你倒霉。\n");
        me->apply_condition("killer", 500);
        kill_ob(me);
        return 1;
}