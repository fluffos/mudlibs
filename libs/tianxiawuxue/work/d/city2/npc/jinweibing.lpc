inherit NPC;
void create() {
  set_name(HIW "禁卫兵" NOR, ({ "jinwei bing", "bing" }));
  set("nickname", MAG "紫禁城" NOR);
  set("age", 22);
  set("gender", "男性");
  set("long", "虽然官兵的武艺不能和武林人士相比，可是他们讲究的是人多力量大。\n");
  set("attitude", "peaceful");
  set("str", 50);
  set("dex", 50);
  set("neili", 500000);
  set("max_neili", 20000);
  set("max_jingli", 10000);
  set("jingli", 30000);
  set("jiali", 1000);
  set("combat_exp", 100000000);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed.muyeyingyang" :),
  }));
  set_skill("unarmed", 540);
  set_skill("dodge", 3500);
  set_skill("sougu", 540);
  set_skill("parry", 540);
  set_skill("blade", 540);
  set_skill("force", 540);
  set_skill("tiangang-blade", 540);
  map_skill("blade", "tiangang-blade");
  map_skill("unarmed", "sougu");
  set_temp("apply/attack", 540);
  set_temp("apply/defense", 540);
  set("chat_chance_combat", 10);
  set("chat_msg_combat", ({
    "禁卫兵喝道：大胆刁民，竟敢造反不成？\n",
    "禁卫兵喝道：跑得了和尚跑不了庙，你还是快快束手就擒！\n",
  }));

  setup();
  carry_object(__DIR__ "obj/blade2")->wield();
  carry_object(__DIR__ "obj/jia2")->wear();
  add_money("gold", random(200));
}
void init() {
  object ob;
  if (!environment()) return;
  ::init();
  if (!living(this_object())) return;
  if (interactive(ob = this_player())) {
    if ((int)ob->query_condition("killer")) {
      command("say 哈！总算给大爷逮住了，杀人犯，那里逃？\n");
      remove_call_out("kill_ob");
      call_out("kill_ob", 1, ob);
    }
    if (this_player()->query_temp("illicit")) {
      command("say 盐枭！那里逃？\n");
      remove_call_out("kill_ob");
      call_out("kill_ob", 1, ob);
    }
  }
  add_action("do_kill", "kill");
  add_action("do_kill", "hit");
}
int do_kill(string arg) {
  object ob;
  if (living(this_object()) && this_object()->id(arg)) {
    command("say 想打架？兄弟们，上！");
    if (ob = present("shi wei", environment()))
      ob->kill_ob(this_player());
    if (ob = present("jinwei bing", environment()))
      ob->kill_ob(this_player());
  }
  return 0;
}
int accept_fight(object me) {
  command("say 大爷我正想找人杀呐，今天算你倒霉。\n");
  me->apply_condition("killer", 500);
  kill_ob(me);
  return 1;
}
