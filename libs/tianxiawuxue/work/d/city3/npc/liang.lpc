#include <ansi.h>
inherit NPC;
string ask_me();

void create()
{
        set_name(HIR"诸葛亮"NOR, ({ "zhuge liang", "zhuge","liang" }) );
          set("nickname", HIY"诸葛武侯"NOR);
        set("gender", "男性" );
        set("age", 1800);
         set("long", YEL"这位三国时代的一代贤臣诸葛亮.\n"NOR);
        set("shen_type", 1);
        set("combat_exp", 1000000000);
        set("str", 300);
        set("dex", 300);
        set("con", 300);
        set("int", 300);
        set("per", 300);
        set("attitude", "friendly");
        set("max_qi", 1000000);
        set("neili", 1000000);
        set("max_neili", 100000);
        set("score", 1000000);

        set("inquiry", ([
                         "恢复" : (: ask_me :)
                         
        ]));
        setup();
}

string ask_me()
 {
        object me = this_player();
        mapping fam; 
        {
        	me->set("eff_jing", (int)me->query("max_jing"));
                me->set("eff_qi", (int)me->query("max_qi"));
me->start_busy(5);
                tell_object(this_player(),HIW "天神啊！让这个心灵受伤害的人重生吧！"NOR);;
                return "让这个心灵受伤害的人加入这个混乱的江湖吧!!!\n";
}
}
