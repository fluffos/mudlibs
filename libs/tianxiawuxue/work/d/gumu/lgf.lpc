// lgf.c

inherit ROOM;
#include <room.h>
#include <ansi.h>
void create()
{
    set("short", HIG"痴情居"NOR);
    set("long", @LONG
这是古墓内的一间石室。周围的火把将石室照的灯火通明，空旷的
一间石室，没有任何摆设。一个美人站在铜镜前不住的叹气，手中
握着一幅画卷（hua）。
LONG
        );

          set("item_desc", ([
          "hua" : "一个男人的画像，看样子已经保存了多年。画中的那男人相貌俊秀无比，举止无限风流，正是二十年前名动江湖的一代大侠--Hanchat。\n",
            ]));
            
    set("exits", ([
        "south" : __DIR__"shitou",
    ]));

    set("objects", ([
           __DIR__"npc/shiren" : 1,
           	"/d/gumu/hanchat/wendy" : 1,
    ]));

    setup();
}

