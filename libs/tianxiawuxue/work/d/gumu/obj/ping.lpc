// ping.c 蜂浆瓶
// 可以用来使用驱蜂之术，驱使玉蜂

#include <ansi.h>
inherit ITEM;
void init()
{
        add_action("do_qufeng","qufeng");
}

void create()
{
        set_name("蜂浆瓶", ({ "fengjiang ping", "ping" }) );
        set_weight(4500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
        set("unit", "个");
        set("value", 0);
        set("jian",5) ;
        set("material", "玉");
        set("long", "这是一个用上古美玉雕成的小瓶，还未拔开瓶塞，就可以闻到\n"
                    "一股浓郁的香味，可以用来驱蜂。\n") ;
        }
        setup();
}

int do_qufeng(string arg)
{
        object  me, obj;
        int     mylev,objlev;
        
        me = this_player();
        if( environment(me)->query("no_fight") )
                return notify_fail("这里禁止放蜂。\n");
        if( !arg )
                return notify_fail("你想驱蜂攻击谁？\n");
        if( this_object()->query("jian") <=0)
                return notify_fail("小瓶里的玉蜂蜜已经给用光了。\n");
         if (me->is_busy())
             return notify_fail("你正忙着呢！\n");

        foreach (obj in all_inventory(environment(me))){
            if (obj->query("id")== arg){
                if( !obj->is_character() || obj->is_corpse() )
                    return notify_fail("看清楚一点，那并不是活物。\n");
                if(obj == me)
                    return notify_fail("玉蜂不能攻击你。\n");
                if (obj->query("age")<18)
                    return notify_fail("玉蜂不能攻击"+obj->name()+"。\n");
                mylev =  me -> query_skill("qufeng",1 ) ;
                if ( mylev <= 0 )
                    return notify_fail("你不会驱蜂之术，不能驱使玉蜂为你攻击敌人！\n");
                if ( me->query("neili")<500 )
                    return notify_fail("你的内力不足以驱使玉蜂为你攻击敌人！\n");
                
                objlev = obj -> query_skill("qufeng",1 ) ;
                message_vision(HIY "\n$N拔开玉瓶塞，手捂玉瓶潜运内力，使得瓶中的香气远远飘了开去，\n"
                "突然嗡嗡之声大作，不知道从哪里飞来一大群玉蜂，向$n围了过去。\n" NOR,
                me, obj);
                me->add("neili",-500);
                me -> start_busy (3) ;
                this_object()->add("jian", -1);
                if (  random ( mylev ) < objlev *2 / 3 )
                    message_vision(YEL "\n但$n撮唇一啸，玉蜂似乎听懂了号令，远远避了开去。\n" NOR, me, obj);
                else {
                    message_vision (HIR "\n$N周围刹那间尽是玉蜂围绕，一只只玉蜂悍不畏死地向$N\n"
                        "蜇了过来，$N只觉得脸上微微一痛，已被玉蜂蜇中！\n" NOR,obj  ) ;
                    obj -> receive_damage ("jing", mylev * 3,me ) ;
                    obj -> receive_damage ("qi", mylev * 4,me ) ;
                    obj -> start_busy (3) ;
                    obj->add_temp("apply/personality",-15);
                    obj->set_temp("apply/long",({ obj->short()+"，\n"+gender_pronoun(obj->query("gender"))+"被玉蜂蜇得满脸浮肿，连五官都分不清位置了。\n" }));;
                }

                if( userp(obj) ) {       
                    obj -> fight_ob(me) ;
                    me->fight_ob(obj);
                } else {       
                    obj->kill_ob(me);
                    me->fight_ob(obj);
                }
          return 1;
            }
        }
        return notify_fail("这里没有这个人。\n");
}