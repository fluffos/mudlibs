#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create()
{
	set_name(HIW"Peter Hu"NOR, ({ "hanchat", "peter hu", "peter" }));
	set("nickname", HIG "无雪大神" NOR);
	set("gender", "男性");
	set("age", 21);
	set("int",3000);
	set("con",300);
	set("str", 300);
	set("dex", 300);
	set("long", "他是一位高大的男子，相貌俊秀。\n"+
	"原籍中国台湾，后移民新西兰，现在美国UIUC学习。\n"+
	"资深玩家，后受dream邀请加入@txwx 巫师组。\n");
	set("combat_exp", 50000000);
	set("score", 10000);
	set("shen_type", 1);
	set("attitude", "peaceful");
	set("shen", 100000);
	set("qi", 200000);
        set("max_qi", 20000);
        set("max_jing", 3000);
        set("neili", 100000);
        set("eff_jingli", 3000);
        set("max_neili", 10000);
        set("jiali", 2000);
	
	    set_skill("sword",600);
      set_skill("dodge",600);
      set_skill("unarmed",600);
        set_skill("force", 600);
        set_skill("yunu-shenfa", 600);
        set_skill("xuantie-jianfa", 600);
        set_skill("anranxiaohun-zhang", 600);
        set_skill("quanzhen-jianfa",600);
        set_skill("tianluo-diwang", 600);
        set_skill("parry", 600);
        set_skill("yunu-xinjing",600);
        set_skill("literate", 600); 
        map_skill("force", "yunu-xinjing");        
        map_skill("sword","xuantie-jianfa");
        map_skill("dodge", "yunu-shenfa");
        map_skill("parry", "anran-xiaohunzhang");        
        map_skill("strike", "anran-xiaohunzhang");        
        prepare_skill("strike","anran-xiaohunzhang");
        set("chat_chance_combat", 100);
        set("chat_msg_combat", ({
                (: perform_action, "sword.haichao" :),
        }));
    
        set("inquiry", ([
                "王颖" : "她是我的爱人，现在不知道身在何方？\n",
                "hanchat" : "正是小弟，不知找在下有什么事情？\n",
                "Peter hu" : "也是小弟我！\n",
                "jojo" : "他是我的兄弟，你认识他嘛？\n",
                "dream" : "连他你就不认识，你还在这里混什么混？滚回家玩泥巴去吧！\n",
       ]) );
       create_family("古墓派", 4, "弟子");
	setup();
	carry_object(__DIR__"obj/jian1")->wield();
	carry_object(__DIR__"obj/jian2")->wield();	
  carry_object("/d/gumu/obj/buxue1")->wear();
  carry_object("/d/gumu/obj/pao1")->wear();    
	add_money("gold", 200);
}

void attempt_apprentice(object ob)
{

     mapping fam = ob->query("family");
     if (!fam || fam["family_name"] != "古墓派"){
              command("say "+RANK_D->query_respect(ob)+"与本派素无来往，不知此话从何谈起？");
              return;
	 }
        if (ob->query_int() < 100) {
                command("say 我古墓派的功夫最讲一个悟字，你的资质不够。");
                return;
        }

        command("say 好吧，看你也是性情中人，我就收下你这个徒弟了。");
        command("recruit " + ob->query("id"));
	 ob->set("title",HIB+"古墓派传人"NOR);
	 ob->set("class","sworder");
}