#include <ansi.h>

inherit NPC;
inherit F_MASTER;

string ask_yunv();

void create() {
  set_name(HIW "王  颖" NOR, ({ "wang ying", "wang" }));
  set("gender", "女性");
  set("nickname", HIG "痴情公主" NOR);
  set("age", 20);
  set("long",
    "她就是古墓派的后起新秀，虽然只有二十许人，望之却\n"
    "还如同十几出头。当年她与wiz hanchat本是一对痴心爱侣，\n"
    "只可惜hanchat要出国求学，只得独自在这古墓上幽居。\n");
  set("attitude", "peaceful");

  set("per", 130);
  set("str", 137);
  set("int", 142);
  set("con", 145);
  set("dex", 142);

  set("chat_chance_combat", 6);
  set("chat_msg_combat", ({
    (: exert_function, "recover" :),
  }));
  set("chat_chance", 1);

  set("qi", 60000);
  set("max_qi", 60000);
  set("jing", 24000);
  set("max_jing", 24000);
  set("neili", 90000);
  set("max_neili", 90000);
  set("jiali", 2000);

  set("combat_exp", 50000000);

  set_skill("force", 600);
  set_skill("yunv-xinfa", 600);    //玉女心法
  set_skill("yunu-xinjing", 600);    //玉女心法
  set_skill("sword", 600);
  set_skill("yunv-jian", 600);     //玉女剑
  set_skill("dodge", 600);
  set_skill("yunu-shenfa", 600);   //玉女身法
  set_skill("parry", 600);
  set_skill("unarmed", 600);
  set_skill("meinu-quanfa", 600);    //美女拳法
  set_skill("literate", 1200);
  set_skill("taoism", 240);
  set_skill("hubo", 600);
  set_skill("quanzhen-jianfa", 600);

  map_skill("force", "yunv-xinfa");
  map_skill("sword", "yunv-jian");
  map_skill("dodge", "yunu-shenfa");
  map_skill("parry", "meinu-quanfa");
  map_skill("unarmed", "meinu-quanfa");
  create_family("古墓派", 4, "弟子");
  set("inquiry", ([
    "hanchat": "大胆后辈小子，也敢直呼hanchat之名？\n",
    "peter": "这是hanchat的真正名字。\n",
    "古墓派": "这里就是古墓派\n",
    "dream": "不认识，是那个瘪三阿？\n",

  ]));

  setup();

  carry_object(__DIR__ "obj/jian1")->wield();
  carry_object(__DIR__ "obj/jian2")->wield();
  carry_object("/d/gumu/obj/buxue1")->wear();
  carry_object("/d/gumu/obj/pao1")->wear();

}

void attempt_apprentice(object ob) {

  mapping fam = ob->query("family");
  if (!fam || fam["family_name"] != "古墓派") {
    command("say " + RANK_D->query_respect(ob) + "与本派素无来往，不知此话从何谈起？");
    return;
  }
  if (ob->query_int() < 50) {
    command("say 我古墓派的功夫最讲一个悟字，你的资质不够。");
    return;
  }
  /*
        if ((int)ob->query_skill("yunv-xinfa",1) < 270 ) {
                command("say 你的玉女心法火候不足,难以领略更高深的武功。");
                return;
        }
*/
  command("say 好吧，看你也是性情中人，我就收下你这个徒弟了。");
  command("recruit " + ob->query("id"));
  ob->set("title", HIB + "古墓派传人" + NOR);
  ob->set("class", "sworder");
}
