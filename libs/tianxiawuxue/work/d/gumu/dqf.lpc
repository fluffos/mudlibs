// lgf.c

inherit ROOM;
#include <room.h>
#include <ansi.h>
void create() {
  set("short", HIG "多情坊" NOR);
  set("long", @LONG
这是古墓内的一间石室。周围的火把将石室照的灯火通明，空旷的
一间石室，中堂挂着一幅字画（hua）。
LONG
  );

  set("item_desc", ([
    "hua": HIR "美人卷珠帘，\n"
    "深座蹙峨嵋。\n"
    "但见泪痕湿，\n"
    "不知心恨水。\n"
    HIW "---" HIG "hanchat" HIY " 题赠 " HIM "王颖\n" NOR,
  ]));

  set("exits", ([
    "west": "/d/gumu/shitou",
  ]));

  set("objects", ([
    __DIR__ "npc/shiren": 1,
    "/d/gumu/hanchat/hanchat": 1,
  ]));

  setup();
}
