#include <ansi.h>;
inherit F_MASTER;
inherit NPC;

void create()
{
 set_name("青青", ({ "qing qing","qing",}) );
	set("nickname", HIR"狐妖美人"NOR);
        set("long",
	    "她就是圆月山庄的庄主夫人,\n");
	set("gender", "女性" );
	set("age", 20);
	set("combat_exp", 100000000);
	set("shen_type",0);
	set("str", 1800);
	set("dex", 180);
	set("con", 180);
	set("int", 180);
	set("per", 99);

            set("qi", 200000);
	set("max_qi", 200000);
	set("jing", 200000);
    set("max_jing", 200000);
    set("neili", 200000);
    set("max_neili", 200000);
    set("jingli", 200000);
    set("max_jingli", 200000);
	set("jiali", 2500);

set_skill("force", 1000);
set_skill("dodge", 1000);
	set_skill("parry", 800);
	set_skill("unarmed",800);
set_skill("sword", 1000);
	set_skill("literate",1500);
	set_skill("flymoon-xinfa",1000);
	set_skill("flymoon-dance",1000);
	set_skill("flymoon-quanfa",800);
	set_skill("flymoon-sword",800);
	map_skill("unarmed", "flymoon-quanfa");
	map_skill("force", "flymoon-xinfa");
	map_skill("dodge", "flymoon-dance");
	map_skill("parry", "flymoon-sword");
	map_skill("sword", "flymoon-sword");
        create_family("圆月山庄",2,"庄主夫人");
        set("chat_chance_combat", 90);
        set("chat_msg_combat", ({
        (: perform_action, "sword.flymoon" :),
    }) );
        
        set("inquiry", 
                (["圆月弯刀"  : "要想学它就得去找我相公.",
                ]));
        
    setup();

     carry_object("/d/yuanyue/npc/obj/cloth")->wear();
     carry_object("/d/yuanyue/npc/obj/shenjian")->wield();
}

void attempt_apprentice(object ob)
{
               if((int)ob->query("kar")<30)
	{
		command("say 你不适合学习我的功夫。");
		return 0;
	}
	     if((string)ob->query("gender")!="男性")
	{
		command("say 你阳气不足，习我功夫恐将走火如魔。");
		return 0;
	}
                if ((int)ob->query_skill("sword", 1) < 800) {
                command("say 你基本功太差了，学不会我的功夫。"); 
                command("say " + RANK_D->query_respect(ob) + 
                        "你还是把基本功练好了在来找我！");
                return;
        }
        if ((int)ob->query_skill("flymoon-dance", 1) < 500) {
                command("say 你的轻功底子太差。"); 
                command("say " + RANK_D->query_respect(ob) + 
                        "你还是把轻功先提高了在来吧？");
                return;
        }
          if ((int)ob->query_skill("flymoon-xinfa", 1) < 500) {
                command("say 你的内功底子太差。"); 
                command("say " + RANK_D->query_respect(ob) + 
                        "你还是把内功先提高了在来吧？");
                return;
        }
       if ( (int)ob->query_skill("literate",1) < 1000)
    {
        command("say 我看" + RANK_D->query_respect(ob) + "的读书识字还没学到家吧。");
        return;
    }
    if (((int)ob->query("shen") < 0)||((int)ob->query("shen") > 0))
    {
        command("say 我圆月山庄不要江湖肖小之辈，你还是另投名师吧!");
        command("say 在德行方面，" + RANK_D->query_respect(ob) +
            "是否还做得不够？");
        return;
    }
    command("chat " + RANK_D->query_respect(ob) + "圆月山庄终于重出江湖了。");
    command("recruit " + ob->query("id"));
        ob->set("title",HIR"圆月山庄传人"NOR);
}
