#include <ansi.h>;
inherit F_MASTER;
inherit NPC;

void create() {
  set_name("门人", ({ "dizi", }));
  set("long",
    "他是圆月山庄的门人.\n");
  set("gender", "男性");
  set("age", 50);
  set("combat_exp", 8000000);
  set("shen_type", 0);
  set("str", 1000);
  set("dex", 300);
  set("con", 200);
  set("int", 200);
  set("per", 15);

  set("qi", 50000);
  set("max_qi", 50000);
  set("jing", 50000);
  set("max_jing", 50000);
  set("neili", 50000);
  set("max_neili", 50000);
  set("jingli", 50000);
  set("max_jingli", 50000);
  set("jiali", 1000);

  set_skill("force", 300);
  set_skill("dodge", 300);
  set_skill("parry", 300);
  set_skill("unarmed", 300);
  set_skill("sword", 300);
  set_skill("literate", 800);
  set_skill("flymoon-xinfa", 500);
  set_skill("flymoon-dance", 500);
  set_skill("flymoon-quanfa", 300);
  set_skill("flymoon-sword", 300);
  map_skill("unarmed", "flymoon-quanfa");
  map_skill("force", "flymoon-xinfa");
  map_skill("dodge", "flymoon-dance");
  map_skill("parry", "flymoon-sword");
  map_skill("sword", "flymoon-sword");
  create_family("圆月山庄", 3, "弟子");

  set("inquiry",
    ([ "圆月弯刀": "要想学它就得去找我家老爷.",
      "拜师": "最好先拜夫人."
    ]));

  setup();

  carry_object("/d/yuanyue/npc/obj/cloth")->wear();
  carry_object("/d/yuanyue/obj/changjian")->wield();
}

void attempt_apprentice(object ob) {
  if ((string)ob->query("gender") != "男性") {
    command("say 你阳气不足，习我功夫恐将走火如魔。");
    return 0;
  }

  if (((int)ob->query("shen") < 0) || ((int)ob->query("shen") > 0)) {
    command("say 我圆月山庄不要江湖肖小之辈，你还是另投名师吧!");
    command("say 在德行方面，" + RANK_D->query_respect(ob) +
      "是否还做得不够？");
    return;
  }
  command("chat " + RANK_D->query_respect(ob) + "圆月山庄终于重出江湖了。");
  command("recruit " + ob->query("id"));
  ob->set("title", HIR "圆月山庄门人" NOR);
}
