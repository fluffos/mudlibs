#include <weapon.h>
#include <ansi.h>
inherit SWORD;
void create()
{
        set_name( WHT "圆月神剑" NOR,  ({ "yuanyue jian", "sword", "jian" }));
        set_weight(20000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long", "一柄长剑，剑柄上雕有一轮圆月。\n");
                set("value", 100000);
                set("material", "gold");
                set("wield_msg", HIR "$N" HIR "抽出圆月神剑挥舞了个剑花，只感到一股凛冽的"
                                 NOR + HIW "寒气" NOR + HIR "扑面而来。\n" NOR);
                set("unwield_msg", HIR "$N" HIR "叹了口气，将圆月神剑插回背后。\n" NOR);

        }
        init_sword(100);
        setup();
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
        int pro;
        int extra;
        extra = (int) me->query("str");
        victim->receive_damage("qi", extra*10);
        return HIY "圆月神剑划出一道炽热的光芒，$n" HIY "只感到心神俱碎。\n" NOR;
}
