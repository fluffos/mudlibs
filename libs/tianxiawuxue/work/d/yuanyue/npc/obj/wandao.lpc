#include <weapon.h>
#include <ansi.h>
inherit BLADE;
void create()
{
        set_name( HIM "圆月弯刀" NOR,  ({ "yuanyue wandao", "blade", "wandao" }));
        set_weight(20000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long", "一柄弯弯的刀，刀身刻着<小楼一夜听春雨>七个字。\n");
                set("value", 100000);
                set("material", "gold");
                set("wield_msg", HIY "$N" HIW "抽出圆月弯刀挥舞了个半圆，只感到一股凛冽的"
                                 NOR + HIR "杀气" NOR + HIW "扑面而来。\n" NOR);
                set("unwield_msg", HIR "$N" HIR "叹了口气，将圆月弯刀插回背后。\n" NOR);

        }
        init_blade(100);
        setup();
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
        int pro;
        int extra;
        extra = (int) me->query("str");
        victim->receive_damage("jing", extra*20);
        return HIR "圆月弯刀发出一道慑人的邪气，$n" HIR "只感到心神俱碎。\n" NOR;
}
