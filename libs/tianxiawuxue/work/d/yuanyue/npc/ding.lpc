#include <ansi.h>;
inherit F_MASTER;
inherit BH_NPC;

void create() {
  set_name("丁鹏", ({ "ding peng", "ding", "peng" }));
  set("nickname", HIR "圆月魔刀" NOR);
  set("long",
    "他就是圆月山庄的庄主,\n" +
    "圆月魔刀的传人,如今江湖中像迷一样的人物,\n");
  set("gender", "男性");
  set("age", 28);
  set("attitude", "friendly");
  set("combat_exp", 200000000);
  set("shen_type", 0);
  set("str", 2800);
  set("dex", 180);
  set("con", 180);
  set("int", 180);

  set("qi", 500000);
  set("max_qi", 500000);
  set("jing", 500000);
  set("max_jing", 500000);
  set("neili", 500000);
  set("max_neili", 500000);
  set("jingli", 500000);
  set("max_jingli", 500000);
  set("jiali", 5000);

  set_skill("force", 1500);
  set_skill("dodge", 1500);
  set_skill("parry", 1500);
  set_skill("blade", 1500);
  set_skill("unarmed", 1500);
  set_skill("sword", 1500);
  set_skill("literate", 1500);
  set_skill("flymoon-xinfa", 1500);
  set_skill("flymoon-dance", 1000);
  set_skill("flymoon-quanfa", 1000);
  set_skill("yuanyue-wandao", 1000);
  set_skill("flymoon-sword", 1000);

  map_skill("unarmed", "flymoon-quanfa");
  map_skill("force", "flymoon-xinfa");
  map_skill("dodge", "flymoon-dance");
  map_skill("parry", "flymoon-sword");
  map_skill("sword", "flymoon-sword");
  map_skill("blade", "yuanyue-wandao");
  create_family("圆月山庄", 1, "庄主");
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "blade.modaozhan" :),
  }));


  set("inquiry",
    ([ "圆月弯刀": "想学就要看你的机缘如何了.",
      "圆月山庄": "山庄的事情你最好少管.",
      "青青": "她是我的夫人.",
      "拜师": "你可以先去拜我的夫人.",
    ]));

  setup();

  carry_object("/d/yuanyue/npc/obj/cloth")->wear();
  carry_object("/d/yuanyue/npc/obj/wandao")->wield();
}

void attempt_apprentice(object ob) {
  mapping fam = ob->query("family");
  if (!fam || fam["family_name"] != "圆月山庄") {
    command("say " + RANK_D->query_respect(ob) + "与本门素无来往，不知此话从何谈起？");
    return;
  }
  if ((int)ob->query_skill("blade", 1) < 800) {
    command("say 你基本功太差了，学不会我的功夫。");
    command("say " + RANK_D->query_respect(ob) +
      "你还是把基本刀法练好了在来找我！");
    return;
  }
  if ((int)ob->query_skill("flymoon-dance", 1) < 1000) {
    command("say 你的轻功底子太差。");
    command("say " + RANK_D->query_respect(ob) +
      "你还是把飞月舞先提高了在来吧？");
    return;
  }
  if ((int)ob->query_skill("flymoon-sword", 1) < 600) {
    command("say 你的剑法底子太差。");
    command("say " + RANK_D->query_respect(ob) +
      "你还是把飞月剑法先提高了在来吧？");
    return;
  }
  if ((int)ob->query_skill("flymoon-xinfa", 1) < 1000) {
    command("say 你的内功底子太差。");
    command("say " + RANK_D->query_respect(ob) +
      "你还是把飞月心法先提高了在来吧？");
    return;
  }
  if ((int)ob->query_skill("literate", 1) < 1000) {
    command("say 我看" + RANK_D->query_respect(ob) + "的读书识字还没学到家吧。");
    return;
  }
  if (((int)ob->query("shen") < 0) || ((int)ob->query("shen") > 0)) {
    command("say 我圆月山庄不要江湖肖小之辈，滚。");
    command("say 在德行方面，" + RANK_D->query_respect(ob) +
      "是否还做得不够？");
    return;
  }
  if ((int)ob->query_int() < 50) {
    command("say 依我看" + RANK_D->query_respect(ob) + "的资质似乎不适合学我圆月弯刀？");
    return;
  }
  command("chat " + RANK_D->query_respect(ob) + "哈哈......圆月山庄重出江湖了。");
  command("recruit " + ob->query("id"));
  ob->set("title", HIR "圆月魔刀传人" NOR);
}
