// Room: /yuanyue
// by hhm 2005/4/19
inherit ROOM;
void create()
{
	set("short", "圆月山庄大门");
        set("long",@LONG
这就是通向『圆月山庄』的大门。大门左右各有一片鲜花,香味
袭人，通过大门看进去，里面很多鲜花,你真的忍不住想要进去
看看。
LONG
	);
        set("exits", ([
		"north" : __DIR__"dating",
		"south" : __DIR__"xiaolu2",
        ]));

	set("objects",([
        "/d/yuanyue/npc/dizi" : 1,
	]));
	setup();
}

int valid_leave(object me, string dir)
{
	if (  (dir == "north")
           && ((string)me->query("family/family_name") != "圆月山庄")
	   && objectp(present("dizi", environment(me))) )
	 return notify_fail
		("看门人伸手拦住你，说道：“好像你不是圆月山庄的弟子，不要到处乱跑.”\n");
	return ::valid_leave(me, dir);
}
