inherit ROOM;
void create()
{
	set("short", "圆月山庄大厅");
        set("long",@LONG
这就是『圆月山庄』的大厅。大厅左右各有一片鲜花,香味
袭人，里面一个人都没有,空荡荡的.可以你总是感到一种莫
名的压力,让你喘不过起来.你不由得纳闷:难道这个地方就
是传说中的圆月山庄吗?
LONG
	);
        set("exits", ([
		"north" : __DIR__"changlang",
		"south" : __DIR__"damen",
        ]));
	setup();
}

