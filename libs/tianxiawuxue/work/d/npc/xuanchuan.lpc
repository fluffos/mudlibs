

#include <ansi.h>

inherit NPC;

void create()
{
        set_name(HIW"宣传使者"NOR, ({ "shizhe" }));
        set("gender", "女性");
        set("age", 19);
        set("combat_exp", 1000);
        set("shen_type", -1);
        set("attitude", "peaceful");
        
        set_skill("unarmed", 20);
        set_skill("dodge", 20);
        set_temp("apply/attack", 10);
        set_temp("apply/defense", 10);
        setup();
        carry_object("/clone/misc/hic_cloth")->wear();
        add_money("silver",2);
}
void init()
{
        object ob;
        ob = this_player();     
        ::init();
if( objectp(ob)&&interactive(ob) && !is_fighting() && random(10)>4 )
               {
                        remove_call_out("greeting");
                       call_out("greeting", 1, ob);
                }
}
void greeting(object ob)
{
    object *user = users();
    for (int i=0;i<sizeof(user);i++)
    {
    	"/adm/daemons/toptend"->topten_checkplayer(user[i]);
    	reset_eval_cost();
    }

   if( !ob || environment(ob) != environment() ) return;
     command("txwx " + HIM"\n
                       "HIR"天下无雪 "HIY"("HIG"IP: "HIW"txwx2.3322.org "HIG"Port: "HIW"6666"HIY")\n
                       "HIR"QQ群号码:"HIG"13182512    "HIR"Dream QQ号码:"HIG"9111813   \n
	                     "HIR"网站 :"HIG" http://txwx.go3.icpcn.com/    \n
	                     "HIR"论坛 :"HIG "http://mud9921.getbbs.com/    \n "NOR);
}

