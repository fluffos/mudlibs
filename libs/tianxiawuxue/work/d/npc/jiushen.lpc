int do_gongji(string arg)
{
        object me,ob;
        me = this_object();
        if(!arg||!objectp(ob=present(arg,environment(me))))
        return notify_fail("人不在着呢!!\n");
        message_vision(HIB"酒神"NOR + "对$N说道: 等下记得那几坛酒孝敬我啊!\n",this_player());
        command("heihei");
    me->kill_ob(ob);
    me->set_leader(ob);
    ob->kill_ob(me);

        return 1;
}       
int return_home(object room)
{
	if (query_leader())
		return 1;
	::return_home(room);
}
