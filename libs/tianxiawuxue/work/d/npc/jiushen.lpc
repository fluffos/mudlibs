int do_stop()
{
   string host_id;
  object me=this_player();
  if(query("id")=="jiu shen")
   return notify_fail("你无权使用此命令。\n");
  sscanf(query("id"),"%s's jiu shen",host_id);
  if(me->query("id")!=host_id)
   return notify_fail("这好像不是你的酒神！\n");
 if(!is_fighting())
         return notify_fail("酒神现在没和人打斗.\n");
 command("halt");
 message_vision("酒神好像醉了。。。。。\n",me);
 return 1;
}

