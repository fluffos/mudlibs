#include <ansi.h>
inherit NPC;
string ask_me();

void create()
{
        set_name(HIR"嫦娥"NOR, ({ "chang e", "chang" }) );
          set("nickname", HIY"中秋快乐"NOR);
        set("gender", "女性" );
        set("age", 18);
         set("long", YEL"这位中秋礼物使者，向他打听“月饼”，他会带给您想不到的惊喜。\n"NOR);
        set("shen_type", 1);
        set("combat_exp", 1000000);
        set("str", 30);
        set("dex", 30);
        set("con", 30);
        set("int", 30);
        set("per", 30);
        set("attitude", "friendly");
        set("max_qi", 100000);
        set("neili", 100000);
        set("max_neili", 1000);
        set("score", 100000);

        set("inquiry", ([
                         "月饼" : (: ask_me :)
        ]));
        setup();
}

string ask_me()
 {
        object me = this_player();
	 object gift;
        mapping fam; 
        
         if ((int) me->query("zhongqiugifth"))
                return "你再这么贪心我叫hanchat purge你哦......";
               else
        {
			gift=new("/d/npc/obj/yuebing");
			gift->move(me);
			me->set("zhongqiugifth", 1);
			return me->query("name")+"中秋节快乐~~~~~！！ 月饼慢慢吃! 不要吃太多哦!\n";
         }
}


