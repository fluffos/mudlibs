// tianshi.c
// 加入了残肢book的拿法 by hhm 2005/4/20
inherit NPC;
#include <ansi.h>
string ask_me();
void create() {
  set_name("复仇天使", ({ "fuchou tianshi", "tianshi" }));
  set("long",
    "他看上去也是几十岁的人了，却是纯然一个书呆子的模样。\n");
  set("gender", "男性");
  set("age", 50);
  set("attitude", "friendly");
  set("shen_type", 1);
  set("str", 25);
  set("int", 35);
  set("con", 25);
  set("dex", 25);
  set("inquiry", ([
    "复仇": (: ask_me :),
  ]));

  set("max_qi", 800);
  set("max_jing", 800);
  set("neili", 800);
  set("max_neili", 800);
  set("jiali", 60);
  set("combat_exp", 150000);
  set("score", 40000);
  set_skill("blade", 60);
  set_skill("ruyi-dao", 60);
  set_skill("force", 60);
  set_skill("dodge", 60);
  set_skill("unarmed", 60);
  set_skill("parry", 60);
  set_skill("lingboweibu", 60);
  set_skill("beiming-shengong", 60);
  set_skill("zhemei-shou", 60);
  map_skill("unarmed", "zhemei-shou");
  map_skill("dodge", "lingboweibu");
  map_skill("force", "beiming-shengong");
  map_skill("blade", "ruyi-dao");
  set("book_count", 1);

  set("title", HIR "无名尊者" NOR);
  setup();
  //   carry_object(__DIR__"/d/xiaoyao/obj/cloth")->wear();
  //  carry_object(__DIR__"obj/blade")->wield();
}

string ask_me() {
  object me, ob;
  ob = this_player();
  if (query("book_count") < 1)
    return "你来晚了，那本《杀人秘籍》我已经赠送给别入了。";
  add("book_count", -1);
  command("chat " "杀人的人啊,你们小心啊!杀人秘籍已经重现江湖了。");
  command("say 既然你那么报仇心切，我就把它送给你吧。\n");
  message_vision(HIY "天使从怀中摸出一本破书，交了给$N \n\n" NOR, ob);
  me = new("/clone/book/canzhi");
  me->move(ob);
  return "这本书可千万不要流传出去,不然就天下大乱了。\n";
}
