#include <ansi.h>
inherit NPC;

int check_name(string str);
int create_banghui(string str);

void create() {
  set_name(HIC "老鬼雾" NOR, ({ "lwt hc", "lwt" }));
  set("long", "他就是红尘主管，负责红尘的武林帮会(banghui)的建立。\n");
  set("title", HIR "众帮之主" NOR);
  set("gender", "男性");
  set("age", 30);
  set("per", 90);

  set_skill("unarmed", 200);
  set_skill("dodge", 200);
  set_skill("parry", 200);

  set_temp("apply/attack", 100);
  set_temp("apply/defense", 100);
  set_temp("apply/damage", 50);

  set("inquiry", ([
    "banghui": "要创建帮会请chengli <帮会名>\n",
    "帮会": "要创建帮会请chengli <帮会名>\n",
  ]));

  set("combat_exp", 2000000);
  setup();
}
//这个是检测帮派名称多少字吗？为什么return 1? 应该return i吧。。
//还是这里限定名字不得超过多少字。。。
//我小小修该了一下。并不理想，因为strlen没有去掉ansi字符，没有达到实际多少字。
int check_name(string name) {
  int i;

  i = strlen(name);
  if (i > 50) return 0;  //名称不得大于50个字符就是25个汉字
  else return 1;


}


void init() {
  //     object ob;

  /* 这里都没有 greeting() 为何call_out??
    if( interactive(ob = this_player()) && !is_fighting() )
    {
	remove_call_out("greeting");
	call_out("greeting", 1, ob);
    }
cut by ivan
*/
  add_action("create_banghui", "chengli");
}

int create_banghui(string str) {
  object me, lingpai;
  int count;

  me = this_player();
  if (stringp(me->query("banghui"))) {
    tell_object(me, "你已经是" + me->query("banghui") + NOR + "的人了，不能另创帮会。\n");
    return 1;
  }
  if (me->query("combat_exp") < 300000000) {
    tell_object(me, RANK_D->query_respect(me) + "的实战经验还差" +
      (string)(300000000 - me->query("combat_exp")) + "点，暂时无法开帮立会。\n");
    return 1;
  }
  if (!count = me->query("lonely/have_create")) count = 0;
  if (count >= 4) {
    tell_object(me, "星空怒道：你以为帮会是创着玩吗？想再建帮会，下辈子吧！！\n",);
    return 1;
  }

  if (!stringp(str)) {
    tell_object(me, "你要创建什么名字的帮会？\n");
    return 1;
  }

  if (!check_name(str)) return notify_fail("你帮派的名字也太长了。短点！\n");

  if (file_size("/data/guild/" + str + ".o") != -1) {
    tell_object(me, "非常抱歉，你起的帮会名早就有了。\n");
    return 1;
  }
  str = replace_string(str, "$BLINK$", BLK);
  str = replace_string(str, "$RED$", RED);
  str = replace_string(str, "$GRN$", GRN);
  str = replace_string(str, "$YEL$", YEL);

  str = replace_string(str, "$BLU$", BLU);
  str = replace_string(str, "$MAG$", MAG);
  str = replace_string(str, "$CYN$", CYN);
  str = replace_string(str, "$WHT$", WHT);
  str = replace_string(str, "$HIR$", HIR);
  str = replace_string(str, "$HIG$", HIG);
  str = replace_string(str, "$HIY$", HIY);
  str = replace_string(str, "$HIB$", HIB);
  str = replace_string(str, "$HIM$", HIM);
  str = replace_string(str, "$HIC$", HIC);
  str = replace_string(str, "$HIW$", HIW);
  str = replace_string(str, "$BLINK$", BLINK);
  str = replace_string(str, "$NOR$", NOR);

#ifdef DEBUG
  write("1 step set player\n");
#endif
  me->set("banghui", str);
  me->set("party/party_name", "" + str + "" NOR);
  me->set("party/rank", HIR "领袖" NOR);
  me->set("bh_rank", "帮主");
  me->set("zjbbang", 1);
#ifdef DEBUG
  write("2 step new lingpai and set\n");
#endif
  lingpai = new("/clone/misc/lingpai");
  lingpai->create(str);
  lingpai->set("bangzhu", me->query("name"));
  lingpai->set("bangzhu_id", me->query("id"));
  lingpai->set("player", ([ me->query("id"): me->query("name") ]));
  lingpai->set("npc", ([]));
  lingpai->set("area", ([]));
  lingpai->set("money", 0);
  lingpai->save();
  destruct(lingpai);

  count++;
  me->set("lonely/have_create", count);

  me->save();
  command("chat 恭喜" + me->query("name") + "的帮会「" + str + "」创建成功！\n");
  return 1;
}
