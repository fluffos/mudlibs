#include <ansi.h>
inherit ITEM;

void setup()
{}

void init()
{
	add_action("do_eat", "eat");
}

void create()
{
	set_name(HIR"月饼"NOR, ({"yue bing", "bing"}));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "块");
		set("long", "这是嫦娥中秋节给你的一块月饼, 据说吃了可以加exp 5%, skills 10级。\n");
		set("value", 0);
   		set("no_get","你想把月饼捡起来可惜已经脏掉了！\n");
   		set("no_give","想肥死他啊？\n");
    		set("no_drop","月饼丢到地上还能吃吗！\n");
		set("no_sell","凡人哪里知道"+this_object()->query("name")+"的价值？还是自己留着吧。\n");
	}
	setup();
}

int do_eat(string arg)
{
	int i, level;
	object me=this_player();
	mapping skill_status;
	string *sname;

	if (!id(arg))
	return notify_fail("你要吃什么？\n");
	
	if ((int) this_player()->query("yuebingeath"))
	{
		message_vision(HIR "$N想尽了办法终于吃下了第二块月饼!! 可惜肚子已经塞不下了。\n" NOR, this_player());
		return 0;
	}


	if ( !(skill_status = me->query_skills()) )
	{
	this_player()->add("combat_exp", this_player()->query("combat_exp")/20);
	this_player()->add("potential",1000000);
	this_player()->set("yuebingeath", 1);
	message_vision(HIR "$N吃下了嫦娥给的月饼,$N觉得今年的中秋实在是太美好了!!\n" NOR, this_player());
	destruct(this_object());
	return 1;
	}

	sname  = keys(skill_status);
	for(i = 0; i < sizeof(skill_status); i++)
	{
		

       level = skill_status[sname[i]] + 10;
       if(level <= 0)
            me->delete_skill(sname[i]);
       else
            me->set_skill(sname[i], level);
    }

	this_player()->add("combat_exp", this_player()->query("combat_exp")/20);
	this_player()->add("potential",1000000);
	this_player()->add("max_jingli",50000);
	this_player()->add("max_neili",50000);
	this_player()->set("yuebingeath", 1);



	message_vision(HIR "$N吃下了嫦娥给的月饼,$N觉得今年的中秋实在是太美好了!!\n" NOR, this_player());
	destruct(this_object());
	return 1;
}

