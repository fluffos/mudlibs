//npc.c 新手导师   by hhm  2005/5/12
inherit NPC;
inherit F_MASTER;
//void attempt_apprentice(object ob);
int ask_me();
void create()
{
    set_name("琴琴", ({ "qin qin", "qin", "aqin" }));
    set("long", 
        "她就是爱帮助新手的神仙姐姐——琴琴，据说她还精通医理，可以起死回生。\n");
    set("gender", "女性");
    set("title","包治白病" HIM "神仙姐姐" NOR);
    set("nickname", HIB "新手导师" NOR);
    set("age", 19);
    set("attitude", "friendly");
    set("str", 30);
    set("int", 30);
    set("con", 30);
    set("dex", 30);
 set("per", 99);
    set("no_suck", 1);
    set("inquiry", ([
        "疗伤" : (:ask_me:),
    ]) );
    
    set("max_qi", 150000);
    set("max_jing", 60000);
    set("neili", 999999);
    set("max_neili", 3000);
    set("jiali", 60);
    set("combat_exp", 15000000);

        set_skill("literate", 2000);
        set_skill("force", 800);
    set_skill("dodge", 800);
    set_skill("unarmed",800);
    set_skill("parry", 800);
    set_skill("sword", 800);
      set_skill("claw", 800);
    set_skill("blade", 800);
    set_skill("wuhu-duanmendao", 400);
    set_skill("shaolin-shenfa",800);
    set_skill("beiming-shengong", 800);
set_skill("huagong-dafa", 800);
    set_skill("jiuyin-baiguzhao", 400);
    set_skill("taoism", 800);
    set_skill("qimen-flee", 400);
    set_skill("taixuan-gong",200);
    map_skill("unarmed", "jiuyin-baiguzhao");
    map_skill("dodge", "shaolin-shenfa");
    map_skill("force", "beiming-shengong");
    
     create_family("逍遥派", 3, "弟子");
   
    setup();
    carry_object("/clone/misc/cloth")->wear();

}
void attempt_apprentice(object ob)
{
    command("say 好吧，我就收下你了，以后要多为逍遥派出力啊。");
    command("recruit " + ob->query("id"));
 }

int ask_me()
{
    object ob;
    ob=this_player();
 if ((int)ob->query("eff_qi") == (int)ob->query("max_qi"))
    {
        command("?"+ob->query("id"));     
        command("say 你没有受任何伤啊？\n");
        return 1;
    }
    else
    {
        message_vision("琴琴右手对$N一指,$N便觉得浑身舒坦,感觉好多了。\n", ob);
        remove_call_out("recover");
        call_out("recover",2,ob);
        return 1;
    }
}
int recover(object ob)
{
    ob->set("eff_qi", (int)ob->query("max_qi"));
    ob->set("eff_jing", (int)ob->query("max_jing"));  
    message_vision("琴琴微微红了脸.\n",ob);
    command("say 你的伤势已经全好了,可以走啦。\n");
    return 1;
}
