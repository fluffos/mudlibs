//by hhm
#include <ansi.h>
inherit NPC;
string ask_me();

void create()
{
        set_name(HIR"五.一礼物使者"NOR, ({ "liwu shizhe", "shizhe" }) );
          set("nickname", HIY"天下无雪"NOR);
        set("gender", "男性" );
        set("age", 18);
         set("long", YEL"这位是五.一礼物使者，向他打听“节日快乐”，他会带给您想不到的惊喜。\n"NOR);
        set("shen_type", 1);
        set("combat_exp", 1000000);
        set("str", 30);
        set("dex", 30);
        set("con", 30);
        set("int", 30);
        set("per", 30);
        set("attitude", "friendly");
        set("max_qi", 100000);
        set("neili", 100000);
        set("max_neili", 1000);
        set("score", 100000);

        set("inquiry", ([
                         "节日快乐" : (: ask_me :)
        ]));
        setup();
}

void init()
{
        object ob;
        ob = this_player();     
        ::init();
        if( interactive(ob) && !is_fighting() )
               {
                        remove_call_out("greeting");
                        call_out("greeting", 1, ob);
                }
}

void greeting(object ob)
{
   if( !ob || environment(ob) != environment() ) return;
     command("whisper " + ob->query("id") + " "HIW"欢迎光临〖天下无雪〗"+HIR+"(ask shizhe about 节日快乐)\n"+NOR+HIW+"，你会得到五一节日礼物．"NOR);
     command("es " + HIC"祝大家五一节快乐.\n"NOR);
}

string ask_me()
 {
        object me = this_player();
        mapping fam; 
        
         if ((int) me->query("welcome51gift"))
                return "我日哦!老子已经给你礼物了,你真是贪得无厌啊!滚开......";
               else
        {
                 me->add("potential",100000);
                 me->set("welcome51gift", 1);
                 me->add("max_neili", 10000);
                 me->add("neili", 10000);
                 me->add("max_jingli", 10000);
                 me->add("jingli", 10000);
//   me->add("potential", 50000)
                 me->add("food", 10000);
                 me->add("water", 100000);
                 me->add("combat_exp",200000);
                  CHANNEL_D->do_channel(me, "es", sprintf("在下%s今日已经得到五一节礼物,同时祝大家节日快乐.", me->name(1)));
                 return "欢迎光临"NOR+HIR"〖天下无雪〗"NOR"，小的祝你节日快乐,希望你努力成为一代大侠!\n"
                 HIW"突然天空中几个大字"HIM"劳"HIY"动"HIR"光"HIC"荣"HIW"！"NOR;
         }
}


