//泥潭中国
//http://mud.lovefinal.com
//Final(章鹏)
inherit ROOM;
void create()
{
	set("short", "风雨楼第十层");
	set("long", @LONG
这是一个纠集了江湖上十大正派高手的楼，共有十层之高。
LONG );
       set("no_sleep_room",1);
       set("no_clean_up", 0);
	set("exits", ([
		"down" : __DIR__"b9",
		"up":__DIR__"b11",
	]));
		set("objects", ([
			__DIR__"zhang": 1,
		]));
setup();
}

void init()
{
add_action("do_dazuo","dazuo");
add_action("do_dazuo","exercise");
}

int do_dazuo()
{
   object me;
   me = this_player();
   tell_object(me,"这里不能打坐。\n");
return 1;
}
int valid_leave(object me, string dir)
{
        object ob;
if( userp(me) &&
dir=="up" && ob=present("zhang sanfeng", this_object()))
return notify_fail( 
"你想硬闯？！\n");
return 1;
}

