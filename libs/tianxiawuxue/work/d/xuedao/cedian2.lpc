#include <room.h>
inherit ROOM;

void create()
{
	set("short","侧殿");
	set("long",@LONG
这里是法元寺的东侧殿。殿内有神色狞历的夜叉
塑像，光线暗淡，很是诡异。
LONG );
	set("exits",([
		"north"   : __DIR__"zoulang2",
		"east" : __DIR__"dadian",
	]));
	set("objects",([
		  CLASS_D("xuedao")+"/shanyong" : 1,
	]));
//	set("no_clean_up", 0);
	setup();

}
void init()
{
	add_action("do_watch", "watch");
	add_action("do_watch", "kan");
	add_action("do_watch", "mianbi");
	add_action("do_watch", "face");
}

int do_watch()
{
	object ob = this_player();
	int lvl = this_player()->query_skill("xue-dao",1);

	if ((int)ob->query_skill("xuehai-mogong", 1) < 10)
	{
		message_vision("$N的血海魔功不够，看不懂上面刻的是什么。\n",ob);
		return 1;
	}
	if ((int)ob->query_skill("xue-dao", 1) > 40)
	{
		message_vision("$N的血刀早就超越壁上所刻了。\n",ob);
		return 1;
	}
	if((lvl * lvl * lvl/10) > (int)ob->query("combat_exp"))
	{
		message_vision("$N的实战经验不足，无法领悟壁上内容。\n",ob);
		return 1;
	}
	if (ob->query("jing")<20)
	{
		 message_vision("$N太累了，现在无法领悟壁上内容。\n",ob);
		 return 1;
	}
	message_vision("$N面对着壁上图案揣摩良久，有点感觉。\n",ob);
	ob->improve_skill("xue-dao", random(ob->query("int")));
	ob->receive_damage("jing", 15);
	return 1;
}
int valid_leave(object me, string dir)
{
	mapping myfam;
	myfam=(mapping)me->query("family");
	if( (!myfam || myfam["family_name"] !="法元寺") && dir=="up"
	&& objectp(present ("shan yong", environment(me))))
		return notify_fail("善勇说道: 你非法元寺弟子, 不能入内。\n");
	return ::valid_leave(me,dir);
}

