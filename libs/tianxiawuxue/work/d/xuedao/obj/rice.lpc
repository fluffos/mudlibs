// rice.c

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("牛肉", ({ "rou" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一个碗香喷喷牛排。\n");
    set("unit", "块");
    set("value", 100);
    set("food_remaining", 20);
    set("food_supply", 100);
  }
}
