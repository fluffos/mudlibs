// chufang.c 铸造室
// By Lgg,1998.10

inherit ROOM;
int do_kan(string arg);

void create() {
  set("short", "铸造室");
  set("long", @LONG
这里是血刀门的血刀铸造室,红红的炉火在怒吼
着,到处一片片打铁的声音,墙上挂着一块牌子
(paizi)，墙边扔着一把铁锤。
LONG
  );
  set("exits", ([
    "west": __DIR__ "lwchang1",
  ]));
  set("item_desc", ([
    "paizi": "招收打铁弟子。\n"
  ]));
  set_temp("times", 20);
  set("objects", ([
    __DIR__ "npc/daoshi": 1,
  ]));

  setup();
}

void init() {
  add_action("do_da", "da");
}

int do_da(string arg) {
  object me = this_player();
  object ob;

  if (me->query("combat_exp") > 300000)
    return notify_fail("你是本派高手,咋能麻烦你打铁呢?\n");
  if (me->query("family/family_name") != "法元寺")
    return notify_fail("你是哪来的野蜡烛?\n");
  if (!arg || arg != "刀")
    return notify_fail("别乱打，打死不管。\n");
  if (me->is_busy())
    return notify_fail("你当是耍刀啊?\n");
  if (present("daoshi", environment(me)) && living(present("daoshi", environment(me)))) {
    if ((int)me->query("qi") < 30)
      return notify_fail("你的力不够了，休息一会儿再打吧。\n");

    message_vision("$N抡起铁锤，奋力向烧的红红的刀锋砸下去。\n", me);
    add_temp("times", -1);

    if (random(9) < 8) {
      me->receive_damage("qi", 20 + random(20));
      message_vision("结果$N用力过猛，刀锋一下扁了。$N被臭骂一
		顿,灰溜溜的继续干活。\n", me);
      me->start_busy(3);

    } else {
      me->receive_damage("qi", 20 + random(40));
      me->add("combat_exp", 50 + random(100));
      me->add("potential", 20 + random(20));
      message_vision("一把好刀顺顺利利打出来了。刀师笑着对$N说，
		你工作的不错呀，这是你的酬劳。\n", me);
      message_vision("$N被奖励了。\n", me);



    }
    me->start_busy(3);
    return 1;
  } else
    return notify_fail("老板都不见了，你为谁白干啊？\n");
}
