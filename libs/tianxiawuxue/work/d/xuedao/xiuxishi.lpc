inherit ROOM;

void init();
void close_men();
int do_open(string arg);
int do_close(string arg);
int valid_leave(object me, string dir);

void create() {
  set("short", "休息室");
  set("long", @LONG
这是血刀门的休息处，光线很昏暗。房里别无他物，
只有中间放着一张收拾得舒舒服服的大床，看着就让人想睡觉。
LONG);
  set("exits", ([
    "southeast": __DIR__ "lwchang",
  ]));

  set("no_clean_up", 0);
  set("sleep_room", 1);
  set("no_fight", 1);
  setup();
}
