inherit ROOM;
#include <ansi.h>
void create ()
{
	set ("short","禁地");
	set ("long", @LONG
        [1;31m蜀山禁地  善闯者死[2;37;0m
LONG);

	set("exits", ([     
        "west" : __DIR__"jby",
          "east" : __DIR__"zhenyaota/tower",
	]));
       set("objects", ([         
         __DIR__"npc/shouhu" : 1,
        __DIR__"npc/shouhu1" : 1,
       ]));
  
       setup();
}
int valid_leave(object me, string dir)
{
    if ( dir == "east" ) {
        if(objectp(present("shouwei dizi", environment(me))))
            return
notify_fail("蜀山弟子一个箭步闪到你前面，喊道：哪里走！\n");
    }
    return ::valid_leave(me, dir);
}
