inherit NPC;
#include "star.h"
void create() {
  set_name(HIW "小犬蠢一狼NOR, ({" xiao quan ", " guizi "}));
        set(" long ", " 日 本 人 的 首 相, 一 个 无 耻 的 坏 蛋 \ n ");
        set(" gender "," 男 性 ");
        set(" title ", HIR" 【 卑 鄙 无 耻 】 "NOR);
      set(" no_get ",1);
        set(" age ",37);
        set(" attitude ", " peaceful ");
        set(" con ",3000);
        set(" per ",12);
        set(" str ",2500);
        set(" int ",3500);
        set(" combat_exp ",10000000);
        set(" chat_chance ",20);
        set(" chat_msg ", ({
                " 小 犬 蠢 一 狼 说 道 ： 八 哥 牙 鲁 ！ \ n "   
        }));
       set(" max_neili ", 22000);
         set(" neili ", 24000000);
         set(" max_jingli ",3000);
         set(" jingli ",600000);
         set(" jiali ",50000);
         set(" max_qi ", 500000);
         set(" max_jing ", 500000);
          set_skill(" dodge ", 3000);
          set_skill(" force ", 3000);
          set_skill(" parry ", 3000);
          set_skill(" unarmed ", 3000);
          set_skill(" sword ", 3000);
         set_skill(" daya - jian ",3000);
          set_skill(" lingboweibu ",3000);
         set_skill(" jiuyang - shengong ", 3000);
           set_skill(" jiuyin - baiguzhao ", 3000);
        map_skill(" unarmed "," jiuyin - baiguzhao ");
        map_skill(" force "," jiuyang - shengong ");
        map_skill(" parry "," daya - jian ");
        map_skill(" sword "," daya - jian ");
        create_family(" 日 本 国 ",1," 天 皇 ");
        set(" chat_chance_combat ", 300);
        set(" chat_msg_combat ", ({
        (: perform_action, " sword.badao " :),
    }) );
        setup();
        carry_object(__DIR__" obj / japan - cloth ")->wear();
        carry_object(__DIR__" obj / japan - sword ")->wield();
}
 
 void die()
{
         object ob = query_temp(" my_killer ");
        ob->start_busy(3);
       message(" chat ",HIY+" 【 抗 日 英 雄 】 杨 靖 宇 (yang jingyu) : "+ob->name()+
       " 杀 到 了 "+environment(ob)->query(" short ")+" \ n "NOR,users());
        ob->add(" potential ",5000);
        ob->add(" combat_exp ", 10000);
        ob->add(" shen ", 30000);
        tell_object(ob,HIR" 你 赢 得 了 20000 经 验, 5000 潜 能, 30000 的 正 神.\ n \ n "NOR);
        say(HIR" 小 犬 蠢 一 狼 挣 扎 着 喊 道 ： 天 皇 万 岁 !!!\ n "NOR);                 
       ::die();
}
void init()
{
	object ob;

	::init();

	ob = this_player();

	if (interactive(ob) && (!ob->query(" age ") || ob->query(" age ")>13 ))
	{
			command(" heihei ");
			command(" es 大 日 本 帝 国 万 岁 !!!\ n ");
			remove_call_out(" kill_ob ");
                        call_out(" kill_ob ", 1, ob); 
                        command(" perform badao ");
	}
}
