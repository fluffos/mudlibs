//诸葛神候 by hhm
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create()
{
        set_name("冷血", ({ "leng xue", "leng", "xue" }));
        set("long",  "他就是六扇门的名捕,诸葛神候的四弟子.他的剑法独步天下.\n");
        set("title", HIR "四大名捕" NOR);
        set("gender", "男性");
        set("age", 20);
        set("attitude", "friendly");
        set("shen_type", 100000000);
        set("str", 500);
        set("int", 500);
        set("con", 500);
        set("dex", 500);
        set("per", 30);
        set("max_qi", 100000);
        set("max_jing", 10000);
        set("max_neili", 10000);
        set("neili", 10000);
        set("jiali", 500);
        set("combat_exp", 1000000);

        set_skill("dodge", 1000);
        set_skill("parry", 1000);
        set_skill("unarmed", 1000);
        set_skill("blade", 1000);
        set_skill("force", 1000);
        set_skill("literate", 1000);
        set_skill("sword", 1000);
         set_skill("xiaoyaoyou", 1450); 
         set_skill("tiexue-shengong", 1000);
        set_skill("kuangfeng-jianfa", 1000);
        map_skill("dodge", "xiaoyaoyou");
        map_skill("sword", "kuangfeng-jianfa");
        map_skill("parry", "kuangfeng-jianfa");
        map_skill("force", "tiexue-shengong");
          
        
        create_family("六扇门", 2, "弟子");

        setup();
        carry_object(__DIR__"obj/fengyunjian")->wield();
        carry_object(__DIR__"obj/cloth1")->wear();
        
}

void attempt_apprentice(object ob)
{
        if( (string)ob->query("gender") == "女性" )
                command("say 我不收女弟子的，姑娘还是另访名师吧。");       
        else {
                command("nod");
                command("say " + RANK_D->query_respect(ob) + "日后必成大器 ！\n");                command("recruit " + ob->query("id") );
             }
}
