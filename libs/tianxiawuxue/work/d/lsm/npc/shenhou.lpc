//诸葛神候 by hhm
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create()
{
        set_name("诸葛神候", ({ "zhuge xiaohua", "shenhou", "zhuge", "xiaohua"}));
        set("long",  "他就是六扇门的门主,人称诸葛神候的老爷子.\n");
        set("title", HIY "铁面无私" NOR);
        set("gender", "男性");
        set("age", 60);
        set("attitude", "peaceful");
        set("shen_type", 100000000);
        set("str", 500);
        set("int", 500);
        set("con", 500);
        set("dex", 500);
        set("per", 30);
        set("max_qi", 100000);
        set("max_jing", 100000);
        set("max_neili", 100000);
        set("neili", 100000);
        set("jiali", 5000);
        set("combat_exp", 100000000);
        set_skill("sword",1500);
        set_skill("dodge",1500);
        set_skill("unarmed",1500);
        set_skill("force", 1500);
        set_skill("parry", 1400);
        set_skill("blade",1550);  
        set_skill("strike",1550);
        set_skill("tiexue-shengong",1500);
        set_skill("mantianhuayu", 1450); 
        set_skill("xiaoyaoyou", 1450); 
        set_skill("kuangfeng-jianfa", 1450); 
        set_skill("tiexue-daofa", 1550); 
        set_skill("wuming-shenzhang", 1450); 
        map_skill("force", "tiexue-shengong");        
        map_skill("sword","kuangfeng-jianfa");
        map_skill("dodge", "xiaoyaoyou");
        map_skill("blade", "tiexue-daofa");  
        map_skill("parry", "wuming-shenzhang");        
        map_skill("unarmed", "wuming-shenzhang"); 
        map_skill("strike", "wuming-shenzhang");       
        create_family("六扇门",1,"掌门");
        set("chat_chance_combat", 90);
    set("chat_msg_combat", ({
        (: perform_action, "blade.canghaixiao" :),
        (: perform_action, "strike.lianhuan" :),
    }) );
       
        setup();

        carry_object(__DIR__"obj/cloth1")->wear();    
        carry_object(__DIR__"obj/fengyundao")->wield();      
}

void attempt_apprentice(object ob)
{
     mapping fam = ob->query("family");
      if (!fam || fam["family_name"] != "六扇门"){
                command("say "+RANK_D->query_respect(ob)+"与本门素无来往，不知此话从何谈起？");
                return;
                }       
      if((int)ob->query_skill("force", 1) < 1500) {
                command("say 内功是六扇门武功之基础。"); 
                command("say " + RANK_D->query_respect(ob)+"是否还应该先在内功上多下点功夫？");
                return;
                }   
      if((int)ob->query_int() < 30 ) {
                command("say 我的武功都要极高的悟性才能学会。");
                command("say 要能达到炉火纯青之境，体质什么的倒是无关紧要，悟性却是半点也马虎不得。");
                command("say "+RANK_D->query_respect(ob)+"的悟性还大有潜力可挖，还是请回吧。");
                return;
                }
       if((int)ob->query_skill("wuming-shenzhang",1) < 1000 ) {
                command("say 无名神掌是我派行走江湖的基本武功。");
                command("say 要想铲奸除恶,真才实学却是半点也马虎不得。");
                command("say "+RANK_D->query_respect(ob)+"的基础武功没有学会，还是请回吧。");
                return;
                }         
      if(ob->query("gender") != "男性") {
                command("say 我可只收男徒.");
                return;
                }
        command("say 嗯，看你还是个学武的料，我就收下你吧！");         
        command("chat 六扇门武功重现江湖，"+ ob->name() +"可别让为师看走眼了！");
        command("chat* pat " + ob->query("id"));
        command("recruit " + ob->query("id"));
        ob->set("title","六扇门传人");
        ob->set("class","sworder");
}
