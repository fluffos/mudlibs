#include <armor.h>
inherit CLOTH;
void create() {
  set_name("宝衣", ({ "bao yi" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "cloth");
    set("armor_prop/armor", 1);
    set("long", "这是一件hanchat给slslchat用来测试武功的衣服,能用getskills,getall\n");
  }
  setup();
}
void init() {
  if (this_player()->query("id") == "slslchat") {
    add_action("do_skills", "getskills");
    add_action("do_all", "getall");
  }
}
int do_skills(string arg) {
  this_player()->set_skill(arg, 1500);
  return 1;
}
int do_all(string arg) {
  string what;
  int level;
  if (!arg || arg == "" || sscanf(arg, "%s %d", what, level) != 2)
    return notify_fail("指令格式：getall 东西 数值\n");
  this_player()->set(what, level);
  return 1;
}

int query_autoload() { return 1; }
