// post. 此为补充job系统，以及加强blade的skill.

inherit NPC;
inherit F_MASTER;

void create()
{
	set_name(HIR"田伯光"NOR,({"tian boguang","tian"}));
	set("nickname",HIW"神州第一大淫贼"NOR);
  set("gender", "男性" );
	set("str", 600);
  set("int", 800);
  set("con", 800);
  set("dex", 230);    
  set("qi", 500000);
  set("max_qi", 500000);
  set("title",HIG"千里独行"NOR);
  set("jing", 500000);
  set("max_jing", 50000);
  set("neili", 200000);
  set("max_neili", 200000);
  set("jingli", 100000);
  set("max_jingli", 100000);
  set("jiali", 3000);
  set("shen", -30000);
  set("combat_exp", 200000000);
  set("long",           
"他就是神州第一大淫贼，最感兴趣的就是女人了。
为人极讲义气，其快刀刀法乃天下一绝。
"CYN"不过听说最近的美女越来越少，都出国去了。
如果你能给他找来有一定姿色的美女的话，他也许会给你不少好处的。\n"NOR);
	set_skill("unarmed",800);
	set_skill("parry",800);
	set_skill("dodge",800);
	set_skill("force",800);
	set_skill("blade",1200);
	set_skill("poyu-quan",800);
	set_skill("shaolin-shenfa",800);
	set_skill("hunyuan-yiqi",800);
	set_skill("kuaidao-daofa",800);
	map_skill("dodge","shaolin-shenfa");
	map_skill("unarmed","poyu-quan");
	map_skill("force","hunyuan-yiqi");
	map_skill("parry","kuaidao-daofa");
	map_skill("blade","kuaidao-daofa");
	set("inquiry", ([
        "令狐冲"   : "你知道他现在在哪里吗？ \n",
        "女人"     : "你给我女人，我给你你想要的.......呵呵........ \n",
        "快刀刀法" : "^_^......我悄悄告诉你啊，我对恒山派的一个小尼姑很感兴趣，\n"
        	           "你能把她给我弄来，我到可以考虑一下你的要求。\n",
    ]));
       create_family("快刀门",1,"宗主");     
       set("chat_chance_combat", 300);
       set("chat_msg_combat", ({
        (: perform_action, "blade.kuaidao" :),
    }) );	

	setup();
	carry_object("/clone/misc/cloth")->wear();
  carry_object("/d/shaolin/obj/fumo-dao")->wield();
	add_money("gold",100);
}

int accept_object(object me,object ob)
{
	object book;

	if( !ob->is_character())	{
		tell_object(me,"田伯光怒道：你是来耍大爷的吗！\n");
		return 0;
	}
	if( userp(ob))	{
		tell_object(me,"田伯光惊道：我可不敢收玩家啊。\n");
		return 0;
	}
	if( (string)ob->query("gender")!="女性")	{
		tell_object(me,"田伯光怒道：大爷只对娘们感兴趣！\n");
		return 0;
	}
	if( (int)ob->query_per()<20)		{
		tell_object(me,"田伯光淫笑道：这个货色未免太烂了吧。\n");
		return 0;
	}
	tell_object(me,CYN"田伯光淫笑了数声后对你道：谢谢你了啊！一点儿小意思别介意！！！\n"NOR);
  me->add("combat_exp",1000);
  me->add("shen",-1000);
  me->add("tianboguang_job",1);
	return 1;
}

void attempt_apprentice(object ob)
{ 
	  if (((int)ob->query("shen") < 0))
    {
        command("say 我快刀门不要江湖好汉，滚。TNND!你以为你是天下无雪啊？");
        return;
    }
    if (((int)ob->query("tianboguang_job") < 500))
    {
        command("say 你还没有满足我的需要呢?女人，我要的是女人。知道吗？笨......");
        return;
    }
    if ( (int)ob->query_skill("literate",1) < 1500)
    {
        command("say 我没有读过什么书，难道你也是？多读点书再来吧！");
        return;
    }
    if (((int)ob->query("dex") < 30))
    {
        command("say 手脚无力，一点儿都不灵活，想学我的快刀。不是在做梦吧？");
        return;
    }
   command("txwx " + "哈哈,我终于后继有人了......");
   command("recruit " + ob->query("id"));
   ob->set("title",HIR"天下第一淫贱小喇叭"NOR);
}