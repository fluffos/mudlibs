inherit ROOM;


string look_writing();


void create()
{
	set("short", "后花园");
	set("long", @LONG
这里是包大人的眷属住处，向东是包大人的少爷的房间，
向西是包小姐的闺房，向北是包老爷的休息室.
LONG
	);

	set("exits", ([
		"west" : __DIR__"girlroom",
		"east" : __DIR__"boyroom",
		"north" : __DIR__"livingroom",
		"south" : __DIR__"houmen",
	]));

	setup();
}


