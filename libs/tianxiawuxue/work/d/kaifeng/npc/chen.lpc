  set_name("陈光蕊", ({ "chen guangrui", "chen", "guangrui" }));
  set("long", "陈光蕊乃玄奘之父，当朝大阐都纲御赐状元。\n");
  set("title", "大阐都纲");
  set("gender", "男性");
  set("age", 50);
  set("per", 35);
  set("attitude", "peaceful");
  set("class", "scholar");
  set("shen_type", 1);
  set("combat_exp", 40000);
  set_skill("unarmed", 50);
  set_skill("dodge", 50);
  set_skill("literate", 180);
  set_skill("parry", 50);
  set_skill("force", 50);
  set("max_gin", 400);
  set("max_kee", 400);
  set("max_sen", 400);
  set("max_force", 400);
  set("max_mana", 400);
  set("force_factor", 20);
  set("chat_chance", 10);
  setup();
  carry_object("/d/kaifeng/obj/cloth")->wear();
}
