inherit NPC;
inherit F_DEALER;

void create()
{
  set_name("海老板", ({"hai laoban", "hai", "laoban"}));
  set("shop_id",({"laoban","waiter"}));
  set("gender", "男性");
  set("combat_exp", 5000);
  set("age", 48);
  set("per", 24);
  set("attitude", "friendly");
  set("shen_type", 1);
  set_skill("unarmed", 50);
  set_skill("dodge", 50);
  set_skill("parry", 50);
  set("vendor_goods", ({
		"/d/kaifeng/obj/dutiao",
		"/d/kaifeng/obj/ganjian",
		"/d/kaifeng/obj/changtou",
		"/d/kaifeng/obj/feipian",
	}));
  setup();
   carry_object("/clone/misc/cloth")->wear();
}

void init()
{
  add_action("do_list", "list");
  add_action("do_buy", "buy");
}

