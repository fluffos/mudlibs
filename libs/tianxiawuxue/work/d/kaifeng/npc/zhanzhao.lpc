  }));
  set("long",
    "他就是名动江湖的'玉猫',据传他的武功已与达摩祖师相差无几.\n"
    "他正在保护包大人的安全.\n"
  );


  set("nickname", "御前一品带刀侍卫");
  set("gender", "男性");
  set("attitude", "peaceful");
  set("class", "officer");

  set("age", 30);
  set("shen_type", 1);
  set("str", 50);
  set("int", 50);
  set("con", 50);
  set("dex", 50);

  set("qi", 10000);
  set("max_qi", 10000);
  set("jing", 1500);
  set("max_jing", 1500);
  set("neili", 10000);
  set("max_neili", 10000);
  set("jiali", 150);
  set("combat_exp", 10000000);
  set("score", 1000000);

  set_skill("force", 500);
  set_skill("hunyuan-yiqi", 500);
  set_skill("dodge", 500);
  set_skill("shaolin-shenfa", 500);
  set_skill("parry", 500);
  set_skill("cuff", 500);
  set_skill("staff", 500);
  set_skill("blade", 500);
  set_skill("luohan-quan", 500);
  set_skill("xiuluo-dao", 500);

  map_skill("force", "hunyuan-yiqi");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("parry", "luohan-quan");
  map_skill("cuff", "luohan-quan");
  map_skill("blade", "xiuluo-dao");

  prepare_skill("cuff", "luohan-quan");


  set("inquiry", ([
  ]));

  set("chat_chance_combat", 45);
  set("chat_msg_combat", ({
    (: exert_function, "recover" :),
  }));

  setup();

  carry_object("/d/kaifeng/obj/goldblade")->wield();
  carry_object("/d/kaifeng/obj/yayifu")->wear();
