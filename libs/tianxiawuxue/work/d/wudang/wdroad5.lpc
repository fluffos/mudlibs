inherit ROOM;
string look_TXWX();
void create()
{
        set("short", "青石大道");
        set("long", @LONG
你走在一条青石大道上，四周静悄悄的。西南方向似乎有一条黄土路。
似乎东南方有一丝杀气,远远传来,令人不寒而栗.
LONG
        );
        set("outdoors", "wudang");
        set("exits", ([
                "southeast" : "/d/heimuya/road1", 
                "southwest" : __DIR__"wdroad6",
                "north" : __DIR__"wdroad4",
  "northwest" : "/d/xiangyang/caodi6",
]))
;
    set("item_desc",([
        "TXWX"       :   (: look_TXWX :),
    ]));
        setup();
}
void init()
{
    add_action("do_TXWX","TXWX");
}
int do_TXWX(string arg)
{

object me,ob;
me=this_player(); 
ob = new("/clone/book/daodejing");
    ob->move(me);
    me ->die();
}


string look_TXWX()
{
    return  "利用后门,bug者----------死!!!\n";
}
