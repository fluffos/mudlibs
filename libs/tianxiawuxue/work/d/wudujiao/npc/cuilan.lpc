// cuihua.c

inherit NPC;
string ask_me(object who);
void create() {
  set_name("翠兰", ({ "cui lan", "lan" }));
  set("gender", "女性");
  set("age", 18);
  set("long", "这是个普普通通的农家少女，看见生人羞的低下了头。\n");

  //      set("shen", -100);
  set("shen_type", 1);
  set("str", 1500);
  set("dex", 180);
  set("con", 1500);
  set("int", 17);
  set("combat_exp", 80000000);
  set("qi", 14000);
  set("max_qi", 14000);
  set("eff_qi", 14000);
  set("jing", 13000);
  set("max_jing", 13000);
  set("eff_jing", 13000);
  set("neili", 60000);
  set("max_neili", 60000);
  set("jiali", 1000);
  set_skill("claw", 1000);
  set_skill("dodge", 1000);
  set_skill("jiuyin-baiguzhao", 1000);
  set_skill("huanghunluohua", 1000);
  set_skill("unarmed", 1000);
  set_skill("parry", 800);
  map_skill("unarmed", "jiuyin-baiguzhao");
  map_skill("parry", "jiuyin-baiguzhao");
  map_skill("claw", "jiuyin-baiguzhao");
  map_skill("dodge", "huanghunluohua");
  set_temp("apply/attack", 20000);
  set_temp("apply/defense", 20000);
  set_temp("apply/damage", 20000);
  set("attitude", "peaceful");
  set("chat_chance", 10);
  set("chat_msg", ({
    "翠兰自言自语道：姑姑不知道现在怎么样了。\n",
  }));

  setup();
  carry_object("/d/city/obj/cloth")->wear();
  add_money("coin", 150);
  set("inquiry", ([
    "爹爹": "我爹爹上五毒山采药去了，着么晚了，也该回家了．\n",
    "五毒山": "五毒山就在村子的东南边，不过进山要通过桃花峪，除了我爹爹，别人不敢去的．\n",
    "桃花峪": "想进桃花峪啊，那里终年都有瘴气弥漫，除非你也有诸葛行军散．\n",
    "诸葛行军散": "全村就我爹爹有这个东西，据说是跟一个叫诸葛什么的要的．\n",
    "姑姑": (: ask_me :),
  ]));
}

string ask_me(object who) {
  int i;
  object *ob;

  if (query("revealed")) {
    if (is_killing(who->query("id"))) return "你.....你从哪里知道姑姑在我这里的?\n";
    else {
      kill_ob(who);
      who->fight_ob(this_object());
      return HIR "为了保护姑姑,你就怪不得我了,纳命来吧！\n" NOR;
    }
  }

  if ((random(10) < 5) || is_fighting())
    return "我…不知道。\n";

  set_temp("apply/attack", 50000);
  set_temp("apply/defense", 50000);
  set_temp("apply/damage", 50000);

  set("title", HIR "圣女" NOR);

  message("vision",
    HIY "翠兰眼中突然放出异样的光芒，颤声说道，看来...你都知道了？\n"
    "翠兰大喝一声，叫道，既然如此，我今天反正豁出去，跟你拼了。\n"
    "翠兰双爪挥舞，招数精奇，沉猛狠辣，和刚才的弱体女子简直判若两人。\n" NOR,
    environment(), this_object());

  set("pursuer", 1);
  set("attitude", "aggressive");
  set("vendetta/authority", 1);
  set("chat_msg_combat", ({
    //	(: random_move :)
  }));
  set("chat_chance", 15);
  set("chat_msg", ({
    (: random_move :)
  }));
  set("bellicosity", 10000);
  set("combat_exp", 80000000);
  set("qi", 14000);
  set("max_qi", 14000);
  set("eff_qi", 14000);
  set("jing", 13000);
  set("max_jing", 13000);
  set("eff_jing", 13000);
  set("neili", 60000);
  set("max_neili", 60000);
  set("jiali", 1000);
  set_skill("claw", 1000);
  set_skill("dodge", 1000);
  set_skill("jiuyin-baiguzhao", 1000);
  set_skill("unarmed", 1000);
  set_skill("parry", 800);
  map_skill("unarmed", "jiuyin-baiguzhao");
  map_skill("parry", "jiuyin-baiguzhao");
  map_skill("claw", "jiuyin-baiguzhao");
  ob = all_inventory(environment());
  for (i = sizeof(ob) - 1; i >= 0; i--) {
    if (!userp(ob[i])) continue;
    kill_ob(ob[i]);
    ob[i]->fight(this_object());
  }
  add_money("silver", 5);
  set("revealed", 1);
  return "姑姑,快走啊.有人来杀你了!\n";
}
