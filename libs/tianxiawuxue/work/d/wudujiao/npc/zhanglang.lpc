inherit NPC;
void create() {
  set_name("蟑螂", ({ "zhang lang", "lang" }));
  set("race", "野兽");
  set("per", 1);
  set("long", "一只令人恶心的小虫子，正好奇的看着你。\n");
  set("age", 10000);
  set("attitude", "peaceful");

  set("max_jing", 1);
  set("max_qi", 1);
  set("neili", 1);
  set("max_neili", 1);
  set("jiali", 1);

  set("str", 1);
  set("con", 1);

  set("limbs", ({ "头部", "身体", "尾巴" }));
  set("verbs", ({ "bite" }));
  set("combat_exp", 1);

  set_weight(10);
  setup();
}
