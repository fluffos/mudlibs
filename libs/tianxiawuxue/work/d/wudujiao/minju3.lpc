inherit ROOM;
void create()
{
	set("short", "民居");
	set("long", @LONG
这是一户普通的农家，屋里没有什么象样的摆设。墙边摆放着一些
农具，除此只外四壁皆空，看来并不富裕。 
LONG
	);

	set("exits", ([
		"out" : __DIR__"cun4",		
		"west" : __DIR__"minju8",		
	]));
        set("objects", ([
                __DIR__"npc/cuilan": 1,
	]));
	
	setup();
}

int valid_leave(object me, string dir)
{
	if (  (dir == "west")
           && ((string)me->query("family/family_name") != "峨嵋派")
	   && objectp(present("cui lan", environment(me))) )
	 return notify_fail
		("翠兰伸手拦住你，说道：“好像你不是峨嵋派的弟子，不要到处乱跑.”\n");
	return ::valid_leave(me, dir);
}