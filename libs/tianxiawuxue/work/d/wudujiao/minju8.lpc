inherit ROOM;
void create() {
  set("short", "内房");
  set("long", @LONG
这是一个简陋的卧室房，只有一张床,和几把椅子。墙上挂了一幅画。
好象是郭大侠夫妇的画像。房间的中央站着为清新脱俗的女人。
LONG
  );

  set("exits", ([
    "east": __DIR__ "minju3",
  ]));
  set("objects", ([
    "/kungfu/class/emei/guo": 1,
  ]));

  setup();
}

int valid_leave(object me, string dir) {
  if ((dir == "west")
    && ((string)me->query("family/family_name") != "峨嵋派")
    && objectp(present("cui lan", environment(me))))
    return notify_fail("翠兰伸手拦住你，说道：“好像你不是峨嵋派的弟子，不要到处乱跑.”\n");
  return ::valid_leave(me, dir);
}
