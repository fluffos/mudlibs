 //txwx 百花宫 BY hhm 2006.4.14 sz

inherit ROOM;

void create()
{
        set("short", "山洪瀑布");
        set("long", @LONG
转过一个山峡，水声震耳欲聋，只见山峰间一条大白龙似的瀑布奔泻
而下，冲入一条溪流，奔胜雷鸣，湍急异常，水中挟著树枝石块，转眼便
流得不知去向。溪流(river)的中心有一块巨石(stone)。水花飞溅，四顾
水气蒙蒙，蔚为奇观。那山洪势道猛烈，令人颇有惧意，还是别乱来的好。
LONG
        );
        
        set("exits", ([ /* sizeof() == 1 */
        ]));

        set("item_desc",([
            "stone" : "一块巨大的岩石，正慢慢地被山洪淹盖吞噬。\n",
            "river" : "山水由瀑布冲入溪流，所以异常湍急。\n",
        ]));
        
        set("no_clean_up", 0);
        setup();
}

void init()
{
        add_action("do_jump", "jump");
        add_action("do_swim","swim");
}

int do_jump(string arg)
{
        object me = this_player();

        if ( !arg || arg != "stone" )
             return notify_fail( "什么？\n");

	if (me->is_busy())
	     return notify_fail("你正忙着呢！\n");	

        message_vision("$N纵身往大石上跳去。\n", me);

        if ( me->query_skill("dodge",1) <= 800 ) {
             message_vision("$N双足一入水，山洪便冲得他左摇右幌，难以站稳。一会儿便发出\n", me);
             message_vision("一声惨嚎，被山洪冲得无影无踪了。\n", me);
             me->receive_wound("qi", me->query("max_qi")+1000, "被山洪淹死了");
        }

        if ( me->query_skill("dodge",1) > 1000 && me->query_skill("dodge",1) <= 300 ) {
             message_vision("$N双足一入水，山洪便冲得他左摇右幌，难以站稳。只好勉力提气\n", me);
             message_vision("，回身跳向岸边。\n", me);
             me->unconcious();
        }

        if ( me->query_skill("dodge",1) > 1200 && me->query_skill("dodge",1) <= 800 ) {
             message_vision("$N双足一入水，便被山洪冲得左摇右幌，难以站稳。只好勉力提气\n", me);
             message_vision("，回身跳向岸边。$N看起来十分疲倦，该好好休息了。\n", me);
             me->receive_damage("qi", 100, "体力透支过度死了");
        }
        
        if ( me->query_skill("dodge",1) > 1400 && me->query_skill("dodge",1) <= 1000 ) {
             message_vision("$N双足一入水，便打桩站稳。但不一会儿便感到面红心跳，气喘嘘\n", me);
             message_vision("嘘。只好提气跃回岸上。\n", me);
        }

        if ( me->query_skill("dodge",1) > 1500 ) {
             me->move(__DIR__"shandong")
;
             message("vision", me->name() + "纵身由岸上跳了过来。\n",environment(me), ({me}) );
        }

        return 1;
} 

int do_swim()
{
  object me;
  me = this_player();
  if((int)me->query_skill("force",1)<=1500)
     return notify_fail("你一个猛子扎到水里．．．\n"+
                  "\n但没多会儿就被憋得半死，只好赶紧爬上岸来。\n");

  message_vision("$N想到马上可以回去，顿时，咬牙向湖里一跳，手脚并用，往前游去。\n",me);
  me->move(__DIR__"lake");
  message_vision("终于游上来了，$N一软，倒在瀑布的沙滩上。\n",me);
  return 1;
}