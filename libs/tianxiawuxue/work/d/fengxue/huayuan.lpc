//txwx 百花宫 BY hhm 2006.4.14 sz

inherit ROOM;
int do_zhong(string arg);
#include <ansi.h>

void create()
{
  set("short",HIG"花园"NOR);
  set("long",@LONG

这里是一个美丽的花园，里面有许多许多很漂亮的花，争奇斗艳，花色
独特，似乎不是凡间所有。

LONG);

 set("outdoors",__DIR__);
 set("exits",([
   "south":__DIR__"wytdamen",
   ]));

  setup();
}
void init()
{
  add_action("do_zhong","zhong");
}

int do_zhong(string arg)
{
        object me,flower,ob;
        me = this_player();
        if( !arg || arg=="" ) return 0;
        if( arg=="hua" )
        {               
                if (!query("had_flower"))
                {
                  message_vision( YEL"$N拿起一把小锄头，仔细地挖一个坑，放一粒花籽进去！\n"NOR, this_player());
               flower = new(__DIR__"npc/obj/xuelian");
               flower->move(me);
               message_vision(CYN"\n$N耐心的等待着。\n\n"
                              HIW"忽然，一阵风吹来，花开了，雪莲在风中摇曳，好漂亮啊。\n\n"
                              MAG"$N迫不急待的一把摘下雪莲，装进口袋里,生怕被人抢走......\n\n"NOR,me);
               message("channel:rumor", HIM"〖天下无雪〗"NOR+"："+HIR"听说"HIW+this_player()->query("name")+NOR HIR"在百花谷种出了之武林奇花"HIW"百花雪莲"HIR"了!\n"NOR, users());
                        set("had_flower", 1);
                        return 1;
}
               message_vision(
               "$N把花籽种进土壤，发现这片土地再也长不出雪莲了...。\n", this_player());
                return 1;
}
        return 0;

}

