inherit ROOM;
#include <ansi.h>

void create()
{
        set("short", "山洞");
        set("long", @LONG
这是一个毫不起眼的山洞，但是里面的石壁上却画满了
所有已经失传的精妙绝招。花岗岩石壁(wall)上很多小
人，全是用利器刻制，想见当初运力之人内力十分深厚。
LONG );
        set("exits", ([ /* sizeof() == 4 */
            "out"   : __DIR__"shandong",
        ]));
        set("item_desc", ([ 
            "wall" : @TEXT

       o    | o      o    \ o      o      o     <o     <o>
    --^|\    ^|^  --v|^    v|v    |/v   \|X|    \|      |
       /\     >\    /<      >\    /<      >\    /<      >\

       o>     o      o      o      o      o      o      o
       \ __   x     </     <|>    </>    <\>    <)>     |\__
      /<      >\    /<      >\    /<      >\     >>     L

TEXT
        ]));

        setup();
}
void init()
{
        add_action("do_lingwu", "lingwu");
        add_action("do_swim","swim");
}

int do_lingwu()
{
        object ob;
        int c_skill;

        ob = this_player();

        c_skill = (int)ob->query_skill("baihua-sword", 1);

        if (ob->query("baihua-sword/po"))
        {
                write("你觉得石壁上的内容对你而言过于肤浅。\n");
                return 1;
        }

        if (ob->query("combat_exp") < 300000000)
        {
                write("你的实战经验不足，无法领悟石壁内容。\n");
                return 1; 
        }

        if (c_skill < 1500)
        {
                write("你研究了半天，始终无法参悟透石壁上的内容。\n");
                return 1; 
        }

        if (ob->query("jing") < 200)
        {
                write("你精力不能集中，现在无法领悟石壁内容。\n",ob);
                return 1; 
        }
        
          if (ob->query_skill("baihua-force") < 1500)
        {
                write("你的内功不够，现在无法领悟石壁内容。\n",ob);
                return 1; 
        }
      
        if (random(25) != 1)
        {
        
                write("你面对着石壁趺坐静思，良久，对「百花惊魂」"
                               "这招似有所悟，但仍有许多不解之处。\n", ob);
                ob->start_bisy(2);
                return 1;
        }

        message_vision(HIW"\n$N" HIW"面对着石壁趺坐静思，猛然间一声长叹，诸"
                     "多凡尘旧事已涌上心头，$N" HIW "终于将「百花惊魂」"
                     "参悟出来，从此再无疑虑。\n", this_player());
        write(HIC "你学会了百花剑法的终极绝技-----「百花惊魂」。\n" NOR);
        ob->set("baihua-sword/po", 1);
        ob->receive_damage("jing", 75);
        ob->start_busy(8);
        return 1;
}
