//太阿剑——writed by lonely
// writed by lonely
// 修改by dream 06.8.16 yc

#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create()
{
        set_name(HIW"太阿剑"NOR, ({ "tai-e jian", "jian","sword"}));
        set_weight(10000);
        set("zhuanshi/jineng",1);
        set("id_id","tai-e jian");
        if (clonep())
             set_default_object(__FILE__);
        else {
             set("unit", "柄");
             set("long", 
             HIW"太阿宝剑——据传为上古神物，也不知主人从何处觅得。\n"NOR);
             set("value", 1000000);
             set("material", "steel");
             set("wield_neili", 2000);
             set("wield_maxneili", 4000);
             set("wield_str", 50);
             set("rigidity",1000);
             set("no_drop",1); 
             set("no_steal",1);
             set("no_get",1);
             set("no_put",1); 
             set("wield_msg", 
             HIC"$N轻按剑匣，"NOR+"$n"+HIC"「唰」一跃而出，"
             +"龙吟声响彻天地，\n盘旋回绕于空中而不绝，真乃神物也！\n"NOR);
             set("unwield_msg",
             HIC"$N轻抚剑身，"NOR+"$n"+HIC"「唰」的一声自行飞回剑匣。\n"NOR); 
        }
        set("owner",this_player(1)->query("id"));
        set("no_clean_up",1);
        init_sword(1000);
        setup();
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
       object weapon,armor;
       string name;

       if(objectp(weapon=me->query_temp("weapon"))
          && weapon->query("id_id")=="tai-e jian"
          && random(2))
       if(objectp(armor=victim->query_temp("armor/cloth")))
       {
           armor->unequip();
           armor->reset_action();
           armor->move(environment(victim));
           name=armor->query("name");
           armor->set("name", name + "的碎片");
           armor->set("value", 0);
           armor->set("armor_prop", 0);
           armor->set("long", "一堆破碎物事，好象是布片铁片什么的。\n");
           message_vision(HIW"只听嗤嗤几声轻响，$N身上的"NOR
           +name+HIW"被割成道道碎片"+"散落在地上！\n"NOR,victim); 
           return;
       } else
       {
           victim->receive_damage("qi",query("weapon_prop/damage"),me);
           victim->receive_wound("qi",query("weapon_prop/damage"),me); 
           message_vision(HIR"只听嗤嗤几声轻响，$N周身上下顿时为"NOR
           +query("name")+HIR"剑气所伤，顷刻间已是遍体鳞伤！\n"NOR,victim); 
           return;
       } else
       return;
}

