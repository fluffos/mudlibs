// xuelian.c 雪莲
#include <ansi.h>
inherit ITEM;

void init();
void eat();

void create() {
  set_name(HIW "雪莲" NOR, ({ "xue lian", "xuelian", "lian" }));
  set_weight(20);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", HIW "武林奇花----百花雪莲，只能生长在百花谷中。\n"
      "听说人们只要吃了它就可以变的更加聪明 ！\n" NOR);
    set("unit", "朵");
    set("value", 5000);
  }

  setup();
}

void init() {
  add_action("do_eat", "eat");
}


int do_eat(string arg) {

  object me = this_player();
  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  {
    if (me->query("int") < 30)

    {
      message_vision(RED "$N张开大嘴,一口把" + this_object()->name() + RED + "吞了!\n" NOR, this_player());
      message_vision(MAG
        "$N忽然觉得一股热流由丹田之处直冲向脑子...........\n" NOR, this_player());
      this_player()->add("int", 1);
      this_player()->unconcious();
      this_object()->move(VOID_OB);
      destruct(this_object());
      return 1;
    }
    message_vision(RED "$N张开大嘴,一口把" + this_object()->name() + RED + "吞了!\n" NOR, this_player());
    message_vision(MAG "$N忽然觉得头重脚轻,可能是$N吃了太多的雪莲起了反效果...........\n" NOR, this_player());
    this_player()->set("int", 30);
    this_player()->unconcious();
    this_object()->move(VOID_OB);
    destruct(this_object());
    return 1;
  }

}
