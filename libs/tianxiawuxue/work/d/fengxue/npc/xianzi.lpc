//by hhm 2006.8.16 yc

#include <ansi.h>;
inherit NPC;
inherit F_MASTER;

object ob = this_object();
void create() {
  set_name(HIC "百花仙子" NOR, ({ "baihua xianzi", "baihua", "xianzi" }));
  set("gender", "女性");
  set("attitude", "friendly");
  create_family("百花宫", 1, "宫主");
  set("nickname", HIR "剑.掌.人.三绝江湖" NOR);
  set("title", HIG "雅然别苑斋" NOR);
  set("age", 18);
  set("per", 30);
  set("long",
    HIW "其素若何：春梅绽雪。其洁若何：秋兰披霜。
其静若何：松生空谷。其艳若何？霞映澄塘。
其文若何：龙游曲沼。其神若何：月射寒江。\n" NOR);
  set("combat_exp", 400000000);
  set("str", 1800);
  set("dex", 180);
  set("con", 180);
  set("int", 180);
  set("qi", 200000);
  set("max_qi", 200000);
  set("jing", 200000);
  set("max_jing", 200000);
  set("neili", 800000);
  set("max_neili", 200000);
  set("jingli", 200000);
  set("max_jingli", 200000);
  set("jiali", 5000);
  set("shen_type", 0);
  set_skill("force", 2000);
  set_skill("dodge", 2000);
  set_skill("parry", 2000);
  set_skill("unarmed", 2000);
  set_skill("sword", 2000);
  set_skill("literate", 2000);
  set_skill("baihua-dance", 2000);
  set_skill("baihua-sword", 2000);
  set_skill("baihua-zhang", 2000);
  set_skill("ningxie-force", 2000);
  map_skill("unarmed", "baihua-zhang");
  map_skill("force", "ningxie-force");
  map_skill("dodge", "baihua-dance");
  map_skill("parry", "baihua-sword");
  map_skill("sword", "baihua-sword");
  set("baihua-sword/po", 1);
  set("chat_chance_combat", 300);
  set("chat_msg_combat", ({
    (: perform_action, "sword.jinghun" :),
  }));
  set("inquiry", ([
    "here": "百花之上，天地之中。",
    "雪莲": "这是我们谷里面的奇宝，可惜我没有时间去种啊。",
    "风林花": "听说这种武林奇花可以在通吃帮找到，不知是真是假？",

  ]));
  setup();
  carry_object(__DIR__ "obj/luoyi")->wear();
  carry_object(__DIR__ "obj/feijian")->wield();
  add_money("gold", 300);

}

void attempt_apprentice(object ob) {
  if ((int)ob->query("per") < 30) {
    command("say 你的容貌也太.......,还是另求高师吧！");
    return 0;
  }

  if ((int)ob->query("baihua/baihua1") < 1) {
    command("say 我喜欢雪莲花。还是麻烦你帮忙找一下吧！");
    return 0;
  }
  if ((int)ob->query("baihua/baihua2") < 1) {
    command("say 我喜欢风林花。还是麻烦你帮忙找一下吧！");
    return 0;
  }
  if ((int)ob->query("baihua/baihua3") < 1) {
    command("say 我喜欢幽昙仙花。还是麻烦你帮忙找一下吧！");
    return 0;
  }
  if ((int)ob->query("int") < 30) {
    command("say " + RANK_D->query_respect(ob) +
      "天资欠聪，难学得我这一身武功。");
    return;
  }
  if ((int)ob->query("kar") < 30) {
    command("say " + RANK_D->query_respect(ob) +
      "天份不够，还是另求高师吧。");
    return;
  }
  if ((int)ob->query("PKS") > 1) {
    command("say " + RANK_D->query_respect(ob) +
      "杀气太重,与我无缘,还是多积善德,以保平安。");
    return;
  }
  if ((int)ob->query("shen") < 10000) {
    command("say 我最恨的就是奸险狡诈的恶棍,你的没有侠义心肠,不能做我的弟子.");
    return;
  }


  command("say 好吧。我就指点你几招。");
  command("chat* smile");
  command("recruit " + ob->query("id"));
  ob->set("title", MAG "百花谷传人" NOR);
}

int accept_object(object ob, object obj) {
  object me = this_object();
  if (obj->query("id") == "xue lian") {
    command("say 好吧，我收下了！谢谢啊！！！\n");
    this_player()->set("baihua/baihua1", 1);
    return 1;
  }
  if (obj->query("id") == "fenglin flower") {
    command("say 好吧，我收下了！谢谢啊！！！\n");
    this_player()->set("baihua/baihua2", 1);
    return 1;
  }
  if (obj->query("id") == "youtan flower") {
    command("say 好吧，我收下了！谢谢啊！！！\n");
    this_player()->set("baihua/baihua3", 1);
    return 1;
  }
  command("smile");
  command("say 这东西给我可没有什麽用。");
  command("give " + obj->query("id") + " to " + me->query("id"));
  return 0;
}
