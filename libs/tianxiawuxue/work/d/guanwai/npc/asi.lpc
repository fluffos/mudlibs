// asi.c
// BY dream
#include <ansi.h>;
inherit NPC;
string ask_me();
string ask_book();

void create() {
  set_name("平阿四", ({ "ping asi", "ping", "asi" }));
  set("gender", "男性");
  set("nickname", "忠心" HIR "老仆" NOR);
  set("age", 60);
  set("long",
    "他是胡一刀的仆人，当年就是他拼死救回了胡斐的。\n");
  set("attitude", "peaceful");
  set("str", 450);
  set("int", 30);
  set("con", 30);
  set("dex", 30);
  set("chat_chance", 20);
  set("chat_msg", ({
    "平阿四叹了口气道：“老爷夫人死的太冤了。\n",
    "平阿四恨恨道：“苗人凤是杀老爷仇人，阿斐一定要报此仇！”\n",
  }));

  set("qi", 10000);
  set("max_qi", 10000);
  set("jing", 10000);
  set("max_jing", 10000);
  set("neili", 10000);
  set("max_neili", 10000);
  set("jiali", 500);
  set("combat_exp", 10000000);
  set("score", 20000);

  set_skill("force", 400);             // 基本内功
  set_skill("hujia-dao", 400);       // 胡家刀法    
  set_skill("blade", 400);             // 基本刀法
  set_skill("lengyue-shengong", 400);      // 冷月神功
  set_skill("dodge", 400);             // 基本躲闪
  set_skill("hujia-shenfa", 400);    // 胡家身法
  set_skill("parry", 400);             // 基本招架

  map_skill("force", "lengyue-shengong");
  map_skill("blade", "hujia-dao");
  map_skill("dodge", "hujia-shenfa");
  map_skill("parry", "hujia-daofa");

  create_family("胡家刀门", 2, "嫡传");
  set("baodao_count", 1);

  setup();

  carry_object("/d/city/obj/cloth")->wear();
  carry_object("/clone/weapon/blade")->wield();
}

void attempt_apprentice(object ob) {
  command("chat " + RANK_D->query_respect(ob) + "想不到这个世界上还有人可以继承我家老爷的胡家刀。");
  command("recruit " + ob->query("id"));
  ob->set("title", HIB "胡家刀传人" NOR);
}
