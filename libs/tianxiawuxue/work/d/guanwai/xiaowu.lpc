inherit ROOM;
void create()
{
    set("short", "内室");
    set("long", @LONG
这是专供仆人休息的小屋。屋里放着一张床，挤挤地占掉了屋子的一大半
地方。屋角很散乱地放了一些日常生活用具。中央放着一张桌子，上面摆一
茶壶和几个杯子。墙上挂着闯王的画像.
LONG );
set("exits", ([
    "out"  : __DIR__"dating",
]));
set("objects", ([
        __DIR__"npc/hufei" : 1,
    ]) );    
    set("no_sleep_room","1") ;
    setup();
    replace_program(ROOM);
