// hufei.c
// BY dream
#include <ansi.h>;
inherit NPC;
 string ask_me();
string ask_book();

void create()
{
    set_name("胡斐", ({"hu fei", "hu", "fei"}));
    set("gender", "男性");
    set("nickname", "雪山"HIG"飞狐"NOR);
    set("age", 25);
    set("long", 
      "他就是胡一刀之子，因其武功高强神出鬼没。\n"
      "在江湖上人送外号「雪山飞狐」。\n"
      "他身穿一件白色长衫，腰间别着一把看起来很旧的刀。\n"
      "他满腮虬髯，根根如铁，一头浓发，却不结辫。\n");
    set("attitude", "peaceful");
    set("str", 450);
    set("int", 300);
    set("con", 300);
    set("dex", 300);
    set("chat_chance", 20);
    set("chat_msg", ({
        "胡斐叹了口气道：“不知什么时候还能再见到若兰姑娘。\n",
        "胡斐恨恨道：“苗人凤是我杀父仇人，我必报此仇！”\n",
        "胡斐切齿恨道：“阎基老贼暗中下毒，我必手刃此獠！”\n",
      }));
    
    set("qi", 30000);
    set("max_qi", 30000);
    set("jing", 20000);
    set("max_jing", 10000);
    set("neili", 30000);
    set("max_neili", 30000);
    set("jiali", 1000);
    set("combat_exp", 190000000);
    set("score", 20000);
    
    set_skill("force", 1210);             // 基本内功
    set_skill("hujia-daofa", 1200);       // 胡家刀法    
    set_skill("blade", 1200);             // 基本刀法
    set_skill("hunyuan-yiqi", 1200);      // 混元一气功
    set_skill("dodge", 1200);             // 基本躲闪
    set_skill("hujia-shenfa", 1200);    // 胡家身法
    set_skill("parry", 1120);             // 基本招架
    
    map_skill("force", "hunyuan-yiqi");
    map_skill("blade", "hujia-daofa");
    map_skill("dodge", "hujia-shenfa");
    map_skill("parry", "hujia-daofa");
    set("inquiry",([
        "冷月宝刀":     (: ask_me :),
        "阎基":     "阎基这个狗贼我非杀了他不可。\n",
        "胡一刀":   "辽东大侠胡一刀是我爹。不过我从没见过他。\n",
        "苗人凤":   "苗人凤虽和家父齐名，家父却死在他的剑下。\n",
        "苗若兰":   "不知什么时候还能再见到若兰姑娘。\n",
        "若兰":   "不知什么时候还能再见到若兰姑娘。\n",
        "若兰姑娘":   "不知什么时候还能再见到若兰姑娘。\n",
        "程灵素":   "二妹是为我而死的。\n",
        "赵半山":   "你见我赵三哥了? \n",
        "袁紫衣":   "算了，别提这伤心事了。\n"
      ]));
    create_family("胡家刀门", 1, "嫡传");
   set("baodao_count",1);
   set("chat_chance_combat", 300);
        set("chat_msg_combat", ({
        (: perform_action, "blade.bafan" :),
    }) );
    setup();

     carry_object("/d/city/obj/cloth")->wear();
     carry_object("/d/guanwai/npc/obj/cwbdao")->wield();
     carry_object("/d/guanwai/npc/obj/lydao")->wield();
}

void attempt_apprentice(object ob)
{
                if ((int)ob->query_skill("blade", 1) < 300) {
                command("say 你基本功太差了，学不会我的功夫。"); 
                command("say " + RANK_D->query_respect(ob) + 
                        "你还是把基本功练好了在来找我！");
                return;
        }
        if ((int)ob->query_skill("hujia-shenfa", 1) < 300) {
                command("say 你的轻功底子太差。"); 
                command("say " + RANK_D->query_respect(ob) + 
                        "你还是把轻功先提高了在来吧？");
                return;
        }
        if ((int)ob->query_skill("hujia-dao", 1) < 300) {
                command("say 你的胡家刀底子太差。"); 
                command("say " + RANK_D->query_respect(ob) + 
                        "你还是把胡家刀先提高了在来吧？");
                return;
        }
          if ((int)ob->query_skill("hunyuan-yiqi", 1) < 300) {
                command("say 你的内功底子太差。"); 
                command("say " + RANK_D->query_respect(ob) + 
                        "你还是把内功先提高了在来吧？");
                return;
        }
       command("chat " + RANK_D->query_respect(ob) + "想不到这个世界上还有人可以继承我的胡家刀法。");
        command("recruit " + ob->query("id"));
        ob->set("title",HIB"胡家刀亲传"NOR);
}
string ask_me()
{
    object ob, me;
    
    me = this_player();
    if((int)me->query("shen") < 0)
    {
        me->set_leader(ob);
        call_out("do_kill",1,this_player());
    }
    else if((int)(me->query("shen")<10000000))
        return "以你目前的作为是不能拿这把刀的。\n";
    
    else if((int)(me->query("shen") > 10000000))
    {
        if(query("baodao_count") > 0)
        {               
            call_out("waiting",0,me,ob);
            add("baodao_count", -1);
            ob = new (__DIR__"obj/lydao");
            ob->move(me);
            command("rumor "+me->query("name")+"拿到冷月宝刀啦。\n");
            return " 好吧，这把冷月宝刀就赠与你，希望你好好利用它。\n";
        }
        else return "你来晚了，现在这把刀已不在此处。\n";
    }
    
}

void do_kill(object ob)
{
    object me, room1;       
    me = this_object();
    room1 = environment(me);
    /*
            if (room1->query("no_fight"))
                room1->set("no_fight", 0);
    */
    if (interactive(ob))
    {
        command("say 你这恶贼竟敢打我宝刀的主意，给我纳命来！\n");
        me->set_leader(ob);
        me->kill_ob(ob);
        ob->fight_ob(me);
        remove_call_out("kill_ob");
        call_out("kill_ob", 1, ob);
    }
    
}       

int accept_object(object me, object ob)
{
    int i;
    if ( (string)ob->query("id") == "yan ji") 
    {
        write(HIC "\n胡斐说道：这位" + RANK_D->query_respect(me)+"，如此大恩大德，在下实不知何以为报。\n");
        write(HIC "\n胡斐大喜道：狗贼！想不到你也有今天！！手起刀落，将阎基剁为两段。\n");
        ob->die();
        me->set_temp("marks/hujiadaopu",1);
    }
    return 1;
}



