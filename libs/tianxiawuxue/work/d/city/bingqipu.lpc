// #include <room.h>

inherit ROOM;

void create() {
  set("short", "百晓生兵器排名榜");
  set("long", HIG @LONG 
       "武林至尊,宝刀屠龙"
           "号令天下,莫敢不从"
           "倚天不出,谁与争峰"        
LONG
    NOR);
  set("no_die", 1);
  set("no_fight_npc", 1);
  set("no_fight", 1);
  set("no_get", 1);
  set("exits", ([
    "down": __DIR__ "guangchang",
  ]));
  set("item_desc", ([
    "sign": @TEXT
   虹台论剑
天下归心
TEXT
  ]));

  set("objects", ([
    __DIR__ "npc/bingqipu": 1,

  ]));


  setup();
}
