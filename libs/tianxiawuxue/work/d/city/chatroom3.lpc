// Room: /d/snow/chatroom.c
// This is a room made by roommaker. write by Fan. :)
inherit ROOM;
void create()
{
        set("short", HIR"秘密商店"NOR);
        set("long", HIW@LONG
这是大榕树上的秘密商店,可以买到许多不常见的物品哦!柜台
上摆着一个牌子(paizi).
LONG
        NOR);
        set("item_desc", ([
		"paizi": HIW@TEXT
			
仙丹(Xian dan)：                一百两黄金 (+ food)
返老还童丹(Xian dan)：          一千两黄金 (age -1)
清神丹(Qingshen dan)：          一千两黄金 (set shen 0)
朱睛冰蟾(Chan)：                一千两黄金 (解毒) 
返身丹(Fanshen dan)：           一千两黄金 (消除帮会)
消精丹(Xiaojing dan)：          一两黄金    (-1w neili -2w jingli)

TEXT
	NOR]) );
        
        set("exits", ([
        "east": __DIR__"chatroom",
        ]));
        set("no_fight",1);
        set("no_magic",1);
        set("freeze",1);
        set("objects", ([
        "/d/city/npc/hhm":2,
        ]));
        setup();
       
}
void init()
{
    if (wizardp(this_player())) return;
    add_action("discmds",({"sleep","respitate","exert","array","duanlian","ansuan","touxi","persuade","teach","exert","exercise","study","learn","kill","steal","conjure","fight","hit","perform","prcatice","scribe","surrender"}));
}
int discmds()
{
        tell_object(this_player(),"现在你还是专心聊天吧！\n");
        return 1;
}
