inherit NPC;
#include <ansi.h>;
void create()
{
        set_name(HIR"拉 登"NOR, ({ "la deng", "ladeng","la","deng" }) );
        set("title", HIR"基地组织"HIY"瓢把子"NOR);
        set("gender", "男性");
        set("class", "swordsman");
        set("long", 
        "他就是人称超级恐怖分子的本.拉登，如果你连他都不知道,\n"
        "本人建议你回家玩泥巴去吧!\n"
        "嘘,小点儿声,当心他用炸弹炸你家厕所!\n");
        set("age", 55);
        set("attitude", "peaceful");
        set("str", 26);
        set("con", 30);
        set("dex", 30);
        set("int", 28);
        set("inquiry", ([
                "萨达姆" : "可怜的家伙,没有本事就不要和美国玩儿!\n",
                "hanchat" : "呵呵,不是看在他也在美国的份上,我早炸白宫了.\n",
                "胡锦涛" : "呵呵！昨天刚刚一起吃过牛肉面.\n",
                "dream" : "连他你就不认识，你还在这里混什么混？滚回家玩泥巴去吧！\n",
                ]) );
        set("neili", 10000);
        set("max_neili", 10000);
        set("jingli", 100000);  //by hhm 改为了吸精力npc.
        set("max_jingli", 100000);        
        set("jiali", 3000);
        set("max_qi",800000);
        set("max_jing",450000);
        set("combat_exp", 100000000);
        set("shen", 0);

        set_skill("unarmed", 1000);        
        set_skill("force", 1000);
        set_skill("parry", 1000);
        set_skill("dodge", 10000);        
        set_skill("huanghunluohua", 5000);
        map_skill("dodge", "huanghunluohua");

        setup();

        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/clone/cloth/cloth")->wear();
}

void kill_ob(object ob)
{
        ob->remove_killer(this_object());
        remove_killer(ob);
        command("cry " + ob->query("id"));
}
