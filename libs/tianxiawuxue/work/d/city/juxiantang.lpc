#include <room.h>
inherit ROOM;
void create() {
  set("short", RED "聚贤堂" NOR);
  set("long", "
    " BRED + HIB "※※※※※※※※※※※※※※※※※※※※※※※※※※※※" NOR "
    " BRED + HIB "※※※※※※※※※※※※※※※※※※※※※※※※※※※※" NOR "
    " BRED + HIB "※※                                                ※※" NOR "
    " BRED + HIB "※※               " NOR + BRED + HIW "提剑跨骑挥鬼雨" NOR + BRED + HIB "                   ※※" NOR "
    " BRED + HIB "※※               " NOR + BRED + HIW "白骨如山鸟惊飞" NOR + BRED + HIB "                   ※※" NOR "
    " BRED + HIB "※※               " NOR + BRED + HIW "尘世如潮人如水" NOR + BRED + HIB "                   ※※" NOR "
    " BRED + HIB "※※               " NOR + BRED + HIW "只叹江湖几人回" NOR + BRED + HIB "                   ※※" NOR "
    " BRED + HIB "※※                                                ※※" NOR "
    " BRED + HIB "※※※※※※※※※※※※※※※※※※※※※※※※※※※※" NOR "
    " BRED + HIB "※※※※※※※※※※※※※※※※※※※※※※※※※※※※" NOR "\n"
  );
  set("exits", ([ /* sizeof() == 1 */
    "north": __DIR__ "xxci2",
    "west": "/d/city/chatroom",
    "south": __DIR__ "xxci3",
    "east": __DIR__ "xxci1",
  ]));
  set("no_new_clean_up", 0);
  set("no_sleep_room", 1);
  setup();
  call_other("/d/board/play_b", "???");
  replace_program(ROOM);
}

int valid_learn(object ob) {
  return notify_fail("平时不烧香,临时抱佛脚也没有用了!");
}
void init() {
  if (!wizardp(this_user()))
    add_action(
      "discmds",
      ({
        "duanlian",
        "ansuan",
        "attack",
        "sha",
        "home",
        "array",
        "get",
        "persuade",
        "teach",
        "exert",
        "exercise",
        "study",
        "learn",
        "sleep",
        "steal",
        "cast",
        "conjure",
        "expell",
        "prcatice",
        "scribe",
        "surrender",
        "practice"
      })
    );
}
int discmds() {
  tell_object(this_player(), "平时不烧香,临时抱佛脚也没有用了！\n");
  return 1;
}
