#include <ansi.h>

inherit NPC;

void create()
{
        set_name("LYWIN", ({ "lywin"}));
        set("long", "殿堂级人物，泥巴元老\n" 
                    "星月的第一代wiz ,大陆资深的jy wiz,高手中的高手\n");
        set("nickname", HIW "星月BOSS" NOR);
        set("title", HIY "大宗师" NOR);
        set("gender", "男性");
        set("age", 24);
        set("attitude", "friendly");
        set("shen_type", 1);
        set("str", 500);
        set("int", 500);
        set("con", 500);
        set("dex", 500);
        set("per", 30);
        set("max_qi", 100000);
        set("max_jing", 100000);
        set("max_neili", 100000);
        set("neili", 100000);
        set("jiali", 5000);
        set("combat_exp", 1000000000);

        set_skill("dodge", 1000);
        set_skill("parry", 1000);
        set_skill("unarmed", 1000);
        set_skill("blade", 1000);
        set_skill("force", 1000);
        set_skill("literate", 1000);

        setup();

        carry_object(__DIR__"obj/cloth1")->wear();
        carry_object(__DIR__"obj/fengyundao")->wield();
}

