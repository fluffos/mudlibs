#include <weapon.h>
#include <ansi.h>
inherit BLADE;
void create()
{
        set_name( WHT "玄天血刀" NOR,  ({ "xuantian dao", "blade", "dao" }));
        set_weight(20000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long", "一柄玄铁铸造的刀，刀柄上雕有神龙的图像。\n");
                set("value", 100000);
                set("material", "gold");
                set("wield_msg", HIY "$N" HIW "抽出玄天血刀挥舞了个半圆，只感到一股凛冽的"
                                 NOR + HIR "杀气" NOR + HIW "扑面而来。\n" NOR);
                set("unwield_msg", HIR "$N" HIR "叹了口气，将玄天血刀插回背后。\n" NOR);

        }
        init_blade(500);
        setup();
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
        int pro;
        int extra;
        extra = (int) me->query("str");
        victim->receive_damage("jing", extra*20);
        return HIR "玄天血刀发出一道慑人的杀气，$n" HIR "只感到心神俱碎。\n" NOR;
}
