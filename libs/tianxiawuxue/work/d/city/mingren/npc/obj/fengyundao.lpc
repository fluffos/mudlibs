#include <weapon.h>
#include <ansi.h>
inherit BLADE;
void create()
{
        set_name( WHT "风云刀" NOR,  ({ "fengyun dao", "blade", "dao" }));
        set_weight(20000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long", "一柄精钢打造天兵神器，整个刀身呈血红色。\n");
                set("value", 100000);
                set("material", "gold");
                set("wield_msg", HIR "$N" HIR "从背后抽出风云刀，天地顿时为之风云变色。\n" NOR);
                set("unwield_msg", HIR "$N" HIR "叹了口气，将风云刀插回背后。\n" NOR);

        }
        init_blade(500);
        setup();
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
        int pro;
        int extra;
        extra = (int) me->query("str");
        victim->receive_damage("qi", extra*10);
        return HIR "风云刀发出一阵的吓人低鸣声，$n" HIR "只感到精气狂泄。\n" NOR;
}
