#include <ansi.h>

inherit NPC;

void create()
{
        set_name("LONELY", ({ "lonely", "zhang", "wei"}));
        set("long", "殿堂级人物，泥巴元老\n" 
                    "XKX青岛站资深wiz ,后加入WMKJ,现在独掌NT\n");
        set("nickname", HIW "泥潭老大" NOR);
        set("title", HIY "大宗师" NOR);
        set("gender", "男性");
        set("age", 24);
        set("attitude", "friendly");
        set("shen_type", 1);
        set("str", 500);
        set("int", 500);
        set("con", 500);
        set("dex", 500);
        set("per", 30);
        set("max_qi", 100000);
        set("max_jing", 100000);
        set("max_neili", 100000);
        set("neili", 100000);
        set("jiali", 5000);
        set("combat_exp", 1000000000);

        set_skill("dodge", 1000);
        set_skill("parry", 1000);
        set_skill("unarmed", 1000);
        set_skill("sword", 1000);
        set_skill("force", 1000);
        set_skill("literate", 1000);
        set("inquiry", ([	
		"xiha" : "唉，孽缘啊孽缘.....你问这干嘛？\n",
        ]));

        setup();

        carry_object(__DIR__"obj/cloth1")->wear();
        carry_object(__DIR__"obj/fengyunjian")->wield();
}

