#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIG "【名人殿入口】" NOR);
  set("long", NOR @LONG
这里就是传说中的名人殿的入口，名人殿里面的人物都是泥巴元老。
中国泥巴的发展离不开他们的辛勤劳动和无私奉献，为此特意建立名人殿
表彰他们在mud领域的丰功伟绩！
LONG NOR);
  set("exits", ([
    "south": "/d/city/wumiao",
    "north": __DIR__ "road1",
  ]));
  set("sleep_room", 1);
  setup();
