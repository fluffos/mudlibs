#include <ansi.h>
inherit ROOM;
void create() {
  set("short", HIY "【快意恩仇殿西侧】" NOR);
  set("long", HIW @LONG

             快    意    恩    仇    殿

    这里是一片茫茫云海，四周除了彩云以外不见任何事物。
在众彩云中，有一朵发出异样光芒，看得人如痴如醉.....

LONG NOR);
  set("exits", ([
    "east": __DIR__ "road3",
  ]));
  set("item_desc", ([
    "彩云": HIW "\n一蓬发出耀眼光芒的彩云，似乎可以（eat）。\n" NOR,
  ]));
  set("no_fight", 1);
  set("no_sleep_room", 1);
  set("no_steal", 1);
  set("no_beg", 1);
  set("no_study", 1);
  set("no_yun", 1);
  set("objects", ([
    __DIR__ "npc/lonely": 1,
  ]));
  setup();
}
void init() {
  add_action("do_eat", "eat");
}
int do_eat(string arg) {
  object paper,
    me = this_player();
  int heal, heal1;
  if (!arg || arg == "")
    return 0;
  if (arg == "彩云") {
    message_vision(HIW "\n$N" HIW "拿起一朵彩云大口大口的吞下去,\n"
      "顿时觉得身体充满了力量！\n"
      NOR, this_player());
    heal = me->max_water_capacity();
    heal1 = me->max_food_capacity();
    me->set("food", heal1);
    me->set("water", heal);
    me->clear_condition();
    me->reincarnate();
    return 1;
  }
  return 0;
}
