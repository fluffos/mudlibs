#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIG "【天堂之路】" NOR);
  set("long", NOR @LONG
你来到这里，发现这里这里就是人间仙境。眼前这一条天堂之路是由一片
彩霞堆积而成，你踩在上面感觉极其舒服，但是又怕一个不小心掉了下去。
LONG NOR);
  set("exits", ([
    "east": __DIR__ "kyec1",
    "west": __DIR__ "kyec2",
    "south": __DIR__ "road2",
    "north": __DIR__ "road4",
  ]));
  set("sleep_room", 1);
  setup();
}
