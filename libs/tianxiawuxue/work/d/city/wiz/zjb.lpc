#include <ansi.h>
inherit NPC;
void create() {
  set_name(HIW "綰綰" NOR, ({ "buy npc" }));

  set("gender", "男性");
  set("age", 19);
  set("long",
    "綰綰.一个不寻常的名字,他的主人也是一个不寻常的人\n"
    "綰綰原来是红尘中player群中的其中一名player,\n"
    "后来因感到玩MUD无趣,改向WIZ方向发展,先后参与了好几\n"
    "个MUD的开发,后受邀来到天下无雪的参与开发,是\n"
    "天下无雪的主要的巫师之一.\n");
  set("attitude", "peaceful");
  set("title", HIG "孤独的男人" NOR);
  set("nickname", HIB "〖" HIC "高手" HIB "〗" HIW "高高手" NOR);
  set("chat_chance", 3);
  setup();
  carry_object("/clone/misc/cloth")->wear();
}
