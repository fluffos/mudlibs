#include <ansi.h>
inherit NPC;
void create() {
  set_name(HIW "天下无雪" NOR, ({ "dream npc" }));

  set("gender", "男性");
  set("age", 25);
  set("long",
    "天下无雪？呵呵~身份来历不明,是江湖风云2之天下无雪\n"
    "的全年被最容易被eat,pk的人物最之一,也是天下无雪\n"
    "的主要的wiz之一，大家多多关照啊.我无论你们\n"
    "如何威逼拷打也不会服从的，我是天下无雪我怕谁啊!~~\n"
    "我先逃了~所有事情找buy解决，我去wc方便一下..\n");
  set("attitude", "peaceful");
  set("title", HIW "我爱你,就像老鼠爱大米" NOR);
  set("chat_chance", 3);
  setup();
  carry_object("/clone/misc/cloth")->wear();
}
