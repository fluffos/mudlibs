// 九转还魂丹

#include <ansi.h>

inherit ITEM;

int do_eat(string);
void init();

void init() {
  add_action("do_chai", "chai");
}

void create() {
  set_name(HIR "圣诞卡片" NOR, ({ "xmas card", "card" }));
  set_weight(0);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("long", "这是一张santa claus给你的卡片, 你可以拆开他(chai)。\n");
    set("value", 0);
    set("no_give", 1);
    set("no_drop", 1);

  }

  setup();
}

int do_chai() {
  string skill_name, type;
  int skill_value, value, used;
  object diamond;
  skill_name = this_object()->query("skill_name");
  value = this_object()->query("value");
  used = this_object()->query("used_point");
  type = this_object()->query("type");
  skill_value = this_object()->query("skill_value");

  if (value < 0) return notify_fail("你还是重新许愿吧\n");
  if (skill_value < 0) return notify_fail("你还是重新许愿吧\n");

  if (this_player()->query("id") != this_object()->query("xmas_owner")) {
    write("你当hanchat白痴阿 你的礼物没收了!\n");
    destruct(this_object());
    return 1;
  }
  if (this_player()->query("xmas_gift_times") > 12) {
    write("你的xmas机会已经用完了 很可惜你浪费钱了!\n");
    destruct(this_object());
    return 1;
  }
  if (this_object()->query("type") == "skills") {
    write(HIR "卡上写着: 恭喜你! 你获得了圣诞老公公给你的" + skill_name + chinese_number(skill_value) + "级!\n" NOR);
    this_player()->set_skill(skill_name, (this_player()->query_skill(skill_name, 1) + skill_value));
    this_player()->set("xmas_gift_time", used);
    destruct(this_object());
    return 1;
  } else if (this_object()->query("type") == "exp")

  {
    write(HIR "卡上写着: 恭喜你! 你获得了圣诞老公公给你的" +
      this_object()->query("type") + chinese_number(value) + "点\n" NOR);
    this_player()->set("combat_exp", this_player()->query("combat_exp") + value);
    this_player()->set("xmas_gift_time", used);
    destruct(this_object());
    return 1;
  }

  else if (this_object()->query("type") == "pot")

  {
    write(HIR "卡上写着: 恭喜你! 你获得了圣诞老公公给你的" +
      this_object()->query("type") + chinese_number(value) + "点\n" NOR);
    this_player()->set("potential", this_player()->query("potential") + value);
    this_player()->set("xmas_gift_time", used);
    destruct(this_object());
    return 1;
  }

  else if (this_object()->query("type") == "neili")

  {
    write(HIR "卡上写着: 恭喜你! 你获得了圣诞老公公给你的" +
      this_object()->query("type") + chinese_number(value) + "点\n" NOR);
    this_player()->set("max_neili", this_player()->query("max_neili") + value);
    this_player()->set("xmas_gift_time", used);
    destruct(this_object());
    return 1;
  }

  else if (this_object()->query("type") == "jingli")

  {
    write(HIR "卡上写着: 恭喜你! 你获得了圣诞老公公给你的" +
      this_object()->query("type") + chinese_number(value) + "点\n" NOR);
    this_player()->set("max_jingli", this_player()->query("max_jingli") + value);
    this_player()->set("xmas_gift_time", used);
    destruct(this_object());
    return 1;
  }

  else if (this_object()->query("type") == "money") {
    write(HIR "卡上写着: 恭喜你! 你获得了圣诞老公公给你的" + chinese_number(value) + "钻石\n" NOR);
    diamond = new("/clone/money/diamond");
    diamond->set_amount(value);
    diamond->move(this_player());
    this_player()->set("xmas_gift_time", used);
    destruct(this_object());
    return 1;
  }

  else {
    write(HIR "卡上写着: 对不起, 你今年的愿望无法实现!\n" NOR);
    destruct(this_object());
    return 1;
  }

}
