// socks for xmas by hanchat@txwx 2005
inherit ITEM;
#include <ansi.h>

void get_type(string arg);
void get_skill_name(string skill, string name);
void get_skill_value(string value, string skill, string name);
void get_value(string value, string name);
void create()
{
        set_name( HIW "圣诞袜_纯银版" NOR,({"xmas socks silver"}));
        set_weight(200);
        set_max_encumbrance(8000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
            set("long",
                "这里圣诞夜里大家都会挂(hang)的袜子, 挂起来以后就可以许愿了(wish)。\n");
            set("unit","支");
	     set("no_get", 1);
	     set("no_drop", 1);
	     set("capacity", 1);
	     set("chance", 20);
            set("value", 5);
        }
}
int is_container() { return 1; }
void init()
{
    if ( (environment()==this_player()) && (this_object()->query("xmas_owner") == this_player()->query("id")))
                add_action("do_hang","hang");
    else if( 
		(  environment()==environment(  this_player()  )   ) 
		&& (  this_object()->query("xmas_owner") == this_player()->query("id")  ) 
		&& this_object()->query("hanged") 
		&& !this_object()->query("wished") 
	  )
		  add_action("do_wish", "wish");

}
int do_hang(string arg)
{
    int rnd;
    object me = this_player();
        object where = environment(me);
    if (arg != "socks")  return 0;


    message_vision("$N拿起手中的" + this_object()->query("name") + "顺手就往" 
		+ environment(this_player())->query("short") + "的墙边挂了起来！\n",me);

    
this_object()->set("name", this_player()->query("name") + "的" + this_object()->query("name"));
this_object()->set("hanged", 1);
this_object()->move(environment(this_player()));

    
        return 1;
}

int do_wish()
{

	write("袜子挂起来以后就可以许愿了哦!\n");
	write("把你想要得愿望写在袜子上，这样当圣诞老公公看到的时候\n");
	write("就会发礼物给你咯!....如果他同意的话!\n");
	write("所以不能太过分哦\n");
	write("准备好了吗? 可以开始写了哦!\n\n");
	write("目前能实现的愿望有经验(exp), 潜能(pot), 内力(neili), 精力(jingli), 金钱(money), 武功(skills)\n");
	write("方法是这样, 比如果你要经验, 你就可以许愿加经验10000000, 如果圣诞老公公觉得可以的话\n");
	write("那他就会给你你的礼物放在你的袜子里面。\n");
	write("或者如果你想要武功 比如果beiming-shengong进步100级 都可以的\n");
	write("成功率跟你买的袜子还有运气有关 并不是wiz决定哦!!\n");
	write("请选择你的愿望(exp, pot, neili, jingli, money, skills):");
	input_to("get_type");
	return 1;
}

void get_type(string arg)
{
	switch(arg){
	case "exp":
			write("你选择了加经验, 请输入你想要加多少经验:");
			input_to("get_value", arg);
			return;
	case "pot":
			write("你选择了加潜能, 请输入你想要加多少潜能:");
			input_to("get_value", arg);
			return;
	case "neili":
			write("你选择了加内力, 请输入你想要加多少内力:");
			input_to("get_value", arg);
			return;
	case "jingli":
			write("你选择了加精力, 请输入你想要加多少精力:");
			input_to("get_value", arg);
			return;
	case "money":
			write("你选择了加钱, 请输入你想要加多少钱,以diamond当作unit:");
			input_to("get_value", arg);
			return;
	case "skills":
			write("你选择了加武功, 输入你要的武功名字, ");
			input_to("get_skill_name", arg);	
			return;
	default:
		write("输入错误 重新输入!\n");
		write("请选择你的愿望(exp, pot, neili, jingli, money, skills):");
		input_to("get_type");
			return;
	}
	return;
}

void get_value(string value, string name)
{
	int p;
	if( !value || value == "" || (sscanf( value , "%d", p)!=1))
		{
			write("输入错误 重新输入 你要加" + name + "!\n");
			input_to("get_value", name);
		}	
	this_object()->set("long", this_player()->query("name")+ "希望今年圣诞夜能拿到" + name + chinese_number(p) +"点!\n");
	this_object()->set("xmas_wish_type", name);
	this_object()->set("xmas_wish_value", p);
	message_vision("$N低头想了想，把他今年的愿望写在了他的袜子上\n", this_player());
	return;

}

void get_skill_name(string skill, string name)
{
	if( !this_player()->query_skill(skill, 1) )
		{
			write("你不会这项武功 重新输入:\n");
			input_to("get_skill_name", name);
			
		}
	write("输入你要加多少等级的" + skill);
		input_to("get_skill_value", skill, name);
	return ;

}


void get_skill_value(string value, string skill, string name)
{
	int p;
	if( !value || value == "" || (sscanf( value , "%d", p)!=1))
		{
			write("输入你要加多少等级的" + skill);
			input_to("get_skill_value", skill, name);
		}	
	this_object()->set("long", this_player()->query("name")+ "希望今年圣诞夜能加" + name + "的" + skill + chinese_number(p) +"级!\n");
	this_object()->set("xmas_wish_type", name);
	this_object()->set("xmas_wish_skill", skill);
	this_object()->set("xmas_wish_skill_value", p);
	message_vision("$N低头想了想，把他今年的愿望写在了他的袜子上\n", this_player());

	return;

}
