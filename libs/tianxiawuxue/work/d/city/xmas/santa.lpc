//santa for 2005 by hanchat @txwx2
inherit NPC;

void go_give();
void create()
{
        set_name( HIW "老公公" NOR, ({ "santa claus", "santa", "claus" }));
        set("title", HIR "圣诞" NOR);
        set("long", 
"他身材较胖，身穿红色大衣，有长长的白鬍子。\n");
        set("gender", "男性");
        set("age", 888);
	 set("class", "xiake");
        set("attitude", "peaceful");
        set("str", 30);
        set("int", 40);
        set("con", 30);
        set("per", 30);
        set("qi", 2800);
        set("max_qi", 2800);
        set("jing", 1600);
        set("max_jing", 1600);
        set("neili", 4800);
        set("max_neili", 2400);
        set("jiali", 60);
        set("combat_exp", 38000000);
        set("max_jingli", 1000);
          set("max_neili", 10000);
        set("jingli", 100000);
        set("neili",10000000);
         set("jiali",1000);

	set("chat_chance",40);
       
    set("chat_msg",({
        "叮铃当~ 叮铃当~ 铃声多响亮~~~~\n",
        "HOHOHO! HAPPY NEW YEAR~~~~ ~~~~\n",
        "HO HO HO!! MERRY XMAS!!~~~~\n",
       }) );
        set("inquiry", ([
                "xmas"    : "txwx proudly present to you ur xmas gift! made by hanchat",
        ]));
	 setup();

        carry_object("/clone/cloth/cloth")->wear();
        carry_object("/clone/weapon/changjian")->wield();

}


void init()
{

  add_action("go_give", "@hanchat@");

}

void greeting()
{
        say( BLK HIR "突然叮铃当~ 叮铃当~~~" + this_object()->query("name") + "架着雪橇飞了过来\n" NOR);
}

void go_give()
{
	object *ob1, *ob2, *ob3, *ob4, obj1, obj2, obj3, obj4, card, env;
	

	ob1=children("/d/city/xmas/obj/socks.lpc");
	ob2=children("/d/city/xmas/obj/socks_silver.lpc");
	ob3=children("/d/city/xmas/obj/socks_gold.lpc");
	ob4=children("/d/city/xmas/obj/socks_diamond.lpc");
	message("channel:rumor", HIR "【圣诞老公公】"+ "HO HO HO 圣诞快乐!! 发礼物去了!!\n" NOR, users() );
	foreach (obj1 in ob1)
	{
		if(!env=environment(obj1))
			destruct(obj1);
		else
		if( obj1->query("xmas_wish_type") && ! obj1->query("wished") 
			&& random(150) < obj1->query("chance") 
			
			)
		if(obj1->query("xmas_wish_type")=="money" && obj1->query("xmas_wish_value") > (100*random(10)))
				{
				card=new("/d/city/xmas/obj/card");
				card->set("type", "nogoooooo");
				card->set("xmas_owner", obj1->query("xmas_owner"));
				card->move(obj1);
				obj1->set("wished", 1);
				}
		else if(obj1->query("xmas_wish_type")=="exp" && obj1->query("xmas_wish_value") > (1000000*random(10)))
