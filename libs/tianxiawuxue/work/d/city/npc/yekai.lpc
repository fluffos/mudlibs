// master.c
inherit NPC;
inherit F_MASTER;
#include <ansi.h>
void create()
{
    set_name("叶开", ({ "ye kai", "ye", "kai" }) );
        set("nickname", MAG"边城浪子"NOR);
        set("gender", "男性" );
        set("age", 24);
        set("str", 30);
        set("cor", 30);
        set("cps", 30);
        set("int", 30);
	set("per", 30);
            set("shen_type", 1);
	set("attitude","friendly");
        set("max_force", 15000);
        set("force", 15000);
	set("courage",1000);
        set("force_factor", 3);

        set("rank_info/respect", "小叶");

        set("long",
"叶开别号边城浪子，乃是一代人杰小李探花的弟子，小李飞刀的第二代传人。\n"                
	);
        create_family("风云一刀", 2, "传人");
	set("student_title","浪子");
        set("combat_exp", 3000000000);
        set("score", 100000);

        set("chat_chance", 10);
        set("chat_msg", ({
                            "叶开点点头，道：“我不能忘记叶家的养育之恩”。\n",
                "叶开迎风而立，只觉得胸中热血澎湃，久久难以平息。\n",
"叶开看着你，目光中也充满了痛苦和歉疚。\n",
"叶开道：“感谢兔子大人帮忙把飞刀绝艺寻回，我把书藏起来了”。\n",
"叶开道：“感谢兔子大人帮忙把飞刀绝艺寻回，我把书贴身收藏起来了”。\n",
        }) );
        set_skill("parry", 200);
        set_skill("dodge", 1000);
        set_skill("throwing", 300);
	set_skill("feidao", 180);
        set_skill("force", 1000);
             set_skill("yijing-force", 500);
        set_skill("literate", 1000);
              set_skill("piaoxiang-bufa", 300);
         map_skill("throwing", "feidao");
              map_skill("dodge", "piaoxiang-bufa");
              map_skill("parry", "feidao");
                        map_skill("force", "yijing-force");              
            set("max_jing", 8000);
        set("neili", 50000); 
        set("max_neili", 30000);
        set("jiali", 10000);
set("chat_chance_combat", 160);
    set("chat_msg_combat", ({
        (: perform_action, "throwing.jueji" :),
        (: perform_action, "dodge.zonghengsihai" :),
        (: exert_function, "recover" :),
        (: exert_function, "heal" :),
    }) );
    setup();
        carry_object(__DIR__"obj/whitecloth")->wear();
        carry_object("/d/obj/feidao_book")->study();
}
