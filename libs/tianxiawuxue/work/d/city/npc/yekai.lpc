void heart_beat()
{
object feidao;
if(!query_temp("weapon") && is_fighting())
{
	feidao = new(__DIR__"obj/xlfd_knife");
	feidao->move(this_object());
	command("wield flying blade");
WEAPON_D->throw_weapon(this_object(),feidao,0);            
return;
}
else
return ::heart_beat();
}
