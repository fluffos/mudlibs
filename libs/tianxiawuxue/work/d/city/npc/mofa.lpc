#include <ansi.h>
inherit NPC;
string ask_me();

void create() {
  set_name(HIR "魔法师" NOR, ({ "mofa shi", "shi" }));
  set("nickname", HIY "超级无敌恢复" NOR);
  set("gender", "男性");
  set("age", 1800);
  set("long", YEL "这位是〖天下无雪〗的最最厉害的魔法师，向他打听“恢复”，他会带给您想不到的惊喜。\n" NOR);
  set("shen_type", 1);
  set("combat_exp", 1000000000);
  set("str", 300);
  set("dex", 300);
  set("con", 300);
  set("int", 300);
  set("per", 300);
  set("attitude", "friendly");
  set("max_qi", 1000000);
  set("neili", 1000000);
  set("max_neili", 100000);
  set("score", 1000000);

  set("inquiry", ([
    "恢复": (: ask_me :)

  ]));
  setup();
}
void die() {
  message_vision("抱歉，我是不会死的。\n", this_object());
  return;
}

string ask_me() {
  object me = this_player();

  if ((int)me->query("money") < 1000000)
    return "你的钱庄存款不够！";
  if ((int)me->query("potential") < 500)
    return "你的潜能不够500！";
  else {
    me->set("eff_jing", (int)me->query("max_jing"));
    me->set("eff_qi", (int)me->query("max_qi"));
    me->add("potential", -500);
    me->set("shen", 0);
    me->add("money", -1000000);
    me->start_busy(3);
    tell_object(this_player(), HIW "已经从你的银行帐户扣除500gold！\n" NOR); ;
    return "天神啊！让这个心灵受伤害的人重生吧！加入这个混乱的江湖吧!!!\n"
      HIW "突然天空中一道" HIY "金光" HIW "笼罩四方，转瞬即逝！" NOR;
  }
}
