//by hhm
#include <ansi.h>
inherit NPC;
string ask_me();

void create() {
  set_name(HIR "礼物使者" NOR, ({ "liwu shizhe", "shizhe" }));
  set("nickname", HIY "端午节" NOR);
  set("gender", "男性");
  set("age", 18);
  set("long", YEL "这位是端午节礼物使者，向他打听“端午节的粽子我爱吃”，他会带给您想不到的惊喜。\n" NOR);
  set("shen_type", 1);
  set("combat_exp", 1000000);
  set("str", 30);
  set("dex", 30);
  set("con", 30);
  set("int", 30);
  set("per", 30);
  set("attitude", "friendly");
  set("max_qi", 100000);
  set("neili", 100000);
  set("max_neili", 1000);
  set("score", 100000);

  set("inquiry", ([
    "端午节的粽子我爱吃": (: ask_me :)
  ]));
  setup();
}

void init() {
  object ob;
  ob = this_player();
  ::init();
  if (interactive(ob) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

/*void greeting(object ob)
{
   if( !ob || environment(ob) != environment() ) return;
     command("whisper " + ob->query("id") + " "HIW"欢迎光临〖天下无雪〗"+HIR+"(ask shizhe about 节日快乐)\n"+NOR+HIW+"，你会得到五一节日礼物．"NOR);
     command("es " + HIC"祝大家五一节快乐.\n"NOR);
}*/

string ask_me() {
  object me = this_player();
  mapping fam;

  if ((int)me->query("duanwujie-gift"))
    return HIG "我日哦!老子已经给你礼物了,你真是贪得无厌啊!滚开......" NOR;
  else {
    me->add("potential", 50000);
    me->set("duanwujie-gift", 1);
    me->add("max_neili", 5000);
    me->add("neili", 5000);
    me->add("max_jingli", 5000);
    me->add("jingli", 5000);
    me->add("food", 100000);
    me->add("water", 100000);
    me->add("combat_exp", 100000);
    CHANNEL_D->do_channel(me, "es", sprintf("在下%s今日已经得到端午节礼物,同时祝大家节日快乐!!!", me->name(1)));
    return "欢迎光临" NOR + HIR "〖天下无雪〗" NOR "，小的祝你节日快乐,希望你努力成为一代大侠!\n";

  }
}
