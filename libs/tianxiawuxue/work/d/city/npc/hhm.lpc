// hhm.c 
inherit NPC;
inherit F_DEALER;
void create()
{
        set_name(HIR"黄昏落花"NOR, ({ "hhm",}));
        set("title", HIG"天下无敌"NOR);
        set("nickname", HIW"高手"NOR);
        set("shen_type", 1);
        set("str", 30);
        set("per",90);
        set("gender", "男性");
        set("age", 25);
        set("long",
                "黄昏落花就是天下无雪。湖北宜昌人。其实许多朋友都知道。\n"
                "关于本人没有什么好说的，一个狂热的游戏迷。除了mud以外\n"
                "还喜欢三国志系列。可以毫不夸张的说，三国的任何一个系列\n"
                "我都玩过，从一代的e文版，到最近的十一繁体版。\n");
        set("combat_exp", 50000000);
        set("attitude", "friendly");
        set("inquiry", ([
                "天下无雪" : "就是我啊！！！\n",
                "生意" : "现在在宜昌开网吧，养家糊口。\n",
                "理想":"老婆，女儿都有了，还差什么呢？我看除了钱没有其他的了......"
        ]));
        
        set("vendor_goods", ({
                   "/d/city/npc/obj/xiandan",
                   "/u/dream/agedan",
                   "/clone/drug/qingshendan",
                   "/clone/misc/zhujingchan",
                   "/u/dream/bhdan",
                    "/u/dream/dan1",
                  
                  
        }));
        setup();
carry_object("/d/fengxue/obj/hei-ke")->wear();
carry_object("/d/fengxue/obj/tai-e")->wield();
carry_object("/d/fengxue/obj/han-po")->wield();
}

void init()
{
        add_action("do_list", "list");
        add_action("do_buy", "buy");
}

void greeting(object ob)
{
        if (!ob || environment(ob) != environment())
                return;
        switch(random(2)) {
        case 0 :
                say("雪饮狂刀笑眯眯地说道：这位" + RANK_D->query_respect(ob) +
                        "，快请进来看看好东西啊。\n");
                break;
        case 1 :
                say("雪饮狂刀说道：哟！这位" + RANK_D->query_respect(ob) + 
                        "您来了啊！快请!\n");
                break;
        }
}

