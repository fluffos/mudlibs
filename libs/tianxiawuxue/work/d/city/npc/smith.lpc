// smith.c
inherit NPC;
inherit F_DEALER;
int do_datie(string arg);
string do_ask();
void create()
{
        set_name("铁匠", ({ "tie jiang", "smith" }));
	set("title", "铁匠铺老板");
	set("shen_type", 1);
        set("gender", "男性" );
        set("age", 33);
        set("long", "铁匠正用铁钳夹住一块红热的铁块放进炉中。\n");
        set("combat_exp", 400);
	set("attitude", "friendly");
        set("vendor_goods",({
		"/d/city/obj/changjian",
		"/d/city2/obj/tudao",
		"/d/city/obj/dagger",
		"/d/xingxiu/obj/staff",
		"/d/xingxiu/obj/club",
		"/d/city/obj/gangdao",
                "/d/city/obj/gangaxe",
                "/d/obj/feidao",
		"/d/city/obj/whip",
                "/d/obj/feihuangshi",
                "/d/obj/tielianzi",
	   }));
set("inquiry", ([
"job" : (: do_ask :),
]));
	setup();
	carry_object("/clone/misc/cloth")->wear();
}
void init()
{
        add_action("do_list", "list");
        add_action("do_buy", "buy");
add_action("do_datie", "da");
}

string do_ask()
{
object me=this_player();
int exp=me->query("combat_exp");
if(me->is_busy())
return "你现在正忙着呢。\n";
if(exp>550000)
return "这小孩子做的事你也跑来做?\n";
me->set_temp("datie_asked", 1);
return "好吧! 你就在这打铁(da 铁)吧!\n";
}


int do_datie(string arg)
{
if(!arg||arg!="铁")
return notify_fail("你想要打什么? 不会是打自己吧!\n");
if(!this_player()->query_temp("datie_asked"))
return notify_fail("铁匠瞪了你一眼说道:不要乱动我的东西!!!\n");

write("你拿起旁边的铁锤, 开始用力的敲在那块热烘烘的铁上。。。\n");
this_player()->start_busy(random(2));
this_player()->add("combat_exp", random(100));
this_player()->add("potential", random(50));
this_player()->delete_temp("datie_asked");
write("你好像从中领悟了一些东西。\n");
return 1;
}
