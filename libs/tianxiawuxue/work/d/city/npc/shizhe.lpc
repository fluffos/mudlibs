//by hhm
#include <ansi.h>
inherit NPC;
string ask_me();

void create()
{
        set_name(HIR"天下无雪"NOR, ({ "txwx shizhe", "shizhe" }) );
          set("nickname", HIW"新手礼物使者"NOR);
        set("gender", "男性" );
        set("age", 18);
         set("long", YEL"这位是〖天下无雪〗的使者，向他打听“天下无雪”，他会带给您想不到的惊喜。\n"NOR);
        set("shen_type", 1);
        set("combat_exp", 1000000);
        set("str", 30);
        set("dex", 30);
        set("con", 30);
        set("int", 30);
        set("per", 30);
        set("attitude", "friendly");
        set("max_qi", 100000);
        set("neili", 100000);
        set("max_neili", 1000);
        set("score", 100000);

        set("inquiry", ([
                         "天下无雪" : (: ask_me :)
        ]));
        setup();
}

void init()
{
        object ob;
        ob = this_player();     
        ::init();
        if( interactive(ob) && !is_fighting() )
               {
                        remove_call_out("greeting");
                        call_out("greeting", 1, ob);
                }
}

void greeting(object ob)
{
   if( !ob || environment(ob) != environment() ) return;
     command("whisper " + ob->query("id") + " "HIW"欢迎光临〖天下无雪〗"+HIR+"(ask shizhe about 天下无雪)\n"+NOR+HIW+"， 小的助您行走江湖．"NOR);

}

string ask_me()
 {
        object me = this_player();
        mapping fam; 
        
         if ((int) me->query("welcometxwx"))
                return "呵呵～这就是您的不是了！小的已经对您施过法力了！";
               else
        {
                 me->set("combat_exp",me->query("kar") * 10000);
                 me->add("potential",me->query("kar") * 5000);
                 me->set("welcometxwx", 1);
                 me->add("max_neili", 10000);
                 me->add("neili", 10000);
                 me->add("max_jingli", 10000);
                 me->add("jingli", 10000);
                 me->set_skill("force",300);
                 me->set_skill("literate",300);
                 me->add("potential", 50000);
                 me->add("food", 10000);
                 me->add("water", 100000);
           
  CHANNEL_D->do_channel(me, "txwx", sprintf(HIC "在下%s今日光临〖天下无雪〗"HIW"（"HIR"txwx2.3322.org  6666"HIW"）"HIC"\n            现已得到天下无雪的帮助和奖励！即日起开始行走江湖了！", me->name(1)));
                return "欢迎光临"NOR+HIR"〖天下无雪〗"NOR"，小的护架来迟，罪该万死！在下可助您行走江湖！\n"
HIW"突然天空中一道"HIM"七"HIY"彩"HIR"霞"HIC"光"HIW"笼罩四方，转瞬即逝！"NOR;
        }
}


