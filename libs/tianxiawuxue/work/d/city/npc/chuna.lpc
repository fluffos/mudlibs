//银行卡
//@txwx by hhm 05/06/13


#include <ansi.h>
inherit NPC;
string ask_me();

void create()
{
        set_name(HIW"银行出纳小妹妹"NOR, ({ "chuna meimei", "chuna","meimei" }) );
        set("gender", "男性" );
        set("age", 18);
         set("long", YEL"这位是江湖风云的银行出纳,你可以ask chuna about 信用卡。\n"NOR);
        set("shen_type", 1);
        set("combat_exp", 1000000);
        set("str", 30);
        set("dex", 30);
        set("con", 30);
        set("int", 30);
        set("per", 90);
        set("attitude", "friendly");
        set("max_qi", 100000);
        set("neili", 100000);
        set("max_neili", 1000);
        set("score", 100000);

        set("inquiry", ([
                         "信用卡" : (: ask_me :)
        ]));
        setup();
}

void die()
{
        message_vision("抱歉，我是不会死的。\n",this_object());
          return ;
}


string ask_me()
 {
              object me,ob;
              ob=this_player(); 

if(present("card", this_player()))
return ("你不是有一张了???\n");
               else
        {
ob->add("money", 0);
               
    command("say 好吧，您的卡您拿好了,欢迎再来啊!\n");
    message_vision(HIY"出纳妹妹微笑着从柜台中拿出了一张卡，交了给$N\n\n"NOR,ob);
    me=new("/d/obj/xinyongka");
    me->move(ob);
    return "这信用卡可千万不要搞丢了。\n";
        }
}
