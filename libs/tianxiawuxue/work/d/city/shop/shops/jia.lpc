#include <armor.h>
inherit CLOTH;
void create() {
  set_name(HIR "无名甲" NOR, ({ "wumingjia", "jia" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("material", "cloth");
    set("for_create_cloth", 1);
    set("base_armor", 20);
    set("armor_prop/armor", 300);
    set("long", "一块麒麟的披甲。\n");
    set("max_enchant", 3);
    set("value", 200000);
  }
  setup();
}
