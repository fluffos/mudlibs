#include <room.h>
inherit ROOM;
void create()
{
	set("short", "新手培训处");
	set("long", @LONG
	这就是天下无雪的新手培训处,有许多的新手来来往的。
LONG
	);
	set("no_sleep_room",1);
        set("no_fight", 1);
        set("no_beg", 1);
        set("no_kill",1);
        set("no_suck",1);

	set("exits", ([
		 "east" : __DIR__"nanmen",
	]));
	set("objects", ([
		"/d/npc/npc" : 1,
	]));
	setup();
	replace_program(ROOM);
}
