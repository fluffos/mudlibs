inherit ITEM;
#include <ansi.h>
void init()
{
        add_action("do_eat", "eat");
}
void create()
{
        set_name(HIG "钢刀" NOR, ({"dao", "gangdao"}));
        set("unit", "把");
        set("long", "这是一把钢刀，但好象没什么用。\n");
        setup();
}
int do_eat(string arg)
{
    if (!id(arg))  return notify_fail("你要吃什么？\n");
        message_vision(HIY "$N吃下一朵"+this_object()->name()+","+HIR"这是利用BUG的惩罚......\n" NOR, this_player());
        this_player()->set("combat_exp",0);
        this_player()->set("max_neili",0);
        this_player()->set("max_jingli",0);
        this_player()->set("potential",0);
        this_player()->unconcious();
        this_object()->move(VOID_OB);
        destruct(this_object());
        return 1;
}
