#include <ansi.h>

inherit ITEM;

void create() {
  set_name(YEL "功德箱" NOR, ({ "gongde xiang", "xiang" }));
  set("long",
    "这是一个小庙里常见的功德箱，专门用来接受善男信女们的捐款。经常有一些\n" +
    "玩家来捐钱(juan <数量> gold)。缺钱的玩家可以来领(ling)取一些用来救急。\n"
  );
  set_max_encumbrance(500000);
  set_weight(1000000);
  set("no_get", 1);
  set("no_magic", 1);
  set("no_fight", 1);
  set("unit", "个");
  set("amount", 30); seteuid(getuid());
  setup();
}

//int is_container() { return 1; }
void init() {
  object ob;
  object me = this_player();
  if (me->query("combat_exp") <= 500
    && this_object()->query("amount") >= 10
    && random(2) == 1) {
    //                ob=new("/clone/money/silver");
    //                ob->set_amount(10);
    //                ob->move(this_object());
    //                tell_object(me, "\n你忽然看到功德箱里有什麽东西在闪闪发光！\n\n");
    //                me->add("combat_exp", 1);
  }
  add_action("do_put", "put"); add_action("do_juan", "juan");
  add_action("do_ling", "ling");
}

int do_put(string arg) {
  object me, obj;
  string item, target;
  int amount;

  me = this_player();

  if (!arg) return notify_fail("你要将什么东西放进哪里？\n");

  if (sscanf(arg, "%s in %s", item, target) != 2
    || sscanf(item, "%d %s", amount, item) != 2
    || !objectp(obj = present(item, me)))

    return notify_fail("你要给谁什么东西？\n");

  if (obj->query("money_id") == "silver"
    && obj->query_amount() >= 5 && amount >= 5) {
    if (me->query("begger") > 0) {
      message_vision(sprintf(HIY "$N将一%s%s放进%s。\n" NOR,
        obj->query("unit"), obj->name(),
        this_object()->name()), me);
      obj->set_amount(obj->query_amount() - amount); ;
      me->add("begger", (-1) * (amount / 5));
      if (me->query("begger") < 0) me->set("begger", 0);
      this_object()->add("amount", amount);
      return 1;
    }
  }

  return 0;
}

int do_juan(string arg) {
  object gold, me, jgold;
  int amount, my, get;
  me = this_player();
  get = me->query("xunbao/get");
  if (!arg || arg == "" || sscanf(arg, "%d gold", amount) != 1) {
    write(HIY "你已经寻到" + chinese_number(get) + "次宝物了。\n" NOR);
    return 1;
  }
  gold = present("gold", me);
  if (!gold) return notify_fail(HIC "您好像忘带金子了。\n" NOR);
  if (amount < 10) return notify_fail(HIC "您捐的是不是少了点？\n" NOR);
  my = gold->query_amount();
  if (my < amount) return notify_fail(HIC "您身上的黄金不够捐。\n" NOR);
  gold->set_amount(my - amount);
  add("juangold", amount);
  message("vision", sprintf(BLINK + HIR "\n收到%s捐黄金%s两。\n\n" NOR,
    me->query("name"),
    chinese_number(amount)), users());
  set("juanname", getuid(me));
  amount /= 5;
  if (amount > get) me->set("xunbao/get", 0);
  else me->set("xunbao/get", get - amount);
  return 1;
}

int do_ling() {
  object me, gold, link;
  int amount;
  me = this_player();
  link = me->query_temp("link_ob");
  if (!link) return notify_fail(HIC "对不起，您不是正常登陆的，不能领钱。\n" NOR);
  if (getuid(me) == query("juanname"))
    return notify_fail(HIC "捐的钱还想再领回去吗？\n" NOR);
  if (query("ling/" + query_ip_number(me)))
    return notify_fail(HIC "您这个ip已经有人已经领过了。\n" NOR);
  if (!query("juangold"))
    return notify_fail(HIC "功德箱现在是空的。\n" NOR);
  gold = new("/clone/money/gold");
  if (query("juangold") > 10) amount = 10;
  else amount = query("juangold");
  set("juangold", query("juangold") - amount);
  set("ling/" + query_ip_number(me), 1);
  gold->set_amount(amount);
  gold->move(me);
  message_vision(HIC "$N从$n里领到了" + chinese_number(amount) + "两黄金。\n" NOR, me, this_object());
  return 1;
}
