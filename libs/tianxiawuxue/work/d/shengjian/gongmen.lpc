//ROM yuanzi

inherit ROOM;

void create() {
  set("short", "圣剑魔宫宫门");
  set("long",
    "这就是闻名天下的『圣剑魔宫』的宫门。宫门由一块巨大的汉白玉雕\n"
    "刻而成，不知凝聚着多少能工巧匠的智慧与心血。宫门前左右各蹲着一只\n"
    "威武庄严的碧玉狮子。更显出圣剑魔宫的气势与威严。\n"
  );
  set("outdoors", "guangchang");
  set("exits", ([
    "north": __DIR__ "shijie1",
    "south": "/d/shengjian/chukou1",
  ]));
  set("objects", ([
    __DIR__ "npc/shiwei": 2,
  ]));
  setup();
}

int valid_leave(object me, string dir) {

  if ((dir == "north")
    && ((int)me->query("shen") < 0)
    && objectp(present("shiwei", environment(me)))
    && living(present("shiwei", environment(me))))
    return notify_fail("锦衣侍卫把手一拦：这里不是平民百姓来的地方！\n");
  return ::valid_leave(me, dir);
}
