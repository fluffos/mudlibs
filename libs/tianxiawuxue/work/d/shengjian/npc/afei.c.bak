
inherit NPC;
#include <ansi.h>
object who = this_player();
void create()
{
	set_name("阿飞", ({ "a fei", "fei","afei" }) );
	set("gender", "男性" );
        set("title", HIG "情为何物" NOR);
set("class", "jianxia");	
	set("age", 20);
	set("int", 30);
	set("per", 30);
	set("long",
		HIB "圣剑魔宫祖师\n"
		HIM "天下无敌圣剑阿飞\n" NOR
		);
        set("force_factor", 200);
        set("max_gin", 3000);
        set("max_kee", 3000);
        set("max_sen", 3000);
        set("eff_gin", 3000);
        set("eff_kee", 3000);
        set("eff_sen", 3000);
        set("nickname",RED"魔剑"NOR);	
        set("gin", 3000);
        set("kee", 3000);
        set("sen", 3000);
        set("max_force", 30000);	
        set("force", 30000);
	set("cor",200);
        set("combat_exp", 5000000000);	
        set("score", 90000);
        set_skill("sword", 2400);	
        set_skill("force", 2400);	
        set_skill("parry", 1800);	
        set_skill("literate", 1800);	
        set_skill("dodge", 2000);
        set_skill("lonely-sword", 2100);	
        set_skill("tianmo-shenfa", 1500);        	
        set_skill("zhentian-quan", 1500);       
        set_skill("shengjian-xinfa", 1500);         	
        set_skill("unarmed", 1500);            	
        map_skill("dodge", "tianmo-shenfa");     	
        map_skill("unarmed", "zhentian-quan");         	
        map_skill("sword", "lonely-sword");	
        map_skill("parry", "lonely-sword");	
        map_skill("force", "shengjian-xinfa");
        set("max_neili",1000);  	
        set("neili",15000000);  	
        set("max_jingli",500000);  	
        set("max_jingli",200000);  	
        set("jingli",400000);  	
        set("max_jing",500000);  	
        set("max_qi",1000000);  	
        set("shen",300000000);
        set("jiali",50000);  	
        
        set("int",30);
        set("chat_chance_combat", 300);	
        set("chat_msg_combat", ({
(: perform_action, "sword.jiushi" :),	
(: perform_action, "sword.zongjue" :),	
(: perform_action, "sword.pozhao" :),  	
(: perform_action, "sword.pojian" :),	
(: perform_action, "sword.podao" :),	
(: perform_action, "sword.pobian" :),	
(: perform_action, "sword.poqi" :),	
(: perform_action, "sword.pozhang" :),	
        }) );
	
create_family("圣剑山庄", 1, "掌门");	
	setup();
	carry_object("clone/cloth/cloth")->wear();
        carry_object("/d/dali/npc/obj/toysword")->wield();
}
int accept_fight(object me)
{
        command("grin");
        command("say 我的剑是用来杀人的，不是用来比划着玩的．");
        return 0;
}
void init()
{
	add_action("do_killing", "kill");
	add_action("do_killing", "mo");
	add_action("do_killing", "18mo");
	add_action("do_killing", "qiangjian");
	add_action("do_killing", "fight");
	add_action("do_killing", "hit");
	add_action("do_killing", "touxi");
	add_action("do_killing", "look");
}

int do_killing(string arg)
{
	
	object player, victim, weapon;
	string name;
	player = this_player();
	if( !arg) return 0;
	if( objectp(victim = present(arg, environment(this_object()))) && living(victim))
	{
		name = (string)victim->name();
		if( (string)name == "林仙儿")
		{
		message_vision("$N冷笑一声道：我看你活得太长了。\n", this_object());
		this_object()->kill_ob(player);
		player->kill_ob(this_object());
		return 1;
		}
	}
	return 0;		
}
