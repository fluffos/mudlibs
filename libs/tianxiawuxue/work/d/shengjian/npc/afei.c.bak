void attempt_apprentice(object ob)	
{
               mapping fam = ob->query("family");
              if (!fam || fam["family_name"] != "圣剑山庄"){
                command("say "+RANK_D->query_respect(ob)+"与本门素无来往，不知此话从何谈起？");
                return;
                }       

                if ((int)ob->query_skill("tianmo-shengfa", 1) < 900) {
                command("say 你天魔身法太差了，学不会我的功夫。"); 
                command("say " + RANK_D->query_respect(ob) + 
                        "你还是把天魔身法练好了在来找我！");
                return;
        }
        if ((int)ob->query_skill("zhentian-quan", 1) < 1000) {
                command("say 你的震天拳太差。"); 
                command("say " + RANK_D->query_respect(ob) + 
                        "你还是把震天拳先提高了在来吧？");
                return;
        }
        if ((int)ob->query_skill("shengjian-xinfa", 1) < 600) {
                command("say 你的剑法底子太差。"); 
                command("say " + RANK_D->query_respect(ob) + 
                        "你还是把圣剑诀先提高了在来吧？");
                return;
        }
         
       if ( (int)ob->query_skill("literate",1) < 2000)
    {
        command("say 我看" + RANK_D->query_respect(ob) + "的读书识字还没学到家吧。");
        return;
    }
    
if((int)ob->query("shen",1) < 150000000)               	
{
command("say 我的剑法只传侠义人士，你在德行方面还做得不够吧。");	
return 0;	
}
command("say 好吧，我就破例收下你了，以后要多多行侠仗义。");	
command("chat 我的绝世剑法终有传人了，武林中又多了位行侠仗义的大侠。哈哈.....");	
command("recruit " + ob->query("id"));	
ob->set("title",HIR"圣剑传人"NOR);                  	
}
