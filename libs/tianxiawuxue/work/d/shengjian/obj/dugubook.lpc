//Cracked by Roath
// dugubook.c 独孤秘笈

inherit ITEM;
void create()
{
	set_name("独孤", ({ "dugu book", "book" }));
	set_weight(600);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "本");
		set("long", 
		"这是圣剑魔宫的镇宫之宝《独孤秘籍》。里面记载了圣剑魔宫的至高武学。\n");
		set("value", 7000);
		set("material", "paper");
		set("skill", ([
			"name":	"lonely-sword", // name of the skill
			"exp_required":	3000000,	  // minimum combat experience required
			"jing_cost":	30000,	  // jing cost every time study this
			"difficulty":	10,	  // the base int to learn this skill
			"max_skill":	1,
			"min_skill":    0,	  // the max and min level you can learn
		]) );
	}
}
