#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int ask_weiwang();
string ask_me();
void create() {
  set_name(HIY "徐子陵" NOR, ({ "xu ziling", "xu", "ziling" }));
  set("long", "他就是名闻天下的徐子陵,现在和少帅隐居的这里。\n"
    "偶尔向这边看过来，顿觉他文文静静,一副书生气息。\n");
  set("nickname", HIM "大唐双龙之侠者" NOR);
  set("gender", "男性");
  set("age", 27);
  set("attitude", "peaceful");
  set("str", 3000);
  set("dex", 99);
  set("con", 99);
  set("int", 99);
  set("per", 99);
  set("shen_type", 1);
  set_skill("literate", 400);
  set_skill("unarmed", 1200);
  set_skill("force", 1200);
  set_skill("dodge", 1200);
  set_skill("taoism", 1000);
  set_skill("parry", 1200);
  set_skill("sword", 1200);
  set_skill("stick", 1200);
  map_skill("force", "taiji-shengong");
  set("jiali", 5000);
  set("combat_exp", 150000000);
  set("max_qi", 50000);
  set("qi", 50000);
  set("max_jing", 50000);
  set("jing", 50000);
  set("neili", 100000);
  set("max_neili", 10000);
  create_family(HIW "双龙会" NOR, 1, HIR "帮主" NOR);
  set("chat_chance", 10);
  set("chat_msg", ({
    "徐子陵歌道：" HIW "「三十年来寻刀剑」" NOR "\n",
    "徐子陵歌道：" HIW "「几回落叶又抽枝」" NOR "\n",
    "徐子陵唱道：" HIW "「自从一见桃花後」" NOR "\n",
    "徐子陵唱道：" HIW "「直至如今更不疑」" NOR "\n",
  }));
  setup();
  carry_object("/d/quanzhou/obj/fuchen")->wield();
  carry_object("/d/wudang/obj/greenrobe")->wear();
}

void attempt_apprentice(object ob) {
  if ((int)ob->query("int") < 30) {
    command("giggle");
    command("say 这位" + RANK_D->query_respect(ob) + "也太不聪慧了吧...，哎！还是请回吧！");
    return;
  }
  if ((int)ob->query("con") < 28) {
    command("giggle");
    command("say 这位" + RANK_D->query_respect(ob) + "也太差了吧...，哎！还是请回吧！");
    return;
  }

  if ((int)ob->query("weiwang") < 400) {
    command("say 我双龙会武功天下无敌，凡入我门，\n必闯荡江湖，行侠仗义，为天下苍生谋福利。\n");
    command("say " + RANK_D->query_respect(ob) +
      "是否应该先出去闯一闯，做几件惊天动地的大事？");
    return;
  }
  if ((int)ob->query("shen") > 0 && (int)ob->query("shen") < 10000000) {
    command("say 学武之人，德义为先，功夫的高低倒还在其次，未练武，要先学做人。");
    command("say 在德行方面，" + RANK_D->query_respect(ob) +
      "是否还做得不够？");
    return;
  }
  if (ob->query("weiwang") < 500) {
    if ((int)ob->query("shen") < 0) command("say " + RANK_D->query_respect(ob) + "虽然是邪派中人，但也还做了些好事。\n");
    command("es 我双龙会所作所为，无一不是前人所未行之事。\n");
    command("es 想当日指点江山,是何等的威武啊?\n");
    command("es 今天就收了你吧！！\n");
    command("es 想不到我一身惊人艺业，今日终于有了传人，哈哈哈哈！！！！\n");
    message_vision(HIC "$N的江湖威望提高了！\n" NOR, this_player());
    ob->add("weiwang", 80);
  }
  command("recruit " + ob->query("id"));
  if ((!(string)ob->query("class")) || ((string)ob->query("class") != "fighter"))
    ob->set("class", "fighter");
  ob->set("title", HIW "双龙会弟子" NOR);
}
