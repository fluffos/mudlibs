inherit ITEM;
inherit F_AUTOLOAD;
#include <ansi.h>
#include <skill.h>

void create()
{
        seteuid(getuid());
        set_name(HIG"紫禁令"NOR, ({ "ling" }) );
        set("long", "
封官(fengguan)。或将其罢免(bamian)。\n");
        set("unit", "块");
          set("no_get",1);
          set("no_give",1);
          set("no_drop",1);
        setup();
}

void init()
{
        add_action("do_fengguan","fengguan");
        add_action("do_bamian","bamian");
        
}
int do_fengguan(string arg)
{
        object me, ob, obj,objj;
        string tit;
        mapping party;

        me = this_player () ;
        if (!(int)me->query("wangye"))
        return notify_fail("你无权使用。\n");
        
        if( !arg || sscanf(arg, "%s %s", arg, tit)!=2 )
        return notify_fail("指令格式：fengguan <玩家id> <官职>\n");       

        if( !objectp(ob = present(arg, environment(me))) 
        ||      !userp(ob) )
                return notify_fail("他不在旁边。\n");

        if( (int)ob->query("guan") || (int)ob->query("wangye") )
        {
                return notify_fail("他已经够级别了。\n");
        }

        if(tit=="刑部") tit=WHT" 刑部侍郎 "NOR;
     else if(tit=="吏部") tit=MAG" 吏部侍郎 "NOR; 
   else if(tit=="兵部") tit=HIW" 兵部侍郎 "NOR; 
   else if(tit=="户部") tit=HIC" 户部侍郎 "NOR; 
   else if(tit=="工部") tit=HIG" 工部侍郎 "NOR;
   else if(tit=="礼部") tit=HIR" 礼部侍郎 "NOR; 
   else if(tit=="尚吏部") tit=HIB" 吏部尚书 "NOR; 
   else if(tit=="尚兵部") tit=HIM" 兵部尚书 "NOR;
     else if(tit=="尚刑部") tit=HIW" 刑部尚书 "NOR; 
   else if(tit=="尚户部") tit=MAG" 户部尚书 "NOR;
   else if(tit=="尚工部") tit=HIG" 工部尚书 "NOR;
   else if(tit=="尚礼部") tit=WHT" 礼部尚书 "NOR;
   else if(tit=="征东") tit=HIG" 征东大将军 "NOR; 
   else if(tit=="征西") tit=HIR" 征西大将军 "NOR; 
   else if(tit=="征北") tit=HIM" 征北大将军 "NOR; 
   else if(tit=="征南") tit=HIW" 征南大将军 "NOR;
   else if(tit=="中书令") tit=HIW" 中 书 令 "NOR;
   else if(tit=="尚书令") tit=HIM" 尚 书 令 "NOR; 
   else if(tit=="骠骑") tit=HIW" 骠骑大将军 "NOR;
   else if(tit=="赤龙") tit=HIR" 赤龙大将军 "NOR;
   else if(tit=="翔凤") tit=HIM" 翔凤大将军 "NOR;
   else if(tit=="虎威") tit=HIY" 虎威大将军 "NOR;
   else if(tit=="破虏") tit=HIB" 破虏将军 "NOR;
   else if(tit=="荡寇") tit=HIG" 荡寇将军 "NOR;
   else if(tit=="伏波") tit=HIW" 伏波将军 "NOR;
   else if(tit=="奋威") tit=HIC" 奋威将军 "NOR;
   else if(tit=="安国") tit=BLU" 安国将军 "NOR;
   else if(tit=="一品") tit=HIR" 一品带刀侍卫 "NOR;
   else if(tit=="二品") tit=HIR" 二品带刀侍卫 "NOR;
   else if(tit=="三品") tit=HIR" 三品带刀侍卫 "NOR;
   else if(tit=="四品") tit=HIR" 四品带刀侍卫 "NOR;
     
   else return notify_fail("没有这个旗。\n");
        party = allocate_mapping(5);
        party["party_name"] = HIY "【紫禁城】" NOR;
        party["rank"] = tit+NOR;
        party["level"] = 2;
        party["tasks"] = 0;
        party["enter_time"] = time();
        ob->set("party", party);
        ob->set("guan",1);
        if (!present ("ling2",ob))
{
/*
        obj=new("/u/aplio/obj/ling2");
        obj->move(ob);
*/
}

  message("channel:rumor", MAG""+HIY"【皇榜】"NOR+""+HIG"奉天呈运 皇帝诏曰"NOR+" 晋封" + ob->query("name") + "为"HIY "【紫禁城】" NOR +tit+"钦此！！！\n\n"NOR, users());
        message_vision(HIC"$N从怀里掏出一块令牌，递给$n。\n"NOR,me,ob);
        return 1;
}
int do_bamian(string arg)
{
        object me, ob, obj, objj;
        string tit;
        mapping party;
        me = this_player () ;

        if (!(int)me->query("wangye"))
        return notify_fail("你不能使用这个东西!\n");

        if( !arg || sscanf(arg, "%s %s", arg, tit)!=2 )
        return notify_fail("指令格式：bamian <玩家id> <官职>\n");     

        if( !objectp(ob = present(arg, environment(me))) 
        ||      !userp(ob) )
                return notify_fail("你只能当着他的面将他罢免。\n");

        if (!(int)ob->query("guan"))
        {
                return notify_fail("他并不是自己人，要你来操什么心？\n");
        }

        if(tit=="刑部") tit=WHT" 刑部侍郎 "NOR;
   else if(tit=="兵部") tit=HIW" 兵部侍郎 "NOR; 
   else if(tit=="户部") tit=HIC" 户部侍郎 "NOR; 
   else if(tit=="工部") tit=HIG" 工部侍郎 "NOR;
   else if(tit=="礼部") tit=HIR" 礼部侍郎 "NOR; 
   else if(tit=="尚吏部") tit=HIB" 吏部尚书 "NOR; 
   else if(tit=="尚兵部") tit=HIM" 兵部尚书 "NOR;
     else if(tit=="尚刑部") tit=HIW" 刑部尚书 "NOR; 
   else if(tit=="尚户部") tit=MAG" 户部尚书 "NOR;
   else if(tit=="尚工部") tit=HIG" 工部尚书 "NOR;
   else if(tit=="尚礼部") tit=WHT" 礼部尚书 "NOR;
   else if(tit=="征东") tit=HIG" 征东大将军 "NOR; 
   else if(tit=="征西") tit=HIR" 征西大将军 "NOR; 
   else if(tit=="征北") tit=HIM" 征北大将军 "NOR; 
   else if(tit=="征南") tit=HIW" 征南大将军 "NOR;
   else if(tit=="中书令") tit=HIW" 中 书 令 "NOR;
   else if(tit=="尚书令") tit=HIM" 尚 书 令 "NOR; 
   else if(tit=="骠骑") tit=HIW" 骠骑大将军 "NOR;
   else if(tit=="赤龙") tit=HIR" 赤龙大将军 "NOR;
   else if(tit=="翔凤") tit=HIM" 翔凤大将军 "NOR;
   else if(tit=="虎威") tit=HIY" 虎威大将军 "NOR;
   else if(tit=="破虏") tit=HIB" 破虏将军 "NOR;
   else if(tit=="荡寇") tit=HIG" 荡寇将军 "NOR;
   else if(tit=="伏波") tit=HIW" 伏波将军 "NOR;
   else if(tit=="奋威") tit=HIC" 奋威将军 "NOR;
   else if(tit=="安国") tit=BLU" 安国将军 "NOR;
   else if(tit=="一品") tit=HIR" 一品带刀侍卫 "NOR;
   else if(tit=="二品") tit=HIR" 二品带刀侍卫 "NOR;
   else if(tit=="三品") tit=HIR" 三品带刀侍卫 "NOR;
   else if(tit=="四品") tit=HIR" 四品带刀侍卫 "NOR;
   
        party = allocate_mapping(5);
        party["party_name"] = HIY "【紫禁城】" NOR;
        party["rank"] = tit+NOR;
        party["level"] = 2;
        party["tasks"] = 0;
        party["enter_time"] = time();
            ob->set("party", 0);
          ob->set("guan",0);
        destruct(obj);

        message("channel:rumor", MAG""+HIY"【圣旨到】"NOR+""+HIG"奉天呈运 皇帝诏曰"NOR+" 由于" + ob->query("name") + "贪赃枉法，胡作非为，现贬为庶民，诛九族...钦此！！！\n\n"NOR, users());

        return 1;
}

int query_autoload()
{
       return 1;
}
void owner_is_killed()
{
       destruct(this_object());
}

