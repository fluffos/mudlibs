// 金刚不坏
// by aguo
// update 2006.1.14

inherit ITEM;

string *titles = ({
  "破烂的经书",
});

void create() {
  set_name(titles[random(sizeof(titles))], ({ "jingshu", "book" }));
  set("long", "
这是一本破烂的经书,上面似乎记载什么高深的武学,可惜大半已经蛀烂掉了!
");
  set_weight(200);

  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("value", 500);
    set("material", "paper");

  }
}
void init() {
  add_action("do_du", "du");
  add_action("do_du", "study");
}
int do_du(string arg) {
  object me = this_player();
  object where = environment(me);
  object ob;
  mapping skill;
  int dzlevel;
  int neili_lost;
  if (!(arg == "douzhuan xingyi" || arg == "book" || arg == "shu"))
    return 0;

  if (where->query("pigging")) {
    write("你还是专心拱猪吧！\n");
    return 1;
  }
  if (me->is_busy()) {
    write("你现在正忙着呢。\n");
    return 1;
  }

  if (me->is_fighting()) {
    write("你无法在战斗中专心下来研读新知！\n");
    return 1;
  }

  if (!id(arg)) {
    write("你要读什么？\n");
    return 1;
  }

  if (!me->query_skill("literate", 1)) {
    write("你是个文盲，先学点文化(literate)吧。\n");
    return 1;
  }

  if ((int)me->query("jing") < 15) {
    write("你现在过于疲倦，无法专心下来研读新知。\n");
    return 1;
  }
  if ((int)me->query_skill("buddhism", 1) < 200) {
    write("你阅读了经书好久,只觉里面的佛里精深奥妙,实在难以理解。\n");
    return 1;
  }
  if (me->query_skill("jingang-buhuai", 1) > (me->query_skill("force", 1) + 10)) {
    write("由于你的基本内功的火侯不够，不能再进行更高一层的提高。\n");
    return 1;
  }
  if ((int)me->query("neili") < neili_lost) {
    write("你内力不够，无法钻研这么高深的武功。\n");
    return 1;
  }

  dzlevel = me->query_skill("jingang-buhuai", 1);
  if ((int)me->query("combat_exp") < (int)dzlevel * dzlevel * dzlevel / 10) {
    write("你的实战经验不足，再怎么读也没用。\n");
    return 1;
  }
  if ((int)me->query_skill("jingang-buhuai", 1) > 121) {
    write("后面的已经蛀的破烂不堪,你实在是看不清楚里面写的是什么！\n");
    return 1;
  }
  neili_lost = 5;
  me->receive_damage("jing", random(200) + 50);
  me->set("neili", (int)me->query("neili") - neili_lost);
  me->improve_skill("jingang-buhuai", (int)me->query_skill("buddhism", 1) / 30 + random(10));
  if (random(5) > 3) me->start_busy(2);
  write("你小心翼翼的打开经书开始阅读，似乎对佛法和武学有了更多的理解。\n");
  return 1;

}
