// fei.c
inherit NPC;
inherit F_MASTER;
#include <ansi.h>;
void create() {
  set_name("费彬", ({ "fei bing", "bing", "fei" }));
  set("nickname", "大嵩阳手");
  set("gender", "男性");
  set("class", "swordsman");
  set("age", 45);
  set("attitude", "peaceful");
  set("str", 26);
  set("con", 30);
  set("dex", 30);
  set("int", 28);

  set("neili", 2000);
  set("max_neili", 2000);
  set("jiali", 30);
  set("max_qi", 2000);
  set("max_jing", 1200);
  set("combat_exp", 111600000);
  set("shen_type", 0);

  set_skill("literate", 1500);
  set_skill("unarmed", 1000);
  set_skill("sword", 1000);
  set_skill("force", 1000);
  set_skill("parry", 1000);
  set_skill("dodge", 1000);
  set_skill("hand", 1500);
  set_skill("songshan-jian", 1000);
  set_skill("lingxu-bu", 1000);
  set_skill("hanbing-zhenqi", 1000);
  set_skill("dasongyang-shou", 1500);

  map_skill("sword", "songshan-jian");
  map_skill("parry", "songshan-sword");
  map_skill("dodge", "lingxu-bu");
  map_skill("unarmed", "hanbing-shenzhang");
  map_skill("hand", "dasongyang-shou");
  map_skill("force", "hanbing-zhenqi");

  create_family("嵩山派", 13, "弟子");
  setup();

  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/clone/cloth/cloth")->wear();
  carry_object("/d/songshan/obj/songyang-huwan")->wear();
}

void attempt_apprentice(object ob) {
  mapping fam = ob->query("family");

  if (ob->query("gender") != "男性") {
    command("say 我可只收男徒.");
    return;
  }
  if (!fam || fam["family_name"] != "嵩山派") {
    command("say " + RANK_D->query_respect(ob) + "与本门素无来往，不知此话从何谈起？");
    return;
  }
  if ((int)ob->query_skill("force", 1) < 800) {
    command("say 内功是嵩山派武功之基础。");
    command("say " + RANK_D->query_respect(ob) + "是否还应该先在内功上多下点功夫？");
    return;
  }
  if ((int)ob->query_skill("hanbing-zhenqi", 1) < 800) {
    command("say 寒冰真气是我派行走江湖的根本所在。");
    command("say 要想铲奸除恶,真才实学却是半点也马虎不得。");
    command("say " + RANK_D->query_respect(ob) + "的基础武功没有学会，还是请回吧。");
    return;
  }

  command("say 嗯，看你还是个学武的料，我就收下你吧！");
  command("recruit " + ob->query("id"));
  ob->set("class", "sworder");
}
