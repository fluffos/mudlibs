inherit NPC;
#include <ansi.h>
#include <room.h>    
#include "job_npc.h"

void create()
{
        string id, id1, id2, idf2, id3, idf3;// ID、姓ID、名ID
        string flname, name1, name2, namef2, name3, namef3;// 全名、姓、名
        string sex; //性别
        mapping mp;
        string title;
        int index1, index2;             
        
        //-------- 获取姓名和ID-----------
        // 取得姓
        index1= random(sizeof(first_name));
        name1 = first_name[index1]["name"];
        id1   = first_name[index1]["id"];               
        
        // 取得名 第一个字
        // 男性
        index1= random(sizeof(second_name1));
        name2 = second_name1[index1]["name"];
        id2   = second_name1[index1]["id"];
        // 女性
        index2= random(sizeof(second_name2));
        namef2= second_name2[index2]["name"];
        idf2  = second_name2[index2]["id"];             
        // 取得名 第二个字
        // 男性
        index1= random(sizeof(third_name1));
        name3 = third_name1[index1]["name"];
        id3   = third_name1[index1]["id"];      
        // 女性
        index2= random(sizeof(third_name2));
        namef3= third_name2[index2]["name"];
        idf3  = third_name2[index2]["id"];                      

        // 取得门派
        index1=random(sizeof(menpai));
        set("menpaiIndex", index1);
        // 任务等级
        set("job_lev", menpai[index1]["lev"]);
        mp=menpai[index1];
        sex= mp["gender"];
        title= mp["title1"];
        
        set_skill("literate", 5000);
        set_skill("taoism", 5000);
        set_skill("buddhism", 5000);
        
        // 设置基础数据
        if (sex=="男性")
        {
            id=id1+" "+id2+id3;
            flname= name1+name2+name3;
            set_name(flname,({id, id1}));
            set("gender", "男性");
        }
        else
        {
            id=id1+" "+idf2+idf3;
            flname=name1+namef2+namef3;
            set_name(flname, ({id, id1}));
            set("gender", "女性");
        }
        set("title", title);
        set("age", 30+random(10));
        set("fight_till_die",1);
				set("chat_chance", 5);
				set("chat_msg", ({
 					(: random_move :),
        		}) );

				set("is_quest",1);
				set("no_suck",1);
				set("jobid", "admin knightly");

				setup();
				
				carry_object(mp["weapon"])->wield();				
				carry_object("/d/shaolin/obj/jingang-zhao.lpc")->wear();
}

void init()
{
    add_action("do_panwen", "panwen");
    add_action("do_kill",   "kill");
    add_action("do_forbid", "hit");
    add_action("do_forbid", "fight");
    add_action("do_forbid", "steal");
    add_action("do_forbid", "persuade");
    add_action("do_forbid", "touxi");
    add_action("do_forbid", "ansuan");
    add_action("do_forbid", "beg");
    add_action("do_forbid", "team kill");                   
}

int do_forbid(string arg)
{
    string what,who;
    object ob= this_player();
    object me= this_object();
    
    if(!arg) return 0;

    if(this_object()->id(arg))
    {
				if((!me->query("jobid"))||(me->query("jobid")!=ob->query("id")))
				{
          write("江湖人士，还是少惹为妙，安全第一哦。\n");
          return 1;                                               
        }       
        else
        {
          command("say 咱们手底下见真章吧！\n");
          return 1;
        }
    }
    else
    if(sscanf(arg,"%s from %s",what,who)==2 && this_object()->id(who))
    {
        if((!me->query("jobid"))||(me->query("jobid")!=ob->query("id")))
        {
            write("还是到别处去施展你的本事吧。\n");
            return 1;                       
        }
        else
        {
            write("别对我搞这些，没用的。\n");
            return 1;
        }
    }
    return 0;           
}

int do_kill(string arg)
{
    object ob= this_player();
    object me= this_object();     
    string what,who;
    
    if((!me->query("jobid"))||(me->query("jobid")!=ob->query("id")))
    {
				write("江湖人士，还是少惹为妙。\n");            
				return 1;    
    }
                
    if(!arg) return 0;

    if((!me->query("cankill"))||(me->query("cankill")!=1))                
    {
     		write(HIW"盘问清楚了吗？可别杀错了人！\n"NOR);
    		return 1;                     
    }
          
    if((me->query("jobid")==ob->query("id"))&&(me->query("cankill")))
    {
        command("heng");
        me->kill_ob(ob);
        ob->kill_ob(me);
        
        return 1;
    }
                
		return 0;
}

int do_panwen(string arg)
{
		int answer;
		object ob= this_player();
		object me= this_object();
          
		if((!me->query("jobid"))||(me->query("jobid")!=ob->query("id")))
		{
			answer = random(10);
			if (answer>=8)
			{
				command("shake");
				return 1;
			}
			else
			if (answer>=5)
			{
				command("?");
				return 1;
			}
			else
			if (answer>=3)
			{
				command("smile");
				return 1;
			}
			else
				return 0;
    }      
    if (!arg)
    {
        //write("你要盘问谁？\n");
        //return 1;
				return 0;// 也返回“什么？”增加迷惑性。
    }
    if(this_object()->id(arg))
    {
        copyplayerdata(this_object(), this_player());
        me->set("cankill", 1);
        if (random(2)==1)
        {
        	command("say 嘿嘿，想不到我潜伏多日，竟然被你发现了！\n"+HIB"既然如此，怪不得我心狠手辣了！\n"NOR);
     	 	}
     	 	else
     	 	{
     	 		command("say 人算不如天算，我隐蔽这么好也被发现，难道是天意？\n"+HIR"好，咱们手下见真章吧！\n"NOR);
     	 	}
        this_object()->kill_ob(this_player());
        return 1;
    }
    return 0;
}

void start_escape(object ob,object me)
{
		call_out("escape_me",900,ob,me);
}

void escape_me(object ob,object me)
{
    if (objectp(me) ) 
    {          
    		if (ob->query("jobid")=="admin knightly")
    		{
					message_vision("$N轻笑了几声：“呵呵，"+RANK_D->query_self_rude(ob)+
                                                "今天这趟掩护任务算是完成了。”\n说罢，一个纵身，不知去向。\n",ob);    			
    		}
    		else
    		{        
					message_vision("$N狞笑了几声：“今天运气好，"+RANK_D->query_self_rude(ob)+
                                                "这么容易就完成刺探任务了。”说罢，一个纵身，不知去向。\n",ob);
					// 如果npc消失前，玩家已经申请任务失败了，那么就不做下面的处理了
					if ((!me->query_temp("family_job/songshan/killerid"))||(me->query_temp("family_job/songshan/killerid")!=ob->query("id")))
					{
						destruct(ob);
						return;
					}	
          // 通知玩家并做标记
          tell_object(me, HIG"听说奸细已经完成任务溜走了，唉。\n"NOR);
          me->set("/family_job/songshan/npcflee", 1);
          // 降低综合评价
          me->add("score",-(1+random(3)));
          tell_object(me, HIG"你的江湖评价也降低了，可惜。\n"NOR);                                                
				}
    }
    
    destruct(ob);
    
    return;
}

void die()
{
    int reward_exp,reward_pot,level=0;
    int count;
    string fam;
    object killer,me;
    int lev, reward;
    
    me=this_object();
    
    if (
    		(!me->query("jobid"))
    		||(me->query("jobid")=="admin knightly")
    		)
    {
    		message_vision(HIC"$N惨嚎一声，口喷鲜血，到在地上死了。\n"NOR,me);
        destruct(me);		
				return;
    }
    
    lev  = (int)me->query("job_lev");
    killer=me->query_temp("last_damage_from");
    
		// 修改玩家任务标记
    killer->set("family_job/songshan/done", 1);
    killer->add("family_job/songshan/donecount",1);
    killer->add_temp("family_job/songshan/loopcount", 1);
    
    // 计算奖励
    reward=(int)killer->query("combat_exp")/300;
    reward=reward+random(reward/2);
    reward=reward/60;
    
    reward=reward*lev;
    
    // 增加并记录奖励
    killer->add("family_job/songshan/reward_exp",reward);
    killer->add("family_job/songshan/reward_potential",reward/2);
    killer->add("combat_exp", reward);
    killer->add("potential", reward/2);
    
    command("say "+killer->query("name")+"，算你狠！");

    message_vision(HIC"$N惨嚎一声，口喷鲜血，到在地上死了。\n"NOR,me);

    message_vision(HIW"$N得到了\n"+CHINESE_D->chinese_number(reward)+"点经验\n"NOR+HIY"\n"+CHINESE_D->chinese_number(reward/2)+"点潜能。\n"NOR, killer);

    remove_call_out("escape_me");
    
    destruct(me);
		
		return;
}
