// guanri-sword.c
// 嵩山 左冷禅 观日剑
// knightly 2006.05.15
#include <weapon.h>
inherit SWORD;
void create()
{
        set_name(HIY"观日剑"NOR, ({"guanri sword", "guanri jian", "sword", "jian",
"guanri"}));
        set_weight(10000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long","一把隐隐泛着金光的宝剑，磅礴之气震慑心魄。\n");
                set("unit", "柄");
		set("wield_msg",
"金光一闪,一把长柄阔身的$n从剑鞘中弹出，似有灵性地落入$N的手中。\n");
		set("unwield_msg",
"$N将手中的$n插入腰间，脸上露出一丝笑意，四周的压力顿时减弱不少。\n");
              set("value",1000000);
		set("weapon_prop/courage", 10);
        }
        init_sword(1000);
        setup();
}
