// songyang huwan.c 嵩阳腕

#include <ansi.h>
#include <armor.h>
inherit WRISTS;
void create() {
  set_name(HIR "嵩阳腕" NOR, ({ "songyang wan", "wrists" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "双");
    set("long", "嵩山派历代相传的至宝，是空手高手梦寐以求的东西。\n");
    set("value", 1300);
    set("material", "cloth");
    set("armor_prop/strength", 20);
    set("armor_prop/armor", 100);
  }
  setup();
}
