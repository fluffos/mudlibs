// mengzhuling.c

#include <ansi.h>
#include <armor.h>

inherit FINGER;

void create()
{
        set_name(HIY"盟主令"NOR, ({ "mengzhu ling"}) );
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
  							set("long", "虽然只是一枚小小的戒指，却是五岳剑盟盟主的象征。\n");
  							set("unit", "枚");
  							set("value", 0);
  							set("material", "gold");
								set("armor_prop/armor", 500);
  							set("armor_prop/personality", 10);
								set("wear_msg", "只见$N戴上一个"+"$n"NOR+"。\n");
                set("unequip_msg", "$N将手指上的"+"$n"NOR+"轻轻的取了下来。\n");
        }
        
        setup();    
    set("no_get",1);
    set("no_drop",1);	
}

void owner_is_killed() 
{ 
	destruct(this_object());
}
