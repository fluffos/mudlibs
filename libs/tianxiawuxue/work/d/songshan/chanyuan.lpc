inherit ROOM;

void create()
{
	set("short", "峻极禅院");
	set("long", @LONG
峻极禅院处嵩山绝顶，院中古柏森森，殿上并无佛像。院宇
辽阔，可容千人。
LONG );
	set("exits", ([
		"southdown" : __DIR__"junjigate",
	]));
	set("objects", ([
		__DIR__"npc/zuolengchan" :1,
		__DIR__"npc/shi" :1,
		__DIR__"npc/di" :1,
	]));

	setup();
	replace_program(ROOM);
       "/d/board/songshan_b"->foo();
}

void reset()
{
			// 通过load_object()判断的话，应该是宕机一次出现一次。
			//object sword, ling;
			
      ::reset();      	
								
			//sword=find_object("/d/songshan/obj/guanri-jian");
			//sword=find_object("di xiu");
			//ling =find_object("mengzhu ling");
			
			//if (!sword)
			if (load_object("/d/songshan/obj/guanri-jian")==0)
			{
				set("canload_guanrijian", 1);
			}
			else
			{
				set("canload_guanrijian", 0);					
			}

			//if (!ling)
			if (load_object("/d/songshan/obj/mengzhuling")==0)			
			{
				set("canload_zuoling", 1);
			}
			else
			{
				set("canload_zuoling", 0);
			}
}