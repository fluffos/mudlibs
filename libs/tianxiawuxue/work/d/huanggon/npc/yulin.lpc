#include <ansi.h>

inherit NPC;


void create()
{
	set_name("校尉", ({"jiao wei", "wei", "jiao"}));
	set("title", HIR "御林军" NOR);
	set("long",
	"禁军校尉,不同于普通官兵,据说他们中的随便一个都有江湖上一流的身手.\n"
	"大内不同其他地方,有时候,这些禁军杀你都不要理由.\n"
	);

	set("gender", "男性");
	set("attitude", "friendly");
	set("class", "offical");

	set("age", 20);
	set("shen_type", 1);
	set("str", 20);
	set("int", 20);
	set("con", 20);
	set("dex", 20);
	set("max_qi", 5000);
	set("max_jing", 3000);
	set("neili", 5000);
	set("max_neili", 5000);
	set("pursuer", 1);
	set("combat_exp", 20000000);
	set("jiali", 130);
	set("score", 1);

	set_skill("force", 630);
	set_skill("hunyuan-yiqi", 630);
	set_skill("dodge", 630);
	set_skill("shaolin-shenfa", 630);
	set_skill("unarmed", 630);
	set_skill("banruo-zhang", 630);
	set_skill("parry", 630);
	set_skill("blade", 630);
	set_skill("cibei-dao", 630);

	map_skill("force", "hunyuan-yiqi");
	map_skill("dodge", "shaolin-shenfa");
	map_skill("unarmed", "banruo-zhang");
	map_skill("parry", "cibei-dao");
	map_skill("blade", "cibei-dao");

	setup();

	carry_object("/d/city/obj/gangdao")->wield();
	carry_object("/d/city/obj/junfu")->wear();
}



