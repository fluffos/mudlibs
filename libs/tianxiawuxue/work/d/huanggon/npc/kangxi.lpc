//kangxi.c 康熙大帝

#include <ansi.h>
inherit NPC;
inherit F_UNIQUE;

void create()
{
	set_name(HIR "康熙大帝" NOR, ({"kang xi", "kang"}));
	set("title", "清成祖");
	set("gender", "男性");
	set("age", 36);
	set("str", 25);
	set("dex", 20);
	set("int", 28);
	set("con", 28);
	set("long", HIR @LONG
这位高大魁梧,英俊潇洒的男子就是天下独尊的康熙大帝.
LONG NOR
	);

	set("combat_exp", 50000000);
	set("score", 20000);
	set("shen_type", 1);
	set("attitude", "peaceful");


	set_skill("unarmed", 1800);
	set_skill("dodge", 1800);
	set_skill("literate", 1800);
	set_skill("force", 1800);
	set_skill("hunyuan-yiqi", 1800);
	set_skill("shaolin-shenfa", 1800);
	set_skill("finger", 1800);
	set_skill("nianhua-zhi", 1800);
	map_skill("force", "hunyuan-yiqi");
	map_skill("dodge", "shaolin-shenfa");
	map_skill("parry", "nianhua-zhi");
	map_skill("finger", "nianhua-zhi");
	prepare_skill("finger", "nianhua-zhi");

	set_temp("apply/attack", 90);
	set_temp("apply/defence", 90);
	set_temp("apply/armor", 90);
	set_temp("apply/damage", 95);
	
	set("qi", 100000);
	set("max_qi", 100000);
	set("jing", 60000);
	set("max_jing", 60000);
	set("neili", 200000);
	set("max_neili", 200000);
	set("jiali", 280);
	
	set("inquiry", ([
		"韦小宝" : "\n小宝是我的心腹,我让他为我收集各大官员的消息.\n",
	 "鳌拜" : "\n鳌拜虽是开朝元老,但太骄横跋负了,终是我的心腹大患.\n",
	]));
	setup();
	carry_object("/d/huanggon/obj/jinduan")->wear();
	add_money("gold", 5);
}
