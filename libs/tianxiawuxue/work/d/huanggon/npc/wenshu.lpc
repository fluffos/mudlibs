// wenshu
// lei : 1998 10 25

inherit NPC;

void create() {
  set_name("文书", ({ "wen shu", "wen" }));
  set("long", "各部里一些文章杂事，都是这些老文书们做的。\n" +
    "他们都是些有经验的人，成天在念叨着些什么。\n");
  set("gender", "男性");
  set("age", 65);

  set_skill("literate", 500);
  set_skill("taoism", 600);

  set_skill("unarmed", 180);
  set_skill("dodge", 180);
  set_skill("parry", 180);
  set_temp("apply/attack", 80);
  set_temp("apply/defense", 80);
  set_temp("apply/damage", 20);

  set("combat_exp", 100000);
  set("shen_type", 1);
  setup();

  set("chat_chance", 10);
  set("chat_msg", ({
    "为官之道可大有学问。\n",
    "做官的人不仅要为百姓谋福利，也要记得为自己谋私利。\n",
    "当官要做的事可多了。\n",
    "做官最重要的就是要让上司知道你干了些什么。\n",
  }));
  carry_object("/clone/misc/cloth")->wear();
}

int recognize_apprentice(object ob) {
  if (!(int)ob->query_temp("mark/朱"))
    return 0;
  ob->add_temp("mark/朱", -1);
  return 1;
}
