//
// 假太后
// lei : 1998 10 25 


#include <ansi.h>

inherit NPC;

string ask_me(object who);

void create() {
  set_name("萧太后", ({ "tai hou", "hou" }));
  set("gender", "女性");
  set("shen_type", -1);
  set("age", 40);
  set("str", 25);
  set("cor", 25);
  set("cps", 25);
  set("int", 25);
  set("long",
    "太后真有一种雍荣华贵的气质,却似乎些妖邪的气息.\n");

  set("combat_exp", 20000);
  set("attitude", "heroism");
  set("chat_chance_combat", 15);
  set("chat_msg_combat", ({
    "太后说道:皇上身边的人好像越来越不成话了.\n",
    "太后说道:那个小桂子真的讨人厌,要是没有他会不会好点呢?\n",
    "太后说道:鳌拜这个老家伙真不好对付.\n",
  }));

  set("inquiry", ([
    "四十二章经": "太后双目一瞪:放肆,这是你问得的吗",

    "萧太后": (: ask_me :),
  ]));

  set_skill("dodge", 40);
  set_skill("unarmed", 30);
  set_skill("parry", 50);

  setup();

  carry_object("/d/huanggon/obj/jinduan")->wear();
}

string ask_me(object who) {
  int i;
  object *ob;

  if (query("revealed")) {
    if (is_killing(who->query("id"))) return "你既然知道了我的身分，今日休想活命！\n";
    else {
      kill_ob(who);
      who->fight_ob(this_object());
      return "你好像问得太多了, 留你在世上也是浪费, 去死吧!\n";
    }
  }

  if ((random(10) < 5) || is_fighting())
    return "放肆!\n";

  set_temp("apply/attack", 50);
  set_temp("apply/defense", 50);
  set_temp("apply/damage", 20);

  set("title", HIR "千手观音" NOR);

  message("vision",
    HIY " 千手观音颤声笑道:看来...你全都知道了.\n"
    "千手观音突然出手,招招精妙,却异常狠毒.\n"
    "千手观音冷笑道:留你不得,到地府去后悔吧.\n" NOR
    ,
    environment(), this_object());

  set("pursuer", 1);
  set("attitude", "aggressive");
  set("vendetta/authority", 1);
  set("bellicosity", 10000);
  set("combat_exp", 8000000);
  set("max_neili", 5300);
  set("neili", 3000);
  set("jiali", 130);
  set_skill("force", 700);
  set_skill("dodge", 700);
  set_skill("unarmed", 800);
  set_skill("parry", 800);
  carry_object("/d/city2/obj/book14_4");
  ob = all_inventory(environment());
  for (i = sizeof(ob) - 1; i >= 0; i--) {
    if (!userp(ob[i])) continue;
    kill_ob(ob[i]);
    ob[i]->fight(this_object());
  }
  add_money("silver", 5);
  set("revealed", 1);
  return "真的太后已被我杀了!你去阴曹找她吧!\n";
}
