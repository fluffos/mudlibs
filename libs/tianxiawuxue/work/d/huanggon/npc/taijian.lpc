inherit NPC;

void create() {
  set_name("太监", ({ "tai jian", "tai", "jian" }));
  set("gender", "无性");
  set("age", 15 + random(60));

  set("combat_exp", 5000000);
  set("shen_type", 0);

  set_skill("unarmed", 630);
  set_skill("blade", 640);
  set_skill("parry", 630);
  set_skill("dodge", 630);

  set_temp("apply/attack", 55);
  set_temp("apply/defense", 55);
  set_temp("apply/damage", 50);

  setup();
  add_money("silver", random(10));
  carry_object("/d/huanggon/obj/cloth2")->wear();
}
