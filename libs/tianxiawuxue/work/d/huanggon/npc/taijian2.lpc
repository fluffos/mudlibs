// 王太监
// lei 1998 10 26

inherit NPC;

inherit F_UNIQUE;
string ask_me();

void create() {
  set_name("太监", ({ "tai jian", "tai" }));
  set("gender", "无性");
  set("age", 53);
  set("long",
    "这个老太监看来在宫中伺奉多年了,从前应该红过吧,\n"
    "可现在就不同了.他应该知道许多......\n"
    "好像...他是姓王.大概是吧.\n");
  set("combat_exp", 5001000);

  set("str", 24);
  set("dex", 17);
  set("con", 28);
  set("int", 27);
  set("shen_type", 1);

  set("attitude", "friendly");
  set_skill("dodge", 770);

  set_skill("unarmed", 650);
  set_skill("parry", 660);
  set_skill("force", 640);
  set_temp("apply/attack", 40);
  set_temp("apply/defense", 40);
  set("inquiry", ([
    "王太监": (: ask_me :),
    "太监": "你问这干嘛?\n",
  ]));
  setup();
  add_money("coin", 50);
  carry_object("/clone/misc/cloth")->wear();
}
string ask_me() {
  object who;
  who = this_player();
  say("王太监突然热泪盈眶:你认得我?...太好了, ...还有人记得我.\n"
    "你是来要书的吗?\n");
  who->set_temp("zhiying", 1);
}

int accept_object(object who, object ob) {
  object book;
  book = new("/d/city2/obj/book14_3");
  if ((string)ob->query("name") == "四十二章经三") {
    if (!query("bookisgot") && who->query_temp("zhiying")) {
      say(
        "王太监叹了口气说:这是假的,也真难为你了.唉,这本才是真的.拿去吧.\n"
        "王太监把" + book->query("name") + "交给了" + who->query("name") + ".\n");
      book->move(who);
      set("bookisgot", 1);
    } else say("王太监一楞:给我的?你这人真怪.就收下了.\n");
    return 1;
  }
  return 0;
}
