#include <ansi.h>
inherit NPC;
inherit F_UNIQUE;


void create()
{
	set_name("索额图", ({"suo e tu", "suo", "tu" }));
	set("long",
	"这是大清三朝元老,德高望重.又是康熙的老师,更是位极人臣.\n"
	);

	set("title", HIR "太子太傅" NOR);
	set("gender", "男性");
	set("attitude", "peaceful");
	set("age", 50);
	set("shen_type", 1);
	set("str", 25);
	set("int", 25);
	set("con", 25);
	set("dex", 25);
	set("max_qi", 15000);
	set("max_jing", 15000);
	set("neili", 15000);
	set("max_neili", 15000);
	set("jiali", 150);
	set("combat_exp", 15000000);
	set("score", 50000);

	set_skill("force", 690);
	set_skill("hunyuan-yiqi", 690);
	set_skill("dodge", 690);
	set_skill("shaolin-shenfa", 695);
	set_skill("hand", 600);
	set_skill("parry", 600);
	set_skill("literate", 655);
	set_skill("fengyun-shou", 690);

	map_skill("force", "hunyuan-yiqi");
	map_skill("dodge", "shaolin-shenfa");
	map_skill("hand", "fengyun-shou");
	map_skill("parry", "fengyun-shou");

	prepare_skill("hand", "fengyun-shou");

        set("chat_chance_combat", 10);  
        set("chat_msg_combat", ({
		"索额图捻须微笑:年青人要多读书啊.\n",
		(: command("nod") :),
                      }) );
        setup();
        carry_object("/d/city2/obj/jinduan")->wear();
        carry_object("/d/city2/obj/yaodai")->wear();
        add_money("gold",10);
}

#include "/kungfu/class/shaolin/cheng.h"


