// Room: /d/huanggon/d/hougong.c


#include <ansi.h>
#include <room.h>
#include <room.h>

inherit ROOM;


void create() {
  set("short", "宁祥宫");
  set("long", @LONG
这里是太后的寝宫.与其他内宫不同的是这里摆设了许多帛书古籍,似乎
并不合这里的环境.房间正中有一张大床,用一幅绢红的丝帐轻罩着, 床上铺
着一床绣凤的绸垫(dian).这里尤其引人注目的是顶上那精雕的彩梁(liang)
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "south": __DIR__ "houhuayuan",
  ]));
  set("item_desc", ([
    "dian": "这是一袭绣凤的绸垫,这等上品也只有皇家才消受得起.\n",
    "liang": "这些彩梁显然只起装饰的作用,其中有一条挂着一个小风铃(ling),\n"
    "似乎跳起来可以抓到.\n",
  ]));
  set("no_clean_up", 0);

  setup();
}


void init() {
  object me;
  me = this_player();
  add_action("do_jump", "jump");
  add_action("do_jump", "tiao");
}


int do_jump(string arg) {
  int i;
  object me, room;
  me = this_player();
  i = (int)me->query_skill("shenxing-baibian", 1);
  if (!arg || arg != "ling")
    return notify_fail("我跳,我跳,我跳跳......\n");

  if (i < 20)
    return notify_fail("虽然你的轻功不错,但你总是抓不着它,真见鬼了.\n");
  message_vision(
    "\n$N定定心神,随风而起,飘飘然正抓着了小风铃.响起了脆脆铃声,煞是好听.\n"
    "$N轻轻落地,得意地笑了笑.突然,发现身后不知何时多了道暗门.\n", this_player());
  if (!(room = find_object(__DIR__ "mishi2")))
    room = load_object(__DIR__ "mishi2");
  if (objectp(room))
    set("exits/enter", __DIR__ "mishi2");
  return 1;
}

int valid_leave(object me, string dir) {
  int i;
  if (dir == "enter") {
    i = (int)me->query_skill("shenxing-baibian", 1);
    if (i < 20) {
      me->receive_damage("qi", 50);
      me->receive_wound("qi", 50);
      delete("exits/enter");
      return notify_fail(
        "\n你一步踏进暗门,突觉一股力道奇大的劲风激扑出来,将你撞飞出来.\n"
        "你再定睛一看,连暗门也消失了.\n");
    }
  }
  delete("exits/enter");
  return ::valid_leave(me, dir);
}
