#include <room.h>
inherit ROOM;

void close_gate();
int do_open(string arg);
int do_close(string arg);

void create() {
  set("short", "暗室");
  set("long", @LONG
这里十分昏暗,凭借着墙上的几支火烛,你看到墙角下有条地道.突然
你发觉来时的暗门消失了,而身后居然无声无息地站着一条瘦瘦的人影.
LONG
  );

  set("exits", ([
    "down": __DIR__ "mishi3",
  ]));
  set("objects", ([
    "/d/huanggon/npc/shou": 1,
  ]));

  setup();
}

void init() {
  add_action("do_open", "open");
  add_action("do_open", "unlock");
}

void close_gate() {
  object room;
  if (!(room = find_object(__DIR__ "hougong")))
    room = load_object(__DIR__ "hougong");
  if (objectp(room)) {
    delete("exits/out");
  }
}

int do_open(string arg) {
  object room;

  if (query("exits/out"))
    return notify_fail("暗门已经是开着了。\n");

  if (!arg || (arg != "door"))
    return notify_fail("你要开什么？\n");
  if (!(room = find_object(__DIR__ "hougong")))
    room = load_object(__DIR__ "hougong");


  if (objectp(room)) {
    set("exits/out", __DIR__ "hougong");
    message_vision("$N使劲把暗门打了开来。\n", this_player());
    remove_call_out("close_gate");
    call_out("close_gate", 10);
  }
  return 1;
}
