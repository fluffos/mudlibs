//wenhua.c

inherit ROOM;

void create() {
  set("short", "文华殿");
  set("long", @LONG
这里是文华殿, 在这陈列着许许多多千奇百怪的奇珍异宝.
LONG
  );
  set("exits", ([
    "southwest": __DIR__ "taihedian",
    "west": __DIR__ "yihedian",
    "northwest": __DIR__ "baohedian",
    "east": __DIR__ "donghuamen",
  ]));
  setup();
}
