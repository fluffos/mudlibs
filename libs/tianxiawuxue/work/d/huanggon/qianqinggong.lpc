// qianqinggong.c

#include <ansi.h>
#include <room.h>
inherit ROOM;

void create()
{
	set("short", "乾清宫");
	set("long", @LONG
这是皇上的寝宫.皇上也常在这里选派官吏,批阅文章,召见臣下.
宫上横匾"正大光明"是顺治帝的亲笔手书,以表明自己所作所为是正直
大度和光明磊落的.殿内悬着一幅康熙帝的对联(lian).
LONG
	);
	set("item_desc", ([
	"lian" : "
表正万邦慎厥身修思永
弘敷五典无轻民事惟难
\n",
	]));
	set("exits", ([	
	"south" : __DIR__"qianqingmen",
	"west" : __DIR__"qihedian",
	"north" : __DIR__"jiataidian",
	"east" : __DIR__"jiuqing",
	]));
	setup();
}
	
