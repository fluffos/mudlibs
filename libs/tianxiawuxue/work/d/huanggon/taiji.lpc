//taiji.c

inherit ROOM;

void create() {
  set("short", "台基");
  set("long", @LONG
这个巨大的台基建在皇城的中轴线上,有三层台阶,中间是铺了地
毯的御道.东西两侧各是一个日晷(gui)和一个嘉量(liang).四周围都
是汉白玉雕刻栏板,景象无比壮观.
LONG
  );
  set("exits", ([
    "south": __DIR__ "guangchang",
    "north": __DIR__ "taihedian",
  ]));
  set("item_desc", ([
    "liang": "这原是容积的标准量器,是皇帝公正无私和至高无上的象征.\n",
  ]));
  setup();
}
