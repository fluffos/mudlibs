inherit ROOM;

void create() {
  set("short", "御厨房");
  set("long", @LONG
    远远就能闻到一阵阵香味从这儿飘出.这里是御厨房.闲杂人等不能
在此出入.一张张长桌上摆着天下美味,无不令人垂涎三尺.可这是皇上
吃的,你想也甭想.
LONG
  );

  set("exits", ([
    "east": __DIR__ "qihedian",
    "west": __DIR__ "houyuan",
  ]));
  set("objects", ([
    "/d/huanggon/npc/taijian": 1,
    "/d/huanggon/obj/yuchi": 2,
  ]));

  setup();
}
