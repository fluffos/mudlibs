
#include <ansi.h>
#include <room.h>

inherit ROOM;

void create()
{
	set("short", "乾清门");
	set("long", @LONG
这是皇宫后廷的正门.门中有一个宝座,有些时候,皇上为表示亲政
就在这听取各衙门主管依次奏事,这叫御门听政.
LONG
	);
	set("exits", ([
	"south" : __DIR__"baohedian",
	"north" : __DIR__"qianqinggong",
	"southeast" : __DIR__"shanshufang",
	"southwest" : __DIR__"jingshifang",
	"west" : __DIR__"shufang",
	"east" : __DIR__"yuehua",
	]));

	set("objects", ([
	"/d/huanggon/npc/taijian3" : 1,
	]));
	setup();
}


int valid_leave(object me, string dir)
{
        if (!me->query_temp("neigong") && dir == "north")
		return notify_fail("李公公白眼一翻:咋的,你以为你是谁,这是你们这些人来的地方?\n");
           if (dir == "north")
	me->delete_temp("neigong");
	return ::valid_leave(me, dir);
}
