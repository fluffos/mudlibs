// Room: /city/dangpu.c
// YZC 1995/12/04 
inherit ROOM;
void create() {
  set("short", "竞赛广场");
  set("long", @LONG
这里就是帮会的比武场, 往up就进去了, 除非你输了 不然不可以出来的!
LONG
  );
  set("no_new_clean_up", 0);
  set("no_fight", 1);
  set("no_magic", 1);
  set("item_desc", ([
    "flag": @TEXT
              以武会友！
TEXT
  ]));
  set("exits", ([
    "west": "/d/quanzhou/zhongxin",
    "up": __DIR__ "fightroom0",
  ]));
  setup();
}
void init() {
  object me = this_player();
  add_action(
    "discmds",
    ({
      "fly",
      "trans",
      "home",
      "respitate",
      "exert",
      "array",
      "duanlian",
      "ansuan",
      "touxi",
      "persuade",
      "teach",
      "exert",
      "exercise",
      "study",
      "learn",
      "sleep",
      "kill",
      "steal",
      "cast",
      "conjure",
      "expell",
      "fight",
      "hit",
      "perform",
      "prcatice",
      "scribe",
      "surrender"
    })
  );
  if (me->query_temp("inpk") && me->query("no_get"))
    call_out("do_recover", 5, me);
}
void do_recover(object me) {
  object *banginn;
  object *newbang = ({});
  if (!me || environment(me) != this_object()) return;
  me->delete("no_get");
  if (!living(me)) me->revive();
  me->set("eff_jing", me->query("max_jing"));
  me->set("jing", me->query("max_jing"));
  me->set("eff_qi", me->query("max_qi"));
  me->set("qi", me->query("max_qi"));
  if (me->query("neili") < me->query("max_neili"))
    me->set("neili", me->query("max_neili"));
  if (me->query("jingli") < me->query("max_jingli"))
    me->set("jingli", me->query("max_jingli"));
  me->start_busy(0);
  me->clear_condition();
  tell_object(me, HIW "广场似乎有一种神秘的力量，你活动了一下经骨，发现并没有受伤！\n" NOR);
  me->set_temp("inpk", 0);
  add("temp/" + me->query("banghui"), -1);
  message("channel:rumor",
    YEL "【比武】" + "比武使者：" + me->query("name") + "参加比武！结果输了! 「" + me->query("banghui") + "」剩下" + query("temp/" + me->query("banghui")) + "人!!\n" + NOR, users());

  if (query("temp/" + me->query("banghui")) == 0 || query("temp/" + me->query("banghui")) < 0) {
    banginn = query("bangnow");
    for (int i = 0; i < sizeof(banginn); i++) {
      if (banginn[i] != me->query("banghui")) {
        //			write(banginn[i]);
        newbang += ({ banginn[i] });
      }
    }


    message("channel:rumor",
      YEL "【比武】" + "比武使者：「" + me->query("banghui") + "」因为全部出局而退出了比赛, 现在剩下" + sizeof(newbang) + "个帮会!!\n" + NOR, users());
    set("bangnow", newbang);


  }
}

int discmds() { /*line50*/
  tell_object(this_player(), "这里你什么都不能做！\n");

  return 1;
}

int valid_leave(object me, string dir) {

  object *bangin;
  bangin = query("bangnow");
  if (!me->query_temp("inpk") && dir == "up")
    return notify_fail("你不能去哪\n");

  if (dir == "up") {
    if (sizeof(bangin) == 0) {
      bangin = ({ me->query("banghui") });
      set("temp/" + me->query("banghui"), 1);
      //				set("bangnow/"+me->query("banghui"), 1);
      message("channel:rumor",
        YEL "【比武】" + "比武使者：" + me->query("name") + "代表「" + me->query("banghui") + "」参加比武！\n" NOR, users());
      /*line70*/
    } else {
      int noin = 1;
      int i;
      for (i = 0; i < sizeof(bangin); i++) {
        if (bangin[i] == me->query("banghui")) {
          add("temp/" + me->query("banghui"), 1);
          noin = 0;
          message("channel:rumor",
            YEL "【比武】" + "比武使者：" + me->query("name") + "代表「" + me->query("banghui") + "」参加比武！目前有" + query("temp/" + me->query("banghui")) + "个人\n" NOR, users());

          /*line80*/
        }

      }
      if (noin) {
        bangin += ({ me->query("banghui") });
        set("temp/" + me->query("banghui"), 1);
        message("channel:rumor",
          YEL "【比武】" + "比武使者：" + me->query("name") + "代表「" + me->query("banghui") + "」参加比武！\n" NOR, users());
      }
    }
    set("bangnow", bangin);
  }
  return ::valid_leave(me, dir);
}
