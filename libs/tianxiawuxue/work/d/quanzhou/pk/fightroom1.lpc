void relay_message(string msg)
{
    object look_fight_room;
   string *msgs;
    int i;
    if (!look_fight_room=find_object("/d/quanzhou/pk/guankan"))
    look_fight_room=load_object("/d/quanzhou/pk/guankan");
   msgs=explode(msg, "\n");
    for (i=0;i<sizeof(msgs);i++)
    if (strlen(msgs[i])>5)
    message("vision",NOR+"@@ -->"+msgs[i]+"\n",look_fight_room);
}

void init()
{
add_action("forbidden", "trans");
add_action("forbidden", "fly");
add_action("forbidden", "home");
add_action("forbidden", "goto");
}

int forbidden()
{
