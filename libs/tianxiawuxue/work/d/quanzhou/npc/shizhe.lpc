#include <ansi.h>
inherit NPC;
inherit F_UNIQUE;
void create() {
  set_name(HIW "比武使者" NOR, ({ "biwu shizhe", "biwu", "shizhe" }));
  set("nickname", HIR "开启" NOR);
  set("gender", "男性");
  set("age", 32);
  set("long",
    "他就是比武使者。\n");
  set("combat_exp", 100000);
  set("attitude", "friendly");
  set("max_jing", 500);
  set("max_qi", 500);
  set("str", 25);
  set("int", 25);
  set("con", 25);
  set("dex", 30);
  set("inquiry", ([
    "name": "小的就是shizhe，不知您要打听点什么？",
  ]));
  set_skill("literate", 100);
  set_skill("dodge", 100);
  set_skill("unarmed", 100);
  setup();
  add_money("gold", 5);
  carry_object("d/city/obj/cloth")->wear();
}
