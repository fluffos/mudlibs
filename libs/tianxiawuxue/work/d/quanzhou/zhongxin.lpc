// Room: /d/quanzhou/zhongxin.c
// Date: May 7, 96   Jay
inherit ROOM;
void create()
{
    set("short", "城中心");
    set("long", @LONG
泉州是一个安静的港城。虽然这里是城中心，人们也只是脚步轻轻地
过往，并不喧哗。东面是一个港口，从那里可以出海。西面有一条小巷。
LONG
    );
    set("exits", ([
                "north" : __DIR__"beimen",
"northeast" : "/d/quanzhou/pk/guankan",
                "south" : __DIR__"nanmen",
                "east" : __DIR__"haigang",
                "west" : __DIR__"xijie",
    ]));
        set("objects",([
        __DIR__"npc/youxun" : 1,
__DIR__"npc/shizhe" : 1,
        ]));
    set("outdoors", "quanzhou");
    setup();
}

void init()
{
add_action("do_pk", "jiaru2");
}

int do_pk(string arg)
{
    object me, shizhe, ob, whereme, room;
    me = this_player();

whereme=environment(me);
if( !arg || arg=="" ) return notify_fail("格式错误!! \n");
if (!me->query("banghui")) return notify_fail("你还是先去加个帮会吧！\n");
if (me->query_temp("inpk")||me->query_temp("byhan")) return notify_fail("你不是参加了吗? 怎么又来了?\n");
if( arg="比赛")
	{
if (!present("biwu shizhe", whereme))
{
return notify_fail("你还是等使者来在开始吧!!\n");
}
if(me->query("combat_exp")<10000000)
return notify_fail("你武功这么差 怎么代表你的帮会呢?\n");
if(query("ppl_in_game")==0)
set("ppl_in_game", 1);
if(query("ppl_in_game")>20)
{
return notify_fail("现在人太多了!!\n");
}
if(query("ppl_in_game")==1)
{
message("channel:rumor", 
YEL"【比武】"+ "比武使者：帮会比武开始了!!将于3分钟后结束报名\n"+NOR,users());
call_out("stop_accept", 180);
}

if (!room=find_object("/d/quanzhou/pk/gate"))
room=load_object("/d/quanzhou/pk/gate");
ob=this_player();
ob->set_temp("inpk", 1);
ob->set_temp("byhan", 1);
ob->move(room);
add("ppl_in_game", 1);
if(!query("doreg"))
{
message("channel:rumor", 
YEL"【比武】"+ "比武使者：帮会比武快要开始了!!将于60分钟后开始第二场比赛\n"+NOR,users());
call_out("regenerate", 3600);
set("doreg", 1);
}
return 1;
	}
else return notify_fail("你要加入什么?\n");
}

int stop_accept()
{
object room;
set("ppl_in_game", 30);
message("channel:rumor", 
YEL"【比武】"+ "比武使者：帮会比武结束报名了!!比赛开始\n"+NOR,users());
"/d/quanzhou/pk/gate"->set("exits/up", "/d/quanzhou/pk/fightroom0");
if (!room=find_object("/d/quanzhou/pk/fightroom0"))
room=load_object("/d/quanzhou/pk/fightroom0");
}

int regenerate()
{
object *obb;
obb=users();
message("channel:rumor", 
YEL"【比武】"+ "比武使者：帮会比武可以开始报名了!!\n"+NOR,users());
set("ppl_in_game", 1);
set("doreg", 0);

"/d/quanzhou/pk/gate"->delete("exits/up");
"/d/quanzhou/pk/gate"->delete("temp");
"/d/quanzhou/pk/gate"->delete("bangnow");
for (int k=0; k < sizeof(obb); k++)
	{
			if(obb[k]->query_temp("byhan"))
					{
					obb[k]->set_temp("inpk", 0);
					obb[k]->set_temp("byhan", 0);					
					if(environment(obb[k])->query("fight_room"))
						{
						tell_object(obb,HIW "由于时间过久, 你自动退出了比赛！\n"NOR);
						obb[k]->move("/d/quanzhou/pk/guankan");
						}
								
					}
							
	}


return 1;
}
