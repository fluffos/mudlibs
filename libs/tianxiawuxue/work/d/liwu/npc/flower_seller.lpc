// flower_seller.c
inherit NPC;

inherit F_DEALER;
void create()
{
    set_name("小伙计", ({ "seller", "houji", "xiao" }));
    set("title", HIC"卖花郎"NOR);
    set("shen_type", 1);
    set("gender", "男性");
    set("age", 20);
    set("long",
"情人节来临，花圃的主人跑去泡妞了，只留下这个小伙计在这里看花，卖花。\n");
    set("vendor_goods", ({
	"/d/liwu/obj/rose",
      }));

    setup();
    carry_object("/clone/misc/changpao")->wear();
}
void init()
{
    add_action("do_list", "list");
    add_action("do_buy", "buy");
}
