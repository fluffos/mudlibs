// rose.c
inherit ITEM;

void setup() {}

void init() {
  add_action("do_song", "song");
}
//13
void create() {
  set_name(HIR "红玫瑰" NOR, ({ "rose" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "束");
    set("value", 100000 + random(6) * 10000);
    set("long", HIY "一束情人节专用的玫瑰花，可以送(song)给你心爱的人儿。" NOR);
  }
  setup();
}
//26
int do_song(string arg) {
  object me, ob;
  if (!arg || arg == "")
    return notify_fail("你要将玫瑰花送给谁？\n");

  me = this_player();
  ob = find_player(arg);

  if (!ob)
    return notify_fail("你心爱的人还没赴约呢，耐心等等吧。\n");
  if (query("value") == 1) {
    if (me != ob) {
      message_vision(HIR
        "$n定睛一看，原来是一束毫无价值的小草，不觉笑颜大怒！\n"
        "劈里啪啦一阵响声过后，$N的脸肿得象个大猪头...\n" NOR,
        me, ob);
    }
    destruct(this_object());
    return 1;
  }
  set("value", 1);
  set("long", "已经送给" + ob->name() + "的玫瑰花。");

  if (ob == me) {
    message_vision(HIY
      "$N很真诚的给自己送了一束花。\n" NOR, me);
    return 1;
  }
  if (!present(ob->query("id"), environment(me)))
    return notify_fail("你的心上人不在身边，送不到耶 :( \n");
  else {
    message_vision(HIY
      "$N单膝下跪，深情款款的将手中的一大束红玫瑰递给了$n，"
      "柔声说道：“祝你情人节快乐！”。\n"
      NOR, me, ob);

    message_vision(HIY
      "$N含羞接过玫瑰，刹那间，玫瑰化为漫天的祝福和欢乐将两人包围起来..."
      "不觉就互相依偎在一起。\n" NOR, ob);
  }
  this_object()->move(ob);
  return 1;
}
