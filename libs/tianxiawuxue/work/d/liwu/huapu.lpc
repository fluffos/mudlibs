#include <ansi.h>
#include <room.h>
inherit ROOM;
void create() {
  set("short", "玫瑰花圃");
  set("long", @long
:这是巫师专门为红尘中的有情人在情人节精心培育的玫瑰花花圃。只有
在情人节那天才开放的。一眼望去，一束束的玫瑰花迎风绽放，娇艳欲滴。
十分的惹人怜爱。
long);
  set("exits", ([
    "north": __DIR__ "happyjie",
  ]));
  set("objects", ([
    //"/d/liwu/obj/rose" : 10,
    "/d/liwu/npc/flower_seller": 1,
  ]));
  set("no_fight", 1);
  setup();
  replace_program(ROOM);
}
