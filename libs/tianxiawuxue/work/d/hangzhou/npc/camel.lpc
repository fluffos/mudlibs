// camel.c

#include <command.h>
#include <dbase.h>
#include <origin.h>

inherit NPC;

void create()
{
        set_name("白骆驼", ({ "camel" }));
        set("long","一匹白骆驼。\n");
        set("race", "野兽");
        set("age", 5);
        set("attitude","heroism");
        set("str", 30);
        set("dex", 35);
        set("con", 40);
 set("limbs", ({ "头部", "身体", "四肢" }) );
 set("verbs", ({ "bite" }) );
 set_temp("apply/attack", 10);
 set_temp("apply/damage", 10);
 set_temp("apply/armor", 10);
 set_temp("apply/defence",10);
        set("shen", 1);
        set("combat_exp", 2000);
        setup();
}
