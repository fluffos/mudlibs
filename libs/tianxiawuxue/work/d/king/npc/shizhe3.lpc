// shizhe3.c 
inherit NPC;
void create()
{
        set_name("使者", ({ "shi zhe", "shi", "zhe" }));
        set("gender", "男性");
        set("title", "惊雷堂使者");
        set("nickname",HIG"使者"NOR);
        create_family("风啸楼", 3, "弟子");
        set("age", 35);
        set("str", 25);
        set("dex", 20);
        set("long", "这是一个精壮汉子，腰间悬挂一只钢剑。\n");
        set("combat_exp", 45000);
        set("shen_type", 0);
        set("attitude", "peaceful");
        set_skill("unarmed", 50);
        set_skill("force", 50);
        set_skill("sword", 80);
        set_skill("dodge", 50);
        set_skill("parry", 50);
        set_skill("fengxiao-jianfa", 70);
        set_temp("apply/attack", 30);
        set_temp("apply/defense", 30);
        set_temp("apply/armor", 15);
        set_temp("apply/damage", 20);
        map_skill("sword", "fengxiao-jianfa");
        map_skill("parry", "fengxiao-jianfa");
        set("neili", 800); 
        set("max_neili", 800);
        set("jiali", 50);
        set("chat_chance", 15);
        set("chat_msg", ({
                "\n使者一拍腰间的钢剑，说道:在下风啸楼使者，奉哈玛雅将令，\n"
                "守护这里。\n" ,
                "\n使者大叫: 反了，反了！通通给我拿下！ \n",
                "使者说道: 哈玛雅武功盖世，曾在扬州街上一拳\n"
                "打死一只疯狗，就凭你也配和哈玛雅动手？\n" ,
               }) );
        setup();
        carry_object("/clone/cloth/cloth.lpc")->wear();
        carry_object("/clone/weapon/gangjian.lpc")->wield();
        add_money("silver",30);
}

