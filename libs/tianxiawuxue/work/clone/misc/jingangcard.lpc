#include <ansi.h>;
#include <command.h>;
inherit ITEM;

void create() {
  set_name(HIY "金刚元气" NOR, ({ "jingang yuanqi", "yuanqi", "qi" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "团");
    set("long",
      HIY "这是你使出金刚不坏神功所在你体内的一股真气, 他能使你精气不受损, 天下无敌。\n" NOR);
    set("value", 0);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_put", 1);
    set_weight(10);
  }
  setup();
}
void init() {
  object me = this_player();
  if (me->query_temp("jingang-buhuai"))
    add_action("do_huti", "jingang");
  else
    destruct(this_object());
}

int do_huti(string arg) {
  object me = this_player();
  if (me->query_temp("jingang-buhuai")) {
    string msg;
    me->set("qi", me->query("max_qi"));
    me->set("eff_qi", me->query("max_qi"));
    me->set("jing", me->query("max_jing"));
    me->set("eff_jing", me->query("max_jing"));
    me->set("neili", me->query("max_neili"));
    me->set("jingli", me->query("max_jingli"));
    me->clear_condition();
    me->reincarnate();
    message_vision(HIY "啊!!!的一声$N运起体内的金刚之气，整个人如同金人一样刀枪不入！！\n" NOR, me);
    if (me->query_busy()) {
      message_vision(HIY "$N发觉自己动弹不得, 只好用金刚之气，硬充破穴道！！\n" NOR, me);
      tell_object(me, HIY + BOLD "虽然你可以动了但是却伤了身体，看来下次要小心一点。\n" NOR);
      me->add("max_neili", -1000);
      me->start_busy(0);
      if (me->query("max_neili") < 0) me->set("max_neili", 0);
    }

  } else
    destruct(this_object());
  return 1;
}
