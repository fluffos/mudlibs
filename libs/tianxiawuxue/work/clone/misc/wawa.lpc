// by hhm 2005/6/01
#include <ansi.h>
inherit ITEM;
void setup() {}
void init() {
  add_action("do_ri", "ri");
}
void create() {
  set_name(HIR "充气娃娃" NOR, ({ "chongqi wawa", "wawa" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", HIG "这是一个可爱的充气娃娃,是参照麦当娜的身体原型制作的,你可以(ri)娃娃!\n" NOR);
    set("value", 0);
  }
  setup();
}

int do_ri(string arg) {
  int fw;
  object me = this_player();
  if (!id(arg))
    return notify_fail("你要日什么？\n");
  me->set("jing", 0);
  me->set("qi", 0);
  me->add("combat_exp", 1000);
  me->add("max_neili", 500);
  me->add("max_jingli", 500);
  me->add("potential", 1000);
  message_vision(HIR "$N吧娃娃放在身体下面拼命的动作,结果你用力过猛,娃娃漏气了,你也消耗了大量的静,气.\n" NOR, me);
  destruct(this_object());
  return 1;
}
