// 潜能丹 (测试用,不用于游戏!)
//@ TXWX by hhm 2005/4/22

#include <ansi.h>
inherit ITEM;

void setup() {}

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIR "潜能丹" NOR, ({ "qn dan", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", HIR "这是一颗武林人士梦寐以求的潜能丹，据说当年虚蓝(Happy)为了得到它,曾经求了天下无雪三天三夜.(eat)可以增加1000潜能。\n" NOR);
    set("value", 0);
    set("no_drop", HIR "你是不是不想要啊?不想要还给天下无雪啊.\n" NOR);
    set("no_get", HIR "你是不是不想要啊?不想要还给天下无雪啊.\n" NOR);
    set("no_put", 1);
  }
  setup();
}

int do_eat(string arg) {
  if (!id(arg))
    return notify_fail("你要吃什么？\n");

  this_player()->add("potential", 1000);
  message_vision("$N吃下一颗潜能丹，对天下无雪充满了感激 !\n", this_player());
  destruct(this_object());
  return 1;
}
