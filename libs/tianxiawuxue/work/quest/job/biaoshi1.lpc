#include <ansi.h>
inherit NPC;
void create()
{
        
        set_name("护镖镖师", ({ "biao shi"}));
        set("gender", "男性");
        set("age", random(10) + 25);
        set("str", 33);
        set("con", 26);
        set("int", 20);
        set("dex", 23);
        set("long", "长风镖局的镖师。\n");
        set("combat_exp", 10800000); 
        set("attitude", "friendly");
        set_skill("force", 450);
        set_skill("sword", 450);
        set_skill("dodge", 450);
        set_skill("parry", 450);
        set_skill("fanliangyi-dao", 400);
        set_skill("blade", 450);
	 set_skill("zixia-shengong",400);
        map_skill("blade","fanliangyi-dao");
        set("max_qi", 14500); 
        set("eff_jingli", 14000); 
        set("neili", 17000); 
        set("max_neili", 17000);
        set("jiali", 30);
                setup();
        carry_object("/clone/weapon/gangdao")->wield();
        carry_object("/clone/cloth/cloth")->wear();
}
