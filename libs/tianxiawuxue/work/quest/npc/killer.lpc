// killer.c
#include <ansi.h>
inherit NPC;
void create() {
  set_name("蒙面人", ({ "figure" }));
  set("long",
    "这个人头上戴著蒙面头罩，八成准备干什麽坏事。\n");
  set("attitude", "heroism");
  set("hired_killer", 1);
  set("age", random(10) + 30);
  set("max_qi", 1500);
  set_skill("dodge", 90);
  set_skill("sword", 90);
  set("combat_exp", 500000 + random(500000));
  setup();
  carry_object("/d/city/obj/cloth");
  carry_object("/clone/weapon/changjian")->wield();
}

void init() {
  object ob;
  if (interactive(ob = this_player())) {
    remove_call_out("hunting");
    call_out("hunting", 1, ob);
    remove_call_out("destkiller");
    call_out("destkiller", 60, 2);
  }
}

void hunting(object me) {
  if (me->query("combat_exp") < 2000) {
    message_vision("$N指着$n说道：这种九流货色还用我？再见！\n", this_object(), me);
    set_leader(0);
    call_out("destkiller", 1);
    return;

  } else {
    //	message_vision(HIR "$N对$n大喝道：有人花银子买了你的命！明年今日就是你的忌辰！认倒霉吧！\n" NOR,this_object(), me);
    this_object()->kill_ob(me);
    this_object()->set_leader(me);
    me->kill_ob(this_object());
  }
  if (!this_object()->is_fighting()) this_object()->set_leader(me);
  return;
}
int accept_fight(object me) {
  return 0;
}

void destkiller() {
  destruct(this_object());
  return;
}
void unconcious() {
  message_vision(HIR "$N大叫一声：好厉害！然后地板突然翻起，$N钻了进去不见了。\n", this_object());
  destruct(this_object());
  return;
}
void die() {
  call_out("unconcious", 1);
  return;
}
