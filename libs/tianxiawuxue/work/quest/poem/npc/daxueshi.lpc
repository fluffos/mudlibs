// poemgirl.c

inherit NPC;

#include <ansi.h>

int send_back(object me);

void create() {
  set_name(HIW "仙姑" NOR, ({ "xian gu", "gu", }));
  set("gender", "女性");
  set("age", 152);

  set("combat_exp", 2000000);
  set("attitude", "friendly");
  set_skill("literate", 300);
  set_skill("dodge", 140);
  setup();
  this_player()->carry_object("/clone/misc/cloth")->wear();

}
