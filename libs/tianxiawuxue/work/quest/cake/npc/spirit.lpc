// by night
// fid 修改

#include <ansi.h>

inherit NPC;
inherit F_DEALER;
void consider();
int ask_cake();
void create() {
  set_name("精灵", ({ "spirit" }));
  set("nickname", HIW "生辰" NOR);
  set("gender", "女性");
  set("age", 20);
  set("long",
    "精灵的主人，管理着生辰的一切事务。\n");
  set("attitude", "friendly");
  set("shen_type", 1);
  set("class", "swordman");

  set("str", 21);
  set("int", 28);
  set("con", 40);
  set("dex", 40);
  set("per", 100);


  set("qi", 2000);
  set("max_qi", 2000);
  set("jing", 1000);
  set("max_jing", 1000);
  set("neili", 3000);
  set("max_neili", 3000);
  set("jiali", 100);

  set("combat_exp", 1000000);
  set("score", 200000);
  set("shen", 100000);

  set("inquiry", ([
    "生日礼物": (: ask_cake :) ]));

  set("chat_chance", 30);
  set("chat_msg", ({
    "生辰精灵拿出一本" + HIW "《精灵物语》" NOR + "，专心地读了起来。\n",
    "生辰精灵笑嘻嘻地说：“要生日礼物，找我就对了。”\n", }));
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: exert_function, "shield" :),
  }));
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: exert_function, "eyes" :),
  }));
  set("vendor_goods", ({
    "/quest/cake/obj/candle",
  }));
  setup();
  //        carry_object("/d/city/npc/cloth/moon-dress")->wear();
  carry_object("/d/city/obj/gangdao")->wield();
  //        carry_object("/u/jave/obj/gun"); 
}

string ask_cake() {
  object ob;
  object me = this_player();
  if (me->query("mud_age") < 86400)
    return "你太年轻了，等过了15岁再来要生日礼物吧。\n";
  if (this_player()->query_temp("birthday")) {
    command("say 恭喜恭喜，祝你生日快乐！\n");
    ob = new("/quest/cake/obj/cake");
    ob->move(this_player());
    message_vision("\n$N给了$n一个特制的生日蛋糕。\n", this_object(), this_player());
    this_player()->delete_temp("birthday");
    return "祝你生日快乐！\n";
  }
  return;
}


void init() {
  add_action("do_list", "list");
  add_action("do_buy", "buy");
  add_action("do_faint", "18mo");
  add_action("do_faint", "kiss");
  add_action("do_faint", "taste");
  add_action("do_faint", "hug");
  add_action("do_faint", "beg");
}

void unconcious() {
  die();
}
void die() {
  object ob;
  command("sigh");
  message_vision("\n$N背上长出一对透明的羽翼，一开一合间，$N又变得神采奕奕。\n", this_object());
  ob = new("/quest/cake/npc/spirit");
  ob->move(environment(this_object()));
  destruct(this_object());
}
