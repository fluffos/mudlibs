string randomlocation(int i1);
string ask_me();
string *list,tmp;
void create()
{ 
    set_name("宋远桥", ({ "song yuanqiao", "song" }));
        set("nickname", "武当首侠");
        set("long", 
                "他就是张三丰的大弟子、武当七侠之首的宋远桥。\n"
                "身穿一件干干净净的灰色道袍。\n"
                "他已年过六十，身材瘦长，满脸红光。恬淡冲和，沉默寡言。\n");
        set("gender", "男性");
        set("age", 61);
        set("attitude", "peaceful");
        set("shen_type", 1);
    set("str", 38);
    set("int", 58);
    set("con", 68);
    set("dex", 128);
    
    set("max_qi", 1000);
    set("max_jing", 1000);
    set("neili", 16000);
    set("max_neili", 8000);
    set("jiali", 50);
    set("combat_exp", 24000000);
    set("score", 70000);
    set_skill("force", 600);
    set_skill("taiji-shengong", 600);
    set_skill("dodge", 600);
    set_skill("tiyunzong", 600);
    set_skill("unarmed", 600);
    set_skill("taiji-quan", 600);
    set_skill("parry", 600);
    set_skill("taoism",800);
    set_skill("sword", 600);
    set_skill("taiji-jian", 600);
    set_skill("literate", 500);
    map_skill("force", "taiji-shengong");
    map_skill("dodge", "tiyunzong");
    map_skill("unarmed", "taiji-quan");
    map_skill("parry", "taiji-jian");
    map_skill("sword", "taiji-jian");
        create_family("武当派", 2, "弟子");
        set("inquiry", ([
                          "秘籍" : (: ask_me :),
                          "kill":(:give_quests():),
                          "fangqi": (: ask_fangqi :),
                          "放弃"  : (: ask_fangqi :),
        ]));

        set("book_count", 1);

        set("chat_chance_combat", 40);
        set("chat_msg_combat", ({
                (: perform_action, "unarmed.zhen" :),
                (: exert_function, "recover" :),
        }) );
            set("no_get",1);
        setup();
//        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/d/wudang/obj/greyrobe")->wear();

}
void attempt_apprentice(object ob)
{
          
          if ((int)ob->query("shen") < 0) {
                command("say 我武当乃是堂堂名门正派，对弟子要求极严。");
                command("say 在德行方面，" + RANK_D->query_respect(ob) +
                        "是否还做得不够？");
                return;
        }
        command("say 好吧，贫道就收下你了。");
        command("recruit " + ob->query("id"));
        if( (string)ob->query("class") != "taoist")
                ob->set("class", "taoist");
}

string ask_me()
{
        mapping fam; 
        object ob;
        
        if (!(fam = this_player()->query("family")) || fam["family_name"] != "武当派")
                return RANK_D->query_respect(this_player()) + 
                "与本派素无来往，不知此话从何谈起？";
        if (query("book_count") < 1)
                return "你来晚了，本派的内功心法不在此处。";
        add("book_count", -1);
        ob = new("/kungfu/class/wudang/force_book");        
        ob->move(this_player());
        return "好吧，这本「太极十三式」你拿回去好好钻研。";
}


int max_skill_level(object ob)
{  
        int s,i=0,maxlevel=1;
        string *str;
        userskills=ob->query_skills();
        if (!mapp(userskills)) {maxlevel=3;return maxlevel;}
        str=keys(userskills);

        s=sizeof(str);
        if (s<2) return userskills[str[0]]; 
        while (s>0){
                s-=1;
                i=userskills[str[s]];
                if (i>maxlevel) maxlevel=i;
                }
        return maxlevel;
}

int accountlevel(int turn,object ob)
{
        int level;
        level=max_skill_level(ob);
        level=(int)level*(70+turn*4)/100;
        if(level==0) level = 1;
        return level;
}

string randomlocation(int i1)
{
        string *str1,*str2,loca;
        int i2,temp;
        str1=keys(allloca);
        str2=allloca[str1[i1]];
        i2=sizeof(str2);
        temp=random(i2);
        if (temp==0 || temp==i2) temp=1;
        loca=str2[0]+str2[temp];
        return loca;
}
      
int give_quests()
{
        object guaiob;
        object me,who,tempob;
        int chooseguai,rewardpot,rewardexp,turn;
        int questbusytime,giveuptime,guailevel;
        int temp,i1;
        string guaiid;
        string *strtemp,locastr;
        me=this_object();
        who=this_player();
        giveuptime=who->query_temp("questtime2");
        questbusytime=who->query_temp("questtime1");
        turn=who->query_temp("turn");
        if (who->query_temp("kill")){
                if (time()<giveuptime){      
                message_vision ("$n对$N说道：这位"+RANK_D->query_respect(who)
                +"，在下不是请您去杀掉"+who->query_temp("guainame")+"吗？\n",me,who);
                return 1;
                }else turn-=2;
        }else{
                        if (time()<questbusytime) {
                        message_vision ("$n看了看你,面带微笑的对$N说道：\n"
                        +"这位"+RANK_D->query_respect(who)+",坏人已经除尽，不妨先去歇息。\n"
                        ,me,who);
                        return 1;
                        }
                         if (who->query("shen") < 10000){
                        message_vision ("$N看了看你,面带微笑的对$n说道：\n"
                        +"还是算了把！\n"
                          ,me,who);
                        return 1;
                        }
                }
        if (!turn || turn>9) {
                who->set_temp("turn",0);
                turn=0;
                }
        turn=turn+1;
         who->set_temp("turn",turn);
         guailevel=accountlevel(turn,who);
         guaiob=new("/quest/wudang/questguai_n"); 


        guaiob->set_heart_beat(1);
        guaiob->set_temp("killername",(string)who->query("id"));
        guaiob->set("max_neili",guaif(turn,who));
        guaiob->set("neili",(int)(guaif(turn,who)*3/5));
        guaiob->set("max_jingli",guaim(turn,who));
        guaiob->set("jingli",(int)(guaim(turn,who)*3/5));
        guaiob->set("combat_exp",accountguaiexp(turn,who));
        guaiob->set("neili_factor",(int)(guailevel/2));
        guaiob->set("jiali",(int)who->query_skill("force")/4);
        guaiob->set("int",(int)who->query_int());
        guaiob->set("str",(int)who->query_str());
        guaiob->set("spi",(int)who->query_spi());
        guaiob->set("con",(int)who->query_con());
        guaiob->set("per",(int)who->query_per());
        guaiob->set("kar",(int)who->query_skill("kar"));
        guaiob->set("jingli_factor",(int)(guailevel/2));
        set_guai_qi_jing(turn,guaiob);

        
        switch (random(3)){
                case 1 :
                if(guaiob->query("combat_exp")>100000)
                        guaiob->set("long","一个绿林高手,听说出师于星宿派，是"HIR
                                +who->query("name")+NOR"的目标\n");
                else guaiob->set("long","绿林人物"+guaiob->query("name")
                                +",听说是星宿派的高手，颇有些本领。\n");
                break;
                case 2 :
                        if(guaiob->query("combat_exp")>100000)
                                guaiob->set("long","一个黑道高手,听说来自于一个神秘的组织，是"HIR
                                        +who->query("name")+NOR"的目标\n");
                        else guaiob->set("long","黑道人物"+guaiob->query("name")
                                        +"他全身散发出一丝邪气。\n");
                        break;
                default :
                        guaiob->set("long","武当叛徒"+guaiob->query("name")
                                        +"，他混身上下杀气逼人。\n");
                }
        chooseguai=random(14);
        setguaititle(chooseguai,guaiob);   
        guaiid=guaiob->query("title");
        guaiob->set("title",guaiid);
        
        rewardexp=200+random(10);
        rewardpot=300+random(10);
        guaiob->set_temp("killrewardpot",rewardpot);
        guaiob->set_temp("killrewardexp",rewardexp);
        guaiob->set_temp("player1",who);
        guaiob->setguaiskill(chooseguai,guailevel,guaiob);
        guaiob->check_time();  
       
   strtemp=keys(allloca);
   i1=sizeof(strtemp);
   temp=random(i1);
   if (temp==i1) temp=0;
   locastr=randomlocation(temp);  
   tempob=load_object(locastr);
   if (!tempob) 
     {
      write("好象没反应了，再问一次吧。\n");     
      return 1;
     }
        guaiob->move(tempob);
        who->set_temp("questtime1",time()+60); 
        who->set_temp("questtime2",time()+600);
        who->set_temp("guainame",guaiob->query("name"));
        who->set_temp("turn",turn);
        who->set_temp("kill",1);
        who->delete_temp("song_job",1);
        message_vision("$n微笑着对$N说道：请这位"+RANK_D->query_respect(who)
                +"替我除掉在"+strtemp[temp]+"出没的"+
YEL+guaiob->query("name")+"("+
        guaiob->query("id")+")"+NOR", 老夫必有重谢！\n",me,who); 
        return 1;
}

int accountguaiexp(int turn,object who)
{ 
   int userexp,guaiexp;
   userexp=who->query("combat_exp");
   guaiexp=userexp*(50+turn*6)/100;
   return guaiexp;
}
int guaif(int turn,object who)
{
   int userneili,guaineili;
   userneili=who->query("max_neili");
   guaineili=userneili*(50+turn*5)/80;
   return guaineili;
}
int guaim(int turn,object who)
{
   int userjingli,guaijingli; 
   userjingli=who->query("max_jingli");
   guaijingli=userjingli*(30+turn*5)/80;
   return guaijingli;
}

int set_guai_qi_jing(int turn,object guai)
{
   int maxqi,maxjing;
   maxqi=20+(int)guai->query("max_neili")*(20+turn*2)/100;
   maxjing=20+(int)guai->query("max_jingli")*(20+turn*2)*4/400;
   guai->set_temp("maxqi",maxqi);
   guai->set("max_qi",maxqi);
   guai->set("eff_qi",maxqi);
   guai->set("qi",maxqi);
   guai->set("max_jing",maxjing);
   guai->set("eff_jing",maxjing);
   guai->set("jing",maxjing);
   return 1;
}
int getexp(int turn,int level,object who)
{
        int exp,userexp;
        userexp=who->query("combat_exp");
        if(turn<1) turn =1;
 exp=random(1000)+turn*2000+(userexp/5000)*turn+(level*level/2000)*turn*1000;
        return exp;
}

string setguaititle(int number,object guaiob)
{
   if (random(10)>7){
        if (guaiob->query("combat_exp")>2000000)
                guaiob->set("title","杀人狂魔");
        else if (guaiob->query("combat_exp")>1000000)
                guaiob->set("title","恶贯满盈");
        else if (guaiob->query("combat_exp")>500000)
                guaiob->set("title","江洋大盗");
        else if (guaiob->query("combat_exp")>100000)
                guaiob->set("title","大盗");
        else if (guaiob->query("combat_exp")>50000)
                guaiob->set("title","采花贼");     
        else if (guaiob->query("combat_exp")>10000)
                guaiob->set("title","流氓头");  
        else if (guaiob->query("combat_exp")>5000)
                guaiob->set("title","流氓");
        else  guaiob->set("title","小流氓");
        }else {
        switch (number){
                        case 0 :guaiob->set("title","古墓魔女");break;
                        case 1 :guaiob->set("title","峨嵋恶尼");break;
                        case 2 :guaiob->set("title","全真恶道");break;
                        case 3 :guaiob->set("title","武当贼道");break;
                        case 4 :guaiob->set("title","少林恶僧");break;
                        case 5 :guaiob->set("title","白驼淫贼");break;
                        case 6 :guaiob->set("title","丐帮叛徒");break;
                        case 7 :guaiob->set("title","华山恶龙");break;
                        case 8 :guaiob->set("title","星宿老魔");break;
                        case 9 :guaiob->set("title","明教暴徒");break;
                        case 10 :guaiob->set("title","神龙恶徒");break;
                        case 11 :guaiob->set("title","桃花岛弃徒");break;
                        case 12 :guaiob->set("title","逍遥派奸贼");break;
                        case 13 :guaiob->set("title","雪山喇嘛");break;
                        default :guaiob->set("title","小贼");break;
                        }
                }
}

int ask_fangqi()
{        
         int temp,i1;
         object me,guai;
         string *strtemp,locastr;
         locastr=randomlocation(temp); 
         me = this_player();
         guai=load_object(locastr);
         if(!me->query_temp("kill"))
       { command("bite");
           command("say 呸！你没有任务！\n");
           return 1;
         }
         me->apply_condition("questbusytime",4+random(4));
         me->delete_temp("questtime1"); 
         me->delete_temp("questtime2");
         me->delete_temp("guainame");
         me->set_temp("song_job",1);
         me->set_temp("kill",0); 
        command("shrug");
        command("say  只好任它去了。\n");
        destruct(guai);
        return 1;
}
