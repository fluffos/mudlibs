//倭寇 wokou.c
inherit NPC;

void create()
{
        set_name("倭寇", ({"wo kou"}));
        set("long",
        "这是一个身材高大倭寇，两臂粗壮，膀阔腰圆，看起来似乎不怀好意。\n"
        );

        set("gender", "男性");
        set("attitude", "aggressive");
        set("class", "alchemist");

        set("age", 20+random(30));
        set("shen_type", 0-random(1000));

        set("str", 25+random(10));
        set("dex", 25+random(10));
        set("int", 25+random(10));
        set("con", 25+random(10));

        set("qi", 2000);
        set("max_qi", 2000);
        set("jing", 1000);
        set("max_jing", 1000);
        set("neili", 2000);
        set("max_neili", 1000);
        set("jiaji", 50+random(100));

        set("combat_exp", 10000+random(100000));
        set("score", 1);

        set_skill("force", 20+random(80));
        set_skill("bibo-shengong", 20+random(80));
        set_skill("dodge", 20+random(60));
        set_skill("anying-fuxiang", 20+random(80));
        set_skill("unarmed", 20+random(100));
        set_skill("luoying-zhang", 20+random(120));
        set_skill("parry", 20+random(80));
        set_skill("sword", 20+random(100));
        set_skill("luoying-shenjian", 10+random(110));

        map_skill("force", "bibo-shengong");
        map_skill("dodge", "anying-fuxiang");
        map_skill("parry", "luoying-shenjian");
        map_skill("sword", "luoying-shenjian");
        map_skill("unarmed", "luoying-zhang");

        set("chat_chance", 20);
        set("chat_msg", ({
                "倭寇说道: 这次看那些玩家们往哪儿跑。\n",
                "倭寇说道: 杀! 杀! 杀!!!。\n",
                (: random_move :)
        }) );

        setup();

        carry_object("/d/city/obj/gangjian")->wield(); 
        carry_object("/clone/misc/cloth")->wear();}
