#include <ansi.h>
// qwlist1000.c 李逍遥(lxy@xi'an_ldj) 99.9.25
inherit SKILL;
mapping *quest = ({
  ([ "quest": HIC "李逍遥" NOR,
    "quest_type": "寻",
    "time": 300,
    "exp_bonus": 4,
    "pot_bonus": 2,
    "score": 20
  ]),
});
mapping query_quest() {
  return quest[random(sizeof(quest))];
}
