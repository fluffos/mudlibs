#include <weapon.h>
inherit SWORD;

void create() {
  set_name("斩妖剑", ({ "zhanyaojian", "jian", "sword" }));
  set_weight(6000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "这是一口透体血红的宝剑，不知沾满了多少武林人士的鲜血,\n");
    set("value", 8000);
    set("material", "steel");
    set("weapon_prop/personality", 150);
    set("wield_msg", "$N「唰」的一声抽出一柄透体血红的$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n插回剑鞘。\n");
  }
  init_sword(200);
  setup();
}
