// qiangdao.c 淫贼
// zjb@smlw
inherit NPC;
#include <ansi.h>

void create() {
  object me;
  int myskill;
  me = this_player();
  set_name(HIW "淫贼" NOR, ({ me->query("id") + " yinzei" }));
  set("title", me->query("name") + "要杀的");
  set("gender", "男性");
  set("age", 28);
  set("no_suck", 1);
  set("long", "他是一个专欺负妇女的淫贼。\n");

  set("combat_exp", 1000);
  set("score", -10);

  set("attitude", "peaceful");

  set_skill("sword", 100);
  set_skill("dodge", 100);
  set_temp("apply/attack", 10);
  set_temp("apply/defense", 10);

  set("str", 30);
  set("per", 18);
  set("food", 400);
  set("water", 400);

  setup();
  carry_object("/clone/misc/cloth")->wear();
  add_money("silver", 10);
}

void init() {
  remove_call_out("leave");
  call_out("leave", 300);
}

void leave() {
  object ob = this_object();
  if (!ob->is_fighting()) {
    message_vision(HIC "淫贼钻进路边的杂草，不见了。\n" NOR, this_object());
    destruct(this_object());
  } else call_out("leave", 10);
}

void die() {
  object me = this_object()->query_temp("last_damage_from");
  object corpse, money;
  int exp, pot;
  //         kar = random(me->query("kar"));
  //        shen1 =  300+random(100);
  //        shen2 =  random(50);
  exp = 1200 + random(500);
  pot = 500 + random(200);

  if (this_object()->query("id") == killer->query("id") + "-huaidan") {
    exp = random(500);
    pot = random(350);
    killer->add("combat_exp", exp);
    killer->add("potential", pot);
    killer->set_temp("job", 0);
    tell_object(killer, sprintf(HIY "你得到了%d点经验，%d点潜能。\n" NOR, exp, pot));
    killer->delete_temp("job");
  }

  message_vision(HIR "\n淫贼倒在地上，挣扎了几下就死了。\n" NOR, me);

  corpse = new("/clone/misc/corpse");
  corpse->set("name", HIW "淫贼的尸体" NOR);
  corpse->set("long", "他是一个曾经无恶不做的淫贼，\n然而，他已经死了，剩下一具丑陋的尸体。\n");
  corpse->move(environment(this_object()));
  corpse->set_max_encumbrance(1000);
  money = new("/clone/money/gold");
  money->move(corpse);
  me->add("MKS", 1);

  destruct(this_object());
}
