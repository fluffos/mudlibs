#include <armor.h>
inherit CLOTH;
void create() {
  set_name("破烂的布衣", ({ "cloth" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "cloth");
    set("armor_prop/armor", 100000);
  }
  setup();
}
