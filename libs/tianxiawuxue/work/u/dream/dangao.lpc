// /u/drea/dangao.c 国庆节蛋糕
//by hhm
//2005.9.27 sz

#include <ansi.h>
inherit ITEM;
inherit F_FOOD;

int do_eat(string arg);
void create() {
  set_name(HIY "国庆节蛋糕" NOR, ({ "dan gao", "dangao" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "这是dream和朋友们庆祝国庆节而做的蛋糕，可是dream自己亲手做的哦!\n快吃(eat)了吧。^_^\n");
    set("unit", "盒");
  }
  setup();
}

void init() {
  if (!wizardp(this_player())) {
    set("no_get", "这盒蛋糕已经掉在地上摔了个乱七八糟。\n");
    set("no_give", "蛋糕可不多，留着自己吃吧。\n");
    set("no_drop", "不是吧！这可是的dream苦心做的哦，丢了乱可惜的\n");
    set("no_sell", "神的礼物，小的不敢收。\n");
    set("no_put", "蛋糕不能压的，还是别放进去了。\n");
    set("no_steal", "这也要偷，太无耻了吧。\n");
  }
  if (this_player() == environment())
    add_action("do_eat", "eat");

}
string rdm(string *strs) {
  return strs[random(sizeof(strs))];
}

int do_eat(string arg) {
  string *hows = ({
    "万般幸福地",
    "鬼鬼祟祟地",
    "红光满面地",
    "乐滋滋地",
    "感激涕淋地",
    "激动得浑身颤抖，",
    "庄严地看着大家，然后勇敢地",
    "笨手笨脚地",
    "满脸狐疑地",
    "满脸堆笑故作正经地",
    "推开众人，摆好架式，",
    "羞得满脸通红，",
  });

  string *manners = ({
    "把$n在手心里反复捏了几下，",
    "把$n在地上疯狂地跺扁，",
    "把$n在墙上嘭地一声砸开，",
    "把$n在心口仔细暖了一下，",
    "亲了亲$n，",
    "用一副刀叉切开$n，",
    "在$n上舔了半天，",
  });

  string *actions = ({
    "张开樱桃小口吞了下去",
    "用两片大嘴唇狠狠的就是一口吃了下去",
    "一歪嘴巴吃了下去",
    "皱着眉头痛心疾首地吃了下去",
    "望天上一扔，伸出脖子叭地一声准确的命中嘴巴",
    "往嘴巴用力使劲里一塞",
    "嚼都没嚼就伸脖踮脚地咽了下去",
    "唏唏溜溜就岔着气吃下了肚子",
    "吃得神经错乱眼冒金星",
    "吃得如痴如狂东倒西歪",
    "吃得神采奕奕情窦大开",
    "吃得神魂颠倒四面楚歌",
    "吃得翻肠倒肚天昏地暗",
    "狼吞虎咽地反反复复左嚼右嚼咽了下去",
    "咔嚓咔嚓地大嚼了起来，只一会儿就整个连假牙都咽了下去",
  });

  object me = this_player();
  int get_qn, get_wx, get_money, get_jingli, get_neili;

  if (!arg && arg != "dan gao")
    return notify_fail("你要吃什么?\n");


  if (me->query("guoqing", 1))
    return notify_fail(HIR "你还想吃呀？这可不行啊？明年吧！！！\n" NOR);

  message_vision("$N" + rdm(hows) + rdm(manners) + rdm(actions) + "。\n",
    this_player(), this_object());

  get_qn = 200000;
  get_wx = 500000;
  get_money = 100000000;
  get_neili = 5000;
  get_jingli = 5000;


  me->add("potential", get_qn);
  me->add("combat_exp", get_wx);
  me->add("balance", get_money);
  me->add("max_neili", get_neili);
  me->add("max_jingli", get_jingli);
  me->set("guoqing", 1);
  this_player()->set("food", (int)this_player()->max_food_capacity());

  tell_object(me, HIW "你得到了天下无雪wiz组给的奖励：\n" +
    chinese_number(get_qn) + "点潜能\n" +
    chinese_number(get_wx) + "点经验\n" +
    chinese_number(get_money / 10000) + "两黄金存款\n" +
    chinese_number(get_neili) + "点内力和精力\n" + NOR);

  tell_object(me, HIR "祝大家国庆节快乐，祝福我们的祖国蒸蒸日上！\n
还有希望大家永远支持天下无雪!\n" NOR);
  destruct(this_object());
  return 1;
}
