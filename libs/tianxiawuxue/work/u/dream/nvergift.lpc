// 奖励

#include <ansi.h>
inherit ITEM;
int do_eat(string);
void init();

void init() {
  if (!wizardp(this_player())) {
    set("no_get", "你手里一松，红包从指间滑落！\n");
    set("no_give", "这么珍贵的红包，哪能随便给人？\n");
    set("no_drop", "这么宝贵的红包，扔了多可惜呀！\n");
    set("no_sell", "凡人哪里知道" + this_object()->query("name") + "的价值？还是自己留着吧。\n");
  }
  add_action("do_dakai", "dakai");
}

void create() {
  set_name(HIR "红包" NOR, ({ "hongbao", "gift" }));
  set_weight(90);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", HIR "这是天下无雪特地为对女儿出世而送给大家的礼物!\n" NOR);
    set("value", 0);
    set("no_give", 1);
    set("no_drop", 1);
    set("drug_type", "补品");
  }
  set("is_monitored", 1);
  setup();
}

int do_dakai(string arg) {
  if (!id(arg))
    return notify_fail("你要打开什么？\n");
  if (this_player()->query("dreamdaughter"))
    return notify_fail("嘿嘿...想来这招?\n");

  this_player()->add("max_neili", 20000);
  this_player()->add("max_jingli", 20000);
  this_player()->add("combat_exp", 1000000);
  this_player()->set("dreamdaughter", 1);
  this_player()->add("potential", 1000000);
  message_vision(HIR "$N摸了摸油腻腻的嘴，乐呵呵的说：愿嫣然侄女快乐成长！！！\n", this_player());
  destruct(this_object());
  return 1;
}
