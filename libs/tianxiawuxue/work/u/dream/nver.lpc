#include <ansi.h>
inherit NPC;
string ask_me();

void create()
{
        set_name(HIW"嫣  然"NOR, ({ "yanran", "hu" }) );
        set("nickname", HIR"Dream 的女儿"NOR);
        set("gender", "女性" );
        set("age", 2);
        set("long", YEL"这是Dream为了答谢各位兄弟的关怀,向小女嫣然打听“红包”，她会带给您想不到的惊喜。\n"NOR);
        set("shen_type", 1);
        set("combat_exp", 1000000);
        set("str", 30);
        set("dex", 30);
        set("con", 30);
        set("int", 30);
        set("per", 30);
        set("attitude", "friendly");
        set("max_qi", 100000);
        set("neili", 100000);
        set("max_neili", 1000);
        set("score", 100000);

        set("inquiry", ([
            "红包" : (: ask_me :)
        ]));
        setup();
}

string ask_me()
 {
        object me = this_player();
	      object gift;
        mapping fam; 
        
if ((int) me->query("nvergift"))
return HIR"叔叔的脸皮也太厚了吧！嫣然记得叔叔已经拿过礼物了......"NOR;
               else
        {
			gift=new("/u/dream/nvergift");
			gift->move(me);
      me->set("nvergift", 1);
return me->query("name")+"叔叔,谢谢你~~~~~ \n";
         }
}


