#include <ansi.h>
inherit ITEM;


void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIR "喜糖" NOR, ({ "xi tang", "xitang" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", HIM "这是天下无雪女儿出世时发放给大家的喜糖，敬请笑纳。\n" NOR);
  }
}
int do_eat(string arg) {
  string *skills;
  mapping all_skills;
  int i;
  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  else {
    all_skills = this_player()->query_skills();
    if (!sizeof(all_skills))
      message_vision(HIM "$N吃下一颗天下无雪女儿出世时发的喜糖，不过没有什么感觉。\n" NOR, this_player());
    else {
      skills = keys(all_skills);
      for (i = 0; i < sizeof(skills); i++)
        this_player()->set_skill(skills[i], all_skills[skills[i]] + 1);
    }
    message_vision(HIM "$N吃下一颗天下无雪女儿出世时发的喜糖，感觉甜丝丝的。\n" NOR, this_player());
    log_file("nosave/EAT_XITANG",
      sprintf("%s 吃了天下无雪女儿出世时发的喜糖 %s\n", this_player()->query("id"), ctime(time())));
    destruct(this_object());
    return 1;
  }
}
