#include <ansi.h>
inherit NPC;
string ask_me();

void create()
{
        set_name(HIW"礼物发放使者"NOR, ({ "shizhe", "shi" }) );
        set("nickname", HIR"天下无雪"NOR);
        set("gender", "女性" );
        set("age", 2);
        set("long", YEL"这是天下无雪的礼物发放使者.向她打听“礼物”，她会带给您想不到的惊喜。\n"NOR);
        set("shen_type", 1);
        set("combat_exp", 1000000);
        set("str", 30);
        set("dex", 30);
        set("con", 30);
        set("int", 30);
        set("per", 30);
        set("attitude", "friendly");
        set("max_qi", 100000);
        set("neili", 100000);
        set("max_neili", 1000);
        set("score", 100000);

        set("inquiry", ([
            "礼物" : (: ask_me :)
        ]));
        setup();
}

string ask_me()
 {
        object me = this_player();
	      object gift;
        mapping fam; 
        
if ((int) me->query("guoqinggift"))
return HIR"靠！真不知道怎么说你好!......"NOR;
               else
        {
			gift=new("/u/dream/dangao");
			gift->move(me);
      me->set("guoqinggift", 1);
return me->query("name")+"你要加油阿~~~~~ \n";
         }
}


