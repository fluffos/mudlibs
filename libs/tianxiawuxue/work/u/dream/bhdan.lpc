//返身丹.c  
// by hhm 2006/4/26

#include <ansi.h>
inherit ITEM;
void setup()
{}
void init()
{
        add_action("do_eat", "eat");
}
void create()
{
        set_name(HIR"返身丹"NOR, ({"fanshen dan","bhdan", "dan"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "颗");
               set("long", HIR"这是一颗晶莹火红的仙丹，\n"
                               "如果你误入歧途的话，可以用来脱离帮派，\n"
                               "获得自由新生!\n"NOR);
                set("value", 10000000);
        }
        setup();
}

int do_eat(string arg)
{
        int fw;
        object me = this_player();
        if (!id(arg))
        return notify_fail("你要吃什么？\n");
        me->delete("bh");
        me->delete("bh_rank");
        me->delete("bangpaijc");
        me->delete("banghui");
        me->delete("party");
        me->add("potential",-10000);
        me->add("combat_exp",-50000); 
        message_vision(HIR"$N吃下一颗仙丹，顿时觉得前途一片光明！\n"NOR,me);
        destruct(this_object());
        return 1;
}
