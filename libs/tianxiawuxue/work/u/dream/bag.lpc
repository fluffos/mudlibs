//bag.c 天下无雪偷懒的工具
//@txwx by hhm 2005/6/5

#include <ansi.h>
inherit ITEM;
void create()
{
        set_name(HIR "天下无雪的神秘口袋" NOR, ({ "bag" }) );         
        set_weight(30);
        if( clonep() )
                set_default_object(__FILE__);
        else{
        set("unit", "个");
        set("long", HIY"这是天下无雪专门用来放各种宝贝的袋子。
里面有：
        (JIAN)
        (DAO)
        (JIA)
        (DAN)
        (GIFT)   
\n"NOR);
        set("material","wood");
        set("no_get",1);
        set("no_give",1);
        set("no_drop",1);
        }
        setup();
}
void init()
{
    add_action("do_get",({"get","na"}));
}

int do_get(string arg)
{
  object me,ob;
  string arg1,arg2;
  me=this_player();
  if(!arg || sscanf(arg, "%s from %s", arg1, arg2)!=2)
   return notify_fail("命令格式: get <物品名称> from bag。\n");
  if (arg2!="bag")
     return notify_fail("命令格式: get <物品名称> from bag。\n");
//  if(present(arg1, me) || present(arg1, environment()))
//   return notify_fail("已经有这样东西了。\n");
    switch (arg1){
          case "jian": ob=new("/d/yuanyue/npc/obj/shenjian"); break;             
          case "dao": ob=new("/d/yuanyue/npc/obj/wandao"); break;   
          case "gold": ob=new("/clone/money/100gold"); break;   
          case "dan1": ob=new("/u/dream/dream-dan"); break;   
          case "qsdan": ob=new("/clone/drug/qingshendan"); break;  
          case "dan": ob=new("/d/city/npc/obj/xiandan"); break;  
          case "gift": ob=new("/u/dream/gift-dream"); break;    
          case "jia": ob=new("/d/12gong/npc/obj/gold_cloth"); break;         
          default :
                 return notify_fail("没有这个东西。\n");
          }
     if(ob) ob->move(me);
       message_vision(HIG"$N从口袋里掏了半天,终于掏出了$n。\n"NOR,me, ob);  
       return 1;
}

