#include <ansi.h>
inherit ITEM;


void init()
{
        add_action("do_eat", "eat");
}

void create()
{
        set_name(HIR "元旦礼物" NOR, ({"yuandan liwu", "gift"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "颗");
                set("long", HIM "元旦礼物，代表巫师的一点心意。\n" NOR);
        }
}
int do_eat(string arg)
{
        if (! id(arg))
             return notify_fail("你要吃什么？\n");
             
        if ((int)this_player()->query("gifter/yuandan"))
        {
                tell_object(this_player(), HIR "你已经吃过礼物了，还想再吃，就不怕被杀档？！\n" NOR);
                return 1;
        } else
        {
                message_vision(HIM "$N吃下一颗巫师元旦时候发的礼物。\n" NOR, this_player());
                this_player()->set("gifter/yuandan", 1);
                this_player()->add("int", 2);
                this_player()->add("con", 2);
                this_player()->add("dex", 2);
                this_player()->add("str", 2);
                destruct(this_object());
                return 1;
        }
}

int query_autoload() { return 1; } 
