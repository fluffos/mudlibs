// 还魂丹

#include <ansi.h>

inherit ITEM;

int do_eat(string);
void init();

void init()
{
  if (!wizardp(this_player())) {
    set("no_get","你手里一松，还魂丹从指间滑落！\n");
    set("no_give","这么珍贵的药，哪能随便给人？\n");
    set("no_drop","这么宝贵的丹药，扔了多可惜呀！\n");
    set("no_sell","凡人哪里知道"+this_object()->query("name")+"的价值？还是自己留着吧。\n");
  }
  add_action("do_eat", "eat");
}

void create()
{
set_name( HIR "聪明丸" NOR , ({"dream-dan", "dan"}))
;


  set_weight(90);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", HIW"一颗金黄色的丹丸，略微能闻到些许香气。这是天下无雪特地为对本mud发展有贡献的人所作的奖励丹!\n"NOR);
    set("value", 0);
    set("drug_type", "补品");
  }
  set("is_monitored",1);
  setup();
}

int do_eat(string arg)
{
	if (!id(arg))
	return notify_fail("你要吃什么？\n");
this_player()->add_skill("literate", 111)
;
message_vision("$N吃下一颗聪明丸，只觉得自己聪明了许多!\n", this_player())
;
	destruct(this_object());
	return 1;
}
