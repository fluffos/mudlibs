//u/dream/shizhe.c 礼物发放使者
//@ txwx by hhm
//2005.9.30

#include <ansi.h>
inherit NPC;
string ask_me();

void create() {
  set_name(HIR "补偿使者" NOR, ({ "BUCHANG shizhe", "shizhe", "BUCHANG" }));
  set("gender", "女性");
  set("nickname", HIW "天下无雪" NOR);
  set("age", 20);
  set("long", YEL "由于这次转服务器给大家造成了一定的损失,
                        wiz组决定对玩家一定的补偿。
                        清向使者大厅有关 补偿 的问题.\n" NOR);
  set("shen_type", 1);

  set("attitude", "friendly");
  set("inquiry", ([
    "补偿": (: ask_me :)
  ]));
  setup();
}

string ask_me() {
  object me = this_player();
  object gift;
  mapping fam;
  if ((int)me->query("gift/buchang"))
    return HIR "靠！真不知道怎么说你好!......" NOR;
  else {
    gift = new("/u/dream/gift/dabudan");
    gift->move(me);
    me->set("gift/buchang", 1);
    return me->query("name") + "谢谢你对天下无雪MUD的支持,WIZ在次表示歉意!!! \n";
  }
}
