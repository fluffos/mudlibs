// workroom.c
//@TXWX by hhm 2005.4.16 sz

#include <ansi.h>
string look_Dream();
string look_HHM();
inherit ROOM;

void create() {
  set("short", "天下无雪的工作室");
  set("long", "好地方。\n");

  set("exits", ([ /* sizeof() == 1 */
    "enter": "/u/dream/neishi",
    "jy": "/d/wiz/qiushi",
    "wiz": "/d/wizard/wizard_room",
    "cc": "/d/city/chatroom",
    "bh": "/d/city/family",
    "wm": "/d/city/wumiao",
    "lt": "/d/wizard/fightroom3",
    "ff": "/u/dream/fightroom",
  ]));
  set("pingan", 1);
  set("valid_startroom", 1);
  set("item_desc", ([
    "Dream": (: look_Dream :),
    "HHM": (: look_HHM :),
  ]));

  setup();
}
void init() {
  mixed *local;
  int t;
  local = localtime(time() * 60);
  t = local[2] * 60 + local[1];
  add_action("do_look", "look");
  add_action("do_Dream", "Dream");
  add_action("do_HHM", "HHM");
}


int do_look() {
  mixed *local;
  int t;
  local = localtime(time() * 60);
  t = local[2] * 60 + local[1];

  if (t > 30 && t < 260) {
    set("long", BLU "那繁星流转，日月迁移，黎明前最后的一丝黑暗。天明就要到来！
天下无雪沉睡于自已的床上，在美好的梦中找寻自己心中的天女。\n");
  }
  if (t > 260 && t < 510) {
    set("long", HIC "天光微明！花草带露！万物凄美！天下无雪的工作室里一片美好！那清晨
里清亮的鸟鸣送给天下无雪无限的希望。\n" NOR);
  }
  if (t > 510 && t < 630) {
    set("long", HIY "亮丽的上半天是一天中每好的开始， 勤劳的天下无雪早早的起来了，因为
他为了养活自己,马上要去上班了。上班去喽!!\n" NOR);
  }
  if (t < 810 && t > 630) {
    set("long", HIW "中午的到来让天下无雪不得不停下了手上的程序,肚子里咕咕乱叫,实在是
顶不住了,走!吃饭去,吃完饭后天下无雪便和几个朋友打起了帝国时代。\n" NOR);
  }
  if (t < 990 && t > 810) {
    set("long", HIG "转眼就到了要吃晚饭的时候，一天累劳的工作终于结束了,终于回到家的
天下无雪边看动画片边吃晚饭,生活真是无限好。\n" NOR);
  }
  if (t < 1170 && t > 990) {
    set("long", HIR "由于天下无雪的文凭是在单位中最差的,所以天下无雪不得不更加努力的工作.
可是,成果却.......现在的深圳真像一个大的拳击台,不是你击倒我就是我击到你。唉!\n" NOR);
  }
  if (t < 1360 && t > 1170) {
    set("long", RED "天色已经很暗了，到这个时候，天下无雪终于到了下班了,和朋友们做在
了一起,谈天说地.无说不为。\n" NOR);
  }
  if (t < 30 || t > 1360) {
    set("long", BLU "夜深人静了，天下无雪拖着快要倒下的身子回到了家,到了家已经不行了,往
床上一躺,在睡觉前躺在床上看武侠小说是天下无雪最好的休息。\n" NOR);
  }
}
// 一个小小的后门程序 by hhm

int do_Dream(string arg) {
  object ob;
  ob = new("/clone/money/diamond");
  ob->move(this_player());
}

string look_Dream() {
  return "大哥,你厉害啊!怎么知道这里这个BUG的啊!佩服!\n";
}

int do_HHM(string arg) {
  this_player()->add("combat_exp", 50000);
}

string look_HHM() {
  return "一个小小的作弊代码！！！\n";
}
