//转世NPC

#include <ansi.h>
inherit NPC;

string ask_zhuan();

void create()
{
        set_name(RED"三太子"NOR, ({ "san taizi", "taizi" }) );

        set("long",
        "一位年纪轻轻的天神，他就是负责评定转世的神仙，要查看自己有没有资格专事就找他吧。\n");
        set("attitude", "peaceful");
        set("age", 12);
        set("combat_exp", 10000000);
        set("max_jing", 100000);
        set("max_qi", 100000);
        set("max_neili",100000);
        set_skill("dodge", 500);
        set_skill("parry", 500);
        set_skill("unarmed", 500);
        set_temp("apply/armor", 500);
        set_temp("apply/damage", 500);
        
        set("inquiry", ([
                        
               "转世"     : (: ask_zhuan :),
        ]));
        
        setup();
        carry_object("/clone/misc/cloth")->wear();
}                           


string ask_zhuan()
{
      object me = this_player();
      
               if((int)me->query_skill("force", 1) < 5000){
               command("say " + RANK_D->query_respect(me)+"是否还应该先在内功上多下点功夫？");
                return;
                }   
                if((int)me->query_skill("blade", 1) < 5000) {               
                command("say " + RANK_D->query_respect(me)+"是否还应该先在基本刀法上多下点功夫？");
                return;
                }   
                if((int)me->query_skill("sword", 1) < 5000) {
                command("say " + RANK_D->query_respect(me)+"是否还应该先在基本剑法上多下点功夫？");
                return;
                }   
                if((int)me->query_skill("parry", 1) < 5000) {             
                command("say " + RANK_D->query_respect(me)+"是否还应该先在基本招架上多下点功夫？");
                return;
                }   
                if((int)me->query_skill("unarmed", 1) <5000) {              
                command("say " + RANK_D->query_respect(me)+"是否还应该先在基本拳脚上多下点功夫？");
                return;
                }   
                if((int)me->query_skill("dodge", 1) < 5000) {
                command("say " + RANK_D->query_respect(me)+"是否还应该先在基本轻功上多下点功夫？");
                return;
                }   
                if((int)me->query_skill("taoism", 1) < 5000) {              
                command("say " + RANK_D->query_respect(me)+"是否还应该先在道学心法上多下点功夫？");
                return;
                }   
                if((int)me->query_skill("literate", 1) < 4500) {
                command("say " + RANK_D->query_respect(me)+"是否还应该先在读书写字上多下点功夫？");
                return;
                }   
                 if((int)me->query("age", 1) < 24) {
                command("say " + RANK_D->query_respect(me)+"太年轻了，好好磨练一下再来吧！");
                return;
                }   
                
                if ((int)me->query("combat_exp") < 1000000000 ||(int)me->query("potential") < 200000000 ) 
        {
               command("say " + RANK_D->query_respect(me)+"经验和潜力不够，强求亦是枉然!");
                return;
                          
        }  
        command("say 既然如此，我就成全你了！");        
        message_vision(RED"三太子右手向$N一指,$N便觉得天昏地暗，立刻转换到了另一个空间.......\n"NOR,me);
        command("rumor 哎......"+ me->name() +"开始转世投胎了！");
        me->delete_temp("lygm");
        me->move("/u/dream/zhuanshi/difu");    
        me->delete_temp("difu");
        return "你就放心的走吧!\n";
}
