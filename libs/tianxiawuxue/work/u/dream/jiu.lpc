// /u/dream/jiu.c
// hhm 2005.7.13

inherit ITEM;
#include <ansi.h>;
int do_drink(string arg);

string *name = ({ "竹叶青", "茅台", "女儿红", "稻花香", "五酿液", "枝江大曲" });
string replace_color(string arg) {
  switch (arg) {
    case "竹叶青": return HIW "竹叶青" NOR;
    case "茅台": return CYN "茅台" NOR;
    case "女儿红": return HIR "女儿红" NOR;
    case "稻花香": return HIY "稻花香" NOR;
    case "枝江大曲": return HIG "枝江大曲" NOR;
    case "五酿液": return HIB "五酿液" NOR;
  }
}
void create() {
  int i = random(sizeof(name));
  string name = name[i];
  set_name(replace_color(name), ({ "jiu" }));
  set("names", name);
  set_weight(200);
  set("unit", "瓶");
  set("no_give", 1);
  set("no_get", 1);
  set("no_drop", 1);
  set("long", "一瓶" + replace_color(name) + "，可以喝（drink）\n");
  set("value", 2000);
}
void init() {
  add_action("do_drink", "drink");
}
int do_drink(string arg) {
  object me;
  object ob = this_object();

  me = this_player();
  if (!arg || (arg != "jiu" && arg != ob->query("names"))) return 0;
  if (!me->query_temp("marks/drinking")) {
    me->set_temp("marks/drinking", 1);
    message_vision(YEL "$N拿起一瓶" NOR + ob->name()
      +YEL "，对着嘴，大口大口的喝了起来。\n" NOR, me);
    remove_call_out("select_msg");
    call_out("select_msg", 10, me);
    return 1;
  }
  return notify_fail("");
}
void select_msg(object me) {
  remove_call_out("do_msg");
  call_out("do_msg", 10, me);
}
void do_msg(object me) {
  object ob = this_object();
  switch (random(4)) {
    case 0:
      message_vision(YEL "$N翘起二郎腿，眯上眼睛，猛喝了一口" + ob->name()
        +YEL "，自言自语道：“这东西害人又害己，为啥我还那么喜欢？”\n" NOR, me);
      break;
    case 1:
      message_vision(YEL "$N吐出一串酒泡泡oоＯ◎，看着它悠闲的散开。\n" NOR, me);
      break;
    case 2:
      message_vision(YEL "$N喝了一口" + ob->name()
        +YEL "，大概是喝得太猛了，一张脸涨得通红。\n" NOR, me);
      break;
    case 3:
      message_vision(YEL "$N喝了一口" + ob->name()
        +YEL "，摇头晃脑地说道：“饭前一口酒，赛过活神仙。”\n" NOR, me);
      break;
  }
  ob->add_temp("drinked", 1);
  if (ob->query_temp("drinked") >= 6 && random(3) >= 2)
    call_out("finish_smoke", 10, me);
  else {
    remove_call_out("select_msg");
    call_out("select_msg", 0, me);
  }
}
void finish_smoke(object me) {
  message_vision(HIR "$N猛喝了一口剩下的一滴酒，两个手不由自主地又去模酒瓶。\n" NOR, me);
  me->delete_temp("marks/smoking");
  destruct(this_object());
  return;
}
