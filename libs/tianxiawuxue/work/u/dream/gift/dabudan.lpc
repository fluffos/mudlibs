#include <ansi.h>
inherit ITEM;



void init() {
  if (!wizardp(this_player())) {
    set("no_get", "这颗大补丹已经掉在地上摔了个乱七八糟。\n");
    set("no_give", "大补丹可不多，留着自己吃吧。\n");
    set("no_drop", "不是吧！这可是的dream苦心做的哦，丢了乱可惜的\n");
    set("no_sell", "神的礼物，小的不敢收。\n");
    set("no_put", "大补丹不能压的，还是别放进去了。\n");
    set("no_steal", "这也要偷，太无耻了吧。\n");
  }
  if (this_player() == environment())
    add_action("do_eat", "eat");

}

void create() {
  set_name(HIY "大补丹" NOR, ({ "dabu dan", "dan" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "这是Dream为感谢大家的支持,同时也为了
     这次服务器事件对大家而造成的损失表示
     歉意和补偿而制作的礼物,快吃(eat)了吧。^_^\n");
    set("unit", "颗");
  }
  setup();
}

int do_eat(string arg) {
  object me = this_player();
  string *skills;
  mapping all_skills;
  int i;

  if (me->query("buchang2", 1))
    return notify_fail(HIR "沒有了,不能再吃了!\n" NOR);
  if (!id(arg))
    return notify_fail("你要吃什么药？\n");
  else {
    all_skills = this_player()->query_skills();
    if (!sizeof(all_skills)) destruct(this_object());
    skills = keys(all_skills);
    for (i = 0; i < sizeof(skills); i++)
      me->set_skill(skills[i], all_skills[skills[i]] + 100);
    me->add("potential", 1000000);
    me->add("combat_exp", 2000000);
    me->add("max_neili", 10000);
    me->add("max_jingli", 10000);
    me->set("buchang2", 1);
    tell_object(me, HIW "你得到了天下无雪wiz组给的补偿：\n" +
      "一百万点潜能\n" +
      "二百万点经验\n" +
      "各项SKILL添加一百级\n" +
      "一万点内力和精力\n" + NOR);
    message_vision(HIW "$N吃下一颗大补丹,心中的气愤才稍稍消了些。\n" NOR, this_player());
    destruct(this_object());
    return 1;
  }
}
