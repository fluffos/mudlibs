//b-cloth.c
// beyond 以彼之道，还彼之身
#include <ansi.h>
#include <armor.h>

inherit ARMOR;

void create()
{
        set_name(HIR"生化机械装甲"NOR, ({ "dongli jia", "jia" }) );
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
  set("long", "这是一件由人类探索外太空所发现的一套由不知名的物质所组成的装甲，看上去坚不可催。\n");
  set("unit", "件");
  set("value", 9000);
  set("material", "armor");
set("armor_prop/armor", 20000);
  set("armor_prop/personality", 7200);
set("wear_msg", "只见$N威武的穿上一件"+"$n"NOR+"。\n");
                set("unequip_msg", "$N将身上的"+"$n"NOR+"脱了下来。\n");
        }
        setup();
}
int query_autoload()
{
return 1;
}
#include "/kungfu/skill/eff_msg.h";
int ob_hit(object ob, object me, int damage)
{
        object weapon = ob->query_temp("weapon");
        int p;
        string msg;
        if(!weapon) {
            msg = "只听“啊哟”一声惊呼，$N正好打在生化机械装甲上，一阵强大的电流传了过来，顿时疼得手脚发麻！\n";
            ob->receive_damage("qi", damage/5);
            ob->receive_wound("qi", damage/5);
            p = (int)ob->query("qi")*100/(int)ob->query("max_qi");
            msg += "( $N"+eff_status_msg(p)+" )\n";
            message_vision(msg, ob);
            return -damage/2;
         }        
}

