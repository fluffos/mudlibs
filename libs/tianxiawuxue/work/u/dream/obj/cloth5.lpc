//b-cloth.c
// beyond 以彼之道，还彼之身
#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create() {
  set_name(MAG "真空棉保暖内衣" NOR, ({ "neiyi", "yi" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "看着这件内衣你不由得想起了一句老诗：慈母手中线，游子身上衣。\n");
    set("unit", "件");
    set("value", 9000);
    set("material", "cloth");
    set("armor_prop/armor", 20000);
    set("armor_prop/personality", 7200);
    set("wear_msg", "只见$N小心的穿上一件" + "$n" NOR + "。\n");
    set("unequip_msg", "$N将身上的" + "$n" NOR + "轻轻的脱了下来。\n");
  }
  setup();
}
int query_autoload() {
  return 1;
}
