//b-cloth.c
// beyond 以彼之道，还彼之身
#include <ansi.h>
#include <armor.h>

inherit NECK;

void create()
{
        set_name(HIW"紫色水晶项链"NOR, ({ "xianglian", "lian" }) );
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
  set("long", "看着它你仿佛有回到了以前和她度过的快乐时光。\n");
  set("unit", "串");
  set("value", 9000);
  set("material", "cloth");
set("armor_prop/armor", 20000);
  set("armor_prop/personality", 7200);
set("wear_msg", "只见$N小心的戴上一件"+"$n"NOR+"。\n");
                set("unequip_msg", "$N将脖子上的"+"$n"NOR+"轻轻的取了下来。\n");
        }
        setup();
}
int query_autoload()
{
return 1;
}

