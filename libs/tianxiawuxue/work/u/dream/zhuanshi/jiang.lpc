//转世NPC

#include <ansi.h>
inherit NPC;
string ask_zhuan();

void create() {
  set_name(HIR "姜子牙" NOR, ({ "jiang ziya", "jiang", "ziya" }));

  set("long",
    "一位慈祥和蔼的老人家，他就是负责封神的神仙，投胎转世就找他吧。\n");
  set("attitude", "peaceful");
  set("nickname", HIG "封神天神" NOR);
  set("age", 1200);
  set("combat_exp", 10000000);
  set("max_jing", 100000);
  set("max_qi", 100000);
  set("max_neili", 100000);
  set_skill("dodge", 500);
  set_skill("parry", 500);
  set_skill("unarmed", 500);
  set_temp("apply/armor", 500);
  set_temp("apply/damage", 500);
  set("inquiry", ([

    "转世": (: ask_zhuan :),
  ]));

  setup();
  carry_object("/clone/misc/cloth")->wear();
}


string ask_zhuan() {
  object me = this_player();

  if ((int)me->query_skill("force", 1) < 2500) {
    command("say " + RANK_D->query_respect(me) + "是否还应该先在内功上多下点功夫？");
    return;
  }
  if ((int)me->query_skill("blade", 1) < 2500) {
    command("say " + RANK_D->query_respect(me) + "是否还应该先在基本刀法上多下点功夫？");
    return;
  }
  if ((int)me->query_skill("sword", 1) < 2500) {
    command("say " + RANK_D->query_respect(me) + "是否还应该先在基本剑法上多下点功夫？");
    return;
  }
  if ((int)me->query_skill("parry", 1) < 2500) {
    command("say " + RANK_D->query_respect(me) + "是否还应该先在基本招架上多下点功夫？");
    return;
  }
  if ((int)me->query_skill("unarmed", 1) < 2500) {
    command("say " + RANK_D->query_respect(me) + "是否还应该先在基本拳脚上多下点功夫？");
    return;
  }
  if ((int)me->query_skill("dodge", 1) < 2500) {
    command("say " + RANK_D->query_respect(me) + "是否还应该先在基本轻功上多下点功夫？");
    return;
  }
  if ((int)me->query_skill("taoism", 1) < 2000) {
    command("say " + RANK_D->query_respect(me) + "是否还应该先在道学心法上多下点功夫？");
    return;
  }
  if ((int)me->query_skill("literate", 1) < 3500) {
    command("say " + RANK_D->query_respect(me) + "是否还应该先在读书写字上多下点功夫？");
    return;
  }
  if ((int)me->query("age", 1) < 36) {
    command("say " + RANK_D->query_respect(me) + "太年轻了，好好磨练一下再来吧！");
    return;
  }

  if ((int)me->query("zhuanshiok", 1) > 1) {
    command("say " + RANK_D->query_respect(me) + " 你已经转过世了,真的想死吗?");
    return;
  }

  if ((int)me->query("combat_exp") < 600000000 || (int)me->query("potential") < 200000000) {
    command("say " + RANK_D->query_respect(me) + "经验和潜力不够，强求亦是枉然!");
    return;

  }
  command("say 既然如此，我就成全你了！");
  message_vision(RED "姜子牙右手向$N一指,$N便觉得天昏地暗，立刻转换到了另一个空间.......\n" NOR, me);
  command("rumor 哎......" + me->name() + "开始转世投胎了！");
  me->set("HellZhenPass", 1);
  me->move("/u/dream/zhuanshi/difu");
  return "你就放心的走吧!\n";
}
