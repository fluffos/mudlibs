//agedan.c  
// by hhm 2005/9/30

#include <ansi.h>
inherit ITEM;
void setup() {}
void init() {
  add_action("do_eat", "eat");
}
void create() {
  set_name(HIR "返老还童丹" NOR, ({ "xian dan", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", HIR "这是一颗晶莹火红的仙丹，天下无雪从天庭偷来得!\n" NOR);
    set("value", 10000000);
  }
  setup();
}

int do_eat(string arg) {
  int fw;
  object me = this_player();
  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  if (me->query("age") < 36)
    return notify_fail("你年纪那么小不需要吃吧。!");
  me->add("age", -1);
  me->add("mud_age", -86400 * 1);
  me->save();
  message_vision(HIW "$N吃下一颗仙丹，顿时觉得年轻了不少！\n" NOR, me);
  destruct(this_object());
  return 1;
}
