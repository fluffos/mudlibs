void init() {
  object me = this_player();
  //        add_action("do_action", "");

  add_action("do_play", "listen");
  add_action("do_play", "听");
}


int do_action(string arg) {
  object me, *ob, ob1;
  int i;
  me = this_player();
  ob = all_inventory(environment(me));
  if (this_player()->query("id") != "lonely") {
    string action = query_verb();

    switch (action) {

      case "kill":
      case "fight":
        write(HIW "这里是黑客的房间，请不要惹黑客不快。\n" NOR);
        return 1;
    }
  }
  if (arg != "")

  {
    for (i = 0; i < sizeof(ob); i++) {
      ob1 = query_snoop(ob[i]);
      if (!living(ob[i])) continue;
      if (objectp(ob1)) {
        snoop(ob1);
        tell_object(ob[i], HIW + ob1->name(1) + "对你的窃听被中止。\n" NOR);
      }
    }
  }
  return 0;
}

int do_play() {
  object me;
  me = this_player();

  message_vision(CYN "四周灯光闪动，舞台慢慢旋转，音响里响起了音乐!”\n\n", me);

  call_out("over", 3, me, 0);

  return 1;
}

int over(object me, int stage) {
  object room;

  tell_object(me, around_msg[stage]);
  if (++stage < sizeof(around_msg)) {
    call_out("over", 3, me, stage);
    return 1;
  } else
    me->reincarnate();

  message_vision(CYN "灯光慢慢暗淡下来，舞台停止了旋转。\n", me);

}
