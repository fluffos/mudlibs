// zuolengchan.c 左冷禅
// knightly
// 2006.5

inherit NPC;
inherit F_MASTER;
#include <ansi.h>;
int ask_skill1(string str);
int ask_skill2(string str);
void create() {
  set_name("左冷禅", ({ "zuo lengchan", "zuo" }));
  set("title", HIR "五岳剑派盟主" HIY "嵩山派第十三掌门" NOR);
  set("gender", "男性");
  set("class", "swordsman");
  set("age", 55);
  set("attitude", "peaceful");
  set("str", 26);
  set("con", 30);
  set("dex", 30);
  set("int", 28);
  set("per", 28);

  set("neili", 300000);
  set("max_neili", 150000);
  set("jiali", 300);
  set("max_qi", 180000);
  set("jing", 145000);
  set("max_jing", 145000);
  set("combat_exp", 220000000);
  set("shen", 0);

  set("inquiry", ([
    "剑法精髓": (: ask_skill1 :),
    "最高境界": (: ask_skill2 :),
  ]));

  set("chat_chance", 10);
  set("chat_msg", ({
    "左冷禅说道：五岳合并是我最大的心愿。\n",
    "左冷禅说道：听说岳不群的紫霞神功已有大成，看来不可小觑。\n",
    "左冷禅说道：据闻岳不群夺得了辟邪剑谱，不知道是不是真的。\n",
    "左冷禅说道：只有真正效忠我的人才可以承传我的衣钵。\n",
  }));

  set_skill("literate", 2500);
  set_skill("unarmed", 2000);
  set_skill("hand", 2000);
  set_skill("sword", 2500);
  set_skill("force", 2500);
  set_skill("parry", 2500);
  set_skill("dodge", 2500);
  set_skill("songshan-sword", 2500);
  set_skill("lingxu-bu", 2500);
  set_skill("dasongyang-shou", 2000);
  set_skill("hanbing-zhenqi", 2500);

  map_skill("force", "hanbing-zhenqi");
  map_skill("sword", "songshan-sword");
  map_skill("parry", "songshan-sword");
  map_skill("hand", "dasongyang-shou");
  map_skill("dodge", "hanbing-zhenqi");

  create_family("嵩山派", 13, "掌门");
  setup();

  //        carry_object("/clone/weapon/changjian")->wield();
  /*
        carry_object("/d/songshan/obj/guanri-jian")->wield();
        carry_object("/clone/cloth/cloth")->wear();
        carry_object("/d/songshan/obj/mengzhuling")->wear();
*/
}

void init() {

  object room;
  int sword, ling;

  ::init();

  room = environment(this_object());

  sword = (int)room->query("canload_guanrijian");
  ling = (int)room->query("canload_zuoling");

  carry_object("/clone/cloth/cloth")->wear();

  if (sword == 1) {
    set_temp("nosword", 0);
    carry_object("/d/songshan/obj/guanri-jian")->wield();
  } else {
    set_temp("nosword", 1);
    carry_object("/clone/weapon/changjian")->wield();
  }

  if (ling == 1) {
    carry_object("/d/songshan/obj/mengzhuling")->wear();
  }
}

void attempt_apprentice(object ob) {
  int fmcount;

  mapping fam = ob->query("family");
  fmcount = (int)ob->query("familyjob/songshan/count");

  if (ob->query("gender") != "男性") {
    command("say 我可只收男徒.");
    return;
  }
  if (!fam || fam["family_name"] != "嵩山派") {
    command("say " + RANK_D->query_respect(ob) + "与本门素无来往，不知此话从何谈起？");
    return;
  }
  if ((int)ob->query_skill("force", 1) < 1500) {
    command("say 内功是嵩山派武功之基础。");
    command("say " + RANK_D->query_respect(ob) + "是否还应该先在内功上多下点功夫？");
    return;
  }
  if ((int)ob->query_int() < 30) {
    command("say 我的武功都要极高的悟性才能学会。");
    command("say 要能达到炉火纯青之境，体质什么的倒是无关紧要，悟性却是半点也马虎不得。");
    command("say " + RANK_D->query_respect(ob) + "的悟性还大有潜力可挖，还是请回吧。");
    return;
  }
  if ((int)ob->query_skill("hanbing-zhenqi", 1) < 1000) {
    command("say 寒冰真气是我派行走江湖的根本所在。");
    command("say 要想铲奸除恶,真才实学却是半点也马虎不得。");
    command("say " + RANK_D->query_respect(ob) + "的基础武功没有学会，还是请回吧。");
    return;
  }
  if ((int)ob->query("kar", 1) < 30) {
    command("say " + RANK_D->query_respect(ob) + "虽然是个人才，却与我无缘，可惜可惜。");
    command("sigh");
    return;
  }
  if (fmcount < 500) {
    if (ob->query("id") != "knightly") {
      command("say " + RANK_D->query_respect(ob) + "对本门的心意似乎不够啊。");
      return;
    }
  }

  command("say 嗯，看你还是个学武的料，我就收下你吧！");
  command("chat 嵩山派武功重现江湖，" + ob->name() + "，五岳合并的伟业你要多费心了！");
  command("chat* addoil " + ob->query("id"));
  command("recruit " + ob->query("id"));
  ob->add("title", HIB "【左冷禅嫡传门人】" NOR);
  ob->set("class", "sworder");
}

int accept_object(object me, object ob) {
  if ((string)ob->name() == MAG "紫霞密芨" NOR && ob->id() == "zixia_book") {
    command("say 嗯，难得你这么用心，我很喜欢，关于嵩山剑法的几个要领我再给你讲讲吧！");
    me->set_temp("canaskzuoskill1", 1);
    return 1;
  } else {
    command("say 这是什么东西，快拿走！");
    return 1;
  }
}

int ask_skill1(string arg) {
  object me;
  object zuo;

  zuo = this_object();
  me = this_player();

  if (me->query_temp("shzuocanpfm1", 1)) {
    command("say 我不是已经指点过你了吗？");
    return 1;
  }

  if (me->query_temp("canaskzuoskill1", 1)) {
    command("say 好吧，现在我就对你指点一二。");
    me->set_temp("shzuocanpfm1", 1);
  }
}

int ask_skill2(string arg) {
  object me;
  object zuo;

  zuo = this_object();
  me = this_player();

  if (me->query("spskill/shzuocanpfm2", 1)) {
    command("say 我不是已经指点过你了吗？");
    return 1;
  }

  if (me->query_temp("canaskzuoskill2", 1)) {
    command("say 好吧，现在我就对你指点一二。");
    me->set("spskill/shzuocanpfm2", 1);
  }
}
