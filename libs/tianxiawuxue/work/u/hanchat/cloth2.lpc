// cloth.c

#include <armor.h>

inherit CLOTH;

void create() {
  set_name(HIW "生日服" NOR, ({ "birth_cloth" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "cloth");
    set("armor_prop/armor", 10000);
  }
  setup();
}

void init() {
  add_action("do_hhh", "mybirth");
}


int do_hhh(string arg) {
  object me = this_player();
  object ob;
  int j, time;
  time = (int)me->query("birthday") ? (int)me->query("birthday") : time() - me->query("age") * 86400;
  write(cntime(time));

  return 1;

}
