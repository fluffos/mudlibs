//Room of wizard that haven't modify own workroom.
//Modify by Super 1998.1.2

inherit ROOM;

void create()
{
set("short","SIR的工作室");


        set("long",@LONG
这里是SIR的临时住处，这里的设备非常简单，
只有一些常用物品。
LONG );
        set("exits",([ /* sizeof() == 1 */
                "gc":"/d/city/guangchang",
                "down" : "/d/city/chatroom",
                "north":"/d/wizard/wizard_room" ]));
        set("valid_startroom", 1);
         set("freeze",1);
        set("no_fight", "1");
        set("no_clean_up", 0);
        set("objects", ([
                __DIR__"sofa" : 4,
        ]));

        setup();
}
void init()
 {
    if (wizardp(this_player())) return;
      add_action("do_kill","kill");
    add_action("discmds",({"go","fly","quit","conjure","trans"}));
 }
int do_kill()
    {
       message_vision("$N脸色一沉，全身散发出一股浓烈的杀气，\n",this_player());
       return 0;
    }
int valid_leave(object me, string dir)
{
        if( !wizardp(me) )
                return notify_fail("那里只有巫师才能进去。\n");
        return ::valid_leave(me, dir);
}


int discmds()
{
        tell_object(this_player(),"你哪也去不了。\n");
        return 1;
}
