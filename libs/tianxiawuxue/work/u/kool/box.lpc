#include <ansi.h>
inherit ITEM;
void create()
{
    set_name("闲人的百宝箱", ({ "box", "he", "xiang", }) );
    set_weight(300);
    set_max_encumbrance(8000000);
    if( clonep() )
        set_default_object(__FILE__);
    else {
        set("unit", "个");
                set("long", "这是闲人的百宝箱，里面堆满了宝贝。\n");
        set("value", 1000000);
        set("material", "wood");
    }
    setup();
}
void init()
{
    add_action("do_na", "na");
}
int do_na(string arg)
{
    object ob;
    object me = this_player();
    if(arg="fengyunjian") 
    {
       ob=new("/d/city/mingren/npc/obj/fengyunjian");
	ob->move(me);
    }
    if(arg="fengyundao") 
    {
       ob=new("/d/city/mingren/npc/obj/fengyundao");
	ob->move(me);
    }
    if(arg="xuantianjian") 
    {
       ob=new("/d/city/mingren/npc/obj/xuantianjian");
	ob->move(me);
    }
    if(arg="fengyunjian") 
    {
       ob=new("/d/city/mingren/npc/obj/xuantiandao");
	ob->move(me);
    }
    if(arg="fengyunjian") 
    {
       ob=new("/d/city/mingren/npc/obj/fengyunjian");
	ob->move(me);
    }
    if(arg="shengyi") 
    {
       ob=new("/d/12gong/npc/obj/gold_cloth");
	ob->move(me);
    }
    if(arg="gold") 
    {
       ob=new("/clone/money/diamond");
	ob->move(me);
    }
    else
    return notify_fail("你要拿什么东西？\n");
}
