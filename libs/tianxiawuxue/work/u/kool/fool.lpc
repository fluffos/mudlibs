// zhuziliu.c

#include <ansi.h>

inherit NPC;
void create()
{
    set_name("傻瓜", ({"sha gua", "sha", "gua"}));
	set("gender", "男性");
	set("age", 55);
    set("long", "他是一个皮厚肉坚的傻瓜。\n");
 	set("attitude", "peaceful");
	
	set("per", 17);
	set("str", 40);
	set("int", 20);
	set("con", 30);
	set("dex", 25);

    set("qi", 5000000);
    set("max_qi", 5000000);
    set("jing", 5000000);
    set("max_jing", 5000000);
	set("neili", 45000);
	set("max_neili", 4500);
	
	set("combat_exp", 9000000);
     	set_skill("force", 170);
	set_skill("sun-finger", 170);
	set_skill("jinyu-quan", 170);
	set_skill("dodge", 1700);
	set_skill("parry", 170);
       set_skill("unarmed",800);
	
	map_skill("unarmed", "sun-finger");
	map_skill("parry", "sun-finger");
	reincarnate();
	setup();

	
	
}
