#include <ansi.h>
#include <room.h>
inherit ROOM;
void create()
{
        set("short",HIB "Weal的测试室" NOR);
        set("long",@LONG
这里是Weal的测试工作室，闲人勿入
LONG );
         set("exits",([
        "east" : "/d/wizard/wizard_room",
        "down" : "/d/city/chatroom",
          ]));
    setup();
}
void init()
{
        add_action("do_gender", "gender");
        add_action("do_per", "per");
}
int do_gender(string arg)
{

    object me=this_player();
    if (!arg || arg!="male" && arg!="female") return notify_fail("你要变男还是变女？\n");
    if (arg=="male")
    {
    message_vision(HIC"$N变性手术成功，你现在已经是男性了！\n"NOR,me);
    me->set("gender","男性");
    return 1;
    }
    if (arg=="female")
    {
    message_vision(HIC"$N的变性手术非常成功，现在已经是女性了！\n"NOR,me);
    me->set("gender","女性");
    return 1;
    }
}
int do_per(string arg)
{
    object me=this_player();
    if (arg=="mei")
    {
    me->add("per",1);
    message_vision(HIC
    "$N的整容手术非常成功，你变漂亮了！\n"NOR,me);
    return 1;
    }
    if (arg=="hui")
    {
    message_vision(HIC
    "$N的毁容手术非常完美，你变丑了！\n"NOR,me);
    me->add("per",-1);
    return 1;
    }
}
