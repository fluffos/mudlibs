//
inherit BHNPC;
inherit F_BVENDOR;
#include <die.h>
#include <ansi.h>
string query_save_file() { return DATA_DIR + "npc/铁手"; }
void create() {
  set_name(YEL "铁手" NOR, ({ "tie shou", "shou", "tie" }));
  set("long", "人字号杀手。\n");
  this_object()->init_bhnpc();
  set("area_name", "丝绸之路");
  set("ziyuan", "矿石");
  set("jizhi", 25);
  set("kaifa", 21);
  set("area_file", "/d/xingxiu/silk1");
  set("gender", "男性");
  set("age", 38);
  set("str", 700);
  set("per", 30);
  set("con", 700);
  set("int", 700);
  set("dex", 700);
  set("combat_exp", 9000000);
  set("attitude", "peaceful");
  set_skill("force", 1100);
  set_skill("unarmed", 1100);
  set_skill("xianglong-zhang", 1100);
  set_skill("club", 1100);
  set_skill("dodge", 1100);
  set_skill("parry", 1100);
  set_skill("huntian-qigong", 1100);
  set_skill("xiaoyaoyou", 1100);
  set_skill("dagou-bang", 1100);
  set_temp("apply/attack", 60);
  set_temp("apply/defense", 60);
  set_temp("apply/armor", 60);
  set_temp("apply/damage", 60);
  map_skill("force", "huntian-qigong");
  map_skill("unarmed", "xianglong-zhang");
  map_skill("club", "dagou-bang");
  map_skill("parry", "dagou-bang");
  map_skill("dodge", "xiaoyaoyou");
  set("max_qi", 18000);
  set("qi", 18000);
  set("max_neili", 5000);
  set("neili", 5000);
  set("jiali", 150);
  prepare_skill("unarmed", "xianglong-zhang");
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed.jingyian" :),
    (: perform_action, "club.chan" :),
    (: command("unwield tiegun") :),
    (: command("wield tiegun") :),
    (: exert_function, "recover" :),
    (: exert_function, "heal" :),
    (: command("unwield tiegun") :),
    (: command("wield tiegun") :),
  }));
  set("chat_msg", ({
    GRN "铁手 嘿嘿嘿地奸笑了几下，低声对你说：“杀人其实是很好玩的，杀人很刺激的，\n" +
    "如果有一天我下岗了，一定会去当杀人狂，嘿~！嘿~！嘿~！”\n" NOR,
    (: random_move :)
  }));
  setup();
  carry_object("/clone/weapon/tiegun")->wield();
  carry_object("/d/city/obj/tiejia")->wear();

  add_money("silver", 30);
}
void init() {
  ::init();
  add_action("do_vendor_list", "list");
}
