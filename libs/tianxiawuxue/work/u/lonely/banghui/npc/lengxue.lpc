//
inherit BHNPC;
inherit F_BVENDOR;
#include <die.h>
#include <ansi.h>
string query_save_file() { return DATA_DIR + "npc/冷血"; }
void create()
{
          set_name(HIR"冷血"NOR, ({"leng xue", "leng","xue"}));
        set("long", "地字号杀手。\n");
        this_object()->init_bhnpc();
        set("area_name","南码头");
        set("ziyuan","矿石");
        set("jizhi",25);
        set("kaifa",21);
        set("area_file","/d/nanyang/matou1");
        set("gender", "男性");
        set("age", 38);
        set("str", 700);
        set("per", 30);
        set("con", 700);
        set("int", 700);
        set("dex", 700);
        set("combat_exp", 9000000);
        set("attitude", "peaceful");
        set_skill("force", 1100);
        set_skill("unarmed", 1100);
        set_skill("hunyuan-zhang", 1100);
        set_skill("sword", 1100);
        set_skill("dodge", 1100);
        set_skill("parry", 1100);
        set_skill("zixia-shengong", 1100);
          set_skill("huashan-jianfa", 1100);
        set_skill("feiyan-huixiang", 1100);
        set_temp("apply/attack", 60);
        set_temp("apply/defense", 60);
        set_temp("apply/armor", 60);
        set_temp("apply/damage", 60);
        map_skill("force", "zixia-shengong");
        map_skill("unarmed", "hunyuan-zhang");
        map_skill("sword", "huashan-jianfa");
        map_skill("parry", "huashan-jianfa");
        map_skill("dodge", "feiyan-huixiang");          
        set("max_qi", 18000);
        set("qi", 18000);
        set("max_neili", 5000);
        set("neili",5000);
        set("jiali",150);
        prepare_skill("unarmed","hunyuan-zhang");
        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action, "unarmed.wuji" :),
                (: perform_action, "sword.jianzhang" :),
                (: command("unwield jian") :),
                (: command("wield jian") :),
                (: exert_function, "recover" :),
                (: exert_function, "heal" :),
                (: command("unwield jian") :),
                (: command("wield jian") :),
            }) ); 
        set("chat_msg",({
     GRN"冷血嘿嘿嘿地奸笑了几下，低声对你说：“你喜欢杀人吗？杀人很刺激的，\n"+
         "如果有一天我下岗了，一定会去当杀人狂，嘿~！嘿~！嘿~！”\n"NOR,
        (: random_move :)
        }));
        setup();
        carry_object("/d/city/obj/gangjian")->wield();
        carry_object("/d/city/obj/tiejia")->wear();

add_money("silver",30);
}
void init()
{
::init();
  add_action("do_vendor_list","list");
}
