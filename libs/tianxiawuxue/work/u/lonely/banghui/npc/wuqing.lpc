//
inherit BHNPC;
inherit F_BVENDOR;
#include <die.h>
#include <ansi.h>
string query_save_file() { return DATA_DIR + "npc/无情"; }
void create()
{
        set_name(HIW"无情"NOR, ({"wu qing", "wu","qing"}));
        set("long", "神字号杀手。\n");
        this_object()->init_bhnpc();
        set("area_name","黄土路");
        set("ziyuan","矿石");
        set("jizhi",25);
        set("kaifa",21);
        set("area_file","/d/wudang/wdroad6");
        set("gender", "男性");
        set("age", 38);
        set("str", 700);
        set("per", 30);
        set("con", 700);
        set("int", 700);
        set("dex", 700);
        set("combat_exp", 9000000);
        set("attitude", "peaceful");
        set_skill("force", 1100);
        set_skill("unarmed", 1100);
        set_skill("tanzhi-shentong", 1100);
        set_skill("sword", 1100);
        set_skill("dodge", 1100);
        set_skill("parry", 1100);
        set_skill("bibo-shengong", 1100);
        set_skill("anying-fuxiang", 1100);
        set_skill("luoying-shenjian", 1100);
        set_temp("apply/attack", 60);
        set_temp("apply/defense", 60);
        set_temp("apply/armor", 60);
        set_temp("apply/damage", 60);
        map_skill("force", "bibo-shengong");
        map_skill("unarmed", "tanzhi-shentong");
        map_skill("sword", "luoying-shenjian");
        map_skill("parry", "luoying-shenjian");
        map_skill("dodge", "anying-fuxiang");          
        set("max_qi", 18000);
        set("qi", 18000);
        set("max_neili", 5000);
        set("neili",5000);
        set("jiali",150);
        prepare_skill("unarmed","xianglong-zhang");
        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action, "unarmed.jinglei" :),
                (: perform_action, "sword.lybf" :),
                (: command("unwield jian") :),
                (: command("wield jian") :),
                (: exert_function, "recover" :),
                (: exert_function, "heal" :),
                (: command("unwield jian") :),
                (: command("wield jian") :),
            }) ); 
        set("chat_msg",({
     GRN"无情嘿嘿嘿地奸笑了几下，低声对你说：“杀人其实是很好玩的，杀人很刺激的，\n"+
         "如果有一天我下岗了，一定会去当杀人狂，嘿~！嘿~！嘿~！”\n"NOR,
        (: random_move :)
        }));
        setup();
        carry_object("/d/city/obj/gangjian")->wield();
        carry_object("/d/city/obj/tiejia")->wear();

add_money("silver",30);
}
void init()
{
::init();
  add_action("do_vendor_list","list");
}
