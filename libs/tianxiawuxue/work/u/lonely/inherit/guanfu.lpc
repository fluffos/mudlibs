int do_read(string target) {
  object me, *list;
  int i, temp;
  me = this_player();
  temp = 0;
  if (target == "list") {
    if ((me->query("family/family_name") == "朝廷"
      && me->query("rank") != 0
      && me->query("rank") < 8) || wizardp(me)) {
      list = users();
      i = sizeof(list);
      while (i--) {
        if (!wizardp(list[i]) && list[i]->query_condition("killer") && list[i]->query("class") != "officer") {
          temp = 1;
          printf(list[i]->query("name") + "还在被通缉中,悬赏" + chinese_number(list[i]->query("combat_exp") / 60 + list[i]->query("wanted/exp")) + "点经验和若干潜能、金钱。 \n");
        }
      }
    } else {
      printf("六品以下，官员无权阅读此文件。\n");
      return 1;
    }
  }
  if (temp == 0) {
    tell_object(me, "现在还没有人被通缉！\n");
    return 1;
  }
  return 1;
}
