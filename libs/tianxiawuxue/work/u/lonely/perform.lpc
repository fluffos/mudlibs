// perform.c
#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg)
{
        object weapon;
        string martial, skill;
        int result;
        int time_busy=10+(int)me->query("GUILT")*2-me->query("perform/peak")/100;

        if(time_busy>20) time_busy=20;        
        if(time_busy<6) time_busy=6;  

        seteuid(getuid());

        if( me->is_busy() )
                return notify_fail("( 你上一个动作还没有完成，不能施用外功。)\n");

        if( environment(me)->query("no_fight") )
                return notify_fail("这里禁止战斗！\n");

        if( !arg ) return notify_fail("你要用外功做什麽？\n");

        if( sscanf(arg, "%s.%s", martial, arg)!=2 ) {
                if( weapon = me->query_temp("weapon") )
                        martial = weapon->query("skill_type");
                else
                        martial = "unarmed";
        }

    if((time()-(int)me->query("perform/last_time")) > time_busy)
    {
        if(me->query("combat_exp") > 10000000 && me->is_fighting() && random(me->query("kar"))<10)
        {  
        if(me->query("combat_exp")/10000000 > me->query("perform/peak")/100 && me->query_temp("perform"))
        {
         me->add("perform/peak_points",2*random(me->query_int()+me->query_con())+1);
         if(me->query("perform/peak_points") >
                    me->query("perform/peak")*me->query("perform/peak"))
         {
          me->add("perform/peak",1);
          me->set("perform/peak_points",0);
         tell_object(me,HIM"你好不容易才控制住部分体内的真气运行。\n"NOR);  
         }
         message_vision(MAG"猛然间，$N神色大变，一张脸忽"NOR+HIM"红"NOR
         +MAG"忽"NOR+HIW"白"NOR+MAG"，仿佛受着莫大的煎熬，\n"
         +"看来是$N的“"NOR+HIG"高原现象"NOR+MAG"”来临了。\n"NOR,me);
         me->set("perform/last_time",time());
         me->start_busy(1+me->query("perform/peak")/50+random(2));
         return 1;
        } else
        if( me->query("perform/peak") % 100 == 0 )
        message_vision(HIW"$N纵声长啸，但觉体内真气急速运转，绵绵不绝，不觉中"
        +"已突破“"NOR+HIG"高原绝境"NOR+HIW"”，\n功力又进了一层。\n"NOR,me);        
        }

        if( stringp(skill = me->query_skill_mapped(martial)) ) {
                notify_fail("你所使用的外功中没有这种功能。\n");
                if( SKILL_D(skill)->perform_action(me, arg) ) {
                        if( random(120) < (int)me->query_skill(skill) )
                                me->improve_skill(skill, 1, 1);
                        me->set("perform/last_time",time());

                        if(me->query("combat_exp")/10000000 == me->query("perform/peak")/100
                           && me->is_fighting() && random(me->query("int")) >= 10 && me->query("perform/peak")>=100)
                        {
                         me->add("perform/peak_points",2*random(me->query_con())+1);
                         if(me->query("perform/peak_points") >
                                  me->query("perform/peak")*me->query("perform/peak"))
                         {
                          me->add("perform/peak",1);
                          me->set("perform/peak_points",0);
                          tell_object(me,HIY"你的内息修为造诣又深厚了一层。\n"NOR);
                         }
                        }
                        me->set_temp("perform",1);   
                        return 1;
                } else if( SKILL_D(martial)->perform_action(me, arg) ) {
                        if( random(120) < (int)me->query_skill(martial, 1) )
                                me->improve_skill(martial, 1, 1);
                        me->set("perform/last_time",time());
                        if(me->query("combat_exp")/10000000 == me->query("perform/peak")/100
                           && me->is_fighting() && random(me->query("int")) >= 15 && me->query("perform/peak")>=100)
                        {
                         me->add("perform/peak_points",random(me->query_con()/2)+1);
                         if(me->query("perform/peak_points") >
                                    me->query("perform/peak")*me->query("perform/peak"))
                         {
                          me->add("perform/peak",1);
                          me->set("perform/peak_points",0);
                          tell_object(me,HIY"你的内息修为造诣又深厚了一层。\n"NOR);
                         }
                        }
                        me->set_temp("perform",1);
                        return 1;
                }

                me->set_temp("perform",0);
                return 0;
        }

        return notify_fail("你请先用 enable 指令选择你要使用的外功。\n");
    } else 
      return notify_fail(
          HIR"你略一运气，只觉气息翻腾不止，已无力再施用外功。\n"NOR);
}

int help (object me)
{
        write(@HELP
指令格式：perfrom [<武功种类>.]<招式名称> [<施用对象>]

如果你所学的外功(拳脚、剑法、刀法....)有一些特殊的攻击方式或招式，可以
用这个指令来使用，你必须先用 enable 指令指定你使用的武功，不指定武功种
类时，空手的外功是指你的拳脚功夫，使用武器时则是兵刃的武功。

若是你的外功中有种类不同，但是招式名称相同的，或者不属於拳脚跟武器技能
的武功(如轻功)，可以用 <武功>.<招式>  的方式指定，如：

perform sword.chan

换句话说，只要是 enable 中的武功有特殊招式的，都可以用这个指令使用。
HELP
        );
        return 1;
}


