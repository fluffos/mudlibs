#include <ansi.h>
inherit ROOM;
void create()
{
        set("short", HIR "【帮会广场】" NOR);
        set("long", HIW @LONG

               群    英    神    殿
                                 --天下无雪 题㊣   

    这里是各位江湖朋友的帮会神殿随在地,到处都是来来往往的
江湖客,这个方圆几百里的空地具有悠久的历史，广场的四面八方
都是玩家修建的各种各样的城池,从这里开始，你也可以在这里的
任何一个地方造属于自己的城堡,扩大地盘,修起来了可是千秋万
代的基业啊!

LONG NOR );
        set("exits", ([
                "down" : "/d/taishan/nantian",
                "west" : "/p/guangchang",
                "east" : "/p/guangchang1",
]));
        set("no_fight",1);
        set("no_sleep_room",1);
        set("no_steal",1);
        set("no_beg",1);
        set("no_study",1);
        set("no_yun",1);
        set("objects", ([ 
                "/p/npc/dream": 1,
                "/p/npc/sir": 1,
                "/p/npc/kool": 1,
                "/p/npc/weal": 1,
        ]));
        
        set("outdoors", __DIR__);
  //      set("owner","public");


        setup();
}
