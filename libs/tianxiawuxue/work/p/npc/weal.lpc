inherit NPC;

void create() {
  set_name(HIW "邪影" NOR, ({ "weal_npc", "npc1" }));
  set("gender", "男性");
  set("age", 24);
  set("long", "本MUD的最早的开发WIZ之一 ,许多想法的开拓者.\n");
  set("title", HIY "大宗师" NOR);
  set("gender", "男性");
  set("str", 500);
  set("int", 500);
  set("con", 500);
  set("dex", 500);
  set("per", 30);
  set("max_qi", 100000);
  set("max_jing", 100000);
  set("max_neili", 100000);
  set("neili", 100000);
  set("jiali", 5000);
  set("combat_exp", 1000000000);
  set_skill("dodge", 1000);
  set_skill("parry", 1000);
  set_skill("unarmed", 1000);
  set_skill("sword", 1000);
  set_skill("force", 1000);
  set_skill("literate", 1000);

  setup();
  if (query("gender") == "男性")
    carry_object("/clone/cloth/male" + (1 + random(8)) + "-cloth")->wear();
  else
    carry_object("/clone/cloth/female" + (1 + random(8)) + "-cloth")->wear();
}
