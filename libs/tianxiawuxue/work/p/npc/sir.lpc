inherit NPC;

void create()
{
    set_name( HIG"纪六"NOR, ({ "sir_npc","sinb" }) );
    set("gender", "男性");
    set("age", 28);
    set("long", HIR"本MUD的最举足轻重的wiz,本mud最最高手的wiz.\n"
                 "虽然他很忙,但是他还是每天要来看看.你们知道他\n"
                 "究竟是谁吗?其实他就是传说中的......\n"NOR);
    set("title", HIY "大宗师" NOR);
    set("gender", "男性");
    set("str", 500);
        set("int", 500);
        set("con", 500);
        set("dex", 500);
        set("per", 30);
        set("max_qi", 100000);
        set("max_jing", 100000);
        set("max_neili", 100000);
        set("neili", 100000);
        set("jiali", 5000);
        set("combat_exp", 1000000000);
        set_skill("dodge", 1000);
        set_skill("parry", 1000);
        set_skill("unarmed", 1000);
        set_skill("sword", 1000);
        set_skill("force", 1000);
        set_skill("literate", 1000);

    setup();
    if (query("gender") == "男性")
        carry_object("/clone/cloth/male"+(1+random(8))+"-cloth")->wear();
    else
        carry_object("/clone/cloth/female"+(1+random(8))+"-cloth")->wear();
}
