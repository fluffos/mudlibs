inherit ROOM;

void create() {

  set("short", HIR "【邪月广场】" NOR);
  set("long", BLU @LONG
        
                盗    亦    有    道
                                 --天下无雪 题㊣ 
                                 
这里是一个很宽阔的广场，铺着青石地面。周围聚集着江湖上
不少邪魔外道，很多邪派武林人物都喜欢来这里，因为这是通
向各门派的必进之路，正派人士往往都敬而远之此处。这里有
块牌子(sign)。
LONG);

  set("type", "xie");
  set("owner", "public");
  set("item_desc", ([
    "sign": "各门派的掌门人可以在此处划出(buildroom)一块地盘为己用。\n",
  ]));

  set("exits", ([
    "west": "/d/city/family", ]));

  setup();
}
