// guo xiang
// @ TXWX by hhm 2005/5/1 (解密)
#include <ansi.h>;
inherit NPC;
inherit F_MASTER;

void create() {
  set_name(HIY "郭襄" NOR, ({ "guo xiang", "guo", "xiang" }));
  set("nickname", HIR "痴心情长" NOR);
  set("long",
    "她就是郭大侠和黄蓉女侠的小女儿郭襄,身怀数门绝学,\n在四十岁的时候创立的峨嵋派.\n");

  set("gender", "女性");
  set("age", 45);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("shen", 150000000);
  set("str", 3000);
  set("int", 280);
  set("con", 300);
  set("dex", 300);
  set("per", 99);
  set("qi", 140000);
  set("max_qi", 140000);
  set("jing", 130000);
  set("max_jing", 130000);
  set("neili", 600000);
  set("max_neili", 600000);
  set("jiali", 100000);

  set("combat_exp", 1000000000);
  set("score", 30);

  set_skill("force", 1500);
  set_skill("dodge", 1550);
  set_skill("blade", 1580);
  set_skill("unarmed", 1580);
  set_skill("parry", 1500);
  set_skill("sword", 1500);
  set_skill("linji-zhuang", 1500);
  set_skill("jinding-zhang", 1500);
  set_skill("huifeng-jian", 1500);
  set_skill("yanxing-dao", 1580);
  set_skill("tiangang-zhi", 1580);
  set_skill("zhutian-bu", 1550);
  set_skill("yugalism", 1580);
  set_skill("dushi-jiren", 1500);
  set_skill("huanghunluohua", 1500);
  set_skill("duanchang-sword", 1500);
  set_skill("literate", 1500);
  set_skill("emei-jiuyang", 1500);
  map_skill("dodge", "huanghunluohua");
  map_skill("parry", "duanchang-sword");
  map_skill("sword", "duanchang-sword");
  map_skill("force", "emei-jiuyang");
  map_skill("unarmed", "tiangang-zhi");
  map_skill("blade", "yanxing-dao");
  prepare_skill("strike", "jinding-zhang");
  prepare_skill("unarmed", "tiangang-zhi");
  set("chat_chance_combat", 99);
  set("chat_msg_combat", ({
    (: perform_action, "sword.duanchang" :),
    (: exert_function, "recover" :),
  }));
  create_family("峨嵋派", 1, "祖师婆婆");
  set("class", "bonze");
  setup();
  carry_object("/clone/misc/cloth")->wear();
  carry_object("/d/emei/obj/yitian-jian")->wield();
}

void attempt_apprentice(object ob) {
  mapping fam = ob->query("family");
  if (!fam || fam["family_name"] != "峨嵋派") {
    command("say " + RANK_D->query_respect(ob) + "与本门素无来往，不知此话从何谈起？");
    return;
  }
  if ((int)ob->query_skill("force", 1) < 1000) {
    command("say 你基本功太差了，学不会我的功夫。");
    command("say " + RANK_D->query_respect(ob) +
      "你要想学到峨嵋九阳功,还是把基本内功练好了在来找我！");
    return;
  }
  if ((int)ob->query_skill("zhutian-bu", 1) < 800) {
    command("say 你的轻功底子太差。");
    command("say " + RANK_D->query_respect(ob) +
      "你还是把轻功先提高了在来吧？");
    return;
  }
  if ((int)ob->query_skill("huifeng-jian", 1) < 800) {
    command("say 你的剑法底子太差。");
    command("say " + RANK_D->query_respect(ob) +
      "你还是把剑法先提高了在来吧？");
    return;
  }
  if ((int)ob->query_skill("linji-zhuang", 1) < 800) {
    command("say 你的内功底子太差。");
    command("say " + RANK_D->query_respect(ob) +
      "你还是把内功先提高了在来吧？");
    return;
  }
  if ((int)ob->query_skill("yugalism", 1) < 600) {
    command("say 你的善心不够差。");
    command("say " + RANK_D->query_respect(ob) +
      "你还是把多做点好事,集点德后在来吧？");
    return;
  }
  if ((int)ob->query_skill("literate", 1) < 1500) {
    command("say 我看" + RANK_D->query_respect(ob) + "的读书识字还没学到家吧。");
    return;
  }
  if (((int)ob->query("shen") < 150000000)) {
    command("say 我绝对不收无名小辈，施主还是速速离去吧。");
    command("say 在德行方面，" + RANK_D->query_respect(ob) +
      "是否还做得不够？");
    return;
  }
  if ((int)ob->query("per") < 30) {
    command("say 依我看" + RANK_D->query_respect(ob) + "的资质似乎不适合学我伤心断肠剑？");
    return;
  }
  if ((int)ob->query("kar") < 29) {
    command("say 依我看" + RANK_D->query_respect(ob) + "的资质似乎不适合学我伤心断肠剑？");
    return;
  }
  if ((int)ob->query_int() < 41) {
    command("say 依我看" + RANK_D->query_respect(ob) + "的资质似乎不适合学我伤心断肠剑？");
    return;
  }
  command("chat " + RANK_D->query_respect(ob) + "我的剑法终于找到传人了。");
  command("recruit " + ob->query("id"));
  ob->set("title", HIR "郭襄亲传弟子" NOR);
}
