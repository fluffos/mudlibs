//shanyong.c  随喜

#include <ansi.h>

inherit NPC;
inherit F_MASTER;

string ask_for_join();
string ask_for_join();

void create()
{
	set_name("随喜", ({ "sui xi", "sui", "xi" }));
	set("long",@LONG
一个胖胖的西藏僧人，面带笑容，却常干笑里藏刀的事。
LONG
	);

	set("inquiry",([
		"剃度"  : (: ask_for_join :),
		"出家"  : (: ask_for_join :),
	]));


	set("title","血刀门第六代弟子");
	set("gender", "男性");
	set("age", 35);
	set("attitude", "peaceful");
	set("shen_type", -1);
	set("str", 25);
	set("int", 25);
	set("con", 25);
	set("dex", 25);
	
	set("max_jing", 1200);
	set("neili", 8000);
	set("max_neili", 8000);
	set("jiali", 120);
	set("combat_exp", 1000000);
	set("score", 20000);

	set_skill("lamaism", 200);
	set_skill("literate", 200);
	set_skill("force", 200);
	set_skill("parry", 200);
	set_skill("blade", 200);
	set_skill("dodge", 200);
	set_skill("xuehai-mogong", 200);
	set_skill("xuedun", 200);
	set_skill("strike", 200);
	set_skill("miexian-zhang", 200);
	set_skill("xue-dao", 200);

	map_skill("force", "xuehai-mogong");
	map_skill("dodge", "xuedun");
	map_skill("strike", "miexian-zhang");
	map_skill("parry", "xue-dao");
	map_skill("blade", "xue-dao");

	create_family("血刀门", 6, "弟子");
	set("class", "bonze");

	setup();
	carry_object("/d/xueshan/obj/y-jiasha")->wear();
	carry_object("/d/xuedao/obj/xuedao")->wield();
}


 void init()
{
	add_action("do_kneel", "kneel");
}

string ask_for_join()
{
	object me;

	me = this_player();

	if( (string)me->query("class")=="bonze" )
		return "阿弥陀佛！你我同是和尚，开什么玩笑？\n";

	if( (string)me->query("gender") != "男性" )
	  return "阿弥陀佛！善哉！善哉！妹子若真心皈依我佛，可和我大和尚做点别的。\n";

	me->set_temp("pending/join_bonze", 1);
	return "阿弥陀佛！善哉！善哉！施主若真心出家，请跪下(kneel)受戒。\n";
}

int do_kneel()
{
	 object me=this_player();

	string *prename =({ "刀", "灭", "绝", "血","杀","狂","婪", });

	string name, new_name;

	if( !me->query_temp("pending/join_bonze") )
		return 0;

	message_vision(
		"$N双手合十，老老实实地跪了下来。\n\n"
		"$n伸出手掌，在$N头上拍拍，将$N的头发剃光。\n\n",
		me, this_object() );
	name = me->query("name");
	new_name = prename[random(sizeof(prename))] + name[0..1];
	command("say 从今以后你的法名叫做" + new_name + "。");
	command("smile");
	me->delete_temp("pending/join_bonze");
	me->set("name", new_name);
	me->set("class", "bonze");
	me->set("k_record", me->query("PKS") + me->query("MKS"));
	me->set("shen_record", me->query("shen"));
	me->set("shen", 0);

	return 1;
   }



void attempt_apprentice(object ob)
{
	if((string)ob->query("class") != "bonze")
	{
		command("say 加入我们血刀门必须先行剃度。");
		return;
	}
	if ((string)ob->query("gender") != "男性")
	{
		command("say 小娘皮！贫僧只要你做老婆！嘿嘿！\n");
		command("chat* kiss "+ ob->query("id"));
		return;
	}
	if ((int)ob->query("shen") > 0)
	{
		command("say 我最恶心所谓正派人士了,快滚！\n");
		return;
	}
	command("haha");
	command("recruit " + ob->query("id"));
	ob->set("title", "血刀门第七代弟子");
}

