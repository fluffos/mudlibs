// masteryue.c
inherit NPC;
inherit F_MASTER;
void create()
{
        set_name(HIW"何足道"NOR, ({ "he zudao", "master","he" }) );
        set("title", HIR"昆仑三圣"NOR);
        set("nickname", HIG"何三圣"NOR);        
        set("gender", "男性");
        set("age", 162);
        set("long",
 "他就是昆仑派的开山祖师，江湖上人称“昆仑三圣”的何足道。\n");        
        set("attitude", "peaceful");
        set("str", 850);
        set("int", 850);
        set("con", 800);
        set("per", 250);
        set("dex", 140);
        set("jingli",100000);
        set("max_jingli",10000);
        set("neili", 200000);
        set("max_neili", 50000);
        set("jiali",10000);
        set("rank_info/respect", "何师祖");        
        set("combat_exp",300000000);
 
           set_skill("force", 1000);
           set_skill("dodge", 1000);
           set_skill("parry", 1000);
           set_skill("xuantian-force", 1000);
           set_skill("sword", 1000);
           set_skill("literate",1000);
           set_skill("xunlei-sword", 1000);
           set_skill("unarmed", 1000);
           set_skill("sanyin-unarmed",1000);
           set_skill("throwing",1000);
           set_skill("yaoming-dodge", 1000);
           set_skill("mantianhuayu", 1000);
    
           map_skill("dodge", "yaoming-dodge");
           map_skill("force", "xuantian-force");
           map_skill("unarmed","sanyin-unarmed");
           map_skill("throwing","mantianhuayu");
           map_skill("parry", "xunlei-sword");
           map_skill("sword", "xunlei-sword");
    
    create_family("昆仑派", 13, "三圣");
    setup();
    carry_object("/clone/misc/long_cloth")->wear();
    carry_object("/d/kunlun/obj/qizi")->wield();
    carry_object("/clone/weapon/changjian")->wield();
}
void attempt_apprentice(object ob)
{   
        if ((int)ob->query_skill("xuantian-force", 1) < 600) 
           {
        command("say " + RANK_D->query_respect(ob) + "是否还应该多练练本门的内功心法？");
        return;
       }
    command("recruit " + ob->query("id"));
}
void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "swordsman");
}
