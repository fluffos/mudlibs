// bamboo_club.c
#include <ansi.h>
#include <weapon.h>
inherit CLUB;
void create()
{
    set_name(HIG"玉竹杖"NOR, ({"yuzhu zhang", "zhu", "club"}));
    set_weight(5000);
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("unit", "根");
        set("long", "一根泛着淡淡青光的竹杖，看起来年头不短。\n"+"这是丐帮的镇帮之宝，由帮主代代相传。\n");
        set("value", 10000);
        set("material", "bamboo");
        set("wield_msg", "$N抽出一根青光闪闪的竹杖抓在手中，胸中顿生一股睥睨天下的豪情。\n");
        set("unwield_msg", "$N把手中的玉竹杖插回腰中，换作一幅懒洋洋的神情。\n");
    }
    init_club(800);
    setup();
}   
