// fanye.c 范骅

#include <ansi.h>
inherit "/inherit/char/b_npc.lpc";
inherit F_MASTER;

void upgrade_title(object me,string arg);
string clear_title(string arg);
int ask_me();
void create()
{
        set_name("范骅" , ({ "fan ye", "fan" }));
        set("title",YEL  "大理司马" NOR);
        set("long", "他是大理国三公之一。\n");
        set("gender", "男性");
        set("age", 40);
        set("class", "officer");
        set("attitude", "friendly");
        set("shen_type", 1);
        set("str", 25);
        set("int", 30);
        set("con", 30);
        set("dex", 25);
        
        set("max_qi", 1500);
        set("max_jing", 500);
        set("neili", 1000);
        set("max_neili", 1000);
        set("jiali", 100);
        set("combat_exp", 5000000);
        set("score", 200000);

        set_skill("force", 280);
        set_skill("dodge", 280);
        set_skill("parry", 280);
        set_skill("cuff", 280);
        set_skill("sword", 280);
        set_skill("staff", 280);
        set_skill("kurong-changong", 280);
        set_skill("tiannan-step", 280);
        set_skill("jinyu-quan", 280);
        set_skill("duanjia-sword", 280);
        set_skill("literate", 280);

        map_skill("force", "kurong-changong");
        map_skill("dodge", "tiannan-step");
        map_skill("cuff", "jinyu-quan");
        map_skill("sword", "duanjia-sword");
        map_skill("staff", "duanjia-sword");
        map_skill("parry", "duanjia-sword");
        prepare_skill("cuff", "jinyu-quan");

         set("inquiry", ([
                "指点武功" : (: ask_me :),
        ]));
        setup();
        carry_object("/clone/misc/cloth")->wear();
        carry_object("/clone/weapon/changjian")->wield();
        add_money("silver", 20);

        create_family("大理段家",19,"武将");
}
#include "/kungfu/class/dali/jiachen.h"; 
