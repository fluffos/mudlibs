// batianshi.c 巴天石

#include <ansi.h>
inherit "/inherit/char/b_npc.lpc"
;
 // inherit NPC;
inherit F_MASTER;

void upgrade_title(object me,string arg);
string clear_title(string arg);
int ask_me();
void create()
{
        set_name("巴天石", ({ "ba tianshi", "ba" }));
        set("title", YEL "大理司空" NOR);
        set("long", "他是大理国三公之一。一个又瘦又黑的汉子，但他的擅长轻功。\n");
        set("gender", "男性");
        set("age", 40);
        set("class", "officer");
        set("attitude", "friendly");
        set("shen_type", 1);
        set("str", 25);
        set("int", 25);
        set("con", 25);
        set("dex", 30);
        
        set("max_qi", 1500);
        set("max_jing", 500);
        set("neili", 1000);
        set("max_neili", 1000);
        set("jiali", 100);
        set("combat_exp", 5000000);
        set("score", 200000);

        set_skill("force", 300);
        set_skill("dodge", 300);
        set_skill("parry", 300);
        set_skill("cuff", 300);
        set_skill("sword", 300);
        set_skill("staff", 300);
        set_skill("kurong-changong", 300);
        set_skill("tiannan-step", 300);
        set_skill("jinyu-quan", 300);
        set_skill("duanjia-sword", 300);
        set_skill("literate", 300);

        map_skill("force", "kurong-changong");
        map_skill("dodge", "tiannan-step");
        map_skill("sword", "duanjia-sword");
        map_skill("staff", "duanjia-sword");
        map_skill("parry", "duanjia-sword");
        map_skill("cuff", "jinyu-quan");
        prepare_skill("cuff", "jinyu-quan");
 
      set("inquiry", ([
                "指点武功" : (: ask_me :),
        ]));

        setup();
        carry_object("/clone/misc/cloth")->wear();
        carry_object("/clone/weapon/changjian")->wield();
        add_money("silver", 20);

        create_family("大理段家",19,"武将");
}
#include "/kungfu/class/dali/jiachen.h"; 

