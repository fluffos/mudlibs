// masteryue.c
inherit BH_NPC
;
inherit F_MASTER;
void create()
{
        set_name("岳不群", ({ "yue buqun", "master", "yue" }) );
        set("title", "华山派现任掌门");
        set("nickname", "君子剑");        
        set("gender", "男性");
        set("age", 40);
        set("long",
 "他就是华山派的现任掌门人，江湖上人称“君子剑”的岳不群。他看上去\n"
 "是个和善的中年人，对人总是彬彬有礼，很有一代宗师的风范。\n" );
        set("inquiry", ([
                "紫霞秘籍": "对不起，你来晚了，紫霞秘籍并不在我这里。\n",
                "辟邪剑谱": "你问辟邪剑谱,那是歪门邪道的武功，问来干什么。\n",
                "手令": "手令，你想进我的书房偷东西吗，抓贼啊。"
]) );        
        set("attitude", "peaceful");
    set("str", 40);
    set("neili",3000);
    set("max_qi",2000);
    set("int", 65);
    set("con", 60);
        set("per", 28);
    set("dex", 130);
        set("max_neili", 1500);
        set("jiali",200);
        set("rank_info/respect", "岳掌门");        
        set("combat_exp",30000000);
        set("shen",15000);
    set_skill("force", 600);
    set_skill("dodge", 600);
    set_skill("parry", 600);
    set_skill("sword", 600);
    set_skill("blade", 600);
    set_skill("zixia-shengong", 600);
    set_skill("huashan-jianfa", 600);
    set_skill("huashan-zhangfa", 600);
    set_skill("feiyan-huixiang", 600);
    set_skill("hunyuan-zhang", 600);
    set_skill("pixie-jian", 200);
set_skill("strike", 600);
    set_skill("poyu-quan", 600);
    set_skill("fanliangyi-dao", 600);
    set_skill("literate", 600);
    set_skill("unarmed", 600);
    
    map_skill("dodge", "pixie-jian");
    map_skill("force", "zixia-shengong");
    map_skill("parry", "pixie-jian");
    map_skill("sword", "pixie-jian");
    map_skill("unarmed", "hunyuan-zhang");
    map_skill("blade", "fanliangyi-dao");
    create_family("华山派", 13, "掌门人");
    setup();
    carry_object("/clone/misc/long_cloth")->wear();
    carry_object("/clone/weapon/changjian")->wield();
}
void attempt_apprentice(object ob)
{       
	       if ((int)ob->query("shen") < 10000) {
        command("say 我华山派乃是堂堂名门正派，对弟子要求极严。");
        command("say 在德行方面，" + RANK_D->query_respect(ob) +
            "是否还做得不够？");
        return;
         }
    if ((int)ob->query_dex() < 25) {
        command("say 依我看" + RANK_D->query_respect(ob) + "的资质似乎不适合学我华山派武功？");
        return;
        }
	 if ((string)ob->query("gender") != "男性") {
        command("say 阁下开什么玩笑！我怎么能够收女子为徒呢？真是要命!");
                command("say 我只收男弟子，你还是去拜我夫人吧。");
        return;
    }
	
        command("say 好吧，我就收下你了。");
        command("recruit " + ob->query("id"));
        if((string)ob->query("class") != "swordsman")
        ob->set("class", "swordsman");
}
void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "swordsman");
}
