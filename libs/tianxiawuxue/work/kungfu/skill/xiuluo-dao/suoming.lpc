#include <ansi.h>
 
inherit F_SSERVER;
 
int perform(object me)
{
    string msg;
    object weapon, target;
    int skill, skill1, skill2, ap, dp, neili_wound, qi_wound;
    me->clean_up_enemy();
    target = me->select_opponent();
    skill = me->query_skill("xiuluo-dao",1);
    skill1 = me->query_skill("shaolin-shenfa",1);
    skill2 = me->query_skill("hunyuan-yiqi",1);
    if( !(me->is_fighting() ))
        return notify_fail("「修罗索命刀」只能对战斗中的对手使用。\n");
 
    if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
        return notify_fail("你使用的武器不对。\n");
    if (me->query("gender") == "无性" || me->query("gender") == "女性")
        return notify_fail("你无法使出修罗刀之「修罗索命刀」。\n");
    if( skill2 < 200)
        return notify_fail("你的混元一气等级不够, 不能使用「修罗索命刀」！\n");
    if( skill < 250)
        return notify_fail("你的修罗刀等级不够, 不能使用「修罗索命刀」！\n");
    if( me->query("neili") < 500 )
        return notify_fail("你的内力不够，无法运用「修罗索命刀」！\n");
    
     if (me->query_temp("perform"))
        return notify_fail("你上一招没完成, 不能使用「修罗索命刀」！\n");
    msg = HIG "$N运起修罗刀法，剑势直逼$n的气门。\n";
    message_vision(msg, me, target);
 
    ap = me->query("combat_exp")+(skill*skill1*skill2) / 5;
    dp = target->query("combat_exp") / 2;
    if( dp < 1 )
        dp = 1;
    if( random(ap) > dp )
    {
        if(userp(me))
            me->add("neili",-250);
        msg = "$N突然使出一招「修罗索命刀」积聚体内所有真气凝于刀中，心随气转，发力于刀。 ！\n" NOR;
        neili_wound = 1000 + random(skill+skill1+skill2);
        if(neili_wound > target->query("neili"))
            neili_wound = target->query("neili");
        qi_wound = neili_wound * 2;
        if(qi_wound > target->query("qi"))
            qi_wound = target->query("qi");
        target->add("neili", -neili_wound);
        target->add("qi", -qi_wound);
        target->add("eff_qi", -qi_wound);
        target->start_busy(2);
    }
    else
    {
        if(userp(me))
            me->add("neili",-100);
        msg = "可是$n看破了$N的企图，凝神静气，暗运内力于气门之内，挡住了$N的凌厉攻势。\n"NOR;
    }
    me->set_temp("perform",1);
    call_out("perform_end",5,me);
    message_vision(msg, me, target);
    return 1;
}
void perform_end(object me)
{
    if (!me)    return;
    me->delete_temp("perform");
}
