#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;

int perform(object me, object target) {
  object weapon, ob;
  string msg;
  int i;
  int attack_time;

  if (!target) target = offensive_target(me);
  if (!me->is_fighting())
    return notify_fail("圆月无敌只能对战斗中的对手使用。\n");
  if (me->query_temp("perform")) return notify_fail("你上一招未使完！\n");
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
    if (!objectp(weapon = me->query_temp("secondary_weapon"))
      || (string)weapon->query("skill_type") != "blade")
      return notify_fail("你使用的武器不对。\n");
    else me->set_temp("secondly_weapon", 1);
  if ((int)me->query("neili") < 200)
    return notify_fail("你的真气不够！\n");
  if ((int)me->query_skill("yuanyue-wandao", 1) < 800 ||
    me->query_skill_mapped("blade") != "yuanyue-wandao")
    return notify_fail("你的「圆月刀法」还不到家，无法使用「圆月无敌」！\n");
  msg = HIY "$N微微一笑,朗声道" + HIR "圆月起,刀光落.纵横大地十万里.刀光寒如雪,何处听春雨?" + HIY "，只见刀光一闪,已经使出最后一招「" + HIY "圆" NOR + HIC "月" NOR + HIW "无" NOR + HIR "敌" NOR + "」一招八式扑向$n！";
  message_vision(msg, me, target);
  me->clean_up_enemy();
  ob = me->select_opponent();
  me->start_busy(2 + random(3));
  me->add("neili", -150);
  me->set_temp("perform", 1);
  me->set_temp("perform_wudi", 1);
  attack_time = (int)me->query_skill("yuanyue-wandao", 1) / 50;

  for (i = 0; i < attack_time; i++)
    if (me->is_fighting(ob) && ob->is_fighting(me) && ob->query("eff_qi") > 0) {
      me->set_temp("action_msg", "紧接着");
      if (!weapon->query("equipped")) break;
      COMBAT_D->do_attack(me, ob, weapon, 0);
    } else break;
  me->delete_temp("perform_wudi");
  me->delete_temp("secondly_weapon");
  me->start_call_out((: call_other, __FILE__, "del_perform", me :), 3); ;
  return 1;
}

void del_perform(object me) {
  if (!me) return;
  me->delete_temp("perform");
}
