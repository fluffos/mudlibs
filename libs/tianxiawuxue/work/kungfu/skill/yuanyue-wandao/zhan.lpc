//@TXWX by hhm 2005/4/20
#include <ansi.h>
inherit F_SSERVER;
int perform(object me, object target) {
  int lvl;
  lvl = me->query_skill("yuanyue-wandao", 1);
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("你只能对战斗中的对手使用乾坤斩。\n");
  if ((int)me->query_skill("yuanyue-wandao", 1) < 500)
    return notify_fail("你的圆月弯刀不够娴熟，无法施展出乾坤斩。\n");
  if ((int)me->query_skill("flymoon-xinfa", 1) < 800)
    return notify_fail("你的飞月心法火候不够，无法施展出乾坤斩。\n");
  if ((int)me->query_skill("flymoon-dance", 1) < 800)
    return notify_fail("你的飞月舞火候不够，无法施展出乾坤斩。\n");
  if ((int)me->query("max_neili") < 50000)
    return notify_fail("你的内力不够，无法施展出乾坤斩。\n");
  if ((int)me->query("neili") < 5000)
    return notify_fail("你的真气不够，无法施展出乾坤斩。\n");
  message_vision(HIB "$N使出弯刀「乾坤斩」，刀光一闪只劈向$n！\n" NOR, me, target);

  me->add("neili", -(400 + random(800)));

  me->add_temp("apply/attack", lvl * 10);
  me->add_temp("apply/dexerity", lvl * 10);
  me->add_temp("apply/damage", lvl * 10);

  if (random(me->query_dex()) > target->query_dex() / 5) {
    message_vision(HIB "结果$N一招得手，$n的手腕居然被斩了下来！\n" NOR, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 3);
    target->apply_condition("broken_arm", 180);
  }
  me->start_busy(random(3) + 2);
  me->add_temp("apply/attack", -lvl * 10);
  me->add_temp("apply/damage", -lvl * 10);
  me->add_temp("apply/dexerity", -lvl * 10);
  me->start_perform(8, "「乾坤斩」");
  return 1;
}
