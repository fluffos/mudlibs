    "dodge": 50,
    "damage": 800,
    "lvl": 71,
    "skill_name": "方圆",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N挪步小退，一招" + HIC "「问鼎天下」" NOR + "，手中$w轻描淡写地挥出一
刀，随即又“唰唰”连
劈出两刀，后发先至，洒向$n的$l",
    "force": 800,
    "dodge": 100,
    "damage": 2000,
    "lvl": 120,
    "skill_name": "问鼎天下",
    "damage_type": "割伤"
  ]),
});


int valid_enable(string usage) { return usage == "blade" || usage == "parry"; }

int valid_learn(object me) {
  mapping myfam;
  myfam = (mapping)me->query("family");
  if (!myfam || myfam["master_id"] != "kou zhong")
    return notify_fail("你无法向其他人学习井中八法。\n");
  if ((int)me->query("max_neili") < 200000)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_skill("force", 1) < 1200)
    return notify_fail("你的内功心法火候太浅。\n");
  if ((int)me->query_skill("dodge", 1) < 1200)
    return notify_fail("你的轻功火候太浅。\n");
  if ((int)me->query_dex() < 30)
    return notify_fail("你的身法还不够灵活。\n");
  if (me->query("gender") == "无性")
    return notify_fail("你无根无性，阴阳不调，难以领会高深的井中八法。\n");
  if (me->query("gender") != "男性")
    return notify_fail("井中八法需要阳刚之气，不适合你学。\n");
  if (me->query("kar") < 30)
    return notify_fail("井中八法只传授有缘之人，阁下请回吧。\n");
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}
mapping query_action(object me, object weapon) {
  if (random(me->query_skill("blade")) > 800 &&
    me->query_skill("force") > 800 &&
    me->query("neili") > 1000 &&
    (string)weapon->query("id") == "jingzhongyue") {
    me->add("neili", -100);
    return ([
      "action": HIR "$N使出一招" HIW "「问鼎天下」" HIR "，$w发出万长白芒，寒光四射，直劈向$n" NOR,
      "damage": 6000,
      "force": 1000,
      "damage_type": "劈伤" ]);
  }
  return action[random(sizeof(action))];
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  if (damage_bonus < 100) return 0;

  if (random(damage_bonus) > victim->query_str()) {
    victim->add("qi", -damage_bonus);
    victim->receive_wound("qi", (damage_bonus - 500) / 2);
    return HIW "听到「哧」一声轻响,一片刀气如" HIY "月光" HIW "般扑天而来，忽然间$n血冒三丈，被$N刀气所伤！\n";
  }
}

string perform_action_file(string action) {
  return __DIR__ "jingzhong-bafa/" + action;
}
