  ]),
  ([ "action": "$N一招" + HIC "「用谋」" NOR + "，侧身而退，$w却在胸前划出一道圆弧
，横劈$n的$l",
    "force": 350,
    "dodge": 50,
    "damage": 500,
    "lvl": 32,
    "skill_name": "用谋",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N侧身滑步而上，一招" + HIW "「速战」" NOR + "，欺至$n身前，$w猛砍
