    "dodge": 10,
    "lvl": 0,
    "skill_name": "不攻",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N一招" + HIW "「击奇」" NOR + "，右脚一点，$w寒光闪闪，快速涌$n的
$l",
    "force": 250,
    "dodge": 50,
    "damage": 300,
    "lvl": 10,
    "skill_name": "击奇",
    "damage_type": "割伤"
