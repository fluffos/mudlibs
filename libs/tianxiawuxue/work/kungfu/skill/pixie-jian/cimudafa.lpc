// cimu.c 辟邪剑法「刺目式」

// file: /kungfu/skill/pixie-jian/cimu.c

#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target)
{
        int damage, i;
        int a;
        object weapon, weapon2;
        string msg, msg1, eye;

        if( !target ) target = offensive_target(me);

        if( !target || !target->is_character() || !me->is_fighting(target) )
                return notify_fail("「刺目式」只能对战斗中的对手使用。\n");

        if (!objectp(weapon = me->query_temp("weapon"))
                || (string)weapon->query("skill_type") != "sword")
                        return notify_fail("你使用的武器不对。\n");

        if( (int)me->query_skill("pixie-jian", 1) < 1000 )
                return notify_fail("你的辟邪剑法不够娴熟，不会使用「刺目式」。\n");

        if( me->query("neili") < 10000
            || me->query("max_neili") < 30000 )
                return notify_fail("你现在内力太弱，不能使用「刺目式」。\n");

        if( me->query_skill_mapped("dodge") != "pixie-jian"
            || me->query_skill_mapped("parry") != "pixie-jian"
            || me->query_skill_mapped("sword") != "pixie-jian")
                return notify_fail("你没有激发辟邪剑法，无法使用「刺目式」！\n");


/**************** Check ablepsia ****************/

           // query("cimu") 检查对手是否已经盲了。
        if( target->query("cimu") > 1)
                return notify_fail("对方已经双目失明了，没有用「刺目式」的必要！\n");
         
        if ( !userp(target) )       
                return notify_fail("你只能对玩家使用「刺目式」！\n");

/**************** Check ablepsia ****************/

        if( target->query("cimu") == 1)
                eye = "左";
        else
                eye = "右";

        damage = ((int)me->query_skill("pixie-jian", 1) * 2);
        damage = (int)damage/2 + (int)(random(damage/2));
        weapon2 = target->query_temp("weapon");

        message_vision(WHT"$N一声冷笑，蓦地里疾冲上前，身形飘忽，" +
        "有如鬼魅，移步到$n四周转了几转。\n"NOR, me, target);
        tell_object(me,HIR"你使出一招「刺目式」，向" + target->query("name") +
        "的" + eye + "目急刺，" + target->query("name") + "已不及挡架，又不及闪避。\n"NOR);
        tell_object(target,HIR"你只觉眼前一花，但见剑影闪处，似有一物向自己" + eye + "" +
        "目戳来，此刻既已不及挡架，又不及闪避！\n"NOR);

        a=random(me->query("combat_exp")/100)*10;

        if((a > (int)target->query("combat_exp") / 30
        && random(me->query_skill("dodge") / 5) > target->query_skill("dodge") / 15
        && random(me->query_skill("parry") / 5) > target->query_skill("parry") / 15)
        || !living(target))
        {
//保护新手
                if( target->query("age") < 18 && target->query("combat_exp") < 50000000 )
                {

                        me->start_busy(random(5)+2);
                        tell_object(me,HIC"你瞟了" + target->query("name") + "一眼，发觉" +
                        target->query("name") + "竟然是一名稚童，不忍向其施下毒手，\n" +
                                "硬生生把这招「刺目式」收回来。\n"NOR);
                        msg = WHT"蓦地里$N猱身而上，蹿到$n的身后，又跃回原地。\n"NOR;
                        msg1 = HIC"你满脸疑惑，不明白" + me->query("name") +
                                "刚才那一招到底是怎麽回事？！\n"NOR;
                 }
                 else {

                        msg = HIR"斗到酣处，猛听得$n大叫一声，";
                        i = 2   ;

                        if (objectp(weapon2))
                        {
                                if (random(me->query_skill("dodge")) > (int)target->query_skill("dodge") / 2
                                    && random(me->query_skill("parry")) > (int)target->query_skill("parry") / 3 )
                                {
                                        msg += "手中";
                                        msg += weapon2->query("name") + NOR;
                                        msg += HIR"落地，";

                                        weapon2->move(environment(me));
                                        i = 3;
                                }
                        }

                        me->start_busy(random(3));
                        target->start_busy(random(3));

                        target->receive_damage("qi", damage);
                        target->receive_wound("qi", damage/i);
                target->remove_all_enemy();
                        me->remove_all_enemy();

/**************** SET ablepsia ****************/

           // set 对手被刺盲的参数:
                        target->add("cimu",1);
                        if ( target->query("cimu")> 1)  
                                CHANNEL_D->do_channel(this_object(),"rumor",
                                        sprintf("%s双目被%s刺盲了！",target->query("name"),me->query("name")));

/**************** SET ablepsia ****************/

                        msg += "一个筋斗翻了出去，双手按住" + eye + "眼，眼睛已被$N刺瞎。\n"NOR;
                        msg1 = HIM"你眼前一黑，甚麽也看不见，" + eye + "眼阵阵剧痛，心乱如麻，斗志全无。\n"NOR;
                }
        }
        else 
        {

                if (objectp(weapon2)) {
                        msg = WHT"$n危急之际不暇细思，百忙中" + weapon2->query("name") +
                        "颤动，也向$N的左目急刺，竟是两败俱伤的打法。\n";
                        i = 4;
                } else {
                        msg = WHT"$n危急之际不暇细思，百忙中拳脚并用，" +
                        "向$N奋力一击，竟是两败俱伤的打法。\n";
                        i = 5;
                }

                if( a > (int)target->query("combat_exp") / (i*10) 
                   && random(me->query_skill("dodge")/i) > target->query_skill("dodge") / 20
                   && random(me->query_skill("parry")/i) > target->query_skill("parry") / 20)
                {
                        me->start_busy(random(5));
                        target->start_busy(random(3));

                        target->receive_damage("qi", damage/3);
                        target->receive_wound("qi", damage/5);

                        msg1 = HIM"但觉眉心微微一痛，知道自己眉额已为" +
                        me->query("name") + "所刺中。\n";

                }
                else {

                        me->start_busy(random(5)+3);
        
                        i = 10;

                        msg1 = HIM;

                }

                msg += "$N已跳了开去，避开了$n这一击，啧啧连赞：“好功夫，好功夫！”\n"NOR;
                msg1 += "你心中暗暗想：幸亏他要闪避自己一击，才失了准头，否则眼睛已给他刺瞎了。\n"NOR;

        }

        me->add("neili", -damage/3);

        message_vision(msg, me, target);
        tell_object(target,msg1);
        
        if(i == 10) {
                target->kill_ob(me);
                me->fight_ob(target);
        }
        return 1;
}

