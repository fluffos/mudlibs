// bloody.c 残肢断魂
//web

#include <ansi.h>
inherit SKILL;

mapping *action = ({
  ([ "action": HIR "$N一手扳住$n上腭，一手扳住下颌，用力一分，把$n下巴撕了下来" NOR,
    "force": 100,
    "dodge": 10,
    "parry": 10,
    "damage": 200,
    "lvl": 10,
    //      "skill_name" : "",
    "damage_type": "抓伤"
  ]),
  ([ "action": HIM "$N扑向$n，一口咬住$n的喉咙，喀嚓一声$n的食管，气管，血管全都被撕得希巴烂，像一堆烂麻绳" NOR,
    "force": 200,
    "dodge": 20,
    "parry": 20,
    "damage": 400,
    "lvl": 20,
    //      "skill_name" : "",
    "damage_type": "抓伤"
  ]),
  ([ "action": RED "$N五指插进$n天灵盖，喀的一声扳开头骨，把$n脑浆一把抓了出来，舔了几口" NOR,
    "force": 300,
    "dodge": 30,
    "parry": 30,
    "damage": 600,
    "lvl": 30,
    //      "skill_name" : "",
    "damage_type": "抓伤"
  ]),
  ([ "action": HIC "$N一手摁住$n喉咙，咬向$n胸腹，三两口就啃得见了肋骨，几下就把$n胸腹肌肉撕扯殆尽，心肺等内脏清晰可见" NOR,
    "force": 400,
    "dodge": 40,
    "parry": 40,
    "damage": 800,
    "lvl": 40,
    //      "skill_name" : "",
    "damage_type": "抓伤"
  ]),
  ([ "action": HIG "$N一声狞笑，踩住$n脊背，抓住$n双手，啪的一声将两臂硬拽了下来，手臂与身体连接处血肉模糊，白骨森森" NOR,
    "force": 500,
    "dodge": 40,
    "parry": 50,
    "damage": 1000,
    "lvl": 50,
    //      "skill_name" : "",
    "damage_type": "抓伤"
  ]),
  ([ "action": HIW "$N踩住$n的背，一用劲，咯的一声闷响，$n的脊椎骨断成十七二十八截，$N再从$n身体中血淋淋地扯出半条不成模样的脊椎骨" NOR,
    "force": 600,
    "dodge": 60,
    "parry": 60,
    "damage": 1200,
    "lvl": 60,
    //      "skill_name" : "",
    "damage_type": "抓伤"
  ]),
  ([ "action": BLU "$N抓住$n两条腿，使劲一撕，把$n撕成两片，鲜血四溅，$n的内脏稀里乎噜流了一地" NOR,
    "force": 700,
    "dodge": 70,
    "parry": 70,
    "damage": 1400,
    "lvl": 70,
    //      "skill_name" : "",
    "damage_type": "抓伤"
  ]),
  ([ "action": HIB "$N两指嵌入$n眼睛，使劲抓牢，一手抓住$n身体，用劲一绞，一扭，再一扯，一下就把$n的头拽了下来" NOR,
    "force": 800,
    "dodge": 80,
    "parry": 80,
    "damage": 1600,
    "lvl": 80,
    //      "skill_name" : "",
    "damage_type": "抓伤"
  ]),

});

int valid_enable(string usage) { return usage == "claw" || usage == "unarmed" || usage == "parry"; }

int valid_learn(object me) {

  return notify_fail("你不能学残肢断魂。\n");

}


mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {

  return notify_fail("你不能练残肢断魂。\n");

}
string perform_action_file(string action) {
  return __DIR__ "canzhi-duanhun/" + action;
}
void skill_improved(object me) {
  tell_object(me, HIR "你忽然从心底生出一股恶念：杀、杀、杀！我要杀绝天下人！\n" NOR);
  me->add("shen", -20000);
}
