#include <ansi.h>
 
inherit F_SSERVER;
 
int perform(object me)
{
    string msg;
    object weapon, target;
    int skill, skill1, skill2, ap, dp, jing_wound, qi_wound;
    me->clean_up_enemy();
    target = me->select_opponent();
    skill = me->query_skill("damo-jian",1);
    skill1 = me->query_skill("shaolin-shenfa",1);
    skill2 = me->query_skill("hunyuan-yiqi",1);
    if( !(me->is_fighting() ))
        return notify_fail("「伤元剑」只能对战斗中的对手使用。\n");
 
    if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
        return notify_fail("你使用的武器不对。\n");
    if (me->query("gender") == "无性" || me->query("gender") == "女性")
        return notify_fail("你无法使出达摩剑之「伤元剑」。\n");
    if( skill2 < 200)
        return notify_fail("你的混元一气等级不够, 不能使用「伤元剑」！\n");
    if( skill < 250)
        return notify_fail("你的达摩剑等级不够, 不能使用「伤元剑」！\n");
    if( me->query("neili") < 500 )
        return notify_fail("你的内力不够，无法运用「伤元剑」！\n");
    
     if (me->query_temp("perform"))
        return notify_fail("你上一招没完成, 不能使用「伤元剑」！\n");
    msg = HIG "$N使出达摩剑之「伤元剑」，剑势杂乱无章，使$n疲于招架。\n";
    message_vision(msg, me, target);
 
    ap = me->query("combat_exp")+(skill*skill1*skill2) / 5;
    dp = target->query("combat_exp") ;
    if( dp < 1 )
        dp = 1;
    if( random(ap) > dp )
    {
        if(userp(me))
            me->add("neili",-150);
        msg = "$N的剑势步步进逼, $n在难于招架之下，精力不断下降！\n" NOR;
        jing_wound = 1000 + random(skill+skill1+skill2);
        if(jing_wound > target->query("jing"))
            jing_wound = target->query("jing");
        qi_wound = jing_wound / 5;
        if(qi_wound > target->query("qi"))
            qi_wound = target->query("qi");
        target->add("jing", -jing_wound);
        target->add("qi", -qi_wound);
        target->add("eff_qi", -qi_wound);
        target->start_busy(2);
    }
    else
    {
        if(userp(me))
            me->add("neili",-100);
        msg = "可是$n看破了$N的企图，立刻闭目侧耳，闪到$N的剑势之外。\n"NOR;
    }
    me->set_temp("perform",1);
    call_out("perform_end",1,me);
    message_vision(msg, me, target);
    return 1;
}
void perform_end(object me)
{
    if (!me)    return;
    me->delete_temp("perform");
}
