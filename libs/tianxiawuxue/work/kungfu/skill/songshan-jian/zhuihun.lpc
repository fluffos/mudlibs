// 嵩山剑法 夺命追魂
// knightly 2006.04.27
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;
int perform(object me, object target)
{
		object weapon, ob;
		int	flag;
    string msg;
    int times;
    int i;
    int qCon1, qCon2, fmCount, sssword, damage;
    
    sssword = (int)me->query_skill("songshan-jian", 1);
           
		if( !target ) target = offensive_target(me);           
            
    if( !target
    ||      !target->is_character()
    ||      target->is_corpse()
    ||      target==me)
            return notify_fail("你要对谁施展「夺命追魂」？\n");    
    if( !me->is_fighting() )
        return notify_fail("「夺命追魂」只能在战斗中使用。\n");
    if (!objectp(weapon = me->query_temp("weapon"))
            || (string)weapon->query("skill_type") != "sword")
                    return notify_fail("你使用的武器不对。\n");
		if((int)me->query_skill("sword",1) < 400)
		  			return notify_fail("你的基本剑法的火候还不到家, 不能使用这一绝技 !\n");
    if(sssword <400)
            return notify_fail("你的嵩山剑法的火候还不到家, 不能使用这一绝技 !\n");
    if( (int)me->query("neili") < 10000 )
            return notify_fail("你的真气不够！\n");
    if( (int)me->query("max_neili") < 5000 )
            return notify_fail("你的内力修为不够！\n");
            
    flag = me->query("sp_skill/zuolengchan", 1);
    qCon1 = (int)me->query("con", 1);
    qCon2 = (int)me->query_con();
    fmCount = (int)me->query("familyjob/songshan/GetPay");
    
		msg =HIB "\n$N默运内力，剑势突然迅猛起来,这正是嵩山剑法绝技——"+NOR+BLINK HIR+"夺命追魂！\n" NOR;
    message_vision(msg, me);    
    
    if ((flag > 0) && (sssword >=1000) && ((qCon1 > 23)||(qCon2>240)))
    {
    	times = me->query_skill("songshan-jian",1) / 100;
    	
    	msg =HIR "\n$N不坏好意的笑了笑，剑势顿变，诡异狠辣，杀机四伏！\n" NOR;
    	message_vision(msg, me);
    	
	    me->add_temp("apply/attack", sssword/2);
	    me->add_temp("apply/dodge", sssword/2);    	
	    me->add_temp("apply/damage", sssword/2);    	
    	
    	if ((qCon1>24)&&(fmCount>400))
    	{
    		damage = random(sssword)+2*random(fmCount);
    		target->receive_damage("qi", damage);    		
    		msg =  HIR "$1使出诡异的一剑，$2躲无可躲，只好挺身受了一剑。\n" NOR;
    	}
    	else
    	{
      	COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);
      	msg =  HIR "在剑花中，冷不丁一剑突出剑幕刺了过来。\n" NOR;
    	}
      message_vision(msg, me, target);  
      
      for(i=0;i<times;i++)
      {
      	if (me->query("spskill/songshan/huashanlingwu_sword", 1))
      	{
      		damage = random(10*qCon2)+2*random(sssword)+2*random(fmCount);
      		if (damage<1000)
      			damage= 1000;
      		msg =  HIR "$1剑气连连，显然已得"+HIW+"嵩山剑法"+NOR+"真传，$2招式以老，无法闪躲，硬受一招。\n" NOR;
    			target->receive_damage("qi", damage);  
    			if (random(10)>7)  		
    			{
    				target->receive_wound("qi", damage/3+random(damage));
    				target->receive_wound("jing", damage/3+random(damage));
    			}
    			message_vision(msg, me, target);  
      	}
      	else      	
      	if (me->query("spskill/shzuocanpfm2", 1))
      	{
      		msg =  HIR "$1剑气连连，显然已尽得"+HIB+"左冷禅"+NOR+"真传，$2招式以老，无法闪躲，硬受一招。\n" NOR;
    			target->receive_damage("qi", random(2*sssword)+random(2*fmCount));    		
    			message_vision(msg, me, target);  
      	}      	
      	else      	
      	if (me->query_temp("shzuocanpfm1", 1))
      	{
      		msg =  HIR "$1剑气连连，显然已领悟个中三昧，$2招式以老，无法闪躲，硬受一招。\n" NOR;
    			target->receive_damage("qi", random(sssword)+2*random(fmCount));    		
    			message_vision(msg, me, target);  
      	}      	
      	else
      	{
	      	msg = HIY "$N剑走旁门，一剑又次了过来！\n" NOR;
	      	COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);
	    	}
      }
           
      if (qCon1>24)
      {
      	me->add("neili", - 20 * i);
      	me->start_busy(random(2));
      }
      else
      {
      	me->add("neili", - 80 * i);
      	me->start_busy(2+random(1));
      }
      
	    me->add_temp("apply/attack", -sssword/2);
	    me->add_temp("apply/dodge", -sssword/2);    	
	    me->add_temp("apply/damage", -sssword/2);    	      
      
      return 1;        	
  	}
  	else
  	{  		
  		msg =HIB "\n$N杀机顿起，双目寒光闪闪，唰唰六剑急刺过来！\n" NOR;
      message_vision(msg, me);
      me->clean_up_enemy();
      ob = me->select_opponent();
      
	    me->add_temp("apply/attack", sssword/3);
	    me->add_temp("apply/dodge", sssword/3);    	
	    me->add_temp("apply/damage", sssword/3);    	      
      
      COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
      COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
      COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
      COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
      COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
      COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);     
             
      me->add("neili",-400);
			me->start_busy(random(1));
			
	    me->add_temp("apply/attack", -sssword/3);
	    me->add_temp("apply/dodge",  -sssword/3);    	
	    me->add_temp("apply/damage", -sssword/3);    	
	    
	    return 1;			
 		}
    return 1;
}

