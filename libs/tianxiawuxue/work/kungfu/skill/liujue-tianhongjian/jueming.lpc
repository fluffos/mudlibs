// jueming.c 绝命一击
// by kain
#include <ansi.h>

inherit F_SSERVER;

int perform(object me, object target)
{
 
        object weapon = me->query_temp("weapon");

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("你只能对战斗中的对手使用。\n");

        if( (int)me->query_skill("liujue-tianhongjian", 1) < 120 )
                return notify_fail("你的六绝天虹剑法不够娴熟，不会使用绝命一击。\n");
        if( (int)me->query_skill("beiming-shengong", 1) < 120 )
                return notify_fail("你的北冥神功的基础不够，不能使用绝命一击。\n");

        if( (int)me->query_dex() < 30 )
                return notify_fail("你的身法太低，不能使用绝命一击。\n");
 
        if( (int)me->query("neili", 1) < 1500 )
                return notify_fail("你现在内力不足！\n");     
      
     if( (int)me->query("qi") > (int)me->query("max_qi") /4 )
                return notify_fail("绝命一击是拼命的招数，怎可以随便使用？！\n");    

        if (!weapon || !(weapon->id("sword"))
        || me->query_skill_mapped("sword") != "liujue-tianhongjian"
        || me->query_skill_mapped("parry") != "liujue-tianhongjian")
                return notify_fail("你现在无法使用绝命一击。\n");

  message_vision(RED"\n$N面如死灰，缓缓走向$n，突然身形向前一扑，$n毫无防备的被$N双臂箍住，就在$n急于挣脱之时"
"$N突然拔出利刃意图从$n的后心刺入，跟$n拼个两败俱伤。\n\n"NOR, me, target);
  
     if(random(me->query("combat_exp")) > (int)target->query("combat_exp")/4 &&
     me->query_dex() > (int)target->query_dex()/2) {
        message_vision(HIR"\n$n一时手忙脚乱，意欲挣脱已然不能，思想一片混乱，"
"当时只有一个感觉：“$N疯了”！\n"NOR, me, target);
        tell_object(target, HIR "你感觉一柄利剑从自己身体穿过，骇怖到了极点！\n" NOR);
        
                me->add("max_neili",-100);
                me->set_temp("last_damage_from", "使用绝命一击和"+target->name()+"同归于尽");
//                me->die();
                me->set_temp("last_damage_from", "被"+me->name()+"使用绝命一击");
//                target->die();
               }
         else 
              {
                target->start_busy(5);
                message_vision(HIY"\n$n临危不乱，一蹲身子，身体从$N的双臂之中滑过，而后急退三尺，这才长舒了一口气。\n"NOR, me, target);
                me->add("max_neili",-50);
                me->set_temp("last_damage_from", "使用绝命一击");
                me->die();
              }

        return 1;
} 