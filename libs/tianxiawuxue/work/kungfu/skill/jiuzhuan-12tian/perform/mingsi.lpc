// ming.c 「冥思决」
// By Dream 19:32 05-12-19

#include <ansi.h>
inherit F_SSERVER;
int perform(object me, object target) {
  int damage;
  string msg;
  int skill, jing_cost;
  skill = me->query_skill("jiuzhuan-12tian", 1);
  if (me->query_int() < 50)
    jing_cost = (int)me->query_int() - 50;
  else jing_cost = 1;
  if (me->is_fighting())
    return notify_fail("「冥思决」不能在战斗中演练。\n");

  if (!skill || (skill < 300))
    return notify_fail("你的阴阳九转十二重天等级不够, 不能演练「冥思决」！\n");
  if (me->query("neili") < 50)
    return notify_fail("你的内力不够，没有内力演练「冥思决」！\n");
  if (me->query_skill("sword", 1) <= skill)
    return notify_fail("你的基本剑法不够，无法通过演练「冥思决」提高阴阳九转十二重天的技巧！\n");
  if (me->query("jing") < -jing_cost)
    return notify_fail("你现在太累了，无法集中精神演练「冥思决」！\n");
  msg = WHT "$N盘腿坐下，将自己所学的阴阳九转十二重天冥想了一遍。\n" + NOR;
  me->add("neili", -50);
  me->add("jing", jing_cost);
  if (skill < 500)
    me->improve_skill("jiuzhuan-12tian", 50);
  else if (skill < 600)
    me->improve_skill("jiuzhuan-12tian", 50 + random((int)me->query_int() - 9));
  else if (skill < 700)
    me->improve_skill("jiuzhuan-12tian", 50 + random((int)me->query_int() * 2 - 9));
  else if (skill < 800)
    me->improve_skill("jiuzhuan-12tian", 50 + random((int)me->query_int() * 4 - 9));
  else
    me->improve_skill("jiuzhuan-12tian", 50 + random((int)me->query_int() * 8 - 9));
  msg = MAG "$P的「阴阳九转十二重天」进步了！\n" NOR;
  if (random(10) > 8) me->start_busy(1);
  message_vision(msg, me);
  return 1;
}
