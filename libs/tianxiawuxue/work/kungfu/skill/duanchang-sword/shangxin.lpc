//kool
#include <ansi.h>
inherit F_SSERVER;
void remove_effect(object me, int amount);
int perform(object me, object target)
{
    object weapon;  
    string msg;
    int skill;
    
    if( !me->is_fighting() )
        return notify_fail("「伤心诀」只能在战斗中使用。\n");
    if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "sword")
            return notify_fail("你使用的武器不对。\n");
    if( (int)me->query_temp("shangxin") ) 
        return notify_fail("你已经在运功中了。\n");
    if( (int)me->query_skill("duanchang-sword", 1) < 500)
        return notify_fail("你的伤心断肠剑的功力不够，不能使用此项绝技！\n");
    if( (int)me->query_skill("sword") < 600)
        return notify_fail("你的剑法修为不够，不能使用此项绝技! \n");
    if( (int)me->query("neili") < 500 )
        return notify_fail("你的内力不足！\n");
    skill = me->query_skill("duanchang-sword");
    me->add("neili", -100);
    me->receive_damage("qi", 0);
    message_vision(
    HIC "$N突然领悟了伤心断肠剑的「伤心诀」，功力陡然增加！\n" NOR, me);
    me->add_temp("apply/attack", skill/2);
    me->add_temp("apply/dodge", skill/2);
    me->set_temp("shangxin", 1);
    me->start_call_out( (: call_other, __FILE__, "remove_effect", me, skill/2 :), skill);
    if( me->is_fighting() ) me->start_busy(2);
        return 1;
}

void remove_effect(object me, int amount)
{
   if ( (int)me->query_temp("shangxin") ) {
        me->add_temp("apply/attack", - amount);
        me->add_temp("apply/dodge", - amount);
        me->delete_temp("shangxin");
    tell_object(me, "你的「伤心诀」运行完毕，将内力收回丹田。\n");}
}
