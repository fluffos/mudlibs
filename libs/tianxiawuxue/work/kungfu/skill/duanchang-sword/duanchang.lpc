//kool
#include <ansi.h>
#include <combat.h>
inherit F_SSERVER;
int perform(object me, object target)
{
        string msg;
        int times;
        int i;
        object weapon;
        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("「断肠诀」只能对战斗中的对手使用。\n");

        if (!objectp(weapon = me->query_temp("weapon"))
                || (string)weapon->query("skill_type") != "sword")
                return notify_fail("你使用的武器不对。\n");

        if( (int)me->query_skill("duanchang-sword", 1) < 800 )
                return notify_fail("你的伤心断肠剑不够娴熟，不能使用「断肠诀」。\n");

        if( (int)me->query("neili") < 500  ) 
                return notify_fail("你的内力不够。\n");


        times = me->query_skill("duanchang-sword",1) / 60;
        message_vision(
        HIR "$N脸色一沉，手上动作加快，使出伤心断肠剑的［断肠诀］！\n" NOR, me);

        COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);
        msg =  HIR "在一片剑芒中，一剑劈了过来\n" NOR;
        message_vision(msg, me, target);
        for(i=0;i<times;i++)
        {
        msg = HIY "$N咬紧牙关，一剑又砍了过来！\n" NOR;
        COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);
        }
        me->add("neili", - 65 * i);
        me->start_busy(3);
        return 1;
}