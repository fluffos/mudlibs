// 开天辟地，大嵩阳手 pfm
// knightly

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
void remove_effect(object me, int amount);
int perform(object me, object target)
{
	string msg;
	int skill, dtime, tag;

	if( !target ) target = offensive_target(me);

	// pfm 指令好像检测busy状态,这里判断其实是多余的.呵呵.
	if( me->is_busy() )
		return notify_fail("忙乱中如何使得出开天绝技?");
		
  if ( !wizardp(this_player()) && (me->query("family/family_name") != "嵩山派"))
          return notify_fail("你不是嵩山派弟子不能使用大嵩阳手。\n
                              大嵩阳手是嵩山派秘传绝技，非嵩山弟子不传, 真不知道你是怎么学会的！\n
                              不过，既非嵩山派门人，自然也无法使得出其真正精髓。\n");
	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("[开天辟地]只能对战斗中的对手使用。\n");

  //if( (int)me->query_temp("dasongshangshou_kaitian") ) 
  //		return notify_fail("你已经在运功中了。\n");

	skill = (int)me->query_skill("dasongyang-shou", 1);

	if( skill < 400 )
		return notify_fail("你的大嵩阳手不够娴熟，无法使用[开天辟地]。\n");

	msg = HIR "突然$N劲气暴涨，威势逼人，举手投足间威力大为增长。\n";
	me->start_busy(random(2));
	
	// 还在效果作用过程中的话,先消除效果
	if ( me->query_temp("dasongyangshou_kaitian") ) 
			remove_effect(me, skill);
	// 然后附加效果，并标记。
	me->add_temp("apply/strength", skill/4);
	me->add_temp("apply/attack", skill/3);
	me->set_temp("dasongyangshou_kaitian", 1);				
	
	if( random(me->query("combat_exp")) > (int)target->query("combat_exp")/10 ) 
	{
		if( !target->is_busy() )
		{
			dtime = skill /100;
			if (dtime>20)
				dtime = 20;
	    msg += HIR "$p被威势所吓，竟然愣住了！\n" NOR;
			target->start_busy(random(dtime));			
			message_vision(msg, me, target);			
		}
		else
		{
				msg += HIR"$p本已身法呆滞，此时更是全无章法，$P乘机连出三式。\n"NOR;
				message_vision(msg, me, target);
				
				me->add_temp("apply/attack", skill);						
				
        msg = BLINK HIG "\n          第一式！\n" NOR;
        message_vision(msg, me, target);						
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR);
        
				msg = BLINK HIM "\n          第二式！\n" NOR;
				message_vision(msg, me, target);						
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR);
        
        msg = BLINK YEL "\n          第三式！\n" NOR;
        message_vision(msg, me, target);						
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR);
        
        me->add_temp("apply/attack", - skill);
		}		
	} 
	else 
	{
		msg += HIY "$p眼见$P突现异相，忙纵身跃开。\n" NOR;
		message_vision(msg, me, target);		
	}

	me->start_call_out( (: call_other, __FILE__, "remove_effect", me, skill :), skill/4);	
	return 1;
}

void remove_effect(object me, int amount)
{
   	if (!me) return;
   	if ( me->query_temp("dasongyangshou_kaitian") ) 
   	{
    	me->add_temp("apply/attack", - amount/3);
    	me->add_temp("apply/strength", - amount/4);
    	me->delete_temp("dasongyangshou_kaitian");
  		message_vision(HIW"$N将大嵩阳手的劲气内敛，气回丹田，一切恢复了正常。\n"NOR, me);
  	}
}