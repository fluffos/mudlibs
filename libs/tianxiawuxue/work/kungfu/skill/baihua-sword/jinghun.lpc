//百花惊魂
//dream


#include <ansi.h>
#include <combat.h>
inherit F_SSERVER;
int perform(object me, object target) {
  string msg;
  int times;
  int i;
  object weapon;
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("「百花惊魂」只能对战斗中的对手使用。\n");

  if (me->query("baihua-sword/po", 1) < 1)
    return notify_fail("你没有认真领悟,还不会使用「百花惊魂」这一绝技！\n");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");

  if ((int)me->query_skill("baihua-sword", 1) < 800)
    return notify_fail("你的百花剑法不够娴熟，不能使用「百花惊魂」。\n");

  if ((int)me->query("neili") < 500)
    return notify_fail("你的内力不够。\n");

  times = me->query_skill("baihua-sword", 1) / 100;

  message_vision(
    HIR "$N狂喝一声，手中宝剑将到之际，突然圈转，\n"
    HIM "使出百花剑法的独得之秘" HIG "「百" HIB "花" HIY "惊" HIB "魂」" HIM ",\n"
    HIC "一招之中又另蕴涵三招，招式繁复狠辣，\n"
    HIW "剑招虚虚实实，霍霍剑光径直逼向对手！\n" NOR, me);

  COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR, msg);

  msg = HIW "在一片剑芒中，一剑劈了过来，一声惨叫，对手已被凌厉的剑招刺中......\n" NOR;

  message_vision(msg, me, target);
  for (i = 0; i < times; i++) {
    msg = HIY "$N咬紧牙关，冷笑一声，手中宝剑挥洒，一剑又砍了过来！\n" NOR;

    COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR, msg);
  }
  me->add("neili", -65 * i);
  me->start_busy(3);
  return 1;
}
