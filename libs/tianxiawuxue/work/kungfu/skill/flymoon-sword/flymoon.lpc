//飞月剑 flymoon.c
// by  hhm  2005/4/10 

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>


void remove_effect(object me, int a_amount, int d_amount);

inherit F_SSERVER;
int perform(object me, object target)
{
        object weapon,ob;
        int skill;
        string msg;

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("「飞月无踪」只能在战斗中使用。\n");

	if (!objectp(weapon = me->query_temp("weapon"))
		|| (string)weapon->query("skill_type") != "sword")
                return notify_fail("「飞月无踪」必须用剑才能施展。\n");

if( (int)me->query_skill("flymoon-sword", 1) < 800 )
                return notify_fail("你的「飞月剑法」不够娴熟，不会使用「分身无影」。\n");

if( (int)me->query("neili") < 2000)
                return notify_fail("你的内力不够。\n");

        skill = me->query_skill("flymoon-sword");
        msg = HIG "$N身行突变，瞬间犹如分出无数身影闪电般的向$n攻去！\n"NOR;
        message_vision(msg, me, target);

        me->add("neili", -1000);

        me->clean_up_enemy();
        ob = me->select_opponent();
        msg = HIR"天外飞月\n"NOR;
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        msg = HIY"飞月西来\n"NOR;
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        msg = HIG"飞月惊天\n"NOR;
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        msg = HIB"飞月破空\n"NOR;
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        msg = HIW"飞月无形\n"NOR;
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);


        if( me->is_fighting() ) me->start_busy(6);

        return 1;
}
