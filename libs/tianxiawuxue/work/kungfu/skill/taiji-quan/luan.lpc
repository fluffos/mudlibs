#include <ansi.h>

inherit F_SSERVER;

int perform(object me, object target) {
  string msg;

  //       if( me->query("skill_luanhuan_on") != 1 )
  //  return notify_fail("你还不会「乱环诀」。\n");

  if (!target) target = offensive_target(me);

  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("乱环诀只能对战斗中的对手使用。\n");

  if ((int)me->query_skill("taiji-shengong", 1) < 1000)
    return notify_fail("你太极神功的功力不够，不能使用乱环诀！\n");

  if ((int)me->query_skill("taiji-quan", 1) < 1000)
    return notify_fail("你的太极拳修为不够,目前还不能使用乱环诀！\n");

  if ((int)me->query("neili") < 80000)
    return notify_fail("你内力现在不够, 不能使用乱环诀！\n");

  if (target->is_busy())
    return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧ⅵ\n");

  msg = HIG "$N使出太极拳法乱环诀，双手划出无数大圆，小圆，中圆，平圆，斜圆朝$n套去。\n";

  if (random(me->query("combat_exp")) > (int)target->query("combat_exp") / 5) {
    msg += "结果$p不知厉害，企图硬抗，被数个圆圈套中，身形沉涩，竟稳不住脚，却被太极拳力带得转起圈来！\n" NOR;
    target->start_busy((int)me->query_skill("taiji-quan", 1) / 50 + 2);
    me->add("neili", -25000);
  } else {
    msg += HIG "可是$p功力深厚，并深知太极拳乱环诀厉害之处，连忙闪身退开。\n" NOR;
    me->start_busy(2);
  }
  message_vision(msg, me, target);

  return 1;
}
