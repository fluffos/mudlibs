#include <ansi.h>

inherit NPC;

void do_bite();
int do_liandan(string arg);

void create() {
  set_name("分身", ({ "fen shen" }));
  set("long", "这是一个分身。\n");
  set("max_jing", 400);
  set("max_qi", 400);
  set("max_jingli", 100);
  set("jingli", 100);

  set("no_suck", 1);
  set("no_die", 1);
  set("demogorgon", 1);


  set("max_neili", 100);
  set("neili", 100);
  set("str", 60);
  set("int", 40);

  set_skill("unarmed", 30);
  set_skill("dodge", 30);

  set_temp("apply/damage", 15);

  setup();
}

int is_zombie() { return 1; }
void init() {
  ::init();
  add_action("do_liandan", "liandan");
  set_heart_beat(1);

}

int do_liandan(string arg) {
  object me = this_player();
  object ob = this_object();
  object enemy, temp;
  int num = 1;

  if (ob->query("owner_id") != me->query("id"))
    return 0;

  if (!arg || !objectp(enemy = present(arg, environment(me))))
    return 0;

  for (num = 1; num < 41; num++) {
    foreach (temp in all_inventory(environment(me))) {
      if (temp->query("number") == num && temp->query("owner_id") == me->query("id")) {
        message_vision(
          "\n" + HIR + me->query("name") + "连弹第" + temp->query("number") + "招\n" + NOR,
          me
        );
        COMBAT_D->do_attack(temp, enemy, query_temp("weapon"));
        destruct(temp);
      }
    }
  }
  return 1;
}

void dispell() {
  object corpse;

  if (environment()) {
    tell_room(environment(), name() + "砰的一下子就突然消失了。\n");
  }

  destruct(this_object());
}
void die() {
  dispell();
}
