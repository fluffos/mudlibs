#include <ansi.h>
//inherit SSERVER;
int conjure(object me, object target)
{
    if( target )
        return notify_fail("影分身只能对自己使用！\n");
    write("你要分几个影分身？");
    input_to( (: call_other, __FILE__, "select_target", me :));
    return 1;
}
void select_target(object me, string num)
{
	int p;
	object fenshen;
	if(!num || num=="" || (sscanf( num , "%d", p)!=1))
	{
	write( HIY "什么...不会算术啊???\n" NOR);
	return;
	}

	if(p>40 || p*2>me->query("chakela")) //每个分身要2点查克拉
	{
	write("你的查卡拉不够分那么多分身!\n");
	return;	
	}

	me->set("chakela", me->query("chakela")-p*2);
	message_vision(HIY+"$N双手按了“火，金，水”手印,一声‘影分术’后面多了" + p + "个分身!\n"+NOR, me);
	
	for(int i=0;i<p;i++)
	{
	fenshen=new("/kungfu/skill/huoying-renshu/npc/fenshen");
	fenshen->set("name", me->query("name")+"的分身");
	fenshen->set("number", i+1);
	fenshen->move(environment(me));
	fenshen->set("owner_id", me->query("id"));
	fenshen->set("jiali", me->query("jiali")*10);
	fenshen->set("combat_exp", me->query("combat_exp")/2);
	fenshen->set("neili", me->query("neili")*4);
	fenshen->set_skill("dodge", me->query_skill("dodge",1));
	fenshen->set_skill("piaomiao-shenfa", me->query_skill("dodge",1));
	fenshen->set_skill("unarmed", me->query_skill("unarmed",1));
	fenshen->set_skill("liumai-shenjian", me->query_skill("unarmed",1));
	fenshen->command("enable unarmed liumai-shenjian");
	fenshen->command("enable dodge piaomiao-shenfa");

	call_out("dispell", 60, fenshen);  //1分钟后消失
	}
	return;
}

