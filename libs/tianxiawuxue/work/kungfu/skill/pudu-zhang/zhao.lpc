#include <ansi.h>

inherit F_SSERVER;

int perform(object me) {
  string msg;
  object weapon, target;
  int skill, neili, ap, dp, neili_wound, qi_wound;
  me->clean_up_enemy();
  target = me->select_opponent();
  skill = me->query_skill("pudu-zhang", 1);
  neili = me->query("neili", 1);
  if (!(me->is_fighting()))
    return notify_fail("「佛光普照」只能对战斗中的对手使用。\n");
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "staff")
    return notify_fail("你使用的武器不对。\n");
  if (skill < 250)
    return notify_fail("你的普渡杖法等级不够, 不能使用「佛光普照」！\n");
  if (me->query("neili") < 500)
    return notify_fail("你的内力不够，无法运用「佛光普照」！\n");

  if (me->query_temp("perform"))
    return notify_fail("你上一招没完成, 不能使用「佛光普照」！\n");
  msg = HIY "$N使出普渡杖法的绝技「佛光普照」\n";
  message_vision(msg, me, target);

  ap = me->query("combat_exp") + skill * 100 + neili * 10;
  dp = target->query("combat_exp") / 2 + skill * 100 + neili * 5;
  if (dp < 1)
    dp = 1;
  if (random(ap) > dp) {
    if (userp(me))
      me->add("neili", -250);
    msg = "$N使出「佛光普照」，直取$n的气海大穴，$n只觉丹田之气狂泄而出！\n" NOR;
    neili_wound = 2000 + random(neili / 100);
    if (neili_wound > target->query("neili"))
      neili_wound = target->query("neili");
    qi_wound = neili_wound / 5;
    if (qi_wound > target->query("qi"))
      qi_wound = target->query("qi");
    target->add("neili", -neili_wound);
    target->add("qi", -qi_wound);
    target->add("eff_qi", -qi_wound);
    target->start_busy(2);
  } else {
    if (userp(me))
      me->add("neili", -100);
    msg = "可是$n早有防备，运去内功心法紧守自己的门户，艰难的抵挡住$N的攻击。" NOR;
  }
  me->set_temp("perform", 1);
  call_out("perform_end", 3, me);
  message_vision(msg, me, target);
  return 1;
}
void perform_end(object me) {
  if (!me) return;
  me->delete_temp("perform");
}
