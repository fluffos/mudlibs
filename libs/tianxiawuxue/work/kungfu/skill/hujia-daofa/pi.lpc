// hui.c 「练习」
#include <ansi.h>
inherit F_SSERVER;
int perform(object me)
{
    string msg;
    object weapon;
   int skill, jing_cost, exp;
    skill = me->query_skill("hujia-daofa",1);
    if (me->query_int()<50)
        jing_cost = (int)me->query_int() - 50;
    else    jing_cost=1;
    if( me->is_fighting() )
        return notify_fail("「劈刀绝」不能在战斗中演练。\n");
 
    if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
        return notify_fail("你必须先去找一把刀。\n");
    if( !skill || (skill < 9))
        return notify_fail("你的胡家刀法等级不够, 不能演练「劈刀绝」！\n");
    if( me->query("neili") < 50 )
        return notify_fail("你的内力不够，没有力气演练「劈刀绝」！\n");
    if (me->query_skill("blade",1)<= skill)
        return notify_fail("你的基本刀法不够，无法通过演练「劈刀绝」提高胡家刀法的技巧！\n");
    if( me->query("jing") < -jing_cost )
        return notify_fail("你现在太累了，无法集中精神演练「劈刀绝」！\n");
   exp= (int)me->query("combat_exp");
        if( skill*skill*skill/10>exp )
           return notify_fail("你的实战经验不够，无法体会「劈刀绝」！\n");
    msg = HIC "$N使出胡家刀法之「劈刀绝」，将手中" + weapon->name() + HIC "拼命劈砍。\n" + NOR;
    message_vision(msg, me);
    me->add("neili", -50);
    me->add("jing", jing_cost);
    if ( skill < 9)
        me->improve_skill("hujia-daofa", 10);
    else if (skill < 60)
        me->improve_skill("hujia-daofa", 10 + random((int)me->query_int() - 9));
    else if (skill < 140)
        me->improve_skill("hujia-daofa", 10 + random((int)me->query_int() * 2 - 9));
    else if (skill < 200)
        me->improve_skill("hujia-daofa", 10 + random((int)me->query_int() * 4 - 9));
    else
        me->improve_skill("hujia-daofa", 10 + random((int)me->query_int() * 8 - 9));
    msg = MAG"$P的「胡家刀法」进步了！\n"NOR;
    if (random(10)<8)    me->start_busy(random(3));
    message_vision(msg, me);
    return 1;
}
