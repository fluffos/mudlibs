#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;

int perform(object me, object target) {
  string msg;
  int extra;
  object weapon;
  extra = me->query_skill("hujia-daofa", 1);
  if (!target) target = offensive_target(me);
  if (!me->is_fighting())
    return notify_fail("胡家刀法「绝杀」只能在战斗中使用。\n");
  if (me->query_temp("perform")) return notify_fail("你上一招未使完！\n");
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
    if (!objectp(weapon = me->query_temp("secondary_weapon"))
      || (string)weapon->query("skill_type") != "blade")
      return notify_fail("你使用的武器不对。\n");
    else me->set_temp("secondly_weapon", 1);
  if ((int)me->query("neili") < 500)
    return notify_fail("你的真气不够！\n");
  if ((int)me->query_skill("lengyue-shengong", 1) < 1000)
    return notify_fail("你的冷月神功不够娴熟，无法施展出「绝杀」。\n");
  if ((int)me->query_skill("blade") < 1000 ||
    me->query_skill_mapped("blade") != "hujia-daofa")
    return notify_fail("你的「胡家刀法」还不到家，无法使用「绝杀」！\n");
  me->add("neili", -1000);
  msg = YEL "$N提刀前胸,忽然身体像幽灵一样飞去,言来这就是胡家刀法的终极绝技「" + HIY "绝" NOR + HIC "天" NOR + HIW "灭" NOR + HIR "地" NOR + "」一招八式劈向$n！" NOR;
  message_vision(msg, me, target);
  msg = HIC "绝杀" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIR "绝杀" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIB "绝杀" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIY "绝杀" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIG "绝杀" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIM "绝杀" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = YEL "绝杀" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIW "绝杀" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);


  me->add_temp("apply/strength", -extra);
  me->add_temp("apply/attack", -extra);
  me->start_busy(5);
  return 1;
}
