int valid_enable(string usage) { return (usage == "sword") || (usage == "parry"); }

int valid_learn(object me)
{   
    int lvl = (int)me->query_skill("flymoon-sword", 1);
    if ( me->query("gender") == "无性" && lvl > 49)
        return notify_fail("你无根无性，阴阳不调，难以领会高深的飞月剑法。\n");
    if ( me->query("gender") != "男性")
        return notify_fail("飞月剑法需要阳刚之气，不适合你学。\n");
    if ( me->query("kar") < 29)
        return notify_fail("飞月剑法只传授有缘之人，阁下请回吧。\n");
    if ((int)me->query_skill("force", 1) < 1000)
        return notify_fail("你的基本内功火候还不够，无法领会飞月剑法。\n");
    if ((int)me->query_skill("sword", 1) < 1000)
        return notify_fail("你的基本剑法火候还不够，无法领会飞月剑法。\n");
    if (me->query_skill("sword",1)<=lvl)
        return notify_fail("你的基本剑法基础不够，再学下去会走火入魔的。\n");
    if ((int)me->query_skill("flymoon-xinfa", 1) < 480)
                return notify_fail("你的「飞月心法」火候不够，无法学「飞月剑法」。\n");
        if ((int)me->query("max_neili") < 500)
                return notify_fail("你的内力太弱，无法练「飞月剑法」。\n");
    if ((int)me->query_skill("flymoon-sword",1) > 500)
                return notify_fail("这套剑法我就教到这儿，以后就要靠你自己练了。\n");             
        return 1;
}

mapping query_action(object me, object weapon)
{
        int i, level;
	level   = (int) me->query_skill("flymoon-sword",1);
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"])
                        return action[NewRandom(i, 20, level/4)];
}

