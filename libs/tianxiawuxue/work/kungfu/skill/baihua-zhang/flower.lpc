//天女散花 
// dream 


#include <ansi.h>
inherit F_SSERVER;
int perform(object me, object target)
{
	      int lvl;
        string msg;
        int damage, ap, dp;
        int number, size, i, four,amount;
        object *tar;

        if( !target ) target = offensive_target(me);
     
      if( !target || !me->is_fighting(target) )
      return notify_fail("「天女散花」只能在战斗中对对手使用。\n");
             
      if(me->query_temp("weapon"))
      return notify_fail("你必须空手使用「天女散花」！\n");
      
      if( (int)me->query_skill("baihua-zhang",1) < 800 )
      return notify_fail("你的散花掌不够娴熟，不能使用「天女散花」！\n");
      
  //    if( (int)me->query_skill("baihua-gong",1) < 800 )
  //    return notify_fail("你的百花内功等级不够，不能使用「天女散花」！\n");  
      
      if( (int)me->query_str() < 30 )
      return notify_fail("你的臂力不够强，不能使用「天女散花」！\n");
      
      if( (int)me->query("neili") < 800 )
      return notify_fail("你的内力太弱，不能使用「天女散花」！\n");
      
      if(me->query("family/family_name") != "百花宫")
        return notify_fail("[天女散花]是百花宫不传之密！\n");
        
     if( (int)me->query("max_neili") < 50000 )
	      return notify_fail("你的内力修为还不够高。\n");
	      
	   if( me->query_temp("weapon"))
                return notify_fail("你先放下手中的武器再说吧？！\n");   

        tar=all_inventory(me);
        size = sizeof(tar); 
        if(size) {
                for(i=0;i<size;i++)
                if(tar[i]->query("material") == "flower") {
                        if (tar[i]->query_amount())
                              number+=tar[i]->query_amount();
                        else number++;
                }
        }
        write((string)number+"\n");
        
        if((int)number < 1)
                return notify_fail("你的花不足以施展「天女散花」！\n");

        me->add("force", -500);
        me->receive_damage("qi", 100);
        msg = HIR
"\n$N微微一笑，身子凌空而起，洒下漫天花雨，一时花香缭绕\n"+
HIM"$n只觉周身都被花影罩住了，一时竟然不知如何招架，更不用说躲闪了！\n" NOR;

        ap = me->query_skill("baihua-zhang", 1);
        ap = ( ap * ap * ap / (4 * 400) );
        ap = ap*250 + (int)me->query("combat_exp");
        dp = target->query_skill("parry");
        dp = ( dp * dp * dp / (4 * 400) );
        dp = dp*250 + target->query("combat_exp"); 
        if( random((ap + dp)/1000+1) <  dp/1000 ) {
                msg += HIG "谁知$n竟险中求胜，长袖一摆，已将所有花瓣打落！\n\n"NOR;
                message_vision(msg, me, target);
        } else {
                damage = (int)me->query_skill("baihua-zhang",1) / 10 +
                        (int)me->query("jing") / 400 + random((int)me->query("jing") / 200 ) +
                        (int)me->query("qi") / 400 + random((int)me->query("qi") / 200 );
                msg += HIC "这些花瓣看似柔弱无力，却如疾风骤雨般射向$n,深深的嵌入肉里！\n" NOR;
                if (number < 10) damage = damage *  (random(number+1)/5);
                else damage = damage * (random(10)/5);
                        target->receive_damage("qi", me->query("eff_qi")*damage/100, me);
                        target->receive_damage("jing", me->query("eff_jing")*damage/70, me);
                        me->improve_skill("baihua-zhang", 1, 1);
                message_vision(msg, me, target);
                COMBAT_D->report_status(target);
         }


        if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
        }
        
        for (i = 0; i< size; i++){
           if (tar[i]->query("material") == "flower"){
                amount=tar[i]->query_amount();
                if (amount) four+=amount;
                  else four++;
                if (four <= 1)
                destruct(tar[i]);
                else {
                       tar[i]->set_amount(four-1);
                       four=1;
                       break;
                }
           }
        }
        me->start_busy(3);
        return 1;
}
