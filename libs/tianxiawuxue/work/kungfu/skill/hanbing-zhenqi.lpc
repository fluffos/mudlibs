// 寒冰真气
// hanbing-zhenqi.c
// knightly

#include <ansi.h>
inherit FORCE;

mapping *action = ({

  ([ "action":
    "$N使出一招「" CYN "天寒地冻" NOR "」，左手聚出一团寒冰真气击向$n的$l",
    "force": 300,
    "damage_type": "瘀伤"

  ]),

  ([ "action":
    "$N使出一招「" HIW "千里冰封" NOR "」，右手聚出一团寒冰真气罩向$n的$l",
    "force": 500,
    "damage_type": "瘀伤"

  ]),

  ([ "action":
    "$N使出一招「" HIR "万里雪飘" NOR "」，双手由掌变拳，聚出一团寒冰真气击向$n的$l",
    "force": 700,
    "damage_type": "瘀伤"
  ]),

  ([ "action":
    "$N使出一招「" BLU "九幽阴极" NOR "」，全身腾空而起，化作一团寒冰真气击向$n的$l",
    "force": 1000,
    "damage_type": "瘀伤"
  ]),

});

int ob_hit(object ob, object me, int damage) {
  int myjob, skill, dmper, dm;

  myjob = (int)me->query("familyjob/songshan/getpay");
  skill = (int)me->query_skill("hanbing-zhenqi", 1);

  // 返回要减少伤害值 		
  if (me->query_skill_mapped("dodge") == "hanbing-zhenqi") {
    if (myjob > 1200) {
      dmper = myjob / 100;
      dm = damage / dmper;
      if (dm <= 0)
        dm = 1;
      message_vision(HIG "眼看$N这一招正要击中$n，却被$n的寒冰真气的力道一带，化解了大半威力！\n" NOR, ob, me, ob);
      return -dm;
    } else if (skill > 800) {
      dmper = skill / 200;
      dm = damage / dmper;
      message_vision(HIB "眼看$N这一招正要击中$n，却被$n的寒冰真气的力道一带，避开了要害！\n" NOR, ob, me, ob);
      return -damage / 3;
    } else {
      dmper = 3;
      dm = damage / dmper;
      message_vision(MAG "眼看$N这一招正要击中$n，却被$n的寒冰真气的力道一带，稍微失去了准头！\n" NOR, ob, me, ob);
      return -dm;
    }
  } else
    return -damage;
}


mixed hit_ob(object me, object victim, int damage_bonus) {
  int myjob, mydex, vtdex, mydodge, vtdodge, dtime;

  myjob = (int)me->query("familyjob/songshan/getpay");

  if (damage_bonus < 200) {
    mydex = (int)me->query("dex");
    vtdex = (int)victim->query("dex");

    if ((2 * random(mydex)) > random(vtdex)) {
      if (me->query_skill_mapped("dodge") == "hanbing-zhenqi") {
        mydodge = me->query_skill("dodge", 1);
        vtdodge = victim->query_skill("dodge", 1);
        dtime = mydodge - vtdodge;
        if (dtime < 0)
          dtime = 1;
        dtime = random(dtime);
        if (myjob > 2400)
          dtime = dtime + random(myjob / 1000);
        if (dtime > 0) {
          victim->start_busy(dtime);
          return HIB "$N闪躲之间，几丝不易察觉的劲气已经悄然缠住了$n。\n" NOR;
        }
      }
    }
    return 0;
  } else if (random(6 * (me->query_skill("hanbing-zhenqi", 1))) > (damage_bonus)) {
    if (random(6) > 4) {
      victim->receive_wound("jing", (damage_bonus));
      dtime = 2 + random(me->query("kar", 1));
      if (myjob > 2400)
        dtime = dtime + random(myjob / 1000);
      victim->start_busy(dtime);
      return HIC "$n抵挡不住$N的寒冰真气，被内劲侵入，慌张不迭，不知所措。\n" NOR;
    } else {
      victim->receive_wound("qi", (damage_bonus + random(dtime)));
      victim->receive_wound("jing", (damage_bonus + random(dtime)));
      victim->add("neili", -(int)me->query("jiali"));
      return HIR "$N的寒冰真气摧毁了$n的真元！！！！\n" NOR;
    }
  }
}

int valid_enable(string usage) {
  return usage == "dodge" || usage == "force";
}

int valid_learn(object me) {
  mapping myfam;
  int myskill, fmcount;

  myfam = (mapping)me->query("family");
  myskill = (int)me->query_skill("hanbing-zhenqi", 1);
  fmcount = (int)me->query("familyjob/songshan/GetPay");

  if (!myfam || myfam["family_name"] != "嵩山派") {
    return notify_fail("寒冰真气只有嵩山派的人才可以学习。\n");
  }
  if ((me->query("gender") != "男性") && (me->query("gender") != "女性"))
    return notify_fail("寒冰真气需要阴阳调和，无根之人无法学习。\n");
  if (me->query("MKS", 1) < 5000)
    return notify_fail("寒冰真气需要冷血的人才能习得，你手上沾血太少，不适合学习。\n");
  if (me->query("kar") < 30)
    return notify_fail("寒冰真气有干天和，容易折寿，只富大之人方可学习，阁下请回吧。\n");
  if (me->query("shen") > 0)
    return notify_fail("寒冰真气在所谓正派人士手中无法发挥威力，阁下请回吧。\n");
  if ((int)me->query("combat_exp", 1) < 100000000)
    return notify_fail("你的武学经验还不够，小心走火入魔。\n");
  if ((myskill > 100) && (fmcount < 150) ||
    (myskill > 300) && (fmcount < 200) ||
    (myskill > 500) && (fmcount < 300) ||
    (myskill > 800) && (fmcount < 500) ||
    (myskill > 1000) && (fmcount < 800) ||
    (myskill > 1500) && (fmcount < 1000) ||
    (myskill > 2000) && (fmcount < 1300) ||
    (myskill > 2400) && (fmcount < 1500) ||
    (fmcount < 100))
    return notify_fail("你对师门贡献尚浅，为师不能将此神功轻易相授。\n");
  if ((int)me->query_skill("force", 1) < 1500)
    return notify_fail("你的基本内功火候还不够，无法研习寒冰真气。\n");
  if ((me->query_skill("hanbing-zhenqi", 1) > 600) && myfam["master_id"] != "zuo lengchan")
    return notify_fail("你目前的寒冰真气境界只有向左冷禅学习才可能进步。\n");

  return 1;
}

int practice_skill(object me) {
  return notify_fail("寒冰真气只能用学的，或是从运用(exert)中增加熟练度。\n");
}

int effective_level() { return 21; }

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

string *dodge_msg = ({
  "只见$n一招「" + HIC + "风生水起" + NOR + "」，身体向上笔直地纵起丈余，躲过了$N这一招。\n",
  "$n一个「" + HIW + "风卷残云" + NOR + "」，向后纵出数丈之远，避开了$N的凌厉攻势。\n",
  "$n使出「" + CYN + "冷若冰霜" + NOR + "」，原地一个美妙的转身，轻描淡写地化解了$N的所有进攻。\n",
  "$n一招「" + HIB + "浮光掠影" + NOR + "」，身形顿时虚化，$N完全看不清楚，所有招式都落空。\n"
});

string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}

string exert_function_file(string func) {
  return __DIR__ "hanbing-zhenqi/" + func;
}
