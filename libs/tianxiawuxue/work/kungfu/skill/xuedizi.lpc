// xuedizi.c 血滴子


inherit SKILL;

mapping *action = ({
([      "action":       "$N身形一转,高高跃起,一招『血影无涯』,手中$w笔直向$n当头罩下",
        "force":        100,
        "dodge":        20,
        "damage":       90,
        "lvl":          150,
        "skill_name":   "血影无涯",
        "damage_type":  "内伤"
])
});

int valid_enable(string usage) {return(usage == "whip") || (usage == "parry");}

int valid_learn(object me)
{
        if( (int)me->query("max_neili") < 200)
                return notify_fail("你的内力还不足以练这种霸道武功.\n");
        return 1;
}
mapping query_action(object me, object weapon)
{
        int i, level;
        level = (int)me->query_skill("xuedizi", 1);
i = sizeof(action);
                if(level > 10)
                return action[random(i)];
}

