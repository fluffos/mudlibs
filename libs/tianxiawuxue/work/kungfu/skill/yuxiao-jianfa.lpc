// 此武学已达绝高境界，希不要随便修改里面的伤害条件，
// 否则会招成其他武学的不平衡。
inherit SKILL;
string *xue_name = ({
  "劳宫穴", "膻中穴", "曲池穴", "关元穴", "曲骨穴", "中极穴", "承浆穴", "天突穴", "百会穴"
  ,
  "幽门穴", "章门穴", "大横穴", "紫宫穴", "冷渊穴", "天井穴", "极泉穴", "清灵穴", "至阳穴"
  , });
mapping *action = ({
  ([ "action": "$N怀抱$w，跨前一步身形微沉左膝略曲，剑势如匹的攻向$n，正是一招「" + RED + "百鸟朝凰" + NOR + "」。",
    "force": 120,
    "dodge": -10,
    "damage": 20,
    "lvl": 0,
    "skill_name": "百鸟朝凰",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N横过$w一式「" + CYN + "垄玉吹萧" + NOR + "」横切$n的颈部，攻势奇幻之极。",
    "force": 140,
    "dodge": -10,
    "damage": 30,
    "lvl": 9,
    "skill_name": "垄玉吹萧",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N脚下踏着八卦方位，$w以一式「" + YEL + "清羽之音" + NOR + "」中宫直进，势如破竹攻向$n胸口。",
    "force": 160,
    "dodge": 5,
    "damage": 40,
    "lvl": 18,
    "skill_name": "清羽之音",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N手中$w去势弱有若无般挑向$n右肩，却是一招「" + BLK + "一音奚奚" + NOR + "」。",
    "force": 180,
    "dodge": 10,
    "damage": 55,
    "lvl": 27,
    "skill_name": "一音奚奚",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N手中$w一抖正是一式「" + GRN + "昆岗凤鸣" + NOR + "」，只见那剑势忽高忽低，愈变愈奇刺向$n。",
    "force": 220,
    "dodge": 15,
    "damage": 60,
    "lvl": 100,
    "skill_name": "昆岗凤鸣",
    "damage_type": "刺伤"
  ]),
  ([ "action": "只见$N身形一晃$w使出「" + BLU + "萧史乘龙" + NOR + "」如形随影的攻向$n后背。",
    "force": 360,
    "dodge": 5,
    "damage": 65,
    "lvl": 120,
    "skill_name": "萧史乘龙",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N使出「" + MAG + "巴山夜雨" + NOR + "」迅速的抖动手中$w幻化出无数个光点，剑势如同暴风骤雨般的攻向$n。",
    "force": 400,
    "dodge": 5,
    "damage": 70,
    "lvl": 150,
    "skill_name": "巴山夜雨",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N一声长叹使出「" + RED + "曲终人散" + NOR + "」，长袖一挥只见$w从重重袖影中飞出，点向$n的咽喉要害，随及身形飘然离去。",
    "force": 600,
    "dodge": 5,
    "damage": 80,
    "lvl": 200,
    "skill_name": "曲终人散",
    "damage_type": "刺伤"
  ]),
});
int valid_enable(string usage) {
  return (usage == "sword") || (usage == "parry");
}
int valid_learn(object me) {
  if ((int)me->query("max_neili") < 5000)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_skill("bibo-shengong", 1) < 100)
    return notify_fail("你的碧波神功火候太浅。\n");

  return 1;
}
mapping query_action(object me, object weapon) {
  mapping a_action;
  int level = me->query_skill("yuxiao-jianfa", 1);
  if (random(me->query_skill("sword")) > 300 &&
    me->query_skill("force") > 60 &&
    me->query("neili") > 100 &&
    (string)weapon->query("id") == "yu xiao") {
    me->add("neili", -1000);
    return ([
      "action": HIG "$N手中玉萧自发啸声，顿时绵绵不绝的剑气有如怒潮般涌向$n" NOR,
      "attack": 1200,
      "damage": 1200,
      "dodge": -level * 2,
      "force": 1200,
      "need_force": 1000,
      "damage_type": "内伤" ]);
  }
  a_action = action[random(sizeof(action))];
  a_action["dodge"] = 0 - level;
  a_action["damage"] = level;
  return a_action;
}
mixed hit_ob(object me, object victim, int damage_bonus) {

  string name, weapon;
  name = xue_name[random(sizeof(xue_name))];

  if (damage_bonus < 100) return 0;

  if (random(damage_bonus / 2) > victim->query_str()) {
    //                victim->add("qi", 1 - damage_bonus - 100 * 3 );
    victim->receive_wound("qi", (damage_bonus - 100) / 2);
    return HIR "你听到耳边传来一阵阵萧声，顿时血气翻滚，一股热流穿心而过！\n" NOR;
  }


  if (me->query_skill("yuxiao-jianfa", 1) > 100
    && me->query("neili") > 5000
    && me->query_skill_mapped("force") == "bibo-shengong"
    && victim->query("force") > 100) {
    victim->add("neili", -random(10));
  }
  if (victim->is_busy()) return 0;
  if (!objectp(weapon = me->query_temp("weapon"))) {
    if ((!random(10)) && (me->query("neili") > 10000) && me->query_skill(
      "yuxiao-jianfa",
      1
    ) > 200) {
      victim->start_busy(2);
      me->add("neili", -300);
      victim->add("neili", -60);
      return HIB "$n被$N剑上所附的螺旋劲气侵入" RED + name + CYN "，" +
        "顿时经脉倒转，痛苦万分！\n" NOR;
    }
  } else {
    if ((!random(10)) && (me->query("neili") > 20000) && me->query_skill(
      "yuxiao-jianfa",
      1
    ) > 300) {
      victim->start_busy(2);
      me->add("neili", -500);
      victim->add("neili", -300);
      victim->receive_damage("qi", me->query_skill("yuxiao-jianfa", 1)
        / 10);
      victim->receive_wound("qi", me->query_skill("yuxiao-jianfa", 1) / 30);

      return HIB "$n被$N剑上所附的螺旋劲气侵入" RED + name + CYN "，" +
        "顿时经脉倒转，痛苦万分！\n" NOR;
    }
  }

}
int practice_skill(object me) {
  object weapon;
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("qi") < 50)
    return notify_fail("你的体力不够练玉箫剑法。\n");
  me->receive_damage("qi", 30);
  return 1;
}
string perform_action_file(string action) {
  return __DIR__ "yuxiao-jianfa/" + action;
}
