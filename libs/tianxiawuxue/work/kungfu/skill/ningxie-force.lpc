// ningxie-force.c  【百花凝血功】

#include <ansi.h>
inherit FORCE;

mixed hit_ob(object me, object victim, int damage_bonus)
{
    if( damage_bonus < 100 ) return 0;
    if (damage_bonus >500)
    		  damage_bonus = 500;
   if( random(3*(me->query_skill("ningxie-gong",1))) > (victim->query_con() )) {
                        victim->receive_wound("qi", (damage_bonus)/3);
                        victim->add("neili", -(int)me->query("jiali"));
                        return HIB "$N发挥出"+HIR+"百花凝血功"NOR HIB"的精髓,摧毁了$n的真元！\n" NOR;
        }
}

int valid_enable(string usage) 
{ 
        return      usage=="force";

}

int valid_learn(object me)
{
    mapping skl;
    string *sname;
    int i;
    int lvl = (int)me->query_skill("ningxie-gong", 1);
    if ( me->query("gender") == "无性" && lvl > 49)
        return notify_fail("你无根无性，阴阳不调，难以领会高深的百花凝血功。\n");
     if (me->query("kar") < 30)
       return notify_fail("你的富缘不够领会不了高深的百花凝血功。\n");
     if (me->query_skill("force") < 2000)
       return notify_fail("你的基本内功不够，领会不了高深的百花凝血功。\n");         
     if (me->query_skill("force",1)<=lvl)
        return notify_fail("你的基本内功基础不够，再学下去会走火入魔的。\n");
    skl = me->query_skills();
    sname  = keys(skl);
    for (i=0;i<sizeof(skl);i++){
        if (sname[i]=="damo-force") continue;
        if (sname[i]=="tiexue-shengong") continue;
        if (sname[i]=="jiuyang-shengong") continue;
        if (sname[i]=="emei-jiuyang") continue;
        if (sname[i]=="beiming-shengong") continue;
            if( SKILL_D(sname[i])->valid_enable("force") )
        return notify_fail("你不先散了别派内功，怎能学百花凝血功？！\n");
    }
    return 1;
}

int practice_skill(object me)
{
        return notify_fail("百花凝血功只能用学的，或是从运用(exert)中增加熟练度。\n");
}

int effective_level() { return 21; }



int stage(int level)
{
	if( level <10 ) return 1;
	else if ( level < 20 ) return 2;
	else if ( level < 40 ) return 3;
	else if ( level < 70 ) return 4;
	else if ( level < 110 ) return 5;
	else if ( level < 160 ) return 6;
	else if ( level < 220 ) return 7;
	else if ( level < 290 ) return 8;
	else return 9;
}

string level_description(int level)
{
	if ( stage(level) < 3 )
		return BLU "第"+chinese_number( stage(level) )+"重　" NOR;
	else if ( stage(level) < 5 )
		return HIB "第"+chinese_number( stage(level) )+"重　" NOR;
	else if ( stage(level) < 7 )
		return YEL "第"+chinese_number( stage(level) )+"重　" NOR;
	else if ( stage(level) < 9 )
		return CYN "第"+chinese_number( stage(level) )+"重　" NOR;
	else 
		return HIW "第"+chinese_number( stage(level) )+"重　" NOR;
}

