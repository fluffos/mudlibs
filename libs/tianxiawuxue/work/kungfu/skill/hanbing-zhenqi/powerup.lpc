// 寒冰真气 powerup.c
// 其他内功powerup的基础上可以叠加寒冰的效果，但是寒冰powerup后其他内功不能叠加。
// knightly

#include <ansi.h>
void remove_effect(object me, int amount);
int exert(object me, object target) {
  int skill;
  if (target != me) return notify_fail("你只能用寒冰真气提升自己的战斗力。\n");
  if ((int)me->query("neili") < 100)
    return notify_fail("你的内力不够!");
  if ((int)me->query_temp("hanbingforce_powerup"))
    return notify_fail("你已经在运功中了。\n");
  skill = me->query_skill("hanbing-zhenqi", 1);
  if (skill < 400)
    return notify_fail("你的寒冰真气还不够娴熟。\n");
  me->add("neili", -100);

  message_vision(
    HIC "$N默运功力，内息全身加速运行，运起寒冰真气在身体周围形成一个奇异的气场。\n" NOR, me);
  me->add_temp("apply/attack", skill / 2);
  me->add_temp("apply/dodge", skill / 2);
  me->add_temp("apply/armor", skill / 3);
  me->set_temp("hanbingforce_powerup", 1);
  me->set_temp("powerup", 1);
  me->add("bellicosity", skill);
  me->start_call_out((: call_other, __FILE__, "remove_effect", me, skill :), skill);

  if (me->is_fighting()) me->start_busy(3);

  return 1;
}
void remove_effect(object me, int amount) {
  if (!me) return;
  if ((int)me->query_temp("hanbingforce_powerup")) {
    me->add_temp("apply/attack", -amount / 2);
    me->add_temp("apply/dodge", -amount / 2);
    me->add_temp("apply/armor", -amount / 3);
    me->delete_temp("hanbingforce_powerup");
    me->delete_temp("powerup");
    message_vision(HIW "$N的寒冰真气运行完毕，将内力收回丹田，周围又恢复了正常。\n" NOR, me);
  }
}
int clean_up() {
  return 1;
}
void reset() {}
