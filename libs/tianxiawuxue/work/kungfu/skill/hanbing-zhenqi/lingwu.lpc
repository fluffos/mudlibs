// lingwu.c 领悟，寒冰真气自练
// knightly

#include <ansi.h>
inherit F_SSERVER;
int exert(object me, object target) {
  int damage;
  string msg;
  int skill, jing_cost;
  skill = me->query_skill("hanbing-zhenqi", 1);
  if (me->query_int() < 100)
    jing_cost = (int)me->query_int() - 50;
  else
    jing_cost = 1;

  if (me->is_fighting())
    return notify_fail("寒冰真气需要静下心来，沉思领悟。\n");
  if (!skill || (skill < 1000))
    return notify_fail("你的寒冰真气等级不够, 不能领悟！\n");
  if (me->query_skill("force", 1) < 1500)
    return notify_fail("你的基本内功修为不够，无法领悟！\n");
  if (me->query("max_neili") < 10000)
    return notify_fail("你的内力修为不够，无法领悟！\n");
  if (me->query("jing") < -jing_cost)
    return notify_fail("你现在太累了，无法集中精神领悟！\n");
  msg = WHT "$N盘腿坐下，运气内息遍走奇经八脉，仔细领悟寒冰真气的神髓。\n" + NOR;
  me->add("neili", -50);
  me->add("jing", jing_cost);
  if (skill < 1200)
    me->improve_skill("hanbing-zhenqi", 20 + random(30));
  else if (skill < 1500)
    me->improve_skill("hanbing-zhenqi", 50 + random((int)me->query_int() - 9));
  else if (skill < 1800)
    me->improve_skill("hanbing-zhenqi", 50 + random((int)me->query_int() * 2 - 9));
  else if (skill < 2000)
    me->improve_skill("hanbing-zhenqi", 50 + random((int)me->query_int() * 4 - 9));
  else if (skill < 2300)
    me->improve_skill("hanbing-zhenqi", 60 + random((int)me->query_int() * 4 - 8));
  else if (skill < 2500)
    me->improve_skill("hanbing-zhenqi", 80 + random((int)me->query_int() * 4 - 7));
  else
    me->improve_skill("hanbing-zhenqi", 100 + random((int)me->query_int() * 8 - 9));

  if (skill < 2500)
    me->add("learned_points", 10 + random(40));
  else
    me->add("learned_points", 10 + random(10));

  msg = HIW "$P的「寒冰真气」进步了！\n" NOR;

  if (random(8) > 6)
    me->start_busy(1);
  message_vision(msg, me);

  return 1;
}
