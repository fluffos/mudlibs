// powerup.c 化蛇大法

#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me, int amount);

int exert(object me, object target)
{
	int skill;

       if( target != me ) return notify_fail("你只能用铁血神功提升自己的战斗力。\n");

	if( (int)me->query("neili") < 500 )	return notify_fail("你的内力不够。\n");
       if( (int)me->query_temp("powerup") ) return notify_fail("你已经在运功中了。\n");

	skill = me->query_skill("tiexue-shengong",1)/3;

	me->add("force", -1000);
 
	message_vision(
        HIR "$N运起铁血神功,头顶红气翻腾，全身肌肤浮现金色的祥云，双目正义凛然,让人不敢丝毫侵犯！\n" NOR, me);

    me->add_temp("apply/armor", skill);
    me->add_temp("apply/unarmed", skill);
    me->add_temp("apply/attack", skill);
	me->set_temp("powerup", 1);

    me->start_call_out( (: call_other, __FILE__, "remove_effect", me, skill :), skill);

	if( me->is_fighting() ) me->start_busy(2);

	return 1;
}

void remove_effect(object me, int amount)
{
   if ( (int)me->query_temp("powerup") ) {
       me->add_temp("apply/unarmed", -amount);
    me->add_temp("apply/attack",-amount);
       me->add_temp("apply/armor",-amount);
	me->delete_temp("powerup");
      tell_object(me, "你的铁血神功运行完毕，身体逐渐恢复正常。\n");}
}
