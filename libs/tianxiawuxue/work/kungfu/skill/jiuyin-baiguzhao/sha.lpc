#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;

int perform(object me, object target)
{
        string msg;
	 int extra;
	 object weapon;
        extra = me->query_skill("jiuyin-baiguzhao",1);
	 if( !target ) target = offensive_target(me);
        if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
                return notify_fail("「"+HIY"绝"NOR+HIC"天"NOR+HIW"灭"NOR+HIR"地"NOR+"」只能对战斗中的对手使用。\n");

               if( objectp(me->query_temp("weapon")) )
              return notify_fail("你必须空手使用「"+HIY"绝"NOR+HIC"天"NOR+HIW"灭"NOR+HIR"地"NOR+"」！\n");
     
        if( (int)me->query_skill("jiuyin-baiguzhao", 1) < 1500 )
                return notify_fail("你的九阴白骨爪不够娴熟，无法施展出「"+HIY"绝"NOR+HIC"天"NOR+HIW"灭"NOR+HIR"地"NOR+"」。\n");
       
        if ( (int)me->query("max_neili") < 2000)
                return notify_fail("你的内力不够，无法施展出「"+HIY"绝"NOR+HIC"天"NOR+HIW"灭"NOR+HIR"地"NOR+"」。\n");
        if ( (int)me->query("neili") < 1500)
                return notify_fail("你的爪气不够，无法施展出「"+HIY"绝"NOR+HIC"天"NOR+HIW"灭"NOR+HIR"地"NOR+"」。\n");
	          me->add_temp("apply/strength", extra);
            me->add_temp("apply/attack", extra);
           	me->add("neili", -1000);
		    msg = HIR "$N双爪在胸前交错，神色突然变沉重,\n"NOR
		          HIB"双手风车般的使出最后一招「"+HIY"绝"NOR+HIC"天"NOR+HIW"灭"NOR+HIR"地"NOR+"」,\n"NOR
		          HIW"一招八式扑向$n！\n" NOR;
       	      message_vision(msg, me, target);             
	      msg =  HIC  "第一式！$N右爪一式「绝杀」，勇猛无比地劈向$n！" NOR;
	             COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        msg = HIR  "第二式！$N双爪施出一式「绝杀」，隐隐约约带着爪风拍向$n！" NOR;
               COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        msg = HIB  "第三式！$N左爪御胸，右爪一式「绝杀」缓缓推向$n！" NOR;
               COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        msg = HIY  "第四式！$N使出「绝杀」，向$n的连拍数爪！" NOR;
             	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        msg = HIG "第五式！$N双爪一式「绝杀」一前一后按向$n的胸前！" NOR;
              COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
      	msg = HIM  "第六式！$N身形转动，使出「绝杀」向$n连打六下！" NOR;
               COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        msg = YEL  "第七式！$N脚下一转，突然欺到$n身前，一式「绝杀」直拍向$n面门" NOR;
             	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        msg = HIW "第八式！$N突然飞起，双爪居高临下最后一式「绝杀」全力拍向$n！" NOR;
          COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);

        me->add_temp("apply/strength", -extra);
        me->add_temp("apply/attack", -extra);
        me->start_busy(2+random(4));
        return 1;
}
