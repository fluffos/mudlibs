// liujue-tianhongjian.c  六绝天虹剑法

inherit SKILL;

mapping *action = ({
([	"action" : "$N举剑过顶，背躬而下，剑尖点地，一式「绝唱」，$w向$n的$l轻轻刺去，",
	"force" : 120,
	"dodge" : 20,
	"damage" : 35,
        "lvl" : 0,
	"damage_type" : "刺伤"
]),
([	"action" : "$N双眉紧蹙,双目含泪,使出一式「绝情」，剑势放荡不羁，$w直刺$n的$l",
	"force" : 140,
	"dodge" : 15,
	"damage" : 50,
        "lvl" : 10,
	"damage_type" : "刺伤"
]),
([	"action" : "$N双臂张开，门户大开,$n正待出击，突然$N持着$w一猫腰，一招「绝路」，剑气诡异地向$n的$l荡去",
	"force" : 200,
	"dodge" : 15,
	"damage" : 60,
        "lvl" : 20,
	"damage_type" : "刺伤"
]),
([	"action" : "$N猛地一拔腰间$w，彩虹一般的剑花一亮，一招「绝交」,一道激烈的历芒直刺$n的$l",
	"force" : 240,
	"dodge" : 10,
	"damage" : 70,
        "lvl" : 30,
	"damage_type" : "刺伤"
]),
([	"action" : "$N一式「绝招」发出，霎时$n的眼前迷朦一片，突然眼前一清，但只看见$N手中$w的剑尖急射向$n的眉心",
	"force" : 270,
	"dodge" : 10,
	"damage" : 80,
        "lvl" : 40,
	"damage_type" : "割伤"
]),
([	"action" : "$N面色威严，一式「绝杀」，$w缓慢的向$n移动过去，可是偏偏$n却不能躲避，剑锋慢慢地刺向$n的$l",
	"force" : 280,
	"dodge" : 5,
	"damage" : 90,
        "lvl" : 50,
	"damage_type" : "刺伤"
]),
});


int valid_enable(string usage) { return (usage == "sword") || (usage == "parry"); }

int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 100)
		return notify_fail("你的内力不够。\n");
	if ((int)me->query_skill("beiming-shengong", 1) < 20)
		return notify_fail("你的北冥神功火候太浅。\n");
		return 1;
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level   = (int) me->query_skill("liujue-tianhongjian",1);
	for(i = sizeof(action); i > 0; i--)
		if(level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];

}

int practice_skill(object me)
{
	object weapon;

	if (!objectp(weapon = me->query_temp("weapon"))
	|| (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对。\n");
	if ((int)me->query("jingli") < 50)
		return notify_fail("你的体力不够练六绝天虹剑法。\n");
	me->receive_damage("jingli", 35);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"liujue-tianhongjian/" + action;
}
