int valid_enable(string usage) { return (usage == "sword") || (usage == "parry"); }

int valid_learn(object me)
{
    object weapon;
    if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    if (!objectp(weapon = me->query_temp("secondary_weapon"))
    || (string)weapon->query("skill_type") != "sword")
        return notify_fail("你必须先找把剑才能学玉女剑法。\n");

    if ((int)me->query("max_neili") < 100)
        return notify_fail("你的内力不够。\n");
    if ((int)me->query_skill("yunv-xinfa", 1) < 30 )
        return notify_fail("你的玉女心法火候太浅。\n");
if ((int)me->query_skill("meinu-quanfa", 1) <= me->query_skill("yunv-jian", 1))
        return notify_fail("你的美女拳火候太浅。\n");
if ((int)me->query_skill("quanzhen-jianfa", 1) <= me->query_skill("yunv-jian", 1))
        return notify_fail("你的全真剑法火候不够。\n");
    if (me->query_skill("sword", 1) <=me->query_skill("yunv-jian", 1))
        return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
    return 1;
}

int practice_skill(object me)
{
        return notify_fail("玉女剑法只能向师傅请教。\n");
}
string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}
mapping query_action(object me, object weapon)
{
    mapping a_action;
    int i, level;
    
    if (me->query("gender") != "女性")
       return action[0];
    level   = (int) me->query_skill("yunv-jian", 1);
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"]){
                        a_action = action[NewRandom(i, 20, level/5)];
                        break;
                }
    a_action["dodge"]  = 0-level*3;
    a_action["parry"]  = 0-level*3;
    a_action["attack"]  = level*2;
    a_action["damage"] = level;
    if (me->query_temp("action_flag"))
       me->set_temp("action_msg","$N展开双手互搏，使出玉女素心剑法：\n");
    return a_action;

}
void do_interlink(object me, object victim)
{
    int     skill,i;
    object  weapon1,weapon2;
    
    if (me->query("gender") != "女性") return;    
      weapon1 = me->query_temp("weapon");
      weapon2 = me->query_temp("secondary_weapon");
    if (!weapon1 || !weapon2)    return ;
        
    if (weapon1->query("skill_type") != "sword" ||
        weapon2->query("skill_type") != "sword")
        return ;

    skill=me->query_skill("yunv-jian", 1);
    if (me->query("neili")<skill) return;

    if ( skill >= 250 
        && me->query_skill("hubo", 1)>= 300
        && me->query_skill("yunv-xinfa", 1) >= 250 
        && skill<= me->query_skill("quanzhen-jianfa", 1)){
        for (i=0;i<(skill/40);i++){
      weapon1 = me->query_temp("weapon");
      weapon2 = me->query_temp("secondary_weapon");
      if (!weapon1 || !weapon2)  return ;
         if ((me->is_fighting(victim) || victim->is_fighting(me)) && victim->query("qi")>0 ){
            if (environment(me) == environment(victim)){
                me->add_temp("str",skill/10);
                me->add_temp("dex",skill/10);
                COMBAT_D->do_attack(me, victim, me->query_temp("weapon"), TYPE_REGULAR);
            }
            me->delete_temp("str");
            me->delete_temp("dex");
         }else  break;
       }
//           me->improve_skill("yunv-jian",skill/60);
       if (me->query("neili")<skill*2) me->set("neili",0);
         else
         me->add("neili",-skill);
   }
}
