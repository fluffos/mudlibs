string *parry_msg = ({
  "$n举刀反砍，飞快地架住了$N的$w\n",
  "$n刀转向左，身形反退右，将$N的攻势化解了\n",
  "$n$v向后急刺\n",
});

int valid_enable(string usage) { return usage == "blade" || usage == "parry"; }

int valid_learn(object me) {
  mapping myfam;
  myfam = (mapping)me->query("family");
  if (!myfam || myfam["master_id"] != "tian boguang")
    return notify_fail("你无法向此人学习快刀刀法。\n");
  if ((int)me->query("max_neili") < 30000)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_skill("force", 1) < 1200)
    return notify_fail("你的内功心法火候太浅。\n");
  if ((int)me->query_skill("dodge", 1) < 1200)
    return notify_fail("你的轻功火候太浅。\n");
  if (me->query("dex") < 30)
    return notify_fail("你的灵活度太低，学不了我的快刀刀法。\n");
  if ((int)me->query_skill("blade", 1) < 1200)
    return notify_fail("你的基本刀法火候还不够，无法领会快刀刀法。\n");

  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  mapping a_action;
  int i, level;
  level = (int)me->query_skill("kuaidao-daofa", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"]) {
      a_action = action[NewRandom(i, 20, level / 5)];
      break;
    }
  if (me->query_temp("perform_kuaidao")) level += level;
  a_action["dodge"] = 0 - level;
  a_action["parry"] = 0 - level * 2;
  a_action["attack"] = level;
  a_action["damage"] = level * 4;
  return a_action;
}

int practice_skill(object me) {
  return notify_fail(HIW "快刀刀法只能通过(perform kan)来演练。\n" NOR);
}

string perform_action_file(string action) {
  return __DIR__ "kuaidao-daofa/" + action;
}
