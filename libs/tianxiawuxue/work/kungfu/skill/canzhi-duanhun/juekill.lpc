#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;

int perform(object me, object target) {
  string msg;
  int extra;
  object weapon;
  extra = me->query_skill("canzhi-duanhun", 1);
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("「" + HIY "绝" NOR + HIC "天" NOR + HIW "灭" NOR + HIR "地" NOR + "」只能对战斗中的对手使用。\n");

  if (objectp(me->query_temp("weapon")))
    return notify_fail("你必须空手使用「" + HIY "绝" NOR + HIC "天" NOR + HIW "灭" NOR + HIR "地" NOR + "」！\n");

  if ((int)me->query_skill("canzhi-duanhun", 1) < 100)
    return notify_fail("你的残肢断魂不够娴熟，无法施展出「" + HIY "绝" NOR + HIC "天" NOR + HIW "灭" NOR + HIR "地" NOR + "」。\n");

  if ((int)me->query("max_neili") < 5000)
    return notify_fail("你的内力不够，无法施展出「" + HIY "绝" NOR + HIC "天" NOR + HIW "灭" NOR + HIR "地" NOR + "」。\n");
  if ((int)me->query("neili") < 5000)
    return notify_fail("你的真气不够，无法施展出「" + HIY "绝" NOR + HIC "天" NOR + HIW "灭" NOR + HIR "地" NOR + "」。\n");
  me->add_temp("apply/strength", extra);
  me->add_temp("apply/attack", extra);
  me->add("neili", -5000);
  msg = YEL "$N双掌平平提到胸前，神色沉重的缓缓施出残肢断魂的最后一招「" + HIY "绝" NOR + HIC "天" NOR + HIW "灭" NOR + HIR "地" NOR + "」一招八式推向$n！" NOR;
  message_vision(msg, me, target);
  msg = HIC "第一式！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIR "第二式！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIB "第三式！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIY "第四式！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIG "第五式！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIM "第六式！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = YEL "第七式！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIW "第八式！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);

  me->add_temp("apply/strength", -extra);
  me->add_temp("apply/attack", -extra);
  me->start_busy(5);
  return 1;
}
