//  圆月刀法
//@TXWX by hhm 2005/4/17

inherit SKILL;

mapping *action = ({
([      "action" : "$N身影变双，刀光浮动，转眼已劈出二十七刀，向$n的$l挥去",
        "force" : 300,
        "dodge" : 10,
        "parry" : 5,
        "damage": 600,
        "lvl" : 0,
        "skill_name" : "圆月弯刀",
        "damage_type" : "割伤"
]),
([      "action" : "$N凌空扬刀，绕$n游走，刀法之快，匪夷所思，手中$w已割向$n的周身各处",
        "force" : 400,
        "dodge" : 10,
        "parry" : 10,
        "damage": 800,
        "lvl" : 12,
        "skill_name" : "圆月弯刀",
        "damage_type" : "割伤"
]),
 ([      "action" : "$N掌中$w稍作一顿，旋及如流星划空，闪电霹雳，刷地一声自上而下向$n猛劈",
        "force" : 600,
        "dodge" : 5,
        "parry" : 5,
        "damage": 1000,
        "lvl" : 18,
        "skill_name" : "圆月弯刀",
        "damage_type" : "割伤"
]),
([      "action" : "$N右手反执刀柄，横刀一斩，$w直向$n的颈中划去",
        "force" : 800,
        "dodge" : 5,
        "parry" : 5,
        "damage": 1200,
        "lvl" : 24,
        "skill_name" : "圆月弯刀",
        "damage_type" : "割伤",
]),
});

int valid_enable(string usage) { return usage == "blade" || usage == "parry"; }
mapping query_action(object me, object weapon)
{
        int i, level;
        level   = (int) me->query_skill("yuanyue-wandao",1);
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"])
                        return action[NewRandom(i, 20, level/5)];
}
int valid_learn(object me)
{
    mapping skl;
    string *sname;
    int i;
    int lvl = (int)me->query_skill("yuanyue-wandao", 1);
    if ( me->query("gender") == "无性" && lvl > 49)
        return notify_fail("你无根无性，阴阳不调，难以领会高深的圆月弯刀。\n");
    if ( me->query("gender") != "男性")
        return notify_fail("圆月弯刀需要阳刚之气，不适合你学。\n");
    if ( me->query("PKS") )
        return notify_fail("你曾经滥杀无辜，心中戾气未除，已经失去了学习圆月弯刀的机会。\n");
    if ( me->query("kar") < 30)
        return notify_fail("圆月弯刀只传授有缘之人，阁下请回吧。\n");
    if ((int)me->query_skill("force", 1) < 1600)
        return notify_fail("你的基本内功火候还不够，无法领会圆月弯刀。\n");
    if ((int)me->query_skill("blade", 1) < 1200)
        return notify_fail("你的基本刀法火候还不够，无法领会圆月弯刀。\n");
    if (me->query_skill("blade",1)<=lvl)
        return notify_fail("你的基本刀法基础不够，再学下去会走火入魔的。\n");
    skl = me->query_skills();
    sname  = keys(skl);
    for (i=0;i<sizeof(skl);i++){
        if( SKILL_D(sname[i])->valid_enable("parry") )
        return notify_fail("你已经修炼了高深武学，怎能再学圆月弯刀？！\n");
    }
    return 1;
}
