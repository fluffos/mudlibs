//2005.7.10

#include <ansi.h>
#include <combat.h>
inherit F_SSERVER;
int perform(object me, object target)
{
	string msg;
	int extra;
	object weapon;
	extra = me->query_skill("tiexue-hammer",1);
        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "hammer")
                return notify_fail("你用的武器不对！\n");
	if ( extra < 800) return notify_fail("你的铁雪锤法还未到第八重！\n");
	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("［雪锤脱手］只能对战斗中的对手使用。\n");
	
	weapon = me->query_temp("weapon");

	msg = HIM  "$N使出铁雪锤法中的［雪锤脱手］，突然身体往下一蹲把手中的雪锤往$n的脚砸去！\n" NOR;
	message_vision(msg, me, target);
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);

if (random(COMBAT_D->skill_power(me, "hammer", SKILL_USAGE_ATTACK)) > COMBAT_D->skill_power(me, "target", SKILL_USAGE_DEFENSE) / 4 )
{
	msg = HIC  "结果$n闪避不及, 大腿被$N的雪轮擦过连白骨都露出来了！！\n" NOR;
	target->start_busy(3+random(5));
target->add_temp("apply/dexerity", -extra/5);
	msg += HIR  "$N见到$n反应变慢了,连忙快攻了两招！\n" NOR;
	message_vision(msg, me, target);
       COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
       COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
}
else
{
	msg = HIC  "可是$n深吸了一口气往上跳跃了二十尺, 避过了$N的攻击！！\n" NOR;
	message_vision(msg, me, target);
}
weapon->move(environment(me));
me->start_busy(2+random(2));
	return 1;
}
