// tiezhang-shengong.c 铁掌神功
inherit FORCE;
int valid_enable(string usage) { return usage == "force"; }
int valid_learn(object me) {
  mapping skl;
  string *sname;
  int i = (int)me->query_skill("tiezhang-shengong", 1);
  int t = 1, j;
  if (i <= 100)
    for (j = 1; j < i / 10; j++)
      t *= 2;
  if (me->query("gender") == "无性" && i > 49)
    return notify_fail("你无根无性，阴阳不调，难以领会高深的铁掌神功。\n");
  if ((int)me->query_skill("force", 1) < 20)
    return notify_fail("你的基本内功火候还不够，还不能学习铁掌神功。\n");
  if (me->query_skill("force", 1) <= i)
    return notify_fail("你的基本内功基础不够，再学下去会走火入魔的。\n");
  skl = me->query_skills();
  sname = keys(skl);
  for (i = 0; i < sizeof(skl); i++) {
    if (sname[i] == "tiezhang-shengong") continue;
    if (sname[i] == "yijing-force") continue;
    if (SKILL_D(sname[i])->valid_enable("force"))
      return notify_fail("你不先散了别派内功，怎能学铁掌神功？！\n");
  }
  return 1;
}
int practice_skill(object me) {
  return notify_fail("铁掌只能用学(learn)的来增加熟练度。\n");
}
string exert_function_file(string func) {
  return __DIR__ "tiezhang-shengong/" + func;
}
