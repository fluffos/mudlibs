#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;

int perform(object me, object target) {
  object weapon, ob;
  string msg;
  int i;
  if (!me->is_fighting())
    return notify_fail("「销魂五掌」只能在战斗中使用。\n");
  if (me->query_temp("perform")) return notify_fail("你上一招未使完！\n");
  if (me->query_temp("weapon"))
    return notify_fail("使用黯然销魂掌必须空手。\n");
  if ((int)me->query("neili") < 300)
    return notify_fail("你的真气不够！\n");
  if ((int)me->query_skill("unarmed") < 100 ||
    me->query_skill_mapped("unarmed") != "anranxiaohun-zhang")
    return notify_fail("你的「黯然销魂掌」还不到家，无法使用「销魂五掌」！\n");
  msg = HIB "$N脸色一淡, 使出「销魂五掌」，犹如天地之情，式如破竹！\n" NOR;
  message_vision(msg, me);
  me->clean_up_enemy();
  ob = me->select_opponent();
  me->add("neili", -150);
  me->set_temp("perform", 1);
  me->set_temp("perform_zhan", 1);
  for (i = 0; i < 5; i++)
    if (me->is_fighting(ob) && ob->is_fighting(me) && ob->query("eff_qi") > 0) {
      me->set_temp("action_msg", "紧接着");
      COMBAT_D->do_attack(me, ob, weapon, 0);
    } else break;
  me->delete_temp("perform_zhan");
  me->delete_temp("secondly_weapon");
  me->start_call_out((: call_other, __FILE__, "del_perform", me :), 3);
  return 1;
}

void del_perform(object me) {
  if (!me) return;
  me->delete_temp("perform");
}
