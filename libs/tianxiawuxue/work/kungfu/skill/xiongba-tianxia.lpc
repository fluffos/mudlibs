// xiongba-tianxia.c 雄霸天下
inherit SKILL;
mapping *action = ({
([  "action" : "$N一招「"+WHT+"傲气长存"+NOR+"」，$w手中的刀丛上往下直劈向$n",
    "force" : 230,
    "lvl" : 300,
    "damage_type" : "割伤"
]),
([  "action" : HIG+"$N运内力到$w上，一招「"+HIM+"幻影邪刀"+NOR+HIG+"」，双手持刃反切，砍向$n的胸口"+NOR,
    "force" : 440,
    "lvl" : 450,
    "damage_type" : "劈伤"
]),
([  "action" : "$N一招「"+HIB+"末日杀神"+NOR+"」，$w从身后飞出，挟风声劈向$n的$l",
    "force" : 210,
    "lvl" : 250,
    "damage_type" : "劈伤"
]),
([  "action" : HIC+"$N一跃而起，一招「"+HIY+"唯我天下"+NOR+ HIC +"」，手中$w直劈向$n的颈部"+NOR,
    "force" : 250,
    "lvl" : 400,
    "damage_type" : "劈伤"
]),
([  "action" : HIW+"$N双手握住$w，一招「"+RED+"雄霸天下"+NOR+HIW+"」，毫不防守的往$n的头部砍去"+NOR,
    "force" : 260,
    "lvl" : 650,
    "damage_type" : "割伤"
]),
});

int valid_enable(string usage) { return (usage == "blade") || (usage == "parry"); }
int practice_level(){   return 800;  }
int valid_learn(object me, object ob)
{
    if ((int)me->query("max_neili") < 100000)
        return notify_fail("你的内力不够。\n");
    if ((int)me->query_skill("blade", 1) < 1000)
        return notify_fail("你的基本刀法火候太浅。\n");
    if (me->query_skill("blade", 1) <=me->query_skill("xiongba-tianxia", 1))
        return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
    if(me->query("PKD")<10)
	 return notify_fail("你心中没有怨气怎么能领悟这套刀法。\n");	
    if (ob && userp(ob))
        return notify_fail(ob->name(1)+"看来并不想教你雄霸天下。\n");
    
	return 1;
}
mapping query_action(object me, object weapon)
{
        mapping a_action;
        int i, level;
        level   = (int) me->query_skill("xiongba-tianxia",1);
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"]){
                        a_action=action[NewRandom(i, 20, level/5)];
                       break;
                 }
    if ( me->query_temp("perform_xiongba")) level+=level;
    a_action["dodge"]  = 0-level;
    a_action["parry"]  = 0-level*2;
    a_action["attack"]  = level;
    a_action["damage"] = level*4;
    return a_action;
}

int practice_skill(object me)
{
    object weapon;
    if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
    if (!objectp(weapon = me->query_temp("secondary_weapon"))
    || (string)weapon->query("skill_type") != "blade")
        return notify_fail("你使用的武器不对。\n");
    if ((int)me->query("qi") < 5000 || (int)me->query("jing") < 5000)
        return notify_fail("你的体力不够练雄霸天下刀法。\n");
    me->receive_damage("qi", 30+random(50));
    me->receive_damage("jing", 30+random(50));
    return 1;
}
string perform_action_file(string action)
{
    return __DIR__"xiongba-tianxia/" + action;
}
