inherit SKILL;

mapping *action = ({
([  "action": "$N双掌一错，一招「五指山」，狂风般扫向$n的$l",
    "dodge": 30,
    "force": 200,
    "damage": 200,
		"skill_name" : "五指山",
    "damage_type": "瘀伤"
]),
([  "action": "$N一招「大沼龙蛇」，身形突然旋转起来扑向$n，双掌拍向$n的$l", 
    "dodge": 40,
    "force": 240,
    "damage": 250,
		"skill_name" : "大沼龙蛇",
    "damage_type": "瘀伤"
]),
([  "action": "$N一招「云断秦岭」，身形突然旋转起来扑向$n，双掌拍向$n的$l", 
    "dodge": 40,
    "force": 240,
    "damage": 300,
		"skill_name" : "云断秦岭",
    "damage_type": "瘀伤"
]),
([  "action": "$N一招「开山碎石」，身形突然旋转起来扑向$n，双掌拍向$n的$l", 
    "dodge": 40,
    "force": 340,
    "damage": 750,
		"skill_name" : "开山碎石",
    "damage_type": "瘀伤"
]),
([  "action": "$N一招「力劈华山」，身形突然旋转起来扑向$n，双掌拍向$n的$l", 
    "dodge": 40,
    "force": 240,
    "damage": 400,
		"skill_name" : "力劈华山",
    "damage_type": "瘀伤"
]),
([  "action": "$N将寒毒运至左手，一招「大漠狂风」，迅疾无比地抓向$n的$l",   
    "dodge": 50,
    "force": 280,
    "damage": 450,
		"skill_name": "大漠狂风",
    "damage_type": "瘀伤"
]),
([  "action": "$N后退一步，突然一招「天崩地裂」，掌挟风雷之声拍向$n的$l",   
    "dodge": 60,
    "force": 300,
    "damage": 600,
		"skill_name": "天崩地裂",
    "damage_type": "瘀伤"
]),
});

int valid_enable(string usage) { return usage=="hand" || usage=="unarmed"; }   

int practice_skill(object me)
{
   if ((int)me->query("qi") < 300)
   		return notify_fail("你的体力太低了，先休息一下吧。\n");
   if ((int)me->query("neili") < 800)
   		return notify_fail("你的内力不够练大嵩阳手。\n");
   if (me->query_skill("dasongyang-shou", 1) < 50)
   		me->receive_damage("qi", 20);
   else
   		me->receive_damage("qi", 30);
   me->add("neili", -5);
   return 1;
}

int valid_learn(object me)
{
    if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
            return notify_fail("练大嵩阳手必须空手。\n");
//    if ((int)me->query_skill("hanbing-zhenqi", 1) < 100)
//            return notify_fail("你的寒冰真气火候不够，无法学大嵩阳手。\n");
    if ((int)me->query("max_neili") < 10000)
            return notify_fail("你的内力太弱，无法学习大嵩阳手。\n");
    return 1;
}

string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int tt;
	
	string *sanzhao_msg = 
	({
		HIW"$N大步迈出，左手一划，右掌呼的一声，便向$n击去，正是一招「力劈华山」，力自掌生，猛不可当。"NOR,
		HIM"$N一掌既出，身子抢前，又是一招「大漠狂风」，後掌推前掌，双掌力道并在一起，排山倒海的压将过来。"NOR,
		HIG"$N跟着又是一招「天崩地裂」，前招掌力相消，次招掌力又至。竟如怒涛狂涌，势不可挡，又如一堵无形的高墙，向$n身前疾冲。"NOR,
	});

	if ( me->query_skill_mapped("force") == "hanbing-zhenqi" )
	{
		tt = random(3);
		if ((tt < 0 ) || (tt>2))
			tt = 0;
			
    if ( random(me->query_skill("dasongyang-shou")) > 200 && random(me->query_skill("force")) > 200 && me->query("neili") > 5000  )
		{
			return ([
			"action": sanzhao_msg[tt],
			"dodge": 80,
			"parry": 50,
			"force": 400,
			"damage": 600+random(200),
			"damage_type": random(2)?"内伤":"瘀伤" ]);
		}
		else if ( random(me->query_skill("dasongyang-shou")) > 300 && random(me->query_skill("force")) > 400 && me->query("neili") > 7000  )
		{
			return ([
			"action": sanzhao_msg[tt],
			"dodge": 80+random(20),
			"parry": 50+random(20),
			"force": 400+random(350),
			"damage": 600+random(400),
			"damage_type": random(2)?"内伤":"瘀伤" ]);
		}
		else if ( random(me->query_skill("dasongyang-shou")) > 400 && random(me->query_skill("force")) > 600 && me->query("neili") > 8000)
		{
			return ([
			"action": sanzhao_msg[tt],
			"dodge": 80+random(100),
			"parry": 50+random(100),
			"force": 400+random(350),
			"damage": 600+random(600),
			"damage_type": random(2)?"内伤":"瘀伤" ]);
		}
    else if (random(me->query_skill("dasongyang-shou",1)) > 500 && random(me->query_skill("force")) > 800 && me->query("neili") > 10000)
		{
			return ([
			"action": sanzhao_msg[tt],
			"dodge": 80+random(140),
			"parry": 50+random(140),
			"force": 400+random(400),
			"damage": 600+random(800),
			"damage_type": random(2)?"内伤":"瘀伤" ]);
		}
		else
		{
			return action[random(sizeof(action))];     
		}
	}
	else
		return action[random(sizeof(action))];     
        
    /*    
        level   = (int) me->query_skill("hanbing-shenzhang",1);
        for(i = sizeof(action); i >=0; i--)
                if(level > action[i-1]["lvl"])
                        return action[NewRandom(i, 10, level/5)];
    */
}

string perform_action_file(string action)
{
        return __DIR__"dasongyang-shou/" + action;
}
