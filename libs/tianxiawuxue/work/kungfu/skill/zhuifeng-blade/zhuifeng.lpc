#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target)
{
        object weapon;
        string msg;
        int i, attack_time;

        if( !target ) target = offensive_target(me);

                if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("「"HIG"追风"NOR"」只能在战斗中使用。\n");

        if (!objectp(weapon = me->query_temp("weapon"))
                || (string)weapon->query("skill_type") != "blade")
                return notify_fail("你使用的武器不对。\n");
        if((int)me->query_dex() < 30)
                return notify_fail("你的身法不够, 目前还不能使用这项绝技! \n");

        if((int)me->query_skill("polang-shengong",1) < 200)
                return notify_fail("你的破浪神功的修为不够, 不能使用这一绝技 !\n");

        if((int)me->query_skill("dodge") < 400)
                return notify_fail("你的轻功修为不够, 不能使用"HIG"追风"NOR"！\n");
 
        if((int)me->query_skill("blade") < 150)
                return notify_fail("你的刀法修为不够， 目前不能使用"HIG"追风"NOR"! \n");

        if( (int)me->query("neili") < 1000 )
                return notify_fail("你的真气不够！\n");
msg =BLINK HIR"$N面如止水,身形变的犹如行云流水一般,"HIG"带着淡淡的微笑$N已劈出数刀都夹杂着风，\n"NOR;
msg +=
    BLINK  HIB"风追逐着刀！使对方只觉得心跳都停止了！"NOR;
      message_vision(msg, me, target);


        attack_time = ((int)me->query_skill("zhuifeng-blade", 1) / 55);
                if(attack_time < 1)
                        attack_time = 1;

                for(i = 2; i < attack_time; i++)
                        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);

      me->start_busy(random(4));
    me->add("neili", -400);

        return 1;
}


