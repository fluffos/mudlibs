// drift_sense.c
#include <ansi.h>
//inherit SSERVER;
int conjure(object me, object target) {
  string name, new_id, skill1, skill2;
  string *sname;
  mapping hp_status, skill_status;
  object ob, jiushen, *obj;
  int i, level, temp;

  if (!me->is_fighting())
    return notify_fail("没事不要乱叫酒神出来！\n");
  if (me->query_skill("xianfeng-spells", 1) < 300)
    return notify_fail("你的仙风云体术等级还不够。");
  if (me->query("jing") < 30 || me->query("jingli") < 75)
    return notify_fail("你的精力不够！\n");
  if (target)
    return notify_fail("你只能叫酒神出来！\n");
  jiushen = new("/d/npc/jiushen");
  name = me->query("name");
  jiushen->set("name", HIB + name + "的酒神" + NOR);
  new_id = me->query("id") + "'s jiu shen";
  jiushen->set("id", new_id);
  //    move(jiushen);

  hp_status = me->query_entire_dbase();
  jiushen->set("combat_exp", (hp_status["combat_exp"] * 2));
  jiushen->set("neili", hp_status["max_neili"] * 2);
  jiushen->set("max_neili", hp_status["max_neili"]);
  jiushen->set("max_qi", hp_status["max_qi"] * 2);
  jiushen->set("eff_qi", hp_status["eff_qi"] * 2);
  jiushen->set("qi", hp_status["qi"] * 2);
  jiushen->set("max_jing", hp_status["max_jing"] * 2);
  jiushen->set("eff_jing", hp_status["eff_jing"] * 2);
  jiushen->set("jing", hp_status["jing"] * 2);

  if (mapp(skill_status = me->query_skills())) {
    sname = keys(skill_status);
    for (i = 0; i < sizeof(skill_status); i++) {

      level = skill_status[sname[i]] * 3 / 2;
      if (level)
        jiushen->set_skill(sname[i], level);
    }
  }

  if (mapp(skill_status = me->query_skills())) {
    sname = keys(skill_status);
    for (i = 0; i < sizeof(skill_status); i++) {
      jiushen->command("enable unarmed " + sname[i]);
      jiushen->command("enable force " + sname[i]);
      jiushen->command("enable parry " + sname[i]);
      jiushen->command("enable dodge " + sname[i]);
      if (stringp(skill1))
        jiushen->command("enable " + skill1 + " " + sname[i]);
      if (stringp(skill2))
        jiushen->command("enable " + skill2 + " " + sname[i]);
    }
  }

  jiushen->move(environment(me));
  jiushen->do_chase();
  temp = me->query_skill("xianfeng-spells", 1) - 50;
  me->set_skill("xianfeng-spells", temp);
  return 1;
}
