// buddhism-force (protect)
#include <ansi.h>

void remove_effect(object me, int amount, object yuanqi);

int exert(object me, object target) {
  int skill, usetimes;
  object card;
  string msg;
  if (target != me)
    return notify_fail("金刚不坏神功只能对自己使用。\n");
  if ((int)me->query("neili") < 10000)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_temp("jingang-buhuai"))
    return notify_fail("你已经在运功中了。\n");
  skill = me->query_skill("jingang-buhuai", 1);
  if (skill < 1000) return notify_fail("你的金刚不坏神功还不够娴熟。\n");

  usetimes = me->query("jingangtimes");
  if (!usetimes) {
    me->set("jingangtimes", 1);
    msg = CYN "$N第一次使出金刚不坏神功，只觉得身体烘热热的烧了起来！！\n" NOR;
  } else {
    me->set("jingangtimes", usetimes + 1);
    msg = CYN "$N第" + me->query("jingangtimes") + "次使出金刚不坏神功，只觉得全身力大无穷！！\n" NOR;
  }
  message_vision(msg, me);
  if (me->query("jingangtimes") > 5) {
    message_vision(HIY "$N不听劝告硬使出第" + me->query("jingangtimes") + "次金刚不坏神功, 结果当场气绝身亡！！\n" NOR, me);
    me->die();
    me->add("max_neili", -10000);
    me->add("combat_exp", -me->query("combat_exp") / 10);
    if (me->query("max_neili") < 0) me->set("max_neili", 0);
    return 0;
  }

  message_vision(HIY "$N把内力往头上冲，运起金刚不坏护体神功，全身都变成金色的了。\n" NOR, me);
  me->add_temp("apply/armor_vs_force", skill * 20);
  me->set_temp("jingang-buhuai", 1);
  tell_object(me, HIY + BOLD "只要你使用金刚之气(jingang)就可以刀枪不入,什么都不用怕了。\n" NOR);
  me->set_temp("apply/long", ({ me->short() + "，\n" + HIY + gender_pronoun(me->query("gender"))
    +HIY "因为使出了金刚不坏神功所以全身金光闪闪，好像个金人一样。\n" NOR }));
  card = new("/clone/misc/jingangcard");
  card->move(me);
  //    call_out("destrory",600,card);		
  me->start_call_out((: call_other, __FILE__, "remove_effect", me, skill * 20, card :), 600);
  if (me->is_fighting()) me->start_busy(1);
  return 1;
}
void remove_effect(object me, int amount, object yuanqi) {
  if (!me) return;
  me->add_temp("apply/armor_vs_force", -amount);
  me->delete_temp("jingang-buhuai");
  call_out("destroy", 1, yuanqi);
  message_vision(HIY + BOLD "$N的金刚不坏神功发功完毕，一团团的热气从$N的头上冒了出来, $N似乎有点累了。\n" NOR, me);
  me->set("qi", 100);
  me->set("jing", 100);
  me->delete_temp("apply/long");
  me->set("neili", 0);
}

void destrory(object ob) {
  destruct(ob);
  return;
}

void reset() {}
int clean_up() { return 1; }
