#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;
int perform(object me, object target) {
  object weapon, ob;
  string msg, string1;
  int count;
  if (!target) target = offensive_target(me);

  if (!me->is_fighting())
    return notify_fail("「迅雷无极」只能在战斗中使用。\n");

  if (me->query_skill("xuantian-force", 1) < 1000)
    return notify_fail("你的玄天无极等级不够, 不能使用「迅雷无极」！\n");

  if (me->query_skill("xunlei-sword", 1) < 1000)
    return notify_fail("你的迅雷剑等级不够, 不能使用「迅雷无极」！\n");

  if (me->query("max_neili") < 50000)
    return notify_fail("你的内力不够，无法运用「迅雷无极」！\n");
  msg = HIY "$N使出昆仑派绝技「迅雷无极」，身法陡然加快。迅猛无极！" NOR;

  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = YEL "风雷变换！ " NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = RED "万剑齐发！ " NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = BLU "漫天花雨！ " NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIC "落雷无间！ " NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  me->add("neili", -50);
  me->start_busy(2);
  return 1;
}
