//@ txwx by hhm
//05.7.11
#include <ansi.h>
#include <combat.h>
inherit F_SSERVER;
int perform(object me, object target) {
  string msg;
  int extra;
  int i;
  object weapon;
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("铁掌降龙只能对战斗中的对手使用。\n");

  if ((int)me->query_skill("guiyuan-tunafa", 1) < 1000)
    return notify_fail("你的归元吐呐法还未练成，不能使用！\n");

  if ((int)me->query("max_neili", 1) < 20000)
    return notify_fail("你现在内力不足，不能使用天雷气！\n");

  if ((int)me->query("neili", 1) < 5000)
    return notify_fail("你现在内力不足，不能使用天雷气！\n");

  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("「铁掌降龙」只能空手使用。\n");

  if ((int)me->query_skill("tiezhang-zhangfa", 1) < 1000)
    return notify_fail("你的铁掌掌法不够娴熟，不能用铁掌降龙。\n");

  extra = me->query_skill("tiezhang-zhangfa", 1) / 10;
  extra += me->query_skill("guiyuan-tunafa", 1) / 10;
  me->add_temp("apply/attack", extra * 20);
  me->add_temp("apply/damage", extra * 20);
  msg = HIR "$N运起［归元吐纳法］，同时使出［铁掌降龙］一阵一阵的掌力，如潮水般的击向$n！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIW "第一层掌力，．．．．\n" NOR;
  msg = HIW "第二层掌力，．．．．\n" NOR;
  msg = HIW "第三层掌力，．．．．\n" NOR;
  msg = HIW "第四层掌力，．．．．\n" NOR;
  msg = HIW "第五层掌力，．．．．\n" NOR;
  msg = HIW "第六层掌力，．．．．\n" NOR;
  msg = HIW "第七层掌力，．．．．\n" NOR;
  msg = HIW "第八层掌力，．．．．\n" NOR;
  msg = HIW "第九层掌力，．．．．\n" NOR;

  message_vision(msg, me, target);
  for (i = 0; i < extra / 40; i++) {
    msg = HIC "$N身形突转，一掌又打了过来！\n" NOR;
    COMBAT_D->do_attack(me, target, weapon, msg);
  }
  i = extra / 40;
  me->add_temp("apply/attack", -extra * 20);
  me->add_temp("apply/damage", -extra * 20);
  me->add("neili", -100 * i);
  me->start_busy(2);
  return 1;
}
