#include <dbase.h>

int query_str()
{
	return (int)query("str") + query_temp("apply/strength");
}

int query_cor()
{
	return (int)query("cor") + query_temp("apply/courage");
}

int query_int()
{
	return (int)query("int") + query_temp("apply/intelligence");
}

