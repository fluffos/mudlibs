#include <dbase.h>

inherit F_TREEMAP;

mapping dbase;
mapping space_dbase;
nosave mapping tmp_dbase;
nosave mapping tmp_space_dbase;
nosave mapping current;

//	The default_ob provides the default values of the dbase. It is set to
//	be master copy of an object.
nosave mixed default_ob;

mixed query_default_object() { return default_ob; }
void set_default_object(mixed ob) {
  //	if( geteuid(previous_object()) != ROOT_UID )
  //		error("dbase: Only this_object() or object with root euid can set default_ob.\n");
  if (!geteuid()) seteuid(getuid());
  default_ob = ob;
  ob->add("no_clean_up", 1);
}


//New Writen by Alarms 3/31/99

mixed set_space(string prop, mixed data) {
  if (!mapp(space_dbase)) space_dbase = ([]);

  if (strsrch(prop, '/') != -1)
    return _set(space_dbase, explode(prop, "/"), data);

  return space_dbase[prop] = data;
}

varargs mixed query_space(string prop, int raw) {
  mixed data;

  if (!mapp(space_dbase)) return 0;

  if (strsrch(prop, '/') != -1)
    data = _query(space_dbase, explode(prop, "/"));
  else
    data = space_dbase[prop];

  if (functionp(data) && !raw)
    return (* data) (this_object());
  else
    return data;
}

int delete_space(string prop) {
  if (!mapp(space_dbase)) return 0;

  if (strsrch(prop, '/') != -1)
    return _delete(space_dbase, explode(prop, "/"));
  else {
    map_delete(space_dbase, prop);
    return 1;
  }
}

mixed add_space(string prop, mixed data) {
  mixed old;

  if (!mapp(space_dbase) || !(old = query_space(prop, 1)))
    return set_space(prop, data);

  if (functionp(old))
    error("dbase: add_space_temp() - called on a function type property.\n");

  return set_space(prop, old + data);
}

mapping query_entire_space_dbase() {
  //	if( (previous_object() != this_object())
  //	&&	(geteuid(previous_object()) != ROOT_UID) )
  //		error("dbase: query_entire_space_temp_dbase() - must has root euid or be this_object().\n");

  return space_dbase;
}

mixed set_space_temp(string prop, mixed data) {
  if (!mapp(tmp_space_dbase)) tmp_space_dbase = ([]);

  if (strsrch(prop, '/') != -1)
    return _set(tmp_space_dbase, explode(prop, "/"), data);

  return tmp_space_dbase[prop] = data;
}

varargs mixed query_space_temp(string prop, int raw) {
  mixed data;

  if (!mapp(tmp_space_dbase)) return 0;

  if (strsrch(prop, '/') != -1)
    data = _query(tmp_space_dbase, explode(prop, "/"));
  else
    data = tmp_space_dbase[prop];

  if (functionp(data) && !raw)
    return (* data) (this_object());
  else
    return data;
