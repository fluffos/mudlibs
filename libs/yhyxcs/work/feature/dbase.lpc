int delete_space_temp(string prop) {
  if (!mapp(tmp_space_dbase)) return 0;

  if (strsrch(prop, '/') != -1)
    return _delete(tmp_space_dbase, explode(prop, "/"));
  else {
    map_delete(tmp_space_dbase, prop);
    return 1;
  }
}

mixed add_space_temp(string prop, mixed data) {
  mixed old;

  if (!mapp(tmp_space_dbase) || !(old = query_space_temp(prop, 1)))
    return set_space_temp(prop, data);

  if (functionp(old))
    error("dbase: add_space_temp() - called on a function type property.\n");

  return set_space_temp(prop, old + data);
}

mapping query_entire_space_temp_dbase() {
  //	if( (previous_object() != this_object())
  //	&&	(geteuid(previous_object()) != ROOT_UID) )
  //		error("dbase: query_entire_space_temp_dbase() - must has root euid or be this_object().\n");

  return tmp_space_dbase;
}

//which是分舰队的mapping数组号，如果是第一分舰队的话，which应该是0
mapping query_sub_fleet(int which) {
  mapping fleets;

  if (!mapp(space_dbase)) return 0;

  if (!pointerp(fleets = query_space("sub_fleet"))) return 0;
  if (which >= sizeof(fleets)) return 0;
  return fleets[which];
}

//设定分舰队属性，which是舰队数组号，prop是参数名称，data是参数数据	
int set_sub_fleet(int which, string prop, mixed data) {
  mapping fleet;
  if (!mapp(fleet = this_object()->query_sub_fleet(which))) return 0;
  return fleet[prop] = data;
}

//增加一个舰队，四个基本指数设定，其余的设为默认值
mapping *add_sub_fleet(string shiptype, string name, int eff_amt, int max_amt) {
  int which;
  mapping result;
  mapping *fleets;

  which = sizeof(space_dbase["sub_fleet"]);
  result = ([]);

  if (!which) space_dbase["sub_fleet"] = ({});
  fleets = space_dbase["sub_fleet"];

  result["shiptype"] = shiptype;
  result["name"] = name;
  result["eff_amt"] = eff_amt;
  result["max_amt"] = max_amt;

  result["enable"] = 1;
  result["morale"] = 70;
  result["attacktype"] = "beam";
  result["energy"] = F_S_ATTRIBUTE->query_base_max_energy(shiptype);
  result["missile"] = F_S_ATTRIBUTE->query_base_max_missile(shiptype);
  result["craft"] = F_S_ATTRIBUTE->query_base_max_craft(shiptype);

  fleets += ({ result });
  set_space("sub_fleet", fleets);

  return fleets;
}

mixed set_current(string prop, mixed data) {
  if (!mapp(current)) current = ([]);

  if (strsrch(prop, '/') != -1)
    return _set(current, explode(prop, "/"), data);

  return current[prop] = data;
}

varargs mixed query_current(string prop, int raw) {
  mixed data;

  if (!mapp(current)) return 0;

  if (strsrch(prop, '/') != -1)
    data = _query(current, explode(prop, "/"));
  else
    data = current[prop];

  if (functionp(data) && !raw)
    return (* data) (this_object());
  else
    return data;
}

int delete_current(string prop) {
  if (!mapp(current)) return 0;

  if (strsrch(prop, '/') != -1)
    return _delete(current, explode(prop, "/"));
  else {
    map_delete(current, prop);
    return 1;
  }
}

mixed add_current(string prop, mixed data) {
  mixed old;

  if (!mapp(current) || !(old = query_current(prop, 1)))
    return set_current(prop, data);

  if (functionp(old))
    error("dbase: add_current() - called on a function type property.\n");

  return set_current(prop, old + data);
}

mapping query_entire_current_dbase() {
  //	if( (previous_object() != this_object())
  //	&&	(geteuid(previous_object()) != ROOT_UID) )
  //		error("dbase: query_entire_current_dbase() - must has root euid or be this_object().\n");

  return current;
}

//New Writen end



mixed set(string prop, mixed data) {
  if (!mapp(dbase)) dbase = ([]);

  if (strsrch(prop, '/') != -1)
    return _set(dbase, explode(prop, "/"), data);

  return dbase[prop] = data;
}

varargs mixed query(string prop, int raw) {
  mixed data;

  if (!mapp(dbase)) return 0;

  if (undefinedp(dbase[prop]) && (strsrch(prop, '/') != -1))
    data = _query(dbase, explode(prop, "/"));
  else
    data = dbase[prop];

  if (undefinedp(data) && default_ob)
    data = default_ob->query(prop, 1);

  if (raw) return data;

  return evaluate(data, this_object());
}

int delete(string prop) {
  if (!mapp(dbase)) return 0;

  if (strsrch(prop, '/') != -1)
    return _delete(dbase, explode(prop, "/"));
  else {
    map_delete(dbase, prop);
    return 1;
  }
}

mixed add(string prop, mixed data) {
  mixed old;

  if (!mapp(dbase) || !(old = query(prop, 1)))
    return set(prop, data);

  if (functionp(old))
    error("dbase: add() - called on a function type property.\n");

  return set(prop, old + data);
}

mapping query_entire_dbase() {
  //	if( (previous_object() != this_object())
  //	&&	(geteuid(previous_object()) != ROOT_UID) )
  //		error("dbase: query_entire_dbase() - must has root euid or be this_object().\n");

  return dbase;
}

