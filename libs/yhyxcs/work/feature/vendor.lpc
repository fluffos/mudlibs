#include <dbase.h>

//private void destruct_ob(object ob) { destruct(ob); }
int buy_object(object me, string what, int amount) {
  mapping goods, init_goods;
  string list, *name;
  int i, value;

  if (!mapp(goods = query("vendor_goods"))) return 0;
  name = keys(goods);
  for (i = 0; i < sizeof(name); i++) {
    if (what == name[i]->name() || what == (name[i]->query("id"))) {
      if (goods[name[i]] < amount)
        return 0;
      value = amount * (name[i]->query("value"));
      return value;
    }
  }
  return 0;

}

void compelete_trade(object me, string what, int amount) {
  string ob_file;
  object ob;
  mapping goods;
  string list, *name, last = "";
  int i, j;

  if (!mapp(goods = query("vendor_goods"))) return 0;
  name = keys(goods);
  for (i = 0; i < sizeof(name); i++) {
    if (what == name[i]->name() || what == (name[i]->query("id"))) {
      if (stringp(ob_file = name[i])) {
        goods[name[i]] -= amount;
        for (j = 1; j <= amount; j++) {
          ob = new(ob_file);
          // Let's decrement the amount if it goes to zero, delete it from vendor list
          if (!ob->move(me)) {
            ob->move(VOID_OB);
            call_out("destruct_ob", 1, ob);
          }
        }
        if (goods[name[i]] <= 0) {
          map_delete(goods, name[i]);
          last = "最后";
        }
        printf("你向%s买下%s%s%s%s.\n", this_object()->query("name"),
          last, chinese_number(amount),
          ob->query("unit"), ob->name());
        return;
      }
    }
  }
  return;
}

