int do_vendor_list(string arg) {
  mapping goods, init_goods;
  string list, *name;
  int i, value;

  if (!mapp(goods = query("vendor_goods"))) return 0;
  if (arg && !this_object()->id(arg)) return 0;

  name = keys(goods);
  if (!sizeof(name))
    return notify_fail("这儿的东西全卖光了。\n");
  list = "你可以购买下列这些：\n";

  for (i = 0; i < sizeof(name); i++) {
    value = name[i]->query("value");
    list += sprintf("%-10s %-20s ：%10d %s\n",
      name[i]->name(),
      name[i]->query("id"),
      value,
      "费沙马克");
  }

  write(list);
  return 1;
}
