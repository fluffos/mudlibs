// apprentice.c

#include <dbase.h>

int is_apprentice_of(object ob) {
  mapping family;

  if (!mapp(family = query("family"))) return 0;

  if (family["master_id"] == (string)ob->query("id")
    && family["master_name"] == (string)ob->query("name"))
    return 1;

  return 0;
}

void assign_apprentice(string title, int privs) {
  mapping family;

  if (!mapp(family = query("family"))) return;

  family["privs"] = privs;

  if (stringp(title) && (title != "") /* && ( title != "幕僚" )*/) {
    family["title"] = title;
    set("title", sprintf("%s%s", family["family_name"], family["title"]));
  } else {
    family["title"] = "幕僚";
    switch (family["generation"]) {
      case 1:
        family["title"] = "司令官";
        set("title", sprintf("%s%s", family["family_name"], family["title"]));
        break;
      case 2:
        set("title", sprintf("%s首席%s", family["family_name"], family["title"]));
        break;
      case 3:
        set("title", sprintf("%s次席%s", family["family_name"], family["title"]));
        break;
      case 4:
        set("title", sprintf("%s高级%s", family["family_name"], family["title"]));
        break;
      case 5:
        set("title", sprintf("%s中级%s", family["family_name"], family["title"]));
        break;
      case 6:
        set("title", sprintf("%s初级%s", family["family_name"], family["title"]));
        break;
      default:
        set("title", sprintf("%s低级%s", family["family_name"], family["title"]));
    }
  }
}

// This is used for NPC, or start a new family for a player.
varargs void create_family(string family_name, int generation, string title) {
  mapping family;

  family = allocate_mapping(6);

  family["family_name"] = family_name;
  family["generation"] = generation;

  set("family", family);

  // priv = -1 for ALL privileges.
  assign_apprentice(title, -1);
}

int recruit_apprentice(object ob) {
  string student_name;
  mapping my_family, family;

  if (ob->is_apprentice_of(this_object())) return 0;
  if (!mapp(my_family = query("family"))) return 0;

  family = allocate_mapping(sizeof(my_family));
  family["master_id"] = query("id");
  family["master_name"] = query("name");
  family["family_name"] = my_family["family_name"];
  family["generation"] = my_family["generation"] + 1;
  family["enter_time"] = time();
  ob->set("family", family);

  if (stringp(student_name = query("student_title")))
    ob->assign_apprentice(student_name, 0);
  else ob->assign_apprentice("", 0);
  return 1;
}
