#include <ansi.h>
//#include <dbase.h>

inherit F_DISTANCE;

int do_geton() {
  object me, here, flagship;
  string name;

  me = this_player();
  here = this_object();

  if (me->query_space("landin") != here->query("globe"))
    return notify_fail("您的舰队现在并没有停泊在这个宇宙港。\n");
  if (objectp(flagship = new("/std/room/flagship"))) {
    if (stringp(name = me->query_space("flagship"))) {
      flagship->set("short", HIC "【旗舰：" + name + "】" NOR);
    }

    flagship->set("globe", here->query("globe"));
    flagship->set("exits/out", file_name(here));

    if (me->move(flagship)) {
      message("vision", HIY "" + me->name() + "离开" + here->query("short")
        +HIY "准备率领舰队启航了。\n" NOR, here);
      tell_object(me, HIY "你离开" + here->query("short") + HIY "准备率领舰队启航了。\n" NOR);
      return 1;
    }
    return 0;
  }
  return 0;
}
