//combat.c
//combat.c

#include <ansi.h>
#include <command.h>

inherit F_CLEAN_UP;
inherit F_DISTANCE;

int main(object me, string arg) {
  int alpha, beta;
  string result;
  object obj, env;

  seteuid(getuid());

  if (!objectp(env = environment(me))) return 0;

  if (!env->is_space_room() && !env->is_planet())
    return notify_fail("这里进行舰队作战？好象不大行啊。\n");

  if (!arg)
    return notify_fail("我军要攻击哪一支舰队？\n");

  if (!objectp(obj = present(arg, env)))
    return notify_fail("我军要攻击哪一支舰队？\n");

  if (!calculate_distance(obj, me, me->query_space("scouting")))
    return notify_fail("我军要攻击哪一支舰队？\n");

  if (!obj->is_character() /*&& !obj->is_planet()*/)
    return notify_fail("那并不是我军可以攻击的对象。\n");

  if (stringp(obj->query_space("vassalage"))
    && (obj->query_space("vassalage") != "中立")
    && (obj->query_space("vassalage") == me->query_space("vassalage")))
    return notify_fail("难道你想叛国吗？！\n");

  if (me->is_combating(obj))
    return notify_fail("攻击！攻击！攻击！\n");

  if (obj == me)
    return notify_fail("自己与自己作战，你疯了吗？\n");

  tell_object(me, CYN "\n我军整合舰列，准备对" + obj->space_short(1) + "进行攻击！\n\n" NOR);

  me->combat_ob(obj);

  result = "警报！！！军事工作官报告：我军舰队遭到攻击！\n敌军";
  if (calculate_distance(me, obj, obj->query_space("scouting"))) {
    obj->combat_ob(me);
    result += me->space_short(1) + "，";
  } else result += "不明，";

  alpha = me->query_space("x-dir") - obj->query_space("x-dir");
  beta = me->query_space("y-dir") - obj->query_space("y-dir");

  if (!alpha && !beta) result += "攻击近在咫尺！\n";
  else result = "部队受损来自" + POSITION_CMD->display_direction(result, alpha, beta);

  tell_object(obj, HIR + result + "\n" NOR);
  return 1;
}

int help(object me) {
  write(@HELP
指令格式：
	combat <舰队名称>
 
命令我军舰队与另一支舰队交战。
 
HELP
  );
  return 1;
}
