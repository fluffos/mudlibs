inherit F_CLEAN_UP;

int main(object me, string arg) {
  string skill;
  int check;

  seteuid(getuid());

  if (!environment(me)->is_space_room() && !environment(me)->is_planet())
    return notify_fail("能力提升只能在星际空间使用。\n");

  if (!arg) return notify_fail("你要提升哪一种能力？\n");

  if (!stringp(skill = me->query_s_skill_mapped(arg)))
    return notify_fail(to_chinese(arg) + "没有被 Enalbe 任何特殊技能。\n");

  if (me->query_space_temp("apply"))
    return notify_fail("你已经有一种能力在提升状态中了。\n");

  check = S_SKILL_D(skill)->powerup(me, arg);
  if (!check) return notify_fail("能力提升失败。\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式：powerup <能力>

<能力>：是各种基本技能之一。如Beam, Missile, Airforce 等等，enable在这样基本技能上
	的特殊技能如果能够提供powerup能力，则此命令将在一定时间内加强你的这项能力。

HELP
  );
  return 1;
}
