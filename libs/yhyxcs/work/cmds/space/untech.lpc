#include <ansi.h>

inherit F_CLEAN_UP;

int do_untech(object me, object ob);
string tech_level(int i);

int main(object me, string arg)
{
	object ob, env, *inv;
	int i;

	seteuid(getuid());

	if( !arg ) return notify_fail("你要利用哪个装备为旗舰进行改装？\n");

	env = environment(me);

	if( env->is_space_room() || env->is_planet() )
		return notify_fail("只有旗舰在宇宙港停泊时才可以进行改装。\n");
	if( me->query_space("landin") != env->query("globe") )
		return notify_fail("你的旗舰并没有在这个宇宙港停泊。\n");

/*	if( arg == "all")
	{
		inv = all_inventory(me);
		for(i=0; i<sizeof(inv); i++)
			do_untech(me, inv[i]);
		write("Ok.\n");
		return 1;
	}
*/
	if( !objectp(ob = present(arg, me)) )
		return notify_fail("旗舰没有装载这样装备。\n");
	return do_untech(me, ob);
}

int do_untech(object me, object ob)
{
	string str;

	if( (string)ob->query("equipped") != "tech" )
		return notify_fail("你的旗舰并没有用这种装备进行过改装。\n");

	if( ob->untech() )
	{
		switch( ob->query("skill_type") )
		{
		   case "beam":
			str = "  主炮攻击能力" + tech_level( - ob->query("weapon/beam") );
			break;
		   case "missile":
			str = "  飞弹攻击能力" + tech_level( - ob->query("weapon/missile") );
			break;
		   case "airforce":
			str = "  舰载艇攻击能力" + tech_level( - ob->query("weapon/air_force") );
			break;
		   default :
			str = "  攻击能力效果不详。\n";
		}
		str += "  防御能力" + tech_level( - ob->query("weapon/defending") );
		str += "  速度" + tech_level( - ob->query("weapon/speed") );
		if( me->query_space("flagship") )
			str = me->query_space("flagship") + "】\n" + str;
		else str = "：\n" + str;
		tell_object(me,HIW"军事工作官报告：旗舰卸装成功。通过" + ob->name() + "的卸除，\n我舰队【旗舰："
			+ str + NOR);
		return 1;
	}
	else return 0;
}

string tech_level(int i)
{
	if( !i ) return "没有什么改变。\n";
	if( i < -30 ) return "有极大幅度的降低\n";
	else if( i < -20 ) return "有较大幅度的降低\n";
	else if( i < -10 ) return "有一定程度的降低\n";
	else if( i < -5 ) return "有较小幅度的降低\n";
	else if( i < 0 ) return "有极小幅度的降低\n";

	else if( i > 30 ) return "有极大幅度的提高\n";
	else if( i > 20 ) return "有较大幅度的提高\n";
	else if( i > 10 ) return "有一定程度的提高\n";
	else if( i > 5 ) return "有较小幅度的提高\n";
	else if( i > 0 ) return "有极小幅度的提高\n";
}

int help(object me)
{
  write(@HELP
指令格式 : untech all | <物品名称>
 
这个指令让你的舰队去除某种装备技术的影响。
 
HELP
    );
    return 1;
}
 
