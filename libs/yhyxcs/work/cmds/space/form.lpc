// form.c Writen by Alarms 8/18/99

#include <ansi.h>

inherit F_CLEAN_UP;
inherit F_CURRENT;

int main(object me, string arg) {
  if (!environment(me)->is_space_room() && !environment(me)->is_planet())
    return notify_fail("现在你并没有率领舰队在外太空航行。\n");

  if (!arg) add_command(me, ({ "form" }));
  else add_command(me, ({ "form", arg }));
  write("命令已经向舰队下达。\n");
  return 1;
}

int sub_main(object me, string arg) {
  int level;
  seteuid(getuid(me));

  level = me->query_s_skill("formation", 1);
  if (!level) return 0;

  if (!arg) {
    me->map_s_skill("formation");
    tell_object(me, HIW "你的舰队阵型已经改为三角阵。\n" NOR);
    return 1;
  }

  if (arg == "shuttle" && me->query_s_skill("shuttle", 1)) {
    me->map_s_skill("formation", "shuttle");
    tell_object(me, HIW "你的舰队阵型已经改为" + to_chinese(arg) + "。\n" NOR);
    return 1;
  }
  if (arg == "round" && level >= 10 && me->query_s_skill("round", 1)) {
    me->map_s_skill("formation", "round");
    tell_object(me, HIW "你的舰队阵型已经改为" + to_chinese(arg) + "。\n" NOR);
    return 1;
  }
  if (arg == "trapezia" && level >= 20 && me->query_s_skill("trapezia", 1)) {
    me->map_s_skill("formation", "trapezia");
    tell_object(me, HIW "你的舰队阵型已经改为" + to_chinese(arg) + "。\n" NOR);
    return 1;
  }
  if (arg == "sector" && level >= 30 && me->query_s_skill("sector", 1)) {
    me->map_s_skill("formation", "sector");
    tell_object(me, HIW "你的舰队阵型已经改为" + to_chinese(arg) + "。\n" NOR);
    return 1;
  }
  if (arg == "fovea" && level >= 40 && me->query_s_skill("fovea", 1)) {
    me->map_s_skill("formation", "fovea");
    tell_object(me, HIW "你的舰队阵型已经改为" + to_chinese(arg) + "。\n" NOR);
    return 1;
  }
  write("舰队阵型无法改变！\n");
  return 0;
}

int help(object me) {
  write(@HELP
指令格式：
	form [阵型名称]

	"shuttle":"梭形阵";"round":"圆形阵";
	"trapezia":"梯形阵";"sector":"扇形阵";

这个指令让你改变舰队的阵型。如果不加参数则阵型将改变为三角阵。
例：form round
 
HELP
  );
  return 1;
}
