//New Writen by Alarms & Lysh 4/10/99
//Update by Alarms 4/24/99

#include <ansi.h>
inherit F_CLEAN_UP;
inherit F_DISTANCE;
inherit F_S_ATTRIBUTE;


void create() { seteuid(getuid()); }

int main(object me, string arg)
{
	object obj;
	object *result;
	string direction;
	int alpha,beta,speed,range,pow;

	if( !environment(me)->is_space_room() )
		return notify_fail("只有在广袤的宇宙空间中才能MOVE。\n");
	if( !arg ) return notify_fail("你要往哪里走？\n");

	if( undefinedp( range = me->query_space("scouting")) )
	{
		range = 1;
		me->set_space("scouting",1);
	}

	if( sscanf(arg, "%d %d", alpha, beta) != 2 )
	{
		if( ( obj = present(arg, environment(me)) )
			&& calculate_distance(me,obj,range) )
		{
			if( obj->is_character() )
			{
				alpha = obj->query_space("x-dir");
				beta = obj->query_space("y-dir");
			}
			else
			{

				alpha = obj->query("x-dir");
				beta = obj->query("y-dir");
			}
		}
		else return notify_fail("没有这个星球，舰队或者星际物。\n");
	}
	if( undefinedp(me->query_space("x-dir")) ) me->set_space("x-dir",0);
	if( undefinedp(me->query_space("y-dir")) ) me->set_space("y-dir",0);
	speed = query_eff_spd(me);
	if( speed < 1 ) speed = 1;
	me->set_space_temp("x-des",alpha);
	me->set_space_temp("y-des",beta);
	alpha = alpha - me->query_space("x-dir");
	beta = beta - me->query_space("y-dir");

	pow = to_int(sqrt(alpha*alpha+beta*beta));
	if( pow < 1 ) return notify_fail("已经到达。\n");

	if( alpha == 0 ) direction = "";
	else if( alpha > 0 ) direction = "Alpha +";
	else direction = "Alpha -";

	if( beta == 0 ) direction += "";
	else if( alpha > 0 ) direction += "，Beta +";
	else direction += "，Beta -";	

	result = receiver_filter(all_inventory(environment(me)),me);

	message("vision",HIY"\n" + me->space_short() + "的尾部开始放射出眩白的光焰，向着"
		+ direction + "方向驶去...\n"NOR,result,({}));
	tell_object(me,HIY"你的舰队开始起动，向着" + direction + "方向行进了。\n"NOR);

	me->set_space_temp("addx",(int)(speed*alpha/pow));
	me->set_space_temp("addy",(int)(speed*beta/pow));
	me->set_space_temp("times",(int)(pow/speed));
	return 1;
}

int help(object me)
{
	write(@HELP
指令格式 : move <坐标|星球|舰队|星际物>
 
命令舰队向指定的方向移动。
[例]  move 1000 2000	移动到坐标Alpha 1000，Beta 2000
[例]  move phezzan	移动到行星费沙所在坐标
[例]  move guard	移动到ID为guard的NPC所在坐标
[例]  move wreck	移动到ID为wreck的星际物所在坐标

HELP
    );
    return 1;
}
