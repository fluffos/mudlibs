inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string specify,form,victim;
	object *targets,target;
	int check;

	seteuid(getuid());

	if( !environment(me)->is_space_room() && !environment(me)->is_planet() )
		return notify_fail("特殊攻击命令的下达只能在星际空间中。\n");

	if( !me->is_combating() ) return notify_fail("特殊攻击只能在战斗中使用。\n");

	if( !arg ) return notify_fail("你要命令舰队完成哪一种特殊攻击？\n");

	if( sscanf(arg, "%s %s", specify, victim) != 2 )
	{
		if( sizeof(me->query_againster()) > 1 )
			return notify_fail("你要对哪一支敌对舰队进行特殊攻击？\n");
		if( !stringp(form = me->query_s_skill_mapped("formation")) )
			return notify_fail("舰队正采用基本阵型--三角阵，没有特殊攻击！\n");

		write(sprintf("it is specify--%s\n",specify));
		write(sprintf("it is arg--%s\n",arg));
		write(sprintf("it is victim--%s\n",victim));
		write(sprintf("it is target--%O\n",target));
		check = S_SKILL_D(form)->specify(me,arg);
		if( !check ) return notify_fail("舰队现在采用的阵型没有这种特殊攻击！\n");
		return 1;
	}
	if( !(target = present(victim,environment(me))) )
		return notify_fail("你要对哪支舰队进行特殊攻击？\n");
	if( !F_DISTANCE->calculate_distance(me,target,me->query_space("scouting")) )
		return notify_fail("你要对哪支舰队进行特殊攻击？\n");

	targets = me->query_againster();
	if( member_array(target,targets) == -1 )
		return notify_fail("你与这支舰队并没有处于交战状态！\n");
	if( undefinedp(form = me->query_s_skill_mapped("formation")) )
		return notify_fail("舰队正采用基本阵型--三角阵，没有特殊攻击！\n");

	write(sprintf("it is specify--%s\n",specify));
	write(sprintf("it is arg--%s\n",arg));
	write(sprintf("it is victim--%s\n",victim));
	write(sprintf("it is target--%O\n",target));
	check = S_SKILL_D(form)->specify(me,specify,victim);
	if( !check ) return notify_fail("舰队现在采用的阵型没有这种特殊攻击！\n");
	return 1;
}

int help (object me)
{
        write(@HELP
指令格式：specify <特殊攻击> [敌对舰队]

<特殊攻击>：是阵型所具有的特殊攻击，但是基本阵型--三角阵没有特殊攻击。
[敌对舰队]：正在与我方舰队交战的敌对舰队，如果只与一支舰队交战，可以不
		指定敌方舰队名称，但是如果同时与多个敌人交战，必须指定
		特殊攻击是对哪一支舰队。

只要是 enable 的阵型有特殊攻击的，都可以用这个指令使用。
HELP
        );
        return 1;
}
