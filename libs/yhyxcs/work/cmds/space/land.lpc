#include <ansi.h>

inherit F_CLEAN_UP;
inherit F_DISTANCE;

int main(object me, string arg) {
  string landto;
  object obj, planet, *result;

  seteuid(getuid());

  if (!environment(me)->is_space_room() && !environment(me)->is_planet())
    return notify_fail("现在你并没有率领舰队在外太空航行。\n");

  if (!arg)
    return notify_fail("要向哪里降落？\n");

  planet = environment(me);
  if (planet->is_planet()) {
    if (arg != "here" && arg != planet->query("id"))
      return notify_fail("舰队并不在指定星球的轨道上。\n");
  } else {
    if (!(planet = present(arg, planet))
      || !planet->is_planet()
      || !distance(me, planet->query("x-dir"), planet->query("y-dir"), me->query_space("scouting"))
    )
      return notify_fail("没有这个星球。\n");
  }

  if ((me->query_space("x-dir") != planet->query("x-dir"))
    || (me->query_space("y-dir") != planet->query("y-dir")))
    return notify_fail("还没有到达星球空域，无法降落。\n");
  if (!(landto = planet->query("landto")))
    return notify_fail("不允许降落。\n");
  if (me->is_combating())
    return notify_fail("战斗中降落？！你疯了吗？！！\n");
  if (!(obj = find_object(landto)))
    call_other(landto, "???");
  if (!(obj = find_object(landto)))
    return notify_fail("无法降落。\n");

  me->set("channel_id", me->name() + "(" + me->query("id") + ")");

  result = receiver_filter(all_inventory(environment(me)), me);

  message("vision", HIY "随着震耳欲聋的反推声，" + me->space_short(1) + HIY "整合舰列，向"
    +planet->query("name") + HIY "的宇宙港降落了···\n" NOR, result, ({}));

  tell_object(me, HIY "随着震耳欲聋的反推声，你的舰队整合舰列，向" + planet->query("name")
    +HIY "的宇宙港降落了···\n" NOR);

  if (me->move(obj)) {
    message("vision", HIY "随着震耳欲聋的反推声，" + me->space_short() + HIY "降落在"
      +planet->query("name") + HIY "宇宙港。\n" NOR, obj, ({ me }));
    me->set_space("landin", obj->query("globe"));
    return 1;
  }
  return 0;
}

int help(object me) {
  write(@HELP
指令格式: land <星球>
 
这个指令让你可以率领舰队向指定的星球降落。
如果舰队正处于星球的轨道之上，也可以使用"land here"来降落。
 
HELP
  );
  return 1;
}
