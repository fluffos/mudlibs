// apprentice.c Update by Alarms 1/29/2000

inherit F_CLEAN_UP;

int main(object me, string arg) {
  object ob, old_app, uniform;
  mapping family, skills;
  int i;
  string dir, uniform_from, uniform_to, id;
  string *skname;

  seteuid(getuid());

  if (environment(me)->is_space_room() || environment(me)->is_planet())
    return notify_fail("在外太空追随别人为其效力实在不太方便。\n");

  if (!arg) return notify_fail("指令格式：apprentice [cancel]|<对象>\n");

  if (arg == "cancel") {
    old_app = me->query_temp("pending/apprentice");
    if (!objectp(old_app))
      return notify_fail("你现在并不想为任何人效力。\n");
    write("你改变主意不想追随" + old_app->name() + "，为其效力了。\n");
    tell_object(old_app, me->name() + "改变主意不想追随你，为你效力了。\n");
    me->delete_temp("pending/apprentice");
    return 1;
  }

  if (!(ob = present(arg, environment(me))) || !ob->is_character())
    return notify_fail("你想追随谁？为谁效力？\n");
  if (!living(ob))
    return notify_fail("你必须先把" + ob->name() + "弄醒。\n");
  if (ob == me)
    return notify_fail("好主意....不过没什么用。\n");

  if (me->is_apprentice_of(ob)) {
    message_vision("$N打点精神，踌躇满志向$n行了一个标准的军礼。\n", me, ob);
    ob->re_rank(me);
    return 1;
  }

  if (!mapp(ob->query("family")))
    return notify_fail(ob->name() + "并不属于任何一方势力，你恐怕找错人了。\n");

  if (userp(ob) && (int)ob->query("family/privs") != -1)
    return notify_fail("对方玩家还没有达到能够统驭别人的能力。\n");

  if ((string)me->query("family/family_name") == (string)ob->query("family/family_name"))
    if ((int)me->query("family/generation") <= (int)ob->query("family/generation"))
      return notify_fail(ob->name() + "的职位并不比你高！\n");

  if (me->query_space("vassalage") == ob->query_space("vassalage"))
    if (me->query("rank") >= ob->query("rank"))
      return notify_fail(ob->name() + "的官阶并不比你高！\n");

  // If the target is willing to recruit us already, we do it.
  if ((object)ob->query_temp("pending/recruit") == me) {
    if (me->query("family") && ((string)me->query("family/family_name") != (string)ob->query("family/family_name"))) {
      message_vision("\n$N似乎改变了从前的志向，转而加入$n麾下！！\n"
        "$N打点精神，踌躇满志的向$n行了一个标准的军礼。\n\n",
        me, ob);
      me->set("score", me->query("score") / 2);

      if (stringp(me->query_space("vassalage"))
        && (me->query_space("vassalage") != "中立")
        && (ob->query_space("vassalage") != me->query_space("vassalage"))) {
        me->add("betrayer", 1);
        me->set("score", 0);
        if (me->query("rank") <= 3) me->set("rank", 0);
        else me->add("rank", -3);
      }
    } else {
      message_vision("\n$N立定了自己的志向，打算加入$n麾下。\n"
        "$N打点精神，踌躇满志的向$n行了一个标准的军礼。\n\n",
        me, ob);
      me->set("rank", 0);
    }
    ob->recruit_apprentice(me);
    ob->delete_temp("pending/recruit");
    tell_object(ob, "有一位愿意追随你的人加入了！\n");
    family = me->query("family");
    if (ob->query_space("vassalage"))
      me->set_space("vassalage", ob->query_space("vassalage"));
    printf("您已经成为%s中的一员了。\n", me->query("family/family_name"));
    me->set("next_salary_time", me->query("mud_age") + 7200);

    id = me->query("id");
    seteuid(ROOT_UID);
    switch (me->query_space("vassalage")) {
      case "帝国":
        uniform_from = read_file("/obj/cloth/uniform_e.lpc");
        break;
      case "同盟":
        uniform_from = read_file("/obj/cloth/uniform_a.lpc");
        break;
      case "费沙":
        uniform_from = read_file("/obj/cloth/uniform_p.lpc");
        break;
      default:
        uniform_from = read_file("/obj/cloth/uniform.lpc");
    }
    uniform_to = DATA_DIR + "login/" + id[0..0] + "/" + id + "/uniform.lpc";
    dir = DATA_DIR + "login/" + id[0..0] + "/" + id + "/";

    if (!pointerp(get_dir(dir)))
      if (!mkdir(dir)) return notify_fail("目录创建失败.\n");
    if (!write_file(uniform_to, uniform_from, 1))
      return notify_fail("军服文件读写失败。\n");
    if (objectp(find_object(uniform_to)))
      destruct(find_object(uniform_to));
    if (!(uniform = new(uniform_to)))
      return notify_fail("军服载入失败。\n");
    uniform->move(me);
    message_vision("$N交给$n一套崭新的" + uniform->name() + "。\n", ob, me);
    seteuid(getuid());

    me->save();

    return 1;
  } else {
    old_app = me->query_temp("pending/apprentice");
    if (ob == old_app)
      return notify_fail("你想追随" + ob->name() + "为其效力，但是对方还没有答应。\n");
    else if (objectp(old_app)) {
      write("你改变主意不想追随" + old_app->name() + "为其效力了。\n");
      tell_object(old_app, me->name() + "改变主意不想追随你，为你效力了。\n");
    }
    message_vision("$N想要追随$n，为其效力。\n", me, ob);
    me->set_temp("pending/apprentice", ob);
    if (userp(ob))
      tell_object(ob, "如果你愿意将" + me->name() + "收归麾下，请用 recruit 指令。\n");
    else ob->attempt_apprentice(me);
    return 1;
  }
}


int help(object me) {
  write(@HELP
指令格式 : apprentice [cancel]|<对象>

这个指令能让你可以追随某人并为其效力，如果对方同意让你加入的话，则你将成为其阵营中
的一员，否则必须等到对方用 recruit 指令。

如果你对自己的上司使用这个指令，则会成为向其行礼，并请求给予相应的职位。

请参考相关指令 expell、recruit
HELP
  );
  return 1;
}
