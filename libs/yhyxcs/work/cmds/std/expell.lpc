// expell.c

#include <skill.h>

inherit F_CLEAN_UP;

void create() { seteuid(getuid()); }

int main(object me, string arg) {
  object ob;
  string *skname;
  mapping skills;
  int i;

  if (environment(me)->is_space_room() || environment(me)->is_planet())
    return notify_fail("在外太空开除别人实在不太方便。\n");

  if (!arg || !ob = present(arg, environment(me)))
    return notify_fail("你要罢免谁的职位？\n");

  if (!ob->is_character())
    return notify_fail("你只能罢免某“人”。\n");

  if (!userp(ob))
    return notify_fail("你只能罢免玩家的职务。\n");

  if ((me->query("family/privs") == -1)
    && (string)me->query("family/family_name") == (string)ob->query("family/family_name")) {
    message_vision("\n$N对著$n说道：你从此不再是"
      +me->query("family/family_name") + "的一员了，去适合你的地方吧！\n\n",
      me, ob);
    tell_object(ob, "\n你被" + me->query("family/title") + me->name() + "革除了职务！\n\n");
  } else if (ob->is_apprentice_of(me)) {
    message_vision("\n$N对著$n说道：你的发展实在与我的期望相差甚远，还是去适合你的地方吧！\n\n",
      me, ob);
    tell_object(ob, "\n你被" + me->query("family/title") + me->name() + "革除了职务！\n\n");
  } else return notify_fail("这个人不是你的属下。\n");

  ob->delete("family");
  ob->delete("title");
  ob->set("score", 0);
  skills = ob->query_s_skills();

  if (mapp(skills)) {
    skname = keys(skills);
    for (i = 0; i < sizeof(skname); i++)
      skills[skname[i]] /= 2;
  }
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : expell <某人>

这个指令可以让你将不成才的属下革职，被革职的人所有技能都会降到原来的一半，
而且功绩会变成零，这对於一个人物而言是一个「比死还严重」的打击，请你在革
职任何一个人之前务必审慎考虑。

HELP
  );
  return 1;
}
