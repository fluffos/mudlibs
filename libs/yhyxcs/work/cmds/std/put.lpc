inherit F_CLEAN_UP;

int do_put(object me, object obj, object dest);

void create() { seteuid(getuid()); }

int main(object me, string arg) {
  string target, item;
  object obj, dest, env, *inv, obj2;
  int i, amount, in_space = 0;

  env = environment(me);
  if (env->is_planet() || env->is_space_room())
    in_space = 1;

  if (!arg) return notify_fail("你要将什麽东西放进哪里？\n");

  if (sscanf(arg, "%s in %s", item, target) != 2)
    return notify_fail("你要将什麽东西放进哪里？\n");

  if (!in_space) {
    dest = present(target, me);
    if (!dest || living(dest)) dest = present(target, env);
    if (!dest || living(dest))
      return notify_fail("这里没有这样东西。\n");

    if (sscanf(item, "%d %s", amount, item) == 2) {
      if (!objectp(obj = present(item, me)))
        return notify_fail("你身上没有这样东西。\n");
      if (obj->is_s_equip())
        return notify_fail("你身上没有这样东西。\n");
      if (!obj->query_amount())
        return notify_fail(obj->name() + "不能被分开。\n");
      if (amount < 1)
        return notify_fail("东西的数量至少是一个。\n");
      if (amount > obj->query_amount())
        return notify_fail("你没有那麽多的" + obj->name() + "。\n");
      else if (amount == (int)obj->query_amount())
        return do_put(me, obj, dest);
      else {
        obj->set_amount((int)obj->query_amount() - amount);
        obj2 = new(base_name(obj));
        obj2->set_amount(amount);
        return do_put(me, obj2, dest);
      }
    }

    if (item == "all") {
      inv = all_inventory(me);
      for (i = 0; i < sizeof(inv); i++)
        if (inv[i] != dest && !inv[i]->is_s_equip()) do_put(me, inv[i], dest);
      write("OK!\n");
      return 1;
    }

    if (!objectp(obj = present(item, me)))
      return notify_fail("你身上没有这样东西。\n");
    if (obj->is_s_equip())
      return notify_fail("你身上没有这样东西。\n");

    return do_put(me, obj, dest);
  } else {
    dest = present(target, env);
    if (!dest || living(dest) || !F_DISTANCE->calculate_distance(
      me,
      dest,
      me->query_space("scouting")
    ))
      return notify_fail("这里没有这样东西。\n");
    if (!F_DISTANCE->calculate_distance(me, dest, 1))
      return notify_fail("旗舰与目标距离过远，无法转移。\n");
    if (!objectp(obj = present(item, me)))
      return notify_fail("你的旗舰上没有这样东西。\n");
    if (!obj->is_s_equip())
      return notify_fail("你的旗舰上没有这样东西。\n");
    if (obj->query("no_drop") || obj->query("no_get"))
      return notify_fail("这样东西不能被随便移动。\n");

    if (obj->move(dest)) {
      tell_object(me, "旗舰上的" + obj->name() + "已经转移到" + dest->name() + "去了。\n");
      dest->insert_object(obj);
      return 1;
    } else return 0;
  }
}

int do_put(object me, object obj, object dest) {
  if (obj->query("no_drop") || obj->query("no_get"))
    return notify_fail("这样东西不能被随便移动。\n");

  if (obj->move(dest)) {
    message_vision(sprintf("$N将一%s%s放进%s。\n",
      obj->query("unit"), obj->name(), dest->name()),
      me);
    dest->insert_object(obj);
    return 1;
  } else return 0;
}

int help(object me) {
  write(@HELP
指令格式 : put <物品名称> in <某容器>

这个指令可以让你将某样物品放进一个容器，当然，首先你要拥有这样物品。

HELP
  );
  return 1;
}
