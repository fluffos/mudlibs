// say.c
//New Writen by Alarms 4/24/99
//Update by Alarms 5/9/99

#include <ansi.h>

inherit F_CLEAN_UP;

int say_space(object me, string arg);
int say_common(object me, string arg);

int main(object me, string arg) {
  seteuid(getuid());

  if (environment(me)->is_space_room() || environment(me)->is_planet())
    return say_space(me, arg);
  else return say_common(me, arg);
}

int say_space(object me, string arg) {
  if (!arg) {
    write("你胡乱忙活着但不知道要发送什么信息。\n");
    return 1;
  }

  arg = replace_string(arg, "\n", " ");

  write(CYN "你向茫茫的星系发出电波：" + arg + "\n" NOR);
  message("sound", CYN + "截获到" + me->space_short() + "发送的电波：" + arg + "\n" NOR,
    environment(me), me);

  // The mudlib interface of say
  all_inventory(environment(me))->relay_say(me, arg);
  return 1;
}

int say_common(object me, string arg) {
  if (!arg) {
    write("你自言自语不知道在说些什麽。\n");
    message("sound", me->name() + "自言自语不知道在说些什麽。\n",
      environment(me), me);
    return 1;
  }

  arg = replace_string(arg, "\n", " ");

  if ((int)me->query("kee") < (int)me->query("max_kee") / 5)
    arg = replace_string(arg, " ", " ... ") + " ...";

  write(CYN "你说道：" + arg + "\n" NOR);
  message("sound", CYN + me->name() + "说道：" + arg + "\n" NOR,
    environment(me), me);

  // The mudlib interface of say
  all_inventory(environment(me))->relay_say(me, arg);

  return 1;
}

int help(object me) {
  write(@HELP
指令格式: say <讯息>
 
说话，所有跟你在同一个房间的人都会听到你说的话。
星际中发送信息，在同一星系的舰队都会捕获到你的信息。
 
注: 本指令可用 ' 取代.
 
HELP
  );
  return 1;
}
