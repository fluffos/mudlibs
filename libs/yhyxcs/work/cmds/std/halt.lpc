// halt.c

#include "/doc/help.h"
inherit F_CLEAN_UP;

int main(object me, string arg) {
  //	if( me->is_busy() ) {
  //		me->interrupt_me(me, "halt");
  //		write("Ok.\n");
  //		return 1;
  //	}

  seteuid(getuid());

  if (environment(me)->is_planet() || environment(me)->is_space_room())
    return notify_fail("这个命令在外太空无法实行。\n");

  if (!me->is_fighting())
    return notify_fail("你现在并没有在战斗。\n");
  if (wizardp(me)) {
    me->remove_all_killer();
    message_vision("$N用巫师的神力停止了这场打斗。\n", me);
  } else {
    me->remove_all_enemy();
    message_vision("$N向後一跃，离开战圈罢手不斗了。\n", me);
  }

  write("Ok.\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式: halt

终止你正在做的事。

例如，你可以在练内力时使用halt指令，这会终止你练气过程。

也可以停止所有与你正在进行的比试，但是正在跟你性命相搏的敌人通常
不会轻易言和。
HELP
  );
  return 1;
}
