// buy.c New Writen by Alarms 7/8/99

#include <ansi.h>

inherit F_CLEAN_UP;

void create() { seteuid(getuid()); }

int main(object me, string arg) {
  string item, targ;
  object owner, *inv;
  int price, change, amount, i;
  amount = 0;

  if (environment(me)->is_planet() || environment(me)->is_space_room())
    return notify_fail("在外太空买东西好象不太行。\n");

  if (!arg || sscanf(arg, "%d %s from %s", amount, item, targ) != 3)
    if (!arg || sscanf(arg, "%s from %s", item, targ) != 2)
      return notify_fail("指令格式：buy [<数目>] <某物> from <某人>\n");

  if (amount < 1) amount = 1;
  if (!objectp(owner = present(targ, environment(me))))
    return notify_fail("你要跟谁买东西？\n");

  if (userp(owner)) {
    write("你想向" + owner->name() + "购买「" + item + "」。\n");
    tell_object(owner, me->name() + "想向你购买「" + item + "」。\n");
    return 1;
  }

  if ((price = owner->buy_object(me, item, amount)) < 1)
    return notify_fail("对方好像没有你想要的东西。\n");
  if (!intp(price)) return notify_fail("error");

  inv = all_inventory(me);
  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i]->name() == "ＩＤ卡") {
      if (!inv[i]->query("owner_name") && !inv[i]->query("owner_id")) {
        write(CYN + owner->name() + "说道：您的这张卡似乎有些问题，无法付帐。\n" NOR);
        return 1;
      }
      if (inv[i]->query("owner_name") != me->name()) {
        write(CYN + owner->name() + "说道：这张卡不是您的吧？上面记录的信息和您不符。\n" NOR);
        return 1;
      }
      if (inv[i]->query("owner_id") != me->query("id")) {
        if (random(25 - me->query_kar())) {
          me->set("next_trade_time", time() + 3600);
          destruct(inv[i]);
          write(CYN + owner->name() + "说道：对不起，我必须没收您的假卡。\n" NOR);
          write("由于你被发现使用假ＩＤ卡，所以银行冻结了你的帐户！\n");
          return 1;
        } else if (inv[i]->query("left_money") > price) {
          owner->compelete_trade(me, item, amount);
          inv[i]->add("left_money", -price);
          return 1;
        } else return notify_fail("你信用卡上的钱不够。\n");
      }
      if (me->query("next_trade_time") > time()) {
        write(CYN + owner->name() + "说道：您的银行帐户正在冻结状态，无法付帐。\n" NOR);
        return 1;
      }
      if (me->query("id_card") > price * amount) {
        me->add("id_card", -price * amount);
        inv[i]->set("left_money", me->query("id_card"));
        owner->compelete_trade(me, item, amount);
        return 1;
      } else return notify_fail("你信用卡上的钱不够。\n");
    }
  }
  return notify_fail("您的ＩＤ卡呢？\n");
}

int help(object me) {
  write(@HELP
指令格式: buy [<数目>] <某物> from <某人>

这一指令让你可以从某些人身上买到物品。
HELP
  );
  return 1;
}
