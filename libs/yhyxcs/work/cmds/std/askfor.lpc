#include <ansi.h>

inherit F_CLEAN_UP;

string *refuse_msg = ({
	"想从我这里索要东西吗？想得倒美！\n",
	"随随便便就向别人要东西，你不觉的害羞吗？\n",
	"从我这里要东西，你以为你是谁？别想了！\n",
	"对不起，太多人向我要过这样东西了！\n"
});

int complete_give(object me,object inv,string sth);

int main(object me, string arg)
{
	string sth, sb, msg;
	object ob, inv;

	seteuid(getuid());

	if( environment(me)->is_planet() || environment(me)->is_space_room() )
		return notify_fail("在外太空向别人索要东西好象不太行。\n");

	if( !arg || sscanf(arg, "%s from %s", sth, sb)!=2 )
		return notify_fail("你要向谁索要什麽东西？\n");

	if( !objectp(ob = present(sb, environment(me))) )
		return notify_fail("这里没有这个人。\n");

	if( !ob->is_character() )
	{
		message_vision("$N装疯卖傻似的对著$n说着什么。。。\n", me, ob);
		return 1;
	}
	message_vision("$N向$n索要『" + sth + "』。\n", me, ob);

	if( userp(ob) ) return 1;
	if( !living(ob) )
	{
		message_vision("但是很显然的，$n现在的状况没有办法给$N任何东西。\n", me, ob);
		return 1;
	}

	if( ob->query_space("vassalage") && ( ob->query_space("vassalage") != "中立" ) )
	{
		if( me->query_space("vassalage") != ob->query_space("vassalage") )
		{
			message_vision(CYN"$N说道：你我志向不同，我不会给你任何东西的。\n"NOR,ob);
			return 1;
		}
		if( (string)me->query("family/family_name") != (string)ob->query("family/family_name") )
		{
			message_vision(CYN"$N说道：你我虽然同为一方效力，但毕竟各事其主，请回吧。\n"NOR,ob);
			return 1;
		}

		if( (int)me->query("family/generation") >= (int)ob->query("family/generation") )
			return notify_fail(ob->name() + "的职位并不比你低！\n");
		if( me->query("rank") <= ob->query("rank") )
			return notify_fail(ob->name() + "的官阶并不比你低！\n");

		complete_give(me,ob,sth);
		return 1;
	}
	else
	{
		if( pointerp(ob->query("refuse")) )
			if( member_array( me, ob->query("refuse") ) != -1 )
			{
				message_vision(CYN"$N厌烦的说道：说过了不给，不要再烦我了。\n"NOR,ob);
				return 1;
			}
		ob->set("refuse",({ }));
		if( random( 20 - me->query_kar() ) )
		{
			ob->set("refuse",ob->query("refuse") + ({ me }));
			message_vision(CYN"$N说道：" + refuse_msg[random(sizeof(refuse_msg))] + NOR,ob);
			return 1;
		}
		if( random( 20 - me->query_per() ) )
		{
			ob->set("refuse",ob->query("refuse") + ({ me }));
			message_vision(CYN"$N说道：" + refuse_msg[random(sizeof(refuse_msg))] + NOR,ob);
			return 1;
		}
		complete_give(me,ob,sth);
		return 1;
	}
}

int complete_give(object me, object ob, string sth)
{
	object inv;

	if( !objectp(inv = present(sth, ob)) || inv->is_s_equip() )
	{
		message_vision(CYN"$N说道：真抱歉，我并没有『" + sth + "』这样东西。\n"NOR,ob);
		return 1;
	}
	if( inv->query("equipped") )
	{
		message_vision(CYN"$N说道：真抱歉，这样东西是我随身物品，不能给你。\n"NOR,ob);
		return 1;
	}
	if( inv->move(me) )
	{
		message_vision(CYN"$N把" + inv->name() + "交给了$n。\n"NOR,ob,me);
		return 1;
	}
	return 0;
}

int help(object me)
{
   write( @HELP
指令格式: askfor <something> from <somebody>

这个指令在完成TASK和QUEST时非常有用，如果是对方是军人，不仅是你的下级而且官阶比你低，
那么恭喜你，你可以向他索要任何东西了(当然不包括穿着和装备)。

如果对方并不是军人，那就要看你的运气和魅力够不够好了。
HELP
   );
   return 1;
}
