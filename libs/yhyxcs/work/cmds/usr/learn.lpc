// learn.c

#include <skill.h>

inherit F_CLEAN_UP;

string *reject_msg = ({
  "说道：您太客气了，这怎麽敢当？\n",
  "像是受宠若惊一样，说道：请教？这怎麽敢当？\n",
  "笑著说道：您见笑了，我这点雕虫小技怎够资格「指点」您什麽？\n",
});

void create() { seteuid(getuid()); }

int main(object me, string arg) {
  string skill, teacher, master, skill_file;
  object ob;
  int master_skill, my_skill, gin_cost;
  int exp, amount, is_s_skill = 0;
  mapping learned;

  if (environment(me)->is_space_room() || environment(me)->is_planet())
    return notify_fail("在外太空请教别人实在不太方便。\n");

  if (!arg || sscanf(arg, "%s from %s", skill, teacher) != 2)
    return notify_fail("指令格式：learn <技能> from <某人>\n");

  if (me->is_fighting())
    return notify_fail("临阵磨枪？好象有点晚。\n");

  if (!(ob = present(teacher, environment(me))) || !ob->is_character())
    return notify_fail("你要向谁请教？\n");

  if (!living(ob))
    return notify_fail("嗯。。。你得先把" + ob->name() + "弄醒再说。\n");

  if (!me->is_apprentice_of(ob)) {
    if ((string)me->query("family/family_name") != (string)ob->query("family/family_name")
      || (int)ob->query("family/privs") != -1) {
      notify_fail(ob->name() + reject_msg[random(sizeof(reject_msg))]);
      if (!(ob->recognize_apprentice(me))) return 0;
    }
  }

  if (!master_skill = ob->query_skill(skill, 1)) {
    if (!master_skill = ob->query_s_skill(skill, 1))
      return notify_fail("这项技能你恐怕必须找别人学了。\n");
    is_s_skill = 1;
  }

  if (!userp(ob) && !ob->accept_learn(me, skill))
    return notify_fail(ob->name() + "不愿意教你这项技能。\n");

  if (is_s_skill) {
    if (!S_SKILL_D(skill)->valid_learn(me))
      return notify_fail("依你目前的能力，没有办法学习这种技能。\n");
    my_skill = me->query_s_skill(skill, 1);
    skill_file = S_SKILL_D(skill);
    exp = me->query_space("combat_exp");
    learned = me->query_s_learned();
  } else {
    if (!SKILL_D(skill)->valid_learn(me))
      return notify_fail("依你目前的能力，没有办法学习这种技能。\n");
    my_skill = me->query_skill(skill, 1);
    skill_file = SKILL_D(skill);
    exp = me->query("combat_exp");
    learned = me->query_learned();
  }

  if (my_skill >= master_skill)
    return notify_fail("你这项技能的程度已经不亚于对方了。\n");

  gin_cost = 200 / (int)ob->query_int();

  if (!my_skill) {
    gin_cost *= 2;
    if (is_s_skill) me->set_s_skill(skill, 0);
    else me->set_skill(skill, 0);
  }

  //	if( (int)me->query("learned_points") >= (int)me->query("potential") )
  //		return notify_fail("你的潜能已经发挥到极限了，没有办法再成长了。\n");

  printf("你向%s请教有关「%s」的问题。\n", ob->name(), to_chinese(skill));

  if (ob->query("env/no_teach"))
    return notify_fail("但是" + ob->name() + "现在并不准备回答你的问题。\n");

  tell_object(ob, sprintf("%s向你请教有关「%s」的问题。\n",
    me->name(), to_chinese(skill)));

  if ((int)ob->query("sen") > gin_cost / 5 + 1) {
    if (userp(ob)) ob->receive_damage("sen", gin_cost / 5 + 1);
  } else {
    write("但是" + ob->name() + "显然太累了，没有办法教你什麽。\n");
    tell_object(ob, "但是你太累了，没有办法教" + me->name() + "。\n");
    return 1;
  }

  if ((int)me->query("gin") > gin_cost) {
    if ((my_skill > 25) && ((my_skill + 1) * (my_skill + 1) > learned[skill] * 4 / 5))
      printf("也许是缺乏足够的实战磨砺，你对%s的解答总是无法领会。\n", ob->name());
    else if (my_skill * my_skill * my_skill / 10 > exp) {
      printf("也许是缺乏实战经验，你对%s的解答总是无法领会。\n", ob->name());
    } else {
      amount = skill_file->learn_bonus() + me->query_int() * me->query_int() + to_int(sqrt(to_float(exp))) / 5;
      amount /= 50;
      if (amount < 1) amount = 1;
      printf("你听了%s的指导，似乎有些明白了。\n", ob->name());
      if (is_s_skill)
        me->improve_s_skill(skill, amount, 1);
      else me->improve_skill(skill, amount);
    }
  } else {
    gin_cost = me->query("gin");
    write("你今天太累了，结果什麽也没有学到。\n");
  }
  me->receive_damage("sen", gin_cost);

  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : learn <技能> from <某人>

这个指令可以让你向别人请教有关某一种技能的疑难问题，当然，你请教的对象在这
项技能上的造诣必须比你高，而你经由这种方式学习得来的技能也不可能高於你所请
教的人，然而因为这种学习方式相当於一种「经验的传承」，因此学习可以说是熟悉
一种新技能最快的方法。

通常，一个人刚学到一种新技能是不会有什麽疑难问题的，这勿庸置疑。但是，当对
某种技能的了解深入到了一定层次的时候，仅仅通过请教是无法达成效果的。所以，
适当的通过实际的操练来熟悉这项技能是解决这个矛盾的最基本方法。

作为一个优秀的上司，他不会刻板的教授知识，而是最有效的为那些在实战中拥有了
相当经验的下属做“点化”，也就是让请教者在“量”的积累上尽快的进行“质”的
飞跃。同样，对于一个下属，只有当他的技能锻炼到一定时候( 这项技能显示的名称
颜色由绿色变为紫色 )，才会去麻烦他的上司，否则不但无法领会任何知识，还会白
白的消耗自己宝贵的精力。

学习消耗的精力跟你自己悟性有关，而学习的效果则与你的悟性，实战经验，以及这
种技能的难易程度等等都有相当大的关系。

其他相关指令 : practice、study
HELP
  );
  return 1;
}
