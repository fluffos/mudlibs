#include <ansi.h>

inherit F_CLEAN_UP;

string *skill_level_desc = ({
  BLU "初学乍练" NOR,
  HIB "粗通皮毛" NOR,
  HIB "半生不熟" NOR,
  HIB "马马虎虎" NOR,
  HIB "驾轻就熟" NOR,
  CYN "出类拔萃" NOR,
  CYN "神乎其技" NOR,
  CYN "出神入化" NOR,
  HIC "登峰造极" NOR,
  HIC "一代宗师" NOR,
  HIW "深不可测" NOR
});

string *knowledge_level_desc = ({
  BLU "新学乍用" NOR,
  HIB "初窥门径" NOR,
  HIB "略知一二" NOR,
  HIB "马马虎虎" NOR,
  HIB "已有小成" NOR,
  CYN "心领神会" NOR,
  CYN "了然於胸" NOR,
  CYN "豁然贯通" NOR,
  HIC "举世无双" NOR,
  HIC "震古铄今" NOR,
  HIW "深不可测" NOR
});

string skill_level(string, int);

int main(object me, string arg) {
  object ob, *list, couple_ob;
  mapping skl, lrn, map, sskl;
  string *sname, *mapped, target, cardname;
  int i, marry_flag;

  seteuid(getuid());

  if (!arg)
    ob = me;
  else {
    ob = present(arg, environment(me));
    //        if ( ob->query("SPSKILLS",1)  ) return ob->skills();		 
    if (!ob) ob = find_player(arg);
    if (!ob) ob = find_living(arg);
    if (!ob) return notify_fail("你要察看谁的技能？\n");
  }

  marry_flag = 0;
  list = all_inventory(me);
  i = sizeof(list);
  while (i--) {
    if ((string)list[i]->query("id") == "marrycard") {
      cardname = list[i]->query("name");
      marry_flag = 1;
    }
  }
  if (marry_flag == 1) {
    if (sscanf(cardname, "你和%s的婚约", target) != 1)
      return notify_fail("你没有伴侣.\n");
    couple_ob = find_player(target);
  }

  if (ob != me && !wizardp(me) && !ob->is_apprentice_of(me)
    && !me->is_apprentice_of(ob) && ob != couple_ob)
    return notify_fail("只有巫师或有直系上司，嫡系下属关系的人能察看他人的技能。\n");

  sskl = ob->query_s_skills();
  skl = ob->query_skills();
  if (!sizeof(sskl) && !sizeof(skl)) {
    write((ob == me ? "你" : ob->name()) + "目前并没有学会任何技能。\n");
    return 1;
  }

  write((ob == me ? "你" : ob->name()) + "目前共学过" + chinese_number(sizeof(sskl) + sizeof(skl))
    + "种技能：\n\n");

  if (sizeof(sskl)) {
    sname = sort_array(keys(sskl), (: strcmp :));

    map = ob->query_s_skill_map();
    if (mapp(map)) mapped = values(map);
    if (!mapped) mapped = ({});

    lrn = ob->query_s_learned();
    if (!mapp(lrn)) lrn = ([]);

    if (wizardp(me)) {
      for (i = 0; i < sizeof(sskl); i++) {
        printf("%s" + HIG "%s%-12s%-33s" NOR "   - %-10s %3d/%5d\n",
          (member_array(sname[i], mapped) == -1 ? "  " : HIC "☆" NOR),
          (lrn[sname[i]] * 5 / 4 > (sskl[sname[i]] + 1) * (sskl[sname[i]] + 1)) ? HIM : "",
          to_chinese(sname[i]), " 〖" + sname[i] + "〗",
          skill_level(S_SKILL_D(sname[i])->type(), sskl[sname[i]]),
          sskl[sname[i]], lrn[sname[i]]);
      }
    } else for (i = 0; i < sizeof(sskl); i++) {
      printf("%s" + HIG "%s%-12s%-33s" NOR "   - %-10s %3d/  ???\n",
        (member_array(sname[i], mapped) == -1 ? "  " : HIC "☆" NOR),
        (lrn[sname[i]] * 5 / 4 > (sskl[sname[i]] + 1) * (sskl[sname[i]] + 1)) ? HIM : "",
        to_chinese(sname[i]), " 〖" + sname[i] + "〗",
        skill_level(S_SKILL_D(sname[i])->type(), sskl[sname[i]]),
        sskl[sname[i]]);
    }
  }

  if (!sizeof(skl)) {
    write("\n");
    return 1;
  }
  sname = sort_array(keys(skl), (: strcmp :));

  map = ob->query_skill_map();
  if (mapp(map)) mapped = values(map);
  if (!mapped) mapped = ({});

  lrn = ob->query_learned();
  if (!mapp(lrn)) lrn = ([]);

  if (wizardp(me)) {
    for (i = 0; i < sizeof(skl); i++) {
      printf("%s" + HIG "%s%-12s%-33s" NOR "   - %-10s %3d/%5d\n",
        (member_array(sname[i], mapped) == -1 ? "  " : HIC "☆" NOR),
        (lrn[sname[i]] * 5 / 4 > (skl[sname[i]] + 1) * (skl[sname[i]] + 1)) ? HIM : "",
        to_chinese(sname[i]), " 〖" + sname[i] + "〗",
        skill_level(SKILL_D(sname[i])->type(), skl[sname[i]]),
        skl[sname[i]], (int)lrn[sname[i]]);
    }
  } else for (i = 0; i < sizeof(skl); i++) {
    printf("%s" + HIG "%s%-12s%-33s" NOR "   - %-10s %3d/  ???\n",
      (member_array(sname[i], mapped) == -1 ? "  " : HIC "☆" NOR),
      (lrn[sname[i]] * 5 / 4 > (skl[sname[i]] + 1) * (skl[sname[i]] + 1)) ? HIM : "",
      to_chinese(sname[i]), " 〖" + sname[i] + "〗",
      skill_level(SKILL_D(sname[i])->type(), skl[sname[i]]),
      skl[sname[i]]);
  }
  write("\n");
  return 1;
}

string skill_level(string type, int level) {
  int grade;

  grade = level / 10;

  switch (type) {
    case "knowledge":
      if (grade >= sizeof(knowledge_level_desc))
        grade = sizeof(knowledge_level_desc) - 1;
      return knowledge_level_desc[grade];
    default:
      if (grade >= sizeof(skill_level_desc))
        grade = sizeof(skill_level_desc) - 1;
      return skill_level_desc[grade];
  }
}
