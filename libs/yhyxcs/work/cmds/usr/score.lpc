// score.c New Writen by Alarms 7/8/99

#include <ansi.h>
#include <combat.h>

inherit F_CLEAN_UP;

string display_attr(int gift, int value);
string display_rank(int rank, string vassalage);

void create() { seteuid(ROOT_UID); }

int main(object me, string arg) {
  object ob;
  mapping my, family;
  string line, title;

  seteuid(getuid(me));

  if (!arg) ob = me;
  else if (wizardp(me)) {
    ob = present(arg, environment(me));
    if (!ob) ob = find_player(arg);
    if (!ob) ob = find_living(arg);
    if (!ob) return notify_fail("你要察看谁的状态？\n");
  } else return notify_fail("玩家只能查看自己的状态。\n");

  my = ob->query_entire_dbase();

  line = sprintf("%s%s\n", RANK_D->query_rank(ob), ob->name(1));


  line += sprintf(" 你是一位%s岁的%s\n", chinese_number(my["age"]), my["gender"]);
  line += sprintf(" %s出生\n ",
    CHINESE_D->chinese_date(my["birthday"]));

  if ((title = ob->query("title")) && (title != "普通公民")) {
    line += sprintf("现任%s，", title);
    line += "官阶" + display_rank(ob->query("rank"), ob->query_space("vassalage"));
  }

  if (mapp(family = ob->query("family"))) {
    line += "\n 于" + CHINESE_D->chinese_date(family["enter_time"]) + "加入" + family["family_name"] + "效力";
    if (family["master_name"])
      line += "\n 你的直属上司是" + family["master_name"];
  }

  line += sprintf("\n\n 力量：[%s]  胆识：[%s]  才智：[%s]  统率：[%s]\n"
    " 沉着：[%s]  魅力：[%s]  体格：[%s]  运气：[%s]\n",
    display_attr(my["str"], ob->query_str()),
    display_attr(my["cor"], ob->query_cor()),
    display_attr(my["int"], ob->query_int()),
    display_attr(my["lea"], ob->query_lea()),
    display_attr(my["cps"], ob->query_cps()),
    display_attr(my["per"], ob->query_per()),
    display_attr(my["con"], ob->query_con()),
    display_attr(my["kar"], ob->query_kar()));

  line += sprintf("\n 至今为止，曾率领舰队取得胜绩%s次，尝得败绩%s次\n",
    chinese_number(ob->query_space("combat_win")), chinese_number(ob->query_space("combat_loss")));
  line += sprintf(" 胜利完成“银河使命榜”使命%s次\n\n",
    chinese_number(ob->query("TASK")));
  line += sprintf(
    " 参 数 点： " HIY "%d\n" NOR,
    ob->query("gift_points") - ob->query("used_gift_points")
  );
  line += sprintf(" 战    功： " HIC "%d\n" NOR, ob->query("score"));
  line += sprintf(" 实战经验： " HIY "%d\n\n" NOR, ob->query_space("combat_exp"));
  line += sprintf(" 格斗经验： " HIY "%d\n\n" NOR, ob->query("combat_exp"));

  write(line);
  return 1;
}

string display_attr(int gift, int value) {
  if (value > gift) return sprintf(HIY "%3d" NOR, value);
  else if (value < gift) return sprintf(CYN "%3d" NOR, value);
  else return sprintf("%3d", value);
}

string display_rank(int rank, string vassalage) {
  switch (rank) {
    case 0: return "列兵";
    case 1: return "准尉";
    case 2: return "少尉";
    case 3: return "中尉";
    case 4: return "上尉";
    case 5: return "少校";
    case 6: return "中校";
    case 7: return "上校";
    case 8: return "准将";
    case 9: return "少将";
    case 10: return "中将";
    case 11: return "上将";
    case 12:
      if (vassalage == "帝国")
        return "一级上将";
      else return "元帅";
    case 13:
      return "元帅";
    default: return "列兵";
  }
}

int help(object me) {
  write(@HELP
指令格式 : score
           score <对象名称>                   (巫师专用)

本指令用来显示你的基本状态。
HELP
  );
  return 1;
}
