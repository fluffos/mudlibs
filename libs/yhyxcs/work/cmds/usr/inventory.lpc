#include <ansi.h>

inherit F_CLEAN_UP;

string inventory_desc(object ob);
int main(object me, string arg) {
  int i, j;
  object *inv, ob;

  if (!arg) ob = me;
  else {
    ob = present(arg, environment(me));
    if (!ob) ob = find_player(arg);
    if (!ob) ob = find_living(arg);
    if (!ob) return notify_fail("你要察看谁身上携带的物品？\n");
    if (!wizardp(me) && !ob->accept_info(me, "hp"))
      return notify_fail("只有巫师能察看别人身上携带的物品。\n");
  }

  //	if( !ob ) ob = me;

  inv = all_inventory(ob);
  j = 0;
  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i]->is_s_equip()) j++;
  }

  if (!sizeof(inv) || (j == i)) {
    write((ob == me) ? "目前你身上没有任何东西。\n"
      : ob->name() + "身上没有携带任何东西。\n");
    return 1;
  }
  printf("%s身上带著下列这些东西(负重 %d%%)：\n", (ob == me) ? "你" : ob->name(),
    (int)ob->query_encumbrance() * 100 / (int)ob->query_max_encumbrance(), "\n");

  for (i = 0; i < sizeof(inv); i++) {
    if (!inv[i]->is_s_equip())
      printf("%s\n", inventory_desc(inv[i]), "\n");
  }

  /*
           j=0;
          for(i=0; i<sizeof(inv); i++) {
                 if(!inv[i]->is_s_equip()) j++;
                
        }

	if( !sizeof(inv) || (j==i) ) {
		write((ob==me)? "\n目前你舰船上没有任何东西。\n"
			: ob->name() + "舰船上没有携带任何东西。\n");
		return 1;
	}

printf("\n%s的舰船上带著下列这些装置\n",
		(ob==me)? "你": ob->name(),"\n");
            for(i=0; i<sizeof(inv); i++) {
                 if(inv[i]->is_s_equip()) 
                  printf("%s\n",inventory_desc(inv[i]),"\n");
                
        }
*/
  //	printf("\n");
  return 1;
}

string inventory_desc(object ob) {
  return sprintf("%s%s",
    ob->query("equipped") ? HIC "☆" NOR : "  ",
    ob->short()
  );
}

int help(object me) {
  write(@HELP
指令格式: inventory
 
可列出你目前身上所携带的所有物品。

注 : 此指令可以 " i " 代替。

HELP
  );
  return 1;
}
