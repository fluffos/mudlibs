#include <room.h>
#include <ansi.h>
#include <command.h>

inherit F_CLEAN_UP;
inherit F_S_ATTRIBUTE;
inherit F_DISTANCE;

int look_room(object me, object env);
int look_item(object me, object obj);
int look_living(object me, object obj);
int look_room_item(object me, string arg);
string per_status_msg(int per, string gender, string race);


//new writen
int look_planet(object me, object env);
int look_space_living(object me,object obj);
int look_space_room_item(object me, object obj);

string amount_of(int amount)
	{
	if ( amount < 100 ) return "不过百艘";
	if ( amount < 400 ) return "仅有几百艘";
	if ( amount < 700 ) return "约有数百艘";
	if ( amount < 1000 ) return "大概有近千艘";
	if ( amount <= 4000 ) return "超过千数";
	if ( amount <= 7000 ) return "有数千艘";
	if ( amount <= 10000 ) return "接近万艘";
	else return "难以计数";
	}

string morale_of(int morale)
	{
	if ( morale <= 20 ) return "极为溃乱的浮动在";
	if ( morale <= 40 ) return "散乱不堪的漂在";
	if ( morale <= 60 ) return "有些混乱的行进在";
	if ( morale <= 70 ) return "略显松散的集合在";
	if ( morale <= 85 ) return "整齐的排列在";
	if ( morale <= 100 ) return "极为整齐标准的列队于";
	}
//new writen end

void create() { seteuid(getuid()); }

int main(object me, string arg)
{
	object obj,env;
	int result;

	env = environment(me);
	if ( !arg )
		{
		if ( env->is_space_room() ) result = look_spaceroom(me,env);
		else if ( env->is_planet() ) result = look_planet(me,env);
		else result = look_room(me, env);
		}
/*	else if ( (obj = present(arg, me)) ||
			  (obj = present(arg, env)))
	{
		if ( obj->is_character() )
		if ( env->is_space_room() )
			result = look_space_living(obj);
		else
			result = look_living(me, obj);
		else
			result = look_item(me, obj);
	}
	else
		result = look_room_item(me, arg);
*/
	else if ( (obj = present(arg, me)) ) result = look_item(me, obj);
	else if ( (obj = present(arg, env) ) && !env->is_planet() && !env->is_space_room() )
		{
		if ( obj->is_character() ) result = look_living(me, obj);
		else result = look_item(me, obj);
		}
	else if ( (obj = present(arg, env) ) && env->is_space_room() )
		{
		if ( obj->is_character() ) result = look_space_living(me, obj);
		else result = look_space_room_item(me, obj);
		}
	else if ( (obj = present(arg, env) ) && env->is_planet() )
		{
		if ( obj->is_character() ) result = look_space_living(me, obj);
		else result = look_space_room_item(me, obj);
		}
	else if ( environment(env)
			&& (obj = present(arg, environment(env)) )
			&& env->is_planet() )
		{
		if ( obj->is_character() ) result = look_space_living(me, obj);
		else result = look_space_room_item(me, obj);
		}
	else result = look_room_item(me,arg);
/*
	else if ( (obj = present(arg, me)) ) result = look_item(me, obj);
	else if ( (obj = present(arg, env) ) && !env->is_space_room() )
		{
		if ( obj->is_character() ) result = look_living(me, obj);
		else result = look_room_item(me, arg);
		}
	else if ( (obj = present(arg, env) ) && env->is_space_room() )
		{
		if ( obj->is_character() ) result = look_space_living(me, obj);
		else result = look_space_room_item(me, obj);
		}
*/
	return result;
}

int look_room(object me, object env)
{
	int i;
	object *inv;
	mapping exits;
	string str, *dirs;

	if ( !env )
	{
		write("你的四周灰蒙蒙地一片，什么也没有。\n");
		return 1;
	}
	str = sprintf( "%s - %s %s\n    %s%s",
		env->query("short"),
		wizardp(me) ? file_name(env): "",
		wizardp(me) ? "("+env->query("coor/x")
			+","+env->query("coor/y")
			+","+env->query("coor/z")+")" : "",
		env->query("long"),
		env->query("outdoors") ? NATURE_D->outdoor_room_description() : "" );

	exits = env->query("exits");
	if ( mapp(exits) )
	{
		dirs = keys(exits);
		for ( i = 0; i < sizeof(dirs); i++ )
			if ( (int)env->query_door(dirs[i], "status") & DOOR_CLOSED )
				dirs[i] = 0;
		dirs -= ({ 0 });
		if ( sizeof(dirs) == 0 )
			str += "    这里没有任何明显的出路。\n";
		else if ( sizeof(dirs) == 1 )
			str += "    这里唯一的出口是 " + BOLD + dirs[0] + NOR + "。\n";
		else
			str += sprintf("    这里明显的出口是 " + BOLD + "%s" + NOR + " 和 " + BOLD + "%s" + NOR + "。\n",
				implode(dirs[0..sizeof(dirs)-2], "、"), dirs[sizeof(dirs)-1]);
	}
//	str += env->door_description();

	inv = all_inventory(env);
	for ( i = 0; i < sizeof(inv); i++ )
	{
		if (( inv[i] == me ) || ( !me->visible(inv[i]) ) || inv[i]->query("no_show") || inv[i]->is_s_equip() )
			continue;
		str += "    " + inv[i]->short() + "\n";
	}

	write(str);
	return 1;
}

int look_item(object me, object obj)
{
	mixed *inv;

	if( ( environment(me)->is_space_room() != obj->is_s_equip() )
		&& ( environment(me)->is_space_room() != obj->is_s_equip() ) )
		return 0;
	write(obj->long());
	inv = all_inventory(obj);
	if ( sizeof(inv) )
	{
		inv = map_array(inv, "inventory_look", this_object() );
		message("vision", sprintf("里面有：\n  %s\n",
			implode(inv, "\n  ") ), me);
	}
	return 1;
}

int look_living(object me, object obj)
{
	string str, limb_status, pro, gender;
	int age, per;
	mixed *inv;
	mapping my_fam, fam;

	if ( me != obj )
		message("vision", me->name() +
			"正目不转睛的凝视着你。\n", obj);

	str = obj->long();
	gender = obj->query( "gender" );
	pro = (obj == me) ? gender_self(gender) : gender_pronoun(gender);

	if ( (string)obj->query("race") == "人类" &&
		 intp(age = obj->query("age")) )
	{
		if( (age%10) < 6 )
			str += sprintf("%s看起来%s多岁", pro, chinese_number( age / 10 * 10 ) );
		else str += sprintf("%s看起来不到%s岁", pro, chinese_number( ( age/10 + 1 ) * 10 ) );
	}

	// If we both has family, check if we have any relations.
	if ( obj != me &&
		 mapp(fam = obj->query("family")) &&
		 mapp(my_fam = me->query("family")) &&
		 fam["family_name"] == my_fam["family_name"] )
	{
		if ( fam["generation"] == my_fam["generation"] )
			str += "，是你的同僚。\n";
		else if ( fam["generation"] < my_fam["generation"] )
		{
			if ( my_fam["master_id"] == obj->query("id") )
				str += "，是你的直属上司。\n";
			else
				str += "，是你的上级。\n";
		}
		else
		{
			if ( fam["master_id"] == me->query("id") )
				str += "，是你的直系下属。\n";
			else
				str += "，是你的下级。\n";
		}
	}
	else str += "。\n";

	per = obj->query_per();
	if ((string) obj->query("gender") == "男性")
	{
		if ((per >= 20) && (per <=30)) 
			str += pro + "英俊潇洒，相当有魅力。\n";
		else if ((per >= 15) && (per < 20)) 
			str += pro + "面目俊朗，举止得体。\n";
		else if ((per >= 10) && (per < 15))
			str += pro + "五官端正，气质颇佳。\n";
		else if ((per >= 5) && (per < 10))
			str += "相貌一般，普普通通。\n";
		else if (per < 5) 
			str += pro + "看上去并不怎么让人喜欢。\n";
		else str += pro + "相貌极为出众，堪称完美。\n";
	}
	else if  ((string) obj->query("gender") == "女性")
	{
		if ((per >= 20) && (per <= 30)) 
			str += pro + "有沉鱼落雁之容,避月羞花之貌！\n";
		else if ((per >= 15) && (per < 20)) 
			str += pro + "风情万种,楚楚动人！\n"; 
		else if ((per >= 10) && (per < 15))
			str += pro + "长得还算颇有几分姿色。\n";
		else if ((per >= 5) && (per < 10))
			str += pro + "相貌平平,还看得过去。\n";
		else if (per < 5) 
			str += pro + "的相貌嘛...马马虎虎吧。\n";
		else str += pro + "美奂绝伦,堪称人间仙子！\n";
	}

	if ( obj->query("max_kee") )
	{
		int eff_kee, max_kee;
		eff_kee = obj->query( "eff_kee" );
		max_kee = obj->query( "max_kee" );
		str += pro + COMBAT_D->eff_status_msg(eff_kee * 100 / max_kee) + "\n";
	}
//    str += pro + per_status_msg((int)obj->query("per"),
//               		obj->query("gender"), obj->query("race"));

	inv = all_inventory(obj);
	if ( sizeof(inv) )
	{
		inv = map_array(inv, "inventory_look", this_object(),
				obj->is_corpse() ? 0 : 1 );
		inv -= ({ 0 });
		if ( sizeof(inv) )
			str += sprintf( obj->is_corpse() ?
						"%s的遗物有：\n%s\n" : "%s身上带著：\n%s\n",
						pro, implode(inv, "\n") );
	}

	message("vision", str, me);
/*
	if ( obj != me &&
		 living(obj) &&
		 random((int)obj->query("bellicosity")/10) > (int)me->query("per") )
	{
		write( obj->name() + "突然转过头来瞪你一眼。\n");
		COMBAT_D->auto_fight(obj, me, "berserk");
	}
*/
	return 1;
}

string inventory_look(object obj, int flag)
{
	string str;

	if( obj->is_s_equip() ) return 0;

	str = obj->short();
	if( obj->query("equipped") )
		str = HIC "  ☆" NOR + str;
	else if ( !flag )
		str = "    " + str;
	else
		return 0;

	return str;
}

int look_room_item(object me, string arg)
{
	object env;
	mapping item, exits;

	if ( !objectp(env = environment(me)) )
		return notify_fail("这里只有灰蒙蒙地一片，什么也没有。\n");

	item = env->query("item_desc");
	if ( mapp(item) && !undefinedp(item[arg]) )
	{
		if ( stringp(item[arg]) )
			write(item[arg]);
		else if ( functionp(item[arg]) )
			write((string)(*item[arg])(me));
			
		return 1;
	}
	exits = env->query("exits");
	if ( mapp(exits) && !undefinedp(exits[arg]) )
	{
		if ( objectp(env = find_object(exits[arg])) )
			look_room(me, env);
		else
		{
			call_other(exits[arg], "???");
			look_room(me, find_object(exits[arg]));
		}
		return 1;
	}
	// Look specific object in the room
	if ( arg )
	{
		string detail;
		detail = env->query( "detail/" + arg );
		if ( detail )	
		{
			write( detail );
			return 1;
		}
		if ( strsrch( env->query( "long" ), arg ) >= 0 )
			return notify_fail("你看不出这里的" + arg + "有什么特别之处\n");
	}
	return notify_fail("你要看什么？\n");
}


//new writen

int look_planet(object me, object env)
{
	int i,check,counter=0;
	object *inv;
	string str,result="";

	if ( !env )
	{
		write("你的四周灰蒙蒙地一片，什么也没有。\n");
		return 1;
	}
	str = sprintf( "%s - %s \n    %s",
		( "    这里是" + env->query("name") + "的行星轨道" ),
		wizardp(me) ? file_name(env): "",
		env->query("long"));

	inv = all_inventory(env);
	str += "根据侦察舰艇的报告，在行星轨道上";

	for ( i = 0; i < sizeof(inv); i++ )
	{
		check = calculate_distance(me,inv[i],me->query_space("scouting"));
		if ( check == -1 ) continue;
		if (( inv[i] == me )
			|| inv[i]->query("no_show")
			|| ( !check ) )
//			|| ( !me->visible(inv[i]) ) )
			continue;
		result += "    " + inv[i]->space_short_inroom() + "\n";
		counter += 1;
	}
	if( counter < 1 ) str += "什么也没有。\n";
	else str += "可以见到：\n";

	write( (str+result) );

	counter = 0;
	str = "在行星附近";
	result = "";
	inv = all_inventory(environment(env));
	for ( i = 0; i < sizeof(inv); i++ )
	{
		check = calculate_distance(env,inv[i],me->query_space("scouting"));
		if ( check == -1 ) continue;
		if (( inv[i] == env )
			|| inv[i]->query("no_show")
			|| ( !check ) )
//			|| ( !me->visible(inv[i]) ) )
			continue;
		result += "    " + inv[i]->space_short_inroom() + "\n";
		counter += 1;
	}
	if( counter < 1 ) str += "什么也没有。\n";
	else str += "可以见到：\n";

	write( (str+result) );
	return 1;
}

int look_space_living(object me,object obj)
{
	string str,formation;

	if ( !calculate_distance(me,obj,me->query_space("scouting")) )
		return notify_fail("你要看什么？\n");

	str = "";
	if( me == obj ) str = "\n我军";
	else POSITION_CMD->main(me,obj->query("id"));

	str += "舰只数量" + amount_of( F_S_ATTRIBUTE->query_eff_amount(obj) ) + "，呈";

	if( formation = obj->query_s_skill_mapped("formation") )
		str += to_chinese(formation);
	else str += "三角阵";

	str += "排列。\n";
	str += "攻击范围还没有做。";
	if( obj->is_combating() ) str += "战斗状态中。\n";
	else if( obj->query_space_temp("times") ) str += "行进状态中。\n";
	else str +="待命状态中。\n";

	write(str);
	return 1;
}

int look_space_room_item(object me, object obj)
{
	object env;
	mixed *inv;
	int i;
	string prep;

	if ( !objectp(env = environment(me)) )
		return notify_fail("这里只有灰蒙蒙地一片，什么也没有。\n");
	if ( !calculate_distance(me,obj,me->query_space("scouting")) )
		return notify_fail("你要看什么？\n");
	write( "    " + obj->long() );
	inv = all_inventory(obj);
	if( sizeof(inv) )
		{
		switch( obj->is_planet() )
			{
			case 1:
				prep = "轨道上";
				break;
			default:
				prep = "里面";
				break;
                        }
		for(i=0;i<sizeof(inv);i++)
			{
			if (( inv[i] == me )
				|| inv[i]->query("no_show") )
//				|| ( !me->visible(inv[i]) ))
				continue;
			if ( inv[i]->is_character() )
			inv[i] =  "    " + (string)inv[i]->space_short_inroom();
			else inv[i] =  "    " + (string)inv[i]->short();
			}
		message("vision", sprintf("%s有：\n  %s\n", prep,
			implode(inv, "\n  ") ), me);
		}
	return 1;
}



