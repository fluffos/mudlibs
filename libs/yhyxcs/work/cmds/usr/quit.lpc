// quit.c

#include <command.h>

inherit F_DBASE;
inherit F_CLEAN_UP;

void create() {
  seteuid(getuid());
  set("name", "离线指令");
  set("id", "quit");
}

int main(object me, string arg) {
  int i;
  object *inv, link_ob, ob;

  if (!wizardp(me) || !arg) ob = me;
  else {
    ob = present(arg, environment(me));
    if (!userp(ob))
      return notify_fail("你想把谁踢出系统？\n");
  }
  //	if( ob->is_busy() ) {
  //		ob->interrupt_me(ob, "halt");
  //		write("Ok.\n");
  //		return 1;
  //	}

  if (!wizardp(ob)) {
    inv = all_inventory(ob);
    for (i = 0; i < sizeof(inv); i++)
      if (!inv[i]->query_autoload())
        DROP_CMD->do_drop(ob, inv[i]);
  }

  link_ob = ob->query_temp("link_ob");

  // We might be called on a link_dead player, so check this.
  if (link_ob) {

    // Are we possessing in others body ?
    if (link_ob->is_character()) {
      write("你的魂魄回到" + link_ob->name(1) + "的身上。\n");
      exec(link_ob, ob);
      link_ob->setup();
      return 1;
    }

    link_ob->set("last_on", time());
    link_ob->set("last_from", query_ip_name(ob));
    link_ob->save();
    destruct(link_ob);
  }
  if (me == ob) write("欢迎下次再来！\n");
  else write("系统告诉你：反醒一下吧，巫师对使这条指令总是很慎重的。\n我想他不会冤枉你的！\n");
  message("system", ob->name() + "离开游戏。\n", environment(ob), ob);

  CHANNEL_D->do_channel(this_object(), "sys",
    ob->name() + "离开游戏了。");
  ob->delete("channel_id");
  ob->save();
  destruct(ob);

  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : quit

当你想暂时离开时, 可利用此一指令。
HELP
  );
  return 1;
}
