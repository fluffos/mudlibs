#include <ansi.h>

int main(object me, string str) {
  string output;

  seteuid(getuid());
  me->add("sen", -5);
  output = HIR "◎ 银河使命榜 ◎\n" NOR;
  output += "———————————————————————————\n";
  output += TASK_D->dyn_task_list();
  output += "———————————————————————————\n\n";

  me->start_more(output);
  return 1;
}

int help(object me) {
  write(@HELP
指令格式: tasks

这个指令是用来得知目前的所有使命.

HELP
  );
  return 1;
}
