//Cargo.c   Writen by Alarms 4/4/99

#include <ansi.h>

inherit F_CLEAN_UP;
inherit F_S_ATTRIBUTE;

int main(object me, string arg) {
  mapping in_cargo;
  string *name;
  int i, *amount;

  if (!arg) me = me;
  else if (wizardp(me))
    me = present(arg, environment(me));
  else return notify_fail("玩家不能查看别人的货物装载情况。\n");
  if (!mapp(in_cargo = me->query_space("in_cargo")))
    return notify_fail(me->space_short() + "没有装载任何货物。\n");

  name = keys(in_cargo);
  amount = values(in_cargo);
  printf(me->space_short() + "装载着以下的的货物 %d%%\n", query_cargo(me) * 100 / query_max_cargo(me));
  for (i = 0; i < sizeof(in_cargo); i++) {
    printf("  %-10s : %6d \n", name[i], amount[i]);
  }
  return 1;
}

int help(object me) {
  write(@HELP
指令格式：
	cargo
	cargo <对象名称>    巫师专用
 
这个指令让你查看舰队货物装载情况。
 
HELP
  );
  return 1;
}
