// shp.c Writen by Alarms 7/8/99
 
#include <ansi.h>
#include <combat.h>
 
inherit F_CLEAN_UP;
inherit F_S_ATTRIBUTE;
 
string status_color(int current, int max);
 
int main(object me, string arg)
{
	object ob;
	mapping my,fleet,formation;
        string list="";
        int i;
 
	seteuid(getuid(me));
 
	seteuid(getuid(me));

	if(!arg) ob = me;
	else
		{
		ob = present(arg, environment(me));
		if (!ob) ob = find_player(arg);
		if (!ob) ob = find_living(arg);
		if (!ob) return notify_fail("你要察看谁的状态？\n");
		if (!wizardp(me) && !ob->accept_info(me, "hp"))
			return notify_fail("只有巫师能察看别人的状态。\n");
		}

	my = ob->query_entire_space_dbase();

	list += sprintf("  舰队名称    舰队类型    武器装备    舰只数量    舰队士气    能源储量\n");

	for( i=0;i<sizeof(my["sub_fleet"]);i++ )
		{
		fleet = query_usage_fleet(ob,i);
		list += sprintf( HIW" *%-10s  %-10s  %-10s " NOR "%s%4d/%4d  " HIC " %s%4d/ 100 " HIC "  %8d\n" NOR,
				fleet["name"],fleet["shiptype"],fleet["attacktype"],
				status_color(fleet["eff_amt"],fleet["max_amt"]),
				fleet["eff_amt"],fleet["max_amt"],
				status_color(fleet["morale"],100),
				fleet["morale"],
				fleet["energy"]);
		}
	list += sprintf("\n  舰队速度：    %6d    舰队总数：    %6d",
			query_eff_spd(ob),query_eff_amount(ob));
	list += sprintf("\n  侦察范围：    %6d    作战经验：    %6d",
			my["scouting"],my["combat_exp"]);

	if( formation = ob->query_s_skill_mapped("formation") )
	list += sprintf("\n  舰队归属：%10s    舰队阵型：%10s\n",
			my["vassalage"],to_chinese(formation) );
	else
	list += sprintf("\n  舰队归属：%10s    舰队阵型：%10s\n",
			my["vassalage"],"三角阵" );
	
	write(list);

 	return 1;
}
 
string status_color(int current, int max)
{
	int percent;
 
	if( max>0 ) percent = current * 100 / max;
	else percent = 100;
	if( percent > 100 ) return HIC;
	if( percent >= 90 ) return HIG;
	if( percent >= 60 ) return HIY;
	if( percent >= 30 ) return YEL;
	if( percent >= 10 ) return HIR;
	return RED;
}
 
int help(object me)
{
	write(@HELP
指令格式 : hp
           hp <对象名称>                   (巫师专用)
 
这个指令可以显示你(□)或指定对象(含怪物)的精神, 生命, 体能数值。
 
see also : score
HELP
    );
    return 1;
}
