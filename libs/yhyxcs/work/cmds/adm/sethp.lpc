void create() { seteuid(getuid()); }

int main(object me, string arg) {
  string key;
  int chinz;

  if (!arg || arg == "")
    return notify_fail("指令格式：sethp arg1==arg2\n");
  seteuid(geteuid(me));
  if (sscanf(arg, "%s==%d", key, chinz) == 2) {
    me->set(key, chinz);
    return 1;
  }
  return notify_fail("指令格式：sethp arg1==arg2\n");
}
