// fly

inherit F_CLEAN_UP;

void create() { seteuid(getuid()); }

int main(object me, string dest)
{
    object obj;

    if( !dest ) return notify_fail("你要往去那里？\n");

//	if( me->is_busy() )
//		return notify_fail("要移动请你先用 halt 终止你正在做的事。\n");

	if( !(obj = find_object(dest)) )
        catch(call_other(dest,"???"));
	if( !(obj = find_object(dest)) )
		return notify_fail("无法移动。\n");

	if( me->move(obj) ) {
		me->remove_all_enemy();
		me->set_temp("pending", 0);
		return 1;
	}
	return 0;
}
