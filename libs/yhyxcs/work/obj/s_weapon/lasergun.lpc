#include <s_weapon.h>
#include <ansi.h>

inherit LASERGUN;

void create() {
  set_name("磁力炮", ({ "lasergun" }));
  set("long", "磁力炮。\n");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
  }
  //int damage, int cost, int attack
  init_lasergun(3, 1, 2);
  set("tech_msg", "你将舰队的主炮按照磁力炮的技术改进了！\n");
  set("untech_msg", "你将舰队的主炮恢复成为原来的样子。\n");
  setup();
}
