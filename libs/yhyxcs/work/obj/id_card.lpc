#include <ansi.h>

inherit ITEM;

void geton_taxi(string arg,object me,string *dest,int *price);
void complete_geton(object me,string dest);
int hire_taxi();

void create()
{
	set_name("ＩＤ卡", ({ "card","id_card" }) );
	set("long","一张制作精致的ＩＤ卡，上面的镭射条码记录着姓名，以及使用者的\n"
			"身体特征，科技程度之高让人几乎无法仿制。右上角银色的费沙徽标\n"
			"则是它通用性的最好证明。\n");
	set_weight(200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "张");
	}
	setup();
}

void init()
{
        add_action("hire_taxi", "taxi");
}

int hire_taxi()
{
	object who, env;
	mapping taxi;
	string *dest,*index;
	string result;
	int *price;
	int i;

	who = this_player();
	if( who != environment(this_object()) )
		return 0;
	if( !who->is_character() )
		return 0;

	if( !objectp( env = environment(who) ) )
		return 0;
	if( env->is_space_room() || env->is_planet() )
		return 0;
	taxi = env->query("taxi");
	if( !mapp(taxi) )
	{
		write("现在这里恐怕没有办法雇到地上车。\n");
		return 1;
	}
	message_vision(CYN"$N站在路边，将手中的ＩＤ卡轻轻的挥了一下。\n\n"NOR,who);
	message_vision("一辆地上车缓缓的停在了$N的身旁。\n\n",who);

	dest = keys(taxi);
	price = values(taxi);
	result = CYN"车内电脑屏幕显示：您可以乘坐本车到达：\n"NOR;
	for(i=0;i<sizeof(dest);i++)
	{
		result += " " + (string)i + " -- " + dest[i]->query("short") + "(" + (string)price[i] + "费沙马克)\n";
	}
	write(result);
	write("请问您要去哪里？(退出按Q)");
	input_to("geton_taxi",who,dest,price);
	return 1;
}

void geton_taxi(string arg,object me,string *dest,int *price)
{
	object taxi, *inv;
	int which, size, i;
	string quit;

	sscanf(arg,"%s",quit);
	if( ( quit == "Q" ) || ( quit == "q" ) )
	{
		write("那么真是很遗憾啊。\n");
		return;
	}
	if( sscanf(arg,"%d",which) != 1 )
	{
		write("请问您要去哪里？\n");
		input_to("geton_taxi",me,dest);
		return;
	}
	size = sizeof(dest);
	if( ( which > size ) || ( which < 0 ) )
	{
		write("请问您要去哪里？\n");
		input_to("geton_taxi",me,dest);
		return;
	}
	inv = all_inventory(me);
	for(i=0;i<sizeof(inv);i++)
	{
		if( inv[i]->name() == "ＩＤ卡" )
		{
			if( !inv[i]->query("owner_name") && !inv[i]->query("owner_id") )
			{
				write(CYN + "车内电脑屏幕显示：ＩＤ卡识别错误，无法付款。\n"NOR);
				return;
			}
			if( inv[i]->query("owner_name") != me->name() )
			{
				write(CYN + "车内电脑屏幕显示：ＩＤ卡记录的信息与持有者不符，无法付款。\n"NOR);
				return;
			}
			if( inv[i]->query("owner_id") != me->query("id") )
			{
				if( random(25-me->query_kar()) )
				{
					me->set("next_trade_time", time()+ 3600 );
					destruct(inv[i]);
					write(CYN + "车内电脑屏幕显示：ＩＤ卡识别错误，必须没收假卡。\n"NOR);
					write("由于你被发现使用假ＩＤ卡，所以银行冻结了你的帐户！\n");
					return;
				}
				else if( inv[i]->query("left_money") > price[which] )
				{
					complete_geton(me, dest[which]);
					inv[i]->add("left_money", -price[which]);
					return;
				}
				else
				{
					write(CYN"车内电脑屏幕显示：ＩＤ卡余额不足。\n");
					return;
				}
			}
			if( me->query("next_trade_time") > time() )
			{
				write(CYN"车内电脑屏幕显示：ＩＤ卡持有者银行帐户冻结状态中，无法付款。\n"NOR);
				return;
			}
			if( me->query("id_card") > price[which] )
			{
				complete_geton(me, dest[which]);
				me->add("id_card", -price[which] );
				inv[i]->add("left_money", -price[which] );
				return;
			}
			else
			{
				write(CYN"车内电脑屏幕显示：ＩＤ卡余额不足。\n"NOR);
				return;
			}
		}
	}
	write(CYN"车内电脑屏幕显示：请出示您的ＩＤ卡。\n"NOR);
	return;
}

void complete_geton(object me,string dest)
{
	object taxi;

	if( objectp( taxi = new("/std/room/taxi") ) )
	{
		taxi->set("globe",environment(me)->query("globe"));
		taxi->set("exits/out",file_name(environment(me)));
		taxi->set("dest",dest);
		message_vision(CYN"$N一弯腰，钻进了一辆停在路旁的地上车。\n\n"NOR,me);
		me->move(taxi);
	}
}
