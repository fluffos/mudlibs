#include <weapon.h>

inherit AMMO;

void create()
{
	set_name("能源弹夹", ({ "energy ammo","ammo" }) );
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long","这是最普通的能源弹夹。\n");
		set("unit", "些");
		set("base_unit", "只");
		set("base_weight", 200);
		set("value", 100);
	}
	set_amount(1);

//init_ammo(装弹量，[弹药类型]，[装备情况]);
	init_ammo(7,"能源");
	setup();
}
