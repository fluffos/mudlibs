#include <weapon.h>

inherit GUN;

void create()
{
	set_name("手枪", ({ "gun","pistol" }) );
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long", "这是一把看起相当普通的手枪。\n");
                set("value", 300);
                set("material", "steel");
        }
//init_gun(伤害力，装弹量，[类形]，[装备情况(单手还是双手)])
        init_gun(50,7);

        set("wield_msg", "$N掏出一把$n握在手中。\n");
        set("unwield_msg", "$N将$n放入衣服的内兜里。\n");

        setup();
}
