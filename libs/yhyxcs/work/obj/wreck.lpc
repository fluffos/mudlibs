// wreck.c  Writen by Alarms 5/3/99

inherit ITEM;

int decayed;
int is_container() { return 1; }
int is_wreck() { return decayed < 2; }

void create()
{
        set_name("残骸", ({ "wreck" }) );
        set("long", "一堆散布在宇宙空间中不知名的残骸。\n");
        set("unit", "片" );
        decayed = 0;
        if( clonep(this_object()) ) call_out("decay", 120, 1);
}

void decay(int phase)
{
	decayed = phase;
	switch(phase)
	{
		case 1:
//		say( query("name") + "被太阳风渐渐的吹散了。\n" );
		set_name("不知名的残骸", ({ "wreck" }) );
		set("long", "一堆散布在宇宙空间中不知名的残骸。\n");
		call_out("decay", 120, phase + 1);
		break;

		case 2:
//		say( query("name") + "分散着向周围的小天体飘去。\n" );
		set_name("太空垃圾", ({ "dust" }) );
		set("long", "一堆散布在宇宙空间中的太空垃圾。\n");
		call_out("decay", 60, phase + 1);
		break;

		case 3:
//		say( query("name") + "终于全部消失在无尽的宇宙空间中。\n" );
		if( environment() )
			{
			object *inv;
			int i;
			inv = all_inventory(this_object());
			for(i=0; i<sizeof(inv); i++)
			destruct(inv[i]);
//			inv[i]->move(environment());
			}
		destruct(this_object());
		break;
	}
}
