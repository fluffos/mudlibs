#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "冬馆大厅");
        set("long", @LONG
大厅内阳光自半透明的天顶照亮这里的每个角落，稀有植物、晶
莹发亮的大理石地板、还有不知从何处穿来的美妙的古典音乐。大厅
正对装饰气派的楼梯连接着二楼的悬廊。
LONG
	);

	set("globe","phezzan");

	set("exits", ([
		"northup" : __DIR__"winter_parlor",
		"south" : __DIR__"winter_garden",
	]));


	set("coor/x",-50);
	set("coor/y",70);
	set("coor/z",0);

	setup();
}
