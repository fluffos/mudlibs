#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "情报采集室");
	set("long", @LONG
若是在同盟或帝国，这里一定会被称作情报作战室吧？TV电话、
超长波通讯机、传信器和作战电脑遍布其间。费沙小姐独有韵味的
嗓音合成了极富旋律的乐章,此起彼伏。
LONG	
	);

	set("globe","phezzan");

	set("item_desc", ([
		"TV电话":"一台普通的TV电话。\n",
		"phone":"一台普通的TV电话。\n",
		"telephone":"一台普通的TV电话。\n",
		"超长波通讯机":"一台普通的超长波通讯机。\n",
		"通讯机":"一台普通的超长波通讯机。\n",
		"tongxunji":"一台普通的超长波通讯机。\n",
		"传信器":"一台普通的传信器。\n",
		"chuanxinqi":"一台普通的传信器。\n",
	]) );

	set("exits", ([
		"west" : __DIR__"maingov_hall",
	]));

	set("objects", ([
		__DIR__"npc/enlistee" : 1,
		__DIR__"obj/computer_p" : 1,
	]) );

	set("coor/x",10);
	set("coor/y",130);
	set("coor/z",0);

	setup();
}

void reset()
{
	object *inv;
	object con, item;

	::reset();
	con = present("computer", this_object());
        inv = all_inventory(con);
        if( !sizeof(inv) && !random(10) )
	{
		item = new(__DIR__"obj/disk");
		item->move(con);
	}
}

