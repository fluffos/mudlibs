#include <ansi.h>

inherit ROOM;

void create() {
  set("short", GRN "西费沙大道" NOR);
  set("long", @LONG
费沙人勤劳、智慧。行星费沙能有今天这样一派自由、和平、繁
荣的景象，西费沙大道的这一街区路南是费沙医科大学附属医院，北
面是就是自由行星同盟的驻在武官官邸。
LONG
  );

  set("globe", "phezzan");

  set("exits", ([
    "east": __DIR__ "wstreet1",
    "south": __DIR__ "hospital",
    "west": __DIR__ "wstreet3",
    "north": __DIR__ "alliance_embassy",
  ]));

  set("coor/x", -60);
  set("coor/y", 0);
  set("coor/z", 0);

  set("walk_bonus", 5);

  setup();
}
