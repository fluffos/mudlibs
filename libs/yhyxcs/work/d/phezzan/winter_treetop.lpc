//Modified by xyc
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "大树顶端");
  set("long", @LONG
尽管树的主干有一抱多粗，可是到了顶端却只有碗口粗细。脆弱
的树枝不停地左右摇摆，时不时发出的“吱喀”、“喀嚓”的响声……
LONG
  );

  set("exits", ([
    "down": __DIR__ "winter_tree",
  ]));

  set("coor/x", -30);
  set("coor/y", 90);
  set("coor/z", 20);

  set("globe", "phezzan");
  setup();
}


void init() {
  add_action("do_jump", "jump");
}

int do_jump(string arg) {
  object me, room;

  if (!arg) {
    write("你要向哪个方向跳？\n");
    return 1;
  }

  if ((arg != "east") && (arg != "west") && (arg != "south") && (arg != "north")) {
    write("你要向哪个方向跳？\n");
    return 1;
  }

  me = this_player();
  message_vision("$N用尽力气，向" + to_chinese(arg) + "跳去！\n", me);

  if (arg == "west") {
    if (!random(25 - me->query_kar())) {
      room = load_object(__DIR__ "winter_library");
      if (room) {
        me->move(room);
        message_vision("只听窗户的玻璃“咔喳”一声脆响，$N从冬青树的枝头跳到了屋子里！\n", me);
        return 1;
      }
    }
  }
  room = load_object(__DIR__ "winter_tree");

  if (room) {
    me->move(room);
    message_vision("只听$N一声怪叫，从冬青树树顶径直跌了下来。\n", me);
    me->unconcious();
    return 1;
  }
}
