//Modified by xyc
#include <ansi.h>

inherit ROOM;

void relock_door();

void create() {
  set("short", "领主副官办公室");
  set("long", @LONG
简朴的办公室内，一切都在高效、有序地进行着。南边是线条简
练的木制装饰，而东西两面墙上则挂有不少图表和表格。这就是费沙
人引以为荣的勤勉办事官的办公地。
LONG
  );

  set("globe", "phezzan");

  set("item_desc/", ([
    "墙": "北面墙的颜色与周围多少有些不同，好象是个电子门。\n",
    "北墙": "北面墙的颜色与周围多少有些不同，好象是个电子门。\n",
    "北面的墙": "北面墙的颜色与周围多少有些不同，好象是个电子门。\n",
    "wall": "北面墙的颜色与周围多少有些不同，好象是个电子门。\n",
    "north wall": "北面墙的颜色与周围多少有些不同，好象是个电子门。\n",
    "电子门": "一个相当隐秘的电子门，上面有两个钥匙孔。\n",
  ]));

  set("exits", ([
    "south": __DIR__ "passage1",
    "north": __DIR__ "maingov_aisle",
  ]));

  seteuid(getuid());

  create_door("north", "电子门", "", 1);

  set("item_desc/north", "你要看什么？\n");

  set("objects", ([
    __DIR__ "npc/fuguan": 1,
  ]));

  set("coor/x", 0);
  set("coor/y", 160);
  set("coor/z", 0);

  setup();
}

void init() {
  load_object(__DIR__ "maingov_aisle");
  add_action("do_unlock", "unlock");
}

int do_unlock(string arg) {
  object key1, key2, me, ob, room;

  if (!arg) return 0;

  me = this_player();
  if (!objectp(key1 = present("key1", me)))
    return 0;
  if (!objectp(key2 = present("key2", me)))
    return 0;

  if ((arg != "电子门") && (arg != "door") && (arg != "门"))
    return 0;

  message_vision("$N将两把电子钥匙分别插到电子门的相两个锁孔里。\n", me);
  if (objectp(ob = present("fuguan", this_object()))) {
    message_vision(HIR "结果$N发现了$n的企图，迅速的按响了警铃！\n" NOR, ob, me);
    tell_object(me, "两把钥匙都被电子门吸了进去！\n");
    destruct(key1);
    destruct(key2);
    return 1;
  }
  message("vision", "随着电子钥匙轻轻的旋动，北墙上隐秘的电子门锁解除了！\n", this_object());
  room = load_object(query("exits/north"));
  delete_door("north");
  create_door("north", "电子门", "south", 1);
  room->delete_door("south");
  room->create_door("south", "电子门", "north", 1);

  //write(sprintf("%O\n",this_object()->query_doors()));
  //write(sprintf("%O\n",room->query_doors()));
  call_out("relock_door", 5);
  return 1;
}

void relock_door() {
  object room;

  message("vision", "电子门锁发出“嘀”“嘀”的响声，重新恢复了锁定状态。\n", this_object());

  room = load_object(query("exits/north"));
  room->delete_door("south");
  delete_door("north");
  room->create_door("south", "电子门", "", 1);
  create_door("north", "电子门", "", 1);

  //write(sprintf("%O\n",this_object()->query_doors()));
  //write(sprintf("%O\n",room->query_doors()));
  set("item_desc/north", "你要看什么？\n");
}

int valid_leave(object me, string dir) {

  if (userp(me)) {
    if (dir == "north" && query_door("north", "status"))
      return notify_fail("这个方向没有出路。\n");
    return 1;
  }
  return 1;
}
