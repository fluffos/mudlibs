//Modified by xyc
#include <ansi.h>

inherit ROOM;

void relock_door();

void create()
{
	set("short","走廊");
	set("long", @LONG
一条狭小、阴暗的走廊。寂静之中只有你自己的脚步声．．．．
LONG
	);
	set("globe","phezzan");

	set("exits", ([
		"south" : __DIR__"fuguan_office",
		"north" : __DIR__"lord_office",
	]));

	create_door("south","电子门","",1);

	set("coor/x",0);
	set("coor/y",170);
	set("coor/z",0);

	setup();
}

void init()
{
	add_action("do_unlock","unlock");
}

int do_unlock(string arg)
{
	object key1, key2, me, ob, room;

	if( !arg ) return 0;

	me = this_player();
	if( !objectp( key1 = present("key1",me) ) )
		return 0;
	if( !objectp( key2 = present("key2",me) ) )
		return 0;

	if( ( arg != "电子门" ) && ( arg != "door" ) && ( arg != "门" ) )
		return 0;

	message_vision("$N将两把电子钥匙分别插到电子门的相两个锁孔里。\n",me);
	message("vision","随着电子钥匙轻轻的旋动，电子门锁解除了！\n",this_object());
	room = load_object(query("exits/south"));
	delete_door("south");
	create_door("south","电子门","north",1);
	room->delete_door("north");
	room->create_door("north","电子门","south",1);

//write(sprintf("%O\n",this_object()->query_doors()));
//write(sprintf("%O\n",room->query_doors()));
	call_out("relock_door",5);
	return 1;
}

void relock_door()
{
	object room;

	message("vision","电子门锁发出“嘀”“嘀”的响声，重新恢复了锁定状态。\n",this_object());

	room = load_object(query("exits/south"));
	room->delete_door("north");
	delete_door("south");
	room->create_door("north","电子门","",1);
	create_door("south", "电子门", "", 1);

//write(sprintf("%O\n",this_object()->query_doors()));
//write(sprintf("%O\n",room->query_doors()));
}
