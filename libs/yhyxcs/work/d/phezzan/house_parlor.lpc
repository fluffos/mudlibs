#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "神秘山庄客厅");
        set("long", @LONG
忽然传入耳际的音乐让人神驰不已。客厅相当宽广，墙壁上还挂
了几幅油画，有着洛可可式的风味。墙壁的另一边挂着一幅宽达两公
尺的大镜子，给人一种豪华却无个性可言的感觉。前面的楼梯连接着
二楼的两个房间。
***********************************************************
这里需要knockdoor才能进入，一个waiter开门，然后门马上关闭。
***********************************************************
LONG
	);
	set("exits", ([ 
		"east" : __DIR__"house_kitchen",
		"south" : __DIR__"secrethouse",
		"west" : __DIR__"house_study",
		"up" : __DIR__"house_story2",
	]));

	set("globe","phezzan");
	setup();
}
