inherit NPC;

#include <ansi.h>

void create() {
  set_name("费沙少女", ({ "girl" }));
  set("gender", "女性");
  set("age", 18);
  set("long", "豆蔻年华的费沙少女，高挑的身材，可爱的笑容。\n");
  set("combat_exp", 200);
  set("attitude", "friendly");
  set("per", 18);

  setup();

  carry_object(__DIR__ "obj/cloth")->wear();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(20)) {
    case 0:
      message_vision("$N毫不掩饰地往$n的脸直盯着看，$n也不知不觉地看着她。\n", this_object(), ob);
      break;
    case 1:
      message_vision("$N突然高声地爆笑了出来，然后小跑步地从$n旁边经过。\n", this_object(), ob);
      break;
  }
}
