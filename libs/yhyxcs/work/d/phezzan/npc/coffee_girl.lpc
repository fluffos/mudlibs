inherit NPC;
inherit F_VENDOR;

#include <ansi.h>

void create()
{
	set_name("咖啡厅小姐", ({ "girl","coffee_girl" }) );
	set("gender", "女性" );
	set("age", 23);
	set("long","温柔可爱的咖啡厅服务小姐。\n");
	set("combat_exp", 200);
	set("attitude", "friendly");
	set("per",18);
	set("vendor_goods", ([
		__DIR__"obj/coffee1" : 20,
		__DIR__"obj/coffee2" : 20,
		__DIR__"obj/coffee3" : 20,
		__DIR__"obj/tea" : 20,
	]) );

	setup();

	carry_object(__DIR__"obj/cloth")->wear();
}

void init()
{	
	object ob;

	::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
	add_action("do_vendor_list", "list");
}


void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	switch( random(4) ) {
		case 0:
		message_vision("$N对$n说：欢迎您的光临，这里有香浓的费沙咖啡，坐下来尝一尝吧？\n",this_object(),ob);
			break;
		case 1:
		message_vision("$N招呼着$n：只要您购买任意一种咖啡，本店赠送精制咖啡杯！\n",this_object(),ob);
			break;
	}
}
