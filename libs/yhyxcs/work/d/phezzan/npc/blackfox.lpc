
inherit NPC;
inherit F_APPLY;
inherit F_MASTER;

#include <ansi.h>

void create()
{
	set_name("安德鲁安·鲁宾斯基", ({ "a.r","blackfox","adrian","rubinsky","lord",}) );
	set("gender", "男性" );
	set("nickname",BLK"费沙的黑狐"NOR);
	set("age", 45);
	set("long",@LONG
    鲁宾斯基的长相实在奇怪之至。虽然年纪在四十岁左右，顶上已
无毛，肌肤是浅黑色的，眉、眼、口、鼻，无一不大，实在称不上是
美男子。不过这种容貌也给人留下了深刻的印象。他的身材魁梧，虎
背熊腰，让人觉得精力充沛，活力十足。身穿着一件黑色高领衫。外
加淡紫色套装，这身休闲的打扮让人一点也感觉不出他是一国的元首。
由於他个性精明难缠，执政的这五年期间，帝国和同盟国给了他一个
封号一一一一“费沙的黑狐”。
LONG
	);
	set("combat_exp", 200000);
	set("attitude", "friendly");

	set("rank",13);
	set_space("vassalage","费沙");

	create_family("费沙自治领", 1, "领主");

	set("product",([
		"帝国战舰":1000,
		"帝国炮舰":3000,
		]) );

	setup();

	carry_object(__DIR__"obj/mag_suit")->wear();
}

void init()
{
        add_action("do_apply", "apply");
}

void attempt_apprentice(object me)
{
	message("vision",CYN + this_object()->name() + "说道：以你现在的实力恐怕还不足以成为我的手下。\n"NOR,environment(me));
}  