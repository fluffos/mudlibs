inherit NPC;
inherit F_VENDOR;

#include <ansi.h>

void create() {
  set_name("服务生", ({ "waiter" }));
  set("gender", "男性");
  set("age", 22);
  set("long", "高大英俊的服务生，彬彬有礼。\n");
  set("combat_exp", 200);
  set("attitude", "friendly");
  set("per", 18);
  set("vendor_goods", ([
    __DIR__ "obj/champagne": 20,
    __DIR__ "obj/squish": 20,
    __DIR__ "obj/salad": 20,
    __DIR__ "obj/cheese": 20,
  ]));

  setup();

  carry_object(__DIR__ "obj/suit")->wear();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(5)) {
    case 0:
      message_vision("$N向$n微一弯腰，说道：请问您是几位？\n", this_object(), ob);
      break;
    case 1:
      message_vision("$N对$n说道：欢迎光临香格里拉饭店，里面请。\n", this_object(), ob);
      break;
  }
}
