inherit NPC;

#include <ansi.h>

void create() {
  set_name("情报员", ({ "lady", "enlistee" }));
  set("gender", "女性");
  set("age", 23);
  set("long", "情报员长描述。\n");
  set("combat_exp", 200);
  set("attitude", "friendly");
  set("per", 18);

  set("rank", 2);
  create_family("费沙自治领", 6, "幕僚");

  set_space("vassalage", "费沙");

  set("chat_chance", 10);
  set("chat_msg", ({
    "情报员似乎心有所思：“近来帝国方面的变化···”\n",
    "情报员似乎有点不满意：“克斯拉···哼哼，克斯拉···”\n",
    "情报员忧心忡忡：“看来同盟的“奇迹杨”处境有些···”\n",
    "情报员非常严肃的说道：“这件事马上向副官阁下汇报！”\n",
    "情报员自言自语道：“再等一等···”\n",
    "情报员吩咐手下：“去把近期的经济走势分析一下···”\n",
    "情报员对着话筒说道：“什么？噢？好的、好的，是！阁下···”\n",
  }));

  setup();

  carry_object(__DIR__ "obj/key2");
  carry_object("/obj/cloth/uniform_p")->wear();
}
