
inherit NPC;
inherit F_VOYAGE;

void create()
{
	set_name("机场小姐", ({ "lady" }) );
	set("gender", "女性" );
	set("age", 25);
	set("long",
		"美丽的费沙机场小姐，负责各次航班的预定(voyage <目的地>)。\n");
	set("combat_exp", 100);
	set("per",25);

	set("voyage",([
		"heinessen":1000,
		"odin":1500,
	]) );

//	set("rank",4);
//	create_family("费沙自治领", 5, "幕僚");
//	set_space("vassalage","费沙");

	setup();

	carry_object(__DIR__"obj/dress")->wear();
}

void init()
{
        add_action("do_voyage", "voyage");
}
