inherit NPC;

#include <ansi.h>

void create() {
  set_name("地球教徒", ({ "monk", "earth monk" }));
  set("gender", "男性");
  set("age", 27);
  set("long", "神色怪异的地球教徒。\n");
  set("combat_exp", 100000);
  set("attitude", "peaceful");

  setup();

  carry_object(__DIR__ "obj/key1");
  carry_object(__DIR__ "obj/blade")->wield();
  carry_object(__DIR__ "obj/cloke")->wear();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    message_vision("$N对着$n大喝一声：什么人？去死吧！\n", this_object(), ob);
    command("close door");
    kill_ob(ob);
  }
}
