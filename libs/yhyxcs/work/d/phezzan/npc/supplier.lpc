
inherit NPC;
inherit F_SUPPLY;

void create()
{
	set_name("补给官", ({ "supplier" }) );
	set("gender", "男性" );
	set("age", 30);
	set("long",
		"费沙自治领的官员，负责舰队补给。\n");
	set("combat_exp", 100);

	set("rank",5);
	create_family("费沙自治领", 5, "");
	set_space("vassalage","费沙");

	setup();

	carry_object("/obj/cloth/uniform_p")->wear();
}

void init()
{
        add_action("do_supply", "supply");
}

void attempt_apprentice(object me)
{
	command("say 抱歉，我没有让您加入费沙的权利，你还是去找事务官博尔德克吧。");
}
