inherit NPC;

#include <ansi.h>

int give_map();

void create() {
  set_name("管理员", ({ "manager" }));
  set("gender", "男性");
  set("age", 33);
  set("long", "管理员长描述。\n");
  set("combat_exp", 200);
  set("attitude", "friendly");

  set("rank", 2);
  create_family("费沙自治领", 5, "幕僚");

  set_space("vassalage", "费沙");

  set("inquiry", ([
    "费沙星图": (: give_map :),
    "费沙": "费沙星系是我最熟悉的了，几乎每天都在电脑上看得到。\n",
    "星图": "我只知道费沙星系的星图，不知道你说的是哪一个。",
  ]));

  set("chat_chance", 10);
  set("chat_msg", ({
    "管理员对者话筒那边吩咐：“副官阁下还在等，请快一些···”\n",
    "管理员自言自语道：“这几个月来总是特别忙···”\n",
    "管理员说道：“不不不，这里有点问题···”\n",
    "管理员半信半疑的说：“你再核查一下···”\n",
    "管理员露出了满意的神情：“嗯，这样就可以了···”\n",
    "管理员吩咐手下：“把这份资料给副官阁下送去···”\n",
  }));

  setup();

  carry_object("/obj/cloth/uniform_p")->wear();
}

int give_map() {
  object me, ob;
  string my_vassalage;

  me = this_player();
  ob = this_object();
  if (!stringp(my_vassalage = me->query_space("vassalage"))
    || (my_vassalage == "中立")) {
    write(CYN + ob->name() + "说道：你是哪一支舰队的指挥官，问这个干什么？\n" NOR);
    return 1;
  }
  if (my_vassalage != ob->query_space("vassalage")) {
    if (random(30 - me->query_kar())) {
      write(CYN + ob->name() + "说道：你是哪一支舰队的指挥官，问这个干什么？\n" NOR);
      return 1;
    }
    message("vision", HIR "房间里忽然间警铃大作。\n" NOR, environment(ob), ({}));
    write(HIR "你的身份被" + ob->name() + HIR "识破了！\n" NOR);
    write("打起来的功能我还没有做:-P\n");
    return 1;
  }
  if (!pointerp(me->query_space("sub_fleet"))) {
    write(CYN + ob->name() + "笑笑说道：你还没有担任舰队指挥官吧？算了，说了你也不明白。\n" NOR);
    return 1;
  }

  message_vision("$N似乎和$n很谈得来，向$n讲述了不少费沙星系的事情。\n", ob, me);

  if (!pointerp(me->query_space("maps")))
    me->set_space("maps", ({}));
  if (member_array("/u/phezzan", me->query_space("maps")) == -1) {
    if (me->query_space("landin") != "phezzan") {
      write(CYN + ob->name() + "说道：唉，你的旗舰并没有停留本星球，可惜，可惜。\n" NOR);
      return 1;
    }
    write(CYN + ob->name() + "说道：我已经将费沙星系资料输入你的旗舰了，航行平安吧！\n" NOR);
    me->add_space("maps", ({ "/u/phezzan" }));
  }
  return 1;
}
