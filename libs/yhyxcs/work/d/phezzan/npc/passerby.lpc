inherit NPC;

#include <ansi.h>

void create() {
  set_name("行人", ({ "goer" }));
  set("gender", "女性");
  set("age", 26);
  set("long", "行色匆匆的过路人。\n");
  set("combat_exp", 200);
  set("attitude", "friendly");
  set("chat_chance", 10);
  set("chat_msg", ({
    "行人从口袋里掏出一份乳汁烤鸟肉，大口的吃着。\n",
    (: random_move :),
  }));

  setup();

  if (!random(3))
    carry_object(__DIR__ "obj/cook1");

  carry_object(__DIR__ "obj/dress")->wear();
}
