inherit NPC;

#include <ansi.h>

void create() {
  object epaulet;

  set_name("维欧拉", ({ "weioula" }));
  set("gender", "男性");
  set("age", 34);
  set("long",
    "首席驻在武官维欧拉上尉是个又高又胖的人，但一见之下，却仍感意
外。因为他这个人，说是胖，却又似乎没什么肉，在他那青白的皮肤
之下所掩盖的好像不是筋肉也不是脂肪，而是涨满的瓦斯气体似的。
他看起来总让人觉得好像轻飘飘的，像是一艘鼓鼓的飞行船。
");
  set("combat_exp", 100000);
  set("attitude", "friendly");

  set("chat_chance", 5);
  set("chat_msg", ({
    "维欧拉上尉艰难的移动着他肥胖的身体，在房间里度来度去。\n",
    "维欧拉上尉偷偷的从口袋里拿出一块糖果，迅速放到嘴里。\n",
    "维欧拉上尉从屋子的这边走到那边，吭哧，吭哧。。。\n",
    "维欧拉上尉挺着肚子在电脑前摸索着输入键，看起来有点费劲。\n",
    "维欧拉上尉自言自语道：电脑里的星图不会被病毒搞坏了吧？\n",
  }));

  create_family("同盟领事馆", 2, "驻在武官");
  set_space("vassalage", "同盟");
  set("rank", 4);

  setup();

  epaulet = new("/obj/cloth/epaulet");
  epaulet->set("name", "同盟上尉肩章");
  epaulet->set("long", "同盟上尉肩章的长描述。\n");

  if (epaulet->move(this_object()))
    epaulet->wear();
  carry_object("/obj/cloth/uniform_a")->wear();
}
