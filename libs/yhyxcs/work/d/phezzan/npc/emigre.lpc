inherit NPC;

#include <ansi.h>

void create() {
  set_name("流亡者", ({ "emigre" }));
  set("gender", "男性");
  set("age", 42);
  set("long", "流亡者的长描述。\n");
  set("combat_exp", 200);
  set("attitude", "friendly");
  set("chat_chance", 10);
  set("chat_msg", ({
    "流亡者恨恨的嘀咕：“哼！金发小子！”\n",
    "流亡者双手紧紧的握着拳：“迟早有一天···”\n",
    "流亡者在牙缝里挤出话来：“鲁宾斯基那只老狐狸···”\n",
    "流亡者显的面有忧色：“不知道伯爵最近···”\n",
    "流亡者皱着眉头，自言自语道：“同盟那方面的···”\n",
  }));

  setup();

  carry_object(__DIR__ "obj/suit")->wear();
}
