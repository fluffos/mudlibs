inherit NPC;
inherit F_RANK;
inherit F_MASTER;

void create() {
  set_name("尼古拉斯·博尔德克", ({ "n.b", "boltic", "nikolas", "fuguan" }));
  set("gender", "男性");
  set("age", 35);
  set("long", @LONG
    博尔德克的嘴角稍微泛起了笑意。这个黑头发、瘦削面孔，身穿
米黄色西服的男人，总是以一种极为适宜的表情注视着他眼前的人，
但是眼神当中流露着观察与盘算的心机。对这个毫无名气的优秀演员
来说，未能将这种极为巧妙精致的高超艺术成果公诸于世人面前，实
在是太可惜了。
LONG
  );
  set("combat_exp", 100);

  set("rank", 7);
  create_family("费沙自治领", 3, "帝国驻在事务官");

  set_space("number", 1);
  set_space("vassalage", "费沙");
  set_space("scouting", 100);

  add_sub_fleet("帝国战舰", "第一部队", 300, 300);
  add_sub_fleet("帝国战舰", "第二部队", 300, 300);

  set_sub_fleet(1, "attacktype", "missile");

  setup();

  set_s_skill("beam", 90);
  set_s_skill("missile", 50);
  set_s_skill("air_force", 30);
  set_s_skill("formation", 100);
  set_s_skill("fovea", 70);
  set_s_skill("shuttle", 70);
  set_s_skill("trapezia", 70);
  set_s_skill("defending", 50);
  set_s_skill("lancer", 60);
  set_s_skill("reining", 90);
  map_s_skill("formation", "shuttle");
  map_s_skill("beam", "lancer");

  //	set_skill("axe", 60);

  carry_object(__DIR__ "obj/key1");
  carry_object("/obj/cloth/uniform_p")->wear();
}

void init() {
  add_action("do_advance", "rankme");
}

void attempt_apprentice(object me) {
  command("recruit " + me->query("id"));
}

void recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob)) {
    ob->set("family/generation", 7);
    ob->assign_apprentice("", 0);
  }
}

void re_rank(object student) {
  int score;
  score = (int)student->query("score");

  if (score > 10000) {
    tell_object(student, this_object()->name() + "说道：费沙正需要你这样的人才，去和盖塞林格联系吧！\n");
    return;
  }
  if (score > 7000) {
    student->set("title", "费沙自治领高级幕僚");
    student->set("family/generation", 4);
    if (student->query("rank") > 5) return;
    student->set("promoted", 6);
    tell_object(student, this_object()->name() + "决定晋升你了，快接收任命(rankme)吧！\n");
    return;
  } else if (score > 4000) {
    student->set("title", "费沙自治领中级幕僚");
    student->set("family/generation", 5);
    if (student->query("rank") > 4) return;
    student->set("promoted", 5);
    tell_object(student, this_object()->name() + "决定晋升你了，快接收任命(rankme)吧！\n");
    return;
  } else if (score > 1000) {
    student->set("title", "费沙自治领初级幕僚");
    student->set("family/generation", 6);
    if (student->query("rank") > 3) return;
    student->set("promoted", 4);
    tell_object(student, this_object()->name() + "决定晋升你了，快接收任命(rankme)吧！\n");
    return;
  } else if (score > 700) {
    if (student->query("rank") > 2) return;
    student->set("promoted", 3);
    tell_object(student, this_object()->name() + "决定晋升你了，快接收任命(rankme)吧！\n");
    return;
  } else if (score > 400) {
    if (student->query("rank") > 1) return;
    student->set("promoted", 2);
    tell_object(student, this_object()->name() + "决定晋升你了，快接收任命(rankme)吧！\n");
    return;
  } else if (score > 100) {
    if (student->query("rank")) return;
    student->set("promoted", 1);
    tell_object(student, this_object()->name() + "决定晋升你了，快接收任命(rankme)吧！\n");
    return;
  } else return;
}
