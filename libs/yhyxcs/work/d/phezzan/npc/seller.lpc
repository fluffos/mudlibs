inherit NPC;
inherit F_VENDOR;

#include <ansi.h>

void create() {
  set_name("店员", ({ "girl", "seller" }));
  set("gender", "女性");
  set("age", 23);
  set("long", "黄金之都的店员。\n");
  set("combat_exp", 200);
  set("attitude", "friendly");
  set("per", 23);

  set("vendor_goods", ([
    __DIR__ "obj/suit": 20,
    __DIR__ "obj/dress": 20,
    __DIR__ "obj/skirt": 20,
  ]));

  setup();

  carry_object(__DIR__ "obj/skirt")->wear();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(10)) {
    case 0:
      message_vision("$N招呼着$n：欢迎来到黄金之都，这里有新到的服装，要不要买一件？\n", this_object(), ob);
      break;
    case 1:
      message_vision("$N对$n说道：黄金之都是费沙最繁华的商业中心，请来看看吧。\n", this_object(), ob);
      break;
  }
}
