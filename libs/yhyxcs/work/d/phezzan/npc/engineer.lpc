inherit NPC;

#include <ansi.h>

void repaired(object room);
void make_mistake();

void create() {
  set_name("电力工程师", ({ "engineer" }));
  set("gender", "男性");
  set("age", 27);
  set("long", "神情专注的供电所工程师，正监控着这里的设备。\n");
  set("combat_exp", 100000);
  set("attitude", "peaceful");

  set("chat_chance", 5);
  set("chat_msg", ({
    "电力工程师凑过脸，仔细的看着仪器，也不知道那有什么好看的。\n",
    "电力工程师走到电脑前，把刚刚测量到的数据输入了进去。\n",
    "电力工程师从监控电脑走到显示屏前，又走到电力仪旁，然后再转回来。\n",
    (: make_mistake :),
  }));

  setup();

  carry_object(__DIR__ "obj/smock")->wear();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting())
    ob->set_temp("bother_time", time());
}

void make_mistake() {
  object room, ob, *inv;
  int i, check = 0;


  if (this_object()->query_temp("is_repairing")) {
    message_vision("$N正在努力的抢修电力设备，额头上渗出细密的汗滴。\n", this_object());
    return;
  }

  inv = all_inventory(environment(this_object()));

  for (i = 0; i < sizeof(inv); i++) {
    if (userp(inv[i])
      && (inv[i]->query_temp("bother_time") + 60 < time()))
      check = 1;
  }

  if (!check) {
    message_vision("$N嘟嘟囔囔的说道：我最讨厌工作的时候被人打扰了。。。\n", this_object());
    return;
  }
  if (random(2)) {
    message_vision("$N忽然间大叫一声：不好，自治领主府的供电出问题了！\n", this_object());
    room = load_object("/d/phezzan/fuguan_office");
    if (!objectp(room)) return;
    room->set("no_power", 1);
    message("vision", HIY "四台电脑忽然间都停止了工作，灯也全熄灭了！\n" NOR, room);
    if (objectp(ob = present("r.g", room))) {
      destruct(ob);
      message("vision", "盖塞林格看了看周围，狠狠的哼了一声，一脸阴沉的走了出去。\n", room);
    }
  } else {
    message_vision("$N忽然间大叫一声：不好，医科大学附属医院的供电出问题了！\n", this_object());
    room = load_object("/d/phezzan/x_ray_room.lpc");
    if (!objectp(room)) return;
    room->set("no_power", 1);
    message("vision", HIY "巨大的设备忽然间停止了工作，应急灯却亮了起来！\n" NOR, room);
  }
  this_object()->set_temp("is_repairing", 1);
  call_out("repaired", 60, room);
  return 1;
}

void repaired(object room) {
  if (!room) return;
  if (!room->query("no_power")) return;

  message_vision("$N擦着脸边的汗水，松了一大口气自言自语道：终于修好了！\n", this_object());
  this_object()->delete_temp("is_repairing");
  room->setup();
  message("vision", HIY "这里的供电又恢复了正常！\n" NOR, room);
  room->delete("no_power");
}
