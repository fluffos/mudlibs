inherit NPC;
inherit F_BANKER;

#include <ansi.h>

void create() {
  set_name("营业小姐", ({ "lady", "bank_lady" }));
  set("gender", "女性");
  set("age", 26);
  set("long", "费沙中央银行的营业员，声音柔软可人，一直面带微笑。\n");
  set("combat_exp", 200);
  set("attitude", "friendly");
  set("per", 18);

  set("inquiry", ([
    "服务": "本行提供 查帐(check)、申请新卡(apply)和恢复帐户\n(restore)的服务。\n",
    "service": "本行提供 查帐(check)、申请新卡(apply)和恢复帐户\n(restore)的服务。\n",
  ]));

  setup();

  carry_object(__DIR__ "obj/dress")->wear();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("check_account", "check");
  add_action("apply_id_card", "apply");
  add_action("restore_account", "restore");
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(2)) {
    case 0:
      message_vision(CYN "$N从椅子上站了起来，对$n说道：欢迎您来到费沙中央银行。\n" NOR, this_object(), ob);
      break;
    case 1:
      message_vision(CYN "$N微笑着示意刚刚走进来的$n在桌边的高脚皮凳坐下。\n" NOR, this_object(), ob);
      break;
    case 1:
      message_vision(CYN "$N甜甜的对$n说道：您需要本行为您提供什么服务？\n" NOR, this_object(), ob);
      break;
  }
}
