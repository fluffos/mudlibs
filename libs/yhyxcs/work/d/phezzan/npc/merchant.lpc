inherit NPC;

#include <ansi.h>

void create()
{
	set_name("年轻商人", ({ "merchant","young merchant","young" }) );
	set("gender", "男性" );
	set("age", 24);
	set("long","年轻商人的长描述。\n");
	set("combat_exp", 200);
	set("attitude", "friendly");
	set("chat_chance", 5);
	set("chat_msg", ({
		"年轻商人作出恐怖的表情：在伊谢尔伦，险些被那什么大炮误伤！！\n",
		"年轻商人绘声绘色的讲着：哇，那流星雨，冰雹一样打在我的船上，就差一点。\n",
		"年轻商人显得满不在乎：我当时就说，别紧张！怕什么？！有我在呢！！\n",
		"年轻商人一脸的英雄气概：当时大家都慌神了，全都惊恐地看着我。\n",
		"年轻商人咕嘟一口，把杯中的液体一饮而尽···\n",
		"年轻商人又向小姐要了一杯酒。\n",
		"年轻商人紧拧着眉头，说道：当时我一想，我要冷静，这些人就全靠我了。\n",
		"年轻商人心有余悸的说：有一次，我们偏航了，马上进入黑洞时才发现。\n",
		"年轻商人夸张的比划着：帝国军的炮舰就在我们旁边，个头足有我们的十倍。\n",
		"年轻商人得意的笑着：哈哈哈···把他们吓坏了···\n",
		"年青商人故作神秘，低声说道：那天我看到一个化装成旅游者的地球教徒。\n",
	}) );

	setup();

	carry_object("/obj/id_card")->set("name","信用卡");
	carry_object(__DIR__"obj/suit")->wear();
}
