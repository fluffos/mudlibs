inherit NPC;

#include <ansi.h>

void create() {
  set_name("行人", ({ "goer" }));
  set("gender", "男性");
  set("age", 32);
  set("long", "行色匆匆的路人。\n");
  set("combat_exp", 200);
  set("attitude", "friendly");
  set("chat_chance", 10);
  set("chat_msg", ({
    "行人从口袋里掏出一份肉丸子，大口的吃着。\n",
    (: random_move :),
  }));

  setup();
  if (!random(3))
    carry_object(__DIR__ "obj/meatball");

  carry_object(__DIR__ "obj/suit")->wear();
}
