inherit NPC;

#include <ansi.h>

void create()
{
	set_name("贵族后裔", ({ "noble","amir" }) );
	set("gender", "男性" );
	set("age", 32);
	set("long","贵族后裔的长描述。\n");
	set("combat_exp", 200);
	set("attitude", "friendly");
	set("chat_chance", 5);
	set("chat_msg", ({
		"贵族后裔很不放心的说：“您还要多注意身体···”\n",
		"贵族后裔小声的问道：“···听说过几天···”\n",
		"贵族后裔谦卑的说：“···也许现在已经···”\n",
		"贵族后裔怒视着你，咆哮着：“你看什么看！！”\n",
		"贵族后裔弯下腰，恭敬的提议道：“男爵阁下，我看···”\n",
		"贵族后裔自言自语的说：也不知道郝晋格男爵在伊斯麦尔怎么样了···\n",
	}) );

	setup();

	carry_object(__DIR__"obj/suit")->wear();
}
