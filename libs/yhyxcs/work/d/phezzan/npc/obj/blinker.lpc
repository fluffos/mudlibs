#include <ansi.h>

inherit ITEM;

void create() {
  set_name("信号灯", ({ "blinker", "signaler", "light" }));
  set_weight(500);
  set("usage", 20);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "只");
    set("long",
      "一只电子信号灯，可以用来发出一红一绿的信号。\n");
    set("value", 100);
  }
}

void init() {
  add_action("do_poweron", "poweron");
}

int do_poweron() {
  object me;

  me = this_player();
  if (environment(this_object()) != me)
    return 0;
  if (query("usage") < 1)
    return notify_fail("没有电的信号灯应该是没有什么用处的。\n");

  message_vision("$N打开了手里的信号灯，让它闪了几下，也不知道要给谁发信号。\n", me);
  add("usage", -1);

  return 1;
}
