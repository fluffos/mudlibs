#include <weapon.h>

inherit BLADE;

void create()
{
	set_name("碳素刀", ({ "blade" }) );
	set_weight(4000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "柄");
		set("value", 500);
		set("material", "carbon");
		set("long", "这是一寻常的碳素刀，大约三四公斤重。\n");
		set("wield_msg", "$N抽出一把$n握在手中。\n");
		set("unequip_msg", "$N将手中的$n插入刀鞘收了起来。\n");
	}

	init_blade(10);
	setup();
}
