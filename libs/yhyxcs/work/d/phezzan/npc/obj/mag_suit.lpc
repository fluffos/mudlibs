#include <armor.h>

inherit CLOTH;

void create() {
  set_name("淡紫色套装", ({ "suit" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "cloth");
    set("value", 1000);
    set("armor_prop/armor", 5);
  }
  setup();
}
