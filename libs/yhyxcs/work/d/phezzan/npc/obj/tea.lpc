inherit ITEM;
inherit F_LIQUID;

void create()
{
	set_name("费沙红茶", ({ "tea cup","cup" }));
	set_weight(300);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "杯");
		set("long",
			"一只制作相当精致的咖啡杯。\n");
		set("value", 40);
		set("max_liquid", 2);
	}

	set("liquid", ([
		"type": "water",
		"name": "红茶",
		"remaining": 2,
	]) );
}
