inherit ITEM;
inherit F_LIQUID;

void create()
{
	set_name("简包装", ({ "package" }));
	set_weight(300);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "只");
		set("long",
			"一只经过超高温消毒的简包装。\n");
		set("value", 20);
		set("max_liquid", 3);
	}

	set("liquid", ([
		"type": "water",
		"name": "果汁",
		"remaining": 3,
	]) );
}
