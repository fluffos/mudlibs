inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("马铃薯泥", ({ "potato" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一份热腾腾的马铃薯泥。\n");
    set("unit", "份");
    set("value", 20);
    set("food_remaining", 5);
    set("food_supply", 20);
  }
}
