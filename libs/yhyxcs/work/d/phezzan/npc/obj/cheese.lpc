inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("原味乳酪", ({ "natural cheese", "cheese" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一份散发着香气，新鲜的原味乳酪。\n");
    set("unit", "份");
    set("value", 30);
    set("food_remaining", 3);
    set("food_supply", 30);
  }
}
