// book.c
#include <ansi.h>

inherit ITEM;

void create() {
  set_name("星图介绍", ({ "astronomy book", "book" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long",
      "一本介绍各个著名星系的书。\n");
    set("value", 100);
    set("material", "paper");
  }
}

void init() {
  add_action("do_read", "read");
}

int do_read() {
  object me;

  me = this_player();
  message_vision(HIY "\n$N拿起一本《星图介绍》认真的读着。\n" NOR, me);

  me->set_space("maps", ({ "/u/phezzan", "/u/iserlohn", "/u/walhalla", "/u/ballat" }));
  return 1;
}
