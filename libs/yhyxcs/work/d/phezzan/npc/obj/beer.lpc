inherit ITEM;
inherit F_LIQUID;

void create()
{
	set_name("啤酒", ({ "beer","bottle" }));
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "瓶");
		set("long",
			"一只非常普通的啤酒瓶。\n");
		set("value", 20);
		set("max_liquid", 5);
	}

	set("liquid", ([
		"type": "alcohol",
		"name": "啤酒",
		"remaining": 5,
		"drunk_apply": 4,
	]) );
}
