inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name("费沙咖啡", ({ "phezzan cup", "cup" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "杯");
    set("long",
      "一只制作精致的费沙咖啡杯。\n");
    set("value", 20);
    set("max_liquid", 2);
  }

  set("liquid", ([
    "type": "water",
    "name": "咖啡",
    "remaining": 2,
  ]));
}
