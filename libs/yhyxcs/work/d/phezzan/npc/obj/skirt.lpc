#include <armor.h>

inherit CLOTH;

void create() {
  set_name("短裙", ({ "skirt", "short skirt" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "条");
    set("material", "cloth");
    set("value", 200);
    set("armor_prop/armor", 1);
  }
  setup();
}
