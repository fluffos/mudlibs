inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("莴苣沙拉", ({ "blt salad", "salad" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一份色泽相当不错的沙拉。\n");
    set("unit", "份");
    set("value", 30);
    set("food_remaining", 3);
    set("food_supply", 30);
  }
}
