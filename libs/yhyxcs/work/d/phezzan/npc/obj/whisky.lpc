inherit ITEM;
inherit F_LIQUID;

void create()
{
	set_name("威士忌", ({ "whisky","bottle" }));
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "瓶");
		set("long",
			"一只很具现代感的威士忌酒瓶。\n");
		set("value", 20);
		set("max_liquid", 6);
	}

	set("liquid", ([
		"type": "alcohol",
		"name": "啤酒",
		"remaining": 6,
		"drunk_apply": 10,
	]) );
}
