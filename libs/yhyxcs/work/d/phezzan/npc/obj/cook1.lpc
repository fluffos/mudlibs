inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("乳汁烤鸟肉", ({ "milk fresh" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一份刚刚做好的乳汁烤鸟肉。\n");
    set("unit", "份");
    set("value", 500);
    set("food_remaining", 5);
    set("food_supply", 20);
  }
}

int finish_eat() {
  set_name("合成陶瓷盘", ({ "plate" }));
  set("unit", "只");
  set("long", "一只很漂亮的合成陶瓷盘。\n");
  return 1;
}
