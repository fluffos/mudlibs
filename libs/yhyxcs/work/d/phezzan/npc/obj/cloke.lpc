#include <armor.h>

inherit CLOTH;

void create() {
  set_name("黑色长袍", ({ "cloke" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "cloke");
    set("long", "一件黑色的长袍，只有僧侣才会穿。\n");
    set("armor_prop/armor", 5);
  }
  setup();
}
