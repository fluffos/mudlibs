#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "费沙中央银行");
  set("long", @LONG
大理石台阶、高硬度透明合金的建筑，这里就是费沙人可籍以控
制银河系命脉的心脏地带，也是整个银河系财富的会聚之所。每年，
每月，甚至每一分钟，都不知有多少万亿的帝纳尔、帝国马克流入这
里，又从这里以借贷的形式充实到同盟和帝国的国防预算中去，从而
获得年复一年丰厚而稳定的利润---说他是大发国难财也罢。
LONG
  );

  set("globe", "phezzan");

  set("exits", ([
    "north": __DIR__ "center_bank_hall",
    "south": __DIR__ "estreet2",
  ]));

  set("objects", ([
    __DIR__ "npc/goer": 1,
  ]));

  set("coor/x", 60);
  set("coor/y", 20);
  set("coor/z", 0);

  setup();
}
