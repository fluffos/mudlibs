#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", GRN"高速路"NOR);
	set("long", @LONG
来往的车辆川流不息，高速路两旁的自然景致倒是不错。
LONG
	);

	set("globe","phezzan");

	set("exits", ([
		"north" : __DIR__"highway4",
                "south" : __DIR__"highway2",
	]));

	set("walk_bonus",10);

	set("coor/x",0);
	set("coor/y",-130);
	set("coor/z",0);

	setup();
}
