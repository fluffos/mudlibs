#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "西走廊");
  set("long", @LONG
木制结构的回廊地板，走上去发出木板轻微摩擦的声音。从这里
可以俯瞰一楼大厅。外侧的扶手也是暗色调硬制木料，显得朴实无华。
一般的情况下，西面的木门都是关闭着的。
LONG
  );

  set("exits", ([
    "south": __DIR__ "w_gallery",
    "west": __DIR__ "winter_refectory",
    "north": __DIR__ "w_gallery2",
  ]));

  set("coor/x", -60);
  set("coor/y", 85);
  set("coor/z", 20);

  set("globe", "phezzan");

  create_door("west", "木门", "east", 1);

  setup();
}
