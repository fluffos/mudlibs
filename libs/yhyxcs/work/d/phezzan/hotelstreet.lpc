#include <ansi.h>

inherit ROOM;

void create() {
  set("short", GRN "菲亚巴尔特街" NOR);
  set("long", @LONG
行人摩肩接踵的菲亚巴尔特街是集饭店、宾馆、旅店等休闲娱乐
设施于一体的地方。这里西面是“巴特亚”酒店，东面就是著名的“
香格里拉”饭店。
LONG
  );

  set("globe", "phezzan");

  set("exits", ([
    "east": __DIR__ "shangrila",
    "south": __DIR__ "hotelstreet2",
    "west": __DIR__ "bateya",
    "north": __DIR__ "wstreet1",
  ]));

  set("taxi", ([
    __DIR__ "highway": 220,
    __DIR__ "square": 20,
  ]));

  set("objects", ([
    __DIR__ "npc/passerby": 1,
  ]));

  set("coor/x", -40);
  set("coor/y", -30);
  set("coor/z", 0);

  setup();
}
