#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", GRN"高速路入口"NOR);
	set("long", @LONG
费沙的宇宙港就在南边不远处。虽然已经有近百年费沙都没有听
过宇宙战舰的呼啸了，但时至今日商船队的数量却是有过之而无不及，
宇宙港的规模也就随之越扩越大。为防止干扰行星住民，几十年来宇
宙港已搬迁过三次了。因为是高速路的入口，所以有不少地上出租车
在等着拉客人，而往返市区最快也要半个小时。
LONG
	);
	set("globe","phezzan");

	set("taxi",([
		__DIR__"square" : 200,
	]) );

	set("exits", ([
		"north" : __DIR__"highway1",
                "south" : __DIR__"starport",
	]));

	set("coor/x",0);
	set("coor/y",-280);
	set("coor/z",0);

	set("walk_bonus",5);

	setup();
}

