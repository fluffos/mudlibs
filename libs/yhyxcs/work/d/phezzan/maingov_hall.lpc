#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "领主府大厅");
  set("long", @LONG
富丽堂皇的壁画、金碧光辉的天顶无不显示出费沙强大的经济实
力。十根擎天立柱列立两厢。往前看，红色地毯的尽头是领主副官的
办公室。虽然灯光明亮，但是一股森然的气氛依然笼罩全身。东面是
情报采集室，西面是资料室。
LONG
  );

  set("globe", "phezzan");

  set("exits", ([
    "east": __DIR__ "info_gathering",
    "south": __DIR__ "maingov",
    "west": __DIR__ "info_room",
    "north": __DIR__ "passage",
  ]));

  set("coor/x", 0);
  set("coor/y", 130);
  set("coor/z", 0);

  setup();
}
