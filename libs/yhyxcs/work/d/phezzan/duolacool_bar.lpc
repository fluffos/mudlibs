#include <ansi.h>

inherit ROOM;

void create()
{
	set("short","吧台");
	set("long", @LONG
吧台前柔和的灯光营造着舒适的气氛，上方挂满了玲珑剔透的高
脚杯，在轻微的碰撞下发出悦耳的响声。几个小伙子正酒气喷喷地高
声宣扬自己在星系间航行时的历险奇遇，以博取女士们的掌声和惊呼。
说者神采飞扬，听者如痴如醉，而几个老商人则对他们递送了不屑的
眼神之后付帐离去。
LONG
	);
	set("globe","phezzan");

	set("exits", ([
		"leave" : __DIR__"duolacool",
	]));

	set("objects", ([
		__DIR__"npc/merchant" : 1,
		__DIR__"npc/bar_girl" : 1,
	]) );

	set("coor/x",-10);
	set("coor/y",-300);
	set("coor/z",0);

	setup();
}
