#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "东走廊");
  set("long", @LONG
木制结构的回廊地板，走上去发出木板轻微摩擦的声音。从这里
可以俯瞰一楼大厅。外侧的扶手也是暗色调硬制木料，显得朴实无华。
LONG
  );

  set("exits", ([
    "east": __DIR__ "winter_bedroom",
    "south": __DIR__ "e_gallery",
    "north": __DIR__ "e_gallery2",
  ]));

  set("globe", "phezzan");

  seteuid(getuid());

  set("coor/x", -40);
  set("coor/y", 85);
  set("coor/z", 20);

  create_door("east", "木门", "", 1);

  setup();
}

void init() {
  load_object(__DIR__ "winter_bedroom.lpc");
}
