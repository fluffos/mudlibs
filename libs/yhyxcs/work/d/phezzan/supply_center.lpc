#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "费沙物资集散中心");
	set("long", @LONG
费沙中央物资中心，掌握着银河系近半数的具有战略意义的物资
调动权。中心仅有此一个办公大厅，来往的商人、政府办事员都是来
往匆匆，因为真正的物资调拨是在中央宇宙港直接交易的。
LONG
	);

	set("globe","phezzan");

	set("exits", ([
		"north" : __DIR__"estreet1",
	]));

	set("objects", ([
		__DIR__"npc/gambler" : 1,
	]) );

	set("coor/x",40);
	set("coor/y",-20);
	set("coor/z",0);

	setup();
}
