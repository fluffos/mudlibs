//Modified by xyc
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "朵拉库尔酒吧");
  set("long", @LONG
人声鼎沸……这里并非一般船舱，而是由一艘超期服役的运输船
改建而成的酒馆。在宇宙中做买卖的独立商人们经常在这里聚会喝酒。
对面狭长的吧台前坐满了人，正在高声说笑。这里简直就是费沙的缩
影，一个像人类历史上加尔各答、长安、波罗塞尔比纳…一样的“冒
险家与野心家的天堂”。
LONG
  );

  set("globe", "phezzan");

  set("item_desc", ([
    "吧台": "前面已经有不少人了，你可以坐过去（ＳＩＴＤＯＷＮ）喝一杯。\n",
    "bar": "前面已经有不少人了，你可以坐过去（ＳＩＴＤＯＷＮ）喝一杯。\n",
  ]));

  set("exits", ([
    "east": __DIR__ "starport",
  ]));

  set("objects", ([
    //		__DIR__"npc/lady" : 1,
  ]));

  set("coor/x", -10);
  set("coor/y", -300);
  set("coor/z", 0);

  setup();
}

void init() {
  add_action("do_sitdown", "sitdown");
}

int do_sitdown() {
  object me;
  object room;

  me = this_player();
  message_vision("$N在吧台前找到了一张高脚啤酒凳，坐了下来。\n", me);

  room = load_object(__DIR__ "duolacool_bar.lpc");
  if (objectp(room)) {
    if (me->move(room))
      return 1;
  }
  return 0;
}
