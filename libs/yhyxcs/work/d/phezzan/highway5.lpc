#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", GRN"高速路入口"NOR);
	set("long", @LONG
来往的车辆川流不息，高速路两旁的自然景致倒是不错。人流渐
显密集，市区近在眼前，而费沙的宇宙港却在路的尽头。
LONG
	);

	set("globe","phezzan");

	set("exits", ([
		"north" : __DIR__"square",
                "south" : __DIR__"highway4",
	]));

	set("walk_bonus",5);

	set("coor/x",0);
	set("coor/y",-30);
	set("coor/z",0);

	setup();
}

