#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "冬馆北草坪");
        set("long", @LONG
周围是四季如一嫩绿色的厚草垫，草坪中央有一只大理石雕刻的
狮子，环境静谧，北边不远就是冬馆的主建筑了。
LONG
	);

	set("exits", ([
		"north" : __DIR__"winter_tree",
		"south" : __DIR__"winter_lawn",
	]));

	set("globe","phezzan");

	set("coor/x",-30);
	set("coor/y",70);
	set("coor/z",0);

	setup();
}
