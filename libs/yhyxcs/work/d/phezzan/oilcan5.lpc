#include <ansi.h>

inherit ROOM;

void create()
{
	set("short","贮油罐深处");
	set("long", @LONG
这里林立着巨大贮油罐，北边的间隙处终于可以见到一座纯木盖
成的小屋，它挤在闪动着奕奕银光的金属人造物中，看起来倒是别有
一番风味。这里已经比较靠近罗夫汀地区的边缘了，南边就隐约可以
看到西郊的沙漠。
LONG
	);

	set("globe","phezzan");

	set("exits", ([
		"east" : __DIR__"oilcan2",
		"south" : __DIR__"west_desert",
		"west" : __DIR__"oilcan1",
		"north" : __DIR__"earth_antehall",
	]));

	set("coor/x",-130);
	set("coor/y",-40);
	set("coor/z",0);

	create_door("north", "木门", "south", 1);

	setup();
}
