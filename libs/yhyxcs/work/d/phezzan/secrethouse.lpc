#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "神秘山庄");
  set("long", @LONG
山庄的玄关富丽堂皇，掩映在湖光山色之间。象牙白的柔色石料，
两侧精工雕刻的石狮，无一不在诉说着主人的贪婪本性。几级同样石制
的弧形台阶打扫得一尘不染，上面就是山庄的大厅。东西两面另有青石
小径，似乎是通往后山的。
***********************************************************
从这里可以偷地上车，开到帝国领事馆。但途中可能被击毁，
玩家被call到任意一个"丛林迷宫"中。
如果是费沙军官，可以向鲁宾斯基申请地上车。
***********************************************************
LONG
  );

  set("exits", ([
    "east": __DIR__ "estoneway",
    "south": __DIR__ "lakeside",
    "west": __DIR__ "wstoneway",
    "north": __DIR__ "house_parlor",
  ]));

  set("globe", "phezzan");
  setup();
}
