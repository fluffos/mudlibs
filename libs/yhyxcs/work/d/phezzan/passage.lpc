#include <ansi.h>

inherit ROOM;

void create()
{
	set("short","领主府大厅");
	set("long", "长长的"+RED"红色地毯"NOR+"走上去轻松而柔软。厅柱的间隙间可以隐约看到前
几任领主的画像，只是色调十分昏暗，也许是现在当权的领主有意弱
化他们在商人们心中的形象吧，谁又能知道呢？不过你最好还是多注
意一点脚下----免得被那些固毯钉绊到。
");

	set("globe","phezzan");

	set("item_desc", ([
		"红色地毯":"漂亮的红色地毯，一直延伸到领主副官办公室的门口。\n",
		"carpet":"漂亮的红色地毯，一直延伸到领主副官办公室的门口。\n",
		"red carpet":"漂亮的红色地毯，一直延伸到领主副官办公室的门口。\n",
		"ditan":"漂亮的红色地毯，一直延伸到领主副官办公室的门口。\n",
	]) );

	set("exits", ([
		"south" : __DIR__"maingov_hall",
		"north" : __DIR__"passage1",
	]));

	set("coor/x",0);
	set("coor/y",140);
	set("coor/z",0);

	setup();
}

int valid_leave(object me,string arg)
{
	if( random(me->query_kar()) < 3 )
	{
		message_vision(YEL"尽管非常注意，$N还是被脚下的固毯钉拌了个大跟头，极为狼狈的摔在地上。\n\n"NOR,me);
		me->set_temp("fluster",1);
		return notify_fail("");
	}
	return 1;
}
