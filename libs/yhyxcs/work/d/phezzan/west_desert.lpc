#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "费沙西部沙漠");
  set("long", @LONG
荒凉的美。自从费沙在三百五十年前，由出身于地球的钜商雷欧
波特·拉普透过请愿、游说和巨额的贿赂成立之后，这里就是这个样
子。恶劣的自然气候以及水资源的缺乏是这里得不到发展的原因。
LONG
  );
  /*
********************************************************
这里是一个迷宫入口，通往费沙东郊，路应很长。
就是fengyun里的沙漠，可以有一些怪兽出没，戈壁滩、沙漠植物
可以找到一些task之类好东西，必然能捡到钱。
减饮水，加杀气。
**********************************************************
*/
  set("globe", "phezzan");

  set("exits", ([
    "east": __DIR__ "west_suburb",
    //		"west" : __DIR__"west_desert",
  ]));

  set("coor/x", -130);
  set("coor/y", -50);
  set("coor/z", 0);

  setup();
}
