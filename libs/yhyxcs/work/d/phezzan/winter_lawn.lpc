//Modified by xyc
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "冬馆前庭");
  set("long", @LONG
朴素的红色石板路一直向西延伸，小路的两侧种有冬馆特有的树
种----冬青树。剪的极为整齐一大片草坪似乎还挂着水气，显得郁郁
葱葱，几棵高大冬青树的掩映下，隐约可以见到冬馆白色建筑东面的
几扇窗户。
LONG
  );

  set("globe", "phezzan");

  set("item_desc", ([
    "草坪": "每天都要修剪浇灌的草坪，北边就是冬馆建筑的东侧。\n",
    "caoping": "每天都要修剪浇灌的草坪，北边就是冬馆建筑的东侧。\n",
    "lawn": "每天都要修剪浇灌的草坪，北边就是冬馆建筑的东侧。\n",
  ]));

  set("exits", ([
    "west": __DIR__ "winter_garden",
    "east": __DIR__ "winter_gate",
  ]));

  create_door("east", "铁门", "west", 1);

  set("objects", ([
    __DIR__ "npc/secret_monk": 1,
  ]));

  set("coor/x", -30);
  set("coor/y", 60);
  set("coor/z", 0);

  setup();
}

void init() {
  add_action("do_cross", "cross");
}

int do_cross(string arg) {
  object me;
  object room;

  if (!arg)
    return 0;
  if ((arg != "草坪") && (arg != "caoping") && (arg != "lawn"))
    return 0;
  me = this_player();
  message_vision("$N穿过草坪，向北边走去。\n", me);

  room = load_object(__DIR__ "winter_n_lawn");
  if (room) me->move(room);

  return 1;
}
