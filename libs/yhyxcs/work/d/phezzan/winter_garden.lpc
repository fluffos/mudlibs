#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "冬馆花园");
  set("long", @LONG
各式各样的鲜花散发着芳香，从这里可以看到北面冬馆的白色主
建筑，向东连接着冬馆的出口。
LONG
  );

  set("globe", "phezzan");

  set("exits", ([
    "east": __DIR__ "winter_lawn",
    //		"south" : __DIR__"wintergate",
    "north": __DIR__ "winter_hall",
  ]));

  set("coor/x", -50);
  set("coor/y", 60);
  set("coor/z", 0);

  setup();
}
