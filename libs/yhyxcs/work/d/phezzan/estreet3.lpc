#include <ansi.h>

inherit ROOM;

void create() {
  set("short", GRN "东费沙大道" NOR);
  set("long", @LONG
费沙人勤劳、智慧。行星费沙能有今天这样一派自由、和平、繁
荣的景象，除了得益于此之外，更应该感谢不卑不亢的“中立政策”。
这里北面矗立着高大的输电塔，是费沙供电中心。再往东、往南就是
郊外了，是费沙行星上最原始荒凉的地方。
LONG
  );

  set("globe", "phezzan");

  set("exits", ([
    "west": __DIR__ "estreet2",
    "north": __DIR__ "e_center",
    "southeast": __DIR__ "east_suburb",
  ]));

  set("walk_bonus", 5);

  set("coor/x", 80);
  set("coor/y", 0);
  set("coor/z", 0);

  setup();
}
