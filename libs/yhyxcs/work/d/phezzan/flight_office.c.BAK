inherit ROOM;
inherit F_VOYAGE;

void create()
{
	set("short", "民用航班预定处");
	set("long", @LONG
这里是民用航班预定处，数个窗口都在昼夜不停的办理着星系间
旅行的业务。一阵阵呼啸声中，数个商船队正在起飞，数百艘尾部喷射
着淡蓝色火光的运输艇整齐的向外太空远去。费沙的确是银河系最富有
的星球，只有他们才有如此规模比军队还宏大的商船队。
LONG
	);

	set("globe","phezzan");

	set("exits", ([
		"north" : __DIR__"starport",
	]) );

	set("objects", ([
		__DIR__"npc/lady" : 1,
	]) );

	set("voyage", ([
		"odin" : 200,
		"heinessen" : 200,
		"iserlohn" : 400,
	]) );

	set("coor/x",0);
	set("coor/y",-310);
	set("coor/z",0);

	setup();
}

void init()
{
	add_action("do_voyage","voyage");
}
