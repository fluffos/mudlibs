//Modified by xyc
#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "冬馆北草坪");
        set("long", @LONG
这里是冬馆主建筑的东侧，环绕著这座大别墅种植的冬青树又高
又大，配上厚厚的绿草坪，很有古式欧洲园林的味道，别墅的石墙粗
糙坚硬，二楼的几扇窗户被浓密的树叶遮蔽着。
LONG
	);

	set("item_desc", ([
		"冬青树":"一排高大的冬青树，其中一棵的枝叶几乎能够碰到了二楼的一扇窗户。\n",
		"tree":"一排高大的冬青树，其中一棵的枝叶几乎能够碰到了二楼的一扇窗户。\n",
		"shu":"一排高大的冬青树，其中一棵的枝叶几乎能够碰到了二楼的一扇窗户。\n",
		"dongqingshu":"一排高大的冬青树，其中一棵的枝叶几乎能够碰到了二楼的一扇窗户。\n",
	]) );

	set("exits", ([
		"south" : __DIR__"winter_n_lawn",
		"north" : __DIR__"winter_i_lawn",
	]));

	set("globe","phezzan");

	set("coor/x",-30);
	set("coor/y",90);
	set("coor/z",0);

	setup();
}

void init()
{
	add_action("do_climb","climb");
}

int do_climb(string arg)
{
	object me, room, ladder;

	if( !arg ) return 0;

	me = this_player();
	if( objectp( ladder = present("ladder",me) )
		&& ( ladder->name() == "合金梯" ) )
	{
		if( ( arg == "石墙" ) || ( arg == "墙" ) || ( arg == "wall" ) || ( arg == "qiang" ) )
		{
			message_vision("$N架起一部野战用合金梯，迅速向上爬去。\n", me);
			ladder->move(this_object());
			room = load_object(__DIR__"winter_bedroom");
			if( room ) me->move(room);
			message_vision("只见$N从窗户外一跃而入，跳到了屋子里！\n", me);
			return 1;
		}
	}

	if( ( arg != "冬青树" ) && ( arg != "tree" ) && ( arg != "shu" ) && ( arg != "dongqingshu" ) )
		return 0;

        message_vision("$N手脚并用，向一棵高大的冬青树上爬去。\n", me);

	room = load_object(__DIR__"winter_treetop");
	if( room ) me->move(room);

	return 1;
}
