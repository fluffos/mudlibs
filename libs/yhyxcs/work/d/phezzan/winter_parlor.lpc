#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "冬馆客厅");
  set("long", @LONG
紧凑的大理石色块拼接而成的地板，使整个客厅显得富有生气。
方桌与两张对面摆放的沙发都是木制结构的，色调凝重。由北面窗子
射进来的光线经由纱帘遮挡，使客厅的亮度柔和适中。
LONG
  );

  set("exits", ([
    "east": __DIR__ "e_gallery",
    "west": __DIR__ "w_gallery",
    "southdown": __DIR__ "winter_hall",
  ]));

  set("coor/x", -50);
  set("coor/y", 80);
  set("coor/z", 20);

  set("globe", "phezzan");

  setup();
}
