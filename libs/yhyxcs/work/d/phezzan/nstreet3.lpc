//Modified by xyc
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", GRN "费沙北街" NOR);
  set("long", @LONG
淡粉色的喷池与领主府的浅灰色台阶紧紧相连，艺术地溶为一体。
震耳欲聋的轰鸣声随嘻笑声似已远去，游客、行人渐渐稀少，大多在
往回走了。领主府就在眼前。古希腊风格的大理石建筑，似乎在诉说
着什么。高大虽不及预想，但隐隐一股森然的气势却不能不使人不寒
而栗。
LONG
  );

  set("globe", "phezzan");

  set("exits", ([
    "south": __DIR__ "nstreet2",
    "north": __DIR__ "maingov",
  ]));

  set("objects", ([
    __DIR__ "npc/maingov_guard": 2,
  ]));

  set("coor/x", 0);
  set("coor/y", 90);
  set("coor/z", 0);

  setup();
}

int valid_leave(object me, string dir) {
  object *inv;
  object ob;
  int i, check = 0;

  if (userp(me)) {
    if (dir == "north" && ob = present("guard", this_object())) {
      tell_object(me, CYN + ob->name() + "立正站好，向你行了一个标准的军礼。\n" NOR);
      if (me->query_space("vassalage") != "费沙") {
        inv = all_inventory(me);
        for (i = 0; i < sizeof(inv); i++) {
          if ((inv[i]->name() == "帝国军服")
            && (inv[i]->query("equipped")))
            check = 1;
          if ((inv[i]->name() == "同盟军服")
            && (inv[i]->query("equipped")))
            check = 1;
          if ((inv[i]->name() == "费沙军服")
            && (inv[i]->query("equipped")))
            check = 2;
        }
        if (!check)
          return notify_fail(CYN + ob->name() + "说道：非官方人员不得进入自治领主府，请留步。\n" NOR);

        if ((check == 1) && (!me->query_temp("invented_by_phezzan")))
          return notify_fail(CYN + ob->name() + "说道：您欲进入自制领主府有何公干？\n" NOR);
      }
      for (i = 0; i < sizeof(inv); i++) {
        if (mapp(inv[i]->query("weapon_prop")))
          return notify_fail(CYN + ob->name() + "说道：您不可以携带任何武器及爆炸品进入自制领主府！\n" NOR);
      }
    }
    return 1;
  }
  return 1;
}
