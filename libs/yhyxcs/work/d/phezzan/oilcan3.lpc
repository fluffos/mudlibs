//Modified by xyc
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "贮油罐深处");
  set("long", @LONG
这里是费沙最大的贮油库，周围都是巨大的圆柱型贮油罐，让人
无法辨清方向，如同置身莽林。这里是费沙的战略物资贮存区，据说
里面有难以数计的维护建筑，但是周围的油罐挡住了视线，竟然是什
么也看不到。
LONG
  );

  set("globe", "phezzan");

  set("exits", ([
    "east": __DIR__ "oilcan0",
    "south": __DIR__ "oilcan4",
    "west": __DIR__ "oilcan2",
    "north": __DIR__ "oilcan1",
  ]));

  set("coor/x", -100 - random(10));
  set("coor/y", random(10) + 10);
  set("coor/z", 0);

  set("walk_bonus", 5);

  setup();
}

void init() {
  add_action("do_poweron", "poweron");
}

int do_poweron() {
  object me, blinker;
  string *dir;
  string leave_dir;

  me = this_player();
  if (!objectp(blinker = present("blinker", me)))
    return 0;
  if (blinker->query("usage") < 1)
    return notify_fail("没有电的信号灯应该是没有什么用处的。\n");

  message_vision("$N打开了手里的信号灯，让它闪了几下，也不知道要给谁发信号。\n", me);

  dir = ({ "north", "south", "west", });
  leave_dir = dir[random(3)];
  set("leave_dir", leave_dir);
  me->set_temp("leave_dir", leave_dir);
  tell_object(me, "你看到贮油罐区域" + to_chinese(leave_dir) + "面也有信号灯闪动了几下。\n");

  return 1;
}

int valid_leave(object me, string dir) {
  object room;

  if (userp(me)) {
    if (stringp(query("leave_dir"))
      && (dir == query("leave_dir"))
      && (query("leave_dir") == me->query_temp("leave_dir"))) {
      if (me->query_temp("already_gone") > 9)
        room = load_object(__DIR__ "oilcan5.lpc");
      else room = load_object(__DIR__ "oilcan" + sprintf("%d", random(5)) + ".lpc");
      message_vision("$N向贮油罐区域深处走去。\n", me);
      me->move(room);
      me->add_temp("already_gone", 1);
      this_object()->delete("leave_dir");
      return notify_fail("correct!\n");
    }
    me->delete_temp("already_gone");
    return 1;
  }
  return 1;
}
