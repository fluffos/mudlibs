#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "帝国高等事务官邸大厅");
  set("long", @LONG
朴素的大厅中并没有什么多余的摆设。当然，作为形式上的必须，
必要的装潢还是应有尽有。不算高的天花板上，一具华丽典雅的吊灯
从巨大的帝国金色双头鹫军徽中间垂挂下来。四壁则是用来诉说近五
世纪辉煌的彩色壁画。前面是瑞姆夏德伯爵办公室，左右则是驻在武
官和文化参赞的居室。
LONG
  );

  set("globe", "phezzan");

  set("exits", ([
    "west": __DIR__ "empire_wuguan",
    "east": __DIR__ "empire_wenguan",
    "north": __DIR__ "empire_study",
    "south": __DIR__ "empire_embassy",
  ]));

  create_door("south", "原木大门", "north", 1);

  set("coor/x", 40);
  set("coor/y", 20);
  set("coor/z", 0);

  //	set("objects", ([
  //	__DIR__"npc/bookseller" : 1,
  //	]) );

  setup();
}
