//Modified by xyc
#include <ansi.h>

inherit ROOM;

void close_path();
void player_win();

void create() {
  set("short", "领主办公室");
  set("long", @LONG
这里是费沙历任领主办公的地方。鲁宾斯基是个享乐主义者，办
公室的摆设也是尽可能的豪华。屋内墙壁由造形优美的特殊玻璃构成，
使整个屋内似乎泛着一层微绿的空气一般，显得格外宁静。在不大的
办公桌前，是一架电脑兵棋台。东面的一扇小门里是领主的寝房。
LONG
  );
  set("globe", "phezzan");

  set("item_desc", ([
    "墙壁": "那是由造形优美的特殊玻璃构成的。\n",
    "wall": "那是由造形优美的特殊玻璃构成的。\n",
    "兵棋台": "一架很常见的兵棋台，上面还摆着一附残局。\n",
    "兵棋": "一架很常见的兵棋台，上面还摆着一附残局。\n",
    "bingqi": "一架很常见的兵棋台，上面还摆着一附残局。\n",
    "chess": "一架很常见的兵棋台，上面还摆着一附残局。\n",
  ]));

  set("exits", ([
    "east": __DIR__ "bedroom",
    "south": __DIR__ "maingov_aisle",
  ]));

  //	set("objects", ([__DIR__"npc/blackfox" : 1,]) );
  set("coor/x", 0);
  set("coor/y", 180);
  set("coor/z", 0);

  setup();
}


void init() {
  add_action("do_play", "play");
}

int do_play(string arg) {
  object me;

  if (!arg) return 0;
  if ((arg != "兵棋台") && (arg != "兵棋") && (arg != "bingqi") && (arg != "chess"))
    return 0;

  me = this_player();
  message_vision("$N站在电脑兵棋台前认真的看着上面的残局。\n", me);
  if (random(me->query_int()) > 15) {
    message_vision("经过片刻思索，$N踌躇满志的移动了一个棋子，叫到：将！\n", me);
    call_out("player_win", 30);
    return 1;
  }
  message_vision(HIR "结果$N刚刚一移动棋台上的棋子，屋子里就响起了凄厉的警报声！\n" NOR, me);
  //	write("其实应该打起来了。\n");
  return 1;
}

void close_path() {
  if (!query("exits/down")) return;

  message("vision", "办公桌“咯吱吱”的响着，掩住了地下通道。\n", this_object());
  delete("exits/down");
}

void player_win() {
  if (query("exits/down")) return;
  message("vision", "办公桌忽然发出“咯吱吱”的响声向后退去，一个地下通道显露了出来！\n", this_object());
  set("exits/down", __DIR__ "maingov_tvroom");
  call_out("close_path", 5);
}
