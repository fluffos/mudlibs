#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "阁楼");
	set("long", @LONG
低矮的阁楼，却打扫得干干净净。阁楼里到处堆放着大小不同、
各式各样的箱子。小得可怜的玄窗透进微弱的光亮，照射在木板
上。
*****************************************************
武器库
秘密：
1，打开箱子可以得到气爆枪(lasergun)、杰夫粒子炸弹(jefbomb)
	当然要费点劲。
2，get all from 木板，可以得到挂在上面的绳梯，方能下去
	(上来时的梯子会被人拿走)
*****************************************************
LONG
	);

	set("globe","phezzan");

	set("exits", ([
		"down" : __DIR__"earth_info",
	]));

	setup();
}