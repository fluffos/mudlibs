//Modified by xyc
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "自由行星同盟驻在武官官邸");
  set("long", @LONG
由于费沙至少在形式上隶属于银河帝国，相应的，对于同盟的驻
在官邸，当然在外观上要含蓄一些。玄关只是从门右手边的铭牌才能
知道这里是同盟的官方建筑。
LONG
  );

  set("globe", "phezzan");

  set("exits", ([
    "north": __DIR__ "alliance_office",
    "south": __DIR__ "wstreet2",
  ]));

  set("objects", ([
    __DIR__ "npc/alliance_guard": 2,
  ]));

  set("coor/x", -60);
  set("coor/y", 20);
  set("coor/z", 0);

  setup();
}


int valid_leave(object me, string dir) {
  object *inv;
  object ob;
  int i, check = 0;

  if (userp(me)) {
    if (dir == "north" && ob = present("guard", this_object())) {
      tell_object(me, CYN + ob->name() + "立正站好，向你行了一个标准的军礼。\n" NOR);
      if (me->query_space("vassalage") != "同盟") {
        inv = all_inventory(me);
        for (i = 0; i < sizeof(inv); i++) {
          if ((inv[i]->name() == "帝国军服")
            && (inv[i]->query("equipped")))
            check = 1;
          if ((inv[i]->name() == "同盟军服")
            && (inv[i]->query("equipped")))
            check = 3;
          if ((inv[i]->name() == "费沙军服")
            && (inv[i]->query("equipped")))
            check = 2;
        }
        if (!check)
          return notify_fail(CYN + ob->name() + "说道：非官方人员不得进入本领事馆，请留步。\n" NOR);

        if (check == 1)
          return notify_fail(CYN + ob->name() + "说道：两国交战，恕本领事馆不予接待，请回吧。\n" NOR);
        if ((check == 2) && (!me->query_temp("invented_by_alliance")))
          return notify_fail(CYN + ob->name() + "说道：您欲进入本领事馆有何公干？\n" NOR);
      }
      for (i = 0; i < sizeof(inv); i++) {
        if (mapp(inv[i]->query("weapon_prop")))
          return notify_fail(CYN + ob->name() + "说道：您不可以携带任何武器及爆炸品进入本领事馆！\n" NOR);
      }
    }
    return 1;
  }
  return 1;
}
