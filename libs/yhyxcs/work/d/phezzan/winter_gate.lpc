#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "冬馆玄关");
  set("long", @LONG
冬馆名称的由来是种植于门两侧的冬青树，以及在玄关的门上刻
着的冬青树徽章。整个建筑遵循着朴实而不失高贵的日耳曼风格，但
是比起帝都奥丁的任何一处官邸，这里最多也只能算是一处较高档次
的别馆罢了。
LONG
  );

  set("globe", "phezzan");

  set("exits", ([
    "west": __DIR__ "winter_lawn",
    "east": __DIR__ "nstreet2",
  ]));

  create_door("west", "铁门", "east", 1);

  set("coor/x", -20);
  set("coor/y", 60);
  set("coor/z", 0);

  setup();
}
