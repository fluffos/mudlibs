#include <ansi.h>

inherit ROOM;

void create()
{
	set("short","德川书店");
	set("long", @LONG
宽敞明亮的的书店大厅，各种图书、电子版、影碟整齐的摆放在
四周及中间的书架上。这里不但供应同盟、帝国的畅销书，更有趣的
是还有大批双方列为的禁书有售。大量的人群在这里从不是罕有的现
象。
LONG
	);

	set("globe","phezzan");

	set("exits", ([
		"south" : __DIR__"wstreet1",
	]));

	set("objects", ([
		__DIR__"npc/bookseller" : 1,
	]) );

	set("coor/x",-40);
	set("coor/y",20);
	set("coor/z",0);

