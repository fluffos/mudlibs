#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "费沙西郊");
  set("long", @LONG
荒凉的美。自从费沙在三百五十年前，由出身于地球的钜商雷欧
波特·拉普透过请愿、游说和巨额的贿赂成立之后，这里就是这个样
子。恶劣的自然气候以及水资源的缺乏是这里得不到发展的原因。
LONG
  );

  set("globe", "phezzan");

  set("exits", ([
    "west": __DIR__ "west_desert",
    "northeast": __DIR__ "wstreet3",
  ]));

  set("coor/x", -100);
  set("coor/y", -50);
  set("coor/z", 0);

  setup();
}
