#include <ansi.h>

inherit ROOM;

void create() {
  set("short", GRN "费沙北街" NOR);
  set("long", @LONG
朴实的小块混凝土地板，砖缝间兹出了嫩草，连这儿的每片青苔
都会令人心情舒畅；走不多远便能见到一对对普通的石凳。眼前成双
成对的情侣们把这里当成了最好的约会场所，偶尔传入耳际的片语情
话更使一草一木都变得楚楚动人。粉红的花岗岩水池仍在向北延伸。
LONG
  );

  set("globe", "phezzan");

  set("exits", ([
    "south": __DIR__ "nstreet",
    "north": __DIR__ "nstreet2",
  ]));

  set("objects", ([
    __DIR__ "npc/goer": 1,
  ]));

  set("coor/x", 0);
  set("coor/y", 40);
  set("coor/z", 0);

  setup();
}
