//Modified by xyc
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "冬馆卧房");
  set("long", @LONG
这里便是这栋别馆主人的卧室。淡红色帷幕笼罩着室内唯一的陈
设----一张也同为硬木制的双人床。墨绿色的地毯踩上去轻松而柔软，
壁炉在房间的另一边，装饰也比较朴实。引人注目的倒是东面的那扇
巨大窗子，窗下有一张木制躺椅。
LONG
  );

  set("exits", ([
    "west": __DIR__ "e_gallery1",
  ]));

  set("globe", "phezzan");

  set("objects", ([
    __DIR__ "obj/carpet": 1,
  ]));

  set("coor/x", -35);
  set("coor/y", 85);
  set("coor/z", 20);

  setup();
}

void reset() {
  object *inv;
  object con, epaulet;

  ::reset();
  con = present("carpet", this_object());
  inv = all_inventory(con);
  if (!sizeof(inv) && !random(10)) {
    epaulet = new("/obj/cloth/epaulet");
    epaulet->set("name", "费沙上校肩章");
    epaulet->set("no_drop", 0);
    epaulet->set("long", "费沙上校肩章的长描述。\n");
    epaulet->move(con);
  }
}
