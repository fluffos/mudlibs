#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "贝伦卡斯提尔旅馆");
  set("long", @LONG
贝伦卡斯提尔旅馆是专为接待同盟或帝国的长途旅客而由政府特
意修建的。在帝国政变平复后，许多贵族后裔适应不了待遇的陡然下
降，纷纷来到费沙。在这里就经常能够看到一些神气非凡的流亡者。
LONG
  );

  set("globe", "phezzan");

  set("exits", ([
    "east": __DIR__ "hotelstreet2",
  ]));

  set("objects", ([
    __DIR__ "npc/emigre": 1,
    __DIR__ "npc/noble": 1,
  ]));

  set("coor/x", -60);
  set("coor/y", -60);
  set("coor/z", 0);

  setup();
}
