#include <ansi.h>

inherit ROOM;

void create()
{
	set("short",GRN"西费沙大道"NOR);
	set("long", @LONG
西费沙大道可以说是这个行星的富人区。宾馆、别馆、饭店比比
皆是。南面是菲亚巴尔特街。北面是德川书店。
LONG
	);

	set("globe","phezzan");

	set("exits", ([
		"east" : __DIR__"wstreet",
		"south" : __DIR__"hotelstreet",
		"west" : __DIR__"wstreet2",
		"north" : __DIR__"bookstore",
	]));

	set("coor/x",-40);
	set("coor/y",0);
	set("coor/z",0);

	set("walk_bonus",5);

	setup();
}
