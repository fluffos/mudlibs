#include <ansi.h>

inherit ROOM;
inherit F_STARPORT;

void messaging();

void create() {
  set("short", "费沙中央宇宙港");
  set("long", @LONG
这里是费沙的航空港，专为大型商船队提供起降和给养服务。以
其庞大的规模来看，负担帝国、同盟舰队的总合仍是富富有余。诺大
的玻璃钢圆顶外是帷幕一般的苍穹，五公里外的起降平原上密密麻麻
的排满了航班。东面是宇宙港给养服务中心，西面是酒吧朵拉库尔，
南面是民用航班预定处，而向北离开宇宙港则是笔直通向费沙市中心
的高速路。
LONG
  );

  set("valid_startroom", 1);
  set("globe", "phezzan");

  set("exits", ([
    "east": __DIR__ "supply_office",
    "west": __DIR__ "duolacool",
    "south": __DIR__ "flight_office",
    "north": __DIR__ "highway",
  ]));

  set("objects", ([
    //		__DIR__"npc/boltic" : 1,
    //		__DIR__"npc/blackfox" : 1,
    //		__DIR__"npc/fuguan" : 1,
  ]));

  set("coor/x", 0);
  set("coor/y", -300);
  set("coor/z", 0);

  messaging();
  setup();
}

void init() {
  add_action("do_geton", "geton");
}

void messaging() {
  switch (random(3)) {
    case 0:
      message("vision", CYN "大厅的广播中的女声在耳边响起：" +
        "“请各位搭乘舰船的士官迅速登舰。。。”\n" NOR, this_object());
      break;
    case 1:
      message("vision", CYN "略显嘈杂的人群中任然可以清晰的听到播音小姐甜美的嗓音：“" +
        sprintf("%d", random(600)) + "次\n商用航班马上就要起飞了，" +
        "请乘客迅速登舰。。。”\n" NOR, this_object());
      break;
    case 2:
      message("vision", CYN "空港广播中心似乎正在催促舰队完成高效的起降作业：“请司令官从" +
        "\nＡ通道前往（ＧＥＴＯＮ）旗舰。。。”\n" NOR, this_object());
      break;
  }
  call_out("messaging", 500);
}
