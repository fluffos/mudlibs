//Modified by xyc
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "费沙供电中心");
  set("long", @LONG
远远就能看见高大林立的输电塔。费沙的许多重要设施的能源供
应都源自这里。供电分为地上的输电线和地下的输电管道，密如蛛网
一般。里面就是市民的禁区--配电管制操作间。
LONG
  );

  set("globe", "phezzan");

  set("exits", ([
    "north": __DIR__ "workroom",
    "south": __DIR__ "estreet3",
  ]));

  set("objects", ([
    __DIR__ "npc/guard": 2,
  ]));

  set("coor/x", 80);
  set("coor/y", 20);
  set("coor/z", 0);

  setup();
}

int valid_leave(object me, string dir) {
  object *inv;
  object ob, uniform, epaulet;
  int i, check = 0;
  if (userp(me)) {
    if (dir == "north" && ob = present("guard", this_object())) {
      if (me->query_space("vassalage") == "费沙") {
        tell_object(me, CYN + ob->name() + "立正站好，向你行了一个标准的军礼。\n" NOR);

        if (me->query("rank") < 5)
          return notify_fail(CYN + ob->name() + "说道：我的上司不允许我放行您这个官阶的人员。\n" NOR);
      } else {
        inv = all_inventory(me);
        for (i = 0; i < sizeof(inv); i++) {
          if ((inv[i]->name() == "费沙军服")
            && (inv[i]->query("equipped")))
            check = 1;
          switch (inv[i]->name()) {
            case "费沙少校肩章":
              if (inv[i]->query("equipped") && check)
                check = 2;
              break;
            case "费沙中校肩章":
              if (inv[i]->query("equipped") && check)
                check = 2;
              break;
            case "费沙上校肩章":
              if (inv[i]->query("equipped") && check)
                check = 2;
              break;
            case "费沙准将肩章":
              if (inv[i]->query("equipped") && check)
                check = 2;
              break;
            case "费沙少将肩章":
              if (inv[i]->query("equipped") && check)
                check = 2;
              break;
            case "费沙中将肩章":
              if (inv[i]->query("equipped") && check)
                check = 2;
              break;
            case "费沙上将肩章":
              if (inv[i]->query("equipped") && check)
                check = 2;
              break;
            case "费沙元帅肩章":
              if (inv[i]->query("equipped") && check)
                check = 2;
              break;
          }
        }
        if (!check)
          return notify_fail(CYN + ob->name() + "说道：非费沙自治领军方人员不得进入供电中心！\n" NOR);

        tell_object(me, CYN + ob->name() + "立正站好，向你行了一个标准的军礼。\n" NOR);

        if (check == 1)
          return notify_fail(CYN + ob->name() + "说道：我的上司不允许我放行您这个官阶的人员。\n" NOR);
      }
      for (i = 0; i < sizeof(inv); i++) {
        if (mapp(inv[i]->query("weapon_prop")))
          return notify_fail(CYN + ob->name() + "说道：您不可以携带任何武器及爆炸品进入供电中心！\n" NOR);
      }
    }
    return 1;
  }
  return 1;
}
