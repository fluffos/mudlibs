#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "别墅客厅");
  set("long", @LONG
墙壁醒目的地方挂着几张银河帝国皇帝鲁道夫的油彩画像，客厅
的布置异常简洁。没有往常司空见惯的吧台，只有一张勉强能被称作
“茶几”的小桌。随风飘动的窗帘使室内的光线总是在随时的变化中。
LONG
  );

  set("exits", ([
    "south": __DIR__ "shore_veranda",
    "west": __DIR__ "shore_bedroom",
    "southdown": __DIR__ "shore_villa",
  ]));

  set("globe", "phezzan");
  setup();
}
