//Modified by xyc
#include <ansi.h>

inherit ROOM;

void restore_power();

void create() {
  set("short", "领主府卧室");
  set("long", @LONG
虽然鲁宾斯基并不常在这里过夜，但这除了是继承自先人的遗产
外，也是形式上的必须。柔软而暗色调的地毯，高挑帘幕的金属双人
床。窗帘始终拉上，由室内的暗黄色水银灯提供光源。整个房间恬静
而舒适。
LONG
  );


  set("exits", ([
    "west": __DIR__ "lord_office",
  ]));

  set("coor/x", 10);
  set("coor/y", 180);
  set("coor/z", 0);

  set("globe", "phezzan");
  setup();
}

void init() {
  add_action("do_turnoff", "turnoff");
  add_action("do_sleep", "sleep");
}

int do_turnoff(string arg) {
  object me;

  if (!arg) return notify_fail("你要关闭什麽？\n");
  if ((arg != "灯") && (arg != "水银灯") && (arg != "lamp") && (arg != "light") && (arg != "deng"))
    return notify_fail("你要关闭什麽？\n");

  if (query("already_turn_off"))
    return notify_fail("水银灯已经是关着的了。\n");
  set("already_turn_off", 1);
  message_vision("$N找到了水银灯的开关按了一下。\n整个屋子瞬间暗了下来，突如其来的漆黑让人难以使应。\n",
    this_player());
  call_out("restore_power", 3);
  return 1;
}

void restore_power() {
  if (!query("already_turn_off")) return;

  message("vision", "水银灯忽然嗡嗡的响着，又亮了起来。\n", this_object());
  delete("already_turn_off");
}

int do_sleep(string arg) {
  object me, room;

  if (!query("already_turn_off")) return 0;
  if (!arg) return 0;
  if ((arg != "床") && (arg != "双人床") && (arg != "bed") && (arg != "chuang"))
    return 0;

  me = this_player();
  room = load_object(__DIR__ "maingov_vault.lpc");

  tell_object(me, "你在漆黑中摸索着向床上躺去。\n");
  message("vision", "房间里忽然传出轻微的轮轴转动的声音。\n", this_object());

  if (objectp(room)) {
    tell_object(me, "你忽然觉的身下一空，不由自主的向下滑去！\n");
    if (me->move(room)) {
      message("vision", "有人被领主府卧房床上的翻板送了下来。\n", this_object(), ({ me }));
      return 1;
    }
  }
  return 0;
}
