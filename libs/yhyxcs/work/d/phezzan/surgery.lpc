//Modified by xyc
#include <ansi.h>

inherit ROOM;

void curehimup(object me);

void create()
{
	set("short", "附属医院外科");
	set("long", @LONG
医院的外科诊室，房间里有着医院所必然的整洁而明亮。对面墙
上挂着的现代时钟显示着医院的节奏感。正中摆这一张密舱床，靠近
窗边的写字台上堆放着各种诊断证明、处方和透视照片。
LONG
	);
	set("item_desc", ([
		"密舱床":"密舱床具就是在轻型塑胶制的密闭水槽内放约三十公分满的浓盐水，
水温保持在三十二℃。躺在里面(ＣＵＲＥ)，与外界的色彩、光热、
音响完全隔离。在里面泡上一个小时，效果相当于熟睡八小时。\n",
		"bed":"密舱床具就是在轻型塑胶制的密闭水槽内放约三十公分满的浓盐水，
水温保持在三十二℃。躺在里面(ＣＵＲＥ)，与外界的色彩、光热、
音响完全隔离。在里面泡上一个小时，效果相当于熟睡八小时。\n",
		"micangchuang":"密舱床具就是在轻型塑胶制的密闭水槽内放约三十公分满的浓盐水，
水温保持在三十二℃。躺在里面(ＣＵＲＥ)，与外界的色彩、光热、
音响完全隔离。在里面泡上一个小时，效果相当于熟睡八小时。\n",
	]) );

	set("globe","phezzan");

	set("exits", ([
		"west" : __DIR__"hospital",
	]));

	set("coor/x",-50);
	set("coor/y",-20);
	set("coor/z",0);

	setup();
}

void init()
{
	add_action("do_cure", "cure");

}

int do_cure()
{
	object me, *inv;
	int wait, i;

	if( query("already_in_use") )
		return notify_fail("密舱床已经在使用中了，请等等吧。\n");
	me = this_player();

	inv = all_inventory(me);
	for(i=0;i<sizeof(inv);i++)
	{
		if( inv[i]->name() == "ＩＤ卡" )
		{
			if( !inv[i]->query("owner_name") && !inv[i]->query("owner_id") )
			{
				write(CYN"似乎你的ＩＤ卡有问题，密舱床的卡机拒绝接收。\n"NOR);
				return 1;
			}
			if( inv[i]->query("owner_name") != me->name() )
			{
				write(CYN"似乎你的ＩＤ卡有问题，密舱床的卡机拒绝接收。\n"NOR);
				return 1;
			}
			if( inv[i]->query("owner_id") != me->query("id") )
			{
				me->set("next_trade_time", time()+ 3600 );
				destruct(inv[i]);
				write(CYN"密舱床的卡机将你的假ＩＤ卡吞掉了。\n"NOR);
				write("由于你的假ＩＤ卡被发现了，所以银行冻结了你的帐户！\n");
				return 1;
			}
			if( me->query("next_trade_time") > time() )
			{
				write(CYN"你的银行帐户仍在冻结状态，密舱床的卡机拒绝接收。\n"NOR);
				return 1;
			}
			if( me->query("id_card") < 1000 )
			{
				write(CYN"密舱床的卡机提示你的卡上并没有足够的金额支付服务费用。\n"NOR);
				return 1;
			}
			me->add("id_card",-1000);
			inv[i]->set("left_money",me->query("id_card"));

			wait = random( 40 - (int)me->query("con")) * 2;

			if ( wait <= 20) wait = 21;
			message_vision("$N欠身躺到了密舱床中。。。\n",me);
			tell_object(me,"密舱床中静谥舒适，你感觉非常好。\n");

			remove_call_out("curehimup");
			call_out("curehimup", wait, me);
			set("already_in_use",1);
			return 1;
		}
	}
	write("你的ＩＤ卡呢？\n");

	return 1;
}

void curehimup(object me)
{
	int gin,kee,sen;

	delete("already_in_use");
	if(!me) return;
	gin=(int)me->query("max_gin");
	kee=(int)me->query("max_kee");
	sen=(int)me->query("max_sen");
	if( me && environment(me) == this_object())
	{
	message_vision("$N的身心疲劳全恢复了！！\n", me);
	me->set("eff_gin",gin);
	me->set("eff_kee",kee);
	me->set("eff_sen",sen);
	me->set("gin", gin);
	me->set("kee", kee);
	me->set("sen", sen);
	}
	return;
}
