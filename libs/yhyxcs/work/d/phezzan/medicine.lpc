LONG
	);

	set("globe","phezzan");

	set("item_desc", ([
		"病床":"其中一张病床非常宽大，似乎是为特别肥胖的人准备的。\n",
		"bed":"其中一张病床非常宽大，似乎是为特别肥胖的人准备的。\n",
		"chuang":"其中一张病床非常宽大，似乎是为特别肥胖的人准备的。\n",
		"bingchuang":"其中一张病床非常宽大，似乎是为特别肥胖的人准备的。\n",
	]) );

	set("exits", ([
		"east" : __DIR__"hospital",
	]));

