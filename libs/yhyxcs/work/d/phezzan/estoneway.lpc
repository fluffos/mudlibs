#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "青石小路");
        set("long", @LONG
左手边是象牙白色的别墅，右手边则是一片丛林。一条似断似续
的明媚的青石小路蜿蜒在低矮茂密的灌木丛中，上面青苔遍布，看来
已经长时间没有人从这里经过了。穿过密林的道道阳光和前面别墅玄
窗的反射，使前面的青砖依稀可见。
LONG
	);

	set("exits", ([
		"west" : __DIR__"secrethouse",
		"north" : __DIR__"estoneway1",
	]));

	set("globe","phezzan");
	setup();
}
