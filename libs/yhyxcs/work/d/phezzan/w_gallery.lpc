#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "西走廊");
  set("long", @LONG
木制结构的回廊地板，走上去发出木板轻微摩擦的声音。从这里
可以俯瞰一楼大厅。外侧的扶手也是暗色调硬制木料，显得朴实无华。
LONG
  );

  set("exits", ([
    "east": __DIR__ "winter_parlor",
    "north": __DIR__ "w_gallery1",
  ]));

  set("coor/x", -60);
  set("coor/y", 80);
  set("coor/z", 20);

  set("globe", "phezzan");

  setup();
}
