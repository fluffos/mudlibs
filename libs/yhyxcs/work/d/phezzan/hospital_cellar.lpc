//Modified by xyc
#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "附属医院地下室");
	set("long", @LONG
这里是费沙附属医院的地下室，大概是专门堆放垃圾的，里面又
脏又乱，靠近里面散乱的放着几个垃圾筒，里面传出刺鼻的消毒水味
道，这种地方还是不要久留的好。
LONG
	);

	set("globe","phezzan");

	set("exits", ([
		"up" : __DIR__"x_ray_room",
	]));

	set("objects", ([
		__DIR__"obj/canister" : 1,
	]) );

	set("coor/x",-60);
	set("coor/y",-30);
	set("coor/z",-10);

	setup();
}

void reset()
{
	object *inv;
	object con, item;

	::reset();
	con = present("canister", this_object());
        inv = all_inventory(con);
        if( !sizeof(inv) && !random(3) )
	{
		item = new("/obj/cloth/uniform_a");
		item->set("long","一件肥大的破烂的同盟军服，无论谁穿上都会觉得大。\n");
		item->set("no_drop",0);
		item->move(con);
	}
}
