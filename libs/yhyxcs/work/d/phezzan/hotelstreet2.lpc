#include <ansi.h>

inherit ROOM;

void create()
{
	set("short",GRN"菲亚巴尔特街"NOR);
	set("long", @LONG
行人摩肩接踵的菲亚巴尔特街是集饭店、宾馆、旅店等休闲娱乐
设施于一体的地方。这一地段路西是贝伦卡斯提尔旅馆，
LONG
	);

	set("globe","phezzan");

	set("exits", ([
		"east" : __DIR__"travel_station",
		"west" : __DIR__"hotel_blkstr",
		"north" : __DIR__"hotelstreet",
	]));

	set("taxi",([
		__DIR__"highway" : 220,
		__DIR__"square" : 20,
	]) );

	set("coor/x",-40);
	set("coor/y",-60);
	set("coor/z",0);

