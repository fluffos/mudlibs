//Modified by xyc
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "帝国驻在武官办公室");
  set("long", @LONG
这似乎是一个充满了军旗、勋章的战功荣誉室。各类纪念品琳琅
满目地堆放在房间的各个角落，无处不在的双头鹫军徽更是镶印在各
种存在的平面上。办公桌被这些物品严重侵占，几乎看不出它本来的
作用。武官郝晋格男爵已经很长时间没有在这里出现过了。
LONG
  );

  set("globe", "phezzan");

  set("exits", ([
    "east": __DIR__ "empire_hall",
  ]));

  set("objects", ([
    __DIR__ "obj/table": 1,
  ]));

  set("coor/x", 30);
  set("coor/y", 20);
  set("coor/z", 0);

  setup();
}

void reset() {
  object *inv;
  object con, item;

  ::reset();
  con = present("table", this_object());
  inv = all_inventory(con);
  if (!sizeof(inv) && !random(3)) {
    item = new("/obj/cloth/uniform_e");
    item->set("no_drop", 0);
    item->move(con);
  }
}
