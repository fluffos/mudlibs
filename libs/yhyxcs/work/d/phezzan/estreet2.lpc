#include <ansi.h>

inherit ROOM;

void create() {
  set("short", GRN "东费沙大道" NOR);
  set("long", @LONG
宽阔的大道至此豁然开朗，恒星的光芒把两侧高大而宏伟的建筑
群渲染得金光万丈，无比壮观。这里街北是费沙人的骄傲、中立星费
沙真正的心脏，更是全宇宙经济中心的费沙中央银行。南边则是凡到
过费沙的人都必然要去的购物天堂----黄金之都。
LONG
  );

  set("globe", "phezzan");

  set("exits", ([
    "north": __DIR__ "center_bank_s",
    "south": __DIR__ "golden_capital",
    "east": __DIR__ "estreet3",
    "west": __DIR__ "estreet1",
  ]));

  set("walk_bonus", 5);

  set("coor/x", 60);
  set("coor/y", 0);
  set("coor/z", 0);

  setup();
}
