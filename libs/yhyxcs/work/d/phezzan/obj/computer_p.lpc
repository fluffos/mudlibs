inherit ITEM;

void create()
{
	set_name("作战电脑", ({ "computer" , "电脑", "diannao", "作战电脑" }) );
	set_weight(5000);
	set_max_encumbrance(8000);
	set("no_get", 1);
	set("no_show", 1);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "台");
		set("long", "一台专门配备给费沙情报部门的电脑。\n");
		set("value", 1);
	}
}

int is_container() { return 1; }