#include <ansi.h>

inherit ITEM;

void create() {
  set_name("文件", ({ "file", "wenjian" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "一本残缺不全的文件，上面大概是记录的是办公日志。\n");
    set("value", 0);
  }
}

void init() {
  add_action("do_read", "read");
}

int do_read() {
  write("你拿起这本残缺不全的文件仔细的找寻着有用的资料。。。\n\n");
  write("帝国历489年4月10日\n");
  write("    布朗胥百" HIW "########" NOR "战败，秃鹰之城" HIW "#######" NOR "\n");
  write("所占领。现所" HIW "######" NOR "沙银河帝国官员" HIW "#########" NOR "\n");
  write(HIW "##" NOR "晋格男爵与瑞" HIW "####" NOR "德事务官拟迁往距" HIW "#######\n" NOR);
  write(HIW "####" NOR "日行程" HIW "#####" NOR "斯麦" HIW "####" NOR "区" HIW "################\n");
  write("########                      ###########\n");
  write("######                      #############\n\n" NOR);
  return 1;
}
