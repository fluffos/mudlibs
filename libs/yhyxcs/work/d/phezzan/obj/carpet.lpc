inherit ITEM;

void create() {
  set_name("地毯", ({ "carpet", "地毯", "ditan" }));
  set_weight(5000);
  set_max_encumbrance(8000);
  set("no_get", 1);
  set("no_show", 1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "条");
    set("long", "一条墨绿色的地毯，踩上去轻松而柔软。\n");
    set("value", 1);
  }
}

int is_container() { return 1; }
