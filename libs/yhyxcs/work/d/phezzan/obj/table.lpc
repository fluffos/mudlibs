inherit ITEM;

void create() {
  set_name("办公桌", ({ "table", "desk", "办公桌" }));
  set_weight(5000);
  set_max_encumbrance(8000);
  set("no_get", 1);
  set("no_show", 1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("long", "一张标准的办公桌，上面堆满了没用的东西。\n");
    set("value", 1);
  }
}

int is_container() { return 1; }
