inherit ROOM;

void create()
{
        set("short", "人造湖");
        set("long", @LONG
抬眼望去，青山绿树掩映之间，一池清澈的湖水倒映着蓝天白云，
碧波荡漾。谁能想到如此风景秀丽的地方，在四个半世纪以前还只是
充满盐气的山间小盆地呢？四周遍布着一些低矮的灌木，鸟兽的鸣叫
声，声声不绝于耳。
******这里一个小秘密：例如pushaside grass之类，可以“依
稀见到北面的”神秘山庄。*******
LONG
	);

	set("exits", ([
		"north" : __DIR__"lakeside",
	]));

	set("globe","phezzan");
	setup();
