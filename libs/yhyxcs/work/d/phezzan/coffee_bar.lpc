#include <ansi.h>

inherit ROOM;

void create()
{
	set("short","中央银行咖啡厅");
	set("long", @LONG
咖啡厅的四周布置有供人休息与闲谈的几组色彩与室内基调十分
协调的真皮沙发和缓解气氛的绿色植物。墙上没有在同盟和帝国随处
可见的进行战争鼓动的宣传，让人感到很是轻松。此外，面对如此温
柔可亲的费沙服务小姐，总不能只要一杯咖啡吧？
LONG
	);

	set("globe","phezzan");

	set("exits",([
		"east" : __DIR__"center_bank_hall",
		"west" : __DIR__"center_bank_w",
	]));

	set("objects", ([
		__DIR__"npc/coffee_girl" : 1,
	]) );

	set("coor/x",40);
	set("coor/y",60);
	set("coor/z",0);

	setup();
}
