//Modified by xyc
#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "避难所");
	set("long", @LONG
这里像是一个仓库，墙壁以厚重的铅块围成，是一个不为外人所
知的密室。里面办公桌、电脑操作台、床俱、速食食品应有尽有。显
然是一处费沙政府官员的避难所。
LONG
	);

	set("globe","phezzan");

	set("exits", ([
		"up" : __DIR__"bedroom",
	]));

	set("item_desc", ([
                "computer": "其中一台电脑屏幕上显示着：" HIC"password_______。\n"NOR,
		"电脑屏幕": "其中一台电脑屏幕上显示着："HIC"password_______。\n"NOR,
		"电脑": "其中一台电脑屏幕上显示着："HIC"password_______。\n"NOR,
		"屏幕": "其中一台电脑屏幕上显示着："HIC"password_______。\n"NOR,
	]) );

	set("coor/x",10);
	set("coor/y",180);
	set("coor/z",-10);

	set("objects", ([
		__DIR__"npc/blackfox" : 1,
	]) );

	setup();
}
