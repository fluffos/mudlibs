//Modified by xyc
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "帝国高等事务官邸");
  set("long", @LONG
这里就是高登巴姆王朝做为高等事务官官邸的住宅，一扇结实的
原木大门关住了外面的景色。这栋单单以地名为名，被称为“贝尔塞
底皇宫”的建筑物以平民的眼光来看确实称得上宏伟豪华，但和高登
巴姆王朝的新无忧宫比较起来，却连千分之一的规模都不到。
LONG
  );

  set("globe", "phezzan");

  set("exits", ([
    "north": __DIR__ "empire_hall",
    "south": __DIR__ "estreet1",
  ]));

  set("objects", ([
    __DIR__ "npc/empire_guard": 2,
  ]));

  set("coor/x", 40);
  set("coor/y", 10);
  set("coor/z", 0);

  create_door("north", "原木大门", "south", 1);

  setup();
}

int valid_leave(object me, string dir) {
  object *inv;
  object ob;
  mapping doors;
  int i, check = 0;

  doors = query_doors();
  if (mapp(doors) && !undefinedp(doors[dir])) {
    if (doors[dir]["status"] & 1)
      return notify_fail("你必须先把" + doors[dir]["name"] + "打开！\n");
  }
  if (userp(me)) {
    if (dir == "north" && ob = present("guard", this_object())) {
      if (me->query_space("vassalage") == "费沙") {
        tell_object(me, CYN + ob->name() + "立正站好，向你行了一个标准的军礼。\n" NOR);

        if (me->query("rank") < 3)
          return notify_fail(CYN + ob->name() + "说道：我的上司不允许我放行您这个官阶的人员。\n" NOR);
      } else {
        inv = all_inventory(me);
        for (i = 0; i < sizeof(inv); i++) {
          if ((inv[i]->name() == "费沙军服")
            && (inv[i]->query("equipped")))
            check = 1;
          switch (inv[i]->name()) {
            case "费沙中尉肩章":
              if (inv[i]->query("equipped") && check)
                check = 2;
              break;
            case "费沙上尉肩章":
              if (inv[i]->query("equipped") && check)
                check = 2;
              break;
            case "费沙少校肩章":
              if (inv[i]->query("equipped") && check)
                check = 2;
              break;
            case "费沙中校肩章":
              if (inv[i]->query("equipped") && check)
                check = 2;
              break;
            case "费沙上校肩章":
              if (inv[i]->query("equipped") && check)
                check = 2;
              break;
            case "费沙准将肩章":
              if (inv[i]->query("equipped") && check)
                check = 2;
              break;
            case "费沙少将肩章":
              if (inv[i]->query("equipped") && check)
                check = 2;
              break;
            case "费沙中将肩章":
              if (inv[i]->query("equipped") && check)
                check = 2;
              break;
            case "费沙上将肩章":
              if (inv[i]->query("equipped") && check)
                check = 2;
              break;
            case "费沙元帅肩章":
              if (inv[i]->query("equipped") && check)
                check = 2;
              break;
          }
        }
        if (!check)
          return notify_fail(CYN + ob->name() + "说道：非费沙自治领军方人员不得进入供电中心！\n" NOR);

        tell_object(me, CYN + ob->name() + "立正站好，向你行了一个标准的军礼。\n" NOR);

        if (check == 1)
          return notify_fail(CYN + ob->name() + "说道：我的上司不允许我放行您这个官阶的人员。\n" NOR);
      }
      for (i = 0; i < sizeof(inv); i++) {
        if (mapp(inv[i]->query("weapon_prop")))
          return notify_fail(CYN + ob->name() + "说道：您不可以携带任何武器及爆炸品进入供电中心！\n" NOR);
      }
    }
    return 1;
  }
  return 1;
}
