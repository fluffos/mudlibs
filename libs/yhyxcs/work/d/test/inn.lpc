inherit SPACE_ROOM;

void create() {
  set("short", "试验区");
  set("long", @LONG
这里是《银河英雄传说》的试验区，检测空间的地方。
LONG
  );

  set("valid_startroom", 1);

  set("objects", ([
    __DIR__ "obj/huacao": 1,
    "/d/test/npc/mercenary": 1,
    "/d/test/npc/waiter": 1
  ]));

  setup();
}

void reset() {
  object *inv;
  object con, item;
  ::reset();
  con = present("earth", this_object());
  inv = all_inventory(con);
  if (!sizeof(inv)) {
    item = new(__DIR__ "obj/xuehama");
    item->move(con);
  }
}
