// waiter.c

inherit NPC;

void create() {
  set_name("店小二", ({ "waiter" }));
  set("gender", "男性");
  set("age", 22);
  set("long",
    "这位店小二正笑咪咪地忙著，还不时拿起挂在脖子上的抹布擦脸。\n");
  set("combat_exp", 5);
  set("attitude", "friendly");
  set("rank_info/respect", "小二哥");

  set_space("number", "第一");
  set_space("vassalage", "同盟军");
  setup();

  carry_object("/obj/cloth");
}
