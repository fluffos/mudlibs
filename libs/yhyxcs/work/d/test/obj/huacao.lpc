inherit PLANET;

void create() {
  set_name("测试行星", ({ "earth" }));
  set_weight(50000);
  set_max_encumbrance(1000000000);
  set("no_get", 1);
  set("no_shown", 1);
  set("prep", "orbit");
  set("landto", "/d/test/gate");

  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "测试用的可爱的小行星。\n");
  }
}
