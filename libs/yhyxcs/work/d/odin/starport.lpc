#include <ansi.h>

inherit ROOM;
inherit F_STARPORT;

void messaging();

void create() {
  set("short", BLU "奥丁空港" NOR);
  set("long", @LONG
比起民用港，奥丁军用港停舰坪的规模则稍小一些，但也能同时起降数
百艘的舰艇，而且有着庞大的舰队驻留基地，可以同时驻留二十万艘舰艇。
每天都的巡逻的舰艇在这里起降，因此也是轰鸣声不绝。
LONG
  );

  set("valid_startroom", 1);
  set("globe", "odin");

  set("exits", ([
    "north": __DIR__ "highwaygate",
  ]));

  messaging();
  setup();

}

void init() {
  add_action("do_geton", "geton");
}

void messaging() {
  switch (random(3)) {
    case 0:
      message("vision", CYN "大厅的广播中的女声在耳边响起：" +
        "“请各位搭乘舰船的士官迅速登舰。。。”\n" NOR, this_object());
      break;
    case 1:
      message("vision", CYN "略显嘈杂的人群中任然可以清晰的听到播音小姐甜美的嗓音：“" +
        sprintf("%d", random(600)) + "次\n商用航班马上就要起飞了，" +
        "请乘客迅速登舰。。。”\n" NOR, this_object());
      break;
    case 2:
      message("vision", CYN "空港广播中心似乎正在催促舰队完成高效的起降作业：“请司令官从" +
        "\nＡ通道前往（ＧＥＴＯＮ）旗舰。。。”\n" NOR, this_object());
      break;
  }
  call_out("messaging", 500);
}
