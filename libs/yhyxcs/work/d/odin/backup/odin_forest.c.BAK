inherit ROOM;

void create()
{
	set("short","利普休塔特森林");
	set("long",@LONG
这是奥丁南郊的一片森林。由于远离市区，这里的环境污染极少，植物和动物
豪无顾忌地吸收日月的精华而格外地茂盛或肥壮。
LONG
	);
	set("globe","odin");
	set("exits",([

		"north" : "/d/odin/southhighway3",
	]));
	set("coor/x",0);
	set("coor/y",-270);
	set("coor/z",0);
	setup();
}
