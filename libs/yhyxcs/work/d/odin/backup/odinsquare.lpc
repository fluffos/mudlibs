inherit ROOM;

void create()
{
	set("short","帝国皇家广场");
	set("long",@LONG
这里是全帝国最大的广场，是衔接奥丁市区与新无忧宫的衔接点。整个广
场用上等的花岗岩铺地，在中央竖立着鲁道夫大帝的巨大铜像。过去曾有一段
时间，凡经过铜像的人都必须对铜像鞠躬，当然现在这种无聊的规定早被取消
了。
LONG
	);
	set("globe","odin");
	set("exits",([
		"east" : "/d/odin/eastroad1",
		"west" : "/d/odin/wuyou_front",
		"south" : "/d/odin/southroad1",
		"north" : "/d/odin/northroad1",
	]));
	set("coor/x",0);
	set("coor/y",0);
	set("coor/z",0);
	setup();
}
