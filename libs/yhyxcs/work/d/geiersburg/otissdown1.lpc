inherit ROOM;

void create()
{
	set("short","下层南1全向通道");
	set("long",@LONG
这里是连接下层和中层的两个通道之一。也是要塞下层的重要枢
纽。所以这里一直都有重兵把守。这在以和谐安宁为主要气氛的下层
是少见的。
LONG
	);
	set("globe","geiersburg");
	set("exits",([
		"east" : "/d/geiersburg/dcns",
		"up" : "/d/geiersburg/otiss0",
		"south" : "/d/geiersburg/dsroad2",
		"north" : "/d/geiersburg/dcroad",
	]));
	set("coor/x",0);
	set("coor/y",-30);
	set("coor/z",-60);
	setup();
}
