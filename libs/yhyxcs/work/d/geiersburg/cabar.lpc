inherit ROOM;

void create() {
  set("short", "A区街角小酒吧");
  set("long", @LONG
这是在Ａ区的一个小酒吧，也许和其他的小酒吧一样，完全无法
引起别人更多的注意，但对于士兵们却是必须的，在战场上可能处于
兴奋状态或仅仅是为了活命而发射出一发又一发的炮弹，而下了战场
一方面是为了庆幸自己还活着另一方面是为了摆脱一时的负罪感酒精
是必须的。但要完全放下精神的压力大概酒精也无能为力了吧。在昏
暗的灯光下可以看见不少人都在默默的喝着闷酒。
LONG
  );
  set("globe", "geiersburg");
  set("exits", ([
    "east": "/d/geiersburg/camr",
    "west": "/d/geiersburg/carm2",
    "south": "/d/geiersburg/cashop",
    "north": "/d/geiersburg/caw",
  ]));
  set("coor/x", -60);
  set("coor/y", 90);
  set("coor/z", 0);
  setup();
}
