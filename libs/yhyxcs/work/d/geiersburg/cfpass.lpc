inherit ROOM;

void create()
{
	set("short","高级军官高速通道");
	set("long",@LONG
这是一条高速通道，从这里可以很快的从秃鹰之城空港到达要塞
内部，但这条通道只限中校以上级别的军官使用，且由于修建这条高
速通道牺牲Ｄ区与其他地区的沟通路线。为了自身的方便而牺牲下级
军官和贫民的利益是大贵族的一贯作风。
LONG
	);
	set("globe","geiersburg");
	set("exits",([
		"east" : "/d/geiersburg/otiss0",
		"north" : "/d/geiersburg/pass1",
	]));
	set("coor/x",-180);
	set("coor/y",130);
	set("coor/z",0);
	setup();
