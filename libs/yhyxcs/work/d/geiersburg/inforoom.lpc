inherit ROOM;

void create()
{
	set("short","情报分析中心");
	set("long",@LONG
情报分析中心可以说是处在最关键的地位，司令官能否做出正确
判断与其有直接的关联。所以这里集中了全要塞的精英。不论什么时
候来到这里总能看到大家在繁忙的工作，看到这幅景象任谁也不好意
思去无故打扰。
LONG
	);
	set("globe","geiersburg");
	set("exits",([
		"east" : "/d/geiersburg/ccroad",
		"west" : "/d/geiersburg/centermeetroom",
	]));
	set("coor/x",-30);
	set("coor/y",0);
	set("coor/z",0);
	setup();
}
