inherit ROOM;

void create() {
  set("short", "小会客厅");
  set("long", @LONG
在这个会客厅里发生过很多历史事件，不久以前莱因哈特就是在
这里永远的失去了他的红法挚友齐格飞．吉尔菲艾斯的。由于祟尚实
际的坎普认为内部装饰根本没有修复的必要。在这里仍可以看见被手
持式加农炮击中而尚未修复的壁面。看着这里不由得产生了一种凄凉
的感觉。仿佛可以感受到莱因哈特那彻骨的悲痛。
LONG
  );
  set("globe", "geiersburg");
  set("exits", ([
    "east": "/d/geiersburg/slroom1",
    "west": "/d/geiersburg/bighall",
  ]));
  set("coor/x", 60);
  set("coor/y", 0);
  set("coor/z", 0);
  setup();
}
