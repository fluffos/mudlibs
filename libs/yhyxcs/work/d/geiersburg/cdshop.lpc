    "east": "/d/geiersburg/cdtrainroom1",
    "west": "/d/geiersburg/cdcr",
    "south": "/d/geiersburg/cdbar",
  ]));
  set("coor/x", -90);
  set("coor/y", -60);
  set("coor/z", 0);
  setup();
