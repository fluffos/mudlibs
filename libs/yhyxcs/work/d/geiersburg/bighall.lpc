inherit ROOM;

void create() {
  set("short", "要塞中央大厅");
  set("long", @LONG
这个大厅原来是布朗胥百克公爵举行宴会的地方，曾经容纳过近
３０００名贵族。在内战结束后，这里所有的艺术品都被素有“艺
术家提督”之称的梅克林洛上将搬到了国立博物馆去了。使原本就
空阔的大厅愈发显得空荡荡的，大贵族们的昨日辉煌也消失的无影
无踪。
LONG
  );
  set("globe", "geiersburg");
  set("exits", ([
    "east": "/d/geiersburg/littlehall",
    "west": "/d/geiersburg/ccroad",
  ]));
  set("coor/x", 30);
  set("coor/y", 0);
  set("coor/z", 0);
  setup();
}
