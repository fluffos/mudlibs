inherit ROOM;

void create() {
  set("short", "S2通道");
  set("long", @LONG
Ｓ２通道是联系中层Ｄ区的唯一的通路，这里的通道和中央大道
一样宽敞。本来Ｄ区的设计是和Ａ区一样的，但因布朗胥百克公爵的
特权要求不得不使的Ｄ区只有一个通道，一旦通道被破坏的话，Ｄ区
就完全被隔离了。因为有这种想法在人们心中弥漫，所以在昏暗的灯
光下这里显得格外阴森。
LONG
  );
  set("globe", "geiersburg");
  set("exits", ([
    "east": "/d/geiersburg/cchospital",
    "west": "/d/geiersburg/cdtrainroom1",
    "south": "/d/geiersburg/ccsroad3",
    "north": "/d/geiersburg/otiss0",
  ]));
  set("coor/x", 0);
  set("coor/y", -60);
  set("coor/z", 0);
  setup();
}
