inherit ROOM;

void create()
{
	set("short","要塞水处理中心");
	set("long",@LONG
水是生命的源泉，作为废水的处理和回收当然是要塞内部不可缺
少的一部分。要塞内部所有的废水全部都会集中到这里进行加工再处
理，然后再重新回到管道中供人们使用。为了安全起见，这里自然也
设有重兵把守，除了工人外未经允许，任何人经警告后仍要靠近的话
就会被立即射杀。
LONG
	);
	set("globe","geiersburg");
	set("exits",([

		"west" : "/d/geiersburg/dsroad3",
	]));
	set("coor/x",60);
	set("coor/y",-120);
	set("coor/z",160);
	setup();
}
