inherit ROOM;

void create()
{
	set("short","2号兵工厂");
	set("long",@LONG
这里是处于要塞上层Ａ区的兵工厂，这里有相当规模的生产基地
如果生产设施全部开动的话一天就可以生产出１００艘航母、１００
艘高速战舰和１００艘驱逐舰，其生产能力可以说在全帝国要塞中是
最强大的。在舰队战中的损失可以很快的恢复，但兵员呢？
LONG
	);
	set("globe","geiersburg");
	set("exits",([
