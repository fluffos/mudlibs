inherit ROOM;

void create()
{
	set("short","上层主炮控制室");
	set("long",@LONG
这里是秃鹰之城主炮－－秃鹰之喙的控制室，可以说这里控制着
最为可怕的武器。秃鹰之城名字的由来也是基于主炮的名字。控制主
炮的都是中校级别以上的军官，而使用开启主炮的密码却只有司令官
和副司令官才有。也就是说只有司令官才有动用主炮的决定权。
LONG
	);
	set("globe","geiersburg");
	set("exits",([
		"east" : "/d/geiersburg/controlcenter",
		"southwest" : "/d/geiersburg/udpass1",
		
		"northwest" : "/d/geiersburg/uapass1",
	//"west" : "/d/geiersburg/umainfireofgeir",
	]));
	set("coor/x",-90);
	set("coor/y",0);
	set("coor/z",60);
	setup();
}
