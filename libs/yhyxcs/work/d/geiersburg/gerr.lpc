inherit ROOM;

void create()
{
	set("short","将官休息室");
	set("long",@LONG
这里是指挥官的专用休息室，除了有休息用的密舱外，还有一些
其他的放松精神的设备。虽然指挥官不会亲上前线，但一个好的指挥
官在每次战役要付出多少精神力量是外人不得而知的。所以一场艰苦
战役下来，指挥官往往都会象虚脱一样。为了尽快恢复状态，休息室
的作用就显得愈发突出了。
LONG
	);
	set("globe","geiersburg");
	set("exits",([

		"west" : "/d/geiersburg/controlcenter",
	]));
	set("coor/x",-30);
	set("coor/y",0);
	set("coor/z",60);
	setup();
}
