    "east": "/d/geiersburg/inforoom",
    "up": "/d/geiersburg/controlcenter",
    //"down" : "/d/geiersburg/mlmlroom",
  ]));
  set("coor/x", -60);
  set("coor/y", 0);
  set("coor/z", 0);
  setup();
