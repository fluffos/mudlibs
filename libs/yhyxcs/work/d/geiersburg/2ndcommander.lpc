inherit ROOM;

void create()
{
	set("short","副司令室");
	set("long",@LONG
这里是缪拉上将的办公室，和坎普上将的办公室一样，这里没有
更多的装饰，只有一张朴素的办公桌，一个书柜，一个转椅和一个会
客用的沙发，仅此而已。这里收拾得很整齐很有规律，处处透漏出主
人那严谨、认真、利落的品行。
LONG
	);
	set("globe","geiersburg");
