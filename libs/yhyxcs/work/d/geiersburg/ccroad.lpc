inherit ROOM;

void create()
{
	set("short","秃鹰之城中央大道");
	set("long",@LONG
这是秃鹰之城的中心广场，整个广场上到处都是古代地球的欧式
建筑让人有一种到了地球上的错觉，在广场中心是一个旗杆上面飘着
罗严克拉姆军队特有的黄金狮子旗，经过此地的人们看见这面旗帜，
不尽都想到了他们那永不战败的主君，敬仰之心油然而生。
LONG
	);
	set("globe","geiersburg");
	set("exits",([
		"east" : "/d/geiersburg/bighall",
		"west" : "/d/geiersburg/inforoom",
		"south" : "/d/geiersburg/otiss0",
		"north" : "/d/geiersburg/otisn0",
	]));
	set("coor/x",0);
	set("coor/y",0);
	set("coor/z",0);
	setup();
}
