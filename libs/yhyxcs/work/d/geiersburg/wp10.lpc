inherit ROOM;

void create() {
  set("short", "10号瓦普室");
  set("long", @LONG
这里是要塞的动力引擎“瓦普”的所在地，重达４０兆吨的要塞
就是由１２个这样的引擎所带动的。“瓦普”所提供的动力是十分巨
大的，相对的也产生了巨大的噪音，幸好是在宇宙中使用，声音无法
传播。否则即使用了最好的隔音服大概也没人能够靠近，所以这里的
防卫方法就是在“瓦普”室里充满空气，这样就没有办法人为接近破
坏了。
LONG
  );
  set("globe", "geiersburg");
  set("exits", ([

    "south": "/d/geiersburg/dcwpc",
  ]));
  set("coor/x", 120);
  set("coor/y", -30);
  set("coor/z", -60);
  setup();
}
