inherit ROOM;

void create()
{
	set("short","D区控制中心");
	set("long",@LONG
这里是整个Ｄ区的作战指挥中心，如果把要塞的指挥中心比作是
大脑的话这里就相当于四肢了。在房间的中央是透明的作战指挥图，
周围有许多通信兵在忙忙碌碌的工作着，上面一道简单的命令就在
这里详细化变成若干个命令发到若干个地方。
LONG
	);
	set("globe","geiersburg");
	set("exits",([
		"east" : "/d/geiersburg/cdshop",
		"west" : "/d/geiersburg/cdrr1",
		"south" : "/d/geiersburg/cdrr2",
	]));
	set("coor/x",-120);
	set("coor/y",-60);
	set("coor/z",0);
	setup();
}
