inherit ROOM;

void create()
{
	set("short","D区王尔古雷发射口");
	set("long",@LONG
这里是王尔古雷从要塞出击的地方，每次出击的时候看着一架架
的王尔古雷呼啸着争先恐后的发射出去真是壮观极了，但等它们回来
的时候看着一架架千疮百孔的样子，任谁也会心疼不已，但这还只是
那些“幸运的小伙子们”。
LONG
	);
	set("globe","geiersburg");
	set("exits",([
		"east" : "/d/geiersburg/cdsh",
		"north" : "/d/geiersburg/cdw",
	]));
	set("coor/x",-90);
	set("coor/y",-150);
	set("coor/z",0);
	setup();
}
