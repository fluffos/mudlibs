inherit ROOM;

void create()
{
	set("short","副司令警卫室");
	set("long",@LONG
和坎普不同的是，缪拉在警卫方面是相当的在意，警卫室里全部
是个人的亲信精兵。这和个人的个性有关。缪拉本人是那种思维缜密
细致的人，“为了不使指挥瘫痪，有必要采取严密的保护措施”。由
于他为人相当有弹性，所以在巴米利恩星域会战中四次更换旗舰，坚
持战斗守卫着主君而得到"铁壁缪拉"之称。

	);
	set("globe","geiersburg");
	set("exits",([
		"east" : "/d/geiersburg/2ndcommander",
		"west" : "/d/geiersburg/dcroad",
	]));
	set("coor/x",30);
	set("coor/y",0);
	set("coor/z",-60);
	setup();
}
