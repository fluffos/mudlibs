inherit ROOM;

void create()
{
	set("short","A区王尔古雷机坪");
	set("long",@LONG
这里是王尔古雷的停机坪，在这里整整齐齐的停放着一架又一架
的王尔古雷，从远处看显得十分壮观。但每次出击回来后就又是另一
副景观了，茫茫碌碌的后勤人员在修理那些侥幸回来的战机，而更多
的是从兵工厂力拖来新的战机，补充在那些永远不能回来的战机的位
置上。所以要让那些后勤人员记住每一个飞行员是不可能的。
LONG
	);
	set("globe","geiersburg");
	set("exits",([
		"east" : "/d/geiersburg/uawe2",
		"west" : "/d/geiersburg/uawe1",
		"south" : "/d/geiersburg/warfactory1",
	]));
	set("coor/x",-60);
	set("coor/y",150);
	set("coor/z",60);
	setup();
}
