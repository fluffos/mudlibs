#include <ansi.h>
inherit ROOM;

void create() {
  set("short", BLU "秃鹰之城空港" NOR);
  set("long", @LONG
秃鹰之城空港是要塞的主要对外空港，所有的非宇宙舰队的船只
都必须停靠在这里。这里也是要塞最大的一个空港可以同时容纳８０
０００艘战舰的停靠。光是在空港工作的人员就有３０００００人之
多。
LONG
  );

  set("valid_startroom", 1);
  set("globe", "geiersburg");

  set("exits", ([
    "east": "/d/geiersburg/pass1",
    //		"north" : __DIR__"starportway",
    //		"west" : __DIR__"moontai",
  ]));
  set("coor/x", -210);
  set("coor/y", 0);
  set("coor/z", 0);
  setup();
}
