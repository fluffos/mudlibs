inherit ROOM;

void create()
{
	set("short","A区中子光束4号炮台");
	set("long",@LONG
在这里你可以看到一座座的中子光束大炮，士兵们在此不停
的瞄准射击。这一切的一切都显得死气沉沉的，唯一与其他地方
相区别的，大概只有入口处的"A区中子光束４号炮台"的铭牌了。
LONG
	);
	set("globe","geiersburg");
	set("exits",([
		"east" : "/d/geiersburg/carm1",
		"south" : "/d/geiersburg/cspass2",
	]));
	set("coor/x",-150);
	set("coor/y",60);
	set("coor/z",0);
	setup();
}
