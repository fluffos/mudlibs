inherit SPACE_ROOM;

void create() {
  set("short", "巴拉特星系");
  set("long", @LONG
这里就是在以国父亚雷·海尼森带领下的逃亡者们，从牛郎星
出发，经过半个多世纪苦难的旅程之后才到达的安定的壮年期星群。
他们将这里以古代腓尼基大神的称呼命名为: 巴拉特。
　　巴拉特星系拥有6颗行星，主星为其第四行星--海尼森。
LONG
  );

  set("objects", ([
    __DIR__ "globe/heinessen": 1,
  ]));
  set("exits", ([
    "+ +": __DIR__ "iserlohn",
    "+ -": __DIR__ "phezzan",
  ]));
  setup();
}

void reset() {
  object *inv;
  object con, item;
  ::reset();
  con = present("heinessen", this_object());
  inv = all_inventory(con);
  if (!sizeof(inv)) {
    item = new("/u/globe/obj/necklace");
    item->move(con);
  }
}
