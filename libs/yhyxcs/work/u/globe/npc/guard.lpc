// guard.c

inherit NPC;

void create()
{
	set_name("博尔德克", ({ "guard" }) );
	set("gender", "男性" );
	set("age", 35);
	set("long",
		"博尔德克，费沙驻帝国使馆外交官。\n");
	set("combat_exp", 100);

	set_space("number",1);
	set_space("vassalage","费沙");
	set_space("scouting",100);

	add_sub_fleet("帝国战舰","第一部队",300,300);
	add_sub_fleet("帝国战舰","第二部队",300,300);

	set_sub_fleet(1,"attacktype","missile");

	setup();

	carry_object("/obj/cloth");
}
