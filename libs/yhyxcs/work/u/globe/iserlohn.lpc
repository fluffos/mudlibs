inherit PLANET;

void create() {
  set_name("伊谢尔伦要塞", ({ "iserlohn" }));
  set_weight(50000);
  set_max_encumbrance(1000000000);
  set("no_get", 1);
  set("no_shown", 1);
  set("prep", "orbit");
  set("landto", "/d/iserlohn/starport");
  set("x-dir", 100);
  set("y-dir", 100);

  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", @LONG
远望呈海蓝色的伊谢尔伦要塞。是一座直径六十公里、质量六十
兆吨的巨大人造天体，于三十年前由银河帝国在此处修建。从这里可
以看到其表面的那层厚厚的流体金属,而且,在这上面还有公认宇宙间
最强的火力----被称为「雷神之锤」的巨炮，输出功率达九二四兆瓦。
这里距离帝国首都星奥丁六二○○光年。
LONG
    );
  }
}
