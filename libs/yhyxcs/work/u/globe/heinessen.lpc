inherit PLANET;

void create()
{
	set_name("行星海尼森", ({ "heinessen" }) );
	set_weight(50000);
	set_max_encumbrance(1000000000);
	set("no_get", 1);
	set("no_shown", 1);
	set("prep","orbit");
	set("landto","/d/heinessen/starport");
	set("x-dir",100);
	set("y-dir",100);

	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "颗");
		set("long", "海尼森的描述。\n");
	}
}
