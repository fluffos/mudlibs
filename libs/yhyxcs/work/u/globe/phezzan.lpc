inherit PLANET;

void create() {
  set_name("行星费沙", ({ "phezzan" }));
  set_weight(50000);
  set_max_encumbrance(1000000000);
  set("no_get", 1);
  set("no_shown", 1);
  set("prep", "orbit");
  set("landto", "/d/phezzan/starport");
  set("x-dir", 100);
  set("y-dir", 150);

  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "略显橙黄色的巨大行星，公转时间40小时，人口20亿。\n");
  }
}
