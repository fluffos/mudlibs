		}
	}
*/
  mapping my;

  if (!ob->query_temp("already_loaded")) loadall(ob);

  my = ob->query_entire_dbase();
  if (undefinedp(my["eff_gin"])) my["eff_gin"] = my["max_gin"];
  if (undefinedp(my["eff_kee"])) my["eff_kee"] = my["max_kee"];
  if (undefinedp(my["eff_sen"])) my["eff_sen"] = my["max_sen"];
  if (my["eff_gin"] > my["max_gin"]) my["eff_gin"] = my["max_gin"];
  if (my["eff_kee"] > my["max_kee"]) my["eff_kee"] = my["max_kee"];
  if (my["eff_sen"] > my["max_sen"]) my["eff_sen"] = my["max_sen"];
  if (my["gin"] > my["eff_gin"]) my["gin"] = my["eff_gin"];
  if (my["kee"] > my["eff_kee"]) my["kee"] = my["eff_kee"];
  if (my["sen"] > my["eff_sen"]) my["sen"] = my["eff_sen"];
  if (!(my["age"] % 5) && my["age"] <= 55) my["gift_points"] = my["age"] - 5;

  if (!my["next_salary_time"]) my["next_salary_time"] = my["mud_age"];

  if (my["mud_age"] > my["next_salary_time"]) {
    my["id_card"] += my["rank"] * 1000;
    my["next_salary_time"] += 7200;
  }
}

void loadall(object me) {
  string name, id, *created;
  int j;
  object thing, card;

  id = me->query("id");
  write("现在携带着以下随身物品：\n");

  card = new("/obj/id_card");
  card->set("left_money", me->query("id_card"));
  card->set("owner_name", me->query("name"));
  card->set("owner_id", me->query("id"));
  card->move(me);
  write(card->name() + ".....ＯＫ．\n");

  created = get_dir(DATA_DIR + "login/" + id[0..0] + "/" + id + "/");
  if (!pointerp(created)) return;
  for (j = 0; j < sizeof(created); j++) {
    if (sscanf(created[j], "%s.lpc", name) == 1) {
      thing = new(DATA_DIR + "login/" + id[0..0] + "/" + id + "/" + name + ".lpc");
      write(thing->name());
      if (thing->move(me)) write(".....ＯＫ．\n");
      thing->restore();
      if (!mapp(thing->query("armor_prop"))) continue;
      if (me->query_temp("armor/" + thing->query("armor_type"))) continue;
      thing->wear();
    }
  }
  me->set_temp("already_loaded", 1);
}
