// This is a daemon that calls itself every minte. it checks
// someting important and makes sure that they are up and running.

#include <ansi.h>
//#include <command.h>
//#include <globals.h>

//inherit F_DBASE;

void init_monitor();
void autosave();
void check_user();

void create()
{
 //	seteuid( ROOT_UID );
//	set("name","监测精灵");
//	set("id","monitord");
	init_monitor();
}

void init_monitor()
{
	mixed *local;
	local = localtime(time());

// every 45 mins, autosave every player
	if ( !((local[1])%45)) autosave();

// On average tasks get renewed every 30 mins
//	if ( !random(30))
	if( !((local[1])%5) )
	TASK_D->init_dynamic_task();

/*check users whether anyone of them has lost his heart beat
	if( !(local[1]%2) )
		check_user();
*/
	call_out("init_monitor", 60);
}

void autosave()
{
	object *user;
	int i;

	user = users();
	message("system", HIR "\n 自动存档．．．", users());

	for(i=0; i<sizeof(user); i++)
	user[i]->save();

	message("system", HIG "．．．存档完毕 \n" NOR, users());
}
