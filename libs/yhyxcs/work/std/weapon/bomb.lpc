// bomb.c

#include <dbase.h>
#include <move.h>
#include <name.h>

inherit F_CLEAN_UP;
inherit F_DBASE;
inherit F_MOVE;
inherit F_NAME;

void setup() {
  seteuid(getuid());
}

varargs void init_gun(int damage, int max_time, int tech_level, string type) {
  if (clonep(this_object())) return;
}

string extra_long() {
  string result;

  return result;
}

void init() {
  add_action("do_timer", "timer");
}

int do_timer() {
  return 1;
}
