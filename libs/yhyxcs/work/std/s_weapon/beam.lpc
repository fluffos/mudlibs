#include <s_weapon.h>

#ifdef AS_FEATURE
#include <dbase.h>
#else
inherit S_EQUIP;
#endif

int is_s_weapon() { return 1; }

varargs void init_beam(int beam, int defending, int speed) {
  set("weapon/beam", beam);
  set("weapon/defending", defending);
  set("weapon/speed", speed);
  set("skill_type", "beam");
  return;
}
