#include <ansi.h>

inherit ROOM;

void start_voyage();
void success_leave();
void reach_dest();
void force_leave();

void create() {
  seteuid(getuid());
  set("short", "星际民航");
  set("long",
    "这里是星际民航班机的机舱，机舱宽敞，座位松软，很舒服。
");

  call_out("start_voyage", 20);
}

void start_voyage() {
  message("vision", "星际飞船在强烈的喷射火焰中缓缓上升，地面的景物渐渐变的模糊。\n",
    all_inventory(this_object()), ({}));
  this_object()->delete("exits/out");
  call_out("reach_dest", 20);
}

void init() {
  message("vision", "本航班马上就要起飞了，请各位乘客回到自己的位置。\n",
    all_inventory(this_object()), ({}));
}

void reach_dest() {
  object here, obj;
  string dest;

  here = this_object();
  dest = here->query("dest");

  here->set("exits/out", dest);
  here->set("globe", dest->query("globe"));
  here->delete("dest");
  here->delete("order_from");
  message("vision", "请各位乘客下机，我们的目的地到了。\n", all_inventory(here), ({}));
  call_out("force_leave", 20);
}

void force_leave() {
  object *inv;
  int i;

  inv = all_inventory(this_object());
  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i]->is_character())
      inv[i]->force_command("out");
    else destruct(inv[i]);
  }
}

int valid_leave(object me, string dir) {
  remove_call_out("success_leave");
  call_out("success_leave", 0);
  return 1;
}

void success_leave() {
  object *inv;
  int i;

  inv = all_inventory(this_object());
  for (i = 0; i < sizeof(inv); i++) {
    if (userp(inv[i]))
      return;
  }
  destruct(this_object());
}
