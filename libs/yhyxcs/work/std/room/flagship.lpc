//flagship.c
//Update by Alarms 1/21/00

#include <ansi.h>

inherit ROOM;
inherit F_DISTANCE;

void create() {
  seteuid(getuid());
  set("short", "旗舰舰桥");
  set("long",
    "这里旗舰的指挥台，位置要略高于整个舰桥，面前的全息星图
显示出所在星域的物理特性和运动规律，恒星带，黑洞，星云，行
星的分布运行一目了然。十数名操作员各司其位，等待司令官阁下
指令。
");

}

void init() {
  add_action("do_blastoff", "blastoff");
}

string load_universe(string which) {
  string universe;
  switch (which) {
    case "phezzan":
      universe = "/u/phezzan";
      break;
    case "odin":
      universe = "/u/walhalla";
      break;
    case "heinessen":
      universe = "/u/ballat";
      break;
    case "iserlohn":
      universe = "/u/iserlohn";
      break;
    default:
      universe = "/u/phezzan";
  }
  return universe;
}

string load_globe(string which) {
  string globe;
  switch (which) {
    case "phezzan":
      globe = "/u/globe/phezzan";
      break;
    case "odin":
      globe = "/u/globe/odin";
      break;
    case "heinessen":
      globe = "/u/globe/heinessen";
      break;
    case "iserlohn":
      globe = "/u/globe/iserlohn";
      break;
    default:
      globe = "/u/phezzan";
  }
  return globe;
}

int do_blastoff() {
  object me, here, obj, *result, *inv;
  string where, globe;
  int i;

  me = this_player();
  here = this_object();

  if (!(where = here->query("globe")))
    return notify_fail("舰队无法升空。\n");

  if (!(obj = load_object(load_universe(where))))
    return notify_fail("舰队无法升空。\n");

  if (undefinedp(me->query_space("sub_fleet")) || !pointerp(me->query_space("sub_fleet")))
    return notify_fail("你并没有舰队可以指挥！\n");

  globe = load_globe(where);
  me->set_space("x-dir", globe->query("x-dir"));
  me->set_space("y-dir", globe->query("y-dir"));

  //	message_vision(HIY"惊天动地的轰鸣过后，" + me->space_short() + "在一阵呼啸声中离开" + here->query("short")
  //			+ HIY"，\n向"NOR + obj->query("short") + HIY"飞去...\n"NOR,me);

  if (me->move(obj)) {
    me->set("channel_id", me->space_short());
    //		me->delete_space("landin");
    result = ({});
    inv = all_inventory(obj);
    for (i = 0; i < sizeof(inv); i++) {
      if (!userp(inv[i])) continue;
      if (inv[i] == me || !calculate_distance(inv[i], me, inv[i]->query_space("scouting")))
        result += ({ inv[i] });
    }
    message("vision", HIY "\n" + me->space_short() + HIY "在一阵呼啸声中升空了...\n" NOR,
      obj, result);

    tell_object(me, HIY "你的舰队已航行在" + obj->query("short") + HIY "中。\n" NOR);
    destruct(here);
    return 1;
  }
  return 0;
}

int valid_leave(object me, string dir) {
  remove_call_out("success_leave");
  call_out("success_leave", 0);
  return 1;
}

void success_leave() {
  destruct(this_object());
}
