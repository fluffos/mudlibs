//flagship.c
//Update by Alarms 1/21/00

#include <ansi.h>

inherit SPACE_ROOM;

void create() {
  set("short", "无尽的光墙");
  set("long",
    "透过指挥台，可以看到舰外不断侵袭而来的光线，时间似乎停止了，
所有的东西都保持着空间跳跃前的模样。没有任何感觉，对于所有的人
来说，能够做的一切事情，只有等待着这段里程的结束罢了。
");
  set("no_clean_up", 0);
}

void init() {
  write("\n    透过指挥台，可以看到舰外不断侵袭而来的光线，时间似乎停止了，\n");
  write("所有的东西都保持着空间跳跃前的模样。没有任何感觉，对于所有的人\n");
  write("来说，能够做的一切事情，只有等待着这段里程的结束罢了。\n\n");
  this_player()->stationary();
}

int do_delay(object dest, object me) {
  remove_call_out("delay");
  call_out("delay", 30, dest, me);
  return 1;
}

int delay(object dest, object me) {
  me->unstationary();
  if (me->move(dest)) {
    message("vision", HIY "\n星海深处延伸成一片广袤的光团，重力场的改变预示着似乎将有不明物体进入星域...\n" NOR
      , dest, ({ me }));
    tell_object(me, CYN "光幕消失了，正前方出现的点点星光说明舰队的空间跳跃成功了!\n" NOR);
    destruct(this_object());
    return 1;
  }
  return 0;
}
