#include <ansi.h>

inherit ROOM;

void start_travel();
void success_leave();
void reach_dest();
void force_leave();

void create()
{
	seteuid(getuid());
	set("short","地上车");
	set("long",
"这里是地上车的后座，皮质的座椅非常舒服。
");
}

void init()
{
	if( !this_object()->query("dest") )
		return;
	remove_call_out("start_travel");
	call_out("start_travel",1);
}

void start_travel()
{
	message("vision","地上车在均匀的加速中前进，窗外的景物如同幻灯画片一般顺序的倒退。\n",
		all_inventory(this_object()),({ }));
	this_object()->delete("exits/out");
	call_out("reach_dest",10);
}

void reach_dest()
{
	object here, obj, room;
	string dest;

	here = this_object();
	dest = here->query("dest");

	here->set("exits/out", dest);
//	here->set("globe",dest->query("globe"));
	here->delete("dest");
//	here->delete("order_from");
	message("vision","您可以下车了，我们的目的地到了。\n",here);
	room = load_object(dest);
	if( room ) tell_room(room,"一辆地上车慢慢的停在了旁边。\n");
	call_out("force_leave",20);
}

void force_leave()
{
	object *inv;
	int i;

	inv = all_inventory(this_object());
	for(i=0;i<sizeof(inv);i++)
	{
		if( inv[i]->is_character() )
			inv[i]->force_command("out");
		else destruct(inv[i]);
	}
}

int valid_leave(object me, string dir)
{
	remove_call_out("success_leave");
	call_out("success_leave",0);
	return 1;
}

void success_leave()
{
	object *inv;
	int i;

	inv = all_inventory(this_object());
	for(i=0;i<sizeof(inv);i++)
	{
		if( userp(inv[i]) )
			return;
	}
	destruct(this_object());
}
