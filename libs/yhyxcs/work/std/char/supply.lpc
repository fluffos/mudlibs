#include <dbase.h>
#include <ansi.h>

void complete_supply(object me);

int do_supply()
{
	string my_vassalage;
	object me, ob;

	me = this_player();
	ob = this_object();

	if( !stringp( my_vassalage = me->query_space("vassalage") )
		|| ( my_vassalage == "中立" ) )
	{
		write( CYN + ob->name() + "说道：你是哪一支舰队的指挥官，我怎么没有见过你？\n"NOR);
		return 1;
	}
	if( my_vassalage != ob->query_space("vassalage") )
	{
		if( random( 30 - me->query_kar() ) )
		{
			write( CYN + ob->name() + "说道：你是哪一支舰队的指挥官，我怎么没有见过你？\n"NOR);
			return 1;
		}
		message("vision",HIR"房间里忽然间警铃大作。\n"NOR,environment(ob),({}));
		write( HIR"你的身份被" + ob->name() + HIR"识破了！\n"NOR);
		write("打起来的功能我还没有做:-P\n");
		return 1;
	}

	if( me->query_space("next_supply_time") > time() )
	{
		write( CYN + ob->name() + "说道：司令官这么快又要申请补给，恐怕有些不妥吧？\n"NOR);
		return 1;
	}

	if( !pointerp(me->query_space("sub_fleet")) )
	{
		write( CYN + ob->name() + "说道：很遗憾，您目前尚未配备舰队。\n"NOR);
		return 1;
	}

	if( me->query_space("garrison") != environment(ob)->query("globe") )
	{
		write( CYN + ob->name() + "说道：司令官的舰队并不是本星球的驻留舰队，无法为您进行补给。\n"NOR);
		return 1;
	}
	if( me->query_space("landin") != environment(ob)->query("globe") )
	{
		write( CYN + ob->name() + "说道：司令官的舰队并不在本星球，无法为您进行补给。\n"NOR);
		return 1;
	}

	complete_supply(me);
	return 1;
}

void complete_supply(object me)
{
	mapping *fleets;
	int i;
	string shiptype;

	fleets = me->query_space("sub_fleet");
	for(i=0;i<sizeof(fleets);i++)
	{
		shiptype = fleets[i]["shiptype"];
		fleets[i]["energy"] = F_S_ATTRIBUTE->query_base_max_energy(shiptype);
		fleets[i]["missile"] = F_S_ATTRIBUTE->query_base_max_missile(shiptype);
		fleets[i]["craft"] = F_S_ATTRIBUTE->query_base_max_craft(shiptype);
	}
	me->set_space("next_supply_time", time() + 1800 );
	write( CYN + this_object()->name() + "说道：补给完成，请继续为国效力吧！\n"NOR );
}
