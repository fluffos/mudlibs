#include <dbase.h>
#include <ansi.h>

void geton_plane(object me, string dest);
void complete_geton(object me, object plane);

int do_voyage(string arg) {
  string my_vassalage, *dest;
  mapping voyage;
  int i, price;
  object me, ob, *inv;

  ob = this_object();
  if (!arg) {
    write(CYN + ob->name() + "说道：您要预定去哪里的航班？\n" NOR);
    return 1;
  }

  me = this_player();
  voyage = ob->query("voyage");

  if (!mapp(voyage)) {
    write(CYN + ob->name() + "说道：真抱歉，现在我们这里的航班全部停飞了。\n" NOR);
    return 1;
  }

  dest = keys(voyage);
  inv = all_inventory(me);
  for (i = 0; i < sizeof(inv); i++) {
    if (member_array(arg, dest) == -1) {
      write(CYN + ob->name() + "说道：真报歉，这里没有到" + arg + "的航班。\n" NOR);
      return 1;
    }
    price = voyage[arg];
    if (inv[i]->name() == "ＩＤ卡") {
      if (!inv[i]->query("owner_name") && !inv[i]->query("owner_id")) {
        write(CYN + ob->name() + "说道：您的这张卡似乎有些问题，无法付帐。\n" NOR);
        return 1;
      }
      if (inv[i]->query("owner_name") != me->name()) {
        write(CYN + ob->name() + "说道：这张卡不是您的吧？上面记录的信息和您不符。\n" NOR);
        return 1;
      }
      if (inv[i]->query("owner_id") != me->query("id")) {
        if (random(25 - me->query_kar())) {
          me->set("next_trade_time", time() + 3600);
          destruct(inv[i]);
          write(CYN + ob->name() + "说道：对不起，我必须没收您的假卡。\n" NOR);
          write("由于你被发现使用假ＩＤ卡，所以银行冻结了你的帐户！\n");
          return 1;
        } else if (inv[i]->query("left_money") > price) {
          geton_plane(me, arg);
          inv[i]->add("left_money", -price);
          return 1;
        } else return notify_fail("你信用卡上的钱不够。\n");
      }
      if (me->query("next_trade_time") > time()) {
        write(CYN + ob->name() + "说道：您的银行帐户正在冻结状态，无法付帐。\n" NOR);
        return 1;
      }
      if (me->query("id_card") > price) {
        me->add("id_card", -price);
        geton_plane(me, arg);
        inv[i]->add("left_money", -price);
        return 1;
      } else return notify_fail("你信用卡上的钱不够。\n");
    }
  }
  return notify_fail("您的信用卡呢？\n");
}

void geton_plane(object me, string dest) {
  object ob, plane, here;
  object *planes;
  int i;

  ob = this_object();
  here = environment(ob);
  planes = children("/std/room/plane");
  for (i = 0; i < sizeof(planes); i++) {
    if ((planes[i]->query("globe") == environment(ob)->query("globe"))
      && (planes[i]->query("order_from") == ob->name())
      && (planes[i]->query("dest") == dest)) {
      complete_geton(me, planes[i]);
      return;
    }
  }

  if (objectp(plane = new("/std/room/plane"))) {
    plane->set("globe", here->query("globe"));
    plane->set("order_from", ob->name());
    plane->set("dest", "/d/" + dest + "/starport");
    plane->set("exits/out", file_name(here));
    complete_geton(me, plane);
    return;
  }
  tell_object(me, "准备登机失败。\n");
  return;
}

void complete_geton(object me, object plane) {
  if (me->move(plane)) {
    message_vision(HIY "" + me->name()
      + "离开这里前往停机坪，大概是要乘坐民航班机吧。\n" NOR, this_object());
    tell_object(me, HIY "你离开这里登机，准备前往目的地了。\n" NOR);
    return;
  }
  tell_object(me, "登机失败。\n");
}
