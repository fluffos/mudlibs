#include <dbase.h>

int accept_learn(object me, string skill) {
  int betrayer;

  if (betrayer = me->query("betrayer")) {
    if (me->query_skill(skill, 1) >= this_object()->query_skill(skill, 1) - betrayer * 20) {
      message_vision("$N神色忧虑，也许是想起了$n的判国者身份。。。\n",
        this_object(), me);
      command("say 嗯。。。我的所知毕竟有限，也只能给你讲授到这个地步了。");
      return 0;
    }
  }

  if (!me->is_apprentice_of(this_object())
    && (int)this_object()->query_skill(skill, 1) <= (int)me->query_skill(skill, 1) * 3) {
    command("hmm");
    //		command("pat " + me->query("id"));
    command("say 虽然做为上司的应该体恤属下，但我实在忙于公干无从分身。。。");
    command("say 我只能向你介绍这些基本的技能，更高深的还是向" + me->query("family/master_name") + "请教吧。");
    return 0;
  }
  return 1;
}
