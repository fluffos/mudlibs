// rank.c Writen by Alarms 2/1/2000

#include <dbase.h>
#include <ansi.h>
#include <command.h>

string *garrison_e = ({ "odin", "odin", "iserlohn", "iserlohn" });
string *garrison_a = ({ "heinessen", "heinessen", "iserlohn", "iserlohn" });

void assign_garrison(object me);

int do_advance() {
  int size;
  string my_vassalage, rank, result, id, dir;
  string uniform_from, uniform_to, epaulet_txt, epaulet_to;
  mapping product;
  object me, ob, uniform, epaulet;

  me = this_player();
  ob = this_object();

  product = this_object()->query("product");

  if (!stringp(my_vassalage = me->query_space("vassalage"))
    || (my_vassalage == "中立")) {
    write(CYN + ob->name() + "说道：你是哪一支舰队的指挥官，我怎么没有见过你？\n" NOR);
    return 1;
  }
  if (my_vassalage != ob->query_space("vassalage")) {
    if (random(30 - me->query_kar())) {
      write(CYN + ob->name() + "说道：你是哪一支舰队的指挥官，我怎么没有见过你？\n" NOR);
      return 1;
    }
    message("vision", HIR "房间里忽然间警铃大作。\n" NOR, environment(ob), ({}));
    write(HIR "你的身份被" + ob->name() + HIR "识破了！\n" NOR);
    write("打起来的功能我还没有做:-P\n");
    return 1;
  }

  if (!me->query("promoted")) {
    if (!me->query_temp("abhor_by_rankman")) {
      me->set_temp("abhor_by_rankman", 1);
      write(CYN + ob->name() + "说道：以你现在的功绩还不足以晋升，继续努力吧。\n" NOR);
      return 1;
    } else if (me->query_temp("abhor_by_rankman") == 1) {
      me->add_temp("abhor_by_rankman", 1);
      write(CYN + ob->name() + "说道：你的功绩还不够，难道要我再说一次吗？退下吧！\n" NOR);
      return 1;
    }
    return 1;
  }

  if (me->query("rank") >= me->query("promoted")) {
    me->delete("promoted");
    write(CYN + ob->name() + "说道：以你现在的功绩还不足以晋升，继续努力吧。\n" NOR);
    return 1;
  } else {
    me->set("rank", me->query("promoted"));
    rank = SCORE_CMD->display_rank(me->query("rank"));
    if (my_vassalage == "帝国") {
      result = "$N单膝跪地，恭敬的听着$n宣读任命书。\n" CYN
        "$n说道：鉴于$N在数次战斗中的优异表现，现决定晋升$N为"
        +rank + "。\n" NOR;
      //			uniform_from = read_file("/obj/cloth/uniform_e.lpc");
    } else if (my_vassalage == "同盟") {
      result = "$N立正站好，恭敬的听着$n宣读任命书。\n" CYN
        "$n说道：鉴于$N在数次任务中的优异表现，现决定晋升$N为"
        +rank + "。\n" NOR;
      //			uniform_from = read_file("/obj/cloth/uniform_a.lpc");
    } else if (my_vassalage == "费沙") {
      result = "$N立正站好，恭敬的听着$n宣读任命书。\n" CYN
        "$n说道：鉴于$N在数次任务中的优异表现，现决定晋升$N为"
        +rank + "。\n" NOR;
      //			uniform_from = read_file("/obj/cloth/uniform_p.lpc");
    } else {
      result = "$N立正站好，恭敬的听着$n宣读任命书。\n" CYN
        "$n说道：鉴于$N在数次任务中的优异表现，现决定晋升$N为"
        +rank + "。\n" NOR;
      //			uniform_from = read_file("/obj/cloth/uniform.lpc");
    }
  }
  message_vision(result, me, ob);
  CHANNEL_D->do_channel(ob, "report", YEL + me->name() + "在首都接收晋升，官阶" + rank + "。\n" NOR);

  id = me->query("id");
  seteuid(ROOT_UID);

  //	uniform_to = DATA_DIR + "login/" + id[0..0] + "/" + id + "/uniform.lpc";
  epaulet_to = DATA_DIR + "login/" + id[0..0] + "/" + id + "/epaulet.lpc";
  dir = DATA_DIR + "login/" + id[0..0] + "/" + id + "/";
  epaulet_txt = read_file("/obj/cloth/epaulet.lpc");

  switch (me->query("rank")) {
    case 0:
      write("准尉没有肩章。\n");
      return 1;
      break;
    case 1:
      epaulet_txt = replace_string(epaulet_txt, "肩章", my_vassalage + "准尉肩章");
      epaulet_txt = replace_string(epaulet_txt, "长描述", my_vassalage + "准尉肩章的长描述");
      break;
    case 2:
      epaulet_txt = replace_string(epaulet_txt, "肩章", my_vassalage + "少尉肩章");
      epaulet_txt = replace_string(epaulet_txt, "长描述", my_vassalage + "少尉肩章的长描述");
      break;
    case 3:
      epaulet_txt = replace_string(epaulet_txt, "肩章", my_vassalage + "中尉肩章");
      epaulet_txt = replace_string(epaulet_txt, "长描述", my_vassalage + "中尉肩章的长描述");
      break;
    case 4:
      epaulet_txt = replace_string(epaulet_txt, "肩章", my_vassalage + "上尉肩章");
      epaulet_txt = replace_string(epaulet_txt, "长描述", my_vassalage + "上尉肩章的长描述");
      break;
    case 5:
      epaulet_txt = replace_string(epaulet_txt, "肩章", my_vassalage + "少校肩章");
      epaulet_txt = replace_string(epaulet_txt, "长描述", my_vassalage + "少校肩章的长描述");
      break;
    case 6:
      epaulet_txt = replace_string(epaulet_txt, "肩章", my_vassalage + "中校肩章");
      epaulet_txt = replace_string(epaulet_txt, "长描述", my_vassalage + "中校肩章的长描述");
      break;
    case 7:
      epaulet_txt = replace_string(epaulet_txt, "肩章", my_vassalage + "上校肩章");
      epaulet_txt = replace_string(epaulet_txt, "长描述", my_vassalage + "上校肩章的长描述");
      break;
    case 8:
      epaulet_txt = replace_string(epaulet_txt, "肩章", my_vassalage + "准将肩章");
      epaulet_txt = replace_string(epaulet_txt, "长描述", my_vassalage + "准将肩章的长描述");
      break;
    case 9:
      epaulet_txt = replace_string(epaulet_txt, "肩章", my_vassalage + "少将肩章");
      epaulet_txt = replace_string(epaulet_txt, "长描述", my_vassalage + "少将肩章的长描述");
      break;
    case 10:
      epaulet_txt = replace_string(epaulet_txt, "肩章", my_vassalage + "中将肩章");
      epaulet_txt = replace_string(epaulet_txt, "长描述", my_vassalage + "中将肩章的长描述");
      break;
    case 11:
      epaulet_txt = replace_string(epaulet_txt, "肩章", my_vassalage + "上将肩章");
      epaulet_txt = replace_string(epaulet_txt, "长描述", my_vassalage + "上将肩章的长描述");
      break;
    case 12:
      if (my_vassalage == "帝国") {
        epaulet_txt = replace_string(epaulet_txt, "肩章", my_vassalage + "一级上将肩章");
        epaulet_txt = replace_string(epaulet_txt, "长描述", my_vassalage + "一级上将肩章的长描述");
        break;
      } else {
        epaulet_txt = replace_string(epaulet_txt, "肩章", my_vassalage + "元帅肩章");
        epaulet_txt = replace_string(epaulet_txt, "长描述", my_vassalage + "元帅肩章的长描述");
        break;
      }
    case 13:
      epaulet_txt = replace_string(epaulet_txt, "肩章", my_vassalage + "元帅肩章");
      epaulet_txt = replace_string(epaulet_txt, "长描述", my_vassalage + "元帅肩章的长描述");
      break;
  }

  if (!pointerp(get_dir(dir)))
    if (!mkdir(dir)) return notify_fail("目录创建失败。\n");

  //	if( !write_file(uniform_to, uniform_from, 1) )
  //		return notify_fail("军服文件读写失败。\n");
  if (!write_file(epaulet_to, epaulet_txt, 1))
    return notify_fail("肩章文件读写失败。\n");

  //	if( objectp( find_object(uniform_to) ) )
  //		destruct(find_object(uniform_to));
  if (objectp(find_object(epaulet_to)))
    destruct(find_object(epaulet_to));

  //	if( !( uniform = new(uniform_to) ) )
  //		return notify_fail("军服载入失败。\n");
  //	uniform->move(me);

  if (objectp(epaulet = present("epaulet", me))) {
    destruct(epaulet);
    message_vision("$n收回了$N原来的旧肩章。\n", me, ob);
  }
  if (!(epaulet = new(epaulet_to)))
    return notify_fail("肩章载入失败。\n");
  epaulet->move(me);
  epaulet->wear();
  seteuid(getuid());

  message_vision("$n并将代表着新官阶的肩章交给了$N。\n", me, ob);

  me->delete("promoted");
  me->save();

  assign_garrison(me);

  return 1;
}

void assign_garrison(object me) {
  int rank, success_assigned = 0;
  string my_vassalage, old_garrison, str;

  rank = me->query("rank");
  my_vassalage = me->query_space("vassalage");
  old_garrison = me->query_space("garrison");

  if (my_vassalage == "帝国") {
    switch (rank) {
      case 0:
      case 1:
      case 2:
      case 3:
      case 4:
        return;
      case 5:
      case 6:
        if (old_garrison != garrison_e[0]) {
          me->set_space("garrison", garrison_e[0]);
          success_assigned = 1;
        }
        break;
      case 7:
      case 8:
        if (old_garrison != garrison_e[1]) {
          me->set_space("garrison", garrison_e[1]);
          success_assigned = 1;
        }
        break;
      case 9:
      case 10:
        if (old_garrison != garrison_e[2]) {
          me->set_space("garrison", garrison_e[2]);
          success_assigned = 1;
        }
        break;
      case 11:
      case 12:
        if (old_garrison != garrison_e[3]) {
          me->set_space("garrison", garrison_e[3]);
          success_assigned = 1;
        }
        break;
      default:
        if (old_garrison != garrison_e[0]) {
          me->set_space("garrison", garrison_e[0]);
          success_assigned = 1;
        }
    }
  } else if (my_vassalage == "同盟") {
    switch (rank) {
      case 0:
      case 1:
      case 2:
      case 3:
      case 4:
        return;
        //少校与中校
      case 5:
      case 6:
        if (old_garrison != garrison_a[0]) {
          me->set_space("garrison", garrison_a[0]);
          success_assigned = 1;
        }
        break;
        //上校与准将
      case 7:
      case 8:
        if (old_garrison != garrison_a[1]) {
          me->set_space("garrison", garrison_a[1]);
          success_assigned = 1;
        }
        break;
        //少将与中将
      case 9:
      case 10:
        if (old_garrison != garrison_a[2]) {
          me->set_space("garrison", garrison_a[2]);
          success_assigned = 1;
        }
        break;
        //上将以上阶级
      case 11:
      case 12:
        if (old_garrison != garrison_a[3]) {
          me->set_space("garrison", garrison_a[3]);
          success_assigned = 1;
        }
        break;
      default:
        if (old_garrison != garrison_a[0]) {
          me->set_space("garrison", garrison_a[0]);
          success_assigned = 1;
        }
    }
  } else if (my_vassalage == "费沙") {
    if (old_garrison != "phezzan") {
      me->set_space("garrison", "phezzan");
      success_assigned = 1;
    }
  } else {
    tell_object(me, "很可惜，你现在所加入的阵营还没有任何驻留基地。\n");
    return;
  }

  if (success_assigned)
    str = "$n宣读道：现指派$N赴" + to_chinese(me->query_space("garrison")) + "协助军事工作。\n";
  else str = "$n对$N说到：请回驻留基地继续工作吧。\n";

  message_vision(CYN + str + NOR, me, this_object());
}
