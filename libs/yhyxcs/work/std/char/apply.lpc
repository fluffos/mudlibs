// apply.c Writen by Alarms 1/28/2000

#include <dbase.h>
#include <ansi.h>


//"product":(["帝国战舰":200,"帝国炮舰":400])

void process_apply(string arg, object me);
void complete_apply(object me, int which, int eff_amt, int max_amt);

int can_provide, need, max;
string shiptype;

int do_apply(string arg) {
  int size, rank;
  string my_vassalage;
  mapping product;
  object me, ob;

  me = this_player();
  ob = this_object();

  product = this_object()->query("product");

  if (!arg || (sscanf(arg, "%d %s", need, shiptype) != 2)) {
    write("命令格式：apply <舰艇数目> <舰艇种类>\n");
    return 1;
  }

  if (!mapp(product)) {
    write(CYN + ob->name() + "说道：真抱歉，本星球现在还没有舰船生产能力。\n" NOR);
    return 1;
  }
  if (product[shiptype] < 1) {
    write(CYN + ob->name() + "说道：真抱歉，本星球现在还无法生产" + shiptype + "。\n" NOR);
    return 1;
  }
  if (!stringp(my_vassalage = me->query_space("vassalage"))
    || (my_vassalage == "中立")) {
    write(CYN + ob->name() + "说道：你是哪一支舰队的指挥官，我怎么没有见过你？\n" NOR);
    return 1;
  }
  if (my_vassalage != ob->query_space("vassalage")) {
    if (random(30 - me->query_kar())) {
      write(CYN + ob->name() + "说道：你是哪一支舰队的指挥官，我怎么没有见过你？\n" NOR);
      return 1;
    }
    message("vision", HIR "房间里忽然间警铃大作。\n" NOR, environment(ob), ({}));
    write(HIR "你的身份被" + ob->name() + HIR "识破了！\n" NOR);
    write("打起来的功能我还没有做:-P\n");
    return 1;
  }

  if (me->query_space("next_apply_time") > time()) {
    write(CYN + ob->name() + "说道：司令官这么快又要申请增加舰只，恐怕有些不妥吧？\n" NOR);
    return 1;
  }

  if (product[shiptype] < need) {
    write(CYN + ob->name() + "说道：以星球现在的生产水平来看，恐怕无法满足您的需求。\n" NOR);
    return 1;
  }

  //根据官阶看看是否有能力申请need那么多的舰艇
  rank = me->query("rank");
  switch (rank) {
    case 0:
      write(CYN + ob->name() + "说道：您还是列兵，不能申请舰队。\n" NOR);
      return 1;
      break;
      //准尉到上尉
    case 1:
    case 2:
    case 3:
    case 4:
      write(CYN + ob->name() + "说道：您还是尉官，不能申请舰队。\n" NOR);
      return 1;
      break;
      //少校
    case 5:
      if ((shiptype == "同盟战舰")
        || (shiptype == "帝国战舰")
        || (shiptype == "同盟高速战舰")
        || (shiptype == "帝国高速战舰")
        || (shiptype == "同盟宇宙母舰")
        || (shiptype == "帝国宇宙母舰")
        || (shiptype == "同盟驱逐舰")
        || (shiptype == "帝国驱逐舰")
        || (shiptype == "同盟巡航舰")
        || (shiptype == "帝国巡航舰")
        || (shiptype == "同盟炮舰")
        || (shiptype == "帝国炮舰")) {
        write(CYN + ob->name() + "说道：您的官阶还不足以申请这个舰种。\n" NOR);
        return 1;
      }
      if (need > 100) {
        write(CYN + ob->name() + "说道：您的官阶还不足以一次申请如此多的舰只。\n" NOR);
        return 1;
      }
      max = 100;
      break;
      //中校
    case 6:
      if ((shiptype == "同盟战舰")
        || (shiptype == "帝国战舰")
        || (shiptype == "同盟高速战舰")
        || (shiptype == "帝国高速战舰")
        || (shiptype == "同盟宇宙母舰")
        || (shiptype == "帝国宇宙母舰")
        || (shiptype == "同盟驱逐舰")
        || (shiptype == "帝国驱逐舰")
        || (shiptype == "同盟巡航舰")
        || (shiptype == "帝国巡航舰")) {
        write(CYN + ob->name() + "说道：您的官阶还不足以申请这个舰种。\n" NOR);
        return 1;
      }
      if (need > 200) {
        write(CYN + ob->name() + "说道：您的官阶还不足以一次申请如此多的舰只。\n" NOR);
        return 1;
      }
      max = 200;
      break;
      //上校
    case 7:
      if ((shiptype == "同盟战舰")
        || (shiptype == "帝国战舰")
        || (shiptype == "同盟高速战舰")
        || (shiptype == "帝国高速战舰")
        || (shiptype == "同盟宇宙母舰")
        || (shiptype == "帝国宇宙母舰")
        || (shiptype == "同盟驱逐舰")
        || (shiptype == "帝国驱逐舰")) {
        write(CYN + ob->name() + "说道：您的官阶还不足以申请这个舰种。\n" NOR);
        return 1;
      }
      if (need > 400) {
        write(CYN + ob->name() + "说道：您的官阶还不足以一次申请如此多的舰只。\n" NOR);
        return 1;
      }
      max = 400;
      break;
      //准将
    case 8:
      if ((shiptype == "同盟战舰")
        || (shiptype == "帝国战舰")
        || (shiptype == "同盟高速战舰")
        || (shiptype == "帝国高速战舰")
        || (shiptype == "同盟宇宙母舰")
        || (shiptype == "帝国宇宙母舰")) {
        write(CYN + ob->name() + "说道：您的官阶还不足以申请这个舰种。\n" NOR);
        return 1;
      }
      if (need > 800) {
        write(CYN + ob->name() + "说道：您的官阶还不足以一次申请如此多的舰只。\n" NOR);
        return 1;
      }
      max = 800;
      break;
      //少将
    case 9:
      if ((shiptype == "同盟高速战舰")
        || (shiptype == "帝国高速战舰")
        || (shiptype == "同盟宇宙母舰")
        || (shiptype == "帝国战舰")) {
        write(CYN + ob->name() + "说道：您的官阶还不足以申请这个舰种。\n" NOR);
        return 1;
      }
      if (need > 1000) {
        write(CYN + ob->name() + "说道：您的官阶还不足以一次申请如此多的舰只。\n" NOR);
        return 1;
      }
      max = 1000;
      break;
      //中将
    case 10:
      if ((shiptype == "同盟宇宙母舰")
        || (shiptype == "帝国高速战舰")) {
        write(CYN + ob->name() + "说道：您的官阶还不足以申请这个舰种。\n" NOR);
        return 1;
      }
      if (need > 1500) {
        write(CYN + ob->name() + "说道：您的官阶还不足以一次申请如此多的舰只。\n" NOR);
        return 1;
      }
      max = 1500;
      break;
      //上将
    case 11:
      if (need > 2000) {
        write(CYN + ob->name() + "说道：您一次申请如此多的舰只，恐怕并不太合适吧？\n" NOR);
        return 1;
      }
      max = 2000;
      break;
      //(一级上将)，元帅
    case 12:
    case 13:
      max = 2000;
      break;
    default:
      max = 2000;
  }

  if (pointerp(me->query_space("sub_fleet"))) {
    if (me->query_space("garrison") != environment(ob)->query("globe")) {
      write(CYN + ob->name() + "说道：司令官的舰队并不是本星球的驻留舰队，无法为您进行部队改编。\n" NOR);
      return 1;
    }
    if (me->query_space("landin") != environment(ob)->query("globe")) {
      write(CYN + ob->name() + "说道：司令官的舰队并不在本星球，无法为您进行部队改编。\n" NOR);
      return 1;
    }
  }

  if (size = sizeof(me->query_space("sub_fleet")))
    write("您的舰队有" + chinese_number(size) + "个部队。现在请输入需要申请舰只的部队：(退出按Q)");
  else write("您还没有舰队。现在请输入需要申请舰只的部队：(退出按Q)");
  input_to("process_apply", me);
  return 1;
}

void process_apply(string arg, object me) {
  int which, size;
  string quit;
  mapping fleet;

  sscanf(arg, "%s", quit);
  if ((quit == "Q") || (quit == "q")) return;

  if (!arg || (sscanf(arg, "%d", which) != 1)) {
    write("请输入需要申请舰只的部队：");
    input_to("process_apply", me);
    return;
  }
  if (which < 1) {
    write("请输入需要申请舰只的部队：");
    input_to("process_apply", me);
    return;
  }

  size = sizeof(me->query_space("sub_fleet"));
  if (which <= size) {
    which -= 1;
    fleet = me->query_sub_fleet(which);
    if (fleet["eff_amt"] >= fleet["max_amt"]) {
      write("此部队已经满额，请输入需要申请舰只的部队：");
      input_to("process_apply", me);
      return;
    }
    if (fleet["shiptype"] != shiptype) {
      write("此部队舰种不是" + shiptype + "，请输入需要申请舰只的部队：");
      input_to("process_apply", me);
      return;
    }
    complete_apply(me, which, fleet["eff_amt"], fleet["max_amt"]);
    return;
  }
  if (which > size /*&& 根据官阶判断是否能够申请新的分舰队*/) {
    switch (me->query("rank")) {
      case 0:
        write("您现在还只是个列兵，没法申请舰队。\n");
        return;
      case 1:
      case 2:
      case 3:
      case 4:
        write("您现在还只是个尉官，没法申请舰队。\n");
        return;
      case 5:
        if (which > 1) {
          write("您最多只能拥有一支部队，请输入需要申请舰只的部队：");
          input_to("process_apply", me);
          return;
        }
        break;
      case 6:
        if (which > 2) {
          write("您最多只能拥有两支部队，请输入需要申请舰只的部队：");
          input_to("process_apply", me);
          return;
        }
        break;
      case 7:
        if (which > 3) {
          write("您最多只能拥有三支部队，请输入需要申请舰只的部队：");
          input_to("process_apply", me);
          return;
        }
        break;
      case 8:
        if (which > 4) {
          write("您最多只能拥有四支部队，请输入需要申请舰只的部队：");
          input_to("process_apply", me);
          return;
        }
        break;
      case 9:
        if (which > 5) {
          write("您最多只能拥有五支部队，请输入需要申请舰只的部队：");
          input_to("process_apply", me);
          return;
        }
        break;
      case 10:
        if (which > 6) {
          write("您最多只能拥有六支部队，请输入需要申请舰只的部队：");
          input_to("process_apply", me);
          return;
        }
        break;
      case 11:
        if (which > 7) {
          write("您最多只能拥有七支部队，请输入需要申请舰只的部队：");
          input_to("process_apply", me);
          return;
        }
        break;
      case 12:
      case 13:
        if (which > 8) {
          write("您最多只能拥有八支部队，请输入需要申请舰只的部队：");
          input_to("process_apply", me);
          return;
        }
        break;
      default:
        if (which > 8) {
          write("您最多只能拥有八支部队，请输入需要申请舰只的部队：");
          input_to("process_apply", me);
          return;
        }
    }
    if (need <= max) {
      me->add_sub_fleet(shiptype, "测试", need, max);
      me->set_space("next_apply_time", time() + 7200);
      me->set_space("landin", environment(this_object())->query("globe"));
      write("OK!\n");
      return;
    } else {
      me->add_sub_fleet(shiptype, "", max, max);
      need -= max;
      me->set_space("landin", environment(this_object())->query("globe"));
      write("OK!\n");
      write("还有" + sprintf("%d", need) + "艘" + shiptype + "可以供您分配，请输入需要申请舰只的部队：");
      input_to("process_apply", me);
      return;
    }
  }
  return;
}

void complete_apply(object me, int which, int eff_amt, int max_amt) {
  if (eff_amt + need <= max_amt) {
    me->set_sub_fleet(which, "eff_amt", eff_amt + need);
    me->set_space("landin", environment(this_object())->query("globe"));
    write("OK!\n");
    me->set_space("next_apply_time", time() + 7200);
    return;
  }
  need -= max_amt - eff_amt;
  me->set_sub_fleet(which, "eff_amt", max_amt);
  me->set_space("landin", environment(this_object())->query("globe"));
  me->set_space("next_apply_time", time() + 7200);
  write("OK!\n");
  write("还有" + sprintf("%d", need) + "艘" + shiptype + "可以供您分配，请输入需要申请舰只的部队：");
  input_to("process_apply", me);
  return;
}
