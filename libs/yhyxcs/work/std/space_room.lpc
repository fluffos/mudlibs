//Update by Alarms 5/9/99



#include <dbase.h>

inherit F_DBASE;
inherit F_CLEAN_UP;

int query_max_encumbrance()
{
	return 100000000000;
}

int is_space_room() { return 1; }

object make_inventory( string file )
{
	object ob;

	ob = new( file );

	if( !ob ) return 0;
	ob->move( this_object() );
	return ob;
}

void reset()
{
	mapping ob_list, ob;
	string *list;
	int i, j, temp_list;
	object temp_ob;

	//
	// Check loaded objects to match the objects specified in "objects"
	// while query("objects") is 
	// ([ <object filename>: <amount>, ..... ])
	// and query_temp("objects") is
	// ([ <object filename>: ({ob1, ob2, ...}), .... ])
	//
	set( "no_clean_up", 1 );
	ob_list = query( "objects" );
	if ( !mapp( ob_list ) ) return;
	
	ob = query_temp( "objects" );
	if ( !mapp( ob ) )
		ob = allocate_mapping( sizeof( ob_list ) );
	list = keys( ob_list );
	for ( i = 0; i < sizeof( list ); i++ )
	{
		temp_list = ob_list[ list[ i ] ];

		// Allocate an array if we have multiple same object specified.
		if ( undefinedp( ob[ list[ i ] ] ) &&
			 intp( temp_list ) && temp_list > 1 )
		{
			ob[ list[ i ] ] = allocate( temp_list );
		}

		switch( temp_list )
		{
		case 1:
			if ( !ob[ list[ i ] ] )
				ob[ list[ i ] ] = make_inventory( list[ i ] );
			temp_ob = ob[ list[ i ] ];
			if ( environment( temp_ob ) != this_object() &&
				 temp_ob->is_character() )
			{
				if ( !temp_ob->return_home( this_object() ) )
					add( "no_clean_up", 1 );
			}
			break;
	
		default:
			for ( j = 0; j < temp_list; j++ )
			{
				// If the object is gone, make another one.
				if ( !objectp( ob[ list[ i ] ][ j ] ) )
				{
					ob[ list[ i ] ][ j ] = make_inventory( list[ i ] );
					continue;
				}
				temp_ob = ob[ list[ i ] ][ j ];

				// Try to call the wandering npc come back here.
				if ( environment( temp_ob ) != this_object() &&
					 temp_ob->is_character() )
				{
					if ( !temp_ob->return_home( this_object() ) )
						add( "no_clean_up", 1 );
				}
			}
		}
	}
	set_temp( "objects", ob );
}


int valid_leave(object me, string dir)
{
	return 1;
}


void setup()
{
	seteuid( getuid() );
	this_object()->reset();
}
