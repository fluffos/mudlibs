// equip.c

inherit ITEM;
inherit F_EQUIP;

void setup() {
  if (clonep(this_object())) return;

  if (weight() > 30000) {
    if (query("armor_prop") && !query("armor_prop/dodge"))
      set("armor_prop/dodge", -weight() / 3000);
    if (query("weapon_prop") && !query("weapon_prop/dodge"))
      set("weapon_prop/dodge", -weight() / 3000);
  }
}
