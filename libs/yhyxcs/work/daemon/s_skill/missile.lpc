inherit S_SKILL;

string *missile_msg = ({
//	"“锁定目标，弹道飞弹发射！”发令官的声音在整个舰桥回荡着！\n",
	"视线所及的宇宙空间也都闪着白光，似乎飞弹永远也炸不完似的··\n",
	"不胜计数和飞弹交错飞射，炸裂的舰体随着能源的风暴在空中扭曲飞舞···\n",
	"雷射氢爆飞弹如凶猛的猎犬般急袭而去，四处绽开爆炸的火光··\n",
	"飞弹爆炸所发出的声音和闪光充斥整个太空···\n",
	"飞弹扫射而下，眩目的闪光如汹涌的漩涡袭卷各处···\n",
	"爆炸的光芒划破了黑暗，被撕裂的舰体在宇宙中片片飞散···\n",
	"这种不经核分裂而以雷射的超高热引发核融合的兵器飞速向死神的召唤奔去··\n",
	"空中飞弹密集而交错，好像一面没有极限的电网一样··\n",
	"只见闪烁的火球在黑暗里灼灼发光，亮得有如宝石一般···\n",
	"飞弹爆炸所及之地转眼之间化为乌有，留下的尸体也将还原为原子回归宇宙虚空··\n",
});

string query_msg()
{
        
	return missile_msg[random(sizeof(missile_msg))];
     
}

int valid_learn(object me) { return 1; }