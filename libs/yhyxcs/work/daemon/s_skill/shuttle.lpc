//shuttle.c Writen by Alarms 8/22/99

#include <ansi.h>

inherit S_SKILL;
inherit F_CURRENT;

int att_coefficient() { return 20; }
int def_coefficient() { return 5; }
int efficient_level() { return 10; }

int valid_enable(string usage)
{
	return usage=="formation";
}

int valid_learn(object me)
{
	int skill,learned;

	skill = me->query_s_skill("formation",1);
	learned = me->query_s_skill("shuttle",1);

	if( learned >= skill ) return 0;
	else return 1;
}

int three_attack(object me,int i,string arg)
{
	object env,victim,*targets;
	mapping *all_sub_fleet;

	if( !me->is_combating() ) return 0;
	if( !(env = environment(me)) ) return 0;
	if( !env->is_space_room() && !env->is_planet() ) return 0;

	if( stringp(arg) && ( arg != "" ) )
	{
		if( !(victim = present(arg,env)) )
			return 0;
		if( !F_DISTANCE->calculate_distance(me,victim,me->query_space("scouting")) )
			return 0;
	}
	else if( sizeof(targets=me->query_againster()) == 1)
		victim = targets[0];
	else victim = targets[random(sizeof(targets))];

	if( !objectp(victim) ) return 0;
	if( !objectp(me) ) return 0;
	if( !living(me) || !living(victim) ) return 0;

	targets = S_COMBAT_D->combat_no_vision(me,victim);
	all_sub_fleet = me->query_space("sub_fleet");
	if( i == 1 )
	{
		message("vision",HIY"\n" + me->space_short(1) + "的阵型开始重新整形，慢慢对正舰队指向，掉转炮口对准"
			+ victim->space_short(1) + "\n\n"NOR,env,targets);
		tell_object(me,HIW"\n军事工作官报告，我军舰队开始整型，全舰队指向" + victim->space_short(1)
			+ "，所有部队准备主炮攻击！\n\n"NOR);
		tell_object(victim,HIW"\n军事工作官报告，发现" + me->space_short(1)
			+ "停止攻击并开始整型，将舰队朝向全部指向我军！\n\n"NOR);

		for(i=0;i<sizeof(all_sub_fleet);i++)
		{
			all_sub_fleet[i]["attacktype"] = "beam";
		}
		return 1;
	}
	if( i == 2 )
	{
		tell_object(me,YEL"\n全舰主炮、三发齐射！你的命令奔驰在通讯回路上。\n\n"NOR);
		tell_object(victim,HIR"\n" + me->space_short(1) + "所有部队打开炮门，向我军齐连三射！\n\n"NOR);
		message("vision",YEL"\n" + me->space_short(1) + "所有部队打开炮门，向" + victim->space_short(1)
			+"齐连三射！\n\n"NOR,env,targets);

		message("vision",YEL"\n  似乎整个宇宙被白光包围了起来，沸腾的能量浊流旋在虚空中，灼
势的黑暗以那巨大的手掌要压碎舰艇。舰体的外面是无限大的沉默，
炸裂的光芒装饰了恐饰的序幕。\n\n"NOR,env,targets);

		tell_object(me,YEL"\n  似乎整个宇宙被白光包围了起来，沸腾的能量浊流旋在虚空中，灼
势的黑暗以那巨大的手掌要压碎舰艇。舰体的外面是无限大的沉默，
炸裂的光芒装饰了恐饰的序幕。\n\n第一波攻击开始！！！\n\n"NOR);

		tell_object(victim,HIR"\n  似乎整个宇宙被白光包围了起来，沸腾的能量浊流旋在虚空中，灼
势的黑暗以那巨大的手掌要压碎舰艇。舰体的外面是无限大的沉默，
炸裂的光芒装饰了恐饰的序幕。\n\n我军遭到第一波攻击！！！\n\n"NOR);

		S_COMBAT_D->combat(me,victim);

		tell_object(me,YEL"\n第二波攻击开始！！！\n\n"NOR);
		tell_object(victim,HIR"\n我军遭到第二波攻击！！！\n\n"NOR);
		S_COMBAT_D->combat(me,victim);

		for(i=0;i<sizeof(all_sub_fleet);i++)
		{
			if( all_sub_fleet[i]["energy"] < 200 )
				all_sub_fleet[i]["energy"] = 0;
			else all_sub_fleet[i]["energy"] -= 200;
		}

		message("vision",YEL"整个宇宙被白光包围了起来。\n\n"NOR,env,targets);
		tell_object(me,YEL"\n第三波攻击开始！！！\n\n"NOR);
		tell_object(victim,HIR"\n我军遭到第三波攻击！！！\n\n"NOR);
		S_COMBAT_D->combat(me,victim);
		return 1;
	}
}

varargs int specify(object me,string specify,string victim)
{
	mapping fleets;
	int i, check1=0, check2=0;

	if( specify == "three_attack" )
	{
		fleets = me->query_space("sub_fleet");
		for(i=0;i<sizeof(fleets);i++)
		{
			if( fleets[i]["energy"] > 200 ) check1++;
			if( !F_S_ATTRIBUTE->query_base_beam(fleets[i]["shiptype"]) )
				continue;
			check2++;
		}
		if( check2*2 < sizeof(fleets) )
		{
			tell_object(me,"我军部队大部分都没有装备主炮，无法使出特殊攻击。\n");
			return 1;
		}
		if( check1*2 < sizeof(fleets) )
		{
			tell_object(me,"我军各部队能源匮乏，无法使出特殊攻击。\n");
			return 1;
		}
		if( me->query_s_skill("shuttle",1) < 50 )
		{
			tell_object(me,"你的梭形阵能力实在太低，无法使出特殊攻击。\n");
			return 1;
		}
		if( !stringp(victim) ) victim = "";

//		if( me->query_s_skill("shuttle",1) < 100 )
//		{
			add_command(me,({"shuttle","three_attack",1,victim}));
			add_command(me,({"shuttle","three_attack",2,victim}));
			return 1;
//		}
//		else
//		{
//			add_command(me,({"shuttle","super_three_attack",1,victim}));
//			add_command(me,({"shuttle","super_three_attack",2,victim}));
//			add_command(me,({"shuttle","super_three_attack",3,victim}));
//			add_command(me,({"shuttle","super_three_attack",4,victim}));
//			return 1;
//		}
	}
	return 0;
}
