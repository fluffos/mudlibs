#include <ansi.h>

inherit S_SKILL;
inherit F_CURRENT;

int att_coefficient() { return 10; }
int def_coefficient() { return 15; }
int efficient_level() { return 10; }

int valid_enable(string usage)
{
	return usage=="formation";
}

int valid_learn(object me)
{
	int skill,learned;

	skill = me->query_s_skill("formation",1);
	learned = me->query_s_skill("fovea",1);

	if( learned >= skill ) return 0;
	else return 1;
}

int focus_on_point(object me,int i,string arg)
{
	object env,victim,*targets;
	mapping *my_fleets, *victim_fleets;
	int j;

	if( !me->is_combating() ) return 0;
	if( !(env = environment(me)) ) return 0;
	if( !env->is_space_room() && !env->is_planet() ) return 0;

	if( stringp(arg) && ( arg != "" ) )
	{
		if( !(victim = present(arg,env)) )
			return 0;
		if( !F_DISTANCE->calculate_distance(me,victim,me->query_space("scouting")) )
			return 0;
	}
	else if( sizeof(targets=me->query_againster()) == 1)
		victim = targets[0];
	else victim = targets[random(sizeof(targets))];

	if( !objectp(victim) ) return 0;
	if( !objectp(me) ) return 0;
	if( !living(me) || !living(victim) ) return 0;

	targets = S_COMBAT_D->combat_no_vision(me,victim);
	my_fleets = me->query_space("sub_fleet");
	if( i == 1 )
	{
		message("vision",HIY"\n" + me->space_short(1) + "整理阵型，将凹形的焦点对准了"
			+ victim->space_short(1) + "\n\n"NOR,env,targets);
		tell_object(me,HIW"\n军事工作官报告，我军舰全舰队拉开阵列，将" + victim->space_short(1)
			+ "锁定在最强攻击焦点！\n\n"NOR);
		tell_object(victim,HIW"\n军事工作官报告，发现" + me->space_short(1)
			+ "停止攻击并整理阵型，将凹形焦点对准我军！\n\n"NOR);
		return 1;
	}
	else
	{
		j = random(sizeof(victim->query_space("sub_fleet"))) + 1;
		me->set_space("attack_focus", j );
		tell_object(me,YEL"\n命令在在通讯回路中流动：焦点锁定敌军第" + chinese_number(j)
			+ "部队，攻击！！\n\n"NOR);

		tell_object(victim,HIR"\n" + me->space_short(1) + "所有部队同时向我军第" + chinese_number(j)
			+ "部队发动攻击！！\n\n"NOR);
		message("vision",YEL"\n" + me->space_short(1) + "将凹形阵的焦点对准" + victim->space_short(1)
			+"，开始攻击！！\n\n"NOR,env,targets);

		for(j=0;j<sizeof(my_fleets);j++)
		{
			if( my_fleets[j]["energy"] < 1 )
			{
				tell_object(me,HIW"\n我军第" + chinese_number(j+1) + "能源不足，无法成战术目的。\n\n"NOR);
				continue;
			}
			if( my_fleets[j]["energy"] < 50 )
				my_fleets[j]["energy"] = 0;
			else my_fleets[j]["energy"] -= 50;
		}

		tell_object(me,YEL"\n第" + chinese_number(i-1) + "波攻击开始！！！\n\n"NOR);
		tell_object(victim,HIR"\n我军遭到敌军第" + chinese_number(i-1) + "波攻击！！！\n\n"NOR);
		S_COMBAT_D->combat(me,victim);
		me->delete_space("attack_focus");
		return 1;
	}
	return 0;
}

varargs int specify(object me,string specify,string victim)
{
	mapping fleets;
	int i, check1=0, check2=0;

	if( specify == "focus_on_point" )
	{
		if( me->query_s_skill("fovea",1) < 50 )
		{
			tell_object(me,"你的凹形阵能力实在太低，无法使出特殊攻击。\n");
			return 1;
		}
		if( !stringp(victim) ) victim = "";

			add_command(me,({"fovea","focus_on_point",1,victim}));
			add_command(me,({"fovea","focus_on_point",2,victim}));
			add_command(me,({"fovea","focus_on_point",3,victim}));
			add_command(me,({"fovea","focus_on_point",4,victim}));
			add_command(me,({"fovea","focus_on_point",5,victim}));
			add_command(me,({"fovea","focus_on_point",6,victim}));
			return 1;
	}
	return 0;
}
