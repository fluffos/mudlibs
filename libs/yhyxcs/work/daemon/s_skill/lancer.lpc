#include <ansi.h>

inherit S_SKILL;
inherit F_CURRENT;

int efficient_level() { return 15; }

int valid_enable(string usage) {
  return usage == "beam";
}

int valid_learn(object me) {
  int skill, learned;

  skill = me->query_s_skill("beam", 1);
  learned = me->query_s_skill("lancer", 1);

  if (learned >= skill) {
    //		tell_object(me,"你的主炮攻击技术还不够高，所以无法深入的学习枪骑兵攻击这项技能。\n");
    return 0;
  } else return 1;
}

void remove_powerup(object me) {
  if (!living(me)) return;

  me->delete_space_temp("apply");
  message_vision(YEL "通信回路中回响着的$N的声音终于渐渐平静了。。。\n" NOR, me);
  tell_object(me, YEL "能力提升的效果已经结束。\n" NOR);
}

int complete_powerup(object me, int i, string skill) {
  object env, targets;
  int j, add_on;

  if (!stringp(skill) || (skill == ""))
    return 0;

  if (!me->is_combating()) return 0;
  if (!(env = environment(me))) return 0;
  if (!env->is_space_room() && !env->is_planet()) return 0;

  if (!living(me)) return 0;

  if (efficient_level() == 0) add_on = me->query_s_skill("lancer", 1);
  else add_on = me->query_s_skill("lancer", 1) * efficient_level() / 10;

  if (me->query("sen") > 50)
    me->receive_damage("sen", 50);
  else {
    tell_object(me, "你的精力不怎么好，怎么提升能力呢？\n");
    return 0;
  }
  me->set_space_temp("apply/" + skill, add_on);
  message_vision(YEL "通信回路中回响$N激扬的声音：胜利女神已经向我们掀起裙子啦！！\n" NOR, me);
  tell_object(me, YEL "全舰队主炮攻击能力提升！！\n" NOR);

  if (add_on < 20) add_on = 20;
  remove_call_out("remove_powerup");
  call_out("remove_powerup", add_on / 4 + random(add_on / 4), me);
  return 1;
}

//arg是基本技能名称
int powerup(object me, string arg) {
  mapping fleets;
  int i, check1 = 0, check2 = 0;

  if (me->query_s_skill_mapped(arg) != "lancer") return 0;

  if (me->query_s_skill("lancer", 1) < 50) {
    tell_object(me, "你的枪骑兵攻击能力实在太低，无法使出能力提升。\n");
    return 1;
  }
  if (!me->is_combating()) {
    tell_object(me, "枪骑兵攻击的能力提升只能在战斗中使用。\n");
    return 1;
  }
  switch (arg) {
    case "beam":
      //	   case "missile":
      add_command(me, ({ "lancer", "complete_powerup", 1, arg }));
      return 1;
    default:
      return 0;
  }
  return 0;
}
