###############################################################################
#              Customizable runtime config file for FluffOS                   #
###############################################################################
# Adapted from the original bin/primal.mud (MudOS v21-era config) shipped in
# the ehershey/pd source repo. See AGENTS.md for the conversion notes.
###############################################################################

# name of this mud
name : Primal Darkness-II

# port number to accept users on
port number : 40254

# absolute pathname of mudlib
mudlib directory : /home/sunyc/src/mudlib/libs/pd/work

# debug.log and author/domain stats are stored here
log directory : /log

# the directories which are searched by #include <...>
include directories : /adm/include:/include:/include/domains:/include/std:/include/daemon:/include/cmds

# Directory to save binaries in.  (if BINARIES is defined)
save binaries directory : /binaries

# the file which defines the master object
master file : /adm/obj/master

# the file where all global simulated efuns are defined.
simulated efun file : /adm/obj/simul_efun

# This is an include file which is automatically #include'd in all objects
global include file : "/include/std/std.h"

# alternate debug.log file name (assumed to be in specified 'log directory')
debug log file : debug.log

# if an object is left alone for a certain time, then the
# function clean_up will be called.
time to clean up : 1200

# How long time until an unused object is swapped out.
time to swap : 0

# How many seconds until an object is reset again.
time to reset : 1200

# Maximum number of bits in a bit field.
maximum bits in a bitfield : 1200

# Max number of local variables in a function.
maximum local variables : 30

# Maximum amount of "eval cost" per thread.
maximum evaluation cost : 60000000

# This is the maximum array size allowed for one single array.
maximum array size : 15000

# This is the maximum allowed size of a variable of type 'buffer'.
maximum buffer size : 400000

# Max size for a mapping
maximum mapping size : 15000

# Max inherit chain size
inherit chain size : 30

# maximum length of a string variable
maximum string length : 200000

# Max size of a file allowed to be read by 'read_file()'.
maximum read file size : 60000

# max number of bytes you allow to be read and written with read_bytes
# and write_bytes
maximum byte transfer : 8000

# Define the size of the shared string hash table.
hash table size : 7001

# Object hash table size.
object table size : 7501

# default no-matching-action message
default fail message : What?

# default message when error() occurs (optional)
default error message : !ERROR! This is a bug. Please contact an admin.

# maximum number of users
maximum users : 40

# Define the maximum stack size of the stack machine.
evaluator stack size : 1000

# Define the size of the compiler stack.
compiler stack size : 200

# Define the maximum call depth for functions.
maximum call depth : 30

# There is a hash table for living objects, used by find_living().
living hash table size : 100
