#include <std.h>
#include <castlewall.h>
inherit MONSTER;

int i;

void create() {
  ::create();
  set_name("Patrol Commander");
  set_short("Patrol Commander");
  set_id(({ "monster", "commander", "patrol commander" }));
  set_long("A rather huge person, the Patrol Commander looks like he is not a person to be messed with.");
  set_level(50 + random(25));
  set_swarm("");
  set_gender("male");
  set_race("human");
  set_class("fighter");
  set_subclass("warrior");
  set_spell_chance(40);
  set_moving(1);
  set_speed(3);
  set_spells(({ "slash" }));
  set_body_type("sacron");

  {
    object new_ob = new(EQ "battlearmour");
    if (new_ob) new_ob->move(this_object());
  }
  force_me("wear armour");

  {
    object new_ob = new(EQ "boneleggings");
    if (new_ob) new_ob->move(this_object());
  }
  force_me("wear leggings");

  {
    object new_ob = new(EQ "pbracers");
    if (new_ob) new_ob->move(this_object());
  }
  force_me("wear bracers");

  {
    object new_ob = new(EQ "light");
    if (new_ob) new_ob->move(this_object());
  }
  force_me("wear light");

  {
    object new_ob = new(EQ "vest");
    if (new_ob) new_ob->move(this_object());
  }
  force_me("wear vest");

  {
    object new_ob = new(EQ "medallion");
    if (new_ob) new_ob->move(this_object());
  }
  force_me("wield medallion");

  {
    object new_ob = new(WEAP "rapture");
    if (new_ob) new_ob->move(this_object());
  }
  force_me("wield sword");

  {
    object new_ob = new(WEAP "broadsword");
    if (new_ob) new_ob->move(this_object());
  }
  force_me("wield sword");

  {
    object new_ob = new(WEAP "cblade");
    if (new_ob) new_ob->move(this_object());
  }
  force_me("wield blade");
}
