#include <std.h>
#include <castlewall.h>
inherit MONSTER;

int i;

void create() {
  ::create();
  set_name("Dark Archer");
  set_short("%^BOLD%^%^BLACK%^Dark Archer%^RESET%^");
  set_id(({ "monster", "archer" }));
  set_long("One of the band of %^BOLD%^%^BLACK%^Dark Archers%^RESET%^ summoned by the royal magician to defend the walls of Purgatory.");
  set_level(50 + random(25));
  set("aggressive", 55);
  set_swarm("");
  set_gender("male");
  set_race("human");
  set_class("fighter");
  set_subclass("ranger");
  set_body_type("raknid");
  set_spell_chance(39);
  set_spells(({ "slash" }));

  {
    object new_ob = new(EQ "quiver");
    if (new_ob) new_ob->move(this_object());
  }
  force_me("wear quiver");

  {
    object new_ob = new(WEAP "longbow");
    if (new_ob) new_ob->move(this_object());
  }
  force_me("wield bow");

  {
    object new_ob = new(WEAP "shortsword");
    if (new_ob) new_ob->move(this_object());
  }
  force_me("wield sword");

  {
    object new_ob = new(EQ "darkarmour");
    if (new_ob) new_ob->move(this_object());
  }
  force_me("wear armour");

  {
    object new_ob = new(EQ "spiderleggings");
    if (new_ob) new_ob->move(this_object());
  }
  force_me("wear leggings");
}
