#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "southeast": KEEPROOM "zforest/x11y11.lpc",
    "southwest": KEEPROOM "zforest/x11y9.lpc",
    "east": KEEPROOM "zforest/x10y11.lpc",
    "west": KEEPROOM "zforest/x10y9.lpc",
  ]));
}
