#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "north": KEEPROOM "zforest/x17y27.lpc",
    "northwest": KEEPROOM "zforest/x17y26.lpc",
    "southeast": KEEPROOM "zforest/x19y28.lpc",
    "southwest": KEEPROOM "zforest/x19y26.lpc",
  ]));
}
