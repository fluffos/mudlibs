#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "northwest": KEEPROOM "zforest/x10y27.lpc",
    "west": KEEPROOM "zforest/x11y27.lpc",
    "southwest": KEEPROOM "zforest/x12y27.lpc",
    "southeast": KEEPROOM "zforest/x12y29.lpc",
  ]));
}
