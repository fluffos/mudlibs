#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "south": KEEPROOM "zforest/x7y10.lpc",
    "northwest": KEEPROOM "zforest/x5y9.lpc",
    "southeast": KEEPROOM "zforest/x7y11.lpc",
  ]));
}
