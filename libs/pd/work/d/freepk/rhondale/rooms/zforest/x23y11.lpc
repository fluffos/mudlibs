#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "west": KEEPROOM "zforest/x23y10.lpc",
    "northeast": KEEPROOM "zforest/x22y12.lpc",
    "southeast": KEEPROOM "zforest/x24y12.lpc",
  ]));
}
