#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "northwest": KEEPROOM "zforest/x2y17.lpc",
    "northeast": KEEPROOM "zforest/x2y19.lpc",
    "south": KEEPROOM "zforest/x4y18.lpc",
    "southeast": KEEPROOM "zforest/x4y19.lpc",
  ]));
}
