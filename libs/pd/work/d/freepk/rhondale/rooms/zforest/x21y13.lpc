#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "northwest": KEEPROOM "zforest/x20y12.lpc",
    "east": KEEPROOM "zforest/x21y14.lpc",
    "southwest": KEEPROOM "zforest/x22y12.lpc",
  ]));
}
