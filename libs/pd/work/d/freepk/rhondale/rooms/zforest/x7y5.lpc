#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "south": KEEPROOM "zforest/x8y5.lpc",
    "southeast": KEEPROOM "zforest/x8y6.lpc",
    "north": KEEPROOM "zforest/x6y5.lpc",
    "northeast": KEEPROOM "zforest/x6y6.lpc",
  ]));
}
