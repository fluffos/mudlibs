#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "south": KEEPROOM "zforest/x15y20.lpc",
    "northeast": KEEPROOM "zforest/x13y21.lpc",
    "northwest": KEEPROOM "zforest/x13y19.lpc",
    "southeast": KEEPROOM "zforest/x15y21.lpc",
  ]));
}
