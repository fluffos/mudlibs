#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "north": KEEPROOM "zforest/x11y11.lpc",
    "west": KEEPROOM "zforest/sunstone.lpc",
    "northeast": KEEPROOM "zforest/x11y12.lpc",
    "southeast": KEEPROOM "zforest/x13y12.lpc",
  ]));
}
