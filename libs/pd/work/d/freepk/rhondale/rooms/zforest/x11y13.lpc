#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "southeast": KEEPROOM "zforest/x12y14.lpc",
    "north": KEEPROOM "zforest/x10y13.lpc",
    "west": KEEPROOM "zforest/x11y12.lpc",
  ]));
}
