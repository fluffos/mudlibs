#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "south": KEEPROOM "zforest/x10y11.lpc",
    "northwest": KEEPROOM "zforest/x8y10.lpc",
    "north": KEEPROOM "zforest/x8y11.lpc",
  ]));
}
