#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "south": KEEPROOM "zforest/x18y5.lpc",
    "northwest": KEEPROOM "zforest/x16y4.lpc",
    "northeast": KEEPROOM "zforest/x16y6.lpc",
  ]));
}
