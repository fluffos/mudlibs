#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "southwest": KEEPROOM "zforest/sunstone.lpc",
    "south": KEEPROOM "zforest/x12y11.lpc",
    "northeast": KEEPROOM "zforest/x10y12.lpc",
    "northwest": KEEPROOM "zforest/x10y10.lpc",
  ]));
}
