#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
     set_server(KEEPROOM"zforest/pathvserver.lpc");
   ::create();
     set_exits(([
  "north" : KEEPROOM"zforest/x17y13.lpc",
  "east" : KEEPROOM"zforest/x18y14.lpc",
  "northeast" : KEEPROOM"zforest/x17y14.lpc",
  "southwest" : KEEPROOM"zforest/x19y12.lpc",
      ]));
}
