#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "northwest": KEEPROOM "zforest/sunstone.lpc",
    "southwest": KEEPROOM "zforest/x14y10.lpc",
    "east": KEEPROOM "zforest/x13y12.lpc",
    "west": KEEPROOM "zforest/x13y10.lpc",
  ]));
}
