#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "northwest": KEEPROOM "zforest/x23y20.lpc",
    "northeast": KEEPROOM "zforest/x23y22.lpc",
    "east": KEEPROOM "zforest/x24y22.lpc",
  ]));
}
