#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "southeast": KEEPROOM "zforest/x14y26.lpc",
    "east": KEEPROOM "zforest/x13y26.lpc",
    "north": KEEPROOM "zforest/x12y25.lpc",
    "south": KEEPROOM "zforest/x14y25.lpc",
  ]));
}
