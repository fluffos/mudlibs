#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
     set_server(KEEPROOM"zforest/pathvserver.lpc");
   ::create();
     set_exits(([
  "northeast" : KEEPROOM"zforest/x2y11.lpc",
  "west" : KEEPROOM"zforest/x3y9.lpc",
  "southwest" : KEEPROOM"zforest/x4y9.lpc",
  "southeast" : KEEPROOM"zforest/x4y11.lpc",
      ]));
}
