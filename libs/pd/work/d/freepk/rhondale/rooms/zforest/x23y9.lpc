#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
     set_server(KEEPROOM"zforest/pathvserver.lpc");
   ::create();
     set_exits(([
  "northwest" : KEEPROOM"zforest/x22y8.lpc",
  "north" : KEEPROOM"zforest/x22y9.lpc",
  "northeast" : KEEPROOM"zforest/x22y10.lpc",
  "southwest" : KEEPROOM"zforest/x24y8.lpc",
      ]));
}
