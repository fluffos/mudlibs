#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "south": KEEPROOM "zforest/x5y22.lpc",
    "east": KEEPROOM "zforest/x4y23.lpc",
    "northeast": KEEPROOM "zforest/x3y23.lpc",
    "northwest": KEEPROOM "zforest/x3y21.lpc",
  ]));
}
