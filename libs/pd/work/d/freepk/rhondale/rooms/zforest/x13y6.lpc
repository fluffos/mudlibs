#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "north": KEEPROOM "zforest/x12y6.lpc",
    "northwest": KEEPROOM "zforest/x12y5.lpc",
    "southeast": KEEPROOM "zforest/x14y7.lpc",
    "southwest": KEEPROOM "zforest/x14y5.lpc",
  ]));
}
