#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "south": KEEPROOM "zforest/x18y13.lpc",
    "southwest": KEEPROOM "zforest/x18y12.lpc",
    "northwest": KEEPROOM "zforest/x16y12.lpc",
  ]));
}
