#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "northwest": KEEPROOM "zforest/x8y18.lpc",
    "west": KEEPROOM "zforest/x9y18.lpc",
    "southeast": KEEPROOM "zforest/x10y20.lpc",
  ]));
}
