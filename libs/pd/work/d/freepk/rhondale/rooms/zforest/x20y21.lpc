#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "north": KEEPROOM "zforest/x19y21.lpc",
    "south": KEEPROOM "zforest/x21y21.lpc",
    "southwest": KEEPROOM "zforest/x21y20.lpc",
  ]));
}
