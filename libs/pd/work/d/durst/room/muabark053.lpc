#include <std.h>
#include <durst.h>

inherit ROOM;

void create() {
  ::create();
  set_name("desert");
  set_short("The MuaBark desert");
  set_long("The desert never seems to end, all sense of direction seems to disappear in the never ending dunes. Some scattered bones can be seen half buried in a dune close by. Vultures can be seen circling overhead.");

  set_properties(([
    "light": 3,
    "night light": 1,
    "dessert": 1
  ]));

  set_listen(
    "default",
    "The deafening sound of the powerful desert winds drowns out all other sounds"
  );
  set_exits(([

    "northwest": ROOMS "muabark073.lpc",
    "southeast": ROOMS "muabark052.lpc",
    "west": ROOMS "muabark054.lpc",
    "north": ROOMS "muabark077.lpc",
    "south": ROOMS "nes_oasis.lpc",
  ]));
}

void reset() {
  ::reset();

  //if (children(MOB"md-nomad.lpc")==({})||
  //    sizeof(children(MOB"md-nomad.lpc"))<7)
  //     new(MOB "md-nomad.lpc")->move(this_object());

  if (!present("scorpion", this_object()))
    new(MOB "md-scorpion.lpc")->move(this_object());
  if (!present("scorpion", this_object()))
    new(MOB "md-scorpion.lpc")->move(this_object());




}
