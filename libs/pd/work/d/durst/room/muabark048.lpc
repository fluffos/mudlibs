#include <std.h>
#include <durst.h>

inherit ROOM;

void create() {
  ::create();
  set_name("desert");
  set_short("The MuaBark desert");
  set_long("Sand dunes as far as the eye can see, only the sky gives something else to look at. Not one plant can be seen anywhere, the desert looks to be completely dead. The winds kick up enough sand to make it difficult to see very far.");

  set_properties(([
    "light": 3,
    "night light": 1,
    "dessert": 1
  ]));

  set_listen(
    "default",
    "The deafening sound of the powerful desert winds drowns out all other sounds"
  );
  set_exits(([

    "north": ROOMS "muabark052.lpc",
    "south": ROOMS "muabark047.lpc",
    "southwest": ROOMS "muabark044.lpc",
    "northeast": ROOMS "muabark049.lpc",

  ]));
}

void reset() {
  ::reset();

  if (children(MOB "md-nomad.lpc") == ({}) ||
    sizeof(children(MOB "md-nomad.lpc")) < 10)
    new(MOB "md-nomad.lpc")->move(this_object());
  if (!present("lizard", this_object()))
    new(MOB "md-lizard.lpc")->move(this_object());
  if (!present("lizard 2", this_object()))
    new(MOB "md-lizard.lpc")->move(this_object());
  if (!present("lizard 3", this_object()))
    new(MOB "md-lizard.lpc")->move(this_object());



}
