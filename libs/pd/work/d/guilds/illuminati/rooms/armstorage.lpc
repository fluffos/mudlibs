#include <std.h>
#include <illuminati.h>
inherit ROOM;

void create() {
    ::create();
    set_short("Illuminati Tower");
    set_long("The Illuminati Armour Supply Room. Get outta here biatch!");
    set_exits((["out" : ILROOM"armshop.lpc"]));
    new(ILOBJ"crestspawn.lpc")->move(this_object());
    new(ILOBJ"ilbandspawn.lpc")->move(this_object());
    new(ILARMOUR"lwingbracer.lpc")->move(this_object());
    new(ILARMOUR"rwingbracer.lpc")->move(this_object());
    new(ILARMOUR"faithwings.lpc")->move(this_object());
    new(ILARMOUR"frostring.lpc")->move(this_object());
    new(ILARMOUR"frostring.lpc")->move(this_object());
    new(ILARMOUR"armour.lpc")->move(this_object());
    new(ILARMOUR"armour.lpc")->move(this_object());

}
