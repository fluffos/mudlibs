#include <std.h>
#include <tirunmts.h>

inherit VIRTUALROOM;

void create() {
  set_server(SERVER);
  ::create();
  set_exits(([

    "west": ROOMS "tirunmts_179.lpc",
    "north": ROOMS "tirunmts_151.lpc",
    "southeast": ROOMS "tirunmts_203.lpc",
    "south": ROOMS "tirunmts_202.lpc",
  ]));
}
