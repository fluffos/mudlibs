#include <std.h>
#include <tirunmts.h>

inherit VIRTUALROOM;

void create() {
  set_server(SERVER);
  ::create();
  set_exits(([

    "northwest": ROOMS "tirunmts_100.lpc",
    "northeast": ROOMS "tirunmts_101.lpc",
    "southwest": ROOMS "tirunmts_139.lpc",
    "south": ROOMS "tirunmts_140.lpc"
  ]));
}
