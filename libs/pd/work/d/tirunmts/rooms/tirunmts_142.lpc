#include <std.h>
#include <tirunmts.h>

inherit VIRTUALROOM;

void create() {
  set_server(SERVER);
  ::create();
  set_exits(([

    "northeast": ROOMS "tirunmts_122.lpc",
    "southeast": ROOMS "tirunmts_164.lpc",
    "southwest": ROOMS "tirunmts_163.lpc",
    "up": ROOMS "tirunmts_121.lpc"
  ]));
}
