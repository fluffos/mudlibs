#include <std.h>
#include <tirunmts.h>

inherit VIRTUALROOM;

void create() {
  set_server(SERVER);
  ::create();
  set_exits(([

    "west": ROOMS "tirunmts_326.lpc",
    "northeast": ROOMS "tirunmts_319.lpc",
    "east": ROOMS "tirunmts_328.lpc",
    "southeast": ROOMS "tirunmts_333.lpc",
  ]));
}
