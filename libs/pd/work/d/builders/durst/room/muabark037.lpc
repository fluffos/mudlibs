#include <std.h>
#include <durst.h>

inherit ROOM;

int Count;
int Door;

void create() 
{
	::create();
		set_name("desert");
		set_short("The MuaBark desert");
		set_long("The MuaBark Desert stretches off in all directions. Large sand dunes make it impossible to see very far in any direction. A powerful wind kicks sand into the air, making it difficult to breath.");
		
		set_properties(([
			"light"		: 3,
			"night light"	: 1,
			"dessert"     	: 1
		]));
		
		set_listen("default", "The deafening sound of the powerful desert winds drowns out all other sounds");
		set_exits(([
			"west"			: ROOMS "muabark036.lpc",
			"southeast"		: ROOMS "muabark038.lpc",
			"southwest"		: ROOMS "muabark033.lpc",
		]));
		Count = 0;
        Door = 0;
}

void reset() {
   ::reset();

//if (children(MOB"md-nomad.lpc")==({})||
//    sizeof(children(MOB"md-nomad.lpc"))<7)
//     new(MOB "md-nomad.lpc")->move(this_object());

//if (!present("scorpion", this_object()))
//    new(MOB"md-scorpion.lpc")->move(this_object());
//if (!present("snake", this_object()))
//    new(MOB"md-snake.lpc")->move(this_object());
//if (!present("scorpion", this_object()))
//    new(MOB"md-scorpion.lpc")->move(this_object());

            Count = 0;
                if( Door != 0 )
                {
                        remove_exit("south");
                }
                Door = 0;

}

void init()
{
        ::init();
                Count++;
                if( Count > 5 )
                {
                        if( Door == 0 )
                        {
                                Door = 1;
				Count = 0;
                                add_exit(ROOMS "md-cave.lpc", "south");
                        }
                      
                       
                }
		
		if(Door == 1)
		{
			Door = 2;
		}
		else if(Door == 2)
		{
			Door = 3;
		}
		else if(Door == 3)
		{
			Count = 0;
			Door = 0;
			remove_exit("south");
		}
}


