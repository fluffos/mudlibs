#include <std.h>

#include <caves.h>

inherit ROOM;

void create() {
::create();
    set_short("Inside the cave");
    set_long("As you look around the cave is like any other, dark, cold and eery. Small lanterns on the walls give enough light to see your self around the cave.\n");
    set_properties(([
	"light" : 1,
    ]));
    set_exits(([
	"north" : ROOMS "cave25.lpc",
	"east" : ROOMS "cave29.lpc",
	"south" : ROOMS "cave31.lpc",
	"northeast" : ROOMS "cave26.lpc",
	"southeast" : ROOMS "cave32.lpc",
    ]));
    set_smell("default", "The foul stench of goblins lurks about.");
    set_listen("default", "Clink ... Clink ... Clink ... ARGhhhhhhh!.");
}

void reset() {
    if(!present("dwarf"))
	new(MONSTERS"weak_goblin.lpc") ->move(this_object());
	new(MONSTERS"slave_dwarf.lpc") ->move(this_object());
	new(MONSTERS"slave_dwarf.lpc") ->move(this_object());
}
