#include <std.h>

#include <caves.h>

inherit ROOM;

void create() {
  ::create();
  set_short("Inside the cave");
  set_long("As you look around the cave is like any other, dark, cold and eery. Small lanterns on the walls give enough light to see your self around the cave.\n");
  set_properties(([
    "light": 1,
  ]));
  set_exits(([
    "north": ROOMS "cave26.lpc",
    "east": ROOMS "cave30.lpc",
    "south": ROOMS "cave32.lpc",
    "west": ROOMS "cave28.lpc",
    "northeast": ROOMS "cave27.lpc",
    "northwest": ROOMS "cave25.lpc",
    "southeast": ROOMS "cave33.lpc",
    "southwest": ROOMS "cave31.lpc",
  ]));
  set_smell("default", "The foul stench of goblins lurks about.");
  set_listen("default", "Clink ... Clink ... Clink ... ARGhhhhhhh!.");
}

void reset() {
  if (!present("dwarf"))
    new(MONSTERS "normal_goblin.lpc")->move(this_object());
  new(MONSTERS "normal_goblin.lpc")->move(this_object());
}
