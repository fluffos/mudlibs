#include <std.h>
#include <illuminati.h>

inherit ROOM;

void create() {
  ::create();
  set_short("Illuminati Tower");
  set_long("The Illuminati Weapon Supply Room. Get outta here biatch!");
  set_exits(([ "out": ILROOM "weapshop.lpc" ]));
  new(ILWEAPON "shortstaff.lpc")->move(this_object());
  new(ILWEAPON "shortstaff.lpc")->move(this_object());
  new(ILWEAPON "kratak.lpc")->move(this_object());
  new(ILWEAPON "kratak.lpc")->move(this_object());
  new(ILWEAPON "divine.lpc")->move(this_object());
  new(ILWEAPON "divine.lpc")->move(this_object());
}
