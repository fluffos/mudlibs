#include <std.h>
inherit ROOM;
#include <guild.h>
void create() {
    ::create();
    set_short("Illuminati Armour Supply Room");
    set_long("The Illuminati Armour Supply Room. Get outta here biatch!");
    set_exits((["west" : ROOMS"illuminati/new/armshop.lpc"]));
    new(ROOMS"illuminati/new/faithwings.lpc")->move(this_object());
    new(ROOMS"illuminati/new/frostring.lpc")->move(this_object());
    new(ROOMS"illuminati/new/frostring.lpc")->move(this_object());
    new(ROOMS"illuminati/armour/ilband.lpc")->move(this_object());
}

