#include <std.h>
#include <guild.h>
#include "ether.h"
inherit ROOM;

void create() {
  ::create();
  set_name("weapon storage");
  set_short("weapon");
  set_long("This is the weapon storage room to Ethereal.  You shouldnt be in
here.");
  set_exits(([ "west": ROOMS "2-1.lpc" ]));
}

