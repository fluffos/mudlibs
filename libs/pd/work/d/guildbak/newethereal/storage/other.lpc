#include <std.h>
#include <guild.h>
#include "ether.h"
inherit ROOM;

void create() {
  ::create();
  set_name("misc storage");
  set_short("misc");
  set_long("This is the misc. storage room to Ethereal.  You shouldnt be in
here.");
  set_exits(([ "north": ROOMS "2-1.lpc" ]));
}

void reset() {
  ::reset();
  if (!present("ring", this_object())) {
    {
      object new_ob = new(OBJ "ring");
      if (new_ob) new_ob->move(this_object());
    }
    {
      object new_ob = new(OBJ "ring");
      if (new_ob) new_ob->move(this_object());
    }
  }
  if (!present("sack", this_object())) {
    {
      object new_ob = new(OBJ "sack");
      if (new_ob) new_ob->move(this_object());
    }
    {
      object new_ob = new(OBJ "sack");
      if (new_ob) new_ob->move(this_object());
    }
  }
  if (!present("bracelet", this_object())) {
    {
      object new_ob = new(OBJ "bracelet");
      if (new_ob) new_ob->move(this_object());
    }
    {
      object new_ob = new(OBJ "bracelet");
      if (new_ob) new_ob->move(this_object());
    }
  }
  if (!present("clasp", this_object())) {
    {
      object new_ob = new(OBJ "rose");
      if (new_ob) new_ob->move(this_object());
    }
    {
      object new_ob = new(OBJ "rose");
      if (new_ob) new_ob->move(this_object());
    }
  }

}
