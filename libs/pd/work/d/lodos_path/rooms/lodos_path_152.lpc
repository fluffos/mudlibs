#include <std.h>
#include <lodospath.h>

inherit VIRTUALROOM;

void create() {
  set_server(SERVER);
  ::create();
  set_exits( ([
                "west": ROOMS"lodos_path_151.lpc",
                "northwest": ROOMS"lodos_path_141.lpc",
                "east": ROOMS"lodos_path_153.lpc",
                "southeast": ROOMS"lodos_path_165.lpc",
                "southwest": ROOMS"lodos_path_164.lpc",
  ]) );
}
