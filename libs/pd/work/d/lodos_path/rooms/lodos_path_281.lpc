#include <std.h>
#include <lodospath.h>

inherit VIRTUALROOM;

void create() {
  set_server(SERVER);
  ::create();
  set_exits( ([
                "northeast": ROOMS"lodos_path_268.lpc",
                "southeast": ROOMS"lodos_path_290.lpc",
                "southwest": ROOMS"lodos_path_289.lpc",
  ]) );
}
