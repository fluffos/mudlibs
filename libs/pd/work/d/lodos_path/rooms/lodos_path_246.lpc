#include <std.h>
#include <lodospath.h>

inherit VIRTUALROOM;

void create() {
  set_server(SERVER);
  ::create();
  set_exits(([
    "northwest": ROOMS "lodos_path_235.lpc",
    "northeast": ROOMS "lodos_path_236.lpc",
    "southeast": ROOMS "lodos_path_257.lpc",
  ]));
}
