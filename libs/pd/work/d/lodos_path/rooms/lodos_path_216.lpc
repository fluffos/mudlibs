#include <std.h>
#include <lodospath.h>

inherit VIRTUALROOM;

void create() {
  set_server(SERVER);
  ::create();
  set_exits( ([
                "west": ROOMS"lodos_path_215.lpc",
                "northeast": ROOMS"lodos_path_204.lpc",
                "southeast": ROOMS"lodos_path_227.lpc",
                "south": ROOMS"lodos_path_226.lpc",
  ]) );
}
