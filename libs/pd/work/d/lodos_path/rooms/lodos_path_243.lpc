#include <std.h>
#include <lodospath.h>

inherit VIRTUALROOM;

void create() {
  set_server(SERVER);
  ::create();
  set_exits(([
    "northwest": ROOMS "lodos_path_233.lpc",
    "southeast": ROOMS "lodos_path_254.lpc",
    "southwest": ROOMS "lodos_path_253.lpc",
  ]));
}
