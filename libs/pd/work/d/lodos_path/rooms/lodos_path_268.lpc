#include <std.h>
#include <lodospath.h>

inherit VIRTUALROOM;

void create() {
  set_server(SERVER);
  ::create();
  set_exits( ([
                "northwest": ROOMS"lodos_path_257.lpc",
                "northeast": ROOMS"lodos_path_258.lpc",
                "east": ROOMS"lodos_path_269.lpc",
                "south": ROOMS"lodos_path_282.lpc",
                "southwest": ROOMS"lodos_path_281.lpc",
  ]) );
}
