#include <std.h>
#include <lodospath.h>

inherit VIRTUALROOM;

void create() {
  set_server(SERVER);
  ::create();
  set_exits(([
    "northwest": ROOMS "lodos_path_314.lpc",
    "northeast": ROOMS "lodos_path_315.lpc",
    "southwest": ROOMS "lodos_path_331.lpc",
  ]));
}
