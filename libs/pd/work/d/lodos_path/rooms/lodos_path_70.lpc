#include <std.h>
#include <lodospath.h>

inherit VIRTUALROOM;

void create() {
  set_server(SERVER);
  ::create();
  set_exits(([
    "west": ROOMS "lodos_path_69.lpc",
    "northeast": ROOMS "lodos_path_58.lpc",
    "southeast": ROOMS "lodos_path_83.lpc",
    "south": ROOMS "lodos_path_82.lpc",
  ]));
}
