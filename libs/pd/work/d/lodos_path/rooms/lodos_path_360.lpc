#include <std.h>
#include <lodospath.h>

inherit VIRTUALROOM;

void create() {
  set_server(SERVER);
  ::create();
  set_exits(([
    "northwest": ROOMS "lodos_path_355.lpc",
    "northeast": ROOMS "lodos_path_356.lpc",
    "southeast": ROOMS "lodos_path_364.lpc",
  ]));
}
