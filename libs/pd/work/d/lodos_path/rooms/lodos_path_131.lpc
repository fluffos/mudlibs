#include <std.h>
#include <lodospath.h>

inherit VIRTUALROOM;

void create() {
  set_server(SERVER);
  ::create();
  set_exits( ([
                "west": ROOMS"lodos_path_130.lpc",
                "northwest": ROOMS"lodos_path_116.lpc",
                "east": ROOMS"lodos_path_132.lpc",
                "southeast": ROOMS"lodos_path_142.lpc",
  ]) );
}
