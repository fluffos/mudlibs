#include <std.h>
#include <lodospath.h>

inherit VIRTUALROOM;

void create() {
  set_server(SERVER);
  ::create();
  set_exits(([
    "north": ROOMS "lodos_path_16.lpc",
    "east": ROOMS "lodos_path_26.lpc",
    "southeast": ROOMS "lodos_path_38.lpc",
    "southwest": ROOMS "lodos_path_37.lpc",
  ]));
}
