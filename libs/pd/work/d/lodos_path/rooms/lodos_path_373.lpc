#include <std.h>
#include <lodospath.h>

inherit VIRTUALROOM;

void create() {
  set_server(SERVER);
  ::create();
  set_exits(([
    "west": ROOMS "lodos_path_372.lpc",
    "north": ROOMS "lodos_path_368.lpc",
    "northeast": ROOMS "lodos_path_369.lpc",
    "south": ROOMS "lodos_path_374.lpc",
  ]));
}
