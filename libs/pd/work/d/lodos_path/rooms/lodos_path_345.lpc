#include <std.h>
#include <lodospath.h>

inherit VIRTUALROOM;

void create() {
  set_server(SERVER);
  ::create();
  set_exits( ([
                "northwest": ROOMS"lodos_path_340.lpc",
                "east": ROOMS"lodos_path_346.lpc",
                "south": ROOMS"lodos_path_351.lpc",
                "southwest": ROOMS"lodos_path_350.lpc",
  ]) );
}
