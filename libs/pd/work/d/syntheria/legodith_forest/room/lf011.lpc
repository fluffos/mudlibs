#include <std.h>
#include <legodith_forest.h>

inherit VIRTUALROOM;

void create() {
    set_server(SERVER);
    ::create();
    set_exits( ([ 
        "east"         : ROOMS "lf010.lpc",
        "south"        : ROOMS "lf012.lpc",       
        "west"         : ROOMS "lf019.lpc",
        "up"           : "/d/syntheria/prudash/rooms/prudash014.lpc",
    ]) );
}
