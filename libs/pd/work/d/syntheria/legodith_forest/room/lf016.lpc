#include <std.h>
#include <legodith_forest.h>

inherit VIRTUALROOM;

void create() {
    set_server(SERVER);
    ::create();
    set_exits( ([ 
        "west"        : ROOMS "lf023.lpc",
        "south"       : ROOMS "lf015.lpc",
        "north"       : ROOMS "lf017.lpc",
        "up"          : "/d/syntheria/prudash/rooms/prudash010.lpc",
    ]) );
}
