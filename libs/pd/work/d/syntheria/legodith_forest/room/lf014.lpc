#include <std.h>
#include <legodith_forest.h>

inherit VIRTUALROOM;

void create() {
    set_server(SERVER);
    ::create();
    set_exits( ([ 
        "west"         : ROOMS "lf015.lpc",
        "east"         : ROOMS "lf005.lpc",
        "southeast"    : ROOMS "lf004.lpc",       
        "northeast"    : ROOMS "lf006.lpc",

    ]) );
}
