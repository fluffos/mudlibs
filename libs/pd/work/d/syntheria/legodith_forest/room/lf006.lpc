#include <std.h>
#include <legodith_forest.h>

inherit VIRTUALROOM;

void create() {
    set_server(SERVER);
    ::create();
    set_exits( ([ 
        "east"        : ROOMS "lf007.lpc",
        "southwest"   : ROOMS "lf014.lpc",
        "northwest"   : ROOMS "lf013.lpc",
        "south"       : ROOMS "lf005.lpc",
    ]) );
}
