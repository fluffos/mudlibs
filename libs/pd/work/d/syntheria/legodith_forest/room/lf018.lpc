#include <std.h>
#include <legodith_forest.h>

inherit VIRTUALROOM;

void create() {
    set_server(SERVER);
    ::create();
    set_exits( ([ 
        "northeast"   : ROOMS "lf019.lpc",
        "south"       : ROOMS "lf017.lpc",
        "northwest"   : ROOMS "lf021.lpc",
        "southwest"   : ROOMS "lf022.lpc"
    ]) );
}
