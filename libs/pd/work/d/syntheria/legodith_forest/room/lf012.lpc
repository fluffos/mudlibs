#include <std.h>
#include <legodith_forest.h>

inherit VIRTUALROOM;

void create() {
    set_server(SERVER);
    ::create();
    set_exits( ([ 
        "east"         : ROOMS "lf009.lpc",
        "southwest"    : ROOMS "lf013.lpc",       
        "northwest"    : ROOMS "lf019.lpc",
        "north"        : ROOMS "lf011.lpc",
    ]) );
}
