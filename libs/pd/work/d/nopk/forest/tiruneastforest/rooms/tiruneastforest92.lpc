inherit VIRTUALROOM;

void create() {
  set_server(SERVER);
  ::create();
    set_exits((["south" : ROOMS "tiruneastforest91.lpc", "north" : ROOMS "tiruneastforest68.lpc", "northeast" : ROOMS "tiruneastforest102.lpc"]));
