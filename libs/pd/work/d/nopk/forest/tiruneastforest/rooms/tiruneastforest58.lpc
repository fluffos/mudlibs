#include <std.h>
#include <tiruneastforest.h>

inherit VIRTUALROOM;

void create() {
  set_server(SERVER);
  ::create();
  set_exits(([
    "north": ROOMS "tiruneastforest57.lpc",
    "southwest": ROOMS "tiruneastforest59.lpc",
    "south": ROOMS "tiruneastforest66.lpc"
  ]));
}
