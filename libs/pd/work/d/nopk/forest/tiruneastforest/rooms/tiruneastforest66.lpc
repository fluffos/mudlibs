#include <std.h>
#include <tiruneastforest.h>

inherit VIRTUALROOM;

void create() {
  set_server(SERVER);
  ::create();
    set_exits((["south" : ROOMS "tiruneastforest65.lpc", "north" : ROOMS "tiruneastforest58.lpc", "northwest" : ROOMS "tiruneastforest84.lpc"]));
}


