#include <std.h>
#include <tiruneastforest.h>

inherit VIRTUALROOM;

void create() {
  set_server(SERVER);
  ::create();
  set_exits(([
    "west": ROOMS "tiruneastforest62.lpc",
    "northeast": ROOMS "tiruneastforest64.lpc",
    "north": ROOMS "tiruneastforest79.lpc"
  ]));
}
