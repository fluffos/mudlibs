#include <std.h>
#include <tiruneastforest.h>

inherit VIRTUALROOM;

void create() {
  set_server(SERVER);
  ::create();
  set_exits(([
    "west": ROOMS "tiruneastforest8.lpc",
    "southeast": ROOMS "tiruneastforest10.lpc",
    "east": ROOMS "tiruneastforest31.lpc",
    "northeast": ROOMS "tiruneastforest35.lpc"
  ]));
}
