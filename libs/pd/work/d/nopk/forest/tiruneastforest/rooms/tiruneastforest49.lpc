#include <std.h>
#include <tiruneastforest.h>

inherit VIRTUALROOM;

void create() {
  set_server(SERVER);
  ::create();
  set_exits(([
    "southwest": ROOMS "tiruneastforest48.lpc",
    "north": ROOMS "tiruneastforest50.lpc",
    "northeast": ROOMS "tiruneastforest60.lpc"
  ]));
}
