#include <std.h>
#include <tiruneastforest.h>

inherit VIRTUALROOM;

void create() {
  set_server(SERVER);
  ::create();
    set_exits((["north" : ROOMS "tiruneastforest10.lpc", "southwest" : ROOMS "tiruneastforest12.lpc", "southeast" : ROOMS "tiruneastforest52.lpc"]));
}


