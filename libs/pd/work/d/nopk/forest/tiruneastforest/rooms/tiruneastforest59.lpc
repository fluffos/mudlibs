#include <std.h>
#include <tiruneastforest.h>

inherit VIRTUALROOM;

void create() {
  set_server(SERVER);
  ::create();
  set_exits(([
    "northeast": ROOMS "tiruneastforest58.lpc",
    "west": ROOMS "tiruneastforest60.lpc",
    "south": ROOMS "tiruneastforest80.lpc"
  ]));
}
