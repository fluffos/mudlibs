#include <std.h>
#include <tiruneastforest.h>

inherit VIRTUALROOM;

void create() {
  set_server(SERVER);
  ::create();
  set_exits(([
    "southwest": ROOMS "tiruneastforest38.lpc",
    "east": ROOMS "tiruneastforest54.lpc",
    "northwest": ROOMS "tiruneastforest101.lpc"
  ]));
}
