#include <std.h>
#include <tiruneastforest.h>

inherit VIRTUALROOM;

void create() {
  set_server(SERVER);
  ::create();
  set_exits(([
    "west": ROOMS "tiruneastforest17.lpc",
    "northeast": ROOMS "tiruneastforest19.lpc",
    "south": ROOMS "tiruneastforest39.lpc"
  ]));
}
