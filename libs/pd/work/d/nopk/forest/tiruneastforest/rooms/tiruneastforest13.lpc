#include <std.h>
#include <tiruneastforest.h>

inherit VIRTUALROOM;

void create() {
  set_server(SERVER);
  ::create();
  set_exits(([
    "east": ROOMS "tiruneastforest12.lpc",
    "northwest": ROOMS "tiruneastforest6.lpc",
    "southwest": ROOMS "tiruneastforest20.lpc"
  ]));
}
