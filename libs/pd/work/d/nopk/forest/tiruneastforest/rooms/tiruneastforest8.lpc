#include <std.h>
#include <tiruneastforest.h>

inherit VIRTUALROOM;

void create() {
  set_server(SERVER);
  ::create();
  set_exits(([
    "southwest": ROOMS "tiruneastforest7.lpc",
    "east": ROOMS "tiruneastforest9.lpc",
    "northwest": ROOMS "tiruneastforest23.lpc"
  ]));
}
