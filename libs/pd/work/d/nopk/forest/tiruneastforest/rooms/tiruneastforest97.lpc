#include <std.h>
#include <tiruneastforest.h>

inherit VIRTUALROOM;

void create() {
  set_server(SERVER);
  ::create();
    set_exits((["west" : ROOMS "tiruneastforest96.lpc", "east" : ROOMS "tiruneastforest98.lpc", "northwest" : ROOMS "tiruneastforest47.lpc", "northeast" : ROOMS "tiruneastforest62.lpc"]));
}


