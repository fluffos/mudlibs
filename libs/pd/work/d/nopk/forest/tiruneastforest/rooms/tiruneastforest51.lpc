#include <std.h>
#include <tiruneastforest.h>

inherit VIRTUALROOM;

void create() {
  set_server(SERVER);
  ::create();
  set_exits(([
    "south": ROOMS "tiruneastforest50.lpc",
    "northwest": ROOMS "tiruneastforest30.lpc",
    "northeast": ROOMS "tiruneastforest61.lpc"
  ]));
}
