#include <std.h>
#include <tiruneastforest.h>

inherit VIRTUALROOM;

void create() {
  set_server(SERVER);
  ::create();
  set_exits(([
    "southwest": ROOMS "tiruneastforest67.lpc",
    "northwest": ROOMS "tiruneastforest69.lpc",
    "north": ROOMS "tiruneastforest87.lpc",
    "south": ROOMS "tiruneastforest92.lpc"
  ]));
}
