inherit VIRTUALROOM;

void create() {
  set_server(SERVER);
  ::create();
    set_exits((["south" : ROOMS "tiruneastforest49.lpc", "north" : ROOMS "tiruneastforest51.lpc", "southwest" : ROOMS "tiruneastforest78.lpc"]));
}


