#include <std.h>
#include <tiruneastforest.h>

inherit VIRTUALROOM;

void create() {
  set_server(SERVER);
  ::create();
    set_exits((["northwest" : ROOMS "tiruneastforest64.lpc", "east" : ROOMS "tiruneastforest89.lpc", "southwest" : ROOMS "tiruneastforest100.lpc"]));
}


