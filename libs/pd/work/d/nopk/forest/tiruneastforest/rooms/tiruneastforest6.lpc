#include <std.h>
#include <tiruneastforest.h>

inherit VIRTUALROOM;

void create() {
  set_server(SERVER);
  ::create();
  set_exits(([
    "west": ROOMS "tiruneastforest5.lpc",
    "north": ROOMS "tiruneastforest7.lpc",
    "southeast": ROOMS "tiruneastforest13.lpc"
  ]));
}
