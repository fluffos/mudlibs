inherit VIRTUALROOM;

void create() {
  set_server(SERVER);
  ::create();
    set_exits((["northwest" : ROOMS "tiruneastforest85.lpc", "south" : ROOMS "tiruneastforest87.lpc", "northeast" : ROOMS "tiruneastforest105.lpc"]));
}


