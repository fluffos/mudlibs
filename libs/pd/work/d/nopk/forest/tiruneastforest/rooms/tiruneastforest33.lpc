#include <std.h>
#include <tiruneastforest.h>

inherit VIRTUALROOM;

void create() {
  set_server(SERVER);
  ::create();
    set_exits((["west" : ROOMS "tiruneastforest32.lpc", "east" : ROOMS "tiruneastforest34.lpc", "north" : ROOMS "tiruneastforest81.lpc", "south" : ROOMS "tiruneastforest82.lpc"]));
}


