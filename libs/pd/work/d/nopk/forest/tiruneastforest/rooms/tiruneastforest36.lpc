#include <std.h>
#include <tiruneastforest.h>

inherit VIRTUALROOM;

void create() {
  set_server(SERVER);
  ::create();
  set_exits(([
    "west": ROOMS "tiruneastforest35.lpc",
    "east": ROOMS "tiruneastforest37.lpc",
    "southeast": ROOMS "tiruneastforest81.lpc"
  ]));
}
