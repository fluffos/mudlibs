inherit VIRTUALROOM;

void create() {
  set_server(SERVER);
  ::create();
    set_exits((["southwest" : ROOMS "tiruneastforest26.lpc", "northeast" : ROOMS "tiruneastforest28.lpc", "northwest" : ROOMS "tiruneastforest52.lpc", "east" : ROOMS "tiruneastforest77.lpc"]));
}


