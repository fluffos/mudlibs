#include <std.h>
#include <arlon2.h>
inherit VIRTUALROOM;
void create() {
  set_server(SERVER);
  ::create();
  set_exits(([
    "east": ROOMS + "docks/95.lpc",
    "south": ROOMS + "docks/96.lpc",
    "west": ROOMS + "beach/81.lpc",
    "north": ROOMS + "roads/62.lpc",
    "southwest": ROOMS + "beach/64.lpc",
  ]));
}
