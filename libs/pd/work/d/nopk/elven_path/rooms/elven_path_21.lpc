#include <std.h>
#include <elven_path.h>

inherit VIRTUALROOM;

void create() {
  set_server(SERVER);
  ::create();
  set_exits(([
    "northwest": ROOMS "elven_path_18.lpc",
    "northeast": ROOMS "elven_path_19.lpc",
    "southeast": ROOMS "elven_path_24.lpc",
    "south": ROOMS "elven_path_23.lpc",
  ]));
}
