#include <std.h>
#include <elven_path.h>

inherit VIRTUALROOM;

void create() {
  set_server(SERVER);
  ::create();
  set_exits(([
    "northwest": ROOMS "elven_path_48.lpc",
    "northeast": ROOMS "elven_path_49.lpc",
    "southeast": ROOMS "elven_path_56.lpc",
    "south": ROOMS "elven_path_55.lpc",
  ]));
}
