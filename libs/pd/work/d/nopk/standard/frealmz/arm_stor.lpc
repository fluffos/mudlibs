inherit "std/room";

void create() {
  ::create();
  set("short", "Anathar's Storage Room");
  set("long", "Storage room for the Asgardian armoury.");
  set_exits(
    ([ "south": "/d/standard/frealmz/armoury" ]));
  {
    object new_ob = new("/d/standard/frealmz/obj/chainvest");
    if (new_ob) new_ob->move(this_object());
  }
  {
    object new_ob = new("/d/standard/frealmz/obj/chainsleeves");
    if (new_ob) new_ob->move(this_object());
  }
  {
    object new_ob = new("/d/standard/frealmz/obj/chainleggings");
    if (new_ob) new_ob->move(this_object());
  }
  {
    object new_ob = new("/d/standard/frealmz/obj/chainhood");
    if (new_ob) new_ob->move(this_object());
  }
  {
    object new_ob = new("/d/standard/frealmz/obj/chaingloves");
    if (new_ob) new_ob->move(this_object());
  }
  {
    object new_ob = new("/d/standard/frealmz/obj/chainboots");
    if (new_ob) new_ob->move(this_object());
  }
}
