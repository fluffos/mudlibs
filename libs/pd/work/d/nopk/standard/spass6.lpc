#include <std.h>
inherit ROOM;

void create() {
  ::create();
  set_short("an old mine shaft");
  set_long("This is the entrance to an old Goblin mine shaft. "
    " The mine looks like it could cave in at any moment. "
    "You better take precaution as you enter. The ledge "
    "continues to the east and west.");
  set_items(([
    "shaft": "The shaft looks extremely unstable.",
  ]));
  set_properties(([
    "light": 2,
    "night light": 2,
  ]));
  set_exits(([
    "mine": "/wizards/marduk/mine_shaft/ms_room2.lpc",
    "east": "/d/nopk/standard/spass5",
    "west": "/d/nopk/standard/spass7",
  ]));
}

void reset() {
  ::reset();
  if (!present("goblin"))
    new("/wizards/marduk/mine_shaft/worker.lpc")->move(this_object());
}
