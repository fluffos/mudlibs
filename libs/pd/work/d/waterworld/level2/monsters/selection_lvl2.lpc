#include <std.h>
#include <waterworld.h>

inherit DAEMON;

int count;
int critter;
int x;

void execute_selection_lvl2(int max, object rm)
{
  count=(1+random(max));
  if(!present("monster",rm)) {

    for(x = 0;x<count;x++)
    {
      critter=(1+random(14));
      switch (critter) {
      case 1:
	new(MOB2"bluefish.lpc")->move(rm);
	break;
      case 2:
	new(MOB2"coral.lpc")->move(rm);
	break;
      case 3:
	new(MOB2"lobster.lpc")->move(rm);
	break;
      case 4:
	new(MOB2"moray_eel.lpc")->move(rm);
	break;
      case 5:
	new(MOB2"octopus.lpc")->move(rm);
	break;
      case 6:
	new(MOB2"seahorse.lpc")->move(rm);
	break;
      case 7:
	new(MOB2"squid.lpc")->move(rm);
	break;
      case 8:
	new(MOB2"tuna.lpc")->move(rm);
	break;
      case 9:
	new(MOB2"clownfish.lpc")->move(rm);
	break;
      case 10:
	new(MOB2"nudibranch.lpc")->move(rm);
	break;
      case 11:
	new(ITEMS2"angler_lure.lpc")->move(rm);
	break;
      case 12:
	new(MOB2"nautilus.lpc")->move(rm);
	break;
      case 13:
	new(MOB2"large_seahorse.lpc")->move(rm);
	break;
      case 14:
	new(ITEMS2"stone_lure.lpc")->move(rm);
	break;
      }
    }
  }
}
