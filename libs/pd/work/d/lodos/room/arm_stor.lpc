#include <std.h>
#include <lodos.h>
inherit ROOM;

void create() {
  ::create();
  set("short", "Anathar's Storage Room");
  set("long", "Storage room for the Lodos armoury.");
  set_exits(
    ([ "south": "/d/standard/frealmz/armoury" ]));
  new(ARM "chainvest")->move(this_object());
  {
    object new_ob = new(ARM "chainsleeves");
    if (new_ob) new_ob->move(this_object());
  }
  {
    object new_ob = new(ARM "chainleggings");
    if (new_ob) new_ob->move(this_object());
  }
  {
    object new_ob = new(ARM "chainhood");
    if (new_ob) new_ob->move(this_object());
  }
  {
    object new_ob = new(ARM "chaingloves");
    if (new_ob) new_ob->move(this_object());
  }
  {
    object new_ob = new(ARM "chainboots");
    if (new_ob) new_ob->move(this_object());
  }
}
