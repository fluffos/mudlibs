#include <std.h>
#include <arlon2.h>
inherit VIRTUALROOM;
void create() {
  set_server(SERVER);
  ::create();

  set_exits(([
    "north" : ROOMS + "roads/36.lpc",
    "east" : ROOMS + "roads/34.lpc",
    "enter south house" : ROOMS + "houses/116.lpc",
  ]));
add_exit_alias("enter south house", "south house");
add_exit_alias("enter south house", "enter south house");
add_exit_alias("enter south house", "south");
add_exit_alias("enter south house", "s");
}
