#include <std.h>
#include <arlonbeach.h>
inherit VIRTUALROOM;
void create() {
  set_server(SERVER);
  ::create();
  set_exits(([
    "northeast": ROOMS + "beach/83.lpc",
    "southeast": ROOMS + "beach/79.lpc",
    "southwest": ROOMS + "beach/68.lpc",
    "east": ROOMS + "beach/66.lpc",
    "west": ROOMS + "beach/78.lpc",
  ]));
}
