#include <std.h>
#include <pastarlon.h>
inherit VIRTUALROOM;
void create() {
set_server(DOCKSERVER);
  ::create();
  set_exits(([
    "northwest" : ROOMS + "beach/64.lpc",
    "west" : ROOMS + "beach/91.lpc",
    "north" : ROOMS + "docks/96.lpc",
    "south" : ROOMS + "docks/97.lpc",
    "east" : ROOMS + "docks/85.lpc",
  ]));
}
