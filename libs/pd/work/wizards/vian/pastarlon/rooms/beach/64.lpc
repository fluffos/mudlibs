#include <std.h>
#include <pastarlon.h>
inherit VIRTUALROOM;
void create() {
  set_server(BEACHSERVER);
  ::create();
  set_exits(([
    "northeast": ROOMS + "roads/63.lpc",
    "southeast": ROOMS + "docks/84.lpc",
    "southwest": ROOMS + "beach/80.lpc",
    "west": ROOMS + "beach/65.lpc",
  ]));
}
