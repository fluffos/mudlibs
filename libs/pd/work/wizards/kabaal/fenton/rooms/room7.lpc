
#include <std.h>
#include <fenton.h>
inherit ROOM;
void create() {
room::create();
   set_properties( ([ "light" : -1, "indoors" : 0]) );
set_property("plain",1);
    set_short("dark alley");
    set_long(
      "This alley is very dark.  Through the darkness not much is noticable.  "
      "Hopefully the alley isn't too long.  You get the chills being in an "
      "area such as this."
    );
    set_items(([
        "alley" : "Darkness....",
    ]));
   set_exits( ([ 
        "west" : ROOMS"room10.lpc",
        "enter" : ROOMS"enter1.lpc",
        "east" : ROOMS"room5.lpc",
        "south" : ROOMS"room9.lpc",
    ]) );
}
void reset() {
::reset();
    if(!present("shadow_st.lpc"))
      new(MOB"shadow_st.lpc")->move(this_object());
}
