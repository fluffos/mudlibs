#include <std.h>
#include <cp.h>
inherit ROOM;

void create() {
  ::create();
  set_properties(([ "light": 0, "indoors": 1, "night light": 0,
    "no teleport": 1 ]));
  set_long(
    "%^BOLD%^%^BLUE%^Underneath the water of the pond is warm. "
    "It is hard to see very far in any direction. The water "
    "gets darker as it gets father down.%^RESET%^ ");
  set_items(([
    "water": "The farther down it goes, the darker the "
    "water gets.",
    "pond": "The pond water is everywhere. "
  ]));
  set_listen("default", "Bluubb.. bluubb.. bluubb.... ");
  set_exits(([
    "west": ROOMS "dp_2",
    "southwest": ROOMS "dp_3",
    "up": ROOMS "p_8",
    "southeast": ROOMS "dp_5" ]));
  if (!present("eel")) new(MOB "eel.lpc")->move(this_object());
  if (!present("piranha")) new(MOB "pir2.lpc")->move(this_object());
  if (!present("piranha 2")) new(MOB "pir1.lpc")->move(this_object());
}
