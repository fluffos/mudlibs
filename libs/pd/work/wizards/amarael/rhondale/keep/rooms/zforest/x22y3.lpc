#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "north": KEEPROOM "zforest/x21y3.lpc",
    "east": KEEPROOM "zforest/x22y4.lpc",
    "southeast": KEEPROOM "zforest/x23y4.lpc",
    "south": KEEPROOM "zforest/x23y3.lpc",
  ]));
}
