#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
     set_server(KEEPROOM"zforest/pathvserver.lpc");
   ::create();
     set_exits(([
  "northwest" : KEEPROOM"zforest/x15y9.lpc",
  "northeast" : KEEPROOM"zforest/x15y11.lpc",
  "west" : KEEPROOM"zforest/x16y9.lpc",
  "east" : KEEPROOM"zforest/x16y11.lpc",
      ]));
}
