#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
     set_server(KEEPROOM"zforest/pathvserver.lpc");
   ::create();
     set_exits(([
  "south" : KEEPROOM"zforest/x11y13.lpc",
  "southeast" : KEEPROOM"zforest/x11y14.lpc",
  "east" : KEEPROOM"zforest/x10y14.lpc",
  "west" : KEEPROOM"zforest/x10y12.lpc",
      ]));
}
