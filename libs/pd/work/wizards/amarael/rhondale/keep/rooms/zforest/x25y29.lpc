#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "northeast": KEEPROOM "zforest/x24y30.lpc",
    "northwest": KEEPROOM "zforest/x24y28.lpc",
    "east": KEEPROOM "zforest/x25y30.lpc",
    "west": KEEPROOM "zforest/x25y28.lpc",
  ]));
}
