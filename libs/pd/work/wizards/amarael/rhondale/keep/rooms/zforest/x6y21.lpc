#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "southeast": KEEPROOM "zforest/x7y22.lpc",
    "northwest": KEEPROOM "zforest/x5y20.lpc",
    "northeast": KEEPROOM "zforest/x5y22.lpc",
    "west": KEEPROOM "zforest/x6y20.lpc",
  ]));
}
