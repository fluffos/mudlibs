#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "south": KEEPROOM "zforest/x19y11.lpc",
    "southeast": KEEPROOM "zforest/x19y12.lpc",
    "north": KEEPROOM "zforest/x17y11.lpc",
  ]));
}
