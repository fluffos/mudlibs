#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
     set_server(KEEPROOM"zforest/pathvserver.lpc");
   ::create();
     set_exits(([
  "northwest" : KEEPROOM"zforest/x9y10.lpc",
  "north" : KEEPROOM"zforest/x9y11.lpc",
  "east" : KEEPROOM"zforest/x10y12.lpc",
  "west" : KEEPROOM"zforest/x10y10.lpc",
      ]));
}
