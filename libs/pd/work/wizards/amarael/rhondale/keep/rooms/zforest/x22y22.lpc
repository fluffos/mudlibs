#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "south": KEEPROOM "zforest/x23y22.lpc",
    "northeast": KEEPROOM "zforest/x21y23.lpc",
    "northwest": KEEPROOM "zforest/x21y21.lpc",
  ]));
}
