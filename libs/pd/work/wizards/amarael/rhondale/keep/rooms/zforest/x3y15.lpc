#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
     set_server(KEEPROOM"zforest/pathvserver.lpc");
   ::create();
     set_exits(([
  "southeast" : KEEPROOM"zforest/x4y16.lpc",
  "south" : KEEPROOM"zforest/x4y15.lpc",
  "northeast" : KEEPROOM"zforest/x2y16.lpc",
  "northwest" : KEEPROOM"zforest/x2y14.lpc",
      ]));
}
