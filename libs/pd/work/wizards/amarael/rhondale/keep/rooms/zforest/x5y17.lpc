#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "northeast": KEEPROOM "zforest/x4y18.lpc",
    "west": KEEPROOM "zforest/x5y16.lpc",
    "southeast": KEEPROOM "zforest/x6y18.lpc",
  ]));
}
