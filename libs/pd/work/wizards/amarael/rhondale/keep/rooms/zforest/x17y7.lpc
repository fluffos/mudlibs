#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
     set_server(KEEPROOM"zforest/pathvserver.lpc");
   ::create();
     set_exits(([
  "north" : KEEPROOM"zforest/x16y7.lpc",
  "northeast" : KEEPROOM"zforest/x16y8.lpc",
  "southeast" : KEEPROOM"zforest/x18y8.lpc",
  "southwest" : KEEPROOM"zforest/x18y6.lpc",
  "north" : KEEPROOM"zforest/x16y7.lpc",
  "southeast" : KEEPROOM"zforest/x18y8.lpc",
  "southwest" : KEEPROOM"zforest/x18y6.lpc",
      ]));
}
