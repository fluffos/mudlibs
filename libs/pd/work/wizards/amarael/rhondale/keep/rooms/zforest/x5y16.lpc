#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "north": KEEPROOM "zforest/x4y16.lpc",
    "east": KEEPROOM "zforest/x5y17.lpc",
    "southeast": KEEPROOM "zforest/x6y17.lpc",
  ]));
}
