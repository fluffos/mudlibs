#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "north": KEEPROOM "zforest/sunstone.lpc",
    "southwest": KEEPROOM "zforest/x14y9.lpc",
    "east": KEEPROOM "zforest/x13y11.lpc",
  ]));
}
