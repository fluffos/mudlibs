#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "southwest": KEEPROOM "zforest/x23y9.lpc",
    "south": KEEPROOM "zforest/x23y10.lpc",
    "north": KEEPROOM "zforest/x21y10.lpc",
    "northeast": KEEPROOM "zforest/x21y11.lpc",
  ]));
}
