#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "northwest": KEEPROOM "zforest/x14y30.lpc",
    "southwest": KEEPROOM "zforest/x16y30.lpc",
    "south": KEEPROOM "zforest/x16y31.lpc",
  ]));
}
