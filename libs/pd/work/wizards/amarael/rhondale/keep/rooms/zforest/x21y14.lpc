#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
     set_server(KEEPROOM"zforest/pathvserver.lpc");
   ::create();
     set_exits(([
  "north" : KEEPROOM"zforest/x20y14.lpc",
  "east" : KEEPROOM"zforest/x21y15.lpc",
  "west" : KEEPROOM"zforest/x21y13.lpc",
  "southeast" : KEEPROOM"zforest/x22y15.lpc",
      ]));
}
