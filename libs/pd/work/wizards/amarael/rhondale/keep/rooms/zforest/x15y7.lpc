#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
     set_server(KEEPROOM"zforest/pathvserver.lpc");
   ::create();
     set_exits(([
  "northwest" : KEEPROOM"zforest/x14y6.lpc",
  "southwest" : KEEPROOM"zforest/x16y6.lpc",
  "north" : KEEPROOM"zforest/x14y7.lpc",
  "south" : KEEPROOM"zforest/x16y7.lpc",
      ]));
}
