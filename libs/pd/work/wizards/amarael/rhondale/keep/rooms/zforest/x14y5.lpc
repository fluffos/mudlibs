#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "southwest": KEEPROOM "zforest/x15y4.lpc",
    "northeast": KEEPROOM "zforest/x13y6.lpc",
    "west": KEEPROOM "zforest/x14y4.lpc",
    "east": KEEPROOM "zforest/x14y6.lpc",
  ]));
}
