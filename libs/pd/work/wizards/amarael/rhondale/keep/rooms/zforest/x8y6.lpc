#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "east": KEEPROOM "zforest/x8y7.lpc",
    "northeast": KEEPROOM "zforest/x7y7.lpc",
    "northwest": KEEPROOM "zforest/x7y5.lpc",
  ]));
}
