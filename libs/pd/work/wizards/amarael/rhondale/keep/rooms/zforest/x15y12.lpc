#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "northeast": KEEPROOM "zforest/x14y13.lpc",
    "west": KEEPROOM "zforest/x15y11.lpc",
    "southeast": KEEPROOM "zforest/x16y13.lpc",
  ]));
}
