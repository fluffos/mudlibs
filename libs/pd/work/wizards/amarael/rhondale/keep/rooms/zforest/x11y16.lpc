#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "northeast": KEEPROOM "zforest/x10y17.lpc",
    "west": KEEPROOM "zforest/x11y15.lpc",
    "southeast": KEEPROOM "zforest/x12y17.lpc",
  ]));
}
