#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "south": KEEPROOM "zforest/x23y12.lpc",
    "east": KEEPROOM "zforest/x22y13.lpc",
    "northeast": KEEPROOM "zforest/x21y13.lpc",
    "southwest": KEEPROOM "zforest/x23y11.lpc",
  ]));
}
