#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "north": KEEPROOM "zforest/x21y24.lpc",
    "east": KEEPROOM "zforest/x22y25.lpc",
    "southwest": KEEPROOM "zforest/x23y23.lpc",
    "southeast": KEEPROOM "zforest/x23y25.lpc",
  ]));
}
