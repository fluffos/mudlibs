#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "north": KEEPROOM "zforest/x1y16.lpc",
    "southwest": KEEPROOM "zforest/x3y15.lpc",
    "northeast": KEEPROOM "zforest/x1y17.lpc",
  ]));
}
