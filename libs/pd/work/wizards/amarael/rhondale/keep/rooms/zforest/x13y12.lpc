#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
     set_server(KEEPROOM"zforest/pathvserver.lpc");
   ::create();
     set_exits(([
  "northwest" : KEEPROOM"zforest/x12y11.lpc",
  "northeast" : KEEPROOM"zforest/x12y13.lpc",
  "west" : KEEPROOM"zforest/x13y11.lpc",
  "east" : KEEPROOM"zforest/x13y13.lpc",
      ]));
}
