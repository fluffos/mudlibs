#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
     set_server(KEEPROOM"zforest/pathvserver.lpc");
   ::create();
     set_exits(([
  "northwest" : KEEPROOM"zforest/x18y11.lpc",
  "north" : KEEPROOM"zforest/x18y12.lpc",
  "northeast" : KEEPROOM"zforest/x18y13.lpc",
  "east" : KEEPROOM"zforest/x19y13.lpc",
  "south" : KEEPROOM"zforest/x20y12.lpc",
      ]));
}
