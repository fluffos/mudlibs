#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "west": KEEPROOM "zforest/x1y19.lpc",
    "southwest": KEEPROOM "zforest/x2y19.lpc",
    "southeast": KEEPROOM "zforest/x2y21.lpc",
  ]));
}
