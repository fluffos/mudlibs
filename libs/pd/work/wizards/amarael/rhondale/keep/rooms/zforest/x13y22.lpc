#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "northwest": KEEPROOM "zforest/x12y21.lpc",
    "west": KEEPROOM "zforest/x13y21.lpc",
    "southeast": KEEPROOM "zforest/x14y23.lpc",
  ]));
}
