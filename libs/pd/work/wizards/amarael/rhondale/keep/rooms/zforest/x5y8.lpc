#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "south": KEEPROOM "zforest/x6y8.lpc",
    "southeast": KEEPROOM "zforest/x6y9.lpc",
    "east": KEEPROOM "zforest/x5y9.lpc",
    "west": KEEPROOM "zforest/x5y7.lpc",
  ]));
}
