#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "north": KEEPROOM "zforest/x11y7.lpc",
    "south": KEEPROOM "zforest/x13y7.lpc",
    "southeast": KEEPROOM "zforest/x13y8.lpc",
  ]));
}
