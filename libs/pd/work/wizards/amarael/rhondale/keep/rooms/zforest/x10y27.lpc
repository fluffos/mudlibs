#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
     set_server(KEEPROOM"zforest/pathvserver.lpc");
   ::create();
     set_exits(([
  "northeast" : KEEPROOM"zforest/x9y28.lpc",
  "north" : KEEPROOM"zforest/x9y27.lpc",
  "northwest" : KEEPROOM"zforest/x9y26.lpc",
  "west" : KEEPROOM"zforest/x10y26.lpc",
  "southeast" : KEEPROOM"zforest/x11y28.lpc",
      ]));
}
