#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "north": KEEPROOM "zforest/x12y17.lpc",
    "east": KEEPROOM "zforest/x13y18.lpc",
    "west": KEEPROOM "zforest/x13y16.lpc",
    "southeast": KEEPROOM "zforest/x14y18.lpc",
  ]));
}
