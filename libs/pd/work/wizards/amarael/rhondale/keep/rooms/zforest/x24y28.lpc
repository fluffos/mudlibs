#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "northeast": KEEPROOM "zforest/x23y29.lpc",
    "southeast": KEEPROOM "zforest/x25y29.lpc",
    "west": KEEPROOM "zforest/x24y27.lpc",
  ]));
}
