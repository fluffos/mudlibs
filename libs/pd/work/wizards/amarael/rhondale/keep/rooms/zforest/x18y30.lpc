#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "north": KEEPROOM "zforest/x17y30.lpc",
    "northeast": KEEPROOM "zforest/x17y31.lpc",
    "west": KEEPROOM "zforest/x18y29.lpc",
    "southwest": KEEPROOM "zforest/x19y29.lpc",
  ]));
}
