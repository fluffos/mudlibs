#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "northeast": KEEPROOM "zforest/x16y23.lpc",
    "south": KEEPROOM "zforest/x18y22.lpc",
    "southwest": KEEPROOM "zforest/x18y21.lpc",
  ]));
}
