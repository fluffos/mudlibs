#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "east": KEEPROOM "zforest/x14y16.lpc",
    "northwest": KEEPROOM "zforest/x13y14.lpc",
    "southeast": KEEPROOM "zforest/x15y16.lpc",
  ]));
}
