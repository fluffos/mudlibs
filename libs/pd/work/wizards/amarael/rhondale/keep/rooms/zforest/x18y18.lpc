#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
  set_server(KEEPROOM "zforest/pathvserver.lpc");
  ::create();
  set_exits(([
    "north": KEEPROOM "zforest/x17y18.lpc",
    "northwest": KEEPROOM "zforest/x17y17.lpc",
    "southeast": KEEPROOM "zforest/x19y19.lpc",
  ]));
}
