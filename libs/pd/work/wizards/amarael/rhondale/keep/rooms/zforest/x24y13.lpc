#include <std.h>
#include <aziraphale.h>

inherit VIRTUALROOM;

void create() {
     set_server(KEEPROOM"zforest/pathvserver.lpc");
   ::create();
     set_exits(([
  "southeast" : KEEPROOM"zforest/x25y14.lpc",
  "northwest" : KEEPROOM"zforest/x23y12.lpc",
  "northeast" : KEEPROOM"zforest/x23y14.lpc",
  "west" : KEEPROOM"zforest/x24y12.lpc",
      ]));
}
