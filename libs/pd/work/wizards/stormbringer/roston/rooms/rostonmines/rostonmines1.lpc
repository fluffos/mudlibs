#include <std.h>
#include "rostonmines.h"

inherit VIRTUALROOM;

void create() {
  set_server(SERVER);
  ::create();
  set_exits(([
    "west": ROOMS "rostonmines0.lpc",
    "south": ROOMS "rostonmines2.lpc",
    "east": ROOMS "rostonmines3.lpc",
    "north": ROOMS "rostonmines9.lpc"
  ]));
}
