#include <std.h>
#include "rostonmines.h"

inherit VIRTUALROOM;

void create() {
  set_server(SERVER);
  ::create();
    set_exits((["south" : ROOMS "rostonmines9.lpc", "west" : ROOMS "rostonmines11.lpc", "east" : ROOMS "rostonmines12.lpc", "north" : ROOMS "rostonmines18.lpc"]));
}


