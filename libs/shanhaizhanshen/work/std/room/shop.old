// shop.c

inherit ROOM;

static object storage;

void remove()
{
	if( storage ) destruct(storage);
}

void setup()
{
	::setup();
	seteuid(getuid());
	if( !storage ) {
		storage = new( base_name( this_object() ) + "_storage");
		storage->set("shop_ob", this_object());
		set("storage_ob", storage);
	}
}

void init()
{
	add_action("do_value", "value");
	add_action("do_pawn", "pawn");
	add_action("do_sell", "sell");
	add_action("do_retrieve", "retrieve");
	add_action("do_list", "list");
	add_action("do_buy", "buy");
	add_action("do_store", "store");
}

string value_string(int value)
{
	int part;
	string msg = "";

	if( value < 1 ) value = 1;
	if( value / 1000000 ) {
		part = value / 1000000;
		value %= 1000000;
		msg += chinese_number( part ) + "枚鉑幣";
		if( value ) msg += ", ";
	}
	if( value / 10000 ) {
		part = value / 10000;
		value %= 10000;
		msg += chinese_number( part ) + "枚金幣";
		if( value ) msg += ", ";
	}
	if( value / 100 ) {
		part = value / 100;
		value %= 100;
		msg += chinese_number( part ) + "枚銀幣";
		if( value ) msg += ", ";
	}
	if( value )
		msg += chinese_number( value ) + "枚銅幣";
	
	return msg;
}

void pay_player(object who, int amount)
{
	object ob;

	if( amount < 1 ) amount = 1;
	if( amount/1000000 ) {
		ob = new(PLATINUM_OB);
		ob->set_amount(amount/1000000);
		ob->move(who);
		amount %= 1000000;
	}
	if( amount/10000 ) {
		ob = new(GOLD_OB);
		ob->set_amount(amount/10000);
		ob->move(who);
		amount %= 10000;
	}
	if( amount/100 ) {
		ob = new(SILVER_OB);
		ob->set_amount(amount/100);
		ob->move(who);
		amount %= 100;
	}
	if( amount ) {
		ob = new(COPPER_OB);
		ob->set_amount(amount);
		ob->move(who);
	}
}

int do_value(string arg)
{
	object ob;
	int value;

	if( !arg || !(ob = present(arg, this_player())) )
		return notify_fail("你要拿什麼物品給店裡估價 ?\n");

	if( ob->query("money_id") )
		return notify_fail("這是「錢」﹐你沒見過嗎 ?\n");

	value = ob->query("value");
	if( !value ) printf("%s一文不值.\n", ob->query("name"));
	else 
		printf("%s值%s.\n如果你要抵押 (pawn), 可以拿到%s及一張抵押契\n如果賣出 (sell), 可以拿到%s.\n",
			ob->query("name"), value_string(value),
			value_string(value * 60 / 100), value_string(value * 80 / 100));

	return 1;
}

int do_pawn(string arg)
{
	object ob, stamp;
	int value;

	if( !arg || !(ob = present(arg, this_player())) )
		return notify_fail("你要抵押什麼物品 ?\n");

	if( ob->query("money_id") )	return notify_fail("你要抵押「錢」?\n");

	value = ob->query("value");
	if( !value ) return notify_fail("這樣東西不值錢.\n");

	if (ob->query("no_sell")) return notify_fail("這樣東西不能典抵押.\n");

	message_vision("$N把身上的" + ob->query("name") + "拿出來典抵押了"
		+ value_string(value * 60 / 100) + "﹐換得一張抵押票.\n", this_player());

	pay_player(this_player(), value * 60 / 100);
	ob->move(storage);
	stamp = new(__DIR__"obj/pawn_stamp");
	stamp->set("pawned_item", ob);
	stamp->set("long", "茲收到\n    " + this_player()->name(1)
		+ "典抵押" + ob->name() + "乙" + ob->query("unit")
		+ "訖﹐破爛缺損不堪.\n    贖回應付" + value_string(value * 120/100)
		+ "整.\n");
	stamp->move(this_player());

	return 1;
}

int do_sell(string arg)
{
	object ob;
	int value;

	if( !arg || !(ob = present(arg, this_player())) )
		return notify_fail("你要賣出什麼物品 ?\n");

	if( ob->query("money_id") )	return notify_fail("你要賣「錢」?\n");
	value = ob->query("value");
	if( !value ) return notify_fail("這樣東西不值錢.\n");

	if (ob->query("no_sell")) return notify_fail("這樣東西不能賣.\n");

	message_vision("$N把身上的" + ob->query("name") + "賣掉.\n",
		this_player());

	pay_player(this_player(), value * 80 / 100);

	if( storage ) {
		int s;

// Make a simple storage management, when we have more goods in
// storage, only keeps higher price goods.
		s = sizeof(all_inventory(storage));
		if( value >= (s * 50) ) {
			ob->add("pawned_time", 1);
			ob->move(storage);
		}
		else destruct(ob);
	}
	else destruct(ob);

	return 1;
}

int do_retrieve(string arg)
{
	object stamp, ob;
	int value;

	if( !arg || arg=="" || !(stamp = present(arg, this_player())) )
		return notify_fail("你要贖回哪一張抵押契上的物品 ?\n");

	if( !stamp->id("pawn stamp") )
		return notify_fail("這不是抵押契.\n");

	if( !(ob = stamp->query("pawned_item")) ) {
		write("這張抵押契上的物品因為你太久沒有來贖, 已經被店裡賣掉了.\n");
		write("你隨手將抵押契撕掉扔了.\n");
		destruct(stamp);
		return 1;
	}

	if( !present(ob, storage) )
		return notify_fail("這不是我們店裡開出的抵押契.\n");

	value = (int)ob->query("value") * 120 / 100;
	if( (int)this_player()->can_afford(value) != 1 )
		return notify_fail("你身上的(零)錢不夠.\n");

	message_vision("$N取出抵押契﹐花了" + value_string(value) + "贖回了"
		+ ob->name() + ".\n", this_player());

	this_player()->pay_money(value);
	ob->move(this_player());
	ob->delete("pawned_time");
	destruct(stamp);

	return 1;
}

int do_list(string arg)
{
	object *inv;
	string msg;

	if( !storage ) return notify_fail("店裡現在沒有貨物.\n");
	if( wizardp(this_player()) )
		inv = all_inventory(storage);
	else
		inv = filter_array( all_inventory(storage), (: $1->query("pawned_time") :));
	if( !sizeof(inv) ) return notify_fail("店裡現在沒有貨物.\n");

	msg = "店裡現在有以下貨物﹕\n  ";
	msg += implode( map_array(inv, (: sprintf("%-30s%s", $1->short(),
		value_string((int)$1->query("value") * 2)) :)), "\n  ");
	msg += "\n";
	this_player()->start_more(msg);
	return 1;
}

int do_buy(string arg)
{
	int index;
	object *inv, ob;

	if( !arg ) return notify_fail("你要買什麼東西 ?\n");

	if( !storage ) return notify_fail("店裡現在沒有貨物.\n");
	inv = filter_array( all_inventory(storage), (: $1->query("pawned_time") :));
	if( !sizeof(inv) ) return notify_fail("店裡現在沒有貨物.\n  ");

// This is a crasher! Dunno why .... Annihilator(11/01/95)
//	if( !parse_command(arg, inv, "%o", ob) )
//		return notify_fail("你要買什麼東西 ?\n");

	if( sscanf(arg, "%s %d", arg, index) != 2 ) index = 1;
	index--;
	for(int i=0; i<sizeof(inv); i++)
		if( inv[i]->id(arg) && !(index--)) break;

	if( i==sizeof(inv) )
		return notify_fail("你要買什麼東西﹖\n");
	ob = inv[i];

	if( (int)this_player()->can_afford((int)ob->query("value") * 2) != 1 )
		return notify_fail("你的(零)錢不夠.\n");
	message_vision("$N掏出錢買下一" + ob->query("unit") + ob->name() + "。\n",
		this_player() );
	this_player()->pay_money((int)ob->query("value") * 2);
	ob->delete("pawned_time");
	ob->move(this_player());

	return 1;
}

int do_store(string arg)
{
	if( !wizardp(this_player()) ) return 0;
	if( !storage ) return notify_fail("倉庫物件不存在.\n");
	this_player()->move(storage);
	write("Ok.\n");
	return 1;
}
