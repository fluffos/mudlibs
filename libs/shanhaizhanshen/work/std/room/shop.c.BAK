// shop.c

inherit ROOM;

static object storage;

void remove()
{
	if( storage ) destruct(storage);
}

void setup()
{
	::setup();
	seteuid(getuid());
	if( !storage ) {
		storage = new( base_name( this_object() ) + "_storage");
		storage->set("shop_ob", this_object());
		set("storage_ob", storage);
	}
	set("no_clean_up", 1 );
}

void init()
{
	add_action("do_value", "value");
	add_action("do_sell", "sell");
	add_action("do_list", "list");
	add_action("do_buy", "buy");
	add_action("do_store", "store");
}

string value_string(int value)
{
	int part;
	string msg = "";

	if( value < 1 ) value = 1;
	if( value / 1000000 ) {
		part = value / 1000000;
		value %= 1000000;
		msg += chinese_number( part ) + "繹痊啟";
		if( value ) msg += ", ";
	}
	if( value / 10000 ) {
		part = value / 10000;
		value %= 10000;
		msg += chinese_number( part ) + "繹踢啟";
		if( value ) msg += ", ";
	}
	if( value / 100 ) {
		part = value / 100;
		value %= 100;
		msg += chinese_number( part ) + "繹窅啟";
		if( value ) msg += ", ";
	}
	if( value )
		msg += chinese_number( value ) + "繹肣啟";
	
	return msg;
}

void pay_player(object who, int amount)
{
	object ob;

	if( amount < 1 ) amount = 1;
	if( amount/1000000 ) {
		ob = new(PLATINUM_OB);
		ob->set_amount(amount/1000000);
		ob->move(who);
		amount %= 1000000;
	}
	if( amount/10000 ) {
		ob = new(GOLD_OB);
		ob->set_amount(amount/10000);
		ob->move(who);
		amount %= 10000;
	}
	if( amount/100 ) {
		ob = new(SILVER_OB);
		ob->set_amount(amount/100);
		ob->move(who);
		amount %= 100;
	}
	if( amount ) {
		ob = new(COPPER_OB);
		ob->set_amount(amount);
		ob->move(who);
	}
}

int do_value(string arg)
{
	object ob;
	int value;

	if( !arg || !(ob = present(arg, this_player())) )
		return notify_fail("斕猁鏽妦繫昜こ跤虛爵嘛歎ˋ\n");

	if( ob->query("money_id") )
		return notify_fail("涴岆ヴㄛ斕羶獗徹鎘ˋ\n");

	value = ob->query("value");
	if( !value ) printf("%s珨恅祥硉﹝\n", ob->query("name"));
	else 
		printf("%s硉%s.\n�蝜�斕猁闖堤 (sell)ㄛ 褫眕鏽善%s.\n",
			ob->query("name"), value_string(value),
			value_string(value * 80 / 100) );

	return 1;
}

int do_sell(string arg)
{
	object ob;
	int value;

	if( !arg || !(ob = present(arg, this_player())) )
		return notify_fail("斕猁闖堤妦繫昜こˋ\n");

	if( ob->query("money_id") )	
		return notify_fail("斕猁闖ヴ?\n");
	value = ob->query("value");
	if( !value ) return notify_fail("涴陲昹祥硉ヴ﹝\n");

	if (ob->query("no_sell")) return notify_fail("這樣東西不能賣.\n");

	message_vision("$N把身上的" + ob->query("name") + "賣掉.\n",
		this_player());

	pay_player(this_player(), value * 80 / 100);

	if( storage ) {
		int s;

// Make a simple storage management, when we have more goods in
// storage, only keeps higher price goods.
		s = sizeof(all_inventory(storage));
		if( value >= (s * 10) ) {
			ob->move(storage);
		}
		else destruct(ob);
	}
	else destruct(ob);

	return 1;
}

int do_list(string arg)
{
	object *inv;
	string msg;

	if( !storage ) return notify_fail("店裡現在沒有貨物.\n");
	if( sizeof( inv = all_inventory( storage ) ) == 0 )
		return notify_fail("店裡現在沒有貨物.\n");

	msg = "店裡現在有以下貨物﹕\n  ";
	msg += implode( map_array(inv, (: sprintf("%-30s%s", $1->short(),
		value_string((int)$1->query("value") )) :)), "\n  ");
	msg += "\n";
	this_player()->start_more(msg);
	return 1;
}

int do_buy(string arg)
{
	int index;
	object *inv, ob;

	if( !arg ) return notify_fail("你要買什麼東西 ?\n");

	if( !storage ) return notify_fail("店裡現在沒有貨物.\n");
	if( sizeof( inv = all_inventory( storage ) ) == 0 )
		return notify_fail("店裡現在沒有貨物.\n");

// This is a crasher! Dunno why .... Annihilator(11/01/95)
//	if( !parse_command(arg, inv, "%o", ob) )
//		return notify_fail("你要買什麼東西 ?\n");

	if( sscanf(arg, "%s %d", arg, index) != 2 ) index = 1;
	index--;
	for(int i=0; i<sizeof(inv); i++)
		if( inv[i]->id(arg) && !(index--)) break;

	if( i==sizeof(inv) )
		return notify_fail("你要買什麼東西﹖\n");
	ob = inv[i];

	if( (int)this_player()->can_afford((int)ob->query("value") ) == 0 ) {
		tell_object( this_player(), "你身上帶的錢不夠.\n");
		return 1;
	}
//		return notify_fail("你身上帶的錢不夠.\n");
	if( (int)this_player()->can_afford((int)ob->query("value") ) == 2 ) {
		tell_object( this_player(), "你的零錢不夠.\n");
		return 1;
	}

	message_vision("$N掏出錢買下一" + ob->query("unit") + ob->name() + "。\n",
		this_player() );
	this_player()->pay_money((int)ob->query("value") );
	ob->move(this_player());

	return 1;
}

int do_store(string arg)
{
	if( !wizardp(this_player()) ) return 0;
	if( !storage ) return notify_fail("倉庫物件不存在.\n");
	this_player()->move(storage);
	write("Ok.\n");
	return 1;
}
