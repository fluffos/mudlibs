// space_station.c

#include <dbase.h>
#include <name.h>

inherit F_DBASE;
inherit F_CLEAN_UP;
inherit F_S_MOVE;
inherit F_NAME;

int is_space_station() { return 1; }

int identify( object me, object ob )
{
	if( me->query_skill("identify") >= ob->query("identify"))
		return 1;
	else return 0;
}

void init()
{
	seteuid( getuid() ); 
}

object make_env()
{
	object ob;
	string space;

	if( stringp(space = query("env_space") ) ) {
		call_other(space, "???");
		ob = find_object(space);
	}
	move( ob );
	return ob;
}

void setup()
{
	int temp, i;
	string *obs;

	seteuid(getuid());
	replace_program(SPACE_STATION);
}

varargs void tell_rooms( string str )
{
	int i, j;
	string *files;
	object *rooms = ({ });

	i = sizeof( files = query("rooms") );
	rooms = allocate( i );
	j = 0;
	while( i-- ) {
		if( objectp( rooms[j] = find_object( files[i] ) ) )
			j++;
	}
	tell_room( rooms, str );
}
