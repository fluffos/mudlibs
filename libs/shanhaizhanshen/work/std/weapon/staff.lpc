// staff.c

#include <weapon.h>
#include <dbase.h>

inherit WEAPON;

varargs void init_staff(int dice_number, int dice_roll, int damage_bonus,
	int round, int range, int flag)
{
	if( clonep(this_object()) ) return;

	set("weapon_prop/dice_number", dice_number);
	set("weapon_prop/dice_roll", dice_roll);
	set("weapon_prop/damage_bonus", damage_bonus);
	set("weapon_prop/round", round);
	set("weapon_prop/range", range);

	set("flag", (int)flag );
	set("damage_type", "traditional" );
	set("skill_type", "staff_weapon");
	set("unknown_type", "棍棒");
	if( !query("max_durability") )
		set("max_durability", 600 );
	if( !query("durability") )
		set("durability", 600 );
	if( !query("attack") )
		set("attack", 80 );
	if( !query("defence") )
		set("defense", 60 );
	if( !query("armor_piercing") )
		set("armor_piercing", 5 );

	set("verbs", ({ "bash", "crush", "slam" }) );
}

