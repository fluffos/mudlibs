// ring.c

#include <armor.h>

inherit ARMOR;

void setup() {
  if (clonep(this_object())) return;

  set("armor_type", TYPE_RING);
  if (!query("armor_apply/dodge")
    && weight() > 500)
    set("armor_prop/dodge", -weight() / 500);

  set("unknown_type", "戒指");
  if (query("durability"))
    delete("durability");
  if (query("max_durability"))
    delete("max_durability");
  if (query("armor_prop/traditional_armor"))
    delete("armor_prop/traditional_armor");
  if (query("armor_prop/traditional_resist"))
    delete("armor_prop/traditional_resist");
}
