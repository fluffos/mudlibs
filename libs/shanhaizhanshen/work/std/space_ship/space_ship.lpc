#include <dbase.h>
#include <move.h>
#include <name.h>

inherit F_S_CLEAN_UP;
inherit F_DBASE;
inherit F_S_MOVE;
inherit F_NAME;
inherit F_SAVE;

float *current_coord = ({ 0.0, 0.0, 0.0, });
float *dest_coord = ({ 0.0, 0.0, 0.0, });

float velocity=0.0;
float distance=0.0;

int planet_coord = -1;
int arrive_time = 0;
object docking_ob;
object *ship_rooms = ({ });
object *bridge_rooms = ({ });
object *boarding_tubes = ({ });
object docking_tube;

int is_space_ship() { return 1; }
string query_save_file();
void move_into_orbit();
object query_docking_ob() { return docking_ob; }
object query_docking_tube() { return docking_tube; }
mixed query_ship_rooms() { return ship_rooms; }
mixed query_bridge_rooms() { return bridge_rooms; }
mixed query_boarding_tubes() { return boarding_tubes; }
float query_velocity() { return velocity; }
float query_distance() { return distance; }
int query_arrive_time() { return arrive_time; }
void set_velocity( int velo ) { velocity = to_float( velo ); }
mixed query_current_coord();
mixed query_destination();
void set_destination( float *dest );
void set_planet_coord( int p_coord ) { planet_coord = p_coord; }
int query_planet_coord() { return planet_coord; }
int identify( object me, object ob );
void init();
void setup();
object make_inventory( string file );
void move_into_orbit();
void exit_orbit();
void warp();
void move_into_coord( object sub_space );
string docking( string dock_name );
void launching();
int visible( object ob );
void tell_ship( string str );
void tell_bridge( string str );
void tell_outside( string str );

string query_save_file()
{
	string owner;
	string id;

	owner = query("owner_id");
	id = query("id", 1);
	if( !stringp(owner) ) return 0;
	if( !stringp(id) ) return 0;
	return sprintf( DATA_DIR + "ship/%c/%s/%s", owner[0], owner, id );
}

mixed query_current_coord()
{
	int *coord = ({ 0, 0, 0,});

	coord[0] = to_int(current_coord[0]);
	coord[1] = to_int(current_coord[1]);
	coord[2] = to_int(current_coord[2]);
	return coord;
}

mixed query_destination()
{
	int *coord = ({ 0, 0, 0,});

	coord[0] = to_int(dest_coord[0]);
	coord[1] = to_int(dest_coord[1]);
	coord[2] = to_int(dest_coord[2]);
	return coord;
}

void set_destination( int *dest )
{
	dest_coord[0] = to_float(dest[0]);
	dest_coord[1] = to_float(dest[1]);
	dest_coord[2] = to_float(dest[2]);
	return;
} 

int identify( object me, object ob )
{
	if( me->query_skill("identify") >= ob->query("identify"))
		return 1;
	else return 0;
}

void init()
{
	seteuid( getuid() );
}

void setup()
{
	int *coord_1 = ({ 0, 0, 0,});
	string *obs;
	int i;
	string where;

	if( !clonep() )
		return;
	seteuid(getuid());
	set("no_clean_up", 1 );

	if( where = environment( this_player() )->query("space_station_location") )
		move( where );
	else 
		move( environment( this_player() ) );

	coord_1 = environment()->query("coord_1");
	if( !( planet_coord = environment()->query("coord") ) )
		planet_coord = -1;

	SPACE_SHIP_D->register_ship( this_object() );

	if( arrayp( obs = query("objects") ) ) {
		i = sizeof(obs);
		while( i-- )
			make_inventory( obs[i] );
	}
	return;
}

object make_inventory( string file )
{
	object ob;

	seteuid( getuid() );
	ob = new( file );
	ob->move( this_object() );
	ob->set("owner", this_object() );
	ship_rooms += ({ ob });
	if( ob->query("bridge") )
		bridge_rooms += ({ ob });
	if( ob->query("boarding_tube") )
		boarding_tubes += ({ ob });
	return ob;
}

void move_into_orbit()
{
	object system, planet;
	string *files, *planets;
	object *ships;
	string planet_var;
	string temp;

	system = environment( this_object() );
		
	if( system->is_planet() )
		system = environment( environment() );
	if( !system )
		system = find_object( environment()->query("env_space") );
	if( !system )
		system = call_other( environment()->query("env_space"), "???" );

	planets = system->query("planets/name");
	files = system->query("planets/file");

	planet_var = planets[planet_coord];

	tell_outside( name() + " 瞒秨﹝办.\n");
	if( sscanf( files[planet_coord], "/d/space/planets/%s", temp ) == 1 
		|| sscanf( files[planet_coord], "/d/space/suns/%s", temp ) == 1 ) {

		if( !( ships = system->query_temp( planet_var ) ) )
			ships = ({ });
		if( sizeof( ships ) > 0 )
			move( environment( ships[0] ) ); 
		else {
			move( planet = system->make_inventory( files[planet_coord] ) );
			planet->set( "short", planet_var );
		}
		ships += ({ this_object() });
		system->set_temp( planet_var, ships );
	} else {
		move( files[planet_coord] );
		set_temp("env_space", system );
	}
	tell_outside( name() + " 秈セ︽琍吏露瓂笵.\n");
	return;
}

void exit_orbit()
{
	object system, planet;
	string *files, *planets;
	object *ships;	
	string planet_var;
	object env_space;

	planet = environment();
	system = environment( planet );
	planets = system->query("planets/name");
	planet_var = planets[planet_coord];

	tell_outside( name() + " 瞒秨セ︽琍吏露瓂笵.\n");
	if( env_space = this_object()->query_temp("env_space") ) {
		if( !env_space )
			move( planet->query("env_space") );
		else
			move( env_space );
	} else {
		if( !( ships = system->query( planet_var ) ) )
			ships = ({});
		if( sizeof( ships ) > 1 || sizeof( all_inventory( planet ) ) > 1 )
			this_object()->move( system );
		else {
			this_object()->move( system );
			destruct( planet );
		}
		ships -= ({ this_object() });
		system->set_temp( planet_var, ships );
	}
	tell_outside( name() + " 秈﹝办.\n");
	planet_coord = -1;	
	return;
}

void warp()
{
	float x, y, z;
	object space, sub_space;
	object *inv;
	int i;

	planet_coord = -1;

	x = dest_coord[0] - current_coord[0];
	y = dest_coord[1] - current_coord[1];
	z = dest_coord[2] - current_coord[2];

	distance = sqrt( ( x * x ) + ( y * y ) + ( z * z ) );

	tell_outside("盎代 " +  name() + sprintf(" 秈 %2.1f Ρ硉︽.\n", velocity ) );
	tell_ship("稰谋差ō肚ㄓ皚秈Ρ硉︽玡疭綺笆.\n");
	space = environment();
	sub_space = new("/d/space/sub_space");
	move( sub_space );
	arrive_time = to_int( distance * 60 / velocity );
	call_out("move_into_coord", arrive_time, sub_space );
	if( file_name(space) == "/d/space/common_space" ) {
		if( inv = all_inventory( space ) ) {
			i = sizeof( inv );
			while( i-- ) {
				if( inv[i]->is_space_ship() )
					return;
			}
		}
		SPACE_SHIP_D->remove_common_space( space, space->query("coord_1") );		
	}
	return;
}

void move_into_coord( object sub_space )
{
	string star_file;
	object star;
	int *coord = ({ 0, 0, 0,});

	coord[0] = to_int(dest_coord[0]);
	coord[1] = to_int(dest_coord[1]);
	coord[2] = to_int(dest_coord[2]);

	arrive_time = 0;
	if( !stringp( star_file = SPACE_SHIP_D->query_star_file( coord ) ) ) {
		if( !objectp( star = SPACE_SHIP_D->query_common_space( coord ) ) ) {
			star = new("/d/space/common_space");
			star->move("/d/space/basic_space");
			star->set("short", "﹝丁");
			star->set("long", sprintf(" [畒夹] ( %d, %d, %d )\n羉琍翴翴骸㏄約礚﹝丁.\n", coord[0], coord[1], coord[2]) );
			star->set("coord_1", coord );
			SPACE_SHIP_D->add_common_space( star, coord );
			move( star );
		}
		move( star );
	} else {
		call_other( star_file, "???");
		star = find_object( star_file );
		star->move("/d/space/basic_space");
		move( star );
	}
	tell_outside("盎代 " + name() + " 眖丁秈﹝办.\n");
	tell_ship("稰谋差ō瞒秨Ρ硉︽, 玻ネ綺笆.\n");
	planet_coord = -1;

//	destruct( sub_space );
	current_coord[0] = dest_coord[0];
	current_coord[1] = dest_coord[1];
	current_coord[2] = dest_coord[2];
	
	return;
}

string docking( string dock_name )
{
	string *tubes; 
	object dock, tube;
	int i, flag;

	if( !objectp( dock = present( dock_name, environment() ) ) || !dock->query("space_station") )
		return "﹝办⊿Τ翠.\n";

	docking_ob = dock;

	if( !arrayp( tubes = dock->query("boarding_tubes") ) || tubes == ({ }) )
		return dock->name() + "⊿Τ氨獃祅磨.\n";
	i = sizeof( tubes );
	while( i-- ) {
		call_other( tubes[i], "???");
		tube = find_object(tubes[i]);
		if(!tube) 
			return "pilot: docking tube available.\n";
		if( !objectp( tubes[i]->query("docking_ship") ) ) {
			tubes[i]->set("docking_ship", this_object() );
			docking_tube = tube;
			flag = 1;
			break;
		}
	}
	if( !flag )
		return "眤饼氨獃﹝翠⊿Τ祅磨氨獃.\n";
	tell_outside( name() + " 氨綼 " + dock->name() + "  " + tube->query("short") + ".\n");
	dock->tell_rooms( name() + " 氨綼セび " + tube->query("short") + ".\n" );
	return "";
}

void launching()
{
	tell_outside( name() + " 瞒秨 " + docking_ob->name() + ".\n");
	docking_ob->tell_rooms( name() + " 瞒秨セび " + docking_tube->query("short") + ".\n" );
	docking_tube->delete("docking_ship");
	docking_ob = 0;
	docking_tube = 0;
	return;
}

int enter_stargate( object stargate )
{
	if( move( stargate->query("destination") ) ) {
		tell_ship("硄筁琍悔铬臘, 稰谋ō砰竒筁皚пΡ.\n");
		tell_outside( name() + " 秈 " + stargate->name() + ".\n");
		return 1;
	}
	else return 0;
}

int visible( object ob )
{
	int invis, detect;

	detect = this_object()->query_temp("apply/detect_invis");
	invis = ob->query_temp("apply/invis");

	if( intp( invis ) && ( invis > detect )) return 0;

	return 1;
}

void tell_ship( string str )
{
	tell_room( ship_rooms, str );
	return;
}

void tell_bridge( string str )
{
	tell_room( bridge_rooms, str );
	return;
}

void tell_outside( string str )
{
	object *obs;
	int i;

	obs = all_inventory( environment() );
	i = sizeof( obs );
	while( i-- ) {
		if( obs[i] == this_object() )
			continue;
		if( obs[i]->visible( this_object() ) )
			obs[i]->tell_bridge( str );
	}
	return;
}
