// poison.c

#include <condition.h>
#include <ansi.h>

int update_condition( object me, int duration)
{
	me->receive_damage("spi", 5);
	me->receive_wound("spi", 3);
	me->receive_damage("mov", 20);
	me->receive_wound("mov", 19);

	me->apply_condition("heart_attack", duration - 1);
	message_vision( "$N" HIM "¬ðµM¯Ý«e©âµh !! ©I§l§xÃø !!\n" NOR, me);
	if( duration < 1 ) return 0;

	return 1;
}
