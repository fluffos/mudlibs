// title.c (Mon  09-04-95)
// Display player's title.
// Orignal ES 2 command.
// Last modified by Spock @ FF	97.Sep.5.
 
#include <ansi.h>

inherit F_CLEAN_UP;
inherit F_CMD;
 
int main(object me, string str)
{
    printf(BOLD "%s" NOR "%s\n\n", RANK_D->query_rank(me), me->short(1));
    return 1;
}
 
int help(object me)
{
    write(@HELP
指令格式: title
 
显示你目前的阶级和头衔。

参考: score
HELP
    );
	return 1;
}
 
