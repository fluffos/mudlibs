// quit.c
// Quit game.
// Original ES 2 command.
// Last modified by Spock @ FF	97.Sep.5.

#include <command.h>
#include <ansi.h>

inherit F_DBASE;
inherit F_CLEAN_UP;

void create() 
{
	seteuid(getuid());
	set("name", "离线指令");
	set("id", "quit");
}

int main(object me, string arg)
{
	int i;
	object *inv, link_ob;

	if( me->is_fighting() )
		return notify_fail( "你还在战斗当中！\n" );
	if( !wizardp(me) ) {
		inv = all_inventory(me);
		for(i=0; i<sizeof(inv); i++)
			if( !inv[i]->query_autoload() )
				DROP_CMD->do_drop(me, inv[i]);
	}

	link_ob = me->link();

// We might be called on a link_dead player, so check this.
	if( link_ob ) {

// Are we possessing in others body ?
		if( link_ob->is_character() ) {
			write("你的魂魄回到" + link_ob->name(1) + "的身上。\n");
			exec(link_ob, me);
			link_ob->setup();
			return 1;
		}

		link_ob->set("last_on", time());
		link_ob->set("last_from", query_ip_name(me));

		if( !environment( me)->is_vehicle())
			me->set("startroom", base_name(environment(me)));
		else me->set("startroom", base_name( environment( environment(me))));

	if( !environment( me ) || environment( me )->is_space_ship_room() 
		|| environment( me )->is_space() ) {

		if( me->is_ghost() )
			me->set("startroom", "/d/death/hall" );
		else
			me->set("startroom", "/d/lwe/kedian1" );
	}
	else
		me->set("startroom", base_name(environment(me)));

		me->set("present_time_unit", me->query_time_unit() );

		link_ob->save();
		destruct(link_ob);
	}

	write("您离开了山海战神的世界。\n");
	message("system", me->name() + " (" + me->query("id")  +") 离开了山海战神的世界。\n", environment(me), me);

	CHANNEL_D->do_channel(this_object(), "sys",
		me->name() + "离开了山海战神的世界。");

	me->save();

	destruct(me);

	return 1;
}

int help(object me)
{
	write(@HELP
指令格式： quit

当你想暂时离开时, 可利用此一指令。
HELP
    );
    return 1;
}
