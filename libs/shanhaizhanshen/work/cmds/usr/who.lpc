// who.c
// Display all users online.
// Original ES 2 command.
// Last modified by Spock @ FF	98.Jul.09.

#include <ansi.h>
#include <net/dns.h>

inherit F_CLEAN_UP;
inherit F_CMD;

mixed main(object me, string arg, int remote)
{
	string str, *option;
	object *list;
	int i, j, ppl_cnt = 0, inv_cnt = 0, wiz_cnt = 0;
	int opt_long, opt_id, opt_wiz;

	if( arg ) {
		option = explode(arg, " ");
		i = sizeof(option);
		while( i-- )
			switch(option[i]) {
				case "-l": opt_long = 1;	break;
				case "-i": opt_id = 1;		break;
				case "-w": opt_wiz = 1;		break;
				default:
					if( wizardp(me)
					&&	option[i][0]=='@' ) {
						RWHO_Q->send_rwho_q(option[i][1..sizeof(option[i])],
							me, opt_long);
						write("网络讯息已送出，请稍候。\n");
						return 1;
					}
					return notify_fail("指令格式：who [-l|-i|-w]\n");
			}
	}


	str = "》 " + MUD_NAME + "\n";
	str += "\n";
	list = users();
	list = sort_array(users(), "sort_user", this_object());
	if( opt_long || opt_wiz ) {
		j = sizeof(list);
		while( j-- ) {
// Skip those users in login limbo.
			if( !environment(list[j]) ) continue;
			if( wizardp( list[j] ) ) {
				wiz_cnt ++;
			}
			if( !remote ) {
				if( !me->visible(list[j]) ) {
					inv_cnt ++;
					continue;
				}
			}
			if( opt_wiz && !wizardp(list[j]) ) continue;

			str += sprintf("%12s%-78s\n",
				RANK_D->query_rank( list[j] ),
				list[j]->short(),
				);
		}
	} else {
		j = sizeof(list);
		while( j-- ) {
// Skip those users in login limbo.
			if( !environment(list[j]) ) continue;
			if( wizardp( list[j] ) ) {
				wiz_cnt ++;
			}
			if( !remote ) {
				if( !me->visible(list[j]) ) {
					inv_cnt ++;
					continue;
				}
			}

			ppl_cnt++;

			if( opt_id ) {
				str = sprintf("%s %-18s %s",
					str,
					capitalize( list[j]->query("id") ),
					(ppl_cnt % 4 ? "" : "\n" )
				);
			} else {
				str = sprintf("%s%-20s%-20s%s",
					str,
					CHINESE_D->ansi_display( list[j]->name(), 20 ),
					" / " + capitalize( list[j]->query("id") ),
					(ppl_cnt % 2 ? "" : "\n" )
				);
			}
		}
		if ( !opt_id && ppl_cnt % 2 ) str += "\n";

		if( opt_id && ppl_cnt % 4 ) str += "\n"; 

	}
		
	str += "\n";
	str = sprintf("%s连线 %d 位， 隐形 %d 位， 巫师 %d 位，系统负担：%s\n"
		, str, sizeof(list), inv_cnt, wiz_cnt, query_load_average() + "\n");

	if( remote ) return str;

	me->start_more(str);
	return 1;
}

int sort_user(object ob2, object ob1)
{
	if( wizardp(ob1) && !wizardp(ob2) ) return -1;
	
	if( wizardp(ob2) && !wizardp(ob1) ) return 1;

	if( wizardp(ob1) && wizardp(ob2) )
		return (int)SECURITY_D->get_wiz_level(ob2) 
			- (int)SECURITY_D->get_wiz_level(ob1);
	
	return (int)ob2->query("level") - (int)ob1->query("level");
}

int help(object me)
{
write(@HELP
指令格式： who [-l|-i|-w]

这个指令可以列出所有在游戏中的玩家及其等级。


不加参数则列出玩家的中文名字及代号


相关指令： finger, wizlist
HELP
    );
    return 1;
}
