// save.c
// Save player's data.
// Original ES 2 command.
// Last modified by Spock @ FF	97.Sep.5.

inherit F_CLEAN_UP;
inherit F_CMD;

int main(object me, string arg)
{
	object link_ob;

	seteuid(getuid());

	if( !objectp( link_ob = me->link() ) )
		return notify_fail("你不是经由正常连线进入，不能储存。\n");

	if( !environment( me)->is_vehicle())
		me->set("startroom", base_name(environment(me)));
	else me->set("startroom", base_name( environment( environment(me))));

	if( !environment( me ) || environment( me )->is_space_ship_room() 
		|| environment( me )->is_space() ) {

		if( me->is_ghost() )
			me->set("startroom", "/d/death/hall" );
		else
			me->set("startroom", "/d/lwe/kedian1" );
	}

	else
		me->set("startroom", base_name(environment(me)));

	me->set("present_time_unit", me->query_time_unit() );

	if( (int)link_ob->save() && (int)me->save() ) {
        write("档案储存完毕。\n");
		return 1;
	} else {
		write("储存失败。\n");
		return 0;
	}
}

int help(object me)
{
	write(@HELP
指令格式save


把你辛苦奋斗的结果存起来。
HELP
	);
	return 1;
}
