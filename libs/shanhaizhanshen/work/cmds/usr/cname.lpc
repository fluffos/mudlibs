// cname.c
// Change user's Chinese name.
// Author: Spock @ FF 97.Sep.5.
// Last modified by Spock	97.Nov.2.

#include <ansi.h>

inherit F_CLEAN_UP;
inherit F_CMD;

int main(object me, string arg)
{
	object ob;

	if( !arg ) return notify_fail("您要替自己取什么中文名字 ?\n");
	if( strlen( arg ) > 75 || sizeof( explode ( arg, "\n" ) ) > 1 )
		return notify_fail("你的中文名字太长了，请想一个短而好听的。\n");

	arg = CHINESE_D->ansi_color( arg );

	ob = me->link();
	ob->set("name", NOR + arg + NOR );
	ob->save();

	me->set("name", NOR + arg + NOR );
	write("Ok.\n");
	return 1;
}
int help(object me)
{
        write(@HELP
指令格式： cname <中文名字>
这个指令可以证您更改自己 
硂琵眤э︑いゅ, 程 75 bytes.
セや穿︹眒﹚, 叫ǎ help color.
眤狦辨い
ㄏノ ANSI 北じэ跑肅︹, ノ北﹃:

$BLK$ - 堵︹		$NOR$ - 確タ盽肅︹
$RED$ - ︹		$HIR$ - 獹︹
$GRN$ - 厚︹		$HIG$ - 獹厚︹
$YEL$ - 独︹		$HIY$ - 独︹
$BLU$ - 瞏屡︹		$HIB$ - 屡︹
$MAG$ - 睱档︹		$HIM$ - ︹
$CYN$ - 屡厚︹		$HIC$ - ぱ獵︹
$WHT$ - 睱η︹		$HIW$ - フ︹
 
╰参穦︑笆﹃玡㎝Ю狠 $NOR$.

把σ: nick, desc, finger, email, profile, signature
HELP
        );
        return 1;
}
