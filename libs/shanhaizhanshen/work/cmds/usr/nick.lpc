// nick.c
// Change player's nick name.
// Original ES 2 command.
// Last modified by Spock @ FF	97.Sep.5.

#include <ansi.h>

inherit F_CLEAN_UP;
inherit F_CMD;

int main(object me, string arg) {
  if (!arg) return notify_fail("你要替自己取什么绰号。\n");
  if (strlen(arg) > 210)
    return notify_fail("绰号太长了，请你想一个短一点的、响亮一点的。\n");

  arg = CHINESE_D->ansi_color(arg);

  me->set("nickname", arg + NOR);

  write("Ok.\n");
  return 1;
}
int help(object me) {
  write(@HELP
指令格式： nick <外号或绰号>

这个指令可以让你为自己取一个响亮的名号或头衔。 

如果你希望使用 ANSI 的控制字元改变颜色，可以用以下的控制字串：
$BLK$ - 黑色		$NOR$ - 恢复正常颜色
$RED$ - 红色		$HIR$ - 亮红色
$GRN$ - 绿色		$HIG$ - 亮绿色
$YEL$ - 土黄色		$HIY$ - 黄色
$BLU$ - 深蓝色		$HIB$ - 蓝色
$MAG$ - 浅紫色		$HIM$ - 粉红色
$CYN$ - 蓝绿色		$HIC$ - 天青色
$WHT$ - 浅灰色		$HIW$ - 白色
$BLINK$ - 字符闪烁
其中系统自动会在字串尾端加一个 $NOR$。
字串或绰号为cancel时将取消该项属性，玩家只能取消<绰号>。

参考: cname, desc
HELP
  );
  return 1;
}
