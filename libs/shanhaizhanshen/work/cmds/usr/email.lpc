// email.c
// Change user's email address data.
// Author:	Spock @ FF
// Last modified by Spock @ FF	97.Sep.5.

#include <ansi.h>

inherit F_CLEAN_UP;
inherit F_CMD;

int help(object me);

int main(object me, string arg) {
  object ob;

  if (!arg) {
    help(me);
    return 1;
  }
  if (strlen(arg) > 100)
    return notify_fail("您输入的电子邮件信箱地址太长了。.\n");

  ob = me->link();
  ob->set("email", arg);
  ob->save();

  write("Ok.\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式： email <您的电子邮件信箱地址>

这个指令可以让您更改自己的电子邮件信箱地址。 


参考: finger, cname, profile, signature
HELP
  );
  return 1;
}
