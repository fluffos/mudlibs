// finger.c
// Display a player's personal data.
// Original ES 2 command.
// Last modified by Spock @ FF	97.Sep.5.

inherit F_CLEAN_UP;
inherit F_CMD;

int main(object me, string arg)
{
	if( !arg ) {
		if( !wizardp(me) )
			return notify_fail("请您指定欲查询的玩家代号。\n");
		write( FINGER_D->finger_all() );
	} else {
		write( FINGER_D->finger_user(arg, me) );
	}
	return 1;
}

int help(object me)
{
  write(@HELP
指令格式： finger [使用者姓名]

这个指令, 如果没有指定使用者姓明, 会显示出所有正在线上玩家
的连线资料. 反之, 则可显示有关某个玩家的连线, 权限等资料.
see also : who, cname, email, profile
HELP
    );
    return 1;
}
 
