// hp.c
// Display brief status of user.
// Original ES 2 hp cmds (Mon  09-04-95)
// Last modified by Spock @ FF	97.Sep.5.
 
#include <ansi.h>
 
inherit F_CLEAN_UP;
inherit F_CMD;
 
string status_color(int current, int max);
 
int main(object me, string arg)
{
	object ob;
	mapping my;
	string *lim;
	int *hit, *eff, *max;
	int j;
 	string str;
 
	seteuid(getuid(me));
 
	if(!arg)
		ob = me;
	else if (wizardp(me)) {
		ob = present(arg, environment(me));
		if (!ob) ob = find_player(arg);
		if (!ob) ob = find_living(arg);
        if (!ob) return notify_fail("你要察看谁的状态？\n");
	} else
                return notify_fail("只有巫师能察看别人的状态。\n");
 
	my = ob->query_entire_dbase();
 
	str = sprintf(" [精神]  %s%d" NOR " / %s%d" NOR " / " HIW "%d" NOR "\n",
		status_color(my["spi"], my["eff_spi"]),
		my["spi"],
		status_color(my["eff_spi"], my["max_spi"]),
		my["eff_spi"],
		my["max_spi"]);

	str += sprintf(" [移动]  %s%d" NOR " / %s%d" NOR " / " HIW "%d" NOR "\n",
		status_color(my["mov"], my["eff_mov"]),
		my["mov"],
		status_color(my["eff_mov"], my["max_mov"]),
		my["eff_mov"],
		my["max_mov"]);

	lim = ob->query("limbs");
	hit = my["limbs_hit"];
	eff = my["limbs_eff_hit"];
	max = my["limbs_max_hit"];

	str += " [体能]  ";

	for( j = 0; j < sizeof( lim ) ; j++ ) {
		str += sprintf( NOR "%s %s%4d ",
				lim[j],
        	        	status_color( hit[j], max[j] ),
	        	        hit[j] );
	}

	str += "\n         "; 

	for( j = 0; j < sizeof( lim ) ; j++ ) {
		str += sprintf( NOR "%s %s%4d ",
				lim[j],
        	        	status_color( eff[j], max[j] ),
	        	        eff[j] );
	}

	str += "\n         "; 

	for( j = 0; j < sizeof( lim ) ; j++ ) {
		str += sprintf( NOR "%s " HIW "%4d ",
				lim[j],
	        	        max[j] );
	}

	str += NOR "\n";

  	str += sprintf(" [食物]  %s%3d" NOR "%%           [饮水] %s%3d" NOR "%%\n",
		status_color( my["food"], ob->max_food_capacity() ),
		my["food"] * 100 / ob->max_food_capacity(),
		status_color(my["water"], ob->max_water_capacity()),
		my["water"] * 100 / ob->max_water_capacity() );

	str += sprintf(" [时间]  " YEL "%2d" NOR "             [经验]  %s%d\n" NOR,
		me->query_time_unit(), HIM, my["combat_exp"] );

	write( str );

	return 1;
}
 
string status_color(int current, int max)
{
	int percent;
 
	if( max>0 ) percent = current * 100 / max;
	else percent = 100;
	if( percent > 100 ) return HIC;
	if( percent >= 80 ) return HIG;
	if( percent >= 65 ) return GRN;
	if( percent >= 50 ) return HIY;
	if( percent >= 35 ) return YEL;
	if( percent >= 20 ) return HIR;
	return RED;
}
 
int help(object me)
{
	write(@HELP
指令格式： hp
           hp <对象名称>         (巫师专用)
 
这个指令可以显示你(你)或指定对象(含怪物)的简单资料。 
参考: score, body
HELP
    );
    return 1;
}
