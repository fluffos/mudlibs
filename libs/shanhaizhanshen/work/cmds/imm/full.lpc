// full.c
// To restore best condition of one character.
// Author: Spock @ FF	97.Mar.22.

inherit F_CLEAN_UP;
inherit F_CMD;

int main(object me, string arg) {
  object ob;
  mapping my;
  int *hits, *effs, *maxs;
  int i;

  seteuid(getuid(me));

  if (!arg)
    ob = me;
  else
    ob = present(arg, environment(me));

  if (!ob) ob = find_player(arg);
  if (!ob) ob = find_living(arg);

  if (!ob) return notify_fail("你要恢复谁的最佳状态?\n");

  my = ob->query_entire_dbase();

  hits = my["limbs_hit"];
  effs = my["limbs_eff_hit"];
  maxs = my["limbs_max_hit"];

  ob->set("spi", my["max_spi"]);
  ob->set("eff_spi", my["max_spi"]);
  ob->set("mov", my["max_mov"]);
  ob->set("eff_mov", my["max_mov"]);

  for (i = 0; i < sizeof(maxs); i++) {
    effs[i] = maxs[i];
    hits[i] = maxs[i];
  }
  ob->set("limbs_hit", hits);
  ob->set("limbs_eff_hit", effs);

  ob->set("food", ob->max_food_capacity());
  ob->set("water", ob->max_water_capacity());

  if (ob != me)
    write("Full condition.\n");
  tell_object(ob, "Full condition.\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : full
           full <对象名称>
 
恢复你或指定对象的最佳状态。
HELP
  );
  return 1;
}
