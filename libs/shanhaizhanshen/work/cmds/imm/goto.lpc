// goto.c

inherit F_CLEAN_UP;
inherit F_CMD;

int main(object me, string arg)
{
	int goto_inventory = 0;
	object obj;
	string msg;

	if( !arg ) return notify_fail("你要去哪里？\n");

	if( sscanf(arg, "-i %s", arg) ) goto_inventory = 1;

	if( !arg ) return notify_fail("你要去哪里？\n");

	obj = find_player(arg);
	if(!obj) obj = find_living(arg);
	if(!obj) obj = find_object(arg);
	if(!obj || !me->visible(obj)) {
		arg = resolve_path(me->query("cwd"), arg);
		if( !sscanf(arg, "%*s.lpc") ) arg += ".lpc";
		if( !(obj = find_object(arg)) ) {
			if( file_size(arg)>=0 )
				return me->move(arg);
			return notify_fail("没有这个玩家、生物、物品或地方。\n");
		}
	}

	if(!goto_inventory && environment(obj))
		obj = environment(obj);

	if( !obj ) return notify_fail("这个物品没有环境可以 goto.\n");

    if( stringp(msg = me->query("env/msg_mout")) )
        message_vision(msg+"\n", me);
	else
		message_vision("随着一团火炎的升起， $N 的身影渐渐的淡化。\n", me);

	me->move(obj);

	if( stringp(msg = me->query("env/msg_min")) )
        message_vision(msg+"\n", me);
	else
		message_vision("轰的一声巨响， $N 头下脚上的从空中掉了下来，在地面上撞出了一个人形的洞。\n", me);

	return 1;
}

int help(object me)
{
write(@HELP
指令格式 : goto [-i] <ヘ夹>
 
硂穦盢肚癳﹚ヘ夹. ヘ夹琌living ┪┬丁
郎. 狦ヘ夹琌living , 穦砆簿蛤ê妓吏挂.
狦Τ -i 把计ヘ夹琌 living, 玥穦砆簿赣 living 
 inventory い.
 
HELP
    );
    return 1;
}
