// attack.c
// attack a vehicle !
// Author: Spock @ FF
// Last modified by Spock @ FF   97.Feb.15.

#include <ansi.h>

inherit F_CLEAN_UP;
inherit F_CMD;

int main(object me, string arg)
{
	object obj;
	string *killer, callname;
	object *inv;
	int i, flag;

	if( me->query("position") == "rest" )
		return notify_fail("你得先站起身子才行。\n");

	if( me->query("position") == "sleep" )
		return notify_fail("你仍在睡梦中。\n");

	if( environment(me)->query("no_fight") )
		return notify_fail("月影巫师告诉你这里不许打架。\n");

	if( !arg )
		return notify_fail("你想攻击什么？\n");

	if(!objectp(obj = present(arg, environment(me))))
		return notify_fail("这里没有这个载具。\n");

	if( !obj->is_vehicle() || obj->is_trash() )
		return notify_fail("看清楚一点，那个不是载具。\n");

	inv = all_inventory( obj );

	message_vision("\n$N 突然开始攻击 $n !!\n", me, obj);
	me->kill_ob(obj);
	me->set_temp("last_opponent", obj );

	return 1;
}
int help(object me)
{
  write(@HELP
指令格式 : attack <载具>

这个指令让你主动开始攻击一个载具或人物。 
其他相关指令： kill
HELP
    );
    return 1;
}
 
