// study.c
// usage: study a knowledge from books or certain materials.
// author: original ES II command.
// Last modified by Spock @ FF   98.Aug.18.

#include <skill.h>

inherit F_CLEAN_UP;
inherit F_CMD;

void create() { seteuid(getuid()); }

int main(object me, string arg) {
  object ob;
  mapping skill, make;
  string *base_name_list;
  int cost;
  mapping valid_make;

  if (me->query("position") == "sleep")
    return notify_fail("你仍在睡梦中。\n");

  if (me->query_time_unit() <= 0)
    return notify_fail("笆ぃ镑е !\n");

  if (me->is_fighting())
    return notify_fail("礚猭驹矮い盡みㄓ弄穝 !\n");

  if (!arg || !objectp(ob = present(arg, me)))
    return notify_fail("璶弄ぐ或\n");

  message("vision", me->name() + " タ盡み弄 " + ob->name()
    + " ず甧.\n", environment(me), me);

  me->time_unit_loss(100);

  if (mapp(skill = ob->query("skill"))) {
    if (me->query_skill("literacy") < skill["literacy"])
      return notify_fail("ぱ, ぃ来柑ず甧.\n");

    if (!SKILL_D(skill["name"])->valid_learn(me)) {
      write(SKILL_D(skill["name"])->learn_failed(me));
      return notify_fail("ヘ玡, 临⊿Τ快猭厩硂贺м.\n");
    }

    cost = skill["spi_cost"] - ((int)me->query("int"));

    if ((int)me->query("spi") < cost) {
      write("瞷筁痟, 礚猭盡みㄓ弄穝.\n");
      return 1;
    }

    if (me->query_skill(skill["name"], 1) > skill["max_skill"])
      return notify_fail("弄穦ㄠ, 琌祇瞷ず甧癸τēび睱, ⊿Τ厩ヴ︙穝.\n");

    me->receive_damage("spi", cost);
    me->time_unit_loss(skill["time_unit_cost"]);

    if (!me->query_skill(skill["name"], 1))
      me->set_skill(skill["name"], 0);
    me->improve_skill(skill["name"], (int)me->query("int") / 5 + 1);
    write("弄Τ闽" + to_chinese(skill["name"]) + "мォΤ翴み眔.\n");

    return 1;

  } else if (mapp(make = ob->query("make"))) {
    if (me->query_skill("literacy") < make["literacy"])
      return notify_fail("ぱ, ぃ来柑ず甧.\n");

    if (me->query_skill(make["skill_name"]) < make["skill_level"]) {
      write(sprintf(" [%s] 璶笷 %d, 厩穦贺舱杆м砃.\n",
        to_chinese(make["skill_name"], make["skill_level"])));
      return notify_fail("ヘ玡, 临⊿Τ快猭厩硂贺舱杆м砃.\n");
    }

    if (member_array(make["base_name"], me->query("valid_make/base_name_list")) > -1)
      return notify_fail("弄穦ㄠ, 琌祇瞷Ν竒笵柑┮癘更ず甧, ⊿Τ厩ヴ︙穝.\n");

    cost = make["spi_cost"] - ((int)me->query("int"));

    if ((int)me->query("spi") < cost)
      return notify_fail("瞷筁痟, 礚猭盡みㄓ弄穝.\n");

    me->receive_damage("spi", cost);
    me->time_unit_loss(make["time_unit_cost"]);

    if (!mapp(valid_make = me->query("valid_make"))) {
      valid_make = ([]);
      me->set("valid_make", ([]));
      if (!arrayp(me->query("valid_make/base_name_list"))) {
        valid_make["base_name_list"] = ({});
        me->set("valid_make/base_name_list", ({}));
      }
    }

    valid_make["base_name_list"] += ({ make["base_name"] });

    valid_make += ([
      make["base_name"]:
      ([
        "name": make["name"],
        "cname": make["cname"],
        "component_names": make["component_names"],
        "component_cnames": make["component_cnames"],
        "component_bnames": make["component_bnames"],
      ])
    ]);
    me->set("valid_make", valid_make);

    write("厩穦︙舱杆 " + make["cname"] + " (" + make["name"] + ") м砃.\n");
    return 1;
  }

  return notify_fail("礚猭眖硂妓珇厩ヴ︙狥﹁.\n");

}

int help(object me) {
  write(@HELP
指令格式： study <珇嘿>
丁: ︓ぶ 100 虫︗, 珇のㄤず甧肂.

硂ㄏ眖セ┪ㄤ珇︑厩琘ㄇм, ┪厩策珇舱杆м砃.
琌Τ砛м惠璶ㄤмよ厩策, 舱杆м砃惠璶疭﹚膀セм.

把σ: learn
HELP
  );
  return 1;
}
