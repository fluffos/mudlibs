// disembark.c
// Disembark from a space ship.
// Author: Spock @ FF	97.May.7.
// Last modified by Spock @ FF   98.Aug.31.

#include <ansi.h>

inherit F_CLEAN_UP;
inherit F_CMD;

int do_disembark( object me, object env, object dest);

void create() { seteuid(getuid()); }

int main( object me)
{
	object env, dest;
	string msg;

	if( me->query("position") == "rest" )
		return notify_fail("你得先站起身子才行。\n");

	if( me->query("position") == "sleep" )
		return notify_fail("你仍在睡梦中。\n");

       
	if( me->is_busy() )
		return notify_fail("你上一个动作还没有完成！\n");

	if( (int)environment( me )->is_space_ship_room() )
		env = environment( environment( me) );

	if( !env->is_space_ship() && !env->is_shuttle() ) 
		return notify_fail("你不在任何船舰中。\n");

	if( !environment( me )->query("boarding_tube") )
		return notify_fail("你要到登舱门才能离舰。\n");
		
	dest = environment( env );
		if( !env->query_docking_ob() )
			return notify_fail("船舰并没有停泊下来。\n");
		if( !dest) 
			return notify_fail("你无法离开这艘船舰。\n");

	if( (int)env->query("lock") == 1 ) {
		msg = env->name() + " 的登舱门已经锁上了。\n";
		return notify_fail( msg );
	}

	if( objectp( env->query_docking_tube() ) )
		dest = env->query_docking_tube();

	return do_disembark(me, env, dest);
}
	
int do_disembark( object me, object env, object dest)
{
	message_vision( sprintf("$N 从一%s %s 走出来。\n", 
			env->query("unit"), env->query("name")), me);
	if( me->move( dest) ) {
		if( me->is_fighting() ) me->start_busy(1);
		message_vision( sprintf("$N 离开这%s %s.\n", 
				env->query("unit"), env->query("name")), me);
		if( me->query_temp("command")) me->delete_temp("command");
		me->set_temp("location", env->query_temp("location"));
		me->time_unit_loss( 10 + ( 25 - me->query("dex")) / 5 );
		return 1;
	}
	else return 0;
}

int help(object me)
{
	write(@HELP
指令格式： disembark

这个指令可以让您离开正在搭乘的宇宙船舰。 


参考： board, pilot, sl
HELP
    );
    return 1;
}
 
