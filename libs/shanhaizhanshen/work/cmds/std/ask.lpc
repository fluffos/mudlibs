// ask.c
// ask someone for some information.
// Original ES II command.
// Last modified by Spock @ FF   97.Feb.3.

#include <ansi.h>

inherit F_CLEAN_UP;
inherit F_CMD;

string *msg_dunno = ({
	"$n摇摇头，说道：没听说过。\n",
	"$n疑惑地看着$N，摇了摇头。\n",
	"$n睁大眼睛望着$N，显然不知道$P在说什么。\n",
	"$n耸了耸肩，很抱歉地说：无可奉告。\n",
	"$n说道：嗯....这我可不清楚，你最好问问别人吧。\n",
	"$n想了一会儿，说道：对不起，你问的事我实在没有印象。\n",
});

int main(object me, string arg)
{
	string dest, topic, msg;
	object ob;
	mapping inquiry;

	seteuid(getuid());

	if( me->query("position") == "sleep" )
		return notify_fail("你仍在睡梦中。\n");


	if( !arg || sscanf(arg, "%s about %s", dest, topic)!=2 )
		return notify_fail("你要问谁什么事？\n");

	if( !objectp(ob = present(dest, environment(me))) )
		return notify_fail("这里没有这个人。\n");

	if( !ob->is_character() ) {
		message_vision("$N对着$n自言自语....\n", me, ob);
		return 1;
	}

	if( !ob->query("can_speak") ) {
		message_vision("$N 向 $n 询问 " + topic + " 的事，但是 $p 显然听不懂 $N 的话。 \n", me, ob);
		return 1;
	}

	me->time_unit_loss( 5 );

	if( !INQUIRY_D->parse_inquiry(me, ob, topic) )
		message_vision("$N 向 $n 询问 " + topic + " 的事。\n", me, ob);

	if( userp(ob) ) return 1;
	if( !living(ob) ) {
		message_vision("但是很显然的，$n现在的状况没有办法给$N任何答覆。\n",
			me, ob);
		return 1;
	}

	if( msg = ob->query("inquiry/" + topic) ) {
		if( stringp(msg) ) {
			message_vision( "$N" CYN "说道：\n" + msg + "\n" NOR, ob);
			return 1;
		}
	} else
		message_vision(msg_dunno[random(sizeof(msg_dunno))], me, ob);

	return 1;
}

int help(object me)
{
   write( @HELP
指令格式： ask <someone> about <something>

这个指令在冒险时很重要，通常必须藉由此一指令才能
获得进一步的资讯。

通常所有的非玩家人物都可以问其姓名 (name) ，
不过，你得先会讲他们听得懂的语言，某些时候
还可以问当地情形 (here) 和打听消息 (rumor).
HELP
   );
   return 1;
}
