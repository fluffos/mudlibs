#include <room.h>
#include <ansi.h>
#include <localtime.h>

inherit F_CLEAN_UP;
inherit F_CMD;

#define LOOK_CMD	"/cmds/std/look.lpc"

int main(object me, string arg) {
  object obj, env;
  int result;

  if (me->query("position") == "sleep")
    return notify_fail("你仍在睡梦中。\n");

  if (me->query_time_unit() <= 0)
    return notify_fail("笆ぃ镑е !\n");

  if (!environment(me)->is_vehicle()) return notify_fail("ぃ更ㄣい.\n");

  if (!arg) result = LOOK_CMD->look_room(me, environment(environment(me)), "vl");
  else if (obj = present(arg, environment(environment(me)))) {
    if (obj->is_character()) result = LOOK_CMD->look_living(me, obj, "vl");
    else result = LOOK_CMD->look_item(me, obj, "vl");
  } else
    result = LOOK_CMD->look_room_item(me, arg, "vl");

  me->time_unit_loss(1);
  return result;
}

int help(object me) {
  write(@HELP
指令格式： vl [<珇>|<ネ>|<よ>]
丁: 1 虫︗
 
硂琵琩更ㄣぇ吏挂琘ン珇ネ┪琌よ.
 
把σ: look, sl
HELP
  );
  return 1;
}
