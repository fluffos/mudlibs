// wear.c
// Wear a cloth or equipment.
// Original ES II command.
// Last modified by Spock @ FF   97.Feb.6.

#include <ansi.h>

inherit F_CLEAN_UP;
inherit F_CMD;

int do_wear(object me, object ob);

int main(object me, string arg) {
  object ob, *inv;
  int i, count;

  if (me->query("position") == "sleep")
    return notify_fail("你仍在睡梦中。\n");



  if (!arg) return notify_fail("你要穿戴什么？\n");

  if (arg == "all") {
    inv = all_inventory(me);
    for (count = 0, i = 0; i < sizeof(inv); i++) {
      if (inv[i]->query("equipped")) continue;
      if (!inv[i]->identify(me, inv[i])) continue;
      if (inv[i]->query("broken")) continue;
      if (do_wear(me, inv[i])) count++;
    }
    write("Ok.\n");
    return 1;
  }

  if (!objectp(ob = present(arg, me)))
    return notify_fail("你身上没有这样东西。\n");

  if (ob->query("equipped"))
    return notify_fail("你已经装备着。\n");

  if (!ob->identify(me, ob))
    return notify_fail("你不知道怎样使用这样物品.\n");

  return do_wear(me, ob);
}

int do_wear(object me, object ob) {
  string str;

  if (ob->query("female_only")
    && (string)me->query("gender") != "女性")
    return notify_fail("这是女人的衣衫，你不知道穿起来会是什么样子 :)\n");

  if (ob->wear()) {
    if (!stringp(str = ob->query("wear_msg")))
      switch (ob->query("armor_type")) {
        case "belt":
          str = "$N " YEL "将一" + ob->query("unit") + NOR " $n " YEL "围在腰上。\n" NOR;
          break;
        case "boots":
          str = "$N " YEL "将一" + ob->query("unit") + NOR " $n " YEL "套上双脚。\n" NOR;
          break;
        case "cloak":
          str = "$N " YEL "将一" + ob->query("unit") + NOR " $n " YEL "披在身上。\n" NOR;
          break;
        case "coat":
          str = "$N " YEL "将一" + ob->query("unit") + NOR " $n " YEL "穿在身上。\n" NOR;
          break;
        case "earring":
          str = "$N " YEL "将一" + ob->query("unit") + NOR " $n " YEL "戴在耳上。\n" NOR;
          break;
        case "gloves":
          str = "$N " YEL "将一" + ob->query("unit") + NOR " $n " YEL "戴在双手上。\n" NOR;
          break;
        case "head":
          str = "$N " YEL "将一" + ob->query("unit") + NOR " $n " YEL "戴在头上。\n" NOR;
          break;
        case "l_armor":
          str = "$N " YEL "将一" + ob->query("unit") + NOR " $n " YEL "套上双腿。\n" NOR;
          break;
        case "mask":
          str = "$N " YEL "将一" + ob->query("unit") + NOR " $n " YEL "戴在脸上。\n" NOR;
          break;
        case "neck":
          str = "$N " YEL "将一" + ob->query("unit") + NOR " $n " YEL "戴在颈中。\n" NOR;
          break;
        case "pants":
          str = "$N " YEL "将一" + ob->query("unit") + NOR " $n " YEL "穿上双腿。\n" NOR;
          break;
        case "ring":
          str = "$N " YEL "将一" + ob->query("unit") + NOR " $n " YEL "戴在手指上。\n" NOR;
          break;
        case "shield":
          str = "$N " YEL "将一" + ob->query("unit") + NOR " $n " YEL "拿在手上。\n" NOR;
          break;
        case "u_armor":
          str = "$N " YEL "将一" + ob->query("unit") + NOR " $n " YEL "套在身上。n" NOR;
          break;
        case "wrists":
          str = "$N " YEL "将一" + ob->query("unit") + NOR " $n " YEL "戴在手腕上。\n" NOR;
          break;
        default:
          str = "$N " YEL "装备一" + ob->query("unit") + NOR " $n " YEL "在身上。\n" NOR;
          break;
      }
    message_vision(str, me, ob);
    me->time_unit_loss(3);
    return 1;
  } else
    return 0;
}

int help(object me) {
  write(@HELP
指令格式wear <杆称嘿>
丁: 3 虫︗.
 
硂琵琘ン臔ヒ┪︾狝, 癬礟.
 
把σ: remove, unwield, wield
HELP
  );
  return 1;
}
