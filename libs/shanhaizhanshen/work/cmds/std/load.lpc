// load.c
// Load a ammunition of a advanced weapon.
// Author: Spock @ FF
// Last modified by Spock @ FF   97.Feb.6.

inherit F_CLEAN_UP;
inherit F_CMD;

int do_load( object me, object obj, object dest);

void create() { seteuid(getuid()); }

int main(object me, string arg)
{
	string target, item;
	object obj, dest;
	int i;

	if( me->query("position") == "sleep" )
		return notify_fail("你仍在睡梦中。\n");

        if( me->query_time_unit() <= 0 )
                return notify_fail("笆ぃ镑е !\n");

	if(!arg) return notify_fail("璶盢ぐ或紆┪紆媚杆秈妓猌竟 ?\n");

	if( sscanf(arg, "%s with %s", target, item)!=2 )
		return notify_fail("璶杆ぐ或狥﹁ ?\n");

	dest = present(target, me);
	if( !dest || living(dest) ) dest = present(target, environment(me));
	if( !dest || living(dest) )
		return notify_fail("硂柑⊿Τ硂妓狥﹁.\n");

	if(!objectp(obj = present(item, me)))
		return notify_fail("ō⊿Τ硂贺紆┪紆媚.\n");

	if( obj->query("loaded"))
		return notify_fail("猌竟柑竒Τ紆┪紆媚.\n");

	return do_load(me, obj, dest);
}

int do_load(object me, object obj, object dest)
{
	int ammo, i;
	object *inv;

	if( obj->is_clip()) {
		if( !obj->query("weapon_type") == dest->query("weapon_type"))
			return notify_fail("紆籔猌竟砏ぃ才.\n");

		for( i = 0; i < sizeof( inv = all_inventory( obj)); i++) {
			if( !inv[i]->is_ammo()) {
				return notify_fail("紆ず杆Τ紆媚狥﹁.\n");
				break;
			}

			if( !inv[i]->query("weapon_type") == dest->query("weapon_type")) {
				return notify_fail("紆ず杆Τぃ砏紆媚.\n");
				break;
			}

			ammo += inv[i]->query_amount();
		}
	}
	if( ammo >= 0 ) {
		message_vision( sprintf("$N 盢%s %s恶秈 %s.\n",
			obj->query("unit"), obj->name(), dest->name()),
			me );

		dest->set("ammo", ammo);
		dest->set("loaded", 1);
		destruct( obj);
		me->time_unit_loss( 10 );
		return 1;
	}
	return 0;
}

int help(object me)
{
write(@HELP
指令格式： load <猌竟嘿> with <紆┪紆媚嘿>
丁: 10 虫︗.
 
硂琵盢紆媚杆秈猌竟. ō璶Τ猌竟┮惠紆媚, τ
Ω杆秈聋紆媚(  )┪琌紆.
 
把σ: unload.
HELP
    );
    return 1;
}
