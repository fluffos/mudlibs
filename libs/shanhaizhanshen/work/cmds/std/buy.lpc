// buy.c
// Buy something from someone.
// Original ES II command.
// Last modified by Spock @ FF   97.Feb.3.

inherit F_CLEAN_UP;
inherit F_CMD;

int main(object me, string arg) {
  string item, targ;
  object ob, owner;
  mixed handle;
  int price, afford;

  if (me->query("position") == "rest")
    return notify_fail("你得先站起身子才行。\n");

  if (me->query("position") == "sleep")
    return notify_fail("你仍在睡梦中。\n");



  if (me->is_busy()) return notify_fail("你现在没有空。\n");

  if (!arg || sscanf(arg, "%s from %s", item, targ) != 2)
    return notify_fail("指令格式：buy <某物> from <某人>\n");

  if (!objectp(owner = present(targ, environment(me))))
    return notify_fail("你要跟谁卖东西。\n");

  me->time_unit_loss(2);

  if (userp(owner)) {
    message_vision("$N想向$n购买" + item + "。\n", me, owner);
    return 1;
  }

  if (owner->is_fighting())
    return notify_fail("看起来" + owner->name() + "正忙着 ... 打架，没空理你。\n");

  notify_fail("对方好像不愿意与你交易。\n");
  if (!(handle = owner->affirm_merchandise(me, item))) return 0;
  price = owner->query_trading_price(handle);

  switch (me->can_afford(price)) {
    case 0: return notify_fail("你身上的钱不够。\n");
    case 1:
      me->pay_money(price);
      owner->deliver_merchandise(me, handle);
      me->time_unit_loss(3);
      return 1;
    case 2:
      return notify_fail("你没有足够的零钱，而对方也找不开...\n");
  }
  me->time_unit_loss(3);

}

int help(object me) {
  write(@HELP
指令格式： buy <something> from <someone>

这一指令让你可以从某些人身上买到物品。

HELP
  );
  return 1;
}
