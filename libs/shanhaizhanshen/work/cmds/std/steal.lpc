// steal.c
// Steal someone's wallet...
// Original ES II command.
// Last modified by Spock @ FF   97.Sep.4.

#include <ansi.h>

inherit F_CLEAN_UP;
inherit F_CMD;

int main(object me, string arg) {
  string what, who;
  object ob, victim;
  int sp, dp;

  if (me->query("position") == "rest")
    return notify_fail("你得先站起身子才行。\n");

  if (me->query("position") == "sleep")
    return notify_fail("你仍在睡梦中。\n");

  if (me->query_time_unit() <= 0)
    return notify_fail("笆ぃ镑е !\n");

  if (environment(me)->query("no_fight"))
    return notify_fail("<抠> 硂柑窽ゎ︽叛\n");

  if (me->query_temp("stealing"))
    return notify_fail("竒т诀穦も\n");

  if (!arg || sscanf(
    arg,
    "%s from %s",
    what,
    who
  ) != 2) return notify_fail("指令格式﹕steal <物品> from <人物>\n");

  victim = present(who, environment(me));
  if (!victim || victim == me) return notify_fail("稱︽叛癸禜ぃ硂柑\n");
  if (!wizardp(me) && wizardp(victim))
    return notify_fail("產ぃ敖畍ō狥﹁\n");

  if (!ob = present(what, victim)) {
    object *inv;
    inv = all_inventory(victim);
    if (!sizeof(inv))
      return notify_fail(victim->name() + "ō癬ㄓ⊿Τぐ或窥狥﹁敖\n");
    ob = inv[random(sizeof(inv))];
  }
  sp = (int)me->query_skill("pick_pocket") * 5 + (int)me->query("dex") * 2 - (int)me->query("thief") * 20;
  if (sp < 1) sp = 1;
  if (me->is_fighting()) {
    sp /= 2;
    me->start_busy(3);
  }
  dp = (int)victim->query("spi") * 2 + (int)ob->weight() / 25;
  if (victim->is_fighting()) dp *= 10;
  if (ob->query("equipped")) dp *= 10;

  write("ぃ笆羘︹篊篊綼" + victim->name() + "单诀穦も ...\n\n");

  me->set("thief", 1);
  me->set_temp("stealing", 1);
  call_out("compelete_steal", 3, me, victim, ob, sp, dp);
  me->time_unit_loss(300 - me->query_skill("pick_pocket"));

  return 1;
}

private void compelete_steal(object me, object victim, object ob, int sp, int dp) {
  me->delete_temp("stealing");

  if (environment(victim) != environment(me)) {
    tell_object(me, "び堡もヘ夹竒ǐ\n");
    return;
  }

  if (!living(victim) || (random(sp + dp) > dp)) {
    if (!ob->move(me)) {
      tell_object(me, "篘" + ob->query("unit") + ob->name()
        + "琌癸τēびぃ眔ぃ斌\n");
      return;
    }
    tell_object(me, HIW "眔も\n\n" NOR);
    tell_object(me, "Θ\敖" + ob->query("unit") + ob->name() + "\n");
    if (living(victim))
      me->improve_skill("pick_pocket", random(me->query("int")));
    if (random(sp) < dp / 2)
      message("vision", "" + me->name() + "碍碍眖"
        +victim->name() + "ō敖ǐ" + ob->query("unit")
        +ob->name() + "\n", environment(me), ({ me, victim }));
    me->set("thief", 1);
  } else {
    if (random(sp) > dp / 2) {
      tell_object(me, victim->name() + "ぃ竒種锣繷Γ盢も罽\n"
        "临⊿Τ砆祇瞷\n");
      return;
    }
    tell_object(me, HIR "罺縷アも\n\n" NOR);
    message_vision("$N繷タ祇瞷$nもタъ帝$Pō" + ob->name() + "\n\n"
      + "$N耻笵稦ぐ或\n\n", victim, me);
    me->improve_skill("pick_pocket", 1, 1);
    if (userp(victim)) victim->fight_ob(me);
    else victim->kill_ob(me);
    me->fight_ob(victim);
    me->start_busy(5);
    me->set("thief", 1);
  }
}

int help(object me) {
  write(@HELP
指令格式： steal <某物> from <某人>
丁: 300, 繦敖叛мォ矗蔼τ搭ぶ.

硂琵Τ诀穦敖ō狥﹁Θ, 讽礛碞莉眔
赣妓珇琌, 皑Τア酷, 羆Τア, 讽ア毖讽礛碞
眔基, ︓琌ぐ或基......綼︑祇备舘
HELP
  );
  return 1;
}
