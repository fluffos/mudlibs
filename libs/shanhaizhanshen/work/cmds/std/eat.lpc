// fill.c
// Fill some liquid from water resource.
// Modified from ES 2 /feature/liquid.c
// Last modified by Spock @ FF	97.Sep.7.

inherit F_CLEAN_UP;
inherit F_CMD;

int help(object me);

int main(object me, string arg) {
  object obj;

  if (me->query("position") == "sleep")
    return notify_fail("你仍在睡梦中。\n");



  if (this_player()->is_busy())
    return notify_fail("你上一个动作还没有完成。\n");

  if (!arg) return notify_fail("你想吃什么？\n");

  if (!objectp(obj = present(arg, me)))
    return notify_fail("你身上没有这种食物。\n");

  if (!obj->query("food"))
    return notify_fail(obj->name() + "无法食用。\n");

  if ((int)me->query("food") >= (int)me->max_food_capacity())
    return notify_fail("你已经吃得太饱了。\n");

  me->add("food", obj->query("food/supply"));
  me->add("water", obj->query("food/water"));
  if (me->is_fighting())
    me->time_unit_loss(20);
  else
    me->time_unit_loss(2);

  obj->set("value", 0);

  obj->add("food/remaining", -1);
  if (!obj->query("food/remaining")) {
    message_vision("$N 将剩下的 " + obj->name() + " 吃个精光。\n", me);
    destruct(obj);
  } else
    message_vision("$N 拿起 " + obj->name() + " 吃了几口。\n", me);

  return 1;
}

int help(object me) {
  write(@HELP
指令格式： eat <食物名>

吃下某样食物以填饱肚子。


参考： drink, fill
HELP
  );
  return 1;
}
