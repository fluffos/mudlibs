// close.c
// Close a door.
// Original ES II command.
// Last modified by Spock @ FF   97.Feb.6.

#include <room.h>

inherit F_CLEAN_UP;
inherit F_CMD;

int main(object me, string arg)
{
	mapping doors;
	string *dirs, dir;
	int i;

	if( me->query("position") == "sleep")
		return notify_fail("你仍在睡梦中。\n");

       

	if( !arg ) return notify_fail("你要关闭什么？\n");

	doors = environment(me)->query_doors();
	if( mapp(doors) ) {
		dirs = keys(doors);
		if( member_array(arg, dirs)!=-1 ) dir = arg;
		else for(i=0; i<sizeof(dirs); i++)
			if( arg==doors[dirs[i]]["name"] || member_array(arg, doors[dirs[i]]["id"])!=-1 ) {
				dir = dirs[i];
				break;
			}
		if( !dir ) return notify_fail("你要关闭什么？\n");
	
		if( environment(me)->close_door(dir) ) {
			message_vision("$N将" + doors[dir]["name"] + "关上。\n", me);
			me->time_unit_loss( 3 );
			return 1;
		}
	}

	return 0;
}

int help(object me)
{
        write(@HELP
指令格式： close <door> 或 <方向>

这个指令可以让你关上门。 

 
参考： open, lock, unlock
HELP
    );
    return 1;
}
