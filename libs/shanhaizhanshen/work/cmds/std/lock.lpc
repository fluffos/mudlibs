// lock.c
// Lock a door.
// Original ES II command
// Lst modified by Spock @ FF   97.Feb.6.

#include <room.h>

inherit F_CLEAN_UP;
inherit F_CMD;

int main(object me, string arg)
{
	object key_ob;
	mapping doors;
	string *dirs, dir, key, key_id;
	int i;

	if( me->query("position") == "rest" )
		return notify_fail("你得先站起身子才行。\n");

	if( me->query("position") == "sleep" )
		return notify_fail("你仍在睡梦中。\n");

        
	if( !arg ) return notify_fail("你要锁上什么 ?\n");

	if( sscanf( arg, "%s with %s", arg, key) == 2 ) {
		key_ob = present( key, me);
		if( !key_ob) return notify_fail("你没有这把钥匙。\n");
		if( !key_ob->is_key()) 
			return notify_fail("这不是钥匙。\n");
		key_id = key_ob->query("key_id");
	} else return notify_fail("你必须要指定门和钥匙。\n");

	doors = environment(me)->query_doors();
	if( mapp(doors) ) {
		dirs = keys(doors);
		if( member_array(arg, dirs)!=-1 ) dir = arg;
		else for(i=0; i<sizeof(dirs); i++)
			if( arg==doors[dirs[i]]["name"] || member_array(arg, doors[dirs[i]]["id"])!=-1 ) {
				dir = dirs[i];
				break;
			}
		if( !dir ) return notify_fail("你要锁上那里的门？\n");

		me->time_unit_loss( 7 );
		if( environment(me)->lock_door( dir, key_id) ) {
			message_vision("$N 将 " + doors[dir]["name"] + " 锁上。\n", me);
			return 1;
		}
	}

	return 0;
}

int help(object me)
{
        write(@HELP
指令格式： lock <door> 或 <方向名> with <钥匙名>

这个指令可以让你锁上门，但是你得先拥有门的钥匙。 

 
HELP
    );
    return 1;
}
