// getin.c
// To get in a vehicle.
// Author: Spock @ FF
// Last modified by Spock @ FF   97.Feb.3.

inherit F_CLEAN_UP;
inherit F_CMD;

int do_getin(object me, object dest);

void create() { seteuid(getuid()); }

int main(object me, string arg)
{
	string vehicle, msg;
	object dest;
	object *inv;
	int max_capacity, i, j;

	if( me->query("position") == "rest" )
		return notify_fail("你得先站起身子才行。\n");

	if( me->query("position") == "sleep" )
		return notify_fail("你仍在睡梦中。\n");

       

	if( !arg) return notify_fail("你要搭乘什么载具？\n");

	sscanf(arg, "%s", vehicle);

	dest = present(vehicle, me);
	if( !dest || living(dest) ) dest = present(vehicle, environment(me));
	if( !dest || living(dest) )
		return notify_fail("这里没有那个载具。\n");

	if( !dest->is_vehicle())
		return notify_fail("那不是一个载具。\n");

	if( ( me->query_temp("location") - dest->query_temp("location"))
		!= 0 ) {
		msg = dest->name() + " 和你的距离太远了。\n";
		return notify_fail( msg );
	}

	if( dest->query_temp("lock") == 1 ) {
		msg = dest->name() + " 的门已经锁上了。\n";
		return notify_fail( msg );
	}

// The default max capacity of vehicle is only one person.
	if( !dest->query("max_capacity") ) max_capacity = 1;
	else max_capacity = dest->query("max_capacity");

// integer counter j counts how many characters is in the vehicle.
	inv = all_inventory( dest );
	for( i = 0, j = 0; i < sizeof( inv ); i++ ) {
		if( inv[i]->is_character()) j++;
		if( j >= max_capacity ) {
			msg = dest->name() + " 已经满座了。\n";
			return notify_fail( msg );
		}
	}

	return do_getin(me, dest);
}

int do_getin(object me, object dest)
{
	message_vision( sprintf("$N 搭上一%s %s.\n",
		dest->query("unit"), dest->name()), me );
	if( me->move( dest) ) {
		message_vision( sprintf("$N 坐上这%s %s.\n",
			dest->query("unit"), dest->name()),
			me );
		me->time_unit_loss( 2 + ( 25 - me->query("dex")) / 5 );
		return 1;
	}
	else return 0;
}

int help(object me)
{
write(@HELP
指令格式： getin <载具名称>

这个指令可以证你搭上载具，但是你跟载具的距离必须是 0.
 
HELP
    );
    return 1;
}
