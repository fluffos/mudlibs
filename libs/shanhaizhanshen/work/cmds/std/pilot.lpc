// pilot.c
// pilot a space ship.
// Author: Spock @ FF
// Last modified by Spock @ FF   97.Aug.31.

#include <ansi.h>
 
inherit F_CLEAN_UP;
inherit F_CMD;
 
int help();
 
int main( object me, string arg )
{
	object *inside, bridge, ship, ob;
	int i, planet, flag = 0;
	int *coord = ({ 0, 0, 0, });
	int cmding;
	float velocity;	
	string *planets;
	string msg = "", name, type;

	if( me != this_player(1) ) return 0;

	if( me->query("position") == "sleep")
		return notify_fail("你仍在睡梦中。\n");

       
 
	bridge = environment( me );

	if( !bridge->is_space_ship_room() )
		return notify_fail("ぃヴ︙﹝差磨┪び濒い.\n");

	if( !bridge->query("bridge") )
		return notify_fail("ぃ磨爵い.\n");

	ship = environment( environment( me ) );
	if( (int)ship->is_space_ship() )
		type = "ss";
	else
		type = "shuttle";

	cmding = me->query_temp("ss_command");

	if( !arg ) {		
		if( !wizardp(me)){
			i = sizeof( inside = all_inventory(bridge) );
			while( i-- ) {
				if( inside[i] == me ) continue;
				if( inside[i]->query_temp("ss_command"))
					return notify_fail(sprintf("%s(%s)タГ緍緋畒.\n",
						inside[i]->query("name"),capitalize(geteuid(inside[i]))));		
			}
		}
		if( me->query_temp("ss_command") == 1 ) {
			return notify_fail("眤竒Г緍緋畒.\n");
		}		
		me->set_temp("ss_command", 1);
		message_vision(sprintf(CYN" %s"CYN"Г緍緋畊, 秨﹍緍緋硂%s%s"CYN".\n"NOR,
		me->query("name"), ship->query("unit"), 
		ship->query("name")), me);
		me->time_unit_loss( 5 );
		return 1;
	} 
	if( cmding ) {
		switch( type ) {
			case "ss":
				if( sscanf( arg, "w %f", velocity) == 1 ) {
					if( !ship->query("max_velocity") )
						return notify_fail("セ磨⊿ΤΡ硉︽.\n");
					if( velocity > ship->query("max_velocity") )
						return notify_fail("禬筁セ磨程蔼硉.\n");
					if( velocity < 0 )
						return notify_fail("セ磨硉ぃ砞﹚璽.\n");
					ship->set_velocity( to_float( velocity ) );
					message_vision( sprintf("セ磨盢秈 %2.1f Ρ硉︽.\n", velocity ), me );
					return 1;
				} else if( sscanf( arg, "c %d,%d,%d", coord[0], coord[1], coord[2] ) == 3) {
					if( !ship->query("max_velocity") )
						return notify_fail("セ磨⊿ΤΡ硉︽.\n");
					if( coord[0] > 999 || coord[0] < -999 || coord[1] > 999 || coord[1] < -999 || coord[2] > 999 || coord[2] < -999 )
						return notify_fail("ヘ畒夹ぃタ絋.\n"); 
					ship->set_destination( coord );
					message_vision( sprintf("セ磨砞﹚ %d-%d-%d.\n", coord[0], coord[1], coord[2]), me);
					return 1;
				} else if( arg == "p" ) {
					planets = environment( ship )->query("planets/name");
					if( !planets )
						planets = environment( ship )->query("env_space")->query("planets/name");
					if( !planets )
						planets = environment( environment( ship ) )->query("planets/name");
					if( !planets )
						return notify_fail("﹝办⊿Τ琍╰.\n");
					msg = "";
					for( i = 0; i < sizeof( planets ); i ++ ) {
						msg += sprintf( "(%d) ", i ) + planets[i] + "\n";
					}
					write( msg );
					return 1;
				} else if( sscanf( arg, "p %d", planet ) == 1 ) {
					planets = environment( ship )->query("planets/name");
					if( !planets )
						planets = environment( ship )->query("env_space")->query("planets/name");
					if( !planets )
						planets = environment( environment( ship ) )->query("planets/name");
					if( !planets )
						return notify_fail("﹝办⊿Τ琍╰.\n");
					if( planet > sizeof( planets ) || planet < 0 )
						return notify_fail("ぃタ絋琍瞴絪腹.\n");
					ship->set_planet_coord( planet );
					message_vision( sprintf("セ磨砞﹚秈吏露 (%d) %s 瓂笵.\n", planet, planets[planet] ), me);
					return 1;
				} else if( arg == "orbit" ) {
					if( ship->query_arrive() )
						return notify_fail("セ磨ぃヴ︙琍╰い.\n");
					if( ship->query_planet_coord() == -1 )
						return notify_fail("临ゼ砞﹚秈材碭琍瞴瓂笵.\n");
					message_vision("$N 笵: 秈瓂笵 !\n", me );
					ship->move_into_orbit();
					return 1;
				} else if( arg == "exit" ) {
					if( ship->query_arrive() )
						return notify_fail("セ磨ぃヴ︙琍╰い.\n");
					if( ship->query_planet_coord() == -1 )
						return notify_fail("セ磨ぃヴ︙琍瞴瓂笵.\n");
					message_vision("$N 笵: 瞒秨瓂笵 !\n", me );
					ship->exit_orbit();
					return 1;
				} else if( arg == "engage" ) {
					if( !ship->query("max_velocity") )
						return notify_fail("セ磨⊿ΤΡ硉︽.\n");
					if( ship->query_destination() == ship->query_current_coord() )
						return notify_fail("セ磨竒砞﹚ヘ畒夹.\n");
					if( (float)ship->query_velocity() == 0.0 )
						return notify_fail("セ磨临ゼ砞﹚硉.\n");
					if( (int)ship->query_arraive_time() )
						return notify_fail("セ磨ご丁Ρ硉︽い.\n");
					message_vision("$N 笵: 币笆 !\n", me );
					ship->warp();
					return 1;
				} else if( sscanf( arg, "enter %s", name ) == 1 ) {
					if( !objectp( ob = present( name, environment(ship) ) ) || !ob->query("stargate") )
						return notify_fail("﹝办⊿Τ琍悔铬臘.\n");
					message_vision("$N 笵: 秈" + ob->name() + ".\n", me );
					ship->enter_stargate( ob );
					return 1;
				} else if( arg == "display" ) {
					if( ship->query("max_velocity") ) {
						msg += sprintf("ヘ玡畒夹: %d-%d-%d	ヘ畒夹: %d-%d-%d\n",
								ship->query_current_coord()[0],
								ship->query_current_coord()[1],
								ship->query_current_coord()[2],
								ship->query_destination()[0],
								ship->query_destination()[1],
								ship->query_destination()[2],
							);
						msg += sprintf("Ρ硉砞﹚: %2.1f 	︽禯瞒: %4.2f \n",
								(float)ship->query_velocity(),
								(float)ship->query_distance(),
							);
						msg += sprintf("︽丁: %d  %d だ\n",
								( (int)ship->query_arrive_time() / 60 ),
								(int)ship->query_arrive_time() % 60,
							);
					}
					msg += sprintf("︽琍瓂笵: 材 %d ︽琍瓂笵	氨綼﹝翠: %s\n",
							ship->query_planet_coord(),
							( (object)ship->query_docking_ob() ? ship->query_docking_ob()->name() : "礚" )
						);

					write( msg );
					return 1;
				} 
			case "shuttle":
				if( sscanf( arg, "dock %s", name ) == 1 ) {
					if( ( msg = (string)ship->docking( name ) ) != "" )
						return notify_fail( msg );
					if( (int)ship->is_space_ship() ) {
						ob = present( name, environment(ship) );
						message_vision("$N 笵: 氨獃 " + ob->name() + ".\n", me );
					} else {
						message_vision("$N 笵: 秈辅笵.\n", me );
					}
					return 1;				
				} else if( arg == "launch" ) {
					if( !( ob = (object)ship->query_docking_ob() ) )
						return notify_fail("差磨ゼ氨獃ヴ︙翠.\n");
					ship->launching();
					if( (int)ship->is_space_ship() )
						message_vision("$N 笵: 瞒秨 " + ob->name() + ".\n", me );
					else
						message_vision("$N 笵: 秈癬祘.\n", me );

					return 1;
				}
		}
	} else return notify_fail("眤瞷⊿Τ緍緋セ磨.\n");
	return 0;
}
 
int help()
{
	write(@HELP
指令格式： pilot			     “ (Г緍緋畊)
	  pilot w <硉>	     》 (砞﹚差磨箇砞Ρ硉硉)
	  pilot c x,y,z		     》 (x, y, z 琌琍╰畒夹)
	  pilot engage		     》 (秨﹍Ρ硉︽)
	  pilot enter <>	     “ (秈琍悔铬臘)
	  pilot p			(セ琍╰︽琍)
	  pilot p <︽琍絪腹>		(砞﹚秈材碭︽琍瓂笵)
	  pilot orbit			(秈砞﹚吏露︽琍瓂笵)
	  pilot exit			(瞒秨ヘ玡︽琍瓂笵)
	  pilot dock <翠>	     “ (盢差磨氨獃び翠
	  pilot dock surface		 緍緋び濒辅︽琍﹝翠)
	  pilot launch		     “ (瞒秨び翠┪︽琍﹝翠)
	  pilot display			(陪ボ緍緋畒祸狾戈)

丁: Г緍緋畒禣 5 虫︗.
	  ㄤ笆 1 虫︗.
 
硂琵秨﹍緍緋﹝差磨, ┪琌癸差磨笷㏑. 
Τ》癘腹, Τ局ΤΡ硉︽ま篮差磨磅︽.
Τ“癘腹琌び濒度磅︽.
﹝︽冈灿弧, 叫把σ help space_flight

把σ: leave, board, disembark, sl
HELP
	);
	return 1;
}
