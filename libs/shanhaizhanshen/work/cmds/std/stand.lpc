// stand.c
// Stand up.
// Author: Spock @ FF
// Last modified by Spock @ FF   97.Sep.4.

inherit F_CLEAN_UP;
inherit F_CMD;

int main( object me )
{
	if( me->is_busy() )
		return notify_fail("你上一个动作还没有完成。\n");

	if( me->is_fighting() )
		return notify_fail("你正在战斗中。\n");

	

	if( me->query("position") == "sleep") {
		me->set("position", "stand");
		message_vision("$N 从睡梦中醒来，抖擞精神站了起来。\n", me);
	} else if( me->query("position") == "stand") {
		return notify_fail("你已经站着了。\n");
	} else if( me->query("position") == "rest") {
                me->set("position", "stand");
		message_vision("$N 打起精神站了起来。\n", me );
	}
	return 1;
}

int help( object me)
{
	write(@HELP
指令格式： stand

让你站起身子。


相关指令: wake, rest, sleep
HELP
	);
        return 1;
}
