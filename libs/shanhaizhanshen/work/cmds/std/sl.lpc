#include <room.h>
#include <ansi.h>
#include <localtime.h>

inherit F_CLEAN_UP;
inherit F_CMD;

#define LOOK_CMD	"/cmds/std/look.lpc"

int main(object me, string arg) {
  object obj, env;
  int result;

  if (me->query("position") == "sleep")
    return notify_fail("你仍在睡梦中。\n");


  if (!environment(me)->is_space_ship_room()) return notify_fail("ぃ﹝差磨い.\n");

  if (!arg) result = LOOK_CMD->look_room(me, environment(environment(environment(me))), "sl");
  else if (obj = present(arg, environment(environment(environment(me))))) {
    if (obj->is_character()) result = LOOK_CMD->look_living(me, obj, "sl");
    else result = LOOK_CMD->look_item(me, obj, "sl");
  } else
    result = LOOK_CMD->look_room_item(me, arg, "sl");

  me->time_unit_loss(1);
  return result;
}

int help(object me) {
  write(@HELP
指令格式： sl [<珇>|<ネ>]
丁: 1 虫︗.
 
硂琵琩差磨ぇ吏挂琘ン珇ネ.
 
把σ: look, vl
HELP
  );
  return 1;
}
