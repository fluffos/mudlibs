// halt.c

#include "/doc/help.h"
inherit F_CLEAN_UP;
inherit F_CMD;

int main(object me, string arg)
{
	object target_ob;
	string target;

	if( !arg ) {
		if( !me->is_fighting() )
			return notify_fail("你现在并没有在战斗。\n");
		me->remove_all_killer();
		me->delete("killer");
		message_vision("$N 用巫师的神力停止了战斗。\n", me);
		write("Ok.\n");
		return 1;
	}

	if( arg && sscanf( arg, "%s", target) != 0 ) {
		target_ob = present( target, environment( me));

		if( !target_ob ) return notify_fail("这里没有你欲停止的战斗目标。\n");
		if( !target_ob->is_fighting() ) return notify_fail("那个人并不在战斗中。\n");

		target_ob->remove_all_killer();
		target_ob->delete("killer");
		message_vision("$N 用巫师的神力停止了战斗。\n", me);
		write("Ok.\n");
		return 1;
	}
}

int help(object me)
{
   write(@HELP
指令格式: halt
	  halt <对象>
可以停止所有和你有关，或别人的战斗。


参考: kill, adv, back
HELP
   );
   return 1;
}
