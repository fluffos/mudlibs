// edstar.c
// edit star system coordinates.
// Author: Spock @ FF	98.Aug.26.
// Last modified by Spock @ FF	98.Aug.26.
inherit F_CLEAN_UP;
inherit F_CMD;

int main(object me, string arg) {
  mapping coords;
  string *star_files;
  int i, *coord = ({ 0, 0, 0 });
  string star_file, str = "";

  if (!arg)
    return notify_fail("叫ノ help edstar 琩高ㄏノよ猭.\n");
  if (arg == "-l") {
    coords = SPACE_SHIP_D->query_all_stars();
    star_files = keys(coords);

    i = sizeof(star_files);
    while (i--) {
      str += sprintf("%-50s 畒夹: %3d, %3d, %3d", star_files[i],
        coords[star_files[i]][0], coords[star_files[i]][1], coords[star_files[i]][2]);
    }
    me->start_more(str);
    return 1;
  } else if (sscanf(arg, "-d %d,%d,%d", coord[0], coord[1], coord[2]) == 3) {
    SPACE_SHIP_D->remove_star(coord, SPACE_SHIP_D->query_star_file(coord));
    return 1;
  } else if (sscanf(arg, "-a %d,%d,%d %s", coord[0], coord[1], coord[2], star_file) == 4) {
    SPACE_SHIP_D->add_star(coord, star_file);
    return 1;
  }
  return notify_fail("叫ノ help edstar 琩高ㄏノよ猭.\n");
}

int help(object me) {
  write(@HELP
指令格式 : edstar -a <琍╰畒夹 x,y,z> <琍╰郎>
	   edstar -d <琍╰畒夹 x,y,z>
	   edstar -l

絛ㄒ:	   edstar 3,3,3 /d/space/system/alpha_centauri

硂糤э埃琍╰┪┮Τ琍╰.
ㄏノ -a 把计糤穝琍╰,  -d 把计穦埃﹚琍╰,
 -l 把计玥穦┮Τ琍╰.
HELP
  );
  return 1;
}
