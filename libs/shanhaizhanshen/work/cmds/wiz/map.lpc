// map.c
// Automatically draw the map within 11 x 11 squares.
// Author: Spock @ FF	97.Mar.18.
// Last modified by Spock @ FF	97.Mar.18.

#include <room.h>
#include <ansi.h>

inherit F_CLEAN_UP;
inherit F_CMD;

nosave mixed *rooms;
nosave mixed *map;

int search_room( string name, int r, int c );

int main( object me, string arg )
{
	mapping exits;
	string *dirs;
	int i, j;
	string msg;

	rooms = allocate( 13 );
	rooms[0] = allocate( 13 );
	rooms[1] = allocate( 13 );
	rooms[2] = allocate( 13 );
	rooms[3] = allocate( 13 );
	rooms[4] = allocate( 13 );
	rooms[5] = allocate( 13 );
	rooms[6] = allocate( 13 );
	rooms[7] = allocate( 13 );
	rooms[8] = allocate( 13 );
	rooms[9] = allocate( 13 );
	rooms[10] = allocate( 13 );
	rooms[11] = allocate( 13 );
	rooms[12] = allocate( 13 );

	map = allocate( 23 );
	map[0] = allocate( 23 );
	map[1] = allocate( 23 );
	map[2] = allocate( 23 );
	map[3] = allocate( 23 );
	map[4] = allocate( 23 );
	map[5] = allocate( 23 );
	map[6] = allocate( 23 );
	map[7] = allocate( 23 );
	map[8] = allocate( 23 );
	map[9] = allocate( 23 );
	map[10] = allocate( 23 );
	map[11] = allocate( 23 );
	map[12] = allocate( 23 );
	map[13] = allocate( 23 );
	map[14] = allocate( 23 );
	map[15] = allocate( 23 );
	map[16] = allocate( 23 );
	map[17] = allocate( 23 );
	map[18] = allocate( 23 );
	map[19] = allocate( 23 );
	map[20] = allocate( 23 );
	map[21] = allocate( 23 );
	map[22] = allocate( 23 );

	search_room( base_name( environment( me ) ), 6, 6 );

	msg = "";
	for( i = 1; i < 22; i++ ) {
		for( j = 1; j < 22; j++ ) {
			if( !map[i][j] )
				map[i][j] = "  ";
			msg += map[i][j];
		}
		msg += "\n";
	}

	write(msg);
	rooms = 0;
	map = 0;
	
	return 1;
}

int search_room( string name, int r, int c )
{
	mapping exits;
	
	if( !name )return 0;
	if( r < 0 || r > 12 || c < 0 || c > 12 ) return 0;
	if( rooms[r][c] ) return 0;

	rooms[r][c] = find_object( name );
	if( !rooms[r][c] ) {
		call_other(name, "???");
		rooms[r][c] = find_object( name );
	}
	if( !rooms[r][c] )
		return 0;
	
	map[r*2 -1][c*2 -1] = "";

	if( rooms[r][c]->query("terrian") == "plain" )
		map[r*2 -1][c*2 -1] = BGRN;
	else if( rooms[r][c]->query("terrian") == "hill" )
		map[r*2 -1][c*2 -1] = BYEL;
	else if( rooms[r][c]->query("terrian") == "mountain" )
		map[r*2 -1][c*2 -1] = BRED;
	else if( rooms[r][c]->query("terrian") == "river" )
		map[r*2 -1][c*2 -1] = BCYN;
	else if( rooms[r][c]->query("terrian") == "ocean" )
		map[r*2 -1][c*2 -1] = BBLU;
	else if( !rooms[r][c]->query("outdoors") )
		map[r*2 -1][c*2 -1] = BMAG;
	else map[r*2 -1][c*2 -1] = BGRN;

	if( r == 6 && c == 6 )
		map[r*2 -1][c*2 -1] += HIW "》" NOR;
	else	map[r*2 -1][c*2 -1] += HIW "〖" NOR;

	exits = rooms[r][c]->query("exits");

	if( exits["north"] )
			map[r*2 - 2][c*2 - 1] = "";
			search_room( exits["north"], r - 1, c );
	if( exits["east"] )
			map[r*2 - 1][c*2] = "⌒";
			search_room( exits["east"], r, c + 1 );	
	if( exits["south"] )
			map[r*2][c*2 - 1] = "";
			search_room( exits["south"], r + 1, c );
	if( exits["west"] )
			map[r*2 - 1][c*2 - 2] = "⌒";
			search_room( exits["west"], r, c - 1 );	
	return 1;
}

int help(object me)
{
   write(@HELP
指令格式: map

绘制出身旁周围 11 x 11 的地图。
HELP
   );
   return 1;
}
