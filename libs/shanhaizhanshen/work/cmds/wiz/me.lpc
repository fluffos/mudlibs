// /cmds/wiz/me.c
//
// Kenny@Broken.History (6/18/1996)

inherit F_CLEAN_UP;
inherit F_ME;				// 膥┯絪胯
inherit F_CMD;


int main(object me, string arg)
{
	string file;
	object ob;
	
	if (in_edit(me)) return notify_fail("你已经在使用编辑器了。\n");
	if (!arg) return notify_fail("指令格式：me <档名>|<物件名>\n");
	
	seteuid(geteuid(me));
	file = resolve_path(me->query("cwd"), arg); // 眔郎
	if (file_size(file) < 0)
	{	// 穝郎
		ob = present(arg, me);	// 浪琩ōン
		if (!ob) ob = present(arg, environment(me)); // 浪琩┬丁柑ン
		if (ob && me->visible(ob))
			file = base_name(ob) + ".lpc"; // 眔ン郎
	}
	
	start_edit(file);		// ㊣絪胯竟秨﹍絪胯
	return 1;
} // main()


int  help(object me)
{
	write(@HELP
指令格式me <档名>|<物件名>

利用此一指令可直接在线上编辑档案，详细说明请看编辑器内的线上辅助说明。


相关指令：edit、update
HELP
		);
	return 1;
} // help()
