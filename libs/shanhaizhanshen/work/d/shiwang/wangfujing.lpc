// Room: /d/huanggon/wangfujing。c

inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "闹市区");
	set("long", @LONG
闹市区的店铺在城里最多，也是生意人最多的地方，各地的商贩
都把货物弄到此地交易，街道两边的招牌一个接一个，排得密密
麻麻的。东面就是狮神酒楼。
LONG
	);
	
	set("no_clean_up", 0);
	set("outdoors", "shiwang");
	set("exits", ([ /* sizeof() == 3 */
  "south" : __DIR__"edajie1",
  "north" : __DIR__"wangfujing1",
  "east" : __DIR__"quanjude",
]));

	setup();
	
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
夜的星空，璀璨夺目，风里的枯枝摇曳着星海无限灿烂的辉煌。
闹市区的店铺在城里最多，也是生意人最多的地方，各地的商贩
都把货物弄到此地交易，街道两边的招牌一个接一个，排得密密
麻麻的。东面就是狮神酒楼。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
东方泛起了鱼肚白，天空瓦蓝瓦蓝的。闹市区的店铺在城里最多，
也是生意人最多的地方，各地的商贩都把货物弄到此地交易，街
道两边的招牌一个接一个，排得密密麻麻的。东面就是狮神酒楼。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
太阳挂在东方的蔚蓝的天空中散射着金色的光芒。闹市区的店铺
在城里最多，也是生意人最多的地方，各地的商贩都把货物弄到
此地交易，街道两边的招牌一个接一个，排得密密麻麻的。东面
就是狮神酒楼。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
太阳开始从西方的天空中慢慢沉落下去。闹市区的店铺在城里最
多，也是生意人最多的地方，各地的商贩都把货物弄到此地交易，
街道两边的招牌一个接一个，排得密密麻麻的。东面就是狮神酒楼。
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，宝蓝色的天空中悄悄露出了滴滴晶莹的星点。闹市
区的店铺在城里最多，也是生意人最多的地方，各地的商贩都把
货物弄到此地交易，街道两边的招牌一个接一个，排得密密麻麻
的。东面就是狮神酒楼。
LONG
);
		}
		return 0;
	}
}


