// Room: shiwang/kangwangfu.c

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "大将军府");
  set("long", @LONG
大将军是狂狮手下的爱将，在以往的战斗中立下赫赫的战功，在
朝中有一席之地，王府建造得富丽堂皇，很有些气势。两个家丁
在角门边闲散的看门。
LONG
  );

  set("exits", ([ /* sizeof() == 2 */
    "north": __DIR__ "tingyuan",
    "south": __DIR__ "wchangan",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "shiwang");

  setup();
}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
夜的星空，璀璨夺目，风里的枯枝摇曳着星海无限灿烂的辉煌。
大将军是狂狮手下的爱将，在以往的战斗中立下赫赫的战功，在
朝中有一席之地，王府建造得富丽堂皇，很有些气势。两个家丁
在角门边闲散的看门。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
东方泛起了鱼肚白，天空瓦蓝瓦蓝的。大将军是狂狮手下的爱将，
在以往的战斗中立下赫赫的战功，在朝中有一席之地，王府建造
得富丽堂皇，很有些气势。两个家丁在角门边闲散的看门。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
太阳挂在东方的蔚蓝的天空中散射着金色的光芒。大将军是狂狮
手下的爱将，在以往的战斗中立下赫赫的战功，在朝中有一席之
地，王府建造得富丽堂皇，很有些气势。两个家丁在角门边闲散
的看门。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
太阳开始从西方的天空中慢慢沉落下去。大将军是狂狮手下的爱
将，在以往的战斗中立下赫赫的战功，在朝中有一席之地，王府
建造得富丽堂皇，很有些气势。两个家丁在角门边闲散的看门。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚降临了，宝蓝色的天空中悄悄露出了滴滴晶莹的星点。大将
军是狂狮手下的爱将，在以往的战斗中立下赫赫的战功，在朝中
有一席之地，王府建造得富丽堂皇，很有些气势。两个家丁在角
门边闲散的看门。
LONG
        );
    }
    return 0;
  }
}
