// Room: shiwang/ndajie2
#include <room.h>
inherit ROOM;
int do_look(string arg);
void create()
{
  set ("short", "北大街");
  set ("long", @LONG
北大街横贯东西，从狮王大殿的后门穿过。这条街道位于帝国的
北面，店铺较少，所住的都是些穷苦人。来往的人多面带菜色。
街道北面是家茶馆，里边时不时暴起两声喝采。
LONG);

  set("outdoors", "shiwang");
  set("exits", ([ /* sizeof() == 3 */
  "west" : __DIR__"ndajie3",
  "east" : __DIR__"guangchang1",
  "north" : __DIR__"chaguan",
]));
set("doors", ([
		"north"	:	([
				"data"		:	"门",
				"other_side_dir":	"south",
			//	"status"	:	DOOR_LOCKED,
				"key_id"	:	"lwe/shop1_key",
				]),]) );
  setup();
  
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
夜的星空，璀璨夺目，风里的枯枝摇曳着星海无限灿烂的辉煌。
北大街横贯东西，从狮王大殿的后门穿过。这条街道位于帝国的
北面，店铺较少，所住的都是些穷苦人。来往的人多面带菜色。
街道北面是家茶馆，里边时不时暴起两声喝采。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
东方泛起了鱼肚白，天空瓦蓝瓦蓝的。北大街横贯东西，从狮王
大殿的后门穿过。这条街道位于帝国的北面，店铺较少，所住的
都是些穷苦人。来往的人多面带菜色。街道北面是家茶馆，里边
时不时暴起两声喝采。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
太阳挂在东方的蔚蓝的天空中散射着金色的光芒。北大街横贯东
西，从狮王大殿的后门穿过。这条街道位于帝国的北面，店铺较
少，所住的都是些穷苦人。来往的人多面带菜色。街道北面是家
茶馆，里边时不时暴起两声喝采。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
太阳开始从西方的天空中慢慢沉落下去。北大街横贯东西，从狮
王大殿的后门穿过。这条街道位于帝国的北面，店铺较少，所住
的都是些穷苦人。来往的人多面带菜色。街道北面是家茶馆，里
边时不时暴起两声喝采。
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，宝蓝色的天空中悄悄露出了滴滴晶莹的星点。北大
街横贯东西，从狮王大殿的后门穿过。这条街道位于帝国的北面，
店铺较少，所住的都是些穷苦人。来往的人多面带菜色。街道北
面是家茶馆，里边时不时暴起两声喝采。
LONG
);
		}
		return 0;
	}
}


