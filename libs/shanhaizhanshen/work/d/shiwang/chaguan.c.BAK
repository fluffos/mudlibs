// Room: /d/huanggon/chaguan.c
#include <room.h>
inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "帝国茶馆");
	set("long", @LONG
你一走进来，就闻到一股茶香沁入心脾，精神为之一爽。几张桌
子一字排开，坐满了客人，或高声谈笑，或交头接耳。
          
         _..,----,.._
      .-;'-.,____,.-';
     (( |            |
      `))            ;   要牛奶、咖啡、还是茶……
       ` \          /
      .-' `,.____.,' '-.
     (     '------'     )
      `-=..________..--'
LONG
	);
	
	set("no_clean_up", 0);
	set("objects", ([
		__DIR__"npc/caguan" : 1,
		
	]));
	set("exits", ([ /* sizeof() == 1 */
  "south" : __DIR__"ndajie2",
]));
set("doors", ([
		"north"	:	([
				"data"		:	"门",
				"other_side_dir":	"south",
			//	"status"	:	DOOR_LOCKED,
				"key_id"	:	"lwe/shop1_key",
				]),]) );
	setup();
	
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
夜的星空，璀璨夺目，风里的枯枝摇曳着星海无限灿烂的辉煌。
你一走进来，就闻到一股茶香沁入心脾，精神为之一爽。几张桌
子一字排开，坐满了客人，或高声谈笑，或交头接耳。
          
         _..,----,.._
      .-;'-.,____,.-';
     (( |            |
      `))            ;   要牛奶、咖啡、还是茶……
       ` \          /
      .-' `,.____.,' '-.
     (     '------'     )
      `-=..________..--'
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
东方泛起了鱼肚白，天空瓦蓝瓦蓝的。你一走进来，就闻到一股
茶香沁入心脾，精神为之一爽。几张桌子一字排开，坐满了客人，
或高声谈笑，或交头接耳。
          
         _..,----,.._
      .-;'-.,____,.-';
     (( |            |
      `))            ;   要牛奶、咖啡、还是茶……
       ` \          /
      .-' `,.____.,' '-.
     (     '------'     )
      `-=..________..--'
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
太阳挂在东方的蔚蓝的天空中散射着金色的光芒。你一走进来，
就闻到一股茶香沁入心脾，精神为之一爽。几张桌子一字排开，
坐满了客人，或高声谈笑，或交头接耳。
          
         _..,----,.._
      .-;'-.,____,.-';
     (( |            |
      `))            ;   要牛奶、咖啡、还是茶……
       ` \          /
      .-' `,.____.,' '-.
     (     '------'     )
      `-=..________..--'
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
太阳开始从西方的天空中慢慢沉落下去。你一走进来，就闻到一
股茶香沁入心脾，精神为之一爽。几张桌子一字排开，坐满了客
人，或高声谈笑，或交头接耳。
          
         _..,----,.._
      .-;'-.,____,.-';
     (( |            |
      `))            ;   要牛奶、咖啡、还是茶……
       ` \          /
      .-' `,.____.,' '-.
     (     '------'     )
      `-=..________..--'
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，宝蓝色的天空中悄悄露出了滴滴晶莹的星点。你一
走进来，就闻到一股茶香沁入心脾，精神为之一爽。几张桌子一
字排开，坐满了客人，或高声谈笑，或交头接耳。
          
         _..,----,.._
      .-;'-.,____,.-';
     (( |            |
      `))            ;   要牛奶、咖啡、还是茶……
       ` \          /
      .-' `,.____.,' '-.
     (     '------'     )
      `-=..________..--'
LONG
);
		}
		return 0;
	}
}
