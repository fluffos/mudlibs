// Room: shiwang/xitiemen。c

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "西铁门");
  set("long", @LONG
西铁门高高的铁灰色城墙的夕阳下十分威武。进出此门的多是到
帝国的生意人，此处向东，是西城街。几个士兵无聊的打着盹。
LONG
  );
  set("outdoors", "shiwang");
  set("exits", ([ /* sizeof() == 2 */

    "east": __DIR__ "wchangan1",
  ]));
  set("no_clean_up", 0);


  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
夜的星空，璀璨夺目，风里的枯枝摇曳着星海无限灿烂的辉煌。
西铁门高高的铁灰色城墙的夕阳下十分威武。进出此门的多是到
帝国的生意人，此处向东，是西城街。几个士兵无聊的打着盹。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
东方泛起了鱼肚白，天空瓦蓝瓦蓝的。西铁门高高的铁灰色城墙
的夕阳下十分威武。进出此门的多是到帝国的生意人，此处向东，
是西城街。几个士兵无聊的打着盹。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
太阳挂在东方的蔚蓝的天空中散射着金色的光芒。西铁门高高的
铁灰色城墙的夕阳下十分威武。进出此门的多是到帝国的生意人，
此处向东，是西城街。几个士兵无聊的打着盹。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
太阳开始从西方的天空中慢慢沉落下去。西铁门高高的铁灰色城
墙的夕阳下十分威武。进出此门的多是到帝国的生意人，此处向
东，是西城街。几个士兵无聊的打着盹。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚降临了，宝蓝色的天空中悄悄露出了滴滴晶莹的星点。西铁
门高高的铁灰色城墙的夕阳下十分威武。进出此门的多是到帝国
的生意人，此处向东，是西城街。几个士兵无聊的打着盹。
LONG
        );
    }
    return 0;
  }
}
