  set("exits", ([ /* sizeof() == 2 */

    "west": __DIR__ "echangan1",
  ]));
  set("no_clean_up", 0);


  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
