  "north" : __DIR__"echangan1",
]));
	set("item_desc", ([ /* sizeof() == 1 */
  "paizi" : "
本庄有利息，至少百分之一。

      存钱        deposit或者cun

      取钱        withdraw或者qu

      钱币兑换    convert或者duihuan

      查帐        check或者chazhang
",
]));

	setup();
	
}
void init()
{
		add_action("do_look", "look");
}
