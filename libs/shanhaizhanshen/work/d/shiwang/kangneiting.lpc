// Room: /d/huanggon/kangneiting.c

inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "王府内厅");
	set("long", @LONG
内厅是大将军招待亲朋好友，聚会的地方，厅中摆了两长溜的凳
子，靠着墙壁十多支高脚琉璃灯大放光明。七八个丫鬟端了盆碗
往来穿梭。南边是天井，北边儿就是后花园。
LONG
	);
	
	set("exits", ([ /* sizeof() == 3 */
  "north" : __DIR__"hougardon",
  "south" : __DIR__"tianjin",
  "west" : __DIR__"shufang",
]));
	set("no_clean_up", 0);

	setup();
	
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
夜的星空，璀璨夺目，风里的枯枝摇曳着星海无限灿烂的辉煌。
内厅是大将军招待亲朋好友，聚会的地方，厅中摆了两长溜的凳
子，靠着墙壁十多支高脚琉璃灯大放光明。七八个丫鬟端了盆碗
往来穿梭。南边是天井，北边儿就是后花园。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
东方泛起了鱼肚白，天空瓦蓝瓦蓝的。内厅是大将军招待亲朋好
友，聚会的地方，厅中摆了两长溜的凳子，靠着墙壁十多支高脚
琉璃灯大放光明。七八个丫鬟端了盆碗往来穿梭。南边是天井，
北边儿就是后花园。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
太阳挂在东方的蔚蓝的天空中散射着金色的光芒。内厅是大将军
招待亲朋好友，聚会的地方，厅中摆了两长溜的凳子，靠着墙壁
十多支高脚琉璃灯大放光明。七八个丫鬟端了盆碗往来穿梭。南
边是天井，北边儿就是后花园。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
太阳开始从西方的天空中慢慢沉落下去。内厅是大将军招待亲朋
好友，聚会的地方，厅中摆了两长溜的凳子，靠着墙壁十多支高
脚琉璃灯大放光明。七八个丫鬟端了盆碗往来穿梭。南边是天井，
北边儿就是后花园。
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，宝蓝色的天空中悄悄露出了滴滴晶莹的星点。内厅
是大将军招待亲朋好友，聚会的地方，厅中摆了两长溜的凳子，
靠着墙壁十多支高脚琉璃灯大放光明。七八个丫鬟端了盆碗往来
穿梭。南边是天井，北边儿就是后花园。
LONG
);
		}
		return 0;
	}
}
