// Room: /d/huanggon/jubaoge.c
#include <room.h>
inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "宝阁");
  set("long", @LONG
宝阁的老板据说是帝国中有势力的将军。这消息不知真假，不过
店中的柜子中摆着各类珠宝玉器金饰古董，映着灯光，直晃得人
眼花。
LONG
  );

  set("no_clean_up", 0);
  set("objects", ([
    __DIR__ "npc/jubao": 1
  ]));
  set("exits", ([ /* sizeof() == 1 */
    "west": __DIR__ "wangfujing2",
  ])); set("doors", ([
    "west": ([
      "data": "门",
      "other_side_dir": "east",
      //	"status"	:	DOOR_LOCKED,
      "key_id": "shiwang/jubaoge_key",
    ]), ]));

  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
夜的星空，璀璨夺目，风里的枯枝摇曳着星海无限灿烂的辉煌。
宝阁的老板据说是帝国中有势力的将军。这消息不知真假，不过
店中的柜子中摆着各类珠宝玉器金饰古董，映着灯光，直晃得人
眼花。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
东方泛起了鱼肚白，天空瓦蓝瓦蓝的。宝阁的老板据说是帝国中
有势力的将军。这消息不知真假，不过店中的柜子中摆着各类珠
宝玉器金饰古董，映着灯光，直晃得人眼花。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
太阳挂在东方的蔚蓝的天空中散射着金色的光芒。宝阁的老板据
说是帝国中有势力的将军。这消息不知真假，不过店中的柜子中
摆着各类珠宝玉器金饰古董，映着灯光，直晃得人眼花。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
太阳开始从西方的天空中慢慢沉落下去。宝阁的老板据说是帝国
中有势力的将军。这消息不知真假，不过店中的柜子中摆着各类
珠宝玉器金饰古董，映着灯光，直晃得人眼花。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚降临了，宝蓝色的天空中悄悄露出了滴滴晶莹的星点。宝阁
的老板据说是帝国中有势力的将军。这消息不知真假，不过店中
的柜子中摆着各类珠宝玉器金饰古董，映着灯光，直晃得人眼花。
LONG
        );
    }
    return 0;
  }
}
