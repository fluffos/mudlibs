// Room: /d/huanggon/shiweifang1
inherit ROOM;
int do_look(string arg);
void create()
{
  set ("short", "侍卫房");
  set ("long", @LONG
这间房间的木柱上绑着三条汉子，光着上身，已给打得血肉模糊，
一边的地上一只铁桶内浸了几条牛皮鞭子，一个碳盆内碳火还未
熄灭，里边是几根烙铁，显然不是烤火来着。
LONG);

  set("exits", ([ /* sizeof() == 1 */
  "west" : __DIR__"shiweifang",
]));
  setup();
  
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
夜的星空，璀璨夺目，风里的枯枝摇曳着星海无限灿烂的辉煌。
这间房间的木柱上绑着三条汉子，光着上身，已给打得血肉模糊，
一边的地上一只铁桶内浸了几条牛皮鞭子，一个碳盆内碳火还未
熄灭，里边是几根烙铁，显然不是烤火来着。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
东方泛起了鱼肚白，天空瓦蓝瓦蓝的。这间房间的木柱上绑着三
条汉子，光着上身，已给打得血肉模糊，一边的地上一只铁桶内
浸了几条牛皮鞭子，一个碳盆内碳火还未熄灭，里边是几根烙铁，
显然不是烤火来着。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
太阳挂在东方的蔚蓝的天空中散射着金色的光芒。这间房间的木
柱上绑着三条汉子，光着上身，已给打得血肉模糊，一边的地上
一只铁桶内浸了几条牛皮鞭子，一个碳盆内碳火还未熄灭，里边
是几根烙铁，显然不是烤火来着。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
太阳开始从西方的天空中慢慢沉落下去。这间房间的木柱上绑着
三条汉子，光着上身，已给打得血肉模糊，一边的地上一只铁桶
内浸了几条牛皮鞭子，一个碳盆内碳火还未熄灭，里边是几根烙
铁，显然不是烤火来着。
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，宝蓝色的天空中悄悄露出了滴滴晶莹的星点。这间
房间的木柱上绑着三条汉子，光着上身，已给打得血肉模糊，一
边的地上一只铁桶内浸了几条牛皮鞭子，一个碳盆内碳火还未熄
灭，里边是几根烙铁，显然不是烤火来着。
LONG
);
		}
		return 0;
	}
}


