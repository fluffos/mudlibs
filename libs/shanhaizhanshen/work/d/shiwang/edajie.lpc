// Room: /d/huanggon/edajie.c

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "东大街");
  set("long", @LONG
这是条东西向的街道，向西穿过狮王帝国广场。街道两边招牌林
立，吆喝声不断，在狮王狂狮的统治下治安很好，所以生意人挺
多。
LONG
  );
  set("no_clean_up", 0);
  set("outdoors", "shiwang");
  set("exits", ([ /* sizeof() == 3 */
    "south": __DIR__ "jiaoqiying",
    "west": __DIR__ "guangchang",
    "east": __DIR__ "edajie1",
  ]));

  setup();


}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
夜的星空，璀璨夺目，风里的枯枝摇曳着星海无限灿烂的辉煌。
这是条东西向的街道，向西穿过狮王帝国广场。街道两边招牌林
立，吆喝声不断，在狮王狂狮的统治下治安很好，所以生意人挺
多。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
东方泛起了鱼肚白，天空瓦蓝瓦蓝的。这是条东西向的街道，向
西穿过狮王帝国广场。街道两边招牌林立，吆喝声不断，在狮王
狂狮的统治下治安很好，所以生意人挺多。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
太阳挂在东方的蔚蓝的天空中散射着金色的光芒。这是条东西向
的街道，向西穿过狮王帝国广场。街道两边招牌林立，吆喝声不
断，在狮王狂狮的统治下治安很好，所以生意人挺多。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
太阳开始从西方的天空中慢慢沉落下去。这是条东西向的街道，
向西穿过狮王帝国广场。街道两边招牌林立，吆喝声不断，在狮
王狂狮的统治下治安很好，所以生意人挺多。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚降临了，宝蓝色的天空中悄悄露出了滴滴晶莹的星点。这是
条东西向的街道，向西穿过狮王帝国广场。街道两边招牌林立，
吆喝声不断，在狮王狂狮的统治下治安很好，所以生意人挺多。
LONG
        );
    }
    return 0;
  }
}
