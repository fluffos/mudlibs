// Room: shiwang/xiaogardon
inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "小花园");
  set("long", @LONG
王府中的小花园，院中是各色的牡丹，据说是因为牡丹富贵，所
以大将军特别喜欢，花木中杂有小巧的座椅，亭子，假山。美不
胜收，从此向西，是王府的天井。
LONG);

  set("exits", ([ /* sizeof() == 2 */
    "north": __DIR__ "xiaogardon1",
    "west": __DIR__ "tianjin",
  ]));
  set("outdoors", "shiwang");
  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
夜的星空，璀璨夺目，风里的枯枝摇曳着星海无限灿烂的辉煌。
王府中的小花园，院中是各色的牡丹，据说是因为牡丹富贵，所
以大将军特别喜欢，花木中杂有小巧的座椅，亭子，假山。美不
胜收，从此向西，是王府的天井。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
东方泛起了鱼肚白，天空瓦蓝瓦蓝的。王府中的小花园，院中是
各色的牡丹，据说是因为牡丹富贵，所以大将军特别喜欢，花木
中杂有小巧的座椅，亭子，假山。美不胜收，从此向西，是王府
的天井。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
太阳挂在东方的蔚蓝的天空中散射着金色的光芒。王府中的小花
园，院中是各色的牡丹，据说是因为牡丹富贵，所以大将军特别
喜欢，花木中杂有小巧的座椅，亭子，假山。美不胜收，从此向
西，是王府的天井。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
太阳开始从西方的天空中慢慢沉落下去。王府中的小花园，院中
是各色的牡丹，据说是因为牡丹富贵，所以大将军特别喜欢，花
木中杂有小巧的座椅，亭子，假山。美不胜收，从此向西，是王
府的天井。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚降临了，宝蓝色的天空中悄悄露出了滴滴晶莹的星点。王府
中的小花园，院中是各色的牡丹，据说是因为牡丹富贵，所以大
将军特别喜欢，花木中杂有小巧的座椅，亭子，假山。美不胜收，
从此向西，是王府的天井。
LONG
        );
    }
    return 0;
  }
}
