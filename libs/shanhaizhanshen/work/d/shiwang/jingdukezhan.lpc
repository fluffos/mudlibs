// Room: /d/huanggon/jingdukezhan.c

inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "帝国客栈");
	set("long", @LONG
门口的旗杆上高挂一串大红灯笼，宽阔的门楣上是黑底泥金的招
牌。客栈里面打扫得十分干净，给人宾至如归的感觉。北边是西
城街，南边再向里面去，就是卧室。
                       
              *
               **
                 **
                    *
                     *
                    **
                  ******
               ************
               *    *    *
                *   *   *
                  *****
LONG
	);set("objects", ([
		__DIR__"npc/bar" : 1,
                __DIR__"npc/xiaoer2" : 1,
	]));
	
	set("no_clean_up", 0);
	set("exits", ([ /* sizeof() == 2 */
  "north" : __DIR__"wchangan1",
  "south" : __DIR__"kezhanwoshi",
]));

	setup();
}
int valid_leave(object me, string dir)
{

	if ( !me->query_temp("rent_paid") && dir == "south" )
	return notify_fail("这位客人，您要付了钱才能进去啊！\n");
	return ::valid_leave(me, dir);
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
夜的星空，璀璨夺目，风里的枯枝摇曳着星海无限灿烂的辉煌。
门口的旗杆上高挂一串大红灯笼，宽阔的门楣上是黑底泥金的招
牌。客栈里面打扫得十分干净，给人宾至如归的感觉。北边是西
城街，南边再向里面去，就是卧室。
                       
              *
               **
                 **
                    *
                     *
                    **
                  ******
               ************
               *    *    *
                *   *   *
                  *****
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
东方泛起了鱼肚白，天空瓦蓝瓦蓝的。门口的旗杆上高挂一串大
红灯笼，宽阔的门楣上是黑底泥金的招牌。客栈里面打扫得十分
干净，给人宾至如归的感觉。北边是西城街，南边再向里面去，
就是卧室。
                       
              *
               **
                 **
                    *
                     *
                    **
                  ******
               ************
               *    *    *
                *   *   *
                  *****
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
太阳挂在东方的蔚蓝的天空中散射着金色的光芒。门口的旗杆上
高挂一串大红灯笼，宽阔的门楣上是黑底泥金的招牌。客栈里面
打扫得十分干净，给人宾至如归的感觉。北边是西城街，南边再
向里面去，就是卧室。
                       
              *
               **
                 **
                    *
                     *
                    **
                  ******
               ************
               *    *    *
                *   *   *
                  *****
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
太阳开始从西方的天空中慢慢沉落下去。门口的旗杆上高挂一串
大红灯笼，宽阔的门楣上是黑底泥金的招牌。客栈里面打扫得十
分干净，给人宾至如归的感觉。北边是西城街，南边再向里面去，
就是卧室。
                       
              *
               **
                 **
                    *
                     *
                    **
                  ******
               ************
               *    *    *
                *   *   *
                  *****
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，宝蓝色的天空中悄悄露出了滴滴晶莹的星点。门口
的旗杆上高挂一串大红灯笼，宽阔的门楣上是黑底泥金的招牌。
客栈里面打扫得十分干净，给人宾至如归的感觉。北边是西城街，
南边再向里面去，就是卧室。
                       
