// Room: /d/huanggon/shiwu。c

inherit ROOM;
#include <room.h>
int do_look(string arg);
void create()
{
	set("short", "石牢");
	set("long", @LONG
这间屋子座落于后花园的西面，通体由巨大厚实的花岗岩垒成，
正面是两扇大铁门，看来没七八个人推不开，一把大锁把铁门锁
死了。十多个卫士围绕着石屋巡逻，这是大将军府中关押重犯的
石牢。
LONG
	);
	
	set("exits", ([ /* sizeof() == 2 */
  "east" : __DIR__"hougardon",
  "north" : __DIR__"shilaozoulang",
]));
	set("outdoors", "/d/shenmin");
	set("no_clean_up", 0);
  create_door("north","石牢门");
	setup();
}


void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
夜的星空，璀璨夺目，风里的枯枝摇曳着星海无限灿烂的辉煌。
这间屋子座落于后花园的西面，通体由巨大厚实的花岗岩垒成，
正面是两扇大铁门，看来没七八个人推不开，一把大锁把铁门锁
死了。十多个卫士围绕着石屋巡逻，这是大将军府中关押重犯的
石牢。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
东方泛起了鱼肚白，天空瓦蓝瓦蓝的。这间屋子座落于后花园的
西面，通体由巨大厚实的花岗岩垒成，正面是两扇大铁门，看来
没七八个人推不开，一把大锁把铁门锁死了。十多个卫士围绕着
石屋巡逻，这是大将军府中关押重犯的石牢。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
太阳挂在东方的蔚蓝的天空中散射着金色的光芒。这间屋子座落
于后花园的西面，通体由巨大厚实的花岗岩垒成，正面是两扇大
铁门，看来没七八个人推不开，一把大锁把铁门锁死了。十多个
卫士围绕着石屋巡逻，这是大将军府中关押重犯的石牢。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
太阳开始从西方的天空中慢慢沉落下去。这间屋子座落于后花园
的西面，通体由巨大厚实的花岗岩垒成，正面是两扇大铁门，看
来没七八个人推不开，一把大锁把铁门锁死了。十多个卫士围绕
着石屋巡逻，这是大将军府中关押重犯的石牢。
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，宝蓝色的天空中悄悄露出了滴滴晶莹的星点。这间
屋子座落于后花园的西面，通体由巨大厚实的花岗岩垒成，正面
是两扇大铁门，看来没七八个人推不开，一把大锁把铁门锁死了。
十多个卫士围绕着石屋巡逻，这是大将军府中关押重犯的石牢。
LONG
);
		}
		return 0;
	}
}


