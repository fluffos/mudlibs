// Room: /d/huanggon/guangchang.c

inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "狮王帝国广场");
	set("long", @LONG
这是狮王帝国广场，地上铺着平实的麻石，垒得平整，北边狮王
门是进入皇城的大门，广场前一条东西向的街道，东是东大街，
西是西大街，南边不远就是天桥。
LONG
	);
	
	set("no_clean_up", 0);
	set("outdoors", "shiwang");
	set("exits", ([ /* sizeof() == 4 */
  "north" : __DIR__"tiananmen",
  "south" : __DIR__"sdajie",
  "east" : __DIR__"edajie",
  "west" : __DIR__"wdajie",
]));

	setup();
	
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
夜的星空，璀璨夺目，风里的枯枝摇曳着星海无限灿烂的辉煌。
这是狮王帝国广场，地上铺着平实的麻石，垒得平整，北边狮王
门是进入皇城的大门，广场前一条东西向的街道，东是东大街，
西是西大街，南边不远就是天桥。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
东方泛起了鱼肚白，天空瓦蓝瓦蓝的。这是狮王帝国广场，地上
铺着平实的麻石，垒得平整，北边狮王门是进入皇城的大门，广
场前一条东西向的街道，东是东大街，西是西大街，南边不远就
是天桥。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
太阳挂在东方的蔚蓝的天空中散射着金色的光芒。这是狮王帝国
广场，地上铺着平实的麻石，垒得平整，北边狮王门是进入皇城
的大门，广场前一条东西向的街道，东是东大街，西是西大街，
南边不远就是天桥。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
太阳开始从西方的天空中慢慢沉落下去。这是狮王帝国广场，地
上铺着平实的麻石，垒得平整，北边狮王门是进入皇城的大门，
广场前一条东西向的街道，东是东大街，西是西大街，南边不远
就是天桥。
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，宝蓝色的天空中悄悄露出了滴滴晶莹的星点。这是
狮王帝国广场，地上铺着平实的麻石，垒得平整，北边狮王门是
进入皇城的大门，广场前一条东西向的街道，东是东大街，西是
西大街，南边不远就是天桥。
LONG
);
		}
		return 0;
	}
}
