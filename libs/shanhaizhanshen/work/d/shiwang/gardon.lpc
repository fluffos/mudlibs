// Room: /d/huanggon/gardon.c

inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "王府花园");
	set("long", @LONG
在满眼的奇花异木中，一座小巧的凉亭在几株芭蕉间挑起，朱红
的栏杆间白玉石的桌椅特别抢眼。大将军喜欢在此饮酒赏花，再
让两个戏子在旁唱些小曲，是他最大的爱好。
LONG
	);
	
	set("exits", ([ /* sizeof() == 1 */
  "east" : __DIR__"tingyuan",
]));
	set("outdoors", "shiwang");
	set("no_clean_up", 0);

	setup();
	
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
夜的星空，璀璨夺目，风里的枯枝摇曳着星海无限灿烂的辉煌。
在满眼的奇花异木中，一座小巧的凉亭在几株芭蕉间挑起，朱红
的栏杆间白玉石的桌椅特别抢眼。大将军喜欢在此饮酒赏花，再
让两个戏子在旁唱些小曲，是他最大的爱好。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
东方泛起了鱼肚白，天空瓦蓝瓦蓝的。在满眼的奇花异木中，一
座小巧的凉亭在几株芭蕉间挑起，朱红的栏杆间白玉石的桌椅特
别抢眼。大将军喜欢在此饮酒赏花，再让两个戏子在旁唱些小曲，
是他最大的爱好。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
太阳挂在东方的蔚蓝的天空中散射着金色的光芒。在满眼的奇花
异木中，一座小巧的凉亭在几株芭蕉间挑起，朱红的栏杆间白玉
石的桌椅特别抢眼。大将军喜欢在此饮酒赏花，再让两个戏子在
旁唱些小曲，是他最大的爱好。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
太阳开始从西方的天空中慢慢沉落下去。在满眼的奇花异木中，
一座小巧的凉亭在几株芭蕉间挑起，朱红的栏杆间白玉石的桌椅
特别抢眼。大将军喜欢在此饮酒赏花，再让两个戏子在旁唱些小
曲，是他最大的爱好。
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，宝蓝色的天空中悄悄露出了滴滴晶莹的星点。在满
眼的奇花异木中，一座小巧的凉亭在几株芭蕉间挑起，朱红的栏
杆间白玉石的桌椅特别抢眼。大将军喜欢在此饮酒赏花，再让两
个戏子在旁唱些小曲，是他最大的爱好。
LONG
);
		}
		return 0;
	}
}
