// Room: /d/huanggon/sdajie1。c

inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "南大街");
	set("long", @LONG
这里是城中最热闹的地方，汇聚了四方艺人，也是各类小吃最多
的地方，此地向北是南大街，南边就是平定门。
LONG
	);
	
	set("no_clean_up", 0);
	set("outdoors", "/d/shenmin");
	set("exits", ([ /* sizeof() == 2 */
  "north" : __DIR__"sdajie",
  "south" : __DIR__"yongdingmen",
]));

	setup();
	
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
夜的星空，璀璨夺目，风里的枯枝摇曳着星海无限灿烂的辉煌。
这里是城中最热闹的地方，汇聚了四方艺人，也是各类小吃最多
的地方，此地向北是南大街，南边就是平定门。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
东方泛起了鱼肚白，天空瓦蓝瓦蓝的。这里是城中最热闹的地方，
汇聚了四方艺人，也是各类小吃最多的地方，此地向北是南大街，
南边就是平定门。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
太阳挂在东方的蔚蓝的天空中散射着金色的光芒。这里是城中最
热闹的地方，汇聚了四方艺人，也是各类小吃最多的地方，此地
向北是南大街，南边就是平定门。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
太阳开始从西方的天空中慢慢沉落下去。这里是城中最热闹的地
方，汇聚了四方艺人，也是各类小吃最多的地方，此地向北是南
大街，南边就是平定门。
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，宝蓝色的天空中悄悄露出了滴滴晶莹的星点。这里
是城中最热闹的地方，汇聚了四方艺人，也是各类小吃最多的地
方，此地向北是南大街，南边就是平定门。
LONG
);
		}
		return 0;
	}
}


