// Room: /d/huanggon/quanjude。c

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "狮神酒楼");
  set("long", @LONG
狮神神酒楼在方圆数百里之内可称得上无人不知，尤其是该店的
烤鹿乃是城中一绝，店铺装饰得简洁大方，几十只烤好的鹿还往
下滴着香油。东边就是闹市区。
                  
       (\_          _/)
       )  (        )  (
      (    (      )    )
       )_(\ \。--。/ /)_(
         `)` 6  6 '('
          /        \
         (  )    (  )
          `(_c__c_)`
             `--`
LONG
  );

  set("no_clean_up", 0);
  set("objects", ([
    __DIR__ "npc/xiaoer1": 1,
    __DIR__ "npc/wazhi": 1,


  ]));
  set("exits", ([ /* sizeof() == 1 */
    "west": __DIR__ "wangfujing",
  ]));

  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
