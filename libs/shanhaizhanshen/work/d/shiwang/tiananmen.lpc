// Room: /d/huanggon/tiananmen。c

inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "狮王门");
	set("long", @LONG
狮王门是皇城的正门，高高的城楼下是五道大门，每逢大典，就
有诏书摆在'狮亭'中，抬到此地，由礼部官员在城楼上大声宣告
庆典的消息，狮王门北面是午门，南边是片广场。
     |Zz。                      |Zz。
     |                         |
    _L__                      _|
   (____)      _             /__\
   /____\     /_\           /____\
  (______)    | |          (______)
   |  U |_____| |___________| U  |
   |u   | |  |   __   |  |  |   u|
   |    | |  |  ||||  |  |  |    |
   -------------""""--------------
LONG
	);
	
	set("exits", ([ /* sizeof() == 2 */
  "north" : __DIR__"wumen",
  "south" : __DIR__"guangchang",
]));
	set("outdoors", "shiwang");
	set("no_clean_up", 0);

	setup();
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
夜的星空，璀璨夺目，风里的枯枝摇曳着星海无限灿烂的辉煌。
狮王门是皇城的正门，高高的城楼下是五道大门，每逢大典，就
有诏书摆在'狮亭'中，抬到此地，由礼部官员在城楼上大声宣告
庆典的消息，狮王门北面是午门，南边是片广场。
