// Room: /d/huanggon/shilaonei。c

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "石牢内");
  set("long", @LONG
坚固的石牢，四边都是厚重的石头，南边墙上安装了铁窗，一扇
铁门关得紧紧的，墙脚铺了一层厚稻草，发出一股霉味。几只老
鼠惊慌得跑到墙角边躲了起来，空气很污浊。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "up": __DIR__ "shilaoxiaotang",
  ]));
  set("no_clean_up", 0);

  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
夜的星空，璀璨夺目，风里的枯枝摇曳着星海无限灿烂的辉煌。
坚固的石牢，四边都是厚重的石头，南边墙上安装了铁窗，一扇
铁门关得紧紧的，墙脚铺了一层厚稻草，发出一股霉味。几只老
鼠惊慌得跑到墙角边躲了起来，空气很污浊。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
东方泛起了鱼肚白，天空瓦蓝瓦蓝的。坚固的石牢，四边都是厚
重的石头，南边墙上安装了铁窗，一扇铁门关得紧紧的，墙脚铺
了一层厚稻草，发出一股霉味。几只老鼠惊慌得跑到墙角边躲了
起来，空气很污浊。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
太阳挂在东方的蔚蓝的天空中散射着金色的光芒。坚固的石牢，
四边都是厚重的石头，南边墙上安装了铁窗，一扇铁门关得紧紧
的，墙脚铺了一层厚稻草，发出一股霉味。几只老鼠惊慌得跑到
墙角边躲了起来，空气很污浊。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
太阳开始从西方的天空中慢慢沉落下去。坚固的石牢，四边都是
厚重的石头，南边墙上安装了铁窗，一扇铁门关得紧紧的，墙脚
铺了一层厚稻草，发出一股霉味。几只老鼠惊慌得跑到墙角边躲
了起来，空气很污浊。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚降临了，宝蓝色的天空中悄悄露出了滴滴晶莹的星点。坚固
的石牢，四边都是厚重的石头，南边墙上安装了铁窗，一扇铁门
关得紧紧的，墙脚铺了一层厚稻草，发出一股霉味。几只老鼠惊
慌得跑到墙角边躲了起来，空气很污浊。
LONG
        );
    }
    return 0;
  }
}
