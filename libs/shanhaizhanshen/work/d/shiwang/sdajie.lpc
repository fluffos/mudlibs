// Room: /d/huanggon/sdajie。c

inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "南大街");
	set("long", @LONG
这是条南北方向的街道，道路两边是各类的店铺，各类东西都比
较齐全，此地向北是片开阔的广场，南边很多人聚齐在一起，看
上去很热闹。
LONG
	);
	set("no_clean_up", 0);
	set("outdoors", "/d/shenmin");
	set("exits", ([ /* sizeof() == 3 */
  "west" : __DIR__"miaofa",
  "south" : __DIR__"sdajie1",
  "north" : __DIR__"guangchang",
]));

	setup();
	
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
夜的星空，璀璨夺目，风里的枯枝摇曳着星海无限灿烂的辉煌。
这是条南北方向的街道，道路两边是各类的店铺，各类东西都比
较齐全，此地向北是片开阔的广场，南边很多人聚齐在一起，看
上去很热闹。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
东方泛起了鱼肚白，天空瓦蓝瓦蓝的。这是条南北方向的街道，
道路两边是各类的店铺，各类东西都比较齐全，此地向北是片开
阔的广场，南边很多人聚齐在一起，看上去很热闹。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
太阳挂在东方的蔚蓝的天空中散射着金色的光芒。这是条南北方
向的街道，道路两边是各类的店铺，各类东西都比较齐全，此地
向北是片开阔的广场，南边很多人聚齐在一起，看上去很热闹。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
太阳开始从西方的天空中慢慢沉落下去。这是条南北方向的街道，
道路两边是各类的店铺，各类东西都比较齐全，此地向北是片开
阔的广场，南边很多人聚齐在一起，看上去很热闹。
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，宝蓝色的天空中悄悄露出了滴滴晶莹的星点。这是
条南北方向的街道，道路两边是各类的店铺，各类东西都比较齐
全，此地向北是片开阔的广场，南边很多人聚齐在一起，看上去
很热闹。
LONG
);
		}
		return 0;
	}
}


