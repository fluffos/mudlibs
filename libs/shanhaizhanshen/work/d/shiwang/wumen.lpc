// Room: shiwang/wumen
inherit ROOM;
int do_look(string arg);
void create()
{
  set ("short", "午门");
  set ("long", @LONG
午门是狮王城的入口，高37。95米，门楼高耸，城楼内置钟鼓。
两翼突出，两翼和边角有四座方亭守望。
LONG);

  set("exits", ([ /* sizeof() == 2 */
  "south" : __DIR__"tiananmen",
  "north" : __DIR__"taihedian",
]));
  set("outdoors", "shiwang");
  setup();
}


void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
夜的星空，璀璨夺目，风里的枯枝摇曳着星海无限灿烂的辉煌。
午门是狮王城的入口，高37。95米，门楼高耸，城楼内置钟鼓。
两翼突出，两翼和边角有四座方亭守望。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
东方泛起了鱼肚白，天空瓦蓝瓦蓝的。午门是狮王城的入口，高
37。95米，门楼高耸，城楼内置钟鼓。两翼突出，两翼和边角有
四座方亭守望。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
太阳挂在东方的蔚蓝的天空中散射着金色的光芒。午门是狮王城
的入口，高37。95米，门楼高耸，城楼内置钟鼓。两翼突出，两
翼和边角有四座方亭守望。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
太阳开始从西方的天空中慢慢沉落下去。午门是狮王城的入口，
高37。95米，门楼高耸，城楼内置钟鼓。两翼突出，两翼和边角
有四座方亭守望。
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，宝蓝色的天空中悄悄露出了滴滴晶莹的星点。午门
是狮王城的入口，高37。95米，门楼高耸，城楼内置钟鼓。两翼
突出，两翼和边角有四座方亭守望。
LONG
);
		}
		return 0;
	}
}


