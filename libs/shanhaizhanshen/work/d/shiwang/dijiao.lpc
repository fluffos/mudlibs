// Room: /d/huanggon/dijiao.c

inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "药铺地窖");
	set("long", @LONG
走下十多级台阶，推开一扇板门，这是个十来尺见方的小室，室
中是张矮榻。上面还残留着血迹。一盏煤油灯发出昏黄的灯光，
把上面的室顶熏黑了老大一块。
LONG
	);
	set("objects", ([ /* sizeof() == 1 */
 
]));
	set("no_clean_up", 0);
	set("exits", ([ /* sizeof() == 1 */
  "out" : __DIR__"neishi1",
]));

	setup();
	
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
夜的星空，璀璨夺目，风里的枯枝摇曳着星海无限灿烂的辉煌。
走下十多级台阶，推开一扇板门，这是个十来尺见方的小室，室
中是张矮榻。上面还残留着血迹。一盏煤油灯发出昏黄的灯光，
把上面的室顶熏黑了老大一块。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
东方泛起了鱼肚白，天空瓦蓝瓦蓝的。走下十多级台阶，推开一
扇板门，这是个十来尺见方的小室，室中是张矮榻。上面还残留
着血迹。一盏煤油灯发出昏黄的灯光，把上面的室顶熏黑了老大
一块。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
太阳挂在东方的蔚蓝的天空中散射着金色的光芒。走下十多级台
阶，推开一扇板门，这是个十来尺见方的小室，室中是张矮榻。
上面还残留着血迹。一盏煤油灯发出昏黄的灯光，把上面的室顶
熏黑了老大一块。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
太阳开始从西方的天空中慢慢沉落下去。走下十多级台阶，推开
一扇板门，这是个十来尺见方的小室，室中是张矮榻。上面还残
留着血迹。一盏煤油灯发出昏黄的灯光，把上面的室顶熏黑了老
大一块。
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，宝蓝色的天空中悄悄露出了滴滴晶莹的星点。走下
十多级台阶，推开一扇板门，这是个十来尺见方的小室，室中是
张矮榻。上面还残留着血迹。一盏煤油灯发出昏黄的灯光，把上
面的室顶熏黑了老大一块。
LONG
);
		}
		return 0;
	}
}
