// Room: /d/huanggon/wchangan
inherit ROOM;
int do_look(string arg);
void create()
{
  set ("short", "西城街");
  set ("long", @LONG
西城街是条东西走向的街道，因为正当城中，两边店铺很多，招
牌林立，游人不绝，向东去就是西城，西面可出西铁门。
LONG);

  set("outdoors", "shiwang");
  set("exits", ([ /* sizeof() == 3 */
  "north" : __DIR__"kangwangfu",
  "west" : __DIR__"wchangan1",
  "east" : __DIR__"xidan2",
]));
  setup();
  
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
夜的星空，璀璨夺目，风里的枯枝摇曳着星海无限灿烂的辉煌。
西城街是条东西走向的街道，因为正当城中，两边店铺很多，招
牌林立，游人不绝，向东去就是西城，西面可出西铁门。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
东方泛起了鱼肚白，天空瓦蓝瓦蓝的。西城街是条东西走向的街
道，因为正当城中，两边店铺很多，招牌林立，游人不绝，向东
去就是西城，西面可出西铁门。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
太阳挂在东方的蔚蓝的天空中散射着金色的光芒。西城街是条东
西走向的街道，因为正当城中，两边店铺很多，招牌林立，游人
不绝，向东去就是西城，西面可出西铁门。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
太阳开始从西方的天空中慢慢沉落下去。西城街是条东西走向的
街道，因为正当城中，两边店铺很多，招牌林立，游人不绝，向
东去就是西城，西面可出西铁门。
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，宝蓝色的天空中悄悄露出了滴滴晶莹的星点。西城
街是条东西走向的街道，因为正当城中，两边店铺很多，招牌林
立，游人不绝，向东去就是西城，西面可出西铁门。
LONG
);
		}
		return 0;
	}
}


