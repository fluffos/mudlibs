// Room: /d/huanggon/shilaozoulang。c

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "石牢走廊");
  set("long", @LONG
石屋内甚是阴暗，一条走廊通向北边的一座小堂，走廊之侧搭了
一座行灶，一名老汉正在煮饭，从北边小堂中传来铁链叮当作响
的声音。
LONG
  );


  set("no_clean_up", 0);
  set("exits", ([ /* sizeof() == 2 */
    "north": __DIR__ "shilaoxiaotang",
    "south": __DIR__ "shiwu",
  ]));

  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
夜的星空，璀璨夺目，风里的枯枝摇曳着星海无限灿烂的辉煌。
石屋内甚是阴暗，一条走廊通向北边的一座小堂，走廊之侧搭了
一座行灶，一名老汉正在煮饭，从北边小堂中传来铁链叮当作响
的声音。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
东方泛起了鱼肚白，天空瓦蓝瓦蓝的。石屋内甚是阴暗，一条走
廊通向北边的一座小堂，走廊之侧搭了一座行灶，一名老汉正在
煮饭，从北边小堂中传来铁链叮当作响的声音。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
太阳挂在东方的蔚蓝的天空中散射着金色的光芒。石屋内甚是阴
暗，一条走廊通向北边的一座小堂，走廊之侧搭了一座行灶，一
名老汉正在煮饭，从北边小堂中传来铁链叮当作响的声音。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
太阳开始从西方的天空中慢慢沉落下去。石屋内甚是阴暗，一条
走廊通向北边的一座小堂，走廊之侧搭了一座行灶，一名老汉正
在煮饭，从北边小堂中传来铁链叮当作响的声音。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚降临了，宝蓝色的天空中悄悄露出了滴滴晶莹的星点。石屋
内甚是阴暗，一条走廊通向北边的一座小堂，走廊之侧搭了一座
行灶，一名老汉正在煮饭，从北边小堂中传来铁链叮当作响的声
音。
LONG
        );
    }
    return 0;
  }
}
