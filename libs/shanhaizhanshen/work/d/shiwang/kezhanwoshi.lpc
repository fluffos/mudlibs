// Room: shiwang/kezhanwoshi
inherit ROOM;
int do_look(string arg);
void create()
{
  set ("short", "客栈卧室");
  set ("long", @LONG
这是帝国客栈内的一间普通卧室，由于人多，房间不够，你只能
和别人挤一下了。房间中只一张床铺，一张木桌，一张矮凳。墙
角落中堆了些鸡毛稻草，如果你觉得冷，可以盖这些东西。
                
          ()___
        ()//__/)_________________()
        ||(___)//#/_/#/_/#/_/#()/||
        ||----|#| |#|_|#|_|#|_|| ||
        ||____|_|#|_|#|_|#|_|#||/||
        ||    |#|_|#|_|#|_|#|_||
LONG);

set("sleep_room",1);
set("hotel",1);
  set("exits", ([ /* sizeof() == 1 */
  "north" : __DIR__"jingdukezhan",
]));
  setup();
  
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
夜的星空，璀璨夺目，风里的枯枝摇曳着星海无限灿烂的辉煌。
这是帝国客栈内的一间普通卧室，由于人多，房间不够，你只能
和别人挤一下了。房间中只一张床铺，一张木桌，一张矮凳。墙
角落中堆了些鸡毛稻草，如果你觉得冷，可以盖这些东西。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
东方泛起了鱼肚白，天空瓦蓝瓦蓝的。这是帝国客栈内的一间普
通卧室，由于人多，房间不够，你只能和别人挤一下了。房间中
只一张床铺，一张木桌，一张矮凳。墙角落中堆了些鸡毛稻草，
如果你觉得冷，可以盖这些东西。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
太阳挂在东方的蔚蓝的天空中散射着金色的光芒。这是帝国客栈
内的一间普通卧室，由于人多，房间不够，你只能和别人挤一下
了。房间中只一张床铺，一张木桌，一张矮凳。墙角落中堆了些
鸡毛稻草，如果你觉得冷，可以盖这些东西。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
太阳开始从西方的天空中慢慢沉落下去。这是帝国客栈内的一间
普通卧室，由于人多，房间不够，你只能和别人挤一下了。房间
中只一张床铺，一张木桌，一张矮凳。墙角落中堆了些鸡毛稻草，
如果你觉得冷，可以盖这些东西。
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，宝蓝色的天空中悄悄露出了滴滴晶莹的星点。这是
帝国客栈内的一间普通卧室，由于人多，房间不够，你只能和别
人挤一下了。房间中只一张床铺，一张木桌，一张矮凳。墙角落
中堆了些鸡毛稻草，如果你觉得冷，可以盖这些东西。
LONG
);
		}
		return 0;
	}
}


