// Room: /d/huanggon/qianfengyin。c

inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "前锋营");
	set("long", @LONG
前锋营是狮王帝国三大军之一，统领绿发狮，治军极严，可是由
于他惧内又要养小老婆，给骄骑营统领那住了把柄，所以声望不
高。营中军士往来巡逻北边是西大街。             

     ("`-/")_。-'"``-。_
      。 。 `; -。_    )-;-，_`)
     (v_，)'  _  )`-。\  ``-'
    _。- _。。-_/ / ((。'
  ((，。-'   ((，/    
LONG
	);
	
	set("no_clean_up", 0);
	set("objects", ([
		__DIR__"npc/qianfeng" : 1,
                __DIR__"npc/qfb2" : 1, 
                __DIR__"npc/qfb1" : 1,
	]));
	set("exits", ([ /* sizeof() == 1 */
  "north" : __DIR__"wdajie",
]));
	set("outdoors", "/d/shenmin");

	setup();
	
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
夜的星空，璀璨夺目，风里的枯枝摇曳着星海无限灿烂的辉煌。
前锋营是狮王帝国三大军之一，统领绿发狮，治军极严，可是由
于他惧内又要养小老婆，给骄骑营统领那住了把柄，所以声望不
高。营中军士往来巡逻北边是西大街。 

     ("`-/")_。-'"``-。_
      。 。 `; -。_    )-;-，_`)
     (v_，)'  _  )`-。\  ``-'
    _。- _。。-_/ / ((。'
  ((，。-'   ((，/                
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
东方泛起了鱼肚白，天空瓦蓝瓦蓝的。前锋营是狮王帝国三大军
之一，统领绿发狮，治军极严，可是由于他惧内又要养小老婆，
给骄骑营统领那住了把柄，所以声望不高。营中军士往来巡逻北
边是西大街。 

     ("`-/")_。-'"``-。_
      。 。 `; -。_    )-;-，_`)
     (v_，)'  _  )`-。\  ``-'
    _。- _。。-_/ / ((。'
  ((，。-'   ((，/                
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
太阳挂在东方的蔚蓝的天空中散射着金色的光芒。前锋营是狮王
帝国三大军之一，统领绿发狮，治军极严，可是由于他惧内又要
养小老婆，给骄骑营统领那住了把柄，所以声望不高。营中军士
往来巡逻北边是西大街。  

     ("`-/")_。-'"``-。_
      。 。 `; -。_    )-;-，_`)
     (v_，)'  _  )`-。\  ``-'
    _。- _。。-_/ / ((。'
  ((，。-'   ((，/               
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
太阳开始从西方的天空中慢慢沉落下去。前锋营是狮王帝国三大
军之一，统领绿发狮，治军极严，可是由于他惧内又要养小老婆，
给骄骑营统领那住了把柄，所以声望不高。营中军士往来巡逻北
边是西大街。

     ("`-/")_。-'"``-。_
      。 。 `; -。_    )-;-，_`)
     (v_，)'  _  )`-。\  ``-'
    _。- _。。-_/ / ((。'
  ((，。-'   ((，/                 
