// Room: /d/huanggon/wangfujing1
inherit ROOM;
int do_look(string arg);
void create()
{
  set ("short", "闹市区");
  set ("long", @LONG
闹市区的店铺在京城最多，也是生意人最多的地方，各地的商贩
都把货物弄到此地交易，街道两边的招牌一个接一个，排得密密
麻麻的。东面是条东西向的街道，就是东安街。
LONG);

  set("exits", ([ /* sizeof() == 3 */
  "east" : __DIR__"echangan",
  "north" : __DIR__"wangfujing2",
  "south" : __DIR__"wangfujing",
]));
  set("outdoors", "shiwang");
  setup();
 
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
夜的星空，璀璨夺目，风里的枯枝摇曳着星海无限灿烂的辉煌。
闹市区的店铺在京城最多，也是生意人最多的地方，各地的商贩
都把货物弄到此地交易，街道两边的招牌一个接一个，排得密密
麻麻的。东面是条东西向的街道，就是东安街。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
东方泛起了鱼肚白，天空瓦蓝瓦蓝的。闹市区的店铺在京城最多，
也是生意人最多的地方，各地的商贩都把货物弄到此地交易，街
道两边的招牌一个接一个，排得密密麻麻的。东面是条东西向的
街道，就是东安街。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
太阳挂在东方的蔚蓝的天空中散射着金色的光芒。闹市区的店铺
在京城最多，也是生意人最多的地方，各地的商贩都把货物弄到
此地交易，街道两边的招牌一个接一个，排得密密麻麻的。东面
是条东西向的街道，就是东安街。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
太阳开始从西方的天空中慢慢沉落下去。闹市区的店铺在京城最
多，也是生意人最多的地方，各地的商贩都把货物弄到此地交易，
街道两边的招牌一个接一个，排得密密麻麻的。东面是条东西向
的街道，就是东安街。
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，宝蓝色的天空中悄悄露出了滴滴晶莹的星点。闹市
区的店铺在京城最多，也是生意人最多的地方，各地的商贩都把
货物弄到此地交易，街道两边的招牌一个接一个，排得密密麻麻
的。东面是条东西向的街道，就是东安街。
LONG
);
		}
		return 0;
	}
}


