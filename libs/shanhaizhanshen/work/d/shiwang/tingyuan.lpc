// Room: /d/huanggon/tingyuan。c

inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "王府庭院");
	set("long", @LONG
宽阔的庭院，一条直道通向北面的大厅，两边是花木葱郁的花园，
来往的丫鬟仆妇匆匆而过。南边就是大门，平常时候只开角门，
中门紧闭。从庭院深处传来一些呼喊声。
LONG
	);
	set("no_clean_up", 0);
	set("outdoors", "/d/huanggon");
	set("exits", ([ /* sizeof() == 4 */
  "east" : __DIR__"majiu",
  "south" : __DIR__"kangwangfu",
  "north" : __DIR__"kangdating",
  "west" : __DIR__"gardon",
]));

	setup();
	
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
夜的星空，璀璨夺目，风里的枯枝摇曳着星海无限灿烂的辉煌。
宽阔的庭院，一条直道通向北面的大厅，两边是花木葱郁的花园，
来往的丫鬟仆妇匆匆而过。南边就是大门，平常时候只开角门，
中门紧闭。从庭院深处传来一些呼喊声。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
东方泛起了鱼肚白，天空瓦蓝瓦蓝的。宽阔的庭院，一条直道通
向北面的大厅，两边是花木葱郁的花园，来往的丫鬟仆妇匆匆而
过。南边就是大门，平常时候只开角门，中门紧闭。从庭院深处
传来一些呼喊声。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
太阳挂在东方的蔚蓝的天空中散射着金色的光芒。宽阔的庭院，
一条直道通向北面的大厅，两边是花木葱郁的花园，来往的丫鬟
仆妇匆匆而过。南边就是大门，平常时候只开角门，中门紧闭。
从庭院深处传来一些呼喊声。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
太阳开始从西方的天空中慢慢沉落下去。宽阔的庭院，一条直道
通向北面的大厅，两边是花木葱郁的花园，来往的丫鬟仆妇匆匆
而过。南边就是大门，平常时候只开角门，中门紧闭。从庭院深
处传来一些呼喊声。
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，宝蓝色的天空中悄悄露出了滴滴晶莹的星点。宽阔
的庭院，一条直道通向北面的大厅，两边是花木葱郁的花园，来
往的丫鬟仆妇匆匆而过。南边就是大门，平常时候只开角门，中
门紧闭。从庭院深处传来一些呼喊声。
LONG
);
		}
		return 0;
	}
}


