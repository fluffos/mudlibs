// Room: /d/huanggon/kangdating.c

inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "王府大厅");
	set("long", @LONG
王府大厅是大将军平时接见下属的地方，大厅中八根朱红的柱子
撑起屋顶，柱子间是白纱宫灯，一排贝雕屏风挡住后堂入口，几
张桌椅按主客位分别摆放。
LONG
	);
	
	set("no_clean_up", 0);
	set("exits", ([ /* sizeof() == 2 */
  "south" : __DIR__"tingyuan",
  "north" : __DIR__"tianjin",
]));

	setup();
	
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
夜的星空，璀璨夺目，风里的枯枝摇曳着星海无限灿烂的辉煌。
王府大厅是大将军平时接见下属的地方，大厅中八根朱红的柱子
撑起屋顶，柱子间是白纱宫灯，一排贝雕屏风挡住后堂入口，几
张桌椅按主客位分别摆放。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
东方泛起了鱼肚白，天空瓦蓝瓦蓝的。王府大厅是大将军平时接
见下属的地方，大厅中八根朱红的柱子撑起屋顶，柱子间是白纱
宫灯，一排贝雕屏风挡住后堂入口，几张桌椅按主客位分别摆放。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
太阳挂在东方的蔚蓝的天空中散射着金色的光芒。王府大厅是大
将军平时接见下属的地方，大厅中八根朱红的柱子撑起屋顶，柱
子间是白纱宫灯，一排贝雕屏风挡住后堂入口，几张桌椅按主客
位分别摆放。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
太阳开始从西方的天空中慢慢沉落下去。王府大厅是大将军平时
接见下属的地方，大厅中八根朱红的柱子撑起屋顶，柱子间是白
纱宫灯，一排贝雕屏风挡住后堂入口，几张桌椅按主客位分别摆
放。
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，宝蓝色的天空中悄悄露出了滴滴晶莹的星点。王府
大厅是大将军平时接见下属的地方，大厅中八根朱红的柱子撑起
屋顶，柱子间是白纱宫灯，一排贝雕屏风挡住后堂入口，几张桌
椅按主客位分别摆放。
LONG
);
		}
		return 0;
	}
}
