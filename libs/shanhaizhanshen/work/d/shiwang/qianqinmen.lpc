// Room: /d/huanggon/qianqinmen。c

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "狂狮门");
  set("long", @LONG
这是片东西横长的广场，东西北三面各有门，北面跨上雕龙台阶
就是狂狮门，朱红的大门两边敞开。进了此门就是内廷。北边是
大殿，南边经过数十级台阶，乃是狮殿，西面通向御膳房。
LONG
  );
  set("no_clean_up", 0);
  set("outdoors", "shiwang");
  set("exits", ([ /* sizeof() == 4 */
    "south": __DIR__ "baohedian",
    "north": __DIR__ "qianqingon",
  ]));

  setup();
}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
夜的星空，璀璨夺目，风里的枯枝摇曳着星海无限灿烂的辉煌。
这是片东西横长的广场，东西北三面各有门，北面跨上雕龙台阶
就是狂狮门，朱红的大门两边敞开。进了此门就是内廷。北边是
大殿，南边经过数十级台阶，乃是狮殿，西面通向御膳房。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
东方泛起了鱼肚白，天空瓦蓝瓦蓝的。这是片东西横长的广场，
东西北三面各有门，北面跨上雕龙台阶就是狂狮门，朱红的大门
两边敞开。进了此门就是内廷。北边是大殿，南边经过数十级台
阶，乃是狮殿，西面通向御膳房。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
太阳挂在东方的蔚蓝的天空中散射着金色的光芒。这是片东西横
长的广场，东西北三面各有门，北面跨上雕龙台阶就是狂狮门，
朱红的大门两边敞开。进了此门就是内廷。北边是大殿，南边经
过数十级台阶，乃是狮殿，西面通向御膳房。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
太阳开始从西方的天空中慢慢沉落下去。这是片东西横长的广场，
东西北三面各有门，北面跨上雕龙台阶就是狂狮门，朱红的大门
两边敞开。进了此门就是内廷。北边是大殿，南边经过数十级台
阶，乃是狮殿，西面通向御膳房。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚降临了，宝蓝色的天空中悄悄露出了滴滴晶莹的星点。这是
片东西横长的广场，东西北三面各有门，北面跨上雕龙台阶就是
狂狮门，朱红的大门两边敞开。进了此门就是内廷。北边是大殿，
南边经过数十级台阶，乃是狮殿，西面通向御膳房。
LONG
        );
    }
    return 0;
  }
}
