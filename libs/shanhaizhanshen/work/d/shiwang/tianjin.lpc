// Room: /d/huanggon/tianjin。c

inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "王府天井");
	set("long", @LONG
说是天井，其实是个大院子，空空的场地铺上白色石板，一边是
口水井，城中的富贵人家少不了这样的空场，南边是大厅，北边
是内厅。
LONG
	);
	set("no_clean_up", 0);
	set("outdoors", "shiwang");
	set("exits", ([ /* sizeof() == 3 */
  "east" : __DIR__"xiaogardon",
  "south" : __DIR__"kangdating",
  "north" : __DIR__"kangneiting",
]));

	setup();
	
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
夜的星空，璀璨夺目，风里的枯枝摇曳着星海无限灿烂的辉煌。
说是天井，其实是个大院子，空空的场地铺上白色石板，一边是
口水井，城中的富贵人家少不了这样的空场，南边是大厅，北边
是内厅。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
东方泛起了鱼肚白，天空瓦蓝瓦蓝的。说是天井，其实是个大院
子，空空的场地铺上白色石板，一边是口水井，城中的富贵人家
少不了这样的空场，南边是大厅，北边是内厅。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
太阳挂在东方的蔚蓝的天空中散射着金色的光芒。说是天井，其
实是个大院子，空空的场地铺上白色石板，一边是口水井，城中
的富贵人家少不了这样的空场，南边是大厅，北边是内厅。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
太阳开始从西方的天空中慢慢沉落下去。说是天井，其实是个大
院子，空空的场地铺上白色石板，一边是口水井，城中的富贵人
家少不了这样的空场，南边是大厅，北边是内厅。
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，宝蓝色的天空中悄悄露出了滴滴晶莹的星点。说是
天井，其实是个大院子，空空的场地铺上白色石板，一边是口水
井，城中的富贵人家少不了这样的空场，南边是大厅，北边是内
厅。
LONG
);
		}
		return 0;
	}
}


