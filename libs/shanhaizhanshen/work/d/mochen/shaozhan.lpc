inherit ROOM;
int do_look(string arg);
void create ()
{
        set ("short", "哨站");
        set ("long", @LONG
在这山势稍微平缓的小平台上，有一座不大的木屋，屋上猎猎飘
扬的正是兽之城的“兽之旗”。你正感叹这美妙山景时，一队兽
之城守卫走了过来，看来是正在巡逻布防，似乎发生了什么大事。
从这里向东北便是第六峰了，南面则是一个山谷。
      

        , .    .--.
        _|__  |_兽_|
       /    \ |_之_|
     /   []   |_旗_|
    |__________|  |                          
    |   ____   |  |        _
    |  |\  /|  |  |      _[_]_
    |  | \/ |  |  |       c")
    |  | /\ |  |  |      ,(_)'
    |__|/__\|__|__|       -"-
LONG);
        
        set("outdoors", "mochen");
set("objects", ([
                __DIR__"npc/showei3" : 1,
        ]));
       

        set("exits", ([
                "northeast" : __DIR__"diliufeng",
                "southdown" : __DIR__"shangu1",
        ]));
        setup();
        
}

void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
深夜，夜幕低垂，满天繁星映衬着宁静的大地。在这山势稍微平
缓的小平台上，有一座不大的木屋，屋上猎猎飘扬的正是兽之城
的“兽之旗”。你正感叹这美妙山景时，一队兽之城守卫走了过
来，看来是正在巡逻布防，似乎发生了什么大事。从这里向东北
便是第六峰了，南面则是一个山谷。
      

        , .    .--.
        _|__  |_兽_|
       /    \ |_之_|
     /   []   |_旗_|
    |__________|  |                          
    |   ____   |  |        _
    |  |\  /|  |  |      _[_]_
    |  | \/ |  |  |       c")
    |  | /\ |  |  |      ,(_)'
    |__|/__\|__|__|       -"-
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
东方的地平线上渐渐有了黎明的颜色。在这山势稍微平缓的小平
台上，有一座不大的木屋，屋上猎猎飘扬的正是兽之城的“兽之
旗”。你正感叹这美妙山景时，一队兽之城守卫走了过来，看来
是正在巡逻布防，似乎发生了什么大事。从这里向东北便是第六
峰了，南面则是一个山谷。
      

