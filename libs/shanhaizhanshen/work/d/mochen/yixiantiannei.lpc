inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "一线天内");
  set("long", @LONG
“一线天”果然名不虚传，从这里向上看两旁高耸的峭壁间只露
出一条白线，两旁的峭壁上长满了老山藤，乍一看就象是几条大
蛇缠在树上。一阵风吹过，四周发出了奇怪的声音，你感到背上
有些寒意。还是快点走吧。
LONG);

  set("outdoors", "mochen");


  set("exits", ([
    "northup": __DIR__ "yixiantian",
    "southdown": __DIR__ "yixiantiannei2",
  ]));
  set("no_clean_up", 0);
  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
深夜，夜幕低垂，满天繁星映衬着宁静的大地。“一线天”果然
名不虚传，从这里向上看两旁高耸的峭壁间只露出一条白线，两
旁的峭壁上长满了老山藤，乍一看就象是几条大蛇缠在树上。一
阵风吹过，四周发出了奇怪的声音，你感到背上有些寒意。还是
快点走吧。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
东方的地平线上渐渐有了黎明的颜色。“一线天”果然名不虚传，
从这里向上看两旁高耸的峭壁间只露出一条白线，两旁的峭壁上
长满了老山藤，乍一看就象是几条大蛇缠在树上。一阵风吹过，
四周发出了奇怪的声音，你感到背上有些寒意。还是快点走吧。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
太阳高挂在你的头顶正上方。“一线天”果然名不虚传，从这里
向上看两旁高耸的峭壁间只露出一条白线，两旁的峭壁上长满了
老山藤，乍一看就象是几条大蛇缠在树上。一阵风吹过，四周发
出了奇怪的声音，你感到背上有些寒意。还是快点走吧。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
太阳孤独地向西方的天空中慢慢沉落。“一线天”果然名不虚传，
从这里向上看两旁高耸的峭壁间只露出一条白线，两旁的峭壁上
长满了老山藤，乍一看就象是几条大蛇缠在树上。一阵风吹过，
四周发出了奇怪的声音，你感到背上有些寒意。还是快点走吧。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚降临了，如洗的天空露出几点星星。“一线天”果然名不虚
传，从这里向上看两旁高耸的峭壁间只露出一条白线，两旁的峭
壁上长满了老山藤，乍一看就象是几条大蛇缠在树上。一阵风吹
过，四周发出了奇怪的声音，你感到背上有些寒意。还是快点走吧。
LONG
        );
    }
    return 0;
  }
}
