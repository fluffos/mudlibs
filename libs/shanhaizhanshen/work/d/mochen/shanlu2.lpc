inherit ROOM;
int do_look(string arg);
void create ()
{
        set ("short", "山路");
        set ("long", @LONG
脚下虽然是塌实的青石路，可是由于常年的雾水弥漫，青石路反
而觉得有点滑，这里已经是半山腰了，你感到越来越冷。从这里
再向东攀上去就是著名的“人止关”了。这里可以看见一些兽之
城居民从上面下来，你无意之间向下望了望，只觉得有些头昏,不
过还是看到了几座小房。
LONG);
        set("area","兽之城");
        set("outdoors", "mochen");

        

        set("exits", ([
                "westdown" : __DIR__"shanjianxiaowu",
                "eastup" : __DIR__"renzhiguan",
        ]));
        setup();
        
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
深夜，夜幕低垂，满天繁星映衬着宁静的大地。脚下虽然是塌实
的青石路，可是由于常年的雾水弥漫，青石路反而觉得有点滑，
这里已经是半山腰了，你感到越来越冷。从这里再向东攀上去就
是著名的“人止关”了。这里可以看见一些兽之城居民从上面下
来，你无意之间向下望了望，只觉得有些头昏,不过还是看到了几
座小房。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
东方的地平线上渐渐有了黎明的颜色。脚下虽然是塌实的青石路，
可是由于常年的雾水弥漫，青石路反而觉得有点滑，这里已经是
半山腰了，你感到越来越冷。从这里再向东攀上去就是著名的“
人止关”了。这里可以看见一些兽之城居民从上面下来，你无意
之间向下望了望，只觉得有些头昏,不过还是看到了几座小房。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
太阳高挂在你的头顶正上方。脚下虽然是塌实的青石路，可是由
于常年的雾水弥漫，青石路反而觉得有点滑，这里已经是半山腰
了，你感到越来越冷。从这里再向东攀上去就是著名的“人止关
”了。这里可以看见一些兽之城居民从上面下来，你无意之间向
下望了望，只觉得有些头昏,不过还是看到了几座小房。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
太阳孤独地向西方的天空中慢慢沉落。脚下虽然是塌实的青石路，
可是由于常年的雾水弥漫，青石路反而觉得有点滑，这里已经是
半山腰了，你感到越来越冷。从这里再向东攀上去就是著名的“
人止关”了。这里可以看见一些兽之城居民从上面下来，你无意
之间向下望了望，只觉得有些头昏,不过还是看到了几座小房。
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，如洗的天空露出几点星星。脚下虽然是塌实的青石
路，可是由于常年的雾水弥漫，青石路反而觉得有点滑，这里已
经是半山腰了，你感到越来越冷。从这里再向东攀上去就是著名
的“人止关”了。这里可以看见一些兽之城居民从上面下来，你
无意之间向下望了望，只觉得有些头昏,不过还是看到了几座小房。
LONG
);
		}
		return 0;
	}
}


