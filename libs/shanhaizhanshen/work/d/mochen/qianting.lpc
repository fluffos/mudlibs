inherit ROOM;
int do_look(string arg);
void create ()
{
        set ("short", "前厅");
        set ("long", @LONG
这里是兽之城总部的前厅。走到这里顿时觉得有一种肃杀的气氛。
左右两边的墙上画着两只握在一起的手，代表着城中各族团结一
致共御外敌。正前面的牌匾上写着“兽之城”。正中间有一张巨
椅，两旁整齐的站着一排兽之城的弟子。这里是兽之城处理城中
大事的地方。向北望去有两个通往偏厅的门。东西两侧分别是练
武场。
LONG);
        
       

        set("exits", ([
                "south" : __DIR__"lysquare",
                "northeast" : __DIR__"dongpianting",
                "northwest" : __DIR__"xipianting",
                "east" : __DIR__"dongwuchang",
                "west" : __DIR__"xiwuchang",
        ]));

        setup();
        
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
深夜，夜幕低垂，满天繁星映衬着宁静的大地。这里是兽之城总
部的前厅。走到这里顿时觉得有一种肃杀的气氛。左右两边的墙
上画着两只握在一起的手，代表着城中各族团结一致共御外敌。
正前面的牌匾上写着“兽之城”。正中间有一张巨椅，两旁整齐
的站着一排兽之城的弟子。这里是兽之城处理城中大事的地方。
向北望去有两个通往偏厅的门。东西两侧分别是练武场。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
东方的地平线上渐渐有了黎明的颜色。这里是兽之城总部的前厅。
走到这里顿时觉得有一种肃杀的气氛。左右两边的墙上画着两只
握在一起的手，代表着城中各族团结一致共御外敌。正前面的牌
匾上写着“兽之城”。正中间有一张巨椅，两旁整齐的站着一排
兽之城的弟子。这里是兽之城处理城中大事的地方。向北望去有
两个通往偏厅的门。东西两侧分别是练武场。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
太阳高挂在你的头顶正上方。这里是兽之城总部的前厅。走到这
里顿时觉得有一种肃杀的气氛。左右两边的墙上画着两只握在一
起的手，代表着城中各族团结一致共御外敌。正前面的牌匾上写
着“兽之城”。正中间有一张巨椅，两旁整齐的站着一排兽之城
的弟子。这里是兽之城处理城中大事的地方。向北望去有两个通
往偏厅的门。东西两侧分别是练武场。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
太阳孤独地向西方的天空中慢慢沉落。这里是兽之城总部的前厅。
走到这里顿时觉得有一种肃杀的气氛。左右两边的墙上画着两只
握在一起的手，代表着城中各族团结一致共御外敌。正前面的牌
匾上写着“兽之城”。正中间有一张巨椅，两旁整齐的站着一排
兽之城的弟子。这里是兽之城处理城中大事的地方。向北望去有
两个通往偏厅的门。东西两侧分别是练武场。
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，如洗的天空露出几点星星。这里是兽之城总部的前
厅。走到这里顿时觉得有一种肃杀的气氛。左右两边的墙上画着
两只握在一起的手，代表着城中各族团结一致共御外敌。正前面
的牌匾上写着“兽之城”。正中间有一张巨椅，两旁整齐的站着
一排兽之城的弟子。这里是兽之城处理城中大事的地方。向北望
去有两个通往偏厅的门。东西两侧分别是练武场。
LONG
);
		}
		return 0;
	}
}


