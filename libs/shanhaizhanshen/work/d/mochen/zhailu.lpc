inherit ROOM;
int do_look(string arg);
void create ()
{
        set ("short", "小径");
        set ("long", @LONG
这是一条很窄的泥路，你走得有些不舒服。从这里再向北走几步
就到了兽之城的西院了。这条路上一个人也没有，据说这里在晚
上有人见到了几个黑影一闪而过。所以现在已经很少人来这里了。
LONG);
	

        set("exits", 
        ([
		"north" : __DIR__"xiyuan",
		"south" : __DIR__"xiaowu",
       ]));
set("no_clean_up", 0);
        set("outdoors", "mochen");
        setup();
        
}

int valid_leave(object me, string dir)
{
        me=this_player();

        if (  ((dir == "south") )
                && ( present("jian", this_player())
                || present("dao", this_player()) ))
        {
	        message_vision("你发现这小屋有些古怪，你的武器全都粘在门上拿不下来了！看来你要先放下武器了。\n", me);
        	return notify_fail("\n");
        }
        return ::valid_leave(me, dir);
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
深夜，夜幕低垂，满天繁星映衬着宁静的大地。这是一条很窄的
泥路，你走得有些不舒服。从这里再向北走几步就到了兽之城的
西院了。这条路上一个人也没有，据说这里在晚上有人见到了几
个黑影一闪而过。所以现在已经很少人来这里了。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
东方的地平线上渐渐有了黎明的颜色。这是一条很窄的泥路，你
走得有些不舒服。从这里再向北走几步就到了兽之城的西院了。
这条路上一个人也没有，据说这里在晚上有人见到了几个黑影一
闪而过。所以现在已经很少人来这里了。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
太阳高挂在你的头顶正上方。这是一条很窄的泥路，你走得有些
不舒服。从这里再向北走几步就到了兽之城的西院了。这条路上
一个人也没有，据说这里在晚上有人见到了几个黑影一闪而过。
所以现在已经很少人来这里了。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
太阳孤独地向西方的天空中慢慢沉落。这是一条很窄的泥路，你
走得有些不舒服。从这里再向北走几步就到了兽之城的西院了。
这条路上一个人也没有，据说这里在晚上有人见到了几个黑影一
闪而过。所以现在已经很少人来这里了。
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，如洗的天空露出几点星星。这是一条很窄的泥路，
你走得有些不舒服。从这里再向北走几步就到了兽之城的西院了。
这条路上一个人也没有，据说这里在晚上有人见到了几个黑影一
闪而过。所以现在已经很少人来这里了。
LONG
);
		}
		return 0;
	}
}



