inherit ROOM;
int do_look(string arg);

void create ()
{
        set ("short", "菜田");
        set ("long", @LONG
这里周围都是一块块的田地，种的都是粮食，看来是兽之城的私
田，大概是因为兽之城在山中吧，万一被人围山时也不会因为粮
食不足而被击败。看来兽之城真是不简单啊。你正想着，突然发
现自己迷路了！
LONG);
        set("no_clean_up", 0);
        set("outdoors", "mochen");

        set("exits", ([
                "north" : __DIR__"tian3",
                "south" : __DIR__"tian"+(random(4)+1),
                "east" : __DIR__"tian"+(random(4)+1),
                "west" : __DIR__"tian"+(random(4)+1),
        ]));

        setup();
        
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
深夜，夜幕低垂，满天繁星映衬着宁静的大地。这里周围都是一
块块的田地，种的都是粮食，看来是兽之城的私田，大概是因为
兽之城在山中吧，万一被人围山时也不会因为粮食不足而被击败。
看来兽之城真是不简单啊。你正想着，突然发现自己迷路了！
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
东方的地平线上渐渐有了黎明的颜色。这里周围都是一块块的田
地，种的都是粮食，看来是兽之城的私田，大概是因为兽之城在
山中吧，万一被人围山时也不会因为粮食不足而被击败。看来兽
之城真是不简单啊。你正想着，突然发现自己迷路了！
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
太阳高挂在你的头顶正上方。这里周围都是一块块的田地，种的
都是粮食，看来是兽之城的私田，大概是因为兽之城在山中吧，
万一被人围山时也不会因为粮食不足而被击败。看来兽之城真是
不简单啊。你正想着，突然发现自己迷路了！
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
太阳孤独地向西方的天空中慢慢沉落。这里周围都是一块块的田
地，种的都是粮食，看来是兽之城的私田，大概是因为兽之城在
山中吧，万一被人围山时也不会因为粮食不足而被击败。看来兽
之城真是不简单啊。你正想着，突然发现自己迷路了！
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，如洗的天空露出几点星星。这里周围都是一块块的
田地，种的都是粮食，看来是兽之城的私田，大概是因为兽之城
在山中吧，万一被人围山时也不会因为粮食不足而被击败。看来
兽之城真是不简单啊。你正想着，突然发现自己迷路了！
LONG
);
		}
		return 0;
	}
}

