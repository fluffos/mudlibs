inherit ROOM;
int do_look(string arg);
void create ()
{
        set ("short", "东院");
        set ("long", @LONG
这里是兽之城的东院，一条青石小路铺在脚下，路的南面是一个
圆形的拱门，从拱门可以看到总管房，路在这里拐了一个小弯，
转向北方，再向北,走过小径，就是女寝室了。西面隐约传来了
练武的吆喝声。
LONG);
	
       set("outdoors", "mochen");
       set("exits", 
        ([
		"west" :__DIR__"eroad",
		"east" :__DIR__"zhangfang",
		"north" : __DIR__"xiaojing",
		"south" : __DIR__"zongguanfang",
	       
         ]));
  set("no_clean_up", 0);
       setup();
	
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
深夜，夜幕低垂，满天繁星映衬着宁静的大地。这里是兽之城的
东院，一条青石小路铺在脚下，路的南面是一个圆形的拱门，从
拱门可以看到总管房，路在这里拐了一个小弯，转向北方，再向
北,走过小径，就是女寝室了。西面隐约传来了练武的吆喝声。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
东方的地平线上渐渐有了黎明的颜色。这里是兽之城的东院，一
条青石小路铺在脚下，路的南面是一个圆形的拱门，从拱门可以
看到总管房，路在这里拐了一个小弯，转向北方，再向北,走过小
径，就是女寝室了。西面隐约传来了练武的吆喝声。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
太阳高挂在你的头顶正上方。这里是兽之城的东院，一条青石小
路铺在脚下，路的南面是一个圆形的拱门，从拱门可以看到总管
房，路在这里拐了一个小弯，转向北方，再向北,走过小径，就是
女寝室了。西面隐约传来了练武的吆喝声。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
太阳孤独地向西方的天空中慢慢沉落。这里是兽之城的东院，一
条青石小路铺在脚下，路的南面是一个圆形的拱门，从拱门可以
看到总管房，路在这里拐了一个小弯，转向北方，再向北,走过小
径，就是女寝室了。西面隐约传来了练武的吆喝声。
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，如洗的天空露出几点星星。这里是兽之城的东院，
一条青石小路铺在脚下，路的南面是一个圆形的拱门，从拱门可
以看到总管房，路在这里拐了一个小弯，转向北方，再向北,走
过小径，就是女寝室了。西面隐约传来了练武的吆喝声。
LONG
);
		}
		return 0;
	}
}


