inherit ROOM;
int do_look(string arg);
void create ()
{
        set ("short", "土路");
        set ("long", @LONG
这是一条普通的土路，黄黄的土路一直延伸到杂草之中，看不清
去路。路上不时滚着一些枯草团。
LONG);
	set("no_clean_up", 0);

        set("exits", 
        ([
		"northup" : __DIR__"huangdi",
		"east" : __DIR__"mudi",
       ]));

        set("outdoors", "mochen");
        setup();
        
}

void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
深夜，夜幕低垂，满天繁星映衬着宁静的大地。这是一条普通的
土路，黄黄的土路一直延伸到杂草之中，看不清去路。路上不时
滚着一些枯草团。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
东方的地平线上渐渐有了黎明的颜色。这是一条普通的土路，黄
黄的土路一直延伸到杂草之中，看不清去路。路上不时滚着一些
枯草团。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
太阳高挂在你的头顶正上方。这是一条普通的土路，黄黄的土路
一直延伸到杂草之中，看不清去路。路上不时滚着一些枯草团。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
太阳孤独地向西方的天空中慢慢沉落。这是一条普通的土路，黄
黄的土路一直延伸到杂草之中，看不清去路。路上不时滚着一些
枯草团。
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，如洗的天空露出几点星星。这是一条普通的土路，
黄黄的土路一直延伸到杂草之中，看不清去路。路上不时滚着一
些枯草团。
LONG
);
		}
		return 0;
	}
}


