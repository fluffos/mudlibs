inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "女寝室");
	set("long", @LONG
这是一间宽敞的房间，室内仅有的几扇窗户却总拉着窗帘。屋内
非常整洁，隐隐透出一股清香。东墙边上有张台子，台子上点着
香，墙上还挂着一面银镜，看来是女人化妆用的。房间里剩下的
就是几张大床和一个大衣柜了。
     .    !__________!    .    _______
    /_\   |____  ____|   /_\   |__*__|
   __|__  {____}{____}  __|__  |__*__|
 __|_*_|__%%%%%%%%%%%%__|_*_|__|__*__|__
   |   | %%%%%%%%%%%%%% |   |  |/   \|
        %%%%%%%%%%%%%%%%
       %%%%%%%%%%%%%%%%%%
      %%%%%%%%%%%%%%%%%%%%
     /||||||||||||||||||||\
     ||||||||||||||||||lc||
LONG
	);

	set("no_fight", 1);

	set("sleep_room", 1);

	  set("no_clean_up", 0);

	set("exits", ([
		"south" : __DIR__"xiaojing",
	]));

	setup();
	
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
