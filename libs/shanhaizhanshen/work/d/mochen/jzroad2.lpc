// Room: jzroad2.c

inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "松树林");
	set("long", @LONG
这是一片松树林。中间一条小路，两边都是黑森森的几丈高的松
树。快出林了，可以看到东北边好高的一座大山，那里应该就是
兽之城的后山了。
LONG );
	set("exits", ([
		"south" : __DIR__"jzroad1",
		"northeast" : __DIR__"jzroad3",
	]));
	set("outdoors", "mochen");
	  set("no_clean_up", 0);

	setup();
	
}


void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
深夜，夜幕低垂，满天繁星映衬着宁静的大地。这是一片松树林。
中间一条小路，两边都是黑森森的几丈高的松树。快出林了，可
以看到东北边好高的一座大山，那里应该就是兽之城的后山了。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
东方的地平线上渐渐有了黎明的颜色。这是一片松树林。中间一
条小路，两边都是黑森森的几丈高的松树。快出林了，可以看到
东北边好高的一座大山，那里应该就是兽之城的后山了。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
太阳高挂在你的头顶正上方。这是一片松树林。中间一条小路，
两边都是黑森森的几丈高的松树。快出林了，可以看到东北边好
高的一座大山，那里应该就是兽之城的后山了。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
太阳孤独地向西方的天空中慢慢沉落。这是一片松树林。中间一
条小路，两边都是黑森森的几丈高的松树。快出林了，可以看到
东北边好高的一座大山，那里应该就是兽之城的后山了。
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，如洗的天空露出几点星星。这是一片松树林。中间
一条小路，两边都是黑森森的几丈高的松树。快出林了，可以看
到东北边好高的一座大山，那里应该就是兽之城的后山了。
LONG
);
		}
		return 0;
	}
}


