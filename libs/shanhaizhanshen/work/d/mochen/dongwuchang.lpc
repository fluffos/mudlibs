inherit ROOM;

void init();

int do_look(string arg);
void create ()
{
        set ("short", "东练武场");
        set ("long", @LONG
这是一个宽敞的东练武场，周围放着一些沙包和木人，左边有一
个木人摇摇晃晃的挂在木架上，右边有个大沙包。两旁兵器架上
面有着各式兵器。至于北面是一个小房子，那是个兵器房。再向
东走就是东院了。向南的是一条小路，一直通向溪边。
LONG);
        set("area","兽之城");
        set("exits", ([
                "west" : __DIR__"qianting",
                "east" : __DIR__"eroad",
                "north" : __DIR__"bingqifang",
                "south" : __DIR__"xiaojing1",
        ]));
set("no_clean_up", 0);
        setup();
}

void init()
{
        add_action("do_da", "da");
        add_action("do_ci", "ci");
        add_action("do_look", "look");
}



//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
深夜，夜幕低垂，满天繁星映衬着宁静的大地。这是一个宽敞的
东练武场，周围放着一些沙包和木人，左边有一个木人摇摇晃晃
的挂在木架上，右边有个大沙包。两旁兵器架上面有着各式兵器。
至于北面是一个小房子，那是个兵器房。再向东走就是东院了。
向南的是一条小路，一直通向溪边。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
东方的地平线上渐渐有了黎明的颜色。这是一个宽敞的东练武场，
周围放着一些沙包和木人，左边有一个木人摇摇晃晃的挂在木架
上，右边有个大沙包。两旁兵器架上面有着各式兵器。至于北面
是一个小房子，那是个兵器房。再向东走就是东院了。向南的是
一条小路，一直通向溪边。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
太阳高挂在你的头顶正上方。这是一个宽敞的东练武场，周围放
着一些沙包和木人，左边有一个木人摇摇晃晃的挂在木架上，右
边有个大沙包。两旁兵器架上面有着各式兵器。至于北面是一个
小房子，那是个兵器房。再向东走就是东院了。向南的是一条小
路，一直通向溪边。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
太阳孤独地向西方的天空中慢慢沉落。这是一个宽敞的东练武场，
周围放着一些沙包和木人，左边有一个木人摇摇晃晃的挂在木架
上，右边有个大沙包。两旁兵器架上面有着各式兵器。至于北面
是一个小房子，那是个兵器房。再向东走就是东院了。向南的是
一条小路，一直通向溪边。
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，如洗的天空露出几点星星。这是一个宽敞的东练武
场，周围放着一些沙包和木人，左边有一个木人摇摇晃晃的挂在
木架上，右边有个大沙包。两旁兵器架上面有着各式兵器。至于
北面是一个小房子，那是个兵器房。再向东走就是东院了。向南
的是一条小路，一直通向溪边。
LONG
);
		}
		return 0;
	}
}



