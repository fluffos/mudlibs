inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "了望台");
  set("long", @LONG
这里是“人止关”旁的一个了望台，大概是为了观察四周环境用
的，这里的雾比山间少多了，所以可以清晰地看见北面的一个大
广场，那里应该就是兽之城的大广场吧！你深呼吸了几下，感到
空气十分清新，使人心旷神怡。
LONG);
  set("area", "兽之城");
  set("outdoors", "mochen");
  set("no_clean_up", 0);
  set("objects", ([
    __DIR__ "npc/showei2": 1,
  ]));

  set("exits", ([
    "south": __DIR__ "renzhiguan",
  ]));
  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
深夜，夜幕低垂，满天繁星映衬着宁静的大地。这里是“人止关”
旁的一个了望台，大概是为了观察四周环境用的，这里的雾比山
间少多了，所以可以清晰地看见北面的一个大广场，那里应该就
是兽之城的大广场吧！你深呼吸了几下，感到空气十分清新，使
人心旷神怡。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
东方的地平线上渐渐有了黎明的颜色。这里是“人止关”旁的一
个了望台，大概是为了观察四周环境用的，这里的雾比山间少多
了，所以可以清晰地看见北面的一个大广场，那里应该就是兽之
城的大广场吧！你深呼吸了几下，感到空气十分清新，使人心旷
神怡。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
太阳高挂在你的头顶正上方。这里是“人止关”旁的一个了望台，
大概是为了观察四周环境用的，这里的雾比山间少多了，所以可
以清晰地看见北面的一个大广场，那里应该就是兽之城的大广场
吧！你深呼吸了几下，感到空气十分清新，使人心旷神怡。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
太阳孤独地向西方的天空中慢慢沉落。这里是“人止关”旁的一
个了望台，大概是为了观察四周环境用的，这里的雾比山间少多
了，所以可以清晰地看见北面的一个大广场，那里应该就是兽之
城的大广场吧！你深呼吸了几下，感到空气十分清新，使人心旷
神怡。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚降临了，如洗的天空露出几点星星。这里是“人止关”旁的
一个了望台，大概是为了观察四周环境用的，这里的雾比山间少
多了，所以可以清晰地看见北面的一个大广场，那里应该就是兽
之城的大广场吧！你深呼吸了几下，感到空气十分清新，使人心
旷神怡。
LONG
        );
    }
    return 0;
  }
}
