inherit ROOM;
int do_look(string arg);
void create ()
{
        set ("short", "兽之城广场");
        set ("long", @LONG
这里是"兽之城"的大广场，山中一个人造的大平台使这里形成一
个巨大的广场。广场的中央是方园约十丈的花池，各色的鲜花在
池中争香吐艳。五色的鲤鱼与碧绿的浮萍相互辉映，赏心悦目。
花池的中央是一条大石柱，石柱上刻着城中各种族的浮雕。
        ,               ,
      /'`\             /|\
    ,' :  `\  ,      /' | `\
   .'  :    `/| /| /'  /'   |
._ |   `\   |'|/'//'  |     | ,
`\`-\    |  |/' |'|   `\    |/|
 /`\_`-,_|_-'_,-'/|     `\,/'/'
|/~~~~~~\ /'~  /' `\___-~/_,'
         Y     `~`~\_Y ~~~
          `\/        |_
          -`,/    \/'
             |    /'
      `~\  _.' _/'\
         \  |_ |
          `\| /'
LONG);
        set("area","兽之城");
        set("outdoors", "mochen");
            set("no_clean_up", 0);

        

        set("exits", ([
                
                "north" : __DIR__"qianting",
                "westdown" :__DIR__"shanlu1",
        ]));

        setup();

        
}

void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
深夜，夜幕低垂，满天繁星映衬着宁静的大地。这里是"兽之城"
的大广场，山中一个人造的大平台使这里形成一个巨大的广场。
广场的中央是方园约十丈的花池，各色的鲜花在池中争香吐艳。
五色的鲤鱼与碧绿的浮萍相互辉映，赏心悦目。花池的中央是一
条大石柱，石柱上刻着城中各种族的浮雕。
