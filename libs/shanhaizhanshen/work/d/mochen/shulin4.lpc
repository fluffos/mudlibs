inherit ROOM;

int do_look(string arg);
void create() {
  set("short", "树林");
  set("long", @LONG
茂密的树叶遮挡了阳光，这使你周围环境显得有点阴森。一阵风
吹过，周围的树叶“沙沙”的作响。你发现四周都是大树，不知
哪一边是出路。你好象已经迷路了。你有些害怕，突然林中跳出
一只不知名的动物，吓了你一大跳。
LONG);


  set("outdoors", "mochen");

  set("exits", ([
    "east": __DIR__ "shulin" + (random(4) + 1),
    "south": __DIR__ "huangdi",
    "west": __DIR__ "shulin" + (random(4) + 1),
    "north": __DIR__ "shulin" + (random(4) + 1),

  ]));
  setup();
}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
深夜，夜幕低垂，满天繁星映衬着宁静的大地。茂密的树叶遮挡
了阳光，这使你周围环境显得有点阴森。一阵风吹过，周围的树
叶“沙沙”的作响。你发现四周都是大树，不知哪一边是出路。
你好象已经迷路了。你有些害怕，突然林中跳出一只不知名的动
物，吓了你一大跳。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
东方的地平线上渐渐有了黎明的颜色。茂密的树叶遮挡了阳光，
这使你周围环境显得有点阴森。一阵风吹过，周围的树叶“沙沙
”的作响。你发现四周都是大树，不知哪一边是出路。你好象已
经迷路了。你有些害怕，突然林中跳出一只不知名的动物，吓了
你一大跳。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
太阳高挂在你的头顶正上方。茂密的树叶遮挡了阳光，这使你周
围环境显得有点阴森。一阵风吹过，周围的树叶“沙沙”的作响。
你发现四周都是大树，不知哪一边是出路。你好象已经迷路了。
你有些害怕，突然林中跳出一只不知名的动物，吓了你一大跳。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
太阳孤独地向西方的天空中慢慢沉落。茂密的树叶遮挡了阳光，
这使你周围环境显得有点阴森。一阵风吹过，周围的树叶“沙沙”
的作响。你发现四周都是大树，不知哪一边是出路。你好象已经
迷路了。你有些害怕，突然林中跳出一只不知名的动物，吓了你
一大跳。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚降临了，如洗的天空露出几点星星。茂密的树叶遮挡了阳光，
这使你周围环境显得有点阴森。一阵风吹过，周围的树叶“沙沙”
的作响。你发现四周都是大树，不知哪一边是出路。你好象已经
迷路了。你有些害怕，突然林中跳出一只不知名的动物，吓了你
一大跳。
LONG
        );
    }
    return 0;
  }
}
