inherit ROOM;
int do_look(string arg);
void create ()
{
        set ("short", "小径");
        set ("long", @LONG
这是一条青石铺成的小径，四周都可以听见小鸟的叫声,从这里
再向北走就到兽之城的东练武场了，而向南是一大片树林，隐约
看得见树林中有些移动的影子,
LONG);
	
       set("outdoors", "mochen");
       set("exits", 
        ([
		"north" : __DIR__"dongwuchang",
		"south" : __DIR__"shulin",
       ]));
 set("no_clean_up", 0);
                setup();
       
}

void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间,
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
深夜，夜幕低垂，满天繁星映衬着宁静的大地,这是一条青石铺
成的小径，四周都可以听见小鸟的叫声,从这里再向北走就到兽
之城的东练武场了，而向南是一大片树林，隐约看得见树林中有
些移动的影子,
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
东方的地平线上渐渐有了黎明的颜色,这是一条青石铺成的小径，
四周都可以听见小鸟的叫声,从这里再向北走就到兽之城的东练
武场了，而向南是一大片树林，隐约看得见树林中有些移动的影子,
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
太阳高挂在你的头顶正上方,这是一条青石铺成的小径，四周都
可以听见小鸟的叫声,从这里再向北走就到兽之城的东练武场了，
而向南是一大片树林，隐约看得见树林中有些移动的影子,
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
太阳孤独地向西方的天空中慢慢沉落,这是一条青石铺成的小径，
四周都可以听见小鸟的叫声,从这里再向北走就到兽之城的东练
武场了，而向南是一大片树林，隐约看得见树林中有些移动的影子,
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，如洗的天空露出几点星星,这是一条青石铺成的小
径，四周都可以听见小鸟的叫声,从这里再向北走就到兽之城的
东练武场了，而向南是一大片树林，隐约看得见树林中有些移动
的影子,
LONG
);
		}
		return 0;
	}
}


