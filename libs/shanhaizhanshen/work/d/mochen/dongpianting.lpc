inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "东偏厅");
  set("long", @LONG
这里的摆设十分朴素，这里是兽之城两大“兽神将”练剑的地方。
西南方的门是通往前厅的而西北方的门是通往兽之城庄内堂的。
而东北方则是男弟子的东武院了。
LONG);
  set("area", " 兽之城");
  set("valid_startroom", 1);

  set("exits", ([
    "northwest": __DIR__ "neitang",
    "southwest": __DIR__ "qianting",
    "northeast": __DIR__ "dongwuyuan",
  ]));
  set("no_clean_up", 0);
  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
深夜，夜幕低垂，满天繁星映衬着宁静的大地。这里的摆设十分
朴素，这里是兽之城两大“兽神将”练剑的地方。西南方的门是
通往前厅的而西北方的门是通往兽之城庄内堂的。而东北方则是
男弟子的东武院了。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
东方的地平线上渐渐有了黎明的颜色。这里的摆设十分朴素，这
里是兽之城两大“兽神将”练剑的地方。西南方的门是通往前厅
的而西北方的门是通往兽之城庄内堂的。而东北方则是男弟子的
东武院了。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
太阳高挂在你的头顶正上方。这里的摆设十分朴素，这里是兽之
城两大“兽神将”练剑的地方。西南方的门是通往前厅的而西北
方的门是通往兽之城庄内堂的。而东北方则是男弟子的东武院了。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
太阳孤独地向西方的天空中慢慢沉落。这里的摆设十分朴素，这
里是兽之城两大“兽神将”练剑的地方。西南方的门是通往前厅
的而西北方的门是通往兽之城庄内堂的。而东北方则是男弟子的
东武院了。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚降临了，如洗的天空露出几点星星。这里的摆设十分朴素，
这里是兽之城两大“兽神将”练剑的地方。西南方的门是通往前
厅的而西北方的门是通往兽之城庄内堂的。而东北方则是男弟子
的东武院了。
LONG
        );
    }
    return 0;
  }
}
