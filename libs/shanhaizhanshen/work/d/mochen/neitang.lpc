inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "内堂");
  set("long", @LONG
这里是兽之城城主授徒的地方，所以很宽阔。东西两墙上挂着刀
和盾。正北的墙上是一幅巨大的城防图。东南方和西南方的两个
门是很显然是从前厅来这里的两个偏厅。向两边看去，可以看见
弟子们在武院里练功夫。
LONG);
  set("area", "兽之城");
  set("no_clean_up", 0);
  set("objects", ([
    __DIR__ "npc/jia": 1,
  ]));

  set("exits", ([
    "southwest": __DIR__ "xipianting",
    "southeast": __DIR__ "dongpianting",
    "east": __DIR__ "dongwuyuan",
    "west": __DIR__ "xiwuyuan",
  ]));

  setup();
}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
深夜，夜幕低垂，满天繁星映衬着宁静的大地。这里是兽之城城
主授徒的地方，所以很宽阔。东西两墙上挂着刀和盾。正北的墙
上是一幅巨大的城防图。东南方和西南方的两个门是很显然是从
前厅来这里的两个偏厅。向两边看去，可以看见弟子们在武院里
练功夫。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
东方的地平线上渐渐有了黎明的颜色。这里是兽之城城主授徒的
地方，所以很宽阔。东西两墙上挂着刀和盾。正北的墙上是一幅
巨大的城防图。东南方和西南方的两个门是很显然是从前厅来这
里的两个偏厅。向两边看去，可以看见弟子们在武院里练功夫。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
太阳高挂在你的头顶正上方。这里是兽之城城主授徒的地方，所
以很宽阔。东西两墙上挂着刀和盾。正北的墙上是一幅巨大的城
防图。东南方和西南方的两个门是很显然是从前厅来这里的两个
偏厅。向两边看去，可以看见弟子们在武院里练功夫。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
太阳孤独地向西方的天空中慢慢沉落。这里是兽之城城主授徒的
地方，所以很宽阔。东西两墙上挂着刀和盾。正北的墙上是一幅
巨大的城防图。东南方和西南方的两个门是很显然是从前厅来这
里的两个偏厅。向两边看去，可以看见弟子们在武院里练功夫。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚降临了，如洗的天空露出几点星星。这里是兽之城城主授徒
的地方，所以很宽阔。东西两墙上挂着刀和盾。正北的墙上是一
幅巨大的城防图。东南方和西南方的两个门是很显然是从前厅来
这里的两个偏厅。向两边看去，可以看见弟子们在武院里练功夫。
LONG
        );
    }
    return 0;
  }
}
