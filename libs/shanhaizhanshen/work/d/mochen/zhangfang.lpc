inherit ROOM;
int do_look(string arg);
void create ()
{
        set ("short", "帐房");
        set ("long", @LONG
这里是兽之城的帐房。兽之城日常的收入支出在这里都有记录，
负责管帐的是个老先生，学识颇为丰富，如果有什么学习上的
问题就来问他。帐房里堆了一柜子的帐本、单据，还有不少贴
上封条的大箱子，想来都是银子吧。
LONG);
        set("area","兽之城");
        
        
        set("no_clean_up", 0);
        set("objects", ([
                __DIR__"npc/miao" : 1,
        ]));
        set("exits", ([
                "west" : __DIR__"dongyuan",
        ]));

        setup();
       
}

void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
深夜，夜幕低垂，满天繁星映衬着宁静的大地。这里是兽之城的
帐房。兽之城日常的收入支出在这里都有记录，负责管帐的是个
老先生，学识颇为丰富，如果有什么学习上的问题就来问他。帐
房里堆了一柜子的帐本、单据，还有不少贴上封条的大箱子，想
来都是银子吧。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
东方的地平线上渐渐有了黎明的颜色。这里是兽之城的帐房。兽
之城日常的收入支出在这里都有记录，负责管帐的是个老先生，
学识颇为丰富，如果有什么学习上的问题就来问他。帐房里堆了
一柜子的帐本、单据，还有不少贴上封条的大箱子，想来都是银
子吧。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
太阳高挂在你的头顶正上方。这里是兽之城的帐房。兽之城日常
的收入支出在这里都有记录，负责管帐的是个老先生，学识颇为
丰富，如果有什么学习上的问题就来问他。帐房里堆了一柜子的
帐本、单据，还有不少贴上封条的大箱子，想来都是银子吧。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
太阳孤独地向西方的天空中慢慢沉落。这里是兽之城的帐房。兽
之城日常的收入支出在这里都有记录，负责管帐的是个老先生，
学识颇为丰富，如果有什么学习上的问题就来问他。帐房里堆了
一柜子的帐本、单据，还有不少贴上封条的大箱子，想来都是银
子吧。
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，如洗的天空露出几点星星。这里是兽之城的帐房。
兽之城日常的收入支出在这里都有记录，负责管帐的是个老先生，
学识颇为丰富，如果有什么学习上的问题就来问他。帐房里堆了
一柜子的帐本、单据，还有不少贴上封条的大箱子，想来都是银
子吧。
LONG
);
		}
		return 0;
	}
}


