inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "山路");
  set("long", @LONG
脚下虽然是塌实的青石路，可是由于常年的雾水弥漫，青石路反
而觉得有点滑，这里已经是半山腰了，不禁有些寒意，从这里再
向北攀上去就是著名的“人止关”了。你抬头向南看去，发现一
座山势怪异的山峰。
LONG);

  set("outdoors", "mochen");

  set("exits", ([
    "northup": __DIR__ "renzhiguan",
    "southup": __DIR__ "luoshenling",
  ]));
  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
深夜，夜幕低垂，满天繁星映衬着宁静的大地。脚下虽然是塌实
的青石路，可是由于常年的雾水弥漫，青石路反而觉得有点滑，
这里已经是半山腰了，不禁有些寒意，从这里再向北攀上去就是
著名的“人止关”了。你抬头向南看去，发现一座山势怪异的山峰。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
东方的地平线上渐渐有了黎明的颜色。脚下虽然是塌实的青石路，
可是由于常年的雾水弥漫，青石路反而觉得有点滑，这里已经是
半山腰了，不禁有些寒意，从这里再向北攀上去就是著名的“人
止关”了。你抬头向南看去，发现一座山势怪异的山峰。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
太阳高挂在你的头顶正上方。脚下虽然是塌实的青石路，可是由
于常年的雾水弥漫，青石路反而觉得有点滑，这里已经是半山腰
了，不禁有些寒意，从这里再向北攀上去就是著名的“人止关”
了。你抬头向南看去，发现一座山势怪异的山峰。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
太阳孤独地向西方的天空中慢慢沉落。脚下虽然是塌实的青石路，
可是由于常年的雾水弥漫，青石路反而觉得有点滑，这里已经是
半山腰了，不禁有些寒意，从这里再向北攀上去就是著名的“人
止关”了。你抬头向南看去，发现一座山势怪异的山峰。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚降临了，如洗的天空露出几点星星。脚下虽然是塌实的青石
路，可是由于常年的雾水弥漫，青石路反而觉得有点滑，这里已
经是半山腰了，不禁有些寒意，从这里再向北攀上去就是著名的
“人止关”了。你抬头向南看去，发现一座山势怪异的山峰。
LONG
        );
    }
    return 0;
  }
}
