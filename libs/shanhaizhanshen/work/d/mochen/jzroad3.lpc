// Room: jzroad3.c

inherit ROOM;
int do_look(string arg);

void create() {
  set("short", "树林外");
  set("long", @LONG
树林外，赫然站着一头巨熊，在阴森森的林子边上，凭添一股煞
气。东边是登山的路，西边又是一片森林了。
LONG);
  set("exits", ([
    "west": __DIR__ "shulin1",
    "eastup": __DIR__ "jzroad4",
    "southwest": __DIR__ "jzroad2",
  ]));
  set("no_clean_up", 0);



  setup();

}

void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
深夜，夜幕低垂，满天繁星映衬着宁静的大地。树林外，赫然站
着一头巨熊，在阴森森的林子边上，凭添一股煞气。东边是登山
的路，西边又是一片森林了。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
东方的地平线上渐渐有了黎明的颜色。树林外，赫然站着一头巨
熊，在阴森森的林子边上，凭添一股煞气。东边是登山的路，西
边又是一片森林了。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
太阳高挂在你的头顶正上方。树林外，赫然站着一头巨熊，在阴
森森的林子边上，凭添一股煞气。东边是登山的路，西边又是一
片森林了。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
太阳孤独地向西方的天空中慢慢沉落。树林外，赫然站着一头巨
熊，在阴森森的林子边上，凭添一股煞气。东边是登山的路，西
边又是一片森林了。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚降临了，如洗的天空露出几点星星。树林外，赫然站着一头
巨熊，在阴森森的林子边上，凭添一股煞气。东边是登山的路，
西边又是一片森林了。
LONG
        );
    }
    return 0;
  }
}
