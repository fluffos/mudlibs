// Room: fanting.c
// Created by Atlus 1999.7.21
// Modified by Atlus 1999.7.21

inherit ROOM;

void init();
int do_shake(string);
int do_look(string arg);
void delete_served(object);

void create()
{
	set("short", "饭厅");
	set("long", @LONG
这是兽之城的饭厅，厅内的摆设不多，只是几张大大的饭桌和的
几十把木凳。有几个人在吃饭，饭厅的南面有一个小窗，里面就
是厨房了。在这里的弟子们匆匆的进进出出，墙上写着：“吃饭
请招手（shake hand)”。
LONG
	);

	set("no_fight", 1);
	  set("no_clean_up", 0);
	set("objects", ([
                __DIR__"npc/tuchusi" : 1,
        ]));

       set("exits", ([
	          "north" :__DIR__"xiwuchang",
       ]));
       
	setup();
}
void init()
{
        add_action("do_shake", "shake");
        add_action("do_look", "look");
}

int do_shake(string arg)
{

        object me;
        object chifan;

        if (!arg || (arg != "shou" && arg != "hand"))
        {
                return notify_fail("你要干什么？\n");	
        }
		
        me = this_player();	
        if( !objectp(chifan = present("tuchusi", environment(me))) )
                return notify_fail("你举起手，向厨房那边招了招手，发现那里没人理你。看来你要过会再来了。\n");
	 	
        if( me->query_temp("fanmark") )
        {
                message_vision("厨子对$N说道：刚刚给你上过菜，这么快吃完了！新的还没好呢？\n", me);
                return notify_fail("");
        }

        message_vision("$N向厨房那边招了招手，厨子快步走过来招呼你。\n", me);
 
        chifan->serve_tea(me) ;

        me->set_temp("fanmark", 1);
        call_out("delete_served", 10, me);

        return 1;
}

void delete_served(object me)
{
        if ( objectp(me) ) me->delete_temp("fanmark");
}


int valid_leave(object me, string dir)
{
        object *obj;
        int i;

        me=this_player();

        if (  ((dir == "north") || (dir == "south") )
                && ( present("zhu", this_player())
                || present("tang", this_player()) || present("kaoya", this_player()) ))
        {
        message_vision("$N想起这里规定饭菜是不能带出饭厅的，就自动自觉的把想带出去的东西放下。\n", me);
        obj=all_inventory(me);
        for (i=0;i<sizeof(obj);i++){
                if (obj[i]->query("id")=="tang" || obj[i]->query("id")=="kaoya" ||
                    obj[i]->query("id")=="zhu" ) destruct(obj[i]);
                }
        }
        return ::valid_leave(me, dir);
}


		

//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
深夜，夜幕低垂，满天繁星映衬着宁静的大地。这是兽之城的饭
厅，厅内的摆设不多，只是几张大大的饭桌和的几十把木凳。有
几个人在吃饭，饭厅的南面有一个小窗，里面就是厨房了。在这
里的弟子们匆匆的进进出出，墙上写着：“吃饭请招手（shake hand)”。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
东方的地平线上渐渐有了黎明的颜色。这是兽之城的饭厅，厅内
的摆设不多，只是几张大大的饭桌和的几十把木凳。有几个人在
吃饭，饭厅的南面有一个小窗，里面就是厨房了。在这里的弟子
们匆匆的进进出出，墙上写着：“吃饭请招手（shake hand)”。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
太阳高挂在你的头顶正上方。这是兽之城的饭厅，厅内的摆设不
多，只是几张大大的饭桌和的几十把木凳。有几个人在吃饭，饭
厅的南面有一个小窗，里面就是厨房了。在这里的弟子们匆匆的
进进出出，墙上写着：“吃饭请招手（shake hand)”。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
太阳孤独地向西方的天空中慢慢沉落。这是兽之城的饭厅，厅内
的摆设不多，只是几张大大的饭桌和的几十把木凳。有几个人在
吃饭，饭厅的南面有一个小窗，里面就是厨房了。在这里的弟子
们匆匆的进进出出，墙上写着：“吃饭请招手（shake hand)”。
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，如洗的天空露出几点星星。这是兽之城的饭厅，厅
内的摆设不多，只是几张大大的饭桌和的几十把木凳。有几个人
在吃饭，饭厅的南面有一个小窗，里面就是厨房了。在这里的弟
子们匆匆的进进出出，墙上写着：“吃饭请招手（shake hand)”。
LONG
);
		}
		return 0;
	}
}


