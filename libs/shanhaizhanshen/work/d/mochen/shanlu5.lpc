inherit ROOM;
int do_look(string arg);
void create ()
{
        set ("short", "山路");
        set ("long", @LONG
脚下是一条小土路，盘旋上山，这条路是一直通向落神岭的。兽
之城据说就在岭的那边。除了兽之城的居民很少有人走这条路。
LONG);
       
        set("outdoors", "mochen");

        set("exits", ([
                "westup" : __DIR__"shanlu4",
                "southdown" : __DIR__"shanlu6",
        ]));
        setup();
        
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
深夜，夜幕低垂，满天繁星映衬着宁静的大地。脚下是一条小土
路，盘旋上山，这条路是一直通向落神岭的。兽之城据说就在岭
的那边。除了兽之城的居民很少有人走这条路。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
东方的地平线上渐渐有了黎明的颜色。脚下是一条小土路，盘旋
上山，这条路是一直通向落神岭的。兽之城据说就在岭的那边。
除了兽之城的居民很少有人走这条路。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
太阳高挂在你的头顶正上方。脚下是一条小土路，盘旋上山，这
条路是一直通向落神岭的。兽之城据说就在岭的那边。除了兽之
城的居民很少有人走这条路。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
太阳孤独地向西方的天空中慢慢沉落。脚下是一条小土路，盘旋
上山，这条路是一直通向落神岭的。兽之城据说就在岭的那边。
除了兽之城的居民很少有人走这条路。
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，如洗的天空露出几点星星。脚下是一条小土路，盘
旋上山，这条路是一直通向落神岭的。兽之城据说就在岭的那边。
除了兽之城的居民很少有人走这条路。
LONG
);
		}
		return 0;
	}
}


