inherit ROOM;
int do_look(string arg);
void create ()
{
        set ("short", "男寝室");
        set ("long", @LONG
这间房间里弥漫着一些古怪的气味，你顿时觉得不太自在。你看
看四周，发现这里排着几张床铺，床铺非常舒适。床上却是乱七
八糟，还有几个兽人在呼呼大睡。房间尽头有一张桌子，桌子上
燃着一种香，还有一大堆刚换的衣服胡乱丢在桌上。
          ()___
        ()//__/)_________________()
        ||(___)//#/_/#/_/#/_/#()/||
        ||----|#| |#|_|#|_|#|_|| ||
        ||____|_|#|_|#|_|#|_|#||/||
        ||    |#|_|#|_|#|_|#|_||"
LONG);
        set("area","兽之城");
           set("no_clean_up", 0);
        set("sleep_room", "1");
        set("no_fight", "1");

        set("exits", ([
                "south" : __DIR__"wxiaojing",
        ]));

        setup();
        
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
深夜，夜幕低垂，满天繁星映衬着宁静的大地。这间房间里弥漫
着一些古怪的气味，你顿时觉得不太自在。你看看四周，发现这
里排着几张床铺，床铺非常舒适。床上却是乱七八糟，还有几个
兽人在呼呼大睡。房间尽头有一张桌子，桌子上燃着一种香，还
有一大堆刚换的衣服胡乱丢在桌上。
          ()___
        ()//__/)_________________()
        ||(___)//#/_/#/_/#/_/#()/||
        ||----|#| |#|_|#|_|#|_|| ||
        ||____|_|#|_|#|_|#|_|#||/||
        ||    |#|_|#|_|#|_|#|_||"
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
东方的地平线上渐渐有了黎明的颜色。这间房间里弥漫着一些古
怪的气味，你顿时觉得不太自在。你看看四周，发现这里排着几
张床铺，床铺非常舒适。床上却是乱七八糟，还有几个兽人在呼
呼大睡。房间尽头有一张桌子，桌子上燃着一种香，还有一大堆
刚换的衣服胡乱丢在桌上。
          ()___
        ()//__/)_________________()
        ||(___)//#/_/#/_/#/_/#()/||
        ||----|#| |#|_|#|_|#|_|| ||
        ||____|_|#|_|#|_|#|_|#||/||
        ||    |#|_|#|_|#|_|#|_||"
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
太阳高挂在你的头顶正上方。这间房间里弥漫着一些古怪的气味，
你顿时觉得不太自在。你看看四周，发现这里排着几张床铺，床
铺非常舒适。床上却是乱七八糟，还有几个兽人在呼呼大睡。房
间尽头有一张桌子，桌子上燃着一种香，还有一大堆刚换的衣服
胡乱丢在桌上。
          ()___
        ()//__/)_________________()
        ||(___)//#/_/#/_/#/_/#()/||
        ||----|#| |#|_|#|_|#|_|| ||
        ||____|_|#|_|#|_|#|_|#||/||
        ||    |#|_|#|_|#|_|#|_||"
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
太阳孤独地向西方的天空中慢慢沉落。这间房间里弥漫着一些古
怪的气味，你顿时觉得不太自在。你看看四周，发现这里排着几
张床铺，床铺非常舒适。床上却是乱七八糟，还有几个兽人在呼
