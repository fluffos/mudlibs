inherit ROOM;
int do_look(string arg);

void create ()
{
        set ("short", "西院");
        set ("long", @LONG
这里是兽之城的西院，看上去和东院是一样的，路的南面是一条
窄路，远远可以看到一扇紧闭的木门，路在这里拐了一个弯，转
向北方，再向北就是男寝室了。东面的练武场隐约传来了练武的
吆喝声。
LONG);
	
       set("outdoors", "mochen");
       set("exits", 
        ([
		"north" : __DIR__"wxiaojing",
		"south" : __DIR__"zhailu",
	       "east" :__DIR__"xiwuchang",
         ]));
 set("no_clean_up", 0);
       setup();
	
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
深夜，夜幕低垂，满天繁星映衬着宁静的大地。这里是兽之城的
西院，看上去和东院是一样的，路的南面是一条窄路，远远可以
看到一扇紧闭的木门，路在这里拐了一个弯，转向北方，再向北
就是男寝室了。东面的练武场隐约传来了练武的吆喝声。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
东方的地平线上渐渐有了黎明的颜色。这里是兽之城的西院，看
上去和东院是一样的，路的南面是一条窄路，远远可以看到一扇
紧闭的木门，路在这里拐了一个弯，转向北方，再向北就是男寝
室了。东面的练武场隐约传来了练武的吆喝声。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
太阳高挂在你的头顶正上方。这里是兽之城的西院，看上去和东
院是一样的，路的南面是一条窄路，远远可以看到一扇紧闭的木
门，路在这里拐了一个弯，转向北方，再向北就是男寝室了。东
面的练武场隐约传来了练武的吆喝声。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
太阳孤独地向西方的天空中慢慢沉落。这里是兽之城的西院，看
上去和东院是一样的，路的南面是一条窄路，远远可以看到一扇
紧闭的木门，路在这里拐了一个弯，转向北方，再向北就是男寝
室了。东面的练武场隐约传来了练武的吆喝声。
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，如洗的天空露出几点星星。这里是兽之城的西院，
看上去和东院是一样的，路的南面是一条窄路，远远可以看到一
扇紧闭的木门，路在这里拐了一个弯，转向北方，再向北就是男
寝室了。东面的练武场隐约传来了练武的吆喝声。
LONG
);
		}
		return 0;
	}
}


