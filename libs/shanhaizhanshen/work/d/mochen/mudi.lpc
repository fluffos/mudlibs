// Modified by Atlus 1999.10.9
// 

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "墓地");
  set("long", @LONG
坟丛间，飘飞着纸钱的灰烬，干草被风吹起，象雨丝般飘着，打
着滚，越滚越大的草团在远处传来的隐隐狼嚎中随风起伏。墓园
里，有一个狼人在扫墓。
LONG);


  set("exits",
    ([
      "west": __DIR__ "tulu",
    ]));


  set("no_clean_up", 0);
  set("outdoors", "feiyu");
  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
深夜，夜幕低垂，满天繁星映衬着宁静的大地。坟丛间，飘飞着
纸钱的灰烬，干草被风吹起，象雨丝般飘着，打着滚，越滚越大
的草团在远处传来的隐隐狼嚎中随风起伏。墓园里，有一个狼人
在扫墓。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
东方的地平线上渐渐有了黎明的颜色。坟丛间，飘飞着纸钱的灰
烬，干草被风吹起，象雨丝般飘着，打着滚，越滚越大的草团在
远处传来的隐隐狼嚎中随风起伏。墓园里，有一个狼人在扫墓。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
太阳高挂在你的头顶正上方。坟丛间，飘飞着纸钱的灰烬，干草
被风吹起，象雨丝般飘着，打着滚，越滚越大的草团在远处传来
的隐隐狼嚎中随风起伏。墓园里，有一个狼人在扫墓。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
太阳孤独地向西方的天空中慢慢沉落。坟丛间，飘飞着纸钱的灰
烬，干草被风吹起，象雨丝般飘着，打着滚，越滚越大的草团在
远处传来的隐隐狼嚎中随风起伏。墓园里，有一个狼人在扫墓。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚降临了，如洗的天空露出几点星星。坟丛间，飘飞着纸钱的
灰烬，干草被风吹起，象雨丝般飘着，打着滚，越滚越大的草团
在远处传来的隐隐狼嚎中随风起伏。墓园里，有一个狼人在扫墓。
LONG
        );
    }
    return 0;
  }
}
