inherit ROOM;
int do_look(string arg);
void create ()
{
        set ("short", "东武院");
        set ("long", @LONG
这里是兽之城男弟子集中练习的地方。只见到几个人围在一起谈
论着。其余的都在各自练习着，西南方的路是通往东偏厅的，通
过西面的门就到内堂了。
LONG);
        set("area"," 兽之城");
      set("no_clean_up", 0);
      set("objects", ([
                __DIR__"npc/juma" : 1,
                __DIR__"npc/juho" : 1,
        ]));
        set("exits", ([
                "southwest" : __DIR__"dongpianting",
                "west" : __DIR__"neitang",   
        ]));

        setup();      
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
深夜，夜幕低垂，满天繁星映衬着宁静的大地。这里是兽之城男
弟子集中练习的地方。只见到几个人围在一起谈论着。其余的都
在各自练习着，西南方的路是通往东偏厅的，通过西面的门就到
内堂了。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
东方的地平线上渐渐有了黎明的颜色。这里是兽之城男弟子集中
练习的地方。只见到几个人围在一起谈论着。其余的都在各自练
习着，西南方的路是通往东偏厅的，通过西面的门就到内堂了。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
太阳高挂在你的头顶正上方。这里是兽之城男弟子集中练习的地
方。只见到几个人围在一起谈论着。其余的都在各自练习着，西
南方的路是通往东偏厅的，通过西面的门就到内堂了。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
太阳孤独地向西方的天空中慢慢沉落。这里是兽之城男弟子集中
练习的地方。只见到几个人围在一起谈论着。其余的都在各自练
习着，西南方的路是通往东偏厅的，通过西面的门就到内堂了。
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，如洗的天空露出几点星星。这里是兽之城男弟子集
中练习的地方。只见到几个人围在一起谈论着。其余的都在各自
练习着，西南方的路是通往东偏厅的，通过西面的门就到内堂了。
LONG
);
		}
		return 0;
	}
}


