// Room: houshan.c


inherit ROOM;
int do_look(string arg);
void create()
{
        set("short", "后山");
        set("long", @LONG
这里是后山的一个小平台。定睛一看，此处已经是云雾缥缈。不
远的地方好象有个小湖。北边的山路延伸到雾里，已经看不清了。
LONG );
        set("exits", ([ 
            "southdown" : __DIR__"jzroad3",
            "northwest"  : __DIR__"xiaohu",
            "northup"  : __DIR__"disanfeng",
		]));
        set("outdoors", "兽之城");
          set("no_clean_up", 0);

		setup();
       
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
深夜，夜幕低垂，满天繁星映衬着宁静的大地。这里是后山的一
个小平台。定睛一看，此处已经是云雾缥缈。不远的地方好象有
个小湖。北边的山路延伸到雾里，已经看不清了。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
东方的地平线上渐渐有了黎明的颜色。这里是后山的一个小平台。
定睛一看，此处已经是云雾缥缈。不远的地方好象有个小湖。北
边的山路延伸到雾里，已经看不清了。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
太阳高挂在你的头顶正上方。这里是后山的一个小平台。定睛一
看，此处已经是云雾缥缈。不远的地方好象有个小湖。北边的山
路延伸到雾里，已经看不清了。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
太阳孤独地向西方的天空中慢慢沉落。这里是后山的一个小平台。
定睛一看，此处已经是云雾缥缈。不远的地方好象有个小湖。北
边的山路延伸到雾里，已经看不清了。
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，如洗的天空露出几点星星。这里是后山的一个小平
台。定睛一看，此处已经是云雾缥缈。不远的地方好象有个小湖。
北边的山路延伸到雾里，已经看不清了。
LONG
);
		}
		return 0;
	}
}



