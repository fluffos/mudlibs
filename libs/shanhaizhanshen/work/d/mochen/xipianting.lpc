inherit ROOM;
int do_look(string arg);
void create ()
{
        set ("short", "西偏厅");
        set ("long", @LONG
这里的摆设和东偏厅一模一样，也是兽之城两大“兽神将”练剑
的地方。东南方的门是通往前厅的，而东北方的门也是通往兽之
城内堂的。而西北方则是女弟子的西武院了。
LONG);
        set("area"," 兽之城");
        

        set("exits", ([
                "northeast" : __DIR__"neitang",
                "southeast" : __DIR__"qianting",
                "northwest" : __DIR__"xiwuyuan",   
        ]));
         set("no_clean_up", 0);

        setup();
        
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
深夜，夜幕低垂，满天繁星映衬着宁静的大地。这里的摆设和东
偏厅一模一样，也是兽之城两大“兽神将”练剑的地方。东南方
的门是通往前厅的，而东北方的门也是通往兽之城内堂的。而西
北方则是女弟子的西武院了。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
东方的地平线上渐渐有了黎明的颜色。这里的摆设和东偏厅一模
一样，也是兽之城两大“兽神将”练剑的地方。东南方的门是通
往前厅的，而东北方的门也是通往兽之城内堂的。而西北方则是
女弟子的西武院了。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
太阳高挂在你的头顶正上方。这里的摆设和东偏厅一模一样，也
是兽之城两大“兽神将”练剑的地方。东南方的门是通往前厅的，
而东北方的门也是通往兽之城内堂的。而西北方则是女弟子的西
武院了。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
太阳孤独地向西方的天空中慢慢沉落。这里的摆设和东偏厅一模
一样，也是兽之城两大“兽神将”练剑的地方。东南方的门是通
往前厅的，而东北方的门也是通往兽之城内堂的。而西北方则是
女弟子的西武院了。
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，如洗的天空露出几点星星。这里的摆设和东偏厅一
模一样，也是兽之城两大“兽神将”练剑的地方。东南方的门是
通往前厅的，而东北方的门也是通往兽之城内堂的。而西北方则
是女弟子的西武院了。
LONG
);
		}
		return 0;
	}
}


