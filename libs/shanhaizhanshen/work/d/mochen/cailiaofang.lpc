inherit ROOM;

void init();

int do_look(string arg);


void create() {
  set("short", "材料房");
  set("long", @LONG
这里是兽之城塘的杂务房间。光线十分昏暗，只点了一根蜡烛。
这里有很多的瓶瓶罐罐和大柜子，一些瓶罐里面放着已经磨成
粉末的药材。还有一些乱七八糟的东西胡乱堆在墙角。
LONG);
  set("area", "兽之城");
  set("no_clean_up", 0);

  set("exits", ([
    "south": __DIR__ "xiwuchang",
  ]));



  setup();
}

void init() {
  add_action("do_look", "look");

}



//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
深夜，夜幕低垂，满天繁星映衬着宁静的大地。这里是兽之城
的杂务房间。光线十分昏暗，只点了一根蜡烛。这里有很多的
瓶瓶罐罐和大柜子，一些瓶罐里面放着已经磨成粉末的药材。
还有一些乱七八糟的东西胡乱堆在墙角。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
东方的地平线上渐渐有了黎明的颜色。这里是兽之城的杂务房
间。光线十分昏暗，只点了一根蜡烛。这里有很多的瓶瓶罐罐
和大柜子，一些瓶罐里面放着已经磨成粉末的药材。还有一些
乱七八糟的东西胡乱堆在墙角。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
太阳高挂在你的头顶正上方。这里是兽之城的杂务房间。光线
十分昏暗，只点了一根蜡烛。这里有很多的瓶瓶罐罐和大柜子，
一些瓶罐里面放着已经磨成粉末的药材。还有一些乱七八糟的
东西胡乱堆在墙角。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
太阳孤独地向西方的天空中慢慢沉落。这里是兽之城的杂务房
间。光线十分昏暗，只点了一根蜡烛。这里有很多的瓶瓶罐罐
和大柜子，一些瓶罐里面放着已经磨成粉末的药材。还有一些
乱七八糟的东西胡乱堆在墙角。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚降临了，如洗的天空露出几点星星。这里是兽之城的杂务
房间。光线十分昏暗，只点了一根蜡烛。这里有很多的瓶瓶罐
罐和大柜子，一些瓶罐里面放着已经磨成粉末的药材。还有一
些乱七八糟的东西胡乱堆在墙角。
LONG
        );
    }
    return 0;
  }
}
