inherit ROOM;
int do_look(string arg);
void create ()
{
        set ("short", "山间小屋");
        set ("long", @LONG
这里是一个山间小屋，小屋里空无一人。只剩下一些破旧的家具
用品了。看到这满布蛛网的破房，你不禁有些“无处话苍凉”的
感觉。东面是一座大山，阵阵凉风从上面吹下来,向西北走便是山
谷了。
LONG);
        
        set("outdoors", "mochen");

        

        set("exits", ([
                "eastup" : __DIR__"shanlu2",
                "northwest" : __DIR__"shangu2",
        ]));
        setup();
       
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
深夜，夜幕低垂，满天繁星映衬着宁静的大地。这里是一个山间
小屋，小屋里空无一人。只剩下一些破旧的家具用品了。看到这
满布蛛网的破房，你不禁有些“无处话苍凉”的感觉。东面是一
座大山，阵阵凉风从上面吹下来,向西北走便是山谷了。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
东方的地平线上渐渐有了黎明的颜色。这里是一个山间小屋，小
屋里空无一人。只剩下一些破旧的家具用品了。看到这满布蛛网
的破房，你不禁有些“无处话苍凉”的感觉。东面是一座大山，
阵阵凉风从上面吹下来,向西北走便是山谷了。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
太阳高挂在你的头顶正上方。这里是一个山间小屋，小屋里空无
一人。只剩下一些破旧的家具用品了。看到这满布蛛网的破房，
你不禁有些“无处话苍凉”的感觉。东面是一座大山，阵阵凉风
从上面吹下来,向西北走便是山谷了。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
太阳孤独地向西方的天空中慢慢沉落。这里是一个山间小屋，小
屋里空无一人。只剩下一些破旧的家具用品了。看到这满布蛛网
的破房，你不禁有些“无处话苍凉”的感觉。东面是一座大山，
阵阵凉风从上面吹下来,向西北走便是山谷了。
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，如洗的天空露出几点星星。这里是一个山间小屋，
小屋里空无一人。只剩下一些破旧的家具用品了。看到这满布蛛
网的破房，你不禁有些“无处话苍凉”的感觉。东面是一座大山，
阵阵凉风从上面吹下来,向西北走便是山谷了。
LONG
);
		}
		return 0;
	}
}


