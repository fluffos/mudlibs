// /u/beyond/mr/guanxingtai.c
// Written by Jpei

inherit ROOM;

int do_look(string arg);


void create()
{
	set("short","南城门");
	set("long",@LONG
这里是星天界的南城门，城门正上刻着“星天界”三个大字，一
条笔直的白石板大道向北南两边延伸。南边是郊外，行人匆匆。
北边是城里。                        
LONG
);
	set("exits",([
		"north" : __DIR__"jie14",
	]) );
	set("outdoors","lwe");
	set("no_clean_up",0);
	setup();
}

void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
月亮慢慢升到天中，夜色如水，这里是星天界的南城门，城门正
上方刻着“星天界”三个大字，一条笔直的白石板大道向北南两
边延伸。南边是郊外，行人匆匆。北边是城里。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
清晨的星天界联盟曙色隐现，天边已现出乳白色，阳光浅浅地照
在南城门上，一片灰蒙蒙的。城门正上方刻着“星天界”三个大
字，一条笔直的白石板大道向北南两边延伸。南边是郊外，行人
匆匆。北边是城里。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
午后时分，阳光普照，城门在阳光下明亮如镜，城门正方上刻着
“星天界”三个大字，一条笔直的白石板大道向北南两边延伸。
南边是郊外，行人匆匆。北边是城里。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
下午的阳光洒进来，可以看到城门上的树影逐渐拉长，日渐西山了。
LONG
);
			else//入夜
				set("long",@LONG
傍晚的阳光穿透树叶的缝隙，使城门看起来有些阴森。城中的炊
烟正在袅袅升起，是晚餐时分了。城外的行人开始回家了。
LONG
);
		}
		return 0;
	}
}


