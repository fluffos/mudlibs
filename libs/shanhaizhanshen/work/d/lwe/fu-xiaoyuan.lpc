// fu-xiaoyuan 富家小院
// By Lgg,1998.10

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "小院");
  set("long", @LONG
这是进门后的一个小院落。东面是一扇月形门好象通往花厅，北
面是大门，南面就是大堂了。
LONG
  );
  set("outdoors", "out");
  set("exits", ([
    "north": __DIR__ "fu-damen",
    "south": __DIR__ "fu-datang",
    "east": __DIR__ "fu-huating",
  ]));


  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
月亮慢慢升到天中，夜色如水，这是进门后的一个小院落。东面
是一扇月形门好象通往花厅，北面是大门，南面就是大堂了。

LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
清晨的星天界联盟曙色隐现，天边已现出乳白色，宽敞而干净的
街道阳光浅浅地透进去，里面一片灰蒙蒙的。这是进门后的一个
小院落。东面是一扇月形门好象通往花厅，北面是大门，南面就
是大堂了。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
午后时分，阳光普照，这是进门后的一个小院落。东面是一扇月
形门好象通往花厅，北面是大门，南面就是大堂了。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
下午的阳光洒进树丛，可以看到里面有些小鸟在窜来窜去，街道
边上的树影逐渐拉长，日渐西山了。这是进门后的一个小院落。
东面是一扇月形门好象通往花厅，北面是大门，南面就是大堂了。
LONG
        );
      else  //入夜
        set("long", @LONG
傍晚的阳光穿透树叶的缝隙，使街道看起来有些阴森。远处的炊
烟正在袅袅升起，是晚餐时分了。街道上的行人开始回家。这是
进门后的一个小院落。东面是一扇月形门好象通往花厅，北面是
大门，南面就是大堂了。
LONG
        );
    }
    return 0;
  }
}
