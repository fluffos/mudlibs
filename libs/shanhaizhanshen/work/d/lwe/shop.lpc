// Room: /d/village/shop.c
#include <room.h>
inherit ROOM;
int do_look(string arg);
void create()
{
        set("short", "杂货店");
	set("long", @LONG
这是一间小小的杂货店，经营些油、盐、酱、醋及日用百货，整
个星天界里的生活必需品，都是由这家小店供应的。
LONG
        );
        set("exits", ([
  "west" : __DIR__"jie4",
]));
        set("no_clean_up", 0);

        set("objects", ([
	                __DIR__"npc/zhahuo": 1
        ]) );
         set("doors", ([
		"west"	:	([
				"data"		:	"门",
				"other_side_dir":	"east",
			//	"status"	:	DOOR_LOCKED,
				"key_id"	:	"lwe/shop_key",
				]),]) );

        setup();
        
}
 
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
月亮慢慢升到天中，这是一间小小的杂货店，经营些油、盐、酱、
醋及日用百货，整个星天界里的生活必需品，都是由这家小店供
应的。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
清晨的星天界曙色隐现，天边已现出乳白色，这是一间小小的杂
货店，经营些油、盐、酱、醋及日用百货，整个星天界里的生活
必需品，都是由这家小店供应的。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
午后时分，阳光照在这间小小的杂货店，店主经营些油、盐、酱、
醋及日用百货，整个星天界里的生活必需品，都是由这家小店供应的。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
下午的阳光洒进杂货店，店主经营些油、盐、酱、醋及日用百货，
整个星天界里的生活必需品，都是由这家小店供应的。
LONG
);
			else//入夜
				set("long",@LONG
城中的炊烟正在袅袅升起，是晚餐时分了。街道上劳累了一天的
行人开始回家，顺便到店里买上一些要用的杂货。一天中也只有
在这个时候，店里的生意才是最好。
LONG
);
		}
		return 0;
	}
}


