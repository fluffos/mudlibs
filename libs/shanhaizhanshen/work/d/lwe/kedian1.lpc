// Room: /lwe/kedian.c
// neva 2002/4/28 

inherit ROOM;
int do_look(string arg);

void create() {
  set("short", "梦旅馆大厅");
  set("long", @LONG
这是星天界远近闻名的梦旅馆，生意非常兴隆。外地游客多选择
在这里落脚，你可以在这里打听到当地的风土人情。服务员里里
外外忙得团团转，接待着南腔北调的客人。墙上挂着一个牌子(paizi)。
LONG
  );
  set("detail/paizi", @DETAIL
   楼上雅房，每夜二十枚银币。
DETAIL
  );



  set("objects", ([
    __DIR__ "npc/bartender": 1,

    __DIR__ "npc/xiaoer2": 1,
  ]));

  set("exits", ([
    "south": __DIR__ "jie2",
    "up": __DIR__ "zodao",
  ]));

  setup();
}
void init() {
  add_action("do_look", "look");
}
int valid_leave(object me, string dir) {

  if (!me->query_temp("rent_paid") && dir == "up")
    return notify_fail("这位客人，您要付了钱才能上去啊！\n");
  return ::valid_leave(me, dir);
}

//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
月亮慢慢升到天中，夜色如水，旅馆中的客人已进入梦乡，只听
到屋外树上的小鸟时而不时的啾鸣几声，这里到处都散发着安祥
宁静的气氛。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
清晨的阳光浅浅地透进去，周围一片灰蒙蒙的。早起的客人已经
结帐离开了。服务员正在准备客人要的早餐，忙碌的一天又开始了。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
午后时分，阳光普照，南来北往的客人络绎不绝的进来投宿。晚
起的客人也起床离开了。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
下午的阳光洒进屋前的树丛，可以看到里面有些小鸟在窜来窜去，
街道边上的树影逐渐拉长，日渐西山了。服务员开始为晚上到来
的客人准备丰盛的晚餐。
LONG
        );
      else  //入夜
        set("long", @LONG
傍晚的阳光穿透树叶的缝隙，使街道看起来有些阴森。厨房的炊
烟正在袅袅升起，是晚餐时分了。来投宿的客人都聚集在大厅中
一边享用丰盛的晚餐一边高声谈论旅途中发生的趣事。
LONG
        );
    }
    return 0;
  }
}
