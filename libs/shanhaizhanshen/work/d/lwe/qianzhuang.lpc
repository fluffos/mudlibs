  本钱庄提供以下服务：
      存钱        deposit或者cun
      取钱        withdraw或者qu
      钱币兑换    convert或者duihuan
      查帐        check或者chazhang
DETAIL
  );
  set("exits", ([
    "north": __DIR__ "jie13",
  ]));

  set("objects", ([
    "obj/npc/lost": 1,


  ]));

  setup();

}
void init() {
  add_action("do_look", "look");
}
