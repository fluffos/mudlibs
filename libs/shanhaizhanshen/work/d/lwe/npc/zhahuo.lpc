      "open door",
    }),
    "6": ({ "w",
      "w",

    }),
    "7": ({ "say 开门做生意啦！！！",
      "",
    }),
    "8": ({ "",
      "",
    }),
    "9": ({ "",
      "",
    }),
    "10": ({ "",
      "",
    }),
    "11": ({ "",
      "",
