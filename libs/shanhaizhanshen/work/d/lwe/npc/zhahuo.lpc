inherit NPC;

inherit F_DEALER;
void prepare_kill();



void create() {
  set_name("杂货老板", ({ "zhahuo", "lwe zhahuo" }));
  set("title", "商人");
  set("gender", "男性");
  set("age", 25 + random(5) + 10 + random(5));

  set("long", @LONG
他长得丰神俊朗，长身玉立，宛如玉树临风，正忙着招呼客人。   
LONG
  );
  set("str", 5 + random(5) + random(5));  //力量 (str):	5 ~ 15
  set("dex", 6 + random(5) + random(8));  //敏捷 (dex):	6 ~ 19
  set("int", 5 + random(5) + random(5) + random(5) + random(3));  //智力 (int):	5 ~ 23
  set("not", 4 + random(5) + random(4) + 2 + random(3));  //注意 (not):	4 ~ 18
  set("con", 7 + random(5) + random(5));  //体质 (con):	7 ~ 17
  set("tec", 2 + random(5) + 6 + random(5) + 4);  //技术 (tec):	2 ~ 22
  set("level", 20 + random(10) + random(10));
  set("combat_exp", 60000 + random(50000) + 30000 + random(100000));
  set("attitude", "friendly");

  set("score", 20 + random(7) + 3 + random(10));




  set("home_time", ([
