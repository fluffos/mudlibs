  setup();

  add_money("gold", 1 + random(5) + 6 + random(5) + 9);
  add_money("silver", 10 + random(5) + 6 + random(5) + 9);
  add_money("copper", 10 + random(5) + 6 + random(5) + 9);
  carry_object("/obj/move/dfly")->wear();
  carry_object("/obj/wear/pants")->wear();
