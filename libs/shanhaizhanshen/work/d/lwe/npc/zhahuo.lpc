    "21": ({ "say 本日营业到此为止。\n",
      "say 各位明日请早。",
    }),
    "22": ({ "close door",
      "lock west with key of zhahuo",
    }),
    "23": ({ "close door",
      "lock west with key of zhahuo",
    }),
  ]));
  set("mob_program_delay", ([
    "1": ({ 5, 2,
    }),
    "2": ({ 5, 2,
    }),
    "3": ({ 5, 2,
