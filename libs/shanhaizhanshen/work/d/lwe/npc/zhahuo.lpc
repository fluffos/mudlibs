void init() {
  add_action("do_list", "list");
  add_action("do_buy", "buy");
  add_action("do_sell", "sell");


}

void die() {
  message_vision("\n$N死了。\n", this_object());
  destruct(this_object());
}


void prepare_kill() {
  if (query_temp("pending/prepare_kill")) return;

  command("wield dagger");
  command("say 哼 ! 你这个杀人的凶手 !!");
  set_temp("pending/prepare_kill", 1);
}
void kill_ob(object ob) {
  ob->remove_killer(this_object());
  remove_killer(ob);
  message_vision(" 杂货老板突然大呵一声“魔神召来，元神合体”。                  
             ''`''.
         .-./ _=_ \.-.
        {  (,(oYo),) }}
        {{ +   `   +} }
        { { \\(---)/  }}
        {{  }'-=-'{ } }
        { { }._1_.{  }}
        {{  } -1- { } }
        {_{ }`===`{  _}
       ((((\)     (/))))

\n", ob);
  message_vision("杂货老板在你眼前化身为一只巨兽！！！！\n
	巨兽一记重拳向你打来，“轰”。\n", ob);
}
