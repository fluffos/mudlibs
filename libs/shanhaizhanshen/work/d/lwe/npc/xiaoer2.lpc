void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
 
}
int accept_object(object who, object ob)
{
	
	if (ob->query("money_id") && ob->value() >= 2000) 
	{
		tell_object(who, "袁红绡一哈腰，说道：多谢您老，客官请上楼歇息。\n");

		who->set_temp("rent_paid",1);

		return 1;
	}

	return 0;
}

void greeting(object ob)
{
        string time,respect;
        if( !ob || environment(ob) != environment() ) return;
        time=NATURE_D->room_event_fun();        // 这里调用了他
        respect=RANK_D->query_respect(ob);
        switch(time) {                          //根据时间的不同说不同的话
                case "event_dawn":
                        message_vision("$N笑着对$n说道:这位" + respect
                + ",天快亮了，您是要住宿还是要用膳啊？\n", this_object(),ob);  
                        break;
                case "event_sunrise":
                        message_vision("$N笑着对$n说道:这位" + respect
                + ",今儿可真早啊，小店全天候营业,欢迎光临。\n", this_object(),ob);        
                        break;
                case "event_morning":
                        message_vision("$N笑着对$n说道:这位" + respect
                + ",今早精神好啊，欢迎光临。\n", this_object(),ob);     
                        break;
                case "event_noon":
                        message_vision("$N笑着对$n说道:这位" + respect
                + ",用过午饭了吗?快请坐。\n", this_object(),ob);        
                        break;
                case "event_afternoon":
                        message_vision("$N笑着对$n说道:这位" + respect
                + ",快请坐,待会一起用晚餐吧。\n", this_object(),ob);    
                        break;
                case "event_evening":
                        message_vision("$N笑着对$n说道:这位" + respect
                + ",天黑了,还是来小店歇歇吧,这一整天可怪累的。\n", this_object(),ob);
        
                        break;
                case "event_night":
                        message_vision("$N笑着对$n说道:这位" + respect
                + ",楼上请，有上好客房。\n", this_object(),ob);  
                        break;
                case "event_midnight":
                        message_vision("$N笑着对$n说道:这位" + respect
                + ",里面请。\n", this_object(),ob); 
                        break;
        }
}
void kill_ob(object ob)
{
	ob->remove_killer(this_object());
	remove_killer(ob);
	message_vision("李孟哲突然大呵一声“魔神召来，元神合体”。                  
             ''`''.
         .-./ _=_ \.-.
        {  (,(oYo),) }}
        {{ +   `   +} }
        { { \\(---)/  }}
        {{  }'-=-'{ } }
        { { }._1_.{  }}
        {{  } -1- { } }
        {_{ }`===`{  _}
       ((((\)     (/))))

\n", ob);
	message_vision("李孟哲在你眼前化身为一只巨兽！！！！\n
	巨兽一记重拳向你打来，“轰”。\n", ob);
}