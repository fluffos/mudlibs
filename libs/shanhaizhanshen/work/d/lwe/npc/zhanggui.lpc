void kill_ob(object ob)
{
	ob->remove_killer(this_object());
	remove_killer(ob);
	message_vision(" 冼老板突然大呵一声“魔神召来，元神合体”。                  
             ''`''.
         .-./ _=_ \.-.
        {  (,(oYo),) }}
        {{ +   `   +} }
        { { \\(---)/  }}
        {{  }'-=-'{ } }
        { { }._1_.{  }}
        {{  } -1- { } }
        {_{ }`===`{  _}
       ((((\)     (/))))

\n", ob);
	message_vision("冼老板在你眼前化身为一只巨兽！！！！\n
	巨兽一记重拳向你打来，“轰”。\n", ob);
}




