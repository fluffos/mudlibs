// fu-huating 花厅
// By Lgg,1998.10

inherit ROOM;

void create()
{
        set("short", "花厅");
        set("long", @LONG
这里是喝酒赏月的所在，一个小亭子建造在厅的中央，四周围绕
着一些葡萄藤(teng)。一阵微风吹过，空气中似乎有隐隐的花香
飘来，中人欲醉。
LONG
        );
        set("outdoors", "out");
        set("exits", ([
                "south" : __DIR__"fu-ceting",
                "west" : __DIR__"fu-xiaoyuan",
        ]));
        set("no_clean_up", 0);
        set("item_desc", ([
            "teng": "这些藤好象长得有些日子了，密不透风，夏天呆在藤下肯定阴凉极了。\n"
        ]) );
        setup();
        
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
月亮慢慢升到天中，夜色如水，这里是喝酒赏月的所在，一个小
亭子建造在厅的中央，四周围绕着一些葡萄藤(teng)。一阵微风
吹过，空气中似乎有隐隐的花香飘来，中人欲醉。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
清晨的星天界联盟曙色隐现，天边已现出乳白色，宽敞而干净的
街道阳光浅浅地透进去，里面一片灰蒙蒙的。这里是喝酒赏月的
所在，一个小亭子建造在厅的中央，四周围绕着一些葡萄藤(teng)。
一阵微风吹过，空气中似乎有隐隐的花香飘来，中人欲醉。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
午后时分，阳光普照，这里是喝酒赏月的所在，一个小亭子建造
在厅的中央，四周围绕着一些葡萄藤(teng)。一阵微风吹过，空
气中似乎有隐隐的花香飘来，中人欲醉。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
下午的阳光洒进树丛，可以看到里面有些小鸟在窜来窜去，街道
边上的树影逐渐拉长，日渐西山了。这里是喝酒赏月的所在，一
个小亭子建造在厅的中央，四周围绕着一些葡萄藤(teng)。一阵
微风吹过，空气中似乎有隐隐的花香飘来，中人欲醉。
LONG
);
			else//入夜
				set("long",@LONG
傍晚的阳光穿透树叶的缝隙，使街道看起来有些阴森。远处的炊
烟正在袅袅升起，是晚餐时分了。街道上的行人开始回家。这里
是喝酒赏月的所在，一个小亭子建造在厅的中央，四周围绕着一
些葡萄藤(teng)。一阵微风吹过，空气中似乎有隐隐的花香飘来，
中人欲醉。
LONG
);
		}
		return 0;
	}
}


