// Room: /d/city/jiulou.c


#include <room.h>
inherit ROOM;
int do_look(string arg);

void create()
{
	set("short", "星天界酒楼");
	set("long", @LONG
星天界酒楼大厅内一溜摆着几排木做的红漆桌子，桌上整齐地摆
放着碗筷，四周放着些椅子。一个酒保正在忙个不停。
LONG
	);

	set("exits", ([
		"south" : __DIR__"jie6",
	]));

	

	set("objects", ([
		__DIR__"npc/jiubao" : 1,
		__DIR__"npc/zhanggui" : 1,
	      
	]));
set("doors", ([
		"south"	:	([
				"data"		:	"门",
				"other_side_dir":	"north",
			//	"status"	:	DOOR_LOCKED,
				"key_id"	:	"lwe/jiulou_key",
				]),]) );

	setup();
	
}

void init()
{
        add_action("do_look", "look");
	
}


int do_look(string arg)
{
	object me = this_player();
	mixed *local;
    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
月亮慢慢升到天中，夜色如水，星天界酒楼大厅内一溜摆着几排
木做的红漆桌子，桌上整齐地摆放着碗筷，四周放着些椅子。一
个酒保正在打着呵欠，这个时间酒楼早打烊了要吃东西等明天早
上吧。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
清晨的星天界联盟曙色隐现，天边已现出乳白色，阳光浅浅地透
进去，星天界酒楼大厅内酒保勤快地招呼着客人。周围一溜摆着
几排木做的红漆桌子，桌上整齐地摆放着碗筷，四周放着些椅子。
一个酒保正在忙个不停。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
午后时分，阳光普照，星天界酒楼大厅内酒保正忙着收拾吃完的
桌子，好让下一位客人就坐。桌上整齐地摆放着碗筷，四周放着
些椅子。一个酒保正在忙个不停。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
街道边上的树影逐渐拉长，日渐西山了。一个酒保正在忙着摆好
几排木做的红漆桌子，在桌上整齐地摆放碗筷，四周放好椅子，
准备迎接来吃晚餐的客人。
LONG
);
			else//入夜
				set("long",@LONG
酒楼厨房里的炊烟正在袅袅升起，是晚餐时分了。星天界酒楼大
厅内一溜摆着几排木做的红漆桌子，桌上整齐地摆放着碗筷，四
周放着些椅子。一个酒保正在忙着招呼客人。
LONG
);
		}
		return 0;
	}
}


