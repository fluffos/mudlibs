  set("no_fight", 1);
  set("no_sleep_room", 1);


  set("item_desc", ([
    "paizi": "公平交易，老少无欺。\n",
  ]));
  set("objects", ([
    __DIR__ "npc/pablo": 1,
  ]));
  set("no_clean_up", 1);
  set("exits", ([
    "east": __DIR__ "jie12",
  ]));

  setup();

}

void init() {
  add_action("do_look", "look");
}
