// Room: /d/village/shop.c
#include <room.h>
inherit ROOM;
int do_look(string arg);
void create()
{
        set("short", "武器店");
	set("long", @LONG
这是一间小小的武器店，墙两边有两个兵器架，十八武器样样俱
全，墙角还散放着几个练力的石锤和一些杂物。
  _________________.---.______
 (_(______________(_o o_(____()
              .___.'. .'.___.
              \ o    Y    o /
               \ \__   __/ /
                '.__'-'__.'
                    '''
LONG
        );
        set("exits", ([
  "north" : __DIR__"jie9",
]));
        set("no_clean_up", 0);

        set("objects", ([
	                __DIR__"npc/wuqi": 1
        ]) );
         set("doors", ([
		"north"	:	([
				"data"		:	"门",
				"other_side_dir":	"south",
			//	"status"	:	DOOR_LOCKED,
				"key_id"	:	"lwe/shop1_key",
				]),]) );

        setup();
        
}
 
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
月亮慢慢升到天中，这是一间小小的武器店，墙两边有两个兵器
架，十八武器样样俱全，墙角还散放着几个练力的石锤和一些杂物。
  _________________.---.______
 (_(______________(_o o_(____()
              .___.'. .'.___.
              \ o    Y    o /
               \ \__   __/ /
                '.__'-'__.'
                    '''
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
清晨的星天界曙色隐现，天边已现出乳白色，这是一间小小的武
器店，墙两边有两个兵器架，十八武器样样俱全，墙角还散放着
几个练力的石锤和一些杂物。
  _________________.---.______
 (_(______________(_o o_(____()
              .___.'. .'.___.
              \ o    Y    o /
               \ \__   __/ /
                '.__'-'__.'
                    '''
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
午后时分，阳光照在这间小小的武器店，墙两边有两个兵器架，
十八武器样样俱全，墙角还散放着几个练力的石锤和一些杂物。
  _________________.---.______
 (_(______________(_o o_(____()
              .___.'. .'.___.
              \ o    Y    o /
               \ \__   __/ /
                '.__'-'__.'
                    '''
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
下午的阳光洒进杂货店，店主经营这些武器，可以方便城里的冒
险者和士兵来购买，因此生意也不错。
  _________________.---.______
 (_(______________(_o o_(____()
              .___.'. .'.___.
              \ o    Y    o /
               \ \__   __/ /
                '.__'-'__.'
                    '''
LONG
);
			else//入夜
				set("long",@LONG
城中的炊烟正在袅袅升起，是晚餐时分了。看来今天没什么人来
了。这是一间小小的武器店，墙两边有两个兵器架，十八武器样
样俱全，墙角还散放着几个练力的石锤和一些杂物。
  _________________.---.______
 (_(______________(_o o_(____()
              .___.'. .'.___.
              \ o    Y    o /
               \ \__   __/ /
                '.__'-'__.'
                    '''
LONG
);
		}
		return 0;
	}
}


