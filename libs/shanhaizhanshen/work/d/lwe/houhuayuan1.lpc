// houhuayuan1.c 后花园
// By Lgg,1998.10

inherit ROOM;

void create()
{
        set("short", "后花园");
        set("long", @LONG
这是后花园，这里有一片小池塘，养着一些金鱼之类。池塘边立
着一座假山，山上长满了花草。
LONG
        );
        set("outdoors", "out");
        set("exits", ([
                "west" : __DIR__"houhuayuan",
        ]));
        

        setup();
       
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
月亮慢慢升到天中，夜色如水，这是后花园，这里有一片小池塘，
养着一些金鱼之类。池塘边立着一座假山，山上长满了花草。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
清晨的星天界联盟曙色隐现，天边已现出乳白色，宽敞而干净的
街道阳光浅浅地透进去，里面一片灰蒙蒙的。这是后花园，这里
有一片小池塘，养着一些金鱼之类。池塘边立着一座假山，山上
长满了花草。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
午后时分，阳光普照，这是后花园，这里有一片小池塘，养着一
些金鱼之类。池塘边立着一座假山，山上长满了花草。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
下午的阳光洒进树丛，可以看到里面有些小鸟在窜来窜去，街道
边上的树影逐渐拉长，日渐西山了。这是后花园，这里有一片小
池塘，养着一些金鱼之类。池塘边立着一座假山，山上长满了花
草。
LONG
);
			else//入夜
				set("long",@LONG
傍晚的阳光穿透树叶的缝隙，使街道看起来有些阴森。远处的炊
烟正在袅袅升起，是晚餐时分了。街道上的行人开始回家。这是
后花园，这里有一片小池塘，养着一些金鱼之类。池塘边立着一
座假山，山上长满了花草。
LONG
);
		}
		return 0;
	}
}


