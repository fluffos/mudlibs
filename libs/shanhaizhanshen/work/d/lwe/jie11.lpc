#include <room.h>
inherit ROOM;

int do_look(string arg);


void create()
{
	set("short","街道");
	set("long",@LONG
星天界的街道宽敞而干净，白色岩石铺的路面被雨水冲得光明如
镜，街道两侧的砖房高大而宏伟。双人合抱的巨树整齐的排在两
边。只听到树上的小鸟时而不时的啾鸣几声，这里到处都散发着
安祥宁静的气氛。东边是一家专卖防具的商店。
                               |\ 
                                 |\\ 
                                 | \\ 
              -----/|------------|--\-------------- 
                  //|          (_)  |    |\    | 
              ----//|--|----------(_)----|-----|-------- 
                  / |  |                _|    _| 
              ----|.'-_|---|-----------(_)---(_)--- 
                 .   (_)   |             `-.-' 
              ------------_|----------------------------- 
                         (_) 
              ------------------------------------------ 

LONG
);
	set("exits",([
		"east" : __DIR__"shop2",
		"north" : __DIR__"jie10",
		
		"south" : __DIR__"jie12",
	]) );
	set("outdoors","lwe");
	set("no_clean_up",0);
	  set("doors", ([
		"east"	:	([
				"data"		:	"",
				"other_side_dir":	"west",
			//	"status"	:	DOOR_LOCKED,
				"key_id"	:	"lwe/shop2_key",
				]),
				]) );

        
	setup();
}

void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
月亮慢慢升到天中，夜色如水，星天界的街道宽敞而干净，白色
岩石铺的路面在月光下光亮如镜，街道两侧的砖房高大而宏伟。
双人合抱的巨树整齐的排在两边。只听到树上的小鸟时而不时的
啾鸣几声，这里到处都散发着安祥宁静的气氛。东边是一家专卖
防具的商店。
                               |\ 
                                 |\\ 
                                 | \\ 
              -----/|------------|--\-------------- 
                  //|          (_)  |    |\    | 
              ----//|--|----------(_)----|-----|-------- 
                  / |  |                _|    _| 
              ----|.'-_|---|-----------(_)---(_)--- 
                 .   (_)   |             `-.-' 
              ------------_|----------------------------- 
                         (_) 
              ------------------------------------------ 

LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
清晨的星天界联盟曙色隐现，天边已现出乳白色，宽敞而干净的
街道阳光浅浅地透进去，里面一片灰蒙蒙的。街道两侧的砖房高
大而宏伟。双人合抱的巨树整齐的排在两边。只听到树上的小鸟
时而不时的啾鸣几声，这里到处都散发着安祥宁静的气氛。东边
是一家专卖防具的商店。
                               |\ 
                                 |\\ 
                                 | \\ 
              -----/|------------|--\-------------- 
                  //|          (_)  |    |\    | 
              ----//|--|----------(_)----|-----|-------- 
                  / |  |                _|    _| 
              ----|.'-_|---|-----------(_)---(_)--- 
                 .   (_)   |             `-.-' 
              ------------_|----------------------------- 
                         (_) 
              ------------------------------------------ 

LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
午后时分，阳光普照，白色岩石铺的路面在阳光下明亮如镜，街
道两侧的砖房高大而宏伟。双人合抱的巨树整齐的排在两边。只
听到树上的小鸟时而不时的啾鸣几声，这里到处都散发着安祥宁
静的气氛。东边是一家专卖防具的商店。
                                 |\ 
                                 |\\ 
                                 | \\ 
              -----/|------------|--\-------------- 
                  //|          (_)  |    |\    | 
              ----//|--|----------(_)----|-----|-------- 
                  / |  |                _|    _| 
              ----|.'-_|---|-----------(_)---(_)--- 
                 .   (_)   |             `-.-' 
              ------------_|----------------------------- 
                         (_) 
              ------------------------------------------ 

LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
下午的阳光洒进树丛，可以看到里面有些小鸟在窜来窜去，街道
边上的树影逐渐拉长，日渐西山了。东边是一家专卖防具的商店。
  ,_
  >' )
  ( ( \
   ''|\
  ,_
  >' )
  ( ( \
   ''|\

LONG
);
			else//入夜
				set("long",@LONG
傍晚的阳光穿透树叶的缝隙，使街道看起来有些阴森。远处的炊
烟正在袅袅升起，是晚餐时分了。街道上的行人开始回家。东边
是一家专卖防具的商店。
LONG
);
		}
		return 0;
	}
}


