inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "客房");
  set("long", @LONG
这里是梦旅馆的客房。你如果累了可以在床上舒舒服服地睡一觉。

          ()___
        ()//__/)_________________()
        ||(___)//#/_/#/_/#/_/#()/||
        ||----|#| |#|_|#|_|#|_|| ||
        ||____|_|#|_|#|_|#|_|#||/||
        ||    |#|_|#|_|#|_|#|_||

LONG);
  set("sleep_room", "1");
  set("no_fight", "1");

  set("exits", ([
    "east": __DIR__ "zodao",
  ]));

  set_temp("full", 0);
  setup();

}
void init() {
  add_action("do_look", "look");

}

//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。

int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
月亮慢慢升到天中，夜色如水，客房中的客人已进入梦乡，只听
到疲累的客人传来了呼噜声。

          ()___
        ()//__/)_________________()
        ||(___)//#/_/#/_/#/_/#()/||
        ||----|#| |#|_|#|_|#|_|| ||
        ||____|_|#|_|#|_|#|_|#||/||
        ||    |#|_|#|_|#|_|#|_||
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
清晨的阳光浅浅地透进去，周围一片灰蒙蒙的。走道上传来早起
客人的脚步声。楼下的服务员正在准备客人要的早餐，忙碌的一
天又开始了。
        ||
        ||                   ||
     ||/||___                ||
     || /`   )____________||_/|
     ||/___ //_/_/_/_/_/_/||/ |
     ||(___)/_/_/_/_/_/_/_||  |
     ||     |_|_|_|_|_|_|_|| /|
     ||     | | | | | | | ||/||
     ||~~~~~~~~~~~~~~~~~~~||
     ||                   ||
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
午后时分，窗外阳光普照，南来北往的客人络绎不绝的进来投宿。
晚起的客人也起床离开了。

          ()___
        ()//__/)_________________()
        ||(___)//#/_/#/_/#/_/#()/||
        ||----|#| |#|_|#|_|#|_|| ||
        ||____|_|#|_|#|_|#|_|#||/||
        ||    |#|_|#|_|#|_|#|_||
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
下午的阳光洒进屋前的树丛，可以看到里面有些小鸟在窜来窜去，
街道边上的树影逐渐拉长，日渐西山了。服务员开始为晚上到来
的客人准备丰盛的晚餐。

          ()___
        ()//__/)_________________()
        ||(___)//#/_/#/_/#/_/#()/||
        ||----|#| |#|_|#|_|#|_|| ||
        ||____|_|#|_|#|_|#|_|#||/||
        ||    |#|_|#|_|#|_|#|_||
LONG
        );
      else  //入夜
        set("long", @LONG
傍晚的阳光穿透窗边的缝隙，使街道看起来有些阴森。厨房的炊
烟正在袅袅升起，是晚餐时分了。来投宿的客人都下到大厅中享
用丰盛的晚餐了。

        ||
        ||                   ||
     ||/||___                ||
     || /`   )____________||_/|
     ||/___ //_/_/_/_/_/_/||/ |
     ||(___)/_/_/_/_/_/_/_||  |
     ||     |_|_|_|_|_|_|_|| /|
     ||     | | | | | | | ||/||
     ||~~~~~~~~~~~~~~~~~~~||
     ||                   ||
LONG
        );
    }
    return 0;
  }
}
