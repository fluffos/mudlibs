// Room: /d/shenmin/chufang.c

inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "素斋厅");
	set("long", @LONG
这是寺庙中的大小僧人用餐的地方，当然龙皇的素斋是专门有人送过
去的，平时龙皇寺的僧人听钟吃饭，等他们吃完了，也经常把剩下的
素斋舍给穷人吃。
LONG
	);
	set("objects", ([
		__DIR__"npc/food" : 1,
                	]));
	set("exits", ([ /* sizeof() == 2 */
  "north" : __DIR__"chufang2",
  "west" : __DIR__"zhongyuan",
]));
	set("no_clean_up", 0);
	

	setup();
	
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;

    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
半夜了，素斋厅周围静悄悄的。这是寺庙中的大小僧人用餐的地
方，当然龙皇的素斋是专门有人送过去的，平时龙皇寺的僧人听
钟吃饭，等他们吃完了，也经常把剩下的素斋舍给穷人吃。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
曙色隐现，天边已现出乳白色，素斋厅里寺庙中的大小僧人都在
用餐，当然龙皇的素斋是专门有人送过去的，平时龙皇寺的僧人
听钟吃饭，等他们吃完了，也经常把剩下的素斋舍给穷人吃。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
正午的钟声刚响过，寺庙中的大小僧人开始聚集到素斋厅来。伙
头僧正忙着把午饭分给僧众。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
下午的阳光柔和了不少，素斋厅周围静悄悄的。素斋厅里寺庙中
的大小僧人都在用餐，当然龙皇的素斋是专门有人送过去的，平
时龙皇寺的僧人听钟吃饭，等他们吃完了，也经常把剩下的素斋
舍给穷人吃。
LONG
);
			else//晚餐时候
				set("long",@LONG
夕阳西下，天边抹上了一笔瑰丽的晚霞。素斋厅里寺庙中的大小
僧人都在用餐，当然龙皇的素斋是专门有人送过去的，平时龙皇
寺的僧人听钟吃饭，等他们吃完了，也经常把剩下的素斋舍给穷
人吃。
LONG
);
		}
		return 0;
	}
}


