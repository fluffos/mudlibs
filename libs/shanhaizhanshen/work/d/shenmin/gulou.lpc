// Room: /d/shenmin/gulou.c

inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "鼓楼");
	set("long", @LONG
一座木结构的小亭阁楼，上层摆了个大鼓，是寺庙内每天晨钟暮
鼓时所用。有一条小楼梯通向前院。阁楼的四角挂着铁马，风摆
摇动。分外动听。
LONG
	);
	set("no_clean_up", 0);
	set("objects", ([
		__DIR__"npc/gu" : 1,
                	]));
	set("exits", ([ /* sizeof() == 1 */
  "westdown" : __DIR__"qianyuan",
]));
	set("outdoors", "/d/kaifeng");

	setup();
	
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;

    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
半夜了，周围静悄悄的，大家都沉浸在梦乡之中。这是一座木结
构的小亭阁楼，上层摆了个大鼓，是寺庙内每天晨钟暮鼓时所用。
有一条小楼梯通向前院。阁楼的四角挂着铁马，风摆摇动。分外
动听。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
清晨的空气传来花香的味道，阳光浅浅地洒进鼓楼。这是一座木
结构的小亭阁楼，上层摆了个大鼓，是寺庙内每天晨钟暮鼓时所
用。有一条小楼梯通向前院。阁楼的四角挂着铁马，风摆摇动。
分外动听。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
正午的阳光从窗外照了进来。这是一座木结构的小亭阁楼，上层
摆了个大鼓，是寺庙内每天晨钟暮鼓时所用。有一条小楼梯通向
前院。阁楼的四角挂着铁马，风摆摇动。分外动听。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
下午的阳光洒在大鼓上，这是一座木结构的小亭阁楼，上层摆了
个大鼓，是寺庙内每天晨钟暮鼓时所用。有一条小楼梯通向前院。
阁楼的四角挂着铁马，风摆摇动。分外动听。
LONG
);
			else//晚餐时候
				set("long",@LONG
最后一抹阳光从大鼓上消失，这是一座木结构的小亭阁楼，上层
摆了个大鼓，是寺庙内每天晨钟暮鼓时所用。有一条小楼梯通向
前院。阁楼的四角挂着铁马，风摆摇动。分外动听。
LONG
);
		}
		return 0;
	}
}


