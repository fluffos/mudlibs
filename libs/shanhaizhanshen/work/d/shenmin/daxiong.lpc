// Room: /d/shenmin/daxiong.c

inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "大雄宝殿");
	set("long", @LONG
经过九级石头台阶，正面就是龙皇的神像。高大的神像几乎挨到
了屋顶，令人凌然生威。正对着门的地方摆着供桌，上面是时鲜的瓜
果。供桌两边的大蜡烛比人还高。

