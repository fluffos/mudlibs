                 -###################\\/      \//###################-
                _#/|##########/\######(   /\   )######/\##########|\#_
                |/ |#/\#/\#/\/  \#/\##\  |  |  /##/\#/  \/\#/\#/\#| \|
                `  |/  V  V  `   V  \#\| |  | |/#/  V   '  V  V  \|  '
                   `   `  `      `   / | |  | | \   '      '  '   '
                                    (  | |  | |  )
                                   __\ | |  | | /__
                                  (vvv(VVV)(VVV)vvv)
LONG
	);
set("valid_startroom",1);
	
	set("no_clean_up", 0);
	set("exits", ([ /* sizeof() == 2 */
  "south" : __DIR__"zhongyuan",
  "north" : __DIR__"houyuan",
]));

	setup();
	
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
