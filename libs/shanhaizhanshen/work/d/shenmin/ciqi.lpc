// Room: /d/shenmin/ciqi.c

inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "雅琪轩");
	set("long", @LONG
雅琪轩是间出售瓷器的商店，其间也出售些书画精品。你瞧了一
下，店铺中四面木架子上大小各类的瓷器，大多是富贵人家用的。
象粗瓷，粗碗之类东西，只能从地摊买了。
       ,-"-.
    _r-----i          _
    \      |-.      ,###.
     |     | |    ,-------.
     |     | |   c|       |                       ,--.
     |     |'     |       |      _______________ C|  |
     (=====)      =========      \_____________/  `=='   
(HHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHH)
LONG
	);
	
	set("no_clean_up", 0);
	set("exits", ([ 
  "west" : __DIR__"road3",
]));

	setup();
	
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;

    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
半夜了，周围静悄悄的，大家都沉浸在梦乡之中。雅琪轩是间出
售瓷器的商店，其间也出售些书画精品。你瞧了一下，店铺中四
面木架子上大小各类的瓷器，大多是富贵人家用的。象粗瓷，粗
碗之类东西，只能从地摊买了。
