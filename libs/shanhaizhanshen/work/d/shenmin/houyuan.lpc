// Room: /d/shenmin/houyuan.c

inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "后院");
	set("long", @LONG
后院之中绿荫如云。许多树木下设有石凳，供人休息。正中的一
个大铁香炉中香烟袅袅。东面是藏经楼,北面是琉璃殿。
LONG
	);
	set("no_clean_up", 0);
	set("exits", ([ /* sizeof() == 4 */
  
  "east" : __DIR__"cangjing",
  "north" : __DIR__"8bao",
  "south" : __DIR__"daxiong",
]));
	set("outdoors", "/d/shenmin");

	setup();
	
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;

    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
周围静悄悄的，已经半夜了，大家都沉浸在梦乡之中。后院之中
绿荫如云。许多树木下设有石凳，供人休息。正中的一个大铁香
炉中香烟袅袅。东面是藏经楼,北面是琉璃殿。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
清晨的空气传来花香的味道，阳光浅浅地洒进院子，后院之中绿
荫如云。许多树木下设有石凳，供人休息。正中的一个大铁香炉
中香烟袅袅。东面是藏经楼,北面是琉璃殿。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
正午的阳光透过树荫洒在石凳上。院子正中的一个大铁香炉中香
烟袅袅。东面是藏经楼,北面是琉璃殿。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
下午的阳光洒进了院子，香炉的烟在阳光中袅袅升起。后院之中
绿荫如云，许多树木下设有石凳，供人休息。东面是藏经楼北面
是琉璃殿。
LONG
);
			else//晚餐时候
				set("long",@LONG
最后一抹阳光从香炉上消失，已经入夜了。后院之中绿荫如云。
许多树木下设有石凳，供人休息。正中的一个大铁香炉中香烟袅
袅。东面是藏经楼,北面是琉璃殿。
LONG
);
		}
		return 0;
	}
}


