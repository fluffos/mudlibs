// Room: /d/shenmin/qianyuan.c

inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "前院");
	set("long", @LONG
一带粉成黄色的围墙圈起这个院子，一条青石道通向北面的天王
殿，南面就是龙皇寺的大门，东边一座高楼是鼓楼，西面是钟楼。
LONG
	);
	set("no_clean_up", 0);
	set("exits", ([ /* sizeof() == 4 */
  "south" : __DIR__"xianguosi",
  "north" : __DIR__"tianwang",
  "eastup" : __DIR__"gulou",
  "west" : __DIR__"zhonglou",
]));
	set("outdoors", "/d/shenmin");

	setup();
	
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;

    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
半夜了，周围静悄悄的，大家都沉浸在梦乡之中。一条青石道通
向北面的天王殿，南面就是龙皇寺的大门，东边一座高楼是鼓楼，
西面是钟楼。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
清晨的空气传来花香的味道，阳光浅浅地洒进院子，一条青石道
通向北面的天王殿，南面就是龙皇寺的大门，东边一座高楼是鼓
楼，西面是钟楼。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
正午的阳光照在粉成黄色的围墙，热气从地面不断的升起。一条
青石道通向北面的天王殿，南面就是龙皇寺的大门，东边一座高
楼是鼓楼，西面是钟楼。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
下午的阳光洒进了粉成黄色的围墙，围墙圈起这个院子，一条青
石道通向北面的天王殿，南面就是龙皇寺的大门，东边一座高楼
是鼓楼，西面是钟楼。
LONG
);
			else//晚餐时候
				set("long",@LONG
最后一抹阳光从粉成黄色的围墙上消失，一条青石道通向北面的
天王殿，南面就是龙皇寺的大门，东边一座高楼是鼓楼，西面是
钟楼。
LONG
);
		}
		return 0;
	}
}


