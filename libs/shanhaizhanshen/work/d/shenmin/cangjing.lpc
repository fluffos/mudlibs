// Room: /d/shenmin/cangjing.c

inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "藏经楼");
	set("long", @LONG
藏经楼中都是龙皇城武学经典，名贵稀少的都用檀木盒盛放了。
收藏在楼上，派有专人职司。你满眼看去，到处是高低的书架。
LONG
	);
	
	set("no_clean_up", 0);
	set("objects", ([
		__DIR__"npc/jing" : 1,
 
	]));
	set("exits", ([ /* sizeof() == 3 */
  "west" : __DIR__"houyuan",
  
  "east" : __DIR__"xiaoyuan",
]));

	setup();
	
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;

    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
周围静悄悄的，大家都沉浸在梦乡之中。藏经楼中都是龙皇城武
学经典，名贵稀少的都用檀木盒盛放了。收藏在楼上，派有专人
职司。你满眼看去，到处是高低的书架。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
清晨了，藏经楼中都是龙皇城武学经典，名贵稀少的都用檀木盒
盛放了。收藏在楼上，派有专人职司。你满眼看去，到处是高低
的书架。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
正午了，寺庙中的和尚会把收藏在盒中的武学经典放到外面去晒，
以防日久被虫子蛀了，用来晾晒武学经典的石头就称为晒经石，
据说有神力。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
下午寺庙中的和尚会把放到外面去晒的武学经典收藏回盒中，再
在小楼的四个角落中放着石灰包，用来吸收空气中的水份。
LONG
);
			else//晚餐时候
				set("long",@LONG
最后一抹阳光消失了，藏经楼中都是龙皇城武学经典，名贵稀少
的都用檀木盒盛放了。收藏在楼上，派有专人职司。你满眼看去，
到处是高低的书架。
LONG
);
		}
		return 0;
	}
}


