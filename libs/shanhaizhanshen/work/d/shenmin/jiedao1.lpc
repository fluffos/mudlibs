// Room: /d/shenmin/jiedao1.c

inherit ROOM;
int do_look(string arg);

void create() {
  set("short", "龙牙街");
  set("long", @LONG
这条道横贯南北，北到宣德门，南至南盈门，是龙牙城的主城道，
所以修得是格外平整。城道两边店铺不断。再向南一点就可以出
城了。
LONG
  );
  set("outdoors", "/d/shenmin");
  set("exits", ([
    "west": __DIR__ "jiedao",
    "east": __DIR__ "eroad",
    "south": __DIR__ "jiedao2",
  ]));
  set("no_clean_up", 0);

  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;

  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
现在是上半夜了，周围静悄悄的，大家都沉浸在梦乡之中。这条
城道横贯南北，北到宣德门，南至南盈门，是龙牙城的主城道，
所以修得是格外平整。城道两边店铺不断。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
清晨的空气混有一股花香的味道，阳光浅浅地洒进去，城道里面
一片灰蒙蒙的。这条城道横贯南北，北到宣德门，南至南盈门，
是龙牙城的主城道，所以修得是格外平整。城道两边店铺不断。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
正午的阳光照在城道上，热气从地面不断的升起。这条城道横贯
南北，北到宣德门，南至南盈门，是龙牙城的主城道，所以修得
是格外平整。城道两边店铺不断。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
下午的阳光洒进了城道，可以看到城里的人开始回家了，城道两
边房屋的影子逐渐拉长，日渐西山了。这条城道横贯南北，北到
宣德门，南至南盈门，是龙牙城的主城道，所以修得是格外平整。
城道两边店铺不断。
LONG
        );
      else  //晚餐时候
        set("long", @LONG
傍晚了，最后一抹阳光在地平线上消失，城道两边的店铺开始把
灯点亮。这条城道横贯南北，北到宣德门，南至南盈门，是龙牙
城的主城道，所以修得是格外平整。城道两边店铺不断。
LONG
        );
    }
    return 0;
  }
}
