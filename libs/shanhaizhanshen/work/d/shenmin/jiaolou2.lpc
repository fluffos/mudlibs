// Room: /d/shenmin/jiaolou2.c

inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "东角楼");
	set("long", @LONG
角楼是平时驻兵来守望的地方。只在楼的顶端挂了个气死风灯。
日夜有人值守。从此向西下是朱牙门，东下是东大街，你眺目远
处。湖泊，楼阁，真是大好江山。
LONG
	);
	set("no_clean_up", 0);
	set("objects", ([
		__DIR__"npc/shiwei4" : 1,
                
	]));
	set("exits", ([ /* sizeof() == 2 */
  "westdown" : __DIR__"zhuque",
  "eastdown" : __DIR__"eroad2",
]));
	set("outdoors", "/d/kaifeng");

	setup();
	
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;

    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
现在是半夜了，周围静悄悄的，大家都沉浸在梦乡之中。角楼的
卫兵守着楼顶端挂上的一盏气死风灯。从此向西下是朱牙门，东
下是东大街，你眺目远处。湖泊，楼阁，真是大好江山。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
清晨的空气混有一股花香的味道，阳光浅浅地洒在角楼，角楼是
平时驻兵来守望的地方。只在楼的顶端挂了个气死风灯。日夜有
人值守。从此向西下是朱牙门，东下是东大街，你眺目远处。湖
泊，楼阁，真是大好江山。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
正午的阳光照在角楼上，角楼是平是驻兵来守望的地方。只在楼
的顶端挂了个气死风灯。日夜有人值守。从此向西下是朱牙门，
东下是东大街，你眺目远处。湖泊，楼阁，真是大好江山。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
下午的阳光洒进了角楼，从角楼上可以看到街里的人开始回家了，
街道两边房屋的影子逐渐拉长，日渐西山了。当值的卫兵开始换
班了。LONG
);
			else//晚餐时候
				set("long",@LONG
傍晚了，最后一抹阳光在地平线上消失，街道两边的店铺开始把
灯点亮。角楼的卫兵守着楼顶端挂上的一盏气死风灯，从此向西
下是朱牙门，东下是东大街，你眺目远处。湖泊，楼阁，真是大
好江山。
LONG
);
		}
		return 0;
	}
}


