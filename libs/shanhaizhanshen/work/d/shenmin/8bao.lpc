// Room: /d/shenmin/8bao.c

inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "琉璃殿");
	set("long", @LONG
这座大殿相对于大雄殿来说要小得多，但却显得富丽精致无比，
大殿的檐面是用琉璃瓦铺的，四面的墙壁上都镂刻了龙牙城的故
事。
LONG
	);
	
	set("exits", ([ /* sizeof() == 2 */
  "south" : __DIR__"houyuan",
  "northdown" : __DIR__"road",
]));
	set("no_clean_up", 0);

	setup();

}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;

    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
半夜了，周围静悄悄的，大家都沉浸在梦乡之中。这座大殿相对
于大雄殿来说要小得多，但却显得富丽精致无比，大殿的檐面是
用琉璃瓦铺的，四面的墙壁上都镂刻了龙牙城的故事。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
清晨的阳光浅浅地洒在琉璃瓦上，这座大殿相对于大雄殿来说要
小得多，但却显得富丽精致无比，大殿的檐面是用琉璃瓦铺的，
四面的墙壁上都镂刻了龙牙城的故事。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
正午的阳光照在大殿上，热气从地面不断的升起。这座大殿相对
于大雄殿来说要小得多，但却显得富丽精致无比，大殿的檐面是
用琉璃瓦铺的，四面的墙壁上都镂刻了龙牙城的故事。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
下午的阳光洒在琉璃瓦上，这座大殿相对于大雄殿来说要小得多，
但却显得富丽精致无比，大殿的檐面是用琉璃瓦铺的，四面的墙
壁上都镂刻了龙牙城的故事。
LONG
);
			else//晚餐时候
				set("long",@LONG
傍晚了，最后一抹阳光在在琉璃瓦上消失，这座大殿相对于大雄
殿来说要小得多，但却显得富丽精致无比，大殿的檐面是用琉璃
瓦铺的，四面的墙壁上都镂刻了龙牙城的故事。
LONG
);
		}
		return 0;
	}
}


