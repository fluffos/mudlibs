// Room: /d/shenmin/chufang2.c

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "素斋厨");
  set("long", @LONG
素斋厨的几个大灶烧得正旺，白色的蒸汽在室顶铺了一层，灶膛
间摆满了松柴，和尚们很挑剔，说是用这种柴禾煮出的饭菜才近
佛。一边的桌上摆着一个饭桶，里面还有半桶稀饭。
LONG
  );

  set("no_clean_up", 0);
  set("objects", ([
    __DIR__ "npc/food1": 1,
  ]));
  set("exits", ([ /* sizeof() == 2 */
    "south": __DIR__ "chufang",

  ]));

  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;

  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
半夜了，素斋厨周围静悄悄的。几个大灶火已熄灭，灶膛间摆满
了松柴，和尚们很挑剔，说是用这种柴禾煮出的饭菜才近佛。一
边的桌上摆着一个饭桶，里面还有半桶稀饭。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
曙色隐现，天边已现出乳白色，素斋厨的几个大灶烧得正旺，白色
的蒸汽在室顶铺了一层，灶膛间摆满了松柴，和尚们很挑剔，说是
用这种柴禾煮出的饭菜才近佛。一边的桌上摆着一个饭桶，那是今
天的早饭。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
正午的阳光透过窗户照在灶前，素斋厨的几个大灶烧得正旺，白
色的蒸汽在室顶铺了一层，灶膛间摆满了松柴，和尚们很挑剔，
说是用这种柴禾煮出的饭菜才近佛。一边的桌上摆着一个饭桶，
那是今天的午饭。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
下午的阳光柔和了不少，素斋厨周围静悄悄的。几个大灶火已熄
灭，灶膛间摆满了松柴，和尚们很挑剔，说是用这种柴禾煮出的
饭菜才近佛。一边的桌上摆着一个饭桶，里面还有半桶中午吃剩
的稀饭。
LONG
        );
      else  //晚餐时候
        set("long", @LONG
夕阳西下，天边抹上了一笔瑰丽的晚霞。素斋厨的几个大灶烧得
正旺，白色的蒸汽在室顶铺了一层，灶膛间摆满了松柴，和尚们
很挑剔，说是用这种柴禾煮出的饭菜才近佛。一边的桌上摆着一
个饭桶，那是今天的晚饭。
LONG
        );
    }
    return 0;
  }
}
