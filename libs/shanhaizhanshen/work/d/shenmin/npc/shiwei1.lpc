// waiter.c
// 月影修改史巴克人物程序为动态NPC,在此叩谢.
inherit NPC;

void prepare_kill();
void create() {
  set_name("殷三", ({ "yin san" }));
  set("gender", "男性");
  set("title", "龙牙卫");
  set("age", 18);
  set("long",
    "殷三，龙皇寺的武僧。\n");
  set("str", 5 + random(5) + random(5));  //力量 (str):	5 ~ 15
  set("dex", 6 + random(5) + random(8));  //敏捷 (dex):	6 ~ 19
  set("int", 5 + random(5) + random(5) + random(5) + random(3));  //智力 (int):	5 ~ 23
  set("not", 4 + random(5) + random(4) + 2 + random(3));  //注意 (not):	4 ~ 18
  set("con", 7 + random(5) + random(5));  //体质 (con):	7 ~ 17
  set("tec", 2 + random(5) + 6 + random(5) + 4);  //技术 (tec):	2 ~ 22
  set("level", 20 + random(10) + random(10));
  set("combat_exp", 60000 + random(50000) + 30000 + random(100000));
  set("attitude", "friendly");

  set("score", 20 + random(7) + 3 + random(10));


  set("home_time", ([
    "8-21": "/d/shiwang/jubaoge.lpc",
  ]));
  set("mob_program", ([
    "0": ({ "north",
      "",
    }),
    "1": ({ "say 1",
      "south",
    }),
    "2": ({ "wake",
      "say 2",
    }),
    "3": ({ "say 3"
    }),
    "4": ({ "say 4",
      "west",
    }),
    "5": ({ "north",
      "east",
    }),
    "6": ({ "",
      "",
    }),
    "7": ({ "say 龙皇无敌！！！",
      "west",
    }),
    "8": ({ "west",
      "west",
    }),
    "9": ({ "west",
      "west",
    }),
    "10": ({ "say hi hi ",
      "",
    }),
    "11": ({ "say 11",
      "",
    }),
    "12": ({ "say 12",
      "",
    }),
    "13": ({ "say sdlkf",
      "",
    }),
    "14": ({ "say 14",
      "east",
    }),
    "15": ({ "say 15",
      "east",
    }),
    "16": ({ "say 16",
      "east",
    }),
    "17": ({ "say 17;say 17",
      "",
    }),
    "18": ({ "say 18",
      "",
    }),
    "19": ({ "say 19",
      "",
    }),
    "20": ({ "say 20",
      "",
    }),
    "21": ({ "say \n",
      "say ",
    }),
    "22": ({ "",
      "",
    }),
    "23": ({ "",
      "",
    }),
  ]));
  set("mob_program_delay", ([
    "1": ({ 5, 2,
    }),
    "2": ({ 5, 2,
    }),
    "3": ({ 5, 2,
    }),
    "4": ({ 5, 2,
    }),
    "5": ({ 5, 2,
    }),
    "6": ({ 5, 2,
    }),
    "7": ({ 5, 2,
    }),
    "8": ({ 5, 2,
    }),
    "9": ({ 5, 2,
    }),
    "10": ({ 5, 2,
    }),
    "11": ({ 5, 2,
    }),
    "12": ({ 5, 2,
    }),
    "13": ({ 5, 2,
    }),
    "14": ({ 5, 2,
    }),
    "15": ({ 5, 2,
    }),
    "16": ({ 5, 2,
    }),
    "17": ({ 5, 2,
    }),
    "18": ({ 5, 2,
    }),
    "19": ({ 5, 2,
    }),
    "20": ({ 5, 2,
    }),
    "21": ({ 5, 5,
    }),
    "22": ({ 5, 2,
    }),
    "23": ({ 5, 2,
    }),
  ]));
  setup();
  carry_object("/obj/move/dfly")->wear();
  carry_object("/obj/wear/pants")->wear();

}





void prepare_kill() {
  if (query_temp("pending/prepare_kill")) return;

  command("wield dagger");
  command("say 哼 ! 你这个杀人的凶手 !!");
  set_temp("pending/prepare_kill", 1);
}
