// Room: /d/shenmin/tinyuan。c

inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "龙亭园");
	set("long", @LONG
一片花木葱郁的园林。园林的南北两边分别是龙湖和牙湖，湖中
碧波荡漾，湖边垂柳依依，芳草如茵。从此向东，是龙牙街，西
面是西大街道。
LONG
	);
	
	set("no_clean_up", 0);
	set("exits", ([ /* sizeof() == 2 */
  "east" : __DIR__"road5",
  "west" : __DIR__"wroad3",
]));
	set("outdoors", "/d/shenmin");

	setup();
	
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;

    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
现在是上半夜了，周围静悄悄的，大家都沉浸在梦乡之中。一片
花木葱郁的园林。园林的南北两边分别是龙湖和牙湖，湖中碧波
荡漾，湖边垂柳依依，芳草如茵。从此向东，是龙牙街，西面是
西大街道。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
清晨的空气混有一股花香的味道，阳光浅浅地洒在花丛中，一片
花木葱郁的园林。园林的南北两边分别是龙湖和牙湖，湖中碧波
荡漾，湖边垂柳依依，芳草如茵。从此向东，是龙牙街，西面是
西大街道。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
正午的阳光照在花丛上，一片花木葱郁的园林。园林的南北两边
分别是龙湖和牙湖，湖中碧波荡漾，湖边垂柳依依，芳草如茵。
从此向东，是龙牙街，西面是西大街道。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
下午的阳光洒进了花丛，可以看到街里的人开始回家了，街道两
边房屋的影子逐渐拉长，日渐西山了。一片花木葱郁的园林。园
林的南北两边分别是龙湖和牙湖，湖中碧波荡漾，湖边垂柳依依，
芳草如茵。从此向东，是龙牙街，西面是西大街道。
LONG
);
			else//晚餐时候
				set("long",@LONG
傍晚了，最后一抹阳光从花丛上消失，街道两边的店铺开始把灯
点亮。一片花木葱郁的园林。园林的南北两边分别是龙湖和牙湖，
湖中碧波荡漾，湖边垂柳依依，芳草如茵。从此向东，是龙牙街，
西面是西大街道。
LONG
);
		}
		return 0;
	}
}


