// Room: /d/shenmin/nanying.c

inherit ROOM;
int do_look(string arg);

void create()
{
	set("short", "南盈门");
	set("long", @LONG
南盈门是龙牙城的南门，由于神皇治理有方，龙牙境内很是平安。
        .&______~*@*~______&.           *
      "w/%%%%%%%%%%%%%%%%%%%\w"        ***
        `Y""Y""Y"""""Y""Y""Y'         *****
     p-p_|__|__|_____|__|__|_q-q      **Y**
    [EEEEM==M==MM===MM==M==MEEEE]-__....|....  
LONG
	);
	
	set("no_clean_up", 0);
	set("exits", ([ /* sizeof() == 2 */
  "north" : __DIR__"jiedao2",
  "south" : __DIR__"dadao",
]));
	set("outdoors", "/d/shenmin");

	setup();

}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
	
    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
夜色如水，月正中天，南盈门在夜幕下显得格外阴森。南盈门是
龙牙城的南门，由于神皇治理有方，龙牙境内很是平安。
        .&______~*@*~______&.           *
      "w/%%%%%%%%%%%%%%%%%%%\w"        ***
        `Y""Y""Y"""""Y""Y""Y'         *****
     p-p_|__|__|_____|__|__|_q-q      **Y**
    [EEEEM==M==MM===MM==M==MEEEE]-__....|....  
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
清晨的空气混有一股泥土的清香，阳光浅浅地透过来，四周一片
灰蒙蒙的。南盈门是龙牙城的南门，由于神皇治理有方，龙牙境
内很是平安。
        .&______~*@*~______&.           *
      "w/%%%%%%%%%%%%%%%%%%%\w"        ***
        `Y""Y""Y"""""Y""Y""Y'         *****
     p-p_|__|__|_____|__|__|_q-q      **Y**
    [EEEEM==M==MM===MM==M==MEEEE]-__....|....  
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
正午的阳光透过树叶的缝隙在城门上留下了班驳的树影。南盈门
是龙牙城的南门，由于神皇治理有方，龙牙境内很是平安。
        .&______~*@*~______&.           *
      "w/%%%%%%%%%%%%%%%%%%%\w"        ***
        `Y""Y""Y"""""Y""Y""Y'         *****
     p-p_|__|__|_____|__|__|_q-q      **Y**
    [EEEEM==M==MM===MM==M==MEEEE]-__....|....  
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
下午的阳光洒了进来，可以看到好些行人在走来走去，城门上的
树影逐渐拉长，日渐西山了。南盈门是龙牙城的南门，由于神皇
治理有方，龙牙境内很是平安。
        .&______~*@*~______&.           *
      "w/%%%%%%%%%%%%%%%%%%%\w"        ***
        `Y""Y""Y"""""Y""Y""Y'         *****
     p-p_|__|__|_____|__|__|_q-q      **Y**
    [EEEEM==M==MM===MM==M==MEEEE]-__....|....  
LONG
);
			else//晚餐时候
				set("long",@LONG
傍晚的阳光慢慢的消失在地平线上。远处不知谁家的炊烟正在袅
袅升起，是晚餐时分了。南盈门是龙牙城的南门，由于神皇治理
有方，龙牙境内很是平安。
        .&______~*@*~______&.           *
      "w/%%%%%%%%%%%%%%%%%%%\w"        ***
        `Y""Y""Y"""""Y""Y""Y'         *****
     p-p_|__|__|_____|__|__|_q-q      **Y**
    [EEEEM==M==MM===MM==M==MEEEE]-__....|....  
LONG
);
		}
		return 0;
	}
}


