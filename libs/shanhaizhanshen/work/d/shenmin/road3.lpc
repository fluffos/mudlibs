// Room: /d/shenmin/road3.c

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "龙牙街");
  set("long", @LONG
龙牙街是条横贯南北的大街道，是龙牙城的主街道。两边的店铺
楼阁不断，实是人间一景。抬眼望去，层层鳞鳞的房屋望不到尽头。
LONG
  );

  set("outdoors", "/d/shenmin");
  set("exits", ([ /* sizeof() == 4 */
    "east": __DIR__ "ciqi",

    "south": __DIR__ "road2",
    "northup": __DIR__ "road4",
  ]));
  set("no_clean_up", 0);

  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;

  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
现在是上半夜了，周围静悄悄的，大家都沉浸在梦乡之中。龙牙
街是条横贯南北的大街道，是龙牙城的主街道。两边的店铺楼阁
不断，实是人间一景。抬眼望去，层层鳞鳞的房屋望不到尽头。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
清晨的空气混有一股花香的味道，阳光浅浅地洒在街道，龙牙街
是条横贯南北的大街道，是龙牙城的主街道。两边的店铺楼阁不
断，实是人间一景。抬眼望去，层层鳞鳞的房屋望不到尽头。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
正午的阳光照在街道上，龙牙街是条横贯南北的大街道，是龙牙
城的主街道。两边的店铺楼阁不断，实是人间一景。抬眼望去，
层层鳞鳞的房屋望不到尽头。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
下午的阳光洒进了龙牙街，可以看到街里的人开始回家了，街道
两边房屋的影子逐渐拉长，日渐西山了。龙牙街是条横贯南北的
大街道，是龙牙城的主街道。两边的店铺楼阁不断，实是人间一
景。抬眼望去，层层鳞鳞的房屋望不到尽头。
LONG
        );
      else  //晚餐时候
        set("long", @LONG
傍晚了，最后一抹阳光在地平线上消失，街道两边的店铺开始把
灯点亮。龙牙街是条横贯南北的大街道，两边的店铺楼阁不断，
实是人间一景。抬眼望去，层层鳞鳞的房屋望不到尽头。
LONG
        );
    }
    return 0;
  }
}
