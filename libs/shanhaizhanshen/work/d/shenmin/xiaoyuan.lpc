// Room: /d/shenmin/xiaoyuan.c

inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "小院");
	set("long", @LONG
你一脚踏进来，不由得喊了声『好』，只见修篁一片，间中是两
棵菩提树。小路沿着修竹而弯，北面路的尽头就是龙皇的住所，
也是他平常接待贵客的地方。
LONG
	);
	set("no_clean_up", 0);
	set("exits", ([ /* sizeof() == 2 */
  "north" : __DIR__"fangzhang",
  "west" : __DIR__"cangjing",
]));
	set("outdoors", "/d/shenmin");

	setup();
	
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;

    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
周围静悄悄的，已经半夜了，大家都沉浸在梦乡之中。你一脚踏
进来，不由得喊了声『好』，只见修篁一片，间中是两棵菩提树。
小路沿着修竹而弯，北面路的尽头就是龙皇的住所，也是他平常
接待贵客的地方。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
清晨的空气传来花香的味道，阳光浅浅地洒在竹林上，你一脚踏
进来，不由得喊了声『好』，只见修篁一片，间中是两棵菩提树。
小路沿着修竹而弯，北面路的尽头就是龙皇的住所，也是他平常
接待贵客的地方。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
正午的阳光照在竹林上，一阵微风吹过，竹子随后摇摆。你一脚
踏进来，不由得喊了声『好』，只见修篁一片，间中是两棵菩提
树。小路沿着修竹而弯，北面路的尽头就是龙皇的住所，也是他
平常接待贵客的地方。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
下午的阳光洒在竹林上，你一脚踏进来，不由得喊了声『好』，
只见修篁一片，间中是两棵菩提树。小路沿着修竹而弯，北面路
的尽头就是龙皇的住所，也是他平常接待贵客的地方。
LONG
);
			else//晚餐时候
				set("long",@LONG
最后一抹阳光消失在竹林里，院子间中是两棵菩提树。小路沿着
修竹而弯，北面路的尽头就是龙皇的住所，也是他平常接待贵客
的地方。
LONG
);
		}
		return 0;
	}
}


