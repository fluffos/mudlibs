// Room: /d/shenmin/road5.c

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "龙牙街");
  set("long", @LONG
龙牙街是横贯龙城南北的主要街道，是龙牙城的主城道。街道两
边店铺亭台不断，小贩叫卖，行人来往，车马喧哗，一派繁华，
南边的高桥就是龙桥，西面是龙亭园。
LONG
  );
  set("no_clean_up", 0);
  set("exits", ([ /* sizeof() == 3 */
    "southup": __DIR__ "road4",
    "north": __DIR__ "road6",
    "west": __DIR__ "tinyuan",
  ]));
  set("outdoors", "/d/shenmin");

  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;

  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
现在是上半夜了，周围静悄悄的，大家都沉浸在梦乡之中。龙牙
街是横贯龙城南北的主要街道，是龙牙城的主城道。街道两边店
铺亭台不断，小贩叫卖，行人来往，车马喧哗，一派繁华，南边
的高桥就是龙桥，西面是龙亭园。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
清晨的空气混有一股花香的味道，阳光浅浅地洒在街道，龙牙街
是横贯龙城南北的主要街道，是龙牙城的主城道。街道两边店铺
亭台不断，小贩叫卖，行人来往，车马喧哗，一派繁华，南边的
高桥就是龙桥，西面是龙亭园。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
正午的阳光照在街道上，龙牙街是横贯龙城南北的主要街道，是
龙牙城的主城道。街道两边店铺亭台不断，小贩叫卖，行人来往，
车马喧哗，一派繁华，南边的高桥就是龙桥，西面是龙亭园。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
下午的阳光洒进了龙牙街，可以看到街里的人开始回家了，街道
两边房屋的影子逐渐拉长，日渐西山了。龙牙街是横贯龙城南北
的主要街道，是龙牙城的主城道。街道两边店铺亭台不断，小贩
叫卖，行人来往，车马喧哗，一派繁华，南边的高桥就是龙桥，
西面是龙亭园。
LONG
        );
      else  //晚餐时候
        set("long", @LONG
傍晚了，最后一抹阳光在地平线上消失，街道两边的店铺开始把
灯点亮。龙牙街是横贯龙城南北的主要街道，是龙牙城的主城道。
街道两边店铺亭台不断，小贩叫卖，行人来往，车马喧哗，一派
繁华，南边的高桥就是龙桥，西面是龙亭园。
LONG
        );
    }
    return 0;
  }
}
