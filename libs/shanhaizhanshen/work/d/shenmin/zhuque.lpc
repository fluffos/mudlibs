// Room: /d/kaifeng/zhuque.c

inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "朱牙门");
	set("long", @LONG
这是内城的城门，高大的城墙用大青砖弥合米汁而成，时间的冲
刷使得墙砖变为铁青色。东西两边是角楼，有个威武的卫兵在守
护着这里。
LONG
	);
set("valid_startroom",1);
	
	set("no_clean_up", 0);
	set("exits", ([ /* sizeof() == 4 */
  "south" : __DIR__"road",
  "north" : __DIR__"road2",
  "westup" : __DIR__"jiaolou",
  "eastup" : __DIR__"jiaolou2",
]));
	set("outdoors", "/d/shenmin");

	setup();
	
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
	
    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
夜色如水，月正中天。这是内城的城门，高大的城墙用大青砖弥
合米汁而成，时间的冲刷使得墙砖变为铁青色。东西两边是角楼，
有个威武的卫兵在守护着这里。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
清晨的空气混有一股泥土的清香，阳光浅浅地透过来，四周一片
灰蒙蒙的。这是内城的城门，高大的城墙用大青砖弥合米汁而成，
时间的冲刷使得墙砖变为铁青色。东西两边是角楼，有个威武的
卫兵在守护着这里。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
正午的阳光透过树叶的缝隙在城门上留下了班驳的树影。这是内
城的城门，高大的城墙用大青砖弥合米汁而成，时间的冲刷使得
墙砖变为铁青色。东西两边是角楼，有个威武的卫兵在守护着这里。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
城门的树影逐渐拉长，日渐西山了。这是内城的城门，高大的城
墙用大青砖弥合米汁而成，时间的冲刷使得墙砖变为铁青色。东
西两边是角楼，有个威武的卫兵在守护着这里。  
LONG
);
			else//晚餐时候
				set("long",@LONG
傍晚的阳光慢慢的消失，这是内城的城门，高大的城墙用大青砖
弥合米汁而成，时间的冲刷使得墙砖变为铁青色。东西两边是角
楼，有个威武的卫兵在守护着这里。
LONG
);
		}
		return 0;
	}
}


