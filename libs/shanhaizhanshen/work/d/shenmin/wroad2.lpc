// Room: /d/shenmin/wroad2.c

inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "西大街");
	set("long", @LONG
龙牙城内西面的主要交通要道，街道两边店铺林立，行人车马如
梭。商贩的吆喝，市民与小贩的讨价还价，喧闹无比。
LONG
	);
	
	set("outdoors", "/d/shenmin");
	set("exits", ([ /* sizeof() == 4 */
  "eastup" : __DIR__"jiaolou",
  
  "north" : __DIR__"wroad3",
  "south" : __DIR__"wroad1",
]));
	set("no_clean_up", 0);

	setup();
	
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;

    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
现在是半夜，周围静悄悄的，大家都沉浸在梦乡之中。这里是龙
牙城内西面的主要交通要道。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
清晨的空气混有一股花香的味道，阳光浅浅地洒在街道，龙牙城
内西面的主要交通要道，街道两边店铺林立，行人车马如梭。小
商贩们挑着担子来回吆喝。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
正午的阳光照在街道上，龙牙城内西面的主要交通要道，街道两
边店铺林立，行人车马如梭。小商贩们挑着担子来回吆喝。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
下午的阳光洒进了龙牙街，可以看到街里的人开始回家了，街道
两边房屋的影子逐渐拉长，日渐西山了。龙牙城内西面的主要交
通要道，街道两边店铺林立，行人车马如梭。小商贩们挑着担子
来回吆喝。
LONG
);
			else//晚餐时候
				set("long",@LONG
傍晚了，最后一抹阳光在地平线上消失，街道两边的店铺开始把
灯点亮。龙牙城内西面的主要交通要道，街道两边店铺林立，行
人车马如梭。小商贩们挑着担子来回吆喝。
LONG
);
		}
		return 0;
	}
}


