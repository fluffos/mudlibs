// Room: /d/shenmin/xianguosi.c

inherit ROOM;
int do_look(string arg);

void create()
{
	set("short", "龙皇寺");
	set("long", @LONG
龙皇寺占地500余亩，辖64个禅，律院，养僧千余。是龙牙城最大
的寺院和龙皇的皇城。门前『龙皇寺』的匾额乃是当今龙皇御笔
亲书。
                   !
                  /^\
                /     \
 |           | (       ) |           |
/^\ |       /^\ \     / /^\       | /^\
|O|/^\     (   )|-----|(   )     /^\|O|
|_||-| |^-^|---||-----||---|^-^| |-||_|
|O||O| |/^\|/^\||  |  ||/^\|/^\| |O||O|
|-||-| ||_|||_||| /^\ |||_|||_|| |-||-|
|O||O| |/^\|/^\||(   )||/^\|/^\| |O||O|
|-||-| ||_|||_||||   ||||_|||_|| |-||-|
LONG
	);

	
	set("no_clean_up", 0);
	set("objects", ([
		__DIR__"npc/shiwei1" : 1,
                
                __DIR__"npc/shiwei2" : 1,
	]));
	set("exits", ([ /* sizeof() == 2 */
  "north" : __DIR__"qianyuan",
  "south" : __DIR__"jiedao",
]));
	set("outdoors", "/d/shenmin");

	setup();

}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
	
    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//上半夜
				set("long", @LONG
夜色如水，远处传来报时的鼓声。龙皇寺占地500余亩，辖64个
禅，律院，养僧千余。是龙牙城最大的寺院和龙皇的皇城。门前
『龙皇寺』的匾额乃是当今龙皇御笔亲书。
                   !
                  /^\
                /     \
 |           | (       ) |           |
/^\ |       /^\ \     / /^\       | /^\
|O|/^\     (   )|-----|(   )     /^\|O|
|_||-| |^-^|---||-----||---|^-^| |-||_|
|O||O| |/^\|/^\||  |  ||/^\|/^\| |O||O|
|-||-| ||_|||_||| /^\ |||_|||_|| |-||-|
|O||O| |/^\|/^\||(   )||/^\|/^\| |O||O|
|-||-| ||_|||_||||   ||||_|||_|| |-||-|
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
清晨的空气混有一股淡淡的清香，阳光浅浅地透过来，四周一片
灰蒙蒙的。昨晚当值的士兵开始换岗了。
                   !
                  /^\
                /     \
 |           | (       ) |           |
/^\ |       /^\ \     / /^\       | /^\
|O|/^\     (   )|-----|(   )     /^\|O|
|_||-| |^-^|---||-----||---|^-^| |-||_|
|O||O| |/^\|/^\||  |  ||/^\|/^\| |O||O|
|-||-| ||_|||_||| /^\ |||_|||_|| |-||-|
|O||O| |/^\|/^\||(   )||/^\|/^\| |O||O|
|-||-| ||_|||_||||   ||||_|||_|| |-||-|         
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
阳光越来越猛烈，透过树叶的缝隙在寺门上留下了班驳的树影。
龙皇寺占地500余亩，辖64个禅，律院，养僧千余。是龙牙城最大
的寺院和龙皇的皇城。门前『龙皇寺』的匾额乃是当今龙皇御笔亲书。
                   !
                  /^\
                /     \
 |           | (       ) |           |
/^\ |       /^\ \     / /^\       | /^\
|O|/^\     (   )|-----|(   )     /^\|O|
|_||-| |^-^|---||-----||---|^-^| |-||_|
|O||O| |/^\|/^\||  |  ||/^\|/^\| |O||O|
|-||-| ||_|||_||| /^\ |||_|||_|| |-||-|
|O||O| |/^\|/^\||(   )||/^\|/^\| |O||O|
|-||-| ||_|||_||||   ||||_|||_|| |-||-|
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
下午的阳光柔和了许多，可以看到好些行人在走来走去，寺门上
的树影逐渐拉长，日渐西山了。
                   !
                  /^\
                /     \
 |           | (       ) |           |
