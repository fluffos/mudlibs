// Room: /d/shenmin/zhongyuan.c

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "中院");
  set("long", @LONG
中院分为前后两部分,院子的正中有座铁制浮屠，高七层，雕刻
精美花纹。前边部分除中间的行道外，两边是花圃，各种一棵高
大的菩提树。后边铺着青石，通向大雄宝殿。南边是天王殿，东
边是素斋厨。
LONG
  );

  set("no_clean_up", 0);
  set("exits", ([ /* sizeof() == 4 */
    "south": __DIR__ "tianwang",
    "north": __DIR__ "daxiong",
    "east": __DIR__ "chufang",

  ]));
  set("outdoors", "/d/shenmin");

  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;

  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
周围静悄悄的，已经半夜了，大家都沉浸在梦乡之中。中院分为
前后两部分,院子的正中有座铁制浮屠，高七层，雕刻精美花纹。
前边部分除中间的行道外，两边是花圃，各种一棵高大的菩提树。
后边铺着青石，通向大雄宝殿。南边是天王殿，东边是素斋厨。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
清晨的空气传来花香的味道，阳光浅浅地洒进院子，院子的正中
有座铁制浮屠，高七层，雕刻精美花纹。前边部分除中间的行道
外，两边是花圃，各种一棵高大的菩提树。后边铺着青石，通向
大雄宝殿。南边是天王殿，东边是素斋厨。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
正午的阳光照在浮屠上，精美的花纹反射着阳光。院子的前边部
分除中间的行道外，两边是花圃，各种一棵高大的菩提树。后边
铺着青石，通向大雄宝殿。南边是天王殿，东边是素斋厨。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
下午的阳光洒进了院子，落在正中的浮屠上，浮屠高七层，雕刻
精美花纹。前边部分除中间的行道外，两边是花圃，各种一棵高
大的菩提树。后边铺着青石，通向大雄宝殿。南边是天王殿，东
边是素斋厨。
LONG
        );
      else  //晚餐时候
        set("long", @LONG
最后一抹阳光从浮屠上消失，院子前边部分除中间的行道外，两
边是花圃，各种一棵高大的菩提树。后边铺着青石，通向大雄宝
殿。南边是天王殿，东边是素斋厨。
LONG
        );
    }
    return 0;
  }
}
