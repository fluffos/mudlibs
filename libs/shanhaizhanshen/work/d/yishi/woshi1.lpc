inherit ROOM;
int do_look(string arg);
void create()
{
    set("short","休息室");
    set("long", @LONG
这里是蚁蛳洞内的休息室，洞内有点点旧，但是打扫的非常干净，
一排床铺靠墙摆着，不断的有人进来休息或醒后离去，你悄悄的
找个空铺睡了下来。
LONG);
	set("exits", ([
	                "south" : __DIR__"lang6",
        ]));
        set("no_get_from",1);
        set("no_fight",1);
        set("sleep_room", 1);
        set("no_get", 1);
	setup();

}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
夜空，一锭墨黑，伸手不见五指。雷声震耳欲聋的霹雷过处，电
光一闪，豆大的雨滴，洒了下来！这里是蚁蛳洞内的休息室，洞
内有点点旧，但是打扫的非常干净，一排床铺靠墙摆着，不断的
有人进来休息或醒后离去，你悄悄的找个空铺睡了下来。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
风中已带来黎明的消息，变得更清新、更冷，雨天的黎明非常的
凉爽。这里是蚁蛳洞内的休息室，洞内有点点旧，但是打扫的非
常干净，一排床铺靠墙摆着，不断的有人进来休息或醒后离去，
你悄悄的找个空铺睡了下来。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
雨终于停了，空气凉丝丝的透着一股凉意，太阳从云里露出了一
点点。这里是蚁蛳洞内的休息室，洞内有点点旧，但是打扫的非
常干净，一排床铺靠墙摆着，不断的有人进来休息或醒后离去，
你悄悄的找个空铺睡了下来。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
残阳如血，火烧云布满了西边的天空。这里是蚁蛳洞内的休息室，
洞内有点点旧，但是打扫的非常干净，一排床铺靠墙摆着，不断
的有人进来休息或醒后离去，你悄悄的找个空铺睡了下来。
LONG
);
			else//入夜
				set("long",@LONG
一阵隐隐的雷声过后，接着是一道耀目难睁的闪电，给这漆黑的
大地，带来了刹那的光明！这里是蚁蛳洞内的休息室，洞内有点
点旧，但是打扫的非常干净，一排床铺靠墙摆着，不断的有人进
来休息或醒后离去，你悄悄的找个空铺睡了下来。
LONG
);
		}
		return 0;
	}
}


