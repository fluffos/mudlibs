inherit ROOM;
int do_look(string arg);
void create()
{
    set("short", "水房");
    set("long", @LONG
一进屋，你看见屋内放着几口大缸，好象是装水用的，不过缸似
乎都是空的，这里没有一个人，估计仆人都跑了。
LONG);
	set("exits", ([
	     "east" : __DIR__"houyuan",
        ]) );
        set("no_fight",1);
        set("outdoors", "武馆");
	setup();
      
}

void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
夜空，一锭墨黑，伸手不见五指。雷声震耳欲聋的霹雷过处，电
光一闪，豆大的雨滴，洒了下来！一进屋，你看见屋内放着几口
大缸，好象是装水用的，不过缸似乎都是空的，这里没有一个人，
估计仆人都跑了。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
风中已带来黎明的消息，变得更清新、更冷，雨天的黎明非常的
凉爽。一进屋，你看见屋内放着几口大缸，好象是装水用的，不
过缸似乎都是空的，这里没有一个人，估计仆人都跑了。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
雨终于停了，空气凉丝丝的透着一股凉意，太阳从云里露出了一
点点。一进屋，你看见屋内放着几口大缸，好象是装水用的，不
过缸似乎都是空的，这里没有一个人，估计仆人都跑了。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
残阳如血，火烧云布满了西边的天空。一进屋，你看见屋内放着
几口大缸，好象是装水用的，不过缸似乎都是空的，这里没有一
个人，估计仆人都跑了。
LONG
);
			else//入夜
				set("long",@LONG
一阵隐隐的雷声过后，接着是一道耀目难睁的闪电，给这漆黑的
大地，带来了刹那的光明！一进屋，你看见屋内放着几口大缸，
好象是装水用的，不过缸似乎都是空的，这里没有一个人，估计
仆人都跑了。
LONG
);
		}
		return 0;
	}
}


