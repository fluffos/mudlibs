// By jjgod.
inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "洞内大厅");
	set("long", @LONG
这里是蚁蛳洞内大厅，正中靠北摆着一张石桌，桌上放着一个骷
髅灯。往北走有条走廊，一直通向族长的卧室。西面通向厨房，
往东走就可以到后花园了。
LONG);
	set("exits", ([
		"southdown" : __DIR__"dayuan2",
		"enter" : __DIR__"lang5",
		"westdown" : __DIR__"shilu-2",
		"eastdown" : __DIR__"shilu-1",
	]));
	set("objects", ([
                __DIR__"npc/yishi2" : 1,
        ]));
	setup();
	
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
夜空，一锭墨黑，伸手不见五指。雷声震耳欲聋的霹雷过处，电
光一闪，豆大的雨滴，洒了下来！这里是蚁蛳洞内大厅，正中靠
北摆着一张石桌，桌上放着一个骷髅灯。往北走有条走廊，一直
通向族长的卧室。西面通向厨房，往东走就可以到后花园了。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
风中已带来黎明的消息，变得更清新、更冷，雨天的黎明非常的
凉爽。这里是蚁蛳洞内大厅，正中靠北摆着一张石桌，桌上放着
一个骷髅灯。往北走有条走廊，一直通向族长的卧室。西面通向
厨房，往东走就可以到后花园了。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
雨终于停了，空气凉丝丝的透着一股凉意，太阳从云里露出了一
点点。这里是蚁蛳洞内大厅，正中靠北摆着一张石桌，桌上放着
一个骷髅灯。往北走有条走廊，一直通向族长的卧室。西面通向
厨房，往东走就可以到后花园了。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
残阳如血，火烧云布满了西边的天空。这里是蚁蛳洞内大厅，正
中靠北摆着一张石桌，桌上放着一个骷髅灯。往北走有条走廊，
一直通向族长的卧室。西面通向厨房，往东走就可以到后花园了。
LONG
);
			else//入夜
				set("long",@LONG
一阵隐隐的雷声过后，接着是一道耀目难睁的闪电，给这漆黑的
大地，带来了刹那的光明！这里是蚁蛳洞内大厅，正中靠北摆着
一张石桌，桌上放着一个骷髅灯。往北走有条走廊，一直通向族
长的卧室。西面通向厨房，往东走就可以到后花园了。
LONG
);
		}
		return 0;
	}
}


