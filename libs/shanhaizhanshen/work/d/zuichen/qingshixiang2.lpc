//bye enter

inherit ROOM;
int do_look(string arg);
void create()
{
        set("short", "青石巷");
        set("long",@LONG
你走在一条青石巷上，整条小巷静悄悄的，跟春熙路的热闹情景
完全不一样，你总觉得气氛有点不对劲。
LONG
        );

        set("exits", ([
                "west" : __DIR__"qingshixiang1",
                "east" : __DIR__"qingshixiang3",
            ]));
        setup();
            
}


void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
已经是午夜了，风挟卷着枯枝落叶，沙沙声不绝于耳。你走在一
条青石巷上，整条小巷静悄悄的，跟春熙路的热闹情景完全不一
样，你总觉得气氛有点不对劲。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
天渐渐亮了，天空惨白的，大地还笼罩在夜幕之中。你走在一条
青石巷上，整条小巷静悄悄的，跟春熙路的热闹情景完全不一样，
你总觉得气氛有点不对劲。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
现在是正午时分，天阴着，凛冽的风呼呼的吹着。你走在一条青
石巷上，整条小巷静悄悄的，跟春熙路的热闹情景完全不一样，
你总觉得气氛有点不对劲。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
夜晚悄悄降临了，风裹尘沙，寒意袭人。你走在一条青石巷上，
整条小巷静悄悄的，跟春熙路的热闹情景完全不一样，你总觉得
气氛有点不对劲。
LONG
);
			else//入夜
				set("long",@LONG
夜幕笼罩著大地，风沙刺骨。你走在一条青石巷上，整条小巷静
悄悄的，跟春熙路的热闹情景完全不一样，你总觉得气氛有点不
对劲。
LONG
);
		}
		return 0;
	}
}
