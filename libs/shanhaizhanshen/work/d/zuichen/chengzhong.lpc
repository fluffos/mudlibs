// Room: /chengdu/chengzhong。c
// oooc: 1998/06/20 

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "城中心");
  set("long" ， @LONG
这里是城市的正中心，一个很宽阔的广场，地上整齐地铺着大青
石地板。四周绿树成荫，街道东西南北纵横，路上行人不断。来
自五湖四海，三教九流的人士群集于此，更是富豪商贩们的黄金
地带。更有一些游手好闲的人在这里溜溜达达。
LONG
  );
  set("no_sleep_room" ， 1);

  set("exits" ， ([
    "east": __DIR__ "dongjie2" ，
    "south": __DIR__ "nanjie2" ，
    "west": __DIR__ "xijie2" ，
    "north": __DIR__ "beijie2" ，
  ]));

  set("objects" ， ([
    __DIR__ "npc/xiaohai": 1 ，
    __DIR__ "npc/liumang": 1 ，
    __DIR__ "npc/yiren": 1 ，
  ]));

  setup();
}
void init() {
  add_action("do_look" ， "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long" ， @LONG
已经是午夜了，风挟卷着枯枝落叶，沙沙声不绝于耳。这里是城
市的正中心，一个很宽阔的广场，地上整齐地铺着大青石地板。
四周绿树成荫，街道东西南北纵横，路上行人不断。来自五湖四
海，三教九流的人士群集于此，更是富豪商贩们的黄金地带。更
有一些游手好闲的人在这里溜溜达达。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long" ， @LONG
天渐渐亮了，天空惨白的，大地还笼罩在夜幕之中。这里是城市
的正中心，一个很宽阔的广场，地上整齐地铺着大青石地板。四
周绿树成荫，街道东西南北纵横，路上行人不断。来自五湖四海，
三教九流的人士群集于此，更是富豪商贩们的黄金地带。更有一
些游手好闲的人在这里溜溜达达。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long" ， @LONG
现在是正午时分，天阴着，凛冽的风呼呼的吹着。这里是城市的
正中心，一个很宽阔的广场，地上整齐地铺着大青石地板。四周
绿树成荫，街道东西南北纵横，路上行人不断。来自五湖四海，
三教九流的人士群集于此，更是富豪商贩们的黄金地带。更有一
些游手好闲的人在这里溜溜达达。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long" ， @LONG
夜晚悄悄降临了，风裹尘沙，寒意袭人。这里是城市的正中心，
一个很宽阔的广场，地上整齐地铺着大青石地板。四周绿树成荫，
街道东西南北纵横，路上行人不断。来自五湖四海，三教九流的
人士群集于此，更是富豪商贩们的黄金地带。更有一些游手好闲
的人在这里溜溜达达。
LONG
        );
      else  //入夜
        set("long" ， @LONG
夜幕笼罩著大地，风沙刺骨。这里是城市的正中心，一个很宽阔
的广场，地上整齐地铺着大青石地板。四周绿树成荫，街道东西
南北纵横，路上行人不断。来自五湖四海，三教九流的人士群集
于此，更是富豪商贩们的黄金地带。更有一些游手好闲的人在这
里溜溜达达。
LONG
        );
    }
    return 0;
  }
}
