// Room: /city/zahuopu.c
// YZC 1995/12/04 

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "杂货铺");
  set("long", @LONG
这是一家小小的杂货铺，大箱小箱堆满了一地，都是一些日常用
品。店主懒洋洋地躺在一只躺椅上，招呼着过往行人。据说私底
下他也卖一些贵重的东西。摊上立着一块招牌(zhaopai)。
LONG
  );

  set("item_desc", ([
    "zhaopai": "请用 \"list\" 列出货物表，\"buy\" 向老板购物。\n",
  ]));
  set("exits", ([
    "south": __DIR__ "xijie2",
  ]));

  setup();

}


void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
已经是午夜了，风挟卷着枯枝落叶，沙沙声不绝于耳。这是一家
小小的杂货铺，大箱小箱堆满了一地，都是一些日常用品。店主
懒洋洋地躺在一只躺椅上，招呼着过往行人。据说私底下他也卖
一些贵重的东西。摊上立着一块招牌(zhaopai)。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
天渐渐亮了，天空惨白的，大地还笼罩在夜幕之中。这是一家小
小的杂货铺，大箱小箱堆满了一地，都是一些日常用品。店主懒
洋洋地躺在一只躺椅上，招呼着过往行人。据说私底下他也卖一
些贵重的东西。摊上立着一块招牌(zhaopai)。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
现在是正午时分，天阴着，凛冽的风呼呼的吹着。这是一家小小
的杂货铺，大箱小箱堆满了一地，都是一些日常用品。店主懒洋
洋地躺在一只躺椅上，招呼着过往行人。据说私底下他也卖一些
贵重的东西。摊上立着一块招牌(zhaopai)。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
夜晚悄悄降临了，风裹尘沙，寒意袭人。这是一家小小的杂货铺，
大箱小箱堆满了一地，都是一些日常用品。店主懒洋洋地躺在一
只躺椅上，招呼着过往行人。据说私底下他也卖一些贵重的东西。
摊上立着一块招牌(zhaopai)。
LONG
        );
      else  //入夜
        set("long", @LONG
夜幕笼罩著大地，风沙刺骨。这是一家小小的杂货铺，大箱小箱
堆满了一地，都是一些日常用品。店主懒洋洋地躺在一只躺椅上，
招呼着过往行人。据说私底下他也卖一些贵重的东西。摊上立着
一块招牌(zhaopai)。
LONG
        );
    }
    return 0;
  }
}
