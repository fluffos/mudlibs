//xiaoting.c

inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "小厅");
	set("long",@LONG
这是一个小小的客厅，墙上挂着一些人皮字画，其中最显眼的是
一幅巨大的《恶》，有个女仆人正在打扫着卫生。
LONG
	);
	set("exits", ([
		"south" : __DIR__"xiaoyuan",
                "up" : __DIR__"xiaolou",
	]));

        

	set("item_desc", ([
		"《恶》" : "天生万物已养人,人无一物以报天。\n" ,
	]));

	setup();
}

void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
已经是午夜了，风挟卷着枯枝落叶，沙沙声不绝于耳。这是一个
小小的客厅，墙上挂着一些人皮字画，其中最显眼的是一幅巨大
的《恶》，有个女仆人正在打扫着卫生。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
天渐渐亮了，天空惨白的，大地还笼罩在夜幕之中。这是一个小
小的客厅，墙上挂着一些人皮字画，其中最显眼的是一幅巨大的
《恶》，有个女仆人正在打扫着卫生。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
现在是正午时分，天阴着，凛冽的风呼呼的吹着。这是一个小小
的客厅，墙上挂着一些人皮字画，其中最显眼的是一幅巨大的《
恶》，有个女仆人正在打扫着卫生。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
夜晚悄悄降临了，风裹尘沙，寒意袭人。这是一个小小的客厅，
墙上挂着一些人皮字画，其中最显眼的是一幅巨大的《恶》，有
个女仆人正在打扫着卫生。
LONG
);
			else//入夜
				set("long",@LONG
夜幕笼罩著大地，风沙刺骨。这是一个小小的客厅，墙上挂着一
些人皮字画，其中最显眼的是一幅巨大的《恶》，有个女仆人正
在打扫着卫生。
LONG
);
		}
		return 0;
	}
}
