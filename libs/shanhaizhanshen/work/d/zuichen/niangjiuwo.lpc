// Room: /d/chengdu/niangjiuwo.c
// oooc: 1998/6/28

inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "酿酒屋");
	set("long", @LONG
你来到一座老式的房子中间。在你的左手面有一个很大很大的木
桶，约有二人多高。在木桶的上面，站着几个精赤着上身的大汉，
手里拿着竹竿在奋力的朝木桶搅动着。正前方站着一个半老的徐
娘，在和几个小伙子眉来眼去地说笑着。
LONG
	);

	set("exits", ([
                "northwest" : __DIR__"xiaojie3",
	]));

	
	setup();
	
}

void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
已经是午夜了，风挟卷着枯枝落叶，沙沙声不绝于耳。你来到一
座老式的房子中间。在你的左手面有一个很大很大的木桶，约有
二人多高。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
天渐渐亮了，天空惨白的，大地还笼罩在夜幕之中。你来到一座
老式的房子中间。在你的左手面有一个很大很大的木桶，约有二
人多高。在木桶的上面，站着几个精赤着上身的大汉，手里拿着
竹竿在奋力的朝木桶搅动着。正前方站着一个半老的徐娘，在和
几个小伙子眉来眼去地说笑着。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
现在是正午时分，天阴着，凛冽的风呼呼的吹着。你来到一座老
式的房子中间。在你的左手面有一个很大很大的木桶，约有二人
多高。在木桶的上面，站着几个精赤着上身的大汉，手里拿着竹
竿在奋力的朝木桶搅动着。正前方站着一个半老的徐娘，在和几
个小伙子眉来眼去地说笑着。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
夜晚悄悄降临了，风裹尘沙，寒意袭人。你来到一座老式的房子
中间。在你的左手面有一个很大很大的木桶，约有二人多高。在
木桶的上面，站着几个精赤着上身的大汉，手里拿着竹竿在奋力
的朝木桶搅动着。正前方站着一个半老的徐娘，在和几个小伙子
眉来眼去地说笑着。
LONG
);
			else//入夜
				set("long",@LONG
夜幕笼罩著大地，风沙刺骨。你来到一座老式的房子中间。在你
的左手面有一个很大很大的木桶，约有二人多高。在木桶的上面，
站着几个精赤着上身的大汉，手里拿着竹竿在奋力的朝木桶搅动
着。正前方站着一个半老的徐娘，在和几个小伙子眉来眼去地说
笑着。
LONG
);
		}
		return 0;
	}
}
