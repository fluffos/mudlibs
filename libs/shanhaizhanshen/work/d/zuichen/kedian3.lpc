//bye enter 

inherit ROOM;
int do_look(string arg);
void create()
{
        set("short", "客房");
        set("long", @LONG
这是一间假日客店的客房，这里的开房率向来很高，对面有个窗
户，通过那里，可以看见街上热闹的情景，床铺看起来很干净，
被子是新换的，看着就让人想睡觉。

        ||
        ||                   ||
     ||/||___                ||
     || /`   )____________||_/|
     ||/___ //_/_/_/_/_/_/||/ |
     ||(___)/_/_/_/_/_/_/_||  |
     ||     |_|_|_|_|_|_|_|| /|
     ||     | | | | | | | ||/||
     ||~~~~~~~~~~~~~~~~~~~||
     ||                   ||
LONG
        );

        
        set("sleep_room", "1");
        set("no_fight", "1");
        

        set("exits", ([
                "out" : __DIR__"kedian2",
        ]));

        setup();
}

void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
已经是午夜了，风挟卷着枯枝落叶，沙沙声不绝于耳。这是一间
假日客店的客房，这里的开房率向来很高，对面有个窗户，通过
那里，可以看见街上热闹的情景，床铺看起来很干净，被子是新
换的，看着就让人想睡觉。

        ||
        ||                   ||
     ||/||___                ||
     || /`   )____________||_/|
     ||/___ //_/_/_/_/_/_/||/ |
     ||(___)/_/_/_/_/_/_/_||  |
     ||     |_|_|_|_|_|_|_|| /|
     ||     | | | | | | | ||/||
     ||~~~~~~~~~~~~~~~~~~~||
     ||                   ||
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
天渐渐亮了，天空惨白的，大地还笼罩在夜幕之中。这是一间假
日客店的客房，这里的开房率向来很高，对面有个窗户，通过那
里，可以看见街上热闹的情景，床铺看起来很干净，被子是新换
的，看着就让人想睡觉。

