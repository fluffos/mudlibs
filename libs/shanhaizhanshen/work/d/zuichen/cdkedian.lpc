// Room: /chengdu/cdkedian.c
// oooc: 1998/06/20 

inherit ROOM;
int do_look(string arg);
void create()
{
        set("short", "极乐客栈");
	set("long", @LONG
这里是一家老字号的客栈，崭新的桌椅排得整齐齐，隔着一层屏
风隐隐传来一阵阵锅铲的声音，大概是客栈的厨房，靠南边的墙
壁边上有一道通往二楼的楼梯，门口一个烫金的大牌匾上写着四
个大字“极乐客栈”。
LONG
	);

	set("no_fight", 1);
	set("valid_startroom", 1);
        set("no_sleep_room",1);

	set("item_desc", ([
                "paizi" : "楼上客房，每夜五两白银。\n",
	]));

	set("objects", ([
		__DIR__"npc/xiaoer" : 1,
	]));

	set("exits", ([
                "south" : __DIR__"dongjie1",
                "up" : __DIR__"cdkedian2",
	]));

	setup();
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
已经是午夜了，风挟卷着枯枝落叶，沙沙声不绝于耳。这里是一
家老字号的客栈，崭新的桌椅排得整齐齐，隔着一层屏风隐隐传
来一阵阵锅铲的声音，大概是客栈的厨房，靠南边的墙壁边上有
一道通往二楼的楼梯，门口一个烫金的大牌匾上写着四个大字“
极乐客栈”。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
天渐渐亮了，天空惨白的，大地还笼罩在夜幕之中。这里是一家
老字号的客栈，崭新的桌椅排得整齐齐，隔着一层屏风隐隐传来
一阵阵锅铲的声音，大概是客栈的厨房，靠南边的墙壁边上有一
道通往二楼的楼梯，门口一个烫金的大牌匾上写着四个大字“极
乐客栈”。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
现在是正午时分，天阴着，凛冽的风呼呼的吹着。这里是一家老
字号的客栈，崭新的桌椅排得整齐齐，隔着一层屏风隐隐传来一
阵阵锅铲的声音，大概是客栈的厨房，靠南边的墙壁边上有一道
通往二楼的楼梯，门口一个烫金的大牌匾上写着四个大字“极乐
客栈”。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
夜晚悄悄降临了，风裹尘沙，寒意袭人。这里是一家老字号的客
栈，崭新的桌椅排得整齐齐，隔着一层屏风隐隐传来一阵阵锅铲
的声音，大概是客栈的厨房，靠南边的墙壁边上有一道通往二楼
的楼梯，门口一个烫金的大牌匾上写着四个大字“极乐客栈”。
LONG
);
			else//入夜
				set("long",@LONG
夜幕笼罩著大地，风沙刺骨。这里是一家老字号的客栈，崭新的
桌椅排得整齐齐，隔着一层屏风隐隐传来一阵阵锅铲的声音，大
概是客栈的厨房，靠南边的墙壁边上有一道通往二楼的楼梯，门
口一个烫金的大牌匾上写着四个大字“极乐客栈”。
LONG
);
		}
		return 0;
	}
}




int valid_leave(object me, string dir)
{

        if ( me->query_temp("rent_paid") && dir == "south" )
	return notify_fail("店小二跑到门边拦住：客官已经付了银子，怎麽不住店就走了呢！
旁人还以为小店伺候不周呢！\n");

	return ::valid_leave(me, dir);
}
