//bye enter

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "走廊");
  set("long", @LONG
你走在一条长长的走廊上，上面雕梁画柱，飞檐琉璃，穿行其间，
心情舒畅。往东是后院。
LONG
  );
  set("exits", ([
    "east": __DIR__ "houyuan",
    "north": __DIR__ "zoulang2",
    "southeast": __DIR__ "dating",

  ]));

  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
已经是午夜了，风挟卷着枯枝落叶，沙沙声不绝于耳。你走在一
条长长的走廊上，上面雕梁画柱，飞檐琉璃，穿行其间，心情舒
畅。往东是后院。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
天渐渐亮了，天空惨白的，大地还笼罩在夜幕之中。你走在一条
长长的走廊上，上面雕梁画柱，飞檐琉璃，穿行其间，心情舒畅。
往东是后院。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
现在是正午时分，天阴着，凛冽的风呼呼的吹着。你走在一条长
长的走廊上，上面雕梁画柱，飞檐琉璃，穿行其间，心情舒畅。
往东是后院。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
夜晚悄悄降临了，风裹尘沙，寒意袭人。你走在一条长长的走廊
上，上面雕梁画柱，飞檐琉璃，穿行其间，心情舒畅。往东是后
院。
LONG
        );
      else  //入夜
        set("long", @LONG
夜幕笼罩著大地，风沙刺骨。你走在一条长长的走廊上，上面雕
梁画柱，飞檐琉璃，穿行其间，心情舒畅。往东是后院。
LONG
        );
    }
    return 0;
  }
}
