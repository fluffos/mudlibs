//bye enter


#include <room.h>

#include <ansi.h>
inherit ROOM;
int do_look(string arg);
void create()
{
       set("short",HIY "春熙路" NOR);
         set("long", @LONG
这里便是极乐城著名的商业中心，街上行人来来往往，两旁店铺
林立，热闹非凡，东面有个大酒楼，金色的锦旗迎风飘扬，只见
上书四个大字格外醒目银杏酒楼。西面看起来是个茶馆，一个个
衣着光鲜的人从那里进进出出。
LONG);

        set("outdoors", "/d/zuicheng");

        set("exits", ([
                "south" : __DIR__"chunxilu2",
                "north" : __DIR__"chunxilu",
                "east" : __DIR__"jiulou1",
            ]));
	

        setup();
       
}

void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
已经是午夜了，风挟卷着枯枝落叶，沙沙声不绝于耳。这里便是
极乐城著名的商业中心，街上行人来来往往，两旁店铺林立，热
闹非凡，东面有个大酒楼，金色的锦旗迎风飘扬，只见上书四个
大字格外醒目银杏酒楼。西面看起来是个茶馆，一个个衣着光鲜
的人从那里进进出出。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
天渐渐亮了，天空惨白的，大地还笼罩在夜幕之中。这里便是极
乐城著名的商业中心，街上行人来来往往，两旁店铺林立，热闹
非凡，东面有个大酒楼，金色的锦旗迎风飘扬，只见上书四个大
字格外醒目银杏酒楼。西面看起来是个茶馆，一个个衣着光鲜的
人从那里进进出出。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
现在是正午时分，天阴着，凛冽的风呼呼的吹着。这里便是极乐
城著名的商业中心，街上行人来来往往，两旁店铺林立，热闹非
凡，东面有个大酒楼，金色的锦旗迎风飘扬，只见上书四个大字
格外醒目银杏酒楼。西面看起来是个茶馆，一个个衣着光鲜的人
从那里进进出出。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
夜晚悄悄降临了，风裹尘沙，寒意袭人。这里便是极乐城著名的
商业中心，街上行人来来往往，两旁店铺林立，热闹非凡，东面
有个大酒楼，金色的锦旗迎风飘扬，只见上书四个大字格外醒目
银杏酒楼。西面看起来是个茶馆，一个个衣着光鲜的人从那里进
进出出。
LONG
);
			else//入夜
				set("long",@LONG
夜幕笼罩著大地，风沙刺骨。这里便是极乐城著名的商业中心，
街上行人来来往往，两旁店铺林立，热闹非凡，东面有个大酒楼，
金色的锦旗迎风飘扬，只见上书四个大字格外醒目银杏酒楼。西
面看起来是个茶馆，一个个衣着光鲜的人从那里进进出出。
LONG
);
		}
		return 0;
	}
}



