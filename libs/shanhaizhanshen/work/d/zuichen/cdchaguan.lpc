
inherit ROOM;
int do_look(string arg);
void create()
{
        set("short", "轻风茶馆");
	set("long", @LONG
你一走进来，就闻到一股茶香沁入心脾，精神为之一爽。几张桌
子一字排开，坐满了客人，或高声谈笑，或交头接耳。你要若想
打听大陆掌故和谣言，这里是个好所在。需要些茶水和点心可在
些小坐。

         _..,----,.._
      .-;'-.,____,.-';
     (( |            |
      `))            ;   要点心、咖啡、还是茶……
       ` \          /
      .-' `,.____.,' '-.
     (     '------'     )
      `-=..________..--'
LONG
	);
        set("no_fight",1);

	set("exits", ([
                "north" : __DIR__"dongjie3",
	]));

	

	setup();
	
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
已经是午夜了，风挟卷着枯枝落叶，沙沙声不绝于耳。你一走进
来，就闻到一股茶香沁入心脾，精神为之一爽。几张桌子一字排
开，坐满了客人，或高声谈笑，或交头接耳。你要若想打听大陆
掌故和谣言，这里是个好所在。需要些茶水和点心可在些小坐。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
天渐渐亮了，天空惨白的，大地还笼罩在夜幕之中。你一走进来，
就闻到一股茶香沁入心脾，精神为之一爽。几张桌子一字排开，
坐满了客人，或高声谈笑，或交头接耳。你要若想打听大陆掌故
和谣言，这里是个好所在。需要些茶水和点心可在些小坐。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
现在是正午时分，天阴着，凛冽的风呼呼的吹着。你一走进来，
就闻到一股茶香沁入心脾，精神为之一爽。几张桌子一字排开，
坐满了客人，或高声谈笑，或交头接耳。你要若想打听大陆掌故
和谣言，这里是个好所在。需要些茶水和点心可在些小坐。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
夜晚悄悄降临了，风裹尘沙，寒意袭人。你一走进来，就闻到一
股茶香沁入心脾，精神为之一爽。几张桌子一字排开，坐满了客
人，或高声谈笑，或交头接耳。你要若想打听大陆掌故和谣言，
这里是个好所在。需要些茶水和点心可在些小坐。
LONG
);
			else//入夜
				set("long",@LONG
夜幕笼罩著大地，风沙刺骨。你一走进来，就闻到一股茶香沁入
心脾，精神为之一爽。几张桌子一字排开，坐满了客人，或高声
谈笑，或交头接耳。你要若想打听大陆掌故和谣言，这里是个好
所在。需要些茶水和点心可在些小坐。
LONG
);
		}
		return 0;
	}
}




