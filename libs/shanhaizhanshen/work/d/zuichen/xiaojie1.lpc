inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "小街");
  set("long", @LONG
这是一条青石板铺成的小街，这里污水横流而过，臭气熏天，只
是时而有几只饥饿的巨鼠窜出来找东西吃，两边的房屋歪歪斜斜
的树立着，这些都是历次地震的产物，再加上周围的空气中弥漫
着一种紫色的怪雾.....人们一般不会到这种地方来的。

         __            _,-"~^"-.
       _// )      ,-"~`         `.
     ." ( /`"-,-"`                ;
    / 6                            ;
   /           ,            ,-"     ;
  (,__.--.      \          /        ;
   //'   /`-.\   |         |        `.__
     _.-'_/`  )  )-...,,,___\     \----,)
   ((("~` _.-'.-'          __`-.   )  (/______
        ((("`            (((---~"`     ""~

LONG
  );
  set("outdoors", "/d/zuichen");

  set("exits", ([
    "south": __DIR__ "xiaojie2",
    "northwest": __DIR__ "xiaojie",

  ]));

  setup();

}

void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
已经是午夜了，风挟卷着枯枝落叶，沙沙声不绝于耳。这是一条
青石板铺成的小街，这里污水横流而过，臭气熏天，只是时而有
几只饥饿的巨鼠窜出来找东西吃，两边的房屋歪歪斜斜的树立着，
这些都是历次地震的产物，再加上周围的空气中弥漫着一种紫色
的怪雾.....人们一般不会到这种地方来的。
