//by enter xiaoya

inherit ROOM;
int do_look(string arg);
void create()
{
        set("short","麻婆腐肉店");
        set("long", @LONG
这里就是闻名全大陆的麻婆腐肉店。店堂里整齐的摆放着十几张
红漆方桌,一般客人就在这里品尝麻婆腐肉。几个伙计忙的是晕
头转向。柜台上摆着两坛"血冷"和一把算盘,后面端坐着的就是
麻婆。东面是有个厨房。
LONG
        );
set("objects", ([
		__DIR__"npc/mapo" : 1,
                            	]));
        set("exits",([
                "west" : __DIR__"beijie1",               
                "east" : __DIR__"chufang",
        ]));
        
      
        setup();
       
}

 
void init()
{
		add_action("do_look","look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long",@LONG
已经是午夜了,风挟卷着枯枝落叶,沙沙声不绝于耳。这里就是
闻名全大陆的麻婆腐肉店。店堂里整齐的摆放着十几张红漆方桌,
一般客人就在这里品尝麻婆腐肉。几个伙计忙的是晕头转向。柜
台上摆着两坛"血冷"和一把算盘,后面端坐着的就是麻婆。东面
是有个厨房。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
天渐渐亮了,天空惨白的,大地还笼罩在夜幕之中。这里就是闻
名全大陆的麻婆腐肉店。店堂里整齐的摆放着十几张红漆方桌,
一般客人就在这里品尝麻婆腐肉。几个伙计忙的是晕头转向。柜
台上摆着两坛"血冷"和一把算盘,后面端坐着的就是麻婆。东面
是有个厨房。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
现在是正午时分,天阴着,凛冽的风呼呼的吹着。这里就是闻名
全大陆的麻婆腐肉店。店堂里整齐的摆放着十几张红漆方桌,一
般客人就在这里品尝麻婆腐肉。几个伙计忙的是晕头转向。柜台
上摆着两坛"血冷"和一把算盘,后面端坐着的就是麻婆。东面是
有个厨房。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
夜晚悄悄降临了,风裹尘沙,寒意袭人。这里就是闻名全大陆的
麻婆腐肉店。店堂里整齐的摆放着十几张红漆方桌,一般客人就
在这里品尝麻婆腐肉。几个伙计忙的是晕头转向。柜台上摆着两
坛"血冷"和一把算盘,后面端坐着的就是麻婆。东面是有个厨房。
LONG
);
			else//入夜
				set("long",@LONG
夜幕笼罩著大地,风沙刺骨。这里就是闻名全大陆的麻婆腐肉店。
店堂里整齐的摆放着十几张红漆方桌,一般客人就在这里品尝麻
婆腐肉。几个伙计忙的是晕头转向。柜台上摆着两坛"血冷"和一
把算盘,后面端坐着的就是麻婆。东面是有个厨房。
LONG
);
		}
		return 0;
	}
}


