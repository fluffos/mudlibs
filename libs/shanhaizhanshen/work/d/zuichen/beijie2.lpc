// Room: beijie1.c

inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "北大街");
	set("long", @LONG
你走在一条宽阔的青石大道上，这里污水横流而过，臭气熏天，
只是时而有几只饥饿的巨鼠窜出来找东西吃，两边的房屋歪歪斜
斜的树立着，这些都是历次地震的产物，再加上周围的空气中弥
漫着一种紫色的怪雾。。。。。人们一般不会到这种地方来的。
东面是一家赌场，阵阵喧闹声不断地传进你的耳朵里。西面是一
家珠宝店。

         __            _，-"~^"-。
       _// )      ，-"~`         `。
     。" ( /`"-，-"`                ;
    / 6                            ;
   /           ，            ，-"     ;
  (，__。--。      \          /        ;
   //'   /`-。\   |         |        `。__
     _。-'_/`  )  )-。。。，，，___\     \----，)
   ((("~` _。-'。-'          __`-。   )  (/______
        ((("`            (((---~"`     ""~
LONG
	);
	set("no_clean_up", 0);
	set("outdoors", "zuicheng");
	set("exits", ([ /* sizeof() == 4 */
                "north" : __DIR__"beijie1",
                "south" : __DIR__"guangchang",
                "east" : __DIR__"duchang",
                "west" : __DIR__"zhubaodian",  
]));

	setup();
	
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
