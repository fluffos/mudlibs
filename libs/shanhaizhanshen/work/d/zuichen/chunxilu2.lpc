//bye enter

#include <ansi.h>

inherit ROOM;
int do_look(string arg);
void create()
{
        set("short",HIY "春熙路" NOR);
         set("long", @LONG
你走在一条热闹的大道上，街上人群熙熙攘攘，可得当心小偷哦。
东面是个武器铺，西面有个钱庄，西南方有条青石巷。
LONG);

        set("outdoors", "/d/chengdu");

        set("exits", ([
                "south" : __DIR__"chunxilu3",
                "north" : __DIR__"chunxilu1",
                "west" : __DIR__"qianzhuang",
                "southwest" :__DIR__"qingshixiang1",
            ]));

        setup();
        
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
已经是午夜了，风挟卷着枯枝落叶，沙沙声不绝于耳。你走在一
条热闹的大道上，街上人群熙熙攘攘，可得当心小偷哦。东面是
个武器铺，西面有个钱庄，西南方有条青石巷。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
天渐渐亮了，天空惨白的，大地还笼罩在夜幕之中。你走在一条
热闹的大道上，街上人群熙熙攘攘，可得当心小偷哦。东面是个
武器铺，西面有个钱庄，西南方有条青石巷。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
现在是正午时分，天阴着，凛冽的风呼呼的吹着。你走在一条热
闹的大道上，街上人群熙熙攘攘，可得当心小偷哦。东面是个武
器铺，西面有个钱庄，西南方有条青石巷。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
夜晚悄悄降临了，风裹尘沙，寒意袭人。你走在一条热闹的大道
上，街上人群熙熙攘攘，可得当心小偷哦。东面是个武器铺，西
面有个钱庄，西南方有条青石巷。
LONG
);
			else//入夜
				set("long",@LONG
夜幕笼罩著大地，风沙刺骨。你走在一条热闹的大道上，街上人
群熙熙攘攘，可得当心小偷哦。东面是个武器铺，西面有个钱庄，
西南方有条青石巷。
LONG
);
		}
		return 0;
	}
}




