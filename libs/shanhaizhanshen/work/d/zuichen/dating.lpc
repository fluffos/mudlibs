//bye enter

inherit ROOM;
int do_look(string arg);
void create()
{
        set("short", "大厅");
	set("long", @LONG
你来到极乐宫会客的大厅里，这里灯火通明，屋内陈设很是精巧，
两个制作精美的有一人般高的骷髅放在厅的两侧，四周的墙上挂
着许多人皮字画，大厅上面有块匾，上书“万恶堂”三个大字。
LONG
	);
	set("exits", ([ 
            "south" : __DIR__"yuanzi",
            "northwest" : __DIR__"zoulang1",
            "northeast" : __DIR__"zoulang5",
            ]));
        

	setup();
	
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
已经是午夜了，风挟卷着枯枝落叶，沙沙声不绝于耳。你来到极
乐宫会客的大厅里，这里灯火通明，屋内陈设很是精巧，两个制
作精美的有一人般高的骷髅放在厅的两侧，四周的墙上挂着许多
人皮字画，大厅上面有块匾，上书“万恶堂”三个大字。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
天渐渐亮了，天空惨白的，大地还笼罩在夜幕之中。你来到极乐
宫会客的大厅里，这里灯火通明，屋内陈设很是精巧，两个制作
精美的有一人般高的骷髅放在厅的两侧，四周的墙上挂着许多人
皮字画，大厅上面有块匾，上书“万恶堂”三个大字。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
现在是正午时分，天阴着，凛冽的风呼呼的吹着。你来到极乐宫
会客的大厅里，这里灯火通明，屋内陈设很是精巧，两个制作精
美的有一人般高的骷髅放在厅的两侧，四周的墙上挂着许多人皮
字画，大厅上面有块匾，上书“万恶堂”三个大字。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
夜晚悄悄降临了，风裹尘沙，寒意袭人。你来到极乐宫会客的大
厅里，这里灯火通明，屋内陈设很是精巧，两个制作精美的有一
人般高的骷髅放在厅的两侧，四周的墙上挂着许多人皮字画，大
厅上面有块匾，上书“万恶堂”三个大字。
LONG
);
			else//入夜
				set("long",@LONG
夜幕笼罩著大地，风沙刺骨。你来到极乐宫会客的大厅里，这里
灯火通明，屋内陈设很是精巧，两个制作精美的有一人般高的骷
髅放在厅的两侧，四周的墙上挂着许多人皮字画，大厅上面有块
匾，上书“万恶堂”三个大字。
LONG
);
		}
		return 0;
	}
}
