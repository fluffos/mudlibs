// Room: houyuan.c

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "后院");
  set("long", @LONG
这里是个大大的后院，古树参天，知了在树上不停地叫着，有个
仆人在那里清扫着地面。
LONG
  );
  set("no_clean_up", 0);

  set("exits", ([ /* sizeof() == 3 */
    "west": __DIR__ "zoulang3",
    "east": __DIR__ "zoulang5.lpc",
    "north": __DIR__ "zoulang4",
  ]));
  set("outdoors", "zuichen");

  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
已经是午夜了，风挟卷着枯枝落叶，沙沙声不绝于耳。这里是个
大大的后院，古树参天，知了在树上不停地叫着，有个仆人在那
里清扫着地面。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
天渐渐亮了，天空惨白的，大地还笼罩在夜幕之中。这里是个大
大的后院，古树参天，知了在树上不停地叫着，有个仆人在那里
清扫着地面。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
现在是正午时分，天阴着，凛冽的风呼呼的吹着。这里是个大大
的后院，古树参天，知了在树上不停地叫着，有个仆人在那里清
扫着地面。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
夜晚悄悄降临了，风裹尘沙，寒意袭人。这里是个大大的后院，
古树参天，知了在树上不停地叫着，有个仆人在那里清扫着地面。
LONG
        );
      else  //入夜
        set("long", @LONG
夜幕笼罩著大地，风沙刺骨。这里是个大大的后院，古树参天，
知了在树上不停地叫着，有个仆人在那里清扫着地面。
LONG
        );
    }
    return 0;
  }
}
