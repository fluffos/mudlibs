//bye enter

inherit ROOM;
int do_look(string arg);
void create()
{
        set("short", "西厢房");
	set("long", @LONG
这是供来客休息的厢房，房子不大，但是很整洁，墙上挂着一些
人皮字画。有个丫鬟正忙着为客人泡茶。
LONG
	);
	set("exits", ([ 
            "east" : __DIR__"yuanzi",
            ]));
        

	setup();
	
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
已经是午夜了，风挟卷着枯枝落叶，沙沙声不绝于耳。这是供来
客休息的厢房，房子不大，但是很整洁，墙上挂着一些人皮字画。
有个丫鬟正忙着为客人泡茶。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
天渐渐亮了，天空惨白的，大地还笼罩在夜幕之中。这是供来客
休息的厢房，房子不大，但是很整洁，墙上挂着一些人皮字画。
有个丫鬟正忙着为客人泡茶。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
现在是正午时分，天阴着，凛冽的风呼呼的吹着。这是供来客休
息的厢房，房子不大，但是很整洁，墙上挂着一些人皮字画。有
个丫鬟正忙着为客人泡茶。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
夜晚悄悄降临了，风裹尘沙，寒意袭人。这是供来客休息的厢房，
房子不大，但是很整洁，墙上挂着一些人皮字画。有个丫鬟正忙
着为客人泡茶。
LONG
);
			else//入夜
				set("long",@LONG
夜幕笼罩著大地，风沙刺骨。这是供来客休息的厢房，房子不大，
但是很整洁，墙上挂着一些人皮字画。有个丫鬟正忙着为客人泡茶。
LONG
);
		}
		return 0;
	}
}
