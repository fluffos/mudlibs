//by enter

inherit ROOM;
int do_look(string arg);
void create()
{
        set("short", "东大街");
        set("long", @LONG
这条街贯穿极乐城大街小巷，因这条街沿街都是有钱有势的酒楼
、饭馆，所以又称为“美食街”。这里店铺林立，商贾成群。白
天这里车马如龙，人声鼎沸，夜里星光伴月，灯火通明。南边便
是极乐城著名的商业中心：春熙路。北边有个客栈。
LONG
        );

        set("exits", ([
                "north" : __DIR__"kedian",
                "south" : __DIR__"chunxilu",
                "west" : __DIR__"guangchang",
                "east" : __DIR__"dongjie2",                
        ]));
        set("outdoors","zuicheng");
      
        setup();
       }

 
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
已经是午夜了，风挟卷着枯枝落叶，沙沙声不绝于耳。这条街贯
穿极乐城大街小巷，因这条街沿街都是有钱有势的酒楼、饭馆，
所以又称为“美食街”。这里店铺林立，商贾成群。白天这里车
马如龙，人声鼎沸，夜里星光伴月，灯火通明。南边便是极乐城
著名的商业中心：春熙路。北边有个客栈。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
天渐渐亮了，天空惨白的，大地还笼罩在夜幕之中。这条街贯穿
极乐城大街小巷，因这条街沿街都是有钱有势的酒楼、饭馆，所
以又称为“美食街”。这里店铺林立，商贾成群。白天这里车马
如龙，人声鼎沸，夜里星光伴月，灯火通明。南边便是极乐城著
名的商业中心：春熙路。北边有个客栈。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
现在是正午时分，天阴着，凛冽的风呼呼的吹着。这条街贯穿极
乐城大街小巷，因这条街沿街都是有钱有势的酒楼、饭馆，所以
又称为“美食街”。这里店铺林立，商贾成群。白天这里车马如
龙，人声鼎沸，夜里星光伴月，灯火通明。南边便是极乐城著名
的商业中心：春熙路。北边有个客栈。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
夜晚悄悄降临了，风裹尘沙，寒意袭人。这条街贯穿极乐城大街
小巷，因这条街沿街都是有钱有势的酒楼、饭馆，所以又称为“
美食街”。这里店铺林立，商贾成群。白天这里车马如龙，人声
鼎沸，夜里星光伴月，灯火通明。南边便是极乐城著名的商业中
心：春熙路。北边有个客栈。
LONG
);
			else//入夜
				set("long",@LONG
夜幕笼罩著大地，风沙刺骨。这条街贯穿极乐城大街小巷，因这
条街沿街都是有钱有势的酒楼、饭馆，所以又称为“美食街”。
这里店铺林立，商贾成群。白天这里车马如龙，人声鼎沸，夜里
星光伴月，灯火通明。南边便是极乐城著名的商业中心：春熙路。
北边有个客栈。
LONG
);
		}
		return 0;
	}
}
