// Room: /city/kedian3。c
// YZC 1995/12/04 

inherit ROOM;
int do_look(string arg);
void create()
{
        set("short", "东厢客房");
	set("long"， @LONG
这是一间很大的客房，陈设十分简陋。靠墙放了十几张小木床，
不少客人正和衣而卧，满屋子都是呼呼的打酣声。西边有张床是
空的，你蹑手蹑脚地走了过去。
LONG
	);

	
	set("sleep_room"， "1");
	set("no_fight"， "1");
        set("hotel"，1);

	set("exits"， ([
                "west" : __DIR__"cdkedian2"，
	]));

	setup();
}

int valid_leave(object me， string dir)
{
	if ( dir == "out" ) me->delete_temp("rent_paid");

	return ::valid_leave(me， dir);
}
void init()
{
		add_action("do_look"， "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long"， @LONG
已经是午夜了，风挟卷着枯枝落叶，沙沙声不绝于耳。这是一间
很大的客房，陈设十分简陋。靠墙放了十几张小木床，不少客人
正和衣而卧，满屋子都是呼呼的打酣声。西边有张床是空的，你
蹑手蹑脚地走了过去。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long"，@LONG
天渐渐亮了，天空惨白的，大地还笼罩在夜幕之中。这是一间很
大的客房，陈设十分简陋。靠墙放了十几张小木床，不少客人正
和衣而卧，满屋子都是呼呼的打酣声。西边有张床是空的，你蹑
手蹑脚地走了过去。
LONG
);
			else if (local[2] < 15)//正午
				set("long"，@LONG
现在是正午时分，天阴着，凛冽的风呼呼的吹着。这是一间很大
的客房，陈设十分简陋。靠墙放了十几张小木床，不少客人正和
衣而卧，满屋子都是呼呼的打酣声。西边有张床是空的，你蹑手
蹑脚地走了过去。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long"，@LONG
夜晚悄悄降临了，风裹尘沙，寒意袭人。这是一间很大的客房，
陈设十分简陋。靠墙放了十几张小木床，不少客人正和衣而卧，
满屋子都是呼呼的打酣声。西边有张床是空的，你蹑手蹑脚地走
了过去。
LONG
);
			else//入夜
				set("long"，@LONG
夜幕笼罩著大地，风沙刺骨。这是一间很大的客房，陈设十分简
陋。靠墙放了十几张小木床，不少客人正和衣而卧，满屋子都是
呼呼的打酣声。西边有张床是空的，你蹑手蹑脚地走了过去。
LONG
);
		}
		return 0;
	}
}




