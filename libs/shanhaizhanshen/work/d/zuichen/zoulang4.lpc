//bye enter

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "走廊尽头");
  set("long", @LONG
你来到走廊的尽头，往北看去是好大的一个湖泊，前面有个小亭，
极乐城主还真会享受。
LONG
  );
  set("exits", ([
    "north": __DIR__ "tingzi",
    "southeast": __DIR__ "zoulang7",
    "south": __DIR__ "houyuan",
    "southwest": __DIR__ "zoulang3",
  ]));

  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
已经是午夜了，风挟卷着枯枝落叶，沙沙声不绝于耳。你来到走
廊的尽头，往北看去是好大的一个湖泊，前面有个小亭，极乐城
主还真会享受。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
天渐渐亮了，天空惨白的，大地还笼罩在夜幕之中。你来到走廊
的尽头，往北看去是好大的一个湖泊，前面有个小亭，极乐城主
还真会享受。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
现在是正午时分，天阴着，凛冽的风呼呼的吹着。你来到走廊的
尽头，往北看去是好大的一个湖泊，前面有个小亭，极乐城主还
真会享受。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
夜晚悄悄降临了，风裹尘沙，寒意袭人。你来到走廊的尽头，往
北看去是好大的一个湖泊，前面有个小亭，极乐城主还真会享受。
LONG
        );
      else  //入夜
        set("long", @LONG
夜幕笼罩著大地，风沙刺骨。你来到走廊的尽头，往北看去是好
大的一个湖泊，前面有个小亭，极乐城主还真会享受。
LONG
        );
    }
    return 0;
  }
}
