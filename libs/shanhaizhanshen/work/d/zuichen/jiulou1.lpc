
inherit ROOM;
int do_look(string arg);
void create()
{
        set("short", "银杏酒楼");
        set("long", @LONG
这里就是城里最豪华的银杏酒楼，银杏酒楼的历史悠久，菜式以
麻辣为主，因为这里一年四季都很潮湿，多吃点辣椒既开胃健脾，
又强身益寿，宽敞明亮而又富丽堂皇的大厅高朋满座，小二哥满
头大汗的招呼着所有嘉宾，不时传来阵阵欢歌笑语......

                ~  ~
              ( o )o)
             ( o )o )o)
           (o( ~~~~~~~~o
           ( )' ~~~~~~~'
           ( )|)       |-.
             o|  美    |-. \
             o|        |  \ \
              |   酒   |   | |
             o|        |  / /
              |        |." "
              |        |- '
              .========.   
LONG);

        

        set("exits", ([               
                "west"   : __DIR__"chunxilu1",
                "up"   : __DIR__"jiulou2",
            ]));
        setup();
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
