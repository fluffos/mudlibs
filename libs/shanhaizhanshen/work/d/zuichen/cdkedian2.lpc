// Room: /chengdu/cdkedian2.c
// oooc: 1998/06/20 

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "客栈二楼");
  set("long", @LONG
你正走在客店二楼的走廊上，可以听到从客房里不时地呼呼的打
酣声，一阵高过一阵。不时有睡意朦胧的旅客进进出出，到楼下
的掌柜处付了钱再上来睡觉。
LONG
  );

  set("exits", ([
    "down": __DIR__ "cdkedian",
    "east": __DIR__ "cdkedian3",
    "west": __DIR__ "cdkedian4",
  ]));

  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
已经是午夜了，风挟卷着枯枝落叶，沙沙声不绝于耳。你正走在
客店二楼的走廊上，可以听到从客房里不时地呼呼的打酣声，一
阵高过一阵。不时有睡意朦胧的旅客进进出出，到楼下的掌柜处
付了钱再上来睡觉。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
天渐渐亮了，天空惨白的，大地还笼罩在夜幕之中。你正走在客
店二楼的走廊上，可以听到从客房里不时地呼呼的打酣声，一阵
高过一阵。不时有睡意朦胧的旅客进进出出，到楼下的掌柜处付
了钱再上来睡觉。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
现在是正午时分，天阴着，凛冽的风呼呼的吹着。你正走在客店
二楼的走廊上，可以听到从客房里不时地呼呼的打酣声，一阵高
过一阵。不时有睡意朦胧的旅客进进出出，到楼下的掌柜处付了
钱再上来睡觉。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
夜晚悄悄降临了，风裹尘沙，寒意袭人。你正走在客店二楼的走
廊上，可以听到从客房里不时地呼呼的打酣声，一阵高过一阵。
不时有睡意朦胧的旅客进进出出，到楼下的掌柜处付了钱再上来
睡觉。
LONG
        );
      else  //入夜
        set("long", @LONG
夜幕笼罩著大地，风沙刺骨。你正走在客店二楼的走廊上，可以
听到从客房里不时地呼呼的打酣声，一阵高过一阵。不时有睡意
朦胧的旅客进进出出，到楼下的掌柜处付了钱再上来睡觉。
LONG
        );
    }
    return 0;
  }
}
