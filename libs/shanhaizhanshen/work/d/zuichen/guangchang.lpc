     _.-'_/`  )  )-...,,,___\     \----,)
   ((("~` _.-'.-'          __`-.   )  (/______
        ((("`            (((---~"`     ""~
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
