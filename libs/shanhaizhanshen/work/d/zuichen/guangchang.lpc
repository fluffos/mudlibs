//by enter xiaoya

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "极乐城中心");
  set("long", @LONG
这里是极乐城的中心，这里污水横流而过，臭气熏天，只是时而
有几只饥饿的巨鼠窜出来找东西吃，周围的空气中弥漫着一种紫
色的怪雾.....人们一般不会到这种地方来的。

         __            _,-"~^"-.
       _// )      ,-"~`         `.
     ." ( /`"-,-"`                ;
    / 6                            ;
   /           ,            ,-"     ;
  (,__.--.      \          /        ;
   //'   /`-.\   |         |        `.__
     _.-'_/`  )  )-...,,,___\     \----,)
   ((("~` _.-'.-'          __`-.   )  (/______
        ((("`            (((---~"`     ""~

LONG
  );

  set("exits", ([
    "north": __DIR__ "beijie2",
    "south": __DIR__ "nanjie1",
    "west": __DIR__ "xijie2",
    "east": __DIR__ "dongjie1",
  ]));
  set("outdoors", "zuicheng");


  setup();

}


void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
已经是午夜了，风挟卷着枯枝落叶，沙沙声不绝于耳。这里是极
乐城的中心，这里污水横流而过，臭气熏天，只是时而有几只饥
饿的巨鼠窜出来找东西吃，周围的空气中弥漫着一种紫色的怪雾
.....人们一般不会到这种地方来的。

