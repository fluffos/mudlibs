//by enter xiaoya

inherit ROOM;
int do_look(string arg);
void create()
{
        set("short", "厨房");
        set("long", @LONG
一张长长的灶台上放了五六口铁锅,每口锅面前都有一位大师傅,
他们正在汗流浃背地炒着肉。
LONG
        );

        set("exits", ([
                "west" : __DIR__"chenmapo",                
        ]));
        
      
        setup();
        
}

 
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
已经是午夜了，风挟卷着枯枝落叶，沙沙声不绝于耳。一张长长
的灶台上放了五六口铁锅,每口锅面前都有一位大师傅,他们正在
汗流浃背地炒着肉。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
天渐渐亮了，天空惨白的，大地还笼罩在夜幕之中。一张长长的
灶台上放了五六口铁锅,每口锅面前都有一位大师傅,他们正在汗
流浃背地炒着肉。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
现在是正午时分，天阴着，凛冽的风呼呼的吹着。一张长长的灶
台上放了五六口铁锅,每口锅面前都有一位大师傅,他们正在汗流
浃背地炒着肉。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
夜晚悄悄降临了，风裹尘沙，寒意袭人。一张长长的灶台上放了
五六口铁锅,每口锅面前都有一位大师傅,他们正在汗流浃背地炒
着肉。
LONG
);
			else//入夜
				set("long",@LONG
夜幕笼罩著大地，风沙刺骨。一张长长的灶台上放了五六口铁锅
每口锅面前都有一位大师傅,他们正在汗流浃背地炒着肉。
LONG
);
		}
		return 0;
	}
}


