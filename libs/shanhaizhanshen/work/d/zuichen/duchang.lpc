//by enter xiaoya

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "赌场");
  set("long", @LONG
这里是一家赌场,进门你就会看见遒劲有力的四个大字"愿赌服输"。
极乐城的赌场是全大陆最豪华最放肆的地方，在这里只认钱，有钱
就是老大。没钱的人最好回家抱娃娃去。
LONG
  );

  set("exits", ([
    "west": __DIR__ "beijie2",

  ]));

  setup();
}

int valid_leave(object me, string dir) {
  if (dir == "east" && this_player()->query("age") < 14)
    return notify_fail("小娃儿家家的往里头拱啥子?!\n");
  return ::valid_leave(me, dir);
}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
已经是午夜了，风挟卷着枯枝落叶，沙沙声不绝于耳。这里是一
家赌场，进门你就会看见遒劲有力的四个大字"愿赌服输"。极乐
城的赌场是全大陆最豪华最放肆的地方，在这里只认钱，有钱就
是老大。没钱的人最好回家抱娃娃去。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
天渐渐亮了，天空惨白的，大地还笼罩在夜幕之中。这里是一家
赌场，进门你就会看见遒劲有力的四个大字"愿赌服输"。极乐城
的赌场是全大陆最豪华最放肆的地方，在这里只认钱，有钱就是
老大。没钱的人最好回家抱娃娃去。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
现在是正午时分，天阴着，凛冽的风呼呼的吹着。这里是一家赌
场，进门你就会看见遒劲有力的四个大字"愿赌服输"。极乐城的
赌场是全大陆最豪华最放肆的地方，在这里只认钱，有钱就是老
大。没钱的人最好回家抱娃娃去。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
夜晚悄悄降临了，风裹尘沙，寒意袭人。这里是一家赌场，进门
你就会看见遒劲有力的四个大字"愿赌服输"。极乐城的赌场是全
大陆最豪华最放肆的地方，在这里只认钱，有钱就是老大。没钱
的人最好回家抱娃娃去。
LONG
        );
      else  //入夜
        set("long", @LONG
夜幕笼罩著大地，风沙刺骨。这里是一家赌场，进门你就会看见
遒劲有力的四个大字"愿赌服输"。极乐城的赌场是全大陆最豪华
最放肆的地方，在这里只认钱，有钱就是老大。没钱的人最好回
家抱娃娃去。
LONG
        );
    }
    return 0;
  }
}
