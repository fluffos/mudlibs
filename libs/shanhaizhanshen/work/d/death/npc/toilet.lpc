// shadow.c

#include <ansi.h>
#include <login.h>

inherit NPC;

string *death_msg = ({
  GRN "史巴克平静地说道：“我是这个地下世界的主管。”\n" NOR,
  GRN "史巴克向您说道：“时候不早了，您一定急着想回去吧？”\n"
  "“不好意思耽误您宝贵的时间。”\n" NOR,
  GRN "史巴克似乎不舍得结束与你的会面，叹了口气。\n" NOR,
  HIW "你的全身突然笼罩在白色的光晕之中，四周的景物渐渐地模糊了起来。\n" NOR,
  HIW "史巴克向您做了最后的道别。\n" NOR
});

void create() {
  set_name(HIW "
    
      /    \\    
     J \\  / L   
      \\,--./    
    __/`--'\\__   
  ,' J`\\  /'L `. 
      \\ || /     
       J--L     
    --`    `--  
" NOR, ({ "Spock" }));
  set("title", "混蟑螂史巴克");
  set("long",
    "地狱主管－－－混蟑螂史巴克。\n");
  set("attitude", "peaceful");
  set("chat_chance", 7);
  set("chat_msg", ({
    "$N 负责将死去的灵魂送回(return)人世。\n",
    "$N 如果你急着赶回人世，您可以(say return)。\n",

  }));

  set("age", 19);
  set("level", 1000);
  set("combat_exp", 5000000);

  set("str", 12);
  set("dex", 15);
  set("not", 24);
  set("int", 22);
  set("wis", 20);
  set("con", 13);
  set("cha", 15);
  set("tec", 23);

  set_temp("apply/astral_vision", 1);

  set_skill("parry", 100);
  set_skill("dodge", 100);
  set_skill("unarmed", 100);

  setup();

  carry_object(__DIR__ "obj/white_robe")->wear();
}

void init() {
  ::init();
  if (!previous_object()
    || !userp(previous_object())) return;
}

void death_stage(object ob, int stage) {
  if (!ob || !present(ob)) return;

  tell_object(ob, death_msg[stage]);
  if (++stage < sizeof(death_msg)) {
    call_out("death_stage", 5, ob, stage);
    return;
  } else
    ob->reincarnate();

  message_vision_exclude(
    ob->name() + "全身笼罩在柔和的白光之中，慢慢地消失在你面前。\n", ob, ({ ob }));
  ob->move(REVIVE_ROOM);
  message_vision_exclude(
    "一道光芒忽然出现在你面前！光芒消逝之后，一个人影躺\n"
    "在你的面前。那人缓缓地张开眼睛，站了起来。\n", ob, ({ ob }));
}

void relay_say(object ob, string msg) {
  int *limbs_eff_hit_s, *limbs_max_hit_s;
  int i, flag;

  if (!userp(ob)) return;
  if (ob == this_object()) return;

  if (msg == "return") {
    limbs_eff_hit_s = ob->query("limbs_eff_hit");
    limbs_max_hit_s = ob->query("limbs_max_hit");

    for (i = 0; i < sizeof(ob->query("limbs")); i++) {
      if (limbs_eff_hit_s[i] * 10 / limbs_max_hit_s[i] < 5)
        flag = 1;
    }
    if (flag == 1) {
      message_vision("$N 说道：您目前的状况还无法回到人世，请多休息一下吧。\n", this_object());
      return;
    }
    call_out("death_stage", 1, ob, 0);
  }
  return;
}

void relay_emote(object ob, string verb) {
  if (verb == "bow")
    this_object()->relay_say(ob, "return");
  return;
}
