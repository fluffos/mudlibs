//yamen
  

inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "红龙府");
	set("long", @LONG
这就是星龙城城主红龙的府第，走进这里你突然感到有点心惊胆
颤。两边的侍卫冷冷的看着你。
LONG
	);
set("objects", ([
		__DIR__"npc/lingnan" : 1,
                              	]));
	set("exits", ([
		"east" : __DIR__"wendingbei3",
		"enter" : __DIR__"zoulang",
		
	]));
	 
	setup();
	
}

void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
凌晨，东方的天空布满了灰蒙蒙的云层。这就是星龙城城主红龙
的府第，走进这里你突然感到有点心惊胆颤。两边的侍卫冷冷的
看着你。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
清晨，太阳露在东方的地平线上，显示了一天的勃勃生机。这就
是星龙城城主红龙的府第，走进这里你突然感到有点心惊胆颤。
两边的侍卫冷冷的看着你。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
现在是正午时分，太阳高挂天心，肆意地淫虐。这就是星龙城城
主红龙的府第，走进这里你突然感到有点心惊胆颤。两边的侍卫
冷冷的看着你。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
傍晚，一轮火红的夕阳正徘徊在西方的地平线上。这就是星龙城
城主红龙的府第，走进这里你突然感到有点心惊胆颤。两边的侍
卫冷冷的看着你。
LONG
);
			else//入夜
				set("long",@LONG
夜晚，夜幕开始渐渐笼罩著大地。这就是星龙城城主红龙的府第，
走进这里你突然感到有点心惊胆颤。两边的侍卫冷冷的看着你。
LONG
);
		}
		return 0;
	}
}


