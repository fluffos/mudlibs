//yanling
inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "碧玉西路");
  set("long", @LONG
从城中心往西走就到了碧玉西路，这里是星龙城的一条老街。两
边的房屋看上去已经很陈旧了。街道的南面的一间房子看上去象
一个店铺。
LONG);

  set("outdoors", "/d/mohao");

  set("exits", ([
    "west": __DIR__ "yanling1",
    "south": __DIR__ "dangpu",
    "east": __DIR__ "shizhongxin",
  ]));


  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
凌晨，东方的天空布满了灰蒙蒙的云层。从城中心往西走就到了
碧玉西路，这里是星龙城的一条老街。两边的房屋看上去已经很
陈旧了。街道的南面的一间房子看上去象一个店铺。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
清晨，太阳露在东方的地平线上，显示了一天的勃勃生机。从城
中心往西走就到了碧玉西路，这里是星龙城的一条老街。两边的
房屋看上去已经很陈旧了。街道的南面的一间房子看上去象一个
店铺。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
现在是正午时分，太阳高挂天心，肆意地淫虐。从城中心往西走
就到了碧玉西路，这里是星龙城的一条老街。两边的房屋看上去
已经很陈旧了。街道的南面的一间房子看上去象一个店铺。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
傍晚，一轮火红的夕阳正徘徊在西方的地平线上。从城中心往西
走就到了碧玉西路，这里是星龙城的一条老街。两边的房屋看上
去已经很陈旧了。街道的南面的一间房子看上去象一个店铺。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚，夜幕开始渐渐笼罩著大地。从城中心往西走就到了碧玉西
路，这里是星龙城的一条老街。两边的房屋看上去已经很陈旧了。
街道的南面的一间房子看上去象一个店铺。
LONG
        );
    }
    return 0;
  }
}
