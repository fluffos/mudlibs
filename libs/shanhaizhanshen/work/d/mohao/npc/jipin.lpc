inherit NPC;
void prepare_kill();
void create() {
  set_name("季平", ({ "ji pin" }));
  set("title", "药师");
  set("gender", "男性");
  set("age", 25 + random(5) + 10 + random(5));

  set("long", @LONG
他的容貌和蔼，头发微秃，正忙着招呼来往的客人。    
LONG
  );
  set("str", 5 + random(5) + random(5));  //力量 (str):	5 ~ 15
  set("dex", 6 + random(5) + random(8));  //敏捷 (dex):	6 ~ 19
  set("int", 5 + random(5) + random(5) + random(5) + random(3));  //智力 (int):	5 ~ 23
  set("not", 4 + random(5) + random(4) + 2 + random(3));  //注意 (not):	4 ~ 18
  set("con", 7 + random(5) + random(5));  //体质 (con):	7 ~ 17
  set("tec", 2 + random(5) + 6 + random(5) + 4);  //技术 (tec):	2 ~ 22
  set("level", 20 + random(10) + random(10));
  set("combat_exp", 60000 + random(50000) + 30000 + random(100000));
  set("attitude", "friendly");

  set("score", 20 + random(7) + 3 + random(10));





  set("home_time", ([
    "8-21": "/d/lwe/shop2.lpc",
  ]));
  set("mob_program", ([
    "0": ({ "npcsleep",
      "npcsleep",
    }),
    "1": ({ "say 1",
      "say 1",
    }),
    "2": ({ "wake",
      "say 2",
    }),
    "3": ({ "say 3"
    }),
    "4": ({ "say 4",
      "",
    }),
    "5": ({ "unlock door with key2",
      "unlock door with key2",
    }),
    "6": ({ "open door",
      "open door",

    }),
    "7": ({ "say 开门做生意啦！！！",
      "west",
    }),
    "8": ({ "west",
      "west",
    }),
    "9": ({ "west",
      "west",
    }),
    "10": ({ "say hi hi ",
      "",
    }),
    "11": ({ "say 11",
      "",
    }),
    "12": ({ "say 12",
      "",
    }),
    "13": ({ "say sdlkf",
      "",
    }),
    "14": ({ "say 14",
      "",
    }),
    "15": ({ "say 15",
      "",
    }),
    "16": ({ "say 16",
      "",
    }),
    "17": ({ "say 17",
      "",
    }),
    "18": ({ "say 18",
      "",
    }),
    "19": ({ "say 19",
      "",
    }),
    "20": ({ "say 20",
      "",
    }),
    "21": ({ "say 本日营业到此为止。\n",
      "say 各位明日请早。",
    }),
    "22": ({ "close door",
      "close door",
    }),
    "23": ({ "lock door with key2",
      "lock door with key2",
    }),
  ]));
  set("mob_program_delay", ([
    "1": ({ 5, 2,
    }),
    "2": ({ 5, 2,
    }),
    "3": ({ 5, 2,
    }),
    "4": ({ 5, 2,
    }),
    "5": ({ 5, 2,
    }),
    "6": ({ 5, 2,
    }),
    "7": ({ 5, 2,
    }),
    "8": ({ 5, 2,
    }),
    "9": ({ 5, 2,
    }),
    "10": ({ 5, 2,
    }),
    "11": ({ 5, 2,
    }),
    "12": ({ 5, 2,
    }),
    "13": ({ 5, 2,
    }),
    "14": ({ 5, 2,
    }),
    "15": ({ 5, 2,
    }),
    "16": ({ 5, 2,
    }),
    "17": ({ 5, 2,
    }),
    "18": ({ 5, 2,
    }),
    "19": ({ 5, 2,
    }),
    "20": ({ 5, 2,
    }),
    "21": ({ 5, 5,
    }),
    "22": ({ 5, 2,
    }),
    "23": ({ 5, 2,
    }),
  ]));
  setup();

  add_money("gold", 1 + random(5) + 6 + random(5) + 9);
  add_money("silver", 10 + random(5) + 6 + random(5) + 9);
  add_money("copper", 10 + random(5) + 6 + random(5) + 9);
  carry_object("/obj/move/dfly")->wear();
  carry_object("/obj/wear/pants")->wear();


}






void prepare_kill() {
  if (query_temp("pending/prepare_kill")) return;

  command("wield dagger");
  command("say 哼 ! 你这个杀人的凶手 !!");
  set_temp("pending/prepare_kill", 1);
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }

}
int accept_object(object who, object ob) {

  if (ob->query("money_id") && ob->value() >= 2000) {
    tell_object(who, "季平说道：好吧，既然收了你的钱，这点小伤我就帮你医治吧。\n");

    who->set("spi", who->query("max_spi"));
    who->set("eff_spi", who->query("max_spi"));
    who->set("mov", who->query("max_mov"));
    return 1;
  }

  return 0;
}
