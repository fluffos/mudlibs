//huayuan	
  

inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "小花园");
	set("long", @LONG
这是红龙府前的小花园，花草树木，鸟语花香。好一个悠闲的地
方。透过一簇牡丹花，看见北面就是红龙的府邸。西面的厢房略
微陈旧一点。可能是府内下人的屋子。
LONG
	);
set("outdoors","/d/zhongzhou");

	set("exits", ([
		"west" : __DIR__"xiaren",
		"north" : __DIR__"taiyefu",
		"east" :__DIR__"zoulang", 
	]));


	setup();
	
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
凌晨，东方的天空布满了灰蒙蒙的云层。这是红龙府前的小花园，
花草树木，鸟语花香。好一个悠闲的地方。透过一簇牡丹花，看
见北面就是红龙的府邸。西面的厢房略微陈旧一点。可能是府内
下人的屋子。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
清晨，太阳露在东方的地平线上，显示了一天的勃勃生机。这是
红龙府前的小花园，花草树木，鸟语花香。好一个悠闲的地方。
透过一簇牡丹花，看见北面就是红龙的府邸。西面的厢房略微陈
旧一点。可能是府内下人的屋子。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
现在是正午时分，太阳高挂天心，肆意地淫虐。这是红龙府前的
小花园，花草树木，鸟语花香。好一个悠闲的地方。透过一簇牡
丹花，看见北面就是红龙的府邸。西面的厢房略微陈旧一点。可
能是府内下人的屋子。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
傍晚，一轮火红的夕阳正徘徊在西方的地平线上。这是红龙府前
的小花园，花草树木，鸟语花香。好一个悠闲的地方。透过一簇
牡丹花，看见北面就是红龙的府邸。西面的厢房略微陈旧一点。
可能是府内下人的屋子。
LONG
);
			else//入夜
				set("long",@LONG
夜晚，夜幕开始渐渐笼罩著大地。这是红龙府前的小花园，花草
树木，鸟语花香。好一个悠闲的地方。透过一簇牡丹花，看见北
面就是红龙的府邸。西面的厢房略微陈旧一点。可能是府内下人
的屋子。
LONG
);
		}
		return 0;
	}
}


