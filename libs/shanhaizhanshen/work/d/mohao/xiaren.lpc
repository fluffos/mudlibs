//xiaren	


inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "西厢房");
  set("long", @LONG
这里是红龙府下人的住处。屋内没什么东西，只有一张桌子和几
张竹凳。屋角的盆里放着一大堆的衣服。
LONG
  );
  set("objects", ([
    __DIR__ "npc/suilan": 1,
  ]));
  set("exits", ([
    "east": __DIR__ "huayuan",

  ]));

  setup();

}

void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
凌晨，东方的天空布满了灰蒙蒙的云层。这里是红龙府下人的住
处。屋内没什么东西，只有一张桌子和几张竹凳。屋角的盆里放
着一大堆的衣服。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
清晨，太阳露在东方的地平线上，显示了一天的勃勃生机。这里
是红龙府下人的住处。屋内没什么东西，只有一张桌子和几张竹
凳。屋角的盆里放着一大堆的衣服。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
现在是正午时分，太阳高挂天心，肆意地淫虐。这里是红龙府下
人的住处。屋内没什么东西，只有一张桌子和几张竹凳。屋角的
盆里放着一大堆的衣服。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
傍晚，一轮火红的夕阳正徘徊在西方的地平线上。这里是红龙府
下人的住处。屋内没什么东西，只有一张桌子和几张竹凳。屋角
的盆里放着一大堆的衣服。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚，夜幕开始渐渐笼罩著大地。这里是红龙府下人的住处。屋
内没什么东西，只有一张桌子和几张竹凳。屋角的盆里放着一大
堆的衣服。
LONG
        );
    }
    return 0;
  }
}
