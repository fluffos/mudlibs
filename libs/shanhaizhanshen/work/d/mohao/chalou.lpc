// Room: /d/zhongzhou/chalou.c

#include <room.h>
inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "茶楼");
  set("long", @LONG
这里是一间茶楼，虽说是一家不小的茶楼，可店里却没几个人。
里面好象有个楼梯往上，微微从上面透出的味道让人闻了头有点
发昏。
LONG
  ); set("objects", ([
    __DIR__ "npc/qianquxue": 1,
  ]));
  set("exits", ([ /* sizeof() == 3 */

    "east": __DIR__ "wendingnan2",

  ]));
  set("no_clean_up", 0);
  set("doors", ([
    "east": ([
      "data": "门",
      "other_side_dir": "west",
      //	"status"	:	DOOR_LOCKED,
      "key_id": "mohao/chalou_key",
    ]), ]));

  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
凌晨，东方的天空布满了灰蒙蒙的云层。这里是一间茶楼，虽说
是一家不小的茶楼，可店里却没几个人。里面好象有个楼梯往上，
微微从上面透出的味道让人闻了头有点发昏。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
清晨，太阳露在东方的地平线上，显示了一天的勃勃生机。这里
是一间茶楼，虽说是一家不小的茶楼，可店里却没几个人。里面
好象有个楼梯往上，微微从上面透出的味道让人闻了头有点发昏。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
现在是正午时分，太阳高挂天心，肆意地淫虐。这里是一间茶楼，
虽说是一家不小的茶楼，可店里却没几个人。里面好象有个楼梯
往上，微微从上面透出的味道让人闻了头有点发昏。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
傍晚，一轮火红的夕阳正徘徊在西方的地平线上。这里是一间茶
楼，虽说是一家不小的茶楼，可店里却没几个人。里面好象有个
楼梯往上，微微从上面透出的味道让人闻了头有点发昏。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚，夜幕开始渐渐笼罩著大地。这里是一间茶楼，虽说是一家
不小的茶楼，可店里却没几个人。里面好象有个楼梯往上，微微
从上面透出的味道让人闻了头有点发昏。
LONG
        );
    }
    return 0;
  }
}
