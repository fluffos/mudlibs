//taiyefu	
  

inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "红龙府");
	set("long", @LONG  
整个大厅的家具都是用红玉精心打磨制造的，外面的光照进来反
射出一片暗暗的红光。就像红龙的眼睛的颜色一样透着血一般鲜
红光芒。
LONG
	);
            set("objects", ([
		__DIR__"npc/sangya" : 1,
                              	]));
	set("exits", ([
		"south" : __DIR__"huayuan",
		 		 
	]));

	setup();
	
}

void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
凌晨，东方的天空布满了灰蒙蒙的云层。整个大厅的家具都是用
红玉精心打磨制造的，屋里的光照在家具上反射出一片暗暗的红
光。就像红龙的眼睛的颜色一样透着血一般鲜红光芒。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
清晨，太阳露在东方的地平线上，显示了一天的勃勃生机。整个
大厅的家具都是用红玉精心打磨制造的，外面的光照进来反射出
一片暗暗的红光。就像红龙的眼睛的颜色一样透着血一般鲜红光
芒。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
现在是正午时分，太阳高挂天心，肆意地淫虐。整个大厅的家具
都是用红玉精心打磨制造的，外面的光照进来反射出一片暗暗的
红光。就像红龙的眼睛的颜色一样透着血一般鲜红光芒。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
傍晚，一轮火红的夕阳正徘徊在西方的地平线上。整个大厅的家
具都是用红玉精心打磨制造的，外面的光照进来反射出一片暗暗
的红光。就像红龙的眼睛的颜色一样透着血一般鲜红光芒。
LONG
);
			else//入夜
				set("long",@LONG
夜晚，夜幕开始渐渐笼罩著大地。整个大厅的家具都是用红玉精
心打磨制造的，外面的光照进来反射出一片暗暗的红光。就像红
龙的眼睛的颜色一样透着血一般鲜红光芒。
LONG
);
		}
		return 0;
	}
}


