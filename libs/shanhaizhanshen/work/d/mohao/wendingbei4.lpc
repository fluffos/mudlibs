// Room: wendingbei4.c

inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "碧玉北路");
	set("long", @LONG
这是星龙城碧玉北路，这里离星龙北城门已不远。街上冷冷清清
没几个人影。
LONG
	);
	set("exits", ([ /* sizeof() == 4 */
  "south" : __DIR__"wendingbei3",
  "north" : __DIR__"beimen",
]));
	set("no_clean_up", 0);
	set("outdoors", "/d/mohao");
	

	setup();
	
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
凌晨，东方的天空布满了灰蒙蒙的云层。这是星龙城碧玉北路，
这里离星龙北城门已不远。街上冷冷清清没几个人影。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
清晨，太阳露在东方的地平线上，显示了一天的勃勃生机。这是
星龙城碧玉北路，这里离星龙北城门已不远。街上冷冷清清没几个人
影。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
现在是正午时分，太阳高挂天心，肆意地淫虐。这是星龙城碧玉
北路，这里离星龙北城门已不远。街上冷冷清清没几个人影。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
傍晚，一轮火红的夕阳正徘徊在西方的地平线上。这是星龙城碧
玉北路，这里离星龙北城门已不远。街上冷冷清清没几个人影。
LONG
);
			else//入夜
				set("long",@LONG
夜晚，夜幕开始渐渐笼罩著大地。这是星龙城碧玉北路，这里离
星龙北城门已不远。街上冷冷清清没几个人影。
LONG
);
		}
		return 0;
	}
}


