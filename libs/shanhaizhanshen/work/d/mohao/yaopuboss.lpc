// Room: /d/zhongzhou/yaopuboss.c

inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "药铺帐房");
	set("long", @LONG
这里就是药铺帐房，药铺的老板正坐在太师椅上吞云吐雾呢。药
铺的帐房先生在一旁忙着算帐。看着里面一大堆的帐本，你想要
是那收来的钱是我的可就好了。
LONG
	);
	
	set("no_clean_up", 0);
	set("exits", ([ /* sizeof() == 1 */
  "south" : __DIR__"yaopu",
]));

	setup();
	
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
凌晨，东方的天空布满了灰蒙蒙的云层。这里就是药铺帐房，药
铺的老板正坐在太师椅上吞云吐雾呢。药铺的帐房先生在一旁忙
着算帐。看着里面一大堆的帐本，你想要是那收来的钱是我的可
就好了。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
清晨，太阳露在东方的地平线上，显示了一天的勃勃生机。这里
就是药铺帐房，药铺的老板正坐在太师椅上吞云吐雾呢。药铺的
帐房先生在一旁忙着算帐。看着里面一大堆的帐本，你想要是那
收来的钱是我的可就好了。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
现在是正午时分，太阳高挂天心，肆意地淫虐。这里就是药铺帐
房，药铺的老板正坐在太师椅上吞云吐雾呢。药铺的帐房先生在
一旁忙着算帐。看着里面一大堆的帐本，你想要是那收来的钱是
我的可就好了。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
傍晚，一轮火红的夕阳正徘徊在西方的地平线上。这里就是药铺
帐房，药铺的老板正坐在太师椅上吞云吐雾呢。药铺的帐房先生
在一旁忙着算帐。看着里面一大堆的帐本，你想要是那收来的钱
是我的可就好了。
LONG
);
			else//入夜
				set("long",@LONG
夜晚，夜幕开始渐渐笼罩著大地。这里就是药铺帐房，药铺的老
板正坐在太师椅上吞云吐雾呢。药铺的帐房先生在一旁忙着算帐。
看着里面一大堆的帐本，你想要是那收来的钱是我的可就好了。
LONG
);
		}
		return 0;
	}
}


