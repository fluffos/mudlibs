//shiye
  

inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "书房");
	set("long", @LONG
一走进书房，就见周围的桌子上零星的散落着一些机械解剖图。
星龙城主红龙本身也是机甲武学的高手，所以他的书房中常有与
机甲武学有关的书籍。
LONG
	);
	set("no_fight", 1);

	set("exits", ([
		"south" : __DIR__"zoulang1",
		 
	]));
     
setup();
	 
}

void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
凌晨，东方的天空布满了灰蒙蒙的云层。一走进书房，就见周围
的桌子上零星的散落着一些机械解剖图。星龙城主红龙本身也是
机甲武学的高手，所以他的书房中常有与机甲武学有关的书籍。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
清晨，太阳露在东方的地平线上，显示了一天的勃勃生机。一走
进书房，就见周围的桌子上零星的散落着一些机械解剖图。星龙
城主红龙本身也是机甲武学的高手，所以他的书房中常有与机甲
武学有关的书籍。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
现在是正午时分，太阳高挂天心，肆意地淫虐。一走进书房，就
见周围的桌子上零星的散落着一些机械解剖图。星龙城主红龙本
身也是机甲武学的高手，所以他的书房中常有与机甲武学有关的
书籍。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
傍晚，一轮火红的夕阳正徘徊在西方的地平线上。一走进书房，
就见周围的桌子上零星的散落着一些机械解剖图。星龙城主红龙
本身也是机甲武学的高手，所以他的书房中常有与机甲武学有关
的书籍。
LONG
);
			else//入夜
				set("long",@LONG
夜晚，夜幕开始渐渐笼罩著大地。一走进书房，就见周围的桌子
上零星的散落着一些机械解剖图。星龙城主红龙本身也是机甲武
学的高手，所以他的书房中常有与机甲武学有关的书籍。
LONG
);
		}
		return 0;
	}
}


