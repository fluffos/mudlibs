//zahuopu
#include <room.h>
inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "杂货铺");
  set("long", @LONG
这里是星龙城西的一家杂货铺，虽然店内的东西不少，可因为地
处的比较偏僻，所以生意也是冷冷清清。
LONG);
  set("objects", ([
    __DIR__ "npc/lenyuchen": 1,
  ]));

  set("exits", ([
    "south": __DIR__ "yanling1",

  ]));
  set("doors", ([
    "south": ([
      "data": "门",
      "other_side_dir": "north",
      //	"status"	:	DOOR_LOCKED,
      "key_id": "mohao/zahuo_key",
    ]), ]));


  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
凌晨，东方的天空布满了灰蒙蒙的云层。这里是星龙城西的一家
杂货铺，虽然店内的东西不少，可因为地处的比较偏僻，所以生
意也是冷冷清清。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
清晨，太阳露在东方的地平线上，显示了一天的勃勃生机。这里
是星龙城西的一家杂货铺，虽然店内的东西不少，可因为地处的
比较偏僻，所以生意也是冷冷清清。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
现在是正午时分，太阳高挂天心，肆意地淫虐。这里是星龙城西
的一家杂货铺，虽然店内的东西不少，可因为地处的比较偏僻，
所以生意也是冷冷清清。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
傍晚，一轮火红的夕阳正徘徊在西方的地平线上。这里是星龙城
西的一家杂货铺，虽然店内的东西不少，可因为地处的比较偏僻，
所以生意也是冷冷清清。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚，夜幕开始渐渐笼罩著大地。这里是星龙城西的一家杂货铺，
虽然店内的东西不少，可因为地处的比较偏僻，所以生意也是冷
冷清清。
LONG
        );
    }
    return 0;
  }
}
