//yinghaoup
  

inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "龙鳞酒楼二楼");
	set("long", @LONG
这是龙鳞酒楼二楼雅座，如果靠窗坐的话，街上行人可以尽收眼
底，你如果喜欢清净一点，就在里面包间。边上还有一个单间，
喝多了可以上里面小酣片刻。

         _..,----,.._
      .-;'-.,____,.-';
     (( |            |
      `))            ;   要酒、还是茶……
       ` \          /
      .-' `,.____.,' '-.
     (     '------'     )
      `-=..________..--'
LONG
	);

	set("exits", ([
		
		
		"east" : __DIR__"xiuxishi",
		"down" : __DIR__"yinghao",
	]));

set("no_fight",1);


	setup();
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
凌晨，东方的天空布满了灰蒙蒙的云层。这是龙鳞酒楼二楼雅座，
如果靠窗坐的话，街上行人可以尽收眼底，你如果喜欢清净一点，
就在里面包间。边上还有一个单间，喝多了可以上里面小酣片刻。

         _..,----,.._
      .-;'-.,____,.-';
     (( |            |
      `))            ;   要酒、还是茶……
       ` \          /
      .-' `,.____.,' '-.
     (     '------'     )
      `-=..________..--'
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
清晨，太阳露在东方的地平线上，显示了一天的勃勃生机。这是
龙鳞酒楼二楼雅座，如果靠窗坐的话，街上行人可以尽收眼底，
你如果喜欢清净一点，就在里面包间。边上还有一个单间，喝多
了可以上里面小酣片刻。

         _..,----,.._
      .-;'-.,____,.-';
     (( |            |
      `))            ;   要酒、还是茶……
       ` \          /
      .-' `,.____.,' '-.
     (     '------'     )
      `-=..________..--'
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
现在是正午时分，太阳高挂天心，肆意地淫虐。这是龙鳞酒楼二
楼雅座，如果靠窗坐的话，街上行人可以尽收眼底，你如果喜
欢清净一点，就在里面包间。边上还有一个单间，喝多了可以
上里面小酣片刻。

         _..,----,.._
      .-;'-.,____,.-';
     (( |            |
      `))            ;   要酒、还是茶……
       ` \          /
      .-' `,.____.,' '-.
     (     '------'     )
      `-=..________..--'
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
傍晚，一轮火红的夕阳正徘徊在西方的地平线上。这是龙鳞酒楼
二楼雅座，如果靠窗坐的话，街上行人可以尽收眼底，你如果喜
欢清净一点，就在里面包间。边上还有一个单间，喝多了可以上
里面小酣片刻。

         _..,----,.._
      .-;'-.,____,.-';
     (( |            |
      `))            ;   要酒、还是茶……
       ` \          /
      .-' `,.____.,' '-.
     (     '------'     )
      `-=..________..--'
LONG
);
			else//入夜
				set("long",@LONG
夜晚，夜幕开始渐渐笼罩著大地。这是龙鳞酒楼二楼雅座，如果
靠窗坐的话，街上行人可以尽收眼底，你如果喜欢清净一点，就
在里面包间。边上还有一个单间，喝多了可以上里面小酣片刻。

         _..,----,.._
      .-;'-.,____,.-';
     (( |            |
      `))            ;   要酒、还是茶……
       ` \          /
      .-' `,.____.,' '-.
     (     '------'     )
      `-=..________..--'
LONG
);
		}
		return 0;
	}
}


