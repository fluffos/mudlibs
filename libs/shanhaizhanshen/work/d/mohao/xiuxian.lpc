//xiuxian
  

#include <ansi.h>
inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "大浴室");
	set("long", @LONG
一进到大厅，迎面看见足有一丈见方的一幅美女出浴图。地上的
地毯软绵绵的，你不竟想躺下休息一下。北面的门上写着女宾向
南可以到男宾的大厅。
LONG
	);

	set("exits", ([
		 "east" : __DIR__"wendingnan3",
		
		"north" : __DIR__"nubin",
		"south" : __DIR__"nanbin",
]));
	
	setup();
       
}
int valid_leave(object me,string dir)
{
if((me->query("gender")=="男性"&&dir=="north")||(me->query("gender")=="女性"&&dir=="south"))
        return notify_fail("哎！看清楚再走！！\n");
        if(dir=="east")        return  ::valid_leave(me,dir);

	 if(dir=="west")    return  ::valid_leave(me,dir);      
if((me->query("gender")=="男性"&&dir=="south")||(me->query("gender")=="女性"&&dir=="north"))
	return ::valid_leave(me,dir);
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
凌晨，东方的天空布满了灰蒙蒙的云层。一进到大厅，迎面看见
足有一丈见方的一幅美女出浴图。地上的地毯软绵绵的，你不竟
想躺下休息一下。北面的门上写着女宾向南可以到男宾的大厅。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
清晨，太阳露在东方的地平线上，显示了一天的勃勃生机。一进
到大厅，迎面看见足有一丈见方的一幅美女出浴图。地上的地毯
软绵绵的，你不竟想躺下休息一下。北面的门上写着女宾向南可
以到男宾的大厅。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
现在是正午时分，太阳高挂天心，肆意地淫虐。一进到大厅，迎
面看见足有一丈见方的一幅美女出浴图。地上的地毯软绵绵的，
你不竟想躺下休息一下。北面的门上写着女宾向南可以到男宾的
大厅。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
傍晚，一轮火红的夕阳正徘徊在西方的地平线上。一进到大厅，
迎面看见足有一丈见方的一幅美女出浴图。地上的地毯软绵绵的，
你不竟想躺下休息一下。北面的门上写着女宾向南可以到男宾的
大厅。
LONG
);
			else//入夜
				set("long",@LONG
夜晚，夜幕开始渐渐笼罩著大地。一进到大厅，迎面看见足有一
丈见方的一幅美女出浴图。地上的地毯软绵绵的，你不竟想躺下
休息一下。北面的门上写着女宾，向南可以到男宾的大厅。
LONG
);
		}
		return 0;
	}
}


