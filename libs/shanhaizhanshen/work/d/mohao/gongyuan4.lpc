// Room: /d/yangzhou/gongyuan.c

inherit ROOM;

int do_look(string arg);
void create()
{
	set("short", "龙书院");
	set("long", @LONG
龙书院是星龙城最大的书院，和星书院并称星龙双院。是每位异
族子弟都会就读的书院，书院的老师是异族的长老，龙书院专门
教授机械基础。星书院才是教授机械武学的地方。
LONG
	);
	set("no_magic", 1);

	set("no_clean_up", 0);
	
	set("light_up", 1);
	set("exits", ([ /* sizeof() == 1 */
  "south" : __DIR__"yanling2",
]));
	set("no_fight", 1);
        set("no_steal",1);
        set("no_sleep",1);

	setup();
}

void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
凌晨，东方的天空布满了灰蒙蒙的云层。龙书院是星龙城最大的
书院，和星书院并称星龙双院。是每位异族子弟都会就读的书院，
书院的老师是异族的长老，龙书院专门教授机械基础。星书院才
是教授机械武学的地方。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
清晨，太阳露在东方的地平线上，显示了一天的勃勃生机。龙书
院是星龙城最大的书院，和星书院并称星龙双院。是每位异族子
弟都会就读的书院，书院的老师是异族的长老，龙书院专门教授
机械基础。星书院才是教授机械武学的地方。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
现在是正午时分，太阳高挂天心，肆意地淫虐。龙书院是星龙城
最大的书院，和星书院并称星龙双院。是每位异族子弟都会就读
的书院，书院的老师是异族的长老，龙书院专门教授机械基础。
星书院才是教授机械武学的地方。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
傍晚，一轮火红的夕阳正徘徊在西方的地平线上。龙书院是星龙
城最大的书院，和星书院并称星龙双院。是每位异族子弟都会就
读的书院，书院的老师是异族的长老，龙书院专门教授机械基础。
星书院才是教授机械武学的地方。
LONG
);
			else//入夜
				set("long",@LONG
夜晚，夜幕开始渐渐笼罩著大地。龙书院是星龙城最大的书院，
和星书院并称星龙双院。是每位异族子弟都会就读的书院，书院
的老师是异族的长老，龙书院专门教授机械基础。星书院才是教
授机械武学的地方。
LONG
);
		}
		return 0;
	}
}


