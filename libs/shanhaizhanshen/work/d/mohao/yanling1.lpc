//yanling1
#include <room.h>
inherit ROOM;
int do_look(string arg);
void create()
{
  set ("short", "碧玉西路");
  set ("long", @LONG
这里就是碧玉西路，是星龙城的一条老街。两边的房屋看上去已
经很陈旧了。路上冷冷清清的，偶尔有一两个人路过。再往前走，
就能隐隐的看见西城楼了。路北面有间杂货铺，开在这偏僻的地
方，估计生意不会太好.
LONG);

set("outdoors","/d/mohao");

  set("exits", ([  
    "west" : __DIR__"yanling2",
    "north" : __DIR__"zahuopu",
    "east"  : __DIR__"yanling",
]));
	set("doors", ([
		"north"	:	([
				"data"		:	"门",
				"other_side_dir":	"south",
			//	"status"	:	DOOR_LOCKED,
				"key_id"	:	"mohao/zahuo_key",
				]),]) );

	 setup();
       
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
凌晨，东方的天空布满了灰蒙蒙的云层。这里就是碧玉西路，是
星龙城的一条老街。两边的房屋看上去已经很陈旧了。路上冷冷
清清的，偶尔有一两个人路过。再往前走，就能隐隐的看见西城
楼了。路北面有间杂货铺，开在这偏僻的地方，估计生意不会太
好.
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
清晨，太阳露在东方的地平线上，显示了一天的勃勃生机。这里
就是碧玉西路，是星龙城的一条老街。两边的房屋看上去已经很
陈旧了。路上冷冷清清的，偶尔有一两个人路过。再往前走，就
能隐隐的看见西城楼了。路北面有间杂货铺，开在这偏僻的地方，
估计生意不会太好.
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
现在是正午时分，太阳高挂天心，肆意地淫虐。这里就是碧玉西
路，是星龙城的一条老街。两边的房屋看上去已经很陈旧了。路
上冷冷清清的，偶尔有一两个人路过。再往前走，就能隐隐的看
见西城楼了。路北面有间杂货铺，开在这偏僻的地方，估计生意
不会太好.
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
傍晚，一轮火红的夕阳正徘徊在西方的地平线上。这里就是碧玉
西路，是星龙城的一条老街。两边的房屋看上去已经很陈旧了。
路上冷冷清清的，偶尔有一两个人路过。再往前走，就能隐隐的
看见西城楼了。路北面有间杂货铺，开在这偏僻的地方，估计生
意不会太好.
LONG
);
			else//入夜
				set("long",@LONG
夜晚，夜幕开始渐渐笼罩著大地。这里就是碧玉西路，是星龙城
的一条老街。两边的房屋看上去已经很陈旧了。路上冷冷清清的，
偶尔有一两个人路过。再往前走，就能隐隐的看见西城楼了。路
北面有间杂货铺，开在这偏僻的地方，估计生意不会太好.
LONG
);
		}
		return 0;
	}
}


