//yanlingdong
inherit ROOM;
int do_look(string arg);
void create()
{
  set ("short", "碧玉东路");
  set ("long", @LONG
从城中心往东走就到了碧玉东路，这里星龙城的一条老街。两边
的房屋看上去已经很陈旧了。路南有一家老字号的酒店。出门在
外到这种地方来转一转也别有一番滋味。
LONG);

set("outdoors","/d/mohao");

  set("exits", ([  
    "west" : __DIR__"shizhongxin",
    
    
    "east"  : __DIR__"yanlingdong1",
]));
       
	
	 setup();
       
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
凌晨，东方的天空布满了灰蒙蒙的云层。从城中心往东走就到了
碧玉东路，这里星龙城的一条老街。两边的房屋看上去已经很陈
旧了。路南有一家老字号的酒店。出门在外到这种地方来转一转
也别有一番滋味。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
清晨，太阳露在东方的地平线上，显示了一天的勃勃生机。从城
中心往东走就到了碧玉东路，这里星龙城的一条老街。两边的房
屋看上去已经很陈旧了。路南有一家老字号的酒店。出门在外到
这种地方来转一转也别有一番滋味。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
现在是正午时分，太阳高挂天心，肆意地淫虐。从城中心往东走
就到了碧玉东路，这里星龙城的一条老街。两边的房屋看上去已
经很陈旧了。路南有一家老字号的酒店。出门在外到这种地方来
转一转也别有一番滋味。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
傍晚，一轮火红的夕阳正徘徊在西方的地平线上。从城中心往东
走就到了碧玉东路，这里星龙城的一条老街。两边的房屋看上去
已经很陈旧了。路南有一家老字号的酒店。出门在外到这种地方
来转一转也别有一番滋味。
LONG
);
			else//入夜
				set("long",@LONG
夜晚，夜幕开始渐渐笼罩著大地。从城中心往东走就到了碧玉东
路，这里星龙城的一条老街。两边的房屋看上去已经很陈旧了。
路南有一家老字号的酒店。出门在外到这种地方来转一转也别有
一番滋味。
LONG
);
		}
		return 0;
	}
}


