// Room: /d/mohao/wendingnan3.c

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "碧玉南路");
  set("long", @LONG
这是星龙城碧玉南路，宽敞的街道看的人不竟心情一畅。西面有
一家不小的房子，两个异族美女绽放出迷人的微笑,不断地伸手
招呼。
LONG
  );
  set("outdoors", "/d/mohao");

  set("exits", ([ /* sizeof() == 5 */
    "south": __DIR__ "wendingnan4",
    "west": __DIR__ "xiuxian",
    "north": __DIR__ "wendingnan2",
  ]));
  set("no_clean_up", 0);

  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
凌晨，东方的天空布满了灰蒙蒙的云层。这是星龙城碧玉南路，
宽敞的街道看的人不竟心情一畅。西面有一家不小的房子，两个
异族美女绽放出迷人的微笑,不断地伸手招呼。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
清晨，太阳露在东方的地平线上，显示了一天的勃勃生机。这是
星龙城碧玉南路，宽敞的街道看的人不竟心情一畅。西面有一家
不小的房子，两个异族美女绽放出迷人的微笑,不断地伸手招呼。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
现在是正午时分，太阳高挂天心，肆意地淫虐。这是星龙城碧玉
南路，宽敞的街道看的人不竟心情一畅。西面有一家不小的房子，
两个异族美女绽放出迷人的微笑,不断地伸手招呼。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
傍晚，一轮火红的夕阳正徘徊在西方的地平线上。这是星龙城碧
玉南路，宽敞的街道看的人不竟心情一畅。西面有一家不小的房
子，两个异族美女绽放出迷人的微笑,不断地伸手招呼。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚，夜幕开始渐渐笼罩著大地。这是星龙城碧玉南路，宽敞的
街道看的人不竟心情一畅。西面有一家不小的房子，两个异族美
女绽放出迷人的微笑,不断地伸手招呼。
LONG
        );
    }
    return 0;
  }
}
