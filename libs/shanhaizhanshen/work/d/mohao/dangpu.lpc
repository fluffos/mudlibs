// Room: /d/zhongzhou/dangpu.c

inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "当铺");
	set("long", @LONG
这是山海战神的当铺，从一开始创造山海战神的世界就存在了，
在全大陆各地都有分店。一个四尺高的柜台摆在你的面前，柜台
上摆着一个牌子(paizi)， 柜台后坐着当铺的老板，一双鬼溜溜
的眼睛上上下下打量着你。
      ___________________________________
     |.-.--.--.--.--.--.--.--.--.--.--.-.|
     ||(_)(_)(_)(_)(_)(_)(_)(_)(_)(_)(_)||
     ||(_)(_)(_)(_)(_)(_)(_)(_)(_)(_)(_)||
     ||_|__|__|__|__|__|__|__|__|__|__|_||
     [_>_______________________________<_]
     ||"|""|""|""|""|""|""|""|""|""|""|"||
     || |  |  |  |  |  |  |  |  |  |  | ||
     ||(_)(_)(_)(_)(_)(_)(_)(_)(_)(_)(_)||
     ||(_)(_)(_)(_)(_)(_)(_)(_)(_)(_)(_)||
     ||(_)(_)(_)(_)(_)(_)(_)(_)(_)(_)(_)||
     ||(_)(_)(_)(_)(_)(_)(_)(_)(_)(_)(_)||
     ||(_)(_)(_)(_)(_)(_)(_)(_)(_)(_)(_)||
     |'-'--'--'--'--'--'--'--'--'--'--'-'|
     `"""""""""""""""""""""""""""""""""""`
LONG
	);
	
	set("no_clean_up", 0);
	
	set("exits", ([ /* sizeof() == 1 */
  "north" : __DIR__"yanling",
]));

	setup();
	
}
void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
凌晨，东方的天空布满了灰蒙蒙的云层。这是山海战神的当铺，
从一开始创造山海战神的世界就存在了，在全大陆各地都有分店。
一个四尺高的柜台摆在你的面前，柜台上摆着一个牌子(paizi)，
柜台后坐着当铺的老板，一双鬼溜溜的眼睛上上下下打量着你。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
清晨，太阳露在东方的地平线上，显示了一天的勃勃生机。这是
山海战神的当铺，从一开始创造山海战神的世界就存在了，在全
大陆各地都有分店。一个四尺高的柜台摆在你的面前，柜台上摆
着一个牌子(paizi)， 柜台后坐着当铺的老板，一双鬼溜溜的眼
睛上上下下打量着你。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
现在是正午时分，太阳高挂天心，肆意地淫虐。这是山海战神的
当铺，从一开始创造山海战神的世界就存在了，在全大陆各地都
有分店。一个四尺高的柜台摆在你的面前，柜台上摆着一个牌子
(paizi)， 柜台后坐着当铺的老板，一双鬼溜溜的眼睛上上下下
打量着你。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
傍晚，一轮火红的夕阳正徘徊在西方的地平线上。这是山海战神
的当铺，从一开始创造山海战神的世界就存在了，在全大陆各地
都有分店。一个四尺高的柜台摆在你的面前，柜台上摆着一个牌
子(paizi)， 柜台后坐着当铺的老板，一双鬼溜溜的眼睛上上下
下打量着你。
LONG
);
			else//入夜
				set("long",@LONG
夜晚，夜幕开始渐渐笼罩著大地。这是山海战神的当铺，从一开
始创造山海战神的世界就存在了，在全大陆各地都有分店。一个
四尺高的柜台摆在你的面前，柜台上摆着一个牌子(paizi)， 柜
台后坐着当铺的老板，一双鬼溜溜的眼睛上上下下打量着你。
LONG
);
		}
		return 0;
	}
}


