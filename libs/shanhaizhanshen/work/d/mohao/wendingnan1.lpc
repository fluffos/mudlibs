//wendingnan1
  

inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "碧玉南路");
	set("long", @LONG
这是星龙城碧玉南路，宽敞的街道看的人不竟心情一畅。西面的
一家店面，一听里面的算盘声就知道是一家不小的钱庄。
LONG
	);
set("outdoors","/d/mohao");

	set("exits", ([
		
		"south" : __DIR__"wendingnan2",
		"west" : __DIR__"bank",
		"north" : __DIR__"shizhongxin",
	]));
	

	setup();
	
}

void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
        int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
凌晨，东方的天空布满了灰蒙蒙的云层。这是星龙城碧玉南路，
宽敞的街道看的人不竟心情一畅。西面的一家店面，一听里面的
算盘声就知道是一家不小的钱庄。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
清晨，太阳露在东方的地平线上，显示了一天的勃勃生机。这是
星龙城碧玉南路，宽敞的街道看的人不竟心情一畅。西面的一家
店面，一听里面的算盘声就知道是一家不小的钱庄。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
现在是正午时分，太阳高挂天心，肆意地淫虐。这是星龙城碧玉
南路，宽敞的街道看的人不竟心情一畅。西面的一家店面，一听
里面的算盘声就知道是一家不小的钱庄。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
傍晚，一轮火红的夕阳正徘徊在西方的地平线上。这是星龙城碧
玉南路，宽敞的街道看的人不竟心情一畅。西面的一家店面，一
听里面的算盘声就知道是一家不小的钱庄。
LONG
);
			else//入夜
				set("long",@LONG
夜晚，夜幕开始渐渐笼罩著大地。这是星龙城碧玉南路，宽敞的
街道看的人不竟心情一畅。西面的一家店面，一听里面的算盘声
就知道是一家不小的钱庄。
LONG
);
		}
		return 0;
	}
}


