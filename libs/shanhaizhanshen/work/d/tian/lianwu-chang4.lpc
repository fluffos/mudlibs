// Room: lianwu-chang4.c

inherit ROOM;
int do_look(string arg);
void create()
{
        set("short", "练武场");
        set("long", @LONG
这是星凝城的练武场。由数块巨大的花岗岩铺垫而成。地面坑坑
洼洼留下无数脚印，可见城中居民用功之甚。不论白天黑夜，都
可见到十几个居民正在此苦练武技。东面正是演武场。
  ●        ●）      ●      ● ）       ●_)    ＼●
＜┃＞   （┃       （┃）   （）        /┃┃      （ ＞ 
 ／＼    ／ ）      （＼    ／ ）        ／ ＼       ／＼
LONG
        );
        
        set("outdoors", "tian");
        set("exits", ([ /* sizeof() == 3 */
  
  "east" : __DIR__"guangchang1",
]));
        set("no_clean_up", 0);

        setup();
       
}

void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
深夜，更深夜沉，满天繁星。这是星凝城的练武场。由数块巨大
的花岗岩铺垫而成。地面坑坑洼洼留下无数脚印，可见城中居民
用功之甚。不论白天黑夜，都可见到十几个居民正在此苦练武技。
东面正是演武场。
