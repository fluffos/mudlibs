// Room: shiwangdian.c

inherit ROOM;
int do_look(string arg);
void create()
{
        set("short", "长廊");
        set("long", @LONG
从演武场走过来，巨大花岗石铺成的地板映你的身影，这是一条
宽阔的长廊，四周没有什么饰物，光滑的石壁上有着一些天然的
纹理，时而有一些居民匆匆走过，但似乎从没人留步去仔细地望
一望这些美丽而又古怪的花纹。
LONG
        );
        set("exits", ([ /* sizeof() == 4 */
  "west" : __DIR__"zoulang2",
  "south" : __DIR__"guangchang1",
  "north" : __DIR__"juyiting",
  "east" : __DIR__"zoulang1",
]));
        set("no_clean_up", 0);

        setup();
       
}

void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
			set("long", @LONG
深夜，更深夜沉，满天繁星。从演武场走过来，巨大花岗石铺成
的地板映你的身影，这是一条宽阔的长廊，四周没有什么饰物，
光滑的石壁上有着一些天然的纹理，时而有一些居民匆匆走过，
但似乎从没人留步去仔细地望一望这些美丽而又古怪的花纹。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
清晨，太阳刚从东方的地平线升起。从演武场走过来，巨大花岗
石铺成的地板映你的身影，这是一条宽阔的长廊，四周没有什么
饰物，光滑的石壁上有着一些天然的纹理，时而有一些居民匆匆
走过，但似乎从没人留步去仔细地望一望这些美丽而又古怪的花纹。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
午后时分，太阳从你正上方照耀着大地。从演武场走过来，巨大
花岗石铺成的地板映你的身影，这是一条宽阔的长廊，四周没有
什么饰物，光滑的石壁上有着一些天然的纹理，时而有一些居民
匆匆走过，但似乎从没人留步去仔细地望一望这些美丽而又古怪
的花纹。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
下午的太阳开始从西方的天空中慢慢西沉。从演武场走过来，巨
大花岗石铺成的地板映你的身影，这是一条宽阔的长廊，四周没
有什么饰物，光滑的石壁上有着一些天然的纹理，时而有一些居
民匆匆走过，但似乎从没人留步去仔细地望一望这些美丽而又古
怪的花纹。
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，夜幕笼罩着大地。从演武场走过来，巨大花岗石铺
成的地板映你的身影，这是一条宽阔的长廊，四周没有什么饰物，
光滑的石壁上有着一些天然的纹理，时而有一些居民匆匆走过，
但似乎从没人留步去仔细地望一望这些美丽而又古怪的花纹。
LONG
);
		}
		return 0;
	}
}