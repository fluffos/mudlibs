// Room: shanmen.c

#include <ansi.h>
#include <room.h>
inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "山门");
  set("long", @LONG
这就是星凝城的山门，朱红色的两根大柱子矗立在你的面前，上
面悬挂着一块黑色大匾，上书着“星凝圣城”几个金色大字，甚
是威严。
    p                  p         p
    /\     p      p    /\        /\
   /__\   /\_____/\   /__\      /__\
   |. |_=_|. . . .|_=_=_=_=_=_=_|. |
   |. |. .|  ___  |. . . . . . .|. |
   |. |   | |   | |             |. |
 __|__|___|_|___|_|_____________|__|__
/          /   /                      \
LONG
  );

  set("outdoors", "tian");
  set("objects", ([
    __DIR__ "npc/shiwei1": 1,

    __DIR__ "npc/shiwei2": 1,
  ]));
  set("exits", ([ /* sizeof() == 2 */
    "north": __DIR__ "zhandao",
    "south": __DIR__ "shanlu2",
  ]));

  setup();
}

void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
深夜，更深夜沉，满天繁星。这就是星凝城的山门，朱红色的两
根大柱子矗立在你的面前，上面悬挂着一块黑色大匾，上书着“
星凝圣城”几个金色大字，甚是威严。
    p                  p         p
    /\     p      p    /\        /\
   /__\   /\_____/\   /__\      /__\
   |. |_=_|. . . .|_=_=_=_=_=_=_|. |
   |. |. .|  ___  |. . . . . . .|. |
   |. |   | |   | |             |. |
 __|__|___|_|___|_|_____________|__|__
/          /   /                      \
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
清晨，太阳刚从东方的地平线升起。这就是星凝城的山门，朱红
色的两根大柱子矗立在你的面前，上面悬挂着一块黑色大匾，上
书着“星凝圣城”几个金色大字，甚是威严。
    p                  p         p
    /\     p      p    /\        /\
   /__\   /\_____/\   /__\      /__\
   |. |_=_|. . . .|_=_=_=_=_=_=_|. |
   |. |. .|  ___  |. . . . . . .|. |
   |. |   | |   | |             |. |
 __|__|___|_|___|_|_____________|__|__
/          /   /                      \
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
午后时分，太阳从你正上方照耀着大地。这就是星凝城的山门，
朱红色的两根大柱子矗立在你的面前，上面悬挂着一块黑色大匾，
上书着“星凝圣城”几个金色大字，甚是威严。
    p                  p         p
    /\     p      p    /\        /\
   /__\   /\_____/\   /__\      /__\
   |. |_=_|. . . .|_=_=_=_=_=_=_|. |
   |. |. .|  ___  |. . . . . . .|. |
   |. |   | |   | |             |. |
 __|__|___|_|___|_|_____________|__|__
/          /   /                      \
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
下午的太阳开始从西方的天空中慢慢西沉。这就是星凝城的山门，
朱红色的两根大柱子矗立在你的面前，上面悬挂着一块黑色大匾，
上书着“星凝圣城”几个金色大字，甚是威严。
    p                  p         p
    /\     p      p    /\        /\
   /__\   /\_____/\   /__\      /__\
   |. |_=_|. . . .|_=_=_=_=_=_=_|. |
