// Room: xiangfang_1.c

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "休息室");
  set("long", @LONG
这里是星凝城用来接待来访客人的休息室，摆设简单，却布置得
干净整洁，一张大床又大又舒适。有几个小童正在仔细擦拭门椅
廊窗。看样子又有贵客到访了。西面就是走道。
            
          ()___
        ()//__/)_________________()
        ||(___)//#/_/#/_/#/_/#()/||
        ||----|#| |#|_|#|_|#|_|| ||
        ||____|_|#|_|#|_|#|_|#||/||
        ||    |#|_|#|_|#|_|#|_||


LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "west": __DIR__ "houtuqi",
  ]));
  set("sleep_room", 1);
  set("no_fight", 1);
  set("no_clean_up", 0);

  setup();

}
void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
