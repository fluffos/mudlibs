// Room: banshanyao1.c

inherit ROOM;
int do_look(string arg);
void create()
{
        set("short", "半山");
        set("long", @LONG
你爬上半山腰，望着对面的山。这边的山柔静阴郁，对面的山坡
金色的阳光晒得一片亮晶。真象仙境一样，有什麽喜乐的事，如
升平的音乐，在树梢与树梢间荡跌着，回响着.....!
LONG
        );
        set("exits", ([ /* sizeof() == 3 */
  "south" : __DIR__"banshanting",
  
  "northeast" : __DIR__"qian-ting",
]));
        set("no_clean_up", 0);
        set("outdoors", "tian");

        setup();
       
}

void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
深夜，更深夜沉，满天繁星。你爬上半山腰，望着对面的山。这
边的山柔静阴郁，对面的山坡金色的阳光晒得一片亮晶。真象仙
境一样，有什麽喜乐的事，如升平的音乐，在树梢与树梢间荡跌
着，回响着.....!
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
清晨，太阳刚从东方的地平线升起。你爬上半山腰，望着对面的
山。这边的山柔静阴郁，对面的山坡金色的阳光晒得一片亮晶。
真象仙境一样，有什麽喜乐的事，如升平的音乐，在树梢与树梢
间荡跌着，回响着.....!
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
午后时分，太阳从你正上方照耀着大地。你爬上半山腰，望着对
面的山。这边的山柔静阴郁，对面的山坡金色的阳光晒得一片亮
晶。真象仙境一样，有什麽喜乐的事，如升平的音乐，在树梢与
树梢间荡跌着，回响着.....!
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
下午的太阳开始从西方的天空中慢慢西沉。你爬上半山腰，望着
对面的山。这边的山柔静阴郁，对面的山坡金色的阳光晒得一片
亮晶。真象仙境一样，有什麽喜乐的事，如升平的音乐，在树梢
与树梢间荡跌着，回响着.....!
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，夜幕笼罩着大地。你爬上半山腰，望着对面的山。
这边的山柔静阴郁，对面的山坡金色的阳光晒得一片亮晶。真象
仙境一样，有什麽喜乐的事，如升平的音乐，在树梢与树梢间荡
跌着，回响着.....!
LONG
);
		}
		return 0;
	}
}