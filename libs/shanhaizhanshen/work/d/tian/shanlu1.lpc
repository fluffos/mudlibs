// Room: shanlu1.c

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "山路");
  set("long", @LONG
上得峰来，但见山势险峻，树木清幽，鸟鸣嘤嘤，流水淙淙。你
越山脊而上，两崖深不见底，凡险峻处，如身置太空，肝摇胆撼。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "east": __DIR__ "zhandao",
    "northwest": __DIR__ "banshanting",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "none");
  set("outdoors", "tian");
  setup();

}

void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
深夜，更深夜沉，满天繁星。上得峰来，但见山势险峻，树木清
幽，鸟鸣嘤嘤，流水淙淙。你越山脊而上，两崖深不见底，凡险
峻处，如身置太空，肝摇胆撼。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
清晨，太阳刚从东方的地平线升起。上得峰来，但见山势险峻，
树木清幽，鸟鸣嘤嘤，流水淙淙。你越山脊而上，两崖深不见底，
凡险峻处，如身置太空，肝摇胆撼。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
午后时分，太阳从你正上方照耀着大地。上得峰来，但见山势险
峻，树木清幽，鸟鸣嘤嘤，流水淙淙。你越山脊而上，两崖深不
见底，凡险峻处，如身置太空，肝摇胆撼。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
下午的太阳开始从西方的天空中慢慢西沉。上得峰来，但见山势
险峻，树木清幽，鸟鸣嘤嘤，流水淙淙。你越山脊而上，两崖深
不见底，凡险峻处，如身置太空，肝摇胆撼。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚降临了，夜幕笼罩着大地。上得峰来，但见山势险峻，树木
清幽，鸟鸣嘤嘤，流水淙淙。你越山脊而上，两崖深不见底，凡
险峻处，如身置太空，肝摇胆撼。
LONG
        );
    }
    return 0;
  }
}
