// Room: houtuqi.c

inherit ROOM;
int do_look(string arg);
void create()
{
        set("short", "过道");
        set("long", @LONG
这里是一条小过道，由数块巨大的花岗岩铺成，北边通向城中的
演武场,演武场中不时传来城中居民练习武功的拳脚声。左边是厅
堂，右边是休息室。
LONG
        );
        
        set("exits", ([ /* sizeof() == 4 */
  "west" : __DIR__"tingtang",
  "east" : __DIR__"xiangfang_1",
  "south" : __DIR__"guangming-ding",
  "north" : __DIR__"guangchang1",
  
]));
        set("no_clean_up", 0);

        setup();
        
}

void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
深夜，更深夜沉，满天繁星。这里是一条小过道，由数块巨大的
花岗岩铺成，北边通向城中的演武场,演武场中不时传来城中居民
练习武功的拳脚声。左边是厅堂，右边是休息室。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
清晨，太阳刚从东方的地平线升起。这里是一条小过道，由数块
巨大的花岗岩铺成，北边通向城中的演武场,演武场中不时传来城
中居民练习武功的拳脚声。左边是厅堂，右边是休息室。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
午后时分，太阳从你正上方照耀着大地。这里是一条小过道，由
数块巨大的花岗岩铺成，北边通向城中的演武场,演武场中不时传
来城中居民练习武功的拳脚声。左边是厅堂，右边是休息室。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
下午的太阳开始从西方的天空中慢慢西沉。这里是一条小过道，
由数块巨大的花岗岩铺成，北边通向城中的演武场,演武场中不时
传来城中居民练习武功的拳脚声。左边是厅堂，右边是休息室。
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，夜幕笼罩着大地。这里是一条小过道，由数块巨大
的花岗岩铺成，北边通向城中的演武场,演武场中不时传来城中居
民练习武功的拳脚声。左边是厅堂，右边是休息室。
LONG
);
		}
		return 0;
	}
}