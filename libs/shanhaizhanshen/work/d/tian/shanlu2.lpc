// Room: shanlu2.c

inherit ROOM;
int do_look(string arg);
void create()
{
        set("short", "山路");
        set("long", @LONG
山路越走越陡，一不小心就会摔倒。山路上满是黄土，山风一吹，
吹得你一个灰头土脸，忍不住连打几个喷嚏。一枝枯树横躺在山
路上，几只乌鸦站立枝头，“呱呱”乱叫。
LONG
        );
        set("exits", ([
  "north" : __DIR__"shanmen",
  "south" : __DIR__"shanjiao",
]));
        set("no_clean_up", 0);
        set("outdoors", "tian");

        setup();
}

void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
深夜，更深夜沉，满天繁星。山路越走越陡，一不小心就会摔倒
。山路上满是黄土，山风一吹，吹得你一个灰头土脸，忍不住连
打几个喷嚏。一枝枯树横躺在山路上，几只乌鸦站立枝头，“呱
呱”乱叫。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
清晨，太阳刚从东方的地平线升起。山路越走越陡，一不小心就
会摔倒。山路上满是黄土，山风一吹，吹得你一个灰头土脸，忍
不住连打几个喷嚏。一枝枯树横躺在山路上，几只乌鸦站立枝头，
“呱呱”乱叫。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
午后时分，太阳从你正上方照耀着大地。山路越走越陡，一不小
心就会摔倒。山路上满是黄土，山风一吹，吹得你一个灰头土脸，
忍不住连打几个喷嚏。一枝枯树横躺在山路上，几只乌鸦站立枝
头，“呱呱”乱叫。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
下午的太阳开始从西方的天空中慢慢西沉。山路越走越陡，一不
小心就会摔倒。山路上满是黄土，山风一吹，吹得你一个灰头土
脸，忍不住连打几个喷嚏。一枝枯树横躺在山路上，几只乌鸦站
立枝头，“呱呱”乱叫。
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，夜幕笼罩着大地。山路越走越陡，一不小心就会摔
倒。山路上满是黄土，山风一吹，吹得你一个灰头土脸，忍不住
连打几个喷嚏。一枝枯树横躺在山路上，几只乌鸦站立枝头，“
呱呱”乱叫。
LONG
);
		}
		return 0;
	}
}


