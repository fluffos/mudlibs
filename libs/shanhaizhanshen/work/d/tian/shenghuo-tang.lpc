#include <ansi.h>
inherit ROOM;
int do_look(string arg);
void create()
{
        set("short", RED"星凝圣堂"NOR);
        set("long", 
"这里就是星凝圣堂所在。正上方有一幅横匾上书「"RED"星凝圣堂"NOR"」
四个血红大字。正面墙上的石壁中刻着一团巨大的火红烈焰，升腾向上，呼之
欲出。\n"
RED @LONEA
     .
          .   :   .
