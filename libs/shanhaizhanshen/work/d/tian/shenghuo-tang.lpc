  --'  \  '._.=._.'  /  '--
    _.-''.  '._.'  .''-._
   '    .''-.(_).-''.    '
      .'   '  :  '   '.
         '    :   '
              '
LONEA
NOR 
        );
        set("objects", ([
		__DIR__"npc/dishitian" : 1,
                
	]));
        set("exits", ([ /* sizeof() == 3 */
  "south" : __DIR__"juyiting",
  
]));
        
        set("no_clean_up", 0);

        setup();
        
}

void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
