// Room: shanjiao.c

inherit ROOM;
int do_look(string arg);
void create()
{
        set("short", "山脚下");
        set("long", @LONG
山风怒号，云蒸雾涌，一座大山悄然展现在你的眼前，它一岭孤
悬，长至三里，两旁陡绝，深陷万丈。
LONG
        );
        set("exits", ([ /* sizeof() == 3 */
  "south" : __DIR__"luzhou",
  "north" : __DIR__"shanlu2",
  
]));
        set("no_clean_up", 0);
        set("outdoors", "tian");

        setup();
       
}

void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
				set("long", @LONG
深夜，更深夜沉，满天繁星。山风怒号，云蒸雾涌，一座大山悄
然展现在你的眼前，它一岭孤悬，长至三里，两旁陡绝，深陷万丈。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
清晨，太阳刚从东方的地平线升起。山风怒号，云蒸雾涌，一座
大山悄然展现在你的眼前，它一岭孤悬，长至三里，两旁陡绝，
深陷万丈。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
午后时分，太阳从你正上方照耀着大地。山风怒号，云蒸雾涌，
一座大山悄然展现在你的眼前，它一岭孤悬，长至三里，两旁陡
绝，深陷万丈。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
下午的太阳开始从西方的天空中慢慢西沉。山风怒号，云蒸雾涌，
一座大山悄然展现在你的眼前，它一岭孤悬，长至三里，两旁陡
绝，深陷万丈。
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，夜幕笼罩着大地。山风怒号，云蒸雾涌，一座大山
悄然展现在你的眼前，它一岭孤悬，长至三里，两旁陡绝，深陷
万丈。
LONG
);
		}
		return 0;
	}
}


