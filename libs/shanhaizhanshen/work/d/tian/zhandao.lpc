// Room: zhandao.c

#include <ansi.h>
#include <room.h>
inherit ROOM;
int do_look(string arg);
void create() {
  set("short", HIR "城道" NOR);
  set("long", @LONG
你好不容易爬上城道，但见山势险峻，树木清幽，鸟鸣嘤嘤，流
水淙淙。你越山脊而上，两崖深不见底，凡险峻处，如身置太空，
肝摇胆撼。南面就是星凝城的山门了。
LONG
  );

  set("no_out", 1);
  set("outdoors", "tian");
  set("exits", ([ /* sizeof() == 2 */
    "west": __DIR__ "shanlu1",
    "south": __DIR__ "shanmen",
  ]));

  setup();
}

void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
深夜，更深夜沉，满天繁星。你好不容易爬上城道，但见山势险
峻，树木清幽，鸟鸣嘤嘤，流水淙淙。你越山脊而上，两崖深不
见底，凡险峻处，如身置太空，肝摇胆撼。南面就是星凝城的山
门了。
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
清晨，太阳刚从东方的地平线升起。你好不容易爬上城道，但见
山势险峻，树木清幽，鸟鸣嘤嘤，流水淙淙。你越山脊而上，两
崖深不见底，凡险峻处，如身置太空，肝摇胆撼。南面就是星凝
城的山门了。
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
午后时分，太阳从你正上方照耀着大地。你好不容易爬上城道，
但见山势险峻，树木清幽，鸟鸣嘤嘤，流水淙淙。你越山脊而上，
两崖深不见底，凡险峻处，如身置太空，肝摇胆撼。南面就是星
凝城的山门了。
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
下午的太阳开始从西方的天空中慢慢西沉。你好不容易爬上城道，
但见山势险峻，树木清幽，鸟鸣嘤嘤，流水淙淙。你越山脊而上，
两崖深不见底，凡险峻处，如身置太空，肝摇胆撼。南面就是星
凝城的山门了。
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚降临了，夜幕笼罩着大地。你好不容易爬上城道，但见山势
险峻，树木清幽，鸟鸣嘤嘤，流水淙淙。你越山脊而上，两崖深
不见底，凡险峻处，如身置太空，肝摇胆撼。南面就是星凝城的
山门了。
LONG
        );
    }
    return 0;
  }
}
