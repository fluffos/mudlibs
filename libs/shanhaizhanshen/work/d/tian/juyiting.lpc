// Room: juyiting.c

inherit ROOM;
int do_look(string arg);
void create()
{
        set("short", "后院");
        set("long", @LONG
走廊过来是个院子，院中花卉暗香浮动，但见北边的窗子中透出
灯火之光，火苗闪烁不已，似乎有人影晃动，好象刚有人从此走
过！
LONG
        );
        set("exits", ([ /* sizeof() == 4 */
  "north" : __DIR__"shenghuo-tang",
  "west" : __DIR__"zoulang4",
  "south" : __DIR__"shiwangdian",
  "east" : __DIR__"zoulang3",
]));
        
        set("no_clean_up", 0);
set("outdoors", "tian");
        setup();
        
}

void init()
{
		add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
			set("long", @LONG
深夜，更深夜沉，满天繁星。走廊过来是个院子，院中花卉暗香
浮动，但见北边的窗子中透出灯火之光，火苗闪烁不已，似乎有
人影晃动，好象刚有人从此走过！
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
清晨，太阳刚从东方的地平线升起。走廊过来是个院子，院中花
卉暗香浮动，但见北边的窗子中透出灯火之光，火苗闪烁不已，
似乎有人影晃动，好象刚有人从此走过！
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
午后时分，太阳从你正上方照耀着大地。走廊过来是个院子，院
中花卉暗香浮动，但见北边的窗子中透出灯火之光，火苗闪烁不
已，似乎有人影晃动，好象刚有人从此走过！
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
下午的太阳开始从西方的天空中慢慢西沉。走廊过来是个院子，
院中花卉暗香浮动，但见北边的窗子中透出灯火之光，火苗闪烁
不已，似乎有人影晃动，好象刚有人从此走过！
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，夜幕笼罩着大地。走廊过来是个院子，院中花卉暗
香浮动，但见北边的窗子中透出灯火之光，火苗闪烁不已，似乎
有人影晃动，好象刚有人从此走过！
LONG
);
		}
		return 0;
	}
}