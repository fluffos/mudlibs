// shantang.c
// shilling 97.2

inherit ROOM;
int do_look(string arg);
void create()
{
	set("short", "膳食厅");
	set("long", @LONG
这里是星凝城中的一间小小的酒家，地方虽然不大，但是也有不
少城中的居民光顾这里。你终于找到香味的来源了，看着可口的
饭菜，你忍不住也想叫 (order)一份了。
LONG );
	set("exits",([
		"east" : __DIR__"zoulang4",
	]));
	set("no_clean_up", 0);
	set("ricewater", 5);
	setup();
}
void init()
{
        add_action("do_order","order");
        add_action("do_look", "look");
}

int do_order(string arg)
{
	object me;
	object food;
	object water;
	me=this_player();
	if (arg)  return notify_fail("厨师跑出来道: 这样东西这里没有啊。\n");
	if (query("ricewater")>0)
	{
		message_vision("厨师连声答应，从内厅一溜烟跑出来，端着一碗米饭和一碗水拿了给$N。\n",me);
		food=new("obj/rice");
		water=new("obj/bowl");
		food->move(me);
		water->move(me);
		add("ricewater",-1);
	}
	else 
		message_vision("厨师在内厅对$N歉声应道: 嗨，吃的喝的都没了。\n",me);
	return 1; 
}
int valid_leave(object me,string dir)
{
	me=this_player();
        if(dir=="east" && (present("bowl",this_player()) || present("rice",this_player()))) 
             return notify_fail("厨师说道：真抱歉，我们这里没有打包服务。\n");
        return ::valid_leave(me,dir);
}

//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg)
{
	object me = this_player();
	mixed *local;
    int night;
	night = 0;
	local = localtime(time() * 60);
	if (local[2] < 5 || local[2] >= 19) night = 1;

	if (!arg) {

{
			if (local[2] < 5 || local[2] > 19)//半夜
			set("long", @LONG
深夜，更深夜沉，满天繁星。这里是星凝城中的一间小小的酒家，
地方虽然不大，但是也有不少城中的居民光顾这里。你终于找到
香味的来源了，看着可口的饭菜，你忍不住也想叫 (order)一份了。
LONG
);
			
			else if (local[2] < 10)//清晨
				set("long",@LONG
清晨，太阳刚从东方的地平线升起。这里是星凝城中的一间小小
的酒家，地方虽然不大，但是也有不少城中的居民光顾这里。你
终于找到香味的来源了，看着可口的饭菜，你忍不住也想叫 (order)一份了。
LONG
);
			else if (local[2] < 15)//正午
				set("long",@LONG
午后时分，太阳从你正上方照耀着大地。这里是星凝城中的一间
小小的酒家，地方虽然不大，但是也有不少城中的居民光顾这里。
你终于找到香味的来源了，看着可口的饭菜，你忍不住也想叫 (order)
一份了。
LONG
);
			else if (local[2] < 18)//傍晚
				set("long",@LONG
下午的太阳开始从西方的天空中慢慢西沉。这里是星凝城中的一
间小小的酒家，地方虽然不大，但是也有不少城中的居民光顾这
里。你终于找到香味的来源了，看着可口的饭菜，你忍不住也想
叫 (order)一份了。
LONG
);
			else//入夜
				set("long",@LONG
夜晚降临了，夜幕笼罩着大地。这里是星凝城中的一间小小的酒
家，地方虽然不大，但是也有不少城中的居民光顾这里。你终于
找到香味的来源了，看着可口的饭菜，你忍不住也想叫 (order)
一份了。
LONG
);
		}
		return 0;
	}
}