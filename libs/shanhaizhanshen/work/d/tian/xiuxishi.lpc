// Room: xiuxishi.c

inherit ROOM;
int do_look(string arg);
void create() {
  set("short", "休息室");
  set("long", @LONG
这里是城主起居休息的地方。靠墙摆着一张大床，床头叠着床薄
被，南面的长窗往外可以看到幽静的竹林小院，阵阵山风掠过，
飘来阵阵竹叶的清香。
      
        ||
        ||                   ||
     ||/||___                ||
     || /`   )____________||_/|
     ||/___ //_/_/_/_/_/_/||/ |
     ||(___)/_/_/_/_/_/_/_||  |
     ||     |_|_|_|_|_|_|_|| /|
     ||     | | | | | | | ||/||
     ||~~~~~~~~~~~~~~~~~~~||
     ||                   ||              
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "west": __DIR__ "zoulang3",

  ]));
  set("sleep_room", "1");
  set("no_fight", "1");
  set("no_clean_up", 0);

  setup();

}

void init() {
  add_action("do_look", "look");
}
//月影（neva）2002年4月28日删改前辈观星台源程序为动态房间。
int do_look(string arg) {
  object me = this_player();
  mixed *local;
  int night;
  night = 0;
  local = localtime(time() * 60);
  if (local[2] < 5 || local[2] >= 19) night = 1;

  if (!arg) {

    {
      if (local[2] < 5 || local[2] > 19)  //半夜
        set("long", @LONG
深夜，更深夜沉，满天繁星。这里是城主起居休息的地方。靠墙
摆着一张大床，床头叠着床薄被，南面的长窗往外可以看到幽静
的竹林小院，阵阵山风掠过，飘来阵阵竹叶的清香。
      
        ||
        ||                   ||
     ||/||___                ||
     || /`   )____________||_/|
     ||/___ //_/_/_/_/_/_/||/ |
     ||(___)/_/_/_/_/_/_/_||  |
     ||     |_|_|_|_|_|_|_|| /|
     ||     | | | | | | | ||/||
     ||~~~~~~~~~~~~~~~~~~~||
     ||                   ||              
LONG
        );

      else if (local[2] < 10)  //清晨
        set("long", @LONG
清晨，太阳刚从东方的地平线升起。这里是城主起居休息的地方。
靠墙摆着一张大床，床头叠着床薄被，南面的长窗往外可以看到
幽静的竹林小院，阵阵山风掠过，飘来阵阵竹叶的清香。
      
        ||
        ||                   ||
     ||/||___                ||
     || /`   )____________||_/|
     ||/___ //_/_/_/_/_/_/||/ |
     ||(___)/_/_/_/_/_/_/_||  |
     ||     |_|_|_|_|_|_|_|| /|
     ||     | | | | | | | ||/||
     ||~~~~~~~~~~~~~~~~~~~||
     ||                   ||              
LONG
        );
      else if (local[2] < 15)  //正午
        set("long", @LONG
午后时分，太阳从你正上方照耀着大地。这里是城主起居休息的
地方。靠墙摆着一张大床，床头叠着床薄被，南面的长窗往外可
以看到幽静的竹林小院，阵阵山风掠过，飘来阵阵竹叶的清香。
      
        ||
        ||                   ||
     ||/||___                ||
     || /`   )____________||_/|
     ||/___ //_/_/_/_/_/_/||/ |
     ||(___)/_/_/_/_/_/_/_||  |
     ||     |_|_|_|_|_|_|_|| /|
     ||     | | | | | | | ||/||
     ||~~~~~~~~~~~~~~~~~~~||
     ||                   ||              
LONG
        );
      else if (local[2] < 18)  //傍晚
        set("long", @LONG
下午的太阳开始从西方的天空中慢慢西沉。这里是城主起居休息
的地方。靠墙摆着一张大床，床头叠着床薄被，南面的长窗往外
可以看到幽静的竹林小院，阵阵山风掠过，飘来阵阵竹叶的清香。
      
        ||
        ||                   ||
     ||/||___                ||
     || /`   )____________||_/|
     ||/___ //_/_/_/_/_/_/||/ |
     ||(___)/_/_/_/_/_/_/_||  |
     ||     |_|_|_|_|_|_|_|| /|
     ||     | | | | | | | ||/||
     ||~~~~~~~~~~~~~~~~~~~||
     ||                   ||              
LONG
        );
      else  //入夜
        set("long", @LONG
夜晚降临了，夜幕笼罩着大地。这里是城主起居休息的地方。靠
墙摆着一张大床，床头叠着床薄被，南面的长窗往外可以看到幽
静的竹林小院，阵阵山风掠过，飘来阵阵竹叶的清香。
      
        ||
        ||                   ||
     ||/||___                ||
     || /`   )____________||_/|
     ||/___ //_/_/_/_/_/_/||/ |
     ||(___)/_/_/_/_/_/_/_||  |
     ||     |_|_|_|_|_|_|_|| /|
     ||     | | | | | | | ||/||
     ||~~~~~~~~~~~~~~~~~~~||
     ||                   ||              
LONG
        );
    }
    return 0;
  }
