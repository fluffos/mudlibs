// tea.c

inherit F_CONTAINER;

void create()
{
	set_name("红茶", ({ "black tea", "black", "tea" }) );
	set_weight(200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一小杯芳香的锡兰红茶。\n");
		set("unit", "杯");
		set("value", 10 );
		set("max_liquid", 2 );
		set("destruct_if_empty", 1 );
	}

// The liquid contained in the container is independent, we set a copy
// in each cloned copy.
	set("liquid", ([
		"type": "black tea",
		"name": "锡兰红茶",
		"remaining": 2,
	]) );
}
