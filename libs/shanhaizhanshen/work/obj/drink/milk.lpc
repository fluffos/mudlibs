// milk.c

inherit F_CONTAINER;

void create()
{
	set_name("牛奶", ({ "milk" }) );
	set_weight(300);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一小瓶煮过的牛奶。\n");
		set("unit", "瓶");
		set("value", 2 );
		set("max_liquid", 3 );
		set("destruct_if_empty", 1 );
	}

// The liquid contained in the container is independent, we set a copy
// in each cloned copy.
	set("liquid", ([
		"type": "milk",
		"name": "牛奶",
		"remaining": 3,
	]) );
}
