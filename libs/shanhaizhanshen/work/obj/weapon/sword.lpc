// sword.c

#include <weapon.h>

inherit SWORD;

void create()
{
	set_name("长剑", ({ "sword" }) );
	set_weight(5000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
                set("long", "这是一把普通的长剑。\n");
		set("value", 1500);
                set("material", "钢");
                set("wield_msg", "$N 唰地一声抽出一把 $n 握在手中。\n");
                set("unwield_msg", "$N 把手中的 $n 插入腰间的剑鞘。\n");
	}
        init_sword( 2, 5, 7, 1, 2);
	setup();
}
