// rod.c

#include <weapon.h>

inherit STAFF;

void create()
{
	set_name("短棍", ({ "rod" }) );
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "枝");
                set("long", 
"这是一支小巧的短棍。\n");
		set("value", 100);
                set("material", "木材");
                set("wield_msg", "$N 从腰间抽出一枝 $n 握在手中。\n");
                set("unwield_msg", "$N 将手中的 $n 插入腰间的皮套。\n");
	}
        init_staff( 1, 5, 3, 1, 2);
	setup();
}
