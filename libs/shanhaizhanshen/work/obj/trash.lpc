// trash.c

inherit ITEM;

int decayed;

void create()
{
	set_name("紀臟摧纄", ({ "a pile of trash", "trash" }) );
	set("long", "硂琌帮紀臟摧纄.\n");
	set("unit", "帮" );
	decayed = 0;
	if( clonep(this_object()) ) call_out("decay", 120, 1);
}

int is_trash() { return decayed < 2; }
int is_vehicle() { return decayed < 1; }
int is_container() { return 1; }

string short() { return name() + "(" + capitalize(query("id")) + ")"; }

void decay(int phase)
{
	decayed = phase;
	switch(phase) {
		case 1:
			say( query("name") + "秨﹍ネ拿.\n" );
			set("long",	"硂帮ネ拿摧纄陪礛竒硂柑琿丁.\n");
			call_out("decay", 120, phase + 1);
			break;
		case 2:
			say( query("name") + "竒拿Υ.\n" );
			set_name("帮ネ拿紀臟", ({ "metal", "trash" }) );
			set("long", "硂帮紀臟竒硂柑.\n");
			call_out("decay", 60, phase + 1);
			break;
		case 3:
			say( "皚筁, р" + query("name") + "床.\n" );
			destruct(this_object());
			break;
	}
}

