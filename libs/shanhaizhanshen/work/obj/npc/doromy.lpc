// doromy.c

#include <ansi.h>

inherit NPC;

void create()
{
	set_name( HIR "毁灭巫师" HIW "月影" NOR, ({ "neva" }) );
	set("long",
		"不知所谓的新手巫师。\n");
		
	
	set("gender", "女性");
	set("age", 24);
	set("pursuer", 1);

	set("str", 25);
	set("dex", 25);
	set("not", 25);
	set("int", 23);
	set("wis", 25);
	set("con", 25);
	set("cha", 25);
	set("tec", 10);

	set("dice_number", 20);
	set("dice_roll", 5);
	set("damage_bonus", 20);
	set("round", 2);
	set("legal_wield_weapon/maniac", 1 );

	set("level",1000);

	

	set_temp("apply/attack", 10);
	set_temp("apply/defense", 10);

	setup();

	carry_object(__DIR__"obj/doom_staff")->wield();
	carry_object(__DIR__"obj/black_robe")->wear();
}

void start_shutdown( int min )
{
	if( geteuid(previous_object()) != ROOT_UID ) return;

	message("system",
		HIR "\n你听到天空中隐隐传来一阵可怖的声音 ....\n"
		RED	"毁灭巫师" HIW "月影" HIR "用她阴森的声音叫道：\n"
			"\t\t下雨了，大家回家收衣服啦！！！！\n"
NOR,
			 
		users() );
	call_out("countdown", 60, min);
}

private void countdown(int min)
{
	min--;
	if( min ) {
		message("system",
			RED "\n毁灭巫师" HIW "月影" HIR "可怖的声音再度传来：\n"
				"\t\t再等" + chinese_number(min) + "分钟，大雨就要来了。\n"
				"\t\t大家快跑呀，小心淋湿衣服呀！！！！！\n"  NOR,
			users() );
		call_out("countdown", 60, min);
	} else {
		message("system",
			RED "\n毁灭巫师" HIW "月影" HIR "低沉的声音从四面八方传来：\n"
				"\t\t打雷了！！！下雨了！！！\n"
				"\t\t你们不走，我先回家躲雨了！！！！！\n" NOR,
			users() );
		call_out("do_shutdown", 3);
	}
}

private void do_shutdown()
{
	message("system",
		RED "\n毁灭巫师" HIW "月影" HIR "气运全身，使出一招终极绝招：\n"
		HIW "\t\t巫师绝技之终极连锁逃得快！！！！\n"
		HIR "\t\t此时暴风骤雨开始跟在月影巫师的背后降下。。。。。\n"
			"\t\t山海战神的世界很快地被大水淹灭了......\n"
			NOR,
		users() );
	shutdown(0);
}

void die()
{
	object ob;

	if( !ob = query_temp("last_damage_from") )
		ob = this_player(1);

	if( !ob ) return;

	message("system",
		HIR "\n\n\n"
		RED "毁灭巫师" HIW "月影" HIR "喊着： " NOR + ob->name(1) + HIR "，你竟然欺负巫师！！！！\n"
			"我不和你们玩了。\n" ,
		users() );
	destruct(this_object());
}
