// shield.c

#include <armor.h>

inherit SHIELD;

void create()
{
        set_name( "钢制大盾", ({ "steel shield", "steel", "shield" }) );
	set_weight(10000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一面以钢打造的方形大盾。");
		set("unit", "面");
		set("value", 20000);
                set("armor_prop/dodge", -20);
		set("armor_prop/defense", 10);
                set("armor_prop/dp", 100);
	}
	setup();
}
