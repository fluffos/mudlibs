// shield.c

#include <armor.h>

inherit BOOTS;

void create()
{
        set_name( "鞋子", ({ "boots" }) );
	set_weight(10000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一双鞋子。");
		set("unit", "双");
		set("value", 20000);
               
		set("armor_prop/defense", 10);
                set("armor_prop/dp", 100);
	}
	setup();
}
