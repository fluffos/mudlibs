// shield.c

#include <armor.h>

inherit CLOAK;

void create()
{
        set_name( "披风", ({ "cloak" }) );
	set_weight(10000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一件普通的披风。");
		set("unit", "件");
		set("value", 20000);
                set("armor_prop/dodge", -20);
		set("armor_prop/defense", 10);
                set("armor_prop/dp", 100);
	}
	setup();
}
