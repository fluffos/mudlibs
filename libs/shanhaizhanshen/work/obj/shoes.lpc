// shoes.c
//
// This is the basic equip for players.

#include <armor.h>

inherit BOOTS;

void create() {
  set_name("布鞋", ({ "shoes" }));
  set_weight(700);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "双");
    set("long",
      "一双普通的麻布鞋。\n");
    set("value", 20);
    set("armor_prop/traditional_armor", 1);
  }
  setup();
}
