// common_b.c

inherit BULLETIN_BOARD;

void create()
{
	set_name("山海战神留言板", ({ "board" }) );
	set("board_id", "common_b");
	set_weight(20000);
	if( clonep() ) {
		set_default_object(__FILE__);
	}
	else {
		set("long", "这是供玩家留言交流的留言板。\n" );
		set("unit", "");
		set("capacity", 100);
		set("value", 10 );
	}
	setup();
}
