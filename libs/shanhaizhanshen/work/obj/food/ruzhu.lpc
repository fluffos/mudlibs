// beef_steak.c

inherit F_FOOD;

void create()
{
	 set_name("乳猪", ({"zhu","ru zhu"}));
	set_weight(450);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一只烤得发红的乳猪，味道一流。\n");
		set("unit", "碟");
		set("value", 10 );
		set("food/remaining", 8 );
		set("food/supply", 20 );
		set("food/water", 10 );
	}
	setup();
}
