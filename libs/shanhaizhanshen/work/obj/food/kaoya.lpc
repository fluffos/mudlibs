// beef_steak.c

inherit F_FOOD;

void create()
{
	 set_name("烤鸭", ({"kaoya", "ya"}));
	set_weight(450);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一只刚刚出炉的烤鸭，散发着难以抵抗的香气。\n");
		set("unit", "只");
		set("value", 10 );
		set("food/remaining", 8 );
		set("food/supply", 20 );
		set("food/water", 10 );
	}
	setup();
}
