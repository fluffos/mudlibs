// mongolian_barbicue.c

inherit F_FOOD;

void create() {
  set_name("烤肉", ({ "barbicue" }));
  set_weight(400);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一份香味四逸，加上许多香辛料和蔬菜的烤肉。\n");
    set("unit", "份");
    set("value", 6);
    set("food/remaining", 7);
    set("food/supply", 13);
    set("food/water", 5);
  }
  setup();
}
