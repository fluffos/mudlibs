// jelly_bread.c

inherit F_FOOD;

void create() {
  set_name("面包", ({ "jelly bread", "jelly", "bread" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一块面包。\n");
    set("unit", "块");
    set("value", 5);
    set("food/remaining", 5);
    set("food/supply", 10);
    set("food/water", 3);
  }
  setup();
}
