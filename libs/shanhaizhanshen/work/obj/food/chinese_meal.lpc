// chinese_meal.c

inherit F_FOOD;

void create()
{
	set_name("中式套餐", ({ "chinese meal", "chinese", "meal" }) );
	set_weight(750);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一份有葱爆牛肉、虾仁滑蛋、金镶玉板三道菜的中式套餐。\n");
		set("unit", "");
		set("value", 8 );
		set("food/remaining", 12 );
		set("food/supply", 15 );
		set("food/water", 10 );
	}
	setup();
}
