// beef_steak.c

inherit F_FOOD;

void create()
{
	set_name("牛排", ({ "beef steak", "beef", "steak" }) );
	set_weight(450);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一块淋上蘑菇酱的七分熟牛排，正热腾腾地盛在铁板上。\n");
		set("unit", "块");
		set("value", 10 );
		set("food/remaining", 8 );
		set("food/supply", 20 );
		set("food/water", 10 );
	}
	setup();
}
