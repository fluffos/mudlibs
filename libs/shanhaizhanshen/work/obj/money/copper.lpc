// coin.c

inherit MONEY;

void create() {
  set_name("铜币", ({ "coin", "copper", "copper_coin", "copper_money" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("money_id", "copper");
    set("long", "这是流通单位最小的货币，约要一百枚铜币才值得一枚银币。\n");
    set("unit", "些");
    set("base_value", 1);
    set("base_unit", "枚
");
    set("base_weight", 3);
  }
  set_amount(1);
}
