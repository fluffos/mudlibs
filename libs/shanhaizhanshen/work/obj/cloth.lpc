// cloth.c
//
// This is the basic equip for players.

#include <armor.h>

inherit U_ARMOR;

void create()
{
	set_name("布衣", ({ "cloth" }) );
        set_weight(700);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("long",
"一套最普通的麻布上衣和长裤。\n");
                set("material", "麻布");
                set("value", 30);
		set("armor_prop/traditional_armor", 1);
	}
	setup();
}
