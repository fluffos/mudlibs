// cabin_key.c
#include <weapon.h>
inherit DAGGER;

int is_key() { return 1; }

void create()
{
	set_name("袁环秋的钥匙", ({ "key of yuan", "key9" }) );
	set_weight( 50);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", " 
     /\___________   
     \/~~~~~~~~~~~`  
\n");
		set("unit", "把");
		set("value", 50);
		set("key_id", "shiwang/calou_key");
	}

init_dagger(1, 6, 3, 1, 1);
	
setup();
}