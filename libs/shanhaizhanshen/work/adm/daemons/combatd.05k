void create()
{
	seteuid(getuid());
	set("name", "戰鬥精靈");
	set("id", "combatd");
}

string damage_msg(int damage, string type)
{
	string str;

        if( damage == 0 ) return "並沒有造成任何傷害.\n";

	switch( type ) {
	case "割傷":
                if( damage < 20 ) return "只是輕輕地擦破 $p $l 的皮肉.\n";
                else if( damage < 40 ) return "在 $p $l 劃出一道細長的血痕.\n";
                else if( damage < 80 ) return HIW "「嗤」地一聲在 $p $l 劃出一道傷口 !\n";
                else if( damage < 160 ) return HIY "「嗤」地一聲在 $p $l 砍出一道血淋淋的傷口 !\n";
                else if( damage < 320 ) return HIR "「嗤」地一聲在 $p $l 砍出一道又長又深的傷口, 濺得 $N 滿臉鮮血 !\n";
                else return HIM "只聽見 $p 一聲慘叫, $w 已把 $l 斬成兩截 ! !\n";
		break;
	case "刺傷":
                if( damage < 20 ) return "只是輕輕地刺破 $p $l 的皮肉.\n";
                else if( damage < 40 ) return "在 $p $l 刺出一個創口.\n";
                else if( damage < 80 ) return HIW "「噗」地一聲刺入了 $p $l 寸許\ !\n";
                else if( damage < 160 ) return HIY "「噗」地一聲刺進 $p 的 $l, 使 $p 不由自主地退了幾步 !\n";
                else if( damage < 320 ) return HIR "「噗嗤」地一聲, $w 已在 $p $l 刺出一個血肉糢糊的窟窿 !\n";
                else return HIM "結果只聽見 $p 一聲慘叫, $w 已在 $p 的 $l 對穿而出, 血濺滿地 ! !\n";
		break;
	case "瘀傷":
                if( damage < 20 ) return "在 $p 的 $l 打出一處紅印子.\n";
                else if( damage < 40 ) return "一擊命中, $p 的 $l 登時腫了一塊.\n";
                else if( damage < 80 ) return HIW "一擊命中, 使 $p 悶哼了一聲 !\n";
                else if( damage < 160 ) return HIY "「砰」地一聲, 打得 $p 連退了兩步 !\n";
                else if( damage < 320 ) return HIR "這一下「砰」地一聲打得 $p 痛得慘叫 !\n";
                else return HIM "重重地擊中, $p「哇」地一聲吐出一口鮮血 ! !\n";
		break;
        case "槍傷":
                if( damage < 20 ) return "「砰」地一聲, 只擦傷了 $p $l 的皮肉.\n";
                else if( damage < 40 ) return "「砰」地一聲, 打傷了 $p 的 $l.\n";
                else if( damage < 80 ) return HIW "「砰」地一聲, 打在 $p $l 上, 傷口血流不止.\n";
                else if( damage < 160 ) return HIY "「砰」地一聲, 打中 $p $l, 鮮血染紅了整件衣服.\n";
                else if( damage < 320 ) return HIR "「砰」地一聲, 在 $p $l 打出一個窟窿, 登時鮮血濺得滿地.\n";
                else return HIM "「砰」地一聲, $p $l 上開了一個大洞, 血肉立時飛濺四處.\n";
        case "炸傷":
                if( damage < 20 ) return "「轟」地一聲, 只傷到 $p $l 的皮肉.\n"; 
                else if( damage < 40 ) return "「轟」地一聲, 炸傷了 $p 的 $l.\n";
                else if( damage < 80 ) return HIW "「轟隆」一聲, $p $l 上傷痕累累, 血流不止.\n";
                else if( damage < 160 ) return HIY "「轟隆」一聲, $p 的 $l 炸得血肉模糊, 鮮血四濺.\n";
                else if( damage < 320 ) return HIR "「轟」地一聲巨響, $p 的 $l 炸了個稀爛, 血肉橫飛四散.\n";
                else return HIM "「轟」地一聲巨響, 天搖地動, 只見 $p $l 已經炸飛, 不知去向.\n";
	default:
		if( !type ) type = "傷害";
                if( damage < 20 ) str =  "只是造成一處輕微";
                else if( damage < 40 ) str = "造成一處";
                else if( damage < 80 ) str = HIW "造成一處嚴重";
                else if( damage < 160 ) str = HIY "造成頗為嚴重的";
                else if( damage < 320 ) str = HIR "造成相當嚴重的";
                else str = HIM "造成極其嚴重的可怕";
		return str + type + "!\n";
	}
}

string v_damage_msg(int damage, string type)
{
	string str;

        if( damage == 0 ) return "並沒有造成任何損壞.\n";

	switch( type ) {
        case "槍傷":
                if( damage < 20 ) return "「砰」地一聲, 只擦到了 $p $l 的表面.\n";
                else if( damage < 40 ) return "「砰」地一聲, 打凹了 $p 的 $l.\n";
                else if( damage < 80 ) return HIW "「砰」地一聲, 打穿了 $p 的 $l.\n";
                else if( damage < 160 ) return HIY "「砰」地一聲, 在 $p 的 $l 上打了個孔.\n";
                else if( damage < 320 ) return HIR "「砰」地一聲, 在 $p $l 上打出一個窟窿.\n";
                else return HIM "「砰」地一聲, $p $l 上開了一個大洞.\n";
        case "炸傷":
                if( damage < 20 ) return "「轟」地一聲, 只傷到 $p $l 的表面.\n"; 
                else if( damage < 40 ) return "「轟」地一聲, 炸凹了 $p 的 $l.\n";
                else if( damage < 80 ) return HIW "「轟隆」一聲, $p $l 上擦痕累累.\n";
                else if( damage < 160 ) return HIY "「轟隆」一聲, $p 的 $l 炸得面目皆非.\n";
                else if( damage < 320 ) return HIR "「轟」地一聲巨響, $p 的 $l 炸得破爛不堪.\n";
                else return HIM "「轟」地一聲巨響, 天搖地動, 只見 $p $l 已經炸飛, 不知去向.\n";
	default:
		if( !type ) type = "損壞";
                if( damage < 20 ) str =  "只是造成一處輕微";
                else if( damage < 40 ) str = "造成一處";
                else if( damage < 80 ) str = HIW "造成一處嚴重";
                else if( damage < 160 ) str = HIY "造成頗為嚴重的";
                else if( damage < 320 ) str = HIR "造成相當嚴重的";
                else str = HIM "造成極其嚴重的可怕";
		return str + type + "!\n";
	}
}

string eff_status_msg(int ratio)
{
        if( ratio==100 ) return HIG "看來健康良好" NOR;
        if( ratio > 90 ) return HIG "看來有一些刮傷" NOR;
        if( ratio > 80 ) return GRN "看起來受了點小傷" NOR;
        if( ratio > 70 ) return GRN "身上有幾處傷口, 似乎並不礙事" NOR;
	if( ratio > 60 ) return HIY "受傷不輕, 看起來狀況並不太好" NOR;
        if( ratio > 50 ) return HIY "有些大傷口, 看來受傷實在不輕" NOR;
        if( ratio > 40 ) return YEL "全身傷痕累累, 正在勉力支撐下去" NOR;
        if( ratio > 30 ) return YEL "受了重傷, 只怕有生命的危險" NOR;
        if( ratio > 20 ) return HIR "傷重之下難以支撐, 眼看著就要倒下" NOR;
        if( ratio > 10  ) return HIR "連內臟都暴露出來了, 已經命在旦夕" NOR;
        return HIM "全身血肉模糊, 隨時可能死去" NOR;
}

string status_msg(int ratio)
{
        if( ratio==100 ) return HIG "看起來充滿活力" NOR;
        if( ratio > 90 ) return HIG "身上有些刮傷" NOR;
        if( ratio > 80 ) return GRN "看起來有些小傷" NOR;
        if( ratio > 70 ) return GRN "身上有些傷口, 而動作有點不太靈光" NOR;
        if( ratio > 60 ) return HIY "氣喘噓噓, 看起來身體狀況並不太好" NOR;
        if( ratio > 50 ) return HIY "重傷之下, 臉色十分蒼白難看" NOR;
        if( ratio > 40 ) return YEL "身上傷口深及見骨, 正在勉力支撐著" NOR;
        if( ratio > 30 ) return YEL "全身傷口濺血, 已有生命危險" NOR;
        if( ratio > 20 ) return HIR "連內臟都露了出來, 鮮血直噴四處" NOR;
        return HIM "全身已經血肉模糊, 隨時都可能死去" NOR;
}

string v_status_msg(int ratio)
{
        if( ratio==100 ) return HIG "看起來完好如新" NOR;
        if( ratio > 90 ) return HIG "有些刮傷" NOR;
        if( ratio > 80 ) return GRN "看起來有些小損壞" NOR;
        if( ratio > 70 ) return GRN "有些傷口損壞" NOR;
        if( ratio > 60 ) return HIY "看起來有多處損壞" NOR;
        if( ratio > 50 ) return HIY "整個看來損壞得差不多了" NOR;
        if( ratio > 40 ) return YEL "有多處嚴重損壞" NOR;
        if( ratio > 30 ) return YEL "已經損壞得破爛不堪" NOR;
        if( ratio > 20 ) return HIR "大限之期已到了" NOR;
        return HIM "快要成為一堆廢鐵了" NOR;
}

varargs string report_status(object ob, int effective)
{
        int *limbs_hit, *limbs_max_hit;
        int j, hit, max_hit; 

        hit = 0;    max_hit = 0;
        limbs_hit = ob->query("limbs_hit");
        limbs_max_hit = ob->query("limbs_max_hit");

        for( j = 0; j < sizeof( ob->query("limbs_hit")); j++ ) {
                hit += limbs_hit[j];
                max_hit += limbs_max_hit[j];
	}

	if(effective){
		return eff_status_msg( hit * 100 / max_hit );
	} else {
		return status_msg( hit * 100 / max_hit );
        }
}

string v_report_status(object ob)
{
        int *armors_hit, *armors_max_hit;
        int j, hit, max_hit; 

        hit = 0;    max_hit = 0;
        armors_hit = ob->query("armors_hit");
        armors_max_hit = ob->query("armors_max_hit");

        for( j = 0; j < sizeof( ob->query("armors_hit")); j++ ) {
                hit += armors_hit[j];
                max_hit += armors_max_hit[j];
	}
		return v_status_msg( hit * 100 / max_hit );
}

// This function calculates the combined skill/combat_exp power of a certain
// skill. This value is used for A/(A+B) probability use.
varargs int skill_power(object ob, string skill, int usage)
{
        int status, level, power;

	if( !living(ob) ) return 0;

	level = ob->query_skill(skill);

// The certain skill power = skill_level * spi %

	switch(usage) {
		case SKILL_USAGE_ATTACK:
			level += ob->query_temp("apply/attack");
			break;
		case SKILL_USAGE_DEFENSE:
			level += ob->query_temp("apply/defense");
			break;
		default:
			break;
	}

	if( !level ) return 0;

// The certain skill power = skill_level * spi %

        if( ( status = ob->query("spi") ) > 0 )
                power = level * ( status * 100 / ob->query("max_spi") ) / 100;
        else
                power = 0;

	return power;
}

// do_attack()
//
// Perform an attack action. This function is called by fight() or as an
// interface for some special utilize in quests.
//
varargs int do_attack(object me, object victim, object weapon, int attack_type)
{
	mapping action;
	string *limbs_c, result;
	string attack_skill, dodge_skill, parry_skill;
	string damage_type;
	int limb_number;
	int ap, dp, pp, level_bonus, exp;
	int damage, damage_bonus;
	int wounded = 0;
	int j;
	object *inv, your_driver;

	if( attack_type == TYPE_DRIVER ) {
		inv = all_inventory( victim );
		for( j = 0; j < sizeof( inv ); j ++ ) {
			if( inv[j]->query_temp("command") ) {
				your_driver = inv[j];
				break;
			}
		}
	}
//
// (1) Find out what action the offenser will take.
//
	if( objectp(weapon) ) {
		me->set("actions", WEAPON_D->query_action( weapon ) );

		if( (int)weapon->query("broken") ) {
			tell_object(me, HIM "\n" + weapon->query("name") + "已經損壞或故障了 !\n\n" NOR );
			weapon->unequip();
			me->reset_action();
		}

	}
	action = me->query("actions");
	if( !mapp(action) ) {
		me->reset_action();
		action = me->query("actions");
		if( !mapp(action) ) {
			CHANNEL_D->do_channel( this_object(), "sys",
				sprintf("%s(%s): bad action = %O",
					me->name(1), me->query("id"), me->query("actions", 1)));
			return 0;
		}
	}
	if( objectp(weapon) ) {
		me->set("actions", WEAPON_D->query_action( weapon ) );

		if( (int)weapon->query("broken") ) {
			tell_object(me, HIM "\n" + weapon->query("name") + "已經損壞或故障了 !\n\n" NOR );
			weapon->unequip();
			me->reset_action();
		}

		action = me->query("actions");
	}

	if( functionp(action["pre_action"]) )
		evaluate( action["pre_action"], me, victim, weapon, damage);

        result = "\n" + action["action"] + " !\n";

//
// (2) Prepare AP, DP for checking if hit.
//
//     AP = attack point, DP = defense point.
//
	if( objectp(weapon) ) {
		attack_skill =	weapon->query("skill_type");
		damage_type  =	weapon->query("damage_type");
	} else {
		attack_skill = "unarmed";
		damage_type  = "traditional";
	}

	level_bonus = victim->query("level") * victim->query("level") 
		- me->query("level") * me->query("level");
	if( level_bonus < 0 ) level_bonus = 0;

	if( attack_type == TYPE_DRIVER || attack_type == TYPE_VEHICLE ) {
        	limb_number = random( sizeof( victim->query("armors")));
		limbs_c = victim->query("armors");
	} else {
        	limb_number = random( sizeof( victim->query("limbs")));
		limbs_c = victim->query("limbs");
	}
	ap = me->query("basic_ap") + me->query_temp("apply/ap")
               	+ skill_power(me, attack_skill, SKILL_USAGE_ATTACK)
               	* skill_power(me, attack_skill, SKILL_USAGE_ATTACK);
        if( ap < 1 ) ap = 1;
	if( attack_type == TYPE_DRIVER ) {
        	dp = victim->query("basic_dp")
                	+ skill_power( your_driver, victim->query("skill_type"), SKILL_USAGE_DEFENSE )
	                + skill_power( your_driver, attack_skill, SKILL_USAGE_DEFENSE )
	                * skill_power( your_driver, attack_skill, SKILL_USAGE_DEFENSE );
		if( !living( your_driver ) || your_driver->query_temp("tired") 
			|| your_driver->query("position") == "sleep" ) 
			dp = 1;
		if( victim->query("fuel") <= 0 ) dp = 1; 
	} else {
		dp = victim->query("basic_dp") + victim->query_temp("apply/dp")
        	        + skill_power(victim, "dodge", SKILL_USAGE_DEFENSE)
	                + skill_power(victim, attack_skill, SKILL_USAGE_DEFENSE)
	                * skill_power(victim, attack_skill, SKILL_USAGE_DEFENSE);

		if( victim->is_busy() ) dp /= 3;
		if( victim->query("position") == "rest" ) dp /= 2;
		if( victim->query_temp("tired") ) dp = 1;
		if( victim->query("position") == "sleep" ) dp = 1;
		if( !living( victim)) dp = 1;
	}
	        if( dp < 1 ) dp = 1;

//
// (3) Fight!
//     Give us a chance of AP/(AP+DP) to "hit" our opponent. Since both
//     AP and DP are greater than zero, so we always have chance to hit
//     or be hit.
//

// To all environment objects if wants to join combat.
// The detail function of help_npc should written in NPC's own.

	 all_inventory( environment( victim ))->help_combat( me, victim );

// Does the victim dodge this hit?

        if( random( ap + dp ) < dp ) {

		if( attack_type == TYPE_DRIVER || attack_type == TYPE_VEHICLE ) {
			dodge_skill = victim->query("skill_type");
			result += victim->query_dodge_msg(limbs_c[limb_number]);
		} else {
			dodge_skill = "dodge";
			result += SKILL_D(dodge_skill)->query_dodge_msg(limbs_c[limb_number]);
		}

//  Add combat_exp & improve skill.

		if( attack_type == TYPE_DRIVER ) {
			exp = random( your_driver->query("int") + 1 + level_bonus);
			your_driver->add("combat_exp", exp / 2 );
			your_driver->improve_skill( dodge_skill, exp );
		} else if( !attack_type == TYPE_VEHICLE ) {
			exp = random( victim->query("int") + 1 + level_bonus);
			victim->add("combat_exp", exp / 2 );
                	victim->improve_skill("dodge", exp);
		}

// All have chance to get exp when failed to hit.

                if( random( ap + dp) > dp ) {
			exp = random( me->query("int") + 1 + level_bonus);
			me->add("combat_exp", exp / 2 );
       	        	        me->improve_skill( attack_skill, exp);
		}
		damage = RESULT_DODGE;
		victim->time_unit_loss( 10 - victim->query("dex") / 5);

	} else {

//
//      (4) Check if the victim can parry this attack.
//
//	Now only the victim who have wore a shield have chance to parry.
//
//	Vehicle doesn't parry a attack.

		if( !victim->is_vehicle() && objectp( victim->query_temp("armor/shield") ) ) {
		        pp = skill_power( victim, "parry", SKILL_USAGE_DEFENSE)
				+ skill_power( victim, attack_skill, SKILL_USAGE_DEFENSE)
				+ victim->query_temp("apply/pp")
				+ dp;
	
			if( victim->is_busy() ) pp /= 3;
			if( victim->query("position") == "rest" ) pp /= 2;
			if( victim->query_temp("tired") ) pp = 1;
			if( victim->query("position") == "sleep" ) pp = 1;
			if( pp < 1 ) pp = 1;
			if( !living( victim)) pp = 1;

			parry_skill = "parry";

		}
		if( pp != 0 && ( random( ap + dp ) < dp * pp / 100 ) ) {

// change to SKILL_D(parry_skill) after added parry msg to those
// martial arts that can parry.

			result += SKILL_D("parry")->query_parry_msg(weapon);

			if( dp < ap && (!userp(victim) || !userp(me))) { 
				exp = random( victim->query("int") + 1 + level_bonus);

				victim->add("combat_exp", exp / 2 );
				victim->improve_skill("parry", exp);
			}

// Checking shield durability.

			if ( (objectp(weapon) )) {
				for ( j = 1; j <= me->query_temp("apply/dice_number"); j++) {
					damage += random(
						me->query_temp("apply/dice_roll")) + 1;
					if( action["damage"] )
						damage += action["damage"];

					damage_bonus = me->query_temp(
						"apply/damage_bonus")
						+ skill_power (me, attack_skill, SKILL_USAGE_ATTACK);
					damage += damage_bonus;
				}
			} else {
				for ( j = 1; j <= me->query("dice_number"); j++) {
					damage += random(
						me->query("dice_roll")) + 1;
					if( action["damage"] )
						damage += action["damage"];

					damage_bonus = me->query(
						"damage_bonus")
						+ skill_power (me, attack_skill, SKILL_USAGE_ATTACK);
					damage += damage_bonus;
				}
			}

			( victim->query_temp("armor/shield") )->add("durability", -damage );

			if( wizardp( me ) && me->query("env/combat") )
				tell_object( me, sprintf( GRN + "shield durability: %d\n", -damage ) );
			if( wizardp( victim ) && victim->query("env/combat") )
				tell_object( victim, sprintf( GRN "shield durability: %d", -damage ) );

			check_equip_broken( victim, victim->query_temp("armor/shield") );

			damage = RESULT_PARRY;
			victim->time_unit_loss( 6 - victim->query("dex") );
		} else {

//
//      (5) We hit the victim and the victim failed to parry
//
			if ( (objectp(weapon) )) {
				for ( j = 1; j <= me->query_temp("apply/dice_number"); j++) {
					damage += random(
						me->query_temp("apply/dice_roll")) + 1;
					if( action["damage"] )
						damage += action["damage"];

					damage_bonus = me->query_temp(
						"apply/damage_bonus")
						+ skill_power (me, attack_skill, SKILL_USAGE_ATTACK);
					damage += damage_bonus;
				}
			} else {
				for ( j = 1; j <= me->query("dice_number"); j++) {
					damage += random(
						me->query("dice_roll")) + 1;
					if( action["damage"] )
						damage += action["damage"];

					damage_bonus = me->query(
						"damage_bonus")
						+ skill_power (me, attack_skill, SKILL_USAGE_ATTACK);
					damage += damage_bonus;
				}
			}
			if( wizardp( me ) && (string)me->query("env/combat") ) {
	                	tell_object( me, 
				sprintf( GRN "initial damage: %d\n" NOR,
					damage, ) );
			}
			if( wizardp( victim ) && (string)victim->query("env/combat") ) {
	                	tell_object( victim, 
				sprintf( GRN "initial damage: %d\n" NOR,
					damage, ) );
			}

			if( damage <= 0 )
				damage = 0;
			else
                	       	damage = damage * damage / 
					( damage + (int)victim->query_temp( sprintf("protect/%s/%d", damage_type, limb_number ) ) );

			if( arrayp( victim->query_temp( sprintf("limb_armors/%d", limb_number ) ) ) 
				&& victim->query_temp( sprintf("limb_armors/%d", limb_number ) ) != ({ }) ) {

				j = random( sizeof( victim->query_temp( sprintf("limb_armors/%d", limb_number ) ) ) );
				( victim->query_temp( sprintf("limb_armors/%d", limb_number ) ) )[j]->add("durability", - ( damage - ( victim->query_temp( sprintf("limb_armors/%d", limb_number ) ) )[j]->query("armor_prop/" + damage_type + "_armor") ) );

				if( wizardp( me ) && me->query("env/combat") )
					tell_object( me, GRN + sprintf("armor %s durability: %d" + NOR,
						victim->query_temp( sprintf("limb_armors/%d", limb_number ) )[j]->name(),
						- ( damage - ( victim->query_temp( sprintf("limb_armors/%d", limb_number ) ) )[j]->query("armor_prop/" + damage_type + "_armor") ) ) );
				if( wizardp( victim ) && victim->query("env/combat") )
					tell_object( victim, GRN + sprintf("armor %s durability: %d" + NOR, 
						victim->query_temp( sprintf("limb_armors/%d", limb_number ) )[j]->name(),
						- ( damage - ( victim->query_temp( sprintf("limb_armors/%d", limb_number ) ) )[j]->query("armor_prop/" + damage_type + "_armor") ) ) );

				check_equip_broken( victim, victim->query_temp( sprintf("limb_armors/%d", limb_number ) )[j] );
			}

			if( attack_type != TYPE_DRIVER && attack_type != TYPE_VEHICLE ) {
				if( damage > 0 && victim->query("position") == "sleep" ) {
					tell_object( victim, "你被敵人偷襲了 !\n" );
					victim->set("position", "stand");
					victim->time_unit_loss( 50 - victim->query("not") );
				}
			}
			else if( attack_type == TYPE_DRIVER ) {
				if( damage > 0 && your_driver->query("position") == "sleep" ) {
					tell_object( victim, "載具被敵人偷襲了 !\n" );
					your_driver->set("position", "rest");
					your_driver->time_unit_loss( 50 - your_driver->query("not") );
				}
			}
//
//      (6) Inflict the damage.
//
// The vehicle doesn't have wounded status, so we give damage to armor.

			if( victim->is_vehicle() ) {
       		                damage = victim->armor_damage( limb_number, damage, me);
				if( objectp( weapon ) && damage_type == "traditional" )
					weapon->add("durability", - damage );
			} else {
	                        damage = victim->limb_damage( limb_number, damage, me);
				if( objectp( weapon ) && damage_type == "traditional" )
					weapon->add("durability", - damage );

// We are sure that damage is greater than victim's armor here.

				if( damage > (int)victim->query_temp( sprintf("protect/%s/%d", damage_type, limb_number ) ) ) {
       	        	                victim->limb_wound( limb_number,
	               	                        damage - (int)victim->query_temp( sprintf("protect/%s/%d", damage_type, limb_number ) ), me);
					wounded = 1;

					if( objectp( weapon ) && damage_type == "traditional" )
						weapon->add("durability", - ( (int)victim->query_temp("apply/" + damage_type + "_armor" ) ) );
					
				}
			}

// Checking weapon durability.

			if( objectp( weapon ) && damage_type == "traditional" )
				check_equip_broken( me, weapon );
			
			if( victim->is_vehicle() )
				result += v_damage_msg(damage, action["damage_type"]);
			else
				result += damage_msg(damage, action["damage_type"]);

//
//      (7) Give experience
//
			if( attack_type == TYPE_DRIVER && userp( your_driver )) {
				exp = random( your_driver->query("int") + 1 + level_bonus);
				if( your_driver->query("potential") - your_driver->query("learned_points") < 100 )
					your_driver->add("potential", 1 );
					your_driver->add("combat_exp", exp );
					your_driver->improve_skill( attack_skill, exp);
			}
			if( userp(me) || userp(victim) ) {
				exp = random( me->query("int") + 1 + level_bonus);
				if( me->query("potential") - me->query("learned_points") < 100 )
					me->add("combat_exp", exp );
					me->improve_skill( attack_skill, exp);

				exp = random( victim->query("int") + 1 + level_bonus);
				victim->add("combat_exp", exp / 10 );
				victim->improve_skill( attack_skill, exp);
			}
		}
	} 

	result = replace_string( result, "$l", limbs_c[limb_number] );
	if( objectp(weapon) )
		result = replace_string( result, "$w", weapon->name() );
	else if( stringp(action["weapon"]) )
		result = replace_string( result, "$w", action["weapon"] );

	message_vision(result, me, victim );

// See if combat_exps are high enough to raise a combat level.
		if( ( me->query("combat_exp") >= (( me->query("level") + 1) 
			* (me->query("level") + 1) * 100)) 
			&& me->query("level") <= 99 ) 
		{
			me->add("level", 1 );
			me->level_up( me->query("race"));
		}
		if( attack_type == TYPE_DRIVER ) {
			if( ( your_driver->query("combat_exp") >= (( your_driver->query("level") + 1) 
				* ( your_driver->query("level") + 1) * 100)) 
				&& your_driver->query("level") <= 99 ) {

				your_driver->add("level", 1 );
				your_driver->level_up( your_driver->query("race"));
			}
		} else if( (victim->query("combat_exp") >= ((victim->query("level") + 1) 
			* (victim->query("level") + 1) * 100)) 
			&& victim->query("level") <= 99 ) 
		{
			victim->add("level", 1 );
			victim->level_up( victim->query("race"));
		}

	if( wizardp( me ) && (string)me->query("env/combat") ) 
		{
                	tell_object( me, 
			sprintf( GRN "AP: %d, DP: %d, PP: %d, armor: %d, damage: %d\n" NOR,
				ap, dp, pp,
				(int)victim->query_temp( sprintf("protect/%s/%d", damage_type, limb_number ) ),
				damage, ) );
	}
	if( attack_type == TYPE_DRIVER )
		if( wizardp( your_driver ) 
			&& (string)your_driver->query("env/combat") ) 
		{
                	tell_object( your_driver, 
			sprintf( GRN "AP: %d, DP: %d, PP: %d, damage: %d\n" NOR,
				ap, dp, pp, damage));
		}
	if( wizardp( victim ) 
		&& (string)victim->query("env/combat") ) 
	{
                tell_object( victim, 
			sprintf( GRN "AP: %d, DP: %d, PP: %d, armor: %d, damage: %d\n" NOR,
				ap, dp, pp,
				(int)victim->query_temp( sprintf("protect/%s/%d", damage_type, limb_number ) ),
				damage, ) );
	}

        if( damage > 0 ) {
		if( victim->is_vehicle() ) {
        	        message_vision( NOR "( $N " + v_report_status(victim) + ". )\n", victim );
		} else {
	                message_vision( NOR "( $N " + report_status(victim, wounded) + ". )\n", victim );
		}
                if( victim->is_busy() ) 
			victim->interrupt_me(me);
	}

	if( functionp(action["post_action"]) )
		evaluate( action["post_action"], me, victim, weapon, damage);

// See if the victim can make a riposte.
	if( attack_type==TYPE_REGULAR
	&&	damage < 1
        &&      victim->query_temp("guarding") == 1) 
	{
		victim->set_temp("guarding", 0);
                if( random( me->query("not") ) < 10 ) 
		{
			message_vision("$N 攻擊不中, 露出了破綻!\n", me);
			do_attack( victim, me, victim->query_temp("weapon"), TYPE_QUICK);
		} else {
                        message_vision("$N 見 $n 攻擊失誤, 趁機攻擊!\n", victim, me);
			do_attack( victim, me, victim->query_temp("weapon"), TYPE_RIPOSTE);
		}
	}
	status_report( me );
	status_report( victim );

}

//	fight()
//
//	This is called in the attack() defined in F_ATTACK, which handles fighting
//	in the heart_beat() of all livings. Be sure to optimize it carefully.
//
varargs void fight(object me, object victim, int vehicle )
{
	object ob;
	object *inv, your_driver;
	int i, j, distance;
	string msg_me, adv_cmd;
	int fuel_loss;
	int steps;

	if( victim->is_vehicle() && !me->query_temp("weapon") ) {
		tell_object( me, "你想赤手空拳擊毀載具 ? 這樣會骨折的.\n" );
		return;
	}

	if( me->is_character() && !living( me ) ) 
		return;

	if( vehicle ) {
		inv = all_inventory( victim );
		for( j = 0; j < sizeof( inv ); j ++ ) {
			if( inv[j]->query_temp("command") ) {
				your_driver = inv[j];
				break;
			}
		}
	}

	if( !me->visible( victim ) ) {
	        if( ( 25 - random( (int)me->query("not") ) ) 
			< ( (int)me->query("not") / 2 ) )
			return;
	}

	distance = victim->query_temp("location") - me->query_temp("location");
	if( distance < 0 ) distance = - distance;

// Now we add attack range limit and time unit.
// There is no range limitation for vehicle.

if( ( me->query_temp("apply/range") >= distance ) 
	&& ( me->query_time_unit() > 0 ) ) {

// If victim is busy or unconcious, always take the chance to make an attack.
	if( victim->is_busy() || victim->query_time_unit() > 0
		|| ( victim->is_character() && !living( victim ) ) 
		|| victim->query("position") == "sleep" 
		|| victim->query("position") == "rest" 
		|| ( vehicle && victim->query("fuel") <= 0 ) 
		) {
		me->set_temp("guarding", 0);

		if( !victim->is_fighting(me) && !vehicle ) victim->fight_ob(me);
		if( query_temp("weapon") ) {
			me->receive_damage("spi", (50 - me->query("str") - me->query("not") ) / 10, me ); 
			me->receive_damage("mov", (50 - me->query("dex") - me->query("dex") ) / 10, me ); 

			if( me->query("position") == "rest" && !me->query_temp("tired") )
				me->set("position", "stand");

			if( vehicle && your_driver ) {
				your_driver->receive_damage("spi", ( 50 - your_driver->query("not") ) / 10, me ); 
				fuel_loss = 100 - skill_power( your_driver, victim->query("skill_type"), SKILL_USAGE_DEFENSE );
				if( fuel_loss <= 0 ) fuel_loss = 1;
				victim->add("fuel", -fuel_loss ); 
			} else {
				victim->receive_damage("spi", (50 - victim->query("str") - me->query("not") ) / 10, victim ); 
				victim->receive_damage("mov", (50 - victim->query("dex") - me->query("dex") ) / 10, victim ); 
				if( victim->query("position") == "rest" && !victim->query_temp("tired") )
					victim->set("position", "stand");
			}
			for ( i = 1; i <= me->query_temp("apply/round"); i++ ) {
				if( vehicle ) {
					if( your_driver )
						do_attack(me, victim, me->query_temp("weapon"), TYPE_DRIVER);
					else
						do_attack(me, victim, me->query_temp("weapon"), TYPE_VEHICLE);
				}
				else
					do_attack(me, victim, me->query_temp("weapon"), TYPE_QUICK);
			}
		}
		else {
			me->receive_damage("spi", (50 - me->query("str") - me->query("not")) * 2 / 10, me ); 
			me->receive_damage("mov", (50 - me->query("dex") - me->query("dex")) * 2 / 10, me ); 

			if( me->query("position") == "rest" && !me->query_temp("tired") )
				me->set("position", "stand");
			if( vehicle && your_driver ) {
				your_driver->receive_damage("spi", ( 50 - your_driver->query("str") - your_driver->query("not") ) / 10, me ); 
				fuel_loss = 100 - skill_power( your_driver, victim->query("skill_type"), SKILL_USAGE_DEFENSE );
				if( fuel_loss <= 0 ) fuel_loss = 1;
				victim->add("fuel", -fuel_loss ); 
			} else {
				victim->receive_damage("spi", (50 - victim->query("str") - me->query("not")) * 2 / 10, victim ); 
				victim->receive_damage("mov", (50 - victim->query("dex") - me->query("dex")) * 2 / 10, victim ); 
				if( victim->query("position") == "rest" && !victim->query_temp("tired") )
					victim->set("position", "stand");
			}
			for ( i = 1; i <= me->query("round"); i++ ) {
				if( vehicle ) {
					if( your_driver )
						do_attack(me, victim, me->query_temp("weapon"), TYPE_DRIVER);
					else
						do_attack(me, victim, me->query_temp("weapon"), TYPE_VEHICLE);
				}
				else
					do_attack(me, victim, me->query_temp("weapon"), TYPE_QUICK);
			}
		}

// Else, see if we are brave enough to make an aggressive action.
        } else if( ( random( (int)me->query("dex") ) ) 
			> ( random( (int)victim->query("dex") ) ) ) {
		me->set_temp("guarding", 0);
		if( !victim->is_fighting(me) && !vehicle ) victim->fight_ob(me);
		if( query_temp("weapon") ) {
			me->receive_damage("spi", (50 - me->query("str") - me->query("not") ) / 10, me ); 
			me->receive_damage("mov", (50 - me->query("dex") - me->query("dex") ) / 10, me ); 

			if( vehicle && your_driver ) {
				your_driver->receive_damage("spi", ( 50 - your_driver->query("str") - your_driver->query("not") ) / 10, me ); 
				fuel_loss = 100 - skill_power( your_driver, victim->query("skill_type"), SKILL_USAGE_DEFENSE );
				if( fuel_loss <= 0 ) fuel_loss = 1;
				victim->add("fuel", -fuel_loss ); 
			} else {
				victim->receive_damage("spi", (50 - victim->query("str") - me->query("not") ) / 10, victim ); 
				victim->receive_damage("mov", (50 - victim->query("dex") - me->query("dex") ) / 10, victim ); 
			}
			for ( i = 1; i <= me->query_temp("apply/round"); i++) { 
				if( vehicle ) {
					if( your_driver )
						do_attack(me, victim, me->query_temp("weapon"), TYPE_DRIVER);
					else
						do_attack(me, victim, me->query_temp("weapon"), TYPE_VEHICLE);
				}
				else
					do_attack(me, victim, me->query_temp("weapon"), TYPE_REGULAR);
			}
		}
		else {
			me->receive_damage("spi", (50 - me->query("str") - me->query("not")) * 2 / 10, me ); 
			me->receive_damage("mov", (50 - me->query("dex") - me->query("dex")) * 2 / 10, me ); 

			if( vehicle && your_driver ) {
				your_driver->receive_damage("spi", ( 50 - your_driver->query("str") - your_driver->query("not") ) / 10, me ); 
				fuel_loss = 100 - skill_power( your_driver, victim->query("skill_type"), SKILL_USAGE_DEFENSE );
				if( fuel_loss <= 0 ) fuel_loss = 1;
				victim->add("fuel", -fuel_loss ); 
			} else {
				victim->receive_damage("spi", (50 - victim->query("str") - me->query("not")) * 2 / 10, victim ); 
				victim->receive_damage("mov", (50 - victim->query("dex") - me->query("dex")) * 2 / 10, victim ); 
			}
			for ( i = 1; i <= me->query("round"); i++ ) { 
				if( vehicle ) {
					if( your_driver )
						do_attack(me, victim, me->query_temp("weapon"), TYPE_DRIVER);
					else
						do_attack(me, victim, me->query_temp("weapon"), TYPE_VEHICLE);
				}
				else
					do_attack(me, victim, me->query_temp("weapon"), TYPE_REGULAR);
			}
		}

// Else, we just start guarding.
	} else if( !me->query_temp("guarding") ) {
		if( me->is_character() ) {
			if( me->query("position") == "sleep" )
				return;
		}
		me->set_temp("guarding", 1);

		message_vision( guard_msg[random(sizeof(guard_msg))], me, victim);

		return;
	} else return;
} else {
	if( me->query_temp("apply/range") < distance ) {
		if( !me->query_temp("pending/fight_msg") && userp( me)) {
			msg_me ="$N 與 $n 不在攻擊範圍內 !!\n";
			message_vision( msg_me, me, victim );
			me->set_temp("pending/fight_msg", 1 );
		}
		steps = me->query("dex");
		if( steps > distance - me->query_temp("apply/range") )
			steps = distance - me->query_temp("apply/range");
		call_out( "advance", 1, me, victim, steps );
	}
	return;
}
}

//	auto_fight()
//
//	This function is to start an automatically fight. Currently this is
//	used in "aggressive", "vendetta", "hatred", "berserk" fight.
//
void auto_fight(object me, object obj, string type)
{
// Now we let NPC autofight NPC, grin evily...

//	if( !userp(me) && !userp(obj) ) return;

// Because most of the cases that we cannot start a fight cannot be checked
// before we really call the kill_ob(), so we just make sure we have no 
// aggressive callout wating here.
	if( me->query_temp("looking_for_trouble") ) return;
	me->set_temp("looking_for_trouble", 1);

// This call_out gives victim a chance to slip trough the fierce guys.
	call_out( "start_" + type, 0, me, obj);
}

void start_hatred(object me, object obj)
{
// Are we still exist( not becoming a corpse )?	
	if( !me || !obj ) return;				

	me->set_temp("looking_for_trouble", 0);

	if(	me->is_fighting(obj)			// Are we busy fighting?
	||	!living(me)				// Are we capable for a fight?
	||	environment(me)!=environment(obj)	// Are we still in the same room?
	||	environment(me)->query("no_fight") 	// Are we in a peace room?
	)	return;

// We found our hatred! Charge!
	if( me->query("can_speak"))
		message_vision( catch_hunt_msg[random(sizeof(catch_hunt_msg))], 
			me, obj);
	me->kill_ob(obj);
}

void start_vendetta(object me, object obj)
{
	if( !me || !obj ) return;				// Are we still exist( not becoming a corpse )?

	me->set_temp("looking_for_trouble", 0);

	if(	me->is_fighting(obj)				// Are we busy fighting?
	||	!living(me)							// Are we capable for a fight?
	||	environment(me)!=environment(obj)	// Are we still in the same room?
	||	environment(me)->query("no_fight") 	// Are we in a peace room?
	)	return;

	// We found our vendetta opponent! Charge!
	me->kill_ob(obj);
}

void start_aggressive(object me, object obj)
{
	if( !me || !obj ) return;				// Are we still exist( not becoming a corpse )?

	me->set_temp("looking_for_trouble", 0);

	if(	me->is_fighting(obj)				// Are we busy fighting?
	||	!living(me)							// Are we capable for a fight?
	||	environment(me)!=environment(obj)	// Are we still in the same room?
	||	environment(me)->query("no_fight") 	// Are we in a peace room?
	)	return;

// We got a nice victim! Charge !!
	me->kill_ob(obj);
}

// This function is to announce the special events of the combat.
// This should be moved to another daemon in the future.

void announce(object ob, string event)
{
	switch(event) {
		case "dead":
                        message_vision("\n$N 被殺死了.\n", ob);
			break;
		case "unconcious":
                        message_vision("\n$N 昏倒在地上一動也不動了.\n", ob);
			break;
		case "revive":
                        message_vision("\n$N 慢慢睜開眼睛, 清醒了過來.\n", ob);
			break;
		case "tired":
			message_vision("\n$N 身心俱疲, 腳下一個不穩坐倒在地上.\n", ob);
			break;
		case "refresh":
			message_vision("\n$N 恢復了力氣, 緩緩地從地上爬起來.\n", ob);
			break;
	}
}

void winner_reward(object killer, object victim)
{
	killer->defeated_enemy(victim);
}

void killer_reward(object killer, object victim)
{
	int i;
	string vmark, *group;

// Call the mudlib killer apply.
	killer->killed_enemy(victim);
	group = victim->query("group");

	if( userp(victim) ) {
		killer->set("killer", 1);
		killer->add("PKS", 1);
		killer->add("HKS", 1);
		killer->add( "positive_fame", victim->query("negative_fame") );
		killer->add( "negative_fame", victim->query("positive_fame") );
		if( group ) {
			for( i = 0; i < sizeof( group ); i++ ) {
				killer->add( "kill/" + group[i], 1 );
			}
		}
		victim->clear_condition();

// Give the death penalty to the dying user.

		victim->delete("vendetta");
		victim->delete("thief");
		victim->delete("killer");
		if( (int)victim->query("potential") > (int)victim->query("learned_points"))
			victim->add("potential",
				((int)victim->query("learned_points") - (int)victim->query("potential"))/2 );
//		victim->skill_death_penalty();

		CHANNEL_D->do_channel(this_object(), "rumor",
			sprintf("%s" MAG " 被 " MAG "%s " MAG "殺死了." NOR, victim->name(1), killer->name(1)));
	} else {
		if( victim->query("race")=="人類") {
			killer->add("HKS", 1);
			killer->set("killer", 1 );
		}
		killer->add("MKS", 1);
		killer->add( "positive_fame", victim->query("negative_fame") );
		killer->add( "negative_fame", victim->query("positive_fame") );
		if( group ) {
			for( i = 0; i < sizeof( group ); i++ ) {
				killer->add( "kill/" + group[i], 1 );
			}
		}
	}

	if( stringp(vmark = victim->query("vendetta_mark")) )
		killer->add("vendetta/" + vmark, 1);
}

int advance( object me, object target, int steps )
{
	string msg;
	int distance, loc_me, loc_target, mov_damage;

	loc_me = me->query_temp("location");
	loc_target = target->query_temp("location");
	distance = loc_target - loc_me;

	if( distance > 0 ) { 
		loc_me += steps;
		if( loc_target - loc_me < 0 )
			loc_me = loc_target;
	}
	else if( distance < 0 ) { 
		loc_me -= steps;
		if( loc_target - loc_me > 0 )
			loc_me = loc_target;
	}
	else if( distance == 0 ) {
		message("vision", "你已經與目標近得不能再近了.\n", me);
		return 1;
	}
	distance = loc_target - loc_me;
	if( distance < 0 ) distance = - distance;
	me->set_temp("location", loc_me);

	msg = "$N 與 $n 的距離走近了一些. ( 距離: " + distance +" )\n";
	message_vision( msg, me, target );

	mov_damage = 1 + me->query_encumbrance() * 10 / me->query_max_encumbrance()
		- me->query("str") / 5;
	if( mov_damage <= 0 ) mov_damage = 0;
	me->receive_damage( "mov", mov_damage );
	me->time_unit_loss( mov_damage - me->query("dex") / 5 );

	return 1;
}

int back( object me, object target, int steps )
{
	string msg;
	int distance, loc_me, loc_target, max_dis, mov_damage;
	int mov_cost;

	if( !( mov_cost = environment( me )->query("mov_cost") ) )
		mov_cost = 10;
	loc_me = me->query_temp("location");
	loc_target = target->query_temp("location");
	distance = loc_target - loc_me;
	if( distance > 0 ) max_dis = loc_target;
	else max_dis = mov_cost - loc_target;
	if( distance == max_dis || - distance == max_dis ) {
		message("vision","你與目標的距離已經遠得不能再遠了.\n", me);
		return 1;
	}

	if( distance > 0 ) {
		loc_me -= steps;
		if( loc_me < 0 ) {
			loc_me = 0;
			if( loc_target - loc_me < steps )
				loc_me = steps;
		}
	} else if( distance < 0 ) {
		loc_me += steps;
		if( loc_me > mov_cost ) {
			loc_me = mov_cost;
			if( loc_me - loc_target < steps )
				loc_me = mov_cost - steps;
		}
	} else {
		if( loc_me == 0 ) loc_me += steps;
		else if( loc_me == mov_cost ) loc_me -= steps; 
		else if( loc_me <= mov_cost / 2 ) loc_me += steps;
		else if( loc_me > mov_cost / 2 ) loc_me -= steps;
		if( loc_me > mov_cost ) loc_me = mov_cost;
		else if( loc_me < 0 ) loc_me = 0;
	}
	me->set_temp("location", loc_me);
	distance = loc_target - loc_me;
	if( distance < 0 ) distance = - distance;

	msg = "$N 與 $n 的距離走遠了一些. ( 距離: " + distance + " )\n";
	message_vision( msg, me, target );

	mov_damage = 1 + me->query_encumbrance() * 10 / me->query_max_encumbrance()
		- me->query("str") / 5;
	if( mov_damage <= 0 ) mov_damage = 0;
	me->receive_damage( "mov", mov_damage );
	me->time_unit_loss( mov_damage - me->query("dex") / 5 );

	return 1;
}

int check_equip_broken( object me, object equip )
{
	if( equip->query("durability") < 1 ) {
		equip->set("broken", 1 );
		message_vision(HIM "只聽見「鏘」地一聲, $N的" + equip->name()
			+ "已經損壞得無法使用 !\n" NOR, me );
		equip->unequip();
		equip->set("name", "損壞的" + equip->query("name"));
		equip->set("value", (int)equip->query("value") / 100 );
			
		me->reset_action();

		return 1;
	}
	return 0;
}

void status_report( object me )
{
	string prompt;
	int spi, mov;
	int *limbs_eff_hit, *limbs_max_hit;
	int i, limb_flag = 0;
	string *limbs;
 
	prompt = NOR "[ ";
 
	prompt += sprintf( GRN "時間" NOR " %d ", me->query_time_unit() );
 	spi = me->query("spi") * 100 / me->query("max_spi");
	prompt += sprintf(YEL "精神 " NOR "%d%% ", spi );
 
	mov = me->query("mov") * 100 / me->query("max_mov");
	prompt += sprintf(HIB "移動 " NOR "%d%% ", mov );
 
	if( me->query("water") < 1 )
		prompt += CYN "口渴 ";
 
	if( me->query("food") < 1 )
		prompt += MAG "飢餓 ";
 
	limbs_eff_hit = me->query("limbs_eff_hit");
	limbs_max_hit = me->query("limbs_max_hit");
	limbs = me->query("limbs");
 
	for( i = 0; i < sizeof( limbs_max_hit ); i++ ) {
		if( limbs_eff_hit[i] * 100 / limbs_max_hit[i] < 30 ) {
			prompt += HIR + limbs[i] + " ";
			limb_flag = 1;
		}
	}
 
	if( limb_flag == 1 ) prompt += "重傷";
 
	prompt += NOR "] ";

	tell_object( me, prompt );

	return;
}
