// human.c

// A normal human is at least 20 kg weight
#define BASE_WEIGHT 20000

inherit F_DBASE;

mapping query_action();

void setup_human(object ob);
void level_up_human(object ob);
mapping query_action();

mapping *combat_action = ({
        ([      "action":               "$N 忽然，狂声大笑，纵身跃起，向$n 发出决灭的攻击，猛听“啪！”的一声爆响，$n 被轰得血花四溅，撞地后反弹起，双手抑头，痛的怪叫。\n",
		"damage_type":	"瘀伤",
	]),
        ([      "action":               "$N 的十指幻变出紫色光芒往 $n 的 $l 一抓，$n 惨被击中，\n$N 的指劲在体内乱窜冲击，顿时感到周身气劲鼓涨欲爆，痛彻心脾！\n",
		"damage_type":	"抓伤",
	]),
        ([      "action":               "$N 腾空而起，身体在空中不断旋转，形成一股旋风袭向 $n 的 $l ，\n$n 眼冒金星，人欲昏倒，勉强能够抵御住$N 的正面进攻。\n",
		"damage_type":	"瘀伤",
	]),
        ([      "action":               "$N 掌中爆起一团光影向 $n 的 $l 射去，$n 感到如锥刺体，痛彻心脾，心下慌乱，痛苦的“喔！”地叫出声来。\n",
		"damage_type":	"瘀伤",
	]),
        ([      "action":               "$N 运劲对 $n 的 $l 挥出了一拳，$n 顿觉天地倒转，双目金星乱迸，不由$l 一颤，全身劲气立即烟消云散。\n",
		"damage_type":	"瘀伤",
	]),
});

void create()
{
	seteuid(getuid());
	set("unit", "︗");
	if( undefinedp( query("race") ) )
		set("gender", "男性");
	if( undefinedp( query("can_speak") ) )
		set("can_speak", 1);
	if( undefinedp( query("attitude") ) )
		set("attitude", "peaceful");
	set("limbs", ({ "头部",	"身体",	"左手",	"右手", "左脚",	"右脚" }) );
	set("limb_cns", ({ 0, }) );
	set("limb_trunk", ({ 1 }) );
	set("limb_primary_weapon", ({ 2 }) );
	set("limb_secondary_weapon", ({ 3 }) );
	set("limb_movement", ({ 4, 5 }) );
}

void setup_human(object ob)
{
	mapping my;

	my = ob->query_entire_dbase();

	ob->set("default_actions", query_action() );
	
        if( undefinedp( my["age"])) my["age"] = random(30) + 15;
        if( undefinedp( my["level"])) my["level"] = 1;
        if( undefinedp( my["combat_exp"])) my["combat_exp"] = my["level"] * my["level"] * 100;
        if( undefinedp( my["score"])) my["score"] = random( my["level"]);

	if( my["str"] > 25 ) my["str"] = 25;
	if( my["not"] > 25 ) my["not"] = 25;
	if( my["int"] > 25 ) my["int"] = 25;
	if( my["dex"] > 25 ) my["dex"] = 25;
	if( my["con"] > 25 ) my["con"] = 25;
	if( my["tec"] > 25 ) my["tec"] = 25;
        if( undefinedp(my["str"]) ) 
		my["str"] = to_int( to_float( random(10) + 1) * sin( to_float( random( 31416) + 1) / 10000)) + 5;
        if( undefinedp(my["not"]) ) 
		my["not"] = to_int( to_float( random(14) + 1) * sin( to_float( random( 31416) + 1) / 10000)) + 4;
        if( undefinedp(my["int"]) ) 
		my["int"] = to_int( to_float( random(18) + 1) * sin( to_float( random( 31416) + 1) / 10000)) + 5;
        if( undefinedp(my["dex"]) ) 
		my["dex"] = to_int( to_float( random(13) + 1) * sin( to_float( random( 31416) + 1) / 10000)) + 6;
        if( undefinedp(my["con"]) ) 
		my["con"] = to_int( to_float( random(10) + 1) * sin( to_float( random( 31416) + 1) / 10000)) + 7;
        if( undefinedp(my["tec"]) ) 
		my["tec"] = to_int( to_float( random(20) + 1) * sin( to_float( random( 31416) + 1) / 10000)) + 2;

        if( undefinedp(my["basic_dp"]) ) my["basic_dp"] = 50 + (my["dex"]-15)* 10/ 2;
        if( undefinedp(my["basic_ap"]) ) my["basic_ap"] = 50 + (my["dex"]-15)* 10/ 2;
	if( undefinedp(my["round"]) ) my["round"] = 1;
	if( undefinedp(my["dice_number"]) ) my["dice_number"] = 1;
	if( undefinedp(my["dice_roll"]) ) my["dice_roll"] = 5;
	if( undefinedp(my["damage_bonus"]) ) 
		my["damage_bonus"] = ( my["str"] - 10 );
	if( undefinedp(my["range"]) ) my["range"] = 0;
	if( undefinedp(my["time_unit"]) ) my["time_unit"] = my["dex"] + my["level"] / 5;
	if( undefinedp(my["position"]) ) my["position"] = "stand";

	if( my["age"] < 40 && undefinedp( my["max_spi"] ) ){
	        my["max_spi"] = my["int"] * 4 + my ["not"] * 4
			+ ( my["level"] + my["age"] ) * ( my["int"] + my["not"] ) / 5;

		if( my["max_spi"] < my["int"] + my["not"] )
			my["max_spi"] = my["int"] + my["not"];

	} else if( undefinedp( my["max_spi"] ) ) {
                my["max_spi"] = my["int"] * 4 + my ["not"] * 4
		+ ( my["level"] - my["age"] + 40 ) * ( my["int"] + my["not"] ) / 5;

		if( my["max_spi"] < my["int"] + my["not"] )
			my["max_spi"] = my["int"] + my["not"];
	}

	if( my["age"] < 35 ) {
	if( undefinedp( my["limbs_max_hit"] ) )
                my["limbs_max_hit"] = ({
		my["con"] + my["not"] + ( my["level"] + my["age"] ) * (my["con"] + my["not"]) / 10,
		my["con"]* 2 + ( my["level"] + my["age"]) * my["con"] / 5,
                my["con"] + my["str"] + ( my["level"] + my["age"] ) * (my["con"] + my["str"]) / 10,
		my["con"] + my["str"] + ( my["level"] + my["age"] ) * (my["con"] + my["str"]) / 10,
                my["con"] + my["dex"] + ( my["level"] + my["age"] ) * (my["con"] + my["dex"]) / 10,
		my["con"] + my["dex"] + ( my["level"] + my["age"] ) * (my["con"] + my["dex"]) / 10});

		if( my["limbs_max_hit"][0] < my["con"] + my["not"] )
			my["limbs_max_hit"][0] = my["con"] + my["not"];
		if( my["limbs_max_hit"][1] < my["con"] + my["con"] )
			my["limbs_max_hit"][1] = my["con"] + my["con"];
		if( my["limbs_max_hit"][2] < my["con"] + my ["str"] ) {
			my["limbs_max_hit"][2] = my["con"] + my["str"];
			my["limbs_max_hit"][3] = my["con"] + my["str"];
		}
		if( my["limbs_max_hit"][4] < my["con"] + my["dex"] ) {
			my["limbs_max_hit"][4] = my["con"] + my["dex"];
			my["limbs_max_hit"][5] = my["con"] + my["dex"];
		}

	if( undefinedp( my["limbs_eff_hit"] ) )
                my["limbs_eff_hit"] = ({
		my["con"] + my["not"] + ( my["level"] + my["age"] ) * (my["con"] + my["not"]) / 10,
		my["con"] * 2 + ( my["level"] + my["age"] ) * my["con"] / 5,
                my["con"] + my["str"] + ( my["level"] + my["age"] ) * (my["con"] + my["str"]) / 10,
		my["con"] + my["str"] + ( my["level"] + my["age"] ) * (my["con"] + my["str"]) / 10,
                my["con"] + my["dex"] + ( my["level"] + my["age"] ) * (my["con"] + my["dex"]) / 10,
		my["con"] + my["dex"] + ( my["level"] + my["age"] ) * (my["con"] + my["dex"]) / 10});

		if( my["limbs_eff_hit"][0] < my["con"] + my["not"] )
			my["limbs_eff_hit"][0] = my["con"] + my["not"];
		if( my["limbs_eff_hit"][1] < my["con"] + my["con"] )
			my["limbs_eff_hit"][1] = my["con"] + my["con"];
		if( my["limbs_eff_hit"][2] < my["con"] + my ["str"] ) {
			my["limbs_eff_hit"][2] = my["con"] + my["str"];
			my["limbs_eff_hit"][3] = my["con"] + my["str"];
		}
		if( my["limbs_eff_hit"][4] < my["con"] + my["dex"] ) {
			my["limbs_eff_hit"][4] = my["con"] + my["dex"];
			my["limbs_eff_hit"][5] = my["con"] + my["dex"];
		}

	if( undefinedp( my["limbs_hit"] ) )
                my["limbs_hit"] = ({
		my["con"] + my["not"] + ( my["level"] + my["age"] ) * (my["con"] + my["not"]) / 10,
		my["con"]* 2 + ( my["level"] + my["age"] ) * my["con"] / 5,
                my["con"] + my["str"] + ( my["level"] + my["age"] ) * (my["con"] + my["str"]) / 10,
		my["con"] + my["str"] + ( my["level"] + my["age"] ) * (my["con"] + my["str"]) / 10,
                my["con"] + my["dex"] + ( my["level"] + my["age"] ) * (my["con"] + my["dex"]) / 10,
		my["con"] + my["dex"] + ( my["level"] + my["age"] ) * (my["con"] + my["dex"]) / 10});

		if( my["limbs_hit"][0] < my["con"] + my["not"] )
			my["limbs_hit"][0] = my["con"] + my["not"];
		if( my["limbs_hit"][1] < my["con"] + my["con"] )
			my["limbs_hit"][1] = my["con"] + my["con"];
		if( my["limbs_hit"][2] < my["con"] + my ["str"] ) {
			my["limbs_hit"][2] = my["con"] + my["str"];
			my["limbs_hit"][3] = my["con"] + my["str"];
		}
		if( my["limbs_hit"][4] < my["con"] + my["dex"] ) {
			my["limbs_hit"][4] = my["con"] + my["dex"];
			my["limbs_hit"][5] = my["con"] + my["dex"];
		}
	} else {
	if( undefinedp( my["limbs_max_hit"] ) )
                my["limbs_max_hit"] = ({
		my["con"] + my["not"] + ( my["level"] - my["age"] + 35 ) * (my["con"] + my["not"]) / 10,
		my["con"]* 2 + ( my["level"] - my["age"] + 35 ) * my["con"] / 5,
                my["con"] + my["str"] + ( my["level"] - my["age"] + 35 ) * (my["con"] + my["str"]) / 10,
		my["con"] + my["str"] + ( my["level"] - my["age"] + 35 ) * (my["con"] + my["str"]) / 10,
                my["con"] + my["dex"] + ( my["level"] - my["age"] + 35 ) * (my["con"] + my["dex"]) / 10,
		my["con"] + my["dex"] + ( my["level"] - my["age"] + 35 ) * (my["con"] + my["dex"]) / 10});

		if( my["limbs_max_hit"][0] < my["con"] + my["not"] )
			my["limbs_max_hit"][0] = my["con"] + my["not"];
		if( my["limbs_max_hit"][1] < my["con"] + my["con"] )
			my["limbs_max_hit"][1] = my["con"] + my["con"];
		if( my["limbs_max_hit"][2] < my["con"] + my ["str"] ) {
			my["limbs_max_hit"][2] = my["con"] + my["str"];
			my["limbs_max_hit"][3] = my["con"] + my["str"];
		}
		if( my["limbs_max_hit"][4] < my["con"] + my["dex"] ) {
			my["limbs_max_hit"][4] = my["con"] + my["dex"];
			my["limbs_max_hit"][5] = my["con"] + my["dex"];
		}

	if( undefinedp( my["limbs_eff_hit"] ) )
                my["limbs_eff_hit"] = ({
		my["con"] + my["not"] + ( my["level"] - my["age"] + 35 ) * (my["con"] + my["not"]) / 10,
		my["con"]* 2 + ( my["level"] - my["age"] + 35 ) * my["con"] / 5,
                my["con"] + my["str"] + ( my["level"] - my["age"] + 35 )  * (my["con"] + my["str"]) / 10,
		my["con"] + my["str"] + ( my["level"] - my["age"] + 35 ) * (my["con"] + my["str"]) / 10,
                my["con"] + my["dex"] + ( my["level"] - my["age"] + 35 ) * (my["con"] + my["dex"]) / 10,
		my["con"] + my["dex"] + ( my["level"] - my["age"] + 35 ) * (my["con"] + my["dex"]) / 10});

		if( my["limbs_eff_hit"][0] < my["con"] + my["not"] )
			my["limbs_eff_hit"][0] = my["con"] + my["not"];
		if( my["limbs_eff_hit"][1] < my["con"] + my["con"] )
			my["limbs_eff_hit"][1] = my["con"] + my["con"];
		if( my["limbs_eff_hit"][2] < my["con"] + my ["str"] ) {
			my["limbs_eff_hit"][2] = my["con"] + my["str"];
			my["limbs_eff_hit"][3] = my["con"] + my["str"];
		}
		if( my["limbs_eff_hit"][4] < my["con"] + my["dex"] ) {
			my["limbs_eff_hit"][4] = my["con"] + my["dex"];
			my["limbs_eff_hit"][5] = my["con"] + my["dex"];
		}

	if( undefinedp( my["limbs_hit"] ) )
                my["limbs_hit"] = ({
		my["con"] + my["not"] + ( my["level"] - my["age"] + 35 ) * (my["con"] + my["not"]) / 10,
		my["con"]* 2 + ( my["level"] - my["age"] + 35 ) * my["con"] / 5,
                my["con"] + my["str"] + ( my["level"] - my["age"] + 35 ) * (my["con"] + my["str"]) / 10,
		my["con"] + my["str"] + ( my["level"] - my["age"] + 35 ) * (my["con"] + my["str"]) / 10,
                my["con"] + my["dex"] + ( my["level"] - my["age"] + 35 ) * (my["con"] + my["dex"]) / 10,
		my["con"] + my["dex"] + ( my["level"] - my["age"] + 35 ) * (my["con"] + my["dex"]) / 10});

		if( my["limbs_hit"][0] < my["con"] + my["not"] )
			my["limbs_hit"][0] = my["con"] + my["not"];
		if( my["limbs_hit"][1] < my["con"] + my["con"] )
			my["limbs_hit"][1] = my["con"] + my["con"];
		if( my["limbs_hit"][2] < my["con"] + my ["str"] ) {
			my["limbs_hit"][2] = my["con"] + my["str"];
			my["limbs_hit"][3] = my["con"] + my["str"];
		}
		if( my["limbs_hit"][4] < my["con"] + my["dex"] ) {
			my["limbs_hit"][4] = my["con"] + my["dex"];
			my["limbs_hit"][5] = my["con"] + my["dex"];
		}
	}

	if( my["age"] < 35 && undefinedp( my["max_mov"] ) ) {
                my["max_mov"] = my["dex"]* 5 + my["con"]* 10 
		+ ( my["level"] - my["age"] + 35 ) * (my["con"] + my["dex"]) / 5;

		if( my["max_mov"] < my["dex"] + my["con"] )
			my["max_mov"] = my["dex"] + my["con"];

	} else if( undefinedp( my["max_mov"] ) ) {
                my["max_mov"] = my["dex"]* 5 + my["con"]* 5 
		+ ( my["level"] - my["age"] + 35 ) * (my["con"] + my["dex"]) / 5;

		if( my["max_mov"] < my["dex"] + my["con"] )
			my["max_mov"] = my["dex"] + my["con"];
	}

	if( my["limbs_hit"][0] < my["con"] + my["not"] )
		my["limbs_hit"][0] = my["con"] + my["not"];
	if( my["limbs_hit"][1] < my["con"] + my["con"] )
		my["limbs_hit"][1] = my["con"] + my["con"];
	if( my["limbs_hit"][2] < my["con"] + my ["str"] ) {
		my["limbs_hit"][2] = my["con"] + my["str"];
		my["limbs_hit"][3] = my["con"] + my["str"];
	}
	if( my["limbs_hit"][4] < my["con"] + my["dex"] ) {
		my["limbs_hit"][4] = my["con"] + my["dex"];
		my["limbs_hit"][5] = my["con"] + my["dex"];
	}

	my["time_unit"] = my["dex"] + my["level"] / 5;

	ob->set_default_object(__FILE__);
	if( !ob->query_weight() ) ob->set_weight(BASE_WEIGHT + (my["str"] - 10)* 2000);
}

void level_up_human(object ob)
{
	mapping my;

	my = ob->query_entire_dbase();

	ob->set("default_actions", query_action() );
	
	if( my["age"] < 40 ){
	        my["max_spi"] = my["int"] * 4 + my ["not"] * 4
			+ ( my["level"] + my["age"] ) * ( my["int"] + my["not"] ) / 5;

		if( my["max_spi"] < my["int"] + my["not"] )
			my["max_spi"] = my["int"] + my["not"];

	} else {
                my["max_spi"] = my["int"] * 4 + my ["not"] * 4
		+ ( my["level"] - my["age"] + 40 ) * ( my["int"] + my["not"] ) / 5;

		if( my["max_spi"] < my["int"] + my["not"] )
			my["max_spi"] = my["int"] + my["not"];
	}

	if( my["age"] < 35 ) {
                my["limbs_max_hit"] = ({
		my["con"] + my["not"] + ( my["level"] + my["age"] ) * (my["con"] + my["not"]) / 10,
		my["con"]* 2 + ( my["level"] + my["age"]) * my["con"] / 5,
                my["con"] + my["str"] + ( my["level"] + my["age"] ) * (my["con"] + my["str"]) / 10,
		my["con"] + my["str"] + ( my["level"] + my["age"] ) * (my["con"] + my["str"]) / 10,
                my["con"] + my["dex"] + ( my["level"] + my["age"] ) * (my["con"] + my["dex"]) / 10,
		my["con"] + my["dex"] + ( my["level"] + my["age"] ) * (my["con"] + my["dex"]) / 10});

		if( my["limbs_max_hit"][0] < my["con"] + my["not"] )
			my["limbs_max_hit"][0] = my["con"] + my["not"];
		if( my["limbs_max_hit"][1] < my["con"] + my["con"] )
			my["limbs_max_hit"][1] = my["con"] + my["con"];
		if( my["limbs_max_hit"][2] < my["con"] + my ["str"] ) {
			my["limbs_max_hit"][2] = my["con"] + my["str"];
			my["limbs_max_hit"][3] = my["con"] + my["str"];
		}
		if( my["limbs_max_hit"][4] < my["con"] + my["dex"] ) {
			my["limbs_max_hit"][4] = my["con"] + my["dex"];
			my["limbs_max_hit"][5] = my["con"] + my["dex"];
		}

	} else {
                my["limbs_max_hit"] = ({
		my["con"] + my["not"] + ( my["level"] - my["age"] + 35 ) * (my["con"] + my["not"]) / 10,
		my["con"]* 2 + ( my["level"] - my["age"] + 35 ) * my["con"] / 5,
                my["con"] + my["str"] + ( my["level"] - my["age"] + 35 ) * (my["con"] + my["str"]) / 10,
		my["con"] + my["str"] + ( my["level"] - my["age"] + 35 ) * (my["con"] + my["str"]) / 10,
                my["con"] + my["dex"] + ( my["level"] - my["age"] + 35 ) * (my["con"] + my["dex"]) / 10,
		my["con"] + my["dex"] + ( my["level"] - my["age"] + 35 ) * (my["con"] + my["dex"]) / 10});

		if( my["limbs_max_hit"][0] < my["con"] + my["not"] )
			my["limbs_max_hit"][0] = my["con"] + my["not"];
		if( my["limbs_max_hit"][1] < my["con"] + my["con"] )
			my["limbs_max_hit"][1] = my["con"] + my["con"];
		if( my["limbs_max_hit"][2] < my["con"] + my ["str"] ) {
			my["limbs_max_hit"][2] = my["con"] + my["str"];
			my["limbs_max_hit"][3] = my["con"] + my["str"];
		}
		if( my["limbs_max_hit"][4] < my["con"] + my["dex"] ) {
			my["limbs_max_hit"][4] = my["con"] + my["dex"];
			my["limbs_max_hit"][5] = my["con"] + my["dex"];
		}

	}

	if( my["age"] < 35 ) {
                my["max_mov"] = my["dex"]* 5 + my["con"]* 10 
		+ ( my["level"] - my["age"] + 35 ) * (my["con"] + my["dex"]) / 5;

		if( my["max_mov"] < my["dex"] + my["con"] )
			my["max_mov"] = my["dex"] + my["con"];

	} else {
                my["max_mov"] = my["dex"]* 5 + my["con"]* 5 
		+ ( my["level"] - my["age"] + 35 ) * (my["con"] + my["dex"]) / 5;

		if( my["max_mov"] < my["dex"] + my["con"] )
			my["max_mov"] = my["dex"] + my["con"];
	}

	if( my["limbs_hit"][0] < my["con"] + my["not"] )
		my["limbs_hit"][0] = my["con"] + my["not"];
	if( my["limbs_hit"][1] < my["con"] + my["con"] )
		my["limbs_hit"][1] = my["con"] + my["con"];
	if( my["limbs_hit"][2] < my["con"] + my ["str"] ) {
		my["limbs_hit"][2] = my["con"] + my["str"];
		my["limbs_hit"][3] = my["con"] + my["str"];
	}
	if( my["limbs_hit"][4] < my["con"] + my["dex"] ) {
		my["limbs_hit"][4] = my["con"] + my["dex"];
		my["limbs_hit"][5] = my["con"] + my["dex"];
	}

	my["time_unit"] = my["dex"] + my["level"] / 5;

	ob->set_default_object(__FILE__);
	if( !ob->query_weight() ) ob->set_weight(BASE_WEIGHT + (my["str"] - 10)* 2000);
}

mapping query_action()
{
	return combat_action[random(sizeof(combat_action))];
}
