	秖ボ︐ψ眏㎝脄祇, 秖禫眏, 拟盿珇
	羆秖碞禫蔼ㄏノ↖猌竟拦杆ヒ. 秖
	蔼, 盢肚参矮よм莉眔だ, ㄏノも穒阑┪肚参
	疾阑猌竟驹矮硑Θ端甡.

LONG
    );
    write("叫∕﹚眤妮┦ [块 ? ┪ h 陪ボ弧]: ");
    input_to("get_attributes", ob, user);
    return;
  }

  else if (arg == "dex") {
    write(@LONG
  庇倍 (dex): Dexterity

	庇倍ボ秸ō笆ōも艶庇祘. 庇倍禫
	蔼, 驹矮いю阑㎝ň縨禫纔墩Τ耕蔼丁虫︗. 簿
	笆籔庇倍Τ闽. 庇倍蔼, 盢┮Τ矮よм莉眔
	だ. 

