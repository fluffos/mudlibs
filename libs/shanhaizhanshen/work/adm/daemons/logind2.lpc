string wiz_lev(int lev) {
  if (lev == 5) return "滁畍 (admin)";
  if (lev == 4) return "禠畍 (arch)";
  if (lev == 3) return "把畍 (wizard)";
  if (lev == 2) return "龟策も (apprentice)";
  if (lev == 1) return "ǎ策も (immortal)";
  return RED "-=-=-=-=-=-=-=-=-=-=-=-=-=-=\n\n
" HIW "...硂...ぃ穦 ?!\n
" HIC "瞷ㄏノ硂Τ拜肈, 叫ノ︗絬叫畍腊Γ !\n\n
" RED "-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=\n\n" NOR;
}
