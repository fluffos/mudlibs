      user->set("dex", dex);
      user->set("int", inte);
      user->set("not", not);
      user->set("con", con);
      user->set("tec", tec);
    } else {
      write("╆簆眤块妮┦羆㎝ "
        +sprintf("%d", str + dex + inte + not + con + tec)
        + " , 叫眤秸俱 60.\n");

      write("叫∕﹚眤妮┦ [块 ? ┪ h 陪ボ弧]: ");
      input_to("get_attributes", ob, user);
      return;
    }
  }

  else {
    write("叫∕﹚眤妮┦ [块 ? 陪ボ弧]: ");
    input_to("get_attributes", ob, user);
    return;
  }

  write("眤璶ш簍╧┦(m)à︹┪┦(f)à︹: ");
  input_to("get_gender", ob, user);
}

private void get_gender(string gender, object ob, object user) {
  if (gender == "") {
    write("眤璶ш簍╧┦(m)à︹┪┦(f)à︹? ");
    input_to("get_gender", ob, user);
    return;
  }

  if (gender[0] == 'm' || gender[0] == 'M')
    user->set("gender", "╧┦");
  else if (gender[0] == 'f' || gender[0] == 'F')
    user->set("gender", "┦");
  else {
    write("癸ぃ癬, 眤匡拒╧┦(m)┪┦(f)à︹: ");
    input_to("get_gender", ob, user);
    return;
  }

  log_file("USAGE", sprintf("%s was created from %s (%s)\n", user->query("id"),
    query_ip_name(ob), ctime(time())));

  user->set("newbie/in_school", 1);
  init_new_player(user);
  enter_world(ob, user);
}

object make_body(object ob) {
  string err;
  object user;
  int n;

  // query the variable saved in /data/login/????.o
  user = new(ob->query("body"));
  if (!user) {
    write("瞷Τタэㄏノン祘Α, 礚猭秈︽狡籹.\n");
    write(err + "\n");
    return 0;
  }
  seteuid(ob->query("id"));
  export_uid(user);
  export_uid(ob);
  seteuid(getuid());
  user->set("id", ob->query("id"));
  user->set_name(ob->query("name"), ({ ob->query("id") }));
  return user;
}

private void init_new_player(object user) {
  user->set("title", "キチ");
  user->set("birthday", time());
  user->set("potential", 99);
  user->set("level", 0);
  user->set("combat_exp", 0);
  user->set("race", "摸");

  user->set("channels", ({ "chat", "music", "rumor", "es" }));

  user->set("position", "stand");
}

varargs void enter_world(object ob, object user, int silent) {
  object room, coat, pants, cloak, shoes;
  string startroom;

  user->set_link(ob);
  ob->set_body(user);
  exec(user, ob);

  write("ヘ玡舦: " + wizhood(user) + "\n");
  user->setup();

  // In case of new player, we save them here right aftre setup 
  // compeleted.
  user->save();
  ob->save();

  if (!silent) {
    cat(MOTD);
    if (ob->query("new_mail")) {
      write(GRN + "\nΤ眤獺! 叫秎Ыㄓ诫...\n\n" + NOR);
      ob->set("new_mail", 0);
    }
    if (user->is_ghost())
      startroom = DEATH_ROOM;
    else if (!stringp(startroom = user->query("startroom"))) {
      startroom = START_ROOM;
      if (user->query("newbie/in_school")) {
        coat = new("/obj/coat");
        coat->move(user);
        coat->wear();
        pants = new("/obj/pants");
        pants->move(user);
        pants->wear();
        cloak = new("/obj/cloak");
        cloak->move(user);
        cloak->wear();
        shoes = new("/obj/shoes");
        shoes->move(user);
        shoes->wear();
      }
    }

    if (!catch(load_object(startroom))) {
      if (!user->move(startroom))
        user->move(GUEST_ROOM);
    } else {
      user->move(START_ROOM);
      startroom = START_ROOM;
      user->set("startroom", START_ROOM);
    }
    message_vision("$N 硈絬秈 The Final Frontier.\n", user);
  }
  CHANNEL_D->do_channel(this_object(), "sys",
    sprintf("%s パ %s 硈絬秈.", user->name(), query_ip_name(user)));
  write(HIY "Ω硈絬: " + ob->query("last_from") + " ( " +
    ctime(ob->query("last_on")) + " )\n" NOR);
  write(HIC " ff mudlib release のм砃ゅン http://bbs.csmc.edu.tw/spock/\n┪ ff.muds.net 4100 眔.\n﹝︽╰参弧叫 help space_flight\n" NOR);
  UPDATE_D->check_user(user);
}

varargs void reconnect(object ob, object user, int silent) {
  user->set_link(ob);
  ob->set_body(user);
  exec(user, ob);

  if (!silent) {
    tell_room(environment(user), user->query("name") + "穝硈絬硂.\n",
      ({ user }));
  }
  CHANNEL_D->do_channel(this_object(), "sys",
    sprintf("%s パ %s 穝硈絬秈.", user->query("name"), query_ip_name(user)));
  UPDATE_D->check_user(user);
  user->delete_temp("netdead");
}

int check_legal_id(string id) {
  int i;

  i = strlen(id);

  if ((strlen(id) < 3) || (strlen(id) > 20)) {
    write("癸ぃ癬, 璣ゅゲ斗琌 3  20 璣ゅダ.\n");
    return 0;
  }
  while (i--)
    if (id[i] < 'a' || id[i] > 'z') {
      write("癸ぃ癬, 璣ゅノ璣ゅダ.\n");
      return 0;
    }

  return 1;
}

int check_legal_name(string name) {
  int i;

  i = strlen(name);

  if ((strlen(name) < 2) || (strlen(name) > 20)) {
    write("癸ぃ癬, いゅゲ斗琌 1  10 いゅ.\n");
    return 0;
  }
  while (i--) {
    if (name[i] <= ' ') {
      write("癸ぃ癬, いゅぃノ北じ.\n");
      return 0;
    }
    //		if( i%2==0 && !is_chinese(name[i..<0]) ) {
    //			write("癸ぃ癬, 叫眤ノいゅ.\n");
    //			return 0;
    //		}
  }
  if (member_array(name, banned_name) != -1) {
    write("癸ぃ癬, 硂贺穦硑Θㄤ耑.\n");
    return 0;
  }

  return 1;
}

object find_body(string name) {
  object ob, *body;

  if (objectp(ob = find_player(name)))
    return ob;
  body = children(USER_OB);
  for (int i = 0; i < sizeof(body); i++)
    if (clonep(body[i])
      && getuid(body[i]) == name) return body[i];

  return 0;
}

int set_wizlock(int level) {
  if (wiz_level(this_player(1)) <= level)
    return 0;
  if (geteuid(previous_object()) != ROOT_UID)
    return 0;
  wiz_lock_level = level;
  return 1;
}


