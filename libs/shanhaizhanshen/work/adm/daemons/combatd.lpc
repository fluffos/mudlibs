string *guard_msg = ({
        "$N" CYN " 对着 " NOR "$n" CYN "吼道：“嘿，天堂有路你不走，地狱无门你来投，嘿嘿，你岂不是自寻死路，”\n" NOR,
        "$N" CYN " 骂道：“蠢材，我在这里呀！” ，试图激怒" NOR "$n" CYN ".\n" NOR,
        "$N" CYN " 从" NOR "$n" CYN " 的脸上看出其用意，不由心下大怒，疾声厉色地喊道：“天杀的蠢猪，我看你是果然是人头猪脑，又做什么春秋大梦！你以为我只懂得一招半式吗？”\n" NOR,
        "$N" CYN " 阴冷的声音仿佛从阴暗潮湿的地底冒出来，令人激灵灵的打个冷颤 “休想逃！”　。\n" NOR,
        "拼力支持的$N" CYN " 心下焦急地思谋脱身之计：“不妙，我现在进退维艰，吾消彼长下，必败无疑，该怎么办？……”\n" NOR,
});

string *catch_hunt_msg = ({
        "" HIW " 真所谓仇人相见，分外眼红$N气得青筋暴涨，血脉贡张，对着 " NOR "$n" HIW " 暴喝一声：“呸！你这魔鬼我正要找你，你却竟敢找上门来！”\n" NOR,
        "" HIW "“哈哈，你的死期到了，让我把你他妈的钻个稀巴烂，骨肉四溅惨死！”" NOR "!\n" NOR,
        "$N" HIW " 恨 " NOR "$n" HIW " 恨得双目充血，鲜血从$N 眼内溢出，顺颊而下，点点滴滴，落到地上……!\n" NOR,
        "$N" HIW " 满脸愤色，双目充血，脸上筋脉暴突，发立如针，张开狰狞虎口，怒斥" NOR "$n" HIW " ：“呸！你根本没有足够的实力胜我，你拿命来……”\n" NOR,
        "$N" HIW "一见到" NOR "$n" HIW " , 运劲疾扑过去！暴喝：“受死吧！垃圾”。 \n" NOR,
        "$n" HIW " 脸上肌肉一阵抽搐，双目喷射怒火，心底不甘心地默念：“我不会死，更不能败！”\n" NOR,
        "$N" HIW " 愤怒的神情仿如怒狮，对逃跑的" NOR "$n" HIW " 厉喊：“不听劝阻，这是你咎由自取，那就别怪我手下无情！”!\n" NOR, 
} );

string *v_catch_hunt_msg = ({
	"$N" HIW " 一发现 " NOR "$n" HIW "便狞笑，狂笑不绝：“哈哈哈哈……待你下世，再来找我报仇吧！哈哈……” !!\n" NOR,
});

