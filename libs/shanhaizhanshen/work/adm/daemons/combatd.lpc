string eff_status_msg(int ratio)
{
        if( ratio==100 ) return HIG "看起来气血充盈，并没有受伤。" NOR;
        if( ratio > 90 ) return HIG "似乎受了点轻伤，不过光从外表看不大出来。" NOR;
        if( ratio > 80 ) return GRN "看起来可能受了点轻伤。" NOR;
        if( ratio > 70 ) return GRN "受了几处伤，不过似乎并不碍事。" NOR;
	if( ratio > 60 ) return HIY "受伤不轻，看起来状况并不太好。" NOR;
        if( ratio > 50 ) return HIY "气息粗重，动作开始散乱，看来所受的伤著实不轻。" NOR;
        if( ratio > 40 ) return YEL "已经伤痕累累，正在勉力支撑著不倒下去。" NOR;
        if( ratio > 30 ) return YEL "受了相当重的伤，只怕会有生命危险。" NOR;
        if( ratio > 20 ) return HIR "伤重之下已经难以支撑，眼看就要倒在地上。" NOR;
        if( ratio > 10  ) return HIR "受伤过重，已经奄奄一息，命在旦夕了。" NOR;
        return HIM "受伤过重，已经有如风中残烛，随时都可能断气。" NOR;
}

string status_msg(int ratio)
{
        if( ratio==100 ) return HIG "看起来充满生命力。" NOR;
        if( ratio > 90 ) return HIG "心内一惊，汗珠点点滴滴沁出额头，溢满苍白的面颊……" NOR;
        if( ratio > 80 ) return GRN "惊汗直横流，头发竖立，丑态百出。" NOR;
        if( ratio > 70 ) return GRN "吓得亡魂皆冒，惊呼连连!!!" NOR;
        if( ratio > 60 ) return HIY "四肢渐感酸麻，胸部郁闷不畅，几乎窒息。" NOR;
        if( ratio > 50 ) return HIY "觉头重身轻，痛入脑际。" NOR;
        if( ratio > 40 ) return YEL "眼看着自己身体的伤口逐渐扩张，似若撕裂，顿时变得心中慌乱不己。" NOR;
        if( ratio > 30 ) return YEL "大汗淋漓，双目腥红，鲜血喷射而出，面目扭曲变形，嚎叫连连。" NOR;
        if( ratio > 20 ) return HIR "软瘫在地，浑身颤抖不休，气若游丝." NOR;
        return HIM "眼前金星乱冒，鲜血狂喷，眼前一黑，晕了过去。" NOR;
}

