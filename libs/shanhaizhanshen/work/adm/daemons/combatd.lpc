void create()
{
	seteuid(getuid());
	set("name", "战斗精灵");
	set("id", "combatd");
}

string damage_msg(int damage, string type)
{
	string str;

        if( damage == 0 ) return "并没有造成任何伤害。\n";

	switch( type ) {
	case "澄端":
                if( damage < 20 ) return "浑身挟带着无比强劲的萧杀之气，向$N 展开更威猛的攻击，一招便伤了 $p 的$l  。\n";
                else if( damage < 40 ) return "飞起一$w ，将近身的$p 刺得翻滚飞退，鄙夷地嘲笑说“高手，果然是捱打高手！”\n";
                else if( damage < 80 ) return HIW "霎时间“狂龙噬”出手，只见漫天皆是迷茫$w 影，如龙卷狂风，将$p 罩个不透风雨。 !\n";
                else if( damage < 160 ) return HIY "攻势密集，$w 如雨下，直打得$p $l 血花四溅，哀嚎不绝!\n";
                else if( damage < 320 ) return HIR "急凝聚功力，几个翻跃，才稳住身形，跌落地上，但$l 已被$n 砍出一道又长又深的伤口，鲜血喷射而出!\n";
                else return HIM "只看见$p 痛苦的脸上肌肉扭曲，身体肌肉抽搐，$w  已把 $l 斩成数段 ! !\n";
		break;
	case "端":
                if( damage < 20 ) return "$w 势一转，“游龙窜”带着萧萧杀气，又雨点般地向$p $l当头攻击。\n";
                else if( damage < 40 ) return "在 $p $l 划得骨碎肉裂，肉雨横飞。\n";
                else if( damage < 80 ) return HIW "如蟒蛇游动刺向$p $l，一阵剧痛迅速渗入到四肢百骇。!\n";
                else if( damage < 160 ) return HIY "$p 甫触$w ，如遭电击，立时面容扭曲，惊呼而醒，身体反射弹起，原来$w 内蕴含高压电流。!\n";
                else if( damage < 320 ) return HIR "$p 受$w 重击，旧伤未愈，又遭痛袭，顿时只觉得天旋地转，眼前金星乱冒，人被弹飞!\n";
                else return HIM "只听见$p 一声惨叫，$l 突然如遭雷击，剧痛无比。剧痛之下，身体骤然脱力，踉跄着几乎跌倒 ! !\n";
		break;
	case "凤端":
                if( damage < 20 ) return "$n的$l骨被震寸断，$l伤的疼痛令$n痛的死去活来，抱$l狂叫……\n";
                else if( damage < 40 ) return "$n愤怒引起的强大无比的压逼劲力，让人割肤生痛，呼吸因难。\n";
               else if( damage < 80 ) return "$n像羊入狼口，只觉热劲袭体，惨叫一声，身体像子弹一样飞出，“噗”的一声，直摔地面。\n";
                else if( damage < 160 ) return HIY "$N锋锐猛劲的气劲，半秒间已把$n暴绞得残肢碎骨血雨满天！\n";
                else if( damage < 320 ) return HIR "撕心裂肺的重击和极热的气劲，令$n口吐鲜血，整个人凌空倒飞，惨嚎中身体溃散飞碎！\n";
                else return HIM "$n感到五藏六腑，全身肌肉骨骼猛然撕裂，但这种无比的剧痛可\n维持不到两秒，因为整个人己被震回经脉内的气劲反震爆碎了……\n";
		break;
   //     case "簀端":
   //             if( damage < 20 ) return "痽羘, 揽端 $p $l ブψ.\n";
   //             else if( damage < 40 ) return "痽羘, ゴ端 $p  $l.\n";
   //             else if( damage < 80 ) return HIW "痽羘, ゴ $p $l , 端﹀瑈ぃゎ.\n";
   //             else if( damage < 160 ) return HIY "痽羘, ゴい $p $l, 翧﹀琕俱ン︾狝.\n";
   //             else if( damage < 320 ) return HIR "痽羘,  $p $l ゴ竇罧, 祅翧﹀聁眔骸.\n";
   //             else return HIM "痽羘, $p $l 秨瑌, ﹀ψミ聁矪.\n";
   //     case "端":
   //             if( damage < 20 ) return "臚羘, 端 $p $l ブψ.\n"; 
   //             else if( damage < 40 ) return "臚羘, 端 $p  $l.\n";
   //             else if( damage < 80 ) return HIW "臚订羘, $p $l 端勃仓仓, ﹀瑈ぃゎ.\n";
   //             else if( damage < 160 ) return HIY "臚订羘, $p  $l 眔﹀ψ家絢, 翧﹀聁.\n";
   //             else if( damage < 320 ) return HIR "臚羘エ臫, $p  $l 祡年, ﹀ψ绢床.\n";
    //            else return HIM "臚羘エ臫, ぱ穘笆, ǎ $p $l 竒, ぃ.\n";
	default:
		if( !type ) type = "";
                if( damage < 20 ) str =  "$n 痛苦的面容扭曲，五内欲碎，直震得黄胆水也吐了出来。\n";
                else if( damage < 40 ) str = "“呀一一一”$n 惨叫一声，“翔龙破体”劲力直透体而入，霎时一股污血从口中箭射而出，人如擎天柱断……\n";
                else if( damage < 80 ) str = HIW "$n 绝望地哀嚎，全身肌肉抽搐，四肢痉挛，皮肉变得畸形扭曲，样子难看极了。\n";
                else if( damage < 160 ) str = HIY "“啊！”只听撕心裂肺地惨叫一声，$n像出膛炮弹，带着疾风直射地面，只撞的地面顽石像挟风的暴雨倾泻而起，$n随着激射的石屑像球一样四处反弹。\n";
                else if( damage < 320 ) str = HIR "$n痛楚亦大大增强，周身肌肉抽搐，脸部扭曲变形，可脑中复仇的意志使$n支撑着痛苦。\n";
                else str = HIM "$n剧痛得面容扭曲，不停的发出各种怪异刺耳的嚎叫声，“一一一吗！啃！吗！合……！\n";
		return str + type + "无边的痛楚迅速蔓延全身，血丝从周身破损处带着，‘嗤！嗤！”的风声仿如烟花飞射四散，那情景令人有一种说不出的诡异恐怖$N  不仅凄然仰天长啸，那叫声中包含着无限的凄惨怨恨，无尽的哀伤悲苦，神鬼为之动容……!\n";
	}
}

