// logind.c
#include <ansi.h>
#include <command.h>
#include <login.h>

inherit F_DBASE;

int wiz_lock_level = WIZ_LOCK_LEVEL;
string *banned_name = ({
  "你", "我", "他", "她", "它", "他", "您",
});

void logon(object ob);
private void get_id(string arg, object ob);
private void get_passwd(string pass, object ob);
private void confirm_relogin(string yn, object ob, object user);
private void confirm_id(string yn, object ob);
private void get_name(string arg, object ob);
private void new_password(string pass, object ob);
private void confirm_password(string pass, object ob);
private void get_email(string email, object ob);
private void get_attributes(string arg, object ob, object user);
private void get_gender(string gender, object ob, object user);
object make_body(object ob);
private void init_new_player(object user);
varargs void enter_world(object ob, object user, int silent);
varargs void reconnect(object ob, object user, int silent);
object find_body(string name);
int check_legal_id(string arg);
int check_legal_name(string arg);
object find_body(string name);
int set_wizlock(int level);
string wiz_lev(int lev);

void create() {
  seteuid(getuid());
  set("channel_id", "连线精灵");
}

void logon(object ob) {
  object *usr;
  int i, wiz_cnt, ppl_cnt, login_cnt;

  cat(WELCOME);
  UPTIME_CMD->main();

  usr = users();
  wiz_cnt = 0;
  ppl_cnt = 0;
  login_cnt = 0;
  for (i = 0; i < sizeof(usr); i++) {
    if (!environment(usr[i])) login_cnt++;
    //		else if( wizardp(usr[i]) ) wiz_cnt++;
    else ppl_cnt++;
  }
  //	printf("ヘ玡Τ %d ︗畍%d ︗產絬, の %d ︗ㄏノ沽刚硈絬い.\n",
  //		wiz_cnt, ppl_cnt, login_cnt );
  printf("目前共有%d 位使用者在线上，另外有%d 位正在尝试连线。\n",
    ppl_cnt, login_cnt);

  write("您的英文名字: ");
  input_to((: get_id :), ob);
}

private void get_id(string arg, object ob) {
  object ppl;

  arg = lower_case(arg);
  if (!check_legal_id(arg)) {
    write("您扮演角色的英文名字: ");
    input_to("get_id", ob);
    return;
  }

#ifdef MAX_USERS
  if ((string)SECURITY_D->get_status(arg) == "(player)"
    && sizeof(users()) >= MAX_USERS) {
    ppl = find_body(arg);
    // Only allow reconnect an interactive player when MAX_USERS exceeded.
    if (!ppl || !interactive(ppl)) {
      write("对不起, " + MUD_NAME + " 的使用者已经太多了，请待会再来。\n");
      destruct(ob);
      return;
    }
  }
#endif

  if (wiz_level(arg) < wiz_lock_level) {
    write("对不起, " + MUD_NAME + " 目前限制巫师等级 " + wiz_lev(wiz_lock_level)
      + " 以上的人才能连线。\n");
    destruct(ob);
    return;
  }

  if ((string)ob->set("id", arg) != arg) {
    write("Failed setting user name.\n");
    destruct(ob);
    return;
  }

  if (file_size(ob->query_save_file() + __SAVE_EXTENSION__) >= 0) {
    if (ob->restore()) {
      write("请输入密码：");
      input_to("get_passwd", 1, ob);
      return;
    }
    write("您的人物储存档出了一些问题，请使用其他人物通知巫师处理。\n");
    destruct(ob);
    return;
  }

  write("使用 " + (string)ob->query("id") + "这个名字将会创造一个新的人物，您确定吗(y/n)? ");
  input_to("confirm_id", ob);
}

private void get_passwd(string pass, object ob) {
  string my_pass;
  object user;

  write("\n");
  my_pass = ob->query("password");
  if (crypt(pass, my_pass) != my_pass) {
    write("密码错误。\n");
    log_file("CRACK", sprintf("Attempted to crack %s ( %s )'s character from %s [%s]\n",
      ob->query("name"), ob->query("id"),
      query_ip_name(ob), ctime(time())));
    destruct(ob);
    return;
  }

  // Check if we are already playing.
  user = find_body(ob->query("id"));
  if (user) {
    if (user->query_temp("netdead")) {
      reconnect(ob, user);
      return;
    }
    write("
您要将另一个连线中的相同人物赶出去，取而代之吗? (y/n)");
    input_to("confirm_relogin", ob, user);
    return;
  }

  if (objectp(user = make_body(ob))) {
    if (user->restore()) {
      log_file("USAGE", sprintf("%s (%s) loggined from %s [%s]\n",
        user->query("name"), user->query("id"),
        query_ip_name(ob), ctime(time())));
      enter_world(ob, user);
      return;
    } else {
      destruct(user);
    }
  }
  write("请您重新创造这个人物。\n");
  confirm_id("y", ob);
}

private void confirm_relogin(string yn, object ob, object user) {
  object old_link;

  if (yn == "") {
    write("您要将另一个连线中的相同人物赶出去，取而代之吗? (y/n)");
    input_to("confirm_relogin", ob, user);
    return;
  }

  if (yn[0] != 'y' && yn[0] != 'Y') {
    write("好吧。\n");
    destruct(ob);
    return;
  } else {
    tell_object(user, "有人从别处( " + query_ip_number(ob)
      + " )连线取代你所控制的人物。\n");
    log_file("USAGE", sprintf("%s (%s) replaced by %s [%s]\n",
      user->query("name"), user->query("id"),
      query_ip_name(ob), ctime(time())));
  }

  // Kick out tho old player.
  old_link = user->link();
  if (old_link) {
    exec(old_link, user);
    destruct(old_link);
  }

  reconnect(ob, user);
}

private void confirm_id(string yn, object ob) {
  if (yn == "") {
    write("使用这个名字将会创造一个新的人物，您确定吗(y/n)? ");
    input_to("confirm_id", ob);
    return;
  }

  if (yn[0] != 'y' && yn[0] != 'Y') {
    write("好吧，那么请重新输入您扮演角色的英文名字: ");
    input_to("get_id", ob);
    return;
  }

  write("您扮演角色的中文名字: ");
  input_to("get_name", ob);
}

private void get_name(string arg, object ob) {
  if (!check_legal_name(arg)) {
    write("您的中文名字 : ");
    input_to("get_name", ob);
    return;
  }

  printf("%O\n", ob);
  ob->set("name", NOR + arg);
  write("请设定您的密码: ");
  input_to("new_password", 1, ob);
}

private void new_password(string pass, object ob) {
  write("\n");
  if (strlen(pass) < 5) {
    write("密码的长度至少要五个字元，请重设您的密码: ");
    input_to("new_password", 1, ob);
    return;
  }
  ob->set("password", crypt(pass, 0));
  write("请再输入一次您的密码，以确认您没记错: ");
  input_to("confirm_password", 1, ob);
}

private void confirm_password(string pass, object ob) {
  string old_pass;
  write("\n");
  old_pass = ob->query("password");
  if (crypt(pass, old_pass) != old_pass) {
    write("您两次输入的密码并不一样，请重新设定一次密码: ");
    input_to("new_password", 1, ob);
    return;
  }

  write("为了在发生疑似 multi-login  情形时保护您的权益，,\n请您输入您的电子邮件地址: ");
  input_to("get_email", ob);
}

private void get_email(string email, object ob) {
  object user;

  ob->set("email", email);

  // If you want do race stuff, ask player to choose one here, then you can
  // set the user's body after the question is answered. The following are
  // options for player's body, so we clone a body here.
  ob->set("body", USER_OB);
  if (!objectp(user = make_body(ob)))
    return;

  write("请决定您的人物属性 [输入 ?或 h 显示说明]: ");
  input_to("get_attributes", ob, user);

}

private void get_attributes(string arg, object ob, object user) {
  int str, dex, inte, not, con, tec;

  if (arg == "?" || arg == "" || arg == "help" || arg == "h") {
    write(@LONG
山海战神的人物属性分为[力量] [敏捷] [智力] [注意] [体质] [技术] 六项。
	(英文代号 : [str]  [dex]  [int]  [not]  [con]  [tec] )

属性就是一个人物其天赋的能力及才能，为先天的因素，除了特殊情况不会改变。  
玩家的各项属性的上下限如下： 
  
	力量 (str):	5 ~ 15
	敏捷 (dex):	6 ~ 19
	智力 (int):	5 ~ 23
	注意 (not):	4 ~ 18
	体质 (con):	7 ~ 17
	技术 (tec):	2 ~ 22

  现在，您必须决定您扮演角色的人物属性，属性的总和必须是 60.
  例如输入: 15 10 10 6 17 2  决定人物是个肌肉发达、耐打、不聪明、迟缓的人。
  ( 输入 str  可以参考这项属性的说明，其他属性的说明以此类推 )

LONG
    );
    write("请决定您的人物属性 [输入 ? 或 h 显示说明]: ");
    input_to("get_attributes", ob, user);
    return;
  }

  else if (arg == "str") {
    write(@LONG
  力量 (str): Strength

       力量指示出一个人的肌肉强度和爆发力，力量越强的人，携带物品的
       总重量上限就越高、也能使用更沉重的武器、穿戴更重的装甲。力量
       值高的人，将在传统格斗方面的技能获得加分，使用空手搏南或传统
       撞击武器战斗时也能造成列大的伤害。
	

LONG
    );
    write("请决定您的人物属性 [输入 ? 或 h 显示说明]: ");
    input_to("get_attributes", ob, user);
    return;
  }

  else if (arg == "dex") {
    write(@LONG
  敏捷 (dex): Dexterity

	敏捷指示出一个人协调全身动作的能力、身手灵敏的程度。敏捷值越
       高，战斗中攻击和防御越占优势、也有较高的时间单位值。人物的移
       动值也与敏捷有关。敏捷值高的人，将在所有格斗方面的技能获得加
       分。
		 

LONG
    );
    write("请决定您的人物属性 [输入 ? 或 h 显示说明]: ");
    input_to("get_attributes", ob, user);
    return;
  }

  else if (arg == "int") {
    write(@LONG
  智力 (int): Intellegence

	智力反映出一个人的智能或天才。智力越高，学习的速度及领悟力越
       高，也较能从错误中汲取教训。智力高的人，将在所有学术方面的技
       能知识获得加分。
	

LONG
    );
    write("请决定您的人物属性 [输入 ? 或 h 显示说明]: ");
    input_to("get_attributes", ob, user);
    return;
  }

  else if (arg == "not") {
    write(@LONG
  注意 (not): Notation

	注意力指示一个人专心致志的能力，注意力越高，越能集中观察力，
       也越能发现旁人所忽略的细节。注意力高的人，所有技能值的上限将
	高於 80。
	
LONG
    );
    write("请决定您的人物属性 [输入 ? 或 h 显示说明]: ");
    input_to("get_attributes", ob, user);
    return;
  }

  else if (arg == "con") {
    write(@LONG
  体质 (con): Constitution

	体质表示一个人身体《耐不耐命》。体质越高的人，越能承受较大的
	伤害而不死亡，治疗时恢复的速度较快，战斗时也较能忍受长期缠斗。


LONG
    );
    write("请决定您的人物属性 [输入 ? 或 h 显示说明]: ");
    input_to("get_attributes", ob, user);
    return;
  }

  else if (arg == "tec") {
    write(@LONG
  技术 (tec): Tech

	技术表示一个人对理性、机械、逻辑思考的能力。技术值高的人，能
       制作并操作较复杂的电子、机械物品。技术值高的人，将在物品制造
       及科学技术的技能获得加分。

LONG
    );
    write("请决定您的人物属性 [输入 ? 或 h 显示说明]: ");
    input_to("get_attributes", ob, user);
    return;
  }

  else if (sscanf(arg, "%d %d %d %d %d %d", str, dex, inte, not, con, tec) == 6) {
    if (str < 5 || str > 15 || dex < 6 || dex > 19
      || inte < 5 || inte > 23 || not < 4 || not > 18
      || con < 7 || con > 17 || tec < 2 || tec > 22) {

      write("抱歉您输入的属性值不符合规定的范围，请您重新输入。\n");

      write("请决定您的人物属性 [输入 ? 或 h 显示说明]: ");
      input_to("get_attributes", ob, user);
      return;
    } else if ((str + dex + inte + not + con + tec) == 60) {
      user->set("str", str);
      user->set("dex", dex);
      user->set("int", inte);
      user->set("not", not);
      user->set("con", con);
      user->set("tec", tec);
    } else {
      write("抱歉您输入的属性值总和为 "
        +sprintf("%d", str + dex + inte + not + con + tec)
        + " , 请您调整到 60。\n");

      write("请决定您的人物属性 [输入 ? 或 h 显示说明]: ");
      input_to("get_attributes", ob, user);
      return;
    }
  }

  else {
    write("请决定您的人物属性 [输入 ? 显示说明]: ");
    input_to("get_attributes", ob, user);
    return;
  }

  write("您要扮演男性(m)的角色或女性(f)的角色: ");
  input_to("get_gender", ob, user);
}

private void get_gender(string gender, object ob, object user) {
  if (gender == "") {
    write("您要扮演男性(m)的角色或女性(f)的角色？");
    input_to("get_gender", ob, user);
    return;
  }

  if (gender[0] == 'm' || gender[0] == 'M')
    user->set("gender", "男性");
  else if (gender[0] == 'f' || gender[0] == 'F')
    user->set("gender", "女性");
  else {
    write("对不起，您只能选择男性(m)或女性(f)的角色: ");
    input_to("get_gender", ob, user);
    return;
  }

  log_file("USAGE", sprintf("%s was created from %s (%s)\n", user->query("id"),
    query_ip_name(ob), ctime(time())));

  user->set("newbie/in_school", 1);
  init_new_player(user);
  enter_world(ob, user);
}

object make_body(object ob) {
  string err;
  object user;
  int n;

  // query the variable saved in /data/login/????.o
  user = new(ob->query("body"));
  if (!user) {
    write("现在可能有人正在修改使用者物件的程式，无法进行复制。\n");
    write(err + "\n");
    return 0;
  }
  seteuid(ob->query("id"));
  export_uid(user);
  export_uid(ob);
  seteuid(getuid());
  user->set("id", ob->query("id"));
  user->set_name(ob->query("name"), ({ ob->query("id") }));
  return user;
}
private void init_new_player(object user) {
  user->set("title", "平民");
  user->set("birthday", time());
  user->set("potential", 99);
  user->set("level", 0);
  user->set("combat_exp", 0);

  user->set("race", "人类");

  user->set("channels", ({ "chat", "music", "rumor", "es" }));

  user->set("position", "stand");
}

varargs void enter_world(object ob, object user, int silent) {
  object room, coat, pants, cloak, shoes;
  string startroom;

  user->set_link(ob);
  ob->set_body(user);
  exec(user, ob);

  write("目前权限: " + wizhood(user) + "\n");
  user->setup();

  // In case of new player, we save them here right aftre setup 
  // compeleted.
  user->save();
  ob->save();

  if (!silent) {
    cat(MOTD);
    if (ob->query("new_mail")) {
      write(GRN + "\n有您的信，请到邮局来一趟...\n\n" + NOR);
      ob->set("new_mail", 0);
    }
    if (user->is_ghost())
      startroom = DEATH_ROOM;
    else if (!stringp(startroom = user->query("startroom"))) {
      startroom = START_ROOM;
      if (user->query("newbie/in_school")) {
        coat = new("/obj/coat");
        coat->move(user);
        coat->wear();
        pants = new("/obj/pants");
        pants->move(user);
        pants->wear();
        cloak = new("/obj/cloak");
        cloak->move(user);
        cloak->wear();
        shoes = new("/obj/shoes");
        shoes->move(user);
        shoes->wear();
      }
    }

    if (!catch(load_object(startroom))) {
      if (!user->move(startroom))
        user->move(GUEST_ROOM);
    } else {
      user->move(START_ROOM);
      startroom = START_ROOM;
      user->set("startroom", START_ROOM);
    }
    message_vision("$N 连线进入山海战神之简单武力！！！！！\n", user);
  }
  CHANNEL_D->do_channel(this_object(), "sys",
    sprintf("%s 由 %s 连线进入。", user->name(), query_ip_name(user)));
  write(HIY "上次连线地址: " + ob->query("last_from") + " ( " +
    ctime(ob->query("last_on")) + " )\n" NOR);
  write(HIC "             全新动态ＭＵＤ－－山海战神\n
由<ＭＵＤ吸血鬼> neva（月影／山海战神）\n
             ,        ,
            /(        )`
            \\ \\___   / |
            /- _  `-/  '
           (/\\/ \\ \\   /\\
           / /   | `    \\
           O O   ) /    |
           `-^--'`<     '
          (_.)  _  )   /
           `.___/`    /
             `-----' /
<----.     __ / __   \\
<----|====O)))==) \\) /====
<----'    `--' `.__,' \\
             |        |
              \\       /
         ______( (_  / \\______
       ,'  ,-----'   |        \\
       `--{__________)        \\/  
在史巴克停止开发的Final Frontier v0.6e版基础上制造。\n
本 Mud 源程序为自由软件，任何人可以复制、改写、传播。\n
 启动自动帮助系统请执行(auto help)命令。 \n" NOR);
  UPDATE_D->check_user(user);
}

varargs void reconnect(object ob, object user, int silent) {
  user->set_link(ob);
  ob->set_body(user);
  exec(user, ob);

  if (!silent) {
    tell_room(environment(user), user->query("name") + "重新连线回到这个世界。\n",
      ({ user }));
  }
  CHANNEL_D->do_channel(this_object(), "sys",
    sprintf("%s 由 %s 重新连线进入", user->query("name"), query_ip_name(user)));
  UPDATE_D->check_user(user);
  user->delete_temp("netdead");
}

int check_legal_id(string id) {
  int i;

  i = strlen(id);

  if ((strlen(id) < 3) || (strlen(id) > 20)) {
    write("对不起，你的英文名字必须是３到２０个英文字母。\n");
    return 0;
  }
  while (i--)
    if (id[i] < 'a' || id[i] > 'z') {
      write("对不起，你的英文名字只能用英文字母。\n");
      return 0;
    }

  return 1;
}

int check_legal_name(string name) {
  int i;

  // UTF8 FIX: strlen() now counts Unicode characters, not GBK bytes --
  // this bound used to be a byte count (2 bytes per Chinese char);
  // halved to the equivalent character count.
  i = strlen(name);

  if ((strlen(name) < 1) || (strlen(name) > 10)) {
    write("对不起，你的中文名字必须是１到１０个中文字。\n");
    return 0;
  }
  while (i--) {
    if (name[i] <= ' ') {
      write("对不起，你的中文名字不能使用控制字元。\n");
      return 0;
    }

  }
  if (member_array(name, banned_name) != -1) {
    write("对不起，这种名字会造成其他人的困扰。\n");
    return 0;
  }

  return 1;
}
object find_body(string name) {
  object ob, *body;

  if (objectp(ob = find_player(name)))
    return ob;
  body = children(USER_OB);
  for (int i = 0; i < sizeof(body); i++)
    if (clonep(body[i])
      && getuid(body[i]) == name) return body[i];

  return 0;
}

int set_wizlock(int level) {
  if (wiz_level(this_player(1)) <= level)
    return 0;
  if (geteuid(previous_object()) != ROOT_UID)
    return 0;
  wiz_lock_level = level;
  return 1;
}


// Lsr Tue Nov 26 01:00:49 CST 1996

string wiz_lev(int lev) {
  if (lev == 5) return "山海战神 (admin)";
  if (lev == 4) return "烈炎元帅 (arch)";
  if (lev == 3) return "飓风前将 (wizard)";
  if (lev == 2) return "紫玉副将 (apprentice)";
  if (lev == 1) return "铁石士兵(immortal)";
  return RED "-=-=-=-=-=-=-=-=-=-=-=-=-=-=\n\n
" HIW "呃...这...不会吧 ?!\n
" HIC "你现在使用的这个人物有问题，请用另外一位人物上线请巫师帮忙 !\n\n
" RED "-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=\n\n" NOR;
}
