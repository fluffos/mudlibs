      if (damage < 20) return "痽羘, 揽 $p $l .\n";
      else if (damage < 40) return "痽羘, ゴ $p  $l.\n";
      else if (damage < 80) return HIW "痽羘, ゴ $p  $l.\n";
      else if (damage < 160) return HIY "痽羘,  $p  $l ゴふ.\n";
      else if (damage < 320) return HIR "痽羘,  $p $l ゴ竇罧.\n";
      else return HIM "痽羘, $p $l 秨瑌.\n";
    case "端":
      if (damage < 20) return "臚羘, 端 $p $l .\n";
      else if (damage < 40) return "臚羘,  $p  $l.\n";
      else if (damage < 80) return HIW "臚订羘, $p $l 揽勃仓仓.\n";
      else if (damage < 160) return HIY "臚订羘, $p  $l 眔ヘ獶.\n";
      else if (damage < 320) return HIR "臚羘エ臫, $p  $l 眔瘆年ぃ臭.\n";
      else return HIM "臚羘エ臫, ぱ穘笆, ǎ $p $l 竒, ぃ.\n";
    default:
      if (!type) type = "穕胊";
      if (damage < 20) str = "琌硑Θ矪淮稬";
      else if (damage < 40) str = "硑Θ矪";
      else if (damage < 80) str = HIW "硑Θ矪腨";
      else if (damage < 160) str = HIY "硑Θ会腨";
      else if (damage < 320) str = HIR "硑Θ讽腨";
      else str = HIM "硑Θ伐ㄤ腨┤";
      return str + type + "!\n";
  }
}

string eff_status_msg(int ratio) {
  if (ratio == 100) return HIG "ㄓ胺眃▆" NOR;
  if (ratio > 90) return HIG "ㄓΤㄇ端" NOR;
  if (ratio > 80) return GRN "癬ㄓ翴端" NOR;
  if (ratio > 70) return GRN "ōΤ碭矪端, ぃ锚ㄆ" NOR;
  if (ratio > 60) return HIY "端ぃ淮, 癬ㄓ猵ぃび" NOR;
  if (ratio > 50) return HIY "Τㄇ端, ㄓ端龟ぃ淮" NOR;
  if (ratio > 40) return YEL "ō端勃仓仓, タ玧や嫉" NOR;
  if (ratio > 30) return YEL "端, ┤Τネ㏑繧" NOR;
  if (ratio > 20) return HIR "端ぇ螟や嫉, 泊帝碞璶" NOR;
  if (ratio > 10) return HIR "硈ず纽常忌臩ㄓ, 竒㏑ス" NOR;
  return HIM "ō﹀ψ家絢, 繦" NOR;
}

