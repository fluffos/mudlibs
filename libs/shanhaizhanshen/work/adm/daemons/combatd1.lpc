}

string damage_msg(int damage, string type) {
  string str;

  if (damage == 0) return "⊿Τ硑Θヴ︙端甡.\n";

  switch (type) {
    case "澄端":
      if (damage < 20) return "琌淮淮揽瘆 $p $l ブψ.\n";
      else if (damage < 40) return " $p $l 购笵灿﹀勃.\n";
      else if (damage < 80) return HIW "夺羘 $p $l 购笵端 !\n";
      else if (damage < 160) return HIY "夺羘 $p $l 笵﹀睴睴端 !\n";
      else if (damage < 320) return HIR "夺羘 $p $l 笵瞏端, 聁眔 $N 骸羪翧﹀ !\n";
      else return HIM "钮ǎ $p 羘篏, $w р $l 辟Θㄢ篒 ! !\n";
      break;
    case "端":
      if (damage < 20) return "琌淮淮瘆 $p $l ブψ.\n";
      else if (damage < 40) return " $p $l 承.\n";
      else if (damage < 80) return HIW "糚羘 $p $l 砛\ !\n";
      else if (damage < 160) return HIY "糚羘秈 $p  $l, ㄏ $p ぃパ︑癶碭˙ !\n";
      else if (damage < 320) return HIR "糚夺羘, $w  $p $l ﹀ψ罸絢竇罧 !\n";
      else return HIM "挡狦钮ǎ $p 羘篏, $w  $p  $l 癸τ, ﹀聁骸 ! !\n";
      break;
    case "凤端":
      if (damage < 20) return " $p  $l ゴ矪.\n";
      else if (damage < 40) return "阑㏑い, $p  $l 祅竳遏.\n";
      else if (damage < 80) return HIW "阑㏑い, ㄏ $p 磂羘 !\n";
      else if (damage < 160) return HIY "痽羘, ゴ眔 $p 硈癶ㄢ˙ !\n";
      else if (damage < 320) return HIR "硂痽羘ゴ眔 $p 礹眔篏 !\n";
      else return HIM "阑い, $p珃羘翧﹀ ! !\n";
      break;
    case "簀端":
      if (damage < 20) return "痽羘, 揽端 $p $l ブψ.\n";
      else if (damage < 40) return "痽羘, ゴ端 $p  $l.\n";
      else if (damage < 80) return HIW "痽羘, ゴ $p $l , 端﹀瑈ぃゎ.\n";
      else if (damage < 160) return HIY "痽羘, ゴい $p $l, 翧﹀琕俱ン︾狝.\n";
      else if (damage < 320) return HIR "痽羘,  $p $l ゴ竇罧, 祅翧﹀聁眔骸.\n";
      else return HIM "痽羘, $p $l 秨瑌, ﹀ψミ聁矪.\n";
    case "端":
      if (damage < 20) return "臚羘, 端 $p $l ブψ.\n";
      else if (damage < 40) return "臚羘, 端 $p  $l.\n";
      else if (damage < 80) return HIW "臚订羘, $p $l 端勃仓仓, ﹀瑈ぃゎ.\n";
      else if (damage < 160) return HIY "臚订羘, $p  $l 眔﹀ψ家絢, 翧﹀聁.\n";
      else if (damage < 320) return HIR "臚羘エ臫, $p  $l 祡年, ﹀ψ绢床.\n";
      else return HIM "臚羘エ臫, ぱ穘笆, ǎ $p $l 竒, ぃ.\n";
    default:
      if (!type) type = "端甡";
      if (damage < 20) str = "琌硑Θ矪淮稬";
      else if (damage < 40) str = "硑Θ矪";
      else if (damage < 80) str = HIW "硑Θ矪腨";
      else if (damage < 160) str = HIY "硑Θ会腨";
      else if (damage < 320) str = HIR "硑Θ讽腨";
      else str = HIM "硑Θ伐ㄤ腨┤";
      return str + type + "!\n";
  }
}

string v_damage_msg(int damage, string type) {
