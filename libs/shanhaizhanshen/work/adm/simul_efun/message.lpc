// message.c
// Process message output.
// Author unknown.
// Last modified by Spock @ FF   98.Aug.20.

varargs void tell_vehicle( string msg, object vehicle, object target )
{
	string str;
	object *inv;
	int i;

	str = "  [" + (string)vehicle->name() + "] " + msg;
	inv = all_inventory( vehicle );

	i = sizeof( inv );
	while( i-- ) {
                if( objectp(target) ) {
                        if( !(int)inv[i]->visible( target ) ) {
                                if( (int)target->is_vehicle() ) {
                                        str = replace_string( str, "$P", "琘エ砰");
                                        str = replace_string( str, "$N", "琘エ砰");
                                        str = replace_string( str, "$p", "琘エ砰");
                                        str = replace_string( str, "$n", "琘エ砰");
                                }
                                if( (int)target->is_character() ) {
                                        str = replace_string( str, "$P", "琘");
                                        str = replace_string( str, "$N", "琘");
                                        str = replace_string( str, "$p", "琘");
                                        str = replace_string( str, "$n", "琘");
                                } else {
					str = replace_string( str, "$P", target->name());
					str = replace_string( str, "$N", target->name());
					str = replace_string( str, "$p", target->name());
					str = replace_string( str, "$n", target->name());
				}
                        } else {
				str = replace_string( str, "$P", target->name());
				str = replace_string( str, "$N", target->name());
				str = replace_string( str, "$p", target->name());
				str = replace_string( str, "$n", target->name());
                        }
                }
		message("outside", str, inv[i] );
	}
	return;
}

void tell_object( object ob, string str )
{
	message("tell_object", str, ob);
}

varargs void tell_room( mixed ob, string str, object *exclude )
{
	message("tell_room", str, ob, exclude );
	return;
}

void shout(string str)
{
	message("shout", str, users(), this_player() );
}

void write(string str)
{
	if( this_player() )
		message("write", str, this_player());
	else if( previous_object() )
		message("write", str, previous_object());
	else
		efun::write(str);
}

varargs void say(string str, mixed exclude)
{
	if( living(previous_object()) )
		message("say", str, environment(previous_object()), previous_object());
	else if( this_player() )
		message("say", str, environment(this_player()), this_player());
}

varargs void message_vision( string msg, object me, object you)
{
	string my_gender, your_gender, my_name, your_name;
	string str1, str2, str3;
	object *inv;
	int i;

// str1 is the message which object me receives.
// str2 is which object you receives.
// str3 is which to all objects present in environment excepts you and me.

	if( (int)me->is_vehicle() ) {
		str1 = replace_string( msg,  "$P", me->name());
		str1 = replace_string( str1, "$N", me->name());

		if( !objectp( you ) )
	                tell_vehicle( str1, me );
	} else {
		my_name = (string)me->name();
		my_gender = (string)me->query("gender");
		str1 = replace_string( msg,  "$P", (string)gender_self( my_gender ) );
		str1 = replace_string( str1, "$N", (string)gender_self( my_gender ) );

		if( !objectp( you ) )
			message("vision", str1, me );
	}

	if( objectp( you ) ) {
		if( (int)you->is_vehicle() ) {
			str2 = replace_string( msg,  "$p", (string)you->name());
			str2 = replace_string( str2, "$n", (string)you->name());

			tell_vehicle( str2, you, me );

			if( (int)me->is_vehicle() ) {
				tell_vehicle( str1, me, you );
			} else {
				if( !(int)me->visible( you )) {
					str1 = replace_string( str1, "$p", "琘エ砰");
					str1 = replace_string( str1, "$n", "琘エ砰");
				} else {
					str1 = replace_string( str1, "$p", (string)you->name() );
					str1 = replace_string( str1, "$n", (string)you->name() );
				}
			}
			message("vision", str1, me );
		} else {
			your_name = (string)you->name();
			your_gender= (string)you->query("gender");
			str2 = replace_string( msg,  "$p", (string)gender_self(your_gender));
			str2 = replace_string( str2, "$n", (string)gender_self(your_gender));

			if( !(int)you->visible( me )) {
				str2 = replace_string( str2, "$P", "琘");
				str2 = replace_string( str2, "$N", "琘");
			} else {
				str2 = replace_string( str2, "$P", (string)gender_pronoun(my_gender));
				str2 = replace_string( str2, "$N", my_name);
			}
			message("vision", str2, you);
			if( !(int)me->visible( you )) {
				if( (int)you->is_character() ) {
					str1 = replace_string( str1, "$p", "琘");
					str1 = replace_string( str1, "$n", "琘");
				} else {
					str1 = replace_string( str1, "$p", (string)you->name() );
					str1 = replace_string( str1, "$n", (string)you->name() );
				}
			} else {
				str1 = replace_string( str1, "$p", (string)gender_pronoun(your_gender));
				str1 = replace_string( str1, "$n", your_name);
			}
			message("vision", str1, me );
		}
	}

	inv = all_inventory( environment( me ));
	i = sizeof( inv );
	while( i-- ) {
		if( inv[i] == me || inv[i] == you )
			continue;
		if( (int)inv[i]->visible( me )) {
			str3 = replace_string( msg,  "$P", (string)me->name() );
			str3 = replace_string( str3, "$N", (string)me->name() );
		} else if( (int)me->is_character() ) {
			str3 = replace_string( msg,  "$P", "琘" );
			str3 = replace_string( str3, "$N", "琘" );
		} else if( (int)me->is_vehicle() ) {
			str3 = replace_string( msg,  "$P", "琘エ砰" );
			str3 = replace_string( str3, "$N", "琘エ砰" );
		}
                if( objectp(you) ) {
			if( (int)inv[i]->visible( you )) {
				str3 = replace_string( str3, "$p", (string)you->name() );
				str3 = replace_string( str3, "$n", (string)you->name() );
			} else if( (int)you->is_character() ) {
				str3 = replace_string( str3, "$p", "琘" );
				str3 = replace_string( str3, "$n", "琘" );
			} else if( (int)you->is_vehicle() ) {
				str3 = replace_string( str3, "$p", "琘エ砰" );
				str3 = replace_string( str3, "$n", "琘エ砰" );
			} else {		
				str3 = replace_string( str3, "$p", (string)you->name() );
				str3 = replace_string( str3, "$n", (string)you->name() );
			}
		}
		if( inv[i]->is_vehicle() )
			tell_vehicle( str3, inv[i] );
		else
			message("vision", str3, inv[i] );
	}
}

varargs void message_vision_exclude( string msg, object me, object *exclude )
{
	string my_gender, my_name;
	string str1, str3;
	object *inv;
	int i, j;
	int flag = 0;

// str1 is the message which object me receives.
// str3 is which to all objects present in environment excepts exclude objects.

	if( (int)me->is_vehicle() ) {
		str1 = replace_string( msg,  "$P", (string)me->name());
		str1 = replace_string( str1, "$N", (string)me->name());

		j = sizeof( exclude );
		while( j-- ) {
			if( me == exclude[j] ) {
				flag = 1;
				break;
			}
		}
		if( flag == 0 )
		        tell_vehicle( str1, me );
	} else {
		my_name = (string)me->name();
		my_gender = (string)me->query("gender");
		str1 = replace_string( msg,  "$P", (string)gender_self(my_gender));
		str1 = replace_string( str1, "$N", (string)gender_self(my_gender));

		message("vision", str1, me, exclude );
	}

	flag = 0;
	inv = all_inventory( environment( me ));
	i = sizeof( inv );
	while( i-- ) {
		if( inv[i] == me )
			continue;

		if( (int)inv[i]->visible( me )) {
			str3 = replace_string( msg,  "$P", (string)me->name() );
			str3 = replace_string( str3, "$N", (string)me->name() );
		} else if( (int)me->is_character() ) {
			str3 = replace_string( msg,  "$P", "琘" );
			str3 = replace_string( str3, "$N", "琘" );
		} else if( (int)me->is_vehicle() ) {
			str3 = replace_string( msg,  "$P", "琘エ砰" );
			str3 = replace_string( str3, "$N", "琘エ砰" );
		}
		if( (int)inv[i]->is_vehicle() ) {
			tell_vehicle( str3, inv[i] );
		} else {
			message("vision", str3, inv[i], exclude );
		}
	}
}
