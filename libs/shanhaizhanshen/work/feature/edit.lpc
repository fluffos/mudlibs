// edit.c

#include <function.h>
#include <ansi.h>

#define edit_version "(0.2)"
#define HELP_FILE "/doc/help/input"

void editp(int lines, string text, function callback);

int edit(function callback)
{
	write(GRN"   线上输入编辑器简易版"+edit_version+"，想看"NOR+HIG"功能说明书"NOR+GRN"请押"HIW"~h"NOR+GRN"'\n"NOR);
	write(GRN"     输入完了想"NOR+HIG"结束离开"NOR+GRN"请押"HIW"."NOR+GRN"，想"NOR+HIG"取消输入"NOR+GRN"请押"HIW"~q"NOR+GRN"'\n"NOR);
	write(GRN"\n"NOR);
	if( (functionp(callback) & FP_NOT_BINDABLE)==0 )
		callback = bind(callback, this_object());
	//input_to("input_line", "", callback );
	editp(1,"",callback);
	return 1;
}

private void editp(int lines, string text, function callback)
{
	/* 硂琌︽腹..よ獽块..*/
//	write(((lines < 10) ? " " : "")+ lines +"> ");
	input_to("input_line", text, callback);
}

private void input_line(string line, string text, function callback)
{
	string help_file, *lin;
	int lines, i, start, end;

	lin = explode(text , "\n");
	lines = sizeof(lin)+2; 
	
	if( line=="." ) {
		if( text=="" ) text = "\n";
		if( functionp(callback) & FP_OWNER_DESTED ) 
			write("启动编辑模式的物件已经消失了，输入取消。\n");
		else if (functionp(callback))
			evaluate(callback, text);
		return;
	} 
	
	if( line=="~q" ) {
		write("嗯。。。反悔了？？？\n");
		return;
	} 
	
	if( line=="~h" ) {
		help_file = read_file (HELP_FILE);
		write(help_file);
		lines -= 1;
		editp(lines,text,callback);
		return;
	}
	/* 硂琌р竒块陪ボㄓ..*/
	if( line=="~p" ) {
		if(text == ""){
			write("还没有输入任何资料。\n");
			lines -= 1;
			editp(lines,text,callback);
			return;
		}			
		write("－－－这是刚才输入的－－－\n");
		lines -= 1;
		for( i=0; i < lines-1 ; i++){
			printf("%2d  %s\n",i+1,lin[i]);
		}
		write("\n");
		editp(lines,text,callback);
		return;
	}/* 陪ボㄓ矪瞶 END */
	  
	/* 硂琌埃矪瞶... */
	if(sscanf(line,"~d%d,%d",start, end) || sscanf(line,"~d%d",start)) {
		if( !end ) end = start;
		lines -= 1;
		if((start < 1) || (start > lines - 1) || (end < start) || ( end > lines - 1) ){
			write("嗯。。。超出范围了喔。。\n");
			editp(lines,text,callback);
		return;
		}
		printf("Ok..删除了 第%2d%s",start, 
			(start == end)? "行.\n" : sprintf("行°第%2d行.\n",end));
		text="";
		for( i=0 ; i < start - 1; i++){
			text += lin[i] + "\n";
		}
		for(i=end ; i < lines-1 ; i++){
			text += lin[i] + "\n" ;
		}
		lines -= ((end+1)-start);
		editp(lines,text,callback);
	return;
	}/* 埃矪瞶... END  */
	
		text += line + "\n";
		editp(lines,text,callback);
}
