private void _home(object pl)                // 盢村夹簿︽
{
        mapping me=pl->query_temp("me");
        
        me["iCol"] = 1;
        if (me["iS_Col"] == 1)_refresh_status(pl);
        else        _refresh_screen(pl, me["iS_Row"], me["iE_Row"], 1);
} // _home()


private void _insert(object pl)                // 村夹玡础
{
        mapping me=pl->query_temp("me");
        
        if (sizeof(me["sText"]) == 0) return;
        me["is_Command_Mode"] = 0;
        _refresh_status(pl);
} // _insert()


private void _insert_line(object pl)        // 村夹よ穝︽
{
        string *text=({ });
        mapping me=pl->query_temp("me");
        
        me["is_Command_Mode"] = me["is_NewFile"] = 0;
        me["is_Modify"] = 1;
        // 浪琩琌村夹よ琌Τず甧
        if (me["iS_Row"]+me["iRow"]-3 >= 0)
                text = me["sText"][0..me["iS_Row"]+me["iRow"]-3];
        text += ({ "" });
        text += me["sText"][me["iS_Row"]+me["iRow"]-2..<1];
        me["sText"] = text;
        me["iCol"] = 1;
        _refresh_screen(pl, me["iS_Row"], sizeof(me["sText"]), 1);
} // _insert_line()


private void _insert_exclam_mark(object pl) // 村夹玡础!じ
{
        mapping me=pl->query_temp("me");
        
        // 礚猭タ盽块!┮疭ㄧΑ块!
        if (sizeof(me["sText"]) == 0) return;
        me["sChar"] = "!";
        _process(pl);
} // _insert_!()


private void _join(object pl)                // 盢︽ゅ簿︽
{
        string *text=({ });
        mapping me=pl->query_temp("me");


        if (me["iS_Row"]+me["iRow"]-1 >= sizeof(me["sText"])) return;
        
        me["is_NewFile"] = 0;
        me["is_Modify"] = 1;
        _end(pl);                        // 盢村夹簿︽Ю
        text = me["sText"][0..me["iS_Row"]+me["iRow"]-2];
        if (sizeof(me["sText"][me["iS_Row"]+me["iRow"]-1]))
        {        // 璝︽Τず甧ㄓ
                text[me["iS_Row"]+me["iRow"]-2] += (" "+
                        me["sText"][me["iS_Row"]+me["iRow"]-1]);
                _right(pl, 1, 1);
        }
        text += me["sText"][me["iS_Row"]+me["iRow"]..<1];
        me["sText"] = text;
        _refresh_screen(pl, me["iS_Row"], me["iE_Row"], me["iS_Col"]);
} // _join()


private void _keymap(object pl)                // ﹚竡穝龄
{
        _message(pl, "叫块穝﹚竡龄㎝\龄钡 ENTER フ筳秨)",
                "_keymap_done", ECHO);
} // _keymap()


protected void _keymap_done(string str, object pl) // 眔﹚竡龄
{
        string old, _new;
        mapping me=pl->query_temp("me");
        
        _refresh_status(pl);
        if (str != "")
        {        // 璝Τ戈块
                if (sscanf(str, "%s %s", _new, old) != 2)
                        return _message(pl, "块Α岿粇", "_message_done",
                                HIDE);
                me["keymap"][_new] = old;
                _message(pl, sprintf("眖穝﹚竡龄%s碞Τ\龄%s\",
                        _new, old), "_message_done", HIDE);
        }
        else        get_char("_input", HIDE, pl); // 块膥尿弄块
} // _keymap_done()


private void _left(object pl)                // 村夹┕オ簿
{
        mapping me=pl->query_temp("me");

        if (me["iS_Col"]==1 && me["iCol"]==1) return _refresh_status(pl);
        if (--me["iCol"] < 1)
        {        // 村夹穝︗竚礶惠璶酶礶
                // 璝オ簿 8 逆び杠碞オ簿逆
                if (me["iS_Col"]-8 < 1)
                        me["iCol"] = me["iS_Col"]-1;
                else        me["iCol"] = 8; // ぃ礛碞砞﹚村夹材 8 逆︗竚
                _refresh_screen(pl, me["iS_Row"], me["iE_Row"],
                        me["iS_Col"]-me["iCol"]);
                return;
        }
        _refresh_status(pl);
} // _left()


// 篈陪ボ癟
private varargs void _message(object pl, string str, string callback, int hide, mixed arg)
{
        printf(HOME + NOR + REV);        // 簿笆村夹 (1,1)砞﹚はじ陪ボ
        // 睲埃篈癟
        printf("                                                                                ");
        printf(HOME + str);                // 簿笆村夹 (1,1)陪ボ癟
        input_to(callback, hide, pl, arg); // 弄块戈
} // _message()


protected void _message_done(string str, object pl) // 挡癟陪ボ
{
        _refresh_status(pl);
        get_char("_input", HIDE, pl);        // 膥尿弄块﹃
} // _message_done()


private void _next_match(object pl)                // 穓碝/蠢传才﹃
{
        mapping me=pl->query_temp("me");
        string str="";
        // 砞﹚癬﹍穓碝︗竚村夹瞷︗竚
        int    j=me["iS_Col"]+me["iCol"]-1,
               i, ofs;

        
        if (!stringp(me["sSearch"])) return; // 璝⊿砞﹚穓碝﹃ぃ暗ㄆ

        for (i=me["iS_Row"]+me["iRow"]-2; i<sizeof(me["sText"]); i++)
        {        
                if ((ofs = strsrch(me["sText"][i][j-1..<1], me["sSearch"]))
                    == -1)
                        j = 1; // 硂︽⊿т杠砞﹚︽眖材逆秨﹍т
                else
                {        // т﹚﹃, 簿笆村夹ヘ︽
                        _goto_line_done(sprintf("%d", i+1), pl, 0); 
                        me["iCol"] = j+ofs; // 璸衡﹚﹃荡癸︗竚
                        // 璝﹚﹃辅礶玥酶礶
                        if (me["iCol"]<me["iS_Col"] ||
                            me["iCol"]+strlen(me["sSearch"])>me["iS_Col"]+79)
                                _refresh_screen(pl, me["iS_Row"], me["iE_Row"],
                                        me["iCol"]);
                        if (stringp(me["sReplace"]))
                        {        // 惠璶蠢传﹃
                                me["is_NewFile"] = 0;
                                me["is_Modify"] = 1;        
                                // 村夹玡ず甧
                                str = me["sText"][i][0..me["iCol"]-2];
                                str += me["sReplace"];
                                str += (me["sText"][i][me["iCol"]+
                                        strlen(me["sSearch"])-1..<1]);
                                me["sText"][i] = str;
                                // 璝蠢传﹃辅礶玥酶礶
                                if (me["iCol"]<me["iS_Col"] ||
                                    me["iCol"]+strlen(me["sReplace"])
                                    > me["iS_Col"]+79)
                                        _refresh_screen(pl, me["iS_Row"],
                                                me["iE_Row"], me["iCol"]);
                                // 盢村簘簿蠢传﹃
                                me["iCol"] = me["iCol"]+strlen(me["sReplace"])-
                                        me["iS_Col"]+1;
                                printf(ESC "[%d;1f%-80s", me["iRow"]+1,
                                        me["sText"][me["iS_Row"]+
                                        me["iRow"]-2][me["iS_Col"]-1
                                        ..me["iE_Col"]-1]);
                        }
                        // 盢村簘簿穓碝﹃
                        else        me["iCol"] = me["iCol"]+strlen(me["sSearch"])-
                                        me["iS_Col"]+1; 
                        _refresh_status(pl);
                        break;
                } // if found
        } // for each row
        if (i >= sizeof(me["sText"]))
                _message(pl, "тぃ﹚﹃", "_message_done", HIDE);
        else        get_char("_input", HIDE, pl); // 弄块﹃
} // _next_match()


private void _page_down(object pl)        // ┕辈22 ︽
{
        mapping me=pl->query_temp("me");

        if (me["iS_Row"]+22 > sizeof(me["sText"])) return; // 浪琩琌ぃ辈
        me["iS_Row"] += 22;        me["iE_Row"] += 22;
        // 浪琩村夹穝︗竚琌禬筁郎Ю
        if (me["iS_Row"]+me["iRow"]-1 > sizeof(me["sText"]))
                me["iRow"] = sizeof(me["sText"])-me["iS_Row"]+1;
        _refresh_screen(pl, me["iS_Row"], me["iE_Row"], me["iS_Col"]);
        // 璝村夹穝︗竚禬筁︽Ю玥簿笆村夹︽Ю
        if (me["iS_Col"]+me["iCol"]-1 > sizeof(me["sText"][me["iS_Row"]+
                me["iRow"]-2]))
                _end(pl);
} // _page_down()


private void _page_up(object pl)        // ┕辈22 ︽
{
        mapping me=pl->query_temp("me");
        
        if (me["iS_Row"] <= 1) return; // 浪琩琌ぃ辈
        me["iS_Row"] -= 22;
        if (me["iS_Row"] < 1) me["iS_Row"] = 1; // 程陆材
        _refresh_screen(pl, me["iS_Row"], me["iE_Row"], me["iS_Col"]);
        // 璝村夹穝︗竚禬筁︽Ю玥簿笆村夹︽Ю
        if (me["iS_Col"]+me["iCol"]-1 >
            sizeof(me["sText"][me["iS_Row"]+me["iRow"]-2]))
            _end(pl);
} // _page_up()


private void _process(object pl)        // 矪瞶块家Α﹃块
{
        int    i, size;
        string str, rest, *input;
        mapping me=pl->query_temp("me");


        if (me["is_Modify"]==0 || me["is_NewFile"]==1)
        {
                me["is_NewFile"] = 0;
                me["is_Modify"] = 1;
                _refresh_status(pl);
        }
        if (!me["is_Substituted"] && (strsrch(me["sChar"], "\r")!=-1 ||
            strsrch(me["sChar"], "\n")!=-1))
                me["is_Substituted"] = 1; // 砞﹚ず絏传篨夹
        me["sChar"] = replace_string(me["sChar"], "\t", "        ");
        me["sChar"] = replace_string(me["sChar"], "\r", "\rENTER\r");
        me["sChar"] = replace_string(me["sChar"], "\n", "\rENTER\r");
        input = explode(me["sChar"], "\r");

        size = sizeof(input);
        for (i=0; i<size; i++)                // Ω矪瞶︽块
        {
                if (me["is_Substituted"] && input[i] == "ENTER")
                {        // 讽龄 ENTER 璶盢村夹ぇず甧簿穝︽
                        rest = me["sText"][me["iS_Row"]+
                                me["iRow"]-2][me["iS_Col"]+me["iCol"]-2..<1];
                        me["sText"][me["iS_Row"]+me["iRow"]-2] =
                                me["sText"][me["iS_Row"]+
                                me["iRow"]-2][0..me["iS_Col"]+me["iCol"]-3];
                        _append_line(pl); // 村夹┏穝︽
                        // 穝︽ず甧琌村夹︗竚ず甧
                        me["sText"][me["iS_Row"]+me["iRow"]-2] = rest;
                        continue;
                }

                // 块﹃ぃ琌 ENTER , 矪瞶 TAB ﹚︗
                if (me["is_Substituted"] && input[i] == "TAB")
                        input[i] = "        "[0..7-(me["iCol"]-1)%8];
                str = me["sText"][me["iS_Row"]+me["iRow"]-2][0..me["iS_Col"]+
                        me["iCol"]-3] + input[i] + me["sText"][me["iS_Row"] +
                        me["iRow"]-2][me["iS_Col"]+ me["iCol"]-2..<1];
                me["sText"][me["iS_Row"]+me["iRow"]-2] = str;
                _right(pl, sizeof(input[i]), 1);
        } // for

        printf(ESC "[%d;1f%s", me["iRow"]+1, me["sText"][me["iS_Row"]+
                me["iRow"]-2][me["iS_Col"]-1..me["iE_Col"]-1]);
        _refresh_cursor(pl);
} // _process()


protected void _quit(mixed unused, mixed pl) // 瞒秨絪胯竟
{
        mapping me;
        
        seteuid(geteuid(pl));
        me = pl->query_temp("me");
        if (me["is_Modify"])
                return _message(pl, "郎э叫拜惠璶郎盾y/n)[n]",
                        "_confirm_save", ECHO);
        me["iRow"] = 23;
        _refresh_cursor(pl);                // 簿笆村夹程︽
        printf(NOR "\r\n");
        // 璝龄﹚竡癸酚琌碞睲埃產ō癘魁ぃ礛碞癘魁產ō
        if (sizeof(me["keymap"]) == 0) pl->delete("me_keymap");
        else pl->set("me_keymap", me["keymap"]);
        map_delete(EditedFiles, pl->query_temp("me/sFileName"));
        pl->delete_temp("me"); // 睲埃絪胯竟ノ既跑计
} // _quit()


private void _refresh(object pl)        // 穝礶
{
        mapping me=pl->query_temp("me");
        _refresh_screen(pl, me["iS_Row"], me["iE_Row"], me["iS_Col"]);
} // _refresh()


private void _replace(object pl)        // ﹃蠢传
{
        _message(pl, "穓碝/蠢传﹃(钡ENTER,フ筳秨):",
                "_replace_done", ECHO);
} // _replace()


protected void _replace_done(string str, object pl) // 眔蠢传﹃
{
        mapping me=pl->query_temp("me");
        
        _refresh_status(pl);
        if (str != "")
        {        // Τ块戈
                if (sscanf(str, "%s %s", me["sSearch"],        me["sReplace"]) != 2)
                {        // Τ﹃碞﹚穓碝﹃種奔﹚﹃
                        me["sSearch"] = str;
                        me["sReplace"] = "";
                }
                _next_match(pl);
        }
        else        get_char("_input", HIDE, pl); // 膥尿弄块﹃
} // _replace_done()


private void _right(object pl, int col, int extra)        // 村夹┕簿
{
        int    acc;
        mapping me=pl->query_temp("me");


        if (sizeof(me["sText"])==0 || me["iS_Col"]+me["iCol"]-1>
            sizeof(me["sText"][me["iS_Row"]+me["iRow"]-2])-1+extra)
            return;
        me["iCol"] += col;
        if (me["iS_Col"]+me["iCol"]-1 > sizeof(me["sText"][me["iS_Row"]+
            me["iRow"]-2])+extra)
                me["iCol"] = sizeof(me["sText"][me["iS_Row"]+me["iRow"]-2])-
                        me["iS_Col"]+1+extra;
        if (me["iCol"] > 80)
        {        // 村夹穝︗竚ぃǎ跌怠ず惠璶┕簿笆跌怠
                // 璝簿 8 逆び杠碞簿︽Ю
                if (me["iE_Col"]+8 > sizeof(me["sText"][me["iS_Row"]+
                    me["iRow"]-2])+1)
                        acc = sizeof(me["sText"][me["iS_Row"]+me["iRow"]-2])-
                                me["iE_Col"]+1;
                else        acc = 8;
                me["iCol"] = 80-acc+1;         // 璸衡村夹穝︗竚
                _refresh_screen(pl, me["iS_Row"], me["iE_Row"], me["iS_Col"]+acc);
                return;
        }
        _refresh_status(pl);
} // _right()


private void _search(object pl)                // ﹃穓碝
{
        _message(pl, "叫块穓碝﹃钡 ENTER )", "_search_done",
                ECHO);
} // _search()


protected void _search_done(string str, object pl) // 眔穓碝﹃
{
        mapping me=pl->query_temp("me");
        
        _refresh_status(pl);
        if (str != "")
        {        // Τ块戈
                me["sSearch"] = str;        me["sReplace"] = 0;
                _next_match(pl);
        }
        else        get_char("_input", HIDE, pl); // 膥尿弄块﹃
} // _search_done()


private void _tab(object pl)                 // ㏑家Α TAB 龄﹚︗
{
        mapping me=pl->query_temp("me");
        _right(pl, 8-(me["iCol"]-1)%8, 0);
} // _tab()


private void _undef_key(object pl)        // 琘龄﹚竡
{
        _message(pl, "叫块饼﹚竡ぇ\龄钡 ENTER )",
                "_undef_key_done", ECHO);
} // undef_key()


protected void _undef_key_done(string str, object pl) // 眔﹚龄
{
        mapping me=pl->query_temp("me");
        if (str != "")        map_delete(me["keymap"], str);
        _message_done("", pl);
} // undef_key_done()


private void _up(object pl)                // 村夹┕簿︽
{
        int  acc;
        mapping me=pl->query_temp("me");
        
        
        if (me["iRow"]==1 && me["iS_Row"]==1)        return;
        if (--me["iRow"] < 1)
        {        // 村夹穝︗竚ぃǎ跌怠ず碞簿跌怠
                me["iS_Row"]--;
                me["iE_Row"]=me["iS_Row"]+22;
                _refresh_screen(pl, me["iS_Row"], me["iE_Row"], me["iS_Col"]);
                me["iRow"] = 1;
        }
        // 璝村夹穝︗竚禬筁︽Ю玥簿︽Ю
        if (me["iS_Col"]+me["iCol"]-1 > sizeof(me["sText"][me["iS_Row"]+
            me["iRow"]-2]))
                me["iCol"] = sizeof(me["sText"][me["iS_Row"]+me["iRow"]-2])-
                        me["iS_Col"]+(me["is_Command_Mode"]?1:2);
        // 璝︽礚玥﹚︗材逆
        if (me["iCol"]==0 && me["iS_Col"]==1) me["iCol"] = 1;
        if (me["iCol"] > 0) _refresh_status(pl);
        else
        {        // 村夹穝︗竚ぃǎ跌怠ず酶礶
                acc = me["iCol"];        me["iCol"] = 1;
                _refresh_screen(pl, me["iS_Row"], me["iE_Row"],
                        me["iS_Col"]+acc-1);
        }
} // _up()


private void _write(object pl)                // 眔纗郎嘿
{
        _message(pl, "叫块穝郎钡 ENTER ㄏノ侣郎)",
                "_write_done", ECHO, 0);
} // _write()


protected void _write_done(string str, object pl, int quit) // 纗郎
{
        string callback;
        mapping me=pl->query_temp("me");

        if (str == "") str = me["sFileName"];
        else        // 眔郎
                str = resolve_path(pl->query("cwd"), str);
        if (quit) callback = "_quit";
        else callback = "_message_done";
        if (write_file(str, implode(me["sText"], "\n")+"\n", 1))
        {
                me["is_Modify"] = me["is_NewFile"] = 0;
                me["sFileName"] = str;
                _message(pl, "郎Θ\", callback, HIDE);
        }
        else
                _message(pl, "郎ア毖", callback, HIDE);
} // write_done()
