#define HIDE 1                                // 弄块ぃ陪ボじ
#define REFRESH 1                        // 弄块璶酶礶

void start_edit(string filename);        // ㊣絪胯竟秨﹍絪胯
private void _append(object pl);        // 村夹
private void _append_line(object pl);        // 村夹┏穝︽
