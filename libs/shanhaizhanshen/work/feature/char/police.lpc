#include <dbase.h>

void prepare_kill();
void stop_kill();
void ask_drop_weapon();
void check_drop_weapon( object ob );

void prepare_kill()
{
	if( query_temp("pending/prepare_kill") ) return;

	command("unwield rod");
	command("wield sword");
	command("say 哼！你这家伙可要倒大霉了 !!");
	set_temp("pending/prepare_kill", 1 );
}

void stop_kill()
{
	if( !query_temp("pending/prepare_kill") ) return;

	command("unwield sword");
	command("wield rod");
	command("say 哼！刚才那家伙实在是可恶。");
	delete_temp("pending/prepare_kill");
}

void ask_drop_weapon()
{
	object *inv;
	int i;

	inv = all_inventory( environment() );
	
	for( i = 0; i < sizeof( inv ); i ++ ) {
		if( inv[i]->query_temp("weapon") || inv[i]->query("killer") || inv[i]->query("theif") ) {
			if( inv[i]->query("legal_wield_weapon/maniac") ) continue;
			if( inv[i] == this_object() ) continue;
			if( !this_object()->visible( inv[i] ) ) continue;
			if( inv[i]->query("killer") ) {
				message_vision("$N 向 $n 大喊道：你就是那个屠夫 !! 别跑!!\n", this_object(), inv[i] );
				command("kill " + inv[i]->query("id") );
				break;
			} else if( inv[i]->query("thief") ) {
				message_vision("$N 向 $n 大喊道：你就是那个小偷 !! 别跑!!\n", this_object(), inv[i] );
				command("kill " + inv[i]->query("id") );
				break;
			} else {
				message_vision("$N 向 $n 大喊道：快放下你手上的武器 !!\n", this_object(), inv[i]);
				command("follow " + inv[i]->query("id") );
				set_temp("stay_here", 1 );
				call_out("check_drop_weapon", 10, inv[i]);
				break;
			}
		}
	}
	return;
}

void check_drop_weapon( object ob )
{
	if( ob->query_temp("weapon") ) {
		message_vision("$N 向 $n 喊道：别怪我手下无情  !!\n", this_object(), ob );
		command("kill " + ob->query("id") );
	}
	delete_temp("stay_here");
	return;
}
