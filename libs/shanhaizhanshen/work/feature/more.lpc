// more.c

#include <ansi.h>

void more(string cmd, string *text, int line)
{
	int i,j;
	int start_line, goto_line;

	if( sscanf( cmd, "%d", goto_line ) ) {
		if( goto_line < 1 || goto_line > sizeof(text) ) 
			return notify_fail("不正确的行数。\n");
		start_line = goto_line;
		line = goto_line - 1;
		for( i = line + 23; line < sizeof(text) && line < i; line ++ ) {
			write(text[line] + "\n");
			if( line >= sizeof(text) ) break;
		}
	} else
	
	switch(cmd) {
		case "":
			if( line >= sizeof( text ) )
				return; 
			start_line = line + 1;
			for(i = line + 23; line < sizeof(text) && line < i; line ++) {
				write(text[line] + "\n");
				if( line >= sizeof(text) ) break;
			}
			break;
		case "b":
			start_line = line - 45;
			if( start_line < 1 ) start_line = 1;
			line = line - 46;
			if( line < 0 ) line = 0;
			for(i = line + 23; line < i; line ++)
				write(text[line]+"\n");
			break;
		case "q":
			return;
	}
	printf("== 第 %d 至 %d 行 " HIY "%d%%" NOR " == (ENTER 继续下一页，q 离开，b 前一页) ",
		start_line, line, (line*100/sizeof(text)) );
	input_to("more", text, line);
}

void start_more(string msg)
{
	more("", explode(msg, "\n"), 0);
}
