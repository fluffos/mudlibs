// attribute.c

#include <dbase.h>

int query_str() {
  return (int)query("str") + query_temp("apply/str");
}

int query_dex() {
  return (int)query("dex") + query_temp("apply/dex");
}

int query_int() {
  return (int)query("int") + query_temp("apply/int");
}

int query_not() {
  return (int)query("not") + query_temp("apply/not");
}

int query_con() {
  return (int)query("con") + query_temp("apply/con");
}

int query_tec() {
  return (int)query("tec") + query_temp("apply/tec");
}
