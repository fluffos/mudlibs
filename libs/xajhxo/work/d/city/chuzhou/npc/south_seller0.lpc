inherit NPC;

inherit F_VENDOR;

#include <ansi.h>

void create() {
  set_name("宜兴客商", ({ "yixing keshang", "keshang", "seller", }));
  set("title", HBYEL RED "南方" WHT "商人" NOR);
  set("gender", "男性");
  set("age", 25 + random(25));
  set("long", @LONG
这是个南方来的商人，带来了许多南方的特产，正在大声的叫卖。
LONG
  );
  set("attitude", "friendly");
  set("vendor_goods", ([
    "紫砂陶壶": __DIR__ + "obj/zishatao_hu",
    "紫笋茶": MISC_DIR + "zisun_cha",
    "百合": FOOD_DIR + "bai_he",
    "毛笋": FOOD_DIR + "mao_sun",
    "板栗": FRUIT_DIR + "ban_li",
  ]));
  set("talk_msg", ({
  }));
  set("kee", 400);
  set("max_kee", 400);
  set("eff_kee", 400);
  set("sen", 400);
  set("max_sen", 400);
  set("eff_sen", 400);
  set("max_force", 500);
  set("force", 500);
  set("force_factor", 20);
  set("combat_exp", 10000 + random(5000));
  set("social_exp", 20000 + random(5000));
  set("positive_score", 100 + random(500));
  set("negative_score", 100 + random(500));
  set_wugong("lingxiao-shou", 200, 200, 1);
  set_wugong("jiben-qinggong", 200, 200, 1);
  set_xiuwei_by_type("unarmed", 300 + random(600));
  set_xiuwei_by_type("dodge", 300 + random(600));
  setup();

  carry_object(CLOTH_DIR + "cloth3")->wear();
  carry_object(__DIR__ + "zishatao_hu");
  carry_object(MISC_DIR + "zisun_cha");
  carry_object(FOOD_DIR + "bai_he");
  carry_object(FOOD_DIR + "mao_sun");
  carry_object(FRUIT_DIR + "ban_li");
  add_money("coin", 20 + random(31));
}

void init() {
  ::init();
  add_action("do_vendor_list", "list");
}
