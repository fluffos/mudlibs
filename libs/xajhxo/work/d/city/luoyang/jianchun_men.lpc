// rooms:/d/luoyang/jianchun_men.c

#include <room.h>

inherit ROOM;

void create() {
  set("short", "建春门");
  set("long", @LONG
这里是洛阳城的东门。城门洞上方写着三个大字“建春门”，城门两侧贴着
官府的告示。城门并不很大，进出的行人也不多，城门口懒散的站着几个官兵，
偶尔叫住个行人，随便问上两句就匆匆打发了。向东走是一条出城的青石官道，
向西就是繁华的洛阳城了。
LONG
  );
  set("exits", ([
    "west": __DIR__ "nanshi",
    "east": __DIR__ "guandao",
  ]));
  set("objects", ([
    __DIR__ "npc/wujiang": 1,
    __DIR__ "npc/guanbing": 2
  ]));
  set("outdoor", "luoyang");
  setup();
  replace_program(ROOM);
}
