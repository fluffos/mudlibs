// rooms:/d/luoyang/nanshi.c

#include <room.h>

inherit ROOM;

void create() {
  set("short", "南市");
  set("long", @LONG
这里是“洛阳三市”之一的南市，由于这里主要是买卖花卉的地方，所以又
叫做花市。洛阳的花卉天下闻名，洛阳城里有钱的姑娘们太太们都喜欢亲自到这
里来挑选花卉，这里也有远方来的客人们到此买花，他们把花带给心中思念的情
人。你要是运气好的话，还有可能买到一些传说中的珍奇花卉。花市的东北有一
片竹林，竹林中隐约有座青竹搭成的屋子，从那里传来朗郎的读书声，向东就是
出洛阳的建春门了。
LONG
  );
  set("exits", ([
    "west": __DIR__ "tongtuo_jie1",
    "east": __DIR__ "jianchun_men",
    "northeast": __DIR__ "bailu_shuyuan",
  ]));
  set("objects", ([
    //           __DIR__"npc/maihuaguniang": 1,
    __DIR__ "npc/shaofu": 1
  ]));
  set("outdoors", "luoyang");
  setup();
  replace_program(ROOM);
}
