#include <room.h>

inherit ROOM;

void create() {
  set("short", "长夏门");
  set("long", @LONG
这里是洛阳城的南门。城门洞上方写着“长夏门”三个大字，城门两侧贴着
官府的告示。门口很热闹，来来往往的行人很多，磨肩擦踵。向南是一条通往城
外的青石官道。向北就走进热闹的洛阳城。
LONG
  );
  set("exits", ([
    "north": __DIR__ "tongtuo_jie2",
    "south": __DIR__ "guandao",
  ]));
  set("objects", ([
    __DIR__ "npc/wujiang": 1,
    __DIR__ "npc/guanbing": 2
  ]));
  set("outdoors", "luoyang");
  setup();
}
