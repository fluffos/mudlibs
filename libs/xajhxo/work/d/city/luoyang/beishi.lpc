// rooms:/d/luoyang/beishi.c

#include <room.h>

inherit ROOM;

void create() {
  set("short", "北市");
  set("long", @LONG
这里是“洛阳三市”之一的北市，热闹非凡，叫卖声不绝于耳。南来北往的
商人们大多在此进行交易，是洛阳城的主要商业活动地区。路西有一家生意兴隆
的客店，来洛阳的旅客大多到那里落脚。路东是一座宏伟的寺院，进进出出烧香
拜佛的人络绎不绝。南边有一条缓缓流过的河流——洛河。西南是洛河桥。北边
就是出洛阳城的北门了。
LONG
  );
  set("exits", ([
    "west": __DIR__ "kedian",
    "east": __DIR__ "baima_simen",
    "north": __DIR__ "anxi_men",
    "southwest": __DIR__ "luohe_qiao",
  ]));
  set("objects", ([
    __DIR__ "npc/shangren": 2
  ]));
  set("outdoors", "luoyang");
  setup();
}
