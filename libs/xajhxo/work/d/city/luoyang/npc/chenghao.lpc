//NPC:/d/city/luoyang/npc 白鹿书院之主 edit by Happyman Mar.25.97
inherit NPC;
void create() {
  set_name("程颢", ({ "cheng hao", "cheng" }));
  set("title", "老先生");
  set("gender", "男性");
  set("age", 60);
  set("long", "程老先生是当世大儒，你要有什么问题可以请教他。\n");
  set("attitude", "friendly");
  set("combat_exp", 1000000);
  set("social_exp", 1000000);
  set("max_force", 2000);
  set("force", 2000);
  set("force_factor", 100);
  set_wugong("unarmed", 200, 200, 1);
  //        set_skill("literate",200);
  setup();
  carry_object(__DIR__ "obj/cloth1")->wear();
}
