inherit NPC;
void create() {
  set_name("校尉", ({ "xiao wei", "wei" }));
  set("age", 30);
  set("title", "禁军");
  set("gender", "男性");
  set("long", "他是一名校尉军官，负责城防巡查等事。\n");
  set("str", 40);
  set("per", 25);
  set("combat_exp", 100000);
  set_wugong("staff", 120, 140, 1);
  set_wugong("dodge", 100, 100, 1);
  set_wugong("taizu-quan", 100, 100, 1);

  set("chat_chance_combat", 10);
  set("chat_msg_combat", ({
    "校尉喝道：来人！快把这个反贼拿下！\n",

  }));
  setup();
  carry_object(__DIR__ "obj/wolfstick")->wield();
  carry_object(__DIR__ "obj/junfu")->wear();
  carry_object(__DIR__ "obj/kaijia1")->wear();
  carry_object(__DIR__ "obj/toukui1")->wear();
  carry_object(__DIR__ "obj/zhan_pao")->wear();
  carry_object(__DIR__ "obj/yaopai")->wear();
  carry_object(__DIR__ "obj/wuyun_xue")->wear();
}
int accept_fight(object me) {
  command("say 我看你今天是活得不耐烦了," + RANK_D->query_rude(me) + ",去死吧！\n");
  me->apply_condition("killer", 1000);
  kill_ob(me);
  return 1;
}
