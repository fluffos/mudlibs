// rooms:/d/luoyang/kedian.c

#include <room.h>

inherit ROOM;

void create() {
  set("short", "悦来客店");
  set("long", @LONG
门口立着一块招牌，上面写着四个大字——悦来客店。听说这是一家老字号
的客栈，店主是一位远方来的富商，南来北往的旅客大多在此住宿。你一走进这
里，就有殷勤的伙计上来招呼。客店进进出出的人很多，鱼龙混杂，中间还夹杂
着面目不善的人，神色诡异，似乎有事可能发生，看来还要小心一些，不要惹祸
上身。
LONG
  );
  set("exits", ([
    "east": __DIR__ "beishi",
  ]));
  set("objects", ([
    __DIR__ "npc/huoji3": 1,
    __DIR__ "npc/lvke": 2
  ]));
  setup();
  replace_program(ROOM);
}
