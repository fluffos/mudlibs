#include <room.h>

inherit ROOM;

void create() {
  set("short", "仙客来酒楼");
  set("long", @LONG
这里是洛阳城里最大的酒楼了，酒楼门口有一块金字大匾，上面写着三个大
字——仙客来。这里虽然叫做仙客来，但来这里的大多是一些有钱的公子哥，传
闻这里的老板是当朝驸马的亲戚，很少有人敢来此造次，所以这里的生意特别好
。楼上的花费更是昂贵，客官您要是钱少的话就不要踏上楼梯了。
LONG
  );
  set("exits", ([
    "east": __DIR__ "tongtuo_jie1",
    "up": __DIR__ "jiulou2",
  ]));
  set("objects", ([
    __DIR__ "npc/huoji2": 1,
    __DIR__ "npc/keren": 2
  ]));
  setup();
}
