#include <room.h>

inherit ROOM;

void create() {
  set("short", "洛河桥");
  set("long", @LONG
这是一座用汉白玉堆砌成的桥，桥面很宽，可以容纳几匹马并行而过。桥上
过往的行人很拥挤，人群中似乎有人神色鬼鬼祟祟，不怀好意的偷偷瞧着别人的
钱袋，看来你要小心一些，小心丢了东西。这座洛河桥连接着洛阳城的城南城北
，是洛阳城的交通要道。洛河水从桥下缓缓流过，桥北是一个热闹的集市，桥南
是一条宽阔的街道。
LONG
  );
  set("exits", ([
    "northeast": __DIR__ "beishi",
    "south": __DIR__ "tongtuo_jie1",
  ]));
  set("objects", ([
    __DIR__ "npc/youke": 2
  ]));
  set("outdoors", "luoyang");
  setup();
}
