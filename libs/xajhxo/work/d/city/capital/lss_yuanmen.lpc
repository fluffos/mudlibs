inherit STREET;
void create()
{
        set("short",HIY "院门" NOR);
        set("long", @LONG
小巧精致的黑漆院门，门上绘着彩凤双鸾，海棠吐蕊的图画；衔门环的兽头
竟然是一对鸳鸯，金灿灿的鸟头上用鸡血石点着双睛，奇异精美之极。门梁上刻
一横匾，曰：“李宅”。左右一幅联子，写着“歌舞神仙女，风流花月魁”。
LONG
        );
        set("objects", ([ 
         ]));
        set("exits", ([  
            "east" : __DIR__"lss_tingyuan",
            
         ]));     
    create_door("east",BLK "黑漆院门" NOR,"west",DOOR_CLOSED);
    set("detail",([
    ]));
    set("outdoors", "capital");
        setup(); 
}
