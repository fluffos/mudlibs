// 汴京城：新郑门  /d/city/capital/xinz_men.c
#include <room.h>
#include <ansi.h>
#include "bianjing.h"
inherit GATE;
void create() {
  set("short", HIW "新郑门" NOR);
  set("long", @LONG
新郑门又叫顺天门，是汴京外城的西门之一。高大的城门之上还有一座三层
高的门楼，总高足有数十丈；城门外有瓮城，共设大门两重，当中是御路。城门
两侧皆是一溜沿着城墙种植的柳树，斜生在护龙河边。城墙外每隔一百步就有一
处兵马战棚。向北沿着城墙一直走可到万胜门。向南则是戴楼门。西南方有一座
酒楼。
LONG
  );
  set("no_clean_up", 0);
  set("outdoors", "capital");
  set("objects", ([
    __DIR__ "npc/gate_shibing": 2,
    __DIR__ "npc/gate_yuhou": 1,
  ]));
  set("exits", ([
    "west": __DIR__ "jinming_chi",
    "north": __DIR__ "wans_men",
    "up": __DIR__ "wangjing_lou",
    "south": __DIR__ "renhe",
    /*
                  "east"  : __DIR__"xinz_dajie1",
                  "southwest" : __DIR__"lianhua_lou",
*/
    "southeast": __DIR__ "dail_men",
  ]));
  set("detail", ([
    "门楼": "门楼上高高地悬着一块大匾，上面写着“望京楼”",
  ]));
  setup();
}
void init() {}
