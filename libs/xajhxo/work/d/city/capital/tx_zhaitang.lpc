#include "bianjing.h"
inherit BROOM;

#include <room.h>
#include <ansi.h>    

void create()
{
    set("short","斋堂");
    set("long", @LONG
太学生员众多，共设立了八十斋，每斋分领三十人；吃住用度，一律有国家
定数供应，虽然钱物不是很多，却也尽够丰衣足食了。据说当年仁宗来太学视察，
正赶上学中吃馒头，仁宗品尝了馒头后满意地说：“用这么好吃的东西来招待他
们，国家对待读书人算是仁至义尽了。”
LONG);
    set("objects", ([            
        __DIR__"npc/chuniang1" : 1,
    ]));
    set("exits", ([   
        "northwest" : __DIR__"tx_zhengtang",
    ]));
    create_door("northwest","小门","southeast");
//    set("detail",([
//    ]));
    setup();
}

