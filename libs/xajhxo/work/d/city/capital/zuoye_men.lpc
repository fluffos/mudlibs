// 汴京  zuoye_men.c
#include <room.h>
#include <ansi.h> 
#include "bianjing.h"
inherit STREET;
void create()
{
        set("short",HIR "左掖门" NOR);
        set("long", @LONG
左掖门外排列中书省，枢密院，学士院等重要的中央机构。门前排着红色的
木杈子，士兵在往来巡逻。南面一道红墙，墙北一溜廊宇，多是百官上朝前休息
的地方；每天早上，内廷中会派太监送出食物给大臣们当早点；夜里，这里还有
出租马匹的人等着送晚归的官员回府。
LONG
        );
        set("objects", ([ 
         ]));
        set("exits", ([    
            "west" : __DIR__"xuande_men",
            "east" : __DIR__"dong_jiaolou",
         ]));
        set("detail",([
        ]));
        set("outdoors", "capital");
        setup();
}

