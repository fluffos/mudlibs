#include <ansi.h>
#include "bianjing.h"
inherit GATE;
void create() {
  set("short", HIW "宣化门" NOR);
  set("long", @LONG
环绕汴京的外城城墙是用从郑州虎牢关取来的土筑成，城墙多曲折，顺着地
势而走，形似卧牛。城外每隔百步即建一军哨，屯驻数十骑禁军官兵，沿着护城
河两岸是一带柳树临水，风景怡然。
LONG
  );
  set("outdoors", "capital");
  set("objects", ([
    __DIR__ "npc/gate_shibing": 2,
  ]));
  set("exits", ([
    "northeast": "/d/city/matou/bianhe_matou",
    "west": __DIR__ "nanx_men",
  ]));
  set("detail", ([
  ]));
  setup();
}
void init() {}
