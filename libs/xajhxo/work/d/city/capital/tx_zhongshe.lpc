inherit BROOM;

#include <room.h>
#include <ansi.h>    

void create()
{
    set("short",YEL"中舍馆"NOR);
    set("long", @LONG
太学于国初时立，当时只有几十间小房，二百生员不到，当真是穷酸得可以。
仁宗庆历年间才改建扩充，分为上，中，下三舍，下舍上千人，招各州县中读书
人以及官员子弟；中舍三百人，从下舍中选拔；再选则至上舍，止以百人为限。
上舍生中成绩优良的，就可以直接授官了。
    屋子靠北一张大案，案后是学喻先生；身后几个大柜子，摆满了古书。
LONG);
    set("objects",([
        __DIR__"npc/qin_guan" : 1,
    ]));
    set("exits", ([ 
        "west"      : __DIR__"tx_zhengtang", 
    ]));
