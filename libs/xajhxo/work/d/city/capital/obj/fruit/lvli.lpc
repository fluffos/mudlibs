// 汴京 FRUITs:    jin_tao.c
#include <ansi.h>
inherit ITEM;
inherit F_FRUIT;
void create() {
  set_name(GRN "绿李" NOR, ({ "lv li", "li", "fruit" }));
  set_weight(20);
  set("long", "一个绿油油的李子，你敢吃嘛？");
  set("unit", "个");
  set("value", 1);
  set("fruit_remaining", 2);  //可以吃5口
  set("food_supply", 1);   //每口加10的food
  set("water_supply", 15);  //每口可以加10的water
  set("eat_msg", "$N拿起$n，咬了一口--好酸耶#@%#$%#$@%@^#%^@%$#%@$!@$#$%#@%@!!!!!!\n");
  set("core", "李子核");     //name
  set("core_id", ({ "lizi hu", "core" }));  //id
  set("core_unit", "个");    //unit
  set("core_long", "一个李子核。\n");  //long
  set("gifts", ([
    "spi": 1,
  ]));
  setup();
}
void init() {
  add_action("do_eat", "eat");
}
