//汴京 FRUITs :  balanzi.c

inherit ITEM;
inherit F_FRUIT;

#include <ansi.h>

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name(WHT "巴览子" NOR, ({ "ba lan zi", "zi", "fruit" }));
  set_weight(300);
  set("long", @LONG 
    巴览子产于川西，树象樱桃树，果实象杏核一样，白白的又扁又长。
LONG);
  set("unit", "个");
  set("value", 100);
  set("fruit_remaining", 5);
  set("food_supply", 10);
  set("water_supply", 10);
  set("eat_msg", "$N拿起一个$n，小心地放进嘴里－－嗯，味道还真不错呀！\n");
  set("end_msg", "$N仔细的啃完了最后一个$n。\n");
  set("over_msg", "吃这么多？小心撑破肚皮！！！！\n");
  set("gifts", ([
  ]));
  set("core", MAG "巴览子核" NOR);
  set("core_id", ({ "guo he", "he", "core" }));
  set("core_unit", "个");
  set("core_long", "一个巴览子的果核。\n");

  setup();
}
