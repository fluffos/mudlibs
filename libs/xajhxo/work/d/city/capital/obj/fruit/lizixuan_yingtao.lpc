// 汴京 FRUITs:    lizixuan_yingtao.c
#include <ansi.h>
inherit ITEM;
inherit F_FRUIT;
void create() {
  set_name(RED "李子旋樱桃" NOR, ({ "lizixuan yingtao", "yingtao", "fruit" }));
  set_weight(10);
  set("long", @LONG
    红彤彤的一个小樱桃。
LONG);
  set("unit", "个");
  set("value", 1);
  set("fruit_remaining", 1);
  set("food_supply", 1);
  set("water_supply", 10);
  set("end_msg", "$N揪着$n的长柄，仰头放进嘴里......\n");
  set("gifts", ([
    "per": 1,
  ]));
  set("core", "樱桃核");     //name
  set("core_id", ({ "yingtao he", "he", "core" }));  //id

  setup();
}
void init() {
  add_action("do_eat", "eat");
}
