//汴京 FRUITs :     heyin_shiliu.c

inherit ITEM;
inherit F_FRUIT;

#include <ansi.h>

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name(YEL "河阴" RED "石榴" NOR, ({ "heyin shiliu", "shiliu", "fruit" }));
  set_weight(150);
  set("long", @LONG   
    一个好大个儿的石榴，是从西北州县运来的，一边通红，另一半金黄，
  裂开的口子里露出一颗颗粉里透红的石榴子。
LONG);
  set("unit", "个");
  set("value", 5);
  set("fruit_remaining", 3);
  set("food_supply", 7);
  set("water_supply", 17);
  set("eat_msg", "$N拿起$n，大大的啃了一口，然后美美地将一个个石榴子吐出来。\n");
  set("end_msg", "$N仔细的啃完了这个$n。\n");
  set("gifts", ([
    "int": 1,
  ]));
  setup();
}
