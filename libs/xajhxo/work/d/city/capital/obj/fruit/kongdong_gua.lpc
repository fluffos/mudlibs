// 汴京 FRUITs:    longya_lizhi.c
#include <ansi.h>
inherit ITEM;
inherit F_FRUIT;
void create() {
  set_name(GRN "崆峒瓜" NOR, ({ "kongdong gua", "gua", "fruit" }));
  set_weight(500);
  set("long", "一个从崆峒山运来的瓜，好大的个儿。");
  set("unit", "个");
  set("value", 20);
  set("fruit_remaining", 8);  //可以吃5口
  set("food_supply", 10);   //每口加10的food
  set("water_supply", 15);  //每口可以加10的water
  set("end_msg", "$N仔细的啃完了$n。(您吐子儿了么？)\n");
  set("gifts", ([
    "per": 1,
    "spi": 2,
  ]));
  setup();
}
void init() {
  add_action("do_eat", "eat");
}
