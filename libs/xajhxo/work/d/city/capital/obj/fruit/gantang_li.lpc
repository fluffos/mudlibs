//汴京 FRUITs : gantang_li.c

inherit ITEM;
inherit F_FRUIT;

#include <ansi.h>

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIR "甘棠梨" NOR, ({ "gantang li", "li", "fruit" }));
  set_weight(140);
  set("long", @LONG
    一个香喷喷的大梨，皮黄里透红。
LONG);
  set("unit", "个");
  set("value", 6);

  set("gifts", ([
    "per": 2,
  ]));
  set("fruit_remaining", 4);
  set("food_supply", 7);
  set("water_supply", 20);
  set("eat_msg", "$N拿起$n，大大的啃了一口。\n");
  set("core", YEL "梨核" NOR);
  set("core_id", ({ "li hu", "hu", "core" }));
  set("core_unit", "个");
  set("core_long", "一个梨核。\n");

  setup();
}
