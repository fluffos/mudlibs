//汴京 FOODs:    geli.c

inherit ITEM;
inherit F_FOOD;

#include <ansi.h>

void create() {
  set_name("蛤蛎", ({ "ge li", "geli", "ge", "food" }));
  set_weight(500);
  set("long", @LONG   
    一盒从水里捞上来的蛤蛎，等着你吃。
LONG);
  set("unit", "盒");
  set("value", 11);
  set("over_value", 0);
  set("food_remaining", 4);
  set("food_supply", 40);
  set("eat_msg", "$N一个大个儿的$n吃了下去。.\n");
  set("end_msg", "$N将剩下的$n吃的干干净净.\n");
}
int eat_effect(object me, object this) {
  if (me->query("water") > 0)
    me->add("water", -2);
  return 0;
}
int finish_eat(object me, object this) {
  this->set_name(HIM "匣盒" NOR, ({ "xia he", "he", "box" }));
  this->set("long", @LONG
    一个梅红色的匣盒似乎是京城里小贩们专门用来盛食物的那种。
LONG);
  this->set("unit", "个");
  this->set("value", 1);
  this->set_weight(40);
  return 1;
}
