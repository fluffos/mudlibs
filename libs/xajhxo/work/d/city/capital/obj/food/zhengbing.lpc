//汴京 FOODs:   zhengbing.c

inherit ITEM;
inherit F_FOOD;

#include <ansi.h>

void create() {
  set_name("蒸饼", ({ "zheng bing", "bing", "food" }));
  set_weight(200);
  set("long", @LONG   
    一个大大的蒸饼( 就是馒头 )。
LONG);
  set("unit", "个");
  set("value", 2);
  set("over_value", 0);
  set("food_remaining", 3);
  set("gifts", ([
    "per": -2,
    "str": -1,
    "int": -1,
    "spi": -1,
    "dex": -1,
  ]));
  set("food_supply", 30);
  set("eat_msg", "$N拿起$n咬了一口.\n");
  set("end_msg", "$N将剩下的$n吃的干干净净.\n");
}
int eat_effect(object me, object this) {
  if (me->query("water") > 0)
    me->add("water", -1);
  return 0;
}
