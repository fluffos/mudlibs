//汴京 FOODs:     mafujipi.c

inherit ITEM;
inherit F_FOOD;

#include <ansi.h>

void create() {
  set_name(HIY "麻腐鸡皮" NOR, ({ "ma fu ji pi", "jipi", "ji pi", "pi", "ji", "food" }));
  set_weight(400);
  set("long", @LONG   
    这是一道很受欢迎的冷吃，每年夏天，朱雀门内外的集市上经常可以看见卖
  这种凉菜的小贩。炸的焦焦的鸡皮，用冰镇的凉凉的，再浇上麻辣汁，叫人口
  水四溢。
LONG);
  set("unit", "匣");
  set("value", 12);
  set("over_value", 0);
  set("food_remaining", 5);
  set("food_supply", 30);
  set("eat_msg", "$N夹起几块$n连着淋淋的麻辣汁一起塞进嘴里。.\n");
  set("end_msg", "$N将剩下的$n吃的干干净净.\n");
  set("over_msg", "别吃太多了，会闹肚子的耶（古时候哪儿有卫生检疫呢？）.\n");
}
int eat_effect(object me, object this) {
  tell_object(me, "你觉得一股冰凉的感觉直透到心窝里，麻辣汁的味道刺得你直想打喷嚏。\n");
  if (me->query("water") < me->max_water_capacity())
    me->add("water", 10);
  return 0;
}
int finish_eat(object me, object this) {
  this->set_name(HIM "匣盒" NOR, ({ "xia he", "he", "box" }));
  this->set("long", @LONG      
    一个梅红色的匣盒似乎是京城里小贩们专门用来盛食物的那种。
LONG);
  this->set("unit", "个");
  this->set("value", 1);
  this->set_weight(40);
  return 1;
}
