//汴京 FOODs:   xiangt_guozi.c

inherit ITEM;
inherit F_FOOD;

#include <ansi.h>

void create() {
  set_name(YEL "香" WHT "糖" MAG "果子" NOR, ({ "xiangtang guozi", "guozi", "guo", "food" }));
  set_weight(350);
  set("long", @LONG
    香糖果子就是用菖蒲，生姜，杏，梅子，李子，紫苏等等切细成丝，
  加盐后暴晒成干而成的。俗称“百草头”.
LONG);
  set("unit", "匣");
  set("value", 20);
  set("food_remaining", 8);
  set("food_supply", 10);
  set("eat_msg", "$N拿起一撮$n放进嘴里.\n");
  set("end_msg", "$N将剩下的$n吃的干干净净.\n");
}
int eat_effect(object me, object this) {
  if (me->query("water") > 0)
    me->add("water", -3);
  return 0;
}
int finish_eat(object me, object this) {
  this->set_name(HIM "匣盒" NOR, ({ "xia he", "he", "box" }));
  this->set("long", @LONG      
    一个梅红色的匣盒似乎是京城里小贩们专门用来盛食物的那种。
LONG);
  this->set("unit", "个");
  this->set("value", 1);
  this->set_weight(40);
  return 1;
}
