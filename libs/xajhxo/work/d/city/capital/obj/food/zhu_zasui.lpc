// 汴京 FOOD：   zhu_zasui.c

inherit ITEM;
inherit F_FOOD;

#include <ansi.h>

void create() {
  set_name("猪杂碎", ({ "zhu zasui", "zasui", "food" }));
  set_weight(500);
  set("long", "一包熟食腰肾杂碎，用油纸包着。\n");
  set("unit", "包");
  set("value", 15);
  set("over_value", 3);
  set("food_remaining", 8);
  set("food_supply", 20);  //正常饭量的人一顿吃二斤。
  set("eat_msg", "$N从纸包里拿出一块$n放进嘴里，兴奋地吃起来\n");
  set("end_msg", "$N将纸包里的最后一块$n吃掉了，觉得有些口渴。\n");
}
int eat_effect(object me, object this) {
  me->add("water", -5);
  return 0;
}
int finish_eat(object me, object this) {
  this->set_name("油皮纸", ({ "youpi zhi", "zhi", "paper" }));
  this->set("long", "一张用来包食物的纸，已经被油浸透了。\n");
  this->set("unit", "张");
  this->set("value", 0);
  this->set_weight(1);
  return 1;
}
