// 汴京 FOOD：    huan_rou.c
#include <weapon.h>
inherit HAMMER;
inherit F_FOOD;
#include <ansi.h>
void create() {
  set_name(YEL "獾肉" NOR, ({ "huan rou", "rou", "meat" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", @LONG
    一大块在炭火上烤得焦黄流油的獾肉，香气四溢，令人垂涎欲滴。
LONG
    );
    set("unit", "块");
    set("value", 150);
    set("over_value", 0);
    set("food_remaining", 4);
    set("food_supply", 75);  //正常饭量的人一顿吃二斤。
    set("gifts", ([
      "str": 5,
      "cor": 3,
    ]));
    init_hammer(5);
    set("material", "bone");
    set("eat_msg", "$N贪婪地将一块$n放进嘴里大嚼起来.\n");
    //                set("end_msg","$N将纸包里的最后一个$n放进嘴里，颇有些舍不得。.\n");
  }
}
int eat_effect(object me, object this) {
  me->add("water", -3);
  return 0;
}
int finish_eat(object me, object this) {
  this->set_name("骨头", ({ "gu tou", "gu", "bone" }));
  this->set("long", "一根动物的大腿骨，上面还残留着些烤熟的肉。\n");
  this->set("unit", "根");
  this->set("value", 0);
  this->set_weight(50);
  this->init_hammer(5);
  this->set("material", "bone");
  return 1;
}
