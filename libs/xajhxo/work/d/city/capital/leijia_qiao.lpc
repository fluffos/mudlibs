inherit STREET;
void create()
{
        set("short","雷家桥");
        set("long", @LONG  
蔡河城内一段共有十余座桥，形态各异，款式多样。雷家桥地处新门外，南
边是著名的武成王庙，朝廷每岁及用兵时皆来祭祀。西边是一大片里坊，民舍俨
然，沿蔡河向西，一路上渐渐地落入市井，身边不免肮脏起来。
LONG
        );
        set("objects", ([ 
        __DIR__"npc/polan" : 1,  
    ]));
        set("exits", ([  
            "east" : __DIR__"longjin_qiao",
            "southwest" : __DIR__"caihe1",
             "south" : __DIR__"wucheng_miao",
    ]));
    set("detail",([
    ]));
        setup();
}

