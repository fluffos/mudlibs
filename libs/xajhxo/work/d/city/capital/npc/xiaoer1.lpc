// 汴京NPCs:   xiaoer1.c
 
inherit NPC;
inherit F_VENDOR;

#include <ansi.h>
#include "bianjing.h"     

void create()
{
    set_name(comm_man_name(), ({ "xiao er","waiter"}) );
    set("gender", "男性" );
    set("age",20+ random(10) );
    set_hp("gin", 200);
    set_hp("kee", 400);
    set_hp("sen", 500);
    set("title","店小二");
    set("attitude", "friendly");
    set("vendor_goods", ([  
        "山洞梅花包子" : BIANJING_FOOD "meihua_baozi",
        "羊肉包子"     : BIANJING_FOOD "yangrou_baozi",
        "羊肉蒸饼"     : BIANJING_FOOD "yangrou_zhengbing",
        "鳝鱼包子"     : BIANJING_FOOD "shanyu_baozi",
        "水饭"         : BIANJING_FOOD "shuifan",
    ]) );
    set("positive_score", 100);
    set("combat_exp", 1000);
    set("social_exp", 400);
    set_wugong( "taizu-quan" , 40 , 40, 1);
    set_xiuwei_by_type( "unarmed",130 );
    setup();
    carry_object(CLOTH_DIR "mancloth1" )->wear();

}
void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");
}
void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        message_vision("店小二迎着$N跑上来：“客官，来点儿什么？”\n",ob);
}

