// 汴京   /d/city/capital/yiqiu_men.c
#include <room.h>
#include <ansi.h>
inherit ROOM;
void create() {
  set("short", HIW "宜秋门" NOR);
  set("long", @LONG
东京城共有三重城墙，最内为大内皇城，次为唐朝宣武节度使李勉于德宗建
中二年修建的汴州城，现在俗称“内城”，最外是新筑的外城，又称罗城。进得
宜秋门来，便是内城；街道略显狭窄，两侧却更加繁华，酒铺餐馆皆临街设棚，
摆放桌椅供人休息，连城门楼上也有酒店开张，热闹非凡。
LONG
  );
  set("objects", ([
  ]));
  set("exits", ([
    "west": __DIR__ "xinz_dajie1",
    "north": __DIR__ "jiucheng_qianggen",
    "east": __DIR__ "chengqing_jie1",
  ]));
  set("detail", ([
  ]));
  set("outdoors", "capital");
  setup();
}
