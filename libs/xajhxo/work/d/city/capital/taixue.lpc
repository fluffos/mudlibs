#include "bianjing.h"
inherit STREET;

#include <room.h>
#include <ansi.h>    

void create()
{
    set("short","太学巷");
    set("long", @LONG
太学旧地，就是本国初赐给吴越王的礼贤宅。后来改为原来的太学为国子监，
并扩充太学生至两千人，只好将吴越王宅的一部分拆除，另盖了上千间房子，分
为上中下三舍，分别设博士官教授经义古文，还有法律，书法，绘画等门类。太
学生入仕，就成为科举之外读书人发达的又一条途径。
LONG);
    set("exits", ([ 
        "south"     : __DIR__"huimin_nanju",
        "west"      : __DIR__"yujie6", 
        "north"     : __DIR__"tx_zhengtang",
    ]));
    create_door("north","太学大门","south",DOOR_CLOSED);
//    set("detail",([
//    ]));
    setup();
}
