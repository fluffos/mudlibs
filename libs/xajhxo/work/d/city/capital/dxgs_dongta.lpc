inherit SROOM;
void create() {
  set("short", HIY "普满塔" NOR);
  set("long", @LONG
普满塔俗称东塔，在相国寺三门之前，与西边的广愿塔相对。均是大唐天宝
年间建造的。风格古朴明快，带有天竺特色。塔身上面雕有各种如来，观音，罗
汉，力士的形象，塔中供奉着佛龛，四周满是信徒贡献的手抄经文。
LONG);
  set("exits", ([
    "east": __DIR__ "dxgs_donglang2",
    "west": __DIR__ "dxgs_dayuan1",
  ]));
  set("detail", ([
  ]));
  set("objects", ([
  ]));
  setup();
}
