inherit ROOM;

#include "men.h"

void create() {
  set("short", "北门");
  set("long", @LONG
兰州城是大宋西北边防要塞，城高三丈有余，用黄土调糯米汁夯成，雄伟坚
固，城外还有深一丈宽数丈的护城河和高塔了望台。城门楼有三层，顶层挂着一
块金字横匾，两边悬挂两排巨大的灯笼。城门洞正面一块有白底石匾，上书“兰
州”两个大字。几名全副武装的士兵站在高高悬起的千斤闸下，盘查过往行人。
LONG
  );
  set("outdoors", "lanzhou");
  set("item_desc", ([
    "匾": "匾上写着“固若金汤”四个大字，"
    + "据说是经略使范仲淹的手笔。\n",
    "横匾": "匾上写着“固若金汤”四个大字，"
    + "据说是经略使范仲淹的手笔。\n",
    "bian": "匾上写着“固若金汤”四个大字，"
    + "据说是经略使范仲淹的手笔。\n",
    "sign": "匾上写着“固若金汤”四个大字，"
    + "据说是经略使范仲淹的手笔。\n",
    "榜文": (: look_bangwen :),
    "bang wen": (: look_bangwen :),
    "bangwen": (: look_bangwen :),
  ]));
  set("exits", ([
    "north": __DIR__ "chengwai",    //兰州城外
    "south": __DIR__ "beijie",      //兰州北街
  ]));
  set("objects", ([
    __DIR__ "npc/shibing": 2,      //士兵
    __DIR__ "npc/xiaowei": 1,      //将虞侯
  ]));

  setup();
}

void welcome_visitor(object ppl) {
  int hour = query_shichen() * 2;
  object here = this_object();

  if (hour < 5                           //当地时间在晨五点以前，在晚七时以
  || hour > 19)                      //后关闭城门。
  {
    if (query("exits/north"))       //如果此刻城门是开放状态的话，
    {
      delete("exits/north");        //关闭城门。
      tell_room(here, "城门关了。\n");
      return;
    }
    tell_room(here, "城门正关着。\n");
    return;
  }
  if (!query("exits/north"))            //在晨五时到晚七时的时间开放城门。
  {
    set("exits/north", __DIR__ "chengwai");        //通向城外的出口
    tell_room(here, "城门开了。\n");
    return;
  }
  tell_room(here, "城门正开着。\n");
}
