inherit ROOM;

void create() {
  set("short", "东广场");
  set("long", @LONG
这里东面是兰州府衙，门口站着几名衙役，北边是军队驻扎的营盘，南面是
官军的马厩，因为三面都被官府占着，路上的行人小贩都很少，偶尔有几名骑兵
从北面的军营里飞奔而出，路上的人见了都赶紧躲到路边上。
    西面是城市的中心广场,人来人往很是喧闹。
LONG
  );
  set("outdoors", "lanzhou");
  set("exits", ([
    "north": __DIR__ "bingying_men",          //兰州兵营大门  
    "south": __DIR__ "majiu",                 //兰州马厩
    "east": __DIR__ "zhoufu_men",            //兰州州府大门
    "west": __DIR__ "guangchang",            //中心广场
  ]));

  setup();
}
