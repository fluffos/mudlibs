inherit SMITHSHOP;

int eventKickDoor(object who, object nouse, string arg) {
  if (!arg || arg != "door")
    return 0;
  message_vision("$N对着大门狠狠地踹了几脚。\n", who);
  return 1;
}

void create() {
  set("short", " 打铁铺子");
  set("long", @LONG
朝廷为了供应驻边官军的盔甲，兵刃，于是征集内地，当地的铁匠，在此组
织铁工坊，打造军具，后来一个老铁匠役满后不愿还乡，就在这里收徒开了间铁
匠铺，打些镰刀斧头刀剪等物，也为来往的江湖人士打造兵器。铺子后面是工坊，
里面传出“叮叮当当”的打铁声，墙上挂着打好的刀剑，斧头等物。
    外面是热闹的南大街。
LONG
  );
  set("exits", ([
    "west": __DIR__ "nanjie2",   //南大街
  ]));
  set("objects", ([
    __DIR__ "npc/blacksmith": 1,      //张铁匠
  ]));
  set("EnvEffect", ([
    "kick": ([
      "int_level": 5,
      "funcname": (: eventKickDoor :),
    ]),
  ]));

  setup();
}
