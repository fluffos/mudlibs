//  便条：兰州解谜用    /d/city/lanzhou/npc/object/biantiao.c
//  By lin
//  Changed by lala, 1998-03-16

#include <ansi.h>

inherit ITEM;

void create() {
  set_name("便条", ({ "bian tiao", "biantiao", "tiao", "piece" }));
  set_weight(5);                        //一钱；
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("long", "这是一张家常用的黄浆薄纸，上面写着：\n"
      HIW @TEXT
            王老爹：
                妾闻友人遭难，身受重伤，急需玉灵
            散。望老爹看在秦总镖头面上，助我救人。
            妾感激不尽。    
                                    湘玉上
TEXT
      NOR + "纸上还带着些香气。\n");
    set("material", "paper");         //质地：纸（无价值）
  }
}
