//  七星碧玉刀：夜猫子之物，解迷的报偿。    /d/city/lanzhou/npc/obj/7-blade.c
//  By lin on March 3,  97
//  Changed by lala, 1998-03-16

#include <weapon.h>
#include <armor.h>
#include <ansi.h>

inherit BLADE;

void create() {
  set_name(CYN "七星碧玉刀" NOR,
    ({ "qixing dao", "qixingdao", "dao", "sevenstar blade", "blade" }));
  set_weight(5000);                     //十市斤；
  set("long", "一把寒气逼人的精钢宝刀，刀面上镶着七块碧绿的"
    +GRN "翡翠" NOR + "。\n");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 5250);               //价格：(45*100)攻击力的价值
    //  +150*5钢的价值=5250兵器的价值；
    set("material", "steel");         //质地：钢（单价１５０文／千克）；
  }
  init_blade(45);                       //攻击力：+45。

  set("wield_msg", "$N「唰」的一声抽出一把明晃晃的$n握在手中。\n");
  set("unwield_msg", "$N将手中的$n插入腰间的刀鞘。\n");

  setup();
}
