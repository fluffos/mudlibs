//  狐狸皮：猎户出售物，完成任务用。    /d/city/lanzhou/npc/obj/foxcloth.c

#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create() {
  set_name(YEL "狐狸皮" NOR, ({ "huli pi", "hulipi", "pi", "cloth" }));
  set_weight(1500);                     //三市斤；
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("long", "金黄色的狐狸皮，又漂亮又保暖。\n");
    set("value", 1750);               //价格：(10*100)防御力价格
    //+(500*1.5)皮革价格=1750总价格；
    set("material", "leather");       //质地：皮革（单价５００文／千克）
    set("armor_prop/armor", 10);      //防御力：+10。
  }
  setup();
}
