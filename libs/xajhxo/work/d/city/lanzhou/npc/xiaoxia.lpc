//  小霞：买药  /d/city/lanzhou/npc/xiaoxia.c
//  等级：
//  【丁等】大门派的三级师傅、中等门派的二级师傅、小门派的一级师傅
//  ★★☆
//  〖三级〗二级修为（  ４５１－  ６００）三级武功（  ６０－１００）
//          经验（      ６万－１２、５万）声望（       ６００－    １２５０）
//          内力（  ６００－      ９００）体能、生命（   ３５０－    ４２５）
//  By lin
//  Changed by lala, 1998-03-29

inherit NPC;
inherit F_VENDOR;

string DoChat();

void create() {
  set_name("小霞", ({ "xiao xia", "xia", "xiaoxia", "girl" }));
  set("title", "民女");
  set("gender", "女性");               //性别：女
  set("age", 17);                       //年龄：17
  set("per", 20);                       //容貌：20
  set("attitude", "friendly");          //态度：友善
  set("positive_score", 600);           //正声望：600
  set("long", @LONG
    小霞是王老汉的孙女，自幼丧了父母，跟随祖父来到兰州开业行医，平时帮
忙卖卖药材。她生性活泼，长得清秀可爱，很是招人喜欢。
LONG
  );

  set_wugong("unarmed", 100, 100, 0);    //基本拳法：    一级
  set_wugong("taizu-quan", 90, 90, 0);    //太祖长拳：    二级
  set_wugong("tiesha-zhang", 60, 60, 1);    //铁砂掌：      三级

  set_wugong("qinggong", 100, 100, 0);    //基本轻功：    一级
  set_wugong("feiyan-zoubi", 180, 180, 0);    //飞檐走壁之术：二级
  set_wugong("feiyan-gong", 50, 50, 1);    //飞燕功：      三级      

  set_xiuwei_by_type("unarmed", 450);  //拳脚修为：    二级
  set_xiuwei_by_type("dodge", 400);  //轻功修为：    二级

  set("combat_exp", 60000);            //战斗经验：60000

  set("max_force", 800);              //内力：    800
  set("force", 800);
  set("force_factor", 40);              //加力：    40(5%)

  set_hp("kee", 400);              //生命、体能：  400
  set_hp("sen", 400);

  set("chat_chance", 5);
  set("chat_msg", ({
    (: DoChat :),
  }));
  set("vendor_goods", ([
    "金创药": __DIR__ "obj/jinchuang_yao",
    "何首乌": __DIR__ "obj/shou_wu",
  ]));

  setup();

  carry_object(WRISTS_DIR + "yu_zhuozi")->wear();
  carry_object(HEAD_DIR + "yin_zanzi")->wear();
  carry_object(CLOTH_DIR + "nenlv_choushan")->wear();
  carry_object(BOOTS_DIR + "zihua_xie")->wear();

  add_money("coin", 20);
}

void init() {
  object ppl;

  ::init();

  add_action("do_vendor_list", "list");

  if (!userp(ppl = this_player())
    || !can_act())
    return;
  remove_call_out("Greeting");
  call_out("Greeting", 1, ppl);
}

void Greeting(object ppl) {
  object wang;
  if (!ppl
    || environment(ppl) != environment())
    return;

  if (wang = present("wang junxiao", environment()))  //王太医活着
  {
    message_vision("王小霞笑嘻嘻地迎上前来：“您买什么？”\n", ppl);
    return;
  }
  if (ppl->query_marks("lin/kill_wang"))          //王太医死了，而且玩家是
  {                                                   //凶手
    message_vision("小霞和$N仇人想见，分外眼红，大叫着"
      + "：“还我爷爷的性命来！”\n", ppl);
    add("bellicosity", 100);          //增加杀气：100
    kill_ob(ppl);
    ppl->fight_ob(this_object());
    return;
  }                                       //王太医死了，玩家不是凶手
  message_vision("小霞用手背擦了擦眼睛，哽咽着问道：“客官想买什么？”\n", ppl);
}

string DoChat() {
  if (present("wang junxiao", environment()))
    return "小霞笑嘻嘻地吃着手中的小枣，边吃边和伙计说话儿。\n";
  return "小霞眼睛红红地，不住地用手擦眼泪。\n";
}
