//  洪镖头：龙门镖局镖师    /d/city/lanzhou/npc/guard3.c
//  等级：
//  【丁等】大门派的三级师傅、中等门派的二级师傅、小门派的一级师傅
//  ★★★☆
//  〖一级〗三级修为（  ９０１－１１００）四级武功（  ８０－１１０）
//          经验（    ２５万－    ５０万）声望（    ２５００－    ５０００）
//          内力（  １２００－  １８００）体能、生命（  ５００－    ７５０）
//  By Lin
//  Changed Lala, 1998-03-25

inherit NPC;

void create() {
  set_name("洪镖头",
    ({ "hong biaotou", "hongbiaotou", "biaotou", "hong", "guard" }));
  set("title", "龙门镖局镖师");
  set("gender", "男性");                //性别：男
  set("age", 50);                       //年龄：50
  set("per", 20);                       //容貌：20
  set("str", 30);                       //臂力：30
  set("cor", 30);                       //胆识：30
  set("positive_score", 5000);          //正声望：5000
  set("long", @LONG
    洪镖头擅长拳脚，精通暗器，是镖局里的第二号人物。
LONG
  );

  set_wugong("unarmed", 130, 130, 0);    //基本拳法：    一级
  set_wugong("qinglong-zhua", 120, 120, 0);    //青龙十三抓：  二级
  set_wugong("tiesha-zhang", 120, 120, 1);    //铁砂掌：      三级
  set_wugong("yuanyang-tui", 110, 110, 1);    //鸳鸯连环腿：  四级

  set_wugong("qinggong", 150, 150, 0);    //基本轻功：    一级
  set_wugong("feiyan-zoubi", 120, 120, 1);    //飞檐走壁之术：二级
  set_wugong("shenxing", 100, 100, 1);    //神行百变：    三级

  set_xiuwei_by_type("unarmed", 1100);  //拳脚修为：    三级
  set_xiuwei_by_type("dodge", 1100);  //轻功修为：    三级

  set("max_force", 1800);             //内力：    1800
  set("force", 1800);
  set("force_factor", 90);             //加力：    90(5%)

  set_hp("kee", 750);              //生命、体能：  750
  set_hp("sen", 750);

  set("combat_exp", 500000);           //战斗经验：50万
  set("social_exp", 50000);            //江湖阅历：5万

  set("talk_msg", ({
    "“练武之人要能吃苦，吃得了苦才能练成好功夫！”",
    "“咱们总镖头的武功，不是天下第一也差不多。”",
  }));

  setup();

  carry_object(CLOTH_DIR + "cloth4")->wear();       //紫袍子
  carry_object(BOOK_DIR + "tiesha-zhang");          //《铁砂掌谱》
  add_money("silver", 1);               //一两银子二百三十文钱
  add_money("coin", 230);
}
