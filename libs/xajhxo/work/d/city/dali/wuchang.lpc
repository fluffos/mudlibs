#include <room.h>
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "练武场");
  set("long", @LONG
这里就是镇南王府的练武场了，练武场位于王府的东南角，边上有两排大柳
树，角落里是些石担、石锁、石轱辘。靠墙是一排木人，边上一排兵器架，王府
卫士们平时就在这里练功，地上踩了不少深深的脚印。东北有一排卫士们住的平
房，东面有间大屋，西南就是王府边门，西北是条小巷。
LONG
  );
  set("exits", ([
    "southwest": __DIR__ "bianmen",
    "east": __DIR__ "dawu",
    "northeast": __DIR__ "weishi_ying",
    "northwest": __DIR__ "xiaoxiang",
  ]));

  setup();
}
