// tearoom.c

#include <room.h>

inherit ROOM;

void create() {
  set("short", "鼎泰茶庄");
  set("long", @LONG
这里是大理最大的一家茶庄，全国各地都有分号。大理的茶叶向来闻名于西南，鼎
泰茶庄靠了这个地利，生意越做越兴隆，每天都有很多远道而来的茶商在这里采购大量
的茶叶。茶庄的伙计忙碌地跑来跑去，四处招呼客人。茶庄铺子的顶头上挂着一面金字
大匾，正是「鼎泰茶庄」四字，笔锋矍劲，听说是本地知州所作。
LONG
  );
  set("exits", ([
    "west": __DIR__ "chachang",
    "east": __DIR__ "guangchang",

  ]));
  set("objects", ([
    __DIR__ "npc/huoji": 1,
  ]));

  create_door("west", "木雕门", "east", DOOR_CLOSED);
  setup();
  replace_program(ROOM);
}
