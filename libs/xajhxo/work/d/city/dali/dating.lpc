#include <room.h>
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "王府大厅");
  set("long", @LONG
这里就是镇南王府的大厅了，厅堂高大，气势非凡，放眼望去，只见正中一
块横匾，写着“邦国柱石”四个大字，下首署着“丁卯御笔”四个小字。楹柱中
堂悬满了字画，你一时也看不了许多，况且好多字你根本不认识。中间上首是两
张缅甸红木制成的太师椅，当中一张大理石面的八仙桌，下首两边是八张椅子。
几个管事家丁和丫鬟在旁肃立，整个大厅鸦雀无声。
LONG
  );
  set("exits", ([
    "south": __DIR__ "wangfu_dayuan",
    "east": __DIR__ "donglang",
    "west": __DIR__ "xilang",
  ]));

  setup();
}
