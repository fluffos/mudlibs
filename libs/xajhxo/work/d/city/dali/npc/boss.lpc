inherit NPC;
inherit F_VENDOR;
void create() {
  set_name("阿后", ({ "a hou", "boss" }));
  set("title", "兵器店老板");
  set("gender", "男性");
  set("combat_exp", 100000);
  set("max_kee", 400);
  set("max_sen", 300);
  set_wugong("liuyun-jian", 100, 100, 1);
  set_wugong("luofeng", 100, 100, 1);
  set_xiuwei("dodge", 1000);
  set_xiuwei("sword", 1200);
  set_xiuwei("unarmed", 500);
  set("attitude", "friendly");
  set("env/attack", 78);

  set("vendor_goods", ([
    "朴刀": __DIR__ "obj/blade",
    //        "狼牙棒": __DIR__"obj/wolfstick",
    "铁剑": __DIR__ "obj/jian1",
    "柴刀": __DIR__ "obj/chaidao",
    "牛皮盾": __DIR__ "obj/shield",
    "护心甲": __DIR__ "obj/kaijia",
  ]));
  setup();
  carry_object(__DIR__ "obj/cloth1")->wear();
  carry_object(__DIR__ "obj/yuchang")->wield();
}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !this_object()->can_act()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
}
void greeting(object ob) {
  say("阿后笑容满面地对你说：“这位" + RANK_D->query_respect(ob) + "想买点"
    "什么趁手的兵器呀？\n");
}
