// guanshi.c

inherit NPC;

void create() {
  set_name("茶场管事", ({ "guan shi" }));
  set("gender", "男性");
  set("str", 40);
  set("age", 32);
  set("long", "茶场管事正在茶场里转来转去，监督工人干活。\n");
  set("combat_exp", 500);
  set("attitude", "friendly");
  set_wugong("unarmed", 50);
  set_wugong("jiben-qinggong", 60);
  set_xiuwei("unarmed", 1000);
  set_xiuwei("dodge", 1000);
  setup();
  add_money("coin", 30);
  carry_object(CLONE_DIR + "wear/cloth/cloth3")->wear();
}
