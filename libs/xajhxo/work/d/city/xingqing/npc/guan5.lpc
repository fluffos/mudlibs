#include <ansi.h>

inherit NPC;

void create() {
  set_name(RED "大宋使节" NOR, ({ "shi jie" }));
  set("gender", "男性");
  set("combat_exp", 100000);
  set("max_kee", 400);
  set("max_sen", 300);
  set_xiuwei("dodge", 900);
  set_xiuwei("sword", 900);
  set_xiuwei("unarmed", 900);
  set("attitude", "friendly");
  set("env/attack", 78);
  set("chat_chance", 50);
  set("chat_msg", ({
    "使节很不忿地说:西夏王太过分了，我来了连个接待的人也没有，害的我找不到皇宫了\n",
  }));
  setup();
  carry_object(__DIR__ "obj/cloth3")->wear();
}
