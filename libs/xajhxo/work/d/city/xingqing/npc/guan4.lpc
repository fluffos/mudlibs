#include <ansi.h>
inherit NPC;
inherit F_VENDOR;

void create() {
  set_name(RED "官员" NOR, ({ "guanyuan" }));
  set("title", "大夏绢织院");
  set("gender", "男性");
  set("combat_exp", 100000);
  set("max_kee", 400);
  set("max_sen", 300);
  set_wugong("liuyun-jian", 100, 100, 1);
  set_wugong("luofeng", 100, 100, 1);
  set_xiuwei("dodge", 900);
  set_xiuwei("sword", 900);
  set_xiuwei("unarmed", 900);
  set("attitude", "friendly");
  set("env/attack", 78);

  set("vendor_goods", ([
    "毛毡": __DIR__ "obj/maozhan",
    "白毡": __DIR__ "obj/baizhan",
  ]));

  setup();
  carry_object(__DIR__ "obj/cloth3")->wear();
  carry_object(__DIR__ "obj/jian3")->wield();
}

void init() {
  ::init();
  add_action("do_vendor_list", "list");
}
