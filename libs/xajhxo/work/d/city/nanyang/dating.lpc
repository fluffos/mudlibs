#include <ansi.h>
#include <room.h>
inherit ROOM;
void create() {
  set("short", YEL "大厅" NOR);
  set("long", @LONG
进得大厅来，只见黑漆雕花四扇落地门，地上是发亮的青石尺径方砖。正中
一张大硬木桌，上面架着一尊红铜青金香鼎，几缕香烟缭绕而上。两侧各是一溜
四张大椅子，小高桌上摆着白定茶盅，哥窑花瓶。墙上两个大字，左边是个“忍”
字，右边是一个“武”字，写得飒爽豪迈，气势非凡。
LONG);
  set("exits", ([
    "west": __DIR__ "qianyuan",
    "east": __DIR__ "tianjing",
    "south": __DIR__ "xiangf2",
    "north": __DIR__ "huilang",
  ]));
  set("objects", ([
    __DIR__ "npc/guo": 1,
    __DIR__ "npc/dai": 1,
  ]));
  create_door("south", "木门", "north", DOOR_CLOSED);
  set("valid_startroom", 1);
  setup();
}
int valid_leave(object who, string dir) {
  if (dir != "east") return ::valid_leave(who, dir);
  if (!who->query("family") || who->query("family/family_name") != "伏牛派") {
    if (who->query("age") < 16)
      return ::valid_leave(who, dir);
    if (who->query_temp("lin_marks/暂住"))
      return ::valid_leave(who, dir);
    if (objectp(present("guo yanzhi", this_object())))
      return notify_fail("过彦之拦住了你，说：“后面是家师的居所。”\n");
    if (objectp(present("dai ziqi", this_object())))
      return notify_fail("戴子奇拦住了你，说：“后面是家师的居所。”\n");
    return ::valid_leave(who, dir);
  }
  return ::valid_leave(who, dir);
}
