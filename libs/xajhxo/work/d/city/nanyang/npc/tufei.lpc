// tufei.c
#include <ansi.h>

inherit NPC;

void create() {
  set_name("小土匪", ({ "tu fei", "fei" }));
  set("gender", "男性");
  set("title", GRN "青松寨" NOR);
  set("str", 25);
  set("age", random(10) + 25);
  set("max_force", 500);
  set("force", 400);
  set("force_factor", 20);
  set("max_kee", 400);
  set_wugong("blade", 60, 60, 1);
  set_xiuwei_by_type("blade", 100);
  set("attitude", "aggressive");
  set("combat_exp", 1500);

  setup();
  carry_object(__DIR__ "obj/cloth1")->wear();
  carry_object(BLADE_DIR "blade1")->wield();
}
