//
#include <weapon.h>
#include <ansi.h> 
inherit WHIP;

void create()
{
    set_name(HIY "金龙鞭" NOR, ({ "golden whip","whip" }) );
    set_weight(2000);
    if( clonep() )
        set_default_object(__FILE__);
    else {
        set("long",YEL "一条六尺来长的鞭子，钢丝打就，嵌以金丝，闪闪发亮。\n" NOR);
        set("unit", "条");
        set("value", 2000);
        set("cantsell","这类伤人的武器没有人买，小店不收\n");
        set("material", "steel");
    }
    init_whip(80);

    set("wield_msg", "$N从腰间解下一条$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n束在腰间。\n");

    setup();
}


