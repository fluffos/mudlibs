//tang.c
#include <ansi.h>

inherit NPC;

void create() {
  set_name("汤小泉", ({ "tang xiaoquan", "tang" }));
  set("gender", "男性");
  set("title", GRN "青松寨" RED "二寨主" NOR);
  set("str", 34);
  set("age", 37);
  set("max_kee", 1000);
  set("max_gin", 1000);
  set("max_sen", 1000);
  set("max_force", 1000);
  set("force", 1000);
  set("force_factor", 40);
  set_wugong("taizu-quan", 80, 80, 1);
  set_xiuwei_by_type("unarmed", 400);
  set_wugong("wuhu-dao", 100, 70, 1);
  set_xiuwei_by_type("blade", 500);
  set("attitude", "aggressive");
  set("combat_exp", 18500);

  setup();
  carry_object(__DIR__ "obj/cloth1")->wear();
  carry_object(__DIR__ "obj/hongri")->wield();
}
