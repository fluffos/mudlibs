// Room: /d/city/yangzhou/tongsi_jie.c

#include <ansi.h>
inherit ROOM;

private varargs void enter_xinfang(object, object, string);

void create() {
  set("short", YEL "通泗街" NOR);
  set("long", @LONG
通泗街由大块青石砌成，两边整齐的种着槐树，树下各有一道排水沟。北边
是扬州官衙，门前立着一对石狮，门上挂一匾额「扬州」。行人到此多加快脚步，
免惹是非，车马亦加上一鞭，加速通过。南面都是民宅，几条小巷曲折穿插其中，
偶然有一顶轿子进出。
LONG
  );
  set("outdoors", "yangzhou");
  set("no_clean_up", 0);
  set("no_kill", "yangzhou");
  set("objects", ([
    __DIR__ "npc/xunbu": 1,
  ]));
  set("exits", ([ /* sizeof() == 3 */
    "north": __DIR__ "guanya",
    "southeast": __DIR__ "caohe_cexiang",
    "west": __DIR__ "tongsi_men",
    "east": __DIR__ "xiaojie",
  ]));

  setup();
}

void init() {
  add_action("do_enter", ({ "enter", "jinru" }));
}

int do_enter(string arg) {
  object xinfang, me;
  mapping owner;
  string *all_owner_id, owner_id, my_id;
  int i;

  me = this_player();
  my_id = me->query("id");

  if (!arg) arg = my_id;
  if (!xinfang = new(MISC_DIR + "xinfang.lpc")) {
    if (wizardp(me))
      write("create xinfang fail...\n");
    return 0;
  }
  owner = xinfang->query("owner");
  all_owner_id = keys(owner);
  for (i = 0; i < sizeof(all_owner_id); i++) {
    if (arg == all_owner_id[i]) {
      if (stringp(owner[arg]) && find_object(owner[arg])) {
        destruct(xinfang);
        xinfang = find_object(owner[arg]);
      } else {
        xinfang->set("owner/" + arg, file_name(xinfang));
      }
      if (arg == my_id || me->query("have_married/" + arg)) {
        enter_xinfang(me, xinfang, arg);
        return 1;
      }
      if (me->query_temp(arg + " invited")) {
        enter_xinfang(me, me->query_temp(arg + " invited"));
        return 1;
      } else {
        write("你未受主人邀请，不能进入他们的新房。\n");
        return 1;
      }
    }
  }
  write("没有你想进入的新房。\n");
  write("\n       启示\n\n最近通泗物业管理混乱.\n");
  write("总经理trill玩胡职守,至使大家不能入住自己的新房.\n");
  write("\n我们通泗物业集团正在考虑撤换经理,所以请大家最近不要买房.\n");
  write("\n如果想退房,请找原经理trill,本公司概不负责.\n");
  write("\n我们新任经理将选择一位责任心强的人.\n");
  write("新经理上任后,我们保证不再发生丢失新房的事情.\n");
  write("\n\n                             XO通泗物业管理公司(盖章)\n");
  return 1;
}

varargs void enter_xinfang(object me, object xinfang, string owner_id) {
  if (owner_id) {
    xinfang->set_temp("owner_id", owner_id);
    xinfang->change_description(owner_id);
  }
  message("vision", me->query("name") + "离开这里。\n",
    environment(me), ({ me }));
  tell_object(me, "你进入了" + xinfang->query("short") + "。\n");
  me->move(xinfang);
  message("vision", me->query("name") + "进入了这里。\n",
    environment(me), ({ me }));
  return;
}
