#include <ansi.h>
#include <room.h>
inherit ROOM;

void create() {
  set("short", "庭院");
  set("long", @LONG
西面是个练武场，几个镖局的弟子在相互比划。照壁四周摆着些芍药，东墙
脚种着一小丛湘竹，略略的堆了一些湖石。看来周镖头扬州住久了，也有些风雅
起来。只是镖局弟子练武的吆喝声却将这里的闲静的气氛破坏殆尽。绕过照壁，
就是镖局的大厅，客人来洽谈保镖事宜大多在那里进行。
LONG
  );
  set("no_clean_up", 0);
  set("exits", ([
    "east": __DIR__ "biaoju_damen",
    "west": __DIR__ "lianwu_chang",
    "south": __DIR__ "biaoju_dating",
  ]));
  set("objects", ([]));
  set("no_kill", "penglai");
  set("refuse_npc", 1);
  set("outdoor", "yangzhou");
  setup();
}
