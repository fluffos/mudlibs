//Npc : shiye.c
//by trill 05/03/97

inherit NPC;

string ask_xinfang();

void create() {
  set_name("刘飞扬", ({ "liu feiyang", "liu", "shiye" }));
  set("gender", "男性");
  set("age", 40);
  set("title", "扬州官衙师爷");
  set("attribute", "peaceful");
  set("long", @LONG
他看上去甚是友善，却总使人感到难以亲近，也许是身上的官架子
始终去不掉，使人有种虚伪的感觉。
LONG
  );
  set_wugong("unarmed", 40, 40, 1);
  set_wugong("jiben-qinggong", 40, 40, 1);
  set_xiuwei_by_type("unarmed", 100);
  set_xiuwei_by_type("dodge", 100);

  set("combat_exp", 1000);
  set("inquiry", ([
    "新房": (: ask_xinfang :),
    "买新房": (: ask_xinfang :),
  ]));
  set("str", 25);
  set("per", 20);
  set("con", 26);
  set("int", 25);

  setup();
  carry_object(CLOTH_DIR + "baiduan_shan")->wear();
}

string ask_xinfang() {
  object xinfang, me;

  me = this_player();
  if (this_player()->query("have_room"))
    return "你有自己的房子了，现在一人只能有一间。\n";
  if (!me->query_temp("can_buy_xinfang") && !wizardp(me))
    return "买房子先交钱，二十两金子一间。\n";
  if (!xinfang = new(MISC_DIR + "xinfang.lpc")) {
    if (wizardp(me))
      write("create xinfang fail..\n");
    return "现在暂时不售新房。\n";
  }
  xinfang->restore();
  xinfang->set("owner/" + me->query("id"), 1);
  xinfang->save();
  destruct(xinfang);
  this_player()->set("have_room", 1);
  return "呵呵，你的新房在通泗街的南面，不过现在可是空屋子。\n";
}

int accept_object(object me, object item) {
  object xinfang;
  if (me->query("have_room")) {
    write("刘师爷说道：你有自己的房子了，现在一人只能有一间。\n");
    return 0;
  }
  if (item->value() < 200000) {
    write("刘师爷不满的说道：我说过是二十两金子一间。\n");
    return 0;
  }
  if (item->value() > 200000) {
    write("刘师爷说道：太多了，只要二十两金子就够了。\n");
    return 0;
  }
  if (!xinfang = new(MISC_DIR + "xinfang.lpc")) {
    if (wizardp(me))
      write("create xinfang fail..\n");
    write("刘师爷说道：现在暂时不售新房。\n");
    return 1;
  }
  xinfang->restore();
  xinfang->set("owner/" + me->query("id"), 1);
  xinfang->save();
  destruct(xinfang);
  this_player()->set("have_room", 1);
  write("\n刘师爷笑道：呵呵，你的新房在通泗街的南面，不过现在可是空屋子。\n");
  tell_object(this_player(), "\n通泗物业的信誉最近十分不好!!\n");
  tell_object(this_player(), "总经理trill工作不利,所以新房多不能入住.\n");
  tell_object(this_player(), "我们正在考虑撤换经理,从新建立住宅区.\n");
  tell_object(this_player(), "你这间房子既然已经买了,就先算了.\n回去转告其他人,在新经理没有上任之前,最好不要买房.\n");
  tell_object(this_player(), "透露一点,新经理可能是lala.\n");
  return 1;
}
