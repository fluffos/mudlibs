#include <armor.h>
inherit CLOTH;
void create() {
  set_name("碎花衫", ({ "sui huashan", "huashan", "cloth" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一件普通人家女孩子的衣服。\n");
    set("unit", "套");
    set("material", "cloth");
    set("armor_prop/armor", 1);
  }
  setup();
}
