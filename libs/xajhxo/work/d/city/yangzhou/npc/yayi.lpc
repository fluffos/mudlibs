#include <ansi.h>

inherit NPC;

void create() {
  set_name(YEL "衙役" NOR, ({ "ya yi", "ya" }));
  set("age", 32);
  set("title", "扬州官衙");
  set("gender", "男性");
  set("long", "扬州的一名衙役，在官场里混久了，脸上面无表情，一付小屁官的样子。\n");
  set("str", 25);
  set("con", 30);
  set("max_sen", 300);
  set("max_qi", 500);
  set("talk_msg", ({
    "大爷我整天站班，累的要死，没工夫陪你聊天！\n",
  }));
  set_wugong("blade", 100, 100, 1);
  set_wugong("jiben-qinggong", 100, 100, 1);
  set_xiuwei_by_type("blade", 500);
  set_xiuwei_by_type("dodge", 550);
  set("combat_exp", 8000);
  setup();
  carry_object(__DIR__ "obj/yaodao")->wield();
  carry_object(CLOTH_DIR + "yayi_fu")->wear();
  carry_object(BOOTS_DIR + "zaoxue")->wear();
}

void init() {
  ::init();
  if (can_act()) {
    remove_call_out("greeting");
    call_out("greeting", 1);
  }
}

void greeting() {
  object me = this_player();
  if (me->query_condition("kill_yangzhou")) {
    message_vision("衙役对着$N大喝一声：“大胆刁民，竟敢杀人放火，想置我们与何地？！！” \n", me);
    kill_ob(me);
  }
}


int accept_fight(object me) {
  command("say 好，大爷我今天高兴就活动活动筋骨。");
  return 1;
}

int refuse_killing(object me) {
  object *all;
  int i;

  command("say 你小子不想活了是吧？想造反?");
  me->apply_condition("kill_yangzhou", 360);
  CRIME_D->set_crime(me, "yangzhou");
  all = all_inventory(environment(me));
  for (i = 0; i < sizeof(all); i++) {
    if (all[i]->id("xun bu") || all[i]->id("ya yi") ||
      all[i]->id("bu tou"))
      all[i]->kill_ob(me);
  }
  return 0;
}
