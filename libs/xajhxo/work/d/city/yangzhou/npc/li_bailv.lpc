// waiter.c

#include <ansi.h>
inherit NPC;
inherit F_VENDOR;

void create() {
  set_name(YEL "李百履" NOR,
    ({ "li bailv", "li", "bailv", "seller", "boss" }));
  set("gender", "男性");
  set("age", 43);
  set("title", "李家丝鞋铺老板");
  set("long", @LONG
李百履是一条瘦小的汉子，他五短身材，但是却很有精神。从眼睛里就
能看出这是个精明的生意人。他就是这家鞋店的老板。
LONG
  );
  set("talk_msg", ({
    "这里就是扬州城啦，有名的花花世界啊！",
    "说起本府的欧阳老爷，那是天下一等一的大才子，有学问！",
    "嘿嘿，客官，您别光说话聊天啊，照顾照顾小老儿的生意啊？",
    "客官，您瞧瞧，这双丝鞋多合适啊。您家试试，来我帮您包上，怎么样？",
  }));
  set("inquiry", ([
    "丝鞋": "啊，您要买丝鞋是吧？没问题，咱家的鞋是扬州城里头一份！",
    "here": "这扬州城啊，那是大江南北头一个繁华的去处！",
  ]));
  set("attitude", "friendly");
  set("rank_info/respect", "老哥");
  set("rank_info/rude", "老王八蛋");
  set("vendor_goods", ([
    "麻鞋": BOOTS_DIR "maxie",
    "皮靴": BOOTS_DIR "pixue",
    "四缝干黄靴": BOOTS_DIR "sifeng_huangxue",
    "四缝宽靴": BOOTS_DIR "sifeng_kuanxue",
    "丝鞋": BOOTS_DIR "sixie",
    "薄底快靴": BOOTS_DIR "baodi_kuaixue",
    "葱绿绣花鞋": BOOTS_DIR "xiuhua_xie2",
    "细碎紫花鞋": BOOTS_DIR "zihua_xie",
    "弓鞋": BOOTS_DIR "gongxie",
  ]));
  set("positive_score", 10);
  set("no_kill", "yangzhou");
  set("combat_exp", 100);
  set("social_exp", 100);
  set_xiuwei_by_type("unarmed", 50);
  setup();
  carry_object(CLOTH_DIR "cloth4")->wear();

}
void init() {
  object ob = this_player();
  ::init();
  if (this_object()->can_act()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  message_vision("李老板热情的迎上来：“客官，您买双鞋？哎，不买不要紧，看看货色么。”\n", ob);
}
