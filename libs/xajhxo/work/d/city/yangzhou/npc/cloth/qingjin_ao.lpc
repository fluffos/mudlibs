//qingjin_ao.c 青锦袄
//by trill 04/06/97

#include <armor.h>
inherit CLOTH;

void create() {
  set_name("青锦袄", ({ "qingjin ao", "cloth" }));
  set_weight(1500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一套布袄，上面印着青色的花纹。\n");
    set("unit", "套");
    set("value", 400);
    set("material", "cloth");
    set("armor_prop/armor", 3);
  }
  setup();
}
