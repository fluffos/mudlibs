//caoxie.c 草鞋
//by trill 04/07/97
#include <armor.h>
inherit BOOTS;
void create() {
  set_name("草鞋", ({ "cao xie", "xie", "shoes" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一双稻草编的鞋，编制的很合脚。\n");
    set("unit", "双");
    set("value", 300);
    set("material", "grass");
    set("armor_prop/armor", 1);
  }
  setup();
}
