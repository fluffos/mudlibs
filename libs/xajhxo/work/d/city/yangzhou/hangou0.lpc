inherit ROAD;

void create() {
  set("short", "古邗沟边");
  set("long", @LONG
古邗沟最后是要汇入南北大运河的，这一段的大运河称为真楚运河。古邗沟
就是在此汇入真楚运河的。由于靠近河口，这里的交通更加繁忙，而在岸上，这
里的村庄也格外的稠密，常有村民驾小舟出没于大船之间，其技术不能不让人赞
叹。 
LONG);
  set("exits", ([
    "northeast": "/d/map/zhongyuan/yunhe2",
    "west": __DIR__ "hangou1",
  ]));
  set("outdoors", "yangzhou");
  setup();
}
