inherit ROOM;

void create() {
  set("short", "容膝园");
  set("long", @LONG
在园之东北隅，叠山石一撮，植花木少许。在园之西侧，贴墙筑半廊，与半
亭连续。于园之西南，横断园林，造客斋一间。斋之南，留有隙地，到也小有天
地。整个园地，纵深约三十步，宽仅十步许。身步不移，全园景物，即可全收眼
底。北向有堂屋一间。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "north": __DIR__ "tangwu2",
    "south": __DIR__ "hejia_jie",
  ]));
  set("objects", ([ /* sizeof() == */
  ]));
  setup();
}
