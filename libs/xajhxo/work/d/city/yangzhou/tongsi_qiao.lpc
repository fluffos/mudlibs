#include <ansi.h>
inherit ROOM;

void create() {
  set("short", YEL "通泗桥" NOR);
  set("long", @LONG
通泗桥连接扬州旧城的中心十里街和官衙，宽敞平整，数辆大车可以并行。
桥的西头围出一大花坛，种着扬州的名花「芍药」，更有一株老杏，横卧水上，
夭矫屈曲。桥的东头，立一巨石，上书「通泗桥」。桥上常有行人倚栏笑看船儿
桥下过。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "east": __DIR__ "shili_changjie2",
    "west": __DIR__ "xiaojie",
  ]));
  set("detail", ([
    "芍药": "扬州以盛产芍药而名闻天下，其中又以「金带围」最为名贵。\n",
  ]));

  set("no_clean_up", 0);
  set("outdoors", "yangzhou");
  set("no_kill", "yangzhou");
  setup();
  replace_program(ROOM);
}
