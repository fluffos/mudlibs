#include <ansi.h>
#include <room.h>
inherit ROOM;

void create() {
  set("short", "公堂");
  set("long", @LONG
这里不甚明亮，一块「正大光明」的金字牌匾高悬在北壁上，底下是知州的
宝座，案桌上放着一些笔墨、文书和令签。两边立着几对木牌，上面写着「肃静」
「回避」。一进得公堂，立刻感受到一种肃穆压抑的气氛，不敢胡乱说话。有些
奇怪的是偌大的公堂，却只有师爷一人。
LONG
  );
  set("no_kill", "yangzhou");
  set("no_clean_up", 0);
  set("exits", ([
    "south": __DIR__ "guanya"
  ]));
  set("objects", ([
    __DIR__ "npc/shiye": 1,
  ]));
  setup();
}
