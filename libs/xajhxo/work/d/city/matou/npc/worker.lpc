inherit NPC;

void create() {
  set_name("采石工", ({ "shi gong", "worker" }));
  set("gender", "男性");
  set("age", 35);
  set("str", 40);
  set("long", "这是一位身强力壮，腰大膀圆的采石工。\n");
  set("combat_exp", 5000);
  set("max_kee", 200);
  set("kee", 200);
  set("attitude", "friendly");
  set_wugong("unarmed", 100, 100, 1);
  set_wugong("jiben-qinggong", 100, 100, 1);
  set_xiuwei("unarmed", 50);
  setup();
  add_money("coin", 30);
  carry_object(__DIR__ "obj/cloth1")->wear();
}
