// dai.c

#include <ansi.h>


inherit __DIR__ "funiu.lpc";

void create() {
  set_name("戴子奇", ({ "dai ziqi", "dai" }));
  set("gender", "男性");
  set("age", 26);
  set("str", 30);
  set("cor", 30);
  set("cps", 30);
  set("int", 25);
  set("ker", 24);
  set("kar", 30);
  set("dex", 30);
  set("max_force", 1500);
  set("force", 1500);
  set("force_factor", 3);
  set("positive_score", 3000);
  set("negative_score", 700);
  set("class_score/伏牛派", 1000);

  create_family("伏牛派", 2, "弟子");
  set("no_kill", "funiu");
  set("combat_exp", 20000);
  set("social_exp", 200);
  set_wugong("unarmed", 100, 100, 0);
  set_wugong("taizu-quan", 110, 100);
  set_wugong("zhuifeng-quan", 60, 50, 1);
  set_xiuwei_by_type("unarmed", 500);
  set_wugong("whip", 100, 100, 1);
  set_wugong("kuangf-bian", 40, 40, 1);
  set_xiuwei_by_type("whip", 250);
  set_wugong("qinggong", 100, 100, 1);
  set_wugong("xingyun-shenfa", 110, 100);
  set_wugong("feiyan-gong", 60, 50, 1);
  set_xiuwei_by_type("dodge", 500);

  setup();
  carry_object(CLOTH_DIR "cloth3")->wear();
}
void init() {
  ::init();
  add_action("do_ling", "ling");
}
int refuse_killing() {
  set("force_factor", 40);
  return 0;
}
int do_ling(string arg) {
  object me, whip;
  int ling_time;
  me = this_player();
  if (!me->can_act())
    return 0;
  if (!arg) return 0;
  if (arg != "whip" && arg != "bian" && arg != "鞭子" && arg != "鞭" && arg != "book" && arg != "书")
    return notify_fail("你要领什么东西？\n");
  if (!me->query("family/family_name") || me->query("family/family_name") != "伏牛派") {
    message_vision("戴子奇疑惑地看了看$N,说：“你想干什么？”\n", me);
    return notify_fail("算了吧，人家不想给你。\n");
  }
  ling_time = me->query("marks/lin/伏牛ling");
  if (ling_time && (me->query("mud_age") - ling_time) < 1000)
    return notify_fail("戴子奇说：“不是刚给过你了吗？是不是卖了换酒喝了？“\n");
  if (me->query("age") < 15)
    return notify_fail("戴子奇说：“你先到后堂上随便拿把鞭子使吧。”\n");
  whip = new(__DIR__ "obj/whip");
  message_vision("戴子奇从身后拿了一把鞭子交给$N,说道：“这是本派用的软鞭，你拿去用吧。”\n", me);
  whip->move(me);
  me->set("marks/lin/伏牛ling", me->query("mud_age"));
  return 1;
}

int recognize_apprentice_of(object me) {
  if (me->query("family/family_name") == "伏牛派")
    return 1;
  return 0;
}
