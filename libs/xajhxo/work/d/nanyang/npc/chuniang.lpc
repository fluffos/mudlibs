// liang.c

#include <ansi.h>

inherit FILLER;

void create() {
  set_name("厨娘", ({ "chu niang" }));
  set("gender", "女性");
  set("age", 44);
  set("talk_msg", ({
    "怎么，饿啦？\n",
    "怎么，又饿啦？真是不可救药。\n",
  }));
  set("combat_exp", 4000);
  set("social_exp", 200);
  set("no_kill", "funiu");
  setup();
  carry_object(__DIR__ "obj/cloth1")->wear();
}
