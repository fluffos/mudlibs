//chushi.c 一品堂之玄武堂的内院厨师

#include <ansi.h>

inherit __DIR__ "xwnpc";

void create() {
  set_name("厨子", ({ "chu zi", "cooker" }));
  set("gender", "男性");
  set("age", 35 + random(10));
  set("long", @LONG
这位大师傅身穿一件白布袍，腰间别着一把剔骨刀，正在案板前忙活
着。听说他是堂主从中原聘来的，一付好手艺，好象原来还是什么楼
的大厨。
LONG);

  set_wugong("unarmed", 70, 70, 1);
  set_wugong("dodge", 70, 70, 1);
  set_xiuwei_by_type("unarmed", 50);
  set_xiuwei_by_type("dodge", 50);
  set("combat_exp", 3000);
  set("social_exp", 10000);

  set("chat_chance", 4);
  set("chat_msg", ({
    "厨子一面揉着面，一面嘟囔道：“这鬼地方，钱可真不好挣呀。”\n",
    "厨子望着炉火出了会儿神，喃喃地说：“还是江南好呀。”\n",
  }));

  setup();

  carry_object(__DIR__ "obj/baibu_pao")->wear();
  carry_object(__DIR__ "obj/tigu_dao");
}

int tell_skills(object me) {

  message_vision(CYN @LONG
厨子一笑道：这练武和发面是一个道理，即不能欠了，也不能过了。
要是发过了，完全没劲儿了，也就不好吃了；要是没发开，回头一蒸
就死面了。所以说要恰到好处才行。
LONG NOR, me);
  return 1;
}
