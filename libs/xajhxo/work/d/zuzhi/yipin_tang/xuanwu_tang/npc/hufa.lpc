//hufa.c 玄武堂的护法
#include <ansi.h>

inherit __DIR__ "xwnpc";

int init() {
  add_action("do_qingjiao", "qingjiao");
  ::init();
}


int alarming(object npc, object ppl) {
  message_vision(CYN "$N看了$n一眼，喝道：“阁下闯关杀人，莫非当我大夏无人吗？！”\n" NOR,
    npc, ppl);
  kill_ob(ppl);
  return 1;
}

int refuse_killing(object ppl) {
  command("enforce 10");
  return 0;
}

int accept_fight(object ppl) {
  if (ppl->IsMemberOf("yipin")) {
    message_vision(CYN "$N瞟了$n一眼，道：“好，那我就指点你两手。”\n" NOR,
      this_object(), ppl);
    return 1;
  } else {
    message_vision(CYN "$N看了$n一眼，脸色忽然大变：“咦？你是什么人？"
      "怎么闯上来的？”\n" NOR,
      this_object(), ppl);
    kill_ob(ppl);
    return notify_fail("");
  }
}

int valid_teach(object ppl, string skill) {
  int time_available;
  object npc = this_object();
  string npc_name = npc->name(), msg = CYN + npc_name + CYN;
  mapping clocks = ppl->query_condition("clock");

  if (mapp(clocks))
    time_available = clocks["玄武"]["duration"];
  if (time_available < 2)
    msg += "叹了口气道：“你在本堂耽搁太久了，我可不敢留你。”\n" NOR;
  else if (ppl->ZuzhiTouxianJibie("yipin") / 2 < SKILL_D(skill)->query_dengji() - 4)
    msg += "微微一笑，对你道：“以你在组织中的业绩，还是先学些其他的工夫吧。”\n" NOR
      "看来" + npc_name + NOR "好象对你不是很信任。\n";
  else if (!npc->query_jibie(skill))
    msg += "一楞道：“这——这门功夫我可不会了。”\n" NOR;
  else if (npc->query_jibie(skill) <= ppl->query_jibie(skill))
    msg += "对你笑道：“这门功夫我已经没什么可教的了，能领悟多少就看你的造化了。”\n" NOR;
  else if (ppl->query_lingwu_ratio(skill) < 50)
    msg += "对你笑道：“我看这次就讲到这儿吧，再多讲些你就该糊涂了。”\n" NOR;
  else return 1;
  write(msg);
  return 0;
}

int get_gain_xiuwei(object ppl, object npc, string type) {
  int ppl_int, ppl_dengji;
  int npc_int, npc_dengji;
  int temp, diff;

  ppl_int = ppl->query_int(); ppl_dengji = ppl->query_xiuwei_dengji(type);
  npc_int = npc->query_int(); npc_dengji = npc->query_xiuwei_dengji(type);
  if (ppl->query_xiuwei(type) > npc->query_xiuwei(type))
    return 0;
  else if (ppl_dengji < npc_dengji)
    diff = (npc_dengji - ppl_dengji + 1) / 2;
  else
    diff = 2;
  temp = npc_dengji * ppl_dengji / 2 + npc_int / 10 * (ppl_int + 5) / 10;

  return random(temp / diff + 3);
}

int do_qingjiao(string arg) {
  string skill, master, xiuwei_type;
  object ppl = this_player(), npc = this_object();
  int npc_jibie, ppl_jibie;
  int gain_xiuwei, gain_jibie;
  int gin_cost, ratio;

  if (!arg) return 0;
  if ((sscanf(arg, "%s from %s", skill, master) != 2) &&
    (sscanf(arg, "%s %s", master, skill) != 2))
    return 0;
  if (!npc->id(master)) return 0;

  //现在可以肯定用的是这个add_action的qingjiao了。
  //在这之后就不能再返回0了。notify_fail()也不能用了。
  if (environment(ppl)->query("wiz")) {
    write(HIR "这是属于神的房间，不能用来练功。\n" NOR);
    return 1;
  }

  if (ppl->is_busy()) {
    write("你现在无法静下心来求教。\n");
    return 1;
  }
  if (ppl->is_fighting() || ppl->is_duilianing()) {
    write("临阵磨枪？来不及啦。\n");
    return 1;
  }

  if (!ppl->can_act()) {
    write("你现在无法请教！\n");
    return 1;
  }
  if (file_size(SKILL_D(skill) + ".lpc") == -1) {
    write("没有这门武功。\n");
    return 1;
  }
  if (!SKILL_D(skill)->valid_learn(ppl)) return 1;

  printf("你向%s请教有关「%s」的疑问。\n", npc->name(),
    to_chinese(skill));

  if (!living(npc)) {
    write("但是" + npc->name() + "现在无法指点你什么了。\n");
    return 1;
  }

  // 为了能更加灵活一些, 我们让你请教的人来决定是否教你
  notify_fail("但是看来" + npc->name() + "并不想指点你。\n");
  if (!npc->valid_teach(ppl, skill))
    return 1;

  npc_jibie = npc->query_jibie(skill);
  ppl_jibie = ppl->query_jibie(skill);

  gain_jibie = random(30) + 10;  //10倍于正常速度。
  printf("%s向你滔滔不绝地讲述%s的要领，", npc->name(), to_chinese(skill));
  if (gain_jibie + ppl_jibie > npc_jibie)
    gain_jibie = npc_jibie - ppl_jibie;
  gin_cost = 10 + 2 * gain_jibie;

  if (ppl->query("gin") < gin_cost) {
    ppl->receive_damage("gin", ppl->query("gin"));
    ratio = ppl->query("gin") * 100 / gin_cost;
  } else {
    ppl->receive_damage("gin", gin_cost);
    ratio = 100;
  }

  gain_jibie = gain_jibie * ratio / 100;
  if (!gain_jibie) {
    printf("可是你今天太累了，结果什么也没有领会到。\n");
    return 1;
  } else if (ratio < 100)
    printf("听得你脑子几乎都打了结，后面的一部分是怎么也记不住了。\n");
  else printf("你听了觉得大有收获。\n");
  ppl->improve_jibie(skill, gain_jibie);

  if (xiuwei_type = SKILL_D(skill)->query_xiuwei_type())     // 请教文化类的东西是不会有修为的啦. :-)
  {
    printf("xiuwei %d\n", ppl->query_xiuwei(xiuwei_type));
    gain_xiuwei = get_gain_xiuwei(ppl, npc, xiuwei_type) * 10;  //10倍于正常速度。
    printf("gainxiuwei %d\n", gain_xiuwei);
    if (ppl->query_xiuwei_dengji(xiuwei_type) > SKILL_D(skill)->query_dengji())
      gain_xiuwei = 0;
    if (gain_xiuwei && random(100) < ratio)
      ppl->improve_xiuwei(xiuwei_type, gain_xiuwei);
    printf("xiuwei %d\n", ppl->query_xiuwei(xiuwei_type));
  }
  return 1;
}
