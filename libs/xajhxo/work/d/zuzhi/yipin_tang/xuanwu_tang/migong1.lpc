// migong1.c
// by lnwm

inherit ROOM;

void create() {
  set("short", "山道");
  set("long", @LONG
你已经走入贺兰山脉深处。到这里，脚下已经出现终年不化的皑皑白雪。举
目四顾，周围是高耸入云的山峰，蜂顶的雪光隐藏在朵朵白云之上，宛若天上的
仙境。
    蜂顶往下，无一例外是陡峭的悬崖，岩石在悬崖上突兀出来，仿佛怪兽口中
的牙齿。四周山风呼啸，冰冷异常，你只想赶快离开这里，回到温暖的山下平原
中去。
LONG
  );
  set("exits", ([
    "southeast": __DIR__ "migong",
    "northwest": __DIR__ "migong1",
    "northeast": __DIR__ "migong3",
    "southwest": __DIR__ "migong3",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "xuanwu");
  setup();
}
