// shancun.c
// by lnwm

inherit ROOM;

void create() {
  set("short", "小山村");
  set("long", @LONG
贺兰山区并不常见的山村。因贺兰山常年寒冷，因此人烟稀少，只在各个地
方散居着一些农户。这些农户祖祖辈辈生活在这里，几乎过着与世隔绝的生活，
因此也比较贫困。每年夏季时，他们以种田为生。当寒冷的冬季到来时，可以打
猎的农户就会上山解决他们的生计问题，不能打猎的，就奔赴山外，寻找生路，
常常数个月呆在外面。
LONG
  );
  set("exits", ([
    "north": __DIR__ "nongjia1",
    "northwest": __DIR__ "cunkou",
    "south": __DIR__ "nongjia2",
    "east": __DIR__ "shanjiao",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "xuanwu");
  setup();
}
