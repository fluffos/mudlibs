//密道模型之六--滚刀

#include <ansi.h>
inherit ROOM;

void init() {
  object ob, me;
  ob = this_object();
  me = this_player();

  if (me->IsMemberOf("yipin")) return;
  if ((ob->query("id")) == "wei shi") return;
  if ((me->query("combat_exp") > 30000)) {
    if (random(5) < 2)
      message_vision(RED "$N看见四周景色大变，耳边突然警铃大作，头顶上\n"
        "缓缓的降下了一面钉板，四壁也出现了几排滚刀，一起向$N挤来\n"
        "但$N不慌不忙，轻轻一纵。跑了出来。\n" NOR, me);
    return;
  }
  if (random(10) > 5) {
    if (random(5) < 2)
      message_vision(RED "$N看见四周景色大变，耳边突然警铃大作，头顶上\n"
        "缓缓的降下了一面钉板，四壁也出现了几排滚刀，一起向$N挤来\n"
        "但$N不慌不忙，轻轻一纵。跑了出来。\n" NOR, me);
    return;
  }
  remove_call_out("fa_him");
  call_out("fa_him", 0, me);
}

void fa_him(object me) {
  message_vision(RED "$N看见四周景色大变，耳边突然警铃大作，头顶上\n"
    "缓缓的降下了一面钉板，四壁也出现了几排滚刀，一起向$N挤来\n"
    "$N不由得惊慌失措，被滚刀砍个正着。\n" NOR, me);
  me->receive_damage("sen", (int)(me->query("sen")) - (int)(me->query("sen") / 5));
  me->receive_damage("kee", (int)(me->query("kee")) - (int)(me->query("kee") / 5));
  me->receive_damage("gin", (int)(me->query("gin")) - (int)(me->query("gin") / 5));
  return;
}
