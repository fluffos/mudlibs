// Room: /u/ysg/room/shenf4.c

inherit ROOM;

void create() {
  set("short", "身份甄别处");
  set("long", @LONG
你终于走出了密道，来到了总舵地牢所在，这里是总舵的身份甄别处，所有
的一品堂弟子，不论你是什么职务，到了这里都得出示你的腰牌，接收检查。一
品堂对所有的人犯都看管的极为严格，看到你来，几名守牢弟子一起向你迎来.。
LONG
  );
  set("exits", ([ /* sizeof() == 3 */
    "south": __DIR__ "midao26",
    "east": __DIR__ "groom6",
    "northwest": __DIR__ "laofang_rukou",
  ]));
  set("no_clean_up", 0);

  setup();
}

void welcome_visitor(object me) {
  object *inv;
  int i;

  inv = all_inventory(me);

  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i]->is_character() && (!userp(inv[i]))
      && inv[i]->query("name") == me->query("yipin_task/obname")
      && me->query("yipin_task/keyname") == "活捉"
      // && me->query_temp("yipin_task/allow") 
    ) {
      message_vision("卫士对$P点头说：辛苦了。把犯人交给我们好了。", me);
      YIPIN_D->end_yipin_task("活捉", me, inv[i]);
    }
  }
}
