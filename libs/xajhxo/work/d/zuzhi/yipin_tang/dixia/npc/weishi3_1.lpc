// modified by lnwm 97-12-11

#include <ansi.h>
#include "refuse_kill.h"

inherit NPC;

int ling(string arg);
int quchu(object ob);

void create() {
  set_name(MAG "紫衣卫士" NOR, ({ "wei shi" }));
  set("title", YEL "一品堂" NOR);
  set("age", 22);
  set("gender", "男性");
  set("str", 40);
  set("per", 25);
  set_wugong("liuyun-jian", 200, 200, 1);
  set_xiuwei_by_type("sword", 1800);
  set("combat_exp", 50000);
  set_xiuwei_by_type("dodge", 1800);
  set_wugong("yanxing", 200, 200, 1);
  set("max_force", 2000);
  set("force", 2000);
  set("force_factor", 30);
  JoinZuzhi("yipin", "指挥使", "玄阳堂");
  set("attitude", "peaceful");
  setup();
  carry_object(__DIR__ "obj/cloth2")->wear();
  carry_object(__DIR__ "obj/jian1")->wield();
}

void init() {
  object ob, me;
  ob = this_object();
  me = this_player();

  add_action("ling", "ling");
  if (ob->can_act()
    && !me->query_condition("kill_yipin")
    && !ob->is_fighting()
    && (me->IsBossOf(this_object(), "yipin"))) {
    remove_call_out("greeting");
    call_out("greeting", 1, me);
  }

  if (ob->can_act()
    && me->query_condition("kill_yipin")) {
    remove_call_out("kill_him");
    call_out("kill_him", 1, me);
    return;
  }
  if (me->IsMemberOf("yipin")) return;
  if ((me->query("id")) == "wei shi") return;
  remove_call_out("kill_him");
  call_out("kill_him", 1, me);
}

void kill_him(object me) {
  message_vision("$N对着$n大喝一声：“哪里来的奸细，快快受死吧！！！” \n",
    this_object(), me);
  kill_ob(me);
  me->fight_ob(this_object());
}

void greeting(object me) {
  if (interactive(me) && environment() == environment(me)) {
    message_vision(GRN "$N对$n拱手施礼：“卑职见过大人。”\n" NOR,
      this_object(), me);
  }
  if (!me->IsMemberOf("yipin")) {
    say("哪里来的小子，一品堂是让你乱闯的地方吗？\n"
      "居然让你给闯到这儿来了，外面的兄弟都干嘛去了。\n"
      "不过到了大爷这里，就没那么容易了，纳命来！！！\n");
    kill_ob(me);
    me->fight_ob(this_object());
    return;
  }
  return;
}

int ling(string arg) {
  object wuqi, me, ob;
  ob = this_object();
  me = this_player();

  if (!me->IsMemberOf("yipin")) {
    message_vision("只有本堂弟子可以领武器。\n", me);
    return 1;
  }

  if (me->ZuzhiScore("yipin") < 0) {
    return notify_fail("你的组织信任度太低，不能领任何东西。\n");
  }
  if (arg != "jian" && arg != "剑" && arg != "dao" && arg != "刀") {
    tell_object(me, "你只能领刀或者是剑。\n");
    return 1;
  }
  if (!me->query("lnwm/yipin/task/领武器")) {
    say("难道你不知道未经许可，不得私自领武器吗？\n");
    return 1;
  }

  if (present("riyue dao", me) || present("qiankun jian", me)) {
    say("你已经领到武器了，请速速离去。别忘了按时归还。\n");
    return 1;
  } else if (me->query("lnwm/yipin/task/已经领武器")) {
    tell_object(me, "大担，竟敢将本堂配发的武器丢失！真是无能！\n");
    me->AddZuzhiScore("yipin", -200);
    me->delete("lnwm/yipin/task/已经领武器");
    return 1;
  }

  if (arg == "jian" || arg == "剑") {
    wuqi = new(__DIR__ "obj/qiankunjian");
    wuqi->move(me);
    message_vision("$N交给$n一柄乾坤剑。\n", ob, me);
    tell_object(me, CYN "\n你必须在一月之内将此剑归还！否则后果自付！\n" NOR);
    me->apply_condition("yipin_jiewuqi", 120);
    me->set("lnwm/yipin/task/已经领武器", 1);
    me->delete("lnwm/yipin/task/领武器");
    return 1;
  }

  if (arg == "dao" || arg == "刀") {
    wuqi = new(__DIR__ "obj/riyuedao");
    wuqi->move(me);
    message_vision("$N交给$n一把日月刀。\n", ob, me);
    tell_object(me, CYN "\n你必须在一月之内将此刀归还！否则后果自付！\n" NOR);
    me->apply_condition("yipin_jiewuqi", 120);
    me->set("lnwm/yipin/task/已经领武器", 1);
    me->delete("lnwm/yipin/task/领武器");
    return 1;
  }
  return 1;
}

int accept_object(object me, object obj) {
  if ((obj->query("id") != "riyue dao" && obj->query("id") != "qiankun jian")) {
    tell_object(me, "卫士奇怪地看了你一眼，你给我这个做什么？\n");
    return 0;
  } else {
    if (me->query_condition("yipin_jiewuqi")) {
      tell_object(me, "卫士点点头，好！按时归还。\n");
      me->delete("lnwm/yipin/task/已经领武器");
      me->clear_condition("yipin_jiewuqi");
      call_out("quchu", 1, obj);
      return 1;
    } else {
      tell_object(me, "卫士哼了一声，怎么这么晚才还回来？\n");
      me->delete("lnwm/yipin/task/已经领武器");
      me->AddZuzhiScore("yipin", -50);
      call_out("quchu", 1, obj);
      return 1;
    }
  }
}

int quchu(object ob) {
  destruct(ob);
}
