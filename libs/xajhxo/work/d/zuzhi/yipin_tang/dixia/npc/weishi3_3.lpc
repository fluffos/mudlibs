//weishi3_2.c.紫衣卫士
//date:1997.9.8 changed by ysg

// modified by lnwm 97-12-11

#include <ansi.h>
#include "refuse_kill.h"

inherit NPC;

int ling(string arg);

void create() {
  set_name(MAG "紫衣卫士" NOR, ({ "wei shi" }));
  set("title", YEL "一品堂" NOR);
  set("age", 22);
  set("gender", "男性");
  set("str", 40);
  set("per", 25);
  set_wugong("liuyun-jian", 100, 100, 1);
  set_xiuwei_by_type("sword", 1800);
  set_xiuwei_by_type("dodge", 2000);
  set_wugong("tianhong", 200, 200, 1);
  set("max_force", 2000);
  set("force", 2000);
  set("combat_exp", 80000);
  set("force_factor", 30);
  JoinZuzhi("yipin", "指挥使", "玄阳堂");
  set("attitude", "peaceful");

  setup();
  carry_object(__DIR__ "obj/cloth2")->wear();
  carry_object(__DIR__ "obj/jian1")->wield();
}

void init() {
  object ob, me;
  ob = this_object();
  me = this_player();

  add_action("ling", "ling");

  if (ob->can_act()
    && !me->query_condition("kill_yipin")
    && !ob->is_fighting()
    && (me->IsBossOF(this_object(), "yipin"))) {
    remove_call_out("greeting");
    call_out("greeting", 1, me);
  }
  if (ob->can_act()
    && me->query_condition("kill_yipin")) {
    remove_call_out("kill_him");
    call_out("kill_him", 1, me);
    return;
  }
  if (me->IsMemberOf("yipin")) return;
  remove_call_out("kill_him");
  call_out("kill_him", 1, me);
}

void kill_him(object me) {
  message_vision("$N对着$n大喝一声：“哪里来的奸细，快快受死吧！！！” \n",
    this_object(), me);
  kill_ob(me);
  me->fight_ob(this_object());
}

void greeting(object me) {
  if (interactive(me) && environment() == environment(me)) {
    message_vision(GRN "$N对$n拱手施礼：“卑职见过大人。”\n" NOR,
      this_object(), me);
  }
  if (!me->IsMemberOf("yipin")) {
    say("哪里来的小子，一品堂是让你乱闯的地方吗？\n"
      "居然让你给闯到这儿来了，外面的兄弟都干嘛去了。\n"
      "不过到了大爷这里，就没那么容易了，纳命来！！！\n");
    kill_ob(me);
    me->fight_ob(this_object());
    return;
  }
  return;
}

int ling(string arg) {
  object yao, me, ob;
  int i;

  ob = this_object();
  me = this_player();

  if (!me->IsMemberOf("yipin")) {
    message_vision("只有本堂弟子可以领物品。\n", me);
    return 1;
  }

  if (me->ZuzhiScore("yipin") < 0) {
    return notify_fail("你的组织信任度太低，不能领任何东西。\n");
  }
  if (arg != "yirong yao" && arg != "易容药" && arg != "易容油膏" && arg != "yirong yougao") {
    tell_object(me, "目前你只能领易容药物(yirong yao)。\n");
    return 1;
  }
  if (!me->query("lnwm/yipin/task/领药")) {
    say("难道你不知道未经许可，不得私自领物品吗？\n");
    return 1;
  }

  if (present("rirong yougao", me)) {
    say("你已经领到你需要的东西了，请速速离去。\n");
    return 1;
  }

  for (i = 0; i < 2; i++) {
    yao = new("/clone/misc/yirong");
    yao->move(me);
  }
  message_vision("$N交给$n两包易容药。\n", ob, me);
  me->delete("lnwm/yipin/task/领药");
  return 1;
}
