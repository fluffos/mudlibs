#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "试药室");
  set("long", @LONG
这里是玄云坛的试药室。屋子里显得乱七八糟的，到处都是瓶瓶罐罐，地上
这儿一块红色，哪儿一块绿色。几个坛里的药剂师正站在那儿摆弄什么，看见你
进来，他们只是抬头看了你一眼，又埋下头去继续工作。据说坛里的大部分毒药
、解药和疗伤药都是从这儿研究出来，再批量生产的，这里的瓶瓶罐罐说不定就
有什么毒，所以你觉得还是小心为妙。
LONG
  );

  set("exits", ([ /* sizeof() == 1 */
    "south": __DIR__ "midao78",
  ]));

  setup();
