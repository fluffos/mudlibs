// haokan.c
#include <armor.h>

inherit SURCOAT;
inherit F_SAVE;

void create() {
  set_name("号坎", ({ "hao kan", "haokan" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "cloth");
    set("value", 10);
    set("armor_prop/armor", 1);
  }
  setup();
}

string query_autoload() {
  if (query("equipped")) return query("name");
}

void autoload(string arg) {
  int i;

  set("name", arg);
  ::wear();
}
