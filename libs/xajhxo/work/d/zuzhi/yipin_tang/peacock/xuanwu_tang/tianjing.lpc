// tianjing.c

inherit ROOM;

void create() {
  set("short", "天井");
  set("long", @LONG
环抱的群山中形也不知怎么的就成了这么一个十数丈见方的深洞
，一线天光从头顶投射下来。一道流泉从四十余丈的高处涌出岩壁，
倾注到这里，随着时光的流逝，冲出一方四五丈宽的小水潭。然后又
从一个黑漆漆的岩洞流走了，形成了一条地下河。
LONG);

  set("objects", ([
    __DIR__ "npc/heiyiren": 1
  ]));
  setup();
}

int event_blow(string arg) {
  object room = load_object(__DIR__ "xuanya1");

  find_object(__DIR__ "diaolan")->receive_blow(arg);
  tell_room(this_object(), "尖锐的哨声在狭小的空间里回旋激荡，直上云霄。\n");
  return room->receive_blow(arg);
}
