//xiaomi_zhou.c
//by peacock
//按水果做的粥，有趣吧？除了空碗不能装水以外，还是很真的呢。
//特别是不用drink wan了，而是真正的喝粥。

#include <ansi.h>

inherit ITEM;
inherit F_FRUIT;

void init() {
  add_action("do_eat", "drink");
}

void create() {
  set_name(YEL "小米粥" NOR, ({ "xiaomi zhou", "zhou", "congee", "gruel", "porridge" }));
  set_weight(60);
  set("long", "一碗金黄喷香的小米粥。");
  set("unit", "碗");
  set("value", 3);
  set("fruit_remaining", 7);
  set("food_supply", 5);
  set("water_supply", 30);
  set("eat_msg", "$N端起碗，喝了一口$n。\n");
  set("end_msg", "$N喝光了$n，看看四周没人注意自己，还把碗舔了个干干净净。\n");
  set("over_msg", "多香的小米粥呀！可惜你的胃是实在装不下了。\n");
  // 粥喝完了，只剩下碗了 :-)
  set("core", "海碗");     //name
  set("core_id", ({ "hai wan", "wan", "porringer" }));  //id
  set("core_unit", "个");    //unit
  set("core_long", "一个被舔得干干净净的海碗。\n");  //long
  setup();
}

int is_food_of_xuanwu() {
  return 1;
}
