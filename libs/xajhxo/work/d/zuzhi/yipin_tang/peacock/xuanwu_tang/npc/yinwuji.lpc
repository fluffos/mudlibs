//qinhaoran.c 玄武堂的总管
#include <ansi.h>

inherit NPC;

void create() {
  set_name("阴无极", ({ "yin wuji", "yin", "zongguan" }));
  set("gender", "男性");
  set("age", 42);
  set("long", @LONG
这个身着员外袍的中年人，就是玄武堂的总管。听说他有一身的刚猛
功夫，却不见他使过。即使答应指点你几招，翻来复去用也是的那套
江湖上人人会用的伏虎拳。实在不知是出自何门。
LONG);

  set("str", 43); set("cor", 34); set("int", 33);
  set("per", 23); set("spi", 24); set("cps", 27);
  set("dex", 25); set("con", 30); set("kar", 13);

  set("force", 1500); set("max_force", 1500); set("force_factor", 0);

  set_wugong("luohan-quan", 100);
  set_wugong("weituo-zhang", 100);
  set_wugong("shaolin-shenfa", 140, 140, 1);
  set_wugong("fuhu-quan", 120, 120, 1);
  set_wugong("shaolin-neigong", 150, 150, 1);
  set_wugong("sanhua-zhang", 120);
  set_wugong("qianye-shou", 120);
  set_xiuwei_by_type("dodge", 1300);
  set_xiuwei_by_type("unarmed", 2000);
  set("combat_exp", 30000);
  set("social_exp", 50000);

  setup();

  carry_object(CLOTH_DIR "cloth5")->wear();
  carry_object(SWORD_DIR "changjian")->wield();
  JoinZuzhi("yipin", "护国都尉", "玄武堂");
}

void welcome(object me) {
  object cloth;

  tell_object(me, CYN "一个身着员外袍的中年人踏前一步，递给你一件号坎，道：“首先，\n"
    "只要你还在山上，这件号坎就不能离身片刻，否则格杀勿论。一旦遗\n"
    "失，立刻到我这里报备。其次，山上供给不便，各种器物，尤其是粮\n"
    "食要分外爱惜，不可浪费。第三，堂里有些地方是禁地，不可擅入，\n"
    "否则格杀勿论。不过这些地方都有人看守，一般你也不用担心误入。\n"
    "最后，”声音陡然转厉道：“本堂禁止私斗，如有触犯者，杀无赦！\n"
    "你明白了吗？”\n\n" NOR);
  cloth = new(__DIR__ "obj/haokan");
  cloth->move(me);
}

int welcome_visitor(object me) {
  object npc = this_object(), cloth, ling;

  foreach (object inv in deep_inventory(me)) {
    if ((inv->name() == YEL "玄武令" NOR) && inv->id("ling pai"))
      ling = inv;
  }
}

int refuse_killing(object me) {
  set("force_factor", 100);
  return 0;
}

int accept_fight(object me) {
  if (me->IsMemberOf("yipin")) {
    message_vision(CYN "$N瞟了你一眼，道：“我很忙，要找人对练就到练武场去。”\n" NOR,
      this_object());
    return 0;
  } else {
    message_vision(CYN "$N看了$n一眼，脸色忽然大变：“咦？你是什么人？"
      "怎么闯上来的？”\n" NOR
      , this_object(), me);
    kill_ob(me);
    return notify_fail("");
  }
}

int valid_teach(object me, string skill) {
  return 0;
}
