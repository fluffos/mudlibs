// zhangfang.c
// by lnwm 97-09-12
#include <ansi.h>

inherit NPC;

void create() {
  set_name("帐房先生", ({ "zhangfang xiansheng", "xiansheng" }));
  set("title", "一品堂总堂");
  set("gender", "男性");
  set("age", 50 + random(10));
  set("gender", "男性");
  set_xiuwei_by_type("short", 3000);
  set_wugong("tie-suanpan", 120, 120, 1);
  set("max_kee", 600);
  set("kee", 600);
  set("eff_kee", 600);
  set("combat_exp", 100000);
  setup();
  carry_object(CLOTH_DIR "cloth1")->wear();
  carry_object("/clone/weapon/short/tiesuanpan")->wield();
}

int refuse_killing() {
  int i;
  object *inv, who;

  who = this_player();
  who->apply_condition("kill_yipin", 150);
  inv = all_inventory(environment(this_object()));
  for (i = 1; i < sizeof(inv); i++) {
    if (!userp(inv[i])
      && inv[i] != this_object()
      && inv[i]->IsMemberOf("yipin")
      && inv[i] != who)
      inv[i]->kill_ob(who);
    who->fight_ob(inv[i]);
  }
  return 0;
}
