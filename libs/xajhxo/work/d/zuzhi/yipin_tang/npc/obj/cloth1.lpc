#include <armor.h>
#include <ansi.h>
inherit CLOTH;

void create() {
  set_name(YEL "镶铜战甲" NOR, ({ "zhan jia", "jia" }));
  set("long", "一件镶金边的熟铜战甲\n");
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "steel");
    set("value", 1000);
    set("cant_sell", "一品堂的东西, 小的可不敢收. \n");
    set("armor_prop/armor", 5);
  }
  setup();
}
