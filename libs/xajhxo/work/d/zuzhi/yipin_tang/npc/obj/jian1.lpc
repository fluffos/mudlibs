#include <weapon.h>
#include <ansi.h>

inherit SWORD;

void create() {
  set_name("薄刃长剑", ({ "chang jian", "jian", "sword" }));
  set_weight(1500);
  set("long", "一把长剑，剑身极薄, 两面开刃. \n");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 800);
    set("material", "iron");
  }
  init_sword(10);
  set("wield_msg", "$N抽出一把$n握在手中。\n");
  set("unwield_msg", "$N将手中的$n插入腰间的剑鞘。\n");
  setup();
}
