// yipin_task的结构 
//          yipin_task/task_type    "long"or"short"
//                    /start_time   发任务时间(秒)
//                    /time_limit   任务期限(秒)
//                    /bonus        奖励组织信任度
//                                   (可缺省)                        
//                    /fail         失败惩罚
//                                   (可缺省)                                
//                    /keyname      "杀"or"取"or"活捉"
//                    /obname       任务对象(中文名)
//                    /task_message 发任务时显示的信息
//                    /need_type    任务前可发的东西
//                                  1 -- 兵刃  
//                                  2 -- 易容药
//                                  3 -- 毒药
//                                   (可缺省)
//    对"long"另加的task_type：
//                   /start_mud_age    发任务时玩家岁数

#include <ansi.h>

inherit SKILL;

mapping *task = ({
  ([
    "task_type": "short",
    "time_limit": 350 + random(300),
    "bonus": 3,
    "keyname": "取",
    "obname": "风雷刀",
