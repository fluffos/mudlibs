inherit __DIR__ "ShennongNpc.lpc";

void create() {
  set_name("阿胜", ({ "a sheng", "asheng", "sheng", }));
  set("class_score/神农帮", 100);
  set("age", 25);
  set("int", 25);

  set_wugong("unarmed", 80, 80, 1);
  set_wugong("blade", 80, 80, 1);
  set_wugong("hammer", 80, 80, 1);
  set_wugong("jiben-qinggong", 80, 80, 1);
  set_wugong("shaolin-xinfa", 30, 30, 1);
  set_wugong("dugong", 30, 30, 0);

  set_xiuwei_by_type("unarmed", 140);
  set_xiuwei_by_type("blade", 140);
  set_xiuwei_by_type("dodge", 140);
  set_xiuwei_by_type("short", 140);

  setup();

  carry_object(CLOTH_DIR + "cloth2")->wear();
  carry_object(SHORT_DIR + "yaochu")->wield();
  add_money("coin", 20 + random(20));
}
