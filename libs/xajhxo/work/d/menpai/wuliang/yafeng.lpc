//Qyz

inherit ROOM;
void create() {
  set("short", "崖缝");
  set("long", @LONG
这里是山崖中裂开的一道大缝，勉强可攀援而下。崖缝中尽多砂石草木，所
以不会一溜而下，内中还有很多荆刺。瀑布的声音更大了，只觉水珠如下大雨般
溅来，打得你隐隐生疼。那崖缝间有些小坑，似乎可以踏着它爬下去。
LONG);
  set("outdoors", "wuliang");
  setup();
}
void init() {
  add_action("do_pa", ({ "pa", "climb" }));
}

int do_pa(string arg) {
  object me;

  me = this_player();

  if (!me->can_act())
    return notify_fail("你现在没法爬。\n");
  message_vision("$N顺着崖缝慢慢爬了下去。\n", me);
  me->disable_command("verb", "你正在爬山，小心点吧。\n");
  call_out("end_pa", 7, me);
  return 1;
}

void end_pa(object me) {
  if (!me) return;

  me->enable_path();
  tell_object(me, "你顺着崖缝慢慢向下爬着，手脚被磨得皮开肉绽。\n"
    "半晌，终于到了谷底。\n");

  me->move(__DIR__ "gudi");
}
