// laogao.c

inherit NPC;

void create() {
  set_name("老高", ({ "lao gao", "gao" }));
  set("title", "保管人");
  set("gender", "男性");
  set("age", 58);
  set("str", 26);
  set("int", 14);
  set("long",

    "老高看起来老态龙钟，动作缓慢，好象不会什么功夫，他在\n"
    "剑湖宫已经有好多年了。\n");
  set("combat_exp", 200000);
  set("attitude", "peaceful");

  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 20);


  set_skill("unarmed", 80);
  set_skill("liuh-ken", 60);
  set_skill("dodge", 80);
  set_skill("sword", 100);
  set_skill("parry", 100);
  set_skill("wuliang-jian", 100);
  set_skill("force", 60);
  set_skill("haoran-zhengqi", 80);

  map_skill("unarmed", "liuh-ken");
  map_skill("parry", "wuliang-jian");
  map_skill("sword", "wuliang-jian");
  map_skill("force", "haoran-zhengqi");

  setup();
  carry_object(__DIR__ "obj/cloth")->wear();
}

int accept_fight(object ob) {
  if ((string)ob->query("family/family_name") == "无量剑东宗") {
    command("smile");
    command("say 好吧，我就陪你练几招吧，看好了哦。");
    return 1;
  }
  if (ob->query("combat_exp") >= 100000) {
    command("heng");
    command("say 欺负到门上来了，今天我就不惜这条命，陪你玩玩吧！");
    carry_object(__DIR__ "obj/changjian")->wield();
    kill_ob(ob);
    ob->fight_ob(this_object());
    return 1;
  }
}

void init() {
  add_action("do_ling", "ling");
}

void check_triggers() {
  object me;
  me = this_player();
  if ((int)query_temp("triggers") == 3)
    return notify_fail("你不能领更多的剑了，省着点用吧。");
}
int do_ling(string arg) {
  object who;
  int sword_level;

  who = this_player();
  sword_level = who->query_skill("sword") / 20;
  if (!arg || arg != "jian") return 0;
  if (arg == "jian" || arg == "剑") {
    if (who->query("family_name") != "无量剑东宗")
      return notify_fail("你没有领剑的资格。");
    if (random(5) >= 2) {
      add_temp("triggers", 1);
      check_triggers();
      message_vision("老高轻轻地从架子上取下一把$p，递给$N。"
        , who);
      switch (sword_level) {
        case 0:
          __DIR__ "obj/jian"->move(who);
          break;
        case 1:
          __DIR__ "obj/jian1"->move(who);
          break;
        case 2:
          __DIR__ "obj/jian2"->move(who);
          break;
        default:
          __DIR__ "obj/jian3"->move(who);
          break;
      }
    }
    return notify_fail("不巧，剑已经领完了。");
  }
}
