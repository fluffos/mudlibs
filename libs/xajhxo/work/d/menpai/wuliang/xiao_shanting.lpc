inherit ROOM;
void create() {
  set("short", "小山亭");
  set("long", @LONG
这是一个小小的木亭子，脚下是大理石地面，周围一带二尺来高的青石栏杆，
六根木柱子都刷着红漆，大部分都已剥落。梁上画着些彩绘图案，也大多看不清
了。正中地面上立着一块石碑，碑体残破，左上角裂了一道大缝。
    六角形的亭子建在一块大石之上，西面就是万丈绝崖，爬在栏杆上向下看去
，真是惊心动魄。
LONG
  );
  set("exits", ([
    "out": __DIR__ "shanyao1",
  ]));
  set("objects", ([
    __DIR__ "obj/shibei2": 1,
    __DIR__ "npc/oldman": 1,
  ]));
  setup();
}
