#include <room.h>

inherit ROOM;

void create() {
  set("short", "洞穴");
  set("long", @LONG
这是个仅可容身的洞穴，石级到这已是尽头，外面就是澜沧江，怒涛汹涌，
水流湍急，水声振耳欲聋，江岸山石壁立，嶙峋突兀，这洞穴离岸边足有十来丈
高，山壁上荆棘密布，杂草丛生，有一些山石夹杂于其中，似乎可以攀援而下。
LONG
  );
  set("exits", ([
    "east": __DIR__ "shiji1",
  ]));

  setup();
}

void init() {
  add_action("do_climb", ({ "pa", "climb" }));
}

int do_climb(string arg) {
  object me;
  me = this_player();

  if (!me->can_act())
    return notify_fail("你现在无法爬。\n");
  me->disable_command("verb");
  tell_object(me, "你抓着山草，艰难地往下爬......\n");
  call_out("end_climb", 3, me);
  return 1;
}

void end_climb(object me) {
  if (!me) return;
  tell_object(me,
    "终于，你爬到了岸边，但已累得满头大汗，身上也划了好几道伤痕。\n");
  me->enable_path();
  me->move("/d/map/xinan/jiangbian");
  me->receive_wound("kee", 5);
}
