#include <room.h>

inherit ROOM;

void create() {
  set("short", "玉壁");
  set("long", @LONG
这就是“无量玉壁”，经过瀑布很多年的冲激磨洗，这半面石壁被磨得光润
如玉，后来瀑布水量减少，露出了这片如琉璃，如明镜的石壁，相传，有的月明
之夕，这玉壁上可以看到仙人舞剑的影子，那剑法之精，令人做梦都想像不到，
但剑影实在太快，太急，淡淡的若有若无，很难学到一招半式。
LONG
  );
  set("exits", ([
    "northeast": __DIR__ "hupan1",
    "south": __DIR__ "pubu",
  ]));
  set("outdoors", "wuliang");
  setup();
}
