//Cloth :baishan.c

#include <armor.h>
inherit CLOTH;

void create() {
  set_name("白缎衫", ({ "baiduan shan", "cloth" }));
  set_weight(1200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("value", 300);
    set("unit", "套");
    set("material", "cloth");
    set("armor_prop/armor", 1);
  }
  setup();
}
