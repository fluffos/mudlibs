// /d/menpai/wuliang/west/npc/lin_shuangxiu.c 无量西宗的林双秀
// Changed by lala 1997/09/08

inherit NPC;
#include "west.h"
#include "west_master.h"

void create() {
  set_name("林双秀", ({ "lin shuangxiu", "dao gu", "lin" }));
  set("gender", "女性");
  set("age", 48);

  set("no_kill", "west_wuliang");
  set("str", 20);
  set("cor", 20);
  set("cps", 20);
  set("per", 20);
  set("int", 24);

  set("attitude", "peaceful");

  set("max_force", 500);
  set("force", 500);
  set("force_factor", 10);

  set("long", @LONG
她是一位无量剑派西宗的长辈，掌门人的师姐。慈眉善目，和蔼可亲，正
在指点弟子无量剑法。
LONG
  );

  create_family("无量剑派西宗", 5, "弟子");

  set("combat_exp", 200000);

  set_wugong("lingxiao-shou", 80, 80, 1);
  set_wugong("nanshan-liushi", 90, 70, 1);
  set_wugong("literate", 80);
  set_wugong("haoran-zhengqi", 110, 100, 1);
  set_wugong("wuliang-jian", 90, 90, 1);
  set_wugong("wuliang-shenfa", 100, 100, 1);
  set_wugong("yanxing", 90, 90, 1);
  set_wugong("liuyun-jian", 70, 100);

  set_xiuwei_by_type("unarmed", 1400);
  set_xiuwei_by_type("sword", 1800);
  set_xiuwei_by_type("dodge", 1800);
  setup();

  carry_object(__DIR__ "obj/sword")->wield();
  carry_object(__DIR__ "obj/daopao")->wear();
}
