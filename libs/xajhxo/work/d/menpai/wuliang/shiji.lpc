#include <room.h>

inherit ROOM;

void create() {
  set("short", "石级");
  set("long", @LONG
这里有十馀级石级，都以长约三尺的条形石块砌成，石级往南极是明亮，一
直通向一间石室，往北是一个石门。
LONG
  );
  set("exits", ([
    "south": __DIR__ "shishi2",
    "northeast": __DIR__ "shishi1",
  ]));
  create_door("northeast", "石门", "southwest", DOOR_CLOSED);
  setup();
}
