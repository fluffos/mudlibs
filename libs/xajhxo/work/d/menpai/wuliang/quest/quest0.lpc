inherit SKILL;
string *fail_msg = ({
  "左子穆对着你摇了摇头，说：“连这点事都做不好.....下去吧。”\n",
  "左子穆看上去很不高兴，皱了皱眉头对你说：“下去歇着吧。”，嘴\n"
  "里嘟囔着：“真是没用。。。。”\n",
  "左子穆疑惑地看着你：“怎么回事？怎么你。。。”\n",
  "左子穆失望地看看你，慢慢地转过头去，跟其他弟子说话去了。\n",
});
string *delay_msg = ({
  "左子穆似乎有些不满：“怎么现在才办好这件事？，你。。。”\n",
  "左子穆很不高兴地看了你两眼，一言不发，又把身子转了过去。。。\n",
  "左子穆瞪了你一眼：“真是误事，现在才回来....”\n",
});

mapping *quest = ({
  ([ "quest": "杀毒蛇",
    "time": 600,
    "bonus": 4,
    "quest_msg":
    "左子穆沉吟了一下：“听说近来后山上常有毒蛇出没，伤及人畜，\n"
    "你就去把它杀死吧。”\n",
    "reward_msg":
    "左子穆拍拍你的肩膀，用欣赏的眼光看着你：“看来你也是个可造\n"
    "之材呀，日后定会好好栽培于你。”\n",
    "fail_msg":
    "左子穆对着你摇了摇头，说：“连这点事都做不好.....下去吧。”\n",
    "delay_msg":
    "左子穆似乎有些不满：“怎么现在才办好这件事？，你。。。”\n",
  ]),
  ([ "quest": "扫前厅",
    "time": 300,
    "bonus": 2,
    "quest_msg":
    "左子穆看看周围，“暂时也没什么事做，听老高说前厅没人打扫，你\n"
    "就先去打扫一下吧。”\n",
    "reward_msg":
    "左子穆说，“嗯，不错，能吃苦，是练武的好材料。”\n",
    "fail_msg":
    "左子穆瞪着你，似乎有些圭怒：“让你去打扫前厅，怎么你竟。。。”\n",
    "delay_msg":
    "左子穆无奈地笑了笑：“扫地都要花那么多时间。。。唉！！”\n",
  ]),
  ([ "quest": "杀衙役",
    "time": 1000,
    "bonus": 10,
    "positive_score": 40,
    "quest_msg":
    "左子穆看了你一眼，郑重地对你说：“大理衙门里那个衙役平常作威\n"
    "作福，欺压百姓，鱼肉乡里，现在我命你下山去把他杀了，为大理百\n"
    "姓除掉这个祸害！”\n",
    "reward_msg":
    "左子穆大喜，对你说：“你能办成这件事，实乃大理黎民之福也，日\n"
    "后我必将倾囊相授，令你成为武林奇葩！”\n",
    "fail_msg":
    "左子穆叹了一口气，说：“那贼子果然厉害，也难怪你敌不过他，只\n"
    "是，如此一来，那恶贼必将愈加猖獗，唉～～”\n",
    "delay_msg":
    "左子穆舒了一口气：“你一去不返，我等均以为凶多吉少，如今你终\n"
    "于杀掉那恶贼而平安归来，还属天助呀！”\n",
  ]),
  ([ "quest": "取烧柴",
    "time": 600,
    "bonus": 2,
    "quest_msg":
    "左子穆想了想，说：“听厨房里说，这两天烧柴颇缺，你就上后山密\n"
    "林中去砍些烧柴回来吧。”\n",
    "reward_msg":
    "左子穆点了点头：“待会我会命人把这些烧柴送到厨房，你累了吧？\n"
    "下去歇歇吧。”\n",
    "fail_msg":
    "左子穆看上去很不高兴，皱了皱眉头对你说：“下去歇着吧。”，嘴\n"
    "里嘟囔着：“真是没用。。。。”\n",
    "delay_msg":
    "左子穆很不高兴地看了你两眼，一言不发，又把身子转了过去。。。\n",
  ]),
  ([ "quest": "杀关东刀客",
    "time": 1000,
    "bonus": 4,
    "positive_score": 70,
    "quest_msg":
    "左子穆突然想起了什么，急切地对你说：“速速下山除掉大理城中的\n"
    "关东刀客，此人乃一名大盗假扮，意欲对我大理国不利，此事甚急，\n"
    "你快点下山去办吧！”\n",
    "reward_msg":
    "左子穆如释重负，欣然对你说，“所幸你及时除掉关东刀客，否则我\n"
    "大理百姓又要遭受磨难了。”\n",
    "fail_msg":
    "左子穆焦急地搓着双手，眉头紧皱，看着你叹了一口气说：“看来得\n"
    "再派个人去。。。。要不然。。。”\n",
    "delay_msg":
    "左子穆点了点头：“嗯，迟了一点，还好没出大事。”\n",
  ]),
  ([ "quest": "取三字经",
    "time": 300,
    "bonus": 1,
    "quest_msg":
    "左子穆点了点头，对你说：“到书房去替我拿一本三字经来，我要教\n"
    "你的师弟们识几个字。”\n",
    "reward_msg":
    "左子穆看看三字经，轻轻颔首：“嗯，很好。”\n",
    "fail_msg":
    "左子穆疑惑地看着你：“怎么回事？怎么你。。。”\n",
    "delay_msg":
    "左子穆很不高兴地说：“怎么去了那么长时间？书房不就在里面吗？\n",
  ]),
  ([ "quest": "取百家姓",
    "time": 300,
    "bonus": 1,
    "quest_msg":
    "左子穆点了点头，对你说：“到书房去替我拿一本百家姓来，我要教\n"
    "你的师弟们识几个字。”\n",
    "reward_msg":
    "左子穆看看百家姓，轻轻颔首：“嗯，很好。”\n",
    "fail_msg":
    "左子穆疑惑地看着你：“怎么回事？怎么你。。。”\n",
    "delay_msg":
    "左子穆很不高兴地说：“怎么去了那么长时间？书房不就在里面吗？”\n",
  ]),
  ([ "quest": "取绿茶",
    "time": 400,
    "bonus": 2,
    "quest_msg":
    "左子穆说：“你下山去买点绿茶回来吧，听总管说茶叶已经不多了。”\n",
    "reward_msg":
    "左子穆拿起绿茶看了看，“嗯，这绿茶不太好，不过也将就了。你下去\n"
    "休息吧。”\n",
    "fail_msg": fail_msg[random(sizeof(fail_msg))],
    "delay_msg": delay_msg[random(sizeof(delay_msg))],
  ]),
  ([ "quest": "取普洱茶",
    "time": 500,
    "bonus": 3,
    "quest_msg":
    "左子穆说：“你下山去买点普洱茶回来吧，听总管说茶叶已经不多了。”\n",
    "reward_msg":
    "左子穆拿起普洱茶看了看，“嗯，这普洱茶可真不错，色泽很好，看来\n"
    "你对茶的好坏还是很熟悉的嘛！”\n",
    "fail_msg": fail_msg[random(sizeof(fail_msg))],
    "delay_msg": delay_msg[random(sizeof(delay_msg))],
  ]),
  ([ "quest": "杀冷锋",
    "time": 2000,
    "bonus": 12,
    "positive_score": 50,
    "quest_msg":
    "左子穆凝重地注视着你，小声对你说：“本门曾经有个叛徒，名叫冷锋\n"
    "，很多年来四处搜捕他都不见踪影，最近有人告诉我，他就躲在大理城\n"
    "内，隐姓埋名，你就下山去仔细寻访，若是发现他，即刻处死。”\n",
    "reward_msg":
    "左子穆猛一拍膝盖：“太好了！  这个逆徒曾经作恶多端，败坏我无量\n"
    "门风，但是行踪无定，所以一直找不到他，今天你终于为师门除去这个\n"
    "恶徒，可谓师门之幸呀。”\n",
    "fail_msg":
    "左子穆长叹道：“那个恶徒天资颇高，本是无量新一辈中的佼佼者，也\n"
    "怪不得你敌不过他，但我对你期望确也过高了，唉～～”\n",
    "delay_msg":
    "左子穆点点头：“嗯，你终于回来了，怎么那么费劲呢？看来杀这恶徒\n"
    "确实比较棘手，花了那么多时间。”\n",
  ]),
  ([ "quest": "取盐",
    "time": 400,
    "bonus": 2,
    "quest_msg":
    "左子穆对你说：“总管告诉我山上存放的盐快用完了，你就下山一趟，\n"
    "买点盐回来吧。”\n",
    "reward_msg":
    "左子穆笑道：“哦，你的脚力不错嘛，这么快就回来了，嗯，不错不错。”\n",
    "fail_msg": fail_msg[random(sizeof(fail_msg))],
    "delay_msg": delay_msg[random(sizeof(delay_msg))],
  ]),
  ([ "quest": "取护心甲",
    "time": 500,
    "bonus": 2,
    "quest_msg":
    "左子穆想了一下，“哦，老高说兵器库里差个护心甲，你去城里兵器店\n"
    "买一个回来吧。”\n",
    "reward_msg":
    "左子穆拿起护心甲仔细看了看：“嗯，这护心甲还挺结实，你下去吧。”\n",
    "fail_msg": fail_msg[random(sizeof(fail_msg))],
    "delay_msg": delay_msg[random(sizeof(delay_msg))],
  ]),
  ([ "quest": "杀禁军士兵",
    "time": 600,
    "bonus": 4,
    "quest_msg":
    "左子穆沉思了一下，抬头对你说：“城中禁军士兵助纣为虐，大理百姓\n"
    "深受其苦，你就下山去杀一名禁军士兵以作儆戒吧。”\n",
    "reward_msg":
    "左子穆很是高兴，对你说：“很好很好。”\n",
    "fail_msg": fail_msg[random(sizeof(fail_msg))],
    "delay_msg": delay_msg[random(sizeof(fail_msg))],
  ])
});


mapping query_quest() {
  return quest[random(sizeof(quest))];
}
