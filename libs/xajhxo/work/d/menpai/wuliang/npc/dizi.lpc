inherit NPC;
void create() {
  set_name("无量弟子", ({ "wuliang dizi", "dizi" }));
  set("gender", "男性");
  set("age", 18);
  set_wugong("unarmed", 10);
  set_xiuwei("unarmed", 20);
  set_xiuwei("dodge", 20);
  set_wugong("sword", 10);
  set_xiuwei("sword", 20);
  set("combat_exp", 150);
  set("social_exp", 150);
  setup();
  carry_object(__DIR__ "obj/changjian")->wield();
  carry_object(__DIR__ "obj/cloth")->wear();
}
