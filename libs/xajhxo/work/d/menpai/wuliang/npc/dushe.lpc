//dushe.c
#include <ansi.h>
inherit NPC;
void use_poison();

void create() {
  set_name("毒蛇", ({ "du she", "she" }));
  set("race", "野兽");
  set("age", 4);
  set("yes_carry", 1);
  set("long", "一条色彩斑斓的毒蛇。\n");
  set("limbs", ({ "头部", "身体", "尾巴", "七寸" }));
  set("verbs", ({ "bite" }));
  set("attitude", "aggressive");
  set_wugong("dodge", 50);
  set_xiuwei("dodge", 200);
  set_temp("apply/dodge", 100);
  set("combat_exp", 10000);
  set("bellicosity", 300);
  set("chat_chance_combat", 40);
  set("chat_msg_combat", ({
    (: use_poison :),
  }));
  setup();
}
void use_poison() {
  object *enemy, ob;
  enemy = query_enemy();
  if (sizeof(enemy)) ob = enemy[random(sizeof(enemy))];
  tell_object(ob, RED "你觉得腿上被咬了一下，一看是两个毒牙印痕。\n" NOR);
  if (random(query("combat_exp")) > (int)ob->query("combat_exp"))
    ob->apply_condition("snake_poison",
      (int)this_player()->query_condition("snake_poison")
      +random(5) + 3);
}

void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player())) {
    say(YEL "你突然发觉踩到一样软软的东西。。。蛇！！\n" NOR);
    kill_ob(ob);
    ob->fight_ob(this_object());
  }
}
