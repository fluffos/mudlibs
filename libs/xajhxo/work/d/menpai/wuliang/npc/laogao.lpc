// laogao.c

void del_mask(object);
inherit NPC;

#include <ansi.h>

void create() {
  set_name("老高", ({ "lao gao", "gao" }));
  set("title", "保管人");
  set("gender", "男性");
  set("age", 58);
  set("str", 26);
  set("int", 14);
  set("per", 26);
  set("long", "老高看起来老态龙钟，动作缓慢，好象不会什么功夫，他在\n"
    "剑湖宫已经有好多年了。\n");
  set("combat_exp", 200000);
  set("social_exp", 100000);
  set("attitude", "peaceful");

  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 20);
  set("kee", 1000);
  set("max_kee", 1000);

  set_wugong("unarmed", 80, 80, 1);
  set_wugong("dodge", 80, 100, 1);
  set_wugong("sword", 100, 100, 1);
  set_wugong("lingxiao-shou", 150, 130, 1);
  set_wugong("liuyun-jian", 100, 100, 1);
  set_wugong("haoran-zhengqi", 80, 100, 1);
  set_xiuwei_by_type("dodge", 4000);
  set_xiuwei("unarmed", 3000);
  set_xiuwei("sword", 3000);

  setup();
  carry_object(__DIR__ "obj/cloth")->wear();
  carry_object(__DIR__ "obj/xuanquan")->wield();
}

int accept_fight(object ob) {
  if ((string)ob->query("family/family_name") == "无量剑派东宗") {
    command("smile");
    command("say 好吧，我就陪你练几招吧，看好了哦。");
    return 1;
  }
  if (ob->query("combat_exp") >= 100000) {
    command("heng");
    command("say 欺负到门上来了，今天我就不惜这条命，陪你玩玩吧！");
    carry_object(__DIR__ "obj/changjian")->wield();
    kill_ob(ob);
    ob->fight_ob(this_object());
    return 1;
  }
  return 0;
}

void init() {
  add_action("do_ling", "ling");
}

int do_ling(string arg) {
  object who, sword;
  int swords;

  who = this_player();
  //    sword_level=who->query_xiuwei_dengji("sword");
  if (!arg || arg != "jian") return 0;
  if (arg == "jian" || arg == "剑") {
    if (who->query("family/family_name") != "无量剑派东宗")
      return notify_fail("你没有领剑的资格。\n");
    //      if(who->query_temp("mask/sword_got") )
    //            return notify_fail("现在你不能再领剑了，等过一会儿再来。\n");
    if (present("chang jian", who))
      return notify_fail("你已经有剑了。\n");
    if (this_object()->query("swords") <= 10) {
      message_vision("老高轻轻地从架子上取下一把剑，递给$N。\n"
        , who);
      sword = new(__DIR__ "obj/sword");
      sword = new(__DIR__ "obj/sword");
      sword->move(who);
      sword->set("long", "一把无量剑派本门使用的长剑，剑上刻着" +
        HIY " 无量剑" +
        who->query("name") + NOR "\n");
      who->save();
      this_object()->add("swords", 1);
      /*      switch(sword_level){
          case 0 : 
               new(__DIR__"obj/jian")->move(who);                
               break;
          case 1 :
               new(__DIR__"obj/jian1")->move(who);
               break;
          case 2 :
               new(__DIR__"obj/jian2")->move(who);
               break;
          default :
               new(__DIR__"obj/jian3")->move(who);
               break;
               }
*/
      return 1;
    }
    return notify_fail("不巧，剑已经领完了。\n");
  }
}
