inherit NPC;

void create() {
  set_name("蜜蜂", ({ "mi feng", "feng" }));
  set("race", "野兽");
  set("age", 1);
  set("per", 25);
  set("long", "一只可爱的小蜜蜂。\n");

  set("limbs", ({ "头部", "身体", "尾巴" }));
  set("verbs", ({ "bite" }));

  set_wugong("dodge", 50);
  set_xiuwei("dodge", 100);
  set("combat_exp", 200);

  setup();
}
