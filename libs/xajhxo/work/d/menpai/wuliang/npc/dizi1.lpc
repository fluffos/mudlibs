inherit NPC;

int ask_me();

//  弟子负责拦住非无量剑派的人上山，但是可用ask about 拜师来上山。 
// so the skill cannot be too low.
void create() {
  set_name("无量弟子", ({ "wuliang dizi", "dizi" }));
  set("gender", "男性");
  set("age", 18);
  set_wugong("unarmed", 70);
  set_xiuwei("unarmed", 300);
  set_wugong("jiben-qinggong", 70);
  set_xiuwei("dodge", 300);
  set_wugong("sword", 60);
  set_xiuwei("sword", 290);
  set("combat_exp", 5000);
  set("social_exp", 5000);
  set("inquiry", ([
    "拜师": (: ask_me :),
  ]));
  setup();
  carry_object(__DIR__ "obj/changjian")->wield();
  carry_object(__DIR__ "obj/cloth")->wear();
}

int ask_me() {
  object me;
  me = this_player();
  command("say 既是这样，就上去吧.");
  me->set_temp("go/yes", 1);
  return 1;
}
