inherit ROOM;

void create() {
  set("short", "菩提院");
  set("long", @LONG
这是一座幽静的院子，院中树木高大茂密，其中有几株千年的古菩提树，树
前树后有几位僧人来回巡逻，手持的戒刀闪闪发光。殿前挂着一块匾额(sign)，
往北便是菩提院的前堂。走出菩提院的大门，通往竹林小道。
LONG
  );
  set("exits", ([
    "southeast": __DIR__ "zhulin_xiaodao3",
    "north": __DIR__ "puti_qiantang",
  ]));

  set("item_desc", ([
    "sign": "菩提院\n",
  ]));

  setup();
}
