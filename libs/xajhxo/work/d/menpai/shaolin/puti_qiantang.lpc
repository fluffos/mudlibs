// pu ti yuan qian tang : /d/shaolin/puti_qiantang.c

inherit ROOM;

void create() {
  set("short", "菩提院前堂");
  set("long", @LONG
这里是菩提院的前堂，看上去空空荡荡的。穿过前堂，就是菩提院后殿。
LONG
  );
  set("exits", ([
    "south": __DIR__ "puti_yuan",
    "north": __DIR__ "puti_houdian",
  ]));

  set("objects", ([
    __DIR__ "npc/zhiqing": 1,
  ]));

  setup();
}

int valid_leave(object me, string dir) {
  mapping myfam;
  myfam = (mapping)me->query("family");

  if ((!myfam || myfam["family_name"] != "少林派") && dir == "north" &&
    objectp(present("zhi qing", environment(me))))
    return notify_fail("止清对你喝道：菩提院乃少林重殿，外人不得入内。\n");

  return ::valid_leave(me, dir);
}
