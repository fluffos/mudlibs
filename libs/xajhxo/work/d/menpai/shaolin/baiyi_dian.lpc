// Room: /d/shaolin/baiyi_dian.c

#include <room.h>
#include <ansi.h>

inherit ROOM;

string look_tongxiang(object me);

void create() {
  set("short", CYN "白衣殿" NOR);
  set("long", @LONG
殿里只有一尊铜铸的观音大士像(tong xiang)，孤零零地端坐在莲台之上。
四周墙上尽是描写观音显圣的壁画。别看现在这里冷冷清清，每当九月十八观音
菩萨生日时，方圆数百里的善男信女都会赶来参加法事。连山门前的广场都人山
人海的。到时，少林寺的法师们就会来到这里，迎接菩萨的圣像。被邀一同前来
的都是平素大有声望的居士，无论谁被选中都会认为是无上的荣光。
LONG
  );
  set("exits", ([
    "west": __DIR__ "lixue_ting.lpc",
  ]));
  set("item_desc", ([
    "tong xiang": (: look_tongxiang :),
  ]));
  setup();
}

void init() {
  add_action("xi_hua", "xi");
}

int xi_hua(string arg) {
  object me;
  me = this_player();
  if (!arg || (arg != "画" && arg != "hua"))
    return notify_fail("你要洗什么？\n");

  if (!me->can_act()) return notify_fail("你现在无法擦洗画像。\n");

  if (arg == "画" || arg == "hua") {
    if (query_temp_marks("xihua_times") >= 2)
      return notify_fail("这壁画已经被擦洗得干干净净了。\n");
    if ((int)me->query("sen") < 50)
      return notify_fail("你现在太累了，先休息一会吧。\n");
    else {
      tell_object(me, "你不知从哪找了块破抹布，先仔细看了看..\n"
        "然后就开始慢慢擦洗起来....\n");
      add_temp_marks("cahua_times", 1);
      me->disable_command("verb", "你正在擦洗壁画呢。");
      call_out("done_xihua", 10, me);
      return 1;
    }
  }
}

int done_xihua(object me) {
  mapping quest;
  tell_object(me, "那一大块壁画终于被你擦洗得干干净净，但你也有些累。\n");
  me->receive_damage("sen", 50);
  me->enable_path();
  if (quest = me->query("quest")) {
    if (quest["quest"] == "洗壁画")
      me->set("done_quest", "洗壁画");
    return 1;
  }
  return 1;
}

string look_tongxiang(object me) {
  //    if ( random( 100 )< 40)
  call_out("think", 5, this_player());
  return @TEXT
        虽是铜像，但面目娇好，体态修长，衣袂更象被风吹拂得飘起
        来了一般。看着观音面无表情，低眉垂目地坐在那里，宛若一
        个想着心事的女子，你不禁想：“不知她有什么伤心事？难道
        做了菩萨也会有难处？不知我能帮她什么？”惊觉这是对菩萨
        的大不敬，你不禁不安起来。仿佛做了什么见不得人的事，害
        怕被人发觉，又有点兴奋。
TEXT;
}

void think(object me) {
  if (!me || environment(me) != this_object())
    return;
  tell_object(me,
    "你忽然想起观音原是男身，这个...这个...咳咳......\n");
}
