// Room: /d/shaolin/shanmen.c

#include <room.h>
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", CYN "少林寺山门" NOR);
  set("long", @LONG
兴建于北魏的百年名寺少林寺，自唐少林得朝廷荫庇而发扬光大后，少
林武功、佛法名满天下。经数百年而流传不衰。在十七级青石垂带式台阶上
是两扇厚重的山门。山门用厚厚的杉木制成，上面包铜，镶满巨大的铜钉。
山门正上方悬着一块黑漆大匾，上面写着

LONG
    "                " BBLK YEL "※※※※※※※※※※※※※※※" NOR "\n"
    "                " BBLK YEL "※※" RED "    少    林    寺    " YEL "※※" NOR "\n"
    "                " BBLK YEL "※※※※※※※※※※※※※※※" NOR "\n"
    @LONG

三个大字。字迹苍劲挺拔，相传为唐王李世民所题。虽年代久远依然光彩夺
目。门口有两头巨大的青石雄狮，石狮旁站着两个高大威猛的僧人。
LONG);

  set("exits", ([
    "north": __DIR__ "dadao2",
    "south": __DIR__ "shanmen_guangchang",
  ]));
  set("objects", ([
    __DIR__ "npc/xuzhao": 1,
    __DIR__ "npc/xuyuan": 1,
  ]));

  set("outdoors", "shaolin");
  setup();
}

int valid_leave(object me, string dir) {
  object *inv;
  mapping myfam, mygen;
  int i;
  string msg;

  msg = "";
  if (me->query("gender") == "女性" && dir == "north") {
    if (objectp(present("xu yuan", environment(me))))
      msg += "虚缘伸手拦住你白眼一翻说道：“数百年以来，少林向不许"
        "女流擅入。" + RANK_D->query_respect(me) + "\n请下山去吧，免得"
        "自讨没趣。”\n";
    if (objectp(present("xu zhao", environment(me))))
      msg += "虚照迈步挡在你身前，双手合什说道：“阿弥陀佛，"
        "这位" + RANK_D->query_respect(me) + "请留步，\n恕小寺不接待女"
        "客。女施主倘若一心向佛，何妨去峨眉山随喜？”\n";
    if (msg != "") return notify_fail(msg);
  }

  myfam = (mapping)me->query("family");

  if ((!myfam || myfam["family_name"] != "少林派") && dir == "north") {
    inv = deep_inventory(me);
    for (i = sizeof(inv) - 1; i >= 0; i--)
      if (inv[i]->query("weapon_prop")) {
        if (objectp(present("xu yuan", environment(me))))
          msg += "虚缘拦住你说道：“这位" + RANK_D->query_respect(me) + "请放下兵刃。少林数百年的规矩，外客不得持兵刃上山。”\n";
        if (objectp(present("xu zhao", environment(me))))
          msg += "虚照迈步挡在你身前，双手合什说道：“阿"
            "弥陀佛，这位" + RANK_D->query_respect(me) + "请收起"
            "\n兵刃。佛门清静之地，不便随意舞刀弄剑。还请施主鉴"
            "谅。”\n";
        if (msg != "") return notify_fail(msg);
      }
  }
  if (myfam && (myfam["family_name"] == "少林派")
    && (!me->query("family/master_id"))
    && dir == "south") {
    if (objectp(present("xu yuan", environment(me))))
      msg += "虚缘伸手拦住你白眼一翻说道：\n"
        "“木人巷都没过就想下山？哪有这么便宜的事？”\n";
    if (objectp(present("xu zhao", environment(me))))
      msg += "虚照迈步挡在你身前，双手合什说道：“这位师弟请留步，\n"
        "本寺的规矩从来都是打过木人巷之后才能下山的。”\n";
    if (msg != "") return notify_fail(msg);
  }
  return ::valid_leave(me, dir);
}

