// 藏经阁广场 : /d/shaolin/cangjing_guangchang.c

inherit ROOM;

void create() {
  set("short", "广场");
  set("long", @LONG
沿着一条林间小径，径向西北，转了几个弯，眼前豁然开朗，是一片很大的
广场。只听得水声淙淙，山溪旁耸立着一座楼阁，楼头挂着一块匾额(bian)。那
就是闻名于天下的少林寺藏经阁了。整个藏经阁掩映于茂密的竹林之中，看不清
全貌。
LONG
  );
  set("exits", ([
    "southeast": __DIR__ "houshan_zhulin" + (random(4) + 1),
    "enter": __DIR__ "cangjing_ge",
  ]));

  set("item_desc", ([
    "bian": "藏经阁\n",
  ]));

  setup();
}
