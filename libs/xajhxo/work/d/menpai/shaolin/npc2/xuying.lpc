#include <ansi.h>

inherit "/d/menpai/shaolin/npc/xu";

void create() {
  set_name("虚影", ({ "xu ying", "xu", "ying", "he shang",
    "sen ren", "bonze" }));
  set("long", "他中等身材，看不出有什么特别的地方，但据说是少林年轻一代中\n"
    "身具慧根者之一。\n");

  set("age", 24);

  set("str", 30);
  set("int", 30);
  set("spi", 30);
  set("con", 30);
  set("cps", 30);
  set("cor", 28);
  set("per", 30);
  set("kar", 30);
  set("dex", 28);

  set_wugong("luohan-quan", 80, 80, 1);
  set_wugong("weituo-zhang", 80, 80, 1);
  set_wugong("shaolin-shenfa", 60, 60, 1);
  set_xiuwei_by_type("unarmed", 350);
  set_xiuwei_by_type("dodge", 350);

  setup();
}
