#include <ansi.h>

inherit "/d/menpai/shaolin/npc/xu";

void create() {
  set_name("虚光", ({ "xu guang", "xu", "guang", "he shang",
    "seng ren", "bonze" }));
  set("long", @LONG
虎头虎脑的小和尚，穿着一件小小的僧衣，一双眼睛大大得十分有神。别看他
年纪小，可入寺已有十多年了。是当年方丈从寺外拣回来的弃婴。因为身世可
怜，所以大家对他都十分爱护。
LONG
  );
  set("age", 12);

  set("max_force", 100 + random(50));
  set("force", 100 + random(100));

  set_wugong("luohan-quan", 80, 80, 1);
  set_wugong("weituo-zhang", 80, 80, 1);
  set_wugong("shaolin-shenfa", 60, 60, 1);
  set_xiuwei_by_type("unarmed", 200);
  set_xiuwei_by_type("dodge", 230);

  set("social_exp", 800);

  setup();
  carry_object(CLOTH_DIR "sengyi_c")->wear();
}
