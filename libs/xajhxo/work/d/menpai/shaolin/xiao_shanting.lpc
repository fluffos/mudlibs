// road for enter shaolin: lin on 06/01/97 02:00AM
// xiao_shanting.c
#include <ansi.h>
#include <room.h>

inherit ROOM;

void create() {
  set("short", HIR "一苇亭" NOR);
  set("long", @LONG
穿过一片树林，地势渐平，脚下不知何时出现了一条大青石铺成的甬道。道
边一座小小的石亭，六角仿木飞檐冲天，亭中放着几个石凳。东面地势又渐升高，
一条青石铺成的甬路直通上山去了。
LONG);
  set("exits", ([
    "southwest": __DIR__ "shaoshi_shanyao2",
    "eastup": __DIR__ "shaoshi_dadao1",
  ]));
  set("outdoors", "shaolin");
  setup();
}
