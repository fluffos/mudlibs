inherit ROOM;

void create() {
  set("short", "长廊");
  set("long", @LONG
这是一座一眼望不到尽头的长廊，走一段路，拐一个弯，不知通向哪里。但
见长廊两旁，一座座殿堂构筑宏伟，一路上遇到许多僧人，都执礼甚恭。长廊拐
过三个弯之后，似乎可以走到尽头了。
LONG
  );
  set("exits", ([
    "south": __DIR__ "zhulin_xiaodao3",
    "north": __DIR__ "fangzhang_changlang2",
  ]));

  setup();
}
