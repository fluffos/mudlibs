// 加上敲钟的功能..


#include <ansi.h>
#include <localtime.h>

inherit ROOM;

void KnockBell();
void eventKnock();
int filter_listener(object);

void create() {
  set("short", CYN "钟楼" NOR);
  set("long", @LONG
佛殿两侧钟鼓楼之钟楼。用大块坚硬的花岗岩为砖砌成，钟楼中空，有一座
楼梯蜿蜒而上到楼顶，楼顶上是一座钟亭。钟亭并不很大，但修得飞檐斗拱，也
甚有气派钟楼斗拱之下是一根粗大得横梁，横梁上用碗口粗的铁钩悬挂一只熟铜
打就的大钟。大钟通体黝黑，上面用阴文篆刻着金刚经。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "west": __DIR__ "qingshi-lu2.lpc",
  ]));
  eventKnock();
  set("no_clean_up", 1);
  setup();
}


void eventKnock() {
  int time;
  remove_call_out("eventKnock");
  time = query_shichen();
  if (time == 3) {
    KnockBell();
  }
  call_out("eventKnock", 10);
}


//执行敲钟的过程，所有在少林寺里面的人能听到
void KnockBell() {
  object *listener;
  int i;
  if (query_shichen() == 3)
    listener = filter_array(users(), "filter_listener", this_object());
  message("qiaozhong", CYN "当。。。当。。。当。。。\n\n" NOR, listener);
  message("qiaozhong", CYN "你听到远处钟楼的钟声响了起来。。。\n" NOR, listener);

  foreach (object ob in listener) {
    if (ob->query("family/family_name") == "少林派")
      tell_object(ob, HIY "看来是做早课的时间到了。。。你得赶紧法"
        "堂听课了。\n" NOR);
    else
      tell_object(ob, HIY "原来是少林弟子做早课的时间到了。\n" NOR);
  }
}


//ppl在少林这个区域里面，return 1，else return 0;
int filter_listener(object ppl) {
  string filename, *dir;
  if (!environment(ppl)) return 0;
  filename = file_name(environment(ppl));
  dir = explode(filename, "/");
  write(filename + "\n");
  write(dir[2] + "\n");
  if (dir[2] == "shaolin")
    return 1;
  else
    return 0;
}
