// hou shan shi dong : /d/shaolin/houshan_shidong.c

inherit ROOM;

void init();
int do_look(string);

void create() {
  set("short", "后山石洞");
  set("long", @LONG
这是一个小小的石洞，洞里空无一物。墙上光秃秃的，却有些人工雕琢的痕
迹。洞口挂着一道瀑布，象一道门帘，把这里和外界隔绝开来。
LONG
  );
  set("exits", ([
    "out": __DIR__ "houshan_pubu",
  ]));

  setup();
}

void init() {
  add_action("do_look", "look");
}


int do_look(string arg) {
  object me = this_player();

  if (arg != "wall") return command("look " + arg);

  message_vision("达摩剑法精要。\n", me);

  return 1;
}
