// hou shan pu bu : /d/shaolin/houshan_pubu.c

inherit ROOM;

void init();
int do_jump(string);

void create() {
  set("short", "后山瀑布");
  set("long", @LONG
走到这里，眼前一片开阔。一道瀑布挂在前方，犹如一条雪白的帘子遮住了
峭壁。瀑布的水顺山石而下，汇成了一道小溪(xiaoxi)，潺潺流淌着。瀑布旁的
峭壁上隐隐有一行小字(xiaozi)。低头往脚下一看，这里是山崖边一块突出的大
岩石，之所以光秃秃地，寸草不生，连飞鸟也不愿在此逗留。四周静得出奇。再
往前显然已经没有路了。
LONG
  );
  set("exits", ([
    "south": __DIR__ "houshan_zhulin6",
  ]));

  set("item_desc", ([
    "xiaozi": "达摩祖师练剑处\n",
  ]));

  setup();
}

void init() {
  add_action("do_jump", "jump");
}

int do_jump(string arg) {
  object me = this_player();

  if (arg != "pubu" && arg != "waterfall" && arg != "xiaoxi")
    return command("jump " + arg);

  if (arg == "pubu" || arg == "waterfall") {
    message_vision("$N提足一口气，跳入了瀑布之中。\n", me);
    me->move(__DIR__ "houshan_shidong");
  } else {
    message_vision("$N一纵身，跃入了小溪之中。\n", me);
    message_vision("只听得“扑通”一声，$N全身湿淋淋地站在水中。\n", me);
    me->move(__DIR__ "houshan_xiaoxi");
  }
  return 1;
}
