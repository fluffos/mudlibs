inherit ROOM;

void create() {
  set("short", "香积厨里间");
  set("long", @LONG
这里是香积厨里间，墙角堆满了柴火，几位僧人正在满头大汗的烧火，灶下
炉火正汪。不时有阵阵的青烟从锅底倒喷出来，那几个僧人不禁被呛了一口。靠
墙是一张案几，上面摆着几样做好的食物，虽说都是素食，但看上去也是又滋有
味的。左边有个出口，可以看到外面的菜园。
LONG
  );

  set("exits", ([ /* sizeof() == 4 */
    "east": __DIR__ "xiangji-chu",
    "west": __DIR__ "caiyuan1",
  ]));
  set("objects", ([
    __DIR__ "obj/doufu": 2,
    __DIR__ "obj/baicai": 2,
    __DIR__ "obj/huasheng": 1,
    __DIR__ "npc/shaofan": 2,
    __DIR__ "obj/tietong": 1,
  ]));
  setup();
}

void init() {
  add_action("dao_shui", "dao");
}

int dao_shui(string arg) {
  object me, tong;
  mapping quest;
  me = this_player();
  if (!arg || (arg != "水" && arg != "shui"))
    return notify_fail("你要倒什么？\n");

  if (!me->can_act()) return notify_fail("你现在无法倒水。\n");

  if (!tong = present("tie tong", me))
    return notify_fail("你没有桶，倒什么水呀？\n");

  if (!tong->query("full_water"))
    return notify_fail("这桶是空的，里面没有水。\n");

  if (query_temp_marks("daoshui_times") >= 4)
    return notify_fail("大水缸已经盛满了水，倒不下了。\n");

  if (arg == "水" || arg == "shui") {
    tell_object(me, "你把铁桶里的水全部倒进角落的水缸里。\n");
    tong->delete("full_water");
    tong->set("name", "铁桶");
    add_temp_marks("daoshui_times", 1);
    if (quest = me->query("quest")) {
      if (quest["quest"] == "挑水")
        me->set("done_quest", "挑水");
    }
    return 1;
  }
  return 1;
}
