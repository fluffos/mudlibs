/* hui.c  159847

代设:
    "gender","age","attitude","max_force","force","force_factor","combat_exp",
    "social_exp","class","family"
    另备有标准 "inquiry" 一套,知道少林寺,知道出家和剃度.
    预装有valid_teach(),tell_skills().其中tell_skills()对已拜师的玩家调用
    tell_skills_to_apprenticed(),该函数可重载.
需设:
    "name","id","long",skill和修为,9项天赋.
    还要穿衣服.


*/

#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void ask_for_shaolin();

string ask_for_join();

void create() {
  set_name("慧", ({ "hui" }));
  set("long", "一个四十多岁的中年僧人。\n");
  set("gender", "男性");
  set("age", 41);
  //      set("attitude", "peaceful");
  set("class", "bonze");

  set("str", 17);
  set("int", 30);
  set("spi", 30);
  set("con", 30);
  set("cps", 30);
  set("cor", 20);
  set("per", 30);
  set("kar", 30);

  set("force", 12000);
  set("max_force", 12000);
  set("force_factor", 40);
  set("kee", 2000);
  set("max_kee", 2000);

  set_wugong("luohan-quan", 100, 100, 0);
  set_wugong("weituo-zhang", 100, 100, 0);
  set_wugong("sanhua-zhang", 100, 100, 1);
  set_wugong("fuhu-quan", 108, 108, 0);
  set_wugong("shaolin-shenfa", 100, 100, 1);
  set_wugong("shaolin-neigong", 100, 100, 0);
  set_xiuwei_by_type("unarmed", 3200);
  set_xiuwei_by_type("dodge", 3200);

  set("combat_exp", 800000);
  set("social_exp", 500000);
  set("positive_score", 10000);
  set("negative_score", 0);
  set("class_score", 10700);

  set("inquiry", ([
    "少林寺": (: ask_for_shaolin :),
    "剃度": (: ask_for_join :),
    "出家": (: ask_for_join :),
  ]));
  create_family("少林派", 37, "弟子");
  set("title", "少林寺罗汉堂知事");

  setup();
  carry_object(CLOTH_DIR "sengyi3")->wear();

}

void attempt_apprentice(object ob) {
  if ((string)ob->query("gender") != "男性")
    command("say 阿弥陀佛，女施主不要跟贫僧开玩笑。");
  else if (ob->query("class") != "bonze")
    command("say 未得方丈准许，贫僧不敢擅收俗家弟子。施主还是请回吧。");
  else if (ob->query("marks/木人巷") != 9)
    command("say 莫急，莫急。你现在的功夫还欠火候，再磨练磨练吧。");
  else {
    message_vision("$N微微一笑，道：“好孩子，从今天起你就是罗汉堂的弟子了。\n"
      "可别给少林丢脸呵。”", this_object(), ob);
    command("recruit " + ob->query("id"));
    ob->set("title", "少林寺罗汉堂弟子");
  }

}


int accept_fight(object me) {
  if ((string)me->query("class") == "bonze")
    command("say 阿弥陀佛！出家人戒逞强恶斗！贫僧不敢违反清规。");
  else
    command("say 施主既然身负绝艺，贫僧佩服便是，也不必较量了。");

  return 0;
}


void ask_for_shaolin() {
  object me, ob;

  me = this_player();
  ob = this_object();
  if (me->query("family/family_name") == "少林派")
    message_vision("$N和颜悦色地向$n说：“本门建寺百余年，一时也讲不了许多。改天有空时我细细告诉你。”", ob, me);
  else
    message_vision("$N拂然不悦道：“施主这是拿小寺说笑吗。”\n", ob, me);
  return;
}

string ask_for_join() {
  object me;

  me = this_player();

  if ((string)me->query("class") == "bonze")
    return "你这是什么意思？\n";
  if ((string)me->query("gender") != "男性")
    return "阿弥陀佛！女施主，这里是寺庙，请你到尼庵去剃度吧。\n";
  return "阿弥陀佛！善哉！善哉！施主若真心皈依我佛，可前去法堂找慧觉。\n";
}

int valid_teach(object me, string skill) {
  if (!me->query("family/master_id"))
    return notify_fail("慧轮摇头道：“少林武功最重根基，这门功夫待你过了木人巷，成为\n本寺入室弟子再来精研也不迟。”");

  switch (skill) {
    case "guanyin-shou":
    case "banruo-zhang":
      return notify_fail("慧轮摇头道：“少林武功最重根基，我且问你，散花掌你已练到几品了？”\n");
    default:
      break;
  }
  return ::valid_teach(me, skill);
}
