#include <ansi.h>
inherit "/d/menpai/shaolin/npc/wuseng.lpc";

void create() {
  set_name(RED "武僧" NOR, ({ "wu seng", "seng", "monk" }));
  set("age", 30);
  set_wugong("duoluoye-zhi", 44, 44, 1);
  set_xiuwei_by_type("unarmed", 1000);
  set_wugong("shaolin-shenfa", 100, 100, 1);
  set_xiuwei_by_type("dodge", 1200);

  setup();
  carry_object(CLOTH_DIR "sengyi3")->wear();
}
