#include <ansi.h>

inherit NPC;
inherit F_MASTER;

string ask_for_join();
string do_accept(string msg, object me);

void create() {
  set_name("慧轮", ({ "hui lun", "hui", "bonze" }));
  set("long", "一个四十多岁的中年僧人。\n");
  set("gender", "男性");
  set("age", 41);
  //      set("attitude", "friendly");
  set("class", "bonze");

  set("str", 17);
  set("int", 30);
  set("spi", 30);
  set("con", 30);
  set("cps", 30);
  set("cor", 20);
  set("per", 30);
  set("kar", 30);

  set("force", 12000);
  set("max_force", 12000);
  set("force_factor", 40);
  set("kee", 2000);
  set("max_kee", 2000);

  set_wugong("luohan-quan", 100, 100, 0);
  set_wugong("weituo-zhang", 100, 100, 0);
  set_wugong("fuhu-quan", 108, 108, 0);
  //    set_wugong("sanhua-zhang"   ,100,100,1);
  set_wugong("shaolin-shenfa", 100, 100, 1);
  set_wugong("shaolin-neigong", 100, 100, 0);
  set_xiuwei_by_type("unarmed", 3200);
  set_xiuwei_by_type("dodge", 3200);

  set("combat_exp", 800000);
  set("social_exp", 500000);
  set("positive_score", 10000);
  set("negative_score", 0);
  set("class_score", 10000);

  set("inquiry", ([
    "木人巷": (: do_accept :),
  ]));
  create_family("少林派", 37, "弟子");
  set("title", "少林寺罗汉堂知事");

  setup();
  carry_object(CLOTH_DIR "sengyi3")->wear();

}

void init() {
  add_action("do_nod", "nod");
}

void attempt_apprentice(object ob) {
  if ((string)ob->query("gender") != "男性")
    command("say 阿弥陀佛，女施主不要跟贫僧开玩笑。");
  else if (ob->query("class") != "bonze")
    command("say 未得方丈准许，贫僧不敢擅收俗家弟子。施主还是请回吧。");
  else if (!ob->query("lnwm/pass_muren"))
    command("say 莫急，莫急。你现在的功夫还欠火候，再磨练磨练吧。");
  else {
    message_vision("$N微微一笑，道：“乖徒儿，从今天起你就是罗汉堂的弟子了。\n"
      "可别给少林丢脸呵。”\n", this_object(), ob);
    command("recruit " + ob->query("id"));
    //ob->set("family/master_id", "hui lun"); 
    ob->set("title", "少林寺罗汉堂武僧");
    //  ob->set("class","bonze1");
  }
}

int accept_fight(object me) {
  if ((string)me->query("class") == "bonze") {
    command("say 那小心了！\n");
    return 1;
  } else
    command("say 施主既然身负绝艺，贫僧佩服便是，也不必较量了。");

  return 0;
}

int valid_teach(object me, string skill) {
  if (!me->query("family/master_id"))
    return notify_fail("慧轮摇头道：“少林武功最重根基，这门功夫待你过了木人巷，成为\n本寺入室弟子再来精研也不迟。”");

  return ::valid_teach(me, skill);
}

string do_accept(string msg, object me) {
  me = this_player();
  if (me->query("class") != "bonze") {
    msg = "木人巷只有本派的弟子可以使用，施主请回吧";
  } else if (me->query("family/master_id")) {
    msg = "你已是我座下弟子，无需再闯木人巷了，好好学功夫吧";
  } else if (this_object()->query_marks("lnwm/有人闯")) {
    msg = "木人巷现正有本门弟子在里头,请稍等一会";
  } else if (me->query_lingwu("fuhu-quan") < 60) {
    msg = "木人巷是本门弟子艺成试练的地方，\n"
      "等你把伏虎拳练得出神入化再来吧。";
  } else {
    me->set_marks("lnwm/问慧轮", 1);
    command("nod");
    command("say 小师侄，你真有心闯木人巷吗?\n");
    msg = "你若有心闯木人巷，就点个头(nod)";
  }
  return msg;
}

int do_nod(string arg) {
  object me;
  me = this_player();

  if (me->query_marks("lnwm/问慧轮")) {
    if (this_object()->query_marks("lnwm/有人闯")) {
      message_vision("慧轮说:木人巷现正有本门弟子在里头,请稍等一会\n", me);
    } else {
      message_vision(CYN "\n\n慧轮对$P说:好孩子!有勇气!那你就试试吧!\n\n\n" NOR, me);
      message_vision(YEL "慧轮燃起一根供香，然后对$P说:在这根香熄灭前,希望你打出木人巷!\n\n\n" NOR, me);
      message_vision(GRN "慧轮转过身，在身后的供桌上轻轻按了一下，他的身后的地上出现一条暗道。\n" NOR, me);
      message_vision(GRN "$P看了看暗道口，然后毫不犹豫地走了进去\n\n\n\n" NOR, me);
      me->delete_marks("lnwm/问慧轮");
      me->set_temp("huilun", this_object());
      me->move("/d/menpai/shaolin/muren_xiang/entrance");
      message_vision(GRN "\n\n只听一阵机簧之声，暗道的门合上了\n\n\n\n" NOR, me);
      this_object()->set_marks("lnwm/有人闯", 1);
    }
    return 1;
  } else {
    return 0;
  }

}

int do_fail(object me) {
  tell_object(me, CYN "你忽然看见一个灵活的人影，几个跳跃越过木人来到你的身边.\n\n" NOR);
  tell_object(me, CYN "来人伸出手抓住你，说:师父让我带你出去.\n\n" NOR);
  tell_object(me, CYN "来人在旁边的墙上按了一下，墙上出现一个暗门，来人带着你从暗门离开木人巷.\n\n" NOR);
  me->move("/d/menpai/shaolin/muren_xiang/exit");
  tell_object(me, YEL "你定睛一看，是你的师兄，罗汉堂大弟子虚戒!\n\n" NOR);
  tell_object(me, YEL "虚戒对你说:师父面前的香已经点完，你还没有闯过木人巷，真是可惜。\n\n" NOR);
  //      tell_object(me,YEL"虚戒看了你一眼:别那么灰心，练好了功夫再来嘛.\n\n"NOR);
  tell_object(me, YEL "\n虚戒叹了一口气,转身离去了.\n" NOR);
  call_out("delete_call_murenxiang", 1);
}

void delete_call_murenxiang() {
  this_object()->delete_marks("lnwm/有人闯");
  //remove_call_out("do_fail");
}
