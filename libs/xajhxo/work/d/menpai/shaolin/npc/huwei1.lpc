#include <ansi.h>
inherit "/d/menpai/shaolin/npc/guard.lpc";

void create() {
  set_name(CYN "少林僧兵" NOR, ({ "shaolin sengbing", "sengbing", "monk", "guard", "monk guard" }));
  set("long", @LONG
这些少林僧兵都是从戒律院精选出来的武功高强的少林武
僧，专门负责重要场所的警卫工作，其功夫不下于江湖上
一般的好手。
LONG);

  set("force", 1000);
  set("max_force", 1000);
  set("force_factor", 20);

  set_wugong("damo-jian", 60, 100, 1);
  set_wugong("duoluoye-zhi", 60, 100, 1);
  set_wugong("xiuluo-dao", 100, 100, 1);
  set_wugong("shaolin-shenfa", 100, 100, 1);
  set_wugong("shaolin-neigong", 80, 100, 1);
  set_xiuwei_by_type("unarmed", 1500);
  set_xiuwei_by_type("dodge", 1500);
  set_xiuwei_by_type("blade", 1500);
  set_xiuwei_by_type("sword", 1500);

  set("social_exp", 3000);
  set("combat_exp", 20000);
  setup();

  carry_object(CLOTH_DIR "jiasha1")->wear();

  switch (random(4)) {
    case 0:
    case 1:
      break;
    case 2:
      carry_object(CLONE_DIR + "weapon/blade/jiedao")->wield();
      break;
    case 3:
      carry_object(CLONE_DIR + "weapon/sword/sword1")->wield();
      break;
  }
}
