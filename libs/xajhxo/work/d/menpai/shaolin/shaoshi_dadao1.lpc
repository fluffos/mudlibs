// road for enter shaolin: lin on 06/01/97 02:00AM
// shaoshi_dadao1.c
#include <ansi.h>
#include <room.h>

inherit ROOM;

void create() {
  set("short", CYN "青石甬道" NOR);
  set("long", @LONG
一条整齐的青石甬道，沿着山势一直向北面山上而去，石板宽阔平整，有些
已显年久之色，有些上面的斧凿痕迹还是崭新的。路边小树林里散落着很多砖塔，
据说是少林寺中历代高僧坐化后珍藏肉身之处。一些小路顺着树林的间隙穿向四
面八方。
LONG);
  set("exits", ([
    "westdown": __DIR__ "xiao_shanting",
    "northup": __DIR__ "shaoshi_dadao2",
  ]));
  set("outdoors", "shaolin");
  setup();
  replace_program(ROOM);
}
