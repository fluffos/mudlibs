// 藏经阁西阁 : /d/shaolin/cangjing_xige.c

inherit ROOM;

void create() {
  set("short", "藏经阁西阁");
  set("long", @LONG
这是一间收拾得极为朴素的楼阁，中间放着一张长长的木桌，有几位僧人坐
在蒲团上正翻阅着经书。四周静得出奇，似乎可以听到窗外竹叶飘落在地上的声
音。往北是藏经阁的西阁书库，往南是一条长长的走廊。
LONG
  );
  set("exits", ([
    "south": __DIR__ "cangjing_zoulang1",
    "north": __DIR__ "cangjing_shukuw",
  ]));

  setup();
}
