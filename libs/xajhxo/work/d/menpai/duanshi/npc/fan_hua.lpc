inherit NPC;
inherit F_MASTER;

#include <ansi.h>

void create() {
  set_name("范骅", ({ "fan hua", "fan", "hua" }));
  set("title", CYN "大理国" RED "司马" NOR);
  set("gender", "男性");
  set("age", 43);
  set("attitude", "peaceful");
  set("class", "duanshi");
  set("long", @LONG
范骅官居大理三公之一的司马之位，深得保定帝的信任，视之如左膀右臂。
他与华赫艮、巴天石可以说是生死之交。他的刀法在三人中为最高，故担
任了大理最高军事长官。
LONG);
  set("str", 25);
  set("int", 26);
  set("spi", 27);
  set("con", 28);
  set("cps", 29);
  set("cor", 30);
  set("per", 15);
  set("force", 1700);
  set("max_force", 1700);
  set("force_factor", 15);
  set("max_kee", 700);
  set("kee", 700);
  set("max_sen", 800);
  set("sen", 800);
  set("rank_info/respect", "司马大人");

  set("class_score/镇南王府", 2000);
  set("combat_exp", 100000);
  set("social_exp", 500000);
  set("positive_score", 50000);

  set_wugong("jiben-qinggong", 170, 170, 0);
  set_wugong("unarmed", 180, 180, 0);
  set_wugong("duanshi-neigong", 170, 170, 0);
  set_wugong("duanshi-xinfa", 70, 70, 1);
  set_wugong("blade", 190, 190, 0);
  set_wugong("kuaige-dao", 170, 170, 0);
  set_wugong("zuiliu-dao", 150, 150, 0);
  set_wugong("dingnan-dao", 130, 130, 1);
  set_wugong("haofeng-quan", 160, 160, 0);
  set_wugong("zhuifeng-quan", 140, 140, 0);
  set_wugong("tianhong", 160, 160, 0);
  set_wugong("shenxing", 140, 140, 1);
  set_wugong("huzhua-gong", 70, 70, 1);

  set_xiuwei_by_type("blade", 1500);
  set_xiuwei_by_type("unarmed", 1100);
  set_xiuwei_by_type("dodge", 1300);
  set_xiuwei_by_type("zonggang", 1100);

  create_family("镇南王府", 1, "司马");

  setup();

  carry_object(CLONE_DIR "wear/boots/wuyun_xue")->wear();
  carry_object(CLONE_DIR "wear/waist/chahe_luandai")->wear();
  carry_object(CLONE_DIR "wear/cloth/baizhu_sipao")->wear();
  carry_object(CLONE_DIR "wear/head/qingsha_jin")->wear();
  carry_object(CLONE_DIR "weapon/blade/blade1");
}

#include "sangong.h";
#include "teach.h";
