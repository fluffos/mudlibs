// NPC: /d/menpai/duanshi/npc/zhu_wanli.c
// By lala on July 12, 97
inherit NPC;
inherit F_MASTER;

#include <ansi.h>

string *chat_msg = ({
  "褚万里提起渔竿，取下一条鱼儿，看了看，又把它抛回水中。\n",
  "褚万里抬渔竿一看，钩上空空，看来这次运气不够好，白白被鱼儿吃了饵料，不过他并不以为意。\n",
  "褚万里一边举着渔竿，一边警觉地观察四周的动静。\n",
});

void create() {
  set_name("褚万里", ({ "zhu wanli", "zhu", "wanli" }));
  set("title", CYN "大理国" GRN "四大卫护" NOR);
  set("gender", "男性");
  set("age", 42);
  set("attitude", "peaceful");
  set("class", "duanshi");
  set("long", @LONG
褚万里身为大理国四大卫护之一，是这四者中最年长者。他整日里总是拎着
渔竿钓鱼，看起来不似武士，倒象是平常人家的渔户。
LONG);
  set("str", 27);
  set("int", 27);
  set("spi", 27);
  set("con", 27);
  set("cps", 27);
  set("cor", 27);
  set("per", 27);
  set("force", 1500);
  set("max_force", 1500);
  set("force_factor", 15);
  set("max_kee", 700);
  set("kee", 700);
  set("max_sen", 900);
  set("sen", 900);

  set("class_score/镇南王府", 800);
  set("combat_exp", 55000);
  set("social_exp", 300000);
  set("positive_score", 11000);

  set_wugong("jiben-qinggong", 170, 170, 0);
  set_wugong("unarmed", 150, 150, 0);
  set_wugong("duanshi-neigong", 150, 150, 1);
  set_wugong("blade", 170, 170, 0);
  set_wugong("kuaige-dao", 150, 150, 0);
  set_wugong("zuiliu-dao", 130, 130, 1);
  set_wugong("haofeng-quan", 130, 130, 0);
  set_wugong("zhuifeng-quan", 100, 100, 1);
  set_wugong("tianhong", 150, 150, 0);
  set_wugong("shenxing", 130, 130, 1);
  set_wugong("yanbodiaoke", 100, 100, 1);

  set_xiuwei_by_type("blade", 750);
  set_xiuwei_by_type("unarmed", 750);
  set_xiuwei_by_type("dodge", 750);
  set_xiuwei_by_type("whip", 900);
  set_xiuwei_by_type("zonggang", 750);

  set("env/attack", 55);

  create_family("镇南王府", 1, "卫护");

  setup();

  carry_object(CLONE_DIR "wear/boots/wuyun_xue")->wear();
  carry_object(CLONE_DIR "wear/waist/chahe_luandai")->wear();
  carry_object(CLONE_DIR "wear/cloth/baizhu_sipao")->wear();
  carry_object(CLONE_DIR "wear/head/qingsha_jin")->wear();
  carry_object(__DIR__ "obj/tiegan")->wield();
}
#include "weihu.h";
#include "teach.h";
