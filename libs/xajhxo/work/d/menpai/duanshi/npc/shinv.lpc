// /d/menpai/duanshi/npc/shinv.c
// By lala on July 19, 1997

#include <ansi.h>
inherit NPC;
string *first_name = ({
  "如", "若", "慧", "素", "贤", "佳", "文", "淑", "瑞", "妙", "柔", "翠", "筱",
});

string *first_id = ({
  "ru", "ruo", "hui", "su", "xian", "jia", "wen", "shu", "rui", "miao", "rou", "cui", "xiao",
});

string *last_name = ({
  "梅", "兰", "竹", "菊", "云", "雨", "雾", "雯", "雪", "玫", "玉", "敏", "萍",
});

string *last_id = ({
  " mei", " lan", " zhu", " ju", " yun", " yu", " wu", " wen", " xue",
  " mei", " yu", " min", " ping",
});

void create() {
  string name, id;
  int i, j;
  i = random(sizeof(first_name));
  j = random(sizeof(last_name));
  name = first_name[i];
  name += last_name[j];
  id = first_id[i];
  id += last_id[j];


  set_name(name, ({ id }));
  set("title", HIY "镇南王府侍女" NOR);
  set("gender", "女性");
  set("age", 15 + random(15));
  set("per", 20 + random(15));
  set("combat_exp", 2000 + random(10) * 100);
  set("class", "duanshi");
  set("max_force", 100);
  set("force", 100);
  set("force_factor", 5);

  set_wugong("duanshi-neigong", 30 + random(20), 40, 1);
  set_wugong("unarmed", 30 + random(20), 40, 1);
  set_wugong("jiben-qinggong", 30 + random(20), 40, 1);

  set_xiuwei_by_type("unarmed", 45);
  set_xiuwei_by_type("dodge", 45);

  set("env/attack", 45);

  create_family("镇南王府", 2, "侍女");

  setup();

  switch (random(6)) {
    case 0:
      carry_object(CLONE_DIR "wear/cloth/choushan")->wear();
      break;
    case 1:
      carry_object(CLONE_DIR "wear/cloth/xiaoao")->wear();
      break;
    case 2:
      carry_object(CLONE_DIR "wear/cloth/ouse_shashan")->wear();
      break;
    case 3:
      carry_object(CLONE_DIR "wear/cloth/danhuang_shayi")->wear();
      break;
    case 4:
      carry_object(CLONE_DIR "wear/cloth/yinhong_shanzi")->wear();
      break;
    case 5:
      carry_object(CLONE_DIR "wear/cloth/sahua_ao")->wear();
      break;
  }
}

void init() {
  object ob, me;
  ob = this_object();
  me = this_player();

  if (ob->can_act()
    && !ob->is_fighting()
    && me->query("class") == "duanshi") {
    remove_call_out("greeting");
    call_out("greeting", 1, me);
  }
}

void greeting(object me) {
  if (interactive(me) && environment() == environment(me)) {
    message_vision(CYN "$N对$n道了个万福：“小女子给您见礼了！您辛苦了。”\n" NOR,
      this_object(), me);
  }
}

int refuse_killing(object me) {
  me->apply_condition("kill_dali", 100);
  return 0;
}

#include "teach.h"
