#include <armor.h>
#include <ansi.h>
inherit WAIST;
void create() {
  set_name(HIR "皮腰带" NOR, ({ "pi yaodai", "yaodai", "waist" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("long", "一根牛皮腰带，上面刺着一行小字“镇南王府 段”。\n");
    set("value", 50);
    set("material", "leather");
    set("armor_prop/armor", 1);
    set("cant_sell", "啊？！这个可是镇南王府的东西呀！小的我还想多活两年呢，可不敢收！\n");
  }
  setup();
}
