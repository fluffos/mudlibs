#include <ansi.h>
inherit ITEM;
string *map = ({
  "/d/map/xinan/dadu_hebian",
});

void create() {
  set_name(CYN "巡逻腰牌" NOR, ({ "xunluo yaopai", "yao pai", "pai" }));
  set("long", "这是用来在大理国中巡逻的腰牌。\n");
  set("unit", "块");
  set("weight", 50);
  set("value", 100);
  set("cant_sell", "王府里面的东西也敢拿来卖？");
  setup();
}

void init() {
  add_action("do_give", "give");
}

int do_give(string arg) {
  string target, item;
  object who, me = this_player();

  if (!arg) return 0;
  if (sscanf(arg, "%s to %s", item, target) == 2 ||
    sscanf(arg, "%s %s", target, item) == 2) {
    if (item != "xunluo yaopai")
      return 0;
  } else return 0;
  if (!objectp(who = present(target, environment(me))))
    return 0;
  if (!living(who))
    return 0;
  if (who->query("name") != query_temp("npc_name"))
    return 0;
  message_vision("$N给$n一块" + present(item, me)->query("name") +
    "。\n$n仔细查看了一会儿，把" + present(item, me)->query("name") +
    "还给$N，点点头，示意放行了。\n", me, who);
  me->set_temp("cant_pass", 0);
  return 1;
}

string *show_map() {
  return map;
}

int valid_leave(object me, string dir) {
  int i, flag = 0;
  string name;
  object *inv;

  inv = all_inventory(environment(me));
  for (i = 0; i < sizeof(map); i++) {
    name = "/d/menpai/duanshi/" + map[i];
    if (name == file_name(environment(me)))
      map[i] = YEL "$$" NOR;
  }
  if (me->query_temp("cant_pass") == 1) {
    for (i = 0; i < sizeof(inv); i++) {
      if ((inv[i]->query("title") == YEL "镇南王府卫士" NOR
        || inv[i]->query("title") == MAG "镇南王府卫士" NOR
        || inv[i]->query("title") == RED "镇南王府卫士" NOR)
        && !userp(inv[i])
        && living(inv[i])
        &&
        ((!random(4) && !me->query_temp("cant_pass"))
          || (me->query_temp("cant_pass") == 1))) {
        me->set_temp("cant_pass", 1);
        set_temp("npc_name", inv[i]->query("name"));
        return notify_fail(inv[i]->query("name") + "拦住去路喝道：\n" +
          "“干什么的？到处转来转去，有腰牌没有啊？拿来检查！”\n");
      }
    }
  }
  return 1;
}
