inherit ITEM;

void create() {
  set_name("「横刀六式精要」", ({ "hengdaoliushi jingyao", "book", "shu" }));
  set_weight(250);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("num", "a3");
    set("long", "这是一本深入讲述横刀六式的书。\n");
    set("value", 100);
    set("material", "paper");
    set("skill", ([
      "name": "blade",
      "xiuwei_required": 10,
      "literate_required": 20,
      "gin_cost": 10 + random(10),
      "max_jibie": 70,
      "max_lingwu": 70,
      "bonus_xiuwei": 2,
      "max_xiuwei": 120,
    ]));
  }
}

#include "duan_book.h"
