// /d/menpai/duanshi/npc/cui_baiquan.c 霍先生（崔百泉）
// By lala on July 19, 1997

#include <ansi.h>
inherit NPC;

int give_money();

void create() {
  set_name("霍先生", ({ "huo xiansheng", "huo", "xiansheng", "sir" }));
  set("title", HIM "镇南王府帐房差役" NOR);
  set("long", @LONG
霍先生在镇南王府上当帐房差役已经有多年，此人邋遢嗜酒，又好赌如命，
然而他帐目上却甚是干净，所以现在仍然能在王府里帮助帐房先生管帐。
眼下帐房先生有病在身，故而霍先生暂时接手了他的工作，负责给王府的
家丁、卫士发放薪俸的活计。
LONG);
  set("gender", "男性");
  set("age", 58);
  set("class", "duanshi");
  set("attitude", "friendly");
  set("env/attack", 35);
  set("per", 10);
  set("inquiry", ([
    "薪俸": (: give_money :),
    "武功": "呵呵，糟老头子我哪会什么武功啊……这不是开玩笑嘛。",
    "酒": "喝酒？你也好这个？呵呵，万事不如杯在手啊，有空一起喝一杯。",
    "喝酒": "喝酒？你也好这个？呵呵，万事不如杯在手啊，有空一起喝一杯。",
  ]));

  set("wimpy", 70);
  create_family("镇南王府", 2, "帐房");

  setup();

  carry_object(CLONE_DIR "wear/cloth/cloth3")->wear();
}

int give_money() {
  object me = this_player();
  object ob = this_object();
  if (ob->query("id") == "huo xiansheng" && ob->can_act()) {
    if (environment(ob)->query("short") == "王府帐房") {
      if (me->query("class") != "duanshi") {
        command("? " + me->query("id"));
        command("say “这位朋友取笑了，王府上怎么会有您的薪俸呢？”");
      } else {
        if (me->query("marks/段/已支取薪俸时间") == me->query("age")) {
          message_vision("$N从帐柜里翻出一本厚厚的帐簿查看起来……\n", ob);
          command("look " + me->query("id"));
          command("say “对不起，您看，帐簿上记着您今年的薪俸已经支取过啦。”");
        } else {
          message_vision("$N从帐柜里翻出一本厚厚的帐簿查看起来……\n", ob);
          message_vision("$N抓起一把红木算盘，劈里啪啦地打起来，一边打嘴里还一边嘟囔……\n", ob);
          remove_call_out("do_pay");
          call_out("do_pay", 5, me);
        }
      }
    } else {
      command("say “喔，这个……回头你到帐房来找我吧。”");
    }
    return 1;
  } else {
    return 0;
  }
}
int do_pay(object me) {
  object n_money, ob = this_object();
  int amount;
  string kind;

  if (!present(me, environment(ob))) return 0;
  else {
    message_vision("$N算完了帐，对$n点一点头，笑道：“啊，这是您今年的薪俸，拿好了。”\n", ob, me);
    switch (me->query("title")) {
      case "大理国武官":
        kind = "gold";
        amount = 31;
        break;
      case YEL "镇南王府卫士" NOR:
        kind = "gold";
        amount = 15;
        break;
      case MAG "镇南王府卫士" NOR:
        kind = "gold";
        amount = 7;
        break;
      case RED "镇南王府卫士" NOR:
        kind = "gold";
        amount = 3;
        break;
      case CYN "镇南王府家丁" NOR:
        kind = "silver";
        amount = 19;
        break;
      case BLU "镇南王府家丁" NOR:
        kind = "silver";
        amount = 9;
        break;
      case "镇南王府家丁":
        kind = "silver";
        amount = 4;
        break;
      case "镇南王府见习家丁":
        kind = "coin";
        amount = 99;
        break;
    }
    me->set("marks/段/已支取薪俸时间", me->query("age"));
    n_money = new(CLONE_DIR "money/" + kind);
    n_money->move(me);
    n_money->add_amount(amount);
    message_vision("$N交给$n一些钱。\n", ob, me);
  }
  return 1;
}

int refuse_killing() {
  object ob = this_object();
  object me = this_player();
  me->apply_condition("kill_dali", 150);
  if (ob->query("id") == "huo xiansheng") {
    remove_call_out("check_life");
    call_out("check_life", 2);
  }
  return 0;
}

void check_life() {
  object obj, ob = this_object();
  object me = this_player();
  if ((((int)ob->query("kee")) > ((int)ob->query("max_kee") * 0.7))
    || !ob->can_act()) {
    call_out("check_life", 2);
  } else {
    set_hp("kee", 500);
    set_hp("sen", 500);
    set("max_force", 1000);
    set("force", 1000);
    set("force_factor", 200);
    message_vision(RED @LONG

突然$N眼中精光直射，仿佛变了一个人。他怒喝道：“好啊，看来你是非要

取崔某的性命了！嘿嘿，崔某也不是白给的，拿命来！～”

LONG NOR, ob);
    set_name("崔百泉", ({ "cui baiquan", "cui", "baiquan" }));
    set("nickname", YEL "金算盘" NOR);
    set_wugong("zhuifeng-quan", 100, 100, 1);
    set_wugong("baisheng-bian", 100, 100, 1);
    set_wugong("feiyan-gong", 60, 60, 1);
    set_wugong("ke-xinfa", 100, 100, 1);
    delete("wimpy");
    set("combat_exp", 80000);
    set("social_exp", 600000);
    set("positive_score", 20000);

    set_xiuwei_by_type("unarmed", 600);
    set_xiuwei_by_type("whip", 800);
    set_xiuwei_by_type("dodge", 600);
    set_xiuwei_by_type("short", 1000);
    set("per", 20);
    obj = new(__DIR__ "obj/suanpan");
    obj->move(ob);
    command("wield suanpan");
    set_leader(me);
    set("env/attack", 60);
    remove_call_out("run_away");
    call_out("run_away", 15, ob);
  }
}

int run_away(object ob) {
  if (!ob) return 0;
  else {
    message_vision(YEL @LONG
$N看看四周，突然全身一纵，跃墙而走，不知所去……
LONG NOR, ob);
    destruct(ob);
  }
}
