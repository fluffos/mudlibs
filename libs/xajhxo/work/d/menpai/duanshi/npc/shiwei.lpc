#include <ansi.h>
inherit NPC;

void create() {
  set_name(YEL "皇宫侍卫" NOR, ({ "shi wei", "wei" }));
  set("title", "");
  set("age", 22);
  set("gender", "男性");
  set("str", 40);
  set("per", 25);
  set("combat_exp", 100000);
  set_wugong("lingxiao-shou", 100, 100, 1);
  set("force_factor", 20);
  set("chat_chance_combat", 10);
  set("chat_msg_combat", ({
    YEL "皇宫侍卫喝道：何方奸贼，竟敢硬闯皇宫？\n" NOR,
    YEL "皇宫侍卫喝道：来人哪，有反贼！\n" NOR,
  }));
  setup();
  carry_object(__DIR__ "obj/junfu")->wear();
  carry_object(__DIR__ "obj/kaijia")->wear();
  carry_object(__DIR__ "obj/toukui")->wear();
  carry_object(__DIR__ "obj/yaopai")->wear();
}

int accept_fight(object me) {
  this_player()->apply_condition("kill_dali", 200);
  command("say 我看你今天是活得不耐烦了," + RANK_D->query_rude(me) + ",去死吧！\n");
  kill_ob(me);
  return 1;
}

int refuse_killing() {
  object me = this_player();
  me->apply_condition("kill_dali", 200);
  return 0;
}

void init() {
  ::init();
  if (can_act()) {
    remove_call_out("greeting");
    call_out("greeting", 1);
  }
}

void greeting() {
  object me = this_player();
  if (me->query_condition("kill_dali")) {
    message_vision("$N对着$n大喝一声：“杀人放火的强盗，快快受死吧！！！” \n", this_object(), me);
    kill_ob(me);
  }
}
