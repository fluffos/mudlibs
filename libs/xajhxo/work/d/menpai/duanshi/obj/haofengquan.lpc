// haofengquan.c 2
inherit ITEM;
void create() {
  set_name("浩风拳谱", ({ "haofeng quanpu", "shu", "book" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "这就是浩风拳的拳谱，看起来已经颇陈旧了。\n");
    set("value", 270);
    set("material", "paper");
    set("skill", ([
      "name": "haofeng-quan",
      "xiuwei_required": 100,
      "literate_required": 20,
      "gin_cost": 10 + random(10),
      "max_jibie": 70,
      "bonus_jilei": 0,
      "bonus_xiuwei": 2,
      "max_xiuwei": 300,
      "bonus_combat_exp": 10,
      "max_combat_exp": 2000,
      "bonus_social_exp": 0,
      "max_social_exp": 0,
    ]));
  }
}
