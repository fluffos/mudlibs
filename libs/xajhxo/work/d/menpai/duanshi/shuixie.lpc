#include <room.h>
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "水榭");
  set("long", @LONG
这是一座漂亮的木制建筑，座落在水中，通过一座曲桥通向花园。水榭顶上
是八檐飞角，挂着镏金的风铃，微风拂过发出悦耳的声音。居中是张石制的圆桌，
几个石凳环绕周围。从这里往出去，是周围娇艳的茶花和明媚的湖光。镇南王爷
时常在这里招待贵客，赏花饮酒，赋诗作对。听说连皇上也很喜欢这里呢。
LONG
  );
  set("exits", ([
    "out": __DIR__ "huayuan1",
  ]));
  set("objects", ([
    __DIR__ "npc/zhu_wanli": 1,
    __DIR__ "npc/shinv": 2,
  ]));
  setup();
  replace_program(ROOM);
}
