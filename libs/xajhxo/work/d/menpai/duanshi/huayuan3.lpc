#include <room.h>
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", GRN "后花园" NOR);
  set("long", @LONG
这里就是镇南王府的后花园，到处是奇花异草，大理盛产茶花，王府里的花
匠是个老头，平时话不多，却把个后花园的茶花侍弄的千姿百态，“十八学士”、
“抓破美人脸”、“落第秀才”等名花应有尽有。很得小王爷的器重。常来此跟
他探讨花经。花园北面是个小湖，远远望去，湖中央有座屋顶在阳光下闪光。
LONG
  );
  set("exits", ([
    "south": __DIR__ "huayuan5",
    "west": __DIR__ "huayuan2",
  ]));
  set("objects", ([
    __DIR__ "npc/shinv": random(2),
    __DIR__ "npc/shinv2": random(2),
  ]));
  set("outdoors", "dali");
  setup();
}
