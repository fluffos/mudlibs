#include <room.h>
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "夹道");
  set("long", @LONG
你走在一条寂静的夹道上，下面是青砖铺地，两旁是红色的高大宫墙。道路
两旁每隔一段就有一对青铜的路灯和一个用来防火的大黄铜水缸。
LONG
  );
  set("exits", ([
    "west": __DIR__ "jiadao1",
    "east": __DIR__ "yueliang_men4",
  ]));
  setup();
  replace_program(ROOM);
}
