#include <room.h>
#include <ansi.h>

inherit ROOM;

string *things = ({
  CLONE_DIR + "eat/fruit/guiyuan",
  CLONE_DIR + "eat/fruit/mangguo",
  CLONE_DIR + "eat/fruit/lizhi",
  CLONE_DIR + "eat/fruit/yangmei",
});

void create() {
  set("short", YEL "佛堂" NOR);
  set("long", @LONG
这是王府里的大佛堂。大理是个佛教国家，上至皇帝下至黎庶，人人信奉佛
教。这座佛堂里供着如来金身，旁边配祀的是如来二位弟子。佛前摆放着四色供
果，屋里的香炉点着檀香，四周挂着杏黄色的幔帐。
LONG
  );
  set("exits", ([
    "south": __DIR__ "zoulang24",
    "east": __DIR__ "zoulang23",
    "west": __DIR__ "zoulang9",
  ]));
  set("objects", ([
    __DIR__ "npc/jiading1": 1,
  ]));
  set("search_things", ([
    "供果": things[random(sizeof(things))],
  ]));
  setup();
  replace_program(ROOM);
}
