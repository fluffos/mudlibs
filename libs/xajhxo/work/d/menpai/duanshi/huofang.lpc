// room:/d/menpai/duanshi/huofang.c  writen by lala July-25-97

#include <room.h>
#include <ansi.h>

inherit ROOM;

string *chat_msg = ({
  "厨师摇着头，一边干活一边嘟囔：“哼，这么多吃饭的，就我一个做饭的，怎么忙得过来？”\n",
  "厨师叹了口气：“哎，象人家在王爷小厨房里的，那么几个人吃饭就好几个人伺候着……”\n",
  "“段管事还算是体贴咱们兄弟，给了几个钱补贴……”，厨师掂了掂一把铜钱。\n",
  "厨师冲着帮忙的家丁大叫：“唉，就不能把火再烧旺一点吗？这点钱也不是白拿的啊！”\n",
  "厨师忙着指挥那些帮忙的家丁，不停的走来走去。\n",
  "一个家丁站起身来，厨师看了看他，数给他一些铜钱。\n",
});

void create() {
  set("short", "伙房");
  set("long", @LONG
这是王府的大伙房，所有家丁和卫士的饭菜都是这里做出来的。靠墙是宽大
的灶台和案板，炉灶里炉火在熊熊燃烧，炉灶上的大锅在冒着热气，地上有一个
沉重的铁盖子。厨子忙得不亦乐乎，把两个帮忙的家丁支使得团团转。一般总有
几个家丁来这里帮忙，挣几个酒钱。
LONG
  );
  set("exits", ([
    "north": __DIR__ "fanting",
    "east": __DIR__ "qianyuan2",
    "south": __DIR__ "shuijing",
    "west": __DIR__ "chaifang",
    "down": __DIR__ "jiujiao",
  ]));
  set("objects", ([
    __DIR__ "npc/jiading3": 2,
    __DIR__ "npc/chushi": 1,
  ]));
  create_door("down", "沉重的铁盖子", "up", DOOR_CLOSED);
  setup();
}
void init() {
  object ob, me = this_player();
  if (me->query("class") == "duanshi"
    && (me->query("title") == "镇南王府家丁")
    && (ob = present("chu shi", this_object()))
    && ob->can_act())
    add_action("do_work", "work");
  if ((ob = present("chu shi", this_object()))
    && ob->can_act()
    && !ob->is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 3);
  }
}

void greeting() {
  object ob, me = this_player();
  if (!me || environment(me) != this_object()) return;
  message_vision(chat_msg[random(sizeof(chat_msg))], me);
  if ((ob = present("chu shi", this_object()))
    && ob->can_act()
    && (!ob->is_fighting())) {
    remove_call_out("greeting");
    call_out("greeting", 20 + random(10));
  }
}

int do_work(string arg) {
  object me;
  me = this_player();

  if (!present("chu shi", environment(me)))
    return notify_fail("现在厨师不在，过一会再来吧。\n");

  if (me->query_temp("mark/段/working"))
    return notify_fail("你已经在工作了。\n");

  if (me->query("age") < 15)
    return notify_fail("厨师看了看你，说：“小孩子凑什么热闹？！去去！”\n");

  if (me->query("sen") < 100 || me->query("gin") < 30)
    return notify_fail("厨师见你一付无精打采的样子，摇摇头说：“我看你还是"
      "回去歇着吧。”\n");

  if (query_temp_marks("worktimes") >= 10) {
    message_vision("厨师冲$N摇摇头说：“要帮忙来早点！今天的饭已经做完了。”\n", me);
    return 1;
  }
  message_vision("厨师点点头道：“好，那就开始干活吧！\n"
    "$N按照厨师的吩咐拉起风箱来.....\n", me);
  add_temp_marks("worktimes", 1);
  me->disable_command("verb", "你正在干活呢。");
  call_out("do_pay", 5, me);
  return 1;
}

void do_pay(object me) {
  object coin;
  me->receive_damage("sen", 100);
  me->receive_damage("gin", 30);
  me->enable_path();

  message_vision("$N终于结束了自己的工作，长长舒了一口气，站了起来，\n"
    "擦了擦满头的汗水。\n", me);

  me->delete_temp("mark/段/working");

  if (!present("chu shi", environment(me)))
    message_vision("$N正要跟厨师要报酬的时候却发现他已经不见了，气得大骂：\n"
      "“该死的厨师怎么能这么欺骗我们呢？我一定要把他找回来！”\n"
      "最后$N只得垂头丧气地说：“唉，又上当了。”\n", me);
  else {
    message_vision("厨师对$N点点头，“干得还不错，这点钱你就拿去吧，以后要有空\n"
      "再来帮忙干活啊！”\n", me);
    coin = new(MONEY_DIR + "coin");
    coin->set_amount(100 + random(me->query("kar")));
    coin->move(me);
  }
}
