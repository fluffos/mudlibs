#include <room.h>
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "仆从住房");
  set("long", @LONG
这是一排平房。王府里值班养马、训狗、遛鹰和放鸽子的家丁就住在这儿。
屋里有几张小床，地当间有一张大桌子，旁边是几把椅子。现在并没有人在睡
觉，这些家丁们正偷空扔把色子赌钱。
LONG
  );
  set("exits", ([
    "west": __DIR__ "dongkuayuan",
  ]));
  set("objects", ([
    __DIR__ "npc/jiading3": 1 + random(2),
    __DIR__ "npc/jiading2": 1 + random(2),
    __DIR__ "npc/jiading1": 1 + random(3),
  ]));
  setup();
}
