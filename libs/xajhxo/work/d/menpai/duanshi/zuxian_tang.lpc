#include <room.h>
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", YEL "祖先堂" NOR);
  set("long", @LONG
这里是镇南王府的祖先堂。当今皇帝段正明和镇南王段正淳这一支本不是大
理皇室的正支，但是先帝在位时发生了动乱，皇储延庆太子神秘失踪，因而当今
皇帝得以继承皇位。而这一支的先人牌位，除了今上的祖、父得以配享太庙，其
余的仍然在这里供奉着。
LONG
  );
  set("exits", ([
    "south": __DIR__ "zoulang14",
  ]));
  setup();
}
