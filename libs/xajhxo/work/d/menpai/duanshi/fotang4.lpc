#include <room.h>
#include <ansi.h>

inherit ROOM;

string *things = ({
  CLONE_DIR + "eat/fruit/guiyuan",
  CLONE_DIR + "eat/fruit/mangguo",
  CLONE_DIR + "eat/fruit/lizhi",
  CLONE_DIR + "eat/fruit/yangmei",
});

void create() {
  set("short", YEL "佛堂" NOR);
  set("long", @LONG
这是王世子的小佛堂，平素任何人不得随便入内。大理是个佛教国家，上至
皇帝下至黎庶，人人信奉佛教。这座佛堂里供着的是大肚子的弥勒佛，他挺着肥
大的肚子乐呵呵地看着大家。佛前摆放着四色供果，屋里的香炉点着檀香，四周
挂着杏黄色的幔帐。
LONG
  );
  set("exits", ([
    "south": __DIR__ "zoulang29",
  ]));
  set("objects", ([
  ]));
  set("search_things", ([
    "供果": things[random(sizeof(things))],
  ]));
  setup();
}
