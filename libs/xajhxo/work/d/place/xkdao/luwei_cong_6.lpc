///d/place/xkdao/luwei_cong.c

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", BLU "芦苇荡" NOR);
  set("long1", @LONG
面前是一片无边无际的芦苇荡，万籁俱寂，只听见你自己的脚步声和风吹芦
苇丛发出的哗哗声，偶尔还有几声鸥鸟的叫声。极目望去，风吹芦苇丛，似波浪
起伏，时而好象还有一些人影露出，不知是干什么的.....
LONG);
  set("long2", @LONG
面前是一片无边无际的芦苇荡，万籁俱寂，只听见你自己的脚步声和风吹芦
苇丛发出的哗哗声，偶尔还有几声鸥鸟的叫声。极目望去，风吹芦苇丛，似波浪
起伏，几只鸥鸟在上空徘徊，似乎在觅食.....
LONG);
  set("long3", @LONG
面前是一片无边无际的芦苇荡，万籁俱寂，只听见你自己的脚步声和风吹芦
苇丛发出的哗哗声，偶尔还有几声鸥鸟的叫声。极目望去，风吹芦苇丛，似波浪
起伏，突然远处惊起一群鸥鸟.....
LONG);
  set("not_startroom", 1);
  set("exits", ([
    "south": __FILE__,
    "north": __FILE__,
    "west": __FILE__,
    "east": __FILE__,
    "southeast": __FILE__,
    "southwest": __FILE__,
    "northeast": __FILE__,
    "northwest": __FILE__,
  ]));
  set("item_desc", ([
    "south": "从这里望去，远处还是一片无边无际的芦苇荡.....\n",
    "north": "从这里望去，远处还是一片无边无际的芦苇荡.....\n",
    "west": "从这里望去，远处还是一片无边无际的芦苇荡.....\n",
    "east": "从这里望去，远处还是一片无边无际的芦苇荡.....\n",
    "southeast": "从这里望去，远处还是一片无边无际的芦苇荡.....\n",
    "southwest": "从这里望去，远处还是一片无边无际的芦苇荡.....\n",
    "northeast": "从这里望去，远处还是一片无边无际的芦苇荡.....\n",
    "northwest": "从这里望去，远处还是一片无边无际的芦苇荡.....\n",
  ]));
  setup();
}

void init() {
  object me, room, *inv;
  int j;
  if (!room = find_object(__DIR__ "luwei_cong_6"))
    room = load_object(__DIR__ "luwei_cong_6");
  if (random(10) > 4)
    room->set("long", (string)room->query("long1"));
  else if (random(2) > 0)
    room->set("long", (string)room->query("long2"));
  else
    room->set("long", (string)room->query("long3"));
  inv = all_inventory(room);
  for (j = 0; j < sizeof(inv); j++) {
    if (!living(inv[j]))
      destruct(inv[j]);
  }
  return;
}
