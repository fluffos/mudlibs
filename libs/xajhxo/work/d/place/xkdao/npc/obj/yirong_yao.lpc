//yirong_yao.c.易容药
//data:1997.10.19
// by dan

#include <ansi.h>

inherit ITEM;

void create() {
  set_name(YEL "易容药" NOR, ({ "yirong yao", "yao" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("value", 150);
  }
  setup();
}

void init() {
  add_action("do_pretend", "pretend");
}

int do_pretend(string arg) {
  object me, who, obj;
  me = this_player();
  obj = this_object();
  if (!arg)
    return notify_fail("你想假装谁？\n");

  if (arg == "none" || arg == "cancel") {
    me->delete_temp_marks("disguise");
    me->delete_temp_marks("apply/name");
    me->delete_temp_marks("apply/id");
    me->delete_temp_marks("apply/short");
    me->delete_temp_marks("apply/long");
    me->apply_condition("mask", 0);
    message_vision("$N转身一抹脸，然后就笑嘻嘻地站在你面前。。\n", me);
    return 1;
  }

  if (me->query_temp_marks("disguise"))
    return notify_fail("你已用了易容药了.....\n");

  if (obj->query("disguise"))
    return notify_fail("这块药膏已没有用了，只能用来洗去易容..\n");

  if (!objectp(who = present(arg, environment(me))) ||
    !living(who))
    return notify_fail("你想假装谁？\n");

  tell_object(me, "你开使假装" + who->name() + "。\n");
  message_vision("$N忽然神秘地笑了一下，然后转身一抹脸。。。\n", me);
  me->set_temp_marks("apply/name", ({ who->name() }));
  me->set_temp_marks("apply/id", ({ who->id() }));
  me->set_temp_marks("apply/short", ({ who->short() }));
  me->set_temp_marks("apply/long", ({ who->long() }));
  me->apply_condition("mask", 20);
  obj->set("disguise", 1);
  return 1;
}
