#include <ansi.h>

inherit ITEM;

void create() {
  set_name(GRN "木材" NOR, ({ "mu cai", "mu" }));
  set_weight(30000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一根未加工的木材,似乎先天不足，什么也不能做。\n");
    set("unit", "根");
    set("value", 20);
    set("can_fire", 1);
  }
}
