#include <ansi.h>

inherit ITEM;

void create() {
  set_name(RED "兔肉" NOR, ({ "tu rou", "rou" }));
  set_weight(1500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一块未加工的兔肉。\n");
    set("unit", "块");
    set("value", 20);
    set("can_cook", 1);
    set("cook_name", "hare_flesh");
  }
}
