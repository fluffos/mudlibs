#include <ansi.h>

inherit NPC;

void create() {
  set_name(BLU "蛇" NOR, ({ "she" }));
  set("race", "野兽");
  set_weight(2500);
  set("age", 1);
  set("long", "一条在草丛中潜伏的毒蛇,当心它可是巨毒......\n");
  set("verbs", ({ "bite" }));
  set("combat_exp", 300000);
  setup();
}
