//haidao.c.海盗
//date:1997.10.26
// by dan

inherit NPC;

void create() {
  set_name("海盗", ({ "hai dao" }));
  set("gender", "男性");
  set("age", 30 + random(20));
  set("long",
    "这是一名横行南海的海盗...\n");
  set("combat_exp", 60000 + random(40000));
  set("social_exp", 6000 + random(4000));
  set("attitude", "peaceful");
  set_wugong("zuiliu-dao", 100, 100, 1);
  set_wugong("yanxing", 100, 100, 1);
  set_xiuwei("blade", 1000);
  set_xiuwei("unarmed", 500);
  set_xiuwei("dodge", 1000);
  setup();
  carry_object(__DIR__ "obj/7-blade")->wield();
  set("score", 5 - random(10));
}

void init() {
  add_action("do_kill", "kill");
}

int kill(object me) {
  kill_ob(me);
}
