#include <ansi.h>

inherit NPC;

void create() {
  set_name(WHT "野兔" NOR, ({ "ye tu", "tu" }));
  set("race", "野兽");
  set_weight(2500);
  set("age", 1);
  set("long", "一只活泼可爱的野兔......\n");
  set("str", 30);
  set("cor", 30);
  set("limbs", ({ "头部", "身体", "前脚", "後脚", "尾巴" }));
  set("verbs", ({ "bite", "claw" }));
  set("combat_exp", 3000);
  set("edible", 1);
  set("refine_name", "lostcony");
  set("refine_msg", "$N拎起兔子剥皮...开膛...破肚...加工成一块兔肉.\n");
  setup();
}

void init() {
  add_action("do_kill", "kill");
}

