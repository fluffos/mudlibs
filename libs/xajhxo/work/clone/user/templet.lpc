// Filename : /clone/user/templet.c
// 任务：将原来string型的autoload转换成class Item型的AutoLoad。

inherit F_DBASE;
inherit F_SAVE;

class Item {
  string BaseName;
  mixed ItemInfo;
}

mapping alias, dbase, m_jibie, m_lingwu, m_jilei, Tasks, TaskLevel;
string *autoload;
class Item * AutoLoad;

nosave string Target = 0;

void create() {
  set("id", "user object");
}

void SetTarget(string target) {
  Target = target;
  return;
}

string query_save_file() {
  if (!stringp(Target)) return 0;
  return sprintf(DATA_DIR "user/%c/%s", Target[0], Target);
}

int convert() {
  class Item item;

  if (!pointerp(autoload)) return 1;

  if (!classp(AutoLoad)) AutoLoad = ({});

  foreach (string str in autoload) {
    item = new(class Item);
    if (sscanf(str, "%s:%s", item->BaseName, item->ItemInfo) != 2) {
      item->BaseName = str;
      item->ItemInfo = 0;
    }
    AutoLoad += ({ item });
  }

  autoload = 0;
  return 1;
}
