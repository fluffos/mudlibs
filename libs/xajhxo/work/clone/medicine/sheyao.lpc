inherit ITEM;
void create() {
  set_name("蛇毒药", ({ "she yao", "pill", "yao" }));
  set_weight(30);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一枚普普通通的蛇药，外出时最好带上它。\n");
    set("unit", "枚");
    set("value", 3000);
  }
}

void init() {
  add_action("do_eat", "eat");
}

int do_eat(string arg) {
  object me;
  me = this_player();

  if (!me->can_act()) return notify_fail("你现在无法服药。\n");

  if (!arg || this_object() != present(arg, me))
    return notify_fail("你要吃什么？\n");

  if (!me->query_condition("snake_poison"))
    return notify_fail("你没有被蛇咬伤，吃蛇药是没用的。\n");

  message_vision("$N从怀里掏出一枚蛇药，吃了下去。\n", me);
  tell_object(me, "你觉得体内的毒性好象已经被控制住了。\n");

  call_out("dest_me", 1, this_object());
  me->clear_condition("snake_poison");
  return 1;
}

void dest_me(object ob) {
  destruct(ob);
}
