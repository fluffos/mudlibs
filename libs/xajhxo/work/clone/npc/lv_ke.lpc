//  标准初级旅客    /clone/npc/lv_ke.c
//  等级：
//  【巳等】小门派的弟子，江湖闲汉
//          零级修为（      ０－  １００）一级武功（    ０－  ６０）
//          经验（        ０－  ７５００）声望（          ０－         ７５）
//  By lin
//  Changed by lala, 1998-04-03

inherit NPC;

void create() {
  set_name(comm_man_name(), ({ "lv ke", "lvke", "lv", "traveller" }));
  set("title", "旅客");
  set("gender", "男性");                //性别：男
  set("age", 17 + random(60));        //年龄：17～76
  set("positive_score", 10 + random(31));         //正声望：10～40
  set("long", @LONG
    一名长途跋涉来到此地的旅客，脸上颇有风尘劳顿之态。
LONG
  );

  set_wugong("unarmed", 30, 30, 1);    //基本拳法：    一级

  set("combat_exp", 500 + random(7001));          //战斗经验：500～7500
  setup();
  carry_object(CLOTH_DIR + "mancloth1");  //一般服装
  add_money("coin", query("combat_exp") / 10);    //五十至七百五十文铜钱  
}
