inherit ZUOJI;

#include <ansi.h>

string *name = ({
  YEL "黄膘马" NOR, RED "枣红马" NOR, CYN "青骢马" NOR, REV BBLK "乌骓马" NOR, WHT "雪青马" NOR,
  HIC "菊花青" NOR, HIR "红鬃马" NOR, MAG "紫骝马" NOR, HIW "灰斑马" NOR,
});

string *id = ({
  "huangbiao", "zaohong", "qingcong", "wuzhui", "xueqing", "juhuaqing", "hongzong",
  "ziliu", "huiban",
});

void create() {
  int num = random(sizeof(name));
  string horse_name = name[num];
  string horse_id = id[num];
  set_name(horse_name, ({ horse_id + " ma", horse_id, "ma", "horse", }));
  zuoji::create();
  set("long", "这是一匹剽悍精壮的" + horse_name + "，在一般的马市上大约要值十多两银子。\n");
  set("race", "野兽");
  set("gender", "雄性");
  set("attitude", "friendly");
  setup();
  set("unit", "匹");
}
