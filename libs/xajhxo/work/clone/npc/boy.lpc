inherit NPC;

void create() {
  set_name("小男孩", ({ "xiao nanhai", "nanhai", "boy" }));
  set("gender", "男性");                //性别：男
  set("age", 7);                        //年龄：7
  set("str", 15);                       //臂力：15
  set("long", @LONG
    这是个很可爱的小男孩，正在和同伴玩耍。
LONG
  );

  set("combat_exp", 100);               //战斗经验：100

  setup();
  carry_object(CLOTH_DIR + "cloth1")->wear();       //青布衣衫
}
