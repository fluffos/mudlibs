inherit ZUOJI;

#include <ansi.h>

void create() {
  set_name(RED "枣红马" NOR, ({ "zaohong ma", "ma", "horse", }));
  zuoji::create();
  set("long", "这是一匹剽悍精壮的" RED "枣红马" NOR "，在一般的马市上大约要值十多两银子。\n");
  set("race", "野兽");
  set("gender", "雄性");
  set("attitude", "friendly");
  setup();
  set("unit", "匹");
}
