#include <ansi.h>
#include <armor.h>
inherit WAIST;
void create() {
  set_name(GRN "双股鸦青绦" NOR, ({ "yaqing tao", "yaodai", "waistband" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("value", 500);
    set("material", "silk");
    set("armor_prop/armor", 1);
  }
  setup();
}
