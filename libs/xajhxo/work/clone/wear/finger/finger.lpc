//tiezhihuan.c铁指环
//by Xujs 6.12.98
#define M_SIZE 25000
//一次最多允许显示25k
#include <armor.h>

inherit F_CLEAN_UP;
inherit FINGER;

int number, number2 = 0;  //全局变量，记录文件总数
int totalsize = 0;

void create() {
  set_name("铁指环", ({ "tie zhihuan", "zhihuan", "finger" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一枚乌铁打造的指环\n");
    set("unit", "枚");
    set("value", 50);
    set("material", "steel");
    set("armor_prop/armor", 1000);
  }
  setup();
}



private int write_file(string file);

private void rehash(string dir, int max_size) {
  int i, j;
  string *file, text;
  if (file_size(dir) == -2) {
    if (dir[sizeof(dir) - 1] != '/')
      dir += "/";
    file = get_dir(dir);
  }
  j = sizeof(file);
  for (i = 0; i < j; i++) {
    file[i] = dir + file[i];
    if (file_size(file[i]) == -2)
      rehash(file[i], max_size);
    else {
      if ((totalsize /*+ file_size( file[i] )*/) > max_size) {
        number2 = number;
        return;
      }
      number++;
      if (number > number2) {
        printf("NO:%4d  Name:%40s  Size:%d\nTotalSize: %10d\n",
          number, file[i], file_size(file[i]), totalsize);
        totalsize += file_size(file[i]);
        if (file_size(file[i]) > 8192)
          write_file(file[i]);
        else
          write(read_file(file[i]));
      }
    }
  }
}



int main(object me, string arg) {
  int i, times;
  string dir;
  number = 0;
  totalsize = 0;
  if (me->query("id") != "xujs")
    return 0;
  if (!arg || sscanf(arg, "%s to %d", dir, times) != 2)
    return notify_fail("指令格式test <目录> to <一次显示多少内容>(以k为单位)\n");

  if (file_size(dir) == -1)
    return notify_fail("没有这个目录!\n");
  //    printf("The times you input is %d\n",times);
  times *= 1000;
  if (times > M_SIZE) times = M_SIZE;
  rehash(dir, times);
  printf(
    "\nThis time over! Stop at file No:%d\nmax_size is %d\ntotal size is %d \n",
    number,
    times,
    totalsize
  );

  return 1;
}

int write_file(string file) {
  int i;
  string *text;
  if (file_size(file) < 0)
    return notify_fail("没有这个文件！\n");
  text = explode(read_file(file), "\n");
  i = sizeof(text);
  while (i--)
    write(text[i] + "\n");
  return 1;
}
