// 雪魔芋 /clone/eat/food/xuemo_yu.c
// by lala, 1997-12-16

inherit ITEM;

inherit F_FOOD;

void create() {
  set_name("雪魔芋", ({ "xuemo yu", "yu" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", @LONG
雪魔芋是四川峨嵋山的特产，鲜美可口，别有风味。
LONG
    );
    set("unit", "斤");
    set("value", 2300 + random(500));
    set("food_remaining", 15);
    set("food_supply", 80);
  }
}

int do_eat(string arg) {
  return notify_fail("这还是生的，怎么吃呀。\n");
}
