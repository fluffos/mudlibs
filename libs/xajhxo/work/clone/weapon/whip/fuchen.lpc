// 拂尘 /clone/weapon/whip/fuchen.c
// by lala, 1997-12-13

#include <ansi.h>
#include <weapon.h>

inherit WHIP;

void create() {
  set_name(CYN "拂尘" NOR, ({ "fu chen", "fuchen", "whisk" }));
  set_weight(400);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一柄通常用来掸拂灰尘的拂尘。\n");
    set("unit", "柄");
    set("value", 80);
    set("material", "skin");
  }
  init_whip(4);

  set("wield_msg", "$N从腰间抽出一柄$n握在手中。\n");
  set("unwield_msg", "$N将手中的$n别在腰间。\n");

  setup();
}
