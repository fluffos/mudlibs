// pen.c
// modified by lin 21/05/97
#include <weapon.h>
#include <armor.h>
#include <ansi.h>
inherit PEN;

void create() {
  set_name("判官笔", ({ "panguan bi", "bi", "pen" }));
  set_weight(250);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "支");
    set("long", "一支普普通通的判官笔，笔头包着铁皮。\n");
    set("value", 120);
    set("material", "wood");
  }
  init_pen(3);

  // These properties are optional, if you don't set them, it will use the
  // default values.

  set("wield_msg", "$N从怀中摸出一把$n握在手中。\n");
  set("unwield_msg", "$N将手中的$n藏入怀中。\n");

  // The setup() is required.

  setup();
}
