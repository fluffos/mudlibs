#include <register.h>
#include "include/register.h"

nosave private mapping QuitedId = ([]);
nosave private string *BannedId = ({});
nosave private string *BannedIp = ({});
nosave private string *LoginedIp = ({});
nosave private string *RegistedIp = ({});
nosave private string *BannedName = ({});

int CheckUserIp(string ip) {
  if (IsBannedIp(ip)) {
    return BANNED_IP;
  } else if (IsRegistedIp(ip)) {
    return REGISTED_IP;
  } else if (IsLoginedIp(ip)) {
#ifdef WORNING_TIME
    return WORNING_MESSAGE_IP;
#else
    return BANISH_IP;
#endif
  } else {
    return COMMON_IP;
  }
}

int CheckUserId(string id) {
  if (wiz_level(id) > 0 && !IsNewbieId(id)) {
    return WIZARD_ID;
  } else if (IsGuestId(id)) {
    return GUEST_ID;
  } else if (IsBannedId(id)) {
    return BANNED_ID;
  } else if (IsNewbieId(id)) {
    return NEWBIE_ID;
  } else if (IsQuitedId(id)) {
    return QUITED_ID;
  } else if (IsIllegalId(id)) {
    return ILLEGAL_ID;
  } else if (IsOverLoad()) {
    return OVERLOAD_ID;
  } else {
    return COMMON_ID;
  }
}

int CheckUserName(string name) {
  if (IsIllegalName(name)) {
    return ILLEGAL_NAME;
  } else if (IsBannedName(name)) {
    return BANNED_NAME;
  } else {
    return COMMON_NAME;
  }
}

void RehashQuitedId() {
  foreach (string id in keys(QuitedId)) {
    if ((QuitedId[id] + REHASH_TIME) < time()) {
      map_delete(QuitedId, id);
    }
  }
  remove_call_out("ReHashQuitedId");
  call_out("RehashQuitedId", REHASH_TIME);
}

void UserLogin(object user) {
  string ip = query_ip_number(user);
  if (!IsRegistedIp(ip)) {
    LoginedIp += ({ ip });
  }
}

void UserQuit(object user) {
  string id = user->query("id");
  string ip = query_ip_number(user);

  QuitedId[id] = time();
}

nosave void create() {
  LoginedIp = ({});
  QuitedId = ([]);
  BannedId = read_config_file(BANNED_ID_FILE);
  BannedIp = read_config_file(BANNED_IP_FILE);
  BannedName = read_config_file(BANNED_NAME_FILE);
  RegistedIp = read_config_file(REGISTED_IP_FILE);
  RehashQuitedId();
}

private int IsGuestId(string id) {
  return !(strcmp(id, "guest"));
}

private int IsBannedId(string id) {
  return 1 + member_array(id, BannedId);
}

private int IsNewbieId(string id) {
  string file_name = sprintf(DATA_DIR "login/%c/%s", id[0], id);
  if (file_size(file_name + __SAVE_EXTENSION__) < 0) {
    return 1;
  } else {
    return 0;
  }
}

private int IsQuitedId(string id) {
  if (mapp(QuitedId)) {
    return QuitedId[id];
  } else {
    return 0;
  }
}

private int IsIllegalId(string id) {
  int i;

  i = strlen(id);
  if (i < 3 || i > 12) {
    return 1;
  }
  while (i--) {
    if (id[i] < 'a' || id[i] > 'z') {
      return 1;
    }
  }
  return 0;
}

private int IsOverLoad() {
#ifdef MAX_USERS
  int player_count = 0;
  foreach (object player in users()) {
    if (environment(player))
      player_count++;
  }
  if (player_count >= MAX_USERS) {
    return 1;
  }
#endif
  return 0;
}

private int IsBannedIp(string ip) {
  if (member_array(ip, BannedIp) >= 0) {
    return 1;
  } else {
    foreach (string bIp in BannedIp) {
      if (strsrch(ip, bIp) >= 0) {
        return 1;
      }
    }
  }
  return 0;
}

private int IsRegistedIp(string ip) {
  return 1 + member_array(ip, RegistedIp);
}

private int IsLoginedIp(string ip) {
  return 1 + member_array(ip, LoginedIp);
}

private int IsIllegalName(string name) {
  int i;

  i = strlen(name);

  if ((strlen(name) < 4) || (strlen(name) > 12)) {
    write("对不起，你的中文名字必须是 2 到 6 个中文字。\n");
    return 0;
  }
  while (i--) {
    if (name[i] <= ' ') {
      write("对不起，你的中文名字不能用控制字符。\n");
      return 0;
    }
    if (i % 2 == 0 && !is_chinese(name[i..<0])) {
      write("对不起，请您用「中文」取名字。\n");
      return 0;
    }
  }
  return 1;
}

private int IsBannedName(string name) {
  if (member_array(name, BannedName) != -1) {
    return 0;
  }
  return 1;

}

string *read_config_file(string file_name) {
  string file, *result = ({});

  file = read_file(file_name);
  if (!stringp(file)) return result;
  foreach (string line in explode(file, "\n")) {
    if (line[0..0] == "/"
      || line[0..0] == "#"
      || line[0..0] == "\n") {
      continue;
    } else {
      line = replace_string(line, ",", " ");
      foreach (string word in explode(line, " ")) {
        result += ({ word });
      }
    }
  }
  return result;
}
