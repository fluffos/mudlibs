#define USER_DATA               DATA_DIR "user/"

varargs mixed *filter_gift(string gift, mixed condition, int amount) {
  function user_cond;
  if (funtionp(condition)) user_cond = condition;
  if (intp(condition)) amount = condition;
  if (!amount) amount = 10;
  comp_cond = function() {};
}

varargs mixed *filter_candidate(mixed arg1, mixed arg2, int amount) {
  mixed *TopTen = ({});
  object *candidates = ({});
  function user_cond, comp_cond;

  if (functionp(arg1) && functionp(arg2)) {
    user_cond = arg1;
    comp_cond = arg2;
    if (!amount) amount = 10;
  } else
    return 0;
  message("system", "\n 整理玩家存档中，请稍候...\n", users());
  foreach (string id in evaluate(function()
    {
      string *all_id;
      all_id = ({});
      foreach (string dir in get_dir(USER_DATA))
        all_id += get_dir(USER_DATA + dir + "/*" + __SAVE_EXTENSION__);
      return all_id;
    })) {
    object user;
    if (id[<2..] == __SAVE_EXTENSION__) id = id[0..<3];
    if (wiz_level(id)) continue;
    user = new(USER_OB);
    seteuid(id);
    export_uid(user);
    seteuid(getuid());
    user->set("id", id);
    user->restore();
    if (evaluate(user_cond, user)) {
      candidates += ({ user });
    } else {
      destruct(user);
    }
  }
  if (sizeof(candidates))
    candidates = sort_array(candidates, comp_cond);
  TopTen = allocate(amount);
  for (int i = 0; i < sizeof(candidates); i++) {
    TopTen[i] = candidates[i];
    if (i > amount)
      destruct(candidates[i]);
  }
  return TopTen;
}
