// /system/daemon/autod.c
// Amber reedit on 1997-12-01
/*  
    功能函数只有一个AcclaimAction:
    actor是动作的发出者，acceptor是被触动者（如果有的话） 
    verb是执行的指令名称，status是附加的带入参数。 
    可以被执行的函数在能够被检查到的物品上以"EnvEffect/"+verb形式储存为一个 
    mapping，格式为： 
        "int_level" : n,-----------中断级别 
        "funcname"    : string,------函数名称 
        "funcfile"    : file,--------被调用的函数所在的文件 
    或者为： 
        "int_level" : n,
        "funcname"  : (: function :),-----函数名称 
    被调用的函数应该是int型。 
    执行中如果调用以上的函数成功且int_level>0，则中断原来的命令的执行。 
    对于同样可以作用于这次动作的多个函数，int_level高的可以阻断int_level低的 
    函数 的执行，且不被int_level低的函数所阻断。 
    最后如果所有中断都为0级，则原命令继续执行，否则中断原命令。 
    被调用函数格式为:
    int funcname( object actor, object acceptor, mixed status ); 
*/
// Amber reEdit on 1998-04-25 15:45
// 正式试验插接入XO。

inherit F_DBASE;
inherit F_CLEAN_UP;

int AcclaimAction(object actor, object acceptor, string verb, mixed status);
void eventAfterAction(object actor, object acceptor, string verb, mixed status);
private mapping *AddEffect(object effector, string verb, mapping *effect);
private mapping *SortEffect(mapping *effect);
private void report(string arg);

void create() {
  set("name", "中断处理器");
  set("id", "auto_d");
  seteuid(getuid());
}

// 我们先去掉这个acceptor，应该用不着。 Amber 1998-04-25 09:22
int AcclaimAction(object actor, object acceptor, string verb, mixed status) {
  mapping *effect, tmp;
  object ActEnv, AccEnv, env, *inv, ob;
  int level;  //中断级别
  mixed i;

  // collect all information for the effection of this action.
  // actor身上的实际相当于附加命令。
  // actor理论上是应该有环境的。
  ActEnv = environment(actor);
  AccEnv = environment(acceptor);
  // 得到最终环境
  env = actor;
  while (environment(env)) {
    env = environment(env);
  }
  if (!env)
    return 0;
  if (env = ActEnv || env == AccEnv)
    effect = AddEffect(env, verb, effect);
  effect = AddEffect(actor, verb, effect);
  if (actor != acceptor)
    effect = AddEffect(acceptor, verb, effect);
  // 寻找方法：如果ob和actor或acceptor同处于一个环境中，那么就应该可以
  // 参加连锁反应。Amber 1998-04-25 16:58
  foreach (ob in (deep_inventory(env) - ({ actor, acceptor }))) {
    if (environment(ob) == ActEnv)
      effect = AddEffect(ob, verb, effect);
    else if (actor == acceptor)
      continue;
    else if (environment(ob) == AccEnv)
      effect = AddEffect(ob, verb, effect);
  }

  if (!effect)
    return 0;

  // Now go on to make effect
  //  先要按照中断优先级高低排序
  effect = SortEffect(effect);
  // 执行
  level = 0;
  foreach (mapping act in effect) {
    if (level > act["int_level"])
      break;
    if (functionp(act["funcname"])
      && intp(i = evaluate(act["funcname"], actor, acceptor, status)) && i)
      if (!level)
        level = act["int_level"];
      else if (act["funcfile"]
        && call_other(act["funcfile"], act["funcname"], actor, acceptor, status))
        // 这里只传送动作的双方，需要什么参数由执行的函数自己去query得了。
        if (!level)
          level = act["int_level"];
    // 执行成功（就是说必须返回大于0，我想不出好办法了）
  }
  report("level is " + level);
  report("actor is " + actor->name());
  return level;
}

void eventAfterAction(object actor, object acceptor, string verb, mixed status) {}

mapping *AddEffect(object effector, string verb, mapping *effect) {
  mapping tmp;
  if (!arrayp(effect))
    effect = ({});
  if (tmp = effector->query_temp("EnvEffect/" + verb))
    effect += ({ tmp });
  else if (tmp = effector->query("EnvEffect/" + verb))
    effect += ({ tmp });
  return effect;
}

// 将effect中的中断按照优先级别排序。Amber 1998-04-25 17:14
// TODO：冒泡法也太土了，得换个好一点儿的。Amber 1998-04-26 19:38
mapping *SortEffect(mapping *effect) {
  mapping tmp;
  int i, j;
  for (i = 0; i < (sizeof(effect) - 1); i++)
    for (j = i + 1; j < sizeof(effect); j++)
      if (effect[j]["int_level"] > effect[i]["int_level"]) {
        tmp = effect[i];
        effect[i] = effect[j];
        effect[j] = tmp;
      }
  return effect;
}

private void report(string arg) {
  object ob;
  if (!ob = LOGIN_D->find_body("amber"))
    return;
  if (ob->query("no_report"))
    return;
  tell_object(ob, arg + "\n");
  return;
}
