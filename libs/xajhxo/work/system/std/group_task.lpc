#include "include/group_task.h"

inherit TASK;

private int Level;
private string MasterName;

void SetLevel(int iLevel) {
  Level = iLevel;
}

int GetLevel() {
  return Level;
}

void SetMasterName(string sName) {
  MasterName = sName;
}

string GetMasterName() {
  return MasterName;
}

void TaskBegin(object ppl) {
  if (intp(this_object()->GetBonus("BeginningAct"))) {
    int bonus = (int)this_object()->GetBonus("BeginningAct");
    ppl->AddZuzhiScore(GetGroupName(), bonus);
  }
  task::TaskBegin(ppl);
}

void TaskSuccess(object ppl) {
  if (intp(this_object()->GetBonus("SuccessAct"))) {
    int bonus = (int)this_object()->GetBonus("SuccessAct");
    ppl->AddZuzhiScore(GetGroupName(), bonus);
  }
  task::TaskSuccess(ppl);
}

void TaskFail(object ppl) {
  if (objectp(ppl) && intp(this_object()->GetBonus("FailAct"))) {
    int bonus = (int)this_object()->GetBonus("FailAct");
    ppl->AddZuzhiScore(GetGroupName(), bonus);
  }
  task::TaskFail(ppl);
}

int CanBegin(object ppl) {
  string GroupName = GetGroupName();
  if (ppl->GetTaskLevel(GroupName) > Level) {
    return 0;
  } else if (MasterName != "joker" && !find_object(MasterName)) {
    return 0;
  } else {
    return task::CanBegin(ppl);
  }
}

int CanEnd(object ppl) {
  string GroupName = GetGroupName();
  if (MasterName != "joker" && !find_object(MasterName)) {
    return 0;
  } else {
    return task::CanEnd(ppl);
  }
}

nosave void create() {
  task::create();
  Level = 0;
  MasterName = "joker";
}

nosave void heart_beat() {
  task::heart_beat();
  if (MasterName != "joker" && !find_object(MasterName)) {
    TaskEnd();
  }
}
