int do_sell(string arg) {
  object ob, who;
  int value, value1, value2;
  who = this_player();

  if (query_temp("busy"))
    return notify_fail("伙计生气地说：“着什么急，我正忙呢！”\n");

  if (!arg || !(ob = present(arg, who)))
    return notify_fail("你要卖断什麽物品？\n");

  if (ob->query("money_id"))
    return notify_fail("你要卖「钱」？\n");

  if (ob->is_food())
    return notify_fail("食物不便保存，不予收购。\n");

  value = ob->query("value");
  if (value > 10000000) {
    value1 = (value / 100) * 60;
    value2 = (value / 100) * 80;
  } else {
    value1 = value * 60 / 100;
    value2 = value * 80 / 100;
  }
  if (!value)
    return notify_fail("这样东西不值钱。\n");

  if (ob->query("cant_sell"))
    return notify_fail((string)ob->query("cant_sell"));

  message_vision("$N把身上的" + ob->query("name") + "卖了" + price_string(value2) + "。\n",
    who);

  destruct(ob);
  pay_player(who, value2);

  set_temp("busy", 1);
  //who->start_busy(1);
  remove_call_out("dest");
  call_out("dest", 1, who);

  return 1;
}

int do_convert(string arg) {
  string from, to, name, unit;
  int amount, bv1, bv2;
  object from_ob, to_ob, who;
  who = this_player();

  if (query_temp("busy"))
    return notify_fail("伙计生气地说：“着什么急，我正忙呢！”\n");
  if (!arg || sscanf(arg, "%d %s to %s", amount, from, to) != 3)
    return notify_fail("指令格式：convert <数量> <货币种类> to <货币种类>\n");

  from_ob = present(from + "_money", who);
  to_ob = present(to + "_money", who);
  if (file_size(MONEY_DIR + to + ".lpc") < 0)
    return notify_fail("你想兑换哪一种钱？\n");

  if (!from_ob)
    return notify_fail("你身上没有这种货币。\n");
  if (amount < 1)
    return notify_fail("兑换货币一次至少要兑换一个。\n");

  if ((int)from_ob->query_amount() < amount)
    return notify_fail("你身上没有那麽多" +
      from_ob->query("name") + "。\n");

  bv1 = from_ob->query("base_value");
  if (!bv1)
    return notify_fail("这种东西不值钱。\n");

  bv2 = to_ob ? to_ob->query("base_value") : call_other(MONEY_DIR + to, "query", "base_value");

  if (bv1 < bv2) amount -= amount % (bv2 / bv1);
  if (amount == 0)
    return notify_fail("这些" + from_ob->query("name") +
      "的价值太低了，换不起。\n");
  //destruct from_ob first.     
  name = from_ob->query("name");
  unit = from_ob->query("base_unit");
  if (from_ob->query_amount() == amount)
    destruct(from_ob);
  else
    from_ob->add_amount(-amount);
  if (!to_ob) {
    to_ob = new(MONEY_DIR + to);
    to_ob->move(who);
    to_ob->set_amount(amount * bv1 / bv2);
  } else
    to_ob->add_amount(amount * bv1 / bv2);

  set_temp("busy", 1);
  //who->start_busy(1);
  remove_call_out("dest");
  call_out("dest", 1, who);
  message_vision(sprintf("$N从身上取出%s%s%s，换成%s%s%s。\n",
    chinese_number(amount), unit, name, chinese_number(amount * bv1 / bv2),
    to_ob->query("base_unit"), to_ob->query("name")),
    who);

  return 1;
}

int do_save(string arg) {
  string money, name;
  int amount, value;
  object from_ob, who, mon;

  who = this_player();

  if (query_temp("busy"))
    return notify_fail("伙计生气地说：“着什么急，我正忙呢！”\n");

  if (!arg || sscanf(arg, "%d %s", amount, money) != 2)
    return notify_fail("指令格式：cun <数量> <货币种类> \n");

  if (file_size(MONEY_DIR + money + ".lpc") < 0)
    return notify_fail("这不是钱，不能存。\n");

  from_ob = present(money + "_money", who);

  if (!from_ob)
    return notify_fail("你身上没有这种货币。\n");
  if (amount < 1)
    return notify_fail("一次至少要存一个。\n");

  if ((int)from_ob->query_amount() < amount)
    return notify_fail("你身上没有那麽多" +
      from_ob->query("name") + "。\n");

  name = from_ob->query("name");
  value = from_ob->query("base_value") * amount;
  if (value > 10000000)
    value = value / 100 * 93;
  else
    value = value * 93 / 100;
  if (value < 1) {
    tell_object(who, "客官的钱实在太多了，小店不敢收，抱歉抱歉。\n");
    return 1;
  }
  //dec from_ob first.
  if ((int)from_ob->query_amount() == amount)
    destruct(from_ob);
  else
    from_ob->add_amount(-amount);
  if (!who->query("savemoney")) {
    who->set("savemoney", value);
  } else {
    who->add("savemoney", value);
  }
  if (mon = new(MONEY_DIR + "money.lpc")) {
    mon->restore();
    mon->set(who->query("id"), who->query("savemoney"));
    mon->save();
    destruct(mon);
  }
  set_temp("busy", 1);
  //who->start_busy(1);
  remove_call_out("dest");
  call_out("dest", 1, who);
  message_vision(sprintf("$N从身上取出一些%s，交给伙计存了起来。\n", name), who);
  return 1;
}

int do_load(string arg) {
  string money;
  int amount, value, basevalue;
  object to_ob, who, mon;
  who = this_player();

  if (query_temp("busy"))
    return notify_fail("伙计生气地说：“着什么急，我正忙呢！”\n");

  if (!arg || sscanf(arg, "%d %s", amount, money) != 2)
    return notify_fail("指令格式：qu <数量> <货币种类> \n");

  if (file_size(MONEY_DIR + money + ".lpc") < 0)
    return notify_fail("这不是钱，不能取。\n");
  if (amount < 1)
    return notify_fail("一次至少要取一个。\n");
  value = who->query("savemoney");
  to_ob = present(money + "_money", who);

  basevalue = to_ob ? to_ob->query("base_value") : call_other(
    MONEY_DIR + money,
    "query",
    "base_value"
  );
  if (amount * basevalue < 1)
    return notify_fail("抱歉，您取的太多了，小店一时拿不出来。\n");

  if (value < (amount * basevalue))
    return notify_fail("你没有存那么多钱.\n");
  set_temp("busy", 1);
  //who->start_busy(1);
  remove_call_out("dest");
  call_out("dest", 1, who);
  message_vision("伙计交给$N一些钱，说：“您收好！”。\n", who);
  pay_player(who, amount * basevalue);
  who->add("savemoney", -amount * basevalue);
  if (who->query("savemoney") < 0)
    who->set("savemoney", 0);
  if (mon = new(MONEY_DIR + "money.lpc")) {
    mon->restore();
    mon->set(who->query("id"), who->query("savemoney"));
    mon->save();
    destruct(mon);
  }
  return 1;
}

int do_check() {
  int value;
  object who, mon;

  who = this_player();
  value = who->query("savemoney");
  if (value < 0) {
    who->delete("savemoney");
    value = 0;
  }
  if (!value || value == 0)
    return notify_fail("你根本就没存过钱，查什么帐？！\n");
  printf("你在钱庄里共存有%s.\n", value_string(value));
  if (mon = new(MONEY_DIR + "money.lpc")) {
    mon->restore();
    mon->set(who->query("id"), who->query("savemoney"));
    mon->save();
    destruct(mon);
  }
  return 1;
}

int dest(object ob) {
  delete_temp("busy");
}
