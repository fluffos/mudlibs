// filename : /std/sserver.c

inherit F_CLEAN_UP;

// This function selects a random target for offensive spells/functions.
object offensive_target(object me) {
  int sz;
  object *enemy;
  mixed target;

  enemy = me->query_enemy();
  if (!enemy || !arrayp(enemy)) return 0;

  sz = sizeof(enemy);
  if (sz > 4) sz = 4;

  if (sz <= 0) return 0;

  target = enemy[random(sz)];
  if (objectp(target))
    return target;
  else if (stringp(target) && objectp(target = present(target, environment(me))))
    return target;
  else 0;
}
