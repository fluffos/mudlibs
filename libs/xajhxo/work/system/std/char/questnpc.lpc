// questnpc.c
// edit by Lin
#define QUEST(x) ("/d/city/nanyang/quest/"+x)
#include <ansi.h>

string *refuse_msg = ({
  "现在没什么事做，你先下去练功吧。\n",
});

inherit NPC;

void create() {}

void init() {
  ::init();
  add_action("give_quest", "quest");
}
//modify qyz 1997-3-26 in /d/wuliang/npc/zuo.c
//i picked it to here .
int give_quest() {
  mapping quest;
  object me, ob;
  me = this_player();
  ob = this_object();
  if (me->query("family/family_name") != this_object()->query("family/family_name")) {
    tell_object(me, ob->name() + "疑惑地看着你：“这位" + RANK_D->query_respect(me) + "想要做什么？”\n");
    return 1;
  }
  if (quest = me->query("quest")) {
    if (me->query("done_quest") == quest["quest"]) {
      tell_object(me, quest["reward_msg"]);
      me->delete("done_quest");
      me->delete("quest");
      return 1;
    }

    else {
      if (((int)me->query("task_time")) > time())
        return 0;
      else {
        message_vision(quest["fail_msg"], me);
        me->delete("quest");
        return 1;
      }
    }
  }
  if ((int)me->query("task_time") &&
    (int)me->query("task_time") > time()) {
    message_vision(refuse_msg[random(sizeof(refuse_msg))], ob);
    return 1;
  }
  quest = QUEST("quest")->query_quest();
  tell_object(me, quest["quest_msg"]);

  me->set("quest", quest);
  me->set("task_time", (int)time() + (int)quest["time"]);
  return 1;
}

int accept_object(object who, object ob) {
  string test;
  mapping quest;
  if (!(quest = who->query("quest"))) {
    tell_object(who, ob->name() + "笑道：“你给我东西干什么？”\n");
    return 0;
  }
  if (ob->name(1) != quest["quest"] || ob->is_character()) {
    tell_object(who, ob->name() + "皱眉说：“我当初可不是让你去找这个呀！”\n");
    return 0;
  }
  // Falcon  96-08-18
  // Destory the object after it was accepted by halfgod
  //	destruct( ob );
  if ((int)who->query("task_time") < time()) {
    tell_object(who, quest["delay_msg"]);
    who->delete("quest");
    return 1;
  } else {
    tell_object(who, quest["reward_msg"]);
    who->delete("quest");
  }
}
