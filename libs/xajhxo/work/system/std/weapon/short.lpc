// filename short.c
// 
#include <weapon.h>

#ifdef AS_FEATURE
#include <dbase.h>
#else
inherit EQUIP;
#endif

varargs void init_short(int damage, int wound, int flag) {
  if (clonep(this_object()))
    return;

  set("weapon_prop/damage", damage);
  if (undefinedp(wound))
    set("weapon_prop/wound", damage);
  else set("weapon_prop/wound", wound);
  set("flag", flag | EDGED | SECONDARY);
  set("skill_type", "short");
  set("weapon_type", "short");
  //    set( "verbs", ({ "impale","point" }) );
}
