//by lnwm
//我们已经有了整体规划，该干活了。

#include <ansi.h>

nosave void heart_beat() {
  //    string* *wizlist, wiz_name;
  object ob;
  int time, last_time;

  ob = this_object();
  time = ob->query("mud_age");
  last_time = ob->query("last_time");

  //    wizlist = explode(read_file(WIZLIST), "\n");

  if (!wizardp(this_object())) return;

  //    for ( i = 0; i < sizeof( wizlist ); i++ )
  //    {
  //    }
  if ((time - last_time) > 1800) {
    tell_object(ob, YEL "狐狸奸笑着：" + geteuid(ob) + "该去干活了，你又玩了半个小时了！\n" NOR);
    ob->set("last_time", time);
  }
  return;
}
