// jinchuang-yao.c
#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration) {
  if ((int)me->query("eff_kee") < (int)me->query("max_kee"))
    me->receive_curing("kee", 10);

  me->apply_condition("jin-chuangyao", duration - 1);
  if (duration == 1)
    tell_object(me, "你伤口上敷的金创药药性已经快发挥完了\n");
  if (!duration) return 0;

  return CND_CONTINUE;
}
