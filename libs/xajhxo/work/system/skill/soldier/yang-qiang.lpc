// yang-qiang.c杨家枪法

//    晋城风雪夜，扬刀立威熊虎将
//    乾坤难转，泣主别河东
//    风乍起，九万里，鲲鹏正图举
//    豪气冲天，万马度阴山。

//    枪挑日月，蒙主恩，力当挽
//    金刀耀天辉，银枪映广寒
//    英姿久立雁门，令千万贼寇胆丧
//    南望王师，热血混青冈


inherit SKILL;

#include <ansi.h>

mapping *action = ({
  ([ "action":
    "$N一招" WHT "晋城风雪夜" NOR "，手中$w倏尔飞起，枪杆在猛力的晃动下呼呼有声，犹如一支\n"
    "神射手射出的利箭，带着势不可挡的劲力，直刺$n$l",
    "lian":
    "$N一招" WHT "晋城风雪夜" NOR "，手中$w倏尔飞起，枪杆在猛力的晃动下呼呼有声，犹如一支\n"
    "神射手射出的利箭，带着势不可挡的劲力，直刺向前",
    "jibie": 8,
    "zhaoshi": "「晋城风雪夜」",
    "sen": 4,
    "dodge": 20,
    "damage": 50,
    "damage_type": "枪伤" ]),
  ([ "action":
    "$N身形一转，飘向右方，一招" RED "背水一战" NOR "，向$n跨上一步，持枪长立，威风堂堂，右手持\n"
    "紧$w，下击横扫, 枪头晃了两晃，直刺$n$l，大有当年杨老令公力战群寇的气势",
    "lian":
    "$N身形一转，飘向右方，一招" RED "背水一战" NOR "，向$n跨上一步，持枪长立，威风堂堂，右手持\n"
    "紧$w，下击横扫, 枪头晃了两晃，直刺前方，大有当年杨老令公力战群寇的气势",
    "jibie": 16,
    "zhaoshi": "「背水一战」",
    "sen": 6,
    "dodge": 10,
    "parry": 20,
    "damage": 60,
    "damage_type": "刺伤" ]),
  ([ "action":
    "只见$N一招" YEL "沙场云遮日" NOR "，$w一抖，舞出一片枪影，风势隆隆，随之如似万道利箭的无数枪\n"
    "影重新合成一条毒龙一般的长枪，横扫$n下盘，激起一片飞土",
    "lian":
    "只见$N一招" YEL "沙场云遮日" NOR "，$w一抖，舞出一片枪影，风势隆隆，随之如似万道利箭的无数枪\n"
    "影重新合成一条毒龙一般的长枪，横扫前方，激起一片飞土",
    "jibie": 24,
    "zhaoshi": "「沙场云遮日」",
    "sen": 6,
    "dodge": 20,
    "damage": 54,
    "damage_type": "刺伤" ]),
  ([ "action":
    "又见$N持枪长立，一式" BLU "雁门惊飞鸟" NOR "，手中$w在全身力气的激发下竟然象一条蛇一般弯\n"
    "曲过来，枪尖矗立，似有冲天之势，快步迎上，用柄杆击向$n$l.",
    "lian":
    "又见$N持枪长立，一式" BLU "雁门惊飞鸟" NOR "，手中$w在全身力气的激发下竟然象一条蛇一般弯\n"
    "曲过来，枪尖矗立，似有冲天之势，快步迎上，用柄杆猛击",
    "jibie": 32,
    "zhaoshi": "雁门惊飞鸟",
    "sen": 5,
    "dodge": 40,
    "damage": 60,
    "damage_type": "刺伤" ]),
  ([ "action":
    "$N身子一侧，一招" CYN "九万里风鹏正举" NOR "，劲力使将出来，把丈许长的一柄$w舞得团团转，\n"
    "千影齐现，似乎手中的不再是直挺挺的一杆长枪，犹如活物一般，枪身向着绝不可能的方\n"
    "向刺了出去",
    "lian":
    "$N身子一侧，一招" CYN "九万里风鹏正举" NOR "，劲力使将出来，把丈许长的一柄$w舞得团团转，\n"
    "千影齐现，似乎手中的不再是直挺挺的一杆长枪，犹如活物一般，枪身向着绝不可能的方\n"
    "向刺了出去",
    "jibie": 40,
    "sen": 8,
    "zhaoshi": "「九万里风鹏正举」",
    "damage": 65,
    "parry": 60,
    "damage_type": "刺伤" ]),
  ([ "action":
    "$N一招" HIY "万马度阴山" NOR "，横枪上步，大喝一声，如有排山之势，$w对准$n$l横扫过去，\n"
    "枪尖直刺$n。虽是一人，却有万马千军之势，威不可挡",
    "lian":
    "$N一招" HIY "万马度阴山" NOR "，横枪上步，大喝一声，如有排山之势，$w对准$n$l横扫过去，\n"
    "枪尖向前直刺。虽是一人，却有万马千军之势，威不可挡",
    "jibie": 48,
    "zhaoshi": "「万马度阴山」",
    "sen": 7,
    "damage": 50,
    "parry": 50,
    "damage_type": "刺伤" ]),
  ([ "action":
    "$N一招" HIW "银枪耀天辉" NOR "，飞身闪步，手中$w有如活物一般，在空中被强劲的风势一激，竟\n"
    "然弯曲过去，出其不意地击向$n$l，枪尖在日光下放射出耀眼的光芒",
    "lian":
    "$N一招" HIW "银枪耀天辉" NOR "，飞身闪步，手中$w有如活物一般，在空中被强劲的风势一激，竟\n"
    "然弯曲过去，出其不意地击向$n$l，枪尖在日光下放射出耀眼的光芒",
    "jibie": 56,
    "zhaoshi": "「银枪耀天辉」",
    "sen": 7,
    "dodge": 30,
    "parry": 60,
    "damage": 75,
    "damage_type": "刺伤" ]),
  ([ "action":
    "$N一招" YEL "枪挑日月" NOR "，手中$w一个横扫，激起百道尘沙，劲风扑面，枪身扭曲着向前刺出\n"
    "枪尖乱颤，在滚滚黄沙中反射着耀眼的光芒",
    "lian":
    "$N一招" YEL "枪挑日月" NOR "，手中$w一个横扫，激起百道尘沙，劲风扑面，枪身扭曲着向前刺出\n"
    "枪尖乱颤，在滚滚黄沙中反射着耀眼的光芒",
    "jibie": 64,
    "zhaoshi": "「枪挑日月」",
    "sen": 7,
    "dodge": 30,
    "parry": 60,
    "damage": 75,
    "damage_type": "刺伤" ]),
});

string *parry_msg = ({
  "$n一招「背水一战」，枪身猛地弹起，反激向$N，有如出水蛟龙一般\n",
  "$n抽身而退，反手一招「豪气冲天」$v中路横扫\n",
  "$n用手中兵器一晃，闪身而退\n",
});
string *unarmed_parry_msg = ({
  "$n一招「背水一战」，枪身猛地弹起，反激向$N，有如出水蛟龙一般\n",
  "$n抽身而退，反手一招「豪气冲天」$v中路横扫\n",
  "$n用手中兵器一晃，闪身而退\n",
});
int valid_learn(object me) {
  return 1;
}

int valid_lian(object me) {
  object weapon;

  weapon = me->query_temp("weapon");
  if (!weapon || weapon->query("weapon_type") != "qiang")
    return notify_fail("你必须先找一柄枪才能练\n");

  return 1;
}

mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}


string query_xiuwei_type() {
  return "long";
}
string query_weapon_type() {
  return "qiang";
}

int query_dengji() {
  return 4;
}

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string query_zhaoshi(int jibie) {
  int i;
  for (i = 0; i < sizeof(action); i++) {
    if (action[i]["jibie"] >= jibie)
      return action[i]["zhaoshi"];
  }
  return "";
}

int query_youxiao_jibie() { return 18; }

int query_parry_ratio() { return 4; }
