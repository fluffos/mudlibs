// 铁算盘
// by lnwm 
// for 一品堂

inherit SKILL;

mapping *action = ({
  ([ "action": "$N手中$w平推而出。",
    "lian": "$N手中$w平推而出。",
    "jibie": 10,
    "sen": 4,
    "dodge": 20,
    "parry": 0,
    "damage": 20,
    "wound": 5,
    "damage_type": "瘀伤" ]),
  ([ "action": "$N手中$w向上一举，当头砸下。",
    "lian": "$N手中$w向上一举，当头砸下。",
    "jibie": 10,
    "sen": 4,
    "dodge": 20,
    "parry": 0,
    "damage": 20,
    "wound": 5,
    "damage_type": "瘀伤" ]),
});

string *parry_msg = ({
  "$n手中$v一举，就势一封。\n",
});
string *unarmed_parry_msg = ({
  "$n手中$v一举，就势一封。\n",
});

mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}

string query_xiuwei_type() {
  return "short";
}

string query_weapon_type() { return "plate"; }

// 返回这路武功的等级, 第十等返回0, 第一等返回9.
int query_dengji() {
  return 4;
}

string query_parry_msg(object weapon) {
  if (objectp(weapon))
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int query_youxiao_jibie() { return 15; }

int query_parry_ratio() { return 20; }

int valid_lian(object me) {
  object weapon;

  weapon = me->query_temp("weapon");
  if (!weapon || weapon->query("id") != "tie suanpan")
    return notify_fail("你必须先找一块算盘才能练。\n");

  return 1;
}

int valid_learn(object me) {
  if (me->query("literate") < 100)
    return notify_fail("你的文化太低，无法练这门武功。\n");
  return 1;
}
