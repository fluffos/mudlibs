inherit SKILL;

mapping *action = ({
  ([ "action":
    "$N左掌微分，右手一长使出一招「饿虎扑食」，抓向$n的$l",
    "lian":
    "$N左掌微分，右手一长使出一招「饿虎扑食」，抓向半空中......",
    "jibie": 10,
    "zhaoshi": "「饿虎扑食」",
    "sen": 5,
    "dodge": 0,
    "parry": 0,
    "damage": 40,
    "damage_type": "抓伤"
  ]),
  ([ "action":
    "$N倏地一个转身，双手一翻，一招「白虎跳涧」直掼$n下颌....",
    "lian":
    "$N倏地一个转身，双手一翻，一招「白虎跳涧」直掼假想对手的下颌....",
    "jibie": 20,
    "limb": "下颌",
    "sen": 5,
