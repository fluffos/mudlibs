    "$N身子微斜，随即跨出一步，左手忽掌忽爪使出「龙虎交会」，拍向$n的$l",
    "lian":
    "$N身子微斜，随即跨出一步，左手忽掌忽爪使出一招「龙虎交会」来。",
    "jibie": 35,
    "zhaoshi": "「龙虎交会」",
    "sen": 6,
    "dodge": 0,
    "parry": 10,
    "damage": 75,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N使出「猛虎下山」，身子一纵，双手对准$n的后心抓去",
    "lian":
    "$N使出「猛虎下山」，身子一纵，跨步上前，身形右转，双手同时向右抓去...",
    "jibie": 45,
    "zhaoshi": "「猛虎下山」",
    "sen": 8,
    "limb": "后心",
    "dodge": 10,
    "parry": 0,
    "damage": 65,
    "wound": 10,
    "damage_type": "抓伤"
  ]),
  ([ "action":
    "$N左手虚晃，右抓挂风，一招「虎虎生威」击向$n$l",
    "lian":
    "$N左手虚晃，右抓挂风，一招「虎虎生威」，出爪威猛，不怒自威....",
    "jibie": 60,
    "sen": 7,
    "zhaoshi": "「虎虎生威」",
    "dodge": 0,
    "parry": 20,
    "damage": 80,
    "wound": 15,
    "damage_type": "抓伤"
  ]),
  ([ "action":
    "$N使出「虎尾剪」，凌空跃起，冷不防在落地前对准$n$l踢出一脚",
    "lian":
    "$N使出「虎尾剪」，凌空跃起，两脚空踢下方....",
    "jibie": 70,
    "sen": 6,
    "zhaoshi": "「虎尾剪」",
    "dodge": 5,
    "parry": 30,
    "damage": 90,
    "wound": 5,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N右手在$n$l划过，随後一招「乳虎啸谷」左爪又向同一方位抓到",
    "lian":
    "$N右手斜抓前方，随後一招「乳虎啸谷」左爪又向同一方位抓到",
    "jibie": 80,
    "zhaoshi": "「乳虎啸谷」",
    "sen": 9,
    "parry": 30,
    "damage": 110,
    "wound": 10,
    "damage_type": "抓伤"
  ]),
});


string *parry_msg = ({
  "$n使出一招「虎落平阳」，躲开了$N的$w。\n",
  "$n身形急转，一式「飞虎上冈」，登时将$N的$w躲开了。\n",
  "$n一招「纵虎归山」，不战而走，向左急闪，同时右手翻出，攻向$N....\n",
});
string *unarmed_parry_msg = ({
  "$n使出一招「虎落平阳」，躲开了$N的$w。\n",
  "$n身形急转，一式「飞虎上冈」，登时将$N的$w躲开了。\n",
  "$n一招「纵虎归山」，不战而走，向左急闪，同时右手翻出，攻向$N....\n",
});
int valid_learn(object me) {
  if ((int)me->query("max_force") < 600)
    return notify_fail("你的内力太弱，无法练虎爪功。\n");
  return 1;
}

int valid_lian(object me) {
  object weapon;

  weapon = me->query_temp("weapon");
  if (weapon)
    return notify_fail("你必须先把手中的兵刃放下。\n");

  return 1;
}

mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}


string query_parry_msg(object weapon) {
  if (objectp(weapon))
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string query_xiuwei_type() {
  return "unarmed";
}

// 返回这路武功的等级, 第十等返回0, 第一等返回9.
int query_dengji() {
  return 4;
}

string query_zhaoshi(int jibie) {
  int i;
  for (i = 0; i < sizeof(action); i++) {
    if (action[i]["jibie"] >= jibie)
      return action[i]["zhaoshi"];
  }

  return "";
}

int query_youxiao_jibie() { return 15; }

int query_parry_ratio() { return 5; }
