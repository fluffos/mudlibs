//dinnan-dao
//定难刀法;
inherit SKILL;

mapping *action = ({
  ([ "action": "$N一招「国家有难为忠烈」，大义凛然，手中$w径直砍向$n$l!",
    "lian": "$N手中$w堂堂正正攻出，正是一招起手式「国家有难为忠烈」。",
    "jibie": 10,
    "zhaoshi": "「国家有难为忠烈」",
    "sen": 5,
    "dodge": 0,
    "parry": 0,
    "damage": 50,
    "wound": 30,
    "damage_type": "砍伤" ]),
  ([ "action":
    "$N奋力一刀「敢教一死报君王」，迅捷无伦地劈向$n$l...",
    "lian":
    "$N奋力一刀「敢教一死报君王」，迅捷无伦地劈向前方...",
    "jibie": 25,
    "zhaoshi": "「敢教一死报君王」",
    "sen": 5,
    "dodge": 0,
    "parry": 0,
    "wound": 50,
    "damage_type": "劈伤" ]),
  ([ "action":
    "又见$N揉身而上，抢步俯身，一刀「万里黄沙觅封侯」向$n左腿斩去......",
    "lian":
    "又见$N揉身而上，抢步俯身，一刀「万里黄沙觅封侯」向下斩去......",
    "jibie": 40,
    "limb": "左腿",
    "zhaoshi": "「万里黄沙觅封侯」",
    "sen": 7,
    "dodge": 0,
    "parry": 10,
    "damage": 40,
    "wound": 40,
    "damage_type": "割伤" ]),
  ([ "action":
    "但见$N使出一招「投笔从戎渡关山」，刀光挟着风势冲向$n的$l",
    "lian":
    "但见$N使出一招「投笔从戎渡关山」，刀光挟着风势冲向前方....",
    "jibie": 55,
    "zhaoshi": "「投笔从戎渡关山」",
    "sen": 5,
    "dodge": 10,
    "parry": 5,
    "wound": 60,
    "damage_type": "砍伤" ]),
  ([ "action":
    "$N身子一侧，一招「生为人杰死鬼雄」，大步向前，刀锋转圆，直削$n前胸......",
    "lian":
    "$N身子一侧，一招「生为人杰死鬼雄」，大步向前，刀锋转圆，直削$n前胸......",
    "jibie": 70,
    "sen": 6,
    "limb": "前胸",
    "zhaoshi": "「生为人杰死鬼雄」",
    "wound": 90,
    "parry": 22,
    "damage_type": "刀伤" ]),
  ([ "action":
    "$N一招「剑光如电气如虹」，大喝一声，刀光一闪，化刀为剑刺向$n胸口",
    "lian":
    "$N一招「剑光如电气如虹」，大喝一声，刀光耀眼，化刀为剑刺出",
    "jibie": 85,
    "limb": "胸口",
    "zhaoshi": "「剑光如电气如虹」",
    "sen": 6,
    "dodge": 20,
    "damage": 30,
    "wound": 70,
    "damage_type": "刺伤" ]),
  ([ "action":
    "$N使出最后一招「马革裹尸再朝天」全力以赴，势如疯虎一般连刀带人冲向$n",
    "lian":
    "$N一招「马革裹尸再朝天」，全力以赴地连刀带人向前猛冲",
    "jibie": 100,
    "limb": "前胸",
    "zhaoshi": "「马革裹尸再朝天」",
    "sen": 7,
    "dodge": -10,
    "parry": 40,
    "damage": 50,
    "wound": 50,
    "damage_type": "刀伤" ]),

});

string *parry_msg = ({
  "$n使出一招「万里黄沙觅封侯」，手中$v向$N的$w磕去...\n",
  "$n横刀一架，与$N的$n的$w重重地撞在一处。\n",
  "$n一招「投笔从戎渡关山」，身形晃动，$v虚架...\n",
});
string *unarmed_parry_msg = ({
  "$n使出一招「万里黄沙觅封侯」，手中$v向$N的五指削去...\n",
  "$n横刀一架，与$N的$n的$w重重地撞在一处。\n",
  "$n一招「投笔从戎渡关山」，身形晃动，$v虚架...\n",
});
int valid_learn(object me) {
  if (me->query_jibie("duanshi-xinfa") < 40)
    return notify_fail("你的段氏心法不足以学习定难刀法。\n");
  return 1;
}

int valid_lian(object me) {
  object weapon;

  weapon = me->query_temp("weapon");
  if (me->query("max_force") < 500)
    return notify_fail("你的内力不够强，不能练习定难刀法。\n");
  if (!weapon || weapon->query("weapon_type") != "blade")
    return notify_fail("你必须先找一把刀才能练刀法。\n");

  return 1;
}

mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}


string query_xiuwei_type() {
  return "blade";
}

// 返回这路武功的等级, 第十等返回0, 第一等返回9.
int query_dengji() {
  return 4;
}
string query_weapon_type() {
  return "blade";
}
string query_parry_msg(object weapon) {
  if (objectp(weapon))
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}
string query_zhaoshi(int jibie) {
  int i;
  for (i = 0; i < sizeof(action); i++) {
    if (action[i]["jibie"] >= jibie)
      return action[i]["zhaoshi"];
  }

  return "";
}

int query_youxiao_jibie() { return 14; }

int query_parry_ratio() { return 8; }
