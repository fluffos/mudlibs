string *parry_msg = ({
  "$n使出一招「凌空飞渡」，反手一掌拍向$N的$l，令其不的不回招自救。\n",
  "$n一招「轻烟笼翠」，左掌随着身形的变化轻轻拍出\n",
  "$n转身退开一步，右掌连连挥动，抬臂上格。\n",
  "$n手臂一转，掌力轻吐，左手缓缓击出，登时将$N的攻势化解了\n",
});

string *unarmed_parry_msg = ({
  "$n使出一招「凌空飞渡」，反手一掌拍向$N的$l，令其不的不回招自救。\n",
  "$n一招「轻烟笼翠」，左掌随着身形的变化轻轻拍出\n",
  "$n转身退开一步，右掌连连挥动，抬臂上格。\n",
  "$n手臂一转，掌力轻吐，左手缓缓击出，登时将$N的攻势化解了\n",
});

int valid_learn(object me) {
  if (me->query("age") < 18)
    return notify_fail("小小孩子，学些别的功夫打打基础再说吧。\n");
  if (me->query_xiuwei_by_type("dodge") < (20 - me->query("dex")) * 60)
    return notify_fail("你的身法不够敏捷，还是先练练轻功去吧。\n");
  return 1;
}

int valid_lian(object me) {
  object weapon;

  weapon = me->query_temp("weapon");
  if (weapon)
    return notify_fail("你必须空手练习掌法。\n");

  return 1;
}

mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}

string query_zhaoshi(int jibie) {
  int i;
  for (i = 0; i < sizeof(action); i++) {
    if (action[i]["jibie"] >= jibie)
      return action[i]["zhaoshi"];
  }
  return "";
}

string query_xiuwei_type() {
  return "unarmed";
}

// 返回这路武功的等级, 第十等返回0, 第一等返回9.
int query_dengji() {
  return 4;
}

string query_parry_msg(object weapon) {
  if (objectp(weapon))
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int query_youxiao_jibie() {
  return 8;
}

int query_parry_ratio() { return 11; }
