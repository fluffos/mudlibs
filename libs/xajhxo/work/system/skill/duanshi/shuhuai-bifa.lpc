//shuhuai-bifa
//    述怀笔法;
//古木鸣寒鸟，空山啼夜猿，既伤千里目，还惊九折魂，
//岂不惮艰险，深怀国士恩，季布无二语，侯嬴重一言，
//人生感意气，功名谁复论
inherit SKILL;

mapping *action = ({
  ([ "action": "$N一招「古木鸣寒鸟」，手中$w突然从上而下刺向$n$l!",
    "lian": "$N一招「古木鸣寒鸟」，手中$w从上而下刺去",
    "jibie": 10,
    "sen": 4,
    "dodge": 20,
    "parry": 0,
    "damage": 20,
    "wound": 5,
    "damage_type": "刺伤" ]),
  ([ "action":
    "$N左掌拍向$n的面门，待$n躲闪时，右手$w突然一式「空山啼夜猿」刺向$n$l...",
    "lian":
    "$N左掌先拍出，而后右手$w突然刺出...",
    "jibie": 20,
    "sen": 5,
    "dodge": 40,
    "parry": 10,
    "damage": 15,
    "wound": 10,
    "damage_type": "刺伤" ]),
  ([ "action":
    "$N抢步上前，$w直刺$n双眼，$n大惊之下识出这招是「既伤千里目」，急忙躲避",
    "lian":
    "$N抢步上前，$w直刺假象敌双眼...",
    "limb": "眼旁",
    "jibie": 30,
    "sen": 8,
    "dodge": 40,
    "parry": 10,
    "damage": 20,
    "wound": 50,
    "damage_type": "刺伤" ]),
  ([ "action":
    "但见$N$w舞成一朵银花，欺身而上，忽然飞起一脚踢向$n$l，真是「还惊九折魂」",
    "lian":
    "$N$w舞成一朵银花，忽然飞起一脚踢出",
    "jibie": 40,
    "sen": 5,
    "dodge": 20,
    "parry": 20,
    "damage": 40,
    "wound": 20,
    "damage_type": "淤伤" ]),
  ([ "action":
    "$N使出「季布无二语，侯嬴重一言」，$w急点$n上三路诸大穴",
    "lian":
    "$N使出「季布无二语，侯嬴重一言」，$w急点假想之敌上三路诸大穴",
    "limb": "前心",
    "jibie": 50,
    "sen": 7,
    "damage": 30,
    "wound": 10,
    "dodge": 50,
    "parry": 30,
    "damage_type": "刺伤" ]),
  ([ "action":
    "$N长叹一声「人生感意气，功名谁复论」，$w挥舞变缓，神情寥落，突然暴纵而起，如狂风般向$n猛攻而至",
    "lian":
    "$N$w挥舞变缓，突然暴纵而起，如狂风般攻了出去",
    "jibie": 60,
    "sen": 7,
    "dodge": 30,
    "parry": 30,
    "damage": 80,
    "wound": 7,
    "damage_type": "刺伤" ]),
});

string *parry_msg = ({
  "$n大喝一声，使出一招「岂不惮艰险」，右手$v一封，左拳反击而出。\n",
  "$n横笔一架，顺手用另一只手反扣$N手臂。\n",
  "$n使出一招「深怀国士恩」，身形团抱，架开了$N的$w。\n",
});
string *unarmed_parry_msg = ({
  "$n大喝一声，使出一招「岂不惮艰险」，右手$v一封，左拳反击而出。\n",
  "$n横笔一架，顺手用另一只手反扣$N手臂。\n",
});

mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}

string query_xiuwei_type() {
  return "short";
}
string query_weapon_type() { return "pen"; }

// 返回这路武功的等级, 第十等返回0, 第一等返回9.
int query_dengji() {
  return 4;
}

string query_parry_msg(object weapon) {
  if (objectp(weapon))
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int query_youxiao_jibie() { return 8; }

int query_parry_ratio() { return 12; }

int valid_lian(object me) {
  object weapon;

  weapon = me->query_temp("weapon");
  if (!weapon || weapon->query("weapon_type") != "pen")
    return notify_fail("你必须先找一支笔才能练笔法。\n");

  return 1;
}

int valid_learn(object me) {
  if (me->query("literate") < 100)
    return notify_fail("你的文化太低，无法练这门武功。\n");
  return 1;
}
