    "lian": "$N身形乍展，高高跃起，一式「柳丝随风」，刀刃飘忽不定。",
    "jibie": 33,
    "zhaoshi": "柳丝随风",
    "sen": 4,
    "dodge": 20,
    "damage": 60,
    "damage_type": "砍伤" ]),
