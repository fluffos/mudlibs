    "damage": 40,
    "damage_type": "刀伤" ]),
  ([ "action": "$N将$w换至左手，突然倒身移步，向左卖了个破绽。。。",
    "lian": "$N将刀换至左手，突然倒身移步，刀峰一晃......",
    "jibie": 50,
    "zhaoshi": "「鸳鸯展翅」",
    "sen": 5,
    "damage": 10,
    "damage": 40,
    "parry": 50,
    "damage_type": "割伤" ]),
  ([ "action": "$N纵刀过肩，一招二式，刀锋忽然飘忽不定，变出一式「镜中鸳鸯」..",
    "lian": "$N纵刀过肩，一招二式，刀锋忽然飘忽不定，变出一式「镜中鸳鸯」..",
    "jibie": 60,
    "zhaoshi": "「镜中鸳鸯」",
    "sen": 5,
    "dodge": 20,
