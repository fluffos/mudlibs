// yueman-qiankun 玉壁剑之月满乾坤
// by lnwm on 98/4/2

#include <ansi.h>

int exert(object me, mixed target) {
  object weapon;

  weapon = me->query_temp("weapon");

  if (!target)
    return notify_fail("你要攻击谁？\n");
  if (!(target = present(target, environment(me))))
    // 这里把target转换成object似乎很重要。
    return notify_fail("没这个人啊？\n");

  if (!objectp(target) ||
    !target->is_character() ||
    !me->is_fighting(target))
    return notify_fail("月满乾坤只能对战斗中的对手使用。\n");

  if (me->query_temp("exert/attack"))
    return notify_fail("你正在施展绝技，不能施展新的绝技。\n");

  if (!weapon || weapon->query("weapon_type") != "sword")
    return notify_fail("你手中无剑，如何使用剑法？！\n");

  if ((int)me->query_lingwu("yubi-jian", 1) < 50)
    return notify_fail("你的“玉壁月华明”不够娴熟，不会施展月满乾坤。\n");

  me->set_temp("exert/attack",
    ([
      "name": EXERT_DIR "yubi-jian/yueman-qiankun",
      "call": "pre_action",
      "arg": target,
    ]));

  return 1;
}

int pre_action(object me)  // 这里没有target什么事，所以不加target参数。 
{
  //printf("时辰%d，日期%d\n",query_shichen(),query_day());
  //一天12个时辰，一月30天。    1-12          1-30

  if ((query_shichen() <= 3 || query_shichen() >= 10) &&
    (query_day() <= 20 && query_day() >= 10) &&
    (me->query_lingwu("yubi-jian") >= 70)) {
    message_vision(HIB "皓月当空，$P手中剑忽做龙吟之声。\n", me);
    me->set_temp("exert/attack/call", "action2");
  } else {
    message_vision(HIB "$P身行突变，剑锋破空。\n" NOR, me);
    me->set_temp("exert/attack/call", "action1");
  }
  return 1;
}

int action1(object me, object target)  // 这里需要target了。而且target已经在上面被转换为object了。
{
  int per, dex;

  if (!target || !present(target, environment(me)))
    return notify_fail("你的对手逃跑了。\n");

  per = me->query("per");
  dex = me->query("dex");

  message_vision(YEL "$P“月满乾坤”使出，但见剑气纵横，笼罩数丈之内的空间。\n" NOR, me);
  target->receive_wound("kee", (per + dex) * (per + dex) / 4 / 2 + random(3));
  me->delete_temp("exert/attack");
  return 0;
}

int action2(object me, object target) {
  int per, dex;

  if (!target || !present(target, environment(me)))
    return notify_fail("你的对手逃跑了。\n");

  per = me->query("per");
  dex = me->query("dex");

  if (random(3)) {
    message_vision(HIR "\n只见$P执剑月下，剑尖透出青光，正是“月满乾坤”\n" NOR, me);
    target->receive_wound("kee", (per + dex) * (per + dex) / 6);
  } else {
    message_vision(HIR "\n$P仗剑月下，剑尖忽然冲出一道青气，将$P影在一片光华之中。\n" NOR, me);
    message_vision(HIR "\n$P“月满乾坤”淋漓尽致地使出。。\n" NOR, me);
    target->receive_wound("kee", (per + dex) * (per + dex) / 4);
  }
  me->delete_temp("exert/attack");
  return 0;
}
