//  百草锄法 baicao-chu.c
//  By lala, 1998-01-26

inherit SKILL;

mapping *action = ({
  ([
    "action":
    "$N右臂从上往下一挥，$w直砸$n$l",
    "lian":
    "$N右臂从上往下一挥，$w直直砸落。",
    "jibie": 8,
    "sen": 1,
    "damage_type": "瘀伤"
  ]),
  ([
    "action":
    "$N举起$w，向$n$l横扫过去",
    "lian":
    "$N举起$w，横扫了一圈。",
    "jibie": 16,
    "sen": 1,
    "damage_type": "瘀伤"
  ]),
  ([
    "action":
    "$N转了转身，$w兜了半个圈，猛磕$n$l",
    "lian":
    "$N转了转身，$w兜了半个圈，猛的一磕，结果$w差点脱手。",
    "jibie": 24,
    "sen": 1,
    "damage_type": "瘀伤"
  ]),
  ([
    "action":
    "$N身形晃动，$w砸向$n$l，然后迅速跳开",
    "lian":
    "$N身形晃动，$w砸向出，然后迅速跳到一旁。",
    "jibie": 32,
    "sen": 1,
    "damage_type": "瘀伤"
  ]),
  ([
    "action":
    "$N举起$w，向$n的面门猛砸",
    "lian":
    "$N举起$w，迎面砸了过去。",
    "jibie": 40,
    "limb": "面门",
    "sen": 2,
    "damage_type": "挫伤"
  ]),
  ([
    "action":
    "$N眼露凶光，挥动$w向$n狂砸不已",
    "lian":
    "$N手中的$w向前胡乱砸去，却也势不可挡……",
    "jibie": 48,
    "sen": 2,
    "damage_type": "瘀伤"
  ]),
});

string *parry_msg = ({
  "$n用$v砸向$N的$w，逼$N收招。\n",
  "$n手中$v一架$N的$w，同时向旁边让开一步。\n",
});
string *unarmed_parry_msg = ({
  "$n全是同归于尽的架式，$v反砸$N。\n",
  "$n手中$v砸向$N的手臂，迫$N收招。\n",
});

int valid_learn(object me) {
  return 1;
}

int valid_lian(object me) {
  object weapon;

  weapon = me->query_temp("weapon");
  if (!weapon || weapon->query("weapon_type") != "hammer")
    return notify_fail("你必须先找一把锤子才能练.\n");

  return 1;
}

mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}

string query_xiuwei_type() {
  return "short";
}
string query_weapon_type() { return "hammer"; }

int query_dengji() {
  return 3;
}

string query_parry_msg(object weapon) {
  if (objectp(weapon))
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int query_youxiao_jibie() { return 10; }

int query_parry_ratio() { return 8; }
