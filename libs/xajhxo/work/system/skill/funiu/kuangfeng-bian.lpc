inherit SKILL;

mapping *action = ({
  ([ "zhaoshi": "「狂风大作」",
    "action":
    "$N大喝一声，一招「狂风大作」，挥动$w击向$n$l.",
    "lian":
    "$N大喝一声，挥动$w直击不回。",
    "jibie": 10,
    "sen": 3,
    "dodge": 0,
    "parry": 0,
    "damage": 20,
    "damage_type": "鞭伤"
  ]),
  ([ "zhaoshi": "「旋风骤起」",
    "action":
    "$N右手将$w抖成一串圈子，晃得$n眼花缭乱。",
    "lian":
    "$N右手将$w抖成一串圈子，",
    "jibie": 15,
    "sen": 2,
    "dodge": 10,
    "parry": 10,
    "damage": 30,
    "damage_type": "鞭伤"
  ]),
  ([ "zhaoshi": " 「揽月高塘」",
    "action":
    "$N俯身抢上，一记「揽月高塘」，$w直卷$n双腿。",
    "lian":
    "$N俯身抢上，一记「揽月高塘」，$w直卷向前方地下",
    "jibie": 25,
    "limb": "腿部",
    "sen": 4,
    "dodge": 0,
    "parry": 20,
    "damage": 40,
    "damage_type": "鞭伤"
  ]),
  ([ "zhaoshi": "「横空飞龙」",
    "action":
    "$N使一招「横空飞龙」，手中$w如一条毒龙，飞向$n。",
    "lian":
    "$N使一招「横空飞龙」，手中$w如一条毒龙一般飞出",
    "jibie": 33,
    "sen": 3,
    "dodge": 10,
    "parry": 10,
    "damage": 35,
    "damage_type": "刺伤"
  ]),
  ([ "zhaoshi": "「千里长行」",
    "action":
    "$N一招「千里长行」，化鞭成棍，径点$n面门.",
    "lian":
    "$N一招「千里长行」，化鞭成棍，径点前方",
    "jibie": 40,
    "limb": "面门",
    "sen": 4,
    "dodge": 10,
    "parry": 20,
    "damage": 55,
    "damage_type": "刺伤"
  ]),
  ([ "zhaoshi": "「龙游万里」",
    "action":
    "$N手下加力，$w如同一条飞龙，在半空中拐了个弯，绕向$n后脑。",
    "lian":
    "$N手下加力，$w如同一条飞龙，在半空中拐了个弯。",
    "jibie": 50,
    "limb": "后脑",
    "sen": 5,
    "parry": 20,
    "dodge": 20,
    "damage": 60,
    "damage_type": "鞭伤"
  ]),
});

string *parry_msg = ({
  "$n反守为攻，$v飞击$N下身。\n",
  "$n转身撤步，一条$v舞成一团，将全身罩住。\n",
  "$n手中$v一抖，变成一条长枪也似，架住了$N的攻势。\n",
});
string *unarmed_parry_msg = ({
  "$n反守为攻，$v飞击$N下身。\n",
  "$n转身撤步，一条$v舞成一团，将全身罩住。\n",
  "$n手中$v一抖，变成一条长枪也似，架住了$N的$w。\n",
});
int valid_learn(object me) {
  return 1;
}

int valid_lian(object me) {
  object weapon;

  weapon = me->query_temp("weapon");
  if (!weapon || weapon->query("weapon_type") != "whip")
    return notify_fail("你必须先找一根鞭子才能练.\n");

  return 1;
}

mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}

string query_xiuwei_type() {
  return "whip";
}
string query_weapon_type() { return "whip"; }

// 返回这路武功的等级, 第十等返回0, 第一等返回9.
int query_dengji() {
  return 2;
}
string query_zhaoshi(int jibie) {
  int i;
  for (i = 0; i < sizeof(action); i++) {
    if (action[i]["jibie"] >= jibie)
      return action[i]["zhaoshi"];
  }

  return "";
}


string query_parry_msg(object weapon) {
  if (objectp(weapon))
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int query_youxiao_jibie() { return 12; }

int query_parry_ratio() { return 9; }
