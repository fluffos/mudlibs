inherit SKILL;

mapping *action = ({ /*size = 8*/
  ([ "action": "$N坐马拉弓，击出一拳，正是一招罗汉拳中的「黑虎偷心」",
    "lian": "$N坐马拉弓，击出一拳，却总觉得有些不得要领",
    "zhaoshi": "「黑虎偷心」",
    "jibie": 8,
    "sen": 1,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N双掌一错，使出「黄莺落架」，对准$n的$l连续拍出三掌",
    "lian": "$N双掌一错，连续拍出三掌，结果左手把右手打得生疼",
    "zhaoshi": "「黄莺落架」",
    "jibie": 16,
    "sen": 1,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N吐气扬声，一招「苦海回头」双手奔$n的头颈抢去",
    "lian": "$N一招「苦海回头」，双手向假象中的敌人的头颈抢去",
    "zhaoshi": "「苦海回头」",
    "limb": "头颈",
    "jibie": 24,
    "sen": 1,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N双手平举胸前，使出一招「挟山超海」，向前急速推出，击向$n的$l",
    "lian": "$N双手平举胸前，使出一招「挟山超海」，向前急速推出。",
    "zhaoshi": "「挟山超海」",
    "jibie": 32,
    "sen": 2,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N左掌一翻，右掌推出，一招「二郎担山」击向$n$l",
    "lian": "$N右掌慢慢推出，左掌一翻，配合右掌的变化",
    "zhaoshi": "「二郎担山」",
    "jibie": 40,
    "sen": 2,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N使出一招「偏花七星」，脚踩七星步，一拳向$n$l击去",
    "lian": "$N慢慢使出一招「偏花七星」，仔细揣摩每一个变化",
    "zhaoshi": "「偏花七星」",
    "jibie": 48,
    "sen": 1,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N使出一招「上山伏虎」，左掌虚按，右拳下击，直奔$n的$l而去",
    "lian": "$N左掌虚按，右拳下击，体会「上山伏虎」的气势",
    "zhaoshi": "「上山伏虎」",
    "jibie": 56,
    "sen": 2,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N使出「跨海降龙」，大步跨前，立右拳，挽左拳向$n的$l击去",
    "lian": "$N大步跨前，立右拳，挽左拳，寻找「跨海降龙」的感觉",
    "zhaoshi": "「跨海降龙」",
    "jibie": 64,
    "sen": 2,
    "damage_type": "瘀伤"
  ]),
});

string *parry_msg = ({
  "$n一招「二郎担山」，左掌一翻，接住对方来势，右拳一晃，迫得$N退出两步。\n",
  "$n抽身倒退，脚踏七星，虽退不乱，右拳冲出，一招「偏花七星」阻遏$N的追击。\n",
  "$n左掌虚按，右拳击向$N的右臂，逼$N抽招换式，正是罗汉拳的「上山伏虎」。\n",
  "$n立右拳护住上三路，挽左拳挡向下盘，一招「跨海降龙」封个严严实实。\n",
});

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练罗汉拳必须空手。\n");

  return 1;
}

int valid_lian(object me) {
  if (me->query_temp("weapon"))
    return notify_fail("拿着兵器练拳？开玩笑吧...\n");

  return 1;
}

mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}

string query_xiuwei_type() {
  return "unarmed";
}

string query_parry_msg(object weapon) {
  return parry_msg[random(sizeof(parry_msg))];
}

string query_zhaoshi(int jibie) {
  int i;
  for (i = 0; i < sizeof(action); i++) {
    if (action[i]["jibie"] >= jibie)
      return action[i]["zhaoshi"];
  }
  return "";
}

int query_dengji() { return 1; }

int query_youxiao_jibie() { return 13; }

int query_parry_ratio() { return 8; }
