#include <ansi.h>

inherit SKILL;

string type() { return "knowledge"; }

int valid_learn(object me) {
  if (me->query("bellicosity") > 100)
    return notify_fail("你心中杀念太高，无法学习佛法。\n");
  if (me->query("PKS") > 5)
    return notify_fail("你杀人过多，无法领悟佛法。\n");
  if (me->query("MKS") > sqrt(me->query("age") - 14) * 50)
    return notify_fail("你杀人过多，无法领悟佛法。\n");
  //如果一个月内没有听过课，不得学习。。。
  if (me->query("shaolin/听法") + 21600 < me->query("mud_age"))
    return notify_fail("你长久未去听课，觉得很难领悟高深的佛法。\n");
  return 1;
}

int is_knowledge() {
  return 1;
}

string query_xiuwei_type() {
  return "buddhism";
}

int query_dengji() { return 1; }
