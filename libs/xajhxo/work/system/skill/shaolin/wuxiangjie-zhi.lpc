inherit SKILL;

mapping *action = ({
  ([ "action":
    "$N指影交错，层层叠叠，接着由繁化简，千指化一，一招「沧海一粟」右手点向$n$l",
    "lian":
    "$N指影交错，层层叠叠，接着由繁化简，千指化一，一招「沧海一粟」直点出去",
    "zhaoshi": "沧海一粟",
    "dodge": 10,
    "sen": 3,
    "jibie": 0,
    "parry": 30,
    "force": 80,
    "damage": 50,
    "damage_type": "刺伤",
  ]),
  ([ "action":
    "$N身形突变，指影千幻，一招「空谷幽兰」，忽前忽後，封住了$n的所有攻势",
    "lian":
    "$N身形突变，指影千幻，一招「空谷幽兰」，忽前忽後，急封而出",
    "zhaoshi": "空谷幽兰",
    "dodge": 5,
    "parry": 50,
    "force": 90,
    "sen": 3,
    "jibie": 14,
    "damage": 70,
    "damage_type": "刺伤",
  ]),
  ([ "action":
    "$N身法稍顿，左手一扬使出「落化逐流」往$n的$l点去",
    "lian":
    "$N身法稍顿，左手一扬使出「落化逐流」直点而出",
    "zhaoshi": "落化逐流",
    "dodge": 5,
    "sen": 2,
    "parry": 30,
    "jibie": 38,
    "force": 140,
    "damage": 80,
    "damage_type": "刺伤",
  ]),
  ([ "action":
    "只见$N腰身一摆，陡然滑出数尺，右手顺著来势一招「云绕千峰」往$n攻去",
    "lian":
    "只见$N腰身一摆，陡然滑出数尺，右手顺著来势一招「云绕千峰」攻了出去",
    "zhaoshi": "云绕千峰",
    "sen": 2,
    "jibie": 55,
    "dodge": 10,
    "parry": 30,
    "force": 90,
    "damage": 70,
    "damage_type": "刺伤",
  ]),
  ([ "action":
    "$N无视$n攻势，身形微晃，一招「随风逐影」绕至$n身后，以攻为守，直点向$n",
    "lian":
    "$N身形微晃，一招「随风逐影」直点出去",
    "zhaoshi": "随风逐影",
    "dodge": 15,
    "sen": 3,
    "jibie": 20,
    "parry": 72,
    "force": 120,
    "damage": 90,
    "damage_type": "刺伤",
  ]),
  ([ "action":
    "$N飞身跃起，一招「皓月清风」，一片指影向$n头顶罩下",
    "lian":
    "$N飞身跃起，一招「皓月清风」，一片指影直罩而下",
    "zhaoshi": "皓月清风",
    "dodge": 20,
    "parry": 70,
    "force": 130,
    "sen": 3,
    "jibie": 86,
    "damage": 130,
    "damage_type": "刺伤",
  ]),

});

string *parry_msg = ({
  "$n一招「红花绿叶」，架住了$N的所有攻势.\n",
  "$n身形飘出，一招「云中漫步」躲开了$N的所有攻势.\n",
});

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("无相劫指必须空手。\n");
  return 1;
}

int valid_lian(object me) {
  return valid_learn(me);
}

mapping query_action(int jibie) {
  int i, size;
  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}

string query_zhaoshi(int jibie) {
  int i;
  for (i = 0; i < sizeof(action); i++) {
    if (action[i]["jibie"] >= jibie)
      return action[i]["zhaoshi"];
  }
  return "";
}

string query_xiuwei_type() {
  return "unarmed";
}
int query_dengji() {
  return 6;
}

string query_parry_msg(object weapon) {
  return parry_msg[random(sizeof(parry_msg))];
}

int query_youxiao_jibie() {
  return 22;
}

int query_parry_ratio() {
  return 10;
}
