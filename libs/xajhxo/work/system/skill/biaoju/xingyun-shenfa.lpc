// Dodge : xingyun-shenfa 行云身法
// by trill 05/17/97

inherit SKILL;

mapping *action = ({
  ([ "action": "$n身形微晃，一式「溪边照影行」，向一旁轻巧的跨出几步，巧妙的避开的$N的攻势。",
    "lian": "$N身形微晃，一式「溪边照影行」，向一旁轻巧的跨出几步。",
    "jibie": 10,
    "sen": 2,
    "zhaoshi": "「溪边照影行」",
  ]),
  ([ "action": "$n双脚一点地面，身形急拔，一式「「天在清溪底」」避开了$N的这一招。",
    "lian": "$N双脚一点地面，一式「「天在清溪底」」身形急拔而起。",
    "jibie": 20,
    "sen": 2,
    "zhaoshi": "「天在清溪底」",
  ]),
  ([ "action": "$n身随意转，一招「一曲桃花水」向一旁飘出，险险的避开了$N的攻势。",
    "lian": "$N身随意转，一招「一曲桃花水」向一旁飘出。",
    "jibie": 30,
    "sen": 4,
    "zhaoshi": "「一曲桃花水」",
  ]),
  ([ "action": "$n突然身子一矮，伏下身去，一招「如觅水影」身子紧贴地面，避开了$N的攻势。",
    "lian": "$N突然身形一矮，一式「如觅水影」伏下身去。",
    "jibie": 40,
    "sen": 3,
    "zhaoshi": "「如觅水影」",
  ]),
  ([ "action": "$n身子傲然崛立，当$N快要近身时，身形突然奇异的扭动，险险的闪开了$N的攻势。",
    "lian": "$N身子一通奇异的扭动，摆出一个奇怪的姿势。",
    "jibie": 50,
    "sen": 2,
    "zhaoshi": "「绝伫灵素」",
  ]),
  ([ "action": "$n身形急旋，闪出无数个身影，一式「人在行云里」晃开了$N的攻击。",
    "lian": "$N身形急旋，一式「人在行云里」闪出无数个身影。",
    "jibie": 60,
    "sen": 3,
    "zhaoshi": "「人在行云里」",
  ]),
});

int valid_learn(object me) {
  return 1;
}

int valid_lian(object me) {
  return 1;
}

mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}

string query_xiuwei_type() { return "dodge"; }

int query_dengji() { return 2; }

string *query_lian() {
  string *lian_msg;
  mapping lian_act;

  lian_msg = allocate(sizeof(action));
  for (int i = 0; i < sizeof(action); i++) {
    lian_act = action[i];
    lian_msg[i] = (string)lian_act["lian"];
  }
  return lian_msg;
}
