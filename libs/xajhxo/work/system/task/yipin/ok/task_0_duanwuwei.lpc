// task 杀
// by lnwm 97.12.21

#include <ansi.h>

inherit GROUP_TASK;

void create() {

  group_task::create();

  SetExistenceTime(1500);
  SetTermType("short");
  SetKeyName("kill duan wuwei");
  SetGroupName("yipin");
  SetLevel(0);
  SetAct("BeginningAct", ([
    "message": YEL "\n\n一品堂令：\n\n"
    "你的任务是杀段府段无畏 。\n" NOR,
    "follow": 0,
  ]));
  SetAct("SuccessAct", ([
    "message": YEL "\n\n你完成了一品堂交给你的任务。\n\n" NOR,
    "bonus": 12,
  ]));
  SetAct("FailAct", ([
    "message": RED "\n\n一品堂交给你的任务失败了！\n\n" NOR,
    "bonus": -5,
  ]));
  SetTaskEvent(([
    "verb": "kill",
    "event": "kill duan wuwei",
  ]));
}

void heart_beat() {
  group_task::heart_beat();
}

int CanBegin(object ppl) {
  return group_task::CanBegin(ppl);
}

int CanEnd(object ppl) {
  return group_task::CanEnd(ppl);
}

void PerformBegin(object ppl) {
  tell_object(ppl, CYN "这个任务可能会有一定的危险。你可以去玄云堂领一些易容药膏。\n\n" NOR);
  ppl->set("lnwm/yipin/task/领药", 1);
  return;
}

void PerformSuccess(object ppl) {}

void PerformFail(object ppl) {}
