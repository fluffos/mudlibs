// task 杀一品堂叛徒。
// by lnwm 97.11.28

#include <ansi.h>

inherit GROUP_TASK;

void create() {
  object pan;

  group_task::create();

  pan = new(__DIR__ "npc/pantu");
  pan->move("/d/city/lanzhou/kezhan");

  SetExistenceTime(1800);
  SetTermType("short");
  SetKeyName("kill pantu lanzhou");
  SetGroupName("yipin");
  SetLevel(0);
  SetAct("BeginningAct", ([
    "message": YEL "\n\n一品堂令：\n\n"
    "在兰州有我们的一个叛徒，此人叫：" + pan->query("name") + "。\n"
    "你的任务是将此人尽快除去！\n" NOR,
    "follow": 0,
  ]));
  SetAct("SuccessAct", ([
    "message": YEL "\n\n你完成了一品堂交给你的任务。\n\n" NOR,
    "bonus": 12 + random(20),
  ]));
  SetAct("FailAct", ([
    "message": RED "\n\n一品堂交给你的任务失败了！\n\n" NOR,
    "bonus": -5,
  ]));
  SetTaskEvent(([
    "verb": "kill",
    "event": "kill " + pan->query("id"),
  ]));
}

void heart_beat() {
  group_task::heart_beat();
}

int CanBegin(object ppl) {
  return group_task::CanBegin(ppl);
}

int CanEnd(object ppl) {
  return group_task::CanEnd(ppl);
}

void PerformBegin(object ppl) {
  tell_object(ppl, CYN "如果你觉得必要，可以去玄阳堂领一件趁手的武器。\n\n" NOR);
  ppl->set("lnwm/yipin/task/领武器", 1);
  return;
}

void PerformSuccess(object ppl) {}

void PerformFail(object ppl) {}
