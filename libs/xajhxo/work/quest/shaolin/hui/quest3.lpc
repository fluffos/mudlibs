//Hydra
#include <ansi.h>

inherit SKILL;

mapping *quest = ({
  ([ "quest": "取" HIY "苁蓉" NOR,
    "time": 1800 + random(800),
    "bonus": 17 + random(10),
    "quest_msg":
    "慧觉对你说：“听说西域大漠里有一种植物叫做" HIY "苁蓉" NOR "，被誉为沙漠\n"
    "人参，你去西域看看，能否搞到一棵给药王院作药。”\n",
    "reward_msg":
    "慧觉看了看" HIY "苁蓉" NOR "，道：“不错，不错，果然不同凡响！盶n",
    "fail_msg":
    "慧觉拍了拍你的头：“我知道难为你了，下次努力吧。”\n",
    "delay_msg":
    "慧觉点了点头：“你能够找到已经难得了，下去吧。”\n",
  ]),
  ([ "quest": "取「梵文书籍」",
    "time": 1800 + random(1000),
    "bonus": 20 + random(5),
    "quest_msg":
    "慧觉对你说：“龙树院的玄寂师叔祖翻译佛经需要一些梵文书籍，你去西域\n"
    "哪个城市去看看，能否买一本过来。\n",
    "reward_msg":
    "慧觉看了看「梵文书籍」，“大老远的，一定累了吧，下去休息休息吧。”\n",
    "fail_msg":
    "慧觉拍了拍你的头：“我知道难为你了，下次努力吧。”\n",
    "delay_msg":
    "慧觉点了点头：“你能够买来已经难得了，等一下我叫人去送到龙树院去。”\n",
  ]),
  ([ "quest": "送信给白鹿子",
    "time": 1800 + random(500),
    "send_ob": "/d/menpai/shaolin/obj/letter",
    "bonus": 18 + random(8),
    "quest_msg":
    "慧觉说：“我有一封信要送给昆仑派的掌门白鹿子，你去跑一趟吧，路上小心。”\n",
    "send_msg":
    "白鹿子点了点头道：“大师辛苦了，回去请转告慧觉大师，说信收到了。”\n",
    "reward_msg":
    "慧觉满意地对你说：“很好很好，多跑跑江湖，长长见识。”\n",
  ]),
});

mapping query_quest() {
  return quest[random(sizeof(quest))];
}
