// mooncake1.c ITEM
// 中秋月饼  用来吃的
// write by Xli for XO_Group
// date:1999.9.23
// Last Modified by Xli 1999.9.23
// 月饼，中秋的时候自动发给每个登录进来的人四个，且一人只能吃四个
// 吃一个就把食物补足了
// 随机涨如下东东中的一样：
// 1.资质1+random(2)点  2.修为100+random(50)点
// 3.内力上限20+random(10)点  4.实战经验 1000+random(500)点

#include <ansi.h>
inherit ITEM;

string *gift = ({ "str", "per", "dex", "con", "spi", "cor", "int", "cps", "kar" });
string *xiuwei = ({ "unarmed", "sword", "blade", "dodge", "zonggang" });
string GetName() {
  string name;
  int i;
  i = random(7);
  switch (i) {
    case 0: name = GRN "豆沙月饼" NOR;
    break;
    case 1: name = YEL "莲蓉月饼" NOR;
    break;
    case 2: name = WHT "椰蓉月饼" NOR;
    break;
    case 3: name = RED "火腿月饼" NOR;
    break;
    case 4: name = BLK "芝麻月饼" NOR;
    break;
    case 5: name = BLU "桂花月饼" NOR;
    break;
    default: name = "素月饼";
  }
  return name;
}

void create() {
  string theName;
  theName = GetName();
  set_name(theName, ({ "mooncake" }));
  set("long", "一个小小的" + theName + "，香喷喷的，刚出炉，还是热的呢！\n");
  set_weight(50);  //一两
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("value", 3000);  // 三两银子一个
    set("cant_sell", "食物不便保存，本店不收。\n");
  }
  setup();
}

void init() {
  add_action("do_eat", "eat");
}

int do_eat(string arg) {
  object me;
  int i;
  me = this_player();
  if (arg != "mooncake")
    return "/cmds/verb/eat.lpc"->main(me, arg);
  if (me->query("xli_marks/have_eat_mooncake") == 4) {
    tell_object(me, "你已经吃了很多了，月饼吃多了会消化不良的。\n");
    return 1;
  }
  if (me->query("food") >= me->max_food_capacity()) {
    tell_object(me, "你已经吃的很饱了，再也撑不下去了。\n");
    return 1;
  }
  tell_object(me, "你一口咬了下去，只觉香甜爽口，真是少有的美味！\n");
  me->set("food", me->max_food_capacity());

  i = random(4);
  switch (i) {
    case 0:
      me->add(gift[random(sizeof(gift))], 1 + random(2));
      tell_object(me, CYN "你感觉身体的素质有了明显的改善！\n" NOR);
      break;
    case 1:
      me->set_xiuwei_by_type(xiuwei[random(sizeof(xiuwei))], 100 + random(50));
      tell_object(me, MAG "你感觉对武功的理解又更进了一层！\n" NOR);
      break;
    case 2:
      me->add("max_force", 20 + random(10));
      tell_object(me, HIC "你感到内息的运行有了长足的进步！\n" NOR);
      break;
    case 3:
      me->add("combat_exp", 1000 + random(500));
      tell_object(me, HIM "你觉得临敌对战的经验有了一定的提高！\n" NOR);
      break;
  }
  me->add("xli_marks/have_eat_mooncake", 1);

  this_object()->move("/d/menpai/qingcheng/houdian");
  // xixi，为了不使用destruct，我把这个东东移到我的青城派去了 :)
  return 1;
}
