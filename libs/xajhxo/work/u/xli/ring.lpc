#include <ansi.h>
#include <armor.h>
#include <mudlib.h>   
#include <command.h>

inherit FINGER;
inherit F_SAVE;
inherit F_AUTOLOAD;

void create()
{
    set_name(MAG"结婚钻戒"NOR, ({"jiehun zuanjie","zuanjie","ring"}));
    set_weight(100);
    if ( clonep() )
        set_default_object(__FILE__);
    else
    {
        set("long", 
        "一枚精美的"+MAG"结婚钻戒"NOR+"，白金打造，水波纹的指环上面镶嵌着一颗晶莹剔透的钻石。\n"
        +"环里面还刻着一行小字：宝宝贝贝赠，祝白头偕老，永结同心！\n");
        set("unit", "枚");
        set("value", 100000);
        set("material", "steal");
        set("cant_sell","这是结婚用的戒指，你怎么能随便拿来卖掉呢？\n");
//                set("armor_prop/personality", 10);
        set("armor_prop/armor", 1);

                set("wear_msg","$N从小盒子里取出一枚$n，轻轻地戴在右手无名指上，顿觉心中一片甜蜜。\n");
                set("unequip_msg","$N将$n轻轻褪下，望着它，回忆起了那如梦如诗的往事......\n");
    }

}

int query_autoload()
{
    if( !this_player() ) return 0;
    if( objectp(environment()))
    {
        set("long", 
        "一枚精美的"+MAG"结婚钻戒"NOR+"，白金打造，水波纹的指环上面镶嵌着一颗晶莹剔透的钻石。\n"
        +"环里面还刻着一行小字：宝宝贝贝赠，祝白头偕老，永结同心！\n");
        return 1; 
    }
     else  return 0;
}

int IsAutoLoad() { return 1; }

varargs int move(mixed dest, int silent)
{
    object env = environment();
/*    if (env->is_ghost())
    {
        write("结婚戒指突然闪出一道耀眼的银光,飞散开去,不见了踪影。\n");
        destruct(this_object());
        return notify_fail("戒指回到极乐世界去了！\n");
    }
*/    if ( objectp( env ) 
      && env->is_character() 

      && !env->is_ghost())
        return notify_fail( "这可是你的结婚戒指啊，怎么能随便送人呢！\n");

    
    if ( !stringp( query( "owner" ) ) )
    {
        set( "owner", dest->query( "id" ) );
        set("long", 
        "一枚精美的"+MAG"结婚钻戒"NOR+"，白金打造，水波纹的指环上面镶嵌着一颗晶莹剔透的钻石。\n"
        +"环里面还刻着一行小字：宝宝贝贝赠，祝白头偕老，永结同心！\n");
    }

    return ::move( dest, silent );
}

mapping GetItemInfo()
{
    return ([
        "owner" : query( "owner" ),
        "long"  : query( "long"  ),
        ]);
}

int SetItemInfo( mapping info )
{
    if ( mapp( info ) )
    {
        set( "owner",   info[ "owner" ] );
        set( "long", info[ "long" ] );
        return 1;
    }
    else if ( !info )
    {
        return 1;
    }
    else return 0;
}

