#include <ansi.h>
inherit ITEM;
inherit F_FOOD;
void create() {
  set_name("蛋糕", ({ "cake" }));
  set_weight(250);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一个精美的蛋糕。\n");
    set("unit", "块");
    set("value", 100);
    set("food_remaining", 10);
    set("food_supply", 300);
  }
}
