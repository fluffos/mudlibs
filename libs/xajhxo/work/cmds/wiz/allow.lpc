// allow.c
// Created by Yuhj@XO 
// allow a user to be able to login without any limit


#define ALLOW_D		"/system/daemon/allowd"

void create() {
  seteuid(getuid());
}

int main(object me, string arg) {
  string user_id;

  if (!arg)
    ALLOW_D->print_allow_list();
  else if (sscanf(arg, "+ %s", user_id) == 1)
    ALLOW_D->add_allow(user_id);
  else if (sscanf(arg, "- %s", user_id) == 1)
    ALLOW_D->remove_allow(user_id);
  else write("指令格式：allow [+|- user id]\n");

  return 1;
}

int help(object me) {
  write(@HELP
指令格式：allow [+|- user id]
	
这条命令是用来增加或减掉一个在allowed_list里的user,
所有在这个list里的user都可以不受wizlock的限制。
HELP
  );
  return 1;
}
