// Filename : /cmds/verb/duilian.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  object obj, old_target, wanted;
  int my_gender, your_gender;
  string my_guanxi, your_guanxi;

  if (environment(me)->query("wiz"))
    return notify_fail(HIR "这是属于神的房间，不能用来练功\n" NOR);

  if (!arg || !objectp(obj = present(arg, environment(me))))
    return notify_fail("你想跟谁对练？\n");

  if (!obj->is_character())
    return notify_fail("看清楚一点，那并不是生物。\n");

  if (!living(obj))
    return notify_fail(obj->name() + "已经无法同你对练了。\n");

  if (obj == me)
    return notify_fail("同自己能叫对练吗？你好象还不会双手互搏之术啊？！\n");

  // 不能同正在战斗的人对练
  if (obj->is_fighting()) {
    string temp;
    temp = sprintf("%s(%s)正在战斗，怎么能同你对练呢？\n",
      obj->name(), (string)obj->query("id"));
    return notify_fail(temp);
  }

  // 如果已经同你在对练了
  if (obj->is_duilianing(me)) {
    string temp;
    temp = sprintf("你已经在同%s(%s)对练了，加油吧！！！\n",
      obj->name(), (string)obj->query("id"));
    return notify_fail(temp);
  }

  if (!me->is_tongmen_of(obj) && !obj->is_tongshi_of(me))
    return notify_fail("你只能与同门或是同事对练！\n");

  if (me->is_lianing())
    return notify_fail("你现在不是在一个人练吗？等下再同别人练吧！\n");

  if (me->is_duilianing())
    return notify_fail("只能同时与一个人对练。\n");

  if (me->is_fighting())
    return notify_fail("也许你战斗完后还有练的机会。\n");

  if (me->is_tongmen_of(obj)) {
    my_guanxi = me->get_tongmen_guanxi(obj);
    your_guanxi = obj->get_tongmen_guanxi(me);
    my_gender = me->query("family/generation");
    your_gender = obj->query("family/generation");
  } else {
    your_guanxi = me->get_tongshi_guanxi(obj);
    my_guanxi = obj->get_tongshi_guanxi(me);
    your_gender = me->query("zuzhi/generation");
    my_gender = obj->query("zuzhi/generation");
  }
  if (userp(obj)) {
    if (obj->query_temp("pending/duilian") != me) {
      message_vision("\n$N对$n躬身行礼，琅声道："
        +my_guanxi + me->name() + "，恭请"
        +your_guanxi + "指教。\n\n", me, obj);

      me->set_temp("pending/duilian", obj);
      tell_object(obj, YEL "如果你愿意同对方进行对练，请你也对"
        +me->name() + "(" + (string)me->query("id") + ")"
        + "下一次 duilian 指令。\n" NOR);
    } else {
      if (my_gender >= your_gender)
        message_vision("\n$N向$n躬身回礼，道："
          +my_guanxi + me->name() + "，领教"
          +your_guanxi + "的高招。\n\n", me, obj);
      else
        message_vision("\n$N略为迟疑了一下，点头道：好吧。\n\n",
          me, obj);

      me->duilian_ob(obj);
      obj->duilian_ob(me);
    }
    return 1;
  }

  if (obj->query("can_speak")) {
    message_vision("\n$N对$n躬身行礼，琅声道："
      +my_guanxi + me->name() + "，恭请"
      +your_guanxi + "指教。\n\n", me, obj);

    notify_fail(obj->name() + "看上去没有打算指教你的意思。\n");
    if (!obj->accept_duilian(me)) return 0;
    if (my_gender >= your_gender)
      message_vision("\n$N向$n躬身回礼，道："
        +your_guanxi + obj->name() + "，领教"
        +my_guanxi + "的高招。\n\n", obj, me);
    else
      message_vision("\n$N略为迟疑了一下，点头道：好吧。\n", obj, me);

    me->duilian_ob(obj);
    obj->duilian_ob(me);
  } else {
    message_vision("\n$N二话不说，就对$n发动攻击！\n\n", me, obj);
    me->duilian_ob(obj);
    obj->kill_ob(me);
  }
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : duilian <某人> 

这个命令可以让你向你的同门请求对练武功，目的是为了熟练你所学的武功。 
请求对练的对象的武功如果和你相差太大，或者辈份相差较多时，接受你的
对练的可能性就比较小，因为要么你不配作为他(她)的对手，要么他(她)不
配作为你的对手。 
强调一点，对练不会造成伤害。 
 
相关指令: bihua( tiaozhan ), kill( sha ), qiecuo

HELP
  );
  return 1;
}
