// ask.c

#include <ansi.h>

inherit F_CLEAN_UP;

int answer(object, object, string);

string *msg_dunno = ({
  "$n摇摇头，说道：没听说过。\n",
  "$n睁大眼睛望著$N，显然不知道$P在说什麽。\n",
  "$n耸了耸肩，很抱歉地说：无可奉告。\n",
  "$n说道：嗯....这我可不清楚，你最好问问别人吧。\n",
  "$n想了一会儿，说道：对不起，你问的事我实在没有印象。\n"
});

// the following ask message are add by nerd 1997/03/08
string *ask_msg = ({
  "$N向$n打听有关『$T』的消息。\n",
  "$N对$n一拱手，道：“请问这位$R是否知道有关〖$T〗的消息？”\n",
  "$N对$n说：“在下$W，请教这位$R是否听说过〖$T〗？”\n"
});

int main(object me, string arg) {
  string dest, topic, msg;
  object ob;
  mapping inquiry;

  seteuid(getuid());

  if (!arg || sscanf(arg, "%s about %s", dest, topic) != 2)
    return notify_fail("你要问谁什麽事？\n");

  if (!objectp(ob = present(dest, environment(me))))
    return notify_fail("这里没有这个人。\n");

  if (!ob->is_character()) {
    message_vision("$N对著$n自言自语....\n", me, ob);
    return 1;
  }

  if (!ob->query("can_speak")) {
    message_vision("$N向$n打听有关『" + topic + "』的消息，但是$p显然听不懂$N的话。\n", me, ob);
    return 1;
  }

  if (!INQUIRY_D->parse_inquiry(me, ob, topic)) {
    msg = ask_msg[random(sizeof(ask_msg))];
    msg = replace_string(msg, "$T", topic);
    msg = replace_string(msg, "$R", RANK_D->query_respect(ob));
    msg = replace_string(msg, "$W", me->name());
    message_vision(msg, me, ob);
  }
  if (!living(ob)) {
    message_vision("但是很显然的，$n现在的状况没有办法给$N任何答覆。\n", me, ob);
    return 1;
  }
  if (userp(ob) && msg = (string)ob->query("trill_ask/" + topic)) {
    message_vision(msg, ob);
    return 1;
  }
  if (msg = ob->query("inquiry/" + topic)) {
    if (stringp(msg)) {
      message_vision(CYN "$N说道：" + msg + "\n" NOR, ob);
      return 1;
    }
    return 1;
  }

  //Qyz 增加回答功夫的内容
  if (!userp(ob) && (topic == "武功" || topic == "功夫"))
    return ob->tell_skills(me);

  if (topic == "name" || topic == (string)ob->query("id")) {
    message_vision(CYN "$n说道：“不敢不敢，" + RANK_D->query_self(ob) + "就是$n。”\n" NOR, ob, ob);
    return 1;
  }

  if (!ob->query_ask_answer(me, arg))
    message_vision(msg_dunno[random(sizeof(msg_dunno))], me, ob);

  return 1;
}

int help(object me) {
  write(@HELP
指令格式: ask <someone> about <something>

这个指令在解谜时很重要, 通常必须藉由此一指令才能
获得进一步的资讯。
HELP
  );
  return 1;
}
