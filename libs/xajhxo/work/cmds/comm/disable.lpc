// disable.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  mapping map;
  string *types, *skills, skill;
  int i, modify;

  seteuid(getuid());

  if (!arg)
    return notify_fail("你要放弃使用什么技能?\n");

  if (sscanf(arg, "%s", skill) != 1)
    return notify_fail("指令格式：disable <技能名称>\n");
  if (SKILL_D(skill)->is_knowledge())
    return notify_fail("这门技能不能放弃使用。\n");
  if (!me->query_jibie(skill) || !me->query_lingwu(skill))
    return notify_fail("你还没有领悟这门武功呢。\n");

  me->disable_skill(skill);

  //    if ( ski == "force" )
  //	{
  //        write("你改用另一种内功，内力必须重新锻炼。\n");
  //        me->set("force", 0);
  //        me->receive_damage("kee", 0);
  //	}
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : disable <技能名称>

这个指令让你指定战斗不使用的技能。
 
HELP
  );
  return 1;
}
