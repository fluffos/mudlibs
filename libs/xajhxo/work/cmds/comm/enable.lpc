// enable.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  mapping map;
  string *types, *skills, skill;
  int i, modify;

  seteuid(getuid());

  if (!arg) {
    map = me->query_enable_map();
    if (!mapp(map) || sizeof(map) == 0)
      return notify_fail("你现在没有设定任何用于战斗的技能。\n");

    skills = sort_array(keys(map), (: strcmp :));
    write("以下是你在战斗中使用的技能。\n");
    for (i = 0; i < sizeof(skills); i++) {
      printf("  %-45s\n",
        to_chinese(skills[i]) + HIY " 〖" + skills[i] + "〗" NOR);
    }
    return 1;
  }

  if (sscanf(arg, "%s", skill) != 1)
    return notify_fail("指令格式：enable <技能名称>\n");

  if (!me->valid_skill(skill))
    return notify_fail("你不会这种技能。\n");

  if (SKILL_D(skill)->is_knowledge())
    return notify_fail("这不是用于战斗的技能。\n");

  //    if ( !me->query_lingwu( skill ) )
  //	    return notify_fail("你还没有领悟这门武功呢。\n");

  if (SKILL_D(skill)->is_native_skill())
    return notify_fail("天生的技能不用 enable 就能使用。\n");

  if (!me->enable_skill(skill))
    return notify_fail("你还没有领悟这门武功呢。\n");

  //me->reset_action();
  write("Ok.\n");

  //    if ( ski == "force" )
  //	{
  //        write("你改用另一种内功，内力必须重新锻炼。\n");
  //        me->set("force", 0);
  //        me->receive_damage("kee", 0);
  //	}
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : enable <技能名称>

这个指令让你指定战斗要用的技能，不加参数则会显示出你目前所使用的技能名称。
 
HELP
  );
  return 1;
}
