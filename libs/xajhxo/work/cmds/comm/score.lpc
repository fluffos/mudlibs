#include <ansi.h>
#include <combat.h>

inherit F_CLEAN_UP;

private string *xiuwei = ({
  "sword",
  "blade",
  "unarmed",
  "dodge",
  "short",
  "whip",
  "long",
  "zonggang"
});
private string *xiuwei_chinese = ({
  "剑  术",
  "刀  法",
  "拳  脚",
  "轻  功",
  "短兵刃",
  "鞭  法",
  "长兵刃",
  MAG "总  纲" NOR
});
private string *gift_ranking = ({ BLU "下等", MAG "中下", CYN "中等", GRN "中上", YEL "上等", RED "绝顶" });
private string *gift_types = ({ "膂力", "胆识", "悟性", "容貌", "灵性", "定力", "机敏", "根骨", "福缘" });
private string *gifts = ({ "str", "cor", "int", "per", "spi", "cps", "dex", "con", "kar", });

private mapping query_gifts(object);
private string get_xiuwei_color(int point, int jibie);

void create() { seteuid(ROOT_UID); }

int main(object me, string arg) {
  object ob;
  mapping my, my_gifts, my_zuzhi_score;
  string line, str, skill_type, title, zuzhi_id;
  object weapon;
  int attack_points, dodge_points, parry_points, i, value;
  int class_score;
  seteuid(getuid(me));

  if (!arg || me->query("id") == arg)
    ob = me;
  else if (wizardp(me)) {
    ob = get_object(arg);
    if (!ob) return notify_fail("你要察看谁的状态？\n");
  } else
    return notify_fail("只有巫师能察看别人的状态。\n");

  // dbase and xiuwei
  my = ob->query_entire_dbase();

  // general info
  line = " " + RANK_D->query_rank(ob);
  line += ob->short(1) + "\n\n";
  line += sprintf(" 你是一%s%s岁的%s%s，%s生。\n\n",
    ob->query("unit"),
    chinese_number(ob->query("age")),
    ob->query("gender"),
    ob->query("race"),
    CHINESE_D->chinese_date(((int)ob->query("birthday") - 14 * 365 * 24 * 60) * 120));

  // gifts,can this be modify better?too long
  my_gifts = query_gifts(ob);
  if (wizardp(me)  //&& me->query("env/score") )
  || (int)ob->query("age") >= 18) {
    line += " ";
    for (i = 0; i < sizeof(gifts); i++)
      if (wizardp(me)  // && me->query("env/score")
      )
        line += sprintf("%s：[%s" NOR "](%-4d)%s",
          gift_types[i],
          my_gifts[gifts[i]] > 29 ? gift_ranking[5] : gift_ranking[(my_gifts[gifts[i]] - 10) / 4],
          my_gifts[gifts[i]],
          (i + 1) % 3 ? "    " : "\n ");
      else
        line += sprintf("%s：[%s" NOR "]%s",
          gift_types[i],
          my_gifts[gifts[i]] > 29 ? gift_ranking[5] : gift_ranking[(my_gifts[gifts[i]] - 10) / 4],
          (i + 1) % 3 ? "    " : "\n ");
  }

  // family info
  if (mapp(my["family"])) {
    if (my["family"]["master_name"])
      line += sprintf(
        "你已拜在%s门下，是%s的第%s代弟子。\n 你的师父是%s。\n\n",
        my["family"]["family_name"], my["family"]["family_name"],
        chinese_number(my["family"]["generation"]),
        my["family"]["master_name"]);
  } else line += sprintf("\n");

  // zuzhi info (changed by lnwm)
  if (ob->JoinedZuzhiNumber() > 0)
    for (i = 0; i < ob->JoinedZuzhiNumber(); i++) {
      zuzhi_id = ob->GetZuzhiId()[i];
      line += sprintf(
        " 你已加入%s，现在是一名%s%s.\n",
        ob->ZuzhiName(zuzhi_id),
        ob->ZuzhiZhiwu(zuzhi_id),
        ob->ZuzhiTouxian(zuzhi_id));
    }
  //	else line += sprintf("\n");
  line += "\n";

  // display xiuwei
  for (i = 0; i < sizeof(xiuwei); i++) {
    int xiuwei_jibie;
    int xiuwei_point = (int)ob->query_xiuwei_by_type(xiuwei[i]);
    xiuwei_jibie = (int)ob->query_xiuwei_jibie(xiuwei[i]);
    if (wizardp(me) && me->query("env/score"))
      line += sprintf("  %s修为: %s%3s级" NOR "( %5d)%s",
        xiuwei_chinese[i],
        get_xiuwei_color(xiuwei_point, xiuwei_jibie),
        chinese_number(xiuwei_jibie),
        xiuwei_point,
        i % 2 ? "\n" : "        ");
    else
      line += sprintf("  %s修为: %s%3s级" NOR "%s",
        xiuwei_chinese[i],
        get_xiuwei_color(xiuwei_point, xiuwei_jibie),
        chinese_number(xiuwei_jibie),
        i % 2 ? "\n" : "            ");
  }

  // MKS & PKS
  line += sprintf("\n 你到目前为止总共杀了%s个人，其中有" RED "%s" NOR "个是其他玩家。\n\n",
    chinese_number(my["MKS"] + my["PKS"]), chinese_number(my["PKS"]));

  // other info
  //    if(wizardp(me))
  //    {   
  line += sprintf(" 杀    气： " RED "%d\n" NOR, ob->query("bellicosity"));
  if (ob->query("family")) {
    class_score = ob->query("class_score/" + ob->query("family/family_name"));
  } else {
    class_score = ob->query("class_score/" + ob->query("zuzhi/zuzhi_name"));
  }
  line += sprintf(CYN " 师门忠诚度：%d\n" NOR, class_score);
  //    } 


  //加入组织信任度，苯带鱼的 group 没法 query。:(  ( by lnwm 97/09/30 )

  if (ob->JoinedZuzhiNumber() > 0) {
    for (i = 0; i < ob->JoinedZuzhiNumber(); i++) {
      line += sprintf(
        YEL " 对%s的组织信任度：%d\n" NOR,
        ob->ZuzhiName(ob->GetZuzhiId()[i]),
        ob->ZuzhiScore(ob->GetZuzhiId()[i]));
    };
  };

  line += sprintf(" 实战经验: " BMAG "%-8d" NOR, (int)ob->query("combat_exp"));
  line += sprintf(" 江湖阅历: " BMAG "%-8d" NOR, (int)ob->query("social_exp"));
  if ((int)ob->query("positive_score") > 5 * (int)ob->query("negative_score"))
    line += sprintf(
      " 武林声望: " BMAG "%-8d" NOR "\n\n",
      (int)ob->query("positive_score") + (int)ob->query("negative_score")
    );
  else if ((int)ob->query("positive_score") * 5 < (int)ob->query("negative_score"))
    line += sprintf(
      " 武林声望: " BBLU "%-8d" NOR "\n\n" NOR,
      (int)ob->query("positive_score") + (int)ob->query("negative_score")
    );
  else
    line += sprintf(
      " 武林声望: " BYEL "%-8d" NOR "\n\n",
      (int)ob->query("positive_score") + (int)ob->query("negative_score")
    );
  write(line);
  return 1;
}

private string get_xiuwei_color(int point, int jibie) {
  int *xiuwei_interval = ({ 0, 100, 300, 600, 1100, 1900, 3100, 4800, 7100, 10100 });
  string *colors = ({ "", MAG, BLU, CYN, GRN, YEL, RED });
  int i, jiange;
  if (jibie > sizeof(xiuwei_interval) - 1) return "";
  jiange = (xiuwei_interval[jibie + 1] - xiuwei_interval[jibie]) / sizeof(colors);
  for (i = 0; i < sizeof(colors); i++) {
    if ((point >= (xiuwei_interval[jibie] + i * jiange)) &&
      (point < (xiuwei_interval[jibie] + (i + 1) * jiange)))
      return colors[i];
  }
  return RED;
}

private mapping query_gifts(object ob) {
  mapping gifts;

  gifts = ([ "per": ob->query_per() ]);
  gifts["str"] = ob->query_str();
  gifts["spi"] = ob->query_spi();
  gifts["con"] = ob->query_con();
  gifts["cor"] = ob->query_cor();
  gifts["int"] = ob->query_int();
  gifts["cps"] = ob->query_cps();
  gifts["dex"] = ob->query_dex();
  gifts["kar"] = ob->query_kar();
  return gifts;
}

int help(object me) {
  write(@HELP
指令格式 : score

这个指令可以显示你的基本资料。
其中在修为中的颜色表示你修为的目前状态。
由无色变为粉红、蓝、青、绿、黄、红，表示你的修为正在逐渐上升。

see also : hp
HELP
  );
  return 1;
}
