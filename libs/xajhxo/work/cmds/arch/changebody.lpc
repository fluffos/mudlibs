// filename : /cmds/arch/promote.c

//inherit F_CLEAN_UP;

int main(object me, string arg) {
  object old_ob, new_ob, link_ob;
  string old_status, new_status;
  int my_level, ob_level, level;

  seteuid(ROOT_UID);
  old_ob = present(arg, environment(me));
  if (!objectp(old_ob) || !userp(old_ob))
    return notify_fail("你只能改变使用者的权限。\n");

  if (wiz_level(old_ob->query("id")) > 0) {
    link_ob = old_ob->query_temp("link_ob");
    link_ob->set("body", WIZ_OB);
    new_ob = LOGIN_D->make_body(link_ob);
    if (objectp(new_ob)) {
      if (new_ob->restore()) {
        new_ob->set_temp("link_ob", link_ob);
        destruct(old_ob);
        return notify_fail("换体成功。\n");
      } else {
        write("您的角色存盘数据出了问题，请利用 guest 通知神仙处理。\n");
        destruct(new_ob);
      }
    }
    return notify_fail("换体失败。\n");
  }
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : promote <某人> (权限等级)

用来提升权限等级, (player) (immortal) (apprentice) (wizard)
(arch) (admin)
一个 admin 能提升权限至任何等级, 而 arch 只能提升至 arch。
HELP
  );
  return 1;
}
