// Filename : /cmds/arch/random.c

inherit F_CLEAN_UP;

int main(object me, string arg) {
  int base;

  if (!arg)
    base = 100;
  else
    base = to_int(arg);
  if (base <= 0)
    return notify_fail("基数必须大于零!\n");
  printf("结果: %d\n", random(base));

  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : random <基数>

用来产生一个 0...N-1 之间的随机数.
HELP
  );
  return 1;
}
