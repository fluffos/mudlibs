//Qyz 

inherit F_CLEAN_UP;

int main(object who, string arg) {
  string *id, *options;
  mapping my_apply;
  int i, j;
  if (!arg) {
    write("现在已经填写巫师申请的玩家如下：\n");
    id = APPLY_D->query_all_apply();
    for (i = 0; i < sizeof(id); i++) {
      printf("%5s%s", id[i], (i + 1) % 3 ? "    " : "\n ");
    }
    printf("\n");
    return 1;
  }
  if (!my_apply = APPLY_D->query_apply(arg) || !sizeof(my_apply))
    return notify_fail("没有这份巫师申请。\n");
  else {
    options = keys(my_apply);
    for (j = 0; j < sizeof(options); j++) {
      printf("%s\n%s", options[j], my_apply[options[j]]);
    }
    return 1;
  }
}
