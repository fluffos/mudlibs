inherit "lib/armour";

void create() {
::create();
SetKeyName( "shield");
SetId( ({ "shield", "shield of damien" }) );
SetShort( "the shield of Damien");
SetLong( "The shield of Damien is very old. It looks like it once "
"used to be in good shape. There is a mysterious circle in %^GREEN%^green "
"%^RESET%^drawn upon it." );
SetMass(800);
SetValue(150);
set_type("shield");
set_limbs( ({ "right arm", "right hand" }) );
set_wear( (:this_object(), "extra_worn":) );
}
 
int extra_worn() {
int level;

level = this_player()->GetLevel();
if(level < 19 ) {
write( "Perhaps you should come back in a few levels." );
return 0;
}
return 1;
}
