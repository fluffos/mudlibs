// File:        move.c
// Mudlib:      Nightmare-derived creator move for Foundation II
// Purpose:     allow wizards to move any object anywhere
/* FluffOS PORT: this archive never shipped Nightmare's <move.h>
 * MOVE_* codes or REFS_D/refs daemon. Foundation II eventMove()
 * answers 1 on success / 0 on failure (lib/move.lpc). Resolve
 * arguments with the lib's get_object() sefun (secure/sefun/get_object.lpc).
 */

#include <lib.h>
#define SYNTAX "Syntax: move <object1> to <object2>\n"

inherit LIB_DAEMON;

int cmd(string a) {
    mixed o1, o2;
    string s1, s2;

    if (ambassadorp(previous_object())) return 0;
    if (!a || (sscanf(a, "%s to %s", s1, s2) < 2)) {
        notify_fail(SYNTAX);
        return 0;
    }

    o1 = get_object(s1, this_player());
    if (!objectp(o1)) {
        notify_fail(wrap("Could not identify " + identify(s1) +
            " as an object."));
        return 0;
    }
    o2 = get_object(s2, this_player());
    if (!objectp(o2)) {
        notify_fail(wrap("Could not identify " + identify(s2) +
            " as an object."));
        return 0;
    }
    write(wrap("Moving " + identify(o1) + " to " + identify(o2) + "..."));
    if (o1->eventMove(o2)) {
        write("Move OK.\n");
        return 1;
    }
    notify_fail("Move failed.\n");
    return 0;
}

int help() {
    write(SYNTAX +
        "Effect: Moves object1 to inside object2\n" +
        "See also: call, update\n" +
        "");
    return 1;
}
