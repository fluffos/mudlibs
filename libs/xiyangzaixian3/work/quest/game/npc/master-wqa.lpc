// master-wqa.c 

#include <ansi.h>

inherit NPC;

void create() {
  set_name(HIW "火云神灵" NOR, ({ "master hyl", "master" }));

  set("long", @LONG
她是火云山庄的神仙，掌管火云山庄的梦幻时空。她身着雪白的衣衫，
雪白的长裙，身形苗条婀娜，气定神闲，轻风动裾，飘飘兮如仙子下凡尘。
你不禁想起庄子的描述：藐姑射之山，有神人居焉，肌肤若冰雪，绰约若
处子，不食五谷，吸风饮露。
LONG
  );

  set("gender", "女性");
  set("age", 18);

  set("str", 50);         // 膂力         
  set("per", 30);         // 容貌
  set("int", 50);         // 悟性         
  set("con", 50);         // 根骨
  set("spi", 30);         // 灵性         
  set("combat_exp", 8000000);



  setup();

  carry_object("/clone/misc/cloth")->wear();

}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
    add_action("do_change", "change");
  }
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;

  message_vision(HIW "\n火云神灵对$N说道:你已经回到了现实世界，你是否决定用声望兑换经验？如果兑换，\n" NOR, ob);
  message_vision(HIW "\t请输入'change'；如果不换请使用qt退出或者go继续。'\n" NOR, ob);

  return;
}

int do_change(string arg) {
  int i, n;
  object ob;

  ob = this_player();

  if (ob->query_temp("wqa's room/change") >= 1)
    return notify_fail("你已经进行过兑换了，下次来到再进行兑换吧。\n");

  i = ob->query_temp("wqa's room/point");
  if (i <= 0) i = 1;
  n = i / 2 + random(i / 2 + 1);

  tell_object(ob, HIW "火云神灵对你说：你现在总共有"
    +chinese_number(i) + "点社会声望。\n" NOR);
  tell_object(ob, HIW "火云神灵对你说：它可以转化为"
    +chinese_number(n) + "点社会经验。\n" NOR);
  tell_object(ob, HIW "火云神灵对你说：而且我再送你"
    +chinese_number(i / 2 + 1) + "点社会声望。\n" NOR);

  ob->add("combat_exp", n);
  ob->set_temp("wqa's room/point", i / 2 + 1);
  ob->set_temp("wqa's room/change", 1);

  return 1;
}
