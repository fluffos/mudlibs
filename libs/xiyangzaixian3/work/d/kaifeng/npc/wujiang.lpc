// wujiang.c LOTS 1998.10.16

inherit NPC;
inherit F_SKILL;

void create() {
  set_name("武将", ({ "wu jiang", "wu", "jiang" }));
  set("gender", "男性");
  set("age", random(10) + 30);
  set("str", 25);
  set("dex", 50);
  set("long", "他站在那里，的确有说不出的威风。\n");
  set("combat_exp", 3000000);
  set("shen_type", 1);
  set("attitude", "peaceful");

  set_skill("cuff", 300);
  set_skill("force", 300);
  set_skill("sword", 300);
  set_skill("dodge", 300);
  set_skill("parry", 300);
  set_skill("shaolin-shenfa", 300);
  set_skill("hunyuan-yiqi", 300);
  set_skill("damo-jian", 300);

  map_skill("force", "hunyuan-yiqi");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("parry", "damo-jian");
  map_skill("cuff", "luohan-quan");
  map_skill("sword", "damo-jian");

  prepare_skill("cuff", "luohan-quan");

  set("neili", 4000);
  set("max_neili", 4000);
  set("jiali", 45);
  set("qi", 3000);
  set("max_qi", 3000);
  set("jiali", 10);

  setup();
  carry_object("/d/kaifeng/obj/godsword")->wield();
  carry_object("/d/kaifeng/obj/yayifu")->wear();
}

void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) &&
    (int)ob->query_condition("killer")) {
    remove_call_out("kill_ob");
    call_out("kill_ob", 1, ob);
  }
}
