#include <ansi.h>

inherit NPC;

string ask_me(object who);

void create() {
  set_name("萧太后", ({ "tai hou", "hou" }));
  set("gender", "女性");
  set("shen_type", 1);
  set("age", 40);
  set("str", 25);
  set("cor", 25);
  set("cps", 25);
  set("int", 25);
  set("long",
    "虽然她是一国之母,些时却也是蓬头垢脸,十分凄惨.\n");

  set("combat_exp", 2000000);
  set("attitude", "heroism");
  set("chat_chance_combat", 15);
  set("chat_msg_combat", ({
    "太后说:我何时才能见到我皇儿啊?\n",
  }));


  set_skill("dodge", 140);
  set_skill("unarmed", 130);
  set_skill("parry", 150);

  setup();

  carry_object("/clone/misc/cloth")->wear();
}
