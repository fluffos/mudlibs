#include <ansi.h>

inherit ITEM;
inherit F_AUTOLOAD;

void create()
{
	set_name("个人电脑A", ({"computer"}));
	set_weight(100);
	set("unit", "台");
	set("long", @LONG
这是一个信息高速传递的时代,时间、效率还有速度，时代要求高效的
巫巫。欢迎使用明氏个人电脑。
LONG
	);
	setup();
}

void init()
{
	object ob;
	ob = this_player();
	add_action("do_cp", "c");
}

int do_cp(string arg)
{
	object ob;
	ob = this_player();
	command("cp " + arg + " /d/huanggon/obj/");
}
