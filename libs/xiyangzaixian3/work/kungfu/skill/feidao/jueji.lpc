#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target)
{
        int damage;
        string msg;
        object weapon;

        if (!target ) target = offensive_target(me);
        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "throwing")
        return notify_fail(RED"你的武器不对\n"NOR);
      if (!target || !target->is_character() || !me->is_fighting(target) )
        return notify_fail("「飞刀绝迹」只能对战斗中的对手使用。\n");
      if ((int)me->query_skill("feidao", 1) < 150 )
        return  
notify_fail(WHT"你的飞刀绝技不够娴熟，还使不出「$N飞刀」。\n"NOR); 
        msg = HIY"$N使出飞刀绝技中$N自创的"HIR "〓【$N飞刀】,\n"NOR;
          if (random(me->query("max_neili"))>target->query("max_neili")/1.5|| 
           random(me->query("combat_exp"))>(int)target->query("combat_exp")/3)
        {
               me->start_busy(10);
                 target->start_busy(random(2));
                damage = (int)me->query_skill("feidao", 1);
                damage = damage + random(damage);
                target->receive_damage("jing", damage*1);
                 target->receive_wound("jing", damage*1); 
     msg+=HIY "$n误以为是小李飞刀，活生生被$N吓倒在地……\n"NOR;
                  me->add("neili", -200);
        } else
        {
                 me->start_busy(4);
        msg += HIY"$n看破$N这招不是小李飞刀信心大增，$N被$n连功数招
\n"NOR;
                me->add("neili", -200);
        }
        message_vision(msg, me, target);
        if(!target->is_fighting(me)) target->fight_ob(me);
        return 1;
}

