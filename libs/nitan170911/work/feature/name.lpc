// name.c
// Written by Lonely@chinamud.cn

#pragma save_binary

#include <ansi.h>
#include <condition.h>

// feature/name.lpc is inherited (as F_NAME) as a SIBLING of F_DBASE by
// char.lpc, not the other way around -- it never inherits F_DBASE itself.
// Every bare set()/query() call in this file (no trailing `ob` redirect)
// therefore hits the exact bootstrapping trap documented in AGENTS.md
// (the F_DBASE simul_efun/bare-call class, see NOTES.md's fix #3):
// unqualified calls from a file that doesn't itself inherit F_DBASE
// resolve against the SIMUL_EFUN OBJECT's own shared `dbase`, not this
// object's, silently reading/writing the wrong (shared, effectively
// empty-for-our-purposes) mapping instead of erroring. Confirmed
// empirically: `set_name(0, id)` (the "compute name from surname+purename"
// path used for every new player registration) always read back
// surname/purename as 0/nil and so always fell through to the "无名氏"
// placeholder -- and even that placeholder never reached the actual
// player object's own dbase, leaving "name" permanently unset on every
// newly-registered character (breaking DATABASE_D->db_new_player()'s
// id/name guard, and everything downstream that depends on the account
// existing in the DB -- see AGENTS.md/NOTES.md for the full chain).
// query_idname() below already worked around this correctly with an
// explicit `this_object()` redirect; every other function in this file
// is fixed the same way here.
inherit F_NATURE;
nosave string *my_id;
string *my_id() { return my_id; }

void set_name(string name, string *id) {
  string fullname;

  if (!stringp(name)) {
    if (!stringp(fullname = query("surname", this_object())))
      fullname = "";

    if (stringp(query("purename", this_object())))
      fullname += query("purename", this_object());

    if (fullname == "")
      fullname = "无名氏";

    set("name", fullname, this_object());
  } else {
    set("name", name, this_object());
  }

  if (pointerp(id)) {
    set("id", id[0], this_object());
    my_id = id;
  }
}

void set_color(string color) {
  string colorname;

  //colorname = color + query("name");
  colorname = color + filter_color(query("name", this_object()), 1);
  colorname = trans_color(colorname, 3);

  set("color", color, this_object());
  set("colorname", colorname + NOR, this_object());
}

int id(string str) {
  string *applied_id;

  if (pointerp(my_id) && member_array(str, my_id) != -1) {
    if (pointerp(applied_id = query_temp("apply/id", this_object()))
      && sizeof(applied_id)) {
      if (this_player() && !wizardp(this_player()))
        return 0;
    }
    return 1;
  }
  return 0;
}

string *parse_command_id_list() {
  /*
        string *applied_id;

        if( pointerp(applied_id = query_temp("apply/id"))
        &&  sizeof(applied_id) )
                return applied_id;
        else
*/
  return my_id;
}

varargs string name(int raw) {
  string str, *mask;

  if (!raw && sizeof(mask = query_temp("apply/name", this_object())))
    return mask[sizeof(mask) - 1];
  else {
    if (stringp(str = query("name", this_object())))
      return str;
    else
      return file_name(this_object());
  }
}

varargs string short(int raw) {
  string str;
  string colorname;

  if (!stringp(colorname = query("colorname", this_object())))
    colorname = name(raw);

  if (raw || !stringp(str = query("short", this_object())))
    str = colorname + "(" + capitalize(query("id", this_object())) + ")";

  return str;
}

varargs string long(int raw) {
  string str, extra, *mask;

  if (!raw && sizeof(mask = query_temp("apply/long", this_object())))
    str = mask[sizeof(mask) - 1];

  else if (!stringp(str = query("long", this_object())))
    str = short(raw) + "。\n";

  if (stringp(extra = this_object()->extra_long()))
    str += extra;

  return str;
}

varargs string query_idname(int raw) {
  return query(
    "name",
    this_object()
  ) + "(" + (raw ? capitalize(query("id", this_object())) : query("id", this_object())) + ")";
}
