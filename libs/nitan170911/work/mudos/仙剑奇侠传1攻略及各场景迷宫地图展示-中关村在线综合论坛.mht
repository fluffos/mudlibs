UE.plugin.register('autosave', function (){

    var me =3D this,
        //=CE=DE=CF=DE=D1=AD=BB=B7=B1=A3=BB=A4
        lastSaveTime =3D new Date(),
        //=D7=EE=D0=A1=B1=A3=B4=E6=BC=E4=B8=F4=CA=B1=BC=E4
        MIN_TIME =3D 20,
        //auto save key
        saveKey =3D null;

    function save ( editor ) {

        var saveData;

        if ( new Date() - lastSaveTime < MIN_TIME ) {
            return;
        }

        if ( !editor.hasContents() ) {
            =
//=D5=E2=C0=EF=B2=BB=C4=DC=B5=F7=D3=C3=C3=FC=C1=EE=C0=B4=C9=BE=B3=FD=A3=AC=
