        }

        //=B5=DA=D2=BB=D0=D0=CB=F9=D3=D0cell=B1=D8=D0=EB=CA=C7th
        firstRows =3D table.rows[ 0 ].cells;
        cellCount =3D firstRows.length;

        for ( var i =3D 0, cell; cell =3D firstRows[ i ]; i++ ) {

            if ( cell.tagName.toLowerCase() !=3D=3D 'th' ) {
                return false;
            }

        }

        for ( var i =3D 1, row; row =3D table.rows[ i ]; i++ ) {

            =
//=C3=BF=D0=D0=B5=A5=D4=AA=B8=F1=CA=FD=B2=BB=C6=A5=C5=E4=A3=AC =
=B7=B5=BB=D8false
            if ( row.cells.length !=3D cellCount ) {
                return false;
            }

            //=B5=DA=D2=BB=C1=D0=B2=BB=CA=C7th=D2=B2=B7=B5=BB=D8false
            if ( row.cells[0].tagName.toLowerCase() !=3D=3D 'th' ) {
                return false;
            }

            for ( var j =3D 1, cell; cell =3D row.cells[ j ]; j++ ) {

                var value =3D utils.trim( ( cell.innerText || =
cell.textContent || '' ) );

                value =3D value.replace( new RegExp( =
UE.dom.domUtils.fillChar, 'g' ), '' ).replace( /^\s+|\s+$/g, '' );

                //=B1=D8=D0=EB=CA=C7=CA=FD=D7=D6
                if ( !/^\d*\.?\d+$/.test( value ) ) {
                    return false;
                }

            }

        }

        return true;

    }

});

