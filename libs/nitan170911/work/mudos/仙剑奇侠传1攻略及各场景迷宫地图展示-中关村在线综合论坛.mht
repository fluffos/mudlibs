            cellCount =3D 0;

        //=D0=D0=CA=FD=B2=BB=B9=BB
        if ( table.rows.length < 2 ) {
            return false;
        }

        //=C1=D0=CA=FD=B2=BB=B9=BB
        if ( table.rows[0].cells.length < 2 ) {
