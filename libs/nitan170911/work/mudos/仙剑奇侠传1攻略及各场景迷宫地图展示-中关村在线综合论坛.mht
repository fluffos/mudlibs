UE.plugins['dragdrop'] =3D function (){

    var me =3D this;
    me.ready(function(){
        domUtils.on(this.body,'dragend',function(){
            var rng =3D me.selection.getRange();
            var node =3D rng.getClosedNode()||me.selection.getStart();

            if(node && node.tagName =3D=3D 'IMG'){

                var pre =3D node.previousSibling,next;
                while(next =3D node.nextSibling){
                    if(next.nodeType =3D=3D 1 && next.tagName =3D=3D =
'SPAN' && !next.firstChild){
                        domUtils.remove(next)
                    }else{
                        break;
                    }
                }


                if((pre && pre.nodeType =3D=3D 1 && =
!domUtils.isEmptyBlock(pre) || !pre) && (!next || next && =
!domUtils.isEmptyBlock(next))){
                    if(pre && pre.tagName =3D=3D 'P' && =
!domUtils.isEmptyBlock(pre)){
                        pre.appendChild(node);
                        domUtils.moveChild(next,pre);
                        domUtils.remove(next);
                    }else  if(next && next.tagName =3D=3D 'P' && =
!domUtils.isEmptyBlock(next)){
                        next.insertBefore(node,next.firstChild);
                    }

                    if(pre && pre.tagName =3D=3D 'P' && =
domUtils.isEmptyBlock(pre)){
                        domUtils.remove(pre)
                    }
                    if(next && next.tagName =3D=3D 'P' && =
domUtils.isEmptyBlock(next)){
                        domUtils.remove(next)
                    }
                    rng.selectNode(node).select();
                    me.fireEvent('saveScene');

                }

            }

        })
    });
    me.addListener('keyup', function(type, evt) {
        var keyCode =3D evt.keyCode || evt.which;
        if (keyCode =3D=3D 13) {
            var rng =3D me.selection.getRange(),node;
            if(node =3D =
domUtils.findParentByTagName(rng.startContainer,'p',true)){
                if(domUtils.getComputedStyle(node,'text-align') =3D=3D =
'center'){
                    domUtils.removeStyle(node,'text-align')
                }
            }
        }
    })
};


