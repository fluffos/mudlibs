/**
 * =B2=E5=C8=EB=B6=CE=C2=E4
 * @command insertparagraph
 * @method execCommand
 * @param { String } cmd =C3=FC=C1=EE=D7=D6=B7=FB=B4=AE
 * @example
 * ```javascript
 * //editor=CA=C7=B1=E0=BC=AD=C6=F7=CA=B5=C0=FD
 * editor.execCommand( 'insertparagraph' );
 * ```
 */

UE.commands['insertparagraph'] =3D {
    execCommand : function( cmdName,front) {
        var me =3D this,
            range =3D me.selection.getRange(),
            start =3D range.startContainer,tmpNode;
        while(start ){
            if(domUtils.isBody(start)){
                break;
            }
            tmpNode =3D start;
            start =3D start.parentNode;
        }
        if(tmpNode){
            var p =3D me.document.createElement('p');
            if(front){
                tmpNode.parentNode.insertBefore(p,tmpNode)
            }else{
                tmpNode.parentNode.insertBefore(p,tmpNode.nextSibling)
            }
            domUtils.fillNode(me.document,p);
            range.setStart(p,0).setCursor(false,true);
        }
    }
};



