// knife.c
#include <weapon.h>

inherit BLADE;
void create()
{
	set_name("柴刀", ({ "cut knife" }));
        set_weight(1000);
        /*if( clonep() )
                set_default_object(__FILE__);
        else*/ {
	set("unit", "把");
	set("value", 500);
	set("material", "iron");
	set("long", "这是一柄半新不旧的柴刀。
");
	set("wield_msg", "$N抽出一把$n握在手中。
");
	set("unequip_msg", "$N将手中的$n插回腰间。
");
        }
        init_blade(5);
	set("set_data", 1);
	set("rigidity", 1);
	set("flag", 6);
	set("verbs", ({ /* sizeof() == 3 */
  "slash",
  "slice",
  "hack"
}));
	set("no_store", 1);
	set("item_owner", "uniax");
	set("no_sell", 1);
	set("stable", 22);
	set("weapon_prop/damage", 5);
	set("consistence", 100);
	set("skill_type", "blade");
        setup();
}
int receive_summon(object me)
{
        return ITEM_D->receive_summon(me, this_object());
}

// 隐藏物品
int hide_anywhere(object me)
{
        return ITEM_D->hide_anywhere(me, this_object());
}


int is_no_clone() { return 1; }

