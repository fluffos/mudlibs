#include <ansi.h>
#include <weapon.h>
inherit BLADE;

void create() {
  set_name("[1;33m神[1;37m之[1;35m祝福[2;37;0m[1;36m宝刀[2;37;0m", ({ "zhufu blade" }));
  set_weight(500);
  /*if (clonep())
                set_default_object(__FILE__);
        else*/
  {
    set("unit", "柄");
    set("long", "[1;33m这便是神之祝福宝刀，三尺来长的单刀。
[2;37;0m");
    set("value", 3000);
    set("no_sell", 1);
    set("rigidity", 166);
    set("material", "tian jing");
    set("no_pawn", 1);
  }

  set("quality_level", 2);
  init_blade(500);
  set("flag", 6);
  set("verbs", ({ /* sizeof() == 3 */
    "slash",
    "slice",
    "hack"
  }));
  set("no_store", 1);
  set("item_owner", "nuomi");
  set("stable", 50);
  set("weapon_prop/damage", 500);
  set("consistence", 100);
  set("skill_type", "blade");
  setup();
}


int receive_summon(object me) {
  return ITEM_D->receive_summon(me, this_object());
}

// 隐藏物品
int hide_anywhere(object me) {
  return ITEM_D->hide_anywhere(me, this_object());
}


int is_no_clone() { return 1; }
