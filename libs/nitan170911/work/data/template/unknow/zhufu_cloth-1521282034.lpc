    "max_age": 30,
  ]));



  set("quality_level", 2);
  set("bind_owner", "asdaw");
  set("armor_type", "cloth");
  set("no_sell", 1);
  set("stable", 0);
  set("consistence", 100);
  set("set_data", 1);
