  set_name("[35m紫金读书勋章[2;37;0m", ({ "study emblem" }));
  set_weight(3000);
  /*if (clonep())
                set_default_object(__FILE__);
        else*/ {
    set("long", MAG "带在身上可以提升读书最大次数三百次。\n" NOR);
    set("unit", "块");
