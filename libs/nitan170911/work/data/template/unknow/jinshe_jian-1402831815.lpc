#include <weapon.h>;
#include <ansi.h>;
inherit SWORD;
inherit F_UNIQUE;

void create()
{
	set_name("[33m金蛇剑[2;37;0m", ({ "jinshe jian" }));
        set_weight(50000);
        /*if (clonep())
                set_default_object(__FILE__);
        else*/ {
	set("unit", "柄");
	set("long", "这剑金光灿烂，握在手中甚是沉重，看来竟是黄金混和了其他五
金所铸，剑身上一道血痕，发出碧油油的暗光，极是诡异。剑的
形状甚是奇特，整柄剑就如是一条蛇盘曲而成，蛇尾勾成剑柄，
蛇头则是剑尖，蛇舌伸出分叉，是以剑尖竟有两叉。
");




	set("value", 10000);
	set("material", "gold");
	set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中，顿时全身凉飕飕地只感寒气逼人。
");
	set("unwield_msg", "$N将手中的$n插回剑鞘。
");
        }
        init_sword(130);
	set("rigidity", 32);
	set("flag", 6);
	set("verbs", ({ /* sizeof() == 3 */
  "slash",
  "slice",
  "thrust"
}));
	set("no_store", 1);
	set("item_owner", "first");
	set("no_sell", 1);
	set("stable", 25);
	set("weapon_prop/damage", 130);
	set("consistence", 100);
	set("skill_type", "sword");
        setup();
}
int receive_summon(object me)
{
        return ITEM_D->receive_summon(me, this_object());
}

// 隐藏物品
int hide_anywhere(object me)
{
        return ITEM_D->hide_anywhere(me, this_object());
}


int is_no_clone() { return 1; }

