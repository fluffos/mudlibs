#include <armor.h>
#include <ansi.h>

inherit MYHEART;

void create() {
  set_name("[1;31m夜叉[2;37;0m", ({ "yecha fu" }));
  set_weight(1);
  /*if( clonep() )
                set_default_object(__FILE__);
        else*/ {
    set("material", "paper");
    set("unit", "张");
    set("long", HIR "这是一张道符，上面画着一个奇特的鬼怪，名曰：夜叉。\n" NOR);
    set("value", 95000);
    set("limit", ([
      "exp": 2000000,
      "str": 60,
      "con": 50,
    ]));
    set("apply_prop/damage", 100);
    set("armor_prop/unarmed_damage", 100);
    set("armor_prop/int", 2);
    set("armor_prop/str", 2);
  }
  set("no_store", 1);
  set("item_owner", "bug");
  set("no_sell", 1);
  set("consistence", 100);
  setup();
}

int query_autoload() {
  return 1;
}
int receive_summon(object me) {
  return ITEM_D->receive_summon(me, this_object());
}

// 隐藏物品
int hide_anywhere(object me) {
  return ITEM_D->hide_anywhere(me, this_object());
}


int is_no_clone() { return 1; }
