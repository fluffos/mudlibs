#include <ansi.h>
#include <armor.h>

inherit WRISTS;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;35m苍穹护手[2;37;0m", ({ "huwan" }));
	set_weight(500);
	set("item_make", 1);
	set("unit", "对");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一对护腕。
女娲补天遗下的七彩石与千年寒铁炼制而成的护手，专破各家内功。[2;37;0m
");
	set("makeinfo", "[1;31m
卢云(yiko)[1;31m 出品
[2;37;0m");
	set("value", 6100000);
	set("point", 288);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname");
	set("quality_level", 6);
	set("wear_msg", "$N骈指如戟，运足真气点在手腕上，只见七彩光芒四射，竟向上延伸出了一双护手。[2;37;0m\n");
	set("remove_msg", "$N手上真气一泄，$n便消散于无形。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/armor", apply_armor());
	set("armor_prop/derive_effect", 3);
	set("armor_prop/avoid_freeze", 0);
	set("armor_prop/dp_power", 3.000000);

	setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
