#include <ansi.h>
#include <armor.h>

inherit FINGER;
inherit F_ITEMMAKE;

void create() {
  set_name("睡袋[2;37;0m", ({ "sleepbag" }));
  set_weight(2100);
  set("item_make", 1);
  set("unit", "套");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一套指套。
[1;37m一个[1;35m睡袋[1;37m，江湖人士用来在野外睡觉用的。[2;37;0m
");
  set("makeinfo", "[1;31m
耶稣(yes)[1;31m 出品
[2;37;0m");
  set("value", 2100000);
  set("point", 161);
  set("max_consistence", 100);
  set("material", "magic stone");
  set("material_file", "/d/item/obj/butian");
  set("quality_level", 4);
  set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/unarmed_damage", apply_damage());
  set("armor_prop/armor", 10);
  set("armor_prop/max_experience", 40000);
  set("armor_prop/research_effect", 2);

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
