#include <ansi.h>
#include <armor.h>

inherit SURCOAT;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[45m[1;36m影月[2;37;0m", ({ "yyue" }));
  set_weight(10000);
  set("item_make", 1);
  set("unit", "件");
  set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一件披风。
[1;33m这是一轮影月。[2;37;0m
");
  set("makeinfo", "[1;31m
影舞(ywu)[1;31m 出品
[2;37;0m");
  set("value", 4100000);
  set("point", 500);
  set("max_consistence", 100);
  set("material", "tian jing");
  set("material_file", "/clone/goods/tianjing");
  set("quality_level", 5);
  set("wear_msg", "[1;33m一丝丝月影藏于亮的背面。[2;37;0m\n");
  set("remove_msg", "[30m月影消失了[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/parry", 30);
  set("armor_prop/research_effect", 6);

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
