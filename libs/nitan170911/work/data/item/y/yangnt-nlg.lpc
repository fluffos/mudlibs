#include <ansi.h>
#include <armor.h>

inherit WAIST;
inherit F_ITEMMAKE;

void create() {
  set_name("内力腰带[2;37;0m", ({ "nlg" }));
  set_weight(560);
  set("item_make", 1);
  set("unit", "条");
  set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一条腰带。
");
  set("makeinfo", "[1;31m
杨泥巴(yangnt)[1;31m 出品
[2;37;0m");
  set("value", 2100000);
  set("point", 200);
  set("max_consistence", 100);
  set("material", "silk");
  set("material_file", "/d/item/obj/tiancs");
  set("quality_level", 2);
  set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
