#include <ansi.h>
#include <weapon.h>

inherit CLUB;
inherit F_ITEMMAKE;

void create() {
  set_name("[5m[1;34m沥泉[1;37m盘龙枪[2;37;0m", ({ "qiang" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "根");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一根棍。
[1;36m此乃古代岳飞使用的名枪沥泉，枪长八尺，枪尖黑中泛红、仿佛有条青龙游动其中。[2;37;0m
");
  set("makeinfo", "[1;31m
岳飞(yfei)[1;31m 出品
[2;37;0m");
  set("value", 2100000);
  set("point", 231);
  set("max_consistence", 100);
  set("material", "magic stone");
  set("material_file", "/d/item/obj/butian");
  set("quality_level", 2);
  set(
    "wield_msg",
    "[1;36m$N长叹一声：“壮志饥餐胡虏肉，笑谈渴饮匈奴血。只见天空一声霹雳，一条青龙化作[1;34m沥泉枪[1;36m从天而落。。。[2;37;0m\n"
  );
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_club(apply_damage());

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
