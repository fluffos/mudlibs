#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;37m云梦泽[2;37;0m", ({ "yunmeng" }));
	set_weight(15000);
	set("item_make", 1);
	set("unit", "柄");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一柄剑。
此剑长四尺二，因剑身锋锐，剑光若水，宛若大泽之美，故以“云梦泽”名之。[2;37;0m
");
	set("makeinfo", "[1;31m
卢云(yiko)[1;31m 出品
[2;37;0m");
	set("value", 35400000);
	set("point", 1765);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname2");
	set("quality_level", 6);
	set("wield_msg", "$N一声长啸，拔剑出鞘，只听嗡的一声，堂上精光暴现，果然剑刃若水，映的大堂流光隐动。[2;37;0m\n");
	set("unwield_msg", "$N一声长叹，将手中长剑插回鞘内。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	init_sword(apply_damage());
	set("weapon_prop/add_blind", 4.000000);
	set("weapon_prop/add_damage", 2.500000);
	set("weapon_prop/research_effect", 3);

	setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
