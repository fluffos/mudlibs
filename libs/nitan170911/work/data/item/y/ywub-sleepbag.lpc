#include <ansi.h>
#include <weapon.h>

inherit THROWING;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;32m睡袋[2;37;0m", ({ "sleepbag" }));
  set_weight(1800);
  set("item_make", 1);
  set("unit", "把");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一把暗器。
");
  set("makeinfo", "[1;31m
冥月秃驴(ywub)[1;31m 出品
[2;37;0m");
  set("value", 2100000);
  set("base_weight", 18);
  set("base_unit", "枚");
  set("base_value", 1);
  set("point", 229);
  set("max_consistence", 100);
  set("material", "magic stone");
  set("material_file", "/d/item/obj/butian");
  set("quality_level", 2);
  set("hand_msg", "[1;33m天边飞来一个套套套在你下身上。\n[1;36m套套自动套动，你只觉得快感如潮。[2;37;0m\n");
  set("unhand_msg", "[1;32m还没二分钟，你竟心中悸动，一下子套套装满了。\n[1;35m呼地一声，套套离你而去，你只觉一阵失落。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set_amount(100);
  init_throwing(apply_damage());

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
