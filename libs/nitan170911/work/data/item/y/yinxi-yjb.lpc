#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;33m音曦[1;31m仙掌[2;37;0m", ({ "yjb" }));
	set_weight(4500);
	set("item_make", 1);
	set("unit", "双");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一双铁掌。
[33m这是一副由[1;33m音曦[36m得自天外的[1;37m无名之物[1;34m打造的[1;33m音曦[1;31m仙掌[2;37;0m[33m，
[36m上面分别刻着一行字句：
[1;33m碧海潮生按玉萧
[1;31m弹指神通影飞落[2;37;0m
");
	set("makeinfo", "[1;31m
音曦(yinxi)[1;31m 出品
[2;37;0m");
	set("value", 34920000);
	set("point", 1741);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname2");
	set("quality_level", 6);
	set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
	set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/unarmed_damage", apply_damage());
	set("armor_prop/armor", 10);
	set("armor_prop/ap_power", 2.000000);
	set("armor_prop/double_damage", 6.000000);

	setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
