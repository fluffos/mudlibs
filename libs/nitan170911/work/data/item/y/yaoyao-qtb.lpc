#include <ansi.h>
#include <weapon.h>

inherit BLADE;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;36m青天刀[2;37;0m", ({ "qtb" }));
	set_weight(15000);
	set("item_make", 1);
	set("unit", "把");
	set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一把刀。
");
	set("makeinfo", "[1;31m
瑶瑶(yaoyao)[1;31m 出品
[2;37;0m");
	set("value", 4100000);
	set("point", 200);
	set("max_consistence", 100);
	set("material", "tian jing");
	set("material_file", "/clone/goods/tianjing");
	set("quality_level", 6);
	set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一把[1;36m$n[1;36m。[2;37;0m\n");
	set("unwield_msg", "$N随手一抹，收起了$n。\n");
	if( !check_clone() ) return;
	restore();
	init_blade(apply_damage());
	set("weapon_prop/add_forget", 2.500000);
	set("weapon_prop/ap_power", 2.000000);
	set("weapon_prop/practice_effect", 3);
	set("weapon_prop/add_busy", 2.500000);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
