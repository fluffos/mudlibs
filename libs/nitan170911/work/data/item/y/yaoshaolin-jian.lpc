#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;32m测试[1;32m[2;37;0m", ({ "jian" }));
	set_weight(1500);
	set("item_make", 1);
	set("unit", "柄");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一柄剑。
");
	set("makeinfo", "[1;31m
明少(yaoshaolin)[1;31m 出品
[2;37;0m");
	set("value", 6100000);
	set("point", 1196);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname");
	set("quality_level", 6);
	set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一柄[1;36m$n[1;36m。[2;37;0m\n");
	set("unwield_msg", "$N随手一抹，收起了$n。\n");
	if( !check_clone() ) return;
	restore();
	init_sword(apply_damage());
	set("weapon_prop/fatal_blow", 2.000000);
	set("weapon_prop/add_weak", 2.500000);
	set("weapon_prop/add_busy", 2.500000);
	set("weapon_prop/add_freeze", 2.500000);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
