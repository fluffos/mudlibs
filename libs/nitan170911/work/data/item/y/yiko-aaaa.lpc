#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m混沌虺[2;37;0m", ({ "aaaa" }));
  set_weight(4500);
  set("item_make", 1);
  set("unit", "双");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一双铁掌。
春秋时期剑术名家支离益，擅屠龙之术，曾斩一恶龙，后冶剑名家风胡子以恶龙之皮掺合天外异宝无名之物炼制出一副掌套，名曰：“混沌虺”[2;37;0m
");
  set("makeinfo", "[1;31m
卢云(yiko)[1;31m 出品
[2;37;0m");
  set("value", 34860000);
  set("point", 1738);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname2");
  set("quality_level", 6);
  set("wear_msg", "$N双臂几处穴道紫光一闪，手上多了一副混沌虺[2;37;0m\n");
  set("remove_msg", "$N双手结了个法印，混沌虺消失无踪[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/unarmed_damage", apply_damage());
  set("armor_prop/armor", 10);
  set("armor_prop/derive_effect", 6);
  set("armor_prop/add_busy", 2.500000);
  set("armor_prop/double_damage", 2.000000);

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
