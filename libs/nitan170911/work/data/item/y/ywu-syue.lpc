#include <ansi.h>
#include <weapon.h>

inherit BLADE;
inherit F_ITEMMAKE;

void create()
{
	set_name("[2;37;0m[45m[1;36m朔月[2;37;0m", ({ "syue" }));
	set_weight(1500);
	set("item_make", 1);
	set("unit", "把");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一把刀。
这是一弯新月。[2;37;0m
");
	set("makeinfo", "[1;31m
影舞(ywu)[1;31m 出品
[2;37;0m");
	set("value", 6100000);
	set("point", 1500);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname");
	set("quality_level", 3);
	set("wield_msg", "[1;33m一弯新月慢慢在手中显现。[2;37;0m\n");
	set("unwield_msg", "[30m朔月慢慢隐于空中。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	init_blade(apply_damage());
	set("weapon_prop/str", 3);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
