#include <ansi.h>
#include <weapon.h>

inherit THROWING;
inherit F_ITEMMAKE;

void create()
{
	set_name("[2;37;0m[30m睡袋[2;37;0m", ({ "sleepbag" }));
	set_weight(1350);
	set("item_make", 1);
	set("unit", "把");
	set("long", "这是由[37m精铁[2;37;0m炼制而成的一把暗器。
一个睡袋，江湖人士用来在野外睡觉用的。[2;37;0m
");
	set("makeinfo", "[1;31m
影舞(ywu)[1;31m 出品
[2;37;0m");
	set("value", 700000);
	set("base_weight", 13);
	set("base_unit", "枚");
	set("base_value", 1);
	set("point", 30);
	set("max_consistence", 100);
	set("material", "iron");
	set("material_file", "/d/item/obj/jingtie");
	set("quality_level", 2);
	set("hand_msg", "[1;36m虚空中突然出现一阵水状波纹。\n$n[1;33m出现在$N面前。[2;37;0m\n");
	set("unhand_msg", "[1;36m虚空中突然出现一阵水状波纹。\n[1;35m$N快速离开从$n[1;35m上一跃而也出，$n[1;35m慢慢消失于虚空中。\n[1;36m你只觉心中有些异样。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set_amount(100);
	init_throwing(apply_damage());

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
