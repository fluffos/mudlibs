#include <ansi.h>
#include <armor.h>

inherit BOOTS;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;32m松[1;37m鹤[32m靴[2;37;0m", ({ "xue" }));
	set_weight(600);
	set("item_make", 1);
	set("unit", "双");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一双靴子。
鞋面上绣有青松、白鹤图纹的靴子。[2;37;0m
");
	set("makeinfo", "[1;31m
卢云(yiko)[1;31m 出品
[2;37;0m");
	set("value", 6100000);
	set("point", 456);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname");
	set("quality_level", 6);
	set("wear_msg", "$N念道：“道可道，非常道”脚上靴子光芒大放，青松随风摇摆，白鹤翩翩起舞，竟似活过来一般。[2;37;0m\n");
	set("remove_msg", "$N轻轻说道：“大成若缺，其用不弊。大盈若冲，其用不穷”脚上靴子又变回平常模样，似乎毫无威能。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/armor", apply_armor());
	set("armor_prop/avoid_forget", 2.500000);
	set("armor_prop/avoid_blind", 1.500000);
	set("armor_prop/reduce_busy", 2.500000);
	set("armor_prop/research_effect", 3);

	setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
