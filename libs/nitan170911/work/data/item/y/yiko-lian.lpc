#include <ansi.h>
#include <armor.h>

inherit WAIST;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[35m勾陈链[2;37;0m", ({ "lian" }));
  set_weight(800);
  set("item_make", 1);
  set("unit", "条");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一条腰带。
传说此物是勾陈上宫大帝误降神力于凡铁之上，凡铁被神力扭曲所形成。[2;37;0m
");
  set("makeinfo", "[1;31m
卢云(yiko)[1;31m 出品
[2;37;0m");
  set("value", 6100000);
  set("point", 466);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname");
  set("quality_level", 6);
  set("wear_msg", "$N将一条闪烁着神力的铁链缀在腰上。[2;37;0m\n");
  set("remove_msg", "$N将腰上铁链解了下来。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/avoid_freeze", 0);
  set("armor_prop/dp_power", 3.000000);
  set("armor_prop/avoid_blind", 1.500000);

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
