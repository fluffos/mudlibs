#include <ansi.h>
#include <armor.h>

inherit HEAD;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[45m[1;36m上弦月[2;37;0m", ({ "sxyue" }));
  set_weight(7500);
  set("item_make", 1);
  set("unit", "顶");
  set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一顶头盔。
[1;33m这是一轮上弦月。[2;37;0m
");
  set("makeinfo", "[1;31m
影舞(ywu)[1;31m 出品
[2;37;0m");
  set("value", 4100000);
  set("point", 500);
  set("max_consistence", 100);
  set("material", "tian jing");
  set("material_file", "/clone/goods/tianjing");
  set("quality_level", 5);
  set("wear_msg", "[1;33m一轮上弦月渐渐升起。[2;37;0m\n");
  set("remove_msg", "[30m上弦月慢慢隐于空中。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/derive_effect", 3);
  set("armor_prop/avoid_blind", 1.500000);
  set("armor_prop/research_effect", 3);

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
