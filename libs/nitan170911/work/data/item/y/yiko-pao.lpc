#include <ansi.h>
#include <armor.h>

inherit CLOTH;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;37m九龙逐日袍[2;37;0m", ({ "pao" }));
	set_weight(2000);
	set("item_make", 1);
	set("unit", "件");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一件战衣。
传说此物为炎帝所制，蕴有上古金乌魔魂，有神鬼莫测之能。[2;37;0m
");
	set("makeinfo", "[1;31m
卢云(yiko)[1;31m 出品
[2;37;0m");
	set("value", 6100000);
	set("point", 859);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname");
	set("quality_level", 6);
	set("wear_msg", "$N捏了个诀，口中吐出几个难解其意的音节，顿时天昏地暗，只见九条五爪金龙围在他身周，化为一件金红色的长袍。[2;37;0m\n");
	set("remove_msg", "$N身子一震，身上的金红色长袍化回九条五爪金龙，飞向天际。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/armor", apply_armor());
	set("armor_prop/full_self", 2.500000);
	set("armor_prop/dp_power", 1.500000);
	set("armor_prop/practice_effect", 3);
	set("armor_prop/reduce_damage", 2.500000);

	setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
