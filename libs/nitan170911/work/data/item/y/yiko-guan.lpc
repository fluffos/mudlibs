#include <ansi.h>
#include <armor.h>

inherit HEAD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;36m进贤冠[2;37;0m", ({ "guan" }));
  set_weight(750);
  set("item_make", 1);
  set("unit", "顶");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一顶头盔。
据说是比干七窍玲珑心所化之物，能通人灵慧。[2;37;0m
");
  set("makeinfo", "[1;31m
卢云(yiko)[1;31m 出品
[2;37;0m");
  set("value", 6100000);
  set("point", 417);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname");
  set("quality_level", 6);
  set("wear_msg", "$N缓缓带上一顶形状奇古的道冠。[2;37;0m\n");
  set("remove_msg", "$N缓缓将头上道冠摘下。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/derive_effect", 3);
  set("armor_prop/avoid_forget", 2.500000);
  set("armor_prop/full_self", 2.500000);
  set("armor_prop/avoid_weak", 2.500000);

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
