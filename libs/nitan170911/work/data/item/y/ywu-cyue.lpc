#include <ansi.h>
#include <weapon.h>

inherit BLADE;
inherit F_ITEMMAKE;

void create()
{
	set_name("[2;37;0m[45m[1;36m残月[2;37;0m", ({ "cyue" }));
	set_weight(15000);
	set("item_make", 1);
	set("unit", "把");
	set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一把刀。
[1;33m这是一轮残月。[2;37;0m
");
	set("makeinfo", "[1;31m
影舞(ywu)[1;31m 出品
[2;37;0m");
	set("value", 4100000);
	set("point", 1000);
	set("max_consistence", 100);
	set("material", "tian jing");
	set("material_file", "/clone/goods/tianjing");
	set("quality_level", 5);
	set("wield_msg", "[1;33m一轮残月渐渐升起。[2;37;0m\n");
	set("unwield_msg", "[30m残月慢慢隐于空中。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	init_blade(apply_damage());
	set("weapon_prop/derive_effect", 3);
	set("weapon_prop/research_effect", 3);
	set("weapon_prop/avoid_defense", 1.500000);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
