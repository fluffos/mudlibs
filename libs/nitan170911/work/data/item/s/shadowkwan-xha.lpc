#include <ansi.h>
#include <armor.h>

inherit ARMOR;
inherit F_ITEMMAKE;

void create() {
  set_name("[43;1m玄黄战甲[2;37;0m", ({ "xha" }));
  set_weight(1500);
  set("item_make", 1);
  set("unit", "张");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一张护甲。
[1;37m以天地间[1;33m玄黄之气[1;37m的精华凝聚而成的一件战甲。[2;37;0m
");
  set("makeinfo", "[1;31m
小天(shadowkwan)[1;31m 出品
[2;37;0m");
  set("value", 6100000);
  set("point", 1200);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname");
  set("quality_level", 6);
  set("wear_msg", "[1;37m但见$N凝神一握，身上凝聚出一件[1;33m玄黄战甲[1;37m。[2;37;0m\n");
  set("remove_msg", "[1;37m但见$N轻轻一呼，[1;33m玄黄战甲[1;37m消散成[1;33m天地玄黄之气[1;37m返回天地间。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/derive_effect", 3);
  set("armor_prop/dp_power", 3.000000);
  set("armor_prop/avoid_die", 2.500000);

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
