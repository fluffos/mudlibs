#include <ansi.h>
#include <weapon.h>

inherit BLADE;
inherit F_ITEMMAKE;

void create() {
  set_name("千雪绝舞刀[2;37;0m", ({ "dao" }));
  set_weight(15000);
  set("item_make", 1);
  set("unit", "把");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一把刀。
一把晶莹剔透千山鸟飞绝的魂魄舞刀[2;37;0m
");
  set("makeinfo", "[1;31m
天青(samesame)[1;31m 出品
[2;37;0m");
  set("value", 28980000);
  set("point", 1444);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname2");
  set("quality_level", 2);
  set("wield_msg", "翻手一转，你提起一把荧光寒煞之斩魂绝舞刀[2;37;0m\n");
  set("unwield_msg", "眩光万丈，你收起绝舞刀[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_blade(apply_damage());

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
