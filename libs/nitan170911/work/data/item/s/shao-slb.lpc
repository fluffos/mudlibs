#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;31m霸下龙魂掌[2;37;0m", ({ "slb" }));
	set_weight(450);
	set("item_make", 1);
	set("unit", "双");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一双铁掌。
[1;31m龙生九子之霸下龙魂掌[2;37;0m
");
	set("makeinfo", "[1;31m
司马长空(shao)[1;31m 出品
[2;37;0m");
	set("value", 6100000);
	set("point", 1500);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname");
	set("quality_level", 2);
	set("wear_msg", "[1;31m落花有意随流水，流水无心恋落花[2;37;0m\n");
	set("remove_msg", "[1;31m问君能有几多愁，恰是一江春水向东流[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/unarmed_damage", apply_damage());
	set("armor_prop/armor", 10);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
