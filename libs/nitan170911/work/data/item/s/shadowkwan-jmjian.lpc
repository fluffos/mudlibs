#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;34m寂灭之剑[2;37;0m", ({ "jmjian" }));
  set_weight(15000);
  set("item_make", 1);
  set("unit", "柄");
  set(
    "long",
    "这是由[1;35m无名之物[2;37;0m炼制而成的一柄剑。
[1;37m一柄通体[1;36m幽[1;34m蓝[1;37m弥漫着[1;34m寂静幻灭[1;37m气息的[1;35m魔剑[1;37m，剑身上幻灭着的[1;33m流光[1;37m令你不禁目眩神迷。[2;37;0m
"
  );
  set("makeinfo", "[1;31m
小天(shadowkwan)[1;31m 出品
[2;37;0m");
  set("value", 35700000);
  set("point", 1780);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname2");
  set("quality_level", 5);
  set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一柄[1;36m$n[1;36m。[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());
  set("weapon_prop/ap_power", 6.000000);

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
