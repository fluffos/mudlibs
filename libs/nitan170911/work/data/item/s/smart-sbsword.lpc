#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;37m蜀八剑[2;37;0m", ({ "sbsword" }));
	set_weight(15000);
	set("item_make", 1);
	set("unit", "柄");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一柄剑。
[33m蜀昭烈帝铸，采金牛山铁，三尺六寸，一备自服，余赐太子禅、梁王理、鲁王永、诸葛亮、关羽、张飞、赵云各一，此乃赵云佩剑。[2;37;0m
");
	set("makeinfo", "[1;31m
竹木一横(smart)[1;31m 出品
[2;37;0m");
	set("value", 34100000);
	set("point", 1700);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname2");
	set("quality_level", 6);
	set("wield_msg", "[33m$N往腰间一抹，只见一道白光闪过，$N手中已多了一柄$n[33m。[2;37;0m\n");
	set("unwield_msg", "[33m$N一振手中$n[33m，$n[33m顿化为点点金茫消散，不见踪迹。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	init_sword(apply_damage());
	set("weapon_prop/fatal_blow", 6.000000);
	set("weapon_prop/add_blind", 2.000000);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
