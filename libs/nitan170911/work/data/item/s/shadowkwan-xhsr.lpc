#include <ansi.h>
#include <armor.h>

inherit SURCOAT;
inherit F_ITEMMAKE;

void create()
{
	set_name("[43;1m玄黄之翼[2;37;0m", ({ "xhsr" }));
	set_weight(1000);
	set("item_make", 1);
	set("unit", "件");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一件披风。
[1;37m以天地间[1;33m玄黄之气[1;37m的精华凝聚而成的一对飞翼。[2;37;0m
");
	set("makeinfo", "[1;31m
小天(shadowkwan)[1;31m 出品
[2;37;0m");
	set("value", 6100000);
	set("point", 750);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname");
	set("quality_level", 6);
	set("wear_msg", "[1;37m但见$N凝神一握，背后凝聚出一对[1;33m玄黄之翼[1;37m。[2;37;0m\n");
	set("remove_msg", "[1;37m但见$N轻轻一呼，[1;33m玄黄之翼[1;37m消散成[1;33m天地玄黄之气[1;37m返回天地间。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/armor", apply_armor());
	set("armor_prop/dp_power", 3.000000);
	set("armor_prop/full_self", 2.500000);
	set("armor_prop/avoid_blind", 1.500000);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
