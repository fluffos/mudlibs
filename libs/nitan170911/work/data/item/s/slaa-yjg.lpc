#include <ansi.h>
#include <armor.h>

inherit HEAD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;33m天[32m花[1;31m乱[37m坠[2;37;0m", ({ "yjg" }));
  set_weight(7500);
  set("item_make", 1);
  set("unit", "顶");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一顶头盔。
");
  set("makeinfo", "[1;31m
渡摩(slaa)[1;31m 出品
[2;37;0m");
  set("value", 35000000);
  set("point", 872);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname2");
  set("quality_level", 6);
  set("wear_msg", "[5m[33m故说般若波罗密多咒[2;37;0m\n");
  set("remove_msg", "[5m[33m揭谛揭谛。波罗揭谛。波罗僧揭谛。菩提萨婆诃[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/research_effect", 9);
  set("armor_prop/avoid_die", 2.500000);

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
