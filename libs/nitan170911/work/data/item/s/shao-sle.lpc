#include <ansi.h>
#include <armor.h>

inherit ARMOR;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;34m金猊龙魂铠[2;37;0m", ({ "sle" }));
	set_weight(15000);
	set("item_make", 1);
	set("unit", "张");
	set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一张护甲。
[1;34m龙生九子之金猊龙魂铠[2;37;0m
");
	set("makeinfo", "[1;31m
司马长空(shao)[1;31m 出品
[2;37;0m");
	set("value", 4100000);
	set("point", 800);
	set("max_consistence", 100);
	set("material", "tian jing");
	set("material_file", "/clone/goods/tianjing");
	set("quality_level", 2);
	set("wear_msg", "[1;34m落花有意随流水，流水无心恋落花[2;37;0m\n");
	set("remove_msg", "[1;34m问君能有几多愁，恰是一江春水向东流[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/armor", apply_armor());

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
