#include <ansi.h>
#include <armor.h>

inherit CLOTH;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;33m金[32m刚[1;31m般[37m若[2;37;0m", ({ "yjb" }));
  set_weight(20000);
  set("item_make", 1);
  set("unit", "件");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一件战衣。
");
  set("makeinfo", "[1;31m
渡摩(slaa)[1;31m 出品
[2;37;0m");
  set("value", 36040000);
  set("point", 1797);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname2");
  set("quality_level", 6);
  set("wear_msg", "[5m[33m应云何住，云何降伏其心[2;37;0m\n");
  set("remove_msg", "[5m[33m菩萨于法，应无所住行于布施[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/avoid_forget", 10.000000);

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
