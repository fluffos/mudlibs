#include <ansi.h>
#include <weapon.h>

inherit STAFF;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;32m绿玉囚龙仗[2;37;0m", ({ "slm" }));
	set_weight(15000);
	set("item_make", 1);
	set("unit", "根");
	set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一根杖。
");
	set("makeinfo", "[1;31m
司马长空(shao)[1;31m 出品
[2;37;0m");
	set("value", 4100000);
	set("point", 1000);
	set("max_consistence", 100);
	set("material", "tian jing");
	set("material_file", "/clone/goods/tianjing");
	set("quality_level", 2);
	set("wield_msg", "[1;32m落花有意速流水，流水无心恋落花[2;37;0m\n");
	set("unwield_msg", "[1;32m问君能有几多愁，恰似一江春水向东流[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	init_staff(apply_damage());

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
