#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create()
{
	set_name("镇魂雪舞剑[2;37;0m", ({ "jian" }));
	set_weight(15000);
	set("item_make", 1);
	set("unit", "柄");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一柄剑。
一把晶莹剔透寒气煞人的镇魂雪舞剑[2;37;0m
");
	set("makeinfo", "[1;31m
天青(samesame)[1;31m 出品
[2;37;0m");
	set("value", 28980000);
	set("point", 1444);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname2");
	set("quality_level", 2);
	set("wield_msg", "大喝一声，你反手拿出一把寒光逼人的雪舞剑[2;37;0m\n");
	set("unwield_msg", "风回路转，你收回雪舞剑[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	init_sword(apply_damage());

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
