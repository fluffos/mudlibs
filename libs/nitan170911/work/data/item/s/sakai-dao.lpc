#include <ansi.h>
#include <weapon.h>

inherit BLADE;
inherit F_ITEMMAKE;

void create()
{
	set_name("[5m[1;33m三菱军刺[2;37;0m", ({ "dao" }));
	set_weight(9000);
	set("item_make", 1);
	set("unit", "把");
	set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一把刀。
[1;37m中国制造[2;37;0m
");
	set("makeinfo", "[1;31m
暴风女(sakai)[1;31m 出品
[2;37;0m");
	set("value", 2100000);
	set("point", 500);
	set("max_consistence", 100);
	set("material", "magic stone");
	set("material_file", "/d/item/obj/butian");
	set("quality_level", 2);
	set("wield_msg", "[1;37m三棱枪刺扎出的伤口，大体上是方形的窟窿[2;37;0m\n");
	set("unwield_msg", "[1;33m刺刀刺进对方身体后顺势旋转刀身[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	init_blade(apply_damage());

	setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
