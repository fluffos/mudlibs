#include <ansi.h>
#include <armor.h>

inherit WRISTS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;33m须[32m弥[1;31m山[37m界[2;37;0m", ({ "yje" }));
  set_weight(5000);
  set("item_make", 1);
  set("unit", "对");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一对护腕。
");
  set("makeinfo", "[1;31m
渡摩(slaa)[1;31m 出品
[2;37;0m");
  set("value", 34140000);
  set("point", 425);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname2");
  set("quality_level", 6);
  set("wear_msg", "[5m[33m远离颠倒梦想。究竟涅磐[2;37;0m\n");
  set("remove_msg", "[5m[33m三世诸佛，依般若波罗密多故[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/avoid_forget", 2.500000);
  set("armor_prop/research_effect", 9);

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
