#include <ansi.h>
#include <armor.h>

inherit WAIST;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;33m研[32m究[1;31m腰[37m带[2;37;0m", ({ "yja" }));
  set_weight(8000);
  set("item_make", 1);
  set("unit", "条");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一条腰带。
");
  set("makeinfo", "[1;31m
神龙(slab)[1;31m 出品
[2;37;0m");
  set("value", 35360000);
  set("point", 705);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname2");
  set("quality_level", 6);
  set("wear_msg", "[1;35m只见四周金光散布，祥云朵朵，远处有凤凰盘绕，麒麟逐戏。耳边传来阵阵梵音。一声长啸，金腰带破空而来[2;37;0m\n");
  set("remove_msg", "[1;35m只见四周金光散布，祥云朵朵，远处有凤凰盘绕，麒麟逐戏。耳边传来阵阵梵音。一声长啸，金腰带化为虚无[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/research_effect", 12);

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
