#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[5m[1;37m寂[31m灭[1;35m神剑[2;37;0m", ({ "msword" }));
  set_weight(15000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一柄剑。
");
  set("makeinfo", "[1;31m
神龙(slab)[1;31m 出品
[2;37;0m");
  set("value", 4100000);
  set("point", 952);
  set("max_consistence", 100);
  set("material", "tian jing");
  set("material_file", "/clone/goods/tianjing");
  set("quality_level", 6);
  set(
    "wield_msg",
    "[5m[1;37m忘我杀境·[1;32m无上神兵[1;35m紫宵剑豪·[1;36m无尽弑戮[1;33m永无止境·[1;31m立地成魔[2;37;0m\n"
  );
  set("unwield_msg", "[5m[1;37m忍把浮名，[35m换[1;36m了[36m浅[1;31m斟[33m低[1;37m唱[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());
  set("weapon_prop/add_forget", 2.500000);
  set("weapon_prop/derive_effect", 3);
  set("weapon_prop/add_blind", 2.000000);
  set("weapon_prop/research_effect", 3);

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
