#include <ansi.h>
#include <armor.h>

inherit WRISTS;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[46m[1;32m内力护腕[2;37;0m", ({ "nld" }));
  set_weight(2250);
  set("item_make", 1);
  set("unit", "对");
  set("long", "这是由[37m精铁[2;37;0m炼制而成的一对护腕。
");
  set("makeinfo", "[1;31m
星宿老妖(smja)[1;31m 出品
[2;37;0m");
  set("value", 700000);
  set("point", 7);
  set("max_consistence", 100);
  set("material", "iron");
  set("material_file", "/d/item/obj/jingtie");
  set("quality_level", 2);
  set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
