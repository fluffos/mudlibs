#include <ansi.h>
#include <armor.h>

inherit FINGER;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;33m罗[32m摩[1;31m衍[37m那[2;37;0m", ({ "bslaa" }));
  set_weight(3500);
  set("item_make", 1);
  set("unit", "套");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一套指套。
");
  set("makeinfo", "[1;31m
渡摩(slaa)[1;31m 出品
[2;37;0m");
  set("value", 35480000);
  set("point", 1769);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname2");
  set("quality_level", 6);
  set("wear_msg", "[5m[33m于意云何，可以身相见如来不[2;37;0m\n");
  set("remove_msg", "[5m[33m凡所有相，皆是虚妄，若见诸相非相，即见如来[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/unarmed_damage", apply_damage());
  set("armor_prop/armor", 10);
  set("armor_prop/ap_power", 8.000000);

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
