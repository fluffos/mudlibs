#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create() {
  set_name("天神之手[2;37;0m", ({ "yjh" }));
  set_weight(4500);
  set("item_make", 1);
  set("unit", "双");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一双铁掌。
");
  set("makeinfo", "[1;31m
神龙(slab)[1;31m 出品
[2;37;0m");
  set("value", 35960000);
  set("point", 1793);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname2");
  set("quality_level", 6);
  set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
