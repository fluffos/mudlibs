#include <ansi.h>
#include <armor.h>

inherit CLOTH;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;35m麒麟龙魂袍[2;37;0m", ({ "slc" }));
  set_weight(20000);
  set("item_make", 1);
  set("unit", "件");
  set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一件战衣。
[1;35m龙生九子之麒麟龙魂袍[2;37;0m
");
  set("makeinfo", "[1;31m
司马长空(shao)[1;31m 出品
[2;37;0m");
  set("value", 4100000);
  set("point", 1000);
  set("max_consistence", 100);
  set("material", "tian jing");
  set("material_file", "/clone/goods/tianjing");
  set("quality_level", 2);
  set("wear_msg", "[1;35m落花有意随流水，流水无心恋落花[2;37;0m\n");
  set("remove_msg", "[1;35m问君能有几多愁，恰是一江春水向东流[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
