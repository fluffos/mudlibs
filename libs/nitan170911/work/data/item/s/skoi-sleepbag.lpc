#include <ansi.h>
#include <weapon.h>

inherit AXE;
inherit F_ITEMMAKE;

void create() {
  set_name("睡袋[2;37;0m", ({ "sleepbag" }));
  set_weight(9900);
  set("item_make", 1);
  set("unit", "把");
  set("long", "这是由[37m精铁[2;37;0m炼制而成的一把斧。
");
  set("makeinfo", "[1;31m
天知道(skoi)[1;31m 出品
[2;37;0m");
  set("value", 700000);
  set("point", 150);
  set("max_consistence", 100);
  set("material", "iron");
  set("material_file", "/d/item/obj/jingtie");
  set("quality_level", 2);
  set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一把[1;36m$n[1;36m。[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_axe(apply_damage());

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
