#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;33m饮血肥鸡[2;37;0m", ({ "kingsly" }));
	set_weight(9000);
	set("item_make", 1);
	set("unit", "柄");
	set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
[1;32m这是一柄形如[1;33m功夫熊猫[1;32m的肥鸡，刀上刻着[1;33m「[1;35m天红亮，血满天，血雨，血气，血花飞[1;36m春雨[1;33m」[1;32m的诗句。[2;37;0m
");
	set("makeinfo", "[1;31m
灭世天命(slefuod)[1;31m 出品
[2;37;0m");
	set("value", 2100000);
	set("point", 220);
	set("max_consistence", 100);
	set("material", "magic stone");
	set("material_file", "/d/item/obj/butian");
	set("quality_level", 2);
	set("wield_msg", "[1;35m$N[1;32m缓缓抽出一柄$n[1;32m，低声轻吟：「[1;36m天空红亮，血满天[1;32m血雨[1;36m，[1;35m血气充天[1;36m血花飞[1;32m」[2;37;0m\n");
	set("unwield_msg", "[1;35m$N[1;32m随手一挥，$n[1;32m已入鞘内。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	init_sword(apply_damage());

	setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
