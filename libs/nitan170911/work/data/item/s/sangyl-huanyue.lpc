#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;36m幻月[2;37;0m", ({ "huanyue" }));
  set_weight(15000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一柄剑。
[1;36m此剑全长三尺八寸，剑身满布菱形的暗纹，铸有鸟篆体铭文“幻月”二字，浑体青光茫茫，给人寒如冰雪、又吹毛可断的锋快感觉。[2;37;0m
");
  set("makeinfo", "[1;31m
桑杨林(sangyl)[1;31m 出品
[2;37;0m");
  set("value", 35140000);
  set("point", 1752);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname2");
  set("quality_level", 2);
  set("wield_msg", "[1;36m霎时间，一阵青芒闪过，幻月便出现在了你的手中。[2;37;0m\n");
  set("unwield_msg", "[1;36m只见青光一闪，幻月便消失的无隐无踪。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
