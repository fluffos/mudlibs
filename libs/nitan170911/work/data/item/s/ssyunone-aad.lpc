#include <ansi.h>
#include <armor.h>

inherit ARMOR;
inherit F_ITEMMAKE;

void create()
{
	set_name("[41;1m[1;37m幻灵之圣甲[2;37;0m", ({ "aad" }));
	set_weight(15000);
	set("item_make", 1);
	set("unit", "张");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一张护甲。
");
	set("makeinfo", "[1;31m
渡欧(ssyunone)[1;31m 出品
[2;37;0m");
	set("value", 35900000);
	set("point", 1432);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname2");
	set("quality_level", 6);
	set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
	set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/armor", apply_armor());
	set("armor_prop/reduce_busy", 5.000000);
	set("armor_prop/reduce_damage", 2.500000);
	set("armor_prop/avoid_busy", 2.500000);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
