#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;33m十二品功德金莲[2;37;0m", ({ "qwa" }));
  set_weight(4500);
  set("item_make", 1);
  set("unit", "双");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一双铁掌。
[1;33m端坐莲台，防御惊人，原为极品先天灵宝，后在封神之战中被蚊道人食去三品，变为九品莲台，使其品质下降，封神之战后，接引道人将九品金莲赐给了如来佛祖。[2;37;0m
");
  set("makeinfo", "[1;31m
暴风女(sakai)[1;31m 出品
[2;37;0m");
  set("value", 35600000);
  set("point", 1775);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname2");
  set("quality_level", 6);
  set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/unarmed_damage", apply_damage());
  set("armor_prop/armor", 10);
  set("armor_prop/add_freeze", 2.500000);
  set("armor_prop/research_effect", 9);

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
