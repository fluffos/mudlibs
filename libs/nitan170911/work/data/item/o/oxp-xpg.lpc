#include <ansi.h>
#include <armor.h>

inherit BOOTS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m仙履[2;37;0m", ({ "xpg" }));
  set_weight(6000);
  set("item_make", 1);
  set("unit", "双");
  set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一双靴子。
[1;37m一对小巧玲珑的仙履，不沾半分尘土，自带九天仙气。[2;37;0m
");
  set("makeinfo", "[1;31m
妙仙(oxp)[1;31m 出品
[2;37;0m");
  set("value", 4100000);
  set("point", 400);
  set("max_consistence", 100);
  set("material", "tian jing");
  set("material_file", "/clone/goods/tianjing");
  set("quality_level", 6);
  set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/dp_power", 3.000000);
  set("armor_prop/research_effect", 6);

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
