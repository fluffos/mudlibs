#include <ansi.h>
#include <armor.h>

inherit ARMOR;
inherit F_ITEMMAKE;

void create()
{
	set_name("风神战甲[2;37;0m", ({ "fszj" }));
	set_weight(15000);
	set("item_make", 1);
	set("unit", "张");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一张护甲。
风之战神征战无数世界的风神战甲，拥有无上法力[2;37;0m
");
	set("makeinfo", "[1;31m
鲍清扬(ormer)[1;31m 出品
[2;37;0m");
	set("value", 34860000);
	set("point", 1390);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname2");
	set("quality_level", 6);
	set("wear_msg", "战无不胜！攻无不克！[2;37;0m\n");
	set("remove_msg", "霸皇卸甲，归隐山林[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/armor", apply_armor());
	set("armor_prop/reduce_damage", 2.500000);
	set("armor_prop/reduce_busy", 2.500000);
	set("armor_prop/avoid_weak", 5.000000);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
