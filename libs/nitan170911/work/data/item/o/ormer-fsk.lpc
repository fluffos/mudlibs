#include <ansi.h>
#include <armor.h>

inherit HEAD;
inherit F_ITEMMAKE;

void create() {
  set_name("风神盔[2;37;0m", ({ "fsk" }));
  set_weight(7500);
  set("item_make", 1);
  set("unit", "顶");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一顶头盔。
风之战神征战无数世界的风神盔，拥有无上法力[2;37;0m
");
  set("makeinfo", "[1;31m
鲍清扬(ormer)[1;31m 出品
[2;37;0m");
  set("value", 34420000);
  set("point", 858);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname2");
  set("quality_level", 6);
  set("wear_msg", "蒙面超人来了[2;37;0m\n");
  set("remove_msg", "终于可以晒晒太阳了[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/avoid_forget", 5.000000);
  set("armor_prop/full_self", 2.500000);
  set("armor_prop/research_effect", 3);

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
