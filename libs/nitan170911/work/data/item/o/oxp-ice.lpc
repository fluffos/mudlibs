#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;37m寒冰[2;37;0m", ({ "ice" }));
	set_weight(15000);
	set("item_make", 1);
	set("unit", "柄");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一柄剑。
[1;32m这是临冬城主的佩剑寒冰，由瓦雷利亚钢锻造，
它看上去通体雪白，幽幽寒光沁人，锋利无比。[2;37;0m
");
	set("makeinfo", "[1;31m
妙仙(oxp)[1;31m 出品
[2;37;0m");
	set("value", 34320000);
	set("point", 1711);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname2");
	set("quality_level", 6);
	set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一柄[1;36m$n[1;36m。[2;37;0m\n");
	set("unwield_msg", "$N随手一抹，收起了$n。\n");
	if( !check_clone() ) return;
	restore();
	init_sword(apply_damage());
	set("weapon_prop/add_damage", 10.000000);

	setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
