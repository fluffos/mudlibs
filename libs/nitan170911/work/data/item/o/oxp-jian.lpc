#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m赤焰[2;37;0m", ({ "jian" }));
  set_weight(1500);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一柄剑。
[1;31m蜀山剑侠徐仙子的成名兵器，
她看上去通体血红娇艳无比，
却能够取人首级于千里之外。[2;37;0m
");
  set("makeinfo", "[1;31m
妙仙(oxp)[1;31m 出品
[2;37;0m");
  set("value", 6100000);
  set("point", 1500);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname");
  set("quality_level", 6);
  set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一柄[1;36m$n[1;36m。[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());
  set("weapon_prop/fatal_blow", 6.000000);
  set("weapon_prop/ap_power", 2.000000);

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
