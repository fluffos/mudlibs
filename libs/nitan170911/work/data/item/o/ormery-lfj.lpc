#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create()
{
	set_name("烈风之剑[2;37;0m", ({ "lfj" }));
	set_weight(15000);
	set("item_make", 1);
	set("unit", "柄");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一柄剑。
烈风战神征战无数界面的烈风神剑，无所匹敌！[2;37;0m
");
	set("makeinfo", "[1;31m
鲍俊德(ormery)[1;31m 出品
[2;37;0m");
	set("value", 35880000);
	set("point", 1789);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname2");
	set("quality_level", 6);
	set("wield_msg", "烈风神剑一出，谁与争锋[2;37;0m\n");
	set("unwield_msg", "该放下时就放下[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	init_sword(apply_damage());
	set("weapon_prop/da_power", 2.000000);
	set("weapon_prop/add_weak", 2.500000);
	set("weapon_prop/add_damage", 2.500000);
	set("weapon_prop/research_effect", 3);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
