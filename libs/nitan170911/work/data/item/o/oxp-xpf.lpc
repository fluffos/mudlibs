#include <ansi.h>
#include <armor.h>

inherit WRISTS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m仙镯[2;37;0m", ({ "xpf" }));
  set_weight(5000);
  set("item_make", 1);
  set("unit", "对");
  set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一对护腕。
[1;37m老君八卦炉内练制的金刚白玉镯，绝非人间凡品。[2;37;0m
");
  set("makeinfo", "[1;31m
妙仙(oxp)[1;31m 出品
[2;37;0m");
  set("value", 4100000);
  set("point", 50);
  set("max_consistence", 100);
  set("material", "tian jing");
  set("material_file", "/clone/goods/tianjing");
  set("quality_level", 6);
  set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/full_self", 2.500000);
  set("armor_prop/research_effect", 9);

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
