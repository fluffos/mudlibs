#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create()
{
	set_name("[2;37;0m[35m风神剑[2;37;0m", ({ "fsw" }));
	set_weight(15000);
	set("item_make", 1);
	set("unit", "柄");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一柄剑。
[1;31m这是一把风神成名前用过的宝剑。斩尽无数妖魔。[2;37;0m
");
	set("makeinfo", "[1;31m
鲍清扬(ormer)[1;31m 出品
[2;37;0m");
	set("value", 34280000);
	set("point", 1709);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname2");
	set("quality_level", 6);
	set("wield_msg", "[5m[35m风神剑[2;37;0m一出谁与争锋[2;37;0m\n");
	set("unwield_msg", "[5m[35m风神剑[5m[2;37;0m带起微微的清风，归隐山林[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	init_sword(apply_damage());
	set("weapon_prop/derive_effect", 3);
	set("weapon_prop/ap_power", 2.000000);
	set("weapon_prop/research_effect", 3);
	set("weapon_prop/add_freeze", 2.500000);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
