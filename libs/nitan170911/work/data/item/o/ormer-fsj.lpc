#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[35m[5m风神剑[2;37;0m", ({ "fsj" }));
  set_weight(15000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一柄剑。
[5m这是[1;31m烈风之神[32m成名之时用的神剑，削铁如泥，斩尽无数妖魔[2;37;0m
");
  set("makeinfo", "[1;31m
鲍清扬(ormer)[1;31m 出品
[2;37;0m");
  set("value", 34620000);
  set("point", 1726);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname2");
  set("quality_level", 3);
  set("wield_msg", "[5m[1;31m风神剑[1;32m一出，谁与争锋[2;37;0m\n");
  set("unwield_msg", "[37m[5m斩不断理还乱[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
