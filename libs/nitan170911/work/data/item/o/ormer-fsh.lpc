#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create()
{
	set_name("风神护手[2;37;0m", ({ "fsh" }));
	set_weight(4000);
	set("item_make", 1);
	set("unit", "双");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一双护手。
风之战神征战无数世界的风神之手，拥有无上法力[2;37;0m
");
	set("makeinfo", "[1;31m
鲍清扬(ormer)[1;31m 出品
[2;37;0m");
	set("value", 34680000);
	set("point", 1729);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname2");
	set("quality_level", 6);
	set("wear_msg", "飞龙探云手[2;37;0m\n");
	set("remove_msg", "得手闪人[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/unarmed_damage", apply_damage());
	set("armor_prop/armor", 10);
	set("armor_prop/derive_effect", 3);
	set("armor_prop/fatal_blow", 2.000000);
	set("armor_prop/practice_effect", 3);
	set("armor_prop/double_damage", 2.000000);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
