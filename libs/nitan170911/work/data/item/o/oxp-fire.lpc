#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m烈焰[2;37;0m", ({ "fire" }));
  set_weight(15000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一柄剑。
[1;31m相传这便是上古时期女娲娘娘运用神力将盘古大神
开天地的巨斧熔化后铸造而成的十二神兵之一[1;31m烈焰[2;37;0m[2;37;0m
");
  set("makeinfo", "[1;31m
妙仙(oxp)[1;31m 出品
[2;37;0m");
  set("value", 34180000);
  set("point", 1704);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname2");
  set("quality_level", 6);
  set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一柄[1;36m$n[1;36m。[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());
  set("weapon_prop/ap_power", 8.000000);

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
