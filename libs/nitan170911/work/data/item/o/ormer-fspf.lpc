#include <ansi.h>
#include <armor.h>

inherit SURCOAT;
inherit F_ITEMMAKE;

void create()
{
	set_name("风神披风[2;37;0m", ({ "fspf" }));
	set_weight(10000);
	set("item_make", 1);
	set("unit", "件");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一件披风。
风之战神征战无数世界的风神披风，拥有无上法力！真是帅呆了！[2;37;0m
");
	set("makeinfo", "[1;31m
鲍清扬(ormer)[1;31m 出品
[2;37;0m");
	set("value", 35320000);
	set("point", 880);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname2");
	set("quality_level", 6);
	set("wear_msg", "哗塞好一个帅哥[2;37;0m\n");
	set("remove_msg", "还是低调点好[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/armor", apply_armor());
	set("armor_prop/full_self", 2.500000);
	set("armor_prop/avoid_blind", 1.500000);
	set("armor_prop/reduce_busy", 5.000000);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
