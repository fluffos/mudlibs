#include <ansi.h>
#include <armor.h>

inherit WAIST;
inherit F_ITEMMAKE;

void create()
{
	set_name("风神腰带[2;37;0m", ({ "fsy" }));
	set_weight(8000);
	set("item_make", 1);
	set("unit", "条");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一条腰带。
风之战神征战无神世界的护腰，拥有无上法力[2;37;0m
");
	set("makeinfo", "[1;31m
鲍清扬(ormer)[1;31m 出品
[2;37;0m");
	set("value", 35080000);
	set("point", 699);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname2");
	set("quality_level", 6);
	set("wear_msg", "风神无敌[2;37;0m\n");
	set("remove_msg", "这世界原来这么小[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/armor", apply_armor());
	set("armor_prop/avoid_forget", 2.500000);
	set("armor_prop/reduce_damage", 2.500000);
	set("armor_prop/research_effect", 3);
	set("armor_prop/avoid_die", 2.500000);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
