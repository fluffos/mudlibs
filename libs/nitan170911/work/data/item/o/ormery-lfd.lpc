#include <ansi.h>
#include <weapon.h>

inherit BLADE;
inherit F_ITEMMAKE;

void create()
{
	set_name("烈风战刀[2;37;0m", ({ "lfd" }));
	set_weight(15000);
	set("item_make", 1);
	set("unit", "把");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一把刀。
烈风战神斩尽无数妖魔的宝刀[2;37;0m
");
	set("makeinfo", "[1;31m
鲍俊德(ormery)[1;31m 出品
[2;37;0m");
	set("value", 35240000);
	set("point", 1757);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname2");
	set("quality_level", 6);
	set("wield_msg", "烈风战刀一出，天下无敌[2;37;0m\n");
	set("unwield_msg", "尘归尘，土归土[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	init_blade(apply_damage());
	set("weapon_prop/fatal_blow", 2.000000);
	set("weapon_prop/add_blind", 2.000000);
	set("weapon_prop/ap_power", 2.000000);
	set("weapon_prop/add_weak", 2.500000);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
