#include <ansi.h>
#include <armor.h>

inherit WRISTS;
inherit F_ITEMMAKE;

void create()
{
	set_name("风神护腕[2;37;0m", ({ "fshw" }));
	set_weight(5000);
	set("item_make", 1);
	set("unit", "对");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一对护腕。
风之战神征战无数世界的风神护腕，拥有无上法力！真是酷啊！[2;37;0m
");
	set("makeinfo", "[1;31m
鲍清扬(ormer)[1;31m 出品
[2;37;0m");
	set("value", 35760000);
	set("point", 445);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname2");
	set("quality_level", 6);
	set("wear_msg", "这护腕不错啊！还能当枕头[2;37;0m\n");
	set("remove_msg", "好想好想你[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/armor", apply_armor());
	set("armor_prop/avoid_blind", 3.000000);
	set("armor_prop/reduce_damage", 2.500000);
	set("armor_prop/avoid_die", 2.500000);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
