#include <ansi.h>
#include <weapon.h>

inherit XSWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[33m铁箫[2;37;0m", ({ "tie" }));
  set_weight(1020);
  set("item_make", 1);
  set("unit", "支");
  set("long", "这是由[1;36m离[1;31m火[1;36m玄[1;37m冰[1;36m玉[2;37;0m炼制而成的一支箫。
");
  set("makeinfo", "[1;31m
盘子(disk)[1;31m 出品
[2;37;0m");
  set("value", 1900000);
  set("point", 145);
  set("max_consistence", 100);
  set("material", "stone");
  set("material_file", "/clone/fam/item/lihuo");
  set("quality_level", 2);
  set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一支[1;36m$n[1;36m。[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_xsword(apply_damage());

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
