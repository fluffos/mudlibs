#include <ansi.h>
#include <armor.h>

inherit CLOTH;
inherit F_ITEMMAKE;

void create()
{
	set_name("[2;37;0m[41;1m[1;37m大花裤衩[2;37;0m", ({ "kucha" }));
	set_weight(3600);
	set("item_make", 1);
	set("unit", "件");
	set("long", "这是由[33m乌金丝[2;37;0m炼制而成的一件战衣。
一条破破烂烂的花裤衩，据说[1;36m大肠[2;37;0m比较喜欢穿。[2;37;0m
");
	set("makeinfo", "[1;31m
大肠干燥(dcgz)[1;31m 出品
[2;37;0m");
	set("value", 1500000);
	set("point", 75);
	set("max_consistence", 100);
	set("material", "silk");
	set("material_file", "/d/item/obj/wujins");
	set("quality_level", 2);
	set("wear_msg", "$N大喊一声：“$n何在？”，只听天空一阵霹雳，$n坐着[1;31m莲花牌[2;37;0m筋斗云飞驰而来，$N穿上$n后立刻觉得容光焕发。[2;37;0m\n");
	set("remove_msg", "$N脱下$n后往天空抛去，手指一指空中的$n，喊：“屁遁！”，$n消失的无影无踪。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/armor", apply_armor());

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
