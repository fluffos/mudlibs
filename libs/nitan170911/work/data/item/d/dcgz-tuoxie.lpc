#include <ansi.h>
#include <armor.h>

inherit BOOTS;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[45m[1;37m大脚拖鞋[2;37;0m", ({ "tuoxie" }));
  set_weight(420);
  set("item_make", 1);
  set("unit", "双");
  set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一双靴子。
这就是[37m大肠干燥[2;37;0m穿的拖鞋。[2;37;0m
");
  set("makeinfo", "[1;31m
大肠干燥(dcgz)[1;31m 出品
[2;37;0m");
  set("value", 2100000);
  set("point", 40);
  set("max_consistence", 100);
  set("material", "silk");
  set("material_file", "/d/item/obj/tiancs");
  set("quality_level", 2);
  set(
    "wear_msg",
    "$n走了过来。\n\n[1;31m看起来$n[1;31m想臭死$N！[2;37;0m\n\n[1;37m$N只感一阵极臭的气味从脚底升起，看来是中了$n[1;37m的剧毒。\n[2;37;0m（$N[31m已经陷入半昏迷状态，神智全失，[2;37;0m）[2;37;0m\n"
  );
  set("remove_msg", "$N扑在地上挣扎了几下，腿一伸，口中喷出几口[1;31m鲜血[2;37;0m，死了！[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
