#include <ansi.h>
#include <armor.h>

inherit FINGER;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[33m福指[2;37;0m", ({ "unbles" }));
  set_weight(1190);
  set("item_make", 1);
  set("unit", "套");
  set("long", "这是由[1;36m离[1;31m火[1;36m玄[1;37m冰[1;36m玉[2;37;0m炼制而成的一套指套。
");
  set("makeinfo", "[1;31m
盘子(disk)[1;31m 出品
[2;37;0m");
  set("value", 1900000);
  set("point", 154);
  set("max_consistence", 100);
  set("material", "stone");
  set("material_file", "/clone/fam/item/lihuo");
  set("quality_level", 2);
  set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/unarmed_damage", apply_damage());
  set("armor_prop/armor", 10);

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
