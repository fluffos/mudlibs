#include <ansi.h>
#include <weapon.h>

inherit XSWORD;
inherit F_ITEMMAKE;

void create()
{
	set_name("[41;1m[36m啸西风[2;37;0m", ({ "xiao" }));
	set_weight(9000);
	set("item_make", 1);
	set("unit", "支");
	set("long", "这是由[36m玄铁[2;37;0m炼制而成的一支箫。
[41;1m[36m丁叮[2;37;0m的[41;1m[36m啸西风[2;37;0m[2;37;0m
");
	set("makeinfo", "[1;31m
丁叮(dingding)[1;31m 出品
[2;37;0m");
	set("value", 1500000);
	set("point", 85);
	set("max_consistence", 100);
	set("material", "steel");
	set("material_file", "/d/item/obj/xuantie");
	set("quality_level", 2);
	set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一支[1;36m$n[1;36m。[2;37;0m\n");
	set("unwield_msg", "$N随手一抹，收起了$n。\n");
	if( !check_clone() ) return;
	restore();
	init_xsword(apply_damage());

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
