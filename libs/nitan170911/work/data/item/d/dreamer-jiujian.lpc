#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create()
{
	set_name("九剑[2;37;0m", ({ "jiujian" }));
	set_weight(6750);
	set("item_make", 1);
	set("unit", "柄");
	set("long", "这是由[37m精铁[2;37;0m炼制而成的一柄剑。
");
	set("makeinfo", "[1;31m
筑梦者(dreamer)[1;31m 出品
[2;37;0m");
	set("value", 700000);
	set("point", 63);
	set("max_consistence", 100);
	set("material", "iron");
	set("material_file", "/d/item/obj/jingtie");
	set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一柄[1;36m$n[1;36m。[2;37;0m\n");
	set("unwield_msg", "$N随手一抹，收起了$n。\n");
	if( !check_clone() ) return;
	restore();
	init_sword(apply_damage());

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
