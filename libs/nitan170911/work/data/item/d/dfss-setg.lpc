#include <ansi.h>
#include <armor.h>

inherit BOOTS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;32m日出[1;31m东方[2;37;0m", ({ "setg" }));
  set_weight(600);
  set("item_make", 1);
  set("unit", "双");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一双靴子。
");
  set("makeinfo", "[1;31m
东方叔叔(dfss)[1;31m 出品
[2;37;0m");
  set("value", 6100000);
  set("point", 600);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname");
  set("quality_level", 6);
  set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/dp_power", 3.000000);
  set("armor_prop/full_self", 2.500000);
  set("armor_prop/avoid_die", 2.500000);

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
