#include <ansi.h>
#include <weapon.h>

inherit XSWORD;
inherit F_ITEMMAKE;

void create()
{
	set_name("[5m[1;31m睡袋[2;37;0m", ({ "sleepbag" }));
	set_weight(1800);
	set("item_make", 1);
	set("unit", "支");
	set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一支箫。
[5m[1;31m睡袋[2;37;0m[1;36m当然就是睡觉的袋子[2;37;0m
");
	set("makeinfo", "[1;31m
灭心(mie)[1;31m 出品
[2;37;0m");
	set("value", 2100000);
	set("point", 116);
	set("max_consistence", 100);
	set("material", "magic stone");
	set("material_file", "/d/item/obj/butian");
	set("quality_level", 2);
	set("wield_msg", "[1;31m$N[1;36m展开$n，[1;36m钻了进去，一会儿就听到如雷般的呼噜声！[2;37;0m\n");
	set("unwield_msg", "[1;31m$N[1;36m收起$n[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	init_xsword(apply_damage());

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
