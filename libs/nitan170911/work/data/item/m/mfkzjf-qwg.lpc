#include <ansi.h>
#include <armor.h>

inherit WRISTS;
inherit F_ITEMMAKE;

void create() {
  set_name("[5m[1;37m太极图[2;37;0m", ({ "qwg" }));
  set_weight(5000);
  set("item_make", 1);
  set("unit", "对");
  set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一对护腕。
[1;37m至高无上的开天圣器。拥有平定地水火风之威、转化阴阳五行之力、分理天道玄机之功、包罗大千万象之能。[2;37;0m
");
  set("makeinfo", "[1;31m
渡苦(mfkzjf)[1;31m 出品
[2;37;0m");
  set("value", 4100000);
  set("point", 250);
  set("max_consistence", 100);
  set("material", "tian jing");
  set("material_file", "/clone/goods/tianjing");
  set("quality_level", 6);
  set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
