#include <ansi.h>
#include <weapon.h>

inherit BLADE;
inherit F_ITEMMAKE;

void create()
{
	set_name("[41;1m寒月刀[2;37;0m", ({ "hyd" }));
	set_weight(1500);
	set("item_make", 1);
	set("unit", "把");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一把刀。
[1;31m一把见血封喉的毒刀，其强度也得到大幅提升，足以斩断当时的秦王佩剑——干将莫邪[2;37;0m
");
	set("makeinfo", "[1;31m
钱小贼(money)[1;31m 出品
[2;37;0m");
	set("value", 6100000);
	set("point", 1500);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname");
	set("quality_level", 6);
	set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一把[1;36m$n[1;36m。[2;37;0m\n");
	set("unwield_msg", "$N随手一抹，收起了$n。\n");
	if( !check_clone() ) return;
	restore();
	init_blade(apply_damage());
	set("weapon_prop/fatal_blow", 6.000000);
	set("weapon_prop/practice_effect", 3);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
