#include <ansi.h>
#include <weapon.h>

inherit WHIP;
inherit F_ITEMMAKE;

void create() {
  set_name("蚊子鞭[2;37;0m", ({ "sleepbag" }));
  set_weight(5000);
  set("item_make", 1);
  set("unit", "条");
  set("long", "这是由百炼精铁炼制而成的一条鞭。
");
  set("makeinfo", "[1;31m
张楚灵(maliyu)[1;31m 出品
[2;37;0m");
  set("value", 12500000);
  set("point", 0);
  set("max_consistence", 100);
  set("material", "iron");
  set("material_file", "/d/item/obj/jingtie");
  set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一条[1;36m$n[1;36m。[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_whip(apply_damage());

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
