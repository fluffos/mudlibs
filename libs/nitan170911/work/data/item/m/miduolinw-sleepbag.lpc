#include <ansi.h>
#include <armor.h>

inherit ARMOR;
inherit F_ITEMMAKE;

void create()
{
	set_name("睡袋[2;37;0m", ({ "sleepbag" }));
	set_weight(2700);
	set("item_make", 1);
	set("unit", "张");
	set("long", "这是由[33m乌金丝[2;37;0m炼制而成的一张护甲。
");
	set("makeinfo", "[1;31m
米多达(miduolinw)[1;31m 出品
[2;37;0m");
	set("value", 1500000);
	set("point", 89);
	set("max_consistence", 100);
	set("material", "silk");
	set("material_file", "/d/item/obj/wujins");
	set("quality_level", 2);
	set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
	set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/armor", apply_armor());

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
