#include <ansi.h>
#include <armor.h>

inherit WRISTS;
inherit F_ITEMMAKE;

void create()
{
	set_name("[41;1m[1;36m灵犀神腕[2;37;0m", ({ "lxf" }));
	set_weight(5000);
	set("item_make", 1);
	set("unit", "对");
	set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一对护腕。
");
	set("makeinfo", "[1;31m
诸葛少卿(mingdi)[1;31m 出品
[2;37;0m");
	set("value", 4100000);
	set("point", 250);
	set("max_consistence", 100);
	set("material", "tian jing");
	set("material_file", "/clone/goods/tianjing");
	set("quality_level", 6);
	set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
	set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/armor", apply_armor());
	set("armor_prop/avoid_forget", 2.500000);
	set("armor_prop/reduce_damage", 2.500000);
	set("armor_prop/avoid_die", 5.000000);

	setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
