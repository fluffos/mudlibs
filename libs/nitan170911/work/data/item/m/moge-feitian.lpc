[5m[1;31m飞[1;32m天[1;33m即出，谁与争锋！[2;37;0m
");
  set("makeinfo", "[1;31m
十八摸(moge)[1;31m 出品
[2;37;0m");
  set("value", 2100000);
  set("point", 100);
  set("max_consistence", 100);
  set("material", "magic stone");
  set("material_file", "/d/item/obj/butian");
  set("quality_level", 2);
  set(
    "wield_msg",
    "[5m[1;31m飞[1;32m天[1;33m即出，谁与争锋！[2;37;0m[1;36m一把[5m[1;31m飞[1;32m天[2;37;0m[1;36m突然出现在[1;32m$N[1;36m的手中，只见天地为之变色，大地为之动摇！[2;37;0m\n"
  );
  set(
    "unwield_msg",
    "[5m[1;31m飞[1;32m天[1;33m入鞘，杀气犹存！[2;37;0m[1;36m只见[5m[1;31m飞[1;32m天[2;37;0m[1;36m突然在[1;32m$N[1;36m的手中消失，乌云顿时散去，阳光普照大地！[2;37;0m\n"
