#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create()
{
	set_name("[2;37;0m红莲老祖[2;37;0m[2;37;0m", ({ "redl" }));
	set_weight(13500);
	set("item_make", 1);
	set("unit", "双");
	set("long", "这是由[36m玄铁[2;37;0m炼制而成的一双铁掌。
[2;37;0m红莲老祖[2;37;0m[2;37;0m是一位二十一级的男性人士。
他看起来有十多岁。
他的武功看来[34m不堪一击[2;37;0m，出手似乎极轻。
他长相猥琐，面目可憎。
他[1;33m身上受伤不轻，正在流着血[2;37;0m。[2;37;0m
");
	set("makeinfo", "[1;31m
皮条妹(mei)[1;31m 出品
[2;37;0m");
	set("value", 1500000);
	set("point", 70);
	set("max_consistence", 100);
	set("material", "steel");
	set("material_file", "/d/item/obj/xuantie");
	set("wear_msg", "[1;31m$N一脚踢在$n[1;31m的屁股上，[1;31m$n[1;31m猝不及防一个华丽的平沙落雁式，向前飞去，就像划过夜空的板砖一样栽进了池塘里。[2;37;0m\n");
	set("remove_msg", "$n[1;31m从池塘里爬出来，对着$N高声欢呼：“好爽！再来！”[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/unarmed_damage", apply_damage());
	set("armor_prop/armor", 10);
	set("armor_prop/hand", 10);
	set("armor_prop/strike", 10);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
