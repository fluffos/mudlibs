#include <ansi.h>
#include <armor.h>

inherit FINGER;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m六脉神剑[2;37;0m", ({ "finger" }));
  set_weight(3500);
  set("item_make", 1);
  set("unit", "套");
  set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一套指套。
狙击步枪[2;37;0m
");
  set("makeinfo", "[1;31m
苦楝树(mfkzjf)[1;31m 出品
[2;37;0m");
  set("value", 4100000);
  set("point", 756);
  set("max_consistence", 100);
  set("material", "tian jing");
  set("material_file", "/clone/goods/tianjing");
  set("quality_level", 5);
  set("wear_msg", "醉里挑灯看剑[2;37;0m\n");
  set("remove_msg", "杀场秋点兵[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/unarmed_damage", apply_damage());
  set("armor_prop/armor", 10);
  set("armor_prop/practice_effect", 3);
  set("armor_prop/leech_neili", 2.000000);

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
