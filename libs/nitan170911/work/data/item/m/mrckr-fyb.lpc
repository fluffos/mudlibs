#include <ansi.h>
#include <armor.h>

inherit BOOTS;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;32m福缘靴[2;37;0m", ({ "fyb" }));
	set_weight(18000);
	set("item_make", 1);
	set("unit", "双");
	set("long", "这是由[36m玄铁[2;37;0m炼制而成的一双靴子。
");
	set("makeinfo", "[1;31m
灵楚(mrckr)[1;31m 出品
[2;37;0m");
	set("value", 1500000);
	set("point", 140);
	set("max_consistence", 100);
	set("material", "steel");
	set("material_file", "/d/item/obj/xuantie");
	set("quality_level", 5);
	set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
	set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/armor", apply_armor());
	set("armor_prop/practice_effect", 3);
	set("armor_prop/kar", 3);
	set("armor_prop/parry", 30);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
