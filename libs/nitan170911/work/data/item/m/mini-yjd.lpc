#include <ansi.h>
#include <armor.h>

inherit SURCOAT;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m合金披风[2;37;0m", ({ "yjd" }));
  set_weight(10000);
  set("item_make", 1);
  set("unit", "件");
  set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一件披风。
[1;31m钢铁侠套装之合金披风，超级记忆纤维制成，坚固无比。[2;37;0m
");
  set("makeinfo", "[1;31m
净米(mini)[1;31m 出品
[2;37;0m");
  set("value", 4100000);
  set("point", 500);
  set("max_consistence", 100);
  set("material", "tian jing");
  set("material_file", "/clone/goods/tianjing");
  set("quality_level", 6);
  set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/avoid_poison", 4.500000);
  set("armor_prop/avoid_busy", 2.500000);

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
