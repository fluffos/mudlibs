#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m飞云剑[2;37;0m", ({ "flysword" }));
  set_weight(1500);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一柄剑。
");
  set("makeinfo", "[1;31m
枫飞扬(maple)[1;31m 出品
[2;37;0m");
  set("value", 6100000);
  set("point", 1450);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname");
  set("quality_level", 3);
  set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一柄[1;36m$n[1;36m。[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());
  set("weapon_prop/study_times", 15);

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
