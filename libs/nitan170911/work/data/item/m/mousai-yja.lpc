#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;32m灵狐[1;35m掌套[2;37;0m", ({ "yja" }));
  set_weight(4000);
  set("item_make", 1);
  set("unit", "双");
  set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一双护手。
");
  set("makeinfo", "[1;31m
缪斯(mousai)[1;31m 出品
[2;37;0m");
  set("value", 4100000);
  set("point", 1000);
  set("max_consistence", 100);
  set("material", "tian jing");
  set("material_file", "/clone/goods/tianjing");
  set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/unarmed_damage", apply_damage());
  set("armor_prop/armor", 10);
  set("armor_prop/cuff", 10);
  set("armor_prop/unarmed", 10);

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
