#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[5m[1;36m盘古幡[2;37;0m", ({ "qwi" }));
  set_weight(15000);
  set("item_make", 1);
  set("unit", "柄");
  set(
    "long",
    "这是由[1;35m无名之物[2;37;0m炼制而成的一柄剑。
[1;36m混沌钟是一件上古开天圣器，为三大先天至宝之一，拥有镇压混沌之威、颠倒时空之力、炼化阴阳之功、扭转乾坤之能。混沌钟玄妙无限、造化无穷，可以禁锢时间、镇压空间，主宰三千大道奥义之中的“时空”之奥义。[2;37;0m
"
  );
  set("makeinfo", "[1;31m
渡苦(mfkzjf)[1;31m 出品
[2;37;0m");
  set("value", 35740000);
  set("point", 1782);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname2");
  set("quality_level", 6);
  set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一柄[1;36m$n[1;36m。[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());
  set("weapon_prop/ap_power", 2.000000);
  set("weapon_prop/research_effect", 9);

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
