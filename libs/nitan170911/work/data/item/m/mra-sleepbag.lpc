#include <ansi.h>
#include <weapon.h>

inherit XSWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m[45;1m紫电青霜[2;37;0m", ({ "sleepbag" }));
  set_weight(3000);
  set("item_make", 1);
  set("unit", "支");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一支箫。
");
  set("makeinfo", "[1;31m
迅雷哥(mra)[1;31m 出品
[2;37;0m");
  set("value", 34860000);
  set("point", 1738);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname2");
  set("quality_level", 2);
  set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一支[1;36m$n[1;36m。[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_xsword(apply_damage());

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
