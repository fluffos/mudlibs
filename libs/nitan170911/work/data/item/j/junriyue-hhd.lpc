#include <ansi.h>
#include <armor.h>

inherit WRISTS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;36m昆仑镜[2;37;0m", ({ "hhd" }));
  set_weight(500);
  set("item_make", 1);
  set("unit", "对");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一对护腕。
");
  set("makeinfo", "[1;31m
君日月(junriyue)[1;31m 出品
[2;37;0m");
  set("value", 6100000);
  set("point", 344);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname");
  set("quality_level", 6);
  set("wear_msg", "[1;36m昆仑镜自$N背后冉冉升起，宛如明月，皎皎清光洒落，妖魔鬼怪无所遁形。[2;37;0m\n");
  set("remove_msg", "[1;36m$N元灵归心，意守灵台。昆仑镜的光芒也渐渐随之淡去。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/dp_power", 1.500000);
  set("armor_prop/research_effect", 9);

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
