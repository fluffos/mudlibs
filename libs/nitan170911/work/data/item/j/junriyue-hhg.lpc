#include <ansi.h>
#include <armor.h>

inherit SURCOAT;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m诛仙阵[2;37;0m", ({ "hhg" }));
  set_weight(1000);
  set("item_make", 1);
  set("unit", "件");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一件披风。
");
  set("makeinfo", "[1;31m
君日月(junriyue)[1;31m 出品
[2;37;0m");
  set("value", 6100000);
  set("point", 688);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname");
  set("quality_level", 6);
  set("wear_msg", "[1;37m诛仙阵图引动诛仙四剑，于无声无息之时布下开天辟地以来天道第一杀阵。诛戮\n陷绝四剑分立四方，无穷杀意笼罩鸿蒙。[2;37;0m\n");
  set("remove_msg", "[1;37m$N念诵真言，诛仙剑阵悄然散入天地之间。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/full_self", 2.500000);
  set("armor_prop/research_effect", 9);

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
