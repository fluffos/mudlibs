#include <ansi.h>
#include <armor.h>

inherit CLOTH;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;33m太极图[2;37;0m", ({ "hhb" }));
  set_weight(2000);
  set("item_make", 1);
  set("unit", "件");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一件战衣。
");
  set("makeinfo", "[1;31m
君日月(junriyue)[1;31m 出品
[2;37;0m");
  set("value", 6100000);
  set("point", 1376);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname");
  set("quality_level", 6);
  set("wear_msg", "[1;33m$N将太极图抖开，化作一道金桥，当空环绕，所过之处地水火风皆平。[2;37;0m\n");
  set("remove_msg", "[1;33m$N收起太极图，空间中的地水火风才又活跃起来。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/reduce_busy", 2.500000);
  set("armor_prop/research_effect", 9);

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
