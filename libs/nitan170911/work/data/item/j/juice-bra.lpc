#include <ansi.h>
#include <armor.h>

inherit CLOTH;
inherit F_ITEMMAKE;

void create() {
  set_name("粉色胸罩[2;37;0m", ({ "bra" }));
  set_weight(1400);
  set("item_make", 1);
  set("unit", "件");
  set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一件战衣。
这胸罩上绣了些小碎花[2;37;0m
");
  set("makeinfo", "[1;31m
心宝贝(juice)[1;31m 出品
[2;37;0m");
  set("value", 2100000);
  set("point", 100);
  set("max_consistence", 100);
  set("material", "silk");
  set("material_file", "/d/item/obj/tiancs");
  set("quality_level", 2);
  set("wear_msg", "香风吹起，胸罩自动穿上[2;37;0m\n");
  set("remove_msg", "胸口一凉，原来大肠把胸罩扯落了[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
