#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create()
{
	set_name("生日快乐[2;37;0m", ({ "hbd" }));
	set_weight(4500);
	set("item_make", 1);
	set("unit", "双");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一双铁掌。
生日快乐[31m[2;37;0m
");
	set("makeinfo", "[1;31m
心宝贝(juice)[1;31m 出品
[2;37;0m");
	set("value", 34400000);
	set("point", 1715);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname2");
	set("quality_level", 2);
	set("wear_msg", "祝你生日快乐啦啦啦[2;37;0m\n");
	set("remove_msg", "奶油！奶油抹脸；抹脸[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/unarmed_damage", apply_damage());
	set("armor_prop/armor", 10);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
