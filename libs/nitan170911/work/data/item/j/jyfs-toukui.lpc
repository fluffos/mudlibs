#include <ansi.h>
#include <armor.h>

inherit HEAD;
inherit F_ITEMMAKE;

void create() {
  set_name("头盔[2;37;0m", ({ "toukui" }));
  set_weight(7500);
  set("item_make", 1);
  set("unit", "顶");
  set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一顶头盔。
");
  set("makeinfo", "[1;31m
轩辕枫(jyfs)[1;31m 出品
[2;37;0m");
  set("value", 4100000);
  set("point", 500);
  set("max_consistence", 100);
  set("material", "tian jing");
  set("material_file", "/clone/goods/tianjing");
  set("quality_level", 5);
  set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/dex", 3);
  set("armor_prop/avoid_poison", 1.500000);
  set("armor_prop/avoid_attack", 1.500000);

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
