#include <ansi.h>
#include <armor.h>

inherit HEAD;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;31m东皇钟[2;37;0m", ({ "hha" }));
	set_weight(750);
	set("item_make", 1);
	set("unit", "顶");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一顶头盔。
");
	set("makeinfo", "[1;31m
君日月(junriyue)[1;31m 出品
[2;37;0m");
	set("value", 6100000);
	set("point", 688);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname");
	set("quality_level", 6);
	set("wear_msg", "[1;31m$N将东皇钟祭于头顶，顿时道道玄黄之气垂落，化作祥云，护住全身。[2;37;0m\n");
	set("remove_msg", "[1;31m$N收回东皇钟，护身的朵朵云气也随之散去了。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/armor", apply_armor());
	set("armor_prop/avoid_poison", 1.500000);
	set("armor_prop/research_effect", 9);

	setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
