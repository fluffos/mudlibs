#include <ansi.h>
#include <armor.h>

inherit BOOTS;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;32m净世莲[2;37;0m", ({ "hhf" }));
	set_weight(600);
	set("item_make", 1);
	set("unit", "双");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一双靴子。
");
	set("makeinfo", "[1;31m
君日月(junriyue)[1;31m 出品
[2;37;0m");
	set("value", 6100000);
	set("point", 550);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname");
	set("quality_level", 6);
	set("wear_msg", "[1;32m$N将净世莲望空一掷，净世莲化作一朵九品莲台，落于$N足下。万朵青莲\n随之升起，万法不侵，万魔难近。[2;37;0m\n");
	set("remove_msg", "[1;32m九品莲台渐渐缩小，化作净世青莲飞入法宝囊中。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/armor", apply_armor());
	set("armor_prop/derive_effect", 3);
	set("armor_prop/research_effect", 9);

	setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
