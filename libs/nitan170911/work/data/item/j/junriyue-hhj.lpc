#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;36m长[1;31m歌[1;37m剑[2;37;0m", ({ "hhj" }));
  set_weight(15000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一柄剑。
");
  set("makeinfo", "[1;31m
君日月(junriyue)[1;31m 出品
[2;37;0m");
  set("value", 35860000);
  set("point", 1788);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname2");
  set("quality_level", 6);
  set(
    "wield_msg",
    "[1;36m$N双手掐诀，清声低诵：“天之苍苍，辽阔其长，地之莽莽，厚载\n其广；月之茫茫，会赢其光，日之煌煌，中其正阳。”随着吟唱之声，\n长歌剑一声轻鸣，跃出鞘中，悬于身前。剑光如水，剑气冲霄。[2;37;0m\n"
  );
  set(
    "unwield_msg",
    "[1;37m$N凝神结印，口中默念：“怜我世人，飘零无助，除恶扬善，唯光明故；\n生亦何欢，死亦何苦，喜乐悲愁，皆归尘土。”长歌剑一声龙吟，破空而起，\n化作一道碧光，投入鞘中。众人皆嘘出一口长气，如释重负。[2;37;0m\n"
  );
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());
  set("weapon_prop/ap_power", 6.000000);
  set("weapon_prop/da_power", 2.000000);

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
