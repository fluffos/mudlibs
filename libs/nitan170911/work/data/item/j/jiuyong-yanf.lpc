#include <ansi.h>
#include <armor.h>

inherit WAIST;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;33m燕王腰带[2;37;0m", ({ "yanf" }));
  set_weight(8000);
  set("item_make", 1);
  set("unit", "条");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一条腰带。
[1;33m这是大燕国流传下来仅有的一套装备【燕王套装】之燕王腰带。[2;37;0m
");
  set("makeinfo", "[1;31m
慕容复燕(jiuyong)[1;31m 出品
[2;37;0m");
  set("value", 35500000);
  set("point", 708);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname2");
  set("quality_level", 6);
  set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/derive_effect", 3);
  set("armor_prop/avoid_busy", 7.500000);

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
