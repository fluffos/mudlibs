#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;33m燕王护手[2;37;0m", ({ "yank" }));
  set_weight(4000);
  set("item_make", 1);
  set("unit", "双");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一双护手。
[1;33m这是大燕国流传下来仅有的一套装备【燕王套装】之燕王护手。[2;37;0m
");
  set("makeinfo", "[1;31m
慕容复燕(jiuyong)[1;31m 出品
[2;37;0m");
  set("value", 34860000);
  set("point", 1738);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname2");
  set("quality_level", 6);
  set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/unarmed_damage", apply_damage());
  set("armor_prop/armor", 10);
  set("armor_prop/da_power", 2.000000);
  set("armor_prop/add_damage", 2.500000);
  set("armor_prop/research_effect", 3);
  set("armor_prop/add_freeze", 2.500000);

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
