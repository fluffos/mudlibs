#include <ansi.h>
#include <armor.h>

inherit ARMOR;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;35m乾坤鼎[2;37;0m", ({ "hhc" }));
	set_weight(1500);
	set("item_make", 1);
	set("unit", "张");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一张护甲。
");
	set("makeinfo", "[1;31m
君日月(junriyue)[1;31m 出品
[2;37;0m");
	set("value", 6100000);
	set("point", 1101);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname");
	set("quality_level", 6);
	set("wear_msg", "[1;35m$N祭起乾坤鼎，默念真言，乾坤鼎化作一件血色铠甲，披在身躯之上。[2;37;0m\n");
	set("remove_msg", "[1;35m$N双臂一振，身上铠甲化作万道光华，飞到空中，重新幻化为乾坤鼎。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/armor", apply_armor());
	set("armor_prop/avoid_poison", 1.500000);
	set("armor_prop/research_effect", 9);

	setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
