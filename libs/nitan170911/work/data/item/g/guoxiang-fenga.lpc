#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create()
{
	set_name("凤掌[2;37;0m", ({ "fenga" }));
	set_weight(4500);
	set("item_make", 1);
	set("unit", "双");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一双铁掌。
最美丽的凤凰[2;37;0m
");
	set("makeinfo", "[1;31m
郭襄(guoxiang)[1;31m 出品
[2;37;0m");
	set("value", 35220000);
	set("point", 1756);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname2");
	set("quality_level", 6);
	set("wear_msg", "一声凤鸣[2;37;0m\n");
	set("remove_msg", "凤凰鸣叫销失了[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/unarmed_damage", apply_damage());
	set("armor_prop/armor", 10);
	set("armor_prop/derive_effect", 3);
	set("armor_prop/add_blind", 2.000000);
	set("armor_prop/practice_effect", 3);
	set("armor_prop/add_damage", 2.500000);

	setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
