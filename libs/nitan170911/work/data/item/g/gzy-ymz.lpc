#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;37m极光[1;31m阳明[1;36m掌[2;37;0m", ({ "ymz" }));
	set_weight(4500);
	set("item_make", 1);
	set("unit", "双");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一双铁掌。
[1;31m装备此掌，犹如一轮红日融于手上，无需出招，敌人已然目眩心迷[2;37;0m
");
	set("makeinfo", "[1;31m
顾正阳(gzy)[1;31m 出品
[2;37;0m");
	set("value", 35540000);
	set("point", 1772);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname2");
	set("quality_level", 5);
	set("wear_msg", "[1;31m突然之间，$N的手掌仿佛燃烧了起来，继而炫光四射，周围众人皆无法睁开双眼。等到极光稍退，一副铁掌已然出现在$N手上。[2;37;0m\n");
	set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/unarmed_damage", apply_damage());
	set("armor_prop/armor", 10);
	set("armor_prop/practice_effect", 3);
	set("armor_prop/skill", 0);
	set("armor_prop/double_damage", 2.000000);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
