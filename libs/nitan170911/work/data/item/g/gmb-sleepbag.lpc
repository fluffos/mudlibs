#include <ansi.h>
#include <weapon.h>

inherit THROWING;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;37m[45;1m佛光普照[2;37;0m", ({ "sleepbag" }));
	set_weight(3000);
	set("item_make", 1);
	set("unit", "把");
	set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一把暗器。
");
	set("makeinfo", "[1;31m
静蓉(gmb)[1;31m 出品
[2;37;0m");
	set("value", 4100000);
	set("base_weight", 30);
	set("base_unit", "枚");
	set("base_value", 1);
	set("point", 1000);
	set("max_consistence", 100);
	set("material", "tian jing");
	set("material_file", "/clone/goods/tianjing");
	set("quality_level", 5);
	set("hand_msg", "[1;36m$N[1;36m一声清啸，握着一把[1;36m$n[1;36m。[2;37;0m\n");
	set("unhand_msg", "$N随手一抹，收起了$n。\n");
	if( !check_clone() ) return;
	restore();
	set_amount(100);
	init_throwing(apply_damage());
	set("weapon_prop/leech_qi", 2.000000);
	set("weapon_prop/max_potential", 50000);
	set("weapon_prop/research_effect", 3);

	setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
