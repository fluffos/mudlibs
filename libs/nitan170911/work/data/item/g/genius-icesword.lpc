#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;37m冰魄寒光[2;37;0m", ({ "icesword" }));
	set_weight(1500);
	set("item_make", 1);
	set("unit", "柄");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一柄剑。
[1;37m这是一柄九天寒冰精华凝炼而成的神剑，造型古朴，晶莹剔透，萦绕着摄人心魄的点点寒光。[2;37;0m
");
	set("makeinfo", "[1;31m
雪舞聆风(genius)[1;31m 出品
[2;37;0m");
	set("value", 6100000);
	set("point", 1500);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname");
	set("quality_level", 5);
	set("wield_msg", "[1;37m$N神情渐冷，犹如万物凝冰，天地间突现无数寒光奔流汇聚成手中冰魄寒光剑。[2;37;0m\n");
	set("unwield_msg", "[1;37m$N展颜一笑，宛若春风解冻，手中冰魄寒光剑化作万千寒光渐渐消散于天地间。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	init_sword(apply_damage());
	set("weapon_prop/research_effect", 3);
	set("weapon_prop/double_damage", 2.000000);
	set("weapon_prop/avoid_defense", 1.500000);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
