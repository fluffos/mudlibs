#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;33m九阳夺魄剑[2;37;0m", ({ "jyjian" }));
  set_weight(15000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一柄剑。
[1;32m这是一柄[1;33m价值连城[1;32m的稀世宝剑，观其华，如芙蓉始出；观其才，焕焕如冰释；剑上刻着[1;33m「[1;35m魂归来兮[1;36m」[2;37;0m
");
  set("makeinfo", "[1;31m
张有悔(guangming)[1;31m 出品
[2;37;0m");
  set("value", 34580000);
  set("point", 1724);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname2");
  set("quality_level", 3);
  set(
    "wield_msg",
    "[1;35m$N[1;32m缓缓抽出一柄$n[1;32m，低声轻吟：「[1;36m才高九天兮[1;32m志通四海[1;36m，[1;35m气御灵凤兮[1;36m声唤神龙[1;32m」[2;37;0m\n"
  );
  set("unwield_msg", "[1;35m$N[1;32m随手一挥，$n[1;32m已还剑入鞘。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());
  set("weapon_prop/avoid_dodge", 1.000000);

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
