#include <ansi.h>
#include <weapon.h>

inherit WHIP;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;33m黄粱枕[2;37;0m", ({ "sleepbag" }));
	set_weight(1050);
	set("item_make", 1);
	set("unit", "根");
	set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一根鞭。
");
	set("makeinfo", "[1;31m
胡飞(hufei)[1;31m 出品
[2;37;0m");
	set("value", 2100000);
	set("point", 100);
	set("max_consistence", 100);
	set("material", "silk");
	set("material_file", "/d/item/obj/tiancs");
	set("quality_level", 6);
	set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一根[1;36m$n[1;36m。[2;37;0m\n");
	set("unwield_msg", "$N随手一抹，收起了$n。\n");
	if( !check_clone() ) return;
	restore();
	init_whip(apply_damage());
	set("weapon_prop/add_forget", 2.500000);
	set("weapon_prop/fatal_blow", 2.000000);
	set("weapon_prop/derive_effect", 3);
	set("weapon_prop/da_power", 2.000000);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
