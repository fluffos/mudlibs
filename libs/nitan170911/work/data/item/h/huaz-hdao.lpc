#include <ansi.h>
#include <weapon.h>

inherit BLADE;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;33m一[1;32m串[1;31m红[2;37;0m", ({ "hdao" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "把");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一把刀。
[1;35m花色鲜艳夺目，适作成片摆设，布置花坛，装点节日。一串红代表恋爱的心，
一串白代表精力充沛，一串紫代表智慧。[2;37;0m
");
  set("makeinfo", "[1;31m
花花太帅(huaz)[1;31m 出品
[2;37;0m");
  set("value", 2100000);
  set("point", 453);
  set("max_consistence", 100);
  set("material", "magic stone");
  set("material_file", "/d/item/obj/butian");
  set("quality_level", 5);
  set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一把[1;36m$n[1;36m。[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_blade(apply_damage());
  set("weapon_prop/ap_power", 2.000000);
  set("weapon_prop/derive_times", 15);
  set("weapon_prop/leech_qi", 2.000000);

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
