#include <ansi.h>
#include <armor.h>

inherit FINGER;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;32m赌神扳指[2;37;0m", ({ "dus" }));
	set_weight(2100);
	set("item_make", 1);
	set("unit", "套");
	set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一套指套。
[1;36m赌神高进的[1;32m翡翠戒指[1;36m，因为一次大意将戒指输给了赌坛后起之秀小曼。[2;37;0m
");
	set("makeinfo", "[1;31m
小曼(hanhan)[1;31m 出品
[2;37;0m");
	set("value", 2100000);
	set("point", 219);
	set("max_consistence", 100);
	set("material", "magic stone");
	set("material_file", "/d/item/obj/butian");
	set("quality_level", 2);
	set("wear_msg", "[1;36m$N从口袋拿出一枚[1;32m翡翠扳指[1;36m戴在左右中指上，习惯性的转动了两下。[2;37;0m\n");
	set("remove_msg", "[1;36m$N摘下[1;32m翡翠扳指[1;36m放回口袋里。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/unarmed_damage", apply_damage());
	set("armor_prop/armor", 10);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
