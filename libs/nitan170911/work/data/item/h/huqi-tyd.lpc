#include <ansi.h>
#include <weapon.h>

inherit BLADE;
inherit F_ITEMMAKE;

void create() {
  set_name("[5m[1;33m太阳魔刀[2;37;0m", ({ "tyd" }));
  set_weight(1500);
  set("item_make", 1);
  set("unit", "把");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一把刀。
");
  set("makeinfo", "[1;31m
胡老七(huqi)[1;31m 出品
[2;37;0m");
  set("value", 6100000);
  set("point", 1500);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname");
  set("quality_level", 6);
  set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一把[1;36m$n[1;36m。[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_blade(apply_damage());
  set("weapon_prop/add_forget", 2.500000);
  set("weapon_prop/ap_power", 6.000000);

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
