#include <ansi.h>
#include <weapon.h>

inherit BLADE;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m星[1;37m空[2;37;0m", ({ "xingkong" }));
  set_weight(15000);
  set("item_make", 1);
  set("unit", "把");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一把刀。
[1;37m笼罩辉夜，遥仰星空[2;37;0m
");
  set("makeinfo", "[1;31m
辉夜(huiye)[1;31m 出品
[2;37;0m");
  set("value", 28140000);
  set("point", 1402);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname2");
  set("quality_level", 5);
  set("wield_msg", "[1;32m沉睡于星空之下吧。[2;37;0m\n");
  set("unwield_msg", "[1;32m褪去吧。光明！[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_blade(apply_damage());
  set("weapon_prop/da_power", 2.000000);
  set("weapon_prop/int", 3);
  set("weapon_prop/avoid_defense", 1.500000);

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
