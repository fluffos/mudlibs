#include <ansi.h>
#include <armor.h>

inherit CLOTH;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m赌圣战袍[2;37;0m", ({ "zhanpao" }));
  set_weight(3600);
  set("item_make", 1);
  set("unit", "件");
  set("long", "这是由[33m乌金丝[2;37;0m炼制而成的一件战衣。
[1;36m赌圣阿星的战袍，因为一次失手输给了赌坛后起之秀小曼。[2;37;0m
");
  set("makeinfo", "[1;31m
小曼(hanhan)[1;31m 出品
[2;37;0m");
  set("value", 1500000);
  set("point", 153);
  set("max_consistence", 100);
  set("material", "silk");
  set("material_file", "/d/item/obj/wujins");
  set("quality_level", 2);
  set("wear_msg", "[1;36m$N披上一件[1;31m风衣[1;36m，顿时气势磅礴，围观的重任只感觉一股无形的压力随之而来。[2;37;0m\n");
  set("remove_msg", "[1;36m$N脱下[1;31m风衣[1;36m，随手丢给跟着的小弟。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
