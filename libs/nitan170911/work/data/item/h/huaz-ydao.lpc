#include <ansi.h>
#include <weapon.h>

inherit BLADE;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;31m红[1;37m月[1;32m季[2;37;0m", ({ "ydao" }));
	set_weight(15000);
	set("item_make", 1);
	set("unit", "把");
	set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一把刀。
[1;35m象征爱情和真挚纯洁的爱。人们多把它作为爱情的信物，是情人节首选花卉。
白月季寓意尊敬和崇高。[2;37;0m
");
	set("makeinfo", "[1;31m
花花太帅(huaz)[1;31m 出品
[2;37;0m");
	set("value", 4100000);
	set("point", 921);
	set("max_consistence", 100);
	set("material", "tian jing");
	set("material_file", "/clone/goods/tianjing");
	set("quality_level", 5);
	set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一把[1;36m$n[1;36m。[2;37;0m\n");
	set("unwield_msg", "$N随手一抹，收起了$n。\n");
	if( !check_clone() ) return;
	restore();
	init_blade(apply_damage());
	set("weapon_prop/magic_find", 3);
	set("weapon_prop/avoid_dodge", 1.500000);
	set("weapon_prop/add_freeze", 2.500000);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
