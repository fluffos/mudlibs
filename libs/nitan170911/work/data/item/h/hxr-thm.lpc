#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;35m桃花梦[2;37;0m", ({ "thm" }));
  set_weight(15000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一柄剑。
[1;35m自在飞花轻似梦，无边丝雨细如愁[2;37;0m
");
  set("makeinfo", "[1;31m
黄小蓉(hxr)[1;31m 出品
[2;37;0m");
  set("value", 35620000);
  set("point", 1776);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname2");
  set("quality_level", 4);
  set("wield_msg", "不知什么时候，$N手里已经多了一把[1;35m剑，但是，严格说这不是剑，是一阵温柔的春风，春风无从来，也就无可挡[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());
  set("weapon_prop/through_armor", 2.000000);
  set("weapon_prop/avoid_defense", 1.500000);

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
