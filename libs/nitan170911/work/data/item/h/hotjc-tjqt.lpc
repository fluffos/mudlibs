#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create()
{
	set_name("[5m[1;31m太极拳套[2;37;0m", ({ "tjqt" }));
	set_weight(4000);
	set("item_make", 1);
	set("unit", "双");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一双护手。
[1;33m这是寒月的神级拳套[2;37;0m
");
	set("makeinfo", "[1;31m
寒月(hotjc)[1;31m 出品
[2;37;0m");
	set("value", 28980000);
	set("point", 1444);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname2");
	set("wear_msg", "[1;36m神级拳套护体！[2;37;0m\n");
	set("remove_msg", "[1;36m神级拳套隐[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/unarmed_damage", apply_damage());
	set("armor_prop/armor", 10);
	set("armor_prop/cuff", 10);
	set("armor_prop/unarmed", 10);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
