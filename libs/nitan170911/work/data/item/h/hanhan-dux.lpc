#include <ansi.h>
#include <armor.h>

inherit BOOTS;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;34m赌侠战靴[2;37;0m", ({ "dux" }));
	set_weight(420);
	set("item_make", 1);
	set("unit", "双");
	set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一双靴子。
[1;36m赌侠小刀的靴子，因为一场麻将输给了小曼。[2;37;0m
");
	set("makeinfo", "[1;31m
小曼(hanhan)[1;31m 出品
[2;37;0m");
	set("value", 2100000);
	set("point", 87);
	set("max_consistence", 100);
	set("material", "silk");
	set("material_file", "/d/item/obj/tiancs");
	set("quality_level", 2);
	set("wear_msg", "[1;36m$N穿上[1;34m赌侠战靴[1;36m，用手轻轻拍了拍靴子。[2;37;0m\n");
	set("remove_msg", "[1;36m$N脱下[1;34m赌侠战靴[1;36m。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/armor", apply_armor());

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
