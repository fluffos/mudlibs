#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;33m抓奶龙爪手[2;37;0m", ({ "zhua" }));
	set_weight(1800);
	set("item_make", 1);
	set("unit", "双");
	set("long", "这是由[37m精铁[2;37;0m炼制而成的一双护手。
");
	set("makeinfo", "[1;31m
小曼(hanhan)[1;31m 出品
[2;37;0m");
	set("value", 700000);
	set("point", 30);
	set("max_consistence", 100);
	set("material", "iron");
	set("material_file", "/d/item/obj/jingtie");
	set("quality_level", 2);
	set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
	set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/unarmed_damage", apply_damage());
	set("armor_prop/armor", 10);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
