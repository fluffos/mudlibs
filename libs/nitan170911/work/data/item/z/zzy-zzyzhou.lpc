#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;36m[5m断魂[1;31m[5m赤血[2;37;0m", ({ "zzyzhou" }));
	set_weight(4500);
	set("item_make", 1);
	set("unit", "双");
	set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一双铁掌。
[1;35m昨夜星辰昨夜风，画楼西畔桂堂东[2;37;0m
");
	set("makeinfo", "[1;31m
残天(zzy)[1;31m 出品
[2;37;0m");
	set("value", 4100000);
	set("point", 825);
	set("max_consistence", 100);
	set("material", "tian jing");
	set("material_file", "/clone/goods/tianjing");
	set("quality_level", 2);
	set("wear_msg", "[1;37m运起淡淡白气，大喝一声“[1;31m[5m嗜血归魂”[2;37;0m\n");
	set("remove_msg", "[1;34m甩了甩铁掌上的[1;31m鲜血[1;36m气压丹田，将铁掌收入怀中[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/unarmed_damage", apply_damage());
	set("armor_prop/armor", 10);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
