#include <ansi.h>
#include <armor.h>

inherit ARMOR;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;36m悲鸣甲[2;37;0m", ({ "bmj" }));
  set_weight(15000);
  set("item_make", 1);
  set("unit", "张");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一张护甲。
");
  set("makeinfo", "[1;31m
了尽(zxahh)[1;31m 出品
[2;37;0m");
  set("value", 35220000);
  set("point", 1404);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname2");
  set("quality_level", 6);
  set("wear_msg", "[1;36m悲鸣缠身[2;37;0m\n");
  set("remove_msg", "[1;36m悲鸣透体[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/counter_damage", 2.500000);
  set("armor_prop/research_effect", 9);

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
