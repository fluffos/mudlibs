#include <ansi.h>
#include <armor.h>

inherit FINGER;
inherit F_ITEMMAKE;

void create()
{
	set_name("[2;37;0m[37m套套[2;37;0m", ({ "sleepbag" }));
	set_weight(3500);
	set("item_make", 1);
	set("unit", "套");
	set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一套指套。
一枚第七感套套[2;37;0m
");
	set("makeinfo", "[1;31m
葬心(zang)[1;31m 出品
[2;37;0m");
	set("value", 4100000);
	set("point", 1000);
	set("max_consistence", 100);
	set("material", "tian jing");
	set("material_file", "/clone/goods/tianjing");
	set("quality_level", 5);
	set("wear_msg", "急不可耐的把套套戴上。[2;37;0m\n");
	set("remove_msg", "长舒了一口气，把套套取下来，往地上一甩。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/unarmed_damage", apply_damage());
	set("armor_prop/armor", 10);
	set("armor_prop/research_effect", 6);
	set("armor_prop/attack", 30);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
