#include <ansi.h>
#include <armor.h>

inherit WRISTS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;33m[41;1m诸神之黄昏护腕[2;37;0m", ({ "doomf" }));
  set_weight(5000);
  set("item_make", 1);
  set("unit", "对");
  set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一对护腕。
");
  set("makeinfo", "[1;31m
叶绿风(zues)[1;31m 出品
[2;37;0m");
  set("value", 4100000);
  set("point", 250);
  set("max_consistence", 100);
  set("material", "tian jing");
  set("material_file", "/clone/goods/tianjing");
  set("quality_level", 6);
  set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/dp_power", 3.000000);
  set("armor_prop/reduce_poison", 1.500000);
  set("armor_prop/practice_effect", 3);
  set("armor_prop/avoid_weak", 2.500000);

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
