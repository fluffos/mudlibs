#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[45m幸运女神铁掌[2;37;0m", ({ "mfz" }));
  set_weight(450);
  set("item_make", 1);
  set("unit", "双");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一双铁掌。
");
  set("makeinfo", "[1;31m
叶绿风(zues)[1;31m 出品
[2;37;0m");
  set("value", 6100000);
  set("point", 1500);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname");
  set("quality_level", 5);
  set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/unarmed_damage", apply_damage());
  set("armor_prop/armor", 10);
  set("armor_prop/magic_find", 3);
  set("armor_prop/practice_effect", 3);
  set("armor_prop/study_effect", 3);

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
