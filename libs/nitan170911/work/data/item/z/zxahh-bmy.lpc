#include <ansi.h>
#include <armor.h>

inherit WAIST;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;36m悲鸣腰带[2;37;0m", ({ "bmy" }));
	set_weight(8000);
	set("item_make", 1);
	set("unit", "条");
	set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一条腰带。
腰间鸣响[2;37;0m
");
	set("makeinfo", "[1;31m
了尽(zxahh)[1;31m 出品
[2;37;0m");
	set("value", 4100000);
	set("point", 400);
	set("max_consistence", 100);
	set("material", "tian jing");
	set("material_file", "/clone/goods/tianjing");
	set("quality_level", 6);
	set("wear_msg", "腰间悲鸣[2;37;0m\n");
	set("remove_msg", "悲鸣渐消[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/armor", apply_armor());
	set("armor_prop/dp_power", 1.500000);
	set("armor_prop/reduce_poison", 1.500000);
	set("armor_prop/research_effect", 9);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
