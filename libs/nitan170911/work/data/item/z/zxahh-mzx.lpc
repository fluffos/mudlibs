#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("墨竹[2;37;0m", ({ "mzx" }));
  set_weight(15000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一柄剑。
由墨竹成萧[2;37;0m
");
  set("makeinfo", "[1;31m
了尽(zxahh)[1;31m 出品
[2;37;0m");
  set("value", 4100000);
  set("point", 802);
  set("max_consistence", 100);
  set("material", "tian jing");
  set("material_file", "/clone/goods/tianjing");
  set("quality_level", 6);
  set("wield_msg", "一段墨竹穿土而出[2;37;0m\n");
  set("unwield_msg", "一段墨竹消散不见[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());
  set("weapon_prop/add_forget", 2.500000);
  set("weapon_prop/add_blind", 2.000000);
  set("weapon_prop/add_poison", 3);
  set("weapon_prop/research_effect", 6);

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
