#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create()
{
	set_name("[5m[1;33m佛刑[1;37m禅那[2;37;0m", ({ "fushen" }));
	set_weight(4500);
	set("item_make", 1);
	set("unit", "双");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一双铁掌。
[5m[1;33m佛刑[1;37m禅那[2;37;0m[1;36m为云鼓雷峰之首帝如来所拥有，具有清净无边的佛气缠绕。[2;37;0m
");
	set("makeinfo", "[1;31m
帝如来(parry)[1;31m 出品
[2;37;0m");
	set("value", 34760000);
	set("point", 1733);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname2");
	set("quality_level", 2);
	set("wear_msg", "[5m[1;33m佛刑[1;37m禅那[2;37;0m[1;36m渐渐凝形在$N的手上，四周随之散发出无边的佛气。[2;37;0m\n");
	set("remove_msg", "[1;36m随著佛气渐渐的消逝，[5m[1;33m佛刑[1;37m禅那[2;37;0m[1;36m也渐渐的回复平静状态。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/unarmed_damage", apply_damage());
	set("armor_prop/armor", 10);

	setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
