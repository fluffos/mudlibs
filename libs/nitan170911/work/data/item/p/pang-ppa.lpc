#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create()
{
	set_name("[5m[1;35m湛[1;32m泸[2;37;0m", ({ "ppa" }));
	set_weight(15000);
	set("item_make", 1);
	set("unit", "柄");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一柄剑。
[1;32m这便是传说中，战国时期的神兵利器[5m[1;35m湛[1;32m泸[2;37;0m[2;37;0m
");
	set("makeinfo", "[1;31m
庞青云(pang)[1;31m 出品
[2;37;0m");
	set("value", 34200000);
	set("point", 1705);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname2");
	set("quality_level", 6);
	set("wield_msg", "[1;32m$N从背后缓缓抽出一柄古剑$n，\n[1;32m弹剑歌曰：我本楚狂人，狂歌笑孔丘。[2;37;0m\n");
	set("unwield_msg", "[1;32m$N一声低吟，将手中$n[1;32m插回背后剑鞘。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	init_sword(apply_damage());
	set("weapon_prop/ap_power", 6.000000);
	set("weapon_prop/research_effect", 3);

	setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
