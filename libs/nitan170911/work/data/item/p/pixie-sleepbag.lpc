#include <ansi.h>
#include <weapon.h>

inherit THROWING;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;33m神品睡袋[2;37;0m", ({ "sleepbag" }));
	set_weight(1800);
	set("item_make", 1);
	set("unit", "把");
	set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一把暗器。
一个睡袋，江湖人士用来在野外睡觉用的。[2;37;0m
");
	set("makeinfo", "[1;31m
辟邪(pixie)[1;31m 出品
[2;37;0m");
	set("value", 2100000);
	set("base_weight", 18);
	set("base_unit", "枚");
	set("base_value", 1);
	set("point", 100);
	set("max_consistence", 100);
	set("material", "magic stone");
	set("material_file", "/d/item/obj/butian");
	set("quality_level", 2);
	set("hand_msg", "[1;37m一个避孕套飞过来套住了$N的龟头。\n[1;36m看起来你的心中有点异样。[2;37;0m\n");
	set("unhand_msg", "[1;37m一个避孕套飞过来套住了你的龟头。\n[1;36m看起来你的心中有点异样。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set_amount(100);
	init_throwing(apply_damage());

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
