#include <ansi.h>
#include <weapon.h>

inherit THROWING;
inherit F_ITEMMAKE;

void create() {
  set_name("[41;1m[1;33m女娲石[2;37;0m", ({ "guj" }));
  set_weight(3000);
  set("item_make", 1);
  set("unit", "把");
  set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一把暗器。
[1;33m相传女娲曾经为了救自己病故的爱女，将自己万年修为贯注于一颗当年补天所剩的五彩玉石上，自此该灵石就具有特别之力。[2;37;0m
");
  set("makeinfo", "[1;31m
天蝎(penny)[1;31m 出品
[2;37;0m");
  set("value", 4100000);
  set("base_weight", 30);
  set("base_unit", "枚");
  set("base_value", 1);
  set("point", 1000);
  set("max_consistence", 100);
  set("material", "tian jing");
  set("material_file", "/clone/goods/tianjing");
  set("quality_level", 6);
  set("hand_msg", "[1;36m$N[1;36m一声清啸，握着一把[1;36m$n[1;36m。[2;37;0m\n");
  set("unhand_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  set_amount(100);
  init_throwing(apply_damage());
  set("weapon_prop/da_power", 2.000000);
  set("weapon_prop/add_blind", 2.000000);
  set("weapon_prop/practice_effect", 3);
  set("weapon_prop/add_busy", 2.500000);

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
