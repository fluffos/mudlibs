#include <ansi.h>
#include <armor.h>

inherit WAIST;
inherit F_ITEMMAKE;

void create() {
  set_name("[41;1m[1;33m昊天塔[2;37;0m", ({ "aae" }));
  set_weight(800);
  set("item_make", 1);
  set("unit", "条");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一条腰带。
[1;33m传说昊天塔中蕴含“混沌之力”，凡炼化者，可以成为混沌之主。[2;37;0m
");
  set("makeinfo", "[1;31m
天蝎(penny)[1;31m 出品
[2;37;0m");
  set("value", 6100000);
  set("point", 600);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname");
  set("quality_level", 6);
  set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/full_self", 5.000000);
  set("armor_prop/avoid_die", 5.000000);

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
