#include <ansi.h>
#include <armor.h>

inherit HEAD;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;33m明月[1;37m金刚目[2;37;0m[2;37;0m", ({ "dbaod" }));
	set_weight(7500);
	set("item_make", 1);
	set("unit", "顶");
	set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一顶头盔。
[33m大藏禅师门下有一金刚弟子，额有三目，虎背熊腰，容貌极威武。其额间第三目，更是能聚星月之灵气。
后大藏禅师把朱雀石，加以九阳真火，炼化成法宝明月金刚目，交予三目金刚弟子使用，此法宝发黄绿
光芒。[2;37;0m
");
	set("makeinfo", "[1;31m
唐三藏(tangsz)[1;31m 出品
[2;37;0m");
	set("value", 4100000);
	set("point", 416);
	set("max_consistence", 100);
	set("material", "tian jing");
	set("material_file", "/clone/goods/tianjing");
	set("quality_level", 6);
	set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
	set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/armor", apply_armor());
	set("armor_prop/avoid_freeze", 0);
	set("armor_prop/research_effect", 6);
	set("armor_prop/avoid_die", 2.500000);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
