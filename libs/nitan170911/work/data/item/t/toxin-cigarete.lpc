#include <ansi.h>
#include <weapon.h>

inherit BLADE;
inherit F_ITEMMAKE;

void create() {
  set_name("利群[2;37;0m", ({ "cigarete" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "把");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一把刀。
");
  set("makeinfo", "[1;31m
胡子长(toxin)[1;31m 出品
[2;37;0m");
  set("value", 2100000);
  set("point", 100);
  set("max_consistence", 100);
  set("material", "magic stone");
  set("material_file", "/d/item/obj/butian");
  set("quality_level", 5);
  set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一把[1;36m$n[1;36m。[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_blade(apply_damage());
  set("weapon_prop/avoid_dodge", 1.500000);
  set("weapon_prop/kar", 3);
  set("weapon_prop/leech_neili", 2.000000);

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
