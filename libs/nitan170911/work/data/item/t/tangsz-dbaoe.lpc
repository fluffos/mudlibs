#include <ansi.h>
#include <armor.h>

inherit WRISTS;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;36m五云[1;33m锁仙绫[2;37;0m[2;37;0m", ({ "dbaoe" }));
	set_weight(5000);
	set("item_make", 1);
	set("unit", "对");
	set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一对护腕。
[33m天瑶湖畔，仙堡圣姑于梦中受仙人指点，知此湖底蕴五色寒玉之气，遂用法囊将五色云气收起，
云气便一一化成玉形。后圣姑将此五色玉按五行相生相克之法，炼化出法宝五云锁仙绫。[2;37;0m
");
	set("makeinfo", "[1;31m
唐三藏(tangsz)[1;31m 出品
[2;37;0m");
	set("value", 4100000);
	set("point", 208);
	set("max_consistence", 100);
	set("material", "tian jing");
	set("material_file", "/clone/goods/tianjing");
	set("quality_level", 6);
	set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
	set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/armor", apply_armor());
	set("armor_prop/reduce_busy", 2.500000);
	set("armor_prop/avoid_poison", 1.500000);
	set("armor_prop/research_effect", 6);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
