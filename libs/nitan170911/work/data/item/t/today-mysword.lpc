#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[33m青铜剑[2;37;0m", ({ "mysword" }));
  set_weight(15000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一柄剑。
[5m合体吧，妹子[2;37;0m
");
  set("makeinfo", "[1;31m
今天(today)[1;31m 出品
[2;37;0m");
  set("value", 4100000);
  set("point", 1000);
  set("max_consistence", 100);
  set("material", "tian jing");
  set("material_file", "/clone/goods/tianjing");
  set("quality_level", 5);
  set("wield_msg", "[5m[35m合体吧，妹子[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());
  set("weapon_prop/da_power", 2.000000);
  set("weapon_prop/practice_effect", 3);
  set("weapon_prop/kar", 3);

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
