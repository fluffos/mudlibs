#include <ansi.h>
#include <armor.h>

inherit ARMOR;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;32m八面[1;36m驭风屏[2;37;0m[2;37;0m", ({ "dbaof" }));
	set_weight(15000);
	set("item_make", 1);
	set("unit", "张");
	set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一张护甲。
[33m北冥山一带，修真生灵常被一股妖风残害。太乙真君得悉此妖风乃当年杀死的那条巨蟒蛇妖聚
怨气化成妖风残杀生灵。太乙真君遂集齐四方灵石，炼化八面驭风屏，以镇此妖。此法宝可化
为屏风状，发紫蓝光，威力颇大。[2;37;0m
");
	set("makeinfo", "[1;31m
唐三藏(tangsz)[1;31m 出品
[2;37;0m");
	set("value", 4100000);
	set("point", 666);
	set("max_consistence", 100);
	set("material", "tian jing");
	set("material_file", "/clone/goods/tianjing");
	set("quality_level", 6);
	set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
	set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/armor", apply_armor());
	set("armor_prop/full_self", 2.500000);
	set("armor_prop/avoid_poison", 1.500000);
	set("armor_prop/research_effect", 6);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
