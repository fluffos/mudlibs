#include <ansi.h>
#include <weapon.h>

inherit STAFF;
inherit F_ITEMMAKE;

void create() {
  set_name("屠[1;33m狗[1;36m[2;37;0m", ({ "sha" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "根");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一根杖。
");
  set("makeinfo", "[1;31m
独孤问剑(todo)[1;31m 出品
[2;37;0m");
  set("value", 2100000);
  set("point", 500);
  set("max_consistence", 100);
  set("material", "magic stone");
  set("material_file", "/d/item/obj/butian");
  set("quality_level", 2);
  set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一根[1;36m$n[1;36m。[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_staff(apply_damage());

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
