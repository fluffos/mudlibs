#include <ansi.h>
#include <armor.h>

inherit FINGER;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;37m玄元[1;31m离火鼎[2;37;0m[2;37;0m", ({ "dbaob" }));
	set_weight(3500);
	set("item_make", 1);
	set("unit", "套");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一套指套。
[33m玄冥冰原北山顶，曾有一仙人，常采玄冰灵气和各地奇宝炼制仙丹，后仙人返天庭时，把其炼丹之炉，
遗留在冰原山顶上。此炉因日久炼制丹药，且常吸奇宝灵气，以非凡品。[2;37;0m
");
	set("makeinfo", "[1;31m
唐三藏(tangsz)[1;31m 出品
[2;37;0m");
	set("value", 35680000);
	set("point", 1779);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname2");
	set("quality_level", 6);
	set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
	set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/unarmed_damage", apply_damage());
	set("armor_prop/armor", 10);
	set("armor_prop/add_weak", 2.500000);
	set("armor_prop/research_effect", 6);
	set("armor_prop/double_damage", 2.000000);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
