#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m最贱[2;37;0m", ({ "wyz" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
[5m[1;37m唰的一下我脱掉了全身的衣服[2;37;0m
");
  set("makeinfo", "[1;31m
伊卡璐(wyzly)[1;31m 出品
[2;37;0m");
  set("value", 2100000);
  set("point", 100);
  set("max_consistence", 100);
  set("material", "magic stone");
  set("material_file", "/d/item/obj/butian");
  set("quality_level", 2);
  set(
    "wield_msg",
    "[5m[1;31m一[1;32m不[1;33m小[1;34m心[1;35m我[1;36m脱[1;37m掉[35m了[34m内[1;35m裤[2;37;0m\n"
  );
  set(
    "unwield_msg",
    "[5m[1;31m一[1;32m不[1;33m小[1;34m心[1;35m我[1;36m穿[1;37m上[35m了[34m内[1;35m裤[2;37;0m\n"
  );
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
