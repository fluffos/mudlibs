#include <ansi.h>
#include <armor.h>

inherit FINGER;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;32m睡袋[2;37;0m", ({ "sleepbag" }));
	set_weight(10500);
	set("item_make", 1);
	set("unit", "套");
	set("long", "这是由[36m玄铁[2;37;0m炼制而成的一套指套。
");
	set("makeinfo", "[1;31m
武当(wudang)[1;31m 出品
[2;37;0m");
	set("value", 1500000);
	set("point", 70);
	set("max_consistence", 100);
	set("material", "steel");
	set("material_file", "/d/item/obj/xuantie");
	set("quality_level", 2);
	set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
	set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/unarmed_damage", apply_damage());
	set("armor_prop/armor", 10);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
