#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m天[1;33m残[1;31m剑[2;37;0m", ({ "tcj" }));
  set_weight(1500);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一柄剑。
[1;31m一剑[1;33m更比[1;36m一剑[1;31m狠[2;37;0m
");
  set("makeinfo", "[1;31m
王文(wangwen)[1;31m 出品
[2;37;0m");
  set("value", 6100000);
  set("point", 1216);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname");
  set("quality_level", 2);
  set("wield_msg", "[1;37m我[1;36m要[1;31m杀[1;35m你[1;33m拉[2;37;0m\n");
  set("unwield_msg", "[1;31m杀完[1;32m回家[1;37m吃饭[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
