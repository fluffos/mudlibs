#include <ansi.h>
#include <armor.h>

inherit FINGER;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[31m惊神指[2;37;0m", ({ "jsz" }));
  set_weight(3500);
  set("item_make", 1);
  set("unit", "套");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一套指套。
[1;33m这是梦中才会出现的神奇武器，上刻「[1;35m惊神一出，天下皆惊[1;33m」的诗句。[2;37;0m
");
  set("makeinfo", "[1;31m
段小虚(wuxu)[1;31m 出品
[2;37;0m");
  set("value", 34900000);
  set("point", 1740);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname2");
  set("quality_level", 6);
  set(
    "wear_msg",
    "[1;35m$N[1;32m[1;33m右手指天，突然$n[1;33m出现，佛光普照，鲜花漫天，又见梵音细细吟唱：「[1;35m惊神一出，天下皆惊！[1;33m」[2;37;0m\n"
  );
  set("remove_msg", "[1;35m$N[1;33m随手一挥，$n[1;33m已不见踪影，整个世界安静了下来。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/unarmed_damage", apply_damage());
  set("armor_prop/armor", 10);
  set("armor_prop/add_damage", 5.000000);
  set("armor_prop/practice_effect", 3);
  set("armor_prop/research_effect", 3);

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
