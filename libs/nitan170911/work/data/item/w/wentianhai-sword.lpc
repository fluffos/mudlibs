#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;31m诛仙[2;37;0m", ({ "sword" }));
	set_weight(15000);
	set("item_make", 1);
	set("unit", "柄");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一柄剑。
[1;32m这是一柄传说可以[1;33m诛仙[1;32m的神剑，刀上刻着[1;33m「[1;35m小楼一夜听[1;36m春雨[1;33m」[1;32m的诗句。[2;37;0m
");
	set("makeinfo", "[1;31m
文天海(wentianhai)[1;31m 出品
[2;37;0m");
	set("value", 28900000);
	set("point", 1440);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname2");
	set("quality_level", 4);
	set("wield_msg", "[1;35m$N[1;32m缓缓抽出一柄$n[1;32m，低声轻吟：「[1;36m小楼一夜听[1;32m春雨[1;36m，[1;35m深巷明朝卖[1;36m杏花[1;32m」[2;37;0m\n");
	set("unwield_msg", "[1;35m$N[1;32m随手一挥，$n[1;32m已入鞘内。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	init_sword(apply_damage());
	set("weapon_prop/derive_effect", 1);
	set("weapon_prop/max_jingli", 2500);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
