#include <ansi.h>
#include <weapon.h>

inherit THROWING;
inherit F_ITEMMAKE;

void create()
{
	set_name("睡袋[2;37;0m", ({ "sleepbag" }));
	set_weight(1800);
	set("item_make", 1);
	set("unit", "把");
	set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一把暗器。
一个睡袋，江湖人士用来在野外睡觉用的。[2;37;0m
");
	set("makeinfo", "[1;31m
欧阳奇(www)[1;31m 出品
[2;37;0m");
	set("value", 2100000);
	set("base_weight", 18);
	set("base_unit", "枚");
	set("base_value", 1);
	set("point", 100);
	set("max_consistence", 100);
	set("material", "magic stone");
	set("material_file", "/d/item/obj/butian");
	set("quality_level", 2);
	set("hand_msg", "[30m一个睡袋套了过来。[2;37;0m\n");
	set("unhand_msg", "[30m一个睡袋不见了。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set_amount(100);
	init_throwing(apply_damage());

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
