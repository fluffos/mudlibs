#include <ansi.h>
#include <weapon.h>

inherit BLADE;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;37m圆[1;33m月[1;31m弯刀[2;37;0m", ({ "yywd" }));
	set_weight(15000);
	set("item_make", 1);
	set("unit", "把");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一把刀。
[1;34m月圆雾浓，月色凄凉朦胧令人的心都碎了，淡淡的渗出凄惨的月光刀色[2;37;0m
");
	set("makeinfo", "[1;31m
喂小饱(wxb)[1;31m 出品
[2;37;0m");
	set("value", 29600000);
	set("point", 1475);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname2");
	set("quality_level", 2);
	set("wield_msg", "[1;34m淡淡的从乌云中渗出了月色，凄凉！[2;37;0m\n");
	set("unwield_msg", "[1;34m瞬间一切又恢复了平静，冷漠！[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	init_blade(apply_damage());

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
