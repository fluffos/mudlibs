[5m[1;33m贱[1;36m相[2;37;0m
");
  set("makeinfo", "[1;31m
伊卡璐(wyzly)[1;31m 出品
[2;37;0m");
  set("value", 2100000);
  set("point", 100);
  set("max_consistence", 100);
  set("material", "magic stone");
  set("material_file", "/d/item/obj/butian");
