#include <ansi.h>
#include <armor.h>

inherit HEAD;
inherit F_ITEMMAKE;

void create() {
  set_name("睡袋[2;37;0m", ({ "sleepbag" }));
  set_weight(750);
  set("item_make", 1);
  set("unit", "顶");
  set("long", "这是由[1;35m寒星陨铁[2;37;0m炼制而成的一顶头盔。
一个睡袋，江湖人士用来在野外睡觉用的。[2;37;0m
");
  set("makeinfo", "[1;31m
段玉(warrierh)[1;31m 出品
[2;37;0m");
  set("value", 4100000);
  set("point", 500);
  set("max_consistence", 100);
  set("material", "hanxing yuntie");
  set("material_file", "/clone/goods/hanxing-yuntie");
  set("quality_level", 5);
  set("wear_msg", "展开一个睡袋，钻了进去，开始睡。[2;37;0m\n");
  set("remove_msg", "一觉醒来，只觉精力充沛。该活动一下了。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/defense", 30);
  set("armor_prop/dp_power", 1.500000);
  set("armor_prop/research_effect", 3);

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
