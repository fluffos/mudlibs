#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create()
{
	set_name("[5m[1;37m贱[1;31m相[2;37;0m", ({ "jsword", "jsword" }));
	set_weight(15000);
	set("item_make", 1);
	set("unit", "柄");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一柄剑。
[1;32m传说离恨天之外高处不胜寒之星辰坠落在兜率宫内，
老君收集七七四十九片在八卦炉内炼化为神兵一柄。[2;37;0m
");
	set("makeinfo", "[1;31m
伊卡璐(wyzly)[1;31m 出品
[2;37;0m");
	set("value", 34400000);
	set("point", 1715);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname2");
	set("quality_level", 6);
	set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一柄[1;36m$n[1;36m。[2;37;0m\n");
	set("unwield_msg", "$N随手一抹，收起了$n。\n");
	if( !check_clone() ) return;
	restore();
	init_sword(apply_damage());
	set("weapon_prop/fatal_blow", 4.000000);
	set("weapon_prop/add_blind", 4.000000);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
