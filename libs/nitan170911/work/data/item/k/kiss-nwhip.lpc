#include <ansi.h>
#include <weapon.h>

inherit WHIP;
inherit F_ITEMMAKE;

void create()
{
	set_name("垂涎三尺[2;37;0m", ({ "nwhip" }));
	set_weight(15000);
	set("item_make", 1);
	set("unit", "根");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一根鞭。
");
	set("makeinfo", "[1;31m
小嘴冰凉(kiss)[1;31m 出品
[2;37;0m");
	set("value", 35080000);
	set("point", 1749);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname2");
	set("quality_level", 6);
	set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一根[1;36m$n[1;36m。[2;37;0m\n");
	set("unwield_msg", "$N随手一抹，收起了$n。\n");
	if( !check_clone() ) return;
	restore();
	init_whip(apply_damage());
	set("weapon_prop/ap_power", 6.000000);
	set("weapon_prop/add_poison", 3);
	set("weapon_prop/add_damage", 2.500000);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
