#include <ansi.h>
#include <armor.h>

inherit ARMOR;
inherit F_ITEMMAKE;

void create() {
  set_name("[41;1m[1;33m福缘内力套装[2;37;0m", ({ "fyd" }));
  set_weight(15000);
  set("item_make", 1);
  set("unit", "张");
  set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一张护甲。
");
  set("makeinfo", "[1;31m
啦呱(kos)[1;31m 出品
[2;37;0m");
  set("value", 4100000);
  set("point", 361);
  set("max_consistence", 100);
  set("material", "tian jing");
  set("material_file", "/clone/goods/tianjing");
  set("quality_level", 5);
  set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/kar", 3);
  set("armor_prop/parry", 30);
  set("armor_prop/reduce_busy", 2.500000);

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
