#include <ansi.h>
#include <weapon.h>

inherit BLADE;
inherit F_ITEMMAKE;

void create()
{
	set_name("幽灵狂刀[2;37;0m", ({ "ylkd" }));
	set_weight(15000);
	set("item_make", 1);
	set("unit", "把");
	set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一把刀。
这是一把汇集无数幽灵铸成的狂刀，刀在风中颤抖的声音犹如无数幽魂在哭泣。所劈之处，天地为之震撼！[2;37;0m
");
	set("makeinfo", "[1;31m
金虎(kingh)[1;31m 出品
[2;37;0m");
	set("value", 4100000);
	set("point", 585);
	set("max_consistence", 100);
	set("material", "tian jing");
	set("material_file", "/clone/goods/tianjing");
	set("quality_level", 2);
	set("wield_msg", "大喊一声“幽魂聚刀”，只见空中飘荡的幽魂迅速凝结在一起，形成一把黑色的狂刀。你一把将刀攥在手中。[2;37;0m\n");
	set("unwield_msg", "轻轻低吟“幽魂散”，只见手中黑色的狂刀迅速化为无数的幽魂，随风散去！[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	init_blade(apply_damage());

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
