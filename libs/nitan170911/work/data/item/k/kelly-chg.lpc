#include <ansi.h>
#include <armor.h>

inherit HEAD;
inherit F_ITEMMAKE;

void create()
{
	set_name("[41;1m[1;37m井中月[1;33m头盔[2;37;0m", ({ "chg" }));
	set_weight(7500);
	set("item_make", 1);
	set("unit", "顶");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一顶头盔。
");
	set("makeinfo", "[1;31m
杜铭萱(kelly)[1;31m 出品
[2;37;0m");
	set("value", 35280000);
	set("point", 879);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname2");
	set("quality_level", 5);
	set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
	set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/armor", apply_armor());
	set("armor_prop/derive_effect", 2);
	set("armor_prop/jing_recover", 30);
	set("armor_prop/research_effect", 2);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
