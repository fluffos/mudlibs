#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create()
{
	set_name("[5m[1;36m麒[5m[1;31m柒[2;37;0m", ({ "qiqi" }));
	set_weight(15000);
	set("item_make", 1);
	set("unit", "柄");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一柄剑。
[1;37m从此无心爱良夜，任他明月下西楼[2;37;0m
");
	set("makeinfo", "[1;31m
枯枝(kuzhi)[1;31m 出品
[2;37;0m");
	set("value", 34180000);
	set("point", 1704);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname2");
	set("quality_level", 6);
	set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一柄[1;36m$n[1;36m。[2;37;0m\n");
	set("unwield_msg", "$N随手一抹，收起了$n。\n");
	if( !check_clone() ) return;
	restore();
	init_sword(apply_damage());
	set("weapon_prop/da_power", 2.000000);
	set("weapon_prop/ap_power", 4.000000);
	set("weapon_prop/double_damage", 2.000000);

	setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
