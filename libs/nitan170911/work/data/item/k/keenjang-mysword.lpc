#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;37m回响竖琴[2;37;0m", ({ "mysword" }));
	set_weight(15000);
	set("item_make", 1);
	set("unit", "柄");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一柄剑。
[1;37m这把纯银手工打造的竖琴是如此的特别，虽然只有六根弦却能奏出象征六道轮回的天籁。[2;37;0m
");
	set("makeinfo", "[1;31m
风清扬(keenjang)[1;31m 出品
[2;37;0m");
	set("value", 30040000);
	set("point", 1497);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname2");
	set("wield_msg", "[1;31m天道、人间道、修罗道、畜生道、饿鬼道、地狱道，六道万象在你脑海浮现，夺走了你的五感！[2;37;0m\n");
	set("unwield_msg", "[1;36m视觉、听觉、嗅觉、味觉、触觉，你的五感恢复了正常。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	init_sword(apply_damage());

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
