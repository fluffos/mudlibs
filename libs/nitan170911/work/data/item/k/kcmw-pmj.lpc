#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m五韵七弦[1;32m无形剑[2;37;0m", ({ "pmj" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
[1;37m五韵七弦[1;32m无形剑[1;36m是把奇特的剑器，它无影无形，让人防不胜防。[2;37;0m
");
  set("makeinfo", "[1;31m
灭梓(kcmw)[1;31m 出品
[2;37;0m");
  set("value", 2100000);
  set("point", 203);
  set("max_consistence", 100);
  set("material", "magic stone");
  set("material_file", "/d/item/obj/butian");
  set("quality_level", 2);
  set("wield_msg", "[1;37m缓缓地多背后抽出了一把剑，而你根本无法发现他是从哪里拿出来的。[2;37;0m\n");
  set("unwield_msg", "[1;33m伸手一抛，手中的宝剑顿时无影无踪。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
