#include <ansi.h>
#include <weapon.h>

inherit STAFF;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;37m苍天之杖[2;37;0m", ({ "staff" }));
	set_weight(9000);
	set("item_make", 1);
	set("unit", "根");
	set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一根杖。
[1;37m持此杖者为天空之主。[2;37;0m
");
	set("makeinfo", "[1;31m
空虚公子(kid)[1;31m 出品
[2;37;0m");
	set("value", 2100000);
	set("point", 408);
	set("max_consistence", 100);
	set("material", "magic stone");
	set("material_file", "/d/item/obj/butian");
	set("quality_level", 2);
	set("wield_msg", "[1;37m$N伸手一抖，手中突然出现一把$n。[2;37;0m\n");
	set("unwield_msg", "[1;37m$N随手一挥，$n[1;37m消失得无影无踪。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	init_staff(apply_damage());

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
