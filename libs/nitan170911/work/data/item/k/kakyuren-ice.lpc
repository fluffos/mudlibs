#include <ansi.h>
#include <armor.h>

inherit FINGER;
inherit F_ITEMMAKE;

void create() {
  set_name("冰息指手[2;37;0m", ({ "ice" }));
  set_weight(3500);
  set("item_make", 1);
  set("unit", "套");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一套指套。
这是可敬的赤色要塞阁下的专用武器，一般贱民别想妄图染指它！[2;37;0m
");
  set("makeinfo", "[1;31m
赤色要塞(kakyuren)[1;31m 出品
[2;37;0m");
  set("value", 34180000);
  set("point", 1704);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname2");
  set("quality_level", 4);
  set("wear_msg", "[37m一层寒霜笼罩在双手，待雾气褪去，五指上已然形成了一副冰做的指套。[2;37;0m\n");
  set("remove_msg", "[31m一名娇滴滴的绝色美人走上前来，虔诚地褪去$N手上的指套，并塞入她高耸的胸部。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/unarmed_damage", apply_damage());
  set("armor_prop/armor", 10);
  set("armor_prop/max_experience", 50000);
  set("armor_prop/practice_effect", 3);

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
