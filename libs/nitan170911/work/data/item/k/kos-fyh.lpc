#include <ansi.h>
#include <armor.h>

inherit WAIST;
inherit F_ITEMMAKE;

void create()
{
	set_name("[41;1m[1;33m福缘内力套装[2;37;0m", ({ "fyh" }));
	set_weight(8000);
	set("item_make", 1);
	set("unit", "条");
	set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一条腰带。
");
	set("makeinfo", "[1;31m
啦呱(kos)[1;31m 出品
[2;37;0m");
	set("value", 4100000);
	set("point", 180);
	set("max_consistence", 100);
	set("material", "tian jing");
	set("material_file", "/clone/goods/tianjing");
	set("quality_level", 5);
	set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
	set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/armor", apply_armor());
	set("armor_prop/defense", 30);
	set("armor_prop/kar", 3);
	set("armor_prop/avoid_attack", 1.500000);

	setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
