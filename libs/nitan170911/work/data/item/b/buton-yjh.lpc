#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create()
{
	set_name("[2;37;0m[33m老子[2;37;0m", ({ "yjh" }));
	set_weight(4500);
	set("item_make", 1);
	set("unit", "双");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一双铁掌。
[33m一本泛黄的旧书封面上写着《老子》。[2;37;0m
");
	set("makeinfo", "[1;31m
周不痛(buton)[1;31m 出品
[2;37;0m");
	set("value", 34240000);
	set("point", 1707);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname2");
	set("quality_level", 6);
	set("wear_msg", "$N从随身包裹掏出一本封面已经泛黄的《老子》，\n长叹一声：自古以来成功之道都离不开“老庄孙子”。[2;37;0m\n");
	set("remove_msg", "$N将手里的《老子》小心翼翼的收好，放入随身书包里。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/unarmed_damage", apply_damage());
	set("armor_prop/armor", 10);
	set("armor_prop/research_effect", 12);

	setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
