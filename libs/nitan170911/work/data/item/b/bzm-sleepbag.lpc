#include <ansi.h>
#include <armor.h>

inherit SURCOAT;
inherit F_ITEMMAKE;

void create()
{
	set_name("睡袋[2;37;0m", ({ "sleepbag" }));
	set_weight(6000);
	set("item_make", 1);
	set("unit", "件");
	set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一件披风。
");
	set("makeinfo", "[1;31m
小白(bzm)[1;31m 出品
[2;37;0m");
	set("value", 2100000);
	set("point", 250);
	set("max_consistence", 100);
	set("material", "magic stone");
	set("material_file", "/d/item/obj/butian");
	set("quality_level", 5);
	set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
	set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/armor", apply_armor());
	set("armor_prop/study_times", 15);
	set("armor_prop/neili_recover", 80);
	set("armor_prop/parry", 30);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
