#include <ansi.h>
#include <armor.h>

inherit HEAD;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;31m学霸之红领巾[2;37;0m", ({ "xbc" }));
	set_weight(7500);
	set("item_make", 1);
	set("unit", "顶");
	set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一顶头盔。
[1;31m学霸的红领巾[2;37;0m
");
	set("makeinfo", "[1;31m
周不嗵(buto)[1;31m 出品
[2;37;0m");
	set("value", 4100000);
	set("point", 100);
	set("max_consistence", 100);
	set("material", "tian jing");
	set("material_file", "/clone/goods/tianjing");
	set("quality_level", 5);
	set("wear_msg", "[1;31m$N振臂高呼：好好学习，天天向上。[2;37;0m\n");
	set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/armor", apply_armor());
	set("armor_prop/practice_effect", 3);
	set("armor_prop/learn_effect", 6);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
