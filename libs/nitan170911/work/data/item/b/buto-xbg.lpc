#include <ansi.h>
#include <armor.h>

inherit WRISTS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m学霸之[1;33m五道杠[2;37;0m", ({ "xbg" }));
  set_weight(5000);
  set("item_make", 1);
  set("unit", "对");
  set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一对护腕。
[1;31m学霸中的杰出人物才能佩戴的五道杠大队长标志[2;37;0m
");
  set("makeinfo", "[1;31m
周不嗵(buto)[1;31m 出品
[2;37;0m");
  set("value", 4100000);
  set("point", 50);
  set("max_consistence", 100);
  set("material", "tian jing");
  set("material_file", "/clone/goods/tianjing");
  set("quality_level", 5);
  set("wear_msg", "[1;31m$N满脸得意的拿出$n[1;31m带在了手臂之上，真是羡煞旁人啊。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/reduce_busy", 2.500000);
  set("armor_prop/learn_effect", 6);

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
