#include <ansi.h>
#include <armor.h>

inherit FINGER;
inherit F_ITEMMAKE;

void create()
{
	set_name("[2;37;0m[36m庄子[2;37;0m", ({ "yji" }));
	set_weight(3500);
	set("item_make", 1);
	set("unit", "套");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一套指套。
[36m一本陈旧的古籍封面写着《庄子》。[2;37;0m
");
	set("makeinfo", "[1;31m
周不痛(buton)[1;31m 出品
[2;37;0m");
	set("value", 35600000);
	set("point", 1775);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname2");
	set("quality_level", 6);
	set("wear_msg", "$N从口袋拿出一本古籍，摇头晃脑的读道：北冥有鱼，其名为鲲。[2;37;0m\n");
	set("remove_msg", "$N小心翼翼的将$n收起来折好，放回书包内。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/unarmed_damage", apply_damage());
	set("armor_prop/armor", 10);
	set("armor_prop/research_effect", 12);

	setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
