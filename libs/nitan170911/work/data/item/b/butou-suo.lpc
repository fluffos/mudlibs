#include <ansi.h>
#include <weapon.h>

inherit WHIP;
inherit F_ITEMMAKE;

void create() {
  set_name("[5m[1;37m冰丝[1;34m蛇骨[1;37m鞭[2;37;0m", ({ "suo" }));
  set_weight(1050);
  set("item_make", 1);
  set("unit", "根");
  set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一根鞭。
[1;36m这是昆仑山[1;37m冰蚕丝[1;36m和[1;34m东海蛇妖的骨头[1;36m混合炼就的神鞭，通体雪白、柔软如丝，舞动起来如灵蛇一般。[2;37;0m
");
  set("makeinfo", "[1;31m
邢捕头(butou)[1;31m 出品
[2;37;0m");
  set("value", 2100000);
  set("point", 222);
  set("max_consistence", 100);
  set("material", "silk");
  set("material_file", "/d/item/obj/tiancs");
  set("quality_level", 2);
  set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一根[1;36m$n[1;36m。[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_whip(apply_damage());

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
