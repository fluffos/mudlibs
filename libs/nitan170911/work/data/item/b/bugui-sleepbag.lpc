#include <ansi.h>
#include <weapon.h>

inherit THROWING;
inherit F_ITEMMAKE;

void create()
{
	set_name("一[1;31m花[1;36m一[1;33m世界[2;37;0m", ({ "sleepbag" }));
	set_weight(300);
	set("item_make", 1);
	set("unit", "把");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一把暗器。
");
	set("makeinfo", "[1;31m
何处归(bugui)[1;31m 出品
[2;37;0m");
	set("value", 6100000);
	set("base_weight", 3);
	set("base_unit", "枚");
	set("base_value", 1);
	set("point", 1500);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname");
	set("quality_level", 5);
	set("hand_msg", "[1;36m$N[1;36m一声清啸，握着一把[1;36m$n[1;36m。[2;37;0m\n");
	set("unhand_msg", "$N随手一抹，收起了$n。\n");
	if( !check_clone() ) return;
	restore();
	set_amount(100);
	init_throwing(apply_damage());
	set("weapon_prop/avoid_parry", 1.500000);
	set("weapon_prop/add_busy", 2.500000);
	set("weapon_prop/through_armor", 2.000000);

	setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
