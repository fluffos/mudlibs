#include <ansi.h>
#include <weapon.h>

inherit BLADE;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[37m玄铁菜刀[2;37;0m", ({ "kblade" }));
  set_weight(15000);
  set("item_make", 1);
  set("unit", "把");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一把刀。
[37m这是一把玄冰寒铁铸锻而成的一把菜刀，上面刻着几个小字“三千浮屠”，上面不时道道乌光闪过。[2;37;0m
");
  set("makeinfo", "[1;31m
段德(bogey)[1;31m 出品
[2;37;0m");
  set("value", 35740000);
  set("point", 1782);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname2");
  set("quality_level", 6);
  set("wield_msg", "[37m$N随手一抹，手中不知何时已经多了一把$n。[2;37;0m\n");
  set("unwield_msg", "[37m$N随手一抹，收起了手中的$n[37m，不晓得藏到了哪里。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_blade(apply_damage());
  set("weapon_prop/ap_power", 2.000000);
  set("weapon_prop/add_weak", 2.500000);
  set("weapon_prop/add_damage", 2.500000);
  set("weapon_prop/double_damage", 2.000000);

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
