#include <ansi.h>
#include <weapon.h>

inherit XSWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;36m雅声[2;37;0m", ({ "yss" }));
  set_weight(1800);
  set("item_make", 1);
  set("unit", "支");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一支箫。
[1;36m这是传说中的神器[2;37;0m
");
  set("makeinfo", "[1;31m
步惊云(buyun)[1;31m 出品
[2;37;0m");
  set("value", 2100000);
  set("point", 460);
  set("max_consistence", 100);
  set("material", "magic stone");
  set("material_file", "/d/item/obj/butian");
  set("quality_level", 2);
  set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一支[1;36m$n[1;36m。[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_xsword(apply_damage());

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
