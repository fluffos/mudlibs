#include <ansi.h>
#include <armor.h>

inherit WRISTS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;32m超级内力护腕[2;37;0m", ({ "nlf" }));
  set_weight(500);
  set("item_make", 1);
  set("unit", "对");
  set("long", "这是由[1;35m寒星陨铁[2;37;0m炼制而成的一对护腕。
");
  set("makeinfo", "[1;31m
周不嗵(buto)[1;31m 出品
[2;37;0m");
  set("value", 4100000);
  set("point", 50);
  set("max_consistence", 100);
  set("material", "hanxing yuntie");
  set("material_file", "/clone/goods/hanxing-yuntie");
  set("quality_level", 5);
  set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/avoid_poison", 1.500000);
  set("armor_prop/max_neili", 10000);
  set("armor_prop/research_effect", 3);

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
