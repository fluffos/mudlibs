#include <ansi.h>
#include <armor.h>

inherit FINGER;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;31m学霸之步步高[2;37;0m", ({ "xba" }));
	set_weight(3500);
	set("item_make", 1);
	set("unit", "套");
	set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一套指套。
[1;31m学霸的步步高点读机[2;37;0m
");
	set("makeinfo", "[1;31m
周不嗵(buto)[1;31m 出品
[2;37;0m");
	set("value", 4100000);
	set("point", 356);
	set("max_consistence", 100);
	set("material", "tian jing");
	set("material_file", "/clone/goods/tianjing");
	set("quality_level", 5);
	set("wear_msg", "[1;31m麻麻再也不用担心我的学习，嗖……易……热[2;37;0m\n");
	set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/unarmed_damage", apply_damage());
	set("armor_prop/armor", 10);
	set("armor_prop/practice_effect", 3);
	set("armor_prop/learn_effect", 6);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
