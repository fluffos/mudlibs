#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;31m猫[1;37m爪[1;32m爪[2;37;0m", ({ "mzz" }));
	set_weight(4500);
	set("item_make", 1);
	set("unit", "双");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一双铁掌。
一阵毛绒绒的猫味飘过[2;37;0m
");
	set("makeinfo", "[1;31m
刃无缺(baleno)[1;31m 出品
[2;37;0m");
	set("value", 34580000);
	set("point", 1724);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname2");
	set("quality_level", 3);
	set("wear_msg", "一声清脆可爱的喵。。。。。。[2;37;0m\n");
	set("remove_msg", "一声清脆可爱的喵。。。。。。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/unarmed_damage", apply_damage());
	set("armor_prop/armor", 10);
	set("armor_prop/practice_effect", 2);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
