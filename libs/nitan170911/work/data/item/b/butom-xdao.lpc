#include <ansi.h>
#include <weapon.h>

inherit BLADE;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;31m杀猪刀[2;37;0m", ({ "xdao" }));
	set_weight(15000);
	set("item_make", 1);
	set("unit", "把");
	set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一把刀。
[1;31m这是一把看上去普普通通的杀猪刀
然而似乎它又有一种非同寻常之处
它的刀身上篆刻着三个字“小平赠”[2;37;0m
");
	set("makeinfo", "[1;31m
周不同(butom)[1;31m 出品
[2;37;0m");
	set("value", 4100000);
	set("point", 732);
	set("max_consistence", 100);
	set("material", "tian jing");
	set("material_file", "/clone/goods/tianjing");
	set("quality_level", 6);
	set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一把[1;36m$n[1;36m。[2;37;0m\n");
	set("unwield_msg", "$N随手一抹，收起了$n。\n");
	if( !check_clone() ) return;
	restore();
	init_blade(apply_damage());
	set("weapon_prop/ap_power", 6.000000);
	set("weapon_prop/da_power", 2.000000);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
