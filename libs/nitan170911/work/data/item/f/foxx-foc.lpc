#include <ansi.h>
#include <armor.h>

inherit ARMOR;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m[42m龙神护甲[2;37;0m", ({ "foc" }));
  set_weight(15000);
  set("item_make", 1);
  set("unit", "张");
  set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一张护甲。
");
  set("makeinfo", "[1;31m
阿绣(foxx)[1;31m 出品
[2;37;0m");
  set("value", 4100000);
  set("point", 800);
  set("max_consistence", 100);
  set("material", "tian jing");
  set("material_file", "/clone/goods/tianjing");
  set("quality_level", 6);
  set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/avoid_freeze", 0);
  set("armor_prop/derive_effect", 3);
  set("armor_prop/research_effect", 3);
  set("armor_prop/avoid_die", 2.500000);

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
