#include <ansi.h>
#include <weapon.h>

inherit STAFF;
inherit F_ITEMMAKE;

void create() {
  set_name("睡袋[2;37;0m", ({ "sleepbag" }));
  set_weight(6750);
  set("item_make", 1);
  set("unit", "根");
  set("long", "这是由[37m精铁[2;37;0m炼制而成的一根杖。
");
  set("makeinfo", "[1;31m
鲁米那(flyingii)[1;31m 出品
[2;37;0m");
  set("value", 700000);
  set("point", 150);
  set("max_consistence", 100);
  set("material", "iron");
  set("material_file", "/d/item/obj/jingtie");
  set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一根[1;36m$n[1;36m。[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_staff(apply_damage());

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
