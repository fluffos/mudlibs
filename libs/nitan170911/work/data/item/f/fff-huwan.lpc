#include <ansi.h>
#include <armor.h>

inherit WRISTS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;33m任志强[2;37;0m", ({ "huwan" }));
  set_weight(5000);
  set("item_make", 1);
  set("unit", "对");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一对护腕。
");
  set("makeinfo", "[1;31m
金木研(fff)[1;31m 出品
[2;37;0m");
  set("value", 34680000);
  set("point", 432);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname2");
  set("quality_level", 6);
  set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
