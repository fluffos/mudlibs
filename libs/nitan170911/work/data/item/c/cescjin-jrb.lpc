#include <ansi.h>
#include <weapon.h>

inherit WHIP;
inherit F_ITEMMAKE;

void create() {
  set_name("贱人鞭[2;37;0m", ({ "jrb" }));
  set_weight(1050);
  set("item_make", 1);
  set("unit", "根");
  set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一根鞭。
上古开天辟地之神器，源于盘古下体之精元[2;37;0m
");
  set("makeinfo", "[1;31m
暗煞(cescjin)[1;31m 出品
[2;37;0m");
  set("value", 2100000);
  set("point", 100);
  set("max_consistence", 100);
  set("material", "silk");
  set("material_file", "/d/item/obj/tiancs");
  set("quality_level", 2);
  set("wield_msg", "四周围的元气集聚与此，幻化成一根半透明的条状物[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_whip(apply_damage());

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
