#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;34m凌云[1;37m拨月[2;37;0m", ({ "cann" }));
	set_weight(9000);
	set("item_make", 1);
	set("unit", "柄");
	set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
[1;37m凌波所使用的神器，拥有强大的力量[2;37;0m
");
	set("makeinfo", "[1;31m
白云飘(canny)[1;31m 出品
[2;37;0m");
	set("value", 2100000);
	set("point", 166);
	set("max_consistence", 100);
	set("material", "magic stone");
	set("material_file", "/d/item/obj/butian");
	set("quality_level", 2);
	set("wield_msg", "[1;33m大地随之震动，凌云随身飞入手中[2;37;0m\n");
	set("unwield_msg", "[1;37m大地的震动随之消失，归于平静[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	init_sword(apply_damage());

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
