#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create()
{
	set_name("[2;37;0m[34m蓝[37m明[36m离[31m火[2;37;0m", ({ "lhs" }));
	set_weight(15000);
	set("item_make", 1);
	set("unit", "柄");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一柄剑。
这把[2;37;0m[34m蓝[37m明[36m离[31m火[2;37;0m剑是异空间的法宝，遨游在另一个宇宙中，被白眉老祖寻找到，穿破宇宙屏障，降临到了蜀山传的世界。[2;37;0m
");
	set("makeinfo", "[1;31m
欧阳星云(cwz)[1;31m 出品
[2;37;0m");
	set("value", 36100000);
	set("point", 1800);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname2");
	set("quality_level", 6);
	set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一柄[1;36m$n[1;36m。[2;37;0m\n");
	set("unwield_msg", "$N随手一抹，收起了$n。\n");
	if( !check_clone() ) return;
	restore();
	init_sword(apply_damage());
	set("weapon_prop/add_forget", 2.500000);
	set("weapon_prop/add_blind", 2.000000);
	set("weapon_prop/add_poison", 3);
	set("weapon_prop/add_weak", 2.500000);
	set("weapon_prop/add_busy", 2.500000);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
