#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[36m睡袋[2;37;0m", ({ "sleepbag" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
");
  set("makeinfo", "[1;31m
星剑(count)[1;31m 出品
[2;37;0m");
  set("value", 2100000);
  set("point", 100);
  set("max_consistence", 100);
  set("material", "magic stone");
  set("material_file", "/d/item/obj/butian");
  set("quality_level", 5);
  set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一柄[1;36m$n[1;36m。[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());
  set("weapon_prop/derive_effect", 3);
  set("weapon_prop/ap_power", 2.000000);
  set("weapon_prop/practice_effect", 3);

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
