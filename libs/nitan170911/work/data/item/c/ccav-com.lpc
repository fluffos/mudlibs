#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;33m习[1;35m近[1;37m平[2;37;0m", ({ "com" }));
	set_weight(15000);
	set("item_make", 1);
	set("unit", "柄");
	set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一柄剑。
这就是一把剑[2;37;0m
");
	set("makeinfo", "[1;31m
绻阆氚(ccav)[1;31m 出品
[2;37;0m");
	set("value", 4100000);
	set("point", 200);
	set("max_consistence", 100);
	set("material", "tian jing");
	set("material_file", "/clone/goods/tianjing");
	set("quality_level", 5);
	set("wield_msg", "[1;37m缓缓的拔出[2;37;0m\n");
	set("unwield_msg", "[1;32m深深的插入[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	init_sword(apply_damage());
	set("weapon_prop/practice_effect", 3);
	set("weapon_prop/research_effect", 6);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
