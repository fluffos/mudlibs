#include <ansi.h>
#include <armor.h>

inherit ARMOR;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;31m保暖内[1;33m甲[2;37;0m", ({ "nljia" }));
	set_weight(9000);
	set("item_make", 1);
	set("unit", "张");
	set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一张护甲。
");
	set("makeinfo", "[1;31m
渡越(cauac)[1;31m 出品
[2;37;0m");
	set("value", 2100000);
	set("point", 400);
	set("max_consistence", 100);
	set("material", "magic stone");
	set("material_file", "/d/item/obj/butian");
	set("quality_level", 5);
	set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
	set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/armor", apply_armor());
	set("armor_prop/neili_recover", 80);
	set("armor_prop/learn_effect", 3);
	set("armor_prop/max_neili", 10000);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
