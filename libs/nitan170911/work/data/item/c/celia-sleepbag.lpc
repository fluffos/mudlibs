#include <ansi.h>
#include <weapon.h>

inherit THROWING;
inherit F_ITEMMAKE;

void create() {
  set_name("生生世世[2;37;0m", ({ "sleepbag" }));
  set_weight(3000);
  set("item_make", 1);
  set("unit", "把");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一把暗器。
生生世世，我爱你[2;37;0m
");
  set("makeinfo", "[1;31m
龙美美(celia)[1;31m 出品
[2;37;0m");
  set("value", 34920000);
  set("base_weight", 30);
  set("base_unit", "枚");
  set("base_value", 1);
  set("point", 1741);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname2");
  set("quality_level", 6);
  set("hand_msg", "我是真的真的很爱你[2;37;0m\n");
  set("unhand_msg", "不管你爱不爱我！[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set_amount(100);
  init_throwing(apply_damage());
  set("weapon_prop/add_weak", 2.500000);
  set("weapon_prop/add_damage", 2.500000);
  set("weapon_prop/research_effect", 3);
  set("weapon_prop/add_freeze", 2.500000);

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
