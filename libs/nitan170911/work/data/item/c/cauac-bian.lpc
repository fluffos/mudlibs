#include <ansi.h>
#include <weapon.h>

inherit WHIP;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;37m骏马[1;35m不劳[1;31m[5m鞭[2;37;0m", ({ "bian" }));
	set_weight(1500);
	set("item_make", 1);
	set("unit", "根");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一根鞭。
");
	set("makeinfo", "[1;31m
渡越(cauac)[1;31m 出品
[2;37;0m");
	set("value", 6100000);
	set("point", 1500);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname");
	set("quality_level", 6);
	set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一根[1;36m$n[1;36m。[2;37;0m\n");
	set("unwield_msg", "$N随手一抹，收起了$n。\n");
	if( !check_clone() ) return;
	restore();
	init_whip(apply_damage());
	set("weapon_prop/fatal_blow", 2.000000);
	set("weapon_prop/research_effect", 9);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
