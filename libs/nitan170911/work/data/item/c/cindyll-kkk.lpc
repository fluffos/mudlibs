#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("小米加步枪[2;37;0m", ({ "kkk" }));
  set_weight(45000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[36m玄铁[2;37;0m炼制而成的一柄剑。
小米加步枪[2;37;0m
");
  set("makeinfo", "[1;31m
糖醋鲤鱼(cindyll)[1;31m 出品
[2;37;0m");
  set("value", 1500000);
  set("point", 154);
  set("max_consistence", 100);
  set("material", "steel");
  set("material_file", "/d/item/obj/xuantie");
  set("quality_level", 2);
  set("wield_msg", "拿出一把重型机关枪[2;37;0m\n");
  set("unwield_msg", "将重型机枪放回了裤裆里[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
