#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;31m帝王[1;33m神掌[2;37;0m", ({ "cheb" }));
	set_weight(450);
	set("item_make", 1);
	set("unit", "双");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一双铁掌。
[33m这是一副由[1;37m无名之物[36m打造的[1;31m帝王[1;33m神掌[2;37;0m[33m，
[36m上面分别刻着一行字句：
[1;33m碧海潮生按玉箫
[1;31m弹指神通影飞落[2;37;0m
");
	set("makeinfo", "[1;31m
扯蛋(che)[1;31m 出品
[2;37;0m");
	set("value", 6100000);
	set("point", 1500);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname");
	set("quality_level", 6);
	set("wear_msg", "[33m突现一股白雾，[36m突地雾散，[1;34m$N[33m吟诗一首\n[1;33m碧海潮生按玉箫\n[1;31m弹指神通影飞落[2;37;0m\n");
	set("remove_msg", "[33m只见[1;34m$N[33m[36m掌中一闪，[1;31m帝王[1;33m神掌[1;35m突然[33m消失不见[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/unarmed_damage", apply_damage());
	set("armor_prop/armor", 10);
	set("armor_prop/ap_power", 6.000000);
	set("armor_prop/double_damage", 2.000000);

	setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
