#include <ansi.h>
#include <armor.h>

inherit CLOTH;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;31m战[1;34m衣[2;37;0m", ({ "zhanyi" }));
	set_weight(2000);
	set("item_make", 1);
	set("unit", "件");
	set("long", "这是由[1;35m寒星陨铁[2;37;0m炼制而成的一件战衣。
");
	set("makeinfo", "[1;31m
李十八(clrak)[1;31m 出品
[2;37;0m");
	set("value", 4100000);
	set("point", 852);
	set("max_consistence", 100);
	set("material", "hanxing yuntie");
	set("material_file", "/clone/goods/hanxing-yuntie");
	set("quality_level", 5);
	set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
	set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/armor", apply_armor());
	set("armor_prop/defense", 30);
	set("armor_prop/max_experience", 50000);
	set("armor_prop/avoid_weak", 2.500000);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
