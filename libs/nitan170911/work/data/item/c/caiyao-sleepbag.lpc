#include <ansi.h>
#include <weapon.h>

inherit THROWING;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;32m睡[1;35m袋[2;37;0m", ({ "sleepbag" }));
	set_weight(1350);
	set("item_make", 1);
	set("unit", "把");
	set("long", "这是由[37m精铁[2;37;0m炼制而成的一把暗器。
[33m这是由[1;34m菜小邪[36m得自打铁铺的[1;37m百炼精钢[33m打造的[1;36m无敌[1;32m睡[1;35m袋[2;37;0m[33m
[36m上面分别刻着一行字句：
[1;33m想睡就睡
[1;31m真是方便[2;37;0m
");
	set("makeinfo", "[1;31m
菜小邪(caiyao)[1;31m 出品
[2;37;0m");
	set("value", 700000);
	set("base_weight", 13);
	set("base_unit", "枚");
	set("base_value", 1);
	set("point", 30);
	set("max_consistence", 100);
	set("material", "iron");
	set("material_file", "/d/item/obj/jingtie");
	set("quality_level", 2);
	set("hand_msg", "[33m只见[1;34m$N[36m背上突现一股白雾，[33m突地雾散，[36m才发现[1;34m$N[33m背上出现[1;37m由百炼精钢[36m打造的[1;36m无敌[1;32m睡[1;35m袋[2;37;0m\n");
	set("unhand_msg", "[33m只见[1;34m$N[33m[36m背上光华一闪，[1;32m睡[1;35m袋[33m已然消失不见[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set_amount(100);
	init_throwing(apply_damage());

	setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
