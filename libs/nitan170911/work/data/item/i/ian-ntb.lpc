#include <ansi.h>
#include <weapon.h>

inherit HAMMER;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[33m万张百元泥潭币[2;37;0m", ({ "ntb" }));
  set_weight(35000);
  set("item_make", 1);
  set("unit", "把");
  set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一把锤。
[33m这是泥潭临时发行的巨额泥潭币，据说只发行了一张[2;37;0m
");
  set("makeinfo", "[1;31m
浩然(ian)[1;31m 出品
[2;37;0m");
  set("value", 4100000);
  set("point", 1000);
  set("max_consistence", 100);
  set("material", "tian jing");
  set("material_file", "/clone/goods/tianjing");
  set("quality_level", 6);
  set("wield_msg", "[1;31m$N成功充值了一百万泥潭币[2;37;0m\n");
  set("unwield_msg", "[1;31m$N向你转账了一百万泥潭币[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_hammer(apply_damage());
  set("weapon_prop/add_damage", 10.000000);

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
