#include <ansi.h>
#include <weapon.h>

inherit BLADE;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;33m末日神话[2;37;0m", ({ "ults" }));
  set_weight(15000);
  set("item_make", 1);
  set("unit", "把");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一把刀。
[1;33m[5m末法时代，成住坏空，极尽神话！[2;37;0m
");
  set("makeinfo", "[1;31m
太学主(ultimate)[1;31m 出品
[2;37;0m");
  set("value", 34340000);
  set("point", 1712);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname2");
  set("quality_level", 6);
  set("wield_msg", "[1;33m[5m我若要无，天不许有！我若要有，天不可无！[2;37;0m\n");
  set("unwield_msg", "[1;33m[5m魔前一叩三千年，回首凡尘不做仙，只为她……掌缘生灭！！！[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_blade(apply_damage());
  set("weapon_prop/practice_effect", 3);
  set("weapon_prop/research_effect", 9);

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
