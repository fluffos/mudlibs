#include <ansi.h>
#include <weapon.h>

inherit THROWING;
inherit F_ITEMMAKE;

void create()
{
	set_name("[5m[1;31m一寸相思[1;36m一寸灰[2;37;0m", ({ "xiangsi" }));
	set_weight(3000);
	set("item_make", 1);
	set("unit", "把");
	set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一把暗器。
[1;31m春未老，风细柳斜斜。试上超然台上看，半壕春水一城花，烟雨暗千家。[2;37;0m
");
	set("makeinfo", "[1;31m
小怪物(ulianz)[1;31m 出品
[2;37;0m");
	set("value", 4100000);
	set("base_weight", 30);
	set("base_unit", "枚");
	set("base_value", 1);
	set("point", 1000);
	set("max_consistence", 100);
	set("material", "tian jing");
	set("material_file", "/clone/goods/tianjing");
	set("quality_level", 2);
	set("hand_msg", "[1;35m只听到一阵轻音好似自虚空中飘来，清风飘，细雨遥。一荏清风一生漂泊，一丝烟雨一世摇落。夜闻雨声眠，烟雨梦江南。[2;37;0m\n");
	set("unhand_msg", "[1;33m只听到一声轻叹，罢罢罢，塞北寒冬雪，江南春日花。怎能让人不流连，最是令人难消歇。丝丝江南雨，滴滴梨花泪……[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set_amount(100);
	init_throwing(apply_damage());

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
