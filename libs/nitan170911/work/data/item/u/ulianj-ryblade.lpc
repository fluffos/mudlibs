#include <ansi.h>
#include <weapon.h>

inherit BLADE;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m万事如意[2;37;0m", ({ "ryblade" }));
  set_weight(15000);
  set("item_make", 1);
  set("unit", "把");
  set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一把刀。
");
  set("makeinfo", "[1;31m
铁头丙(ulianj)[1;31m 出品
[2;37;0m");
  set("value", 4100000);
  set("point", 1000);
  set("max_consistence", 100);
  set("material", "tian jing");
  set("material_file", "/clone/goods/tianjing");
  set("quality_level", 5);
  set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一把[1;36m$n[1;36m。[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_blade(apply_damage());
  set("weapon_prop/int", 3);
  set("weapon_prop/leech_qi", 2.000000);
  set("weapon_prop/research_effect", 3);

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
