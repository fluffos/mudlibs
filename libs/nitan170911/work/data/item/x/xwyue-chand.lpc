#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;36m别棱[2;37;0m", ({ "chand" }));
  set_weight(4000);
  set("item_make", 1);
  set("unit", "双");
  set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一双护手。
");
  set("makeinfo", "[1;31m
文真(xwyue)[1;31m 出品
[2;37;0m");
  set("value", 4100000);
  set("point", 1000);
  set("max_consistence", 100);
  set("material", "tian jing");
  set("material_file", "/clone/goods/tianjing");
  set("quality_level", 6);
  set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/unarmed_damage", apply_damage());
  set("armor_prop/armor", 10);
  set("armor_prop/da_power", 2.000000);
  set("armor_prop/add_weak", 2.500000);
  set("armor_prop/research_effect", 6);

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
