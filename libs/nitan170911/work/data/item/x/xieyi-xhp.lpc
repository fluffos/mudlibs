#include <ansi.h>
#include <armor.h>

inherit SURCOAT;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;31m销[1;33m魂[1;34m披[2;37;0m", ({ "xhp" }));
	set_weight(10000);
	set("item_make", 1);
	set("unit", "件");
	set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一件披风。
[33m这是一副由[1;34m疯小邪[36m得自天外的[1;37m寰宇天晶[33m打造的[1;31m销[1;33m魂[1;34m披风[2;37;0m
");
	set("makeinfo", "[1;31m
疯小邪(xieyi)[1;31m 出品
[2;37;0m");
	set("value", 4100000);
	set("point", 500);
	set("max_consistence", 100);
	set("material", "tian jing");
	set("material_file", "/clone/goods/tianjing");
	set("quality_level", 6);
	set("wear_msg", "[33m只见[1;34m$N[36m背上光芒闪烁，[33m定睛一看，[36m原来[1;34m$N[33m背上出现一副由[1;37m寰宇天晶[36m打造的[1;31m销[1;33m魂[1;34m披[2;37;0m\n");
	set("remove_msg", "[33m只见[1;34m$N[33m[36m背上光芒一闪，[1;31m销[1;33m魂[1;34m批[33m已然消失不见[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/armor", apply_armor());
	set("armor_prop/practice_effect", 3);
	set("armor_prop/research_effect", 9);

	setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
