#include <ansi.h>
#include <weapon.h>

inherit HAMMER;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;33m巴黎圣母院[2;37;0m", ({ "aaa" }));
  set_weight(3500);
  set("item_make", 1);
  set("unit", "把");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一把锤。
");
  set("makeinfo", "[1;31m
龙四龙(xiaojuan)[1;31m 出品
[2;37;0m");
  set("value", 6100000);
  set("point", 1500);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname");
  set("quality_level", 6);
  set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一把[1;36m$n[1;36m。[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_hammer(apply_damage());
  set("weapon_prop/fatal_blow", 2.000000);
  set("weapon_prop/add_damage", 7.500000);

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
