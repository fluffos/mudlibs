#include <ansi.h>
#include <weapon.h>

inherit WHIP;
inherit F_ITEMMAKE;

void create()
{
	set_name("睡袋[2;37;0m", ({ "sleepbag" }));
	set_weight(750);
	set("item_make", 1);
	set("unit", "根");
	set("long", "这是由[2;37;0m[33m钛金竹[2;37;0m炼制而成的一根鞭。
");
	set("makeinfo", "[1;31m
文真(xwyue)[1;31m 出品
[2;37;0m");
	set("value", 1100000);
	set("point", 50);
	set("max_consistence", 100);
	set("material", "stone");
	set("material_file", "/clone/fam/item/taijin");
	set("quality_level", 2);
	set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一根[1;36m$n[1;36m。[2;37;0m\n");
	set("unwield_msg", "$N随手一抹，收起了$n。\n");
	if( !check_clone() ) return;
	restore();
	init_whip(apply_damage());

	setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
