#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create() {
  set_name("[5m[1;37m销[31m魂[1;35m之手[2;37;0m", ({ "xxchand" }));
  set_weight(4500);
  set("item_make", 1);
  set("unit", "双");
  set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一双铁掌。
[1;37m忘我杀境·[1;32m无上神兵[1;35m紫宵剑豪·[1;36m无尽弑戮[1;33m永无止境·[1;31m立地成魔[2;37;0m
");
  set("makeinfo", "[1;31m
老人(xxc)[1;31m 出品
[2;37;0m");
  set("value", 4100000);
  set("point", 1000);
  set("max_consistence", 100);
  set("material", "tian jing");
  set("material_file", "/clone/goods/tianjing");
  set("quality_level", 6);
  set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
