#include <ansi.h>
#include <weapon.h>

inherit BLADE;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m销[1;33m魂[1;34m刀[2;37;0m", ({ "xhb" }));
  set_weight(15000);
  set("item_make", 1);
  set("unit", "把");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一把刀。
[33m这是一副由[1;34m疯小邪[36m得自天外的[1;37m无名之物[33m打造的[1;31m销[1;33m魂[1;34m刀[2;37;0m
");
  set("makeinfo", "[1;31m
疯小邪(xieyi)[1;31m 出品
[2;37;0m");
  set("value", 35980000);
  set("point", 1794);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname2");
  set("quality_level", 6);
  set(
    "wield_msg",
    "[33m只见[1;34m$N[36m掌中突现一股白雾，[33m突地雾散，[36m才发现[1;34m$N[33m手掌上已有一把由[1;37m无名之物[36m打造的[1;36m绝世神刀[1;31m销[1;33m魂[1;34m刀[2;37;0m\n"
  );
  set(
    "unwield_msg",
    "[33m只见[1;34m$N[33m[36m手上光芒一闪，[1;31m销[1;33m魂[1;34m刀[33m已然消失不见[2;37;0m\n"
  );
  if (!check_clone()) return;
  restore();
  init_blade(apply_damage());
  set("weapon_prop/ap_power", 6.000000);
  set("weapon_prop/add_damage", 2.500000);

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
