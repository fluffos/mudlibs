#include <ansi.h>
#include <armor.h>

inherit HEAD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;33m鸿运头盔[2;37;0m", ({ "hyt" }));
  set_weight(7500);
  set("item_make", 1);
  set("unit", "顶");
  set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一顶头盔。
");
  set("makeinfo", "[1;31m
虚小(xiaoqi)[1;31m 出品
[2;37;0m");
  set("value", 4100000);
  set("point", 500);
  set("max_consistence", 100);
  set("material", "tian jing");
  set("material_file", "/clone/goods/tianjing");
  set("quality_level", 6);
  set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/full_self", 2.500000);
  set("armor_prop/avoid_weak", 2.500000);
  set("armor_prop/reduce_busy", 5.000000);

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
