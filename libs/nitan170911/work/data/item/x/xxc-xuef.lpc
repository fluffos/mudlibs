#include <ansi.h>
#include <armor.h>

inherit WAIST;
inherit F_ITEMMAKE;

void create()
{
	set_name("[5m[1;37m学[31m习[1;35m腰带[2;37;0m", ({ "xuef" }));
	set_weight(8000);
	set("item_make", 1);
	set("unit", "条");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一条腰带。
");
	set("makeinfo", "[1;31m
老人(xxc)[1;31m 出品
[2;37;0m");
	set("value", 35260000);
	set("point", 703);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname2");
	set("quality_level", 5);
	set("wear_msg", "[1;31m杀人放火金腰带[2;37;0m\n");
	set("remove_msg", "[1;35m造桥修路无尸骸[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/armor", apply_armor());
	set("armor_prop/avoid_weak", 2.500000);
	set("armor_prop/learn_effect", 6);

	setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
