#include <ansi.h>
#include <armor.h>

inherit CLOTH;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m销[1;33m魂[1;34m衣[2;37;0m", ({ "xhy" }));
  set_weight(20000);
  set("item_make", 1);
  set("unit", "件");
  set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一件战衣。
[33m这是一件由[1;34m疯小邪[36m得自天外的[1;37m寰宇天晶[33m打造的[1;31m销[1;33m魂[1;34m衣[2;37;0m
");
  set("makeinfo", "[1;31m
疯小邪(xieyi)[1;31m 出品
[2;37;0m");
  set("value", 4100000);
  set("point", 1000);
  set("max_consistence", 100);
  set("material", "tian jing");
  set("material_file", "/clone/goods/tianjing");
  set("quality_level", 6);
  set(
    "wear_msg",
    "[33m只见[1;34m$N[36m身上光芒闪烁，[33m定睛一看，[36m原来[1;34m$N[33m身上出现一件由[1;37m寰宇天晶[36m打造的[1;31m销[1;33m魂[1;34m衣[2;37;0m\n"
  );
  set(
    "remove_msg",
    "[33m只见[1;34m$N[33m[36m身上光芒一闪，[1;31m销[1;33m魂[1;34m衣[33m已然消失不见[2;37;0m\n"
  );
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/counter_damage", 2.500000);
  set("armor_prop/research_effect", 9);

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
