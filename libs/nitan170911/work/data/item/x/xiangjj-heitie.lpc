#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("黑铁剑[2;37;0m", ({ "heitie" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
黑色玄铁铸造而成的剑，吹毛断发。[2;37;0m
");
  set("makeinfo", "[1;31m
大卵泡(xiangjj)[1;31m 出品
[2;37;0m");
  set("value", 2100000);
  set("point", 100);
  set("max_consistence", 100);
  set("material", "magic stone");
  set("material_file", "/d/item/obj/butian");
  set("quality_level", 2);
  set("wield_msg", "拔出了黑铁剑握在手中。[2;37;0m\n");
  set("unwield_msg", "将黑铁剑插入了剑鞘。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
