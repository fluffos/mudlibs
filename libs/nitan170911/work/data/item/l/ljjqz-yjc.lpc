#include <ansi.h>
#include <armor.h>

inherit CLOTH;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;35m金丹期[2;37;0m", ({ "yjc" }));
  set_weight(2000);
  set("item_make", 1);
  set("unit", "件");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一件战衣。
[1;35m金丹大圆满[2;37;0m
");
  set("makeinfo", "[1;31m
不知死(ljjqz)[1;31m 出品
[2;37;0m");
  set("value", 6100000);
  set("point", 1500);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname");
  set("quality_level", 6);
  set("wear_msg", "[1;35m大量的金光从金丹上猛的扩散开来，连接了全身的经脉，在这一刹那，眼睛完全成为了金色[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/practice_effect", 3);
  set("armor_prop/research_effect", 9);

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
