#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m终极仙掌[2;37;0m", ({ "lfa" }));
  set_weight(4500);
  set("item_make", 1);
  set("unit", "双");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一双铁掌。
[1;36m绝世掌套[1;31m终极仙掌[2;37;0m[33m，
[36m上面分别刻着一行字句：
[1;33m乾坤一出惊天地
[1;31m九阳威猛谁人敌[2;37;0m
");
  set("makeinfo", "[1;31m
龙凤(longfeng)[1;31m 出品
[2;37;0m");
  set("value", 35960000);
  set("point", 1793);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname2");
  set("quality_level", 6);
  set(
    "wear_msg",
    "[33m只见[1;34m$N[36m掌中突现一股白雾，[33m突地雾散，[36m才发现[1;34m$N[33m手掌上已有一副由[1;37m无名之物[36m打造的[1;36m绝世掌套[1;31m终极仙掌[2;37;0m\n"
  );
  set("remove_msg", "[33m只见[1;34m$N[33m[36m掌中一闪，[1;31m终极仙掌[33m已然消失不见[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/unarmed_damage", apply_damage());
  set("armor_prop/armor", 10);
  set("armor_prop/ap_power", 8.000000);

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
