#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;33m摸金神符[2;37;0m", ({ "jian" }));
	set_weight(15000);
	set("item_make", 1);
	set("unit", "柄");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一柄剑。
[1;33m自古以来摸金校尉们用来趋吉避凶的神符[2;37;0m
");
	set("makeinfo", "[1;31m
段玉(lovenun)[1;31m 出品
[2;37;0m");
	set("value", 35220000);
	set("point", 1756);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname2");
	set("quality_level", 5);
	set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一柄[1;36m$n[1;36m。[2;37;0m\n");
	set("unwield_msg", "$N随手一抹，收起了$n。\n");
	if( !check_clone() ) return;
	restore();
	init_sword(apply_damage());
	set("weapon_prop/magic_find", 3);
	set("weapon_prop/da_power", 2.000000);
	set("weapon_prop/leech_neili", 2.000000);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
