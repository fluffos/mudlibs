#include <ansi.h>
#include <armor.h>

inherit BOOTS;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;31m无限轮回[2;37;0m", ({ "limitg" }));
	set_weight(600);
	set("item_make", 1);
	set("unit", "双");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一双靴子。
[1;31m[5m问君能有几多愁？恰似一江春水向东流！[2;37;0m
");
	set("makeinfo", "[1;31m
最终信仰(limitless)[1;31m 出品
[2;37;0m");
	set("value", 6100000);
	set("point", 600);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname");
	set("quality_level", 6);
	set("wear_msg", "[1;31m[5m天若有情天亦老，人间正道是沧桑！！[2;37;0m\n");
	set("remove_msg", "[1;31m[5m路漫漫其修远兮，吾将上下而求索！！！[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/armor", apply_armor());
	set("armor_prop/practice_effect", 3);
	set("armor_prop/research_effect", 9);

	setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
