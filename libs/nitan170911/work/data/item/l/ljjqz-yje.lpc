#include <ansi.h>
#include <armor.h>

inherit HEAD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;33m斩灵期[2;37;0m", ({ "yje" }));
  set_weight(750);
  set("item_make", 1);
  set("unit", "顶");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一顶头盔。
[1;33m斩灵大圆满[2;37;0m
");
  set("makeinfo", "[1;31m
不知死(ljjqz)[1;31m 出品
[2;37;0m");
  set("value", 6100000);
  set("point", 750);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname");
  set("quality_level", 6);
  set("wear_msg", "[1;33m天地者，万物之逆旅，岁月者。百代之过客，斩下了枷锁，斩出了自由，拥有了自在[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
