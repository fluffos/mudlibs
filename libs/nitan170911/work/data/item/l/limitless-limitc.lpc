#include <ansi.h>
#include <armor.h>

inherit ARMOR;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m无限祝福[2;37;0m", ({ "limitc" }));
  set_weight(1500);
  set("item_make", 1);
  set("unit", "张");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一张护甲。
[1;31m[5m海上生明月，天涯共此时！[2;37;0m
");
  set("makeinfo", "[1;31m
最终信仰(limitless)[1;31m 出品
[2;37;0m");
  set("value", 6100000);
  set("point", 1200);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname");
  set("quality_level", 6);
  set("wear_msg", "[1;31m[5m人生得意须尽欢，莫使金樽空对月！！[2;37;0m\n");
  set("remove_msg", "[1;31m[5m曾经沧海难为水，除却巫山不是云！！！[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/full_self", 2.500000);
  set("armor_prop/research_effect", 9);

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
