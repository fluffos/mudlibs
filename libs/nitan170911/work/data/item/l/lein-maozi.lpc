#include <ansi.h>
#include <armor.h>

inherit HEAD;
inherit F_ITEMMAKE;

void create() {
  set_name("太阳帽[2;37;0m", ({ "maozi" }));
  set_weight(750);
  set("item_make", 1);
  set("unit", "顶");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一顶头盔。
一顶帽子[2;37;0m
");
  set("makeinfo", "[1;31m
灭姐(lein)[1;31m 出品
[2;37;0m");
  set("value", 6100000);
  set("point", 150);
  set("max_consistence", 100);
  set("material", "no name");
