#include <ansi.h>
#include <armor.h>

inherit SURCOAT;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;31m无限祈祷[2;37;0m", ({ "limitd" }));
	set_weight(1000);
	set("item_make", 1);
	set("unit", "件");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一件披风。
[1;31m[5m此情无计可消除，才下眉头，却上心头！[2;37;0m
");
	set("makeinfo", "[1;31m
最终信仰(limitless)[1;31m 出品
[2;37;0m");
	set("value", 6100000);
	set("point", 750);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname");
	set("quality_level", 6);
	set("wear_msg", "[1;31m[5m众里寻他千百度，蓦然回首，那人却在，灯火阑珊处！！[2;37;0m\n");
	set("remove_msg", "[1;31m[5m此情可待成追忆，只是当时已惘然！！！[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/armor", apply_armor());
	set("armor_prop/dp_power", 1.500000);
	set("armor_prop/research_effect", 9);

	setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
