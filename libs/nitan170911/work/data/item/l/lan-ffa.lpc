#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("长剑[2;37;0m", ({ "ffa" }));
  set_weight(15000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一柄剑。
");
  set("makeinfo", "[1;31m
米兰(lan)[1;31m 出品
[2;37;0m");
  set("value", 34560000);
  set("point", 1723);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname2");
  set("quality_level", 6);
  set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中，只觉一股寒气扑面而来。[2;37;0m\n");
  set("unwield_msg", "$N将手中的$n插回剑鞘，只听“嗤”的一声轻响。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());
  set("weapon_prop/add_forget", 2.500000);
  set("weapon_prop/ap_power", 6.000000);

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
