#include <ansi.h>
#include <armor.h>

inherit WAIST;
inherit F_ITEMMAKE;

void create()
{
	set_name("七彩琉璃束带[2;37;0m", ({ "hwaist" }));
	set_weight(8000);
	set("item_make", 1);
	set("unit", "条");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一条腰带。
");
	set("makeinfo", "[1;31m
静莉(loli)[1;31m 出品
[2;37;0m");
	set("value", 35100000);
	set("point", 700);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname2");
	set("quality_level", 6);
	set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
	set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/armor", apply_armor());
	set("armor_prop/counter_damage", 2.500000);
	set("armor_prop/practice_effect", 3);
	set("armor_prop/reduce_damage", 5.000000);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
