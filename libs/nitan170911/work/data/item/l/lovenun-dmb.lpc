#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;33m洛阳神铲[2;37;0m", ({ "dmb" }));
	set_weight(4500);
	set("item_make", 1);
	set("unit", "双");
	set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一双铁掌。
[1;33m这是一把盗墓者们常用的洛阳铲，它看上去似乎并没有什么与众不同之处，
它上面刻满各种稀奇古怪的符文，据传说这些符文能为主人带来特别好运。[2;37;0m
");
	set("makeinfo", "[1;31m
段玉(lovenun)[1;31m 出品
[2;37;0m");
	set("value", 4100000);
	set("point", 1000);
	set("max_consistence", 100);
	set("material", "tian jing");
	set("material_file", "/clone/goods/tianjing");
	set("quality_level", 5);
	set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
	set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/unarmed_damage", apply_damage());
	set("armor_prop/armor", 10);
	set("armor_prop/magic_find", 3);
	set("armor_prop/avoid_parry", 1.500000);
	set("armor_prop/leech_neili", 2.000000);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
