#include <ansi.h>
#include <armor.h>

inherit HEAD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m无限光明[2;37;0m", ({ "limita" }));
  set_weight(750);
  set("item_make", 1);
  set("unit", "顶");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一顶头盔。
[1;31m[5m天地不仁，以万物为刍狗！[2;37;0m
");
  set("makeinfo", "[1;31m
最终信仰(limitless)[1;31m 出品
[2;37;0m");
  set("value", 6100000);
  set("point", 750);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname");
  set("quality_level", 6);
  set("wear_msg", "[1;31m[5m天行健，君子以自强不息！！[2;37;0m\n");
  set("remove_msg", "[1;31m[5m地势坤，君子以厚德载物！！！[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/derive_effect", 3);
  set("armor_prop/research_effect", 9);

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
