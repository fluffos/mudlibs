#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m美人儿[2;37;0m", ({ "myjian" }));
  set_weight(15000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一柄剑。
[1;35m绝世美女[2;37;0m
");
  set("makeinfo", "[1;31m
画别致(lusss)[1;31m 出品
[2;37;0m");
  set("value", 34380000);
  set("point", 1714);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname2");
  set("quality_level", 2);
  set("wield_msg", "[1;32m屁股一扭嘤的一声[2;37;0m\n");
  set("unwield_msg", "[1;31m瘫软在怀中[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
