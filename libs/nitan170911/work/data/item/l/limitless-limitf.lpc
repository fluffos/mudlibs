#include <ansi.h>
#include <armor.h>

inherit WRISTS;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;31m无限欲望[2;37;0m", ({ "limitf" }));
	set_weight(500);
	set("item_make", 1);
	set("unit", "对");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一对护腕。
[1;31m[5m胭脂泪，相留醉，几时重。自是人生长恨水长东！[2;37;0m
");
	set("makeinfo", "[1;31m
最终信仰(limitless)[1;31m 出品
[2;37;0m");
	set("value", 6100000);
	set("point", 375);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname");
	set("quality_level", 6);
	set("wear_msg", "[1;31m[5m花开堪折直须折，莫待无花空折枝！！[2;37;0m\n");
	set("remove_msg", "[1;31m[5m身无彩凤双飞翼，心有灵犀一点通！！！[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/armor", apply_armor());
	set("armor_prop/dp_power", 1.500000);
	set("armor_prop/research_effect", 9);

	setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
