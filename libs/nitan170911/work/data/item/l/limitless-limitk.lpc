#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m无限杀戮[2;37;0m", ({ "limitk" }));
  set_weight(4500);
  set("item_make", 1);
  set("unit", "双");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一双铁掌。
[1;31m[5m我本将心向明月，奈何明月照沟渠？[2;37;0m
");
  set("makeinfo", "[1;31m
最终信仰(limitless)[1;31m 出品
[2;37;0m");
  set("value", 34480000);
  set("point", 1719);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname2");
  set("quality_level", 6);
  set("wear_msg", "[1;31m[5m我以我眼看造化，我以我心开青天！！[2;37;0m\n");
  set("remove_msg", "[1;31m[5m寄意寒星荃不察，我以我血荐轩辕！！！[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/unarmed_damage", apply_damage());
  set("armor_prop/armor", 10);
  set("armor_prop/research_effect", 9);
  set("armor_prop/double_damage", 2.000000);

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
