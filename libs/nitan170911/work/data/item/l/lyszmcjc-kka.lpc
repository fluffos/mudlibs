#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[41;1m轩辕剑[2;37;0m", ({ "kka" }));
  set_weight(15000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一柄剑。
");
  set("makeinfo", "[1;31m
小恒恒(lyszmcjc)[1;31m 出品
[2;37;0m");
  set("value", 36040000);
  set("point", 1797);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname2");
  set("quality_level", 6);
  set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一柄[1;36m$n[1;36m。[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());
  set("weapon_prop/fatal_blow", 2.000000);
  set("weapon_prop/add_forget", 2.500000);
  set("weapon_prop/ap_power", 2.000000);
  set("weapon_prop/double_damage", 2.000000);

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
