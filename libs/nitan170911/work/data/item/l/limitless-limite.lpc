#include <ansi.h>
#include <armor.h>

inherit WAIST;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;31m无限诱惑[2;37;0m", ({ "limite" }));
	set_weight(800);
	set("item_make", 1);
	set("unit", "条");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一条腰带。
[1;31m[5m东边日出西边雨，道是无晴却有情！[2;37;0m
");
	set("makeinfo", "[1;31m
最终信仰(limitless)[1;31m 出品
[2;37;0m");
	set("value", 6100000);
	set("point", 600);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname");
	set("quality_level", 6);
	set("wear_msg", "[1;31m[5m金风玉露一相逢，便胜却人间无数！！[2;37;0m\n");
	set("remove_msg", "[1;31m[5m两情若是久长时，又岂在朝朝暮暮！！！[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/armor", apply_armor());
	set("armor_prop/practice_effect", 3);
	set("armor_prop/research_effect", 9);

	setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
