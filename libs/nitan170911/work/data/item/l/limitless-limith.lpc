#include <ansi.h>
#include <armor.h>

inherit FINGER;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m无限湮灭[2;37;0m", ({ "limith" }));
  set_weight(3500);
  set("item_make", 1);
  set("unit", "套");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一套指套。
[1;31m[5m大江东去，浪淘尽，千古风流！[2;37;0m
");
  set("makeinfo", "[1;31m
最终信仰(limitless)[1;31m 出品
[2;37;0m");
  set("value", 36000000);
  set("point", 1795);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname2");
  set("quality_level", 6);
  set("wear_msg", "[1;31m[5m谈笑间、强橹灰飞湮灭！！[2;37;0m\n");
  set("remove_msg", "[1;31m[5m多情应笑我，人生如梦！！！[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/unarmed_damage", apply_damage());
  set("armor_prop/armor", 10);
  set("armor_prop/add_damage", 2.500000);
  set("armor_prop/research_effect", 9);

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
