#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;33m太极剑[2;37;0m", ({ "tjj" }));
  set_weight(1500);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一柄剑。
形态飘逸潇洒之极颇具太极之意[2;37;0m
");
  set("makeinfo", "[1;31m
皓轩(ljj)[1;31m 出品
[2;37;0m");
  set("value", 6100000);
  set("point", 1500);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname");
  set("quality_level", 6);
  set("wield_msg", "[1;36m形态飘逸潇洒之极颇具[1;33m太极[1;36m之意[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());
  set("weapon_prop/fatal_blow", 6.000000);
  set("weapon_prop/double_damage", 2.000000);

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
