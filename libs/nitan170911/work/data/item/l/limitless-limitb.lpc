#include <ansi.h>
#include <armor.h>

inherit CLOTH;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;31m无限荣耀[2;37;0m", ({ "limitb" }));
	set_weight(2000);
	set("item_make", 1);
	set("unit", "件");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一件战衣。
[1;31m[5m悠悠万古，不尽长江滚滚流，天下英雄谁敌手？[2;37;0m
");
	set("makeinfo", "[1;31m
最终信仰(limitless)[1;31m 出品
[2;37;0m");
	set("value", 6100000);
	set("point", 1500);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname");
	set("quality_level", 6);
	set("wear_msg", "[1;31m[5m怅寥廓，问苍茫大地，谁主沉浮？？[2;37;0m\n");
	set("remove_msg", "[1;31m[5m俱往矣，数风流人物，还看今朝！！！[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/armor", apply_armor());
	set("armor_prop/derive_effect", 3);
	set("armor_prop/research_effect", 9);

	setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
