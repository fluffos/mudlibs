#include <ansi.h>
#include <armor.h>

inherit WRISTS;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;35m魔女[1;37m的[1;36m电子表[2;37;0m", ({ "mmg" }));
	set_weight(5000);
	set("item_make", 1);
	set("unit", "对");
	set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一对护腕。
");
	set("makeinfo", "[1;31m
莉莉(lily)[1;31m 出品
[2;37;0m");
	set("value", 4100000);
	set("point", 250);
	set("max_consistence", 100);
	set("material", "tian jing");
	set("material_file", "/clone/goods/tianjing");
	set("quality_level", 2);
	set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
	set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/armor", apply_armor());

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
