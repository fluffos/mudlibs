#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[31m血剑[2;37;0m", ({ "xuesword" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
血色的长剑善发出淡淡暗红色[2;37;0m
");
  set("makeinfo", "[1;31m
没影子(asksk)[1;31m 出品
[2;37;0m");
  set("value", 2100000);
  set("point", 100);
  set("max_consistence", 100);
  set("material", "magic stone");
  set("material_file", "/d/item/obj/butian");
  set("quality_level", 2);
  set("wield_msg", "[1;37m一道红光闪过血剑出现在手中[2;37;0m\n");
  set("unwield_msg", "[1;31m血剑回鞘[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
