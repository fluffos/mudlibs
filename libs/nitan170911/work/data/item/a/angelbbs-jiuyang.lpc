#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create() {
  set_name("[5m[1;31m九阳[1;37m真经[2;37;0m", ({ "jiuyang" }));
  set_weight(400);
  set("item_make", 1);
  set("unit", "双");
  set(
    "long",
    "这是由[1;35m无名之物[2;37;0m炼制而成的一双护手。
[1;31m这是一本薄薄的经书，书面上写着[1;33m《[5m[1;31m九阳[1;37m真经[2;37;0m[1;33m》[1;31m，只因油布包得紧密，虽长期藏在猿腹之中，书页仍然完好无损。[2;37;0m
"
  );
  set("makeinfo", "[1;31m
五毒教主(angelbbs)[1;31m 出品
[2;37;0m");
  set("value", 6100000);
  set("point", 1500);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname");
  set("quality_level", 5);
  set(
    "wear_msg",
    "$N[1;35m拿出一本[1;33m《$n[1;33m》[1;35m，只见书面上写著几个弯弯曲曲的文字，但是一个也不识得，翻开来一看，书中尽是这些怪文，但每一行之间，却以蝇头小楷写满了中国文字。[2;37;0m\n"
  );
  set("remove_msg", "$N[1;35m轻轻合上[1;33m《$n[1;33m》[1;35m，[1;35m放入怀中。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/unarmed_damage", apply_damage());
  set("armor_prop/armor", 10);
  set("armor_prop/magic_find", 3);
  set("armor_prop/ap_power", 2.000000);
  set("armor_prop/research_effect", 3);

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
