#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m十方俱灭[2;37;0m", ({ "destroy" }));
  set_weight(1500);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一柄剑。
[1;37m上天．下地．东．南．西．北．生门．死位．过去．未来，天机不可泄露！[2;37;0m
");
  set("makeinfo", "[1;31m
净素(amperex)[1;31m 出品
[2;37;0m");
  set("value", 6100000);
  set("point", 1500);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname");
  set("quality_level", 6);
  set(
    "wield_msg",
    "[1;36m[5m问，争权夺利何时停；恨，崎岖世路人难行！\n[1;36m问，风波干戈何时停；恨，朱雀泣血吐丹志！\n[1;36m问，生灵涂炭何时停；恨，日月争辉谁人赢！[2;37;0m\n"
  );
  set(
    "unwield_msg",
    "[1;31m[5m一誓向人，红尘归理道云清！\n[1;31m二誓向地，妖氛涤尽灵岳起！\n[1;31m三誓向天，月落西坠日独行！[2;37;0m\n"
  );
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());
  set("weapon_prop/fatal_blow", 2.000000);
  set("weapon_prop/research_effect", 9);

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
