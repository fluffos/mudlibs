#include <ansi.h>
#include <weapon.h>

inherit BLADE;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;33m缺口的菜刀[2;37;0m", ({ "dao" }));
	set_weight(9000);
	set("item_make", 1);
	set("unit", "把");
	set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一把刀。
一把双立人的菜刀，质量呱呱叫，只是缺了一个口子。[2;37;0m
");
	set("makeinfo", "[1;31m
萧寒(allun)[1;31m 出品
[2;37;0m");
	set("value", 2100000);
	set("point", 230);
	set("max_consistence", 100);
	set("material", "magic stone");
	set("material_file", "/d/item/obj/butian");
	set("quality_level", 2);
	set("wield_msg", "[1;37m$N随手从背后拿出一把[1;33m缺口的菜刀[1;37m，看着应该是准备[1;31m砍人[1;37m了！[2;37;0m\n");
	set("unwield_msg", "[1;37m$N擦了擦[1;33m菜刀[1;37m上面的[1;32m血迹[1;37m，放回背后。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	init_blade(apply_damage());

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
