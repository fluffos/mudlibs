#include <ansi.h>
#include <weapon.h>

inherit BLADE;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;36m岁月刀[2;37;0m", ({ "syd" }));
  set_weight(1500);
  set("item_make", 1);
  set("unit", "把");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一把刀。
岁月如刀[2;37;0m
");
  set("makeinfo", "[1;31m
帝沫沫(aiw)[1;31m 出品
[2;37;0m");
  set("value", 6100000);
  set("point", 1342);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname");
  set("quality_level", 6);
  set("wield_msg", "岁月如刀[2;37;0m\n");
  set("unwield_msg", "岁月如刀[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_blade(apply_damage());
  set("weapon_prop/add_forget", 2.500000);
  set("weapon_prop/ap_power", 6.000000);

  setup();
}

string long() { return short() + query_makeinfo() + query("long") + item_long(); }
