#include <ansi.h>
#include <armor.h>

inherit FINGER;
inherit F_ITEMMAKE;

void create()
{
	set_name("[5m[33m天龙[35m之[1;37m爪[2;37;0m", ({ "myclaw" }));
	set_weight(3500);
	set("item_make", 1);
	set("unit", "套");
	set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一套指套。
");
	set("makeinfo", "[1;31m
星宿清风(qmg)[1;31m 出品
[2;37;0m");
	set("value", 4100000);
	set("point", 800);
	set("max_consistence", 100);
	set("material", "tian jing");
	set("material_file", "/clone/goods/tianjing");
	set("quality_level", 2);
	set("wear_msg", "[36m尘土飞扬，天龙之爪重现江湖[2;37;0m\n");
	set("remove_msg", "[31m杀人如麻的天龙之爪归位天神。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/unarmed_damage", apply_damage());
	set("armor_prop/armor", 10);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
