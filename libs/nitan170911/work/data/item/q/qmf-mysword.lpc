#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;32m碧水剑[2;37;0m", ({ "mysword" }));
	set_weight(9000);
	set("item_make", 1);
	set("unit", "柄");
	set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
");
	set("makeinfo", "[1;31m
华山清风(qmf)[1;31m 出品
[2;37;0m");
	set("value", 2100000);
	set("point", 400);
	set("max_consistence", 100);
	set("material", "magic stone");
	set("material_file", "/d/item/obj/butian");
	set("quality_level", 2);
	set("wield_msg", "[1;33m随手一挥，一把明晃晃的[1;32m碧水剑[1;33m破空而出[2;37;0m\n");
	set("unwield_msg", "[1;34m挥一挥衣袖，带走了一把[1;32m碧水剑[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	init_sword(apply_damage());

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
