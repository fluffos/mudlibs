#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create()
{
	set_name("[5m[1;32m天天想上[2;37;0m", ({ "myzhang" }));
	set_weight(4500);
	set("item_make", 1);
	set("unit", "双");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一双铁掌。
天天想上[2;37;0m
");
	set("makeinfo", "[1;31m
星宿弟子(qmd)[1;31m 出品
[2;37;0m");
	set("value", 34400000);
	set("point", 1715);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname2");
	set("quality_level", 3);
	set("wear_msg", "[5m[1;33m活到老，学到老，天天想上[2;37;0m\n");
	set("remove_msg", "[5m[1;36m累了，休息会吧[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/unarmed_damage", apply_damage());
	set("armor_prop/armor", 10);
	set("armor_prop/skill", 0);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
