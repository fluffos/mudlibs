#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m帝王[1;31m之剑[2;37;0m", ({ "nsword" }));
  set_weight(15000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一柄剑。
若得杂冶，即成神剑，可以克天下。太公解投冶中，剑成授太公。[2;37;0m
");
  set("makeinfo", "[1;31m
渡楚(naonao)[1;31m 出品
[2;37;0m");
  set("value", 35760000);
  set("point", 1783);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname2");
  set("quality_level", 2);
  set("wield_msg", "[1;37m月盈则亏[1;31m亘古不变[2;37;0m\n");
  set("unwield_msg", "[1;31m月圆转缺[1;37m唯有情殇[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
