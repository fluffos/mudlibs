#include <ansi.h>
#include <armor.h>

inherit FINGER;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[35m王者指[2;37;0m", ({ "kingb" }));
  set_weight(3500);
  set("item_make", 1);
  set("unit", "套");
  set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一套指套。
");
  set("makeinfo", "[1;31m
诺基亚(nokia)[1;31m 出品
[2;37;0m");
  set("value", 4100000);
  set("point", 200);
  set("max_consistence", 100);
  set("material", "tian jing");
  set("material_file", "/clone/goods/tianjing");
  set("quality_level", 6);
  set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/unarmed_damage", apply_damage());
  set("armor_prop/armor", 10);
  set("armor_prop/add_busy", 2.500000);
  set("armor_prop/add_damage", 2.500000);
  set("armor_prop/research_effect", 6);

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
