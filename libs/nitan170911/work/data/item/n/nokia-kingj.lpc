#include <ansi.h>
#include <weapon.h>

inherit STAFF;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[35m王者之杖[2;37;0m", ({ "kingj" }));
  set_weight(15000);
  set("item_make", 1);
  set("unit", "根");
  set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一根杖。
");
  set("makeinfo", "[1;31m
诺基亚(nokia)[1;31m 出品
[2;37;0m");
  set("value", 4100000);
  set("point", 200);
  set("max_consistence", 100);
  set("material", "tian jing");
  set("material_file", "/clone/goods/tianjing");
  set("quality_level", 6);
  set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一根[1;36m$n[1;36m。[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_staff(apply_damage());
  set("weapon_prop/da_power", 2.000000);
  set("weapon_prop/add_damage", 2.500000);
  set("weapon_prop/research_effect", 6);

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
