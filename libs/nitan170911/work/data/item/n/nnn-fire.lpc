#include <ansi.h>
#include <weapon.h>

inherit THROWING;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;36m火折[2;37;0m", ({ "fire" }));
	set_weight(1800);
	set("item_make", 1);
	set("unit", "把");
	set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一把暗器。
[1;33m这是一支用于引火的火折，到了黑暗的地方就用得着了。[2;37;0m
");
	set("makeinfo", "[1;31m
慧邪(nnn)[1;31m 出品
[2;37;0m");
	set("value", 2100000);
	set("base_weight", 18);
	set("base_unit", "枚");
	set("base_value", 1);
	set("point", 100);
	set("max_consistence", 100);
	set("material", "magic stone");
	set("material_file", "/d/item/obj/butian");
	set("quality_level", 2);
	set("hand_msg", "[1;35m一把火苗突然在$n[1;35m上跳出来把你的毛全都点着。[2;37;0m\n");
	set("unhand_msg", "$n[1;32m上的火越烧越旺，你的毛也越烧越少。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set_amount(100);
	init_throwing(apply_damage());

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
