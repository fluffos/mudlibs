#include <ansi.h>
#include <weapon.h>

inherit HAMMER;
inherit F_ITEMMAKE;

void create() {
  set_name("[41;1m[1;37m一套好的神器[2;37;0m", ({ "shenqi" }));
  set_weight(21000);
  set("item_make", 1);
  set("unit", "把");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一把锤。
");
  set("makeinfo", "[1;31m
绿莲老猪(rcdl)[1;31m 出品
[2;37;0m");
  set("value", 2100000);
  set("point", 100);
  set("max_consistence", 100);
  set("material", "magic stone");
  set("material_file", "/d/item/obj/butian");
  set("quality_level", 2);
  set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一把[1;36m$n[1;36m。[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_hammer(apply_damage());

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
