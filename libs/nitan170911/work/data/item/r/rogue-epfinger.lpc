#include <ansi.h>
#include <armor.h>

inherit FINGER;
inherit F_ITEMMAKE;

void create()
{
	set_name("[2;37;0m[35m紫陨扳指[2;37;0m", ({ "epfinger" }));
	set_weight(3500);
	set("item_make", 1);
	set("unit", "套");
	set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一套指套。
[33m此扳指乃夏禹所铸，腹上刻二十八宿面文明星晨，背记山川，藏之会稽山。[2;37;0m
");
	set("makeinfo", "[1;31m
流氓(rogue)[1;31m 出品
[2;37;0m");
	set("value", 35140000);
	set("point", 1752);
	set("max_consistence", 100);
	set("material", "no name");
	set("material_file", "/clone/goods/noname2");
	set("quality_level", 6);
	set("wear_msg", "[37m$N随手一抹，只见一道紫芒闪过，$N手上就多了一只$n[37m。[2;37;0m\n");
	set("remove_msg", "[33m$N随手一振，[35m$n[33m化为点点紫色星光消散，瞬间不见了踪迹。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set("armor_prop/unarmed_damage", apply_damage());
	set("armor_prop/armor", 10);
	set("armor_prop/fatal_blow", 2.000000);
	set("armor_prop/add_blind", 2.000000);
	set("armor_prop/ap_power", 2.000000);
	set("armor_prop/double_damage", 2.000000);

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
