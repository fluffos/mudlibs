#include <ansi.h>
#include <weapon.h>

inherit THROWING;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;31m魔力宝石[2;37;0m", ({ "ruby" }));
	set_weight(1800);
	set("item_make", 1);
	set("unit", "把");
	set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一把暗器。
[1;37m这是一颗通体通透的[1;31m红宝石[1;37m，宝石中间还散发着魔力的光辉。[2;37;0m
");
	set("makeinfo", "[1;31m
远坂凛(rin)[1;31m 出品
[2;37;0m");
	set("value", 2100000);
	set("base_weight", 18);
	set("base_unit", "枚");
	set("base_value", 1);
	set("point", 176);
	set("max_consistence", 100);
	set("material", "magic stone");
	set("material_file", "/d/item/obj/butian");
	set("quality_level", 2);
	set("hand_msg", "$N把[1;31m魔力宝石[2;37;0m放进了自己的宝石袋中。[2;37;0m\n");
	set("unhand_msg", "$N从宝石袋中拿出了一颗[1;31m魔力宝石[2;37;0m。[2;37;0m\n");
	if( !check_clone() ) return;
	restore();
	set_amount(100);
	init_throwing(apply_damage());

	setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
