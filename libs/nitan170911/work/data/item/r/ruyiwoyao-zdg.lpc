#include <ansi.h>
#include <armor.h>

inherit WRISTS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m杰德里奇[2;37;0m", ({ "zdg" }));
  set_weight(500);
  set("item_make", 1);
  set("unit", "对");
  set("long", "这是由[1;35m无名之物[2;37;0m炼制而成的一对护腕。
");
  set("makeinfo", "[1;31m
杜子腾(ruyiwoyao)[1;31m 出品
[2;37;0m");
  set("value", 6100000);
  set("point", 375);
  set("max_consistence", 100);
  set("material", "no name");
  set("material_file", "/clone/goods/noname");
  set("quality_level", 0);
  set("wear_msg", "[33m$N[33m装备[33m$n[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[33m$n[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/claw", 119);
  set("armor_prop/club", 119);
  set("armor_prop/hand", 119);
  set("armor_prop/dagger", 119);
  set("armor_prop/strike", 119);
  set("armor_prop/cuff", 119);
  set("armor_prop/finger", 119);
  set("armor_prop/staff", 119);
  set("armor_prop/sword", 119);
  set("armor_prop/hammer", 119);
  set("armor_prop/stick", 119);
  set("armor_prop/parry", 119);
  set("armor_prop/whip", 119);
  set("armor_prop/unarmed", 119);
  set("armor_prop/blade", 119);

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
