#include <ansi.h>
#include <weapon.h>

inherit XSWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[45;1m几打[2;37;0m", ({ "gucci" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "支");
  set("long", "这是由[36m玄铁[2;37;0m炼制而成的一支箫。
");
  set("makeinfo", "[1;31m
绿莲老猪(rcdl)[1;31m 出品
[2;37;0m");
  set("value", 1500000);
  set("point", 70);
  set("max_consistence", 100);
  set("material", "steel");
  set("material_file", "/d/item/obj/xuantie");
  set("quality_level", 2);
  set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一支[1;36m$n[1;36m。[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_xsword(apply_damage());

  setup();
}

string long() { return short() + query("makeinfo") + query("long") + item_long(); }
