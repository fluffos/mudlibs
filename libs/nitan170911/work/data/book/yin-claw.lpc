#include <ansi.h>

inherit BOOK;
inherit F_NOCLONE;

void create() {
  set_name("「淫爪」", ({ "yin-claw book" }));
  set_weight(500);
  /*
        if( clonep() )
                set_default_object(__FILE__);
        else*/ {
    set("unit", "本");
    set("long", "这是一本用薄绢写成的书。上书：“淫爪”。\n书上署名渡欧(ssyunone)。\n");
    set("value", 1);
    set("auto_load", 1);
    set("material", "silk");
    set("skill", ([
      "name": "yin-claw",
      "exp_required": 100000,
      "jing_cost": 40,
      "difficulty": 100,
      "max_skill": 199,
      "min_skill": 0
    ]));
  }
  setup();
  check_clone();
}
