// Room: /u/shenxian/workroom.c

#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "" HIM "魔域" HIG "桃园" NOR);
  set("long", "
漫步过来，没想道这里居然有间小茅屋。屋子里空空的，没什么摆设，
只是不知哪里传来阵阵幽香，令人精神为之一爽。
    ");
  set("exits", ([ /* sizeof() == 1 */
    "sky": "/u/shenxian/sky",
  ]));
  set("objects", ([
    "/u/shenxian/npc/shenxian": 1,
  ]));
  set("no_clean_up", 0);
  set("valid_startroom", 1);

  setup();
}
void init() {
  object ob = this_player();
  remove_call_out("check");
  call_out("check", 1, ob);
  if (!wizardp(ob)) {
    add_action("block_cmd", "", 1);
  }
  add_action(
    "do_action",
    ({
      "more",
      "call",
      "move",
      "goto",
      "home",
      "smash",
      "uncon",
      "get",
      "whisper",
      "tell",
      "reply",
      "die",
      "zisha",
      "summon",
      "snoop",
      "sleep",
      "kill",
      "pocess",
      "hammer",
      "hammer1",
      "hammer2",
      "slagon",
      "steal",
      "ti"
    })
  );
  add_action("do_sky", "sky");
}
int block_cmd() {
  string verb = query_verb();
  if (verb == "say") return 0;  //allow say
  if (verb == "sky") return 0;
  if (verb == "chat") return 0;
  if (verb == "quit") return 0;
  if (verb == "look") return 0;
  if (verb == "ask") return 0;
  return 1;
}
int check(object ob) {
  if (ob->query("id") == "shenxian" || ob->query("id") == "grief") return;
  message_vision(HIW "$N轻手轻脚的走了过来。\n" NOR, ob);
  return;
}
int do_action(string arg) {
  object ob = this_player();
  if (ob->query("id") == "shenxian" || ob->query("id") == "grief" || ob->query("id") == "meokey") return 0;
  message_vision("$N贼头贼脑的输了些命令! \n", ob);
  return 1;
}
int do_sky() {
  object ob = this_player();
  message_vision(HIY "$N悄悄的往天堂走去,后面传来一个的声音:慢走啊! \n" NOR, ob);
  return 0;
}
