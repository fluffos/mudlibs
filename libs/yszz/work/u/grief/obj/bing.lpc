inherit ITEM;
#include <ansi.h>

void creat()
{
    set_name(HIR"状元饼"NOR,({"bing","zhuangyuan bing"}));
    set("unit",1);
    set("no_get",1);
    set("no_drop","状元饼来之不易,怎么能扔掉呢? \n");
    set("long","状元饼,好好珍惜");
    setup();
}

void owner_is_killed()
{
    destruct(this_object());
}
