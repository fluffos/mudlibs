// This is a room made by roommaker.
//modified by shenxian@YSZZ 2000.10.12

#include <ansi.h>
inherit ROOM;

void create() {
  set("short", RED "垃圾场" NOR);
  set("long", "
一个完全陌生的地方，四周白茫茫一片，什么也看不到，什么
也听不见.空气中散发出一股浓浓的腐臭味.只是偶尔有一两只
寻食的野狗走过.你顺着它们的足迹望去，发现地上似乎有好多
盖子(gaizi).
    ");
  set("item_desc", ([
    "gaizi": "这是一个虚掩着的下水道盖子，好象能从这里钻出去!" ]));
  setup();
}
void init() {
  add_action("do_zuan", "zuan");
  add_action("block_cmd", "", 1);
}

int do_zuan(string arg) {
  object me = this_player();
  if (!arg || ((arg != "xiaoshuidao") && (arg != "下水道")))
    return notify_fail("你要钻什么？\n");
  else {
    if (random(3) == 1) {
      message_vision(HIY "$N找到一个下水道，一下钻了出去。\n\n" NOR, me);
      me->move("/u/city/center");
      message_vision(HIR "\n地上的盖子动了动，$N浑身湿漉漉的钻了出来。\n" NOR, me);
    } else {
      message_vision(HIY "$N往地上钻去，只听嘣的一声，额上多了个包\n\n" NOR, me);
      me->add("kee", -8);
    }
  }
  return 1;
}

int block_cmd() {
  string verb = query_verb();
  if (verb == "chat") return 0;
  if (verb == "zuan") return 0;
  if (verb == "look") return 0;
  if (verb == "chat*") return 0;
  if (verb == "tell") return 0;
  if (verb == "reply") return 0;
  if (verb == "wiz") return 0;
  if (verb == "wiz*") return 0;
  return 1;  //allow chat & zuan
}
