int set_file_header(string file, string *tobeset) {
  string list2;
  int i;

  //    list = explode(read_file(file), "\n");
  //need not read the file just rm them

  for (list2 = "", i = 0; i < 10; i++) {
    list2 += tobeset[i] + "\n";
  }
  write_file(file, list2);
  return 1;
}

int total_file_num(string directory) {
  int number;
  string *dir;
  if (directory = "/data/bbs/leavemsg_towiz")
    dir = get_dir("/data/bbs/leavemsg_towiz/");
  if (directory = "/data/bbs/leavemsg_player")
    dir = get_dir("/data/bbs/leavemsg_player/");
  //the "/" must be added !!!
  number = sizeof(dir);
  return number;
}
