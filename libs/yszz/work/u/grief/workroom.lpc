// Room: /u/ammy/workroom.c
#include <ansi.h>

inherit ROOM;

void create()
{
    set("short", HIY "忘情幽居" NOR);
        set("valid_startroom",1);
    set("long",HIB"
暂无描术
" NOR
	);
	set("no_clean_up", 0);
	set("exits", ([ /* sizeof() == 1 */
  "east" : "/d/wiz/wizroom.lpc",
]));

        set("objects", ([
        "/u/grief/npc/wuqing" : 1,
         ]));
	setup();

}
void init ()
{
                if (!wizardp(this_player()))
{
          add_action("block_cmd","",1);   
           message_vision("$N轻手轻脚的走了过来。\n", this_player());
}
   add_action("do_action", ({"goto", "gg", "summon", "sleep", "home", "snoop", "fight", "hit", "kill", 
"dest", "smash", "fushen", "18mo", "die","slogan2", "zzz", "yawn", "possess"}));
}
int block_cmd()
{
       string verb = query_verb();
       if (verb=="say") return 0; //allow say
       if (verb=="chat") return 0;
       if (verb=="quit") return 0;
       if (verb=="look") return 0;
       return 1;
}
int do_action(string arg)
{
     if((string)this_player()->query("id") != "grief" || (string)this_player()->query("id") != "cqq")      
{
   write("嘻嘻！\n");
   return 1;
 }
 }
