// mybirthday.c
// created by ammy@yszz 12/07/2000
// 用来查看自己或别人的生日!

#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  string id;
  if (!arg) {
    string day, season;
    mapping date;
    date = YSTIME_D->check_time(time());
    season = YSTIME_D->check_season();
    day = date["YEAR"] + date["MONTH"] + date["DAY"] + date["HOUR"];
    day = HIW + "现在是" + day + "! \n" + NOR;
    tell_object(me, day);
    return 1;
  } else if (arg == "-b") {
    /*
	int time;
	string day2;			
        mapping date; 		
        time=me->query("birthday");
        date=YSTIME_D->check_time(time);        
　　　　day=date["MONTH"]+date["DAY"]+date["HOUR"];
        tell_object(me,"你的出生时间是"+day+"\n");
*/
    string day2;
    day2 = YSTIME_D->check_usr_birthday(me);
    tell_object(me, HIM + "你的生日是" + day2 + NOR + "\n");
    return 1;
  } else if (sscanf(arg, "%s -b", id) == 1) {
    object ob;
    string day3;
    id = lower_case(id);
    ob = find_player(id);
    if (!ob) return notify_fail("对不起，没这个玩家 \n");
    if (ob->query("env/no_birthday"))
      if (!wizardp(me))
        return notify_fail("" HIW "呵呵，人家现在不愿意告诉你啊，还是省着点吧!" NOR " \n");

    day3 = YSTIME_D->check_usr_birthday(ob);
    tell_object(
      me,
      HIM + ob->query("name") + "[" + HIC + ob->query("id") + NOR + HIM "]的生日是" + day3 + NOR + "\n"
    );
    return 1;
  } else {
    return notify_fail("" HIY "指令格式:ystime[<id>] <-b>" NOR " \n");
  }

}

int help() {
  write("
指令格式：birthday [<id>] <-b>

此命令用来查看妖神纪年中的出生日期!

");
  return 1;
}
