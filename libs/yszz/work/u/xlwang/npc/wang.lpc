inherit NPC;



void create() {
  set_name("修罗王", ({ "king", "wang" }));
  set("long", "至高无上的修罗王，清高飘逸，战力通神。\n");
  set("gender", "男性");
  set("title", "王者");
  set("age", 27);
  set("con", 100);
  set("per", 100);
  set("str", 100);
  set("int", 100);
  set("combat_exp", 10000000);
  set("chat_chance", 200);

  set_skill("dodge", 800);
  set_skill("force", 800);
  set_skill("parry", 800);
  set_skill("unarmed", 800);
  set_skill("sword", 120);
  set_skill("literate", 800);
  set("max_force", 20000);
  set("force", 20000);
  set("max_mana", 20000);
  set("mana", 20000);
  set("force_factor", 1000);
  set("mana_factor", 1000);
  set("max_kee", 7000);
  set("max_gin", 4000);
  set("max_sen", 5000);

  setup();
  carry_object("/d/obj/book/forcebook2");
  add_money("gold", 500);
}


void destroy(object ob) {
  destruct(ob);
  return;
}


void die() {
  destruct(this_object());
  return;
}
void init() {
  add_action("do_ttt", "ttt");
}

int do_ttt() {
  object me = this_player();
  int time;
  time = time();
  me->interrupt_me();
  return notify_fail(time() + "\n");
}
