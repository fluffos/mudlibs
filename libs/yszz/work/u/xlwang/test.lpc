inherit ROOM;
#include <ansi.h>

int in_ask, can_out, answer;

/************************************************************/

void create() {

  set("short", "异空间");
  set("long", @LONG
  
由于祭法宝造成了时空扭曲,你来到了异空间。只要你以虔诚之心,
回答对了问题，就能离开这里，回到原来的世界。

LONG);

  set("exits", ([ /* sizeof() == 1 */
    "out": "/u/city/center",
  ]));
  set("no_fight", 1);
  set("no_magic", 1);
  set("no_get", 1);
  set("no_drop", 1);
  setup();

}
void init() {
  object *inv;
  int i;
  object me = this_player();
  me->set_temp("in_ask", 0);
  me->set_temp("can_out", 0);

  inv = all_inventory();
  for (i = sizeof(inv) - 1; i >= 0; i--) {
    if (!interactive(inv[i]))
      if (!living(inv[i])) destruct(inv[i]);
  }


  //me->set_temp("answered",0);
  add_action("block_cmd", "", 1);
  add_action("do_answer", "da");
  add_action("do_answer", "huida");
  add_action("do_answer", "answer");
}
int block_cmd(string args) {
  string verb;
  verb = query_verb();
  if (verb == "bian") return 1;
  if (verb == "ji") return 1;
  if (verb == "xiudao") return 1;
  if (verb == "exert") return 1;
  if (verb == "cast") return 1;  //by cjl
  if (verb == "fly") return 1;  //by cjl
  return 0;
}
int do_answer(string arg) {
  object me = this_player();
  int ans;
  if (me->query_temp("in_ask") == 0) return notify_fail("你已经回答了。\n");
  //if ( me->query_temp("answered") == 1 ) return notify_fail("你已经回答了。\n");
  if (!arg) return notify_fail("请你回答一个数字。\n");

  write(CYN "你答道：" + arg + "\n" NOR, this_player());
  if (sscanf(arg, "%d", ans) == 1) {
    me->set_temp("answered", 1);
    if (ans == me->query_temp("answer")) {
      write("答对了,你可以出去(out)了\n", me);
      me->set_temp("in_ask", 0);
      me->set_temp("can_out", 1);
    } else {
      write(" 答错!!!\n", me);
      me->start_busy(5);
      me->set_temp("in_ask", 0);
      me->set_temp("can_out", 0);

    }
  }
  return 1;
}
int valid_leave(object me, string dir) {
  if (me->query_temp("in_ask") == 1)
    return notify_fail("先回答再走！\n");

  if (me->query_temp("can_out") == 0) {
    me->set_temp("in_ask", 1);
    // me->set_temp("answered",0);
    write(" 请回答(da,huida,answer)下面的数字是多少?\n", me);
    switch (random(9)) {
      case 0:
        me->set_temp("answer", 0);

        write("     0000\n", me);
        write("     0  0\n", me);
        write("     0  0\n", me);
        write("     0  0\n", me);
        write("     0000\n", me);
        break;
      case 1:
        me->set_temp("answer", 1);

        write("        0\n", me);
        write("        0\n", me);
        write("        0\n", me);
        write("        0\n", me);
        write("        0\n", me);
        break;
      case 2:
        me->set_temp("answer", 2);

        write("     0000\n", me);
        write("        0 \n", me);
        write("     0000 \n", me);
        write("     0   \n", me);
        write("     0000\n", me);
        break;
      case 3:
        me->set_temp("answer", 3);

        write("     0000\n", me);
        write("        0\n", me);
        write("     0000\n", me);
        write("        0\n", me);
        write("     0000\n", me);
        break;
      case 4:
        me->set_temp("answer", 4);

        write("     0  0\n", me);
        write("     0  0\n", me);
        write("     0000\n", me);
        write("        0\n", me);
        write("        0\n", me);
        break;
      case 5:
        me->set_temp("answer", 5);

        write("     0000\n", me);
        write("     0   \n", me);
        write("     0000\n", me);
        write("        0\n", me);
        write("     0000\n", me);
        break;
      case 6:
        me->set_temp("answer", 6);

        write("     0000\n", me);
        write("     0   \n", me);
        write("     0000\n", me);
        write("     0  0\n", me);
        write("     0000\n", me);
        break;
      case 7:
        me->set_temp("answer", 7);

        write("     0000\n", me);
        write("        0\n", me);
        write("        0\n", me);
        write("        0\n", me);
        write("        0\n", me);
        break;
      case 8:
        me->set_temp("answer", 8);

        write("     0000\n", me);
        write("     0  0\n", me);
        write("     0000 \n", me);
        write("     0  0\n", me);
        write("     0000\n", me);
        break;



    }
    //return ;
  } else {

    return ::valid_leave(me, dir);
  }
  return notify_fail("先回答再走！\n");

}
