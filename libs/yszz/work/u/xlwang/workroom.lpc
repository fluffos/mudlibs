inherit ROOM;

void create() {
  set("short", "修罗居");

  set("long", @LONG


LONG);
  set("exits", ([ /* sizeof() == 2 */
    "west": "/d/wiz/system",
    "north": "/d/wiz/jobroom",
    "sleeve": "/d/wiz/sleeveroom",
    "guest": "/d/wiz/guest",
    "jail": "/d/wiz/punish",
    "kz": "/d/city/kezhan",
    "down": "/d/wiz/wizroom",
  ]));
  set("sleep_room", 1);
  set("objects",
    ([  //sizeof() == 1
    __DIR__ "npc/wang": 1,
    ]));
  setup();
}
void init() {
  object *inv;
  int i;
  if (!wizardp(this_player()))
    add_action("block_cmd", "", 1);
  add_action("do_time", "gettime");
  add_action("do_test", "ttest");
  //         tell_object(this_player(),query("long"));
  inv = all_inventory();
  for (i = sizeof(inv) - 1; i >= 0; i--) {
    if (!interactive(inv[i]))
      if (!living(inv[i])) destruct(inv[i]);
  }
}

