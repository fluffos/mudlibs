/*

        ㈠  巫师内部禁止争吵，有意见可以提出来解决。
        ㈡  在巫师没有被分配任务时，最简单任务就是找出BUG，并修改。
        ㈢  当巫师被玩家污辱人格时，请用其它帐号争吵。
        ㈣  在ＭＵＤ未成熟时，巫师要多监听一些可疑玩家。
        ㈤  巫师一个星期或更长不能上线要说明原因。
        ㈥  在ＭＵＤ做较大变动时，同经过巫师组的同意。
*/

int do_time() {
  object me = this_player();
  int time;
  time = time();
  write(time, me);
  me->interrupt_me();
  return notify_fail(time() + "\n");
}
int do_test() {

  object me = this_player();
  call_other("adm/daemons/cron.lpc", "autosave");
  write("do_test_done\n");
}
private void test() {
  ::reset();
}
