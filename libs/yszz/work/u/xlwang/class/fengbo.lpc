#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  string msg;
  object weapon, weapon2;
  int skill, ap, dp, damage;

  me->clean_up_enemy();
  target = me->select_opponent();

  skill = me->query_skill("fengbo-cha", 1);
  if ((string)me->query("class") != "dragon")
    return notify_fail("你身非水族,无法使出这招!!\n");

  if (!(me->is_fighting())
    || !me->is_fighting(target))
    return notify_fail(HIW "「无尽风波」" NOR + "只能对战斗中的对手使用。\n");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "fork")
    return notify_fail("你使用的武器不对。\n");


  if (skill < 100)
    return notify_fail("你的风波十二叉等级不够, 不能使用「无尽风波」！\n");

  if (me->query("force") < 1000)
    return notify_fail("你的内力不够，无法运用「无尽风波」！\n");

  msg = HIC "$N凝神闭息,将手中" + weapon->name() + HIC "绕了几圈,猛地向对方的兵刃卷去$n。\n";
  message_vision(msg, me, target);

  damage = 10 + random(skill / 2);
  ap = me->query_skill("fork") + 4 * skill;
  dp = target->query_skill("force") + 4;
  if (dp < 1)
    dp = 1;
  if (random(ap) > random(dp)) {
    if (userp(me))
      me->add("force", -50);
    if (objectp(weapon2 = target->query_temp("weapon"))) {
      msg = "$n顿时觉得手臂一麻，手中";
      msg += weapon2->name();
      msg += "脱手而出！\n" NOR;
      message_vision(msg, me, target);

      weapon2->move(environment(me));
    }
    target->receive_damage("kee", damage);
    target->start_busy(4 + random(skill) / 20);
    me->start_busy(1);
  } else {
    if (userp(me))
      me->add("force", -30);
    msg = "可是$n看破了$N的企图，立刻将手中" + weapon2->name() + "舞
得风雨不透，使$N的「无尽风波」没有起到作用。\n" NOR;
    me->start_busy(2);
  }

  return 1;
}
