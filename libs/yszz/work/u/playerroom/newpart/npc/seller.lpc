// waiter.c

inherit NPC;
inherit F_VENDOR;
void create() {
  set_name("赵健", ({ "zhao" }));
  set("gender", "男性");
  set("age", 62);
  set("long",
    "这位店家满脸红光，一身绸服，是绍兴酒家的老板。\n");
  set("combat_exp", 50000000);
  set("attitude", "friendly");
  set_temp("apply/astral_vision", 1);
  set("rank_info/respect", "老店家");
  set("vendor_goods", ([
    __DIR__ "obj/pumpkin": 10,
    __DIR__ "obj/wineskin": 20,
  ]));
  setup();
}
void init() {
  object ob;
  ::init();
  remove_call_out("greeting");
  call_out("greeting", 1, ob);
  add_action("do_vendor_list", "list");
}

void greeting(object ob) {
  switch (random(3)) {
    case 0:
      say("赵健道：这位" + RANK_D->query_respect(ob)
        + "，住黑店．．，哦哦．．不，不，住店吗？\n");
      break;
    case 1:
      say("赵健道：" + RANK_D->query_respect(ob)
        + "，请进请进,早投宿，早起来。\n");
      break;
    case 2:
      say("赵健咳道：这位" + RANK_D->query_respect(ob)
        + "，进来喝几盅小店的绍兴黄酒吧！\n");
      break;
  }
}
