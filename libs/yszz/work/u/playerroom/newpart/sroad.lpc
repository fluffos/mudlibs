inherit ROOM;
void create()
{
        set("short", "泰安南街");
        set("long", @LONG
你走在一条宽阔的石板大街上，街面是由碗口大的彩色石块铺成，南面就快
到城中心了，在这里你能享受到城内少有的清净。彩色石块铺成的大道向四方伸
延。可以看到钟楼耸立于前。
LONG
        );
        set("exits", ([ 
  "north" : __DIR__"center",
  "east" : __DIR__"sarea1",
  "west" : __DIR__"sarea2",
  "south" : __DIR__"pool",
]));
        set("coor/x",10);
        set("coor/y",2000);
        set("coor/z",0);
        setup();
        replace_program(ROOM);
}
