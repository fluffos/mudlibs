inherit ROOM;
void create()
{
        set("short", "泰安东街");
        set("long", @LONG
你走在一条宽阔的石板大街上，街面是由碗口大的彩色石块铺成，西面就快
到城中心了，在这里你能享受到城内少有的清净。彩色石块铺成的大道向四方伸
延。可以看到钟楼耸立于前。南北皆是规模不小的宅院。
LONG
        );
        set("exits", ([ 
  "west" : __DIR__"center",
  "east" : __DIR__"earea1",
]));
        set("coor/x",10);
        set("coor/y",2000);
        set("coor/z",0);
        setup();
        replace_program(ROOM);
}
