inherit ROOM;
void create() {
  set("short", "泰安北街");
  set("long", @LONG
你走在一条宽阔的石板大街上，街面是由碗口大的彩色石块铺成，南面就快
到城中心了，在这里你能享受到城内少有的清净。彩色石块铺成的大道向四方伸
延。可以看到钟楼耸立于前。东西皆是规模不小的宅院。
LONG
  );
  set("exits", ([
    "south": __DIR__ "center",
    "north": __DIR__ "narea1",
  ]));
  set("coor/x", 10);
  set("coor/y", 2000);
  set("coor/z", 0);
  setup();
}
