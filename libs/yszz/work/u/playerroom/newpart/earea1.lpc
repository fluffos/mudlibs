#include "playerroom.h"
inherit ROOM;
void create()
{
        set("short", "泰东一区");
        set("long", @LONG
你已来到了清净整洁的居民小区，西面就是宽阔的石板大街上，街面是由碗
口大的彩色石块铺成，直通城中心。规模不小的宅院竖立在周围。
LONG
        );
        set("exits", ([
"shasha" : __PLAYERROOM__"room/s/shasha/shasha926099899",
"wly" : __PLAYERROOM__"room/w/wly/wly926094418",
"water" : __PLAYERROOM__"room/w/water/water925628947",
"mingming" : __PLAYERROOM__"room/m/mingming/mingming921728286",
"ming" : __PLAYERROOM__"room/m/ming/ming921418110", 
  "west" : __DIR__"eroad",
]));
        set("coor/x",10);
        set("coor/y",2000);
        set("coor/z",0);
