int valid_leave(object me, string dir) {
  if ((dir == "north") && (!wizardp(me))
    && (me->query("id") != "youzi") && (me->query("id") != "dlin"))
    return notify_fail("大天神正在构筑玩家新区,尚未完成,严禁通行!\n");
  return 1;
}
