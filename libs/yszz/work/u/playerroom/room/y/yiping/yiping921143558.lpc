// a skeleton for user rooms
#include <ansi.h>
#include "playerroom.h"
#define X_COOR 10
#define Y_COOR 2000
#define Z_COOR 0
#define R_FLAG 2063
#define OWNER "yiping"
inherit ROOM;
void create()
{
	set("short", "修罗殿");
	set("long", @LONG
创造神的继承人--修罗王一平修炼的居所.
修罗王一平这几年在风云城中声名鹊起,这是与他勤恳修炼
分不开的.看,墙上挂着几幅港台明星大美女的画,比较...,用来
修炼"忍"术的.不过他现在不在练功,只见一个人趴在一台电脑
前猛敲键盘,一边唱着"不到当机誓不休..",原来是玩mud,这是
他休息的方式噢,一平很少mud,他只在不停电时时才玩的,现在
大家知道一平是个很不错的人吧,xixi.

LONG
	);
	set("objects", ([ ]));
	set("no_magic", 1);
	set("room_flag", 2063);
	set("exits", ([ /* sizeof() == 1 */
  "outyiping" : "/u/playerroom/newpart/sarea2",
]));
	set("NONPC", 1);
	set("class", "朝廷");
	set("coor", ([ /* sizeof() == 3 */
  "x" : 10,
  "y" : 2000,
  "z" : 0,
]));
	set("owner", "yiping");
	set("valid_startroom", 1);
	set("no_fight", 1);
	set("no_clean_up", 0);
	setup();
}
void init()
{
	int flag;
	flag = (int) query("room_flag");
	if(flag & 1) set("valid_startroom",1);
	if(flag & 2) set("NONPC",1);
	if(flag & 4) set("no_fight",1);
        if(flag & 8) set("no_magic",1);
	if(flag & 16) set("outdoors","residence");
	add_action("do_invite","invite");
	add_action("do_setowner","setowner");
         add_action("do_sleep","sleep");
}
int valid_enter(object me)
{
	int flag;
// always let owner go in:
        flag = (int) query("room_flag");
        if((string)me->query("id") == (string)query("owner"))
	return 1;
	if(flag & 512)
	if((string)me->query("id") != (string)query("owner"))
	return 0;
	if(flag & 1024)
        if((string)me->query("class") != (string)query("class"))
        return 0;
	if(flag & 2048)	
	if((string)query("invite") != (string)me->query("id"))
	return 0;	
	return 1;
}
int do_invite(string arg)
{
	object me;
	me= this_player();
	if((string)me->query("id") != (string)query("owner"))
	return 0;
	set("invite",arg);
	write("你邀请"+arg+"来你的房间。\n");
	return 1;
}

int do_setowner(string arg)
{
	string oldowner;
	oldowner = (string)query("owner");
	set("owner",arg);
	write("你将房间的主人暂时设为"+arg+"。\n");
	call_out("set_back",60, oldowner);
	return 1;
}

int set_back(string oldowner)
{
	set("owner", oldowner);
	return 1;
}
int do_sleep(string arg)
{
   object me;
   int gin, kee, sen;

   me = this_player();

   if (me->is_fighting()) return 1;

   if (me->query("id")=="yiping") {
      message_vision("$N揉揉眼、打个哈欠，躺到了床上，", me);
      tell_object(me, "很快你就觉的睡意朦胧。\n");
      message("vision", me->name()+"翻了几个身，找到个舒适的姿势，很快就进入了梦乡。\n", environment(me), me);
      gin = (int) me->query("eff_gin");
      kee = (int) me->query("eff_kee");
      sen = (int) me->query("eff_sen");
      me->set("gin", gin);
      me->set("kee", kee);
      me->set("sen", sen);
      me->set_temp("disable_inputs",1);
      me->set_temp("block_msg/all",1);
      me->set_temp("is_unconcious",1);
      me->set("disable_type",HIG "<睡梦中>" NOR);

      call_out("wake", 11, me);
      return 1;
   }   
   else {
      message_vision("只有房子的主人才能在这休息\n", me);
      return 1;
   }
   return 1;
}

void wake(object me)
{
   me->delete_temp("disable_inputs");
   me->delete("disable_type");
   me->delete_temp("block_msg/all");
   me->delete_temp("is_unconcious");
   if(!me->is_ghost())
   message_vision("$N睁开了眼睛，一个鲤鱼打挺从床上跳了下来。\n", me); 
   tell_object(me, "你觉得精神好了很多。\n");

}

