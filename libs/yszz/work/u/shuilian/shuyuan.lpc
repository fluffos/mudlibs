// Room: /d/shuilian/shuyuan
inherit ROOM;
#include <ansi.h>

string *strs = ({
  " 君不见黄河之水天上来，奔流到海不复回  \n",
  " 君不见高堂明镜悲白发，朝如清丝暮成雪   \n",
  " 人生得意须尽欢，莫使金樽空对月         \n",
  " 天生我材必有用。千金散失还复来         \n",
  " 烹羊宰牛且为乐，会须一饮三百杯      \n",
  " 岑夫子，丹丘生，将进酒，君莫停      \n",
  " 与君歌一曲，请君为我侧耳听        \n",
});

void init();
void check_time(object where);
void dushu(object where);
void finish_dushu(object where);

void create() {
  set("short", "[0;36m书院[m");
  set("long", @LONG
   这就是水帘洞的小猴们读书的地方,也许是因为猴子家族
以前很少有会咬文嚼字的,所以孙大圣取经回来后,就规定
了每天必须读书的规矩. (dushu)
LONG);

  set("exits", ([ /* sizeof() == 1 */
    "north": __DIR__ "studyroom",
  ]));
  set("objects", ([ /* sizeof() == 3 */
    __DIR__ "npc/xiaohou": 1,
  ]));
  set("light_up", 1);

  setup();
}

void init() {
  remove_call_out("check_time");
  check_time(this_object());
  add_action("do_dushu", "dushu");
}

void check_time(object where) {
  mixed *local = localtime((time() - 900000000) * 60);
  int t = local[2] * 60 + local[1];
  int phase = ((int)(t / 120));

  if (phase == 3 && (!query("shuilian/start_dushu"))) dushu(where);
  if (phase == 5 && query("shuilian/start_dushu")) finish_dushu(where);
  call_out("check_time", 60, where);
}

void dushu(object where) {
  message("channel:es", HIG "【水帘洞】读书小猴(little monkey)：孩儿们，回来读书拉！\n" + NOR, users());
  where->set("shuilian/start_dushu", 1);
}

int do_dushu() {
  object who = this_player();

  if (who->is_busy())
    return notify_fail("你正忙着呢。\n");
  if (!this_object()->query("shuilian/start_dushu"))
    return notify_fail("还不到读书的时候呢。\n");
  if ((string)who->query("family/family_name") != "水帘洞")
    return notify_fail("外派弟子不得来此读书。\n");
  tell_object(who, "你低眉垂目，口中微颂：" + strs[random(sizeof(strs))]);
  who->start_busy(5);
  if ((int)who->query("faith") < 300 && who->query("combat_exp") < 100000)
    who->add("faith", 1);
  who->ichatrove_skill("mihouxinjing", random((int)(who->query("spi") + who->query("int")) / 2), 1);
  who->add("combat_exp", 12);
  who->add("potential", 3);
  who->receive_damage("kee", 20);
  who->receive_damage("sen", 20);
  tell_object(who, "你觉得弥猴心经进步了！\n");
  return 1;
}

void finish_dushu(object where) {
  tell_object(where, "只见室外一个猴子敲着铃铛，应该下课拉。\n");
  where->delete("shuilian/start_dushu");
}
