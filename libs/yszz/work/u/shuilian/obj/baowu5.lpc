/* <SecCrypt CPL V3R05> */
//蓝桃、青桃、紫桃、绿桃、黄桃、红桃 
inherit ITEM;

void create()
{
        set_name("[1;33m黄桃[m", ({"huang tao"}));
        set_weight(8);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一个异常奇怪的桃\n");
                set("unit", "个");
                set("shuilianbao","fake");
        }
}

