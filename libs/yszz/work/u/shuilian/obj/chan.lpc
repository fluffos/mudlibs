// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */
#include <weapon.h>
inherit STICK;
void create() {
  set_name("锅铲", ({ "chan" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("no_get", 1);
    set("value", 50);
    set("material", "wood");
    set("wield_msg", "$N把$n握在手中．\n");
  }
  init_stick(10);
  setup();
}
void init() {
  add_action("do_cook", "cook");
}
int do_cook(string arg) {
  object me = this_player();
  string env;
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");
  if (!me->query("shuilian/cook"))
    return notify_fail("您来做饭?别开玩笑了.\n");
  if (!arg && arg != "meal")
    return notify_fail("你要做什么？\n");
  env = environment(me)->query("short");
  if (env != "[0;32m厨房[m")
    return notify_fail("你是不是生病了,这里能做饭吗?\n");
  if ((int)me->query("kee") < 80)
    return notify_fail("你太累了，歇歇吧！\n");
  message_vision("$N提着锅铲就在厨房里忙活起来了.\n", me);
  write("只一会的工夫,一盘香喷喷的麻辣鸡丝出现在你面前\n");
  write("又一段时间后,一盘让你掉口水的红烧大虾端了上来\n");
  call_out("finish_cook", 5, me);
  me->start_busy(8);
  return 1;
}
void finish_cook(object ob) {
  object me = ob;
  object where = environment(me);
  message_vision("$N得意洋洋的说:怎么样不错吧.\n",
    me);
  me->receive_damage("kee", 60);
  me->delete("shuilian/cook");
  tell_object(me, "你觉得在劳累之余也有所收获。\n");
  tell_object(me, "你的基本杖法提高了\n");
  me->improve_skill("stick", random(me->query("int")), 1);

  me->add("faith", 1);
  me->add("combat_exp", 8);
  me->add("potential", 3);
}
