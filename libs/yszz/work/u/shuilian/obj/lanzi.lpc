// Room: /d/heimuya/basket.c

inherit ITEM;
void create() {
  set_name("篮子", ({ "basket" }));
  set_weight(1000);
  set("no_get", 1);
  set("unit", "把");
  set("value", 50);
  set("material", "wood");
  set("wield_msg", "$N把$n握在手中．\n");

  setup();
}
void init() {
  add_action("do_pick", "pick");
}
int do_pick(string arg) {
  object me = this_player();
  string env;
  if (!me->query("shuilian/zhaitao"))
    return notify_fail("你真的是来摘桃的吗?我看你象是来偷桃的!\n");
  if (!arg && arg != "tao")
    return notify_fail("你要摘什么？\n");

  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");
  env = environment(me)->query("short");
  if (env != "[0;33m桃树林[m")
    return notify_fail("这有桃子给你摘吗？\n");
  if ((int)me->query("kee") < 80)
    return notify_fail("你太累了，歇歇吧！\n");
  message_vision("$N爬到一棵桃树上，挑了些上等的桃子放金了篮子里.\n", me);
  me->start_busy(8);
  call_out("zhai1", 2, me);
  call_out("zhai2", 4, me);
  call_out("finish_zhai", 8, me);
  return 1;
}
void zhai1(object me) {
  message_vision("$N擦了擦头上的汗水，继续摘了起来。\n", me);
}
void zhai2(object me) {
  message_vision("$N歇了一会儿.躺在树上，看着满树的桃子，不禁笑了起来.n",
    me);
}
void zhai3(object me) {
  message_vision("快要结束了，$N顾不得擦头上的汗水，迅速的摘着\n", me
  );
}
void finish_zhai(object me)

{
  object where = environment(me);

  me->delete("shuilian/zhaitao");
  tell_object(me, "你觉得在劳累之余也有所收获。\n");
  tell_object(me, "你的经验和基本轻功提高了。\n");
  me->improve_skill("dodge", random(me->query("int")), 1);
  me->add("faith", 1);
  me->add("combat_exp", 9);
  //   me->add("potential",2);
  me->add("kee", -50);
}
