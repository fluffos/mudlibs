// daodejing.c

inherit ITEM;
void init();
void create()
{
        set_name( "【水帘洞天】", ({ "houbook" }));
        set_weight(200);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "本");
                set("long", "这是一册【水帘洞天】.\n");
                set("value", 500);
                set("no_sell", 1);
                set("material", "paper");
                set("skill", ([
                        "name": "literate",       // name of the skill
                        "exp_required": 10,   // minimum combat experience required
                        "sen_cost":    20+random(20),
                      "difficulty":   25, 
                        "max_skill":    100      // the maximum level you can learn
                ]) );
        }
}


void init()
{
    add_action("do_read", "read");
    add_action("do_read", "study");
}

int do_read(string arg)
{
    object me=this_player(), book=this_object();
    if (!id(arg)) return 0;
    if ( me->query("family/family_name") != "水帘洞")
    {
        tell_object(me, "你只看见书上画了几个小猴子，根本没有什么好读的。\n");
        return 1;
    }
    return 0;
}
