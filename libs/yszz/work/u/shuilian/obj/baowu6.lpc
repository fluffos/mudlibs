//蓝桃、青桃、紫桃、绿桃、黄桃、红桃
// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

inherit ITEM;

void create() {
  set_name("[1;31m红桃[m", ({ "hong tao" }));
  set_weight(8);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一个异常奇怪的桃\n");
    set("unit", "个");
    set("shuilianbao", "fake");
  }
}
