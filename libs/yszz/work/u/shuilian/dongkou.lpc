//happ
inherit ROOM;

void create() {
  set("short", "[33m水帘洞洞口[m");
  set("long", @LONG

        走到水帘洞的洞口，你惊呆了，有诗为证：

        一派白虹起，千寻雪浪飞。
        海风吹不断，江月照还依。
        冷气分青嶂，余流润脆微。
        潺橼名瀑布，真似挂联帷。
LONG);
  set("exits", ([
    "east": __DIR__ "tbridge",
    "enter": __DIR__ "cave1",
  ]));
  set("objects", ([
    __DIR__ "npc/guard2": 1,
    __DIR__ "npc/zhangmen": 1,
  ]));
  set("outdoors", "shuilian");
  setup();
}

void init() {
  object *inv;
  int i;

  inv = all_inventory();
  for (i = sizeof(inv) - 1; i >= 0; i--) {
    if (!interactive(inv[i]))
      if (!living(inv[i])) destruct(inv[i]);
  }

  add_action("do_none", "get");
  add_action("do_none", "ji");
  add_action("do_none", "steal");
  add_action("do_none", "put");
  add_action("do_none", "drop");
}

int do_none() {
  object zm = present("qitian xiaosheng");

  if (zm) {
    message_vision("$N对$n摇了摇头。\n", zm, this_player());
    return 1;
  }
  return 1;
}
int valid_leave(object me, string dir) {
  object map;

  if (dir == "enter" && !(map = present("raincoat", me)))
    return notify_fail("这么大的水，你就这样进去。。。？\n");
  if (me->query_temp("in_guard"))
    return notify_fail("你正在守值，不能离开!\n");
  return ::valid_leave(me, dir);
}
