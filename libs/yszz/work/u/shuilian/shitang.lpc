int valid_leave(object me, string dir)
{
        if (( present("tao", me)||present("putao", me))
        &&objectp(present("monkey", environment(me))) )
        return notify_fail
        ("猴师傅一把拽住你的衣领，说道：外面的桃都吃不玩，你还带走干嘛？\n");
        return ::valid_leave(me, dir);
}
