// worker.c

inherit NPC;

void create() {
  set_name("看门猴", ({ "guard" }));
  set("gender", "男性");
  set("age", 13);
  set("long", "一个小猴子，每天负责在洞口迎接远道而来的客人．\n");
  set("combat_exp", 200);
  set("attitude", "friendly");
  set_skill("dodge", 10);
  set("per", 30);
  set("max_kee", 150);
  set("max_gin", 150);
  set("max_sen", 150);
  setup();
}
void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()
    && !this_player()->query("env/invisibility")) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_volunteer", "volunteer");
}

void greeting(object ob) {
  if (!ob || !present(ob, environment(this_object()))) return;
  say("小猴说道：这位" + RANK_D->query_respect(ob) +
    "，欢迎到我们水帘洞来,记得要带雨衣来哦(raincoat)！\n");
}

int do_volunteer() {
  object me = this_player();
  object *ob;
  int i;

  if ((string)me->query("family/family_name") != "水帘洞")
    return notify_fail("您不是本门中人.\n");
  if (me->query("faith") > 500)
    return notify_fail("您是本门大有名望之人，怎敢有劳您做看门这样的杂务呢？");
  if (time() - me->query("last_volunteer_time") < 300)
    return notify_fail("才刚值过,你怎么又来了?歇歇吧.\n");
  if (me->query_temp("in_guard"))
    return notify_fail("小猴对你说；看门的时候不要三心二意啊！\n");
  ob = users();
  for (i = sizeof(ob); i > 0; i--) {
    if (ob[i - 1]->query_temp("in_guard"))
      return notify_fail("小猴对你说：已经有人看门了，你一会再来吧。\n");
  }
  tell_object(me, "那好，就请你守一会儿山门吧。\n");
  tell_room(environment(me), me->query("name") + "开始在水帘洞洞口值守拉. \n");
  me->set_temp("in_guard", "1");
  me->set("last_volunteer_time", time());
  me->save();
  remove_call_out("end_guard");
  call_out("end_guard", 70, me);
  call_out("clone_meng", 20, me);
  return 1;
}
void clone_meng(object me) {
  object ob;
  tell_room(environment(me), "不知从哪突然冲上来一伙蒙面大汉。\n");
  ob = new("/d/lingtai/npc/mengmian.lpc");
  ob->set("combat_exp", me->query("combat_exp"));
  ob->move("/u/shuilian/dongkou");
  call_out("clone_meng", 20, me);
}
void end_guard(object me) {
  int reward = me->query("combat_exp") / 5000;
  object yao;

  me->delete("guard");
  me->add("faith", 2 + random(4));
  me->add("combat_exp", 100 + random(reward));
  me->add("potential", 30 + random(reward / 4));
  me->delete_temp("in_guard");
  me->save();
  remove_call_out("clone_meng");
  tell_room(environment(me), me->query("name") + "在水帘洞洞口值守期已满。\n
");
  tell_object(me, "你在水帘洞洞口值守期已满。\n");
  while (yao = present("dahan", environment(me))) {
    tell_object(me, "只见蒙面大汉呼啸而去，很快消失在远方。\n");
    destruct(yao);
  }
}
void die() {
  object *me;
  int i;

  me = users();
  for (i = 0; i < sizeof(me); i++)
    me[i]->delete_temp("in_guard");

  ::die();
}
