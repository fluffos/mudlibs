// tea_waiter.c
string ask_cook();
inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("猴师傅", ({ "monkey" }));
  set("gender", "男性");
  set("age", 40);
  set("long",
    "这个家伙整天就呆在这，无所事事。\n");
  set("combat_exp", 5000);
  set("attitude", "friendly");
  set("inquiry", ([
    "做饭": (: ask_cook :),
  ]));
  setup();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(2)) {
    case 0:
      say("猴师傅笑咪咪地说道：这位" + RANK_D->query_respect(ob)
        + "，进来吃个桃子吧！\n");
      break;
    case 1:
      say("猴师傅说道：这位" + RANK_D->query_respect(ob)
        + "，请进请进。\n");
      break;

  }

}

string ask_cook() {
  object who = this_player();
  if ((string)who->query("family/family_name") != "水帘洞")
    return ("您不是本门中人。");
  if (who->query("faith") > 200 || who->query("combat_exp") > 100000)
    return ("您是本门中大有名望之人，不须做这些杂务。");
  who->set("shuilian/cook", 1);
  return ("让咱们也尝尝您的手艺.");
}
