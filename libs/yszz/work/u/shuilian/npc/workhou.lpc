// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

// worker.c

inherit NPC;

string ask_zhaitao();

void create() {
  set_name("摘桃小猴", ({ "worker" }));
  set("gender", "男性");
  set("age", 19);
  set("long", "一个小道，正在摘桃");
  set("combat_exp", 1000);
  set_skill("stick", 20);
  set_skill("dodge", 40);
  set("attitude", "friendly");

  set("inquiry", ([
    "摘桃": (: ask_zhaitao :),
  ]));
  setup();
  carry_object("/u/shuilian/obj/lanzi")->wield();
}

string ask_zhaitao() {
  object me = this_player();
  if ((string)me->query("family/family_name") != "水帘洞")
    return ("您不是本门中人。");
  if (me->query("kee") < 80)
    return ("你还是先去休息休息吧！");
  if (me->query("faith") > 200 || me->query("combat_exp") > 100000)
    return ("您是本门大有名望之人，怎敢有劳您做这种杂务呢？");
  me->set("shuilian/zhaitao", 1);
  return ("这样,就麻烦你去摘了（pick tao）。");
}
