void upgrade_title(object me, string arg);
string expell_me(object me);
string clear_title(string arg);
int ask_me();
inherit NPC;
inherit F_MASTER;
void create() {
  set_name("芭将军", ({ "ba jiangjun", "ba" }));
  set("gender", "男性");
  set("age", 50);
  set("long", "一只身强体壮的大马猴。\n");
  set("combat_exp", 900000);
  set("attitude", "peaceful");
  set("str", 40);
  set_skill("spells", 80);
  set_skill("houquan", 100);
  set_skill("jindouyun", 100);
  set_skill("unarmed", 80);
  set_skill("dodge", 110);
  set_skill("parry", 80);
  set_skill("literate", 10);
  set_skill("force", 100);
  set_skill("stick", 100);
  set_skill("qitian-gun", 100);
  set_skill("mihouxinjing", 100);
  set_skill("spells", 100);
  set_skill("mihou-force", 100);
  map_skill("force", "mihou-force");
  map_skill("spells", "mihouxinjing");
  map_skill("dodge", "jindouyun");
  map_skill("unarmed", "houquan");
  map_skill("stick", "qitian-gun");
  set("per", 10);
  set("max_kee", 600);
  set("max_gin", 1000);
  set("max_sen", 3000);
  set("max_force", 4000);
  set("force", 4000);
  set("max_mana", 2000);
  set("mana", 2000);
  set("force_factor", 20);
  set("inquiry", ([
    "叛师": (: expell_me :),
    "指点武功": (: ask_me :)
  ]));

  set("chat_msg_combat", ({
    (: cast_spell, "fenshen" :),
    (: cast_spell, "tao" :),
  }));

  setup();
  create_family("水帘洞", 3, "护法将军");

}
#include "/daemon/class/houyao/title.h"
