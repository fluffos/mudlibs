#include <ansi.h>

inherit NPC;

void create()
{
        set_name("看门猴", ({
                "guard",
                "monkey",
        }));
        set("long",
        "一个凶神恶煞一般的猴子。\n"
        );

        set("gender", "男性");
        set("attitude", "peaceful");
        set("class", "houyao");

        set("age", 40);
        set("shen_type", 1);
        set("str", 25);
        set("int", 20);
        set("con", 20);
        set("per", 15);
        set("max_kee", 500);
        set("max_gin", 300);
        set("force", 500);
        set("max_force", 500);
        set("jiaji", 50);
        set("combat_exp", 100000);
        set("score", 1);

        set_skill("force", 50);
        set_skill("dodge", 50);
        set_skill("unarmed", 50);
        set_skill("parry", 50);


        setup();
//
  //      carry_object("/d/shaolin/obj/jiedao")->wield();
//      carry_object(__DIR__"obj/cloth")->wield();
}

void init()
{
        object me, ob;
        mapping fam;

        ::init();

        ob = this_player();
        me = this_object();
        
        if (interactive(ob) 
        && !environment(ob)->query("no_fight")
        && !present("tuijian xin", ob) 
        && ( (fam = ob->query("family")) && fam["family_name"] != "水帘洞" ) )
        {
                if( !ob->query_temp("warned") ) {
                        command("say 你是谁？  怎么闯到水帘洞来了？！");
                        command("say 快给我速速离开，下次看到决不轻饶！");
                        ob->set_temp("warned", 1);
                }
                else if( ob->query_temp("stay") < 10 ) ob->add_temp("stay", 1);
                else {
                        command("say 何方妖怪，竟敢闯到水帘洞里来撒野！！！\n");
                        me->set_leader(ob);
                        remove_call_out("kill_ob");
                call_out("kill_ob", 1, ob); 
                }
        }       

}
