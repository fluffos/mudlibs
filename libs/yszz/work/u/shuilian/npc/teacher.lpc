inherit NPC;

string ask_book();

void create() {
  set_name("猴先生", ({ "hou", "teacher" }));
  set("gender", "女性");
  set("age", 18);
  set("long",
    "活灵活现的一个母猴！她会教你读书写子哦\n");

  set("attitude", "friendly");

  set("per", 30);
  set("str", 30);
  set("combat_exp", 2000);
  set("max_kee", 300);
  set("max_sen", 300);
  set_skill("literate", 200);
  create_family("水帘洞", 3, "管账猴妖");

  set("env/wimpy", 40);
  set("book_count", 1);
  set("count", 1);
  set("inquiry", ([
    "读书识字": (: ask_book :),
  ]));
  setup();
}

string ask_book() {
  mapping fam;
  object ob;

  fam = this_player()->query("family");
  if (!fam || fam["family_name"] != "水帘洞")
    return RANK_D->query_respect(this_player()) + "你是哪路高人，来问本门派的宝贝。";
  if (query("book_count") < 1)
    return "你来晚了，书已经被别人拿走拉。";
  add("book_count", -1);
  ob = new("/u/shuilian/obj/houbook");
  ob->move(this_player());
  return "好吧，这本【水帘洞天】你拿回去好好研读。";
}
