inherit ROOM;

void create()
{
        set("short","[0;33m迷宫外[m");
        set("long", @LONG

        走了半天，你终于走出了那片该死的桃树林，现在
你一看到桃子就觉得恶心，不过现在呈现在你眼前的是另外
一番景色。有诗为证：

    　　千峰开戟，万仞开屏。日映岚光轻锁翠，
        雨收黛色冷含青。枯藤缠老树，古渡界幽程。
        奇花瑞草，修竹乔松。修竹乔松，万载常青欺福地

LONG);

        set("exits",([
               "west":         __DIR__"dong",
"east":__DIR__"mg10",
]));
      set("objects",([
                __DIR__"npc/guard": 1,
]));
        set("no_magic",1);
        set("no_fight",1);
        set("outdoors","shuilian");
        set("no_kill",1);
setup();
}

int valid_leave(object me, string dir)
{
object map;
mapping fam;
     if( dir == "west" && !(map=present("letter", me)) ) {
        return notify_fail("猴守卫大喝一声：没有推荐信不准进去！\n");
        }
     
        return ::valid_leave(me, dir);
}
