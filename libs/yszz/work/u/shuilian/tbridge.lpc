inherit ROOM;

void create() {
  set("short", "[0;32m铁板桥[m");
  set("long", @LONG
     一座铁制的桥，桥的前面落下一幕瀑布，水溅在了你的身上，
水声绵绵不绝于耳，桥的两侧是一些绳子做成的扶手，摇摇晃晃的
，你向旁边看了一眼，似乎想看看桥下的景色。

LONG);
  set("outdoors", 1);
  set("exits", ([
    "east": "/d/4world/houshan2",
    "west": __DIR__ "dongkou",
  ]));
  setup();
}
void init() {
  add_action("do_jump", "jump");
}
int do_jump(string arg) {
  object me = this_player();
  if (!arg || arg != "down") {
    return notify_fail("你要向哪跳？\n");
  }

  if (me->query("cor") <= 20)
    return notify_fail("你看了看湍急的瀑布，不禁倒退了几步。\n");
  {
    message_vision("$N纵身一跃，跳进了水中。\n", me);
    me->move("/d/sea/under3");
  }
  return 1;
}
