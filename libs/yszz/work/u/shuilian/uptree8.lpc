// Room:   /u/shuilian/uptree.c

inherit ROOM;
void init();
#include <ansi.h>
#include "dec.h"

void create()
{
        set("short","[1;32m树上[m");
        set("long", @LONG

[33;1m………… 这里到处都是水果 ……… [m，旁边还有一棵树，你可以试
着跳过去。
LONG);
        set("objects",([
                "/clone/food/fruit": 3,
]));
setup();
}

void init()
{
        add_action("do_jump","jump");
}

int do_jump(string arg)
{
        object me = this_player();
        if( me->is_busy() )
                return notify_fail("你现在还挂在树上呢！\n");
        
   if( !arg || (arg != "west" && arg != "east" && arg != "north" && arg != "south") )
   {
     return notify_fail("你要往哪跳？\n");
   }
  if( arg == "north" )
   {
     message_vision( MAG "$N双手抓着树枝，向"+direction_name(arg)+"掠了过去。\n"NOR, me);
     me->move(__DIR__"uptree6");
   }   
else if ( arg == "west" ) {
    message_vision( MAG "$N双手抓着树枝，向"+direction_name(arg)+"掠了过去。\n"NOR,me);
     me->move(__DIR__"uptree3");
   }
else if ( arg == "south" ) {
    message_vision( MAG "$N双手抓着树枝，向"+direction_name(arg)+"掠了过去。\n"NOR,me);
        me->move(__DIR__"uptree9");
  }
   else return notify_fail( "往"+direction_name(arg)+"什么也没有，看来你要摔死了.............\n" );
        ( (int)me->query_skill("dodge") < 80  ?
me->improve_skill("dodge",1) : me->improve_skill("dodge",0));
  message_vision("$N抓着树枝从"+direction_rev(arg)+"荡了过来，样子神气极了。\n", me);
me->start_busy(2);
me->add("kee",-30);
   return 1;
}
