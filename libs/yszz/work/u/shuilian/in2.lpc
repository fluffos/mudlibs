//happ
#include <ansi.h>
inherit ROOM;
void check_time(object where);
void feel_hungry(object where);
void feel_full(object where);
int do_serve();

void create() {
  set("short", "[33m齐天大圣居[m");
  set("long", @LONG

　　刮风有处躲，下雨好存身。霜雪全无惧，雷声永不闻。
　　烟霞常照耀，祥瑞每蒸熏。松竹年年秀，奇花日日新。

LONG);


  set("exits", ([
    "south": __DIR__ "in1",
  ]));
  set("objects", ([
    "/d/4world/npc/mihou.lpc": 1,
  ]));

  setup();
}
void init() {
  object where = this_object();
  remove_call_out("check_time");

  check_time(where);
  add_action("do_serve", "serve");
}

void check_time(object where) {
  mixed *local = localtime(time() * 60);
  int t = local[2] * 60 + local[1];
  int phase = ((int)(t / 120));
  if ((phase == 5) && (!query("hungry"))) feel_hungry(where);
  if ((phase == 6) && query("hungry")) feel_full(where);
  call_out("check_time", 60, where);
}
void feel_hungry(object where) {
  message("channel:es", HIG + "【水帘洞】六耳猕猴(Liuer mihou)：孩儿们,大圣饿了,怎么没人来服务?\n" + NOR, users());
  set("hungry", 1);
}
void feel_full(object where) {
  tell_object(where, "六耳猕猴拍拍你的肩膀：不错嘛\n");
  set("hungry", 0);
}
int do_serve() {
  object me = this_player();
  if (me->is_busy())
    return notify_fail("你正忙着呢。\n");
  if (!query("hungry"))
    return notify_fail("六耳猕猴说道：我现在不想吃东西\n");
  if ((string)me->query("family/family_name") != "水帘洞")
    return notify_fail("六耳猕猴对你说道：不敢劳您大驾。\n");
  if (me->query("faith") > 400 || me->query("combat_exp") > 100000)
    return notify_fail("你在道上的修为已经足够高，不用再听讲了。\n");
  tell_object(me, "你赶忙爬到桃树上，选了几个上等的仙桃给六耳猕猴奉上。\n");
  me->start_busy(5);
  me->add("faith", 2);
  me->add("combat_exp", 60);
  me->add("potential", 20);
  me->receive_damage("kee", 20);
  me->receive_damage("sen", 20);
  return 1;
}
