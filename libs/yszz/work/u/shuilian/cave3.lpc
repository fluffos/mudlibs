void init()
{
        add_action("do_move", "move");
}


int do_move(string arg)
{
        object me=this_player();
        if( !arg || arg != "table" ) {
                return notify_fail("你要移动什么？\n");
        }

                {
                message_vision("$N站在石前，双掌发力推动石桌，只听得石桌吱吱连声
，\n",this_player());
                message_vision("缓缓向后移去，现出一道门户来。\n", this_player()
);
