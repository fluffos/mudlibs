#include <ansi.h>

inherit ROOM;
void init();
void create()
{
        set("short","[0;33m桃树林[m");
        set("long", @LONG

这儿错落有秩的排列着一行桃树,树上垂着许多有红有甜的仙桃,看着,
看着,你不禁发觉自己的口水已经留出很多了哦,如果你有篮子的话,可
以来摘桃(pick tao)，如果你想上去看看，就爬上去吧（climb up），
旁边还有一个牌子，你可以看看上面写的什么。（paizi)
LONG);

set("item_desc",(["paizi":"
                从此爬上去就到了 ★ 处，
                       [32m ☆ [1;31m ★ [0;32m ☆
                            ☆  ☆
                        ☆  ☆  ☆
                        ☆  ☆  ☆
                        ☆[m \n
              "  ]));
  set("exits",([     
        "north" : __DIR__"shitang",
]));
 set("objects", ([                 
__DIR__"npc/workhou":1,
__DIR__"obj/lanzi":1,
]));
setup();
   }

void init()
{
        add_action("do_climb","climb");
}

int do_climb(string arg)
{
        object me = this_player();
        if( me->query("family/family_name") != "水帘洞")
                 return notify_fail("你不是猴子，别费劲了。\n");
        if( !arg || arg != "up" ) {
                return notify_fail("你要向哪爬？\n");
        }
         if ( me->is_busy() )
                return notify_fail("你正忙着呢。\n");
         message_vision( HIC "$N向上爬去。\n" NOR,me);
         me->move(__DIR__"uptree");
         return 1;
}
