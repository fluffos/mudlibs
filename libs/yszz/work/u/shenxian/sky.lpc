// Room: /u/shenxian/sky.c

// modified by shenxian@YSZZ 2000.10.11
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIW "时空隧道" NOR);
  set("long", "
神仙的时空穿梭机，从这里可以去 …………
    ");
  set("no_clean_up", 0);
  set("exits", ([ /* sizeof() == 9 */
    "west": "/d/wiz/system",
    "kz": "/d/city/kezhan",
    "hong": "/d/ourhome/honglou/fairyplace",
    "down": "/d/wiz/wizroom",
    "empty": "/obj/empty",
    "north": "/d/wiz/jobroom",
    "zuan": "/u/fly/where/workhome",
    "guest": "/d/wiz/guest",
    "aolai": "/d/4world/center",
  ]));
  setup();
}
void init() {
  object ob = this_player();
  remove_call_out("check");
  call_out("check", 1, ob);
}

int check(object ob) {
  if (ob->query("id") == "shenxian" || ob->query("id") == "grief" || ob->query("id") == "meokey") return;
  message_vision(HIR "神仙突然跑出来，抱起$N,一把扔到垃圾筒里! \n", ob);
  ob->move("/u/shenxian/rubbish");
  return;
}
