
//测试中

#include <ansi.h>
#include <localtime.h>
inherit F_CLEAN_UP;
int help(object me);

int main(object me, string arg)
{
        string *file, str;
        int i, j, number,m,y;
        tell_object(me,HIW"《"NOR+MUD_NAME+HIW"消息列表"NOR+HIW"》"NOR"，");
        file = get_dir("/doc/news/");
        i = sizeof(file);
        if (!i) return notify_fail("现在暂时还没有新的消息。\n");

        m = localtime(time())[LT_MON]+1;
        y = localtime(time())[LT_YEAR];

        if (!arg) list(me, y, m);
        else if(arg=="all")  list(me, 2, m);
           else read_note(me, number, m, y);
        return 1;
int help(object me)
{
write(@HELP
指令格式：
news all                  : 列出妖神之争的消息。
news                      : 列出本日妖神之争的消息。
news <编号>               : 阅读此编号的妖神之争的消息。
news 0 <月份>             : 列出本年月妖神之争的消息。

HELP
    );
    return 1;
}
