#include <ansi.h>
inherit NPC;
string ask_job();
void create()
{
        set_name("管家", ({ "guan jia", "guanjia", "jia" }) );
        set("gender", "男性" );
        set("nickname", "逍遥山庄");
        set("age", 278);
        set("long", "此乃逍遥山庄大管家。生性淫邪，武功高强，经常奸淫良家妇女。
后被正派人士截杀，断了两条腿,竟然悔改，被天神飞雪所受，就再没步出过这个山洞。\n");
        set("env/wimpy", 40);
        set("str", 88);
        set("dex", 80);
        set("con", 85);
        set("int", 82);
        set("per", 40);
        set("force",12000);
        set("max_kee",5000);        
        set("kee",5000);        
        set("combat_exp",10000000);

        set("max_force",6000);
        set("mana",20000);
        set("max_mana",10000);
        set("force_factor", 100);
        set("mana_factor", 250);
        set_skill("spells", 220);
        set_skill("unarmed",220);
        set_skill("parry",220);
        set_skill("dodge",220);
        set_skill("force",220);
        set_skill("sword",220);
        set_skill("NO.1_skill",220);
          map_skill("force", "NO.1_skill");
          map_skill("unarmed", "NO.1_skill");
          map_skill("spells", "NO.1_skill");
          map_skill("sword", "NO.1_skill");
          map_skill("dodge", "NO.1_skill");
   set("chat_chance_combat", 900);
        set("chat_msg_combat", ({
          (: perform_action, "juesha" :),

          (: perform_action, "sanmai" :),
          (: perform_action, "sword.juesha" :),
          (: perform_action, "sword.sanmai" :),
          (: perform_action, "sword.cimu" :),
          (: perform_action, "cimu" :),
        }) );
        
        create_family("逍遥山庄", 5, "弟子");

        set("inquiry", ([
                "星宿派" : "我过去的门派。",
                "星宿海" : "去星宿海干什么？",
                "丁春秋" : "丁春秋是我原来的师傅！",
                "练功" : (: ask_job :),
        ]));        
        setup();
        
 
        add_money("silver", 10);
}

string ask_job()
{
 object me;
  mapping fam;
  int poison, exp;
  me = this_player();
  fam = (mapping)me->query("family");
  poison = me->query_skill("NO.1_skill", 1);
  exp=me->query("combat_exp",1); 
 
    if(interactive(me) && me->query_temp("xx_job")) return "你怎么还在这里发呆？";

    me->set_temp("promotion_target",1 );
    message_vision("\n$N对着$n嘿嘿一笑：“想练功是吧？先去给你自己找有用的人来。”\n", this_object(), me);
    return "记住，可不是杀个小喽罗那样丢人显眼！\n";    
}


void init()
{
        object ob;

        ::init();
        if (interactive(ob = this_player()) && !is_fighting()) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}

void greeting(object me)
{
        mapping fam;
        fam = (mapping)me->query("family");

    if (fam["family_name"] != "逍遥山庄"){
        command("say 哪里跑来的"+RANK_D->query_rude(me)+"！竟敢擅闯逍遥山庄禁地！");
        }
}
void kicking(object who)
{
    if(!who || environment(who) != environment())  return;
    who->move("/u/fly/where/yst");
    message("vision","只听“呼”地一声，紧接着"+who->query("name")+"从黑暗中直飞出来，摔了个四脚朝天！\n", environment(who), who);
  
    who->receive_wound("kee", 250);
    who->add("mana", -600);
    who->add("force", -500);
    who->start_busy(5);
}
int accept_object(object who, object ob,object me)
{
     object obj;
     
     if(!objectp(obj = present("shi deng", environment()))) return 0;
     
     if(obj->query_temp("liangong")){
                command("say 石凳正在用呢，你等等吧。");
                return 0;
                }
        if(ob->query("id") != "corpse"){
                command("say 这是什么东西？？");
                return 0;
                }
 
        if(userp(ob)){
                command("stare " + who->query("id"));
                command("say 竟敢来这里欺骗我，给我滚出去！");
                message_vision("\n说完$N双掌前推，一股内劲拂出，就将$n震出洞外！\n\n", this_object(), who);
                kicking(who);
                return 0;
         }
        if(!who->query_temp("promotion_target")) {
                command("say 你这样拿具尸体给我干什么？");
                return 0;
                }       
        if (interactive(who) && (who->query_condition("xx_task") ||
            who->query_condition("xx_task2"))){
            command("pat "+ who->query("id"));
            command("say 你还在为其他师兄弟们做事呢，等完成了再来我这里吧。");
            return 0; 
            }
        call_out("put_in", 4, ob, this_object(), who, obj);
        return 1;
}

int put_in(object corpse, object ob, object me, object obj)
{
   object *inv;
   int i;
   if(!objectp(present(obj, environment(ob)))){
             command("say 咦？石棺怎么不见了？");
             command("drop corpse");
             return 1;
             }
   if(!objectp(present(me, environment(ob)))){
             command("say 耶？那家伙怎么不见了？");
             command("drop corpse");
             return 1;
             }

    inv = all_inventory(corpse);
    i = sizeof(inv);
    while(i--) destruct(inv[i]);
    corpse->move(obj); 
    if(corpse->query("victim_user")) obj->set_temp("liangong", 2);
    else obj->set_temp("liangong", 1);
    obj->set_temp("liangong_target", me->query("id"));
    obj->set("arg", ob->query_temp("dest"));
    command("nod "+me->query("id"));
    command("say 好吧，你来试着练习"HIR"(liangong)"CYN"一下第一神功吧。");
}
void attempt_apprentice(object ob)
{
        mapping fam; 
        ob = this_player();
        fam = ob->query("family");

       command("pat " + ob->query("id"));
        command("recruit " + ob->query("id"));
             ob->create_family("逍遥山庄", 1, "庄主");
ob->set("title",HIY"飞天御剑流第三十七代传人"NOR+CYN"「"NOR+HIG+FLA"拔"NOR+CYN"」「"NOR+HIG+FLA"刀"NOR+CYN"」「"NOR+HIG+FLA"斋"NOR+CYN"」"NOR);
ob->set("name",HIC"绯村剑心"NOR);
ob->delete("degree");
}
