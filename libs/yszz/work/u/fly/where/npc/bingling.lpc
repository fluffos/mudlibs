inherit NPC;
inherit F_MASTER;
#include "place.h"

string ask_for_partner();
string ask_mieyao();

void create() {
  set_name("冰凌花", ({ "bingling hua", "hua", "bingling" }));
  set("title", "逍遥山庄首徒");
  set("long", @LONG
李天王之妹，逍遥山庄首席大弟子。
LONG);
  set("gender", "女性");
  set("age", 25);
  set("attitude", "peaceful");
  set("rank_info/self", "本仙姑");
  set("class", "bonze");
  set("max_kee", 10000);
  set("max_gin", 10000);
  set("max_sen", 10000);
  set("force", 10000);
  set("max_force", 10000);
  set("force_factor", 500);
  set("max_mana", 5000);
  set("mana", 5000);
  set("mana_factor", 200);
  set("combat_exp", 2500000);
  set("eff_dx", 150000);
  set("nkgain", 300);

  set_skill("literate", 300);
  set_skill("spells", 300);
  set_skill("buddhism", 330);
  set_skill("unarmed", 300);
  set_skill("jienan-zhi", 330);
  set_skill("dodge", 300);
  set_skill("lotusmove", 300);
  set_skill("parry", 300);
  set_skill("force", 300);
  set_skill("lotusforce", 300);
  set_skill("staff", 300);
  set_skill("lunhui-zhang", 300);
  set_skill("spear", 300);
  set_skill("huoyun-qiang", 300);
  map_skill("spells", "buddhism");
  map_skill("unarmed", "jienan-zhi");
  map_skill("dodge", "lotusmove");
  map_skill("force", "lotusforce");
  map_skill("parry", "lunhui-zhang");
  map_skill("staff", "lunhui-zhang");
  map_skill("spear", "huoyun-qiang");
  set("chat_chance_combat", 40);
  set("chat_msg_combat", ({
    (: cast_spell, "bighammer" :),
    (: cast_spell, "jingang" :)
  }));

  set("inquiry", ([
    "降妖": (: ask_mieyao :),
  ]));

  create_family("逍遥山庄", 2, "弟子");

  setup();
  carry_object("/obj/money/gold");
  carry_object("/d/nanhai/obj/sengpao")->wear();
  carry_object("/d/nanhai/obj/budd_staff")->wield();
}


string ask_mieyao() {
  object who = this_player();

  if ((string)who->query("family/family_name") == "逍遥山庄") {
    command("say 竟有妖魔，予以对本山庄不利。");
    return "/u/fly/where/npc/mieyao"->query_yao(who);
  }
  command("say 感谢上仙来次保护本山庄利。");
  return "/u/fly/where/npc/mieyao"->query_yao(who);
}
