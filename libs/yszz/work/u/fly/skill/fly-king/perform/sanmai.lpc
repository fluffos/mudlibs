#include <ansi.h>

inherit F_SSERVER;

#include "/u/fly/skill/eff_msg.h";
 
int perform(object me, object target)
{       
       string msg;
        int damage, p;

        if( !target ) target = offensive_target(me);
 
         if( !target || !target->is_character()
           || !me->is_fighting(target) || !living(target) )
                return notify_fail("「一指三脉」只能在战斗中使用。\n");
      if( (int)me->query_skill("NO.1_skill", 1) < 100 ||
            (int)me->query_skill("unarmed", 1) < 100 ||
            (int)me->query_str() < 39)
                return notify_fail("你有的功夫还不够娴熟，不会使用「一指三脉」。\n");
        if( (int)me->query("max_force") < 3200 )
                return notify_fail("你的内力修为太弱，不能使用「一指三脉」！\n");
        
        if( (int)me->query("force") < 800 )
                return notify_fail("你的真气不够！\n");
            msg = YEL "\n$N背向$n，凝气于指，一式「一指三脉」反手缓缓点出，纯阳指力直袭$n胸口！\n" NOR;
          if (random(me->query_skill("parry")) > target->query_skill("parry") / 10)
             {
                me->start_busy(1);
                target->start_busy(1);
                damage = (int)me->query_skill("NO.1_skill", 1);
                damage = (int)me->query_skill("unarmed", 1) +damage;
                damage = damage*2 + random(damage);
                target->receive_damage("kee", damage);
                target->receive_wound("kee", damage/2);               
             p = (int)target->query("kee")*100/(int)target->query("max_kee");
                msg += damage_msg(damage, "内伤");
                msg += "( $n"+eff_status_msg(p)+" )\n";
                if(me->query_skill("NO.1_skill", 1) > 119)
                {
             remove_call_out("perform2");
                call_out("perform2", 1, me, target);    
                         }
             } 
         else {       
                me->start_busy(3);
                msg += HIY"可是$p一个巧云翻身，远远的躲了开去。\n"NOR;
                if(me->query_skill("NO.1_skill", 1) > 119)
                {
             remove_call_out("perform2");
                call_out("perform2", 1, me, target);    
                         }
              }
        message_vision(msg, me, target);
        return 1;
}

int perform2(object me, object target)
{
        string msg;

        if (!me || !target) return 0;
        if(!living(target)) 
          return notify_fail("对手已经不能再战斗了。\n");  
        if( (int)me->query("neili", 1) < 600 )
                return notify_fail("你待要再出第二指，却发现自己的内力不够了！\n");     
       
        msg = YEL "\n接着$N踏前一步，出第二指隔空点向$n胸前“玉堂穴”，认穴竟无厘毫之差！\n"NOR;
if(me->query_skill("dodge")>random(target->query_skill("dodge"))/3*2){                
                msg += HIR "结果一指点中，$n只觉得全身气脉通道阻塞，真气立受干挠！\n"NOR;   
                target->add_temp("apply/attack", - 200);
                target->add_temp("apply/dodge", - 200);
                target->add_temp("apply/parry", -200);
                me->start_busy(1);
                target->start_busy(1);
                if(me->query_skill("NO.1_skill", 1) > 139)
                {
             remove_call_out("perform3");
                call_out("perform3", 1, me, target);    
                         }
                } 
        else {
           me->start_busy(random(3));
          msg += HIY"\n$p眼看逼无可逼，便也一指点去，两根指尖相碰，$p顺势跳了开去。\n" NOR;
                if(me->query_skill("NO.1_skill", 1) > 139)
                {
             remove_call_out("perform3");
                call_out("perform3", 1, me, target);    
                         }
           }
        message_vision(msg, me, target);
        return 1;
}

int perform3(object me, object target)
{
    int skill;
        string msg;
        skill = (int)me->query_skill("NO.1_skill", 1);                
        skill = skill/10;
       
        if(!living(target)) 
          return notify_fail("对手已经不能再战斗了。\n");

        if( (int)me->query("force", 1) < 400 )
                return notify_fail("你待要再出第三指，却发现自己的内力不够了！\n");  
        msg = YEL "\n紧跟着$N一阳指第三次点出，以纯阳内力，同时透入$n体内任脉紫宫穴、
阴维脉大横穴、冲脉幽门穴、带脉章门穴和阴跤脉晴明穴！\n"NOR;        
        if (random(me->query_skill("force")) > target->query_skill("force") / 2){                
                me->add("force", -200);
               msg += HIR "$n只觉体内奇经八脉中内息为之一怠，全身气力竟然提不起来了！\n" NOR;
                          
                me->start_busy(1);
                target->start_busy(me->query_skill("force",1)/30);
                call_out("back", 3 + skill, target);
                } 
        else {
               me->start_busy(1);
                me->add("force", -300);
                target->start_busy(2);
                msg += HIY"\n$p喘息未定，见$P指力如狂风般点来，连忙又跃开数尺，狼狈地避开。\n" NOR;
             }
        message_vision(msg, me, target);
        return 1;
}
void back(object target)
{
    if (!target) return;
        target->add_temp("apply/attack", 200);
        target->add_temp("apply/dodge", 200);
        target->add_temp("apply/parry", 200);
}
