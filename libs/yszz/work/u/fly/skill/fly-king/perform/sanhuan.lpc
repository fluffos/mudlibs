//by fly 6-6-2000

#include <ansi.h>
inherit F_SSERVER;
#include "/u/fly/skill/eff_msg.h";
string *xue_name = ({
  HIR "劳宫穴" NOR, HIR "膻中穴" NOR, HIR "曲池穴" NOR,
  HIG "关元穴" NOR, HIG "曲骨穴" NOR, HIG "中极穴" NOR,
  HIY "承浆穴" NOR, HIY "天突穴" NOR, HIY "百会穴" NOR,
  HIM "幽门穴" NOR, HIM "章门穴" NOR, HIM "大横穴" NOR,
  HIW "紫宫穴" NOR, HIW "冷渊穴" NOR, HIW "天井穴" NOR,
  HIC "极泉穴" NOR, HIC "清灵穴" NOR, HIC "至阳穴" NOR, });
string *weapon1_name = ({ HIR "剑气" NOR, HIR "左手剑" NOR, HIG "快剑" NOR });
string *weapon2_name = ({ HIW "半轮剑弧" NOR, HIB "一道闪光" NOR, HIR "无形剑气" NOR });
string *weapon3_name = ({ HBRED "回旋剑气" NOR, HBGRN "一道闪光" NOR, HBBLU "无数剑气" NOR });

int perform(object me, object target) {
  int damage, p;
  string msg, dodge_skill, *limbs;
  if (!target) target = offensive_target(me);
  if (!target || !target->is_character()
    || !me->is_fighting(target) || !living(target))
    return notify_fail("三环套月只能对战斗中的对手使用。\n");
  /*
        if( (int)me->query_skill("taiji-jian", 1) < 100 )
                return notify_fail("你的太极剑还不够熟练，不能使用三环套月对敌！\n");
*/
  if (!me->query_temp("weapon"))
    return notify_fail("你必须用剑才能使用「太极剑」！\n");
  if ((int)me->query("max_force") < 1500)
    return notify_fail("你现在内力不足，使不出太极剑的绝招！\n");
  if ((int)me->query("force") < 400)
    return notify_fail("你现在内力不足，使不出太极剑的绝招！\n");
  if ((int)me->query_skill("sword", 1) < 100)
    return notify_fail("你的剑法不够娴熟，使不出太极剑的绝招！\n");
  if (me->query_str() < 30)
    return notify_fail("你的力量太小，使不出用三环套月！\n");
  //         if( me->query_temp("tjj_sanhuan"))
  //return notify_fail("你刚使完「三环套月」，目前气血翻涌，无法再次运用！\n");
  message_vision(HIR "\n$N纵身长啸，横剑于胸前，弹指剑尖，却见朵朵光华，长剑未出，已然蓄势无穷。\n" NOR, me, target);
  msg = HIG "\n突然之间，$N剑交右手，寒光一闪，剑拉弧形，直逼向$n," NOR + xue_name[random(sizeof(xue_name))] + HIG "阵阵森森寒气。\n" NOR;
  me->set_temp("tjj_sanhuan", 1);
  if (random(me->query_skill("force")) > random(target->query_skill("force") / 4)) {
    me->start_busy(1);
    target->start_busy(1);
    me->add("force", -200);
    damage = (int)me->query_skill("sword", 1);
    damage = damage * 5 + random(damage);
    if (damage > 2000) damage = 2000;
    if (me->query("force") > target->query("force") * 2) damage += random(damage);
    target->receive_damage("kee", damage);
    target->receive_wound("kee", damage / 2);
    p = (int)target->query("kee") * 100 / (int)target->query("max_kee");
    //                msg += damage_msg(damage, "刺伤");
    //                msg += "( $n"+eff_status_msg(p)+" )\n";
    msg += CYN "$n大吃一惊，变招不及，$w已在他的" NOR + xue_name[random(sizeof(xue_name))] + CYN "对穿而出，真气不由一散。\n" NOR;
    msg = replace_string(msg, "$w", weapon1_name[random(sizeof(weapon1_name))]);
    //            msg = replace_string(msg, "$l", limbs[random(sizeof(limbs))]);
    //           msg = replace_string(msg, "$w", weapon1_name[random(sizeof(weapon1_name))]);    
    remove_call_out("perform2");
    call_out("perform2", 0, me, target, p);
  } else {
    me->start_busy(2);
    me->add("force", -100);
    tell_object(target, HIY "你但觉一股微风扑面而来，风势虽然不劲，然已逼得自己呼吸不畅，知道不妙，连忙跃开数尺。\n" NOR);
    dodge_skill = target->query_skill_mapped("dodge");
    if (!dodge_skill) dodge_skill = "dodge";
    msg += SKILL_D(dodge_skill)->query_dodge_msg(target, 1);
    me->delete_temp("tjj_sanhuan");
    tell_object(me, HIC "\n你经过一段时间调气养息，又可以使用「三环套月」绝招了。\n" NOR);
  }
  message_vision(msg, me, target);
  return 1;
}

int perform2(object me, object target, int p) {
  int damage;
  string msg, dodge_skill, *limbs, force_skill, force_skill_name;
  if (!target) target = offensive_target(me);
  if (!target || !target->is_character()
    || !me->is_fighting(target) || !living(target))
    return notify_fail("三环套月只能对战斗中的对手使用。\n");
  if (!living(target))
    return notify_fail("对手已经不能再战斗了。\n");
  if ((int)me->query("force", 1) < 500)
    return notify_fail("你待要再发一剑，却发现自己的内力不够了！\n");
  msg = HIC "\n跟着，$N随式一转，右跨一步，蓦地剑交左手,剑势似是千变万化，剑气万重。\n" NOR;
  if (random(me->query_skill("sword")) > random(target->query_skill("force") / 3) &&
    me->query_skill("sword", 1) > 124) {
    me->start_busy(1);
    target->start_busy(1);
    damage = (int)me->query_skill("sword", 1);
    damage = damage * 2 + random(damage * 2);
    if (damage > 3000) damage = 3000;
    if (me->query("force") > target->query("force") * 2) damage += random(damage);
    target->receive_damage("kee", damage);
    target->receive_wound("kee", damage / 2);
    p = (int)target->query("kee") * 100 / (int)target->query("max_kee");
    force_skill = target->query_skill_mapped("force");
    if (!force_skill) force_skill_name = "基本内功";
    else if (force_skill == "huntian-qigong") force_skill_name = "混天气功";
    else if (force_skill == "lengquan-force") force_skill_name = "冷泉神功";
    else if (force_skill == "mihou-force") force_skill_name = "弥猴内功";
    else if (force_skill == "xuanhu-xinfa") force_skill_name = "玄狐心法";
    else if (force_skill == "lotusforce") force_skill_name = "莲花心法";
    else if (force_skill == "moonforce") force_skill_name = "月宫心法";
    else if (force_skill == "ningxie-force") force_skill_name = "凝血神功";
    else if (force_skill == "wuxiangforce") force_skill_name = "小无相功";
    else if (force_skill == "dragonforce") force_skill_name = "龙神心法";
    else if (force_skill == "tonsillit") force_skill_name = "摄气绝";
    else if (force_skill == "zhenyuan-force") force_skill_name = "镇元神功";
    else if (force_skill == "NO.1_skill") force_skill_name = "第一神功";
    else force_skill_name = "无名内功";
    msg += CYN "$n冷笑一声，突然" NOR + xue_name[random(sizeof(xue_name))] + CYN "一冷，连连运起" NOR + HIR + force_skill_name + NOR + CYN "，气血依然无法凝聚。\n" NOR;
    /*
                msg += damage_msg(damage, random(3)?"砸伤":"刺伤");
                msg += "( $n"+eff_status_msg(p)+" )\n";                
           limbs = target->query("limbs");
           msg = replace_string(msg, "$l", limbs[random(sizeof(limbs))]);
           msg = replace_string(msg, "$w", weapon2_name[random(sizeof(weapon2_name))]);    
*/
    remove_call_out("perform3");
    call_out("perform3", 0, me, target, p);
  } else {
    me->start_busy(2);
    tell_object(target, HIY "你喘息未定，又觉一股劲风扑面而来，连忙跃开数尺，狼狈地避开。\n" NOR);
    dodge_skill = target->query_skill_mapped("dodge");
    if (!dodge_skill) dodge_skill = "dodge";
    msg += SKILL_D(dodge_skill)->query_dodge_msg(target, 1);
    me->delete_temp("tjj_sanhuan");
    tell_object(me, HIC "\n你经过一段时间调气养息，又可以使用「三环套月」绝招了。\n" NOR);
  }
  message_vision(msg, me, target);
  return 1;
}
int perform3(object me, object target, int p) {
  int damage;
  string msg, dodge_skill, *limbs, force_skill, force_skill_name;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character()
    || !me->is_fighting(target) || !living(target))
    return notify_fail("三环套月只能对战斗中的对手使用。\n");
  if (!living(target))
    return notify_fail("对手已经不能再战斗了。\n");
  if ((int)me->query("force", 1) < 700)
    return notify_fail("你待要再发一剑，却发现自己的内力不够了！\n");
  force_skill = target->query_skill_mapped("force");
  if (!force_skill) force_skill_name = "基本内功";
  else if (force_skill == "huntian-qigong") force_skill_name = "混天气功";
  else if (force_skill == "lengquan-force") force_skill_name = "冷泉神功";
  else if (force_skill == "lotusforce") force_skill_name = "莲花心法";
  else if (force_skill == "moonforce") force_skill_name = "月宫心法";
  else if (force_skill == "mihou-force") force_skill_name = "弥猴内功";
  else if (force_skill == "xuanhu-xinfa") force_skill_name = "玄狐心法";
  else if (force_skill == "ningxie-force") force_skill_name = "凝血神功";
  else if (force_skill == "wuxiangforce") force_skill_name = "小无相功";
  else if (force_skill == "dragonforce") force_skill_name = "龙神心法";
  else if (force_skill == "tonsillit") force_skill_name = "摄气绝";
  else if (force_skill == "zhenyuan-force") force_skill_name = "镇元神功";
  else if (force_skill == "NO.1_skill") force_skill_name = "第一神功";
  else force_skill_name = "无名内功";
  msg = HIW "\n紧接着，$N飞身向前，身剑合一，所幻的光圈一圈一圈，$n全身已被套其中\n" NOR;
  if (random(me->query_skill("sword")) > random(target->query_skill("force") / 2) &&
    me->query_skill("sword", 1) > 149) {
    me->start_busy(1);
    target->start_busy(random(4));
    damage = (int)me->query_skill("sword", 1);
    damage = damage * 4 + random(damage * 2);
    if (damage > 4000) damage = 4000;
    if (me->query("force") > target->query("force") * 2) damage += random(damage);
    target->receive_damage("kee", damage);
    target->receive_wound("kee", damage / 2);
    p = (int)target->query("kee") * 100 / (int)target->query("max_kee");
    //                msg += HIB"$n愈打愈惊，丝毫不见金刃劈风之声，突然转身剑指$N"NOR+xue_name[random(sizeof(xue_name))]+HIB",实乃冒险一击。\n"NOR;
    msg += weapon2_name[random(sizeof(weapon2_name))] + WHT "刺穿$n的" NOR + HIR + force_skill_name + NOR + WHT ",喀嚓一声$n的" NOR + HIM "手臂" NOR + WHT "已然绞断，" NOR + xue_name[random(sizeof(xue_name))] + WHT "被对穿而出。\n" NOR;
    msg += damage_msg(damage, "砸伤");
    //                msg += damage_msg(damage, random(3)?"刺伤":"砸伤");
    msg += "( $n" + eff_status_msg(p) + " )\n";
    limbs = target->query("limbs");
    msg = replace_string(msg, "$l", limbs[random(sizeof(limbs))]);
    msg = replace_string(msg, "$w", weapon3_name[random(sizeof(weapon3_name))]);
  } else {
    me->start_busy(2);
    target->start_busy(1);
    me->add("force", -300);
    tell_object(target, HIY "你用尽全身力量向右一纵一滚，摇摇欲倒地站了起来，但总算躲开了这致命的一击！\n" NOR);
    dodge_skill = target->query_skill_mapped("dodge");
    if (!dodge_skill) dodge_skill = "dodge";
    msg += SKILL_D(dodge_skill)->query_dodge_msg(target, 1);
  }
  remove_call_out("remove_effect");
  call_out("remove_effect", 6, me);
  message_vision(msg, me, target);
  return 1;
}
void remove_effect(object me) {
  if (!me) return;
  me->delete_temp("tjj_sanhuan");
  tell_object(me, HIC "\n你经过一段时间调气养息，又可以使用「三环套月」绝招了。\n" NOR);
}
