#include <ansi.h>

int exert(object me, object target)
{
	if( !target )
		return notify_fail("你要用真气为谁疗伤？\n");
	if( me->is_fighting() || target->is_fighting())
		return notify_fail("战斗中无法运功疗伤！\n");

	if( (int)me->query("max_force") < 300 )
		return notify_fail("你的内力修为不够。\n");

	if( (int)me->query("force") < 100 )
		return notify_fail("你的真气不够。\n");
	if( (int)target->query("eff_qi") < (int)target->query("max_qi") / 10 )
		return notify_fail( target->name() +
			"已经受伤过重，经受不起你的真气震荡！\n");
        if( me == target ) {
                write( WHT "你全身放松，盘膝坐下，运起第一神功开始疗伤。\n" NOR);
                message("vision",
                        HIR + me->name() + "吐出一口瘀血，脸色看起来好多了。\n" NOR,
                        environment(me), me);
	}
else {message_vision(
        CYN"$N坐了下来运起第一奇功，将手掌贴在$n背心，缓缓地将真气输入$n体内....\n"
        RED"$n只觉一股暧阳阳的真气源源不绝的输入体内，瞬间流遍全身各大穴位。\n"
        HIR"$n吐出一口瘀血，脸色看起来红润多了，伤势有了很大的好转！\n" NOR,
		me, target );
	}
    target->receive_curing("kee", 100 + (int)me->query_skill("force"));
    target->add("kee", 100+ (int)me->query_skill("force"));
	if( (int)target->query("kee") > (int)target->query("eff_kee") ) target->set("kee", (int)target->query("eff_kee"));
	me->add("force", -10);
	
return 1;
}
