// fengyun.c

#include <ansi.h>

int exert(object me)
{       
        int improve;

        if( me->is_fighting() )
                return notify_fail("战斗中运功疗伤？找死吗？\n");

        if (me->is_busy() )
        return notify_fail("你正忙着哪！\n");
        if( (int)me->query("force") < 90 )
                return notify_fail("你的真气不够。\n");
        
      if( me->query_temp("yun_fengyun")   )
        return notify_fail("你正在运用惊神指法的「风云」字决！\n");
        write(HIG"你暗运"HIR"风"HIY"云"HIG"两庄，心思浮云飘空之悠闲缓慢。\n"NOR, me);
        message_vision(RED"渐渐$N身旁凝起一圈"HIW"白雾"HIR"，似浮似飘。\n"NOR, me);
        message_vision(HIR"只见$N微闭双眼，一股丹田热气分注四肢百骸，$N一跃而起。\n"NOR, me);
        improve = me->query_skill("dodge",1);
        me->add_temp("apply/dodge", improve);
        me->add_temp("apply/parry", improve);
        me->set_temp("yun_fengyun", 1);  
        me->add("neili", - 90);    
        me->start_call_out( (: call_other, __FILE__, "remove_effect", me, improve :), (int)me->query_skill("dodge", 1)*2 );
        return 1;
}
void remove_effect(object me, int improve)
{     
        me->add_temp("apply/parry", -improve);
        me->add_temp("apply/dodge", -improve);
      me->delete_temp("yun_fengyun");
      tell_object(me, HIR"你风云行功已久，略觉步履沉重了一些。\n"NOR);
}
