//惊神指

#include "/u/fly/skill/eff_msg.h";
#include <ansi.h>
inherit SSERVER;
int exert(object me, object target)
{
        string msg, dodge_skill;
        int p;

        int lvl,lvl2;
        if( !me->is_fighting() )
                return notify_fail("只能在战斗中对敌人使用！\n");
        lvl = me->query_skill("fly-king",1);
        if(!target)target = offensive_target(me);  
        if(target==me) target = offensive_target(me);
        if( (int)me->query("neili") < 500 )
                return notify_fail("你的真气不够。\n");
        if( lvl < 100 )
       return notify_fail("你的惊神指法火候太浅，用不出“惊神指”！\n");
       
/*
       if( me->query_temp("jsz")   )
        return notify_fail("你正在运用惊神指法的「惊神指」！\n");
*/

       message_vision(HIW+"$N脸色一寒，浑身发出冰雪般的寒气。\n"+NOR,me);
       message_vision(HIW+"$N将已修练了十余年的“寒冰真气”注于食指之上，拚着大耗内力，手指一伸，飞点$n的胸口！\n"+NOR,me);
if(random((me->query("combat_exp")))>(int)target->query("combat_exp")/4 )
        {
         message_vision("结果$n促不及防，被$P一指点在胸前大穴上！\n", me, target);
         
         tell_object(me, BLU "你一指点在" +target->query("name") +"胸口，待其运内力抵抗，将寒毒顺他“天池穴”直逼过去！" +target->query("name") +"体内。\n"NOR);
         tell_object(target, HIW "你只觉一股寒气袭胸，立即全力运功，不料一瞬之间，寒气已将你全身冻僵！\n"NOR);
         target->receive_damage("kee",me->query_skill("fly-king"));
         target->receive_wound("kee",me->query_skill("unarmed"));
         target->start_busy(1+random(lvl)/20);
         target->apply_condition("cold_poison", me->query_skill("fly-king", 1)*2);
/*
          p = (int)target->query("kee")*100/(int)target->query("max_kee");
          msg = damage_msg(me->query_skill("unarmed"), "内伤");
          msg += "( $n"+eff_status_msg(p)+" )\n";          
          message_vision(msg, me, target);
*/
     }
    else
      {
/*
             dodge_skill = target->query_skill_mapped("dodge");
	     if( !dodge_skill ) dodge_skill = "dodge";
             message_vision(SKILL_D(dodge_skill)->query_dodge_msg(target, 1), me, target);
*/
         message_vision(
                HIW +
"$N觉出危险，身行急退，躲开了此式！\n"+NOR,target);
    }
        me->add("force", -500);
        me->start_busy(1);
      return 1;
}
