#include <ansi.h>
inherit F_SSERVER;
#include "/u/fly/skill/eff_msg.h";

int perform(object me, object target)
{
        int damage, p;
        string msg, dodge_skill;
        if( !target ) target = offensive_target(me);
        if( !target || !target->is_character()
           || !me->is_fighting(target) || !living(target) )
                return notify_fail("三环套月只能对战斗中的对手使用。\n");
/*
        if( (int)me->query_skill("taiji-jian", 1) < 100 )
                return notify_fail("你的太极剑还不够熟练，不能使用三环套月对敌！\n");
*/
        if(! me->query_temp("weapon") )
                return notify_fail("你必须用剑才能使用「太极剑」！\n");
        if( (int)me->query("max_force") < 1500 )
                return notify_fail("你现在内力不足，使不出太极剑的绝招！\n");     
        if( (int)me->query("force") < 400 )
                return notify_fail("你现在内力不足，使不出太极剑的绝招！\n");     
        if( (int)me->query_skill("sword", 1) < 100 )
                return notify_fail("你的剑法不够娴熟，使不出太极剑的绝招！\n");
        if (me->query_str() < 30 )
                return notify_fail("你的力量太小，使不出用三环套月！\n");
//        if( me->query_temp("tjj_sanhuan") )
//return notify_fail("你刚使完「三环套月」，目前气血翻涌，无法再次运用！\n");
        msg = HIC "\n$N微微一笑，使出太极剑中「三环套月」，当下身子缓缓右转,左手持剑向上提起。\n"NOR;
        message_vision(msg, me, target); 
        msg = HIC "剑身横于胸前，左右掌心相对，如抱圆球，手中长剑未出，已然蓄势无穷。\n"NOR;
        message_vision(msg, me, target); 
        msg = CYN "\n$N左手长剑缓缓向前划出，成一弧形，一股森森寒气，直逼向你，突然之间，$N剑交右手，寒光一闪，向$n划去。\n"NOR;
        me->set_temp("tjj_sanhuan", 1);
        if (random(me->query_skill("force")) > random(target->query_skill("force") /4) ){                     
                me->start_busy(1);
                target->start_busy(1); 
                me->add("force", -200);
                damage = (int)me->query_skill("sword", 1);       
                damage = damage*5 + random(damage);
                if(damage>2000) damage=2000;
                if(me->query("force") > target->query("force")*2 ) damage += random(damage);
                target->receive_damage("kee", damage);
                target->receive_wound("kee", damage/2);
                p = (int)target->query("kee")*100/(int)target->query("max_kee");
                msg += damage_msg(damage, "内伤");
                msg += "( $n"+eff_status_msg(p)+" )\n";
               remove_call_out("perform2");
                call_out("perform2", 0, me, target, p);  
                } 
        else {
                me->start_busy(1);
                target->start_busy(1);
                me->add("force", -100);
                tell_object(target, HIY"你但觉一股微风扑面而来，风势虽然不劲，然已逼得自己呼吸不畅，知道不妙，连忙跃开数尺。\n" NOR);
                dodge_skill = target->query_skill_mapped("dodge");
                if( !dodge_skill ) dodge_skill = "dodge";
                msg += SKILL_D(dodge_skill)->query_dodge_msg(target, 1);
               remove_call_out("remove_effect");
                call_out("remove_effect", me->query_con()/6, me);
        }
        message_vision(msg, me, target); 
        return 1;
}

int perform2(object me, object target, int p)
{
        int damage;
        string msg, dodge_skill;
        if(!living(target)) 
          return notify_fail("对手已经不能再战斗了。\n");
        if( (int)me->query("force", 1) < 500 )
                return notify_fail("你待要再发一剑，却发现自己的内力不够了！\n");     
        msg = HIM "\n$N又是剑交左手，在身前划了两个圆圈，剑劲连绵护住全身，竟无半分空隙，右手捏着剑诀，左手剑不住的抖动，罩向你上盘七大要穴，剑尖急颤，看不出攻向何处。\n"NOR;
        message_vision(msg, me, target); 
        msg = MAG "\n只见,$N左剑劲力未消，蓦地剑交右手,剑势似是千变万化，无穷无尽，剑气万重!！\n"NOR;        
        if (random(me->query_skill("sword")) > random(target->query_skill("force") / 3) &&
            me->query_skill("sword", 1) > 124 ){            
                me->start_busy(1);
                target->start_busy(1);
                me->add("force", -200);
                damage = (int)me->query_skill("sword", 1);       
                damage = damage*8 + random(damage);
                if(damage>3000) damage=3000;
                if(me->query("force") > target->query("force")*2 ) damage += random(damage);
                target->receive_damage("kee", damage);
                target->receive_wound("kee", damage/2);
                p = (int)target->query("kee")*100/(int)target->query("max_kee");
                msg += damage_msg(damage, "淤伤");
                msg += "( $n"+eff_status_msg(p)+" )\n";                
               remove_call_out("perform3");
                call_out("perform3", 0, me, target, p);  
        } 
        else 
        {
                me->start_busy(4);
                me->add("force", -200);
                tell_object(target, HIY"你喘息未定，又觉一股劲风扑面而来，连忙跃开数尺，狼狈地避开。\n" NOR);
                dodge_skill = target->query_skill_mapped("dodge");
                if( !dodge_skill ) dodge_skill = "dodge";
                msg += SKILL_D(dodge_skill)->query_dodge_msg(target, 1);
               remove_call_out("remove_effect");
                call_out("remove_effect", me->query_con()/4, me);
        }
        message_vision(msg, me, target); 
        return 1;
}
int perform3(object me, object target, int p)
{
        int damage;
        string msg, dodge_skill;

        if(!living(target))
              return notify_fail("对手已经不能再战斗了。\n");
        if( (int)me->query("force", 1) < 700 )
                return notify_fail("你待要再发一剑，却发现自己的内力不够了！\n");     
        msg = HIY "\n$N剑上所幻的光圈越来越多，过不多时，全身已隐在无数光圈之中，光圈光圈一个未消，另一个再生。\n"NOR;        
        message_vision(msg, me, target); 
        msg = YEL "\n$N手中长剑虽使得极快，却丝毫听不到金刃劈风之声，足见剑劲之柔韧已达于化境。\n"NOR;        
        if (random(me->query_skill("sword")) > random(target->query_skill("force") / 2) &&
            me->query_skill("sword", 1) > 149 )
        {
                me->start_busy(1);
                target->start_busy(random(4));
                me->add("force", -300);
                damage = (int)me->query_skill("sword", 1);       
                damage = damage*10 + random(damage);
                if(damage>4000) damage=4000;
                if(me->query("force") > target->query("force")*2 ) damage += random(damage);
                target->receive_damage("kee", damage);
                target->receive_wound("kee", damage/2);
                p = (int)target->query("kee")*100/(int)target->query("max_kee");
                msg += damage_msg(damage, "瘀伤");
                msg += "( $n"+eff_status_msg(p)+" )\n";     
        } else 
        {
                me->start_busy(4);
                target->start_busy(1);
                me->add("force", -300);
                tell_object(target, HIY"你用尽全身力量向右一纵一滚，摇摇欲倒地站了起来，但总算躲开了这致命的一击！\n" NOR);
                dodge_skill = target->query_skill_mapped("dodge");
                if( !dodge_skill ) dodge_skill = "dodge";
                msg += SKILL_D(dodge_skill)->query_dodge_msg(target, 1);
        }
               remove_call_out("remove_effect");
        call_out("remove_effect", me->query_con()/2, me);
        message_vision(msg, me, target); 
        return 1;
}
void remove_effect(object me)
{
        if (!me) return;
        me->delete_temp("tjj_sanhuan");
        tell_object(me, HIC"\n你经过一段时间调气养息，又可以使用「三环套月」绝招了。\n"NOR); 
}
