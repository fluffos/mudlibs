// snowsword perform
//by fly
#include <ansi.h>
#include <combat.h>
#include "/u/fly/skill/eff_msg.h";
inherit F_SSERVER;
int perform(object me, object target) {
  string msg;
  int i, j, z;
  object weapon;
  j = me->query_skill("sword", 1);
  z = me->query_skill("unarmed", 1);
  weapon = me->query_temp("weapon");
  if (!target) target = offensive_target(me);
  if (!target || !me->is_fighting(target))
    return notify_fail("「满天飞雪」只能在战斗中对对手使用。\n");
  if (!weapon || weapon->query("skill_type") != "sword"
  )
    return notify_fail("你必须在使用剑时才能使[满天飞雪」！\n");
  /*
        if(me->query_skill("taiji-jian", 1) < 120 )
                return notify_fail("你的太极剑法还不够娴熟，使不出「满天飞雪」绝技。\n");
*/
  if (me->query_skill("unarmed", 1) < 120)
    return notify_fail("你的掌法还不够娴熟，使不出「满天飞雪」绝技。\n");
  if ((int)me->query_skill("force") < 170)
    return notify_fail("你的内功等级不够，使不出「满天飞雪」绝技。\n");
  if ((int)me->query_str() < 50)
    return notify_fail("你的膂力还不够强劲，使不出「满天飞雪」绝技。\n");
  if ((int)me->query("max_force") < 1500)
    return notify_fail("你现在内力太弱，使不出「满天飞雪」。\n");
  if ((int)me->query("force") < 500)
    return notify_fail("你现在内力太弱，使不出「满天飞雪」。\n");
  msg = HIY "\n突然$N绕着$n快速奔走，猛然击出两剑一掌，齐齐指向$n！\n\n" NOR;
  me->add_temp("apply/strength", z);
  me->add_temp("apply/attack", j);
  if (weapon->query("id") == "flysword") {
    me->set_temp("moon_pfm", 1);
    me->add_temp("apply/damage", 150);
    msg = HIR "\n$N手中飞雪之剑连划数剑，逼出道道金光，剑光中$N化身为二，掌剑齐出，直指$n！\n\n" NOR;
  }
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 2);
  if (me->query_temp("moon_pfm"))
    message_vision(
      HIY "                                                                     ※※  满  ※※\n" NOR,
      me
    );
  weapon->unequip();
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 2);
  if (me->query_temp("moon_pfm"))
    message_vision(
      HIY "                                                                     ※※  天  ※※\n" NOR,
      me
    );
  weapon->wield();
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 2);
  if (me->query_temp("moon_pfm"))
    message_vision(
      HIY "                                                                     ※※  飞  ※※\n" NOR,
      me
    );
  weapon->unequip();
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 2);
  if (me->query_temp("moon_pfm")) {
    me->add_temp("apply/damage", -150);
    message_vision(
      HIY "                                                                     ※※  雪  ※※\n" NOR,
      me
    );
  }
  weapon->wield();
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 2);
  me->delete_temp("moon_pfm");
  me->add("neili", -50);
  me->add_temp("apply/strength", -z);
  me->add_temp("apply/attack", -j);
  me->start_busy(3);
  target->start_busy(random(3));
  return 1;
}
