#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIR + FLA "东天门" NOR + NOR);
  set("long", @LONG
    这里是岱顶的东面出口。往东依次经过伏虎门峡口、鹰愁涧等，
便可下山。
LONG);

  set("no_sleep_room", 1);

  set("exits", ([
    "west": "/d/kaifeng/taishan/tanhai",

  ]));

  set("outdoors", "泰山");

  setup();
}
void init() {

  object me = this_player();
  int ran;
  int luck = me->query_temp("xiaoyao_meet");


  if (me->query("id") == "xlwang" || me->query("id") == "fly")
    write(HIR + FLA "测试开始。\n" NOR);

  if (!me->query("xiaoyao_son") && me->query("xiaoyao_fail") < 4) {
    ran = random(2);
    if (me->query("id") == "xlwang" || me->query("id") == "fly")
      write(HIR "ran=" NOR + ran + HIR "&&luck=" NOR + luck + HIR "测试\n" NOR);
    if (ran == 1) {
      if (!luck && random((int)me->query("int")) > 20) {
        write("你突然觉得好象有人在你身后，转过头来却发现什么也没有。\n");
        me->set_temp("xiaoyao_meet", 1);
      }
      if (luck >= 1) {
        write("你突然觉得好象有人在你身后，转过头来却发现什么也没有。\n");
        me->add_temp("xiaoyao_meet", 1);
      }

      if (luck >= 2 && me->query_temp("xiaoyao_meet1")) {
        write("忽听背後一人说道：「小娃娃，来这里干什么？」\n");
        write("这声音祥和，却似从地底下钻出来一般。\n");
        message_vision(HIR "\n$N却好象被什么东西一惊，回头看看却已经无人，还是这里等一下为好。\n" NOR, me);
        me->delete_temp("xiaoyao_meet");
        if (me->query_temp("xiaoyao_meet1")) {
          remove_call_out("wait");
          if (me->query("id") == "xlwang" || me->query("id") == "fly")
            write(HIR "测试\n" NOR);
          call_out("wait", 10, me);
        }
      }
    }
  }
}
void wait(object me) {
  int total, try;
  try = me->query("xiaoyao_fail");
  if (me->query("id") == "xlwang" || me->query("id") == "fly")
    write(HIR "测试 2 \n" NOR);
  if (random(2) == 1 || me->query("id") == "fly") {
    message_vision("$N只觉越呆越是心惊，要跑却也不听使唤，只急得大汗淋漓，
只在不知如何是好之际，误入了一片柳树林子。\n", me);
    me->set_temp("xiaoyao_see", 1);
    me->delete_temp("xiaoyao_meet1");
    me->move(__DIR__ "shulin");
    return;
  } else {
    message_vision(HIR "$N脚下突然一软，骨碌碌地滚出了数十丈！\n" NOR, me);
    me->delete_temp("xiaoyao_meet1");
    me->move("/d/kaifeng/taishan/daizong");
    me->receive_wound("ken", 100);
    message_vision(HIM + FLA "$N大失所望，估计这次没戏了！\n" NOR + NOR, me);
    tell_room(environment(me), HIR + me->name() + "骨碌碌地滚了过来，躺在地上半天爬不起来！\n" NOR, ({ me }));
    return;
  }
}
int valid_leave(object me, string dir) {
  if (me->query_temp("xiaoyao_meet1") &&
    dir == "west") {
    message_vision("\n$N觉得这里一且都不可思议,只想逃离这里。\n", me);
    message_vision(HIR "$N脚下突然一软，骨碌碌地滚出了数十丈！\n" NOR, me);
    me->move("/d/kaifeng/taishan/daizong");
    message_vision(HIB "$N一越身,犹如不受身心控制一般,等定神回来却发现好象又回到了原地！\n" NOR, me);
    me->move("/d/kaifeng/taishan/tanhai");
    me->start_busy(1 + random(3));
    return notify_fail(WHT "\n突然，呼的一声响，仿佛一个人影从你头顶跃过，你大吃一惊。最好还是去(" NOR + HIC + FLA "east" NOR + NOR + WHT ")方向看看。\n\n" NOR);
  }
  if (dir == "west")
    me->start_busy(1);
  return 1;
}
