#include <ansi.h>

inherit NPC;


void create() {
  set_name("书生", ({ "shu sheng", "shusheng" }));
  set("gender", "男性");
  set("age", 170);
  set("str", 35);
  set("con", 30);
  set("int", 30);
  set("per", 40);
  set("dex", 30);

  set("no_clean_up", 1);

  set("long",
    WHT "\n一洗白衣飘飘，头裹白巾,说不出的无尽洒脱，
但见他行走处如行云流水，似动似静。背后却斜挂一根短笛。\n\n" NOR);
  set("combat_exp", 1800000);
  set("attitude", "heroism");

  set("max_ken", 8000);
  set("max_sen", 8000);
  set("force", 10000);
  set("max_mana", 7000);
  set("max_force", 7000);
  set("mana", 10000);
  set("enforce_factor", 500);

  set("mana_factor", 500);
  set_skill("force", 200);
  set_skill("sword", 200);
  set_skill("literate", 100);
  set_skill("poison", 200);
  set_skill("dodge", 190);
  set_skill("parry", 190);
  set_skill("strike", 190);
  /*
       set_skill("sushang-dodge", 190);
       set_skill("sushang-jianfa", 200); 
       set_skill("sushang-force", 190);
       set("chat_chance_combat", 20);
        set("chat_msg_combat", ({
                (: perform_action, "sword.feijian" :)
        }));
       map_skill("dodge", "sushang-dodge");
       map_skill("force", "sushang-force");
       map_skill("parry", "sushang-jianfa");
*/
  map_skill("sword", "sushang-jianfa");

  set("inquiry", ([
    "李逍遥": "李逍遥,李逍遥,听起来这名字挺熟的。。。\n",


  ]));
  setup();

  carry_object("/d/obj/weapon/sword/di");

  add_money("gold", 10);
}

void kill_ob(object me) {
  command("stare");
  command("exert jianshen");
  ::kill_ob(me);
}
void init() {
  object me = this_player();
  ::init();

  if (me->query_temp("xiaoyao_see") && !me->query("xiaoyao_son")) {
    command("look " + me->query("id"));
    command("sigh"); command("poor");
    command("say 你学了什么乱78糟的武功呀。");
    me->delete_temp("xiaoyao_see");
    me->set_temp("xiaoyao_see1", 1);
    call_out("do_wait", 360, me);
  }
  if (me->query("xiaoyao_son") && me->query("id") != "fly") {
    command("look " + me->query("id"));
    command("nod " + me->query("id"));
    command("say 好徒弟,最近还好吧。");
    me->delete_temp("xiaoyao_see");
    me->delete_temp("xiaoyao_meet");
    me->delete_temp("xiaoyao_meet1");
    call_out("do_back", 20, me);
  }
  add_action("do_kneel", "kneel");
  add_action("do_kneel", "gui");
  add_action("do_turn", "turn");
  add_action("do_chongfu", "chongfu");
}

int do_kneel(string arg) {
  object me, xiaoyao;
  int number;
  me = this_player();
  xiaoyao = this_object();
  number = me->query_temp("xiaoyao_kneel");

  if (!me->query_temp("xiaoyao_see1")) return 0;
  if (!arg) return 0;
  if (arg == "shu sheng" ||
    arg == "shusheng") {
    if (!number) {
      me->set_temp("xiaoyao_kneel", 1);
      message_vision(CYN "\n$n猛然福至心灵，向$N双膝跪倒，叫道：「求老公公叫我武功。」\n" NOR, xiaoyao, me);
      me->set_temp("xiaoyao_kneel", 1);
      /*
             if ((string)me->query("gender") == "女性") { 
                command("hmm " + me->query("id"));
                command("say 可惜你是女孩子，我这门武功你是学不得的了。");
                message_vision("只见$N翻过身来，面向$n,想了想，道:我先教你一套武功了,不过你终竟是个女孩子....。\n",xiaoyao,me);
                message_vision("$N慢慢地推起手来，却是越来越快，最后是乱花影飞。\n",xiaoyao);
                command("say 这门武功叫落影掌。罢了，你还是先走吧。");
                command("sigh");
                me->delete_temp("xiaoyao_see1"); 
                call_out("do_back", 1, me);
                return 1;
                }
              else {
*/
      message_vision("书生无奈地摇了摇头道：「小生有急事正巧，真是对不主了！」\n", me);
      return 1;
    }
    if (number == 1) {
      message_vision(CYN "\n$n跪在地上对$N道：「你本事这麽大，定能帮我。」\n" NOR, xiaoyao, me);
      message_vision("$N甚是高兴，微微一笑，道：「你怎知我本事大？」\n", xiaoyao);
      message_vision(CYN "\n$n跪在地上却是暗暗地想：果然是千穿..那个马屁..不过这个问题可不好回答。\n" NOR, xiaoyao, me);
      message_vision(CYN "$n不由地得意起来,却是烦愁接着怎么说呢!\n" NOR, xiaoyao, me);
      command("say 你且起来吧。");
      me->add_temp("xiaoyao_kneel", 1);
      return 1;
    }
    if (number > 1) {
      message_vision(CYN "\n$n暗想：还是先跪着说好了！\n" NOR, xiaoyao, me);
      message_vision(
        CYN "\n$n忙对$N道：「你...." NOR + HIR "英俊潇洒，气宇不凡" NOR + CYN "，一看就知道是神仙人物呀！」\n" NOR,
        xiaoyao,
        me
      );
      message_vision("$N哈哈大笑，声震林梢，叫道：「好好,哈哈,你先推推手经(" NOR + HIR "turn" NOR + ")来，让我瞧瞧。」\n", xiaoyao);
      me->delete_temp("xiaoyao_kneel");
      me->delete_temp("xiaoyao_see1");
      me->set_temp("xiaoyao_see2", 1);
      return 1;
    }
  }
}
int do_turn() {
  object me, oyf;
  me = this_player();
  oyf = this_object();

  if (!me->query_temp("xiaoyao_see2")) return 0;

  tell_object(me, HIC "你心想:说不定这位神仙人物还真的受了我为徒弟，那也不错呀。\n" NOR);
  message_vision("$n当下运气手臂，练了一下，却是满头大汗，向$N道：「好公公，你就受了我吧。」\n", oyf, me);
  tell_object(me, HIC "你心想:今天怎么一点力道也没了呀。\n" NOR);
  me->delete_temp("xiaoyao_see2");
  me->set_temp("xiaoyao_see3", 1);
  if (random(me->query("kar")) >= 10 && random(5) >= 4) {
    me->set_temp("xiaoyao_see3", 1);
    call_out("xiaoyao_ask", 4, me);
    return 1;
  } else {
    call_out("xiaoyao_cure", 4, me);
    return 1;
  }
  return 1;
}
void xiaoyao_ask() {
  object me, oyf;
  me = this_player();
  oyf = this_object();

  message_vision("$N点了点头，脸有喜色，显得极是满意。\n", oyf, me);
  command("say 果然是好根骨的，好，教你不难，但你须得答应我一件事。");
  command("say 我也可以收你为徒弟。但记主：为人为善，行身要正。");
  command("say 你再重复一便(chongfu)。");
  call_out("do_wait", 320, me);
}
void do_wait() {
  object me = this_player();
  if (!me->query_temp("xiaoyao_son") && present(me)) {
    command("hmm");
    call_out("do_back", 0, me);
  }
}
int do_chongfu(string arg) {
  object me, oyf;
  me = this_player();
  oyf = this_object();

  if (!me->query_temp("xiaoyao_see3")) return 0;
  if (me->query_temp("xiaoyao_see3")) {
    if (!arg) return 0;
    me->set_temp("xiaoyao_say", 1);
    if (me->query_temp("xiaoyao_say") >= 3) {
      me->delete_temp("xiaoyao_say");
      me->delete_temp("xiaoyao_see3");
      call_out("do_wait", 0, me);
      return 1;
    }
    if (arg == "为人为善，行身要正") {
      message_vision(HIC "$N默默暗念:为人为善，行身要正！\n" NOR, me);
      message_vision(HIC "$N自想自己所做所为，不由汗颜！\n" NOR, me);
      message_vision(HIC "$N心中一动，真情流露，一声“师傅，师傅,我错了”冲口而出！！\n" NOR, me);
      me->set_temp("xiaoyao_say", 1);
      remove_call_out("do_wait");
      call_out("do_cure", 4, me);
      return 1;
    } else {
      command("hmm");
      command("say 怎么了,快重复呀。");
      command("say 这个决心都没有?");
      me->add_temp("xiaoyao_say", 1);
      return 1;
    }
    return 1;
  }
}
void do_cure(object me) {
  object oyf;
  oyf = this_object();

  command("haha");
  command("say 只要以后能够做到我告你的话，也就可以了。");
  command("say 好徒弟，来，我给你活动活动经脉。");


  message_vision(CYN "\n只见$N翻过身来，捏住手臂推拿几下，只听你的骨骼乱响几声。\n" NOR, oyf);
  message_vision(CYN "\n$N轻轻咳嗽了一声。\n" NOR, oyf);

  command("say 好啦！为师再把以前的行走江湖的武功也传给你。");
  tell_object(me, HIC "\n书生开始给你讲解摩云手的入门功夫。。。\n" NOR);
  tell_object(me, HIG "\n书生说了一会儿,就站起来了,慢慢演示起来.....\n" NOR);
  me->delete_temp("xiaoyao_see3");
  me->set("xiaoyao_son", 1);
  call_out("do_teach", 5, me, oyf);
  return;

}

void do_teach(object me, object oyf) {
  int i, lvl = 1;
  mapping skills;
  string *sk;
  oyf = this_object();

  if (random(me->query("int")) >= 10 && random(9) == 1) {
    message_vision("$N开始还是慢慢地推起手来，却是越来越快，最后是乱花影飞。\n", oyf);
    message_vision("$N看你目瞪口呆地样子,微微一笑.......\n", oyf);
    tell_object(me, HIR "\n书生接着给你讲解摩云手的基本技巧和基本手法。\n" NOR);
    me->set("xiaoyao_moyun-shou", 1);
    me->set_skill("moyun-shou", 101);
    skills = me->query_skills();
    if (mapp(skills)) {
      sk = keys(skills);
      for (i = 0; i < sizeof(sk); i++)
        skills[sk[i]] += lvl;
    }
    me->add("combat_exp", me->query("combat_exp") / (50 - lvl) + lvl);
    me->add("shen", me->query("shen") / (10 - lvl));
    tell_object(
      me,
      HIY "---------------" NOR + HIG + FLA "你的功夫提高了！" NOR + NOR + HIY "---------------\n" NOR
    );
    call_out("do_back", 15, me);
  } else {
    command("hmm");
    command("say 你怎么这么不开窍呀。");
    command("say 本可以传你为师的得意武功，怎奈你不是个练武的材料。");
    command("look " + me->query("id"));
    command("say 但毕竟是我的徒弟,也罢,只有帮你提高提高你现有的武功了。");
    skills = me->query_skills();
    if (mapp(skills)) {
      sk = keys(skills);
      for (i = 0; i < sizeof(sk); i++)
        skills[sk[i]] += lvl;
    }
    me->add("combat_exp", me->query("combat_exp") / (50 - lvl) + lvl);
    tell_object(
      me,
      HIY "---------------" NOR + HIG + FLA "你的功夫提高了！" NOR + NOR + HIY "---------------\n" NOR
    );
    call_out("do_back", 15, me);
    return;
  }

}
void oyf_cure(object me) {
  object oyf;
  oyf = this_object();
  if (environment(me)) {

    command("hmm");
    command("say 看起来你这娃娃还不赖吧。");
    command("say 可是....");
    command("say 算是我们无缘了。");
    command("sigh");

    call_out("do_back", 5, me);
    return;

  }
}

void do_back(object me) {
  message_vision(HIY "\n 空中忽然几声清唳，两只仙鹤在半空飞掠而过。\n\n" NOR, me);
  message_vision(HIG "\n 空中忽然几声清唳，两只仙鹤在半空飞掠而过。\n\n" NOR, me);
  call_out("do_leave", 5, me);
}

void do_leave(object me) {
  object oyf;
  oyf = this_object();
  if (environment(me)) {
    message_vision("\n$N以手击额，皱眉苦苦思索，突然间似乎想起了甚麽，登时脸色大变。\n", oyf);
    command("whisper " + me->query("id") + " " + HIG "现在有个极为厉害的对手来了，我得先行一步" NOR);
    if (me->query("xiaoyao_son")) {
      command("heng");
      command("whisper " + me->query("id") + " " + HIB "这门武功还有什么问题当可去找飞雪,也许他还能帮点忙" NOR);
      command("pat " + me->query("id"));
      command("whisper " + me->query("id") + " " + HIB "此次机遇且不可外传" NOR);
      command("whisper " + me->query("id") + " " + HIB "我就是李逍遥!" NOR);
      message_vision("\n接着$N一步跨了出去。\n", oyf);
      message_vision(MAG "身子一晃，$N已在丈许之外，早在桑树林後没了。\n\n" NOR, oyf);
      if (!me->query("xiaoyao_faith")) {
        tell_object(
          me,
          HIR "---------" NOR + HIR + FLA "你被奖励了10000点经验点！" NOR + NOR + HIR "---------\n" NOR
        );
        me->add("combat_exp", 10000);
        me->add("max_force", 100);
        tell_object(
          me,
          HIR "---------" NOR + HIR + FLA "你的内功修为提高了！" NOR + NOR + HIR "---------\n" NOR
        );
        me->set("xiaoyao_faith", 1);
      }
    }
    destruct(oyf);
  }
}
void xiaoyao_cure(object me) {
  object oyf;
  oyf = this_object();
  if (environment(me)) {
    command("hmm");
    command("look " + me->query("id"));
    command("poor " + me->query("id"));
    command("say 看起来你这娃娃还不赖吧。");
    command("say 可是....");
    command("say 算是我们无缘了。");
    if (!me->query("xiaoyao_fail")) {
      me->delete_temp("xiaoyao_meet1");
      me->set("xiaoyao_fail", 1);
    } else {
      me->add("xiaoyao_fail", 1);
      me->delete_temp("xiaoyao_meet1");
    }
    call_out("do_back", 5, me);
    return;
  }
}
