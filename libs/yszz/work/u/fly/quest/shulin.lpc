#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", GRN+FLA"柳树林"NOR+NOR);
        set("long", @LONG
泰山之上有这种地方真是不可思议,这片柳树林便泰山半空中，柳条
随风飘摆，宛如仙子起舞。时不时还有一两只林中鸟兽从你身前跑过，
当真是个好地方。前面悬崖耸立，无法再行。
LONG);
 
        set("no_sleep_room", 1);

        set("objects", ([
                        "/u/fly/quest/npc/shusheng" : 1, 
        ]));       

        set("exits", ([
              "east" : __DIR__"quest_where",
        ]));

        setup(); 
//      replace_program(ROOM);
}

int valid_leave(object me, string dir)
{
        if (objectp(present("shu sheng", environment(me))) && 
            dir == "east")
                return notify_fail("呼的一声，书生已跃过你头顶，落在身前,笑呵呵地道:既为有缘人，何必这么急着走呢。\n");
        return ::valid_leave(me, dir);
}
