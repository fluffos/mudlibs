// by fly_2000/12/4

inherit NPC;
#include "/u/fly/job/npc/skill.h"
#include <ansi.h>

string *color_title = ({
  HIC "[逍遥山庄]二代弟子" NOR,
  HIY "[截教]散仙" NOR,
  HIM "[倥侗山]隐仙" NOR,
  HIM "[七毒谷]杀手" NOR,
});

void create() {
  set_name("", ({ "killer" }));
  set("title", color_title[random(sizeof(color_title))]);
  set("gender", "男性");
  set("age", random(20) + 25);
  set("str", 25 + random(5));
  set("int", 25 + random(5));
  set("con", 25 + random(5));
  set("per", 25 + random(5));
  set("attitude", "friendly");

  setup();
  add_money("silver", random(20) + 10);

}
int do_make(object ob) {
  mapping myskills;
  string *sk_names, weapon;
  int max_level, kee, sen, neili, mana, exp;
  string t_force, t_dodge;

  kee = ob->query("max_kee");
  sen = ob->query("max_sen");
  neili = ob->query("max_force");
  mana = ob->query("max_mana");
  set("max_kee", (kee + random(kee)));
  set("max_sen", (sen + random(sen)));
  set("max_neili", (neili + random(neili)));
  set("max_mana", (mana + random(mana)));
  exp = ob->query("combat_exp");
  set("combat_exp", (exp + random(exp)));
  set("enforce_factor", neili / 50);
  reincarnate();
  myskills = skills[random(sizeof(skills))];
  t_force = k_force[random(sizeof(k_force))];
  t_dodge = k_dodge[random(sizeof(k_dodge))];

  set_skill("force", max_level);
  set_skill(t_force, max_level);
  map_skill("force", t_force);  // force和dodge是一定的。
  set_skill("dodge", max_level);
  set_skill(t_dodge, max_level);
  map_skill("dodge", t_dodge);
  set_skill("parry", max_level);
  set_skill(myskills["b_skill"], max_level);
  set_skill(myskills["t_skill"], max_level);
  map_skill(myskills["b_skill"], myskills["t_skill"]);
  map_skill("parry", myskills["t_skill"]);
  if ((weapon = myskills["weapon"])) {
    carry_object(weapon)->wield();
  }
  return 1;
}
void init() {
  object me = this_player();

  if (me->query_temp("msy_job"))
    call_out("kill_ob", 0, me);
}

void die() {
  object killer;
  if (objectp(killer = query_temp("last_damage_from"))
    && killer->query_temp("msy_job"))
    killer->add_temp("msy_job", 1);
  ::die();
}

void kill_ob(object me) {
  if (query("target_id") != me->query("id")) {
    do_make(me);
    set_leader(me);
    set("target_id", me->query("id"));
  }
  ::kill_ob(me);
}
