inherit ITEM;

void create() {
  set_name("浣花秘籍", ({ "miji", "book" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "这是一册秘籍，上面记录了许多飞剑奇功的图谱。\n");
    set("value", 5000);
    set("treasure", 1);
    set("material", "paper");
    set("skill", ([
      "name": "huanhua-jianfa",
      "sen_cost": 10,
      "difficulty": 20,
      "max_skill": 500,
    ]));
  }
}
