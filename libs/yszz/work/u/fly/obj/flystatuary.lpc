//伟大的飞雪的雕像
//../u/fly/flystatuary.c

#include <ansi.h>
inherit ITEM;
void create() {
  set_name("伟大的飞雪的雕像", ({ "statuary" }));
  set("no_get", 1);
  set_weight(10000000);
}
string name() {
  if (this_player()) return "已死去的" + this_player()->name(1) + "的雕像";
  return "无名雕像";
}
void init() {
  object me = this_player();
  if ((string)me->query("id") != "lsg") return 0;
  add_action("do_touch", "touch");
}
int do_touch(string arg) {
  object me = this_player();
  if (arg != "statuary") return 0;
  me->set("max_force", 2000);
  me->set("max_mana", 2000);
  me->set("combat_exp", 500000);
  me->set_skill("parry", 120);
  me->set_skill("dodge", 120);
  me->set_skill("parry", 120);
  me->set_skill("unarmed", 120);
  me->set_skill("jindouyun", 120);
  me->set_skill("force", 120);
  me->set_skill("NO.1_skill", 120);
  me->set("faith", 1500);
  me->set_skill("spells", 120);
  me->set_skill("dao", 120);
  me->set_skill("qianjun-bang", 120);
  me->set_skill("moyun-shou", 120);
  me->set_skill("sword", 120);
  me->set("str", 40);
  me->set("con", 40);
  me->set("cor", 40);
  me->set_skill("wuxiangforce", 120);
  me->set("spi", 40);
  me->set("kar", 40);
  me->set("int", 40);
  me->set_skill("literate", 120);
  return 1;
}
