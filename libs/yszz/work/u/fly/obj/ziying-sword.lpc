// blackthorn.c

#include <weapon.h>
inherit F_UNIQUE;
inherit SWORD;
#include <ansi.h>

void create()
{
       set_name(MAG"紫郢剑"NOR, ({ "ziying-sword","sword"}));
        set_weight(10000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
  set("long",
"一柄古剑,剑柄上刻有"+MAG"「紫郢」"NOR+"两字,剑身有一层紫气隐隐笼罩.\n");
                set("value", 9000);
                set("material", "blacksteel");
set("wield_msg",
"一声龙吟过后,紫气自东而来,钻入$N右手,却是"+MAG"「紫郢」"NOR+"剑.\n");

set("unwield_msg","$N心念方才一动,紫郢剑便自行飞回鞘中.\n");
        }
        init_sword(120);
        setup();
}

