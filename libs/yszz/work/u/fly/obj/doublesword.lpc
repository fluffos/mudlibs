// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

// blackthorn.c

#include <weapon.h>

inherit SWORD;
#include <ansi.h>

void create() {
  set_name("紫青双剑", ({ "doublesword" })
  );
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "对");
    set("long",
      "一对古剑,剑柄上分别刻有" + MAG "「紫郢」" NOR + "，" + HIG "「青索」" NOR + "两字.\n"
      "剑身隐有紫青两色霞光流动,看起来是一对神兵利器.\n");
    set("value", 9000);
    set("material", "blacksteel");
    set("wield_msg",
      "两道眩目的紫青剑光闪过,双剑不知何时已飞入你的掌中.\n");

    set("unwield_msg", "$N心念方才一动,双剑便自行飞回鞘中.\n");
  }
  init_sword(120);
  setup();
}
