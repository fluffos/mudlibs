inherit NPC;
#include <ansi.h>

void create() {
  set_name(
    HIG "飞天" NOR + HIC "_" NOR + HIG "神龙" NOR,
    ({ "feitian shenlong", "feitianshenlong", "shenlong", "long", "dragon" })
  );
  set("long", RED + FLA "\n飞天神龙。\n" NOR + NOR + HIY "没人知道这条神龙的来历,但每个人都知道它的威力\n" NOR);
  set("race", "野兽");
  set("age", 10);
  set("age", 30);
  set("combat_exp", 200000000);
  set("limbs", ({ "头部", "身体", "前脚", "後脚", "尾巴" }));
  set("verbs", ({ "bite" }));
  set("ride/msg", "骑");
  set("ride/dodge", 35);
  set_temp("apply/attack", 120);
  set_temp("apply/armor", 120);

  setup();
}
