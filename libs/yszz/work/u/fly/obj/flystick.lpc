//定海神针
#include <weapon.h>
#include <ansi.h>
inherit STICK;
inherit F_UNIQUE;
void create() {
  set_name(BLU "★" + MAG "定海神针" + BLU "★" NOR, ({ "flystick", "stick" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", HIM "这是南海用来擎天支海的宝物\n当年齐天大圣西天取经时候曾带走,取经后已换会南海,只是外人不知而已\n");
    set("rigidity", 8);
    set("weapon_prop/parry", 50);
    set("weapon_prop/dodge", 50);
    set("material", "steel");
    set("sharpness", 8);
    set("rigidity", 8);
    set("value", 1);
    set("unit", "根");
    set("unwield_msg", HIY "$N随手一挥，手中定海神针神剑已不见踪影。姿态潇洒无比。\n" NOR);
  }
  init_stick(1000);
  setup();
}
void init() {
  add_action("do_wield", "wield");
}
int do_wield(string arg) {
  object me, ob;
  me = this_player();
  ob = this_object();
  if (!arg) return 0;
  if (arg == "stick" || arg == "flystick") {
    if ((int)me->query("max_force", 1) < 3000 ||
      (int)me->query("force", 1) < 4000) {
      tell_object(me, "你感觉全身气息翻腾，原来你内力不够，提不起这把定海神针。\n");
      return 1;
    }
    if ((int)me->query_str() < 100) {
      tell_object(me, "你想举起这把定海神针，怎奈力量不够，只好作罢。\n");
      return 1;
    }
    ob->wield();
    set("wield_msg", HIC "$N仰天一笑，手里已多了根奇怪玩意,接着$N朗声叫到:变 变 变 只见,$N手里多了一把定海神针。\n" NOR);
    me->add("force", -100);
    return 1;
  }
}
