#include <armor.h>
#include <ansi.h>

inherit BOOTS;
inherit F_UNIQUE;
void create()
{
set_name( HIM "★"+HIC"逍遥神行靴"+HIM"★" NOR, ({"xue" }) );
  set_weight(1000);
  if( clonep() )
    set_default_object(__FILE__);
  else {
    set("unit", "双");
    set("long", "这不是啸傲神妖万年的玄天仙子的逍遥神靴吗?\n");
    set("value", 120);
    set("material", "boots");
    set("no_sell",1);
    set("material", "boots");
    set("armor_prop/spells",200);
    set("armor_prop/dodge", 200);
  }
  setup();
}
