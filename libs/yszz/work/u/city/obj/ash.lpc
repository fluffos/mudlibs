// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */
 

inherit ITEM;

void create()
{
        set_name("灰烬", ({ "ash" }) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "堆");
                set("no_get",1);
                set("long", "一堆带着余火的灰烬。\n");
                set("value", 50);
        }
}


