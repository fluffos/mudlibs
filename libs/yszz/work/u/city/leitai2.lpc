    妖       神      之       争        比        武      大        会  

※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※

LONG
        );
        
       set("exits", ([
                "down" : __DIR__"center",
                    ]));
        set("objects",([
                __DIR__"npc/ys":1,
        ]));
       set("alternative_die",1);
       setup();
}

void init()
{

        remove_call_out("check");
        call_out("check",1);
        add_action("do_kill","kill");
        add_action("do_drop","drop");
        add_action("do_down","d");
        add_action("do_down","down");
        add_action("do_down","go");
        add_action("do_none","du");
        add_action("do_none","study");
        add_action("do_none","read");
        add_action("do_none","ji");
        add_action("do_none","touxiang");
         add_action("do_none","perform");
        add_action("do_none","cast");
        add_action("do_none","surrender");
}

int do_none()
{
        object ob = this_player();
        tell_object(ob,HIG"比武要紧，且不可分心！\n"NOR);
        return 1;
}

int do_kill()
{
        object ob = this_player();
        tell_object(ob,HIG"擂台之上，且不可行凶。\n"NOR);
        return 1;
}
int do_drop()
{
        object ob = this_player();
        tell_object(ob,HIG"擂台之上，不要乱丢东西！\n"NOR);
        return 1;
}

void check()
{
        object me = this_object();
        object room=load_object("/obj/empty");
        int i;
        object *inv;
        inv = all_inventory(me);
        
        for(i=0;i<sizeof(inv);i++)
        {
                if(inv[i]->query("id") == "ys spirit") return ;
                if(interactive(inv[i])) return ;
                inv[i]->move(room);
        }
        remove_call_out("check");
        call_out("check",1);
}

int do_down()
{
        object me = this_player();
  if( me->query("kee") <= 0 )
   me->set("kee",2);
  if( me->query("sen") <= 0)
   me->set("sen",2);
  if( me->query("eff_kee") <= 0 )
   { 
  me->set("kee", 1);
  me->set("eff_kee",me->query("max_kee"));
  }
  if( me->query("eff_sen") <= 0 )
{
  me->set("sen", 1);
  me->set("eff_sen",me->query("max_sen"));
}
        tell_room(environment(me),me->name()+"向下离去。\n");
        me->move(__DIR__"center");
        me->remove_all_killer();
        return 1;
}
