void init() {
  add_action("do_look", "look");
}
void write_objects(object room, object who) {
  mixed *inv = all_inventory(room);
  int i = sizeof(inv);

  while (i--) {
    object ob = inv[i];
    if (!who->visible(ob) || ob == who)
      continue;

    write("  " + ob->short() + "\n");
  }
}

int do_look(string arg) {
  object who = this_player();
  object room = environment(who);

  if (arg != "up")
    return 0;

  LOOK_CMD->look_room(who, room);

  room = load_object(__DIR__ "leitai2");
  if (!room)
    return 1;

  write("\n        －－－－－－－〖赛场内〗－－－－－－－\n");
  write(room->query("long"));
  write_objects(room, who);
  write("\n        －－－－－－－－－－－－－－－－－－－\n");
  return 1;
}
int valid_leave(object me, string dir) {
  object room = load_object(__DIR__ "leitai2");
  object *inv;
  inv = all_inventory(room);
  if (dir == "up") {
    if (sizeof(inv) >= 3)
      return notify_fail("台上有人比武，请稍后。\n");
  }
  return ::valid_leave(me, dir);
}
