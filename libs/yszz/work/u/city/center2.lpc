向长安城的大街小巷。路口车水马龙，来往人潮不断。

LONG);

  //set("item_desc", ([" *** " : " *** ", ]));

  set("exits",
    ([  //sizeof() == 4
    "south": __DIR__ "zhuque-s1",
      "north": __DIR__ "xuanwu-n1",
      "west": __DIR__ "baihu-w1",
      "east": __DIR__ "qinglong-e1",
