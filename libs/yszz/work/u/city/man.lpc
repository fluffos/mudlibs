int valid_leave(object me, string dir)
{
        if( dir=="south" && me->is_busy() )
        message("channel:rumor",HIM"【谣言】："+me->query("name")+"还没有提裤子就要到大街上。\n"NOR,users());
        return ::valid_leave(me, dir);
}

