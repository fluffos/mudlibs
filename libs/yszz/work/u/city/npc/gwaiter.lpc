#include <ansi.h>
 
inherit NPC;

void create()
{
   set_name(HIC "女招待" NOR,({ "girl" }) );
        set("gender", "女性" );
        set("age", 12);
   set("long", "这是个漂亮的女招待, 身材真是没得说, 正妩媚地看着你。\n");
        set_temp("apply/defense", 5);
   set("combat_exp", 70);
   set("str", 14);
        set("dex", 15);
   set("per", 25);
   set("con", 16);
        set("int", 15);
        set("attitude", "friendly");
   setup();
   carry_object("/d/obj/cloth/three.lpc")->wear();
   add_money("coin", 50);
}

void init()
{
	object ob;

	::init();
	set("chat_chance",25);
	set("chat_msg", ({
		"女招待向你招了招手,帅哥,到这里来看看吧.\n",
		"女招待自言自语:这些穷小子, 没有几十万也想买车!\n",
		"女招待捶了捶自己的腿, 好象有些累了. \n",
	}) );
}
