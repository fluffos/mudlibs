// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

#include <ansi.h> 
inherit NPC;
string ask_xuewu();
void create()
{
        set_name("范青屏", ({"fan qingping", "fan"}));
        set("age", 72);
        set("gender", "男性");
        set("long",
"范老拳师壮年时也是响当当的英雄，现在虽老了，手脚利落却不输当年．\n");
   set("title", "拳盖三省");
        set("attitude", "friendly");
   set("max_kee", 800);
   set("max_sen", 700);
        set("combat_exp", 100000);
        set("shen_type", 1);
   set("max_force", 300);
   set("force", 300);
   set("force_factor", 15);
        set_skill("unarmed", 100);
   set_skill("changquan", 100);
        set_skill("dodge", 100);
        set_skill("parry", 100);
   map_skill("unarmed", "changquan");
   set("chat_chance",1);
        set("chat_msg", ({
        "范青屏叹道：腿脚不利落了，也没人去给我提笼小二的包子来。\n",}));
        set("inquiry", ([
                "学武" : (: ask_xuewu :),
                "xuewu": (: ask_xuewu :), 
                       ]));
   setup();
        carry_object("/d/obj/cloth/choupao")->wear();
   carry_object("/d/obj/book/quanjing");
   add_money("gold",1);
}

int accept_object(object who,object ob)
{
        if (ob->query("id")=="zhurou bao"){
   command("say 嘿嘿，老二这包子是越做越小了。\n");
   command("say 不过还是要谢谢你呀！\n");
   command("give jing to " + who->query("id"));
   return 1;
   }
   return 0;
}

string ask_xuewu()
{
        object ob = this_player();
        if( ob->query_skill("unarmed",1) > 30 )
                return("“您客气了。”\n");
        if( ! ( ob->query_temp("money_give")) )
                return("“咱们这也不是清水衙门，我看你还是先到外面交点学费再来吧。\n");
        message("channel:chat",HIC"【闲聊】范青屏(Fan qingping)：欢迎"+ob->query("name")+"到长安武馆学武。\n"NOR,users());
        ob->set_temp("xuewu",1);
        return("\n你可以到里面学习基本拳脚了。\n");
}
