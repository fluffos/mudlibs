int accept_object(object who,object ob)
{
        object obj;

        if ( (string)ob->name() == HIM "魔鞭翩珑" NOR) {
                command("say 你怎么知道我喜欢这根魔鞭。");
                command("smile");
                command("say 为了答谢你，这本书送你，当做报酬吧。");
                obj=new("/d/obj/book/forcebook3");
                obj->move(who);
//              call_out( (: destruct :), 1, ob);
