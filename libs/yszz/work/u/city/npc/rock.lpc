inherit NPC;
#include <ansi.h>
inherit F_MASTER;
inherit F_QUEST;

void create()
{
    set_name(HIG "月亮" NOR, ({ "rock" }) );

	set("gender", "女性");
	set("age", 16);
	set("long",
		"他年方二八，温柔漂亮。更是武林中有名的赌王,因此被重金聘
到长安这家'天下坊'来当顾问. \n");
	set("attitude", "peaceful");
        set("skill_public",1);
	set("str", 26000);
	set("cor", 300);
	set("int", 240);
	set("cps", 300);
        set("chat_chance", 50);
        set("chat_msg", ({
        "月亮向来人大声的说：“快进来赌两手巴.赌多赢多,赌少少赢．．．．\n,"
        }) );

         set("inquiry", ([
        "book" : "我干吗要告诉你? 你又不给我什么好处? \n",
        ]) );
	set("force", 40000);
	set("max_force", 80000);
	set("force_factor", 1000);

	set("combat_exp", 10000000);
	set("score", 200000);

	set_skill("unarmed", 1200);
	set_skill("force", 1000);
	set_skill("iron-cloth", 1000);
	set_skill("yiqiforce", 300);
	set_skill("dagger",2000);
	set_temp("apply/attack",3000);
	set_temp("apply/damage",300000);
	map_skill("iron-cloth", "yiqiforce");
        map_skill("force", "yiqiforce");
        map_skill("unarmed", "yiqiforce");

	create_family("潇遥派", 1, "祖师");
	set("title",HIR "赌圣"NOR);
	setup();

//	carry_object("obj/baojia")->wear();
//	carry_object("obj/weapon/sword")->wield();
}
int accept_fight(object me)
{
        command("say 生命可贵！不要自寻死路！");
        return 0;
}
