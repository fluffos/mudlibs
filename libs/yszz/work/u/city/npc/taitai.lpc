// garrison.c

#include <ansi.h>

inherit NPC;

void create()
{
        set_name("就业介绍人", ({ "introducer"  }) );
        set("long",
                "他可是福利院的好人哦.\n");

	set("gender","女性");
        set("str", 27);
        set("cor", 26);
        set("cps", 25);
	set("age", 99);
        set("combat_exp",10000000);
        set("nkgain",50);
        setup();
        carry_object("obj/cloth")->wear();
}

void init()
{
        ::init();
        add_action("do_work", "work");

}
int do_work(string arg)
{
        object ob;
        object me;
        me = this_player();
if(this_player()->query("age") < 15 ) return notify_fail("我们这不要童工.\n");
if(me->is_busy()) return notify_fail("你的动作还没有完成，不能工作。\n");
message_vision("$N辛苦的工作终于结束了，可人也累的要死\n",me);
me->add("kee",-30);
me->add("sen",-30);
ob = new("/obj/money/gold");
ob->move(me);
message_vision("就业介绍人$N说：这是你的工钱。\n", me);
me->start_busy(1);
return 1;
}
