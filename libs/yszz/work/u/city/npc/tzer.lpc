#include <ansi.h>
inherit NPC;

string *names = ({
  "[33m亚力山大[m",
  "[31m范·扎儿[m",
  "[32m斯德巴诃夫[m",
  "[33m小野次郎[m",
  "[34m拉德·克莱[m",
  "[35m里而克[m",
  "[36m巴得拉[m",
  "[1;33m杜拉[m",
  "[32m法西摩尔[m",
  "[1;35m奥古斯都[m",
  "[1;37m法尔泰[m",
  "[32m金新煊[m",
});
string *nations = ({
   "[32m英吉利[m",
   "[35m波斯[m",
   "[32m俄罗斯[m",
   "[31m扶桑[m",
   "[32m花剌子模[m",
   "[33m比利时[m",
   "[34m荷兰[m",
   "[35m法兰西[m",
   "[36m葡萄牙[m",
   "[32m孟买[m",
   "[35m印加帝国[m",
   "[33m高丽[m",
                });
void create()
{
  int i = random(sizeof(names));
  set_name(names[i], ( {"challenger"}) );
  set("age", 25 + random(10) );
  set("nation", nations[i] );
  set("max_kee", 100*(1+random(5)) );
  set("kee",500);
  set("max_sen", 100*(1+random(5)) );
  set("sen",500);
  set("max_force", 100*(1+random(5)) );
  set("force_factor", 10*(1+random(5)) );
  set("force", 800);
  set("combat_exp", 200000*(1+ random(5)) );
  set_skill("sword", 15*(random(10)+1));
  set_skill("westsword", 15*(random(10)+1));
  set_skill("unarmed",15*(random(10)+1));
  set_skill("parry",15*(random(10)+1));
  set_skill("dodge",15*(random(10)+1));
  set_skill("balei",15*(random(10)+1));
  set_skill("boxing",15*(random(10)+1));
  map_skill("sword", "westsword");
  map_skill("unarmed","boxing");
  map_skill("parry", "westsword");
  map_skill("dodge", "balei");  
 

  setup();
  carry_object("/d/obj/weapon/sword/westsword")->wield();
//  carry_object("/d/obj/cloth/westcloth")->wear();
}
void init()
{
   object ob=this_player(), me=this_object();
   ::init();
                   remove_call_out("greeting");
                   call_out("greeting", 1, ob);
}
void greeting(object ob)
{
        object me=this_object();
        if( !ob || environment(ob) != environment() ) return;
     command("bow "+ ob->query("id"));
     command("say 你我决斗一场，一比高低如何？");
     command("fight " + ob->query("id"));
}

int accept_fight(object ob)
{
        object me = this_object();
        me->set("eff_kee", me->query("max_kee"));
        me->set("kee",     me->query("max_kee"));
        me->set("gin",   me->query("max_gin"));
        me->set("force",  me->query("max_force"));
        remove_call_out("checking");
        call_out("checking", 1, me, ob);
        return 1;
}
int checking(object me, object ob)
{

        object obj;
        int my_max_kee, his_max_kee;

        my_max_kee  = me->query("max_kee");
        his_max_kee = ob->query("max_kee");

        if (me->is_fighting()) {

                call_out("checking", 1, me, ob);
                return 1;
        }

        if ( !present(ob, environment()) ) return 1;

        if (( (int)me->query("kee")*100 / my_max_kee) <= 50 ) {
                command("say 我输了，大唐真是人才辈出啊。\n");
 message("channel:chat",HIR"【心服口服】"+me->query("name")+"(challenger)：" + ob->query("name") + "果然了得，在下甘拜下风，看来我得回"+me->query("nation")+"再修炼几年了。\n"NOR,users());
                me->delete_temp("accept");
                this_player()->move("/u/city/center");       
                remove_call_out("give_reward");
                call_out("give_reward", 1, me, ob);
                return 1;
        }

        if (( (int)ob->query("kee")*100 / his_max_kee) < 50 ) {
command("chat 看来唐朝真的没人了，连"+ob->query("name")+"这样的渣子也要和我决斗。\n");
                me->delete_temp("accept");
                destruct(me);
                return 1;
        }

        return 1;
}

void give_reward(object me, object ob)
{
        ob->add("combat_exp", 300*(random(3)+1) );
        ob->add("potential",  100*(random(3)+1) );
        destruct(me);
}

void die()
{
        destruct(this_object());
}
