inherit ROOM;
#include <ansi.h>
void create()
{
  set ("short", "[0;32m武馆内部[m");
  set ("long", @LONG

一进来就听到一群人习武的声音，你不禁热血沸腾，浑身是劲，
也想习武(xiwu)起来。
LONG);
        set("objects", ([
                __DIR__"npc/dizi": 2, 
                                                
]));
        set("exits", ([ /* sizeof() == 2 */
        "west" : __DIR__"wuguanzhong",
]));
  setup();
}

void init()
{
        add_action("do_xiwu","xiwu");
}

int do_xiwu()
{
   object me = this_player();
   if(me->is_busy())
      return notify_fail("你正忙着呢。\n");
    if ( (int)me->query("unarmed",1) > 30)
        return notify_fail("你已经不用在这学习了。");
   tell_object( me,"你听着教练的指导，觉得自己进步的很快。\n");
   me->start_busy(1);
   me->improve_skill("unarmed",20);
   me->receive_damage("kee",10);
   me->receive_damage("sen",10);
   message_vision("$N觉得扑击格斗之术进步了!\n",me);
   me->set_temp("xiwu_done",1);
   return 1;
}
int valid_leave(object me, string dir)
{

   if (dir == "west"  && (int)me->query_skill("unarmed",1) >= 30 )
        message("channel:chat",HIC"【闲聊】范青屏(Fan qingping)：恭喜"+me->query("name")+"从本馆合格毕业，江湖路上保重啊，为师只能教你这么多了。\n"NOR,users());
        return ::valid_leave(me, dir);
}
