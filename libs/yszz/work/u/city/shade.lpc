// This is a room made by roommaker.
#include <room.h>
#include <login.h>
#include <ansi.h>

inherit ROOM;

int block_cmd(string);
void create() {
  set("short", HIC "兔宝宝菜园");
  set("long", HIG "这是兔宝宝种萝卜的地方,别乱飞进来,把地踩坏了,兔子发火可不得了!!!\n");
  set("no_magic", 1);
  setup();
  set("exits",
    ([ "down": __DIR__ "center",
    ]));
  set("outdoors", "changan");
  set("no_clean_up", 0);
  setup();
  set("valid_startroom", 1);
  setup();
  call_other("/obj/board/nancheng_b", "???");
}

void init() {
  add_action("block_cmd", "", 1);
}
int block_cmd(string args) {
  string verb;
  verb = query_verb();

  if (verb == "bian") return 1;
  if (verb == "xiudao") return 1;
  if (verb == "exert") return 1;
  if (verb == "cast") return 1;  //by cjl
  if (verb == "fly") return 1;  //by cjl
  return 0;
}

int valid_leave(object me, string dir) {
  if (me->query("id") == "happ") return ::valid_leave(me, dir);
  if (me->query("id") == "njrmc") return ::valid_leave(me, dir);
  if (me->query("id") == "meokey") return ::valid_leave(me, dir);
  if (dir == "down")
    return notify_fail(HIC "这是兔子们才能走的路,老实呆着吧!!!\n");
  return ::valid_leave(me, dir);
}
