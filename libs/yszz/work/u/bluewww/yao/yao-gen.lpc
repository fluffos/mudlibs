inherit NPC;
string *dirs = ({
"baoxiang",
"biqiu",
"chechi",
"fengxian",
"jinping",
"jisaiguo",
"nuerguo",
"tongtian",
"qinfa",
"tianzhu",
"wudidong",
"wuji",
"yuhua",
"zhuzi",
});   
int cast_chance(int level)
{
    return 10+level/2;
}
// here should be this NPC specific skills.
void set_skills(int j)
{
}
int set_yao_skill()
{
    int exp=query("combat_exp");
    int level=70;

    exp=exp/4;
    while(level*level*level/10<exp)level=level+10;
    set_skills(level);
}
int get_exp(int i)
{
   int exp=10000;

   if(i>=3)exp=exp*10;
   if(i>=10)exp=exp*10;
   if(i>=17)exp=exp*10;
   return exp;
}
void set_yao_exp()
{
    int i,j,expbase;

    i=random(20);
    expbase=get_exp(i);
    j=random(10);
    if(j<2)set("subtitle","小");
    else if(j<4)set("subtitle","中小");
    else if(j<6)set("subtitle","中");
    else if(j<8)set("subtitle","中大");
    else set("subtitle","大");
    set("name",query("subtitle")+query("name"));
    set("combat_exp",expbase*j+expbase/10*random(10));
}
void set_status()
{
    int exp,i,j;
    int max_sen, max_kee;
    set_yao_exp();
    set_yao_skill();

    max_sen=query_skill("spells");
    max_kee=query_skill("force");
    set("max_force",max_kee*10);
    set("force",max_kee*15);
    set("force_factor",max_kee/5);
    set("max_mana",max_sen*10);
    set("mana",max_sen*15);
    set("mana_factor",max_sen/4);

    max_kee=max_kee*3+800;
    max_sen=max_sen*4+600;
    set("eff_sen",max_sen);
    set("eff_kee",max_kee);
    set("sen",max_sen);
    set("kee",max_kee);
    set("max_sen",max_sen);
    set("max_kee",max_kee);
}
int random_place(object me, string loc)
{
        int  j, k;
        object  newob;
        mixed*  file, exit;
        file = get_dir( loc+"/*.lpc", -1 );
        if( !sizeof(file) )             return 1;
 for(k=0;k<30;k++) { // try 20 times
           j = random(sizeof(file));
           if( file[j][1] > 0 ) {
             newob=load_object(loc+"/"+file[j][0]);
             if (newob) {
               if(newob->query("no_fight") ||
         newob->query("no_magic") ||
         newob->query("alternative_die") ||
         !(exit=newob->query("exits")) ||
         sizeof(exit)<1)
     continue;
               if(me->move(newob)) {
     message_vision("$N走了过来。\n",me);
      me->set("location",file_name(newob));
     return 1;
        }
      }
    }
 }
        return 0;
}
void invocation()
{       object me=this_object();
        int dx;
      string title;
        string loc;
        int exp_reward,pot_reward;

 set_status();
  title=query("family/family_name");

	set("chat_chance", 5);
 set("chat_msg", ({
      (: random_move :)
 }) );


 dx=me->query("combat_exp");
        if(dx>=10000000)
  title=title+"万年";
     else if(dx>=1000000)
  title=title+"千年";
     else if(dx>=100000)
  title=title+"百年";
     else if(dx>10000)
  title=title+"十年";
     else
  title=title+"小小";

     set("title",title);
 if(random(10)==0) {
     set("env/wimpy",40);
 } else {
     set("env/wimpy",1);
 }
 // determine reward
 if(dx<30000) {
     exp_reward=1000+dx/60;
     pot_reward=400+dx/300;
 } else if(dx<300000) {
     exp_reward=2000+dx/600;
     pot_reward=600+dx/6000;
 } else if(dx<3000000) {
     exp_reward=3000+dx/6000;
     pot_reward=700+dx/60000;
 } else {
     exp_reward=4000;
     pot_reward=800;
 }

 set("reward/exp",exp_reward);
 set("reward/pot",pot_reward);

 set("attitude","heroism");
 if(!random(10))set("attitude","aggr");
	loc="/d/qujing/"+dirs[random(sizeof(dirs))];
 if(!random_place(me,loc)){
	 destruct(this_object());
 }

}
