#include <ansi.h>
#include "/u/driftpho/heart.h"

inherit ITEM;

void create() {
  set_name(HIM "星心" NOR, ({ "heart" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "记得我们的星空吗？好美！\n");
    add("long", heart_str());
    set("no_drop", 1);
    set("unit", "颗");
    set("no_get", 1);
    set("can_hang", 1);
    set("no_sell", 1);
  }
}
