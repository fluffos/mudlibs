#include <ansi.h>
#include <room.h>
inherit ROOM;

void create()
{
    set("short","多情居");
    set("long", @LONG
   问世间情是何物，
   直叫人生死相许。
LONG);
  set("exits", ([ 
  "kf" : "/d/kaifeng/tieta",
  "wizroom" : "/d/wiz/wizroom",
  "kezhan" : "/d/city/kezhan",
]));
  setup();
}
void init()
{
   add_action("do_climb", "climb");
}
int do_climb(string arg)
{
   object me=this_player();
   if( !arg || (arg!="高崖" && arg!="悬崖" && arg!="cliff") )
     return notify_fail("你要爬什么？\n");
   if(me->is_busy())
     return notify_fail("你很忙，爬什么呀！\n");
   message_vision("$N搓了搓手，扒着石头的缝隙向崖上爬去。。。\n", me);
   me->start_busy(3);
   call_out("success", 3, me);
   return 1;
}
int success(object me)
{
   message_vision("$N越爬越高，渐渐隐入了云中。。。\n", me);
   return 1;
}
