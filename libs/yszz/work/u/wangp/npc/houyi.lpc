// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */
 
inherit NPC;
string hui_xin();
void create()
{
        set_name("后羿", ({"houyi","hou yi"}));
        set("gender", "男性" );
        set("age", 33);
        set("long","后羿，传说中最勇敢的勇士，竟然以手中之弓射下九个太阳，
与嫦娥相恋，却因为西王母的干涉，被拆散了.\n");
        set("int", 40);
   set("str", 80);
        set("combat_exp", 1900000);
        set("attitude", "friendly");
   set("title", "射日英雄");
        set_skill("unarmed", 80);
        set_skill("dodge", 120);
        set_skill("parry", 120);
        set_skill("spells", 120);
        set_skill("dao", 120);
        set_skill("literate", 50);
        set_skill("sword", 120);
        set_skill("xianglong-zhang",60);   
     //   set_skill("archery",150);  
     //   set_skill("xuanyuan-archery",175);
        map_skill("unarmed","xianglong-zhang");
        map_skill("spells", "dao");
    //    map_skill("archery","xuanyuan-archery");
        set("per", 30);
        set("max_kee", 4000);
        set("max_gin", 4000);
        set("max_sen", 4000);
        set("force", 2250);
        set("max_force", 2000);
        set("force_factor", 10);
        set("mana", 2250);
        set("max_mana", 2000);
        set("mana_factor", 5);
       set ("inquiry",([
               "嫦娥": "她是我的妻子，现在被她师傅软禁在月宫中.\n",
               "回信" : (: hui_xin:),
              ]));
        setup();
      carry_object("/d/obj/armor/jinjia")->wear();
carry_object("/d/moon/obj/houyilove");
}
int accept_fight(object me)
{
        write("后羿凛然道：学武乃是为了强身，不是打打杀杀！\n");
        return 0;
}

int accept_object(object who,object ob)
{
        object me=this_object();
          if(ob->query("id")=="paper"){
     if(!(int)who->query("moon/song_xin")){
        write("后羿哼了一声:信从何而来，不说?我的娥娥定是为你所害，纳命来!\n");
        me->kill_ob(who);

       who->kill_ob(me);
        return 1;
     }
        write("后羿说道: 多谢多谢，在下真是谢谢了，不会薄待你的.\n");
        write("后羿作了一个揖，说道：好人作到底，你就帮我送封[回信]吧!\n");
        write("你觉得作了一件好事，身上轻飘飘的.\n");
        who->delete("moon/song_xin");
        who->add("faith",20);
        who->add("combat_exp",300);
        who->add("potential",50);
        who->improve_skill("dodge",1000+random(who->query("int")),1);
        who->improve_skill("moondance",1000+random(who->query("int")),1);
        call_out("destroy", 1, ob);
                        return 1;
     }
   
return 0;
}
void destroy(object ob)
{
        destruct(ob);
        return;
}

string hui_xin()
{
   object who,me;
   who=this_player();
   me=this_object();
   
     if(present("houyilove",me)){
   who->set("moon/hui_xin",1);
   command("give houyilove to " + who->query("id"));
   return "多谢了，快去吧！";
   }
}
