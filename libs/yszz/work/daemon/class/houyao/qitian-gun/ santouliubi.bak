// santouliubi
#include <ansi.h>
#include <combat.h>
inherit F_CLEAN_UP;
inherit SSERVER;
void remove_effect(object me, int amount);
int perform(object me, object target)
{
        int skill;
        if( !target ) target=offensive_target(me);
        if(!me->is_fighting())
        return notify_fail("［三头六臂］只能在战斗中使用。\n");
        if(me->query("family/family_name")!="水帘洞")
        return notify_fail("［三头六臂］是水帘洞秘技，你不知道秘诀！\n");
        
        if( (int)me->query_temp("santouliubi") )
        return notify_fail("你已经在施展［三头六臂］了。\n");
        skill = me->query_skill("qitian-gun",1);
        if(skill < 100) return notify_fail("你的齐天棍法太差了！\n");
        me->add("force", -100);
        skill = me->query_skill("qitian-gun");
message_vision( HIR "$N身体一抖，一下长出三头六臂来，每个头都怒目圆睁：蒙湃恕n六只手臂抡起三根大棒朝$n疯打，$n被打的手忙脚乱！\n" NOR, me,target);
        me->add_temp("apply/dodge", skill/3);
me->add_temp("apply/attack", skill/3);
        me->set_temp("santouliubi", 1);
me->start_call_out((: call_other, __FILE__,"remove_effect",me,skill/3 :),skill/3);
        me->start_busy(3);
        return 1;
}

void remove_effect(object me, int amount)
{
        me->add_temp("apply/dodge", - amount);
        me->add_temp("apply/attack",-amount);
        me->delete_temp("santouliubi");
        tell_object(me, "你的［三头六臂］施展完毕，身体恢复原状。\n");
}
