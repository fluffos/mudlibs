// by fly
//2000-10-20

#include <ansi.h>
#include <combat.h>
inherit F_SSERVER;
#include "/u/fly/skill/eff_msg.h";

int perform(object me, object target)
{
      object ob, tar;
        string msg,mian_tian;
        object weapon;
if( !target ) target = offensive_target(me);
if( !target
||      !target->is_character()
||      !me->is_fighting(target) )
return notify_fail(HIC"「漫天飞雪」"HIM"攻击只能对战斗中的对手使用。\n"NOR);
        if( !objectp(me->query_temp("weapon")) )
                return notify_fail("你用空手不能出来"+HIC"「剑气」"NOR+"！\n"); 
        msg = HIM "$N使出月宫不传之密「漫天飞雪」，身行顿时急若风回，轻灵似雪舞！\n" NOR;

   weapon = me->query_temp("weapon");
        if (!weapon || weapon->query("skill_type") != "sword"
          )      return notify_fail("你必须在使用剑时才能使[满天飞雪」！\n");
       if(weapon->query("id") == "snowsword")
          msg = HIR"\n$N手中风回雪舞剑连划数剑，逼出道道金光，，身行顿时急若风回，轻灵似雪舞！！\n\n"NOR;
        message_vision(msg, me, target);
me->start_busy(2);
               mian_tian=me->query("env/moon_tian");
if (!mian_tian)    {
             remove_call_out("mantian2");
          call_out("mantian2", 0, me, target);
                     }
if (mian_tian=="漫天飞雪") {
             remove_call_out("mantian1");
          call_out("mantian1", 0, me, target);
                     }
if (mian_tian!="漫天飞雪") {
             remove_call_out("mantian2");
          call_out("mantian2", 0, me, target);
                     }
       return 1;
}

int mantian1(object me, object target)
{
        string msg;
        int i, j, z;
        object weapon;
        j = me->query_skill("snowsword", 1);
        z = me->query_skill("baihua-zhang", 1);
        weapon = me->query_temp("weapon");
/*
        if(me->query_skill("snowsword", 1) < 120 )
                return notify_fail("你的特殊剑法还不够娴熟，使不出「满天飞雪」绝技。\n");
        if( (int)me->query_skill("force") < 170 )
                return notify_fail("你的内功等级不够，使不出「满天飞雪」绝技。\n");
        if( (int)me->query_str() < 50)
                return notify_fail("你的膂力还不够强劲，使不出「满天飞雪」绝技。\n");
*/
        if( (int)me->query("max_force") < 1500 )
                return notify_fail("你现在内力太弱，使不出「满天飞雪」。\n");      
        if( (int)me->query("force") < 500 )
                return notify_fail("你现在内力太弱，使不出「满天飞雪」。\n");      
   if (!me->query_temp("moon_tian"))
                            return notify_fail("没有"+HIR"西王母"NOR+"的指点，你自己领悟的了?.....省省吧!!!\n");
        if( me->query_skill("snowsword", 1) >200&&me->query_skill("moonforce", 1) >200 ){
message_vision(HIC"\n$N剑意绵绵,默运"HIB"月宫神功"HIC",只觉剑随人行，真气越奔越快。"NOR,me);
        me->add_temp("apply/dodge", 350);
          me->add_temp("apply/damage", 350);
          me->set_temp("moon_pfm", 1);
          }
        if(weapon->query("id") == "snowsword"){
          me->set_temp("moon_pfm_snowsword", 1);
        me->add_temp("apply/dodge", 350);
          me->add_temp("apply/damage", 350);
          }
        me->add_temp("apply/strength", z);
        me->add_temp("apply/attack", j);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 2);
        weapon->unequip(); 
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 2);
        weapon->wield();
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 2);
        weapon->unequip(); 
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 2);
        if(me->query_temp("moon_pfm"))
                {
        me->add_temp("apply/dodge", -350);
          me->add_temp("apply/damage", -350);
                }
        if(me->query_temp("moon_pfm_snowsword"))
                {
        me->add_temp("apply/dodge", -350);
          me->add_temp("apply/damage", -350);
                }
        weapon->wield();               
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 2);
        me->delete_temp("moon_pfm");
        me->delete_temp("moon_pfm_snowsword");
        me->add("force", -100);
        me->add_temp("apply/strength", -z);
        me->add_temp("apply/attack", -j);
        me->start_busy(1+random(2));
        return 1;
}

int mantian2(object me, object target)
{
        object ob;
        string msg;
        int extra;
        extra=me->query_skill("snowsword",1) /5;
        me->clean_up_enemy();
        ob = me->select_opponent();
        me->add_temp("apply/attack",extra);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
          me->start_call_out( (: call_other, __FILE__, "remove_effect", me,extra:),2);
        me->add("force", -200);
        me->start_busy(1+random(1));
        return 1;
}
void remove_effect(object me, int extra)
{
           extra=me->query_skill("snowsword",1) /5;
        me->add_temp("apply/attack",-extra);
        me->start_busy(1);
}
