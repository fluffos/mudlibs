// powerup.c

#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me, int amount);

int exert(object me, object target, int amount) {
  int skill;

  if (target != me) return notify_fail("你只能用冷泉神功提升自己的能力。\n");

  if ((int)me->query("force") < 500) return notify_fail("你的内力不够。\n");
  if ((int)me->query_temp("jingxin")) return notify_fail("你已经在运功中了。\n");

  skill = me->query_skill("lengquan-force", 1);
  me->add("force", -100);
  me->receive_damage("kee", 1);

  message_vision(
    HIC
    "$N微一凝神，运起冷泉神功，强行将各处潜能全部提起,全身骨节发出一阵爆豆般的声响！\n" NOR, me);

  me->add_temp("apply/attack", skill / 2);
  me->add_temp("apply/dodge", skill / 2);
  me->set_temp("jingxin", 1);
  me->start_call_out((: call_other, __FILE__, "remove_effect", me, skill / 2 :), skill
  );
  if (me->is_fighting()) me->start_busy(2 + random(1));

  return 1;
}

void remove_effect(object me, int amount) {
  if (!me) return;
  me->add_temp("apply/attack", -amount);
  me->add_temp("apply/dodge", -amount);
  me->delete_temp("jingxin");
  me->add("bellicostiy", -10);
  tell_object(me, "你的冷泉神功运行一周天完毕，将内力收回丹田。\n");
}
