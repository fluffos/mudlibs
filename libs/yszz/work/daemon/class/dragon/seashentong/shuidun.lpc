// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

inherit SSERVER;

int cast(object me, object target) {
  if (!target) target = offensive_target(me);

  if ((int)me->query("mana") < 100)
    return notify_fail("你的法力不够了！\n");
  if ((int)me->query("sen") < 100)
    return notify_fail("你的精神无法集中！\n");

  if ((string)me->query("family/family_name") != "东海龙宫")
    return notify_fail("你打算召唤水族下场大雨,可是就是没人理你！\n");
  if (environment(me)->query("alternative_die"))
    return notify_fail("在这儿很安全，你又何必逃呢?\n");

  message_vision("$N得意的叫到:风来,雨来！\n", me);

  if (me->is_fighting() && target)  //by xlwang
  {
    if (random((int)me->query("max_mana")) >
      (int)target->query("max_mana") / 2) {

      message_vision("天空忽然下起了倾盆大雨,$N借着雨水化作云雾遁去了. . .\n", me);
      me->receive_damage("sen", 100);
      me->move("/d/sea/wolongrest");
      me->remove_all_killer();
    }
    message_vision("$N刚想变化，那雨却又忽然停了！\n", me, target);
    me->receive_damage("sen", 100);
  } else {

    message_vision("天空忽然下起了倾盆大雨,$N借着雨水化作云雾遁去了. . .\n", me);
    me->receive_damage("sen", 100);
    me->move("/d/sea/wolongrest");
  }
  //        me->start_busy(1+random(2));
  return 5 + random(5);
}
