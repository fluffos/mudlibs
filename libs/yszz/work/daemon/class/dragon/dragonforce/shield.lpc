// 护体神功

#include <ansi.h>
inherit F_CLEAN_UP;
void remove_effect(object me, int amount);
int exert(object me, object target) {
  int skill;

  if ((string)me->query("family/family_name") != "东海龙宫")
    return notify_fail("你非龙族，不能使用龙神护体。\n");
  if ((int)me->query("force") < 150)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_temp("shield"))
    return notify_fail("你已经在运功中了。\n");
  skill = me->query_skill("force");
  me->add("force", -200);
  message_vision(
    HIY "$N微一凝神，身上的龙鳞闪闪发光，真似龙神附体。\n" NOR, me);
  me->add_temp("apply/armor", skill / 2);
  me->add_temp("apply/dodge", skill / 3);
  me->set_temp("shield", 1);
  me->start_call_out((: call_other, __FILE__, "remove_effect", me, skill / 2 :), skill);
  if (me->is_fighting()) me->start_busy(3);
  return 1;
}
void remove_effect(object me, int amount) {
  amount = me->query_skill("force") / 3;
  me->add_temp("apply/armor", -amount * 3 / 2);
  me->add_temp("apply/dodge", -amount);
  me->delete_temp("shield");
  tell_object(me, "你的龙神心法运行完毕。\n");
}
