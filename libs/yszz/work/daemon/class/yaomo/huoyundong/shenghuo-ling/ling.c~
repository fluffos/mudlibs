#include <ansi.h>

inherit SSERVER;
string msg;
int perform(object me, object target)
{
        object weapon;
                
        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展这一招「不知何处来兮何处终」?\n");
        weapon = me->query_temp("weapon");
        if(!me->is_fighting())
                return notify_fail("「不知何处来兮何处终」只能在战斗中使用!\n");

   if((int)me->query("max_force") < 1200)
     return notify_fail("你的内力太弱！\n");
   if((int)me->query("force") < 400 )
     return notify_fail("你的内力不足！\n");
   if((int)me->query_skill("shenghuo-ling", 1) < 100)
     return notify_fail("你的圣火令等级还不够!!\n");


    msg = HIM
"\n$N手中的"+weapon->name()+""+HIM"轻轻一颤,身形飘忽,口中吟道「来如流水兮逝如风，不知何处来兮何所终」!!\n"NOR;
message_vision(msg, me, target);
   me->delete("env/brief_message");
   target->delete("env/brief_message");
        me->set_temp("SHL_perform", 8);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        me->delete_temp("SHL_perform");
        me->add("force", -100);
        if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                }
        }

        me->start_busy(1+random(1));
        return 1;
}

