// 妖神之争 1.0

#include <ansi.h>
inherit SSERVER;

int perform(object me, object target)
{
      int def;
        string msg;
         int ap, bp, cp, extra, myexp, yourexp;
        object weapon;
        weapon = me->query_temp("weapon");
if (!weapon || weapon->query("skill_type") != "sword"  )
    return notify_fail("你必须在使用兵器时才能使用！\n");

        if(me->is_busy())
                return notify_fail("你现在没空！！\n");
        extra = me->query_skill("birds-sword",1) ;
        if ( extra < 80) return notify_fail("你的百鸟剑法还不够纯熟！\n");
        if( (int)me->query("force") < 500)
        return notify_fail("你的内力不够了!!\n");        
        if( (int)me->query("max_force") < 1000)
        return notify_fail("你的内力太弱了!\n");
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("「飞鸟投林」只能对战斗中的对手使用。\n");

        // added by happ 2000.10.26 
     
        ap = (int)me->query_skill("birds-sword",1);
        bp = (int)me->query_skill("xiaoyaoyou",1);
        cp = ap+bp;
        myexp = (int)me->query("combat_exp");
        yourexp = (int)target->query("combat_exp");
  
      msg = HIR
"\n$N双臂一震,一招「飞鸟投林」,手中的";
    msg += weapon->name();
    msg += "脱手而出,直取$n右胸.\n" NOR;
       
        if( random(myexp*5) > yourexp )
{
 def=(int)target->query_temp("apply/armor_vs_force");
  cp -=cp*def/3000;
target->receive_damage("kee",cp);
target->receive_wound("kee",cp/2);
          msg += HIC
"\n$n不及躲闪,只听「噗」地一声，被";
      msg += weapon->name();
      msg += "钉了个正着,鲜血狂涌而出.\n" NOR;
      me->start_busy(2);
 } else {
          msg += HIY
"\n$n却看出了剑尖去向,躲开了$N的飞鸟投林!!\n" NOR;
  me->start_busy(1);
}

message_vision(msg, me, target);
 if( weapon->unequip()) weapon->move(environment(me));
        return 1;
}
