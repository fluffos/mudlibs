// 妖神之争
// by happ 2000.4.22
 
#include <ansi.h>
inherit SSERVER;

int cast(object me, object target)
{
  int melv,oblv;

  melv=me->query_skill("talk");

if( ! target )
        return notify_fail("你要对谁使用金玉良言？\n");

 ( ! target->query_skill("talk",1) ? oblv=0 : oblv=target->query_skill("talk") ); 
      

if( ! me->query_skill("talk",1) )
        return notify_fail("你还不会聊天大法，如何使用金玉良言？\n");
if( me->query("combat_exp") < 10000 )
        return notify_fail("你的经验值太低！需要十年道行方可。\n");

if( time() - me->query_temp("cast_talk") < 60 )
        return notify_fail("你现在不能使用金玉良言。\n");

message_vision(HIG"\n只见$N大嘴一张，便对$n婆婆妈妈、罗里巴唆、叽叽歪歪、\n",me,target);
message_vision("哼哼叽叽、嘟嘟囊囊、嘻嘻哈哈、嘻里划拉、轲理马差、\n",me,target);
message_vision("说上一段爪哇语。\n"NOR,me,target);

  if( melv > oblv )
        {
 message_vision(HIC"只见$N被$n说的目瞪口呆。\n"NOR,target,me);
 tell_object(target,"你暂时不能说话了。\n");
 me->set_temp("cast_talk",time());
 target->set("chblk_channel/chat",time());
 return 1;
        }
  
  message_vision(HIC"$N对$n大吼一声：你在叽歪什么，给我滚！\n"NOR,target, me);
  return 1;
}
