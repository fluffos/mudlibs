// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration) {
  if (!living(me)) {
    message("vision", me->name() + "突然感觉到胸口剧痛难忍。\n", environment(me), me);
  } else {
    tell_object(me, HIB "你感觉到胸口剧痛难忍，你中的鹰爪剧毒发作了！\n" NOR);
    message("vision", me->name() + "猛咳了一阵，居然吐出一口鲜血。\n",
      environment(me), me);
  }
  me->add("kee", -80);
  me->apply_condition("yz_poison", duration - 1);
  if (duration < 1) return 0;
  return CND_CONTINUE;
}
