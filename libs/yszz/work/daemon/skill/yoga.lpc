// iron-cloth.c

inherit SKILL;
#include <ansi.h>
void skill_improved(object me) {
  int s;

  s = me->query_skill("yoga", 1);
  if (s % 10 == 9 && (int)me->query("str") < s / 4) {
    tell_object(me, HIW "由於你勤练瑜珈，你的臂力提高了。\n"
    );
    me->add("str", 2);
  }
}
int learn_bonus() {
  return 0;
}
int practice_bonus() {
  return 0;
}
int black_white_ness() {
  return 0;
}
