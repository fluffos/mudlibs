inherit SKILL;

string *dodge_msg = ({
  "$n使出一招「冥冥鸟去迟」，猛然纵起丈余，结果$N扑了个空。\n",
  "$n一招「千峰同一色」纵身跃起，倏忽已落至$N身后。\n",
  "$n双足一点，斜斜飞起，使出「皎皎孤月轮」已闪到$N身侧。\n",
  "$n一个「漠漠帆来重」，随着$N的攻势飘起，从容躲过这一招。\n",
  "$n左一摇，右一晃，一招「落月去清波」已轻松闪过。\n",
  "$n冉冉腾空而起，早以一招「江鸣夜雨悬」令$N所有招式都落在空处。\n",

});

int valid_enable(string usage) {
  return (usage == "dodge") || (usage == "move");
}

int valid_learn(object me) {
  if ((int)me->query("max_force") < 100)
    return notify_fail("你的内力不够，没有办法练风雨飘香步。\n");

  return 1;
}

string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 30
    || (int)me->query("force") < 3)
    return notify_fail("你的气或内力不够，不能练风雨飘香步。\n");
  me->receive_damage("kee", 30);
  me->add("force", -3);
  return 1;
}
int effective_level() { return 15; }

int learn_bonus() {
  return -150;
}
int practice_bonus() {
  return -200;
}
int black_white_ness() {
  return 40;
}

string perform_action_file(string action) {
  return CLASS_D("bianfu") + "/fengyu-piaoxiang/" + action;
}
