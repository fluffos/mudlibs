#include <ansi.h>
#include "/u/fly/skill/eff_msg.h";
inherit SKILL;
mapping *action = ({
  ([ "action": HIW "$N大吼一声" CYN "[天马流星]" HIW ",身体右转，屈膝弓步，右拳内旋立拳向前冲打$n" NOR,
    "force": 400,
    "dodge": 5,
    "lvl": 0,
    "damage_type": "内伤"
  ]),
  ([ "action": MAG "$N呸的一声怒吼，身子忽地拔起，一跃三尺，落在$n的面前，单拳直向$n面门" NOR,
    "force": 640,
    "dodge": 7,
    "lvl": 40,
    "damage_type": "瘀伤"
  ]),
  ([ "action": BLU "$N上体微左转,两臂外旋，从体两侧向前划弧合抱于胸，两腕搭成十字形,$n全身都笼罩在这一招之下" NOR,
    "force": 720,
    "dodge": 3,
    "lvl": 60,
    "damage_type": "瘀伤"
  ]),
  ([ "action": HIC "$N脚步摇摇幌幌的看上去马上就会跌倒
" HIB "忽然双腿一弯、一登，口中阁的一声叫喝，拳式向$n猛然击去" NOR,
    "force": 960,
    "dodge": 25,
    "lvl": 60,
    "damage_type": "瘀伤"
  ])
});

int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }

mapping query_action(object me) {
  int ran = random(6);
  if (!me) me = this_object();
  if (ran > 2 && random(me->query_str()) > 250 &&
    random(me->query("force")) > 500) {
    return ([
      "action": HIY "$N左掌阳，右掌阴，目光凝视$n，两掌向$p慢慢合拢，竟是凝重如山，却又轻灵似羽！" NOR,
      "force": 1050,
      "dodge": 10,
      "damage": 650,
      "damage_type": "内伤",
    ]);
  }
  if (ran < 2 && random(me->query_str()) > 25
    && random(me->query("force")) > 500) {
    me->add("force", -30);
    return ([
      "action": HIR "不料$N双手一圈，如抱太极，一股雄浑无比的力道组成了一个旋涡，只带得$p在原地急转七八下，
如转陀螺，如旋纺锤，好容易使出“千斤坠”之力定住身形，却已满脸胀得通红，狼狈万状！
慌乱中只听见$N大喝一声[天马流星],胸口已中圈" NOR,
      "force": 1050,
      "dodge": 10,
      "damage": 850,
      "damage_type": "内伤",

    ]);
  }
  return action[random(sizeof(action))];
}



int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练星宿毒掌必须空手。\n");
  if ((int)me->query("max_force") < 60)
    return notify_fail("你的内力太弱，无法练星宿毒掌");
  return 1;
}
int practice_skill(object me) {
  if ((int)me->query("kee") < 30)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("force") < 8)
    return notify_fail("你的内力不够练星宿毒掌。\n");
  if (me->query_skill("xingxiu-duzhang", 1) < 50)
    me->receive_damage("kee", 20);
  else
    me->receive_damage("kee", 30);
  me->add("force", -5);
  return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  //if( random(me->query_skill("huagong-dafa")) > (damage_bonus + foo)/3 )
  if (random(me->query_skill("huagong-dafa")) > 5) {
    //victim->receive_wound("kee", (damage_bonus + foo));
    victim->apply_condition("xx_poison", random(2) + 1 +
      victim->query_condition("xx_poison"));
  }
}
string perform_action_file(string action) {
  return "/u/fly/skill/" + action;
}
