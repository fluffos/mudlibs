inherit SKILL;

mapping *action = ({
        ([      "action":               
"$N使一招「我笑我歌我痴狂」，手中$w如柔枝一般卷向$n的$l",
                "dodge":                20,
		"force" :		100,
                "damage_type":  "刺伤"
        ]),
        ([      "action":               
"$N使出蔷薇剑中的「满地碎金枕玉瓣」，剑光向残照般洒向$n的$l",
                "dodge":                20,
                "force":               200,
                "damage_type":  "割伤"
        ]),
        ([      "action":               
"$N回手一招「暗香浮动月黄昏」，手中$w默默的削向$n的$l",
                "dodge":                30,
                "force":               50,
                "damage_type":  "割伤"
        ]),
        ([      "action":               
"$N手中$w一式「风起雨飘花飞舞」对准$n的$l一连刺出七剑",
                "force":                300,
                "damage_type":  "刺伤"
        ]),
        ([      "action":               
"$N的$w凭空一指，一招「笑指天南万物轻」刺向$n的$l",
                "dodge":                20,
                "force":               200,
                "damage_type":  "刺伤"
        ]),
        ([      "action":               
"$N手中$w向外一分，使一招「零落成泥辗作尘」反手对准$n$l一剑刺去",
                "dodge":                20,
                "force":               500,
                "damage_type":  "刺伤"
        ]),
});

int valid_learn(object me)
{
        object ob;

        if( (int)me->query("max_force") < 50 )
                return notify_fail("你的内力不够，没有办法练蝶恋花剑法。\n");

        if( !(ob = me->query_temp("weapon"))
        ||      (string)ob->query("skill_type") != "sword" )
                return notify_fail("你必须先找一把剑才能练剑法。\n");

        return 1;
}

int valid_enable(string usage)
{
        return usage=="sword" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}

int practice_skill(object me)
{
        if( (int)me->query("kee") < 10
        ||      (int)me->query("force") < 2 )
                return 
notify_fail("你的内力或气不够，没有办法练习蔷薇剑法。\n");
        me->receive_damage("kee", 10);
        me->add("force", -2);
        write("你按著所学练了一遍蔷薇剑法。\n");
        return 1;
}

string perform_action_file(string action)
{
        return CLASS_D("smallfish") + "/rosebush-sword/" + action;
}
 
int effective_level() { return 23;}

string *parry_msg = ({
        "$n使出一招「春愁深处别样红」，手中的$v荡开了$N的$w。\n",
        "$n使出「花舞清风香遮路」，将$N的$w封于丈外。\n",
        "$n使出一招「彩蝶振翅」，手中的$v化做漫天残照，荡开了$N的$w。\n",
        "$n手中的$v一抖，一招「玉蜂引路」，向$N拿$w的手腕削去。\n",
});

string *unarmed_parry_msg = ({
        "$n将手中的$v舞得密不透风，一招「剪不断、理还乱」封住了$N的攻势。\n",
        "$n反手一招「思愁千古无绝期」，整个人消失在一团剑光之中。\n",
        "$n使出一招「万倾波中觅自由」，$v直刺$N的双手。\n",
        "$n将手中的$v一抖，一招「与尔同消万古愁」，迫得$N连连后退。\n",
});

string query_parry_msg(object weapon)
{
        if( weapon )
                return parry_msg[random(sizeof(parry_msg))];
        else
                return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int learn_bonus()
{
	return -50;
}
int practice_bonus()
{
	return -30;
}
int black_white_ness()
{
	return 10;
}


