inherit SKILL;

mapping *action = ({
  ([ "action": "$N双手合击，一招「月涌大江流」猛然击向$n的$l！",
    "force": 80,
    "parry": 40,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N长啸连连，使一招「暮色千山入」，双手闪电般击向$n的$l！",
    "force": 60,
    "parry": 20,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N一招「因风离海上」，身行飘渺如云烟，忽地向$n的$l一拂！",
    "force": 60,
    "parry": 20,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N陡然回身一转，一招「白云回望合」向$n$l虚空拍出一掌！",
    "force": 60,
    "parry": 20,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N飘然有出尘之意，一招「穿花露滴衣」回拍$n的$l！",
    "force": 60,
    "parry": 40,
    "damage_type": "瘀伤"
  ]),
});

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练落日神拳必须空手。\n");

  if ((string)me->query_skill_mapped("force") != "bibo-force")
    return notify_fail("落日神拳必须配合碧波心法才能练。\n");

  return 1;
}

int valid_enable(string usage) {
  return usage == "unarmed";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 30)
    return notify_fail("你的体力不够了，休息一下再练吧。\n");
  me->receive_damage("kee", 30);
  return 1;
}
int effective_level() { return 12; }

string *parry_msg = ({
  "$n一声大喝使出「风生万马间」，幻出满天掌影，将$N所有招式化于无形。\n",
});

string *unarmed_parry_msg = ({
  "$n一声大喝使出「风生万马间」，幻出满天掌影，将$N所有招式化于无形。\n",

});

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int learn_bonus() {
  return -150;
}
int practice_bonus() {
  return -100;
}
int black_white_ness() {
  return 30;
}

string perform_action_file(string action) {
  return CLASS_D("bianfu") + "/luori/" + action;
}
