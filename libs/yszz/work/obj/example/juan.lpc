// waterskin.c

inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name("入场卷", ({ "juan" }));
  set_weight(70);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一张入场卷,上面写着座位号和比武日程。\n");
    set("unit", "张");
    set("value", 20);
    set("max_liquid", 15);
  }
}
