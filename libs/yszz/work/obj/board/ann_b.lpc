// nancheng_b.c

inherit BULLETIN_BOARD;

void create() {
  set_name("巫师公告栏", ({ "board" }));
  set("location", "/u/city/center");
  set("board_id", "ann_b");
  set("long", "这是巫师公告游戏变动的留言板。\n");
  setup();
  set("capacity", 100);
  replace_program(BULLETIN_BOARD);
}
