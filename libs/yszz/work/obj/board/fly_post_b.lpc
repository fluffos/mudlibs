#include <ansi.h>
inherit BULLETIN_BOARD;

void create()
{
        set_name(HIC"【"HBRED"     技能留言板    "HIC"】"NOR, ({ "wall" }) );
        set("location", "/u/fly/where/post.lpc");
        set("board_id", "fly_post_b");
        set("long","技能留言板。希望各位详实贴帖，谢谢各位！\n" );
        setup();
        set("capacity", 80);
        replace_program(BULLETIN_BOARD);
}

