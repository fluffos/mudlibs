//sword.c : an example weapon

#include <weapon.h>

inherit WHIP;

void create()
{
	set_name("皮鞭", ({ "whip" }) );
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "条");
		set("long", "这是一条黑色的鞭子，看起来份量不轻。\n");
		set("value", 0);
		set("base_weight",10000);
		set("ding_weapon",10);
		set("no_drop",1);
		set("no_get",1);
		set("material", "steel");
	}
	init_whip(50);

// These properties are optional, if you don't set them, it will use the
// default values.

	set("wield_msg", "$N「唰」地一声从腰间抽出一条$n握在手中。\n");
	set("unwield_msg", "$N将手中的$n束在腰间。\n");

// The setup() is required.

	setup();
}
