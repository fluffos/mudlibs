#include <weapon.h>
inherit FORK;
void create() {
  set_name("订作的", ({ "order" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是一柄黑色的叉子，看起来份量不轻。\n");
    set("value", 0);
    set("base_weight", 10000);
    set("ding_weapon", 10);
    set("no_drop", 1);
    set("no_get", 1);
    set("material", "steel");
  }
  init_fork(50);
  setup();
}
