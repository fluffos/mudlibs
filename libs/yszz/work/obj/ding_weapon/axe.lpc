// lumber_axe.c

#include <weapon.h>

inherit AXE;

void create() {
  set_name("铁斧", ({ "lumber axe", "axe" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "这是一柄黑色的斧子，看起来份量不轻。\n");
    set("value", 0);
    set("base_weight", 10000);
    set("ding_weapon", 10);
    set("no_drop", 1);
    set("no_get", 1);
    set("material", "steel");
  }
  set("wield_msg", "$N拿出一把砍柴用的$n，握在手中当作武器。\n");
  set("unwield_msg", "$N放下手中的$n。\n");

  init_axe(50, TWO_HANDED);
  setup();
}
