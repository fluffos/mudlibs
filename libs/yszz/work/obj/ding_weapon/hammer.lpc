// hammer.c

#include <weapon.h>

inherit HAMMER;

void create() {
  set_name("铁锤", ({ "hammer" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "这是一柄黑色的锤子，看起来份量不轻。\n");
    set("value", 0);
    set("base_weight", 10000);
    set("ding_weapon", 10);
    set("no_drop", 1);
    set("no_get", 1);
    set("material", "steel");
  }
  init_hammer(50);
  setup();
}
