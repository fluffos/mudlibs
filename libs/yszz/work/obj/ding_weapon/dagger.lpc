// dagger.c : an example weapon

#include <weapon.h>

inherit DAGGER;

void create() {
  set_name("匕首", ({ "dagger" }));

  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "这是一柄黑色的匕首，看起来份量不轻。\n");
    set("value", 0);
    set("base_weight", 10000);
    set("ding_weapon", 10);
    set("no_drop", 1);
    set("no_get", 1);
    set("material", "steel");
  }
  init_dagger(50);

  // These properties are optional, if you don't set them, it will use the
  // default values.

  set("wield_msg", "$N从怀中摸出一把$n握在手中。\n");
  set("unwield_msg", "$N将手中的$n藏入怀中。\n");

  // The setup() is required.

  setup();
}
