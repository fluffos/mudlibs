//sword.c : an example weapon

#include <weapon.h>

inherit BLADE;

void create()
{
	set_name("单刀", ({ "blade" }) );
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "柄");
		set("long", "这是一柄黑色的单刀，看起来份量不轻。\n");
		set("value", 0);
		set("base_weight",10000);
		set("ding_weapon",10);
		set("no_drop",1);
		set("no_get",1);
		set("material", "steel");
	}
	init_blade(50);

// These properties are optional, if you don't set them, it will use the
// default values.

	set("wield_msg", "$N「唰」地一声抽出一柄$n握在手中。\n");
	set("unwield_msg", "$N将手中的$n插入腰间的刀鞘。\n");

// The setup() is required.

	setup();
}
