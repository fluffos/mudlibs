// birthday_card.c
// motified by ammy@yszz 12/07/2000

#include <ansi.h>;
#include <command.h>;
inherit ITEM;

void create()
{
        set_name(HIM"生日卡片"NOR, ({"birthday card", "card"}));
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "张");
                set("long",
"　这是一张"BLINK""HIM"生日卡片"NOR",送给每一位过生日的妖神玩家。你
可以用"HIR"("HIW"open card"HIR")"NOR" 来查看你的卡片。也可以用"HIR"("HIW"accept
card"HIR"）"NOR"来签收你的礼物！
\n");
                set("value", 0);
                set("no_give","这是你的生日礼物，你怎么能给别人呢！\n");
                set("no_sell","这是巫师们的心意啊，卖掉不太好吧！\n");
                set("no_get","你想去拿卡片，却怎么也拿不起来。\n");
                set("no_drop","丢掉自己的礼品？\n");
                set("no_put","这张卡片很特别哦，收起来会掉的。\n");
                set_weight(10);
        }
        setup();
}
void init()
{
        add_action("do_open", "open");
        add_action("do_accept","accept");
}

int do_open(string arg)
{
        object me = this_player();
        string message;
        int col;
        if (arg == "card")
        {
                tell_object(me,
HIW"\n"+
"     ┏━━━━━━━━ "HIY"一点祝福"HIW" ━━━━━━━━┓\n"+
"     ┃  ┌──  "BLINK""HIC"Happy "HIR"Birthday "HIG"To "HIM"You"HIB"!"NOR""HIW"  ──┐  ┃\n");
                if(strlen(me->query("name")) == 2) tell_object(me,
HIW"     ┃  │  亲爱的"+me->query("name")+"：                      │  ┃\n");
                if(strlen(me->query("name")) == 4) tell_object(me,
HIW"     ┃  │  亲爱的"+me->query("name")+"：                    │  ┃\n");
                if(strlen(me->query("name")) == 6) tell_object(me,
HIW"     ┃  │  亲爱的"+me->query("name")+"：                  │  ┃\n");
                if(strlen(me->query("name")) == 8) tell_object(me,
HIW"     ┃  │  亲爱的"+me->query("name")+"：                │  ┃\n");
                if(strlen(me->query("name")) == 10) tell_object(me,
HIW"     ┃  │  亲爱的"+me->query("name")+"：              │  ┃\n");
        tell_object(me,
HIW"     ┃  │      愿您和您的家人在未来的日子  │  ┃\n"+
"     ┃  │  里，快乐、平安！                │  ┃\n"+
"     ┃  │             *  *"HIR"r"HIW"*  *            │  ┃\n"+
"     ┃  │          * *"HIR"a"HIW"* "HIG"^"HIY"Y"HIG"^"HIW" *"HIR"i"HIW"* *         │  ┃\n"+
"     ┃  │         *"HIM"m"HIW"*"HIG"^"HIY"Y"HIG"^"HIW"*"HIG"^\\^"HIW"*"HIG"^"HIY"Y"HIG"^"HIW"*"RED"s"HIW"*        │  ┃\n"+
"     ┃  │         "HIG"^"HIY"Y"HIG"^"HIW"*"HIG"\\"HIW"*"RED"e"HIW"*"HIG"/"HIW"*"HIG"l"HIW"*"HIG"/"HIW"*"HIG"^"HIY"Y"HIG"^"HIW"        │  ┃\n"+
"     ┃  │         *"HIG"\\"HIW"*"CYN"t"HIW"*"HIG"|"HIY"Y"HIG"^\\^"HIY"Y"HIG"|"HIW"*"HIG"l"HIW"*"HIG"/"HIW"*        │  ┃\n"+
"     ┃  │        *"MAG"s"HIW"*"HIG"|"HIY"Y"HIG"^\\\\^/^//^"HIY"Y"HIG"|"HIW"*"HIR"a"HIW"*       │  ┃\n"+
"     ┃  │        "GRN"^"YEL"Y"GRN"^\\\\_^\\\\\\//^_//^"YEL"Y"GRN"^"HIW"       │  ┃\n"+
"     ┃  │        "GRN"^\\_^\\_\\_\\//_/_/^_/^"HIW"       │  ┃\n"+
"     ┃  │         "GRN"^^\\_^\\_\\\\/_/^_/^^"HIW"        │  ┃\n"+
"     ┃  │           "GRN"^^\\_ \\// _/^^"HIW"          │  ┃\n"+
"     ┃  │               "GRN"\\_\\_/"HIW"              │  ┃\n"+
"     ┃  │                "GRN"/|\\"HIW"               │  ┃\n"+
"     ┃  │               "GRN"/\\\\/\\"HIW"              │  ┃\n"+
"     ┃  │                                  │  ┃\n"+
"     ┃  │                  "HIB"妖神之争巫师组"HIW"  │  ┃\n"+
HIW"     ┃  └─────────────────┘  ┃\n"+
"     ┗━━━━━━━━━━━━━━━━━━━━━┛\n"
NOR);
        }
        return 1;
}

int do_accept(string arg)
{
        object me = this_player();
        message_vision("$N试图在卡片上再签一个名字，可是字迹一写上去就不见了。\n",me);
        return 1;
}
