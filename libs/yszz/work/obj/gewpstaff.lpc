// budd_staff.c

#include <ansi.h>
#include <weapon.h>

inherit STAFF;

void create()
{
    set_name("[2;35m海上明月共潮生[1;0m", ({"sea staff", "staff", "sf",}) );
   set_weight(0);
   if( clonep() )
     set_default_object(__FILE__);
   else {
     set("unit", "条");
//     set("no_drop","这是私人物件不能离开你");
     set("no_give", "这是珍贵的东西,怎么能给人呢?\n" );
//     set("no_get", "这样东西不能离开那儿。\n");
     set("long", "[1;35m一条淡紫色的法杖, 是观音大士赐给得意弟子的兵器\n\n看起来佛光四射, 隐隐可闻海潮之声[1;0m");
     set("value", 10000);
     set("material", "brass");
     set("wield_msg", "$N拿出一条淡紫色的$n握在手中。\n");
     set("unwield_msg", "$N放下手中的$n。\n");
   }

   init_staff(1);
   setup();
}
