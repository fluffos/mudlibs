// score.c

#include <ansi.h>
#include <combat.h>

inherit F_CLEAN_UP;

string display_attr(int gift, int value);
string status_color(int current, int max);
string date_string(int date);
string tribar_graph(int val, int eff, int max, string color);

void create() { seteuid(ROOT_UID); }

int main(object me, string arg)
{
        object ob;
        mapping my,quest;
        string line, str, skill_type;
        object weapon;
        int attack_points, dodge_points, parry_points,year,obstacles;
        int i;

        seteuid(getuid(me));

        if(!arg)
                ob = me;
        else if (wizardp(me)) {
                ob = present(arg, environment(me));
                if (!ob) ob = find_player(arg);
                if (!ob) ob = find_living(arg);
                if (!ob) return notify_fail("你要察看谁的状态？\n");
        } else
                return notify_fail("只有巫师能察看别人的状态。\n");

        my = ob->query_entire_dbase();
        quest = ob->query("fy_quest");
printf("\n");
printf("━━━━━━━━━━━[1;44m「 妖神之争 」 之 %-10s %-8s篇[m━━━━━━━━━\n"NOR,ob->name(),ob->query("id"));
printf("〖个人隐私篇〗                  〖修行战斗篇〗                〖任务行动篇〗\n");
printf("━━━━━━━━━┳━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━\n");
        if( objectp(weapon = ob->query_temp("weapon")) )
                skill_type = weapon->query("skill_type");
        else
                skill_type = "unarmed";
        attack_points = COMBAT_D->skill_power(ob, skill_type,SKILL_USAGE_ATTACK);
     parry_points = COMBAT_D->skill_power(ob, skill_type,SKILL_USAGE_DEFENSE);
        dodge_points = COMBAT_D->skill_power(ob, "dodge",SKILL_USAGE_DEFENSE);       
        obstacles = ob->query("obstacle/number");

printf(" [1;45m年龄[m: %-3d        ┃          [1;45m攻击力[m: %-7d       ┃   %-20s\n",
my["age"],attack_points/100 + 1,obstacles==36?"你已经功德圆满!":(obstacles==0?"[1;45m你尚未踏上西行大道[m":"[1;45m你闯过了西行[m "+obstacles+" [1;45m关[m"));

printf(" [1;41m性别[0m: %-2s       ┃          [1;41m兵刃攻击[m: %-4d        ┃   [1;41m师门杀怪任务(如下)[0m\n",my["gender"],ob->query_temp("apply/damage"));

printf(" [1;42m%-16s[m ┃          [1;42m防御力[m: %-7d       ┃   %-8s  %-8s\n",

ob->query("couple")?(my["gender"]=="男性"?"妻子："+ob->query("couple/name"):"丈夫："+ob->query("couple/name")):"快乐的单身贵族",

               (dodge_points + (weapon? parry_points:
(parry_points/10)))/100 + 1,

ob->query("mieyao")?ob->query("mieyao/place"):"暂时没有",ob->query("mieyao")?ob->query("mieyao/name"):"");

printf(" [1;43m师傅[m: %-10s ┃          [1;43m盔甲防御[m: %-4d        ┃   [1;43m师门寻找任务(如下)[m\n",
ob->query("family/master_name")?ob->query("family/master_name"):"鬼才知道",ob->query_temp("apply/armor"));

printf(" [1;44m存款[m: %-9d  ┃          [1;44m怒气[m: %-3d             ┃   %-20s\n",
ob->query("balance"),ob->query("anger"),mapp(quest)?"寻找："+quest["quest"]:"暂时还没有");

printf(" [1;46m杀气[m: %-5d      ┃          [1;46m共杀过%-4d人,玩家%-3d人[m┃   [1;46m官位[m: %-18s\n",
                         ob->query("bellicosity"),
                        ob->query("MKS"),
                        ob->query("PKS"),
                        ob->query("degree")?ob->query("degree"):"无官一身轻");
printf("━━━━━━━━━┻━━━━━━━━━━━━━━━━┻━━━━━━━━━━━━━\n");
printf("   灵性:%s 定力:%s 容貌:%s 膂力:%s 胆识:%s 悟性:%s 根骨:%s 福缘:%s\n",
                        display_attr(my["spi"], ob->query_spi()),
                        display_attr(my["cps"], ob->query_cps()),
                        display_attr(my["per"], ob->query_per()),
                        display_attr(my["str"], ob->query_str()),
                        display_attr(my["cor"], ob->query_cor()),
                        display_attr(my["int"], ob->query_int()),
                        display_attr(my["con"], ob->query_con()),      
                        display_attr(my["kar"], ob->query_kar()));    
printf("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n");
printf("\n");
return 1;
}
string display_attr(int gift, int value)
{
        if( value > gift ) return sprintf( HIY "%3d" NOR, value );
        else if( value < gift ) return sprintf( CYN "%3d" NOR, value );
        else return sprintf("%3d", value);
}
int help(object me)
{
        write(@HELP
指令格式 : score
           score <对象名称>                   (巫师专用)

这个指令可以显示你或指定对象(含怪物)的基本资料。
基本资料的设定请参阅 'help setup'。

see also : hp
HELP
    );
    return 1;
}

