//okip.c
//by xlwang@ys
inherit F_CLEAN_UP;


void create()
{
seteuid(getuid());
}

int main(object me, string arg)
{ 
int i;
string *nowip;
string ad,ip;
string* ok_ip;

  ok_ip=me->query("ok_ip");
  if(!pointerp(ok_ip)) ok_ip=({});
  if (!arg) {
  write("你现在的连线ip为"+query_ip_number(me)+"\n");
  i=sizeof(ok_ip);
  if (!i)  return notify_fail("你没设定任何okip\n");
  write("你设的ok_ip为\n");
    for (i=0;i<sizeof(ok_ip);i++) 
                    tell_object(me,ok_ip[i]+"\n");             
    if (!SECURITY_D->match_site(me,query_ip_number(me))) 
  {
  ok_ip +=({query_ip_number(me)});
write(query_ip_number(me));
ip=query_ip_number(me);
  nowip=explode(ip,".");
write(nowip[0]);
  ok_ip +=({nowip[0]+"."+nowip[1]});
  me->set("ok_ip",ok_ip);
  return notify_fail("注意,你现在的连线ip不在okip之内,系统自动加上现在ip,请重新设置okip\n");    
     }
           return 1;   }
 if(sscanf(arg,"%s %s",ad,ip)!=2)
                return notify_fail("用法:okip [-a|-d ip]\n");      
 if ((int)strlen(arg)>40) return notify_fail("怎么,想捣乱?\n"); 
     if (ad=="-a") {
        if (sizeof(ok_ip)>10) return notify_fail("没必要设置如此多的okip吧!\n");
        ok_ip +=({ip});
        }
     if (ad=="-d") {if (ip=="all") {write("取消所有okip\n");
       me->delete("ok_ip");    
       return 1;}
        for (i=0;i<sizeof(ok_ip);i++) {
        if (ok_ip[i]==ip) ok_ip -=({ok_ip[i]});         
                       }
  
            }
        
  me->set("ok_ip",ok_ip);
write("你设的ok_ip为\n");
    for (i=0;i<sizeof(ok_ip);i++) 
                    tell_object(me,ok_ip[i]+"\n");             
if (me->query("id")!="babya")    if (!SECURITY_D->match_site(me,query_ip_number(me))) 
  {
  ok_ip +=({query_ip_number(me)});
ip=query_ip_number(me);
  nowip=explode(ip,".");
write(nowip[0]);
  ok_ip +=({nowip[0]+"."+nowip[1]});
  me->set("ok_ip",ok_ip);
  return notify_fail("注意,你现在的连线ip不在okip之内,系统自动加上现在ip,请重新设置okip\n");    
     }
  
        return 1;
}


int help(object me)
{
write(@HELP
指令格式 : okip [-a|-d ip]
这个指令让你设置你允许登录的ip,
不加参数可以查询你的连线ip以及已设的okip,
注意,缺省为不设任何okip,如果你不希望有人从其它ip地址登录你的帐号,就请把
你常用的ip加入okip里,不过设了okip之后,你自己也不能从okip之外的 ip地址
登录,一旦要设置的话,请考虑全面点.
-a 增加一个okip,
-d 删除一个okip,
-d all删除所有okip ,

okip允许重复,因为只要从okip列表里找到和登录ip匹配的就允许登录.
ip可以使用*通配符,不过-d操作不考虑通配符
例okip -a 202.119.144.5
  okip -a 202.119.*.* 
  okip -d 202.119.*.*
之后okip为 202.119.144.5
HELP
    );
    return 1;
}

