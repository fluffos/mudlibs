// lord_master.c modify by gump

#include <dbase.h>

#define LORD_OB "/obj/npc/demolord"
#define LORD_ROOM "/obj/lordroom"

inherit NPC;

string SAVE_NAME;

void set_new_lord(object who, object lord, object master);

int do_challenge() {
  object me, lord, defier;

  me = this_object();
  defier = this_player();
  if (me->query("lord_home"))

    if (me->query("lord_home") != base_name(environment(me))) {
      command("say 我都不在自己的地盘上，你来挑战什么？");
      return 1;
    }
  lord = new(LORD_OB);
  lord->set("master", base_name(me));
  lord->set("save_name", SAVE_NAME);
  if (!lord->restore())
    lord->reset_me();
  lord->fully_recover();
  if (lord->query("lord"))
    set_new_lord(lord, lord, me);
  lord->move(environment(me));
  lord->set_temp("master", me);
  me->move(LORD_ROOM);
  lord->start_challenge(defier, me);
  return 1;
}

void reload(string filename) {
  string name, id, long;
  object lord, me;

  SAVE_NAME = filename;
  me = this_object();
  lord = new(LORD_OB);
  lord->set("master", base_name(me));
  lord->set("save_name", SAVE_NAME);
  if (!lord->restore())
    return;
  if (lord->query("lord"))
    set_new_lord(me, lord, me);
  destruct(lord);
  return;
}

void set_new_lord(object who, object lord, object master) {
  string *newid, short;
  string name, id, long;

  name = lord->query("lord/name");
  id = lord->query("lord/id");
  long = lord->query("lord/long");

  if (pointerp(newid = master->parse_command_id_list()))
    newid = ({ "lord " + id }) + newid;
  else newid = ({ "lord " + id });
  newid += ({ "lord" });
  if ((string)(short = query("lord_title")))
    short += " ";
  else short = "妖王 ";
  short += name + "(" + capitalize(newid[0]) + ")";

  who->set_temp("apply/id", newid);
  who->set_temp("apply/name", ({ name }));
  who->set_temp("apply/long", ({ long }));
  who->set_temp("apply/short", ({ short }));
  return;
}
