// lord.c modify by gump

#include <dbase.h>
#include <login.h>
#include <ansi.h>

#define LORD_DIR DATA_DIR+"npc/lord/"

inherit NPC;
inherit F_SAVE;

void save_status(object me, object who, int flag);
void create_me();
void reset_me();
void start_challenge(object defier);
void check_result(object me, object defier);
void return_master();
string query_save_file();

void reset_me() {
  mapping skill_status, hp_status, map_status;
  string *lists, master_name, save_name;
  int i, weapon_cnt, armor_cnt;
  object *inv, master, me;

  if (!stringp(master_name = query("master")))
    return;
  if (!objectp(master = new(master_name)))
    return;
  save_name = query("save_name");
  me = this_object();

  me->set("sav_force", 0);
  me->set("max_force", 0);
  me->set("force", 0);
  me->set("sav_mana", 0);
  me->set("max_mana", 0);
  me->set("mana", 0);
  me->set("force_factor", 0);
  me->set("mana_factor", 0);
  me->set("combat_exp", 0);
  me->set("wuxue_exp", 0);

  me->delete("lord");
  me->delete("object");
  if (mapp(map_status = me->query_skill_map())) {
    lists = keys(map_status);
    for (i = 0; i < sizeof(lists); i++) {
      me->map_skill(lists[i]);
    }
  }
  if (mapp(skill_status = me->query_skills())) {
    lists = keys(skill_status);
    for (i = 0; i < sizeof(lists); i++) {
      me->delete_skill(lists[i]);
    }
  }
  reset_eval_cost();
  hp_status = master->query_entire_dbase();
  lists = keys(hp_status);
  for (i = 0; i < sizeof(lists); i++)
    me->set(lists[i], hp_status[lists[i]]);

  delete("chat_chance_combat");
  delete("chat_msg_combat");

  if (mapp(skill_status = master->query_skills())) {
    lists = keys(skill_status);
    for (i = 0; i < sizeof(lists); i++) {
      me->set_skill(lists[i], skill_status[lists[i]]);
    }
  }
  if (mapp(map_status = master->query_skill_map())) {
    lists = keys(map_status);
    for (i = 0; i < sizeof(lists); i++) {
      me->map_skill(lists[i], map_status[lists[i]]);
    }
  }

  weapon_cnt = 0;
  armor_cnt = 0;
  inv = all_inventory(master);
  for (i = 0; i < sizeof(inv); i++) {
    if (weapon_cnt && armor_cnt)
      break;
    if (!inv[i]->query_unique() && inv[i]->query("skill_type") &&
      inv[i]->query("equipped") && !weapon_cnt) {
      me->set("object/weapon", base_name(inv[i]));
      weapon_cnt = 1;
    } else if (!inv[i]->query_unique() && !inv[i]->query("skill_type") &&
      inv[i]->query("equipped") && !armor_cnt) {
      me->set("object/armor", base_name(inv[i]));
      armor_cnt = 1;
    }
  }
  set("master", master_name);
  set("save_name", save_name);

  save();

  destruct(master);
  return;
}

void fully_recover() {
  int i;
  object weapon, armor, me, lord_player, *inv;
  string player_name;


  me = this_object();
  set("kee", query("max_kee"));
  set("eff_kee", query("max_kee"));
  set("sen", query("max_sen"));
  set("eff_sen", query("max_sen"));
  set("force", 2 * query("max_force"));
  set("sav_force", query("max_force"));
  set("mana", 2 * query("max_mana"));
  set("sav_mana", query("max_mana"));

  set("force_factor", me->query_skill("force") * 5 / 8);
  set("mana_factor", query("max_mana") / 20 + 1);

  if (query("lord")) {
    player_name = query("lord/id");
    if (lord_player = find_player(player_name))
      save_status(me, lord_player, 0);
    else if (lord_player = LOGIN_D->find_body(player_name))
      save_status(me, lord_player, 0);
    else {
      seteuid(player_name);
      lord_player = new(USER_OB);
      lord_player->set("id", player_name);
      if (!lord_player->restore()) {
        destruct(lord_player);
        return;
      }
      export_uid(lord_player);
      seteuid(getuid());
      lord_player->setup();
      if (lord_player->query("combat_exp") > me->query("combat_exp"))
        save_status(me, lord_player, 0);
      destruct(lord_player);
    }
  }
  inv = all_inventory(me);
  for (i = 0; i < sizeof(inv); i++)
    destruct(inv[i]);

  if (query("object/weapon")) {
    weapon = new(query("object/weapon"));
    if (weapon) {
      weapon->move(this_object());
      weapon->wield();
    }
  }
  if (query("object/armor")) {
    armor = new(query("object/armor"));
    if (armor) {
      armor->move(this_object());
      armor->wear();
    }
  }
  reset_action();
  return;
}

void save_status(object me, object who, int flag) {
  mapping skill_status, hp_status, map_status;
  int i, weapon_cnt, armor_cnt;
  object *inv, old_lord, lord_player;
  string *lists, lord_name;

  reset_eval_cost();
  hp_status = who->query_entire_dbase();

  me->set("str", hp_status["str"]);
  me->set("int", hp_status["int"]);
  me->set("con", hp_status["con"]);
  me->set("spi", hp_status["spi"]);
  me->set("cor", hp_status["cor"]);
  me->set("cps", hp_status["cps"]);
  me->set("per", hp_status["per"]);
  me->set("kar", hp_status["kar"]);

  me->set("max_kee", hp_status["max_kee"]);
  me->set("max_sen", hp_status["max_sen"]);
  me->set("max_force", hp_status["max_force"]);
  me->set("max_mana", hp_status["max_mana"]);
  me->set("combat_exp", hp_status["combat_exp"]);
  me->set("wuxue_exp", hp_status["wuxue_exp"]);
  me->set("gender", hp_status["gender"]);
  me->set("age", hp_status["age"]);

  if (mapp(map_status = me->query_skill_map())) {
    lists = keys(map_status);
    for (i = 0; i < sizeof(lists); i++) {
      me->map_skill(lists[i]);
    }
  }
  if (mapp(skill_status = me->query_skills())) {
    lists = keys(skill_status);
    for (i = 0; i < sizeof(lists); i++) {
      me->delete_skill(lists[i]);
    }
  }
  if (mapp(skill_status = who->query_skills())) {
    lists = keys(skill_status);
    for (i = 0; i < sizeof(lists); i++) {
      me->set_skill(lists[i], skill_status[lists[i]]);
    }
  }
  if (mapp(map_status = who->query_skill_map())) {
    lists = keys(map_status);
    for (i = 0; i < sizeof(lists); i++) {
      me->map_skill(lists[i], map_status[lists[i]]);
    }
  }

  if (flag) {
    if (who->query("lord")) {
      old_lord = new("/obj/npc/demolord");
      lord_name = who->query("lord/data_name");
      sscanf(lord_name, "/data/npc/lord/%s", lord_name);
      old_lord->set("save_name", lord_name);
      old_lord->set("master", who->query("lord/base_name"));
      old_lord->reset_me();
      destruct(old_lord);
    }
    if (me->query("lord")) {
      if (lord_player = find_player(query("lord/id"))) {
        lord_player->set("title", lord_player->query("lord/old_title"));
        if (lord_player->query("lord/family")
          != lord_player->query("family/family_name")) {
          if (lord_player->query("family/family_name"))
            lord_player->set("title",
              sprintf("%s第%s代%s",
                lord_player->query("family/family_name"),
                chinese_number(lord_player->query("family/generation")),
                lord_player->query("family/title")));
        }
        lord_player->delete("lord");
        lord_player->save();
      } else if (lord_player = LOGIN_D->find_body(query("lord/id"))) {
        lord_player->set("title", lord_player->query("lord/old_title"));
        if (lord_player->query("lord/family")
          != lord_player->query("family/family_name")) {
          if (lord_player->query("family/family_name"))
            lord_player->set("title",
              sprintf("%s第%s代%s",
                lord_player->query("family/family_name"),
                chinese_number(lord_player->query("family/generation")),
                lord_player->query("family/title")));
        }
        lord_player->delete("lord");
        lord_player->save();
      }
    }
    me->delete("obejct");
    me->delete("lord");
    who->delete("lord");
    weapon_cnt = 0;
    armor_cnt = 0;
    inv = all_inventory(who);
    for (i = 0; i < sizeof(inv); i++) {
      if (weapon_cnt && armor_cnt)
        break;
      if (!inv[i]->query_unique() && inv[i]->query("skill_type") &&
        inv[i]->query("equipped") && !weapon_cnt) {
        me->set("object/weapon", base_name(inv[i]));
        weapon_cnt = 1;
      } else if (!inv[i]->query_unique() && !inv[i]->query("skill_type") &&
        inv[i]->query("equipped") && !armor_cnt) {
        me->set("object/armor", base_name(inv[i]));
        armor_cnt = 1;
      }
    }
    who->set("lord/family", who->query("family/family_name"));
    who->set("lord/old_title", who->query("title"));
    who->set("lord/time", who->query("mud_age"));
    who->set("lord/base_name", query("master"));
    who->set("lord/data_name", query_save_file());
    who->set("lord/title", me->query("lord_title"));
    who->set("lord/area", query("lord_area"));
    who->set("title", me->query("lord_title"));
    me->set("lord/name", who->name(1));
    me->set("lord/id", geteuid(who));
    me->set("lord/long", who->long());
  }

  save();
}


void start_challenge(object defier) {
  object me, *inv, master;
  int i;

  master = query_temp("master");
  if (!objectp(defier)) {
    return_master();
    return;
  }
  me = this_object();
  if (geteuid(defier) == me->query("lord/id")) {
    command("say 你是不是又迷糊了？");
    tell_object(defier, "你已经是这里的妖王了！\n");
    return_master();
    return;
  }
  fully_recover();
  message_vision("$N对$n喝道：你在这里作威作福也够长时间了，也该换人了！\n",
    defier, me);
  me->command("heihei");
  message_vision("$N笑道：那就看看你有没有这本事了！\n", me);
  inv = all_inventory(defier);
  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i]->query_unique()) {
      message_vision("突然间，$n化一道白光飞去，无影无踪！\n", me, inv[i]);
      destruct(inv[i]);
    }
  }

  defier->kill_ob(me);
  me->kill_ob(defier);
  me->set("defier", defier);

  remove_call_out("check_result");
  call_out("check_result", 1, me, defier);
  return;
}

void check_result(object me, object defier) {
  object master;
  int my_max_kee;

  master = query_temp("master");
  if (!defier) {
    command("heng");
    command("say 就这么一点本事！");
    return_master();
    return;
  }
  if (environment(defier) != environment(me)) {
    command("heng");
    command("say 就这么一点本事！");
    return_master();
    return;
  }
  if (!me->is_fighting(defier)) {
    command("heng");
    command("say 就这么一点本事！");
    return_master();
    return;
  }
  my_max_kee = me->query("max_kee");
  if (((me->query("kee") * 100) / (1 + my_max_kee)) < 10) {
    message_vision("$N大叫一声：厉害。说着就化做一阵烟雾遁去了！\n", me);
    CHANNEL_D->do_channel(defier, "ys", "从此以后我就是〖"
      +me->query("lord_title") + HIR "〗！\n");
    save_status(me, defier, 1);
    return_master();
    return;
  }
  call_out("check_result", 1, me, defier);
  return;
}

void return_master() {
  object me, home, master;


  me = this_object();
  master = query_temp("master");
  if (!objectp(master))
    if (!objectp(master = new(query("master"))))
      return;
  home = environment(me);
  master->move(home);
  if (me->query("lord"))
    master->set_new_lord(master, me, master);
  destruct(this_object());
  return;
}

string query_save_file() {
  string save_name;

  save_name = query("save_name");
  if (!stringp(save_name))
    return 0;
  return LORD_DIR + save_name;
}


int do_bandage(string arg) {
  object who = this_player();
  object me = this_object();

  if (!arg || me != present(arg, environment(me)))
    return 0;

  message_vision("$N过份殷勤地要给$n包扎伤口。\n", who, me);
  call_out("no_bandage", 2, who, me);
  return 1;
}

void no_bandage(object who, object me) {
  message_vision("$N向$n摇了摇头。\n", me, who);
}

int do_ji(string arg) {
  object who = this_player();
  object me = this_object();

  message_vision("$N摸摸索索地想祭什么法宝。\n", who);
  call_out("no_ji", 2, who, me);
  return 1;
}

void no_ji(object who, object me) {
