#include <ansi.h>
#define YS_TIME 981010000  //定义元年一月一日一时一刻的时间,定义为981010000是因为这个mud 建立与那个时期
#define ONE_YEAR_TIME 172800  //每年所需要的时间,这里为48小时
inherit F_CLEAN_UP;
mapping check_time(int time_now);
string check_season();
string check_usr_birthday(object ob);
mapping check_time(int time_now)
{   int t;
    int year,month,day,hour,quarter;
    mapping date;
    string time;
    t = time_now-YS_TIME;
        if(t>=0){
        time = "妖神";
        year = t / ONE_YEAR_TIME;
        t -=year*ONE_YEAR_TIME;
         }
        else {
          time ="妖神前";
          t =(-1)*t;
          year =t / ONE_YEAR_TIME;
          t = ONE_YEAR_TIME - (t-year*ONE_YEAR_TIME);
           }

       month = t/(30*480);  t -=month*30*480;
       day  =t/480;          t -=day*480;
       hour =t/20;           t -=hour*20;
       quarter =t/5;
      //此处年月日需要加一.
       year++; month++; day++;
       date =([
          "YEAR"     : time+((year==1)?"元":chinese_number(year)) + "年",
          "MONTH"    : (month==1)?"元月":chinese_number(month) +"月",
          "DAY"      : chinese_number(day) +"日",
          "HOUR"     : chinese_number(hour) +"时",
          "QUARTER"  : (!quarter)?"零刻":chinese_number(quarter)+"刻",
          ]);
        return date;
}


//返回现在的季节。
string check_season()
{
string month;
string season;
mapping date=check_time(time());
month=date["MONTH"];
       switch (month)
       {
       case "元月":
       case "十一月":
       case "十二月":
       season =""HIW"冬季"NOR""; break;
       case "二月":
       case "三月":
       case "四月":
       season =""HIG"春季"NOR""; break;
       case "五月":
       case "六月":
       case "七月":
       season =""HIR"夏季"NOR"";break;
       case "八月":
       case "九月":
       case "十月":
       season =""HIY"秋季"NOR"";break;
       } 
       return season;
}

string check_usr_birthday(object ob)
{
	mapping date=check_time(ob->query("birthday"));
	return date["MONTH"]+date["DAY"];
}

