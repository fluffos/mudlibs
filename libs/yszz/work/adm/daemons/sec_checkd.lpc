void create()
{

}

int has_right(object me,string dir)
{       string wiz_status;
        wiz_status = SECURITY_D->get_status(me);
       
      if(wiz_status  == "(admin)" || wiz_status == "(arch)"||wiz_status == "wizard" ) return 1;
      if(wiz_status == "(immortal)" )
              {
               if (strlen(dir)<2) 
                {
                 write("仙人只能看到/u目录下的文件,作为熟悉程序所用!\n");
                 return 0;
                } 
               if (dir[0..1]=="/u") return 1;
               write("仙人只能看到/u目录下的文件,作为熟悉程序所用!\n");
                           return 0;
              }
              
      if (strlen(dir)<2) 
         {write("巫师和巫师学徒只能看到/u下的内容!\n");
          return 0;
          }
      if (dir[0..1]=="/u" ) return 1;
         write("巫师和巫师学徒只能看到/u下的内容!\n");
         return 0;
}       

