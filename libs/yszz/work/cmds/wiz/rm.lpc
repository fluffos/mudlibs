
#include "/doc/help.h"

inherit F_CLEAN_UP;

int main(object me, string file)
{
        seteuid(geteuid(me));
    if (!file) return notify_fail("sorry, no such file.\n");
        if( rm(resolve_path(me->query("cwd"), file)) )
                write("Ok.\n");
        else
                write("cant rm.\n");
        return 1;
}

