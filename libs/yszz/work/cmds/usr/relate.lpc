#include <ansi.h>
inherit F_CLEAN_UP;

string *degree = ({
        HIC "一般来往" NOR,
        HIR "形同路人" NOR,
        HIG "略有矛盾" NOR,
        HIW "心含仇恨" NOR,
        HIB "不共戴天" NOR,
    });
string *degree2 = ({
        HIG "同路中人" NOR,
        HIB "点头之谊" NOR,
        HIY "交往颇深" NOR,
        HIR "情同手足" NOR,
        HIW "生死患难" NOR,
        });

int main(object me,string arg)
{
        mapping relation;
        object ob;
        string my_fam,*famlist;
        string text;
        int i,lv;

        if( ! arg ) ob=me;
   else if (wizardp(me)) {
                ob = present(arg, environment(me));
                if (!ob) ob = find_player(arg);
                if (!ob) ob = find_living(arg);
        if (!ob) return notify_fail("你要察看谁的联系 ？\n");
        } else
                return notify_fail("只有巫师能察看别人的联系。\n");

        if( !ob->query("family") )
                return notify_fail("你现在还没有加入任何门派！\n");
        
        my_fam=ob->query("family/family_name");
        relation=ob->query("relation");
       if(!sizeof(relation) )
                return notify_fail("你目前与世无争!\n");

        famlist=keys(relation);

        write("你的门派是"+HIC+my_fam+NOR+"\n");
        write("你现在与其他门派关系：\n");
        write(HIW"※※※※※※※※※※※※※※※\n"NOR);
if (wizardp(me))  for(i=0;i<sizeof(relation);i++)
        {
        if(famlist[i]==my_fam) continue;
        write(MAG+famlist[i]+NOR+relation[famlist[i]]+"\n");
        }
       for(i=0;i<sizeof(relation);i++)
        {
        if(famlist[i]==my_fam) continue;
        if( relation[famlist[i]] >= 250 ) relation[famlist[i]]=249;
        if( relation[famlist[i]] <= -249) relation[famlist[i]]=-249;
          relation[famlist[i]] >= 0 ?       
       write(MAG+famlist[i]+NOR+"："+degree[relation[famlist[i]]/50]+"\n"):
       write(MAG+famlist[i]+NOR+"："+degree2[-relation[famlist[i]]/50]+"\n");
        }
        write(HIW"※※※※※※※※※※※※※※※\n"NOR);
        return 1;

}
 
