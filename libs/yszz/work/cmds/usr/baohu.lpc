//采用风云里 user list
#include <ansi.h>
inherit F_CLEAN_UP;
int main(object me,string arg)
{
 string id, id2;
 object obj, *pros;
 int i;
 if (!arg)
  return notify_fail("指令格式 : baohu <对象>\n");

 if(!me->query("married"))
 return notify_fail("你好象并没有结婚！\n");
 if(!stringp(id=me->query("couple/id")))
  return notify_fail("你好象并没有结婚！\n");
 if(id != arg)
 {
  arg+="好象并不是你的";
  if(me->query("gender")=="女性") arg += "丈夫！\n";
  else arg += "妻子！\n";
         return notify_fail(arg);
 }
 if(!objectp(obj=present(id,environment(me))))
  return notify_fail(id+"好象并不在你的周围！\n");
 id2 = obj->query("couple/id");
 if( id2 != me->query("id"))
 {
  arg+="好象你并不是";
  if(obj->query("gender")=="女性") arg += "她的丈夫！\n";
  else arg += "他的妻子！\n";
         return notify_fail(arg);
  }
// passed all checks!
 pros = obj->query_temp("protectors");
 for(i=0;i<sizeof(pros);i++)
    if(pros[i] == me)
    {
          if(sizeof(pros)==1)
          {
                 obj->delete_temp("protectors");
                 return notify_fail("你停止保护"+obj->query("name")+"了！\n");
          }
          else   pros -= ({ me });
          obj->set_temp("protectors",pros);
          return notify_fail("你停止保护"+obj->query("name")+"了！\n");
    }
 if(sizeof(pros))
  pros += ({ me });
 else
  pros = ({ me });
 obj->set_temp("protectors",pros);
 write("你开始保护"+obj->query("name")+"。\n");
 return 1;

}
int help(object me)
{
write(@HELP
指令格式 : baohu <对象>
这是已婚夫妇用来保护对方（妻子／丈夫）的指令
当你成为保护者时，你可以用自己高超的拆招的技能来保护
自己的同伴，替对方拆架敌人的攻击。
HELP
    );
    return 1;
}
