//  妖神之争２。０
//      by happ 2000.9.11 

#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  object who;
  string id, fam, fam2;
  int lv1, lv2, faith, myfaith;


  if (!arg || sscanf(arg, "%s with %s", id, fam) != 2)
    return notify_fail("指令格式：tiaobo ID with 门派.\n如：tiaobo happ with 陷空山无底洞\n");
  lv1 = me->query_skill("tiaobo", 1);
  who = present(id, environment(me));
  if (!who) return notify_fail("你的周围没有这个人！\n");

  who = find_player(id);

  if (me->is_busy())

    return notify_fail("你现在正忙！\n");

  if (!lv1)
    return notify_fail("你根本就不会挑拨离间之术！\n");

  if (!interactive(who))
    return notify_fail("你只能挑拨在线玩家与某个门派的关系！\n");

  if (fam != "五庄观"
    && fam != "东海龙宫" && (fam != "月宫") && fam != "方寸山三星洞" &&
    fam != "南海普陀山" && fam != "大雪山" && fam != "水帘洞" &&
    fam != "陷空山无底洞" && fam != "轩辕古墓" && fam != "阎罗地府")
    return notify_fail("你只能从下面的门派中选择一个\n五庄观 东海龙宫 月宫 方寸山三星洞 南海普陀山 阎罗地府 陷空山无底洞 水帘洞 大雪山 轩辕古墓 \n");

  fam2 = who->query("family/family_name");
  lv2 = who->query_skill("tiaobo", 1);
  faith = who->query("faith");
  if (!fam2)
    return notify_fail("对方根本就没有门派！\n");


  if (!lv2) lv2 = 0;
  tell_room(environment(me), me->name() + "向" + who->name() + "耐心的说出与" + fam + "相处的种种坏处！\n");

  if (random(lv1) > random(lv2)) {
    if (fam == fam2) {
      myfaith = (int)me->query("faith");
      if (random(myfaith) > faith) {
        tell_object(me, "看来" + who->name() + "似乎动心了！\n");
        tell_object(who, "你感觉到对" + fam + "的忠诚降低了！\n");
        if (faith > 800) who->add("faith", -random(3));
        who->start_busy(1);
        return 1;
      }
    }
    tell_object(me, "看来" + who->name() + "似乎动心了！\n");
    tell_object(who, "你感觉到对" + fam + "的仇恨增加了！\n");
    who->add("relation/" + fam, faith / 100);
    me->start_busy(3);
    who->start_busy(1);
    return 1;
  }


  //  else if {
  if (fam == fam2) {
    tell_object(me, "看来" + who->name() + "似乎不为所动！\n");
    tell_object(who, me->name() + "试图挑拨你与师门的关系，但是被你识破了！\n");
    if (me->query_condition("no_pk_time") < 240) who->kill_ob(me);
    me->start_busy(2);
    who->start_busy(2);
    return 1;
  }
  tell_object(me, "看来" + who->name() + "似乎不为所动！\n");
  tell_object(who, me->name() + "试图挑拨你与" + fam + "的关系，但是被你识破了！\n");
  me->start_busy(2);
  who->start_busy(2);
  return 1;
  //        }
  //      return 1;
}
