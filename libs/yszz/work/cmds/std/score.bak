// score.c

#include <ansi.h>
#include <combat.h>

inherit F_CLEAN_UP;

string display_attr(int gift, int value);
string status_color(int current, int max);
string date_string(int date);
string tribar_graph(int val, int eff, int max, string color);

void create() { seteuid(ROOT_UID); }

int main(object me, string arg)
{
        object ob;
        mapping my;
        string line, str, skill_type;
        object weapon;
        int attack_points, dodge_points, parry_points,year,obstacles;
        int i;

        seteuid(getuid(me));

        if(!arg)
                ob = me;
        else if (wizardp(me)) {
                ob = present(arg, environment(me));
                if (!ob) ob = find_player(arg);
                if (!ob) ob = find_living(arg);
                if (!ob) return notify_fail("你要察看谁的状态？\n");
        } else
                return notify_fail("只有巫师能察看别人的状态。\n");

        my = ob->query_entire_dbase();
printf("\n");
printf("[37;1m┏━━━━━[32m【个人  档案】[37m━━━━┓\n");
printf("┃ [m中文姓名：   %-10s       [37;1m ┃[m灵性：[%s]  定力：[%s]  容貌：[%s]\n",
                ob->query("name"),
                        display_attr(my["spi"], ob->query_spi()),
                        display_attr(my["cps"], ob->query_cps()),
                        display_attr(my["per"], ob->query_per()));
printf("[1;37m┃[m 英文姓名：   %-15s   [1;37m┃[m根骨：[%s]               福缘：[%s]\n",
                ob->query("id"),
                        display_attr(my["con"], ob->query_con()),
//                ob->query("anger"),
                        display_attr(my["kar"], ob->query_kar()));
printf("[1;37m┃[m 杀气：   [1;31m    %-8d      [37m    ┃[m膂力：[%s]  胆识：[%s]  悟性：[%s]\n",
                  ob->query("bellicosity"),
                        display_attr(my["str"], ob->query_str()),
                        display_attr(my["cor"], ob->query_cor()),
                        display_attr(my["int"], ob->query_int()));
printf("[1;37m┃[m 年龄：  [1;32m     %-8s         [1;37m ┗━━━━━━━━━━━━━━━━━━━━━┓\n",  
                chinese_number(ob->query("age")));
        if( mapp(my["family"]) ) {
                if( my["family"]["master_name"] )    
printf("┃[m 你的师傅是： [1;35m%-10s  [m       性别：[1;33m %-8s[37m                            ┃\n",
                ob->query("family/master_name"),
                ob->query("gender"));
 else  
printf("┃ [m你的师傅还没有出现！            性别：[1;33m %-8s [37m                           ┃\n",
                ob->query("gender"));
}
printf("┃[m 你共杀的人有：[1;31m%-4d个 [m           你杀的玩家有：  [1;32m %6d个[37m                  ┃\n",
                                my["MKS"] + my["PKS"], my["PKS"]);
        if (ob->query("married")) {
  if (ob->query("gender")=="女性") {
printf("┃[m 你的丈夫是：[32;1m%8s      [m      你的生辰是：[33;1m%-30s[37m ┃\n",
                          ob->query("couple/name"),
   CHINESE_D->chinese_date(((int)ob->query("birthday") - 14*365*24*60) * 60) );
 } else {
printf("┃[m 你的妻子是：[32;1m%8s          [m  你的生辰是：[33;1m%-30s [37m┃\n",
                ob->query("couple/name"),
   CHINESE_D->chinese_date(((int)ob->query("birthday") - 14*365*24*60) * 60) );
    }
} else { 
                if (ob->query("gender")=="女性")
printf("┃[m 你目前待字闺中。     [m           你的生辰是：[1;33m%-30s [37m┃\n",
   CHINESE_D->chinese_date(((int)ob->query("birthday") - 14*365*24*60) * 60) );
else
printf("┃ [m你目前还是光棍一条。      [m      你的生辰是：[1;33m%-30s [37m┃\n",
   CHINESE_D->chinese_date(((int)ob->query("birthday") - 14*365*24*60) * 60) );
}

        if( objectp(weapon = ob->query_temp("weapon")) )
                skill_type = weapon->query("skill_type");
        else
                skill_type = "unarmed";

        attack_points = COMBAT_D->skill_power(ob, skill_type,
SKILL_USAGE_ATTACK);
        parry_points = COMBAT_D->skill_power(ob, skill_type,
SKILL_USAGE_DEFENSE);
        dodge_points = COMBAT_D->skill_power(ob, "dodge",
SKILL_USAGE_DEFENSE);
printf("[1;37m┃ [m你的攻击力是：[32;1m%-6d[m (+[33;1m%-3d[m)     你的防御力是：[32;1m%-6d[m (+[1;33m%-3d[m)  [37;1m              ┃\n",

                attack_points/100 + 1, ob->query_temp("apply/damage"),
                (dodge_points + (weapon? parry_points:
(parry_points/10)))/100 + 1, ob->query_temp("apply/armor"));
       obstacles = ob->query("obstacle/number");
         if(obstacles)
printf("┃ [m你西行求取真经已过了[1;31m%-6s[m关    你现在要去杀死[1;36m%-10s[m的[1;35m%-10s[m      [1m┃\n",
    chinese_number(obstacles),ob->query("mieyao/place"),ob->query("mieyao/name"));
else 
printf("┃ [m你还没有过关呢.                 你现在要去杀死 [1;36m%-8s 的 [1;35m%-13s[0;1m   ┃\n",
        ob->query("mieyao/place"),ob->query("mieyao/name"));

printf("┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛[m\n");
printf("\n");
return 1;
}
string display_attr(int gift, int value)
{
        if( value > gift ) return sprintf( HIY "%3d" NOR, value );
        else if( value < gift ) return sprintf( CYN "%3d" NOR, value );
        else return sprintf("%3d", value);
}
int help(object me)
{
        write(@HELP
指令格式 : score
           score <对象名称>                   (巫师专用)

这个指令可以显示你或指定对象(含怪物)的基本资料。
基本资料的设定请参阅 'help setup'。

see also : hp
HELP
    );
    return 1;
}

