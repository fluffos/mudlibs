// shout.c

inherit F_CLEAN_UP;
#include <ansi.h>;

int main(object me, string arg)
{
          string wiz_status;
        if( !wizardp(me) )
                return notify_fail("目前暂不开放玩家 shout。\n");
       wiz_status = SECURITY_D->get_status(me);
         if( wiz_status != "(admin)" && wiz_status != "(arch)"  && wiz_status != "(wizard)" )
		return notify_fail("shout 指令影响玩家,请慎用.\n");
        if (!arg) return notify_fail("你想要大叫什么？\n");
       shout ( HIY"〖巫师公告〗：" + arg + "\n" NOR);
      shout ( HIY"〖巫师公告〗：" + arg + "\n" NOR);
        return 1;
}
int help(object me)
{
  write(@HELP
指令格式 : shout <讯息>
 
这个指令让你将 <讯息> 传送出去, 所有正在游戏中的人都
会听见你的话.
 
see also : tune
HELP
    );
    return 1;
}
 
