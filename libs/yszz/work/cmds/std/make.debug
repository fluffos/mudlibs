

#include <skill.h>
#include <ansi.h>
inherit F_CLEAN_UP;

void create() { seteuid(getuid()); }

int main(object me, string arg)
{
        int m=me->query_skill("medical",1);
        int f=me->query("force"),i;
        string env;
        object ash=find_object("/u/city/obj/ash");
        object *inv, bahan,baochi,baoming;
 
        if( me->is_fighting() )
                return notify_fail("你无法在战斗中，如何治药！\n");

        if (me->is_busy() || me->query_temp("pending/exercising"))
                return notify_fail("你现在正忙着呢。\n");

        if( !me->query_skill("medical", 1) )
                return notify_fail("开玩笑，你会医术(medical)吗？\n");
        if( !arg )
                return notify_fail("你要制什么药？\n");
        switch(arg) {

     case "bahan" :
              if( f < 50 ) { write("你的内力不够。\n"); return 1; }
             if( m < 30 )  { write("你的医术太低。\n"); return 1; }
             if(ash)
                {
       if(!present("chuan huajiao",environment(ash)) )
  { write("你身上没有足够的药材用来制武力拔寒散。\n");    return 1; }
                return 1;
                }
                else    {
            message_vision(MAG"只见$N运内力于胸，驱真气于药材之上。\n"
                  "不到一会的时间，药材渐渐的消失了，$N\n"
                  "感到真气与药材凝为一体。顿时$N感到\n"                  
                  "身上如火烧一般，而身上除了药丸以外\n"
                  "其他东西似乎也在燃烧，$N终于制成了武力拔寒散。\n"NOR,me );
                bahan=new("/clone/medicine/bahan");
                bahan->move(me);
                return 1;}
                 break;

                default:
                    {  write("开玩笑，哪有这种药？\n"); return 1; }
              }
        }
int help(object me)
{
   write( @HELP
指令格式: make <药品名称>

这是个治药的指令。

HELP
   );
   return 1;
}
