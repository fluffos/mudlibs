// team.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
    object *t;
    string msg;
    string name;
   int exp;
        exp = me->query("combat_exp");

    if( !arg ) {
        if( !pointerp(t = me->query_team()) )
            return notify_fail("你现在并没有参加任何队伍。\n");
        write("你现在队伍中的成员有：\n  " + implode(t->name(1), "\n  ") + "。\n");
        return 1;
    }
    if( arg=="dismiss" ) {
        if( !pointerp(t = me->query_team()) )
            return notify_fail("你现在并没有参加任何队伍。\n");
        if( me->is_team_leader() ) {
            message("team", me->name(1) + "将队伍解散了。\n", t, me);
            write("你将队伍解散了。\n");
           me->delete("degree");
        } else {
            message("team", me->name(1) + "决定脱离队伍。\n", t, me);
            write("你脱离了你的队伍。\n");
           me->delete("degree");
        }
        me->dismiss_team();
        return 1;
    }

    if( sscanf(arg, "with %s by %s", arg,name)==2 )
        {
        object ob;
        int i = strlen(name);

        if( !(ob = present(arg, environment(me)))
          ||    !living(ob)
          ||    !ob->is_character()
          ||    ob==me )
            return notify_fail("你想和谁成为伙伴？\n");

        if( ob->query("combat_exp") > exp*6/5  ||
            ob->query("combat_exp") < exp*4/5)
        return notify_fail("对不起，你们经验相差太多，组队可能会配合不好。\n");
         
        while(i--) {
                if( name[i]<=' ' ) {
                        write("对不起，你的队伍名称不能用控制字元。\n");
                        return 1;
                }
                if( strlen(name)> 10 )
                        return notify_fail("你设定的队伍名称过长！\n");
                if( i%2==0 && !is_chinese(name[i..<0]) ) {
                        write("对不起，请您用「中文」为队伍起名。\n");
                        return 1;
                }
                }
        if( !pointerp(me->query_team()) || me->is_team_leader() )
            {
          {
             if( me==(object)ob->query_temp("pending/team") ) 
             {
                if( !pointerp(me->query_team()) ) {
                    ob->add_team_member(me);
                    me->set("degree",name+"队队员 ");
                    message_vision("$N决定加入$n的队伍。\n", me, ob);
                    me->set("team_name",name);
                    ob->set("team_name",name);
                   } 
                  else {
                    me->add_team_member(ob);
                    ob->set("degree",name+"队队员 ");
                    me->set("degree",name+"队首领 ");
                    message_vision("$N决定让$n加入队伍。\n", me, ob);
                    ob->set("team_name",name);
                    me->set("team_name",name);
                        }
                ob->delete_temp("pending/team");
                return 1;
            }     else {
                message_vision("$N邀请$n加入$P的队伍。\n", me, ob);
                tell_object(ob, YEL "如果你愿意加入，请用 team with " + me->query("id") + " by " +name+"。\n" NOR);
                me->set_temp("pending/team", ob);
                me->set("degree",name+"队首领 ");
                me->set("team_name",name);
                return 1;
                       }
         }
        }
         // else
          //return notify_fail("只有队伍领袖可以邀请别人加入。\n");
        return 1;
        }

    if( sscanf(arg, "talk* %s", arg)==1 ) {
        string vb, emote_arg;
        if( !pointerp(t=me->query_team()) )
            return notify_fail("你现在并没有和别人组成队伍。\n");
        if( sscanf(arg, "%s %s", vb, emote_arg)!= 2 )
        {
            vb = arg;
            emote_arg = "";
        }
        if (!(msg = EMOTE_D->do_emote(me, vb, emote_arg, 1, 0, 0)))
            return 0;
        message("team", HIW "【队伍】" + msg + NOR, t);
        return 1;
    }
    else if( sscanf(arg, "talk %s", arg)==1 ) {
        if( !pointerp(t=me->query_team()) )
            return notify_fail("你现在并没有和别人组成队伍。\n");
        message("team", HIW "【队伍】" + me->name(1) + "：" + arg + "\n" NOR, t);
        return 1;
    }
    if( sscanf(arg, "form %s", arg)==1 ) {
        if( !pointerp(t=me->query_team()) || !me->is_team_leader() )
            return notify_fail("你必须是一个队伍的领袖才能组织阵形。\n");
        if( !me->query_skill(arg, 1) )
            return notify_fail("这种阵形你没学过。\n");
        return SKILL_D(arg)->form_array(me);
    }
}

int help(object me)
{
    write(@HELP
队伍指令使用方法:

team with <某人> by <名字> - 跟某人组成队伍. 必须要双方都同意加入才会生效。
team dismiss     - 离开队伍. 若下此指令的是劣谟, 则整个队伍会解散。
team talk <讯息> - 跟队伍里其他的人谈话, 可以用 tt <讯息> 替代。
team form <阵法> - 如果队伍的劣谟学过阵法的话，可以将队伍中的成员组织成
                   某种阵形，组成阵形的状态只要领袖一移动就会解除。

直接下 team 指令时则会显示你目前是否有加入队伍及队员名单。

注: team 跟 follow 是独立的，你不一定要 follow 队伍的领袖。
HELP
    );
    return 1;
}
