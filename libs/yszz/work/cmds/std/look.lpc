// snowcat 12/20/97
string ride_suffix (object me)
{
  string ridemsg = 0;
  object ridee = 0;

  ridee = me->ride();
  if (ridee)
    ridemsg = ridee->query("ride/msg")+"在"+ridee->name()+"上";
  return ridemsg;
}

void create() { seteuid(getuid()); }

int main(object me, string arg)
{
        object obj;
        int result;

        if( !arg ) result = look_room(me, environment(me));
        else if( (obj = present(arg, me)) || (obj = present(arg, environment(me)))) {
                if( obj->is_character() ) result = look_living(me, obj);
                else result = look_item(me, obj);
        } else result = look_room_item(me, arg);

        return result;
}

int look_room(object me, object env)
{
        int i;
        object *inv;
        mapping exits;
        string str, str1="", *dirs;
        string ridemsg = "";

        if( !env ) {
                write("你的四周灰蒙蒙地一片，什么也没有。\n");
                return 1;
        }
 switch (NATURE_D->outdoor_room_outcolor())
        {
              case "BLK":
        str = sprintf( HIC + "【[33m%s[1;36m】" + NOR + "   %s\n    %s" + BLK + "%s" + NOR,
                env->query("short"),
                wizardp(me)? file_name(env): "",
                env->query("long"),
                env->query("outdoors")? NATURE_D->outdoor_room_description():"")
;
                   break;
              case "RED":
        str = sprintf( HIC + "【[33m%s[1;36m】" + NOR + "  %s\n    %s" + RED + "%s" + NOR,
                env->query("short"),
                wizardp(me)? file_name(env): "",
                env->query("long"),
                env->query("outdoors")? NATURE_D->outdoor_room_description():"")
;
                   break;
              case "HIR":
        str = sprintf( HIC + "【[33m%s[1;36m】" + NOR + "  %s\n    %s" + HIR + "%s" + NOR,
                env->query("short"),
                wizardp(me)? file_name(env): "",
                env->query("long"),
                env->query("outdoors")? NATURE_D->outdoor_room_description():"")
;
                   break;
              case "HIY":
        str = sprintf( HIC + "【[33m%s[1;36m】" + NOR + "  %s\n    %s" + HIY + "%s" + NOR,
                env->query("short"),
                wizardp(me)? file_name(env): "",
                env->query("long"),
                env->query("outdoors")? NATURE_D->outdoor_room_description():"")
;
                   break;
              case "HIG":
        str = sprintf( HIC + "【[33m%s[1;36m】" + NOR + "  %s\n    %s" + HIG + "%s" + NOR,
                env->query("short"),
                wizardp(me)? file_name(env): "",
                env->query("long"),
                env->query("outdoors")? NATURE_D->outdoor_room_description():"")
;
                   break;
              case "YEL":
        str = sprintf( HIC + "【[33m%s[1;36m】" + NOR + "  %s\n    %s" + YEL + "%s" + NOR,
                env->query("short"),
                wizardp(me)? file_name(env): "",
                env->query("long"),
                env->query("outdoors")? NATURE_D->outdoor_room_description():"")
;
                   break;
              case "HIY":
        str = sprintf( HIC + "【[33m%s[1;36m】" + NOR + "  %s\n    %s" + HIY + "%s" + NOR,
                env->query("short"),
                wizardp(me)? file_name(env): "",
                env->query("long"),
                env->query("outdoors")? NATURE_D->outdoor_room_description():"")
;
                   break;
              case "BLU":
        str = sprintf( HIC + "【[33m%s[1;36m】" + NOR + "  %s\n    %s" + BLU + "%s" + NOR,
                env->query("short"),
                wizardp(me)? file_name(env): "",
                env->query("long"),
                env->query("outdoors")? NATURE_D->outdoor_room_description():"")
;
                   break;
              case "HIB":
        str = sprintf( HIC + "【[33m%s[1;36m】" + NOR + "  %s\n    %s" + HIB + "%s" + NOR,
                env->query("short"),
                wizardp(me)? file_name(env): "",
                env->query("long"),
                env->query("outdoors")? NATURE_D->outdoor_room_description():"")
;
                   break;
              case "MAG":
        str = sprintf( HIC + "【[33m%s[1;36m】" + NOR + "  %s\n    %s" + MAG + "%s" + NOR,
                env->query("short"),
                wizardp(me)? file_name(env): "",
                env->query("long"),
                env->query("outdoors")? NATURE_D->outdoor_room_description():"")
;
                   break;
              case "HIM": str = sprintf( HIC + "【[33m%s[1;36m】" + NOR + "  %s\n    %s" + HIM + "%s" + NOR,
                env->query("short"),
                wizardp(me)? file_name(env): "",
                env->query("long"),
                env->query("outdoors")? NATURE_D->outdoor_room_description():"")
;
                   break;
              case "CYN":
        str = sprintf( HIC + "【[33m%s[1;36m】" + NOR + "  %s\n    %s" + CYN + "%s" + NOR,
                env->query("short"),
                wizardp(me)? file_name(env): "",
                env->query("long"),
                env->query("outdoors")? NATURE_D->outdoor_room_description():"")
;
                   break;
              case "HIY":
        str = sprintf( HIC + "【[33m%s[1;36m】" + NOR + "  %s\n    %s" + HIY + "%s" + NOR,
                env->query("short"),
                wizardp(me)? file_name(env): "",
                env->query("long"),
                env->query("outdoors")? NATURE_D->outdoor_room_description():"")
;
                   break;
              case "WHT":
        str = sprintf( HIC + "【[33m%s[1;36m】" + NOR + "  %s\n    %s" + WHT + "%s" + NOR,
                env->query("short"),
                wizardp(me)? file_name(env): "",
                env->query("long"),
                env->query("outdoors")? NATURE_D->outdoor_room_description():"")
;
                   break;
              case "HIW":
        str = sprintf( HIC + "【[33m%s[1;36m】" + NOR + "  %s\n    %s" + HIW + "%s" + NOR,
                env->query("short"),
                wizardp(me)? file_name(env): "",
                env->query("long"),
                env->query("outdoors")? NATURE_D->outdoor_room_description():"")
;
                   break;
              default:
        str = sprintf( HIC + "【[33m%s[1;36m】" + NOR + "  %s\n    %s" + HIG + "%s" + NOR,
                env->query("short"),
                wizardp(me)? file_name(env): "",
                env->query("long"),
                env->query("outdoors")? NATURE_D->outdoor_room_description():"")
;
                   break;
        }   

        if( mapp(exits = env->query("exits")) ) {
                dirs = keys(exits);
                for(i=0; i<sizeof(dirs); i++)
                        if( (int)env->query_door(dirs[i], "status") & DOOR_CLOSED )
                                dirs[i] = 0;
                dirs -= ({ 0 });
                if( sizeof(dirs)==0 )
                        str += "    这里没有任何明显的出路。\n";
                else if( sizeof(dirs)==1 )
                        str += "    这里唯一的出口是 " + BOLD + dirs[0] + NOR + "。\n";
                else
                        str += sprintf("    这里明显的出口是 " + BOLD + "%s" + NOR + " 和 " + BOLD + "%s" + NOR + "。\n",
                                implode(dirs[0..sizeof(dirs)-2], "、"), dirs[sizeof(dirs)-1]);
        }
        inv = all_inventory(env);
        i=sizeof(inv);
        while(i--) {
                if( !me->visible(inv[i]) ) continue;
                if( inv[i]==me ) continue;
                if (ridemsg = ride_suffix(inv[i]))
                        str1 = "  " + inv[i]->short() + " <"+ridemsg +
                          ">\n"+str1;
                else    
                        str1 = "  " + inv[i]->short() + "\n"+str1;
        }

        write(str+str1);
        return 1;
}

int look_item(object me, object obj)
{
        mixed *inv;

//      write(obj->long());
        me->start_more(obj->long());
        inv = all_inventory(obj);
        if( sizeof(inv) ) {
                inv = map_array(inv, "inventory_look", this_object() );
                message("vision", sprintf("里面有：\n  %s\n",
                        implode(inv, "\n  ") ), me);
        }
        return 1;
}
