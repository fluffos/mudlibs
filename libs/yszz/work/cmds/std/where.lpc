// where.c
// 06-14-95

inherit F_CLEAN_UP;
#include <ansi.h>

int main(object me, string arg) {
  string str;
  object *list;
  object player;
  int i, j, ppl_cnt;
  object where;
  if (!wizardp(me) && !me->query("bigeye"))
    return notify_fail("你尚未炼成千里眼。\n");
  if (me->query("mana") < 500)
    return notify_fail("你的法力不够！\n");

  tell_room(environment(me), HIC "忽然一道亮光呼啸而来，原来是" + me->name() + "的眼睛在铄铄放光！\n" NOR);
  me = this_player();
  str = "—————————————————————————————————————\n";
  str += "使用代号      中文姓名          目前位置      \n";
  str += "—————————————————————————————————————\n";
  list = users();
  j = sizeof(list);
  if (!arg) {
    while (j--) {
      where = environment(list[j]);
      // Skip those users in login limbo.
      if (!where) continue;
      if (wizardp(list[j])) continue;
      str = sprintf(
        "%s%-14s%-18s%-s(%s)\n",
        str,
        list[j]->query("id"),
        list[j]->query("name"),
        where->query("short"),
        wizardp(me) ? file_name(where) : "",
      );
    }
    str += "—————————————————————————————————————\n";
    me->start_more(str);
    me->add("mana", -400);
    return 1;
  }
  player = find_player(arg);
  if (!player || wizardp(player)) return notify_fail("奇怪！怎么找不到这个人？\n"); ;
  where = environment(player);
  if (where)
    str = sprintf(
      "%s%-14s%-18s%-s(%s)\n",
      str,
      arg,
      player->query("name"),
      where->query("short"),
      wizardp(me) ? file_name(where) : "",
    );
  str += "-------------------------------------------------------------------------\n";
  me->start_more(str);
  me->add("mana", -400);
  return 1;
}

int help(object me) {
  write(@HELP
指令格式: where 

当你炼成千里眼时，可用此指令来看玩家所在。
HELP
  );
  return 1;
}
