  set("short", "脚部武器商店");
  set("long", @LONG

[37m         [32;47m     ▂▂▂▂▂▂▂▂▂▂▂▂▂▂▂▂▂▂▂▂      [1;37;40m▎
[37m         [1;31;47m     [37;42m ＷＥＡＰＯＮＳ  ＳＴＯＲＥ  脚部武器店 [31;47m      [37;40m▎
