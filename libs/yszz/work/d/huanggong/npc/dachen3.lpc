inherit NPC;
//string ask_war();

void create() {
  set_name("杜如晦", ({ "du ruhui", "du", "ruhui", "da chen" }));
  set("title", "大臣");
  set("gender", "男性");
  set("age", 60);
  set("per", 30);
  set("combat_exp", 300000);
  set_skill("force", 80);
  set_skill("spells", 80);
  set_skill("unarmed", 80);
  set_skill("dodge", 80);
  set_skill("parry", 80);
  set("gin", 3000);
  set("max_gin", 3000);
  set("kee", 3000);
  set("max_kee", 3000);
  set("sen", 3000);
  set("max_sen", 3000);
  set("force", 1000);
  set("max_force", 1000);
  set("mana", 1000);
  set("max_mana", 1000);
  set("force_factor", 80);
  /*set("inquiry", ([
        "报国" : (: ask_war :),
        "敌军" : (: ask_war :),
        ]));*/
  setup();
  carry_object("/d/obj/cloth/jinpao")->wear();
}
