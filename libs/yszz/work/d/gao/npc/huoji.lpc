// guanjia.c

inherit NPC;

void create()
{
       set_name("高才", ({"gao cai", "gao"}));
       set("long","一个小伙计，给管家跑腿．\n");
   set("title", "小伙计");
       set("gender", "男性");
       set("age", 16);
       set("attitude", "peaceful");
       set("shen_type", 1);
   set("combat_exp", 600);
   setup();
}

void init()
{
        object ob = this_player();
        object me = this_object();

 	if( !ob->query_temp("girl_asked")
  || !ob->query_temp("heard") )

        command("say 我那太公有一个女儿，年方二十岁，更不曾配人，三年前被一个妖精占去了。");
        command("say 那妖精做了三年女婿，我太公不悦，说道女儿招了妖精，不是长法，");
        command("say 一则败坏家门，二则每个亲家来往，一向要退这妖精，要妖精哪里肯退");
        command("say 转把女儿关在他福陵山的山洞里面，将有半年，不曾与家人相会。");
        command("say 我太公与我几两银子教我寻访法师，拿那妖怪，我这些时不曾住脚");
        command("say 前前后后请了三四个人，都是些不济的和尚，脓包的道士。降不得妖精");
        command("say 我刚才还挨骂了一顿。");
        command("sigh");
        ob->set_temp("heard",1);
        return;
}
