#include <armor.h>

inherit ARMOR;

void create() {
  set_name("碗子铁盔", ({ "wanzi tiekui", "kui", "jia", "armor" }));
  set_weight(8000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "一件盔甲。\n");
    set("value", 2500);
    set("material", "steel");
    set("armor_prop/armor", 45);
  }
  setup();
}
