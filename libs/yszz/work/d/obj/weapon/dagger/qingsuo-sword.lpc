// blackthorn.c

inherit F_UNIQUE;
#include <weapon.h>
inherit DAGGER;
#include <ansi.h>

void create()
{
        set_name(HIG"青索剑"NOR, ({ "qingsuo-sword"})
);
        set_weight(1);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
  set("long",
"一柄古剑,剑柄上刻有两个篆字"+HIG"「青索」"NOR+",剑身有一道青霞隐隐流动.\n");
                set("value", 9000);
                set("material", "gold");
set("wield_msg",
"九天之上忽传来一声凤鸣,青光闪过,$N手中多了一柄"+HIG"「青索」"NOR+"剑.\n");

set("unwield_msg","$N心念方才一动,青索剑便自行飞回鞘中.\n");
        }
        init_dagger(60);
        setup();
}

