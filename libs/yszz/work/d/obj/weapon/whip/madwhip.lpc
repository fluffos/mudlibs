// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

// blade.c

#include <weapon.h>
inherit F_UNIQUE;

inherit WHIP;

void create() {
  set_name("狂龙索", ({ "mad whip", "whip" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {

    set("long", "一条乌黑的长索, 里面附着恶龙的灵魂。\n");
    set("unit", "条");
    set("replace_file", "/d/obj/weapon/whip/pibian");
    set("value", 12000);
    set("wield_msg", "$N左手轻扬，一条黑色巨龙飞出, 刹时天昏地暗.\n");
    set("unwield_msg", "$N一招手, 巨龙化为一条黑烟飞回. 大家松了口气.\n");
    set("weapon_prop/courage", 5);
  }
  init_whip(150);
  set("is_monitored", 1);
  setup();
}
