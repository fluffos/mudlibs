// blade.c

#include <weapon.h>

inherit WHIP;

void create() {
  set_name("银鞭", ({ "sliver", "whip" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一条用银丝缠起来的鞭子。\n");
    set("unit", "条");
    set("value", 5000);
    set("wield_msg", "$N手指轻轻一弹,手上多了一条银光闪闪的鞭子。\n");
  }
  init_whip(45);
  setup();
}
