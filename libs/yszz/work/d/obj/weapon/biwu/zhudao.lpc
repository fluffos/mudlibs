#include <weapon.h>

inherit BLADE;

void create()
{
        set_name("竹刀", ({"zhu dao","dao", "blade"}));
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("value", 100);
                set("material", "wood");
                set("long", "比武用武器．\n");
                set("wield_msg", "$N抽出一把$n握在手中。\n");
                set("unequip_msg", "$N将手中的$n插入腰后．\n");
        }
        init_blade(1);
        setup();
}

