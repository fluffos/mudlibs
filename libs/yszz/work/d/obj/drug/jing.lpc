// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */
 

inherit COMBINED_ITEM;

void setup()
{}

void init()
{
        add_action("do_eat", "eat");
}

void create()
{
        set_name("养精丹", ({"yangjing dan", "dan"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("base_unit","颗");
                set("long", "一颗略带香气的药丸．\n");
                set("value", 2500);
          set("drug_type", "良药");
        }
        set_amount(1);
        setup();
}

int do_eat(string arg)
{
        if (!id(arg))
                return notify_fail("你要吃什么药？\n");
        if ((int)this_player()->query("eff_gin") == 
            (int)this_player()->query("max_gin"))
                return notify_fail("你现在不需要用养精丹。\n");
        else {
                this_player()->receive_curing("gin", 20);
                message_vision("$N吃下一颗养精丹，气色看起来好多了．\n",
this_player());
add_amount(-1);
                destruct(this_object());
                return 1;
        }
}

