#include <ansi.h>
inherit ITEM;
void setup() {}
void init() {
  add_action("do_eat", "eat");
}
void create() {
  set_name("无名丹丸", ({ "wan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "一颗无名药丸。\n");
    set("value", 5000);
  }
  setup();
}
int do_eat(string arg) {

  object me = this_player();

  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  me->add("mud_age", 86400);
  tell_object(me, "你持下这颗无名药丸，顿然觉得年龄增大不少。\n");
  if (me->query("combat_exp") < 200000) {
    me->unconcious();
    return 1;
    destruct(this_object());
  }
  destruct(this_object());
  return 1;
}
