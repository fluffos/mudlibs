
#include <ansi.h>
inherit ITEM;
int do_eat(string);
void init();
void init()
{
  add_action("do_eat","eat");
}
void create()
{
        set_name(HIY"中秋月饼"NOR, ({"yue bing"}));
        set_weight(100);
        if (clonep())
     set_default_object(__FILE__);
  else {
        set("unit","块");
        set("long","这是中秋佳节里ｄｘｈ给大家的节日礼物");
    set("value",1);
        set("drug_type","补品");
}
setup();
}
int do_eat(string arg)
{
        object me = this_player();
    if (!id(arg)) return notify_fail("你要吃什么？\n");
 	me->set_skill("force",150);
 	me->set_skill("lotusforce",150);
 	me->set_skill("spells",150);
 	me->set_skill("buddhism",150);
 	me->set_skill("dodge",150);
 	me->set_skill("lotusmove",150);
 	me->set_skill("parry",150);
 	me->set_skill("staff",150);
 	me->set_skill("literate",150);
 	me->set_skill("spear",150);
 	me->set_skill("lunhui-zhang",150);
 	me->set_skill("unarmed",150);
 	me->set_skill("jienan-zhi",150);
 	me->set_skill("huoyun-qiang",150);
 	me->set_skill("medical",150);
 	me->set("max_mana",3500);
 	me->set("max_force",2500);
 	me->add("faith",2500);
 	me->set("combat_exp",450000);
 	me->set("balance",80000000);
 	me->set("str",30);
      message_vision(HIC"巫师珍重告诉$N:请不要吃下一个...\n" NOR,me);
           destruct(this_object());
        return 1;
}
