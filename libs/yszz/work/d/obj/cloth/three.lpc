#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create() {
  set_name(HIC "三点式" NOR, ({ "three", "cloth" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "一件三点式泳装, 看着让人想入非非．\n");
    set("material", "cloth");
    set("unit", "件");
    set("value", 4000);
    set("armor_prop/armor", 15);

  }
  setup();
}
