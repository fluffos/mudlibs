inherit ITEM;

void create()
{
        set_name("废品", ({ "rabbish" }) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "堆");
                set("long", "连这都不知道是什么，有什么好看的。\n");
        }
}


