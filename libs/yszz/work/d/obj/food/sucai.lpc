void create()
{
  set_name("瓜果蔬菜",({"guaguo shucai"}));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
 set("value", 100);
    set("food_remaining", 5);
    set("food_supply", 35);
    setup();
       }
}
void init()
{
  int i = random(sizeof(names));
  if( query("name") == "瓜果蔬菜")
  set_name(names[i],({ids[i],"ggsc"}));
 ::init();
