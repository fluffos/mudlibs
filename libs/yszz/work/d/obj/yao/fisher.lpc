inherit NPC;
#include <ansi.h>

string ask_kill();
void create()
{
        set_name("张梢", ({"fisher","zhangshao","zhang"}));
        set("gender", "男性" );
        set("age", 45);
        set("title","渔夫");
        set("long", "他虽是个渔夫，却也知书达理，能吟诗作词。\n跟附近一个叫李定的樵夫乃是知交好友。\n");
        set("combat_exp", 500);
        set("attitude", "peaceful");
        set_skill("dodge", 10);
        set_skill("unarmed", 20);
        set_skill("literate", 30);
        set("per", 25);
        set("max_kee", 200);
        set("max_gin", 100);
        set("max_sen", 100);
        set("inquiry",([
          "kill":(:ask_kill:),
          ]));
        setup();
        carry_object("/d/ourhome/obj/linen")->wear();
}

string ask_kill()
{
	object me=this_player();
//    return "/d/obj/yao/mieyao"->query_yao(me);
    write(WHT+"/d/obj/yao/mieyao"->query_yao(me)+NOR);
          command("hmm " + me->query("id"));
        return "速去速回";
}
