set_default_object(__FILE__);
else {
set("unit", "本");
set("value", 100);
set("material", "paper");
set("skill", ([
   "name": "jueqingbian",
    "sen_cost": 80,
    "difficulty": 100,
     "max_skill": 140,
]));
}
}
