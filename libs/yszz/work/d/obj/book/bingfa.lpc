/* <SecCrypt CPL V3R05> */


inherit ITEM;

void create() {
  set_name("兵法", ({ "bingfa", "book" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "1>");
    set("value", 1000);
    set("material", "paper");
    set("skill", ([
      "name": "bingfa",
      "sen_cost": 20,
      "difficulty": 20,
      "max_skill": 100,
    ]));
  }
}

void init() {
  object ob = this_player();
  object me = this_object();

  if (me->query("owner") != ob->query("id"))
    remove_call_out("des");
  call_out("des", 1, ob);
}

void des(object ob) {
  tell_object(ob, "书转眼就不见了！\n");
  destruct(this_object());
}
