// literate.c

inherit ITEM;

void create()
{
        set_name("〖逃课大法〗", ({"book"}));
        set_weight(400);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "本");
     set("value", 600);
   set("long", "一本薄薄的的小册子，说了些逃课的法门。
旁注小字：逃课第一人作\n");
        set("material", "paper");
        set("skill", ([
  "name": "dodge",
                        "exp_required": 300,
"sen_cost": 20,
   "difficulty": 25,
"max_skill": 100,
]) );
        }
}

