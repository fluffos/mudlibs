inherit ROOM;

void create ()
{
  set ("short", "宠物商店训练场一");
  set ("long", @LONG

    一个小小的土场地，专门用来训练宠物的！
LONG);

  set("exits", ([
               "west" : __DIR__"petshop",
      ]));
  set("objects", ([
        __DIR__"npc/pettrainer" :  1,
        __DIR__"npc/pettrainer2" :  1,
        __DIR__"npc/pettrainer3" :  1,
        __DIR__"npc/pettrainer4" :  1,
      ]));

  setup();
}


