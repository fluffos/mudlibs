#include <ansi.h>

inherit NPC;

void create() {
  set_name("亲兵队长", ({ "qinbing duizhang", "duizhang", "qinbing" }));
  set("gender", "男性");
  set("age", 40);
  set("long",
    "他就是当今「中神通」的亲兵队长, 身披铁甲，手执钢剑。\n");

  set("combat_exp", 500000);
  set("attitude", "heroism");

  set("str", 24);
  set("con", 22);
  set("int", 22);
  set("dex", 22);
  set("no_get", 1);
  set("max_kee", 3000);
  set("eff_kee", 3000);
  set("kee", 3000);
  set("max_mana", 4000);
  set("mana", 4000);
  set("force", 3000);
  set("max_force", 3000);
  set("jiali", 50);

  set_temp("apply/attack", 50);
  set_temp("apply/defense", 50);

  set_skill("sword", 160);
  set_skill("unarmed", 160);
  set_skill("parry", 160);
  set_skill("dodge", 160);
  set("chat_chance", 10);

  setup();

  carry_object("/d/obj/weapon/sword/changjian")->wield();

}
