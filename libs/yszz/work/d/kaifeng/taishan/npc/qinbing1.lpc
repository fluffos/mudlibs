#include <ansi.h>

inherit NPC;

void create() {
  set_name("亲兵", ({ "qinbing" }));
  set("gender", "男性");
  set("age", 40);
  set("long",
    "他就是当今「中神通」的亲兵, 身披铁甲，手执钢剑。\n");

  set("combat_exp", 400000);
  set("attitude", "heroism");

  set("str", 24);
  set("con", 20);
  set("int", 20);
  set("dex", 20);

  set("max_kee", 800);
  set("eff_kee", 3000);
  set("kee", 3000);
  set("max_mana", 4000);
  set("mana", 4000);
  set("force", 3000);
  set("max_force", 3000);
  set("enforce_actor", 50);

  set_temp("apply/attack", 50);
  set_temp("apply/defense", 50);

  set_skill("sword", 100);
  set_skill("unarmed", 100);
  set_skill("parry", 100);
  set_skill("dodge", 100);
  set("chat_chance", 10);

  setup();

  carry_object("/d/obj/weapon/sword/changjian")->wield();

}
