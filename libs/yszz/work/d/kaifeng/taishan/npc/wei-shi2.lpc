#include <ansi.h>

inherit NPC;

void create()
{
        set_name(HIR "红衣武士" NOR, ({ "wei shi", "shi", "guard" }) );
        set("gender", "男性");
        set("age", 35);
        set("long",
                "这是位红衣武士，身披钢甲，手执长剑，双目精光炯炯，警惕地巡视着四周的情形。\n");
        set("combat_exp", 140000);
        set("shen_type", 1);
        set("attitude", "heroism");

        set("str", 28);
        set("con", 23);
        set("int", 20);
        set("dex", 26);

        set("combat_exp", 20000);
        set("shen_type", -1);
        set("attitude", "heroism");

        set("apply/attack",  30);
        set("apply/defense", 30);

        set_skill("sword", 60);
        set_skill("unarmed", 50);
        set_skill("parry", 50);
        set_skill("dodge", 50);

        setup();

        add_money("silver", 20);
}
void init()
{
        object ob1;
        string mengzhu;
        
        if(!( ob1 = find_living("zhong shentong")) )
        ob1 = load_object("/u/fly/npc/zhong");
        mengzhu = ob1->query("winner");

        if( this_player()->query("id") == mengzhu ) {
                command("bow "+this_player()->query("id"));
                return;
        }       
                
        ::init();
}
