// 妖神之争
// by happ

inherit ROOM;
#include <ansi.h> 
int block_cmd(string);

void create()
{
        set("short", "擂台");
        set("long", @LONG

        开国元勋 尉迟恭功成名就以后，闲的无事，便摆起了擂台，
专门看别人打群架，不过这里面是不会伤人。

LONG
        );

  set("no_quit",1);
  set("no_flee",1);
  set("broadcast",1);
  set("alternative_die",1);
  setup();
}

void init()
{
   object ob = this_player();
   add_action("block_cmd", "", 1);
   remove_call_out("check");
   call_out("check",1,ob);   
}

int block_cmd(string args)
{
        string verb;
        verb = query_verb();

    if (verb == "cast" || verb == "perform" || verb == "bandage"
     || verb == "steal"|| verb == "bandage" || verb == "ji" || verb == "team")
        {
        write("擂台之上，不要乱动。\n");
        return 1;
        }
    if( verb == "kill" || verb == "fight" )
        {
        write("请使用 teamkill 指令，擂台之上不伤阳寿。\n");
        return 1;
        }

        return 0;
}
void do_none()
{
        tell_object(this_player(),"比武场上不要乱来。\n");
}

void do_kill()
{
        tell_object(this_player(),"请使用teamkill命令。\n");
        return 0;
}

void check(object ob)
{
        int i;
        object *t,*inv;
        int kee = ob->query("kee");
        int sen = ob->query("sen");
        int maxkee = ob->query("max_kee");
        int maxsen = ob->query("max_sen");
        int exp = ob->query("combat_exp");
        t = ob->query_team();

        inv = all_inventory(this_object());

        if( (kee < maxkee/5) || (sen < maxsen/5) )
             {
        message("channel:chat",HIC"【闲聊】尉迟恭(Yuchi gong)："+ob->query("degree")+ob->name()+"被踢下了擂台。\n"NOR,users());
              ob->set(kee,maxkee/5);
              ob->set(sen,maxsen/5);
              ob->move(__DIR__"qilin2");
             }

        if( sizeof(inv) == 1 )    {
        if( !pointerp(t)) 
             {
        message("channel:chat",HIC"【闲聊】尉迟恭(Yuchi gong)："+ob->name()+"，你一个人跑到擂台上干什么，是不是想死？\n"NOR,users());
            ob->move(__DIR__"qilin2");
             return;
              }
        for(i=0;i<sizeof(t);i++){
             if( t[i]->query("team_name") == ob->query("team_name") )
            call_out("award",1,ob);
                }

        call_out("check",1,ob);

}


void award(object ob)
{
     object ob = this_player();
       int exp = ob->query("combat_exp");
       
        message("channel:chat",HIC"【闲聊】尉迟恭(Yuchi gong)："+ob->query("team_name")+"队取得比赛的胜利。\n"NOR,users());
        ob->move(__DIR__"qilin2");
        ob->set_temp("win",1);
        
        for(i=0;i<sizeof(t);i++){
                t[i]->add("combat_exp", exp/2000 );
                t[i]->add("potential", exp/2500 );
        tell_object(t[i],"你得到了"+chinese_number(exp/2000)+"，和"+chinese_number(exp/2500)+"点潜能。\n");
                }        

}
