// happ@yszz

inherit ROOM;
#include <ansi.h>
int block_cmd(string);
void create() {
  set("short", "bbs");
  set("long", @LONG
LONG);
  setup();
}
void init() {
  object ob = this_player();
  ob->delete("channels");
  add_action("block_cmd", "", 1);
  add_action("do_1", "1");
  add_action("do_2", "2");
  add_action("do_3", "3");
  add_action("do_4", "4");
  add_action("do_5", "5");
  add_action("do_6", "6");
  add_action("do_7", "7");
  add_action("do_8", "8");
  add_action("do_9", "9");
  remove_call_out("menu");
  call_out("menu", 1, ob);
}
