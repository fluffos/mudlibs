int block_cmd(string args) {
  string verb;
  verb = query_verb();
  if (verb == "kill" || verb == "quit" || verb == "chat" || verb == "es"
    || verb == "mp" || verb == "ys" || verb == "rumor" || verb == "fight"
    || verb == "tell" || verb == "whisper" || verb == "steal" ||
    verb == "fly")
    return 1;
  return 0;
}

void menu(object ob) {
  ob->command_function("cls");
  printf("\n[1;44;33m★ 阅读文章 ★                      妖神之争站                                  [m\n");
  printf("目前选择：[[47;32;1mNone     [m]                                         \n");
  printf("[1;31m□——————————————┤[37m活  动  看  板[31m├——————————————□ \n\n");
  printf(" [32m                欢迎光临妖神之争！ [37m%s ，[32m记住我们的地址吧！\n\n", ob->name());
  printf("                            [44;5m202.119.144.5 8000[m      \n\n");
  printf("                   [33;1m站长：[37mhapp(如梦) meokey(天龙八部)[m\n");
  printf("[1;31m□—————————————————————————————————————□[m\n\n");
  printf("        (1)help newbie        新手入门篇\n");
  printf("        (2)help hints-dxh     新手拜师篇\n");
  printf("        (3)help hints-xhf     新手成长篇\n");
  printf("        (4)help feature       本站的特点\n");
  printf("        (5)help renwu         门派任务篇\n");
  printf("        (6)help task          关于任务榜\n");
  printf("        (7)help faith         关于忠诚度\n");
  printf("        (8)help news          本站新变化\n");
  printf("        (9)exit               返回上一层\n");
  printf("                                              Since December 1998\n");
  printf("[1;44m请输入您的选择（1、2、3、4、5、6、７、８、９）                                  [m\n");
  return;
}
int do_1() {
  object ob = this_player();
  ob->command_function("help newbie");
  call_out("menu", 1, ob);
  return 1;
}
