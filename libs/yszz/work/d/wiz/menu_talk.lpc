int block_cmd(string args)
{
    string verb;
    verb = query_verb();
   if(verb == "kill" || verb == "quit" || verb == "chat"  || verb == "es"
    || verb == "mp"  || verb == "ys"  || verb == "rumor"  || verb == "fight"
    || verb == "tell" || verb == "whisper" || verb == "steal" ||
      verb == "fly" )
return 1;
        return 0;
}
void menu(object ob)
{
        ob->command_function("cls");
printf("\n[1;44;33m★ 阅读文章 ★                      妖神之争站                                  [m\n");
printf("目前选择：[[47;32;1mNone     [m]                                         \n");
printf("[1;31m□——————————————┤[37m活  动  看  板[31m├——————————————□ \n\n");
printf(" [32m                欢迎光临妖神之争！ [37m%s ，[32m记住我们的地址吧！\n\n",ob->name());
printf("                            [44;5m202.119.144.5 8000[m      \n\n");
printf("                   [33;1m站长：[37mhapp(如梦) meokey(天龙八部)[m\n"); 
printf("[1;31m□—————————————————————————————————————□[m\n\n\n");
printf("        (1)查看在线玩家         \n");
printf("        (2)查询网友             \n");
printf("        (3)进入聊天室           \n");
printf("        (4)返回上一层           \n\n\n\n\n\n"); 
printf("[1;44m请输入您的选择（1、2、３、４）                                                 [m\n");
return ;
}

int do_1()
{
        object ob = this_player();
        ob->command_function("who");
        call_out("menu",3,ob);
        return 1;
}

int do_2()
{
        object ob = this_player();
        ob->start_more( FINGER_D->finger_all() );
        call_out("menu",3,ob);
        return 1;
}
int do_3()
{
        object ob = this_player();
        ob->move("/u/city/chatroom");
        return 1;
}
int do_4()
{
        object ob = this_player();
         ob->move(__DIR__"menu");
        return 1;
}
