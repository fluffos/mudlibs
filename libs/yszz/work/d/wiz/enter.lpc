// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

//changan city
int block_cmd(string);
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "[1;33m入门[m");
  set("long", @LONG

        本MUD游戏为西游记最新版本，如看本MUD不同之处，请help feature.

LONG);

  set("exits", ([
    "east": __DIR__ "faith",
  ]));

  set("objects",
    ([  //sizeof() == 1
    __DIR__ "npc/welcome": 1,
    ]));
  set("no_clean_up", 0);
  set("no_kill", 1);
  set("no_magic", 1);
  setup();
}

void init() {
  object ob = this_player();
  ob->command_function("cls");
  tell_object(ob, HIY "           欢迎光临西游记最新版本--- 妖神之争        \n" NOR);
}

int block_cmd(string args) {
  string verb;
  verb = query_verb();

  if (verb == "bian") return 1;
  if (verb == "xiudao") return 1;
  if (verb == "kill") return 1;
  if (verb == "exert") return 1;
  if (verb == "cast") return 1;
  if (verb == "fly") return 1;
  return 0;
}
