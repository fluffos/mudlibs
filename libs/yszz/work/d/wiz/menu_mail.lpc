// happ@yszz

inherit ROOM;
#include <ansi.h>
int block_cmd(string);
void create ()
{
        set ("short", "bbs");
        set ("long", @LONG
LONG);
        setup();
}
void init()
{
        object ob = this_player();
        ob->delete("channels");
        add_action("block_cmd","", 1);
        add_action("do_1","1");
        add_action("do_2","2");
        add_action("do_3","3");
        add_action("do_4","4");
        add_action("do_5","5");
        remove_call_out("menu");
        call_out("menu",1,ob);
}

int block_cmd(string args)
{
    string verb;
    verb = query_verb();
   if(verb == "kill" || verb == "quit" || verb == "chat"  || verb == "es"
    || verb == "mp"  || verb == "ys"  || verb == "rumor"  || verb == "fight"
    || verb == "tell" || verb == "whisper" || verb == "steal" ||
      verb == "fly" )
return 1;
        return 0;
}

void menu(object ob)
{
        object mbox;
        seteuid(getuid());
        mbox = new(MAILBOX_OB);
        present("mailbox",ob)?printf("\n"):mbox->move(ob);
        ob->command_function("cls");
printf("\n[1;44;33m★ 阅览信件 ★                      妖神之争站                                  [m\n");
printf("目前选择：[[47;32;1mNone     [m]                                         \n");
printf("[1;31m□——————————————┤[37m活  动  看  板[31m├——————————————□ \n\n");
printf(" [32m                欢迎光临妖神之争！ [37m%s ，[32m记住我们的地址吧！\n\n",ob->name());
printf("                            [44;5m202.119.144.5 8000[m      \n\n");
printf("                   [33;1m站长：[37mhapp(如梦) meokey(天龙八部)[m\n"); 
printf("[1;31m□—————————————————————————————————————□[m\n");
printf("                                     \n");
printf("    (1)check       查看所有信件          \n");
printf("    (2)read        阅读信件          \n");
printf("    (3)delete      删除信件    \n");
printf("    (4)mail        寄信 \n");
printf("    (5)exit        回到主选单          \n\n\n");
printf("                                     \n");
printf("                                              Since December 1998\n");
printf("[1;44m请输入您的选择（1、2、3、4、5）                                         [m\n");
return ;
}

int do_1()
{
        object ob = this_player();
        ob->command_function("from");
        call_out("menu",3,ob);
        return 1;
}

void do_2()
{
        object ob = this_player();
        call_out("menu",10,ob);
}

void do_3()
{
        object ob = this_player();
        call_out("menu",10,ob);
}

void do_4()
{
        object ob = this_player();
        call_out("menu",10,ob);
}

int do_5()
{
        object mbox;
        object ob = this_player();
        mbox=present("mailbox",ob);
        ob->move(__DIR__"menu");
        destruct(mbox);
        return 1;
}
