// happ@yszz

inherit ROOM;
#include <ansi.h>
int block_cmd(string);
void create() {
  set("short", "bbs");
  set("long", @LONG
LONG);
  setup();
}
void init() {
  object ob = this_player();
  ob->delete("channels");
  add_action("block_cmd", "", 1);
  add_action("do_1", "1");
  add_action("do_2", "2");
  add_action("do_3", "3");
  add_action("do_4", "4");
  add_action("do_5", "5");
  add_action("do_6", "6");
  remove_call_out("menu");
  call_out("menu", 1, ob);
}

int block_cmd(string args) {
  string verb;
  verb = query_verb();
  if (!wizardp(this_player())) {
    if (verb != "1" || verb != "2" || verb != "3" || verb != "4" || verb != "5" || verb != "6")
      return 1;
  }
  return 0;
}

void menu(object ob) {
  ob->command_function("cls");
  printf("\n[1;44;33m★ 系统设置 ★                      妖神之争站                                  [m\n");
  printf("目前选择：[[47;32;1mNone     [m]                                         \n");
  printf("[1;31m□——————————————┤[37m活  动  看  板[31m├——————————————□ \n\n");
  printf(" [32m                欢迎光临妖神之争！ [37m%s ，[32m记住我们的地址吧！\n\n", ob->name());
  printf("                            [44;5m202.119.144.5 8000[m      \n\n");
  printf("                   [33;1m站长：[37mhapp(如梦) meokey(天龙八部)[m\n");
  printf("[1;31m□—————————————————————————————————————□[m\n");
  printf("    (1)不接受别人的tell          %s             \n", ob->query("env/block_tell") ? "■" : "□");
  printf("    (2)设定自动逃跑参数为 50     %s             \n", ob->query("env/wimpy") ? "■" : "□");
  printf("    (3)不显示地图描述            %s             \n", ob->query("env/brief") ? "■" : "□");
  printf("    (4)设置隐身(巫师专用)        %s             \n", ob->query("env/invisibility") ? "■" : "□");
  printf("    (5)设置不死(巫师专用)        %s             \n", ob->query("env/immortal") ? "■" : "□");
  printf("    (6)回到主选单                       \n\n\n\n\n");
  printf("                                              Since December 1998\n");
  printf("[1;44m请输入您的选择（1、2、3、4、5、6）                                         [m\n");
  return;
}

int do_1() {
  object ob = this_player();
  ob->query("env/block_tell") ? ob->delete("env/block_tell") : ob->set("env/block_tell", 1);
  call_out("menu", 2, ob);
  return 1;
}

int do_2() {
  object ob = this_player();
  ob->query("env/wimpy") ? ob->delete("env/wimpy") : ob->set("env/wimpy", 50);
  call_out("menu", 2, ob);
  return 1;
}

int do_3() {
  object ob = this_player();
  ob->query("env/brief") ? ob->delete("env/brief") : ob->set("env/brief", "YES");
  call_out("menu", 2, ob);
  return 1;
}

int do_4() {
  object ob = this_player();
  wizardp(ob) && ob->query("env/invisibility") ? ob->delete("env/invisibility") : ob->set(
    "env/invisibility",
    10
  );
  call_out("menu", 2, ob);
  return 1;
}
int do_5() {
  object ob = this_player();
  wizardp(ob) && ob->query("env/immortal") ? ob->delete("env/immortal") : ob->set(
    "env/immortal",
    10
  );
  call_out("menu", 2, ob);
  return 1;
}

int do_6() {
  object ob = this_player();
  ob->move(__DIR__ "menu");
  return 1;
}
