inherit ROOM;
#include <ansi.h>
void create() {
  set("short", HIG "命运的路口" NOR);
  set("long", @LONG

   来到这里，你已经开始了你或妖或神的旅程，那么祝福你
一路顺风。
LONG);
  set("exits", ([
    "west": __DIR__ "renwu",
    "south": __DIR__ "lg",
    "northwest": __DIR__ "yg",
    "north": __DIR__ "wzg",
    "westdown": __DIR__ "wdd",
    "southwest": __DIR__ "lt",
  ]));
  set("no_clean_up", 0);
  setup();
  replace_program(ROOM);
}
