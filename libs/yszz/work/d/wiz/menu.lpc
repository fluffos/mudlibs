// happ@yszz

inherit ROOM;
#include <ansi.h>
int block_cmd(string);
void create ()
{
        set ("short", "bbs");
        set ("long", @LONG
LONG);
        setup();
}
void init()
{
        object ob = this_player();
        ob->delete("channels");
        add_action("block_cmd","", 1);
        add_action("do_1","1");
        add_action("do_2","2");
        add_action("do_3","3");
        add_action("do_4","4");
        add_action("do_5","5");
        add_action("do_6","6");
        remove_call_out("menu");
        call_out("menu",1,ob);
}

int block_cmd(string args)
{
    string verb;
    verb = query_verb();
        if( ! wizardp(this_player()) )
         {
        if( verb != "1"||verb!="2"||verb!="3"||verb!="4"||verb!="5"||verb!="6")
        return 1;
          }
        return 0;
}

void menu(object ob)
{
        ob->command_function("cls");
printf("\n[1;44;33m★ 主选单 ★                      妖神之争站                                    [m\n");
printf("目前选择：[[47;32;1mNone     [m]                                         \n");
printf("[1;31m□——————————————┤[37m活  动  看  板[31m├——————————————□ \n\n");
printf(" [32m                欢迎光临妖神之争！ [37m%s ，[32m记住我们的地址吧！\n\n",ob->name());
printf("                            [44;5m202.119.144.5 8000[m      \n\n");
printf("                   [33;1m站长：[37mhapp(如梦) meokey(天龙八部)[m\n"); 
printf("[1;31m□—————————————————————————————————————□[m\n");
printf("                                     |||        _       ,|| .      _        |||\n");
printf("    (1)read        阅读文章          |||    *  / \_ *  / ||       ((         |||\n");
printf("    (2)mail        处理信笺          |||      /    \  /  ||\,      `     .    |||\n");
printf("    (3)talk        谈天说地          ||+--*--------------++-----------------+||\n");
printf("    (4)service     特别服务          |||   /    \/  \  _|| \-'\      *   /.    |||\n");
printf("    (5)infoEdit    工具箱            |||  /\  .-   `. \/ ||  \ /===~=-~==-;.   |||\n");
printf("    (6)leave       返回ＭＵＤ中。    ||| /  `-.__ ^   / .||.--\ ==-=~_-==^/  |||\n");
printf("                                     |||/        `.  / / ||    `..~-^==~^=.-|||\n");
printf("                                     |+--------------------------------------+|\n");
printf("                                              Since December 1998\n");
printf("[1;44m请输入您的选择（1、2、3、4、5、6）                                           [m\n");
return ;
}

int do_1()
{
        this_player()->move(__DIR__"menu_read");
        return 1;
}
int do_2()
{
        this_player()->move(__DIR__"menu_mail");
        return 1;
}
int do_3()
{
        this_player()->move(__DIR__"menu_talk");
        return 1;
}
int do_4()
{
        this_player()->move(__DIR__"menu_ser");
        return 1;
}
int do_5()
{
       this_player()->move(__DIR__"menu_conf");
       return 1;
}
int do_6()
{
        tell_object(this_player(),HIC"欢迎光临妖神之争BBS。\n");
        this_player()->move("/d/city/kezhan");
        return 1;
}
