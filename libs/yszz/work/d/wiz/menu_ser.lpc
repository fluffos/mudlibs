// happ@yszz

inherit ROOM;
#include <ansi.h>
int block_cmd(string);
void create() {
  set("short", "bbs");
  set("long", @LONG
LONG);
  setup();
}
void init() {
  object ob = this_player();
  ob->delete("channels");
  add_action("block_cmd", "", 1);
  add_action("do_1", "1");
  add_action("do_2", "2");
  add_action("do_3", "3");
  add_action("do_4", "4");
  add_action("do_5", "5");
  add_action("do_6", "6");
  remove_call_out("menu");
  call_out("menu", 1, ob);
}

int block_cmd(string args) {
  string verb;
  verb = query_verb();
  if (!wizardp(this_player())) {
    if (verb != "1" || verb != "2" || verb != "3" || verb != "4" || verb != "5" || verb != "6")
      return 1;
  }
  return 0;
}

void menu(object ob) {
  ob->command_function("cls");
  printf("\n[1;44;33m★ 阅读文章 ★                      妖神之争站                                  [m\n");
  printf("目前选择：[[47;32;1mNone     [m]                                         \n");
  printf("[1;31m□——————————————┤[37m活  动  看  板[31m├——————————————□ \n\n");
  printf(" [32m                欢迎光临妖神之争！ [37m%s ，[32m记住我们的地址吧！\n\n", ob->name());
  printf("                            [44;5m202.119.144.5 8000[m      \n\n");
  printf("                   [33;1m站长：[37mhapp(如梦) meokey(天龙八部)[m\n");
  printf("[1;31m□—————————————————————————————————————□[m\n");
  printf("        (1)押签         \n");
  printf("        (2)骨骰             \n");
  printf("        (3)斗鸡           \n");
  printf("        (4)赛龟                 \n");
  printf("        (5)围棋                 \n");
  printf("        (6)退出                 \n\n\n\n\n");
  printf("[1;44m请输入您的选择（1、2、３、４、５、６）                                         [m\n");
  return;
}

int do_1() {
  object ob = this_player();
  ob->move("/u/city/duchang1");
  return 1;
}

int do_2() {
  object ob = this_player();
  ob->move("/u/city/duchang2");
  return 1;
}
int do_3() {
  object ob = this_player();
  ob->move("/u/city/duchang3");
  return 1;
}
int do_4() {
  object ob = this_player();
  ob->move("/u/city/duchang4");
  return 1;
}
int do_5() {
  object ob = this_player();
  ob->move("/d/changan/pinqiting");
  return 1;
}
int do_6() {
  object ob = this_player();
  ob->move(__DIR__ "menu");
  return 1;
}
