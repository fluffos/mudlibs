// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

// xunshi.c
string ask_make();
string ask_see(object me);
inherit NPC;
void create() {
  set_name("冰谷巡使", ({ "xunshi", "shi" }));
  set("gender", "男性");
  set("age", 33);
  set(
    "long",
    "雪山门下有很多巡使。因为外人很少能到这里，\n在谷内的巡使大多武功不高，至于大雪山的法术则基本上不会。\n这位巡使身披白袍，腰跨弯刀。白袍当胸绣着一只飞扬欲脱的大鹏鸟。\n弯刀看起来晶莹透明，好像是以寒冰制成。\n"
  );
  set("class", "yaomo");
  set("combat_exp", 25000);
  set("attitude", "peaceful");
  create_family("大雪山", 4, "弟子");
  set_skill("unarmed", 30);
  set_skill("yingzhaogong", 30);
  set_skill("dodge", 30);
  set_skill("parry", 30);
  set_skill("blade", 30);
  set_skill("bingpo-blade", 30);
  set_skill("xiaoyaoyou", 30);
  set_skill("force", 30);
  set_skill("ningxie-force", 30);
  map_skill("force", "ningxie-force");
  map_skill("blade", "bingpo-blade");
  map_skill("dodge", "xiaoyaoyou");
  map_skill("unarmed", "yingzhaogong");

  set("per", 19);
  set("max_kee", 300);
  set("max_sen", 300);
  set("force", 300);
  set("max_force", 250);
  set("force_factor", 5);

  set("eff_dx", -8000);
  set("nkgain", 60);

  set("inquiry", ([
    "冰刀": (: ask_make :),
    "护驾": (: ask_see :),

  ]));
  setup();
  carry_object("/d/obj/cloth/xueshan-pao")->wear();
  carry_object("/d/obj/weapon/blade/iceblade")->wield();
  //    carry_object("/d/xueshan/obj/chanzi");
}
string ask_make() {
  object me = this_player();
  object chanzi = new("/d/xueshan/obj/chanzi");
  if ((string)me->query("family/family_name") != "大雪山")
    return ("您不是本门中人。");
  if (me->query("faith") > 300)
    return ("您是本门大有名望之人，怎敢有劳您做这种杂务呢？");
  if (me->query("combat_exp") > 100000)
    return ("你已经不需要靠这种方式加忠诚了！\n");
  chanzi->move(me);
  me->set("xueshan/make", 1);
  return ("这样，那就 麻烦您帮我造一些冰刀吧.（make icedao）");
}
string ask_see(object me) {
  me = this_player();
  if ((string)me->query("family/family_name") != "大雪山")
    return ("你是谁？我好象并不认识你！\n");
  if (me->query("combat_exp") < 250000)
    return ("你的武功自保尚且不足,还谈什么护驾，真是不自量力。\n");
  if (me->query("faith") > 1000)

  {
    message_vision("冰谷巡使道：现在明王正需要人保护，快去。\n");
    message_vision("只见你来到了一个陌生的地方。\n");
    me->move("/d/xueshan/dixiashi");
    tell_room(environment(me), "大鹏明王到：好呀，又来了一个护驾的。\n");
  } else {
    return ("你有这么忠心，我怎么就不相信呢。嘿嘿！\n");
  }
}
