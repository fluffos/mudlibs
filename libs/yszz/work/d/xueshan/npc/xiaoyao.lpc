// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

// worker.c
inherit NPC;
string ask_shaodi();
void create() {
  set_name("扫地小妖", ({ "xiao yao" }));
  set("gender", "男性");
  set("age", 13);
  set("long", "一个小妖，正在轻轻的扫地");
  set("combat_exp", 1000);
  set_skill("stick", 20);
  set_skill("dodge", 40);
  set("attitude", "friendly");
  set("chat_chance_combat", 50);

  set("inquiry", ([
    "扫地": (: ask_shaodi :),
  ]));
  setup();
  carry_object("/d/xueshan/obj/shaoba")->wield();
}
string ask_shaodi() {
  object me = this_player();
  object shaoba = present("broom", this_object());

  if ((string)me->query("family/family_name") != "大雪山")
    return ("您不是本门中人。");
  if (me->query("faith") > 1000)
    return ("您是本门大有名望之人，怎敢有劳您做这种杂务呢？");
  if (!shaoba) return ("已经有人去扫地了。");

  me->set("xueshan/shaodi", 1);
  shaoba->move(me);
  return ("这样，就有劳您去把院子扫扫(sao di)了。");
}
