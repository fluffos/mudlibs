#include <weapon.h>

inherit STICK;

void create() {
  set_name("铲刀", ({ "tool" }));
  set("long", "你可以用造来早冰刀。\n");
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 50);
    set("material", "wood");
    set("wield_msg", "$N把$n握在手中．\n");
  }
  init_stick(10);
  setup();
}

void init() {
  add_action("do_make", "make");
}

int do_make(string arg) {
  object me = this_player();
  string env;

  if (!me->query("xueshan/make"))
    return notify_fail("您来造冰刀，这怎么敢当呢？\n");
  if (me->is_busy())
    return notify_fail("你现在正忙，还是专心点叭。\n");
  if (!arg && arg != "icedao")
    return notify_fail("你要造什么？\n");
  if (me->query("faith") > 300 || me->query("combat_exp") > 100000)
    return notify_fail("你还是去找点别的活干吧。\n");
  if ((int)me->query("kee") < 80)
    return notify_fail("你太累了，歇歇吧！\n");

  message_vision("$N选了一块冰比较多的地方 ，然后用铲刀挖了一些冰，再把这些冰做成刀\n", me);
  me->start_busy(8);
  call_out("dig1", 2, me);
  call_out("finish_dig", 8, me);

  return 1;
}

void dig1(object me) {
  message_vision("$N擦了擦头上的汗水，继续干了起来。\n", me);
}
void finish_dig(object me) {

  message_vision("$N这时才发现自己身后已经堆满了冰刀。n", me);
  me->receive_damage("kee", 20);
  me->delete("xueshan/make");
  tell_object(me, "你觉得在劳累之余也有所收获。\n");
  tell_object(me, "你的经验和基本刀法提高了。\n");
  me->improve_skill("blade", random(me->query("int")), 1);
  me->add("faith", 1);
  me->add("combat_exp", 9);
  me->add("potential", 3);
  me->add("kee", -60);
}
