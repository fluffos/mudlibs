inherit ROOM;

void create() {
  set("short", "玉阶");
  set("long", @LONG

由此向上是龙宫正殿，东海龙王就住在里面。一级级的台阶都是用　　　
玉砌成，阶上两边立着武士，银盔银甲，煞是威风。
LONG);
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/zhangmen.lpc": 1,
  ]));

  set("exits", ([ /* sizeof() ==4 */
    "west": __DIR__ "gate.lpc",
    "northeast": __DIR__ "boy1.lpc",
    "southeast": __DIR__ "girl1.lpc",
