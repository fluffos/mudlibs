// hill.c

inherit ROOM;

void create ()
{
  set ("short", "明察堂");
  set ("long", @LONG

明察堂是东海龙宫中大将军鲸无敌的办公场所，檀木桌上叉着令旗　　　
和令箭。平常的虾兵蟹将是不敢来这里的，出入的人也小心翼翼，　　　
不敢大声出气，周围一派肃穆的气氛。到了一定时间，这就成了
龙宫弟子们操练(caolian)的地方！

LONG);

  set("exits", ([ /* sizeof() == 2 */
  "south" : __DIR__"yujie2.lpc",
  "north" : __DIR__"jingxing.lpc",
]));
  set("objects", ([ /* sizeof() == 1 */
  __DIR__"npc/jing" : 1,
]));
        setup();
}


void init()
{
   add_action("do_caolian","caolian");
}
int do_caolian()
{
   object me=this_player();
   if(me->is_busy())
      return notify_fail("你正忙着呢。\n");
   if((string)me->query("family/family_name")!="东海龙宫")
      return notify_fail("你不是我们东海龙宫的，不用来这操练。\n");
   if(time()-me->query("last_caolian")<600)
       return notify_fail("你不是刚刚练习过吗?\n");
   if(me->query("faith")>400||me->query("combat_exp")>50000)
      return notify_fail("你已经不需要在这种地方习武了.\n");
   tell_object(me,"你运气丹田，便生龙活虎的在场地上耍了起来.\n");
   me->start_busy(5);
      me->add("faith",2);
   me->add("combat_exp",45+random(me->query("str")));
 me->add("potential",10+random(me->query("str")));
me->improve_skill("unarmed",1);
   me->receive_damage("kee",40);
   me->receive_damage("sen",40);
message_vision("$N觉得扑击格斗之术进步了!\n",me);
   return 1;
}
