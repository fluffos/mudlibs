// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */
 
inherit NPC;
string ask_armor();

void create()
{
       set_name("贝嫂", ({"beisao"}));

set("long","一位中年妇女，是龙女的贴身仆人．\n");
       set("gender", "女性");
       set("age", 36);
   set("per", 20);
       set("attitude", "peaceful");
       set("shen_type", 1);
   set_skill("unarmed", 60);
   set_skill("dodge", 80);
   set_skill("parry", 60);
        set("combat_exp", 36000);
         set("nkgain",90);
        setup();
        add_money("silver", 1);
      set("inquiry", ([
          "编藤甲" : (: ask_armor :),
      ]));

}

string ask_armor()
{
  object me=this_player();
  if(me->query("class")!="dragon")
     return ("您不是龙宫中人！");
  if(me->query("faith")>200||me->query("combat_exp")>50000)
     return ("怎敢劳动您来编藤甲呢？");
  if(me->is_busy())
     return ("你还忙着呢。");
  command("smile");
  command("say 我正愁人手不够，你快来帮忙吧！");
  message_vision("$N走到贝嫂跟前，打起了下手。\n",me);
  me->start_busy(5);
  call_out("finish_armor",5,me);
  return ("谢谢你了！");
}
void finish_armor(object me)
{
  message_vision("在$N的帮助下，贝嫂终于将藤甲编好了。\n",me);
  message_vision("$N站了起来，擦了擦头上的汗。\n",me);
  tell_object(me,"你在劳累之余，觉得对扑击格斗之技有了领悟。\n");
  me->add("faith",1);
  me->add("combat_exp",9);
  me->add("potential",3);
  me->improve_skill("unarmed",random(me->query("str")),1);
  me->add("kee",-40);
}
