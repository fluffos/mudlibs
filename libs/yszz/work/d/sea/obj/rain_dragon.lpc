//rain_dragon.c
inherit ITEM;
string *str = ({ "你举起手中玉龙，立刻乌云滚滚。\n",
  "你再挥玉龙，天空电闪雷鸣！\n",
  "你三次挥动玉龙，大雨滂沱而下。\n",
  "你收回玉龙，立刻雨歇云散。\n" });


void create() {
  set_name("玉龙", ({ "rain dragon" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("no_sell", 1);
    set("no_give", 1);
    set("no_put", 1);
    set("no_get", 1);
    set("unit", "个");

    set("long", "一条白玉雕成的龙，可以用来(apply)行云降雨。\n");
  }
  setup();
}
void init() {
  add_action("do_apply", "apply");
}

int do_apply() {
  object me = this_player();
  if ((string)me->query("family/family_name") != "东海龙宫")
    return notify_fail("你非龙族，无法行云布雨！\n");
  if (!me->query("sea/rain"))
    return notify_fail("龙王并没有让你来行雨。\n");

  tell_room(environment(me), me->query("name") + "开始施法降雨。\n");
  me->set("last_rain", time());
  me->set_temp("in_guard", 1);
  me->save();
  remove_call_out("end_rain");
  call_out("end_rain", 70, me, this_object());
  call_out("clone_meng", 10, me, 0);
  return 1;
}

void clone_meng(object me, int i) {
  object ob;

  if (i < 3) tell_room(environment(me), str[i]);
  tell_room(environment(me), "不知从什么地方突然冲上来一伙妖怪。\n");
  tell_room(environment(me), "看起来他们要抢玉龙。\n");
  switch (random(3)) {
    case 0:
      ob = new("/d/nanhai/npc/yao1.lpc");
      break;
    case 1:
      ob = new("/d/nanhai/npc/yao2.lpc");
      break;
    case 2:
      ob = new("/d/nanhai/npc/yao3.lpc");
      break;
  }
  ob->set("combat_exp", me->query("combat_exp"));
  ob->move(environment(me));
  i++;
  call_out("clone_meng", 30, me, i);
}

void end_rain(object me, object dragon) {
  object ob, cloud;
  int reward = me->query("combat_exp") / 5000;

  tell_room(environment(me), str[3]);
  me->add("faith", 2 + random(2));
  me->add("combat_exp", 100 + random(reward));
  me->add("potential", 30 + random(reward / 4));
  me->delete_temp("in_guard");
  me->save();
  remove_call_out("clone_meng");
  tell_room(environment(me), me->query("name") + "降雨任务完成。\n");
  tell_object(me, "你降雨任务完成，你的经验增加了！\n");
  while (ob = present("dahan", environment(me)))
    destruct(ob);
  if (!(cloud = find_object("/d/sea/inside3")))
    cloud = load_object("/d/sea/inside3");
  if (objectp(cloud))
    me->move("/d/sea/inside3");
  destruct(this_object());
}
