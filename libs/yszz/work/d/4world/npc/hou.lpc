// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

// liuerhou.c
//

inherit NPC;

void create() {
  set_name("六耳猕猴", ({ "liuer mihou", "miuhou", "mi hou", "hou", "monkey" }));
  set("gender", "男性");
  set("age", 20);
  set("long", "
  六耳灵猴本来居住在雪山，不知为何他会在这里出现。六耳猕猴冷酷无情，
  不过要是投其所好,你让他把自己老子杀了都行！！。\n");
  set("combat_exp", 5000000);
  set("attitude", "heroism");
  set_skill("unarmed", 200);
  set_skill("dodge", 200);
  set_skill("stick", 200);
  set_skill("qianjun-bang", 200);
  set_skill("dengxian-dafa", 200);
  set_skill("lengquan-force", 200);
  set_skill("force", 200);
  set_skill("spells", 200);
  set_skill("xiaoyaoyou", 200);
  set_skill("moyun-shou", 200);
  set_skill("parry", 200);
  set("per", 40);
  set("max_kee", 3500);
  set("max_gin", 3000);
  set("max_sen", 3000);
  map_skill("parry", "qianjun-bang");
  map_skill("dodge", "xiaoyaoyou");
  map_skill("unarmed", "moyun-shou");
  map_skill("stick", "qianjun-bang");
  map_skill("spells", "dengxian-dafa");
  map_skill("force", "lengquan-force");

  setup();
  carry_object("/d/obj/armor/jinjia")->wear();
  carry_object("/d/obj/weapon/stick/xiangmo")->wield();
}

void init() {
  object ob;

  ::init();
  set("chat_chance", 7);
  set("inquiry", ([
    "name": "我就是六耳灵猴，怎么着？？ ",
    "here": "这里就是那个什么孙行者的花果山，哼！！",
    "rumors": " 不知道那个家伙跑到什么地方去了，如果让我遇上。。。。。",
    "孙悟空": "就他那种道行也配称战斗胜佛？？我就是来找他麻烦的！！",
  ]));

}
int accept_object(object me, object ob) {
  object book, npc = this_object();

  if ((string)ob->query("id") != "renshen guo") {
    command("say 这是什么东西，我才不稀罕！！");
    return 0;
  } else {
    if (query_temp("received_guo") == 1) {
      command("thank " + me->query("id"));
      command("say 不必了，刚才已经有个家伙献了一个人参果给本仙了。");
      command("say 嘿嘿，我已经不需要这个东西了。");
      add_temp("received_guo", 1);
      return 0;
    } else {
      if (query_temp("received_guo") < 1 || !query_temp("received_guo")) {
        command("haha " + me->query("id"));
        command("say 这位" + RANK_D->query_respect(me) + "真是很识抬举！！不错不错！！");
        command("say 那这本书就给了你了！！");
        book = new("/d/obj/book/forcebook2");
        message_vision("六耳猕猴给$N一本「猕猴心得」。\n");
        book->move(me);
        command("say 本仙就是喜欢那些识抬举的人！");
        command("hehe");
        add_temp("received_litou", 1);
        return 1;
      }
      command("say 少来这一套，本仙不稀罕！！");
      return 0;
    }
  }
}
