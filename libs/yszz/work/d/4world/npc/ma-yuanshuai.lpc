// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */
 
// ma-yuanshuai.c

void upgrade_title(object me,string arg);
string clear_title(string arg);
string expell_me(object me);
int ask_me();
inherit NPC;
inherit F_MASTER;
void create()
{
        set_name("马元帅", ({"ma yuanshuai","ma","yuanshuai","hou","mahou"}));
        set("gender", "男性" );
        set("age", 50);
        set("long", "一只身强体壮的大马猴。\n");
        set("combat_exp", 500000);
        set("attitude", "peaceful");
        set("str",40);
        set_skill("unarmed", 80);
        set_skill("dodge", 110);
        set_skill("spells",80);
        set_skill("parry", 80);
        set_skill("literate",10);
        set_skill("force", 100);
        set_skill("jindouyun",80);
        set_skill("mihou-force",80);
        set_skill("stick",100);
        set_skill("qitian-gun",90);
        map_skill("stick","qitian-gun");
        set_skill("mihouxinjing",80);
        set_skill("houquan",80);
        map_skill("unarmed","houquan");
        map_skill("force","mihou-force");
        map_skill("dodge","jindouyun");
        map_skill("spells","mihouxinjing");   
        set("per", 10);
        set("max_kee", 600);
        set("max_gin", 800);
        set("max_sen", 800);
        set("max_force", 900);
        set("force",900);
        set("max_mana",900);
        set("mana",900);
        set("force_factor", 20);
        set("inquiry", ([
                "指点武功" : (: ask_me :),
                "leave" : (: expell_me :),
                "叛师" : (: expell_me :)
        ]));

        setup();
     create_family("水帘洞",3,"护法元帅");

}
void init()
{
        add_action("do_yuanyi","yuanyi");
}
void attempt_apprentice(object ob)
{

    command("say 很好，很好。");
    command("recruit " + ob->query("id"));
}

string expell_me(object me)
{
     me=this_player();
   if(me->query("family/family_name") == "水帘洞" )
  {
        command("say 看来你并非猴类，我也不勉强你留下。");
   me->set_temp("betray",1);
        return ("不过你要受到一定的处罚，你可愿意(yuanyi)？");
   }
   return ("我不知情！\n");
}

int do_yuanyi(string arg)
{
   if(this_player()->query_temp("betray")) {
     message_vision("$N答道：弟子愿意。\n\n", this_player());
     command("say 既然你非猴类，还是快些走巴！");
     this_player()->add("betray/count", 1);
     this_player()->set("betray/shuilian",1);
     this_player()->set("combat_exp", this_player()->query("combat_exp")*95/100)
;
     this_player()->delete("family");
      this_player()->set("faith",0);
     this_player()->delete("class");
     this_player()->set("title", "普通百姓");
     this_player()->set_temp("betray", 0);
     this_player()->save();
     command("say 江湖风波，善恶无形，好自为之。。。\n");
     return 1;
}
}
