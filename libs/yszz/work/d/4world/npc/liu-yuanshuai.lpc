// ma-yuanshuai.c

void upgrade_title(object me,string arg);
string clear_title(string arg);
int ask_me();
inherit NPC;
string expell_me(object me);
inherit F_MASTER;
void create()
{
        set_name("流元帅", ({"liu yuanshuai","liu","yuanshuai","hou","mahou"}));
        set("gender", "男性" );
        set("age", 50);
        set("long", "一只身强体壮的大马猴。\n");
        set("combat_exp", 500000);
        set("attitude", "peaceful");
        set("str",40);
        set_skill("unarmed", 80);
        set_skill("dodge", 110);
        set_skill("spells",80);
        set_skill("parry", 80);
        set_skill("literate",10);
        set_skill("force", 100);
        set_skill("stick",100);
        set_skill("qitian-gun",90);
        map_skill("stick","qitian-gun");
        set_skill("jindouyun",80);
        set_skill("mihou-force",80);
        set_skill("mihouxinjing",80);
        set_skill("houquan",80);
        map_skill("unarmed","houquan");
        map_skill("force","mihou-force");

        map_skill("dodge","jindouyun");
        map_skill("spells","mihouxinjing");   
        set("per", 10);
        set("max_kee", 600);
        set("max_gin", 800);
        set("max_sen", 800);
        set("max_force", 900);
        set("force",900);
        set("max_mana",900);
        set("mana",900);
        set("force_factor", 20);
        set("inquiry", ([
                "指点武功" : (: ask_me :),
                "叛师": (: expell_me :)
        ]));

        setup();
     create_family("水帘洞",3,"护法元帅");

}

void attempt_apprentice(object ob)
{

    command("say 很好，很好。");
    command("recruit " + ob->query("id"));
}
