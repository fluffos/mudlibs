//话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

#include <ansi.h>
string ask_mieyao();
string ask_cancel();
inherit NPC;
inherit F_MASTER;
void create() {
  set_name("六耳猕猴", ({ "liuer mihou", "mihou" }));
  set("gender", "男性");
  set("nickname", "[1;33m齐天大圣[m");
  set("age", 20);
  set("long", "
  六耳灵猴本来居住在雪山，不知为何他会在这里出现。六耳猕猴冷酷无情，
  不过要是投其所好,你让他把自己老子杀了都行！！。\n");
  set("combat_exp", 5000000);
  set("max_mana", 5000);
  set("max_force", 5000);
  set("force", 5000);
  set("mana", 5000);
  set("mana_factor", 200);
  set("force_factor", 200);
  set("attitude", "heroism");
  set_skill("unarmed", 190);
  set_skill("dodge", 160);
  set_skill("stick", 180);
  set_skill("qitian-gun", 180);
  set_skill("mihouxinjing", 200);
  set_skill("mihou-force", 180);
  set_skill("force", 180);
  set_skill("spells", 200);
  set_skill("jindouyun", 160);
  set_skill("houquan", 190);
  set_skill("parry", 160);
  set("per", 40);
  set("max_kee", 3500);
  set("max_gin", 3000);
  set("max_sen", 3000);
  map_skill("parry", "qitian-gun");
  map_skill("dodge", "jindouyun");
  map_skill("unarmed", "houquan");
  map_skill("stick", "qitian-gun");
  map_skill("spells", "mihouxinjing");
  map_skill("force", "mihou-force");
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "stick.wu" :)
  }));
  create_family("水帘洞", 2, "洞主");
  setup();
  carry_object("/d/obj/armor/jinjia")->wear();
  carry_object("/d/obj/weapon/stick/xiangmo")->wield();
}

int recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("class", "houyao");
}

void init() {
  object ob;
  ::init();
  set("chat_chance", 7);
  set("inquiry", ([
    "name": "我就是六耳灵猴，怎么着？？ ",
    "here": "这里就是那个什么孙行者的花果山，哼！！",
    "rumors": " 不知道那个家伙跑到什么地方去了，如果让我遇上。。。。。",
    "孙悟空": "就他那种道行也配称战斗胜佛？？我就是来找他麻烦的！！",
    "斗佛": (: ask_mieyao :),
    "cancel": (: ask_cancel :),
  ]));
}
string ask_cancel() {
  object me = this_player();
  if ("/d/obj/mieyao"->delete_mieyao(me))
    me->add("faith", -5);
  return ("没用的东西！");
}

string ask_mieyao() {
  object me = this_player();

  if (me->query("family/family_name") != "水帘洞")
    return ("你不是本门中人!");
  if (me->query("faith") < 100)
    return "你还是先修炼一下吧.\n";
  command("pat " + me->query("id"));
  write(WHT + "/d/obj/mieyao"->query_yao(me) + NOR);
  return "有志气！\n";
}

void attempt_apprentice(object ob) {

  if ((int)ob->query_skill("mihouxinjing", 1) < 80) {
    command("say 你的法术太低了,还是努努力先提高一下吧!");
    command("slap " + ob->query("id"));
    return;
  }

  if ((int)ob->query_skill("mihou-force", 1) < 80) {
    command("say 你的本门内功心法太低了,还是努努力先提高一下吧!");
    command("kick2 " + ob->query("id"));
    return;
  }

  command("say 很好，很好。");
  command("recruit " + ob->query("id"));
}
