// jiading.c

inherit NPC;

void create()
{
       set_name("护殿天兵", ({"bing"}));

set("long","一个身批金甲,手执大锤的天兵。\n正狠巴巴的瞪着你．\n");
       set("gender", "男性");
       set("age", 25+random(15));
       set("attitude", "aggressive");
        set("max_gin", 1500);
        set("gin",1500);
        set("max_kee", 1500);
        set("max_sen", 1500);
        set("force",   1100);
        set("max_force", 1100);
        set("force_factor", 55);
       set("mana",  1500);
       set("max_mana",1500);
       set("mana_factor",60);
       set("combat_exp", 1200000);
       set_skill("hammer", 140+random(25));
       set_skill("parry", 140+random(30));
       set_skill("dodge", 140+random(30));
       set_skill("yanxing-steps",140+random(30));
       set_skill("huntian-hammer",140+random(30));
       set_skill("spells",100);
       set_skill("force",150);
       set_skill("lengquan-force",150);
       set_skill("jinghun-zhang",120);
       set_skill("unarmed",120);
       set_skill("moonshentong",100);
       map_skill("spells", "moonshentong");
       map_skill("unarmed", "jinghun-zhang");
       map_skill("force", "moonforce");
       map_skill("hammer", "huntian-hammer");
       map_skill("parry", "huntian-hammer");
       map_skill("dodge", "yanxing-steps");
       set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
                (: cast_spell, "mihun" :)
        }) );
       
        exert_function("jingxin");
        setup();
        add_money("gold", 5);
        carry_object("/d/obj/weapon/hammer/bahammer")->wield();
        carry_object("/d/obj/armor/jinjia")->wear();
}

