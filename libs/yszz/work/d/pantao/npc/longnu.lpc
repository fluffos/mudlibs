#include <ansi.h>

inherit NPC;

void create()
{
  set_name("南海龙女",({ "long nu", "long" }) );
      set_weight(1000000);
  set("gender", "女性" );
  set("title",HIW"雪灵公主"NOR);
  set("long", "南海龙王的独生女儿,也是西王母的侄女.从小信仰佛教,因而深得观音的喜爱.\n");
  set("age", 18);
  set("attitude", "aggressive");
  set("str", 50);
  set("per", 50);
  set("combat_exp",1500000);
  set("force",3000);
  set("max_force",2000);
  set("force_factor", 100);
  set("max_gin", 4000);
  set("max_kee", 4000);
  set("max_sen", 4000);
  set("max_mana", 2000);
  set("mana", 4000);
  set("mana_factor", 150);
  set_skill("unarmed",150);
  set_skill("dodge",200);
  set_skill("parry",150);
  set_skill("spells",180);
  set_skill("sword",170);
  set_skill("force",150);
  set_skill("jienan-zhi",180);
  set_skill("lotusmove",160);
  set_skill("snowsword",160);
  set_skill("buddhism",180);
  set_skill("lotusforce",160);
  map_skill("unarmed","jienan-zhi");
  map_skill("sword","snowsword");
  map_skill("force","lotusforce");
  map_skill("dodge","lotusmove");
  map_skill("spells","buddhism");
  set("chat_chance_combat",80);
  set("chat_msg_combat",({
  (: cast_spell,"bighammer" :),
}));

  setup();
  carry_object("/d/obj/cloth/xianyi")->wear();
  carry_object("/d/obj/weapon/sword/qinghong")->wield();
}
