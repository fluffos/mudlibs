#include <ansi.h>

inherit NPC;

void create() {
  set_name("九天玄女", ({ "xuan nu", "xuan" }));
  set_weight(1000000);
  set("gender", "女性");
  set("title", HIC "流光飞舞仙子" NOR);
  set("long", "相传她是元始天尊的妹子,极擅道家仙术.\n");
  set("age", 18);
  set("attitude", "aggressive");
  set("str", 50);
  set("per", 50);
  set("combat_exp", 2000000);
  set("force", 3000);
  set("max_force", 2000);
  set("force_factor", 100);
  set("max_gin", 4000);
  set("max_kee", 4000);
  set("max_sen", 4000);
  set("max_mana", 2500);
  set("mana", 5000);
  set("mana_factor", 150);
  set_skill("unarmed", 150);
  set_skill("dodge", 200);
  set_skill("parry", 150);
  set_skill("spells", 200);
  set_skill("sword", 170);
  set_skill("force", 150);
  set_skill("puti-zhi", 180);
  set_skill("wuxiangforce", 160);
  set_skill("sanqing-jian", 200);
  set_skill("dao", 200);
  set_skill("moondance", 180);
  map_skill("unarmed", "puti-zhi");
  map_skill("sword", "sanqing-jian");
  map_skill("force", "wuxiangforce");
  map_skill("dodge", "moondance");
  map_skill("spells", "dao");
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: cast_spell, "light" :),
    (: cast_spell, "thunder" :),
  }));

  setup();
  carry_object("/d/obj/cloth/xianyi")->wear();
  carry_object("/d/obj/weapon/sword/qinghong")->wield();
}
void unconcious() {
  die();
}
void die() {
  tell_room(environment(), name() + HIC "化作一条丝带直飞九天！\n" NOR);
  call_out("des", 1);
}
void des() {
  destruct(this_object());
}
