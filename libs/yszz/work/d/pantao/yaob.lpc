// room: /d/pantao/yaob.c

inherit ROOM;

#define FILE __DIR__"npc/taibai"

void create() {
  set("short", "[33m瑶池[m");
  set("long", @LONG

                       ◇瑶池◇

琼香缭绕，瑞霭缤纷，瑶台铺彩结，宝阁散氤氲。凤翥鸾腾形
缥缈，金花玉萼影浮沉。五彩描金桌，千花碧玉盆。桌上有龙
肝凤髓，熊掌猩唇。珍馐百味般般美，异果嘉肴色色新。

LONG);

  set("exits", ([
    "south": __DIR__ "palace1",
    "west": __DIR__ "yaoa",
    "east": __DIR__ "yaoc",
    "north": __DIR__ "gate",
  ]));

  set("objects", ([
    "/u/fly/doublesword/npc/laojun": 1,
    __DIR__ "obj/luzi": 1,
  ]));
  set("no_fight", 1);
  set("no_clean_up", 1);
  set("no_magic", 1);
  setup();
}

void init() {
  if (sizeof(filter_array(children(FILE), (: clonep :))) < 1)
    new(FILE)->move(this_object());
  add_action("do_jump", "jump");
}

int do_jump(string arg) {
  object ob = this_player();
  object me = this_object();
  object luzi = load_object(__DIR__ "luzi");
  object *inv = all_inventory(luzi);
  object *inv2 = all_inventory(ob);
  int i, x;

  if (!arg || arg != "bagua lu")
    return notify_fail("你要向哪跳？\n");

  for (i = 0; i < sizeof(inv); i++) {
    if (interactive(inv[i])) {
      tell_object(ob, "你纵身一跃，谁知道炉子里面还有一人！你大喊一声不好，顿时摔了个狗啃屎！\n");
      ob->set("kee", 10);
      return 1;
    }
  }
  for (x = 0; x < sizeof(inv2); x++) {
    if (interactive(inv2[x])) {
      tell_object(ob, "你感觉身上什么东西压你的难受！\n");
      return 1;
    }
  }

  tell_room(environment(ob), "只见" + ob->name() + "纵身一跃，跳进了八卦炉！\n");
  ob->set_temp("bgl_enter_time", time());
  ob->move(__DIR__ "luzi");
  return 1;
}
