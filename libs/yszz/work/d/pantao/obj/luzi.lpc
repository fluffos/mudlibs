// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

#include <weapon.h>
#include <ansi.h>
inherit HAMMER;

void create() {
  set_name(HIR "八卦炉" NOR, ({ "bagua lu", "luzi" }));
  set_weight(500);
  set_max_encumbrance(20000);
  set_max_items(20);
  if (clonep()) {
    object ash;
    seteuid(getuid());
    if (ash = new("/u/city/obj/ash"))
      ash->move(this_object());
    set_default_object(__FILE__);
  } else {
    set("unit", "只");
    set("value", 2000);
    set("no_get", 1);
  }
  init_hammer(1);
}
