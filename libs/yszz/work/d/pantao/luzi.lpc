// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */


inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "八卦炉中");
  set("long", @LONG

        [1;31m 火     火       火[m
LONG);
  setup();
}

void init() {
  object ob = this_player();
  remove_call_out("infire");
  call_out("infire", 600, ob);

  add_action("do_out", "out");
  add_action("do_none", "cast");
}


int do_none() {
  object ob = this_player();
  tell_object(ob, HIR "你刚想施展法力，周围的炉火就湮没了你！\n" NOR);
  ob->set("sen", 10);
  tell_object(ob, HIR "你觉得好象有点神志不清！\n" NOR);
  return 1;
}

int do_out() {
  object ob = this_player();
  if (time() - ob->query_temp("bgl_enter_time") < 60 * 60 * 12) {
    remove_call_out("infire");
    ob->delete_temp("bgl_enter_time");
    ob->move("/d/pantao/yaob");
    tell_room(environment(ob), HIR "只见" + ob->name() + "灰头灰脸地从八卦炉里面爬了出来。\n" NOR);
    return 1;
  }
  ob->delete_temp("bgl_enter_time");
  ob->move("/d/pantao/yaob");
  remove_call_out("infire");
  tell_room(environment(ob), HIR "只见" + ob->name() + "双眼烁烁放光，正是炼成了千里眼！\n");
  ob->set("bigeye", 1);
  return 1;
}

int infire(object ob) {

  tell_object(ob, HIR "火烧在你身上，你感觉到浑身无比疼痛！\n" NOR);

  if (!ob)
    return 1;
  ob->add("kee", -50);

  if (random(20) <= 7) {
    tell_object(ob, "忽然你看到八卦炉的炉顶被人掀开！\n");
    message(
      "chat",
      HIC "【闲聊】太上老君(taishang laojun)：" + ob->name() + "你躲在我的八卦炉内做甚？快给我出来！\n" NOR,
      users()
    );
    tell_object(ob, "只见一个大手把你从炉子里面抓了出去。\n");
    ob->move("/d/pantao/yaob");
    return 1;
  }

  call_out("infire", 60 * 60, ob);
}
