// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */
#include <weapon.h>
inherit SWORD;
void create() {
  set_name("木梳", ({ "bb" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 50);
    set("material", "wood");
    set("wield_msg", "$N把$n握在手中．\n");
  }
  init_sword(10);
  setup();
}
void init() {
  add_action("do_daban", "daban");
}
int do_daban(string arg) {
  object me = this_player();
  string env;
  if (me->query("family/family_name") != "月宫")
    return notify_fail(me->name() + "拿起梳子在头上梳了几下.\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");
  if (!me->query("moon/beauty"))
    return notify_fail("您没东西怎么梳洗打扮呢?\n");
  if (!arg && arg != "me")
    return notify_fail("你想给谁梳洗打扮?\n");
  env = environment(me)->query("short");
  if (env != "休息室" && env != "卧房" && env != "练功房")
    return notify_fail("大庭广众的,你也好意思梳洗打扮??!\n");
  if (environment(me)->query("water"))
    return notify_fail("梳洗用的水用完了,你等佣人送水来巴\n");
  if ((int)me->query("kee") < 80)
    return notify_fail("你太累了，歇歇吧！\n");
  message_vision("$N轻轻的掬起一些水,拿起木梳,静静的梳洗着。\n", me);
  write("啊,美女出现了。\n");
  call_out("finish_daban", 5, me);
  me->start_busy(5);
  return 1;
}
void finish_daban(object ob) {
  object where = environment(ob);
  message_vision("$N放下木梳,只见木梳随水而化。\n", ob);
  ob->add("kee", -60);
  // where->set("water",1);
  ob->delete("moon/beauty");
  tell_object(ob, "你觉得在梳洗打扮之余也有所体会。\n");
  tell_object(ob, "你的经验和圆月心法提高了。\n");
  ob->improve_skill("moonforce", random(ob->query("int")), 1);
  ob->add("faith", 1);
  ob->add("combat_exp", 8);
  ob->add("potential", 3);
  if (find_living("magu")) {
    this_object()->move(find_living("magu"));
    return;
  }
  destruct(this_object());
}
