// wugang.c

inherit NPC;
#include <ansi.h>

void create() {
  set_name(HIW "吴刚" NOR, ({ "wu gang", "wugang", "wu", "gang" }));
  set("gender", "男性");
  set("age", 35);
  set("long", "一个气宇不凡的大汉．");
  set("combat_exp", 100000);
  set("attitude", "peaceful");

  set("eff_dx", 40000);
  set("nkgain", 200);

  set_skill("unarmed", 50);
  set_skill("dodge", 50);
  set_skill("parry", 80);
  set_skill("literate", 50);
  set_skill("force", 50);
  set_skill("axe", 100);
  set("per", 27);
  set("max_kee", 500);
  set("max_gin", 200);
  set("max_sen", 300);
  set("force", 450);
  set("max_force", 300);
  set("force_factor", 15);
  setup();
  carry_object("/d/ourhome/obj/linen")->wear();
  carry_object("/d/moon/obj/bigaxe")->wield();
}

int accept_fight(object me) {
  command("jump");
  command("say 正好！我砍了半天树，也该换换了。");
  return 1;
}
void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()
    && !ob->query("env/invisibility")) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_volunteer", "volunteer");
}

void greeting(object ob) {
  if (!ob || !present(ob, environment(this_object()))) return;
  say("吴刚轻轻的说:这位" + RANK_D->query_respect(ob) + ",欢迎来到月宫!\n");
  say("吴刚说道:凡月宫弟子可以在此守护(volunteer)本门. \n");
}

int do_volunteer() {
  object me = this_player();
  object *ob;
  int i;
  if ((string)me->query("family/family_name") != "月宫")
    return notify_fail("您不是本门中人。\n");
  if (me->query("faith") > 500)
    return notify_fail("您是本门大有名望之人，怎敢有劳您做看门这样的杂务呢？
");
  if (me->query_temp("in_guard"))
    return notify_fail("吴刚对你说:你专心守好山门，别想打两份工。\n");
  if (time() - me->query("last_guard") < 300)
    return notify_fail("吴刚对你说:怎么这么快又来了?歇歇去吧!\n");
  ob = users();
  for (i = sizeof(ob); i > 0; i--) {
    if (ob[i - 1]->query_temp("in_guard"))
      return notify_fail("吴刚对你说：已经有人守山门了，你一会再来吧
。\n");
  }
  tell_object(me, "那好，就请你守一会儿山门吧。\n");
  tell_room(environment(me), me->query("name") + "开始在山门值守。\n");
  me->set("last_guard", time());
  me->set_temp("in_guard", "1");
  me->save();
  remove_call_out("end_guard");
  call_out("end_guard", 70, me);
  call_out("clone_meng", 20, me);
  return 1;
}

void clone_meng(object me) {
  object ob;
  if (!present(me, environment())) return;
  tell_room(environment(me), "山下突然冲上来一伙妖怪。\n");
  ob = new("/d/lingtai/npc/mengmian");
  ob->set("combat_exp", me->query("combat_exp"));
  ob->move("/d/moon/ontop2");
  call_out("clone_meng", 20, me);
}

void end_guard(object me) {
  object ob;
  int reward;

  if (!present(me, environment(me))) return;

  reward = me->query("combat_exp") / 5000;
  me->delete("guard");
  me->add("faith", 2 + random(4));
  me->add("combat_exp", 100 + random(reward));
  me->add("potential", 30 + random(reward / 4));
  me->delete_temp("in_guard");
  me->save();
  remove_call_out("clone_meng");
  tell_room(environment(me), me->query("name") + "在山门值守期已满。\n");
  tell_object(me, "你在山门值守期已满。\n");
  while (ob = present("dahan", environment(me)))
    destruct(ob);
}
