// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

// Room: /changan/southseashore.c

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "[0;33m南海之滨[m");
  set("long", @LONG

南海之滨。往北是一条宽阔笔直的官道，足可容得下十马并驰。
向东好象是一个小城。
LONG);

  set("exits", ([ /* sizeof() == 2 */
    "north": __DIR__ "broadway5",
    "east": "/d/jz/sibei-w3",
  ]));
  set("outdoors", 1);

  setup();
}

void init() {
  add_action("do_swim", "swim");
  add_action("do_jump", "jump");
  add_action("do_cry", "yell");
}

int do_swim() {
  object me = this_player();

  if (me->query_temp("ridee"))
    me->query_temp("ridee")->set_temp("rider", 0);
  me->set_temp("ridee", 0);
  me->add_temp("apply/dodge", -me->query_temp("ride/dodge"));
  me->set_temp("ride/dodge", 0);

  message_vision(HIY "$N纵身一跃，跳入海中。只见$N使足了全身力气，手足并用，不一会儿就游到了海中小岛上。\n" NOR, me);
  me->move("/d/nanhai/island");
  message_vision(HIY "只见$N浑身湿漉漉地从海里爬了上来。\n" NOR, me);
  me->receive_damage("kee", 20);
  me->receive_damage("sen", 20);
  return 1;
}

int do_jump(string arg) {
  object me = this_player();
  if (!arg || arg != "river")
    return notify_fail("你要往哪跳？\n");
  me->move("/d/jz/river");
  message_vision(HIC "$N纵身一跳，跳进江中。\n" NOR, me);
  me->add("kee", -40);
  return 1;
}

int do_cry() {
  object me = this_player();
  object dragon;

  if (me->query("obstacle/jz") == "done")
    return notify_fail("你干嚎了两嗓子，眼泪也流不出来。\n");

  if (!me->query_temp("obstacle/jz_given"))
    return notify_fail("你干嚎了两嗓子，眼泪也流不出来。\n");

  if (present("long wang", environment(me)))
    return notify_fail("龙王不是在这吗？\n");

  if (random(20) == 6) {
    dragon = new("/d/jz/npc/longwang");
    dragon->move(environment(me));
    message_vision(HIG "只见$N号啕大哭起来，真是如丧考妣。\n" NOR, me);
    tell_room(environment(me), "忽然龙王飘然而至....\n");
    me->delete_temp("obstacle/jz_given");
    return 1;
  }
  message_vision(HIG "只见$N号啕大哭起来，但是根本没有在乎$N。\n" NOR, me);
  return 1;
}
