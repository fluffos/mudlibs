inherit NPC;
void create() {
  set_name("李彪", ({ "li biao", "libiao" }));
  set("gender", "男性");
  set("age", 38);
  set("title", "江州知爷");
  set("long", "一个身强力壮的男人，怎么看也不象知爷。");
  set("attitude", "friendly");
  set("per", 10);
  set("str", 40);
  set("combat_exp", 50000);
  set("max_force", 1000);
  set("force", 1000);
  set("force_factor", 40);
  set("max_kee", 300);
  set("max_sen", 300);
  set_skill("unarmed", 80);
  set_skill("parry", 80);
  set_skill("dodge", 70);
  set_skill("houquan", 80);
  map_skill("unarmed", "houqaun");
  map_skill("parry", "houquan");

  setup();
}
