inherit NPC;
void create() {
  set_name("刘洪", ({ "liu hong", "liuhong" }));
  set("gender", "男性");
  set("age", 38);
  set("title", "江州知府");
  set("long", "一个看起来让人很不舒服的知府。");
  set("per", 10);
  set("str", 40);
  set("combat_exp", 50000);
  set("max_force", 1000);
  set("force", 1000);
  set("force_factor", 40);
  set("max_kee", 300);
  set("max_sen", 300);
  set_skill("unarmed", 80);
  set_skill("parry", 80);
  set_skill("fumo-jian", 80);
  set_skill("dodge", 100);
  set_skill("houquan", 100);
  map_skill("unarmed", "houqaun");
  map_skill("parry", "fumo-jian");
  map_skill("sword", "fumo-jian");
  seteuid(getuid());

  set("inquiry", ([
    "陈光蕊": (: kill_ob(this_player()) :),
    "殷温娇": "她是我的结发妻子",
  ])),
    setup();

  carry_object("/d/obj/weapon/sword/changjian")->wield();
  carry_object("/d/obj/cloth/jinpao")->wear();
}
