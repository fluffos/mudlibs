#include <armor.h>

inherit SURCOAT;

void create()
{
 set_name("挂毯", ({"gua tan","guatan","tan"}));
  set_weight(800);
  if( clonep() )
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("long","这是一块挂毯。\n");

    set("value", 130);
    set("material", "cloth");
    set("armor_prop/armor", 1);
    set("armor_prop/personality", 1);
  }
  setup();
}

