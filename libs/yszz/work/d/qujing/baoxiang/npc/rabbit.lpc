// created by snowcat on 4/12/1997

inherit NPC;

void create()
{
    set_name("小兔子", ({"little rabbit","rabbit"}));
  set("gender", "男性");
    set("age",5);
  set("long","一只活泼可爱的小兔子，在树林里蹦来蹦去，你不禁想捉住(catch)它。\n");
  set("combat_exp",2000);
  set("per",30);
  setup();
}

void init()
{
  add_action("do_catch","catch");
}

int do_catch(string arg)
{
  if(!arg||arg!="rabbit")
    return notify_fail("你想抓什么?\n");
  say("小兔子一下子就蹦进树林不见了。\n");
  destruct(this_object());
  this_player()->set_temp("marks\rabbitmiss",1);
  return 1;
}
