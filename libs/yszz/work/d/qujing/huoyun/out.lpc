inherit ROOM;

void create() {
  set("short", "洞外");
  set("long", @LONG

回峦古道幽还静，风月也听玄鹤弄，白云透出满川光，流水
过桥仙意兴，猿啸鸟啼花木奇，藤萝石蹬芝兰胜，苍摇崖壑
散烟霞，翠染松篁招彩凤。

LONG);

  set("exits", ([
    "northwest": __DIR__ "dongwai",
    "eastup": __DIR__ "shanya5",
  ]));
  set("outdoors", 1);
  setup();
}
