#include <ansi.h>
string ask_niang();

inherit NPC;
void create()
{
   set_name("红孩儿", ({ "honghaier","hong" }));
   set("title", "圣婴大王");   
   set("long", @LONG
他本是牛魔王之子，生性好斗；又在火焰山修炼八百年,修成天下难敌的三昧真火。
他使得一手的好枪法，火云枪更是鲜有敌手，寻常人是不敢碰他的。
LONG);
   set("gender", "男性");
   set("age", 15);
   set("attitude", "heroism");
   set("max_kee", 4000);
   set("max_gin", 4000);
   set("max_sen", 4000);
   set("force", 4500);
   set("max_force", 3000);
   set("force_factor", 50);
   set("max_mana", 3000);
   set("mana", 5000);
   set("mana_factor", 50);
   set("combat_exp", 1100000);
   set_skill("literate", 180);
   set_skill("spells", 150);
   set_skill("pingtian-dafa", 170);
   set_skill("unarmed", 130);
   set_skill("moyun-shou", 130);
   set_skill("dodge", 120);
   set_skill("moshenbu", 120);
   set_skill("parry", 150);
   set_skill("force", 150);
   set_skill("huomo-xinfa", 150);
   set_skill("spear", 140);
   set_skill("huoyun-qiang", 120);
   map_skill("spells", "pingtian-dafa");
   map_skill("unarmed", "moyun-shou");
   map_skill("dodge", "moshenbu");
   map_skill("force", "huomo-xinfa");
   map_skill("parry", "huoyun-qiang");
   map_skill("spear", "huoyun-qiang");
   set("inquiry", ([
        "你娘": (: ask_niang :),
        "铁扇公主": (: ask_niang :),
        "娘": (: ask_niang :),
        ]));
   create_family("火云洞", 1, "弟子");
   setup();
   carry_object("/obj/money/gold");
   carry_object("/obj/money/gold");
   carry_object("/obj/cloth")->wear();
   carry_object("/d/nanhai/obj/huojianqiang")->wield();
}
void init()
{
        object ob = this_player();
        remove_call_out("check");
        call_out("check",1,ob);
        add_action("do_yes","ok");
}

void check(object ob)
{
        object where=environment();
       if ( ob->query_temp("apply/name") &&
            ob->query_temp("apply/name")[0] == "牛魔王" 
          && ! ob->query_temp("done"))
           {
        command("say 父王怎有机会来看望孩儿。");
        command("say 孩儿正好抓到一个和尚，吃了他，可以长生不老啊。");
        command("xixi");
        return;
            }

        if( present("jin che",where) || present("mu che",where)
        ||  present("shui che",where) || present("huo che",where) ||
            present("tu che",where) )
          {
        kill_ob(ob);
        message_vision(HIR"只见红孩儿手架五行车，手中火尖枪对$N一指。\n",ob);
        message_vision(HIR"一股三昧真火带着浓烟扑向$N，$N抽身便走。\n",ob);
        ob->move("/d/qujing/huoyun/out");
        ob->unconcious();
        }
kill_ob(ob);
}
string ask_niang()
{
        object ob = this_player();
       if ( ob->query_temp("apply/name") &&
            ob->query_temp("apply/name")[0] == "牛魔王" )
             {
            command("bird");
            ob->set_temp("ok",1);
            return "我去请我娘一起吃肉好吗（ok）？\n";
             }
       
        kill_ob(ob);
        return "我娘管你什么事？\n";
}

int do_yes()
{
        object ob = this_player();
        if( ! ob->query_temp("ok") ) return 0;
        command("say 父王请在家等候，孩儿快去快回。");
        command("bye");
        destruct(this_object());
        return 1;
}

int accept_fight (object ob)
{
  ob->apply_condition ("killer",100);
  kill_ob (ob);
  return 1;
}

void kill_ob (object ob)
{
  set_temp("no_return",1);
  set_temp("my_killer",ob);
  ::kill_ob(ob);
}

void die()
{
  object ob = query_temp("my_killer");
  object pusa = new (__DIR__"pusa");
  if (ob)
  {
  pusa->move(environment(ob));
  message_vision(HIY"天上传来观音菩萨的声音：红孩儿，还不随我回南海去。\n"NOR,ob);
  ob->set_temp("obstacle/hong_killed",1);
   }
  ::die();
}


void unconcious ()
{
  die();
}
