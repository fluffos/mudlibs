// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */
 
// yudi.c

#include <weapon.h>
#include <ansi.h>

inherit SWORD;
inherit F_SAVE;
inherit F_AUTOLOAD;
inherit F_DAMAGE;
inherit F_UNIQUE;
inherit F_CLEAN_UP;
inherit F_COMMAND;

void create()
{
   set_name(HIG "碧玉笛" NOR , ({"di","sword" }) );
   set_weight(1000);
   if( clonep() )
     set_default_object(__FILE__);
   else {
     set("unit", "根");
     set("value", 0);
     set("long", "一根碧玉制就的笛子，绿莹莹地甚是精致。\n");
     set("wield_msg", "$N拿起一支$n放在唇边轻轻一吹。\n");
     set("unwield_msg", "$N盈盈一笑，将$n插回腰间。\n");
   }
   init_sword(150000);
   setup();
}
