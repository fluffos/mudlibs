//  妖神之争 １。０
//  by happ@YSZZ 2000.4.7
//  /d/qujing/village/npc/oldwoman.c

inherit NPC;
#include <ansi.h>

void create() {
  set_name("老妈妈", ({ "old woman", "lao fu" }));
  set("gender", "女性");
  set("age", 55);
  set("per", 19);
  set("long",
    "一位很慈祥的老太太。\n");

  set("combat_exp", 600 + random(400));
  set("attitude", "friendly");
  set_skill("dodge", 10);
  set_skill("unarmed", 10);
  setup();
  carry_object("/obj/cloth")->wear();
  add_money("silver", 3 + random(20));
}

void init() {
  object ob = this_player();
  remove_call_out("checking");
  call_out("checking", 1, ob);
}

void checking(object ob) {
  if (ob->query("obstacle/village") == "done")
    return;
  if (!ob->query("obstacle/liusha"))
    return;

  if (!ob->query_temp("yao_killed")
    && ob->query_temp("seen")) {
    command("say 你去帮我杀了那些妖怪吧。好吗？");
    return;
  }
  if (ob->query_temp("yao_killed")
    && !ob->query_temp("cao_given")) {
    tell_object(ob, "老妈妈对你说道：能否再帮我去寻找" + RED "七叶琼芝草" NOR + "？\n");
    return;
  }
  command("say 听说" + ob->query("name") + "是去西天取真经的，能否帮个忙呢？");
  command("say 我们家北面有些妖怪在作乱，不知你能否帮我杀了他们啊？");
  ob->set_temp("seen", 1);
  return;
}

int accept_object(object who, object ob) {


  if (ob->name() == RED "七叶琼芝草" NOR) {
    if (!who->query_temp("yao_killed")) {
      command("say 你还是先去帮我杀了那些妖怪吧。好吗？");
      return 1;
    }
    command("smile");
    command("say 多谢你拉。");
    who->set_temp("cao_given", 1);
    this_object()->set_name("骊山老母", ({ "lishan laomu", "lao mu" }));
    call_out("pass", 1, this_player());
    return 1;
  }
  return 1;
}

void pass(object ob) {
  int i;
  if (!ob->query_temp("yao_killed"))
    return;
  if (!ob->query("obstacle/liusha"))
    return;
  if (ob->query("combat_exp") < 10000)
    return;
  if (ob->query("obstacle/village") == "done")
    return;
  i = random(500);
  ob->add("obstacle/number", 1);
  ob->set("obstacle/village", "done");
  ob->add("combat_exp", i + 2000);
  command("chat " + ob->query("name") + "经住耐心与勇气的考验！");
  command("chat " + ob->query("name") + "顺利闯过西行[1;37m第八关！[m");
  tell_object(ob, "你赢得了" + chinese_number(3) + "年" +
    chinese_number(i / 4) + "天" +
    chinese_number((i - (i / 4) * 4) * 3) + "时辰的道行！\n");
  ob->delete("seen");
  ob->save();
  return;
}
