// Room: /d/qujing/wudidong/wdd_bedroom.c

inherit ROOM;

void create() {
  set("short", "[0;31m卧房[m");
  set("long", @LONG

这里是无底洞的卧房，四面地上睡着几个老鼠精。洞中散发着一股令
人作呕的臊气，不知道哪个小妖带东西进来吃了。这也是小妖们自残
(zican)的地方。
LONG
  );
  set("sleep_room", "1");
  set("exits", ([ /* sizeof() == 1 */
    "west": __DIR__ "dong2",
  ]));
  set("no_clean_up", 0);
  set("no_magic", "1");
  set("no_fight", "1");

  setup();
}

void init() {
  add_action("do_zican", "zican");
}
int do_zican() {
  object me = this_player();
  if (me->is_busy())
    return notify_fail("你正忙着呢。\n");
  if ((string)me->query("family/family_name") != "陷空山无底洞")
    return notify_fail("你不是我们 陷空山无底洞的，何必到这种地方糟蹋自己。\n");
  if (me->query("faith") > 200 || me->query("combat_exp") > 100000)
    return notify_fail("你已经不需要在这种地方自残了.\n");
  tell_object(me, "你轮起家伙对自己的要害部位砸去，顿时你感到一阵目眩。\n");
  me->start_busy(5);
  me->add("faith", 2);
  me->add("combat_exp", 10 + random(me->query("str")));
  me->add("potential", 2 + random(me->query("str")));
  me->improve_skill("yaofa", 3);
  me->receive_damage("sen", 40);
  message_vision("$N觉得自己的妖法提高了!\n", me);
  return 1;
}
