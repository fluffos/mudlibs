inherit F_UNIQUE;
inherit ITEM;

void create()
{
        set_name("金刚如意叉", ({"ruyi cha","cha"}));
        set_weight(80);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "这个叉看起来很奇特.\n");
                set("unit", "件");
                set("wudidongbao","fake");
    set("replace_file","/d/lingtai/obj/guo");
        }
}

