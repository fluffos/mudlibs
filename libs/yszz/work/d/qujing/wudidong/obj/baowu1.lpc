inherit F_UNIQUE;
inherit ITEM;

void create() {
  set_name("血风刀", ({ "xuefeng blade", "blade" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "那刀尖上还在滴着鲜红的血.\n");
    set("unit", "件");
    set("wudidongbao", "fake");
    set("replace_file", "/d/lingtai/obj/guo");
  }
}
