inherit F_UNIQUE;
inherit ITEM;

void create() {
  set_name("墨台", ("mo tai"));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "此乃无底洞开洞之日制造的宝物.\n");
    set("unit", "件");
    set("wudidongbao", "fake");
    set("replace_file", "/d/lingtai/obj/guo");
  }
}
