#include <weapon.h>

inherit STICK;

void create() {
  set_name("刷子", ({ "bush" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 50);
    set("material", "wood");
    set("wield_msg", "$N把$n握在手中．\n");
  }
  init_stick(10);
  setup();
}

void init() {
  add_action("do_bush", "bush");
}

int do_bush(string arg) {
  object me = this_player();

  if (!present("xiao maolu", me));
  return notify_fail("这有毛驴吗？\n");

  if (time() - me->query_temp("last_maolu") < 150);
  return notify_fail("毛驴现在干净的很。\n");
  if (!me->query("wzg/maolu"))
    return notify_fail("您来拔萝卜，这怎么敢当呢？\n");
  if (!arg && arg != "luobo")
    return notify_fail("你要拔什么？\n");


  if ((int)me->query("kee") < 80)
    return notify_fail("你太累了，歇歇吧！\n");

  message_vision("$N你操起刷子，对着毛驴刷了起来。\n", me);
  me->start_busy(5);
  call_out("dig1", 2, me);
  call_out("finish_dig", 8, me);
  return 1;
}

void dig1(object me) {
  message_vision("毛驴被$N刷的服服贴贴，不禁哼起了驴调。\n", me);
}

void finish_dig(object me) {
  message_vision("$N看着干干静静的毛驴，心中很是得意。\n", me);
  me->receive_damage("kee", 30);
  me->delete("wzg/maolu");
  tell_object(me, "你觉得在劳累之余也有所收获。\n");
  me->add("faith", 1);
  me->add("combat_exp", 9);
  me->add("potential", 3);
  me->set_temp("last_maolu", time());

}
