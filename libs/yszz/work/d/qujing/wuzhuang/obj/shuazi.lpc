#include <weapon.h>

inherit STICK;

void create() {
  set_name("刷子", ({ "bush" }));
  set_weight(10);
  set("long", "你可以用刷子来给毛驴洗澡wash maolu. \n");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 50);
    set("material", "wood");
    set("wield_msg", "$N把$n握在手中．\n");
  }
  init_stick(10);
  setup();
}

void init() {
  add_action("do_wash", "wash");
}

int do_wash(string arg) {
  object ob = this_object();
  object maolu;
  object me = this_player();
  string env;
  string dest;
  if (!me->query("wuzhuang/maolu"))
    return notify_fail("您来给毛驴洗澡？不敢不敢。\n");
  if (!arg && arg != "maolu")
    return notify_fail("你要给谁洗澡？\n");
  if (!objectp(maolu = present("maolu", environment(me))) && !living(maolu))
    return notify_fail("这有毛驴吗？\n");
  if ((int)me->query("kee") < 80)
    return notify_fail("你太累了，歇歇吧！\n");

  message_vision("$N操起刷子，在毛驴身上开始刷了起来。\n", me);
  me->start_busy(8);
  call_out("dig1", 2, me);
  call_out("dig2", 4, me);
  call_out("dig3", 6, me);
  call_out("finish_dig", 8, me);

  return 1;
}

void dig1(object me) {
  message_vision("$N擦了擦头上的汗水，继续干了起来。\n", me);
}
void dig2(object me) {
  message_vision("小毛驴一抬屁股，一泡尿正洒在你的头上。$N叹了一口气。\n", me);
}
void dig3(object me) {
  message_vision("快要结束了，$N刷的更卖力了，就见毛驴舒服的伸长了脖子。\n", me);
}

void finish_dig(object me) {
  object where = environment(me);

  message_vision("$N擦去身上的汗和尿，看着张果老那干净的小毛驴，心里很是得意。\n", me);
  me->receive_damage("kee", 20);
  where->set("clean", 1);
  me->delete("wuzhuang/maolu");
  tell_object(me, "你觉得在劳累之余也有所收获。\n");
  tell_object(me, "你的经验和扑击格斗提高了。\n");
  me->improve_skill("unarmed", random(me->query("int")), 1);
  me->add("faith", 1);
  me->add("combat_exp", 9);
  me->add("potential", 3);
  this_object()->move(find_living("zhang"));
}
