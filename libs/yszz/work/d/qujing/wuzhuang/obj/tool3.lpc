#include <weapon.h>

inherit STICK;

void create() {
  set_name("干活用的家伙", ({ "hoe" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("no_get", 1);
    set("value", 50);
    set("material", "wood");
    set("wield_msg", "$N把$n握在手中．\n");
  }
  init_stick(10);
  setup();
}

void init() {
  add_action("do_dig", "dig");
}

int do_dig(string arg) {
  object me = this_player();
  string env;


  if (!me->query("wzg/xigua"))
    return notify_fail("您来种西瓜，这怎么敢当呢？\n");
  if (me->is_busy())
    return notify_fail("你现在正忙，还是专心点好。\n");
  if (!arg && arg != "xigua")
    return notify_fail("你要种什么？\n");

  env = environment(me)->query("short");
  if (env != "西瓜地")
    return notify_fail("这是西瓜地吗?\n");

  if ((int)me->query("kee") < 80)
    return notify_fail("你太累了，歇歇吧！\n");

  message_vision("$N走到一块荒地上,拿起铲子,就种起西瓜来\n", me);
  me->start_busy(8);
  call_out("dig1", 2, me);
  call_out("dig2", 4, me);
  call_out("dig3", 6, me);
  call_out("finish_dig", 8, me);

  return 1;
}

void dig1(object me) {
  message_vision("$N擦了擦头上的汗水，继续干了起来。\n", me);
}
void dig2(object me) {
  message_vision("$N歇了一会儿,看着自己的劳动成果,心里美滋滋.\n", me);
}
void dig3(object me) {
  message_vision("快要结束了，$N顾不得擦头上的汗水.专心的干起活来\n", me);
}

void finish_dig(object me) {
  object where = environment(me);

  message_vision("$N抹了一把汗，得意的笑了笑。身后是整整齐齐一片已开好的西瓜地。\n", me);
  me->receive_damage("kee", 40);
  where->set("clean", 1);
  me->delete("wzg/xigua");
  tell_object(me, "你觉得在劳累之余也有所收获。\n");
  tell_object(me, "你的经验和基本棍法提高了。\n");
  me->improve_skill("stick", random(me->query("int")), 1);
  me->add("faith", 1);
  me->add("combat_exp", 9);
  me->add("potential", 3);
}
