// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */
 
// worker.c

inherit NPC;

string ask_zhongdi();

void create()
{
        set_name("种地小道", ({"worker"}));
        set("gender", "男性" );
        set("age", 19);
        set("long", "一个小道，正在种地");
        set("combat_exp", 1000);
   set_skill("stick", 20);
   set_skill("dodge", 40);
        set("attitude", "friendly");
        set("chat_chance_combat", 50 );
        
        set("inquiry", ([
          "西瓜": (: ask_zhongdi :),
          ]));
        setup();
   carry_object("/d/qujing/wuzhuang/obj/tool3")->wield();
}

string ask_zhongdi()
{
   object me=this_player();
   if((string)me->query("family/family_name")!="五庄观")
      return ("您不是本门中人。");
   if(me->query("faith")>200||me->query("combat_exp")>100000)
      return ("您是本门大有名望之人，怎敢有劳您做这种杂务呢？");
  me->set("wzg/xigua",1);
   return ("好吧,正好庄主让我来种西瓜,你就帮帮我吧(dig xigua)。");
}
