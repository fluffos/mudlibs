/*
 * Temple of All Gods — hall (;ch;oldtown;temple).
 * Strategy A FluffOS room.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "south": "/world/start/temple2",
    "north": "/world/start/oldtown",
    "out": "/world/start/oldtown",
  ]);
  extras = ([
    "door": "Heavy wooden doors stand open to the street.\n",
    "doors": "Heavy wooden doors stand open to the street.\n",
    "pew": "Plain wooden benches line the hall.\n",
    "pews": "Plain wooden benches line the hall.\n",
  ]);
}

string query_short() { return "Temple hall"; }

string query_long() {
  return "The public hall of the Temple of All Gods. Benches face the "
    "inner shrine to the south. Open doors lead north onto an "
    "Oldtown street.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are south, north and out.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "hall" || str == "temple" || str == "here"; }
