/*
 * Oldtown street outside the temple (;ch;oldtown).
 * Strategy A FluffOS room.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "south": "/world/start/temple",
  ]);
  extras = ([
    "street": "Packed dirt and worn cobbles, quiet at this hour.\n",
    "temple": "The Temple of All Gods stands to the south, its doors open.\n",
  ]);
}

string query_short() { return "Oldtown street"; }

string query_long() {
  return "A quiet street in Oldtown. The Temple of All Gods stands to the "
    "south. Further streets are closed for now.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The only obvious exit is south.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "street" || str == "oldtown" || str == "here"; }
