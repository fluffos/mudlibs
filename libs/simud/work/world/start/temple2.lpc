/*
 * Temple of All Gods — inner shrine (spawn ;ch;oldtown;temple;temple2).
 * Strategy A FluffOS room. The live SIMud world was a saved object tree
 * (/world/world.obj) that is not in the git snapshot.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "north": "/world/start/temple",
    "out": "/world/start/temple",
  ]);
  extras = ([
    "altar": "A low stone altar, worn smooth by years of offerings. "
      "No single god is named on it.\n",
    "statue": "Stone figures of many faiths stand in a ring around the "
      "altar, some familiar, some not.\n",
    "statues": "Stone figures of many faiths stand in a ring around the "
      "altar, some familiar, some not.\n",
  ]);
}

string query_short() { return "Temple of All Gods"; }

string query_long() {
  return "You are in the inner shrine of Oldtown's Temple of All Gods. "
    "A ring of statues watches a plain stone altar. New souls wake "
    "here, and the dead return here. The temple hall is to the north.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are north and out.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "temple" || str == "shrine" || str == "here"; }
