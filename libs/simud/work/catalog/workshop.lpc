mapping exits;

void create() {
  exits = ([
    "south": "/catalog/void",
  ]);
}

string query_short() { return "SIMud workshop"; }

string query_long() {
  return "SIMud workshop\n"
    "Notes on the SIMud LDMud → FluffOS conversion. Original master:\n"
    "/secure/master_ldmud.lpc (inaugurate_master, set_driver_hook).\n"
    "South returns to the void.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "Exits: south.\n";
}

int id(string str) { return str == "workshop" || str == "here"; }
