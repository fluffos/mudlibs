#include <ansi.h>
inherit NPC;


int set_gumu_guai(int level, object ob) {
  ob->set("gender", "男性");

  ob->set_skill("force", level);
  ob->set_skill("nutao-shengong", level);
  ob->set_skill("sword", level);
  ob->set_skill("iron-sword", level);
  ob->set_skill("dodge", level);
  ob->set_skill("yunv-shenfa", level);
  ob->set_skill("parry", level);
  ob->set_skill("strike", level);
  ob->set_skill("anran-zhang", level);
  ob->map_skill("force", "nutao-shengong");
  ob->map_skill("sword", "iron-sword");
  ob->map_skill("dodge", "yunv-shenfa");
  ob->map_skill("parry", "iron-sword");
  ob->map_skill("strike", "anran-zhang");
  ob->prepare_skill("strike", "anran-zhang");

  ob->set("chat_msg_combat", ({
    (: perform_action, "sword.xunlei" :),
  }));
  ob->carry_object("/clone/misc/cloth")->wear();
  ob->carry_object("/clone/weapon/changjian")->wield();
  ob->create_family("古墓派", 18, "叛徒");
}


