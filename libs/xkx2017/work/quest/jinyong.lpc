inherit NPC;
#include <ansi.h>
inherit F_MASTER;
int time_period(int timep, object me);
string sysmsg;
void create()
{
	set_name(HIY "金庸" NOR, ({ "jin yong", "jin", "yong" }) );

	set("gender", "男性");
	set("age", 89);
	set("long",
		"飞雪连天射白鹿，笑书神侠倚碧鸳\n");
	set("attitude", "peaceful");
	set("str", 30);
	set("con", 25);
	set("int", 30);
	set("dex", 25);
        set("chat_chance", 1);
        set("chat_msg", ({
                "金庸拿起旱烟抽了几口．．．．\n",
        }) );

	set("jingli", 4000);
	set("max_jingli", 2000);
	set("neili", 4000);
	set("max_neili", 2000);
	set("jiali", 10);

	set("combat_exp", 100000);
	set("score", 20000);

	set_skill("unarmed", 100);
	set_skill("force", 100);
  set_skill("literate", 1000);
  set_skill("parry", 100);
  set_skill("dodge", 100);
	set("nickname",HIW "闲云野鹤"NOR);
	setup();

	carry_object("/d/city/obj/cloth")->wear();
}
int accept_fight(object me)
{
        command("say 生命可贵！不要自寻死路！");
        return 0;
}
void init()
{
        add_action("give_quest", "quest");
}
int accept_object(object who, object ob)
{
        int  exp, pot, score, val;
	string test;
	mapping quest;
	val = ob->value();
	if (val)
	{if (val>=1000)
		       {who->set("quest", 0 );
		       	if (who->query("combat_exp")>999)
		       		{who->add("combat_exp",-30);
       	 	tell_object(who,"金庸说道：好吧，这个任务就算了吧．．.\n你的实战经验似乎降低了. . .\n");}
       	 	else
       	 		tell_object(who,"金庸说道：好吧，这个任务就算了吧．．.\n");
		who->delete_temp("quest_number");
	return 1;}
	else {tell_object(who,"金庸说道：我不缺这么一点点钱啊！\n");
	return 0;}
	}
        if(!(quest =  who->query("quest")))
	{
        tell_object(who,"金庸说道：这不是我想要的。\n");
	return 0;
	}
        if( (string)ob->query("name") != quest["quest"])
        {
        tell_object(who,"金庸说道：这不是我想要的。\n");
        return 0;
        }
	if( ob->is_character())
        {
        tell_object(who,"金庸说道：这不是我想要的。\n");
        return 0;
        }
destruct(ob);
if ((int) who->query("task_time") < time() )
        {
        tell_object(who,"金庸说道：真可惜！你没有在指定的时间内完成！\n");
                        return 1;
        }
        else
        {
       tell_object(who,"金庸说道：恭喜你！你又完成了一项任务！\n");
	exp = quest["exp_bonus"]/2 + random(quest["exp_bonus"]/2)+1;
// put a cap
	if(exp > 150) exp = 150;
	exp = 6 * exp * (int) who->query_temp("quest_number");
	pot = exp / 3 + 1;
//	due to weekly quest, each quet worth 20
//	score = quest["score"]/2 + random(quest["score"]/2);
	score = -1;
	who->add("combat_exp",exp);
	who->add("potential",pot);
	who->add("score",score);
        tell_object(who,HIW"你被奖励了：\n" +
	chinese_number(exp) + "点实战经验\n"+
chinese_number(pot) + "点潜能\n" NOR);
  	 
	who->set("quest", 0 );
                        return 1;
        }
                return 1;
}

int give_quest(string arg)
{
	mapping quest ;
	object me;
	int j, combatexp, timep, lvl=0;
        mixed *local;
        int  t;
	string tag = "40000000";
 string *levels = ({
                        "0",
                        "4000",
                        "8000",
                        "16000",
                        "32000",
                        "64000",
                        "128000",
                        "256000",
                        "512000",
                        "1024000",
                        "1536000",
                        "2304000",
                        "3456000",
                        "5184000",
                        "7776000",
                        "11664000",
                        "17496000",
                        "26244000",
			"40000000"
        });
	if( ! arg || !sscanf(arg, "%d", lvl))
	lvl = 0;
	if(lvl<0) lvl=0;
	me = this_player();
// Let's see if this player is a ghost
	
	if((int) me->is_ghost())
	{
		write("鬼魂不可要任务．\n");
		return 1;
	}
if (me->query("combat_exp")>2100000000)
		{
			message_vision ("金庸对$N说道：\n"
                        +"这位"+RANK_D->query_respect(me)+",在下这里没有任务给您做了。\n"
                        ,me);
						return 1;
		}
// Let's see if this player still carries an un-expired task
        if((quest =  me->query("quest")))
	{
	if( ((int) me->query("task_time")) >  time() )
		return 0;
	else
		me->set("kee", me->query("kee")/2+1);
		me->delete_temp("quest_number");
	}
	combatexp = (int) me->query("combat_exp");
        for(j= sizeof(levels) - 1 ; j>=0; j--)
        {
                if( atoi(levels[j])  <= combatexp )
                        {
                                tag = levels[j];
				if(j < (sizeof(levels)- lvl)) tag = levels[j+lvl];
                                break;
                        }
        }
        if(!random(40) ) tag = "_new";
	if(!random(10) ) tag = "_common";
	quest = QUEST_D(tag)->query_quest();
//	to use less mem...
//	timep = quest["time"];	
	timep = 600;   // each quest give 10 mins.
// A factor here to make time random
	timep = random(timep/2)+timep/2;
	time_period(timep, me);
	if (quest["quest_type"] == "寻")
	{
        tell_object(me,"找回『"+quest["quest"]+"』给金庸。\n" NOR);
	sysmsg +="找回『"+quest["quest"]+"』。";
	}
	        if (quest["quest_type"] == "杀")
        {
        tell_object(me,"替金庸杀了『"+quest["quest"]+"』。\n" NOR);
	sysmsg +="杀了『"+quest["quest"]+"』。";
        }
 	me->set("quest", quest);
	me->set("task_time", (int) time()+(int) timep);
	if((int)me->query_temp("quest_number") < 5)
	me->add_temp("quest_number",1);
	CHANNEL_D->do_channel(this_object(), "qst", sprintf("%s(%s)：%s", 
	me->query("name"),me->query("id"),sysmsg));

return 1;
}

int time_period(int timep, object me)
{
        int t, d, h, m, s;
        string time;
        t = timep;
        s = t % 60;             t /= 60;
        m = t % 60;             t /= 60;
        h = t % 24;             t /= 24;
        d = t;

        if(d) time = chinese_number(d) + "天";
        else time = "";

        if(h) time += chinese_number(h) + "小时";
        if(m) time += chinese_number(m) + "分";
        time += chinese_number(s) + "秒";

        tell_object(me,HIW + sprintf("%s",this_object()->name()) +"说道：\n请在" + time + "内");
	sysmsg = "在" + time + "内";
        return 1;
}
void die()
{ if (environment())
    message("sound", "\n\n金庸缓缓道：“九阴九阳，护我金身！”\n\n", environment());

	set("eff_jing",70);
	set("jing",70);
	set("eff_qi",750);
	set("qi",750);
	set("neili",4000);
	set("max_neili",2000);
}
void unconcious()
{die();}
