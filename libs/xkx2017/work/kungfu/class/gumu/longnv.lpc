// Last Modified by winder on Feb. 28 2001
// longnv.c 小龙女

#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string ask_me();

void create() {
  set_name("小龙女", ({ "xiao longnv", "longnv" }));
  set("nickname", HIM "绝世仙女" NOR);
  set("gender", "女性");
  set("age", 28);
  set("long",
    "小龙女是古墓派第三代传人，容颜绝世，武功高强。\n"
    "她给人一种不食人间烟火的感觉。\n");
  set("attitude", "friendly");
  set("shen", 2000);
  set("per", 99);
  set("str", 25);
  set("int", 30);
  set("con", 28);
  set("dex", 80);
  set("chat_chance", 5);
  set("chat_msg", ({
    "小龙女叹道：“一生一世在古墓待着多好啊！”\n",
  }));
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: perform_action, "sword.chengshuang" :),
    (: command("hubo") :),
    (: exert_function, "recover" :),
  }));
  set("qi", 5000);
  set("max_qi", 5000);
  set("jing", 3000);
  set("max_jing", 3000);
  set("jingli", 1000);
  set("max_jingli", 1000);
  set("neili", 4000);
  set("max_neili", 3500);
  set("jiali", 100);
  set("food", 800);
  set("water", 800);
  set("combat_exp", 1500000);
  set("score", 0);

  set_skill("force", 300);
  set_skill("yunv-xinfa", 450);
  set_skill("sword", 280);
  set_skill("dodge", 450);
  set_skill("meinv-quan", 200);
  set_skill("yunv-shenfa", 450);
  set_skill("parry", 200);
  set_skill("hubo", 200);
  set_skill("unarmed", 200);
  set_skill("throwing", 200);
  set_skill("literate", 90);
  set_skill("mantian-huayu", 200);
  set_skill("yunv-jianfa", 280);
  map_skill("force", "yunv-xinfa");
  map_skill("sword", "yunv-jianfa");
  map_skill("throwing", "mantian-huayu");
  map_skill("dodge", "yunv-shenfa");
  map_skill("parry", "yunv-jianfa");
  map_skill("unarmed", "meinv-quan");
  create_family("古墓派", 3, "掌门");
  set("letter_count", 1);

  set("inquiry", ([
    "杨过": "过儿是小女子的夫君，他自创的黯然销魂掌盖世无双。\n",
    "古墓派": "祖师奶奶本来和重阳真人是一对璧人，可是...\n",
  ]));
  setup();
  carry_object("/d/zhongnan/obj/xiannvjian")->wield();
  carry_object("/d/city/npc/obj/pink_cloth")->wear();
}

void attempt_apprentice(object ob) {
  command("say 好吧，我就收下你这个徒弟了。\n");
  command("recruit " + ob->query("id"));
  return;
}
void kill_ob(object ob) {
  object me = this_object();
  object where = environment(me);
  object yang = present("yang guo", where);
  set_temp("my_killer", ob);
  ::kill_ob(ob);
  if (yang && !yang->is_fighting()) {
    message("vision", "杨过怒道：“" + ob->name() + "，竟敢对我妻子下手，我劈了你！”\n", environment(), me);
    yang->kill_ob(ob);
  }
}
