// mizong.c 神行百变「迷踪决」

#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target) {
  int busytime;
  string msg;
  busytime = (int)me->query_skill("shenxing-baibian") / 10;
  if (busytime > 4) busytime = 4;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("「迷踪决」只能对战斗中的对手使用。\n");

  if (target->is_busy())
    return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧。\n");

  if ((int)me->query_skill("shenxing-baibian", 1) < 40)
    return notify_fail("你的神行百变不够娴熟，不会使用「迷踪决」。\n");

  msg = HIG "$N使出神行百变「迷踪决」，试图打乱$n的攻势。\n";

  me->start_busy(1 + random(2));
  if (random(me->query("combat_exp")) > (int)target->query("combat_exp") / 10) {
    msg += HIR " 结果$p被$P弄得手忙脚乱！\n" NOR;
    target->start_busy(busytime);
  } else {
    msg += "可是$p看破了$P的企图，并没有上当。\n" NOR;
  }
  message_vision(msg, me, target);

  return 1;
}
