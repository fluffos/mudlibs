//Cracked by Roath
//binfen.c 落英缤纷 

#include <ansi.h>

inherit F_DBASE;
inherit F_SSERVER;

int perform(object me, object target)
{
	string weapon;
	object weapon1;
	int    lvl1, lvl2, amount;
  
  if ( (me->query("family/family_name") != "桃花岛"))
	  	return notify_fail("你不是桃花岛弟子，无法领会「落英缤纷」。\n");
	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("落英缤纷只能对战斗中的对手使用。\n");

	weapon1 = me->query_temp("weapon");
        if( !objectp(weapon1) || weapon1->query("skill_type") != "sword" )
                return notify_fail("你手中无箫无剑，如何使得落英缤纷？\n");
  if( me->query_skill("bibo-shengong", 1) < 100 )
		return notify_fail("你的碧波神功修为不够，施展不出落英缤纷！\n");
	if( me->query_skill("luoying-shenjian", 1) < 90 )
		return notify_fail("你的落英神剑火候未到，无法施展落英缤纷！\n");

	lvl1=me->query_skill("force");

	lvl2=me->query_skill("sword");

	amount = (lvl1+lvl2) / 15;

	if ( amount < 40 ) amount = 40;
	if ( amount > 80 ) amount = 80;

	if( me->query("neili") <= amount*3 )
		return notify_fail("你的内力不够使用落英缤纷！\n");
	
	weapon = me->query_temp("weapon");

	me->add_temp("apply/damage", amount/4);
	me->add_temp("apply/attack", amount/3);
	me->add_temp("apply/dodge", amount/3);

	message_vision(HIM "\n$N笑一声「"NOR+MAG"亲亲你闺女！"+HIM"」,$n但见无穷剑芒缤纷袭来！\n\n" NOR, me, target);

	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  me->start_busy(2);
	me->add_temp("apply/damage", -amount/4);
	me->add_temp("apply/attack", -amount/3);
	me->add_temp("apply/dodge", -amount/3);
	me->add("neili", -amount*2);
	return 1;
}
