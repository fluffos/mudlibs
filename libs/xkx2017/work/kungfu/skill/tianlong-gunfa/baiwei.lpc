#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;

int perform(object me, object target) {
  object weapon, ob;
  string msg, string1;
  int count;

  if ((me->query("family/family_name") != "天龙寺"))
    return notify_fail("你不是天龙寺弟子，无法施展「天龙摆尾」。\n");
  if (!me->is_fighting())
    return notify_fail("「天龙摆尾」只能在战斗中使用。\n");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "club")
    return notify_fail("你使用的武器不对。\n");

  if ((int)me->query_dex() < 30)
    return notify_fail("你的身法不够, 目前还不能使用这项绝技! \n");

  if ((int)me->query_skill("kurong-changong", 1) < 100)
    return notify_fail("你的枯荣禅功的修为不够, 不能使用这一绝技 !\n");

  if ((int)me->query_skill("tianlong-gunfa", 1) < 120)
    return notify_fail("你的天龙棍法修为不够， 使用不了「天龙摆尾」! \n");

  if ((int)me->query_skill("dodge") < 120)
    return notify_fail("你的轻功修为不够, 不能使用「天龙摆尾」！\n");

  if ((int)me->query_skill("club") < 120)
    return notify_fail("你的棍法修为不够， 目前不能使用「天龙摆尾」! \n");

  if ((int)me->query("neili") < 500)
    return notify_fail("你的真气不够！\n");


  msg = YEL "$N使出天龙棍法的绝技「天龙摆尾」，顿时前后左右都处在$N的棍影笼罩之下！\n" NOR;
  message_vision(msg, me);

  me->clean_up_enemy();
  ob = me->select_opponent();

  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);

  me->add("neili", -100);
  me->start_busy(1 + random(2));

  return 1;
}
