// cimu.c 辟邪剑法「刺目」

#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target) {
  int i, j, m, p;
  object weapon;
  string msg;
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("「刺目」只能对战斗中的对手使用。\n");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");

  if (userp(me) && (int)me->query_skill("kuihua-xinfa", 1) < 40)
    return notify_fail("你的葵花心法修为不够，使用不出「刺目」绝技！\n");
  if ((int)me->query_skill("bixie-jianfa", 1) < 40)
    return notify_fail("你的辟邪剑法不够娴熟，不会使用「刺目」。\n");
  if ((int)me->query("neili") < 300)
    return notify_fail("你的内力不够。\n");
  j = random(3);
  switch (j) {
    case 0:
      msg = RED "$N尖叫道：“欲练神功，引刀自宫！”\n" NOR; break;
    case 1:
      msg = MAG "$N怪叫道：“天下风云出我辈，一入江湖岁月催！”\n" NOR; break;
    default:
      msg = CYN "$N嚎叫道：“葵花宝典，所向无敌！”\n" NOR;
  }
  message_vision(msg, me, target);
  if ((me->query("family/family_name") != "日月神教")) {
    i = 4; m = 3;
  } else { i = 10; m = 6; }
  //if( random(me->query("combat_exp")) > (int)target->query("combat_exp")/4) 
  if (random((int)me->query_skill("bixie-jianfa", 1)) * i > (int)target->query_skill("dodge")) {
    msg = HIR " $p的眼珠子被$P刺得鲜血淋漓，惨不忍睹！\n" NOR;
    if (!target->is_busy()) target->start_busy(1 + random(3));
    for (p = m; p > 0; p--)
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
    me->start_busy(1);
  } else {
    for (p = (int)m / 2; p > 0; p--)
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
    msg = CYN "$p匆忙护住了眼珠子。\n" NOR;
    me->start_busy(1);
  }
  me->add("neili", -100);
  message_vision(msg, me, target);

  return 1;
}
