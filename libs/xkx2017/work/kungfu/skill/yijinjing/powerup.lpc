// powerup.c 易筋经加力

#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me, int amount);

int exert(object me, object target)
{
	int skill;

	if ( !wizardp(me) && (me->query("family/family_name") != "少林派"))
		return notify_fail("你不是少林弟子，不能使用易筋经。\n
		 		    易筋经博大精深, 真不知道你是怎么学会的!\n");
 
  if((int)me->query_skill("yijinjing") < 20 )
		return notify_fail("你的易筋经修为太低了。\n");
		
	if( target != me ) 
		return notify_fail("你只能用易筋经来提升自己的战斗力。\n");

	if( (int)me->query("neili") < 100  ) 
		return notify_fail("你的内力不够。\n");
	if( (int)me->query_temp("powerup") ) 
		return notify_fail("你已经在运功中了。\n");

	skill = me->query_skill("force");
	me->add("neili", -100);
	me->receive_damage("qi", 0);

	message_vision(
	HIR "$N微一凝神，运起易筋经，将全身潜能尽皆爆发。\n" NOR, me);

	me->add_temp("apply/attack", skill/8);
	me->add_temp("apply/dodge", skill/4);
	me->set_temp("powerup", 1);

	me->start_call_out( (: call_other, __FILE__, "remove_effect", me, skill/8 :), skill);

	if( me->is_fighting() ) me->start_busy(1);

	return 1;
}

void remove_effect(object me, int amount)
{
   if ( (int)me->query_temp("powerup") ) {
	me->add_temp("apply/attack", - amount);
	me->add_temp("apply/dodge", - amount*2);
	me->delete_temp("powerup");
	tell_object(me, "你的易筋经运行完毕，将内力收回丹田。\n");}
}
