inherit ROOM;

void create()
{
        set("short", "地下休息室");
        set("long", @LONG
        这是一间肮脏的休息室，没有床铺，劳累的人们只能躺在地上睡觉。
LONG
        );

        set("sleep_room", 1);
        set("no_fight", 1);
        set("exits", ([
		"up" : __DIR__"guangchang",
		]));

        setup();
}