// mujian.c 木剑

#include <weapon.h>
inherit SWORD;

void create()
{
	set_name("木剑", ({ "mujian", "sword" }));
	set_weight(1000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "柄");
		set("long", "这是一柄普通的木剑，一般师兄弟比武时使用。\n");
		set("value", 500);
		set("material", "wood");
		set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中。\n");
		set("unwield_msg", "$N将手中的$n插回剑鞘。\n");
	}
	init_sword(10);
	setup();
}
