// weixiaobao.c
#include <ansi.h>
inherit NPC;

void create() {
  set_name("韦小宝", ({ "wei xiaobao", "wei", "xiaobao" }));
  set("nickname", YEL "小混混" NOR);
  set("gender", "男性");
  set("age", 16);
  set("long",
    "这是扬州城内的一个小混混。\n");

  set("str", 20);
  set("dex", 27);
  set("con", 23);
  set("int", 26);
  set("shen_type", 1);
  set_temp("apply/defense", 15);
  set("combat_exp", 500);
  set("attitude", "peaceful");
  set("qi", 210);
  set("max_qi", 210);
  set_skill("unarmed", 10);
  set_skill("dodge", 10);
  set_skill("parry", 10);
  set("chat_chance", 20);
  set("chat_msg", ({
    "韦小宝说道: 我最爱听大姑娘唱十八摸了。～\n",
    "韦小宝说道：为人不识陈近南，就算英雄也枉然。 \n",
    (: random_move :)
  }));
  set("inquiry", ([
    "陈近南": "嘿嘿，不认识。",
    "韦春芳": "我娘可是丽春院的名花啊。"
  ]));
  setup();
  carry_object(__DIR__ "obj/cloth")->wear();
  add_money("silver", 42);
}
