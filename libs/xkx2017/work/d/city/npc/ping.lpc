// ping.c 平一指

inherit NPC;
inherit F_DEALER;
int ask_me();
void create() {
  set_name("平一指", ({ "ping yizhi", "ping", "yizhi" }));
  set("title", "药铺老板");
  set("gender", "男性");
  set("long", "他就是医术高超的「杀人神医」平一指。可是他性格古怪，不是什么人都医的。\n");
  set("age", 65);

  set("int", 30);

  set("qi", 1000);
  set("max_qi", 1000);
  set("jing", 1000);
  set("max_jing", 1000);
  set("shen_type", 1);

  set("combat_exp", 500000);
  set("attitude", "heroism");

  set_skill("unarmed", 80);
  set_skill("dodge", 80);
  set_skill("parry", 60);
  set_temp("apply/attack", 70);
  set_temp("apply/defense", 70);
  set_temp("apply/damage", 50);


  set("inquiry", ([
    "有病": (: ask_me :),
    "治病": (: ask_me :),
    "看病": (: ask_me :),
  ]));

  setup();
  add_money("gold", 1);
  carry_object("/clone/misc/cloth")->wear();
}

int ask_me() {
  object ob;
  ob = this_player();

  if (ob->query("balance") < 30000) {
    command("?" + ob->query("id"));
    command("say 你的钱庄存款不够支付老夫的诊金。\n");
    return 1;
  }
  if ((int)ob->query("eff_qi") == (int)ob->query("max_qi") && (int)ob->query("eff_jing") == (int)ob->query("max_jing")) {
    command("?" + ob->query("id"));
    command("say 你没有生病啊？\n");
    return 1;
  } else {
    ob->add("balance", -10000);
    message_vision("$N向平一指的账户转入一两黄金。\n平一指将$N的裤子褪下，在$N的屁股上面狠狠地扎了一针。\n", ob);
    remove_call_out("recover");
    call_out("recover", 2, ob);
    return 1;
  }
}


int recover(object ob) {
  ob->set("eff_qi", (int)ob->query("max_qi"));
  ob->set("qi", (int)ob->query("max_qi"));
  ob->set("eff_jing", (int)ob->query("max_jing"));
  ob->set("jing", (int)ob->query("max_jing"));
  message_vision("大约过了一炷香的时间，平一指将针猛地拔了出来。\n", ob);
  command("say 你的病已经全好了,可以滚啦。\n");
  return 1;
}
