#include <ansi.h>

inherit ROOM;

void create()
{
    set("short", "后院");
    set("long", @LONG
这是一个破旧的后院。院子倒挺宽阔，可以容下几十头猪。
院子右首有一只黑雕(diao)。原来这里是日月神教为方便
弟子回黑木崖而特意建起的。
LONG
    );

    set("item_desc", ([
        "diao" : "一只黑雕正展翅欲飞。如果是日月神教的弟子，\n"
                  "骑上(ride)就可以飞回黑木崖。\n",
    ]));
    set("exits", ([
		"north" : "/d/city/zhengting",
    ]));
    setup();
}


void init()
{
    add_action("do_ride", "ride");
}
int do_ride ( )
{
    mapping myfam;
    object room;
    object ob = this_player () ;
    myfam = (mapping)ob->query("family");
    if(!myfam || myfam["family_name"] != "日月神教")
    {
      message_vision("$N一跃身跨上了黑雕。只见黑雕仰天长唳，突然猛然一颠......\n"
                     HIR "结果$N摔了个鼻青脸肿！\n" NOR
                     "看来黑雕对$N并不感兴趣，它只认识日月神教的弟子。\n" , ob ) ;
      ob -> receive_damage ("qi",50) ;
      ob -> receive_wound  ("qi",50) ;
      return 1;
    }
    if( !(room = find_object(__DIR__"lantian")) )
            room = load_object(__DIR__"lantian");
    if( room = find_object(__DIR__"lantian") ) 
    if((int)room->query_temp("tian_trigger")==1 ) 
     {
       message_vision("现在黑雕正忙着,请过一会再乘坐!\n" , ob) ;
       return 1 ;
     }
    room->set_temp("tian_trigger", 1);
    message_vision("$N一跃身跨上了黑雕。只见黑雕仰天长唳，突然展翅高飞。\n\n"
                   "但看一雕一人身形渐渐缩小，终至不见。\n" , ob );
    ob->move(room) ;
    tell_object(ob, CYN  "\n你不断地飞呀飞，万水千山身下飘过 ......\n\n" NOR ) ;
    call_out("heimuya", 3 , ob );
    room->delete_temp("tian_trigger");
    return 1 ;
}
void heimuya( object ob )
{
  tell_object(ob, "你终于飞到了黑木崖，黑雕落了下来。\n\n"  ) ;
  ob -> move (__DIR__"chengdedian") ; 
}
void reset()
{
    object room;

   // ::reset();
    if( room = find_object(__DIR__"lantian") )
        room->delete("tian_trigger"); 
}