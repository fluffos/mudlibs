inherit NPC;

void create ()
{
	set_name("丁典", ({"ding dian","ding","dian"}));
	set("long", "他是个好汉。\n");
	set("gender", "男性");
	set("age", 24);
	set("combat_exp", 2000000);
	set("str", 28);
	set("int", 28);
	set("dex", 25);
	set("con", 25);
	set("per", 15);
  set("shen", 320000);
  set("neili",5000);
  set("max_neili",4500);
  set("jiali",100);
  set("jingli",1000);
  set("max_qi",5500);
  set("qi",5500);
  set("food",500);
  set("water",500);
  set("max_jingli",1000);
	set_skill("force", 400);
	set_skill("unarmed", 400);
	set_skill("dodge", 350);
	set_skill("yanfly", 350);
	set_skill("literate",100);
set_skill("parry", 400);
	set_skill("shenzhao-jing", 400);
	map_skill("force", "shenzhao-jing");
	map_skill("parry", "shenzhao-jing");
	map_skill("unarmed", "shenzhao-jing");
	map_skill("dodge", "yanfly");
	create_family("连城武馆", 2, "长老");
	setup();
	
	carry_object("/d/city/obj/cloth")->wear();
}
void attempt_apprentice(object ob)
{ if((string)ob->query("family/family_name")!="连城武馆")
{command("say “你还不是本馆弟子。”");
return;}
if(ob->query_skill("shenzhao-jing",1)<150)
  {command("say “你的本门内功心法还未练到家吧。”");
   return;}
	command("say “好吧，我就收你为徒弟了！”");
	command("recruit " + ob->query("id"));
}
