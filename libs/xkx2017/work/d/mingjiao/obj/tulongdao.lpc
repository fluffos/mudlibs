// tulongdao.c

#include <ansi.h>
#include <weapon.h>
inherit BLADE;

void create() {
  set_name(HIY "屠龙刀" NOR, ({ "tulong dao", "dao", "blade" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "武林至尊，宝刀屠龙；号令天下，莫敢不从。\n");
    set("value", 2000000);
    set("material", "steel");
    set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n插回刀鞘。\n");
  }
  init_blade(1000);
  setup();
}
