inherit ROOM;

void init();

void create()
{
        set("short","光明顶大殿");
        set("long", @LONG
走进这里，突感一阵肃穆之意，昆仑山光明顶的明教大殿中十分空旷，
殿顶高悬八盏金灯，两旁是精壮佩剑武士剑气森严逼人。正中设一宝座，
前有一雕花檀木案，案头供明教玄铁令六枚。宝座后立有一扇玉屏，屏
中所画正是明教圣火图，烈焰直逼日月。
LONG
           );
        set("exits",([
            "south" : __DIR__"qiandian",
			"east": __DIR__"neishi",
           ]));
        set("objects",([
			"/kungfu/class/mingjiao/zhangwuji":1,
			__DIR__"npc/xiaozhao": 1,
			]));
        setup();
}
