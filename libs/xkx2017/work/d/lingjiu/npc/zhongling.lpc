// zhongling.c
#include <ansi.h>
inherit NPC;

void create()
{
	set_name("钟灵",({ "zhong ling", "zhong", "ling" }) );
        set("gender", "女性" );
        set("age", 18);
        set("nickname",HIG"小美女"NOR);
        set("long", "她是万劫谷的谷主钟万仇的夫人甘宝宝和大理镇南王段正淳\n的私生女，娇俏窈窕，十分可爱。\n");
//      set("shen", 100);
        set("shen_type", 1);
        set("str", 15);
        set("dex", 18);
        set("con", 15);
        set("int", 17);
        set("combat_exp", 1500);
        set_skill("unarmed",25);
        set_skill("dodge",25);
        set_skill("parry",25);
        set("attitude", "peaceful");
        setup();
        carry_object("/d/village/npc/obj/cloth")->wear();
}

