inherit NPC;

void create()
{
	set_name("红花会弟子", ({ "dizi" }));
	set("gender", "男性");
	set("age", 19);
	set("long", "他是红花会的一名普通弟子。\n");
	
	set("combat_exp", 3000);
	set("shen_type", 1);
    set("qi",500);
	set("max_qi",500);
	set("neili",100);
	set("max_neili",100);
	set("attitude", "peaceful");
	
	set_skill("unarmed", 40);
	set_skill("dodge", 40);
	set_skill("parry",40);

	setup();
	carry_object("/clone/misc/cloth")->wear();
	add_money("silver",80);
}
