#include <ansi.h>
#include <weapon.h>
inherit CLUB;

void create()
{
     set_name(HIY"金"HIM"箍"HIC"棒"NOR, ({ "jingu bang","bang","club"}));
        set_weight(1000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "根");
                set("long", "这莫非就是传说中齐天大圣孙悟空使用的如意金箍棒吗？如何收走它呢？\n");
                set("value", 1000000);
                set("material", "steel");
                set("no_get", 1);
                set("no_drop", 1);
                set("no_give","你舍得送人吗？\n");
                set("wield_msg", "$N抽出一根$n握在手中。\n");
                set("unwield_msg", "$N将手中的$n插回腰间。\n");
        }
        init_club(2000);
        setup();
}
void init()
{
	add_action("do_shout", "shout");
}
int do_shout(string arg)
{
        object me;
        me = this_player();
	if (!arg || (arg != "小小小") )
		return 0;
		message_vision("你对着"+this_object()->name()+"大喊一声“小小小！”\n",me);
		message_vision(this_object()->name()+"突然变小飞到你的耳朵里了。\n", me);
		this_object()->move(me);
return 1;
}
