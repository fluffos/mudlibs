// xiaoyuan.c 后山小院
// by Xiang
#include <ansi.h>
#include <room.h>
inherit ROOM;

void create()
{
	set("short", "金殿");
	set("long", @LONG
	这是后山的一座小院，布置简简单单，除了一床、一桌、一椅、一蒲团，
再也没有别的什物。比较引人注目的是墙上挂着一把剑。这里就是武当开山祖师
张三丰的练功所在。因为这里是张三丰常住的地方，人们把这里叫做金殿。张三丰
经常从这里飞升（jump）进入天堂（sky）。
LONG
	);
 set("item_desc", ([
 "sky": "天堂虚无缥缈，难以目视。\n",
 	]));
	set("exits", ([
		"south" : __DIR__"xiaolu2",
	]));
	set("objects", ([
		CLASS_D("wudang") + "/zhang" : 1 ]));
	create_door("south", "竹门", "north", DOOR_CLOSED);
	set("valid_startroom", 1);
	setup();
}
void init()
{
	add_action("do_jump", "jump");
}
int do_jump(string arg)
{
       object me;
       me = this_player();
      if( !arg || (arg!="sky" ))
              return notify_fail("你要往哪儿飞?\n");       
      if ( present("zhang sanfeng",environment(me)))
       {
        message_vision(YEL"张三丰双手一拦，道：“升天很危险，一不小心就会下地狱！”\n" NOR,me) ;
        return notify_fail("你无奈地耸耸肩。\n");
        }
       if((int)me->query_dex()<70)
      {if(!wizardp(me)) me->die(); else message_vision("你的轻功太低了。\n",me);}
       else
       {me->move("/d/wudang/tiantang");
       message_vision("$N飞升到了天堂。\n",me );
       }
       return 1;     
}
