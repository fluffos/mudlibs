inherit ITEM;
void setup() {}
void init() {
  add_action("do_du", "study");
}
void create() {
  set_name("「九阴真经」上册", ({ "jiuyin zhenjing1", "zhenjing1", }));
  set_weight(400);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "这就是武林人士梦寐以求的《九阴真经》，相传乃黄裳所著。\n");
    set("value", 30000);
    set("material", "paper");
  }
}
int do_du(string arg) {
  object me = this_player();
  object where = environment(me);
  mapping skill;
  int jiuyinlvl;
  int neili_lost;

  if (!(arg == "jiuyin zhenjing1" || arg == "zhenjing1"))
    return 0;

  if (where->query("pigging")) {
    write("你还是专心拱猪吧！\n");
    return 1;
  }
  if (me->is_busy()) {
    write("你现在正忙着呢。\n");
    return 1;
  }

  if (me->is_fighting()) {
    write("你无法在战斗中专心下来研读新知！\n");
    return 1;
  }

  if (!id(arg)) {
    write("你要读什么？\n");
    return 1;
  }

  if (!me->query_skill("literate", 1)) {
    write("你是个文盲，先学点文化(literate)吧。\n");
    return 1;
  }
  if (me->query_skill("jiuyang-shengong", 1)) {
    write("普通阴阳内功融合已属罕见，能融合九阴九阳者绝无一人！\n");
    return 1;
  }
  message("vision", me->name() + "小心翼翼翻出一本书在读。\n", environment(me), me);

  if ((int)me->query("jing") < 15) {
    write("你现在过于疲倦，无法专心下来研读新知。\n");
    return 1;
  }

  if (me->query_skill("jiuyin-shengong", 1) > 84) neili_lost = 15;
  else if (me->query_skill("jiuyin-shengong", 1) > 74) neili_lost = 10;
  else neili_lost = 5;


  if ((int)me->query("neili") < neili_lost) {
    write("你内力不够，无法钻研这么高深的武功。\n");
    return 1;
  }

  jiuyinlvl = me->query_skill("jiuyin-shengong", 1);
  if ((int)me->query("combat_exp") < (int)jiuyinlvl * jiuyinlvl * jiuyinlvl / 10) {
    write("你的实战经验不足，再怎么读也没用。\n");
    return 1;
  }

  if (me->query_skill("jiuyin-shengong", 1) > 99) {
    write("你研读了一会儿，但是发现上面所说的对你而言都太浅了，没有学到任何东西。\n");
    return 1;
  }

  me->receive_damage("jing", 15);
  me->set("neili", (int)me->query("neili") - neili_lost);
  if (!me->query_skill("jiuyin-shengong", 1)) {
    me->set_skill("jiuyin-shengong", 0);
    write("                   《九阴真经》阅读指南\n"
      "\n    恭喜你开始研习九阴真经！\n"
      "         祝你早日成为武林第一高手，称霸天下！\n");
  }
  me->improve_skill("jiuyin-shengong", (int)me->query_skill("literate", 1) / 3 + 1);
  write("你研读《九阴真经》，似乎有点心得。\n");
  return 1;
}
