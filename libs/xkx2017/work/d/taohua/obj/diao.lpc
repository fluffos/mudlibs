// item: /d/taohua/obj/diao.c
// Jay 3/17/96

inherit ITEM;
void setup()
{}

void init()
{
        add_action("do_ride", "ride");
}

void create()
{
        set_name("大雕", ({"da diao"}));
        set_weight(10);
        //set_max_encumbrance(50000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "只");
                set("long", "一只凶狠的大雕，骑上它可以到处飞（fly）。\n");
                set("value", 100000);
        }
}

int do_ride(string arg)
{
	object me = this_player();
        if (!id(arg))
                return notify_fail("你要骑什么？\n");
        if (this_player()->query_temp("marks/骑") ) {
                       write("你已经骑在雕上了。\n");
                        return 1;
        }
        else {
               message("vision",this_player()->name() + "翻身上雕。\n",
                        environment(me), ({me}) );
               write("你忐忑不安地爬上雕背。\n");
                this_player()->set_temp("marks/骑", 1);
        return 1;
        }
}
