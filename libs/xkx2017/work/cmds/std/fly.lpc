//cglaem...12/17/97.

#include <ansi.h>

int main(object me, string arg) {
  string loc;
  int mana_cost;
  object ridee, map, wing;
  string ridemsg;

  seteuid(getuid());

  wing = present("wing", me);

  if (me->is_fighting())
    return notify_fail("你正在战斗，飞不开。\n");
  /*
   if( me->is_busy() || me->query_temp("pending/exercising"))
                return notify_fail("你正忙着呢，没工夫御雕飞行。\n");
*/
  if (me->is_ghost())
    return notify_fail("做了鬼了，就老实点吧！\n");
  if (!arg)
    return notify_fail("你要飞到哪里去？\n");

  if (!present("da diao", me)) {
    return notify_fail("你没有雕，怎么飞行？\n");
  }

  /*
        if( (int)me->query("jing") * 100 / (int)me->query("max_jing") < 50 )
                return
notify_fail("你现在头脑不太清醒，当心掉下来摔死。\n");

        if( (int)me->query("qi") * 100 / (int)me->query("max_qi") < 50 )
                return
notify_fail("你想飞起来，可是体力似乎有点不支。\n");
*/

  message_vision(HIR "$N跨上雕背，大叫一声：我去耶！！！\n" +
    "只见大雕越上云宵，飞翔而去......\n\n" NOR, me);
  if (arg == "yangzhou") loc = "/d/city/guangchang";
  else if (arg == "shaolin") loc = "/d/shaolin/shanmen";
  else if (arg == "wudang") loc = "/d/wudang/guangchang";
  else if (arg == "gaibang") loc = "/d/city/pomiao";
  else if (arg == "taohua") loc = "/d/taohua/tingzi";
  else if (arg == "gumu" || arg == "quanzhen") loc = "/d/zhongnan/shanjiao";
  else if (arg == "emei") loc = "/d/emei/shanjiao";
  else if (arg == "xiakedao") loc = "/d/xiakedao/haitan";
  else if (arg == "mingjiao") loc = "/d/mingjiao/shanjiao";
  else if (arg == "beijing") loc = "/d/city2/tian_anm";
  else if (arg == "xueshan") loc = "/d/xueshan/shanmen";
  else if (arg == "xingxiu") loc = "/d/xingxiu/xxh1";
  else if (arg == "shenlong") loc = "/d/shenlong/haitan";
  else if (arg == "baituo") loc = "/d/baituo/damen";
  else if (arg == "tianlong") loc = "/d/tianlongsi/damen";
  else if (arg == "xiaoyao") loc = "d/xiaoyao/xiaodao4";
  else if (arg == "riyue") loc = "/d/heimuya/guang";
  else if (arg == "lingjiu") loc = "/d/lingjiu/dadao1";
  else if (arg == "huashan") loc = "/d/huashan/path1";
  else if (arg == "honghua") loc = "/d/honghua/lianwuchang";
  else if (arg == "liancheng") loc = "/d/wuguan/damen";
  else if (arg == "taishan") loc = "/d/taishan/yitian";
  else if (arg == "jiaxing") loc = "/d/quanzhou/jiaxing";
  else if (arg == "tianshan") loc = "/d/xingxiu/shanjiao";
  else if (arg == "heimuya") loc = "/d/heimuya/chengdedian";
  else if (arg == "quanzhou") loc = "/d/quanzhou/beimen";
  else if (arg == "guiyun") loc = "/d/taohua/zhangqian";
  else {
    write("\n\n到了！你按下雕背跳了下来。\n");
    write("咦？．．．怎么还在原来的地方？\n");
    return 1;
  }

  if (!loc)
    return 1;

  me->move(loc);
  write("\n\n到了！你按下雕背跳了下来。\n");

  message_vision(HIR "\n天上一道雕影闪过，$N不知道什么时候已经站在面前。 \n"
    NOR, me);
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : fly|[目的地]
当你有了雕时，就可以御雕飞行。

目前你可以飞到的地方：
yangzhou        ->扬州城                 beijing        ->北京城
shaolin         ->少林寺                 wudang         ->武当山
gaibang         ->丐帮                   taohua         ->桃花岛
gumu            ->古墓                   quanzhen       ->全真教
emei            ->峨眉山                 xiakedao       ->侠客岛
mingjiao        ->明教                   xueshan        ->雪山寺
xingxiu         ->星宿海                 shenlong       ->神龙教
baituo          -白驼山                  tianlong       ->天龙寺
xiaoyao         ->逍遥派                 riyue          ->日月神教
lingjiu         ->灵鹫宫                 huashan        ->华山
honghua         ->红花会                 liancheng      ->连城武馆
taishan         ->泰山                   jiaxing        ->嘉兴城
tianshan        ->天山                   heimuya        ->黑木崖
quanzhou        ->泉州城                 guiyun         ->归云山庄

HELP
  );
  return 1;
}
