// surrender.c
inherit F_CLEAN_UP;

#include <ansi.h>



int main(object me, string arg) {
  int i;
  object ob;

  if (!me->is_fighting())
    return notify_fail("投降？现在没有人在打你啊....？\n");

  ob = me->query_temp("last_opponent");
  if (objectp(ob) && ob->is_killing(me->query("id")) &&
    living(ob) && !ob->query_temp("noliving")) {
    message_vision("$N向$n求饶，但是$N大声说道：" + RANK_D->query_rude(me) + "废话少说，纳命来！\n", ob, me);
    return 1;
  }
  i = random(5);
  if (i != 3) {
    me->remove_all_enemy();
    if ((int)me->query("score") >= 50)
      me->add("score", -50);
    else
      me->set("score", 0);
    message_vision(HIW "\n$N说道：「不打了，不打了，我投降....。」\n\n" NOR, me);
    return 1;
  } else
    message_vision(HIC "\n$n高举双手投降，但是$N毫不理睬，打得更起劲了。\n\n" NOR, ob, me);
  return 1;
}
int help(object me) {
  write(@HELP
指令格式 : touxiang
 
    这个指令可以让你向敌人投降而终止战斗。
 
HELP
  );
  return 1;
}
