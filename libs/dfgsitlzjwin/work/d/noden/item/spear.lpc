#include <mudlib.h>

inherit WEAPON;

void create()
{
	seteuid(getuid());
	set_name( "short spear", "短矛" );
	add( "id", ({ "spear" }) );
   set_short( "短矛" );
	set_long(
		"一把很短的矛，它的尖端是用石头磨尖而成的。\n"
	);
	set( "unit", "把" );
	set( "type", "polearm" );
	set( "weapon_class", 6 );
	set( "min_damage", 3 );
	set( "max_damage", 8 );
	set( "weight", 40 );
	set( "value", ({ 20, "silver" }) );
}
