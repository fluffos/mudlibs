#include <mudlib.h>

inherit OBJECT;

void create()
{
         seteuid(getuid());
	set_name( "list", "排行榜" );
	set_short( "玩家排行榜" );
	set_long( (string)"/adm/daemons/topplayer"->get_list(),
			  (string)"/adm/daemons/topplayer"->get_list(1) );
	set( "unit", "卷" );
	set( "weight", 5 );
	set( "value", ({ 5, "silver" }) );
	set( "useless", 1 );
//	set( "prevent_get", 1 );
}
