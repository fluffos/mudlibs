#pragma save_binary

#include <mudlib.h>

inherit DAEMON;

int cmd_ignore( string a )
{
  string * ignore;
  int i;

  ignore = this_player()-> query( "ignore" );
  if( !pointerp( ignore ) ) ignore = ({ });
  if( !a )
  {
    if( !sizeof( ignore ) ) write( "You are ignoring no-one.\n" );
    else write( wrap( "You are ignoring: " + implode( ignore, ", " ) ) );
    return 1;
  }
  if( -1 == member_array( a, ignore ) )
  {
    write( "You are now ignoring " + a + "\n" );
    ignore += ({ a });
  } else {
    write( "You are now no longer ignoring " + a + "\n" );
    ignore -= ({ a });
  }
  this_player()-> set( "ignore", ignore );
  return 1;
}

int help()
{
  write(
    "Syntax: ignore [<name>]\n"+
    "Effect: ignore on its own lists the names you are ignoring\n"+
    "if you give a name then it toggles whether you are ignoring that name.\n"+
    "A name can be that of a user or @mud or user@mud\n"+
    "Ignoring someone blocks their tells, unless they are an admin.\n"
  );
  return 1;
}
