#pragma save_binary
#include <mudlib.h>
inherit DAEMON;

int cmd_say(string str)
{
	if (!str) {
	write("你自言自语.\n");
	say( this_player()->query("c_name")+"自言自语的不知道在说什麽.\n");
	return 1;
	}
	printf( "你说道：%s\n",str);
	say( this_player()->query("c_name") + "说道：" + str + "\n");

	return 1;
}
 
int help()
{
	write( "指令格式：say <讯息>\n" );

	return 1 ;
}
