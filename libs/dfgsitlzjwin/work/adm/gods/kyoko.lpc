#include <races.h>

inherit RACE_GOD;

void create()
{
	::create();
	seteuid(getuid());
	set_level(19);
	set_name( "kyoko", "响子" );
	add ("id", ({ "god" }) );
	set_short( set_color("一刻馆管理人 音无响子", "HIM") );
	set_long("音无响子是个十分美丽的女人，长长的秀发和迷人的身材，不知迷倒了多少人。\n"
	);
	set( "gender", "female" );
	set_perm_stat( "str", 30 );
	set_perm_stat( "int", 30 );
	set_perm_stat( "dex", 30 );
	set_perm_stat( "con", 30 );
	set_perm_stat( "pie", 30 );
	set_perm_stat( "kar", 30 );

	set_skill( "blunt", 100 );
	set_skill( "parry", 100 );
	set_skill( "dodge", 100 );

	set( "max_hp", 65535 );
	set( "hit_points", 65535 );
	set( "max_sp", 65535 );
	set( "spell_points", 65535 );
	set( "max_fp", 655350 );
	set( "force_points", 655350 );
	set( "wealth/platinum", 1 );
	set( "exp_reward", 1 );

	set_natural_weapon( 200, 50, 100 );
	set_natural_armor( 500, 500 );
	set( "special_defense", ([ "all": 100, "none" : 100 ]) );
	
	set( "tactic_func", "add_explore" );

//	wield_weapon( "/u/k/kyoko/obj/kyoko_broom" );
//	equip_armor( "/u/k/kyoko/obj/kyoko_robe" );
}

int add_explore()
{
	object victim;

	if( victim = query_attacker() ) victim->set_explore("noden#19");
    return 0;
}
