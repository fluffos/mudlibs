// Pill: hedinghong.c
#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIG "摇摇" NOR, ({ "yao yao", "wan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一颗诱人的小丹,食后让人兴奋不已，男欢女爱之用. \n");
    set("unit", "颗");
    set("value", 20000);
  }
  setup();
}

int init() {
  add_action("do_eat", "eat");
}

int do_eat(string arg) {
  object me = this_player();

  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  if (arg == "wan" || arg == "yao yao") {
    message_vision("$N仰头把摇摇拍到嘴里" + name() + "。\n", me);
    me->faint();
    destruct(this_object());
  }
  return 1;
}
