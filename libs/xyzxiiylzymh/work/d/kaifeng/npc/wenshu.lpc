	map_skill("force", "hunyuan-yiqi");
	map_skill("dodge", "shaolin-shenfa");
	map_skill("cuff", "luohan-quan");
	map_skill("blade", "xiuluo-dao");
prepare_skill("cuff", "luohan-quan");



	set("inquiry", ([
	]));

