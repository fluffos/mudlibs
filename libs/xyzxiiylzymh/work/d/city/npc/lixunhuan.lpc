// master.c
inherit NPC;
inherit F_MASTER;
#include <ansi.h>
void create()
{
    set_name("李寻欢", ({ "li xunhuan", "li", "xunhuan" }) );
        set("nickname", RED"小李飞刀"NOR);
        set("gender", "男性" );
        set("age", 44);
        set("str", 30);
        set("cor", 30);
        set("cps", 30);
        set("int", 30);
	set("per", 30);
            set("shen_type", 1);
	set("attitude","friendly");
        set("max_force", 15000);
        set("force", 15000);
	set("courage",1000);
        set("force_factor", 3);

        set("rank_info/respect", "李探花");

        set("long",
"李寻欢别号李探花，又有江湖绰号小李飞刀。
一手飞刀绝技，在百晓生的兵器谱上排行第三。
不发则已，但例无虚发。\n"                
	);
        create_family("风云一刀", 1, "人杰");
	set("student_title","人杰");
        set("combat_exp", 100000000);
        set("score", 200000);

        set("chat_chance", 10);
        set("chat_msg", ({
                "李寻欢不停的在咳，嘴角流下一丝鲜血。\n",
                "李寻欢的脸色越发苍白了。\n",
"李寻欢叹口气，呆呆地望着手里的木像。\n",
        }) );
        set_skill("parry", 2000);
        set_skill("dodge", 2400);
        set_skill("throwing", 500);
	set_skill("feidao", 500);
        set_skill("force", 2000);
             set_skill("yijing-force", 500);
        set_skill("literate", 1000);
              set_skill("piaoxiang-bufa", 1000);
         map_skill("throwing", "feidao");
              map_skill("dodge", "piaoxiang-bufa");
              map_skill("parry", "feidao");
                        map_skill("force", "yijing-force");              
            set("max_jing", 25000);
        set("neili", 100000); 
        set("max_neili", 50000);
        set("jiali", 5000);
set("chat_chance_combat", 999);
    set("chat_msg_combat", ({
        (: perform_action, "throwing.zhenxl_feidao" :),
        (: perform_action, "dodge.zonghengsihai" :),
        (: exert_function, "recover" :),
        (: exert_function, "heal" :),
    }) );
    setup();
        carry_object(__DIR__"obj/whitecloth")->wear();
}
void attempt_apprentice(object ob)
{
    if (mapp(ob->query("family"))  &&   (string)ob->query("family/family_name") != "风云一刀")
    {
        command("say " + RANK_D->query_respect(ob) + "既然已有名师指点，何必又来学飞刀呢？");
        return;
    }
    if (((int)ob->query_skill("throwing",1) < 2300) || ((int)ob->query_skill("feidao",1) < 10))
    {
        command("say 我看" + RANK_D->query_respect(ob) + "的暗器使用还没学到家,不适宜学飞刀。");
        return;
    }
    if (((int)ob->query_skill("force",1) < 2700) || ((int)ob->query_skill("yijing-force",1) < 150))
    {
        command("say 我看" + RANK_D->query_respect(ob) + "的内功太差了,不适宜学飞刀。");
        return;
    }
    if (((int)ob->query_skill("dodge",1) < 1700) || ((int)ob->query_skill("piaoxiang-bufa",1) < 300))
    {
        command("say 我看" + RANK_D->query_respect(ob) + "的轻功还没学到家，来学飞刀小心伤了自己。");
        return;
    }
    if ( (int)ob->query_skill("literate",1) < 4800)
    {
        command("say 我看" + RANK_D->query_respect(ob) + "的读书识字太差，我不能收你。");
        return;
    }
    if ((int)ob->query("shen") < 100000)
    {
        command("say 我对收徒要求极严。");
        command("say 在德行方面，" + RANK_D->query_respect(ob) +
            "是否还做得不够？");
        return;
    }
    command("say 好吧，我就收下你了。");
    command("recruit " + ob->query("id"));
}
void heart_beat()
{
object feidao;
if(!query_temp("weapon") && is_fighting())
{
	feidao = new(__DIR__"obj/xlfd_knife");
	feidao->move(this_object());
	command("wield flying blade");
WEAPON_D->throw_weapon(this_object(),feidao,0);            
return;
}
else
return ::heart_beat();
}
