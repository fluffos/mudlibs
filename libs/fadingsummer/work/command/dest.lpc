/* Synopsis: This file contains the code for the dest command. */

inherit COMMAND_OB;

// function: create()
// purpose: This function initializes the object.  In this case, it adds
//          two rules to the parser and refreshes the parser's cache for
//          this object.

void create()
{
   command::create();
   parse_add_rule("dest", "OBJ");
   parse_add_rule("dest", "OBS");
   parse_refresh();
}

// function: can_dest*
// purpose: These are applies allowing this object to 'do' the rules
//          added to the parser.

int can_dest_obj() { return 1; } // this covers plural and singular rule

// function: do_dest*
// purpose: These functions actually carry out the rules.

void do_dest_obj(object ob, string ob_text) // we don't care about ob_text
{                                           // with this function.
   ob->remove();
   if(ob) destruct(ob);
}

void do_dest_obs(object *obs, string obs_text)
{
   foreach(object ob in obs)
   {
      if(interactive(ob) || environment(ob) != environment(this_player())) continue;
      ob->remove();
      if(ob) destruct(ob);
   }
}

// function: query_syntax()
// purpose: This function exists to provide an alternative to the
//          'You cannot use that command that way' error message.
//          It should be contained in all commands.

string query_syntax()
{
   return "Usage: dest <object(s)>";
}
