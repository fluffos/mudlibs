/* Synopsis: This file contains the rule for the quit command. */

inherit COMMAND_OB;

void create()
{
   command::create();
   parse_add_rule("quit", "");
   parse_add_rule("quit", "STR");
   parse_refresh();
}

int can_quit()     { return 1; }
int can_quit_str() { return 1; }

void do_quit()
{
   message(M_SYSTEM, "See you again soon!\n", this_player());
   if(environment(this_player()))
      message(M_SYSTEM, capitalize((string) this_player()->query_name()) + " leaves this reality.\n", environment(this_player()),this_player());
   this_player()->remove();
}

void do_quit_str(string arg)
{
   message(M_SYSTEM, "See you again soon!\n", this_player());
   if(environment(this_player()))
      message(M_SYSTEM, capitalize((string) this_player()->query_name()) + " leaves this reality, saying \""+arg+"\"\n", environment(this_player()), this_player());
   this_player()->remove();
}
