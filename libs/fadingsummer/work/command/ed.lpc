// date:   18-6-2001

/* Synopsis: This file will contain the parser rules for the various
             invocations of the 'ed' and 'edob' commands.
*/

inherit COMMAND_OB;

// function: create()
// purpose: This function initializes the object.  In this case, it adds
//          some rules to the parser and resets the parser's cache on
//          the object.

void create()
{
   command::create();
   parse_add_rule("ed", "");
   parse_add_rule("ed", "STR");
   parse_add_rule("edob", "OBJ");
   parse_refresh();
}

// function: can_*
// purpose: These are applies that indicate this object can support the
//          rules it provides.

int can_ed()        { return 1; }
int can_ed_str()    { return 1; }
int can_edob_obj()  { return 1; }

// function: do_*
// purpose: These are the functions that actually carry out the work
//          required for each rule.

void do_ed()
{
   this_player()->start_ed("");
}

void do_ed_str(string arg)
{
   this_player()->start_ed(arg);
}

void do_edob_obj(object ob, string ob_text)
{
   message("blah", ob_text+"\n", this_player());
   this_player()->start_ed(c_name(ob));
}
