/* Synopsis: This file contains the shutdown command which is used to
   initiate a system shutdown.
*/

inherit COMMAND_OB;

void create()
{
   command::create();
   parse_add_rule("shutdown","");
   parse_refresh();
}

int can_shutdown()  { return 1; }

void do_shutdown()
{
   shutdown(0);
}
