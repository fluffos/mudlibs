/* Synopsis: This program holds the user connection as it logs onto
   the system.
*/

void catch_tell(string str) {
    receive(str);
}

// function: logon()
// purpose: This function is called upon user connection by the
// master object.  It actually _is_ the user object until exec()
// is called to pass the user's connection to the real user object.

void logon()
{
    object user;
    
    seteuid(getuid(this_object()));
    user = clone_object(USER_OB);
    exec(user, this_object());
    call_other(LOGON_D, "logon", user);
    destruct(this_object());
}
