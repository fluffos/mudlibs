// mudlib: Fading Summer
// file:   user.c
// author: Lontau
// date:   15-6-2001
// Museum 2026-11-10: alpha never finished ed/parser/query_name; keep a
// minimal body that can register, land in the void, look, and quit.

inherit BASE_OB;

void catch_tell(string str) {
    receive(str);
}

int id(string arg) {
    return base::id(arg);
}

mixed process_input(string arg) {
    // Return 0 so add_action verbs still run.
    return 0;
}

void create() {
    base::create();
    seteuid(0);
}

void receive_message(string msgclass, string msg) {
    receive(msg);
}

string query_save_file() {
    string n;
    n = query("name");
    if (!stringp(n) || n == "" || n == "UNDEFINED")
        return 0;
    n = lower_case(n);
    return USER_DATA_DIR + "/" + n[0..0] + "/" + n;
}

int save() {
    string file, letter;
    mapping data;
    string *k;
    int i;

    file = query_save_file();
    if (!file)
        return 0;
    letter = lower_case(query("name"))[0..0];
    if (file_size(USER_DATA_DIR) != -2)
        mkdir(USER_DATA_DIR);
    if (file_size(USER_DATA_DIR + "/" + letter) != -2)
        mkdir(USER_DATA_DIR + "/" + letter);

    data = ([]);
    k = keys(object_data);
    for (i = 0; i < sizeof(k); i++)
        data[k[i]] = object_data[k[i]];
    write_file(file + __SAVE_EXTENSION__, save_variable(data), 1);
    return 1;
}

int restore() {
    string file, raw;
    mapping data;
    string *k;
    int i;

    file = query_save_file();
    if (!file)
        return 0;
    raw = read_file(file + __SAVE_EXTENSION__);
    if (!raw)
        return 0;
    data = restore_variable(raw);
    if (!mapp(data))
        return 0;
    k = keys(data);
    for (i = 0; i < sizeof(k); i++)
        set(k[i], data[k[i]], 1);
    return 1;
}

void startup() {
    object void_ob;
    string n;

    n = query("name");
    if (!stringp(n) || n == "" || n == "UNDEFINED")
        return;
    seteuid(ROOT_UID);
    restore();
    seteuid(n);
    void_ob = find_object(VOID_OB);
    if (!void_ob)
        catch(void_ob = load_object(VOID_OB));
    if (void_ob)
        move_object(void_ob);
    write("Welcome to Lore of the Fading Summer.\n");
    write("You are in the void. Type 'look' or 'quit'.\n");
    enable_commands();
    add_action("cmd_quit", "quit");
    add_action("cmd_look", "look");
}

int cmd_quit(string arg) {
    save();
    write("Goodbye.\n");
    destruct(this_object());
    return 1;
}

int cmd_look(string arg) {
    write("You are floating in the void of an unfinished mudlib.\n");
    return 1;
}
