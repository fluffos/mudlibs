/* Synopsis: This object is inheritted by all daemons. */

// prototypes
int check_save_dir(string filename);
int make_save_dir(string filename);

// functions

// function: check_save_dir(string)
// purpose: This function checks whether or not the specified
//          directory exists under the DATA_DIR and returns an
//          integer representing the state of the filename,
//          whether it is non-existant, a file, or a directory.

int check_save_dir(string filename)
{
   if(file_size(DATA_DIR+"/"+filename) == -2) return 1;
   if(file_size(DATA_DIR+"/"+filename) >=  0) return -1;
   else return 0;
}

// function: make_save_dir(string)
// purpose: This function simply creates the specified directory
//          under the DATA_DIR and returns whether or not it
//          succeeded.

int make_save_dir(string filename)
{
   return mkdir(DATA_DIR+"/"+filename);
}
