/* Synopsis: This file is included in the base object.  It includes
   applies that make it possible for any object to be the target
   of 'dest', 'edob', and other commands.  These applies will always
   be true for any object that inherits the base object.
*/

mixed direct_dest_obj(object ob, string ob_text)   { return 1; }
mixed direct_edob_obj(object ob, string ob_text)   { return 1; }
mixed direct_update_obj(object ob, string ob_text) { return 1; }
mixed direct_renew_obj(object ob, string ob_text)  { return 1; }

