/* Synopsis: This is the mud's base object.  All objects that are to be
   accessible in a physical sense in the mud should inherit this object.
   If an object is not meant to be cloned and is meant instead to be
   a supporting object such as a daemon or other program, it should not
   inherit this object.  This object provides much of the functionality
   that should be found in every object.
*/

// #include "parsing_applies.lpc"
#include "object_data.lpc"

void remove()
{
   destruct(this_object());
}

int move(mixed dest)
{
   move_object(dest);
}

int id(string arg)
{
   mixed ids;

   if (!arg) {
      return 0;
   }

   ids = query("id");

   if(!arrayp(ids))
      return 0;

   return (member_array(arg, ids) != -1);
}

void create()
{
   // Museum: parsing applies never finished; skip parse_init().
}
