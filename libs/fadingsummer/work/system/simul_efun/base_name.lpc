string base_name(mixed obj) {
    string name, base;

    if (objectp(obj)) name = file_name(obj);
    else name = obj;
    if (name && sscanf(name, "%s#%*d", base) == 2) {
	return base;
    } else {
	return name;
    }
}

// Tal 04-04-2001
// Returns the real file name of an object

string c_name(mixed obj)
{
    string name, base;
    if (!obj)
	return 0;
    if (objectp(obj))
	name = file_name(obj);
    else
	name = obj;
    if (name && sscanf(name, "%s#%*d", base) == 2)
	return base +".lpc";
    else 
    { /// This is for when 'obj' is a string
	if (name[<2..] != ".lpc")
	    name+=".lpc";
	return ( (file_size(name) >= 0) ? name : 0);
    }
}
