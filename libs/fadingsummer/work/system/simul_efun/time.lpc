// Museum: param was named `time` but body used specified_time.

#include <driver/localtime.h>

varargs string log_formatted_time(int specified_time)
{
   mixed arr_time;

   if (!specified_time) specified_time = time();
   arr_time = localtime(specified_time);

   return sprintf("[%d/%d/%d, %d:%d.%d] ", arr_time[LT_MDAY], arr_time[LT_MON] + 1,
                                           arr_time[LT_YEAR], arr_time[LT_HOUR],
                                           arr_time[LT_MIN],  arr_time[LT_SEC] );
}
