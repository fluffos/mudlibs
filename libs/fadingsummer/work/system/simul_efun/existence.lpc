/* Synopsis: This file contains simul_efuns that deal with existence,
   such as the existence of a file or user or whatever.
*/

// function: file_exists(string)
// purpose: This function determines whether or not a given filename
//          points to an existing file by the return value of file_size()

int file_exists(string file)
{
   return (file_size(file) >= 0);
}

// function: directory_exists(string)
// purpose: This function determines whether or not a directory exists
//          based on the return value of file_size()
 
int directory_exists(string dirname)
{
   return (file_size(dirname) == -2);
}
