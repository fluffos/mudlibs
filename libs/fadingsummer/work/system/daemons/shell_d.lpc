// Museum stub: Fading Summer never shipped SHELL_D.
// Passkeys live on the user save file under USER_DATA_DIR.
inherit DAEMON_OB;

#include <paths.h>

void create() {
   seteuid(ROOT_UID);
}

varargs mixed query(string name, mixed keys) {
   string file;
   mapping data;
   mixed *want;
   mixed *out;
   int i;

   if (!name || name == "")
      return 0;
   file = USER_DATA_DIR + "/" + name[0..0] + "/" + name + __SAVE_EXTENSION__;
   if (file_size(file) < 0)
      return 0;
   data = restore_variable(read_file(file));
   if (!mapp(data))
      return 0;
   if (!keys)
      return data;
   if (stringp(keys))
      want = ({ keys });
   else if (arrayp(keys))
      want = keys;
   else
      return 0;
   out = allocate(sizeof(want));
   for (i = 0; i < sizeof(want); i++)
      out[i] = data[want[i]];
   return out;
}

int user_exists(string name) {
   string file;
   if (!name || name == "")
      return 0;
   name = lower_case(name);
   file = USER_DATA_DIR + "/" + name[0..0] + "/" + name + __SAVE_EXTENSION__;
   return file_size(file) >= 0;
}
