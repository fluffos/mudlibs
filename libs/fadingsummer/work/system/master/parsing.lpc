/* Synopsis: This file contains all the applies related to the natural
   language parsing package that are required to be in the master
   object.  This file is meant to be included in the master object.
*/

#include <driver/parser_error.h>

// function: parse_command_id_list()
// purpose: This apply should return an array of strings that are singular
//          nouns that can refer to any object.

string *parse_command_id_list()
{
   return ({ "thing", "it" });
}

// function: parse_command_adjectiv_id_list()
// purpose: This apply should return an array of strings that are
//          adjectives that can refer to any object.

string *parse_command_adjectiv_id_list()
{
   return ({ "a", "an", "the" });  // this may be redundant; the driver may
                                   // automatically parse articles.
}

// function: parse_command_plural_id_list()
// purpose: This apply should return an array of strings that can be
//          used to refer to any collection of objects.

string *parse_command_plural_id_list()
{
   return ({ "things", "them", "everything", "those" });
}

// function: parse_command_prepos_list()
// purpose: This apply provides a list of prepositions that can be
//          used to build rules for commands within the mudlib.  If
//          the preposition is not in this list, it cannot be used in
//          a rule.

string *parse_command_prepos_list()
{
   return ({ "about", "above", "across", "after", "against", "along",
             "among", "around", "at", "before", "behind", "below",
             "beneath", "beside", "between", "beyond", "by", "down",
             "during", "for", "from", "in", "inside", "into", "of",
             "on", "onto", "over", "since", "under", "underneath",
             "up", "upon", "with", "within", "without" });
                                             // THAT'S A LONG LIST!
}

// function: parse_command_all_word()
// purpose: This apply returns a string that contains the one word that
//          can be used to refer to all the objects in a particular
//          environment.

string parse_command_all_word()
{
   return "all";
}

// function: parse_command_users()
// purpose: This apply is used to determine which objects are to be
//          considered living objects by the parser.  A good idea
//          for this apply would be to return users().

object *parse_command_users()
{
   return users();
}

// function: refresh_parse()
// purpose: This function will give other objects a chance to force
//          the parser to clear the cache for the master object,
//          causing the data from these applies (especially the
//          parse_command_users() apply, which needs reconsidered
//          everytime someone logs in or out).

void refresh_parse()
{
   parse_refresh();
}

// function: parser_error_message(int, object, mixed, int)
// purpose: This function is used to generate intelligent error messages
//          when a parsing rule is 'nearly matched'.  With some tweaking,
//          this function could allow for perfectly matching error messages
//          all of the time.  (Or so I've heard.)

string parser_error_message(int error, object ob, mixed arg, int plural)
{
   switch(error)
   {
      case ERR_IS_NOT:
         return capitalize(arg) + " is not here.\n";

      case ERR_ALLOCATED:
         return "Parse allocated error " + arg + ".\n";

      case ERR_THERE_IS_NO:
         return "There is no " + arg + " here.\n";

      case ERR_ORDINAL:
         arg = -arg - 1;
         if( arg > 1 )
            return "There are only " + number_word(arg) + " of them.\n";
         else
            return "There is only one of them.\n";

      case ERR_NOT_ACCESSIBLE:
         if (plural)
            return "They are out of your reach.\n";
         else
            return "That is out of your reach.\n";

      case ERR_NOT_LIVING:
         if (plural)
            return "The " + pluralize(arg) + " are not alive.\n";
         else
            return "The " + arg + " is not alive.\n";

      case ERR_AMBIG:
         return "Which of the " + arg + " do you mean?\n";

      case ERR_BAD_MULTIPLE:
         return "You can only do that to one thing at a time.\n";

      case ERR_MANY_PATHS:
         return "Parse many paths error " + arg + ".\n";
   }
}
