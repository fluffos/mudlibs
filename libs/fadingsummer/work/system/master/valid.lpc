/* Synopsis: This file contains the 'valid_*' applies for the master
   object.  They were moved into this file to make the master object
   more readable. This file is meant to be included in the master
   object.
*/

// function: valid_shadow(object)
// purpose: This function determines whether or not an object is allowed
//          to shadow another object.

int valid_shadow(object ob)
{
    if (getuid(ob) == ROOT_UID) {
        return 0;
    }

    if (ob->query_prevent_shadow(previous_object())) {
        return 0;
    }
	return 1;
}

// function: valid_override(string, string)
// purpose: This function determines if an object is allowed to call an
//          efun with the 'efun::' prefix even when a simul_efun of
//          the same name exists.  This function deserves special
//          attention for the sake of security.

int valid_override(string filename, string name)
{
	if (filename == OVERRIDES_FILE) {
		return 1;
	}
	if ((name == "move_object") && (filename != BASE))
		return 0;

	return 1;
}

// function: valid_seteuid(object, string)
// purpose: This function determines whether or not a given object is
//          allowed to set its euid to a certain value.  This will be
//          determined by the object's uid.

int valid_seteuid(object ob, string euid)
{
    return 1;
}

// function: valid_socket(object, string, mixed *)
// purpose: This function determines if a given object is allowed to use
//          the socket efuns.

int valid_socket(object caller, string func, mixed *info)
{
	return 1;
}

// function: valid_write(string, object, string)
// purpose: This function determines if a given function in a given object
//          has permission to write to a given filename. (That's a given!)

int valid_write(string filename, object ob, string func)
{
    return 1;
}

// function: valid_read(string, object, string)
// purpose: This function determines whether or not a specific object can
//          read a certain filename using the specified function, which
//          is usually an efun. (see valid_write() above.)

int valid_read(string filename, object ob, string func)
{
    return 1;
}

// function: valid_bind(object, object, object)
// purpose: This function determines if it is legal to bind a given 
//          function pointer to an object.  This is accompilshed via
//          the bind() efun.

int valid_bind(object doer, object owner, object victim) {
    return 0;
}

// function: valid_hide(object)
// purpose: This function determines if an object is priveleged enough
//          to be hidden and to be aware of the existence of other hidden
//          objects.

int valid_hide(object ob) {
    return 1;
}

// function: valid_compile_to_c(string)
// purpose: This function determines if an LPC object is able to be
//          compiled into C code based on its filename.  This process
//          is resource intensive and should be restricted.

int valid_compile_to_c(string filename) {
    return 1;
}
