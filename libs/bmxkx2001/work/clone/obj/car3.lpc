inherit ROOM;
inherit F_CLEAN_UP;
inherit F_UNIQUE;

/* Two inherits define clean_up(); the later one was already in effect: name it. */
int clean_up() { return clean_up::clean_up(); }

void reset() {}

void create() {
  set("short", "车库");
  set("no_clean_up", 1);

  setup();
}
