void generate_jp_name(object ob) {
  string name, sname, pname, id1, id2;
  string *ks, *kp;

  ks = keys(jp_sname);
  kp = keys(jp_pname);
  sname = ks[random(sizeof(ks))];
  pname = kp[random(sizeof(kp))];
  id1 = jp_sname[sname];
  id2 = jp_pname[pname];
  name = sname + pname;

  if (ob) ob->set_name(name, ({ id1 + " " + id2, id1, id2 }));
}
