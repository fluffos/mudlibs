// zombie.c

#include <ansi.h>

inherit NPC;

void copy_status(object me, object ob);
void invocation(object me, object who);

void create()
{
	set_name("僵尸", ({ "zombie" }) );
	set("long",
		"这是一具被人用符咒控制的僵尸，从它苍白的脸上看不出任何喜怒哀乐。\n");
	set("max_kee", 500);
	set("max_sen", 500);
	set("max_mana", 200);
	set("mana", 200);
        set("max_force", 200); 
        set("is_guard", 1);
        set("force", 200);
	set("age", 50);
	set("str", 25);
	set("cor", 30);
	set("chat_chance", random(100));
	set("chat_msg_combat", ({
		"僵尸口中发出荷荷的叫声。\n",
		"僵尸的脸上开始痉挛，一阵抽搐，发狂似地大叫。\n",
		"僵尸五指箕张，咬牙切齿，露出狰狞的笑容。\n",
	}) );
	set_skill("unarmed", 30);
	set_skill("dodge", 30);

	set_temp("apply/damage", 15);

	setup();
}

void init()
{
	add_action("do_release", "release");
	add_action("do_gongji", "gongji");

}

int do_gongji(string arg)
 {
  object me=this_player();
  object obj;
  object *inv=all_inventory(environment(me));
if(!arg) 
        return notify_fail(HIY"你命令僵尸攻击谁？\n"NOR);
  if(!objectp(obj = present(arg, environment(me))))
        return notify_fail(HIY"你命令僵尸攻击谁？\n"NOR);

 if( !obj->is_character() || obj->is_corpse() )
        return notify_fail(HIY"看清楚点，那并不是活物。\n"NOR);

 if( !wizardp(me) && environment(obj)->query("no_fight") && environment(obj)->query("no_magic"))
         return notify_fail(HIY"这里不准战斗\n"NOR);
 if(userp(obj) && obj->query("age")<16 && !wizardp(me))
        return notify_fail(HIY"不准欺负新手\n"NOR);
 if(wizardp(obj)&&!wizardp(me)) 
        return notify_fail(HIY"杀巫师？还是考虑清楚吧。\n"NOR);

message_vision(HIC"$N"+HIC+"运起勾魂术，叽里咕噜念了几句法咒，一指$n"+HIC+"喝道：都给我上！\n" NOR,me, obj);

 for (int i=0;i<sizeof(inv);i++) 
 {
  if(me==inv[i]->query("possessed"))
      {
  inv[i]->kill_ob(obj);
message_vision(HIC"$N"+HIC+"眼睛忽然睁开，喃喃地说道：" RED 
"杀....死....$n....\n" NOR,
                        inv[i], obj);
      }
  }
 return 1;
 }

int do_release()
{
	object who=this_player();

	if( who != this_object()->query("possessed") )
		return notify_fail("什么？\n");

	message_vision("$N向$n挥了挥手，$n慢慢地走开了。\n", who, this_object());
       who->add_temp("hellzombie",-1);
	destruct( this_object() );
	return 1;
}

int is_zombie() { return 1; }

void animate(object who)
{
	object me=this_object();
	set("possessed", who);
	copy_status(me, who);
	invocation(me, who);
	set_leader(who);
}
void copy_status(object me, object ob)
{
int i,j;


         j = 1;
        j = (int)ob->query_skill("gouhunshu",1);
         me->set_skill("force", j);       
         me->set_skill("dodge", j);         
         me->set_skill("parry", j);        
         me->set_skill("literate", j);  
         me->set_skill("spells", j);
         me->set_skill("unarmed", j);        
         me->set_skill("gouhunshu", j);         
         me->set_skill("tonsillit", j);               
         me->set_skill("ghost-steps", j);               
         me->set_skill("jinghun-zhang", j);              
         me-> map_skill("force", "tonsillit");

         me->map_skill("unarmed", "jinghun-zhang");
         me->map_skill("dodge", "ghost-steps");
         me->map_skill("spells", "gouhunshu");


        me->set("str",j);
        me->set("int",ob->query("int"));
        me->set("con",ob->query("con"));
        me->set("per",ob->query("per"));
        me->set("cor",ob->query("cor"));
        me->set("spi",ob->query("spi"));
        me->set("cps",ob->query("cps"));
        me->set("kar",ob->query("kar"));

        me->set("max_kee",ob->query("max_kee"));
        me->set("eff_kee",ob->query("eff_kee"));
        me->set("kee",ob->query("kee"));

        me->set("max_gin",ob->query("max_gin"));
        me->set("eff_gin",ob->query("eff_gin"));
        me->set("gin",ob->query("gin"));

        me->set("max_sen",ob->query("max_sen"));
        me->set("eff_sen",ob->query("eff_sen"));
        me->set("sen",ob->query("sen"));

        me->set("max_force",ob->query("max_force"));
        me->set("force",ob->query("force"));
        me->set("force_factor",ob->query("force_factor"));

        me->set("max_mana",ob->query("max_mana"));
        me->set("mana",ob->query("mana"));
        me->set("mana_factor",ob->query("mana_factor"));

        me->set("combat_exp",ob->query("combat_exp"));
        me->set("daoxing",ob->query("daoxing"));
  me->setup();
}

void invocation(object me, object who)
{
        int i;
        object *enemy;

	message_vision(HIY"\n$N"+HIY+"加入战斗。\n\n"NOR, me);

        enemy = who->query_enemy();
        i = sizeof(enemy);
        while(i--) {
                if( enemy[i] && living(enemy[i]) ) {
                        kill_ob(enemy[i]);
                        if( userp(enemy[i]) ) enemy[i]->fight_ob(this_object());
                        else enemy[i]->kill_ob(this_object());
                }
        }
        set_leader(who);
}


void die()
{
  object master;
	if( objectp(master = query("possessed")) )
      {
       master->add_temp("hellzombie",-1);
		message("tell",
HIY"你的" + name()+""+HIY+"死了。\n"NOR, master);
          }
        if( environment() ) {
                message("sound", "僵尸慢慢地倒了下去，化为一滩血水。\n", environment());
        }

	destruct(this_object());
}

int heal_up()
{
	object master;
       object me = this_object();
	if( objectp(master = query("possessed")) 
	&&	(int)master->query("mana") > 100 
	&&	(int)master->query("kee") > 100) {
		message("tell",
HIR"你觉得体内的力量被" + name()+""+HIR+"一点一点地吸去了。\n"NOR, master);
		master->add("mana", -50);
      if (environment(me)!=environment(master)) 
               {
         tell_room(environment(me),"一阵黑烟过后"+me->query("name")+"消失不见了。\n", me);
         me->move(environment(master));
        message_vision(HIB"只见一股腐臭之气从地底冒出，浓雾之中$N"+HIB+"从中蹦了出来。\n"NOR,me);
               }
		::heal_up();
		return 1;		// Always acquire power from master.
	} else {
		call_out("die", 1);
		return ::heal_up();
	} 
}


