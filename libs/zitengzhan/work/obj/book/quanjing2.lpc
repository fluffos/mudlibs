// literate.c
#include <ansi.h>
inherit ITEM;

void create()
{
        set_name("〖拳神〗", ({"quan shen", "shen", "book"}));
        set_weight(400);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "本");
                set("value", 0);
                set("long", "一本薄薄的的小册子，画了些手法，拳经的续集。\n");
                set("material", "paper");
                set("skill", ([
                        "name": "unarmed",
                        "sen_cost": 40,
                        "difficulty": 50,
                        "max_skill": 200,
                        "min_skill": 150,
                ]) );
        }
}
varargs int move(mixed dest, int silently)
{
        object ob;

        if( objectp(dest) )
                ob = dest;
        else if( stringp(dest) ) {
                call_other(dest, "???");
                ob = find_object(dest);
        } 
        if(objectp(ob)&&userp(ob))      {
                if( (query("rumor")==0))       {
                        message("channel:rumor", 
HIM +"【空穴来风】"+ "某人：听说"+ob->query("name")+"好象得到了"+HIY+"〖拳神〗"+HIM+"！\n"NOR,users());
                        set("rumor",1);
                }
        }

        return ::move(dest,silently);
}

void init()
{
	if( (int)this_object()->query("created") != 1 )
	{
		this_object()->set("created", 1);
		remove_call_out ("destroy_book");
                call_out ("destroy_book", 6800+random(400));
	}
}

void destroy_book()
{
	message_vision("一阵风吹来，" + (string)this_object()->query("name") + "片片碎落，随风而去了。\n", environment(this_object()));
	destruct(this_object());
}

