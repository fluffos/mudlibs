// xue.c
// by better

#include <ansi.h>

int exert(object me, object target) {
  string force;

  if (!target || target == me)
    return notify_fail("你要用真气为谁补血？\n");

  if (me->is_fighting() || target->is_fighting())
    return notify_fail("战斗中无法补血！\n");

  if (target->query("not_living"))
    return notify_fail("你不能给" + target->name() + "补血。\n");

  force = me->query_skill_mapped("force");
  if (!force)
    return notify_fail("你必须激发自己的内功才能替人补血。\n");

  if ((int)me->query_skill(force, 1) < 50)
    return notify_fail("你的" + to_chinese(force) + "等级不够。\n");

  if ((int)me->query("max_force") < 300)
    return notify_fail("你的内力修为不够。\n");

  if ((int)me->query("force") < 150)
    return notify_fail("你现在的真气不够。\n");

  if ((int)target->query("kee") >= (int)target->query("max_qi"))
    return notify_fail(target->name() +
      "现在没有伤血，不需要你运功治疗！\n");


  message_vision(
    HIY "$N大喊一声，赐予我同伴生命吧" + to_chinese(force) +
    "，将手掌贴在$n背心，缓缓地将真气输入$n体内....\n"
    HIW "过了不久，$N额头上冒出豆大的汗珠，$n精神"
    "一振，脸色看起来红润多了。\n" NOR,
    me, target);

  target->receive_curing("kee", 50 + (int)me->query_skill("force") / 2);
  target->add("kee", 50 + (int)me->query_skill("force") / 3);

  me->add("force", -50);
  return 1;
}
