#include <ansi.h>
inherit NPC;
int give_gift(object target);

void create() {
  set_name(HIW "叶欣" NOR, ({ "ye xin" }));
  set("title", HIY "劳动使者" NOR);
  set("gender", "女性");
  set("age", 47);
  set("long", HIW "我不知道你是谁，但是我知道你是为了谁！\n\n" HIR "敬请访问" BLINK HIY "  http://yx.netor.com\n" NOR);
  set("attitude", "peaceful");
  set("per", 99);
  set("inquiry", ([
    "五一礼物": (: give_gift :),
    "gift": (: give_gift :),
  ]));
  setup();
  carry_object("/d/moon/obj/tianyi")->wear();

}

int give_gift(object target) {
  int exp, wxreward, dxreward;

  target = this_player();

  exp = target->query("combat_exp") + target->query("daoxing");

  if (target->query("mudbug/51gift")) {
    write(HIR "\n你不是领过了“五.一”礼物了吗？\n\n" NOR);
    this_object()->command("hammer " + target->query("id"));
    return 1;
  }

  if (exp < 100000) {
    write("你的修行太低了，还是先去锻炼一下再来吧!\n");
    return 1;
  }
  wxreward = target->query("combat_exp") / 50 > 250000 ? 250000 : target->query("combat_exp") / 50;
  dxreward = target->query("daoxing") / 50 > 250000 ? 250000 : target->query("daoxing") / 50;

  tell_object(target, HIR "“五.一”劳动节快乐!\n" + HIW " 你得到了以下奖励：\n\n      武学:  " + (string)wxreward + "  点\n"
    + "      道行:  " + COMBAT_D->chinese_daoxing(dxreward) + "\n      潜能： 5000  点" + HIB "\n\n深切怀念“非典”卫士---敬请访问" + HIY " http://yx.netor.com\n" NOR);
  tell_room(environment(this_object()), target->query("name") + "得到了“五.一”劳动节奖励!\n");
  target->set("mudbug/51gift", 1);
  target->add("combat_exp", wxreward);
  target->add("daoxing", dxreward);
  target->add("potential", 5000);
  target->set("data_watch_time", time());
  target->set("data_watch_exp", target->query("combat_exp") + target->query("daoxing"));

  target->save();

  return 1;

}
