//by mudbug

inherit NPC;
#include <ansi.h>

void create() {

  set_name("小泥虫", ({ "accountant" }));
  set("title", "数据统计员");
  set("age", 19);
  set("gender", "男性");
  set("per", 40);
  set("attitude", "peaceful");
  setup();
  carry_object("/u/mudbug/zhuxian")->wield();

}

void init() {

  remove_call_out("work");
  call_out("work", 1);

}

int work() {

  int i, num, totle, num10, num26, num40, num64, num90;
  num90 = 0;
  num10 = num26 = num40 = num90 = 0;
  for (i = 0, num = 0; i < 1000; i++) {
    num = 0;
    num = random(100);
    totle += num;
    if (num > 10) num10++;
    if (num > 26) num26++;
    if (num > 40) num40++;
    if (num > 64) num64++;
    if (num > 90) num90++;
  }
  totle /= 1000;

  tell_room(
    environment(),
    HIR "【系统】小泥虫(Mudbug)：1000次 Random(100)平均值==" + BLINK HIY "  " + (string)totle + "\n" NOR
  );
  tell_room(
    environment(),
    HIC "【系统】pozhan(80%myexp)：1000次 Random(100)>10共有" + BLINK HIB "  " + (string)num10 + "\n" NOR
  );
  tell_room(
    environment(),
    HIG "【系统】pozhan(100%myexp)：1000次 Random(100)>26共有" + BLINK HIC "  " + (string)num26 + "\n" NOR
  );
  tell_room(
    environment(),
    HIY "【系统】pozhan(120myexp)：1000次 Random(100)>40共有" + BLINK HIR "  " + (string)num40 + "\n" NOR
  );
  tell_room(
    environment(),
    HIC "【系统】pozhan(150%myexp)：1000次 Random(100)>64" + BLINK HIB "  " + (string)num64 + "\n" NOR
  );
  tell_room(
    environment(),
    YEL "【系统】pozhan(186%myexp)：1000次 Random(100)>90" + BLINK HIW "  " + (string)num90 + "\n" NOR
  );

  call_out("work", 15);
  return 1;


}
