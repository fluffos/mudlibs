int die()
{
	object me=this_object();
	me->set("eff_kee",me->query("max_kee"));
	me->set("eff_sen",me->query("max_sen"));
	me->set("kee",me->query("max_kee"));
	me->set("sen",me->query("max_sen"));
	return 1;
}

int unconcious()
{
	return die();
}