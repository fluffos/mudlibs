// 辅助函数
string game();  // 返回游戏名称
string game_name();  // 返回游戏中文名
object player_at(string);  // 返回某个座位的玩家
string seat_of(object);  // 返回某个玩家的座位
void seat_player(string, object);  // 某个玩家进入某个座位
string *player_seats();  // 返回玩家可以坐的位置
object *players();  // 返回已经入座的玩家
object *watchers();  // to be completed
int is_player(object);  // 是否本游戏玩家
int check_seat(string);  // 确认座位的玩家
int is_playing();  // 游戏是否进行中（相对于等待中）
int is_ready(object);  // 玩家是否准备
object judge();  // 返回裁判
object speaker();  // 返回当前出牌的玩家
int *cards_of(object);  // 返回该玩家手上的牌
int *cards_at(string);  // 返回改位置的牌
string center_string(string, int);  // 字符串居中
mapping last_trick();  // 上一圈牌
mapping last_trail();  // 上一手牌
string last_seat();  // 上一手牌的位置
string next_position(string);  // 位置的下个位置
string next_position_of(object);  // 玩家的下个位置
string status();  // 返回状态
// 计算类型辅助函数
int sizeof_member_size(mixed);  // 二维数组有几种不同成员长度
int max_member_size(mixed);  // 二维数组的最大成员长度
int member_size_appears(mixed darray, int size);  // 二维数组长度为size的成员个数
int *first_member_of_size(mixed darray, int size);  // 二维数组第一个长度为size的成员

// 外部接口
void set_number(int table_number);  // 设置桌号
int enter_player(object);  // 加入游戏
int leave_player(object);  // 退出游戏
int enter_watcher(object, string);  // 加入观看 to be completed

// 内部接口
void start_game();  // 游戏开始
void terminate_game();  // 游戏异常中止
void utter_timeout(object);  // 出牌时间到
void invalidate_player_seats();  // 强制刷新玩家座位，修正错误状态 
void turn_to_seat(string seat);  // 轮到某个座位

void utter_cards(object, mapping);  // 出牌

// 虚接口
void distribute_cards();  // 发牌
void show_play_method_detail();  // 游戏规则介绍
void show_play_method_brief(object ob);  // 游戏规则提示
void on_utter_timeout(object);  // 出牌超时操作
void show_cards(int *cards, object *viewers, int mode, int incs);  // 给某个玩家看手上的牌
int valid_input_chars(string arg);  // 输入的字符是否在扑克字符范围内
int *input_to_cards(string arg);  // 输入字符转换为扑克，用这些扑克的权表示
int *player_have_cards(object player, int *input_cards);  // 玩家是否有这些扑克，返回这些扑克号的数组
mapping cards_to_trail(int *input_cards);  // 将用权表示的扑克解析为一手牌
int greater(mapping my_cards, mapping other_cards);  // 比较牌大小
void show_trail(int *cards, object ob, int mode);  // 显示一手牌
void play_out(object ob);
void on_table_create();

void init() {
  add_action("block_cmd", "", 1);
  add_action("do_look", "look");
  add_action("do_put", "put");
  add_action("do_get", "get");

  add_action("do_ready", "ready");
  add_action("do_ready", "ok");
  add_action("do_hintsoff", "hintsoff");
  add_action("do_hintson", "hintson");
  add_action("do_decs", "decs");
  add_action("do_incs", "incs");
  add_action("do_rules", "rules");
  add_action("do_rules", "help");
  add_action("do_pass", "pass");
  add_action("do_pass", "p");
  add_action("do_info", "info");
  add_action("do_replay", "replay");
  add_action("do_replay", "re");
  add_action("do_leave", "leave");
  add_action("do_leave", "bye");
  add_action("do_always", "always");
  add_action("do_always", "auto");
}

/* 
      action：ready
*/
int do_ready(string arg) {
  object ob = this_player();
  if (!is_player(ob))
    return 0;
  if (ob->is_busy()) {
    write(WHT "你正忙着。。。\n" NOR);
    return 1;
  } else if (is_playing()) {
    message_vision(YEL "\n$N大叫道：俺准备好咧！\n" NOR, ob);
    message_vision(CYN "$N狠狠地敲著$n的脑袋，数著$n头上被打出来的包，偷偷地笑著。\n", judge(), ob);
    message_vision(CYN "$N对$n说道：给我闭嘴！\n" NOR, judge(), ob);
    if (!wizardp(ob))
      ob->start_busy(3);
    return 1;
  }

  if (!is_ready(ob)) {
    if (userp(ob))
      message_vision(YEL "\n$N向裁判示意准备好了。\n" NOR, ob);
    set("ready/" + seat_of(ob), 1);
    if (sizeof(query("ready")) == sizeof(player_seats())) {
      start_game();
    }
  } else if (userp(ob)) {
    switch (random(4)) {
      case 0:
        message_vision(YEL "$N催促道，都赶紧地啊GGMM们！\n" NOR, ob);
        break;
      case 1:
        message_vision(YEL "$N左看看又看看，怎么都这么慢？\n" NOR, ob);
        break;
      case 2:
        message_vision(YEL "$N等得不耐烦了。。。\n" NOR, ob);
        break;
      case 3:
        message_vision(YEL "$N打了个哈欠，再不开始俺要走了啊。\n" NOR, ob);
        break;
    }
    if (!wizardp(ob))
      ob->start_busy(3);
  }

  return 1;
}

/* 
      action：hintson
*/
int do_hintson(string arg) {
  object ob = this_player();
  if (!is_player(ob))
    return 0;
  if (ob->is_busy()) {
    write(WHT "你正忙着。。。\n" NOR);
    return 1;
  }
  ob->delete(game() + "/no_hints");
  write(BLK "OK.提示信息已经打开，使用hintsoff命令关闭提示信息。\n" NOR);
  return 1;
}

/* 
      action：hintsoff
*/
int do_hintsoff(string arg) {
  object ob = this_player();
  if (!is_player(ob))
    return 0;
  if (ob->is_busy()) {
    write(WHT "你正忙着。。。\n" NOR);
    return 1;
