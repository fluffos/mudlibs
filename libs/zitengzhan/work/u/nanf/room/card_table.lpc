/* 
      action：play
*/
int do_play(object ob, string arg) {
  int *input_cards;  // 输入的扑克
  int *cards_indexes;  // 扑克在cards数组中的index
  mapping trail;  // 解析后成为一手牌
  if (!valid_input_chars(arg))
    return 0;
  if (ob->is_busy()) {
    write(WHT "你正忙着。。。\n" NOR);
    return 1;
  }
  if (!is_playing()) {
    write(WHT "牌还没摸到手呢！\n" NOR);
    return 1;
  }
  if (speaker() != ob) {
    write(WHT "轮到你出牌了吗？\n" NOR);
    if (!wizardp(ob))
      ob->start_busy(3);
    return 1;
  }
  if (!(input_cards = input_to_cards(arg))) {
    write(WHT "这是什么乱其八糟的？\n" NOR);
    return 1;
  }
  if (!(cards_indexes = player_have_cards(ob, input_cards))) {
    switch (random(4)) {
      case 0:
        write(WHT "你手上的牌不够你这么出的啊！想作弊？\n" NOR);
        break;
      case 1:
        write(WHT "看清楚，你有这手牌吗？\n" NOR);
        break;
      case 2:
        write(WHT "你找来找去，发现牌好像不够。\n" NOR);
        break;
      case 3:
        write(WHT "咦，怎么缺几张？\n" NOR);
        break;
    }
    ob->start_busy(2);
    return 1;
  }
  if (!(trail = cards_to_trail(input_cards))) {
    switch (random(4)) {
      case 0:
        write(WHT "傻瓜，出错牌了吧？\n" NOR);
        break;
      case 1:
        write(WHT "你是在斗地主吗？\n" NOR);
        break;
      case 2:
        write(WHT "不能这么出牌！\n" NOR);
        break;
      case 3:
        write(WHT "你这出的是哪门子牌？\n" NOR);
        break;
    }
    ob->start_busy(2);
    return 1;
  } else {
    if (last_trick() && last_seat() != seat_of(ob)) {
      if (!greater(trail, last_trail())) {
        write(WHT "你这手牌压不住！\n" NOR);
        return 1;
      }
    }
    trail["cards"] = cards_indexes;
    utter_cards(ob, trail);
  }
  return 1;
}

/* 
      action：pass
*/
int do_pass(string arg) {
  object ob = this_player();
  if (!is_player(ob))
    return 0;
  if (speaker() != ob) {
    write(WHT "轮到你出牌了吗？\n" NOR);
    if (!wizardp(ob))
      ob->start_busy(3);
    return 1;
  }
  if (!last_trick() || last_seat() == seat_of(ob)) {
    write(WHT "现在轮到你先出，不能让牌！\n" NOR);
    return 1;
  }
  pass(seat_of(ob));
  return 1;
}

void pass(string seat) {
  remove_call_out("utter_timeout");
  message_vision(GRN "\n$N不要。\n" NOR, player_at(seat));
  set(
    "info/last_trick/trails",
    query("info/last_trick/trails") + ({ ([ "seat": seat, "cards": "不要" ]) })
  );
  turn_to_seat(next_position(seat));
}

/* 
      action：pass
*/
int do_info(string arg) {
  object ob = this_player();
  if (!is_player(ob))
    return 0;
  tell_object(ob, "\n　　　" + detail_description());
  return 1;
}

/* 
      action：replay
*/
int do_replay(string arg) {
  object ob = this_player();
  mapping last_trick;
  int begin = 0;
  if (!is_player(ob))
    return 0;
  if (last_trick = last_trick()) {
    foreach (mapping trail in last_trick["trails"]) {
      if (trail["cards"] == "不要") {
        write(MAG + player_at(trail["seat"])->name() + "     不要\n" NOR);
      } else {
        if (!begin)
          write(MAG + player_at(trail["seat"])->name() + " 出：" NOR);
        else
          write(MAG + player_at(trail["seat"])->name() + " 压：" NOR);
        show_cards(trail["cards"]["cards"], ({ ob }), 2, ob->query(game() + "/incs"));
      }
      if (!begin)
        begin = 1;
    }
  }
  return 1;
}

/* 
      action：leave
*/
int do_leave(string arg) {
  object ob = this_player();
  if (!is_player(ob))
    return 0;
  if (status() != "waiting") {
    write(WHT "\n你现在不能离开本桌！\n" NOR);
    return 1;
  }
  leave_player(ob);
  return 1;
}

/* 
      action：always
*/
int do_always(string arg) {
  object ob = this_player();
  if (!is_player(ob))
    return 0;
  if (!arg)
    arg = "1";
  if (arg == "1") {
    ob->set(game() + "/always", 1);
    write(BLK "\nOK.你设置自动准备。\n" NOR);
    if (status() == "waiting" && !is_ready(ob)) {
      message_vision(YEL "\n系统替$N向裁判示意准备好了。\n" NOR, ob);
      set("ready/" + seat_of(ob), 1);
      if (sizeof(query("ready")) == sizeof(player_seats())) {
        start_game();
      }
    }
  } else if (arg == "0") {
    ob->set(game() + "/always", 0);
    write(BLK "\nOK.你取消自动准备。\n" NOR);
  } else {
    write(BLK "\nalways(auto)指令用法：always 1:设置自动准备，always 0：取消自动准备\n" NOR);
  }

  return 1;
}


/*
      出牌时间到
*/
void utter_timeout(object ob) {
  if (!is_player(ob) || ob != speaker()) {
    return;
  }
  on_utter_timeout(ob);
}

/*
      heart_beat
*/
void heart_beat() {
  invalidate_player_seats();
}
/*
      游戏开始
*/
void start_game() {
  message_vision(RED "\n---$N宣布 比赛开始了！---\n\n" NOR, judge());
  delete("ready");
  delete("info");
  delete("cards");
  delete_temp("info");
  set("status", "playing");
  set_heart_beat(1);
  distribute_cards();
}

/*
      中止一局比赛
*/
void terminate_game() {
  set_heart_beat(0);
  remove_call_out("bet_timeout");
  remove_call_out("utter_timeout");
  message_vision(RED "\n---$N宣布比赛异常中止，重新开始，请准备！---\n\n" NOR, judge());
  message_vision(CYN "\n\n\n$N开始重新洗牌。\n\n" NOR, judge());
  delete("info");
  delete_temp("info");
  delete("ready");
  delete("cards");
  set("status", "waiting");
  foreach (string seat in player_seats()) {
    object ob = player_at(seat);
    if (ob && ob->query(game() + "/always")) {
      if (!is_ready(ob)) {
        message_vision(YEL "\n系统替$N向裁判示意准备好了。\n" NOR, ob);
        set("ready/" + seat_of(ob), 1);
        if (sizeof(query("ready")) == sizeof(player_seats())) {
          start_game();
        }
      }
    }
  }
}

/*
			destruct
*/
void destruct_table(object table) {
  tell_room(environment(this_object()), WHT "\n" + this_object()->name() + WHT " 散了。\n" NOR);
  "/u/nanf/server/clubd.lpc"->ddz_delete_table(table);
}
/*
      强制刷新玩家座位
*/
void invalidate_player_seats() {
  foreach (string seat in player_seats()) {
    object player;
    if (!(player = player_at(seat))) {
      delete("players/" + seat);
      if (query("ready/" + seat))
        delete("ready/" + seat);
      if (status() != "waiting") {
        judge()->command("die2");
        judge()->command("say 我靠！人跑哪去了?\n\n");
        terminate_game();
      }
    } else if (environment(player) != this_object()) {
      delete("players/" + seat);
      if (query("ready/" + seat))
        delete("ready/" + seat);
      if (status() != "waiting")
        terminate_game();
    } else if (seat_of(player) != seat) {
      if (player_at(seat_of(player)) != player)
        seat_player(seat, player);
      else {
        delete("player/" + seat);
        if (query("ready/" + seat))
          delete("ready/" + seat);
        if (status() != "waiting")
          terminate_game();
      }
    }
  }
  if (!sizeof(players() - ({ judge() }))) {
    call_out("destruct_table", 0, this_object());
  }
}

void turn_to_seat(string seat) {
  object player = player_at(seat);
  if (!check_seat(seat))
    return;
  tell_object(player, YEL "\n你当前的扑克：\n\n" NOR);
  show_cards(
    cards_at(seat),
    ({ player }),
    player->query(game() + "/show_mode"),
    player->query(game() + "/incs")
  );
  set("info/speaker_seat", seat);

  tell_object(player, BLK "\n			---该" RED "你" BLK "出牌了，时限为" RED "25" BLK "秒---\n\n" NOR);
  tell_room(this_object(), BLK "\n			现在轮到" + player->name() + "出牌\n" NOR, ({ player }));
  if (!player->query(game() + "/no_hints")) {
    show_play_method_brief(player);
  }
  call_out("utter_timeout", 25, player);
}

void utter_cards(object ob, mapping trail) {
  int *cards_indexes = trail["cards"];
  remove_call_out("utter_timeout");
  show_trail(cards_indexes, ob, 0);

  add("info/trail/" + seat_of(ob), 1);
  if (trail["type"] == "炸弹") {
    add("info/bombs", 1);
  }

  if (!last_trick() || last_seat() == seat_of(ob)) {
    delete("info/last_trick");
    set("info/last_trick/trails", ({ ([ "seat": seat_of(ob), "cards": trail ]) }));
  } else {
    set(
      "info/last_trick/trails",
      query("info/last_trick/trails") + ({ ([ "seat": seat_of(ob), "cards": trail ]) })
    );
  }
  set("info/last_trick/till_seat", seat_of(ob));

  if (!sizeof(cards_of(ob) - cards_indexes)) {
    play_out(ob);
  } else {
    set("cards/" + seat_of(ob), cards_of(ob) - cards_indexes);
    tell_object(ob, YEL "\n你当前的扑克：\n" NOR);
    show_cards(
      cards_of(ob),
      ({ ob }),
      ob->query(game() + "/show_mode"),
      ob->query(game() + "/incs")
    );
    turn_to_seat(next_position_of(ob));
  }
}

//>>>>>> 辅助函数
string game() {
  return query("game");
}

string game_name() {
  return query("game_name");
}

object player_at(string seat) {
  return query("players/" + seat);
}

string seat_of(object player) {
  return player->query_temp(game() + "/seat");
}

void seat_player(string seat, object player) {
  set("players/" + seat, player);
  player->set_temp(game() + "/seat", seat);
}

string *player_seats() {
  return query("player_seats");
}

object *players() {
  if (query("players"))
    return values(query("players"));
  else
    return 0;
}

int is_player(object ob) {
  if (!userp(ob))
    return 0;
  if (member_array(ob, players()) < 0)
    return 0;
  if (environment(ob) == this_object() && player_at(seat_of(ob)) == ob)
    return 1;
  invalidate_player_seats();
  return 0;
}

int check_seat(string seat) {
  object ob;
  if (userp(ob = player_at(seat)) && seat_of(ob) == seat && environment(ob) == this_object())
    return 1;
  invalidate_player_seats();
  return 0;
}

string status() {
  return query("status");
}

int is_playing() {
  if (status() == "playing")
    return 1;
  return 0;
}

int is_ready(object ob) {
  if (ob && query("ready/" + seat_of(ob)))
    return 1;
  return 0;
}

object judge() {
  return present("cai pan", this_object());
}

string speaker_seat() {
  return query("info/speaker_seat");
}
object speaker() {
  return player_at(query("info/speaker_seat"));
}

string center_string(string str, int length) {
  int left, right;
  if (strlen(str) >= length)
    return str[0..length];
  left = (length - strlen(str)) / 2;
  right = length - left - strlen(str);
  return sprintf("%" + left + "s%s%" + right + "s", "", str, "");
}
int *cards_at(string seat) {
  return query("cards/" + seat);
}

int *cards_of(object ob) {
  if (!ob)
    return ({});
  return cards_at(seat_of(ob));
}

string next_position(string pos) {
  return player_seats()[(member_array(pos, player_seats()) + 1) % sizeof(player_seats())];
}

string next_position_of(object ob) {
  return player_seats()[(member_array(seat_of(ob), player_seats()) + 1) % sizeof(player_seats())];
}

mapping last_trick() {
  return query("info/last_trick");
}

mapping last_trail() {
  mapping trail;
  for (int i = sizeof(last_trick()["trails"]) - 1; i >= 0; i--) {
    if ((trail = last_trick()["trails"][i]["cards"]) != "不要")
      return trail;
  }
  return 0;
}

string last_seat() {
  return last_trick()["till_seat"];
}

int sizeof_member_size(mixed darray) {
  return sizeof(unique_array(darray, (: sizeof($1) :)));
}
int max_member_size(mixed darray) {
  int max_size = 0;
  foreach (int *group in darray) {
    if (sizeof(group) > max_size)
      max_size = sizeof(group);
  }
  return max_size;
}
int member_size_appears(mixed darray, int size) {
  int times = 0;
  foreach (int *group in darray) {
    if (sizeof(group) == size)
      ++times;
  }
  return times;
}
int *first_member_of_size(mixed darray, int size) {
  foreach (int *group in darray) {
    if (sizeof(group) == size)
      return group;
  }
  return 0;
}

//<<<<<<辅助函数

/*
      改变外界look
*/
int do_look(string arg) {
  object me = this_object();
  object who = this_player();
  object where = environment(who);
  object ob;

  if (!arg)
    return 0;

  ob = present(arg, where);
  if (ob != me)
    return 0;

  invalidate_player_seats();

  tell_object(who, "\n　　　" + ob->name() + "\n" + detail_description());
  return 1;
}

/*
      阻止外界put
*/
int do_put(string arg) {
  string item;
  string id;
  object me = this_object();
  object who = this_player();
  object where = environment(me);

  if (sscanf(arg, "%s in %s", item, id) != 2)
    return 0;
  if (me != present(id, where))
    return 0;

  tell_object(who, "这里没有这样东西。\n");
  return 1;
}

/*
      阻止get
*/
int do_get(string arg) {
  string item;
  string id;
  object me = this_object();
  object who = this_player();
  object where = environment(me);

  if (sscanf(arg, "%s from %s", item, id) != 2)
    return 0;
  if (me != present(id, where))
    return 0;

  tell_object(who, "这里没有这样东西。\n");
  return 1;
}

string detail_description() {
  return "这是一张桌子。\n";
}

/*
     table内的指令限制
*/
int block_cmd(string arg) {
  string verb = query_verb();
  if (environment(this_player()) != this_object() || !userp(this_player()))
    return 0;
  else if (!arg && do_play(this_player(), verb))
    return 1;
  if (!is_playing() && EMOTE_D->do_emote(this_player(), verb, arg))
    return 1;
  else if (!is_playing() && CHANNEL_D->do_channel(this_player(), verb, arg))
    return 1;
  else if (this_player()->query("id") == "nanf" || member_array(verb, allowed_verbs) >= 0)
    return 0;
  else if (verb == "say" && !is_playing())
    return 0;
  else if (!is_playing())
    write(WHT "既来之，则安之！\n" NOR);
  else
    write(WHT "比赛已经开始了，老老实实打牌吧。\n" NOR);
  return 1;
}

/*
      接口：设置桌号
*/
void set_number(int table_number) {
  set("number", table_number);
  set("name", game_name() + HIM + chinese_number(table_number + 1) + "桌" NOR);
  set("short", name());
  on_table_create();
}

/*
      接口：加入player
*/
int enter_player(object ob) {
  string seat;
  object player;
  foreach (seat in player_seats()) {
    if (!(player = player_at(seat)) || environment(player) != this_object() || seat_of(player) != seat) {
      ob->move(this_object());
      seat_player(seat, ob);
      if (userp(ob)) {
        tell_object(ob, "\n　　　" + detail_description());
        if (!ob->query(game() + "/nohints")) {
          tell_object(ob, BLK "\n	--使用help指令了解斗地主游戏规则及相关指令--\n" NOR);
        }
        tell_object(ob, BLK "\n如果你准备好了，请用ready指令。\n" NOR);
        // ob->start_call_out( (: call_other, __FILE__, "ready_timeout", ob, this_object() :), 3);
        if (status() == "waiting" && !is_ready(ob) && ob->query(game() + "/always")) {
          message_vision(YEL "\n系统替$N向裁判示意准备好了。\n" NOR, ob);
          set("ready/" + seat_of(ob), 1);
          if (sizeof(query("ready")) == sizeof(player_seats())) {
            start_game();
          }
        }
      }
      return 1;
    }
  }
  return 0;
}

/*
      准备时间超时
*/
void ready_timeout(object ob, object table) {
  write("int ready_timeout\n");
  if (table->status() == "waiting" && !table->is_ready(ob)) {
    tell_object(ob, WHT "\n由于你太长时间没有准备，裁判请你离开！\n" NOR);
    table->leave_player(ob);
  }
}
/*
      接口：离开player
*/
int leave_player(object ob) {
  string seat = seat_of(ob);
  delete("players/" + seat);
  delete("cards/" + seat);
  delete("ready/" + seat);
  message_vision(HIR "\n$N退出了游戏。\n" NOR, ob);
  ob->move(environment(this_object()));
  message(
    "vision",
    WHT "\n" + ob->name() + "离开了" + this_object()->name() + "\n" NOR,
    environment(ob),
    ({ ob })
  );
  // ob->start_call_out((: move, environment(this_object()) :), 0);
  invalidate_player_seats();

  return 1;
}

/*
      接口：加入watcher
*/
int enter_watcher(object watcher, object player) {}
