  "score", "score1", "score2", "score3",
});

int block_cmd(string);  // 指令限制
int do_look(string arg);  // 改变外界look
int do_put(string arg);  // 阻止外界put
int do_get(string arg);  // 阻止外界get from

string detail_description();  // 详细描述

// user actions
int do_ready(string);
int do_hintsoff(string);
int do_hintson(string);
int do_rules(string);
int do_decs(string);
int do_incs(string);
int do_info(string);
