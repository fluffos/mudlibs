//Nanf 2011-03
inherit ROOM;
#include <ansi.h>

int sit_table(string);
void update_free_table_num();

void create()
{
	int i;
	set ("short", "斗地主 房间");
	set ("long", @LONG

这里是 紫藤棋牌室 斗地主房间，来这里的目的就是消遣消遣
房间里到处都是 斗地主用的桌子，你可以找一张有空位的桌
子坐下(sit)。

LONG);

	set("objects", ([ /* sizeof() == 1 */
		__DIR__"ddz_free_table.lpc" : 1,
	]));

	set("no_time", 1);
	set("no_fight", 1);
	set("no_magic", 1);


	setup();

	set("no_clean_up", 1);

	update_free_table_num();
}

int clean_up()
{
	return 0;
}

void init ()
{
	add_action("sit_table", "sit");
}

void update_free_table_num()
{
	object free_table;

	if(free_table = present("free table", this_object()))
		free_table->set_number("/u/nanf/server/clubd.lpc"->ddz_tables_left());
}

int sit_table(string arg)
{
	object me = this_player();
	int i,table_number,direction;
	if(!arg)
	{
		table_number = "/u/nanf/server/clubd.lpc"->ddz_free_table();
		if(table_number>=0)
		{
			write(WHT"\n使用 sit 桌号 坐下，如sit 1坐到1号桌。\n"NOR);
		}
		else
			write(WHT"\n没有空桌子了。\n"NOR);
	}
	else if(sscanf(arg, "%d", table_number) == 1)
	{
		object table, *inv;

		inv = all_inventory(this_player());
		for(i=0; i<sizeof(inv); i++)
		{
			if ( inv[i]->is_character())
			{
				write(WHT"\n你想背着个大活人来斗地主？\n"NOR);
				me->start_busy(3);
				return 1;
			}
		}

		if(!"/u/nanf/server/clubd.lpc"->ddz_valid_table(table_number-1))
		{
			write(WHT"\n没有这张桌子。\n"NOR);
		}
		else if("/u/nanf/server/clubd.lpc"->ddz_table_state(table_number-1))
		{
			if(table = "/u/nanf/server/clubd.lpc"->ddz_table(table_number-1))
			{
				if(environment(table) != this_object())
					table->move(this_object());
			}
			else if(table = "/u/nanf/server/clubd.lpc"->ddz_new_table(table_number-1))
			{
				table->move(this_object());
				update_free_table_num();
			}
			else
			{
				write(BLK"\n出错了，你无法进入这张桌子！\n"NOR);
				return 1;
			}
			message_vision(WHT"\n$N加入"+table->name()+"\n\n"NOR, me);
			if(!table->enter_player(me))
			{
				write(BLK"\n你无法进入这张桌子！\n"NOR);
				return 1;
			}
		}
		else if(table = "/u/nanf/server/clubd.lpc"->ddz_new_table(table_number-1))
		{
			message_vision(WHT"\n$N坐到了"+table->name()+WHT"上。\n\n"NOR, me);
			table->move(this_object());
			update_free_table_num();
			if(!table->enter_player(me))
				write(BLK"\n出错了，你无法进入这张桌子！\n"NOR);
		}
		else
		{
			write(BLK"\n出错了，你无法进入这张桌子！\n"NOR);
		}
	}
	else
	{
		write(WHT"\n你要坐到哪里去？\n"NOR);
	}

	return 1;
}

