//Nanf 2011-03
inherit ITEM;
#include <ansi.h>


void create()
{
	set_name(HIW"空桌子"NOR, ({"free table", "kong zhuo zi"}));
	set_weight(60000000);
	set_max_encumbrance(2000000000);
	if( clonep() )
		set_default_object(__FILE__);
	else
	{
		set("no_get",1);
		set("no_clean_up",1);
		setup();
	}
}

void set_number(int number)
{
	set("name",HIR+chinese_number(number)+"张" HIW"空桌子"NOR);
}