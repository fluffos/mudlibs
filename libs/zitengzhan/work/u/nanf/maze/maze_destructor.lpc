//maze keeper by Nanf
inherit F_DBASE;
#include <ansi.h>
#include <maze.h>

void create() {
  seteuid(getuid());
  set("name", "副本");
  set("id", "maze");
  set_heart_beat(CHECK_INTERVAL);
}

void heart_beat() {
  mapping mazes = MAZE_OB->query("mazes");
  if (mazes) {
    foreach (string maze in keys(mazes)) {
      class maze_settings settings = mazes[maze]["settings"];
      if (settings->life_time && settings->life_time <= time()) {
        CHANNEL_D->do_channel(this_object(), "sys", MAG "destructing maze: " + maze + "\n" NOR);
        MAZE_D->destruct_maze(maze);
      }
    }
  }
}
