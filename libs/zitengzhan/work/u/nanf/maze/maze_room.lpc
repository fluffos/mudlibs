//maze room  by Nanf
#include <ansi.h>
inherit ROOM;

void create() {
  set("drop_msg", HIG "$N" HIG "一落地就消失的无影无踪。\n" NOR);
  set("outdoors", 1);
  setup();
}

void init() {
  object ob = this_player();
  MAZE_D->go(ob, query("maze"), query("x"), query("y"));

  add_action("do_mmap", "mmap");
}

int do_mmap(string arg) {
  object me = this_player();
  if (!wizardp(me) && time() - me->query_temp("maze/last_mmap") < 3) {
    write(HIW "你想回忆一下地图，可是脑力不够用。。。\n" NOR);
    return 1;
  }
  me->set_temp("maze/last_mmap", time());
  write(HIW "你努力回忆走过的路，在脑海中绘出一幅地图：\n" NOR);
  write("\n " + query("maze_name") + "\n");
  if (!wizardp(me))
    me->start_busy(1);
  MAZE_D->draw_maze(me, query("maze"), 50, 20);
  return 1;
}
