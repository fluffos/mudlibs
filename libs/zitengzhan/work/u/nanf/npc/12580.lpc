void dn_input_amount()
{
	write(BLK"\n主菜单 >> 赞助登记  >> 六、赞助金额\n"NOR);
	write(GRN"\n请输入你赞助的"RED"金额"GRN"（单位为元），输入"CYN"q"GRN"放弃。\n"NOR);
	input_to("dn_input_amount_ok");
}

void dn_input_amount_ok(string arg)
{
	int amount;
	object ob = this_player();
	if(arg == "q" || arg == "Q")
	{
		ob->delete_temp("donate");
		write(CYN"\n你放弃赞助服务器。\n"NOR);
		dn_choices();
		return;
	}
	sscanf(arg, "%d", amount);
	if(amount<100)
	{
		write(CYN"\n每笔最低赞助额为100元人民币。\n"NOR);
		dn_input_amount();
		return;
	}
	ob->set_temp("donate/dn_amount", amount);
	dn_final_ensurance();
}

void dn_final_ensurance()
{
	object ob = this_player();
	string name, open, bank, card, msg;
	int amount;

	write(BLK"\n主菜单 >> 赞助登记  >> 七、最终确认\n"NOR);

	if( !(name = ob->query_temp("donate/dn_name")) || !(open = ob->query_temp("donate/dn_open")) 
		|| !(bank = ob->query_temp("donate/dn_bank")) || !(card = ob->query_temp("donate/dn_card"))
		|| !(amount = ob->query_temp("donate/dn_amount"))
		)
	{
		msg =  WHT"账户：	" + GRN + name + "（";
		if(open == "YES")
			msg += "公开）\n";
		else
			msg += "匿名）\n";
		msg += WHT"卡号：	" + GRN + card + "（" + bank + "）\n";
		msg += WHT"数目：	" + GRN + amount + "元\n"NOR;

		write(msg);
		write(CYN"\n登记出错了，请重新登记，谢谢！\n"NOR);
		return;
	}
	write(CYN"\n请核对以下信息：\n\n"NOR);
	msg =  WHT"	账户：	" + GRN + name + "（";
	if(open == "YES")
		msg += "公开）\n";
	else
		msg += "匿名）\n";
	msg += WHT"	卡号：	" + GRN + card + "（" + bank + "）\n";
	msg += WHT"	数目：	" + GRN + amount + "元\n"NOR;
	msg += WHT"	赞助id：" + GRN + ob->query("name") + "（" + ob->query("id") + "）\n";

	write(msg);
	
	write(GRN"\n请最后确认一次，是否登记上述赞助意向！"CYN"（y/n）"GRN"\n"NOR);
	input_to("dn_final_ensurance_ok");
}

void dn_final_ensurance_ok(string arg)
{
	object ob = this_player();
	if(arg == "q" || arg == "Q")
	{
		ob->delete_temp("donate");
		write(CYN"\n你放弃赞助服务器。\n"NOR);
		dn_choices();
		return;
	}
	else if(arg == "Y" || arg == "y")
	{
		dn_final();
		return;
	}
	else if(arg == "N" || arg == "n")
	{
		ob->delete_temp("donate");
		write(CYN"\n你放弃赞助服务器。\n"NOR);
		dn_choices();
		return;
	}
	else
	{
		write(RED"\n输入错误！\n"NOR);
		dn_final_ensurance();
		return;
	}
}

void dn_final()
{
	object ob = this_player();
	int period;
	object dnob = new(__DIR__"donate.lpc");
	string name, open, bank, card, msg, id, idname;
	int amount;
	string dir;

	id = ob->query("id");
	idname = ob->query("name");
	if( !(name = ob->query_temp("donate/dn_name")) || !(open = ob->query_temp("donate/dn_open")) 
		|| !(bank = ob->query_temp("donate/dn_bank")) || !(card = ob->query_temp("donate/dn_card"))
		|| !(amount = ob->query_temp("donate/dn_amount"))
		)
	{
		msg =  WHT"账户：	" + GRN + name + "（";
		if(open == "YES")
			msg += "公开）\n";
		else
			msg += "匿名）\n";
		msg += WHT"卡号：	" + GRN + card + "（" + bank + "）\n";
		msg += WHT"数目：	" + GRN + amount + "元\n"NOR;

		write(msg);
		write(CYN"\n登记出错了，请重新登记，谢谢！\n"NOR);
	}
	else
	{
		dnob->restore();
		period = dnob->query("curr_period");

		dir = "period"+period+"/"+"records/"+id+"/"+time()+"/";
		write(dir+"\n");
		dnob->add("period"+period+"/"+"amount_intended",amount);
		dnob->set(dir+"name",name);
		dnob->set(dir+"open",open);
		dnob->set(dir+"bank",bank);
		dnob->set(dir+"card",card);
		dnob->set(dir+"amount",amount);
		dnob->set(dir+"id",id);
		dnob->set(dir+"idname",idname);
		dnob->save();

		write(CYN"\n你的赞助意向已经登记在案，谢谢！\n"NOR);
		write(HIY+BLINK+"\n感谢你对"HIC"大唐西游 "HIM"紫藤站"HIY"的支持！\n"NOR);
		message("channel:chat",HIY"\n\n【服务器赞助】"+HIC+"紫藤善心大使： "+HIG+ob->name()+HIW"慷慨解囊，决定赞助 "HIC"大唐西游 "HIM"紫藤站 "HIW"服务器，特此表示感谢！\n\n"NOR,users());
	}

	destruct(dnob);
	dn_choices();
}

void dn_choices()
{
	write(BLK"\n主菜单\n"NOR);
	write(CYN"\n你可以选择 0： 赞助登记   1：我的赞助   2：赞助条款   3：本期简报   4：本期详情   5（或其它）：退出\n\n"NOR);
	if(this_player()->query("id") == "nanf")
	{
		write(CYN"\n9：确认管理\n\n"NOR);
	}
	input_to("dn_choices_ok");
}

void dn_choices_ok(string arg)
{
	int rt;
	if(arg == "0")
	{
		dn_donate_register();
	//	dn_choices();
	}
	else if(arg == "1")
	{
		dn_show_mydonate();
	//	dn_choices();
	}
	else if(arg == "2")
	{
		dn_show_rules();
		dn_choices();
	}
	else if(arg == "3")
	{
		dn_show_brief();
		dn_choices();
	}
	else if(arg == "4")
	{
		rt = dn_show_detail();
		if(this_player()->query("id") == "nanf" && rt)
			dn_super_management();
		else
			dn_choices();
	}
	else if(arg == "9" && this_player()->query("id") == "nanf")
	{
		if(dn_show_apply())
			dn_super_management();
		else
			dn_choices();
	}
	return;

}

void dn_super_management()
{
	write(CYN"\n输入"GRN"识别号+命令+金额+下划线+id"CYN"来"RED"处理"CYN"某条记录，命令包括：\n"NOR);
	write(CYN"	a 确认记录	c 撤销确认	d 删除记录	r 恢复记录，输入"GRN"q"CYN"返回主菜单\n"NOR);
	input_to("dn_super_management_ok");
}

void dn_super_management_ok(string arg)
{
	int index, amount = 0;
	string cmd, did;

	if(arg == "q" || arg == "Q")
	{
		dn_choices();
		return;
	}
	if(sscanf(arg, "%d%s%d_%s", index, cmd, amount, did) !=4 && sscanf(arg, "%d%s_%s", index, cmd, did) != 3
		|| (cmd != "d" && cmd != "a" && cmd != "c" && cmd != "r"))
	{
		write(RED"\n输入错误！\n"NOR);
		dn_super_management();
	}
	else
	{
		dn_super_management_cmd(cmd, index, did, amount);
	}
}

void dn_super_management_cmd(string cmd, int index, string did, int amount)
{
	int period;
	mapping idrecord;
	object dnob;
	int amount_intended;
	string rid;

	rid = ""+index;

	if(cmd == "d")
	{
		dnob = new(__DIR__"donate.lpc");
		dnob->restore();
		period = dnob->query("curr_period");
		idrecord = dnob->query("period"+period+"/records/"+did);

		if(!idrecord[rid])
		{
			write(RED"\n没有识别号为"+rid+"的记录！\n"NOR);
		}
		else
		{
			if(idrecord[rid]["confirmed_amount"] > 0)
			{
				write(RED"\n不能删除已经确认的记录，请先撤销其确认记录！\n"NOR);
			}
			else
			{
				amount_intended = idrecord[rid]["amount"];
				dnob->add("period"+period+"/amount_intended",-1*amount_intended);
				dnob->set("period"+period+"/records/"+did+"/"+rid+"/deleted",1);
				dnob->save();
			}
		}
		destruct(dnob);
		dn_show_detail();
		dn_super_management();
	}
	else if(cmd == "a")
	{
		dnob = new(__DIR__"donate.lpc");
		dnob->restore();
		period = dnob->query("curr_period");
		idrecord = dnob->query("period"+period+"/records/"+did);

		if(amount<=0)
		{
			write(RED"\n确认金额必须大于0！\n"NOR);
		}
		else if(!idrecord[rid])
		{
			write(RED"\n没有识别号为"+rid+"的记录！\n"NOR);
		}
		else
		{
			if(!idrecord[rid]["apply_time"] > 0)
			{
				write(RED"\n该记录没有申请确认！\n"NOR);
			}
			else if(idrecord[rid]["confirmed_amount"] > 0)
			{
				write(RED"\n该记录已经确认过，不需要再申请确认！\n"NOR);
			}
			else
			{
				dnob->add("period"+period+"/amount_confirmed",amount);
				dnob->set("period"+period+"/records/"+did+"/"+rid+"/confirmed_amount",amount);
				dnob->save();
			}
		}
		destruct(dnob);
		dn_show_detail();
		dn_super_management();
	}
	else if(cmd == "c")
	{
		dnob = new(__DIR__"donate.lpc");
		dnob->restore();
		period = dnob->query("curr_period");
		idrecord = dnob->query("period"+period+"/records/"+did);

		if(!idrecord[rid])
		{
			write(RED"\n没有识别号为"+rid+"的记录！\n"NOR);
		}
		else
		{
			if(idrecord[rid]["confirmed_amount"] <= 0)
			{
				write(RED"\n该记录尚未确认，无需撤销！\n"NOR);
			}
			else
			{
				dnob->add("period"+period+"/amount_confirmed",-1*idrecord[rid]["confirmed_amount"]);
				dnob->delete("period"+period+"/records/"+did+"/"+index+"/confirmed_amount");
				dnob->save();
			}
		}
		destruct(dnob);
		dn_show_detail();
		dn_super_management();
	}
	else if(cmd == "r")
	{
		dnob = new(__DIR__"donate.lpc");
		dnob->restore();
		period = dnob->query("curr_period");
		idrecord = dnob->query("period"+period+"/records/"+did);

		if(!idrecord[rid])
		{
			write(RED"\n没有识别号为"+rid+"的记录！\n"NOR);
		}
		else
		{
			if(!idrecord[rid]["deleted"])
			{
				write(RED"\n该记录没有被删除，无需恢复！\n"NOR);
			}
			else
			{
				amount_intended = idrecord[rid]["amount"];
				dnob->add("period"+period+"/amount_intended",amount_intended);
				dnob->delete("period"+period+"/records/"+did+"/"+index+"/deleted");
				dnob->save();
			}
		}
		destruct(dnob);
		dn_show_detail();
		dn_super_management();
	}
	else
	{
		write("error command "+ cmd + "\n");
	}
}

void dn_donate_register()
{
	int period, amount_needed, amount_intended, amount_confirmed;
	object dnob = new(__DIR__"donate.lpc");
	dnob->restore();
	if( ! (period = dnob->query("curr_period")) )
	{
		period = 1;
		amount_intended = 0;
		amount_confirmed = 0;
		dnob->set("curr_period",1);
		dnob->set("period1/amount_intended",0);
		dnob->set("period1/amount_confirmed",0);
		dnob->set("period1/amount_needed",NEED_AMOUNT);
		dnob->save();
	}
	amount_intended = dnob->query("period"+period+"/amount_intended");
	amount_confirmed = dnob->query("period"+period+"/amount_confirmed");
	amount_needed = dnob->query("period"+period+"/amount_needed");

	destruct(dnob);


	// 如果赞助额已经满了
	if(amount_confirmed>=amount_needed)
	{
		write(BLK"\n主菜单 >> 赞助登记 >> 停止登记\n"NOR);
		write(GRN"感谢您对大唐西游 紫藤站的支持，由于实际汇款已达到需求，目前"RED"已经"GRN"停止接受登记。\n"NOR);
	}
	// 如果赞助意向已经达到上限
	else if(amount_intended>=amount_needed && amount_confirmed<amount_needed)
	{
		write(BLK"\n主菜单 >> 赞助登记  >> 暂停登记\n"NOR);
		write(GRN"\n感谢您对大唐西游 紫藤站的支持，由于赞助意向已经达到需求，目前"RED"暂时"GRN"停止接受登记。\n"NOR);
		write(GRN"\n若已登记赞助意向未能在规定时间内汇款并确认，登记记录将被"RED"清除"GRN"，届时您可以继续登记。\n"NOR);
	}
	else
	{
		dn_show_rules();
	//	write(BLK"\n主菜单 >> 赞助登记\n"NOR);
		dn_makesure_rules();
	}
}
