void create()
{
	set_name(MAG"紫藤"WHT"善心大使"NOR, ({ "kind hearted", "kind", "shanxin dashi", "dashi" }) );
	set("nickname", HIG "一问我帮您"NOR);
	set ("long", @LONG
传说中的大好人，外号12580，一问我帮您。
LONG);
	set("gender", "男性");
	set("title",HIW"12580"NOR);
	set("age", 21);
	set("per", 40);
	set("attitude", "peaceful");
	set("shen_type", 1);
	set("max_kee", 10000);
	set("max_sen", 10000);
	set("force", 100000);
	set("max_force", 20000);
	set("force_factor", 1000);
	set("max_mana", 20000);
	set("mana", 100000);
	set("mana_factor", 1000);
	set("combat_exp", 50000000);
	set("daoxing", 50000000);

	set("inquiry", ([
		"修改自创招式":(:do_zcname:),
		"修改雷劫法则":(:do_djtype:),
		"服务器赞助登记":(:do_donate:),
		"donate":(:do_donate:),
	]));
	setup();
//	broadcast();
}

void broadcast()
{
	int period, amount_needed, amount_intended, amount_confirmed;
	object dnob = new(__DIR__"donate.lpc");
	remove_call_out("broadcast");
	dnob->restore();
	if( ! (period = dnob->query("curr_period")) )
	{
		period = 1;
		amount_intended = 0;
		amount_confirmed = 0;
		dnob->set("curr_period",1);
		dnob->set("period1/amount_intended",0);
		dnob->set("period1/amount_confirmed",0);
		dnob->set("period1/amount_needed",NEED_AMOUNT);
		dnob->save();
	}
	amount_intended = dnob->query("period"+period+"/amount_intended");
	amount_confirmed = dnob->query("period"+period+"/amount_confirmed");
	amount_needed = dnob->query("period"+period+"/amount_needed");
	
	destruct(dnob);
	
	if(amount_confirmed<amount_needed)
	{
		message("channel:chat",HIY"\n\n【服务器赞助】"+HIC+"紫藤善心大使： "HIG"第"+period+"期服务器募捐已经正式开始！\n"NOR,users());
		message("channel:chat",HIY"\n\n【服务器赞助】"+HIC+"紫藤善心大使： "HIG"本期的募捐目标为"+amount_needed+"元。\n"NOR,users());
		message("channel:chat",HIY"\n\n【服务器赞助】"+HIC+"紫藤善心大使： "HIG"目前已经登记的赞助意向为"+amount_intended+"元。\n"NOR,users());
		message("channel:chat",HIY"\n\n【服务器赞助】"+HIC+"紫藤善心大使： "HIG"目前已经确认的赞助金额为"+amount_confirmed+"元。\n"NOR,users());
		message("channel:chat",HIY"\n\n【服务器赞助】"+HIC+"紫藤善心大使： "HIG"请kz u w ask kind about donate了解详细情况。\n"NOR,users());
		call_out("broadcast", 120);
	}
}

int do_zcname()
{
	write("你要修改哪一门武功的自创招式（如dragonfight）？\n");
	input_to("zc_skill", this_player());
	return 1;
}
void zc_skill(string arg, object ob)
{
	mapping* actions;
	int i;

	if(! (actions =ob->query("skill_"+arg)) )
	{
		write("你没有这门功夫的自创招式。\n");
		return;
	}
	ob->set_temp("skill_modify", arg);
	write("选择你要修改的招式序号：\n");
	for(i=0;i<sizeof(actions);i++)
	{
		write(i+1+" "+actions[i]["name"]+"  (需花费武学"+10000*(i+1)+")""\n");
	}
	input_to("zc_order", ob);
}
void zc_order(string arg, object ob)
{
	mapping* actions;
	int order;

	if( !(actions =ob->query("skill_"+ob->query_temp("skill_modify"))) )
	{
		write("你没有这门功夫的自创招式。\n");
		ob->delete_temp("skill_modify");
		return;
	}
	sscanf(arg, "%d", order);
	if(order<1 || order>sizeof(actions))
	{
		write("输入的序号不对。\n");
		ob->delete_temp("skill_modify");
		return;
	}
	ob->set_temp("order_modify",order-1);
	write("为这一招起一个新名字。（4到8个中文字符）\n");
	input_to("zc_name",ob);
}
void zc_name(string arg, object ob)
{
	mapping* actions;
	int i=strlen(arg);
	int order=ob->query_temp("order_modify");
	string *banned_name = ({
		"你", "你", "我", "他", "她", "它", "爸", "妈",
			"爷", "奶", "巫师", "天神", "神仙", "南疯",
	});

	if( !(actions =ob->query("skill_"+ob->query_temp("skill_modify"))) )
	{
		write("你没有这门功夫的自创招式。\n");
		ob->delete_temp("skill_modify");
		ob->delete_temp("order_modify");
		return;
	}

	if (!arg || arg=="") 
	{
		write("为这一招起一个新名字。（4到8个中文字符）\n");
		input_to( "zc_name", ob);
		return;
	}
	else while(i--) 
	{
		if( arg[i]<=' ' ) 
		{
			write("招式名字不能使用控制字元，请重新想一个名字。\n");      
			input_to( "zc_name", ob);
			return;
		}
		if(strsrch(arg, "　") >= 0) 
		{
			write("招式名字不能有格，请重新想一个名字。。\n");
			input_to( "zc_name", ob);
			return;
		}
		if( i%2==0 && !is_chinese(arg[i..<0]) ) 
		{
			write("请用「中文」为你的新招式取名字：\n");
			input_to( "zc_name", ob);
			return;
		}
	}
	if( member_array(arg, banned_name)!=-1 ) 
	{
		write("对不起，这种名字会造成其他人的困扰。请重新设定一个名字：");
		input_to( "zc_name", ob);
		return;
	}
	if( (strlen(arg) < 8) || (strlen(arg) > 16 ) ) 
	{
		write("对不起，招式名字必须是 4 到 8 个中文字：");
		input_to( "zc_name", ob);
		return;
	}
	actions[order]["action"]=replace_string(actions[order]["action"],actions[order]["name"], arg);
	actions[order]["name"] = arg;
	ob->set("skill_"+ob->query_temp("skill_modify"), actions);
	ob->add("combat_exp", -10000*(ob->query_temp("order_modify")+1));
	if(ob->query("combat_exp")<0)
		ob->set("combat_exp",0);
	ob->delete_temp("skill_modify");
	ob->delete_temp("order_modify");
	write("修改成功！\n");
}
int do_djtype()
{
	int lv;
	object ob = this_player();
	lv = ob->query("dujie/level");
	if(lv!=4 && lv!=5)
	{
		write("只有在度过第4劫或者第5劫时才能修改雷劫法则。\n");
		return 1;
	}
	if(ob->query("dujie/mod"+lv))
	{
		write("第"+lv+"劫你已经修改过法则了，只有一次机会。\n");
		return 1;
	}
	write("在第"+lv+"劫修改法则类型，需要"HIY"耗费"+(9-lv)+"000000武学和"+COMBAT_D->chinese_daoxing((9-lv)*1000000)+"道行。"NOR
				+"\n\n你确定要修改吗？(y确认，或任意其它字符取消。)\n");
	input_to("dj_confirm",ob);
	return 1;
}

void dj_confirm(string arg, object ob)
{
	if(arg=="Y"||arg=="y")
		dj_giveup(ob);
	else
		write("你放弃修改法则！\n");
}

void dj_giveup(object ob)
{
	int i,lv;
	write("你要放弃一级哪种法则，请输入相应的"HIW"代号"NOR"，或输入"HIW"q"NOR"放弃。\n");
	write("已经学会的法则：\n");
	if((lv=ob->query("dujie/life"))>0)
		write("生命法则："+lv+"级		"HIY"（代号：life）"NOR"\n");
	if((lv=ob->query("dujie/power"))>0)
		write("毁灭法则："+lv+"级		"HIY"（代号：power）"NOR"\n");
	if((lv=ob->query("dujie/time"))>0)
		write("时间法则："+lv+"级		"HIY"（代号：time）"NOR"\n");
	input_to("dj_giveup_ok",ob);
}

void dj_giveup_ok(string arg, object ob)
{
	string msg;
	if(arg=="Q" || arg=="q")
	{
		write("你放弃修改法则！\n");
		return;
	}
	else if( (arg=="life" || arg=="time" || arg=="power") && ob->query("dujie/"+arg)>0 )
	{
		ob->set_temp("fz_modify",arg);
		msg = "你选择放弃一级";
		if(arg == "life")
			msg+="生命";
		else if(arg == "time")
			msg+="时间";
		else if(arg == "power")
			msg+="毁灭";
		msg+="法则。\n";
		write(msg);
		dj_add(ob);
	}
	else
	{
		write("输入错误！\n");
		dj_giveup(ob);
	}
}

void dj_add(object ob)
{
	int i,lv;
	write("你要增加一级哪种法则，请输入相应的"HIW"代号"NOR"，或输入"HIW"q"NOR"放弃。\n");
	write("生命法则		"HIY"（代号：life）"NOR"\n");
	write("毁灭法则		"HIY"（代号：power）"NOR"\n");
	write("时间法则		"HIY"（代号：time）"NOR"\n");
	input_to("dj_add_ok",ob);
}

void dj_add_ok(string arg, object ob)
{
	string msg;
	if(arg=="Q" || arg=="q")
	{
		write("你放弃修改法则！\n");
		ob->delete_temp("fz_modify");
		return;
	}
	else if( arg=="life" || arg=="time" || arg=="power" )
	{
		ob->set_temp("fz_add",arg);
		msg = "你选择增加一级";
		if(arg == "life")
			msg+="生命";
		else if(arg == "time")
			msg+="时间";
		else if(arg == "power")
			msg+="毁灭";
		msg+="法则。\n";
		write(msg);
		dj_final_confirm(ob);
	}
	else
	{
		write("输入错误！\n");
		dj_add(ob);
	}
}

void dj_final_confirm(object ob)
{
	string modify,add,msg;
	int lv;
	modify = ob->query_temp("fz_modify");
	add = ob->query_temp("fz_add");
	lv = ob->query("dujie/level");
	
	msg = "你要降低一级";
	if(modify == "life")
		msg+="生命";
	else if(modify == "time")
		msg+="时间";
	else if(modify == "power")
		msg+="毁灭" ;
	msg+="法则，提升一级";
	if(modify == "life")
		msg+="生命";
	else if(modify == "time")
		msg+="时间";
	else if(modify == "power")
		msg+="毁灭" ;
	msg+="法则。\n";
	write(msg);
	write("代价为"HIY+(9-lv)+"000000武学和"+COMBAT_D->chinese_daoxing((9-lv)*1000000)+"道行。"NOR
				+"\n\n请再确认一次。(y确认，或任意其它字符取消。)\n");
	input_to("dj_final_ok",ob);
}

void dj_final_ok(string arg,object ob)
{
	string modify,add,msg;
	int lv,cost;
	if(arg=="Y"||arg=="y")
	{
		modify = ob->query_temp("fz_modify");
		add = ob->query_temp("fz_add");
		lv = ob->query("dujie/level");
		cost = (9-lv)*1000000;
		ob->delete_temp("fz_modify");
		ob->delete_temp("fz_add");
		if(modify!="life" && modify!="time" && modify!="power" || add!="life" && add!="time" && add!="power")
		{
			write("出错了，放弃修改法则。\n");
			return;
		}
		if(ob->query("dujie/"+modify)<1)
		{
			write("出错了，放弃修改法则。\n");
			return;
		}
		if(lv!=4 && lv!=5)
		{
			write("出错了，放弃修改法则。\n");
			return;
		}
		if(ob->query("combat_exp")<cost || ob->query("daoxing")<cost)
		{
			write("你的经验不够，放弃修改法则。\n");
			return;
		}
		ob->set("dujie/mod"+lv,1);
		ob->add("combat_exp",-1*cost);
		ob->add("daoxing",-1*cost);
		ob->add("dujie/"+modify,-1);
		if(ob->query("dujie/"+modify)==0)
			ob->delete("dujie/"+modify);
		ob->add("dujie/"+add,1);
		ob->save();
		write("修改完毕！\n");
	}
	else
		write("你放弃修改法则！\n");
}

void dn_show_rules()
{

	write(BLK"\n主菜单 >> 赞助条款\n"NOR);

	write(YEL"\n服务器赞助条款及注意事项：\n\n"NOR);
	write(WHT"1.	所有赞助出于自愿；\n\n"NOR);
	write(WHT"2.	赞助仅给予象征性奖励——生命宝石、赞助头衔以及提供名单供查；\n\n"NOR);
	write(WHT"3.	赞助总计达到4500元时（4400元服务器租用费+100元域名费用），停止接受赞助；\n\n"NOR);
	write(WHT"4.	若无法凑足一年租用期所需费用，尝试2500元半年期费用；\n\n"NOR);
	write(WHT"5.	若无法凑足半年租用期所需费用，退还所有赞助，接受赞助时间定为一个月；\n\n"NOR);
	write(WHT"6.	为避免退款繁琐，每笔最低赞助额为100元人民币；\n\n"NOR);
	write(WHT"7.	租用服务器的服务商网站http://idc.bylee.cc；\n\n"NOR);
	write(WHT"8.	赞助方法为：在此处登记赞助数目后，通过转帐汇款相同金额，然后申请确认；\n\n"NOR);
    write(WHT"9.      接收汇款的帐户为nanf私人账户（工行），卡号：6282 8800 0010 6949，户名：房鹤；\n\n"NOR);
	write(WHT"10.	登记时要写明汇款帐户的户名和卡号，便于确认汇款和退还赞助；\n\n"NOR);
	write(WHT"11.	登记后望尽快汇款，超过120小时没有得到确认的，将自动清除登记记录；\n\n"NOR);
	write(WHT"12.	汇款数目尽量与登记数额相同，避免为确认带来麻烦；\n\n"NOR);
	write(WHT"13.	没有登记成功请勿汇款，汇款前请确认您的登记有效（未被清除）；\n\n"NOR);
	write(WHT"14.	未尽事宜，协商解决。\n"NOR);
}

void dn_show_brief()
{
	int period, amount_needed, amount_intended, amount_confirmed;
	object dnob = new(__DIR__"donate.lpc");

	write(BLK"\n主菜单 >> 本期简报\n"NOR);

	dnob->restore();
	if( ! (period = dnob->query("curr_period")) )
	{
		period = 1;
		amount_intended = 0;
		amount_confirmed = 0;
		dnob->set("curr_period",1);
		dnob->set("period1/amount_intended",0);
		dnob->set("period1/amount_confirmed",0);
		dnob->set("period1/amount_needed",NEED_AMOUNT);
		dnob->save();
	}
	amount_intended = dnob->query("period"+period+"/amount_intended");
	amount_confirmed = dnob->query("period"+period+"/amount_confirmed");
	amount_needed = dnob->query("period"+period+"/amount_needed");
	
	destruct(dnob);

	write(HIW"\n【本期简报】\n"NOR);
	write("\n");
	write(MAG"\n	目前处于"GRN"第"+chinese_number(period)+"期"MAG"服务器赞助筹款区间；\n\n"NOR);
	write(MAG"\n	本期"GRN"赞助需求"MAG"为"+CYN+chinese_number(amount_needed)+MAG"元；\n"NOR);
	write(MAG"\n	目前"GRN"赞助意向"MAG"已经累计达到"+CYN+chinese_number(amount_intended)+MAG"元；\n"NOR);
	write(MAG"\n	目前"GRN"赞助汇款"MAG"经确认数目达到"+CYN+chinese_number(amount_confirmed)+MAG"元。\n"NOR);
	write("\n\n");
}

string dn_calc_time(int arg)
{
	string e_time, week, month, year;
	string c_time;
	int day, hour, minute, second;
	string *month_name = ({"Jan","Feb","Mar","Apr","May","Jun","Jul",
		"Aug","Sep","Oct","Nov","Dec"});
	string *week_name = ({"Mon","Tue","Wed","Thu","Fri","Sat","Sun"});

	e_time = ctime(arg);

	sscanf(e_time,"%s %s %d %d:%d:%d %s", week, month, day, hour, minute, second, year);

	c_time = sprintf("%04s-%02d-%d %02s:%02s", year, member_array(month, month_name), day, hour+"", minute+"");
	return c_time;
}

int dn_show_detail()
{
	object ob = this_player();
	int period, amount_needed, amount_intended, amount_confirmed;
	object dnob = new(__DIR__"donate.lpc");
	mapping records;
	mapping idrecord;
	mapping record;
	string *keys_records;
	string *keys_idrecord;
	string key_records;
	string key_idrecord;
	string name, open, bank, card, id, idname, msg, confirm;
	int amount, deleted;

	write(BLK"\n主菜单 >> 本期详情\n"NOR);

	dnob->restore();
	if( ! (period = dnob->query("curr_period")) )
	{
		period = 1;
		amount_intended = 0;
		amount_confirmed = 0;
		dnob->set("curr_period",1);
		dnob->set("period1/amount_intended",0);
		dnob->set("period1/amount_confirmed",0);
		dnob->set("period1/amount_needed",NEED_AMOUNT);
		dnob->save();
	}
	amount_intended = dnob->query("period"+period+"/amount_intended");
	amount_confirmed = dnob->query("period"+period+"/amount_confirmed");
	amount_needed = dnob->query("period"+period+"/amount_needed");

	write(HIW"\n【本期详情】\n"NOR);
	records = dnob->query("period"+period+"/records");
	if(!records)
	{
		write(GRN"		本期还没有人登记过赞助意向。\n"NOR);
		destruct(dnob);
		return 0;
	}
	else
	{
		keys_records = keys(records);
		write(HIW"\n------------------------------------------------------------------------------------------------------------------\n"NOR);
		if(ob->query("id") == "nanf")
			write( sprintf(BLU"\n	%-15s%-12s%-10s%-40s%-18s%-10s\n"NOR, "识别号", "赞助人", "金额", "卡号（银行）", "登记时间", "确认状况") );
		else
			write( sprintf(BLU"\n	%-12s%-10s%-40s%-18s%-10s\n"NOR, "赞助人", "金额", "卡号（银行）", "登记时间", "确认状况") );
		foreach(key_records in keys_records)
		{
			write(BLK"\n------------------------------------------------------------------------------------------------------------------------\n"NOR);
			write(HIG+"\n "+key_records+"\n"NOR);
			idrecord = records[key_records];
			keys_idrecord = keys(idrecord);
			foreach(key_idrecord in keys_idrecord)
			{
				// write(CYN+key_idrecord+"\n");
				record = idrecord[key_idrecord];
				name = record["name"];
				open = record["open"];
				bank = record["bank"];
				card = record["card"];
				amount = record["amount"];
				id = record["id"];
				idname = record["idname"];
				deleted = record["deleted"];
				
				if(open != "YES")
					name = "匿名";
				if(ob->query("id") != id && ob->query("id") != "nanf")
				{
					card = "******";
					bank = "**";
				}
				if(!record["apply_time"])
					confirm = HIW"尚未申请确认"NOR+CYN;
				else if(!record["confirmed_amount"])
					confirm = HIM"已申请，尚未确认"NOR+CYN;
				else
					confirm = HIY"确认金额"+chinese_number(record["confirmed_amount"])+"元"NOR+CYN;
				if(ob->query("id") == "nanf")
				{
					if(!deleted)
						write( sprintf(CYN"\n	%-15s%-12s%-10s%-40s%-18s%-10s\n"NOR, key_idrecord, name, amount+"", card+"（"+bank+"）", dn_calc_time(to_int(key_idrecord)), confirm) );
					else
						write( sprintf(CYN"\n	"BYEL"%-15s%-12s%-10s%-40s%-18s%-10s\n"NOR, key_idrecord, name, amount+"", card+"（"+bank+"）", dn_calc_time(to_int(key_idrecord)), NOR+BLINK+HIR"已过期失效！"CYN ));
				}

				else
					write( sprintf(CYN"\n	%-12s%-10s%-40s%-18s%-10s\n"NOR, name, amount+"", card+"（"+bank+"）", dn_calc_time(to_int(key_idrecord)), confirm) );
			}
		}

		write(HIW"\n\n------------------------------------------------------------------------------------------------------------------\n"NOR);
		destruct(dnob);
		return 1;
	}
}

int dn_show_apply()
{
	object ob = this_player();
	int period, amount_needed, amount_intended, amount_confirmed;
	object dnob = new(__DIR__"donate.lpc");
	mapping records;
	mapping idrecord;
	mapping record;
	string *keys_records;
	string *keys_idrecord;
	string key_records;
	string key_idrecord;
	string name, open, bank, card, id, idname, msg, info;
	int amount, apply_time;
	int rt = 0;

	write(BLK"\n主菜单 >> 确认管理\n"NOR);

	dnob->restore();
	if( ! (period = dnob->query("curr_period")) )
	{
		period = 1;
		amount_intended = 0;
		amount_confirmed = 0;
		dnob->set("curr_period",1);
		dnob->set("period1/amount_intended",0);
		dnob->set("period1/amount_confirmed",0);
		dnob->set("period1/amount_needed",NEED_AMOUNT);
		dnob->save();
	}
	amount_intended = dnob->query("period"+period+"/amount_intended");
	amount_confirmed = dnob->query("period"+period+"/amount_confirmed");
	amount_needed = dnob->query("period"+period+"/amount_needed");

	write(HIW"\n【确认管理】\n"NOR);
	records = dnob->query("period"+period+"/records");
	if(!records) 
	{
		write(GRN"		本期还没有人登记过赞助意向。\n"NOR);
		destruct(dnob);
		return 0;
	}
	else
	{
		keys_records = keys(records);
		info = HIW"\n-------------------------------------------------------------------------------------------------------------------------------------\n"NOR;
		info += sprintf(BLU"\n	%-12s%-10s%-40s%-18s%-10s\n"NOR, "赞助人", "金额", "卡号（银行）", "登记时间", "申请确认时间") ;
		foreach(key_records in keys_records)
		{
			info += BLK"\n-------------------------------------------------------------------------------------------------------------------------------------------\n"NOR;
			info += HIG+"\n "+key_records+"\n"NOR;
			idrecord = records[key_records];
			keys_idrecord = keys(idrecord);
			foreach(key_idrecord in keys_idrecord)
			{
				record = idrecord[key_idrecord];
				if(!record["apply_time"] || record["confirmed_amount"])
					continue;
				rt = 1;
				name = record["name"];
				open = record["open"];
				bank = record["bank"];
				card = record["card"];
				amount = record["amount"];
				id = record["id"];
				idname = record["idname"];
				apply_time = record["apply_time"];

				if(open != "YES")
					name = "匿名";
				if(ob->query("id") != id && ob->query("id") != "nanf")
				{
					card = "******";
					bank = "**";
				}
				info += sprintf(CYN"\n	%-12s%-10s%-40s%-18s%-10s\n"NOR, name, amount+"", card+"（"+bank+"）", dn_calc_time(to_int(key_idrecord)), dn_calc_time(apply_time));
			}
		}

		info += HIW"\n\n-------------------------------------------------------------------------------------------------------------------------------------\n"NOR;
		destruct(dnob);
		if(rt)
			write(info);
		else
			write(GRN"		本期还没有人申请确认记录。\n"NOR);
		return rt;
	}
}

void dn_show_mydonate()
{
	object ob = this_player();
	object dnob;
	mapping idrecord;
	mapping record;
	string *keys_idrecord;
	string key_idrecord;
	int period;
	string name, open, bank, card, id, idname, msg, confirm;
	int amount;
	int i=0;

	write(BLK"\n主菜单 >> 我的赞助\n"NOR);
	
	id = ob->query("id");
	dnob = new(__DIR__"donate.lpc");
	dnob->restore();
	period = dnob->query("curr_period");
	if(! (idrecord = dnob->query("period"+period+"/records/"+id)))
	{
		write(GRN"\n		没有以"+id+"名义登记过赞助意向。\n"NOR);
		dn_choices();
	}
	else
	{
		if( ! (period = dnob->query("curr_period")) )
		{
			period = 1;
			dnob->set("curr_period",1);
			dnob->set("period1/amount_intended",0);
			dnob->set("period1/amount_confirmed",0);
			dnob->set("period1/amount_needed",NEED_AMOUNT);
			dnob->save();
		}

		write(HIW"\n【"+HIG+id+HIW"的赞助】\n"NOR);
		write( sprintf(BLU"\n	%-15s%-12s%-10s%-40s%-18s%-10s\n"NOR, "识别号", "赞助人", "金额", "卡号（银行）", "登记时间", "确认状况") );
		write(HIW"\n------------------------------------------------------------------------------------------------------------------\n"NOR);

		keys_idrecord = keys(idrecord);
		foreach(key_idrecord in keys_idrecord)
		{
			// write(CYN+key_idrecord+"\n");
			record = idrecord[key_idrecord];
			name = record["name"];
			open = record["open"];
			bank = record["bank"];
			card = record["card"];
			amount = record["amount"];
			id = record["id"];
			idname = record["idname"];

			if(open != "YES")
				name = "匿名";
			if(ob->query("id") != id && ob->query("id") != "nanf")
			{
				card = "******";
				bank = "**";
			}
			if(!record["apply_time"])
				confirm = HIW"尚未申请确认"NOR+CYN;
			else if(!record["confirmed_amount"])
				confirm = HIM"已申请，尚未确认"NOR+CYN;
			else
				confirm = HIY"确认金额"+chinese_number(record["confirmed_amount"])+"元"NOR+CYN;
			write( sprintf(CYN"\n	%-15s%-12s%-10s%-40s%-18s%-10s\n"NOR, key_idrecord, name, amount+"", card+"（"+bank+"）", dn_calc_time(to_int(key_idrecord)), confirm) );
		}

		write(HIW"\n------------------------------------------------------------------------------------------------------------------\n"NOR);
		destruct(dnob);
		dn_manage_record();
	}
}

void dn_manage_record()
{
	write(CYN"\n输入"GRN"识别号+a"CYN"来"RED"申请确认"CYN"某条记录，如1297816847a命令申请确认识别号为1297816847的记录。\n"NOR);
	write(CYN"\n输入"GRN"识别号+c"CYN"来"RED"撤销确认申请"CYN"，如1297816847c命令撤销识别号为1297816847的记录的确认申请。\n"NOR);
	write(CYN"\n输入"GRN"识别号+d"CYN"来"RED"删除"CYN"某条登记记录，如1297816847d命令删除识别号为1297816847的记录。\n"NOR);
	write(CYN"\n输入"GRN"q"CYN"返回主菜单。\n"NOR);

	write(CYN"\n注意１："GRN"已经确认"CYN"的记录"RED"无法删除"CYN"。\n"NOR);
	write(CYN"\n注意２："GRN"已经汇款"CYN"但"GRN"尚未确认"CYN"的记录"RED"切毋删除"CYN"。\n"NOR);
	input_to("dn_manage_record_ok");
	return;
}

void dn_manage_record_ok(string arg)
{
	int index;
	string cmd;

	if(arg == "q" || arg == "Q")
	{
		dn_choices();
		return;
	}
	if (sscanf(arg, "%d%s", index, cmd) !=2 || (cmd != "d" && cmd != "a" && cmd != "c"))
	{
		write(RED"\n输入错误！\n"NOR);
		dn_show_mydonate();
	}
	else
	{
		dn_manage_record_confirm(index,cmd);
	}
}

void dn_manage_record_confirm(int index,string cmd)
{
	if(cmd == "d")
	{
		write(CYN"\n确定删除识别号为"+index+"的记录？"GRN"（y/n）"CYN"\n"NOR);
		input_to("dn_manage_record_confirm_ok",this_player(), 0, cmd, index);
	}
	else if(cmd == "a")
	{
		write(CYN"\n确定对识别号为"+index+"的记录进行确认申请？"GRN"（y/n）"CYN"\n"NOR);
		input_to("dn_manage_record_confirm_ok",this_player(), 0, cmd, index);
	}
	else if(cmd == "c")
	{
		write(CYN"\n确定对识别号为"+index+"的记录进行撤销确认申请？"GRN"（y/n）"CYN"\n"NOR);
		input_to("dn_manage_record_confirm_ok",this_player(), 0, cmd, index);
	}
}

void dn_manage_record_confirm_ok(string arg, object ob, int opt, string cmd, int index)
{
	int period;
	mapping idrecord;
	object dnob;
	int amount;
	string rid;

	rid = ""+index;
	
	if(cmd == "d")
	{
		if(arg == "y" || arg == "Y")
		{
			dnob = new(__DIR__"donate.lpc");
			dnob->restore();
			period = dnob->query("curr_period");
			idrecord = dnob->query("period"+period+"/records/"+ob->query("id"));

			if(!idrecord[rid])
			{
				write(RED"\n没有识别号为"+rid+"的记录！\n"NOR);
			}
			else
			{
				if(idrecord[rid]["confirmed_amount"] > 0)
				{
					write(RED"\n不能删除已经确认的记录！\n"NOR);
				}
				else
				{
					amount = idrecord[rid]["amount"];
					dnob->add("period"+period+"/amount_intended",-1*amount);
					if(sizeof(idrecord) == 1)
						dnob->delete("period"+period+"/records/"+ob->query("id"));
					else
						dnob->delete("period"+period+"/records/"+ob->query("id")+"/"+rid);
					dnob->save();
				}
			}
			destruct(dnob);
			dn_show_mydonate();
		}
		else
		{
			dn_show_mydonate();
		}
	}
	else if(cmd == "a")
	{
		if(arg == "y" || arg == "Y")
		{
			dnob = new(__DIR__"donate.lpc");
			dnob->restore();
			period = dnob->query("curr_period");
			idrecord = dnob->query("period"+period+"/records/"+ob->query("id"));

			if(!idrecord[rid])
			{
				write(RED"\n没有识别号为"+rid+"的记录！\n"NOR);
			}
			else
			{
				if(idrecord[rid]["confirmed_amount"] > 0)
				{
					write(RED"\n该记录已经确认过，不需要再申请确认！\n"NOR);
				}
				else if(idrecord[rid]["apply_time"])
				{
					write(RED"\n该记录已经申请确认了，不要再重复申请！\n"NOR);
				}
				else
				{
					dnob->set("period"+period+"/records/"+ob->query("id")+"/"+rid+"/apply_time",time());
					dnob->save();
				}
			}
			destruct(dnob);
			dn_show_mydonate();
		}
		else
		{
			dn_show_mydonate();
		}
	}
	else if(cmd == "c")
	{
		if(arg == "y" || arg == "Y")
		{
			dnob = new(__DIR__"donate.lpc");
			dnob->restore();
			period = dnob->query("curr_period");
			idrecord = dnob->query("period"+period+"/records/"+ob->query("id"));

			if(!idrecord[rid])
			{
				write(RED"\n没有识别号为"+rid+"的记录！\n"NOR);
			}
			else
			{
				if(idrecord[rid]["confirmed_amount"] > 0)
				{
					write(RED"\n该记录已经确认了，无法撤销！\n"NOR);
				}
				else if(!idrecord[rid]["apply_time"])
				{
					write(RED"\n该记录尚未申请确认，无需撤销！\n"NOR);
				}
				else
				{
					dnob->delete("period"+period+"/records/"+ob->query("id")+"/"+index+"/apply_time");
					dnob->save();
				}
			}
			destruct(dnob);
			dn_show_mydonate();
		}
		else
		{
			dn_show_mydonate();
		}
	}
	else
	{
		write("error command "+ cmd + "\n");
	}	
}

int do_donate()
{
	dn_choices();
	return 1;
}

void dn_makesure_rules()
{
	write(BLK"\n主菜单 >> 赞助登记  >> 一、阅读条款\n"NOR);
	write(CYN"\n你是否已"GRN"仔细阅读"CYN"并"GRN"同意"CYN"上述条款及注意事项？"CYN"（y/n）"GRN"\n"NOR);
	input_to("dn_makesure_rules_ok");
}

void dn_makesure_rules_ok(string arg)
{
	if(arg == "Y" || arg == "y")
	{
		write(RED"\n好的，请按提示仔细登记。\n"NOR);	
		this_player()->delete_temp("donate");
		dn_input_name_once();
	}
	else if(arg == "N" || arg == "n")
	{
		write(CYN"\n你放弃赞助服务器。\n"NOR);
		dn_choices();
	}
	else
		dn_makesure_rules();
}

void dn_input_name_once()
{
	write(BLK"\n主菜单 >> 赞助登记  >> 二、帐户户名\n"NOR);
	write(GRN"\n请输入你汇款使用的账户的"RED"户名"GRN"（便于确认汇款人及退还赞助），输入"CYN"q"GRN"放弃。\n"NOR);
	input_to("dn_input_name_once_ok");
}

void dn_input_name_once_ok(string arg)
{
	object ob = this_player();
	if(arg == "q" || arg == "Q")
	{
		write(CYN"\n你放弃赞助服务器。\n"NOR);
		dn_choices();
		return;
	}
	if(strlen(arg)>10)
	{
		write(CYN"\n输入户名太长。\n"NOR);
		dn_input_name_once();
		return;
	}
	ob->set_temp("donate/dn_name", arg);
	dn_input_name_twice();
}

void dn_input_name_twice()
{
	write(GRN"\n请"WHT"再次"GRN"输入你汇款使用的账户的"RED"户名"GRN"，输入"CYN"q"GRN"放弃。\n"NOR);
	input_to("dn_input_name_twice_ok");
}

void dn_input_name_twice_ok(string arg)
{
	object ob = this_player();
	if(arg == "q" || arg == "Q")
	{
		ob->delete_temp("donate");
		write(CYN"\n你放弃赞助服务器。\n"NOR);
		dn_choices();
		return;
	}
	if(arg != ob->query_temp("donate/dn_name"))
	{
		write(CYN"\n两次输入的户名不一致。\n"NOR);
		ob->delete_temp("donate/dn_name");
		dn_input_name_once();
		return;
	}
	dn_input_open();
}

void dn_input_open()
{
	write(BLK"\n主菜单 >> 赞助登记  >> 三、公开确认\n"NOR);
	write(GRN"\n你是否愿意"RED"公开"GRN"账户"RED"户名"CYN"（y/n）"GRN"？输入"CYN"q"GRN"放弃。\n"NOR);
	input_to("dn_input_open_ok");
}

void dn_input_open_ok(string arg)
{
	object ob = this_player();
	if(arg == "q" || arg == "Q")
	{
		ob->delete_temp("donate");
		write(CYN"\n你放弃赞助服务器。\n"NOR);
		dn_choices();
		return;
	}
	else if(arg == "Y" || arg == "y")
	{
		ob->set_temp("donate/dn_open","YES");
		dn_input_bank();
	}
	else if(arg == "N" || arg == "n")
	{
		ob->set_temp("donate/dn_open","NO");
		dn_input_bank();
	}
	else
	{
		write(RED"\n输入错误！\n"NOR);
		dn_input_open();
	}
}


