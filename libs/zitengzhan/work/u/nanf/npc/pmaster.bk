#include <ansi.h>
// inherit NPC;
inherit F_DBASE;
inherit F_SAVE;

private string SAVE_NAME="pmaster_save";
private nosave int can_save=1;

void create()
{	
	seteuid(getuid());	
}
string query_save_file()
{
	return sprintf(__DIR__"pmasters");
}

int restore()
{
	string file;
	if( stringp(file = this_object()->query_save_file()) )
		return restore_object(file);
	return 0;
}
void init()
{	
	seteuid(getuid());
}