inherit F_DBASE;

#define DDZ_SIZE 20
int* ddz_tables_state = allocate(DDZ_SIZE);
object* ddz_tables = allocate(DDZ_SIZE);

void create()
{
		seteuid( getuid() );
		set("name","紫藤　棋牌室");
		set("id","club");

		/*for(i=0;i<SIZE;i++)
			ddz_tables_state[i] = 0;*/
}

/*
      桌号是否有效
*/
int ddz_valid_table(int table_number)
{
	if(table_number<0 || table_number>=DDZ_SIZE)
		return 0;
	return 1;
}

/*
      桌子的状态
*/
int ddz_table_state(int table_number)
{
	if(ddz_valid_table(table_number))
		return ddz_tables_state[table_number];
	else
		return -1;
		
}

/*
      设置桌子的状态
*/
void ddz_set_table_state(int table_number, int state)
{
	write(table_number+"\n");
	if(!ddz_valid_table(table_number))
		return;
	ddz_tables_state[table_number] = state;
}

/*
      第一张空闲桌的桌号
*/
int ddz_free_table()
{
	int i;
	for(i=0;i<DDZ_SIZE;i++)
	{
		if(!ddz_tables_state[i])
			return i;
	}
	return -1;
}

/*
      剩余的空闲桌数
*/
int ddz_tables_left()
{
	int i,num=DDZ_SIZE;
	for(i=0;i<DDZ_SIZE;i++)
	{
		if(ddz_tables_state[i])
			--num;
	}
	return num;
}

/*
      创建并返回一个新桌子
*/
object ddz_new_table(int table_number)
{
	object table,judge;
	if(!ddz_valid_table(table_number) )
		return 0;

	if(table = ddz_tables[table_number])
		return table;
	else if(table = new("/u/nanf/room/ddz_table.lpc"))
	{
		ddz_tables_state[table_number] = 1;
		table->set_number(table_number);
		ddz_tables[table_number] = table;
	}
	else 
		return 0;
	
	return table;
}

/*
      销毁一张桌子
*/
void ddz_delete_table(object table)
{
	int table_number = table->query("number");
	if(!ddz_valid_table(table_number))
		return;

	if(table = ddz_tables[table_number])
	{
		ddz_tables_state[table_number] = 0;
		environment(table)->update_free_table_num();
		destruct(table);
	}
}

/*
      返回对应号的桌子对象
*/
object ddz_table(int table_number)
{
	return ddz_tables[table_number];
}