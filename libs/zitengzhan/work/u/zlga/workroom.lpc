int valid_leave(object me, string dir)
{
    if ( dir == "north" )
    {
if ( me->query("id") == "zlga"  || me->query("id") == "zlg"
  || me->query("id") == "pozi"  || me->query("id") == "lying")
		return ::valid_leave(me, dir);
	return notify_fail(HIR"进入人家居室不好吧！\n");
     }
     
     return ::valid_leave(me, dir);       
     
}

