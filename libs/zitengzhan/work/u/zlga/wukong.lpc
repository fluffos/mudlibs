inherit NPC;
#include <ansi.h>

void create() {
  int i, j;
  i = 550;
  j = 50;
  set_name(HIW "孙悟空" NOR, ({ "sun wu kong", "sun" }));
  set("long", @LONG
天生地养一石猴！五百年前大闹天宫的齐天大圣孙悟空！
LONG);
  set("gender", "男性");
  set("title", HIW "齐天大圣" NOR);
  set("age", 30);
  set("attitude", "heroism");
  set("class", "yaomo");
  set("max_kee", 1000000);
  set("max_sen", 1000000);
  set("force", 50000);
  set("max_force", 50000);
  set("force_factor", 350);
  set("max_mana", 20000);
  set("mana", 20000);
  set("mana_factor", 250);
  add_temp("apply/damage", 300 + random(300));
  add_temp("apply/armor", 400 + random(400));
  add_temp("apply/armor_vs_force", 400 + random(400));
  add_temp("apply/armor_vs_spells", 400 + random(400));
  set("combat_exp", 50000000);
  set("daoxing", 50000000);
  set("baolv", 1);
  set("haveexp", 70000);
  set("fangcun/panlong_accept", "done");
  set("fangcun/jldl", "done");
  set("family/family_name", "方寸山三星洞");
  set_skill("unarmed", i + random(j));
  set_skill("dodge", i + random(j));
  set_skill("parry", i + random(j));
  set_skill("force", i + random(j));
  set_skill("spells", i + random(j));
  set_skill("stick", i + random(j));
  set_skill("qianjun-bang", i + random(j));
  set_skill("sword", i + random(j));
  set_skill("liangyi-sword", i + random(j));
  set_skill("jindouyun", i + random(j));
  set_skill("wuxiangforce", i + random(j));
  set_skill("puti-zhi", i + random(j));
  set_skill("dao", i + random(j));

  map_skill("force", "wuxiangforce");
  map_skill("stick", "qianjun-bang");
  map_skill("parry", "qianjun-bang");
  map_skill("spells", "dao");
  map_skill("dodge", "jindouyun");
  map_skill("unarmed", "puti-zhi");
  map_skill("sword", "liangyi-sword");
  setup();
  carry_object("/d/obj/weapon/stick/fake-jingubang.lpc")->wield();
}

void init() {
  object me = this_object();
  object who = this_player();
  ::init();
  add_action("do_no", "ji");
  add_action("do_qk", "cast");
  /*
if(who->query("family/family_name")=="东海龙宫"
       ||who->query("family/family_name")=="大雪山"
       ||who->query("family/family_name")=="陷空山无底洞"
       ||who->query("family/family_name")=="将军府"
       ||who->query("family/family_name")=="月宫"
       ||who->query("family/family_name")=="阎罗地府")
      {
*/
  message_vision("$N看见$n，大喝一声：敢来降我！吃俺老孙一棒！！\n",
    this_object(), who);
  kill_ob(this_player());
  this_player()->kill_ob(this_object());
  //  }
  call_out("clear", 1, me);
}
int do_qk(string arg) {

  string cast_id, cast_name;
  object who = this_player();

  if (sscanf(arg, "%s on %s", cast_id, cast_name) == 2)

    if (cast_id == "qiankun" || arg == "qiankun")

      tell_object(who, "你隐隐的听到镇元大仙的声音：你这逆徒！"
        + "竟然想加害悟空，休要用我观中法术，以免牵带我全观弟子！\n");
  return 1;


}
int do_no(string arg) {
  object who = this_player();
  object me = this_object();
  message_vision("$N鬼鬼遂遂不知想干什么，$n警惕的盯着$N。\n", who, me);
  return 1;
}


void clear(object me) {
  object *inv;
  int p;
  remove_call_out("clear");
  inv = all_inventory(environment(me));
  for (p = 0; p < sizeof(inv) - 1; p++) {
    if (inv[p]->is_corpse())
      destruct(inv[p]);
  }

}

void heart_beat() {
  object ob = this_object();
  int k;
  ::heart_beat();

  if (query("eff_kee") < query("max_kee")) {
    for (int i = 3; i > 0; i--) {
      carry_object("/d/npc/vr_room/obj/jinchuangyao.lpc"); command("eat jinchuang yao"); command("exert recover");
    }
  }

  if (query("eff_sen") < query("max_sen")) {
    for (int i = 3; i > 0; i--) {
      carry_object("/d/npc/vr_room/obj/hunyuandan.lpc"); command("eat hunyuan dan"); command("exert refresh");
    }
  }
  if (is_fighting() && query("force") < query("max_force") / 2)
    command("cast transfer");
  if (query("kee") < query("eff_kee") - 10)
    command("exert recover");
  if (query("sen") < query("eff_sen") - 10)
    command("exert refresh");
  if (!is_fighting() && query("force") < query("max_force"))
    set("force", (int)query("max_force"));
  if (!is_fighting() && query("mana") < query("max_mana"))
    set("mana", (int)query("max_mana"));
  if (is_fighting()) {
    if (!ob->query_temp("jldl")) command("exert jldl");
    k = random(4);
    if (k > 3) k = 3;
    switch (k) {
      case 0:
        command("cast light"); break;
      case 1:
        command("perform pili"); break;
      case 2:
        command("perform qiankun"); break;
      case 3:
        command("perform panlong"); break;
      default: return 0;
    }
  }
}

void die() {
  object me = this_object();
  string err;
  object ps, newitem, ss;
  object *player;
  object killer = query_temp("last_damage_from");
  int exp, baolv, pot, d, i, m;
  player = users();
  m = sizeof(player);
  message("channel:chat", YEL "【花果山】" + CYN + "孙悟空仰天狂吼：俺老孙遭人暗算！俺老孙不服！！。\n" NOR, users());
  if (objectp(killer) && killer->query("is_guard") == 1)
    killer = killer->query("possessed");
  if (objectp(killer)) {
    message(
      "channel:chat",
      YEL "【花果山】" + CYN + "" + killer->query("name") + "神通广大！打败了孙悟空！。\n" NOR,
      users()
    );
    if (killer->query("family/family_name") == "东海龙宫"
      || killer->query("family/family_name") == "大雪山"
      || killer->query("family/family_name") == "陷空山无底洞"
      || killer->query("family/family_name") == "将军府"
      || killer->query("family/family_name") == "月宫"
      || killer->query("family/family_name") == "阎罗地府") {
      TEAMK_D->teamk(killer, 100000);
      killer->set_temp("mieyao/level", 12);
      err = catch(newitem = NEWITEMS_OB->get_item(me, killer));
      message_vision("$N爆出一" + newitem->query("unit") + newitem->query("name") + "。\n", me);
      newitem->move(killer);
      tell_object(
        killer,
        HIM "你得到了一" + newitem->query("unit") + newitem->query("name") + "。\n" NOR
      );
      err = catch(newitem = NEWITEMS_OB->get_item(me, killer));
      message_vision("$N爆出一" + newitem->query("unit") + newitem->query("name") + "。\n", me);
      newitem->move(killer);
      tell_object(
        killer,
        HIM "你得到了一" + newitem->query("unit") + newitem->query("name") + "。\n" NOR
      );
      err = catch(newitem = NEWITEMS_OB->get_item(me, killer));
      message_vision("$N爆出一" + newitem->query("unit") + newitem->query("name") + "。\n", me);
      newitem->move(killer);
      tell_object(
        killer,
        HIM "你得到了一" + newitem->query("unit") + newitem->query("name") + "。\n" NOR
      );
    }
  }
  for (i = 0; i < m; i++) {
    if (player[i]->query_temp("hgs_begin")) {
      if (player[i]->query("family/family_name") == "东海龙宫"
        || player[i]->query("family/family_name") == "大雪山"
        || player[i]->query("family/family_name") == "陷空山无底洞"
        || player[i]->query("family/family_name") == "将军府"
        || player[i]->query("family/family_name") == "月宫"
        || player[i]->query("family/family_name") == "阎罗地府") {
        killer = player[i];
        killer->set_temp("mieyao/level", 12);
        err = catch(newitem = NEWITEMS_OB->get_item(me, killer));
        newitem->move(killer);
        tell_object(
          killer,
          HIM "你得到了一" + newitem->query("unit") + newitem->query("name") + "。\n" NOR
        );
        d = random(11);
        if (d > 10) d = 10;
        switch (d) {
          case 0: ps = new("/d/npc/vr_room/obj/bs_zf.lpc");
          if (ps) ps->move(player[i]);
          tell_object(player[i], HIM "你得到了" + ps->query("name") + "" + HIM + "的奖励。\n" NOR); break;
          case 1: ps = new("/d/npc/vr_room/obj/bs_lh.lpc");
          if (ps) ps->move(player[i]);
          tell_object(player[i], HIM "你得到了" + ps->query("name") + "" + HIM + "的奖励。\n" NOR); break;
          case 2: ps = new("/d/npc/vr_room/obj/bs_fsl.lpc");
          if (ps) ps->move(player[i]);
          tell_object(player[i], HIM "你得到了" + ps->query("name") + "" + HIM + "的奖励。\n" NOR); break;
          case 3: ps = new("/d/npc/vr_room/obj/bs_tq.lpc");
          if (ps) ps->move(player[i]);
          tell_object(player[i], HIM "你得到了" + ps->query("name") + "" + HIM + "的奖励。\n" NOR); break;
          case 4: ps = new("/d/npc/vr_room/obj/bs_tj.lpc");
          if (ps) ps->move(player[i]);
          tell_object(player[i], HIM "你得到了" + ps->query("name") + "" + HIM + "的奖励。\n" NOR); break;
          case 5: ps = new("/u/xdao/ljs/obj/stone.lpc");
          if (ps) ps->move(player[i]);
          tell_object(player[i], HIM "你得到了" + ps->query("name") + "" + HIM + "的奖励。\n" NOR); break;
          case 6: ps = new("/obj/money/gold.lpc");
          if (ps) ps->set_amount(100);
          if (ps) ps->move(player[i]);
          tell_object(player[i], HIM "你得到了" + HIY + "100两黄金" + HIM + "的奖励。\n" NOR); break;
          case 7: exp = 50000 + random(50000);
          player[i]->add("combat_exp", exp);
          tell_object(player[i], HIM "你得到了" + chinese_number(exp) + "点武学经验的奖励。\n" NOR); break;
          case 8: exp = 50000 + random(50000);
          player[i]->add("daoxing", exp);
          tell_object(
            player[i],
            HIM "你得到了" + COMBAT_D->chinese_daoxing(exp) + "道行的奖励。\n" NOR
          ); break;
          case 9: exp = 20000 + random(20000);
          player[i]->add("potential", exp);
          tell_object(player[i], HIM "你得到了" + chinese_number(exp) + "点潜能的奖励。\n" NOR); break;
          case 10: ps = new("/d/npc/vr_room/obj/baoshi.lpc");
          if (ps) ps->move(player[i]);
          tell_object(player[i], HIM "你得到了" + ps->query("name") + "" + HIM + "的奖励。\n" NOR); break;
          default: ps = new("/d/npc/vr_room/obj/baoshi.lpc");
        }
      }
      player[i]->delete_temp("hgs_begin");
      player[i]->move("/d/city/kezhan");
    }
  }
  // 2010-12-29 dammy
  // ss=find_object("hgs shanshen");
  ss = find_living("hgs shanshen");
  if (ss) destruct(ss);
  else CHANNEL_D->do_channel(this_object(), "sys", "错误！找不到花果山山神。");

  ::die();
}
