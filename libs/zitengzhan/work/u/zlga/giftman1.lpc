#include <ansi.h>
inherit NPC;
string ask_me();


void create()
{
   set_name(HIC"龙王爷"NOR, ({"longwang ye","ye"}));
   set("title", HIW"四☆海☆为☆家"NOR);
   set("gender", "男性");
   set("long","农历龙年的代表，长的十分魁梧，和蔼可亲，但却很少说话。你可以试着跟他要新年礼物(gift)\n");
   set("combat_exp", 500000);
   set("age", 20);
   set("per", 27);
   set("attitude", "friendly");
   set("shen_type", 1);
   set_skill("unarmed", 300);
   set_skill("dodge", 300);
   set("inquiry", ([
          "gift" : (: ask_me :),
                  ]) );
   setup();
   carry_object("/d/obj/cloth/magua")->wear();
   add_money("silver", 5);
}



string ask_me()
 {
         object me,gift;
         me=this_player();
		
         if(!userp(me)) return "一边玩去。";
         if (me->query("2012gift_given"))
                return "你不是领过了吗，还想再要？";
         if ((int)me->query("combat_exp") + (int)me->query("daoxing") < 2000000)
                return "武学加道行200w以上再来领取吧！";
         if(!me->query("family"))
                return "你先去拜个师再来要礼物吧！";

         me->set("2012gift_given", 1);
         gift=new("/u/zlga/gift");
         gift->move(me);
         me->save();
		 return "龙王爷低头念了几句咒语，手中忽然多了一个新年大礼包。龙王爷说道：新年礼物接着吧！";
}

