// 《仙侣情缘*三界神话》

// aoyundan.c 奥运大补丸
// koker  13/07/2001

#include <ansi.h>

inherit ITEM;

int do_eat(string);
void init();

void init()
{
        if (!wizardp(this_player())) {
           set("no_sell",1); 
          set("no_give",1); 
          set("no_drop",1); 
          set("no_get",1); 
            set("value",10);                
        }
        add_action("do_eat", "eat");
}

void create()
{
  set_name(YEL "武学大补丸" NOR, ({"wx wan","dan"}));
  set_weight(100000);
  if (clonep())
    set_default_object(__FILE__);
   else {
     set("unit", "颗");
     set("long", "大补丸。上面刻有：“天上人间万岁”六个字。\n");
     set("drug_type", "补品");
        }
  set("is_monitored",1); //监控精灵
  setup();
}

int do_eat(string arg)
{
  object me = this_player();
  
  if (!id(arg)) 
    {
      return notify_fail("你要吃什么？\n");
    }
       else
         {
           me->set("food", (int)me->max_food_capacity());
           me->add("combat_exp",15000000);
           me->add("daoxing",15000000);
           message_vision(HIC "$N吃下一颗武学大补丸，只觉体内冉冉升起一道道热爱天上人间的激流！ \n" NOR, me);
           destruct(this_object());  //毁灭这个物品
           return 1;
         }
 }


