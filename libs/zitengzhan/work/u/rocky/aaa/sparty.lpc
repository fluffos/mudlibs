//party.c
//Wangcy
//帮会

#include "party.h"
#include <ansi.h>
inherit F_CLEAN_UP;
#define COLOR NOR+WHT

string do_get_name(string id);

int main(object me, string arg)
{
	string p_file,member,*member1,*member2,*member3;
	object party,master;
	string name,id,master_name,master_id,master_id_1;
	string str1,str2,str3;
	string msg;
	int i,max;
	if (!arg) {
	        tell_object(me,HIY"「仙侣情缘紫藤站」"+HIW"目前的帮派有：\n"NOR);
		tell_object(me,HIY"\n≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡\n"NOR);
		member1=get_dir(DATA_PATH);
		party=new("/d/obj/party");
		for(i=0;i<sizeof(member1);i++){
			if(sscanf(member1[i],"%s.o",member)!=1) continue;
			party->set(ID,member);
			party->restore();
			name=party->query(NAME);
			master_name=party->query(MASTER_NICK);
			id=capitalize(party->query(ID));
			master_id=party->query("master")[0];
			if(master=find_player(master_id)) ;
			else {master=new("/obj/user");
			master->set("id",master_id);
			master->restore();}
			master_id_1=master->query("name");
			master_id=capitalize(master_id);
			if(!userp(master)) destruct(master);
			str1=HIG"【"+name+"】"+"("+id+")";
			str2=HIY"["+master_name+"]： ";
			str3=master_id_1+"("+master_id+")";
			printf("\n%45|s%20+s%14+s",str1,str2,str3);
		}
		tell_object(me,HIY"\n\n≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡\n\n"NOR);
		destruct(party);
		return 1;
	}
	p_file=DATA_PATH+arg+".o";
	if(file_size(p_file)<0) return notify_fail("没有这个帮会。\n");
	if(arg!=me->query(ID) && !wizardp(me)) return notify_fail("只能查看本帮会的人员情况。\n");
	party=new("/d/obj/party");
	party->set(ID,arg);
	party->restore();
	msg=COLOR"\n                  ┏ "NOR+sprintf("%40|s",BCYN HIW+party->query(NAME)+"英雄榜"NOR)+COLOR"┓ \n";
	msg+="┏━━━━━━━━┻━━━━━━━━━━┻━━━━━━━━━━┓\n";
	member1=party->query("master");
	if(sizeof(member1)){
		msg+=COLOR"┃"HIB+sprintf("%50-s",party->query(MASTER_NICK)+"：")+COLOR"          ┃"NOR;
		for(i=0;i<sizeof(member1);i++) {
			if(i%3==0) msg+=COLOR"\n┃"HIW;
			msg+=sprintf("%20-s",do_get_name(member1[i]));
			if((i+1)%3==0) msg+=COLOR"┃"NOR;
		}
		for(;(i+1)%3!=1;i++){
			msg+=sprintf("%20-s","                    ");
		}
		msg+=COLOR"┃"NOR;
	}
	member1=party->query("submaster");
	if(sizeof(member1)){
		msg+=COLOR"\n┃"HIB+sprintf("%50-s",party->query(SUBMASTER_NICK)+"：")+COLOR"          ┃"NOR;
		for(i=0;i<sizeof(member1);i++) {
			if(i%3==0) msg+=COLOR"\n┃"HIW;
			msg+=sprintf("%20-s",do_get_name(member1[i]));
			if((i+1)%3==0) msg+=COLOR"┃"NOR;
		}
		for(;(i+1)%3!=1;i++){
			msg+=sprintf("%20-s","                    ");
		}
		msg+=COLOR"┃"NOR;
	}
	member1=party->query("leader");
	if(sizeof(member1)){
		msg+=COLOR"\n┃"HIB+sprintf("%50-s",party->query(LEADER_NICK)+"：")+COLOR"          ┃"NOR;
		for(i=0;i<sizeof(member1);i++) {
			if(i%3==0) msg+=COLOR"\n┃"HIW;
			msg+=sprintf("%20-s",do_get_name(member1[i]));
			if((i+1)%3==0) msg+=COLOR"┃"NOR;
		}
		for(;(i+1)%3!=1;i++){
			msg+=sprintf("%20-s","                    ");
		}
		msg+=COLOR"┃"NOR;
	}
	member1=party->query("member");
	if(sizeof(member1)){
		msg+=COLOR"\n┃"HIB+sprintf("%50-s",party->query(MEMBER_NICK)+"：")+COLOR"          ┃"NOR;
		for(i=0;i<sizeof(member1);i++) {
			if(i%3==0) msg+=COLOR"\n┃"HIW;
			msg+=sprintf("%20-s",do_get_name(member1[i]));
			if((i+1)%3==0) msg+=COLOR"┃"NOR;
		}
		for(;(i+1)%3!=1;i++){
			msg+=sprintf("%20-s","                    ");
		}
		msg+=COLOR"┃"NOR;
	}
	if(party->query(PLACE)) {
		msg+=COLOR"\n┣━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┫";
		msg+="\n┃"+HIY"总堂在："HIW+sprintf("%45-s",party->query(PLACE))+COLOR"  　　 ┃"NOR;
	}
		msg+=COLOR"\n┗━━━━━━━━━━━━━━━━━━━━━━━━━━"+HIG"X"NOR+"."+HIR"L"NOR+"."+HIY"Q"NOR+"."+HIC"Y"NOR+"."+COLOR"┛"NOR;
	msg+="\n";
	printf(msg);
	destruct(party);
	return 1;
}

string do_get_name(string id)
{
	object user;
	string msg;
	if(user=find_player(id)) ;
	else {user=new("/obj/user");
	user->set("id",id);
	user->restore();}
	msg=user->query("name")+"("+user->query("id")+")";
	if(!userp(user)) destruct(user);
	return msg;
}
int help()
{
	write(@TEXT
指令格式：sparty [帮会名称]

查看帮会情况，分两种：
sparty       　　　　:　　查看现有全部帮会情况。
sparty <帮会名称>　　:    查看该帮会详细资料。
TEXT
  );
	return 1;
}
