//abdicate.c
//Wangcy
//帮主禅位

#include "party.h"
#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  object party, ob;
  if (me->query(LEVEL) != MASTER) return notify_fail("你又不是帮主。\n");
  if ((!arg) || arg == me->query("id")) return notify_fail("你要禅位给谁？\n");
  ob = find_player(arg);
  if (!ob) return notify_fail("没有这个玩家。\n");
  if (ob->query(NAME) != me->query(NAME)) return notify_fail("你难道想禅位给外人？\n");
  if (!master_limite(ob)) return notify_fail("他的能力还不能胜任帮主。\n");
  me->command(
    "club 在下自觉能力有限，无力领导兴帮大业，因此今日禅位给" + ob->query("name") + "(" + ob->query("id") + ")" + "。\n" + NOR,
    users()
  );
  del_member(me, me->query(LEVEL));
  add_member(me, me->query(NAME), me->query(ID), 4);
  del_member(ob, ob->query(LEVEL));
  add_member(ob, me->query(NAME), me->query(ID), 1);
  return 1;
}
int help() {
  write(@TEXT
指令格式：abdicate <对象>

将帮主之位禅让给帮中能人。
TEXT
  );
  return 1;
}
