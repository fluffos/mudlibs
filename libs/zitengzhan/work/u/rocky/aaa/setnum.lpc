//party.c
//Wangcy
//帮会

#include "party.h"
#include <ansi.h>
inherit F_CLEAN_UP;


int main(object me, string arg)
{
        object party;
        string level;
        int level_num;

        if(me->query(LEVEL)!=MASTER) return notify_fail("只有帮会首领才有此权利。\n");


	if(!arg) return notify_fail("指令参数：\n  
		setinfo master     <首领个数>\n 
		setinfo submaster  <次首领个数>\n
		setinfo leader     <头目个数>\n
		setinfo member     <普通成员个数>\n");
        
        party=new("/d/obj/party");
	party->set(ID,me->query(ID));
	party->restore();

	if(sscanf(arg, "%s %d",level,level_num)==2) {

           if(!intp(level_num)) return 1;
	   
	   if(level=="master") {
	     if(level_num>1) return notify_fail("首领不能超过1个。\n");
	     party->set("MASTER_NUM",level_num);
	   }	   
	   else if(level=="submaster") {
	     if(level_num>2) return notify_fail("次首领不能超过2个。\n");
	     party->set("SUBMASTER_NUM",level_num);
	   }	   
	   else if(level=="leader") {
	     if(level_num>8) return notify_fail("头目不能超过8个。\n");
	     party->set("LEADER_NUM",level_num);
	   }	   
/*	   else if(level=="subleader") {
	     if(level_num>20) return notify_fail("小头目不能超过20个。\n");
	     party->set("subleader/num",level_num);
	   }	   */
//           else if(level=="member") party->set("member/num",level_num);
           else return notify_fail("没有这个等级。\n");
		
	}	
	else return notify_fail("格式：setnum <等级> <数目>。\n");
	write("OK\n");
	party->save();
	destruct(party);
        return 1;
}
	
int help()
{
  write(@TEXT
指令格式：
          setinfo master     首领个数
          setinfo submaster  次首领个数
          setinfo leader     头目个数
          setinfo member     普通成员个数
TEXT
  );
  return 1;
}
