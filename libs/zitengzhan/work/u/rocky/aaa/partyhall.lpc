      return 0;
    }
    // if ( door[dir]["status"] & DOOR_HAS_TRAP ) ....
  }
  return 1;
}


void create() {
  set_name("总堂", ({ "hall" }));
  set("short", "总堂");
  set("long", @LONG

一切都设置好了，只等一些室内装修。 
LONG
  );
  set("env/invisibility", 1);
  /*     set("exits", ([
                "out": query("out"),
         ]));
		 */
  set_max_encumbrance(100000000);
  set_max_items(20);
  set_weight(10000000);
  set("no_get", 1);
  //     set("no_magic", 1);
  //     set("no_fight", 1);
  //     seteuid(getuid());
  doors = query("doors");
  if (mapp(doors)) {
    if (undefinedp(doors["east"])) create_door("east", doors["east"]["name"], "west", DOOR_CLOSED);
    if (undefinedp(doors["west"])) create_door("west", doors["west"]["name"], "east", DOOR_CLOSED);
    if (undefinedp(doors["south"])) create_door(
      "south",
      doors["south"]["name"],
      "north",
      DOOR_CLOSED
    );
    if (undefinedp(doors["north"])) create_door(
      "north",
      doors["north"]["name"],
      "south",
      DOOR_CLOSED
    );
  }

  setup();

}
