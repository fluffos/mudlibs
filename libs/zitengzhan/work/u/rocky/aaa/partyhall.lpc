int set_door(string direction) {
  string str;
  object me = this_player();
  mapping exits = query("exits");
  if (me->query(NAME) != query(NAME)) return notify_fail("你无权为这里命名。\n");
  if (me->query(LEVEL) != MASTER) return notify_fail("你无权为这里命名。\n");
  if (direction != "west" && direction != "east" && direction != "south" && direction != "north")
    return notify_fail("不能在这个方向上建门。\n");
  if (!mapp(exits) || undefinedp(exits[direction]))
    return notify_fail("没有这个方向。\n");
  write("请给一个中文名字:");
  input_to((: get_door_name :), me, direction);
  return 1;
}

void get_door_name(string arg, object me, string direction) {
  if (!arg) {
    write("你要起什么名字？\n");
    return;
  }
  arg = check_str(arg);
  if (check_legal_name(arg, 12))
    create_door(direction, arg, mapping_direction(direction), DOOR_CLOSED);
  write("Ok.\n");
}

int do_go(string arg) {
  //	if(!valid_leave(this_player(),arg)) return 0;
  if (arg == "east") return go_east();
  if (arg == "west") return go_west();
  if (arg == "south") return go_south();
  if (arg == "north") return go_north();
  if (arg == "out") return go_out();
  else return notify_fail("没有这个方向的出路。\n");
}


string query_save_file() {
  return DATA_PATH + "/room/" + this_object()->query(ID);
}

int go_out() {
  object me = this_player();
  if (!query("exits/out")) return notify_fail("这个方向没有出路。\n");
  tell_room(this_object(), me->query("name") + "向外离开。\n", ({ me }));
  me->move(query("exits/out"));
  tell_room(environment(me), me->query("name") + "走了过来。\n", ({ me }));
  return 1;
}
int go_east() {
  object me = this_player();
  object hall;
  if (!valid_leave(me, "east"))
    return 1;
  if (!query("exits/east")) return notify_fail("这个方向没有出路。\n");
  if (!find_object(query("exits/east"))) {
    hall = new("/d/obj/partyhall");
    hall->set(ID, query(ID) + "/east");
    hall->restore();
    hall->set("exits/west", file_name(this_object()));
    set("exits/east", file_name(hall));
    save();
  }
  tell_room(this_object(), me->query("name") + "向东离开。\n", ({ me }));
  me->move(query("exits/east"));
  tell_room(environment(me), me->query("name") + "走了过来。\n", ({ me }));
  return 1;
}
int go_west() {
  object me = this_player();
  object hall;
  if (!valid_leave(me, "west")) return 1;
  if (!query("exits/west")) return notify_fail("这个方向没有出路。\n");
  if (!find_object(query("exits/west"))) {
    hall = new("/d/obj/partyhall");
    hall->set(ID, query(ID) + "/west");
    hall->restore();
    hall->set("exits/east", file_name(this_object()));
    set("exits/west", file_name(hall));
    save();
  }
  tell_room(this_object(), me->query("name") + "向西离开。\n", ({ me }));
  me->move(query("exits/west"));
  tell_room(environment(me), me->query("name") + "走了过来。\n", ({ me }));
  return 1;
}
int go_north() {
  object me = this_player();
  object hall;
  if (!valid_leave(me, "north")) return 1;
  if (!query("exits/north")) return notify_fail("这个方向没有出路。\n");
  if (!find_object(query("exits/north"))) {
    hall = new("/d/obj/partyhall");
    hall->set(ID, query(ID) + "/north");
    hall->restore();
    hall->set("exits/south", file_name(this_object()));
    set("exits/north", file_name(hall));
    save();
  }
  tell_room(this_object(), me->query("name") + "向北离开。\n", ({ me }));
  me->move(query("exits/north"));
  tell_room(environment(me), me->query("name") + "走了过来。\n", ({ me }));
  return 1;
}
int go_south() {
  object me = this_player();
  object hall;
  if (!valid_leave(me, "south")) return 1;
  if (!query("exits/south")) return notify_fail("这个方向没有出路。\n");
  if (!find_object(query("exits/south"))) {
    hall = new("/d/obj/partyhall");
    hall->set(ID, query(ID) + "/south");
    hall->restore();
    hall->set("exits/north", file_name(this_object()));
    set("exits/south", file_name(hall));
    save();
  }
  tell_room(this_object(), me->query("name") + "向南离开。\n", ({ me }));
  me->move(query("exits/south"));
  tell_room(environment(me), me->query("name") + "走了过来。\n", ({ me }));
  return 1;
}
int do_build(string direction) {
  object hall, party;
  object me = this_player();
  string *halls;
  if (me->query(NAME) != query(NAME)) return notify_fail("你不是这个帮会的。\n");
  if (!direction) return notify_fail("你打算向哪个方向建立房间？\n");
  if (direction != "west" && direction != "east" && direction != "south" && direction != "north")
    return notify_fail("没有这个方向。\n");
  //	if(file_size(query_save_file()+"/"+direction+".o")>0)  return notify_fail("这个方向上已经有房间了。\n");
  if (query("exits/" + direction)) return notify_fail("这个方向上已经有房间了。\n");
  hall = new("/d/obj/partyhall");
  hall->set("exits", ([
    mapping_direction(direction): file_name(this_object()),
  ]));
  hall->set(ID, query(ID) + "/" + direction);
  hall->set(NAME, query(NAME));
  hall->set("short", me->query(NAME) + direction + "堂");
  hall->save();
  set("exits/" + direction, file_name(hall));
  save();
  write("OK\n");
  return 1;
}
string mapping_direction(string arg) {
  if (arg == "east") return "west";
  if (arg == "west") return "east";
  if (arg == "north") return "south";
  return "north";
}
int check_legal_name(string name, int max_len) {
  int i;
  string *legalname;  //not implemented..may add later

  i = strlen(name);
  if ((strlen(name) < 2) || (strlen(name) > max_len)) {
    write(sprintf("对不起，中文字必须是 1 到 %d 个中文字。\n",
      max_len / 2));
    return 0;
  }
  while (i--) {
    if (name[i] <= ' ') {
      write("对不起，中文字不能用控制字元。\n");
      return 0;
    }
    if (i % 2 == 0 && !is_chinese(name[i..<0])) {
      write("对不起，请您用「中文」取名字。\n");
      return 0;
    }
  }

  return 1;
}
int do_name(string arg) {
  object me = this_player();
  if (me->query(NAME) != query(NAME)) return notify_fail("你无权为这里命名。\n");
  if (me->query(LEVEL) != MASTER) return notify_fail("你无权为这里命名。\n");
  if (!arg) return notify_fail("你要给这里起什么名字？\n");
  arg = check_str(arg);
  if (check_legal_name(arg, 12));
  else return 1;
  set("short", arg);
  save();
  write("OK\n");
  return 1;

}
int set_long() {
  string str;
  this_player()->edit((: get_long_text, str :));
  return 1;
}
void get_long_text(string str, string text) {
  str = check_str(text);
  set("long", str);
  save();
  return;
}

string check_str(string str) {
  str = replace_string(str, "\"", "");
  str = replace_string(str, ";", "");
  str = replace_string(str, "\\", "");
  str = replace_string(str, "/", "");
  str = replace_string(str, "'", "");
  str = replace_string(str, "`", "");
  str = replace_string(str, ",", "");
  str = replace_string(str, "!", "");
  str = replace_string(str, "~", "");
  str = replace_string(str, "{", "");
  str = replace_string(str, "}", "");
  str = replace_string(str, "$", "");
  str = replace_string(str, "&", "");
  return str;
}
