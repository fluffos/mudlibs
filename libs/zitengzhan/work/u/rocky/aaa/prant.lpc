//prant.c
//Wangcy
//帮会等级管理

#include <ansi.h>
inherit F_CLEAN_UP;

#include "party.h"

int creat_party(object ob);
int main(object me, string arg1) {
  object ob;
  string arg;
  int change;
  if (!me->query("party")) return notify_fail("你还未加入任何帮会的\n");
  if (me->query(LEVEL) != MASTER) {
    if (arg1 != "-f") return notify_fail("退出帮会,请用prant -f确认。\n");
    me->command("club " + "经过再三思量，在下觉得不能胜任帮中之位，只好退出，还望诸位原谅。");
    add_member(me, me->query(NAME), me->query(ID), OUT);
    return 1;
  }
  if (!arg1) return notify_fail("格式：prant id [by 1/-1]");
  if (sscanf(arg1, "%s by %d", arg, change) == 2);
  else {
    arg = arg1;
    change = 1;
  }
  if ((!arg) || arg == me->query("id")) return notify_fail("你要向谁执行帮会命令？?\n");
  ob = find_player(arg);
  //	if(!ob) return notify_fail(HIY"没有这个玩家。\n"NOR);
  if (!ob) {
    ob = new("/obj/user");
    ob->set("id", arg);
    ob->restore();
  }

  if (ob->query_temp(JOINING) == me->query("id")) {
    add_member(ob, me->query(NAME), me->query(ID), MEMBER);
    ob->delete_temp(JOINING);
    me->command("club " + "今日" + ob->query("name") + "加入本帮,希望" + ob->query("name") + "能够大展雄才，为本帮的繁荣贡献力量。");
    return 1;
  }
  if (ob->query(NAME) == me->query(NAME)) {
    if (add_member(ob, me->query(NAME), me->query(ID), ob->query(LEVEL) - change)) {
      del_member(ob, ob->query(LEVEL) + change);
      me->command("club " + "决定改变" + ob->query("name") + "的等级为" + party_title(ob) + "。\n");
    }
    if (!userp(ob)) {
      ob->save();
      destruct(ob);
    }
  } else {
    if (!userp(ob)) destruct(ob);
    return notify_fail("他并没有申请入帮。\n");
  }
  return 1;
}
