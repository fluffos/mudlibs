//setinfo.c
//Wangcy
//帮会名号确定

#include "party.h"
#include <ansi.h>
inherit F_CLEAN_UP;

int check_legal_name(string name, int max_len);
int main(object me, string arg) {
  object party;
  string level, level_name;

  if (me->query(LEVEL) != MASTER) return notify_fail("只有帮会首领才有此权利。\n");


  if (!arg) return notify_fail("指令参数：\n  
		setinfo master     <首领称号>\n 
		setinfo submaster  <次首领称号>\n
		setinfo leader     <头目称号>\n
		setinfo member     <普通成员称号>\n");


  party = new("/d/obj/party");
  party->set(ID, me->query(ID));
  party->restore();

  if (sscanf(arg, "%s %s", level, level_name) == 2) {
    if (!check_legal_name(level_name, 10)) return 1;
    if (level == "master") party->set(MASTER_NICK, level_name);
    else if (level == "submaster") party->set(SUBMASTER_NICK, level_name);
    else if (level == "leader") party->set(LEADER_NICK, level_name);
    else if (level == "member") party->set(MEMBER_NICK, level_name);
    else return notify_fail("没有这个等级。\n");
  } else return notify_fail("格式：setinfo <等级> <称号>。\n");
  write("OK\n");

  party->save();
  destruct(party);

  return 1;
}

int check_legal_name(string name, int max_len) {
  int i;
  string *legalname;  //not implemented..may add later

  i = strlen(name);

  if ((strlen(name) < 2) || (strlen(name) > max_len)) {
    write(sprintf("对不起，称号必须是 1 到 %d 个中文字。\n", max_len / 2));
    return 0;
  }

  while (i--) {
    if (name[i] <= ' ') {
      write("对不起，称号中不能用控制字元。\n");
      return 0;
    }
    if (i % 2 == 0 && !is_chinese(name[i..<0])) {
      write("对不起，请您用「中文」取名字。\n");
      return 0;
    }
  }

  return 1;
}
int help() {
  write(@TEXT
指令格式：
                setinfo master     首领称号
                setinfo submaster  次首领称号
                setinfo leader     头目称号
                setinfo member     普通成员称号
TEXT
  );
  return 1;
}
