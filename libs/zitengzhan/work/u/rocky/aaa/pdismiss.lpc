//pdismiss.c
//Wangcy
//解散帮会

#include "party.h"
#include <ansi.h>
inherit F_CLEAN_UP;
void del_party(string member);

int main(object me, string arg) {
  object party, env;
  string *member;
  int i;
  if (me->query(LEVEL) != MASTER) return notify_fail("你没有这个权力。\n");
  party = new("/d/obj/party");
  party->set(ID, me->query(ID));
  party->restore();
  //	if(sizeof(party->query("member"))||sizeof(party->query("leader"))||sizeof(party->query("submaster"))) return notify_fail("你的帮里还有帮众呀。\n");
  if (arg != "-f") return notify_fail("请用pdismiss -f 确认\n");
  if (!in_home(me)) return notify_fail("这么重大的事情还是回总堂宣布吧。\n");
  env = environment(me);
  if (env->query(ID) == me->query(ID)) {
    me->command("out");
    me->command("pdestroy " + me->query(ID));
  }
  member = party->query("master");
  if (sizeof(member)) {
    for (i = 0; i < sizeof(member); i++) {
      del_party(member[i]);
    }
  }
  member = party->query("submaster");
  if (sizeof(member)) {
    for (i = 0; i < sizeof(member); i++) {
      del_party(member[i]);
    }
  }
  member = party->query("leader");
  if (sizeof(member)) {
    for (i = 0; i < sizeof(member); i++) {
      del_party(member[i]);
    }
  }
  member = party->query("member");
  if (sizeof(member)) {
    for (i = 0; i < sizeof(member); i++) {
      del_party(member[i]);
    }
  }
  if (!rm(DATA_PATH + party->query(ID) + ".o")) return notify_fail("解散帮会失败。\n");
  message(
    "channel:chat",
    HIY "\n【帮派天下】" + me->query("name") + "(" + me->query("id") + ")" + "：在下已经觉得身心俱疲，决定解散" + party->query(NAME) + "，各位今日分道扬镳，好自为之呀。" NOR,
    users()
  );
  message(
    "channel:chat",
    HIY "\n【帮派天下】" + me->query("name") + "英雄气短，无奈之下解散了【" + party->query(NAME) + "】，江湖上从此再无" + party->query(NAME) + "的名号！\n\n" NOR,
    users()
  );
  me->delete("party");
  destruct(party);
  return 1;
}
void del_party(string member) {
  object ob;
  if (!(ob = find_player(member))) {
    ob = new("/obj/user");
    ob->set("id", member);
    ob->restore();
  }
  ob->delete("party");
  if (!userp(ob)) {
    ob->save();
    destruct(ob);
  }
  return;
}
int help() {
  write(@TEXT
指令格式：pdismiss <帮派ID>
解散已存在的帮派
TEXT
  );
  return 1;
}
