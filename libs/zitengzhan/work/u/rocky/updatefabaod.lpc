#include <ansi.h>

inherit F_DBASE;

string *fabaopath = ({
  "/d/dntg/donghai/obj/jingubang",
  "/d/obj/fabao/huntian-ling",
  "/d/obj/fabao/kunxian-suo",
  "/d/obj/weapon/blade/kugudao"
  "/d/qujing/pingding/obj/hulureal",
  "/d/qujing/pingding/obj/pingreal",
  "/d/shendian/babu/obj/longyi",
  "/d/pansi/obj/ziqing",
  "/d/pansi/obj/baohe",
  "/d/moon/obj/feijian",
  "/d/nanhai/obj/jiasha",
  "/d/nanhai/obj/nine-ring",
  "/d/qujing/xiaoxitian/obj/baoreal",
  "/d/shendian/babu/obj/longzhua",
  "/d/shendian/babu/obj/gudao"
  "/d/shendian/babu/obj/gufork"
  "/d/shendian/babu/obj/guaxe"
  "/d/shendian/babu/obj/guhammer"
  "/d/shendian/babu/obj/gujian"
  "/d/shendian/babu/obj/gumace"
  "/d/shendian/babu/obj/guqiang"
  "/d/shendian/babu/obj/gustaff"
  "/d/shendian/babu/obj/gustick"
  "/d/shendian/babu/obj/guwhip"
  "/d/shendian/babu/obj/shelizi"
  "/d/obj/cloth/tianyi",
});

void create() {
  seteuid(ROOT_UID);
  set("channel_id", "内存精灵");
  CHANNEL_D->do_channel(this_object(), "sys", "法宝自动恢复系统已经启动。\n");
  call_out("update_fabao", 600);
}
int update_fabao() {
  object *fabao, obj;
  int i, j;
  for (i = 0; i < sizeof(fabaopath); i++) {
    fabao = children(fabaopath[i]);
    for (j = 0; j < sizeof(fabao); j++) {
      obj = environment(fabao[j]);
      if (living(obj)) message_vision(fabao[j]->query("name") + "直冲天际。\n", obj);
      destruct(fabao[j]);
    }
  }
  message("channel:chat", HIG "【" + HIR "奇珍异宝" + HIG "】" + "特殊物品更新。\n" + NOR, users());
  call_out("update_fabao", 10800);
}
