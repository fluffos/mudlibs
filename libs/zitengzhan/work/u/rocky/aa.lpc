#include <room.h>
inherit ROOM;


void create() {
  set("short", "密洞");

  set("exits", ([ /* sizeof() == 1 */
  ]));
  set("objects", ([ /* sizeof() == 3 */
  ]));

  setup();
}
void init() {
  add_action("do_kill", "kill");
  add_action("do_kill", "fight");
  add_action("no_do_kill", "perform");
  add_action("no_do_kill", "cast");
  add_action("no_do_kill", "ji");
  add_action("no_do_kill", "steal");
  add_action("no_do_kill", "teamkill");
}
int no_do_kill() {
  object me = this_player();
  tell_object(me, "此乃天界，岂容你乱来？\n");
  return 1;
}
int do_kill(string arg) {
  object me = this_player();
  object *ob = all_inventory(environment(me));
  if (arg != "shouhuzhe" && arg != "zhe" && arg != "shouhu zhe") return 0;
  if (sizeof(ob) > 1) {
    tell_object(me, "想倚多取胜，没门！\n");
    return 1;
  }
  return 0;
}
