int do_block_cmds() {
  object me;
  string cmds;
  me = this_player();
  cmds = query_verb();
  if (wizardp(me)) return 0;
  if (cmds != "input" && cmds != "read" && cmds != "help" && cmds != "look") return 1;
  return 0;
}
