inherit ROOM;
#include <ansi.h>

int do_block_cmds();

void create() {
  set("short", "检验平台");
  set("long", @LONG

LONG);

  set("exits", ([ /* sizeof() == 1 */
  ]));
  set("objects", ([ /* sizeof() == 3 */
  ]));

  set("outdoors", 1);
  set("indentify", 1);
  setup();
  call_other("/obj/board/newbie_b", "???");
}
void init() {
  add_action("do_pass_in", "pass");
  add_action("do_list", "list");
  add_action("do_refuse_in", "refuse");
  add_action("do_input", "input");
  //    add_action("do_summon", "summon");
  add_action("do_block_cmds", "", 1);
}
int do_pass_in(string arg) {
  object me, ob;
  if (!arg) return notify_fail("指令格式 pass <玩家ID>\n");
  ob = find_player(arg);
  if (!ob) return notify_fail("没有这个玩家。\n");
  if (!environment(ob)->query("indentify")) return notify_fail("此命令只能用于初次登录的玩家。\n");
  me = this_player();
  if (!wizardp(me)) return notify_fail("只有巫师才有权力在此使用此命令。\n");
  ob->move("/d/city/kezhan");
  return 1;
}
int do_refuse_in(string arg) {
  object me, ob;
  string wizname, playername;
  me = this_player();
  wizname = me->query("id");
  if (!wizardp(me)) return notify_fail("只有巫师才有权力在此使用此命令。\n");
  if (!arg) return notify_fail("指令格式 refuse <玩家ID>\n");
  ob = find_player(arg);
  if (!ob) return notify_fail("没有这个玩家。\n");
  if (!environment(ob)->query("indentify")) return notify_fail("此命令只能用于初次登录的玩家。\n");
  if (wizardp(me) < wizardp(ob)) return notify_fail("你不能对高级巫师使用此命令。\n");
  playername = ob->query("name");
  message_vision(HIW "$N一扬手，$n被轰出了仙旅奇缘。\n" NOR, me, ob);
  "/cmds/adm/refuseplayer.lpc"->main(me, arg);
  "/cmds/adm/delplayer.lpc"->main(me, arg);
  message_vision(HIW "$N又一扬手，" + playername + HIW "的档案被烧成了飞灰。\n" NOR, me);
  log_file("STATIC/REFUSE", sprintf("[%s] %s refused %s \n", ctime(time())[0..15], wizname, arg,));
  return 1;
}

int do_summon() {
  return 1;
}

int do_list(string arg) {
  object me, ob;
  string msg;
  if (!arg) return notify_fail("指令格式 list <玩家ID>\n");
  ob = find_player(arg);
  if (!ob) return notify_fail("没有这个玩家。\n");
  me = this_player();
  if (!wizardp(me)) return 1;
  if (!environment(ob)->query("indentify")) return notify_fail("此命令只能用于初次登录的玩家。\n");
  msg = "玩家档案：\n";
  msg += "所在省份" + ob->query("indentify/ad", 1) + "\n";
  msg += "是否学生" + ob->query("indentify/class", 1) + "\n";
  msg += "是否主ID" + ob->query("indentify/main", 1) + "\n";
  write(msg);
  return 1;
}
