
inherit ROOM;
int block_cmd(string);
void create()
{
        set("short", "美容室");
        set("long", @LONG

  一间空荡荡的手术室，看起来阴深深的。。。。

LONG
        );
       
        set("exits",([
                      "east" : "/d/wiz/entrance",
                     ]));
        set("no_time",1);
        set("no_magic",1);
        set("no_fight",1);
      set("no_clean_up", 1);
        set("objects",([/* sizeof() == 2 */
            "/u/wzx/npc/meirshi" : 1,
//   "/u/xdao/gift/vikee.c" : 1,
 "/u/zlga/guoguan" : 1,
   "/u/wsw/xiaoya" : 1,
            "/u/nanf/npc/12580.c" : 1,
                      ]));               
        set("no_clean_up", 0);

        setup();

}

          



void init()
{
  add_action("block_cmd","",1);
}
int block_cmd(string args)
{
 string verb;
 verb = query_verb();
 if (verb=="xiudao") return 1;
 if (verb=="exert") return 1;
 if (verb=="bian") return 1;
 if (verb=="board") return 1;
 if (verb=="steal") return 1;
 if (verb=="throw") return 1;
 if (verb=="kill") return 1;
 if (verb=="cast") return 1;
   return 0;
}



