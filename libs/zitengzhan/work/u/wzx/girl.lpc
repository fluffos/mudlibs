//Cracked by WZX
inherit F_VENDOR_SALE;
void create()
{
    reload("ling");
        set_name("乌子婿", ({"wu", "wu zixu", "zixu"}));
        set("title", "竹屋种花人");
        set("gender", "男性");
        set("age", 27);
        set("long", "一个看起来很平凡的人。比较喜欢种花。\n");
   set("str", 30);
   set("con", 30);
   set("spi", 30);
        set("combat_exp", 20000);
        set("daoxing",20000);   
        set_skill("force", 50);
        set_skill("unarmed", 50);
        set_skill("dodge", 50);
        set_skill("parry", 50);
   set("force", 200);
   set("max_force", 200);
   set("force_factor", 5);
        set("vendor_goods", ([
//                    "seed": "/d/obj/misc/seed",
 "1": "/u/wzx/obj/flower/red_rose",
 "2": "/u/wzx/obj/flower/white_rose",
 "3": "/u/wzx/obj/flower/qingren_cao",
 "4": "/u/wzx/obj/flower/ding_xiang",
 "5": "/u/wzx/obj/flower/mu_dan",
 "6": "/u/wzx/obj/flower/yu_jinxiang",
 "7": "/u/wzx/obj/flower/bai_he",
 "8": "/u/wzx/obj/flower/kang_naixin",
 "9": "/u/wzx/obj/flower/ma_tilian",
"10": "/u/wzx/obj/flower/jin_yucao",
"11": "/u/wzx/obj/flower/huo_he",
"12": "/u/wzx/obj/flower/hu_dielan",
"13": "/u/wzx/obj/flower/qiu_haitang",
"14": "/u/wzx/obj/flower/shi_hulan",
        ]) );
        setup();
   add_money("silver", 20);
}

void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
     call_out("greeting",1,ob);
        }
        add_action("do_vendor_list", "list");

}
void greeting(object ob)
{
    if( !ob || !visible(ob) || environment(ob) != environment() ) return;
        switch( random(1) ) {
                case 0:
                        say( name()+"笑道：随便坐坐吧！\n");
                        break;
        }
}

