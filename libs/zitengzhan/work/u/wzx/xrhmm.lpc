  set("gender", "女性");
  set("long", "婷婷玉立的一个女孩，长的十分标志，一笑有两个小酒窝，但却很少说话。你可以试着跟她要张信用卡看看(card)\n");
  set("combat_exp", 500000);
  set("age", 20);
  set("per", 27);
  set("attitude", "friendly");
  set("shen_type", 1);
  set_skill("unarmed", 300);
  set_skill("dodge", 300);
  set("inquiry", ([
    //  "name" : "我就是这里的店主雪绒花拉。\n",

    //      "here" : "这里便是玩具坊拉。\n",

    //     "xrh" : "雪绒花是个专门派送玩具的好妹妹。\n",

    //        "ago" : "ago啊,她老说自己是xyj第一大好人,但是,群众的眼光是雪亮的哦。\n",

    //      "ccww" : "ccww是个大流氓,mm们都烦他的很。\n",

    //       "qssa" : "包子一是个大家都想吃的香喷喷的大肉包。\n",

    //      "duke" : "duke也是个大流氓,mm们对他总是爱理不理的。\n",

    //       "seashell" :"seashell是雪绒花的好老公。\n",

    //       "xxhaohao":"这个家伙只知道埋头赚钱。\n",
    //"tmd" : "Top1。\n",

    //   "zero" : "zero是个好gg,紫藤卡就是他作的。\n",

    //    "布娃娃" : (: give_wawa :),

    //      "buwawa" : (: give_wawa :),

    //      "bu wawa" : (: give_wawa :),

    "card": (: give_card :),


  ]));
  set("no_wawa", 0);
  //    set("no_feiji",0); 

  set("vendor_goods", ([
    /*
        "cloth": "d/qujing/tongtian/obj/cloth", 
        "cloth1": "d/qujing/dudi/obj/cloth",  
        "rou": "d/qujing/yinwu/obj/rou", 
         "skirt": "d/qujing/tongtian/obj/skirt", 
        "denglong": "d/qujing/jinping/obj/denglong32", 
