}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 3, ob);
  }
  add_action("do_vendor_list", "list");
  add_action("do_nod", "nod");
  add_action("do_yao", "yao");

}

string give_wawa(object me) {

  me = this_player();
  me->set_temp("need_wawa", 1);
  return "布娃娃，可是个好玩的东东，你想要吗？想要你就说嘛，你不说我怎么知道了，难道你真的想要吗？你真的想要？\n";
}


int do_nod(string arg) {
  object me, buwawa, who;
  me = this_player();
  if (me->query_temp("need_wawa")) {
    message_vision("$N答道：我真的想要！\n\n", me);
    //           command("chan");
    if (query("no_wawa") == 0) {
      message_vision(
        "雪绒花低头念了几句咒语，手中忽然多了根雪花棒;雪花棒在空中划过一道美丽的弧线，转瞬间，漫天雪花飞舞;只见一个布娃娃随着飘落的雪花，轻轻落到雪绒花手中,雪绒花说道：布娃娃就给你把！\n",
        me
      );
      me->set_temp("need_wawa", 0);

      buwawa = new("/d/obj/misc/buwawa");
      buwawa->move(me);
      command("baobao " + me->query("id"));
      command("face");
      set("no_wawa", 1);
      call_out("regenerate", 240);
    } else {
      message_vision("雪绒花说道：我那里有那么多的布娃娃啊，你过会在来把。\n", me);
      command("sorry " + me->query("id"));
    }

    return 1;
  }
  return 0;
}
int regenerate() {
  set("no_wawa", 0);
  return 1;
}

string give_card(object me) {

  me = this_player();

  if (present("card", me))
    return "你身上不是已经有信用卡了吗，怎么又来要？\n";
  me->set_temp("need_card", 1);
  return "大唐信用卡，可是个好玩的东东，你想要吗？想要你就说嘛，你不说我怎么知道了，难道你真的想要吗？你真的想要(yao)？\n";
}


int do_yao(string arg) {
  object me, card, who;
  me = this_player();

  if (sizeof(all_inventory(me)) > 35) return notify_fail("你身上物品太多了，清理下再来吧。 \n");
  if (present("datang card", me)) return notify_fail("你身上不是有了吗！\n");
  if (me->query_temp("need_card")) {
    message_vision("$N答道：我真的想要！\n\n", me);
    //           command("chan");
    //     if( query("no_feiji") == 0 )
    //    {
    message_vision(
      "雪绒花低头念了几句咒语，手中忽然多了根雪花棒;雪花棒在空中划过一道美丽的弧线，转瞬间，漫天雪花飞舞;只见一张紫藤信用卡随着飘落的雪花，轻轻落到雪绒花手中。雪绒花说道：信用卡就给你吧！\n",
      me
    );
    //        me->set_temp("need_feiji", 0);

    card = new("/u/wzx/obj/card");
    card->move(me);
    command("baobao " + me->query("id"));
    command("face");
    if (me->query("newbie/lev3")) {
      write(HIG + "\n恭喜您完成了新手任务，奖励您1两黄金并存入信用卡。\n现在您拥有了信用卡，请使用look card命令来了解信用卡的使用。\n如果信用卡不小心遗失，请再向xrhmm索取。\n接下来请去找个门派拜师吧，门派信息请输入help menpai了解。\n当你拜师后再回南城客栈向新手指导(Newbie npc)获取师门奖励。\n
获取指令：ask newbie npc about 师门\n" + NOR);
      me->delete("newbie/lev3");
      me->add("c_balance", 10000);
      me->set("newbie/lev4", 1);
      me->set("newbie/job", "先拜师然后去南城客栈领取师门奖励");
      me->save();
    }

    //      set("no_feiji", 1);
    //      call_out("regenerate", 240);
    //  }
    //   else
    //   {
    //      message_vision("雪绒花说道：我那里有那么多的纸飞机啊，你过会在来把。\n", me);
    //            command("sorry " + me->query("id"));
    //   }

    return 1;
  }
  return 0;
}


void die() {
  if (environment())
    message("sound", "\n\n你们不能对雪绒花妹妹这样哦！\n\n", environment());

  set("eff_kee", 10000);
  set("eff_gin", 10000);
  set("eff_sen", 10000);
  set("kee", 10000);
  set("gin", 10000);
  set("sen", 10000);
  set("force", 10000);
  set("mana", 10000);
}
