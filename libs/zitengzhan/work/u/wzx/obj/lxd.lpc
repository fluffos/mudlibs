#include <ansi.h>

inherit ITEM; 

int do_eat(string);
void init();

void init()
{
  if (!wizardp(this_player())) {
    set("no_drop","这么宝贵的丹药，扔了多可惜呀！\n");
  }
  if(this_player()==environment())
  	add_action("do_eat", "eat");
}
void create()
{
  set_name( HIG "灵仙丹" NOR , ({"lingxian dan", "dan"}));
  set_weight(90);
  set("no_get",1);
	set("no_sell",1);
	set("no_put",1);
	set("no_give",1);
  if (clonep())
    set_default_object(__FILE__);  else {
     set("unit", "颗"); 
    set("long", "一颗珍贵无比的仙丹，吃了它可以提升天赋。\n");
    set("value", 10000000);
    set("drug_type", "补品");
  }
  setup();}

int do_eat(string arg)
{
   object ob = this_object();
  object me = this_player();
  object qs;
  int i, ps;
  i = random(8);
  ps = 1+random(1);  
  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  if(environment(ob) != me)
    return notify_fail("你要吃什么？\n");
  if (i>7) i=7;
   switch(i)
  {
          case 0:                     
           message_vision(HIW"$N吃下"HIG"灵仙丹"HIW"，顿时觉得神清气爽。\n"NOR, me);  
           me->add("str", ps);
           tell_object(me, HIW"你得到了"+chinese_number(ps)+"点先天臂力的奖励。\n"NOR);
           destruct(this_object());break;
         case 1:
            message_vision(HIW"$N吃下"HIG"灵仙丹"HIW"，顿时觉得神清气爽。\n"NOR, me);  
           me->add("cor", ps);
           tell_object(me, HIW"你得到了"+chinese_number(ps)+"点先天胆识的奖励。\n"NOR);
           destruct(this_object());break;
          case 2:
            message_vision(HIW"$N吃下"HIG"灵仙丹"HIW"，顿时觉得神清气爽。\n"NOR, me);  
           me->add("int", ps);
           tell_object(me, HIW"你得到了"+chinese_number(ps)+"点先天悟性的奖励。\n"NOR);
           destruct(this_object());break;
         case 3:
            message_vision(HIW"$N吃下"HIG"灵仙丹"HIW"，顿时觉得神清气爽。\n"NOR, me);  
           me->add("spi", ps);
           tell_object(me, HIW"你得到了"+chinese_number(ps)+"点先天灵性的奖励。\n"NOR);
           destruct(this_object());break;
         case 4:
            message_vision(HIW"$N吃下"HIG"灵仙丹"HIW"，顿时觉得神清气爽。\n"NOR, me);  
           me->add("cps", ps);
           tell_object(me, HIW"你得到了"+chinese_number(ps)+"点先天定力的奖励。\n"NOR);
           destruct(this_object());break;
        case 5:
            message_vision(HIW"$N吃下"HIG"灵仙丹"HIW"，顿时觉得神清气爽。\n"NOR, me);  
           me->add("per", ps);
           tell_object(me, HIW"你得到了"+chinese_number(ps)+"点先天容貌的奖励。\n"NOR);
           destruct(this_object());break;
 case 6:
            message_vision(HIW"$N吃下"HIG"灵仙丹"HIW"，顿时觉得神清气爽。\n"NOR, me);  
           me->add("con", ps);
           tell_object(me, HIW"你得到了"+chinese_number(ps)+"点先天根骨的奖励。\n"NOR);
           destruct(this_object());break;

 case 7:
            message_vision(HIW"$N吃下"HIG"灵仙丹"HIW"，顿时觉得神清气爽。\n"NOR, me);  
           me->add("kar", ps);
           tell_object(me, HIW"你得到了"+chinese_number(ps)+"点先天福缘的奖励。\n"NOR);
           destruct(this_object());break;


          default: return 0;
  }


  return 1;
}



