#include <ansi.h>
#include <weapon.h>
inherit SPEAR;
void create()
{
        set_name(HIB"镇天枪" NOR, ({ "calmsky spear","spear" }) );
        set_weight(7);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long",                        
"这是一把灌注了魔力的枪，是由密银制成的。\n");
                set("value", 0);		
		set("no_get",1);
		set("no_drop",1);
		set ("no_break",1);
                set("material", "steel");                
             }

        init_spear(100);
        setup();

}

mixed hit_ob(object me, object victim, int damage_bonus)
{
	int pro;
	int dam;
	dam = (int) me->query("force");
	dam+= (int) me->query("mana");
        victim->receive_damage("gin",dam/7);
        victim->receive_damage("kee",dam/5);  
	victim->receive_damage("sen",dam/7);
	return HIR "$N手中的镇天枪冒出一团火球，离开$N呼地向$n。烧了过去。\n结果$n的身体上被烧出了一个焦黑的窟窿。\n" NOR;
}
 
void init()
{
	add_action("do_make","remake");
}
int do_make()
{
	object me;
	object obj;
	me=this_player();
	obj=new(__DIR__"box");
	obj->move(me);
	if(query("equipped")) unequip();
	tell_object(me,"你将手中的"+query("name")+"又拆开，组成个箱子。\n");
        destruct(this_object());
	return 1;
}          