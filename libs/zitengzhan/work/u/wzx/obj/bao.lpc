#include <ansi.h>
inherit ITEM;
void create() {
  set_name(HIY "大礼包" NOR, ({ "libao" }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("material", "cloth");
    set("long", "一个神秘的红包,里面的东西是.......\n");
    set("no_drop", "如此宝贵的东西再世难求啊。\n");
    set("no_give", "送人？亏你想的出来！\n");
    set("no_steal", " 抓贼啊！ \n");
    set("no_put", " 嘿嘿，别妄想了！ \n");
    set("no_get", "送人？亏你想的出来！\n");

  }
  setup();
}
void init() {
  if (environment() == this_player())
    add_action("do_open", "open");
}
int do_open(string arg) {
  object gold;
  object me;
  me = this_player();
  if (arg != "bao" && arg != "libao") return 0;
  me->add("potential", 200000);
  me->add("balance", 8888800);
  me->add("combat_exp", 200000);
  me->add("daoxing", 200000);
  write(HIC "乌子婿突然蹦出来，笑嘻嘻地对你说：同志辛苦了！!\n\n");
  destruct(this_object());
  return 1;
}
