//edit by vermin;
inherit NPC;

#include <ansi.h>
#include <obstacle.h>

int ask_for_shang();
int ask_for_go();
int ask_for_cancel();
int accept_object(object me, object obj);
int chuanshou();

void create() {
  set_name(HIM "花雨" NOR, ({ "hua yu", "yu" }));
  set("title", HIW "妙手天师飞雪之妻" NOR);
  set("gender", "女性");
  set("long", "云和山的彼端中天神飞雪的老婆，负责玩家解九迷事宜”。\n");
  set("age", 21);
  set("per", 30);
  set("combat_exp", 300000);
  set_skill("force", 200);
  set_skill("spells", 200);
  set_skill("unarmed", 200);
  set_skill("dodge", 200);
  set_skill("parry", 200);
  set_skill("sword", 200);
  set("gin", 3000);
  set("max_gin", 3000);
  set("kee", 3000);
  set("max_kee", 3000);
  set("sen", 3000);
  set("max_sen", 3000);
  set("force", 1000);
  set("max_force", 1000);
  set("mana", 1000);
  set("max_mana", 1000);
  set("force_factor", 200);
  set("inquiry", ([
    "奖赏": (: ask_for_shang :),
    "解九迷": (: ask_for_go :),
    "放弃九迷": (: ask_for_cancel :),
  ]));
  setup();
  carry_object("/d/obj/cloth/jinpao")->wear();
}

int ask_for_go() {
  object ob = this_player();
  if (ob->query("ask_for_go")) {
    command("say 你不是正在做九迷吗？\n");
    return 1;
  } else if ((int)ob->query("daoxing") <= 60000) {
    command("say 你道行不够，解不了九迷，等道行够了60年再来吧！\n");
    return 1;
  } else if (ob->query("quest/pending")) {
    command("say 先去销了上次的任务！！\n");
    return 1;
  } else {
    command("say 好吧，下面就是解九迷了，要努力呀，别轻言放弃！\n");
    ob->set("ask_for_go", 1);
    ob->set("ask_for_cancel", 0);
    ob->set("jiumi/xianglan", 0);
    ob->set("jiumi/yulan", 0);
    ob->set("jiumi/cuilan", 0);
    ob->set("jiumi/zhu", 0);
    ob->set("jiumi/yin", 0);
    ob->set("jiumi/chen", 0);
    ob->set("jiumi/hu", 0);
    ob->set("jiumi/gong", 0);
    ob->set("jiumi/po", 0);
    return 1;
  }
}

int ask_for_shang() {
  int points, points2;
  object ob = this_player();

  points = (random(21000) + 10000);

  if (ob->query("daoxing") > 1000000) {
    points = points * 1.5;
  }
  if (ob->query("daoxing") > 4000000) {
    points = points * 1.5;
  }
  if (ob->query("daoxing") > 6000000) {
    points = points * 1.5;
  }
  if (ob->query("daoxing") > 9000000) {
    points = points * 1.5;
  }

  points2 = points / 5;

  if (((int)ob->query("jiumi/xianglan") == 1) && ((int)ob->query("jiumi/yulan") == 1)
    && ((int)ob->query("jiumi/cuilan") == 1) && ((int)ob->query("jiumi/zhu") == 1)
    && ((int)ob->query("jiumi/yin") == 1) && ((int)ob->query("jiumi/chen") == 1)
    && ((int)ob->query("jiumi/hu") == 1) && ((int)ob->query("jiumi/gong") == 1)
    && ((int)ob->query("jiumi/po") == 1)) {
    if (ob->query("quest/reward") > 0)  //test player
    {
      command("say 你还是先赴长安进宫请赏吧！找我要奖赏也不急在这一时呀！\n");
      return 1;
    } else {
      command("say 阁下功德圆满，果然了得，我有赏赐予你！\n");
      ob->add("daoxing", points);
      ob->add("potential", points2);
      ob->add("combat_exp", points);
      message_vision(HIR "$N本次九迷得到" + COMBAT_D->chinese_daoxing(points) + "道行！\n" NOR, ob);
      message_vision(HIR "$N本次九迷得到" + chinese_number(points2) + "点潜能！\n" NOR, ob);
      message_vision(HIR "$N本次九迷得到" + chinese_number(points) + "点武学！\n" NOR, ob);
      ob->add("gain_daoxing", points);
      ob->add("gain_potential", points2);
      ob->add("gain_combat_exp", points);
      ob->set("jiumi/xianglan", 0);
      ob->set("jiumi/yulan", 0);
      ob->set("jiumi/cuilan", 0);
      ob->set("jiumi/zhu", 0);
      ob->set("jiumi/yin", 0);
      ob->set("jiumi/chen", 0);
      ob->set("jiumi/hu", 0);
      ob->set("jiumi/gong", 0);
      ob->set("jiumi/po", 0);
      return 1;
    }
  } else if (!(ob->query("ask_for_go"))) {
    command("say 你又没在解九迷，要什么赏？小心我让我们家飞雪办你！！\n");
    return 1;
  } else {
    command("say 你还没解完这轮九迷呢！骗我？小心我让我们家飞雪办你！！\n");
    return 1;
  }
}

int ask_for_cancel() {
  object ob = this_player();
  if (!(ob->query("ask_for_go"))) {
    command("say 你又没在解九迷，放弃什么？");
    return 1;
  } else if (ob->query("ask_for_cancel") == 0) {
    command("say 放弃，对得起我们家飞雪写的程序吗？\n");
    command("say 就不让你放弃!气死你!\n");
    return 1;
  } else {
    command("say 算了，不强求你，你去吧！\n");
    command("say 别忘了销了你的任务！\n");
    ob->delete("jiumi/xianglan");
    ob->delete("jiumi/yulan");
    ob->delete("jiumi/cuilan");
    ob->delete("jiumi/zhu");
    ob->delete("jiumi/yin");
    ob->delete("jiumi/chen");
    ob->delete("jiumi/hu");
    ob->delete("jiumi/gong");
    ob->delete("jiumi/po");
    ob->delete("ask_for_go");
    ob->delete("ask_for_cancel");
    return 1;
  }
}

int accept_object(object me, object obj) {
  object ob = this_player();
  int dh;
  dh = ob->query("daoxing");
  dh = dh / 10;
  if (!(ob->query("ask_for_go"))) {
    return 0;
  } else if (obj->value() >= dh) {
    message_vision("花雨对$N道：" + RANK_D->query_respect(me) + "哎!早知如此,何必当初?\n", me);
    me->set("ask_for_cancel", 1);
    return 1;
  } else {
    command("say 这是干吗?多不好意思。");
    return 1;
  }
}
