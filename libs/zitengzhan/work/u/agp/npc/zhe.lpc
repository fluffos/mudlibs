#include <ansi.h>
inherit NPC;

int ask_tiankongjie();

void create() {
  set_name(HIR "天空界传送使者" NOR, ({ "chuansong zhe", "shizhe", "zhe" }));
  set("long",
    "天空界---问路使者\n");
  set("gender", "男性");
  set("age", 20);
  set("class", "xian");
  set("attitude", "friendly");
  set("per", 40);  //means no rong-mao description.
  set("int", 30);
  set("max_kee", 12000);
  set("max_gin", 14000);
  set("max_sen", 12000);
  set("force", 6000);
  set("max_force", 3000);
  set("force_factor", 500);
  set("max_mana", 3000);
  set("mana", 6000);
  set("mana_factor", 600);
  set("combat_exp", 3000000);
  set("daoxing", 3000000);
  set("eff_dx", 200000);
  set("nkgain", 350);
  set_skill("spells", 900);
  set_skill("buddhism", 900);
  set_skill("unarmed", 900);
  set_skill("jienan-zhi", 900);
  set_skill("dodge", 900);
  set_skill("lotusmove", 900);
  set_skill("parry", 900);
  set_skill("force", 900);
  set_skill("lotusforce", 900);
  set_skill("staff", 900);
  set_skill("lunhui-zhang", 900);
  map_skill("spells", "buddhism");
  map_skill("unarmed", "jienan-zhi");
  map_skill("dodge", "lotusmove");
  map_skill("force", "lotusforce");
  map_skill("parry", "lunhui-zhang");
  map_skill("staff", "lunhui-zhang");
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: cast_spell, "bighammer" :),
  }));

  set("inquiry", ([

    "天空界": (: ask_tiankongjie :),
  ]));

  setup();

  carry_object("/d/obj/armor/jinjia")->wear();
}
int ask_tiankongjie() {
  string str;
  object ob = this_object();
  object me = this_player();
  if (this_player()->query("yc1") != 1) {
    message_vision("天空界传送使者对着$N说道: 过了霸王别姬的考验任务以后再来找我吧！\n", me);
    return 1;
  }
  if (this_player()->query("qicai") < 50) {
    message_vision("天空界传送使者对着$N说道: 你的七彩解迷值不够50个！\n", me);
    return 1;
  }
  if (this_player()->query("qujing") < 50) {
    message_vision("天空界传送使者对着$N说道: 等你取够了50次经我就送你去！\n", me);
    return 1;
  } else {
    message_vision("$N说道：好，既然你已经过了重重考验，证明你是有实力的，我就送你一程吧 ！\n", ob, me);
    tell_object(
      me,
      HIY "天空界传送使者突然脸色一黑，大声的念动咒语:依 木 拉 洒 ，紧接着你眼前一阵强光，刺的你眼睛都睁不开了。不一会，强光散去，你睁开眼看了看，发现自己已经在天空界了。\n" NOR
    );
    //me->delete("bieji1");
    me->move("/d/tiankongjie/jiancha");
    return 1;
  }
}
