int ask_gongde() {
  string str;
  object who = this_player();
  object dan = new("/d/wizz/yhq/gongdedan");

  if (this_player()->query("combat_exp") < 10000000) {
    message_vision("功德大使对着$N说：“你都没有一千万经验值，怎么帮你申请呢。”\n", who);
    return 1;
  } else if (this_player()->query("obstacle/number") < 34) {
    message_vision("功德大使对着$N说：“你都没有完成取经，怎么帮你申请呢。”\n", who);
    return 1;
  } else if (this_player()->query("dhgongde") == 1) {
    message_vision("功德大使对着$N说：“你当自己是谁啊，换那么多次。”\n", who);
    return 1;
  } else {
    str = who->name();
    dan->move(who);
    message("channel:rumor", HIM "【通天界】天上人间II：" + str + "顺利通过系统考验，得到功德丸一粒。\n" NOR, users());
    message("channel:rumor", HIM "【通天界】天上人间II：" + str + "得到了一粒功德丸。\n" NOR, users());
    message_vision("功德大使递给$N1粒功德丸 。\n\n" NOR, who);
    who->set("dhgongde", 1);
    log_file("gongde",
      sprintf("%s(%s) shenqing gongde 时间 %s\n",
        who->name(1), geteuid(who), ctime(time())));
    return 1;
  }
}
int jiemi() {
  string str;
  object who = this_player();

  if (this_player()->query("gongde") < 1) {
    message_vision("功德大使对着$N说：“你都没有功德值，怎么帮你换呢。”\n", who);
    return 1;
  } else if (this_player()->query("quest/number") > 2000) {
    message_vision("功德大使对着$N说：“你都超过2000个了，别贪得无厌了。”\n", who);
    return 1;
  } else {
    str = who->name();
    message("channel:rumor", HIM "【通天界】天上人间II：" + str + "通过功德值换取一千个开封解谜任务。\n" NOR, users());
    message_vision("突然一阵红光笼罩着$N。\n" NOR, who);
    if (who->query("quest/number") < 1000) {
      who->set("jiemi/reward1", "done");
    } else if (who->query("quest/number") < 2000) {
      who->set("jiemi/reward2", "done");
    }
    who->add("quest/number", 1000);
    who->add("gongde", -1);
    log_file("gongde",
      sprintf("%s(%s) duihuan jiemi 时间 %s\n",
        who->name(1), geteuid(who), ctime(time())));
    return 1;
  }
}

int wddrrb() {
  string str;
  object who = this_player();

  if (this_player()->query("gongde") < 1) {
    message_vision("功德大使对着$N说：“你都没有功德值，怎么帮你换呢。”\n", who);
    return 1;
  }

  if (this_player()->query("gongde_wddrrb") > 9) {
    message_vision("功德大使对着$N说：“你怎么如此贪得无厌？！自己做包子去！”\n", who);
    return 1;
  }


  else {
    str = who->name();
    message("channel:rumor", HIM "【通天界】天上人间II：" + str + "通过功德值换取一千点无底洞人肉包子点数。\n" NOR, users());
    message_vision("突然一阵红光笼罩着$N。\n" NOR, who);
    if (!who->query("gongde_wddrrb")) who->set("gongde_wddrrb", 0);
    who->add("gongde_wddrrb", 1);
    who->add("gongde", -1);
    if (!who->query("wudidong/sell_reward")) who->set("wudidong/sell_reward", 0);
    who->add("wudidong/sell_reward", 1000);
    log_file(
      "gongde",
      sprintf("%s(%s) duihuan wddrrb 时间 %s\n", who->name(1), geteuid(who), ctime(time()))
    );
    return 1;
  }
}

