#include <ansi.h>
int exp();
int danlu();
int dh();
int baotu();
int jinbi();
int qn();
int qianneng();
int dajiu();
int jiemi();
int zhongkui();
int cdajiu();
int rulai();
int haomao();
int shashou();
int ask_gongde();
int bili();
int con();
int per();
int cor();
int cps();
int wuxing();
int spi();
int kar();
int wddrrb();
int zui();
int yincang();
int qicaijiemi();

inherit NPC;
void create() {
  set_name(HBBLU "功德大使" NOR, ({ "dashi", "gongde dashi" }));
  set("title", HIY "天上人间II" NOR);
  set("long", HIR "\n他就是天上人间II的功德大使。\n
  \n" NOR);
  set("gender", "男性");
  set("age", 25);
  set("str", 1000);
  set("per", 32);
  set("max_kee", 5000);
  set("max_gin", 5000);
  set("max_sen", 5000);
  set("force", 6000);
  set("max_force", 12000);
  set("force_factor", 300);
  set("max_mana", 7000);
  set("mana", 16000);
  set("mana_factor", 350);
  set("combat_exp", 2400000);
  set("daoxing", 6800000);
  set("inquiry", ([
    "name": "我就是天上人间II的功德大使，你有什么需要我帮忙的。\n",
    "功德兑换规则": "兑换规则为:1功德 = 10w exp= 10w qn= 1000y dh= 0.5属性= 40jinbi = 1 haomao，
 \n获取功德的方法可以用任务数兑换，比例为1000杀手楼任务,1500钟馗抓鬼任务，3000如来任务，1000万的vip卡内潜能，\n
 还有3000个搭救数量,或者一个取经完成的1000万exp大米.这些可以兑换1点功德。\n另外1功德可以兑换1000点无底洞人肉包子点数.1汇票可以兑换1滴酒葫芦千年醉。\n",
    "兑换经验": (: exp :),
    "兑换潜能": (: qn :),
    "强盗数换公德": (: baotu :),
    "兑换道行": (: dh :),
    "兑换金币": (: jinbi :),
    "兑换毫毛": (: haomao :),
    "兑换先天臂力": (: bili :),
    "兑换先天悟性": (: wuxing :),
    "兑换先天容貌": (: per :),
    "兑换先天福缘": (: kar :),
    "兑换先天定力": (: cps :),
    "兑换先天胆识": (: cor :),
    "兑换先天根骨": (: con :),
    "兑换先天灵性": (: spi :),
    "兑换解谜数量": (: jiemi :),
    "兑换搭救数量": (: dajiu :),
    "兑换无底洞人肉包子点数": (: wddrrb :),
    "票子兑换千年醉": (: zui :),
    "钟馗数兑换功德": (: zhongkui :),
    "搭救数兑换功德": (: cdajiu :),
    "如来数兑换功德": (: rulai :),
    "杀手数兑换功德": (: shashou :),
    "功德兑换丹炉": (: danlu :),
    "潜能数兑换功德": (: qianneng :),
    "兑换七彩解迷": (: qicaijiemi :),
    "兑换功德": (: ask_gongde :),
    "隐藏门派功德": (: yincang :),
  ]));
  setup();
}

int qicaijiemi() {
  string str;
  object who = this_player();

  if (this_player()->query("gongde") < 1) {
    message_vision("功德大使对着$N说：“你都没有功德值，怎么帮你换呢。”\n", who);
    return 1;
  } else {
    str = who->name();
    message("channel:rumor", HIM "【通天界】天上人间II：" + str + "通过功德值换取5点七彩解迷值。\n" NOR, users());
    message_vision("突然一阵红光笼罩着$N。\n" NOR, who);
    who->add("qicai", 5);
    who->add("gongde", -1);
    log_file("gongde",
      sprintf("%s(%s) duihuan exp 时间 %s\n",
        who->name(1), geteuid(who), ctime(time())));
    return 1;
  }
}

int jinbi() {
  string str;
  object who = this_player();
  object money = new("/clone/money/jinbi");

  if (this_player()->query("gongde") < 1) {
    message_vision("功德大使对着$N说：“你都没有功德值，怎么帮你换呢。”\n", who);
    return 1;
  } else {
    str = who->name();
    money->set_amount(40);
    money->move(who);
    message("channel:rumor", HIM "【通天界】天上人间II：" + str + "通过功德值换取40枚金币。\n" NOR, users());
    message_vision("功德大使递给$N 40枚金币。\n\n" NOR, who);
    who->add("gongde", -1);
    log_file("gongde",
      sprintf("%s(%s) duihuan jinbi 时间 %s\n",
        who->name(1), geteuid(who), ctime(time())));
    return 1;
  }
}

