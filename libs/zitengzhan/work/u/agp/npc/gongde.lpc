int bili() {
  string str;
  object who = this_player();

  if (this_player()->query("gongde") < 2) {
    message_vision("功德大使对着$N说：“你的功德值不够两点，怎么帮你换呢。”\n", who);
    return 1;
  } else if (this_player()->query("str") > 59) {
    message_vision("功德大使对着$N说：“上限是60点，你都达到了，怎么帮你换呢。”\n", who);
    return 1;
  } else {
    str = who->name();
    message("channel:rumor", HIM "【通天界】天上人间II：" + str + "通过功德值换取一点先天体格。\n" NOR, users());
    message_vision("突然一阵红光笼罩着$N。\n" NOR, who);
    who->add("str", 1);
    who->add("gongde", -2);
    log_file("gongde",
      sprintf("%s(%s) duihuan str 时间 %s\n",
        who->name(1), geteuid(who), ctime(time())));
    return 1;
  }
}
