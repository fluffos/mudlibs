  string str;
  object who = this_player();

  if (this_player()->query("gongde") < 1) {
    message_vision("功德大使对着$N说：“你都没有功德值，怎么帮你换呢。”\n", who);
    return 1;
  } else {
    str = who->name();
    message("channel:rumor", HIM "【通天界】天上人间II：" + str + "通过功德值换取十万经验。\n" NOR, users());
    message_vision("突然一阵红光笼罩着$N。\n" NOR, who);
    who->add("combat_exp", 100000);
    who->add("gongde", -1);
    log_file("gongde",
      sprintf("%s(%s) duihuan exp 时间 %s\n",
        who->name(1), geteuid(who), ctime(time())));
    return 1;
  }
}
int yincang() {
  string str;
  object who = this_player();

  if (this_player()->query("yc1") != 1) {
    message_vision("功德大使对着$N说：“你都没有通过隐藏任务。”\n", who);
    return 1;
  } else if (this_player()->query("yc1-gift") == 1) {
    message_vision("功德大使对着$N说：“你都拿过了还想拿。”\n", who);
    return 1;
  } else {
    str = who->name();
    message("channel:rumor", HIM "【通天界】天上人间II：" + str + "通过隐藏门派考念，获取10点功德值。\n" NOR, users());
    message_vision("突然一阵红光笼罩着$N。\n" NOR, who);
    who->add("gongde", 10);
    who->delete("family");
    who->set("yc1-gift", 1);
    log_file("gongde",
      sprintf("%s(%s) duihuan yincang 时间 %s\n",
        who->name(1), geteuid(who), ctime(time())));
    return 1;
  }
}
