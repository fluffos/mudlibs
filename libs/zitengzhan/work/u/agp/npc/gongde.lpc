int rulai() {
  string str;
  object who = this_player();

  if (who->query("rulaitask_log/kill1") + who->query("rulaitask_log/kill2") + who->query("rulaitask_log/kill3") + who->query("rulaitask_log/arrest1") + who->query("rulaitask_log/arrest2") + who->query("rulaitask_log/arrest3") + who->query("rulaitask_log/persuade1") + who->query("rulaitask_log/persuade2") + who->query("rulaitask_log/persuade3") + who->query("rulaitask_log/fight1") + who->query("rulaitask_log/fight2") + who->query("rulaitask_log/fight3") < 3001) {
    message_vision("功德大使对着$N说：“你的如来数量不够，怎么帮你换呢。”\n", who);
    return 1;
  } else if (who->query("rulaitask_log/kill1") < 300) {
    message_vision("功德大使对着$N说：“你的如来数量不够，怎么帮你换呢。”\n", who);
  } else if (who->query("rulaitask_log/kill2") < 200) {
    message_vision("功德大使对着$N说：“你的如来数量不够，怎么帮你换呢。”\n", who);
  } else if (who->query("rulaitask_log/kill3") < 100) {
    message_vision("功德大使对着$N说：“你的如来数量不够，怎么帮你换呢。”\n", who);
  } else if (who->query("rulaitask_log/arrest1") < 300) {
    message_vision("功德大使对着$N说：“你的如来数量不够，怎么帮你换呢。”\n", who);
  } else if (who->query("rulaitask_log/arrest2") < 200) {
    message_vision("功德大使对着$N说：“你的如来数量不够，怎么帮你换呢。”\n", who);
  } else if (who->query("rulaitask_log/arrest3") < 100) {
    message_vision("功德大使对着$N说：“你的如来数量不够，怎么帮你换呢。”\n", who);
  } else if (who->query("rulaitask_log/persuade1") < 300) {
    message_vision("功德大使对着$N说：“你的如来数量不够，怎么帮你换呢。”\n", who);
  } else if (who->query("rulaitask_log/persuade2") < 200) {
    message_vision("功德大使对着$N说：“你的如来数量不够，怎么帮你换呢。”\n", who);
  } else if (who->query("rulaitask_log/persuade3") < 100) {
    message_vision("功德大使对着$N说：“你的如来数量不够，怎么帮你换呢。”\n", who);
  } else if (who->query("rulaitask_log/fight1") < 300) {
    message_vision("功德大使对着$N说：“你的如来数量不够，怎么帮你换呢。”\n", who);
  } else if (who->query("rulaitask_log/fight2") < 200) {
    message_vision("功德大使对着$N说：“你的如来数量不够，怎么帮你换呢。”\n", who);
  } else if (who->query("rulaitask_log/fight3") < 100) {
    message_vision("功德大使对着$N说：“你的如来数量不够，怎么帮你换呢。”\n", who);
  } else {
    str = who->name();
    message("channel:rumor", HIM "【通天界】天上人间II：" + str + "通过如来数量换取一功德。\n" NOR, users());
    message_vision("突然一阵红光笼罩着$N。\n" NOR, who);
    who->add("rulaitask_log/kill1", -300);
    who->add("rulaitask_log/kill2", -200);
    who->add("rulaitask_log/kill3", -100);
    who->add("rulaitask_log/arrest1", -300);
