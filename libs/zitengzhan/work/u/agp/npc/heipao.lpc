//Cracked by Roath
inherit NPC;
#include <ansi.h>
inherit F_MASTER;

#include </d/panshi/panshi.h>
void create() {
  set_name("黑袍", ({ "heipao" }));
  set("gender", "男性");
  set("age", 33);
  set("title", HIR "无天座下右护法" NOR);
  set("combat_exp", 1500000);
  set("daoxing", 1500000);
  set("long", "此魔是无天座下右护法，为人凶狠残暴，嗜血如命。他本
是一山妖，后被无天收服，得己重用，是无天必不可少的
刽子手。\n");
  set("attitude", "peaceful");
  set("int", 25);
  set("class", "mo");
  create_family("魔界", 2, "弟子");

  set("eff_dx", 30000);
  set("nkgain", 200);

  set_skill("unarmed", 280);
  set_skill("dodge", 280);
  set_skill("parry", 280);
  set_skill("spells", 280);
  set_skill("molian-spells", 280);
  set_skill("literate", 280);
  set_skill("sword", 280);
  set_skill("xueling-jian", 280);
  set_skill("shifo-zhi", 280);
  set_skill("moshenbu", 280);
  set_skill("dodge", 280);
  set_skill("force", 280);
  set_skill("heilian-force", 280);

  map_skill("spells", "molian-spells");
  map_skill("unarmed", "shifo-zhi");
  map_skill("force", "heilian-force");
  map_skill("sword", "xueling-jian");
  map_skill("parry", "xueling-jian");
  map_skill("dodge", "moshenbu");


  set("per", 30);
  set("max_kee", 2500);
  set("max_sen", 2500);
  set("force", 2500);
  set("max_force", 2500);
  set("force_factor", 50);
  set("mana", 2500);
  set("max_mana", 2500);
  set("mana_factor", 50);

  set("inquiry", ([ "leave": (: askLeave :), ]));

  create_family("魔界", 3, "蓝");

  setup();

  carry_object("/d/qujing/kusong/obj/tongjia")->wear();
}

void attempt_apprentice(object ob) {
  ob = this_player();

  if ((string)ob->query("family/family_name") == "魔界") {
    command("say 大家同门中人，不敢当，不敢当！\n");
    return;
  }
  command("grin");
  command("recruit " + ob->query("id"));
  return;
}

int recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob)) {
    ob->set("title", "魔界妖童");
  }
}

void init() { add_action("doAgree", "agree"); }
