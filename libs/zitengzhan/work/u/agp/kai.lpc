inherit NPC;

#include <ansi.h>
int give_dou();
int qujing_done();

int create() {
  set_name(HIM "小凯" NOR, ({ "xiao kai", "kai", "master" }));
  set("long", "恩。高人。\n");

  set("gender", "男性");
  set("attitude", "peaceful");
  set("class", "bonze");
  set("age", 15);
  set("str", 20);
  set("int", 30);
  set("per", 40);
  set("con", 20);
  set("max_kee", 400);
  set("max_sen", 400);
  set("max_force", 300);
  set("force", 300);
  set("force_factor", 10);
  set("max_mana", 400);
  set("mana", 400);
  set("mana_factor", 10);
  set("combat_exp", 50000);
  set("daoxing", 80000);


  set("chat_chance", 5);
  set("chat_msg", ({
    "小凯叹道：淘淘回来了，工作辛苦吧?\n",
    "小凯说道：童钢，我做的可可豆出锅了，你要吃点吗?\n",
    "小凯叹道：淘淘，你要多听听你妈的话呀，别在惹她生气了，知道吗！\n",
    "小凯叹道：以后少抽点烟，对你的身体不好！\n",
    "小凯叹道：狗狗最乖了，我最喜欢狗狗了!\n",
    "小凯说道：淘淘什么时候娶我呀？哈.....\n",
    "小凯叹道：淘淘，今天我做炉包，你吃吗?\n",
  }));
  set("inquiry", ([
    "可可豆": (: give_dou :),
    "dou": (: give_dou :),
    "qujing": (: qujing_done :),
    "取经": (: qujing_done :),


  ]));

  set_skill("force", 50);
  set_skill("unarmed", 50);
  set_skill("dodge", 79);
  set_skill("parry", 79);
  set_skill("staff", 50);
  set_skill("lotusforce", 50);
  set_skill("lunhui-zhang", 79);
  set_skill("jienan-zhi", 50);
  set_skill("lotusmove", 79);
  map_skill("dodge", "lotusmove");
  map_skill("unarmed", "jienan-zhi");
  map_skill("staff", "lunhui-zhang");
  map_skill("parry", "lunhui-zhang");
  map_skill("force", "lotusforce");
  setup();
  add_money("silver", 5);
  carry_object("/u/tonggang/obj/skirt")->wear();
  carry_object("/u/tonggang/obj/dou");
  set("dous", 3);
  setup();
}

int qujing_done()  //每次测试都要一个一个的call 麻烦！我做一个 by tonggang
{
  object me = this_player();
  if (!me->query("qujing_agree")) {
    //		command ("say 好哇你，童钢不在，你就想乱来啊！");
    //		return 1;
  }
  me->set("obstacle/yz", "done");
  me->set("obstacle/jilei", "done");
  me->set("obstacle/nuerguo", "done");
