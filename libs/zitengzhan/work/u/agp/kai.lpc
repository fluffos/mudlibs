  me->set("obstacle/yuhua", "done");
  me->set("obstacle/hf", "done");
  me->set("obstacle/jindou", "done");
  me->set("obstacle/yj", "done");
  me->set("obstacle/fengxian", "done");
  me->set("obstacle/tongtian", "done");
  me->set("obstacle/sc", "done");
  me->set("obstacle/yinwu", "done");
  me->set("obstacle/jz", "done");
  me->set("obstacle/chechi", "done");
  me->set("obstacle/qinfa", "done");
  me->set("obstacle/huoyun", "done");
  me->set("obstacle/wudidong", "done");
  me->set("obstacle/wuji", "done");
  me->set("obstacle/liuer-mihou", "done");
  me->set("obstacle/pingding", "done");
  me->set("obstacle/biqiu", "done");
  me->set("obstacle/baoxiang", "done");
  me->set("obstacle/pansi", "done");
  me->set("obstacle/baigudong", "done");
  me->set("obstacle/zhuzi", "done");
  me->set("obstacle/shushan", "done");
  me->set("obstacle/wuzhuang", "done");
  me->set("obstacle/xiaoxitian", "done");
  me->set("obstacle/shenglingzhu", "done");
  me->set("obstacle/village", "done");
  me->set("obstacle/niulang", "done");
  me->set("obstacle/jingjiling", "done");
  me->set("obstacle/liusha", "done");
  me->set("obstacle/tianzhu", "done");
  me->set("obstacle/huangfeng", "done");
  me->set("obstacle/jisaiguo", "done");
  me->set("obstacle/dudi", "done");
  me->set("obstacle/jinping", "done");
  me->set("obstacle/number", 38);
  me->delete("qujing_agree");
  command("shrug");
  command("say 又耍赖皮，跟我家狗狗一个德行！");
}
int give_dou() {
  object who = this_player();
  object dou;

  if (query("dous") <= 0) {
    command("say 不给了，不给了，你们把豆吃光了，我怎么跟童钢交待呀！");
    return 1;
  }

  dou = new("/u/tonggang/obj/dou");
  add("dous", -1);
  message_vision(HIM "小凯" NOR "给$N一颗$n。\n", who, dou);
  dou->move(who);
  return 1;
}
