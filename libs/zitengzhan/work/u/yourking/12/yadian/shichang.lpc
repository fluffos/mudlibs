

inherit ROOM;

void create ()
{
  set ("short", "市场");
  set ("long", @LONG

  雅典最热闹的地方。

LONG);

  set("exits", ([
        "west" : __DIR__"bank",
        "east" : __DIR__"dangpu",
        "north" : __DIR__"yaodian",
        "south" : __DIR__"shizhongxin",
      ]));
  set("objects", ([
        "/d/yun/npc/heike"   : 1,
      ]));
  set("outdoors", __DIR__);

  setup();
}
 void init()
{
  add_action("do_fly", "fly");
}
int do_fly (string arg)
{
  object me;
  me = this_player();

  message_vision("只见$N向上一飞，突然重重地摔了下来。\n", me);
  tell_object(me,"看样子在圣域里真是插翅难飞……\n");
  return 1;
}


