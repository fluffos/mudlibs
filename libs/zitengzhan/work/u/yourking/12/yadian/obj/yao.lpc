inherit COMBINED_ITEM;

void setup() {}

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name("止血药", ({ "zhixie yao", "yao" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("base_unit", "包");
    set("unit", "些");
    set("long", "一包止血药．\n");
    set("value", 3000);
    set("drug_type", "良药");
  }
  set_amount(1);

  setup();
}

int do_eat(string arg) {
  if (arg != "zhixie yao" && arg != "yao")
    return 0;

  //  if ((int)this_player()->query("eff_sen") == 
  //    (int)this_player()->query("max_sen"))
  //    return notify_fail("你现在不需要吃药。\n")
  else {
    this_player()->receive_curing("kee", 40 + random(10));
    message_vision("$N咽下一包止血药，精神焕发。\n", this_player());
    add_amount(-1);
    return 1;
  }
}
