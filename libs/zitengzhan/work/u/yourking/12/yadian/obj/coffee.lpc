
inherit COMBINED_ITEM;

void setup()
{}

void init()
{
  add_action("do_eat", "eat");
}

void create()
{
  set_name("咖啡", ({"coffee",}));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("base_unit", "包");
    set("unit", "些");
    set("long", "一包的咖啡。\n");
    set("value", 3000);
    set("drug_type", "良药");
  }
  set_amount(1);
  setup();
}

int do_eat(string arg)
{
  if (arg != "coffee" && arg != "coffee")
    return 0;

//  if ((int)this_player()->query("eff_kee") == 
//    (int)this_player()->query("max_kee"))
//    return notify_fail("你现在不困。\n")
  else {
    this_player()->receive_curing("sen", 40+random(10));
    message_vision("$N喝下一杯咖啡，顿时精神好多了。\n",this_player());
    add_amount(-1);
    return 1;
  }
}

