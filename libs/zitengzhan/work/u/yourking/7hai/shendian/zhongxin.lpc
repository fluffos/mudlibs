#include <ansi.h>
inherit ROOM;


void create ()
{
  set ("short", HIY"地中海下"NOR);
  set ("long", HIC @LONG

   这里是海皇波士顿的海底神殿！
   它通向支撑七大样的柱子！
   
LONG NOR);

  set("exits", ([
  "south" : "/d/7hai/ydy/lu1",
  "enter" : __DIR__"shendian",
  "west" :  "/d/7hai/ndxy/lu1",
  "east" :  "/d/7hai/btpy/lu1",
  "northeast" : "/d/7hai/bby/lu1",
  "northwest" : "/d/7hai/bdxy/lu1",
  "southeast" : "/d/7hai/ntpy/lu1",
  "southwest" : "/d/7hai/nby/lu1",
  "up" : "/d/yun/haibian",
]));
set("no_fly", 1);
set("water", 1);
 set("objects", ([
  __DIR__"npc/doushi" : 4,
  __DIR__"npc/yu" : 1,
]));
set("valid_startroom", 1);
  setup();
}

 int valid_leave(object me, string dir)
{
  if (dir == "enter") {
        if (objectp(present("hai doushi", environment(me))))
        return notify_fail("海斗士伸手挡住了你的去路。\n");
        if (me->query("7hai/number")<7)
        return notify_fail("看来你要先毁坏支撑七海的柱子！\n");
        }   
        return ::valid_leave(me, dir);
}

