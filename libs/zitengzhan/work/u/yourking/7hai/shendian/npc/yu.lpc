#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int give_gift();
void create() {
  set_name(HIG "狄蒂丝" NOR, ({ "didi si", "didisi", }));
  set("title", HIY "美人鱼星座" NOR);
  set("long", "
    美人鱼星座海斗士。
\n");
  set("gender", "女性");
  set("age", 16);
  set("attitude", "peaceful");
  set("env/wimpy", 110);
  set("str", 18);
  set("int", 28);
  set("per", 30);
  set("con", 20);
  set("dex", 24);
  set("max_see", 500);
  set("max_sen", 300);
  set("force", 500);
  set("max_force", 500);
  set("jiali", 10);
  set("combat_exp", 40000);

  set_skill("force", 100);
  set_skill("dodge", 100);
  set_skill("parry", 100);
  set_skill("unarmed", 100);
  set_skill("literate", 100);

  setup();

  carry_object("/d/7hai/shendian/obj/yu")->wear();
}

void init() {
  object ob;
  ::init();
  set("inquiry", ([
    "7hai": (: give_gift :),



  ]));
}


int give_gift() {
  object m;
  object me = this_object();
  object who = this_player();
  m = new("/d/7hai/shendian/obj/gift.lpc");
  if (who->query("7hai/gift")) {
    me->command("say 这位仙长，你的礼物不是已经给你了吗？");
    me->command("? " + who->query("id"));
    return 1;
  }
  if (who->query("7hai/haihuang") != "done") {
    me->command("say 这位仙长，你还是先杀死教皇再来要礼物吧？");
    me->command("? " + who->query("id"));
    return 1;
  }
  message_vision(HIW "\n只见" + HIY + "狄蒂丝" + HIW + "惊叹道：$N竟然能闯过七海神殿,果然厉害。\n" NOR, who);
  message_vision(HIW "只见" + HIY + "狄蒂丝" + HIW + "呵呵一笑，掏出一包药粉顺手交给了$N。\n" NOR, who);
  m->move(who);
  who->set("7hai/gift", "got");
  return 1;

}
