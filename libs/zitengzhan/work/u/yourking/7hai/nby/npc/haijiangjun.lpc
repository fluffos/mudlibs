#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int rank_me();

void create()
{
        set_name("隆奈狄斯", ({"hai jiangjun",}));
        set("gender", "男性" );
        set("age", 20);
        set("title",HIY"海将军"HIW"-"HIC"水妖星座"NOR);
        set("long", "他是守护南冰洋之柱的海斗士。\n");
        set("combat_exp", 2600000);
        set("daoxing",5000000);
        set("attitude", "peaceful");
        set("force", 2500);
        set("max_force", 2500);
        set("force_factor", 100);
        set("max_mana", 2500);
        set("mana", 2500);
        set("mana_factor", 100);
        set_skill("dodge", 180);
        set_skill("unarmed", 180);
        set_skill("literate", 180);
        set_skill("parry", 180);
        set("per", 23);
        set("max_kee", 20000);
        set("max_gin", 1000);
        set("max_sen", 10000);
        setup();
        carry_object("/d/7hai/nby/obj/linyi")->wear();
}

void destruct_me (object me)
{
  destruct (me);
}
void unconcious()
{
die ();
}

void die ()
{
object me = this_object();
 object ob = query_temp("last_damage_from");
 call_out ("haihuang_appearing",1,ob);
 load_object("/obj/empty");
  me->move("/obj/empty");
  call_out ("destruct_me",3,me);
}
void haihuang_appearing (object who)
{
  object haihuang = new ("/d/7hai/nby/npc/haihuang");

  haihuang->announce_success (who);
  destruct (haihuang);
}

void init()
{
        object ob;
        if (interactive(ob = this_player()) && !is_fighting()) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
   }
}
void greeting(object me)
{
    message("vision", "云中仙走了过来。\n",me);
    message("vision", HIW"你和云中仙一碰面，二话不说就打了起来！\n"NOR,me);
    message("vision", RED"云中仙目不转睛地盯着你，准备发出致命一击。\n\n\n"NOR,me);
    message("vision", HIW "云中仙使出剑术绝技中最强的" + HIC "仙云夺命剑" +HIW "，你只觉得眼前一花，咽喉已被对穿而过！！！\n\n"NOR,me) ;
    message("vision", HIY"一股血箭喷涌而出．．你的眼睛死鱼般的突了出来．．\n\n"NOR,me);
    message("vision", "你死了。\n"NOR,me);
    message("vision", HIM"【谣言】某人："+me->name()+"莫名其妙地死了。\n"NOR,me);
    message("vision", HIW"阴阳界 "NOR"- \n",me);
    message("vision", "隐约北方现出一座黑色城楼，光线太暗，看不大清楚。许多亡魂正
                       哭哭啼啼地列队前进，因为一进鬼门关就无法再回阳间了。周围尺
                       高的野草随风摇摆，草中发出呼呼的风声。\n",me);
    message("vision", "这里明显的出口是 "HIG"north、east、west "NOR"和"HIG" south。\n\n"NOR,me);
    message("vision", HIW"朱笔判官 崔珏"NOR"(Cui jue)\n",me);
    message("vision", HIW"崔判官向你招招手，说道：新来的，你莫乱跑，画了生死簿，我好送你还阳。\n\n"NOR,me);
    message("vision", HIW"崔判官看着你笑了笑，说道：生死有命，你也不要太难过了。\n\n"NOR,me);
    message("vision", HIW"崔判官从怀中拿出一个黑底白字的册子翻看着。。。\n\n"NOR,me);
    message("vision", HIW"崔判官合上册子，说道：命不该死，多留无益，我这便送你还阳去吧！\n\n"NOR,me);
    message("vision", HIW"崔判官伸手向你一指，你的魂魄又回到了自己身上。。。\n\n"NOR,me);
    message("vision", HIW"一股阴冷的浓雾突然出现，很快地包围了你。\n\n"NOR,me);
    message("vision", "ok.\n",me);
}
