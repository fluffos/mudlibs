#include <armor.h>
#include <ansi.h>
#include <weapon.h>
inherit ARMOR;

void create()
{
        set_name( HIC "六头怪星座"+HIY+"鳞衣" NOR, ({"lin yi","silver armor", "yi", "armor"}));
        set_weight(30000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
		set("long",HIC "海斗士的鳞衣。\n"NOR);
                set("material", "steel");
                set("value", 1000000);
                set("no_sell",1);
                set("no_give", 1);
                set("no_drop", 1);
                set("no_put", 1);
                set("armor_prop/armor", 400);
                set("wear_msg", HIC"$N凌空一指变出了$n"+HIC+"穿在身上，防御能力迅速提升了！\n"NOR);
                set("remove_msg","$N将$n脱了下来。\n");
		//set("armor_prop/dodge", 50);
		set("ride/dodge", 500);
        }
        setup();
}


