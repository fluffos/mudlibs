int valid_leave(object me, string dir)
{
  if (dir == "enter" ){
  if (me->query("7hai/haihuang") != "done")
    return notify_fail ("你还没有打败海皇波士顿！\n");
  return 1;
  }
  return ::valid_leave(me, dir);
}



