#include <ansi.h>
#include <weapon.h>
inherit MACE;

void create() {
  set_name(HIY "笛子" NOR, ({ "di zi" }));
  set_weight(7000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "只");
    set("long", HIW "一只笛子。\n" NOR);
    set("value", 1000000);
    set("no_sell", 1);
    //set("no_give", 1);
    set("no_drop", 1);
    set("no_put", 1);
    set("material", "steel");
    set("weapon_prop/personality", 24);
    set("wield_msg", HIC "$N凌空一指，变出了$n" + HIC + "握在手中。\n" NOR);
    set("unwield_msg", "$N把$n向海中抛去，$n消失了。\n");
  }
  init_mace(500);
  setup();
}
