#include <ansi.h>

inherit MONEY;

void create() {
  set_name(WHT "银币" NOR, ({ "yinbi" }));
  set("money_id", "yinbi");
  set("long", WHT "一枚大唐西游的银币，正面是全体巫师的全家福。\n" NOR);
  set("unit", "堆");
  set("base_value", 10000000);
  set("base_unit", "枚");
  set("base_weight", 3);
  set_amount(1);
}
