//created by lxmas 2008.12.19

#include <ansi.h>

inherit ITEM;
int get_gift(string arg);
void create()
{
  set_name(HIY"一大锅饺子" NOR ,({"guo"}));
  set("long","这是大唐西游巫师为了玩家度过冬至而做的一大锅饺子，玩家可以在这里拿(take)饺子(jiaozi)吃。");
  set("unit", "个");
  set("value", 1000000000000);
}
void init()
{
  if (!wizardp(this_player())) 
   set("no_get","这个东西拿不起来。\n");
  add_action("get_jiaozi","take");
}
int get_jiaozi(string arg)
{
  object me=this_player();
  object lw;
  if (arg!="jiaozi") return 0;
  if (me->query("dongzhi_gift")) return notify_fail("你已经领过饺子了,小心撑死你！\n");
  if ((int)me->query("combat_exp")<=100000)
      return notify_fail("新来的吧？去练到10万wx再来吃饺子吧！\n");
  message_vision("$N从锅里捞出来一碗饺子。\n" NOR, me);
  lw=new("/u/lxmas/obj/dongzhi/jiaozi");
  lw->move(me);
  me->set("dongzhi_gift",1);
  return 1;
}
