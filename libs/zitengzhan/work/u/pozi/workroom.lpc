#include <ansi.h>
inherit ROOM;
void create() {
  set("short", HIY "隐龙台" NOR);
  set("long", @LONG
这里清新典雅，没什么特别,中堂站着的丫鬟，身材火辣，但又娇小可人，让人浮想连篇。
LONG);
  set("no_time", 1);
  set("no_fight", 1);
  set("no_kill", 1);
  set("if_ben", 1);
  set("no_magic", 1);
  set("exits", ([
    "kz": "/d/city/kezhan.lpc",
    "wiz": "/d/wiz/wizroom.lpc",
    "up": "/u/pozi/bedroom",
  ]));

  set("no_clean_up", 0);
  setup();
}

int valid_leave(object me, string dir) {
  if (dir == "north") {
    if (me->query("id") == "pozi" || me->query("id") == "gudu"
      || me->query("id") == "zlga" || me->query("id") == "lying")
      return ::valid_leave(me, dir);
    return notify_fail(CYN "雙儿" HIR "对你说道：站住！" HIG "我家老爷" HIR "的睡房你也敢乱闯，还是好好呆着吧。\n" NOR);
  }

  return ::valid_leave(me, dir);

}
