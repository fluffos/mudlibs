// by sadboy
#include <ansi.h>
 
inherit NPC;
inherit F_VENDOR;

string give_gift();


void create()
{
   set_name(HIC"财神爷"NOR, ({"caishen ye","ye"}));
   set("title", HIW"万☆物☆为☆金"NOR);
   set("gender", "男性");
   set("long","农历龙年的代表，长的十分魁梧，和蔼可亲，但却很少说话。你可以试着跟他要新手启动资金(gift)\n");
   set("combat_exp", 500000);
   set("age", 20);
   set("per", 27);
   set("attitude", "friendly");
   set("shen_type", 1);
   set_skill("unarmed", 300);
   set_skill("dodge", 300);
   set("inquiry", ([
          "gift" : (: give_gift :),
                  ]) );
   setup();
   carry_object("/d/obj/cloth/magua")->wear();
   add_money("silver", 5);
}

void init()
{
  add_action("do_yao","yao");
}

string give_gift(object me)
{
   me=this_player();
   
   if ((int)me->query("combat_exp") + (int)me->query("daoxing") > 2000000) 
        {
             me->set_temp("ggyao",1);
             return "新手启动资金，每人只有一份，你真的想要(yao)吗？\n"; 
        }
   return "你武学加道行200w以上再来领取吧！";
}


int do_yao(string arg)
{
   object me,gift;
   me=this_player();
   if (!me->query("2012gift_given")&& me->query_temp("ggyao")) 
	   {        
        message_vision("$N答道：我真的想要！\n\n", me);
        message_vision("财神爷低头念了几句咒语，手中忽然多了一个新手红包。财神爷说道：新手红包接着吧！\n", me);
        me->set("2012gift_given", 1);
        me->delete_temp("ggyao");
		gift=new("/u/zlga/gift");
        gift->move(me);
        me->save();
        return 1
	   } else {
               command("kick");
               command("say  "+who->query("name")+""不是领过了吗，赶紧给我一边玩去。"\n");
              }
}



