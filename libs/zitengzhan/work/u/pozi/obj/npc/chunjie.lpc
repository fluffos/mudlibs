#include <ansi.h>
inherit NPC;
string ask_me();


void create() {
  set_name(HIC "礼物大使" NOR, ({ "da shi" }));
  set("age", 18 + random(10));
  set("gender", "男性");
  set("title", HIR "春节专用" NOR);
  set("long", "这位就是春节礼物使者。\n");
  set("attitude", "peaceful");
  set("str", 50);
  set("kar", 50);
  set("per", 99);
  set("attitude", "friendly");
  set("shen_type", 1);
  set_skill("unarmed", 300);
  set_skill("dodge", 300);
  set("inquiry", ([
    "春节礼物": (: ask_me :),
  ]));
  setup();
  carry_object("/d/obj/cloth/magua")->wear();
  add_money("silver", 5);
}



string ask_me() {
  object me, gift;
  me = this_player();

  if (!userp(me)) return "一边玩去。";
  if (me->query("春节gift_given"))
    return "你不是领过了吗，还想再要？";
  if ((int)me->query("combat_exp") + (int)me->query("daoxing") < 2000000)
    return "武学加道行200w以上再来领取吧！";
  if (!me->query("family"))
    return "你先去拜个师再来要礼物吧！";

  me->set("春节gift_given", 1);
  gift = new("/u/pozi/obj/gift/gift");
  gift->move(me);
  me->save();
  return "礼物使者低头念了几句咒语，手中忽然多了一个新年大礼包。礼物使者说道：新年礼物接着吧！";
}
