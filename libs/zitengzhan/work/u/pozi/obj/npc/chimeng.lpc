// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

//change.c
inherit NPC;
#include <ansi.h>
inherit F_MASTER;
string ask_sanshou();
// 假设每个id有30次机会，目前暂定的概率是：
// 有情：1/2
// 无情：1/2
// 忘情：1/2
// 如果解出的人太少，可以考虑增大概率
// 如果解出的人太多，可以考虑减小概率
string ask_youqing();
string ask_wuqing();
string ask_wangqing();

void create() {
  set_name("痴梦仙姑", ({ "chi meng", "dream", "fairy" }));
  set("long", "此乃迷津痴梦仙姑也；不受金银之谢，但遇有缘者渡之！\n");
  set("title", "迷津渡者");
  set("gender", "女性");
  set("age", 18);
  set("class", "xian");
  set("attitude", "friendly");
  set("rank_info/respect", "仙姑");
  set("per", 30);
  set("int", 30);
  set("max_kee", 1000);
  set("max_gin", 1000);
  set("max_sen", 1000);
  set("force", 800);
  set("max_force", 800);
  set("force_factor", 50);
  set("max_mana", 500);
  set("mana", 500);
  set("mana_factor", 40);
  set("combat_exp", 1000000);

  set("eff_dx", 90000000);
  set("nkgain", 300);

  set_skill("literate", 90);
  set_skill("parry", 100);
  set_skill("unarmed", 80);
  set_skill("dodge", 100);
  set_skill("force", 120);
  set_skill("whip", 180);
  set_skill("unarmed", 80);
  set_skill("spells", 120);
  set_skill("baihua-zhang", 120);
  set_skill("moonshentong", 140);
  set_skill("jueqingbian", 180);
  set_skill("moonforce", 120);
  set_skill("moondance", 100);
  map_skill("spells", "moonshentong");
  map_skill("unarmed", "baihua-zhang");
  map_skill("force", "moonforce");
  map_skill("whip", "jueqingbian");
  map_skill("parry", "jueqingbian");
  map_skill("dodge", "moondance");
  set("inquiry", ([
    "三无三不手": (: ask_sanshou :),
    "有情": (: ask_youqing :),
    "无情": (: ask_wuqing :),
    "忘情": (: ask_wangqing :),
  ]));


  create_family("月宫", 2, "弟子");
  setup();

  carry_object("/d/obj/cloth/luoyi")->wear();
  carry_object("/d/obj/weapon/whip/jueqingwhip")->wield();
}
string ask_sanshou() {
  object me = this_player();

  if (me->query("family/family_name") != "月宫")
    return ("你不是我月宫弟子!!\n");
  if (me->query("faith") < 500)
    return ("你对本门做了多少贡献，就想打听三无三不手！");
  if ((string)me->query("gender") != "女性")
    return ("你非为纯阴之身,怎能知哓女儿家的心思??\n");
  if (me->query("family/master_id") != "chi meng")
    return ("你不是我的弟子,不传。\n");
  if (me->query("JQB_known"))
    return ("你不是已经知道了么，难道是来戏弄我的！");
  command("pat " + me->query("id"));
  me->set("JQB_known", 1);
  return ("你附耳过来，三无三不手乃如此如此...");
}
void attempt_apprentice(object ob) {
  int reborn;
  object me = this_player();
  if (!((string)ob->query("gender") == "女性")) {
    command("shake");
    command("say 我们月宫只收女徒，这位" +
      RANK_D->query_respect(ob) + "还是另请高就吧。\n");
    return;
  }
  if (this_player()->query("mark/moon_chimeng") == 2) {
    command("pat " + ob->query("id"));
    command("say 好徒儿！\n");
    command("recruit " + ob->query("id"));
    return;
  }
  // 先天福缘高于31可拜痴梦（这个条件只有0转时才是一点小障碍）
  // 每转需要重新拜（修改转世轮回NPC），每转只有一次机会
  if (me->query("kar") < (me->query("HellZhenPass") ? 41 : 31) || 1 == this_player()->query("mark/moon_chimeng")) {
    this_player()->set("mark/moon_chimeng", 1);
    command("shake");
    command("say 你我无缘，还是另请高就吧。\n");
    return;
  }
  reborn = me->query("lunhui_zhuanshi");
  // 1转和4转肯定能拜成功，其它每转拜成功的概率为1/3
  if (reborn == 1 || reborn == 4 || random(3)) {
    command("pat " + ob->query("id"));
    command("say 既然" + RANK_D->query_respect(ob) +
      "与我有缘，我就收下你了。\n");
    command("recruit " + ob->query("id"));
    ob->set("mark/moon_chimeng", 2);
    return;
  } else {
    this_player()->set("mark/moon_chimeng", 1);
    command("shake");
    command("say 你我无缘，还是另请高就吧。\n");
    return;
  }

}
int recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "xian");
  ob->set("title", HIM "痴梦仙姑亲传弟子" NOR);
}

string ask_youqing() {
  object me = this_player();
  int reborn, chance, mod;
  if (me->query("family/master_id") != "chi meng")
    return ("你不是我的弟子，我怎能想你吐露心事！\n");
  if (!me->query("JQB_known"))
    return ("你连三无三不手都学不会，还谈什么情不情的？\n");
  if (me->query("secret/JQB/youqing"))
    return ("你不是已经学会了吗？\n");
  if (!me->query("JQB_ask"))
    return ("我已经告诉你绝情鞭的奥秘了，你好好参悟参悟这三无三不手吧！\n");
  if (me->query("age") >= 18)
    return ("你还放不开这个“情”字吗？\n");
  me->delete("JQB_ask");
  reborn = me->query("lunhui_zhuanshi");
  mod = me->query("kar") - me->query("per");
  if (mod < 0)
    mod = -1 * mod;
  chance = 50 + reborn * 5 + mod;
  if (random(chance)) {
    command("sigh");
    log_file(
      "monitors/jqb_lose",
      "【有情】：" + me->query("name") + "(" + me->query("id") + ")被痴梦拒绝！\n"
    );
    return ("今天我不想说这个事，你改日再来吧……");
  }
  me->set("secret/JQB/youqing", 1);
  log_file("monitors/jqb_win", "【有情】：" + me->query("name") + "(" + me->query("id") + ")学会了有情！\n");
  message(
    "channel:chat",
    HIC "【绝情断义】" + HIM + "痴梦：" + BLINK + HIW + me->query("name") + HIW "在" + me->query("age") + "岁这一年参悟了★有情诀★，绝情鞭法后继有人！\n" NOR,
    users()
  );
  return ("想不到你小小年纪就能参悟这个“情”字，也难为你了\n"
    "可情是何物你又能懂几分能？\n"
    "你年纪尚幼，只懂得“有情”，也好！也好！\n"
    "愿你永远只知“有情”，不要像师父这样……哎！\n");

}

string ask_wuqing() {
  object me = this_player();
  int reborn, chance, mod;
  if (me->query("family/master_id") != "chi meng")
    return ("你不是我的弟子，我怎能想你吐露心事！\n");
  if (!me->query("JQB_known"))
    return ("你连三无三不手都学不会，还谈什么情不情的？\n");
  if (me->query("secret/JQB/wuqing"))
    return ("你不是已经学会了吗？\n");
  if (!me->query("JQB_ask"))
    return ("我已经告诉你绝情鞭的奥秘了，你好好参悟参悟这三无三不手吧！\n");
  if (me->query("age") < 18)
    return ("小小年纪，问这个干什么？\n");
  if (me->query("age") >= 22)
    return ("晚了，这时候你还来跟我说什么“无情”？\n");
  me->delete("JQB_ask");
  reborn = me->query("lunhui_zhuanshi");
  mod = me->query("kar") - me->query("per");
  if (mod < 0)
    mod = -1 * mod;
  chance = 80 + reborn * 8 + mod;
  if (random(chance)) {
    command("sigh");
    log_file(
      "monitors/jqb_lose",
      "【无情】：" + me->query("name") + "(" + me->query("id") + ")被痴梦拒绝！\n"
    );
    return ("今天我不想说这个事，你改日再来吧……");
  }
  me->set("secret/JQB/wuqing", 1);
  log_file("monitors/jqb_win", "【无情】：" + me->query("name") + "(" + me->query("id") + ")学会了无情！\n");
  message(
    "channel:chat",
    HIC "【绝情断义】" + HIM + "痴梦：" + BLINK + HIW + me->query("name") + HIW "在" + me->query("age") + "岁这一年参悟了★无情诀★，绝情鞭法后继有人！\n" NOR,
    users()
  );
  return ("“无情”即使“有情”，“有情”便是“无情”\n"
    "你说师傅“无情”吗？可若不是为情，师傅怎会如此无情？\n"
    "你懂得了“无情”，便永远不会痛苦了！\n");
}

string ask_wangqing() {
  object me = this_player();
  int reborn, chance, mod;
  if (me->query("family/master_id") != "chi meng")
    return ("你不是我的弟子，我怎能想你吐露心事！\n");
  if (!me->query("JQB_known"))
    return ("你连三无三不手都学不会，还谈什么情不情的？\n");
  if (me->query("secret/JQB/wangqing"))
    return ("你不是已经学会了吗？\n");
  if (!me->query("JQB_ask"))
    return ("我已经告诉你绝情鞭的奥秘了，你好好参悟参悟这三无三不手吧！\n");
  if (me->query("age") < 22)
    return ("你阅历尚欠，师傅还不能告诉你如何“忘情”？\n");
  me->delete("JQB_ask");
  reborn = me->query("lunhui_zhuanshi");
  mod = me->query("kar") - me->query("per");
  if (mod < 0)
    mod = -1 * mod;
  chance = 180 + reborn * 10 + mod;
  if (random(chance)) {
    command("sigh");
    log_file(
      "monitors/jqb_lose",
      "【忘情】：" + me->query("name") + "(" + me->query("id") + ")被痴梦拒绝！\n"
    );
    return ("今天我不想说这个事，你改日再来吧……");
  }
  me->set("secret/JQB/wangqing", 1);
  log_file("monitors/jqb_win", "【忘情】：" + me->query("name") + "(" + me->query("id") + ")学会了忘情！\n");
  message(
    "channel:chat",
    HIC "【绝情断义】" + HIM + "痴梦：" + BLINK + HIW + me->query("name") + HIW "在" + me->query("age") + "岁这一年参悟了★忘情诀★，绝情鞭法后继有人！\n" NOR,
    users()
  );
  return ("“你既然能想到这一层，便不用师傅再多言了”\n"
    "世间最“有情”之事莫过于“忘情”\n"
    "世间最“无情”之事莫过于“忘情”\n");
}
