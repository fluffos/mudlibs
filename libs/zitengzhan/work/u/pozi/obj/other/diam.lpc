inherit MONEY;
#include <ansi.h>
void create()
{
      set_name(HIG"钻石"NOR, ({"diamond", "diamond_money"}));

        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("money_id", "thousand-cash");
              set("long", "一颗晶莹夺目面额值一万两金子的钻石。\n");
               set("unit", "袋");
             set("base_value", 5000000000);
              set("base_unit", "颗");
                set("base_weight", 3);
        }
       set_amount(1);
}

