#include <ansi.h>
inherit ROOM;
void create()
{
  set("short",HIY "静怡轩" NOR);
 set("long", @LONG
优雅清静的石屋让人身心舒展，隐隐可以感觉到房间主人的深不可测。那张寒冰榻（bed）冒出一丝丝的仙气。
LONG); 
    set("no_time", 1);
    set("no_fight", 1);
    set("no_magic", 1);
    set("exits",([ 
       "south" : "/u/pozi/workroom",
        ]));    
    set("objects",([
            "/d/obj/flower/rose999":1]));
   
    create_door("south","花雕木门","north");
    set("no_clean_up",0);
	setup();
    //replace_program(ROOM);
}

void init()
{
  add_action("do_bed", "gosleep");
  add_action("do_bed", "gobed" );
  add_action("do_bed", "bed");
}

int do_bed()
{       object me;
        me=this_player();
        message_vision(HIY "$N掀开纱帐，准备上床了。\n\n" NOR, me);
        me->move("/u/allenc/bed_allenc");
        message_vision(HIY "\n沙帐轻轻一动，$N钻了进来。\n" NOR, me);
        return 1;
}
