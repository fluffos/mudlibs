inherit ROOM;

void create()
{
        set("short", "床上");
        set("long", @LONG
来自天庭的木头散发出阵阵香气和淡淡的一股清烟，
整个木床被这撩人的香气和烟雾环绕。
LONG
        );
        
	set("exits", ([
                "out": "/u/gudu/bedroom",
            ]));
	set("sleep_room",1);
	set("if_bed",1);                             
                 
    setup();
}