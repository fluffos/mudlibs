//under.c

#include <ansi.h>
inherit ROOM;
#include "banned.h"

void create() {
  set("short", HBRED + HIW "天上人间" NOR + "玩家武术交流现场" NOR);
  set("long",
    @LONG
    
天上人间玩家交流武术心得的赛场，这儿玩家可以自行比试武功，
也可以在这儿观摩比武赛场中玩家的情况。
比试分组为：
1.) 16岁以下组     2.) 100万以下组 3.) 100-300万组 4.) 300-500万组 
5.) 500-800万组  6.) 800-1000万组7.) 1000万上组

由当值wiz决定比赛的组别(start)。然后玩家开始挑战(tiaozhan)。

LONG);
  set("no_flee", 1);
  set("no_fight", 1);
  set("no_magic", 1);
  set("exits", ([
    //     "south":"/d/city/wuguan",
  ]));
  set("alternative_die", 1);
  setup();
}

void init() {
  add_action("do_start", "start");
  add_action("do_fight", "tiaozhan");
  this_player()->remove_all_enemy();
}

int do_start(string arg) {
  object ob, me;
  me = this_player();
  ob = this_object();

  if (!wizardp(me)) return notify_fail("还是听wiz的吧！\n");

  if (!arg) return notify_fail("您要举办哪一级别的比武大会？start：\n
1.) 16岁以下组     2.) 100万以下组 3.) 100-300万组 4.) 300-500万组 \n
5.) 500-800万组  6.) 800-1000万组7.) 1000万上组 ");

  if (arg == "1") {
    message(
      "channel:rumor",
      HIM "【" + HIW "天上人间·比武大会" NOR + HIM "】" + HIW "16岁以下组比武大会开始，欢迎玩家踊跃报名！\n" NOR,
      users()
    );
    ob->set_temp("age", 1000);
    ob->delete_temp("wx1");
    ob->delete_temp("wx2");
    ob->set_temp("age", 16);
    return 1;
  }
  if (arg == "2") {
    message(
      "channel:rumor",
      HIM "【" + HIW "天上人间·比武大会" NOR + HIM "】" + HIW "100万WX以下组比武大会开始，欢迎玩家踊跃报名！\n" NOR,
      users()
    );
    ob->set_temp("age", 1000);
    ob->delete_temp("wx1");
    ob->delete_temp("wx2");
    ob->set_temp("wx2", 100);
    ob->set_temp("wx1", 0);
    return 1;
  }
  if (arg == "3") {
    message(
      "channel:rumor",
      HIM "【" + HIW "天上人间·比武大会" NOR + HIM "】" + HIW "300万WX以下组比武大会开始，欢迎玩家踊跃报名！\n" NOR,
      users()
    );
    ob->set_temp("age", 1000);
    ob->delete_temp("wx1");
    ob->delete_temp("wx2");
    ob->set_temp("wx1", 100);
    ob->set_temp("wx2", 300);
    return 1;
  }
  if (arg == "4") {
    message(
      "channel:rumor",
      HIM "【" + HIW "天上人间·比武大会" NOR + HIM "】" + HIW "500万WX以下组比武大会开始，欢迎玩家踊跃报名！\n" NOR,
      users()
    );
    ob->set_temp("age", 1000);
    ob->delete_temp("wx1");
    ob->delete_temp("wx2");
    ob->set_temp("wx2", 500);
    ob->set_temp("wx1", 300);
    return 1;
  }
  if (arg == "5") {
    message(
      "channel:rumor",
      HIM "【" + HIW "天上人间·比武大会" NOR + HIM "】" + HIW "800万WX以下组比武大会开始，欢迎玩家踊跃报名！\n" NOR,
      users()
    );
    ob->set_temp("age", 1000);
    ob->delete_temp("wx1");
    ob->delete_temp("wx2");
    ob->set_temp("wx1", 500);
    ob->set_temp("wx2", 800);
    return 1;
  }
  if (arg == "6") {
    message(
      "channel:rumor",
      HIM "【" + HIW "天上人间·比武大会" NOR + HIM "】" + HIW "1000万WX以下组比武大会开始，欢迎玩家踊跃报名！\n" NOR,
      users()
    );
    ob->set_temp("age", 1000);
    ob->delete_temp("wx1");
    ob->delete_temp("wx2");
    ob->set_temp("wx1", 800);
    ob->set_temp("wx2", 1000);
    return 1;
  }
  if (arg == "7") {
    message(
      "channel:rumor",
      HIM "【" + HIW "天上人间·比武大会" NOR + HIM "】" + HIW "1000万WX以上组比武大会开始，欢迎玩家踊跃报名！\n" NOR,
      users()
    );
    ob->set_temp("age", 1000);
    ob->delete_temp("wx1");
    ob->delete_temp("wx2");
    ob->set_temp("wx1", 1000);
    ob->set_temp("wx2", 10000);
    return 1;
  }

}


int do_fight(string arg) {
  string myop, tempstr;
  int j, wx1, wx2;
  object ob, me, where;
  me = this_player();
  where = environment(me);
  wx1 = (int)where->query_temp("wx1");
  wx2 = (int)where->query_temp("wx2");

  if (me->is_busy()) return notify_fail("你正忙着呢！\n");
  if (!arg) return notify_fail("您要挑战谁？\n");

  ob = LOGIN_D->find_body(arg);
  if (!ob) return notify_fail("咦．．． 有这个人吗？\n");
  if (me->query("id") == arg) return notify_fail("想和你自己切磋?\n");
  if (!present(ob, environment(me))) return notify_fail("向你挑战的人不在这里。\n");
  if (ob->is_busy()) return notify_fail("对方正忙着呢！\n");
  if (sizeof(all_inventory(load_object(__DIR__ "ground"))) > 0) {
    j = sizeof(all_inventory(load_object(__DIR__ "ground")));
    while (j > 0) {
      j = j - 1;
      if (userp(all_inventory(load_object(__DIR__ "ground"))[j]))
        return notify_fail("擂台上已经有人了。\n");
    }
  }
  if (me->query("age") > where->query_temp("age")
    || ob->query("age") > where->query_temp("age"))
    return notify_fail("还没轮到你们的级别组比赛呢！\n");

  else if (((int)me->query("combat_exp") / 10000 < wx1 || (int)me->query("combat_exp") / 10000 > wx2)
    || ((int)ob->query("combat_exp") / 10000 < wx1 || (int)ob->query("combat_exp") / 10000 > wx2))
    return notify_fail("还没轮到你们的级别组比赛呢！\n");

  message_vision("$N和$n双双纵身跃上擂台,准备比武。\n", me, ob);
  me->move(__DIR__ "ground");
  ob->move(__DIR__ "ground");
  me->set_temp("statusbef/kee", (int)me->query("kee"));
  me->set_temp("statusbef/eff_kee", (int)me->query("eff_kee"));
  me->set_temp("statusbef/sen", (int)me->query("sen"));
  me->set_temp("statusbef/eff_sen", (int)me->query("eff_sen"));
  me->set_temp("statusbef/force", (int)me->query("force"));
  me->set_temp("statusbef/mana", (int)me->query("mana"));
  me->set_temp("statusbef/kill_ob", ob);
  ob->set_temp("statusbef/kee", (int)ob->query("kee"));
  ob->set_temp("statusbef/sen", (int)ob->query("sen"));
  ob->set_temp("statusbef/eff_kee", (int)ob->query("eff_kee"));
  ob->set_temp("statusbef/eff_sen", (int)ob->query("eff_sen"));
  ob->set_temp("statusbef/force", (int)ob->query("force"));
  ob->set_temp("statusbef/mana", (int)ob->query("mana"));
  ob->set_temp("statusbef/kill_ob", me);
  ob->kill_ob(me);
  me->kill_ob(ob);
  ob->delete_temp("objectob");
  remove_call_out("wait_and_star");
  remove_call_out("finish_match");
  call_out("wait_and_start", 2);
  return 1;
}

int wait_and_start() {
  object fan;
  object me, ob;
  object *allinv;
  allinv = all_inventory(environment(this_player()));
  if (sizeof(allinv) < 2) return 1;
  me = allinv[0];
  ob = allinv[1];
  fan = load_object(__DIR__ "npc/fan");
  message_vision(HIW "$N与$n比武开始！限时五分钟。\n" NOR, me, ob);
  fan->command("chat " + me->query("name") + "与" + ob->query("name") + "比武开始！限时五分钟。\n");
  "/cmds/std/kill"->main(me, (string)ob->query("id"));
  "/cmds/std/kill"->main(ob, (string)me->query("id"));
  call_out("finish_match", 300);
  return 1;
}

int finish_match() {
  object fan, where;
  int i, j;
  object me, ob;
  object *allinv, *playerinv;
  where = this_object();
  j = 0;
  playerinv = ({});
  allinv = all_inventory(load_object(__DIR__ "ground"));
  if (sizeof(allinv) < 2) return 1;
  i = sizeof(allinv);
  while (i > 0) {
    i = i - 1;
    if (userp(allinv[i])) {
      playerinv += ({ allinv[i] });
      j = j + 1;
    }
  }
  if (j < 2) return 1;
  me = playerinv[0];
  ob = playerinv[1];
  fan = load_object(__DIR__ "npc/fan");
  fan->command("chat " + me->query("name") + "与" + ob->query("name") + "大战三百回合，不分胜负，现各下场休息，有待来日再战。\n");
  message_vision(HIG "$N与$n大战三百回合，不分胜负，现各下场休息，有待来日再战。\n" NOR, me, ob);
  me->remove_killer(ob);
  ob->remove_killer(me);
  me->move("/u/snowtu/under");
  ob->move("/u/snowtu/under");
  where->set_temp("age", 0);
  where->set_temp("wx2", 50000);
  where->set_temp("wx1", 10000);

  me->set("kee", me->query_temp("statusbef/kee"));
  me->set("eff_kee", me->query_temp("statusbef/eff_kee"));
  me->set("sen", me->query_temp("statusbef/sen"));
  me->set("eff_sen", me->query_temp("statusbef/eff_sen"));
  me->set("force", me->query_temp("statusbef/force"));
  me->set("mana", me->query_temp("statusbef/mana"));
  ob->set("kee", ob->query_temp("statusbef/kee"));
  ob->set("sen", ob->query_temp("statusbef/sen"));
  ob->set("eff_kee", ob->query_temp("statusbef/eff_kee"));
  ob->set("eff_sen", ob->query_temp("statusbef/eff_sen"));
  ob->set("force", ob->query_temp("statusbef/force"));
  ob->set("mana", ob->query_temp("statusbef/mana"));

  return 1;
}

void alternative_die(object me) {
  if (!userp(me)) {
    set("alternative_die", 0);
    me->die();
    set("alternative_die", 1);
    return;
  }
  if (me->query("kee") < 1)
    me->set("kee", 10);
  if (me->query("eff_kee") < 1)
    me->set("eff_kee", 10);
  if (me->query("sen") < 1)
    me->set("sen", 10);
  if (me->query("eff_sen") < 1)
    me->set("eff_sen", 10);
  if (me->query_condition("no_pk_time")) {
    set("alternative_die", 0);
    me->unconcious();
    set("alternative_die", 1);
  }
  return;

}
