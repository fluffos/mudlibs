//cglaem...12/17/96.

#include <ansi.h>

string ridemsg;
string *fly_xian = ({
  HIW "\n$N" HIW "口中念动真言，瞬时浑身仙气缭绕。\n" NOR,
  HIW "\n半空一声鹤鸣，$N" HIW "仰天一声哈哈。\n" NOR,
  HIW "\n$N" HIW "仰天一声哈哈，念了几声咒语，脚下升起一片祥云。\n" NOR,
});

string *fly_human = ({
  HIC "\n$N" HIC "口中念了几声，身形立刻变得轻盈起来。\n" NOR,
  HIC "\n$N" HIC "浑身内力运行小周天，身形变得轻盈起来。\n" NOR,
  HIC "\n$N" HIC "默运内功，立时身轻似燕。\n" NOR,
});

string *fly_yao = ({
  HIB "\n$N" HIB "仰天一声嘶鸣，背后仿佛生出一对血翅。\n" HIB,
  HIB "\n$N" HIB "后退一步，显出了妖精的本相，端是糁人。\n" HIB,
  HIB "\n$N" HIB "显出原形，朝天一声长嘶，众人一阵哗然。\n" HIB,
});

mapping fly_msg = ([
  "五庄观": ({
    HIB "$N" HIB "大袖一摆，只见风起云涌，人已借风云之势在空中大步迈去。\n" NOR,
    HIB "\n一阵清风吹来，$N" HIB + "$M" + HIB "从空中降落。 \n" NOR,
  }),

  "南海普陀山": ({
    HIY "$N" HIY "口中念着佛号，脚下升起祥云，缓缓离地飞去。  \n" NOR,
    HIY "\n一声洪亮的“南无阿弥陀佛”，$N" HIY + "$M" + HIY "从佛光中，祥云里走出。 \n" NOR,
  }),
  "方寸山三星洞": ({
    HIG "$N" HIG "捻个口诀，口中念动真言，大叫一声：“筋斗云！”，\n只见天上降下一朵七色云彩，$N" HIG "纵身跃上，飞驰而去......\n\n" NOR,
    HIG "\n只听见天上传来一声：“俺来也！”，人随声到，$N" HIG + "$M" + HIG "从筋斗云中冉冉落下。\n" NOR,
  }),
  "东海龙宫": ({
    HIC "$N" HIC "摇身一变，现出原形，正是一条神龙，随即穿云而去。 \n" NOR,
    HIC "\n半空中仿佛冲出一条水柱，$N" HIC + "$M" + HIC "从水柱上稳稳跳落地下。  \n" NOR,
  }),
  "月宫": ({
    HIM "$N" HIM "妩媚一笑，欣然起舞，随着一阵花香，已消失在月光中。\n" NOR,
    HIM "\n只见一道月光洒在你面前，柔柔的，冷冷的，$N" HIM + "$M" + HIM "从中飘然而至。 \n" NOR,
  }),
  "江湖浪子": ({
    HIW "$N一声长啸腾空而起，运起" HIR "血海飘香" HIW "轻功，刹那间消失在众人眼前…… \n\n" NOR,
    HIW "$N出现在众人眼前…… \n\n" NOR,
  }),
  "阎罗地府": ({
    CYN "$N" CYN "往黑暗处一指，只见所指之处仿佛出现一扇门，\n$N" CYN "大步走入，门也随之消失。 \n\n" NOR,
    CYN "\n阴影中吹起一阵冷风，伴随着冷森森的笑声，$N" CYN + "$M" + CYN "如魑魅般从黑暗中出现。\n" NOR,
  }),
  "三界散仙": ({
    HIB "$N" HIB "双目紧闭，两指轻弹。\n只见$N" HIB "幽冥鬼舞般升起，消失在一片茫茫人海了。\n\n" NOR,
    HIB "\n只看天色变暗，$N" HIB "的鬼影" + "$M" + HIB "走了出来。 \n" NOR,
  }),
  "将军府": ({
    HIY "$N" HIY "用手轻轻一指，只见天上降下一朵五彩祥云，\n$N" HIY "纵身跃上，乘祥云飘摇而去......\n\n" NOR,
    HIY "\n只见空中飘落一朵五彩祥云，$N" HIY + "$M" + HIY "拨开云端走了出来。 \n" NOR,
  }),
  "三界山": ({
    HIR "$N真气一提，大叫一声：我去耶！！！\n" + "只见$N纵身一跳，越上云宵，飞驰而去......\n\n" NOR,
    HIR "\n云雾散去只见$N纵身从云霄上跳了下来\n\n" NOR,
  }),
  "陷空山无底洞": ({
    WHT "只见平地里忽然刮起一阵阴风，将$N" WHT "紧紧裹住，\n$P顷刻间随风而去，消失得无影无踪。 \n\n" NOR,
    WHT "\n忽然间刮起一阵阴风，风尽处，$N" WHT + "$M" + WHT "走了出来。\n" NOR,
  }),
  "火云洞": ({
    RED "$N" RED "口捻个口诀，口中念动真言,突然“轰”地冒起一团红雾,$N" RED "随即隐入红雾中。\n" NOR,
    RED "\n一团红色的烟雾涌了过来,$N" RED + "$M" + RED "突然从里面蹦了出来。\n" NOR,
  }),
  "大雪山": ({
    HIW "$N" HIW "随手一挥，只见一团雪雾裹住真身，旋转而去。 \n" NOR,
    HIW "\n霎时间，大雪纷飞，$N" HIW + "$M" + HIW "亦如晶莹剔透的雪花随风飘下。 \n" NOR,
  }),
  "盘丝洞": ({
    MAG "$N" MAG "皓腕轻抖，但见一道彩虹落了下来,$P纤腰轻摆飘然而上,霞光一闪,彩虹消失的无影无踪。\n" NOR,
    MAG "\n但见一道彩虹从天空划过，$N" MAG + "$M" + MAG "随彩虹飘然而至。 \n" NOR,
  }),
  "蜀山剑派": ({
    HIC "$N" HIC "口捻个口诀，扔出一把宝剑，飞驰而上，一招「御剑飞行」向远方飞去。。。。\n" NOR,
    HIC "\n半空一道剑影闪过，只见$N" HIC + "$M" + HIC "从中走了出来。\n" NOR,
  }),
  "少林寺": ({
    HIW "$N" HIW "口中念着佛号，提气向空纵起，眨眼间已经消失不见。  \n" NOR,
    HIW "\n一声洪亮的“南无阿弥陀佛”，$N" HIW + "$M" + HIY "从半空中跳将下来。 \n" NOR,
  }),
  "峨嵋派": ({
    HIM "$N一声长鸣，脚下一团祥云出现，$N脚踏祥云缓缓而去……\n" NOR,
    HIW "祥云分开，$N从云中走了出来……\n" NOR,
  }),
  "剑客联盟": ({
    MAG "$N突然射出一颗奇怪的弹子，只听嘣的一声，一片烟雾弥漫后，$N早已消失得无影无踪了。\n" NOR,
    MAG "一片烟雾弥漫后，$N显出了身影。\n" NOR,
  }),

]);

int main(object me, string arg) {
  string loc;
  int mana_cost;
  object ridee, map;
  string msg, type, fam;

  seteuid(getuid());

  if (me->is_fighting())
    return notify_fail("你正在战斗，飞不开。\n");
  if (me->is_busy() || me->query_temp("pending/exercising"))
    return notify_fail("你正忙着呢，没工夫腾云驾雾。\n");
  if (!wizardp(me) && !environment(me)->query("outdoors"))
    return notify_fail("周围没有一片云，没办法腾云驾雾。\n");
  if (me->is_ghost())
    return notify_fail("做了鬼了，就老实点吧！\n");
  if (!arg)
    return notify_fail("你要飞到哪里去？\n");
  if (me->query_temp("no_move"))
    return notify_fail("你被定住了，哪里飞得起来！\n");

  if (RANK_D->grade_dx(RANK_D->describe_dx((int)me->query("daoxing")))
    < RANK_D->grade_dx(BLU "初领妙道" NOR)) {
    message_vision(HIY
      "$N奋力望上一跳，似乎想飞起来。结果离地不到三尺就一个倒栽葱摔了下来。\n" NOR, me);
    return notify_fail("你现在还初领妙道都谈不上，哪里飞得起来。\n");
  }

  if (RANK_D->grade_fali(RANK_D->describe_fali((int)me->query("max_mana")))
    < RANK_D->grade_fali(HIB "腾云驾雾" NOR)) {
    message_vision(HIY
      "$N奋力望上一跳，似乎想飞起来。结果离地不到三尺就一个倒栽葱摔了下来。\n" NOR, me);
    return notify_fail("看来以你的法力修为还不能腾云驾雾。\n");
  }

  if ((int)me->query("mana") < 200) {
    message_vision(HIY
      "$N奋力望上一跳，似乎想飞起来。结果离地不到三尺就一个倒栽葱摔了下来。\n" NOR, me);
    return notify_fail("你目前法力不够充盈。\n");
  }

  if ((int)me->query("sen") * 100 / (int)me->query("max_sen") < 50)
    return notify_fail("你现在头脑不太清醒，当心掉下来摔死。\n");

  if ((int)me->query("kee") * 100 / (int)me->query("max_kee") < 50)
    return notify_fail("你想飞起来，可是体力似乎有点不支。\n");

  mana_cost = -(100 - (int)me->query_skill("spells")) / 4 - 40;
  if (mana_cost > 0) mana_cost = 0;

  type = me->query("class");

  switch (type) {
    case "yao": msg = fly_yao[random(sizeof(fly_yao))]; break;
    case "xian": msg = fly_xian[random(sizeof(fly_xian))]; break;
    default: msg = fly_human[random(sizeof(fly_human))]; break;
  }

  fam = me->query("family/family_name");
  if (sizeof(fly_msg[fam]) > 0)
    msg += fly_msg[fam][0];
  else msg += HIY "$N" HIY "一声长啸，身形一长，冲天而去！\n\n" NOR;

  message_vision(msg, me);
  me->add("mana", mana_cost);

  if (arg == "stone") loc = "/d/dntg/hgs/entrance";
  //else if(arg=="pkdao") loc="/d/pkdao/pkdao";
  else if (arg == "sanjie") loc = "/d/sanjie/sanjiedao";
  //else if(arg=="tianpeng") loc="/d/leox/tianpeng/meng";
  else if (arg == "kaifeng") loc = "/d/kaifeng/tieta";
  else if (arg == "moon") loc = "/d/moon/ontop2";
  else if (arg == "lingtai") loc = "/d/lingtai/gate";
  else if (arg == "village") loc = "/d/qujing/village/cunkou";
  else if (arg == "putuo") loc = "/d/nanhai/gate";
  else if (arg == "changan") loc = "/d/city/center";
  else if (arg == "yhg") loc = "/d/yhg/yihuadamen";
  else if (arg == "sky") loc = "/d/dntg/sky/nantian";
  else if (arg == "wuzhuang") loc = "/d/qujing/wuzhuang/gate";
  else if (arg == "huangfeng") loc = "/d/qujing/huangfeng/huangfeng1";
  else if (arg == "meishan") loc = "/d/meishan/erlangwai";
  //else if(arg=="wudang") loc="/d/xkx/wudang/guangchang";
  //else if(arg=="wusheng") loc="/d/wusheng/guangchang";
  else if (arg == "wanmei") loc = "/d/youxia/wanmei";
  else if (arg == "shaolin") loc = "/d/shaolin/gate";
  else if (arg == "emei") loc = "/d/emei/huayanding";
  else if (arg == "kunlun") loc = "/d/kunlun/xiaolu";
  else if (arg == "japan") loc = "/d/swordman/gate";
  else if (arg == "shushan") loc = "/d/shushan/road1";
  else if (arg == "penglai") {
    if (!(map = present("eastsea map", me)) && !wizardp(me)) {
      write("你在天上转了半天也不知该往那边飞。。。\n");
      message_vision("\n$N失望地从云上跳了下来！\n", me);
      return 1;
    }
    if (!wizardp(me) && (string)map->query("unit") != "张") {
      write("你在天上转了半天也不知该往那边飞。。。\n");
      message_vision("\n$N失望地从云上跳了下来！\n", me);
      return 1;
    }
    loc = "/d/penglai/penglai";
  } else if (arg == "shenjian") {
    if ((string)me->query("family/family_name") != "神剑山庄" && !wizardp(me)) {

      write("你在天上转了半天也不知该往那边飞。。。\n");
      message_vision("\n$N失望地从云上跳了下来！\n", me);
      return 1;
    }
    loc = "/d/shenjian/sjsz";
  }

  else if (arg == "xueshan") {
    if ((!(map = present("xueshan map", me))
      || (string)map->query("unit") != "张")
      && (string)me->query("family/family_name") != "大雪山"
      && !wizardp(me)) {
      write("你在天上转了半天也不知该往那边飞...\n");
      message_vision("\n$N失望地从云上跳了下来！\n", me);
      return 1;
    }
    loc = "/d/xueshan/binggu";
  } else if (arg == "baoxiang") {
    loc = "/d/qujing/baoxiang/bei1.lpc";
    loc[strlen(loc) - 3] = '1' + random(4);
  } else if (arg == "pingding") {
    loc = "/d/qujing/pingding/ping1.lpc";
    loc[strlen(loc) - 3] = '1' + random(4);
  } else if (arg == "yalong") {
    loc = "/d/qujing/pingding/yalong1.lpc";
    loc[strlen(loc) - 3] = '1' + random(3);
  } else if (arg == "wuji")
    loc = "/d/qujing/wuji/square.lpc";
  else if (arg == "chechi") {
    loc = "/d/qujing/chechi/jieshi1.lpc";
    loc[strlen(loc) - 3] = '1' + random(9);
  } else if (arg == "tongtian") {
    loc = "/d/qujing/tongtian/hedong1.lpc";
    loc[strlen(loc) - 3] = '1' + random(6);
  } else if (arg == "jindou") {
    loc = "/d/qujing/jindou/jindou1.lpc";
    loc[strlen(loc) - 3] = '1' + random(4);
  } else if (arg == "nuerguo") {
    loc = "/d/qujing/nuerguo/towna1.lpc";
    loc[strlen(loc) - 4] = 'a' + random(3);
    loc[strlen(loc) - 3] = '1' + random(3);
  } else if (arg == "dudi") {
    loc = "/d/qujing/dudi/dudi1.lpc";
    loc[strlen(loc) - 3] = '1' + random(4);
  } else if (arg == "firemount") {
    loc = "/d/qujing/firemount/cuiyun1.lpc";
    loc[strlen(loc) - 3] = '1' + random(5);
  } else if (arg == "jilei") {
    loc = "/d/qujing/jilei/jilei1.lpc";
    loc[strlen(loc) - 3] = '1' + random(3);
  } else if (arg == "jisaiguo") {
    loc = "/d/qujing/jisaiguo/east1.lpc";
    loc[strlen(loc) - 3] = '1' + random(4);
  } else if (arg == "jingjiling") {
    loc = "/d/qujing/jingjiling/jingji1.lpc";
  } else if (arg == "xiaoxitian")
    loc = "/d/qujing/xiaoxitian/simen.lpc";
  else if (arg == "zhuzi") {
    loc = "/d/qujing/zhuzi/zhuzi1.lpc";
    loc[strlen(loc) - 3] = '1' + random(5);
  } else if (arg == "qilin")
    loc = "/d/qujing/qilin/yutai.lpc";
  else if (arg == "pansi") {
    loc = "/d/qujing/pansi/ling1.lpc";
    loc[strlen(loc) - 3] = '1' + random(6);
  } else if (arg == "biqiu") {
    loc = "/d/qujing/biqiu/jie1.lpc";
    loc[strlen(loc) - 3] = '1' + random(9);
  } else if (arg == "qinghua")
    loc = "/d/qujing/biqiu/zhuang.lpc";
  else if (arg == "wudidong") {
    loc = "/d/qujing/wudidong/firemount-wudidong3.lpc";
    loc[strlen(loc) - 3] = '1' + random(3);
  } else if (arg == "qinfa") {
    loc = "/d/qujing/qinfa/jiedao1.lpc";
    loc[strlen(loc) - 3] = '1' + random(8);
  } else if (arg == "lingjie") loc = "/d/lingjie/rukoujob";
  else if (arg == "yinwu")
    loc = "/d/qujing/yinwu/huangye1.lpc";
  else if (arg == "fengxian") {
    loc = "/d/qujing/fengxian/jiedao1.lpc";
    loc[strlen(loc) - 3] = '1' + random(9);
  } else if (arg == "yuhua") {
    loc = "/d/qujing/yuhua/xiaojie1.lpc";
    loc[strlen(loc) - 3] = '1' + random(9);
  } else if (arg == "baotou") {
    loc = "/d/qujing/baotou/shanlu1.lpc";
    loc[strlen(loc) - 3] = '1' + random(9);
  } else if (arg == "zhujie") {
    loc = "/d/qujing/zhujie/shanlu11.lpc";
    loc[strlen(loc) - 3] = '1' + random(8);
  } else if (arg == "jinping") {
    loc = "/d/qujing/jinping/xiaojie1.lpc";
    loc[strlen(loc) - 3] = '1' + random(7);
  } else if (arg == "qinglong")
    loc = "/d/qujing/qinglong/shanjian.lpc";
  else if (arg == "tianzhu") {
    loc = "/d/qujing/tianzhu/jiedao11.lpc";
    loc[strlen(loc) - 3] = '1' + random(8);
  } else if (arg == "maoying") {
    loc = "/d/qujing/maoying/shanpo1.lpc";
    loc[strlen(loc) - 3] = '1' + random(9);
  } else if (arg == "lingshan") {
    loc = "/d/qujing/lingshan/dalu1.lpc";
    loc[strlen(loc) - 3] = '1' + random(3);
  } else if (arg == "lanling")
    loc = "/d/lanling/兰陵城心.lpc";
  else {
    write("\n\n到了！你按下云头跳了下来。\n");
    write("咦？．．．怎么还在原来的地方？\n");
    return 1;
  }

  if (!loc)
    return 1;

  // mon /10/18/98
  if (MISC_D->random_capture(me, 0, 1)) return 1;
  if (ridee = me->ride()) {
    ridemsg = ridee->query("ride/msg") + "着" + ridee->name();
    ridee->move(loc);
  } else ridemsg = "";

  me->move(loc);
  write("\n\n到了！你按下云头跳了下来。\n");
  if (sizeof(fly_msg[fam]) > 0)
    msg = fly_msg[fam][1];
  else msg = HIY "一道人影从半空落下，原来却是$N" HIY "！\n\n" NOR;
  msg = replace_string(msg, "$N", me->name());
  msg = replace_string(msg, "$M", ridemsg);
  message("vision", msg, environment(me), me);
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : fly|fei [目的地]
当你的道行和法力高强时，你可以腾云驾雾。

目前你可以飞到的地方：
changan         ->长安城                 kaifeng        ->开封城
stone           ->花果山仙石             sky            ->南天门
moon            ->昆仑山月宫             penglai        ->蓬莱仙岛
lingtai         ->灵台方寸山             putuo          ->南海普陀山
xueshan         ->大雪山寒冰谷           meishan        ->梅山灌江口
wuzhuang        ->万寿山五庄观

baoxiang        ->宝象国                 pingding       ->平顶山
yalong          ->压龙山                 wuji           ->乌鸡国
chechi          ->车迟国                 tongtian       ->通天河
jindou          ->金兜山                 nuerguo        ->女儿国
dudi            ->毒敌山                 firemount      ->火焰山
jilei           ->积雷山                 jisaiguo       ->祭赛国
jingjiling      ->荆棘岭                 xiaoxitian     ->小西天
zhuzi           ->朱紫国                 qilin          ->麒麟山
pansi           ->盘丝岭                 biqiu          ->比丘国 
qinghua         ->清华庄                 wudidong       ->无底洞
qinfa           ->钦法国                 fengxian       ->凤仙郡 
yinwu           ->隐雾山                 yuhua          ->玉华县 
baotou          ->豹头山                 zhujie         ->竹节山
jinping         ->金平府                 qinglong       ->青龙山 
tianzhu         ->天竺国                 maoying        ->毛颖山 
lingshan        ->灵山                   sanjie         ->三界岛
lanling         ->兰陵城                 tianpeng       ->天蓬府
huangfeng       ->黄风岭                 village        ->小村子 
wusheng         ->武圣门                 wudang         ->武当山
emei            ->仙山峨嵋               shaolin        ->少林寺
wanmei          ->万梅山庄

HELP
  );
  return 1;
}
