#include <ansi.h>
string give_gift();
mixed *story = ({
  "眠兔开始在测试自己新做的pfm",
  "眠兔睁大眼睛，狠狠的瞄准对手，一个绝世pfm发出",
  "……",
  "…………",
  "………………",
  "“m d，又失败了！”眠兔大叫。",
  "只见眠兔高举双手，大喝：“去死把!”, 只见天上一道电光闪过，",
  "咆哮的雷暴自天而降，向着地上奔去……",
  (: give_gift :),
  "……",
  "………",
  "眠兔心中一凛，“坏了，劈错了，如今三十六计，惟有上计……”",
  "于是眠兔迅速键入“home”……",
  "只见一阵烟雾过後，眠兔的身影已经不见了。",
});

void create() {
  seteuid(getuid());
}

mixed query_story_message(int step) {
  return step < sizeof(story) ? story[step] : 0;
}

string give_gift() {
  int i;
  object env, ob;
  object *players;
  string msg;
  players = users();
  i = random(sizeof(players));
  ob = players[i];
  if (wizardp(ob)
    || ob->is_fighting()
    || !environment(ob)
    || ob->query_temp("netdead")
    || ob->is_busy())
    give_gift();

  if (!ob) return "";
  tell_object(ob, HIW "一阵轰隆隆的雷声响过，一道闪电从天而降，不偏不倚\n"
    "的砸到你头上，你登时就晕了过去……\n\n" NOR);
  //ob->unconcious();
  msg = HIW "天上降下一道闪电，将" + ob->name() + "劈晕了.......\n" NOR;
  env = environment(ob);
  if (objectp(env))
    tell_room(env, msg);
  CHANNEL_D->do_channel(
    this_object(),
    "rumor",
    HIM "好像" + ob->name() + "被闪电劈中了....................\n" NOR
  );
  message(
    "channel:sys",
    HIR "【" HIW "系统" HIR "】" NOR + WHT "事件精灵：" HIW + ob->name() + "(" + geteuid(ob) + ")" + "被闪电劈中了！\n" NOR,
    users()
  );
  return HIM "好像有人被闪电劈中了....................\n" NOR;
}
