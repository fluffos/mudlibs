#include <weapon.h>
#include <ansi.h>
#include <combat.h>
inherit DAGGER;

void create() {
  set_name(HIB "药王爪" NOR, ({ "yaowang zhua", "zhua", "du zhua" }));
  init_dagger(25);
  set("unit", "根");
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("value", 280);
    set("material", "tron");

  }
  set("wield_msg", HIB "$N双手一晃,两道蓝光化作$n" NOR + HIB "瞬时握在手里。\n" NOR);
  set("unwield_msg", HIY "$N摆动双掌，$n" NOR + HIY "已无影无踪！\n" NOR);

  setup();
}

int hit_ob(object me, object target) {
  string name;
  name = this_object()->query("name");
  message_vision("\n$N手中的" + name + HIB "忽然化作两道绿气抓向$n! \n" NOR, me, target);

  if (target->query("mark/duzhua_poison") == 1)
    message_vision("\n$n脸上的黑气越来越重。。。\n" NOR, target);

  message_vision("\n$N被抓了个正着，创口渐渐红肿起来，脸上隐约透出一股黑气，想是中了毒！\n" NOR, target);
  target->set("mark/duzhua_poison", 1);
  target->apply_condition("duzhua_poison", 30);
}
