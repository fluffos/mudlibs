#include <armor.h>
inherit NECK;

void create() {
  set_name("青龙宝玉", ({ "qinglong baoyu" }));
  set_weight(800);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("value", 2000);
    set("long", "一枚玉佩，为武王姬发的信物．\n");
    set("no_sell", 1);
    set("material", "steel");
    set("armor_prop/spells", 5);
    set("armor_prop/armor", 1);

  }
  setup();
}
