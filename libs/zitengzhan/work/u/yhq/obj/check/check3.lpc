#include <ansi.h>
inherit ITEM;

void checking(object who);

mapping score1;
mapping score2;

void create() {
  set_name("混天仪", ({ "huntian yi", "yi" }));
  set("unit", "个");
  setup();
}

int query_autoload() { return 1; }

void init() {
  add_action("do_check", "check");
}

string check_str(mapping dir, string arg) {
  int i;
  string *str, msg;
  if (!dir || !arg)
    return 0;
  str = keys(dir);
  i = sizeof(str);
  while (i--) {
    if (dir[str[i]] == arg)
      msg = str[i];
  }
  if (!msg || !stringp(msg))
    return 0;
  return msg;
}

int do_check(string arg) {
  int num, i, k;
  string *damage, *armor;
  object *usrs, who, me = this_player();
  if (arg || !wizardp(me))
    return 0;
  usrs = users();
  num = sizeof(usrs);
  score1 = ([]);
  score2 = ([]);
  message(
    "channel:sys",
    YEL "┝ " HIR "系统" NOR YEL " ┥：游戏者数据检测系统" WHT ">>>>>>>>>>>>>>>>>>>" YEL "开始运作\n" NOR,
    users()
  );
  while (num--)
    checking(usrs[num]);
  message(
    "channel:sys",
    YEL "┝ " HIR "系统" NOR YEL " ┥：游戏者数据检测系统" WHT ">>>>>>>>>>>>>>>>>>>" YEL "运作完毕\n" NOR,
    users()
  );
  damage = sort_array(values(score1), -1);
  armor = sort_array(values(score2), -1);

  if (sizeof(damage) > 3) {
    message("channel:chat", YEL "\n\t\t\t┝ " HIR "武器排名" NOR YEL " ┥\n" NOR, users());
    for (i = 0; i < 3; i++) {
      message("channel:chat", sprintf("\t\t\t" WHT "第" HIR "%2-s" NOR WHT "名 : %10-s \n" NOR,
        chinese_number(i + 1), check_str(score1, damage[i]))
        , users());
    }
    message("channel:chat", "\n\n" NOR, users());
  }

  if (sizeof(armor) > 3) {
    message("channel:chat", YEL "\n\t\t\t┝ " HIR "盔甲排名" NOR YEL " ┥\n" NOR, users());
    for (i = 0; i < 3; i++) {
      message("channel:chat", sprintf("\t\t\t" WHT "第" HIR "%2-s" NOR WHT "名 : %10-s \n" NOR,
        chinese_number(i + 1), check_str(score2, armor[i]))
        , users());
    }
    message("channel:chat", "\n\n" NOR, users());
  }

  return 1;
}

