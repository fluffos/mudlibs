#include <ansi.h>
inherit ITEM;

string *npc = ({
  "/d/nanhai/npc/guanyin",
  "/d/moon/npc/xiwangmu",
  "/d/changan/npc/huang",
  "/d/death/npc/yanluowang",
  "/d/xueshan/npc/dapeng",
  "/d/tiankongjie/npc/xiewu",
  "/d/kunlun/npc/tianzun",
  "/d/emei/npc/baimei",
  "/d/pansi/npc/zixia",
  "/d/lingtai/npc/puti",
  "/d/sea/npc/longwang",
  "/d/qujing/wuzhuang/npc/zhenyuan",
  "/d/jjf/npc/yuchigong",
  "/d/shaolin/npc/damo",
  "/d/swordman/npc/bigu",
  "/d/youxia/npc/shaolong",
});

void create() {
  set_name(HIW "兔毛" NOR, ({ "tu mao" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("material", "cloth");
    set("long", HIW "一根雪白的毛茸茸的兔毛。\n" NOR);
  }
  set("no_fight", 1);
  set("no_magic", 1);
  set("fake", 1);
  set("no_give", 1);
  set("no_get", 1);
  setup();
}

int ji_ob(object victim) {
  object attacker;
  string msg;
  object mao = this_object();
  object me = environment(mao);
  string maoname = mao->query("name");
  int damage, ap, dp, myspells, myexp, victimspells, victimexp, duration;
  int mykar = me->query("kar"), victimkar;

  if (me->is_busy()) {
    tell_object(me, "你无法忙中偷闲祭" + maoname + "。\n");
    return notify_fail("你正忙着呢。\n");
  }

  if (!victim) {
    tell_object(me, "你想祭的人不在这里。\n");
    return notify_fail("你祭" + maoname + "失败。\n");
  }

  if (!living(victim)) {
    tell_object(me, victim->query("name") + "已经毫无抵抗能力，不必祭了。\n");
    return notify_fail("你祭" + maoname + "失败。\n");
  }

  if ((int)me->query("mana") < 100) {
    tell_object(me, "你的法力不足，祭不了" + maoname + "。\n");
    return notify_fail("你祭" + maoname + "失败。\n");
  }

  if ((int)me->query("sen") < 100) {
    tell_object(me, "你无法集中精神念咒语。\n");
  }

  message_vision(HIY "\n$N口中念着咒语，唰地扔出一根" NOR + maoname + "。\n", me, victim);
  message_vision(maoname + HIY "腾起在半空中，只见一道白光一闪。\n" NOR, me, victim);
  victimkar = victim->query("kar");
  myspells = me->query_skill("spells") / 10;
  myexp = me->query("combat_exp") / 1000;
  victimspells = victim->query_skill("spells") / 10;
  victimexp = victim->query("combat_exp") / 1000;
  ap = (myexp + myspells * myspells * myspells / 3) * me->query("sen") / me->query("max_sen");
  ap = ap * mykar / 1000;
  dp = (victimexp + victimspells * victimspells * victimspells / 3) * victim->query("sen") / victim->query("max_sen");
  dp = dp * victimkar / 1000;
  if (wizardp(me))
    tell_object(me, GRN "进攻：" + ap + "，防守：" + dp + "。\n" NOR);

  if (random(ap + dp) > random(dp) || !interactive(me)) {
    attacker = new(npc[random(sizeof(npc))]);
    attacker->move(environment(victim));
    msg = HIW "白光一闪," + maoname + HIW "化作" NOR + HIR + attacker->query("name") + HIW "忽然出现在$N的面前！\n" NOR;
    message_vision(msg, victim);
    victim->start_busy(2 + random(3));
    attacker->kill_ob(victim);
    COMBAT_D->do_attack(attacker, victim, attacker->query_temp("weapon"));
    me->add("mana", -100);
  } else {
    message_vision(HIW "$n一转身避开了" NOR + maoname + HIW "的致命一招！\n" NOR, me, victim);
    me->add("mana", -200);
  }
  if (victim)
    victim->fight_ob(me);
  return 1;
}

int ji2_ob(object victim) {
  object attacker;
  string msg;
  object mao = this_object();
  object me = environment(mao);
  string maoname = mao->query("name");
  if (!victim) {
    tell_object(me, "你想祭的人不在这里。\n");
    return notify_fail("你祭" + maoname + "失败。\n");
  }

  if (!living(victim)) {
    tell_object(me, victim->query("name") + "已经毫无抵抗能力，不必祭了。\n");
    return notify_fail("你祭" + maoname + "失败。\n");
  }

  msg = HIY "\n$N口中念着咒语，唰地扔出一根" NOR + maoname + "。\n";
  msg += maoname + HIY "腾起在半空中，只见一道白光一闪。\n" NOR;
  attacker = new("/u/snowtu/npc/hufa");
  attacker->move(environment(victim));
  msg += HIW "白光一闪," + maoname + HIW "化作" NOR + HIR + attacker->query("name") + HIW "忽然出现在$n的面前！\n" NOR;
  message_vision(msg, me, victim);
  attacker->kill_ob(victim);
  if (victim)
    victim->fight_ob(me);
  return 1;
}

int ji(string target) {
  object mao = this_object();
  object me = this_player();
  string maoname = mao->query("name");
  object victim;

  if (!target)
    return notify_fail("你想对谁祭" + maoname + "？\n");

  victim = present(target, environment(me));
  mao->ji_ob(victim);
  return 1;
}

int query_autoload() {
  return 1;
}

void init() {
  add_action("do_huan", "huan");
  add_action("do_kl", "kl");
}

int do_huan(string arg) {
  object me = this_player();
  object ob;
  if (!arg)
    return notify_fail("什么什么?\n");
  if (arg == "shi") {
    ob = new("/d/snowtu/obj/weapon/wuxian");
    message_vision(
      HIW "$N掏出一根$n" + HIW "吹了吹气。\n" NOR + "$n" + HIW "立刻变成了一个" + HIC + ob->query("name") + HIW "。\n" NOR,
      me,
      this_object()
    );
    ob->move(me);
  }
  if (arg == "gold") {
    ob = new("/clone/money/gold");
    message_vision(
      HIW "$N掏出一根$n" + HIW "吹了吹气。\n" NOR + "$n" + HIW "立刻变成了一个" + HIC + ob->query("name") + HIW "。\n" NOR,
      me,
      this_object()
    );
    ob->move(me);
  }
  return 1;
}

int do_kl(string target) {
  object mao = this_object();
  object me = this_player();
  string maoname = mao->query("name");
  object victim;

  if (!target)
    return notify_fail("你想对谁祭" + maoname + "？\n");

  victim = present(target, environment(me));
  mao->ji2_ob(victim);
  return 1;
}
