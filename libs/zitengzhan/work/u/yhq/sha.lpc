#include <combat.h>

#include <ansi.h>

inherit F_DBASE;
inherit SSERVER;

int perform(object me, object target)
{
	int str,skill,damage;
	object weapon;

	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("〖杀〗只能对战斗中的对手使用。\n");

	if( me->query_skill("force") < 150 )
		return notify_fail("你的莲台心法火候未到，无法施展〖杀〗！\n");

	if( me->query_skill("staff") < 150 )
		return notify_fail("〖杀〗需要精湛的轮回杖法方能有效施展！\n");


//       if (me->query_temp("sha_busy")) return notify_fail("你气血翻腾，休息一下吧。\n");


	if( me->query("force") < 300 )
		return notify_fail("你的内力不够使用〖杀〗！\n");
	if( me->query("sen") < 100 )
		return notify_fail("你的精力不够使用〖杀〗！\n");

       skill=me->query_skill("lunhui-staff",1);
       weapon=me->query_temp("weapon");
       damage=skill+me->query_skill("staff",1)+me->query_temp("apply/damage")+me->query("force_factor");

       message_vision(HIW"手中"+weapon->query("name")+HIW"燃起一股滔天烈焰，$N眼中满是凄苦无奈，口中高吟 ：\n\n"NOR,me,target);

       message_vision(HIC"\n“    杀，所当杀者。\n\n"NOR,me,target);
         me->add_temp("apply/damage",damage/3);
	  COMBAT_D->do_attack(me,target, TYPE_REGULAR);
         me->add_temp("apply/damage",-damage/3);

       message_vision(HIC"\n      赦，理当赦者。\n\n"NOR,me,target);
         me->add_temp("apply/damage",damage/3);
	  COMBAT_D->do_attack(me,target, TYPE_REGULAR);
         me->add_temp("apply/damage",-damage/3);

       message_vision(HIC"\n      毒手悲心。\n\n"NOR,me,target);
         me->add_temp("apply/damage",damage/2);
	  COMBAT_D->do_attack(me,target, TYPE_REGULAR);
         me->add_temp("apply/damage",-damage/2);

       message_vision(HIC"\n　　  残人命，\n\n"NOR,me,target);
         me->add_temp("apply/damage",damage);
	  COMBAT_D->do_attack(me,target, TYPE_REGULAR);
         me->add_temp("apply/damage",-damage);

       message_vision(HIC"\n　　  断己肠。。\n\n"NOR,me,target);
         me->add_temp("apply/damage",damage);
	  COMBAT_D->do_attack(me,target, TYPE_REGULAR);
         me->add_temp("apply/damage",-damage);

       message_vision(HIC"\n　　  杀！！ 吾愿无悔之。\n\n"NOR,me,target);
         me->add_temp("apply/damage",damage*3/2);
	  COMBAT_D->do_attack(me,target, TYPE_REGULAR);
         me->add_temp("apply/damage",-damage*3/2);

       message_vision(HIC"\n　　  赦！！ 吾亦无悔之。    ”\n\n"NOR,me,target);
         me->add_temp("apply/damage",damage*3/2);
	  COMBAT_D->do_attack(me,target, TYPE_REGULAR);
         me->add_temp("apply/damage",-damage*3/2);


	     me->start_busy(2+random(1));
            me->add("force", -200);
          
	return 1;
}


