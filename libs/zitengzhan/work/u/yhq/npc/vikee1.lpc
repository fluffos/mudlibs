#include <ansi.h>

int zhongqiu();

inherit NPC;

void create()
{
 set_name(HIY"风 琴"NOR, ({ "npc yhq","npc"}));
  set("title", HIC"天上人间"NOR);   
              set("long", HIW"\n天上人间的圣诞礼物精灵，想要礼物就问问他吧。\n\n"NOR);  
  set("gender", "女性");
  set("age", 16);
  set("attitude", "heroism");
  set("per", 32);
  set("max_kee", 5000);
  set("max_gin", 5000);
  set("max_sen", 5000);
  set("force", 6000);
  set("max_force", 12000);
  set("force_factor", 300);
  set("max_mana", 7000);
  set("mana", 16000);
  set("mana_factor", 350);
  set("combat_exp", 2400000);
  set("daoxing", 6800000);
  set("inquiry", ([
  "圣诞快乐" : (:zhongqiu:),
  ]));
  setup();
}

int gift()
{
string str;
object who = this_player();
object ob = this_object();
if (this_player()->query("ziyougift")=="got")	
{
message_vision("礼物大使对着$N说：“你已经拿过了，做人不要太贪心好。”\n",who);
return 1;
}
else
if (this_player()->query("obstacle/number") < 34 )
{
message_vision("礼物大使对着$N说：“你西天取经还没有完成，请多加努力。”\n",who);
return 1;
}
else
if (this_player()->query("dntg/number") < 10 )
{
message_vision("礼物大使对着$N说：“你大闹天宫还没有完成，成功在向你招手啊。”\n",who);
return 1;
}
else
{
str=who->name();
message("channel:chat",HIC"【天上人间】礼物大使："+str+"已经过西天取经、大闹天宫等难关，特此奖励。\n"NOR,users());
message("channel:rumor",HIM"【谣言】礼物大使："+str+"已经过西天取经、大闹天宫等难关，特此奖励。\n"NOR,users());
message_vision("礼物大使举起火把，往$N头上轻轻一挨，对$N说：“你已经过西天取经、大闹天宫等难关，特此奖励。”\n\n"HIC"$N得到50万武学、500年道行、50万潜能、3000两黄金、所有基本属性加2点的奖励。\n"NOR,who);
who->add("combat_exp", 500000 );
who->add("daoxing", 500000 );
who->add("potential", 500000 );
who->add("balance", 30000000 );
who->add("str", 2 );
who->add("cor", 2 );
who->add("int", 2 );
who->add("spi", 2 );
who->add("cps", 2 );
who->add("per", 2 );
who->add("con", 2 );
who->add("kar", 2 );
who->set("ziyougift", "got" );
return 1;
}
}


int zhongqiu()
{
string str;
object who = this_player();
object ob = new ("/d/wiz/gifts/xmas/ao.lpc");
if (this_player()->query("shengdan")=="got")    
{
message_vision("风 琴对着$N说：“你已经拿过了，做人不要太贪心好。”\n",who);
return 1;
}
else
{
str=who->name();
message("channel:rumor",HIM"【谣言】风 琴："+str+"拿到了本站的圣诞节礼物。\n"NOR,users());
message_vision("风 琴给你一件衣服，说道：8小时后此衣服自动转化为经验，道行，潜能。\n"NOR,who);
ob->move(who);
who->set("shengdan", "got" );
return 1;
}
}
