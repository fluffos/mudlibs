#include <ansi.h>

int shengdan();

inherit NPC;

void create() {
  set_name(HIY "风 琴" NOR, ({ "npc yhq", "npc" }));
  set("title", HIC "天上人间" NOR);
  set("long", HIW "\n天上人间的圣诞礼物精灵，想要礼物就问问他吧。\n\n" NOR);
  set("gender", "女性");
  set("age", 16);
  set("attitude", "heroism");
  set("per", 32);
  set("max_kee", 5000);
  set("max_gin", 5000);
  set("max_sen", 5000);
  set("force", 6000);
  set("max_force", 12000);
  set("force_factor", 300);
  set("max_mana", 7000);
  set("mana", 16000);
  set("mana_factor", 350);
  set("combat_exp", 2400000);
  set("daoxing", 6800000);
  set("inquiry", ([
    "圣诞快乐": (: shengdan :),
  ]));
  setup();
}


int shengdan() {
  string str;
  object who = this_player();
  object ob = new("/d/wiz/gifts/xmas/ao.lpc");
  if (this_player()->query("shengdan") == "got") {
    message_vision("风 琴对着$N说：“你已经拿过了，做人不要太贪心好。”\n", who);
    return 1;
  }
  if (!userp(who)) {
    message_vision("风 琴对着$N说：“什么人物啊你。”\n", who);
    return 1;
  } else {
    str = who->name();
    message("channel:rumor", HIM "【谣言】风 琴：" + str + "拿到了本站的圣诞节礼物。\n" NOR, users());
    message_vision("风 琴给你一件衣服，说道：8小时后此衣服自动转化为经验，道行，潜能。\n" NOR, who);
    ob->move(who);
    who->set("shengdan", "got");
    return 1;
  }
}
