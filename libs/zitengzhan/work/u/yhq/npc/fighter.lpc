#include <ansi.h>
inherit NPC;
string send_me(object me);
void create()
{
set_name("测试ｎｐｃ", ({ "npc"}) );
set("gender", random(2)?"男性":"女性" );
set("long",BLINK+HIW"测试用NPC"NOR);
set("age",50);
set("title", HIC"天"HIM"上"HIG"人"HIW"间"NOR);
set("attitude", "heroism");
set("str",40);
set("int",30);
set("max_kee",3200);
set("kee",3200);
set("max_sen",3200);
set("sen",3200);
set("combat_exp",8000000);
set("daoxing",8000000);
set("force",10000);
set("max_force",5000);
set("mana",10000);
set("max_mana",5000);
set("force_factor", 200);
set("mana_factor",200);

set_skill("unarmed",300);
set_skill("parry",300);
set_skill("dodge",300);
set_skill("sword",300);
set_skill("force",300);
set_skill("spells", 300);
set_skill("cuixin-zhang", 300);
set_skill("xiaoyaoyou", 300);
set_skill("bainiao-jian",300);
set_skill("ningxie-force", 300);
set_skill("throwing", 300);
set_skill("dengxian-dafa", 300);

map_skill("dodge", "xiaoyaoyou");
map_skill("parry", "bainiao-jian");
map_skill("sword","bainiao-jian");
map_skill("unarmed", "cuixin-zhang");
map_skill("force","ningxie-force");
map_skill("spells","dengxian-dafa");
setup();
create_family("大雪山", 2, "弟子");
set("family/master_name","大鹏明王");
carry_object("/d/obj/weapon/sword/qinghong")->wield();
carry_object("/d/obj/armor/jinjia")->wear();
carry_object("/d/obj/armor/jinyipifeng")->wear();
carry_object("/u/angell/obj/toukui")->wear();
carry_object("/d/obj/cloth/zhanpao")->wear();
set("chat_chance_combat", 100);
set("chat_msg_combat", ({
	(: perform_action, "sword", "feijian" :),
	(: perform_action, "sword", "chaofeng" :),
	(: perform_action, "sword", "chongtian" :),
	(: perform_action, "sword", "fengwu" :),
	(: perform_action, "sword", "zheng" :),
	(: perform_action, "sword", "gui" :),
	(: perform_action, "sword", "qilin" :),

}) );

}


int accept_fight(object me)
{
    object ob=this_object();

    if( living(ob) )
      {
      message_vision("$N说到：也要你知道本天王的厉害！\n", ob);
      }
        return 1;
}

void kill_ob (object me)
{
        object ob=this_object();

    if( living(ob) )
       {
        message_vision("$N说到：送你上西天！\n", ob);
       }

	::kill_ob(me);

}

