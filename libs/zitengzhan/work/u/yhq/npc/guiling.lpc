//By yhq 2004-12-23

inherit NPC;
inherit F_MASTER;
int rank_me();
string ask_mieyao();
string ask_cancel();
#include <ansi.h>
string expell_me(object me);
void create() {
  set_name(HIG "龟灵圣母" NOR, ({ "guiling shengmu", "guiling", "shengmu" }));
  set("gender", "女性");
  set("age", 21);
  set("agi", 30);
  set("str", 60);
  set("per", 21);
  set("int", 30);
  set("class", "yao");
  set("attitude", "friendly");
  set("max_force", 3000);
  set("force", 3000);
  set("force_factor", 200);
  set("max_mana", 3000);
  set("mana", 3000);
  set("max_atman", 3000);
  set("max_kee", 2000);
  set("max_gin", 2000);
  set("max_sen", 2000);
  set("chat_chance", 30);
  set("long",
    "火灵圣母的妹妹，在通天一直对姜子牙杀姐耿耿于怀。\n"
  );
  create_family("通天教", 2, "弟子");
  set("chat_chance_combat", 20);
  set("chat_msg_combat", ({
    (: perform_action, "sword", "duo" :),
  }));
  set("inquiry", ([
    "诛仙": (: ask_mieyao :),
    "cancel": (: ask_cancel :),
    "leave": (: expell_me :),
  ]));
  set("combat_exp", 2300000);
  set("daoxing", 2300000);
  set_skill("literate", 120);
  set_skill("unarmed", 120);
  set_skill("dodge", 120);
  set_skill("force", 140);
  set_skill("parry", 165);
  set_skill("sword", 185);
  set_skill("spells", 145);
  set_skill("blade", 125);
  set_skill("wanxing-quan", 155);
  set_skill("zhuxian-sword", 155);
  set_skill("tongtian-force", 135);
  set_skill("chetian-bu", 145);
  set_skill("duzun", 130);
  map_skill("spells", "duzun");
  map_skill("unarmed", "wanxing-quan");
  map_skill("force", "tongtian-force");
  map_skill("sword", "zhuxian-sword");
  map_skill("parry", "zhuxian-sword");
  map_skill("dodge", "chetian-bu");
  setup();

  carry_object("/d/tongtian/obj/wucai.lpc")->wear();
}



string expell_me(object me) {
  me = this_player();
  if ((string)me->query("family/family_name") == "通天教") {
    message_vision("龟灵圣母叹了口气，但依然顽皮的对你眨了眨眼睛。\n", me);
    me->set_temp("betray", 1);
    message_vision("龟灵圣母对$N嘟噜着：小家伙，你说话是真心话(sure)？\n", me);
    return ("好吧，你可不要后悔哦！\n");
  }
  return ("问什么问！自己想去！\n");
}
void init() {
  add_action("do_true", "sure");
  ::init();
}

int do_true(string arg) {
  if (this_player()->query_temp("betray")) {
    message_vision("$N答道：弟子讲的真心话！\n\n", this_player());
    message_vision("龟灵圣母叹道，既然如此，你便去吧！\n", this_player());
    this_player()->set("combat_exp", this_player()->query("combat_exp") * 80 / 100);
    this_player()->set("daoxing", this_player()->query("combat_exp") * 80 / 100);
    this_player()->add("叛师/num", 1);
    this_player()->delete("family");
    this_player()->delete_skill("tongtian-force");
    this_player()->delete_skill("duzuns");
    this_player()->set("title", "普通百姓");
    this_player()->save();
    message_vision("龟灵圣母突然向天空一指，$N便消失得无影无踪。。。\n", this_player());
    this_player()->move("/d/city/center");
    tell_room(environment(this_player()), "房梁上噗噗嗦嗦几声响，掉下个人来！\n", ({ this_player() }));
    message(
      "channel:chat",
      HBMAG + "【判 师】龟灵圣母(guiling shengmu)：" + this_player()->query("name") + "退出我通天教,从此和我通天教毫无关系！\n" + NOR,
      users()
    );
    return 1;
  }
  return 0;
}

string ask_mieyao() {
  object who = this_player();

  if ((string)who->query("family/family_name") == "通天教") {
    command("smile " + who->query("id"));
    return "/d/obj/mieyao"->query_yao(who);
  }
  return ("非我门人,何故来此?\n");
}
string ask_cancel() {
  object me = this_player();
  if ((int)me->query_temp("m_mieyao")) {
    me->add("daoxing", -2000);
    me->delete_temp("m_mieyao");
    me->delete("secmieyao");
    me->delete("secmieyao/type");
    me->delete("secmieyao/location");
    me->delete("secmieyao/place");
    me->delete("secmieyao/name");
    me->delete("secmieyao/id");
    return ("没用的东西！");
  } else {
    me->delete_temp("m_mieyao");
    me->delete_temp("m_mieyao");
    me->delete("secmieyao_killedtime");
    me->delete("secmieyao_mudage");

    return ("你有任务吗？！");
  }
}
