#include <ansi.h>
inherit ITEM;
#include "/cmds/std/valid_move.h"

void step2(object);
void step3(object);
void step4(object);
void step5(object);

void create() {
  set_name("新人锦囊", ({ "xinren jinnang", "nang" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "包");
    set("no_drop", 1);
    set("value", 5000);
    set("no_give", 1);
    set("no_put", 1);
    set("no_put", 1);
    set("long", "这个是给新人准备的锦囊，你可以拆(chai)开来看看。\n");
  }
  setup();
}

void init() {
  add_action("do_chai", "chai");
}

int do_chai(string arg) {
  object ob;
  object me = this_player();
  if (!arg || !id(arg) || me != environment())
    return 0;
  if (!valid_move(me))
    return notify_fail("你现在正忙着呢。\n");
  if (!wizardp(me) && me->query("combat_exp") > 30000000)
    return notify_fail("你现在已经不算是新人了。\n");

  message_vision(YEL "$N" YEL "小心翼翼的拆开$n" YEL "。\n" NOR, me, this_object());
  ob = new("/d/obj/misc/xueshan-map");
  if (ob->move(me))
    write(YEL "你得到了一张" + ob->name() + YEL "。\n" NOR);
  ob = new("/d/penglai/npc/obj/ditu");
  if (ob->move(me))
    write(YEL "你得到了一张" + ob->name() + YEL "。\n" NOR);
  me->start_busy(5);
  call_out("step2", 1 + random(5), me);
  return 1;
}

void step2(object me) {
  object ob;
  remove_call_out("step2");
  if (!me)
    return;
  if (me->move("/d/city/caotang"))
    message_vision("$N走了过来。\n", me);
  ob = new("/d/obj/magic/bishuizhou");
  if (ob->move(me)) {
    message_vision("袁守诚递给$N一本〖无字天书〗。\n", me);
    message_vision("$N撕开无字天书的背页，从里面小心翼翼地取出一张小纸片。\n", me);
  }
  me->start_busy(5);
  call_out("step3", 1 + random(5), me);
}

void step3(object me) {
  remove_call_out("step3");
  if (!me)
    return;
  if (me->move("/d/qujing/qinglong/tongdao1")) {
    message_vision("$N走了过来。\n", me);
    me->set_temp("obstacle/jinping_give_hulu", 1);
    write(YEL "你得到了一个油葫芦。\n" NOR);
    write("你给守门牛精一个油葫芦。\n");
    message_vision("守门牛精说道：谢谢！\n", me);
  }
  me->start_busy(5);
  call_out("step4", 1 + random(5), me);
}

void step4(object me) {
  object ob;
  remove_call_out("step4");
  if (!me)
    return;
  if (me->move("/d/qujing/pansi/nanpo")) {
    message_vision("$N走了过来。\n", me);
    ob = new("/d/qujing/pansi/obj/money");
    if (ob->move(me))
      message_vision("断肠妇人给$N一张黄钱。\n", me);
  }
  me->start_busy(5);
  call_out("step5", 1 + random(5), me);
}

void step5(object me) {
  remove_call_out("step5");
  if (!me)
    return;
  if (!me->query_temp("jinnang-chai")) {
    me->set_temp("jinnang-chai", 1);
    if (me->move("/d/city/kezhan"))
      message_vision("$N走了过来。\n", me);
  }
  me->start_busy(1);
  destruct(this_object());
}
