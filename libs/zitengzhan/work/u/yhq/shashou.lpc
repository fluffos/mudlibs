#include <ansi.h>  
inherit ROOM;
void change1();
void change();
 
void create ()
{
  set ("short", "杀手楼");
  set ("long", @LONG

西夏一品堂招兵买马，成立杀手楼，目的在于成立自己的
杀手组织，暗杀中原武林高手。
LONG);

  set("objects", ([ /* sizeof() == 2 */
         "/d/shashou/npc/helian": 1 ,
]));
  set("exits", ([ /* sizeof() == 3 */
]));
  set("no_fight", 1);
  set("no_magic", 1);
  set("no_magic", 1);
  setup();
}

void init()
{
  object ob =this_object();
  if ( ob->query("r_exit")==1 ) //已经触发
	{
	call_out("change1",300);
	}
  else {
  	remove_call_out("change");
	call_out("change",1);
	}
}

void change()
{
int i;
string arg,arg1,*dir;
object ob = this_object();
dir=({
        "west","north","up",
        "down","northwest","southwest","northeast","southeast",
        "westup","westdown","eastup","eastdown",
        "northup","northdown","southup","southdown",
        "northeastup","northeastdown","northwestup","northwestdown",
        "southeastup","southeastdown","southwestup","southwestdown",
        "enter","out","right","left",
});
i=random(sizeof(dir));
if ( i<=0 || i>28 ) i=1+random(20);
arg=dir[i];
arg1=dir[i-1];
ob->set("exits",([ ]));
ob->set("exits",([
        arg : "/d/shashou/chanfang3",
        arg1 : "/d/shashou/migong/migong1" , 
        "south" : "/d/shashou/damen" ,        
]));
message("channel:wiz",WHT"杀手楼："HIR"〖"HIY"杀手楼"HIR"〗"NOR+WHT"去禅房的出口随机性地更改为"HIG+arg+NOR+WHT"，进迷宫则为"HIG+arg1+NOR+WHT"。\n"NOR,users());   
ob->set("r_exit",1);
}

void change1()
{
object ob=this_object();
ob->set("r_exit",0);
}
