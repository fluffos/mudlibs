#include <ansi.h>
#include <localtime.h>

inherit F_DBASE;

private int state;

#define SLEEPING        0
#define GET_READY       1
#define GET_READY_2     2
#define WARING       3


private int *tlist = ({ 0, 1704, 1705, 1706 });
private int *hlist = ({ 45, 1, 1, 1 });

// 通知一次准备的时间：晚上18:50分
// 通知再次准备的时间：晚上18:59分
// 开始进行战争的时间：晚上晨19:00分
// 晚上7点以后到第二天晚上18:50分之前属于休眠状态

void war_zhunbei();
void war_start();
private void change_state(int new_state);
private void sys_info(string msg);


int is_waring() { return state != SLEEPING; }


int query_war_time() { return tlist[WARING]; }

void create() {
  seteuid(ROOT_UID);
  set("channel_id", "战场指挥官(Battlefield Commander)");
  sys_info("战场系统已经启动。");
  state = SLEEPING;
  set_heart_beat(hlist[state]);
}

int clean_up() {
  return 1;
}

void heart_beat() {
  mixed lt;
  int ti;

  seteuid(ROOT_UID);
  lt = localtime(time());
  ti = lt[LT_HOUR] * 100 + lt[LT_MIN];

  switch (state) {
    case SLEEPING:
      if (ti < tlist[GET_READY] || ti > tlist[GET_READY_2])
        // not change state
        break;
      // chanage state to "GET_READY";
      change_state(GET_READY);
      break;

    case GET_READY:
      if (ti < tlist[GET_READY_2])
        break;

      // change state to "GET_READY_2";
      change_state(GET_READY_2);
      break;

    case GET_READY_2:
      if (ti < tlist[WARING])
        break;

      // change state to "GET_READY_2";
      change_state(WARING);

      // the last function will change to "SLEEPING" state
      // after waring
      break;

    default:
      change_state(SLEEPING);
      break;
  }

  // reset heart beat
  set_heart_beat(hlist[state]);
}

private void change_state(int new_state) {
  mixed lt;

  lt = localtime(time());
  switch (new_state) {
    case GET_READY:
    case GET_READY_2:
      if (lt[LT_HOUR] * 100 + lt[LT_MIN] != tlist[WARING]) {

        set("channel_id", "战场指挥官(Battlefield Commander)");

        CHANNEL_D->do_channel(this_object(), "chat",
          sprintf(HIR "现在是 %d 点 %d 分，战场将于 %d 点 %d 分"
            "正式开启，请玩家到南城客栈找战争使者来进入战场等候开始。" NOR,
            lt[LT_HOUR], lt[LT_MIN],
            (tlist[WARING] / 100) % 100,
            tlist[WARING] % 100)); war_zhunbei(); break;
      } else
        new_state = WARING;

    case WARING:
      state = new_state;


      CHANNEL_D->do_channel(this_object(), "chat",
        sprintf(HIR "现在是 %d 点 %d 分，战场马上开始"
          "请进入战场的玩家做好准备..." NOR,
          lt[LT_HOUR], lt[LT_MIN])); war_start();



      CHANNEL_D->do_channel(this_object(), "chat",
        sprintf(HIR "战场系统正式开始。" NOR,
          lt[LT_HOUR], lt[LT_MIN]));
      // after WAR, change state to SLEEPING
      new_state = SLEEPING;
      break;

    case SLEEPING:
      break;
  }

  // change to new state
  state = new_state;
  return;
}


void war_zhunbei() {
  object ob;
  object *inv, env;
  int i;
  env = find_object("/d/wiz/wizroom");
  inv = all_inventory(env);
  ob = new("/u/jiuweihu/obj/tu");
  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i]->query("id") == "tu") break;
    else {
      ob->move("/d/wiz/wizroom");
    }

  }
  //destruct(ob); continue;


  return;
}
void war_start() {
  object ob;
  object *inv, env;
  int i;
  env = find_object("/d/wiz/wizroom");
  inv = all_inventory(env);
  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i]->query("id") == "tu") inv[i]->move("/d/wiz/system");


  }
  return;
}

private void sys_info(string msg) {
  CHANNEL_D->do_channel(this_object(), "sys", msg + "\n");

}
