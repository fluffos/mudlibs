// lingzhi.c 冰糖葫芦
//星星(lywin)2000/4/22

#include <ansi.h>
inherit ITEM;

void setup()
{}

void init()
{
	add_action("do_eat", "eat");
}

void create()
{
     set_name(HIY"云"NOR, ({"allenc", "admin"}));
	if (clonep())
		set_default_object(__FILE__);
	else {
                set("unit", "位");
       set("no_sell",1);
       set("no_drop",1);
       set("no_give",1);
               set("long", "这是紫藤的一位admin，据说吃了他可得500经验，200潜能。\n");
		set("value", 0);
	}
	setup();
}

int do_eat(string arg)
{
	if (!id(arg))
	return notify_fail("你要吃什么？\n");

        this_player()->add("combat_exp", 1000);
   this_player()->add("daoxing",20800);
        this_player()->add("potential",500);
      message_vision("$N把云捣得稀烂，胡乱吞了下去，只觉得自己又变利害了一些 !\n", this_player());
	destruct(this_object());
	return 1;
}

