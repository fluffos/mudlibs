// lingzhi.c 冰糖葫芦
//星星(lywin)2000/4/22

#include <ansi.h>
inherit ITEM;

void setup() {}

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIM "虫子" NOR, ({ "chong zi", "chongzi" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "一个肥肥胖胖的虫子，还在一跳一跳的蠕动。\n");
    set("value", 0);
    set("no_get", "嘿嘿，做梦吧! \n");
    set("no_sell", "嘿嘿，做梦吧! \n");
    set("no_give", "嘿嘿，做梦吧! \n");
    set("no_drop", "嘿嘿，做梦吧! \n");
    set("no_steal", "嘿嘿，做梦吧! \n");
  }
  setup();
}

int do_eat(string arg) {
  if (!id(arg))
    return notify_fail("你要吃什么？\n");

  this_player()->add("combat_exp", 8000);
  this_player()->add("potential", 4000);
  message_vision("$N忍着恶心把虫子吞了下去!感觉胃里一阵翻涌。\n", this_player());
  destruct(this_object());
  return 1;
}
