// created by error

inherit ITEM;
inherit RANK_D;
#include <ansi.h>

void create() {
  set_name("承诺金牌", ({ "chengnuo jinpai" }));
  set_weight(250);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", @LONG
一面金牌，使用它你可以反复的设定自己的pk承诺状态。
这面金牌是admin发的，如果你不是通过admin获得的，
那你自己想想后果吧。
LONG);
    set("unit", "块");
    set("value", 1000);
  }
  setup();
}
