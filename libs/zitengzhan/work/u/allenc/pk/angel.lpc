int set_pk(string arg);
int do_yes(string arg);
int do_no();

// #include <norumor.lpc>

inherit NPC;

#include <ansi.h>
void create() {
  set_name(MAG "紫藤天使" NOR, ({ "zt angel", "zt", "angel" }));
  set("title", HIG "放下屠刀 " HIY " 立地成佛" NOR);
  set("gender", "女性");
  set("combat_exp", 1000);
  set("age", 26);
  set("per", 30);
  set("attitude", "friendly");
  set("shen_type", 1);
  set_skill("unarmed", 10);
  set("inquiry", ([
    "承诺": "是啊，就是在我这里承诺(chengnuo).\n可是chengnuo pk,也可以chengnuo no_pk\n,
                    记得哦，要yes pk/no_pk。一生只能承诺一次。Good Luck!\n",
  ]));
  setup();

  carry_object("/d/obj/cloth/xianyi")->wear();
  carry_object("/d/obj/cloth/xiuhuaxie")->wear();
}

void init() {
  ::init();
  add_action("set_pk", "chengnuo");
  add_action("do_yes", "yes");
  add_action("do_no", "no");

}

int set_pk(string arg) {
  object me, obj;

  me = this_player();
  if (!arg) return notify_fail("你承诺(chengnuo)什么？\n");

  if (me->query("pk/chengnuo"))
    if (!present("chengnuo jinpai", me))
      return notify_fail("你都承诺过了，还来凑什么热闹？\n");

  if (arg == "pk") {
    command("sigh");
    command("say " + me->query("id") + "已经承诺在今后的MUD生涯中将有选择的PK某人,是么？(yes)。\n");
  }

  if (arg == "no_pk") {
    command("oh");
    command("say " + me->query("id") + "承诺在紫藤不进行任何形式的主动PK，是么?(yes)\n");
  }

  me->set_temp("chengnuopk", 1);
  return 1;
}

int do_yes(string arg) {
  object me, obj;

  me = this_player();
  if (!me->query_temp("chengnuopk")) return notify_fail("什么?\n");
  if (!arg) return notify_fail("yes 什么阿?\n");

  me->set_temp("chengnuopk", 0);
  if (arg == "pk") me->set("pk/no_pk_death", 0);
  else if (arg == "no_pk") me->set("pk/no_pk_death", 1);
  else return notify_fail("pk/no_pk???\n");
  command("ok " + me->query("id"));
  me->set("pk/chengnuo", 1);


  if (objectp(obj = present("chengnuo jinpai", me))) destruct(obj);
  return 1;
}

int do_no() {
  object me;

  me = this_player();
  if (!me->query_temp("chengnuopk")) return notify_fail("什么?\n");
  me->set_temp("chengnuopk", 0);
  command("? " + me->query("id"));
  command("ok " + me->query("id"));
  command("say 那你想好了再来吧。不过没想好之前是不能下kill命令的哦。");
  command("heihei " + me->query("id"));

  return 1;

}
