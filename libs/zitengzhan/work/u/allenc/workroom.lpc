int valid_leave(object me, string dir)
{
    if ( dir == "north" )
    {
    	if ( me->query("id") == "allenc"  || me->query("id") == "babala"
    	   || me->query("id") == "lala"  || me->query("id") == "nname")
		return ::valid_leave(me, dir);
	return notify_fail(HIR"进入人家居室不好吧！\n");
     }
     
     return ::valid_leave(me, dir);       
     
}

