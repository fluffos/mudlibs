// mihun.c 迷魂术
#include <ansi.h>

inherit SSERVER;

void free(object target);

int cast(object me, object target) {
  string msg;
  int success, ap, dp, ap2, ap3, ap4, dp2, dp3, dp4, howlong;

  if (!target) target = offensive_target(me);

  if ((int)me->query_skill("spells") < 100 || (int)me->query_skill("taoism", 1) < 80)
    return notify_fail("你还没学会跳大神。。。\n");

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你想请谁的神？\n");

  if (target->query_temp("no_move"))
    return notify_fail(target->query("name") + "已经迷迷糊糊，不知所措了！\n");

  if ((int)me->query("mana") < 500)
    return notify_fail("你的法力不够！\n");

  if ((int)me->query("sen") < 300)
    return notify_fail("你无法集中精力！\n");

  me->add("mana", -200);
  me->receive_damage("sen", 50);

  msg = HIC
    "$N批头散发嘴里嘟囔着自己都听不懂的咒语，忽然抬起头来朝$n大喊一声：吾神来也！\n"
    NOR;

  success = 1;
  ap = me->query_skill("spells");
  ap = ap * ap * ap / 15;
  ap += (int)me->query("daoxing");
  dp = target->query("daoxing");
  //	if( random(ap + dp) < dp ) success = 0;
  //here we compared exp and spells level. 
  //note: has nothing to do with target's spells level.

  ap2 = (int)me->query_per();
  dp2 = (int)target->query_per();
  //	if( random(4*ap) < ((int)target->query_cps()+dp)) success = 0;
  //here we compare per and guy's ding li.


  ap3 = (int)me->query("mana");
  dp3 = (int)target->query("mana");
  if (random(ap + dp + 2000 * (ap2 + dp2) + 200 * (ap3 + dp3)) < (dp + 2500 * dp2 + 200 * dp3)) success = 0;

  //here we compare current mana. this is important. you need recover to try again.

  if (success == 1) {
    msg += HIR "$n哆嗦了一下,呆呆的看着$N不知所措。\n" NOR;
    target->set_temp("no_move", 1);

    howlong = random((me->query_skill("spells") - 100)) + 1;
    if (howlong > 60) howlong = 60;
    call_out("free", howlong, target);
  } else {
    msg += HIR "$n鄙夷地看了$N一眼，骂道：竟然用这样的招数来骗我，找死！\n" NOR;
    me->start_busy(10 + random(5));
    if (living(target)) target->kill_ob(me);
  }

  message_vision(msg, me, target);
  return 5 + random(5);
}

void free(object target) {
  if (target)
    target->delete_temp("no_move");
  return;
}
