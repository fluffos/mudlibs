#include <ansi.h>
inherit ROOM;
void create()
{
  set("short",HIY "在水一方" NOR);
 set("long", @LONG
一间精致的竹屋让人从分体验到远离江湖喧嚣的悠闲和恬静.一扇竹门
向南开着.阳光从东墙上那扇竹编的窗户透射进来洒在屋里的每个角落显出点
点生气。竹屋北面摆放着一张特制的木床（bed）.木料是采至天庭南面的玉树林的万
年仙树。木床静静地躺在那里冒出一丝丝的仙气.一张巨大的麻编地毯覆盖了
大半个竹屋上面随意摆放着几个坐垫和一张茶几.小屋西边墙上挂满了云夫妻
的各种战利品。
LONG); 
    set("no_time", 1);
    set("no_fight", 1);
    set("no_magic", 1);
    set("exits",([ 
       "south" : "/u/allenc/workroom",
        ]));    
    set("objects",([
            "/d/obj/flower/rose999":1]));
   
    create_door("south","花雕木门","north");
    set("no_clean_up",0);
	setup();
    //replace_program(ROOM);
}

void init()
{
  add_action("do_bed", "gosleep");
  add_action("do_bed", "gobed" );
  add_action("do_bed", "bed");
}

int do_bed()
{       object me;
        me=this_player();
        message_vision(HIY "$N掀开纱帐，准备上床了。\n\n" NOR, me);
        me->move("/u/allenc/bed_allenc");
        message_vision(HIY "\n沙帐轻轻一动，$N钻了进来。\n" NOR, me);
        return 1;
}
