#include <ansi.h>
inherit NPC;
string ask_me();

void create() {
  set_name(HIR "礼物发放" NOR, ({ "angel", "angel" }));
  set("gender", "男性");
  set("age", 18);
  set("long", YEL "
         7.8号的水陆大会结果如下：
         第一组：sky,star,yangn;
         第二组：xiaoxiao,windsnow,hphp;
         门派因为allenc的原因没有继续，在此向大家表示歉意。
         门派比试作废，参加选手上站找nip单独领取礼物。
         
         领取奖励，ask angel about sldh;         
         \n" NOR);

  set("combat_exp", 1000000);
  set("str", 30);
  set("dex", 30);
  set("con", 30);
  set("int", 30);
  set("per", 30);
  set("attitude", "friendly");
  //    set("max_qi", 100000);
  //    set("neili", 100000);
  //    set("max_neili", 100000);
  //    set("score", 100000);

  set("inquiry", ([
    "sldh": (: ask_me :)
  ]));
  setup();
  carry_object("/d/obj/cloth/magua")->wear();
}

void init() {
  object ob;
  ob = this_player();
  ::init();
  if (interactive(ob) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  //command("whisper " + ob->query("id") + " "HIW"欢迎光临〖紫藤站〗"+HIR+"(ask shizhe about 紫藤) "+NOR+HIW+"， 小的助您行走江湖．"NOR);
  command("say " + HIC "发放礼物！look angel!" NOR);
}

string ask_me() {
  object me = this_player();
  object ob;
  string temp;
  mapping fam;

  if ((int)me->query("getsldhreward"))
    return "呵呵～这就是您的不是了！你不是已经领了么？";
  else {
    me->set("getsldhreward", 1);
    if (me->query("id") == "sky" || me->query("id") == "xiaoxiao") me->add("potential", 100000);
    else if (me->query("id") == "star" || me->query("id") == "windsnow") me->add(
      "potential",
      70000
    );
    else if (me->query("id") == "yangn" || me->query("id") == "hphp") me->add("potential", 50000);

    if (me->query("id") == "sky" || me->query("id") == "tonger" ||
      me->query("id") == "xiaomi" || me->query("id") == "cdd" ||
      me->query("id") == "star" || me->query("id") == "yangn" ||
      me->query("id") == "windsnow" || me->query("id") == "xiaoxiao" ||
      me->query("id") == "hphp" || me->query("id") == "lifebird" ||
      me->query("id") == "okok" || me->query("id") == "xkai") me->add("potential", 30000);
    else me->add("potential", 10000);

    return " 奖励已经发放, 继续努力吧！";

  }
}
