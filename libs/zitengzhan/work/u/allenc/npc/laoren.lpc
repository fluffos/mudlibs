//  person who can be asked about wuxingyao

inherit NPC;


int cure_me();
int news_cls();

void create()
{
 
	set_name("神秘老人", ({ "laoren" }) );
	set("gender", "男性" );
	set("long", "他就是上界派来看守妖谷的神仙，也不知在这里守了多少年。\n");
	set("age",100);
	// set("title", "托塔天王");
	set("str", 40);
	set("int", 30);
	set("con", 30);
	set("spi", 30);
	set("per", 30);
	set("class", "xian");
	set("attitude", "heroism");
	set("combat_exp", 1500000);
	set("daoxing", 2000000);
	set("max_kee", 20000);
	set("max_sen", 20000);
	set("force",50000);
	set("max_force",30000);
	set("force_factor", 1500);
	set("mana", 50000);
	set("max_mana", 30000);
	set("mana_factor", 1500);

	set("eff_dx", 600000);
	set("nkgain", 600);

	set_skill("unarmed",500);
	set_skill("dodge",500);
	set_skill("parry",500);
	//set_skill("sword", 500);
	set_skill("force", 500);
	set_skill("spells", 500);
 	set_skill("wuxing-quan", 500);
	//set_skill("liangyi-sword", 500);
	set_skill("buddhism", 500);
	set_skill("baguazhen", 500);
	set_skill("zhenyuan-force", 500);
	map_skill("unarmed", "wuxing-quan");
	map_skill("force", "zhenyuan-force");
	map_skill("spells", "buddhism");
	//map_skill("sword", "liangyi-sword");
	//map_skill("parry", "liangyi-sword");
	map_skill("dodge", "baguazhen");

        seteuid(getuid());

        set("inquiry", ([
        "cure": (: cure_me :),
        "news": (: news_cls :),
        ]));

	setup();
}

int cure_me(){
       object me= this_player();
      if(me->query("cure/bylaoren1")){
      command("say 我不是已经给你治过了吗？");
      return 1;
           }
       me->set("cure/bylaoren1",1);
       me->delete("secmieyao_mudage");
       me->delete("m_mieyao");
       command("nod");
       command("say 好了！");
       return 1;
}

int news_cls()
{
	int i;
	
	object me=this_object();
	
	i=me->query("LastReadNews");
	if(me->query("newscls")) {
		command("say 我不是清过你的了么？\n");
		return 1;
	}
	write(i);
	me->add("LastReadNews",-i);
	me->set("newscls",1);
	command("nod");
	command("say 好了！");
	
	return 1;
}
