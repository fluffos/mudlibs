#include <ansi.h>

inherit NPC;
void consider();
int ask_ziteng();
void create() {
  set_name(HIG "云" NOR, ({ "zt_allenc" }));
  //        set("nickname", HIW "生辰" NOR);
  set("gender", "男性");
  set("title", HIR " 鸿蒙初辟原无姓 " HIY " 打破顽冥须悟空 ");
  set("age", 500);
  set("long",
    "   [1;32m菩提本无树，[1;36m明镜自成台。[2;37;0m
             
   [1;31m本来无一物，[1;33m何处惹尘埃。[2;37;0m\n");
  set("attitude", "friendly");
  set("shen_type", 1);
  set("class", "god");
  set("str", 40);
  set("int", 40);
  set("con", 40);
  set("dex", 40);
  set("per", 100);
  set("kee", 2000);
  set("max_kee", 2000);
  set("force", 3000);
  set("max_force", 3000);
  set("combat_exp", 1000000);
  set("inquiry", ([
    "紫藤开站": "紫藤站是[1;31m2001年5月4日[2;37;0m开的站。\n",
    "紫藤": (: ask_ziteng :), ]));

  /*      set("chat_msg", ({
            "生辰精灵拿出一本"+HIW"《精灵物语》"NOR+"，专心地读了起来。\n", 
            "生辰精灵随着光芒一闪一闪，无聊地说：“怎么没人来领礼物呢？”\n", }) );*/
  setup();
  /*        carry_object("/d/obj/cloth/luoyi")->wear();*/
  carry_object("/d/obj/weapon/stick/xiangmo")->wield();

}

