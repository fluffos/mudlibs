//allenc
///cmds/arch/renwu

#include <ansi.h>
inherit F_CLEAN_UP;
#define RENWU "/adm/etc/renwu"

int main(object me, string arg) {
  object ob;
  string renwu, wiz;
  if (me != this_player(1)) return 0;

  if (!arg || sscanf(arg, "%s %s", wiz, renwu) != 2)
    return notify_fail("指令格式：renwu <使用者> <任务>\n");

  if (!objectp(ob = present(wiz, environment(me)))
    || !userp(ob))
    return notify_fail("你只能改变在线巫师的任务。\n");

  if (!wizardp(ob)) return notify_fail("你只能给巫师分配任务!\n");

  if (wiz_level(me) < wiz_level(wiz)) return notify_fail("你的权限没有他高哦!\n");
  if (wizhood(me) != "(admin)" && wiz_level(me) == wiz_level(wiz))
    return notify_fail("让你的上司给你分配任务吧！\n");

  wiz += " ";
  wiz += renwu;
  wiz += "\n";
  write_file(RENWU, wiz, 0);

  command("addoil " + wiz);

  message_vision("$N给$n分配了 " + renwu + "的任务 !\n", me, ob);

  return 1;
}

int help(object me) {
  write(@HELP
指令格式: renwu <id> <任务>
 
给比你等级低的巫师分配任务。

相关命令： wizlist
 
HELP
  );
  return 1;
}
