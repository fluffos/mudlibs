// wlist.c

//在logind.c 884行 加 user->set("login_time",time());

#include <ansi.h>
inherit F_CLEAN_UP;
#define RENWU "/adm/etc/renwu"
mapping levels = ([
  "(admin)": "天    神",
  "(arch)": "大 巫 师",
  "(wizard)": "巫    师",
  "(apprentice)": "客座巫师",
  "(immortal)": "小 巫 师",
  "(elder)": "荣誉玩家",
]);
string query_time(int time);

void create() { seteuid(getuid()); }

int main(object me, string arg) {
  string *list;
  int i, inv = 0;
  string msg, time_msg, quest, wiz;
  object ob, body;
  mapping quests = ([]);
  if (file_size(RENWU))
    foreach (string str in explode(read_file(RENWU), "\n")) {
      if (str[0] == '#' || sscanf(str, "%s %s", wiz, quest) != 2) continue;
      quests += ([ wiz: quest ]);
    }
  msg = "\n 中文名       英文名   等级     状态　时间　             任务\n";
  msg += "————————————————————————————————————\n";


  list = sort_array(SECURITY_D->query_wizlist(), 1);

  for (i = 0; i < sizeof(list); i++) {
    inv = 0;
    ob = new(LOGIN_OB);
    ob->set("id", list[i]);
    ob->restore();
    if (objectp(body = find_player(list[i])) && !body->query("env/invisibility")) {
      time_msg = sprintf(" 连线：%s",
        query_time(body->query("login_time")));
      inv = 1;
    } else time_msg = sprintf(" 离线：%s",
      query_time(ob->query("last_on")));
    msg += sprintf(" %-13s%-9s%s%s%-26s%s%s%s%s\n", ob->query("name"), list[i],
      levels[SECURITY_D->get_status(list[i])],
      inv ? HIY : NOR, time_msg, NOR,
      HIW, undefinedp(quests[list[i]]) ? "(暂无任务)" : quests[list[i]], NOR);
    destruct(ob);
  }
  msg += "————————————————————————————————————\n";
  msg += sprintf(" %s现在共有%s名巫师。\n", MUD_NAME, chinese_number(sizeof(list)));
  write(msg);
  return 1;
}


string query_time(int time) {
  string msg;
  int day, hour, min;

  time = time() - time;

  msg = "";
  day = time / 86400;
  hour = time % 86400 / 3600;
  min = time / 60 % 60;
  if (min < 1)
    min = 1;
  if (day)
    msg += sprintf("%s天", chinese_number(day));
  if (day < 10 && hour)
    msg += sprintf("%s小时", chinese_number(hour));
  if (!day && hour < 20 && min)
    msg += sprintf("%s分钟", chinese_number(min));
  return msg;
}

int help(object me) {
  write(@HELP
指令格式 : wlist

用途 : 列出目前所有的巫师名单(含客座巫师)。
HELP
  );
  return 1;

}
