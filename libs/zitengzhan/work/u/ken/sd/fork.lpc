//Ken@_@
#include <ansi.h>
#include <weapon.h>
inherit FORK;
void create() {
  set_name(HIG "碧海叉" NOR, ({ "sea fork", "cha", "fork" }));
  set_weight(70000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "一把闪着丝丝莹光的叉子，据说挥舞起来威力无比。\n");
    set("value", 100000);
    set("material", "steel");
    set("need_level", 5);
    set("wield_msg", "平地突然涌起滔天巨浪，原来是$N装备$n做武器。\n");
    set("unwield_msg", "$N收起了$n。\n");
  }

  init_fork(150);
  setup();

}

mixed hit_ob(object me, object victim, int damage_bonus) {
  int pro;
  int dam;
  dam = (int)me->query("force");
  victim->receive_damage("kee", dam / 90);
  return HIG "一阵大浪涌来，$n顿时觉得气血翻涌不已。\n" NOR;
}
