// worker.c
// huarong 2004/5
inherit NPC;
#include <ansi.h>

string *msg = ({
"本站主页地址是 http://www.dtmud.net  欢迎访问！\n",
"help rulaitask是取经之后的任务系统！近期已增加难度四的任务。\n",
"help zongshi里面介绍大唐西游各大门派宗师！\n",
"请用top指令来查询目前在线玩家的排行，以及用topten指令来查看总排行\n",
"新人请多使用help来了解本站礼物以及help moondm来查看老玩家写的新人指南。\n",
"凡是向巫师组举报bug或举报用bug练功者，根据轻重，都会给予奖励。\n",
        });

string *msg2 = ({
"请第一次进站朋友查看help gift以获得帮助！\n"NOR,
BLINK"请大家记得随时备份自已的档案，以免意外情况，备份指令是：backup\n"NOR,
        });
        
void create()
{
        set_name("大唐西游", ({"DTXY","da tang"}));
        set("gender", "男性" );
        set("age", 13);
        set("title", "大唐西游新闻发布使");
        set("long", "一个可爱的小童，每天负责在这里迎接远道而来的客人．\n");
        set("combat_exp", 200);
        set("attitude", "friendly");
        set_skill("dodge", 10);
        set("per", 30);
        set("max_kee", 1500000);
        set("kee",1500000);
        set("sen",1500000);
        set("max_sen", 1500000);
        setup();
        remove_call_out("msg");
        call_out("msg",60);
}

void msg()
{   
     int i;
     i=random(10);
          remove_call_out("msg");
          call_out("msg",300);
     
     if(i>5)      
          command_function("es "+NOR+HBBLU+msg[random(sizeof(msg))]+NOR);
     else         
          command_function("xyj "+BLINK+HIW+"【巫师提示】：" +NOR+HIY+msg2[random(sizeof(msg2))]+NOR);

}


