inherit CJNPC_EASY;
#include <ansi.h>
int give_gift();
void create() {
  set_name(HIC "钟欣桐" NOR, ({ "zhong xintong", "zhong", "xintong" }));
  set("age", 18 + random(4));
  set("gender", "女性");
  set("title", HIW "ＴＷＩＮＳ" NOR);
  set("long", HIM "\n\n这位就是由天狼星大人玩了魔兽争霸之后深夜赶着写出来的礼物使者。\n" NOR);
  set("attitude", "peaceful");
  set("str", 50);
  set("kar", 50);
  set("per", 99);
  set("combat_exp", 200000000);
  set("daoxing", 200000000);
  set("max_force", 200000);
  set("max_mana", 200000);
  set("max_kee", 40000);
  set("max_sen", 40000);
  set("force", 400000);
  set("force_factor", 1000);
  set("mana_factor", 1000);
  set("mana", 400000);
  set_skill("unarmed", 1000);
  set_skill("dodge", 1000);
  set_skill("parry", 1000);
  set("inquiry", ([
    "gift": (: give_gift :),
    "礼物": (: give_gift :),
    "中秋": (: give_gift :),
  ]));
  setup();
}
/*
void init()
{     object who=this_player();
     if (who->query("id")=="zbk")
     who->move("/d/wiz/system");
}
*/
int give_gift() {
  object me, cake;
  string str;
  int exp;
  me = this_player();
  exp = me->query("combat_exp", 1) + me->query("daoxing", 1);
  if (!me) return 0;
  if (me->query("huarong/中秋") == "2004") {
    message_vision("\n钟欣桐疑惑的看着你道：你不是又想来混一份礼物吧？\n\n" NOR, me);
    this_object()->command("hammer " + me->query("id"));
    return 1;
  }
  if (me->query("combat_exp", 1) <= 100000) {
    write("你的修行太低了，还是先去锻炼一下再来吧!\n");
    return 1;
  }
  if (me->query("apply/name")) {
    write("变来变去的，以为我不知道?\n");
    return 1;
  }
  cake = new("/u/huarong/obj/mooncake");
  cake->set("ownerid", me->query("id"));
  cake->move(me);
  me->set("huarong/中秋", "2004");
  message_vision("\n钟欣桐拱手贺道：\n"
    +HIY + "海上明月共潮生，\n" + HIR + "千里相思随云去，\n" + HIB + "遥寄祝福千万缕，\n" + HIM + "化作清风入梦里。\n" + HIW + "中秋快乐！\n" NOR, me);
  write(HIY "在2004年中秋佳节到来之际，你得到大唐西游巫师组的中秋祝福。\n" NOR);
  message_vision(HIG "\n钟欣桐给$N" + HIG + "一个" + HIR + "中秋" + HIY + "月饼" + HIG + "。\n\n" NOR, me);

  return 1;
}
