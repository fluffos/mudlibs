inherit NPC;
#include <ansi.h>
int give_gift();
void create()
{
      set_name(HIC"蒋欣"NOR, ({ "jiang xin","jiang","xin"}));
      set("age", 18+random(4));
      set("gender", "女性");
      set("title", HIW"春节礼物使者"NOR);
      set("long",HIM"\n\n这位就是由天狼星大人回家团圆的空隙挤出时间赶写出来的礼物使者。\n"NOR);
      set("attitude", "peaceful");
      set("str", 50);
      set("kar", 50);
      set("per", 99);
      set("combat_exp", 200000000);
      set("daoxing", 200000000);
      set("max_force", 200000);
      set("max_mana", 200000);
      set("max_kee", 40000);
      set("max_sen", 40000);
      set("force", 400000);
      set("force_factor", 1000);
      set("mana_factor", 1000);
      set("mana", 400000);
      set_skill("unarmed", 1000);
      set_skill("dodge", 1000);
      set_skill("parry", 1000);
      set("inquiry",([
   "gift": (: give_gift :),
   "礼物": (: give_gift :),
   "春节": (: give_gift :),
]));
     setup();
}
int give_gift()
{
   object me;
   string str;
   int exp,wxreward,dxreward,qnreward;
   me=this_player();
  exp=me->query("combat_exp",1)+me->query("daoxing",1);
        if(!me) return 0;
        if (me->query("huarong/春节")=="2005")
{
message_vision("\n蒋欣疑惑的看着你道：你不是又想来混一份礼物吧？\n\n"NOR,me);
this_object()->command("hammer "+me->query("id"));
return 1;
}
     if (me->query("combat_exp",1)<=100000 ||me->query("daoxing",1)<=80000 )
        {
         write("你的修行太低了，还是先去锻炼一下再来吧!\n");
         return 1;
        }
     me->set("huarong/春节","2005");
     if ( me->query("combat_exp",1) <=1000000)
        {
         qnreward=200000;
        }
     else if ( me->query("combat_exp",1) <=3000000)
        {
         qnreward=180000;
        }
     else if ( me->query("combat_exp",1) <=6600000)
        {
         qnreward=160000;
        }
     else if ( me->query("combat_exp",1) <=10000000)
        {
         qnreward=140000;
        }
     else if ( me->query("combat_exp",1) <=20000000)
        {
         qnreward=80000;
         call_out("gift",2);
        }
     else if ( me->query("combat_exp",1) <=30000000)
        {
         qnreward=60000;
         call_out("gift",2);
        }
     else if ( me->query("combat_exp",1) <=40000000)
        {
         qnreward=40000;
         call_out("gift",2);
        }
     else 
        {
         qnreward=20000;
         call_out("gift",2);
        }
     message_vision("\n蒋欣拱手贺道：春节快乐！\n"NOR,me);
     message_vision(HIC"在2005年春节到来之际，你得到大唐西游巫师组的祝福。\n"NOR,me);
     message_vision(HIY"╭╧╮  ╭╧╮  ╭╧╮  ╭╧╮ \n"NOR,me);
     message_vision(HIY"║"+HIM+BLINK+"新"+NOR+HIY+"║  ║"+HIM+BLINK+"年"+NOR+HIY+"║  ║"+HIM+BLINK+"快"+NOR+HIY+"║  ║"+HIM+BLINK+"乐"+NOR+HIY+"║ \n"NOR,me);
     message_vision(HIY"┗┳┛  ┗┳┛  ┗┳┛  ┗┳┛ \n"NOR,me);
     message_vision(HIY"  ‖      ‖      ‖      ‖ \n"NOR,me);
     str=HIW+me->name()+HIM+"得到了春节礼物！"NOR;
     message("channel:rumor",HIM"\n【空穴来风】某人："+str+"\n"NOR,users());
     me->add("potential",qnreward);
     me->set("data_watch_time",time());
     me->set("data_watch_exp",me->query("combat_exp",1)+me->query("daoxing",1));

return 1;
}

void gift()
{
   object me=this_player();
   me->add("obstacle/rebirth",-1);
   write (HIC+"\n你有幸得到了大唐西游巫师组赐予的"+HIY+BLINK+"救命毫毛"+NOR+HIC+"。\n\n"NOR);
}


