#include <ansi.h>
inherit ITEM;
inherit "/u/huarong/book/jingshud.lpc";

void init();
int do_read(string arg);


void setname() {
  string name, long;
  long = HIY "\n西天大雷音寺我佛藏经阁";
  if (random(13) == 1) {
    name = COLOR_D->random_color(
      random(4),
      ((random(10) < 8) ? 0 : 1)
    ) + "『" + jsahan[random(sizeof(jsahan))] + "』" NOR; long += HIR "阿含部" HIY;
  } else if (random(13) == 2) {
    name = COLOR_D->random_color(
      random(4),
      ((random(10) < 8) ? 0 : 1)
    ) + "『" + jsbenyuan[random(sizeof(jsbenyuan))] + "』" NOR; long += HIR "本缘部" HIY;
  } else if (random(13) == 3) {
    name = COLOR_D->random_color(
      random(4),
      ((random(10) < 8) ? 0 : 1)
    ) + "『" + jsbanruo[random(sizeof(jsbanruo))] + "』" NOR; long += HIR "般若部" HIY;
  } else if (random(13) == 4) {
    name = COLOR_D->random_color(
      random(4),
      ((random(10) < 8) ? 0 : 1)
    ) + "『" + jshuafa[random(sizeof(jshuafa))] + "』" NOR; long += HIR "法华部" HIY;
  } else if (random(13) == 5) {
    name = COLOR_D->random_color(
      random(4),
      ((random(10) < 8) ? 0 : 1)
    ) + "『" + jshuayan[random(sizeof(jshuayan))] + "』" NOR; long += HIR "华严部" HIY;
  } else if (random(13) == 6) {
    name = COLOR_D->random_color(
      random(4),
      ((random(10) < 8) ? 0 : 1)
    ) + "『" + jsbaoji[random(sizeof(jsbaoji))] + "』" NOR; long += HIR "宝积部" HIY;
  } else if (random(13) == 7) {
    name = COLOR_D->random_color(
      random(4),
      ((random(10) < 8) ? 0 : 1)
    ) + "『" + jsniepan[random(sizeof(jsniepan))] + "』" NOR; long += HIR "涅槃部" HIY;
  } else if (random(13) == 8) {
    name = COLOR_D->random_color(
      random(4),
      ((random(10) < 8) ? 0 : 1)
    ) + "『" + jsdaji[random(sizeof(jsdaji))] + "』" NOR; long += HIR "大集部" HIY;
  } else if (random(13) == 9) {
    name = COLOR_D->random_color(
      random(4),
      ((random(10) < 8) ? 0 : 1)
    ) + "『" + jsjingji[random(sizeof(jsjingji))] + "』" NOR; long += HIR "经集部" HIY;
  } else if (random(13) == 10) {
    name = COLOR_D->random_color(
      random(4),
      ((random(10) < 8) ? 0 : 1)
    ) + "『" + jslvbu[random(sizeof(jslvbu))] + "』" NOR; long += HIR "律部" HIY;
  } else if (random(13) == 11) {
    name = COLOR_D->random_color(
      random(4),
      ((random(10) < 8) ? 0 : 1)
    ) + "『" + jsshijing[random(sizeof(jsshijing))] + "』" NOR; long += HIR "释经论部" HIY;
  } else if (random(13) == 12) {
    name = COLOR_D->random_color(
      random(4),
      ((random(10) < 8) ? 0 : 1)
    ) + "『" + jszhongguan[random(sizeof(jszhongguan))] + "』" NOR; long += HIR "中观部" HIY;
  } else {
    name = COLOR_D->random_color(
      random(4),
      ((random(10) < 8) ? 0 : 1)
    ) + "『" + jsyujia[random(sizeof(jsyujia))] + "』" NOR; long += HIR "瑜伽部" HIY;
  }

  long += "之经书。" NOR;
  set_name(name, ({ "fo jing", "jing", "book" }));
  set("long", long + "\n\n");

}

void create() {
  seteuid(getuid());
  setname();
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    //      setlong();
    set("material", "paper");
    set("value", 500);
  }
}

void init() {
  add_action("do_read", "read");
  add_action("do_read", "study");

  if ((int)this_object()->query("created") != 1) {
    this_object()->set("created", 1);
    remove_call_out("destroy_book");
    call_out("destroy_book", 18000);  //5 hours

  }
}



void destroy_book() {
  message_vision(
    "天空中翻出一只大袖，将" + (string)this_object()->query("name") + "轻轻一卷，消失在云端。\n",
    environment(this_object())
  );
  destruct(this_object());
}

int do_read(string arg) {
  object me;
  int sen_cost, gain;

  me = this_player();

  if (!this_object()->id(arg)) return 0;
  if (environment(this_object()) != me) return notify_fail("书要拿起来读。\n");
  if (me->is_busy())
    return notify_fail("你现在忙着呢，哪有可能静心研读...\n");
  if (me->is_fighting())
    return notify_fail("现在才想到精研太乙仙法，太晚了吧？\n");
  if ((int)me->query_skill("literate", 1) < 150)
    return notify_fail("你看了半天，里面不少字都是它认得你你不认得它。\n");
  if ((int)me->query_skill("taiyi", 1) > 250)
    return notify_fail("你在太乙仙法方面已经很有造诣，这本书不会让你长进多少。\n");

  sen_cost = 25 + random((30 - (int)me->query("int")));
  if (sen_cost < 10) sen_cost = 10;
  if ((int)me->query("sen") < sen_cost)
    return notify_fail("你现在头晕脑胀，该休息休息了。\n");
  me->receive_damage("sen", sen_cost);

  gain = (int)me->query_skill("literate", 1) / 5 + (int)me->query("int") / 4 + 1;
  me->improve_skill("taiyi", gain);

  message_vision("$N哼哼叽叽地翻看着一本小册子。\n", me);

  return 1;
}
