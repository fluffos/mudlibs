//huarong 2003.4 for cjnpc
inherit "/u/huarong/npc/cjnpc.lpc";
#include <ansi.h>

void create() {
  set_name(HIW "白玉堂" NOR, ({ "bai yutang", "bai", "yutang" }));
  set("long",
    "陷空山无底洞锦毛鼠白玉堂是也，英俊潇洒，风度翩翩。\n");
  set("title", MAG "锦毛鼠" NOR);
  set("gender", "男性");
  set("age", 20);
  set("class", "yaomo");
  set("attitude", "friendly");
  set("per", 40);
  set("int", 30);
  set("max_kee", 10000);
  set("max_sen", 10000);
  set("force", 14000);
  set("max_force", 7000);
  set("force_factor", 300);
  set("max_mana", 20000);
  set("mana", 20000);
  set("mana_factor", 1000);
  set("combat_exp", 50000000);
  set("daoxing", 50000000);
  set("eff_dx", 200000);
  set("nkgain", 350);
  set("faith", 1000);

  set_skill("unarmed", 500);
  set_skill("stealing", 500);
  set_skill("qixiu-jian", 500);
  set_skill("dodge", 500);
  set_skill("parry", 500);
  set_skill("literate", 500);
  set_skill("spells", 500);
  set_skill("force", 500);
  set_skill("huntian-qigong", 500);
  set_skill("yaofa", 500);
  set_skill("yinfeng-zhua", 500);
  set_skill("kugu-blade", 500);
  set_skill("sword", 500);
  set_skill("blade", 500);

  map_skill("force", "huntian-qigong");
  map_skill("unarmed", "yinfeng-zhua");
  map_skill("dodge", "kugu-blade");
  map_skill("spells", "yaofa");
  map_skill("parry", "qixiu-jian");
  map_skill("sword", "qixiu-jian");
  map_skill("blade", "kugu-blade");

  create_family("陷空山无底洞", 1, "弟子");
  setup();
  carry_object("/d/obj/cloth/baipao")->wear();
  carry_object("/d/obj/weapon/sword/zhujian.lpc")->wield();
  carry_object("/d/obj/weapon/blade/jindao.lpc");
}


void kill_ob(object ob) {
  set_temp("my_killer", ob);
  remove_call_out("check");
  call_out("check", 1);
  ::kill_ob(ob);
}

void check() {
  object ob = this_object();
  object ghost;
  object me = query_temp("my_killer");

  if (!me) return;
  if (!present(me, environment()) || !ob->is_fighting() || !me->is_fighting()) {
    remove_call_out("check");
    return;
  }
  remove_call_out("check2");
  call_out("check2", 0);

  if (me->is_busy()) {
    command("unwield blade");
    command("wield sword");
    command("jiali max");
    command("exert recover");
    if (!ob->query_temp("zxzx")) command("perform zxzx");
    //      if( time()-(int)me->query_temp("zxzx_end") < 10 )
    //    {
    command("unwield sword");
    command("wield blade");
    command("perform diyu");
    command("unwield blade");
    command("wield sword");
    //    }
    if (random(10) > 3) {
      command("perform yaowu");
    } else {
      command("cast bite");
    }
    remove_call_out("check");
    call_out("check", 2);
  }
  if (!me->is_busy()) {
    command("unwield sword");
    command("exert recover");
    command("perform duzun");
    command("wield blade");
    command("perform pozhan");
    command("perform duo");
    remove_call_out("check");
    call_out("check", 3);

  }
}


void unconcious() {
  die();
}
void die() {
  if (environment()) {
    command("say 真是横的怕不要命的。");
    command("sigh");
    message("sound", "\n白玉堂身形一转，架起一朵莲花飞上天空。。。\n\n", environment());
  }

  destruct(this_object());
}
