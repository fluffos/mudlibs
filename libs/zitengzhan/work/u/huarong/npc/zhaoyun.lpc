  set("long",
    "他就是常山赵子龙，有万夫不挡之勇。\n");
  set("title", HIG "常山" NOR);
  set("gender", "男性");
  set("age", 20);
  //       set("class", "swordsman");
  set("attitude", "friendly");
  set("per", 160);
  set("int", 30);
  set("max_kee", 10000);
  set("max_sen", 10000);
  set("force", 14000);
  set("max_force", 7000);
  set("force_factor", 200);
  set("max_mana", 20000);
  set("mana", 20000);
  set("mana_factor", 1000);
  set("combat_exp", 50000000);
  set("daoxing", 50000000);
  set("eff_dx", 200000);
  set("nkgain", 350);

  set_skill("literate", 500);
  set_skill("unarmed", 500);
  set_skill("dodge", 500);
  set_skill("force", 500);
  set_skill("parry", 500);
  set_skill("sword", 500);
  set_skill("whip", 500);
  set_skill("spells", 500);
  set_skill("literate", 500);
  set_skill("archery", 500);
  set_skill("mace", 500);
  set_skill("changquan", 500);
  set_skill("yanxing-steps", 500);
  set_skill("lengquan-force", 500);
  set_skill("jinglei-mace", 500);
  set_skill("wusi-mace", 500);
  set_skill("bawang-qiang", 500);
  set_skill("xuanyuan-archery", 500);
  set_skill("spear", 500);
  set_skill("axe", 500);
  set_skill("baguazhou", 500);
  set_skill("spells", 500);
  set_skill("sanban-axe", 500);
  map_skill("force", "lengquan-force");
  map_skill("unarmed", "changquan");
  map_skill("spells", "baguazhou");
  map_skill("axe", "sanban-axe");
  map_skill("parry", "bawang-qiang");
  map_skill("dodge", "yanxing-steps");
  map_skill("mace", "jinglei-mace");
  map_skill("spear", "bawang-qiang");
  map_skill("archery", "xuanyuan-archery");
  create_family("将军府", 1, "弟子");
  setup();
  carry_object("/d/npc/obj/mace.lpc");
  carry_object("/d/npc/obj/spear.lpc")->wield();
  carry_object("/d/npc/obj/axe.lpc");
  carry_object("/d/npc/obj/armor.lpc")->wear();
  carry_object("/d/npc/obj/magua.lpc")->wear();
}



void kill_ob(object ob) {
  set_temp("my_killer", ob);
  remove_call_out("check");
  call_out("check", 1);
  ::kill_ob(ob);
}

void check() {
  object ob = this_object(), newnew, target;
  object ghost;
  object me = query_temp("my_killer");
  int i = random(10), j = random(10);
  if (!me) return;
  if (!present(me, environment()) || !ob->is_fighting() || !me->is_fighting(ob)) {
    remove_call_out("check");
    return;
  }
  if (me->is_busy()) {
    command("exert recover");
    command("jiali max");
    command("wield mace");
    map_skill("mace", "jinglei-mace");
    command("perform tian");
    command("unwield mace");
    if (i < 5) {
      command("wield spear");
      command("perform meihua");
    } else if (i < 8) {
      command("wield axe");
      command("perform sanban");
      command("perform sanban");
    } else {
      command("wield mace");
      map_skill("mace", "wusi-mace");
      command("perform andu");
    }
    remove_call_out("check");
    call_out("check", 1);
  }
  if (!me->is_busy()) {
    if (j < 3) {
      command("unwield spear");
      command("unwield axe");
      command("exert recover");
      command("wield mace");
      map_skill("mace", "wusi-mace");
      command("perform suo");
      remove_call_out("check");
      call_out("check", 2);
    } else if (j < 7) {
      command("unwield spear");
      command("unwield axe");
      command("unwield mace");
      command("exert recover");
      newnew = new("/u/huarong/npc/rain_seal.lpc");
      newnew->move(ob);
      //         newnew->set("owned",ob->query("id"));
      target = offensive_target(ob);
      command("ji rain seal on " + target->query("id"));
      remove_call_out("check");
      call_out("check", 2);
    } else {
      command("unwield spear");
      command("unwield axe");
      command("exert recover");
      command("unwield mace");
      command("perform zhiqi");
      remove_call_out("check");
      call_out("check", 2);
    }
  }


}


void unconcious() {
  die();
}

void die() {
  if (environment()) {
    command("say 真是横的怕不要命的。");
    command("sigh");
    message("sound", "\n身形一转，架起一朵莲花飞上天空。。。\n\n", environment());
  }
  destruct(this_object());
}
