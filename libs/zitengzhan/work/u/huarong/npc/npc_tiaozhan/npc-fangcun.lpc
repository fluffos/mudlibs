//fangcun妖怪for rulaitask难度四
//huarong 2003
#include <ansi.h>
inherit "/u/huarong/npc/npc_tiaozhan/npc_cjnpc.lpc";

void set_skills(int max_value, int level)
{
        int guai_value;
        ::set_skills(max_value, level);
        
        guai_value = max_value+max_value/4;
        set_skill("jiuyin-xinjing", guai_value+random(16));
        set_skill("stick", guai_value+random(16));
        set_skill("dao", guai_value+random(16));
        set_skill("puti-zhi", guai_value+random(16));
        set_skill("sword", guai_value+random(16));
        set_skill("liangyi-sword", guai_value+random(16));
        set_skill("wuxiangforce", guai_value+random(16));
        set_skill("qianjun-bang", guai_value+random(16));
        set_skill("jindouyun", guai_value+random(16));
        set("fangcun/panlong_accept","done");
        map_skill("spells", "dao");
        map_skill("unarmed", "puti-zhi");
        map_skill("force", "wuxiangforce");
        map_skill("stick", "qianjun-bang");
        map_skill("parry", "qianjun-bang");
        map_skill("dodge", "jindouyun");
        map_skill("sword", "liangyi-sword");
        create_family("方寸山三星洞", 1, "弟子");
        carry_object("/d/obj/cloth/shoupiqun.lpc")->wear();
        carry_object("/d/obj/weapon/sword/mujian.lpc");
        carry_object("/d/obj/weapon/stick/shuzhi.lpc")->wield();
        
}
   
void kill_ob(object ob)
{
  set_temp("my_killer",ob);
  remove_call_out("check");
  call_out("check",1);
  ::kill_ob(ob);
}

void check()
{
        object ob=this_object();
        object me=query_temp("my_killer");
        if( ! present(me,environment()) || !me->is_fighting(ob) ) me=offensive_target(ob);
        if( ! me ) return;
   if(! present(me,environment()) ||!ob->is_fighting()|| !me->is_fighting())
     {
     remove_call_out("check");
     return;
     }                               
      if(!ob->query_temp("jldl")) command("exert jldl");
        command("enforce max");
        command("enchant max");
        remove_call_out("check2");
        call_out("check2",0);
  if(me->is_busy())
    {   
        command("unwield sword");
        command("wield stick");
        command("exert recover");
        command("perform pili on "+me->query("id"));
        command("perform qiankun on "+me->query("id"));
if (random(10)>3) {
        command("perform wu on "+me->query("id"));
      }
else  {
        command("cast light on "+me->query("id"));
          }
        remove_call_out("check");
        call_out("check",3);
    }
  if(!me->is_busy())
    {
        command("unwield stick");
        command("wield sword");
        command("exert recover");
        command("perform yin on "+me->query("id"));
        remove_call_out("check");
        call_out("check",2);

    }
   if ( ob->is_fighting()&& !ob->is_busy())
      {   if (  (ob->query("eff_kee")) <  (ob->query("max_kee") / 2) )
             {
               command("say 逼我出绝招啊。");
               command("say 让你见识一下盘龙的威力！");
               command("unwield sword");
               command("wield stick");
               command("perform panlong on "+me->query("id"));
              }
       }

}
      


