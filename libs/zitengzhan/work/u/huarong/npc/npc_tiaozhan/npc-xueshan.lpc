//xueshan妖怪for rulaitask难度四
//huarong 2003
#include <ansi.h>
inherit "/u/huarong/npc/npc_tiaozhan/npc_cjnpc.lpc";

void set_skills(int max_value, int level) {
  int guai_value;
  ::set_skills(max_value, level);

  guai_value = max_value + max_value / 4;

  set_skill("cuixin-zhang", guai_value + random(16));
  set_skill("xiaoyaoyou", guai_value + random(16));
  set_skill("sword", guai_value + random(16));
  set_skill("bainiao-jian", guai_value + random(16));
  set_skill("blade", guai_value + random(16));
  set_skill("bingpo-blade", guai_value + random(16));
  set_skill("throwing", guai_value + random(16));
  set_skill("ningxie-force", guai_value + random(16));
  set_skill("dengxian-dafa", guai_value + random(16));
  map_skill("spells", "dengxian-dafa");
  map_skill("force", "ningxie-force");
  map_skill("unarmed", "cuixin-zhang");
  map_skill("sword", "bainiao-jian");
  map_skill("parry", "bainiao-jian");
  map_skill("blade", "bingpo-blade");
  map_skill("dodge", "xiaoyaoyou");
  map_skill("throwing", "bainiao-jian");
  create_family("大雪山", 1, "弟子");
  carry_object("/d/obj/cloth/shoupiqun.lpc")->wear();
  carry_object("/d/obj/weapon/blade/iceblade");
  carry_object("/d/obj/weapon/sword/fenghuangqin")->wield();
}

void kill_ob(object ob) {
  set_temp("my_killer", ob);
  remove_call_out("check");
  call_out("check", 1);
  ::kill_ob(ob);
}

void check() {
  object ob = this_object(), newnew;
  object me = query_temp("my_killer");

  int i, j;
  i = random(10);
  j = random(10);
  if (!present(me, environment()) || !me->is_fighting(ob)) me = offensive_target(ob);
  if (!me) return;
  if (!present(me, environment()) || !ob->is_fighting() || !me->is_fighting()) {
    remove_call_out("check");
    return;
  }
  command("enforce max");
  command("enchant max");
  remove_call_out("check2");
  call_out("check2", 0);

  if (me->is_busy()) {
    command("unwield sword");
    command("unwield blade");
    command("perform cuixin on " + me->query("id"));
    command("wield sword");
    command("exert recover");
    newnew = new("/u/huarong/npc/kongqueling.lpc");
    newnew->move(ob);
    command("install kongque ling");
    command("perform feijian on " + me->query("id"));
    command("perform chaofeng on " + me->query("id"));
    if (i < 5) {
      command("enforce 100");
      command("perform fenghuang on " + me->query("id"));
    } else if (i < 8) {
      command("unwield sword");
      command("wield blade");
      command("perform ningxie on " + me->query("id"));
      command("perform baoxue on " + me->query("id"));
    } else {
      command("cast tuntian on " + me->query("id"));
    }
    remove_call_out("check");
    call_out("check", 3);
  }
  if (!me->is_busy()) {
    if (j < 5) {
      command("unwield blade");
      command("exert recover");
      command("perform chaofeng on " + me->query("id"));
    } else {
      command("cast juanbi on " + me->query("id"));
    }
    remove_call_out("check");
    call_out("check", 3);

  }
  if (ob->is_fighting() && !ob->is_busy()) {
    if ((ob->query("eff_kee")) < (ob->query("max_kee") / 2)) {
      command("cast niepan");
    }
  }

}
