//hell妖怪for rulaitask难度四
//huarong 2003
#include <ansi.h>
inherit "/u/huarong/npc/npc_tiaozhan/npc_cjnpc.lpc";

void set_skills(int max_value, int level)
{
        int guai_value;
        ::set_skills(max_value, level);
        
        guai_value = max_value+max_value/4;
        set_skill("whip", guai_value+random(16));
        set_skill("hellfire-whip", guai_value+random(16));
        set_skill("tonsillit", guai_value+random(16));
        set_skill("ghost-steps", guai_value+random(16));
        set_skill("gouhunshu", guai_value+random(16));
        set_skill("jinghun-zhang", guai_value+random(16));
        set_skill("kusang-bang", guai_value+random(16));
        set_skill("zhuihun-sword", guai_value+random(16));
        set_skill("sword", guai_value+random(16));
        set_skill("stick", guai_value+random(16));
        map_skill("force", "tonsillit");
        map_skill("unarmed", "jinghun-zhang");
        map_skill("dodge", "ghost-steps");
        map_skill("spells", "gouhunshu");
        map_skill("parry", "hellfire-whip");
        map_skill("whip", "hellfire-whip");
        map_skill("sword", "zhuihun-sword");
        map_skill("stick", "kusang-bang");
        create_family("阎罗地府", 1, "弟子");
        carry_object("/d/obj/cloth/shoupiqun.lpc")->wear();
         carry_object("/d/obj/weapon/sword/mujian.lpc");
         carry_object("/d/obj/weapon/whip/wuchou.lpc")->wield();
         carry_object("/d/obj/weapon/stick/shuzhi.lpc");
}
   
void kill_ob(object ob)
{
  set_temp("my_killer",ob);
  remove_call_out("check");
  call_out("check",1);
  ::kill_ob(ob);
}

void check()
{
        object ob=this_object();
        object me=query_temp("my_killer");

        if( ! present(me,environment()) || !me->is_fighting(ob) ) me=offensive_target(ob);
        if( ! me ) return;
   if(! present(me,environment()) ||!ob->is_fighting()|| !me->is_fighting())
     {
     remove_call_out("check");
     return;
     }
        command("enforce max");
        command("enchant max");
        remove_call_out("check2");
        call_out("check2",0);                               
 if(me->is_busy())
    {   
        command("exert recover");
        command("unwield sword");
        command("wield whip");
        command("perform ldlh");
        command("perform three on "+me->query("id"));
        command("perform xingyun on "+me->query("id"));
        command("unwield whip");
        command("wield sword");
        command("perform yanluo on "+me->query("id"));
        remove_call_out("check");
        call_out("check",5);
    }
  if(!me->is_busy())
    {
        command("unwield whip");
        command("exert recover");
        command("perform zhua on "+me->query("id"));
        remove_call_out("check");
        call_out("check",3);

    }
}
      


