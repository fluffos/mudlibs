//huarong 2003.4 for cjnpc
inherit "/u/huarong/npc/cjnpc.lpc";
#include <ansi.h>

void create() {
  set_name(YEL "黄飞虎" NOR, ({ "huang feihu", "huang", "feihu" }));
  set("long", @LONG
开国武成王黄飞虎，兴周第一大将，封神榜
上五岳之首东岳泰山大齐仁圣大帝，下凡寻
找其五色神牛的下落。
LONG);
  set("title", HIR "东岳泰山大齐仁圣大帝" NOR);
  set("gender", "男性");
  set("age", 50 + random(30));
  set("attitude", "friendly");
  set("kar", 40);
  set("max_kee", 10000);
  set("max_sen", 10000);
  set("force", 14000);
  set("max_force", 7000);
  set("force_factor", 300);
  set("max_mana", 20000);
  set("mana", 20000);
  set("mana_factor", 1000);
  set("combat_exp", 50000000);
  set("daoxing", 50000000);
  set("eff_dx", 200000);
  set("nkgain", 350);

  set_skill("spear", 500);
  set_skill("force", 500);
  set_skill("dodge", 500);
  set_skill("stick", 500);
  set_skill("literate", 500);
  set_skill("dali-bang", 500);
  set_skill("huoyun-qiang", 500);
  set_skill("parry", 500);
  set_skill("unarmed", 500);
  set_skill("wuyue-spear", 500);
  set_skill("spells", 500);
  set_skill("pingtian-dafa", 500);
  set_skill("moshenbu", 500);
  set_skill("huomoforce", 500);
  set_skill("moyun-shou", 500);
  map_skill("force", "huomoforce");
  map_skill("spells", "pingtian-dafa");
  map_skill("unarmed", "moyun-shou");
  map_skill("spear", "wuyue-spear");
  map_skill("parry", "wuyue-spear");
  map_skill("stick", "dali-bang");
  map_skill("dodge", "moshenbu");
  create_family("火云洞", 1, "弟子");
  setup();
  carry_object("/d/obj/cloth/baipao")->wear();
  carry_object("/d/obj/weapon/spear/huaji2")->wield();
  carry_object("/d/obj/weapon/stick/shuzhi");
}


void kill_ob(object ob) {
  set_temp("my_killer", ob);
  remove_call_out("check");
  call_out("check", 1);
  ::kill_ob(ob);
}

void check() {
  object ob = this_object(), newnew;
  object ghost;
  object me = query_temp("my_killer");
  int i, j;
  i = random(10);
  j = random(10);

  if (!me) return;
  if (!present(me, environment()) || !ob->is_fighting() || !me->is_fighting()) {
    remove_call_out("check");
    return;
  }
  command("enforce max");
  command("enchant max");
  command("exert recover");
  command("unwield spear");
  command("wield stick");
  command("perform shenli");
  command("unwield stick");
  command("perform zhangxinlei on " + me->query("id"));
  if (me->is_busy()) {
    if (i < 4) {
      command("wield spear");
      command("perform fengchan on " + me->query("id"));
    } else if (i < 6) {
      command("wield spear");
      command("perform buhui on " + me->query("id"));
    } else if (i < 8) {
      command("wield stick");
      command("perform baiyun on " + me->query("id"));
    } else {
      command("cast sanmei on " + me->query("id"));
    }
    remove_call_out("check");
    call_out("check", 3);
  }
  if (!me->is_busy()) {
    if (j < 5) {
      command("wield spear");
      command("perform buhui on " + me->query("id"));
    } else {
      command("wield spear");
      command("perform fengchan on " + me->query("id"));
    }
    remove_call_out("check");
    call_out("check", 2);

  }
}


void unconcious() {
  die();
}

void die() {
  if (environment()) {
    command("say 真是横的怕不要命的。");
    command("sigh");
    message("sound", "\n身形一转，架起一朵莲花飞上天空。。。\n\n", environment());
  }

  destruct(this_object());


}
