//大荒十大妖女之首－－龙女 雨师妾
inherit "/u/huarong/npc/cjnpc.lpc";
#include <ansi.h>

void create()
{
       set_name(MAG"雨师妾"NOR, ({"yushi qie", "yushi", "qie"}));
       set("long",
"她就是拥有颠倒众生的绝世容颜的大荒十大妖女之首－－龙女 雨师妾。\n");
       set("title", HIC"龙女"NOR);
       set("gender", "女性");
       set("age", 20);
       set("attitude", "friendly");
       set("per", 160);
       set("int", 30);
       set("max_kee", 10000);
       set("max_sen", 10000);
       set("force", 14000);
       set("max_force", 7000);
       set("force_factor", 200);
       set("max_mana", 20000);
       set("mana", 20000);
       set("mana_factor", 1000);
       set("combat_exp", 50000000);
       set("daoxing", 50000000);
       set("eff_dx", 200000);
       set("nkgain", 350);

       set_skill("literate", 500);
       set_skill("unarmed", 500);
       set_skill("dodge", 500);
       set_skill("force", 500);
       set_skill("parry", 500);
       set_skill("spells", 500);
       set_skill("literate", 500);
       set_skill("huntian-hammer", 500);
        set_skill("hammer", 500);
        set_skill("literate", 500);
       set_skill("fork", 500);
        set_skill("seashentong", 500);
        set_skill("dragonfight", 551);
        set_skill("dragonforce", 500);
        set_skill("fengbo-cha", 500);
        set_skill("dragonstep", 500);
        map_skill("hammer", "huntian-hammer");
        map_skill("spells", "seashentong");
        map_skill("unarmed", "dragonfight");
        map_skill("force", "dragonforce");
        map_skill("fork", "fengbo-cha");
        map_skill("parry", "fengbo-cha");
        map_skill("dodge", "dragonstep");
create_family("东海龙宫", 1, "弟子");
setup();
        carry_object("/d/moon/obj/luoyi")->wear();
        carry_object("/d/npc/obj/fork.lpc");
}



void kill_ob(object ob)
{
  set_temp("my_killer",ob);
  remove_call_out("check");
  call_out("check",1);
  ::kill_ob(ob);
}

void check()
{
        object ob=this_object();
        object ghost;
        object me=query_temp("my_killer");
        int i=random(10);
        if( ! me ) return ;
   if(! present(me,environment()) ||!ob->is_fighting()||!me->is_fighting(ob))
     {
     remove_call_out("check");
     return;
     }                               
     remove_call_out("check2");
     call_out("check2",0);
  if(me->is_busy())
    {   
        command("unwield fork");
        command("exert recover");
        command("jiali max");
    if (i<2)
           {
            command("perform sheshen");
           }
    else if(i<7)
           {
            command("perform shenglong");
           }
    else if(i<9)
           {
            command("perform leidong");
           }
    else
           {
            command("cast water");
           }
     remove_call_out("check");
        call_out("check",1);
    }
  if(!me->is_busy())
    {
        command("wield fork");
        command("exert recover");
        command("perform fengbo");
     remove_call_out("check");
       call_out("check",1);

    }

}
      

void unconcious()
{
  die();
}

void die()
{
        if( environment() ) {
      command("say 真是横的怕不要命的。");
       command("sigh");
      message("sound", "\n身形一转，架起一朵莲花飞上天空。。。\n\n", environment());
       }
       destruct(this_object());
}


