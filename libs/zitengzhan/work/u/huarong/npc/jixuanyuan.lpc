  carry_object("/d/npc/obj/sword.lpc")->wield();
  carry_object("/d/npc/obj/armor.lpc")->wear();
  carry_object("/d/npc/obj/magua.lpc")->wear();
}



void kill_ob(object ob) {
  set_temp("my_killer", ob);
  remove_call_out("check");
  call_out("check", 1);
  ::kill_ob(ob);
}

void check() {
  object ob = this_object();
  object ghost;
  object me = query_temp("my_killer");
  int k;

  if (!me) return;
  if (!present(me, environment()) || !ob->is_fighting() || !me->is_fighting(ob)) {
    remove_call_out("check");
    return;
  }
  if (me->is_busy()) {
    command("unwield spear");
    command("unwield blade");
    command("unwield stick");
    command("jiali max");
    ob->set("family/family_name", "将军府");
    map_skill("force", "lengquan-force");
    map_skill("spells", "baguazhou");
    map_skill("spear", "bawang-qiang");
    command("wield mace");
    command("perform tian");
    command("unwield mace");
    command("wield whip");
    ob->set("family/family_name", "阎罗地府");
    map_skill("stick", "kusang-bang");
    command("perform three");
    command("unwield whip");
    ob->set("family/family_name", "蜀山派");
    map_skill("sword", "yujianshu");
    command("wield sword");
    command("perform wanjian");
    command("unwield sword");
    command("exert recover");
    k = random(10);
    if (k > 8) {
      ob->set("family/family_name", "火云洞");
      map_skill("spear", "wuyue-spear");
      command("wield spear");
      command("perform fengchan");
      command("cast sanmei");
    } else if (k > 3) {
      ob->set("family/family_name", "方寸山三星洞");
      map_skill("stick", "qianjun-bang");
      command("wield stick");
      command("perform panlong");
      command("cast light");
    } else {
      ob->set("family/family_name", "南海普陀山");
      map_skill("spells", "buddhism");
      command("cast bighammer");
    }
    remove_call_out("check");
    call_out("check", 1);
  }
  if (!me->is_busy()) {
    command("unwield sword");
    command("unwield spear");
    command("unwield stick");
    command("wield blade");
    command("exert recover");
    ob->set("family/family_name", "陷空山无底洞");
    command("perform pozhan");
    remove_call_out("check");
    call_out("check", 2);

  }
  ob->set("family/family_name", "昆仑山玉虚洞");
  map_skill("force", "xuanzong-force");
  map_skill("spells", "yuxu-spells");

}



void unconcious() {
  die();
}

void die() {
  if (environment()) {
    command("say 真是横的怕不要命的。");
    command("sigh");
    message("sound", "\n黄帝身形一转，架起一朵莲花飞上天空。。。\n\n", environment());
  }
  destruct(this_object());
}
