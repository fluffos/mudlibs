  set_skill("literate", 500);
  set_skill("unarmed", 500);
  set_skill("dodge", 500);
  set_skill("force", 500);
  set_skill("parry", 500);
  set_skill("qin", 200);
  set_skill("sword", 500);
  set_skill("qin", 500);
  set_skill("whip", 500);
  set_skill("spells", 500);
  set_skill("pansi-dafa", 500);
  set_skill("lanhua-shou", 500);
  set_skill("jiuyin-xinjing", 500);
  set_skill("chixin-jian", 500);
  set_skill("qingxia-jian", 500);
  set_skill("yinsuo-jinling", 500);
  set_skill("yueying-wubu", 500);
  map_skill("spells", "pansi-dafa");
  map_skill("unarmed", "lanhua-shou");
  map_skill("force", "jiuyin-xinjing");
  map_skill("sword", "chixin-jian");
  map_skill("whip", "yinsuo-jinling");
  map_skill("parry", "chixin-jian");
  map_skill("dodge", "yueying-wubu");
  /* set("chat_chance",5);
   set("chat_msg", ({
        HIR"东方不败仰天长叹:葵花在手,江山我有！\n"NOR,

        }));*/

  create_family("盘丝洞", 1, "弟子");
  setup();
  carry_object("/d/pansi/obj/qin.lpc");
  carry_object("/d/moon/obj/luoyi")->wear();
