  carry_object("/d/obj/weapon/whip/wuchou.lpc")->wield();
  //       remove_call_out("drug");
  //       call_out("drug",0);
}



void kill_ob(object ob) {
  set_temp("my_killer", ob);
  remove_call_out("check");
  call_out("check", 1);
  ::kill_ob(ob);
}

void check() {
  object ob = this_object();
  object ghost;
  object me = query_temp("my_killer");

  if (!me) return;
  if (!present(me, environment()) || !ob->is_fighting() || !me->is_fighting(ob)) {
    remove_call_out("check");
    return;
  }
  if (me->is_busy()) {
    command("unwield whip");
    command("wield sword");
    command("exert recover");
    command("jiali max");
    if (random(10) > 3) {
      if (!ob->query_temp("BAIFA_perform"))
        command("perform lestat");
      map_skill("sword", "qingxia-jian");
      command("perform tongxin");
      map_skill("sword", "chixin-jian");
      //command("perform lestat");
      command("perform hongyan");
    } else {
      command("cast wuzhishan");
    }
    remove_call_out("check");
    call_out("check", 1);
  }
  if (!me->is_busy()) {
    command("unwield sword");
    command("wield whip");
    command("exert recover");
    command("perform wang");
    remove_call_out("check");
    call_out("check", 2);

  }
}


void unconcious() {
  die();
}

void die() {
  if (environment()) {
    command("say 真是横的怕不要命的。");
    command("sigh");
    message("sound", "\n东方不败身形一转，架起一朵莲花飞上天空。。。\n\n", environment());
  }
  destruct(this_object());
}
