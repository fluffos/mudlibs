//huarong 2003.4 for cjnpc
inherit "/u/huarong/npc/cjnpc.lpc";
#include <ansi.h>

void create() {
  set_name(HIW "独孤求败" NOR, ({ "dugu qiubai", "dugu", "qiubai" }));
  set("long",
    "剑魔独孤求败是也，剑术超一流。\n");
  set("title", HBMAG "剑魔" NOR);
  set("gender", "男性");
  set("age", 50);
  set("class", "swordman");
  set("attitude", "friendly");
  set("per", 40);
  set("int", 30);
  set("max_kee", 10000);
  set("max_sen", 10000);
  set("force", 14000);
  set("max_force", 7000);
  set("force_factor", 300);
  set("max_mana", 20000);
  set("mana", 20000);
  set("mana_factor", 1000);
  set("combat_exp", 50000000);
  set("daoxing", 50000000);
  set("eff_dx", 200000);
  set("nkgain", 350);
  set("faith", 1000);

  set_skill("unarmed", 500);
  set_skill("mindsword", 500);
  set_skill("dodge", 500);
  set_skill("parry", 500);
  set_skill("literate", 500);
  set_skill("spells", 500);
  set_skill("force", 500);
  set_skill("zixia-shengong", 500);
  set_skill("sevensteps", 500);
  set_skill("taoism", 500);
  set_skill("hunyuan-zhang", 500);
  set_skill("yujianshu", 500);
  set_skill("canxin-jian", 500);
  set_skill("sword", 500);

  map_skill("force", "zixia-shengong");
  map_skill("unarmed", "hunyuan-zhang");
  map_skill("dodge", "sevensteps");
  map_skill("spells", "taoism");
  map_skill("parry", "mindsword");
  map_skill("sword", "mindsword");

  create_family("蜀山派", 1, "弟子");
  setup();
  carry_object("/d/obj/cloth/baipao")->wear();
  carry_object("/d/obj/weapon/sword/zhujian.lpc")->wield();
}


void kill_ob(object ob) {
  set_temp("my_killer", ob);
  remove_call_out("check");
  call_out("check", 1);
  ::kill_ob(ob);
}

void check() {
  object ob = this_object();
  object ghost;
  object me = query_temp("my_killer");

  if (!me) return;
  if (!present(me, environment()) || !ob->is_fighting() || !me->is_fighting()) {
    remove_call_out("check");
    return;
  }
  if (me->is_busy()) {
    command("wield sword");
    command("jiali max");
    command("exert recover");
    map_skill("sword", "yujianshu");
    command("perform wanjian");
    map_skill("sword", "canxin-jian");
    command("perform xiangsi");
    remove_call_out("check");
    call_out("check", 5);
  }
  if (!me->is_busy()) {
    command("unwield sword");
    command("exert recover");
    command("perform fenguang");
    command("wield sword");
    map_skill("sword", "mindsword");
    map_skill("parry", "mindsword");
    command("perform jianqi");
    remove_call_out("check");
    call_out("check", 3);

  }
}


void unconcious() {
  die();
}
void die() {
  if (environment()) {
    command("say 真是横的怕不要命的。");
    command("sigh");
    message("sound", "\n独孤求败身形一转，架起一朵莲花飞上天空。。。\n\n", environment());
  }

  destruct(this_object());
}
