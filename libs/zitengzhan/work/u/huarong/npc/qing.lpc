//huarong 2003.4 for cjnpc
inherit "/u/huarong/npc/cjnpc.lpc";
#include <ansi.h>

void create()
{
       set_name(HIG"清风"NOR, ({"qing feng", "qing", "feng"}));
       set("title", HIG"五庄观"NOR);
       set("gender", "男性");
       set("age", 15+random(10));
       set("attitude", "friendly");
       set("kar", 40);
       set("max_kee", 10000);
       set("max_sen", 10000);
       set("force", 14000);
       set("max_force", 7000);
       set("force_factor", 300);
       set("max_mana", 20000);
       set("mana", 20000);
       set("mana_factor", 1000);
       set("combat_exp", 50000000);
       set("daoxing", 50000000);
       set("eff_dx", 200000);
       set("nkgain", 350);

   set_skill("unarmed", 500);
   set_skill("wuxing-quan", 500);
   set_skill("dodge", 500);
   set_skill("baguazhen", 500);
   set_skill("parry", 500);
   set_skill("sword", 500);
   set_skill("sanqing-jian", 500);
   set_skill("xiaofeng-sword", 500);
   set_skill("staff", 500);
   set_skill("fumo-zhang", 500);
   set_skill("hammer", 500);
   set_skill("kaishan-chui", 500);
   set_skill("blade", 500);
   set_skill("yange-blade", 500);
   set_skill("force", 500);   
   set_skill("zhenyuan-force", 500);
   set_skill("literate", 500);
   set_skill("spells", 500);
   set_skill("taiyi", 500);
   map_skill("spells", "taiyi");
   map_skill("force", "zhenyuan-force");
   map_skill("unarmed", "wuxing-quan");
   map_skill("sword", "xiaofeng-sword");
   map_skill("parry", "xiaofeng-sword");
   map_skill("dodge", "baguazhen");
   map_skill("staff", "fumo-zhang");
   map_skill("blade", "yange-blade");
   map_skill("hammer", "kaishan-chui");

create_family("五庄观", 1, "弟子");
setup();
  carry_object("/d/obj/cloth/baipao")->wear();
  carry_object("/d/obj/weapon/sword/zhujian")->wield();
}


void kill_ob(object ob)
{
  set_temp("my_killer",ob);
  remove_call_out("check");
  call_out("check",1);
  ::kill_ob(ob);
}

void check()
{
        object ob=this_object(),newnew;
        object ghost;
        object me=query_temp("my_killer");
        int i,j;
        i=random(10);
        j=random(10);

        if( ! me ) return ;
   if(! present(me,environment()) ||!ob->is_fighting()|| !me->is_fighting())
     {
     remove_call_out("check");
     return;
     }                               
     remove_call_out("check2");
     call_out("check2",0);
 if(me->is_busy())
    {   
        command("enforce max");
        command("exert recover");
        map_skill("sword", "sanqing-jian");
        command("wield sword");
        if(!ob->query_temp("jianmang"))  command("perform jianmang");
        command("perform jianzhang");
    if (i<5)
           {
        command("perform sanqing");
           }
    else if(i<8)
           {
        map_skill("sword", "xiaofeng-sword");
        command("perform huichang");
           }
    else
           {
         command("cast zhenhuo");
            }
        remove_call_out("check");
        call_out("check",3);
    }
  if(!me->is_busy())
    {
    if (j<7)
           {
        map_skill("sword", "sanqing-jian");
        command("wield sword");
        if(!ob->query_temp("jianmang"))  command("perform jianmang");
        command("perform jianzhang");
        map_skill("sword", "xiaofeng-sword");
        command("perform huichang");
           }
    else
           {
        command("enchant max");
        command("cast sanqing");
            }
        remove_call_out("check");
        call_out("check",2);

    }
}
      

void unconcious()
{
  die();
}

void die()
{
        if( environment() ) {
        command("say 真是横的怕不要命的。");
        command("sigh");
        message("sound", "\n身形一转，架起一朵莲花飞上天空。。。\n\n", environment());
    }

        destruct(this_object());


}


