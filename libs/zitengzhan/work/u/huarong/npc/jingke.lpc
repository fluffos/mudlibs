  set("long",
    "他就是行刺秦王的刺客。\n");
  set("title", HIG "易水寒" NOR);
  set("gender", "男性");
  set("age", 20);
  //       set("class", "swordsman");
  set("attitude", "friendly");
  set("per", 30);
  set("kar", 40);
  set("int", 30);
  set("max_kee", 10000);
  set("max_sen", 10000);
  set("force", 14000);
  set("max_force", 7000);
  set("force_factor", 200);
  set("max_mana", 20000);
  set("mana", 20000);
  set("mana_factor", 1000);
  set("combat_exp", 50000000);
  set("daoxing", 50000000);
  set("eff_dx", 200000);
  set("nkgain", 350);
  set("old_flag/jiandao", 9);

  set_skill("literate", 500);
  set_skill("unarmed", 500);
  set_skill("dodge", 500);
  set_skill("force", 500);
  set_skill("parry", 500);
  set_skill("sword", 500);
  set_skill("whip", 500);
  set_skill("spells", 500);
  set_skill("literate", 500);
  set_skill("binfen-steps", 500);
  set_skill("ice_fire_zhang", 500);
  set_skill("whip", 500);
  set_skill("butian-force", 500);
  set_skill("mysticism", 500);
  set_skill("wuwei-fuchen", 500);
  set_skill("spysword", 500);
  map_skill("dodge", "binfen-steps");
  map_skill("parry", "spysword");
  map_skill("sword", "spysword");
  map_skill("force", "butian-force");
  map_skill("spells", "mysticism");
  map_skill("unarmed", "ice_fire_zhang");
  map_skill("whip", "wuwei-fuchen");
  create_family("三界散仙", 1, "弟子");
  setup();
  carry_object("/d/npc/obj/magua.lpc")->wear();
  carry_object("/d/npc/obj/sword2.lpc");
  carry_object("/d/npc/obj/whip.lpc")->wield();
}



void kill_ob(object ob) {
  set_temp("my_killer", ob);
  remove_call_out("check");
  call_out("check", 1);
  ::kill_ob(ob);
}

void check() {
  object ob = this_object();
  object ghost;
  object me = query_temp("my_killer");
  int i = random(10), j = random(10);
  if (!me) return;
  if (!present(me, environment()) || !ob->is_fighting() || !me->is_fighting(ob)) {
    remove_call_out("check");
    return;
  }
  remove_call_out("check2");
  call_out("check2", 0);
  if (me->is_busy()) {
    command("unwield whip");
    command("exert recover");
    command("jiali max");
    if (i < 4) {
      command("wield sword");
      command("perform dunnoname");
    } else if (i < 6) {
      command("wield sword");
      command("perform dunnotruth");
    } else if (i < 8) {
      command("wield sword");
      command("perform bishou");
    } else {
      command("cast gold");
    }
    remove_call_out("check");
    call_out("check", 1);
  }
  if (!me->is_busy()) {
    command("unwield sword");
    command("unwield whip");
    command("exert recover");
    command("jiali max");
    command("perform icefire");
    remove_call_out("check");
    call_out("check", 2);

  }


}


void unconcious() {
  die();
}

void die() {
  if (environment()) {
    command("say 真是横的怕不要命的。");
    command("sigh");
    message("sound", "\n身形一转，架起一朵莲花飞上天空。。。\n\n", environment());
  }
  destruct(this_object());
}
