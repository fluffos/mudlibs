//huarong 2003.4 for cjnpc
inherit "/u/huarong/npc/cjnpc.lpc";
#include <ansi.h>

void create() {
  set_name(HIY "鲁智深" NOR, ({ "nu zhishen", "nu", "zhishen" }));
  set("long",
    "“花和尚”鲁智深。\n");
  set("title", HIG "花和尚" NOR);
  set("gender", "男性");
  set("age", 20);
  set("class", "bonze");
  set("attitude", "friendly");
  set("kar", 40);
  set("max_kee", 10000);
  set("max_sen", 10000);
  set("force", 14000);
  set("max_force", 7000);
  set("force_factor", 300);
  set("max_mana", 20000);
  set("mana", 20000);
  set("mana_factor", 1000);
  set("combat_exp", 50000000);
  set("daoxing", 50000000);
  set("eff_dx", 200000);
  set("nkgain", 350);

  set_skill("literate", 500);
  set_skill("spells", 500);
  set_skill("buddhism", 500);
  set_skill("unarmed", 500);
  set_skill("jienan-zhi", 500);
  set_skill("dodge", 500);
  set_skill("lotusmove", 500);
  set_skill("parry", 500);
  set_skill("force", 500);
  set_skill("lotusforce", 500);
  set_skill("staff", 500);
  set_skill("lunhui-zhang", 500);
  map_skill("spells", "buddhism");
  map_skill("unarmed", "jienan-zhi");
  map_skill("dodge", "lotusmove");
  map_skill("force", "lotusforce");
  map_skill("parry", "lunhui-zhang");
  map_skill("staff", "lunhui-zhang");
  create_family("南海普陀山", 1, "弟子");
  setup();
  carry_object("/d/obj/cloth/baipao")->wear();
  carry_object("/d/obj/weapon/staff/muzhang")->wield();
  carry_object("/d/nanhai/obj/jingu-huarong");
}


void kill_ob(object ob) {
  set_temp("my_killer", ob);
  remove_call_out("check");
  call_out("check", 1);
  ::kill_ob(ob);
}

void check() {
  object ob = this_object(), newnew;
  object ghost;
  object me = query_temp("my_killer");
  int i;
  i = random(10);

  if (!me) return;
  if (!present(me, environment()) || !ob->is_fighting() || !me->is_fighting()) {
    remove_call_out("check");
    return;
  }
  if (me->is_busy()) {
    command("enforce max");
    command("enchant max");
    command("exert recover");
    if (i < 5) {
      command("wield staff");
      command("perform pudu");
    } else if (i < 8) {
      command("unwield staff");
      command("perform rulai");
    } else {
      command("cast bighammer");
    }
    remove_call_out("check");
    call_out("check", 3);
  }
  if (!me->is_busy()) {
    command("unwield staff");
    command("exert recover");
    command("perform lingxi");
    remove_call_out("check");
    call_out("check", 2);

  }
}


void unconcious() {
  die();
}

void die() {
  if (environment()) {
    command("say 真是横的怕不要命的。");
    command("sigh");
    message("sound", "\n身形一转，架起一朵莲花飞上天空。。。\n\n", environment());
  }

  destruct(this_object());


}
