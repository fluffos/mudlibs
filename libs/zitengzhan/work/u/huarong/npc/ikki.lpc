//huarong 2003.4 for cjnpc
inherit "/u/huarong/npc/cjnpc.lpc";
#include <ansi.h>

void create()
{
       set_name(HIC"一辉"NOR, ({"yi hui", "yi", "hui","ikki"}));
       set("long",
"她就是凤凰星座，不死鸟一辉。\n");
       set("title", HIW"不死鸟"NOR);
       set("gender", "男性");
       set("age", 20);
       set("class", "youling");
       set("attitude", "friendly");
       set("kar", 40);
       set("max_kee", 10000);
       set("max_sen", 10000);
       set("force", 14000);
       set("max_force", 7000);
       set("force_factor", 300);
       set("max_mana", 20000);
       set("mana", 20000);
       set("mana_factor", 1000);
       set("combat_exp", 50000000);
       set("daoxing", 50000000);
       set("eff_dx", 200000);
       set("nkgain", 350);

        set_skill("unarmed", 500);
        set_skill("cuixin-zhang", 500);
       set_skill("dodge", 500);
        set_skill("xiaoyaoyou", 500);
        set_skill("parry", 500);
       set_skill("sword", 500);
       set_skill("bainiao-jian", 500);
        set_skill("blade", 500);
        set_skill("bingpo-blade", 500);
        set_skill("throwing", 500);
       set_skill("force", 500);
        set_skill("ningxie-force", 500);
       set_skill("literate", 500);
        set_skill("spells", 500);
        set_skill("dengxian-dafa", 500);
        map_skill("spells", "dengxian-dafa");
        map_skill("force", "ningxie-force");
        map_skill("unarmed", "cuixin-zhang");
        map_skill("sword", "bainiao-jian");
        map_skill("parry", "bainiao-jian");
        map_skill("blade", "bingpo-blade");
        map_skill("dodge", "xiaoyaoyou");
        map_skill("throwing", "bainiao-jian");
create_family("大雪山", 1, "弟子");
setup();
  carry_object("/d/obj/cloth/baipao")->wear();
  carry_object("/d/obj/weapon/blade/jidao");
  carry_object("/d/obj/weapon/sword/fenghuangqin")->wield();
}


void kill_ob(object ob)
{
  set_temp("my_killer",ob);
  remove_call_out("check");
  call_out("check",1);
  ::kill_ob(ob);
}

void check()
{
        object ob=this_object(),newnew;
        object ghost;
        object me=query_temp("my_killer");
        int i,j;
        i=random(10);
        j=random(10);

        if( ! me ) return ;
   if(! present(me,environment()) ||!ob->is_fighting()|| !me->is_fighting())
     {
     remove_call_out("check");
     return;
     }                               
     remove_call_out("check2");
     call_out("check2",0);
 if(me->is_busy())
    {   
        command("unwield sword");
        command("unwield blade");
        command("perform cuixin");
        command("wield sword");
        command("enforce max");
        command("exert recover");
        newnew=new("/u/huarong/npc/kongqueling.lpc");
        newnew->move(ob); 
        command("install kongque ling");
        command("perform feijian");
        command("perform chaofeng");
    if (i<5)
           {
            command("enforce 100");
            command("perform fenghuang");
            command("enforce max");
           }
    else if(i<8)
           {
            command("unwield sword");
            command("wield blade");
            command("perform ningxie");
            command("perform baoxue");
           }
    else
           {
            command("cast tuntian");
            }
        remove_call_out("check");
        call_out("check",3);
    }
  if(!me->is_busy())
    {
        if(j<5)
        {
        command("unwield blade");
        command("exert recover");
        command("perform chaofeng");
         }
        else
         {
          command("cast juanbi");
          }
        remove_call_out("check");
        call_out("check",2);

    }
   if ( ob->is_fighting()&& !ob->is_busy())
      {   if (  (ob->query("eff_kee")) <  (ob->query("max_kee") / 2) )
             {
               command("cast niepan");
              }
       }

}
      

void unconcious()
{
  die();
}

void die()
{
        if( environment() ) {
        command("say 真是横的怕不要命的。");
       command("sigh");
      message("sound", "\n身形一转，架起一朵莲花飞上天空。。。\n\n", environment());
    }

        destruct(this_object());


}


