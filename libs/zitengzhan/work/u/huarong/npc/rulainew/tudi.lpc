//huarong 2003.4 for cjnpc
inherit "/u/huarong/npc/cjnpc.lpc";
#include <ansi.h>
string findyao();
string zhenjia();

void create() {
  set_name("土地", ({ "tu di", "tu", "di", "tudi" }));
  set("long",
    "一位白胡子老公公。\n");
  set("gender", "男性");
  set("age", 80 + random(100));
  set("class", "youling");
  set("title", "");
  set("attitude", "friendly");
  set("per", 10);
  set("int", 30);
  set("max_kee", 10000);
  set("max_sen", 10000);
  set("force", 14000);
  set("max_force", 7000);
  set("force_factor", 300);
  set("max_mana", 20000);
  set("mana", 20000);
  set("mana_factor", 1000);
  set("combat_exp", 50000000);
  set("daoxing", 50000000);
  set("eff_dx", 200000);
  set("nkgain", 350);

  set_skill("unarmed", 500);
  set_skill("whip", 500);
  set_skill("hellfire-whip", 500);
  set_skill("dodge", 500);
  set_skill("parry", 500);
  set_skill("literate", 500);
  set_skill("spells", 500);
  set_skill("force", 500);
  set_skill("tonsillit", 500);
  set_skill("ghost-steps", 500);
  set_skill("gouhunshu", 500);
  set_skill("jinghun-zhang", 500);
  set_skill("kusang-bang", 500);
  set_skill("zhuihun-sword", 500);
  set_skill("sword", 500);
  set_skill("stick", 500);

  map_skill("force", "tonsillit");
  map_skill("unarmed", "jinghun-zhang");
  map_skill("dodge", "ghost-steps");
  map_skill("spells", "gouhunshu");
  map_skill("parry", "hellfire-whip");
  map_skill("whip", "hellfire-whip");
  map_skill("sword", "zhuihun-sword");
  map_skill("stick", "kusang-bang");
  set("inquiry", ([
    "name": "土地！土地的土，土地的地。小神乃此处土地是也。",
    "yaoguai": (: findyao :),
    "妖怪": (: findyao :),
    "真假": (: zhenjia :),
    "zhenjia": (: zhenjia :),
  ]));

  create_family("阎罗地府", 1, "弟子");
  setup();
  carry_object("/d/obj/cloth/baipao")->wear();
  carry_object("/d/obj/weapon/whip/longsuo")->wield();
}

void init() {
  ::init();
  call_out("self_dest", 1800);
}

string findyao() {
  object me = this_player();
  if (!me->query_temp("rulaitask/escape")) return 0;
  call_out("self_dest", 2);
  return CYN + "好像往" + me->query("rulaitask/where1") + NOR + CYN + "方向去了吧。\n" NOR;
}

string zhenjia() {
  object me = this_player();
  object ob = this_object();
  if (!me->query_temp("rulaitask/ask1")) return 0;
  me->set_temp("rulaitask/ask2", 1);
  call_out("self_dest", 2);
  return "我也不知道谁是真的谁是假的，你们还是问别人吧。";
}

void kill_ob(object ob) {
  set_temp("my_killer", ob);
  remove_call_out("check");
  call_out("check", 1);
  ::kill_ob(ob);
}

void check() {
  object ob = this_object();
  object me = query_temp("my_killer");

  if (!me) return;
  if (!present(me, environment()) || !ob->is_fighting() || !me->is_fighting()) {
    remove_call_out("check");
    return;
  }
  if (me->is_busy()) {
    command("wield whip");
    command("jiali max");
    command("exert recover");
    command("perform ldlh");
    command("perform three");
    command("perform xingyun");
    remove_call_out("check");
    call_out("check", 5);
  }
  if (!me->is_busy()) {
    command("unwield whip");
    command("exert recover");
    command("perform zhua");
    remove_call_out("check");
    call_out("check", 3);

  }
}


void unconcious() {
  die();
}

void die() {
  if (environment()) {
    command("sigh");
    message("sound", "\n身形一转，化为一股清烟钻入地下。。。\n\n", environment());
  }

  destruct(this_object());


}

void self_dest() {

  object env = environment();

  remove_call_out("self_dest");
  if (env) {
    if (env->is_character()) {
      tell_object(env, "只见" + this_object()->query("name") + "身形一转，化为一股清烟钻入地下。。。\n");
    } else {
      tell_object(env, this_object()->query("name") + "身形一转，化为一股清烟钻入地下。。。\n");
    }
  }
  destruct(this_object());

}
