// dtask.c
//add level 4 ,edit by huarong  2003.10
#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  object ob;

  seteuid(getuid(me));
  if (!arg) ob = me;
  else if (wizardp(me)) {
    ob = present(arg, environment(me));
    if (!ob) ob = find_player(arg);
    if (!ob) ob = find_living(arg);
    if (!ob) return notify_fail("您要察看谁的状态？\n");
  } else return notify_fail("只有巫师才可以察看别人的状态。\n");

  printf("　　 ┃ 难度" + HIY + "一" + NOR + " ┃ 难度" + HIY + "二" + NOR + " ┃ 难度" + HIY + "三" + NOR + " ┃ 获得潜能 ┃ 获得武学 ┃ 获得道行 ┃\n");
  printf("" + HIR + "杀" + NOR + "妖 ┃%8|d┃%8|d┃%8|d┃%10|d┃%10|d┃%10|d┃ \n",
    ob->query("rulaitask_log/kill1"), ob->query("rulaitask_log/kill2"),
    ob->query("rulaitask_log/kill3"), ob->query("rulaitask_log/kill_potential"),
    ob->query("rulaitask_log/kill_combat"),
    ob->query("rulaitask_log/kill_daoxing"));
  printf("" + HIR + "擒" + NOR + "妖 ┃%8|d┃%8|d┃%8|d┃%10|d┃%10|d┃%10|d┃ \n",
    ob->query("rulaitask_log/arrest1"), ob->query("rulaitask_log/arrest2"),
    ob->query("rulaitask_log/arrest3"), ob->query("rulaitask_log/arrest_potential"),
    ob->query("rulaitask_log/arrest_combat"),
    ob->query("rulaitask_log/arrest_daoxing"));
  printf("" + HIR + "劝" + NOR + "妖 ┃%8|d┃%8|d┃%8|d┃%10|d┃%10|d┃%10|d┃ \n",
    ob->query("rulaitask_log/persuade1"), ob->query("rulaitask_log/persuade2"),
    ob->query("rulaitask_log/persuade3"), ob->query("rulaitask_log/persuade_potential"),
    ob->query("rulaitask_log/persuade_combat"),
    ob->query("rulaitask_log/persuade_daoxing"));
  printf("" + HIR + "降" + NOR + "妖 ┃%8|d┃%8|d┃%8|d┃%10|d┃%10|d┃%10|d┃ \n",
    ob->query("rulaitask_log/fight1"), ob->query("rulaitask_log/fight2"),
    ob->query("rulaitask_log/fight3"), ob->query("rulaitask_log/fight_potential"),
    ob->query("rulaitask_log/fight_combat"),
    ob->query("rulaitask_log/fight_daoxing"));
  printf(HIY "〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓\n" NOR);
  printf("　　 ┃ 难度" + HIY + "四" + NOR + " ┃                  ┃ 获得潜能 ┃ 获得武学 ┃ 获得道行 ┃\n");
  printf("" + HIR + "变" + NOR + "妖 ┃%8|d┃                  ┃%10|d┃%10|d┃%10|d┃ \n",
    ob->query("rulaitask_log/bian1"), ob->query("rulaitask_log/bian_potential"),
    ob->query("rulaitask_log/bian_combat"),
    ob->query("rulaitask_log/bian_daoxing"));
  printf("" + HIR + "渡" + NOR + "妖 ┃%8|d┃                  ┃%10|d┃%10|d┃%10|d┃ \n",
    ob->query("rulaitask_log/du1"), ob->query("rulaitask_log/du_potential"),
    ob->query("rulaitask_log/du_combat"),
    ob->query("rulaitask_log/du_daoxing"));
  printf("" + HIR + "占" + NOR + "妖 ┃%8|d┃                  ┃%10|d┃%10|d┃%10|d┃ \n",
    ob->query("rulaitask_log/zhan1"), ob->query("rulaitask_log/zhan_potential"),
    ob->query("rulaitask_log/zhan_combat"),
    ob->query("rulaitask_log/zhan_daoxing"));
  printf("" + HIR + "解" + NOR + "妖 ┃%8|d┃                  ┃%10|d┃%10|d┃%10|d┃ \n",
    ob->query("rulaitask_log/jie1"), ob->query("rulaitask_log/jie_potential"),
    ob->query("rulaitask_log/jie_combat"),
    ob->query("rulaitask_log/jie_daoxing"));

  printf("殉职次数： " + HIR + "%d" + NOR + "\n", ob->query("rulaitask_log/die"));



  return 1;
}

int help(object me) {
  write(@HELP
指令格式: dtask

这个指令让你知道你做如来任务的统计情况。

HELP
  );
  return 1;
}
