#include <ansi.h>
inherit "/u/huarong/npc/cjnpc.lpc";
int give_book ();
int give_book2 ();
int give_fu ();

void create()
{
       set_name("燃灯古佛", ({ "randeng gufo", "randeng", "gufo" }));
       set("title", "灵山");
       set("gender", "男性");
       set("age", 10000);
       set("attitude", "peaceful");
       set("str",40);
       set("per",40);
       set("max_kee", 10000);
       set("max_gin", 10000);
       set("max_sen", 10000);
       set("force", 30000);
       set("max_force", 15000);
       set("force_factor", 300);
       set("max_mana", 15000);
       set("mana", 30000);
       set("mana_factor", 300);
       set("combat_exp", 20000000);
       set("daoxing", 20000000);
        set_skill("literate", 500);
        set_skill("spells", 500);
        set_skill("buddhism", 500);
        set_skill("unarmed", 500);
        set_skill("jienan-zhi", 500);
        set_skill("dodge", 500);
        set_skill("lotusmove", 500);
        set_skill("parry", 500);
        set_skill("force", 500);
        set_skill("lotusforce", 500);
        set_skill("staff", 500);
        set_skill("lunhui-zhang", 500);
        map_skill("spells", "buddhism");
        map_skill("unarmed", "jienan-zhi");
        map_skill("dodge", "lotusmove");
        map_skill("force", "lotusforce");
        map_skill("parry", "lunhui-zhang");
        map_skill("staff", "lunhui-zhang");
       set("inquiry", ([
         "book" : (: give_book :),
         "jing" : (: give_book :),
         "qujing" : (: give_book :),
         "经" : (: give_book :),
         "取经" : (: give_book :),
         "经书" : (: give_book :),
         "佛经" : (: give_book2 :),
         "fojing" : (: give_book2 :),
         "灵符" : (: give_fu :),
         "lingfu" : (: give_fu :),
         "fu" : (: give_fu :),
                 ]) );

create_family("南海普陀山", 1, "弟子");
setup();
  carry_object("/d/obj/weapon/staff/muzhang")->wield();
  carry_object("/d/obj/cloth/jia_sha")->wear();
}

int give_book()
{
  object ob = this_object();
  object me = this_player();
  object book;

  if (! me->query("obstacle/reward"))
  {
    message_vision ("$N对$n摇了摇头：你先回去，好好过西域再来取经。\n",ob,me);
    return 1;
  }
  if (me->query_temp("given_book"))
  {
    message_vision ("$N对$n摇了摇头：经书已给过了，等等再来吧。\n",ob,me);
    return 1;
  }
  book = new ("/d/obj/book/qujing");
  command ("nod");
  message_vision("$N给$n一本"+book->query("name")+"。\n",ob,me);
  book->move(me);
  me->set_temp("given_book",1);
  call_out("reset_give",180);
  return 1;
}

void reset_give ()
{
  object ob = this_object();
  ob->set_temp("given_book",0);
  ob->set_temp("given_book2",0);
  ob->set_temp("given_fu",0);
}

void reset_givefu ()
{
  object ob = this_player();
  ob->set_temp("given_fu",0);
}

int give_book2()
{
  object ob = this_object();
  object me = this_player();
  object book;

  if (! me->query("rulaitask/daccomplish"))
  {
     if ( me->query("rulaitask/dfail") )
     {
      if ( ! me->query_temp("given_book2") )
      message_vision ("$N拍拍$n的肩膀：这位"+RANK_D->query_respect(me)+"，勤加练习吧，佛祖会保佑你的！\n",ob,me);
      }
     else
      {
      message_vision ("$N对$n摇了摇头：佛祖交待的任务你完成了么？\n",ob,me);
      return 1;
      }
  }


  if (! me->query("obstacle/reward"))
  {
    message_vision ("$N对$n摇了摇头：你先回去，好好过西域再来取经。\n",ob,me);
    return 1;
  }

  if (me->query_temp("given_book2"))
  {
    message_vision ("$N对$n摇了摇头：我不是给过你经书了么？\n",ob,me);
    return 1;
  }
  book = new ("/u/huarong/npc/rulainew/jingshu");
  command ("nod");
  message_vision("$N给$n一本"+book->query("name")+"。\n",ob,me);
  book->move(me);
  book->set("canread",1);
  me->set("rulaitask/bookname1",book->query("name"));
  me->set_temp("given_book2",1);
  call_out("reset_give",3600);
  return 1;
}

int give_fu()
{
  object ob = this_object();
  object me = this_player();
  object fu;

  if ( me->query("rulaitask/kind")!="解")
  {
    message_vision ("$N对$n摇了摇头：佛祖有交待你取灵符么？\n",ob,me);
    return 1;
  }

  if (! me->query("obstacle/reward"))
  {
    message_vision ("$N对$n摇了摇头：你先回去，好好过西域再来取经。\n",ob,me);
    return 1;
  }

  if (me->query_temp("given_fu"))
  {
    message_vision ("$N对$n摇了摇头：我不是给过你灵符了么？\n",ob,me);
    return 1;
  }
  fu = new ("/u/huarong/npc/rulainew/lingfu");
  command ("nod");
  message_vision("$N给$n一张"+fu->query("name")+"。\n",ob,me);
  fu->move(me);
  fu->set("owner", me);
  //fu->set("canread",1);
  //me->set("rulaitask/bookname1",book->query("name"));
  me->set_temp("given_fu",1);
  call_out("reset_givefu",1800);
  return 1;
}


string chinese_time(int timep)
{
        int t, d, h, m, s;
        string time;
        t = timep;
        s = t % 60;             t /= 60;
        m = t % 60;             t /= 60;
        h = t % 24;             t /= 24;
        d = t;

        if(d) time = chinese_number(d) + "天";
        else time = "";

        if(h) time += chinese_number(h) + "小时";
        if(m) time += chinese_number(m) + "分";
        time += chinese_number(s) + "秒";
        
        return time;
}


void reward(object me)
{
        int wuxue,level,kind_bonus,level_bonus,timep;
    int extra_bonus,potential_bonus,combat_exp_bonus,daoxing_bonus;
    string str,kind,time;
        
        wuxue = me->query("combat_exp");
        level = me->query("rulaitask/level");
        kind  = me->query("rulaitask/kind");     
        timep = me->query("rulaitask/end_time")-me->query("rulaitask/start_time");
        time  = chinese_time(timep);
        
        if ( level == 4 ) level_bonus=1000;
        
        if ( kind == "变" ) kind_bonus=1100;
        else if ( kind == "渡" ) kind_bonus=1000;
        else if ( kind == "占" ) kind_bonus=1300;
        else kind_bonus=1200;
        
        extra_bonus = (me->query("combat_exp")/1000)/3;
        
if(extra_bonus > 1000) extra_bonus = 1000;
        potential_bonus = random(extra_bonus)*2 + level_bonus + kind_bonus;
        combat_exp_bonus = extra_bonus*8 + (random(level_bonus) + random(kind_bonus))*3;
        daoxing_bonus = extra_bonus*8 + (random(level_bonus) + random(kind_bonus))*3;
        
        me->add("potential", potential_bonus);
        me->add("combat_exp", combat_exp_bonus);
        me->add("daoxing", daoxing_bonus);

     me->add("data_watch_exp",combat_exp_bonus+daoxing_bonus);
     me->save();
        str = "得到了"+potential_bonus+"点潜能，";
        str +=combat_exp_bonus+"武学经验，";
        str += COMBAT_D->chinese_daoxing(daoxing_bonus)+"道行。";
        
        tell_object(me,"你得到了"+potential_bonus+"点潜能，"+combat_exp_bonus+"武学经验，"+COMBAT_D->chinese_daoxing(daoxing_bonus)+"道行。\n");
        if ( kind == "变" ) 
          {
            str =HIM+ me->name()+HIM+"用时"+time+"夺回了被盗经书，功德无量，"+ str;
          }        
        if ( kind == "渡" ) 
          {
            str =HIM+ me->name()+HIM+"用时"+time+"就令被渡者大撤大悟，功德无量，"+ str;
          }
        if ( kind == "解" ) 
          {
            str =HIM+ me->name()+HIM+"用时"+time+"解救了一位中蛊者，功德无量，"+ str;
          }
        if ( kind == "占" ) 
          {
            str =HIM+ me->name()+HIM+"用时"+time+"驱逐了一名冒充者，功德无量，"+ str;
          }                                
        message("channel:rumor", HIM"【长安夜话】某人："+str+"\n"NOR,users());
        
       // str = str + "用时"+time+"。";
        MONITOR_D->report_system_msg (str);
        
        switch (kind)
          {case "变": {
                        me->add("rulaitask_log/bian_potential",potential_bonus);
                        me->add("rulaitask_log/bian_combat",combat_exp_bonus);
                        me->add("rulaitask_log/bian_daoxing",daoxing_bonus);
                
                        me->add("rulaitask_log/bian1",1);
                        break;
                      }
          case "渡": {
                        me->add("rulaitask_log/du_potential",potential_bonus);
                        me->add("rulaitask_log/du_combat",combat_exp_bonus);
                        me->add("rulaitask_log/du_daoxing",daoxing_bonus);
                
                        me->add("rulaitask_log/du1",1);
                         break;
                      }
          case "占": {
                        me->add("rulaitask_log/zhan_potential",potential_bonus);
                        me->add("rulaitask_log/zhan_combat",combat_exp_bonus);
                        me->add("rulaitask_log/zhan_daoxing",daoxing_bonus);
                
                        me->add("rulaitask_log/zhan1",1);
                         break;
                      }
          case "解": {
                        me->add("rulaitask_log/jie_potential",potential_bonus);
                        me->add("rulaitask_log/jie_combat",combat_exp_bonus);
                        me->add("rulaitask_log/jie_daoxing",daoxing_bonus);
                
                        me->add("rulaitask_log/jie1",1);
                     }                        
          }
}

void finish(object me)
{
        tell_object(me,"你忽然觉得此次阅读经文受用不少。\n");
me->start_busy(2);
        if (me->query("rulaitask/daccomplish")) reward(me);
        me->set_temp("oneday",me->query("rulaitask/oneday"));
        me->set_temp("doneday",me->query("rulaitask/doneday"));
        me->set_temp("whichdate",me->query("rulaitask/whichdate"));
        me->set_temp("dfinish",me->query("rulaitask/dfinish"));
        me->set_temp("finish",me->query("rulaitask/finish"));
        if (me->query("rulaitask/daccomplish")) me->add_temp("dfinish",1);
        me->delete("rulaitask");
        me->set("rulaitask/oneday",me->query_temp("oneday"));
        me->set("rulaitask/doneday",me->query_temp("doneday"));
        me->set("rulaitask/whichdate",me->query_temp("whichdate"));
        me->set("rulaitask/dfinish",me->query_temp("dfinish"));
        me->set("rulaitask/finish",me->query_temp("finish"));
        me->delete_temp("readbook_ok");
        me->delete_temp("readbook");
}

int accept_object (object me, object ob)
{
  object fo;
  fo = this_object();
  me = this_player();

   if ( ob->query("id") != "fo jing" )
       {
         message_vision(CYN"$N手打佛讯：阿弥陀佛！施主之物，贫僧不敢妄取。\n"NOR,fo);
         return 0;
        }
   if (!me->query_temp("readbook_ok"))
       {
         message_vision(CYN"$N手打佛讯：阿弥陀佛！"+RANK_D->query_respect(me)+CYN+"应该熟读经书才是。\n"NOR,fo);
         return 0;
        }
    else { 
           finish(me);
           call_out ("destruct_ob",1,ob);
           me->delete_temp("given_book2");
           return 1;
          }
}


int accept_fight(object me)
{
  command("say 贫僧手重，拳脚无眼，若是伤人就不好了。\n");
  return 0;
}

void destruct_ob (object ob)
{
  destruct (ob);
}

void kill_ob(object ob)
{
  set_temp("my_killer",ob);
  remove_call_out("check");
  call_out("check",1);
  ::kill_ob(ob);
}

void check()
{
        object ob=this_object(),newnew;
        object ghost;
        object me=query_temp("my_killer");
        int i;
        i=random(10);

        if( ! me ) return ;
   if(! present(me,environment()) ||!ob->is_fighting()|| !me->is_fighting())
     {
     remove_call_out("check");
     return;
     }
  remove_call_out("check2");
  call_out("check2",0);                               
 if(me->is_busy())
    {   
        command("enforce max");
        command("enchant max");
        command("exert recover");
    if (i<5)
           {
        command("wield staff");
        command("perform pudu");
           }
    else if(i<8)
           {
        command("unwield staff");
        command("perform rulai");
           }
    else
           {
         command("cast bighammer");
            }
        remove_call_out("check");
        call_out("check",3);
    }
  if(!me->is_busy())
    {
        command("unwield staff");
        command("exert recover");
        command("perform lingxi");
        remove_call_out("check");
        call_out("check",2);

    }
}
      




