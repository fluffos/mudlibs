//moon妖怪for rulaitask难度四
//huarong 2003
#include <ansi.h>
inherit "/u/huarong/npc/rulainew/cjguai.lpc";

void set_skills(int max_value, int level) {
  int guai_value;
  ::set_skills(max_value, level);

  guai_value = max_value + max_value / 4;

  create_family("月宫", 3, "弟子");
  set("gender", "女性");
  set("JQB_known", 1);
  set_skill("sword", guai_value + random(16));
  set_skill("whip", guai_value + random(16));
  set_skill("blade", guai_value + random(16));
  set_skill("moonshentong", guai_value + random(16));
  set_skill("xuanhu-blade", guai_value + random(16));
  set_skill("jueqingbian", guai_value + random(16));
  set_skill("baihua-zhang", guai_value + random(16));
  set_skill("moonforce", guai_value + random(16));
  set_skill("snowsword", guai_value + random(16));
  set_skill("moondance", guai_value + random(16));
  map_skill("spells", "moonshentong");
  map_skill("whip", "jueqingbian");
  map_skill("unarmed", "baihua-zhang");
  map_skill("force", "moonforce");
  map_skill("sword", "snowsword");
  map_skill("blade", "xuanhu-blade");
  map_skill("parry", "snowsword");
  map_skill("dodge", "moondance");
  map_skill("unarmed", "lanhua-shou");
  carry_object("/d/obj/cloth/shoupiqun.lpc")->wear();
  carry_object("/d/obj/weapon/sword/mujian.lpc");
  carry_object("/d/obj/weapon/whip/wuchou.lpc")->wield();
  carry_object("/d/obj/weapon/blade/zhudao.lpc");
}

void kill_ob(object ob) {
  object me = this_object();
  me->set_leader(ob);
  remove_call_out("check");
  call_out("check", 1);
  ::kill_ob(ob);
}


void check() {
  object ob = this_object();
  object me = owner();
  int i = random(10);
  if (!present(me, environment()) || !me->is_fighting(ob)) me = offensive_target(ob);
  if (!me) return;
  if (!present(me, environment()) || !ob->is_fighting() || !me->is_fighting(ob)) {
    remove_call_out("check");
    return;
  }
  command("enforce max");
  command("enchant max");
  remove_call_out("check2");
  call_out("check2", 0);

  if (me->query_temp("in_qingwang")) {
    command("unwield sword");
    command("unwield whip");
    command("wield blade");
    command("perform duanfa on " + me->query("id"));
    command("unwield blade");
    command("wield whip");
    command("perform sanshou on " + me->query("id"));
    command("unwield whip");
    command("perform flower on " + me->query("id"));
    command("wield sword");
    command("perform tian on " + me->query("id"));
    command("perform xiaoyao on " + me->query("id"));
    command("cast arrow on " + me->query("id"));
    remove_call_out("check");
    call_out("check", 3);
  }
  if (me->is_busy()) {
    command("cast arrow on " + me->query("id"));
    remove_call_out("check");
    call_out("check", 3);
  }
  if (!me->query_temp("in_qingwang")) {
    command("unwield sword");
    command("wield whip");
    command("exert recover");
    command("cast qingwang on " + me->query("id"));
    remove_call_out("check");
    call_out("check", 3);

  }

  if (ob->is_fighting()) {
    if ((ob->query("eff_kee")) < (ob->query("max_kee") / 5)) {
      command("unwield whip");
      command("unwield blade");
      command("wield sword");
      command("perform huifeng on " + me->query("id"));
    }
  }

}
