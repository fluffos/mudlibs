//jjf妖怪for rulaitask难度四
//huarong 2003
#include <ansi.h>
inherit "/u/huarong/npc/rulainew/cjguai.lpc";

void set_skills(int max_value, int level) {
  int guai_value;
  ::set_skills(max_value, level);

  guai_value = max_value + max_value / 4;

  set_skill("sword", guai_value + random(16));
  set_skill("whip", guai_value + random(16));
  set_skill("archery", guai_value + random(16));
  set_skill("mace", guai_value + random(16));
  set_skill("changquan", guai_value + random(16));
  set_skill("yanxing-steps", guai_value + random(16));
  set_skill("lengquan-force", guai_value + random(16));
  set_skill("jinglei-mace", guai_value + random(16));
  set_skill("wusi-mace", guai_value + random(16));
  set_skill("bawang-qiang", guai_value + random(16));
  set_skill("xuanyuan-archery", guai_value + random(16));
  set_skill("spear", guai_value + random(16));
  set_skill("axe", guai_value + random(16));
  set_skill("baguazhou", guai_value + random(16));
  set_skill("sanban-axe", guai_value + random(16));
  map_skill("force", "lengquan-force");
  map_skill("unarmed", "changquan");
  map_skill("spells", "baguazhou");
  map_skill("axe", "sanban-axe");
  map_skill("parry", "bawang-qiang");
  map_skill("dodge", "yanxing-steps");
  map_skill("mace", "jinglei-mace");
  map_skill("spear", "bawang-qiang");
  map_skill("archery", "xuanyuan-archery");
  create_family("将军府", 1, "弟子");
  carry_object("/d/obj/weapon/mace/bamboo.lpc");
  carry_object("/d/obj/weapon/spear/muqiang.lpc")->wield();
  carry_object("/d/obj/weapon/axe/ironaxe.lpc");
  carry_object("/d/obj/cloth/shoupiqun.lpc")->wear();
}

void kill_ob(object ob) {
  object me = this_object();
  me->set_leader(ob);
  remove_call_out("check");
  call_out("check", 1);
  ::kill_ob(ob);
}


void check() {
  object ob = this_object(), newnew, target;
  object me = owner();
  int i = random(10), j = random(10);
  if (!present(me, environment()) || !me->is_fighting(ob)) me = offensive_target(ob);
  if (!me) return;
  if (!present(me, environment()) || !ob->is_fighting() || !me->is_fighting(ob)) {
    remove_call_out("check");
    return;
  }
  command("enforce max");
  command("enchant max");
  remove_call_out("check2");
  call_out("check2", 0);
  if (me->is_busy()) {
    command("exert recover");
    command("wield mace");
    map_skill("mace", "jinglei-mace");
    command("perform tian on " + me->query("id"));
    command("unwield mace");
    if (i < 5) {
      command("wield spear");
      command("perform meihua on " + me->query("id"));
    } else if (i < 8) {
      command("wield axe");
      command("perform sanban on " + me->query("id"));
      command("perform sanban on " + me->query("id"));
    } else {
      command("wield mace");
      map_skill("mace", "wusi-mace");
      command("perform andu on " + me->query("id"));
    }
    remove_call_out("check");
    call_out("check", 1);
  }
  if (!me->is_busy()) {
    if (j < 3) {
      command("unwield spear");
      command("unwield axe");
      command("exert recover");
      command("wield mace");
      map_skill("mace", "wusi-mace");
      command("perform suo on " + me->query("id"));
      remove_call_out("check");
      call_out("check", 2);
    } else if (j < 7) {
      command("unwield spear");
      command("unwield axe");
      command("unwield mace");
      command("exert recover");
      newnew = new("/u/huarong/npc/rain_seal.lpc");
      newnew->move(ob);
      command("ji rain seal on " + me->query("id"));
      remove_call_out("check");
      call_out("check", 4);
    } else {
      command("unwield spear");
      command("unwield axe");
      command("exert recover");
      command("unwield mace");
      command("perform zhiqi on " + me->query("id"));
      remove_call_out("check");
      call_out("check", 3);
    }
  }


}
