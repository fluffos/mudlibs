//kunlun妖怪for rulaitask难度四
//huarong 2003
#include <ansi.h>
inherit "/u/huarong/npc/rulainew/cjguai.lpc";

void set_skills(int max_value, int level)
{
        int guai_value;
        ::set_skills(max_value, level);
        
        guai_value = max_value+max_value/4;
        set_skill("sword", guai_value+random(16));
        set_skill("xuanzong-force", guai_value+random(16));
        set_skill("lingyunbu", guai_value+random(16));
        set_skill("dashen-bian", guai_value+random(16));
        set_skill("kaitian-zhang", guai_value+random(16));
        set_skill("huntian-jian", guai_value+random(16));
        set_skill("yuxu-spells", guai_value+random(16));
        set_skill("wugou-jian", guai_value+random(16));
        set_skill("mace",guai_value+random(16));
        map_skill("spells", "yuxu-spells");
        map_skill("dodge", "lingyunbu");
        map_skill("mace", "dashen-bian");
        map_skill("force", "xuanzong-force");
        map_skill("parry", "huntian-jian");
        map_skill("sword", "huntian-jian");
        map_skill("unarmed", "kaitian-zhang");
        map_skill("mace", "dashen-bian");
        create_family("昆仑山玉虚洞", 1, "弟子");
        carry_object("/d/obj/cloth/shoupiqun.lpc")->wear();
         carry_object("/d/obj/weapon/sword/mujian.lpc")->wield();
}
   
void kill_ob (object ob)
{
          object me = this_object();  
          me->set_leader(ob);
          remove_call_out("check");
          call_out("check",1);
          ::kill_ob(ob);
}           


void check()
{
        object ob=this_object();
        object me = owner();
        int i;
        i=random(10);

        if( ! present(me,environment()) || !me->is_fighting(ob) ) me=offensive_target(ob);
        if( ! me ) return ;
   if(! present(me,environment()) ||!ob->is_fighting()|| !me->is_fighting())
     {
     remove_call_out("check");
     return;
     }
        command("enforce max");
        command("enchant max");                               
        remove_call_out("check2");
        call_out("check2",0);

 if(me->is_busy())
    {   
        command("exert recover");
        command("unwield sword");
        command("perform po on "+me->query("id"));
    if(!ob->query_temp("powerup")) command("exert hengha");
    if (i<5)
           {
        command("wield sword");
        if(!ob->query_temp("pfmxue")) command("perform xue");
        command("perform lin on "+me->query("id"));
           }
    else if(i<8)
           {
        command("wield sword");
        map_skill("sword", "wugou-jian");
        command("perform fengshen on "+me->query("id"));
        map_skill("sword", "huntian-jian");
           }
    else
           {
         command("cast light on "+me->query("id"));
            }
        remove_call_out("check");
        call_out("check",3);
    }
  if(!me->is_busy())
    {
        command("enchant max");
        command("cast fantian on "+me->query("id"));
        remove_call_out("check");
        call_out("check",2);

    }
}
      


