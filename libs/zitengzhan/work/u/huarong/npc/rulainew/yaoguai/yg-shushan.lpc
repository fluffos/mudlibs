//shushan妖怪for rulaitask难度四
//huarong 2003
#include <ansi.h>
inherit "/u/huarong/npc/rulainew/cjguai.lpc";

void set_skills(int max_value, int level) {
  int guai_value;
  ::set_skills(max_value, level);

  guai_value = max_value + max_value / 4;

  set_skill("mindsword", guai_value + random(16));
  set_skill("zixia-shengong", guai_value + random(16));
  set_skill("sevensteps", guai_value + random(16));
  set_skill("taoism", guai_value + random(16));
  set_skill("hunyuan-zhang", guai_value + random(16));
  set_skill("yujianshu", guai_value + random(16));
  set_skill("canxin-jian", guai_value + random(16));
  set_skill("sword", guai_value + random(16));
  map_skill("force", "zixia-shengong");
  map_skill("unarmed", "hunyuan-zhang");
  map_skill("dodge", "sevensteps");
  map_skill("spells", "taoism");
  map_skill("parry", "mindsword");
  map_skill("sword", "mindsword");
  create_family("蜀山派", 1, "弟子");
  carry_object("/d/obj/weapon/sword/zhujian.lpc")->wield();
  carry_object("/d/obj/cloth/shoupiqun.lpc")->wear();
}

void kill_ob(object ob) {
  object me = this_object();
  me->set_leader(ob);
  remove_call_out("check");
  call_out("check", 1);
  ::kill_ob(ob);
}


void check() {
  object ob = this_object();
  object me = owner();
  if (!present(me, environment()) || !me->is_fighting(ob)) me = offensive_target(ob);
  if (!me) return;
  if (!present(me, environment()) || !ob->is_fighting() || !me->is_fighting()) {
    remove_call_out("check");
    return;
  }
  command("enforce max");
  command("enchant max");
  remove_call_out("check2");
  call_out("check2", 0);
  if (me->is_busy()) {
    command("wield sword");
    command("exert recover");
    map_skill("sword", "yujianshu");
    command("perform wanjian on " + me->query("id"));
    map_skill("sword", "canxin-jian");
    command("perform xiangsi on " + me->query("id"));
    remove_call_out("check");
    call_out("check", 4);
  }
  if (!me->is_busy()) {
    command("unwield sword");
    command("exert recover");
    command("perform fenguang on " + me->query("id"));
    command("wield sword");
    map_skill("sword", "mindsword");
    map_skill("parry", "mindsword");
    command("perform jianqi on " + me->query("id"));
    remove_call_out("check");
    call_out("check", 3);

  }
}
