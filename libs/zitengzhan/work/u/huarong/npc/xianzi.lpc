//huarong 2003.4 for cjnpc
//木族圣女姑射仙子蕾依丽娅
inherit "/u/huarong/npc/cjnpc.lpc";
#include <ansi.h>

void create() {
  set_name(MAG "蕾依丽娅" NOR, ({ "leiyi liya", "leiyi", "liya", "xianzi" }));
  set("long",
    "她就是木族圣女姑射仙子蕾依丽娅，神仙姐姐是也。\n");
  set("title", HIW "姑射仙子" NOR);
  set("gender", "女性");
  set("age", 20);
  //       set("class", "swordsman");
  set("attitude", "friendly");
  set("per", 160);
  set("int", 30);
  set("max_kee", 10000);
  set("max_sen", 10000);
  set("force", 14000);
  set("max_force", 7000);
  set("force_factor", 200);
  set("max_mana", 20000);
  set("mana", 20000);
  set("mana_factor", 1000);
  set("combat_exp", 50000000);
  set("daoxing", 50000000);
  set("eff_dx", 200000);
  set("nkgain", 350);
  set("JQB_known", 1);

  set_skill("literate", 500);
  set_skill("unarmed", 500);
  set_skill("dodge", 500);
  set_skill("force", 500);
  set_skill("parry", 500);
  set_skill("sword", 500);
  set_skill("whip", 500);
  set_skill("spells", 500);
  set_skill("literate", 500);
  set_skill("blade", 500);
  set_skill("moonshentong", 500);
  set_skill("xuanhu-blade", 500);
  set_skill("jueqingbian", 500);
  set_skill("baihua-zhang", 500);
  set_skill("moonforce", 500);
  set_skill("snowsword", 500);
  set_skill("moondance", 500);
  map_skill("spells", "moonshentong");
  map_skill("whip", "jueqingbian");
  map_skill("unarmed", "baihua-zhang");
  map_skill("force", "moonforce");
  map_skill("sword", "snowsword");
  map_skill("blade", "xuanhu-blade");
  map_skill("parry", "snowsword");
  map_skill("dodge", "moondance");
  map_skill("unarmed", "lanhua-shou");
  create_family("月宫", 1, "弟子");
  setup();
  carry_object("/d/moon/obj/luoyi")->wear();
  carry_object("/d/npc/obj/sword2.lpc");
  carry_object("/d/npc/obj/whip.lpc")->wield();
  carry_object("/d/npc/obj/blade.lpc");
}



void kill_ob(object ob) {
  set_temp("my_killer", ob);
  remove_call_out("check");
  call_out("check", 1);
  ::kill_ob(ob);
}

void check() {
  object ob = this_object();
  object me = query_temp("my_killer");
  if (!me) return;
  if (!present(me, environment()) || !ob->is_fighting() || !me->is_fighting(ob)) {
    remove_call_out("check");
    return;
  }
  remove_call_out("check2");
  call_out("check2", 0);

  if (me->query_temp("in_qingwang")) {
    command("unwield sword");
    command("unwield whip");
    command("wield blade");
    command("perform duanfa");
    command("unwield blade");
    command("wield whip");
    command("perform sanshou");
    command("unwield whip");
    command("perform flower");
    command("wield sword");
    command("perform tian");
    command("perform xiaoyao");
    command("cast arrow");
    remove_call_out("check");
    call_out("check", 3);
  }
  if (me->is_busy()) {
    command("cast arrow");
    remove_call_out("check");
    call_out("check", 3);
  }
  if (!me->query_temp("in_qingwang")) {
    command("unwield sword");
    command("wield whip");
    command("exert recover");
    command("cast qingwang");
    remove_call_out("check");
    call_out("check", 2);

  }

  if (ob->is_fighting()) {
    if ((ob->query("eff_kee")) < (ob->query("max_kee") / 5)) {
      command("unwield whip");
      command("unwield blade");
      command("wield sword");
      command("perform huifeng");
    }
  }

}


void unconcious() {
  die();
}

void die() {
  if (environment()) {
    command("say 真是横的怕不要命的。");
    command("sigh");
    message("sound", "\n身形一转，架起一朵莲花飞上天空。。。\n\n", environment());
  }
  destruct(this_object());
}
