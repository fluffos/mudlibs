//huarong 2003.4 for cjnpc
inherit "/u/huarong/npc/cjnpc.lpc";
#include <ansi.h>

void create() {
  set_name(HIY "太乙真人" NOR, ({ "taiyi zhenren", "taiyi", "zhenren" }));
  set("title", HIG "乾元山金光洞" NOR);
  set("gender", "男性");
  set("age", 100 + random(20));
  set("attitude", "friendly");
  set("kar", 40);
  set("max_kee", 10000);
  set("max_sen", 10000);
  set("force", 14000);
  set("max_force", 7000);
  set("force_factor", 300);
  set("max_mana", 20000);
  set("mana", 20000);
  set("mana_factor", 1000);
  set("combat_exp", 50000000);
  set("daoxing", 50000000);
  set("eff_dx", 200000);
  set("nkgain", 350);

  set_skill("spells", 500);
  set_skill("force", 500);
  set_skill("dodge", 500);
  set_skill("parry", 500);
  set_skill("sword", 500);
  set_skill("xuanzong-force", 500);
  set_skill("lingyunbu", 500);
  set_skill("dashen-bian", 500);
  set_skill("kaitian-zhang", 500);
  set_skill("huntian-jian", 500);
  set_skill("literate", 500);
  set_skill("unarmed", 500);
  set_skill("yuxu-spells", 500);
  set_skill("wugou-jian", 500);
  set_skill("mace", 500);
  map_skill("spells", "yuxu-spells");
  map_skill("dodge", "lingyunbu");
  map_skill("mace", "dashen-bian");
  map_skill("force", "xuanzong-force");
  map_skill("parry", "huntian-jian");
  map_skill("sword", "huntian-jian");
  map_skill("unarmed", "kaitian-zhang");
  map_skill("mace", "dashen-bian");
  create_family("昆仑山玉虚洞", 1, "弟子");
  setup();
  carry_object("/d/obj/cloth/baipao")->wear();
  carry_object("/d/obj/weapon/sword/zhujian")->wield();
}


void kill_ob(object ob) {
  set_temp("my_killer", ob);
  remove_call_out("check");
  call_out("check", 1);
  ::kill_ob(ob);
}

void check() {
  object ob = this_object(), newnew;
  object ghost;
  object me = query_temp("my_killer");
  int i;
  i = random(10);

  if (!me) return;
  if (!present(me, environment()) || !ob->is_fighting() || !me->is_fighting()) {
    remove_call_out("check");
    return;
  }
  if (!ob->query_temp("powerup")) command("exert hengha");
  if (me->is_busy()) {
    command("enforce max");
    command("exert recover");
    command("unwield sword");
    command("perform po");
    if (i < 5) {
      command("wield sword");
      if (!ob->query_temp("pfmxue")) command("perform xue");
      command("perform lin");
    } else if (i < 8) {
      command("wield sword");
      map_skill("sword", "wugou-jian");
      command("perform fengshen");
      map_skill("sword", "huntian-jian");
    } else {
      command("cast light");
    }
    remove_call_out("check");
    call_out("check", 3);
  }
  if (!me->is_busy()) {
    command("enchant max");
    command("cast fantian");
    remove_call_out("check");
    call_out("check", 2);

  }
}


void unconcious() {
  die();
}

void die() {
  if (environment()) {
    command("say 真是横的怕不要命的。");
    command("sigh");
    message("sound", "\n身形一转，架起一朵莲花飞上天空。。。\n\n", environment());
  }

  destruct(this_object());


}
