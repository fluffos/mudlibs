//huarong 2003.7
inherit ITEM;
#include <ansi.h>

void create()
{
        set_name("平装药盒", ({ "jinchuang box","box" }) );
        set_weight(5000);
        set_max_encumbrance(8000);
  if( clonep() ){
    object a;
    seteuid(getuid());
    if(a=new("/u/huarong/drug/jinlie") )
      a->move(this_object());
    seteuid(getuid());
    set_default_object(__FILE__);
  } else {
                set("unit", "盒");
                set("long", "这是一只木质的一百包装的金创药盒。\n");
               set("value", 20000);
                set("no_sell",1);
                set("no_drop",1);
        }
}

int is_container() { return 1; }


