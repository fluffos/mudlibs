//huarong 2003.7
inherit ITEM;
#include <ansi.h>

void create()
{
        set_name(HIY"精装药盒"NOR, ({ "jinchuang box","box" }) );
        set_weight(5000);
        set_max_encumbrance(8000);
  if( clonep() ){
    object a;
    seteuid(getuid());
    if(a=new("/u/huarong/drug/jin") )
      a->move(this_object());
    seteuid(getuid());
    set_default_object(__FILE__);
  } else {
                set("unit", "只");
               set("long", "这是一只一百包装的非常精致的金创药盒。\n");
                set("value", 30000);
                set("no_sell",1);
                set("no_drop",1);
        }
}

int is_container() { return 1; }


