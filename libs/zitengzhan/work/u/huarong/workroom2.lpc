inherit ROOM;
#include <room.h>
#include <ansi.h>
void setlong();

void create() {
  set("short", HIC "天狼星" BLU "的" HIY "小窝" NOR);
  setlong();
  set("sleep_room", 1);
  set("if_bed", 1);
  set("no_get", 1);
  set("no_fight", 1);
  set("no_magic", 1);

  set("exits", ([
    "kz": "/d/city/kezhan",
    "down": "/d/wiz/wizroom",
    "npc": "/d/city/misc/npc_kantai",
  ]));

  setup();
}

