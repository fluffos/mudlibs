// /daemon/skill/wuyue-spear/fengchan  五岳封禅
// writted by jie 2001-2-8
// 连击技 五岳封禅取义上古人帝对五岳封禅
// 最厉害连续发5招：正气岱宗 平冲中庸 文章衡峰 忠勇西岳 恒岭儒雅
// 与l=(int)me->query_skill("literate",1)有关
// 基本开始连续发3招 正气岱宗 忠勇西岳 恒岭儒雅
// 不可能发出的必杀技 五岳归来不看山
// added rumor by huarong 2003.3.13
// modify by huarong 2003.11
#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int calculate_damage(object me, object target, int base_damage, int damge_bonus);
int perform(object me, object target) {
  string msg, str, strr;
  object weapon;
  int myskill, k, l;
  int ap, ap2, dp, dp2, pp;
  int youcps, mycor, mystr, youstr;
  int damage_bonus, damage, wound, base_bonus;
  int delay;
  object ob;
  weapon = me->query_temp("weapon");

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［五岳封禅］只能对战斗中的对手使用。\n");
  if (me->query("family/family_name") != "火云洞")
    return notify_fail("“五岳封禅”只有火云洞门人才可以用！\n");

  myskill = (int)me->query_skill("wuyue-spear", 1);
  if (myskill < 140)
    return notify_fail("你的［五岳神枪］还不够纯熟！\n");
  myskill = (int)me->query_skill("pingtian-dafa", 1);

  if (time() - (int)me->query_temp("fengchan_end") < 8)
    return notify_fail("绝招用多就不灵了！\n");

  if (myskill < 100)
    return notify_fail("你的平天大法等级不够，不能使用这一招！\n");

  k = (int)me->query_skill("spear");
  if (k < 140)
    return notify_fail("你的枪法级别还不够，使用这一招会有困难！\n");
  l = (int)me->query_skill("literate", 1);
  if ((int)me->query("max_force") < 1000)
    return notify_fail("你的内功太差。\n");

  if ((int)me->query("force") < 500)
    return notify_fail("你的内力不够了。\n");

  mycor = me->query_cor();
  youcps = target->query_cps();
  ob = target->query_temp("weapon");
  str = "右臂";
  if (objectp(ob)) str = "手中的" + ob->query("name");
  ap = k;
  ap = (ap / 12) * ap * ap;
  ap += (int)me->query("combat_exp");
  dp = target->query("combat_exp");
  ap2 = COMBAT_D->skill_power(me, "spear", SKILL_USAGE_ATTACK);
  dp2 = COMBAT_D->skill_power(target, "dodge", SKILL_USAGE_DEFENSE);
  dp2 /= 2;
  pp = COMBAT_D->skill_power(target, "parry", SKILL_USAGE_DEFENSE);
  pp /= 2;
  if (objectp(ob)) pp /= 2;
  mystr = me->query_str();
  youstr = target->query_str();
  damage_bonus = k;
  damage_bonus = mystr * (damage_bonus + 100) / 500;
  base_bonus = damage_bonus;


  msg = HIC "$N" + HIC + "神功妙悟，" + weapon->query("name") + HIC "砸出一式\n\n";
  msg += HIC + "┏━━━━┓\n";
  msg += HIC "┃" + BLINK + "正气岱宗" + NOR + HIC + "┃\n";
  msg += HIC "┗━━━━┛\n";
  msg += HIC "一股浩然正气已笼罩$n" + HIC + "全身！\n";
  if (random(ap2 + pp) > pp / 2) {
    damage = calculate_damage(me, target, 140, base_bonus);
    wound = random(damage - (int)target->query_temp("apply/armor"));
    if (damage > 0) {
      target->receive_damage("kee", damage, me);
      if (wound > 0) target->receive_wound("kee", wound / 2, me);
      msg += HIR "结果$n" + HIR + "目瞪口呆，差点栽倒。\n" NOR;
      message_vision(msg, me, target);
      COMBAT_D->report_status(target);
    }
  } else {
    msg += HIB + "可是$p" + HIB + "看破了$P的企图，向后越开。\n" NOR;
    message_vision(msg, me, target);
  }
  msg = HIG + "$n" + HIG + "举起" + str + HIG "一架，不料枪风正气凛冽，微一迟疑。\n" NOR;
  msg += HIG + "$N" + HIG + "枪势斗转，" + weapon->query("name") + HIG + "发出摄人心魄的呼啸向$n" + HIG + "刺去！\n" NOR;
  msg += HIG "瞬间锋锐的枪尖已到了$n" + HIG + "的咽喉，\n";
  msg += HIG "   ┏━━━━┓\n";
  msg += HIG "   ┃" + BLINK + "忠勇西岳" + NOR + HIG + "┃\n";
  msg += HIG "   ┗━━━━┛\n";
  msg += HIG "这式犹如华山一条道直取$n" + HIG + "要害！\n";
  if (random(ap2 + pp) > pp / 2) {
    damage = calculate_damage(me, target, 160, base_bonus);
    wound = random(damage - (int)target->query_temp("apply/armor"));
    if (damage > 0) {
      target->receive_damage("kee", damage, me);
      if (wound > 0) target->receive_wound("kee", wound / 2, me);
      msg += HIR "结果$n" + HIR + "咽喉一麻，差点喘不过气来。\n" NOR;
      message_vision(msg, me, target);
      COMBAT_D->report_status(target);
    }
  } else {
    msg += HIB + "结果被$n" + HIB + "灵巧挡开了。\n" NOR;
    message_vision(msg, me, target);
  }
  msg = HIW "紧跟着$N" + HIW + "到转" + weapon->query("name") + HIW "尾刺向$n" + HIW + "的大腿，\n";
  msg += "同时长啸高吟“恒溪风流禅月明”——\n";
  msg += HIW "      ┏━━━━┓\n";
  msg += HIW "      ┃" + BLINK + "恒岭儒雅" + NOR + HIW + "┃\n";
  msg += HIW "      ┗━━━━┛\n";
  if (random(ap2 + pp) > pp / 2) {
    msg += "$n" + HIW + "紧闭双眼，胡乱拆招。\n" NOR;
    damage = calculate_damage(me, target, 180, base_bonus);
    wound = random(damage - (int)target->query_temp("apply/armor"));
    if (damage > 0) {
      target->receive_damage("kee", damage, me);
      if (wound > 0) target->receive_wound("kee", wound / 2, me);
      msg += HIR "这式俊秀倜傥，结果$n" + HIR + "的腿部被划开深深的一道口子。\n" NOR;
      message_vision(msg, me, target);
      COMBAT_D->report_status(target);
    }
  } else {
    msg += HIB + "$n" + HIB + "看准来势，挫身闪开了。\n" NOR;
    message_vision(msg, me, target);
  }
  msg = HIM "$N" + HIM + "接着顺势连人带" + weapon->query("name") + HIM "撞向$n" + HIM + "，仿佛如椽巨笔饱墨临纸。\n";
  msg += HIM "         ┏━━━━┓\n";
  msg += HIM "         ┃" + BLINK + "文章衡峰" + NOR + HIM + "┃\n";
  msg += HIM "         ┗━━━━┛\n";
  msg += HIM "这式深得“如椽健笔意纵横”的神髓！\n" NOR;
  if ((random(youcps) < 15 || random(ap + dp + ap2 + dp2) > (dp + dp2) / 2) && k >= 200 && l >= 200) {
    damage = calculate_damage(me, target, 200, base_bonus);
    wound = random(damage - (int)target->query_temp("apply/armor"));
    if (damage > 0) {
      target->receive_damage("kee", damage, me);
      if (wound > 0) target->receive_wound("kee", wound / 2, me);
      msg += HIM + "此举令$n" + HIM + "肝胆俱裂！\n" NOR;
      msg += HIR "结果$n" + HIR + "神智迷糊，差点晕倒。\n" NOR;
      message_vision(msg, me, target);
      COMBAT_D->report_status(target);
    }
  } else {
    msg += HIB + "结果$n" + HIB + "一个踉跄，却没摔倒。\n" NOR;
    message_vision(msg, me, target);
  }
  msg = HIY "$N" + HIY + "枪意绵绵，" + weapon->query("name") + HIY "平平正正，直取中路刺向$n！\n";
  msg += HIY "            ┏━━━━┓\n";
  msg += HIY "            ┃" + BLINK + "平冲中庸" + NOR + HIY + "┃\n";
  msg += HIY "            ┗━━━━┛\n";
  msg += HIY "这式登堂入室，把基本枪法的“中平”一式发挥到妙到毫巅！\n" NOR;
  if ((random(youcps) < 15 || random(ap + dp + ap2 + dp2) > (dp + dp2) / 2) && k >= 240 && l >= 240) {
    damage = calculate_damage(me, target, 220, base_bonus);
    wound = random(damage - (int)target->query_temp("apply/armor"));
    if (damage > 0) {
      target->receive_damage("kee", damage, me);
      if (wound > 0) target->receive_wound("kee", wound / 2, me);
      msg += "$n" + HIY + "不晓这招厉害，居然不知如何应付！\n" NOR;
      msg += HIR "结果“噗！”的一声，$n" + HIR + "胸口被搠出个大窟窿！\n" NOR;
      message_vision(msg, me, target);
      COMBAT_D->report_status(target);
    }
  } else {
    msg += HIB + "结果$n" + HIB + "早有准备，轻松闪开。\n" NOR;
    message_vision(msg, me, target);
  }
  // 此招一出，必死
  // ap2+pp>pp
  // 有效等级大于300，读书识字大于180
  // 300随机值大于297
  // 随机福缘大于25
  // 同时满足，概率极其微小
  if (random(ap2 + pp) > pp && k > 300 && l > 300 && random(300) > 297 && random(me->query("kar")) > 25) {
    msg = RED "\n$N" + RED + "脸上露出恐惧之色，" + weapon->query("name") + RED "竟然不听使唤，";
    msg += "犹如妖魔控制一般，\n在枪意已尽，劲势已灭之际，又生新力，又续杀机，死神般活跃！\n" NOR;
    msg += RED "┏━━━━━━━┓\n";
    msg += RED "┃" + BLINK + "五岳归来不看山" + NOR + RED + "┃\n";
    msg += RED "┗━━━━━━━┛\n";
    msg += RED "这式受天上地下十万神魔诅咒过的一招，真是鬼泣神啼，天地顿时失色！\n" NOR;
    me->start_call_out((: call_other, __FILE__, "kill_him", me, target :), random(2) + 4);
    message_vision(msg, me, target);
  }
  if ((target->query("eff_kee") < 0 || (!living(target) && target->query("kee") < 0)) && random(5) == 1) {
    strr = target->name() + HIM "被" + HIY + me->name() + HIM "用火云绝学" NOR + RED "「五岳封禅」" + HIM "砸死了，据说死的时候" + target->name() + HIM "呆呆的看着自己胸口上碗口般大的枪洞！";
    message("channel:rumor", HIM "【空穴来风】某人：" + strr + "\n" NOR, users());
  }

  delay = random(2) + 1;
  me->start_busy(delay);
  me->add("force", -500);
  me->set_temp("fengchan_end", time());
  return 1;
}

int calculate_damage(object me, object target, int base_damage, int damage_bonus) {
  int damage, i;
  int myexp, youexp;

  damage = base_damage + damage_bonus / 3 + random(damage_bonus) / 3;
  myexp = me->query("combat_exp");
  youexp = target->query("combat_exp");
  i = random(youexp + myexp);

  if (i >= youexp * 5 / 3) damage = damage;
  else if (i < youexp * 5 / 3) damage = damage * 4 / 5;
  else if (i < youexp * 4 / 3) damage = damage * 3 / 5;
  else if (i < youexp) damage = damage * 2 / 5;
  else damage = damage / 5;

  if (myexp > youexp * 5) damage = damage * 3;
  else if (myexp > youexp * 4) damage = damage * 5 / 2;
  else if (myexp > youexp * 3) damage = damage * 2;
  else if (myexp > youexp * 2) damage = damage * 3 / 2;
  else damage = damage;

  if (wizardp(me) && me->query("env/combat") == "verbose") {
    tell_object(me, sprintf(HIY + "i: %d\n" NOR, i));
    tell_object(me, sprintf(HIY + "youexp: %d\n" NOR, youexp));
    tell_object(me, sprintf(HIM + BLINK + "damage: %d\n" NOR, damage));
  }

  return damage;
}

void kill_him(object me, object target) {
  string msg;
  if (me->is_fighting() && target->is_fighting() &&
    environment(me) == environment(target)) {
    msg = HIR "\n$n" + HIR + "只觉得眼前一花，咽喉已被对穿而过！！！\n\n一股血箭喷涌而出．．$n" + HIR + "的眼睛死鱼般的突了出来．．\n" NOR;
    target->receive_damage("sen", target->query("max_sen") + 1, me);
    target->receive_wound("sen", (int)target->query("max_sen") + 1, me);
    target->receive_damage("kee", target->query("max_kee") + 1, me);
    target->receive_wound("kee", (int)target->query("max_kee") + 1, me);
    msg += HIR "\n$N" + HIR + "看着$n" + HIR + "的尸体，冷汗直冒．．\n" NOR;
    COMBAT_D->report_status(target);

    message_vision(msg, me, target);
    target->heart_beat();
  }
  return;
}
