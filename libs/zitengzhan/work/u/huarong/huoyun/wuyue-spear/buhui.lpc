//modify for 大唐西游2 by huarong 2003/12
#include <ansi.h>

inherit SSERVER;
//inherit F_CLEAN_UP;

int perform(object me, object target) {
  object weapon;
  int i, j, k, m, n, damage, skill, skill1, skill2, ratio;
  weapon = me->query_temp("weapon");

  skill = me->query_skill("wuyue-spear", 1);
  skill1 = me->query_skill("spear", 1);
  skill2 = me->query_skill("parry", 1);
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)

    return notify_fail("你要攻击谁？\n");

  if (!me->is_fighting())
    return notify_fail("你们没有在打架！\n");
  if (me->query("family/family_name") != "火云洞")
    return notify_fail(HIM "〖不悔〗只有火云洞门人才可以用！\n" NOR);

  if ((int)me->query("max_force") < 1000)
    return notify_fail("你的内功太差。\n");

  if ((int)me->query("force") < 500)
    return notify_fail("你的内力不足！\n");

  if ((int)me->query("sen") < 100)
    return notify_fail("你的精神不足，没法子施用外功！\n");

  if ((int)me->query_skill("pingtian-dafa", 1) < 100)
    return notify_fail("你的平天大法等级不够，不能使用这一招！\n");
  if (time() - (int)me->query_temp("buhui_end") < 6)
    return notify_fail("你刚出过不悔，气息还未调顺！\n");

  if ((int)me->query_skill("spear", 1) < 100)
    return notify_fail("你的基本枪法级别还不够，使用这一招会有困难！\n");
  if ((int)me->query_skill("wuyue-spear", 1) < 100)
    return notify_fail("你的五岳神枪级别还不够，使用这一招会有困难！\n");
  if ((skill - skill1) > 100)
    return notify_fail("你的基本枪法等级不够，不能使用这一招！\n");
  if ((skill - skill2) > 100)
    return notify_fail("你的拆招卸力等级不够，不能使用这一招！\n");
  me->delete("env/brief_message");
  target->delete("env/brief_message");
  me->set_temp("buhui_end", time());
  message_vision(HIM "\n$N" + HIM + "一挺手中" + weapon->name() + NOR + HIB "直刺$n！\n" NOR, me, target);
  i = (int)me->query("combat_exp");
  j = (int)target->query("combat_exp");

  ratio = (i / 10) / (j / 1000);
  if (ratio > 300) ratio = 300;
  if (ratio < 20) ratio = 20;
  k = skill + skill1 / 2 + skill2 / 2;
  n = k / 200;
  if (n < 2) n = 2;
  if (n > 5) n = 5;
  for (m = 1; m <= n; m++) {
    if (random(i + j) > j / 2) {
      damage = k / 2 + random(k / 3) + (int)me->query("str");
      damage = damage * ratio / 100;
      target->receive_damage("kee", damage / 2, me);
      target->receive_wound("kee", damage / 3, me);
      if (wizardp(me) && me->query("env/combat") == "verbose")
        tell_object(me, sprintf(HIM + BLINK + "damage: %d\n" NOR, damage / 2));
      COMBAT_D->report_status(target);
      switch (random(3)) {
        case 0: {
          message_vision(HIM "$N" + HIM + "一枪刺中，又是一枪，直刺向$n！\n" NOR, me, target);
          break;
        };

        case 1: {
          message_vision(HIM "$N" + HIM + "一枪得手，身形一晃，反手又是一枪，戳向$n！\n" NOR, me, target);
          break;
        };

        case 2: {
          message_vision(HIM "$N" + HIM + "一枪刺中，得势不饶人，运起火魔真气，抖手又是一枪刺向$n！\n" NOR, me, target);
          break;
        };
      }

    } else {
      switch (random(3)) {
        case 0: {
          message_vision(HIM "$N" + HIM + "一枪刺空，又是一肘，仍击向$n！\n" NOR, me, target);
          break;
        };

        case 1: {
          message_vision(HIM "$N" + HIM + "一枪刺空，身形一晃，抖手又是一枪，戳向$n！\n" NOR, me, target);
          break;
        };

        case 2: {
          message_vision(HIM "$N" + HIM + "一肘又空，但仍不收着，回手又是一枪！\n" NOR, me, target);
          break;
        };
      }
    }
  }

  me->receive_damage("sen", 50);
  me->add("force", -100 - (int)me->query("force_factor"));
  me->receive_damage("kee", 30);
  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
  }
  me->start_busy(1 + random(2));
  return 1;
}
