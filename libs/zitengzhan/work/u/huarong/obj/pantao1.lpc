#include <ansi.h>

inherit ITEM;

int do_eat(string);
int give_reward(object);
void init();

void init() {
  if (!wizardp(this_player())) {
    set("no_give", "这么珍贵的药，哪能随便给人？\n");
    set("no_drop", "这么宝贵的丹药，扔了多可惜呀！\n");
    set("no_sell", "凡人哪里知道" + this_object()->query("name") + "的价值？还是自己留着吧。\n");
  }
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIY "三千年" + HIM + "蟠桃" NOR, ({ "pan tao", "pantao", "tao" }));
  set_weight(20);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "枚");
    set("long", HIC "一枚核桃大小的蟠桃，三千年一开花，三千年一结果。\n" NOR);
    set("value", 30000);
    set("drug_type", "补品");
    set("reward_value", 1);
  }

  setup();
}

int do_eat(string arg) {
  object me = this_player();

  message_vision(HIM "\n这个桃子果然是与众不同的啊！只见它外表是那么的平凡无奇，以至于把
  它放到三轮车上都可以在早市上出售。但当你一口咬下去的时候，你全身
  上下的每个毛孔都会散发出处女的幽香，简直完全处在一个忘我的境地！
  它真的可以称的上是桃中之神！简称桃神！\n\n" NOR, me);

  me->set("food", (int)me->max_food_capacity());
  give_reward(me);
  destruct(this_object());

  return 1;
}

int give_reward(object me) {
  me->add_maximum_force(3 + random(3 * (int)query("reward_value")));
  me->add_maximum_mana(3 + random(3 * (int)query("reward_value")));
  return 1;
}
