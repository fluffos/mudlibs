//mooncake.c 
//create by huarong 2004中秋节

#include <ansi.h>

inherit ITEM;

string *cakename = ({
  HIR "双黄莲蓉" NOR,
  HIG "蛋黄伍仁" NOR,
  RED "蛋黄豆沙" NOR,
  HIY "蛋黄椰皇" NOR,
  HIY "金翡翠蛋黄" NOR,
  HIM "燕窝金箔" NOR,
  HIC "金箔鱼翅" NOR,
  HIW "白莲蓉双蛋黄" NOR,
  HIY "金翡翠莲蓉" NOR,
  WHT "蛋黄白莲茸" NOR,
  RED "蛋黄红莲茸" NOR,
  HIW "日式奶酥" NOR,
  HIR "金腿五仁" NOR,
  HIB "香菇牛肉" NOR,
  HIG "绿豆凸" NOR,
  HIB "栗茸" NOR,
  HIY "鲍鱼蛋黄" NOR,
  HIR "红豆沙" NOR,
});
int do_eat(string);
void init();

void init() {
  if (!wizardp(this_player())) {
    set("no_get", "你手里一松" + this_object()->query("name") + "从指间滑落！\n");
    set("no_give", "这么珍贵的东东，哪能随便给人？\n");
    set("no_drop", "这么宝贵的东东，扔了多可惜呀！\n");
    set("no_sell", "凡人哪里知道" + this_object()->query("name") + "的价值？还是自己留着吧。\n");
  }
  add_action("do_eat", "eat");
}

void create() {
  set_name(cakename[random(sizeof(cakename))] + HIY + "月饼" + NOR, ({ "moon cake", "cake" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", HIY "天狼星大人精美制作的二零零四年中秋月饼。\n" NOR);
    set("value", 100000);
  }

  set("is_monitored", 1);
  setup();
}

int do_eat(string arg) {
  object me = this_player();
  string str;
  int wxreward, dxreward;
  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  if (this_object()->query("ownerid") != me->query("id") && !wizardp(me))
    return notify_fail("这个月饼恐怕不是你的吧？\n");

  if (!wizardp(me))
    me->set("huarong/中秋", "2004");
  wxreward = me->query("combat_exp", 1) / 50 > 250000 ? 250000 : me->query("combat_exp", 1) / 50;
  dxreward = me->query("daoxing", 1) / 50 > 250000 ? 250000 : me->query("daoxing", 1) / 50;
  str = HIW + me->name() + HIM + "得到了中秋礼物，送上我们的祝福：" + HIY + "   中秋佳节快乐，月圆人圆事事圆满！" NOR;
  message_vision(HIY + "$N美滋滋的吃下了一个" + this_object()->query("name") + HIY + "。\n" NOR, me);
  message("channel:rumor", HIM "【空穴来风】某人：" + str + "\n" NOR, users());

  message_vision(
    HIM + "＃" + HIG + "〓" + HIB + "§" + HIG + "〓〓〓〓〓" + HIB + "§" + HIG + "〓〓〓〓〓〓" + HIB + "§" + HIG + "〓〓〓〓〓" + HIB + "§" + HIG + "〓" + HIM + "＃      \n" NOR,
    me
  );
  message_vision(HIB + "　　↓　　　　　↓　　　　　　↓　　　　　↓          \n" NOR, me);
  message_vision(
    HIC + "　☆" + HIR + "★" + HIC + "☆　　　☆" + HIR + "★" + HIC + "☆　　　　☆" + HIR + "★" + HIC + "☆　　　☆" + HIR + "★" + HIC + "☆    \n" NOR,
    me
  );
  message_vision(
    HIC + "☆　" + HIY + BLINK + "中" + NOR + HIC + "　☆　☆　" + HIY + BLINK + "秋" + NOR + HIC + "　☆　　☆　" + HIY + BLINK + "快" + NOR + HIC + "　☆　☆　" + HIY + BLINK + "乐" + NOR + HIC + "　☆  \n" NOR,
    me
  );
  message_vision(
    HIC + "　☆" + HIR + "★" + HIC + "☆　　　☆" + HIR + "★" + HIC + "☆　　　　☆" + HIR + "★" + HIC + "☆　　　☆" + HIR + "★" + HIC + "☆    \n" NOR,
    me
  );
  message_vision(HIB + "　　↓　　　　　↓　　　　　　↓　　　　　↓          \n" NOR, me);
  message_vision(HIB + "　　※　　　　　※　　　　　　※　　　　　※      \n\n" NOR, me);

  me->add("combat_exp", wxreward);
  me->add("daoxing", dxreward);
  me->add("potential", 10000);
  me->set("data_watch_time", time());
  me->set("data_watch_exp", me->query("combat_exp", 1) + me->query("daoxing", 1));
  me->save();

  destruct(this_object());
  return 1;
}
