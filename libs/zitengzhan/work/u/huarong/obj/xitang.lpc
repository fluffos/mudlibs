#include <ansi.h>
inherit ITEM;

void setup()
{}

int do_eat(string);
void destroy();
void init();
void init()
{
  if (!wizardp(this_player())) {
    set("no_get","你手里一松"+this_object()->query("name")+"从指间滑落！\n");
    set("no_give","这么珍贵的药，哪能随便给人？\n");
    set("no_drop","这么宝贵的丹药，扔了多可惜呀！\n");
    set("no_sell","凡人哪里知道"+this_object()->query("name")+"的价值？还是自己留着吧。\n");
  }                                    
    add_action("do_eat", "eat");
    call_out("destroy", 120);
}
void create()
{
    set_name(HIR"喜糖"NOR, ({"xi tang", "tang"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
       set("unit", "颗");
       set("long", "这是阿尔卑斯的喜糖,不时散发出阵阵芳香。(eat xi tang)\n");
        set("value", 0);
        }
        set("is_monitored",1);
        setup();
}

int do_eat(string arg)
{
        object me = this_player();
        if (!id(arg))
        return notify_fail("你要吃什么？\n");
    this_player()->add("potential",1000);
    message_vision(HIW"$N吃下一颗阿尔卑斯的喜糖，不觉甜到心里！\n"NOR,this_player());
    message_vision(HIY"$N仿佛也感受到了华奇的幸福，$N同时也获得了系统的祝福，$N的潜能增长了！\n"NOR,this_player());
    destruct(this_object());
    return 1;

}

void destroy()
{
  destruct(this_object());
}


