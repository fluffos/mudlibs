// sgzl

#include <weapon.h>
#include <ansi.h>

inherit THROWING;

void create() {
  set_name("孔雀翎", ({ "kongque ling", "ling" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "经过精选过的孔雀身上的羽毛。\n");
    set("unit", "把");
    set("base_unit", "支");
    set("base_weight", 4);
    set("no_sell", 1);
    set("value", 1000);
  }
  set_amount(1000);
  init_throwing(55);
  setup();
}
