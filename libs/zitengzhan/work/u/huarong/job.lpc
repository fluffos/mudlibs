//郭靖

#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void autorecover();
void autoheal();
void dosomething();
void random_place(object me, object who);
int xianglong_start();

void create() {
  set_name("郭靖", ({ "guojing", "guo" }));
  set("title", "北侠");
  set("nickname", HIY "正气凛然" NOR);
  set("long",
    HIY "他就是人称北侠的郭靖。他浓眉大眼，满脸正气！\n" NOR);
  set("gender", "男性");
  set("age", 40);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("str", 28);
  set("int", 25);
  set("con", 26);
  set("dex", 22);
  set("per", 30);
  set("inquiry", ([
    "杨过": "过儿那次生气走了以后，听说去东海练剑去了，也不知道是不是真的，没有消息。\n",
    "黄蓉": "我老婆啊，回娘家探亲去了。\n",
    "洪七公": "他老人家已经把丐帮的事务交给乔帮主了，自己云游四方去了，我也不知道他在哪？\n",
    "王重阳": "他老人家也很久不见了，甚为挂念，你有他老人家的消息么？\n",
    "降龙十八掌": (: xianglong_start :),

  ]));
  set("max_gin", 1500);
  set("take/xianglong_kanglong", "done");
  set("gin", 1500);
  set("max_sen", 1500);
  set("no_get", 1);
  set("sen", 1500);
  set("max_kee", 5000);
  set("kee", 5000);
  set("max_atman", 1000);
  set("atman", 1000);
  set("force", 30000);
  set("max_force", 13000);
  set("force_factor", 200);
  set("env/no_teach", 1);
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: dosomething :) }));
  set("chat_chance", 50);
  set("chat_msg", ({
    (: autoheal :), }));
  set("combat_exp", 3000000);
  set("score", 30000);
  set_skill("force", 801);
  set_skill("hunyuan-qigong", 801);
  set_skill("dodge", 200);
  set_skill("daoxuexinde", 200);
  set_skill("tianlong-shenfa", 200);
  set_skill("unarmed", 200);
  set_skill("xianglong-zhang", 801);
  set_skill("parry", 200);

  map_skill("force", "hunyuan-qigong");
  map_skill("dodge", "tianlong-shenfa");
  map_skill("unarmed", "xianglong-zhang");
  map_skill("parry", "xianglong-zhang");


  setup();
  //  	carry_object(__DIR__"obj/cloth")->wear();
  //        carry_object(__DIR__"obj/shoutao")->wield();
  //        add_money("gold",2);  
}

void init() {
  add_action("do_kill", "kill");
  add_action("do_hit", "hit");
}

int do_kill(string arg) {
  if (arg == "guo" || arg == "guojing") {
    if (this_player()->query("combat_exp", 1) < 100000) {
      command("say 快滚，你没有资格和我动手！");
      return 1;
    }

    command("chat 好个" + this_player()->query("name") + "！");
    command("chat 这可是你逼我的，休怪我无情！");
    this_object()->kill_ob(this_player());
    this_player()->start_busy(3);
    this_object()->set("force_factor", 150);
    return 1;
  } else
    return 0;
}

int do_hit(string arg) {

  if (arg == "guo" || arg == "guojing") {
    if (this_player()->query("combat_exp", 1) < 100000) {
      command("say 快滚，你没有资格和我动手！");
      return 1;
    }
    command("chat 好个" + this_player()->query("name") + "！");
    command("chat 这可是你逼我的，休怪我无情！");
    this_object()->kill_ob(this_player());
    this_player()->start_busy(3);
    this_object()->set("force_factor", 150);
    return 1;
  } else
    return 0;
}
void dosomething() {
  if (random(25) > 5) {
    command("perform kanglong");
  }

  autorecover();
}

void autorecover()

{
  object me, ob;
  me = this_object();
  if (me->query("kee") < me->query("eff_kee")) {
    command("yun recover");
  }
}

void autoheal() {
  object me;
  int i;

  me = this_object();

  if (me->query("eff_kee") > (me->query("max_kee") / 4)) {}
}

int accept_fight(object who) {
  int i;
  object me = this_object();
  object npc, env, *inv;
  env = environment(this_object());
  npc = new(__DIR__ "haoke");
  message_vision("$N一声大喝：“弟兄，鞑子的奸细来了。”\n"
    "一群江湖豪客冲了出来，围住$n。\n", me, who);
  npc->move(env);
  this_object()->kill_ob(who);
  inv = all_inventory(env);
  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i]->query("id") != "jianghu haoke" && inv[i]->query("id") != "haoke") continue;
    inv[i]->kill_ob(who);
  }
}
int accept_kill(object ob) {
  command("say 你要找死么？");
  return 1;
}


int xianglong_start() {
  object who, me;
  me = this_object();
  who = this_player();
  if (who->query("take/xianglong_guojing") == "done") {
    message_vision("\n郭靖对$N抱拳道：" + RANK_D->query_respect(who) + "别来无恙！\n\n", who);
    return 2;
  }
  if ((who->query_temp("take/xianglong_guojing_kill") >= 50) && (!me->query_temp("take/xianglongstart"))) {
    call_out("xianglongend", 1, me, who);
    return 2;
  }
  if (who->query_temp("take/xianglong_guojing") == "begin") {
    message_vision(HIW "\n郭靖凌然道：鞑子攻城正急，哪里有空跟你啰嗦。\n\n" NOR, who);
    return 2;
  }
  if (me->query_temp("take/xianglong")) {
    message_vision(HIW "\n郭靖拱手对$N道：鞑子攻城正急，如" + RANK_D->query_respect(who) + "有事暂缓商议。\n\n" NOR, who);
    return 2;
  }
  message_vision("\n郭靖看了看$N说：既然阁下知道" + HIY "[降龙十八掌]" NOR + "乃丐帮镇帮掌法，怎能随便传给不相识之人？\n\n", who);
  me->set_temp("take/xianglong", 1);
  me->set_temp("take/xianglongstart", 1);
  call_out("start_xianglong", 3600, me);
  call_out("xianglong1", 3, me, who);
  return 2;
}

void start_xianglong(object me) {
  me->delete_temp("take/xianglong");
}

void xianglong1(object me, object who) {
  if (!who || !visible(who) || environment(who) != environment()) return;
  message_vision(HIY "\n\n\n\n突然间，从屋外冲进一个士兵。。。。。。。\n\n\n\n" NOR, who);
  call_out("xianglong2", 3, me, who);
}

void xianglong2(object me, object who) {
  if (!who) return;
  message_vision("\n\n\n\n士兵说道：郭大侠，一伙蒙古鞑子攻打北门正急。\n\n\n\n" NOR, who);
  message_vision("郭靖说道：好猖狂的鞑子，三番五次欺我大宋百姓，待我去会会他们。\n\n\n\n" NOR, who);
  me->move("/d/xiangyang/beichl");
  who->set_temp("take/xianglong_guojing", "begin");
  who->delete_temp("take/xianglong_guojing_kill");
  call_out("xianglong3", 1, me, who);
}

void xianglong3(object me, object who) {
  int i, j, inv;
  object bing, toumu;
  inv = 40;
  j = 1;
  for (i = 0; i <= inv; i++) {
    bing = new("/d/xiangyang/npc/dazi");
    bing->set("xianglong", who);
    bing->invocation(bing, who);
  }
  inv = random(5) + 3;
  for (i = 0; i <= inv; i++) {
    toumu = new("/d/xiangyang/npc/toumu");
    toumu->set("xianglong", who);
    toumu->invocation(toumu, who);
  }
  if (j != 2) {
    j = 2;
    call_out("xianglong3()", 360, me, who);
    call_out("xianglong4()", 600, me);
  }
}

void xianglongend(object me, object who) {
  message_vision(
    "\n\n\n\n郭靖拱手说道：多谢这位" + RANK_D->query_respect(who) + "援手保护襄阳百姓，" + RANK_D->query_respect(who) + "武功过人，行侠仗义，
正是我辈中人，如若不嫌弃，在下教" + RANK_D->query_respect(who) + "一招 [" NOR + HIY "亢龙有悔" NOR + "] ，" + RANK_D->query_respect(who) + "以后行走江
湖定然用得着。看好了！\n\n\n\n" NOR,
    who
  );
  who->start_busy(600);
  who->set("take/xianglong_guojing", "done");
  call_out("xianglongend1", 5, me, who);
}

void xianglongend1(object me, object who) {
  message_vision("郭靖站起身来，走到大厅中间，运起内力，聚全身气劲于右掌间，猛然间向外击出，
郭靖的右手化作一条金色巨龙张牙舞爪地呼啸扑出，势不可挡！\n\n\n\n" NOR, who);
  call_out("xianglongend2", 5, me, who);
}

void xianglongend2(object me, object who) {
  message_vision("$N只看的目瞪口呆，一招 [" HIY "亢龙有悔" NOR + "] 发完整个大厅中隐隐还能听到四海龙吟之声！\n\n\n\n" NOR, who);
  call_out("xianglongend3", 5, me, who);
}

void xianglongend3(object me, object who) {
  message_vision(
    "郭靖收住掌势对$N道：" + RANK_D->query_respect(who) + "这招 [" + HIY "亢龙有悔" NOR + " ]旨在[ 悔 ]，而不在[ 亢 ]，打出
三分力却要收七分，你先好好想想。\n\n\n\n" NOR,
    who
  );
  message_vision(HIR "$N若有所思地缓缓坐下，脑中渐渐浮现出金色巨龙的影子。。。。。。\n\n\n\n" NOR, who);
  call_out("xianglongend4", 15, me, who);
}

void xianglongend4(object me, object who) {
  int i;
  i = random(who->query_temp("take/xianglong_guojing_kill"));
  who->start_busy(2);
  who->add("combat_exp", who->query_temp("take/xianglong_guojing_kill") * 500);
  if (i > 90) {
    message_vision(HIY "不知过了多久，$N脑中金色巨龙渐渐地清晰起来，猛然间$N不自觉地一声长啸，只震的
四壁晃动。\n\n\n\n" NOR, who);
    message_vision(
      "待$N睁开双眼，郭靖正微笑地看着$N道：恭喜" + RANK_D->query_respect(who) + "终于学会这招 [" + HIY "亢龙有悔" NOR + " ]，郭靖
这里还有一言相赠。" + RANK_D->query_respect(who) + "日后闯荡江湖切记在下一句话：\n\n" NOR,
      who
    );
    message_vision(HIW "                              为国为民，侠之大者\n\n\n\n" NOR, who);
    who->set("take/xianglong_kanglong", "done");
    command("chat " + NOR "" HIR + who->query("name") + NOR "" HIC + RANK_D->query_respect(who) + "助我镇守襄阳，抗击蒙古鞑子杀敌无数，奖励经验" + chinese_number(who->query_temp("take/xianglong_guojing_kill") * 500) + "点。\n" NOR);
    return;
  }
  message_vision(HIR "良久，$N只觉得全身气血逆行，经脉错动，眼前一黑，一口乌血喷了出来。\n\n\n\n" NOR, who);
  call_out("xianglongend5", 3, me, who);
}

void xianglongend5(object me, object who) {
  message_vision(
    "郭靖见状急忙走过来运气护住$N经脉，急道：" + RANK_D->query_respect(who) + "无缘学这绝招，切不可强求！\n\n\n\n" NOR,
    who
  );
  message_vision("$N自知功亏一篑，只得仰天长叹。。。。。。\n\n\n\n" NOR, who);
  command("chat " + NOR "" HIR + who->query("name") + NOR "" HIC + RANK_D->query_respect(who) + "助我镇守襄阳，抗击蒙古鞑子杀敌无数，奖励经验" + chinese_number(who->query_temp("take/xianglong_guojing_kill") * 500) + "点。\n" NOR);
  return;
}

void xianglong4(object me) {
  me->move("/d/xiangyang/neiyuan");
  me->delete_temp("take/xianglongstart");
}
