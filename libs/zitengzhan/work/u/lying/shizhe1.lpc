#include <ansi.h>
inherit NPC;
string ask_me();
int family_present();

void create() {
  set_name(MAG "大唐使者" NOR, ({ "ziteng shizhe", "shizhe" }));
  set("nickname", HIY "不知情愁枉少年" NOR);
  set("gender", "男性");
  set("age", 18);
  set("long", YEL "这位是〖青岛站〗的使者，向他打听“大唐”，他会带给您想不到的惊喜。\n" NOR);
  //   set("shen_type", 1);
  set("combat_exp", 1000000);
  set("str", 30);
  set("dex", 30);
  set("con", 30);
  set("int", 30);
  set("per", 30);
  set("attitude", "friendly");
  //    set("max_qi", 100000);
  //    set("neili", 100000);
  //    set("max_neili", 100000);
  //    set("score", 100000);

  set("inquiry", ([
    "大唐": (: ask_me :),
    "师门": (: family_present :),
    "师门奖励": (: family_present :),
  ]));
  setup();
  carry_object("/d/obj/cloth/magua")->wear();
}

void init() {
  object ob;
  ob = this_player();
  ::init();
  if (interactive(ob) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  command("whisper " + ob->query("id") + " " HIW "欢迎光临〖青岛站〗" + HIR + "(ask shizhe about 大唐) " + NOR + HIW + "， 小的助您行走江湖．" NOR);
  //    command("dtxy " + HIC"青岛站 更换ip 欢迎新老玩家,IP: 127.0.0.1 Port: 6666 \n"NOR)
  ;
}

string ask_me() {
  object me = this_player();
  object ob;
  mapping fam;

  if ((int)me->query("welcomexhc"))
    return "呵呵～这就是您的不是了！小的已经对您施过法力了！";
  else {
    me->set("welcomexhc", 1);
    me->set("maximum_force", 800);
    me->set("maximum_mana", 800);
    me->add("force", 1600);
    me->add("max_force", 800);
    me->add("max_mana", 800);
    me->add("mana", 1600);
    me->add("potential", 50000);
    me->add("daoxing", 80000);
    //    me->add("food", 1300);
    //    me->add("water", 10000);
    me->add("combat_exp", 100000);
    //下面就是给钱。其实除了move以外，还可以add存款。就是add banlance.
    //目前是1 gold.你自己选奖励是什么。

    CHANNEL_D->do_channel(
      me,
      "dtxy",
      sprintf(
        "在下%s今日光临〖青岛站〗（ip:127.0.0.1 port: 6666）\n         现已得到大唐使者的帮助和奖励！即日起开始行走江湖了！",
        me->name(1)
      )
    ); return "欢迎光临" NOR + HIR "〖青岛站〗" NOR "，小的护架来迟，罪该万死！在下可助您行走江湖！\n"
      HIW "突然天空中一道" HIM "七" HIY "彩" HIR "霞" HIC "光" HIW "笼罩四方，转瞬即逝！" NOR;
  }
}
int family_present() {
  object me = this_player();
  if (!me->query("family")) {
    command("say 你还没有拜师呢！");
    command("hehe");
    return 1;
  }
  if (me->query("family_present")) {
    command("say 呵呵～这就是您的不是了！小的已经对您施过法力了！");
    return 1;
  }
  me->set("family_present", 1);
  if (me->query("family/family_name") == "南海普陀山") {
    me->set_skill("bighammer", 60);
    me->set_skill("buddhism", 60);
    me->set_skill("huoyun-qiang", 60);
    me->set_skill("jienan-zhi", 60);
    me->set_skill("lotusforce", 60);
    me->set_skill("lotusmove", 60);
    me->set_skill("lunhui-zhang", 60);
  } else if (me->query("family/family_name") == "五庄观") {
    me->set_skill("baguazhen", 60);
    me->set_skill("fumo-zhang", 60);
    me->set_skill("kaishan-chui", 60);
    me->set_skill("sanqing-jian", 60);
    me->set_skill("taiyi", 60);
    me->set_skill("wuxing-quan", 60);
    me->set_skill("yange-blade", 60);
    me->set_skill("zhenyuan-force", 60);
  } else if (me->query("family/family_name") == "神剑山庄") {
    me->set_skill("cloudforce", 60);
    me->set_skill("duo-sword", 60);
    me->set_skill("lianhuan-zhang", 60);
    me->set_skill("qingfeng-jian", 60);
    me->set_skill("shadowsteps", 60);
    me->set_skill("xueying-xianfa", 60);
    me->set_skill("shenji-blade", 60);
  } else if (me->query("family/family_name") == "武圣门") {
    me->set_skill("feisheng", 60);
    me->set_skill("fumobashi", 60);
    me->set_skill("mizongbu", 60);
    me->set_skill("wuying", 60);
    me->set_skill("xiantian", 60);
  } else if (me->query("family/family_name") == "月宫") {
    me->set_skill("baihua-zhang", 60);
    me->set_skill("moondance", 60);
    me->set_skill("moonforce", 60);
    me->set_skill("moonshentong", 60);
    me->set_skill("snowsword", 60);
    me->set_skill("xuanhu-blade", 60);
  } else if (me->query("family/family_name") == "方寸山三星洞") {
    me->set_skill("dao", 60);
    me->set_skill("jindouyun", 60);
    me->set_skill("liangyi-sword", 60);
    me->set_skill("puti-zhi", 60);
    me->set_skill("qianjun-bang", 60);
    me->set_skill("wuxiangforce", 60);
  } else if (me->query("family/family_name") == "阎罗地府") {
    me->set_skill("ghost-steps", 60);
    me->set_skill("gouhunshu", 60);
    me->set_skill("hellfire-whip", 60);
    me->set_skill("jinghun-zhang", 60);
    me->set_skill("kusang-bang", 60);
    me->set_skill("tonsillit", 60);
    me->set_skill("zhuihun-sword", 60);
  } else if (me->query("family/family_name") == "东海龙宫") {
    me->set_skill("dragonfight", 60);
    me->set_skill("dragonforce", 60);
    me->set_skill("dragonstep", 60);
    me->set_skill("fengbo-cha", 60);
    me->set_skill("huntian-hammer", 60);
    me->set_skill("seashentong", 60);
  } else if (me->query("family/family_name") == "乱石山碧波潭" || me->query("family/family_name") == "火云洞" || me->query("family/family_name") == "翠云山芭蕉洞") {
    me->set_skill("dali-bang", 60);
    me->set_skill("huomoforce", 60);
    me->set_skill("huoyun-qiang", 60);
    me->set_skill("moshenbu", 60);
    me->set_skill("moyun-shou", 60);
    me->set_skill("pingtian-dafa", 60);
    me->set_skill("wuyue-spear", 60);
    me->set_skill("yueya-chan", 60);
  } else if (me->query("family/family_name") == "大雪山") {
    me->set_skill("bainiao-jian", 60);
    me->set_skill("bingpo-blade", 60);
    me->set_skill("cuixin-zhang", 60);
    me->set_skill("dengxian-dafa", 60);
    me->set_skill("ningxie-force", 60);
    me->set_skill("xiaoyaoyou", 60);
  } else if (me->query("family/family_name") == "将军府") {
    me->set_skill("bawang-qiang", 60);
    me->set_skill("changquan", 60);
    me->set_skill("lengquan-force", 60);
    me->set_skill("wusi-mace", 60);
    me->set_skill("xuanyuan-archery", 60);
    me->set_skill("yanxing-steps", 60);
    me->set_skill("sanban-axe", 60);
  } else if (me->query("family/family_name") == "盘丝洞") {
    me->set_skill("chixin-jian", 60);
    me->set_skill("jiuyin-xinjing", 60);
    me->set_skill("lanhua-shou", 60);
    me->set_skill("pansi-dafa", 60);
    me->set_skill("qingxia-jian", 60);
    me->set_skill("yinsuo-jinling", 60);
    me->set_skill("yueying-wubu", 60);
  } else if (me->query("family/family_name") == "蜀山剑派") {
    me->set_skill("hunyuan-zhang", 60);
    me->set_skill("mindsword", 60);
    me->set_skill("sevensteps", 60);
    me->set_skill("taoism", 60);
    me->set_skill("yujianshu", 60);
    me->set_skill("zixia-shengong", 60);
    me->set_skill("canxin-jian", 60);
  }
  command("ok");
  command("pat " + me->query("id"));
  return 1;
}
