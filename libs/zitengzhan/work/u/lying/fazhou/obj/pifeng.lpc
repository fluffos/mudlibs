#include <ansi.h>
#include <armor.h>

//inherit F_UNIQUE;
inherit SURCOAT;

void create() {
  set_name(HIM "冷狐披风" NOR, ({ "lenghu pifeng", "pifeng", "cloth" }));
  set_weight(4500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一件用天地之灵气修炼成的白狐皮做成的披风。\n");
    set("no_sell", 1);
    set("no_drop", 1);
    set("no_put", 1);
    set("material", "crimsonsteel");
    set("unit", "件");
    set("value", 1000);
    set("armor_prop/armor", 100);
    set("armor_prop/dodge", 100);
    set("armor_prop/spells", 50);
  }
  setup();
}
