#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIY "仙境之匙" NOR, ({ "xianjing zhishi", "key", "yaoshi", "xianjingzhishi" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一把能开启昆仑仙洞的仙境之匙. \n");
    set("unit", "把");
    set("material", "gold");
    set("no_give", 1);
  }
  setup();
}

void init() {
  call_out("destruct_me", 600, this_object());
}

void destruct_me(object me) {
  message_vision(HIY "只见一道金光闪过，仙境之匙已飞向九天!\n" NOR, me);
  destruct(me);
}
