#include <ansi.h>

inherit NPC;
string ask_fazhou();

void create() {
  set_name("姬发", ({ "ji fa" }));

  set("long", "殷商西伯侯次子，自父兄被商纣还死后
就一直想起兵灭商．\n");
  set("gender", "男性");
  set("age", 46);
  set("title", HIR "周武王" NOR);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("combat_exp", 5000);
  set_skill("unarmed", 15);
  set_skill("dodge", 30);
  set_skill("parry", 15);
  set("inquiry", ([
    "name": "我是西伯侯的二公子．\n",
    "here": "这里就是西崎呀．\n",
    "伐纣": (: ask_fazhou :),
  ]));

  setup();
  add_money("silver", 3 + random(5));
  carry_object("/d/ourhome/obj/choupao")->wear();
}


void init() {
  remove_call_out("check");
  call_out("check", 1);
}

void check() {
  object room = environment();
  object junshi = present("jiang ziya", room);
  object ob;
  if (!junshi) return;
  if (junshi->query_leader() == 0)
    return;
  ob = present(junshi->query_leader(), room);
  if (ob == 0)
    return;

  command("chat 感谢" + ob->query("name") + "帮我找到军师姜子牙！");
  message(
    "channel:chat",
    HIY "【武王伐纣】姬发(Ji Fa)：" + ob->query("name") + "帮我找到军师，全军开始伐纣大业！\n" NOR,
    users()
  );
  ob->remove("/u/yhq/npc/路径.lpc");
  return;
}


string ask_fazhou() {
  object ob = this_player();
  object cloth = new("/u/yhq/obj/qinglongbaoyu");
  command("laugh1");
  cloth->move(ob);
  ob->set_temp("girl_asked", 1);
  command("say 伐纣大业没有军师怎么进行，你可否帮我去寻得一名军师？ ");
  return ("这是我的信物。");
}
