//add rumor by huarong  2003.6
//真假盘龙 huarong 2003/12 嘿嘿
//modify for 大唐西游2 by huarong 2003/12

#include <ansi.h>
inherit SSERVER;
int perform(object me, object target) {
  object weapon;
  int j, skill, i, k;
  string msg, str;

  if (me->query("zhuanshi_lunhui") <= 1 && me->query("fangcun/panlong_accept") != "done") {
    if ((me->query("family/family_name") != "方寸山三星洞") && !wizardp(me))
      return notify_fail("你是哪儿偷学来的武功，也想用「盘龙八式」?\n");
  }

  if (!target) target = offensive_target(me);

  if (!target

    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("「盘龙八式」只能在战斗中使用。\n");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "stick")
    return notify_fail("「盘龙八式」必须用棍棒才能施展。\n");

  if ((int)me->query_skill("qianjun-bang", 1) < 150)
    return notify_fail("你的「千钧棒」不够娴熟，不会使用「盘龙八式」。\n");

  if (me->query("lunhui_zhuanshi") < 3 && me->query("fangcun/panlong_accept") == "done")     //3转开始cd减少5
  {
    if (time() - me->query_temp("pl_end") < 10) return notify_fail("你刚使出盘龙，突觉体力不够！\n");
  } else {
    if (time() - me->query_temp("pl_end") < 5) return notify_fail("你刚使出盘龙，突觉体力不够！\n");
  }

  skill = (int)me->query_skill("qianjun-bang", 1) + (int)me->query_skill("stick", 1);

  if (me->query("fangcun/panlong_accept") == "done") {
    if ((int)me->query("force") < 2000)
      return notify_fail("你的内力不够。\n");

    if (target->query_temp("jldl")) {
      target->delete_temp("jldl");
      target->set_temp("jldl_end", time());
      message_vision(
        HIR "$N" + HIR + "运起盘龙八式，面对强大的气劲，$n" + HIR + "的借力打力也失去了作用！\n\n\n" NOR,
        me,
        target
      );
    }
    if (me->query("lunhui_zhuanshi") < 3)   //3转开始增加对敌人的busy值
    {
      target->start_busy(2);
    } else {
      target->start_busy(5);
    }
    msg = HIG "$N跳至空中，手中的$n" + HIG "好似" + HIY "盘龙出沧海" + HIG "顿时化作无数条影子。\n" NOR;
    message_vision(msg, me, weapon);
    for (j = 9; j <= 16; j++) {
      me->set_temp("QJB_perform", j);
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    }
    me->delete_temp("QJB_perform");
    if (target && (target->query("eff_kee") < 0 || (!living(target) && target->query("kee") < 0)) && random(5) == 1) {
      switch (random(5)) {
        case 0: {
          str = me->name() + HIM + "使出了方寸失传已久的绝学" + HIR + "『盘龙八式』" + HIM + "，" + target->name() + HIM + "闷哼一声，化作一滩血水。\n" NOR;
          break;
        };

        case 1: {
          str = target->name() + HIM + "被" + me->name() + HIM + "用方寸失传已久的绝学" + HIR + "『盘龙八式』" + HIM + "击中，闷哼一声，暴毕当场，面如死灰。\n" NOR;
          break;
        };

        case 2: {
          str = me->name() + HIM + "竟然使出了方寸失传已久的绝学" + HIR + "『盘龙八式』" + HIM + "，在强大攻势之下，" + target->name() + HIM + "顿时皮开肉绽，吐血身亡。\n" NOR;
          break;
        };

        case 3: {
          str = me->name() + HIM + "使出了方寸失传已久的绝学" + HIR + "『盘龙八式』" + HIM + "，" + target->name() + HIM + "抵挡不住，被强大的气劲震断所有经脉，立时吐血身亡。\n" NOR;
          break;
        };

        case 4: {
          str = "「喀啦啦」脆响叠爆，" + target->name() + HIM + "发出一声惊骇凄厉的惨叫，被" + me->name() + HIM + "的方寸绝学" + HIR + "『盘龙八式』" + HIM + "送去了阎罗地府。\n" NOR;
          break;
        };
      }
      message("channel:rumor", HIM "【空穴来风】某人：" + str + "\n" NOR, users());
    }
    if (me->query("lunhui_zhuanshi") < 1) {
      me->start_busy(2 + random(2));
    }
    if (me->query("lunhui_zhuanshi") == 1) {
      me->start_busy(2);
    }
    if (me->query("lunhui_zhuanshi") == 2) {
      me->start_busy(1);
    }
    if (me->query("lunhui_zhuanshi") == 3) {
      me->start_busy(random(1));     //4转开始no busy
    }

  } else {

    if ((int)me->query("force") < 2000)
      return notify_fail("你的内力不够。\n");

    if (target) target->add_temp("apply/dodge", -skill);
    if (target) target->add_temp("apply/parry", -skill);
    msg = HIG "$N" + HIG + "将平常所练招式一连串连续打出，颇有" + HIY "盘龙出沧海" + HIG "的味道！\n" NOR;
    message_vision(msg, me, weapon);
    k = (int)me->query_skill("qianjun-bang", 1) / 50;
    if (k > 8) k = 8;
    for (j = 1; j <= k; j++) {
      msg = HIR "满天棍影中，$N" + HIR + "砸出第" + HIY + chinese_number(j) + HIR + "棍！" NOR;
      message_vision(msg, me, weapon);
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    }
    if (target) target->add_temp("apply/parry", skill);
    if (target) target->add_temp("apply/dodge", skill);
    if (target && (target->query("eff_kee") < 0 || (!living(target) && target->query("kee") < 0)) && random(5) == 1) {
      str = me->name() + HIM + "使出了方寸千钧棒法绝学" + HIR + "「盘龙八式」" + HIM + "，" + target->name() + HIM + "被活活打成肉泥！\n" NOR;
      message("channel:rumor", HIM "【空穴来风】某人：" + str + "\n" NOR, users());
    }
    me->start_busy(1 + random(2));
  }
  me->set_temp("pl_end", time());
  me->add("force", -100 - skill / 3);
  return 1;
}
