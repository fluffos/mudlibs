> more /d/item/npc/zhang.c
1       // zhang.c 张天师 
2        
3       #include <ansi.h> 
4        
5       inherit NPC; 
6        
7       int ask_me(); 
8        
9       void create() 
10      { 
11              set_name("张天师", ({ "zhang tianshi", "zhang" })); 
12              set("age", 57); 
13              set("gender", "男性"); 
14              set("long", "这是一位仙风神骨，道貌岸然的法师。\n"); 
15              set("attitude", "peaceful"); 
16       
17              set("str", 28); 
18              set("int", 35); 
19              set("con", 38); 
20              set("dex", 31); 
21       
22              set("max_qi", 8000); 
23              set("max_jing", 8000); 
24              set("max_neili", 8000); 
25       
26              set_skill("magic", 200); 
27              set_skill("taoism", 350); 
28       
29              set("chat_chance_combat", 3); 
30              set("chat_msg_combat", ({ 
31                      "张天师摇摇铃铛，道：天灵灵，地零零，太上老君还不显灵？\n", 
32                      "张天师呼呼的吹了几口气。\n", 
33              })); 
34       
35              set("inquiry", ([ 
36                      "开光" : (: ask_me :), 
37                      "没钱" : "没钱就去赚，跟我说什么。", 
38                      "穷"   : "看你也是一副穷命。", 
39                      "魔法" : "魔法？什么玩艺？", 
40                      "法术" : "法术还分很多种呢，道术、妖术、仙术不一而足。", 
41                      "道术" : "道术？这可是本源正宗！", 
42                      "妖术" : "妖术啊，趋于下乘，不足为提。", 
43                      "仙术" : "仙术只好算是中乘，还是不能和道术相比。", 
44                      "浸入" : "你要是不行我可以帮你看看(show)浸入需要用什么物品。", 
45              ])); 
46       
47              setup(); 
48      } 
49       
50      void init() 
51      { 
52              add_action("do_show", "show"); 
53              add_action("do_summon", "summon"); 
54      } 
55       
56      int ask_me() 
57      { 
58              command("heihei"); 
59              command("say 我只给神兵利器开光，寻常刀剑莫提！要" 
60                      "你本人的，我可不能帮你做坏事！"); 
61              tell_object(this_player(), GRN "张天师在你耳边悄悄说：" 
62                          "你把要开光的拿出来给我看看(show)！\n" NOR); 
63              return 1; 
64      } 
65       
66      int do_summon(string arg) 
67      { 
68              if (! wizardp(this_player())) 
69              { 
70                      command("say 你在我面前瞎抓个什么劲？别地试去！"); 
71                      return 1; 
72              } 
73       
74              return 0; 
75      } 
76       
77      int do_show(string arg) 
78      { 
79              object money; 
80              object ob; 
81              object me; 
82              int n; 
83       
84              if (! arg) 
85                      return notify_fail("你要亮出什么东西？\n"); 
86       
87              me = this_player(); 
88              if (! objectp(ob = present(arg, me))) 
89                      return notify_fail("你身上没有这种东西。\n"); 
90       
91              if (ob->query("equipped")) 
92                      return notify_fail("你先解除" + ob->name() + "的装备再说！\n"); 
93       
94              message_vision("$n拿出一" + ob->query("unit") + ob->name() + 
95                             "对$N说：“拜托拜托...”\n", 
96                             this_object(), me); 
97       
98              if (ob->query("money_id")) 
99              { 
100                     command("say 你亮出钱干什么？想献给观里？那就给我好了。"); 
101                     return 1; 
102             } 
103      
104             if (! me->query_temp("paid/张天师", 1)) 
105             { 
106                     command("heihei"); 
107                     command("say 这...怎么也的有点意思意思吧？你" 
108                             "说十两黄金怎么样？当然多些我也不反对。"); 
109                     return 1; 
110             } 
111      
112             if (stringp(ob->query("magic/imbue_ob"))) 
113             { 
114                     command("say 嗯...我看看，应该用" + 
115                             ob->query("magic/imbue_ob")->name() + 
116                             CYN "浸入它才能进一步激发它的潜力。" NOR); 
117                     me->delete_temp("paid/张天师"); 
118                     return 1; 
119             } 
120      
121             if (mapp(ob->query("magic/imbue_ok"))) 
122             { 
123                     command("say 哦！我看它现在已经不需要在浸入了，" 
124                             "要发挥潜力得用别的法子了。\n"); 
125                     return 1; 
126             } 
127      
128             if (! ob->is_item_make()) 
129             { 
130                     command("heng"); 
131                     command("say 这...这...我看还是算了吧！"); 
132                     return 1; 
133             } 
134      
135             if (ob->item_owner() != me->query("id")) 
136             { 
137                     command("kick " + me->query("id")); 
138                     command("say 你以为本山人的仙术是蒙事的啊，这分明不是你的！"); 
139                     return 1; 
140             } 
141      
142             if (me->query("can_summon/" + ob->query("id"))) 
143             { 
144                     if (ob->weapon_level() > 1) 
145                     { 
146                             command("poor " + me->query("id")); 
147                             command("say 它现在还不到浸入的时候..." 
148                                     "你要先圣化它才行啊！"); 
149                     } else 
150                     { 
151                             command("kok " + me->query("id")); 
152                             command("say 你和它已经有缘了！我说你的" 
153                                     "记性怎么这么差？"); 
154                     } 
155                     return 1; 
156             } 
157      
158             message("vision", sort_string(HIM + name() + "从口袋中摸出一张黄色" 
159                                     "的符纸，抽出背后的桃木剑，" 
160                                     "将那符纸点燃了，扫过" + ob->name() + HIM "，然" 
161                                     "后用桃木剑穿了，手舞足蹈，口中念念有词：" 
162                                     "“太上老君急急如律赐令！”说罢一抖掌中剑，" 
163                                     "喝道：“疾”！\n" NOR, 64), environment()); 
164             message_vision("焰光划出一道光华，$N发了发呆，也不知道算是怎么回事。\n", 
165                            me); 
166             command("say 行了，行了！你可以走了。"); 
167             me->delete_temp("paid/张天师"); 
168             me->set("can_summon/" + ob->query("id"), base_name(ob)); 
169             log_file("static/item", sprintf("%s %s sancitfy %s(%s)\n", 
170                             log_time(), log_id(me), 
171                             filter_color(ob->name(1)), ob->query("id"))); 
172             return 1; 
173     } 
174      
175     int accept_object(object who, object ob) 
176     { 
177             if (! ob->query("money_id")) 
178             { 
179                     command("say 这玩艺我可没啥兴趣！"); 
180                     return 0; 
181             } 
182      
183             if (ob->value() < 50000) 
184             { 
185                     command("say 算是给观里的香火么？那我就收下了！"); 
186                     return 1; 
187             } 
188      
189             if (ob->value() < 100000) 
190             { 
191                     command("say 唉！看你也算有点心意，我就替你开一次光吧！"); 
192                     who->set_temp("paid/张天师", 1); 
193                     destruct(ob); 
194                     return 1; 
195             } 
196      
197             command("say 好...好...这么照顾本观，我能帮你点什么？"); 
198             who->set_temp("paid/张天师", 1); 
199             destruct(ob); 
200             return 1; 
201     } 
202      
203     void fight_ob(object ob) 
204     { 
205             ::fight_ob(ob); 
206             message_vision("$N冷笑一声，道：“这年头，什么人都有。”说完伸手一指$n。\n", 
207                            this_object(), ob); 
208             ob->unconcious(); 
209     } 
210      
211     int accept_fight(object who) 
212     { 
213             command("say 没兴趣。"); 
214             return 0; 
215     } 
216      
217     int accept_ansuan(object who) 
218     { 
219             return notify_fail("你刚想暗算，可是眼前一花，看不太清楚。\n"); 
220     } 
221      
222     void receive_damage(string type, int n) 
223     { 
224             return; 
225     } 
226      
227     void receive_wound(string type, int n) 
228     { 
229             return; 
230     } 
231      



