57      void init() 
58      { 
59              object me; 
60              object ob = this_object(); 
61       
62         if(this_player()->query("env/invisibility")){; 
63           this_player()->delete("env/invisibility");; 
64           message_vision(HIW"$N渐渐现出身形。\n\n"NOR,this_player());; 
65                                                       }; 
66              if (interactive(me = this_player())) 
67              { 
68               ob->set("eff_kee", ob->query("max_kee")); 
69               ob->set("kee",     ob->query("max_kee")); 
70               ob->set("eff_sen", ob->query("max_sen")); 
71               ob->set("sen",     ob->query("max_sen")); 
72               ob->set("force",   ob->query("max_force")); 
73               ob->set("mana",    ob->query("max_mana")); 
74                 kill_ob(me); 
75              } 
76              ::init(); 
77      } 
78       
79      mixed hit_ob(object me, object ob, int damage_bouns) 
80      { 
81              ob->receive_wound("kee", 400 + random(400), me); 
82              ob->receive_damage("kee", 600 + random(600), me); 
83              me->set("force", me->query("max_force")); 
84              return HIW "白虎喷出一团寒气，刹时地面冰封九尺，四周冰雪" 
85                     "纷飞，似乎连空气都要被冻住一般。\n" NOR; 
86      } 
87       
88      void unconcious()  
89      {  
90        if (query("kee")<0 || query("sen")<0) die();  
91         else ::unconcious();  
92      }  
93       
94      void die() 
95      { 
96              object me; 
97              object gu, pi; 
98       
99              int exp, pot; 
100      
101             exp = 10000 + random(5000); 
102             pot = 500 + random(6500); 
103      
104             gu = new("/d/item/combineobj/hugu"); 
105      
106             if( objectp(me = query_last_damage_from()) 
107              && userp(me) ) 
108             { 
109               if( !random(6) ) 
110                     { 
111                     message_vision(HIC "$N" HIC "从白虎的尸体上除下了一根虎骨。\n", me); 
112                     gu->move(me); 
113                     }        
114                     me->add("combat_exp", exp); 
115                     me->add("potential", pot); 
116                     tell_object(me, HIC "由于你斩杀神兽白虎，你获得了" + chinese_number(exp) 
117                                     + "点经验和" + chinese_number(pot) + "点潜能。\n" NOR); 
118             } 
119      
120             ::die(); 
121     } 
