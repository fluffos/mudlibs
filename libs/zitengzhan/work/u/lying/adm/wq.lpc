84       
85      void create() 
86      { 
87              set_name("莫邪", ({ "mo ye", "moye", "mo" })); 
88              set("long", "她长得清美秀丽，一副不食人间烟火的模样。她就是铸剑大师干将的妻子。\n" ); 
89       
90              set("nickname", HIY "剑仙" NOR); 
91              set("gender", "女性"); 
92              set("attitude", "friendly"); 
93       
94              set("age", 1525); 
95              set("shen_type", 0); 
96               
97              set("str", 1000);                       // 保证不会因为负荷过大而接受不了东西 
98       
99              set("inquiry", ([ 
100                     "炼制" : (: ask_me :), 
101                     "铸剑" : (: ask_me :), 
102                     "炼剑" : (: ask_me :), 
103                     "炼刀" : (: ask_me :), 
104                     "炼杖" : (: ask_me :), 
105                     "炼鞭" : (: ask_me :), 
106                     "炼锤" : (: ask_me :), 
107                     "炼棍" : (: ask_me :), 
108                     "炼甲" : (: ask_me :), 
109                     "打造" : (: ask_me :), 
110                     "铸造" : (: ask_me :), 
111                     "制造" : (: ask_me :), 
112                     "打制" : (: ask_me :), 
113                     "定制" : (: ask_me :), 
114                     "定做" : (: ask_me :), 
115                     "定造" : (: ask_me :), 
116                     "兵器" : (: ask_me :), 
117                     "道具" : (: ask_me :), 
118                     "装备" : (: ask_me :), 
119                     "武器" : (: ask_me :), 
120                     "刀剑" : (: ask_me :), 
121                     "装甲" : (: ask_me :), 
122                      
123                     "没钱" : (: no_money :), 
124                     "钱不够":(: no_money :), 
125                     "等会" : (: no_money :), 
126      
127                     "销毁" : "那你就把东西给干将，他来做主。", 
128                     "退货" : "那你就把东西给干将，他来做主。", 
129                     "原料" : "炼制道具可不能没有原料啊，要想炼制好武器就得有" 
130                              "玄铁石一类的东西。\n          要想炼制好防具就" 
131                              "得有天蚕丝那些东西。这些原料很难找，可遇不可求啊！\n", 
132                     "价格" : "你把原料给我看看(show)，我就能估摸出一个价钱。", 
133             ])); 
134      
135             setup(); 
136      
137             set("startroom", "/d/item/xiaowu"); 
138             check_clone(); 
139             if (! this_object()) return; 
140      
141     } 
142      
143     void init() 
144     { 
145             object me; 
146      
147             // 清除询问标志 
148             if (! objectp(me = this_player()) || ! interactive(me)) 
149                     return; 
150      
151             add_action("do_show", "show"); 
152             add_action("do_answer", "answer"); 
153             if (me->query_temp("item/status") == "item_gived") 
154             { 
155                     remove_call_out("greeting2"); 
156                     call_out("greeting2", 1, me); 
157             } else 
158             { 
159                     remove_call_out("greeting"); 
160                     call_out("greeting", 1, me); 
161             } 
162     } 
163      
164     void greeting(object me) 
165     { 
166             if (objectp(me) && environment(me) == environment()) 
167             { 
168                     message_vision("$N笑着对$n说：你好，你是想打造道具" 
169                                    "吗？\n", this_object(), me); 
170             } 
171     } 
172      
173     void greeting2(object me) 
174     { 
175             if (objectp(me) && environment(me) == environment()) 
176             { 
177                     message_vision("$N对$n说：交钱就可以打造了哦。\n", 
178                                    this_object(), me); 
179             } 
180     } 
181      
182     int do_show(string arg) 
183     { 
184             object  me; 
185             object  ob; 
186             string  msg; 
187             string  mat; 
188             int     power_point; 
189             int     value; 
190             int     n; 
191      
192             me = this_player(); 
193             if (! arg) 
194                     return notify_fail("你想干什么，是要跳个舞么？\n"); 
195      
196             mat = arg; 
197             power_point = 0; 
198      
199             if (! objectp(ob = present(mat, me))) 
200                     return notify_fail("算了吧，你身上没有 " + mat + " 这种东西。\n"); 
201      
202             if (! ob->query("material_attrib")) 
203             { 
204                     message_vision("$N一愣，对$n说道：这种东西也能用来炼" 
205                                    "制，我没听说过。\n", this_object(), me); 
206             } 
207      
208             power_point = ob->query("power_point"); 
209             if (! power_point) 
210             { 
211                     message_vision("$N仔细的看了看$n拿出的原料，叹道：" 
212                                    "这样原料看来已经是锻造不了了。\n", 
213                                    this_object(), me); 
214                     return 1; 
215             } 
216             value = power_point * 2 + 10; 
217             msg = sprintf("$N仔细看了看$n拿出的原料，说道：这种原料打造道具，\n" + 
218                           "只需要%s两黄金，怎么样，我们价格很合理吧。要是没问题" 
219                           "，请给我原料并付钱。\n", chinese_number(value)); 
220             message_vision(msg, this_object(), me); 
221      
222             return 1; 
223     } 
224      
225     // 发出提示信息 
226     int ask_me() 
227     { 
228             message_vision("$N对$n说道："  
229                     "你是要打造自己的道具吗？\n" 
230                     "我们这里可以为你打造各种武器包括刀、剑、锤、鞭、杖和护甲，都是第一流的。\n" 
231                     "你先把原料给我看看(show)，我先估算一下价钱。如果你满意" 
232                     "咱们就一手交钱，一手交货！\n", this_object(), this_player()); 
233             return 1; 
234     } 
235      
236     int no_money() 
237     { 
238             object me; 
239             object ob; 
240      
241             me = this_player(); 
242             if (me->query_temp("item/status") == "item_gived") 
243             { 
244                     message_vision("$N打量了一下$n道：没钱那就下次吧！\n", 
245                                    this_object(), me); 
246                     if (objectp(ob = query_temp("item/accept"))) 
247                     { 
248                             message_vision("$N把" + ob->name() + 
249                                            "交还给$n。\n", this_object(), me); 
250                             if (! ob->move(me)) 
251                                     ob->move(environment()); 
252                     } 
253                     delete_temp("item"); 
254                     me->delete_temp("item"); 
255                     return 1; 
256             } 
257      
258             message_vision("$N眼睛一瞪，对$n说道：没钱？你没钱关我啥事，" 
259                            "我又不是财神爷。\n", this_object(), me); 
260             return 1; 
261     } 
262      
263     // 接受定金 
264     int accept_object(object me, object ob) 
265     { 
266             string status; 
267             int    val; 
268      
269             if (me->query("item/make_weapon") > 0) 
270                      return notify_fail("$N瞪了你一眼，对$n说道：你已经拥有一把神兵了。\n", this_object(), me);  
271             status = query_temp("item/status"); 
272             if (status == "look_working") 
273             { 
274                     message_vision("$N紧张的对$n说：别吵，干将正在干活呢。\n", 
275                                    this_object(), me); 
276                     return 0; 
277             } 
278      
279             if (status == "waiting") 
280             { 
281                     if (query_temp("item/player_id") == me->query("id")) 
282                     { 
283                             command("say 你好好和干将谈，少打岔！"); 
284                             return 0; 
285                     } 
286      
287                     message_vision("$N对$n说：别吵，干将正在和顾客谈话呢。\n", 
288                                    this_object(), me); 
289                     return 0; 
290             } 
291      
292             if (status == "accept") 
293             { 
294                     if (query_temp("item/player_id") != me->query("id")) 
295                     { 
296                             command("say 我正在和别的客人商量呢，你先别添乱！"); 
297                             return 0; 
298                     } 
299      
300                     if (! ob->query("money_id")) 
301                     { 
302                             command("say 你还是快点交钱吧，要是没钱就明说！"); 
303                             return 0; 
304                     } 
305             } 
306      
307             if (ob->query("material_attrib") && 
308                 ob->query("power_point")) 
309             { 
310                     // 计算价值 
311                     val = ob->query("power_point") * 2 + 10; 
312                     message_vision("$N对$n说道：很好，用这块原料打造道具需要" + 
313                                    chinese_number(val) + "两黄金，交钱吧。\n", 
314                                    this_object(), me); 
315                     val *= 10000; 
316                     if (wizardp(me)) 
317                     { 
318                             message_vision("$N仔细看了看$n，笑着说道：原" 
319                                            "来是巫师，那么你随便给点好了。\n", 
320                                            this_object(), me); 
321                             val = 1; 
322                     } 
323                     ob->set("item/value", val); 
324                     me->set_temp("item/status", "item_gived"); 
325                     me->set_temp("item/value", val); 
326                     set_temp("item/status", "accept"); 
327                     set_temp("item/player_id", me->query("id")); 
328                     set_temp("item/accept", ob); 
329      
330                     // 如果过一段时间没有交款，还道具粗坯 
331                     remove_call_out("time_out"); 
332                     call_out("time_out", 30, me, ob); 
333                     return 1; 
334             } 
335      
336             if (ob->query("money_id")) 
337             { 
338                     object origin; 
339                     mixed p; 
340                     string *types; 
341      
342                     if (me->query_temp("item/status") == "answer_type") 
343                     { 
344                             message_vision("$N摇摇头，对$n说：快说你要做什么东西！\n", 
345                                            this_object(), me); 
346                             return 0; 
347                     } 
348      
349                     if (me->query_temp("item/status") != "item_gived") 
350                     { 
351                             message_vision("$N把$n递过去的" + ob->name() + 
352                                            "推了回来，道：无功不受禄！\n", 
353                                            this_object(), me); 
354                             return 0; 
355                     } 
356      
357                     if (ob->value() < me->query_temp("item/value")) 
358                     { 
359                             message_vision("$N对$n说：对不起，本店开张一" 
360                                            "千多年来，还没有打过折扣。\n", 
361                                            this_object(), me); 
362                             return 0; 
363                     } 
364      
365                     origin = query_temp("item/accept"); 
366                     if ((p = origin->query("can_make")) == "all") 
367                     { 
368                             types = keys(item_type); 
369                     } else 
370                     if (arrayp(p)) 
371                             types = p; 
372                     else 
373                     if (stringp(p)) 
374                             types = ({ p }); 
375      
376                     p = origin->query("not_make"); 
377                     if (arrayp(p)) 
378                             types -= p; 
379                     else 
380                     if (stringp(p)) 
381                             types -= ({ p }); 
382      
383                     set_temp("item/types", types); 
384                     set_temp("item/money", ob); 
385                     ob->move(this_object()); 
386      
387                     message_vision("$N对$n说道：好，这就给你炼！你打算打" 
388                                    "造什么东西，请告诉我(answer 类型)！\n" 
389                                    "（" + implode(types, "、") + "）\n", 
390                                    this_object(), me); 
391      
392                     me->set_temp("item/status", "answer_type"); 
393                     return -1; 
394             } 
395      
396             message_vision("莫邪眼睛一瞪，对$N说道：你给我这些东西干什么？我不要！\n", me); 
397             return 0; 
398     } 
399      
400     int do_answer(string arg) 
401     { 
402             object money; 
403             object ob; 
404             object me; 
405             object ganjiang; 
406      
407             me = this_player(); 
408             if (me->query_temp("item/status") != "answer_type") 
409                     return 0; 
410      
411             if (! arg) 
412                     return notify_fail("你要回答什么？\n"); 
413      
414             message_vision("$n对$N道：就打造" + arg + "吧！\n", 
415                            this_object(), me); 
416      
417             if (member_array(arg, query_temp("item/types")) == -1 || 
418                 undefinedp(item_type[arg])) 
419             { 
420                     message_vision("$N“啊秋”一下打了个喷嚏，一脸无辜的看着$n。\n", 
421                                    this_object(), me); 
422                     return 1; 
423             } 
424      
425             // 如果干将不在 
426             if (! objectp(ganjiang = present("gan jiang"))) 
427             { 
428                     message_vision("$N看了看四周，不禁一呆，说道：干将呢" 
429                                    "？他不在，没办法做了...你改天再来吧。\n", 
430                                    this_object()); 
431                     if (ob = query_temp("item/accept")) 
432                     { 
433                             message_vision("$N把" + ob->name() + "交还给$n。\n", 
434                                            this_object(), me); 
435                             if (! ob->move(me)) 
436                                     ob->move(environment()); 
437                     } 
438                     delete_temp("item"); 
439                     me->delete_temp("item"); 
440                     return 0; 
441             } 
442      
443             if (objectp(money = query_temp("item/money"))) 
444                     destruct(money); 
445             delete_temp("item/money"); 
446             set_temp("item/status", "look_working"); 
447             me->set_temp("item/status", "waiting"); 
448             ob = query_temp("item/accept"); 
449             ob->set("item/ctype", arg); 
450             ob->set("item/type", item_type[arg][ITEM_TYPE]); 
451             ob->set("item/stype", item_type[arg][ITEM_STYPE]); 
452             ob->set("item/unit", item_type[arg][ITEM_UNIT]); 
453             ob->set("item/point", ob->query("power_point") * item_type[arg][ITEM_POINT] / 100); 
454             ob->set("item/owner", me); 
455             ob->set("item/owner_id", me->query("id")); 
456             ob->set("item/owner_name", me->name(1)); 
457             ob->set("item/wscale", item_type[arg][ITEM_WEIGHT]); 
458             ob->set("item/prop", item_type[arg][ITEM_PROP]); 
459             message_vision("$N把" + ob->name() + "交给了$n。\n", 
460                            this_object(), ganjiang); 
461             if (! ob->move(ganjiang)) 
462                     error("Can move the object to ganjiang."); 
463             remove_call_out("time_out"); 
464             ganjiang->accept_object(this_object(), ob); 
465             return 1; 
466     } 
467      
468     void time_out(object me, object ob) 
469     { 
470             object money; 
471             int at_present; 
472      
473             money = query_temp("item/money"); 
474      
475             if (! objectp(me)) 
476                     me = find_player(query_temp("item/player_id")); 
477      
478             if (! objectp(me) || environment(me) != environment()) 
479             { 
480                     command("say 奇怪，刚才那位客人呢？怎么这就走了？\n"); 
481                     at_present = 0; 
482             } else 
483             { 
484                     command("say 你慢慢犹豫吧，我可不能跟你耗着！想好再来吧！"); 
485                     at_present = 1; 
486             } 
487      
488             delete_temp("item"); 
489             if (objectp(me)) 
490                     me->delete_temp("item"); 
491      
492             if (money) 
493             { 
494                     if (at_present) 
495                             command("give " + money->query("id") + 
496                                     " to " + me->query("id")); 
497      
498                     if (environment(money) == this_object()) 
499                             command("drop " + money->query("id")); 
500             } 
501      
502             if (ob) 
503             { 
504                     if (at_present) 
505                             command("give " + ob->query("id") + 
506                                     " to " + me->query("id")); 
507      
508                     if (environment(ob) == this_object()) 
509                             command("drop " + ob->query("id")); 
510             } 
511     } 
512      




> more gan jiang
1       // ganjiang.c  干将 
2       // Written by Doing Lu  1998/11/2 
3        
4       // 干将负责炼道具的场景，但是不接受玩家的物品，玩家如果炼制 
5       // 道具应该和莫邪打交道。如果 player 在莫邪那里将一切手续办 
6       // 妥，莫邪将原料交给干将。通过accept_object 函数启动干将的 
7       // 炼制程序。 
8        
9       // 干将接收到莫邪传来的道具，则对他进行锻炼，锻炼完以后，设 
10      // 设置道具的铸造者，铸造者的ID，不设置道具的有效点数 point， 
11      // 因为在莫邪那里已经设置了。并且等候 player 输入关于道具的 
12      // 信息，如果超时，就清除三人的标志，并解除object。如果用户 
13      // finish，这询问 player 是否决定，如果是则生成道具文件，并 
14      // 在生成道具送给 player，否则继续修改。 
15       
16      inherit NPC; 
17      inherit F_NOCLONE; 
18       
19      #include <ansi.h> 
20       
21      // 如果字符串被设置成这个值，表示输入的字符串具有非法的格式 
22      #define ILLEGAL_STR     "." 
23      // 在convert时看看要不要去掉彩色 
24      #define NOCOLOR         1 
25      #define COLORABLE       0 
26       
27      protected int   ask_me();                               // 显示定做信息 
28      protected int   show_order();                           // 显示规则信息 
29      protected int   start_work(object me, object ob);       // 开始工作 
30      protected int   prepare_make(object me, object ob);     // 开始打造 
31      protected int   do_notch(string arg);                   // 道具开槽 
32      protected int   do_wash(string arg); 
33      protected void  clear_data();                           // 清除 ganjiang, moye, player 的临时变量并去除粗坯对象 
34      protected string  create_file(object item_temp); 
35      protected int     save_item_file(string filename, string content); 
36      protected void    tell_rules(object me); 
37      protected void    waiting(object me, object ob, object moye); 
38      protected string        converts(string arg, int max_len, int nocolor); 
39      protected string  prop_segment(mapping p, string path); 
40      protected int     save_item_file(string filename, string content); 
41      protected int     legal_chinese(string str); 
42      mapping   material = ([ 
43              "玄铁石"   : "/d/item/obj/xuantie", 
44              "乌金丝"   : "/d/item/obj/wujins", 
45              "玄冰寒铁" : "/d/item/obj/hantie", 
46              "补天石"   : "/d/item/obj/butian", 
47              "冰蚕丝"   : "/d/item/obj/tiancs", 
48              "七色璎珞" : "/d/item/obj/qise", 
49              "寰宇天晶" : "/d/item/obj/tianjing", 
50      ]); 
51       
52      void create() 
53      { 
54              seteuid(getuid()); 
55       
56              set_name("干将", ({ "gan jiang", "ganjiang", "gan" })); 
57              set("long", "他长得粗壮有力，脸庞似如刀削，透出一股英气。他是古往今来有名的铸剑大师。\n" ); 
58       
59              set("nickname", HIR "剑师" NOR); 
60              set("gender", "男性"); 
61              set("attitude", "friendly"); 
62       
63              set("age", 1535); 
64              set("shen_type", 0); 
65       
66              set("str", 1000); 
67       
68              set("inquiry", ([ 
69                      "炼制" : (: ask_me :), 
70                      "练剑" : (: ask_me :), 
71                      "炼剑" : (: ask_me :), 
72                      "铸剑" : (: ask_me :), 
73                      "打造" : (: ask_me :), 
74                      "铸造" : (: ask_me :), 
75                      "制造" : (: ask_me :), 
76                      "打制" : (: ask_me :), 
77                      "定制" : (: ask_me :), 
78                      "定做" : (: ask_me :), 
79                      "定造" : (: ask_me :), 
80                      "兵器" : (: ask_me :), 
81                      "道具" : (: ask_me :), 
82                      "装备" : (: ask_me :), 
83                      "武器" : (: ask_me :), 
84                      "刀剑" : (: ask_me :), 
85                      "装甲" : (: ask_me :), 
86                       
87                      "开槽" : "我只给神兵利器开槽打孔(notch)，寻常刀剑防具莫提，费用一千两黄金将从银行扣除。\n",              
88                      "原料" : "炼剑就得有原料，一分钱，一分货，好原料就能出好东西。\n", 
89                      "定金" : "定金少得很，才五两黄金，要交定金请交给莫邪。\n", 
90                      "价格" : "一分钱一分货......", 
91                      "销毁" : "那就...退回(discard)来吧...", 
92                      "退货" : "那就...退回(discard)来吧...", 
93       
94                      "规则" : (: show_order :), 
95                      "方法" : (: show_order :), 
96                      "order": (: show_order :), 
97                       
98              ])); 
99       
100             setup(); 
101      
102             set("startroom", "/d/item/xiaowu"); 
103             check_clone(); 
104             if (! this_object()) return; 
105      
106             carry_object("/clone/misc/cloth")->wear(); 
107     } 
