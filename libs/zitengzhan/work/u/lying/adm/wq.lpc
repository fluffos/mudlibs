1       #include <ansi.h> 
2       inherit ITEM; 
3        
4       int is_enchase_ob() { return 1; } 
5        
6       void create() 
7       { 
8               set_name(WHT "虎骨" NOR, ({"hu gu", "hu", "gu"})); 
9               if (clonep()) 
10                      set_default_object(__FILE__); 
11              else { 
12                      set("unit", "根"); 
13                      set("long", WHT "\n一根新鲜的虎骨，从神兽白虎的身体里取出，可以入药。\n" NOR); 
14                      set("value", 6000); 
15                      set("only_do_effect", 1); 
16              } 
17              setup(); 
18      } 
19       
20      void init()  
21      {  
22         if(this_player()==environment())  
23         add_action("do_eat", "eat");  
24      } 
25       
26      int do_eat(string arg) 
27      { 
28              object me = this_player(); 
29              if (arg!="hu gu" && arg!="gu")     return 0;  
30       
31              if( me->is_busy() ) 
32                      return notify_fail("急什么，小心别噎着了。\n"); 
33       
34              message_vision(HIR "$N" HIR "将虎骨嚼烂吞下，只感一阵磅礴的法力直冲顶门。\n" NOR, me); 
35              me->set("mana",me->query("max_mana")); 
36              me->set("force",me->query("max_force")); 
37              me->set("sen",me->query("max_sen")); 
38              me->set("kee",me->query("max_kee")); 
39              me->set("eff_sen",me->query("max_sen")); 
40              me->set("eff_kee",me->query("max_kee")); 
