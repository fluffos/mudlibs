109     void init() 
110     { 
111             add_action("do_name", "name"); 
112             add_action("do_name", "命名"); 
113             add_action("do_desc", "desc"); 
114             add_action("do_desc", "描述"); 
115             add_action("do_wieldmsg", "wieldmsg"); 
116             add_action("do_wieldmsg", "wearmsg"); 
117             add_action("do_wieldmsg", "装备"); 
118             add_action("do_wieldmsg", "装备信息"); 
119             add_action("do_unwield", "unwieldmsg"); 
120             add_action("do_unwield", "removemsg"); 
121             add_action("do_unwield", "收起"); 
122             add_action("do_unwield", "收起信息"); 
123             add_action("do_finish", "finish"); 
124             add_action("do_finish", "完成"); 
125      
126             add_action("do_notch", "notch"); 
127             add_action("do_wash", "wash"); 
128             add_action("do_discard", "discard"); 
129     } 
