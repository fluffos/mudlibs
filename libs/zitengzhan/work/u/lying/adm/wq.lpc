1367    int  do_change_name(string arg) 
1368    { 
1369       string name, newname; 
1370       object fabao_ob, me=this_player(); 
1371       
1372       if( !arg || arg == "")  
1373          return notify_fail("请用 change_name 法宝 新中文名 来改名。\n"); 
1374           
1375       if( sscanf(arg, "%s %s", name, newname) != 2) 
1376          return notify_fail("请用 change_name 法宝 新中文名 来改名。\n"); 
1377        
1378       if( !objectp(fabao_ob=present(name, me)) ) 
1379          return notify_fail("你身上没有这样东西啊。\n"); 
1380     
1381       if(!fabao_ob->query("owner_id") || !fabao_ob->query("series_no"))  
1382          return notify_fail("那个不是法宝耶！\n"); 
1383     
1384       if( fabao_ob->query("equipped") ) 
1385          return notify_fail("你必须放下法宝才能改名。\n"); 
1386        
1387       newname += "$NOR$";       
1388       arg = newname; 
1389                 
1390            arg = replace_string(arg, "$BLK$", ""); 
1391            arg = replace_string(arg, "$RED$", ""); 
1392            arg = replace_string(arg, "$GRN$", ""); 
1393            arg = replace_string(arg, "$YEL$", ""); 
1394            arg = replace_string(arg, "$BLU$", ""); 
1395            arg = replace_string(arg, "$MAG$", ""); 
1396            arg = replace_string(arg, "$CYN$", ""); 
1397            arg = replace_string(arg, "$WHT$", ""); 
1398            arg = replace_string(arg, "$HIR$", ""); 
1399            arg = replace_string(arg, "$HIG$", ""); 
1400            arg = replace_string(arg, "$HIY$", ""); 
1401            arg = replace_string(arg, "$HIB$", ""); 
1402            
1403     arg = replace_string(arg, "$HIM$", ""); 
1404            arg = replace_string(arg, "$HIC$", ""); 
1405            arg = replace_string(arg, "$HIW$", ""); 
1406            arg = replace_string(arg, "$NOR$", ""); 
1407             
1408       if( !check_legal_name(arg, 12) )   { 
1409          return 1;  
1410       } 
1411       
1412       arg = newname; 
1413         
1414            arg = replace_string(arg, "$BLK$", BLK); 
1415            arg = replace_string(arg, "$RED$", RED); 
1416            arg = replace_string(arg, "$GRN$", GRN); 
1417            arg = replace_string(arg, "$YEL$", YEL); 
1418            arg = replace_string(arg, "$BLU$", BLU); 
1419            arg = replace_string(arg, "$MAG$", MAG); 
1420            arg = replace_string(arg, "$CYN$", CYN); 
1421            arg = replace_string(arg, "$WHT$", WHT); 
1422            arg = replace_string(arg, "$HIR$", HIR); 
1423            arg = replace_string(arg, "$HIG$", HIG); 
1424            arg = replace_string(arg, "$HIY$", HIY); 
1425            arg = replace_string(arg, "$HIB$", HIB); 
1426            arg = replace_string(arg, "$HIM$", HIM); 
1427            arg = replace_string(arg, "$HIC$", HIC); 
1428            arg = replace_string(arg, "$HIW$", HIW); 
1429            arg = replace_string(arg, "$NOR$", NOR); 
1430       
1431       fabao_ob->set("name", arg); 
1432       fabao_ob->save();      
1433        
1434       write("改动成功。\n"); 
1435       return 1; 
1436    } 
1437           
1438    int  do_change_id(string arg) 
1439    { 
1440       string name, newname; 
1441       object fabao_ob, me=this_player(); 
1442       string *id_list, *t_list; 
1443       
1444       if( !arg || arg == "")  
1445          return notify_fail("请用 change_id 法宝 新英文名 来改名。\n"); 
1446           
1447       if( sscanf(arg, "%s %s", name, newname) != 2) 
1448          return notify_fail("请用 change_id 法宝 新英文名 来改名。\n"); 
1449        
1450       if( !objectp(fabao_ob=present(name, me)) ) 
1451          return notify_fail("你身上没有这样东西啊。\n"); 
1452     
1453       if(!fabao_ob->query("owner_id") || !fabao_ob->query("series_no"))  
1454          return notify_fail("那个不是法宝耶！\n"); 
1455     
1456       if( fabao_ob->query("equipped") ) 
1457          return notify_fail("你必须放下法宝才能改名。\n"); 
1458     
1459       if( !check_legal_id( newname ) )     return 1; 
1460       
1461       newname = replace_string(newname, " ", "_");  
1462       fabao_ob->set("id", newname); 
1463     
1464       id_list = ({ newname }); 
1465       t_list = explode( newname, "_"); 
1466       if( sizeof(t_list) > 1 )   { 
1467         id_list += t_list; 
1468       } 
1469       fabao_ob->set_name( fabao_ob->query("name"), id_list );  
1470       fabao_ob->save(); 
1471        
1472       write("改动成功。\n"); 
1473       return 1; 
1474    } 
1475     
1476           
1477    int  do_change_desc(string arg) 
1478    { 
1479       string name, newname; 
1480       object fabao_ob, me=this_player(); 
1481       
1482       if( !arg || arg == "")  
1483          return notify_fail("请用 change_desc 法宝 新描述 来重新描述法宝。\n"); 
1484           
1485       if( sscanf(arg, "%s %s", name, newname) != 2) 
1486          return notify_fail("请用 change_desc 法宝 新描述 来重新描述法宝。\n"); 
1487        
1488       if( !objectp(fabao_ob=present(name, me)) ) 
1489          return notify_fail("你身上没有这样东西啊。\n"); 
1490     
1491       if(!fabao_ob->query("owner_id") || !fabao_ob->query("series_no"))  
1492          return notify_fail("那个不是法宝耶！\n"); 
1493     
1494       if( fabao_ob->query("equipped") ) 
1495          return notify_fail("你必须放下法宝才能改名。\n"); 
1496     
1497       if( !check_legal_name(newname, 60 ) )     return 1; 
1498        
1499       fabao_ob->set("long", newname); 
1500       fabao_ob->save(); 
1501        
1502       write("改动成功。\n"); 
1503       return 1; 
1504    } 
1505           
