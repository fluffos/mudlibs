131     // 发出提示信息 
132     protected int ask_me() 
133     { 
134             message_vision("干将对$N说道：这些事请问莫邪，我只管炼剑。\n", this_player()); 
135             return 1; 
136     } 
137      
138     int accept_object(object me, object ob) 
139     { 
140             if (me->name(1) == "莫邪") 
141             { 
142                     if (me->query("id") != "mo ye") 
143                     { 
144                             command ("kick " + me->query("id")); 
145                             message_vision("$N嘿嘿的奸笑了两声，对$n说道：" 
146                                            "你以为取了我妻子的名字就能蒙蔽" 
147                                            "我？我还没瞎呢！\n", 
148                                            this_object(), me); 
149                             return 1; 
150                     } 
151                     start_work(ob->query("item/owner"), ob); 
152                     return 1; 
153             } 
154      
155             if (ob->query("item_origin")) 
156             { 
157                     message_vision("干将对$N说：你别给我这东西，把这个先交" 
158                                    "给莫邪，在她那里付了钱再说。\n", me); 
159                     return 0; 
160             } else 
161             if (ob->is_item_make()) 
162             { 
163                     if (ob->item_owner() != me->query("id")) 
164                     { 
165                             command("heng"); 
166                             command("say 这是你的东西吗？没收了！"); 
167                             destruct(ob); 
168                             return 1; 
169                     } 
170                     message_vision("$N疑惑的望着$n道：“你是嫌它" 
171                                    "不好么？那就退掉(discard)吧！”\n", 
172                                    this_object(), me); 
173                     return 0; 
174             } 
175      
176             message_vision("干将冷冷的对$N说道：你给我这些东西干什" 
177                            "么？我炼剑，不用这些东西。\n", me); 
178             return 0; 
179     } 
180      
181     protected int start_work(object me, object ob) 
182     { 
183             remove_call_out("prepare_make"); 
184             call_out("prepare_make", 1, me, ob); 
185             set_temp("item/making", ob); 
186             set_temp("item/player", me); 
187             me->set_temp("item/status", "waiting"); 
188             return 1; 
189     } 
190      
191     protected int prepare_make(object me, object ob) 
192     { 
193             message_vision(HIC "\n$N说道：好，开炉锻炼！\n\n" NOR, this_object()); 
194             message_vision(HIM "$N接过莫邪手中的" + ob->name() + 
195                            HIM "，随手把它抛入炉内，霎时间，那" + ob->name() + 
196                            HIM "已被火炉中的熊熊" HIR "烈焰" HIM "吞没。\n" + 
197                            "$N凝视着炉火，喃喃说道：天地之精华为其血脉，日" 
198                            "月之光辉是其灵气......\n\n" NOR , this_object()); 
199             remove_call_out("work_step_1"); 
200             call_out("work_step_1", 5, me, ob); 
201             return 1; 
202     } 
203      
204     protected int work_step_1(object me, object ob) 
205     { 
206             message_vision(HIG "炉火渐渐的转成了绿色，火苗不断跳跃，你觉得屋" 
207                            "内十分燥热，可是干将莫邪若无其事。\n\n" NOR, this_object()); 
208      
209             remove_call_out("work_step_2"); 
210             call_out("work_step_2", 6, me, ob); 
211             return 1; 
212     } 
213      
214     protected int work_step_2(object me, object ob) 
215     { 
216             message_vision(RED "炉火淡淡的暗了下来，呈现出一片红色......\n\n" NOR, this_object()); 
217             remove_call_out("work_step_3"); 
218             if (objectp(me)) 
219             call_out("work_step_3", 3, me, ob); 
220             return 1; 
221     } 
222      
223     protected int work_step_3(object me, object ob) 
224     { 
225             message_vision(HIW "$N左手持蛟龙剪，一扬手已经取出了" + ob->name() + 
226                            HIW "，右手持金刚锤聚精会神地用力锤打，\n渐渐的，" + ob->name() + 
227                            HIW "在干将手下的成了" + ob->query("item/ctype") + 
228                            HIW "的形状。\n\n" NOR, this_object()); 
229             remove_call_out("work_step_4"); 
230             call_out("work_step_4", 5, me, ob); 
231             return 1; 
232     } 
233      
234     protected int work_step_4(object me, object ob) 
235     { 
236             message_vision(HIC "$N锤打完毕，大喝一声，将" + ob->query("item/ctype") + 
237                            HIC "抛入水池，只听丝丝作响，从水池腾起一股雾气，" 
238                            "弥漫四周。\n\n" NOR, this_object()); 
239             remove_call_out("work_step_5"); 
240             call_out("work_step_5", 3, me, ob); 
241             return 1; 
242     } 
243      
244     protected int work_step_5(object me, object ob) 
245     { 
246             message_vision(HIW "$N缓缓的从水池抽出了炼好的" + ob->query("item/ctype") + 
247                            HIW "看了看，满意地说，很好，很好。\n\n" NOR, 
248                            this_object()); 
249             remove_call_out("work_step_6"); 
250             call_out("work_step_6", 2, me, ob); 
251     } 
252      
253     protected int work_step_6(object me, object ob) 
254     { 
255             object moye; 
256             int improve; 
257      
258             if (! objectp(moye = present("mo ye"))) 
259             { 
260                     message_vision(HIW "干将看了看四周，说道：咦，莫邪呢？" 
261                                    "算了算了，不做了，去吧！\n" 
262                                    "干将把炼好的道具抛进火炉，就此不见。\n\n" NOR, 
263                                    this_object()); 
264                     if (objectp(me)) 
265                             me->delete_temp("item"); 
266      
267                     if (objectp(ob) && present(ob, this_object())) 
268                             destruct(ob); 
269      
270                     delete_temp("item"); 
271                     return 1; 
272             } 
273      
274             if (! objectp(me)) 
275                     me = find_player(ob->query("item/owner_id")); 
276      
277             if (! objectp(me) || environment(me) != environment()) 
278             { 
279                     message_vision(HIW "$N叹了口气，说道：客人为何这就去" 
280                                    "了！？罢了罢了，不做了，去吧！\n" 
281                                    "$N把炼好的道具抛进火炉，就此不见。\n\n" NOR, 
282                                    this_object()); 
283                     if (objectp(me)) 
284                             me->delete_temp("item"); 
285      
286                     if (objectp(ob) && present(ob, this_object())) 
287                             destruct(ob); 
288      
289                     delete_temp("item"); 
290                     moye->delete_temp("item"); 
291                     return 1; 
292             } 
293             moye->set_temp("item/status", "waiting"); 
294             me->set_temp("item/status", "inputing"); 
295             message_vision("$N对$n说道：一" + ob->query("item/unit") + "好" + 
296                            ob->query("item/ctype") + NOR "不能没有名字，你给它起个名字吧！\n", 
297                            this_object(), me); 
298      
299             tell_rules(me); 
300      
301             // 清除道具的名字，ID，和其它属性，并且设置道具的价值和制造者 
302             ob->set("item/long", ""); 
303             ob->set("item/wield_msg", ""); 
304             ob->set("item/wear_msg", ""); 
305             ob->set("item/unwield_msg", ""); 
306             ob->set("item/remove_msg", ""); 
307             ob->set("item/owner_name", me->query("name")); 
308             ob->set("item/owner_id", me->query("id")); 
309      
310             // 设置等待时间，最多3次 
311             set_temp("item/waited", 4); 
312      
313             // 如果超时，提醒输入 
314             remove_call_out("waiting"); 
315             call_out("waiting", 240, me, ob, moye); 
316             return 1; 
317     } 
318      
319     protected int show_order() 
320     { 
321             object me; 
322      
323             me = this_player(); 
324             if (me->query_temp("item/status") != "inputing") 
325             { 
326                     message_vision("$N冷冷的坐在那里，理都不理$n。\n", 
327                                    this_object(), me); 
328                     return 1; 
329             } 
330      
331             tell_rules(me); 
332             return 1; 
333     } 
334      
335     void tell_rules(object me) 
336     { 
337             tell_object(me, CYN @RULES 
338     干将在你耳边悄声说道： 
339     名字需要你来定，其它信息系统有缺省的描述，当然也可以由你自己为它自定描述。 
340     当然了，最好不用让别人误会的词语字句噢。具体的方法如下。 
341         命名: name 中文名字 英文代号。   (必须有) 
342         描述: desc 武器的描述文字。      (可  选) 
343         装备: wieldmsg   装备时的描述。  (可  选) 
344         收起: unwieldmsg 收起时的描述。  (可  选) 
345     描述时分行请用\n，除了英文代号以外所有的文字都可以用颜色，使用颜色的方法可以参照nick 。 
346     如果你觉得可以了，就请告诉我(finish)，要是没看清楚，可以再问问我 < 规则 > 
347      
348     RULES NOR); 
349     } 
350      
351     void waiting(object me, object ob, object moye) 
352     { 
353             if (! objectp(me)) 
354                     me = find_player(ob->query("item/owner_id")); 
355      
356             if (! objectp(me)) 
357             { 
358                     message_vision("$N叹了口气说道：怎么这走了，算了算" 
359                                    "了，去吧！\n", this_object()); 
360                     if (objectp(moye)) 
361                             moye->delete_temp("item"); 
362      
363                     delete_temp("item"); 
364                     destruct(ob); 
365                     return; 
366             } 
367      
368             if (add_temp("item/waited", -1) <= 0) 
369             { 
370                     // 等待超时 
371                     if (objectp(moye)) 
372                             moye->delete_temp("item"); 
373      
374                     log_file("static/item", sprintf("%s %s do timeout when make item of %s\n", 
375                                      log_time(), log_id(me), 
376                                      (ob ? filter_color(ob->name(1)) : "???"))); 
377                     if (objectp(ob) && present(ob, this_object())) 
378                             destruct(ob); 
379      
380                     me->delete_temp("item"); 
381                     delete_temp("item"); 
382                     if (in_input(me)) return; 
383                     if (environment(me) == environment()) 
384                     { 
385                             message_vision("$N皱了皱眉头说道：这人怎么这么" 
386                                            "磨蹭，算了，不要就不要吧！\n", 
387                                            this_object()); 
388                             return; 
389                     } 
390                     message_vision("$N皱了皱眉头对$n说道：你这人怎么这么" 
391                                    "磨蹭，不要就算了，恕不退款！\n", 
392                                    this_object(), me); 
393                     return; 
394             } 
395      
396             if (environment(me) != environment()) 
397             { 
398                     message_vision("$N疑惑地说道：人怎么跑掉了？算了，再等" 
399                                    "他一会吧。\n", this_object()); 
400             } else 
401             if (! in_input(me)) 
402             { 
403                     message_vision(HIR "$N" HIR "催$n" HIR 
404                                    "道：快点，快点，别磨蹭，否则我可就不做了。\n" NOR, 
405                                    this_object(), me); 
406             } 
407      
408             remove_call_out("waiting"); 
409             call_out("waiting", 300, me, ob, moye); 
410     } 
411      
412     protected void clear_data() 
413     { 
414             object me; 
415             object ob; 
416             object moye; 
417      
418             if (objectp(moye = present("mo ye"))) 
419                     moye->delete_temp("item"); 
420      
421             if (objectp(ob = query_temp("item/making"))) 
422                     destruct(ob); 
423      
424             if (objectp(me = query_temp("item/player"))) 
425                     me->delete_temp("item"); 
426      
427             delete_temp("item"); 
428             remove_call_out("waiting"); 
429     } 
430      
431     int do_name(string arg) 
432     { 
433             object me; 
434             object ob; 
435             string pname; 
436             string sname, sid; 
437      
438             me = this_player(); 
439             if (me->query_temp("item/status") != "inputing") 
440                     return 0; 
441      
442             if (! arg || sscanf(arg, "%s %s", sname, sid) != 2) 
443             { 
444                     write("格式不对！应该是：命名 中文名字 英文名字\n例如：命名 长剑 sword\n"); 
445                     return 1; 
446             } 
447      
448             // ILLEGAL_STR = "." 表示非法的输入 
449             if ((sname = converts(sname, 14, COLORABLE)) == ILLEGAL_STR) 
450                     return 1; 
451      
452             if ((sid = converts(sid, 8, NOCOLOR)) == ILLEGAL_STR) 
453                     return 1; 
454      
455             if (! sname || ! sid) 
456             { 
457                     message_vision("$N摇摇头，对$n道：不行不行，你好好个定个名字！\n", 
458                                    this_object(), me); 
459                     return 1; 
460             } 
461      
462             if (file_size(ITEM_DIR + me->query("id")[0..0] + "/" + 
463                           me->query("id") + "-" + sid + ".lpc") != -1) 
464             { 
465                     message_vision("$N摇摇头，对$n道：不好，你不要再用(" + sid + 
466                                    ")这个英文代号了，换一个吧！\n", 
467                                    this_object(), me); 
468                     return 1; 
469             } 
470      
471             if (! is_chinese(filter_color(sname))) 
472             { 
473                     command("kick " + me->query("id")); 
474                     command("say 不会写中文字怎么的？"); 
475                     return 1; 
476             } 
477      
478             if (! is_legal_id(sid)) 
479             { 
480                     command("say 英文代号必须全部用小写英文才可以！"); 
481                     return 1; 
482             } 
483      
484             if (strlen(filter_color(sname)) < 4) 
485             { 
486                     command("say 我说你这名字起得也太短了吧，至少两个汉字！"); 
487                     return 1; 
488             } 
489      
490             if (strlen(sid) < 3) 
491             { 
492                     command("say 我说你这代号起得也太短了吧，至少三个字符！"); 
493                     return 1; 
494             } 
495      
496             if (sname[0] == 27 && 
497                 sname[4] == 'm') 
498             { 
499                     // Add color prefix 
500                     sname = NOR + sname; 
501             } 
502      
503             ob = query_temp("item/making"); 
504             ob->set("item/name", sname); 
505             ob->set("item/id", sid); 
506      
507             write("名字：" CYN + sname + "    代号：" CYN + sid + NOR "\n"); 
508             return 1; 
509     } 
510      
511     int do_desc(string arg) 
512     { 
513             object ob; 
514             object me; 
515             string chk; 
516      
517             me = this_player(); 
518             if (me->query_temp("item/status") != "inputing") 
519                     return 0; 
520      
521             ob = query_temp("item/making"); 
522             if (! ob->query("item/name")) 
523             { 
524                     message_vision("$N瞪了$n一眼道：你还是先给它取好名字再考虑描述吧！\n", 
525                                    this_object(), me); 
526                     return 1; 
527             } 
528      
529             if (! arg) 
530             { 
531                     write("参照格式：应该是 desc 描述的文字。\n例如：一把" 
532                           "锋利的$n\\n它在阳光下闪闪发光 -- 其中\\n表示换行，$n代表道具。\n"); 
533                     return 1; 
534             } 
535      
536             if ((arg = converts(arg, 200, COLORABLE)) == ILLEGAL_STR) 
537                     return 1; 
538      
539             arg = replace_string(arg, "$N", me->name(1)); 
540      
541             chk = filter_color(arg); 
542             if (strlen(chk) >= 2 && chk[0..1] == "你" || strsrch(chk, "\\n你") != -1) 
543                     return notify_fail("对不起，描述不能以“你”字打头。\n"); 
544      
545             chk = replace_string(chk, " ", ""); 
546             chk = replace_string(chk, "\\n", ""); 
547             chk = replace_string(chk, "$n", ""); 
548             if (! legal_chinese(chk)) 
549                     return notify_fail("对不起，描述必须使用汉字和系统规定可以使用的代表符号。\n"); 
550      
551             arg = replace_string(arg, "$n", ob->query("item/name")); 
552             arg = replace_string(arg, "\\n", "\n"); 
553             arg = chinese_desc(arg); 
554             ob->set("item/long", arg); 
555             write(CYN "当你观察它的时候将会出现下列描述：\n" NOR + arg + "\n"); 
556             return 1; 
557     } 
