840                       write("    道行五百年以上\n"); 
841                       write("    内力一千以上\n"); 
842                       write("    消耗最大内力一百五十点\n"); 
843                       break; 
844              case 3:  write(HIM+"内功抵抗力" + NOR+ "(armor_vs_force)升级需要：\n"); 
845                       write("    道行一千年以上\n"); 
846                       write("    内力一千五以上\n"); 
847                       write("    消耗最大内力两百五十点\n"); 
848                       break; 
849              case 4:  write(HIM+"内功抵抗力" + NOR+ "(armor_vs_force)升级需要：\n"); 
850                       write("    道行一千五百年以上\n"); 
851                       write("    内力两千以上\n"); 
852                       write("    消耗最大内力四百点\n"); 
853                       break; 
854              case 5:  write(HIM+"内功抵抗力" + NOR+ "(armor_vs_force)升级需要：\n"); 
855                       write("    道行三千五百年以上\n"); 
856                       write("    内力四千以上\n"); 
857                       write("    消耗最大内力八百点\n"); 
858                       break; 
859              case 6:  write("你的法宝"+HIM+"内功抵抗力"+NOR+"已经不能再升级了。\n"); 
860           } 
861           switch( spells_stars )   { 
862              case 1:  write(HIC+"魔法攻击力" + NOR+ "(spells)升级需要：\n"); 
863                       write("    道行两百年以上\n"); 
864                       write("    法力五百以上\n"); 
865                       write("    消耗最大法力五十点\n"); 
866                       write("    消耗道行五年\n"); 
867                       break; 
868              case 2:  write(HIC+"魔法攻击力" + NOR+ "(spells)升级需要：\n"); 
869                       write("    道行五百年以上\n"); 
870                       write("    法力一千以上\n"); 
871                       write("    消耗最大法力一百点\n"); 
872                       write("    消耗道行二十年\n"); 
873                       break; 
874              case 3:  write(HIC+"魔法攻击力" + NOR+ "(spells)升级需要：\n"); 
875                       write("    道行一千年以上\n"); 
876                       write("    法力一千五以上\n"); 
877                       write("    消耗最大法力一百五十点\n"); 
