661      
662     // 判断是否是合法的汉字 
663     protected int legal_chinese(string str) 
664     { 
665             int i; 
666      
667             if (strlen(str) < 2) return 0; 
668      
669             for (i = 0; i < strlen(str); i++) 
670             { 
671                     if (str[i] < 161 || str[i] == 255) return 0; 
672                     if ((! (i % 2)) && str[i] >= 248) return 0; 
673             } 
674      
675             return 1; 
676     } 
677      
678     // 转换字符串中的颜色标志 
679     protected string converts(string arg, int max_len, int no_color) 
680     { 
681             int i; 
682      
683             // 去除字符串中的空格，引号，避免被别人利用做破坏 
684             arg = replace_string(arg, " ", "");  
685             arg = replace_string(arg, "\"", "'"); 
686      
687             for (i = 0; i < strlen(arg) - 1; i++) 
688             { 
689                     if (arg[i] == '\\' && arg[i + 1] != 'n') 
690                     { 
691                             write("字符'\\'后面只能跟随n字符表示回车！\n"); 
692                             return ILLEGAL_STR; 
693                     } 
694             } 
695      
696             arg = replace_string(arg, ",", "，"); 
697             arg = replace_string(arg, ":", "："); 
698             arg = replace_string(arg, "?", "？"); 
699      
700             if (no_color) 
701             { 
702                     arg = replace_string(arg, "$BLK$", ""); 
703                     arg = replace_string(arg, "$RED$", ""); 
704                     arg = replace_string(arg, "$GRN$", ""); 
705                     arg = replace_string(arg, "$YEL$", ""); 
706                     arg = replace_string(arg, "$BLU$", ""); 
707                     arg = replace_string(arg, "$MAG$", ""); 
708                     arg = replace_string(arg, "$CYN$", ""); 
709                     arg = replace_string(arg, "$WHT$", ""); 
710                     arg = replace_string(arg, "$HIR$", ""); 
711                     arg = replace_string(arg, "$HIG$", ""); 
712                     arg = replace_string(arg, "$HIY$", ""); 
713                     arg = replace_string(arg, "$HIB$", ""); 
714                     arg = replace_string(arg, "$HIM$", ""); 
715                     arg = replace_string(arg, "$HIC$", ""); 
716                     arg = replace_string(arg, "$HIW$", ""); 
717                     arg = replace_string(arg, "$NOR$", ""); 
718             } else 
719             { 
720                     arg = replace_string(arg, "$BLK$", BLK); 
721                     arg = replace_string(arg, "$RED$", RED); 
722                     arg = replace_string(arg, "$GRN$", GRN); 
723                     arg = replace_string(arg, "$YEL$", YEL); 
724                     arg = replace_string(arg, "$BLU$", BLU); 
725                     arg = replace_string(arg, "$MAG$", MAG); 
726                     arg = replace_string(arg, "$CYN$", CYN); 
727                     arg = replace_string(arg, "$WHT$", WHT); 
728                     arg = replace_string(arg, "$HIR$", HIR); 
729                     arg = replace_string(arg, "$HIG$", HIG); 
730                     arg = replace_string(arg, "$HIY$", HIY); 
731                     arg = replace_string(arg, "$HIB$", HIB); 
732                     arg = replace_string(arg, "$HIM$", HIM); 
733                     arg = replace_string(arg, "$HIC$", HIC); 
734                     arg = replace_string(arg, "$HIW$", HIW); 
735                     arg = replace_string(arg, "$NOR$", NOR); 
736                     if (strlen(arg) < strlen(NOR) || 
737                         arg[strlen(arg) - strlen(NOR)..<1] != NOR) 
738                     { 
739                             // append NOR at tail 
740                             arg += NOR; 
741                     } 
742             } 
743             if (strlen(arg) > max_len + 30 || 
744                 strlen(filter_color(arg)) > max_len) 
745             { 
746                     write("对不起，这个字符串太长了，请不要输入超过" + chinese_number(max_len) + 
747                           "个字符长的字符串。\n"); 
748                     // 表示非法的输入 
749                     return ILLEGAL_STR; 
750             } 
751             return arg; 
752     } 
753      
754     int do_finish() 
755     { 
756             object me; 
757             object ob; 
758             object moye; 
759             string msg; 
760      
761             me = this_player(); 
762             if (me->query_temp("item/status") != "inputing") 
763                     return 0; 
764      
765             if (! objectp(ob = query_temp("item/making"))) 
766             { 
767                     // 数据不对，可能是由于BUG造成，也可能是因为干将被update过 
768                     write("系统故障：数据不一致，你无法完成炼制道具！\n"); 
769                     me->delete_temp("item"); 
770                     delete_temp("item"); 
771                     if (objectp(moye = present("mo ye"))) 
772                             moye->delete_temp("item"); 
773      
774                     // 返回失败，停止进行 
775                     return 0; 
776             } 
777              
778             if (! ob->query("item/name")) 
779             { 
780                     message_vision("$N瞪了$n一眼，说道：你怎么能不给它起个" 
781                                    "名字？你要是不想要了就算了！\n", 
782                                    this_object(), me); 
783                     return 1; 
784             } 
785      
786             if (! ob->query("item/id")) 
787             { 
788                     message_vision("$N瞪了$n一眼，说道：你怎么能不给它起个" 
789                                    "代号？你要是不想要了就算了！\n", 
790                                    this_object(), me); 
791                     return 1; 
792             } 
793      
794             // 显示 player 输入的信息 
795             msg = sprintf("干将对$N说：你的道具描述如下，请看看有没有错。\n"); 
796             message_vision(msg, me); 
797             // 私有信息 
798             msg = sprintf("道具名字：%s   道具英文代号：%s\n\n", 
799                           ob->query("item/name"), ob->query("item/id")); 
800             if (ob->query("item/long") != "") 
801                     msg += sprintf(CYN "外观描述如下：" NOR "\n%s\n\n", ob->query("item/long")); 
802             else 
803                     msg += "采用缺省的外观描述。\n"; 
804      
805             if (ob->query("item/wield_msg") != "") 
806                     msg += sprintf(CYN "装备时描述如下：" NOR "\n%s\n\n", 
807                                    replace_string(ob->query("item/wield_msg"), "\\n", "\n")); 
808             else 
809                     msg += "装备时采用缺省的描述。\n"; 
810      
811             if (ob->query("item/unwield_msg") != "") 
812                     msg += sprintf(CYN "收回时描述如下：" NOR "\n%s\n\n", 
813                                    replace_string(ob->query("item/unwield_msg"), "\\n", "\n")); 
814             else 
815                     msg += "收回时采用缺省的描述。\n"; 
816                     msg += CYN "如果没有问题，就可以继续进行了(y/n):" NOR; 
817             msg = replace_string(msg, "$N", me->query("name")); 
818             msg = replace_string(msg, "$n", ob->query("item/name")); 
819      
820             tell_object(me, msg); 
821      
822             // 判定 player 是否决定生成道具 
823             input_to("confirm_make", ob); 
824             return 1; 
825     } 
826      
827     void confirm_make(string arg, object ob) 
828     { 
829             object me; 
830             object moye; 
831             string item_filename; 
832      
833             me = this_player(); 
834      
835             if (! objectp(query_temp("item/making"))) 
836             { 
837                     command("kick " + me->query("id")); 
838                     command("say 你太磨蹭了，这生意我不做了，恕不退货！"); 
839                     return; 
840             } 
841      
842             if (arg != "y" && arg != "Y") 
843             { 
844                     message_vision("$N对道：那你还是再看看吧！\n", this_object()); 
845                     return; 
846             } 
847      
848             message_vision("$N对$n说道：好，马上就好！\n", 
849                            this_object(), me); 
850             if (item_filename = create_file(ob)) 
851             { 
852                     // clear the old item's data 
853                     DBASE_D->set_object_data(ob, 0); 
854                     destruct(ob); 
855                     catch(call_other(item_filename, "???")); 
856                     ob = find_object(item_filename); 
857                     if (! ob) 
858                     { 
859                             message_vision("$N一呆，对$n道：抱歉抱歉！出了一些问题！\n", 
860                                            this_object(), me); 
861                     } else 
862                     { 
863                             ob->move(me, 1); 
864                             ob->save();             // Create the record in dbase 
865                             me->add("item/make_weapon", 1); 
866                             message_vision("$N把" + ob->query("name") + "交给了$n。\n", 
867                                            this_object(), me); 
868                             log_file("static/item", sprintf("%s %s created  %s(%s)\n", 
869                                      log_time(), log_id(me), 
870                                      filter_color(ob->name(1)), ob->query("id"))); 
871                     } 
872             } 
873      
874             if (objectp(moye = present("mo ye", environment()))) 
875                     moye->delete_temp("item"); 
876      
877             me->delete_temp("item"); 
878             delete_temp("item"); 
879             remove_call_out("waiting"); 
880     } 
881      
882     // 生成道具文档, 需要一个的道具原料对象 
883     // 生成以后建立 ITEM_DIR/???.c 然后删除旧的原料对象, 生成一件新的道具，返回文件名 
884      
885     // 关于原料对象各个属性的说明(item/) 
886     // ------ 用户可以描述的属性 
887     // name                 道具的名称， 必须要 
888     // id                   道具的ID，   必须要 
889     // long                 道具的描述，系统会在生成道具时自动添加关于炼制原料的描述 
890     // wield_msg            装备武器的描述，如果没有系统会自动生成 
891     // unwield_msg          收回武器时的描述 
892     // wear_msg             穿上护甲时的描述 
893     // unwear_msg           脱掉护甲时的描述 
894      
895     // ------ 不是用户描述的属性 
896     // owner_id             制造者的ID 
897     // owner_name           制造者的名字 
898     // unit                 单位 
899     // type                 道具的类型 weapon 或 armor 
900     // stype                道具的子类别 weapon 为 sword, blade, whip, stick ； armor 为 armor 
901     // ctype                道具的类别的中文名 weapon 为 剑、刀、鞭、杖 ； armor 为 护甲 
902     // value                道具的价值 
903     // point                伤害力 
904      
905     // ------ 说明是用户自练的道具的属性 
906     // item_make            1 
907      
908     protected string create_file(object item_temp) 
909     { 
910             string  buf;                    // 生成文件的缓冲区 
911             string  filename; 
912             string  desc; 
913             int     i; 
914             mapping info; 
915             string  ih; 
916             string  id; 
917      
918             // 生成文件名 
919             id = item_temp->query("item/owner_id"); 
920             filename = ITEM_DIR + id[0..0] + "/" + id +  
921                        "-" + item_temp->query("item/id") + ".lpc"; 
922             if (file_size(filename) != -1) 
923             { 
924                     write("无法生成档案，请通知巫师处理。\n"); 
925                     return 0; 
926             } 
927             assure_file(filename); 
928             buf = "// ITEM Made by player(" + item_temp->query("item/owner_name") + 
929                   ":" + item_temp->query("item/owner_id") + ") " + filename +  
930                   "\n// Written by GAN JIANG(Doing Lu 1998/11/2)\t" + ctime(time()) + "\n"; 
931             info = item_temp->query("item"); 
932             ih = up_case(info["stype"]); 
933             if (info["type"] == "weapon") 
934             { 
935                     // 生成武器道具文件 
936                     desc = "这是由" + item_temp->query("material_name") + "炼制而成的一" + 
937                            info["unit"] + info["ctype"] + "。\n"; 
938      
939                     desc += info["long"]; 
940                     if (desc[strlen(desc) - 1] != '\n') 
941                             desc += "\n"; 
942      
943                     desc += info["ctype"] + "柄上刻着一行小字：" + 
944                             info["owner_name"] + "(" + info["owner_id"] + ")\n"; 
945      
946                     // 自动补充空信息 
947                     if (info["wield_msg"] == "") 
948                     { 
949                             info["wield_msg"] = HIC "$N" HIC "一声清啸，" + 
950                                                 (info["stype"] == "throwing" ? "握着一" : "抖出一") + 
951                                                 info["unit"] + HIC "$n" HIC "。" NOR; 
952                     } 
953      
954                     if (info["unwield_msg"] == "") 
955                     { 
956                             info["unwield_msg"] = "$N随手一抹，收起了$n。"; 
957                     } 
958                     buf += "#include <ansi.h>\n"; 
959                     buf += "#include <weapon.h>\n\n"; 
960                     buf += "inherit " + ih + ";\n"; 
961                     buf += "inherit F_ITEMMAKE;\n\n"; 
962                     buf += "void create()\n{\n"; 
963                     buf += sprintf("\tset_name(\"%s\", ({ \"%s\" }));\n",  
964                                     info["name"], info["id"]); 
965                     buf += sprintf("\tset_weight(%d);\n",  
966                                     item_temp->query_weight() * item_temp->query("item/wscale") / 100); 
967                     buf += sprintf("\tset(\"item_make\", 1);\n"); 
968                     buf += sprintf("\tset(\"unit\", \"%s\");\n", info["unit"]); 
969                     buf += sprintf("\tset(\"long\", \"%s\");\n", desc); 
970                     buf += sprintf("\tset(\"value\", %d);\n", info["value"]); 
971                     if (info["stype"] == "throwing") 
972                     { 
973                            buf += sprintf("\tset(\"base_weight\", %d);\n", 
974                                            item_temp->query_weight() * item_temp->query("item/wscale") / 10000); 
975                            buf += sprintf("\tset(\"base_unit\", \"枚\");\n"); 
976                            // buf += sprintf("\tset(\"base_value\", %d);\n", info["value"] / 100); 
977                            buf += sprintf("\tset(\"base_value\", 1);\n"); 
978                     } 
979                     buf += sprintf("\tset(\"point\", %d);\n", info["point"]); 
980                     buf += sprintf("\tset(\"material\", \"%s\");\n", item_temp->query("material_attrib")); 
981                     buf += sprintf("\tset(\"material_file\", \"%s\");\n", base_name(item_temp)); 
982                     if (info["stype"] == "throwing") 
983                     { 
984                             buf += sprintf("\tset(\"hand_msg\", \"%s\\n\");\n", info["wield_msg"]); 
985                             buf += sprintf("\tset(\"unhand_msg\", \"%s\\n\");\n", info["unwield_msg"]); 
986                     } else 
987                     { 
988                             buf += sprintf("\tset(\"wield_msg\", \"%s\\n\");\n", info["wield_msg"]); 
989                             buf += sprintf("\tset(\"unwield_msg\", \"%s\\n\");\n", info["unwield_msg"]); 
990                     } 
991                     buf += sprintf("\tif (! check_clone()) return;\n\trestore();\n"); 
992                     if (info["stype"] == "throwing") 
993                             buf += sprintf("\tset_amount(100);\n"); 
994                     buf += sprintf("\tinit_%s(apply_damage());\n", info["stype"]); 
995                     buf += prop_segment(info["prop"], ""); 
996                     buf += sprintf("\n\tsetup();\n}\n\n"); 
997                     // 生成武器道具文件完毕 
998             }  
999             else 
1000            { 
1001                    // 生成防护道具文件 
1002                    desc = "这是由" + item_temp->query("material_name") + "炼制而成的一" + 
1003                           info["unit"] + info["ctype"] + "。\n"; 
1004     
1005                    desc += info["long"]; 
1006                    if (desc[strlen(desc) - 1] != '\n') 
1007                            desc += "\n"; 
1008     
1009                    desc += info["ctype"] + "缘上刻着一行小字：" + 
1010                            info["owner_name"] + "(" + info["owner_id"] + ")\n"; 
1011     
1012                    // 自动补充空信息 
1013                    if (info["wear_msg"] == "") 
1014                    { 
1015                            info["wear_msg"] = YEL "$N" YEL "装备" + 
1016                                               info["name"] + YEL "。" NOR; 
1017                    } 
1018                    if (info["remove_msg"] == "") 
1019                    { 
1020                            info["remove_msg"] = YEL "$N" YEL "脱下了" + 
1021                                                 info["name"] + YEL "。" NOR; 
1022                    } 
1023                    buf += "#include <ansi.h>\n"; 
1024                    buf += "#include <armor.h>\n\n"; 
1025                    buf += "inherit " + ih + ";\n"; 
1026                    buf += "inherit F_ITEMMAKE;\n\n"; 
1027                    buf += "void create()\n{\n"; 
1028                    buf += sprintf("\tset_name(\"%s\", ({ \"%s\" }));\n",  
1029                                    info["name"], info["id"]); 
1030                    buf += sprintf("\tset_weight(%d);\n", 
1031                                    item_temp->query_weight() * item_temp->query("item/wscale") / 100); 
1032                    buf += sprintf("\tset(\"item_make\", 1);\n"); 
1033                    buf += sprintf("\tset(\"unit\", \"%s\");\n", info["unit"]); 
1034                    buf += sprintf("\tset(\"long\", \"%s\");\n", desc); 
1035                    buf += sprintf("\tset(\"value\", %d);\n", info["value"]); 
1036                    buf += sprintf("\tset(\"point\", %d);\n", info["point"]); 
1037                    buf += sprintf("\tset(\"material\", \"%s\");\n", item_temp->query("material_attrib")); 
1038                    buf += sprintf("\tset(\"material_file\", \"%s\");\n", base_name(item_temp)); 
1039                    buf += sprintf("\tset(\"wear_msg\", \"%s\\n\");\n", info["wear_msg"]); 
1040                    buf += sprintf("\tset(\"remove_msg\", \"%s\\n\");\n", info["remove_msg"]); 
1041                    buf += sprintf("\tif (! check_clone()) return;\n\trestore();\n"); 
1042                    if (! info["prop"]) 
1043                            buf += sprintf("\tset(\"armor_prop/armor\", apply_armor());\n"); 
1044                    else 
1045                            buf += prop_segment(info["prop"], ""); 
1046                    buf += sprintf("\n\tsetup();\n}\n\n"); 
1047                    // 生成防护道具文件完毕 
1048            } 
1049            buf += sprintf("string long() { return query(\"long\") + item_long(); }\n"); 
1050     
1051            if (save_item_file(filename, buf) == 1) 
1052                    return filename; 
1053     
1054            return 0; 
1055    } 
1056     
1057    // add mapping 
1058    protected string prop_segment(mapping p, string path) 
1059    { 
1060            string buf; 
1061            string *ks; 
1062            int i; 
1063     
1064            buf = ""; 
1065            if (! p) return buf; 
1066     
1067            ks = keys(p); 
1068            for (i = 0; i < sizeof(ks); i++) 
1069            { 
1070                    // check the paramter's type 
1071                    if (mapp(p[ks[i]])) 
1072                    { 
1073                            path += ks[i] + "/"; 
1074                            buf += prop_segment(p[ks[i]], path); 
1075                    } else 
1076                            buf += sprintf("\tset(\"%s\", %s);\n", 
1077                                           path + ks[i], (string)p[ks[i]]); 
1078            } 
1079     
1080            return buf; 
1081    } 
1082     
1083    // filename 是写入文档的名称，已经包含有路径 
1084    // content 是写入文档的内容 
1085    protected int save_item_file(string filename, string content) 
1086    { 
1087            rm(filename); 
1088            if (write_file(filename, content)) 
1089            { 
1090                    VERSION_D->append_sn(filename); 
1091                    return 1; 
1092            } else 
1093            { 
1094                    write("写入档案(" + filename + ")时出错，请通知巫师处理。\n"); 
1095                    return 0; 
1096            } 
1097    } 
1098     
1099    int do_discard(string arg) 
1100    { 
1101            string desc; 
1102            object money; 
1103            object ob, item; 
1104            object me; 
1105            int n; 
1106     
1107            if (! arg) 
1108                    return notify_fail("你去退回什么东西？\n"); 
1109     
1110            me = this_player(); 
1111            if (! objectp(ob = present(arg, me))) 
1112                    return notify_fail("你身上没有这种东西。\n"); 
1113     
1114            message_vision("$n拿出一" + ob->query("unit") + ob->name() + 
1115                           "对$N说：“这个东西我想退掉了...”\n", 
1116                           this_object(), me); 
1117     
1118            if (! ob->is_item_make()) 
1119            { 
1120                    command("heng"); 
1121                    command("say 这不是我这里出来的东西，我可不能负责。"); 
1122                    return 1; 
1123            } 
1124     
1125            if (ob->item_owner() != me->query("id")) 
1126            { 
1127                    command("kick " + me->query("id")); 
1128                    command("say 你拿了别人的东西还敢来我这里？以为我是傻子？"); 
1129                    return 1; 
1130            } 
1131     
1132            command("sigh"); 
1133            command("say 一千多年来还没有什么人嫌我的货色不好的，算了！算了！"); 
1134            message_vision("$N接过$n递过来的" + ob->name() + "，随手" 
1135                           "扔进了火炉，呆呆的望了半晌。\n", 
1136                           this_object(), me); 
1137                            
1138            if (ob->query("material_file")) 
1139            { 
1140                    item = new(ob->query("material_file")); 
1141                    item->move(me, 1); 
1142            } else 
1143            { 
1144                    sscanf(filter_color(ob->query("long")), "这是由%s炼制而成%*s", desc); 
1145                    if (! undefinedp(material[desc])) 
1146                            item = new(material[desc]); 
1147                    else 
1148                            item = new("/d/item/obj/butian");   
1149                    item->move(me, 1); 
1150            } 
1151            message_vision("不一会儿" + ob->name() + "就熔化成一块" + item->name() + "。\n", 
1152                           this_object(), me);                                                
1153                     
1154            command("say 你既然不满意我的东西，我也不能收你的钱，" 
1155                    "这些算是我退回给你的！"); 
1156            n = (ob->query("value") * 8 / 10 + 9999) / 10000; 
1157            if (! n) 
1158            { 
1159                    money = new("/clone/money/silver"); 
1160                    money->set_amount(1); 
1161            } else 
1162            { 
1163                    money = new("/clone/money/gold"); 
1164                    money->set_amount(n); 
1165            } 
1166            message_vision("$N拿出一" + item->query("unit") + item->name() + "交给" 
1167                           "$n。\n", this_object(), me); 
1168            message_vision("$N拿出一些" + money->name() + "交给" 
1169                           "$n。\n", this_object(), me); 
1170            log_file("static/item", sprintf("%s %s discard  %s(%s)\n", 
1171                                    log_time(), log_id(me), 
1172                                    filter_color(ob->name(1)), ob->query("id"))); 
1173            me->delete("can_summon/" + ob->query("id")); 
1174            me->add("item/make_weapon", -1); 
1175            rm(base_name(ob) + ".lpc"); 
1176            DBASE_D->clear_object(ob); 
1177            money->move(me, 1); 
1178            return 1; 
1179    } 
1180     
1181    int do_notch(string arg) 
1182    { 
1183            object me, ob, ob1; 
1184            int flag; 
1185             
1186            if (! arg) 
1187                    return notify_fail("你要将什么东西开槽？\n"); 
1188     
1189            me = this_player(); 
1190            if (! objectp(ob = present(arg, me))) 
1191                    return notify_fail("你身上没有这种东西。\n"); 
1192     
1193            if (ob->query("equipped")) 
1194                    return notify_fail("你先解除" + ob->name() + "的装备再说！\n"); 
1195                     
1196            if (me->query("balance") < 10000000 ) 
1197                    return notify_fail("你在钱庄里的存款不够支付道具开槽费用。\n"); 
1198                     
1199            message_vision(CYN "$n拿出一" + ob->query("unit") + ob->name() + 
1200                           CYN "对$N说：我想请您给" + ob->name() + CYN "开些镶嵌用的凹槽。\n", 
1201                           this_object(), me); 
1202     
1203            if (! ob->is_item_make() && ! ob->query("unique")) 
1204            { 
1205                    command("heng"); 
1206                    command("say 我且能给这如此平凡之物开槽钻孔？！"); 
1207                    return 1; 
1208            } 
1209     
1210            if (! ob->query("armor_type") &&  
1211                ! ob->query("skill_type")) 
1212            { 
1213                    command("say 我只给兵器或防具类型的道具开槽打孔。"); 
1214                    return 1; 
1215            } 
1216             
1217            if (ob->query("enchase/flute")) 
1218            { 
1219                    command("heng"); 
1220                    command("say 这不是我已经给开槽过了吗。"); 
1221                    return 1; 
1222            }        
1223             
1224            message_vision(HIM "$N接过$n" HIM "手中的" + ob->name() + HIM "，随手把它抛入炉" 
1225                         "内，霎时间，那" + ob->name() + HIM "已被火炉中的熊" HIR "烈焰" HIM "吞没。\n" 
1226                         "$N凝视着炉火，仰天叹道：天地之精华为其血脉，日月之光辉是其灵气......\n" NOR,  
1227                         this_object(), me); 
1228             
1229            flag = 0; 
1230            ob1 = present("dragon horn", me); 
1231            if (objectp(ob1)) flag = 1; 
1232             
1233            command("say 你要是有青龙之角这个开槽至宝就好了。");    
1234            if (ob->query("skill_type") || (ob->query("armor_type") && 
1235                ob->query("armor_type") == "hands")) 
1236            { 
1237                    if (flag) 
1238                    { 
1239                            ob->set("enchase/flute", 7);                           
1240                            message_vision(HIC "$n赶紧把" + ob1->name() + HIC "取出必恭必敬交给$N。\n" NOR, this_object(), me); 
1241                            destruct(ob1); 
1242                    } 
1243                    else               
1244                            ob->set("enchase/flute", 4 + random(4)); 
1245            } 
1246            else 
1247            { 
1248                    if (flag) 
1249                    { 
1250                            ob->set("enchase/flute", 5); 
1251                            message_vision(HIC "$n赶紧把" + ob1->name() + HIC "取出必恭必敬交给$N。\n" NOR, this_object(), me); 
1252                            destruct(ob1); 
1253                    } 
1254                    else                                          
1255                            ob->set("enchase/flute", 3 + random(3)); 
1256            } 
1257                     
1258            ob->set("enchase/used", 0); 
1259     
1260            ob->save(); 
1261             
1262            me->add("balance", -10000000); 
1263            me->save(); 
1264     
1265            message_vision(HIW "$N左手持蛟龙剪，一扬手已经取出了" + ob->name() + 
1266                           HIW "，右手持" + (flag ? "青龙之角" : "金刚钻") + "聚精会神地用力敲打着，\n片刻间，" + ob->name() + 
1267                           HIW "上面豁然多了" HIY + chinese_number(ob->query("enchase/flute")) +  
1268                           HIW "个圆形的小孔。\n\n" NOR, this_object(), me); 
1269     
1270            message_vision(HIC "$N把" + ob->name() + HIC "交还给了$n。\n" NOR, this_object(), me); 
1271            command("say 行了，行了！你可以走了。"); 
1272            return 1; 
1273    } 
1274     
1275    int do_wash(string arg) 
1276    { 
1277            object me, ob, ob1; 
1278            int f; 
1279             
1280            if (! arg) 
1281            { 
1282                    command("say 你要将什么东西上的宝石清理掉？"); 
1283                    return 1; 
1284            } 
1285     
1286            me = this_player(); 
1287            if (! objectp(ob = present(arg, me))) 
1288            { 
1289                    command("say 你身上没有这种东西。"); 
1290                    return 1; 
1291            } 
1292     
1293            if (ob->query("equipped")) 
1294            { 
1295                    command("say 你先解除" + ob->name() + CYN "的装备再说！"); 
1296                    return 1; 
1297            } 
1298                     
1299            message_vision(CYN "$n拿出一" + ob->query("unit") + ob->name() + 
1300                           CYN "对$N说：我想请您帮把" + ob->name() + CYN "凹槽里的宝石清理掉。\n" NOR, 
1301                           this_object(), me); 
1302     
1303            if (! ob->is_item_make() && ! ob->query("unique")) 
1304            { 
1305                    command("heng"); 
1306                    command("say 我且能给这如此平凡之物清理凹槽里物品？！"); 
1307                    return 1; 
1308            } 
1309     
1310            if (ob->is_item_make() && ob->item_owner() != me->query("id"))  
1311            { 
1312                    command("kick " + me->query("id"));  
1313                    command("say 你拿了别人的东西还敢来我这里？以为我是傻子？");  
1314                    return 1;  
1315            } 
1316     
1317            if (! ob->query("armor_type") &&  
1318                ! ob->query("skill_type")) 
1319            { 
1320                    command("say 我只给兵器或防具类型的道具处理凹槽的宝石。"); 
1321                    return 1; 
1322            } 
1323             
1324            if (! ob->query("enchase/flute")) 
1325            { 
1326                    command("heng"); 
1327                    command("say 这还没有开槽过了呢。"); 
1328                    return 1; 
1329            }        
1330             
1331            if (! ob->query("enchase/used")) 
1332            { 
1333                    command("heng"); 
1334                    command("say 这上面没有镶嵌过东西。"); 
1335                    return 1; 
1336            }        
1337     
1338            message_vision(HIM "$N接过$n" HIM "手中的" + ob->name() + HIM "，随手把它抛入炉" 
1339                         "内，霎时间，那" + ob->name() + HIM "已被火炉中的熊" HIR "烈焰" HIM "吞没。\n" NOR,  
1340                         this_object(), me); 
1341                          
1342            message_vision(RED "炉火淡淡的暗了下来，呈现出一片红色......\n" NOR, this_object(), me); 
1343            message_vision(HIW "$N左手持蛟龙剪，一扬手已经取出了" + ob->name() + 
1344                           HIW "，右手持金刚钻聚精会神地用力敲打着，\n片刻间，" + ob->name() + 
1345                           HIW "上面" HIY + chinese_number(ob->query("enchase/flute")) +  
1346                           HIW "个凹槽内已空无一物，犹如新出。\n" NOR, this_object(), me); 
1347                     
1348            f = ob->query("enchase/flute"); 
1349            ob->delete("enchase"); 
1350            ob->delete("magic/power"); 
1351            ob->delete("magic/type"); 
1352            ob->delete("magic/tessera"); 
1353            ob->delete("ultimate/69"); 
1354            ob->delete("ultimate/87"); 
1355            ob->delete("ultimate/105"); 
1356            ob->set("enchase/flute", f);  
1357            if (ob->query("material") == "tian jing") 
1358                    ob->set("enchase/SN", 8); 
1359            if (ob->query("material") == "noname object") 
1360                    ob->set("enchase/SN", 16); 
1361            ob->save(); 
1362             
1363            me->save(); 
1364            message_vision(HIC "$N把" + ob->name() + HIC "交还给了$n。\n" NOR, this_object(), me); 
1365            command("say 行了，行了！你可以走了。"); 
1366            return 1; 
1367    } 
