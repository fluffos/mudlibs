1       // hide.c 隐藏兵器 
2        
3       #include <ansi.h> 
4       #include <command.h> 
5        
6       inherit F_CLEAN_UP; 
7        
8       int main(object me, string str) 
9       { 
10              object ob; 
11              int i; 
12       
13              if (! str) 
14                      return notify_fail("你要隐藏什么物品？\n"); 
15       
16              if (! stringp(me->query("can_summon/" + str))) 
17                      return notify_fail("你不知道如何隐藏这个物品。\n"); 
18       
19              if (! objectp(ob = present(str, me)) && 
20                  ! objectp(ob = present(str, environment(me)))) 
21                      return notify_fail("你身边没有这个物品。\n"); 
22       
23              if (! ob->hide_anywhere(me)) 
24              { 
25                      message_vision(HIM "$N" HIM "举着" + ob->name() + 
26                                     HIM "，口中念念有词。\n然而" 
27                                     "什么也没有发生 :)\n", me); 
28              } 
29       
30              return 1; 
31      } 
32       
33      int help(object me) 
34      { 
35      write(@HELP 
36      指令格式 : hide <物品的ID> 
37       
38      此指令可让你隐藏某些物品，让它们暂时消失。 
39      HELP 
40          ); 
41          return 1; 
42      } 
43       

