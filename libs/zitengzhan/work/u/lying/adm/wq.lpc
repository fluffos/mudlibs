756            ({ "/data/enchase/BLKjewel7-1", 
757               "/data/enchase/BLUjewel7-1", 
758               "/data/enchase/CYNjewel7-1", 
759               "/data/enchase/GRNjewel7-1", 
760               "/data/enchase/MAGjewel7-1", 
761               "/data/enchase/REDjewel7-1", 
762               "/data/enchase/WHTjewel7-1", 
763               "/data/enchase/YELjewel7-1", 
764               "/data/enchase/mjade-1", 
765               "/clone/enchase/rune07-1", 
766                }) : "/clone/fam/etc/hanjing", 
767      
768             // 圣魔之心·魔 
769            ({ "/data/enchase/BLKjewel7-1", 
770               "/data/enchase/BLUjewel7-1", 
771               "/data/enchase/CYNjewel7-1", 
772               "/data/enchase/GRNjewel7-1", 
773               "/data/enchase/MAGjewel7-1", 
774               "/data/enchase/REDjewel7-1", 
775               "/data/enchase/WHTjewel7-1", 
776               "/data/enchase/YELjewel7-1", 
777               "/data/enchase/mcrystal-1", 
778               "/clone/enchase/rune07-1", 
779                }) : "/clone/fam/etc/mozhixin", 
