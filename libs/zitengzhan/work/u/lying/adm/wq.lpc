581                            "己，$n代表道具。\n"); 
582                     return 1; 
583             } 
584      
585             if ((arg = converts(arg, 200, COLORABLE)) == ILLEGAL_STR) 
586                     return 1; 
587      
588             chk = filter_color(arg); 
589             if (strlen(chk) >= 2 && chk[0..1] == "你" || strsrch(chk, "\\n你") != -1) 
590                     return notify_fail("对不起，描述不能以“你”字打头。\n"); 
591      
592             chk = replace_string(chk, " ", ""); 
593             chk = replace_string(chk, "\\n", ""); 
594             chk = replace_string(chk, "$N", ""); 
595             chk = replace_string(chk, "$n", ""); 
596             if (! legal_chinese(chk)) 
597                     return notify_fail("对不起，描述必须使用汉字和系统规定可以使用的代表符号。\n"); 
598      
599             // 这里不区分武器还是装备，在生成文件时自动选择一条信息 
600             arg = chinese_desc(arg); 
601             arg = replace_string(arg, me->name(1), "$N"); 
602             ob->set("item/wear_msg", arg); 
603             ob->set("item/wield_msg", arg); 
604             arg = replace_string(arg, "\\n", "\n"); 
605             arg = replace_string(arg, "$N", me->name(1)); 
606             arg = replace_string(arg, "$n", ob->query("item/name")); 
607             write(CYN "当你装备它的时候将会出现下列描述：\n" NOR + arg + "\n"); 
608             return 1; 
609     } 
