> more summon.c
-------- 文件的顶部 --------
1       // summon. 取回兵器 
2        
3       #include <ansi.h> 
4       #include <command.h> 
5        
6       inherit F_CLEAN_UP; 
7        
8       int main(object me, string str) 
9       { 
10              object ob; 
11              string file, msg; 
12              mapping summon; 
13              string *ks; 
14       
15              if (! str) 
16              { 
17                      summon = me->query("can_summon"); 
18                      if (! mapp(summon)) 
19                              return notify_fail("你要召唤什么物品？\n"); 
20       
21                      ks = keys(summon); 
22                      msg = "你现在可以召唤的物品代码有"; 
23                      if (sizeof(ks) >= 2) 
24                              msg += implode(ks[0..sizeof(ks) - 2], "、") + 
25                                      "和" + ks[sizeof(ks) - 1] + "。\n"; 
26                      else 
27                              msg += ks[0] + "。\n"; 
28                      msg = sort_string(msg, 64); 
29                      write(msg); 
30                      return 1; 
31              } 
32       
33              if (me->is_busy()) 
34                      return notify_fail("你现在正忙，等你有空了再说吧。\n"); 
35       
36              if (! stringp(file = me->query("can_summon/" + str))) 
37                      return notify_fail("你不知道如何召唤这个物品。\n"); 
38       
39              if (file_size(file + ".lpc") < 0 && file_size(file) < 0) 
40                      return notify_fail("你不知道如何召唤这个物品。\n"); 
41       
42              if (me->is_ghost()) 
43                      return notify_fail("等你还了阳再召唤吧。\n"); 
44       
45              call_other(file, "???"); 
46              ob = find_object(file); 
47              if (! ob || ! ob->receive_summon(me)) 
48              { 
49                      message_vision(HIM "$N" HIM "扬起手来，口中念念有" 
50                                     "词。\n然而什么也没有发生 :)\n", me); 
51              } 
52       
53              if (me->is_fighting()) 
54                      me->start_busy(2 + random(3)); 
55       
56              return 1; 
57      } 
58       
59      int help(object me) 
60      { 
61              write(@HELP 
62      指令格式 : summon <物品的ID> 
63       
64      此指令可让你把某些物品呼唤过来并装备上，当然你得有一定的 
65      精力施展仙术才行。 
66      HELP ); 
67              return 1; 
68      } 
69       
70       







