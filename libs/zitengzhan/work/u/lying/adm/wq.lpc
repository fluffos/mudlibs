583        newob->set("upgraded/armor_vs_spells", 0); 
584        if( fabao_unit != "" ) 
585           newob->set("unit", fabao_unit); 
586        id_list = ({ fabao_id }); 
587        t_list = explode( fabao_id, "_"); 
588        if( sizeof(t_list) > 1 )   { 
589          id_list += t_list; 
590        } 
591        newob->set_name( fabao_name, id_list );  
592      
593        // set owner of fabao 
594        newob->set("owner_id", getuid(ob)); 
595        if( !ob->query("fabao/armor1") ) 
596          newob->set("series_no", "2"); 
597        else if( !ob->query("fabao/armor2") ) 
598          newob->set("series_no", "3"); 
599        newob->set("default_file", ob_file); 
600      
601         newob->save();    
602      
603        //ob->add("max_force", -50); 
604        //ob->add("max_mana", -50); 
605        ob->add("force", -200); 
606        ob->add("mana", -200); 
607        ob->add("balance", -500000); 
608         
609        if( !ob->query("fabao/armor1") ) 
610          ob->set("fabao/armor1",  newob->query("series_no")); 
611        else if( !ob->query("fabao/armor2") ) 
612          ob->set("fabao/armor2",  newob->query("series_no")); 
613         
614        newob->setup(); 
615        if( !newob->move(ob) ) 
616           newob->move(environment(ob)); 
617        ob->save(); 
618      
619        write("法宝炼制成功。\n"); 
620         
621        return; 
622     } 
623      
624     int  do_dispose(string arg) 
625     { 
626        object ob = this_player(); 
627        object fabao_ob; 
628        
629        if( !arg || arg == "" ) 
630          return notify_fail("你要消除什么法宝？\n"); 
631      
632        if( !objectp(fabao_ob=present(arg, ob)) ) 
633           return notify_fail("你身上没有这样东西啊。\n"); 
634            
635        if(!fabao_ob->query("owner_id") || !fabao_ob->query("series_no"))  
636           return notify_fail("那个不是法宝耶！\n"); 
637            
638        write("你确定要毁灭该法宝吗？(y/n)"); 
639        input_to( (: confirm_dispose :), ob, fabao_ob);  
640        return 1; 
641     } 
642      
643     void confirm_dispose(string arg, object ob, object fabao_ob) 
644     { 
645        mapping  fabao_list; 
646        string*  names; 
647        int      i; 
648      
649        if( arg == "y" || arg == "Y" )  { 
650          fabao_list = ob->query("fabao"); 
651          if( !mapp(fabao_list) )     return; 
652          names = keys(fabao_list); 
653          for(i=0; i<sizeof(names); i++)  { 
654           if( fabao_list[names[i]] == fabao_ob->query("series_no") )  { 
655             //seteuid(getuid(ob)); 
656             //rm( fabao_ob->query_save_file() + __SAVE_EXTENSION__ ); 
657             ob->delete("fabao/"+names[i]); 
658             destruct( fabao_ob ); 
659             write("法宝被毁弃了。\n"); 
660             break; 
661           } 
662          } 
663        } 
664      
665        return; 
666     } 
