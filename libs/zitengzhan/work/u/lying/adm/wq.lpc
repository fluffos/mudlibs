1       // wimpy.c 
2       //By qqzqq 1/3/2001 
3       #include <ansi.h> 
4       inherit F_CLEAN_UP; 
5        
6       int help(object me); 
7        
8       int main(object me, string arg) 
9       { 
10              object ob; 
11                string fabao_id; 
12              string *id_list, *t_list;        
13                if (!me->query("fabao/weapon")) 
14                   return notify_fail("你还没有自制兵器,瞎喊什么。\n"); 
15      //          if (environment(me)->query("short")=="擂台") 
16      //             return notify_fail("擂台上怎么能叫宠物帮忙。\n"); 
17      //    if( uptime()-me->query_temp("recall_time")<100) 
18      //           return notify_fail(HIR"BEEP～～！"HIW"宠物公司：你的宠物跑的可没这么快！！\n"HIW); 
19              ob = new("/obj/fabao"); 
20              fabao_id = (string)ob->query("id"); 
21              ob->set("id", fabao_id); 
22                id_list = ({ fabao_id }); 
23                t_list = explode( fabao_id, " "); 
24              if( sizeof(t_list) > 1 )   { 
25                      id_list += t_list; 
26              } 
27                 if( !ob ) ob=find_object(fabao_id); 
28               if( !ob ) ob = LOGIN_D->find_body(fabao_id); 
29              if( !ob ) { 
30                        ob=new("/obj/fabao"); 
31                         ob->set("owner_id",geteuid(me)); 
32                      if (!ob->restore()) 
33                       { 
34                        destruct(ob); 
35                          return notify_fail("你的武器出了问题，请和巫师联系!"); 
36                      } 
37                      ob->set_name(ob->query("name"),id_list); 
38                      ob->setup(); 
39                 } //else if (ob->query("owner_id") != me->query("id")) 
40      //                      return notify_fail("好象你的武器不肯听你的话了，你还是自已去找找吧！\n");:c 
41              ob->move(environment(me)); 
42              message_vision("$N一个唿哨，$n兴奋地从远处向$N奔来。\n",me,ob); 
43              me->set_temp("huhuan_time",uptime()); 
44              return 1; 
45      } 
46       
