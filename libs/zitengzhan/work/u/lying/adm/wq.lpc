916                       write("    道行三千五百年以上\n"); 
917                       write("    法力四千以上\n"); 
918                       write("    消耗最大法力一千两百点\n"); 
919                       break; 
920              case 6:  write("你的法宝"+HIW+"魔法抵抗力"+NOR+"已经不能再升级了。\n"); 
921           } 
922        } 
923         
924        return 1; 
