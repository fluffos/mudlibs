5         
6       void create() 
7       { 
8               set_name(HIR "龙胆" NOR, ({"long dan", "dan", "long"})); 
9               if (clonep()) 
10                      set_default_object(__FILE__); 
11              else { 
12                      set("unit", "只"); 
13                      set("long", HIR "\n一只血淋淋的新鲜龙胆，从神兽青龙的身体里取出，可以入药。\n" NOR); 
14                      set("value", 8000); 
15              } 
