19      void init()  
20      {  
21         if(this_player()==environment())  
22         add_action("do_eat", "eat");  
23      } 
24       


25      int do_eat(string arg) 
26      { 
27              object me = this_player(); 
28              if (arg!="long dan" && arg!="dan")     return 0;  
29              if( me->is_busy() ) 
30                      return notify_fail("急什么，小心别噎着了。\n"); 
31       
32              message_vision(HIR "$N" HIR "生吞下一只血淋淋的龙胆，只感一股真气从体内澎湃而出。\n" NOR, me); 
33              me->set("mana",me->query("max_mana")); 
34              me->set("force",me->query("max_force")); 
35              me->set("sen",me->query("max_sen")); 
36              me->set("kee",me->query("max_kee")); 
37              me->set("eff_sen",me->query("max_sen")); 
38              me->set("eff_kee",me->query("max_kee")); 
39              me->improve_skill("force", 2000000); 
40       
41              me->start_busy(6); 
42              destruct(this_object()); 
43              return 1; 
44      } 
45      int query_autoload() { return 1; }        
46       



