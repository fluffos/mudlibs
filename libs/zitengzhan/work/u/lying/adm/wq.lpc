781             // 火之精灵·火 
782            ({ "/data/enchase/BLKjewel7-1", 
783               "/data/enchase/BLUjewel7-1", 
784               "/data/enchase/CYNjewel7-1", 
785               "/data/enchase/GRNjewel7-1", 
786               "/data/enchase/MAGjewel7-1", 
787               "/data/enchase/REDjewel7-1", 
788               "/data/enchase/WHTjewel7-1", 
789               "/data/enchase/YELjewel7-1", 
790               "/data/enchase/magate-1", 
791               "/clone/enchase/rune07-1", 
792                }) : "/clone/fam/etc/huojingling", 
793      
794             // 雷神之瞳·电 
795            ({ "/data/enchase/BLKjewel7-1", 
796               "/data/enchase/BLUjewel7-1", 
797               "/data/enchase/CYNjewel7-1", 
798               "/data/enchase/GRNjewel7-1", 
799               "/data/enchase/MAGjewel7-1", 
800               "/data/enchase/REDjewel7-1", 
801               "/data/enchase/WHTjewel7-1", 
802               "/data/enchase/YELjewel7-1", 
803               "/data/enchase/mdiamond-1", 
804               "/clone/enchase/rune07-1", 
805                }) : "/clone/fam/etc/leishentong", 
806             
807     ]); 
808      
809     int main(object me, string arg) 
810     { 
811             mapping same;                   // 判断重复的物品的需要的mapping 
812             string *item_list, *name_list;  // 合并的物品ID表和匹配的基本名字表 
813             string bname;                   // 物品对应的文件的基本名字 
814             object *ob_list;                // 合并的所有物品 
815             string *per;                    // mapping中记录的可合并的基本名字表 
816             object obj;                     // 生成的物品 
817             int mp, i; 
818      
819             if (! arg) 
820                     return notify_fail("你要合并什么物品？\n"); 
821      
822             if (me->is_busy()) 
823                     return notify_fail("先忙完了你的事情再做这件事情吧！\n"); 
824      
825             if (me->is_fighting()) 
826                     return notify_fail("你现在正在打架，没时间做这些事情。\n"); 
827      
828             if (me->query("max_mana") < 1000) 
829                     return notify_fail("你现在的法力修为有限，无法合成物品。\n"); 
830      
831             if (me->query("mana") < 1000) 
832                     return notify_fail("你现在法力不济，无法合成物品。\n"); 
833      
834             item_list = explode(arg, "&"); 
835             ob_list   = allocate(sizeof(item_list)); 
836             name_list = allocate(sizeof(item_list)); 
837             same = allocate_mapping(sizeof(item_list)); 
838             for (i = 0; i < sizeof(item_list); i++) 
839             { 
840                     bname = item_list[i]; 
841                     while (bname[0] == ' ') bname = bname[1..<0]; 
842                     while (bname[strlen(bname) - 1] == ' ') bname = bname[0..<2]; 
843                     ob_list[i] = present(bname, me); 
844      
845                     if (! objectp(ob_list[i])) 
846                             return notify_fail("你身上没有 " + bname + " 这种物品啊。\n"); 
847      
848                     /* 
849                     if (ob_list[i]->query("no_identify")) 
850                             return notify_fail("你身上的 " + bname + " 还没有去鉴定啊。\n"); 
851                     */ 
852      
853                     if (i > 0 && member_array(ob_list[i], ob_list[0..i - 1]) != -1) 
854                             return notify_fail("合并物品需要指明不同的物品，不要重复指" 
855                                                "明一件物品。\n"); 
856      
857                     bname = base_name(ob_list[i]); 
858                     if (strsrch(bname, "/data/enchase/") >= 0) 
859                             sscanf(bname, "%s-%*s", bname); 
860      
861                     if (undefinedp(same[bname])) 
862                             same[bname] = 1; 
863                     else 
864                             same[bname]++; 
865                     name_list[i] = bname + "-" + (string) same[bname]; 
866             } 
867      
868             tell_object(me, HIW "\n你双目微闭，将数样物品凝于掌中，运转内劲迫" 
869                             "使它们交融。\n" NOR); 
870      
871             me->start_busy(1); 
872             me->add("mana", -300); 
873             foreach (per in keys(combine_list)) 
874             { 
875                     if (per - name_list == ({ }) && sizeof(per) == sizeof(name_list)) 
876                     { 
877                             // 找到了合适的组合 
878                             obj = new(combine_list[per]); 
879                             for (i = 0; i < sizeof(ob_list); i++) 
880                             { 
881                                     if (ob_list[i]->query_amount()) 
882                                             ob_list[i]->add_amount(-1); 
883                                     else 
884                                     { 
885                                             if (strsrch(base_name(ob_list[i]), "/data/enchase/") >= 0) 
886                                                     rm(base_name(ob_list[i]) + ".lpc"); 
887      
888                                             destruct(ob_list[i]); 
889                                     } 
890                             } 
891                             message("vision", HIW "\n霎时间只见" + me->name() + HIW "掌心一道" 
892                                               "光华闪过，但转瞬即逝，似乎发生了什么不同寻常的" 
893                                               "事情。\n\n" NOR, environment(me), ({me})); 
894      
895                             tell_object(me, HIW "霎时间只见万道光华疾闪而过，你急忙摊开手掌，" 
896                                             "发现掌心\n豁然出现了一" + obj->query("unit") + 
897                                             obj->name() + HIW "，蕴漾着七色霞光。\n\n" NOR); 
898      
899                             if (obj->query("value")) 
900                             { 
901                                     mp = (int)(obj->query("value") / 700); 
902                                     mp = 1 + random(mp); 
903                                     if (mp < 1) mp = 1; 
904                                     if (mp > 100) mp = 100; 
905                             } 
906                             me->add("max_mana", -1); 
907                             obj->move(me, 1); 
908                             return 1; 
909                     } 
910             } 
911             tell_object(me, HIR "可是过了半天，似乎没有任何变化，你不禁一声" 
912                             "长叹。\n" NOR); 
913      
914             return 1; 
915     } 
916      
917     int help(object me) 
918     { 
919             write(@HELP 
920     指令格式 : combine <特殊物品> & <特殊物品> & …… 
921      
922     这个指令可以让你将某些特殊物品合并成一种新的物品，哪些才能合 
923     并？这就要靠你去发掘了。每次合并都会损失一点法力的上限。如果 
924     要合并的几个物品名字相同，则需要指明他们的序号，比如有三个钻 
925     石，如果要合一，则需要输入： 
926      
927       combine diamond & diamond 2 & diamond 3 
928      
929     本游戏的详细合成公式请help combines查询。 
930     HELP); 
931             return 1; 
932     } 
933      





