756              write("★"); 
757           for(i=dodge_stars; i<6; i++) 
758              write("　"); 
759           write("    " + HIB+"抵抗力        "+HIR); 
760           for(i=0; i<armor_stars; i++) 
761              write("★"); 
762           write("\n");  
763           write("    " + HIM+"内功抵抗力    "+HIR); 
764           for(i=0; i<force_stars; i++) 
765              write("★"); 
766           for(i=force_stars; i<6; i++) 
767              write("　"); 
768           write("    " + HIC+"魔法攻击力    "+HIR); 
769           for(i=0; i<spells_stars; i++) 
770           write("★"); 
771           write("\n");  
772           write("    " + HIW+"魔法抵抗力    "+HIR); 
773           for(i=0; i<vs_spells_stars; i++) 
774              write("★"); 
775           write(NOR+"\n");  
776            
