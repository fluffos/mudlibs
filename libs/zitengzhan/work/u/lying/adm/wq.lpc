814                       write("    道行一千年以上\n"); 
815                       write("    内力一千五以上\n"); 
816                       write("    消耗最大内力一百五十点\n"); 
817                       write("    消耗道行二十年\n"); 
818                       break; 
819              case 4:  write(HIB+"抵抗力" + NOR+ "(armor)升级需要：\n"); 
820                       write("    道行一千五百年以上\n"); 
821                       write("    内力两千以上\n"); 
822                       write("    消耗最大内力两百点\n"); 
823                       write("    消耗道行五十年\n"); 
824                       break; 
825              case 5:  write(HIB+"抵抗力" + NOR+ "(armor)升级需要：\n"); 
826                       write("    道行三千五百年以上\n"); 
827                       write("    内力四千以上\n"); 
