690     int do_cost(string arg) 
691     { 
692        object fabao_ob, me=this_player(); 
693        int i, damage_stars, dodge_stars, armor_stars, force_stars; 
694        int spells_stars, vs_spells_stars; 
695         
696        if( !arg || arg == "" )  { 
697           write("制造法宝需要五十两黄金，两百点真气和魔力，\n"); 
698           write("并且道行必须在二十年以上，最大内力法力都必\n"); 
699           write("须在 300以上。例如你的内力是 1500/1200，那\n"); 
700           write("高出来的300就是真气，魔力类似。\n"); 
701           return 1; 
702        } 
703        
704        if( !objectp(fabao_ob=present(arg, me)) ) 
705           return notify_fail("你身上没有这样东西啊。\n"); 
706            
707        if(!fabao_ob->query("owner_id") || !fabao_ob->query("series_no"))  
708           return notify_fail("那个不是法宝耶！\n"); 
709            
710        if( fabao_ob->query("series_no") == "1" )  { 
711           write("法宝等级：    " + HIR); 
712           damage_stars = fabao_ob->query("stars/damage"); 
713           for(i=0; i<damage_stars; i++) 
714              write("★"); 
715           write(NOR + "\n"); 
716           write(HIG+"伤害力" + NOR+ "(damage)升级需要：\n"); 
717           switch(damage_stars)  { 
718              case 1:  write("    道行一百年以上\n"); 
719                       write("    内力五百以上\n"); 
720                       write("    消耗最大内力五十点\n"); 

721                       write("    消耗道行一年\n"); 
722                       break; 
723              case 2:  write("    道行五百年以上\n"); 
724                       write("    内力一千以上\n"); 
725                       write("    消耗最大内力一百点\n"); 
726                       write("    消耗道行十年\n"); 
727                       break; 
728              case 3:  write("    道行一千年以上\n"); 
729                       write("    内力一千五以上\n"); 
730                       write("    消耗最大内力一百五十点\n"); 
731                       write("    消耗道行二十年\n"); 
732                       break; 
733              case 4:  write("    道行一千五百年以上\n"); 
734                       write("    内力两千以上\n"); 
735                       write("    消耗最大内力两百点\n"); 
736                       write("    消耗道行五十年\n"); 
737                       break; 
738              case 5:  write("    道行三千五百年以上\n"); 
739                       write("    内力四千以上\n"); 
740                       write("    消耗最大内力五百点\n"); 
741                       write("    消耗道行五百年\n"); 
742                       break; 
743              case 6:  write("你的法宝"+HIG+"伤害力"+NOR+"已经不能再升级了。\n"); 
744           } 
745        } 
746        else if( fabao_ob->query("series_no") == "2"  || 
747        fabao_ob->query("series_no") == "3" )  { 
748           dodge_stars = fabao_ob->query("stars/dodge"); 
749           armor_stars = fabao_ob->query("stars/armor"); 
750           force_stars = fabao_ob->query("stars/armor_vs_force"); 
751           spells_stars = fabao_ob->query("stars/spells"); 
752           vs_spells_stars = fabao_ob->query("stars/armor_vs_spells"); 
753           write("法宝等级：\n"); 
754           write("    " + HIY+"防御力        "+HIR); 
