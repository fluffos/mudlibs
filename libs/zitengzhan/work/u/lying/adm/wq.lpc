28      void build_weapon(object ob); 
29      void build_armor(object ob); 
30      int check_legal_name(string name, int max_len); 
31      int check_legal_id(string name); 
32      void confirm_dispose(string arg, object ob, object fabao_ob); 
33       
34      void init() 
35      { 
36          add_action("do_sm", "make_fabao"); 
37          add_action("do_dispose", "dispose"); 
38          add_action("do_list", "list"); 
39          add_action("do_cost", "cost"); 
40          add_action("do_upgrade", "upgrade"); 
41          add_action("do_change_name", "change_name"); 
42          add_action("do_change_id", "change_id"); 
43          add_action("do_change_desc", "change_desc"); 
44          add_action("do_change_wdesc", "change_wdesc"); 
45          add_action("do_change_udesc", "change_udesc"); 
46          add_action("do_change_unit", "change_unit"); 
47       
48          seteuid(getuid()); 
49      } 
50       
51      void create () 
52      { 
53              set ("short", "女娲补天处"); 
54              set ("long", @LONG 
55       
56      这里是一片开阔地。地上铺满了一堆又一堆奇形怪状色彩斑斓的 
57      残岩碎石，在雪色映照下溢彩流光。边上一块大石上刻着几行大 
58      字： 
59       
60           昆仑绝处 
61           女娲补天 
62           彩石未尽 
63           遗福後人 
64       
65      底下还密密麻麻地刻了一篇小字(words)，隔远了也看不清说的是 
66      什么。 
67      LONG); 
68       
69              set("item_desc", ([ "words" :  
70                   "make_fabao     炼制法宝\n" + 
71                   "dispose        注消法宝\n" + 
72                   "list           列举可制法宝种类\n" + 
73                   "upgrade        法宝升级\n" + 
74                   "cost 法宝      法宝炼制及升级可能费用\n" + 
75                   "change_name    给法宝改名\n" + 
76                   "change_id      给法宝改代号\n" + 
77                   "change_desc    给法宝改描述\n" + 
78                   "change_unit    给法宝改单位名称\n\n" + 
79                   HIY+"升级暂行办法：\n"+NOR+ 
80                   "　　每五次升级加一个星，最高为六星。\n"+ 
81                   "　　代价以加一星为计算标准。比如升两星要\n" +  
82                   "　　100 年道行，升三星要 500年，那么升两\n" + 
83                   "　　星后，每次升级就需要 80 年道行。\n", ])); 
84       
85              set("exits",  
86              ([ //sizeof() == 2 
87                    "west" : "/u/fotuo/moon/3zfabao-room", 
88                      "east" : __DIR__"fabao-road2", 
89              ])); 
90       
91       
92         set("no_fight", 1); 
93         set("no_magic", 1); 
94       
95       
96          setup(); 
97      } 
98       
99      int do_sm() 
100     { 
101         object me = this_player(); 
102        int  fabao_num; 
103         
104        if( me->query("balance") < 500000 ) 
105           return notify_fail("做法宝费用太高，还是先去发财吧。\n"); 
106            
107        if( me->query("combat_exp") < 20000) 
108          return notify_fail("你的道行不够，不能自造法宝。\n"); 
109         
110        if( me->query("max_force") < 300 ) 
111          return notify_fail("你的内力不够，不能自造法宝。\n"); 
112           
113        if( me->query("max_mana") < 300) 
114          return notify_fail("你的法力不够，不能自造法宝。\n"); 
115         
116        if( me->query("force") < (me->query("max_force")+100) ) 
117          return notify_fail("你的真气不足，不能自造法宝。\n"); 
118         
119        if( me->query("mana") < (me->query("max_mana")+100) ) 
120          return notify_fail("你的目前法力不足，不能自造法宝。\n"); 
121         
122     //   if( me->query("kee") != me->query("max_kee") || 
123     //       me->query("sen") != me->query("max_sen") )  
124     //     return notify_fail("你的精气不足，不能自造法宝。\n"); 
125      
126         fabao_num = 0;      
127        if( me->query("fabao/weapon") )     fabao_num++; 
128        if( me->query("fabao/armor1") )     fabao_num++; 
129        if( me->query("fabao/armor2") )     fabao_num++; 
130         
131        if( fabao_num >= MAX_FABAO ) 
132          return notify_fail("你不能再炼制法宝了，请用 dispose 注消不要的法宝。\n"); 
133           
134        write("您要造哪类法宝：\n"); 
135        if( !me->query("fabao/weapon") ) 
136          write("w. 武器\n"); 
137        if( !me->query("fabao/armor1") || !me->query("fabao/armor2") ) 
138          write("a. 防具\n"); 
139        write("o. 其他(暂缺)\n"); 
140      
141        seteuid(getuid()); 
142        // Other kinds of fabao can be added too.. if there is somefile 
143        // we can use as a default object. 
144        write("请选择：(q 键取消)"); 
145        input_to( (: get_type :), me ); 
146         
147        return 1;    
148     } 
149      
150     void get_type(string arg, object ob) 
151     { 
152        if( arg == "q" || arg == "Q" ) 
153           return; 
154      
155        if( (arg != "w" || ob->query("fabao/weapon")) 
156          && (arg != "a" || ( ob->query("fabao/armor1") 
157          && ob->query("fabao/armor2") )) )   { 
158          write("您要造哪类法宝：\n"); 
159          if( !ob->query("fabao/weapon") ) 
160             write("w. 武器\n"); 
161          if( !ob->query("fabao/armor1") || !ob->query("fabao/armor2") ) 
162             write("a. 防具\n"); 
163            write("o. 其他(暂缺)\n"); 
164            write("请选择：(q 键取消)"); 
165          input_to( (: get_type :), ob ); 
166          return; 
167        } 
168      
169        if( arg == "w" )    { 
170          ob->set_temp("fabao_type", "weapon"); 
171          write("\n"); 
172          write("可选择武器种类：\n"); 
173          write("1. 斧  2. 刀  3. 叉  4. 锤  5. 锏  6. 枪\n"); 
174          write("7. 杖  8. 棒  9. 剑  10. 鞭  11. 拳套\n"); 
175            write("请选择：(q 键取消)"); 
176        } 
177        else if( arg == "a" )   { 
178          ob->set_temp("fabao_type", "armor"); 
179          write("\n"); 
180          write("可选择防具种类：\n"); 
181          write("1. 甲  2. 鞋  3. 衣服  4. 指套  5. 护掌  6. 头罩\n"); 
182          write("7. 脖套  8. 盾  9. 披风  10. 护腕  11. 腰带\n"); 
183            write("请选择：(q 键取消)"); 
184        } 
185        input_to( (: get_subtype :), ob); 
186     } 
187      
188     void get_subtype(string arg, object ob) 
189     { 
190         int  order; 
191        string fabao_type = ob->query_temp("fabao_type"); 
192         
193        if( arg == "q" || arg == "Q" )    return; 
194      
195         sscanf(arg, "%d", order); 
196          
197        if( (fabao_type == "weapon" && order <= 0 && order > 10) || 
198          (fabao_type == "armor" && order <= 0 && order > 11) )  { 
199          if( arg == "w" )    { 
200             fabao_type = "weapon"; 
201             write("\n"); 
202             write("可选择武器种类：\n"); 
203             write("1. 斧  2. 刀  3. 叉  4. 锤  5. 锏  6. 枪\n"); 
204             write("7. 杖  8. 棒  9. 剑  10. 鞭\n"); 
205                write("请选择：(q 键取消)"); 
206          } 
207          else if( arg == "a" )   { 
208             fabao_type = "armor";    
209             write("\n"); 
210             write("可选择防具种类：\n"); 
211             write("1. 甲  2. 鞋  3. 衣服  4. 指套  5. 护掌  6. 头罩\n"); 
212             write("7. 脖套  8. 盾  9. 披风  10. 护腕  11. 腰带\n"); 
213                write("请选择：(q 键取消)"); 
214          } 
215          ob->set_temp("fabao_type", fabao_type); 
216          input_to( (: get_subtype :), ob); 
217          return; 
218        } 
219         
220        ob->set_temp("fabao_subtype",  order); 
221      
222        write("\n"); 
223        write("请设定英文 id ："); 
224        input_to( (: get_id :), ob );  
225     } 
226      
227      
228     int check_legal_id(string id) 
229     { 
230        int i; 
231        string   *legalid; 
232         
233        i = strlen(id); 
234         if( (strlen(id) < 3) || (strlen(id) > 20 ) ) { 
235          write("对不起，英文 id 必须是 3 到 20 个英文字母。\n"); 
236          return 0; 
237         } 
238         while(i--) 
239            if( id[i] != ' ' && (id[i]<'a' || id[i]>'z') )  { 
240              write("对不起，英文 id 只能用英文字母。\n"); 
241              return 0; 
242            } 
243          
244         legalid = explode(read_file(BANNED_ID), "\n"); 
245         for(i=0; i<sizeof(legalid); i++)   { 
246            if( id == legalid[i] )   { 
247              write("对不起，这种 id 会造成其他人的困扰。\n"); 
248              return 0; 
249            } 
250         } 
251          
252         return 1; 
253     } 
254      
255      
256     int check_legal_name(string name, int max_len) 
257     { 
258        int i; 
259        string   *legalname;     //not implemented..may add later 
260         
261        i = strlen(name); 
262         if( (strlen(name) < 2) || (strlen(name) > max_len ) ) { 
263            write( sprintf("对不起，法宝中文字必须是 1 到 %d 个中文字。\n", 
264             max_len/2) ); 
265          return 0; 
266         } 
267         while(i--)   { 
268            if( name[i]<=' ' )   { 
269              write("对不起，法宝中文字不能用控制字元。\n"); 
270              return 0; 
271            } 
272            if( i%2==0 && !is_chinese(name[i..<0]) )  { 
273              write("对不起，请您用「中文」给法宝取名字。\n"); 
274              return 0; 
275            } 
276         } 
277         
278         return 1;  
279     } 
280      
281     void get_id(string arg, object ob) 
282     { 
283        arg = lower_case(arg); 
284        if( !check_legal_id(arg) )   { 
285          write("请设定英文 id ："); 
286          input_to( (: get_id :), ob );  
287          return; 
288        } 
289      
290        arg = replace_string(arg, " ", "_");    
291        ob->set_temp("fabao_id",arg); 
292         
293        write("\n"); 
294        write("请设定中文名：(可加颜色)"); 
295        input_to( (: get_name :), ob); 
296     } 
297      
298     void get_name(string arg, object ob) 
299     { 
300        string  arg_old; 
301         
302        arg += "$NOR$"; 
303        arg_old = arg; 
304             arg = replace_string(arg, "$BLK$", ""); 
305             arg = replace_string(arg, "$RED$", ""); 
306             arg = replace_string(arg, "$GRN$", ""); 
307             arg = replace_string(arg, "$YEL$", ""); 
308             arg = replace_string(arg, "$BLU$", ""); 
309             arg = replace_string(arg, "$MAG$", ""); 
310             arg = replace_string(arg, "$CYN$", ""); 
311             arg = replace_string(arg, "$WHT$", ""); 
312             arg = replace_string(arg, "$HIR$", ""); 
313             arg = replace_string(arg, "$HIG$", ""); 
314             arg = replace_string(arg, "$HIY$", ""); 
315             arg = replace_string(arg, "$HIB$", ""); 
316             arg = replace_string(arg, "$HIM$", ""); 
317             arg = replace_string(arg, "$HIC$", ""); 
318             arg = replace_string(arg, "$HIW$", ""); 
319             arg = replace_string(arg, "$NOR$", ""); 
320      
321        if( !check_legal_name(arg, 12) )  { 
322             write("请设定中文名：(可加颜色)"); 
323          input_to( (: get_name :), ob); 
324          return; 
325        } 
326      
327        arg = arg_old; 
328      
329             arg = replace_string(arg, "$BLK$", BLK); 
330             arg = replace_string(arg, "$RED$", RED); 
331             arg = replace_string(arg, "$GRN$", GRN); 
332             arg = replace_string(arg, "$YEL$", YEL); 
333             arg = replace_string(arg, "$BLU$", BLU); 
334             arg = replace_string(arg, "$MAG$", MAG); 
335             arg = replace_string(arg, "$CYN$", CYN); 
336             arg = replace_string(arg, "$WHT$", WHT); 
337             arg = replace_string(arg, "$HIR$", HIR); 
338             arg = replace_string(arg, "$HIG$", HIG); 
339             arg = replace_string(arg, "$HIY$", HIY); 
340             arg = replace_string(arg, "$HIB$", HIB); 
341             arg = replace_string(arg, "$HIM$", HIM); 
342             arg = replace_string(arg, "$HIC$", HIC); 
343             arg = replace_string(arg, "$HIW$", HIW); 
344             arg = replace_string(arg, "$NOR$", NOR); 
345         
346        ob->set_temp("fabao_name", arg + NOR); 
347         
348        write("\n"); 
349        write("请描述法宝："); 
350        input_to( (: get_desc :), ob); 
351     } 
352      
353     void get_desc(string arg, object ob) 
354     { 
355        if( !check_legal_name(arg, 60) )  { 
356          write("请描述法宝："); 
357          input_to( (: get_desc :), ob); 
358          return; 
359        } 
360      
361        ob->set_temp("fabao_desc",  arg); 
362         
363        write("\n"); 
364        write("法宝用量词：(Return for default)"); 
365        input_to( (: get_unit :), ob); 
366     } 
367      
368      
369     void get_unit(string arg, object ob) 
370     { 
371        string fabao_unit, fabao_type; 
372      
373         if( arg == "" ) 
374            fabao_unit = ""; 
375        else if( !check_legal_name(arg, 2) )  { 
376            write("法宝用量词：(Return for defult)"); 
377           input_to( (: get_unit :), ob); 
378           return; 
379         } 
380         else 
381            fabao_unit = arg;  
382         
383        fabao_type = ob->query_temp("fabao_type"); 
384        ob->set_temp("fabao_unit", fabao_unit); 
385        if( fabao_type == "weapon" ) 
386          build_weapon(ob);    
387        else if( fabao_type == "armor" ) 
388          build_armor(ob);    
389        // may have more later 
390     } 
391      
392     void build_weapon(object ob) 
393     { 
394        object newob; 
395        string weapon_dir, ob_file; 
396        string *id_list, *t_list; 
397        int rev; 
398        int    fabao_subtype = ob->query_temp("fabao_subtype"); 
399        string fabao_id = ob->query_temp("fabao_id"); 
400        string fabao_name = ob->query_temp("fabao_name"); 
401        string fabao_desc = ob->query_temp("fabao_desc"); 
402        string fabao_unit = ob->query_temp("fabao_unit"); 
403         
404        newob = new("/obj/fabao"); 
405        if(!newob) 
406          return; 
407           
408        seteuid(fabao_id); 
409        rev = export_uid(newob); 
410        seteuid(getuid()); 
411      
412        newob->set("value", 1); 
413        newob->set("no_get", 1);    
414        newob->set("no_give", 1);    
415        newob->set("no_sell", 1);    
416        newob->set("no_drop", 1);    
417        newob->set("no_put", 1);    
418         
419        weapon_dir = "/d/obj/weapon/"; 
420        newob->set("weapon_prop/damage", 10); 
421        newob->set("flag", TWO_HANDED); 
422        newob->set("weight", 1000); 
423        switch( fabao_subtype )   { 
424          case 1: 
425             ob_file = weapon_dir + "axe/huafu"; 
426             break; 
427          case 2: 
428             ob_file = weapon_dir + "blade/blade"; 
429             break; 
430          case 3: 
431             ob_file = weapon_dir + "fork/gangcha"; 
432             break; 
433          case 4: 
434             ob_file = weapon_dir + "hammer/hammer"; 
435             break; 
436          case 5: 
437             ob_file = weapon_dir + "mace/ironmace"; 
438             break; 
439          case 6: 
440             ob_file = weapon_dir + "spear/gangqiang"; 
441             break; 
442          case 7: 
443             ob_file = weapon_dir + "staff/muzhang"; 
444             break; 
445          case 8: 
446             ob_file = weapon_dir + "stick/qimeigun"; 
447             break; 
448          case 9: 
449             ob_file = weapon_dir + "sword/changjian"; 
450             break; 
451          case 10: 
452             ob_file = weapon_dir + "whip/pibian"; 
453             break; 
454          case 11: 
455             ob_file = weapon_dir + "unarmed/unarmed"; 
456             break; 
457        } 
458      
459        newob->set_default_object( ob_file ); 
460         
461        newob->set("long", fabao_desc); 
462        newob->set("stars/damage", 1); 
463        newob->set("upgraded/damage", 0); 
464        if( fabao_unit != "" ) 
465           newob->set("unit", fabao_unit); 
466        id_list = ({ fabao_id }); 
467        t_list = explode( fabao_id, "_"); 
468        if( sizeof(t_list) > 1 )   { 
469          id_list += t_list; 
470        } 
471        newob->set_name( fabao_name, id_list );  
472      
473        // set owner of fabao 
474        newob->set("owner_id", getuid(ob)); 
475        newob->set("series_no", "1"); 
476        newob->set("default_file", ob_file); 
477      
478      
479         newob->save();    
480      
481        //ob->add("max_force", -50); 
482        //ob->add("max_mana", -50); 
483        ob->add("force", -200); 
484        ob->add("mana", -200); 
485        ob->add("balance", -500000); 
486      
487        ob->set("fabao/weapon",  newob->query("series_no")); 
488      
489        newob->setup(); 
490        if( !newob->move(ob) ) 
491           newob->move(environment(ob)); 
492        ob->save(); 
493         
494        write("法宝炼制成功。\n"); 
495      
496        return; 
497     } 
498      
