926      
927     int  do_upgrade(string arg) 
928     { 
929        string name, property; 
930        object fabao_ob, me=this_player(); 
931        int   stars, upgraded; 
932        
933        if( !arg || arg == "")   { 
934           write("请用 upgrade 法宝名 for 升级特性 来升级。\n"); 
935           write("升级特性可用 cost 法宝名 来查看。\n"); 
936           return 1; 
937        } 
938            
939        if( sscanf(arg, "%s for %s", name, property) != 2)  { 
940           write("请用 upgrade 法宝名 for 升级特性 来升级。\n"); 
941           write("升级特性可用 cost 法宝名 来查看。\n"); 
942           return 1; 
943        } 
944         
945        if( !objectp(fabao_ob=present(name, me)) ) 
946           return notify_fail("你身上没有这样东西啊。\n"); 
947            
948        if(!fabao_ob->query("owner_id") || !fabao_ob->query("series_no"))  
949           return notify_fail("那个不是法宝耶！\n"); 
950           
951           if( fabao_ob->query("owner_id") != getuid(me) ) 
952           return notify_fail("这个好象不是你的法宝吧!\n"); 
953        if( fabao_ob->query("equipped") ) 
954           return notify_fail("你必须放下法宝才能升级。\n"); 
955                
956        if( fabao_ob->query("series_no") == "1")  {   // weapon 
957           if( property != "damage" ) 
958              return notify_fail("法宝没有这个升级特性。\n"); 
959            
960           stars = fabao_ob->query("stars/"+property); 
961           upgraded = fabao_ob->query("upgraded/"+property) + 1; 
962           switch(stars)   { 
963              case 1:  if( me->query("combat_exp") < (20000+upgraded*16000) || 
964                       me->query("max_force") < 500 ) 
965                          return notify_fail("不够升级条件，请用 cost 查询。\n"); 
966                       fabao_ob->add("weapon_prop/damage", 4); 
967                       fabao_ob->add("upgraded/"+property, 1); 
968                       if( upgraded == 5 )  { 
969                          fabao_ob->add("stars/"+property, 1); 
970                          fabao_ob->set("upgraded/"+property, 0); 
971                       } 
972                       me->add("max_force", -10); 
973                       me->add("combat_exp", -200); 
974                       break; 
975              case 2:  if( me->query("combat_exp") < (100000+upgraded*80000) || 
976                       me->query("max_force") < 1000 ) 
977                          return notify_fail("不够升级条件，请用 cost 查询。\n"); 
978                       fabao_ob->add("weapon_prop/damage", 6); 
979                       fabao_ob->add("upgraded/"+property, 1); 
980                       if( upgraded == 5 )  { 
981                          fabao_ob->add("stars/"+property, 1); 
982                          fabao_ob->set("upgraded/"+property, 0); 
983                       } 
984                       me->add("max_force", -20); 
985                       me->add("combat_exp", -2000); 
986                       break; 
987              case 3:  if( me->query("combat_exp") < (500000+upgraded*100000) || 
988                       me->query("max_force") < 1500 ) 
989                          return notify_fail("不够升级条件，请用 cost 查询。\n"); 
990                       fabao_ob->add("weapon_prop/damage", 6); 
991                       fabao_ob->add("upgraded/"+property, 1); 
992                       if( upgraded == 5 )  { 
993                          fabao_ob->add("stars/"+property, 1); 
994                          fabao_ob->set("upgraded/"+property, 0); 
995                       } 
996                       me->add("max_force", -30); 
997                       me->add("combat_exp", -4000); 
998                       break; 
999              case 4:  if( me->query("combat_exp") < (1000000+upgraded*100000) || 
1000                      me->query("max_force") < 2000 ) 
1001                         return notify_fail("不够升级条件，请用 cost 查询。\n"); 
1002                      fabao_ob->add("weapon_prop/damage", 6); 
1003                      fabao_ob->add("upgraded/"+property, 1); 
1004                      if( upgraded == 5 )  { 
1005                         fabao_ob->add("stars/"+property, 1); 
1006                         fabao_ob->set("upgraded/"+property, 0); 
1007                      } 
1008                      me->add("max_force", -40); 
1009                      me->add("combat_exp", -10000); 
1010                      break; 
1011             case 5:  if( me->query("combat_exp") < (1500000+upgraded*400000) || 
1012                      me->query("max_force") < 4000 ) 
1013                         return notify_fail("不够升级条件，请用 cost 查询。\n"); 
1014                      fabao_ob->add("weapon_prop/damage", 6); 
1015                      fabao_ob->add("upgraded/"+property, 1); 
1016                      if( upgraded == 5 )  { 
1017                         fabao_ob->add("stars/"+property, 1); 
1018                         fabao_ob->set("upgraded/"+property, 0); 
1019                      } 
