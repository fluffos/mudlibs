//ground.c

#include <ansi.h>
inherit ROOM;
#include "/d/kaifeng/ground.h"


void create() {
  set("short", HIG "[" HIR "比武擂台" HIG "]" NOR);
  set("long", @LONG
  
           八  仙  过  海         各  显  神  通

LONG);
  // set("no_flee",1);
  set("no_quit", 1);
  set("broadcast", 1);
  set("busy", 5);
  set("alternative_die", 1);
  set("exits", ([]));
  setup();
}

void alternative_die(object me) {
  object ob = me->query_temp("last_damage_from");
  if (me->query("kee") < 0) me->set("kee", 10);
  if (me->query("eff_kee") < 0) me->set("eff_kee", 10);
  me->remove_killer(ob);
  ob->remove_killer(me);
  message_vision(HIG "$n把$N打翻在地，飞起一脚，将$N踢下了擂台。\n" NOR, me, ob);
  message_vision(HIG "$n在观众的欢呼声中，高高兴兴地下场休息了。\n" NOR, me, ob);
  message(
    "chat",
    HIC + "【大唐西游·比武】" NOR + HIW + ob->query("name") + HIC "打败" NOR + HIW + me->query("name") + HIC "夺得了该场比赛的胜利。\n" NOR,
    users()
  );
  tell_room(__DIR__ "under7", "\n>\n");  //age 14-15
  tell_room(__DIR__ "under7", "\n>\n");  //wx 100w d
  tell_room(__DIR__ "under7", "\n>\n");  //wx 100-300w
  tell_room(__DIR__ "under7", "\n>\n");  //wx 300-500w
  tell_room(__DIR__ "under7", "\n>\n");  //500-800w
  tell_room(__DIR__ "under7", "\n>\n");  //800上
  me->set_temp("fight/fail");
  if (me->query("age") < 16) {
    me->move(__DIR__ "under7");
    ob->move(__DIR__ "under7");
  } else if (me->query("combat_exp") < 1000000) {

    me->move(__DIR__ "under7");
    ob->move(__DIR__ "under7");
  } else if (me->query("combat_exp") < 3000000 && me->query("combat_exp") > 1000000) {

    me->move(__DIR__ "under7");
    ob->move(__DIR__ "under7");
  } else if (me->query("combat_exp") < 5000000 && me->query("combat_exp") > 3000000) {

    me->move(__DIR__ "under7");
    ob->move(__DIR__ "under7");
  } else if (me->query("combat_exp") < 8000000 && me->query("combat_exp") > 5000000) {

    me->move(__DIR__ "under7");
    ob->move(__DIR__ "under7");
  } else {

    me->move(__DIR__ "under7");
    ob->move(__DIR__ "under7");
  }

  me->set("kee", (int)me->query_temp("statusbef/kee"));
  me->set("eff_kee", (int)me->query_temp("statusbef/eff_kee"));
  me->set("sen", (int)me->query_temp("statusbef/sen"));
  me->set("eff_sen", (int)me->query_temp("statusbef/eff_sen"));
  me->set("force", (int)me->query_temp("statusbef/force"));
  me->set("mana", (int)me->query_temp("statusbef/mana"));
  ob->set("kee", (int)ob->query_temp("statusbef/kee"));
  ob->set("eff_kee", (int)ob->query_temp("statusbef/eff_kee"));
  ob->set("eff_sen", (int)ob->query_temp("statusbef/eff_sen"));
  ob->set("sen", (int)ob->query_temp("statusbef/sen"));
  ob->set("force", (int)ob->query_temp("statusbef/force"));
  ob->set("mana", (int)ob->query_temp("statusbef/mana"));
}

void broadcast(string str) {
  string prefix = HIY "〖大唐西游·比武〗" NOR;
  string s1 = str, s2 = "";
  while (strsrch(s1, "\n\n") != -1)
    s1 = replace_string(s1, "\n\n", "\n");

  if (s1[strlen(s1) - 1] == '\n') {
    s1 = s1[0..strlen(s1) - 2];
    s2 = "\n";
  }
  if (strlen(s1) == 0)
    return;
  s1 = replace_string(s1, "\n", "\n" + prefix) + "";
  reset_eval_cost();
  tell_room(__DIR__ "under1", "\n" + prefix + s1);
  tell_room(__DIR__ "under2", "\n" + prefix + s1);
  tell_room(__DIR__ "under3", "\n" + prefix + s1);
  tell_room(__DIR__ "under4", "\n" + prefix + s1);
  tell_room(__DIR__ "under5", "\n" + prefix + s1);
  tell_room(__DIR__ "under6", "\n" + prefix + s1);
  tell_room(__DIR__ "under7", "\n" + prefix + s1);

}
