//水陆大会奖赏包，create by smile 2/20/1999
#include <ansi.h>
inherit ITEM;
int time;
int first;

void create()
{
   set_name(HIG"水陆大会奖励包"NOR, ({"libao"}));
   if( clonep() )
     set_default_object(__FILE__);
   else {
     set("long", "这是一个巫师给玩家的水陆大会奖励礼包,请用jiebao命令打开。\n");
     set("unit", "个");
     set("weight", 5);
   }
}

void init()
{
 add_action("do_settime","settime");
 add_action("do_first","first");
 add_action("do_give","give");
 add_action("do_jiebao","jiebao");
 first=0;
 time=environment(this_object())->query("sldhtime");
}

int do_settime(string arg)
{
  if(!arg||!sscanf(arg,"%d",time))
   return notify_fail("你要设置第几次水陆大会吗？\n");
  environment(this_object())->set("sldhtime",time);
  tell_object(this_player(),"你在这个房间设置了水陆大会发奖届数，请在发完之前不要离开。\n");
  return 1;
}

int do_first(string arg)
{
if(wizardp(this_player()))
 {
  this_object()->set("first",1);
  first=1;
  tell_object(this_player(),"你设置这个包为第一名奖励包，请不要弄错了。\n");
  this_object()->set_name(HIG"水陆大会冠军奖励包"NOR, ({"libao"}));
 }
 return 1;
}

int do_give(string arg)
{
  object who;
  object ob;
  object libao=this_object();
  string item,target;
  if(!arg) {
         tell_object(who,"你要干什么？\n");
         return 1;}
 if( sscanf(arg, "%s to %s", item, target)==2
   || sscanf(arg, "%s %s", target, item)==2 );
 else return notify_fail("你要给谁什么东西啊？\n");

  who=this_player();
  if(!wizardp(who)) {
     tell_object(who,"你无权把这个东西给人。\n");
      return 1;
       }
  if(time==0)
   {
  tell_object(who,"请首先设置水陆大会发奖届数。\n参数：settime N。\n如果这个奖励包是给冠军的，请用first指令指定。\n");
  return 1;}
  ob=find_player(target);
  if(!ob) {
       tell_object(who,"没有这个玩家，无法把这个东西给他。\n");
       return 1;
          }
  if(ob->query("sldh/time")==time&&ob->query("sldh/give")==1) {
    tell_object(who,"这个人已经得到过奖励包了，可不能给第二次！\n");
    return 1;
       }
  ob->set("sldh/give",1);
  ob->set("sldh/time",time);
  libao->move(ob);
  tell_object(ob,who->name()+"给你一个"+libao->name()+"。\n");
  return 1;
}

int do_jiebao()
{
 object who=this_player();
 object ob=this_object();
 object gold,guo;
 int i=0,dx=0;
  message_vision(HIY"$N兴奋的把奖励包打开！\n"NOR,who);
  if(who->query("sldh/time")==time)
   {
    tell_object(who,"你已经拿过奖励了，还是安心点好，别太贪了！\n");
    destruct(ob);
    return 1;
   }
  else {
    if(time==0) {
       tell_object(who,"这个奖励包还没设置好参数，请向巫师要求。\n");
       destruct(ob);
       return 1;
       } 
     dx=who->query("combat_exp");
    if(dx<1000) {
        tell_object(who,"你的道行不满一年，没有资格获得奖励。\n");
        destruct(ob);
        return 1;}
    if(dx>1000&&dx<=50000) i=1;
    if(dx>50000&&dx<=100000) i=2;
    if(dx>100000&&dx<=200000) i=4;
    if(dx>200000&&dx<=500000) i=6;
    if(dx>500000) i=7;
    tell_object(who,"你获得了"+chinese_number(500*i)+"点潜能！\n");
    who->add("potential",500*i);
    if(first) {
    if(dx<=100000) {
     tell_object(who,"你获得一百两黄金。\n");
        gold=new("/obj/100gold");
        gold->move(who);
       }
    if(dx>100000) {
       tell_object(who,"你获得一个人参果。\n");
        guo=new("/d/obj/drug/renshen-guo");
        guo->move(who);
       }
      }
    destruct(ob);
    return 1;
       }
}
