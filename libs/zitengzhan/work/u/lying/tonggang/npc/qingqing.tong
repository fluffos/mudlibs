inherit NPC;

#include <ansi.h>
int give_dou ();

int create()
{
  set_name(HIM"青青"NOR, ({"qing qing","qing", "lover"}));
  set("long", "一位貌美如花的小姑娘。她是天神童钢的女朋友。\n");

  set("gender", "女性");
  set("attitude", "peaceful");
  set("class", "bonze");
  set("age", 15);
  set("str", 20);
  set("int", 30);
  set("per", 40);
  set("con", 20);
  set("max_kee", 400);
  set("max_sen", 400);
  set("max_force", 300);
  set("force", 300);
  set("force_factor", 10);
  set("max_mana", 400);
  set("mana", 400);
  set("mana_factor", 10);
  set("combat_exp", 50000);
  set("daoxing", 80000);


  set("chat_chance", 5);
  set("chat_msg", ({
    "青青叹道：淘淘回来了，工作辛苦吧?\n",
    "青青说道：童钢，我做的可可豆出锅了，你要吃点吗?\n",
    "青青叹道：淘淘，你要多听听你妈的话呀，别在惹她生气了，知道吗！\n",
	"青青叹道：以后少抽点烟，对你的身体不好！\n",
	"青青叹道：狗狗最乖了，我最喜欢狗狗了!\n",
	"青青说道：淘淘什么时候娶我呀？哈.....\n",
	"青青叹道：淘淘，今天我做炉包，你吃吗?\n",
  }));
  set("inquiry", ([
    "可可豆" : (: give_dou :),
    "dou" : (: give_dou :),
  ]) );

  set_skill("force", 50);
  set_skill("unarmed", 50);
  set_skill("dodge", 79);
  set_skill("parry", 79);
  set_skill("staff", 50);
  set_skill("lotusforce", 50);
  set_skill("lunhui-zhang", 79);
  set_skill("jienan-zhi", 50);
  set_skill("lotusmove", 79);
  map_skill("dodge", "lotusmove");
  map_skill("unarmed", "jienan-zhi");
  map_skill("staff", "lunhui-zhang");
  map_skill("parry", "lunhui-zhang");
  map_skill("force", "lotusforce");
  setup();
  add_money("silver", 5);
  carry_object("/u/tonggang/obj/skirt")->wear();
  carry_object("/u/tonggang/obj/dou");
  set("dous", 3);
  setup();
}

int give_dou ()
{
  object who = this_player();
  object dou;

  if (query("dous") <= 0)
  {
    command ("say 不给了，不给了，你们把豆吃光了，我怎么跟童钢少爷交待呀！");
    return 1;
  }
  
  dou = new ("/u/tonggang/obj/dou");
  add("dous",-1);
  message_vision (HIM"青青"NOR"给$N一颗$n。\n",who,dou);
  dou->move(who);
  return 1; 
}

