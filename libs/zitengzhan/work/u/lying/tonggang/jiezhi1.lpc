// jiehunring 结婚戒指

#include <ansi.h>
#include <armor.h>

inherit FINGER;
inherit F_AUTOLOAD;

void create() {
  set_name(HIW "结婚戒指" NOR, ({ "jiehun jiezhi", "jiezhi", "ring" }));
  set("weight", 400);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一只本站给玩家sunhero和smoon的结婚纪念戒指。\n");
    set("unit", "只");
    set("value", 0);
    set("no_sell", 1);
    set("no_drop", 1);
    set("no_get", 1);
    set("no_put", 1);
    set("material", "gold");
    set("armor_prop/armor", 1);
  }
  setup();
}
int query_autoload() { return 1; }
