// wanfo.c write by tonggang

#include <ansi.h>

inherit SSERVER;

void remove_effect(object me, int amount);

int cast(object me, object target) {
  int skill;
  string msg;

  skill = me->query_skill("spells", 1);

  if (skill > 300) {
    skill = 300;
  }


  if ((int)me->query("mana") < skill * 2)
    return notify_fail("你的法力力不够。\n");
  if ((int)me->query("fo/level") < 24)
    return notify_fail("大道未证，何以能够万佛朝宗？\n");
  if (!me->is_fighting())
    return notify_fail("只有在战斗中才能使用万佛朝宗！\n");
  if ((int)me->query_temp("wanfo"))
    return notify_fail("你已经在运功中了。\n");

  me->add("spells", -skill);
  me->receive_damage("kee", 50);

  msg = HIR
    "$N微一凝神，念动大乘佛咒真言。。。\n\n\n
		" + HIY + "" + BLINK + "万                  佛                   朝                   宗 \n\n\n" NOR;
  message_vision(msg, me, target);

  me->add_temp("apply/attack", skill / 5);
  me->add_temp("apply/strength", skill / 5);
  me->set_temp("wanfo", 1);

  me->start_call_out((: call_other, __FILE__, "remove_effect", me, skill / 5 :), skill);

  if (me->is_fighting()) me->start_busy(1);

  return 1;
}

void remove_effect(object me, int amount) {
  int i;
  i = me->query_skill("spells", 1);
  if (!me) return;
  me->add_temp("apply/attack", -amount);
  me->add_temp("apply/strength", -amount);
  me->set_skill("spells", i - 2);
  me->delete_temp("wanfo");
  //    me->add("bellicosity", amount*2 );
  // mon 3/1/98. move this to after powerup is done.
  tell_object(me, "你的万佛朝宗拜会已毕，众佛归位了。\n");
}
