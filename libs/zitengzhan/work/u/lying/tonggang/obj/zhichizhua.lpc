// blade.c

#include <weapon.h>
#include <ansi.h>

inherit DAGGER;
inherit F_AUTOLOAD;

void create() {
  set_name(HIR "支持者" HIC "之" HIM "爪" NOR, ({ "zhichi zhua", "zhua",
    "zhichizhe" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一把本站只奖励给最早玩家的非同凡响的爪子。\n");
    set("unit", "把");
    set("no_sell", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_get", 1);
    set("no_put", 1);

    set("wield_msg",
      "$N拿起$n握在手里。\n");
    set("unwield_msg",
      "$N将手中的$n插入腰间，脸色更加阴沉了！\n");
    set("value", 1);
    set("weapon_prop/courage", 10);
    set("no_sell", 1);
    set("no_drop", "去垃圾堆丢吧，乱扔会污染环境!\n");
    set("no_get", "想拿老玩家才能有的装备？做梦吧!\n");
  }
  init_dagger(60);
  setup();
}
int query_autoload() { return 1; }
