inherit ITEM;
#include <ansi.h>

int check_value(string);
int do_eat(string);
int get_str(string, object);
int get_cps(string, object);
int get_cor(string, object);
int get_per(string, object);
int get_int(string, object);
int get_con(string, object);
int get_spi(string, object);
int get_kar(string, object);
int comfire(object);
void init();

int LIMIT = 170;
int temp = LIMIT;

void init() {
  if (!wizardp(this_player())) {
    set("is_monitored", 1);
    set("no_drop", "这么宝贵的丹药，扔了多可惜呀！\n");
    set("no_sell", "凡人哪里知道" + this_object()->query("name") + "的价值？还是自己留着吧。\n");
  }
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIY "天赋丹" NOR, ({ "tfd", "dan" }));
  set_weight(90);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "一颗金黄色的丹丸，略微能闻到些许香气。\n");
    set("value", 10000);
  }
  setup();
}

int do_eat(string arg) {
  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  if ((int)this_player()->query("tfd_eat") == 4)
    return notify_fail("你已经吃过3次天赋丹了。\n");
  write("臂力[10-30/" + (string)temp + "]：");
  input_to("get_str", this_player());
  return 1;
}
int get_str(string value, object ob) {
  int zhi;
  if (value == "") {
    write("臂力[10-30/" + (string)temp + "]：");
    input_to("get_str", ob);
    return 0;
  }

  else if (value == "q") {
    write("\n放弃！\n");
    temp = LIMIT;
    return notify_fail("放弃！\n");
  }

  if (!check_value(value)) {
    write("臂力[10-30/" + (string)temp + "]：");
    input_to("get_str", ob);
    return 0;
  }
  zhi = atoi(value);
  ob->set_temp("tianfu/str", zhi);
  temp = temp - zhi;
  write("定力[10-30/" + (string)temp + "]：");
  input_to("get_cps", ob);
  return 0;
}
