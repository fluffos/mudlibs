int get_spi(string value, object ob) {
  int zhi;
  if (value == "") {
    write("灵性[10-30/" + (string)temp + "]：");
    input_to("get_spi", ob);
    return 0;
  } else if (value == "q") {
    write("\n放弃！\n");
    temp = LIMIT;
    return notify_fail("放弃！\n");
  }

  if (!check_value(value)) {
    write("灵性[10-30/" + (string)temp + "]：");
    input_to("get_spi", ob);
    return 0;
  }
  zhi = atoi(value);
  ob->set_temp("tianfu/spi", zhi);
  temp = temp - zhi;
  ob->set_temp("tianfu/kar", temp);
  write("福缘[" + (string)temp + "/" + (string)temp + "]。\n");
  write("确定[y|n]：");
  input_to("get_kar", ob);
  return 0;
}
int get_kar(string value, object ob) {
  if (value == "y" || value == "Y") {
    if (temp > 30 || temp < 10) {
      write("数值不能大于 30或小于10！\n");
      write("重输！\n");
      temp = LIMIT;
      write("臂力[10-30/" + (string)temp + "]：");
      input_to("get_str", ob);
      return 0;
    }
    comfire(ob);
  } else if (value == "n" || value == "N") {
    write("\n放弃！\n");
    temp = LIMIT;
    return notify_fail("放弃！\n");
  } else {
    write("确定[y|n]：");
    input_to("get_kar", ob);
    return 0;
  }
}

int check_value(string value) {
  int i, j;
  i = strlen(value);
  while (i--)
    if (value[i] > '9' || value[i] < '0') {
      write("对不起，不是数值（０－９）。\n");
      return 0;
    }
  i = strlen(value);
  j = atoi(value);
  if (j > 30) {
    write("数值不能大于 30！\n");
    return 0;
  } else if (j < 10) {
    write("数值不能小于  10！\n");
    return 0;
  }
  if (j > temp) {
    write("数值没有这么多！\n");
    return 0;
  }
  return 1;
}

int comfire(object ob) {
  ob->set("str", ob->query_temp("tianfu/str"));
  ob->set("cps", ob->query_temp("tianfu/cps"));
  ob->set("cor", ob->query_temp("tianfu/cor"));
  ob->set("per", ob->query_temp("tianfu/per"));
  ob->set("int", ob->query_temp("tianfu/int"));
  ob->set("con", ob->query_temp("tianfu/con"));
  ob->set("spi", ob->query_temp("tianfu/spi"));
  ob->set("kar", ob->query_temp("tianfu/kar"));
  ob->add("tfd_eat", 1);
  ob->delete_temp("tianfu");
  message_vision(HIG "$N轻轻掰开一颗天赋丹送入嘴中，一时间香气四溢。只见$N脸上慢慢泛出红晕，看起来
有精神多了！\n" NOR, ob);
  destruct(this_object());
  return 0;
}
