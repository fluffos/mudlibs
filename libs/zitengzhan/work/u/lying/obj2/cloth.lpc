#include <ansi.h>
#include <armor.h>
inherit CLOTH;
void create() {
  set_name(HIY "黄金战袍" NOR, ({ "golden cloth", "cloth" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("material", "cloth");
    set("unit", "件");
    set("value", 100000);
    set("no_sell", 1);
    set("armor_prop/armor", 50);
    set("need_level", 5);
  }
  setup();
}
