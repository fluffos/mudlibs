#include <ansi.h>
#include <armor.h>
inherit FINGER;
void create() {
  set_name(HIY "黄金指环" NOR, ({ "golden ring", "ring" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("material", "gold");
    set("unit", "个");
    set("value", 20000);
    set("no_sell", 1);
    set("no_drop", 1);
    set("armor_prop/armor", 80);
    set("armor_prop/armor_vs_force", 400);
    set("need_level", 10);
  }
  setup();
}
