#include <ansi.h>
#include <armor.h>
inherit WAIST;
void create() {
  set_name(HIY "黄金腰带" NOR, ({ "golden waist", "waist" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("material", "gold");
    set("unit", "根");
    set("value", 50000);
    set("no_sell", 1);
    set("no_drop", 1);
    set("armor_prop/armor", 30);
    set("armor_prop/armor_vs_mana", 400);
    set("need_level", 2);
  }
  setup();
}
