#include <ansi.h>
#include <armor.h>
inherit NECK;
void create() {
  set_name(HIY "黄金护胸" NOR, ({ "golden neck", "neck" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("material", "golden");
    set("unit", "件");
    set("value", 100000);
    set("no_sell", 1);
    set("armor_prop/armor", 60);
    set("need_level", 6);
  }
  setup();
}
