#include <ansi.h>
#include <armor.h>
inherit SHIELD;
void create()
{
  set_name(HIY "黄金狮子盾" NOR, ({"golden shield", "shield"}));
  set_weight(2000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("material", "gold");
    set("unit", "件");
    set("value", 30000);
               set("no_sell", 1);
               set("no_drop", 1);
    set("armor_prop/armor", 80);
        set("need_level",5);
  }
  setup();
}
