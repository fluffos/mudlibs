#include <ansi.h>
inherit SSERVER;
#include <login.h>



int cast(object me, object target) {
  object bb;
  int i, j, rev, id;
  mixed *name = ({
    ({ HIC "四不像" NOR, HIC "似鹿非鹿似马非马这是一头四不像" NOR, "头", 10, 1, 30, 10, 20, 50, 300 }),
    ({ HIB "月光仙兔" NOR, HIB "经过月光沐浴后产生异变的仙兔" NOR, "只", 20, 2, 40, 10, 30, 60, 500 }),
    ({ HIY "独角兽" NOR, HIY "传说中只有最纯洁的女子才能骑乘的独角兽" NOR, "头", 30, 3, 50, 10, 50, 80, 700 }),
    ({ HIM "美人鱼" NOR, HIM "传说中在大海深处才能看见的美人鱼" NOR, "条", 40, 4, 60, 10, 70, 100, 1000 }),
    ({ HIG "谛魂兽" NOR, HIG "上听三十三天下探九幽这是一头谛魂兽" NOR, "头", 50, 5, 70, 10, 90, 120, 1300 }),
    ({ HIR "火炽朱雀" NOR, HIR "上古四方圣兽之-朱雀的后裔" NOR, "只", 60, 6, 85, 10, 120, 150, 1600 }),
    ({ HIW "月光天使兽" NOR, HIW "由月光所化拥有最纯洁的身体和不可思议的能力" NOR, "头", 70, 7, 100, 10, 150, 180, 2000 })
  });                   //0名字1描述2单位3状态增益4命中增益5先天属性6最高等级7id8伤害力9防御力

  if (!target) target = offensive_target(me);
  if (!target || !target->query("moon_petegg") || target->query("id") != "pet egg")
    return notify_fail("月光神术只能对宠物蛋使用！。\n");

  if (!present("pet egg", me)) return notify_fail("宠物蛋要抱在怀里才能施展月光术神术！。\n");

  if (me->is_fighting())
    return notify_fail("你都自顾不暇了还有空去孵蛋？\n");

  if (me->query("family/family_name") != "月宫")
    return notify_fail("不是月宫弟子用不了月光神术！\n");

  if (me->query_skill("spells", 1) < 50)
    return notify_fail("你的基本法术不够纯熟！\n");
  if (me->query_skill("moonshentong", 1) < 50)
    return notify_fail("你的月宫仙法不够纯熟！\n");
  if ((int)me->query("max_mana") < 500)
    return notify_fail("你的法力太差！\n");
  if ((int)me->query("mana") < 500)
    return notify_fail("你的法力不够了！\n");

  if ((int)me->query("sen") < 500)
    return notify_fail("你的精神无法集中！\n");

  me->add("mana", -200);
  me->receive_damage("sen", 50);
  me->start_busy(1 + random(2));

  message_vision(
    HIW "$N" + HIW + "从怀里掏出宠物蛋，施展起月光神术，面现温柔期盼之态，只见一道璀璨的月光直接照在了$n" + HIW + "上。\n" NOR,
    me,
    target
  );
  message_vision(
    HIW "  $N" + HIW + "轻轻抚摸着$n" + HIW + "，突然觉得$n" + HIW + "好像动了一下。\n" NOR,
    me,
    target
  );
  target->add("petburn", -1);
  if (target->query("petburn") < 1) {
    message_vision(HIM "只听咔嚓一下宠物蛋突然裂成两半！。\n" NOR, me);
    if (me->query("pet")) {
      message_vision(HIY "$N" + HIY + "定睛一看，宠物蛋中居然是空的，什么都没有。\n" NOR, me);
      destruct(target);
      return 0;
    }
    i = me->query_skill("spells") / 100;
    i = random(i);
    if (i < 1) i = 0;
    if (i > 6) i = 6;
    bb = new("/d/eastway/npc/pet");
    if (!bb)
      return 0;
    id = bb->query("id");
    //seteuid(name[i][7]);
    rev = export_uid(bb);
    seteuid(getuid());

    bb->set_name(name[i][0], ({ me->query("id") + " " + id, id }));  //名字
    bb->set("weight", 1000);  //重量
    bb->set("long", name[i][1] + "\n" + "它是" + me->query("name") + "的宠物。\n");
    bb->set("unit", name[i][2]);
    bb->set("owner", me->query("id"));
    bb->set("series_no", "1");
    bb->set("moon_pet", 1);
    bb->set("possessed", me);
    bb->set("is_guard", 1);
    bb->set("levelup", random(i + 4) + 1);
    bb->set("gender", random(2) ? "男性" : "女性");
    bb->set("ride/dodge", random(name[i][3]) + name[i][3] / 2);
    bb->set("ride/parry", random(name[i][3]) + name[i][3] / 2);
    bb->set("ride/spells", random(name[i][3]) + name[i][3] / 2);
    bb->set("ride/armor", random(name[i][3]) + name[i][3]);
    bb->set("ride/damage", random(name[i][3]) + name[i][3] / 2);
    bb->set("ride/armor_vs_force", random(name[i][3]) + name[i][3]);
    bb->set("ride/armor_vs_spells", random(name[i][3]) + name[i][3]);
    bb->set("ride/mingzhong", random(name[i][4]) + 1);
    bb->set("apply/damage", random(name[i][7]));
    bb->set("apply/armor", random(name[i][8]));
    bb->set("apply/armor_vs_force", random(name[i][8]));
    bb->set("apply/armor_vs_spells", random(name[i][8]));
    bb->set("combat_exp", 5000);
    bb->set("daoxing", 5000);
    bb->set("max_petlevel", i + random(name[i][6]));
    bb->set("now_petlevel", 0);
    bb->set("str", name[i][5]);
    bb->set("con", name[i][5]);
    bb->set("cor", name[i][5]);
    bb->set("int", name[i][5]);
    bb->set("spi", name[i][5]);
    bb->set("cps", name[i][5]);
    bb->set("per", name[i][5]);
    bb->set("kar", name[i][5]);
    bb->set("kee", name[i][9]);
    bb->set("max_kee", name[i][9]);
    bb->set("max_sen", name[i][9]);
    bb->set("max_mana", name[i][9]);
    bb->set("max_force", name[i][9]);
    bb->set("eff_sen", name[i][9]);
    bb->set("eff_kee", name[i][9]);
    bb->set("sen", name[i][9]);
    bb->set("mana", name[i][9]);
    bb->set("force", name[i][9]);
    bb->set("title", BLU "幼兽" NOR);
    bb->save();
    bb->setup();
    me->set("pet/pet_id", me->query("id") + " " + id);
    me->set("pet/pet_type", "宠");
    me->set("pet/pet_name", name[i][0]);
    me->set("pet/pet_desc", "可爱的宠物宝宝");
    me->set("pet/pet_unit", name[i][2]);
    message_vision(
      HIY "$N" + HIY + "定睛一看，居然孵化出一" + bb->query("unit") + "可爱的" + bb->query("name") + "。\n" NOR,
      me
    );
    if (!bb->move(me))
      bb->move(environment(me));
    me->save();
    destruct(target);
    return 0;
  }
  return 1;
}
