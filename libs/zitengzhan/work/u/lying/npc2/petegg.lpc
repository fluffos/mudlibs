#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIM "宠物蛋" NOR, ({ "pet egg", "egg" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "一枚宠物蛋，似乎还有生命迹象。\n");
    set("no_sell", 1);
    set("moon_petegg", 1);
    set("petburn", 10 + random(10));
  }
  setup();
}

int query_autoload() { return 1; }
