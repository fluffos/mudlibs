                           if ((int)me->query("txd") < 1)
                            return notify_fail("对不起!您要的天仙丹暂时被兑换完了。 \n");
                                ob=new("/d/npc/vr_room/obj/txd.lpc");
                                if (objectp(ob)) 
                            {
                            ob->move(who);
                            me->add("txd", -1);
                            who->add("faith",-1000);
                                tell_object(who,"你用1000点门派忠诚度向兑换师换取了一颗"+ob->query("name")+"！\n");
                               }
                                break;
                        case "lxd":
                           if (who->query("faith")<1000)
                            return notify_fail("你的门派忠诚度不够! \n");
                           if ((int)me->query("lxd") < 1)
                            return notify_fail("对不起!您要的灵仙丹暂时被兑换完了。 \n");
                                ob=new("/d/npc/vr_room/obj/lxd.lpc");
                                if (objectp(ob)) 
                            {
                            ob->move(who);
                            me->add("lxd", -1);
                            who->add("faith",-1000);
                                tell_object(who,"你用1000点师门派忠诚度向兑换师换取了一颗"+ob->query("name")+"！\n");
                               }
                                break;
                        case "hmd":
                           if (who->query("faith")<1000)
                            return notify_fail("你的门派忠诚度不够! \n");
                           if ((int)me->query("hmd") < 1)
                            return notify_fail("对不起!您要的鸿蒙丹暂时被兑换完了。 \n");
                                ob=new("/d/npc/vr_room/obj/hmd.lpc");
                                if (objectp(ob)) 
                            {
                            ob->move(who);
                            me->add("hmd", -1);
                            who->add("faith",-1000);
                                tell_object(who,"你用1000点门派忠诚度向兑换师换取了一颗"+ob->query("name")+"！\n");
                               }
                                break;
                        case "hdd":
                           if (who->query("faith")<1000)
                            return notify_fail("你的门派忠诚度不够! \n");
                           if ((int)me->query("hdd") < 1)
                            return notify_fail("对不起!您要的混沌丹暂时被兑换完了。 \n");
                                ob=new("/d/npc/vr_room/obj/hdd.lpc");
                                if (objectp(ob)) 
                            {
                            ob->move(who);
                            me->add("hdd", -1);
                            who->add("faith",-1000);
                                tell_object(who,"你用1000点门派忠诚度向兑换师换取了一颗"+ob->query("name")+"！\n");
                               }
                                break;
                        case "djd":
                           if (who->query("faith")<8000)
                            return notify_fail("你的门派忠诚度不够! \n");
                           if ((int)me->query("djd") < 1)
                            return notify_fail("对不起!您要的度劫丹暂时被兑换完了。 \n");
                                ob=new("/u/xdao/gift/djd.lpc");
                                if (objectp(ob)) 
                            {
                            ob->move(who);
                            me->add("djd", -1);
                            who->add("faith",-8000);
