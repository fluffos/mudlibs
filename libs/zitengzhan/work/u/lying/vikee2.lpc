                            {
                            ob->move(who);
                            who->add("faith",-100);
                                tell_object(who,"你用100点师徒荣誉值向兑换师换取了一颗"+ob->query("name")+"！\n");
                               }
                                break;
                        case "baoshi3":
                           if (who->query("faith")<100)
                            return notify_fail("你的荣誉度不够! \n");
                                ob=new("/d/npc/vr_room/obj/bs_tq.lpc");
                                if (objectp(ob)) 
                            {
                            ob->move(who);
                            who->add("faith",-100);
                                tell_object(who,"你用100点师徒荣誉值向兑换师换取了一颗"+ob->query("name")+"！\n");
                               }
                                break;
                        case "baoshi4":
                           if (who->query("faith")<100)
                            return notify_fail("你的荣誉度不够! \n");
                                ob=new("/d/npc/vr_room/obj/bs_zf.lpc");
                                if (objectp(ob)) 
                            {
                            ob->move(who);
                            who->add("faith",-100);
                                tell_object(who,"你用100点师徒荣誉值向兑换师换取了一颗"+ob->query("name")+"！\n");
                               }
                                break;
                        case "baoshi5":
                           if (who->query("faith")<100)
                            return notify_fail("你的荣誉度不够! \n");
                                ob=new("/d/npc/vr_room/obj/bs_lh.lpc");
                                if (objectp(ob)) 
                            {
                            ob->move(who);
                            who->add("faith",-100);
                                tell_object(who,"你用100点师徒荣誉值向兑换师换取了一颗"+ob->query("name")+"！\n");
                               }
                                break;
                        case "baoshi6":
                           if (who->query("faith")<2000)
                            return notify_fail("你的荣誉度不够! \n");
                           if ((int)me->query("stone") < 1)
                            return notify_fail("对不起!您要的生命宝石暂时被兑换完了。 \n");
                                ob=new("/d/npc/vr_room/obj/stone.lpc");
                                if (objectp(ob)) 
                            me->add("stone", -1);
                            {
                            ob->move(who);
                            who->add("faith",-2000);
                                tell_object(who,"你用2000点师徒荣誉值向兑换师换取了一颗"+ob->query("name")+"！\n");
                               }
                                break;
                                //兵器
                        case "ysd":
                           if (who->query("faith")<1000)
                            return notify_fail("你的门派忠诚度度不够! \n");
                           if ((int)me->query("ysd") < 1)
                            return notify_fail("对不起!您要的养神丹暂时被兑换完了。 \n");
                                ob=new("/d/npc/vr_room/obj/ysd.lpc");
                                if (objectp(ob)) 
                            {
