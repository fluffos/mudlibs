                           if ((int)me->query("rxd") < 1)
                            return notify_fail("对不起!您要的人仙丹暂时被兑换完了。 \n");
                                ob=new("/d/npc/vr_room/obj/rxd.lpc");
                                if (objectp(ob)) 
                            {
                            ob->move(who);
                            me->add("rxd", -1);
                            who->add("faith",-1000);
                                tell_object(who,"你用1000点门派忠诚度向兑换师换取了一颗"+ob->query("name")+"！\n");
                               }
                                break;
                        case "dxd":
                           if (who->query("faith")<1000)
                            return notify_fail("你的门派忠诚度不够! \n");
                           if ((int)me->query("dxd") < 1)
                            return notify_fail("对不起!您要的地仙丹暂时被兑换完了。 \n");
                                ob=new("/d/npc/vr_room/obj/dxd.lpc");
                                if (objectp(ob)) 
                            {
                            ob->move(who);
