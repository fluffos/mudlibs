
#include <ansi.h>

inherit NPC;

void create()
{
        set_name(""HIY"兑换师"NOR"", ({"pmaster npc", "npc"}));
        set("long", "这是一个用来兑换师徒荣誉值的npc。\n");
        set("gender", "男性");
       set("title",""HIM"奇经八脉");
        set("no_clean_up",1);
        set("age", 20);
        set("per", 40);
        set("stone",1);
        set("csd",1);
        set("ysd",1);
        set("rxd",1);
        set("dxd",1);
        set("txd",1);
        set("lxd",1);
        set("hmd",1);
        set("hdd",1);
        set("djd",1);
        set_temp("begin_duihuan",1);
        set_skill("literate", 141);
        set("chat_chance",5);
    set("chat_msg", ({
        "兑换师轻声告诉你：你可以用list指令列出想要兑换的东西！\n",
        "兑换师轻声告诉你：你可以用duihuan指令向我兑换装备道具。\n",
        }));
        setup();
        carry_object("/d/obj/cloth/magua")->wear();
}

void heart_beat()
{
object ob = this_object();
::heart_beat();
if(ob->query_temp("begin_duihuan")) 
  {
 ob->delete_temp("begin_duihuan");
 call_out("add_djd", 86400, ob);
 call_out("add_dan", 21600, ob);
    CHANNEL_D->do_channel(this_object(),"sys", "仙丹开始研制。。。");
   }
}

void add_djd(object ob)
{
if(!ob) return 0;
ob->add("djd",1);
 call_out("add_djd", 86400, ob);
    CHANNEL_D->do_channel(ob,"sys", "度劫丹研制成功，库存量+1");
}

void add_dan(object ob)
{
if(!ob) return 0;
ob->add("ysd",1);
ob->add("csd",1);
ob->add("rxd",1);
ob->add("dxd",1);
ob->add("stone",1);
ob->add("txd",1);
ob->add("lxd",1);
ob->add("hmd",1);
ob->add("hdd",1);
 call_out("add_dan", 21600, ob);
    CHANNEL_D->do_channel(ob,"sys", "开脉丹研制成功，库存量+1");
}


void init()
{
        ::init();
  add_action("do_fight", "fight");
  add_action("do_kill", "kill");
  add_action("do_steal", "steal");
  add_action("do_cast", "cast");
  add_action("do_ji","ji");
  add_action("do_throw","throw");
  add_action("do_list","list");
  add_action("do_yao","duihuan");
}

void die()
{
 return;
}

int do_fight(string arg)
{
  object who = this_player();
  object me = this_object();

  if (arg && present(arg,environment(who))==me)
  {
        message_vision("$N看样子想打架，但兑换师很有涵养,不和$N动粗。\n",who,me);
     return 1;
  }
  return 0;
}

int do_kill(string arg)
{
  object who = this_player();
  object me = this_object();

  if (arg && present(arg,environment(who))==me)
  {
message_vision("$N看样子想杀死首席长老，但兑换师是文化人,没跟$N一般见识。\n",who,me);

    return 1;
  }
  return 0;
}

int do_cast(string arg)
{
  object who = this_player();
  object me = this_object();

  message_vision("$N对着兑换师结结巴巴的念了几句咒语，自己都感觉难听死了。\n",who,me);

  return 1;
}


int do_steal(string arg)
{
  object who = this_player();
  object me = this_object();

  message_vision("$N想偷东西，但总是有贼心没贼胆。\n",who,me);

  return 1;
}


int do_ji(string arg)
{
  object who = this_player();
  object me = this_object();

  message_vision("$N想对兑换师祭法宝，前思后想，还是没敢。\n",who,me);

  return 1;
}

int do_throw(string arg)
{
  object who = this_player();
  object me = this_object();

  message_vision("$N掏出暗器，看了看兑换师，信心不足，又把暗器收了起来。\n",who,me);

  return 1;
}

int do_list(string arg)
{
       object who = this_player();
        object me = this_object();
  message("vision",""HIG"\n────────────────兑—换—道—具────────────────
   
          \n"HIC"丹药类："HIY" 
          1.养身丹(ysd)"HIG" 【1000点门派忠诚度：1颗】可供应："+(int)me->query("ysd")+"颗"HIY"  

          2.长生丹(csd)"HIG" 【1000点门派忠诚度：1颗】可供应："+(int)me->query("csd")+"颗"HIY" 

          3.人仙丹(rxd)"HIG" 【1000点门派忠诚度：1颗】可供应："+(int)me->query("rxd")+"颗"HIY"  

          4.地仙丹(dxd)"HIG" 【1000点门派忠诚度：1颗】可供应："+(int)me->query("dxd")+"颗"HIY" 
 
          5.天仙丹(txd)"HIG" 【1000点门派忠诚度：1颗】可供应："+(int)me->query("txd")+"颗"HIY"  

          6.灵仙丹(lxd)"HIG" 【1000点门派忠诚度：1颗】可供应："+(int)me->query("lxd")+"颗"HIY" 

          7.鸿蒙丹(hmd)"HIG" 【1000点门派忠诚度：1颗】可供应："+(int)me->query("hmd")+"颗"HIY"  

          8.混沌丹(hdd)"HIG" 【1000点门派忠诚度：1颗】可供应："+(int)me->query("hdd")+"颗"HIY" 

          9.度劫丹(djd)"HIG" 【8000点门派忠诚度：1颗】可供应："+(int)me->query("djd")+"颗"HIY"  

         "HIR"注：由于仙丹炼制不易且耗时甚久，目前可供兑换的仙丹，度劫丹每天只供应1颗，其余仙丹每3个时辰供应1颗。
          
"HIG"\n───────────────────────────────────────────\n"NOR"",who,me);
  return 1;
}

int do_yao(string arg)
{
string err;
        string type;
      object newitem, killer;
      object me = this_object();
        object ob;
        object who=this_player();
    if (!arg)
              return notify_fail("你想兑换什么？请用list查看兑换物品列表，用duihuan xxxx来兑换需要物品。\n");
            if(sizeof(all_inventory(who)) > 35 )
                return notify_fail("你身上物品太多了，清理下再来吧。 \n");

        else 
        {
                sscanf(arg,"%s",type);
                        switch(type)
                        {
                        case "baoshi":
                           if (who->query("faith")<5)
                            return notify_fail("你的荣誉度不够! \n");
                                ob=new("/d/npc/vr_room/obj/baoshi.lpc");
                                if (objectp(ob)) 
                            {
                            ob->move(who);
                            who->add("faith",-5);
                                tell_object(who,"你用5点师徒荣誉值向兑换师换取了一颗"+ob->query("name")+"！\n");
                               }
                                break;
                        case "baoshi1":
                           if (who->query("faith")<100)
                            return notify_fail("你的荣誉度不够! \n");
                                ob=new("/d/npc/vr_room/obj/bs_tj.lpc");
                                if (objectp(ob)) 
                            {
                            ob->move(who);
                            who->add("faith",-100);
                                tell_object(who,"你用100点师徒荣誉值向兑换师换取了一颗"+ob->query("name")+"！\n");
                               }
                                break;
                        case "baoshi2":
                           if (who->query("faith")<100)
                            return notify_fail("你的荣誉度不够! \n");
                                ob=new("/d/npc/vr_room/obj/bs_fsl.lpc");
