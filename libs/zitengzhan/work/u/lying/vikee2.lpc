                               }
                                break;
                        case "item":
                           if (who->query("faith")<100)
                            return notify_fail("你的荣誉度不够! \n");
                           killer=who;
                           killer->set_temp("mieyao/level",12);
                           err=catch(newitem=NEWITEMS_OB->get_item(me,killer));
                           newitem->move(killer);
                          tell_object(killer, "你用100点师徒荣誉值向兑换师换取了一"+newitem->query("unit")+newitem->query("name")+"。\n"NOR);
                           who->add("faith",-100);
