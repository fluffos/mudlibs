#include <ansi.h>
#include <weapon.h>
inherit SPEAR;

string *first_name = ({ "裂天", "破天", "逆天", "神魔", "混沌" });
string *first_id = ({ "lietian", "potian", "nitian", "shenmo", "hundun" });
string *name_words = ({ "神枪", "魔枪", "魔戟", "神戟", "灵枪", "灵戟" });
string *id_words = ({ "spear", "spear", "spear", "spear", "spear", "spear" });

void create() {
  string name;
  int d, p;
  d = random(sizeof(first_name));
  name = first_name[d];
  p = random(sizeof(name_words));
  name += name_words[p];
  set_name(BLINK + HIW + name + NOR, ({ first_id[d] + " " + id_words[p] }));
  set_weight(60);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "这是传说中能刺穿天地的神兵。\n");
    set("material", "steel");
    set("value", 1);
    set("wield_msg", "$N两指微弹，$n划破长空，飘然跃入$N手中！\n");
    set("unwield_msg", "$N的$n已悄然收起。\n");
  }
  init_spear(150 + random(50));
  setup();
}
