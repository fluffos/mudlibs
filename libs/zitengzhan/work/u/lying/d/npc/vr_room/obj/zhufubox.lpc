#include <ansi.h>
inherit ITEM;

int do_open(string);
void create()
{
 set_name(HIG "祝福宝箱" NOR, ({"zhufu box", "box"}));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "一只充满魔力的神奇宝箱，你可以打开(open)它试试运气。\n");
    set("no_sell", 1);
    set("no_give", 1);
  }
   setup();
}

void init()
{
	add_action("do_open", "open");
}

int do_open(string arg)
{
  object ob = this_object();
  object me = this_player();
  object qs;
  int i, exp, dx, pot;
  exp = 7000+random(5000);
  dx = 5000+random(4000);
  pot = 3000+random(3000);  
  if (!id(arg))
    return notify_fail("你要打开什么？\n");
 i = random(10);
if (i == 1)
    {
           message_vision(HIW"$N身手往"HIG"祝福宝箱"HIW"里使劲的摸，一会儿摸出一件东西藏进了怀里。\n"NOR, me);  
           qs = new ("/d/npc/vr_room/obj/book3");
           qs->move(me);
           tell_object(me, HIM"你得到了一本"HIW"顶级修仙秘籍"HIM"的奖励。\n"NOR); 
 message("channel:rumor",HIW+"【奖励信息】兑换使者"HIC"："+me->query("name")+"打开了"+ob->query("name")+" "HIC"得到了一本"HIW"顶级修仙秘籍"HIC"！\n"+NOR,users());
      }

i = random(10);
if (i == 1)
    {
           message_vision(HIW"$N身手往"HIG"祝福宝箱"HIW"里使劲的摸，一会儿摸出一件东西藏进了怀里。\n"NOR, me);  
           qs = new ("/d/npc/vr_room/obj/bs_g1");
           qs->move(me);
           tell_object(me, HIM"你得到了一颗"HIG"绿宝石"HIM"的奖励。\n"NOR); 
 message("channel:rumor",HIW+"【奖励信息】兑换使者"HIC"："+me->query("name")+"打开了"+ob->query("name")+" "HIC"得到了一颗"HIG"绿宝石"HIC"！\n"+NOR,users());
      }

i = random(10);
if (i == 1)
    {
           message_vision(HIW"$N身手往"HIG"祝福宝箱"HIW"里使劲的摸，一会儿摸出一件东西藏进了怀里。\n"NOR, me);  
           qs = new ("/d/npc/vr_room/obj/bs_y1");
           qs->move(me);
           tell_object(me, HIM"你得到了一颗"HIY"黄宝石"HIM"的奖励。\n"NOR); 
 message("channel:rumor",HIW+"【奖励信息】兑换使者"HIC"："+me->query("name")+"打开了"+ob->query("name")+" "HIC"得到了一颗"HIY"黄宝石"HIC"！\n"+NOR,users());
      }

i = random(30);
if (i == 1)
    {
           message_vision(HIW"$N身手往"HIG"祝福宝箱"HIW"里使劲的摸，一会儿摸出一件东西藏进了怀里。\n"NOR, me);  
           qs = new ("/d/npc/vr_room/obj/bs_b1");
           qs->move(me);
           tell_object(me, HIM"你得到了一颗"HIW"天晶石"HIM"的奖励。\n"NOR); 
 message("channel:rumor",HIW+"【奖励信息】兑换使者"HIC"："+me->query("name")+"打开了"+ob->query("name")+" "HIC"得到了一颗"HIW"天晶石"HIC"！\n"+NOR,users());
      }

  i = random(4);
  if (i>3) i=3;
   switch(i)
  {
          case 0:                     
           message_vision(HIW"$N打开"HIG"祝福宝箱"HIW"，顿时觉得神清气爽，似乎潜能有所增加。\n"NOR, me);  
           me->add("potential", pot);
           tell_object(me, HIM"你得到了"+chinese_number(pot)+"点潜能的奖励。\n"NOR);
           destruct(this_object());break;
         case 1:
            message_vision(HIW"$N打开"HIG"祝福宝箱"HIW"，顿时觉得神清气爽，似乎武学有所增加。\n"NOR, me);  
           me->add("combat_exp", exp);
           tell_object(me, HIM"你得到了"+chinese_number(exp)+"点武学的奖励。\n"NOR);
           destruct(this_object());break;
          case 2:
            message_vision(HIW"$N打开"HIG"祝福宝箱"HIW"，顿时觉得神清气爽，似乎道行有所增加。\n"NOR, me);  
           me->add("daoxing", dx);
           tell_object(me, HIM"你得到了"+COMBAT_D->chinese_daoxing(dx)+"点道行的奖励。\n"NOR);
           destruct(this_object());break;
         case 3:
            message_vision(HIW"$N打开"HIG"祝福宝箱"HIW"，顿时眼前一亮，一枚闪闪发光的宝石跳了出来。\n"NOR, me);  
           qs = new ("/d/npc/vr_room/obj/baoshi");
           qs->move(me);
           tell_object(me, HIM"你得到了一枚原石的奖励。\n"NOR); 
           destruct(this_object());break;
          default: return 0;
  }

 

  return 1;
}

