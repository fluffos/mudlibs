int do_block(string arg)
{
    object me=this_object();
    object who=this_player();
    string verb=query_verb();

    int t;
         
    if(!userp(who)&&wizardp(who)) return 0;

    if(verb!="go" &&
	    verb!="fly" &&
	    !(environment() && environment()->query("exits/" + verb)))
	return 0;
       
    t = 0;    
    t = who->query_temp("passmaze");
   if (t > 0)
         {        
        message_vision(HIY"$n身上发出万丈光芒，$N顿时被照的晕头转向，$n趁机溜了过去。\n"NOR,me,who);
        who->add_temp("passmaze",-1);
        return 0;
    }
          
        tell_object(who,HIM""+me->name()+"身子一晃，堵住了你的去路！\n"NOR);
        return 1;
}


void die ()
{
  string owner;
  string str,err;
  string msg;
  object owner_ob,newitem;
  object me = this_object();
  object ob = query_temp("my_killer");
  object killer = query_temp("last_damage_from");
  object qs;
  int exp,dao,pot;
  exp = me->query("combat_exp") / 20000;
  dao = exp*3/4;
  pot = exp/3;
  owner_ob = ob; 
  ob->add("combat_exp",exp);
  ob->add("daoxing",dao);
  ob->add("potential",pot);
  message_vision (HIY"$N被砍的支离破碎，喀嚓一下倒在地上爬不起来了。\n"NOR,me);

  if (random(2) == 1)
   {
  qs = new ("/d/npc/vr_room/0001/obj/guci.lpc");
  qs->move(environment (me));
  message_vision ("\n"HIY"       喀嚓一声脆响，$N被你打落了一根$n"HIY"掉在地上！\n"NOR,me,qs);
   }

 if (random(10) > 5)  //产生装备的百分比
	 {
            ob->set_temp("mieyao/level",8+random(4));
	     if (killer) err=catch(newitem=NEWITEMS_OB->get_item(me,killer));
	     if (!err&&newitem) 
	     {
		message_vision("$N丢下了一"+newitem->query("unit")+newitem->query("name")+"。\n",me);
		newitem->move(environment(me));
	     }
	 }	    

tell_object(owner_ob, HIM"你得到了"+chinese_number(exp)
			    +"点武学经验和"+chinese_number(pot)+
			    "点潜能、"+COMBAT_D->chinese_daoxing(dao)+"道行!\n"NOR);

if (random(100) == 1)
   {
  qs = new ("/d/npc/vr_room/obj/ztstone");
  qs->move(killer);
  message_vision ("\n"HIW"       叮的一声，$N爆出一块$n"HIW"落到了"+killer->query("name")+"的身上！\n"NOR,me,qs);
 message("channel:rumor",HIC+"【副本信息】迷宫精灵："+killer->query("name")+"杀死了"+me->query("name")+"得到了"HIM"紫藤宝石"HIC"！\n"+NOR,users());
   }


if (random(1000) == 1)
   {
  qs = new ("/d/npc/vr_room/obj/stone");
  qs->move(killer);
  message_vision ("\n"HIW"       叮的一声，$N爆出一块$n"HIW"落到了"+killer->query("name")+"的身上！\n"NOR,me,qs);
 message("channel:rumor",HIC+"【副本信息】迷宫精灵："+killer->query("name")+"杀死了"+me->query("name")+"得到了"HIW"生命宝石"HIC"！\n"+NOR,users());
   }

if (random(500) == 1)
   {
  qs = new ("/d/npc/vr_room/obj/bs_g1");
  qs->move(killer);
  message_vision ("\n"HIW"       叮的一声，$N爆出一块$n"HIW"落到了"+killer->query("name")+"的身上！\n"NOR,me,qs);
 message("channel:rumor",HIC+"【副本信息】迷宫精灵："+killer->query("name")+"杀死了"+me->query("name")+"得到了"HIG"绿宝石"HIC"！\n"+NOR,users());
   }

if (random(500) == 1)
   {
  qs = new ("/d/npc/vr_room/obj/bs_y1");
  qs->move(killer);
  message_vision ("\n"HIW"       叮的一声，$N爆出一块$n"HIW"落到了"+killer->query("name")+"的身上！\n"NOR,me,qs);
 message("channel:rumor",HIC+"【副本信息】迷宫精灵："+killer->query("name")+"杀死了"+me->query("name")+"得到了"HIY"黄宝石"HIC"！\n"+NOR,users());
   }

if (random(50) == 1)
   {
  qs = new ("/d/npc/vr_room/obj/soulbox");
  qs->move(killer);
  message_vision ("\n"HIW"       叮的一声，$N爆出一只$n"HIW"落到了"+killer->query("name")+"的身上！\n"NOR,me,qs);
 message("channel:rumor",HIC+"【副本信息】迷宫精灵："+killer->query("name")+"杀死了"+me->query("name")+"得到了"HIM"灵魂宝箱"HIC"！\n"+NOR,users());
   }

if (random(100) == 1)
   {
  qs = new ("/d/npc/vr_room/obj/zhufubox");
  qs->move(killer);
  message_vision ("\n"HIW"       叮的一声，$N爆出一只$n"HIW"落到了"+killer->query("name")+"的身上！\n"NOR,me,qs);
 message("channel:rumor",HIC+"【副本信息】迷宫精灵："+killer->query("name")+"杀死了"+me->query("name")+"得到了"HIG"祝福宝箱"HIC"！\n"+NOR,users());
   }

if (random(5) == 1)
   {
  qs = new ("/d/npc/vr_room/obj/baoshi");
  qs->move(killer);
  message_vision ("\n"HIW"       叮的一声，$N爆出一块$n"HIW"落到了"+killer->query("name")+"的身上！\n"NOR,me,qs);
 message("channel:rumor",HIC+"【副本信息】迷宫精灵："+killer->query("name")+"杀死了"+me->query("name")+"得到了"HIR"原石"HIC"！\n"+NOR,users());
   }

destruct(this_object());
  return ;
}


