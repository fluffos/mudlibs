  "大雪山"
});
void set_hp_status(object me);

void create(object ob) {
  object me = this_object();
  string name;
  int i, j, k, d, p;

  d = random(sizeof(first_name));
  name = first_name[d];
  p = random(sizeof(name_words));
  name += name_words[p];
  set_name(HIB + name + NOR, ({ first_id[d] + " " + id_words[p] }));
  k = random(sizeof(mp_choose));
  i = 100;
  j = 100;
  set("family/family_name", mp_choose[k]);

  set("age", 20);
  set("vrm_guard", 1);
  set("gender", random(2) ? "男性" : "女性");
  set("long", "被关入此处的各门派叛徒。\n");
  set("attitude", "aggressive");
  set("class", "xian");
