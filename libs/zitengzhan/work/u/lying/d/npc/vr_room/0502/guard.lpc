#include <ansi.h>
inherit NPC;

string *first_name = ({ "正道", "魔道" });
string *first_id = ({ "maze", "maze" });
string *name_words = ({ "叛徒", "孽徒", "弟子", "罪人" });
string *id_words = ({ "pantu", "nietu", "dizi", "zuiren" });
string *mp_choose = ({
  "五庄观",
  "方寸山三星洞",
  "阎罗地府",
  "火云洞",
  "将军府",
  "昆仑山玉虚洞",
