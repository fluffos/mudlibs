void kill_ob(object ob) {
  object me = this_object();
  set_temp("my_killer", ob);
  ::kill_ob(ob);
}

void init() {
  ::init();
  add_action("do_block", "", 1);
}


void heart_beat() {
  int free, free1, kee_cost, sen_cost, k;
  object guai = this_object();
  object ob = this_object(), newnew;
  object me = query_temp("my_killer");
  ::heart_beat();
  free = (int)query_skill("force") / 40;
  kee_cost = (free - 1) * 100;
  sen_cost = (free1 - 1) * 100;
  k = random(7);
  if (!is_fighting()
    && query_skill("butian-force", 1)
    && query("eff_kee") < query("max_kee")) {
    command("exert xiaobutian");
  }


  if (!is_fighting()
    && !query_skill("zixia-shengong", 1)
    && query("eff_kee") < query("max_kee")) {
    if (query("eff_kee") >= query("max_kee") / 2) {
      command("exert heal");
      command("exert heal");
      command("exert heal");
      command("exert heal");
      command("exert heal");
    } else {
      for (int i = 3; i > 0; i--) {
        carry_object("/d/obj/drug/jinchuang-huarong.lpc"); command("eat jinchuang yao");
      }
    }
  }
  if (!is_fighting()
    && query_skill("zixia-shengong", 1)
    && query("eff_kee") < query("max_kee")) {
    if (query("eff_kee") >= query("max_kee") / 2) {
