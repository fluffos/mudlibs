// tooth.c by xdao

#include <weapon.h>

inherit THROWING;

void create()
{
        set_name("[1;37m蛇牙[2;37;0m", ({"tooth"}));
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long",    "蛇的牙齿，似乎兑换使者正需要它。\n");
                set("unit", "些");
                set("base_unit", "枚");
                set("base_weight", 1);
                set("value", 1);
                set("duihuan",1);
                set("tooth",1);
        }
        set_amount(1);
        init_throwing(20);
        setup();
}

