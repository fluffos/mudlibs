//shizhe by xdao
inherit NPC;
inherit F_VENDOR;

#include <ansi.h> 
string answer_duihuan();


void create()
{
        set_name(HIW"兑换使者"NOR, ({ "duihuan shizhe", "shizhe"}) );
        set("gender", "男性" );
        set("age", 74);
        set("combat_exp", 1000000000);
        set("daoxing", 1000000000);
        set("max_kee", 1000000);
        set("max_sen", 1000000);
        set("vendor_goods", ([
           "pass": "u/lying/d/npc/vr_room/obj/pass",
           "pass1": "u/lying/d/npc/vr_room/obj/pass1",
           "pass2": "u/lying/d/npc/vr_room/obj/pass2",
           "pass3": "u/lying/d/npc/vr_room/obj/pass3",
           "yundan": "u/lying/d/npc/vr_room/obj/yundan",
           "bag": "u/lying/d/npc/vr_room/obj/bag",
           "star" : "u/lying/d/npc/vr_room/obj/luckstar",
        ]) );
        set("long",

"这是神界派来常驻长安城的使者，专门喜欢收集一些稀奇古怪的东西。\n 同时也出售不少罕见的宝物！！\n");
        set("title", BLINK""HIM"祝你好运"NOR);
        set("attitude", "friendly");
       	carry_object("/d/obj/cloth/linen")->wear();

set("inquiry", ([
            "duihuan" : (: answer_duihuan :),
            "兑换" : (: answer_duihuan :),
              ]) );
 setup();
}

string answer_duihuan()
             { 
              object me;
              me = this_player();
              message_vision(HIW"兑换使者"CYN"说道：\n",me);      
              message_vision("          20枚"HIW"蛇牙"CYN"可兑换一个"HIR"红色宝箱"CYN"。\n",me);     
              message_vision("          1枚"HIW"王蛇之牙"CYN"可兑换一个"HIB"蓝色宝箱"CYN"。\n",me);    
              message_vision("          20根"HIW"骨刺"CYN"可兑换一个"HIM"灵魂宝箱"CYN"。\n",me);      
              message_vision("          10份"HIW"天地元气"CYN"可兑换一个"HIM"灵魂宝箱"CYN"。\n",me);     
              message_vision("          5份"HIW"魔灵魂魄"CYN"可兑换一个"HIM"灵魂宝箱"CYN"。\n",me);
              message_vision("          10枚以上"HIM"紫藤宝石"CYN"可兑换一件神秘物品。\n\n",me);
              message_vision("          你如果收集满材料，就直接交给我，多给多送！！\n"NOR,me);

                       }

void init()
{
        object ob;

        ::init();
              add_action("do_vendor_list", "list");
        if( interactive(ob = this_player()) && !is_fighting() ) {
                call_out("greeting", 1, ob);
        }
}

void greeting(object ob)
{
        if( !ob || !visible(ob) || !present(ob, environment(this_object())) ) return;
        say( "兑换使者说道：这位" + RANK_D->query_respect(ob)
                + "，别忙着走，能帮我找些物品嘛？我会给你好处的。\n");
}

int accept_object(object who, object ob)
{
        int val, amount, i, num, j, k, d, max_level, xy, ck, gr;
        object qs;
        string att;
        object me = this_object();
        amount = ob->query_amount();
         
        
         if(ob->query("id") != "tooth"&&ob->query("id") != "bigtooth"&&ob->query("id") != "guci"&&ob->query("id")!= "yuanqi"&&ob->query("id") != "hunpo"&&ob->query("id") != "ziteng stone")
                {
            say( HIW"兑换使者"NOR"说道：这不是我需要的物品！别来糊弄我！\n");
             return notify_fail(HIR"这不是兑换使者需要的物品。\n"NOR);
                }
               
          if( ob->query("id") == "ziteng stone")
                {
          if(amount>=10)
              {
		say( HIW"兑换使者"NOR"说道：多谢这位" + RANK_D->query_respect(who)
                + "，这是我的一份心意，拿着。\n");
             num = amount;
               j=random(9);
               if (j>8) j=8;
               switch(j)
                {
                  case 0:
                  qs = new ("u/lying/d/npc/vr_room/obj/sword");
                  qs->move(me);break;
                  case 1:
                  qs = new ("u/lying/d/npc/vr_room/obj/blade");
                  qs->move(me);break;
                  case 2:
                  qs = new ("u/lying/d/npc/vr_room/obj/fork");
                  qs->move(me);break;
                  case 3:
                  qs = new ("u/lying/d/npc/vr_room/obj/hammer");
                  qs->move(me);break;
                  case 4:
                  qs = new ("u/lying/d/npc/vr_room/obj/whip");
                  qs->move(me);break;
                  case 5:
                  qs = new ("u/lying/d/npc/vr_room/obj/spear");
                  qs->move(me);break;
                  case 6:
                  qs = new ("u/lying/d/npc/vr_room/obj/axe");
                  qs->move(me);break;
                  case 7:
                  qs = new ("u/lying/d/npc/vr_room/obj/stick");
                  qs->move(me);break;
                 case 8:
                  qs = new ("u/lying/d/npc/vr_room/obj/staff");
                 qs->move(me);break;
                  default:
                  qs = new ("u/lying/d/npc/vr_room/obj/mace");
                  qs->move(me);
                    }
            if (random(100)==1)
              {
                  k=random(4);
                  if (k>3) k=3;
                  qs->set("primitive_id",who->query("id"));
                  qs->set("bind_type",k);
                  if (k >= 2) qs->set("bind_id",who->query("id")); 
                   
                  xy= num/10;
                 if(xy>6) xy=6;
                  ck= num/7;
                 if(ck>8) ck=8;
                  gr= num/7;
                  qs->set("durability/max",400+random(300));
                  qs->set("durability/now",400+random(300));
                  qs->set("grade", 13+random(gr));
                  qs->set("unique_code",time()); 
                  qs->set("changed",1);
		    qs->set_name(BLINK+HIY"辉煌的"NOR+qs->query("name"),({qs->query("id")}));
                  qs->set("unbreak",1);
                  qs->set("weapon_prop/damage",300+random(200));
                  qs->set("weapon_prop/luck",6 + random(xy));
                  qs->set("sockets/max",6+random(ck));
                  qs->set("sockets/now",0);

              d=random(5);
              if (d>4) d=4;   
              switch(d)
        	{
        		case  0: att="cold_attack";break;
        		case  1:att="fire_attack";break;
        		case  2:att="lightning_attack";break;
        		case  3:att="poison_attack";break;
        		case  4:att="wind_attack";break;
        		default:att="";
		}
		if (att!="") 
		{			
			max_level=15+random(10);
			if (max_level>25) max_level=25;
			qs->set((att+"/max_level"),max_level);
			qs->set("weapon_prop"+"/"+att,1);
			qs->set((att+"/exp"),0);
		}
               
                  qs->move(who);
          }
          else  if (random(20)==1)
              {
                  k=random(4);
                  if (k>3) k=3;
                  qs->set("primitive_id",who->query("id"));
                  qs->set("bind_type",k);
                  if (k >= 2) qs->set("bind_id",who->query("id")); 
                   
                  xy= num/10;
                 if(xy>5) xy=5;
                  ck= num/7;
                 if(ck>7) ck=7;
                  gr= num/7;
                  qs->set("durability/max",300+random(300));
                  qs->set("durability/now",300+random(300));
                  qs->set("grade", 10+random(gr));
                  qs->set("unique_code",time()); 
                  qs->set("changed",1);
		    qs->set_name(BLINK+HIG"卓越的"NOR+qs->query("name"),({qs->query("id")}));
                  qs->set("unbreak",1);
                  qs->set("weapon_prop/damage",200+random(150));
                  qs->set("weapon_prop/luck",4 + random(xy));
                  qs->set("sockets/max",4+random(ck));
                  qs->set("sockets/now",0);

              d=random(5);
              if (d>4) d=4;   
              switch(d)
        	{
        		case  0: att="cold_attack";break;
        		case  1:att="fire_attack";break;
        		case  2:att="lightning_attack";break;
        		case  3:att="poison_attack";break;
        		case  4:att="wind_attack";break;
        		default:att="";
		}
		if (att!="") 
		{			
			max_level=10+random(10);
			if (max_level>20) max_level=20;
			qs->set((att+"/max_level"),max_level);
			qs->set("weapon_prop"+"/"+att,1);
			qs->set((att+"/exp"),0);
		}
               
                  qs->move(who);
          }

   else
                  {
                  k=random(4);
                  if (k>3) k=3;
                  qs->set("primitive_id",who->query("id"));
                  qs->set("bind_type",k);
                  if (k >= 2) qs->set("bind_id",who->query("id")); 
                   
                  xy= num/10;
                 if(xy>5) xy=5;
                  ck= num/7;
                 if(ck>7) ck=7;
                  gr= num/7;
                  qs->set("durability/max",200+random(300));
                  qs->set("durability/now",200+random(300));
                  qs->set("grade", 7+random(gr));
                  qs->set("unique_code",time()); 
                  qs->set("changed",1);
                  qs->set("unbreak",1);
                  qs->set("weapon_prop/damage",150+random(100));
                  qs->set("weapon_prop/luck",2 + random(xy));
                  qs->set("sockets/max",2+random(ck));
                  qs->set("sockets/now",0);

              d=random(5);
              if (d>4) d=4;   
              switch(d)
        	{
        		case  0: att="cold_attack";break;
        		case  1:att="fire_attack";break;
        		case  2:att="lightning_attack";break;
        		case  3:att="poison_attack";break;
        		case  4:att="wind_attack";break;
        		default:att="";
		}
		if (att!="") 
		{			
			max_level=7+random(6);
			if (max_level>12) max_level=12;
			qs->set((att+"/max_level"),max_level);
			qs->set("weapon_prop"+"/"+att,1);
			qs->set((att+"/exp"),0);
		}
               
                  qs->move(who);
          }

    message_vision ("\n "HIW"       兑换使者"HIM"，给了"+who->query("name")+"一把"+qs->query("name")+" "HIM"！\n"NOR,me,qs);
 message("channel:chat",HIW+"【奖励信息】兑换使者"HIC"："+who->query("name")+"凑齐"+chinese_number(num)+"颗"+ob->query("name")+" "HIC"给予一把"+qs->query("name")+""HIC"的奖励！\n"+NOR,users()); 
    call_out("destroy", 1, ob);
               }
         else
              {
             say( HIW"兑换使者"NOR"说道：才这么点"HIM"紫藤宝石"NOR"？至少需要10颗才够兑换。\n");
             return notify_fail(HIR"才这么点紫藤宝石？至少需要10颗才够兑换。\n"NOR);
                           }
                  return 1;
                 }

         if( ob->query("id") == "hunpo")
                {
          if(amount>=5)
              {
		say( HIW"兑换使者"NOR"说道：多谢这位" + RANK_D->query_respect(who)
                + "，这是我的一份心意，拿着。\n");
             num = amount/5;
             for (i=0;i<num;i++)
               {
             qs = new ("u/lying/d/npc/vr_room/obj/soulbox");
             qs->move(who);
                }
    message_vision ("\n"HIW"       兑换使者"HIM"，给了"+who->query("name")+" "+chinese_number(num)+"个"HIM"灵魂宝箱"HIM"！\n"NOR,me,qs);
     call_out("destroy", 1, ob);
               }
         else
              {
             say( HIW"兑换使者"NOR"说道：才这么点"HIW"魔灵魂魄"NOR"？至少需要10份才够兑换。\n");
             return notify_fail(HIR"才这么点魔灵魂魄？至少需要10份才够兑换。\n"NOR);
                           }
                  return 1;
                 }

         if( ob->query("id") == "yuanqi")
                {
          if(amount>=10)
              {
		say( HIW"兑换使者"NOR"说道：多谢这位" + RANK_D->query_respect(who)
                + "，这是我的一份心意，拿着。\n");
             num = amount/10;
             for (i=0;i<num;i++)
               {
             qs = new ("u/lying/d/npc/vr_room/obj/soulbox");
             qs->move(who);
                }
    message_vision ("\n"HIW"       兑换使者"HIM"，给了"+who->query("name")+" "+chinese_number(num)+"个"HIM"灵魂宝箱"HIM"！\n"NOR,me,qs);
        call_out("destroy", 1, ob);        
      }
         else
              {
             say( HIW"兑换使者"NOR"说道：才这么点"HIW"天地元气"NOR"？至少需要10份才够兑换。\n");
             return notify_fail(HIR"才这么点天地元气？至少需要10份才够兑换。\n"NOR);
                           }
                  return 1;
                 }

         if( ob->query("id") == "tooth")
                {
          if(amount>=20)
              {
		say( HIW"兑换使者"NOR"说道：多谢这位" + RANK_D->query_respect(who)
                + "，这是我的一份心意，拿着。\n");
             num = amount/20;
             for (i=0;i<num;i++)
               {
             qs = new ("u/lying/d/npc/vr_room/obj/redbox");
             qs->move(who);
                }
    message_vision ("\n"HIW"       兑换使者"HIM"，给了"+who->query("name")+" "+chinese_number(num)+"个"HIR"红色宝箱"HIM"！\n"NOR,me,qs);
    call_out("destroy", 1, ob);             
                }
         else
              {
             say( HIW"兑换使者"NOR"说道：才这么点"HIW"蛇牙"NOR"？至少需要20枚才够兑换。\n");
             return notify_fail(HIR"才这么点蛇牙？至少需要20枚才够兑换。\n"NOR);
                           }
                  return 1;
                 }

          if( ob->query("id") == "guci")
                {
          if(amount>=20)
              {
		say( HIW"兑换使者"NOR"说道：多谢这位" + RANK_D->query_respect(who)
                + "，这是我的一份心意，拿着。\n");
             num = amount/20;
             for (i=0;i<num;i++)
               {
             qs = new ("u/lying/d/npc/vr_room/obj/soulbox");
             qs->move(who);
                }
    message_vision ("\n"HIW"       兑换使者"HIM"，给了"+who->query("name")+" "+chinese_number(num)+"个"HIM"灵魂宝箱"HIM"！\n"NOR,me,qs);
    call_out("destroy", 1, ob);
               }
         else
              {
             say( HIW"兑换使者"NOR"说道：才这么点"HIW"骨刺"NOR"？至少需要20根才够兑换。\n");
             return notify_fail(HIR"才这么点骨刺？至少需要20根才够兑换。\n"NOR);
                           }
                  return 1;
                 }

          if( ob->query("id") == "bigtooth" )
                    {
		say( HIW"兑换使者"NOR"说道：多谢这位" + RANK_D->query_respect(who)
                + "，这是我的一份心意，拿着。\n");
             num = amount;
             for (i=0;i<num;i++)
               {
             qs = new ("u/lying/d/npc/vr_room/obj/bluebox");
             qs->move(who);
               }
    message_vision ("\n"HIW"       兑换使者"HIM"，给了"+who->query("name")+" "+chinese_number(num)+"个"HIB"蓝色宝箱"HIM"！\n"NOR,me,qs);
              call_out("destroy", 1, ob);
        }
        return 1;

}

void destroy(object ob)
{
destruct(ob);
return;
}

