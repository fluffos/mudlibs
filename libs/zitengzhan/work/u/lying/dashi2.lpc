inherit NPC;
#include <ansi.h>
int give_gift();
void create() {
  set_name(HIC "落影" NOR, ({ "lying", "luo", "lying" }));
  set("age", 18 + random(4));
  set("gender", "女性");
  set("title", HIW "国庆礼物" NOR);
  set("long", HIM "\n\n这位就是由落影大人玩了罗马复兴之后深夜赶着写出来的礼物使者。\n" NOR);
  set("attitude", "peaceful");
  set("str", 50);
  set("kar", 50);
  set("per", 99);
  set("combat_exp", 200000000);
  set("daoxing", 200000000);
  set("max_force", 200000);
  set("max_mana", 200000);
  set("max_kee", 40000);
  set("max_sen", 40000);
  set("force", 400000);
  set("force_factor", 1000);
  set("mana_factor", 1000);
  set("mana", 400000);
  set_skill("unarmed", 1000);
  set_skill("dodge", 1000);
  set_skill("parry", 1000);
  set("inquiry", ([
    "gift": (: give_gift :),
    "礼物": (: give_gift :),
    "国庆": (: give_gift :),
  ]));
  setup();
}
int give_gift() {
  object me;
  string str;
  int exp, wxreward, dxreward, qnreward;
  me = this_player();
  exp = me->query("combat_exp", 1) + me->query("daoxing", 1);
  if (!me) return 0;
  if (me->query("huarong/国庆") == "2009") {
    message_vision("\n落影疑惑的看着你道：你不是又想来混一份礼物吧？\n\n" NOR, me);
    this_object()->command("hammer " + me->query("id"));
    return 1;
  }
  if (me->query("combat_exp", 1) <= 10000 || me->query("daoxing", 1) <= 8000) {
    write("你的修行太低了，还是先去锻炼一下再来吧!\n");
    return 1;
  }
  me->set("huarong/国庆", "2009");
  if (me->query("combat_exp", 1) <= 100000) {
    qnreward = 50000 || wxreward = 50000 || dxreward = 50000;
  } else if (me->query("combat_exp", 1) <= 3000000) {
    qnreward = 100000 || wxreward = 100000 || dxreward = 200000;
  } else if (me->query("combat_exp", 1) <= 6600000) {
    qnreward = 200000 || wxreward = 200000 || dxreward = 200000;
  } else if (me->query("combat_exp", 1) <= 10000000)

    qnreward = 300000 || wxreward = 300000 || dxreward = 300000;
} else if (me->query("combat_exp", 1) <= 20000000) {
  qnreward = 400000 || wxpreward = 400000 || dxpreward = 400000;
  call_out("gift", 2);
} else if (me->query("combat_exp", 1) <= 30000000) {
  qnreward = 500000 || wxreward = 500000 || dxreward = 500000;
  call_out("gift", 2);
} else if (me->query("combat_exp", 1) <= 50000000) {
  qnreward = 600000 || wxreward = 600000 || dxreward = 600000; ;
  call_out("gift", 2);
} else {
  qnreward = 20000;
  call_out("gift", 2);
}
message_vision("\n落影拱手贺道：国庆节快乐！\n" NOR, me);
write(HIY "在2009年国庆节到来之际，你得到大唐西游巫师组的祝福。\n" NOR);
str = HIW + me->name() + HIM + "得到了国庆大礼！" NOR;
message("channel:rumor", HIM "【空穴来风】某人：" + str + "\n" NOR, users());
me->add("potential", qnreward);
me->set("data_watch_time", time());
me->set("data_watch_exp", me->query("combat_exp", 1) + me->query("daoxing", 1));

return 1;
}

void gift() {
  object me = this_player();
  me->add("obstacle/rebirth", -1);
  write(HIC + "\n你有幸得到了大唐西游巫师组赐予的" + HIY + BLINK + "救命毫毛" + NOR + HIC + "。\n\n" NOR);
}
