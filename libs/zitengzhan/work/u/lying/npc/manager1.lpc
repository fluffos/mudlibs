#include <ansi.h>
int gift();
int gift1();
int gift2();
inherit NPC;
void create() {
  set_name(HBBLU "客户服务中心经理" NOR, ({ "manager", "kehu jingli" }));
  set("title", HIW "大唐西游" NOR);
  set("long", HIR "\n一身的制服打扮。\n
  她正坐在办公桌前点着金币呢。\n" NOR + HIG "\n 
  ask manager about vip   用vip值换取金币。\n 
  ask manager about qicai 用七彩解密值换取经验。\n 
\n" NOR);
  set("gender", "女性");
  set("age", 25);
  set("attitude", "heroism");
  set("per", 32);
  set("max_kee", 5000);
  set("max_gin", 5000);
  set("max_sen", 5000);
  set("force", 6000);
  set("max_force", 12000);
  set("force_factor", 300);
  set("max_mana", 7000);
  set("mana", 16000);
  set("mana_factor", 350);
  set("combat_exp", 2400000);
  set("daoxing", 6800000);
  set("inquiry", ([
    "name": "我就是天上人间II的客户服务中心经理，你可以选择用你的vip或者七彩数来兑换。\n",
    "兑换规则": "兑换规则为: 1 点vip可以兑换2枚jinbi。\n
                            20点七彩值可以兑换5万经验值\n
                            30m武学可以换大闹天宫和西天取经\n",
    "vip": (: gift :),
    "qicai": (: gift1 :),
    "gift": (: gift2 :),
  ]));
  setup();
}

int gift() {
  string str;
  object who = this_player();

  if (this_player()->query("vip") < 1) {
    message_vision("客户服务经理对着$N说：“你都没有vip值，怎么帮你换呢。”\n", who);
    return 1;
  } else {
    str = who->name();  //update by ken,防止刷屏和过分写文件
    //message("channel:chat",HIC"大唐西游："+str+"通过vip换取2枚金币,已经成功受理。\n"NOR,users());
    //message("channel:rumor",HIM"大唐西游："+str+"通过vip换取2枚金币,已经成功受理。\n"NOR,users());
    message_vision("客户服务经理娴熟地办理了你的业务，对$N说：“手续办完了。”\n\n" HIC "$N得到了2枚金币，已经存入你的银行户头,请查收。\n" NOR, who);
    who->add("c_balance", 20000000);
    who->add("vip-jinbi", 1);
    who->add("vip", -1);
    //log_file("duihuan", sprintf("%s(%s) duihuan jinbi 时间 %s\n",   who->name(1), geteuid(who),ctime(time()) ) );
    return 1;
  }
}

int gift1() {
  string str;
  object who = this_player();

  if (this_player()->query("qicai") < 20) {
    message_vision("客户服务经理对着$N说：“你都没有那么多七彩解密值，怎么帮你换呢。”\n", who);
    return 1;
  } else {
    str = who->name();
    //message("channel:chat",HIC"大唐西游："+str+"通过七彩解密值换取五万经验,已经成功受理。\n"NOR,users());
    //message("channel:rumor",HIM"大唐西游："+str+"通过七彩解密值换取五万经验,已经成功受理。\n"NOR,users());
    message_vision("客户服务经理娴熟地办理了你的业务，对$N说：“手续办完了。”\n\n" HIC "$N得到了五万经验，请核对你的状态。\n" NOR, who);
    who->add("combat_exp", 50000);
    who->add("qicai-exp", 1);
    who->add("qicai", -20);
    //log_file("duihuan",                        sprintf("%s(%s) duihuan exp 时间 %s\n",                                who->name(1), geteuid(who),ctime(time()) ) );
    return 1;
  }
}
int gift2() {
  string str;
  object who = this_player();
  object ob = this_object();
  if (this_player()->query("ziyougift") == "got") {
    message_vision("客户服务经理对着$N说：“你都没有武学和道行那么多次，怎么帮你换呢。”\n", who);
    return 1;
  } else {
    str = who->name();
    message("channel:chat", HIC " 大唐西游：" + str + "通过30m武学可以换大闹天宫和西天取经,已经成功受理。\n" NOR, users());
    message("channel:rumor", HIM "大唐西游：" + str + "通过30m武学可以换大闹天宫和西天取经。\n" NOR, users());
    message_vision("客户服务经理娴熟地办理了你的业务，对$N说：“手续办完了。”\n\n" HIC "$N得到了大闹天宫和西天取经，请核对你的状态。\n" NOR, who);
    who->add("obstacle", 26);
    who->add("dntg", 10);
    who->add("combat_exp", 30000000);
    who->add("道行", 15000000);
    log_file("duihuan",
      sprintf("%s(%s) duihuan qujing 时间 %s\n",
        who->name(1), geteuid(who), ctime(time())));
    return 1;
  }
}
