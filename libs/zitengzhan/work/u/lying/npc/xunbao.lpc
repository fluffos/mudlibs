#include <ansi.h>
inherit F_VENDOR;
inherit NPC;
void create() {
  set_name(HIY "寻宝专家" NOR, ({ "xunbao zhuanjia", "zhuanjia", "master" }));
  set("long",
    YEL "专业的寻宝者，从他这里你能买到非同寻常的东西\n");
  set("gender", "男性");
  set("per", 23);
  set("age", 36);
  set("attitude", "friendly");
  set("shen_type", 1);
  set_skill("unarmed", 35);
  set_skill("dodge", 30);
  set_skill("parry", 35);
  set("vendor_goods", ([
    "huangjin shengyi": "/d/obj/gold_cloth",
    "qiong cao": "/d/obj/cao",
    "ping": "/d/wuxing/obj/ping",
    "tangsengrou": "/d/obj/drug/tangsengrou",
    //              "card": "u/lying/obj/card",
    "staff": "/d/penglai/npc/obj/gg",
    //                "dan": "u/lying/psd.lpc",
    "old paper": "/u/rocky/titlepai.lpc",
    "jin nang": "/u/rocky/titlepai2.lpc",
    "ztstone": "d/npc/vr_room/obj/ztstone.lpc",
    "huantong": "u/zlga/huantongdan.lpc",
    //               "feitan": "/d/xingji/feitan.lpc",


  ]));
  setup();
  carry_object("/d/obj/cloth/choupao")->wear();

}
void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
}

void greeting(object ob) {
  if (!ob || !visible(ob) || environment(ob) != environment()) return;
  switch (random(1)) {
    case 0:
      //                        message_vision("神农氏看了看$N，又去干自己的事情去了。\n",ob);
      break;
  }
}
