#include <ansi.h>

int gift();
int zjpfm();

inherit NPC;

void create() {
  set_name(HIW "过关奖励大使" NOR, ({ "jiangli dashi" }));
  set("title", HIC "大唐西游" NOR);
  set(
    "long",
    HIW "\n一位娇柔万分的女子，伶俐地扭动着腰肢。\n手举自由火把，有关于自由的事，可以问问她。\n" NOR + HIC "\n ask dashi about gift 拿取取经完成大闹天宫过关的奖励。\n\n" NOR
  );
  set("gender", "女性");
  set("age", 16);
  set("attitude", "heroism");
  set("per", 32);
  set("max_kee", 5000);
  set("max_gin", 5000);
  set("max_sen", 5000);
  set("force", 6000);
  set("max_force", 12000);
  set("force_factor", 300);
  set("max_mana", 7000);
  set("mana", 16000);
  set("mana_factor", 350);
  set("combat_exp", 2400000);
  set("daoxing", 6800000);
  set("inquiry", ([
    "gift": (: gift :),
    "奖励": (: gift :),
    //  "终极pfm" : (:zjpfm:),
  ]));
  setup();
}

int gift() {
  string str;
  object who = this_player();
  object ob = this_object();
  if (this_player()->query("ziyougift") == "got") {
    message_vision("过关大使对着$N说：“你已经拿过了，做人不要太贪心好。”\n", who);
    return 1;
  } else if (this_player()->query("obstacle/number") < 26) {
    message_vision("礼物大使对着$N说：“你西天取经还没有完成，请多加努力。”\n", who);
    return 1;
  } else if (this_player()->query("dntg/number") < 10) {
    message_vision("礼物大使对着$N说：“你大闹天宫还没有完成，成功在向你招手啊。”\n", who);
    return 1;
  } else if (this_player()->query("9sky/number") < 9) {
    message_vision("礼物大使对着$N说：“你9重天还没有完成，成功在向你招手啊。”\n", who);
    return 1;
  } else if (this_player()->query("12gong/number") < 10) {
    message_vision("礼物大使对着$N说：“你十二宫还没有完成，成功在向你招手啊。”\n", who);
    return 1;
  } else if (this_player()->query("mingjie/number") < 15) {
    message_vision("礼物大使对着$N说：“你冥界还没有完成，成功在向你招手啊。”\n", who);
    return 1;
  } else {
    str = who->name();
    message(
      "channel:chat",
      HIC "【大唐西游】礼物大使：" + str + "已经过西天取经、大闹天宫、冥界、十二宫、9重天等难关，特此奖励。\n" NOR,
      users()
    );
    message(
      "channel:rumor",
      HIM "【谣言】礼物大使：" + str + "已经过西天取经、大闹天宫、冥界、十二宫、9重天等难关，特此奖励。\n" NOR,
      users()
    );
    message_vision(
      "礼物大使举起火把，往$N头上轻轻一挨，对$N说：“你已经过西天取经、大闹天宫等难关，特此奖励。”\n\n" HIC "$N得到50万武学、500年道行、50万潜能、3000两黄金、所有基本属性加2点的奖励。\n" NOR,
      who
    );
    who->add("combat_exp", 500000);
    who->add("daoxing", 500000);
    who->add("potential", 500000);
    who->add("balance", 30000000);
    who->add("str", 2);
    who->add("cor", 2);
    who->add("int", 2);
    who->add("spi", 2);
    who->add("cps", 2);
    who->add("per", 2);
    who->add("con", 2);
    who->add("kar", 2);
    who->set("ziyougift", "got");
    return 1;
  }
}


int zjpfm() {
  string str;
  object who = this_player();
  object ob = this_object();
  if (this_player()->query("zjpfm")) {
    command("say 都问过了还问那么多，找死啊!\n");
    return 1;
  } else if (this_player()->query("叛师")) {
    command("say 去死，你这叛徒!\n");
    return 1;
  }

  else if (this_player()->query("quest/number") < 5000) {
    command("say 你去做五千个解谜任务再来吧。\n");
    return 1;
  } else {
    command("say 好吧，我允许你用那个招数了!\n");
    this_player()->set("zjpfm", 1);
    return 1;
  }

}
