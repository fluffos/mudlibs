COMBAT_D->report_sen_status(me);
me->heart_beat();  //立刻召唤心跳判断死亡
call_out("finish",1,me);
 }
else call_out("finish",1,me);
}

void finish2(object me)
{
if(!me) return;
 message("system",HIW"〖"+HIR+"度雷劫"+HIW+"〗"+HIY+"天空中劫云渐渐消散，"+me->query("name")+"度劫失败了。\n"NOR,users());
 me->delete_temp("dujie_begin");
 me->delete_temp("no_move");
}

void finish(object me)
{
int level,i;
if(!me) return;
 if(me->is_ghost()) {
  call_out("finish2",0,me); 
  return;
                    }
me->add("dujie/level",1);
 me->delete_temp("dujie_begin");
 me->delete_temp("no_move");
level = (int)me->query("dujie/level");
 message("system",HIW"〖"+HIR+"度雷劫"+HIW+"〗"+HIY+"天空中劫云渐渐消散,铺天盖地的威压也随之而去。\n"NOR,users());
 message("system",HIW"〖"+HIR+"度雷劫"+HIW+"〗"+HIY+""+me->query("name")+"屹立在虚空之中哈哈大笑：区区雷劫怎能难道我！\n"NOR,users());
 message("system",HIW"〖"+HIR+"度雷劫"+HIW+"〗"+HIY+""+me->query("name")+"度过第"+level+"次雷劫啦！\n"NOR,users());
 i= random(3);
 if (i > 2) i = 2;
 switch(i)
   {
  case 0:
      me->add("dujie/time",1); //掌控时间
     if((int)me->query("dujie/time") == 1)
     tell_object(me, HIC "恭喜你！由于你力抗天劫,领悟了时间法则。\n" NOR);
     else tell_object(me, HIC "恭喜你！由于你力抗天劫,你对时间法则更加精通了。\n" NOR);break;
  case 1:
      me->add("dujie/life",1); //掌控生命
     if((int)me->query("dujie/life") == 1)
     tell_object(me, HIC "恭喜你！由于你力抗天劫,领悟了生命法则。\n" NOR);
     else tell_object(me, HIC "恭喜你！由于你力抗天劫,你对生命法则更加精通了。\n" NOR);break;
  case 2:
      me->add("dujie/power",1); //掌控毁灭
     if((int)me->query("dujie/power") == 1)
     tell_object(me, HIC "恭喜你！由于你力抗天劫,领悟了毁灭法则。\n" NOR);
     else tell_object(me, HIC "恭喜你！由于你力抗天劫,你对毁灭法则更加精通了。\n" NOR);break;
    }
me->save();

}



int help(object me)
{
        write(@HELP
指令格式 : dujie

度过雷劫提高自身素质。
HELP
        );
        return 1;
}
