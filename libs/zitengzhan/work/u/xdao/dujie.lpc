
#include <ansi.h>

int main(object me, string arg)
{
	int level, damage,kdamage,sdamage;
	object where;

	seteuid(getuid());
	where = environment(me);
	level = 0;
       if(me->query("dujie/level")) level = (int)me->query("dujie/level");
       level += 1;       

	if(!userp(me))
	     return notify_fail("战役中不能度劫。\n");

	if(where->query("no_fight") || where->query("no_magic") )
	     return notify_fail("安全区内禁止度劫。\n");

	if(me->query_temp("hgs_begin") )
	     return notify_fail("战役中不能度劫。\n");

	if(me->query_temp("ljs_begin") )
	     return notify_fail("战役中不能度劫。\n");

	if(me->is_ghost())
	     return notify_fail("先还阳去吧。\n");
	
	if (me->is_busy() || me->query_temp("dujie_begin"))
  	return notify_fail("你现在正忙着呢。\n");

	if( me->is_fighting() )
		return notify_fail("战斗中度劫，找死啊？！\n");

	if( (int)me->query("dujie/level") > 8 )
		return notify_fail("你已度过九次雷劫，不需要再度了！\n");

        if( ((int)me->query("combat_exp") + (int)me->query("daoxing")) < 20000000*level )
		return notify_fail("以你目前的修为还感应不到雷劫！\n");

       damage = 5000; //基础伤害暂定为5000
       kdamage = damage+(int)me->query("max_kee");
       sdamage = damage+(int)me->query("max_sen");
	message_vision(HIY "$N闭上眼睛，凌空盘膝而坐，周身仙力澎湃。\n" NOR, me);
       message("system",HIW"〖"+HIR+"度雷劫"+HIW+"〗"+HIY+"天空中劫云翻滚，雷霆闪耀，好像有人正在度雷劫。\n"NOR,users());
	me->set_temp("no_move",1);
	me->set_temp("dujie_begin",1);
      if (me->query_temp("hualong")) me->delete_temp("hualong"); //取消龙宫化龙的无敌效果
	call_out("begin1",2,me,kdamage,sdamage,level); //开始一步步的检测
	return 1;
}

void begin1(object me,int kdamage,int sdamage,int level)
{
if(!me) return;
 if(me->is_ghost()) {
  call_out("finish2",0,me); 
  return;
                    }
if((int)me->query("PKS") > 0)
 {
tell_object(me, HIC "你思绪万千，曾经被你杀害的人犹如恶鬼般的向你扑来，不禁吓的浑身一颤。\n" NOR);
kdamage += kdamage*(int)me->query("PKS")/10; //每杀一人增加10%威力
sdamage += sdamage*(int)me->query("PKS")/10;
call_out("begin2",2,me,kdamage,sdamage,level);
  }
else call_out("begin2",0,me,kdamage,sdamage,level);
}

void begin2(object me,int kdamage,int sdamage,int level)
{
int panshi;
if(!me) return;
 if(me->is_ghost()) {
  call_out("finish2",0,me); 
  return;
                    }

 panshi = (int)me->query("betray/count") || (int)me->query("betrayer");
if( panshi > 0)
 {
tell_object(me, HIC "你思绪万千，想起曾经离师判道的行径，不由的悔恨交加。\n" NOR);
kdamage += kdamage*panshi/10; //判师一次增加10%威力
sdamage += sdamage*panshi/10;
call_out("begin3",2,me,kdamage,sdamage,level);
  }
else call_out("begin3",0,me,kdamage,sdamage,level);
}

void begin3(object me,int kdamage,int sdamage,int level)
{
if(!me) return;
 if(me->is_ghost()) {
  call_out("finish2",0,me); 
  return;
                    }

if((int)me->query("dntg/number") > 9)
 {
tell_object(me, HIC "你思绪万千，想起曾经大闹天宫的壮举，顿时信心倍增。\n" NOR);
kdamage -= kdamage/10;  //完成大闹天宫减少10%威力
sdamage -= sdamage/10;
call_out("begin4",2,me,kdamage,sdamage,level);
  }
else call_out("begin4",0,me,kdamage,sdamage,level);
}

void begin4(object me,int kdamage,int sdamage,int level)
{
if(!me) return;
 if(me->is_ghost()) {
  call_out("finish2",0,me); 
  return;
                    }

if((int)me->query("obstacle/number") > 25)
 {
tell_object(me, HIC "你思绪万千，想起曾经历经千难万险西行取经的壮举，念头豁然通达。\n" NOR);
kdamage -= kdamage/10; //完成取经减少10%威力
sdamage -= sdamage/10;
call_out("dujie1",2,me,kdamage,sdamage,level);
  }
else call_out("dujie1",0,me,kdamage,sdamage,level);
}

void dujie1(object me,int kdamage,int sdamage,int level)
{
int dk,ds;
if(!me) return;
 if(me->is_ghost()) {
  call_out("finish2",0,me); 
  return;
                    }
kdamage -=((int)me->query_temp("apply/armor") + (int)me->query_temp("apply/armor_vs_force"));
sdamage -=((int)me->query_temp("apply/armor") + (int)me->query_temp("apply/armor_vs_spells"));
if (kdamage < 1) kdamage = 1;
if (sdamage < 1) sdamage = 1;  
if( level > 0)
 {
message_vision(HIY "天空劫云越聚越拢，突然劫云中心冲出一道雷电劈向$N。\n" NOR, me);
message_vision(HIC "\n              第一道天雷\n\n" NOR, me);
message_vision(HIY "$N运起全身功力硬抗天雷一击。\n" NOR, me);
dk = kdamage/2+random(kdamage/2);
ds = sdamage/2+random(sdamage/2);
if((int)me->query_temp("eat_djd") >= 1) {
dk = dk/2;
ds = ds/2;
me->add_temp("eat_djd",-1);
}
me->receive_damage("sen",ds);
me->receive_damage("kee",dk);
me->receive_wound("sen",ds);
me->receive_wound("kee",dk);
COMBAT_D->report_status(me);
COMBAT_D->report_sen_status(me);
me->heart_beat();  //立刻召唤心跳判断死亡
call_out("dujie2",1+random(10),me,kdamage,sdamage,level);
  }
}

void dujie2(object me,int kdamage,int sdamage,int level)
{
int dk,ds;
if(!me) return;
 if(me->is_ghost()) {
  call_out("finish2",0,me); 
  return;
                    }
if( level > 1)
 {
message_vision(HIY "天空劫云慢慢下压，突然劫云中心冲出一道雷电劈向$N。\n" NOR, me);
message_vision(HIC "\n              第二道天雷\n\n" NOR, me);
message_vision(HIY "$N运起全身功力硬抗天雷一击。\n" NOR, me);
dk = kdamage+kdamage*10/100; //每一劫增加10%的威力
ds = sdamage+sdamage*10/100; //每一劫增加10%的威力
dk = dk/2+random(dk/2);
ds = ds/2+random(ds/2);
if((int)me->query_temp("eat_djd") >= 1) {
ds = ds/2;
dk = dk/2;
me->add_temp("eat_djd",-1);
}
me->receive_damage("sen",ds);
me->receive_damage("kee",dk);
me->receive_wound("sen",ds);
me->receive_wound("kee",dk);
COMBAT_D->report_status(me);
COMBAT_D->report_sen_status(me);
me->heart_beat();  //立刻召唤心跳判断死亡
call_out("dujie3",1+random(10),me,kdamage,sdamage,level);
  }
else call_out("finish",1,me);
}

