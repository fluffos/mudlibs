#include <ansi.h>


inherit COMBINED_ITEM;

void create()
{
        set_name(RED"血色之石"NOR, ({"xuese stone", "stone"}));
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long",    "杀戮之气凝聚而成的石头，可用来破除一切封印。\n");
                set("unit", "颗");
                set("base_unit", "颗");
                set("base_weight", 1);
                set("value", 100000);
                }
        set_amount(1);
        setup();
}

void destruct_me(object where, object me)
{
  message_vision(HIR"血色之石化作浓浓血雾消散在天地之间。\n"NOR,where,me);
me->add_amount(-1);
if(me->query_amount() < 1) destruct (me);
}

void init()
{
  object me = this_object();
  object where = environment();

  call_out("destruct_me",1,where,me);

}
