
inherit COMBINED_ITEM;
#include <ansi.h>;

void create()
{
        set_name(HIW"妖之魄"NOR, ({"yao po", "po"}));
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long",    "一枚小妖的灵魂，是提炼某种丹药的必须品。\n");
                set("unit", "些");
                set("base_unit", "枚");
                set("base_weight", 1);
                set("value", 10000);
                }
        set_amount(1);
        setup();
}


