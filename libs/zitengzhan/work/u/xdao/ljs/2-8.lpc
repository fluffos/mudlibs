#include <ansi.h>;
inherit ROOM;
void create() {
  set("short", "第二层妖王府");
  set("long", @LONG
这里是守护第二层的覆海大圣蛟魔王的洞府，更是通往第三层的必经之路。
洞府四周刻有七大圣结拜时的石刻， 蛟魔王端坐在石塌之上，周围小妖纷纷
端茶送果，献媚不已。
LONG);

  set("exits", ([
    "up": __DIR__ "3-1",
    "west": __DIR__ "2-7",
  ]));

  set("objects", ([
    "/u/xdao/ljs/npc/yao-2.lpc": 2,
    "/u/xdao/ljs/npc/boss-2.lpc": 1,
  ]));

  setup();
}

int valid_leave(object who, string dir) {
  object wang = present("jiao mo wang", this_object());

  if (dir == "west")
    return ::valid_leave(who, dir);

  if (wang)
    return notify_fail(HIB "蛟魔王身子一晃拦在了你的面前！\n" NOR);
  return ::valid_leave(who, dir);
}
