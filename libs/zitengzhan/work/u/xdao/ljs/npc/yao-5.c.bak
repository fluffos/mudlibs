inherit NPC;
#include <ansi.h>

void create()
{
int i,j;
i=200;
j=50;
	set_name(HIB"小妖"NOR, ({ "xiao yao", "yao"}));
	set("long", @LONG
一只七大圣座下的小妖
LONG);
  set("gender", random(2)?"男性":"女性");
      set("title",HIR"通风大圣座下"NOR);
	set("age", 30);
	set("max_kee", 6000);
	set("max_sen", 6000);
	set("force", 6000);
	set("max_force", 6000);
	set("force_factor", 200);
	set("max_mana", 6000);
	set("mana", 6000);
	set("mana_factor", 200);
       add_temp("apply/damage", 200+random(100));
       add_temp("apply/armor", 280+random(280));
       add_temp("apply/armor_vs_force",280+random(280));
       add_temp("apply/armor_vs_spells",280+random(280));
	set("combat_exp", 13000000);
	set("daoxing", 13000000);
set("vrm_guard", 1);
       set("baolv", 6);
       set("haveexp",600);
   set("family/family_name", "方寸山三星洞");
       set_skill("unarmed", i+random(i));
       set_skill("dodge", i+random(i));
        set_skill("parry", i+random(i));
        set_skill("force", i+random(i));
        set_skill("spells", i+random(i));
 
        set_skill("stick", i+random(i));
        set_skill("qianjun-bang", i+random(i));
        set_skill("sword",i+random(i));
        set_skill("liangyi-sword",i+random(i));
        set_skill("jindouyun", i+random(i));
        set_skill("wuxiangforce", i+random(i));
        set_skill("puti-zhi", i+random(i));
        set_skill("dao", i+random(i));

        map_skill("force", "wuxiangforce");
        map_skill("stick","qianjun-bang");
        map_skill("parry", "qianjun-bang");
        map_skill("spells", "dao");
        map_skill("dodge", "jindouyun");
        map_skill("unarmed", "puti-zhi");
        map_skill("sword", "liangyi-sword");
	setup();
        carry_object("/d/obj/weapon/18weapon.c")->wield();
}

void init()
{
  add_action("do_block","",1);
}

int do_block(string arg)
{
    object me=this_object();
    object who=this_player();
    string verb=query_verb();

         
    if(!userp(who)||wizardp(who)) return 0;

    if(verb!="go" &&
            verb!="fly" &&
            !(environment() && environment()->query("exits/" + verb)))
        return 0;
       
          
        tell_object(who,HIM""+me->name()+"喝道：大王有令！止步！！n"NOR);
        return 1;
}

void kill_ob(object ob)
{
 object me = this_object();
  set_temp("my_killer",ob);
  ::kill_ob(ob);
}

void heart_beat()
{  
object ob = this_object();
int k;
   ::heart_beat();
if (is_fighting()  &&  query("force") < query("max_force")/2 )       
     command("cast transfer");
   if (query("kee") < query("eff_kee")-10 )
         command("exert recover");
   if (query("sen") < query("eff_sen")-10 ) 
     command("exert refresh");
 if(is_fighting())
  {
       k = random(5);                     
        if (k>4) k=4;
        switch(k)
      	{
          case 0: 
                command("perform qizhi");break;
	  case 1:
		command("cast light");break;
          case 2:  
		command("perform pili");break;
	  case 3:
                command("perform qiankun");break;
          case 4:
		command("perform panlong");break;
          default: return 0;
	}
   }
}

void die ()
{
  object me = this_object();
  object ps;
  object killer = query_temp("last_damage_from");
  int exp,baolv,pot,d;
 if(objectp(killer) && killer->query("is_guard") == 1)
         killer = killer->query("possessed");
 if (objectp(killer)) 
  {
exp = query("haveexp");
exp = exp/2 + random(exp/2);
pot = exp/3;
killer->add("combat_exp",exp);
 killer->add("daoxing",exp);
 killer->add("potential",pot);
baolv = query("baolv");
 if (random(baolv) == 0)
   {
     d=random(19);
              if (d>19) d=19;   
              switch(d)
        	{
        		case  0: ps = new ("/d/npc/vr_room/obj/bs_zf.c");break;
        		case  1: ps = new ("/d/npc/vr_room/obj/bs_lh.c");break;
        		case  2: ps = new ("/d/npc/vr_room/obj/bs_fsl.c");break;
        		case  3: ps = new ("/d/npc/vr_room/obj/bs_tq.c");break;
        		case  4: ps = new ("/u/xdao/ljs/obj/stone.c");break;
        		case  5: ps = new ("/u/xdao/ljs/obj/stone.c");break;
        		case  6: ps = new ("/u/xdao/ljs/obj/stone.c");break;
        		case  7: ps = new ("/d/npc/vr_room/obj/baoshi.c");break;
        		case  8: ps = new ("/d/npc/vr_room/obj/baoshi.c");break;
        		case  9: ps = new ("/d/npc/vr_room/obj/baoshi.c");break;
        		case  10: ps = new ("/d/npc/vr_room/obj/baoshi.c");break;
        		case  11: ps = new ("/d/npc/vr_room/obj/baoshi.c");break;
        		case  12: ps = new ("/d/npc/vr_room/obj/baoshi.c");break;
        		case  13: ps = new ("/d/npc/vr_room/obj/baoshi.c");break;
        		case  14: ps = new ("/d/npc/vr_room/obj/baoshi.c");break;
        		case  15: ps = new ("/d/npc/vr_room/obj/baoshi.c");break;
        		case  16: ps = new ("/d/npc/vr_room/obj/baoshi.c");break;
        		case  17: ps = new ("/d/npc/vr_room/obj/baoshi.c");break;
        		case  18: ps = new ("/d/npc/vr_room/obj/baoshi.c");break;
        		case  19: ps = new ("/d/npc/vr_room/obj/bs_tj.c");break;
                    default: ps = new ("/d/npc/vr_room/obj/baoshi.c");
        		}
 if (objectp(ps)) ps->move(me);
   }
  else
   {
     ps = new ("/obj/money/silver.c");
  if(objectp(ps)) 
        {
          ps->set_amount(random(50));
          ps->move(me);
         }
    }
tell_object(killer, HIM"你得到了"+chinese_number(exp)
			    +"点武学经验"+chinese_number(pot)+
			    "点潜能、"+COMBAT_D->chinese_daoxing(exp)+"天道行的奖励!\n"NOR);
TEAMK_D->teamk(killer,exp);

}
::die();
}

void unconcious()
{
die ();
}
