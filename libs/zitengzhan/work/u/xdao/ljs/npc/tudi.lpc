
#include <ansi.h>

inherit NPC;
string ask_for_leave();
void create()
{
        set_name(HIC"土地"NOR, ({"tu di", "di"}));
        set("long",HIC "两界山的土地爷爷。\n"NOR);
        set("age", 400);
        set("attitude", "peaceful");

        set("gender", "男性");
        set("title", HIG"两界山"NOR);
        set("str", 40);
        set("int", 40);
        set("per", 10+random(5));
        set("con", 30);
        set("max_kee",5000);
        set("max_sen", 5000);
        set("combat_exp", 15000000);
        set("daoxing", 15000000);
        set("baolv", 1);

        set("force", 12000);
        set("max_force", 12000);
        set("mana", 12000);
        set("max_mana", 12000);
        set("force_factor", 300);
        set("mana_factor", 1200);

        set("eff_dx", 800000);

        set_skill("unarmed", 200);
        set_skill("force", 200);
        set_skill("dodge", 200);
        set_skill("parry", 200);

        set("inquiry", ([ /* sizeof() == 2 */
                "name" : "吾乃两界山土地是也。",
                "leave" : (: ask_for_leave :),
        ]) );

        setup();
}

string ask_for_leave()
{
 object me=this_player();
 command("sigh");
  command("say 看来你与此山无缘，老夫这便送你出去！");  
 me->delete_temp("ljs_begin");
 me->move("/u/xdao/ljs/ljs");
 }                      
                     
void die()
{
  set("eff_kee", 5000);
  set("eff_gin", 5000);
  set("eff_sen", 5000);
  set("kee", 5000);
  set("gin", 5000);
  set("sen", 5000);
  set("force", 12000);
  set("mana", 12000);
  }

void unconcious()
{
  die ();  
}
