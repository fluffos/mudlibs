inherit NPC;
#include <ansi.h>

void create()
{
int i,j;
i=350;
j=50;
	set_name(HIW"鹏魔王"NOR, ({ "peng mo wang", "wang"}));
	set("long", @LONG
妖族七大圣之一
LONG);
  set("gender", "男性");
      set("title",HIW"混天大圣"NOR);
	set("age", 30);
  set("attitude", "aggressive");
  set("class", "yaomo");
set("ljs_boss",1);
	set("max_kee", 150000);
	set("max_sen", 150000);
	set("force", 20000);
	set("max_force", 20000);
	set("force_factor", 250);
	set("max_mana", 20000);
	set("mana", 20000);
	set("mana_factor", 250);
       add_temp("apply/damage", 150+random(100));
       add_temp("apply/armor", 300+random(300));
       add_temp("apply/armor_vs_force",300+random(300));
       add_temp("apply/armor_vs_spells",300+random(300));
	set("combat_exp", 10000000);
	set("daoxing", 10000000);
       set("baolv", 2);
       set("haveexp",4000);
   set("family/family_name", "大雪山");
        set_skill("unarmed", i+random(j));
        set_skill("dodge", i+random(j));
        set_skill("parry", i+random(j));
        set_skill("force", i+random(j));
        set_skill("spells", i+random(j));
 
        set_skill("sword", i+random(j));
        set_skill("bainiao-jian", i+random(j));
        set_skill("xiaoyaoyou", i+random(j));
        set_skill("dengxian-dafa", i+random(j));
        set_skill("ningxie-force", i+random(j));
        set_skill("cuixin-zhang", i+random(j));
        set_skill("throwing", i+random(j));
        set_skill("blade", i+random(j));
        set_skill("bingpo-blade", i+random(j));
        map_skill("blade", "bingpo-blade");

        map_skill("force", "ningxie-force");
        map_skill("sword", "bainiao-jian");
        map_skill("throwing", "bainiao-jian");
        map_skill("parry", "bainiao-jian");
        map_skill("spells", "dengxian-dafa");
        map_skill("dodge", "xiaoyaoyou");
        map_skill("unarmed", "cuixin-zhang");
	setup();
        carry_object("/d/obj/weapon/18weapon.c")->wield();
}
void kill_ob(object ob)
{
 object me = this_object();
  set_temp("my_killer",ob);
  ::kill_ob(ob);
}

void init()
{
    
    ::init();
    add_action("do_no","ji");    
}

int do_qk(string arg)
{
    
        string cast_id,cast_name;
        object who = this_player();
        
    if (sscanf(arg, "%s on %s", cast_id,cast_name) == 2)
     
      if(cast_id=="qiankun" || arg=="qiankun")
     
       tell_object(who,"你不能这么做！\n");
      return 1;
 
   
}
int do_no(string arg)
{
        object who = this_player();
        object me = this_object();
        message_vision("$N鬼鬼遂遂不知想干什么，$n警惕的盯着$N。\n",who,me);
        return 1;
}


void heart_beat()
{  
object ob = this_object();
int k;
   ::heart_beat();

if (query("eff_kee") <  query("max_kee") ) 
  {
 for (int i=3;i>0;i--)
               {carry_object("/d/npc/vr_room/obj/jinchuangyao.c");command("eat jinchuang yao");command("exert recover");}
  }

if (query("eff_sen") <  query("max_sen") )
 {
  for (int i=3;i>0;i--)
               {carry_object("/d/npc/vr_room/obj/hunyuandan.c");command("eat hunyuan dan");command("exert refresh");}
  }
if (is_fighting()  &&  query("force") < query("max_force")/2 )       
     command("cast transfer");
   if (query("kee") < query("eff_kee")-10 )
         command("exert recover");
   if (query("sen") < query("eff_sen")-10 ) 
     command("exert refresh");
   if (!is_fighting()  &&  query("force") < query("max_force") )
     set("force",(int)query("max_force"));
   if (!is_fighting()  &&  query("mana") < query("max_mana") )
     set("mana",(int)query("max_mana"));
 if(is_fighting())
  {
        k = random(5);                          
        if (k>4) k=4;
        switch(k)
      	{
          case 0:                     
                command("cast tuntian");break;      		
          case 1: 
		command("perform feijian");break;
	  case 2:
		command("perform chaofeng");break;
          case 3:                     
		command("exert ningxie");break;
	  case 4:
                command("perform cuixin");break;
          default: return 0;
	}
   }
}

void die ()
{
  object me = this_object();
  object ps;
string err;
object newitem;
  object killer = query_temp("last_damage_from");
  int exp,baolv,pot,d;
 if(objectp(killer) && killer->query("is_guard") == 1)
         killer = killer->query("possessed");
 if (objectp(killer)) 
  {
exp = query("haveexp");
exp = exp/2 + random(exp/2);
pot = exp/3;
killer->add("combat_exp",exp);
 killer->add("daoxing",exp);
 killer->add("potential",pot);
baolv = query("baolv");
 if (random(baolv) == 0)
   {
     d=random(6);
              if (d>5) d=5;   
              switch(d)
        	{
        		case  0: ps = new ("/d/npc/vr_room/obj/bs_zf.c");break;
        		case  1: ps = new ("/d/npc/vr_room/obj/bs_lh.c");break;
        		case  2: ps = new ("/d/npc/vr_room/obj/bs_fsl.c");break;
        		case  3: ps = new ("/d/npc/vr_room/obj/bs_tq.c");break;
        		case  4: ps = new ("/d/npc/vr_room/obj/bs_tj.c");break;
        		case  5: ps = new ("/u/xdao/ljs/obj/stone.c");break;
                    default: ps = new ("/d/npc/vr_room/obj/baoshi.c");
        		}
 if (objectp(ps)) ps->move(me);
   }
  else
   {
     ps = new ("/obj/money/silver.c");
  if(objectp(ps)) 
        {
          ps->set_amount(random(50));
          ps->move(me);
         }
    }
tell_object(killer, HIM"你得到了"+chinese_number(exp)
			    +"点武学经验"+chinese_number(pot)+
			    "点潜能、"+COMBAT_D->chinese_daoxing(exp)+"道行的奖励!\n"NOR);
TEAMK_D->teamk(killer,exp);
killer->set_temp("mieyao/level",12);
 err=catch(newitem=NEWITEMS_OB->get_item(me,killer));
if(objectp(newitem)) {
//message_vision("$N杀死$n得到了一"+newitem->query("unit")+newitem->query("name")+"。\n",killer,me);
newitem->move(me);
 }

}
::die();
}

void unconcious()
{
die ();
}
