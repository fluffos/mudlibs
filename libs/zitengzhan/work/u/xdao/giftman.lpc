      ob1->set("bind_id", me->query("id"));
      ob1->set("orilong", HIR "龙年吉祥，万事如意。" NOR);
      ob1->set("changed", 1);
      ob1->set("unbreak", 1);
      ob1->set("durability/max", 800);
      ob1->set("durability/now", 800);
      ob1->set("sockets/max", 3);
      ob1->set("sockets/now", 0);
      ob1->set("grade", 7);
