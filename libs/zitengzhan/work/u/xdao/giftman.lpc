#include <ansi.h>
inherit NPC;
string ask_me();

void create() {
  set_name(HIW "开站奖励大使" NOR, ({ "gift dashi", "dashi" }));
  set("nickname", HIR "龙年吉祥，万事如意" NOR);
  set("title", HIY "十二生肖" NOR);
  set("gender", "男性");
  set("age", 18);
  set("long", YEL "迎龙年开站礼物使者，Ask gift获得开站礼物。\n" NOR);
  //   set("shen_type", 1);
  set("combat_exp", 1000000);
  set("str", 30);
  set("dex", 30);
  set("con", 30);
  set("int", 30);
  set("per", 30);
  set("attitude", "friendly");
  set("inquiry", ([
    "gift": (: ask_me :),
  ]));
  setup();
  carry_object("/d/obj/cloth/magua")->wear();
}



string ask_me() {
  object me = this_player();
  object ob, ob1;
  int j;
  string att;

  if (!userp(me)) return "一边玩去。";
  if (me->query("2012newyear"))
    return "呵呵～龙年吉祥，恭喜发财！";
  if ((int)me->query("combat_exp") + (int)me->query("daoxing") < 500000)
    return "武学加道行50W以上再来领取吧！";
  if (!me->query("family"))
    return "你先去拜个师再来要礼物吧！";

  me->set("2012newyear", 1);
  me->add("daoxing", 300000);
  me->add("combat_exp", 300000);
  me->add("potential", 100000);
  if (me->query("family/family_name") == "南海普陀山") {
    ob = new("/u/xdao/neckpt.lpc");
    if (objectp(ob)) {
      ob->set("bind_id", me->query("id"));
      ob->set("orilong", HIR "龙年吉祥，万事如意。" NOR);
      ob->set("changed", 1);
      ob->set("unbreak", 1);
      ob->set("durability/max", 800);
      ob->set("durability/now", 800);
      ob->set("sockets/max", 3);
      ob->set("sockets/now", 0);
      ob->set("armor_prop/spells", 50);
      ob->set("armor_prop/armor_vs_spells", 200);
      ob->set("armor_prop/armor_vs_force", 200);
      ob->set("armor_prop/cold_defence", 10);
      ob->set("armor_prop/fire_defence", 10);
      ob->set("armor_prop/wind_defence", 10);
      ob->set("armor_prop/poison_defence", 10);
      ob->set("armor_prop/lightning_defence", 10);
      ob->set("bind_type", 3);
      ob->set("armor_prop/armor", 50);
      ob->set("unique_code", time());
      ob->set("primitive_id", me->query("id"));
      ob->move(me);
    }
    me->save();
    tell_object(
      me,
      HIR "开站奖励大使双手抱拳对你说道：龙年吉祥！恭喜发财！\n 你得到了武学，道行，潜能，和一件" + ob->query("name") + "" + HIR + "的新年赐福！\n" NOR
    );
  }
  if (me->query("family/family_name") == "方寸山三星洞") {
    ob = new("/u/xdao/stickfc.lpc");
    if (objectp(ob)) {
      ob->set("bind_id", me->query("id"));
      ob->set("orilong", HIR "龙年吉祥，万事如意。" NOR);
      ob->set("changed", 1);
      ob->set("unbreak", 1);
      ob->set("durability/max", 800);
      ob->set("durability/now", 800);
      ob->set("sockets/max", 3);
      ob->set("sockets/now", 0);
      ob->set("grade", 7);
      ob->set("weapon_prop/luck", 3);
      ob->set("weapon_prop/damage", 220);
      ob->set("sockets/max", 3);
      ob->set("sockets/now", 0);
      ob->set("bind_type", 3);
      ob->set("unique_code", time());
      ob->set("primitive_id", me->query("id"));
      j = random(5);
      switch (j) {
        case 0: att = "cold_attack"; break;
        case 1: att = "fire_attack"; break;
        case 2: att = "lightning_attack"; break;
        case 3: att = "poison_attack"; break;
        case 4: att = "wind_attack"; break;
        default: att = "";
      }
      ob->set((att + "/max_level"), 10);
      ob->set("weapon_prop" + "/" + att, 1);
      ob->set((att + "/exp"), 0);
      ob->move(me);
    }
    me->save();
    tell_object(
      me,
      HIR "开站奖励大使双手抱拳对你说道：龙年吉祥！恭喜发财！\n 你得到了武学，道行，潜能，和一件" + ob->query("name") + "" + HIR + "的新年赐福！\n" NOR
