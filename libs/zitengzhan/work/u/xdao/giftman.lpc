      me,
      HIR "开站奖励大使双手抱拳对你说道：龙年吉祥！恭喜发财！\n 你得到了武学，道行，潜能，" + ob->query("name") + "" + HIR + "和" + ob1->query("name") + "" + HIR + "的新年赐福！\n" NOR
    );
