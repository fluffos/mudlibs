inherit ROOM;
#include <ansi.h>;
void create() {
  set("short", "花果山福地");
  set("long", @LONG
花果山福地、水帘洞洞天。此处便是美猴王孙悟空的洞府。四周山石嶙峋
草木茂盛、灵气充沛，许多小猴子在树间荡漾。远处不时传来阵阵怪叫。
LONG);

  set("exits", ([
    "east": __DIR__ "w-6",
    "west": __DIR__ "w-2",
  ]));
  set("objects", ([
    "/u/xdao/hgs/npc/hou.lpc": 2 + random(3),
  ]));

  setup();
}
