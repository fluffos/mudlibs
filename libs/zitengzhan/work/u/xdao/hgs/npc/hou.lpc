// monkey1.c

#include <ansi.h>;
inherit NPC;

void create() {
  set_name("猴子", ({ "hou zi", "monkey", "hou" }));
  set("race", "野兽");
  set("age", 8);
  set("long", "一只顽皮的小猴子。\n");

  set("str", 30);
  set("cor", 26);
  set("combat_exp", 50);
  set("daoxing", 0);



  set_skill("dodge", 20);
  set_skill("unarmed", 10);
  set("limbs", ({ "头部", "身体", "前爪", "后脚", "尾巴" }));
  set("verbs", ({ "bite", "claw" }));


  setup();
}

void die() {
  object ps;
  message_vision(HIB "吱。。吱。。草丛间又串出一只猴子对着你张牙舞爪！\n" NOR, this_object()); ;
  ps = new("/u/xdao/hgs/npc/hou.lpc");
  if (objectp(ps)) ps->move(environment(this_object()));
  ::die();
}
