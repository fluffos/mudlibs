
#include <ansi.h>

inherit NPC;
//#define LJS_TIME 7200;
string ask_for_enter();
void create()
{
        set_name(HIC"山神"NOR, ({"hgs shanshen", "shanshen","shen"}));
        set("long",HIC "花果山山神。\n"NOR);
        set("age", 400);
        set("attitude", "peaceful");

        set("gender", "男性");
        set("title", HIG"花果山"NOR);
        set("str", 40);
        set("int", 40);
        set("per", 10+random(5));
        set("con", 30);
        set("max_kee",5000);
        set("max_sen", 5000);
        set("combat_exp", 15000000);
        set("daoxing", 15000000);
        set("no_clean_up",1);
        set("baolv",1);

        set("force", 12000);
        set("max_force", 12000);
        set("mana", 12000);
        set("max_mana", 12000);
        set("force_factor", 300);
        set("mana_factor", 1200);

        set("eff_dx", 800000);
        set("xuese", 200);
        set_skill("unarmed", 200);
        set_skill("force", 200);
        set_skill("dodge", 200);
        set_skill("parry", 200);

        set("inquiry", ([ /* sizeof() == 2 */
                "name" : "吾乃花果山山神是也。",
                "enter" : (: ask_for_enter :),
        ]) );

        setup();
}

string ask_for_enter()
{
object ob=this_object();
 object me=this_player();
int i;
   if(me->query("combat_exp")<100000&&!wizardp(me)) {
    tell_object (me,HIC"山神说道：你经验太低。至少需要10万武学经验才能进入！\n"NOR);
  return 0;
  }
            if(me->query("age")<16 && !wizardp(me)){
    tell_object (me,HIC"山神说道：16岁以上才能进入!\n"NOR);
  return 0;
}
         if(me->query_temp("dujie_begin")){
    tell_object (me,HIC"山神说道：安心度劫吧！\n"NOR);
  return 0;
  }
if(!ob->query_temp("hgs_start"))
       {
    tell_object (me,HIC"山神说道：时辰未到！\n"NOR);
      }
else
     {
  command("nod");  
  command("say 时辰已到，大仙请进！");  
 me->set_temp("hgs_begin",1);
if(me->query("family/family_name")=="方寸山三星洞"
       ||me->query("family/family_name")=="南海普陀山"
       ||me->query("family/family_name")=="五庄观")
    me->move("/u/xdao/hgs/eastroom");
else me->move("/u/xdao/hgs/westroom");
     }                      
 }

void heart_beat()
{  
object ob = this_object();
if(ob->query_temp("hgs_start")&&!ob->query_temp("start"))
      {
   message("channel:chat",YEL"【花果山】"+CYN+"山神：时辰到！众位仙家可通过我进入花果山福地！\n"NOR,users());
   message("channel:chat",YEL"【花果山】"+CYN+"山神：花果山开放时间为1小时！\n"NOR,users());
          ob->set_temp("start",1);
          call_out("reset_hgs", 3600);
          call_out("reset1", 1800);
          call_out("reset2", 2400);
          call_out("reset3", 3000);
          call_out("reset4", 3300);
       }
}

void reset1()
{
remove_call_out("reset1");
  message("channel:chat",YEL"【花果山】"+CYN+"山神：距离花果山战役结束还有30分钟。\n"NOR,users());
}

void reset2()
{
remove_call_out("reset2");
  message("channel:chat",YEL"【花果山】"+CYN+"山神：距离花果山战役结束还有20分钟。\n"NOR,users());
}

void reset3()
{
remove_call_out("reset3");
  message("channel:chat",YEL"【花果山】"+CYN+"山神：距离花果山战役结束还有10分钟。\n"NOR,users());
}

void reset4()
{
remove_call_out("reset4");
  message("channel:chat",YEL"【花果山】"+CYN+"山神：距离花果山战役结束还有5分钟。\n"NOR,users());
}

void reset_hgs()
{
string err;
 object ob = this_object();
object *player;
object ps,gold,me,killer,newitem;
int m,i,d,exp,pot;
player = users();
m=sizeof(player);
 remove_call_out("reset_hgs");
if(ob->query_temp("hgs_start"))
  {
  message("channel:chat",YEL"【花果山】"+CYN+"山神：时辰到！请众位仙家退出花果山！\n"NOR,users());
       for(i=0;i<m;i++){
          if(player[i]->query_temp("hgs_begin"))
               {
                player[i]->delete_temp("hgs_begin");
     tell_object(player[i], HIC"你被一股强大的力量推出了花果山。\n"NOR);
                player[i]->move("/u/xdao/hgs/hgs");
            if (player[i]->query("family/family_name")=="方寸山三星洞"
                                          ||player[i]->query("family/family_name")=="南海普陀山"
                                          ||player[i]->query("family/family_name")=="五庄观")
                      {
                player[i]->add("faith",1000);
         tell_object(player[i], HIW"由于你的出色表现，获得了师门奖励的1000点门派忠诚度。\n"NOR);
                          killer=player[i];
                          me=ob;
                          killer->set_temp("mieyao/level",12);
                          err=catch(newitem=NEWITEMS_OB->get_item(me,killer));
                       if(objectp(newitem)) {
                          newitem->move(killer);
                          tell_object(killer, HIM"你得到了一"+newitem->query("unit")+newitem->query("name")+"。\n"NOR);}
            d=random(7);
              if (d>6) d=6;   
              switch(d)
        	                {
        		case  0: ps = new ("/d/npc/vr_room/obj/bs_zf.lpc");
                             if(ps) ps->move(player[i]);
                  //           gold = new ("/obj/money/gold.lpc");
                  //            if(gold) gold->set_amount(50);
                   //          if(gold) gold->move(player[i]);
                             exp=20000+random(20000);
                             pot=exp/3;
                              player[i]->add("combat_exp",exp);
                              player[i]->add("daoxing",exp);
                              player[i]->add("potential",pot);
                           tell_object(player[i], HIM"你得到了"+ps->query("name")+""+HIM+"的奖励。\n"NOR);
                        //   tell_object(player[i], HIM"你得到了"+HIY+"50两黄金"+HIM+"的奖励。\n"NOR);
                           tell_object(player[i], HIM"你得到了"+chinese_number(exp)+"点武学经验的奖励。\n"NOR);
                           tell_object(player[i], HIM"你得到了"+COMBAT_D->chinese_daoxing(exp)+"道行的奖励。\n"NOR);
                           tell_object(player[i], HIM"你得到了"+chinese_number(pot)+"点潜能的奖励。\n"NOR);break;
        		case  1: ps = new ("/d/npc/vr_room/obj/bs_lh.lpc");
                             if(ps) ps->move(player[i]);
                  //           gold = new ("/obj/money/gold.lpc");
                  //            if(gold) gold->set_amount(50);
                  //           if(gold) gold->move(player[i]);
                             exp=20000+random(20000);
                             pot=exp/3;
                              player[i]->add("combat_exp",exp);
                              player[i]->add("daoxing",exp);
                              player[i]->add("potential",pot);
                           tell_object(player[i], HIM"你得到了"+ps->query("name")+""+HIM+"的奖励。\n"NOR);
                   //        tell_object(player[i], HIM"你得到了"+HIY+"50两黄金"+HIM+"的奖励。\n"NOR);
                           tell_object(player[i], HIM"你得到了"+chinese_number(exp)+"点武学经验的奖励。\n"NOR);
                           tell_object(player[i], HIM"你得到了"+COMBAT_D->chinese_daoxing(exp)+"道行的奖励。\n"NOR);
                           tell_object(player[i], HIM"你得到了"+chinese_number(pot)+"点潜能的奖励。\n"NOR);break;
        		case  2: ps = new ("/d/npc/vr_room/obj/bs_fsl.lpc");
                             if(ps) ps->move(player[i]);
                     //        gold = new ("/obj/money/gold.lpc");
                      //        if(gold) gold->set_amount(50);
                      //       if(gold) gold->move(player[i]);
                             exp=20000+random(20000);
                             pot=exp/3;
                              player[i]->add("combat_exp",exp);
                              player[i]->add("daoxing",exp);
                              player[i]->add("potential",pot);
                           tell_object(player[i], HIM"你得到了"+ps->query("name")+""+HIM+"的奖励。\n"NOR);
                      //     tell_object(player[i], HIM"你得到了"+HIY+"50两黄金"+HIM+"的奖励。\n"NOR);
                           tell_object(player[i], HIM"你得到了"+chinese_number(exp)+"点武学经验的奖励。\n"NOR);
                           tell_object(player[i], HIM"你得到了"+COMBAT_D->chinese_daoxing(exp)+"道行的奖励。\n"NOR);
                           tell_object(player[i], HIM"你得到了"+chinese_number(pot)+"点潜能的奖励。\n"NOR);break;
        		case  3: ps = new ("/d/npc/vr_room/obj/bs_tq.lpc");
                             if(ps) ps->move(player[i]);
                     //        gold = new ("/obj/money/gold.lpc");
                     //         if(gold) gold->set_amount(50);
                     //        if(gold) gold->move(player[i]);
                             exp=20000+random(20000);
                             pot=exp/3;
                              player[i]->add("combat_exp",exp);
                              player[i]->add("daoxing",exp);
                              player[i]->add("potential",pot);
                           tell_object(player[i], HIM"你得到了"+ps->query("name")+""+HIM+"的奖励。\n"NOR);
                     //      tell_object(player[i], HIM"你得到了"+HIY+"50两黄金"+HIM+"的奖励。\n"NOR);
                           tell_object(player[i], HIM"你得到了"+chinese_number(exp)+"点武学经验的奖励。\n"NOR);
