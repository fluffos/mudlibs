inherit ROOM;
#include <ansi.h>;
void create() {
  set("short", "花果山福地");
  set("long", @LONG
花果山福地、水帘洞洞天。此处便是美猴王孙悟空的洞府。四周山石嶙峋
草木茂盛、灵气充沛，许多小猴子在树间荡漾。远处不时传来阵阵怪叫。
LONG);

  set("exits", ([
    "east": __DIR__ "w-4",
    "northwest": __DIR__ "westroom",
  ]));
  set("objects", ([
    "/u/xdao/hgs/npc/hou.lpc": 2 + random(3),
  ]));

  setup();
}

int valid_leave(object who, string dir) {

  if (dir == "east")
    return ::valid_leave(who, dir);

  if (who->query("family/family_name") == "方寸山三星洞"
    || who->query("family/family_name") == "南海普陀山"
    || who->query("family/family_name") == "五庄观")
    return notify_fail(HIB "你不能进去！\n" NOR);
  return ::valid_leave(who, dir);
}
