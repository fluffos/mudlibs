inherit ROOM;
#include <ansi.h>

void create()
{
        set("short", "紫霄宫");
         set ("long", @LONG
这里便是紫霄宫了，四周紫气环绕，瑞光万千！地上有七个蒲团，往上
是鸿钧的悟道之处，也同样摆放着一个蒲团。虽然成设简单，却处处透着玄奥。
LONG);
set("exits", ([ /* sizeof() == 2 */
      "out": __DIR__"z47", 
        ]));

setup();
}

void init()
{
object me = this_player();
if(userp(me)) {
tell_object(me, HIM"一道苍茫的神念告诉你：入得紫霄宫即是有缘，汝可静坐！待吾开讲！\n"NOR);
tell_object(me, HIM"紫霄宫内不得杀戮、偷窃、耳语！违者逐出紫霄宫！\n"NOR); }
         add_action("do_out","kill");   
         add_action("do_out","fight");   
         add_action("do_out","steal");   
         add_action("do_out","cast");   
         add_action("do_out","gongji");   
         add_action("do_out","whisper");   
         add_action("do_out","ji"); 
         add_action("do_out","perform");   
         add_action("do_out","yuqi");   
         add_action("do_canwu","canwu");   
  }

int do_canwu(string arg)
{
write(HIW"\n紫霄宫中不得参悟!\n"NOR);
return 1;
}
int do_out(string arg)
{
object me = this_player();
if(!me) return 0;
  message_vision(HIM"一股苍茫的神念传来：孽障！敢在紫霄宫撒泼！出去！\n"NOR,me);
  message_vision(HIM"一股强大至极的力量把$N掀了出去！\n"NOR,me);
  if(!me->move("/u/xdao/zxg/z0")) me->move("/d/city/kezhan");
return 1;
}
