//2009/11/18 by xdao
#include <ansi.h>
inherit NPC;

int do_destruct();

void create(object ob) {
  object me = this_object();

  set_name(HIM "鸿钧道人" NOR, ({ "hongjun daoren", "hongjun", "daoren" }));
  set("age", 20);
  set("vrm_guard", 1);
  set("class", "xian");
  set("str", 200);
  set("spi", 130);
  set("gender", "男性");
  set("long", "万世第一大神！盘古与三清之师。\n");
  set("combat_exp", 800000000);
  set("daoxing", 800000000);


  set("max_kee", 3000000);
  set("max_sen", 3000000);
  set("max_force", 300000);
  set("force", 600000);
  set("max_mana", 300000);
  set("mana", 600000);
  set("food", 50000);
  set("water", 50000);
  set_weight(30000);
  set("no_steal", 1);
  set("force_factor", 2000);
  set("mana_factor", 2000);
  set("title", HIW "天道圣人 万法之祖" NOR);
  set_skill("spells", 1000);
  set_skill("force", 1000);
  set_skill("dodge", 1000);
  set_skill("parry", 1000);
  setup();


}

int do_start() {
  object ob = this_object();
  object *player, me;
  string who;
  int i, j;
  if (!environment(ob)) return 0;
  if (environment(ob)->query("short") != "紫霄宫") return 0;
  player = all_inventory(environment(ob));
  j = 100;
  while (j--) {

    i = random(sizeof(player));
    if (!userp(player[i]))
      continue;
    if (!living(player[i]))
      continue;
    if ((int)player[i]->query_kar() < 35)
      continue;
    if ((int)player[i]->query("combat_exp") < 100000000 || (int)player[i]->query("daoxing") < 100000000)
      continue;

    me = player[i];
    break;
  }

  if (!me) return do_destruct();
  else {
    remove_call_out("do_begin");
    call_out("do_begin", 2, me, ob);
  }
}

void do_begin(object me, object ob) {
  message("channel:chat", MAG "【紫霄宫】" + CYN + "紫霄宫内鸿钧现身，众仙入座听讲！\n" NOR, users());
  message("channel:chat", MAG "【紫霄宫】" + CYN + "鸿钧道祖讲述天道法则，只见道祖出口成莲，字字珠玑，晦涩深奥！\n" NOR, users());
  call_out("do_begin1", 3, me, ob);
}

void do_begin1(object me, object ob) {
  message("channel:chat", MAG "【紫霄宫】" + CYN + "这一讲便是一千年。。。众仙有的如痴如醉、有的满脸疾苦、有的强记硬背！\n" NOR, users());
  message(
    "channel:chat",
    MAG "【紫霄宫】" + CYN + "但听一声钟响，将众仙敲醒！道祖说道：吾已将三千大道法则传于汝等，汝等可还有问题？\n" NOR,
    users()
  );
  call_out("do_begin2", 2, me, ob);
}

void do_begin2(object me, object ob) {
  if (!me) {
    message("channel:chat", MAG "【紫霄宫】" + CYN + "众仙唯唯诺诺，均不做声。\n" NOR, users());
    do_destruct();
    return 0;
  }
  message(
    "channel:chat",
    MAG "【紫霄宫】" + CYN + "只见" + me->query("name") + "问道：敢问道祖，何谓圣？\n" NOR,
    users()
  );
  call_out("do_begin3", 2, me, ob);
}

void do_begin3(object me, object ob) {
  if (!me) {
    do_destruct();
    return 0;
  }
  message("channel:chat", MAG "【紫霄宫】" + CYN + "鸿钧道祖点了点头：圣人者、元神寄托于虚空。天道不毁、圣人不殒！\n" NOR, users());
  message(
    "channel:chat",
    MAG "【紫霄宫】" + CYN + " " + me->query("name") + "接着问：可有何成圣之法？\n" NOR,
    users()
  );
  call_out("do_begin4", 2, me, ob);
}

void do_begin4(object me, object ob) {
  if (!me) {
    do_destruct();
    return 0;
  }
  message("channel:chat", MAG "【紫霄宫】" + CYN + "鸿钧道祖：斩三尸着可成圣！大功德者可成圣！力破虚空着可成圣！\n" NOR, users());
  message(
    "channel:chat",
    MAG "【紫霄宫】" + CYN + " " + me->query("name") + "低头沉思，其余众仙不得其解。\n" NOR,
    users()
  );
  call_out("do_begin5", 2, me, ob);
}

void do_begin5(object me, object ob) {
  if (!me) {
    do_destruct();
    return 0;
  }
  message("channel:chat", MAG "【紫霄宫】" + CYN + "也罢！赐汝先天鸿蒙紫气，能不能得圣位看汝机缘了。\n" NOR, users());
  message(
    "channel:chat",
    MAG "【紫霄宫】" + CYN + "鸿钧道祖手指一弹，只见一缕紫气射入了" + me->query("name") + "的体内，直到此事众仙方才醒悟，望向道祖。\n" NOR,
    users()
  );
  message(
    "channel:chat",
    MAG "【紫霄宫】" + CYN + "谁知道祖眉头一皱，居然拂袖而去。虚空中一道神念传遍三界：千年后再次开讲，有缘者再来！\n" NOR,
    users()
  );
  tell_object(me, HIM "恭喜你得到先天鸿蒙紫气！快去找个地方参悟去吧(canwu)\n" NOR);
  me->set("zxg_canwu", 1);
  if (ob) destruct(ob);
}

int do_destruct() {
  message("channel:chat", MAG "【紫霄宫】" + CYN + "只见鸿钧道祖眉头一皱，拂袖而去！\n" NOR, users());
  CHANNEL_D->do_channel(this_object(), "chat", "此次开讲无玩家得到道法真传，千年后将再次开讲！");
  destruct(this_object());
}

void unconcious() {
  die();
}

void die() {
  set("max_kee", 3000000);
  set("max_sen", 3000000);
  set("eff_kee", 3000000);
  set("eff_sen", 3000000);
  set("kee", 3000000);
  set("sen", 3000000);
  set("max_force", 300000);
  set("force", 600000);
  set("max_mana", 300000);
  set("mana", 600000);
  set("food", 50000);
  set("water", 50000);
}
