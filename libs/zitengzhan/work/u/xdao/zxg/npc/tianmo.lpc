#include <ansi.h>
inherit NPC;

void create(object ob) {
  object me = this_object();
  int i, j;

  set_name(HIY "无天" NOR, ({ "wu tian", "mo", "wu", "tian" }));
  i = 600;
  j = 200;
  set("family/family_name", "昆仑山玉虚洞");

  set("age", 20);
  set("vrm_guard", 1);
  set("attitude", "aggressive");
  set("class", "yaomo");
  set("str", 120);
  set("spi", 130);
  set("kar", 40);
  set("gender", "男性");
  set("long", "魔祖无天。\n");
  set("combat_exp", 100000000 + random(100000000));
  set("daoxing", 100000000 + random(100000000));


  set("max_kee", 50000 + random(50000));
  set("max_sen", 50000 + random(50000));
  set("max_force", 30000 + random(50000));
  set("force", 60000 + random(50000));
  set("max_mana", 12000 + random(12000));
  set("mana", 30000 + random(20000));
  set("food", 50000);
  set("water", 50000);
  set_weight(30000);
  set("no_steal", 1);
  set("ljs_boss", 1);
  set("force_factor", 200 + random(300));
  set("mana_factor", 300 + random(300));
  add_temp("apply/spells", 500 + random(500));
  add_temp("apply/damage", 200 + random(500));
  add_temp("apply/armor", 500 + random(1000));
  add_temp("apply/armor_vs_force", 2000 + random(3000));
  add_temp("apply/armor_vs_spells", 2000 + random(3000));
  set("xinmai", 100);
  set("mingmai", 100);
  set("lingmai", 100);
  set("dujie/level", 9);
  set("dujie/power", 1 + random(9));
  set("dujie/time", 1 + random(9));
  set("dujie/life", 3);
  set("title", HIW " 万魔之祖" NOR);
  create_family("昆仑山玉虚洞", 1, "蓝");
  set_skill("spells", i + random(j));
  set_skill("force", i + random(j));
  set_skill("dodge", i + random(j));
  set_skill("parry", i + random(j));
  set_skill("sword", i + random(j));
  set_skill("xuanzong-force", i + random(j));
  set_skill("lingyunbu", i + random(j));
  set_skill("dashen-bian", i + random(j));
  set_skill("kaitian-zhang", i + random(j));
  set_skill("huntian-jian", i + random(j));
  set_skill("literate", i + random(j));
  set_skill("unarmed", i + random(j));
  set_skill("yuxu-spells", i + random(j));
  set_skill("wugou-jian", i + random(j));
  set_skill("mace", i + random(j));
  map_skill("spells", "yuxu-spells");
  map_skill("dodge", "lingyunbu");
  map_skill("mace", "dashen-bian");
  map_skill("force", "xuanzong-force");
  map_skill("parry", "huntian-jian");
  map_skill("sword", "huntian-jian");
  map_skill("unarmed", "kaitian-zhang");

  setup();

  carry_object("/d/obj/weapon/18weapon.lpc")->wield();
  carry_object("/d/obj/weapon/mace/goldjian.lpc");

}

void kill_ob(object ob) {
  object me = this_object();
  set_temp("my_killer", ob);
  ::kill_ob(ob);
}

void init() {
  ::init();
  add_action("do_block", "", 1);
}

void heart_beat() {
  int k;
  object ob = this_object();
  object me = query_temp("my_killer");
  if (!ob) return 0;
  ::heart_beat();
  if (!me) return 0;
  //if(environment(ob)) {
  //if (environment(me)!=environment(ob) ) return 0; }

  if (query("kee") < query("max_kee") - 1000) command("exert recover");
  if (query("sen") < query("max_sen") - 1000) command("exert refresh");

  if (is_fighting()) {
    k = random(9);
    if (k > 8) k = 8;
    switch (k) {
      case 0:
        command("cast light"); break;
      case 1:
        map_skill("sword", "wugou-jian");
        command("perform feixian"); break;
      case 2:
        command("cast fantian"); break;
      case 3:
        command("cast taiji"); break;
      case 4:
        command("perform tianpo"); break;
      case 5:
        map_skill("sword", "huntian-jian");
        command("perform lin"); break;
      case 6:
        map_skill("sword", "huntian-jian");
        command("perform tiandi"); break;
      case 7:
        command("cast fzpower"); break;
      case 8:
        command("cast fztime"); break;

      default: return 0;
    }
  }
}

int releave() {
  object me = this_object();
  if (!me) return 0;
  remove_call_out("do_destruct");
  call_out("do_destruct", 600, me);
}

void do_destruct(object me) {
  if (!me) return 0;
  if (!me->is_fighting()) {
    message_vision("\n" HIR "   无天撕裂空间一步踏了进去！！\n" NOR, me);
    destruct(me);
  } else call_out("do_destruct", 60, me);
}

int do_block(string arg) {
  object me = this_object();
  object who = this_player();
  string verb = query_verb();

  int t;

  if (!userp(who) || wizardp(who)) return 0;

  if (verb != "go" &&
    verb != "fly" &&
    !(environment() && environment()->query("exits/" + verb)))
    return 0;

  t = 0;
  t = (int)who->query_temp("passmaze");
  if (t > 0) {
    message_vision(HIY "$n身上发出万丈光芒，$N顿时被照的晕头转向，$n趁机溜了过去。\n" NOR, me, who);
    who->add_temp("passmaze", -1);
    return 0;
  }

  tell_object(who, HIM "" + me->name() + "身子一晃，堵住了你的去路！\n" NOR);
  return 1;
}


void die() {
  object me = this_object();
  object killer = query_temp("last_damage_from");
  object ps, sl;
  int exp, kexp, mexp, dao, pot, d;
  if (objectp(killer) && killer->query("is_guard") == 1)
    killer = killer->query("possessed");
  if (objectp(killer)) {
    kexp = killer->query("combat_exp");
    mexp = me->query("combat_exp");
    exp = mexp / 100000;
    exp += (mexp - kexp) / 100000;
    if (exp < 100) exp = 1 + random(100);
    if (exp > 10000) exp = 10000;
    dao = exp;
    if (dao < 1) dao = 1;
    pot = exp / 3;
    if (pot < 1) pot = 1;
    killer->add("combat_exp", exp);
    killer->add("daoxing", dao);
    killer->add("potential", pot);
    message_vision(HIC "$N" + HIC + "仰天长啸：不甘心啊！！\n" NOR, me);
    message(
      "channel:chat",
      YEL "【镇魔塔林中心】" + HIR + "" + me->query("name") + "力战魔祖无天,千难万险之下终于把魔头消灭了！\n" NOR,
      users()
    );
    tell_object(killer, HIM "你得到了" + chinese_number(exp)
      + "点武学经验" + chinese_number(pot) +
      "点潜能、" + COMBAT_D->chinese_daoxing(dao) + "道行的奖励!\n" NOR);
    if ((int)killer->query("PKSS") > 0) {
      killer->set("PKSS", -2000);
      tell_object(killer, HIM "恭喜你杀死魔祖无天获得大量善值！\n" NOR);
    }
    if (random(10) == 1) {
      d = random(2);
      if (d > 1) d = 1;
      switch (d) {
        case 0:
          if (!ps = find_object("/u/xdao/maze/maze4/obj/xuemobook2.lpc"))
            ps = new("/u/xdao/maze/maze4/obj/xuemobook2.lpc"); break;
        case 1:
          if (!ps = find_object("/u/xdao/maze/maze4/obj/fobook2.lpc"))
            ps = new("/u/xdao/maze/maze4/obj/fobook2.lpc"); break;
      }
      if (objectp(ps)) ps->move(killer);
      message_vision("\n" HIY "       魔气消散只见一本$n" + HIY + "化作一道金光的落在了$N的怀里！\n" NOR, killer, ps);
    } else if (random(30) == 1) {
      d = random(2);
      if (d > 1) d = 1;
      switch (d) {
        case 0:
          if (!ps = find_object("/u/xdao/maze/maze4/obj/xuemobook3.lpc"))
            ps = new("/u/xdao/maze/maze4/obj/xuemobook3.lpc"); break;
        case 1:
          if (!ps = find_object("/u/xdao/maze/maze4/obj/fobook3.lpc"))
            ps = new("/u/xdao/maze/maze4/obj/fobook3.lpc"); break;
      }
      if (objectp(ps)) ps->move(killer);
      message_vision("\n" HIY "       魔气消散只见一本$n" + HIY + "化作一道金光的落在了$N的怀里！\n" NOR, killer, ps);
    } else {
      d = random(2);
      if (d > 1) d = 1;
      switch (d) {
        case 0:
          if (!ps = find_object("/u/xdao/maze/maze4/obj/xuemobook1.lpc"))
            ps = new("/u/xdao/maze/maze4/obj/xuemobook1.lpc"); break;
        case 1:
          if (!ps = find_object("/u/xdao/maze/maze4/obj/fobook1.lpc"))
            ps = new("/u/xdao/maze/maze4/obj/fobook1.lpc"); break;
      }
      if (objectp(ps)) ps->move(killer);
      message_vision("\n" HIY "       魔气消散只见一本$n" + HIY + "化作一道金光的落在了$N的怀里！\n" NOR, killer, ps);
    }
    message_vision(HIC "突然一阵佛光从天而降罩住了$N，佛光散去，$N也消失不见了！！\n" NOR, killer);
    sl = new("/u/xdao/maze/maze4/obj/sl.lpc");
    if (sl) sl->move("/u/xdao/maze/maze4/mishi");
    killer->move("/u/xdao/maze/maze4/mishi");
  }

  destruct(me);
}
