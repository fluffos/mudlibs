inherit ROOM;
#include <ansi.h>

void create()
{
        set("short", "归墟秘境");
         set ("long", @LONG
终于穿过了混沌虚空，这里是归墟秘境，传说中的紫霄宫就坐落于此。
前方似乎有一座宫殿，快去瞧瞧！
LONG);
set("exits", ([ /* sizeof() == 2 */
      "out": __DIR__"z"+sprintf("%d", 1+random(46)), 
      "enter": __DIR__"zixiaogong", 
        ]));
set("xukong",1);
setup();
}

int valid_leave(object me, string dir)
{
int i;
object* inv;
inv = all_inventory(this_player());
for(i=0; i<sizeof(inv); i++)
        if ( dir == "enter"&&userp(inv[i]))
        {
                         message_vision(HIM"一股强大的力量阻止了你。\n"NOR,this_player());
                         me->start_busy(3);
                         return notify_fail("");
         }
            return ::valid_leave(me, dir);
}

