
#include <weapon.h>
#include <ansi.h>
inherit STICK;

void create()
{
        set_name(HIY"龙王棍"NOR, ({"dragon stick", "stick" }));
        set_weight(5000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long",HIR"龙年吉祥，万事如意。"NOR);
                set("value", 500);
                set("no_put", 1);
                set("no_sell", 1);
                set("material", "steel");
                set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中。\n");
                set("unwield_msg", "$N将手中的$n插回剑鞘。\n");
        }
        init_stick(220);
        setup();
}

