inherit ITEM;
inherit F_SAVE;
#include <ansi.h>

void create(string owner) {
  if (owner) set("owner", owner);
  if (!restore()) {
    set_name(HIW "封印天碑" NOR, ({ "tian bei", "bei" }));
  } else {
    set_name(HIM + owner + "天碑" NOR, ({ "tian bei", "bei" }));
  }
  set("unit", "块");
  set("no_get", 1);
  set("no_clean_up", 1);
  seteuid(getuid());
}

string query_save_file() { return DATA_DIR + "hgs/owner.o"; }

void init() {
  add_action("add_owner", "relieve");
}

int add_owner(string arg) {
  object me = this_object();
  object who = this_player();

  if (!userp(who)) return 0;
  if (!me->query_temp("hgs2_begin")) {
    tell_object(who, "战役未开启不能解封！！！。\n");
    return 0;
  }

  if (me->query_temp("relieve")) {
    tell_object(who, "已经有人在解封印了！！！。\n");
    return 0;
  }
  if (who->query_temp("relieve")) {
    tell_object(who, "你已经在解封印了！！！。\n");
    return 0;
  }
  if (!who->query_temp("hgs2_begin")) {
    tell_object(who, "你是怎么进来的？！。\n");
    return 0;
  }

  message(
    "channel:chat",
    MAG "【花果山内】" + CYN + "" + who->query("name") + "运起法力祭向天碑，试图揭开天碑的封印!\n" NOR,
    users()
  );
  me->set_temp("relieve", 1);
  who->set_temp("relieve", 1);
  who->set_temp("no_move", 150);
  remove_call_out("finish");
  call_out("finish", 120, me, who);
}

void finish(object me, object who) {
  object *player;
  string banghui;
  int m, i;
  player = users();
  m = sizeof(player);
  if (!me) return 0;
  if (!who) return 0;
  if (environment(me) != environment(who)) {
    message(
      "channel:chat",
      MAG "【花果山内】" + CYN + "" + who->query("name") + "功亏一篑!解除花果山封印失败了！\n" NOR,
      users()
    );
    call_out("finish2", 1, me);
    return 0;
  }
  if (!(banghui = who->query("banghui"))) {
    message(
      "channel:chat",
      MAG "【花果山内】" + CYN + "" + who->query("name") + "成功解除了花果山的封印，从今往后花果山内资源由" + who->query("name") + "独享！\n" NOR,
      users()
    );
    for (i = 0; i < m; i++) {
      if (player[i]->query_temp("hgs2_begin") && player[i] != who) {
        player[i]->remove_all_killer();
        player[i]->delete_temp("hgs2_begin");
        player[i]->move("/d/city/kezhan");
      }
    }
    who->delete_temp("hgs2_begin");
    who->remove_all_killer();
    who->delete_temp("relieve");
    who->delete_temp("no_move");
    call_out("close", 0, me, who);
  } else {
    message(
      "channel:chat",
      MAG "【花果山内】" + CYN + "" + banghui + "公会成功解除了花果山的封印，从今往后花果山内资源由" + banghui + "公会独享！\n" NOR,
      users()
    );
    for (i = 0; i < m; i++) {
      if (player[i]->query_temp("hgs2_begin")) {
        player[i]->remove_all_killer();
        player[i]->delete_temp("hgs2_begin");
        if (player[i]->query("banghui") != banghui)
          player[i]->move("/d/city/kezhan");
      }
    }
    who->delete_temp("relieve");
    who->delete_temp("no_move");
    call_out("close", 0, me, who);
  }
}
void finish2(object me) {
  me->delete_temp("relieve");
}

void close(object me, object who) {
  if (!me) return 0;
  if (!who) return 0;
  if (who->query("banghui")) me->set("owner", who->query("banghui"));
  else me->set("owner", me);
  me->delete_temp("hgs2_begin");
  me->save();
}
