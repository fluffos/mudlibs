#include <ansi.h>
inherit NPC;
string ask_me();

void create() {
  set_name(HIC "补偿大使" NOR, ({ "buchang dashi", "dashi" }));
  set("nickname", HIR "请大家支持花卉" NOR);
  set("title", HIM "花卉西游" NOR);
  set("gender", "男性");
  set("age", 18);
  set("long", YEL "ask buchang获得当机补偿。\n" NOR);
  //   set("shen_type", 1);
  set("combat_exp", 1000000);
  set("str", 30);
  set("dex", 30);
  set("con", 30);
  set("int", 30);
  set("per", 30);
  set("attitude", "friendly");
  set("inquiry", ([
    "buchang": (: ask_me :),
  ]));
  setup();
  carry_object("/d/obj/cloth/magua")->wear();
}



string ask_me() {
  object me = this_player();
  object ob, ob1;

  if (!userp(me)) return "一边玩去。";
  if ((int)me->query("age") < 16) return "你还没资格领取补偿。";
  if (me->query("2010buchang"))
    return "呵呵～你已经领过补偿了,请继续支持花卉！";
  me->set("2010buchang", 1);
  me->add("potential", 100000);
  me->add("bs_ys", 30);
  me->add("bs_fsl", 5);
  me->add("bs_zf", 5);
  me->add("bs_lh", 5);
  me->add("bs_tq", 5);
  me->add("bs_tj", 5);
  me->add("c_balance", 20000000);
  tell_object(me, HIR " 你得到了10万潜能、30颗原石、成品宝石各5颗和2000两黄金的当机补偿！\n" NOR);
  message_vision(HIW "花卉西游巫师组祝$N玩的开心！请继续支持我们！\n" NOR, me);
}
