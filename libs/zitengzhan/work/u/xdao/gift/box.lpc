#include <ansi.h>
inherit ITEM;

int do_open(string);
void create() {
  set_name(HIM "元宵宝箱" NOR, ({ "yuanxiao box", "box" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "一只充满魔力的神奇宝箱，你可以打开(open)它试试运气。\n");
    set("no_sell", 1);
  }
  setup();
}

void init() {
  add_action("do_open", "open");
}

int do_open(string arg) {
  object ob = this_object();
  object me = this_player();
  object qs;

  message_vision(HIW "$N身手往" HIG "元宵宝箱" HIW "里使劲的摸，一会儿摸出一件东西藏进了怀里。\n" NOR, me);
  qs = new("/d/npc/vr_room/obj/book4");
  if (qs) qs->move(me);
  tell_object(me, HIM "你得到了一本" HIW "修仙秘籍" HIM "的奖励。\n" NOR);
  destruct(this_object());
  return 1;
}
