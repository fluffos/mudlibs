#include <ansi.h>
//#include "valid_kill.h";
inherit SSERVER;

int cast(object me, object target)
{
        object *enemy;
        string callname;
        int level,tlevel,i;
        
         if( !me->query("dujie/time") )
                return notify_fail("你还未掌握时间法则!\n");

         if( !wizardp(me) && environment(me)->query("no_fight") )
                return notify_fail("这里不准战斗。\n");
         
         if( !me->is_fighting() )
                return notify_fail("掌控时间只能在战斗中使用!\n");

       if( time()-(int)me->query_temp("djtime_end") < 15 )
                return notify_fail("绝招用多就不灵了！\n");

         level = (int)me->query("dujie/time");
         if( level < 5)
          {
        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展时间法则？\n");

         if(target->is_busy())
                return notify_fail("对方已经够忙了，没必要再施展时间法则!\n");
            
        callname = RANK_D->query_rude(target);
        tlevel = (int)target->query("dujie/time");
        message_vision(HIW"$N对着$n"+HIW+"喝道"+ callname + "让你知道法则的威力！\n                    "+level+"重时间法则·····禁！\n"NOR, me, target);        
        level -= tlevel;
        if (level < 1){
        message_vision(HIW"$N冷笑一声：比时间法则？！你远不如我！【时间法则··破禁】！\n"NOR, target);        
               }
       else
            {
          message_vision(HIM"$N"+HIM+"当场动弹不得感觉似乎时间停止了。\n"NOR, target);        
        target->start_busy(level);
        me->set_temp("djtime_end",time());
             }
         }
         else 
           {
             enemy=me->query_enemy();
                    message_vision(HIW"\n    只见$N凝空而立，挥手间一道波纹向四周扩散，居然是时间法则全禁制波动！\n"NOR, me);        
                   for(i=0;i<sizeof(enemy);i++)
                    {
                    tlevel = (int)enemy[i]->query("dujie/time");
                     level -= tlevel;
                     if (level > 0)
                      {       
                      enemy[i]->start_busy(level);
          message_vision(HIM""+enemy[i]->query("name")+""+HIM+"当场动弹不得感觉似乎时间停止了。\n"NOR, me);     
                        }
                   else
                        {
         message_vision(HIW"$N冷笑一声：比时间法则？！你远不如我！【时间法则··破禁】！\n"NOR, enemy[i]);        
                        }  
                     }
        me->set_temp("djtime_end",time());
             }
return 1;
}
