inherit ROOM;
#include <ansi.h>
void create()
{
        set("short", "蛇洞内");
         set ("long", @LONG
整个蛇洞犹如巨大的迷宫，周围杂草丛生，草丛里不时传来悉悉索索的声音。
越往里走，越是黑暗。阵阵阴风从洞内深处吹来，让人不禁而寒。
LONG);
if(random(2)==1) set("exits/north", __DIR__"s"+sprintf("%d", random(36)));
if(random(2)==1) set("exits/east", __DIR__"s"+sprintf("%d", random(36)));
if(random(2)==1) set("exits/west", __DIR__"s"+sprintf("%d", random(36)));
if(random(2)==1) set("exits/south", __DIR__"s"+sprintf("%d", random(36)));
if(!query("exits")) set("exits/out","/d/southern/wutai/guandao3"); 
  set("objects", ([ 
      "/d/npc/vr_room/0501/guard.lpc" : 2+random(2),
        ]));
if(random(10)==1) set("baowu",1);
if(random(10)==1) set("xianjin",1);
        setup();
}

int reset()
{
::reset();
if(random(2)==1) set("exits/north", __DIR__"s"+sprintf("%d", random(36)));
if(random(2)==1) set("exits/east", __DIR__"s"+sprintf("%d", random(36)));
if(random(2)==1) set("exits/west", __DIR__"s"+sprintf("%d", random(36)));
if(random(2)==1) set("exits/south", __DIR__"s"+sprintf("%d", random(36)));
if(!query("exits")) set("exits/out","/d/southern/wutai/guandao3"); 
if(random(10)==1) set("baowu",1);
if(random(10)==1) set("xianjin",1);
}

void init()
{
object me = this_player();
object ob = this_object();
object box;
if(!userp(me)) return 0;

if(ob->query("baowu")) {
        message_vision("$N眼前一亮，居然发现一只宝箱！赶快打开(open box)它看看。\n", me);
        box = new("/d/npc/vr_room/obj/box1");
        if(objectp(box)) box->move(ob);
        ob->delete("baowu");
         }
if(ob->query("xianjin")) {
        message_vision("匆忙之中$N踩中了机关，顿时无数火舌席卷而来，烧的$N遍体鳞伤。\n", me);
        me->add("kee",-(int)me->query("max_kee")/5);
         }

}

