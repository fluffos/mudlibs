
#include <armor.h>
#include <ansi.h>

inherit NECK;

void create()
{
        set_name(HIY"龙骨项圈"NOR, ({"dragon neck","neck"}));
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("material", "cloth");
                set("unit", "条");
                set("long",HIR"龙年吉祥，万事如意。"NOR);
                set("value", 500);
                set("no_put", 1);
                set("no_sell", 1);
                  set("armor_prop/armor", 50);
        }
        setup();
}


