#include <ansi.h>
#include "/adm/daemons/timed.lpc";
inherit NPC;
string ask_me();

void create() {
  set_name(HIW "虎神" NOR, ({ "gift tiger", "tiger" }));
  set("nickname", HIR "虎年吉祥，万事如意" NOR);
  set("title", HIY "十二生肖" NOR);
  set("gender", "男性");
  set("age", 18);
  set("long", YEL "虎年礼物使者，Ask gift获得新年礼物。\n" NOR);
  //   set("shen_type", 1);
  set("combat_exp", 1000000);
  set("str", 30);
  set("dex", 30);
  set("con", 30);
  set("int", 30);
  set("per", 30);
  set("attitude", "friendly");
  set("inquiry", ([
    "time": (: ask_me :),
  ]));
  setup();
  carry_object("/d/obj/cloth/magua")->wear();
}



string ask_me() {
  object me = this_player();
  object ob, ob1;
  int ticktime = 2000;
  CHANNEL_D->do_channel(this_object(), "sys", report_str(ticktime) + "后销毁迷宫。。。");
}
