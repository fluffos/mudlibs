
#include <ansi.h>

varargs int teamk(object killer, int exp)
{
object *team;
int i,dao,pot;
int dexp;
team = killer->query_team();
        if(sizeof(team) >1) 
     {
dexp = exp;
if(dexp < 1) dexp = 1;
exp = 1;
for (i=0;i<sizeof(team);i++)
{
if (objectp(team[i])) {
      if( environment(killer) == environment(team[i]) && killer != team[i] && query_ip_name(killer) != query_ip_name(team[i]) )
    {
exp += dexp/4;
   }
}
}
       if(exp < 1) exp = 1;
       dao = exp;
       pot = exp/3;
      if(pot < 1) pot = 1;
       for(i=0;i<sizeof(team);i++)
       {
        if(team[i])
          {
        if( environment(killer) == environment(team[i]))
               {
         team[i]->add("combat_exp",exp);
         team[i]->add("daoxing",exp);
         team[i]->add("potential",exp);
tell_object(team[i], HIM"在全体队员的努力下你分配到了"+chinese_number(exp)
                            +"点武学经验"+chinese_number(pot)+
                            "点潜能、"+COMBAT_D->chinese_daoxing(dao)+"道行的奖励!\n"NOR);
        if(team[i]->query("pdizi")&&killer->query("pmasterid"))
         {
        if(killer->query("pmasterid") == team[i]->query("id") 
               && query_ip_name(killer)!=query_ip_name(team[i])
               && killer->query("name") == team[i]->query("pdizi/"+killer->query("id")))
                    {
             team[i]->add("qinmidu",1);
         tell_object(team[i], HIW"通过这次战斗你与徒弟"+killer->query("name")+"的亲密度上升了!\n"NOR);
                    }
         }
        if(team[i]->query("pmasterid")&&killer->query("pdizi"))
         {
        if(team[i]->query("pmasterid") == killer->query("id") 
               && query_ip_name(killer)!=query_ip_name(team[i])
               && team[i]->query("name") == killer->query("pdizi/"+team[i]->query("id")))
                    {
             killer->add("qinmidu",1);
         tell_object(killer, HIW"通过这次战斗你与徒弟"+team[i]->query("name")+"的亲密度上升了!\n"NOR);
                    }
         }
                }
           }
         }
       }
    return 1;
 }


