#include <ansi.h>
#include <localtime.h>

inherit NPC;
int do_fight();

void create() {
  set_name(HIC "花卉活动使者" NOR, ({ "flower npc", "npc" }));
  set("long", HIC "花卉西游的形象大使。\n" NOR);
  set("per", 100);
  set("age", 30);
  set("attitude", "peaceful");

  set("gender", "男性");
  set("title", HIY "沙场点兵" NOR);
  set("max_kee", 5000);
  set("max_sen", 5000);
  set("combat_exp", 15000000);
  set("baolv", 1);
  set("daoxing", 15000000);

  set("inquiry", ([ /* sizeof() == 2 */
    "fight": (: do_fight :),
  ]));

  setup();
}


int do_fight() {
  object ob = this_object();
  object me = this_player();
  object sleeveroom, attroom;
  string sname;
  mixed *lt;
  int i, time;

  time = time();
  lt = localtime(time);

  if (!userp(me)) return 0;

  if (me->query_temp("dujie_begin") || me->query_temp("jbd_begin") || me->query_temp("ljs_begin") || me->query_temp("hgs_begin")) {
    tell_object(me, HIC "花卉大使对你说道：你似乎不应该在这里吧！\n" NOR);
    return 1;
  }

  if (time() - (int)me->query_temp("end_yanlian") < 600) {
    tell_object(me, HIC "花卉大使对你说道：你不是刚进去过嘛！\n" NOR);
    return 1;
  }

  if ((int)me->query("yanlian/oneday") > (5 + (int)me->query_temp("gift_yanlian"))
    && lt[LT_MDAY] == me->query("yanlian/whichdate")) {
    tell_object(me, HIC "花卉大使对你说道：你今日的沙场点兵任务额度已满，明天再来吧！\n" NOR);
    return 1;
  }

  if ((int)me->query("combat_exp") < 5000000) {
    tell_object(me, HIC "花卉大使对你说道：你经验太低了！\n" NOR);
    return 1;
  }

  if ((int)me->query("combatd_exp") > 500000000) {
    tell_object(me, HIC "花卉大使对你说道：你经验太高了！\n" NOR);
    return 1;
  }

  sleeveroom = load_object("/d/wiz/sleeveroom1");  //开始创建演练场
  if (!sleeveroom) {
    tell_object(me, HIC "花卉大使说道：读取文件出错请联系在线wiz！\n" NOR);
    return 1;
  }
  sname = me->query("id") + "'s attroom";
  if (!attroom = present(sname, sleeveroom))
    attroom = new("/u/xdao/yanlian/attroom.lpc");
  if (!attroom) {
    tell_object(me, HIC "花卉大使说道：演练场读取错误请联系在线wiz！\n" NOR);
    return 1;
  }
  attroom->set_name(attroom->query("name"), ({ sname, "attroom" }));
  if (!attroom->move(sleeveroom)) {
    tell_object(me, HIC "花卉大使说道：目前演练场的人数太多了请稍后再试！\n" NOR);
    destruct(attroom);
    return 1;
  }

  message_vision(CYN "\n花卉大使说道：这位" + RANK_D->query_respect(me) + "你算问对人了！近日大唐皇帝开举武状元。\n" NOR, me);
  message_vision(CYN "               特设一处演练场供各路英豪一展身手，$N既然有此兴趣我便送你进去。\n" NOR, me);
  message_vision(CYN "\n       无数花瓣飘落，清香四溢。。。$N消失不见了。\n" NOR, me);

  if (!me->move(attroom)) {
    tell_object(me, HIC "花卉大使说道：进入演练场失败请联系在线wiz！\n" NOR);
    destruct(attroom);
    return 1;
  } else {
    if (lt[LT_MDAY] != me->query("yanlian/whichdate"))  //每天清空任务状态
    {
      me->set("yanlian/whichdate", lt[LT_MDAY]);
      me->delete("yanlian/oneday");
    }
    me->add("yanlian/oneday", 1);
    attroom->do_start(me);
  }
}



void die() {
  set("eff_kee", 5000);
  set("eff_gin", 5000);
  set("eff_sen", 5000);
  set("kee", 5000);
  set("gin", 5000);
  set("sen", 5000);
  set("force", 12000);
  set("mana", 12000);
}

void unconcious() {
  die();
}
