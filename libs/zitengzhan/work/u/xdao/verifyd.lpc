public void task_verify_fail(object ob) {
  ob->delete_temp("task_verify_result");
  ob->delete_temp("task_verify_graph");
  tell_object(ob, HIW "很遗憾，你输入的字符不正确！\n" NOR);
}

/*==============================================================================
  迷宫入口验证
==============================================================================*/
public string vr_room_set_verify_string(object ob) {
  string *key;
  string result, result1, result2, result12;
  string graph, graph1, graph2, graph12, graph_temp;

  key = keys(verify_strings_symbol);
  result1 = key[random(sizeof(key))];
  graph1 = verify_strings_symbol[result1];
  if (strlen(graph1) > 420) {
    graph1 = replace_string(
      graph1,
      "幻",
      all_symbols[random(sizeof(all_symbols))] + all_symbols[random(sizeof(all_symbols))],
      1,
      100 + random(5)
    );
    graph1 = replace_string(graph1, "幻", all_words[random(sizeof(all_words))], 1, 100 + random(5));
    graph1 = replace_string(
      graph1,
      "幻",
      all_symbols[random(sizeof(all_symbols))] + all_symbols[random(sizeof(all_symbols))],
      1,
      100 + random(5)
    );
    graph1 = replace_string(graph1, "幻", all_words[random(sizeof(all_words))], 1, 100 + random(5));
  } else if (strlen(graph1) > 220) {
    graph1 = replace_string(
      graph1,
      "幻",
      all_symbols[random(sizeof(all_symbols))] + all_symbols[random(sizeof(all_symbols))],
      1,
      50 + random(5)
    );
    graph1 = replace_string(graph1, "幻", all_words[random(sizeof(all_words))], 1, 50 + random(5));
    graph1 = replace_string(
      graph1,
      "幻",
      all_symbols[random(sizeof(all_symbols))] + all_symbols[random(sizeof(all_symbols))],
      1,
      50 + random(5)
    );
    graph1 = replace_string(graph1, "幻", all_words[random(sizeof(all_words))], 1, 50 + random(5));
  } else if (strlen(graph1) > 120) {
    graph1 = replace_string(
      graph1,
      "幻",
      all_symbols[random(sizeof(all_symbols))] + all_symbols[random(sizeof(all_symbols))],
      1,
      20 + random(5)
    );
    graph1 = replace_string(graph1, "幻", all_words[random(sizeof(all_words))], 1, 20 + random(5));
    graph1 = replace_string(
      graph1,
      "幻",
      all_symbols[random(sizeof(all_symbols))] + all_symbols[random(sizeof(all_symbols))],
      1,
      20 + random(5)
    );
    graph1 = replace_string(graph1, "幻", all_words[random(sizeof(all_words))], 1, 20 + random(5));
  } else if (strlen(graph1) > 70) {
    graph1 = replace_string(
      graph1,
      "幻",
      all_symbols[random(sizeof(all_symbols))] + all_symbols[random(sizeof(all_symbols))],
      1,
      10 + random(5)
    );
    graph1 = replace_string(graph1, "幻", all_words[random(sizeof(all_words))], 1, 10 + random(5));
    graph1 = replace_string(
      graph1,
      "幻",
      all_symbols[random(sizeof(all_symbols))] + all_symbols[random(sizeof(all_symbols))],
      1,
      10 + random(5)
    );
    graph1 = replace_string(graph1, "幻", all_words[random(sizeof(all_words))], 1, 10 + random(5));
  } else {
    graph1 = replace_string(
      graph1,
      "幻",
      all_symbols[random(sizeof(all_symbols))] + all_symbols[random(sizeof(all_symbols))],
      1,
      10 + random(5)
    );
    graph1 = replace_string(graph1, "幻", all_words[random(sizeof(all_words))], 1, 10 + random(5));
  }
  if (random(10) > 5) {
    key = keys(verify_strings_word);
    result2 = key[random(sizeof(key))];
    graph2 = verify_strings_word[result2];
  } else {
    result2 = key[random(sizeof(key))];
    else if (strlen(graph2) > 70) {
      graph2 = replace_string(
        graph2,
        "幻",
        all_symbols[random(sizeof(all_symbols))] + all_symbols[random(sizeof(all_symbols))],
        1,
        10 + random(5)
      );
      graph2 = replace_string(graph2, "幻", all_words[random(sizeof(all_words))], 1, 10 + random(5));
      graph2 = replace_string(
        graph2,
        "幻",
        all_symbols[random(sizeof(all_symbols))] + all_symbols[random(sizeof(all_symbols))],
