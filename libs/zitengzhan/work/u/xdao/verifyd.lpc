    result = result1 + result2;

    key = keys(verify_strings_balnk);
    result12 = key[random(sizeof(key))];
    graph12 = verify_strings_balnk[result12];
    sscanf(result12, "%d", temp);
    graph_temp = mix_str(graph12, graph2, temp);
    graph = mix_str(graph1, graph_temp, 36);

    ob->set_temp("vr_room_verify_result", result);
    return graph;
  }

  public void vr_room_verify_string(object ob) {
    vr_room_set_verify_string(ob);
    tell_object(ob, ob->query_temp("vr_room_verify_graph"));
    tell_object(ob, HIC "  请输入 " HIR "vv + <屏幕字符>" HIY " 进入迷宫！！！(例如：vv AC)\n" NOR);
    tell_object(ob, HIC "  不区分大小写！！你可以重新尝试！(验证成功进入迷宫，失败有三秒的致忙)\n" NOR);
  }

  public void vr_room_verify_reward(object ob) {
    object obj;
    int lve;
    lve = 0;
    lev = ob->query("lunhui_zhuanshi");
    ob->delete_temp("vr_room_verify_result");
    ob->delete_temp("vr_room_verify_graph");
    tell_object(ob, HIY "  你输入成功！\n" NOR);
    if ((obj = get_object((string)ob->query_temp("vr_room_verify_room"))) && objectp(obj)) {
      if ((lve < obj->query("valid_enter_min_level"))) {
        tell_object(
          ob,
          "  进入" + obj->query("short") + "至少需要转世等级达到" + obj->query("valid_enter_min_level") + "！\n"
        );
      }
      if ((lve > obj->query("valid_enter_max_level"))) {
        tell_object(
          ob,
          "  进入" + obj->query("short") + "需要转世等级不超过" + obj->query("valid_enter_max_level") + "！\n"
        );
        return;
      }
    }
    ob->move((string)ob->query_temp("vr_room_verify_room"));
  }

  public void vr_room_verify_fail(object ob) {
    ob->delete_temp("vr_room_verify_result");
    ob->delete_temp("vr_room_verify_graph");
    ob->start_busy(3);
    tell_object(ob, HIW "  你输入错误！请重新输入！\n" NOR);
  }
