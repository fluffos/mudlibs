public string task_set_verify_string(object ob) {
  string *key;
  string result, result1, result2, result12;
  string graph, graph1, graph2, graph12, graph_temp;
  int temp;

  key = keys(verify_strings_symbol);
  result1 = key[random(sizeof(key))];
  graph1 = verify_strings_symbol[result1];
  if (strlen(graph1) > 420) {
    graph1 = replace_string(
      graph1,
      "幻",
      all_symbols[random(sizeof(all_symbols))] + all_symbols[random(sizeof(all_symbols))],
      1,
      100 + random(5)
    );
    graph1 = replace_string(graph1, "幻", all_words[random(sizeof(all_words))], 1, 100 + random(5));
    graph1 = replace_string(
      graph1,
      "幻",
      all_symbols[random(sizeof(all_symbols))] + all_symbols[random(sizeof(all_symbols))],
      1,
      100 + random(5)
    );
    graph1 = replace_string(graph1, "幻", all_words[random(sizeof(all_words))], 1, 100 + random(5));
  } else if (strlen(graph1) > 220) {
    graph1 = replace_string(
      graph1,
      "幻",
      all_symbols[random(sizeof(all_symbols))] + all_symbols[random(sizeof(all_symbols))],
      1,
      50 + random(5)
    );
    graph1 = replace_string(graph1, "幻", all_words[random(sizeof(all_words))], 1, 50 + random(5));
    graph1 = replace_string(
      graph1,
      "幻",
      all_symbols[random(sizeof(all_symbols))] + all_symbols[random(sizeof(all_symbols))],
      1,
      50 + random(5)
    );
    graph1 = replace_string(graph1, "幻", all_words[random(sizeof(all_words))], 1, 50 + random(5));
  } else if (strlen(graph1) > 120) {
    graph1 = replace_string(
      graph1,
      "幻",
      all_symbols[random(sizeof(all_symbols))] + all_symbols[random(sizeof(all_symbols))],
      1,
      20 + random(5)
    );
    graph1 = replace_string(graph1, "幻", all_words[random(sizeof(all_words))], 1, 20 + random(5));
    graph1 = replace_string(
      graph1,
      "幻",
      all_symbols[random(sizeof(all_symbols))] + all_symbols[random(sizeof(all_symbols))],
      1,
      20 + random(5)
    );
    graph1 = replace_string(graph1, "幻", all_words[random(sizeof(all_words))], 1, 20 + random(5));
  }
  {
    graph1 = replace_string(
      graph1,
      "幻",
      all_symbols[random(sizeof(all_symbols))] + all_symbols[random(sizeof(all_symbols))],
      1,
      10 + random(5)
    );
    graph1 = replace_string(graph1, "幻", all_words[random(sizeof(all_words))], 1, 10 + random(5));
    graph1 = replace_string(
      graph1,
      "幻",
      all_symbols[random(sizeof(all_symbols))] + all_symbols[random(sizeof(all_symbols))],
      1,
      10 + random(5)
    );
    graph1 = replace_string(graph1, "幻", all_words[random(sizeof(all_words))], 1, 10 + random(5));
  } else {
    graph1 = replace_string(
      graph1,
      "幻",
      all_symbols[random(sizeof(all_symbols))] + all_symbols[random(sizeof(all_symbols))],
      1,
      10 + random(5)
    );
    graph1 = replace_string(graph1, "幻", all_words[random(sizeof(all_words))], 1, 10 + random(5));
  }
  if (random(10) > 5) {
    key = keys(verify_strings_word);
    result2 = key[random(sizeof(key))];
    graph2 = verify_strings_word[result2];
  } else {
    result2 = key[random(sizeof(key))];
    graph2 = verify_strings_symbol[result2];
  }
  {
    graph2 = replace_string(
      graph2,
      "幻",
      all_symbols[random(sizeof(all_symbols))] + all_symbols[random(sizeof(all_symbols))],
      1,
      100 + random(5)
    );
    graph2 = replace_string(graph2, "幻", all_words[random(sizeof(all_words))], 1, 100 + random(5));
    graph2 = replace_string(
      graph2,
      "幻",
      all_symbols[random(sizeof(all_symbols))] + all_symbols[random(sizeof(all_symbols))],
      1,
      100 + random(5)
    );
    graph2 = replace_string(graph2, "幻", all_words[random(sizeof(all_words))], 1, 100 + random(5));
  } else if (strlen(graph2) > 220) {
    graph2 = replace_string(
      graph2,
      "幻",
      all_symbols[random(sizeof(all_symbols))] + all_symbols[random(sizeof(all_symbols))],
      1,
      50 + random(5)
    );
    graph2 = replace_string(graph2, "幻", all_words[random(sizeof(all_words))], 1, 50 + random(5));
    graph2 = replace_string(
      graph2,
      "幻",
      all_symbols[random(sizeof(all_symbols))] + all_symbols[random(sizeof(all_symbols))],
      1,
      50 + random(5)
    );
    graph2 = replace_string(graph2, "幻", all_words[random(sizeof(all_words))], 1, 50 + random(5));
  } else if (strlen(graph2) > 120) {
    graph2 = replace_string(
      graph2,
      "幻",
      all_symbols[random(sizeof(all_symbols))] + all_symbols[random(sizeof(all_symbols))],
      1,
      20 + random(5)
    );
    graph2 = replace_string(graph2, "幻", all_words[random(sizeof(all_words))], 1, 20 + random(5));
    graph2 = replace_string(
      graph2,
      "幻",
      all_symbols[random(sizeof(all_symbols))] + all_symbols[random(sizeof(all_symbols))],
      1,
      20 + random(5)
    );
    graph2 = replace_string(graph2, "幻", all_words[random(sizeof(all_words))], 1, 20 + random(5));
  } else if (strlen(graph2) > 70) {
    graph2 = replace_string(
      graph2,
      "幻",
      all_symbols[random(sizeof(all_symbols))] + all_symbols[random(sizeof(all_symbols))],
      1,
      10 + random(5)
    );
    graph2 = replace_string(graph2, "幻", all_words[random(sizeof(all_words))], 1, 10 + random(5));
    graph2 = replace_string(
      graph2,
      "幻",
      all_symbols[random(sizeof(all_symbols))] + all_symbols[random(sizeof(all_symbols))],
      1,
      10 + random(5)
    );
    graph2 = replace_string(graph2, "幻", all_words[random(sizeof(all_words))], 1, 10 + random(5));
  } else {
    graph2 = replace_string(
      graph2,
      "幻",
      all_symbols[random(sizeof(all_symbols))] + all_symbols[random(sizeof(all_symbols))],
      1,
      10 + random(5)
    );
    graph2 = replace_string(graph2, "幻", all_words[random(sizeof(all_words))], 1, 10 + random(5));
  }
  result = result1 + result2;

  key = keys(verify_strings_balnk);
  result12 = key[random(sizeof(key))];
  graph12 = verify_strings_balnk[result12];
  sscanf(result12, "%d", temp);
  graph_temp = mix_str(graph12, graph2, temp);
  graph = mix_str(graph1, graph_temp, 36);
  ob->set_temp("task_verify_result", result);
  ob->set_temp("task_verify_graph", graph);
  return graph;
}
{
  task_set_verify_string(ob);
  tell_object(ob, ob->query_temp("task_verify_graph"));
  tell_object(ob, HIY "  恭喜你完成一轮任务，请输入 " HIR "vf + <屏幕字符>" HIY " 获得特殊奖励！！！(例如：vf AC)\n" NOR);
  tell_object(ob, HIY "  注：不区分大小写，只有一次机会！！(验证答案有两秒的致忙)\n" NOR);
}

