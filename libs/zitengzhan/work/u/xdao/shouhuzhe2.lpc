#include <ansi.h>;
inherit NPC;
#include "star.h"


void create() {
  set_name("凤凰神", ({ "shouhuzhe", "shouhu zhe", "zhe" }));
  set("gender", "男性");
  set("long",
    "守护第二重天的守护者----大雪山凤凰神\n"
  );
  set("str", 20);
  set("per", 130);
  set("age", 86);
  set("cor", 30);
  set("family/family_name", "大雪山");

  set("cps", 75);
  set("kar", 100);
  set("int", 40);
  set("con", 40);
  set("spi", 40);
  set("title", "守护者");
  set("combat_exp", 1200000);
  set("daoxing", 1200000);
  set("max_sen", 4000);
  set("max_kee", 4000);
  set("force", 4000);
  set("max_force", 400);
  set("force_factor", 40);
  set("max_mana", 400);
  set("mana", 400);
  set("mana_factor", 50);

  set_skill("unarmed", 250);
  set_skill("cuixin-zhang", 250);
  set_skill("dodge", 250);
  set_skill("xiaoyaoyou", 250);
  set_skill("parry", 250);
  set_skill("sword", 250);
  set_skill("bainiao-jian", 250);
  set_skill("blade", 250);
  set_skill("bingpo-blade", 250);
  set_skill("throwing", 250);
  set_skill("force", 250);
  set_skill("ningxie-force", 250);
  set_skill("literate", 250);
  set_skill("spells", 250);
  set_skill("dengxian-dafa", 250);
  map_skill("spells", "dengxian-dafa");
  map_skill("force", "ningxie-force");
  map_skill("unarmed", "cuixin-zhang");
  map_skill("sword", "bainiao-jian");
  map_skill("blade", "bingpo-blade");
  map_skill("dodge", "xiaoyaoyou");
  set("chat_chance_combat", 50);
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "sword", "feijian" :),

    (: cast_spell, "tuntian" :),
  }));
  setup();
  carry_object("/d/obj/weapon/sword/qingfeng")->wield();
  carry_object("/d/obj/armor/jinjia")->wear();
}


void init() {
  add_action("do_none", "perform");
  add_action("do_none", "cast");
  add_action("do_none", "ji");
}
int do_none() {
  object me = this_object();
  message_vision("此乃天界，岂容你乱来？\n", me);
  return 1;
}

void die() {

  object ob = query_temp("my_killer");

  if ((ob && ob->query("9sky/yi") == "done") && (ob && ob->query("9sky/er") != "done")) {
    ob->start_busy(3);
    message("chat", HIY + "【九重天】天极(Tian ji):" + ob->name() +
      "闯过了二重·巴蜀天\n" NOR, users());
    ob->set("9sky/er", "done");
    ob->add("9sky/number", 1);
    ob->add("daoxing", 20000);
    ob->save();
    tell_object(ob, "你赢得了二十年道行");

  }
  ::die();
}
