inherit ROOM;
#include <ansi.h>;
#define ZY "/u/xdao/jbd/obj/zhanyi" 
#define TB "/u/xdao/jbd/obj/tianbei" 

void create()
{
        set("short", "通天道场入口");
         set ("long", @LONG
这里便是金鳖岛，相传乃截教圣人通天道人的道场。此处灵气充沛，一派仙家气象。
但自从封神之战过后，截教失利，通天道人被鸿钧道祖带回紫霄宫。偌大的金鳖岛就
被通天道人封印了起来，再也不复昔日万仙来朝的景象了。
LONG);
set("outdoors", 1);                     
set("exits", ([
      "south": __DIR__"jbd-4", 
      "enter": __DIR__"tt-enter", 
        ]));
set("no_fight",1);
set("no_magic",1);
        setup();
}

int valid_leave(object who, string dir)
{
int i;
object *inv;
object zy,tianbei;

if( dir != "enter")
 return ::valid_leave(who,dir);

inv = all_inventory(this_player());
for(i=0; i<sizeof(inv); i++)
        if ( dir == "enter"&&userp(inv[i]))
        {
                         message_vision(HIM"一股强大的力量阻止了你。\n"NOR,this_player());
                         who->start_busy(3);
                         return notify_fail("");
         }

if(who->query_temp("dujie_begin"))
     return notify_fail(HIW"  安心度劫吧！\n"NOR);

     if(!who->query("banghui"))
     return notify_fail(HIW"  无公会者不得入内！\n"NOR);

     tianbei = new(TB);
     zy=new(ZY);
     if(objectp(tianbei)&&objectp(zy)) {
     if(tianbei->query("owner")!= who->query("banghui")&&zy->query("jbd_begin")!="done")
        {
          destruct(tianbei);
     who->start_busy(3);
     return notify_fail(HIW"  非战役期间除占领公会外不得入内！\n"NOR);
          }
                     }
            if(objectp(tianbei)) destruct(tianbei);
           if(zy->query("jbd_begin")=="done") who->set_temp("jbd_begin",1);
            if(objectp(zy)) destruct(zy);

 who->start_busy(5);
 return ::valid_leave(who,dir);                        
}


