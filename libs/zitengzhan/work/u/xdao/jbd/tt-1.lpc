inherit ROOM;
#include <ansi.h>;
void create() {
  set("short", "通道");
  set("long", @LONG
这里是通往封印中心的通道，宽阔无比！四周墙壁全是用极品仙玉铸造而成，
晶莹剔透，仙气环绕，遥想当年万仙来朝的景象，你不禁对前方更加向往。
LONG);
  set("exits", ([
    "south": __DIR__ "tt-enter",
    "north": __DIR__ "tt-2",
  ]));
  setup();
}


int valid_leave(object who, string dir) {
  object tb, zy;
  if (dir != "south")
    return ::valid_leave(who, dir);

  tb = new("/u/xdao/jbd/obj/tianbei.lpc");
  zy = new("/u/xdao/jbd/obj/zhanyi.lpc");
  if (!tb->query("owner")) {
    destruct(tb);
    destruct(zy);
    return ::valid_leave(who, dir);
  }

  if (zy->query("jbd_begin") != "done") {
    destruct(tb);
    destruct(zy);
    return ::valid_leave(who, dir);
  }

  if (!who->query("banghui")) {
    destruct(tb);
    destruct(zy);
    return ::valid_leave(who, dir);
  }

  if (tb->query("owner") != who->query("banghui")) {
    destruct(tb);
    destruct(zy);
    return ::valid_leave(who, dir);
  } else {
    destruct(tb);
    destruct(zy);
    who->start_busy(3);
    return notify_fail(HIB "你不能进去！\n" NOR);
  }
  if (tb) destruct(tb);
  if (zy) destruct(zy);
  return ::valid_leave(who, dir);
}
