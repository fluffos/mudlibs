#include <ansi.h>
inherit NPC;

string *first_name = ({ "古剑", "灵剑", "巨剑" });
string *first_id = ({ "gujian", "lingjian", "jujian" });
string *name_words = ({ "妖", "怪", "精" });
string *id_words = ({ "yao", "guai", "jing" });
void set_hp_status(object me);

void create(object ob) {
  object me = this_object();
  string name;
  int i, j, d, p;

  d = random(sizeof(first_name));
  name = first_name[d];
  p = random(sizeof(name_words));
  name += name_words[p];
  set_name(HIB + name + NOR, ({ first_id[d] + " " + id_words[p], id_words[p] }));
  i = 200;
  j = 150;

  set("age", 20);
  set("vrm_guard", 1);
  set("long", "一把通灵兵器显化。\n");
  // set("attitude", "aggressive");
  //set("class", "yaomo");
  set("family/family_name", "月宫");
  set("gender", "女性");
  set("combat_exp", 5000000 + random(20000000));
  set("daoxing", 5000000 + random(20000000));
  set("str", 50 + random(150));
  set("max_kee", 2000 + random(5000));
  set("max_sen", 2000 + random(5000));
  set("max_force", 2000 + random(5000));
  set("force", 2000 + random(5000));
  set("max_mana", 2000 + random(5000));
  set("mana", 2000 + random(5000));
  set("food", 50000);
  set("water", 50000);
  set_weight(30000);
  set("no_steal", 1);
  set("force_factor", 100 + random(200));
  set("mana_factor", 100 + random(200));
  add_temp("apply/damage", 50 + random(150));
  set_temp("mingzhong", 20);
  add_temp("apply/armor", 200 + random(500));
  add_temp("apply/armor_vs_force", 200 + random(500));
  add_temp("apply/armor_vs_spells", 200 + random(500));
  set("title", HIG "封神遗兵" NOR);


  set_skill("moonforce", i + random(j));
  set_skill("moonshentong", i + random(j));
  set_skill("unarmed", i + random(j));
  set_skill("parry", i + random(j));
  set_skill("dodge", i + random(j));
  set_skill("force", i + random(j));
  set_skill("sword", i + random(j));
  set_skill("whip", i + random(j));
  set_skill("blade", i + random(j));
  set_skill("snowsword", i + random(j));
  set_skill("jueqingbian", i + random(j));
  set_skill("xuanhu-blade", i + random(j));
  set_skill("moondance", i + random(j));
  set_skill("baihua-zhang", i + random(j));
  set_skill("spells", i + random(j));

  me->map_skill("force", "moonforce");
  me->map_skill("sword", "snowsword");
  me->map_skill("blade", "xuanhu-blade");
  me->map_skill("whip", "jueqingbian");
  me->map_skill("parry", "jueqingbian");
  me->map_skill("spells", "moonshentong");
  me->map_skill("dodge", "moondance");
  me->map_skill("unarmed", "baihua-zhang");
  create_family("月宫", 3, "弟子");

  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: command, "say 封神。。。万仙。。。阻止。。不甘心啊。。" :),
    (: command, "perform tian" :),
    (: command, "perform feiwu" :),
  }));

  setup();
  carry_object("/d/obj/weapon/18weapon")->wield();
}


void die() {
  object me = this_object();
  object ps, newitem, qs, gold;
  object killer = query_temp("last_damage_from");
  object where = environment(me);
  string err;
  int exp, kexp, mexp, dao, pot, d;
  if (objectp(killer) && killer->query("is_guard") == 1)
    killer = killer->query("possessed");
  if (objectp(killer)) {
    kexp = killer->query("combat_exp");
    mexp = me->query("combat_exp");
    exp = mexp / 20000;
    exp += (mexp - kexp) / 20000;
    if (exp < 100) exp = 1 + random(100);
    if (exp > 2000) exp = 2000;
    dao = exp;
    if (dao < 1) dao = 1;
    pot = exp / 3;
    if (pot < 1) pot = 1;
    killer->add("combat_exp", exp);
    killer->add("daoxing", dao);
    killer->add("potential", pot);

    gold = new("/obj/money/gold");
    if (objectp(gold)) {
      gold->set_amount(1 + random(4));
      gold->move(where);
      message_vision("\n" HIY "    一些黄金掉在了地上！\n" NOR, me, killer);
    }

    if (random(500) == 1) {
      d = random(8);
      if (d > 7) d = 7;
      switch (d) {
        case 0: ps = new("/d/npc/vr_room/obj/csd.lpc"); break;
        case 1: ps = new("/d/npc/vr_room/obj/ysd.lpc"); break;
        case 2: ps = new("/d/npc/vr_room/obj/rxd.lpc"); break;
        case 3: ps = new("/d/npc/vr_room/obj/dxd.lpc"); break;
        case 4: ps = new("/d/npc/vr_room/obj/txd.lpc"); break;
        case 5: ps = new("/d/npc/vr_room/obj/lxd.lpc"); break;
        case 6: ps = new("/d/npc/vr_room/obj/hmd.lpc"); break;
        case 7: ps = new("/d/npc/vr_room/obj/hdd.lpc"); break;

      }
      if (objectp(ps)) {
        ps->move(killer);
        message_vision(
          "\n" HIY "       嘭的一声，$N" HIY "被打散了魂魄，凝聚出一枚$n" HIY "落在" + killer->query("name") + "的身上！\n" NOR,
          me,
          ps
        );
      }
    }

    if (random(20) == 1) {
      killer->set_temp("mieyao/level", 12);
      err = catch(newitem = NEWITEMS_OB->get_item(me, killer));
      if (newitem) {
        message_vision(
          "$N杀死$n得到了一" + newitem->query("unit") + newitem->query("name") + "。\n",
          killer,
          me
        );
        newitem->move(where);
      }
    }

    tell_object(killer, HIM "你得到了" + chinese_number(exp)
      + "点武学经验" + chinese_number(pot) +
      "点潜能、" + COMBAT_D->chinese_daoxing(dao) + "道行的奖励!\n" NOR);
    if (!me->query_temp("hell_juhun")) TEAMK_D->teamk(killer, exp);

    if ((int)killer->query("PKSS") > -1000) {
      killer->add("PKSS", -1);
      message_vision(HIM "$N净化了远古的怨灵，得到了一点善值。\n" NOR, killer);
    }

    if (random(3) == 1) {
      if (qs = find_object("/u/xdao/jbd/npc/yao")) {
        if (qs->move(where)) message_vision(
          "\n" HIY "       四周灵气聚集，嗡的一声凝聚成一把剑体！\n" NOR,
          me,
          killer
        );
        else destruct(qs);
      } else {
        qs = new("/u/xdao/jbd/npc/yao");
        if (qs->move(where)) message_vision(
          "\n" HIY "       四周灵气聚集，嗡的一声凝聚成一把剑体！\n" NOR,
          me,
          killer
        );
        else destruct(qs);
      }
    }
  }
  destruct(this_object());
}
