        printf(NOR RED"〖 督脉开发度 〗 %s%12-d"NOR CYN"\n"NOR,HIR,(int)me->query("dumai"));
           }
          else
        {
         printf(NOR RED"〖 督脉开发度 〗 %s%12-s    "NOR CYN"\n"NOR,HIW,"未开发");
         }  
         if (me->query("tianmai"))
         {
        printf(NOR CYN""NOR GRN"〖 天脉开发度 〗 %s%18-d"NOR,HIR,(int)me->query("tianmai"));
           }
          else
        {
         printf(NOR CYN""NOR GRN"〖 天脉开发度 〗 %s%14-s    "NOR,HIW,"未开发");
         }  
         if (me->query("dimai"))
         {
        printf(NOR GRN"〖 地脉开发度 〗 %s%12-d"NOR CYN"┃\n"NOR,HIR,(int)me->query("dimai"));
           }
          else
        {
         printf(NOR GRN"〖 地脉开发度 〗 %s%12-s    "NOR CYN"\n"NOR,HIW,"未开发");
         }  
       if (me->query("renxmai"))
         {
        printf(NOR CYN""NOR GRN"〖 人脉开发度 〗 %s%18-d"NOR,HIR,(int)me->query("renxmai"));
           }
          else
        {
         printf(NOR CYN""NOR GRN"〖 人脉开发度 〗 %s%14-s    "NOR,HIW,"未开发");
         }  
         if (me->query("lingmai"))
         {
        printf(NOR GRN"〖 灵脉开发度 〗 %s%12-d"NOR CYN"\n"NOR,HIR,(int)me->query("lingmai"));
           }
          else
        {
         printf(NOR GRN"〖 灵脉开发度 〗 %s%12-s    "NOR CYN"\n"NOR,HIW,"未开发");
         }  
         if (me->query("xinmai"))
         {
        printf(NOR CYN""NOR YEL"〖 心脉开发度 〗 %s%18-d"NOR,HIR,(int)me->query("xinmai"));
           }
          else
        {
         printf(NOR CYN""NOR YEL"〖 心脉开发度 〗 %s%14-s    "NOR,HIW,"未开发");
         }  
         if (me->query("mingmai"))
         {
        printf(NOR YEL"〖 命脉开发度 〗 %s%12-d"NOR CYN"\n"NOR,HIR,(int)me->query("mingmai"));
           }
          else
        {
         printf(NOR YEL"〖 命脉开发度 〗 %s%12-s    "NOR CYN"\n"NOR,HIW,"未开发");
         }  

        write(HIC"\n剑魂石像目前的武功等级为："+(int)me->query_skill("sword",1)+"级。\n"NOR);

return 1;
}             

int add_exp(string arg)
{
object me = this_object();
object who = this_player();
int i;

if(!userp(who)) return 0;

if(!me->query("owner"))
return notify_fail(HIY"非我金鳖岛人何故膜拜我？！\n"NOR);

if(!who->query("banghui"))
return notify_fail(HIY"非我金鳖岛人何故膜拜我？！\n"NOR);

if(who->query("banghui") != me->query("owner"))
return notify_fail(HIY"非我金鳖岛人何故膜拜我？！\n"NOR);

if(who->is_busy() || who->is_fighting())
return notify_fail(HIY"你正忙着呢！\n"NOR);

if((int)who->query("combat_exp") < 1000000 || (int)who->query("daoxing") < 1000000 )
return notify_fail(HIY"汝志可嘉，但还需努力！\n"NOR);

if((int)me->query("combat_exp") > 500000000 || (int)me->query("daoxing") > 500000000)
return notify_fail(HIY"吾神躯大成，不需要膜拜了！\n"NOR);

message_vision(HIG"$N对着剑魂石像缓缓跪了下去，膜拜了起来。\n"NOR,who);
tell_object(who, HIM"你损失了10000点武学经验和10000点道行。\n"NOR);
i = ((int)me->query("combat_exp") - 10000000)/100000;
if(i >= 1 && (int)me->query_skill("sword",1) < 1000 )
{
       me->set_skill("unarmed", 200+i);
       me->set_skill("sword", 200+i);
       me->set_skill("dodge", 200+i);
       me->set_skill("parry", 200+i);
       me->set_skill("force", 200+i);
       me->set_skill("spells", 200+i);
       me->set_skill("kaitian-zhang", 200+i);
       me->set_skill("daya-jian", 200+i);
       me->set_skill("yaofa", 200+i);
       me->set_skill("dragonforce", 200+i);
       me->set_skill("moondance", 200+i);
 }
message_vision(HIG"剑魂石像红光一闪，越发高大了起来。\n"NOR,who);
me->add("combat_exp",10000);
me->add("daoxing",10000);
me->save();
who->add("combat_exp",-10000);
who->add("daoxing",-10000);
who->save();
who->start_busy(3);
return 1;
}

int accept_object(object who, object ob)
{
        int amount,i,point,pot;
        object me = this_object();
        
         if(ob->query("money_id") == "gold" && me->query("max_kee") < 10000000)
                {
      message_vision(HIG"剑魂石像发出妖异的绿光，似乎变的更厉害了。\n"NOR,who);
            me->add("max_kee",ob->query_amount()*10);
            me->add("max_sen",ob->query_amount()*10);
            me->add("eff_sen",ob->query_amount()*10);
            me->add("sen",ob->query_amount()*10);
            me->add("eff_kee",ob->query_amount()*10);
            me->add("kee",ob->query_amount()*10);
if((int)me->query("max_kee")>10000000) {
me->set("max_kee",10000000);
me->set("max_sen",10000000);
me->set("sen",10000000);
me->set("kee",10000000);
me->set("eff_sen",10000000);
me->set("eff_kee",10000000); }
         me->save();
           call_out("destroy", 1, ob,me);
                }
          else if(ob->query("weapon_prop")&&ob->query("changed")&&ob->query("zhuoyue"))
              {
               point = (int)ob->query("weapon_prop/damage")/100;
               if(point >= 1)
                {
      message_vision(HIG"剑魂石像发出妖异的绿光，似乎变的更厉害了。\n"NOR,who);
               me->add("apply/damage",point);
               me->add_temp("apply/damage",point);
               me->add("str",1);
               me->add("force_factor", 1);
           call_out("destroy", 1, ob,me);
                }
               else
               {
      message_vision(HIG"剑魂石像发出妖异的绿光，却渐渐的又暗淡了下去。\n"NOR,who);
           call_out("destroy", 1, ob,me);
               }
               }
   else if(ob->query("weapon_prop")&&ob->query("changed"))
              {
               point = (int)ob->query("weapon_prop/damage")/100;
               if(point >= 1)
                {
      message_vision(HIG"剑魂石像发出妖异的绿光，似乎变的更厉害了。\n"NOR,who);
               me->add("apply/damage",point);
               me->add_temp("apply/damage",point);
           call_out("destroy", 1, ob,me);
                }
               else
               {
      message_vision(HIG"剑魂石像发出妖异的绿光，却渐渐的又暗淡了下去。\n"NOR,who);
           call_out("destroy", 1, ob,me);
               }
               }
   else if(ob->query("armor_prop")&&ob->query("changed")&&ob->query("zhuoyue"))
              {
               point = (int)ob->query("armor_prop/armor")/50;
               if(point >= 1)
                {
      message_vision(HIG"剑魂石像发出妖异的绿光，似乎变的更厉害了。\n"NOR,who);
               me->add("apply/armor",point);
               me->add("apply/armor_vs_force",point);
               me->add("apply/armor_vs_spells",point);
               me->add("mana_factor", 1);
               me->add_temp("apply/armor",point);
               me->add_temp("apply/armor_vs_force",point);
               me->add_temp("apply/armor_vs_spells",point);
               i=random(5);
                  switch(i)
                   {
                    case  0: 
                        if((int)me->query("apply/poison_defence") < 76 ) {
                        me->add("apply/poison_defence",1);
                        me->add_temp("apply/poison_defence",1);} break;
                    case  1: 
                        if((int)me->query("apply/fire_defence") < 76 ) {
                        me->add("apply/fire_defence",1);
                        me->add_temp("apply/fire_defence",1);} break;
                    case  2: 
                        if((int)me->query("apply/lightning_defence") < 76 ) {
                        me->add("apply/lightning_defence",1);
                        me->add_temp("apply/lightning_defence",1);} break;
                    case  3: 
                        if((int)me->query("apply/cold_defence") < 76 ) {
                        me->add("apply/cold_defence",1);
                        me->add_temp("apply/cold_defence",1);} break;
                    case  4: 
                        if((int)me->query("apply/wind_defence") < 76 ) {
                        me->add("apply/wind_defence",1);
                        me->add_temp("apply/wind_defence",1);} break;
                      }
           call_out("destroy", 1, ob,me);
                }
               else
               {
      message_vision(HIG"剑魂石像发出妖异的绿光，却渐渐的又暗淡了下去。\n"NOR,who);
           call_out("destroy", 1, ob,me);
               }
               }
   else if(ob->query("armor_prop")&&ob->query("changed"))
         {
               point = (int)ob->query("armor_prop/armor")/50;
               if(point >= 1)
                {
      message_vision(HIG"剑魂石像发出妖异的绿光，似乎变的更厉害了。\n"NOR,who);
               me->add("apply/armor",point);
               me->add("apply/armor_vs_force",point);
               me->add("apply/armor_vs_spells",point);
               me->add_temp("apply/armor",point);
               me->add_temp("apply/armor_vs_force",point);
               me->add_temp("apply/armor_vs_spells",point);
           call_out("destroy", 1, ob,me);
            }
            else
             {
      message_vision(HIG"剑魂石像发出妖异的绿光，却渐渐的又暗淡了下去。\n"NOR,who);
           call_out("destroy", 1, ob,me);
           }
       }
   else if(ob->query("id") == "fo sheli"&&ob->query("color"))
              {
      message_vision(HIG"剑魂石像发出妖异的绿光，似乎变的更厉害了。\n"NOR,who);
               me->add("apply/armor_vs_spells",1);
               me->add_temp("apply/armor_vs_spells",1);
           call_out("destroy", 1, ob,me);
                }
   else if(ob->query("id") == "soul baoshi"&&ob->query("color"))
              {
      message_vision(HIG"剑魂石像发出妖异的绿光，似乎变的更厉害了。\n"NOR,who);
               me->add("apply/armor_vs_spells",1);
               me->add_temp("apply/armor_vs_spells",1);
           call_out("destroy", 1, ob,me);
                }
   else if(ob->query("id") == "tianqing baoshi"&&ob->query("color"))
              {
      message_vision(HIG"剑魂石像发出妖异的绿光，似乎变的更厉害了。\n"NOR,who);
               me->add("apply/armor_vs_force",1);
               me->add_temp("apply/armor_vs_force",1);
           call_out("destroy", 1, ob,me);
                }
   else if(ob->query("id") == "zhufu baoshi"&&ob->query("color"))
              {
      message_vision(HIG"剑魂石像发出妖异的绿光，似乎变的更厉害了。\n"NOR,who);
               me->add("apply/armor_vs_force",1);
               me->add_temp("apply/armor_vs_force",1);
           call_out("destroy", 1, ob,me);
                }
   else if(ob->query("id") == "bao shi"&&ob->query("color"))
              {
      message_vision(HIG"剑魂石像发出妖异的绿光，似乎变的更厉害了。\n"NOR,who);
               me->add("apply/damage",1);
               me->add_temp("apply/damage",1);
           call_out("destroy", 1, ob,me);
                }
   else if(ob->query("id") == "dujie dan"&&ob->query("drug_type"))
              {
               me->add("dujienub",1);
               if((int)me->query("dujie/level")*(int)me->query("dujie/level") + 1 >= (int)me->query("dujienub") && (int)me->query("dujie/level") < 10 )
                 {
               me->add("dujie/level",1);
               me->add("dujie/power",1);
               me->add("dujie/time",1);
                message_vision(HIG"剑魂石像发出妖异的绿光，似乎变的更厉害了。\n"NOR,who);
           call_out("destroy", 1, ob,me);
                  }
                else
                {
      message_vision(HIG"剑魂石像发出妖异的绿光，却渐渐的暗淡了下去。\n"NOR,who);
           call_out("destroy", 1, ob,me);
                  }
                }
  else if(ob->query("id")=="aquamarine life"&&ob->query("statues"))
              {
               me->add("max_force",1000);
               me->add("max_mana",1000);
                message_vision(HIG"剑魂石像发出妖异的绿光，似乎变的更厉害了。\n"NOR,who);
           call_out("destroy", 1, ob,me);
                  }

            else return notify_fail(HIY"此物于我无用，不收！\n"NOR);
return 1;
}

void destroy(object ob,object me)
{
if(!ob || !me) return 0;
destruct(ob);
me->save();
return;
}


void die()
{
object me = this_object();
       me->set("max_kee", 100000);
       me->set("eff_kee",100000);
	me->set("max_sen", 100000);
       me->set("eff_sen",100000);
       me->set("kee",100000);
       me->set("sen",100000);
	me->set("max_mana", 20000);
	me->set("mana", 40000);
       me->set("combat_exp",10000000);
       me->set("daoxing",10000000);
        me->set("max_force", 20000); 
        me->set("baolv", 1);
        me->set("force", 40000);
	me->set("str", 100);
	me->set("spi", 100);
       me->set("force_factor", 100);
       me->set("mana_factor", 100);
       me->set("apply/damage",100);
       me->set("apply/armor",500);
       me->set("apply/armor_vs_force",1000);
       me->set("apply/armor_vs_spells",1000);  
       me->set("apply/poison_defence",10);
       me->set("apply/fire_defence",10);
       me->set("apply/lightning_defence",10);
       me->set("apply/wind_defence",10);
       me->set("apply/cold_defence",10);
       me->set_skill("unarmed", 200);
       me->set_skill("sword", 200);
       me->set_skill("dodge", 200);
       me->set_skill("parry", 200);
       me->set_skill("force", 200);
       me->set_skill("spells", 200);
       me->set_skill("kaitian-zhang", 200);
       me->set_skill("daya-jian", 200);
       me->set_skill("yaofa", 200);
       me->set_skill("dragonforce", 200);
       me->set_skill("moondance", 200);
       me->delete("dujie");
       me->delete("xinmai");
       me->delete("renmai");
       me->delete("dumai");
       me->delete("renxmai");
       me->delete("tianmai");
       me->delete("dimai");
       me->delete("lingmai");
       me->delete("mingmai");
       me->delete("dujienub");
       me->save();
 message_vision(HIG"剑魂石像彻底崩溃!化成石块四散飞溅。\n"NOR,me);
     destruct(me);
  }

