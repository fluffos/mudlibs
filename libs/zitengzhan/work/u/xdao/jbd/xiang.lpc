inherit NPC;
inherit F_SAVE;
#include <ansi.h>

void create()
{
        if(! restore()) {
         set_name(HIW"剑魂石像"NOR,({"statues"}));
       set("max_kee", 100000);
        set("max_sen", 100000);
        set("max_mana", 20000);
        set("mana", 40000);
       set("combat_exp",10000000);
       set("daoxing",10000000);
        set("max_force", 20000); 
        set("baolv", 1);
        set("force", 40000);
        set("str", 100);
        set("spi", 100);
       set("force_factor", 100);
       set("mana_factor", 100);
       set_temp("apply/damage",100);
       set_temp("apply/armor",500);
       set_temp("apply/armor_vs_force",1000);
       set_temp("apply/armor_vs_spells",1000);  
       set_temp("apply/poison_defence",10);
       set_temp("apply/fire_defence",10);
       set_temp("apply/lightning_defence",10);
       set_temp("apply/wind_defence",10);
       set_temp("apply/cold_defence",10);
       set("apply/damage",100);
       set("apply/armor",500);
       set("apply/armor_vs_force",1000);
       set("apply/armor_vs_spells",1000);  
       set("apply/poison_defence",10);
       set("apply/fire_defence",10);
       set("apply/lightning_defence",10);
       set("apply/wind_defence",10);
       set("apply/cold_defence",10);
   }
     else
     {
       set_temp("apply/damage",(int)query("apply/damage"));
       set_temp("apply/armor",(int)query("apply/armor"));
       set_temp("apply/armor_vs_force",(int)query("apply/armor_vs_force"));
       set_temp("apply/armor_vs_spells",(int)query("apply/armor_vs_spells"));  
       set_temp("apply/poison_defence",(int)query("apply/poison_defence"));
       set_temp("apply/fire_defence",(int)query("apply/fire_defence"));
       set_temp("apply/lightning_defence",(int)query("apply/lightning_defence"));
       set_temp("apply/wind_defence",(int)query("apply/wind_defence"));
       set_temp("apply/cold_defence",(int)query("apply/cold_defence"));
      }
       set("long","通天道人遗留下来的一尊石像，守护者金鳖岛。\n");
      if(query("owner")) set("title",HIW+query("owner")+NOR);
      else set("title",HIW"杀伐天地"NOR);
        set("chat_chance", 5);
        set("chat_msg_combat", ({
                "剑魂石像发出妖异的红芒，似乎有了生命似的。\n",
        }) );

      setup();
       save();
}

string query_save_file() { return DATA_DIR + "hgs/jianhun.o"; }

string status_color(int current, int max)
{
        int percent;

        if( max>0 ) percent = current * 100 / max;
        else percent = 100;
        if( percent > 100 ) return HIC;
        if( percent >= 90 ) return HIG;
        if( percent >= 60 ) return HIY;
        if( percent >= 30 ) return YEL;
        if( percent >= 10 ) return HIR;
        return RED;
}

string chinese_daoxing(int gain) {
            int year,day,hour;
             string str;

             year=gain/1000;
             day=(gain-year*1000)/4;
             hour=(gain-year*1000-day*4)*3;
             str="";
             if(year) str=str+chinese_number(year)+"年";
             if(day) str=str+chinese_number(day)+"天";
             if(hour) str=str+chinese_number(hour)+"时辰";
             if(gain==0) str="未入道途";
             return str;
}

string display_attr(int gift, int value)
{
        if( value > gift ) return sprintf( HIY "%4d", value );
        else if( value < gift ) return sprintf( HIC "%4d", value );
        else return sprintf("%3d", value);
}


void init()
{
        add_action("add_exp","mobai");
        add_action("do_show","show");
}

int do_show(string arg)
{
object me = this_object();
object who = this_player();
string line, str;
mapping my;
int cold,fire,wind,lightning,poison,dao;

if(!userp(who)) return 0;
//if(!me->query("owner")) return 0;
//if(!who->query("banghui")) return 0;
//if(who->query("banghui") != me->query("owner")) return 0;
        my = query_entire_dbase();
        printf(NOR CYN"┃"NOR WHT"〖 气血 〗%s%7-d/%8-d%s[%3d%%]"NOR,status_color(my["kee"],my["eff_kee"]),my["kee"],my["eff_kee"],status_color(my["eff_kee"],my["max_kee"]),my["eff_kee"]*100/my["max_kee"]);
        printf(NOR WHT"  〖 内力 〗%s%7-d/%7-d(+%4d)"NOR CYN"┃\n"NOR,status_color(my["force"], my["max_force"]), my["force"], my["max_force"],my["force_factor"]);
        printf(NOR CYN"┃"NOR WHT"〖 精神 〗%s%7-d/%8-d%s[%3d%%]"NOR,status_color(my["sen"],my["eff_sen"]),my["sen"],my["eff_sen"],status_color(my["eff_sen"],my["max_sen"]),my["eff_sen"]*100/my["max_sen"]);
        printf(NOR WHT"  〖 法力 〗%s%7-d/%7-d(+%4d)"NOR CYN"┃\n"NOR,status_color(my["mana"], my["max_mana"]), my["mana"], my["max_mana"],my["mana_factor"]);
        printf(NOR WHT"  〖 武学 〗%s%18-d    "NOR CYN"┃\n"HIG,HIY,(int)me->query("combat_exp")); 
       dao = (int)me->query("daoxing");       
        printf(NOR CYN"┃"NOR WHT"〖 道行 〗%s%52-s    "NOR CYN"┃\n"NOR,HIM,chinese_daoxing(dao));  
        printf(NOR WHT"  〖 杀气 〗%s%20-d "NOR CYN" ┃\n"HIG,HIR,(int)me->query("bellicosity"));
       line = sprintf( " 体格：[%s %4s %s] ",
                 NOR, display_attr(my["str"], me->query_str()), NOR );
        if( my["eff_gin"] <my["max_gin"] ) str = HIR+"生病";
        else if( my["gin"]*100 / my["max_gin"]>=70 ) str = HIG + "饱满";
        else if( my["gin"]*100 / my["max_gin"]>=40 ) str = HIR + "疲倦";
        else str = HIB + "很累";
        line += sprintf( "根骨：[%s %4s %s] ",
                NOR, display_attr(my["con"], me->query_con()), NOR );
        if( my["eff_kee"] <my["max_kee"] ) str = HIR+"伤残";
        else if( my["kee"]*100 / my["max_kee"]>=70 ) str = HIG + "充沛";
        else if( my["kee"]*100 / my["max_kee"]>=40 ) str = HIR + "受伤";
        else str = HIB + "重伤";
        line += sprintf( "悟性：[%s %4s %s] ",
                NOR, display_attr(my["int"], me->query_int()), NOR );
        line += sprintf( "灵性：[%s %4s %s] ",
                NOR, display_attr(my["spi"], me->query_spi()), NOR );

                line += sprintf( "\n 容貌：[%s %4s %s] ",
                HIG, display_attr(my["per"], me->query_per()), NOR );
                 line += sprintf( "定力：[%s %4s %s] ",
                HIG, display_attr(my["cps"], me->query_cps()), NOR );
                      
                 line += sprintf( "胆识：[%s %4s %s] ",
                HIG, display_attr(my["cor"], me->query_cor()), NOR );
                     
                     line += sprintf( "福缘：[%s %4s %s] ",
                HIG, display_attr(my["kar"], me->query_kar()), NOR );
          line += HIC+"\n兵器伤害力： "+NOR+" "+(int)me->query_temp("apply/damage")+"\t  "+HIC+"盔甲防御力： "+NOR+" "+(int)me->query_temp("apply/armor")+"NOR;
          line += HIC+"\n内功防御力： "+NOR+" "+(int)me->query_temp("apply/armor_vs_force")+"\t  "+HIC+"法术防御力： "+NOR+" "+(int)me->query_temp("apply/armor_vs_spells")+"NOR;
       cold=(int)me->query_temp("apply/cold_defence");
fire=(int)me->query_temp("apply/fire_defence");
lightning=(int)me->query_temp("apply/lightning_defence");
poison=(int)me->query_temp("apply/poison_defence");
wind=(int)me->query_temp("apply/wind_defence");
        line += HIW+"\n\n 防冰" +NOR+"："+cold +"\t   "+HIG+"防毒" + NOR+"："+poison+NOR+YEL+"\t   防风" +NOR+"："+ wind;
        line += HIR+"\n 防火" +NOR+"："+fire + "\t\t\t   "+HIB+"防电" + NOR+"："+lightning;
        write(line+BBLK);
        write(HIC"\n剑魂石像目前的武功等级为："+(int)me->query_skill("sword",1)+"级。\n"NOR);

return 1;
}             

