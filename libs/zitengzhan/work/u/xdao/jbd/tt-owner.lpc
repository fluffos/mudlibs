inherit ROOM;
#include <ansi.h>;
void create()
{
        set("short", "封印中心");
         set ("long", @LONG
这里是金鳖岛的封印中心，整个中心宽大无比！耸立着三百六十根玉柱，
含周天星斗之意。中央放着一块封印之碑，东面通往密室，西面通往试炼之地。
再往北却是昔日通天道人的道场。
LONG);
set("exits", ([
      "south": __DIR__"tt-5", 
      "east": __DIR__"tt-jg",
      "north": __DIR__"tt-save",      
        ]));
  set("no_clean_up", 1);
  set("objects", ([ 
      "/u/xdao/jbd/obj/tianbei.lpc" : 1,
        ]));
        setup();
}

int valid_leave (object who, string dir)
{
object tb = present("tian bei", this_object());

  if (dir != "north" )
    return ::valid_leave(who,dir);

if(!who->query("banghui"))
return notify_fail(HIB"你不能进去！\n"NOR);

 if(tb) {
if(!tb->query("owner")){
 who->start_busy(3);
return notify_fail(HIB"你不能进去！\n"NOR);}
if(tb->query("owner")!= who->query("banghui")) {
 who->start_busy(3);
return notify_fail(HIB"你不能进去！\n"NOR);}
         }
 return ::valid_leave(who,dir);
}

