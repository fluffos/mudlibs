inherit ITEM;
inherit F_SAVE;
#include <ansi.h>


void create()
{
     seteuid(getuid());
      set_name(HIM"得道蒲团"NOR,({"pu tuan","tuan"}));
          set("long","这是一块通天道人遗留的蒲团，似乎和整个封印有关，你试试(sit)它，起身请(leave)。\n");
        set("unit","块");
       set("no_get",1);
       set("no_clean_up",1);
       set_heart_beat(1);
}

string query_save_file()
{
    return DATA_DIR+"putuan_save_file";
}


void init()
{
        add_action("add_sit","sit");
        add_action("do_leave","leave");
}

private void heart_beat()
{
object me = this_object();
object tb,zb;
object who = this_object()->query_temp("sit");
string owner = this_object()->query_temp("owner");
if(!objectp(who)) return 0;
if(!owner) return 0;
/*
if(!who)
{
message("channel:chat",MAG"【金鳖岛上】"+CYN+"金鳖岛的封印罩重新笼罩了封印天碑！\n"NOR,users());
me->delete_temp("sit");
 return 0;
}
*/

if(environment(me)!=environment(who))
{
message("channel:chat",MAG"【金鳖岛上】"+CYN+""+who->query("name")+"被打落蒲团!金鳖岛的封印罩重新笼罩了封印天碑！\n"NOR,users());
me->delete_temp("sit");
who->set_temp("sit_end",time());
who->delete_temp("sit_putuan");
zb=new("/obj/npc/zombie.lpc");
if(zb) {
zb->move("/u/xdao/jbd/tt-owner");
destruct(zb);
       }
if(objectp(tb = find_object(owner)))
{
tb->delete_temp("open");
tb->no_open();
 }
return 0;
}

if(!who->query_temp("sit_putuan"))
{
message("channel:chat",MAG"【金鳖岛上】"+CYN+""+who->query("name")+"起身离开了蒲团!金鳖岛的封印罩重新笼罩了封印天碑！\n"NOR,users());
me->delete_temp("sit");
zb=new("/obj/npc/zombie.lpc");
if(zb) {
zb->move("/u/xdao/jbd/tt-owner");
destruct(zb);
       }
tb = find_object(owner);
if(!tb) tb = find_object("tian bei");
if(tb)
{
tb->delete_temp("open");
tb->no_open();
 }
}
}

int do_leave()
{
object me = this_object();
object who = this_player();

if(!who->query_temp("sit_putuan"))
return notify_fail(HIY"你有坐在上面吗？\n"NOR);

message_vision(HIC"$N"+HIC+"起身离开蒲团。\n" NOR,who);
who->set_temp("sit_end",time());
me->delete_temp("sit");
who->delete_temp("sit_putuan");
}

int add_sit(string arg)
{
object me = this_object();
object who = this_player();
object tb,zb;
string owner = this_object()->query("owner");
string bh;

if(!userp(who)) return 0;

if(!arg || (arg != "pu tuan" && arg != "tuan"))
return notify_fail(HIY"你想坐在哪儿？\n"NOR);

if(me->query_temp("sit"))
{
if(me->query_temp("sit")!=who) 
return notify_fail(HIY"已经有人座在上面了！\n"NOR);
else return notify_fail(HIY"你已经座在上面了！\n"NOR);
}

 if( time()-(int)who->query_temp("sit_end") < 10 )
return notify_fail(HIY"起起落落的烦不烦！待会再坐吧！\n"NOR);

tb=new("/u/xdao/jbd/obj/tianbei.lpc");
if(tb) {
bh=tb->query("banghui");
destruct(tb);
if(bh) {
if(who->query("banghui")&&who->query("banghui") == bh)
return notify_fail(HIY"你已经是封印的占有者了，好好守护蒲团吧！\n"NOR);}
         }


if(who->query_temp("jbd_begin")&&who->query("banghui"))
{
message_vision(HIC"$N"+HIC+"端坐在通天蒲团上，好似得道真仙！忽然蒲团白光一闪，封印罩被打开了！！\n" NOR,who);
me->set_temp("sit",who);
who->set_temp("sit_putuan",1);
tb=find_object("tian bei");
if(!tb) tb = find_object(owner);
if(tb) tb->set_temp("open",1);
else CHANNEL_D->do_channel(this_object(),"sys", "蒲团文件读取错误。");

}
else return notify_fail(HIY"蒲团发出一股强大的力量阻止了你！\n"NOR);
}
