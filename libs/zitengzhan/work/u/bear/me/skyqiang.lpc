//TIE@FY3
#include <ansi.h>
#include <weapon.h>
inherit SPEAR;
void create() {
  set_name(HIC "裂空戟" NOR, ({ "sky qiang", "spear", "qiang" }));
  set_weight(60);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("no_get", 1);
    set("no_drop", 1);
    set("changed", 1);
    set("unbreak", 1);
    set("long", "这是传说中能刺穿天地的神兵。\n");
    set("material", "steel"); set("value", 1);
    set("wield_msg", "$N两指微弹，$n划破长空，飘然跃入$N手中！\n");
    set("unwield_msg", "$N的$n已悄然收起。\n");
  }
  init_spear(160);
  setup();
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  int dam;
  dam = (int)me->query("max_force");
  if (!userp(victim)) {
    victim->add_temp("apply/attack", -dam);
    victim->add_temp("apply/damage", -dam);
    victim->add_temp("apply/dodge", -dam);
    victim->add_temp("apply/parry", -dam);
    if (random(3) == 1) {
      victim->receive_damage("kee", damage_bonus);
      return HIB "裂空斩犹如一道闪电，穿过$n的身体。\n" NOR;
    }
  }
  return NOR " \n " NOR;

}
int query_autoload() { return 1; }
