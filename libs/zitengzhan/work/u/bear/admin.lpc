
#include <ansi.h>

void set_weapon(object qs,string id) {
	string att = "fire_attack";
	if (!qs) return; 
    qs->set("primitive_id",id);
    qs->set("bind_type",0);
	qs->set("durability/max",400+random(300));
    qs->set("durability/now",400+random(300));
    qs->set("grade", 13+7);
    qs->set("unique_code",time()); 
    qs->set("changed",1);
    qs->set_name(BLINK+HIY"辉煌的"NOR+qs->query("name"),({qs->query("id")}));
    qs->set("unbreak",1);
    qs->set("weapon_prop/damage",499);
    qs->set("weapon_prop/luck",6 + 5);
    qs->set("sockets/max",6+7);
    qs->set("sockets/now",0);
    qs->set((att+"/max_level"),15+9);
	qs->set("weapon_prop"+"/"+att,1);
	qs->set((att+"/exp"),0);
}

void give_obj(object obj,object who) {
	obj->move(who);
}
void get_zuanshi(object obj,string id) {
   string *attr;
   int k;
   int i = 7;
   int j = 5;
   mixed *color=({
   		({GRN,"原石",0,"",""}),
   		({HIR,"红色宝石",1,"red",({"damage"})}),
   		({HIB,"蓝色宝石",2,"blue",({"attack"})}),
    		({MAG,"紫色宝石",3,"purple",({"damage","attack"})}),
                ({HIY,"黄色宝石",4,"yellow",({"luck"})}),
                ({YEL,"橙色宝石",5,"orange",({"damage","luck"})}),
   		({HIG,"绿色宝石",6,"green",({"attack","luck"})}),
   		({HIW,"钻石",7,"dimond",({"damage","attack","luck"})})
   	}),
   	*level=({
   		({0,"",""}),
   		({1,"破碎的",10}),
   		({2,"有裂纹的",20}),
   		({3,"有瑕疵的",30}),
   		({4,"纯净的",40}),
   		({5,"完美的",50})
   	});
   	if (j>5) j=5;
   	obj->set_name(color[i][0]+level[j][1]+color[i][1]+NOR,({color[i][3]+" baoshi","baoshi"}));
   	obj->set("color",i);
   	obj->set("level",j);
       obj->set("long","一颗闪闪发光的"+obj->name()+"\n好象可以镶嵌(inset)什么东西上面。\n是由("+id+")炼制的。\n");
          obj->set("changed",1);
   	attr=color[i][4];
   	for (k=0;k<sizeof(attr);k++)
   	    obj->set("prop/"+attr[k],level[j][2]/2+level[j][2]/2-1);
}
void set_armor(object armor,string id) {
    int value;
	if (!armor)
		return;
	armor->set("primitive_id",id);
	armor->set("unique_code",time()); 
	armor->set("zhuoyue",1);
	armor->set("bind_type",0);
	armor->set("changed",1);
	armor->set("unbreak",1);
	armor->set("durability/max",220);
	armor->set("durability/now",100);
	armor->set_weight((1000+armor->query_weight())/2);
	armor->set("long",armor->query("name"));
	armor->set("material", "dark");  
	armor->set("grade", 14);
	armor->set("armor_prop/armor",(45+44)*2);
    armor->set("armor_prop/cold_defence",20+14);
    armor->set("armor_prop/fire_defence",20+14);
      armor->set("armor_prop/lightning_defence",20+14);
      armor->set("armor_prop/poison_defence",20+14);
      armor->set("armor_prop/wind_defence",20+14);
	armor->set("armor_prop/chance",10);
	armor->set("sockets/max",4*2);
    armor->set("armor_prop/armor_vs_spells",270+269);
    armor->set("armor_prop/armor_vs_force",270+269);
	armor->set("sockets/now",0);
	value = 200000;
    value+=armor->query("durability/max")*50;
    value+=armor->query("durability/now")*25;
    value+=armor->query("sockets/max")*2000;
    value+=armor->query("armor_prop/armor")*100;            
    value+=armor->query("armor_prop/cold_defence")*100;
    value+=armor->query("armor_prop/fire_defence")*100;
    value+=armor->query("armor_prop/lightning_defence")*100;
    value+=armor->query("armor_prop/poison_defence")*100;
    value+=armor->query("armor_prop/wind_defence")*100;
    value+=armor->query("armor_prop/chance")*500;           
    armor->set("value", value);
          armor->set("armor_wiel/exp",35000);
	armor->set("armor_wiel/str",30);
          "/d/obj/newitem/newitems.lpc"->setname_armor(armor);
}
