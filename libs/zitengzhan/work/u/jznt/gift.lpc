#include <ansi.h>
#include <login.h>
inherit ITEM;

int do_open(string);
int do_glist();
void modify(int lv, string type);
void give_weapon(object ob,int type);
void give_armor(object ob,int type);
void weapon_type(string arg, object ob, int type);
void create()
{
        set_name(HIW "元霄礼物" NOR, ({"liwu", "gift"}));
  set_weight(1);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "个");
                set("long", "2012年元霄大礼包，上面贴着一份礼物单(glist)，赶快打开(open)吧。\n");
		set("no_sell", 1);
set("no_give", 1);
		set("no_put", 1);
		set("no_drop", 1);
		set("level", 5);
		set("type", 1);
		//set("used",0);
	}
	setup();
}

void modify(int lv, int type)
{
	string stype; // 1-除夕礼包 2-春节礼包
	if(type==1)
		stype = MAG"圣诞"NOR;
	else if(type==2)
		stype = MAG"元旦"NOR;
	else if(type==3)
		stype = MAG"赝品圣诞"NOR;
	else
		stype = MAG"赝品元旦"NOR;
	set("name",GRN"第"+chinese_number(lv)+"号"+stype+RED"大礼包"NOR);
	set("level" ,lv);
	set("type", type);
	set("stype", stype);
	//set("used", 0);
}

void init()
{
	add_action("do_open", "open");
	add_action("do_glist", "glist");
}

int do_glist()
{
	int i, lv, type;


	lv = query("level");
	type = query("type");

	if(!lv || !type)
	{
		write("这个大礼包好像有点来历不明。\n");
		return 1;
	}
	write("\n");
	write("  "+name()+"\n");
	write("+--------------------+\n");
	write("|      "GRN"礼物清单"NOR"      |\n");
	write("|                    |\n");
	for(i=1;i<=10;i++)
	{
		if(lv>=i)
		{	
			switch(i)
			{
			case 1:
				write("| "CYN"1"NOR"  "CYN"武学"MAG"道行"WHT"潜能"GRN"若干"NOR"|\n");
				break;
			case 2:
				write("| "CYN"2"NOR"  "YEL"黄金"GRN"两千两"NOR"      |\n");
				break;
			case 3:
				write("| "CYN"3"NOR"  "MAG"紫藤宝石"GRN"一百颗"NOR"  |\n");
				break;
			case 4:
				write("| "CYN"4"NOR"  "GRN"灵仙丹"GRN"五颗"NOR"      |\n");
				break;
			/*case 5:
				if(lv==6 && type==1)
			    write("| "CYN"5"NOR"  "BLINK+WHT"生命宝石"NOR+GRN"三颗"NOR"    |\n");
				break;
			*/case 6:
				if(lv==6 && type==2)
					write("| "CYN"6"NOR"  "WHT"白色武器"GRN"一柄"NOR"    |\n");
				break;
			case 7:
				if(lv==7)
					write("| "CYN"6"NOR"  "GRN"卓越"WHT"指环"GRN"一枚"NOR"    |\n");
				break;
			case 8:
				if(lv==8)
					write("| "CYN"6"NOR"  "GRN"卓越"WHT"武器"GRN"一柄"NOR"    |\n");
				break;
			case 9:
				if(lv==9 && (type==1 || type==3))
					write("| "CYN"6"NOR"  "RED"力量指环"GRN"一枚"NOR"    |\n");
				else if(lv==9 && (type==2 || type==4))
					write("| "CYN"6"NOR"  "CYN"悟性指环"GRN"一枚"NOR"    |\n");
				break;
			case 10:
				if(lv==10)
					write("| "CYN"6"NOR"  "BLINK+YEL"辉煌"WHT"武器"NOR+GRN"一柄"NOR"    |\n");
				break;
			default:
				write("|                    |\n");
			}
		}
	}
	write("|                    |\n");
	write("|                    |\n");
	write("|"MAG"大唐西游巫师组"YEL" 敬上"NOR" |\n");
	write("+--------------------+\n");
	return 1;
}

int do_open(string arg)
{

	object ob = this_object();
	object me = this_player();
	object qs;
	int i,  lv, type;


	if (!id(arg))
		return notify_fail("你要打开什么？\n");

	lv = query("level");
	type = query("type");

	if(!lv || !type)
	{
		write("这个大礼包好像有点来历不明。\n");
		destruct(ob);
		return 1;
	}

/*	if(query("used"))
	{
		write(HIC"你仔细地翻来翻去，"+name()+HIC"里面再也没有什么好东西了，:(，你只好扔了礼盒。\n");
		destruct(ob);
		return 1;
	}
*/
	write(HIG"你迫不及待地打开"+name()+"\n", me);
	if(type == 3 || type==4)
	{
		write(HIC"可惜这是个彩排用的赝品礼包\n"NOR, me);
		me->add("baoshi/bs_b1",1);
		write(HIC"你获得了一颗"BLINK+WHT"天晶石"NOR+HIC"的参与奖。\n"NOR, me);
		destruct(ob);
		return 1;
	}

	for(i=1;i<=10;i++)
	{
		if(lv>=i)
		{	
			switch(i)
			{
			case 1:
				me->add("combat_exp",200000);
				me->add("daoxing",200000);
				me->add("potential",100000);
				write(HIC"你获得了"+chinese_number(200000)+"点武学，"+COMBAT_D->chinese_daoxing(200000)+"道行，"+chinese_number(100000)+"点潜能。\n"NOR);
				break;
			case 2:
				me->add("c_balance",20000000);
				write(HIC"你获得了二千两黄金的奖励，已经存入大唐信用卡。\n"NOR);
				break;
			case 3:
				qs = new("/d/npc/vr_room/obj/ztstone.lpc");
				qs->set_amount(100);
				qs->move(me);
				write(HIC"你获得了一百颗"+qs->name()+"。\n"NOR);
				break;
			case 4:
				qs = new("/u/wzx/obj/lxd.lpc");
				qs->move(me);
				qs = new("/u/wzx/obj/lxd.lpc");
				qs->move(me);
				qs = new("/u/wzx/obj/lxd.lpc");
				qs->move(me);
				qs = new("/u/wzx/obj/lxd.lpc");
				qs->move(me);
				qs = new("/u/wzx/obj/lxd.lpc");
				qs->move(me);
				write(HIC"你获得了五颗"+qs->name()+"。\n"NOR);
				break;
			/*case 5:
				if(lv==6 && type==1)
			    me->add("baoshi/stone",3);
				write(HIC"你获得了三颗"BLINK+WHT"生命宝石"NOR+HIC"。\n"NOR);
				break;
			*/case 6:
				if(lv==6 && type==2)
					give_weapon(me, 0);
				break;
			case 7:
				if(lv==7)
					give_armor(me, 0);
				break;
			case 8:
				if(lv==8)
					give_weapon(me, 1);
				break;
			case 9:
				if(lv==9 && type==1)
					give_armor(me, 1);
				else if(lv==9 && type==2)
					give_armor(me, 2);
				break;
			case 10:
				if(lv==10)
					give_weapon(me, 2);
				break;
			default:
				break;
			}
		}
	}
	//ob->set("used",1);
	//ob->set("long","2012年新年大礼包，好像被人打开(open)过了，上面贴着的礼单(glist)还在。\n");
	destruct(ob);
	return 1;
}

// type: 0-白色武器  1-卓越武器  2-辉煌武器
void give_weapon(object ob, int type)
{
	write(HIC"请选择一种武器类型：\n"NOR);
	write("1. 斧  2. 刀  3. 叉  4. 锤  5. 锏  6. 枪\n");
	write("7. 杖  8. 棒  9. 剑  10. 鞭  11. 拳\n");
	input_to( (: weapon_type :), ob, type);

}
void weapon_type(string arg, object ob, int type)
{
	int order, k;
	string att;
	object qs;
	sscanf(arg, "%d", order);
	if(order<=0 || order>=12)
	{
		write(HIC"没有这种武器类型。\n"NOR);
		give_weapon(ob, type);
		return;
	}
	
	switch(order)
	{
	case 1:
		qs = new ("/d/npc/vr_room/obj/axe");
		break;
	case 2:
		qs = new ("/d/npc/vr_room/obj/blade");
		break;
	case 3:
		qs = new ("/d/npc/vr_room/obj/fork");
		break;
	case 4:
		qs = new ("/d/npc/vr_room/obj/hammer");
		break;
	case 5:
		qs = new ("/d/npc/vr_room/obj/mace");
		break;
	case 6:
		qs = new ("/d/npc/vr_room/obj/spear");
		break;
	case 7:
		qs = new ("/d/npc/vr_room/obj/staff");
		break;
	case 8:
		qs = new ("/d/npc/vr_room/obj/stick");
		break;
	case 9:
		qs = new ("/d/npc/vr_room/obj/sword");
		break;
	case 10:
		qs = new ("/d/npc/vr_room/obj/whip");
		break;
	case 11:
		qs = new ("/d/npc/vr_room/obj/unarmed");
		break;
	default:
		qs = new ("/d/npc/vr_room/obj/sword");
		break;
	}

	qs->set("primitive_id",ob->query("id"));
	qs->set("bind_type",1); // 装备绑定

	qs->set("durability/max",200+random(300));
	qs->set("durability/now",200+random(300));
	qs->set("grade", 8);
	qs->set("unique_code",time()); 
	qs->set("changed",1);
	qs->set("unbreak",1);
	qs->set("weapon_prop/damage",200);
	qs->set("weapon_prop/luck",4);
	qs->set("sockets/max",4);
	qs->set("sockets/now",0);
	qs->set("long",HIW"这是2012年的春节特别礼品，上面刻着一排蝇头小字：\n\n  "MAG+ob->query("name")+"("+ob->query("id")+") 2012年春节留念\n"NOR);

	k=random(5);
	if (k>4) k=4;   
	switch(k)
	{
	case  0: att="cold_attack";break;
	case  1:att="fire_attack";break;
	case  2:att="lightning_attack";break;
	case  3:att="poison_attack";break;
	case  4:att="wind_attack";break;
	default:att="";
	}
	if (att!="") 
	{			
		qs->set((att+"/max_level"),12);
		qs->set("weapon_prop"+"/"+att,1);
		qs->set((att+"/exp"),0);
	}

	if(type == 1)
	{
		qs->set("durability/max",300+random(300));
		qs->set("durability/now",300+random(300));
		qs->set("grade", 10);
		qs->set((att+"/max_level"),16);
		qs->set_name(BLINK+HIG"卓越的"NOR+qs->query("name"),({qs->query("id")}));
		qs->set("weapon_prop/damage",300);
		qs->set("weapon_prop/luck",6);
		qs->set("sockets/max",5);
	}
	else if(type == 2)
	{
		qs->set("durability/max",400+random(300));
		qs->set("durability/now",400+random(300));
		qs->set("grade", 12);
		qs->set((att+"/max_level"),20);
		qs->set_name(BLINK+HIY"辉煌的"NOR+qs->query("name"),({qs->query("id")}));
		qs->set("weapon_prop/damage",400);
		qs->set("weapon_prop/luck",8);
		qs->set("sockets/max",6);

	}

	qs->move(ob);
	write(HIC"你获得了一件"+qs->name()+HIC"。\n"NOR);

}
// type: 0-卓越指环  1-力量指环  2-悟性指环
void give_armor(object ob, int type)
{
	object qs;
	qs = new("/d/obj/newitem/newarmor/finger.lpc");
	
	qs->set("primitive_id",ob->query("id"));
	qs->set("bind_type",1); // 装备绑定
	qs->set("unique_code",time()); // 以时间定义装备唯一识别码
	qs->set("changed",1); // 有此属性，系统自动保存此装备
	qs->set("unbreak",1); // 有此属性，兵器不能被打断
	qs->set_name(BLINK+HIG"卓越的"NOR+HIM"新春指环"NOR, ({"spring ring", "ring"})); // 名称
	qs->set("durability/max",300+random(300)); // 最大耐久度
	qs->set("durability/now",300+random(300)); // 当前耐久度
	qs->set_weight(1000); // 重量
	qs->set("long",HIW"这是2012年的春节特别礼品，里面刻着一圈蝇头小字：\n\n  "MAG+ob->query("name")+"("+ob->query("id")+") 2012年春节留念\n"NOR); // 描述
	qs->set("material", "dragon"); // 材质
	qs->set("grade", 9); // 等级 1-14
	qs->set("armor_prop/armor",120); // 防御力
	qs->set("armor_prop/armor_vs_force",300); // 内功防御力
	qs->set("armor_prop/armor_vs_spells",300); // 法术防御力
	qs->set("sockets/max",4); // 安放宝石数
	qs->set("value", 100000); // 价值
	qs->set("armor_wiel/exp",35000); // 道行需求
	qs->set("armor_wiel/int",20); // 天赋需求
	
	if(type==1)
	{
		qs->set_name(HIR"力量指环"NOR, ({"strenth ring", "ring"}));
		qs->set("armor_prop/strength",50); // 臂力
	}
	else if(type==2)
	{
		qs->set_name(HIC"悟性指环"NOR, ({"intelligence ring", "ring"}));
		qs->set("armor_prop/intelligence",10); // 悟性
	}
	qs->move(ob);
	write(HIC"你获得了一件"+qs->name()+HIC"。\n"NOR);
}
