/* <SecCrypt CPL V3R05> */

// shoupi.c

#include <armor.h>
#include <ansi.h>

inherit WRISTS;

void create() {
  //set_name("护腕", ({"wrists"}));
  set_weight(1000);

  set("primitive_id", "nanf");  // 爆出此装备的id
  set("unique_code", time());  // 以时间定义装备唯一识别码
  set("bind_type", 0);  // 0不绑定，1装备绑定，2拾取绑定,3，直接绑定。
  set("changed", 1);  // 有此属性，系统自动保存此装备
  set("unbreak", 1);  // 有此属性，兵器不能被打断
  set_name(HIC "龙鳞护腕" NOR, ({ "dragon wrists", "wrists" }));  // 名称
  set("durability/max", 500);  // 最大耐久度
  set("durability/now", 500);  // 当前耐久度
  set_weight(1000);  // 重量
  set("long", HIC "龙鳞护腕" NOR);  // 描述
  set("material", "dragon");  // 材质
  set("grade", 9);  // 等级 1-14
  set("armor_prop/armor", 6000);  // 防御力
  set("armor_prop/armor_vs_force", 6000);  // 内功防御力
  set("armor_prop/armor_vs_spells", 6000);  // 法术防御力
  set("armor_prop/cold_defence", 100);  // 防冰
  set("armor_prop/fire_defence", 100);  // 防火
  set("armor_prop/lightning_defence", 100);  // 防电
  set("armor_prop/poison_defence", 100);  // 防毒
  set("armor_prop/wind_defence", 100);  // 防风
  set("armor_prop/chance", 50);  // 魔法装备获得率  
  set("armor_prop/strength", 100);  // 臂力
  set("armor_prop/courage", 100);  // 胆识
  set("armor_prop/intelligence", 50);  // 悟性
  set("armor_prop/spirituality", 50);  // 灵性
  set("armor_prop/composure", 50);  // 定力
  set("armor_prop/personality", 50);  // 容貌
  set("armor_prop/constitution", 50);  // 根骨
  set("armor_prop/karma", 50);  // 福缘
  set("sockets/max", 10);  // 安放宝石数
  set("value", 10000000);  // 价值
  set("armor_wiel/exp", 0);  // 道行需求
  set("armor_wiel/int", 10);  // 天赋需求
  /**/

  if (clonep())
    set_default_object(__FILE__);
  else {
    // set("material", "iron");
    set("unit", "副");
    //	set("armor_prop/armor", 1);


  }
  setup();
}
