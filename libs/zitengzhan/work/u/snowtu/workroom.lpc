#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "CPU");
  set("exits", ([
    "wiz": "/d/wiz/wizroom",
    "up": "/d/city/kezhan",
    "fight": __DIR__ "fight",
  ]));
  set("objects", ([
  ]));
  set("outdoors", "changan");
  set("chat_room", 1);
  set("no_time", 1);
  set("mai_corpse_able", 1);
  set("freeze", 1);
  set("if_bed", 1);
  set("sleep_room", 1);
  set("no_upgrade_age", 1);
  set("valid_startroom", 1);
  set("hs_world", 1);
  set("no_clean_up", 1);
  setup();
}

void init() {
  add_action("do_code", "color");
}

varargs string replace_color(string str) {
  if (!str || !stringp(str)) return 0;
  str = replace_string(str, "$BOLD$", BOLD);  //粗体
  str = replace_string(str, "$FRTOP$", FRTOP);  //结冰大字标题 
  str = replace_string(str, "$FRBOT$", FRBOT);  //结冰底线        
  str = replace_string(str, "$HIREV$", HIREV);  //强烈转动反白显示 
  str = replace_string(str, "$REV$", REV);      //转动反白显示

  str = replace_string(str, "$BLK$", BLK);
  str = replace_string(str, "$RED$", RED);
  str = replace_string(str, "$GRN$", GRN);
  str = replace_string(str, "$YEL$", YEL);
  str = replace_string(str, "$BLU$", BLU);
  str = replace_string(str, "$MAG$", MAG);
  str = replace_string(str, "$CYN$", CYN);
  str = replace_string(str, "$WHT$", WHT);
  str = replace_string(str, "$HIR$", HIR);
  str = replace_string(str, "$HIG$", HIG);
  str = replace_string(str, "$HIY$", HIY);
  str = replace_string(str, "$HIB$", HIB);
  str = replace_string(str, "$HIM$", HIM);
  str = replace_string(str, "$HIC$", HIC);
  str = replace_string(str, "$HIW$", HIW);
  str = replace_string(str, "$NOR$", NOR);

  str = replace_string(str, "$HBRED$", HBRED);
  str = replace_string(str, "$HBGRN$", HBGRN);
  str = replace_string(str, "$HBYEL$", HBYEL);
  str = replace_string(str, "$HBBLU$", HBBLU);
  str = replace_string(str, "$HBMAG$", HBMAG);
  str = replace_string(str, "$HBCYN$", HBCYN);
  str = replace_string(str, "$HBWHT$", HBWHT);
  str = replace_string(str, "$BRED$", BRED);
  str = replace_string(str, "$BGRN$", BGRN);
  str = replace_string(str, "$BYEL$", BYEL);
  str = replace_string(str, "$BBLU$", BBLU);
  str = replace_string(str, "$BMAG$", BMAG);
  str = replace_string(str, "$BCYN$", BCYN);
  str = replace_string(str, "$BLINK$", BLINK);

  str = replace_string(str, "BOLD", BOLD);  //粗体
  str = replace_string(str, "FRTOP", FRTOP);  //结冰大字标题 
  str = replace_string(str, "FRBOT", FRBOT);  //结冰底线  
  str = replace_string(str, "HIREV", HIREV);  //强烈转动反白显示 
  str = replace_string(str, "REV", REV);      //转动反白显示

  str = replace_string(str, "BLINK", BLINK);
  str = replace_string(str, "HBRED", HBRED);
  str = replace_string(str, "HBGRN", HBGRN);
  str = replace_string(str, "HBYEL", HBYEL);
  str = replace_string(str, "HBBLU", HBBLU);
  str = replace_string(str, "HBMAG", HBMAG);
  str = replace_string(str, "HBCYN", HBCYN);
  str = replace_string(str, "HBWHT", HBWHT);

  str = replace_string(str, "BRED", BRED);
  str = replace_string(str, "BGRN", BGRN);
  str = replace_string(str, "BYEL", BYEL);
  str = replace_string(str, "BBLU", BBLU);
  str = replace_string(str, "BMAG", BMAG);
  str = replace_string(str, "BCYN", BCYN);

  str = replace_string(str, "BLK", BLK);
  str = replace_string(str, "RED", RED);
  str = replace_string(str, "GRN", GRN);
  str = replace_string(str, "YEL", YEL);
  str = replace_string(str, "BLU", BLU);
  str = replace_string(str, "MAG", MAG);
  str = replace_string(str, "CYN", CYN);
  str = replace_string(str, "WHT", WHT);
  str = replace_string(str, "HIR", HIR);
  str = replace_string(str, "HIG", HIG);
  str = replace_string(str, "HIY", HIY);
  str = replace_string(str, "HIB", HIB);
  str = replace_string(str, "HIM", HIM);
  str = replace_string(str, "HIC", HIC);
  str = replace_string(str, "HIW", HIW);
  str = replace_string(str, "NOR", NOR);
  return str;
}

int do_code(string arg) {
  object me = this_player();

  if (!arg || !wizardp(me))
    return 0;
  arg = replace_color(arg);
  me->set("name_color", arg);
  write("你的颜色设为" + arg + "1" NOR "\n");
  return 1;
}
