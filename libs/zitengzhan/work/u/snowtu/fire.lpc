#include <ansi.h> 
#include <combat.h> 
inherit F_DBASE;  
inherit SSERVER;  

int perform2(object me, object target);
int perform3(object me, object target,int damage);   
int perform4(object me, object target,int damage);   
         
int perform(object me, object target)  
{ 
string weapon,msg;  
int skill, att,damage,ap,dp;  
object ob;  

if ( !target ) target = offensive_target(me);  
if ( userp(me) && !me->query("env/test") )  return notify_fail("你内力不足。\n");
if ( !target || !target->is_character() || !me->is_fighting(target) )   
        return notify_fail(HIR"『烈火杖』只能对战斗中的对手使用。\n"NOR);  
weapon = me->query_temp("weapon");
if ( time()<me->query_temp("pt_fire")+10 )   
        return notify_fail(HIR"你已在使用『烈火杖』！\n"NOR);  
if( me->query_skill("lotusforce", 1) < 100 ) 
        return notify_fail(HBRED+HIW"你的内功火候未到，无法施展『烈火杖』！\n"NOR);  
if( me->query_skill("staff") < 100 )   
        return notify_fail(HBRED+HIW"你的杖法修为不足，还不会使用『烈火杖』！\n"NOR);  
if((string)me->query("family/family_name") != "南海普陀山") 
        return notify_fail(HIR"你非佛门弟子，无法使用『烈火杖』！\n"NOR);  
     
skill =  ( me->query_skill("lunhui-zhang",1) + me->query_skill("force",1) ) / 5;  
if( me->query("force") <500 )  
        return notify_fail(HIR"你的内力不够使用『烈火杖』！\n"NOR);  
if( me->query("sen") < 100 )      
        return notify_fail(HIR"你的精神不够使用『烈火杖』！\n"NOR);  
       
att = skill;  
if ( att < 45) att = 45;  
if (att >200 ) att = 200;  
me->set_temp("apply/attack", att);  
me->set_temp("apply/dodge", skill/3*2);  
me->set_temp("apply/parry", skill/3*2);  
message_vision(HIR"$N右手一抖，"+weapon->name()+HIR"带着奇异的弧度往$n"HIR"攻去，杖尖不停的抖动，
在空气中带出点点的火花，抖动的火花好似燃烧起来！\n"
HIW"『烈火杖』五连击の第一击---"HIR"“星火燎原”"HIW"。\n" NOR, me, target);  
me->set_temp("pt_fire",time());

if(target->query_temp("weapon"))  
        { 
        ob = target->query_temp("weapon");  
        if ( me->query("str") > random(target->query("str")/4) ) 
                { 
                message_vision(HIR"$N"HIR"的攻势抵受不住这强大而集于一点的攻击而散去，手中"+ob->name()+HIR"被击得把持不定，脱手飞出！\n" NOR,target); 
                ob->unequip(); 
                target->reset_action(); 
                } 
        else    message_vision(HIR"$N"HIR"的攻势抵受不住这强大而集于一点的攻击而散去，手中"+ob->name()+HIR"一震，险些脱手而出！\n"NOR,target); 
        }  
ap = COMBAT_D->skill_power(me,"staff",SKILL_USAGE_ATTACK);
dp = COMBAT_D->skill_power(me,"dodge",SKILL_USAGE_ATTACK);       
if ( random(ap+dp)>dp )
        {  
        damage = COMBAT_D->do_attack(me, target,weapon);
        damage+= me->query_skill("staff");
        damage-= random(target->query_skill("parry"));
        damage-= random(target->query_skill("dodge")/4);
        if ( damage<0 ) damage=50;
        target->receive_damage("kee", damage,me);  
        target->start_busy(random(3));  
        COMBAT_D->report_status(target);   
        }
else  message_vision(CYN"\n$n"NOR CYN"知道这招不可硬挡，瞅准空挡架开了"+weapon->name()+NOR CYN"的攻击。\n\n"NOR,me,target);  

if ( me->query_skill("lunhui-zhang",1)>150 && me->query_skill("lotusforce",1)>150
  && target && me->is_fighting(target) )
        perform2(me, target); 
me->add("force", -200 ); 
return 1; 
} 
       
int perform2(object me, object target)  
{
string weapon,msg;  
int damage,def;
weapon = me->query_temp("weapon");    
if ( !target || !target->is_character() || !me->is_fighting(target) )   
        return notify_fail(BBLU+HIR"『烈火杖』只能对战斗中的对手使用。\n"NOR);  

msg = "\n$N将手中$w向上抛飞，只见$P一个旋身，利用刚才互击的反作用力和从$n转借来的劲道，
将兵器向下一带，$n尚未站稳，$w已经摇晃落下，令人不知其落点为何。\n";
msg = replace_string(msg,"$w",weapon->name());
msg = COLOR_D->clean_color(msg);
msg = HIR+msg+NOR;
msg = COLOR_D->replace_color(msg,2); 
msg +=HIW"『烈火杖』五连击の二击---"NOR+HIR"“天雷骤落”"NOR+HIW"。\n"NOR;
message_vision(msg,me,target);  
damage = COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

msg = "

$N再度顺势转身，带动整支$w横扫而来，滚滚的风声像是将空气撕裂一般，夹带前两式余威，加上$N
巧妙的运劲，威力越来越大！\n"NOR;
msg = replace_string(msg,"$w",weapon->name());
msg = COLOR_D->clean_color(msg);
msg = HIR+msg+NOR;
msg = COLOR_D->replace_color(msg,2); 
msg+=HIW"『烈火杖』五连击の三击---"NOR+HIR"“一泄千里”"NOR+HIW"。\n"NOR;
message_vision(msg,me,target);  
damage+= COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

if ( me->query_skill("lunhui-zhang",1) > 200 && me->query_skill("lotusforce",1) >200
  && target && me->is_fighting(target) )
        perform3(me,target,damage);
me->start_busy(2);  
return 1;  
} 
      
int perform3(object me, object target,int damage)  
{ 
int t;  
string msg;  
object weapon = me->query_temp("weapon");    
if( !target || !target->is_character() || !me->is_fighting(target) )   
        return notify_fail(BBLU+HIR"『烈火杖』只能对战斗中的对手使用。\n"NOR);  

msg = "正当$n手足无措之际，$N顺势甩开武器，$w落地弹起，贯通隐隐风雷之声，直击$n！\n";
msg = replace_string(msg,"$w",weapon->name());
msg = COLOR_D->clean_color(msg);
msg = HIR+msg+NOR;
msg = COLOR_D->replace_color(msg,2); 
msg += HIW"『烈火杖』五连击の四击---"NOR+HIR"“擎天一击”"NOR+HIW"。\n"NOR;
message_vision(msg,me,target);  
me->add_temp("apply/damage",damage);
me->add_temp("apply/attack",damage);
t = COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
me->add_temp("apply/damage",-damage);
me->add_temp("apply/attack",-damage);
damage+= t;
if ( damage<=0 )
        damage = target->query("eff_kee");
if ( me->query_skill("lunhui-zhang",1) > 300 && me->query_skill("lotusforce",1) >300
  && target && me->is_fighting(target) )
        perform4(me,target,damage);
me->start_busy(2);  
return 1;  
} 

int perform4(object me, object target,int damage)   
{
int i;
mapping temp; 
object obj,*inv,weapon = me->query_temp("weapon");
string msg;
if( !target || !target->is_character() || !me->is_fighting(target) )   
        return notify_fail(BBLU+HIR"『烈火杖』只能对战斗中的对手使用。\n"NOR);  

msg = "“喝！”$N大吼一声，将功力提至极限，瞬间火焰从$w前端冲出形成一个异常清晰的形体，
那个形体那赫然是一只麒麟！\n"NOR;
msg = replace_string(msg,"$w",weapon->name());
msg = COLOR_D->clean_color(msg);
msg = HIR+msg+NOR;
msg = COLOR_D->replace_color(msg,2); 
msg = HBRED+HIW"『烈火杖』五连击最后一击---"+HIR"“麒麟再生”"+HIW"！\n"NOR;
msg = HIR"$n"+HIR"连犹豫的时间也没有，眨眼间就被赤莲之火吞没了！\n"NOR;
message_vision(msg,me,target);
temp = target->query_temp("armor");
if ( temp && mapp(temp) )
        {
        inv = values(temp);     
        for(i=0;i<sizeof(inv);i++)
                {                       
                obj = inv[i];
                if ( obj )
                        {
                        message_vision("『轰』的一声，$n身上的"+obj->name()+"被烧得冒起一阵浓烟。。。\n"NOR,me,target);
                        obj->unequip();
                        }
                }
        }
me->add_temp("apply/damage",damage);
me->add_temp("apply/attack",damage);
COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
me->add_temp("apply/damage",-damage);
me->add_temp("apply/attack",-damage);
message_vision(HIR"\n\n$N"+HIR"吸了一口气，将内力收回丹田，"+HIW+weapon->name()+HIR"的烈火渐渐黯淡了下来。\n\n" NOR, me);  
return 1;  
}

