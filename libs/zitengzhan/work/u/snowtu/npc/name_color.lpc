#include <ansi.h>
inherit NPC;
//■
mapping Color = ([
                "HIC"   : 500,
                "CYN"   : 550,            
                "HIY"   : 500,
                "YEL"   : 500,
                "GRN"   : 500,
                "RED"   : 1000,
                "HIR"   : 800,
                "BLK"   : 2000,
                "HIG"   : 650,          
                "BLU"   : 1200,
                "HIB"   : 800,   
                "MAG"   : 900,
                "HIM"   : 850,
                "WHT"   : 1500,
                "HIW"   : 1000,

                "BGRN"  : 2000,
                "HBGRN" : 2200,
                "BYEL"  : 2300,
                "HBYEL" : 2400,
                "BCYN"  : 2500,
                "HBCYN" : 2600, 
                "BBLU"  : 2700,
                "HBBLU" : 2800,
                "BRED"  : 2900,
                "HBRED" : 3000,
                "BMAG"  : 3500,
                "HBMAG" : 4000,
                "HBWHT" : 4500,
]);             

void create()
{
        set_name("阴百生",({"yin bai sheng","yin","sheng"}));
        set("long","阴长生的弟弟，据说从地府偷偷拿了一本《百态图》，可以将人的名字加上颜色。\n");
        set("title", "鬼面人间");
        set("gender", "男性");
        set("attitude", "friendly");
        set("channel_id","颜色精灵");
        set("name_color","HIG");
        set("age", 55);
        set("per", 23);
        set("max_kee", 900);
        set("max_sen", 600);
        set("force", 500);
        set("max_force", 500);
        set("force_factor", 40);
        set("max_mana", 500);
        set("mana", 900);
        set("mana_factor", 30);
        set("combat_exp", 200000);
        set("daoxing",200000);  

        set_skill("force", 90);
        set_skill("unarmed", 90);
        set_skill("dodge", 90);
        set_skill("jienan-zhi", 90);
        set_skill("parry", 90);
        set_skill("spells", 90);
        set_skill("buddhism", 90);
        map_skill("unarmed", "jienan-zhi");
        map_skill("spells", "buddhism");
        set("inquiry", ([
                "颜色": "我这里好多颜色可以调，list查看。\n",
                "color": "我的志向是做一名画家。。。。\n",
        ]));
        set("BASE",1);
        setup();
        carry_object("/d/obj/cloth/linen")->wear();
}

void init()
{
        add_action("do_list","list");
        add_action("do_buy","buy");
        if( wizardp(this_player()) )
                add_action("do_value","value");
}

int do_value(string arg)
{
        string str;
        int v;
        object me = this_player();
        if( !arg || !wizardp(me) )
                return 0;
        v = atoi(arg);
        if( v<=0 || v>10 )
        {
                write("价格基数只能在1-10之间，1表示原价，10表示10倍价。\n");
                return 1;
        }
        if( time()<query("last_set")+3600 )
        {
                write("每一小时内只能调整一次价格。\n");
                return 1;
        }
        set("BASE",v);
        if( v==1 )
                str = "原价";
        else    str = "原价的"HIR+chinese_number(v)+HIC"倍";    
        CHANNEL_D->do_channel(this_object(),"chat",HIY+upper_case(me->query("id"))+HIC"决定颜色姓名的价格调整为"+str+"。"NOR);
        set("last_set",time());
        write("ok");
        return 1;
}

int do_list()
{
        int v,i;
        string str,*color,clr;
        object me = this_player();
        color = keys(Color);
        v = query("BASE");
        if( v==1 )
                str = HIC"正常价格"NOR;
        else    str = HIR+chinese_number(v)+"倍价格"NOR;        
        str = "当前购买价格为"+str;
        str+= "如果您购买的是两种以及以上颜色，则所需价格为各种颜色价值之和。\n";
        for(i=0;i<sizeof(color);i++)
        {
                clr = color[i];
		str+= sprintf("\t"+COLOR_D->replace_color(clr,1)+" 姓名 "NOR"色(代码 "HIR"%-5s"NOR") : "NOR HIR"%6d 两"NOR"黄金\n"NOR,clr,v*Color[clr]);
        }       
        str+= "\n使用buy命令来购买您所需要的名字颜色。\n";
        str+= "示例：你可以通过 buy HIC from yin 来获得天青色的名字颜色。\n";
        str+= "      同时你也可以通过 buy HBRED+HIC from yin 来获得红色背景天青色前景的名字颜色，自然\n";
        str+= "所需价格为红色背景(3000两黄金)与天青色(500两黄金)之和。\n";
        str+= "注意：如果两种以上的颜色都为背景色，那取最后一个，别浪费钱哦。\n";
        me->start_more(str); 
        return 1;
}

int check_value(string color)
{
        int v;
        if( !color ) 
                return 0;
        if( member_array(color,keys(Color))==-1 )
                return notify_fail("没有 "+color+" 这个颜色。\n");
        return Color[color];    
}

int do_buy(string arg)
{
        mixed clr;
        string sth,id,color,tmp;
        int i,num,p,afford,k;
        object card,who,me = this_player();
        if( !arg )
        {
                write("
        示例：你可以通过 buy HIC from yin 来获得天青色的名字颜色。
        同时你也可以通过 buy HBRED+HIC from yin 来获得红色背景天青色前景的名字颜色，自然
        所需价格为红色背景(3000两黄金)与天青色(500两黄金)之和。
        注意：如果两种以上的颜色都为背景色，那取最后一个，别浪费钱哦。\n");
                return 1;
        }
        if( sscanf(arg,"%s from %s",sth,id)!=2 )
        {
                write("
        示例：你可以通过 buy HIC from yin 来获得天青色的名字颜色。
        同时你也可以通过 buy HBRED+HIC from yin 来获得红色背景天青色前景的名字颜色，自然
        所需价格为红色背景(3000两黄金)与天青色(500两黄金)之和。
        注意：如果两种以上的颜色都为背景色，那取最后一个，别浪费钱哦。\n");     
                return 1;
        }
        who = present(id,environment(me));
        if( !who || who!=this_object() )
                return 0;
        if( strsrch(sth,"+")==-1 )
        {
                num = check_value(sth);
                color = sth;
        }
        else
        {
                clr = explode(sth,"+");
                num = 0;
                color = "";
                for(i=0;i<sizeof(clr);i++)
                {
                        if( !clr[i] || strlen(clr[i])<2 )
                                continue;
                        num+= check_value(clr[i]);
                        color+= clr[i];
                }
        }
        tmp = color+"████"NOR;
        tmp = COLOR_D->replace_color(tmp,1);    
        if( num<=0 )
        {
                write("你购买的超出了我的想象。。。。\n");
                return 1;
        }
        k = num;
        write("你总共需要花费"+k+"两黄金。\n");
        num*= 10000;
        if( num<=0 )
        {
                write("你购买的超出了我的想象。。。。\n");
                return 1;
        }
        
        if( (card=present("card",me))&&card->query("stats")=="on" ) 
                p=1;
        if( afford = me->can_afford(num)||p==1 ) 
        {
                if(p==1&&me->query("balance")-num<0)  
                {
                        write("你帐户里的钱不够。\n");
                        return 1;
                }
                if( afford==2 && p!=1) 
                {
                        write("你没有足够的零钱，而银票又没人找得开。\n");
                        return 1;
                }
                if(p!=1)
                        me->pay_money(num);
                else    me->set("balance",me->query("balance")-num);
                me->set("name_color",color);
                write("你花了"HIY+chinese_number(k)+"两黄金"NOR"修改了自己的名字颜色为"+tmp+NOR"色。\n");
                return 1;
        }
        write("你的钱不够。\n");
        return 1;
}
