#include <dbase.h>
#include <name.h>
#include <ansi.h>
inherit F_EQUIP;
inherit ITEM;

string *color = ({
        "RED","红","WHT","白","BLU","蓝","HIG","绿",
        "YEL","黄",
});     

void create()
{
        int i;
        string name,clr;
        
        i=(random(sizeof(color)/2))*2;   
        clr = color[i];
        name = color[i+1];
        name = clr+name+"面具";
        name = COLOR_D->replace_color(name)+NOR; 
        set_name(name,({"mian ju","mianju"}));
        set_weight(3000);
        if( clonep() ) 
                set_default_object(__FILE__);
        else
        {               
                set("unit","个");
                set("value",0);
                set("no_give",1);
        }
        setup();
        set("armor_type","mianju");
        set("armor_prop",([
                "armor" : 10+random(18),
                "armor_vs_force" : 88+random(888),
                "armor_vs_spells" : 88+random(888),
                "personality" : -random(8),
        ]));
        set("wear_msg","\n");
        set("unequip_msg","\n");
        set("wear_color",clr);
}

int wear()
{
        int i;
        string name,*names,title,id;
        object me; 
        
        if( ::wear() )
        {
                me = environment();
                if( me && me->is_character() 
                && !me->query_temp("d_mana") )
                {
                        if( me->query("gender")!="女性" )
                                names = ({
                                        "忠孝王","伍建章","wu jianzhang","大元帅","高颖","gao ying","靠山王","杨林","yang lin",
                                        "上柱国","贺若弼","he ruobi","大都督","鱼俱罗","yu juluo","昌平王","邱瑞","qiu rui",
                                        "上柱国","韩擒虎","han qinhu","双枪将","定彦平","ding yanping","越王","杨素","yang su",
                                        "十六杰","李元霸","li yuanba","十六杰","裴元庆","pei yuanqing","十六杰","宇文成都","yuwen chengdu",
                                        "十六杰","雄阔海","xiong kuohai","十六杰","伍天锡","wu tianxi","十六杰","程咬金","cheng yaojin",
                                        "十六杰","翟让","zhai rang","十六杰","罗成","luo cheng","十六杰","秦琼","qin qiong",
                                        "十六杰","单雄信","shan xiongxin","十六杰","王君可","wang junke","十六杰","魏文通","wei wentong",
                                        "十六杰","伍云召","wu yunzhao","十六杰","王伯当","wang bodang","十六杰","尚师徒","shang shitu",
                                        "十六杰","左天成","zuo tiancheng",
                                        "四猛","罗士信","luo shixin","四猛","新文理","xin wenli","四猛","秦用","qin yong","四猛","来护儿","lai huer",
                                        "成都王","张显图","zhang xiantu","淮西王","焦本忠","jiao benzhong","铜山王","姚子林","yao zilin",
                                        "皇城总兵","史万宝","shi wanbao","燕山王","罗艺","luo yi",
                                        "东昌王","杨义臣","yang yichen","定国公","长孙晟","zhangsun sheng","沙陀国王","始罗失毕可汗","da ke han",
                                });     
                        else
                                names = ({
                                        "九尾美姬","妲己","da ji","倾国红颜","西施","xi shi","薄命红颜","虞姬","yu ji",
                                        "掌上飞舞","赵飞燕","zhao feiyan","丰腴璧人","杨玉环","yang yuhuan",
                                        "西出边塞","王昭君","wang zhaojun","闭月羞花","貂蝉","diao chan",
                                });
                                                                
                        i = random(sizeof(names)/3)*3;
                        title = names[i];
                        name = names[i+1];
                        id = names[i+2];
                        if( title && id && name )
                        {
                                me->set_temp("d_mana",1);
                                me->set_temp("apply/name",({name}));
                                me->set_temp("apply/id",({id}));
                                me->set_temp("apply/short", ({title+" "+name+"("+capitalize(id)+")"}));
                                if( me->query("gender")!="女性" )
                                        me->set_temp("apply/long", ({"威风凛凛的一位大将军，满面杀气。\n"}));
                                else    me->set_temp("apply/long", ({"手如柔荑,肤如凝脂。领如蝤蛴,齿如瓠犀,螓首娥眉,巧笑倩兮,美目盼兮。\n"}));        
                                me->set_temp("unit",me->query("unit"));
                                me->set_temp("is_character",me->is_character());
                                me->set_temp("gender",me->query("gender"));
                                me->set_temp("age",me->query("age"));
                                me->set_temp("race",me->query("race"));
                                me->set_temp("family",me->query("family"));
                                me->set_temp("name_color",query("wear_color"));
                                me->set_temp("is_living",1);
                                if( me->query("gender")!="女性" )
                                        tell_object(me,"你戴上一张面具，化作一代名将"+name+"。\n");                            
                                else    tell_object(me,"你戴上一张面具，化作一代名媛"+name+"。\n");                                    
                        }
                }
                return 1;
        }
        return ::wear();
}

int unequip()
{
        object me;
        
        if( ::unequip() )
        {
                me = environment();
                if( me->query_temp("d_mana") )
                {
                        me->delete_temp("d_mana");
                        me->delete_temp("apply/name");
                        me->delete_temp("apply/id");
                        me->delete_temp("apply/short");
                        me->delete_temp("apply/long");
                        me->delete_temp("is_living");
                        me->delete_temp("unit");
                        me->delete_temp("is_character");
                        me->delete_temp("gender");
                        me->delete_temp("age");
                        me->delete_temp("race");
                        me->delete_temp("family");
                        me->delete_temp("name_color");
                        tell_object(me,"你将面具从脸上取下。\n");                                       
                }
                return 1;
        }
        return ::unequip();
}       
