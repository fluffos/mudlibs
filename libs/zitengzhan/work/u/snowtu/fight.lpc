#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "战斗区");
  set("long", "没有什么好看的\n\n\n\n\n\n\n");
  set("no_quit", 1);
  set("no_flee", 1);
  set("alternative_die", 1);
  set("exits/out", __DIR__ "workroom");
  setup();
}

void powerup(object who) {
  if (!who)
    return;
  who->set("kee", who->query("max_kee"));
  who->set("eff_kee", who->query("max_kee"));
  who->set("sen", who->query("max_sen"));
  who->set("eff_sen", who->query("max_sen"));
  who->set("force", who->query("max_force") * 2);
  who->set("mana", who->query("max_mana") * 2);
  who->clear_condition();
}

void alternative_die(object me) {
  object ob;
  if (!userp(me)) {
    delete("alternative_die");
    if (me->query_temp("last_damage_from"))
      message_vision("\n\n$N被$n杀死了。\n", me, me->query_temp("last_damage_from"));
    me->die();
    set("alternative_die", 1);
    return;
  }
  powerup(me);
  me->remove_all_killer();
  all_inventory(environment(me))->remove_killer(me);
  message_vision("\n$N「啪」的一声倒在地上，挣扎着抽动了几下就死了。\n\n", me);
  message_vision("地下传来崔判官的声音：切磋之争，不伤阳寿！\n", me);
  message_vision("\n$N慢慢从地上爬将起来。\n", me);
}

void init() {
  add_action("do_kill", "kill");
}

int do_kill(string arg) {
  object who, me = this_player();
  if (!arg) return 0;
  who = present(arg, environment(me));
  if (!who || !living(who) || who == me)
    return 0;
  if (!userp(who)) {
    if (who->is_huanbo() && !who->is_fighting())
      who->copy_data(me);
  }
  who->kill_ob(me);
  me->kill_ob(who);
  return 1;
}

int valid_leave(object who, string dir) {
  if (!userp(who))
    return 0;
  if (who->is_fighting())
    return notify_fail("加油加油。\n");
  return ::valid_leave(who, dir);
}
