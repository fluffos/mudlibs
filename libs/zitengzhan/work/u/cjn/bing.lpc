#include <ansi.h>
inherit ITEM;

void setup() {}

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIR "伊利雪糕" NOR, ({ "xue gao", "gao" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "好吃的冰激凌。\n");
    set("value", 0);
    set("no_sell", 1);
    set("no_drop", 1);
    set("no_put", 1);
    set("no_give", 1);
    set("no_steal", 1);
  }
  setup();
}

int do_eat(string arg) {
  if (!id(arg))
    return notify_fail("你要吃什么？\n");

  this_player()->add("combat_exp", 1000);
  this_player()->add("potential", 500);
  message_vision("$N吃下一个冰激凌，只觉得自己又变利害了一些 !\n", this_player());
  destruct(this_object());
  return 1;
}
