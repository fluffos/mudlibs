inherit NPC;
string ask_sword();
#include <ansi.h>

void create()
{
   set_name(HIW"雪儿"NOR, ({ "xue er", "er" }));
   set("long", @LONG

LONG);
   set("gender", "女性");
   set("age", 20);
   set("attitude", "peaceful");
   set("per",100);//means no rong-mao description.
   set("max_kee", 500);
   set("max_gin", 500);
   set("max_sen", 500);
   set("force", 500);
   set("max_force", 500);
   set("max_mana", 500);
   set("mana", 500);
   set("inquiry",([
     "我的剑": (: ask_sword:) ]));     
setup();
}

string ask_sword()
{
        object ob = this_object();
        object me = this_player();
        object sword;
        sword=new("/doc/wiz/sword.lpc");
        sword->move(me);       
}
 
