#include <ansi.h>
#include <weapon.h>
inherit SWORD;
void create()
{
        set_name( HIW "白玫瑰之约" NOR, ({ "ding's sword", "jian", "sword" }) );
        set_weight(1);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long",  HIW"一把由9999朵白玫瑰的花瓣炼制的花剑,剑身发出淡淡的香味。\n");
                set("value", 0);
                set("material", "steel");
                set("wield_msg", HIC"$N"HIC"纤手轻轻舞动,"HIW"$n"HIC"悄然晃出,剑身发出阵阵幽香。\n");
                set("unequip_msg", HIC"$N"HIC"素手一收"HIW"$n"HIC"随着淡淡的清香消失。\n");
        }

   set("no_sell", 1);
   set("no_drop", 1);
   set("no_put",1);
        init_sword(300);
        setup();

}

mixed hit_ob(object me, object victim, int damage_bonus)
{
        int pro;
        int dam;
        int damage;
        pro = (int) victim->query_temp("apply/armor_vs_spells");
        dam = (int) me->query("force");

        damage = (int) me->query("force_factor");
        if(dam > pro)
        {
        victim->start_busy(2);
        return HIC "白玫瑰之约化作万朵白玫瑰，漫天轻轻的飞舞，$n被眼前情景吸引，怔怔的望着漫天玫瑰，心中涌起往日的无限柔情。\n" NOR;
        }
}
int query_autoload(){return 1;}
