#include <ansi.h>
inherit ITEM;
void setup() {}

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIM "毒药" NOR, ({ "ping guo", "guo" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "包");
    set("long", "这是一棵武林人士梦寐以求的苹果。\n");
    set("value", 0);
  }
  setup();
}

int do_eat(string arg) {
  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  this_player()->set_skill("whip", 250);
  message_vision("$N吃下一个毒药，只觉得自己又变利害了一些 !\n", this_player());
  destruct(this_object());
  return 1;
}
