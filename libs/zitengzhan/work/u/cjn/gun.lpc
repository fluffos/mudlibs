// jingubang.c
#include <weapon.h>
#include <ansi.h>

inherit STICK;

void create()
{         set_name( HIB "我"HIG"只"HIR"爱"BLINK HIC"你" NOR, ({ "Cjn bang", "bang", "gun" }) );
        set_weight(1); 
            if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "根");
                set("value", 500);
                set("material", "gold");
                set("no_get",1);
                set("no_drop",1);
                set("no_give",1);
                set("long", HIW"此棍是楚江南的宝贝。上铸一行小字：“我只爱你”。\n");
                set("wield_msg", YEL"$N一伸手，凌空舞了几个棍花，掌中忽然多了一跟$n。\n");
                set("unwield_msg", YEL"$N一吹气！摆了个很COOL的造型，$n"YEL"在$N掌中转了几转，忽然不见了。\n");
}        
        init_stick(500);
        setup();
} 
int query_autoload(){return 1;}


