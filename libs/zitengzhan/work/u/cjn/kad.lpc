// lingzhi.c 冰糖葫芦
//星星(lywin)2000/4/22

#include <ansi.h>
inherit ITEM;

void setup()
{}

void init()
{
        add_action("do_eat", "eat");
}

void create()
{
        set_name(HIM"可爱多"NOR, ({"bingjiling", "keaiduo"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("long", "这是著名的可爱多冰激凌，吃了另你爽歪歪。\n");
                set("value", 0);
        }
        setup();
}

int do_eat(string arg)
{
        if (!id(arg))
        return notify_fail("你要吃什么？\n");

        message_vision("$N吃下一个可爱多冰激凌，感觉舒服极了 !\n", this_player());
        destruct(this_object());
        return 1;
}
