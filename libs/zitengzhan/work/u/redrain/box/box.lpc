#include <ansi.h>
inherit ITEM;
void create()
           {
        set_name("木箱", ({ "woodcase" , "case"}) );
        set_weight(500);
        set_max_encumbrance(40000);
        if( clonep() )
        set_default_object(__FILE__);
        else 
        {
                set("unit", "口");
                set("long",
"一口扁扁的木箱子，用暗褐色的牛皮包着。你可用它（make）或（remake）出一些兵器来。\n");
       }
            }
int is_container()
 { return 1; }
void init()
         {
        add_action("do_make","make");
}
int do_make(string arg)
     {
            string str;
            object me;
        object obj;
        me=this_player();
        if(environment()==this_player() && (int) this_player()->query("sen")>250)
{               
        if(!arg) return 0;
        {
        me->set("sen",1);

       if(arg=="sword")
       {obj=new(__DIR__"sword");
       obj->move(me);
write("你将手中的箱子打开，用其中的零件拼成了一把长剑。\n");}
        if(arg=="blade")
        {obj=new(__DIR__"blade");
         obj->move(me);
write("你将手中的箱子打开，用其中的零件拼成了一把长刀。\n");}           
         if(arg=="spear")
        {obj=new(__DIR__"spear");
         obj->move(me);
write("你将手中的箱子打开，用其中的零件拼成了一把长枪。\n");}
        if(arg=="axe") 
        {obj=new(__DIR__"axe");
         obj->move(me);
write("你将手中的箱子打开，用其中的零件拼成了一把长斧。\n");}
        if(arg=="mace")
        {obj=new(__DIR__"mace");
         obj->move(me);
write("你将手中的箱子打开，用其中的零件拼成了一把铁鞭。\n");}
        if(arg=="stick")
        {obj=new(__DIR__"stick");
         obj->move(me);
write("你将手中的箱子打开，用其中的零件拼成了一把长棍。\n");}
        if(arg=="fork")
        {obj=new(__DIR__"fork");
         obj->move(me);
write("你将手中的箱子打开，用其中的零件拼成了一把长叉。\n");}
        if(arg=="whip")
        {obj=new(__DIR__"whip");
         obj->move(me);
write("你将手中的箱子打开，用其中的零件拼成了一把长鞭。\n");}   
   if(arg=="staff")
        {obj=new(__DIR__"staff");
         obj->move(me);
write("你将手中的箱子打开，用其中的零件拼成了一把长杖。\n");}   
   if(arg=="hammer")
        {obj=new(__DIR__"hammer");
         obj->move(me);
write("你将手中的箱子打开，用其中的零件拼成了一把铁锤。\n");}   
   if(arg=="zhua")
        {obj=new(__DIR__"zhua");
         obj->move(me);
write("你将手中的箱子打开，用其中的零件拼成了一把长抓。\n");}
{   if(arg=="dayasword" && me->query_skill("daya-jian",1) > 200 )
        {obj=new(__DIR__"dayasword");
         obj->move(me);
write("你将手中的箱子打开，竟然发现其中的零件和自己学的某种剑术极其相仿。\n凭着自己的记忆，$N竟然组装出一把大雅古剑！\n");}     
 {str="听说"+me->name()+"竟然得到了传说中的大雅古剑！"NOR;
 message("channel:rumor",HIC"【江湖传闻】某人："+str+"\n"NOR,users());}}
 destruct(this_object());
        }

        return 1;
}

        return 0;
}
