// telnet console version 1.2
// by hiei@dtxy 2012/06/22
// FROM MUD TELNET TO OTHER IP.
// EESUCCESS      1     /* Call was successful */
// EECALLBACK   -29     /* Wait for callback */

#include <ansi.h>
#include <net/dns.h>
#include <net/telnet.h>
#include <net/socket.h>
#include <net/socket_errors.h>
#include <socket_err.h>

inherit ITEM;

nosave int my_socket;
nosave int tick = 60, cmd_time = 0, cmd_flag = 0;
nosave object me;
string connected;
int qi,qi2,nl,nl2,jing,jing2,jl,jl2;
int nlmax=2200, isnl=1;
int isconnect = 1;
string cmd_buf;

int close_socket();
int do_telnet(string arg);
void parse_cmd();
void heart_beat();

// !:特殊指令 #wa 3:等待指令 @:外部(连线者)指令 “;”为分隔符
// 可使用#3 e的格式，表示e;e;e。指令开头和结尾不能有分号
nosave string check_cmd = "eat mian;he jiudai;jingzuo";
string *trigger = ({
"您的英文名字", "ahri",
"请输入密码", "abc123",
"您要将另一个", "!conn",
"已经和大自然容为一体","eat mian;jingzuo",
"你起身穿","eat mian;he jiudai;out;n;e;e;n;e;enter 洞;e;hp;follow dz",
"你一觉醒来","w;s;s;s;e;e;n;e;enter 洞;e;hp;follow tn",
"多洗对身体有害","#wa 5;bath",
//"你一觉醒来","w;s;s;s;e;e;n;e;enter 洞;e;hp;follow tn",
//"这里没有 read。","!read",
"你现在的气","w;out;w;s;w;w;s;enter;bath",
//"你现在精不","w;out;w;s;w;w;s;enter;bath",
"你现在精不","w;out;w;s;w;w;n;n;n;e;sleep",
"你要花多少气练功","hp;follow dz",
"你要花多少精","hp;follow tn",
"你将内息","hp;follow dz",
"你运功完毕","hp;follow dz",
"你将周身内息","hp;follow dz",
//"内力修为","hp;follow dz",
//"你倒在地上","save;quit;",
//"慢慢地你终于","save;quit;#halt;#quit",
//"想杀死你！","touxiang;halt;save;quit;#halt;#quit",
"你吐纳完毕","er;hp;follow tn",
"这里没有 tn。","!tuna",
"这里没有 dz。","!dazuo",
"【 精 神 】","!getjing",
"【 体 力 】","!getqi",
"你连线进入神雕侠侣","get all;hp;bath;dazuo 10",
"重新连线完毕","bath;dazuo 10",
"古勇士朝你“嘿","halt;touxiang;#wa 2;halt;jingzuo;halt;jingzuo;halt;jingzuo;halt;jingzuo;halt;jingzuo",
"( 你","halt;jingzuo;halt;jingzuo;halt;jingzuo;halt;jingzuo",
"你被扔出了监狱","e;n;w;qu 10 silver;w;give abao 5 silver;到 峨眉",
"不知颠了多少时候","e;e;su;w;enter;w;yp;jingzuo",
});

void create()
{
        set_name("控制台a", ({ "tca" }) );
        set("long","在MUD里连接其他MUD的终端台  a\\ a2t a2q a2c\n tc conn/noconn\n");
        set_weight(0);
        set("no_drop", "1");
        set("no_get","1");
        set("value", 100);
        set("unit", "个");
        set("check_ok", 1);
        setup();
        set_heart_beat(0);
}

void init()
{       
        object ob;

        if( (ob=this_player())->query("id") == "hiei" ) {
                add_action("close_socket","a2c");
                add_action("query_connect","a2q");
                add_action("write_message","a\\");
                add_action("do_telnet","a2t");
                me = ob;
        }
}

string remove_ansi(string str)
{
        int i;
        string *color = ({ BLK, RED, GRN, YEL, BLU, MAG, CYN, WHT,
                           HIR, HIG, HIY, HIB, HIM, HIC, HIW,
                           HBRED, HBGRN, HBYEL, HBBLU, HBMAG, HBCYN, HBWHT,
                           BBLK, BRED, BYEL, BBLU, BMAG, BCYN, BWHT,
                           NOR, BOLD, BLINK });
                           
        if( !str || !stringp(str) ) return 0;
        i = sizeof(color);
         reset_eval_cost();
        while( i-- ) {
                str = replace_string(str, color[i], "");
                }
        return str;
}

void tell_me(string arg)
{
        object ob;
        ob = environment(this_object());
        if( !ob || !userp(ob) ) return;
        if( !interactive(ob) ) return;
        tell_object(ob, arg);
}


void check_send(string arg)
{
        set("check_time", time());
        set("check_ok", 0);
        while( cmd_flag == 1 ) ;
        cmd_flag = 1;
        if( strlen(cmd_buf) > 1 ) cmd_buf = cmd_buf + ";";
        cmd_buf = cmd_buf+check_cmd;
        cmd_flag = 0;
        tell_me("[a] Check send.");
}

void retry_conn(string arg)
{
        do_telnet("118.114.245.12 6666");
}

void check_conn(string arg)
{
        if( query("check_ok") == 0 ) {
                close_socket();
                //remove_call_out("check_conn");
                //remove_call_out("check_send");
                tell_me("30秒后重新连接...\n");
                call_out("retry_conn", 30);
                return;
        }
        tell_me("[a] Check succ.");
        //call_out("check_conn", 60);
        //call_out("check_send", 10);
}

int do_telnet(string arg)
{
        int err;
        if( !arg )
                return notify_fail("telnet to ...？\n");

        if( arg == "conn" ) isconnect = 1;
        else if( arg == "noconn" ) isconnect = 0;

        if( query("connected") ) {
                tell_me( "已有连接。\n" );
                return 1;
        }
        my_socket = socket_create( STREAM, "in_read_callback","in_close_callback" );
        if ( my_socket < 0 ) 
        {
                tell_me( "创建连接失败。\n" );
                return 1;
        }
        err = socket_connect( my_socket, "118.114.245.12 6666" , "read_callback","write_callback" );
        if( err==EESUCCESS ) 
        {
                tell_me("正在连接到 " + arg + "\n");
                connected = arg;
                set("connected",1);
                //remove_call_out("check_conn");
                //call_out("check_conn", 60);
                //remove_call_out("check_send");
                //call_out("check_send", 10);
                cmd_buf="";
                tick = 30;
                set_heart_beat(1);
        }
        else
                tell_me("无法连接 " + arg + "\n");
        return 1;
}

int close_socket()
{
        if( query("connected") )  {
                        if( socket_close(my_socket) ) {
                                tell_me("连接关闭。\n");
                                delete("connected");
                                set_heart_beat(0);
                        }
                        else
                                tell_me("无法关闭连接。\n");
               }
        else
               tell_me("目前无任何连接。\n");
        //remove_call_out("retry_conn");
        //remove_call_out("check_conn");
        connected = 0;
        return 1;
}

void heart_beat()
{
        if( strlen(cmd_buf) > 0 ) tell_me( "[cmd]: "+cmd_buf+"\n");

        tick--;
        if( tick == 20 ) {
                check_send("");
        } else if( tick == 0 ) {
                check_conn("");
                tick = 180;
        }
        parse_cmd();
}

void parse_cmd()
{
        int pos, cnt, k, j;
        string s, t, *cmds;

        if( time() <= cmd_time ) return;
        if( strlen(cmd_buf) < 1 ) return;

        pos = strsrch(cmd_buf, "#wa");
        if( pos != -1 ) { //wait?
                t = cmd_buf[0..pos-1];
                while( cmd_flag == 1 ) ;
                cmd_flag = 1;
                cmd_buf = cmd_buf[pos..<1];
                pos = strsrch(cmd_buf, ';');
                if( pos == -1 ) {
                        s = cmd_buf[4..<1];
                        cmd_buf = "";
                } else {
                        s = cmd_buf[4..pos];
                        cmd_buf = cmd_buf[pos+1..<1];
                }
                cmd_flag = 0;
                sscanf( s, "%d", cnt);
                cmd_time = time()+cnt;
        } else {
                t = cmd_buf;
                cmd_buf = "";
        }

        cmds=explode(t, ";");
        cnt = sizeof(cmds);
        for( k = 0; k < cnt; k++ ) {
                if( cmds[k][0] == '@' ) {
                    me->command( cmds[k][1..<1] );
                } else if( cmds[k][0] == '#' ) {
                    sscanf(cmds[k][1..<1], "%d %s", pos, s);
                    for( j = 0; j < pos; j++ ) socket_write(my_socket, s+"\n");
                } else {
                    socket_write(my_socket,cmds[k]+"\n");
                }
        }
}

void read_callback(int fd, mixed message)
{
        int i, j, cnt1, cnt;
        string s, *lines;

        if( query("check_ok") == 0 ) set("check_ok", 1);

        lines = explode(message,"\n");
        cnt1 = sizeof(lines);
        for(i =0; i<cnt1; i++) {
                for( j = 0; j < sizeof(trigger);j+=2 ) {
                        if( strsrch((string)lines[i], trigger[j]) != -1 ) {
                                if( trigger[j+1][0] == '!' ) {
                                        switch( trigger[j+1] ) {
                                        case "!getqi" :
                                             s = replace_string(lines[i]," ","");
                                             s = remove_ansi(s);
                                             sscanf(s, "【体力】%d/%d(%*d%%)【内力】%d/%d(+%*d)", qi,qi2,nl,nl2);
                                             break;
                                        case "!getjing" :
                                             s = replace_string(lines[i]," ","");
                                             s = remove_ansi(s);
                                             sscanf(s, "【精神】%d/%d(%*d%%)【精力】%d/%d(%*d%%)", jing,jing2,jl,jl2);
                                             break;
                                        case "!tuna" :
                                             cnt = jl2*2-jl;
                                             if ( cnt > jing ) {
                                               if( nl < 50 ) socket_write(my_socket,"tuna 99999\n");
                                               else socket_write(my_socket, sprintf("tuna %d\n", jing));
                                             } else {
                                               if ( cnt < 10 ) cnt = 10;
                                               s = sprintf("tuna %d\n", cnt);
                                               socket_write(my_socket,s);
                                             }
                                             break;
                                        case "!dazuo" :
                                             if ( nl2 >= nlmax ) isnl = 0;
                                             if ( isnl == 1 ) {
                                               if( nl2*2-nl<qi) socket_write(my_socket, sprintf("dazuo %d\n", nl2*2-nl));
                                               else socket_write(my_socket, sprintf("dazuo %d\n", qi-10));
                                               socket_write(my_socket, "dazuo 10\n");
                                             }
                                             else{ socket_write(my_socket,sprintf("tuna %d\n",jl2*2-jl));
                                               socket_write(my_socket, "tuna 10\n"); }
                                             break;
                                         case "!conn" :
                                             socket_write(my_socket, sprintf("%s\n", (isconnect?"y":"n"))); 
                                             break;
                                        default: break;
                                        }
                                } else {
                                        while( cmd_flag == 1 ) ;
                                        cmd_flag = 1;
                                        if( strlen(cmd_buf) > 1 ) cmd_buf = cmd_buf + ";";
                                        cmd_buf = cmd_buf+trigger[j+1];
                                        cmd_flag = 0;
                                }
                        }
                }
        }

        message = "[a]" + message;
        tell_me( (string) message );
}

void write_callback(int fd)
{
        int res;
        if(query("connect")) return ;
        res = socket_write( fd,"");
        if (res == EESUCCESS || res == EECALLBACK) {
                set("connected",1);
        }
}

int write_message(string arg)
{
        if( !arg ) arg="";
        socket_write(my_socket,arg+"\n");

        return 1;
}

int query_autoload()
{ 
        return 1;
}

int query_connect()
{
        if ( connected )
               tell_me( "现在正连接在" + connected + "\n" );
        else
               tell_me( "现在没有任何连接。\n" );
        return 1;
}

