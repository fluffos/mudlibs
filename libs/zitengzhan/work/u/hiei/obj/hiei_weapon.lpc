// hiei_weapon.c

#include <ansi.h>
#include <weapon.h>

inherit SWORD;

void init()
{
        if( !environment() ) destruct(this_object());
        if( !environment()->is_character() ) destruct(this_object());
        if( wizardp(environment()) )
                add_action("do_hua","hua");
}

int query_autoload()
{
        return 1;
}

void create()
{
        set_name(HBRED HIY "分金断石的剑" NOR, ({ "hiei weapon" }) );
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("value", 0);
                set("material", "steel");
                set("long", "这是飞影的随身武器，只有他才可以运用自如。

\n");
                set("wield_msg", "$n不知何时已经出现在$N手中。\n");
                set("unequip_msg", "$N将手中的$n收回。\n");
        }
        init_sword(10);
        setup();
}

int do_hua(string arg)
{
        object me;
        string s="";

        me = this_player();

        if( !wizardp(me) ) return 0;
        if( !arg )
                return notify_fail("你想幻化成什么？

<sword,blade,axe,...>\n");
        
        if( query("skill_type") == arg )
                return notify_fail("已经是这个类型了。\n");

        set("skill_type", arg);

        switch( arg ) {
                case "blade":
                        s = "分金断石的刀";break;
                case "sword":
                        s = "分金断石的剑";break;
                case "axe":
                        s = "分金断石的斧";break;
                case "staff":
                        s = "分金断石的杖";break;
                case "mace":
                        s = "分金断石的锏";break;
                case "spear":
                        s = "分金断石的枪";break;
                case "fork":
                        s = "分金断石的叉";break;
                case "rake":
                        s = "分金断石的耙";break;
                case "stick":
                        s = "分金断石的棍";break;
                case "whip":
                        s = "分金断石的鞭";break;
                case "music":
                        s = "分金断石的琴";break;
                case "hammer":
                        s = "分金断石的锤";break;
                case "bow":
                        s = "分金断石的弓";break;
                case "dagger":
                        s = "分金断石的刃";break;
                case "unarmed":
                        s = "分金断石的拳";break;
                default:
                        s = "不明物体";break;
        }

        set("name",HBRED HIY + s + NOR);
        message_vision("$N净心默念，手中武器居然变化成了$n！\n", me, 

this_object());
        this_object()->unequip();
        set("weapon_prop/damage", 200);
        this_object()->wield();
        return 1;
}

