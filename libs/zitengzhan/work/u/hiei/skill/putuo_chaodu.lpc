//modify for 大唐西游2 by huarong 2003/12

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
	string msg;
       int skill;
	if( !target ) target = offensive_target(me);

        //if(me->query("family/family_name")!="南海普陀山")
if (!PFM_D->valid_family(me, "南海普陀山"))
                return notify_fail("不是佛门弟子不能用「超生渡化」！\n");
	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
                return notify_fail("超生渡化只能对战斗中的对手使用。\n");
        if((int)me->query_skill("lunhui-zhang", 1) < 100)
            return notify_fail("你的轮回杖修为还不够，使用这一招会有困难！\n");
	 if (me->query("force")<600)
	     return notify_fail("你的内力不够。\n");
        if( time()-(int)me->query_temp("lastchaodu") < 4 )
	     return notify_fail("你刚刚使过超渡绝招，还是歇会儿吧。\n");

	 skill = (int)me->query_skill("staff",1)/2+(int)me->query_skill("lunhui-zhang",1)/2;
        target->add_temp("apply/dodge",-skill);
        target->add_temp("apply/parry",-skill);
   	 me->add("force",-100-skill/4);
        message_brief(me, target, "轮回杖", "「超生渡化」");
        msg = HIR "$N缓缓说道:佛曰,以杀止杀!我今天就大开杀戒.代表佛来惩罚你们这些顽恶之徒!\n" NOR;
         message_vision(msg, me, target, 0, "env/brief_perform");
        msg =  HIY "\n天理循环，报应不爽！"NOR;
         message_vision(msg, me, target, 0, "env/brief_perform");
	 me->set_temp("LUNHUI_perform",0);
         COMBAT_D->do_attack(me,target, me->query_temp("weapon"), 0, "env/brief_perform");
        msg =  HIC "\n天网恢恢，疏而不漏！"NOR;
        message_vision(msg, me, target, 0, "env/brief_perform");
	 me->set_temp("LUNHUI_perform",3);
         COMBAT_D->do_attack(me,target, me->query_temp("weapon"), 0, "env/brief_perform");
        msg =  HIG "\n放下屠刀，立地成佛！"NOR;
        message_vision(msg, me, target, 0, "env/brief_perform");
	 me->set_temp("LUNHUI_perform",5);
         COMBAT_D->do_attack(me,target, me->query_temp("weapon"), 0, "env/brief_perform");
        msg =  HIW "$n"+HIW+"好象已经到了极乐世界．．．．\n"NOR;
        message_vision(msg, me, target, 0, "env/brief_perform");
        target->add_temp("apply/dodge",skill);
        target->add_temp("apply/parry",skill);

	 me->set_temp("lastchaodu",time());
	 return 1;
}
