//create by huarong 2004/9
#include <ansi.h>

inherit SSERVER;

string begin_msg(object me, object target, int i, string w_name) {
  if (i == 0)
    return (CYN "\n$N" + NOR + CYN + "身形一转，足踏莲花步法，心随意动，身形飘忽，漫天身影一俱扑向$n" + NOR + CYN + "！\n" NOR);
  if (i == 1)
    return (CYN "\n$N" + NOR + CYN + "一声冷笑，嘴角微动，一阵阵梵唱如惊涛拍岸，澎湃而出，欲索群魔性命！\n"
      + "$n" + NOR + CYN + "但见得山野云昏日暗，狂风乍起。分明是高僧颂经，听到的却似鬼哭嚎，不由得心惊肉跳。\n" NOR);
  if (i == 2)
    return (CYN "\n$N" + NOR + CYN + "见趁$n" + NOR + CYN + "惊魂未定，收起" + w_name + NOR + CYN + "杖，将无上的佛门罡气于双拳，拳大如斗，\n"
      + "竟以拳代锤，迅雷不及掩耳，呼啸而至$n" + NOR + CYN + "的面门！$n" + NOR + CYN + "顿觉一股巨大无比的\n"
      + "压力扑面而来，大惊失色，连忙倒退几步，企图避开锤势。谁知脑后风起，\n"
      + "拳头竟已转至自己身后截住去路，刹那间落入拳网中，无处可逃！" NOR);
  if (i == 3)
    return (CYN "\n$N" + NOR + CYN + "右手忽将" + w_name + NOR + CYN + "杖抽出，竟然化杖法为指法，左指右杖，一虚一实，同时\n"
      + "使出劫难指！$N" + NOR + CYN + "已将佛门生死悟到极致，施于指法之中！左指曼妙婀娜，充\n"
      + "满生的玄机，右杖却隐隐风雷之声，杀机凌厉。生酝含着死，死寄托着生。\n"
      + "$n" + NOR + CYN + "却在生死之间勉力支撑，被一柔一刚的指风射得千疮百孔，五脏俱焚！\n" NOR);
  if (i == 4)
    return (CYN "\n$N" + NOR + CYN + "鼓足真气，两眼精光暴射，腾身跃至半空，纵声大吼，声震八百里河川，\n"
      + "地动山摇，正是佛门狮子吼！\n" NOR);
  if (i == 5)
    return (CYN "\n$N" + NOR + CYN + "不等身形落稳，又是一声大喝，运起" + w_name + NOR + CYN + "杖直攻向$n" + NOR + CYN + "。$n" + NOR + CYN + "正待凝神接招，\n"
      + "谁知$N" + NOR + CYN + "将招式发挥得淋漓尽致，层出不穷，涛涛不绝。但见得五百罗汉齐至，\n"
      + "奔腾呼喝，登时间云日色变，天地动容！$n" + NOR + CYN + "早已不支，被漫天杖影击中，狂喷鲜血！\n");
  if (i == 6)
    return (CYN "\n$N" + NOR + CYN + "收了杖势，催动莲台心法，一脸肃穆，高念佛号，只见一朵金莲托起$N" + NOR + CYN + "慢慢升至\n"
      + "半空。俨然佛祖降临！$N" + NOR + CYN + "浑身上下金光灿灿，佛相庄严，散发出无比的光辉，普照\n"
      + "大地，四海升平，山河一片金色。$N" + NOR + CYN + "声如洪钟，沉声喝道：我佛慈悲，还不拜伏皈依！" NOR);
  else return ("shake");
}

string begin_msg1(object me, object target, int i) {
  if (i == 0)
    return (HIW "\n【" + BLINK + "大象无形" + NOR + HIW + "】\n" NOR);
  if (i == 1)
    return (HIM "\n【" + BLINK + "索命梵音" + NOR + HIM + "】\n" NOR);
  if (i == 2)
    return (HIG "\n【" + BLINK + "大势轮回" + NOR + HIG + "】\n" NOR);
  if (i == 3)
    return (HIB "\n【" + BLINK + "无生无死" + NOR + HIB + "】\n" NOR);
  if (i == 4)
    return (HIR "\n【" + BLINK + "佛门狮吼" + NOR + HIR + "】\n" NOR);
  if (i == 5)
    return (HIY "\n【" + BLINK + "天下无魔" + NOR + HIY + "】\n" NOR);
  if (i == 6)
    return (HIW "\n【" + BLINK + "佛光普照" + NOR + HIW + "】\n" NOR);
  else return ("shake");
}

string staff(object me, object target, int i, string w_name) {
  if (i == 0)
    return (HIR + "渡劫！" + HIW + "\n$N" + HIW + "默吟佛号，手中的" + w_name + HIW "带一层淡淡的白雾直直拍向$n" + HIW "的胸前！\n" NOR);
  if (i == 1)
    return (HIR + "渡难！" + HIW "\n$N" + HIW + "手中" + w_name + HIW "一振，白色劲气已然布满全身，风雷之声渐起！\n" NOR);
  if (i == 2)
    return (HIR + "渡厄！" + HIW "\n$N" + HIW + "梵唱又起，" + w_name + HIW "象鼓满了风的劲帆，汹涌而出！\n" NOR);
  else return ("shake");
}

int perform(object me, object target) {
  int damage, skill, i, j, k, f;
  int myexp, youexp, ratio;
  int mydodge, tdodge, myforce, tforce, myforce2, tforce2, myspell, tspell, myspell2, tspell2;
  int hammerdamage, mydh, hisdh, myunarmed, tparry, mystaff, spelll;
  object weapon = me->query_temp("weapon");
  string msg;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail(HIW + "「佛光普照」" + NOR + "只能对战斗中的对手使用。\n");
  //   if(!wizardp(me) && me->query("family/family_name")!="南海普陀山")
  if (!PFM_D->valid_family(me, "南海普陀山"))
    return notify_fail(HIW + "「佛光普照」" + NOR + "只有普陀门人才可以用！\n");

  if ((int)me->query("force") < 2000)
    return notify_fail("你的内力不够了!\n");

  if ((int)me->query("mana") < 2000)
    return notify_fail("你的法力不够了!\n");

  if ((int)me->query_skill("staff", 1) < 250
    || me->query_skill_mapped("staff") != "lunhui-zhang")
    return notify_fail("你的「基本杖法」还不到家，无法使用" + HIW + "「佛光普照」" + NOR + "！\n");

  if ((int)me->query_skill("jienan-zhi", 1) < 250)
    return notify_fail("你的「劫难指」还不到家，无法使用" + HIW + "「佛光普照」" + NOR + "！\n");

  if ((int)me->query_skill("hammer", 1) < 250)
    return notify_fail("你的「基本锤法」还不到家，无法使用" + HIW + "「佛光普照」" + NOR + "！\n");

  if ((int)me->query_skill("bighammer", 1) < 250)
    return notify_fail("你的「大势锤」还不到家，无法使用" + HIW + "「佛光普照」" + NOR + "！\n");

  if ((int)me->query_skill("lunhui-zhang", 1) < 250)
    return notify_fail("你的「轮回仗」等级不够，无法使用" + HIW + "「佛光普照」" + NOR + "！\n");

  if ((int)me->query_skill("lotusmove", 1) < 250)
    return notify_fail("你的「莲花步」等级不够，无法推动" + HIW + "「佛光普照」" + NOR + "！\n");

  if ((int)me->query_skill("lotusforce", 1) < 250)
    return notify_fail("你的「莲台心法」还不到家，无法自由进行" + HIW + "「佛光普照」" + NOR + "！\n");

  if ((int)me->query_skill("buddhism", 1) < 250)
    return notify_fail("你的「大乘佛法」还不到家，无法自由进行" + HIW + "「佛光普照」" + NOR + "！\n");


  if (time() - (int)me->query_temp("zhao_end") < 10)
    return notify_fail("此乃南海普陀山之精髓所在，用多了就烂了！\n");

  myexp = (int)me->query("combat_exp", 1);
  youexp = (int)target->query("combat_exp", 1);
  ratio = to_int((to_float(myexp) / 10) / (to_float(youexp) / 1000));
  if (ratio > 200) ratio = 200;
  if (ratio < 20) ratio = 20;

  skill = (int)me->query_skill(
    "lunhui-zhang",
    1
  ) + (int)me->query_skill("jienan-zhi", 1) + (int)me->query_skill("bighammer", 1);
  hammerdamage = (int)me->query_skill("hammer", 1) + (int)me->query("buddhism", 1);
  hammerdamage = hammerdamage + random(hammerdamage);

  mydodge = (int)me->query_skill("lotusmove", 1);
  tdodge = (int)target->query_skill(target->query_skill_mapped("dodge"), 1);
  myforce = (int)me->query_skill("lotusforce", 1);
  tforce = (int)target->query_skill(target->query_skill_mapped("force"), 1);
  myspell = (int)me->query_skill("buddhism", 1);
  tspell = (int)target->query_skill(target->query_skill_mapped("spells"), 1);
  myunarmed = (int)me->query_skill("unarmed", 1);
  mystaff = (int)me->query_skill("staff", 1);
  tparry = (int)target->query_skill(target->query_skill_mapped("parry"), 1);

  mydh = (int)me->query("daoxing", 1);
  hisdh = (int)target->query("daoxing", 1);
  myforce2 = (int)me->query("max_force", 1);
  tforce2 = (int)target->query("max_force", 1);
  //        myspell2=(int)me->query("max_mana",1);
  //        tspell2=(int)target->query("max_mana",1);

  //me->delete("env/brief_message");
  //target->delete("env/brief_message");

  i = 0;
  message_brief(me, target, "轮回杖", "「佛光普照」");
  message_vision(begin_msg1(me, target, i), me, target, 0, "env/brief_perform");
  message_vision(
    begin_msg(me, target, i, weapon->query("name")),
    me,
    target,
    0,
    "env/brief_perform"
  );
  if (mydodge > random(tdodge)) {
    message_vision(CYN "$n" + NOR + CYN + "只觉眼前一花，便失去$N" + NOR + CYN + "的踪影，又却看见四面八方$N" + NOR + CYN + "无处不在，全力攻\n"
      + "向自己，当即手足无措！\n" NOR, me, target, 0, "env/brief_perform");
    target->start_busy(random(2));
  } else
    message_vision(
      CYN "$n" + NOR + CYN + "却早已识破此中玄机，运出独门轻功绝技，跳出圈外。\n" NOR,
      me,
      target,
      0,
      "env/brief_perform"
    );


  for (j = 1; j <= 5; j++) {
    i++;
    i = i + 1 + random(2);
    if (i > 5) continue;
    message_vision(begin_msg1(me, target, i), me, target, 0, "env/brief_perform");
    message_vision(
      begin_msg(me, target, i, weapon->query("name")),
      me,
      target,
      0,
      "env/brief_perform"
    );

    if (i == 1) {
      if (random(myforce + myspell) > random((tforce + tspell) * 2 / 3)) {
        message_vision(
          HIC "$n" + HIC + "只觉得四下里梵唱之音一浪高过一浪，心弦激荡，血脉贲张，浑身血管经脉一并暴裂！\n" NOR,
          me,
          target,
          0,
          "env/brief_perform"
        );
        target->add("force", -myforce - random(myforce));
        if (target->query("force") < 0)
          target->set("force", 0);

      } else if (random(myforce + myspell) > random((tforce + tspell) / 3)) {
        message_vision(
          HIC "$n" + HIC + "只觉头上似给戴了一个紧箍，越收越紧，头痛欲裂！\n" NOR,
          me,
          target,
          0,
          "env/brief_perform"
        );
        target->add("force", -myforce / 2 - random(myforce) / 2);
        if (target->query("force") < 0)
          target->set("force", 0);
      } else
        message_vision(
          HIG "$n" + HIG + "只觉眼前一花，便失去$N" + NOR + CYN + "的踪影，又却看见四面八方$N" + NOR + CYN + "无处不在，全力攻向自己，当即手足无措！\n" NOR,
          me,
          target,
          0,
          "env/brief_perform"
        );
    } else if (i == 2) {
      f = random(hisdh + mydh);
      if (f > hisdh) {
        message_vision(
          HIR "\n$n" + HIR + "不堪重压，身子象要爆开一般，奇痛无比！波的喷出一口鲜血！\n " NOR,
          me,
          target,
          0,
          "env/brief_perform"
        );
        target->receive_damage("kee", hammerdamage);
        target->receive_wound("kee", hammerdamage / 2);
        if (wizardp(me) && me->query("env/combat") == "verbose")
          tell_object(me, sprintf(HIM + BLINK + "hammerdamage: %d\n" NOR, hammerdamage));
        COMBAT_D->report_status(target);
        me->add("force", -hammerdamage / 4 - random(hammerdamage) / 4);
      } else if (f > hisdh / 2) {
        message_vision(
          HIR "\n$n" + HIR + "不堪重压，波的喷出一口鲜血！\n " NOR,
          me,
          target,
          0,
          "env/brief_perform"
        );
        target->receive_damage("kee", hammerdamage / 2);
        target->receive_wound("kee", hammerdamage / 4);
        if (wizardp(me) && me->query("env/combat") == "verbose")
          tell_object(me, sprintf(HIM + BLINK + "hammerdamage: %d\n" NOR, hammerdamage / 2));
        COMBAT_D->report_status(target);
        me->add("force", -hammerdamage / 6 - random(hammerdamage) / 6);
      } else if (f > hisdh / 4) {
        message_vision(
          HIR "\n$n" + HIR + "暗运内力向抗，但还是喷出一口鲜血！\n " NOR,
          me,
          target,
          0,
          "env/brief_perform"
        );
        target->receive_damage("kee", hammerdamage / 3);
        target->receive_wound("kee", hammerdamage / 6);
        if (wizardp(me) && me->query("env/combat") == "verbose")
          tell_object(me, sprintf(HIM + BLINK + "hammerdamage: %d\n" NOR, hammerdamage / 3));
        COMBAT_D->report_status(target);
        me->add("force", -hammerdamage / 8 - random(hammerdamage) / 8);
      } else
        message_vision(
          HIB "\n$n" + HIB + "暗运内力，逼回了这股劲风！\n" NOR,
          me,
          target,
          0,
          "env/brief_perform"
        );
    } else if (i == 3) {
      if (myunarmed > random(tparry)) {
        message_vision(
          HIR "只听见「嗤」的一声轻响，$N" + HIR + "右手食指已经在$n" + HIR + "身上戳出一个血窟窿。\n\n" NOR,
          me,
          target,
          0,
          "env/brief_perform"
        );
        myunarmed = myunarmed * ratio / 100;
        target->receive_damage("kee", myunarmed * 2 + random(myunarmed));
        target->receive_wound("kee", random(myunarmed) / 3);
        if (wizardp(me) && me->query("env/combat") == "verbose")
          tell_object(
            me,
            sprintf(HIM + BLINK + "unarmeddamage: %d\n" NOR, myunarmed + random(myunarmed))
          );
        COMBAT_D->report_status(target);
        me->add("force", -myunarmed / 4 - random(myunarmed) / 4);
      } else
        message_vision(
          HIG "\n$n" + HIG + "巧运内功，闪过了这股掌风！\n" NOR,
          me,
          target,
          0,
          "env/brief_perform"
        );
    } else if (i == 4) {
      f = random(tforce2);
      damage = myforce2 - tforce2 * 2 / 3;
      damage -= (int)target->query_temp("apply/armor_vs_force");
      if (damage < 0) damage = 0;
      if (damage > 1000) damage = 800 + random(200);
      damage = damage * ratio / 100;

      if (myforce2 > tforce2 * 3 / 4 && random(myforce2) > f / 2) {
        message_vision(
          HIR "$n" + HIR + "被震得眼前一黑，腹内似四海翻腾，脑中轰鸣不至，摇摇晃晃，扑倒在地，七窍流血！\n\n" NOR,
          me,
          target,
          0,
          "env/brief_perform"
        );
        target->receive_damage("sen", damage);
        target->receive_wound("sen", random(damage) / 2);
        if (wizardp(me) && me->query("env/combat") == "verbose")
          tell_object(me, sprintf(HIM + BLINK + "sendamage: %d\n" NOR, damage));
        COMBAT_D->report_sen_status(target);
        me->add("force", -damage / 4);
      } else if (myforce2 > tforce2 / 2 && random(myforce2) > f / 2) {
        message_vision(
          HIR "$n" + HIR + "被震得眼前一黑，跌坐在地，却强压住胸腔的腥咸翻腾，勉力支撑。\n\n" NOR,
          me,
          target,
          0,
          "env/brief_perform"
        );
        target->receive_damage("sen", damage / 2);
        target->receive_wound("sen", random(damage) / 4);
        if (wizardp(me) && me->query("env/combat") == "verbose")
          tell_object(me, sprintf(HIM + BLINK + "sendamage: %d\n" NOR, damage / 2));
        COMBAT_D->report_status(target);
        me->add("force", -damage / 8);
      } else
        message_vision(
          HIG "\n$n" + HIG + "心中一凛，连忙盘腿打坐，收住心神，不为所动。\n" NOR,
          me,
          target,
          0,
          "env/brief_perform"
        );
    } else if (i == 5) {
      for (k = 0; k <= 2; k++) {
        message_vision(
          staff(me, target, k, weapon->query("name")),
          me,
          target,
          0,
          "env/brief_perform"
        );
        damage = random(mystaff) + mystaff * 2;
        damage -= (int)target->query_temp("apply/armor");
        damage = damage * ratio / 100;
        if (damage < 0) damage = 0;

        if ((mystaff) > random(tparry) && damage > 0) {
          message_vision(
            HIM + "招式太快太突然，$n" + HIM + "无从躲避，中了一杖！\n" NOR,
            me,
            target,
            0,
            "env/brief_perform"
          );
          target->receive_damage("kee", damage);
          target->receive_wound("kee", random(damage));
          if (wizardp(me) && me->query("env/combat") == "verbose")
            tell_object(
              me,
              sprintf(HIM + BLINK + "staffdamage: %d\n" NOR, random(mystaff) + mystaff)
            );
          COMBAT_D->report_status(target);
          me->add("force", -damage / 8);
        } else
          message_vision(HIG "\n$n" + HIG + "看准来势，轻松掠过。\n" NOR, me, target, 0, "env/brief_perform");
      }
      continue;
    }
  }

  i = 6;
  message_vision(begin_msg1(me, target, i), me, target, 0, "env/brief_perform");
  message_vision(
    begin_msg(me, target, i, weapon->query("name")),
    me,
    target,
    0,
    "env/brief_perform"
  );
  f = random(tspell);
  spelll = myspell * 2 + random(myspell / 2);
  spelll -= (int)target->query_temp("apply/armor");
  spelll -= (int)target->query_temp("apply/armor_vs_spells");
  if (spelll < 0) spelll = 0;
  if (spelll > 700) spelll = 700;
  //        spelll=spelll*ratio/100;

  if (myspell > tspell * 3 / 4 && random(myspell) > f / 2) {
    message_vision(HIY + "\n$n早已将全身最后的力量凝集，纵身跃起，全力攻向$N" + HIY + "。$N" + HIY + "凝神运气，将毕生功力\n"
      + "凝于袈裟之上，放出万道金光，将$n" + HIY + "击得跪伏于地！\n" NOR, me, target, 0, "env/brief_perform");
    target->receive_damage("kee", spelll * 2 + random(spelll));
    target->receive_wound("kee", random(spelll));
    target->receive_damage("sen", spelll * 2 + random(spelll));
    target->receive_wound("sen", random(spelll));
    if (wizardp(me) && me->query("env/combat") == "verbose")
      tell_object(me, sprintf(HIM + BLINK + "spelldamage: %d\n" NOR, spelll * 2 + random(spelll)));
    COMBAT_D->report_status(target);
    COMBAT_D->report_sen_status(target);
    me->add("mana", -spelll / 4 - random(spelll) / 8);
  } else if (myspell > tspell / 2 && random(myspell) > f / 2) {
    message_vision(
      HIY + "\n$n" + HIY + "早已奄奄一息，忽见佛光祥和，心中感念涕淋，浑身瘫软，五体投地，拜伏皈依。\n" NOR,
      me,
      target,
      0,
      "env/brief_perform"
    );
    target->receive_damage("kee", spelll + random(spelll));
    target->receive_wound("kee", random(spelll) / 2);
    target->receive_damage("sen", spelll + random(spelll));
    target->receive_wound("sen", random(spelll) / 2);
    if (wizardp(me) && me->query("env/combat") == "verbose")
      tell_object(me, sprintf(HIM + BLINK + "spelldamage: %d\n" NOR, spelll + random(spelll)));
    COMBAT_D->report_status(target);
    COMBAT_D->report_sen_status(target);
    me->add("mana", -spelll / 6 - random(spelll) / 8);
  } else
    message_vision(HIG "\n$n" + HIG + "冷笑一声，跳出圈外。\n" NOR, me, target, 0, "env/brief_perform");

  target->set_temp("last_damage_from", me);
  me->start_busy(1 + random(2));
  me->set_temp("zhao_end", time());
  return 1;
}
