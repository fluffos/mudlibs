#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target)
{
        string msg;
        int mydh, hisdh,damage,i;
        object weapon;
        if(me->is_busy())
                return notify_fail("你现在没空！！\n");
        if ( (int)me->query_skill("bighammer",1)< 60) 
               return notify_fail("你的[大势锤]还不够纯熟！\n");
        if ( (int)me->query_skill("buddhism",1)< 60) 
               return notify_fail("你的[大乘佛法]还不够纯熟！\n");
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("［大势将至］只能对战斗中的对手使用。\n");
      //  if(me->query("family/family_name")!="南海普陀山")
if (!PFM_D->valid_family(me, "南海普陀山"))
                return notify_fail("[大势将至]只有出家人才能使用。\n");
        if((int)me->query("force") < 500 ) return notify_fail("你的内力不足！\n");
        if((int)me->query("sen") < 200 ) return notify_fail("你无法集中精力！\n");
        if( time()-(int)me->query_temp("dashi_end") < 6 )
                return notify_fail("绝招用多就不灵了！\n");

             me->add("force", -200);
             me->receive_damage("sen", 100);
             me->receive_damage("kee", 100+random(200));
        weapon = target->query_temp("weapon");
        mydh = (int)me->query("daoxing",1);
        hisdh= (int)target->query("daoxing",1);
       message_vision(HIR "\n$N身形立定口诵佛号，$n只觉得一种巨大的压力扑面而来！\n" NOR,me,target);
       i=random(hisdh+mydh);
       damage=random((int)me->query_skill("buddhism",1)*2)+(int)me->query_skill("buddhism",1)*3;
       damage -=(int)target->query_temp("apply/armor");
       if(damage<0) damage=0;
       if (wizardp(me) && me->query("env/combat")=="verbose")
                   tell_object(me, sprintf(HIM+BLINK+"damage: %d\n" NOR, damage));

          if(  i > hisdh && damage>0 )  
           {
               message_vision(HIR "\n$n"+HIR+"不堪重压，身子象要爆开一般，奇痛无比！波的喷出一口鲜血！\n " NOR,me,target);
                 target->receive_damage("kee",damage,me);
               target->receive_wound("kee",damage/2,me);
                COMBAT_D->report_status(target);
            }
         else if ( i > hisdh /2 && damage>0 )
            {
               message_vision(HIR "\n$n"+HIR+"不堪重压，波的喷出一口鲜血！\n " NOR,me,target);
                 target->receive_damage("kee",damage/2,me);
               target->receive_wound("kee",damage/4,me);
                COMBAT_D->report_status(target);
              }
         else if ( i > hisdh/4 && damage>0 )
              {
               message_vision(HIR "\n$n"+HIR+"暗运内力向抗，但还是喷出一口鲜血！\n " NOR,me,target);
                 target->receive_damage("kee",damage/3,me);
               target->receive_wound("kee",damage/6,me);
                COMBAT_D->report_status(target);
               }
        else 
             message_vision(HIB"\n$n"+HIB+"暗运内力，逼回了这股劲风！\n" NOR, me, target);
        me->start_busy(1+random(1));
        me->improve_skill("bighammer", 1, 1);
        me->set_temp("dashi_end",time());
         return 1;
}

