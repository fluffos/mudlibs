// hiei's home

inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "幻境");
  set("long", "这里什么也没有，你也看不到周围的景物。\n");
  set("no_clean_up", 1);
  set("exits", ([
    "kz": "/d/city/kezhan",
    "west": "/d/wiz/wizroom",
    "up": "/d/wiz/newsroom",
    "down": "/d/wiz/entrance",
  ]));

  set("objects", ([
    __DIR__ "npc/yukina": 1,
  ]));

  setup();
  replace_program(ROOM);
}
