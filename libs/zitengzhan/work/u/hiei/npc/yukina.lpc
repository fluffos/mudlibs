#include <ansi.h>

inherit NPC;

void create() {
  set_name("雪菜", ({ "yukina" }));
  set("gender", "女性");
  set("age", 18);
  set("per", 30 + random(5));
  set("title", HIW "雪国之女" NOR);
  set("long", "她是出生在冰河之国的雪女，飞影的妹妹。\n");
  set("combat_exp", 500000);
  set("attitude", "friendly");
  setup();
  carry_object("/d/obj/cloth/xiuhuaxie")->wear();
  carry_object("/d/obj/cloth/pink_cloth")->wear();
}

void init() {
  object ob;

  ob = this_player();

  if (ob->query("eff_kee") < ob->query("max_kee")) {
    ob->receive_heal("kee", 10000);
    tell_object(ob, "雪菜用一道柔和的白光笼罩了你身体。\n");
  }
  if (ob->query("eff_sen") < ob->query("max_sen")) {
    ob->receive_heal("sen", 10000);
    tell_object(ob, "雪菜用一道温柔的蓝光注入你灵台。\n");
  }

}
