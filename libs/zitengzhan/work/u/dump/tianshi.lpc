//inherit "/std/char/knower";
inherit NPC;
int give_gqliwu(object me);
#include <ansi.h>
 
void create()
{
    set_name("礼物天使", ({"liwu tianshi","tianshi"}));
    set ("long", @LONG

传说中的天使，她可以帮你得到春节期间的礼物。
LONG);
        set("gender", "女性");
        set("title",HIW"天使"NOR);
        set("age", 21);
        set("per", 40);
        set("attitude", "peaceful");
        set("shen_type", 1);
       set("max_kee", 10000);
       set("max_sen", 10000);
       set("force", 100000);
       set("max_force", 20000);
       set("force_factor", 1000);
       set("max_mana", 20000);
       set("mana", 100000);
       set("mana_factor", 1000);
       set("combat_exp", 50000000);
       set("daoxing", 50000000);

        set("inquiry", ([
        "gift":(:give_gqliwu:),
        "礼物":(:give_gqliwu:),
]));
        setup();
}

int give_gqliwu(object me)
{
	me=this_player();
	
 if(me->query("gift/08gq"))   {
    write(HIY"你已经得到了礼物吧？\n"NOR);
			return 1;
	}
          write(HIY"春节快乐!\n你得到了100年道行，50000武学，30000潜能。\n"NOR);
        me->add("daoxing",100000);
         me->add("combat_exp",50000);
    me->add("max_force",500);
me->add("max_mana",500);
me->add("mana",500);
me->add("maximum_force",500);
me->add("maximum_mana",500);
me->add("potential",30000);
me->set("gift/08gq",1);
        me->save();
	return 1;
}
