inherit ROOM;
#include <ansi.h>

void create() {
  set("short", HIY "世" HIR "外" HIW "桃" HIB "源" NOR);
  set("long", "

这是一间被青山绿水环绕其间的小屋，屋内陈设简单，虽然
没有高贵豪华的家具物品，但是却很干净整洁，在主人
的精心设计和布置下显得非常典雅别致，一踏入这个小
屋就能闻到一股淡淡的清香。正面墙上有一幅字(word)，
遒劲有力，落笔不俗，显然是出自名家手笔。\n");

  set("exits", ([ /* sizeof() == 3 */
    "kz": "/d/city/kezhan",
    "wizz": "/d/wiz/wizroom",
  ]));
  set("item_desc", ([ /* sizeof() == 1 */
    "word": "
                宁        超
                静        凡
                致        脱
                远        俗
        " ]));
  set("no_time", 1);
  set("no_kill", 1);
  set("no_fight", 1);
  set("no_magic", 1);
  set("valid_startroom", 1);
  setup();
}
