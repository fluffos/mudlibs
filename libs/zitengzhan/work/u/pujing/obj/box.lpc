inherit ITEM;
#include <ansi.h>
void create() {
  set_name(HIR "礼品盒" NOR, ({ "lipin box", "box" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("long",
      "这是一个" HIR "新年礼品盒" NOR "，送给每位支持
大唐西游的玩家。你可以拆开(chai)包装打开(open)来看看。\n");
    set("value", 0);
    set_weight(10);
    set("no_drop", 1);
    set("no_give", 1);
    set("no_steal", 1);

  }
  setup();
}
void init() {
  add_action("do_open", "open");
  add_action("do_dakai", "chai");

}
int do_dakai(string arg) {
  object me = this_player();
  string message;
  int col;
  if (arg == "box") {
    me->set("can_opengift", 3);
    tell_object(me,
      HIG "\n" +
      "     ┏━━━━━━━━ " BLINK "" HIW "新年快樂" NOR "" HIG " ━━━━━━━━┓\n" +
      "     ┃  ┌────  Happy new year  ────┐  ┃\n" +
      "     ┃  │                                  │  ┃\n");
    if (strlen(me->query("name")) == 2) tell_object(me,
      HIG "     ┃  │  亲爱的" + me->query("name") + "：                      │  ┃\n");
    if (strlen(me->query("name")) == 4) tell_object(me,
      HIG "     ┃  │  亲爱的" + me->query("name") + "：                     │  ┃\n");
    if (strlen(me->query("name")) == 6) tell_object(me,
      HIG "     ┃  │  亲爱的" + me->query("name") + "：                   │  ┃\n");
    if (strlen(me->query("name")) == 8) tell_object(me,
      HIG "     ┃  │  亲爱的" + me->query("name") + "：                │  ┃\n");
    if (strlen(me->query("name")) == 10) tell_object(me,
      HIG "     ┃  │  亲爱的" + me->query("name") + "：              │  ┃\n");
    tell_object(me,
      HIG "     ┃  │  愿您在这个非常特殊的日子里：    │  ┃\n" +
      "     ┃  │      工作顺利，万事如意。        │  ┃\n" +
      "     ┃  │                                  │  ┃\n" +
      "     ┃  │         " HIR "┏━━━━━┓" NOR "" HIG "           │  ┃\n" +
      "     ┃  │         " HIR "┃ 龍馬精神 ┃" NOR "" HIG "           │  ┃\n" +
      "     ┃  │   " HIR "┏━┓┗━━━━━┛┏━┓" NOR "" HIG "     │  ┃\n" +
      "     ┃  │   " HIR "┃逢┃              ┃迎┃" NOR "" HIG "     │  ┃\n" +
      "     ┃  │   " HIR "┃千┃　 ━　 ━━  ┃新┃" NOR "" HIG "     │  ┃\n" +
      "     ┃  │   " HIR "┃禧┃ ━┳━┏━┓ ┃春┃" NOR "" HIG "     │  ┃\n" +
      "     ┃  │   " HIR "┃举┃ ┃┃┃┗━┛ ┃普┃" NOR "" HIG "     │  ┃\n" +
      "     ┃  │   " HIR "┃世┃ ┃┃┃┏┳┓ ┃天┃" NOR "" HIG "     │  ┃\n" +
      "     ┃  │   " HIR "┃共┃　 ┃　┃╋┃ ┃同┃" NOR "" HIG "     │  ┃\n" +
      "     ┃  │   " HIR "┃欢┃　 ┛　┗┻┛ ┃庆┃" NOR "" HIG "     │  ┃\n" +
      "     ┃  │   " HIR "┗━┛　　　　　　  ┗━┛" NOR "" HIG "     │  ┃\n" +
      "     ┃  │                                  │  ┃\n" +
      "     ┃  │            " HIY "『大唐西游巫师组贺』" HIG "  │  ┃\n" +
      HIG "     ┃  └─────────────────┘  ┃\n" +
      "     ┗━━━━━━━━━━━━━━━━━━━━━┛\n" NOR);
  }
  return 1;

}

int do_open(string arg) {
  object me = this_player();

  if (arg != "box")
    return notify_fail("你打开什么?\n");

  if (me->query("can_opengift") != 3)
    return notify_fail("你还没看贺卡呢，这么猴急做什么？\n");

  if (me->query("openbox") == 3)
    return notify_fail("不要这么贪心好不好？\n");

  write(HIY "你打开了" HIR "新年礼品盒" HIY "。。。。。。\n
" HIG "爽～～爽～～爽!\n" NOR "你得到了300000分配点数，你想将它分配在：\n
" HIG "１.潜能。\n" HIY "２.经验。\n" NOR "你的选择是："
    NOR);
  input_to("decide", me);
  return 1;
}
void decide(string arg, object me) {
  if (me->query("openbox") == 3) {
    write("不要这么贪心好不好？\n");
    return;
  }
  if ((int)me->query_temp("gift_1") + (int)me->query_temp("gift_2") > 300000) {
    write("你也太贪心了，当心礼品盒飞了~~~\n");
    me->delete_temp("gift_1");
    me->delete_temp("gift_2");
    me->delete_temp("other_pot");
    me->delete_temp("gift_type");
    return;
  }
  if (arg == "1") {
    write(HIY "\n你要将多少点分配给潜能？" NOR);
    input_to("decide_pot", me);
    me->set_temp("gift_type", "潜能");
    return;
  } else if (arg == "2") {
    write(HIY "\n你要将多少点分配给经验？" NOR);
    input_to("decide_pot", me);
    me->set_temp("gift_type", "经验");
    return;
  } else if (arg == "q") {
    me->delete_temp("gift_1");
    me->delete_temp("gift_2");
    me->delete_temp("other_pot");
    me->delete_temp("gift_type");
    return;
  } else if (arg == "decide") {
    if (me->query_temp("other_pot") > 0) {
      write("\n你还没分配完呢，请选择：");
      input_to("decide", me);
      return;
    }
    if (me->query_temp("gift_1")) {
      write(HIG "\n你得到了" + me->query_temp("gift_1") + "点潜能。\n");
      me->add("potential", me->query_temp("gift_1"));
    }
    if (me->query_temp("gift_2")) {
      write(HIG "你得到了" + me->query_temp("gift_2") + "点经验。\n");
      me->add("combat_exp", me->query_temp("gift_2"));
    }
    me->delete_temp("gift_1");
    me->delete_temp("gift_2");
    me->delete_temp("other_pot");
    me->delete_temp("gift_type");
    me->set("openbox", 3);
    message("channel:rumor", HIM + "【谣言】某人：" + me->query("name") + "小心翼翼的打开了礼品盒！\n" + NOR, users());
    destruct(this_object());
    me->save();
  } else {
    write("\n请重新选择:(q退出)");
    input_to("decide", me);
  }
}
void decide_pot(string arg, object me) {
  int pot, t, p;
  string str;
  sscanf(arg, "%d", pot);
  if (!pot) {
    write("\n请重新选择：");
    input_to("decide", me);
    return;
  }
  if (pot < 0) {
    write("\n你输入有问题，数值不能小于0。\n请重新选择：");
    input_to("decide", me);
    return;
  }
  if (pot > 300000) {
    write("\n你的点数不够分配。\n请重新选择：");
    input_to("decide", me);
    return;
  }
  if (me->query_temp("other_pot")) {
    t = me->query_temp("other_pot");
    if (pot > t) {
      write("\n你的点数不够分配。\n请重新选择：");
      input_to("decide", me);
      return;
    }
  }
  str = me->query_temp("gift_type");
  if (str == "潜能") me->add_temp("gift_1", pot);
  if (str == "经验") me->add_temp("gift_2", pot);
  p = 300000 - me->query_temp("gift_2");
  p -= me->query_temp("gift_1");
  me->set_temp("other_pot", p);
  write("你决定将" + pot + "点分配在" + str + "上，你还剩" + p + "点可以分配。\n请确定你的选择:(decide确定)");
  input_to("decide", me);
  return;
}
