inherit NPC;
#include <ansi.h>

int give_box();
void create() {
  set_name(HIW "圣诞老人" NOR, ({ "shengdan laoren", "laoren" }));
  set("gender", "男性");
  set("title", HIG "圣诞快乐" NOR);
  set("nickname", HIM "飞天而降" NOR);
  set("age", 300);
  set("per", 300);
  set("attitude", "peaceful");
  set("inquiry", ([
    "liwu": (: give_box :),
    "gift": (: give_box :),
    "礼物": (: give_box :),
  ]));
  setup();
  carry_object("/obj/cloth")->wear();
}
int give_box() {
  object me = this_player();
  object ob = this_object();
  object gift;

  if (me->query("gift") == "shengdan") {
    command("say 你已经要过了。\n");
    return 1;
  }

  if (me->query("gift/start") == "shengdan") {
    command("say 你真贪心，要过了还要？\n");
    command("kick" + me->query("id"));
    return 1;
  }
  command("say 圣诞快樂！这个礼品盒送给你。");
  gift = new(__DIR__ "box");
  gift->move(me);

  me->set("gift/start", "shengdan");
  return 1;
}
