inherit NPC;
#include <ansi.h>

int give_box();
void create()
{
        set_name(HIW"礼物精灵"NOR,({"jingling gift","jingling"}));
        set("gender", "男性" );
        set("title",HIG"新年快乐"NOR);
        set("nickname",HIM"三羊开泰"NOR);
        set("age", 300);
        set("per", 300);
        set("attitude", "peaceful");
        set("inquiry", ([
                "liwu"  :       (: give_box :),
                "gift"  :       (: give_box :),
                "礼物"  :       (: give_box :),
        ]));        
        setup();
        carry_object("/obj/cloth")->wear();
}
int give_box()
{
object me= this_player();
object ob= this_object();
object gift;

if (me->query("gift")=="xinnian")
             {
                command("say 懮郁王子说了，每人只有一份。你已经要过了，小心我smash你！\n");
               return 1;
                   }

 if (me->query("gift/start")=="xinnian"){
command("say 你真贪心，要过了还要？\n");
command("kick" + me->query("id"));
return 1;
}
command("say 新年快樂！这个礼品盒送给你。");
gift=new(__DIR__"box");
gift->move(me);

me->set("gift/start","xinnian");
return 1;
}
