//New Moon
//2000/09/08

#include <ansi.h>

inherit ITEM;

nosave object aim_target;

void create() {
  set_name("反隐性导弹", ({ "anti invisiable", "missle" }));
  set_weight(80);
  set("long", "特制的反隐性导弹。据说北约的F-117就是用这个打下来的。\n");
  set("unit", "枚");
  setup();
}

void init() {
  add_action("do_aim", "aim");
  add_action("do_fire", "fire");
}

int do_aim(string arg) {

  object me = this_player();
  object target;

  if (!arg) return notify_fail("虽然是导弹，也要先瞄准的。\n");
  if (arg == "me") return notify_fail("请使用unset invisibility命令比较快。\n");
  if (arg == "none") {
    if (me->query_temp("aiming"))
      me->delete_temp("aiming");
    if ((objectp(target))
      && (target->query_temp("be_aimed")))
      target->delete_temp("be_aimed");
    tell_object(me, "锁定取消。\n");
    return 1;
  };
  if (!(objectp(target = find_player(arg))))
    return notify_fail("无法锁定目标！\n");
  if (!(target->query("env/invisibility")))
    return notify_fail("非隐性目标，请不要浪费这种导弹。\n");
  if ((arg == "me") || (target == me))
    return notify_fail("请使用unset invisibility命令比较快。\n");
  if (me->query_temp("aiming"))
    return notify_fail("多目标跟踪功能尚未实现......\n");
  if (target->query_temp("be_aimed"))
    return notify_fail("目标已锁定。\n");
  message_vision(HIW "$N按动锁定钮，将$n牢牢地套在瞄准光圈内。\n" NOR, me, target);
  me->set_temp("aiming", 1);
  target->set_temp("be_aimed", 1);
  aim_target = target;
  return 1;

}

int do_fire() {
  object me = this_player();

  if ((!objectp(aim_target))
    || (!(aim_target->query_temp("be_aimed"))))
    return notify_fail("目标丢失，无法发射！\n");

  if (!(me->query_temp("aiming")))
    return notify_fail("无锁定目标,无法发射！\n");

  if (!(aim_target->query("env/invisibility")))
    return notify_fail("非隐性目标，请不要浪费这种导弹。\n");

  aim_target->delete("env/invisibility");
  if (aim_target->query_temp("no_heal_up/yinshen"))
    aim_target->delete_temp("no_heal_up/yinshen");
  message_vision(HIY "$N稳稳地按下了“发射”钮。只听“轰”的一声，导弹如离弦之箭朝$n呼啸而去！\n" NOR, me, aim_target);
  if (objectp(environment(aim_target)))
    tell_room(
      environment(aim_target),
      HIY "远处飞来一枚导弹，“轰”地一声把" + aim_target->query("name") + "炸出了身形!\n" NOR
    );
  aim_target->delete_temp("be_aimed");
  me->delete_temp("aiming");
  destruct(this_object());
  return 1;

}
