// telnet console version 1.2
// Modified by Bigfoot@SDXL 99.3.2
// FROM MUD TELNET TO OTHER IP.
// EESUCCESS      1     /* Call was successful */
// EECALLBACK   -29     /* Wait for callback */

#include <ansi.h>
#include <net/dns.h>
#include <net/telnet.h>
#include <net/socket.h>
#include <net/socket_errors.h>
#include <socket_err.h>

inherit ITEM;

nosave int my_socket, socket1, socket2;
nosave object me;
string connected;

void create()
{
        set_name("远程登陆终端台", ({ "Telnet Console", "tc", "telnet", "console" }) );
        set("long",
        "在MUD里连接其他MUD的终端台。\n");
        set_weight(3000);
        set("no_drop", "1");
        set("no_get","1");
        set("unit", "个");
        setup();
}

void init()
{       
        object ob;

        if( interactive(ob = this_player()) ) {
                add_action("close_socket","close");
                add_action("query_connect","query");
                add_action("write_message","/");
                // only allow make one connect
                // if( wiz_level(ob) > wiz_level("(wizard)") )
                add_action("do_telnet","telnet");
                me = ob;
        }
}
void tell_me(string arg)
{
        tell_object(environment(this_object()),arg);
}

int do_telnet(string arg)
{
        int err;
        if( !arg )
                return notify_fail("telnet to ...？\n");
        if( query("connected") ) socket_close(my_socket);
        my_socket = socket_create( STREAM, "in_read_callback","in_close_callback" );
        if ( my_socket < 0 ) {
                tell_me( "创建连接失败。\n" );
                return 1;
                }
        err = socket_connect( my_socket, arg , "read_callback","write_callback" );

        if( err==EESUCCESS ) {
                        tell_me("正在连接到 " + arg + "\n");
                        connected = arg;
                        set("connected",1);
        }
        else
tell_me("无法连接 " + arg + "\n");
        return 1;
}

int close_socket()
{
        if( query("connected") )  {
                        if( socket_close(my_socket) ) {
                                tell_me("连接关闭。\n");
                                delete("connected");
                        }
                        else
                                tell_me("无法关闭连接。\n");
                }
        else
                tell_me("目前无任何连接。\n");
        connected = 0;
        return 1;
}

void read_callback(int fd, mixed message)
{
        message = "\n[remote] " + message;
        tell_me( (string) message );
}

void write_callback(int fd)
{
        int res;
        if(query("connect")) return ;
        res = socket_write( fd,"");
        if (res == EESUCCESS || res == EECALLBACK) {
                set("connected",1);
        }
}

int write_message(string arg)
{
        if( !arg ) arg="";
        socket_write(my_socket,arg+"\n");
        return 1;
}

int query_autoload()
{
        return 1;
}

int query_connect()
{
        if ( connected )
                tell_me( "现在正连接在" + connected + "\n" );
else tell_me( "现在没有任何连接。\n" );
return 1;
}
