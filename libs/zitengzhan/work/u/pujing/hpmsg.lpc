void realtime_hp() {

  write(SAVEC);

  write(SETDISPLAY(4, 0) + DELLINE);
  write(SETDISPLAY(1, 0) + DELLINE);
  write(SETDISPLAY(2, 0) + DELLINE);
  write(SETDISPLAY(3, 0) + DELLINE);
  write(SETDISPLAY(2, 3) + HIM + ("大唐→") + NOR);
  write(SETDISPLAY(2, 9) + HIY + ("气血: ") + NOR);
  write(SETDISPLAY(2, 15) + HIR + (this_player()->query("kee")) + NOR);
  write(SETDISPLAY(2, 19) + HIR + ("/") + NOR);
  write(SETDISPLAY(2, 20) + HIR + (this_player()->query("max_kee")) + NOR);
  write(SETDISPLAY(2, 25) + "┃");
  write(SETDISPLAY(2, 28) + HIY + ("内力: ") + NOR);
  write(SETDISPLAY(2, 34) + HIR + (this_player()->query("force")) + NOR);
  write(SETDISPLAY(2, 39) + HIR + ("/") + NOR);
  write(SETDISPLAY(2, 40) + HIR + (this_player()->query("max_force")) + NOR);
  write(SETDISPLAY(3, 3) + HIM + ("西游→") + NOR);
  write(SETDISPLAY(3, 9) + HIY + ("精神: ") + NOR);
  write(SETDISPLAY(3, 15) + HIR + (this_player()->query("sen")) + NOR);
  write(SETDISPLAY(3, 19) + HIR + ("/") + NOR);
  write(SETDISPLAY(3, 20) + HIR + (this_player()->query("max_sen")) + NOR);
  write(SETDISPLAY(3, 25) + "┃");
  write(SETDISPLAY(3, 28) + HIY + ("法力: ") + NOR);
  write(SETDISPLAY(3, 34) + HIR + (this_player()->query("mana")) + NOR);
  write(SETDISPLAY(3, 39) + HIR + ("/") + NOR);
  write(SETDISPLAY(3, 40) + HIR + (this_player()->query("max_mana")) + NOR);

  write(SETDISPLAY(1, 1) + "┏━━━━━━━━━━━━━━━━━━━━━┓");
  write(SETDISPLAY(2, 1) + "┃");
  write(SETDISPLAY(3, 1) + "┃");
  write(SETDISPLAY(4, 1) + "┗━━━━━━━━━━━━━━━━━━━━━┛");
  write(SETDISPLAY(2, 45) + "┃");
  write(SETDISPLAY(3, 45) + "┃");

  write(REST);

}
