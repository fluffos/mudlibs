// LLY@FYSY 
// sword.c : an example weapon

#include <weapon.h>
#include <ansi.h>
inherit SPEAR;

void create() {
  set_name(HIC "灵玉枪" NOR, ({ "jade spear", "spear" }));
  set_weight(20);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是一把长枪，枪尖略显毫光，是由千年寒铁铸成的。\n");
    set("no_get", 1);
    set("unbreak", 1);
    set("changed", 1);
    set("value", 120000);
    set("material", "steel");
  }
  init_spear(121);
  setup();
}
mixed hit_ob(object me, object victim, int damage_bonus) {
  int dam, myexp, youexp;
  dam = (int)me->query("max_force");
  myexp = (int)me->query("combat_exp");
  youexp = (int)victim->query("combat_exp");
  dam = dam / 10;
  dam = dam * myexp / youexp;
  victim->receive_damage("kee", dam);
  victim->receive_wound("kee", dam / 2);
  victim->add("mana", dam * 3);
  me->add("combat_exp", (dam + random(dam)) / 2);
  me->add("daoxing", dam / 2);
  return notify_fail("\n");
}
