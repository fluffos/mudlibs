inherit ROOM;
void create() {
  set("short", "凤舞九天的办公室");
  set("long", @LONG
凤舞九天的办公室是城中名声恶劣的一个帮会，堂中的人大多是些
亡命之徒，烧杀抢劫，欺压百姓，无恶不做。而官府却很难抓到把
柄而将其除之。正中有三座虎皮大椅，是三位堂主坐的，旁边立了
几个面目凶恶的打手。
LONG);
  set("exits",
    ([  //sizeof() == 4
    "down": "/d/wiz/wizroom",
    ]));
  set("objects",
    ([  //sizeof() == 1
    ]));
  set("no_clean_up", 0);
  setup();
  replace_program(ROOM);
}
