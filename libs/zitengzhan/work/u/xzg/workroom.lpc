inherit ROOM;
#include <room.h>
#include <ansi.h>

void create() {

  set("short", "筱勰的家");
  set("long", @LONG

这是一间被青山绿水环绕其间的小屋，是筱勰办公的地方。
据说这件屋子被筱勰施了魔法，你可以祈祷(qidao)。
心诚则灵，心不诚则不灵。哈哈哈! ! !
LONG);

  set("exits", ([
    "down": "/d/ourhome/kedian",
    "wiz": "/d/wiz/wizroom",
    "heiwu": "d/wiz/blackroom",
    "kz": "/d/city/kezhan",

  ]));

  set("objects", ([ /* sizeof() == 6 */

  ]));

  set("valid_startroom", 1);
  set("if_bed", 1);
  set("sleep_room", 1);
  set("no_clean_up", 0);

  setup();
}
void init() {
  if (wizardp(this_player()))
    add_action("do_tiaoshi", "qidao");
}
int do_tiaoshi(string arg) {
  object me;
  me = this_player();
  write("在你诚心的祈祷下，筱勰出现在你的面前，对你喃喃地念了几句咒语。哈哈，你天下无敌了!\n");

  me->set("max_kee", 10000);
  me->set("max_sen", 10000);
  me->set("force", 30000);
  me->set("max_force", 30000);
  me->set("maximum_force", 30000);
  me->set("mana", 30000);
  me->set("max_mana", 30000);
  me->set("maximum_mana", 30000);
  me->set("combat_exp", 50000000);
  me->set("daoxing", 50000000);
  me->set_skill("unarmed", 500);
  me->set_skill("dodge", 500);
  me->set_skill("parry", 500);
  me->set_skill("stick", 500);
  me->set_skill("spells", 500);
  me->set_skill("dao", 500);
  me->set_skill("puti-zhi", 500);
  me->set_skill("sword", 500);
  me->set_skill("liangyi-sword", 500);
  me->set_skill("wuxiangforce", 500);
  me->set_skill("force", 500);
  me->set_skill("qianjun-bang", 500);
  me->set_skill("jindouyun", 500);
  me->set_skill("literate", 500);
  me->set("fangcun/panlong_accept", "done");

  me->map_skill("spells", "dao");
  me->map_skill("unarmed", "puti-zhi");
  me->map_skill("force", "wuxiangforce");
  me->map_skill("stick", "qianjun-bang");
  me->map_skill("parry", "qianjun-bang");
  me->map_skill("dodge", "jindouyun");
  me->map_skill("sword", "liangyi-sword");

  me->create_family("方寸山三星洞", 1, "弟子");

  me->set("eff_sen", (int)me->query("max_sen"));
  me->set("sen", (int)me->query("max_sen"));
  me->set("eff_gin", (int)me->query("max_gin"));
  me->set("gin", (int)me->query("max_gin"));
  me->set("eff_kee", (int)me->query("max_kee"));
  me->set("kee", (int)me->query("max_kee"));
  me->set("mana", (int)me->query("max_mana"));
  me->set("force", (int)me->query("max_force"));
  me->set("food", (int)me->max_food_capacity());
  me->set("water", (int)me->max_water_capacity());

  return 1;
}
