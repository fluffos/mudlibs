#include <ansi.h>

int update_condition(object me, int duration)
{
me->add("mana",-100);
if(me->query("mana") < 1) me->set("mana", 0);
       me->apply_condition("rulaizhou_poison", duration-1);
 if (duration >0 )
tell_object(me, HIG "你感觉魂魄震荡，念头不聚！\n" NOR );
if( duration < 1 ) return 0;
 return 1;
}
