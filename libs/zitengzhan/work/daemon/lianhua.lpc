
#include <ansi.h>

inherit SSERVER;

#define WIND_FILE "/d/jjf/obj/wind_seal.lpc"


int cast(object me，object target)
{
	string msg;
	int mana, damage, manaf, sen,armor;
	object sleeveroom,sleeve,who;
	string sname;
	object env, *inv;
	int size, i;

	seteuid(getuid());
         	  
         sleeveroom=load_object("/d/wiz/sleeveroom");
	  if(!sleeveroom) return notify_fail("你的袖子恐怕破了。\n");

          sname=me->query("id")+"'s sleeve";
          if(!sleeve=present(sname,sleeveroom)) 
          return notify_fail("你的袖子里啥都没有。\n");

	  size=sizeof(inv=all_inventory(sleeve));
	  if(!size) return notify_fail("你的袖子里啥都没有。\n");

   for(i=0;i<size;i++) {
	    if(inv[i]->is_character())
           who = inv[i];
	  }
       	if( !who || !who->is_character() || who->is_corpse() )
		return notify_fail("你的袖子里没有活物？\n");
         manaf = me->query("mana_factor");
         sen = me->query("sen")/10;
         if(sen < 1) sen = 1;
        mana = me->query("mana")/10;
         if(mana < 1) mana = 1;
         damage = mana + sen + manaf;
         damage = damage/2 + random(damage/2);

          if (me->query("mana") < manaf)
           return notify_fail("你的法力不够。\n");
         msg =  HIR "$N手掐法诀，喃喃念咒，对着袖子喷出一口灵气。\n" NOR;
         message_vision(msg, me);

          for(i=0;i<size;i++)
               {
	    if(inv[i]->is_character())
           who = inv[i];
           armor = who->query("apply/armor_vs_spells");
         if (me->query("mana") < manaf)
             return notify_fail("你的法力枯竭了。\n");
         msg =  HIR "$N的乾坤袖中突然红光大作，铺天盖地的三昧真火把$n烧的焦头烂额。\n" NOR;
          me->add("mana",-manaf);
          damage -= armor;
          if(damage < 0) damage = 1;
          COMBAT_D->report_status(who,1);
          who->receive_damage("kee", damage);
          who->receive_wound("kee", damage/2);
          who->receive_damage("sen", damage);
          who->receive_wound("sen", damage/2);
         message_vision(msg, me, who);
	  }
}
