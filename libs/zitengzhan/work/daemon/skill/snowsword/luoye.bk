int remove_fh (object me)
{      
       if(me->query_temp("luoye_back"))
      {
        message_vision(HIY"\n\n\n$N见到对手已经失去抵抗的能力，便收起了[落叶飞花]。\n\n\n"NOR,me);
       me->set_temp("luoye_back",1);
       me->start_busy(3);
       call_out("luoye_reset",3);
      }
        return 1;
}

int luoye_reset (object me)
{      
       me->delete_temp("luoye_back");
        return 1;
}



void remove_fh16 (object me,int attack_amount)
{
        me->add_temp("apply/attack", attack_amount);
        message_vision(HIC"$N渐渐抛开心事，回过神来。\n\n\n"NOR,me);
    return;
}

void luoye_ready(object me) {
      if (!me) return;
      me->delete_temp("no_luoye");
     
}         

int wait_time() 
{
      return 1;     
}



