int fh12(object me,object target,int waittime)
{
       int damage;
       string str;
        if (!me||!target)
        {
         call_out("remove_fh",1,me);
         remove_call_out("fh12");
         return 1;
        }
       damage = (((int)me->query_skill("snowsword", 1))*2+(int)me->query_skill("sword", 1)-(int)target->query_skill("parry",1));
        if (damage<400) damage=400+random(300);
        if (damage>1500) damage=1500;
       damage=damage*3/2+random(damage*3);
       message_vision(HIC"\n\n\n$N散尽"+HIY"[落叶]"+NOR""+HIC"停下脚步，静静的看着$n略带娇喘，慢慢恢复体力。全力攻击过后$N \n"NOR,me,target);
       message_vision(HIC"罗袖掩剑，立在风中飘飘忽忽，云破月来花弄影，朦胧中$N仿佛足下蹑丝履，头上玳瑁光。\n"NOR,me,target);
       message_vision(HIC"腰若流执素，耳著明月铛。指如削葱根，口如含朱丹。纤纤作细步，当真精妙世无双。\n\n\n"NOR,me,target);
       message_vision(HIY"\n\n\n$n正全力注视$N时，突然间$N身后天空中狂风大作！狂风卷着一个身影箭一般的袭来。\n"NOR,me,target);
       message_vision(HIC"\n\n【猪八戒】哪里来的妖怪好大胆子，竟敢伤嫦娥仙子！\n"NOR,me,target);
       message_vision(MAG"\n\n待到$N回头看清，原来是"+HIY"[天蓬元帅]"+NOR""+MAG"猪八戒，好个呆子，看也不看，举起神兵"+HIY"[九齿钉钯]"+NOR""+MAG"照着$n就是一钯\n"NOR,me,target);
       message_vision(MAG"\n\n$n如何禁得起天蓬元帅这全力一击? 直觉的全身筋骨措动，眼前一片昏暗，连天空都模糊起来。\n"NOR,me,target);
       target->receive_wound("kee",damage);
       if (wizardp(me) && me->query("env/combat")=="verbose") tell_object(me, sprintf(HIM+BLINK+"damage: %d\n" NOR, damage));
       COMBAT_D->report_status(target);
       message_vision(MAG"\n\n猪八戒扛起"+HIY"[九齿钉钯]"+NOR""+MAG"回头一看，才发现$N不是嫦娥，不禁呆了。\n"NOR,me,target);
       message_vision(HIC"【猪八戒】原来不是嫦娥仙子，哎，是我老猪看花眼了。\n"NOR,me,target);
       message_vision(MAG"说罢，摇了摇头，口中默念几句咒语，驾起一阵狂风消失在天边。\n"NOR,me,target);
       if (target->query("eff_kee")<0 || (!living(target) && target->query("kee")<0))
           {  
            str =HIM+me->name()+HIM+"使出了月宫秘传"+HIG+"「落叶」"+HIM+"幻剑式"+HIY+"「如梦如幻」"+HIM+"将"+target->query("name")+HIM+"送去了阎罗地府，据说老猪还来帮着打了一钉耙呢！"NOR;
            me->set_temp("luoye_die",12);
            me->set_temp("luoye_rumor",str);
            if ( !me->query_temp("luoye_rumor_show") )
            {
              message("channel:rumor",HIM"【空穴来风】某人："+str+"\n"NOR,users());
              me->set_temp("luoye_rumor_show",1);
             }
           }
        me->start_busy(waittime+random(2));
       target->start_busy(0);
        return 1;
}


