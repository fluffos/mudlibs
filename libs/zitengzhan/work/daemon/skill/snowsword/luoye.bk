//create by take
//modify by huarong 2003.11
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit SSERVER;
inherit F_DBASE;

int perform(object me, object target)
{
        object ob;
        int damage,waittime,attack_amount,removetime,k;
        string str;
                int tpstr=me->query_str();
                  int tpcon=me->query_con();
                  int tpint=me->query_int();
                  int tpspi=me->query_spi();
                  int tpcps=me->query_cps();
                  int tpper=me->query_per();
                  int tpcor=me->query_cor();
                  int tpkar=me->query_kar();
            
                int yscon=me->query("con");
                int ysint=me->query("int");
                int ysspi=me->query("spi");
                int yscps=me->query("cps");
                int ysper=me->query("per");
                int yskar=me->query("kar");
        
                if (tpcon > 40) tpcon=40;
              if (tpint > 40) tpint=40;
                if (tpspi > 40) tpspi=40;
                if (tpkar > 40) tpkar=40;

                if( !target ) target = offensive_target(me);
       if(me->query("fangcun/luoye_accept") != "done")
                return 0;
 
       if( !target
          || !target->is_character()
          || !me->is_fighting(target) )
                return notify_fail("「落叶飞花」只能在战斗中使用。\n");
                

       if(!wizardp(me)&&(string)me->query("family/family_name") != "月宫")
                return notify_fail("你的风回雪舞剑并非月宫真传,[落叶飞花]乃月宫绝技你怎么会用?\n");

           if( !(ob = me->query_temp("weapon"))
        ||      (string)ob->query("skill_type") != "sword" )
                return notify_fail("使用「落叶飞花」必须拿把剑！\n"); 

        if (me->query_temp("no_luoye") )
                  return notify_fail("你功力还未恢复,无力打出[落叶飞花]\n");

        if( (int)me->query("sen") < 500 )
                return notify_fail("你的精力不够！\n");
        
          if( (int)me->query("force") < 1500 )
                return notify_fail("你的真气不够！\n");

        if( (int)me->query_skill("snowsword",1) < 120 )
                return notify_fail("你的风回雪舞剑法等级不够.\n");
        
         if( (int)me->query_skill("moondance",1) < 120 )
                return notify_fail("你的冷月凝香舞等级不够.\n");
       
        if( !target->is_fighting(me) )
              {
                if( living(target) )
                     {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                        }
                 }

if (!wizardp(me))
me->set_temp("no_luoye",1);
me->delete_temp("luoye_rumor_show",1);
call_out("luoye_ready",25+random(5),me);

damage = ((int)me->query_skill("snowsword", 1)+(int)me->query_skill("parry", 1)+(int)me->query_skill("sword", 1)-(int)target->query_skill("parry",1));
if (damage>1500) damage=1500;

   if (tpcps*10<tpcor)
    {
     if ((int)me->query("force") < 2500) return notify_fail("就凭你的内力也想[飞花]伤人?\n");
        waittime=1;
         target->start_busy(waittime);
         me->start_busy(waittime);
         if (target->query("kee")<0) return notify_fail ("对方已经无力还手,何必再用[飞花]?");
         call_out("fh1",waittime,me,target,damage);
                if (tpstr>30)
                {
                        waittime+=1;
                        me->start_busy(waittime);
                         
                         call_out("fh2",waittime,me,target,damage);
                         if (ysper<26)
                       {
                                waittime+=1;
                               me->start_busy(waittime);
                            damage=damage+random(100);
                                call_out("fh3",waittime,me,target,damage,waittime);
                            me->start_busy(1+random(3));
                                return 1;
                             }
                         else
                             {
                               waittime+=1;
                                me->start_busy(waittime);
                                call_out("fh13",waittime,me,target,waittime);
                                me->start_busy(random(3));
                                return 1;
                              }
                 }
                else
                   {
                        waittime+=1;
                        me->start_busy(waittime);
                        call_out("fh4",waittime,me,target,damage);
                        if ( random(tpper)>25 && ysper>=30 )
                            {
                                   waittime+=1;
                                  me->start_busy(waittime);
                                  call_out("fh14",waittime,me,target,waittime);
                                  me->start_busy(random(3));
                                   return 1;
                            }
                     else
                            {
                                   waittime+=1;
                                  me->start_busy(waittime);             
                                   call_out("fh15",waittime,me,target,waittime);
                                   me->start_busy(random(3));
                                   return 1;
                            }
                }
        }
    else

        {   
               waittime=1;
               me->start_busy(waittime+5);
                call_out("fh6",waittime,me,target,damage);
          if (wizardp(me) && me->query("env/combat")=="verbose") tell_object(me, sprintf(HIM+BLINK+"随机根骨: %d，先天根骨：%d\n" NOR, random(tpcon),yscon));
          if (random(tpcon)>yscon+10)
              {
                        waittime+=1;
                        me->start_busy(waittime);
                        call_out("wait_time",waittime-1);
                        call_out("fh7",waittime,me,target,damage);
                if ( random(tpper)>25 && ysper>=30 )
                   {
                        waittime+=1;
                        me->start_busy(waittime);
                        call_out("fh8",waittime,me,target,waittime);
                        return 1;   
                     }
                else
                     {
                        waittime+=1;
                        me->start_busy(waittime);
                        attack_amount=me->query_skill("parry")*random(6)/20;
                        me->add_temp("apply/attack", -attack_amount);
                        call_out("fh16",waittime,me,target,waittime);
                        removetime=yscps/2;
                        if (removetime<10) removetime=10;
                        me->start_call_out( (: call_other, __FILE__, "remove_fh16", me, attack_amount :),removetime*2);
                        return 1;
                      }
                }
          else
                 {
                        waittime+=1;
                        me->start_busy(waittime);
                        call_out("wait_time",waittime-1);
                        call_out("fh9",waittime,me,target,damage);
                     if ( random(tpspi)>(ysspi+6) ||me->query_skill("snowsword")<200 )
                         {
                                waittime+=1;
                               me->start_busy(waittime);
                               call_out("fh17",waittime,me,target,waittime);
                                return 1;
                            }
                        else
                            {
                               waittime+=1;
                               me->start_busy(waittime+1);
                            damage=damage+random(100);
                                call_out("fh10",waittime,me,target,damage);
                        if ( random(40)>(ysint+5) || (int)me->query_skill("snowsword",1)<300 )
                                    {
                                        waittime+=1;
                                      me->start_busy(waittime);
                                        call_out("fh18",waittime,me,target,waittime);
                                        return 1;
                                }
                             else
                                    {
                                      waittime+=1;
                                      me->start_busy(waittime);
                                        damage=damage+random(100);
                                        call_out("fh11",waittime,me,target,damage);
                                  k=random(tpkar);
                               if ( k < yskar*3/4 )
                                     {
                                              waittime+=1;
                                            me->start_busy(waittime);
                                              call_out("fh19",waittime,me,target,waittime);
                                              return 1;
                                     }
                                   else
                                           {            
                                              waittime+=1;
                                            me->start_busy(waittime);
                                            call_out("fh12",waittime,me,target,waittime);
                                          }
                                     }  
                              }      
                }
        return 1;
   }
}

int fh1(object me,object target,int damage)
{
       string weapon=me->query_temp("weapon");
       string str;
        if (!me||!target)
        {
         call_out("remove_fh",1,me);
         remove_call_out("fh1");
         return 1;
        }
        message_vision(HIR"\n$N杀气涌出再也控制不住，双眼充血，竟然使出了与月宫绝招"+HIY"[落叶]"+HIR"完全不同的招数---禁招"+HIY"[飞花]\n"NOR,me,target);
        message_vision(HIR"\n$N发狂了似的朝$n直扑了过来，手中的"+NOR+weapon->query("name")+HIR"被汹涌的杀气逼得弯成了半弧形!!!"NOR,me,target);
        message_vision(HIW"\n\n\n     江天一色无纤尘，皎皎空中弧月轮\n"NOR,me,target);
       message_vision(HIR"\n\n\n待到$n发觉时全身已被$N发出的杀气吓的全身酸软，$N手中的"+NOR+weapon->query("name")+HIR"已然插进$n的肋下！\n"NOR,me,target);
        
        //if (damage<(me->query_skill("snowsword",1))) damage=(me->query_skill("snowsword",1)/3);
       damage=damage+random(damage/2);
        target->receive_damage("kee", damage);
       if (wizardp(me) && me->query("env/combat")=="verbose") tell_object(me, sprintf(HIM+BLINK+"damage: %d\n" NOR, damage));
        COMBAT_D->report_status(target);
       if (target->query("eff_kee")<0 || (!living(target) && target->query("kee")<0))
            {  
               str=me->name()+HIM+"竟然使出了月宫禁招"+HIR+"「飞花」"+HIM+"屠手式"+HIY+"「江天一色无纤尘」"+HIM+"，"+target->query("name")+HIM+"被强大杀气斩于当场！"NOR;
               me->set_temp("luoye_die",1);
               me->set_temp("luoye_rumor",str);
               me->set_temp("luoye_rumor_show",1);
               message("channel:rumor",HIM"【空穴来风】某人："+str+"\n"NOR,users());
            }
        me->add("force",-(300+random(100)));
        return 1;
}

int fh2(object me,object target,int damage)
{ 
        int j,k=random(100);
        string i;
       string str;
        if (!me||!target)
        {
         call_out("remove_fh",1,me);
         remove_call_out("fh2");
         return 1;
        }
        j=random(4);
        if (j==0) i=HIY"四剑"NOR;
        else if (j==1) i=HIY"三剑"NOR;
        else if (j==2) i=HIY"两剑"NOR;
       else i=HIY"两剑"NOR; 
        j=random(200*j);        
       message_vision(HIR"\n\n$N嘿嘿一声嘶哑的冷笑，$n早已毛骨悚然，只见眼前寒光连闪，四肢一阵剧痛，竟然是一瞬间被$N连砍了"+i+NOR,me,target);
        message_vision("\n",me,target);
       damage=damage*3+random(damage*2);
       if (k>98) damage=damage/3;
        target->receive_damage("kee", damage+j);
       if (wizardp(me) && me->query("env/combat")=="verbose") tell_object(me, sprintf(HIM+BLINK+"damage: %d\n" NOR, damage));
       COMBAT_D->report_status(target);
       if (target->query("eff_kee")<0 || (!living(target) && target->query("kee")<0))
            {  
               str=me->name()+HIM+"竟然使出了月宫禁招"+HIR+"「飞花」"+HIM+"寒光式"+HIY+"「皎皎空中弧月轮」"+HIM+"，"+target->query("name")+HIM+"被一片飞花穿胸而过，暴毕当场！"NOR;
               me->set_temp("luoye_die",2);
               me->set_temp("luoye_rumor",str);
               if ( !me->query_temp("luoye_rumor_show") )
               {
                message("channel:rumor",HIM"【空穴来风】某人："+str+"\n"NOR,users());
                me->set_temp("luoye_rumor_show",1);
               }

            }
       me->add("force",-(300+random(100+j*2)));
        return 1;
}

int fh3(object me,object target,int damage,int waittime)
{ 
       string weapon=me->query_temp("weapon");
       string str;
        int k=random(100);
       damage=damage*3+random(damage/2);
       if (k>98) damage=damage/3;
        if (!me||!target)
        {
         call_out("remove_fh",1,me);
         remove_call_out("fh3");
         return 1;
        }
       message_vision(HIR"\n\n终于"+HIY"[飞花]"+NOR""+HIR"落尽，$n那流淌满地的鲜血也不能阻止$N的最后一击，"+NOR+weapon->query("name")+HIR"穿胸而过....\n"NOR,me,target);
       target->receive_wound("kee",damage*2/3);
       target->receive_damage("kee",damage);
       if (wizardp(me) && me->query("env/combat")=="verbose") tell_object(me, sprintf(HIM+BLINK+"damage: %d\n" NOR, damage));
       COMBAT_D->report_status(target);
        if (target->query("eff_kee")<0 || (!living(target) && target->query("kee")<0))
            {  
               str=me->name()+HIM+"竟然使出了月宫禁招"+HIR+"「飞花」"+HIM+"无空式"+HIY+"「飞花漫天」"+HIM+"，"+target->query("name")+HIM+"被强大剑气穿胸而过，暴毕当场！"NOR;
               me->set_temp("luoye_die",3);
               me->set_temp("luoye_rumor",str);
               if ( !me->query_temp("luoye_rumor_show") )
               {
                message("channel:rumor",HIM"【空穴来风】某人："+str+"\n"NOR,users());
                me->set_temp("luoye_rumor_show",1);
               }

            }
       message_vision(HIR"\n$n已经深受重伤，$N也因为汹涌澎湃的杀气发泄不出重伤力尽.\n"NOR,me,target);
       message_vision(HIC"\n不多时，只见一股瘴气从$N的伤口中缓缓散开去。\n"NOR,me,target);
       me->add("bellicosity",random(100));
       me->receive_wound("kee",damage/4);
       me->add("force",-(300+random(200)));
       me->start_busy(waittime+random(2));
       target->start_busy(0);
       return 1;
}

int fh4(object me,object target,int damage)
{  
       string str;
        int k=random(100);
        if (!me||!target)
        {
         call_out("remove_fh",1,me);
         remove_call_out("fh4");
         return 1;
        }
      me->add_temp("apply/attack",200);
      me->add_temp("apply/damage",20);
      damage=damage*3+random(damage);
       if (k>98) damage=damage/3;
      message_vision(HIR"\n$N由于全力出击后大耗体力，出招也逐渐缓了，拚着最后一点力气，$N竟还能又攻出暴雨般的的"+HIY"[飞花]"+NOR""+HIR"绝招。\n"NOR,me,target);
      target->receive_wound("kee",damage);
      target->receive_damage("kee",damage);
      if (wizardp(me) && me->query("env/combat")=="verbose") tell_object(me, sprintf(HIM+BLINK+"damage: %d\n" NOR, damage));
      COMBAT_D->do_attack(me,target,me->query_temp("weapon"));
      COMBAT_D->do_attack(me,target,me->query_temp("weapon"));
      COMBAT_D->do_attack(me,target,me->query_temp("weapon"));
      if (target->query("eff_kee")<0 || (!living(target) && target->query("kee")<0))
            {  
               str=me->name()+HIM+"竟然使出了月宫禁招"+HIR+"「飞花」"+HIM+"同归式"+HIY+"「飞花绝代艳九州」"+HIM+"，"+target->query("name")+HIM+"被强大剑气穿胸而过，暴毕当场！"NOR;
               me->set_temp("luoye_die",4);
               me->set_temp("luoye_rumor",str);
               if ( !me->query_temp("luoye_rumor_show") )
               {
                message("channel:rumor",HIM"【空穴来风】某人："+str+"\n"NOR,users());
                me->set_temp("luoye_rumor_show",1);
               }

            }
      me->add("force",-(300+random(200)));
      me->add_temp("apply/attack",-200);
      me->add_temp("apply/damage",-20);
      me->start_busy(5);
      target->start_busy(0);
      return 1;
}


int fh6(object me,object target,int damage)
{
       string weapon=me->query_temp("weapon");
       string str;
        if (!me||!target)
        {
         call_out("remove_fh",1,me);
         remove_call_out("fh6");
         return 1;
        }
        message_vision(HIC"\n                  $N使出月宫不传之密"+HIY"[落叶]"+NOR""+HIC"，身行顿时有如\n\n"NOR,me,target);
        message_vision(HIW"                           飘忽若风回，轻灵似雪舞 \n"NOR,me,target);
        message_vision(HIW"                           芙蓉羞闭月, 落叶舞飞花\n\n" NOR,me,target);
       message_vision(HIC"    刹那间方圆三尺之内剑气纵横，片片"+HIY"[落叶]"+NOR""+HIC"漫天飞舞，竟好似长了翅膀一样，向$n飞来！\n\n\n" NOR,me,target);
       damage=damage+random(damage/2);
       target->receive_damage("kee",damage);    
       if (wizardp(me) && me->query("env/combat")=="verbose") tell_object(me, sprintf(HIM+BLINK+"damage: %d\n" NOR, damage));
       COMBAT_D->report_status(target);
       if (target->query("eff_kee")<0 || (!living(target) && target->query("kee")<0))
           {  
            str =HIM+me->name()+HIM+"使出了月宫秘传"+HIG+"「落叶」"+HIM+"起剑式"+HIY+"「落叶舞飞花」"+HIM+"将"+target->query("name")+HIM+"送去了鬼门关！"NOR;
            me->set_temp("luoye_die",6);
            me->set_temp("luoye_rumor",str);
            me->set_temp("luoye_rumor_show",1);
            message("channel:rumor",HIM"【空穴来风】某人："+str+"\n"NOR,users());
           }
       me->add("force",-(100+random(100)));
       return 1;
}

int fh7(object me,object target,int damage)
{
       string weapon=me->query_temp("weapon");
       string str;
        if (!me||!target)
        {
         call_out("remove_fh",1,me);
         remove_call_out("fh7");
         return 1;
        }
        message_vision(CYN"\n\n\n风吹仙诀飘飘举，犹似霓裳羽衣舞，深秋月清空。不知乘月几人归，"+HIY"[落叶]"+NOR""+CYN"摇清满江树，清泉石上流。\n"NOR,me,target);
        message_vision(CYN"$N临风舞剑，招式虽柔，却暗藏杀机。剑气突然间呼啸暴起，飞沙走石，气势惊人。$n哪里分得"+NOR""+"\n"NOR,me,target);
       message_vision(CYN"清什么是人影，什么是"+HIY"[落叶]\n\n\n"NOR,me,target);
       damage=damage+random(damage);
        target->receive_damage("kee",damage);    
       if (wizardp(me) && me->query("env/combat")=="verbose") tell_object(me, sprintf(HIM+BLINK+"damage: %d\n" NOR, damage));
       COMBAT_D->report_status(target);
       if (target->query("eff_kee")<0 || (!living(target) && target->query("kee")<0))
           {  
            str =HIM+me->name()+HIM+"使出了月宫秘传"+HIG+"「落叶」"+HIM+"落剑式"+HIY+"「深秋月清空」"+HIM+"，"+target->query("name")+HIM+"身中数剑，尸体上伤痕累累！"NOR;
            me->set_temp("luoye_die",7);
            me->set_temp("luoye_rumor",str);
            if ( !me->query_temp("luoye_rumor_show") )
            {
              message("channel:rumor",HIM"【空穴来风】某人："+str+"\n"NOR,users());
              me->set_temp("luoye_rumor_show",1);
             }
           }
       me->add("force",-(100+random(100)));
       return 1;
}

int fh8(object me,object target,int waittime)
{
       string weapon=me->query_temp("weapon");
       string str;
       int damage;
        if (!me||!target)
        {
         call_out("remove_fh",1,me);
         remove_call_out("fh8");
         return 1;
        }
      damage = (((int)me->query_skill("snowsword", 1))*2+(int)me->query_skill("sword", 1)-(int)target->query_skill("parry",1));
      if (damage>1500) damage=1500;
      damage=damage*2+random(damage);
      message_vision(HIW"\n\n\n                       疏星淡月，断云微渡，表里俱澄清。\n"NOR,me,target);
      message_vision(HIY"\n\n[落叶]"+NOR""+CYN"舞的正急，$n不知不觉看得痴了，"+HIY"[落叶]"+NOR""+CYN"怎会容情？"+CYN"$N悠悠道：$n接我"+HIY"[落叶]\n"NOR,me,target);
      message_vision(CYN"最后一招。$N话音未落，手中"+NOR""+weapon->query("name")+CYN"腾空而起，化作万道寒光射向$n。\n\n\n\n\n"NOR,me,target);
      target->receive_damage("kee",damage);    
      if (wizardp(me) && me->query("env/combat")=="verbose") tell_object(me, sprintf(HIM+BLINK+"damage: %d\n" NOR, damage));
       COMBAT_D->report_status(target);
       if (target->query("eff_kee")<0 || (!living(target) && target->query("kee")<0))
           {  
            str =HIM+me->name()+HIM+"使出了月宫秘传"+HIG+"「落叶」"+HIM+"迷剑式"+HIY+"「疏星淡月」"+HIM+"，据说"+target->query("name")+HIM+"到死还痴痴看着"+me->name()+"的舞影！"NOR;
            me->set_temp("luoye_die",8);
            me->set_temp("luoye_rumor",str);
            if ( !me->query_temp("luoye_rumor_show") )
            {
              message("channel:rumor",HIM"【空穴来风】某人："+str+"\n"NOR,users());
              me->set_temp("luoye_rumor_show",1);
             }
           }
      me->add("force",-(100+random(100)));
      me->start_busy(waittime+random(2));
      target->start_busy(0);
      return 1;
}

int fh9(object me,object target,int damage)
{
       string weapon=me->query_temp("weapon");
       string str;
        if (!me||!target)
        {
         call_out("remove_fh",1,me);
         remove_call_out("fh9");
         return 1;
        }
        message_vision(HIW"\n                       香雾云鬓湿,清辉玉臂寒\n"NOR,me,target);
       message_vision(HIC"\n$N步履凌波，剑随人影动，丰肌清骨，容态尽天真。手中"+NOR""+weapon->query("name")+HIC"连动数下，$n已然中剑。\n\n\n\n\n"NOR,me,target);
       damage=damage+random(damage/2);
        target->receive_damage("kee",damage);    
       if (wizardp(me) && me->query("env/combat")=="verbose") tell_object(me, sprintf(HIM+BLINK+"damage: %d\n" NOR, damage));
       COMBAT_D->report_status(target);
       if (target->query("eff_kee")<0 || (!living(target) && target->query("kee")<0))
           {  
            str =HIM+me->name()+HIM+"使出了月宫秘传"+HIG+"「落叶」"+HIM+"舞剑式"+HIY+"「香雾云鬓湿」"+HIM+"将"+target->query("name")+HIM+"送去崔叔叔那里喝茶去了！"NOR;
            me->set_temp("luoye_die",9);
            me->set_temp("luoye_rumor",str);
            if ( !me->query_temp("luoye_rumor_show") )
            {
              message("channel:rumor",HIM"【空穴来风】某人："+str+"\n"NOR,users());
              me->set_temp("luoye_rumor_show",1);
             }
          }
       me->add("force",-(100+random(100)));
       return 1;
}

