// thunder.c
#include <ansi.h>

inherit SSERVER;

int cast(object me, object target) {
  int success_adj, damage_adj;

  success_adj = 120;
  damage_adj = 150;

  if (me->query("family/family_name") != "南海普陀山")
    return notify_fail("你不能用「大势锤」！\n");

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展大势锤？\n");

  if ((int)me->query("mana") < 100 + 2 * (int)me->query("mana_factor"))
    return notify_fail("你的法力不够！\n");

  if ((int)me->query("sen") < 100)
    return notify_fail("你无法集中精力！\n");
  if ((int)me->query_skill("bighammer") < 60)
    return notify_fail("你的大势锤等级不够！\n");
  if ((int)me->query_skill("buddhism") < 60)
    return notify_fail("你的大乘佛法等级不够！\n");

  me->add("mana", -25 - 2 * (int)me->query("mana_factor"));
  me->receive_damage("sen", 50);

  if (random(me->query("max_mana")) < 50) {
    write("你的法力太差，召唤不了大势至菩萨！\n");

    return 1;
  }

  SPELL_D->attacking_cast(
    me,
    //attacker 
    target,
    //target
    success_adj,
    //success adjustment
    damage_adj,
    //damage adjustment
    "shen",
    //damage type: could be "qi"/"kee", "shen"/"sen", ...default "both"
    HIC "\n$N口中念了句咒文，半空走出位大势至菩萨，左手大势锤，右手掐无畏印。双目猛的一睁，大势锤已经落在了$n的头顶！\n" NOR,
    //initial message
    HIR "\n结果$n被大势锤砸得眼冒金星，心神不定，差点跌倒在地！\n" NOR,
    //success message
    HIC "\n谁知$n反应迅速，一下就跳开了。\n" NOR,
    //fail message
    HIC "但是大势锤被$n以法力一激，反而向$N的头顶砸来！\n" NOR,
    //backfire initial message
    HIC "结果$n被大势锤砸得眼冒金星，心神不定，差点跌倒在地！\n" NOR
    //backfire hit message. note here $N and $n!!!
  );

  me->start_busy(1);
  return 4;
}
