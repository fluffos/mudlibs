#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me, int amount);
void remove_affect(object me, int amount);

int cast(object me)
{
	int skill,armor,spell;
	me=this_player();


	if( (int)me->query_skill("buddhism", 1) < 60 )
		return notify_fail("你的大乘佛法等级不够。\n");
	if(me->query("family/family_name")!="南海普陀山")
                return notify_fail("不是佛门弟子不能用「莲花护体」！\n");
        if( (int)me->query("mana") < 300 )     
                return notify_fail("你的法力不够。\n");
	if( (int)me->query("kee") < 300 )
		return notify_fail("你的气血不足。\n");
	if( (int)me->query("sen") < 300 )
		return notify_fail("你的精神不足。\n");
        if( (int)me->query_temp("putuo_blianhua") ) 
                return notify_fail("你已经在运功中了。\n");
        if( (int)me->query_temp("putuo_qlianhua") ) 
                return notify_fail("你已经在运功中了。\n");

        skill = (int)me->query_skill("spells",1)/2 + (int)me->query_skill("buddhism",1);
        armor = me->query_temp("apply/armor_vs_spells");
        armor = armor*20/100;
        if (armor<50) armor = 50;
        spell = skill;
        spell = spell*20/100;
        if (spell<50) spell = 50;       
        me->add("mana", -100);
        me->receive_damage("kee", 30);
	me->receive_damage("sen", 30);

        message_vision(
                HIC"$N微一凝神，背后幻出一朵青白双色莲，青白二光轮番闪现。\n" NOR, me);
       
       me->add_temp("apply/armor_vs_spells", armor);
       me->add_temp("apply/spells", spell);
        me->set_temp("putuo_blianhua", 1);
        me->set_temp("putuo_qlianhua", 1);

        me->start_call_out( (: call_other, __FILE__, "remove_effect", me, armor:), skill);
        me->start_call_out( (: call_other, __FILE__, "remove_affect", me, spell:), skill);

        if( me->is_fighting() ) me->start_busy(3);

        return 1;
}

void remove_effect(object me, int amount)
{
        me->add_temp("apply/armor_vs_spells", - amount);
        me->delete_temp("putuo_blianhua");
        tell_object(me, HIW"你身后的白芒渐渐隐去。\n"NOR);
	return;
}

void remove_affect(object me, int amount)
{
        me->add_temp("apply/spells", - amount);
        me->delete_temp("putuo_qlianhua");
        tell_object(me, HIC"你身后的青芒渐渐隐去。\n"NOR);
	return;
}

