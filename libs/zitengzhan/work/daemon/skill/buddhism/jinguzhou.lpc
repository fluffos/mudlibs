// jinguzhou.c
#include <ansi.h>

inherit SSERVER;

int cast(object me, object target) {
  string msg, name;
  int damage, ap, dp, howlong = 0, mz;
  object ob;

  if (!target) target = offensive_target(me);

  if (!(ob = present("jingu zhou", me)))
    return notify_fail("你身上没有紧箍咒、金箍咒或禁箍咒，无法施用咒语！\n");
  name = "“" + ob->query("name") + "”";

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁念" + name + "？\n");
  if (me->query("family/family_name") != "南海普陀山")
    return notify_fail("不是佛门弟子不能用「金箍咒」！\n");

  if ((int)me->query_skill("spells", 1) < 100)
    return notify_fail("你还没学会念" + name + "。\n");

  if ((int)me->query("mana") < 25 + (int)me->query("mana_factor"))
    return notify_fail("你的法力不够！\n");

  if ((int)me->query("sen") < 10)
    return notify_fail("你无法集中精力，别施用到自己头上！\n");

  me->add("mana", -25 - (int)me->query("mana_factor"));
  me->receive_damage("sen", 10);

  if (random(me->query("max_mana")) < 50) {
    write("你失败了！\n");
    return 1;
  }

  msg = HIC
    "$N默默地将那" + name + "念了几遍。\n" NOR;

  ap = (int)me->query("daoxing") / 100;
  dp = target->query("daoxing") / 100;
  ap += dp;
  if (random(ap) > dp) {
    damage = (int)me->query("max_mana") / 5 +  //old is 10    huarong 2003.10
    random((int)me->query("eff_sen") / 5);
    damage -= (int)target->query("max_mana") / 10 + random((int)target->query("eff_sen") / 5);
    damage += (int)me->query("mana_factor") - random((int)target->query("mana_factor"));
    //here we can see if 2 players are at same status, the attacker has higher chance.
    if (damage > 0) {
      msg += HIC "刷的一下" + name + "" HIC "从$N手中飞出，套在了$n的头上，$n立刻耳红面赤，眼胀身麻，动弹不得！\n" NOR;
      //finally damage also depends on enabled spells level.
      damage += random((damage * (int)me->query_skill("spells")) / 80);
      if (name != "“紧箍咒”") damage /= 2;
      target->set_temp("no_move", 1);
      target->start_busy(1 + random(2));
      howlong = 10 + random((me->query_skill("spells") / 100));
      if (howlong > 20) howlong = 20;
      if (name != "“紧箍咒”") howlong /= 2;
      //a typical level is 100+100 ->enabled 150, so will "ding" about 1 minute in the best case.

    } else msg += "但是什么也没发生。\n";
  } else
    msg += "但是什么也没发生。\n";

  message_vision(msg, me, target);

  if (damage > 0) {
    call_out("free", howlong, target);
    ob->add("jingu", -1);
    msg = HIG "$N手中的" + name + "" HIG "华光一闪，似乎多了条裂纹！\n" NOR;
    if (ob->query("jingu") < 1) {
      destruct(ob);
      msg = HIR "$N手中的" + name + "" HIG "华光闪现，化为片片碎片掉落在地！\n" NOR;
    }
    message_vision(msg, me, target);
  }

  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else
        target->kill_ob(me);
    }
    me->fight_ob(target);
  }

  me->start_busy(1);
  return 3 + random(5);
}

void free(object target) {
  if (target) target->delete_temp("no_move");
  return;
}
