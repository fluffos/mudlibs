/*
雁歌刀法    dodge  -10    parry  0    damage  20
雁歌刀法刀势奔放，为豪侠悲歌之士所喜。此刀法以气势
逼人，而不在乎能否杀伤杀死敌手。
*/
#include <ansi.h>
#include <combat.h>
inherit SKILL;

//huarong 2003/12

