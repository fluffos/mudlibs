// tie@fengyun
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string dodskill, msg;
  int extra;
  object weapon;
  extra = me->query_skill("tianmo-qin", 1);
  if (extra < 90) return notify_fail("你的［天魔琴］还不够纯熟！\n");
  dodskill = (string)me->query_skill_mapped("dodge");
  if (dodskill != "tianmostep")
    return notify_fail("［魔音九响］需要天魔步的配和！\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［魔音九响］只能对战斗中的对手使用。\n");
  weapon = me->query_temp("weapon");
  msg = HIY "$N身上魔气纵横，一声怒吼之后将天魔琴的魔音九响发动起来！\n魔音一响！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIY "魔音二响！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIY "魔音三响！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIY "魔音四响！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIY "魔音五响！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIY "魔音六响！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIY "魔音七响！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIY "魔音八响！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIY "魔音九响！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  me->start_busy(9);
  return 1;
}
