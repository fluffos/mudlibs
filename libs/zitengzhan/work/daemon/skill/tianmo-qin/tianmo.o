//主要流程，1 打掉对方有益状态 [jldl,zxzx,ldl,zhenshen,ba......]
//2 使对方在一定时间内，无法 perform,exert,cast
//3 设定对方no_move
//4 减掉对方的攻防
//5 每秒钟判断一次，随机去除对方的装备
#include <ansi.h>
inherit SSERVER;
int perform(object me, object target)
{
        object weapon;
        int j,skill,i,k,extra,howlong;
        string msg,str;

      //  if(me->query("family/family_name")!="天魔宫")
if (!PFM_D->valid_family(me, "天魔宫"))
			return notify_fail("你不是天魔宫弟子，怎么能使用天魔宫绝技？\n");

	 if( !target ) target = offensive_target(me);

        if( !target

        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("「天魔结界」只能在战斗中使用。\n");

        if ( (int)me->query_skill("tianmo-qin", 1) < 180 )
                return notify_fail("你的「千钧棒」不够娴熟，不会使用「盘龙八式」。\n");
		if (!me->query("jm_tmjj"))
		{
			return notify_fail("你还没有掌握「天魔结界」 。\n");
		}
        if(time()-me->query_temp("pfmtmjj_end")<20) return notify_fail("还是先休息一下吧！\n");
		if (me->query_temp("pfmtmjj"))
		{
			return notify_fail("不要连续使用绝招 。\n");
		}
		 me->set_temp("pfmtmjj",1);   
        skill=(int)me->query_skill("tianmo-qin",1)+(int)me->query_skill("qin",1);
		message_vision(HIC"$N"+HIC+"琴声渐渐低落，$n"+HIC+"神志似乎也随着琴声而渐渐迷惘,猛然间才发觉已经在$N"+HIC+"的「天魔结界」中！\n\n\n"NOR,me,target);
		////////////////////
		//这里要加上成功率的判断,tianmo-qin+灵性+悟性+内功+法术+exp+daoxing 和对方的 spells+force+exp+daoxing+灵性+悟性
		//////////////////////
		if (target->query_temp("jldl"))
            {
                target->delete_temp("jldl");
                target->set_temp("jldl_end", time() );                
           }
		 if (target->query_temp("zxzx"))
            {
                target->delete_temp("zxzx");
                target->set_temp("zxzx_end", time() );                
           }
		 if (target->query_temp("ldlh"))
            {
                target->delete_temp("ldlh");
				target->delete_temp("lunhui");
                target->set_temp("ldlh_end", time() );    
           } 
		 if (target->query_temp("bawang"))
            {
                target->delete_temp("bawang");
				target->set_temp("bawang_time",0);
                target->set_temp("bawang_end", time() );    
           }  
		  if (target->query_temp("pfmxue"))
            {
                target->delete_temp("pfmxue");
				target->set_temp("pfmxue_time",0);
                target->set_temp("pfmxue_end", time() );    
           }  
		   message_vision(HIC+"$n"+HIC+"似乎感觉到自己的体内遗失了什么，只觉得自己状态正在慢慢变差！\n\n\n"NOR,me,target);
		   target->delete_temp("anti_magic"); //cast lianhua
		   extra=skill/5;
		   if (extra>100) extra=100;
		   if (extra<10) extra=10;	
		   howlong=extra/10;
		   if (howlong<3) howlong=3;			
		   me->add_temp("apply/attack",extra);
		   call_out("remove_tmjj",howlong,me,extra);
        return 1;
}
	int remove_tmjj(object me,int extra)
{
      if(!me) return 1;
      me->add_temp("apply/attack",-extra);
      me->delete_temp("pfmtmjj");
	  me->set_temp("pfmtmjj_end",time());
      message_vision(HIW"$N"+HIW+"的[天魔结界]正悄悄消散！\n"NOR,me);
      return 1; 
}

