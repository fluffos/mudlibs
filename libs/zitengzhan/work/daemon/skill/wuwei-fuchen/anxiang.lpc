//create by huarong 2003/12
#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  int damage, skill, i;
  int myexp, youexp, ratio;
  object weapon = me->query_temp("weapon");


  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail(HIR + "「暗香浮动」" + NOR + "只能对战斗中的对手使用。\n");
  if (!wizardp(me) && me->query("family/family_name") != "三界散仙")
    return notify_fail(HIR + "「暗香浮动」" + NOR + "只有三界散仙门人才可以用！\n");

  if ((int)me->query("force") < 2000)
    return notify_fail("你的内力不够了!\n");

  if ((int)me->query_skill("whip", 1) < 250
    || me->query_skill_mapped("whip") != "wuwei-fuchen")
    return notify_fail("你的「基本鞭术」还不到家，无法使用" + HIR + "「暗香浮动」" + NOR + "！\n");

  if ((int)me->query_skill("spysword", 1) < 250)
    return notify_fail("你的「刺客剑法」还不到家，无法使用" + HIR + "「暗香浮动」" + NOR + "！\n");

  if ((int)me->query_skill("ice_fire_zhang", 1) < 250)
    return notify_fail("你的「玄冰烈焰掌」还不到家，无法使用" + HIR + "「暗香浮动」" + NOR + "！\n");

  if ((int)me->query_skill("wuwei-fuchen", 1) < 250)
    return notify_fail("你的「无为拂尘」等级不够，无法推动" + HIR + "「暗香浮动」" + NOR + "！\n");

  if ((int)me->query_skill("butian-force", 1) < 250)
    return notify_fail("你的「补天心法」还不到家，无法自由控制剑进行" + HIR + "「暗香浮动」" + NOR + "！\n");

  if (time() - (int)me->query_temp("anxiang_end") < 8)
    return notify_fail("此乃三界散仙之精髓所在，用多了就烂了！\n");

  myexp = (int)me->query("combat_exp", 1);
  youexp = (int)target->query("combat_exp", 1);
  ratio = (myexp / 10) / (youexp / 1000);
  if (ratio > 200) ratio = 200;
  if (ratio < 20) ratio = 20;

  skill = (int)me->query_skill(
    "sword",
    1
  ) + (int)me->query_skill("whip", 1) + (int)me->query_skill("unarmed", 1);
  target->add_temp("apply/dodge", -skill / 2);
  target->add_temp("apply/parry", -skill / 2);
  me->delete("env/brief_message");
  target->delete("env/brief_message");
  weapon->set_temp("original/use_apply_skill", weapon->query("use_apply_skill"));
  weapon->set_temp("original/skill_type", weapon->query("apply/skill_type"));
  message_vision(
    HIW "\n$N" + HIW + "双臂一震，" + weapon->query("name") + HIW + "“嘶嘶”作响，银光闪烁，使得风雨不透！\n" NOR,
    me,
    target
  );
  me->set_temp("fuchen_pfm", 5);
  COMBAT_D->do_attack(me, target, weapon);
  me->set_temp("fuchen_pfm", 6);
  COMBAT_D->do_attack(me, target, weapon);
  me->delete_temp("fuchen_pfm");
  message_vision(HIC "\n激战中$N" + HIC + "飞身前扑，左手虚空一绕，幻起一片掌影！\n" NOR, me, target);
  me->set("actions", (: call_other, SKILL_D("ice_fire_zhang"), "query_action" :));
  weapon->set("use_apply_skill", 1);
  weapon->set("apply/skill_type", "unarmed");
  COMBAT_D->do_attack(me, target);
  message_vision(
    HIW "\n右手" + weapon->query("name") + HIW + "迎空一挥，“嗖”的一声扫向$n" + HIW + "的面门！\n" NOR,
    me,
    target
  );
  me->set("actions", (: call_other, SKILL_D("spysword"), "query_action" :));
  weapon->set("use_apply_skill", 1);
  weapon->set("apply/skill_type", "sword");
  COMBAT_D->do_attack(me, target, weapon);
  message_vision(
    HIR "\n接着$N" + HIR + "招式一变，" + weapon->query("name") + HIR + "涌流而出，突而一圈一卷，再出屈而直，锐如利剑，劲袭而至！\n" NOR,
    me,
    target
  );
  message_vision(HIR "\n正是刺客剑法精髓\n\n\n" NOR, me, target);
  message_vision(
    HIB "            〓" + HIY + BLINK + "图穷匕首现" + NOR + HIB + "〓\n\n\n" NOR,
    me,
    target
  );
  message_vision(HIR "\n此招用鞭法使将出来，却是柔中带刚，威力更胜宝剑！\n" NOR, me, target);
  i = random(myexp + youexp);
  if (i > youexp * 3 / 4) {
    message_vision(
      HIR "$n" + HIR + "闪避不及，被" + weapon->query("name") + HIR + "击中，口中鲜血狂喷而出！\n" NOR,
      me,
      target
    );
    damage = random(skill / 2) + skill / 2;
    damage = damage * ratio / 100;
    target->receive_wound("kee", random(damage / 2), me);
    target->receive_damage("kee", damage, me);
    if (wizardp(me) && me->query("env/combat") == "verbose")
      tell_object(me, sprintf(HIM + BLINK + "damage: %d\n" NOR, damage));
    COMBAT_D->report_status(target);
  } else if (i > youexp / 2) {
    message_vision(
      HIG "$N" + HIG + "识得那鞭中加剑的厉害，往旁闪开，但却仍被" + weapon->query("name") + HIG + "划伤！\n" NOR,
      target
    );
    damage = random(skill / 4) + skill / 4;
    damage = damage * ratio / 100;
    target->receive_wound("kee", random(damage / 2), me);
    target->receive_damage("kee", damage, me);
    if (wizardp(me) && me->query("env/combat") == "verbose")
      tell_object(me, sprintf(HIM + BLINK + "damage: %d\n" NOR, damage));
    COMBAT_D->report_status(target);
  } else message_vision(HIY "$N" + HIY + "识得那鞭中加剑的厉害，闪在一旁。\n" NOR, target);

  me->set("actions", (: call_other, SKILL_D("wuwei-fuchen"), "query_action" :));
  weapon->set("apply/skill_type", "whip");
  weapon->set("use_apply_skill", weapon->query_temp("original/use_apply_skill"));
  weapon->set("apply/skill_type", weapon->query_temp("original/skill_type"));
  me->reset_action();
  target->add_temp("apply/dodge", skill / 2);
  target->add_temp("apply/parry", skill / 2);
  me->start_busy(1 + random(1));
  weapon->set("use_apply_skill", 0);
  me->set_temp("anxiang_end", time());
  return 1;
}
