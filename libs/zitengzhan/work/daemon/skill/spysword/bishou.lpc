//modify for 大唐西游2 by huarong 2003/12
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int extra, i, dlkm, temp_extra, myexp, youexp;
  object weapon;
  if ((string)me->query("family/family_name") != "三界散仙" && !wizardp(me))
    return notify_fail("你的刺客剑法不是亲传，不能使出[图穷匕现]！\n");
  extra = (int)me->query_skill("spysword", 1) / 2 + (int)me->query_skill("sword", 1) / 2;
  temp_extra = extra;
  if (me->query("force") < 1000
    || me->query("mana") < 1000
    || me->query("max_force") < 1200)
    return notify_fail("你的状态不好，无法使出[图穷匕现]。\n");
  if (extra < 120) return notify_fail("你的刺客剑法级别还不够，使用这一招还有一定难度！\n");
  if ((int)me->query_skill("sword", 1) < 120)
    return notify_fail("你的基本剑法还欠缺熟练，无法得心应手。\n");
  if ((int)me->query_skill("spysword", 1) < 120)
    return notify_fail("你的刺客剑法还欠缺熟练，无法得心应手。\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［图穷匕现］只能在战斗中使用。\n");
  if (time() - (int)me->query_temp("bishou_end") < 6)
    return notify_fail("刺客剑法不能用得这么频繁！\n");
  weapon = me->query_temp("weapon");
  myexp = me->query("combat_exp");
  youexp = target->query("combat_exp");

  msg = HIW "\n$N" + HIW + "突然收起手中" + weapon->name() + HIW "，悄无声息地走到$n" + HIW + "身边！\n" NOR;
  message_vision(msg, me, target);
  target->add_temp("apply/dodge", -temp_extra);
  target->add_temp("apply/parry", -temp_extra);
  dlkm = extra / 50;
  if (dlkm > 4) dlkm = 4;
  for (i = 0; i <= dlkm; i++) {
    msg = "";
    if (i == 0) msg = HIM "\n［刺客剑法］" + HIW + "-- 白虹贯日！" NOR;
    else if (i == 1) msg = HIM "\n［刺客剑法］" + HIY + "-- 彗星袭月！" NOR;
    else if (i == 2) msg = HIM "\n［刺客剑法］" + HIR + "-- 流血五步！" NOR;
    else if (i == 3) msg = HIM "\n［刺客剑法］" + HIG + "-- 天下缟素！" NOR;
    else {
      msg = HIM "\n［刺客剑法］" + HIW + "--禁招--" + HIB + " 图穷匕首现！" NOR;
      target->receive_wound("sen", extra, me);
      target->receive_wound("kee", extra, me);
      me->receive_heal("kee", extra);  // grin，补自己的气
    }
    message_vision(msg, me, target);
    if (random((int)me->query("combat_exp")) > (int)target->query("combat_exp") / 3) {
      msg = HIC "\n得手了！\n" NOR;
      switch (random(3)) {
        case 0: {
          msg += YEL "$n" + YEL + "躲闪不及，被" + weapon->name() + YEL "刺个正着！鲜血从胸口汩汩而出！\n" NOR;
          break;
        };

        case 1: {
          msg += MAG "眨眼间，$N" + MAG + "手中的" + weapon->name() + MAG "无声无息地刺中了$n" + MAG + "的腰部！\n" NOR;
          break;
        };

        case 2: {
          msg += HIM "$n" + HIM + "突然头部一阵剧痛，原来被$N" + HIM + "手上的" + weapon->name() + HIM "狠狠刺伤！\n" NOR;
          break;
        };
      }
      if (extra > 300) extra = 300;
      extra = extra * 2 / 3 + random(extra / 3);
      if (myexp > youexp * 5) extra = extra * 3;
      else if (myexp > youexp * 4) extra = extra * 5 / 2;
      else if (myexp > youexp * 3) extra = extra * 2;
      else if (myexp > youexp * 2) extra = extra * 3 / 2;
      else extra = extra;
      target->receive_damage("kee", extra, me);
      target->receive_wound("kee", extra / 2, me);
      message_vision(msg, me, target);
      if (wizardp(me) && me->query("env/combat") == "verbose")
        tell_object(me, sprintf(HIM + BLINK + "damage: %d\n" NOR, extra));
      COMBAT_D->report_status(target, 0);
    } else COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
    me->add("force", -100 - extra / 4);
    if (me->query("force") < 0)
      me->set("force", 0);
  }
  target->add_temp("apply/dodge", temp_extra);
  target->add_temp("apply/parry", temp_extra);
  me->set_temp("bishou_end", time());
  return 1;
}
