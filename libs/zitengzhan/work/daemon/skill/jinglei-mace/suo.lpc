#include <ansi.h>

inherit SSERVER;

int perform(object me)
{
        string msg;
        object weapon, weapon2, target;
        int skill, skill1, skill2, ap, dp, damage,mz;

        me->clean_up_enemy();
        target = me->select_opponent();

        skill = me->query_skill("lengquan-force",1);
        skill1 = me->query_skill("jinglei-mace",1);
        skill2 = me->query_skill("dodge",1);
        
        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "mace")
           return notify_fail("你没用锏，拿什么锁别人的兵器！\n");
            
        if(me->query("family/family_name") != "将军府" )
                return notify_fail("你是哪儿偷学来的武功，也想用「万刃归一」！\n");

        
        if( !(me->is_fighting() ))
            return notify_fail("「万刃归一」只能对战斗中的对手使用。\n");

        if( (int)me->query_skill("jinglei-mace", 1) < 100 )
                return notify_fail("你的惊雷鞭法不够娴熟，不能使用。\n");
                                
        if( (int)me->query_skill("lengquan-force", 1) < 80 )
                return notify_fail("你的冷泉心法还差些火候。\n");
        
        if (!objectp(weapon2 = target->query_temp("weapon")))
            return notify_fail("对方没有使用兵器，你用不了「万刃归一」。\n");

        if( me->query("force") < 500 )
                return notify_fail("你的内力不够，无法运用「万刃归一」！\n");

if( time()-(int)me->query_temp("suo_end") < 7 ) 
       return notify_fail("绝招用多就不灵了！\n"); 

        msg = HIC "$N"+HIC+"手中"+weapon->name()+HIC+"迎面一架，斜刺一拉，好一招「万刃归一」!\n$N"+HIC+"手中"+weapon->name()+HIC+"正好锁在$n"+HIC+"的"+weapon2->name()+HIC+"上。\n";
        message_vision(msg, me, target);
        
        damage = (int)me->query_skill("lengquan-force", 1);
        damage = damage +  (int)me->query_skill("jinglei-mace", 1);
        damage = damage +  (int)me->query_skill("mace", 1);
        damage += me->query_str();
        damage -= target->query_temp("apply/armor_vs_force");
        mz=me->query_temp("mingzhong");
        if(mz<0) mz=0;
        ap = me->query_skill("mace") / 4 + (skill1 / 3);
        dp = target->query_skill("dodge") / 2;
        if( dp < 1 )
            dp = 1;
        if( random(ap)+random(ap*mz/100) + me->query_str() > random(dp) + target->query_str() )
        {
            if(userp(me))
                 me->add("force",-150);
            msg = HIW"$n"+HIW+"顿时觉得一股强大的力量传向自己的手腕，手中";
            msg += weapon2->name();
            msg += "脱手飞出! \n"NOR;
            msg += HIR"同时逆血冲上心头，忍不住吐出一口鲜血.\n"NOR;
            me->start_busy(random(2));
            target->receive_damage("kee", damage,me);
            target->start_busy( random(2) + 1);
            weapon2->move(environment(me));
        }
        else
        {
            if(userp(me))
                 me->add("force",-50);
            msg = RED"$n"+RED+"急运内力，将手中" + weapon2->name()+RED+
"斜斜顺势一送一搭，抽了回来。\n"NOR;
            me->start_busy(5);
        }
        message_vision(msg, me, target);
 me->set_temp("suo_end",time());

        return 1;
}
