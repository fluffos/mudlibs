//rewrited by huarong 2004/8
//player梦回西游提供描述

#include <ansi.h>
inherit SSERVER;

string *wanjian= ({
BLINK+MAG+"紫微剑！"NOR,
BLINK+WHT+"天机剑！"NOR,
BLINK+HIB+"太阳剑！"NOR,
BLINK+HIM+"天同剑！"NOR,
BLINK+HIC+"廉真剑！"NOR,
BLINK+HIW+"武曲剑！"NOR,
BLINK+HIR+"天府剑！"NOR,
BLINK+HIG+"太阴剑！"NOR,
BLINK+HIY+"贪狼剑！"NOR,
BLINK+BLK+"天相剑！"NOR,
});

string *color= ({
MAG+"紫色"NOR,
WHT+"灰色"NOR,
HIB+"蓝色"NOR,
HIM+"粉色"NOR,
HIC+"青色"NOR,
HIW+"白色"NOR,
HIR+"红色"NOR,
HIG+"绿色"NOR,
HIY+"黄色"NOR,
BLK+"黑色"NOR,
});


int perform(object me, object target)
{
        object weapon;
 int i,j,k,t,u,damage,rannum;
        string str; 
        weapon = me->query_temp("weapon");
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target)
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要攻击谁？\n");
        if(me->query("family/family_name")!="蜀山派")
                return notify_fail("非蜀山不能用「万剑诀」！\n");
        if(!me->is_fighting())
                return notify_fail("你们没有在打架！\n");
        if( time()-(int)me->query_temp("wanjian_end") < 6 )
          return notify_fail("绝招用多就不灵了！\n");
        if((int)me->query("max_force") < 1000 )
                return notify_fail("你的内功太差。\n");
        if((int)me->query("force") < 500 )
                return notify_fail("你的内力不足！\n");
        if((int)me->query("sen") < 200 )
                return notify_fail("你的精神不足，没法子施用外功！\n");
        if((int)me->query_skill("taoism", 1) < 100)
                return notify_fail("你的天师正道等级不够，不能使用这一招！\n");
        k=(int)me->query_skill("sword");
        j=(int)target->query_skill("dodge");
                  if(k<150)        
                return notify_fail("你的剑法级别还不够，使用这一招会有困难！\n");
if (me->query("lunhui_zhuanshi") < 1)
{
t=1;}
 if (me->query("lunhui_zhuanshi") == 1){
t=2;}
 if (me->query("lunhui_zhuanshi") == 2){
t=3;}
 if (me->query("lunhui_zhuanshi") == 3){
t=3;}
 if (me->query("lunhui_zhuanshi") == 4){
t=5;}
 if (me->query("lunhui_zhuanshi") == 5){
 t=3;}
        u=1+k/50;
       if (u>9) u=9;
         me->delete("env/brief_message");
         target->delete("env/brief_message");

message_vision(HIB"\n$N"+HIB+"眼观鼻，鼻观口，口问心，忽然时间仿佛停止了流逝.."NOR,me,target);
message_vision(HIB"\n周围的一切都寂静缓慢下来，手中的"+weapon->query("name")+HIB+"不住颤动，好似要脱手飞去.."NOR,me,target);
message_vision(HIC"\n$N"+HIC+"猛的抬头，喝道：“以吾之名，借天地之气一用！”眼中爆出两朵银芒，直通云霄！"NOR,me,target);
message_vision(HIC"\n远处的天空传来一阵撕裂的声音，刹那间亿万道匹练似的剑光遮月蔽日破空而至！"NOR,me,target);
message_vision(HIB"\n看着如此之多的剑光，$n"+HIB+"不禁惊呆了...\n\n"NOR,me,target);

        for (i=0;i<=u;i++)
         {
             message_vision(wanjian[i], me, target);
          if (random(k+j)>j*3/4)// old is j/2  mudbug on 2003/3/10
           {
             message_vision(YEL"\n$n"+NOR+YEL+"一个不慎，一道长虹般的"+color[i]+YEL+"光透体而入！"NOR,me,target);
             rannum=random(me->query("force_factor"));
               damage=100+random(500);  
                damage=damage*3/2+random(damage)+t*200;
             target->receive_damage("kee",damage);
             target->receive_wound("kee",damage/2);
             COMBAT_D->report_status(target);
             target->set_temp("last_damage_from", me);
             me->receive_damage("sen", 10);
             me->add("force", -20-me->query("force_factor")/3);//old is -20 only mudbug 2003/3/10,/3 by redrain
          }
         else 
          {
             message_vision(YEL"\n$n"+NOR+YEL+"左跳右闪前翻后滚好不容易躲过了这一剑...\n"NOR,me,target);
             me->receive_damage("sen", 10);
             me->add("force", -20);
          }
       if(me->query("force")<0||me->query("force")<me->query("force_factor")+20)
          {
           message_vision(HIB"\n$N"+HIB+"经过一轮剑雨般的攻击后内力明显过支了，慢慢的恢复了节奏!\n"NOR,me,target);
           break;
          }
}
    if ( (target->query("eff_kee")<0 || (!living(target) && target->query("kee")<0) )&&random(5)==1)  
                       {str=target->name()+HIM"被"+me->name()+HIM+"用蜀山秘传"NOR+HIC"「万剑诀」"+HIM"杀死了，据说尸体竟然插满数万灵剑！";
                   message("channel:rumor",HIM"【空穴来风】某人："+str+"\n"NOR,users());
                 }
    me->set_temp("wanjian_end",time());
return 1;
}

//作为隐藏pfm的题材吧
/*
$BLINK$$BLK$天相剑！没想到这一剑的攻击范围连居然你本身也笼罩在内...

你左跳右闪前翻后滚好不容易躲过了这一剑...

蝗虫精一个不慎，长虹般的黑色剑光透体而入，只见黑雾中一声雷鸣,元神已被这天造地就的一剑击散！( 蝗虫精死了。)

看着这可怕的一剑不知不觉间你已出了一身的冷汗...连手中的xxx掉落在地上都没有发觉..

这个是前9剑杀死时的谣言
【空穴来风】蝗虫精被某人用蜀山秘传「万剑诀」 杀死了，据说身体已经被数万剑气化为血雾！！

这个是第十剑杀死的谣言
【空穴来风】蝗虫精被某人用蜀山$BLINK$$HIR$禁$HIR$招「万剑诀」 杀死了，据说其元神已被那天造地就的最终一剑所击散！！
由于使用了禁招，祖师白眉令其面壁一年思过....(只是描述下，意思意思，呵呵)

*/

