//modify for dtxy by huarong 2004/10

#include <ansi.h>
inherit SSERVER;
string *where = ({"左","右","前","後","左前","左后","右前","右后"});
int perform(object me, object target)
{
        object weapon;
        int skl,skl1,i,k;
        int skill,skill1,m=0,n=0;
        string msg;
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要攻击谁？\n");
          if((me->query("family/family_name") != "蜀山派")&&(!wizardp(me)))
                return notify_fail("你非我蜀山弟子，怎能使用蜀山绝招?\n");
        if(!me->is_fighting())
                return notify_fail("你们没有在打架！\n");
        if((int)me->query("max_force") < 1000 )
                return notify_fail("你的内功太差。\n");
        if((int)me->query("force") < 1000 )
                return notify_fail("你的内力不足！\n");
        if((int)me->query("sen") < 500 )
                return notify_fail("你的精神不足，没法子施用外功！\n");
        if((int)me->query_skill("taoism", 1) < 120
           ||(int)me->query_skill("spells", 1) < 120)
                return notify_fail("你的法术等级不够，不能使用这一招！\n");
        skl=(int)me->query_skill("mindsword", 1)/2 + (int)me->query_skill("sword", 1)/2;
        skl1=(int)target->query_skill("dodge", 1)/2 + (int)target->query_skill("parry", 1)/2;
        if((int)me->query_skill("sword")<120
           || (int)me->query_skill("mindsword", 1)< 120)      
                  return notify_fail("你的剑法级别还不够，使用这一招会有困难！\n");
        if(time()-me->query_temp("yjwd_end")<8) return notify_fail("御剑无敌不能用得这么频繁！\n");
        me->set_temp("yjwd_end",time());
        me->add("force",-100-random(skl/2));
  k=skl*2;
  skl/=50;
  if (skl>6) skl=6;
  me->set("env/brief_message",1);
  target->set("env/brief_message",1);
  weapon = me->query_temp("weapon");
  message_vision(HIR"\n只见,$N默运天师正道，双目尽赤，全身顿时霞光暴现！！！\n"NOR,me,target);
  message_vision(HIG"\n$N大喝一声：手中$n"+HIG"冉冉升至空中···！\n"NOR,me,weapon);
  for(i=1;i<=skl;i++)
        {
        me->add("force",-60);
        msg=weapon->name(1)+HIB"飞在空中，突然从"+HIR+where[random(sizeof(where))]+HIB+"方射向$n。\n";
        message_vision(HIB+msg+NOR,me,target);
        target->add_temp("apply/dodge",-k);
        target->add_temp("apply/parry",-k);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"));
        if(!random(3)&&random(me->query("combat_exp"))>target->query("combat_exp")*2/3)
            { 
            msg="\n"+weapon->name(1)+HIW"突然又飞了回来，从"HIG"完全不可能的角度"HIW"刺伤$n。\n";
            message_vision(HIW+msg+NOR,me,target);         
            target->receive_wound("sen",k/8,me);
            target->receive_wound("kee",k/8,me);
            COMBAT_D->report_status(target,0);
            COMBAT_D->report_sen_status(target,0);
            }
        target->add_temp("apply/dodge",k);
        target->add_temp("apply/parry",k);
       }
      me->start_busy(2+random(1));

      skill=(int)me->query_skill("mindsword",1);
      skill1=(int)me->query_skill("taoism",1);
      
      if(skill<200 || skill1<200)
      {
        m=30;
        n=30;
      }
      else if(skill<300 || skill1<300)
      {
        m=50;
        n=50;
      }
      else if(skill<500 || skill1<500)
      {
        m=5000;
        n=5000;
      }
      else
      {
        m=10000;
        n=10000;
      }
       if (userp(me)&& m<10000 && n<10000 && random(m)<10 && random(n)<10 )
          {
            message_vision(HIG""+weapon->query("name")+HIG"改变方向，“唰”的一声，斜斜插在地上。\n"NOR,me);
            weapon->move(environment(me));
          }
       else
          {
            message_vision(HIG""+weapon->query("name")+HIG"在空中打了个转，又飞回到$N"+HIG+"手中。\n"NOR,me);
          }
      
        return 1;
 }

