//舞雪
//requirement:force,dodge,sword all over 100
//move to dodge pfm  huarong 2003/12

#include <ansi.h>

inherit F_DBASE;
inherit SSERVER;

void remove_effect(object me, object target, int amount);

int perform(object me, object target) {
  int skill_dodge, long, mz;
  if (me->query("family/family_name") != "月宫")
    return notify_fail("[七彩幻舞]是月宫不传之密！\n");

  if (me->query_skill_mapped("dodge") != "moondance")
    return notify_fail("你还没有施展冷月凝香舞呢。\n");
  if ((int)me->query_skill("moondance", 1) < 100)
    return notify_fail("你舞技还不够高明。\n");
  if (me->query_skill_mapped("force") != "moonforce")
    return notify_fail("舞雪必须配合圆月心法才能使用。\n");
  if ((int)me->query_skill("moonforce", 1) < 100)
    return notify_fail("你的圆月心法不够纯熟。\n");
  if ((int)me->query("force") < 50)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_temp("powerup"))
    return notify_fail("你已经在运功中了。\n");
  if (time() - (int)me->query_temp("huanwu_end") < 7)
    return notify_fail("你现在内息不顺！\n");

  skill_dodge = (int)me->query_skill("dodge") * 2 / 10;
  mz = 0;
  mz = (int)me->query("mingzhong") * 2 / 10;
  if (mz < 0) mz = 1;
  message_vision(
    HIW "$N" + HIW + "略一提气，运起轻功，翩翩起舞，正是冷月凝香舞的绝技" + HIM + "[七彩幻舞]" + HIW + "！\n" NOR,
    me
  );
  tell_object(me, HIM "你增加了" + skill_dodge + "点轻功和" + mz + "点命中！\n" NOR);
  long = (int)me->query_skill("dodge") / 10;
  me->add_temp("apply/dodge", skill_dodge);
  me->add_temp("mingzhong", mz);
  me->set_temp("powerup", 1);
  me->start_call_out((: call_other, __FILE__, "remove_effect",
    me, skill_dodge, mz :), long);
  if (me->is_fighting()) me->start_busy(1);
  me->add("force", -200);
  return 1;
}

void remove_effect(object me, int skill_dodge, int mz) {
  me->add_temp("apply/dodge", -skill_dodge);
  me->add_temp("mingzhong", -mz);
  me->delete_temp("powerup");
  me->set_temp("huanwu_end", time());
  message_vision(HIW "$N" + HIW + "觉得自己的身体沈重下来了。\n" NOR, me);
}
