int valid_learn(object me) {
  object ob;

  if ((int)me->query("max_force") < 50)
    return notify_fail("你的内力修为不够深，无法学习巫月剑法。\n");
  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword")
    return notify_fail("你必须先找一柄剑才能练习剑法。\n");
  return 1;
}

int practice_skill(object me) {
  int dod = (int)me->query_skill("dodge");
  int swo = (int)me->query_skill("songhe-sword");

  if (dod < swo / 2)
    return notify_fail("你的身法跟不上剑法，练下去很可能会伤到自己。\n");
  if ((int)me->query("kee") < 30)
    return notify_fail("你体质欠佳，强练巫月剑法有害无益。\n");
  if ((int)me->query("force") < 5)
    return notify_fail("你内力不足，强练巫月剑法有走火入魔的危险。\n");
  me->receive_damage("kee", 30);
  me->add("force", -5);
  message_vision("$N默默回忆了一会儿，然后练了一遍巫月剑法。\n", me);
  return 1;
}

int valid_enable(string usage) {
  return usage == "sword" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

string perform_action_file(string func) {
  return __DIR__ "wuyue-sword/" + func;
}
