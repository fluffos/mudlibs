// By canoe 2001.09.10
//yuejia-spear.c 【岳家枪法】
#include <ansi.h>
inherit SKILL;

mapping *action = ({
  ([ "action":
    "就在闪电之间，$N使一招" BLINK HIR "【飞沙走石】" NOR "，此招一出，\n无数枪影突如其来从$N每寸肌肤中急射而出！",

    "damage": 50,
    "dodge": 15,
    "parry": -15,
    "force": 60,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N手中$w有如游龙，织成一大片枪网，浓浓稠稠的包裹住$n，原来这招有个名堂叫" BLINK HIR "【游龙惊凤】" NOR "！",
    "damage": 55,
    "dodge": 25,
    "parry": -30,
    "force": 60,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N身随枪走，使一招" BLINK HIR "【横扫千军】" NOR "，手中$w竟似棍般扫向$n的$l",
    "damage": 65,
    "dodge": 20,
    "parry": -20,
    "force": 60,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N一抖$w，枪势外强转而内敛，彷若无形，上下左右，虚虚实实刺\n向$n全身要害，却是一招" BLINK HIR "【蛟龙腾云】" NOR "！",
    "damage": 40,
    "dodge": -10,
    "parry": -25,
    "force": 60,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "只见$N手中$w带动一股霸道的枪影，这招" BLINK HIR "【围魏救赵】" NOR "把$n的前前后后全部\n封死，看来绝对没有逃脱的希望！",
    "damage": 40,
    "dodge": -10,
    "parry": -25,
    "force": 60,
    "damage_type": "刺伤"
  ]),
});

int valid_learn(object me) {
  return notify_fail("你没有神人指导,怎么也搞不懂。\n");
}

int valid_enable(string usage) {
  return (usage == "spear") || (usage == "parry");
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "spear")
    return notify_fail("你必须先找一柄长枪或者是类似的武器，才能练枪法。\n");
  if (me->query_skill("yuejia-spear", 1) > 300)
    return notify_fail("你的枪法够高了，怎么练都不行了。\n");
  if ((int)me->query("kee") < 30
    || (int)me->query("force") < 5)
    return notify_fail("你的体力不够练这门枪法，还是先休息休息吧。\n");
  me->receive_damage("kee", 30);
  me->add("force", -5);
  write("你按着所学练了一遍岳家枪法。\n");
  return 1;
}

string perform_action_file(string func) {
  return __DIR__ "yuejia-spear/" + func;
}
