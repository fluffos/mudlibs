//create by huarong 2004/10
#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
        int num_zhua,skill,skilll,skill1,skill2,ap,dp,mz,myexp,youexp,myforce,mystr,damage,i,j;
        string str;
        object weapon = me->query_temp("weapon");

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail(WHT"「五鬼阴风」"+NOR+"只能对战斗中的对手使用。\n");
                if(!wizardp(me) && me->query("family/family_name")!="陷空山无底洞")
                      return notify_fail(WHT"「五鬼阴风」"+NOR+"只有无底洞门人才可以用！\n");
      skill1 = me->query_skill("yinfeng-zhua",1);
      skill2 = me->query_skill("stealing",1);
      
               if( (int)me->query_skill("yinfeng-zhua",1) < 120)
                     return notify_fail("你的阴风爪还不够纯熟!\n");

               if( (int)me->query_skill("huntian-qigong",1) < 120)
                     return notify_fail("你的混天气功还不够纯熟!\n");


               if( (int)me->query_skill("stealing",1) < 100)
                     return notify_fail("你的妙手空空之计等级不够, 不能使用"+WHT+"「五鬼阴风」"+NOR+"！\n");
                     
               if( (skill1-skill2) > 100)
                     return notify_fail("你的妙手空空之计等级不够, 不能使用"+WHT+"「五鬼阴风」"+NOR+"！\n");

               if( (int)me->query("force") < 300)
                     return notify_fail("你的内力不够了!\n");

               if( (int)me->query("max_force") < 1000)
                     return notify_fail("你的内力太弱,无法使出"+WHT+"「五鬼阴风」"+NOR+"。\n");

               if( time()-(int)me->query_temp("yinfeng_end") < 6 )
                     return notify_fail("你现在内息不顺！\n");

message_vision(RED+"忽然阴风乍起，有如从地狱深处刮起一阵狂风，阴寒中带着淡淡的血腥味。\n"NOR, me, target);
message_vision(RED+"$N"+NOR+RED+"大喊一声：\n\n\t\t"+HIY+"〓"+HIB+"阴风爪"+HIY+"〓\n\n"+NOR, me, target);
message_vision(RED+"$N的双手，推揉拂拨不慌不忙，涌来的袖风在$n"+NOR+RED+"的四周形成诡奇的旋转气流，\n"
+"发出令人心悸的奇异呼啸声浪。\n"+NOR, me, target);
message_vision(HIB+"异啸乍起，劲气破空声锐利刺耳。\n"+NOR, me, target);
message_vision(HIB+"似乎，十只爪尖前有怪异的青灰色芒影吐出。\n"+NOR, me, target);
message_vision(HIB+"$N身形突然飞起，形状可怖，在连声鬼啸中，向$n"+HIB+"下扑，半空中连抓九爪之多！\n"+NOR, me, target);
    // me->set_temp("wddpfm",1);

     ap = ((int)me->query_skill("yinfeng-zhua",1)+(int)me->query_skill("unarmed",1));
     dp = ((int)target->query_skill("parry",1)+(int)target->query_skill("dodge",1));
     skilll = (int)me->query_skill("stealing",1)*10;
     skill = (int)me->query_skill("stealing",1) + (int)me->query_skill("unarmed");
     myexp=(int)me->query("combat_exp",1);
     youexp=(int)target->query("combat_exp",1);
     myforce=(int)me->query("force_factor");
     mystr=me->query_str();
     mz = (int)me->query_temp("mingzhong");
     if(mz < 0) mz = 0;
     i = (myexp/dp + random(myexp/dp))+(myexp/dp + random(myexp/dp))*mz/100;
     j = youexp/ap + random(youexp/ap);
     
       damage = mystr+myforce;
    if( i>j||target->query_temp("unconcious") )
           {  num_zhua=skill/100;
              if(num_zhua<1) num_zhua=1;
              if(num_zhua>9) num_zhua=9;
              damage = damage*num_zhua;
              message_vision(HIR"\n$n"+HIR+"躲闪不及，身上留下了"+HIY+chinese_number(num_zhua)+"条"+HIR+"深深的血槽！\n"NOR,me,target);
              damage = damage - target->query_temp("apply/armor_vs_force");
              damage = damage/2 + random(damage/2);
              if(damage<0) damage=0;
              target->receive_damage("kee",damage,me);
              target->receive_wound("kee",damage*3/4+random(damage/4),me);
               if (wizardp(me) && me->query("env/combat")=="verbose")
                          tell_object(me, sprintf(HIM+BLINK+"damage: %d\n" NOR, damage));
              COMBAT_D->report_status(target);
             if (random(num_zhua)>4 && (int)target->query("c_balance") > skilll )
              {
               skilll = random(skilll/2)+skilll/2;
              message_vision(HIR"\n$N"+HIR+"乘$n受伤之际，施展五鬼搬运术，顺手一摸。得到了"+HIY+""+skilll+"文"+HIR+"铜钱！\n"NOR,me,target);
              me->add("c_balance",skilll);
              target->add("c_balance",-skilll);
               }
              if ( (target->query("eff_kee")<0 || (!living(target) && target->query("kee")<0) ) && random(5)==1)
                  {  
                     str=target->name()+HIM"被"+me->name()+HIM+"用无底洞秘传"+NOR+BLU+"「五鬼阴风」"+HIM+"抓死了，"
                          +NOR+HIM"据说尸体上有"+chinese_number(num_zhua*10)+"条爪痕，血肉模糊！";
                     message("channel:rumor",HIM"【空穴来风】某人："+str+"\n"NOR,users());
                   } 
           }
           else
           {
           message_vision(HIG+"谁知$n比$N更快，飘然躲开了！\n"+NOR, me, target);
           }        
        me->start_busy(1+random(2));
        //me->delete_temp("wddpfm");
        me->set_temp("yinfeng_end",time());
        return 1;
}


