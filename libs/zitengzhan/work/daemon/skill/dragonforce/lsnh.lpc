//jiz
#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me, int i);
void dragonpowerup(object me);

int exert(object me, object target)
{
        int skill,i,k;
        if(me->query("family/family_name")!="东海龙宫")
                return notify_fail("非龙宫弟子不能用「龙神心法」！\n");
        if( target != me ) 
                return notify_fail("你只能用龙神心法保护自己。\n");

        if( (int)me->query("force") < 600 )     
                return notify_fail("你的内力不够。\n");
       if( (int)me->query_skill("dragonforce") < 100 )     
                return notify_fail("你的龙神心法等级不够。\n");
	if( (int)me->query("kee") < 500 )
		return notify_fail("你的气血不足。\n");
	if( (int)me->query("sen") < 500 )
		return notify_fail("你的精神不足。\n");
        if( time()-(int)me->query_temp("lsnh_end") < 60 )
                return notify_fail("你刚施展过龙神怒火，不能连续使用！\n");
      if( (int)me->query_temp("dragonpowerup"))
                return notify_fail("你已经怒发冲冠了！\n");

         skill = (int)me->query_skill("dragonforce",1)/5;
     if(me->query_temp("lsnh"))
        {
     message_vision(
                HIR"$N目射血光，散发出如实质般浓郁的杀气！喝到：龙族尊严不容侵犯！犯者必诛！！\n" NOR, me);
         i = me->query_str();
         k = me->query_temp("lsnh/damage");
         i = i*k/10;
         if(i<0) i = 0;
if(i>1000) i = 1000;
	me->add_temp("apply/strength", i);
       me->delete_temp("lsnh");
       me->set_temp("dragonpowerup",1);
        me->start_call_out( (: call_other, __FILE__, "remove_effect", me,i:), skill);
        }
       else
          {
        me->add("force", -400);
message_vision(
                HIR"$N面现狰狞，双目通红，浑身上下散发出野兽般的杀气。\n" NOR, me);
        me->set_temp("lsnh", 1);
       if(me->is_fighting()) me->start_busy(1);
        me->start_call_out( (: call_other, __FILE__, "dragonpowerup", me:), skill/2);
               }
        return 1;
   }

void dragonpowerup(object me)
{
if (me->query_temp("dragonpowerup"))
       return 0;
  me->delete_temp("lsnh");
message_vision(
                HIC"$N双目恢复清澈，慢慢的平静了下来。\n" NOR, me);
       me->set_temp("lsnh_end",time());
	return;
}


void remove_effect(object me,int i)
{
        me->add_temp("apply/strength", -i);
        me->delete_temp("dragonpowerup");
message_vision(
                HIG"$N双目恢复清澈，慢慢的平静了下来。\n" NOR, me);
       me->set_temp("lsnh_end",time());
	return;
}

