inherit SKILL;

mapping *action = ({
  ([ "action":
    "$N使一招「冰山雪莲」，手中$w幻化出数朵雪莲花飞向$n的$l",
    "dodge": -5,
    "parry": -10,
    "damage": 10,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "只见$N跃上半空，一招「冰雪交加」，手中$w果然象漫天冰雪,将$n罩入其中",
    "dodge": -35,
    "parry": -5,
    "damage": 20,
    "damage_type": "割伤"
  ]),
  ([ "action":
    "$N深吸一口气，手中$w一式「雪雾冰山」舞出无数幻影，$n只觉得眼花缭乱，$N的左掌却已悄然按向$n的腰间",
    "dodge": 10,
    "parry": -15,
    "damage": 30,
    "damage_type": "淤伤"
  ]),
  ([ "action":
    "$N手中$w轻轻一抖，一招「冰清玉洁」幻出道道寒光,罩向$n。$n顿时觉得身体凝重了许多",
    "dodge": -30,
    "parry": -5,
    "damage": 15,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N手中$w再一抖，只见周围尽是剑影，$w带着浓浓的寒气直撩向$n的$l",
    "dodge": -10,
    "parry": -10,
    "damage": 25,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$n只觉得一阵寒风吹来，$N已悄然间欺至$n身前，$n一怔间，$N的一式「冰雨纷飞」已突然发动",
    "dodge": -35,
    "parry": -5,
    "damage": 20,
    "damage_type": "刺伤"
  ]),
});

int valid_learn(object me) {
  object ob;

  if ((int)me->query("max_force") < 50)
    return notify_fail("你的内力不够，没有办法练冰魔剑。\n");

  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword")
    return notify_fail("你必须先找一把剑才能练剑法。\n");

  return 1;
}

int valid_enable(string usage) {
  return usage == "sword" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 30
    || (int)me->query("force") < 3)
    return notify_fail("你的内力或气不够，没有办法练习冰魔剑。\n");
  me->receive_damage("kee", 30);
  me->add("force", -4);
  write("你按著所学练了一遍冰魔剑。\n");
  return 1;
}



int valid_effect(object me, object weapon, string name, int skill) {}

string perform_action_file(string func) {
  return __DIR__ "bingmo-sword/" + func;
}
