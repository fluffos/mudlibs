//冷浸溶溶月,思如鞭法lestat/2001.2.14
// modi by xintai 3/2/2001
//modify for dtxy by huarong 2004/10

#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target) {
  string msg, tparryskill;
  int mjianb, mjianh, tparryb, tparryh, mneili, tneili, mexp, texp, damage;
  object weapon, tweapon;
  weapon = me->query_temp("weapon");
  mjianb = (int)me->query_skill("whip", 1);
  mjianh = (int)me->query_skill("yirubian", 1);
  mneili = (int)me->query("force");
  mexp = (int)me->query("combat_exp", 1);
  msg = "";
  if (!objectp(weapon) || (string)weapon->query("skill_type") != "whip")
    return notify_fail("不拿鞭子怎使" + HIM + "『冷浸溶溶月』" + NOR + "？");
  if (me->query("family/family_name") != "蜀山派")
    return notify_fail("你和李逍遥一点关系都没有，使不出这招！\n");
  if (mjianh < 100)
    return notify_fail("你的思如鞭法还不够火候！\n");
  if (me->query_skill("sevensteps", 1) < 100)
    return notify_fail("你的七星步还不够火候！\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail(HIM + "『冷浸溶溶月』" + NOR + "只能在战斗中使用。\n");
  if ((int)me->query("force") < 700)
    return notify_fail("你的内力不够。\n");
  if (time() - (int)me->query_temp("yue_end") < 7)
    return notify_fail("绝招用多了就烂了！\n");
  tweapon = target->query_temp("weapon");  //  Here might be wrong, need to check.
  tparryb = (int)target->query_skill("parry", 1);
  tneili = (int)target->query("force");
  texp = (int)target->query("combat_exp", 1);
  tparryskill = target->query_skill_mapped("parry");
  tparryh = target->query_skill(tparryskill, 1);
  me->add("force", -300);
  me->receive_damage("sen", 20);

  message_vision(HIC "$N" + HIC + "招式一变，手中" + weapon->name() + HIC "斜指向下，双眼漠然，一副与世无争的神态——\n"
    +HIY + "\n\n\t\t〓冷浸溶溶月〓\n\n" NOR, me, target);
  message_vision(HIB "\n$N" + HIB + "向前迈一步，平无华地挥出一鞭，慢，却噼啪作响。\n" NOR, me);
  message_vision(HIB "这一招" + HIW + BLINK + "『无俗念』" + NOR + HIB + "拼的是内力。\n" NOR, me);
  if (random(mexp * 2) > (int)(texp / 4)
    && (int)me->query("max_force") + mneili > random((int)target->query("max_force") + tneili)) {
    msg = HIR "$n" + HIR + "只觉得一股劲气象化作千百枚细针一样，穿体而过！\n"
      "“哇”的一声，$n" + HIR + "喷出一大口鲜血，看来是受了内伤！\n" NOR;
    damage = (int)me->query("max_force") / 10 + random((int)me->query("max_force") / 10);
    damage = damage - target->query_temp("apply/armor_vs_force");
    if (damage < 1) damage = 1;
    target->receive_damage("kee", damage, me);
    target->receive_wound("kee", damage / 3 + random(damage / 3), me);
    me->add("force", -damage / 4 - random(damage / 8));
    message_vision(msg, me, target);
    if (wizardp(me) && me->query("env/combat") == "verbose")
      tell_object(me, sprintf(HIM + BLINK + "damage: %d\n" NOR, damage));
    COMBAT_D->report_status(target);
  } else {
    msg = HIG "$n" + HIG + "忙运功向抗，深厚的内力将$N" + HIG + "的漫天鞭影都激散了。\n" NOR;
    message_vision(msg, me, target);
  }

  message_vision(YEL "\n$N" + NOR + YEL + "由静转动，一动便急如风，脚踏奇门，鞭走奇招，\n"
    + "每一鞭从$n" + NOR + YEL + "意想不到的方位无声无息地挥出！\n" NOR, me, target);
  message_vision(YEL "这一招" + RED + BLINK + "『永矢勿谖』" + NOR + YEL + "斗的是鞭法！\n" NOR, me, target);
  if (random(mexp * 2) > (int)(texp / 4) && random((int)(mjianb + mjianh * 3)) > (int)((tparryb + tparryh) / 2)) {
    msg = HIR "$n" + HIR + "马上手忙脚乱，不知该如何去招架这静若幽冥、快如风的鞭法！\n"
      "果不然，$N" + HIR + "的" + weapon->name() + HIR "招招命中，$n" + HIR + "浑身上下被抽得遍体鳞伤！\n" NOR;
    damage = random(100) + mjianb * 2 + random(mjianb);
    damage = damage - target->query_temp("apply/armor");
    if (damage < 1) damage = 1;
    target->receive_damage("kee", damage, me);
    target->receive_wound("kee", damage / 3 + random(damage / 3), me);
    me->add("force", -damage / 4 - random(damage / 8));
    message_vision(msg, me, target);
    if (wizardp(me) && me->query("env/combat") == "verbose")
      tell_object(me, sprintf(HIM + BLINK + "damage: %d\n" NOR, damage));
    COMBAT_D->report_status(target);
  } else {
    msg = HIG "$n" + HIG + "却心静如水，丝毫不显慌乱，见招拆招，瓦解了$N" + HIG + "这无声的攻势。\n" NOR;
    message_vision(msg, me, target);
  }


  message_vision(WHT "\n$N" + NOR + WHT + "突然收住身形，回步而立，收鞭于背后，无招胜有招，无形胜有形。\n" NOR, me);
  message_vision(WHT "这一招" + HIM + BLINK + "『独寐寤言』" NOR + WHT + "比的是经验！\n" NOR, me);
  if (random(texp) < (int)(mexp * 7 / 6)) {
    msg = HIR "$n" + HIR + "果然上当，以为$N" + HIR + "露出破绽，大喜之下，急忙上前想抢攻。\n"
      "$N" + HIR + "微微一笑，待$n" HIR + "靠近，长袖一抖，袖尽鞭出，直探$n" + HIR + "的胸口。\n"
      "$n" + HIR + "连鞭影还没看到，就差点儿被穿的透心凉！\n" NOR;
    damage = (int)me->query_skill(
      "dodge",
      1
    ) * 2 + random((int)me->query_skill("dodge", 1)) + random(me->query("force_factor"));
    damage = damage - target->query_temp("apply/armor");
    if (damage < 1) damage = 1;
    target->receive_damage("kee", damage, me);
    target->receive_wound("kee", damage / 3 + random(damage / 3), me);
    me->add("force", -damage / 8 - random(damage / 8));
    message_vision(msg, me, target);
    if (wizardp(me) && me->query("env/combat") == "verbose")
      tell_object(me, sprintf(HIM + BLINK + "damage: %d\n" NOR, damage));
    COMBAT_D->report_status(target);
  } else {
    msg = HIG "$n" + HIG + "看破了这招的虚实，将计就计，假装冲上前，\n"
      + "却在$N" + HIG + "出招的一瞬间腾空而起，回手竟反攻一招！\n" NOR;
    message_vision(msg, me, target);
    COMBAT_D->do_attack(target, me, tweapon);
  }
  me->start_busy(1 + random(1));
  me->set_temp("yue_end", time());
  if ((int)me->query("force") < 0)
    me->set("force", 0);
  return 1;
}
