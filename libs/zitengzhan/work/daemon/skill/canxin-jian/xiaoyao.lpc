//create by huarong 2003/12
#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
 int damage, skill,i,t,time;
       int myexp,youexp,ratio,myskill,myskill1,youskill;
       object weapon=me->query_temp("weapon");
       string msg;

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail(HIR+"「逍遥神剑」"+NOR+"只能对战斗中的对手使用。\n");
                if(!wizardp(me) && me->query("family/family_name")!="蜀山派")
             return notify_fail(HIR+"「逍遥神剑」"+NOR+"只有蜀山门人才可以用！\n");

        if( (int)me->query("force") < 2000)
            return notify_fail("你的内力不够了!\n");

         if( (int)me->query_skill("sword",1) < 250
          ||me->query_skill_mapped("sword") != "canxin-jian")
             return notify_fail("你的「基本剑术」还不到家，无法使用"+HIR+"「逍遥神剑」"+NOR+"！\n");
        
        if( (int)me->query_skill("canxin-jian",1) < 250 )
            return notify_fail("你的「残心剑」还不到家，无法使用"+HIR+"「逍遥神剑」"+NOR+"！\n");



        if( (int)me->query_skill("hunyuan-zhang",1) < 250 )
            return notify_fail("你的「混元掌」还不到家，无法使用"+HIR+"「逍遥神剑」"+NOR+"！\n");

        if( (int)me->query_skill("mindsword",1) < 250 )
            return notify_fail("你的「桃花剑」还不到家，无法使用"+HIR+"「逍遥神剑」"+NOR+"！\n");
        
        if( (int)me->query_skill("yujianshu",1) < 250 )
            return notify_fail("你的「御剑术」等级不够，无法推动"+HIR+"「逍遥神剑」"+NOR+"！\n");

        if( (int)me->query_skill("zixia-shengong",1) < 250 )
            return notify_fail("你的「紫霞神功」还不到家，无法自由控制剑进行"+HIR+"「逍遥神剑」"+NOR+"！\n");

          if( time()-(int)me->query_temp("xiaoyao_end") < 6 )
            return notify_fail("此乃蜀山剑法之精髓所在，用多了就烂了！\n");
if (me->query("lunhui_zhuanshi") < 1){
t=1;}
 if (me->query("lunhui_zhuanshi") == 1){
t=2;}
 if (me->query("lunhui_zhuanshi") == 2){
t=3;}
if (me->query("lunhui_zhuanshi") >2){
t=3;}
            
        myexp=(int)me->query("combat_exp",1);
        youexp=(int)target->query("combat_exp",1);
        ratio=to_int((to_float(myexp)/10)/(to_float(youexp)/1000));
        if (ratio>250) ratio=250;
        if (ratio<20)  ratio=20;

        skill=(int)me->query_skill("whip",1)+(int)me->query_skill("zixia-shengong",1)+(int)me->query_skill("sword",1);
        myskill=(int)me->query_skill("whip",1)+(int)me->query_skill("zixia-shengong",1);
        myskill1=(int)me->query_skill("unarmed",1)+(int)me->query_skill("zixia-shengong",1);
        youskill=(int)target->query_skill("dodge",1)+(int)target->query_skill(target->query_skill_mapped("force"),1);
        me->delete("env/brief_message");
        target->delete("env/brief_message");

        message_vision(HIG"\n$N"+HIG+"聚气凝神，剑如疾风，向$n"+HIG+"连续发动进攻！\n"NOR,me,target);        
        message_vision(MAG"\n$N"+NOR+MAG+"以剑代鞭抖动"+weapon->query("name")+NOR+MAG+"，一式"+HIG+"〓"+HIY+BLINK+"傲啸江湖"+NOR+HIG+"〓"NOR+MAG+"漫天剑影夹带着清脆的响声，震聋发出！\n"NOR,me,target);
        if(random(youskill)<myskill)
            {
            message_vision(HIR+"$n"+HIR+"未加提防，被缠的脱不开身！\n"NOR,me,target);
 if((int)me->query_skill("whip",1)<350) time=2+t;
              else if((int)me->query_skill("whip",1)<400) time=t+3;
  else time=4+t;
  target->start_busy(random(time)+t/2);
            }
        else
            {
            message_vision(HIY+"$n"+HIY+"好似早有所料，灵巧的跳开了！\n"NOR,me,target);
            } 
        me->set("xiangsi", 11);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        me->set("xiangsi", 12);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        message_vision(MAG"\n\n激战中$N"+NOR+MAG+"收剑凝气于双掌，轰然打出混元掌一式"+HIG+"〓"+HIW+BLINK+"白云出岫"+NOR+HIG+"〓"NOR+MAG+"，双掌间升起一团淡淡的白雾！\n"NOR,me,target);
        if(random(youskill)<myskill1)
            {
            message_vision(HIR+"$n"+HIR+"躲闪不及，被$N"+HIR+"拍中前胸，顿时口吐鲜血！\n"NOR,me,target);
              damage = random(skill/3+t*500)+skill*2/3;
            damage=damage-target->query_temp("apply/armor_vs_force");
damage=damage*ratio/100+t*500;
            if (damage<0) damage=0;
            target->receive_wound("kee", damage,me);
            target->receive_damage("kee", damage,me);
            target->add("force",-random(damage/2));
            if (wizardp(me) && me->query("env/combat")=="verbose")
                   tell_object(me, sprintf(HIM+BLINK+"damage: %d\n" NOR, damage));
            if(damage>0) COMBAT_D->report_status(target);
            }
        else
            {
            message_vision(HIG+"$n"+HIG+"好似早有所料，灵巧的跳开了！\n"NOR,me,target);
            } 
        me->set("xiangsi", 13);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        me->set("xiangsi", 14);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        me->delete("xiangsi");
      me->start_busy(2+random(1));
      me->add("force",-100-random(damage/2));
      me->add("sen",-100);
      me->set_temp("xiaoyao_end",time());
      return 1;
}


