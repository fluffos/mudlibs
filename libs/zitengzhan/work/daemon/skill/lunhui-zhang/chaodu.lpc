
#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
	string msg;
	if( !target ) target = offensive_target(me);

        if(me->query("family/family_name")!="南海普陀山")
                return notify_fail("不是佛门弟子不能用「超生渡化」！\n");
	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
                return notify_fail("超生渡化只能对战斗中的对手使用。\n");
        if((int)me->query_skill("lunhui-zhang", 1) < 120)
            return notify_fail("你的轮回杖修为还不够，使用这一招会有困难！\n");
	 if (me->query("force")<1000)
	     return notify_fail("你的内力不够。\n");
        if( time()-(int)me->query_temp("lastchaodu") < 7 )
	     return notify_fail("你刚刚使过超渡绝招，还是歇会儿吧。\n");

        me->add_temp("mingzhong",-80);
   	 me->add("force",-200);
        msg = HIR "$N缓缓说道:佛曰,以杀止杀!我今天就大开杀戒.代表佛来惩罚你们这些顽恶之徒!\n" NOR;
	 message_vision(msg, me, target);
        msg =  HIY "\n天理循环，报应不爽！"NOR;
        message_vision(msg, me, target);
	 me->set_temp("LUNHUI_perform",0);
	 COMBAT_D->do_attack(me,target, me->query_temp("weapon"));
        msg =  HIC "\n天网恢恢，疏而不漏！"NOR;
        message_vision(msg, me, target);
	 me->set_temp("LUNHUI_perform",3);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"));
        msg =  HIG "\n放下屠刀，立地成佛！"NOR;
        message_vision(msg, me, target);
	 me->set_temp("LUNHUI_perform",5);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"));
        msg =  HIW "$n"+HIW+"好象已经到了极乐世界．．．．\n"NOR;
	 message_vision(msg, me, target);
        me->add_temp("mingzhong",80);
        me->start_busy(1+random(2));
	 me->set_temp("lastchaodu",time());
	 return 1;
}
