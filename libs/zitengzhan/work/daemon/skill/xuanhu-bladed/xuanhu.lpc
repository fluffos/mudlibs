          me,
          target
        );
        message_vision(
          HIY "                                   O$$C######%C%#&#C    \n" NOR,
          me,
          target
        );
        message_vision(
          HIY "                         C*         *C C%#&###$ $##$    \n" NOR,
          me,
          target
        );
        message_vision(
          HIY "                         *$C        CC   *C####* &#&    \n" NOR,
          me,
          target
        );
        message_vision(
          HIY "              *           $OO*       $C    %##$  O#&*    \n" NOR,
          me,
          target
        );
        message_vision(
          HIY "             $#*          $O$O**      $O$O  CC    &#C    \n" NOR,
          me,
          target
        );
        message_vision(
          HIY "             C$*          $$$$CC        C         $#C    \n" NOR,
