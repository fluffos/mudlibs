        );
        message_vision(HIY "                       CC   C*                     \n" NOR, me, target);
        message_vision(
          HIY "                      *$   C*                       \n" NOR,
          me,
          target
        );
        message_vision(HIY "                      O*  $$C                      \n" NOR, me, target);
        message_vision(HIY "                     C*  $O                      \n" NOR, me, target);
        message_vision(HIY "                    ** *%O                      \n" NOR, me, target);
        message_vision(HIY "                    CC$$O                       \n" NOR, me, target);
        message_vision(HIY "              **   C*COC                      \n" NOR, me, target);
        message_vision(HIY "              COO$%&$$C                       \n" NOR, me, target);
        message_vision(HIY "             *O$$O* O$O                       \n" NOR, me, target);
        message_vision(HIY "             **                              \n\n\n" NOR, me, target);

        m = damage * 2 + random(damage * 2);
        n = damage + random(damage * 2);
        target->receive_damage("kee", m, me);
        target->receive_wound("kee", n, me);
        target->receive_damage("sen", m, me);
        target->receive_wound("sen", n, me);
        COMBAT_D->report_status(target);
        COMBAT_D->report_sen_status(target);
        if (wizardp(me) && me->query("env/combat") == "verbose") {
          tell_object(me, sprintf(HIM + BLINK + "damage: %d\n" NOR, m));
          tell_object(me, sprintf(HIM + BLINK + "sen_damage: %d\n" NOR, n));
        }


        if (target->query("eff_kee") < 0 || (!living(target) && target->query("kee") < 0)) {
          if (target->query_temp("xuanhu_die") != 1) {
            str = me->name() + HIM + "使出" + HIB + "「玄狐长恨斩」" + HIM + "之终极杀招" NOR + HIY + BLINK + "「飞凤斩」"
              +NOR + HIM + "将" + target->query("name") + HIM + "送去崔叔叔那里去喝茶去了！";
            target->set_temp("xuanhu_die", 2);
          }
        }
      }

    }
    //////////////////////////////////////////
  } else {
    message_vision(HIG "\n不料$n" + HIG + "冷哼一声：“雕虫小技”。顺势躲开了攻击。\n" NOR, me, target);
  }
  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
  }
  me->set_temp("xuanhu_end", time());
  me->start_busy(2 + random(2));
  me->receive_damage("sen", 50);
  me->add("force", -100 - damage / 4);

  if (target->query_temp("xuanhu_die") && random(5) == 1)
    message("channel:rumor", HIM "【空穴来风】某人：" + str + "\n" NOR, users());

  return 1;
}
