#include <ansi.h>
inherit SSERVER;

int perform(object me, object target) {
  object weapon, ob;
  int j, skill, i, damage, num_daoshang, m, n, num_skill;
  string msg, str;

  //        if (me->query("moon/xuanhu")!="done"&&!wizardp(me))
  //           return 0;

  if ((me->query("family/family_name") != "月宫") && !wizardp(me))
    return notify_fail("你是哪儿偷学来的武功，也想用「玄狐长恨斩」?\n");

  if (!target) target = offensive_target(me);

  if (!target

    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail(HIR + "「玄狐长恨斩」" + NOR + "只能在战斗中使用。\n");


  if ((int)me->query_skill("xuanhu-blade", 1) < 120)
    return notify_fail("你的「玄狐长恨刀」不够娴熟，不会使用" + HIR + "「玄狐长恨斩」" + NOR + "。\n");

  if ((int)me->query("force") < 2000)
    return notify_fail("你的内力不够。\n");

  if ((int)me->query("bellicosity") > 200)
    return notify_fail("你的杀气太重，不符玄狐长恨刀的要义。\n");

  if (time() - me->query_temp("xuanhu_end") < 6)
    return notify_fail("你刚使出玄狐长恨斩，突觉体力不够！\n");

  if (target->query_temp("jldl") && me->query("yincang/moon")) {
    target->delete_temp("jldl");
    target->set_temp("jldl_end", time());
    message_vision(HIR "面对$N强大的攻势，$n的借力打力也失去了作用！\n\n\n" NOR, me, target);
  }
  me->delete("env/brief_message");
  target->delete("env/brief_message");
  weapon = me->query_temp("weapon");

  message_vision(
    HIC "$N" + HIC + "双手高举" + HIY + weapon->query("name") + HIC + "大喊：\n" NOR,
    me,
    target
  );
  message_vision(HIR "                玄狐长恨斩\n" NOR, me, target);
  message_vision(HIY + weapon->query("name") + HIC + "幻化出万千光影，照亮了半边天。\n" NOR, me, target);

  me->set_temp("pfm_xuanhu", 8);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  me->set_temp("pfm_xuanhu", 9);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  me->delete_temp("pfm_xuanhu");

  message_vision(HIR "\n接着$N" + HIR + "刀交左手，双腿踢出，刀上呈现一道寒光，身体的重量不能平衡，\n" NOR, me, target);
  message_vision(HIR "整个身子都几乎斜仰在地面上，那片寒光也就利用这一点空隙击落下来。\n" NOR, me, target);
  message_vision(HIR "寒光初现时，速度并不怎么快，但在将要接近$n" + HIR + "身前刹那，却变得比闪电还疾！\n" NOR, me, target);
  message_vision(
    BLU + "\n\n             〓" + HIC + " 玄 " + NOR + BLU + "〓 " + HIC + "狐" + NOR + BLU + " 〓" + HIC + " 望" + NOR + BLU + " 〓" + HIC + " 月" + NOR + BLU + " 〓\n\n\n" NOR,
    me,
    target
  );
  message_vision(HIR "$N" + HIR + "右手撑地，左手刀刀锋四射，身子借势一个旋转，全身功力也都随着这一转之势散发而出。\n" NOR, me, target);

  num_skill = (int)me->query_skill(
    "moonforce",
    1
  ) + (int)me->query_skill(
    "force",
    1
  ) + (int)me->query_skill("xuanhu-blade", 1) + random((int)me->query_skill("blade", 1));
  if (random((int)target->query("combat_exp")) < (int)me->query("combat_exp")) {
    num_daoshang = num_skill / 200;
    if (num_daoshang < 1) num_daoshang = 1;
    message_vision(
      HIR "\n$n" + HIR + "躲闪不及，左手刀在$n" + HIR + "身上留下了" + HIY + chinese_number(num_daoshang) + "道" + HIR + "深深的血槽！\n" NOR,
      me,
      target
    );
    damage = num_daoshang * (random((int)me->query_skill(
      "blade",
      1
    ) * 2 / 3) + (int)me->query_skill("blade", 1) / 3);
    damage = damage - target->query_temp("apply/armor");
    if (damage < 0) damage = 0;
    target->receive_damage("sen", damage, me);
    target->receive_wound("sen", damage / 2, me);
    if (wizardp(me) && me->query("env/combat") == "verbose")
      tell_object(me, sprintf(HIM + BLINK + "damage: %d\n" NOR, damage));
    COMBAT_D->report_sen_status(target);
    if (target->query("eff_kee") < 0 || (!living(target) && target->query("kee") < 0)) {
      str = target->name() + HIM "被" + me->name() + HIM + "用月宫秘传" + HIB + "「玄狐长恨斩」" + HIM + "之绝招" NOR + HIY + "「玄狐望月」"
        +NOR + HIM "斩成" + chinese_number(num_daoshang) + "段，死状惨不忍睹！";
      target->set_temp("xuanhu_die", 1);
    }
    //////////////////////////////////
    //隐藏招式
    /////////////////////////////////
    i = random(10);

    if ((me->query("yincang/moon") && wizardp(me)) && target->query_temp("xuanhu_die") != 1) {
      skill = me->query_skill("xuanhu-blade", 1);
      target->start_busy(2);

      message_vision(
        HIC "\n紧跟着，$N" + HIC + "的身子平空拔升起八九丈，只见青芒打闪，人和刀已化成一道青光，俯冲急下。\n" NOR,
        me,
        target
      );

      if (i > 4) {
        message_vision(
          HIW "              ＿＿＿" + HIY + "狂龙" + HIW + "＿＿＿＿＿" + HIY + "怒斩" + HIW + "＿＿＿\n" NOR,
          me,
          target
        );
        message_vision(HIW "             {<<<<<<<<<<<<<<<>>>>>>>>>>>>>>>}\n" NOR, me, target);
        message_vision(HIW "              ￣￣￣￣￣￣￣￣￣￣￣￣￣￣￣\n" NOR, me, target);
        message_vision(HIR "\n  $N" + HIR + "的身体渐渐的被火焰包围，而$N" + HIR + "的身形也渐渐的幻化为一条火龙，" NOR, me);
        message_vision(
          HIR "\n  只见一条火龙迅速的向着$n" + HIR + "飞去，令$n" + HIR + "不及招架。\n\n" NOR,
          me,
          target
        );

        message_vision(
          HIR "                                        &.  &.     .\n" NOR,
          me,
          target
        );
        message_vision(
          HIR "                                        ~ss.&ss. .s'\n" NOR,
          me,
          target
        );
        message_vision(
          HIR "                                .     .ss&&&&&&&&&&s.\n" NOR,
          me,
          target
        );
        message_vision(
          HIR "                                &. s&&&&&&&&&&&&&&`&&Ss\n" NOR,
          me,
          target
        );
        message_vision(
          HIR "                                ~&&&&&&&&&&&&&&&&&&o&&&       .\n" NOR,
          me,
          target
        );
        message_vision(
          HIR "                               s&&&&&&&&&&&&&&&&&&&&&&&&s.  .s\n" NOR,
          me,
          target
        );
        message_vision(
          HIR "                              s&&&&&&&&&~&&&&&&~~~~&&&&&&~&&&&&.\n" NOR,
          me,
          target
        );
        message_vision(
          HIR "                              s&&&&&&&&&&s~~&&&&ssssss~&&&&&&&&~\n" NOR,
          me,
          target
        );
        message_vision(
          HIR "                             s&&&&&&&&&&'         `~~~ss~&~&s~~\n" NOR,
          me,
          target
        );
        message_vision(
          HIR "                             s&&&&&&&&&&.              `~~~~~&  .s&&s\n" NOR,
          me,
          target
        );
        message_vision(
          HIR "                             s&&&&&&&&&&&&s....               `s&&'  `\n" NOR,
          me,
          target
        );
        message_vision(
          HIR "                         `ssss&&&&&&&&&&&&&&&&&&&&####s.     .&&~&.   . s-\n" NOR,
          me,
          target
        );
        message_vision(
          HIR "                           `~~~~&&&&&&&&&&&&&&&&&&&&#####&&&&&&~     &.&'\n" NOR,
          me,
          target
        );
        message_vision(
          HIR "                                 ~&&&&&&&&&&&&&&&&&&&&&####s~~     .&&&|\n" NOR,
          me,
          target
        );
        message_vision(
          HIR "                                  ~&&&&&&&&&&&&&&&&&&&&&&&&##s    .&&~ &\n" NOR,
          me,
          target
        );
        message_vision(
          HIR "                                   &&~~&&&&&&&&&&&&&&&&&&&&&&&&&&&&&~   `\n" NOR,
          me,
          target
        );
        message_vision(
          HIR "                                  &&~  ~&~&&&&&&&&&&&&&&&&&&&&S~~~~'\n" NOR,
          me,
          target
        );
        message_vision(
          HIR "                             .   .~     '  &&&&&&&&&&&&&&&&####s\n" NOR,
          me,
          target
        );
        message_vision(
          HIR "                             &.          .s&&&&&&&&&&&&&&&&&####~\n" NOR,
          me,
          target
        );
        message_vision(
          HIR "                 .           ~&s.   ..ssS&&&&&&&&&&&&&&&&&&&####~\n" NOR,
          me,
          target
        );
        message_vision(
          HIR "                 &           .&&&S&&&&&&&&&&&&&&&&&&&&&&&&#####~\n" NOR,
          me,
          target
        );
        message_vision(
          HIR "                 Ss     ..sS&&&&&&&&&&&&&&&&&&&&&&&&&&&######~~\n" NOR,
          me,
          target
        );
        message_vision(
          HIR "                  ~&&sS&&&&&&&&&&&&&&&&&&&&&&&&&&&########~\n" NOR,
          me,
          target
        );
        message_vision(
          HIR "           .      s&&&&&&&&&&&&&&&&&&&&&&&&#########~~'\n" NOR,
          me,
          target
        );
        message_vision(
          HIR "           &    s&&&&&&&&&&&&&&&&&&&&&#######~~'      s'         .\n" NOR,
          me,
          target
        );
        message_vision(
          HIR "           &&..&&&&&&&&&&&&&&&&&&######~'       .....&&....    .&\n" NOR,
          me,
          target
        );
        message_vision(
          HIR "            ~&&&&&&&&&&&&&&&######~' .     .sS&&&&&&&&&&&&&&&&s&&\n" NOR,
          me,
          target
        );
        message_vision(
          HIR "              &&&&&&&&&&&&#####~     &. .s&&&&&&&&&&&&&&&&&&&&&&&&s.\n" NOR,
          me,
          target
        );
        message_vision(
          HIR "   )          &&&&&&&&&&&#####'      `&&&&&&&&&###########&&&&&&&&&&&.\n" NOR,
          me,
          target
        );
        message_vision(
          HIR "  ((          &&&&&&&&&&&#####       &&&&&&&&###~       ~####&&&&&&&&&&\n" NOR,
          me,
          target
        );
        message_vision(
          HIR "  ) \\         &&&&&&&&&&&&####.     &&&&&&###~             ~###&&&&&&&&&   s'\n" NOR,
          me,
          target
        );
        message_vision(
          HIR " (   )        &&&&&&&&&&&&&####.   &&&&&###~                ####&&&&&&&&s&&'\n" NOR,
          me,
          target
        );
        message_vision(
          HIR " )  ( (       &&~&&&&&&&&&&&#####.&&&&&###'                .###&&&&&&&&&&~\n" NOR,
          me,
          target
        );
        message_vision(
          HIR " (  )  )   _.&~   &&&&&&&&&&&&######.&&##'                .###&&&&&&&&&&\n" NOR,
          me,
          target
        );
        message_vision(
          HIR " ) (  ( \\.         ~&&&&&&&&&&&&&#######....          ..####&&&&&&&&&&&~\n" NOR,
          me,
          target
        );
        message_vision(
          HIR "(   )& )  )        .&&&&&&&&&&&&&&&&&&####################&&&&&&&&&&&~\n" NOR,
          me,
          target
        );
        message_vision(
          HIR "(   (&&  ( \\     _sS~  `~&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&S&&.\n" NOR,
          me,
          target
        );
        message_vision(
          HIR " )  )&&&s ) )  .      .   `&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&~'  `&&\n" NOR,
          me,
          target
        );
        message_vision(
          HIR "  (   &&&Ss/  .&.    .&..s&&&&&&##S&&&&&&&&&&&&&&&&&&&&&&&&S~~        '\n" NOR,
          me,
          target
        );
        message_vision(
          HIR "    \\)_&&&&&&&&&&&&&&&&&&&&&&&##~  &&        `&&.        `&&.\n" NOR,
          me,
          target
        );
        message_vision(
          HIR "        `~S&&&&&&&&&&&&&&&&&#~      &          `&          `&\n" NOR,
          me,
          target
        );
        message_vision(
          HIR "            `~~~~~~~~~~~~~'         '           '           '\n\n\n" NOR,
          me,
          target
        );

        m = damage * 3 + random(damage * 2);
        n = damage * 2 + random(damage * 3);
        target->receive_damage("kee", m, me);
        target->receive_wound("kee", n, me);
        target->receive_damage("sen", m);
        target->receive_wound("sen", n);
        COMBAT_D->report_status(target);
        COMBAT_D->report_sen_status(target);
        if (wizardp(me) && me->query("env/combat") == "verbose") {
          tell_object(me, sprintf(HIM + BLINK + "damage: %d\n" NOR, m));
          tell_object(me, sprintf(HIM + BLINK + "sen_damage: %d\n" NOR, n));
        }


        if (target->query("eff_kee") < 0 || (!living(target) && target->query("kee") < 0)) {
          if (target->query_temp("xuanhu_die") != 1) {
            str = me->name() + HIM + "竟然使出了" + HIB + "「玄狐长恨斩」" + HIM + "之终极杀招" NOR + HIY + BLINK + "「狂龙怒斩」"
              +NOR + HIM "，看来江湖上又要起大风波了！";
            target->set_temp("xuanhu_die", 2);
          }
        }

      } else {

        message_vision(
          HIW "              ＿＿＿＿" + HIY + "飞" + HIW + "＿＿" + HIY + "凤" + HIW + "＿＿" + HIY + "斩" + HIW + "＿＿＿＿\n" NOR,
          me,
          target
        );
        message_vision(HIW "             {<<<<<<<<<<<<<<<>>>>>>>>>>>>>>>}\n" NOR, me, target);
        message_vision(HIW "              ￣￣￣￣￣￣￣￣￣￣￣￣￣￣￣\n" NOR, me, target);
        message_vision(HIR "\n  $N" + HIR + "的身体渐渐的被火焰包围，而$N" + HIR + "的身形也渐渐的幻化为一只凤凰，" NOR, me);
        message_vision(
          HIR "\n  只见一只火凤凰迅速的向着$n" + HIR + "飞去，令$n" + HIR + "不及招架。\n\n" NOR,
          me,
          target
        );
        message_vision(HIY "                                $C          \n" NOR, me, target);
        message_vision(HIY "                               C#*           \n" NOR, me, target);
        message_vision(HIY "                               $@*           \n" NOR, me, target);
        message_vision(HIY "                               $@$            \n" NOR, me, target);
        message_vision(HIY "                               *#@O             \n" NOR, me, target);
        message_vision(HIY "                                C%#$              \n" NOR, me, target);
        message_vision(HIY "                                 *#@&$*          \n" NOR, me, target);
        message_vision(HIY "                                C $@@@#$          \n" NOR, me, target);
        message_vision(HIY "                               *O  $&&%O$%%$C      \n" NOR, me, target);
        message_vision(HIY "                                OC   * &@##@#%*    \n" NOR, me, target);
        message_vision(
          HIY "                                 *OC   $$$%####$     \n" NOR,
          me,
          target
        );
        message_vision(
          HIY "                                  C    C&######@%    \n" NOR,
          me,
          target
        );
        message_vision(
          HIY "                                  $   *##########%      \n" NOR,
          me,
          target
        );
        message_vision(
