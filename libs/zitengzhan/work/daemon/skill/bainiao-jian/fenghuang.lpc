#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg, str;
  int extra, extra1, extra2, maxli, damage;
  object weapon;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("凤凰之舞只能对战斗中的对手使用。\n");
  //if(me->query("family/family_name")!="大雪山")
  if (!PFM_D->valid_family(me, "大雪山"))
    return notify_fail("[飞鸟投林]只有雪山弟子才可以用！\n");

  if (me->query_skill("bainiao-jian", 1) < 150)
    return notify_fail("你的百鸟剑法那么烂，舞给谁看？\n");
  if (me->query_skill("ningxie-force", 1) < 150)
    return notify_fail("你的内功修为太差了。\n");
  if (me->query_skill("xiaoyaoyou", 1) < 150)
    return notify_fail("你的逍遥游那么烂，舞给谁看？\n");
  if (me->query("force_factor") > 100)
    return notify_fail("「凤凰之舞」加力太大怎么舞啊。\n");
  weapon = me->query_temp("weapon");
  if (me->query_temp("fenghuang_busy"))
    return notify_fail("你舞来舞去的不累？\n");
  if ((int)me->query("force") <= 1000)
    return notify_fail("你内力不够，不能使用凤凰之舞！\n");
  extra = me->query_skill("bainiao-jian", 1);
  extra1 = me->query_skill("xiaoyaoyou", 1);
  extra2 = me->query_skill("ningxie-force", 1);
  maxli = extra / 3 + extra1 / 3 + extra2 / 3;
  // me->add_temp("apply/attack", maxli/50);
  // me->add_temp("apply/damage", maxli);
  msg = HIW "\n$N" + HIW + "神色黯然，随之身形疾转，如冰天雪地中之凤凰独舞！\n风起，愁心起！风息，愁心却无处归依！！\n" NOR;
  message_vision(msg, me, target);
  msg = WHT "\n$n" + WHT + "不觉神情呆滞，似乎勾起无限心伤!\n\n" NOR;
  message_vision(msg, me, target);
  msg = HIC "$N" + HIC + "弹剑轻吟，身形闪动间，连续向$n" + HIC + "攻出三剑！\n" NOR;
  message_vision(msg, me, target);
  me->set("fenghuang", 12);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  me->set("fenghuang", 13);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  me->set("fenghuang", 14);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  if (extra > 200 && extra1 > 200 && extra2 > 200) {
    me->set("fenghuang", 15);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  }
  if (extra > 250 && extra1 > 250 && extra2 > 250) {
    me->set("fenghuang", 16);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  }
  // me->add_temp("apply/attack", -maxli/50);
  // me->add_temp("apply/damage", -maxli);
  /*
 if ( (target->query("eff_kee")<0 || !living(target)) && random(5)==1 )  
{
str=HIM+target->name()+NOR+HIM"被"+me->name()+NOR+HIM"用雪山绝招"HIW"『凤凰之舞』"NOR+HIM"送去了阎罗地府！据说尸体在黄泉路上还跳着舞!";
message("channel:rumor",HIM"【空穴开风】某人："+str+"\n"NOR,users());
}
*/
  //me->start_busy(1+random(1));
  me->add("force", -50 - me->query("force_factor"));
  me->delete("fenghuang");
  me->set_temp("fenghuang_busy", 1);
  call_out("remove_effect", 5 + random(3), me);
  return 1;
}
void remove_effect(object me) {
  if (!me) return;
  me->delete_temp("fenghuang_busy");
}
