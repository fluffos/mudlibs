//modify by ken the new 魔光乍现
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int extra;
  int addon, tmp, atk;
  object weapon;
  extra = me->query_skill("huomo-dao", 300);
  if (extra < 250) return notify_fail("你的天魔步法还不够纯熟！\n");

  addon = me->query_skill("tianmostep", 250);
  tmp = me->query_skill("force", 250);
  if (addon < 250) return notify_fail("你的天魔步法还不够纯熟！\n");
  if ((int)me->query("force") < 200)
    return notify_fail("你的内力不足了。\n");

  if (time() - me->query_temp("guizong_end") < 4)
    return notify_fail("绝招用多了就不灵了。\n");
  //   if(me->query("family/family_name") != "天魔宫")
  if (!PFM_D->valid_family(me, "天魔宫"))
    return notify_fail("你省省好了。\n");

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("没事别乱用万魔归宗。\n");

  message_brief(me, target, "火魔刀", "「万魔归宗」");

  atk = (addon + tmp) / 3;
  me->add_temp("apply/attack", atk);
  me->add_temp("apply/damage", extra);
  weapon = me->query_temp("weapon");
  message_vision(HIW "\n$N神气贯通，将天魔步法精髓一气呵成！\n " NOR, me, target, 0, "env/brief_perform");
  message_vision(HIR "万魔初醒！\n" NOR, me, target, 0, "env/brief_perform");
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0, "env/brief_perform");
  message_vision(HIB "魔光乍现！\n" NOR, me, target, 0, "env/brief_perform");
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0, "env/brief_perform");
  message_vision(HIC "万刃天魔！\n" NOR, me, target, 0, "env/brief_perform");
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0, "env/brief_perform");
  message_vision(HIR "万魔归宗！\n" NOR, me, target, 0, "env/brief_perform");
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0, "env/brief_perform");
  message_vision(HIM "$n使出天魔步法收手式，手中的魔刃迅捷无比地砍向$N的。\n" NOR, target, me);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0, "env/brief_perform");
  me->add_temp("apply/attack", -atk);
  me->add_temp("apply/damage", -extra);
  me->add("force", -200);
  me->set_temp("guizong_end", time());
  return 1;
}
