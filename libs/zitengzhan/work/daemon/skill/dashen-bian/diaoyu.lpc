//create by huarong for dtxy2004  2004/2                                                                                                                                                                              #include <ansi.h>
#include <combat.h>
#include <ansi.h>
inherit SSERVER;
int perform(object me, object target)
{
string msg;
int myexp,yourexp,k,damage;
object weapon,weapon1;
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("太公钓鱼只能对战斗中的对手使用。\n");
        if(me->query("family/family_name")!="昆仑山玉虚洞")
                return notify_fail("“太公钓鱼”只有昆仑山玉虚洞门人才可以用！\n");
        if((int)me->query("max_force") < 200 )
                return notify_fail("你的内功太差。\n");
        if((int)me->query("force") < 100 )
                return notify_fail("你的内力不足！\n");
        if((int)me->query("sen") < 100 )
                return notify_fail("你的精神不足，没法子施用外功！\n");
        if (me->query_skill("dashen-bian",1) < 80)
                return notify_fail("你的打神鞭法还有待提高。\n");
        if( time()-(int)me->query_temp("diaoyu_end") < 5 )
                return notify_fail("绝招用多就不灵了！\n");
weapon = target->query_temp("weapon");
weapon1 = me->query_temp("weapon");
myexp=me->query("combat_exp");
yourexp=target->query("combat_exp");
k=me->query_skill("mace",1)/3;
if (k>200) k=200;

message_vision(HIC+"$N"+HIC+"脚下一点，进势如风，手里的"+HIY+weapon1->query("name")+HIC+"划出了一道银光，直向着对方当头劈落下来。\n" NOR,me,target);
message_vision(HIC+"这一招透着高明，说是"+HIR+"太公钓鱼"+HIC+"，却是另有虚玄——"+NOR+RED+"劈中挂二"+HIC+"。随着$N\n"
+HIC+"大幅度抖开的攻势，一片鞭影，直向着对方整个上身罩落下来。\n" NOR,me,target);
        if (random(myexp+yourexp)>yourexp/2)
           {
              damage=k+random(k);
              target->receive_damage("kee",damage,me);
              target->receive_wound("kee",damage/5,me);
              target->start_busy(3+random(2));
              COMBAT_D->report_status(target);
              message_vision(HIR"\n$n"+HIR+"面对如此猛烈的攻势，被攻了个措手不及！\n"NOR,me,target);
             }
         else message_vision(HIY"\n$n"+HIY+"滴溜溜地打了个转儿，躲开了攻击。\n"NOR,me,target);
         me->receive_damage("sen", 50);
         me->add("force", -150);
	 me->receive_damage("kee", 50);
     if( !target->is_fighting(me) )
         {
                if( living(target) ) 
                 {
                  if( userp(target) ) target->fight_ob(me);
                  else target->kill_ob(me); 
                 }
         }
    me->start_busy(2);
    me->set_temp("diaoyu_end",time());
    return 1;
}
