// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

// yanyun.c 烟云飘渺

inherit SSERVER;
#include <ansi.h>


int cast(object me) {
  int howlong;

  if ((int)me->query("env/invisibility", 1))
    return notify_fail("你已经消失了，还是不要再使用烟云飘渺了。\n");

  if ((int)me->query_skill("spells") < 100)
    return notify_fail("你的法术等级不够，无法使用烟云飘渺。\n");

  if (me->query("family/family_name") != "天魔宫")
    return notify_fail("你不是天魔宫的弟子，无法使用烟云飘渺。\n");

  if ((int)me->query("mana") < 2 * (int)me->query_skill("spells"))
    return notify_fail("你的法力不够了！\n");

  if ((int)me->query("sen") < 50)
    return notify_fail("你的精神无法集中！\n");

  message_vision("$N低声念了几句咒语。\n", me);

  if (random(me->query("max_mana")) < 200) {
    me->add("mana", -(int)me->query_skill("spells"));
    me->receive_damage("sen", 10);
    message("vision", "一阵乌云过后，你又出现了。\n", environment(me));
    return 5 + random(5);
  }

  me->add("mana", -2 * (int)me->query_skill("spells"));
  me->receive_damage("sen", 20);

  howlong = 10 + random((me->query_skill("spells") - 100));
  if (!me->query("env/invisibility"))
    call_out("free", howlong, me, howlong);
  me->set_temp("yinshentime", howlong + (int)me->query_temp("yinshentime"));

  me->set("env/invisibility", 1);
  message_vision(HIW "\n只见$N轻轻一晃，有如一片烟云，瞬间消失得无影无踪。\n\n" NOR, me);

  return 5 + random(5);
}

void free(object user, int howlong) {
  if (!user) return;
  if (!user->query("env/invisibility")) return;
  if (user->query_temp("yinshentime") - howlong) {
    user->set_temp("yinshentime",
      user->query_temp("yinshentime") - howlong);
    call_out("free", user->query_temp("yinshentime"),
      user, user->query_temp("yinshentime"));
    return;
  }
  user->delete_temp("yinshentime");
  user->set("env/invisibility", 0);
  user->save();
  message_vision(HIW "\n几片轻烟渐渐变浓，慢慢的现出了$N的身形。\n\n" NOR, user);
  return;
}
