//vikee 
//modify for 大唐西游2 by huarong 2003/12
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
void lanhua_ok(object);

int perform(object me, object target)
{       int skill,i,j;
	skill = (int)me->query_skill("unarmed",1)/2+(int)me->query_skill("lanhua-shou",1)/2;
                
        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展这一招「兰花拂穴」？\n");
     //    if(me->query("family/family_name") != "盘丝洞" )
if (!PFM_D->valid_family(me, "盘丝洞"))
                return notify_fail("你是哪儿偷学来的武功，也想用「兰花拂穴」?\n");

        if(!me->is_fighting())
                return notify_fail("「兰花拂穴」只能在战斗中使用！\n");

        if((int)me->query("max_force") < 500 )
                return notify_fail("你的内力不够！\n");

	 if((int)me->query("force") < 200 )
		return notify_fail("你的内力不足！\n");

        if((int)me->query("sen") < 200 )
                return notify_fail("你的精神不足，没法子施用外功！\n");

        if((int)me->query_skill("jiuyin-xinjing", 1) < 60)
                return notify_fail("你的九阴心经级别还不够，使用这一招会有困难！\n");

        if((int)me->query_skill("lanhua-shou", 1) < 60)
                return notify_fail("你的兰花拂穴级别还不够，使用这一招会有困难！\n");
              
        if (me->query_skill_mapped("force")!="jiuyin-xinjing")
                return notify_fail("兰花拂穴必须配合九阴心经才能使用。\n");
 

        if (me->query_temp("lanhua_busy"))
                return notify_fail("绝招滥使就不灵了！\n");

        me->delete("env/brief_message");
	target->delete("env/brief_message");

        message_vision(HIM"\n$N"+HIM+"大喝一声，忽施"+HIY+"『兰花拂穴』"+HIM+"向$n"+HIM+"脉门拂去。\n"
                    +"这一拂之式悠扬曼妙，大似韶龄妙女纤手折花一般！\n"NOR,me,target);

        me->set_temp("lanhuashou_pfm", 1);
        COMBAT_D->do_attack(me, target);
        me->set_temp("lanhuashou_pfm", 2);
        COMBAT_D->do_attack(me, target);
        me->set_temp("lanhuashou_pfm", 3);
        COMBAT_D->do_attack(me, target);
        me->set_temp("lanhuashou_pfm", 4);
        COMBAT_D->do_attack(me, target);
        me->delete_temp("lanhuashou_pfm");

        me->receive_damage("sen", 100);
        me->add("force", -100-skill/3);
        me->set_temp("lanhua_busy",1);
        call_out("lanhua_ok",5+random(2),me);


        if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
        }
          me->start_busy(1+random(2));

        return 1;
}

void lanhua_ok(object me)
{ if (!me) return;
      me->delete_temp("lanhua_busy");
}         
