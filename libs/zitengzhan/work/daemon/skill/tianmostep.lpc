// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

//【天魔身法】 tianmostep.c

inherit SKILL;

string *dodge_msg = ({
  "却见$n身形一晃，已从$N身边轻轻滑过。\n",
  "只见$n往后一退，口中喷出阵阵浓烟，$N这一招顿时没了目标。\n",
  "$n身形一晃，$N眼前顿时出现数个幻影，招数自然落了空。\n",
  "$n身形一转，团团黑云将$n隐入其中，$N一招发至，才发现$n早已遁入空中。\n",
  "$n似乎已经躲闪不及，但是$N一招击中才发现，眼前中招的不过是一个幻影。\n",
});

int valid_enable(string usage) { return (usage == "dodge"); }

string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me) {
  if ((int)me->query("sen") < 70
    || (int)me->query("force") < 3)
    return notify_fail("你的气或内力不够，不能练天魔身法。\n");
  me->receive_damage("sen", 30);
  me->add("force", -4);
  return 1;
}
