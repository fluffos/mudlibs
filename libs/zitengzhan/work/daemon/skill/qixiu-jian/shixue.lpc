//Cracked by Roath
#include <ansi.h>
//modify for 大唐西游2 by huarong 2003/12

#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int extra, extra1, extra2, i, damage, force, skill, kee;
  object weapon;
  extra = me->query_skill("qixiu-jian", 1);
  if (extra < 60) return notify_fail("你的[七修剑]还不够纯熟！\n");
  extra1 = me->query_skill("huntian-qigong", 1);
  if (extra1 < 60) return notify_fail("你的[混天气功]还不够纯熟，无法发挥七修剑的威力！\n");
  extra2 = me->query_skill("sword", 1);
  if (extra2 < 60) return notify_fail("你的[基本剑法]还不够纯熟！\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［嗜血］只能对战斗中的对手使用。\n");

  if (me->query("family/family_name") != "陷空山无底洞")
    return notify_fail("你不能用别派的特殊攻击\n");
  if (time() - (int)me->query_temp("qijian_end") < 6)
    return notify_fail("绝招用多了就不灵了！\n");

  skill = extra + extra1 + extra2;
  skill = skill / 60;
  if (skill < 1) skill = 1;
  weapon = me->query_temp("weapon");
  me->add("force", -1000);
  me->add_temp("mingzhong", 30);
  msg = YEL "$N" + NOR + YEL + "狂性大发，手中的" + weapon->name() + NOR + YEL + "狂风暴雨般地向$n" + NOR + YEL + "袭来！" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  damage = COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  force = me->query("force");
  kee = target->query("kee");
  me->add_temp("mingzhong", -30);
  for (i = 0; i <= skill; i++) {
    if (force > 500 && damage > 0 && kee > 1) {
      me->add("force", -600);
      message_vision(HIR "\n$N" + HIR + "看到敌人伤口上滴着的血，状近疯狂，居然在不可能的情况下又再攻出一招！\n" NOR, me);
      damage = COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
      force = me->query("force");
      kee = target->query("kee");
    } else {
      if (target->query("kee") > 0)
        message_vision(HIR "\n$N" + HIR + "剑法一乱，不由自主的停了下来！\n" NOR, me);
      else
        message_vision(HIR "\n$N" + HIR + "见$n" + HIR + "已经奄奄一息了！便收剑而立，停下了攻击！\n" NOR, me, target);
      me->start_busy(1 + random(2));
      me->set_temp("qijian_end", time());
      return notify_fail(HIR "你的狂劲退去了\n" NOR);
    }
  }
  return 1;
}
