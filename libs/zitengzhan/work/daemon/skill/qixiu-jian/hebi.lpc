
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
       object weapon=me->query_temp("weapon"),weapon2,*inv;
       int i;
       inv=all_inventory(me);
       i=sizeof(inv);
      if (!weapon) return 0;
      if( !target ) target = offensive_target(me);
      if( !target || !target->is_character()||target->is_corpse()||!me->is_fighting(target))
          return notify_fail("你要攻击谁？\n");
      if(me->query("family/family_name")!="陷空山无底洞")
          return notify_fail("“刀剑合璧”只有无底洞门人才可以用！\n");
 
      if( time()-(int)me->query_temp("djhb_end") < 10 )
          return notify_fail("绝招用多就不灵了！\n");
      if (me->query_temp("wdd_djhb"))
          return notify_fail("你正在施展“刀剑合璧”！\n");
      if (me->query_skill("huntian-qigong",1)<100)
          return notify_fail("你的内功太差，还不能施展刀剑合璧。\n");
      if (me->query_skill("qixiu-jian",1)<100) 
          return notify_fail("你还是先把精力集中在七修剑法上吧。\n");
      if (me->query_skill("kugu-blade",1)<100)
         return notify_fail("你的枯骨刀法那么烂，还好意思夹在剑法中现眼？\n");
      if (me->query_skill_mapped("force")!="huntian-qigong")
            return notify_fail("刀剑合璧必须配合混天气功才能使用。\n");
      if (me->query_skill_mapped("blade")!="kugu-blade")
            return notify_fail("刀剑合璧必须配合枯骨刀才能发挥威力。\n");
         if (me->query("force")<800)
           return notify_fail("你内力不继，难以出招。\n");

  me->delete_temp("have/blade");  
  for(int k=0;k<i;k++) 
        {
          if ( inv[k]->query("skill_type") == "blade" || inv[k]->query("apply/skill_type") == "blade" ) 
          {
           me->set_temp("have/blade",1);
           weapon2=inv[k];
           break;
           }
         }  
        if ( !me->query_temp("have/blade") )
             return notify_fail("你身上连把刀都没有，怎么使用"+HIR+"「刀剑合璧」"+NOR+"？\n");
if (weapon2->query("changed")&&(int)weapon2->query("durability/now")<=0) 
              return notify_fail("你你的武器损毁严重，怎么使用"+HIR+"「刀剑合璧」"+NOR+"？\n");
 

      seteuid(getuid());
    me->set_temp("wdd_djhb",1);
    message_vision(HIB"$N抽出随身携带的"+weapon2->name()+HIB+"默运混天气功，左手使七修剑法，右手使枯骨刀法，连绵不绝的攻向$n！\n"NOR,me,target);
        weapon->set_temp("original/use_apply_skill",weapon->query("use_apply_skill"));
       weapon->set_temp("original/skill_type",weapon->query("apply/skill_type"));
   COMBAT_D->do_attack(me, target, weapon);
      me->set("actions", (: call_other, SKILL_D("kugu-blade"), "query_action" :) );   
      weapon->set("use_apply_skill",1);
      weapon->set("apply/skill_type","blade");
    COMBAT_D->do_attack(me, target, weapon2);
      weapon->set("use_apply_skill",weapon->query_temp("original/use_apply_skill"));
      weapon->set("apply/skill_type",weapon->query_temp("original/skill_type"));
    me->reset_action();
    call_out("djhb",1,me,target,weapon,weapon2);
   }

void djhb(object me,object target,object weapon,object weapon2)
    {
       string str; 
     if(!me) return 0;
if(!me->is_fighting())
 {
me->set_temp("djhb_end",time());
 me->delete_temp("wdd_djhb");
return 0;
 }
if (!target || !weapon || !weapon2 || me->query_skill_mapped("force")!="huntian-qigong"
                   || me->query_skill_mapped("sword")!="qixiu-jian"
                   || me->query_skill_mapped("blade")!="kugu-blade")
      {
   me->delete_temp("wdd_djhb");
 me->set_temp("djhb_end",time());
return 0;
        }
if ((weapon->query("changed")&&(int)weapon->query("durability/now")<=0) || (weapon2->query("changed")&&(int)weapon2->query("durability/now")<=0)) {
                me->set_temp("djhb_end",time());
                me->delete_temp("wdd_djhb");
message_vision(HIM+"$N的武器损毁严重，无奈的停下了攻击。\n"+NOR,me );
                return 0; }

if (target->is_character() && !target->is_corpse() && environment(me)==environment(target) && me->is_fighting(target) && living(me) && !me->is_ghost())
        {
         if(!me->is_busy())
            {
                    weapon->set_temp("original/use_apply_skill",weapon->query("use_apply_skill"));
                    weapon->set_temp("original/skill_type",weapon->query("apply/skill_type"));
                 COMBAT_D->do_attack(me, target, weapon);
                 me->set("actions", (: call_other, SKILL_D("kugu-blade"), "query_action" :) );   
                    weapon->set("use_apply_skill",1);
                    weapon->set("apply/skill_type","blade");
                 COMBAT_D->do_attack(me, target, weapon2);
                   weapon->set("use_apply_skill",weapon->query_temp("original/use_apply_skill"));
                   weapon->set("apply/skill_type",weapon->query_temp("original/skill_type"));
                 me->reset_action();
                 call_out("djhb",1,me,target,weapon,weapon2);
            return 0;
             }
          else
            {
                 call_out("djhb",1,me,target,weapon,weapon2);
            return 0;
 
             }
         }
      else
        {
          message_vision(HIB"$N狞笑一声，行气收功，右手"+weapon2->name()+HIB+"插回刀鞘。\n"NOR,me);
          me->set_temp("djhb_end",time());
          me->delete_temp("wdd_djhb");
         }
       me->set_temp("djhb_end",time());
      me->delete_temp("wdd_djhb");
   return 0;
 }





 
