//xueer
//【天魔琴】tianmo-qin.c

/*
天魔琴
天魔琴以琴音伤人，故极难躲避，但也正由于其无法直接
敌人的身体，所以攻击力较低。

Attention: 天魔琴只有前六招，而第七，八，九三招是用Perform
时使用的。由于内力消耗巨大，所以平常无法使用。
*/


inherit SKILL;

mapping *action = ({
  ([ "name": "魔音一响",
    "action":
    "$N手指轻弹，$w突然发出激烈的琴音，如利剑一般刺向$n$l",
    "dodge": 0,
    "parry": -60,
    "damage": 25,
    "damage_type": "刺伤"
  ]),
  ([ "name": "魔音二响",
    "action":
    "$N十指纷飞，手中$w突发如雷巨响，有如「晴空霹雳」一般。\n$n只觉得全身寒毛炸起，",
    "dodge": -60,
    "parry": -60,
    "damage": 30,
    "damage_type": "震伤"
  ]),
  ([ "name": "魔音三响",
    "action":
    "$N左手紧钩琴弦，右手用力猛击$w，$w带着奔雷巨响急冲$n而去。",
    "dodge": 10,
    "parry": 10,
    "damage": 30,
    "damage_type": "砸伤"
  ]),
  ([ "name": "魔音四响",
    "action":
    "$N双手压紧琴弦，紧迫的琴音不觉一松，$n一呆间，忽觉两股琴音\n已如长锯飞劈$l。",
    "dodge": -5,
    "parry": -60,
    "damage": 15,
    "damage_type": "刺伤"
  ]),
  ([ "name": "魔音五响",
    "action":
    "$N口中不知在嘟囔什么，双手也不停加劲，$n忽觉得耳旁乐声变得有\n如高山流水，正凝神倾听之间，两条琴弦已飞至面前。",
    "dodge": -10,
    "parry": -10,
    "damage": 35,
    "damage_type": "刺伤"
  ]),
  ([ "name": "魔音六响",
    "action":
    "$N突发长啸，手中$w琴音忽变，突然变得无尽的缠绵悱恻，$n只觉得\n耳边非常的受用，却不知什么时候已然中招。",
    "dodge": -15,
    "parry": -15,
    "damage": 40,
    "damage_type": "震伤"
  ]),
  ([ "name": "魔音七响",
    "action":
    "$N脸色突变，手中$w发出的琴音也变得异常的匪夷所思，$n听着耳边\n的琴音，无意间看了$n一眼，顿感眼前金星闪烁。",
    "dodge": -10,
    "parry": -10,
    "damage": 30,
    "damage_type": "瘀伤"
  ]),
  ([ "name": "魔音八响",
    "action": "$N紧接着再变琴音，$n忽觉四周仙乐飘飘，浑然间已忘了自己身处何\n方，却不知已然中了$N的圈套。",
    "dodge": -10,
    "parry": -10,
    "damage": 30,
    "damage_type": "瘀伤"
  ]),
  ([ "name": "魔音九响",
    "action": "$N口中突发凄厉的啸声，口中一口墨黑的鲜血吐向$w，紧接着$w连发\n十几道琴音从不同方位袭向$n",
    "dodge": -10,
    "parry": -10,
    "damage": 30,
    "damage_type": "瘀伤"
  ]),
});

int valid_learn(object me) {
  object ob;

  if (me->query("family/family_name") != "天魔宫")
    return notify_fail("你非天魔宫弟子，怎可学习魔宫无上绝技！\n");
  if ((int)me->query("max_force") < 150)
    return notify_fail("你的内力不够，没有办法练天魔琴。\n");
  if (me->query("betray/count"))
    return notify_fail("你曾经欺师灭祖，无法练习天魔琴。\n");
  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword")
    return notify_fail("你必须先找一张琴才能练习天魔琴。\n");

  return 1;
}

int valid_enable(string usage) {
  return usage == "music" || usage == "blade" || usage == "sword";
}

mapping query_action(object me, object weapon) {
  int i;
  i = me->query("HellZhen");
  if (!me->query("HellZhen")) {
    return action[random(6)];
  } else {
    return action[i];
  }
}


int practice_skill(object me) {

  if (me->query("family/family_name") != "天魔宫")
    return notify_fail("你非天魔宫弟子，怎可练习魔宫无上绝技！\n");

  if ((int)me->query("kee") < 25
    || (int)me->query("force") < 5)
    return notify_fail("你的内力或气不够，没有办法弹奏天魔琴。\n");
  me->receive_damage("kee", 25);
  me->add("force", -5);
  write("你按着所学弹了一遍天魔琴。\n");
  return 1;
}

int valid_effect(object me, object weapon, string name, int skill) {}


string perform_action_file(string func) {
  return __DIR__ "tianmo-qin/" + func;
}
