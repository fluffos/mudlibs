//modify for 大唐西游2 by huarong 2003/12
#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {

  int damage, skill, myexp, youexp, mystr, myunarmed, myforce, skilll, ap, dp, i, j, mz;
  string str;


  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展这一招「灵犀指」？\n");

  if (!me->is_fighting())
    return notify_fail("「灵犀指」只能在战斗中使用！\n");

  if ((int)me->query("max_force") < 500)
    return notify_fail("你的内力不够！\n");

  if (me->query("family/family_name") != "南海普陀山")
    return notify_fail("你是哪儿偷学来的武功！\n");

  if ((int)me->query("force") < 500)
    return notify_fail("你的内力不足！\n");

  if ((int)me->query("sen") < 100)
    return notify_fail("你的精神不足，没法子施用外功！\n");
  if (time() - (int)me->query_temp("lingxi_end") < 3)
    return notify_fail("你现在内息不顺！\n");

  if ((int)me->query_skill("jienan-zhi", 1) < 60)
    return notify_fail("你的劫难之还不够娴熟！\n");

  myunarmed = (int)me->query_skill("jienan-zhi", 1);


  skill = ((int)me->query_skill(
    "jienan-zhi",
    1
  ) + (int)me->query_skill("lotusforce", 1) + (int)me->query_skill("unarmed", 1));
  ap = ((int)me->query_skill("unarmed", 1) + (int)me->query_skill("jienan-zhi", 1));
  dp = ((int)target->query_skill("parry", 1) + (int)target->query_skill("dodge", 1));
  if (dp < 1) dp = 1;
  skilll = (int)me->query_skill("jienan-zhi", 1);
  myexp = me->query("combat_exp");
  youexp = target->query("combat_exp");
  myunarmed = me->query_skill("unarmed");
  myforce = me->query("force_factor");
  mystr = me->query_str();
  mz = me->query_temp("mingzhong");
  if (mz < 0) mz = 0;
  i = (myexp / dp + random(myexp / dp)) + (myexp / dp + random(myexp / dp)) * mz / 100;
  j = youexp / ap + random(youexp / ap);
  damage = skill + mystr + random(skill + mystr);
  me->add("kee", -100);
  me->add("force", -100);

  message_vision(
    HIY "\n$N" + HIY + "心悟佛法，灵犀所至，缓缓伸出右手食指向$n" + HIY + "凌空一点，一股阳和的气流向$n" + HIY + "直逼过去。\n\n" NOR,
    me,
    target
  );

  if (i > j || target->query_temp("unconcious")) {
    message_vision(
      HIR "只听见「嗤」的一声轻响，$N" + HIR + "右手食指已经在$n" + HIR + "身上戳出一个血窟窿。\n\n" NOR,
      me,
      target
    );
    damage -= target->query_temp("apply/armor_vs_force");
    if (damage < 0) damage = 0;
    target->receive_wound("kee", damage / 2 + random(damage / 2), me);
    target->receive_damage("kee", damage, me);
    if (wizardp(me) && me->query("env/combat") == "verbose")
      tell_object(me, sprintf(HIM + BLINK + "damage: %d\n" NOR, damage));
    COMBAT_D->report_status(target);
    if ((target->query("eff_kee") < 0 || !living(target)) && random(5) == 1) {
      str = target->name() + HIM "被" + me->name() + HIM + "的" + NOR + HIY "灵犀指力" + NOR + HIM "打中死穴，登时七孔流血而死。";
      message("channel:rumor", HIM "【空穴来风】某人：" + str + "\n" NOR, users());
    }
  } else {
    message_vision(HIC "$N" + HIC + "识得厉害，连忙使一个鹞子翻身躲开了！\n" NOR, target);
  }

  me->set_temp("lingxi_end", time());
  me->start_busy(1);
  return 1;
}
