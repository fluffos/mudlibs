//星云锁链
//by lestat 2001五一
//modify for 大唐西游2 by huarong 2003/12

#include <ansi.h>

inherit SSERVER;
int perform(object me, object target)
{
    int damage, lvl, r_lvl, count,skill,skill1, i,damagex;
    string msg;
        if( !target ) target = offensive_target(me);
        
        if( !me->query_skill("hellfire-whip", 1) )
                return notify_fail("你不会星云锁链大法。\n");
        if( !target
                ||      !target->is_character()
                ||      target->is_corpse()
                ||      target==me)
                return notify_fail("你要对谁施展这一招"+HIB+"「星云锁链」"+NOR+"？\n");
        if( skill > 300 ) skill=300;
        if(me->query("family/family_name") != "阎罗地府" )
                return notify_fail("你是哪儿偷学来的武功，也想用"+HIB+"「星云锁链」"+NOR+"?\n");
        if(!me->is_fighting())
                return notify_fail(HIB+"「星云锁链」"+NOR+"只能在战斗中使用！\n");
        if((int)me->query("max_force") < 1000 )
                return notify_fail("你的内力不够！\n");
        if((int)me->query("force") < 1000 )
                return notify_fail("你的内力不足！\n");
        if((int)me->query("sen") < 100 )
                return notify_fail("你的精神不足，没法子施用外功！\n");
        if((int)me->query_skill("hellfire-whip", 1) < 100)
                return notify_fail("你的烈火鞭级别还不够，使用"+HIB+"「星云锁链」"+NOR+"有些力不从心！\n");               
        if (me->query_skill_mapped("force")!="tonsillit")
                return notify_fail("星云锁链必须配合摄气诀才能使用。\n");
        if((int)me->query_skill("tonsillit", 1) < 100)
                return notify_fail("你的摄气诀级别还不够，小心走火入魔！\n"); 
                if( time()-(int)me->query_temp("xingyun_end") < 7 )
                return notify_fail("绝招用多就不灵了！\n"); 
            me->delete("env/brief_message");
            target->delete("env/brief_message");
       me->set_temp("hell_pfm",1);
       skill = (int)me->query_skill("whip", 1);
       skill1 = (int)me->query_skill("hellfire-whip", 1);
        lvl = skill1/50;
        r_lvl=lvl+1;
        if( r_lvl < 3) r_lvl=3 ; 
        if( r_lvl > 7) r_lvl=7;
        count = me->query_str();
        write( HIB "你默运神功，使出星云锁链大法，手中长鞭暴涨,漫天飞舞,瞬间在周身裹成一团星云," + target->name() + "的攻击被尽数挡回。\n"NOR);
        tell_object(target, HIW"忽然，你发现有一股奇怪的力量向你袭来,四周一切似乎已经开始凝结！\n"NOR);
    if (random(me->query("force",1)) > 4*target->query("force",1)/5 )
        {
               target->start_busy(random(3));                
                damage = random(skill/2) + r_lvl*target->query("force_factor",1)/2;
                damage = damage - target->query("armor_vs_force");
                if( damage < 0 ) damage=0;                
                if( damage > me->query("force",1) ) damage = me->query("force",1);
                target->receive_damage("kee", damage,me);
                target->receive_wound("kee", damage/4+random(damage/4),me);
                 if (wizardp(me) && me->query("env/combat")=="verbose")
                   {
                      tell_object(me, sprintf(HIM+BLINK+"damage: %d\n" NOR, damage));
                    }
                me->add("force", -damage);
                msg = CYN "$N"+CYN+"默运神功，使出星云锁链大法。\n"NOR;
                msg += HIB "星云罩将$n"+HIB+"的内力全数反击回去！\n" NOR;    
                if( damage < 100 )
                       msg += HIY"结果$n"+HIY+"受到$N"+HIY+"的内力反震，闷哼一声。\n"NOR;
                  else if( damage < 500 )
                       msg += HIY"结果$n"+HIY+"被$N"+HIY+"以内力反震，「嘿」地一声退了两步。\n"NOR;
                  else if( damage < 1000 )
                       msg += RED"结果$n"+RED+"被$N"+RED+"以内力一震，胸口有如受到一记重锤，连退了五六步！\n"NOR;
                  else
                       msg += HIR"结果$n"+HIR+"被$N"+HIR+"的内力一震，眼前一黑，象一捆稻草一样飞出去好几丈远！\n"NOR;
                message_vision(msg, me, target);
                COMBAT_D->report_status(target);               
        }
     else 
        {
           if((random(me->query("combat_exp",1)) > (int)target->query("combat_exp",1)/4 ))
             {
                tell_object(target, HIG"你周身不畅，似乎有股奇异的力量，将你的出招竟然反了回来击向自己！\n"NOR);
                message("vision", HIW"\n" + target->name() +HIW+"忽然如中魔一般，招招击向自己！\n\n"NOR, environment(me), target);
                for(i = 1; i < r_lvl; i++)
                {
                   damagex=COMBAT_D->do_attack(target, target, target->query_temp("weapon") );
                   if (wizardp(me) && me->query("env/combat")=="verbose")
                         tell_object(me, sprintf(GRN "damage: %d\n" NOR, damagex));
                }
              me->add("force", -200);
              }
            else
             {
              msg = HIY "$n"+HIY+"伸手一指，那股奇异的力量消失了！\n"NOR;
              message_vision(msg, me, target);
             } 
        }
        me->set_temp("xingyun_end",time());
        me->delete_temp("hell_pfm");
        me->start_busy(1+random(2));
        return 1;
}


