//rewrited by huarong 2004/10

//创意所在：
//**********幽冥自有青天  ***********
//msg here
//想我地府之主地藏王菩萨乃是佛界四大菩萨之一，十殿阎王俱是公平无私之人 hellfire-whip
//自天地分明，生灵繁衍，我地府便掌管阴阳，辨尽世间善恶 zhuihun-jian
//千万年来，我地府未曾错判一人，是非善恶尽现黄泉  jinghun-zhang
//世人短浅，空自悲叹，蹉跎岁月，百年之日，止于悲泣 kusang-bang

//damage here
// fire lg xs hyd sanxian  最麻烦
// zhuihun moon
// jinghun psd  比较麻烦
// kusang  fc

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
        object weapon;
	int damage;
	string msg;        
	if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展"+HIB+"「幽冥青天」"+NOR+"？\n");
                
	//if(me->query("family/family_name") != "阎罗地府")
if (!PFM_D->valid_family(me, "阎罗地府"))
                return notify_fail(HIB+"「幽冥青天」"+NOR+"是冥界不传之密！\n");

        if(!me->is_fighting())
                return notify_fail(HIB+"「幽冥青天」"+NOR+"只能在战斗中使用！\n");

        if((int)me->query("force") < 2000 )
                return notify_fail("你的内力不够！\n");
        if((int)me->query("mana") < 2000 )
                return notify_fail("你的法力不够！\n");

             
        if((int)me->query("kee") < 300 )
                return notify_fail("你的气血不足，没法子施用外功！\n");

 	 if((int)me->query_skill("jinghun-zhang", 1) < 250 ||
           (int)me->query_skill("hellfire-whip", 1) < 250 ||
           (int)me->query_skill("zhuihun-sword",1) < 250||
           (int)me->query_skill("gouhunshu",1) < 250||
           (int)me->query_skill("tonsillit",1) < 250||
           (int)me->query_skill("ghost-steps",1) < 250||
           (int)me->query_skill("kusang-bang",1) < 250)
                return notify_fail("你地府的功夫学的不到家，无法使用"+HIB+"「幽冥青天」"+NOR+"!\n");       

 	 if((int)me->query_skill("whip", 1) < 250 ||
           (int)me->query_skill("dodge", 1) < 250 ||
           (int)me->query_skill("stick",1) < 250||
           (int)me->query_skill("unarmed",1) < 250||
           (int)me->query_skill("sword",1) < 250)
                return notify_fail("你的基本功夫学的不到家，无法使用"+HIB+"「幽冥青天」"+NOR+"!\n");       

        if( time()-(int)me->query_temp("ymqt_end") < 10 )
            return notify_fail("此乃地府之精髓所在，用多了就烂了！\n");
            
        message_brief(me, target, "烈火鞭", "「幽冥青天」");
        
        weapon = target->query_temp("weapon");               
        msg=RED"\n$N见$n出手越来越狠，心中不禁有点恼火。。。\n"NOR;
	msg=msg + HIB"\n$N大喝一声：也让你见识一下我地府的绝学！\n\n"NOR;
	message_vision(msg, me, target, 0, "env/brief_perform");
	me->set_temp("ymqt_failed",1);	
	msg=HIR"\n$N诚心念颂：天火、地火、无名业火，以地府众魂之名————\n"NOR;
	msg=HIR+"\n                 "+HIW+"〓"+HIR+" 天诛降临 "+NOR+HIW+"〓\n\n"NOR;
//	msg=HIR+"\n                 "+HIW+"〓"+HIR+BLINK+"天"+NOR+HIW+"〓"+HIR+BLINK+"诛"+NOR+HIW+"〓"+HIR+BLINK+"降"+NOR+HIW+"〓"+HIR+BLINK+"临"+NOR+HIW+"〓\n\n"NOR;
	me->add("mana",-me->query_skill("whip",1));
	if(target->query("family/family_name") == "东海龙宫" && target->query_skill("seashentong",1)>1)
	{
		msg=msg+HIC"\n$n"+HIC+"看着$N"+HIC+"一板正经地颂念咒语，觉得甚是好笑，浑然不把周围的灼热放在眼中。\n"NOR;	
		msg=msg+HIC"$N"+HIC+"颂念完毕，天诛之火由天上地下四面八方降临人世，$n"+HIC+"张口吐出一股水柱，护住了全身。\n"NOR;
		if(random(me->query_skill("whip",1))<target->query_skill("seashentong",1)/5)	
		{
			msg=msg+CYN"天诛之火遇到$n"+NOR+CYN+"周围的水罩，瞬间熄灭，只是蒸腾起袅袅水雾。\n"NOR;
			msg=msg+CYN"$n"+NOR+CYN+"一声龙吟，现出真龙之身，天空立时乌云翻滚，$n"+NOR+CYN+"四周的水罩急剧膨胀。\n";
			msg=msg+CYN"$n"+NOR+CYN+"龙首冲天，狂风立起，天上雷电交加，暴雨倾盆而下，天诛之火尽被熄灭。\n"NOR;
			msg=msg+HIG"$N"+HIG+"眼见天诛被破，心中急怒交加，四周水势乘势而来，$N"+HIG+"抵挡不住，立时被伤。\n"NOR;
			me->add_temp("ymqt_failed",1);
			me->receive_wound("kee",(int)target->query_skill("seashentong",1)/2);
			target->add("force",-(int)target->query_skill("seashentong",1)/2);
			message_vision(msg,me,target, 0, "env/brief_perform");
			COMBAT_D->report_status(me);
		}
		else if(random(me->query_skill("whip",1))<target->query_skill("seashentong",1)/4)
		{
			msg=msg+CYN"天诛之火与$n"+NOR+CYN+"周围的水罩遭遇，水火纠缠相斗，四周雾气蔓延。\n"NOR;
			msg=msg+CYN"$n"+NOR+CYN+"引来的水柱，渐渐被蒸腾损耗，愈见稀薄，$n"+NOR+CYN+"苦苦支撑，略现疲惫。\n";
			msg=msg+CYN"四周雾气随之浓厚，渐渐升腾，于空中渐渐生成散云，竟然也拦住不少天火。\n"NOR;
			msg=msg+CYN"$N见$n"+NOR+CYN+"已经支持不住，难掩心中兴奋。\n"NOR;
			msg=msg+CYN"$n"+NOR+CYN+"长叹一声：天亡我也！正要放弃抵抗，空中一声响雷，大雨瓢泼而下。\n"NOR;
			msg=msg+HIG"$N"+HIG+"立于雨中，怔怔发呆：难道真是天不佑我？$n"+HIG+"却是欢呼雀跃，接雨而饮。\n"NOR;
			target->add("force",-target->query_skill("seashentong",1));
			message_vision(msg,me,target, 0, "env/brief_perform");
		}
		else
		{
			msg=msg+CYN"天诛之火疾速冲向$n"+NOR+CYN+"，以毁灭万物的气势凝聚。\n"NOR;
			msg=msg+CYN"天诛之火还没触及$n"+NOR+CYN+"的水罩，水罩便已经开始蒸腾。\n";
			msg=msg+CYN"$n"+NOR+CYN+"眼见天诛之火声势浩大，远不是自己所能抵挡，正要念动咒语，天诛之火已经到了身前。\n"NOR;
			msg=msg+CYN"水罩在天诛之火冲击之下一触即溃，$n"+NOR+CYN+"仓促间现出真龙之身。\n"NOR;
			msg=msg+HIR"$N"+HIR+"冷笑一声，只见$n"+HIR+"在火中翻腾，天诛之火实是霸道非常，真龙之身也无法免受伤害。\n"NOR;
			message_vision(msg,me,target, 0, "env/brief_perform");
			target->add("force",-target->query_skill("seashentong",1));
			target->receive_wound("kee",me->query_skill("whip",1));
			COMBAT_D->report_status(target);	
		}
	}
	else if(target->query("family/family_name") == "大雪山" && target->query_skill("ningxie-force",1)>1 && target->query_skill("bingpo-blade",1)>1)
	{
		msg=msg+CYN"\n$n"+NOR+CYN+"看着$N"+NOR+CYN+"一脸肃穆地颂念咒语，连忙也唧唧喳喳说了一通鸟语。\n"NOR;	
		msg=msg+CYN"$N"+NOR+CYN+"颂念完毕，天诛之火由天上地下四面八方降临人世。\n"NOR;
		msg=msg+HIW"$n"+HIW+"张口向着手中冰刀吐了一口寒气，冰刀在空中顺势劈斩了几下。\n"NOR;
		msg=msg+HIW"寒风于刀势之间呼啸而生，刹那间冬临大地！\n"NOR;
		target->add("mana",-(int)(target->query_skill("ningxie-force",1)+target->query_skill("bingpo-blade",1))/2);
		if(random(me->query_skill("whip",1))<(target->query_skill("ningxie-force",1)+target->query_skill("bingpo-blade",1))/7)	
		{
			msg=msg+WHT"$n"+NOR+WHT+"心念雪山峰亘古寒冰，不留一丝人情，手中冰刀合着冰谷凝血功的内力将周围变成一片冰天雪地！\n"NOR;
			msg=msg+WHT"大地上的冰层，将地火覆盖，冰火交织之间寒冰升华，地火渐渐冷却$N的脸色也越来越白。\n"NOR;
			msg=msg+WHT"寒风穿梭于朵朵天火之间，将升华的水汽重新凝结，瞬间将天火封闭。\n"NOR;
			msg=msg+WHT"朵朵丹心冰莲自天坠落，落地之时清脆有声！\n"NOR;
			msg=msg+HIG"$N"+HIG+"只觉自己的心随着那声音振动，仿佛要脱离躯体一般，声音珠连不断，$N"+HIG+"压抑不住，七窍渐渐渗出了血丝！\n"NOR;
			me->add_temp("ymqt_failed",1);
			me->receive_wound("kee",(int)target->query_skill("ningxie-force",1)/3+random(target->query_skill("bingpo-blade",1)/3));
			message_vision(msg,me,target, 0, "env/brief_perform");
			COMBAT_D->report_status(me);
		}
		else
		{
			msg=msg+WHT"$n"+NOR+WHT+"冷冷看着天上地下绽放开来的火花，提聚冰谷凝血功，手中冰刀待势而发！\n"NOR;	
			msg=msg+WHT"冰刀散发的寒气，渐渐将空气凝结，$n"+NOR+WHT+"轻轻挥手，淡淡的刀光波浪般荡漾蔓延开去！\n"NOR;
			msg=msg+WHT"$n"+NOR+WHT+"如以往凝视着苍白梦境般的刀光，一朵朵火花在刀光中熄灭，只留下一抹残红！\n"NOR;
			msg=msg+WHT"$n"+NOR+WHT+"看着无数鲜艳却不停淡去的残红，就像无数曾经鲜活却在自己手中沉寂的生命！\n"NOR;
			msg=msg+WHT"$n"+NOR+WHT+"心中没来由的闪过一句老话：江湖风雨催人老！$n"+NOR+WHT+"的刀依然冰冷，心却老了。\n"NOR;
			msg=msg+HIR"一朵亮丽的火花冲入$n"+HIR+"的视线将$n"+HIR+"惊醒，$n"+HIR+"却发现自己被千万朵火花淹没。\n"NOR;
			target->receive_wound("sen",me->query_skill("whip",1));
			target->receive_wound("kee",me->query_skill("whip",1));
			message_vision(msg,me,target, 0, "env/brief_perform");
			COMBAT_D->report_status(target);
			COMBAT_D->report_sen_status(target);
		}
	}
	else if(target->query("family/family_name") == "火云洞" && target->query_skill("huomoforce",1)>1)
	{
		msg=msg+RED"\n$n"+NOR+RED+"看着$N"+NOR+RED+"一脸肃穆地颂念咒语，猖狂地大喊：想玩火？你还差得远呢！\n"NOR;	
		msg=msg+RED"$N"+NOR+RED+"颂念完毕，天诛之火由天上地下四面八方降临人世。\n"NOR;
		msg=msg+RED"$n"+NOR+RED+"一声牛哼，摇了摇脑袋，按住鼻子张口吐出了红橙黄三道魔火。\n"NOR;
		if(random(me->query_skill("whip",1))<target->query_skill("huomoforce",1)/3)
		{
			msg=msg+HIR"天诛与$n"+HIR+"的三味魔火竟然互不冲突，两人防备不及被对方的火焰烧了个焦头烂额！\n"NOR;
			target->receive_wound("kee",me->query_skill("whip",1));
			me->receive_wound("kee",target->query_skill("huomoforce",1));
			message_vision(msg,me,target, 0, "env/brief_perform");
			COMBAT_D->report_status(target);
			COMBAT_D->report_status(me);
		}
		else
		{
			msg=msg+RED"$n刚刚吐出魔火，突然觉得心思杂乱，原来$n"+NOR+RED+"一时张狂，竟被业火乘隙而入！\n"NOR;
			msg=msg+RED"魔火没了主人的法力支持，还没到$N"+NOR+RED+"身前，便散落四处，不成气候了！\n"NOR;
			msg=msg+HIR"$n"+HIR+"气的哇哇大叫，却也无法抵挡来自天地人心的天诛！\n"NOR;
			target->receive_wound("sen",me->query_skill("whip",1));
			target->receive_wound("kee",me->query_skill("whip",1));
			message_vision(msg,me,target, 0, "env/brief_perform");
			COMBAT_D->report_status(target);
			COMBAT_D->report_sen_status(target);
		}		
	}
	else if(target->query("family/family_name") == "三界散仙" && target->query_skill("ice_fire_zhang",1)>1)
	{
		msg=msg+HIC"\n$N"+HIC+"颂念完毕，天诛之火由天上地下四面八方降临人世。\n"NOR;
		msg=msg+HIC"$n"+HIC+"看到$N"+HIC+"召唤出了仙界之火，连忙运起悟于冰火相生相克的内力。\n"NOR;	
		msg=msg+HIR"$n"+HIR+"虽能将天诛中的业火化为己用，却也无法抵挡其余天地二火。\n"NOR;	
		target->receive_wound("kee",me->query_skill("whip",1)*2/3);
		target->add("force",me->query_skill("whip",1)/3);//别过了2倍
		if(target->query("max_force")<target->query("force")/2) target->set("force",target->query("max_force")*2);
		message_vision(msg,me,target, 0, "env/brief_perform");
		COMBAT_D->report_status(target);
	}
	else
	{
//		target->add("force",-target->query_skill("force",1));
		msg=msg+CYN"\n$N"+NOR+CYN+"颂念完毕，天诛之火由天上地下四面八方降临人世。\n"NOR;
		msg=msg+HIR"$n"+HIR+"亲眼看到传说中的天诛地灭，忆及今世往生的所作所为，一时感慨万千呆立当地。\n"NOR;
		target->receive_damage("sen",me->query_skill("whip",1)/3);
		msg=msg+CYN"汹涌的天诛瞬间汇聚在$n"+NOR+CYN+"的四周，出乎$n"+NOR+CYN+"的意料，天诛并没有展开攻击，而是在以一种奇怪的规律融合衍化。\n"NOR;
		if(random(me->query_skill("whip",1))<target->query_skill("force",1)/4)
		{
			msg=msg+CYN"$n"+NOR+CYN+"渐渐的感觉到天诛传来一种遥远却略带亲切的呼唤。\n"NOR;
			msg=msg+CYN"$n"+NOR+CYN+"惊奇的看着四周的天诛，那种朦胧的亲切越发明显了。\n"NOR;
			msg=msg+CYN"$n"+NOR+CYN+"不自觉的向天诛挥挥手，心中竟生离别之意，耳边亦是响起声声道别之语。\n"NOR;
			msg=msg+CYN"别声远去，$n"+NOR+CYN+"正心中感慨，忽然发现天诛亦随别声消散。\n"NOR;
			msg=msg+CYN"$n"+NOR+CYN+"这才醒悟自己正在与$N"+NOR+CYN+"对战，慌忙四处搜寻$N"+NOR+CYN+"，却发现$N"+NOR+CYN+"面带微笑，正在不远处旁观。\n"NOR;
			msg=msg+HIY"$N"+HIY+"沉声说道：有心为善，虽善不赏！先生为真善之人，今日先生至亲之人已借天诛转世，可喜可贺！\n"NOR;
			message_vision(msg,me,target, 0, "env/brief_perform");
		}
		else
		{
			msg=msg+CYN"$n"+NOR+CYN+"忽然听到天诛之中传来声声厉啸，天诛幻化之形张牙舞爪，直欲扑向自己，心中不由更是慌乱。\n"NOR;
			msg=msg+CYN"天诛声像越来越是凄厉，令$n"+NOR+CYN+"想起黑夜噩梦中索魂厉鬼，一时胆战心惊，双手胡乱挥舞，要将厉鬼驱赶开去。\n"NOR;
			msg=msg+CYN"四周阴影重重挥之不尽，声声厉啸不绝于耳，$n"+NOR+CYN+"渐渐被淹没其中，只是不时传出一声惨叫。\n"NOR;
			msg=msg+CYN"待到天诛散尽，$n"+NOR+CYN+"已是满身鲜血，精神恍惚。$N"+NOR+CYN+"冷哼一声，$n"+NOR+CYN+"这才醒觉，抬起头愤恨的盯着$N"+NOR+CYN+"。\n"NOR;
			msg=msg+HIR"$N"+HIR+"沉声说道：无心为恶，虽恶不罚！你却是大奸大恶之人，今日幽魂为天诛所招齐来复仇，正是你报应之日！\n"NOR;
			target->receive_wound("kee",me->query_skill("whip",1));
			message_vision(msg,me,target, 0, "env/brief_perform");
			COMBAT_D->report_status(target);
		}
	}

	if( me->query_temp("ymqt_failed") < 2 )
	{
		me->add("force",-me->query_skill("sword",1),1);
		msg=BLU"\n$N"+NOR+BLU+"脸上突然现出一股鬼气，森然道：我地府掌管阴阳，明辨善恶，有追魂夺魄之法，今日也让你见识一下！\n"NOR;		
		msg=msg+BLU"$N"+NOR+BLU+"挽住了长鞭，随手抽出腰间长剑，将一套"+HIR+"「追魂剑法」"+NOR+BLU+"施展出来。\n"NOR;
		msg=msg+BLU"$N"+NOR+BLU+"将"+HIR+"「追魂剑法」"+NOR+BLU+"发挥的淋漓尽致，那股鬼气也随着剑气蔓延。\n"NOR;
		if(target->query("family/family_name") == "月宫" && target->query_skill("moondance",1)>1 && target->query_skill("snowsword",1)>1)
		{
			msg=msg+BLU"$N"+NOR+BLU+"的剑气将四周搞的鬼气森然，长剑幽光层起，$n"+NOR+BLU+"却竟自踏着自己的步法，不将$N"+NOR+BLU+"放在眼中。\n"NOR;
			msg=msg+MAG+"$n广袖轻挥，樱唇轻启，竟合着"+HIM+"「冷月凝香舞」"+NOR+MAG+"的步法唱起了小曲！\n"NOR;
			if(random(me->query_skill("sword",1))<(int)(target->query_skill("moondance",1)+target->query_skill("snowsword",1))/7)
			{
				msg=msg+MAG"$n"+NOR+MAG+"看来虽是悠闲自在，漫不经心，$N"+NOR+MAG+"却发现自己辛辛苦苦布下的追魂结界被$n"+NOR+MAG+"轻松破去！\n"NOR;
				msg=msg+MAG"$n"+NOR+MAG+"舞姿曼妙，歌声娇柔无邪，$N"+NOR+MAG+"不由自主去细听那曲子。\n"NOR;
				msg=msg+MAG"但听$n"+NOR+MAG+"唱道："+HIM+"\n\t采莲人语隔秋烟，波静如横练。\n\t入手风光莫流转，共留连，画船一笑春风面。\n\t江山信美，终非吾土，问何日是归年？\n"NOR;
				msg=msg+MAG"$N"+NOR+MAG+"感受到曲中那淡淡的的伤感，想象荷花凋谢，莲蓬孤零零的立于莲梗之上的萧瑟秋景，心已醉倒在$n"+NOR+MAG+"的歌舞之中。\n"NOR;
				msg=msg+HIR"$n"+HIR+"舞到曲尽广袖平展，一股风回雪舞冰寒剑气直刺向$N"+HIR+"，$N"+HIR+"恍然惊醒，待要回剑招架，为时已晚！\n"NOR;
				message_vision(msg,me,target, 0, "env/brief_perform");
				target->add("force",-(int)(target->query_skill("moondance",1)+target->query_skill("snowsword",1))/2);
				me->receive_wound("kee",target->query_skill("snowsword",1));
				me->receive_wound("sen",target->query_skill("moondance",1));
				COMBAT_D->report_status(me);
				COMBAT_D->report_sen_status(me);
				me->add_temp("ymqt_failed",1);
			}
			else
			{
				msg=msg+MAG"$n"+NOR+MAG+"看来虽是悠闲自在，漫不经心，但"+HIM+"「冷月凝香舞」"+NOR+MAG+"毕竟是仙界之舞，\n$n"+NOR+MAG+"歌声亦是空灵剔透，立时将四周的鬼气冲淡了许多！\n"NOR;
				msg=msg+MAG"$n"+NOR+MAG+"舞姿曼妙，歌声娇柔无邪，$N"+NOR+MAG+"放缓了剑招，凝神去听那曲子。\n"NOR;
				msg=msg+MAG"但听$n"+NOR+MAG+"唱道："+HIM+"\n\t采莲人语隔秋烟，波静如横练。\n\t入手风光莫流转，共留连，画船一笑春风面。\n\t江山信美，终非吾土，问何日是归年？\n"NOR;
				msg=msg+MAG"$N"+NOR+MAG+"感受到曲中那淡淡的的伤感，念到：枉$n"+NOR+MAG+"亦是仙界中人，竟悟不透贪嗔妄痴，爱恨情仇！\n"NOR;
				msg=msg+HIW"$n"+HIW+"舞曲将尽，$N"+HIW+"奇招忽出，凭空刺出一剑，长剑所指正是$n"+HIW+"最后一步落足之处！\n"NOR;
				msg=msg+HIR"$n"+HIR+"心神微乱，眼前景物突然变化，$n"+HIR+"又见月宫莲湖，小舟一叶，轻愁采莲人！\n"NOR;
				message_vision(msg,me,target, 0, "env/brief_perform");
				target->add("force",-(int)(target->query_skill("moondance",1)+target->query_skill("snowsword",1))/4);
				target->receive_wound("kee",me->query_skill("sword",1));
				target->receive_wound("sen",me->query_skill("sword",1));
				COMBAT_D->report_status(target);
				COMBAT_D->report_sen_status(target);
			}
		}
		else
		{
			msg=msg+BLU"$N"+NOR+BLU+"的剑气将四周搞的鬼气森然，长剑幽光层起，尽显"+HIR+"「追魂剑法」"+NOR+BLU+"奇、快二决精妙。\n"NOR;
			msg=msg+BLU"$n"+NOR+BLU+"凝神迎战，见招拆招，小心翼翼不敢有丝毫马虎。\n"NOR;
			msg=msg+WHT+"四周鬼气渐重，$n"+NOR+WHT+"觉得$N"+NOR+WHT+"似乎融入鬼气之中，身形渐渐模糊，无法辨认。\n"NOR;
			target->add("force",-target->query_skill("parry",1));
			if(random(me->query_skill("sword",1))<target->query_skill("parry",1)/4)
			{
				msg=msg+BLU"$n"+NOR+BLU+"心神不为幻象所乱，神定则气闲，$n"+NOR+BLU+"感应四周剑气，虽目不能见，心中却一切洞明。\n"NOR;
				msg=msg+BLU"$N"+NOR+BLU+"见$n"+NOR+BLU+"根基稳固，幽冥鬼气竟然不能侵蚀$n"+NOR+BLU+"的魂魄，心中甚是佩服。\n"NOR;
				msg=msg+BLU"$N"+NOR+BLU+"心念一转，招随意变，竟将"+HIR+"「追魂剑法」"+NOR+BLU+"使的力重招慢，$n"+NOR+BLU+"心中惊叹，越发凝神应战。\n"NOR;
				msg=msg+BLU"$N"+NOR+BLU+"与$n"+NOR+BLU+"又战了一会，两人互相钦佩，不约而同停下了招数，相视大笑！\n"NOR;
				msg=msg+BLU"$N"+NOR+BLU+"长剑一摆幽幽鬼气顷刻间四散而去，立刻拱手道：先生根基稳固，心志坚定，乃是大道之才！\n"NOR;
				if(me->query("gender")=="男性") msg=msg+HIG"$n"+HIG+"一声长笑，说道：兄台不拘陈规，因势制宜，确是鬼才！\n"NOR;
				if(me->query("gender")=="女性") msg=msg+HIG"$n"+HIG+"一声长笑，说道：姑娘不拘陈规，才华横溢，在下佩服！\n"NOR;
				message_vision(msg,me,target, 0, "env/brief_perform");
			}
			else
			{
				msg=msg+BLU"$n"+NOR+BLU+"不见了$N"+NOR+BLU+"的身形，心神微乱，越发小心应战。\n"NOR;
				msg=msg+BLU"四周鬼气渐重，冷气森然，$n"+NOR+BLU+"渐觉手脚发凉，一股冷风扑面而来，$n"+NOR+BLU+"忍不住打了一个冷战。\n"NOR;
				msg=msg+BLU"$n"+NOR+BLU+"越战越是心寒，身体四肢受寒气影响逐渐微感麻木冰凉。\n"NOR;
				msg=msg+HIR"突然间，幽光层起尽指$n"+HIR+"要害，$n"+HIR+"手脚不便，立时中了数剑。\n"NOR;
				msg=msg+BLU"$n"+NOR+BLU+"再勉强躲过数招，幽光渐落，四周逐渐清明，$n"+NOR+BLU+"依然四肢麻木，此时见得光亮，终于松了一口气。\n"NOR;
				msg=msg+BLU"$N"+NOR+BLU+"现出身形，冷笑道：鬼气蚀魂，阎王夺魄。\n"NOR;
				msg=msg+HIR"$n"+HIR+"听得$N"+HIR+"阴森鬼话，暗中运气查看，这才发觉自己三魂六魄略感阴寒。\n"NOR;
				message_vision(msg,me,target, 0, "env/brief_perform");
				target->receive_wound("kee",me->query_skill("sword",1));
				COMBAT_D->report_status(target);
			}
		}
	}
	
	if( me->query_temp("ymqt_failed") < 2 )
	{
		msg=HIB"\n$N"+HIB+"收回长剑，口中鬼唱一声，双掌虚晃，掌影由二变四，由四生八，一会儿功夫就将$n"+HIB+"包裹在重重鬼影当中。\n"NOR;		
		msg=msg+HIB"$n"+HIB+"心神振动，只觉四周尽是幽魂恶鬼，无数鬼手仿佛要将自己的身体魂魄撕裂。\n"NOR;
		msg=msg+HIB"$N"+HIB+"摄气决急速运转，掌心渐呈碧绿，用的正是幽冥绝学"+HIC+"「惊魂掌」"+HIG+"。\n"NOR;
		msg=msg+HIB"$n"+HIB+"镇定心神，身形有如弱柳扶风，于重重鬼影中飘忽穿梭。\n"NOR;
		msg=msg+HIB"$N"+HIB+"见$n"+HIB+"一味的躲避，默念道："+NOR+WHT+"世事无常，死生无常。"+HIB+"双掌一错，招式也变得飘忽无常。\n"NOR;
		me->add("mana",-me->query_skill("unarmed",1));
		if(target->query("family/family_name") == "盘丝洞" && target->query_skill("pansi-dafa",1)>1)
		{
			msg=msg+MAG"$n与$N"+NOR+MAG+"战到酣处，索性闭了双眼，默运起盘丝大法将无上念力化作无形丝线，\n"NOR;
			msg=msg+MAG"然后四散诸周围，纵横交错间织就一张大网，通过念力感知着网内的一切变化。\n"NOR;
			msg=msg+MAG"$N见$n"+NOR+MAG+"竟然闭着眼睛和自己战斗，心中不快，却也不做声色，只是暗中加力，出手越来越狠。\n"NOR;
			msg=msg+MAG"$N暗中观察$n"+NOR+MAG+"的招数，冷不防凌空跃起落在$n身前，双掌凝重缓缓向$n"+NOR+MAG+"拍出。\n"NOR;
			msg=msg+WHT"$N觉得这招"+HIB+"「饿鬼拦路」"+NOR+WHT+"用的恰到好处，力在招前，等$n发现已是无法闪避了。\n"NOR;
			if(random(me->query_skill("unarmed",1))<target->query_skill("pansi-dafa",1)/5)
			{
				msg=msg+MAG"$N"+NOR+MAG+"正暗自得意，忽然耳边听到一声轻笑，心中大骇，欲要收招，为时已晚。\n"NOR;
				msg=msg+MAG"只听见“碰”的一声，$N"+NOR+MAG+"双掌已经重重击在$n"+NOR+MAG+"的身上。\n"NOR;
				msg=msg+MAG"$N觉得双掌仿佛击在了一座大山之上，手腕疼痛欲折，定睛看去，身前却是一座五指大山。\n"NOR;
				msg=msg+MAG"原来$n"+NOR+MAG+"已经将盘丝大法练到了随心所欲的境界，在将被击中的瞬间招来五指山替换了自己的本身。\n"NOR;
				msg=msg+HIG"$n"+HIG+"笑盈盈的站在一边想看$N"+HIG+"呲牙咧嘴的样子，不想$N"+HIG+"虽然疼痛竟然不露一点痕迹，$n"+HIG+"心下也有点佩服。\n"NOR;
				message_vision(msg,me,target, 0, "env/brief_perform");
				target->add("mana",-me->query_skill("unarmed",1));
				me->receive_wound("kee",target->query_skill("pansi-dafa",1));
				COMBAT_D->report_status(me);
				me->add_temp("ymqt_failed",1);
			}
			else if(random(me->query_skill("unarmed",1))<target->query_skill("pansi-dafa",1)/4) 
			{
				msg=msg+MAG"$N"+NOR+MAG+"心中得意，终于抓住了$n"+NOR+MAG+"的破绽，眼看这招就要实实在在的击在$n"+NOR+MAG+"的身上了。\n"NOR;
				msg=msg+MAG"$N"+NOR+MAG+"的双掌终于接触到了$n"+NOR+MAG+"的身子，正要吐劲将$n"+NOR+MAG+"震飞，$n"+NOR+MAG+"身边忽然生出一股柔和之极的劲力。\n"NOR;
				msg=msg+MAG"$N"+NOR+MAG+"觉得双掌仿佛击在一团棉花之上，虽有万斤气力却也无处可使，又纠缠了一会，$N"+NOR+MAG+"的劲力就被化解的一干二净了。\n"NOR;
				msg=msg+MAG"原来$n"+NOR+MAG+"已将盘丝大法练到了收发随心的境界，瞬间将四散的网聚在身前，以柔克刚，化解了$N"+NOR+MAG+"的攻势。\n"NOR;
				msg=msg+HIM"$N"+HIM+"又费了一会的功夫才将双掌从$n"+HIM+"的柔劲中解放出来，$N"+HIM+"不由心中惊骇盘丝洞武功的精妙。\n"NOR;
				message_vision(msg,me,target, 0, "env/brief_perform");
				me->add("force",-target->query_skill("pansi-dafa",1)/2);
				target->add("force",-me->query_skill("unarmed",1));
			}
			else
			{
				msg=msg+MAG"$N"+NOR+MAG+"心中得意，终于抓住了$n"+NOR+MAG+"的破绽，这一招出其不意，攻其不备，暗合兵法要义。\n"NOR;
				msg=msg+MAG"$N"+NOR+MAG+"双掌未到，$n"+NOR+MAG+"已经觉到一股强大的劲风扑面而来，呼吸竟然也被压的一滞，$n"+NOR+MAG+"连忙将四散的网收到身前防护。\n"NOR;
				msg=msg+MAG"只听见“碰”的一声，$N的双掌已经重重击在$n"+NOR+MAG+"的身上，隐约听见“「喀」”地一声爆响，$n"+NOR+MAG+"已经远远飞了出去。\n"NOR;
				msg=msg+MAG"原来$n"+NOR+MAG+"虽然有柔劲护体，可是$N"+NOR+MAG+"的掌力过于集中，直接穿透了$n"+NOR+MAG+"的护身真气，将$n"+NOR+MAG+"击飞。\n"NOR;
				msg=msg+HIR"$n"+HIR+"空中一个翻身落在地上，却一个不稳差点坐在地上，看样子也不知道断了几根骨头。\n"NOR;
				message_vision(msg,me,target, 0, "env/brief_perform");
				target->receive_wound("kee",me->query_skill("unarmed",1));
				COMBAT_D->report_status(target);
				target->add("force",-target->query_skill("pansi-dafa",1));
			}
		}
		else
		{
			msg=msg+HIB"$n"+HIB+"踏着步法，小心翼翼的躲避着$N"+HIB+"的鬼爪，一时想不出什么脱身之策。\n"NOR;
			msg=msg+HIB"$N"+HIB+"功力渐盛，掌心生出一股吸力，$n"+HIB+"每与其擦身而过，都隐隐觉得魂魄惊颤，心想这掌法果真不负惊魂之名。\n"NOR;
			msg=msg+WHT"$n"+NOR+WHT+"觉得那股吸力越来越强，生怕自己魂魄被逼出体外，默念几句咒语，将魂魄用法力小心护住。\n"NOR;
			target->add("mana",-target->query_skill("spells",1)/3);
			msg=msg+HIB"$n"+HIB+"这才有机会凝神细察$N"+HIB+"的招数。\n"NOR;
			if(random(me->query_skill("unarmed",1))<target->query_skill("dodge",1)/4)
			{
				msg=msg+HIB"$n"+HIB+"初时觉得$N"+HIB+"掌法中鬼影重重，总看的似是而非，多看了会儿也看出了一些门道。\n"NOR;
				msg=msg+HIB"$n"+HIB+"忽然觉得$N"+HIB+"的招数有点熟悉，细看下原来$N"+HIB+"掌法用完一遍，又从第一招开始了。\n"NOR;
				msg=msg+HIG"$N"+HIG+"招数又走完一遍，刚要变招从头再来，却见$n"+HIG+"面带微笑脚下连续踏出几个奇步，已经走出了$N"+HIG+"掌力的范围。\n"NOR;
				message_vision(msg,me,target, 0, "env/brief_perform");
				target->add("force",-target->query_skill("dodge",1)/2);
			}
			else
			{
				msg=msg+HIB"$n"+HIB+"觉得$N"+HIB+"掌法中鬼影重重，看的有点头晕，$n"+HIB+"再多看了会儿竟也看出了一些门道。\n"NOR;
				msg=msg+HIB"$N"+HIB+"掌法用完一遍，又从头出招，$n"+HIB+"觉的$N"+HIB+"你招数有点熟悉，嘴角露出了一丝笑容。\n"NOR;
				msg=msg+HIB"$n"+HIB+"又耐心和$N"+HIB+"战了一会，这时见$N"+HIB+"身子微斜，随即就要跨出一步，$n"+HIB+"识的这招叫做"+HIC+"「群魔乱舞」"+HIB+"。\n"NOR;
				msg=msg+HIB"$n"+HIB+"颇为自信的按照预计踏出了一步，却发现$N"+HIB+"倏地跨步变作一个转身，双手往脸上一抹，一股阴风直扑$n"+HIB+"。\n"NOR;
				msg=msg+HIR"“碰”的一声$n"+HIR+"远远飞了出去！$n正是中了$N"+HIR+"的"+HIC+"「青面缭牙」"+HIR+"。\n"NOR;
				message_vision(msg,me,target, 0, "env/brief_perform");
				target->receive_wound("kee",me->query_skill("unarmed",1));
				COMBAT_D->report_status(target);
				target->add("force",-target->query_skill("dodge",1));
			}
		}
	}
	if( me->query_temp("ymqt_failed") < 2 )
	{
		me->add("force",-me->query_skill("stick",1));
		msg=YEL"\n$N"+NOR+YEL+"慢慢说道：世人畏惧死亡因而怕我地府，百年之时，亲朋悲泣，我地府因此创有一套棒法，还请指教。\n"NOR;
		msg=msg+YEL"说着，$N"+NOR+YEL+"手中便多了一根长棍，$n"+NOR+YEL+"立时觉得一股无法抗拒的悲伤爬上心头。\n"NOR;
		msg=msg+YEL"$n"+NOR+YEL+"连忙深吸了口气，将悲伤的思绪呼出。\n"NOR;
		msg=msg+YEL"$N"+NOR+YEL+"见上来第一招就被$n"+NOR+YEL+"轻松化解了，长棍一摆便和$n"+NOR+YEL+"战在了一起。\n"NOR;
		msg=msg+YEL"$N"+NOR+YEL+"棒法诡异绝伦，招式之间带着人间千百年对死亡的恐惧气息，和对亲人亡去的悲伤之情。\n"NOR;
		if(target->query("family/family_name") == "方寸山三星洞" && target->query_skill("qianjun-bang",1)>1)//应该判断使用stick
		{
			msg=msg+HIG"$n"+HIG+"将千钧棒法展开，招式大开大合，气势磅礴，颇有猴王当年气概。\n"NOR;
			target->add("force",-target->query_skill("qianjun-bang",1));
			if(random(me->query_skill("stick",1))<target->query_skill("qianjun-bang")/4)
			{
				msg=msg+HIG"\n$N"+HIG+"看着$n"+HIG+"舞动棒子的姿态，俨然就是五百年前大闹天宫的情景："+HIY+"\n\t金猴奋起千钧棒，玉宇澄清万里埃。\n"NOR;
				msg=msg+HIG"$n"+HIG+"一声清啸，手中兵器如游龙般翱翔青宇，向$N"+HIG+"当胸破空射来！\n"NOR;
				msg=msg+HIG"$n"+HIG+"声势刚烈"+NOR+MAG+"－－"+HIM+"风萧萧兮易水寒，壮士一去兮不复还"+NOR+MAG+"－－\n"NOR;
				msg=msg+HIG"$N"+HIG+"为$n"+HIG+"气势所迫竟然举步为艰，勉强闪避一侧，依然被砸中了左肩。\n"NOR;
				message_vision(msg,me,target, 0, "env/brief_perform");
				me->receive_wound("kee",target->query_skill("qianjun-bang",1));
				COMBAT_D->report_status(me);
				me->add_temp("ymqt_failed",2);
			}
			else
			{
				msg=msg+HIG"$N"+HIG+"看着$n"+HIG+"舞动棒子的姿态，竟然有点五百年前大闹天宫的美猴王的模样。\n"NOR;
				msg=msg+HIG"$N"+HIG+"沉声问道：难道你是那五百年前大闹罗森，强销名号的孙猴子的同门？\n"NOR;
				msg=msg+HIG"$n"+HIG+"应到：不错，既然知道，还敢在俺面前卖弄棒法，简直自不量力！\n"NOR;
				msg=msg+HIG"$N"+HIG+"冷哼一声：不知你盘龙八式悟出了几式，就这么张狂？\n"NOR;
				msg=msg+HIG"$n"+HIG+"听到盘龙八式的名字，不禁一呆，五百年前美猴王就是靠着这八式棒法横扫三界。五百年来再无人能够领悟！\n"NOR;
				msg=msg+HIG"$N"+HIG+"趁势使出全力,一股冰冷的死亡气息将$n"+HIG+"紧紧围住,四周生灵亦在这股气息之下悲鸣呜咽。\n"NOR;
				if(target->query("gender")=="男性") msg=msg+HIW"$n"+HIW+"依稀看到至亲之人正在自己眼前逝去,任凭自己武功无敌也无法阻挡死亡半步,待伸手去抓,\n却是魂飞缥缈,$n"+HIW+"虎目含泪,想要大声喊叫,却发不出一丝声音。\n"NOR;
				if(target->query("gender")=="女性") msg=msg+HIM"$n"+HIM+"依稀看到至爱之人正在自己眼前逝去,任凭自己法力无边也无法阻挡死亡半步,待伸手去抓,\n却是镜花四散,$n"+HIM+"本已珠泪盈眶,终于忍不住掩面哭泣。\n"NOR;
				msg=msg+HIR"$N"+HIR+"见$n"+HIR+"渐入魔道,心中不忍,做狮子吼:咄!皆悉同见诸欲境界无量过患，心得清净!$n"+HIR+"如醍醐灌顶,幻象冰消水逝。\n"NOR;
				message_vision(msg,me,target, 0, "env/brief_perform");
				target->receive_wound("kee",me->query_skill("stick",1));
				target->receive_wound("sen",me->query_skill("stick",1));
				COMBAT_D->report_status(target);
				COMBAT_D->report_sen_status(target);
			}
		}
		else
		{
			msg=msg+YEL"$n"+NOR+YEL+"运转法力抵挡着心头的那股恐惧和悲伤,手中也不慢,招式如风与$N"+NOR+YEL+"攻的攻,守的守战的不亦乐乎。\n"NOR;
			msg=msg+YEL"$N"+NOR+YEL+"淋漓尽致的发挥着哭丧棒中来自地狱的死亡和来自人心的悲伤之意。\n"NOR;
			msg=msg+WHT"$n"+NOR+WHT+"虽然修为高深却还没有跳出三界,渐渐抵挡不住棒法中的意,一时间七情上面。\n"NOR;
			target->add("force",-target->query_skill("spells",1)/2);
			target->add("mana",-target->query_skill("spells",1)/2);
			if(random(me->query_skill("stick",1))<target->query_skill("spells",1)/4)
			{
				msg=msg+YEL"$N"+NOR+YEL+"看着$n"+NOR+YEL+"的样子没来由的想起多少年前亲人离去自己亦是如此悲伤,百年之时同样颤颤而惊。\n"NOR;
				msg=msg+YEL"$N"+NOR+YEL+"再想到自己在地府勤修苦练才有此成就,其中艰辛更是非世间人所能明了。\n"NOR;
				msg=msg+HIG"$N"+HIG+"想：地藏菩萨曾发下宏愿：“地狱不空，誓不成佛；众生度尽，方证菩提!” 我又怎忍心地府再添新鬼。\n"NOR;
				message_vision(msg,me,target, 0, "env/brief_perform");
			}
			else
			{
				msg=msg+HIR"$N"+HIR+"见$n"+HIR+"时悲时喜时忧时惊,招数逐渐散漫,恐再过一会于$n"+HIR+"修为大有损伤。\n"NOR;
				msg=msg+HIR"$N"+HIR+"缓了手中招数,$n"+HIR+"四周压力骤减,$n"+HIR+"连忙运气调理自己紊乱的经脉。\n"NOR;
				message_vision(msg,me,target, 0, "env/brief_perform");
				target->add("force",-target->query_skill("force",1)/2);
				target->receive_wound("kee",me->query_skill("stick",1));
				target->receive_wound("sen",me->query_skill("stick",1));
				COMBAT_D->report_status(target);
				COMBAT_D->report_sen_status(target);
			}
		}
	}
	if(me->query_temp("ymqt_failed")==2)
	{
		message_vision(HIB"\n$N"+HIB+"受此重创，已经无力施展「幽冥青天」剩余的招数了！\n"NOR,me,target);
	}
	if(me->query_temp("ymqt_failed")==3)
	{
		message_vision(HIG"\n$N"+HIG+"无奈喝一声：不想五百年后方寸山三星洞又出了如此高人，果真人杰地灵！\n"NOR,me,target);
	}
	me->delete_temp("ymqt_failed");
        me->start_busy(1+random(1));
        me->set_temp("ymqt_end",time());
	return 1;
}
