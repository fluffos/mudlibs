//Cracked by Roath
//modify for 大唐西游2 by huarong 2003/12

#include <ansi.h>
 
inherit F_DBASE;
inherit SSERVER;
 
void delay_effect(object me, object target, object weapon,int power);
 
int perform(object me, object target)
{
        int delay,skill;
        object weapon=me->query_temp("weapon");
     if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展这一招「炼狱」？\n");
      //  if(me->query("family/family_name") != "阎罗地府")
if (!PFM_D->valid_family(me, "阎罗地府"))
                return notify_fail(HIG"「炼狱」"+NOR"是冥界不传之密！\n");
        if ((int)me->query_skill("tonsillit",1)<60) return notify_fail("你的摄气诀不够纯熟。\n");
        if ((int)me->query_skill("whip",1)<60) 
                return notify_fail("你的鞭法太差劲了。\n"); 
        if ((int)me->query_skill("hellfire-whip",1)<60) 
                return notify_fail("你的烈火鞭法太差劲了。\n"); 
        if( (int)me->query("force") < 300 )      
                return notify_fail("你的内力不够。\n");
        if( time()-(int)me->query_temp("lianyu_end") < 6 )
                return notify_fail("绝招用多就不灵了！\n");

        skill=(int)me->query_skill("whip")+(int)me->query_skill("hellfire-whip");
       
        me->add("force", -50-skill/4);
        delay=random(2)+1;
        target->add_temp("apply/dodge",-skill);
        target->add_temp("apply/parry",-skill);
        message_vision(HIB"$N"+HIB+"阴恻恻地一笑，手中"+weapon->name()+HIB"突然慢了下来，$n"+HIB+"一见大喜，抓住机会，上前就是一轮疾攻！\n"NOR, me,target);
        COMBAT_D->do_attack(me, target, weapon);
        message_vision(HIR"$N"+HIR+"鞭势突然一变，手中"+weapon->name()+HIR"幻做漫天鞭影，将$n"+HIR+"的退路全部封死。\n"NOR,me,target);
        message_vision(HIR"$N"+HIR+"觉得有如置身炼狱，四周都是熊熊鬼火，深受轮回之苦，连气都透不过来。\n"NOR,target);
        COMBAT_D->do_attack(me, target, weapon);
        target->add_temp("apply/dodge",skill);
        target->add_temp("apply/parry",skill);
        me->set_temp("lianyu_end",time());
        me->start_busy(delay);
        return 1;
}
 

