//create by huarong 2003.12
#include <ansi.h>
inherit SSERVER;

int perform(object me, object target)
{
       object weapon;
        string msg; 
        int extra,count = 0;
       int skill,level,lvl,myexp,youexp,blade,dodge,lmt,ratio,damage,damagex;
        
          if( !target ) target = offensive_target(me);
          if( !target || !target->is_character() || !me->is_fighting(target) )
              return notify_fail(HIW+"「寒光斩」"+NOR+"只能对战斗中的对手使用。\n");
        
        // if(me->query("family/family_name")!="大雪山")
if (!PFM_D->valid_family(me, "大雪山"))
             return notify_fail(HIW+"「寒光斩」"+NOR+"只有大雪山门人才可以用！\n");


          if (!objectp(weapon = me->query_temp("weapon"))
            || (string)weapon->query("skill_type") != "blade")
             return notify_fail("手中无刀怎么用"+HIW+"「寒光斩」"+NOR"啊？\n");
        
         if( (int)me->query("force") < 2000 )
             return notify_fail("你的内力不够了！\n");

         if( (int)me->query_skill("blade",1) < 250
          ||me->query_skill_mapped("blade") != "bingpo-blade")
             return notify_fail("你的「基本刀法」还不到家，无法使用"+HIW+"「寒光斩」"+NOR+"！\n");
        
        if( (int)me->query_skill("bingpo-blade",1) < 250 )
            return notify_fail("你的「冰魄寒刀」还不到家，无法使用"+HIW+"「寒光斩」"+NOR+"！\n");
        
        if( (int)me->query_skill("cuixin-zhang",1) < 250 )
            return notify_fail("你的「催心掌」等级不够，无法推动"+HIW+"「寒光斩」"+NOR+"！\n");

        if( (int)me->query_skill("xiaoyaoyou",1) < 250 )
            return notify_fail("你的「逍遥游」还不到家，无法使用"+HIW+"「寒光斩」"+NOR+"！\n");

        if( (int)me->query_skill("ningxie-force",1) < 250 )
            return notify_fail("你的「凝血神功」还不到家，无法使用"+HIW+"「寒光斩」"+NOR+"！\n");

        if( time()-(int)me->query_temp("hanguang_end") < 8 )
            return notify_fail("此乃冰魄寒刀之精髓所在，用多了就烂了！\n");

          skill=(int)me->query_skill("bingpo-blade",1)+(int)me->query_skill("cuixin-zhang",1)+(int)me->query_skill("ningxie-force",1);
          blade=(int)me->query_skill("blade",1);
          dodge=(int)me->query_skill("xiaoyaoyou",1);
          if(skill<600) level=1;
          if(skill>=600&&skill<700) level=2;
          if(skill>=700) level=3;
          if( level==3 && (blade-dodge)>50 ) level=2;
          myexp=(int)me->query("combat_exp",1);
          youexp=(int)target->query("combat_exp",1);
          if(youexp>10000)
             ratio=to_int((to_float(myexp/10))/(to_float(youexp/1000)));
          else
             ratio=to_int((to_float(myexp*100))/(to_float(youexp)));
          if (ratio>250) ratio=250;
          if (ratio<20)  ratio=20;
          lmt=(skill-750)/30;
          if (lmt<1) lmt=1;
          if (lmt>10) lmt=10;

          lvl=random(10);

      if(level==1)
        {
         if(lvl<2) level=2;
         else level=random(2);
         }
      else if(level==2)
        {
         if(lvl<5) level=2;
         else level=random(2);
         }
      else
        {
         if(lvl<8) level=2;
         else level=random(2);
         }

               if (wizardp(me) && me->query("env/combat")=="verbose")
                   tell_object(me, sprintf(HIM+BLINK+"level: %d\n" NOR, level));


          skill=(int)me->query_skill("blade",1)+(int)me->query_skill("unarmed",1)+(int)me->query_skill("ningxie-force",1);
switch( level )
           {
                case 0:
                message_vision(HIW"\n$N"+HIW+"将内劲聚于双掌，祭起十成功力之"+HIG+"冰魄寒刀"+HIW"！\n"
                       +"只见$N"+HIW+"掌中逐渐形成两个耀眼刀环，倏地向$n"+HIW+"疾射而去！\n\n"NOR,me,target);
                me->add("force", -100-skill/6);
              if ( random(myexp+youexp)<youexp/3 )
                  {
                        message_vision(HIM"只见$N"+HIM+"刀势虽猛，但似乎欠缺准头，连$n"+HIM+"的衣服都没沾到。\n"NOR,me,target);
                        me->start_busy(2);
                        return 1;
                  }
                damage = random(skill/2)+skill;
                damage=damage*ratio/100;
                damage=damage-target->query_temp("apply/armor");
				damage=damage+random(damage);
                if (damage<0) damage=0;
                target->receive_wound("kee", random(damage/2),me);
                target->receive_damage("kee", damage,me);
                message_vision(HIR"$n"+HIR+"闪避不及，被$N的冰魄刀芒贯体而过，当场血流如注！\n"NOR,me,target);
               if (wizardp(me) && me->query("env/combat")=="verbose")
                   tell_object(me, sprintf(HIM+BLINK+"damage: %d\n" NOR, damage));
                COMBAT_D->report_status(target);
                break;

                case 1:
                message_vision(HIW"\n$N双掌合十，高举过顶，顺势运起"+HIG+"冰魄寒刀"+HIW+"\n"
                   +"只见$N"+HIW+"双掌的力劲合而为一，形成一个巨大刀环。\n"
                   +"突然间$N"+HIW+"真气一提，向$n"+HIW+"直劈而下！\n\n"NOR,me,target);
                me->add("force", -200-skill/6);
              if ( random(myexp+youexp)<youexp/3 )
                   {
                        message_vision(HIM"只见$N刀势虽猛，但似乎欠缺准头，连$n的衣服都没沾到。\n"NOR,me,target);
                     me->start_busy(2);
                        return 1;
                     }
                damage = random(skill/2)+skill*3/2;
                damage=damage*ratio/100;
                damage=damage-target->query_temp("apply/armor");
				damage=damage+random(damage);
                if (damage<0) damage=0;
                target->receive_wound("kee", random(damage/2),me);
                target->receive_damage("kee", damage,me);
                message_vision(HIR"$n"+HIR+"闪避不及，被$N"+HIR+"的巨大刀环当场击中，口中鲜血狂喷而出！\n"NOR,me,target);
               if (wizardp(me) && me->query("env/combat")=="verbose")
                   tell_object(me, sprintf(HIM+BLINK+"damage: %d\n" NOR, damage));
                COMBAT_D->report_status(target);
                break;

                case 2:
                message_vision(HIW"\n$N"+HIW+"身形一变，幻化出无数幻影，将$n"+HIW+"团团围住。\n"
                          +"只见$N"+HIW+"无数幻影身形同时聚起连串刀光，使出冰魄寒刀中最强一式\n"
                          +HIG+BLINK+"\n\n               〓"+HIW+"寒光斩"+HIG+"〓"
                          +NOR+HIW+"\n\n\n霎时间$N"+HIW+"满天刀芒向四周狂射而出！\n"NOR,me,target);
                me->add("force", -300-skill/6);
                damage = random(skill/3)+skill/3;
                damage=damage*ratio/100;
                damage=damage-target->query_temp("apply/armor")/lmt;
				damage=damage+random(damage);
               if (wizardp(me) && me->query("env/combat")=="verbose")
                   tell_object(me, sprintf(HIM+BLINK+"ratio: %d\n" NOR, ratio));
                if (damage<0) damage=0;
//              target->start_busy(2);
              for (int i=1;i<=lmt;i++)
                {
                 if (random(myexp+youexp)>youexp/2)
                    {
                        damagex=damage/3+random(damage/4);
                          target->receive_wound("kee", random(damagex/2),me);
                          target->receive_damage("kee", damagex,me);
                           message_vision(HIY"$N"+HIY+"一个不留神，身上多了几条深可见骨的刀伤！\n"NOR,target);
                        if (wizardp(me) && me->query("env/combat")=="verbose")
                              tell_object(me, sprintf(HIM+BLINK+"damage: %d\n" NOR, damagex));
                           COMBAT_D->report_status(target);
                        }
                  else
                    {
                           message_vision(HIM"只见$N"+HIM+"狼狈的从漫天刀网中钻了出来，不过倒是没受什么伤。\n"NOR,target);
                        }
                 }
             break;
        }
       me->start_busy(1+random(1));
       me->set_temp("hanguang_end",time());
        return 1;
}


