//modify for 大唐西游2 by huarong 2003/12

#include <ansi.h>
#include <combat.h>

inherit SSERVER;
int perform(object me, object target)
{
      int damage,skill;
      string str;
         skill = (int)me->query_skill("blade",1)/2+(int)me->query_skill("bingpo-blade",1)/2;
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展这一招「暴雪天威」？\n");
   // if(!wizardp(me)&&(string)me->query("family/family_name") != "大雪山" )
if (!PFM_D->valid_family(me, "大雪山"))
          return notify_fail("你的冰魄寒刀是从哪里偷学来的？\n");
        if(!me->is_fighting())
                return notify_fail("「暴雪天威」只能在战斗中使用！\n");
        if((int)me->query("max_force") < 500 )
                return notify_fail("你的内力不够！\n");
        if((int)me->query("force") < 800 )
                return notify_fail("你的内力不足！\n");
        if((int)me->query("sen") < 500 )
                return notify_fail("你的精神不足，没法子施用外功！\n");
        if((int)me->query_skill("bingpo-blade", 1) < 100)
                return notify_fail("你的冰魄寒刀级别还不够，使用这一招会有困难！\n");
        if((int)me->query_skill("ningxie-force", 1) < 100)
                return notify_fail("你的冰谷凝血功修为不够，使用这一招会有困难！\n");
        if (me->query_temp("xs_pfm_busy")) return notify_fail("绝招用的太多太滥就不灵了。\n");
 message_vision(HIW"\n$N"+HIW+"运起寒气，身形一转，四周顿时冰冻数尺，空气中寒气逼人$n"+HIW+"只冻的忘记的抵抗！\n"NOR,me,target);
 //me->set_temp("noauto",1);
 //target->start_busy(random(2));
 damage=(int)me->query_skill("blade")/2+random((int)me->query_skill("blade"))/2;
 target->add_temp("apply/dodge",-skill);
 target->add_temp("apply/parry",-skill);
 message_vision(HIW"\n$N"+HIW+"嘿嘿一声冷笑，竟然隐入雪花之中。$n"+HIW+"大急，四下找寻$N"+HIW+"，忽然背后一阵寒气随着\n"NOR,me,target);
 message_vision(HIW"\n刀光狂袭过来！！！\n"NOR,me,target);
 message_vision(HIW"\n$N"+HIW+"自左向右划出一刀！"NOR,me,target);
       COMBAT_D->do_attack(me, target, me->query_temp("weapon"),TYPE_REGULAR);
 message_vision(HIW"\n$N"+HIW+"自上而下划出一刀！"NOR,me,target);
       COMBAT_D->do_attack(me, target, me->query_temp("weapon"),TYPE_REGULAR); 
 message_vision(HIW"\n$N"+HIW+"自后向前划出一刀！"NOR,me,target);
       COMBAT_D->do_attack(me, target, me->query_temp("weapon"),TYPE_REGULAR);
 target->add_temp("apply/dodge",skill);
 target->add_temp("apply/parry",skill);
 if(random(me->query("combat_exp"))>random(target->query("combat_exp"))/4)
 {
message_vision(HIY"\n打斗中,一只金色大鹏鸟远远飞来！$N"+HIY+"和$n"+HIY+"都看呆了！\n"NOR,me,target);
message_vision(HIY"\n突然大鹏鸟用翅膀一扇,顿时狂风大作！\n"NOR,me,target);
if(random(me->query("force_factor"))>target->query("force_factor")/4)
{
 message_vision(HIR"\n$N"+HIR+"见机不可失,连忙攻出一招！\n"NOR,me,target);
 target->receive_damage("kee",damage,me); 
 target->receive_damage("sen",damage,me); 
 message_vision(HIR"\n狂风夹杂着碎石漫天飞舞,把$n"+HIR+"砸得遍体鳞伤！\n"NOR,me,target);
 target->receive_wound("kee",damage/2,me);
 target->receive_wound("sen",damage/2,me);
 COMBAT_D->report_status(target);
}  
 else if(random(me->query("force_factor"))>target->query("force_factor")/2)
{
message_vision(HIR"\n狂风夹杂着碎石漫天飞舞,把$n"+HIR+"砸得遍体鳞伤！\n"NOR,me,target);
target->receive_wound("kee",damage/2,me);
COMBAT_D->report_status(target);
}
else  
{
message_vision(HIR"\n狂风夹杂着碎石漫天飞舞,把$N"+HIR+"和$n"+HIR+"砸得遍体鳞伤！\n"NOR,me,target); 
target->receive_wound("kee",damage/2,me);
target->receive_wound("sen",damage/2,me);
COMBAT_D->report_status(target);
me->receive_wound("kee",damage/5);
COMBAT_D->report_status(me);
}        
}
 //me->delete_temp("noauto");
 me->receive_damage("sen", 100);
 me->add("force", -300);

/*
    if ( (target->query("eff_kee")<0 || (!living(target) && target->query("kee")<0)) && random(5)==1 )  
{str=target->name()+HIM"被"+me->name()+HIM+"用雪山秘传"NOR+HIW"「暴雪天威」"+HIM"杀死了，据说"+target->name()+HIM+"的尸体被封印在一个巨大的"NOR+HIW"冰棺"+HIM"里面！";
message("channel:rumor",HIM"【空穴来风】某人："+str+"\n"NOR,users());
 }
*/
      me->start_busy(1+random(2));
      me->set_temp("xs_pfm_busy",1);
      call_out("remove_effect",4+random(3),me);
      return 1;
}

void remove_effect(object me) {
  if (!me) return;
  me->delete_temp("xs_pfm_busy");
}

