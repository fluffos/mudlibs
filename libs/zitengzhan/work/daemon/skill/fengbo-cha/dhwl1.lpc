#include <ansi.h>

inherit SSERVER;

string *dahai= ({
BLINK""HIR"入夜潮声十里闻，气连霄汉自氤氲。\n"NOR,
BLINK""HIG"舟航吴越长风使，襟带幽燕孔道分。\n"NOR,
BLINK""CYN"云卷云舒见海日，潮生潮灭起沙鸥。\n"NOR,
BLINK""MAG"江风扬浪动云根，重碇危樯白日昏。\n"NOR,
BLINK""HIY"楼台影就波中出，日月光疑镜里悬。\n"NOR,
BLINK""HIB"水色苍茫碧四围，临风独立瞰危矶。\n"NOR,
BLINK""HIM"浪中生身浪里去，红尘辗转几道关。\n"NOR,
BLINK""HIC"险嶂连峰催鹤影，危崖惊浪暖高峡。\n"NOR,
BLINK""HIW"代邸东南龙跃泉，清漪碧浪远浮天。\n"NOR,
BLINK""RED"万叠银山寒浪起  日泛仙舟醉碧澜。\n"NOR,
BLINK""YEL"永巷长年怨绮罗，离情终日思风波。\n"NOR
});



int perform(object me, object target)
{
    int how_long,times;
    string str;
    object weapon;
    
    if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展「大海无量」？\n");
    
    if (!PFM_D->valid_family(me, "东海龙宫"))
                return notify_fail("非龙宫弟子不能用「大海无量」！\n");
    if (!me->query_temp("dhwl"))
           return notify_fail("你没有蓄力。\n");
           
    if (me->query_temp("dhwl_target") != target)
           return notify_fail("你搞错对象了吧。\n");              
           
    weapon=me->query_temp("weapon");
    how_long = me->query_temp("dhwl");
    times = random(how_long)+1;
    if (how_long > 6 && times < 6) times=5;
    if (how_long > 10) times=10;
    
    
    message_vision(HIC"$N"+HIC+"长啸一声，天地为之变色，手中"+weapon->name()+HIC"卷起一阵震耳欲聋的海潮声，暴风骤雨地袭向$n。
$n"+HIC+"只觉得$N"+HIC+"激荡起来的真气以海纳百川般的气势一浪接一浪扑来，连呼吸也感到困难了。\n"NOR,me,target);

    me->delete_temp("no_move");
    target->add_temp("apply/dodge",-how_long*50);
    target->add_temp("apply/parry",-how_long*50);
      for (int i=0; i<=times; i++)
     {  
        me->set_temp("dhwl1_perform", i);
        message_vision(dahai[random(sizeof(dahai))], me, target);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        me->delete_temp("dhwl1_perform");
     }
    if ( (target->query("eff_kee")<0 || !living(target)) && random(5)==1 )  
                       {str=target->name()+"中了"+me->name()+"的"+HIC+"「大海无量」"+HIM+"，在"+me->name()+"的内力震荡下，顿时吐血身亡！";
                        CHANNEL_D->do_channel(me, "rumor",str);
                        me->delete_temp("last_channel_msg");}

    me->set_temp("apply/dodge",me->query_temp("before_dhwl_dodge"));
    me->delete_temp("dhwl");
    me->delete_temp("before_dhwl_dodge");
    target->add_temp("apply/dodge",how_long*50);
    target->add_temp("apply/parry",how_long*50);
    me->set_temp("dhwl_end",time());
    me->set_temp("dhwl1_end",time());
    me->delete_temp("dhwl_target");
    return 1;
                
        
}



