//create by huarong 2003/12
#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  int damage, skill, i;
  int myexp, youexp, ratio;
  object weapon = me->query_temp("weapon"), weapon2, *inv;
  inv = all_inventory(me);
  i = sizeof(inv);

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail(HIR + "「威震四海」" + NOR + "只能对战斗中的对手使用。\n");
  //     if(!wizardp(me) && me->query("family/family_name")!="东海龙宫")
  if (!PFM_D->valid_family(me, "东海龙宫"))
    return notify_fail(HIR + "「威震四海」" + NOR + "只有东海龙宫门人才可以用！\n");

  if ((int)me->query("force") < 2000)
    return notify_fail("你的内力不够了!\n");

  if (me->query_temp("dhwl"))
    return notify_fail("你正在蓄力之中，哪还有余出「无尽风波」。\n");
  if ((int)me->query_skill("fork", 1) < 250
    || me->query_skill_mapped("fork") != "fengbo-cha")
    return notify_fail("你的「基本叉法」还不到家，无法使用" + HIR + "「威震四海」" + NOR + "！\n");

  if ((int)me->query_skill("fengbo-cha", 1) < 250)
    return notify_fail("你的「风波十二叉」还不到家，无法使用" + HIR + "「威震四海」" + NOR + "！\n");

  if ((int)me->query_skill("hammer", 1) < 250)
    return notify_fail("你的「基本锤法」还不到家，无法使用" + HIR + "「威震四海」" + NOR + "！\n");

  if ((int)me->query_skill("huntian-hammer", 1) < 250)
    return notify_fail("你的「混天锤法」还不到家，无法使用" + HIR + "「威震四海」" + NOR + "！\n");

  if ((int)me->query_skill("dragonfight", 1) < 250)
    return notify_fail("你的「龙形搏击」等级不够，无法推动" + HIR + "「威震四海」" + NOR + "！\n");

  if ((int)me->query_skill("dragonforce", 1) < 250)
    return notify_fail("你的「龙神心法」还不到家，无法自由控制剑进行" + HIR + "「威震四海」" + NOR + "！\n");

  if (time() - (int)me->query_temp("sihai_end") < 10)
    return notify_fail("此乃东海龙宫之精髓所在，用多了就烂了！\n");
  //    if( time()-(int)me->query_temp("dhwl1_end") < 3 )
  //            return notify_fail("「大海无量」消耗大量内力，需要短时间的调整！\n");//add by huarong 2004.6


  me->delete_temp("have/hammer");
  for (int k = 0; k < i; k++) {
    if (inv[k]->query("skill_type") == "hammer" || inv[k]->query("apply/skill_type") == "hammer") {
      me->set_temp("have/hammer", 1);
      weapon2 = inv[k];
      break;
    }
  }
  if (!me->query_temp("have/hammer"))
    return notify_fail("你身上连把锤都没有，怎么使用" + HIR + "「威震四海」" + NOR + "？\n");

  skill = (int)me->query_skill(
    "fengbo-cha",
    1
  ) + (int)me->query_skill("dragonfight", 1) + (int)me->query_skill("huntian-hammer", 1);
  target->add_temp("apply/dodge", -skill);
  target->add_temp("apply/parry", -skill);
  me->delete("env/brief_message");
  target->delete("env/brief_message");
  weapon->set_temp("original/use_apply_skill", weapon->query("use_apply_skill"));
  weapon->set_temp("original/skill_type", weapon->query("apply/skill_type"));
  message_vision(
    HIW "\n$N" + HIW + "大吼一声，手中" + weapon->query("name") + HIW + "婉转一个大圆，使得密不透风！\n" NOR,
    me,
    target
  );
  COMBAT_D->do_attack(me, target, weapon);
  COMBAT_D->do_attack(me, target, weapon);
  message_vision(HIC "\n激战中$N" + HIC + "飞身前扑，招式一变，一掌拍向$n！\n" NOR, me, target);
  me->set("actions", (: call_other, SKILL_D("dragonfight"), "query_action" :));
  weapon->set("use_apply_skill", 1);
  weapon->set("apply/skill_type", "unarmed");
  COMBAT_D->do_attack(me, target);
  message_vision(
    HIW "\n$N一掌拍过，招式又一变，从身后取出" + weapon2->query("name") + HIW + "迎空一挥，招招不离$n" + HIW + "的面门！\n" NOR,
    me,
    target
  );
  me->set("actions", (: call_other, SKILL_D("huntian-hammer"), "query_action" :));
  weapon->set("use_apply_skill", 1);
  weapon->set("apply/skill_type", "hammer");
  message_vision(HIG + BLINK + "\n◆遍地开花◆" NOR, me, target);
  COMBAT_D->do_attack(me, target, weapon2);
  message_vision(HIY + BLINK + "\n◆石破天惊◆" NOR, me, target);
  COMBAT_D->do_attack(me, target, weapon2);
  message_vision(HIR + BLINK + "\n◆威震四海◆" NOR, me, target);
  me->set_temp("HTH_pfm", 1);
  COMBAT_D->do_attack(me, target, weapon2);
  me->delete_temp("HTH_pfm");
  me->set("actions", (: call_other, SKILL_D("fengbo-cha"), "query_action" :));
  weapon->set("apply/skill_type", "fork");
  weapon->set("use_apply_skill", weapon->query_temp("original/use_apply_skill"));
  weapon->set("apply/skill_type", weapon->query_temp("original/skill_type"));
  me->reset_action();
  target->add_temp("apply/dodge", skill);
  target->add_temp("apply/parry", skill);
  me->start_busy(1 + random(1));
  weapon->set("use_apply_skill", 0);
  me->set_temp("sihai_end", time());
  return 1;
}
