#include <ansi.h>

inherit SSERVER;

int cast(object me, object target)
{
 int skill;
        if(me->query("family/family_name")!="东海龙宫")
                return notify_fail("非龙宫弟子不能用「化龙」！\n");

        if( target != me ) 
                return notify_fail("你只能让自己化龙。\n");

        if( (int)me->query("mana") < 500 )     
                return notify_fail("你的法力不够。\n");
        if( (int)me->query_skill("seashentong") < 100 )     
                return notify_fail("你的碧海神通等级不够。\n");
	if( (int)me->query("kee") < 350 )
		return notify_fail("你的气血不足。\n");
	if( (int)me->query("sen") < 350 )
		return notify_fail("你的精神不足。\n");
        if( (int)me->query_temp("hualong") ) 
                return notify_fail("你已经化身成龙了。\n");
        if( time()-(int)me->query_temp("hualong_end") < 20 )
                return notify_fail("你刚化身成龙，肉体极度疲乏！\n");

       message_vision(HIW" $N"+HIW+"喃喃地念起了咒语，古老玄奥的咒文回绕在$N"+HIW+"周围，居然是上古龙语。\n"NOR, me);

        me->add("mana", -500);
        me->receive_damage("sen", 100);

        skill = me->query_skill("seashentong",1);
        skill= skill/50;
          
	if ( skill<1 ) skill=1; 
        message_vision(
HIC"一声苍茫的龙吟响彻天下，只见$N"+HIC+"的血肉之躯竟化为一条张牙舞爪的苍龙，端地杀气逼人。\n"NOR, me);
         me->set_temp("hualong",skill);

        return 1;
}


