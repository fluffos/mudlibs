// sheshen.c            舍身技
//modify for dtxy by huarong 2004/10
#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int calculate_damage(object me, object target, int base_damage, int damge_bonus);
int perform(object me, object target) {
  string msg, str;
  int mydf;
  int ap, dp, pp;
  int myexp, youexp, myunarmed, youdodge, myforce, youarmor, mz, mystr, youstr;
  int damage_bonus, damage, wound;
  int delay;
  object ob;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("不在战斗中，舍什么身？\n");
  if (!wizardp(me) && me->query("family/family_name") != "东海龙宫")
    return notify_fail("非龙宫弟子不能用「舍身技」！\n");
  if ((int)me->query_skill("dragonfight", 1) < 60)
    return notify_fail("你的修为不够深，还不能领悟舍身技的精髓。\n");
  if ((int)me->query_skill("dragonforce", 1) < 60)
    return notify_fail("你的修为不够深，还不能领悟舍身技的精髓。\n");
  if (time() - me->query_temp("sheshen_end") < 7)
    return notify_fail("舍身技不能用得这么频繁！\n");
  if ((int)me->query("force") < 300)
    return notify_fail("你的内力不够了。\n");
  if ((int)me->query_temp("lsnh"))
    return notify_fail("你已陷入疯狂状态，无法使用舍身技！\n");

  msg = CYN "$N" + CYN + "右掌挥出，斩向$n" + CYN + "的左肩，\n";
  me->add_temp("mingzhong", 30);
  myunarmed = me->query_skill("unarmed") / 10;
  if (myunarmed < 1) myunarmed = 1;
  youdodge = (int)target->query_skill("dodge") / 10;
  if (youdodge < 1) youdodge = 1;
  youdodge += (int)target->query_skill("parry") / 10;
  if (youdodge < 1) youdodge = 1;
  youdodge = youdodge / 2;
  myexp = (int)me->query("combat_exp") / 10000;
  if (myexp < 1) myexp = 1;
  myexp = myexp * myunarmed;
  youexp = (int)target->query("combat_exp") / 10000;
  if (youexp < 1) youexp = 1;
  youexp = youexp * youdodge;
  mz = me->query_temp("mingzhong");
  if (mz < 0) mz = 0;
  myexp += myexp / 100 * mz;

  ob = target->query_temp("weapon");
  str = "右手";
  if (objectp(ob)) str = "手中的" + ob->query("name");
  mystr = me->query_str();
  myforce = me->query("str");
  if (!userp(me)) myforce = myforce / 2;
  damage = mystr * myforce / 10;
  damage += (int)me->query_skill("unarmed");
  youarmor = (int)target->query_temp("apply/armor_vs_force");
  damage = damage / 2 + random(damage / 2);
  damage = damage - youarmor;
  if (damage < 1) damage = 1;
  if (myexp / 2 + random(myexp / 2) > random(youexp) || target->query_temp("unconcious")) {
    msg += "$n" + NOR + CYN + "想用" + str + NOR + CYN + "挡开，不料却被$N" + NOR + CYN + "一把抓住。\n";
    msg += "$N" + NOR + CYN + "顺势上步，使出了" + HIY + "「舍身技」" + NOR + CYN + "！\n\n" NOR;
    msg += CYN "$N" + NOR + CYN + "左脚铲向$n" + NOR + CYN + "右腿膝盖，\n";
    if (myexp / 2 + random(myexp / 2) > youexp / 2 + random(youexp / 2) || target->query_temp("unconcious")) {
      msg += HIR "结果正铲在$n" + HIR + "的小腿上。\n" NOR;
      damage_bonus = damage * 2 / 3;
      wound = damage_bonus / 2;
      if (damage > 0) {
        target->receive_damage("kee", damage_bonus, me);
        if (wound > 0) target->receive_wound("kee", wound, me);
        msg += COMBAT_D->damage_msg(damage, "内伤");
        message_vision(msg, me, target);
        COMBAT_D->report_status(target);
      }
    } else {
      msg += HIG "结果被$n" + HIG + "提腿挡开了。\n" NOR;
      message_vision(msg, me, target);
    }
    msg = BLU "紧跟着$N" + NOR + BLU + "收左脚，提左膝撞向$n" + NOR + BLU + "的软肋，\n";
    msg += "同时右手曲肘撞向$n" + NOR + BLU + "的面门，\n";
    if (myexp / 2 + random(myexp / 2) > youexp / 2 + random(youexp / 2) || target->query_temp("unconcious")) {
      msg += HIR "结果正中$n！\n" NOR;
      damage_bonus = damage;
      wound = damage_bonus / 2;
      if (damage > 0) {
        target->receive_damage("kee", damage_bonus, me);
        if (wound > 0) target->receive_wound("kee", wound, me);
        msg += COMBAT_D->damage_msg(damage, "内伤");
        message_vision(msg, me, target);
        COMBAT_D->report_status(target);
      }
    } else {
      msg += HIG "结果被$n" + HIG + "挡开了。\n" NOR;
      message_vision(msg, me, target);
    }
    msg = HIB "$N" + HIB + "接着顺势用右手抓住$n" + HIB + "右臂，半转身将$n" + HIB + "摔了出去，\n";
    if (myexp / 2 + random(myexp / 2) > youexp / 2 + random(youexp / 2) || target->query_temp("unconcious")) {
      msg += HIR "结果$n" + HIR + "一跟头摔在地上。\n" NOR;
      if (damage > 0) {
        damage = damage * 3 / 2;
        wound = damage / 2;
        target->receive_damage("kee", damage, me);
        if (wound > 0) target->receive_wound("kee", wound, me);
        msg += COMBAT_D->damage_msg(damage, "内伤");
        message_vision(msg, me, target);
        COMBAT_D->report_status(target);
      }
    } else {
      msg += HIG "结果被$n" + HIG + "一个踉跄，却没摔倒。\n" NOR;
      message_vision(msg, me, target);
    }
  } else {
    msg += HIG "可是$p" + HIG + "看破了$P" + HIG + "的企图，向后越开。\n" NOR;
    message_vision(msg, me, target);
  }
  me->start_busy(1 + random(2));
  me->add_temp("mingzhong", -30);
  me->add("force", -100 - damage / 4);
  me->set_temp("sheshen_end", time());

  return 1;
}

int calculate_damage(object me, object target, int base_damage, int damage_bonus) {
  int damage;
  int myexp, youexp;

  damage = base_damage + (damage_bonus + random(damage_bonus)) / 2;
  myexp = me->query("combat_exp", 1);
  youexp = target->query("combat_exp", 1);
  if (random(youexp) > myexp) {
    damage -= damage / 3;
    youexp /= 2;
  }
  //added by huarong  2004/8
  damage -= target->query("apply/armor_vs_force");
  if (wizardp(me) && me->query("env/combat") == "verbose")
    tell_object(me, sprintf(HIG "damage: %d\n" NOR, damage));

  return damage;
}
