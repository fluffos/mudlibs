//modify for 大唐西游2 by huarong 2003/12
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int damage_bonus, target_bonus, damage, wound;

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("不在战斗中，怎么使用" HIY "龙行天下" NOR "？\n");
  //   if((me->query("family/family_name") != "东海龙宫")&&(!wizardp(me)))
  if (!PFM_D->valid_family(me, "东海龙宫"))
    return notify_fail("你非我龙王弟子，怎能使用龙宫绝招?\n");
  if ((int)me->query_skill("dragonfight", 1) < 100
    || (int)me->query_skill("dragonforce", 1) < 100)
    return notify_fail("你的修为不够深，还不能领悟" HIY "龙行天下" NOR "的精髓。\n");
  if ((int)me->query("max_force") < 1000)
    return notify_fail("你的内功太差。\n");
  if ((int)me->query("force") < 1000)
    return notify_fail("你的内力不足！\n");
  if ((int)me->query("sen") < 500)
    return notify_fail("你的精神不足，没法子施用外功！\n");
  if (time() - me->query_temp("lxtx_end") < 7)
    return notify_fail(HIY "龙行天下" NOR "不能用得这么频繁！\n");
  //  if( time()-(int)me->query_temp("dhwl1_end") < 3 )
  //          return notify_fail("「大海无量」消耗大量内力，需要短时间的调整！\n");//add by huarong 2003.4
  me->set_temp("lxtx_end", time());
  me->add("force", -600);
  // dodge
  msg = HIB "$N运转神功，身形化作一团白雾，似乎一条蛟龙腾空而起。\n" NOR;
  msg += HIB "这招比的是灵动。\n" + HIY + BLINK + "【风起云涌】" + NOR + HIB + "$N" + HIB + "带起的劲风涌向$n" + HIB + "全身！\n" NOR;
  damage_bonus = (int)me->query_skill("dodge", 1);
  target_bonus = (int)target->query_skill("dodge", 1);
  if ((damage_bonus) > random(target_bonus)) {
    damage = 150 + (damage_bonus + random(damage_bonus)) / 2; ;
    if (wizardp(me)) tell_object(me, sprintf(GRN "damage: %d\n" NOR, damage));
    wound = random(damage - (int)target->query_temp("apply/armor"));
    msg += HIR "$n" + HIR + "躲闪不及，被劲风带倒在地。 \n" NOR;
    target->receive_damage("kee", damage, me);
    if (wound > 0) target->receive_wound("kee", wound, me);
    msg += COMBAT_D->damage_msg(damage, "内伤");
    message_vision(msg, me, target);
    COMBAT_D->report_status(target);
  } else {
    msg += HIG "$n" + HIG + "见势不妙，就地一滚躲开了。\n" NOR;
    message_vision(msg, me, target);
  }
  // combat_exp
  msg = CYN "$N" + NOR + CYN + "巧运掌法，左手虚探，右手早就抓向$n" + NOR + CYN + "的肋部。\n" NOR;
  msg += CYN "这招比的却是经验。\n" + HIY + BLINK + "【声东击西】" + NOR + CYN + "$N" + NOR + CYN + "的手掌已经无声无息贴近$n！\n" NOR;
  damage_bonus = (int)me->query("combat_exp");
  target_bonus = (int)target->query("combat_exp");
  if ((damage_bonus) > random(target_bonus)) {
    damage_bonus = (damage_bonus / 20000 + random(600)) / 30;
    damage = 150 + (damage_bonus + random(damage_bonus)) / 2;
    if (wizardp(me)) tell_object(me, sprintf(GRN "damage: %d\n" NOR, damage));
    wound = random(damage - (int)target->query_temp("apply/armor") * 2);
    msg += HIR "$n" + HIR + "的肋部已被$N" + HIR + "撕出条血痕。\n" NOR;
    target->receive_damage("kee", damage, me);
    if (wound > 0) target->receive_wound("kee", wound, me);
    msg += COMBAT_D->damage_msg(damage, "内伤");
    message_vision(msg, me, target);
    COMBAT_D->report_status(target);
  } else {
    msg += HIG "$n" + HIG + "顺势左转，神奇般地躲开攻击。\n" NOR;
    message_vision(msg, me, target);
  }
  // daoxing
  msg = HIC "$N" + HIC + "仗着深厚的道行，左手强行带起掌风砸向$n。\n" NOR;
  msg += HIC "这招全靠道行。\n" + HIY + BLINK + "【破釜沉舟】" + NOR + HIC + "$n" + HIC "眼看躲闪不及！\n" NOR;
  damage_bonus = (int)me->query("daoxing");
  target_bonus = (int)target->query("daoxing");
  if ((damage_bonus) > random(target_bonus)) {
    damage_bonus = (damage_bonus / 20000 + random(600)) / 30;
    damage = 150 + (damage_bonus + random(damage_bonus)) / 2;
    if (wizardp(me)) tell_object(me, sprintf(GRN "damage: %d\n" NOR, damage));
    wound = random(damage - (int)target->query_temp("apply/armor") * 2);
    msg += HIR + "$n" + HIR + "被$N" + HIR + "一掌震飞一丈多远。 \n" NOR;
    target->receive_damage("kee", damage, me);
    if (wound > 0) target->receive_wound("kee", wound, me);
    msg += COMBAT_D->damage_msg(damage, "内伤");
    message_vision(msg, me, target);
    COMBAT_D->report_status(target);
  } else {
    msg += HIG + "$n" + HIG + "缩腹挺胸，暴退而出，躲过了攻击。\n" NOR;
    message_vision(msg, me, target);
  }
  // unarmed
  msg = HIM "$N" + HIM + "总结多年练习心得，虚探一下，抓住$n" + HIM + "的兵刃。\n" NOR;
  msg += HIM "这招全靠掌法。\n" + HIY + BLINK + "【围魏救赵】" + NOR + HIM + "$N" + HIM + "和$n" + HIM + "近身肉搏！\n" NOR;
  damage_bonus = (int)me->query_skill("unarmed", 1);
  target_bonus = (int)target->query_skill("unarmed", 1);
  if ((damage_bonus) > random(target_bonus)) {
    damage = 150 + (damage_bonus + random(damage_bonus)) / 2;
    if (wizardp(me)) tell_object(me, sprintf(GRN "damage: %d\n" NOR, damage));
    wound = random(damage - (int)target->query_temp("apply/armor") * 2);
    msg += HIR "$n" + HIR + "空手功夫不行，显然吃了大亏。 \n" NOR;
    target->receive_damage("kee", damage, me);
    if (wound > 0) target->receive_wound("kee", wound, me);
    msg += COMBAT_D->damage_msg(damage, "内伤");
    message_vision(msg, me, target);
    COMBAT_D->report_status(target);
  } else {
    msg += HIG + "$n" + HIG + "的空手功夫竟然也不赖，躲过了$N" + HIG + "的招式。\n" NOR;
    message_vision(msg, me, target);
  }
  // 运气
  if (!random(5)) {
    msg = HIW "$N" + HIW + "本已力尽，谁知运气竟然不错，又出一招。\n" NOR;
    msg += HIW "这招是运气帮忙。\n" + HIY + BLINK + "【无中生有】" + NOR + HIW + "$N" + HIW + "趁$n" + HIW + "分神之际逼向$n" + HIW + "！\n" NOR;
    damage_bonus = (int)me->query_kar();
    target_bonus = (int)target->query_kar();
    if ((damage_bonus) > random(target_bonus)) {
      damage_bonus *= 7;
      damage = 150 + (damage_bonus + random(damage_bonus)) / 2;
      if (wizardp(me)) tell_object(me, sprintf(GRN "damage: %d\n" NOR, damage));
      wound = random(damage - (int)target->query_temp("apply/armor"));
      msg += HIR "$n" + HIR + "被脚下石头一绊，而被$N" + HIR + "击中一掌。 \n" NOR;
      target->receive_damage("kee", damage, me);
      if (wound > 0) target->receive_wound("kee", wound, me);
      msg += COMBAT_D->damage_msg(damage, "内伤");
      message_vision(msg, me, target);
      COMBAT_D->report_status(target);
    } else {
      msg += HIG + "$n" + HIG + "迎风使舵，晃过了$N" + HIG + "的攻击。\n" NOR;
      message_vision(msg, me, target);
    }
  }
  me->start_busy(random(2) + 2);
  return 1;
}
