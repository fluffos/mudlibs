//modify for dtxy by huarong 2004/10

#include <ansi.h>
inherit SSERVER;
//string npc_dir = "/d/sea/npc/slnpc/long";
string npc_dir = "/obj/npc/long";

int perform(object me, object target) {
  string msg, str, desc_msg;
  object where, weapon;
  object soldier;
  object attacker;
  int i, j, skill, skill1, damage, myexp;
  int dragonfight_level;
  skill = (int)me->query_skill(
    "unarmed",
    1
  ) + (int)me->query_skill("dragonfight", 1) + (int)me->query_skill("dragonforce", 1);

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你对谁施展庐山升龙霸？\n");
  if (!target->is_fighting(me))
    return notify_fail("只有在战斗中才可以使用「庐山升龙霸」！\n");

  if (!wizardp(me) && (string)me->query("family/family_name") != "东海龙宫")
    return notify_fail("你又不是东海弟子，不会庐山升龙霸。\n");
  if ((int)me->query_skill("dragonfight", 1) < 150)
    return notify_fail("你的龙形搏击修为不深，施展不出庐山升龙霸。\n");
  if ((int)me->query_skill("dragonforce", 1) < 150)
    return notify_fail("你的龙神心法修为不深，施展不出庐山升龙霸。\n");
  if ((int)me->query_skill("dragonstep", 1) < 150)
    return notify_fail("你的龙神身法修为不深，施展不出庐山升龙霸。\n");
  if (time() - (int)me->query_temp("shenglong_end") < 8)
    return notify_fail("你刚用过「庐山升龙霸」,内息还无法调整！\n");
  if ((int)me->query_temp("lsnh"))
    return notify_fail("你已陷入疯狂状态，无法使用庐山升龙霸！\n");
  if ((int)me->query("force") < 1000)
    return notify_fail("你的内力不够。\n");

  if ((int)me->query("sen") < 100)
    return notify_fail("你现在神智不清！\n");

  me->add("force", -200);
  me->receive_damage("sen", 100);
  me->delete("env/brief_message");
  target->delete("env/brief_message");
  weapon = me->query_temp("weapon");
  myexp = me->query("combat_exp");
  message_vision(
    HIB "顷刻之间山崩地裂，惊水拍岩，卷起千堆土，$N" + HIB + "回过神定睛一看，身作神龙的$n" + HIB + "正在将瀑布之下\n" NOR,
    target,
    me
  );
  message_vision(HIB "苦练出的绝世神功提至极限！$N" + HIB + "冒着身体爆裂的危险,使出能让自己全身血液沸腾倒流的绝学！\n" NOR, me, target);
  COMBAT_D->do_attack(me, target, weapon);
  i = (int)me->query_skill("dragonfight", 1) - 100;
  i /= 50;
  msg = HIC "$N" + HIC + "大喝一声                 " + HIB + "～～～～庐～～山～～～～" + HIC + "\n\n"
    "               ***               ****   **                    ************\n"
    "        ****   ***              *****  ****                   ************  \n"
    "       ******  ***             ***     *******             ***************** \n"
    "      ******   ***               ***** *******             ***********  *****\n"
    "     *******   ***            *******  ***                 ***  ** ** *** ** \n"
    "    *******    ***            *******  *******             *** *   ** *  ** \n"
    "    ******     ***              * **** *******             *** *** ** ** * \n"
    "   *******     ***             *******    ***               *** ** **      \n"
    "      **************         ******    ******             **********  *****\n"
    "     ****************       ***   **   *****              ***** **   ******\n"
    "  ******************       **  ****** *******               *****   ***  **\n"
    "*******************       **   ** *** ********              ******* ****** \n"
    "**    *****     **             ******* *******              ******** ****** \n"
    "      ****     **             *** **  *******              ** ** ** *** ** \n"
    "      ****     **             ******  ****                 ******** ****** \n"
    "      ****     *              ******  *********            *******  ****** \n"
    "      ***      *              ***  *   ******                ****   ***  * \n"
    "      ***      *              ***  *   **               ***************  * \n"
    "               **              **  *   ***       **    ***   *****  ***  * \n"
    "               **              *   *    ***********           ***    **  * \n"
    "               **                  *                          ***        * \n"
    "               **                  *                           *         **\n"
    "               **                  *                                     **\n" NOR;
  message_vision(msg, me, target);
  if (i < 1) {
    msg = HIY "结果什么也没有发生！\n\n" NOR;
    message_vision(msg, me, target);
  }

  if (i) {
    if (i > 9) i = 9;
    message_vision(HIB + chinese_number(i) + "条神龙张牙舞爪地向$n" + HIB + "呼啸着！\n\n" NOR, me, target);
  }
  where = environment(target);
  for (j = 1; j <= i; j++) {
    if (!me || !target) return 0;
    if (environment(me) != environment(target)) return 0;
    if (environment(target) != where) return 0;
    seteuid(getuid());
    attacker = new(npc_dir + j);
    attacker->move(environment(me));
    attacker->add("combat_exp", j * myexp / 10);
    //   skill1 = (int)attacker->query_skill("unarmed",1)+(int)attacker->query_skill("dragonfight",1)+(int)attacker->query_skill("dragonforce",1);
    damage = COMBAT_D->do_attack(attacker, target, attacker->query_temp("weapon"));
    if (wizardp(me) && me->query("env/combat") == "verbose")
      tell_object(me, sprintf(HIG "damage: %d\n" NOR, damage));

    if (target->query_temp("last_damage_from") == attacker)
      target->set_temp("last_damage_from", me);
    if (target->query_temp("last_fainted_from") == attacker)
      target->set_temp("last_fainted_from", me->query("id"));
    destruct(attacker);
  }
  call_out("check", 2, me, target);
  message_vision(
    HIY "那感性的神龙在$N" + HIY + "眼前一览，便带$n" + HIY + "进入了另一个空间--耳边响起雷鸣般的水声，也感受到了不同\n" NOR,
    me,
    target
  );
  message_vision(
    HIY "寻常的空气，眼前是一幅壮丽山河--" + HIW + "『飞流直下三千尺，疑是银河落九天』" + HIY + "--的中国庐山瀑布！\n\n" NOR,
    me,
    target
  );
  dragonfight_level = (int)me->query_skill("dragonfight", 1) - 100;
  dragonfight_level = dragonfight_level / 50;
  if (dragonfight_level > 9) dragonfight_level = 9;
  desc_msg = chinese_number(dragonfight_level);
  if ((!target || target->query("eff_kee") < 0 || !living(target)) && random(5) == 1) {
    if (dragonfight_level >= 1) {
      str = HIM + me->name() + HIM + "竟然使出了东海秘传之能令大瀑布也逆流的无敌一击" NOR + HIC + "「庐山升龙霸」" + HIM + "，" + desc_msg + "条金灿灿的巨龙在天空翱翔了好一阵才散去!" NOR;
      message("channel:rumor", HIM "【空穴来风】某人：" + str + "\n" NOR, users());
    }
  }
  me->start_busy(2 + random(1));
  me->set_temp("shenglong_end", time());
  return 1;
}
