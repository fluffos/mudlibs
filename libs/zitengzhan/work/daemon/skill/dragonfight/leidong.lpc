#include <ansi.h>
inherit SSERVER;
#include "/daemon/skill/eff_msg.h";

int def;
int perform(object me, object target) {
  string msg;
  int damage, p, myexp, youexp, mystr, myforce, mz;
  if (!target) target = offensive_target(me);
  if (!target || !target->is_character()
    || !me->is_fighting(target) || !living(target))
    return notify_fail("「雷动九天」只能在战斗中使用。\n");
  if (me->query("family/family_name") != "东海龙宫")
    return notify_fail("非龙宫弟子不能用「雷动九天」！\n");
  if ((int)me->query_skill("dragonfight", 1) < 100 ||
    (int)me->query_skill("unarmed", 1) < 100
  )
    return notify_fail("你有的功夫还不够娴熟，不会使用「雷动九天」。\n");
  if (me->query_skill("force", 1) < 100)
    return notify_fail("以你现在的内功修为还使不出「雷动九天」。\n");
  if (me->query_skill_mapped("unarmed") != "dragonfight")
    return notify_fail("你现在无法使用「雷动九天」进行攻击。\n");
  if ((int)me->query("max_force") < 1200)
    return notify_fail("你的内力修为太弱，不能使用「雷动九天」！\n");
  if ((int)me->query("force") < 600)
    return notify_fail("你的真气不够！\n");
  if (time() - (int)me->query_temp("leidong_end") < 7)
    return notify_fail("绝招用多就不灵了！\n");
  if ((int)me->query_temp("lsnh"))
    return notify_fail("你已陷入疯狂状态，无法使用雷动九天！\n");

  me->set_temp("leidong_end", time());
  msg = RED "\n 突然$N" + RED + "大喝一声:「雷动」,面色唰的变得通红,须发皆飞,浑身上下充满杀气,\n" NOR;
  message_vision(msg, me, target);
  msg = YEL "\n        “嗡”的一声，一掌凌空击向$n" + YEL + "的胸口！\n" NOR;
  me->add_temp("mingzhong", 40);
  mz = me->query_temp("mingzhong");
  if (mz < 0) mz = 0;
  mystr = me->query_str();
  myforce = me->query("str");
  if (!userp(me)) myforce = myforce / 2;
  damage = mystr * myforce / 10;
  damage += me->query_skill("unarmed");
  youexp = (int)target->query("combat_exp") / 100;
  if (youexp < 2) youexp = 2;
  myexp = (int)me->query("combat_exp") / 100;
  if (myexp < 2) myexp = 2;
  myexp += myexp / 100 * mz;
  damage = damage / 2 + random(damage / 2);
  if (damage < 2) damage = 2;
  if (myexp / 2 + random(myexp / 2) > youexp / 2 + random(youexp / 2) || target->query_temp("unconcious")) {
    if (wizardp(me) && me->query("env/combat") == "verbose")
      tell_object(me, sprintf(HIM + BLINK + "damage: %d\n" NOR, damage));
    target->receive_damage("kee", damage, me);
    target->receive_wound("kee", damage / 2, me);
    me->add("force", -200);
    p = (int)target->query("kee") * 100 / (int)target->query("max_kee");
    msg += damage_msg(damage, "内伤");
    msg += "( $n" + eff_status_msg(p) + " )\n";
    target->set_temp("last_damage_from", me);
  } else {
    msg += HIY "可是$p" + HIY + "伏地一滚，躲开了对手的攻击。\n" NOR;
  }
  message_vision(msg, me, target);
  if (me->query_skill("dragonfight", 1) > 149) {
    if (myexp / 2 + random(myexp / 2) > youexp / 2 + random(youexp / 2) || target->query_temp("unconcious")) {
      if (!target || !living(target))
        return notify_fail("对手已经不能再战斗了。\n");
      if ((int)me->query("force", 1) < 500)
        return notify_fail("你待要再出第二击，却发现自己的内力不够了！\n");
      msg = MAG "\n只见$N" + MAG + "衣袍鼓起，猎猎飞舞，身子凌空飞起，又是一声大吼「九天」，\n" NOR;
      message_vision(msg, me, target);
      msg = CYN "\n       “哗”的挥出九个光圈，居高临下，直向$n" + CYN + "逼来。\n" NOR;
      if (wizardp(me) && me->query("env/combat") == "verbose")
        tell_object(me, sprintf(HIM + BLINK + "damage: %d\n" NOR, damage));
      target->receive_damage("kee", damage, me);
      target->receive_wound("kee", damage / 2, me);
      me->add("force", -300);
      p = (int)target->query("kee") * 100 / (int)target->query("max_kee");
      msg += damage_msg(damage, "内伤");
      msg += "( $n" + eff_status_msg(p) + " )\n";
      target->set_temp("last_damage_from", me);
    } else {
      msg += HIY "可是$p" + HIY + "纵身一跃，躲开了对手的攻击。\n" NOR;
    }
    message_vision(msg, me, target);
  }
  me->add_temp("mingzhong", -40);
  me->start_busy(2);
  me->set_temp("leidong_end", time());
  return 1;
}
