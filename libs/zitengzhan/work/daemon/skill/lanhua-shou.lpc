#include <ansi.h>
#include <combat.h>
inherit SKILL;
string *xue_name = ({ 
HIR"劳宫穴"NOR,HIR"膻中穴"NOR,HIR"曲池穴"NOR,
HIG"关元穴"NOR,HIG"曲骨穴"NOR,HIG"中极穴"NOR,
HIY"承浆穴"NOR,HIY"天突穴"NOR,HIY"百会穴"NOR,
HIM"幽门穴"NOR,HIM"章门穴"NOR,HIM"大横穴"NOR,
HIW"紫宫穴"NOR,HIW"冷渊穴"NOR,HIW"天井穴"NOR,
HIC"极泉穴"NOR,HIC"清灵穴"NOR,HIC"至阳穴"NOR,});

mapping *action = ({
        ([      "action":               "$N二手合十，一式"+MAG+"「莲花座」"+NOR+"，双拳蓄势而发，击向$n的$l",
                "dodge":                -10,
                "parry":                10,
                "force":                40,
                "damage_type":  "刺伤",
                        "weapon":               "右手食指",
        ]),
        ([      "action":               "$N腾空飞起，一式"+MAG+"「五指山」"+NOR+"，攻向$n的身前身后",
                "dodge":                -20,
                "parry":                -20,
                "force":                40,
                "damage_type":  "内伤",
                        "weapon":               "左手", 
        ]),
            ([  "action":               "$N一式"+MAG+"「观音渡」"+NOR+"，两手十指虚点$n的全身三十六道要穴",
                "dodge":                30,
                "parry":                -10,
                "force":                50,
                "damage_type":  "内伤",
                        "weapon":               "左手",
        ]),
            ([  "action":               "$N两目内视，双手内笼，一式"+MAG+"「天龙唱」"+NOR+"，四面八方响起震人心魄的龙吟",
                "dodge":                10,
                "parry":                -10,
                "force":                45,
                "damage_type":  "砍伤",
                        "weapon":               "右手",
        ]),
        ([  "action":   "$N似笑非笑，双拳无形无定，一式"+MAG+"「如来笑」"+NOR+"，骤然击向$n的前胸",
                "dodge":                -50,
                "parry":                -50,
                "force":                50,
                "damage_type":  "内伤",
         ]),
});

mapping *action_sizijue = ({
([  "action" : HIY+BLINK+"○快○"+NOR+MAG+"    $N"+NOR+MAG+"出手如风，十指微微抖动，点向$n"+NOR+MAG+"的"+NOR+xue_name[random(sizeof(xue_name))], 
    "force" :  50,
    "dodge" : -80,
    "damage_type" : "内伤",
    "parry" : -80,
    "skill_name" : "快字决" ,
]),
([  "action" : HIY+BLINK+"○准○"+NOR+MAG+"    $N"+NOR+MAG+"身形微晃，右手五指直取$n"+NOR+MAG+"的"+NOR+xue_name[random(sizeof(xue_name))],
    "force" :  50,
    "dodge" : -90,
    "damage_type" : "内伤",
    "parry" : -80,
    "skill_name" : "准字决" ,
]),
([  "action" : HIY+BLINK+"○奇○"+NOR+MAG+"    $N"+NOR+MAG+"突然双手平举，$n"+NOR+MAG+"愣神之间，$N"+NOR+MAG+"嗖的一下将双手    
收回胸前，直拂向$n"+NOR+MAG+"的"+NOR+xue_name[random(sizeof(xue_name))],
    "force" :  40,
    "dodge" : -80,
    "damage_type" : "内伤",
    "parry" : -90,
    "skill_name" : "奇字决" ,
]),
([  "action" : HIY+BLINK+"○清○"+NOR+MAG+"    $N"+NOR+MAG+"双掌翻飞，激起漫天的劲风，扫向$n"+NOR+MAG+"的"+NOR+xue_name[random(sizeof(xue_name))],
    "force" :  40,
    "dodge" : -90,
    "damage_type" : "内伤",
    "parry" : -90,
    "skill_name" : "清字决" ,
]),
});

int valid_learn(object me)
{
        if( (string)me->query_skill_mapped("force")!= "jiuyin-xinjing")
     return notify_fail("兰花手必须配合九阴心经才能练。\n");
        if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
                return notify_fail("练兰花手必须空手。\n");
        return 1;
}

int valid_enable(string usage)
{
        return usage=="unarmed";
}

mapping query_action(object me, object weapon)
{
    int i=me->query_temp("lanhuashou_pfm");
    if(me->query_temp("lanhuashou_pfm") )
          return action_sizijue[i-1];
    else
          return action[random(sizeof(action))];
}

int practice_skill(object me)
{

        if( (int)me->query("kee") < 30
        ||      (int)me->query("force") < 5 )
                return notify_fail("你的内力或气不够，没有办法练习兰花手。\n");
        me->receive_damage("kee", 30);
        me->add("force", -5);
        write("你按着所学练了一遍兰花手。\n");
        return 1;

}

string perform_action_file(string func)
{
return __DIR__"lanhua-shou/" + func;
}


