// sanqing.c 一剑化三清
//modify for 大唐西游2 by huarong 2003/12
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SSERVER;
 
int perform(object me, object target)
{
        object weapon;
        string msg;
        int skill;
 	 if( !target ) target = offensive_target(me);
        if( !target || !target->is_character()||target->is_corpse()||target==me)
          return notify_fail("你要攻击谁？\n");

        if( !me->is_fighting() )
                return notify_fail("「一剑化三清」只能在战斗中使用。\n");
 
        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "sword")
                return notify_fail("「一剑化三清」开始时必须拿着一把剑！\n");
        
        if( (int)me->query("force") < 300 )
                return notify_fail("你的内力不够！\n");

        if( (int)me->query_skill("sanqing-jian",1) < 60 )
                return notify_fail("你的三清剑法还不到家，无法使用「一剑化三清」！\n");

        if( time()-(int)me->query_temp("sq_end") < 6 )
                return notify_fail("绝招用多就不灵了！\n");
     

	 skill = (int)me->query_skill("sword",1)/2+(int)me->query_skill("sanqing-jian",1)/2;
        msg = HIB+"\n$N"+HIB+"使出三清剑法的绝技"+NOR+RED+"「一剑化三清」"+HIB+"，一招连环三剑，手中的"+ weapon->name()+HIB+"已然出鞘！\n" NOR;
        message_vision(msg, me,target);
        me->add_temp("apply/attack", skill);
        target->add_temp("apply/dodge",-skill);
        target->add_temp("apply/parry",-skill);
        msg = HIY "\n只见$N"+HIY+"右手一抖，"+ weapon->name()+ HIR"第一剑"+HIY+"刺向$n"+HIY+"的左肩！" NOR;
        message_vision(msg, me,target);
               COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR);
        msg =  HIW "\n$N"+HIW+"凌空使出"+HIB+"第二剑"+HIW+","+ weapon->name()+ HIW"削向$n"+HIW+"的右肩！" NOR;
        message_vision(msg, me,target);
       	 COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR);
        msg = HIC "\n$N"+HIC+"清啸一声，聚气于剑，朝$n"+HIC+"的胸前攻出"+HIM+"第三剑"+HIC+"！" NOR;
        message_vision(msg, me,target);
              COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR);
        me->add("force", - 100);
        me->add_temp("apply/attack",-skill);
        target->add_temp("apply/dodge",skill);
        target->add_temp("apply/parry",skill);
        me->start_busy(1+random(2));
        me->set_temp("sq_end",time());

        return 1;
}

