//modify for 大唐西游2 by huarong 2003/12

#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int extra, lvl;
  int i;
  object weapon;

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("无边地狱只能对战斗中的对手使用。\n");
  //if(me->query("family/family_name")!="陷空山无底洞")
  if (!PFM_D->valid_family(me, "陷空山无底洞"))
    return notify_fail("“无边地狱”只有无底洞门人才可以用！\n");
  weapon = me->query_temp("weapon");
  if ((string)weapon->query("skill_type") != "blade")
    return notify_fail("你手上无刀，不能使用无边地狱！\n");
  if ((int)me->query("force") <= 1000)
    return notify_fail("你内力不够，不能使用无边地狱！\n");
  if ((int)me->query_skill("kugu-blade", 1) < 120)
    return notify_fail("你的枯骨刀修为不够深，还使不出这一招！\n");
  if ((int)me->query_skill("blade", 1) < 120)
    return notify_fail("你的基本刀法修为不够深，还使不出这一招！\n");
  //if( time()-(int)me->query_temp("diyu_end") < 5 )
  //      return notify_fail("绝招用多就不灵了！\n");

  message_brief(me, target, "枯骨刀", "「无边地狱」");

  extra = me->query_skill("kugu-blade", 1) / 4;
  me->add_temp("apply/damage", extra);
  me->set_temp("wddpfm", 1);  //这里禁止zxzx的效果，见combatd.c   huarong 2003.12
  msg = HIR "$N使出［枯骨刀法］的无边地狱，手中的" + weapon->name() + HIR "斜斜劈出，$n顿觉呼吸一窒！\n" NOR;
  msg += HIW "$N刀光连闪，$n周围鬼哭神号，恰似无边地狱！\n" NOR;
  message_vision(msg, me, target, 0, "env/brief_perform");
  lvl = extra * 4 / 30;
  if (lvl > 9) lvl = 9;
  for (i = 0; i <= lvl; i++) {
    if (!target) return 1;
    msg = HIY "$N劈出一刀！\n" NOR;
    COMBAT_D->do_attack(me, target, weapon, 0, "env/brief_perform");
    message_vision(msg, me, target, 0, "env/brief_perform");
  }
  me->add_temp("apply/damage", -extra);
  me->add("force", -1 * random(400));
  me->start_busy(2);
  return 1;
}
