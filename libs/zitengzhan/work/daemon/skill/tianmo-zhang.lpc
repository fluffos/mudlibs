//tianmo-zhang.c【天魔掌】, weiqi...980213

inherit SKILL;

mapping *action = ({
  ([ "action":
    "$N双手划出一个大圆，然后缓缓推向$n，虽然速度不快，但$n却觉得四周都已经被$N的掌风笼罩住了",
    "dodge": 10,
    "parry": 5,
    "force": 110,
    "damage_type": "内伤"
  ]),
  ([ "action":
    "只见$N大喝一声，双脚如涡轮一般踢向$n，$n堪堪躲过这轮攻击，谁知$N的[腿中拳]却又已杀到",
    "dodge": 5,
    "parry": 5,
    "force": 80,
    "damage_type": "砸伤"
  ]),
  ([ "action":
    "$N双掌急挥，霎时间$n感觉自己也被卷入$N的双掌之中，仓皇间，$N的一指已直奔$n$l",
    "dodge": 5,
    "parry": 5,
    "force": 60,
    "damage_type": "内伤"
  ]),
  ([ "action":
    "$N双手再度划出一个大圆，$n以为$N还要双掌推出，却不料$N双脚已如黑云一般袭来",
    "dodge": 5,
    "parry": 5,
    "force": 80,
    "damage_type": "内伤"
  ]),
});

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("不空手无法练天魔掌。\n");
  return 1;
}

int valid_enable(string usage) {
  return usage == "unarmed";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((int)me->query("sen") < 30)
    return notify_fail("你的精神无法集中了，休息一下再练吧。\n");
  if ((int)me->query("kee") < 30)
    return notify_fail("你现在手足酸软，休息一下再练吧。\n");
  if ((int)me->query("force") < 10)
    return notify_fail("你的内力不够了。\n");

  me->receive_damage("kee", 30);
  me->add("force", -10);

  return 1;
}
