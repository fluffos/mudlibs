#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit SSERVER;

int get_current_day_phase();
nosave mapping *day_phase = NATURE_D->query_day_phase(); 

string *sun_f = ({
HIG"\n$N"+HIG+"鞭势之间生出兰花灿烂，$n"+HIG+"发现$N"+HIG+"换了招数，立刻远远躲了开去！\n" NOR,
HIC"\n$N"+HIC+"招数虽然变化无穷却是以劈刺为主，$n"+HIC+"立时觉察到了四周的剑气，！\n"NOR,
HIM"\n$N"+HIM+"依然使着银索金铃的招数，$n"+HIM+"却觉察到了剑气，便小心注意着$N"+HIM+"的招数！\n"NOR,
HIY"\n$N"+HIY+"使出银索金铃的招数，暗合五韵易理，铃声叮当，$n"+HIY+"却从五韵之中发现了$N"+HIY+"的破绽！\n"NOR,
HIB"\n$N"+HIB+"突然将银索金铃缠回手腕，$n"+HIB+"觉得四周暗劲汹涌，立刻运气护住全身！\n"NOR,
HIW"\n$N"+HIW+"招数依旧，$n"+HIW+"觉得$N"+HIW+"杀气全消，头上一座五指山压下，$n"+HIW+"一个鱼跃跳了开去！\n"NOR,
});
int perform(object me, object target)
{       
        string msg,kind,dodge_skill;
  int damage, qin,i,k,maxhit,myexp,youexp,ratio,t,skill;
        int chixinjian,qingxiajian,yinsuojinling,lanhuashou,jiuyinxinjing,pansidafa;
        int phase = get_current_day_phase(); 
        object weapon = me->query_temp("weapon");  
        
/*      if(!me->query("fenghua_known"))
           return notify_fail("你还没有学会"+HIW+"「风华乱舞」"+NOR+"。。。\n"); */
        if( !target ) target = offensive_target(me);
        
        if( !target || !target->is_character()
           || !me->is_fighting(target) || !living(target) )
                return notify_fail(HIW+"「风华乱舞」"+NOR+"只能在战斗中使用。\n");
                
        if (!present("wuxian qin", me))
                return notify_fail("你手中无琴如何施展"+HIW+"「风华乱舞」"+NOR+"?\n");
                       
        if((int)me->query_skill("unarmed", 1) < 250 ||
           (int)me->query_skill("sword", 1) < 250 ||
           (int)me->query_skill("whip",1) < 250)
                return notify_fail("你的基本功夫学的不到家，无法使用"+HIW+"「风华乱舞」"+NOR+"!\n");

        if((int)me->query_skill("lanhua-shou", 1) < 250 ||
           (int)me->query_skill("qingxia-jian", 1) < 250 ||
           (int)me->query_skill("yinsuo-jinling",1) < 250||
           (int)me->query_skill("jiuyin-xinjing",1) < 250||
           (int)me->query_skill("pansi-dafa",1) < 250||
           (int)me->query_skill("chixin-jian",1) < 250)
                return notify_fail("你盘丝洞的功夫学的不到家，无法使用"+HIW+"「风华乱舞」"+NOR+"!\n");
        
        if((int)me->query_skill("qin",1) < 200)
                return notify_fail("你不通音律，无法使用"+HIW+"「风华乱舞」"+NOR+"!\n");
 
//      if(me->query("gender")!="女性")
//              return notify_fail("你一个大男人，怎么能懂得女儿家的心事！");
        //haaa,让那些家伙去哭吧，没事乱加的，要不你自己想boy的描述吧！我看这个样子也不错，嘿嘿
/*        if(weapon->query("id")!="yinsuo jinling")
                return notify_fail("除了银索金铃，好像还没有听说什么武器可以与五韵相通呀！");   */
        if(me->query("family/family_name")!="盘丝洞")
                return notify_fail(HIW"「风华乱舞」"+NOR+"只有盘丝洞弟子才可以用！\n");
        if( (int)me->query("max_force") < 2000 )
                return notify_fail("你的内力修为太弱，根本使不出"+HIW+"「风华乱舞」"+NOR+"！\n");
        if( (int)me->query("force") < 2000 )
                return notify_fail("你的真气不够！\n");
        if( time()-(int)me->query_temp("fenghua_end") < 8 )
                return notify_fail("绝招用多就不灵了！\n");
                
if (me->query("lunhui_zhuanshi") < 1){
t=2;}
if (me->query("lunhui_zhuanshi") == 1){
t=3;}
if (me->query("lunhui_zhuanshi") == 2){
t=4;}
if (me->query("lunhui_zhuanshi") > 2){
t=6;}
        qin = me->query_skill("qin",1);
        chixinjian=(int)me->query_skill("chixin-jian",1);
        qingxiajian=(int)me->query_skill("qingxia-jian",1);
        lanhuashou=(int)me->query_skill("lanhua-shou",1);                
        yinsuojinling=(int)me->query_skill("yinsuo-jinling",1);                
        jiuyinxinjing=(int)me->query_skill("jiuyin-xinjing",1);                
        pansidafa=(int)me->query_skill("pansi-dafa",1);                
        i=(int)qin/50;
        myexp=(int)me->query("combat_exp",1)/100; //防止溢出所以除以100
        youexp=(int)target->query("combat_exp",1)/100;
        ratio=to_int((to_float(myexp)/10)/(to_float(youexp)/1000));
        if(weapon->query("id")!="yinsuo jinling")
        ratio=ratio*5/4;
        if (ratio>200) ratio=200;
        if (ratio<20)  ratio=20;
        skill=(int)me->query_skill("yinsuo-jinling",1)/2+(int)me->query_skill("qin",1)+(int)me->query_skill("jiuyin-xinjing",1)/2;
          
        if(random(target->query_per())<=me->query("per") && (phase<0 || phase>5)) 
        //夜晚才能出这个,希望降低一下妖怪的per，不然自己也取后天的了...
        //同时目前想到的只是girl的描述，boy的还没想呢
        {
                kind="moon";
                msg = HIC"\n$N"+HIC+"合着清脆的金铃，轻声念了一句：长天净，绛河清浅，皓月蝉娟。\n" NOR;
                msg = msg + HIC"清风倏起，天空立时明净了许多，月华仿佛也越来越浓了！\n"NOR;
                msg = msg + HIC"$n"+HIC+"听得风似丝竹，见得羽衣轻舞，月华中容颜绝世，心便醉了。\n"NOR;
        }
        else if(random(target->query_per())<=me->query("per") && phase>=0 && phase<=6)
        {
                kind="sun";
                msg = HIY"\n$N"+HIY+"合着欢快的金铃，轻声念了一句：云想衣裳花想容，春风拂槛露华浓。\n" NOR;
                msg = msg + HIY"舞动的金铃循着欢快的轨迹折射阳光，$N的身形渐渐消失在一片金光之中！\n"NOR;
                msg = msg + HIY"$n"+HIY+"觉得那金光虽然明亮却不刺目，耳边铃声悦耳，心中杀意渐消。\n"NOR;
        }
        else 
        {       
                kind="rain";
                msg = HIB"\n$N"+HIB+"合着忧伤的金铃，轻声念了一句：七月七日长生殿，夜半无人私语时。\n"NOR;
                msg = msg + HIB"刹那间，天空中阴云聚合，不一会便下起了密密细雨！\n"NOR;
                msg = msg + HIB"$n"+HIB+"只觉得四周突然鬼气森然，细听雨声，竟如夜半冤魂血泣，立时打了几个冷战。\n"NOR;
        }
        msg = msg + WHT"\n\n$n"+WHT+"眼见$N"+WHT+"竟自轻歌曼舞，思量之时才知自己无法看穿$N"+WHT+"的心意，不禁有些心慌！\n\n"NOR;
        message_vision(msg, me, target);

   if (random(myexp+youexp)>youexp)
     {
        if(kind=="sun")
        {
                msg = HIY"$N"+HIY+"一声清啸，$n"+HIY+"眼前金光大盛，不禁慌了手脚，$N"+HIY+"展开了强大的攻势。\n"NOR;
                message_vision(msg, me, target);
                maxhit=0;
                for(k=0;k<=i;k++)
                {
                        if(random(target->query_skill("dodge",1))<me->query_skill("sword",1))
                        {
                                maxhit=maxhit+1;
                        }       
                }

                if(maxhit==0)
                {
                        message_vision(sun_f[random(sizeof(sun_f))], me, target);               
                        msg=HIC"\n$n"+HIC+"侥幸躲过了$N"+HIC+"狂风暴雨般的攻击，脸上已经满是汗水。\n"NOR;
                        msg=msg+WHT"\n$N"+WHT+"见$n"+WHT+"竟然躲过了阳光的攻势，只能长叹一声：天意如此！\n"NOR;
                }
                else
                {
                   for (k=1;k<=maxhit;k++)
                   {
                    switch(random(5))
                      {
                        case 0:
                        {
                        msg=HIM"\n$N"+HIM+"使出痴心情长剑的招数，$n"+HIM+"却觉得四周剑气纵横，一不留神被一道紫色剑气击中！\n"NOR;     
                        message_vision(msg, me, target);
                        damage=chixinjian;                      
                        damage=damage/2+random(damage/2);                       
 damage=damage*t*ratio/50;
                        target->receive_damage("kee",damage,me);
                        target->receive_wound("kee",damage/2+random(damage/2),me);
                        COMBAT_D->report_status(target);
                        break;
                        };
                        case 1:
                        {
                        msg=HIY"\n$N"+HIY+"招式之间生出朵朵金色兰花，$n"+HIY+"还没反应过来，兰花便已透体而入！\n" NOR;  
                        message_vision(msg, me, target);
                        damage=lanhuashou;
                        damage=damage+random(damage/2);                 
 damage=damage*t*ratio/50;
                        target->receive_damage("kee",damage,me);
                        COMBAT_D->report_status(target);
                        break;
                        }
                        case 2:
                        {
                        msg=HIY"\n$N"+HIY+"使出痴心情长剑的招数，暗合五韵易理，铃声叮当，$n"+HIY+"却听得心烦意乱！\n"NOR;
                        message_vision(msg, me, target);
                        damage=(chixinjian+yinsuojinling)/2;                    
                        damage=damage/2+random(damage/2);                       
 damage=damage*t*ratio/50;
                        target->receive_damage("sen",damage,me);
                        target->receive_wound("sen",damage/2+random(damage/2),me);
                        COMBAT_D->report_sen_status(target);
                        break;
                        };
                        case 3:
                        {
                        msg=HIB"\n$N"+HIB+"突然将银索金铃缠回手腕，$n"+HIB+"觉得四周暗劲汹涌，胸口一震，已被九阴心经内力所伤！\n"NOR;
                        message_vision(msg, me, target);
                        damage=jiuyinxinjing;
                        damage=damage+random(damage/2);                 
 damage=damage*t*ratio/50;
                        target->receive_damage("kee",damage,me);                        
                        target->receive_wound("kee",damage,me);
                        COMBAT_D->report_status(target,1);
                        break;
                        };
                        case 4:
                        {
                        msg=HIW"\n$N"+HIW+"招数依旧，$n"+HIW+"却觉得杀气全消，正自不解，一座五指山当头压下，原来$N"+HIW+"暗自发动了盘丝大法！\n"NOR;
                        message_vision(msg, me, target);
                        damage=pansidafa;
                        damage=damage/2+random(damage/2);                       
 damage=damage*t*ratio/50;
                        target->receive_damage("kee",damage,me);                        
                        target->receive_wound("kee",damage,me);
                        target->receive_damage("sen",damage,me);                        
                        target->receive_wound("sen",damage,me);
                        COMBAT_D->report_status(target);
                        COMBAT_D->report_sen_status(target);
                        break;
                        };
                      }
                    if (wizardp(me) && me->query("env/combat")=="verbose")
                        tell_object(me, sprintf(HIM+BLINK+"damage: %d\n" NOR, damage));
                    }
                        msg=HIR"\n$n腾挪闪跃，竭力招架，始终脱不出$N布下"+BLINK+HIY+"『风华乱舞·阳光』"+NOR+HIR"！\n"NOR;
                        msg=msg+WHT"\n$N"+WHT+"轻叹一声：天意不可违，你就任命吧！\n"NOR;
                }
                message_vision(msg, me, target);
        }
        else if(kind=="moon")
        {
                msg = HIC"$N"+HIC+"缓缓对$n"+HIC+"说道：能不能躲过"+BLINK+HIM+"『风华乱舞·影月』"+NOR+HIC"，就看你的造化了。言罢展开了攻势。\n"NOR;
                message_vision(msg, me, target);
                maxhit=0;
                for(k=0;k<=i;k++)
                {
                        if(random(target->query_skill("dodge",1))<me->query_skill("sword",1))
                        {
                                maxhit=maxhit+1;
                        }       
                }
                if(maxhit==0)
                {
                        message_vision(sun_f[random(sizeof(sun_f))], me, target);               
                        msg=HIB"\n$n"+HIB+"侥幸躲过了$N"+HIB+"狂风暴雨般的攻击，脸上已经满是汗水。\n"NOR;
                        msg=msg+WHT"\n$N"+WHT+"见$n"+WHT+"竟然躲过了影月的攻势，只能长叹一声：天意如此！\n"NOR;
                }
                else
                {
                   for (k=1;k<=maxhit;k++)
                   {
                   switch(random(5))
                      {
                        case 0:
                        {
                        msg=HIC"\n$N"+HIC+"使出青霞剑法的招数，$n"+HIC+"却觉得四周剑气纵横，一不留神一道青色剑气击中！\n"NOR;        
                        message_vision(msg, me, target);
                        damage=qingxiajian;                     
                        damage=damage/2+random(damage/2);                       
 damage=damage*t*ratio/50;
                        target->receive_damage("kee",damage,me);
                        target->receive_wound("kee",damage/2+random(damage/2),me);
                        COMBAT_D->report_status(target);
                        break;
                        };
                        case 1:
                        {
                        msg=HIY"\n$N"+HIY+"招式之间生出朵朵金色兰花，$n"+HIY+"还没反应过来，兰花便已透体而入！\n" NOR;  
                        message_vision(msg, me, target);
                        damage=lanhuashou;
                        damage=damage+random(damage/2);                 
 damage=damage*t*ratio/50;
                        target->receive_damage("kee",damage,me);
                        COMBAT_D->report_status(target);
                        break;
                        };
                        case 2:
                        {
                        msg=HIY"\n$N"+HIY+"使出青霞剑法的招数，暗合五韵易理，铃声叮当，$n"+HIY+"却听得心烦意乱！\n"NOR;
                        message_vision(msg, me, target);
                        damage=(qingxiajian+yinsuojinling)/2;                   
                        damage=damage/2+random(damage/2);                       
 damage=damage*t*ratio/50;
                        target->receive_damage("sen",damage,me);
                        target->receive_wound("sen",damage/2+random(damage/2),me);
                        COMBAT_D->report_sen_status(target);
                        break;
                        };
                        case 3:
                        {
                        msg=HIB"\n$N"+HIB+"突然将银索金铃缠回手腕，$n"+HIB+"觉得四周暗劲汹涌，胸口一震，已被九阴心经内力所伤！\n"NOR;
                        message_vision(msg, me, target);
                        damage=jiuyinxinjing;
                        damage=damage+random(damage/2);
 damage=damage*t*ratio/50;
                        target->receive_damage("kee",damage,me);                        
                        target->receive_wound("kee",damage,me);
                        COMBAT_D->report_status(target,1);
                        break;
                        };
                        case 4:
                        {
                        msg=HIW"\n$N"+HIW+"招数依旧，$n"+HIW+"却觉得杀气全消，正自不解，一座五指山当头压下，原来$N"+HIW+"暗自发动了盘丝大法！\n"NOR;
                        message_vision(msg, me, target);
                        damage=pansidafa;
                        damage=damage/2+random(damage/2);                       
 damage=damage*t*ratio/50;
                        target->receive_damage("kee",damage,me);                        
                        target->receive_wound("kee",damage,me);
                        target->receive_damage("sen",damage,me);                        
                        target->receive_wound("sen",damage,me);
                        COMBAT_D->report_status(target);
                        COMBAT_D->report_sen_status(target);
                        break;
                        };
                      }
                    if (wizardp(me) && me->query("env/combat")=="verbose")
                        tell_object(me, sprintf(HIM+BLINK+"damage: %d\n" NOR, damage));
                   }
                        msg=HIR"\n$n"+HIR+"腾挪闪跃，竭力招架，始终脱不出$N"+HIR+"的攻势！\n"NOR;
                        msg=msg+WHT"\n$N"+WHT+"轻叹一声：既然天意如此，你也不要太伤心了！\n"NOR;
                }
                message_vision(msg, me, target);
        }
        else
        {
                msg = HIB"$N"+HIB+"阴森森地对$n"+HIB+"说道：能死在"+BLINK+HIR+"『风华乱舞·妖雨』"+NOR+HIB"之下也是你的福气，拿命来吧！\n"NOR;
                message_vision(msg, me, target);
                maxhit=0;

                for(k=0;k<=i;k++)
                {
                        if(random(target->query_skill("dodge",1))<me->query_skill("whip",1))
                        {
                                maxhit=maxhit+1;
                        }       
                }
                if(maxhit==0)
                {
                        message_vision(sun_f[random(sizeof(sun_f))], me, target);               
                        msg=HIY"\n$n"+HIY+"侥幸躲过了$N"+HIY+"狂风暴雨般的攻击，脸上已经满是汗水。\n"NOR;
                        msg=msg+WHT"\n$N"+WHT+"见$n"+WHT+"竟然躲过了妖雨的攻势，冷笑一声：看你下次还能不能这么好运！\n"NOR;
                }
                else
                {
                   for (k=1;k<=maxhit;k++)
                   {
                    switch(random(5))
                      {
                        case 0:
                        {
                        msg=HIM"\n$N"+HIM+"使出天罗地网的招数，$n"+HIM+"却觉得四周银圈密布，被压得喘不过气来！\n"NOR;               
                        message_vision(msg, me, target);
                        damage=yinsuojinling;
                        damage=damage/2+random(damage/2);                       
 damage=damage*t*ratio/50;
                        target->receive_damage("kee",damage,me);
                        target->receive_wound("kee",damage/2+random(damage/2),me);
                        COMBAT_D->report_status(target);
                        break;
                        };
                        case 1:
                        {
                        msg=HIB"\n$N"+HIB+"出招劲风凛然带动四周的雨丝，数招之间形成了一朵雨兰将$n"+HIB+"笼罩当中！\n" NOR;
                        message_vision(msg, me, target);
                        damage=lanhuashou;
 damage=damage+random(damage);                 
 damage=damage*t*ratio/50;
                        target->receive_damage("kee",damage,me);
                        COMBAT_D->report_status(target);
                        break;
                        };
                        case 2:
                        {
                        msg=HIY"\n$N"+HIY+"使出银索金铃的招数，暗合五韵易理，铃声叮当，$n"+HIY+"却听得心烦意乱！\n"NOR;
                        message_vision(msg, me, target);
                        damage=(chixinjian+yinsuojinling)/2;                    
                        damage=damage/2+random(damage/2);                       
 damage=damage*t*ratio/50;
                        target->receive_damage("sen",damage,me);
                        target->receive_wound("sen",damage/2+random(damage/2),me);
                        COMBAT_D->report_sen_status(target);
                        break;
                        };
                        case 3:
                        {
                        msg=HIB"\n$N"+HIB+"突然将银索金铃缠回手腕，$n"+HIB+"觉得四周暗劲汹涌，胸口一震，已被九阴心经内力所伤！\n"NOR;
                        message_vision(msg, me, target);
                        damage=jiuyinxinjing;
                        damage=damage+random(damage/2);                 
 damage=damage*t*ratio/50;
                        target->receive_damage("kee",damage,me);                        
                        target->receive_wound("kee",damage,me);
                        COMBAT_D->report_status(target,1);
                        break;
                        };
                        case 4:
                        {
                        msg=HIW"\n$N"+HIW+"招数依旧，$n"+HIW+"却觉得杀气全消，正自不解，一座五指山当头压下，原来$N"+HIW+"暗自发动了盘丝大法！\n"NOR;
                        message_vision(msg, me, target);
                        damage=pansidafa;
                        damage=damage/2+random(damage/2);                       
 damage=damage*t*ratio/50;
                        target->receive_damage("kee",damage,me);                        
                        target->receive_wound("kee",damage,me);
                        target->receive_damage("sen",damage,me);                        
                        target->receive_wound("sen",damage,me);
                        COMBAT_D->report_status(target);
                        COMBAT_D->report_sen_status(target);
                        break;
                        };
                      }
                    if (wizardp(me) && me->query("env/combat")=="verbose")
                        tell_object(me, sprintf(HIM+BLINK+"damage: %d\n" NOR, damage));
                   }      
                        msg=HIR"\n$n"+HIR+"腾挪闪跃，竭力招架，始终脱不出$N"+HIR+"的攻势！\n"NOR;
                        msg=msg+WHT"\n$N"+WHT+"不屑地说到：你这样的水平，简直是浪费妖雨！\n"NOR;
                }
                message_vision(msg, me, target);
        }

        if (wizardp(me) && me->query("env/combat")=="verbose")
               tell_object(me, sprintf(HIM+BLINK+"maxhit: %d\n" NOR, maxhit));
        if(random(qin)>100 && maxhit >0 && me->is_fighting() && living(target) && living(me) )
        {
                msg=HIM+"说着$N"+HIM+"拨动琴弦，发出绕人心魄的凄凉之乐！\n$n"+HIM+"不禁眼神恍惚起来！\n"NOR;
                message_vision(msg, me, target);
                damage=qin/3+random(qin/3);
                target->receive_wound("sen",damage);    
                COMBAT_D->report_sen_status(target);
        }
     }
  else
     {
      target->add_temp("apply/dodge",-skill);
      target->add_temp("apply/parry",-skill);
      msg=HIM+"$N"+HIM+"拨动琴弦，发出绕人心魄的凄凉之乐！\n"NOR;
      msg+=HIG"\n枯如乾井 满似汪洋 三界六道 惟由心现\n"NOR;             
      msg+=HIM"\n$N"+HIM+"轻言道：－－"+HIW+BLINK+"『风华乱舞·葬曲』"+NOR+HIM+"－－\n"NOR;             
      message_vision(msg, me, target);
      weapon->set_temp("original/use_apply_skill",weapon->query("use_apply_skill"));
      weapon->set_temp("original/skill_type",weapon->query("apply/skill_type"));
      message_vision(MAG+"\n\t剑有痴心醉\n"NOR, me, target);
      me->set("actions", (: call_other, SKILL_D("chixin-jian"), "query_action" :) );
      weapon->set("use_apply_skill",1);
      weapon->set("apply/skill_type","sword");
      COMBAT_D->do_attack(me, target,weapon);
      message_vision(CYN+"\n\t自在青霞舞\n"NOR, me, target);
      me->set("actions", (: call_other, SKILL_D("qingxia-jian"), "query_action" :) );
      COMBAT_D->do_attack(me, target,weapon);
      message_vision(BLU+"\n\t幽谷兰花静\n"NOR, me, target);
      me->set("actions", (: call_other, SKILL_D("lanhua-shou"), "query_action" :) );
      weapon->set("apply/skill_type","unarmed");
      COMBAT_D->do_attack(me, target);
      message_vision(WHT+"\n\t心中盘丝结\n"NOR, me, target);
      msg=HIW"\n$N"+HIW+"暗自发动了盘丝大法，一座五指山朝$n"+HIW+"当头压下！\n"NOR;
      message_vision(msg, me, target);
      if ( me->query("mana")>random(target->query("mana")) )
        {
              msg=HIR"\n$n"+HIR+"被砸个正着，血流如注！\n"NOR;
              message_vision(msg, me, target);
              damage=jiuyinxinjing;
              damage=damage+random(damage/2);                   
 damage=damage*t*ratio/50;
              if (wizardp(me) && me->query("env/combat")=="verbose")
                   tell_object(me, sprintf(HIM+BLINK+"damage: %d\n" NOR, damage));
              target->receive_damage("kee",damage,me);                  
              target->receive_wound("kee",damage,me);
              COMBAT_D->report_status(target,1);
              me->add("mana",-damage/3);
        }
      else
        {
              msg=HIB"\n$n"+HIB+"一个鱼跃躲开了五指山！\n"NOR;
              message_vision(msg, me, target);        
        }               
      message_vision(HIC+"\n\t九阴由此成\n"NOR, me, target);
      msg=HIB"\n$n"+HIB+"觉得四周暗劲汹涌，直被压得喘不过气来！\n"NOR;
      message_vision(msg, me, target);
      if ( me->query("force")>random(target->query("force")) )
        {
              msg=HIR"\n结果$n"+HIR+"胸口一震，已被九阴心经内力所伤！\n"NOR;
              message_vision(msg, me, target);
              damage=jiuyinxinjing;
              damage=damage+random(damage/2);                   
 damage=damage*t*ratio/50;
              if (wizardp(me) && me->query("env/combat")=="verbose")
                   tell_object(me, sprintf(HIM+BLINK+"damage: %d\n" NOR, damage));
              target->receive_damage("kee",damage,me);                  
              target->receive_wound("kee",damage,me);
              COMBAT_D->report_status(target,1);
              me->add("force",-damage/3);
        }
      else
        {
              msg=HIB"\n$n"+HIB+"觉得四周暗劲汹涌，立刻运气护住全身，令$N"+HIB+"的攻击难以奏效！\n"NOR;
              message_vision(msg, me, target);        
        }
      message_vision(HIY+"\n\t宫商角徵羽\n"NOR, me, target);
      me->set("actions", (: call_other, SKILL_D("yinsuo-jinling"), "query_action" :) );
      weapon->set("apply/skill_type","whip");
      COMBAT_D->do_attack(me, target,weapon);
      message_vision(HIR+"\n\t风华曲中求\n"NOR, me, target);
      COMBAT_D->do_attack(me, target,weapon);
      message_vision(HIB+"\n\n\t\t〓"+BLINK+HIM+"风华乱舞"+NOR+HIB+"〓\n\n"NOR, me, target);
      COMBAT_D->do_attack(me, target,weapon);
      weapon->set("use_apply_skill",weapon->query_temp("original/use_apply_skill"));
      weapon->set("apply/skill_type",weapon->query_temp("original/skill_type"));
      me->reset_action();
      weapon->set("use_apply_skill",0);
      target->add_temp("apply/dodge",skill);
      target->add_temp("apply/parry",skill);
     }
        me->add("force",-qin);
        me->add("kee",-random(qin/2));
        me->add("sen",-random(qin/2));
        me->start_busy(1+random(1));
        me->set_temp("fenghua_end",time());
        return 1;
}

int get_current_day_phase() {
    mixed *local = localtime(time()*60);
    int t = local[2] * 60 + local[1];
    int i;
    for (i=0; i<sizeof(day_phase); i++)
        if (t>=day_phase[i]["length"])
            t -= (int)day_phase[i]["length"];
        else
            break;
    return (i==0 ? sizeof(day_phase)-1 : i-1);
}


