#include <ansi.h>

inherit SSERVER;
string *xue_name = ({
  HIR "劳宫穴" NOR, HIR "膻中穴" NOR, HIR "曲池穴" NOR,
  HIG "关元穴" NOR, HIG "曲骨穴" NOR, HIG "中极穴" NOR,
  HIY "承浆穴" NOR, HIY "天突穴" NOR, HIY "百会穴" NOR,
  HIM "幽门穴" NOR, HIM "章门穴" NOR, HIM "大横穴" NOR,
  HIW "紫宫穴" NOR, HIW "冷渊穴" NOR, HIW "天井穴" NOR,
  HIC "极泉穴" NOR, HIC "清灵穴" NOR, HIC "至阳穴" NOR, });


int perform(object me, object target) {
  object weapon;
  int i, j, k, damage;
  weapon = me->query_temp("weapon");

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展这一招「点枪」？\n");
  if (me->query("family/family_name") != "火云洞")
    return notify_fail("“点枪”只有火云洞门人才可以用！\n");

  if (!me->is_fighting())
    return notify_fail("「点枪」只能在战斗中使用！\n");

  if ((int)me->query("max_force") < 1000)
    return notify_fail("你的内力不够！\n");

  if ((int)me->query("force") < 1000)
    return notify_fail("你的内力不足！\n");

  if ((int)me->query("sen") < 500)
    return notify_fail("你的精神不足，没法子施用外功！\n");

  if (me->query_skill_mapped("force") != "huomoforce")
    return notify_fail("点枪必须配合火魔心法才能使用。\n");

  if (time() - (int)me->query_temp("dian_end") < 5)
    return notify_fail("绝招用多就不灵了！\n");

  if (target->is_busy())
    return notify_fail(target->name() + "目前忙得不可开交，还点什么点，放胆攻击吧！\n");

  k = (int)me->query_skill("spear", 1);
  if (k < 100)
    return notify_fail("你的火云枪级别还不够，使用这一招会有困难！\n");
  if ((int)me->query_skill("huomoforce", 1) < 100)
    return notify_fail("你的火魔心法级别还不够，使用这一招会有困难！\n");
  if ((int)me->query_skill("spear", 1) < 100)
    return notify_fail("你的基本枪法太差，使用这一招会有困难！\n");
  i = (int)me->query("combat_exp", 1);
  j = (int)target->query("combat_exp", 1);
  message_vision(
    HIR "\n$N" + HIR + "身形一转，" + weapon->query("name") + HIR + "枪尖散出耀眼红光，忽地往$n" + HIR + "点去！\n",
    me,
    target
  );

  me->delete("env/brief_message");
  target->delete("env/brief_message");
  //出busy
  message_vision(
    HIR "\n眨眼之间，枪尖已到$n" + NOR + xue_name[random(sizeof(xue_name))] + HIR + "！\n" NOR,
    me,
    target
  );
  if (random(i + j) > j / 2) {
    damage = random(k) / 3 + k / 3;
    target->receive_damage("kee", damage, me);
    target->receive_wound("kee", random(damage / 5), me);
    target->start_busy(3 + random(1));
    message_vision(HIR "\n$n" + HIR + "躲闪不及，被击中穴位，浑身酥麻酸软，动弹不得！\n" NOR, me, target);
    //出hit
    me->set_temp("HYQ_perform", 8);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    me->delete_temp("HYQ_perform");
  } else message_vision(HIY "\n$n" + HIY + "身子一闪，躲开了这一击！\n" NOR, me, target);

  me->receive_damage("sen", 100 + random(100));
  me->add("force", -100 - k / 4);
  me->receive_damage("kee", 30);
  me->receive_damage("sen", 30);
  me->start_busy(1 + random(1));
  me->set_temp("dian_end", time());
  return 1;
}
