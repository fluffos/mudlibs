
#include <ansi.h>

inherit SSERVER;


int cast(object me, object target)
{
	string msg;
        int mana, damage, manaf, sen, armor, ksen;
	object sleeveroom,sleeve,who;
	string sname;
	object env, *inv;
	int size, i;

	seteuid(getuid());
         	    if(me->is_busy())
                return notify_fail("你正忙着呢！等等再炼化！\n");;

         sleeveroom=load_object("/d/wiz/sleeveroom");
	  if(!sleeveroom) return notify_fail("你的袖子恐怕破了。\n");

          sname=me->query("id")+"'s sleeve";
          if(!sleeve=present(sname,sleeveroom)) 
          return notify_fail("你的袖子里啥都没有。\n");

	  size=sizeof(inv=all_inventory(sleeve));
	  if(!size)
          {
           me->delete_temp("in_qiankun");
         return notify_fail("你的袖子里啥都没有。\n");
           }
         manaf = (int)me->query("mana_factor")*2;
         sen = (int)me->query_skill("spells");
         if(sen < 1) sen = 1;
        mana = me->query("mana")/10;
         if(mana < 1) mana = 1;
if(userp(me)) {
           ksen = (int)me->query("sen")/5;
          if(ksen < 1) ksen = 1;
         }
       else ksen = 0;
         damage = mana + sen + manaf + ksen;
         damage = damage/2 + random(damage/2);

          if (me->query("mana") < manaf)
           return notify_fail("你的法力不够。\n");
         msg =  HIR "$N手掐法诀，喃喃念咒，对着袖子喷出一口灵气。\n" NOR;
         message_vision(msg, me);
           me->start_busy(3+random(5));

          for(i=0;i<size;i++)
               {
     if(inv[i]->is_character() && !inv[i]->is_corpse() )
{
           who = inv[i];
           armor = (int)who->query("apply/armor_vs_spells");
         if (me->query("mana") < manaf)
             return notify_fail("你的法力枯竭了。\n");
         if (me->query("sen") < manaf)
             return notify_fail("你的精神太疲惫了。\n");
         msg =  HIR "$N的乾坤袖中突然红光大作，铺天盖地的三昧真火把$n烧的焦头烂额。\n" NOR;
         message_vision(msg, me, who);
          me->add("mana",-manaf);
          me->add("sen",-manaf);
          damage -= armor;
          who->set_temp("quankun",1);
          if(damage < 2) damage = 2;
          who->set_temp("last_damage_from",me);
          who->receive_damage("kee", damage,me);
          who->receive_damage("sen", damage,me);
          who->receive_wound("kee", damage/3,me);
          who->receive_wound("sen", damage/3,me);
          COMBAT_D->report_status(who);
}
else {
msg =  HIR "$N的袖子中没有活物。\n" NOR;
 message_vision(msg, me);
}
	  }
return 1;
}
