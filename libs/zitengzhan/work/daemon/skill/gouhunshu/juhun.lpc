#include <ansi.h>
inherit SSERVER;
int cast(object me, object target)
{
        string msg;
        int damage, ap, dp;
        int extradam;

        if(me->query("family/family_name")!="阎罗地府")
                return notify_fail("你不是地府弟子，不能使用这项技能！\n");

        if((int)me->query_skill("gouhunshu",1) < 120 )
                return notify_fail("你的勾魂术不够高！\n");

        if((int)me->query("mana") < 500 )
                return notify_fail("你的法力不够！\n");

        if((int)me->query("kee") < 500 )
                return notify_fail("你的气血不够！\n");

        write("你想拘谁的魂？");
        input_to( (: call_other, __FILE__, "select_target", me :));
        return 1;
}

void select_target(object me, string name)
{
        mapping ob_list;
        object ob,new1;
        string msg;
        object room;
        string *list;
        int i,HERE = 0;
        if( !name || name=="" ) {
                write("中止施法。\n");
                return;
        }

                ob = find_living(name);
                room = environment(me);
        if( !ob || !me->visible(ob) || userp(ob) || present(ob, room)){
                write("你无法感受到这个人的鬼魂。\n");
                return; }
         me->add("mana",-500);
        me->receive_wound("kee",500);
        msg = HIW "$N双手向上一挥，一阵浓雾从地下卷出．．．\n" ;
        ob_list = room->query("objects");
        list = keys(ob_list);
        for(i=0;i<sizeof(list);i++)
                if(list[i] == base_name(ob) || list[i] == base_name(ob)+".lpc")
                        {HERE=1;break;}
        if(HERE) {
                        seteuid(geteuid(me));
                        new1 = new(base_name(ob));
if((int)new1->query("combat_exp") > (int)me->query("combat_exp")/2 || (int)new1->query("daoxing") > (int)me->query("daoxing")/2) {
                            write(HIR"对方太强大了！你无法招魂。\n"NOR);
                            destruct(new1);
                return; }
                        new1->be_ghost(1);
               new1->set("combat_exp", ((int)new1->query("combat_exp"))*2);
               new1->set("daoxing", ((int)new1->query("daoxing"))*2);
                         new1->set("max_kee", (int)new1->query("max_kee")*10);
                         new1->set("eff_kee", (int)new1->query("eff_kee")*10);
                         new1->set("kee", (int)new1->query("kee")*10);
                         new1->set("max_sen", (int)new1->query("max_sen")*10);
                         new1->set("sen", (int)new1->query("sen")*10);
                         new1->set("eff_sen", (int)new1->query("eff_sen")*10);
                         new1->set("str", (int)new1->query("str")*5);
                         new1->set("force_factor", (int)new1->query("force_factor")*3);
                         new1->set("mana_factor", (int)new1->query("mana_factor")*5);
                         new1->add_temp("apply/damage", (int)new1->query_temp("apply/damage")*2);
                         new1->set_temp("apply/spells", (int)new1->query_skill("spells",1));
                         new1->set_temp("apply/dodge", (int)new1->query_skill("dodge",1));
                         new1->set("spi", (int)new1->query("spi")*2);
new1->add("xinmai",100);
new1->add("dujie/life",1+random(3));
                         new1->add_temp("apply/armor", (int)new1->query_temp("apply/armor")*2);
                         new1->add_temp("apply/armor_vs_force", (int)new1->query_temp("apply/armor_vs_force")*2);
                         new1->add_temp("apply/armor_vs_spells", (int)new1->query_temp("apply/armor_vs_spells")*2);
                         new1->set_temp("hell_juhun",1);
                       new1->move(room);       
                        new1->set("title",HIB "拘魂"NOR);
        msg +=  "浓雾似乎在$N身边渐渐得浓缩成一个黑影．．．\n" NOR;
                new1->start_call_out((: call_other, __FILE__, "melt", new1 :), 
(int)me->query_skill("spells")/10);
me->kill_ob(new1);
new1->kill_ob(me);
                }
        else
        msg += "浓雾立刻消失了．．．\n"NOR;
        message_vision(msg, me);
}

void melt(object ob)
{
        message_vision("$N渐渐的虚化，消失了．．．\n",ob);
        destruct(ob);
}
