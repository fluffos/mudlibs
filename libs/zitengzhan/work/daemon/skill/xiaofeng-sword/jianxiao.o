//yudian 2000-11-14
// zouxiao.c  碧箫传情  
#include <ansi.h>
inherit SSERVER;
int perform(object me, object target)
{
        string msg;
 int damage,i,skill,t;
        object weapon=me->query_temp("weapon"),weapon2;
        object *inv;
        inv=all_inventory(me);
        i=sizeof(inv);
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁使用这一招"+HIW+"[剑萧]"+NOR+"？\n");
        if(me->query("family/family_name") != "五庄观")
                return notify_fail(HIW+"[剑萧]"+NOR+"是五庄观不传之密！\n");

        if( !me->is_fighting(target) )
                return notify_fail("大家都很忙，没人有时间听你吹吹打打。\n");

	 if( (int)me->query_skill("sword",1) < 250
          ||me->query_skill_mapped("sword") != "xiaofeng-sword")
	     return notify_fail("你的「基本剑术」还不到家，无法使用"+HIR+"「剑萧」"+NOR+"！\n");
        
        if( (int)me->query_skill("xiaofeng-sword",1) < 250 )
            return notify_fail("你的「晓风残月剑」还不到家，无法使用"+HIR+"「剑萧」"+NOR+"！\n");

        if( (int)me->query_skill("zhenyuan-force",1) < 250 )
            return notify_fail("你的「镇元神功」还不到家，无法自由控制剑箫合一！\n");

        if ((int)me->query_skill("zouxiao",1)<180)
                return notify_fail("你奏箫的功夫还不够，再好好练练吧。\n");

        if (me->query_skill_mapped("force")!="zhenyuan-force")
                return notify_fail("只有用镇元神功才能使剑箫合一。\n");

        if( time()-(int)me->query_temp("jianxiao_end") < 8 )
            return notify_fail("此乃五庄观之精髓所在，用多了就烂了！\n");

if (me->query("lunhui_zhuanshi") < 1){
t=0;}
if (me->query("lunhui_zhuanshi") == 1){
t=1;}
if (me->query("lunhui_zhuanshi") > 1){
t=2;}

        if((int)me->query("force") < 200 )
                return notify_fail("你的内力还不到火候。\n");
        if((int)me->query("kee") < 200 )
                return notify_fail("你的体力已经不够了！\n");
        if((int)me->query("sen") < 200 )
                return notify_fail("你无法集中精力！\n");
        me->delete_temp("have/xiao");  
        for(int k=0;k<i;k++) 
        {
          if ( inv[k]->query("music/type") == "xiao") 
          {
           me->set_temp("have/xiao",1);
           weapon2=inv[k];
           break;
           }
         }  
        if ( !me->query_temp("have/xiao") )
	     return notify_fail("你身上连萧都没有，无法使用"+HIR+"「剑萧」"+NOR+"！\n");

        if( weapon->query("id")==weapon2->query("id") )
            return notify_fail("你把萧都飞出去了，还怎么吹啊？\n");

      skill=(int)me->query_skill("zouxiao",1)*2+(int)me->query_skill("xiaofeng-sword",1);
  target->add_temp("apply/dodge",-skill*(t+1)/2);
 target->add_temp("apply/parry",-skill*(t+1)/2);
      me->delete("env/brief_message");
      target->delete("env/brief_message");
      message_vision(HIB"\n$N"+HIB+"心随意动，手中"+weapon->query("name")+HIB+"如清风拂面一般！\n"NOR, me, target);
      COMBAT_D->do_attack(me, target,weapon);
      message_vision(HIC "\n$N"+HIC+"双脚点地，手中"+weapon->query("name")+HIC+"有如暖风习习一般！\n"NOR, me, target);
      COMBAT_D->do_attack(me, target,weapon);
      message_vision(HIG "\n$N"+HIG+"出手越来越快，用力越来越狠，手中"+weapon->query("name")+HIG+"有如寒风刮面一般！\n"NOR, me, target);
      COMBAT_D->do_attack(me, target,weapon);
      message_vision(HIR "\n突然$N"+HIR+"招式一变，暗运镇元神功，手中"+weapon->query("name")+HIR+"突然脱手而飞！\n"NOR, me, target);
      message_vision(HIR "$N"+HIR+"却手握"+weapon2->query("name")+"，运起内功，开始吹奏旋律！\n"NOR, me, target);
      me->set_temp("xiao_auto",1); 
      COMBAT_D->do_attack(me, target,weapon);
      COMBAT_D->do_attack(me, target,weapon);
      COMBAT_D->do_attack(me, target,weapon);
      message_vision(HIR+""+weapon->query("name")+HIR+"飞行一圈又回到$N"+HIR+"的手中！\n"NOR, me, target);
target->add_temp("apply/dodge",skill*(t+1)/2);
 target->add_temp("apply/parry",skill*(t+1)/2);
      me->delete_temp("xiao_auto"); 
      me->add("sen", -150);
      me->add("kee", -150);
      me->add("force", -150);
      me->set_temp("jianxiao_end",time());
      me->start_busy(1+random(2));
      return 1;
}
