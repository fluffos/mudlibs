
//create by huarong 2003/12
#include <ansi.h>

inherit SSERVER;

string *where = ({"乾","坤","震","巽","艮","兑","坎","离"});
string *effect = ({"天","地","雷","风","山","泽","水","火"});
  
int perform(object me, object target)
{
       int damage, skill,lmt,i,l;
       object weapon=me->query_temp("weapon"),weapon2;
       object *inv;
       string msg;
       inv=all_inventory(me);
       i=sizeof(inv);


        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail(HIR+"「天地有乾坤」"+NOR+"只能对战斗中的对手使用。\n");
                
                if(!wizardp(me) && me->query("family/family_name")!="昆仑山玉虚洞")
             return notify_fail(HIR+"「天地有乾坤」"+NOR+"只有昆仑山玉虚洞门人才可以用！\n");

        if( (int)me->query("force") < 2000)
            return notify_fail("你的内力不够了!\n");

   if( (int)me->query_skill("sword",1) < 250
          ||me->query_skill_mapped("sword") != "huntian-jian")
       return notify_fail("你的「基本剑术」还不到家，无法使用"+HIR+"「天地有乾坤」"+NOR+"！\n");
        
        if( (int)me->query_skill("huntian-jian",1) < 250 )
            return notify_fail("你的「混天一剑」还不到家，无法使用"+HIR+"「天地有乾坤」"+NOR+"！\n");

        if( (int)me->query_skill("dashen-bian",1) < 250 )
            return notify_fail("你的「打神鞭」还不到家，无法使用"+HIR+"「天地有乾坤」"+NOR+"！\n");

        if( (int)me->query_skill("kaitian-zhang",1) < 250 )
            return notify_fail("你的「混沌开天掌」还不到家，无法使用"+HIR+"「天地有乾坤」"+NOR+"！\n");
  
        if( (int)me->query_skill("wugou-jian",1) < 250 )
            return notify_fail("你的「吴钩剑」等级不够，无法推动"+HIR+"「天地有乾坤」"+NOR+"！\n");

        if( (int)me->query_skill("xuanzong-force",1) < 250 )
            return notify_fail("你的「玄宗心法」还不到家，无法融会贯通！\n");

        me->delete_temp("have/mace");  
        for(int k=0;k<i;k++) 
        {
          if ( inv[k]->query("skill_type") == "mace" || inv[k]->query("apply/skill_type") == "mace" ) 
          {
           me->set_temp("have/mace",1);
           weapon2=inv[k];
           break;
           }
         }  
        if ( !me->query_temp("have/mace") )
       return notify_fail("你身上连把锏都没有，无法使用"+HIR+"「天地有乾坤」"+NOR+"！\n");

        if( time()-(int)me->query_temp("bagua_end") < 5 )
            return notify_fail("此乃昆仑山玉虚洞之精髓所在，用多了就烂了！\n");

        skill=(int)me->query_skill("huntian-jian",1)+(int)me->query_skill("wugou-jian",1)
            +(int)me->query_skill("kaitian-zhang",1)+(int)me->query_skill("dashen-bian",1);
        target->add_temp("apply/dodge",-skill);
        target->add_temp("apply/parry",-skill);
        me->delete("env/brief_message");
        target->delete("env/brief_message");
        me->set_temp("klpfm",1);//这里禁止xue的效果，见combatd.c   huarong 2004/2
        lmt=skill/200;
        if (lmt>8) lmt=8;
        weapon->set_temp("original/use_apply_skill",weapon->query("use_apply_skill"));
        weapon->set_temp("original/skill_type",weapon->query("apply/skill_type"));
        weapon->set("use_apply_skill",1);

  message_vision(HIY"\n$N"+HIY+"潜运玄宗心法，手中"+HIM+weapon->query("name")+HIY+"呛然出鞘，盘旋而起！\n"NOR,me,target);
  message_vision(HIY"\n$n"+HIY+"所立之处，竟形成了一个巨大的八卦图！\n"NOR,me,target);
  for(int j=1;j<=lmt;j++)
     {
       me->add("force",-60);
       l=random(sizeof(where));        
       message_vision(HIB"\n呼啸中，"+weapon->query("name")+HIB+"自"+HIR+where[l]+HIB+"位入，自"+HIY+where[random(sizeof(where))]+HIB+"位出！\n"NOR,me,target);        
       message_vision("\n     "+COLOR_D->random_color(3+random(2),0)
                        +"〓  "+COLOR_D->random_color(3+random(2),1)
               +effect[l]+NOR+COLOR_D->random_color(3+random(2),0)+"  〓\n"NOR,me,target);        
     switch(random(4))
       {
        case 0:
          me->set("actions", (: call_other, SKILL_D("huntian-jian"), "query_action" :) );
          weapon->set("apply/skill_type","sword");
          COMBAT_D->do_attack(me, target,weapon);
        break;
        case 1:
          me->set("actions", (: call_other, SKILL_D("wugou-jian"), "query_action" :) );
          weapon->set("apply/skill_type","sword");
          COMBAT_D->do_attack(me, target,weapon);
        break;
        case 2:
          me->set("actions", (: call_other, SKILL_D("dashen-bian"), "query_action" :) );
          weapon->set("apply/skill_type","mace");
          COMBAT_D->do_attack(me, target,weapon2);
        break;
        case 3:
          me->set("actions", (: call_other, SKILL_D("kaitian-zhang"), "query_action" :) );
          weapon->set("apply/skill_type","unarmed");
          COMBAT_D->do_attack(me, target,weapon);
        break;                               
       }
     }
   message_vision(HIY"\n"+weapon->query("name")+HIY+"在八卦位中飞了一圈，又落回到$N"+HIY+"手中！\n"NOR,me,weapon);        
      weapon->set("use_apply_skill",weapon->query_temp("original/use_apply_skill"));
      weapon->set("apply/skill_type",weapon->query_temp("original/skill_type"));
      me->reset_action();
      target->add_temp("apply/dodge",skill);
      target->add_temp("apply/parry",skill);
      weapon->set("use_apply_skill",0);
      me->set_temp("bagua_end",time());
      me->delete_temp("klpfm");
      return 1;
}
