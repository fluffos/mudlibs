//玄狐长恨刀
// dodge 0    parry -5        damage 25
// modify by huarong 2003.11
#include <ansi.h>
inherit SKILL;

string *xuanhu = ({
  HIB "$N心静如水，默念口诀：" + HIG + "情投意合展欢颜，突来横祸阴阳隔。\n" NOR,
  HIB "$N心静如水，默念口诀：" + HIR + "迟迟钟鼓初长夜，耿耿星河欲曙天。\n" NOR,
  HIB "$N心静如水，默念口诀：" + HIY + "上穷碧落下黄泉，两处茫茫皆不见。\n" NOR,
  HIB "$N心静如水，默念口诀：" + HIW + "楼阁玲珑五云起，其中绰约多仙子。\n" NOR,
  HIB "$N心静如水，默念口诀：" + HIC + "风吹仙袂飘飘举，犹似霓裳羽衣舞。\n" NOR,
  HIB "$N心静如水，默念口诀：" + HIB + "玉容寂寞泪阑干，梨花一枝春带雨。\n" NOR,
  HIB "$N心静如水，默念口诀：" + MAG + "在天愿作比翼鸟，在地愿为连理枝。\n" NOR,
  HIB "$N心静如水，默念口诀：" + HIM + "天长地久有时尽，此恨绵绵无绝期。\n" NOR
});

mapping *action = ({
  ([ "name": "「马嵬坡下泥土中，不见玉颜空死处」",
    "action": "$N一式" + HIG "「马嵬坡下泥土中，不见玉颜空死处」" NOR "，脚踏「巽」位，
身形一晃，从$n眼前消失，闪现在$n身后，以刀当剑，手中$w毫无声息地刺向$n的$l",
    "dodge": 0,
    "parry": 0,
    "damage": 20,
    "damage_tupe": "刺伤",
    "parry_msg": "$N一式「马嵬坡下泥土中，不见玉颜空死处」，脚踏「巽」位，
身形一晃，从$n眼前消失，闪现在$n身后",
    "parry_power": 10,
  ]),
  ([ "name": "「迟迟钟鼓初长夜，耿耿星河欲曙天」",
    "action": "$N一式" + HIR "「迟迟钟鼓初长夜，耿耿星河欲曙天」" NOR "，抢占「坎」位，
手中$w化做一道刀光, 似银河倒泻般挥向$n$l",
    "dodge": 0,
    "parry": 0,
    "damage": 25,
    "damage_type": "砍伤",
    "parry_msg": "$N一式「迟迟钟鼓初长夜，耿耿星河欲曙天」，抢占「坎」位，
手中$w化做一道刀光, 磕开$n的攻势",
    "parry_power": 10,
  ]),
  ([ "name": "「上穷碧落下黄泉，两处茫茫皆不见」",
    "action": "$N一式" + HIY "「上穷碧落下黄泉，两处茫茫皆不见」" NOR "，闪向「震」位，
手中$w化为漫天刀影，夹着隐隐雷声，攻向$n全身各处",
    "dodge": 0,
    "parry": -10,
    "damage": 25,
    "damage_type": "劈伤",
    "parry_msg": "$N一式「上穷碧落下黄泉，两处茫茫皆不见」，闪向「震」位，
手中$w化为漫天刀影，夹着隐隐雷声，护住$N全身各处",
    "parry_power": 10,
  ]),
  ([ "name": "「楼阁玲珑五云起，其中绰约多仙子」",
    "action": "$N一式" + HIW "「楼阁玲珑五云起，其中绰约多仙子」" NOR "，绕$n急速旋转，
化为一圈幻影，在「艮」位突发一刀，以泰山压顶之式劈向$n$l",
    "dodge": -5,
    "parry": 0,
    "damage": 30,
    "damage_type": "砍伤",
    "parry_msg": "$N一式「楼阁玲珑五云起，其中绰约多仙子」，绕$n急速旋转，
化为一圈幻影，躲开$n的攻势",
    "parry_power": 10,
  ]),
  ([ "name": "「风吹仙袂飘飘举，犹似霓裳羽衣舞」",
    "action": "$N一式" + HIC "「风吹仙袂飘飘举，犹似霓裳羽衣舞」" NOR "，身体急速旋转，
在「离」位如一团旋风，手中$w唰地砍向$n的$l",
    "dodge": 0,
    "parry": 0,
    "damage": 20,
    "damage_type": "砍伤",
    "parry_msg": "$N一式「风吹仙袂飘飘举，犹似霓裳羽衣舞」，身体急速旋转，
在「离」位如一团旋风，化去$n的攻势",
    "parry_power": 10,
  ]),
  ([ "name": "「玉容寂寞泪阑干，梨花一枝春带雨」",
    "action": "$N一式" + HIB "「玉容寂寞泪阑干，梨花一枝春带雨」" NOR "，占住「兑」位，
将手中$w化做点点星光，洒向$n全身",
    "dodge": -10,
    "parry": -10,
    "damage": 30,
    "damage_type": "劈伤",
    "parry_msg": "$N一式「玉容寂寞泪阑干，梨花一枝春带雨」，占住「兑」位，
将手中$w化做点点星光，击在$n的$l，化去$n的攻势",
    "power_power": 10,
  ]),
  ([ "name": "「在天愿作比翼鸟，在地愿为连理枝」",
    "action": "$N一式" + MAG "「在天愿作比翼鸟，在地愿为连理枝」" NOR "，连踏「乾」「坤」二位，
手中$w从两个方向向$n的$l击去",
    "dodge": 0,
    "parry": 0,
    "damage": 20,
    "damage_type": "割伤",
    "parry_msg": "$N一式「在天愿作比翼鸟，在地愿为连理枝」，连踏「乾」「坤」二位，
从$n的攻势中闪了出去",
    "parry_power": 10,
  ]),
  ([ "name": "「天长地久有时尽，此恨绵绵无绝期」",
    "action": "$N一式" + HIM "「天长地久有时尽，此恨绵绵无绝期」" NOR "，由「坤」向「乾」疾退，
手中$w化做一道长虹向$n$l击去",
    "dodge": -10,
    "parry": -20,
    "damage": 30,
    "damage_type": "割伤",
    "parry_msg": "$N一式「天长地久有时尽，此恨绵绵无绝期」，由「坤」向「乾」疾退，
手中$w化做一道长虹荡开了$n的锋芒",
    "parry_power": 10,
  ]),
  ([ "name": "「天海一线」",
    "action": HIM "激战中，$N" + HIM + "冷哼一声，身形不退反进，红光骤起，手中$w"
    +HIM + "\n涌起千层波浪，一式" + HBBLU + "「天海一线」" + NOR + HIM + "，反向" + HIM + "$n" + HIM + "$l" + HIM + "硬封过去" NOR,
    "dodge": -80,
    "parry": -50,
    "damage": 40,
    "force": 60,
    "damage_type": "割伤",
  ]),
  ([ "name": "「流星飞逝」",
    "action": HIY "眼看招式已经用老，在这间不容发刹那，$N" + HIY + "身旁突然升起一道青芒，
一式" + HBRED + "「流星飞逝」" + NOR + HIY + "，正如山谷中浮沉不定的云雾一样，若隐若现，\n倏然向" + HIY + "$n" + HIY + "$l" + HIY + "砍去" NOR,
    "dodge": -50,
    "parry": -80,
    "damage": 50,
    "force": 50,
    "damage_type": "割伤",
  ]),
});

int valid_learn(object me) {
  object ob;

  if ((string)me->query("gender") != "女性" && !wizardp(me))
    return notify_fail("玄狐长恨刀只有女性才能练。\n");
  if ((int)me->query("force") < 300)
    return notify_fail("你的内力不够，没有办法学玄狐长恨刀法。\n");

  if ((int)me->query("max_force") < 200)
    return notify_fail("你的内力不够，没有办法学玄狐长恨刀法。\n");

  if (!(ob = me->query_temp("weapon")) || (string)ob->query("skill_type") != "blade")
    return notify_fail("你必须先找一把刀才能学玄狐长恨刀法。\n");

  if ((int)me->query("bellicosity") > 200)
    return notify_fail("你的杀心太重，不符玄狐长恨刀法的要义。\n");

  return 1;
}

int valid_enable(string usage) {
  return (usage == "blade") || (usage == "parry");
}

mapping query_action(object me, object weapon) {
  int i;
  i = me->query_temp("pfm_xuanhu");
  if (!me->query_temp("pfm_xuanhu")) {
    return action[random(8)];
  } else {
    return action[i];
  }
}

int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
    return notify_fail("你必须先找一把刀，才能练刀法。\n");

  if ((int)me->query("kee") < 40)
    return notify_fail("你的体力不够练这门刀法，还是先休息休息吧。\n");
  me->receive_damage("kee", 30);
  me->add("force", -10);
  message_vision(xuanhu[random(sizeof(xuanhu))], me);
  return 1;
}

string perform_action_file(string func) {
  return __DIR__ "xuanhu-blade/" + func;
}
