//create by huarong 2003.12
#include <ansi.h>
inherit SSERVER;

int perform(object me, object target)
{
         object weapon=me->query_temp("weapon");
          string msg; 
         int skill;
        
          if( !target ) target = offensive_target(me);
         if( !target || !target->is_character() || !me->is_fighting(target) )
              return notify_fail(HIR+"「火云满天」"+NOR+"只能对战斗中的对手使用。\n");
        
         if(me->query("family/family_name")!="火云洞")
             return notify_fail(HIR+"「火云满天」"+NOR+"只有火云门人才可以用！\n");

         if( (int)me->query("force") < 2000 )
             return notify_fail("你的内力不够了！\n");

         if( (int)me->query_skill("stick",1) < 250
          ||me->query_skill_mapped("stick") != "dali-bang")
             return notify_fail("你的「基本棍法」还不到家，无法使用"+HIR+"「火云满天」"+NOR+"！\n");
        
        if( (int)me->query_skill("dali-bang",1) < 250 )
            return notify_fail("你的「大力棒」还不到家，无法使用"+HIR+"「火云满天」"+NOR+"！\n");

        if( (int)me->query_skill("huoyun-qiang",1) < 250 )
            return notify_fail("你的「火云枪」还不到家，无法使用"+HIR+"「火云满天」"+NOR+"！\n");
        
        if( (int)me->query_skill("moyun-shou",1) < 250 )
            return notify_fail("你的「摩云手」等级不够，无法推动"+HIR+"「火云满天」"+NOR+"！\n");

        if( (int)me->query_skill("huomoforce",1) < 250 )
            return notify_fail("你的「火魔心法」还不到家，无法使用"+HIR+"「火云满天」"+NOR+"！\n");

        if( time()-(int)me->query_temp("mantian_end") < 10 )
            return notify_fail("此乃火云之精髓所在，用多了就烂了！\n");

      skill=(int)me->query_skill("spear",1)+(int)me->query_skill("stick",1)+(int)me->query_skill("unarmed",1);
      skill=skill*3/2;
      target->add_temp("apply/dodge",-skill);
      target->add_temp("apply/parry",-skill);
      me->delete("env/brief_message");
      target->delete("env/brief_message");
message_vision(WHT"\n$N"+NOR+WHT+"眼中闪现一丝奇怪的神色，刹那之间已打出两棍，连攻$n"+NOR+WHT+"上下两路，\n"
+"手中"+weapon->query("name")+NOR+WHT+"上下翻飞！正是火云之精髓－－\n\n\n"
+HIR+BLINK"                      〓"+HIY+"火云满天"+HIR+"〓\n\n\n"NOR,me,target);
      COMBAT_D->do_attack(me, target,weapon);
      COMBAT_D->do_attack(me, target,weapon);
message_vision(HIR"\n两棍打完，突然$N"+HIR+"招式一变，体内火魔心法潜运，真气源源不断在体内流转，\n"
+"手中"+weapon->query("name")+HIR+"在翻转中冒出三丈火焰，竟然以棍代枪使出火云枪法，直取$n"+HIR+"，\n"
+"并燃烧四周空气引起火焰，瞬时一片火光！\n"NOR,me,target);
      me->set("actions", (: call_other, SKILL_D("huoyun-qiang"), "query_action" :) );
      weapon->set_temp("original/use_apply_skill",weapon->query("use_apply_skill"));
      weapon->set_temp("original/skill_type",weapon->query("apply/skill_type"));
      weapon->set("use_apply_skill",1);
      weapon->set("apply/skill_type","spear");
      COMBAT_D->do_attack(me, target,weapon);
      COMBAT_D->do_attack(me, target,weapon);
message_vision(HIC"\n$n"+HIC+"尚未站稳，突然$N"+HIC+"招式又一变，撤回"+weapon->query("name")+HIC+"，抬手出掌！\n"NOR,me,target);
      me->set("actions", (: call_other, SKILL_D("moyun-shou"), "query_action" :) );
      weapon->set("apply/skill_type","unarmed");
      COMBAT_D->do_attack(me, target,weapon);
      COMBAT_D->do_attack(me, target,weapon);
      weapon->set("use_apply_skill",weapon->query_temp("original/use_apply_skill"));
      weapon->set("apply/skill_type",weapon->query_temp("original/skill_type"));
      me->reset_action();
      target->add_temp("apply/dodge",skill);
      target->add_temp("apply/parry",skill);
      me->start_busy(1+random(1));
      weapon->set("use_apply_skill",0);
      me->set_temp("mantian_end",time());
      return 1;
}


