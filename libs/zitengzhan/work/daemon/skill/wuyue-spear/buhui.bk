//wuyue-spear, perform buhui
// /daemon/class/fighter/wuyue-spear/buhui
//writted by jie 2001-2-10
//modify for 大唐西游2 by huarong 2003/12

#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target)
{
        object weapon;
        int myskill,times, damage,skill;
        string number, msg;
        myskill = (int)me->query_skill("wuyue-spear", 1);  
         skill = (int)me->query_skill("spear",1)+(int)me->query_skill("wuyue-spear",1);
        weapon = me->query_temp("weapon");
      
        if( !target ) target = offensive_target(me);
        
       
        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展这一招「不悔」？\n");

        if(!me->is_fighting())
                return notify_fail("「不悔」只能在战斗中使用！\n");
                
				if (!PFM_D->valid_family(me, "火云洞"))
                return notify_fail("你是哪儿偷学来的武功，也想用「不悔」?\n");
	
              
                
        if((int)me->query("max_force") < 800 )
                return notify_fail("你的内力不够！\n");

				if((int)me->query("force") < 300 )
								return notify_fail("你的内力不足！\n");

        if((int)me->query("sen") < (int)(me->query("max_sen")/2) )
                return notify_fail("你的精神不足，没法子施展不悔！\n");

       if( time()-(int)me->query_temp("buhui_end") < 8 )
                return notify_fail("绝招用多就不灵了！\n");

        if(myskill < 60)
                return notify_fail("你的五岳神枪级别还不够。\n");
        else 
            if(myskill <100){
                times = 3;        
                number = "三";}
            else
                if (myskill <150){
                    times = 4;
                    number = "四";}
                else
                    if(myskill <200 ){
                           times = 5;
                           number = "五";}
                     else{ 
                           times = 6;
                           number = "六";}

	 			message_brief(me, target, "五岳神枪", "「不悔」");

        damage = me->query_skill("spear",1)+random(me->query_skill("spear",1));
        damage = damage*2;
				message_vision(HIC"\n$N"+HIC+"一声长啸，"+ weapon->query("name")+ HIC"光一转，闪电般连续向$n"+HIC+"攻出了"+number+"枪，枪枪要命！\n"NOR,me,target,0,"env/brief_perform");

        target->add_temp("apply/dodge",-skill/2);
        target->add_temp("apply/parry",-skill/2);
        me->add_temp("apply/attack",skill/3);
        for(int i=1;i<=times;i++)
        COMBAT_D->do_attack(me, target, weapon,0,"env/brief_perform");
        target->add_temp("apply/dodge",skill/2);
        target->add_temp("apply/parry",skill/2);
        me->add_temp("apply/attack",-skill/3);
        me->receive_damage("sen", 20);
        me->add("force", -(times*15+50));

        if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
        }

        me->set_temp("buhui_end",time());
        return 1;
}

