inherit SKILL;

mapping *action = ({
  ([ "action":
    "$N一招「魔火燎原」，手中$w带出团团烈火，直扑向$n的$l",
    "damage": 25,
    "dodge": -5,
    "parry": 0,
    "damage_type": "割伤"
  ]),
  ([ "action":
    "$N手中$w轻颤，由$n的左肩斜斜劈下，一招「斩冰截火」果然使得恰到好处",
    "damage": 30,
    "dodge": -5,
    "parry": -5,
    "damage_type": "砍伤"
  ]),
  ([ "action":
    "$N左掌直劈$n，$n闪身一避才发现$N右手的$w已砍向自己的腰间，",
    "damage": 30,
    "dodge": -10,
    "parry": 10,
    "damage_type": "砍伤"
  ]),
  ([ "action":
    "$N将手中$w交于左手，$n一怔间，$N右手已冲破$n的防线，直抵$n的胸口",
    "damage": 25,
    "dodge": -10,
    "parry": 5,
    "damage_type": "淤伤"
  ]),
  ([ "action":
    "$N冷笑一声，口中突然喷出滚滚浓烟，浓烟中，$w突然带着扑鼻的热气，由下至上划向$n的$l",
    "damage": 30,
    "dodge": -10,
    "parry": 0,
    "damage_type": "划伤"
  ]),
});

int valid_learn(object me) {
  object ob;

  if ((int)me->query("max_force") < 80)
    return notify_fail("你的内力不够，没有办法学火魔刀。\n");

  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "blade")
    return notify_fail("你必须先找一把刀才能学火魔刀。\n");

  return 1;
}


int valid_enable(string usage) {
  return (usage == "blade") || (usage == "parry");
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 30
    || (int)me->query("force") < 5)
    return notify_fail("你的内力或气不够，没有办法练习火魔刀。\n");
  me->receive_damage("kee", 30);
  me->add("force", -5);
  write("你按着所学练了一遍火魔刀。\n");
  return 1;
}

int valid_effect(object me, object weapon, string name, int skill) {}

string perform_action_file(string func) {
  return __DIR__ "huomo-dao/" + func;
}
