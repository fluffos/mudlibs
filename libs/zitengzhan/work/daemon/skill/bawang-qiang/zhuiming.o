//create for dtxy by huarong 2004/10

#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target)
{
        object weapon;
        int skill;
        int x,y,z,u,v,w,hit;
        string str;     
        skill = (int)me->query_skill("spear",1)/2+(int)me->query_skill("bawang-qiang",1)/2;
        weapon = me->query_temp("weapon");
      
        if( !target ) target = offensive_target(me);
        
       
        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展这一招「追命绝户枪」？\n");

        if(!me->is_fighting())
                return notify_fail("「追命绝户枪」只能在战斗中使用！\n");
                
        if(me->query("family/family_name") != "将军府" )
                return notify_fail("你是哪儿偷学来的武功，也想用「追命绝户枪」?\n");

        if((int)me->query_skill("bawang-qiang", 1) < 150)
                 return notify_fail("你的霸王枪法级别还不够。\n");

        if((int)me->query_skill("lengquan-force", 1) < 120)
                 return notify_fail("你的冷泉神功级别还不够。\n");

        if((int)me->query_skill("spear", 1) < 150)
                return notify_fail("你的基本枪法级别还不够。\n");
                                
        if((int)me->query("max_force") < 800 )
                return notify_fail("你的内力不够！\n");

        if((int)me->query("force") < 300 )
                return notify_fail("你的内力不足！\n");

        if((int)me->query("sen") < (int)(me->query("max_sen")/2) )
                return notify_fail("你的精神不足，没法子施展追命绝户枪！\n");

       if( time()-(int)me->query_temp("zhuiming_end") < 6 )
                return notify_fail("绝招用多就不灵了！\n");

        me->delete("env/brief_message");
        target->delete("env/brief_message");

        x=(int)me->query_skill("bawang-qiang", 1);
        y=(int)me->query_skill("parry", 1);
        z=(int)me->query_skill("lengquan-force", 1);
        u=(int)me->query_skill("yanxing-steps", 1);
        v=(int)me->query_skill("baguazhou", 1);
        w=(int)me->query_skill("changquan", 1);
        if(x==y
        && x==z
        && x==u
        && x==v
        && x==w
        && x>250 )
             me->set_temp("zhuiming_hit",1);
        if((int)me->query_cor() > (int)me->query_cps()
        && (int)me->query_cor() - (int)me->query_cps() <=5 )
          skill=skill*2;
                
message_vision(RED"\n$N"+NOR+RED+"无声无息，"+ weapon->query("name")+ NOR+RED+"银光一闪，暗暗发动了「追命绝户枪」！\n"NOR,me,target);

        target->add_temp("apply/dodge",-skill);
        target->add_temp("apply/parry",-skill);
        me->set_temp("pfm_zhuiming",1);
        COMBAT_D->do_attack(me, target, weapon);
        me->set_temp("pfm_zhuiming",2);
        COMBAT_D->do_attack(me, target, weapon);
        me->set_temp("pfm_zhuiming",3);
        COMBAT_D->do_attack(me, target, weapon);

        if (me->query_temp("zhuiming_hit")==1)
         {
          me->set_temp("pfm_zhuiming",4);
          COMBAT_D->do_attack(me, target, weapon);
          if ( target && (target->query("eff_kee")<0 || (!living(target) && target->query("kee")<0)) && random(5)==1 )  
           { str=me->name()+"竟然使出将军府"+HIR"「追命绝户枪」"+HIM"之失传绝招"+HIY+"「流星追月」"+HIM+"，"
                +target->name()+HIM"甚至连枪的来势都没看清楚，就做了冤死鬼！";
             message("channel:rumor",HIM"【空穴来风】某人："+str+"\n"NOR,users());
           }
         }
        me->delete_temp("pfm_zhuiming");
        target->add_temp("apply/dodge",skill);
        target->add_temp("apply/parry",skill);
        me->receive_damage("sen", 20);
        me->add("force", -(skill/4+50));
        me->start_busy(1+random(2));
//       if(me->query_temp("zhuiming_hit"))
           me->delete_temp("zhuiming_hit");
        me->set_temp("zhuiming_end",time());
        return 1;
}


