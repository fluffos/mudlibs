#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target)
{
        string msg;
        int i,skill;
        object weapon,*enemy;
        weapon = me->query_temp("weapon");
        
        enemy=me->query_enemy();
        if(!sizeof(enemy))
                return notify_fail("［八方风雨］只能对战斗中的对手使用。\n");

        if(target)
                return notify_fail("这个绝招不需要指定使用对象！！\n");


        if(!me->is_fighting())
                return notify_fail("「八方风雨」只能在战斗中使用！\n");
                
        if(me->query("family/family_name") != "将军府" )
                return notify_fail("你是哪儿偷学来的武功，也想用「八方风雨」?\n");
	
                
        if((int)me->query("max_force") < 800 )
                return notify_fail("你的内力不够！\n");

	if((int)me->query("force") < 300 )
		return notify_fail("你的内力不足！\n");

        if((int)me->query("sen") < (int)(me->query("max_sen")/2) )
                return notify_fail("你的精神不足，没法子施展八方风雨！\n");

       if( time()-(int)me->query_temp("bafang_end") < 6 )
                return notify_fail("绝招用多就不灵了！\n");

        if((int)me->query_skill("bawang-qiang",1) < 60)
                return notify_fail("你的霸王枪法级别还不够。\n");
      skill = me->query_skill("spear",1) + me->query_skill("bawang-qiang",1);
       me->add("force",-300);
       me->add_temp("apply/damage",skill);
       me->add_temp("mingzhong",50);
        msg = HIY  "\n\n$N"+HIY"低喝一声［"+HIR"八—方—风—雨"+HIY"］！\n"+HIW"$N"+HIW"内力骤然凝聚，"+
weapon->name() +
HIW"化成满天枪影，铺天盖地散向在场每一个人！\n" NOR;
        message_vision(msg,me);
        for(i=0;i<sizeof(enemy);i++)
        {
        message_vision(HIG"$N"+HIG+"手中"+weapon->query("name")+""HIG"一抖，闪电般的刺向$n。\n",me,enemy[i]);
           COMBAT_D->do_attack(me,enemy[i],weapon);
        }
       me->add_temp("apply/damage",-skill);
       me->add_temp("mingzhong",-50);
 me->start_busy(1);
        me->set_temp("bafang_end",time());
        return 1;
}

