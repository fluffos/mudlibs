int perform(object me) {
  string msg = "", cnum;
  object target, weapon;
  int lv, i, j, k, l, ispace, num, sword;
  int sword1, sword2, sword3, sword4, sword5, sword6, sword7;
  int init;
  int *swords;
  int myskill, yourskill;

  // me=this_object();
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你对谁施展" PFM "？\n");

  if (!target->is_fighting(me))
    return notify_fail("只有在战斗中才可以使用" PFM "！\n");

  weapon = me->query_temp("weapon");
  if (!weapon || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你需要装备一把剑，才能施展" PFM "。\n");
  if ((int)me->query_skill("godsword", 1) < 220 || (int)me->query_skill("sword") < 220)
    return notify_fail("你的剑法的技巧不足无法使出" PFM "。\n");
  if (me->query("force") < 1800 || me->query("max_force") < 1800)
    return notify_fail("你的内力不够。\n");
  lv = me->query("secret/jianhun");
  if (!lv)
    return notify_fail("你还没学会" PFM "。\n");

  // 间隔还没写
  me->add("force", -200 - 25 * random(lv));

  if (lv > 7)
    lv = 7;

  myskill = me->query_skill("sword", 1);
  yourskill = target->query_skill("force", 1);

  message_vision(HIY "\n$N" + HIY + "眼观鼻，鼻观口，口问心，忽然时间仿佛停止了流逝.." NOR, me, target);
  message_vision(
    HIY "\n周围的一切都寂静缓慢下来，手中的" + weapon->query("name") + HIY + "不住颤动，好似要脱手飞去.." NOR,
    me,
    target
  );
  message_vision(HIC "\n$N" + HIC + "猛的抬头，喝道：“以吾之名，借天地之气一用！”眼中爆出两朵银芒，直通云霄！" NOR, me, target);
  message_vision(HIC "\n远处的天空传来一阵撕裂的声音，刹那间亿万道匹练似的剑光遮月蔽日破空而至！" NOR, me, target);
  message_vision(HIW "\n\n无数剑光拥簇着的竟然是传说中的......\n\n" NOR, me, target);
  message_vision(BLINK + HIG "                                    上古神剑\n\n" NOR, me, target);
  message_vision(HIB "\n看着如此之多的剑光，$n" + HIB + "不禁惊呆了...\n\n" NOR, me, target);

  for (i = 0; i < lv; i++)  // 领悟几级出几招
  {
    num = 1 + random(1 + lv / 2);  // 级别高的话，每招有可能出2-3剑
    //	message_vision("num:"+num+"\n",me);
    ispace = 1 + random(10);
    init = 0;
    for (j = 0; j < sizeof(haocao); j++)  // 从上往下画
    {
      if (!init) {
        init = 1;
        swords = ({});
        for (k = 1; k <= num; k++)
          swords += ({ 1 + random(lv) });
        if (sizeof(swords) == 2)
          cnum = "两";
        else
          cnum = chinese_number(sizeof(swords));
        message_vision(GRN "\n$N剑锋一指，" + cnum + "柄神剑从万剑从中飞出，光芒万丈！\n\n" NOR, me, target);
      }
      msg = "";
      for (k = 1; k <= num; k++) {
        for (l = 0; l < ispace; l++) msg += " ";
        switch (swords[k - 1]) {
          case 1:
            msg += haocao[j];
            break;
          case 2:
            msg += juque[j];
            break;
          case 3:
            msg += yuchang[j];
            break;
          case 4:
            msg += shengxie[j];
            break;
          case 5:
            msg += longquan[j];
            break;
          case 6:
            msg += chunjun[j];
            break;
          case 7:
            msg += zhanlu[j];
            break;
        }
      }
      msg += "\n";
      message_vision(msg, me);
    }

    if (myskill + yourskill > random(yourskill / (num + 1.5))) {
      message_vision(HIR "\n$n" + NOR + HIR + "一个不慎，" + cnum + "道长虹般的剑光透体而入！\n" NOR, me, target);
      target->receive_wound("kee", myskill * num + me->query_str());
      COMBAT_D->report_status(target);
    } else
      message_vision(
        YEL "\n$n" + NOR + YEL + "左跳右闪前翻后滚狼狈之中居然躲过了这" + cnum + "剑...\n" NOR,
        me,
        target
      );

  }

  me->start_busy(4);



  return 1;
  /*
	
        message_vision(HIY"\n
$N大开大阖，囤积身上刚阳气劲，只见无数光点渐渐往$N身上聚集...转眼间.
       $N耀上天空..身上剑气瞬间转移到配剑中...只听$N大喊:
                            "HIW"‘"HIC"～神 剑 助 我～"HIW"’\n"NOR"
              "HIG"‘"HIR"    八 ＊ ＊ ＊ 剑 ＊ ＊ ＊ 齐 ＊ ＊ ＊ 飞  "HIG"’
                                      "WHT"██"NOR"
                                       "RED"█"NOR"
                               "WHT"██    "RED"█    "WHT"██"NOR"
                                "RED"█     "RED"█     "RED"█"NOR"
                         "WHT"██   "RED"█  "CYN"◢██◣  "RED"█   "WHT"██"NOR"
                          "RED"█    "RED"█   "HIY"｜湛｜"NOR"   "RED"█    "RED"█"NOR"
                   "WHT"██   "RED"█  "CYN"◢█◣ "HIY"｜卢｜"NOR" "CYN"◢█◣  "RED"█   "WHT"██"NOR"
                    "RED"█    "RED"█  "HIC"｜纯｜ "HIY" ◣◢  "HIM"｜龙｜"NOR"  "RED"█    "RED"█"NOR"
                    "RED"█  "CYN"◢█◣"HIC"｜钧｜ "HIY" ██  "HIM"｜泉｜"NOR""CYN"◢█◣  "RED"█"NOR"
                    "RED"█  "HIW"｜胜｜"HIC"｜  ｜ "HIY" ██  "HIM"｜  ｜"HIG"｜鱼｜"NOR"  "RED"█"NOR"
                  "CYN"◢█◣"HIW"｜邪｜"HIC"｜  ｜ "HIY" ██  "HIM"｜  ｜"HIG"｜肠｜"NOR""CYN"◢█◣"NOR"
                  "HIR"｜豪｜"HIW"｜  ｜"HIC"｜  ｜ "HIY" ██  "HIM"｜  ｜"HIG"｜  ｜"HIB"｜巨｜"NOR"
	          "HIR"｜曹｜"HIW"｜  ｜"HIC"｜  ｜ "HIY" ██  "HIM"｜  ｜"HIG"｜  ｜"HIB"｜阙｜"NOR"
	          "HIR"｜  ｜"HIW"｜  ｜"HIC"｜  ｜ "HIY" ██  "HIM"｜  ｜"HIG"｜  ｜"HIB"｜  ｜"NOR"
                  "HIR"｜  ｜"HIW"｜  ｜"HIC"｜  ｜ "HIY" ██  "HIM"｜  ｜"HIG"｜  ｜"HIB"｜  ｜"NOR"
                  "HIR"｜  ｜"HIW"｜  ｜"HIC"｜  ｜  "HIY"◥◤  "HIM"｜  ｜"HIG"｜  ｜"HIB"｜  ｜"NOR"
	          "HIR"｜  ｜"HIW"｜  ｜"HIC"｜  ｜        "HIM"｜  ｜"HIG"｜  ｜"HIB"｜  ｜"NOR"
		  "HIR"｜  ｜"HIW"｜  ｜"HIC" ＼／         "HIM" ＼／ "HIG"｜  ｜"HIB"｜  ｜"NOR"
		  "HIR"｜  ｜"HIW"｜  ｜                    "HIG"｜  ｜"HIB"｜  ｜"NOR"
		  "HIR"｜  ｜ "HIW"＼／                     "HIG" ＼／ "HIB"｜  ｜"NOR"
		  "HIR"｜  ｜                                "HIB"｜  ｜"NOR"
 		   "HIR"＼／                                 "HIB" ＼／"NOR"
\n"NOR,me);
     message_vision(HBYEL"$N神剑剑气，浩瀚无穷，瞬间整个空间接笼罩在金黄色的剑光下..\n"NOR,me);
     for(j=0;j < i;j++)
     {
           enemy[j]->receive_damage("kee",300+random(200));
           enemy[j]->start_busy(1);
           COMBAT_D->report_status(enemy[j]);
          }
           me->add("force",-50);
           me->start_busy(1);
        call_out("act1",1,msg,target,me);
        message_vision( NOR,me);
return 1;
}
int act1(string msg,object target,object me)
{
        object room,*enemy;
        int damage,i,j,kee_lv;
        room = environment(me);
        enemy=me->query_enemy(room);
        target=offensive_target(me);
        kee_lv=me->query_function("godswordkee");
        j=sizeof(enemy);
        if (j<1)
        {
        me->delete_temp("usegodsword");
        return notify_fail("‘没敌人..打鸟欧。\n");
        }
        else
        {
        damage = 50 + kee_lv + random(me->query_skill("godsword"));
        message_vision(HBCYN"$N身上神剑气劲发出骇人光芒...\n"NOR,me);
     for(i=0;i < j;i++)
     {
 if(random((me->query("combat_exp")/10000)+me->query_skill("godsword")*10+me->query_skill("dodge"))>random(enemy[i]->query_skill("dodge")+enemy[i]->query_skill("parry")+(enemy[i]->query("combat_exp")/20000)))
          {
           message_vision(HBCYN"$N峰回路转内劲猛然上窜祭出"HIY"〓豪曹剑〓,"HIC"剑光如烈火狂焰直奔$n心口。\n"NOR,me,enemy[i]);
           message_vision(HIR"$n闪躲不及，当场被此宏大的剑气贯穿。\n"NOR,me,enemy[i]);
           me->add("force",-50);
           enemy[i]->receive_damage("kee",damage);
           COMBAT_D->report_status(enemy[i]);
          }
         else {
           message_vision(HBCYN"$N峰回路转内劲猛然上窜祭出"HIY"〓豪曹剑〓,"HIC"剑光如烈火狂焰直奔$n心口。\n"NOR,me,enemy[i]);
           message_vision(HIB"$n全神贯注盯紧豪曹剑，在费尽千辛万苦之后总算闪过这一击。\n"NOR,me,enemy[i]);
           me->add("force",-20);
          }
        }
        me->set_temp("usesunsword",1);
    if(kee_lv >=110) me->set("functions/godswordkee/level",110);
    else function_improved("godswordkee",random(20)+15);
        call_out("act2",1,msg,target,me);
        return 1;
        }
}

int act2(string msg,object target,object me)
{
        object room,*enemy;
        int damage,i,j,kee_lv;
        kee_lv=me->query_function("godswordkee");
        room = environment(me);
        enemy=me->query_enemy(room);
        target=offensive_target(me);
        j=sizeof(enemy);
        if (j<1)
        {
        me->delete_temp("usegodsword");
        return notify_fail("‘没敌人..打鸟欧。\n");
        }
        else
        {
        damage = 70 + kee_lv + random(me->query_skill("godsword"));
        message_vision(HBCYN"$N身上神剑气劲发出骇人光芒...\n"NOR,me);
     for(i=0;i < j;i++)
     {
if(random((me->query("combat_exp")/10000)+me->query_skill("godsword")*10+me->query_skill("dodge"))>random(enemy[i]->query_skill("dodge")+enemy[i]->query_skill("parry")+(enemy[i]->query("combat_exp")/20000)))
          {
            message_vision(HBCYN"$N收光为晕敛刚成柔，身后飞出了"HIY"〓胜邪剑〓"HIC"，瞬间身化残影落步，剑尖直刺$n。\n"NOR,me,enemy[i]);
            message_vision(HIR"$n闪躲不及，当场被此宏大的剑气贯穿。\n"NOR,me,enemy[i]);
            me->add("force",-50);
            enemy[i]->receive_damage("kee",damage);
            COMBAT_D->report_status(enemy[i]);
          } else {
            message_vision(HBCYN"$N收光为晕敛刚成柔，身后飞出了"HIY"〓胜邪剑〓"HIC"，瞬间身化残影落步，剑尖直刺$n。\n"NOR,me,enemy[i]);
            message_vision(HIB"$n全神贯注盯紧胜邪剑，在费尽千辛万苦之后总算闪过这一击。\n"NOR,me,enemy[i]);
            me->add("force",-20);
          }
        }
       me->set_temp("usesunsword",1);
    if(kee_lv >=110) me->set("functions/godswordkee/level",110);
    else function_improved("godswordkee",random(20)+15);
       call_out("act3",1,msg,target,me);
       return 1;
       }
}

int act3(string msg,object target,object me)
{
        object room,*enemy;
        int damage,i,j,kee_lv;
        room = environment(me);
        enemy=me->query_enemy(room);
        target=offensive_target(me);
        kee_lv=me->query_function("godswordkee");
        j=sizeof(enemy);
        if (j<1)
        {
        me->delete_temp("usegodsword");
        return notify_fail("‘没敌人..打鸟欧。\n");
        }
        else
        {
        damage = 90 + kee_lv + random(me->query_skill("godsword"));
        message_vision(HBCYN"$N身上神剑气劲发出骇人光芒...\n"NOR,me);
     for(i=0;i < j;i++)
     {
 if(random((me->query("combat_exp")/10000)+me->query_skill("godsword")*10+me->query_skill("dodge"))>random(enemy[i]->query_skill("dodge")+enemy[i]->query_skill("parry")+(enemy[i]->query("combat_exp")/20000)))

          {
           message_vision(HBCYN"$N飞身高跃倏然使出了"HIY"〓纯钧剑〓"HIC"，剑光如浩日辉煌，笔直落在$n眉心。\n"NOR,me,enemy[i]);
           message_vision(HIR"$n闪躲不及，当场被此宏大的剑气贯穿。\n"NOR,me,enemy[i]);
           me->add("force",-50);
           enemy[i]->receive_damage("kee",damage);
           enemy[i]->set_temp("no_power",1);
           enemy[i]->apply_condition("no_power",1);
           COMBAT_D->report_status(enemy[i]);
          } else {
           message_vision(HBCYN"$N飞身高跃倏然使出了"HIY"〓纯钧剑〓"HIC"，剑光如浩日辉煌，笔直落在$n眉心。\n"NOR,me,enemy[i]);
           message_vision(HIB"$n全神贯注盯紧纯钧剑，在费尽千辛万苦之后总算闪过这一击。\n"NOR,me,enemy[i]);
           me->add("force",-20);
          }
        }
        me->set_temp("usesunsword",1);
    if(kee_lv >=110) me->set("functions/godswordkee/level",110);
    else function_improved("godswordkee",random(20)+15);
        call_out("act4",1,msg,enemy,me);
        return 1;
        }
}

int act4(string msg,object target,object me)
{
        object room,*enemy;
        int damage,i,j,kee_lv;
        room = environment(me);
        enemy=me->query_enemy(room);
        target=offensive_target(me);
        kee_lv=me->query_function("godswordkee");
        j=sizeof(enemy);
        if (j<1)
        {
        me->delete_temp("usegodsword");
        return notify_fail("‘没敌人..打鸟欧。\n");
        }
        else
        {
        damage = 100 + kee_lv + random(me->query_skill("godsword"));
        message_vision(HBCYN"$N身上神剑气劲发出骇人光芒...\n"NOR,me);
     for(i=0;i < j;i++)
     {
 if(random((me->query("combat_exp")/10000)+me->query_skill("godsword")*10+me->query_skill("dodge"))>random(enemy[i]->query_skill("dodge")+enemy[i]->query_skill("parry")+(enemy[i]->query("combat_exp")/20000)))

          {
           message_vision(HBCYN"$N步若游光使出若有若无.祭出"HIY"〓湛卢剑〓"HIC",剑气烘燃，一流宏大的剑压逼近$n。\n"NOR,me,enemy[i]);
           message_vision(HIR"$n闪躲不及，当场被此宏大的剑气贯穿。\n"NOR,me,enemy[i]);
           me->add("force",-50);
           enemy[i]->receive_damage("kee",damage);
           COMBAT_D->report_status(enemy[i]);
           } else {
           message_vision(HBCYN"$N步若游光使出若有若无.祭出"HIY"〓湛卢剑〓"HIC",剑气烘燃，一流宏大的剑压逼近$n。\n"NOR,me,enemy[i]);
           message_vision(HIB"$n全神贯注盯紧湛卢剑，在费尽千辛万苦之后总算闪过这一击。\n"NOR,me,enemy[i]);
           me->add("force",-20);
          }
        }
               me->set_temp("usesunsword",1);
    if(kee_lv >=110) me->set("functions/godswordkee/level",110);
    else function_improved("godswordkee",random(20)+15);
         call_out("act5",1,msg,target,me);

        return 1;
        }
}
int act5(string msg,object target,object me)
{
        object room,*enemy;
        int damage,i,j,kee_lv;
        room = environment(me);
        enemy=me->query_enemy(room);
        target=offensive_target(me);
        j=sizeof(enemy);
        kee_lv=me->query_function("godswordkee");
        if (j<1)
        {
        me->delete_temp("usegodsword");
        return notify_fail("‘没敌人..打鸟欧。\n");
        }
        else
        {
        damage = 110 + kee_lv + random(me->query_skill("godsword"));
        message_vision(HBCYN"$N身上神剑气劲发出骇人光芒...\n"NOR,me);
     for(i=0;i < j;i++)
     {
        if(!enemy[i]) continue;
 if(random((me->query("combat_exp")/10000)+me->query_skill("godsword")*10+me->query_skill("dodge"))>random(enemy[i]->query_skill("dodge")+enemy[i]->query_skill("parry")+(enemy[i]->query("combat_exp")/20000)))

          {
           message_vision(HBCYN"$N抚剑如静，心若止水剑光潋艳，念动口诀，"HIY"〓龙泉剑〓"HIC"泛起波波杀意如刃向$n绕流而去。\n"NOR,me,enemy[i]);
           message_vision(HIR"$n闪躲不及，当场被此宏大的剑气贯穿。\n"NOR,me,enemy[i]);
           me->add("force",-50);
           enemy[i]->receive_damage("kee",damage);
           COMBAT_D->report_status(enemy[i]);
          } else {
           message_vision(HBCYN"$N抚剑如静，心若止水剑光潋艳，念动口诀，"HIY"〓龙泉剑〓"HIC"泛起波波杀意如刃向$n绕流而去。\n"NOR,me,enemy[i]);
           message_vision(HIB"$n全神贯注盯紧龙泉剑，在费尽千辛万苦之后总算闪过这一击。\n"NOR,me,enemy[i]);
           me->add("force",-20);
          }
        }
        me->set_temp("usesunsword",1);
    if(kee_lv >=110) me->set("functions/godswordkee/level",110);
    else function_improved("godswordkee",random(20)+15);
        call_out("act6",1,msg,target,me);
        return 1;
