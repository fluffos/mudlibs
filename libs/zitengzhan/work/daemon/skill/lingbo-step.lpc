//凌波微步 水月宫 by take
//【凌波微步】
//        翩若惊鸿  婉若游龙  轻云蔽月 流风回雪
//        动无常则  若危若安  神光离合  乍阴乍阳


inherit SKILL;

string *dodge_msg = ({
	"$n不进不退，身形只是稍稍一转，宛若一道轻风般从$N身边掠过。\n",
	"$n右脚踏了个虚步，翩若惊鸿，凌空从$N头顶踏了过去。\n",
	"$n左足一点，轻云蔽月，身形急转数个圈后，轻飘飘地落在了$N身后。\n",
	"但是$n婉若游龙，身子如行云流水般借着$N的气势连踩几步一霎那间后退数尺。\n",
	"可是$n腰身微动，一招流风回雪平地越起数丈，宛如离合神光动无常则。\n",
	"$n步法乍阴乍阳，脚踏微步，身如凌波$N只看得呆了。\n"
});

int valid_enable(string usage)
{
	return (usage=="dodge") || (usage=="move");
}

int valid_learn(object me)
{
	if( (int)me->query("max_force") < 0 )
		return notify_fail("你的内力不够，没有办法学凌波微步。\n");

	return 1;
}

string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
	if( (int)me->query("kee") < 30)
		return notify_fail("你现在太虚弱，练凌波微步当心受伤。\n");
	if((int)me->query("force") < 5 )
		return notify_fail("你现在内力不够，不能平地起凌波。\n");
	me->receive_damage("kee", 30);
	me->add("force", -5);
	return 1;
}
