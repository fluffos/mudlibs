// mantian.c 青霞漫天
//modify for 大唐西游2 by huarong 2003/12
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target) {
  object weapon;
  string msg;
  int skill;
  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || target->is_corpse() || target == me)
    return notify_fail("你要攻击谁？\n");

  if (me->query("family/family_name") != "盘丝洞")
    return notify_fail("[青霞漫天]是盘丝洞不传之密！\n");
  if (!me->is_fighting())
    return notify_fail("「青霞漫天」只能在战斗中使用。\n");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("「青霞漫天」开始时必须拿着一把剑！\n");

  if ((int)me->query("force") < 300)
    return notify_fail("你的内力不够！\n");

  if ((int)me->query_skill("qingxia-jian", 1) < 100)
    return notify_fail("你的青霞剑法还不到家，无法使用「青霞漫天」！\n");

  if (time() - (int)me->query_temp("sq_end") < 6)
    return notify_fail("绝招用多就不灵了！\n");


  skill = ((int)me->query_skill("sword", 1) + (int)me->query_skill("qingxia-jian", 1)) * 3 / 2;
  msg = HIB + "\n$N" + HIB + "使出青霞剑法的绝技" + NOR + RED + "「青霞剑法」" + HIB + "，手中的" + weapon->name() + HIB + "已然出鞘！\n" NOR;
  message_vision(msg, me, target);
  if (userp(me)) {
    me->add_temp("apply/attack", skill);
    me->add_temp("apply/damage", skill);
    target->add_temp("apply/dodge", -skill);
    target->add_temp("apply/parry", -skill);
  }
  msg = HIY "\n只见$N" + HIY + "突然向后疾退两步，" + HIR + "青霞漫天" + HIY + "，一剑刺向$n的左肩！\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
  msg = HIW "\n$N" + HIW + "万点剑芒云起风涌，，如清风拂铃" + HIB + "漫天、漫天" + HIW + "，两剑削向$n" + HIW + "的双肩！" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
  msg = HIC "\n$N" + HIC + "见对方中招，机会难得，，又闪电般攻出三招，" + HIM + "、剑天、剑芒、剑心" + HIC + "齐出朝$n的胸前攻出三剑" + HIC + "！" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
  me->add("force", -100);
  if (userp(me)) {
    me->add_temp("apply/attack", -skill);
    me->add_temp("apply/damage", -skill);
    if (target) {
      target->add_temp("apply/dodge", skill);
      target->add_temp("apply/parry", skill);
    }
  }
  me->set_temp("sq_end", time());

  return 1;
}
