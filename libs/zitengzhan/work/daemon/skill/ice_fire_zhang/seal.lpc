//icefire  by huarong 2003.3
#include <ansi.h>
inherit SSERVER;
#define PFM HIW"「"HIW"冰"HIR"火"HIY"符"HIW"」"NOR
void seal_attack(object me,object target,int type);

string* ghosts = ({"姚碧松","林敬忠","蔡子良","张子贵","陈贵先"});
string* dirs = ({HIB"中",HIM"北",HIC"西",HIG"南",HIW"东"});
int perform(object me, object target)
{
        int sealtype=3, time=3;
        int rand;
     //   if(!wizardp(me))
     //   	return 0;
        if( !target ) target = offensive_target(me);

        if( !target || !target->is_character() || !me->is_fighting(target) )
                return notify_fail(PFM"只能对战斗中的对手使用。\n");
    //    if(me->query("family/family_name")!="三界散仙")
        if (!PFM_D->valid_family(me, "三界散仙"))
              return notify_fail(PFM"是三界散仙的不传之秘。\n");

        if( (int)me->query_skill("ice_fire_zhang", 1) < 150 )
                return notify_fail("你的玄冰烈焰掌不够级别，不会使用"PFM"!\n");
                
        if( (int)me->query_skill("mysticism", 1) < 150 )
                return notify_fail("你的玄玄神机不够级别，不会使用"PFM"!\n");

        if( (int)me->query("force", 1) < 600 )
                return notify_fail("你现在内力太弱，不能使用"PFM"！\n");
                
        if( (int)me->query("mana", 1) < 600 )
                return notify_fail("你现在法力太弱，不能使用"PFM"！\n");
        
       if( time()-(int)me->query_temp("icefire_seal") < 10 && !wizardp(me))
              return notify_fail("你刚刚画过符，气息尚未恢复！\n");
       message_brief(me, target, "玄冰烈焰掌", "「冰火符」");
       message_vision(HIC"\n$N"+HIC+"口中喃喃地念了几句。\n",me,0,0,"env/brief_perform");
       message_vision(HIW"\n$N"+HIW+"右手在空中虚画几下，所到之处空气皆凝，隐约现一符状。\n"+NOR,me,0,0,"env/brief_perform");
       message_vision(HIR"\n$N"+HIR+"左手冒出一团烈火，窜入半空，那冰符竟似被点燃了一般。\n"+NOR,me,0,0,"env/brief_perform");
       message_vision(HIC"\n须臾之间，一道"PFM+HIC"已然作毕，却在$N上空凝而不发。\n"NOR,me,0,0,"env/brief_perform");
       message_vision(RED"
		                "WHT"*"RED"^
		 ^              "WHT"*"RED"^
		  ^"WHT"*"RED"   "HBYEL"       "NOR"  "WHT"*"RED"0C 
		  '7"WHT"*"RED"  "HBYEL"    "WHT"*"RED"^"WHT"*"NOR+RED"  "WHT"*"RED"7O     
		   !>"WHT"*"RED" "HBYEL"    "WHT"*"RED"^0"NOR+WHT"*"RED"  "WHT"*"RED"7$7  
		    C!"WHT"*"RED""HBYEL" "BLINK+HIC"道"NOR+HBYEL" "WHT"*"RED"^?"NOR+RED"^"WHT"*"RED" 0"WHT"*"RED"C$O
		    ^Q"WHT"*"RED""HBYEL"  "BLINK+HIB"法"NOR+HBYEL" "WHT"*"RED"0"NOR+RED"C>   $
		    -O$"HBYEL"-"WHT"*"RED" "BLINK+HIW"自"NOR+HBYEL" "WHT"*"NOR+RED"0Q?   $$
		    !O$"HBYEL"?"WHT"*"RED"  "BLINK+HIW"然"NOR+HBYEL" "NOR+WHT"*"RED">$$7
		     OO"HBYEL"O"WHT"* *"RED"   "NOR" "WHT"*"RED"?Q$> 
		      O"HBYEL"Q70>C"WHT"*"RED" "NOR+WHT"*"RED" "WHT"*"RED"$   
		      O"HBYEL"$C -Q"WHT"*"RED" "NOR+RED"O !$
		       $$7>$?0!$O$   
		        O$O$O 7$\n"NOR,me,0,0,"env/brief_perform");
		   rand = 1+random(100);
       if(rand==100)
       {
       	sealtype = 0; // 0: 生死符 1%
       	time = 3; // 3s
       }
       else if(rand>=79)
       {
       	sealtype = 1; // 1: 招鬼符 20%
       	time = 1;
       }
       else if(rand>=55)
       {
       	sealtype = 2; // 2: 祈禳符 24%
       	time = 1;
       }
       else if(rand>=30)
       {
       	sealtype = 3; // 3: 瘟病符 25%
       	time = 1;
       }
       else
       {
       	sealtype = 4; // 4: 禁解符 30%
       	time = 1;
       }
       me->add("force",(sealtype-5)*100);
       me->add("mana",(sealtype-5)*100);
       if(me->query("force")<0)
       	me->set("force",0);
       if(me->query("mana")<0)
       	me->set("mana",0);
       call_out("seal_attack", time, me, target,sealtype);
       me->set_temp("icefire_seal", time());
       return 1;
   }

void seal_attack(object me,object target,int type)
{
	string str;
	int skill, i, num;
	object ghost;
	if(!me)
		return;
	if(!target)
	{
		message_vision(HIC"\n$N双手连抓，收回了"PFM"\n"NOR,me,0,0,"env/brief_perform");
		message_vision(HIG"一股寒光闪入$N的前胸，激起几道蓝焰，再无踪迹。\n"NOR,me,0,0,"env/brief_perform");
		message_vision(HIG"$N感到全身舒畅，无所不适。\n"NOR,me,0,0,"env/brief_perform");
		me->receive_curing("kee",random((5-type)*800));
		me->receive_curing("sen",random((5-type)*800));
		me->add("force",random((5-type)*500));
		me->add("mana",random((5-type)*500));
		if(me->query("force")>2*me->query("max_force"))
				me->set("force",2*me->query("max_force"));
		if(me->query("mana")>2*me->query("max_mana"))
			me->set("mana",2*me->query("max_mana"));
		return;
	}
	switch(type)
	{
		case 0:
			message_vision("\n		　　　"HBYEL+BLINK+BLU"　死 "WHT"生　\n\n"NOR,me,0,0,"env/brief_perform");
			message_vision("\n"PFM+YEL"从$n的前胸透体而过，$n的眼球死鱼眼一般突了出来，恐怖异常！\n"NOR,me,target,0,"env/brief_perform");
			target->set("eff_kee",-1);
			target->set("kee",-1);
			target->set("eff_sen",-1);
			target->set("sen",-1);
			target->receive_wound("sen",target->query("max_sen")+1, me);
			COMBAT_D->report_status(target);
			COMBAT_D->report_sen_status(target);
			str=target->name()+HIM+"死在"+me->name()+HIM"祭出的冰火符﹢死生咒之下，据说尸体两眼突出如珠，全身僵硬如石。";
			target->die();
			message("channel:rumor",HIM"【空穴来风】某人："+str+"\n"NOR,users()); 
			break;
		case 1:
			message_vision("\n		　　　"HBYEL+BLINK+BLU"　招 "WHT"送　\n\n"NOR,me,0,0,"env/brief_perform");
			str = HIC"$N朗声念到：弟子"+me->name()+HIC"拜请\n"HIB;
			skill = (int)me->query_skill("ice_fire_zhang",1);
			num = skill/80+1;
			if(num>5)
				num = 5;
			for(i=0;i<num;i++)
			{
				str += " "+dirs[i]+"方小鬼"+ghosts[i];
		  }
		  str+= HIY"\n\n		速来助我！\n\n"NOR;
		  message_vision(str,me,target,0,"env/brief_perform");
		  message_vision(PFM+HIB"上一阵烟雾缭绕，"+HIB"几只小鬼不知从何处冒了出来。\n"NOR,me,0,0,"env/brief_perform");
		  for(i=0;i<num;i++)
			{
				ghost = new("/d/sanxian/npc/ghost.lpc");
				ghost->set("name",ghosts[i]);
				ghost->move(environment(me));
				ghost->set_skill("unarmed",skill-random(20));
				ghost->set_skill("ice_fire_zhang",skill-random(20));
				ghost->set_skill("force",skill-random(20));
				ghost->set_skill("butian-force",skill-random(20));
				ghost->set_skill("whip",skill-random(20));
				ghost->set_skill("wuwei-fuchen",skill-random(20));
				ghost->set_skill("sword",skill-random(20));
				ghost->set_skill("spysword",skill-random(20));
				ghost->set("combat_exp",random(me->query("combat_exp")/2)+me->query("combat_exp")/2);
				ghost->command("hi "+me->query("id"));
				ghost->kill_ob(target);
				switch(i)
				{
					case 0:
						ghost->command("perform icefire on "+target->query("id"));
						break;
					case 1:
						ghost->command("perform qiansi on "+target->query("id"));
						break;
					case 2:
						ghost->command("perform dunnoname on "+target->query("id"));
						break;
					case 3:
						ghost->command("perform bishou on "+target->query("id"));
						break;
					case 4:
						ghost->command("perform dunnotruth on "+target->query("id"));
						break;
					default:
						break;
				}				
				if(target->query_temp("last_damage_from")==ghost)
					target->set_temp("last_damage_from", me);
				if(target->query_temp("last_fainted_from")==ghost)
					target->set_temp("last_fainted_from", me->query("id"));
				destruct(ghost);
		  }
			break;
		case 2:
			skill = (int)me->query_skill("ice_fire_zhang",1)+(int)me->query_skill("mysticism",1);
			message_vision("\n		　　　"HBYEL+BLINK+BLU"　祈 "WHT"禳　\n\n"NOR,me,0,0,"env/brief_perform");
			message_vision(HIC"$n被符篆所咒，元气直泻！\n"NOR,me,target,0,"env/brief_perform");    
			target->set("force",target->query("force")/3);
			target->set("mana",target->query("mana")/3);
			me->add("force",target->query("force")/3);
			me->add("mana",target->query("mana")/3);
			if(me->query("force")>2*me->query("max_force"))
				me->set("force",2*me->query("max_force"));
			if(me->query("mana")>2*me->query("max_mana"))
				me->set("mana",2*me->query("max_mana"));
			message_vision(HIC"$N乘机攻出两招！\n"NOR,me,target,0,"env/brief_perform");  
			message_vision(HIW"$N右掌带着一股极寒劲气，印在$n的胸口。\n"NOR,me,target,0,"env/brief_perform");
			target->receive_wound("kee",skill/3);
			COMBAT_D->report_status(target);
			message_vision(HIR"$N左掌中夹带着几道火焰，印在$n的胸口。\n"NOR,me,target,0,"env/brief_perform");
			target->receive_wound("kee",skill/3);
			COMBAT_D->report_status(target);
			break;
		case 3:
			skill = (int)me->query_skill("ice_fire_zhang",1)+(int)me->query_skill("mysticism",1);
			message_vision("\n		　　　"HBYEL+BLINK+BLU"　病 "WHT"瘟　\n\n"NOR,me,0,0,"env/brief_perform");
			target->receive_wound("kee",skill/2+random(skill/2));
			COMBAT_D->report_status(target);
			message_vision(HIC"$n被符篆所咒，元神顿泄！\n"NOR,me,target,0,"env/brief_perform");             
			target->apply_condition("ziwuliuzhu_poison",skill/5);
			target->set_temp("mark/ziwuliuzhu", 1);
			tell_object(target,HIB"猛地里你感觉什么神奇的东西在内元一转，似乎多了什么，又似乎少了什么。\n"NOR); 
			break;
		case 4:
			message_vision("\n		　　　"HBYEL+BLINK+BLU"　禁 "WHT"解　\n\n"NOR,me,0,0,"env/brief_perform");
			message_vision(HIC"$n被符篆所咒，动弹不得！\n"NOR,me,target,0,"env/brief_perform");    
			target->start_busy(2+random(3));
			break;
	}
}
