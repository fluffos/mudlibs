//BY nanf 2011.01 wangqing.c <忘情决>

#include <ansi.h>
#include <combat.h>
inherit SSERVER;

#define PFM "「" HIG "忘情决" NOR "」"

string *poem = ({
  BLINK + HIC "\n回梦里、再言痴语。\n" NOR,
  BLINK + HIG "\n曳曳风华抚曲。\n" NOR,
  BLINK + HIM "\n婉转似述有情思，漫天彩蝶飞舞。\n" NOR,
  BLINK + HIY "\n迷魂处。\n" NOR,
  BLINK + HIW "\n凝望去，一笑逍遥君无复。\n" NOR,
  BLINK + HIR "\n牛郎织女。\n" NOR,
  BLINK + HIB "\n纵长相厮守，叹而哪及，此番相聚。\n\n" NOR,

  BLINK + HIC "\n枉流连，凝香冷月仙途。\n" NOR,
  BLINK + HIG "\n参得三无三不。\n" NOR,
  BLINK + HIM "\n月蚀花变星河冷，无数风回雪舞。\n" NOR,
  BLINK + HIY "\n无情苦。\n" NOR,
  BLINK + HIW "\n长恨天、嘘一生终伴玄狐。\n" NOR,
  BLINK + HIR "\n吾谁与诉。\n" NOR,
  BLINK + HIB "\n忘却世间情，凄清广寒，红尘了无顾。\n" NOR,
});

void remove_wangqing(object me) {
  if (!me)
    return;
  me->delete_temp("wangqing");
}

int wangqing(object me, object target, int witch) {
  object weapon = me->query_temp("weapon");
  int mod, damage;
  string msg;

  if (!objectp(me)) {
    call_out("remove_wangqing", 3, me);
    return 0;
  }

  if (!living(me)) {
    call_out("remove_wangqing", 3, me);
    return 0;
  }

  if (!objectp(target) || !living(target)) {
    message_vision(sprintf("$N缓缓收拢了%s的攻势！\n", PFM), me);
    call_out("remove_wangqing", 3, me);
    return 0;
  }

  if (!objectp(weapon = me->query_temp("weapon")) ||
    (string)weapon->query("skill_type") != "whip") {
    tell_object(me, sprintf("你换了兵器，%s的攻势瓦解了！\n", PFM));
    message_vision(sprintf("$N缓缓收拢了%s的攻势！\n", PFM), me);
    call_out("remove_wangqing", 3, me);
    return 0;
  }

  if ((int)me->query("force") < 200) {
    tell_object(me, sprintf("你的内力不足，%s的攻势瓦解了！\n", PFM));
    message_vision(sprintf("$N缓缓收拢了%s的攻势！\n", PFM), me);
    call_out("remove_wangqing", 3, me);
    return 0;
  }

  if (me->query_skill_mapped("whip") != "jueqingbian") {
    tell_object(me, sprintf("你改用了别的鞭法，%s的攻势瓦解了！\n", PFM));
    message_vision(sprintf("$N缓缓收拢了%s的攻势！\n", PFM), me);
    call_out("remove_wangqing", 3, me);
    return 0;
  }

  if (!me->is_fighting()) {
    message_vision(sprintf("$N缓缓收拢了%s的攻势！\n", PFM), me);
    call_out("remove_wangqing", 3, me);
    return 0;
  }

  message_vision(poem[witch], me, target);
  mod = 5 * target->query("eff_kee") / to_float(target->query("max_kee"));
  ++mod;
  if (me->query("combat_exp") * mod > random(target->query("combat_exp"))) {
    if (target->query("eff_kee") > 50) {
      if (!target->is_busy())
        target->start_busy(1);
      damage = target->query("eff_kee") * mod / 10;
      if (damage) {
        target->receive_wound("kee", damage);
        COMBAT_D->report_status(target);
      }
    }
  }

  ++witch;
  if (witch >= sizeof(poem)) {
    call_out("remove_wangqing", 3, me);
    return 0;
  }
  call_out("wangqing", 1 + random(2), me, target, witch);
}

int perform(object me, object target) {
  string msg;

  object weapon = me->query_temp("weapon");

  if (!me->query("secret/JQB/wangqing") && !wizardp(me))
    return notify_fail("你懂" PFM "吗？\n");

  if (me->query_temp("wangqing"))
    return notify_fail("你现在不能使用" PFM "！\n");

  if (!target)
    target = offensive_target(me);

  if (!target || !target->is_character() || target->is_corpse() || target == me)
    return notify_fail("没事不要乱用" PFM "。\n");

  if (!me->is_fighting())
    return notify_fail(PFM "只能在战斗中使用！\n");

  if ((int)me->query("max_force") < 3500)
    return notify_fail("你的内力不够！\n");

  if ((int)me->query("force") < 1000)
    return notify_fail("你的内力不足！\n");

  if ((int)me->query("sen") < 250)
    return notify_fail("你的精神不足，没法子施用外功！\n");

  if ((int)me->query_skill("jueqingbian", 1) < 200)
    return notify_fail("你的绝情鞭法不够熟练，使用这一招会有困难！\n");

  if (me->query("gender") != "女性")
    return notify_fail("你一个大男人，怎么能懂得女儿家的心事！");

  me->set_temp("wangqing", 1);
  msg = HIC "\n伴着一首" HIM "痴梦令" HIC "，$N轻盈地舞了起来，手中" + weapon->name() + HIC "萤光流转，煞是好看。\n" NOR;
  message_vision(msg, me, target);

  if (!target->is_busy())
    target->start_busy(1);
  me->start_busy(2);

  call_out("wangqing", 1, me, target, 0);

  return 1;
}
