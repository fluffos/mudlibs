//BY nanf 2011.01 wuqing.c <无情决>

#include <ansi.h>
#include <combat.h>
inherit SSERVER;

#define PFM "「" HIG "无情诀" NOR "」"

string *poem = ({
  BLINK + HIC "\n枉流连，凝香冷月仙途。\n" NOR,
  BLINK + HIG "\n参得三无三不。\n" NOR,
  BLINK + HIM "\n月蚀花变星河冷，无数风回雪舞。\n" NOR,
  BLINK + HIY "\n无情苦。\n" NOR,
  BLINK + HIW "\n长恨天、嘘一生终伴玄狐。\n" NOR,
  BLINK + HIR "\n吾谁与诉。\n" NOR,
  BLINK + HIB "\n忘却世间情，凄清广寒，红尘了无顾。\n" NOR,
});

int perform(object me, object target) {
  string msg;
  int i, attack, damage;

  object weapon = me->query_temp("weapon");

  if (!me->query("secret/JQB/wuqing") && !wizardp(me))
    return notify_fail("你懂" PFM "吗？\n");

  if (time() - me->query_temp("wuqing") < 6)
    return notify_fail("你刚刚使用过" PFM "！\n");

  if (!target)
    target = offensive_target(me);

  if (!target || !target->is_character() || target->is_corpse() || target == me)
    return notify_fail("没事不要乱用" PFM "。\n");

  if (!me->is_fighting())
    return notify_fail(PFM "只能在战斗中使用！\n");

  if ((int)me->query("max_force") < 2500)
    return notify_fail("你的内力不够！\n");

  if ((int)me->query("force") < 1000)
    return notify_fail("你的内力不足！\n");

  if ((int)me->query("sen") < 250)
    return notify_fail("你的精神不足，没法子施用外功！\n");

  if ((int)me->query_skill("jueqingbian", 1) < 200)
    return notify_fail("你的绝情鞭法不够熟练，使用这一招会有困难！\n");

  if (me->query("gender") != "女性")
    return notify_fail("你一个大男人，怎么能懂得女儿家的心事！");

  if (!PFM_D->valid_family(me, "月宫"))
    return notify_fail(PFM "是月宫绝技，你虽领悟，也不能随便使！\n");

  message_brief(me, target, "绝情鞭", "「无情诀」");
  msg = HIC "\n伴着一首" + HIM "痴梦令" HIC "，$N轻盈地舞了起来，手中" + weapon->name() + HIC "萤光流转，煞是好看。\n" NOR;
  message_vision(msg, me, target, 0, "env/brief_perform");


  if (!target->is_busy())
    target->start_busy(2);

  attack = me->query_temp("apply/attack");
  damage = me->query_temp("apply/damage");
  for (i = 0; i < sizeof(poem); i++) {
    message_vision(poem[i], me, target, 0, "env/brief_perform");
    me->add_temp("apply/attack", i * 20);
    me->add_temp("apply/damage", i * 20);
    COMBAT_D->do_attack(me, target, weapon, 0, "env/brief_perform");
  }
  me->set_temp("apply/attack", attack);
  me->set_temp("apply/damage", damage);
  me->set_temp("wuqing", time());
  return 1;
}
