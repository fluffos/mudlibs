//lestat for moon
//2001 三无三不手

#include <ansi.h>

inherit F_DBASE;
inherit SSERVER;

void jqb_secret(object me, object target);
int perform(object me, object target) {
  object weapon;
  int skill, i;
  string msg;
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展「三无三不手」?\n");
  if (time() - (int)me->query_temp("JQB_end") < 6)  //old is 10 huarong 2003.3.18
    return notify_fail("绝招用多就不灵了！\n");

  if (!me->query("JQB_known"))
    return notify_fail("痴梦没有传你「三无三不手」。。。\n");
  if (me->query_temp("JQB_perform"))
    return notify_fail("你已经使出「三无三不手」了！\n");
  if (me->query("secret/JQB_wangqing"))
    return notify_fail("你已经领悟了「忘情」，忘掉「三无三不手」了！\n");
  if (!me->is_fighting(target))
    return notify_fail("三无三不手只能在战斗中使用!!\n");

  if ((int)me->query("max_force") < 1000)
    return notify_fail("你的内力不够！\n");

  if ((int)me->query("force") < 500)
    return notify_fail("你的内力不足！\n");

  if ((int)me->query("sen") < 50)
    return notify_fail("你的精神不足，没法子施用外功！\n");

  if ((int)me->query_skill("jueqingbian", 1) < 100)
    return notify_fail("你的绝情鞭级别还不够施展这一招三无三不手!!\n");
  if ((int)me->query_skill("moondance", 1) < 100)
    return notify_fail("你的冷月凝香舞等级不够!!\n");
  if ((int)me->query_skill("moonforce", 1) < 100)
    return notify_fail("你的圆月心法等级太低!!\n");
  if ((int)me->query_skill("moonshentong", 1) < 100)
    return notify_fail("你的月宫仙法等级不够!!\n");
  if ((string)me->query("gender") != "女性" && !wizardp(me))
    return notify_fail("你非为纯阴之身,怎能知哓女儿家的心思??\n");
  //  if(me->query("family/family_name") != "月宫" )
  if (!PFM_D->valid_family(me, "月宫"))
    return notify_fail("你与痴梦无缘,领悟不到鞭法的精髓!!\n");

  message_brief(me, target, "绝情鞭", "「三无三不手」");

  weapon = me->query_temp("weapon");
  msg = HIC
    "\n问世间情为何物?直叫人生死相许!$N" + HIC + "心中一阵酸楚,鞭法忽然变得灵动异常!\n" NOR;
  message_vision(msg, me, target, 0, "env/brief_perform");

  skill = me->query_skill("whip");
  me->add_temp("apply/attack", skill / 3);

  if (me->query("JQB_ask") && !me->query("env/brief_perform")) {
    tell_object(me, HIB "你心里有事想问师傅，挥出的招数愈发不成章法。\n");
  } else
    me->set_temp("JQB_perform", 1);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0, "env/brief_perform");
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0, "env/brief_perform");
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0, "env/brief_perform");
  me->delete_temp("JQB_perform");
  if (random(1) == 0 && !me->query("JQB_ask")) {
    me->add_temp("apply/damage", skill / 3);
    msg = HIC "\n问世间情为何物?直叫人生死相许!$N" + HIC + "心中不禁纳闷，师傅心里为什么这么苦呢！爱一个人不是很美好的事吗？\n" NOR;
    msg += HIM "$N莞尔一笑，鞭法陡变，居然不照师傅教你的套路出招！\n\n";
    message_vision(msg, me, target, 0, "env/brief_perform");
    msg = HIW "$N一鞭挥出，似乎又想通了什么！\n";
    for (i = 0; i < 1; i++) {
      message_vision(msg, me, target);
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0, "env/brief_perform");
    }
    me->add_temp("apply/damage", -1 * skill / 3);
    jqb_secret(me, target);
  }
  me->add_temp("apply/attack", -1 * skill / 3);
  me->add("force", -200);

  me->start_busy(1 + random(3));

  return 1;
}
// 经测试0转24小时大概能杀1800个妖怪（li+mp）
// 12天大概20000个
// 每400次给一次机会，总共50次左右
// 考虑到其它因素，平均每两个id可能出三招中的一招

// 2011-1-6，提高了获得机会的概率random(500)->random(200)
void jqb_secret(object me, object target) {
  // 通过sanshou杀死lijing menpai妖怪，有机会获得问痴梦的机会
  if (!target->query("quest_npc") || target->query("owner") != me->query("id"))
    return;
  //if (target->query("eff_kee")<0 || (!living(target) && target->query("kee")<0))
  if (target->query("eff_kee") < 0 || target->query("kee") < 0) {
    if (me->query("age") < 18 && !me->query("secret/JQB/youqing") /*&& !random(200)*/) {
      if (!me->query("env/brief_perform"))
        tell_object(me, BLINK + HIB "你使完这招，心中颇为得意。\n");
      if (!me->query("JQB_time"))
        me->set("JQB_time", 1);
      else
        me->add("JQB_time", 1);
      if (me->query("JQB_time") >= 400) {
        me->set("JQB_ask", 1);
        me->set("JQB_time", 0);
        if (!me->query("env/brief_perform"))
          tell_object(me, BLINK + HIB "你使完这招，心里大惑不解，你感到有些事情必须向师傅问清楚。\n");
      }
    }
    if (me->query("age") >= 18 && me->query("age") < 22 && !me->query("secret/JQB/wuqing") /*&& !random(200)*/) {
      if (!me->query("env/brief_perform"))
        tell_object(me, BLINK + HIB "你使完这招，心中闷闷不乐。\n");
      if (!me->query("JQB_time"))
        me->set("JQB_time", 1);
      else
        me->set("JQB_time", me->query("JQB_time") + 1);
      if (me->query("JQB_time") >= 400) {
        me->set("JQB_ask", 1);
        me->set("JQB_time", 0);
        if (!me->query("env/brief_perform"))
          tell_object(me, BLINK + HIB "你使完这招，心里大惑不解，你感到有些事情必须向师傅问清楚。\n");
      }
    }
    if (me->query("age") >= 22 && me->query("age") < 26 && !me->query("secret/JQB/wangqing") /*&& !random(200)*/) {
      if (!me->query("env/brief_perform"))
        tell_object(me, BLINK + HIB "你使完这招，心中凄苦。\n");
      if (!me->query("JQB_time"))
        me->set("JQB_time", 1);
      else
        me->add("JQB_time", 1);
      if (me->query("JQB_time") >= 400) {
        me->set("JQB_ask", 1);
        me->set("JQB_time", 0);
        if (!me->query("env/brief_perform"))
          tell_object(me, BLINK + HIB "你使完这招，心里大惑不解，你感到有些事情必须向师傅问清楚。\n");
      }
    }
  }
}
