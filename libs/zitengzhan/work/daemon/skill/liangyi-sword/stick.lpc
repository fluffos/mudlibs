#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  int damage, skill, myexp, youexp, mystr, myunarmed, myforce, skilll, ap, dp, i, j, mz;
  object weapon = me->query_temp("weapon");
  string msg;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail(HIR + "「剑计」" + NOR + "只能对战斗中的对手使用。\n");
  if (!wizardp(me) && me->query("family/family_name") != "方寸山三星洞")
    return notify_fail(HIR + "「剑计」" + NOR + "只有方寸山三星洞门人才可以用！\n");

  if ((int)me->query("force") < 2000)
    return notify_fail("你的内力不够了!\n");


  if ((int)me->query_skill("sword", 1) < 250
    || me->query_skill_mapped("sword") != "liangyi-sword")
    return notify_fail("你的「基本剑术」还不到家，无法使用" + HIR + "「剑计」" + NOR + "！\n");

  if ((int)me->query_skill("qianjun-bang", 1) < 250)
    return notify_fail("你的「千钧棒」还不到家，无法使用" + HIR + "「剑计」" + NOR + "！\n");

  if ((int)me->query_skill("puti-zhi", 1) < 250)
    return notify_fail("你的「菩提指」还不到家，无法使用" + HIR + "「剑计」" + NOR + "！\n");

  if ((int)me->query_skill("liangyi-sword", 1) < 250)
    return notify_fail("你的「两仪剑」等级不够，无法推动" + HIR + "「剑计」" + NOR + "！\n");

  if ((int)me->query_skill("wuxiangforce", 1) < 250)
    return notify_fail("你的「小无相功」还不到家，无法自由控制剑进行" + HIR + "「剑计」" + NOR + "！\n");

  if (time() - (int)me->query_temp("ly_end") < 10)
    return notify_fail("此乃方寸山之精髓所在，用多了就烂了！\n");


  skill = (int)me->query_skill("stick") + (int)me->query_skill("unarmed") + (int)me->query_skill("sword");
  me->add_temp("mingzhong", 30);
  me->add_temp("apply/damage", skill / 3);
  me->delete("env/brief_message");
  target->delete("env/brief_message");
  weapon->set_temp("original/use_apply_skill", weapon->query("use_apply_skill"));
  weapon->set_temp("original/skill_type", weapon->query("apply/skill_type"));

  message_vision(
    HIG "\n$N" + HIG + "默运小无相功，手中" + HIY + weapon->query("name") + HIG + "清描淡写的划出三剑。\n" NOR,
    me,
    target
  );
  COMBAT_D->do_attack(me, target, weapon);
  COMBAT_D->do_attack(me, target, weapon);
  COMBAT_D->do_attack(me, target, weapon);
  me->add_temp("mingzhong", -30);
  me->add_temp("apply/damage", -skill / 3);
  message_vision(
    HIR + "\n$N" + HIR + "见$n" + HIR + "放松警惕，突然剑招一变，竟然以剑代棍使出" + HIY + "千钧棒法" + HIR + "绝招！\n" NOR,
    me,
    target
  );
  me->add_temp("mingzhong", 30);
  me->add_temp("apply/damage", skill / 2);
  me->set("actions", (: call_other, SKILL_D("qianjun-bang"), "query_action" :));
  weapon->set("use_apply_skill", 1);
  weapon->set("apply/skill_type", "stick");
  me->set_temp("QJB_perform", 8);
  damage = COMBAT_D->do_attack(me, target, weapon);
  me->delete_temp("QJB_perform");
  me->add_temp("mingzhong", -30);
  me->add_temp("apply/damage", -skill / 2);
  if (damage > 0) {
    skill = ((int)me->query_skill(
      "puti-zhi",
      1
    ) + (int)me->query_skill("wuxiangforce", 1) + (int)me->query_skill("unarmed", 1));
    ap = ((int)me->query_skill("unarmed", 1) + (int)me->query_skill("puti-zhi", 1));
    dp = ((int)target->query_skill("parry", 1) + (int)target->query_skill("dodge", 1));
    if (dp < 1) dp = 1;
    skilll = (int)me->query_skill("puti-zhi", 1);
    myexp = me->query("combat_exp");
    youexp = target->query("combat_exp");
    myunarmed = me->query_skill("unarmed");
    myforce = me->query("force_factor");
    mystr = me->query("str");
    me->add_temp("mingzhong", 30);
    mz = me->query_temp("mingzhong");
    if (mz < 0) mz = 0;
    i = (myexp / dp + random(myexp / dp)) + (myexp / dp + random(myexp / dp)) * mz / 100;
    j = youexp / ap + random(youexp / ap);
    msg = HIY "$N" + HIY + "一击得手，收剑入鞘，反手却使出菩提指！" NOR;
    message_vision(msg, me, target);
    message_vision(HIR "\n$N将双掌成虎形，使出菩提指法" + NOR + WHT + "--浩日诀--\n"
      +HIR + "$N" + HIR + "将十尺内的热气集中在双掌之内，只见$N" + HIR + "的双掌发出阵阵闷热的气劲\n"
      +HIR + "$N" + HIR + "双掌发光炙热，掌中聚集一颗明亮的" + HIW + "光球" + HIR + "！\n\n" NOR, me, target);
    message_vision(HIR "$N" + HIR + "双掌向前一推，掌中的菩提指气向$n" + HIR + "射出！\n"
      +HIY + "    -------------------------------------------------------------*\n"
      + "    =================浩==========日=========诀====================***\n"
      + "    -------------------------------------------------------------*\n\n" NOR, me, target);

    damage = (skill + (myforce + mystr) * 2) / 2 + random(skill + (myforce + mystr) * 2) / 2;

    if (i > j || target->query_temp("unconcious")) {
      message_vision(HIR "$n" + HIR + "躲避不及，被强大的指气击中，霎时烈火笼罩$n" + HIR + "全身！\n" NOR, me, target);
      damage -= target->query_temp("apply/armor_vs_force");
      if (damage < 0) damage = 0;

      target->receive_wound("kee", damage / 2 + random(damage / 2), me);
      target->receive_damage("kee", damage, me);
      COMBAT_D->report_status(target);
    } else {
      message_vision(HIM + "$n" + HIM + "看准来势，躲开了攻击。\n" NOR, me, target);
    }
    me->add_temp("mingzhong", -30);
  } else {
    skill = (int)me->query_skill("stick") + (int)me->query_skill("unarmed") + (int)me->query_skill("sword");
    msg = HIY "$N" + HIY + "一击未中，确不甘心，紧跟着又拔剑出鞘！" NOR;
    message_vision(msg, me, target);
    me->set("actions", (: call_other, SKILL_D("liangyi-sword"), "query_action" :));
    weapon->set("apply/skill_type", "sword");
    me->add_temp("mingzhong", 30);
    me->add_temp("apply/damage", skill / 3);
    COMBAT_D->do_attack(me, target, weapon);
    me->add_temp("mingzhong", -30);
    me->add_temp("apply/damage", -skill / 3);
  }

  weapon->set("use_apply_skill", weapon->query_temp("original/use_apply_skill"));
  weapon->set("apply/skill_type", weapon->query_temp("original/skill_type"));
  me->reset_action();
  me->start_busy(2);
  weapon->set("use_apply_skill", 0);
  me->set_temp("ly_end", time());
  return 1;
}
