inherit FORCE;

string *absorb_msg = ({
 "$n双臂一震，先天不坏功力决堤似的澎湃而出。\n",
        "$n施展出先天不坏功中的「弹」字诀，一股弹力传入$N的体内。\n",
        "$n使出一招「无畏战神」，凝虚为实，浑身硬如金刚。\n",
        "$n身体虚转，双手微划，无坚不摧的先天不坏功澎湃而出。\n",
        "$n身型微展，先天真气充斥了丈许空间。\n",
});

int valid_enable(string usage) { return (usage=="force")||(usage=="iron-cloth"); }

int valid_learn(object me) { return 1; }

int practice_skill(object me)
{
        return
notify_fail("先天不坏神功只能向师父学，或是从运用(exert)中增加熟练度。\n");
}
string exert_function_file(string func)
{
        return __DIR__"lengquan-force/" + func;
}

