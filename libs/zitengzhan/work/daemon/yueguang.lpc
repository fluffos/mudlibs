#include <ansi.h>
inherit SSERVER;
#include <login.h>

mixed *name=({
		({HIC"四不像","pet",80,2500,5000,80,4,1,3,500,120,21,600,600,2,50}),
		({HIB"月光仙兔","pet",110,3000,15000,110,5,2,3,1000,150,22,800,800,3,70}),
		({HIY"独角兽","pet",140,4000,25000,155,6,2,4,4000,200,23,1000,1000,4,110}),
		({HIG"谛魂兽","pet",170,2000,50000,190,7,3,4,10000,280,24,1500,1500,5,150}),
		({HIR"火炽朱雀","pet",200,2000,100000,230,8,3,5,25000,350,24,2000,2000,6,200}),
		({HIW"月光天使兽","pet",250,2000,200000,270,9,5,5,40000,450,24,2500,2500,7,300})
		});                   


int cast(object me, object ob)
{
  if(!objectp(ob)&&!ob->query("moon_petegg")
  return notify_fail("月光神术只能对宠物蛋使用！。\n");

        if (! present("pet egg", me)) return notify_fail("宠物蛋要抱在怀里才能施展月光术神术！。\n");

        if( me->is_fighting() )
                return notify_fail("你都自顾不暇了还有空去救别人？\n");

        if(me->query("family/family_name")!="月宫")
                return notify_fail("不是月宫弟子用不了月光神术！\n");
    
        if(me->query_skill("spells",1) < 100) 
                return notify_fail("你的基本法术不够纯熟！\n");
       if(me->query_skill("moonshentong",1) < 100) 
                return notify_fail("你的月宫仙法不够纯熟！\n");
        if( (int)me->query("max_mana") < 1000 )
                return notify_fail("你的法力太差！\n");
        if( (int)me->query("mana") < 1000 )
                return notify_fail("你的法力不够了！\n");

        if( (int)me->query("sen") < 1000 )
                return notify_fail("你的精神无法集中！\n");

        me->add("mana", -200);
        me->receive_damage("sen", 50);
        me->start_busy(1+random(2));

        message_vision(HIW"$N"+HIW+"从怀里掏出宠物蛋，施展起月光神术，面现温柔期盼之态，只见一道璀璨的月光直接照在了$n"+HIW+"上。\n"NOR,me,ob);
        ob->add("petburn",-1);
       if(ob->query("petburn") < 1) call_out("burn",1,me,ob);
        return 1;
}

void msgs(object me,object target)
{
 int i,j;
        if( !me ) return;
        if( !target) return;
        if( environment(me)!=environment(target) )
       {
        i = me->query_skill("buddhism",1);
        j = me->query_skill("spells",1);
        message_vision(HIR"  $N"+HIR+"突然脸色发白，浑身抖动不停！原来$n"+HIR+"和$N"+HIR+"之间的精神联系被掐断了。\n"NOR,me,target);
        message_vision(HIR"  $N"+HIR+"金身溃散，一下跌坐在地“哇”的一声吐出一口鲜血！不好！法力反噬了！！\n"NOR,me,target);
        tell_object(me,HIM"   你降了一级 基本法术 等级 。\n"NOR);
        tell_object(me,HIM"   你降了一级 大乘佛法 等级 。\n"NOR);
        tell_object(me,HIM"   你失去了200点最大法力值 。\n"NOR);
        me->add("max_mana",-200);
        me->set_skill("buddhism",i-1);
        me->set_skill("spells",j-1);
        me->unconcious();
        remove_call_out("msgs");
        remove_call_out("finish");
                return ;
         }
        if (me->query_temp("putuo_fuhuo"))
        {
        message_vision(COLOR_D->random_color(2,1)+"$N端坐虚空，缓缓念道：\n"+NOR+COLOR_D->random_color()+msg[random(sizeof(msg))]+"\n"+NOR,me);
        call_out("msgs",2,me,target);
        }
}

void finish(object me,object target)
{
      int i,j;
      string str;
        if( !me ) return;
        if( !target) return;
       me->delete_temp("putuo_fuhuo");
       if( environment(me)!=environment(target) )
       {
        i = me->query_skill("buddhism",1);
        j = me->query_skill("spells",1);
        message_vision(HIR"  $N"+HIR+"突然脸色发白，浑身抖动不停！原来$n"+HIR+"和$N"+HIR+"之间的精神联系被掐断了。\n"NOR,me,target);
        message_vision(HIR"  $N"+HIR+"金身溃散，一下跌坐在地“哇”的一声吐出一口鲜血！不好！法力反噬了！！\n"NOR,me,target);
        tell_object(me,HIM"   你降了一级 基本法术 等级 。\n"NOR);
        tell_object(me,HIM"   你降了一级 大乘佛法 等级 。\n"NOR);
        tell_object(me,HIM"   你失去了200点最大法力值 。\n"NOR);
        me->add("max_mana",-200);
        me->set_skill("buddhism",i-1);
        me->set_skill("spells",j-1);
        me->unconcious();
                return ;
         }
      i = me->query_skill("spells")/20;
      if (i > 100) i= 100;
           message_vision(HIY"\n    $N"+HIY+"大喝一声，【南无阿弥陀佛】！！浑身突然绽放万丈佛光！！\n"
                +HIY+"    $N"+HIY+"在半空中犹如佛陀降临！万丈佛光，刺穿天地！浩瀚佛唱，响彻三界！！\n"
                +HIY+"    $N"+HIY+"念头一动，凝聚出一尊佛手往虚空一抓，然后再往$n"+HIY+"身上一拍!!\n"
                +HIY+"    只见一团清光钻进了$n"+HIY+"的体内!!\n\n"NOR,me,target);
    if (target->query("death/dx_loss"))
  {
    tell_object (target,BLINK" "HIC"      你突然发现你上次死亡损失的道行恢复了"+i+"%！\n"NOR);
    target->add("daoxing", (int)target->query("death/dx_loss")*i/100);
    target->add("data_watch_exp",(int)target->query("death/dx_loss")*i/100);
  }
   if (target->query("death/combat_exp_loss"))
  {
    tell_object (target,BLINK" "HIC"      你突然发现你上次死亡损失的武学恢复了"+i+"%！\n"NOR);
    target->add("combat_exp", (int)target->query("death/combat_exp_loss")*i/100);
  target->add("data_watch_exp",(int)target->query("death/combat_exp_loss")*i/100);
  }
if (target->query("death/skill_loss")&&random(i)>50)
  {
    tell_object (target,BLINK" "HIC"      你突然发现你上次死亡损失的武功全部恢复了！\n"NOR);
    target->skill_death_recover();
  }
log_file("RECOVER","["+ctime(time())+"] "+sprintf("%s用如来往生咒复活了%s。\n"
, me->query("id"),target->query("id")));
  target->delete("death");
  target->save();
str = me->name()+"施展出佛门绝学"+NOR+HIG"「如来往生咒」"+NOR+HIM"复活了 "+target->name()+NOR+HIM", 真是佛陀转世！大德大能啊！";
message("channel:rumor",HIM"【空穴来风】某人："+str+"\n"NOR,users());
}