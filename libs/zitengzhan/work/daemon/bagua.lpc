#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  int damage, skill, myexp, mydao, texp, tdao, tskill, mz, mybusy, mystr, myforce, i;
  object weapon = me->query_temp("weapon");
  string msg;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail(HIR + "「先天八卦诀」" + NOR + "只能对战斗中的对手使用。\n");
  if (!wizardp(me) && me->query("family/family_name") != "五庄观")
    return notify_fail(HIR + "「先天八卦诀」" + NOR + "只有五庄观弟子才可以用！\n");

  if ((int)me->query("force") < 2000)
    return notify_fail("你的内力不够了!\n");

  if (me->is_busy())
    return notify_fail("你正忙着呢!\n");

  if (time() - (int)me->query_temp("ly_end") < 10)
    return notify_fail("此乃五庄观之精髓所在，用多了就烂了！\n");

  mz = me->query_temp("mingzhong");
  if (mz < 0) mz = 0;
  skill = me->query_skill("literate") + me->query_skill("taiyi") + me->query_skill("zhenyuan-force");
  tskill = target->query_skill("parry") + target->query_skill("dodge");
  myexp = me->query("combat_exp") / 10000;
  myexp += myexp * mz / 100;
  if (myexp < 1) myexp = 1;
  mydao = me->query("daoxing") / 10000;
  mydao += mydao * mz / 100;
  if (mydao < 1) mydao = 1;
  texp = target->query("combat_exp") / 10000;
  if (texp < 1) texp = 1;
  tdao = target->query("daoxing") / 10000;
  if (tdao < 1) tdao = 1;
  mybusy = 0;
  i = 0;
  myforce = me->query("force_factor");
  mystr = me->query_str();
  weapon->set_temp("original/use_apply_skill", weapon->query("use_apply_skill"));
  weapon->set_temp("original/skill_type", weapon->query("apply/skill_type"));

  message_vision(HIG "\n$N脚踏连环，脚下渐渐形成一副八卦图。居然是五庄观绝学【先天八卦诀】！\n" NOR, me, target);

  if ((int)me->query_skill("baguazhen", 1) > 49) {
    me->set_temp("wzg_bagua", 1);
    skill += me->query_skill("dodge");
    msg = HIB "$N转身一脚踏入【乾】门，对$n攻出一招" + HIG + "【天地定位·阳】" + HIB + "。\n" NOR;
    msg += HIB "$N脚踩八卦阵，围绕着$N滴溜溜的直转。\n" NOR;
    if ((myexp + skill) / 2 + random(myexp + skill) / 2 > (texp + tskill) / 2 + random(texp + tskill) / 2)
  )
  {
    msg += HIB "结果$n被$N转的头晕眼花，一下子反应不过来了。\n" NOR;
    i = 2 message_vision(msg, me, target);
    target->start_busy(i);
  } else {
    msg += HIB "$n目不转睛的盯着$N，丝毫不受步法的影响。\n" NOR;
    message_vision(msg, me, target);
  }
}

if ((int)me->query_skill("wuxingquan", 1) > 99 && my->query("force") > myforce) {
  me->set_temp("wzg_bagua", 1);
  me->add("force", -myforce);
  skill += me->query_skill("unarmed");
  damage = (skill + (myforce + mystr) * 2) / 2 + random(skill + (myforce + mystr) * 2) / 2;
  damage -= target->query_temp("apply/armor_vs_force");
  if (damage < 0) damage = 0;
  msg = HIB "$N转身一脚踏入【坤】门，对$n攻出一招" + HIG + "【天地定位·阴】" + HIB + "。\n" NOR;
  msg += HIB "$N运气于掌，凌空向$n拍出一掌。\n" NOR;
  if ((myexp + skill) / 2 + random(myexp + skill) / 2 > (texp + tskill) / 2 + random(texp + tskill) / 2) || target->query_temp("unconcious")
)
{
  msg += HIB "只听“嘭”的一声，$n被$N凌空一掌劈飞了出去。\n" NOR;
  message_vision(msg, me, target);
  target->receive_wound("kee", random(damage / 2), me);
  target->receive_damage("kee", damage, me);
  COMBAT_D->report_status(target);
} else {
  msg += HIB "$n潇洒的一转身，巧妙的躲开了$N的劈空掌力。\n" NOR;
  message_vision(msg, me, target);
}
mybusy += random(2);
}

if ((int)me->query_skill("sanqing-jian", 1) > 149 && (int)me->query_skill("sword") > 224) {
  me->set_temp("wzg_bagua", 1);
  msg = HIB "$N转身一脚踏入【艮】门，对$n攻出一招" + HIG + "【山泽通气·阳】" + HIB + "。\n" NOR;
  msg += HIB "$N模拟三清剑法，凌空向$n劈出一剑。\n" NOR;
  message_vision(msg, me, target);
  me->set("actions", (: call_other, SKILL_D("sanqing-jian"), "query_action" :));
  weapon->set("use_apply_skill", 1);
  weapon->set("apply/skill_type", "sword");
  COMBAT_D->do_attack(me, target, weapon);
  weapon->set("use_apply_skill", weapon->query_temp("original/use_apply_skill"));
  weapon->set("apply/skill_type", weapon->query_temp("original/skill_type"));
  me->reset_action();
  mybusy += random(2);
}

if ((int)me->query_skill("xiaofeng-sword", 1) > 199 && (int)me->query_skill("sword") > 299) {
  me->set_temp("wzg_bagua", 1);
  msg = HIB "$N转身一脚踏入【兑】门，对$n攻出一招" + HIG + "【山泽通气·阴】" + HIB + "。\n" NOR;
  msg += HIB "$N模拟晓风残月剑法，凌空向$n劈出一剑。\n" NOR;
  message_vision(msg, me, target);
  me->set("actions", (: call_other, SKILL_D("xiaofeng-sword"), "query_action" :));
  weapon->set("use_apply_skill", 1);
  weapon->set("apply/skill_type", "sword");
  COMBAT_D->do_attack(me, target, weapon);
  weapon->set("use_apply_skill", weapon->query_temp("original/use_apply_skill"));
  weapon->set("apply/skill_type", weapon->query_temp("original/skill_type"));
  me->reset_action();
  mybusy += random(2);
}

if ((int)me->query_skill(
  "staff",
  1
) > 249 && (int)me->query_skill_mapped("staff") == "fumo-zhang") {
  me->set_temp("wzg_bagua", 1);
  msg = HIB "$N转身一脚踏入【坎】门，对$n攻出一招" + HIG + "【水火不射·阳】" + HIB + "。\n" NOR;
  msg += HIB "$N模拟伏魔杖法，凌空向$n挥出一杖。\n" NOR;
  message_vision(msg, me, target);
  me->set("actions", (: call_other, SKILL_D("fumo-zhang"), "query_action" :));
  weapon->set("use_apply_skill", 1);
  weapon->set("apply/skill_type", "staff");
  COMBAT_D->do_attack(me, target, weapon);
  weapon->set("use_apply_skill", weapon->query_temp("original/use_apply_skill"));
  weapon->set("apply/skill_type", weapon->query_temp("original/skill_type"));
  mybusy += random(2);
}

if ((int)me->query_skill(
  "hammer",
  1
) > 299 && (int)me->query_skill_mapped("hammer") == "kaishan-chui") {
  me->set_temp("wzg_bagua", 1);
  msg = HIB "$N转身一脚踏入【离】门，对$n攻出一招" + HIG + "【水火不射·阴】" + HIB + "。\n" NOR;
  msg += HIB "$N模拟开山锤法，凌空向$n砸出一锤。\n" NOR;
  message_vision(msg, me, target);
  me->set("actions", (: call_other, SKILL_D("kaishan-chui"), "query_action" :));
  weapon->set("use_apply_skill", 1);
  weapon->set("apply/skill_type", "hammer");
  COMBAT_D->do_attack(me, target, weapon);
  weapon->set("use_apply_skill", weapon->query_temp("original/use_apply_skill"));
  weapon->set("apply/skill_type", weapon->query_temp("original/skill_type"));
  me->reset_action();
  mybusy += random(2);
}

if ((int)me->query_skill(
  "blade",
  1
) > 349 && (int)me->query_skill_mapped("blade") == "yange-blade") {
  me->set_temp("wzg_bagua", 1);
  msg = HIB "$N转身一脚踏入【震】门，对$n攻出一招" + HIG + "【雷风相薄·阳】" + HIB + "。\n" NOR;
  msg += HIB "$N模拟雁歌刀法，凌空向$n砍出一刀。\n" NOR;
  message_vision(msg, me, target);
  me->set("actions", (: call_other, SKILL_D("kaishan-chui"), "query_action" :));
  weapon->set("use_apply_skill", 1);
  weapon->set("apply/skill_type", "blade");
  COMBAT_D->do_attack(me, target, weapon);
  weapon->set("use_apply_skill", weapon->query_temp("original/use_apply_skill"));
  weapon->set("apply/skill_type", weapon->query_temp("original/skill_type"));
  me->reset_action();
  mybusy += random(2);
}

if ((int)me->query_skill("zouxiao", 1) > 399 && my->query("force") > myforce) {
  me->set_temp("wzg_bagua", 1);
  me->add("force", -myforce);
  skill += me->query_skill("zouxiao");
  msg = HIB "$N转身一脚踏入【巽】门，对$n攻出一招" + HIG + "【雷风相薄·阴】" + HIB + "。\n" NOR;
  msg += HIB "$N发出一声连绵不绝的长啸，长啸化为音波向$n攻去，竟然模拟出了箫音。\n" NOR;
  if ((myexp + skill) / 2 + random(myexp + skill) / 2 > (texp + tskill) / 2 + random(texp + tskill) / 2)
)
{
  msg += HIB "结果$n被箫音震荡的耳膜破裂，头痛难忍，差点摔倒在地。\n" NOR;
  message_vision(msg, me, target);
  target->start_busy(4 + i);
} else {
  msg += HIB "谁知$n也同样发出一声长啸，两道音波在空中猛的撞在一起，看来谁都奈何不了谁。\n" NOR;
  message_vision(msg, me, target);
}
mybusy += random(2);
}
if (!me->query_temp("wzg_bagua")) {
  message_vision(HIG " $N脚下一个不稳，“啪嗒”一声摔了个狗吃屎！\n" NOR, me);
} else {
  message_vision(HIG " $N行功完毕，脚步缓慢了下来，脚下八卦图渐渐隐去！\n" NOR, me);
  ne->start_busy(mybusy);
}
return 1;
}
