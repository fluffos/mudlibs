// japanese.c 圣斗士

inherit NPC;
object killertemp,killer_ob;

void create()
{
        NPC_D->generate_jp_name(this_object());
	set("long", "圣斗士。\n");
	set("gender", "男性");
	set("age", 30);
	set("str", 30);
	set("int", 30);
	set("con", 30);
	set("kar", 30);

        // the follow 5 setting has no use
	set("max_kee", 100);
	set("max_sen", 100);
	set("force", 100);
	set("max_force", 100);
	set("force_factor", 100);
	set("mana", 100);
	set("max_mana", 100);
	set("mana_factor", 100);
	set("combat_exp", 3000000);
	set("daoxing", 3000000);
        set("scale", 135);

	set_skill("force", 1);
        set_skill("wuxiangforce", 1);
	set_skill("dodge", 1);
	set_skill("balei", 1);
        set_skill("boxing", 1);
	set_skill("parry", 1);
        set_skill("westsword", 1);
        set_skill("sword", 1);
        set_skill("unarmed", 1);
        map_skill("sword", "westsword");
        map_skill("parry", "westsword");
        map_skill("unarmed", "boxing");
        map_skill("dodge", "balei");

        set("rank_info/rude", "斗士");

        set("chat_chance_combat", 120);
        set("chat_msg_combat", ({
                (: exert_function, "powerup" :),
                (: exert_function, "recover" :),
        }));

	setup();

       carry_object("/d/npc/obj/armor")->wear();
        carry_object("/d/obj/weapon/sword/qinghong")->wield();
}

string challenge()
{
        set("opinion/msg", ({
        	(random(2) ? "据说雅典圣城被黑暗势力控制，看来不假。"
                           : "雅典圣城素来与我创世和睦，由此看来雅典圣城已非往日。"),
                (random(2) ? "此人来自雅典圣城，据说那里守护雅典娜的圣斗士武功极高。"
                           : "雅典圣城远在四海之外，那里的斗士擅长西洋剑术。"),
                (random(2) ? "是啊，西洋剑术也是诡秘得很。"
                           : "没错，不过西洋剑造型奇特，配合圣城秘传心法还是颇有威力。"),
//                (random(2) ? "不过，据说西方盛行拳击之术，料想此人也得此秘传。"
//                           : "据传，西洋流行一种格斗扑击之术名曰：拳击，似乎颇有威力。"),
//                (random(2) ? "哼！此人气焰如此嚣张，实为习武者大忌！"
//                           : "此人可谓鼠目寸光，须知武道无穷，一丝也马虎不得！"),
        }));

        command(random(2) ? "haha" : "heng");
        switch (random(3))
        {
        case 0:
                return "我！黄金圣斗士" + name() + "，来向你们创世"
                        "武人挑战！谁敢出来迎战？";

        case 1:
                return "我就是雅典圣城的白银圣斗士" + name() + "，你们创世"
                        "有没有人是我的对手？";

        default:
                return "我神斗士" + name() + "代表雅典圣城来向你们挑战"
                        "，有种的就给我滚出来！";
        }
}

void unconcious()
{
 killer_ob=this_object()->query_temp("last_damage_from");
  command("chat 雅典娜！赐予我力量！");
 ::unconcious();
}

void die()
{
if(killertemp==killer_ob)
{
tell_object(killer_ob,"这次战斗，你得到前所未有的提高，你得到了8000点潜能!\n");
killer_ob->add("potential",8000);
}
::die();
}


void competition_with(object ob)
{
 	object me=this_object();
	int max_skill=3;
int i;
	int *level;
       mapping skill_status;
mapping hp_status;
       if((skill_status = ob->query_skills()))
       level=values(skill_status);
       for(i=0; i<sizeof(skill_status); i++) {
       if(level[i]>max_skill)max_skill=level[i];
       }
     	set_skill("force", max_skill);
       set_skill("wuxiangforce", max_skill);
	set_skill("dodge", max_skill);
       set_skill("balei", max_skill);
	set_skill("parry", max_skill);
       set_skill("westsword", max_skill);
       set_skill("sword", max_skill);
       set_skill("unarmed", max_skill);
       set_skill("boxing", max_skill);
       me->map_skill("sword","westsword");
       me->map_skill("dodge","balei");
       me->map_skill("parry","westsword");
       map_skill("unarmed", "boxing");

   hp_status = ob->query_entire_dbase();
   me->set("marks", hp_status["marks"]);
   me->set("combat_exp", hp_status["combat_exp"]*9/8);
   me->set("daoxing", 50000000);
   me->set("max_kee",    hp_status["max_kee"]);
   me->set("eff_kee",    hp_status["eff_kee"]);
   me->set("kee",        hp_status["eff_kee"]);
   me->set("max_sen",  hp_status["max_sen"]);
   me->set("eff_sen",  hp_status["eff_sen"]);
   me->set("sen",      hp_status["eff_sen"]);
   me->set("max_force", hp_status["max_force"] * 3/2);
   me->set("force",     hp_status["max_force"] * 5/2);
   me->set("force_factor",     hp_status["force_factor"]);
   me->set("max_mana", hp_status["max_mana"] * 10);
   me->set("mana",     hp_status["max_mana"] * 20);
   me->set("mana_factor",     hp_status["mana_factor"]);
   killertemp=ob;
        command("say 小宇宙！爆发吧！\n");
        kill_ob(ob);
}


