//贯日剑 xueer 8/4/99

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
        string msg;
        int damage, ap, dp;

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展「贯日剑」？\n");

if (!PFM_D->valid_family(me, "天魔宫"))
return notify_fail("你不是天魔宫弟子，怎么能使用天魔宫绝技？\n");
            if((string)me->query_skill_mapped("force")!="tianmo-force")
                         return notify_fail("不会天魔神功的人用不了贯日剑。\n");

        if((int)me->query("force") < 65+(int)me->query("force_factor") )
                return notify_fail("你的内力不足！\n");

            if(me->query("max_force") < 1000 || me->query("force")<500)
                         return notify_fail("内力不足，无法发挥贯日剑的威力。\n");

        if((int)me->query("kee") < 100 )
                return notify_fail("你身体太虚弱了，无法施展「贯日剑」！\n");

        if((int)me->query_skill("bingmo-sword", 1) <120)
        return notify_fail("你的冰魔剑练得不够纯熟，无法使出这招「贯日剑」！\n");

         if((int)me->query_skill("tianmo-force", 1) <100)
        return notify_fail("你对天魔神功领悟尚浅，不能使出「贯日剑」！\n");

        me->add("force", -65-(int)me->query("force_factor"));
        me->receive_damage("kee", 100);

   msg = HIC
"\n$N默运神功，身形忽向斜后飞出，$n正要追击，却不料$N手中长剑突发剑气，\n"
"如长虹一般直贯$n胸前，仓皇间$n已不知如何是好\n" NOR;

        ap = me->query_skill("bingmo-sword", 1);
        ap = ( ap * ap * ap / (4 * 400) );
        ap = ap*250 + (int)me->query("combat_exp");
        dp = target->query_skill("dodge");
   dp = ( dp * dp * dp / (4 * 300) );
   dp = dp*250 + target->query("combat_exp");
        if( random((ap + dp)/1000+1) <  dp/1000 ) {
     msg += HIC "$n身体微微一侧，总算是躲过了这必杀的一剑！\n\n"NOR;
           message_vision(msg, me, target);
   } else {
                damage = (int)me->query_skill("bingpo-blade",1) / 10 +
        (int)me->query("sen") / 300 + random((int)me->query("sen") / 200 ) +
        (int)me->query("kee") / 300 + random((int)me->query("kee") / 200 );
     msg += HIC "剑气从$n的胸口直贯而过，$n的胸口顿时血流如注！\n" NOR;
     damage +=random(10);
                        target->receive_damage("sen", me->query("eff_sen")*damage/100, me);
                        target->receive_damage("kee", me->query("eff_kee")*damage/100, me);
                        me->improve_skill("huomo-dao", 1, 1);
           message_vision(msg, me, target);
                COMBAT_D->report_status(target);
    }

        if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
        }
        me->start_busy(2);
        return 1;
}
