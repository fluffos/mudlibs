//波月斩 xueer 8/4/99

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  string msg;
  int damage, ap, dp;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展「波月斩」？\n");

  if (me->query("family/family_name") != "天魔宫")
    return notify_fail("你不是天魔宫弟子，怎么能使用天魔宫绝技？\n");
  if ((string)me->query_skill_mapped("force") != "tianmo-force")
    return notify_fail("不会天魔神功的人用不了波月斩。\n");

  if ((int)me->query("force") < 65 + (int)me->query("force_factor"))
    return notify_fail("你的内力不足！\n");

  if (me->query("max_force") < 1000 || me->query("force") < 500)
    return notify_fail("内力不足，无法发挥波月斩的威力。\n");

  if ((int)me->query("kee") < 100)
    return notify_fail("你身体太虚弱了，无法施展「波月斩」！\n");

  if ((int)me->query_skill("huomo-dao", 1) < 100)
    return notify_fail("你的火魔刀练得不够纯熟，无法使出这招「波月斩」！\n");

  if ((int)me->query_skill("tianmo-force", 1) < 100)
    return notify_fail("你对天魔神功领悟尚浅，不能使出「波月斩」！\n");

  me->add("force", -65 - (int)me->query("force_factor"));
  me->receive_damage("kee", 100);

  msg = HIC
    "\n$N默运神功，忽然后跃丈余，手中宝刀一挥，一道如月刀光直劈向$n，\n";
  "$n只觉刀光如电，竟不知如何躲避了！\n" NOR;
  ap = me->query_skill("huomo-dao", 1);
  ap = (ap * ap * ap / (4 * 400));
  ap = ap * 250 + (int)me->query("combat_exp");
  dp = target->query_skill("parry");
  dp = (dp * dp * dp / (4 * 400));
  dp = dp * 250 + target->query("combat_exp");
  if (random((ap + dp) / 1000 + 1) < dp / 1000) {
    msg += HIC "$n下身不动，上身向后一仰，在间不容发间居然躲过了那致命刀光！\n\n" NOR;
    message_vision(msg, me, target);
  } else {
    damage = (int)me->query_skill(
      "huomo-dao",
      1
    ) / 10 + (int)me->query("sen") / 300 + random((int)me->query("sen") / 200) + (int)me->query("kee") / 300 + random((int)me->query("kee") / 200);
    msg += HIC "刀光从$n的胸前呼啸而过，$n的胸口顿时血流如注！\n" NOR;
    damage += random(10);
    target->receive_damage("sen", me->query("eff_sen") * damage / 100, me);
    target->receive_damage("kee", me->query("eff_kee") * damage / 100, me);
    me->improve_skill("bingpo-blade", 1, 1);
    message_vision(msg, me, target);
    COMBAT_D->report_status(target);
  }

  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
  }
  me->start_busy(2);
  return 1;
}
