inherit NPC;
#include <ansi.h>
void create()
{
 
        set_name("张天师", ({ "zhang tianshi", "zhang", "tianshi" }) );
        set("gender", "男性" );
 set("long", "张天师乃是道家始祖。你可以向他打听关于搭救(dajiu)/保护(baohu)/放弃(cancel)的事情。\n");
        set("age",40);
        set("title", HIC"除魔卫道"NOR);
        set("str", 40);
        set("int", 30);
        set("con", 30);
        set("spi", 30);
        set("per", 30);
        set("class", "xian");
        set("attitude", "heroism");
        set("combat_exp", 1500000);
        set("daoxing", 2000000);
        set("max_kee", 2000);
        set("max_sen", 2000);
        set("force",5000);
    set("max_force",3000);
        set("force_factor", 150);
        set("mana", 5000);
        set("max_mana", 3000);
        set("mana_factor", 150);

        set("eff_dx", 600000);
        set("nkgain", 600);

        set_skill("unarmed",170);
        set_skill("dodge",170);
        set_skill("parry",170);
        set_skill("sword", 180);
        set_skill("force", 170);
        set_skill("spells", 170);
        set_skill("changquan", 170);
        set_skill("liangyi-sword", 180);
        set_skill("baguazhou", 170);
        set_skill("moshenbu", 170);
        set_skill("lengquan-force", 170);
        map_skill("unarmed", "changquan");
        map_skill("force", "lengquan-force");
        map_skill("spells", "baguazhou");
  map_skill("sword", "liangyi-sword");
        map_skill("parry", "liangyi-sword");
        map_skill("dodge", "moshenbu");
        
        set("chat_chance",1);
        set("chat_msg", ({
                    name()+"说道：哎。。近期下界妖怪淫乱，哪位大仙可愿去搭救花仙？\n",
                    }));

        seteuid(getuid());

        

        setup();
        carry_object("/d/obj/armor/jinjia")->wear();
        carry_object("/d/sky/obj/zhanyaojian")->wield();
}
void init ()
{
  add_action("do_task", "baohu");
  add_action("do_task", "dajiu");
  add_action("do_cancel", "cancel");
}
int do_task()
{
        object me = this_player();
        object guai,xie;
        int level,i;
        int tt;
        string where,msg;
/*
    if( me->query("combat_exp")< 2000000)
        {
tell_object(me,"你的修为不够，练好了再来！\n");
     return 1;
       }
*/
        if( (tt=(int)me->query("dajiu/job_start")) &&
                me->query("dajiu/done")) {
 // job done
            if(tt<=time() &&
                    time()<tt+150) {
                message_vision("$N拿起玄天宝镜一看，花仙已搭救,你还是等等再来。\n",
                        this_object(), me);
                return 1;
            }
           
        }
       
        me->command("say 最近可有妖怪为害花仙？");
        
        
        if( me->query("dajiu/fail") )
             { if(tt<=time() &&
                    time()<tt+600) {
                
                message_vision(CYN"\n张天师说道：你任务失败了，等等再来把。\n"NOR,me);
                return 1;
            }
             
            me->delete("dajiu/fail");  
             }
        
        
        if( me->query("dajiu/get") )
             {message_vision(CYN"\n张天师说道：花仙等着搭救呢，快快起程。\n"NOR,me);
              return 1;
             }
       
     //确定任务等级
        level = random(10);
        if (level<5) level=1;
        else if (level<8) level=2;
        else level=3;
        
        me->set("dajiu/get",1);
        me->set("dajiu/level",level);
        me->delete("dajiu/done");
        guai = new("/quest/dajiu/xian/bhnpc");
        guai->set("dajiu/npcstart",time());
        where=guai->invocation(me, level);
        message_vision(CYN"\n张天师说道：现在有"+where+"附近被妖怪掳去，
已经快不行了，你去搭救她吧。\n"NOR,me); 
         
          
this_object()->command("job "+me->name()+"接到一个搭救"+guai->name()+"的任务。");
        me->set("dajiu/guai",guai);
        me->delete("dajiu/job_start");
        me->delete("dajiu/kk");
        me->set("dajiu/where",where);
        me->set("dajiu/start_time",time());
        me->set("dajiu/job_start",time());
     
        me->set("dajiu/id",guai->query("id"));

        me->set("dajiu/name",guai->query("name"));
        me->set_temp("dajiu/ob",guai);
        xie=new("/quest/dajiu/obj/sjxie.lpc");
        xie->move(me);
        
        message_vision("$N变出一双水晶鞋。\n $N给$n一双水晶鞋。\n",this_object(),this_player());

        msg = me->name()+"接到一个搭救"+guai->name()+"的任务。";
        MONITOR_D->report_system_msg (msg);
        return 1;
}        

int do_cancel()
{
        object me = this_player();
        object guai;
        int tt;
          if (!me->query("dajiu/get"))
             {tell_object(me,"你没有任务在身。\n"); return 1;}
        if ( (tt=(int)me->query("dajiu/job_start"))){
   if(tt<=time() &&
                    time()<tt+600) {
                message_vision("$N说道：时辰未到，不可放弃。\n",
                        this_object(), me);
                return 1;
            }
        else{
      
        me->delete_temp("dajiu");
            
        me->command("say 这个任务弟子恐怕无能为力搭救。");
        message_vision(CYN"\n张天师说道：好吧，那我另派神仙搭救吧。\n"NOR,me);
        me->delete("dajiu/fail",1);
        me->delete("dajiu/get");
        me->delete("dajiu/job_start");
        
        guai=me->query_temp("dajiu/ob");
        me->delete("dajiu");
        
        if (objectp(guai) && living(guai))   {
        destruct(guai);  
          
        }
   me->delete("dajiu/name");
        me->delete_temp("dajiu");
        return 1;
        }
        }
}       
