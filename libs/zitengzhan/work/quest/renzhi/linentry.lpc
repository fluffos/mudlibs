// Room: /quest/renzhi/linentry.c
inherit ROOM;
void create() {
  set("short", "小路");
  set("long", @long
小路越来越窄，往北好象是一片迷宫似的树林，远远看去白雾茫茫。在路旁的山腰
有一块牌子，上面绘着迷宫树林的地图(map)。但是起雾时根本就看不清楚。
long);
  set("outdoors", "xiakedao");
  set("exits", ([
    "southwest": "/d/shulin/lin8",
    "north": "/quest/renzhi/lin/entry",
  ]));

  setup();
}
void init() {
  add_action("more_map", "look");
}
/*
