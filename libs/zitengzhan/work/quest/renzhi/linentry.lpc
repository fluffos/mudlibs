{
	if (arg != "map") return 0;
	return __DIR__"lin.lpc"->more_vrm_map()	;
	return 1;
}
*/

int more_map(string arg) {
  object ob, who = this_player();
  if (arg != "map") return 0;
  if (!objectp(ob = load_object(__DIR__ "lin/entry")))
    return notify_fail("暂时没有迷宫地图。\n");
  if (arg = ob->query("map"))
    write("\n" + ob->query("map") + "\n");
  else write("\n你先去迷宫探探路再来看吧。\n");
  return 1;

}
