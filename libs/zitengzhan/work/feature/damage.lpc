// damage.c

#include <ansi.h>
#include <dbase.h>
#include <login.h>
#include <move.h>
void remove_faint(object me);

int ghost = 0;

int is_ghost() { return ghost; }

int self_purge() {
  object me = this_object();

  if (!userp(me)) return 0;
  if (
    // Removed since we don't use this part. Dream 12/11/97.
    // Re-removed again on the same day :-)
    (int)me->query("max_gin") > 0 &&
    (int)me->query("max_kee") > 0 &&
    (int)me->query("max_sen") > 0) return 0;
  set_heart_beat(0);
  ghost = 1;
  me->move("/d/death/block.lpc");
  CHANNEL_D->do_channel(me, "rumor", me->query("name")
    + "因为年纪太大，心力交瘁，不幸与世长辞，永远离开了我们！");
  return 1;
}

void gameover() {
  object me = this_object();

  //currently, only move the player to /d/death/block.c
  if (!userp(me)) return;


  me->move("/d/death/block.lpc");
  if (!me->query("life/death_announced")) {
    me->set("life/death_announced", 1);
    CHANNEL_D->do_channel(load_object(COMBAT_D), "rumor", me->query("name")
      + "寿终正寝，永远地离开了我们。");
  }
}


int check_gameover() {  //weiqi, 981231
  object me = this_object();

  if (wizardp(me)) return 0;
  if (!userp(me)) return 0;

  if ((me->query("age") <= me->query("life/life_time")) || me->query("life/live_forever")) return 0;

  //now gameover le
  gameover();
  return 1;
}

void announce_live_forever(string reason) {
  object me = this_object();
  object dadi;

  if (!reason) return;

  if (me->query("life/live_forever_announced")) return;

  me->set("life/live_forever_announced", 1);
  me->set("life/live_forever", 1);

  dadi = new("/d/wiz/npc/dadi.lpc");
  dadi->move(environment(me));

  message_vision(HIY "只听一阵仙乐缥缈，一驾五彩云车从天缓缓而降。\n" NOR, dadi);
  message_vision(HIY "$N从车上立起身来对$n一拱手：恭喜！恭喜！\n" NOR, dadi, me);
  dadi->command_function("chat " + reason);
  message_vision(HIY "$N一挥手，云车渐渐淡去...\n" NOR, dadi);
  destruct(dadi);

  return;
}

varargs int receive_damage(string type, int damage, object who) {
  object me = this_object();
  int val, j, i;
  int tlevel;
  int level;
  object ob;
  tlevel = 0;
  level = 0;
  j = 0;
  if (objectp(who))
    tlevel = (int)who->query("dujie/level");  //敌人的度劫次数 
    level = query("dujie/level");

  if (objectp(who)) {
    if (!userp(who) && damage > 2 && (int)query("combat_exp") < 10000000) damage = damage / 2;
    if (who->query("xinmai"))
      j = who->query("xinmai");
    else j = 0;
  }
  if (!query("mingmai")) i = 0;
  else i = query("mingmai");
  if (damage <= 0) damage = 0;
  if (damage < 0) error("F_DAMAGE: 伤害值为负值。\n");


  if (type != "gin" && type != "kee" && type != "sen")
    error("F_DAMAGE: 伤害种类错误( 只能是 gin, kee, sen 其中之一 )。\n");
  /*
//added by mudbug to test pfm BUG on 2003/4/20
        if( damage > 2000 ) {
  if(who)
log_file("static/Too_big_damage",sprintf("[%s]  %s(%s) make a damage of %d %s on %s\n",query_ip_number(who),who->query("name"),who->query("id"),damage,type,ctime(time())));
       }
//     error("F_DAMAGE: 伤害值超过最大值1000。\n");}
*/

  if (objectp(who)) {
    if (objectp(who->query_temp("invoker")))
      who = who->query_temp("invoker");
    set_temp("last_damage_from", who);

    /* //added by mudbug on 2003/2/25

       ob=find_living("fo wukong");

         if(living(who)&&ob){
       if(!who->query("family/family_name")&&ob->query("menpai/"+ob->convert_en(query("family/family_name"))))
         damage=damage*ob->query("menpai/"+ob->convert_en(query("family/family_name")))/100;

         else if(who->query("family/family_name")&&ob->query("menpai/"+ob->convert_en(who->query("family/family_name"))))
       damage=damage*ob->query("menpai/"+ob->convert_en(who->query("family/family_name")))/100;
     else damage=damage;

             }
          */
  }


  if (!damage) damage = 1;
  damage = damage + damage * j / 100;
  damage = damage - damage * i / 200;
  damage = damage + damage * tlevel / 10 - damage * level / 20;  //每劫增加10%伤害和5%抵抗

  if (who && me && damage > 0 && me->query_temp("lsnh"))  //for龙神怒火
  {
    me->add_temp("lsnh/damage", 1);
    message_vision(HIM "$N低吼了一声！死盯着$n" HIM "的眼神似乎更加凶厉了！！\n" NOR, me, who);
  }
  if (who && me && damage > 0 && me->query_temp("hualong"))  //for化龙
  {
    damage = 0;
    message_vision(HIM "$N身上的龙鳞华光一闪！抵挡住了$n" HIM "的攻击！！\n" NOR, me, who);
    me->add_temp("hualong", -1);
    if (me->query_temp("hualong") < 1) {
      message_vision(HIW "$N化身的苍龙鳞甲碎裂，掉落在地翻腾悲鸣！$N" HIW "被$n" HIW "打回了原形！！\n" NOR, me, who);
      me->delete_temp("hualong");
      me->set_temp("hualong_end", time());
    }
  }

  //add by snowtu 普遍降低伤害输出
  damage = damage / 3 * 2;
  if (damage <= 0) damage = 0;
  val = (int)query(type) - damage;

  if (val >= 0) set(type, val);
  else {
    set(type, -1);
    // 
    //added by mon for pk and nk.
    if (living(this_object()) && objectp(who) && userp(who)
      && !query_temp("last_fainted_from")
      //must not be fainted before within 60 sec.
    ) {
      set_temp("last_fainted_from", who->query("id"));
      if (userp(this_object()))
        call_out("remove_faint", 60, this_player());
      //prevent help other to faint a npc or player
      //and to get daoxing.
      //has to wait 60 second after the faint.
      //for NPC, the last_fainted_from mark will not
      //be erased, so only the first one who faint a npc
      //can possibly get dx. One can't help others to
      //faint a npc.
    }
  }

  set_heart_beat(1);

  return damage;
}

void remove_faint(object me) {
  if (me) me->delete_temp("last_fainted_from");
}

varargs int receive_wound(string type, int damage, object who) {
  object me = this_object();
  int val, j, i;
  int tlevel;
  int level;
  object ob;
  tlevel = 0;
  level = 0;
  j = 0;
  if (objectp(who))
    tlevel = (int)who->query("dujie/level");  //敌人的度劫次数 
    level = query("dujie/level");

  if (objectp(who)) {
    if (!userp(who) && damage > 2 && (int)query("combat_exp") < 10000000) damage = damage / 2;
    if (who->query("xinmai"))
      j = (int)who->query("xinmai");
    else j = 0;
  }
  if (!query("mingmai")) i = 0;
  else i = query("mingmai");
  if (damage <= 0) damage = 0;
  if (damage < 0) error("F_DAMAGE: 伤害值为负值。\n");
  if (type != "gin" && type != "kee" && type != "sen")
    error("F_DAMAGE: 伤害种类错误( 只能是 gin, kee, sen 其中之一 )。\n");
  /*
//added by mudbug to test pfm wound BUG on 2003/4/20
        if( damage > 2000 ) {
  if(who)
log_file("static/Too_big_wound",sprintf("[%s]  %s(%s) make a wound of %d %s on %s\n",query_ip_number(who),who->query("name"),who->query("id"),damage,type,ctime(time())));
   }
//      error("F_DAMAGE: 伤害值超过最大值1000。\n");}
*/

  if (objectp(who)) {
    if (objectp(who->query_temp("invoker")))
      who = who->query_temp("invoker");
    set_temp("last_damage_from", who);
  }

  if (!damage) damage = 1;
  damage = damage + damage * j / 100;
  damage = damage - damage * i / 200;
  damage = damage + damage * tlevel / 10 - damage * level / 20;  //每劫增加10%伤害和5%抵抗

  //add by snowtu 普遍降低伤害输出
  damage = damage / 3 * 2;
  if (damage <= 0) damage = 0;
  if (who && me && damage > 0 && me->query_temp("hualong")) damage = 0;  //for化龙



  val = (int)query("eff_" + type) - damage;

  if (val >= 0) set("eff_" + type, val);
  else {
    set("eff_" + type, -1);
    val = -1;

    //added by mon for pk and nk.
    if (living(this_object()) && objectp(who) && userp(who)
      && !query_temp("last_fainted_from")
      //must not be fainted before within 60 sec.
    ) {
      set_temp("last_fainted_from", who->query("id"));
      if (userp(this_object()))
        call_out("remove_faint", 60, this_player());
      //prevent help other to faint a npc or player
      //and to get daoxing.
      //has to wait 60 second after the faint.
      //for NPC, the last_fainted_from mark will not
      //be erased, so only the first one who faint a npc
      //can possibly get dx. One can't help others to
      //faint a npc.
    }
  }

  if ((int)query(type) > val) set(type, val);

  set_heart_beat(1);

  return damage;
}

int receive_heal(string type, int heal) {
  int val;

  if (heal < 0) error("F_DAMAGE: 恢复值为负值。\n");
  if (type != "gin" && type != "kee" && type != "sen")
    error("F_DAMAGE: 恢复种类错误( 只能是 gin, kee, sen 其中之一 )。\n");

  val = (int)query(type) + heal;

  if (val > (int)query("eff_" + type)) set(type, (int)query("eff_" + type));
  else set(type, val);

  return heal;
}

int receive_curing(string type, int heal) {
  int max, val;

  if (heal < 0) error("F_DAMAGE: 恢复值为负值。\n");
  if (type != "gin" && type != "kee" && type != "sen")
    error("F_DAMAGE: 恢复种类错误( 只能是 gin, kee, sen 其中之一 )。\n");

  val = (int)query("eff_" + type);
  max = (int)query("max_" + type);

  if (val + heal > max) {
    set("eff_" + type, max);
    return max - val;
  } else {
    set("eff_" + type, val + heal);
    return heal;
  }
}

// snowcat feb 8 1998 
void remove_ride() {
  object rider, ridee;

  if (ridee = query_temp("ridee"))
    ridee->delete_temp("rider");
  delete_temp("ridee");
  add_temp("apply/dodge", -query_temp("ride/dodge"));
  set_temp("ride/dodge", 0);
  add_temp("apply/parry", -query_temp("ride/parry"));
  set_temp("ride/parry", 0);
  add_temp("apply/spells", -query_temp("ride/spells"));
  set_temp("ride/spells", 0);
  add_temp("apply/armor", -query_temp("ride/armor"));
  set_temp("ride/armor", 0);
  add_temp("apply/damage", -query_temp("ride/damage"));
  set_temp("ride/damage", 0);
  add_temp("apply/armor_vs_force", -query_temp("ride/armor_vs_force"));
  set_temp("ride/armor_vs_force", 0);
  add_temp("apply/armor_vs_spells", -query_temp("ride/armor_vs_spells"));
  set_temp("ride/armor_vs_spells", 0);
  add_temp("mingzhong", -query_temp("ride/mingzhong"));
  set_temp("ride/mingzhong", 0);
  if (rider = query_temp("rider"))
    rider->remove_ride();
  delete_temp("rider");
}

void unconcious() {
  object defeater;

  if (environment() && environment()->query("alternative_die")) {
    environment()->alternative_die(this_object());
    return;
  }

  if (!living(this_object())) return;
  if (wizardp(this_object()) && query("env/immortal")) return;
  if (this_object()->query_temp("pkgame")) {
    this_object()->remove_all_enemy();
    this_object()->die();
    return;
  }

  if (objectp(defeater = query_temp("last_damage_from")))
    COMBAT_D->winner_reward(defeater, this_object());

  this_object()->remove_all_enemy();
  remove_ride();

  message("system", HIR "\n你的眼前一黑，接着什么也不知道了．．．\n\n" NOR,
    this_object());
  this_object()->disable_player(" <昏迷不醒>");
  set("gin", 0);
  set("kee", 0);
  set("sen", 0);
  set_temp("block_msg/all", 1);
  set_temp("block_input", 1);
  COMBAT_D->announce(this_object(), "unconcious");
  this_object()->set("unconcious", 1);
  if (!query_temp("lingfu")) {
    call_out("revive", random(100 - query("con")) + 30);
  }
}

varargs void revive(int quiet) {
  remove_call_out("revive");

  //	delete_temp("last_fainted_from");
  // revive will not remove this mark.

  delete_temp("no_move");
  //sometimes players still set no_move after death
  //and can't be cleared.
  if (this_object()->is_busy()) this_object()->start_busy(1);
  //clear the busy flag.

  while (environment()->is_character())
    this_object()->move(environment(environment()));
  this_object()->enable_player();
  if (!quiet) {
    COMBAT_D->announce(this_object(), "revive");
    set_temp("block_msg/all", 0);
    this_object()->delete("unconcious");
    message("system", HIY "\n慢慢地你终于又有了知觉．．．\n\n" NOR,
      this_object());
  } else
    set_temp("block_msg/all", 0);
}

void die() {
  object corpse, killer, me, owner, guai, guai1, guai2, guai3, guai4;
  object *inv, *inv_changed, changed, ps;
  int i, k, exp, dao, mlevel, nlevel, j, pexp, p;
  string last_fainted_from, str, killername, myname;
  me = this_object();
  if (query_temp("last_fainted_from"))
    last_fainted_from = query_temp("last_fainted_from");
  if (last_fainted_from)
    set_temp("last_fainted_from", last_fainted_from);
  if (me) killer = me->query_temp("last_damage_from");
  if (killer && killer->query("moon_pet"))  //宠物战斗经验
  {
    j = killer->query("levelup");
    mlevel = killer->query("max_petlevel");
    nlevel = killer->query("now_petlevel");
    pexp = killer->query("combat_exp");
    owner = killer->query("owner");
    exp = me->query("combat_exp") / 200;
    if (exp < 1) exp = 1;
    if (exp > 1000000000) exp = 1000000000;
    dao = me->query("daoxing") / 200;
    if (dao > 1000000000) dao = 1000000000;
    if (dao < 1) dao = 1;
    killer->add("combat_exp", exp);
    killer->add("daoxing", dao);
    message_vision(
      HIM "$N" HIM "通过这次战斗增加了" + exp + "点武学经验和" + COMBAT_D->chinese_daoxing(dao) + "道行！\n" NOR,
      killer
    );
    pexp = killer->query("combat_exp");

    if (nlevel * nlevel * nlevel * 10000 + 10000 < pexp && nlevel < mlevel) {
      i = killer->query("str") * j / 100;
      if (i < 1) i = 1;
      killer->add("str", i);
      i = killer->query("con") * j / 100;
      if (i < 1) i = 1;
      killer->add("con", i);
      i = killer->query("int") * j / 100;
      if (i < 1) i = 1;
      killer->add("int", i);
      i = killer->query("cor") * j / 100;
      if (i < 1) i = 1;
      killer->add("cor", i);
      i = killer->query("spi") * j / 100;
      if (i < 1) i = 1;
      killer->add("spi", i);
      i = killer->query("cps") * j / 100;
      if (i < 1) i = 1;
      killer->add("cps", i);
      i = killer->query("per") * j / 100;
      if (i < 1) i = 1;
      killer->add("per", i);
      i = killer->query("kar") * j / 100;
      if (i < 1) i = 1;
      killer->add("kar", i);
      i = killer->query("max_kee") * j / 100;
      killer->add("max_kee", i);
      i = killer->query("max_sen") * j / 100;
      killer->add("max_sen", i);
      i = killer->query("max_kee");
      killer->set("eff_kee", i);
      killer->set("kee", i);
      i = killer->query("max_sen");
      killer->set("eff_sen", i);
      killer->set("sen", i);
      i = killer->query("apply/damage") * j / 100;
      if (i < 1) i = 1;
      killer->add("apply/damage", i);
      killer->add_temp("apply/damage", i);
      i = killer->query("apply/armor") * j / 100;
      if (i < 1) i = 1;
      killer->add("apply/armor", i);
      killer->add_temp("apply/armor", i);
      i = killer->query("apply/armor_vs_force") * j / 100;
      if (i < 1) i = 1;
      killer->add("apply/armor_vs_force", i);
      killer->add_temp("apply/armor_vs_force", i);
      i = killer->query("apply/armor_vs_spells") * j / 100;
      if (i < 1) i = 1;
      killer->add("apply/armor_vs_spells", i);
      killer->add_temp("apply/armor_vs_spells", i);
      i = killer->query("ride/dodge") * j / 100;
      if (i < 1) i = 1;
      killer->add("ride/dodge", i);
      i = killer->query("ride/parry") * j / 100;
      if (i < 1) i = 1;
      killer->add("ride/parry", i);
      i = killer->query("ride/spells") * j / 100;
      if (i < 1) i = 1;
      killer->add("ride/spells", i);
      i = killer->query("ride/armor") * j / 100;
      if (i < 1) i = 1;
      killer->add("ride/armor", i);
      i = killer->query("ride/damage") * j / 100;
      if (i < 1) i = 1;
      killer->add("ride/damage", i);
      i = killer->query("ride/armor_vs_force") * j / 100;
      if (i < 1) i = 1;
      killer->add("ride/armor_vs_force", i);
      i = killer->query("ride/armor_vs_spells") * j / 100;
      if (i < 1) i = 1;
      killer->add("ride/armor_vs_spells", i);
      i = random(j);
      killer->add("ride/mingzhong", random(i));
      killer->add("now_petlevel", 1);
      i = killer->query("now_petlevel");
      if (i < 2) killer->set("title", HIB "一级妖兽" NOR);
      else if (i < 3) killer->set("title", HIB "二级妖兽" NOR);
      else if (i < 4) killer->set("title", HIC "三级妖兽" NOR);
      else if (i < 5) killer->set("title", HIC "四级妖兽" NOR);
      else if (i < 6) killer->set("title", HIG "五级妖兽" NOR);
      else if (i < 7) killer->set("title", HIG "六级妖兽" NOR);
      else if (i < 8) killer->set("title", HIR "七级妖兽" NOR);
      else if (i < 9) killer->set("title", HIR "八级妖兽" NOR);
      else if (i < 10) killer->set("title", HIW "九级妖兽" NOR);
      else if (i < 13) killer->set("title", HIW "圣兽" NOR);
      else killer->set("title", HIY "神兽" NOR);
      message_vision(HIM "$N" HIM "的等级增加了！$N" HIM "的能力全面提升了！\n" NOR, killer);
      killer->save();
    }
  }


  if ((me->query_temp("pkgame")) && ("/cmds/usr/pkgame"->query_pk())) {
    me->set("eff_kee", me->query("max_kee"));
    me->set("eff_sen", me->query("max_sen"));
    me->set("kee", me->query("max_kee"));
    me->set("sen", me->query("max_sen"));
    me->set("force", me->query("max_force"));
    me->set("mana", me->query("max_mana"));
    killer = me->query_temp("last_damage_from");
    killer->delete("PKG");
    me->delete("PKG");
    (objectp(killer)) ? (me->set_temp("my_killer", killer->query("id"))) : (killer = me);
    COMBAT_D->killer_reward(killer, this_object());
    this_object()->clear_condition();
    remove_ride();
    this_object()->remove_all_killer();
    return;
  }

  if (environment() && environment()->query("alternative_die")) {
    environment()->alternative_die(this_object());
    return;
  }

  if (!living(this_object())) revive(1);
  if (wizardp(this_object()) && query("env/immortal")) return;

  //needed because last_fainted_from is cleared in revive()

  if (me->query_temp("mpwar_chance"))  //huarong 2003.11
  {
    int kill_bonus, myexp, killerexp;
    myname = me->query("name") + "(" + me->query("id") + ")";
    killer = me->query_temp("last_damage_from");
    killername = killer->query("name") + "(" + killer->query("id") + ")";
    if (killer) {
      myexp = me->query("combat_exp");
      killerexp = killer->query("combat_exp");
      killerexp = killerexp / 1000;
      kill_bonus = myexp / killerexp;
      if (kill_bonus > 10000) kill_bonus = 10000;
      killer->add_temp("mpwar/kill_bonus", kill_bonus);

      switch (random(4)) {
        case 0: {
          str = "刀光剑影之中，" + myname + "已被" + killername + "送去崔叔叔那里喝茶去了！\n" NOR;
          break;
        };

        case 1: {
          str = "" + myname + "惨嚎一声，已被" + killername + "斩于战场之上！\n" NOR;

          break;
        };

        case 2: {
          str = "" + killername + "神勇无比，已将" + myname + "秒杀于战场之上！\n" NOR;

          break;
        };

        case 3: {
          str = "" + killername + "所向披靡，将" + myname + "斩于死地！\n" NOR;

          break;
        };
      }

      message(
        "channel:chat",
        HIM "【" + HIC + "门派战争" + HIM + "】监场官(jianchang guan)：" + str + "\n" NOR,
        users()
      );
      COMBAT_D->announce(this_object(), "dead");
      me->set("eff_kee", me->query("max_kee"));
      me->set("eff_sen", me->query("max_sen"));
      me->set("kee", me->query("max_kee"));
      me->set("sen", me->query("max_sen"));
      me->set("force", me->query("max_force") + me->query("max_force") / 2);
      me->set("mana", me->query("max_mana") + me->query("max_mana") / 2);
      me->add_temp("mpwar/chance", -1);
      me->delete_temp("no_fight_time");
      me->remove_all_killer();
      me->clear_condition();
      me->move("/d/city/jingxin.lpc");
      return;
    }
  }


  /*
	// destroy all self-made fabao here
	
	inv = all_inventory(this_object());
	for(i=0; i<sizeof(inv); i++)   {
		if( inv[i]->query("owner_id") == getuid(this_object()) )   {
			tell_object(this_object(), HIB+"你看到" + inv[i]->query("name") +
			HIB + "破空而去，慢慢消失在天际．．．\n"+NOR);
			destruct( inv[i] );
		}
	}
*/

  //加入由于善恶值(PKSS)值影响掉特殊装备 by www 2003 11 
  inv = all_inventory(this_object());
  inv_changed = filter_array(inv, "filter_items", this_object());
  if (sizeof(inv_changed)) {
    i = this_object()->query("PKSS");  //i为善恶值
    k = 0;
    do {
      if (i > random(1000) && changed = inv_changed[random(sizeof(inv_changed))]) {
        tell_object(this_object(), HIB + "你看到" + changed->query("name") +
          HIB + "破空而去，慢慢消失在天际．．．\n" + NOR);
        str = this_object()->name(1) + "由于平时作恶太多，身上的" + changed->query("name") + "掉了。\n";
        destruct(changed);
        COMBAT_D->announce(this_object(), "death_rumor", str);
        k++;
      }
      i -= 1000;
    } while (i > 0 && sizeof(inv_changed) > k);
  }

  COMBAT_D->announce(this_object(), "dead");

  if (me->query_temp("ljs_begin")) {
    me->set("eff_kee", me->query("max_kee"));
    me->set("eff_sen", me->query("max_sen"));
    me->set("kee", me->query("max_kee") / 3);
    me->set("sen", me->query("max_sen") / 3);
    if (me->query("force", 1) < 0) me->set("force", 1);
    me->set_temp("ljs_die", time());
    remove_ride();
    me->clear_condition();
    me->remove_all_killer();
    me->move("/u/xdao/ljs/1-0");
    message_vision(HIY "正当$N丧命之时，两界山顶射出一道佛光罩住了$N的魂魄，$N的魂魄滴溜一下归位了。浑浑噩噩中$N被带到了山脚，脱离了危险。\n" NOR, me);
    return;
  }

  if (me->query_temp("hgs_begin")) {
    killer = me->query_temp("last_damage_from");
    if (killer && killer->query("is_guard") == 1) killer = killer->query("possessed");
    if (userp(killer)) {
      if ((int)me->query("combat_exp") + (int)me->query("daoxing") >
        ((int)killer->query("combat_exp") + (int)killer->query("daoxing")) / 2 +
        random(((int)killer->query("combat_exp") + (int)killer->query("daoxing")) / 2)) {
        TEAMK_D->teamk(killer, 1000);
        p = random(3);
        if (p > 2) p = 2;
        switch (p) {
          case 0: ps = new("/d/npc/vr_room/obj/baoshi.lpc");
          if (objectp(ps)) ps->move(killer);
          tell_object(killer, HIB + "你杀敌有功！奖励" + HIR + "原石" + HIB + "一块。\n" + NOR); break;
          case 1: ps = new("/obj/money/gold.lpc");
          if (objectp(ps)) {
            ps->set_amount(5);
            ps->move(killer);
          }
          tell_object(killer, HIB + "你杀敌有功！奖励" + HIY + "黄金五两" + HIB + "。\n" + NOR); break;
          case 2: killer->add("combat_exp", 1000);
          killer->add("daoxing", 1000);
          killer->add("potential", 500);
          tell_object(
            killer,
            HIB + "你杀敌有功！奖励" + chinese_number(1000) + "点武学经验" + COMBAT_D->chinese_daoxing(1000) + "道行和" + chinese_number(500) + "点潜能。\n" + NOR
          ); break;
          default: ps = new("/d/npc/vr_room/obj/baoshi.lpc");
        }
      }
    }
    me->set("eff_kee", me->query("max_kee"));
    me->set("eff_sen", me->query("max_sen"));
    me->set("kee", me->query("max_kee") / 3);
    me->set("sen", me->query("max_sen") / 3);
    if (me->query("force", 1) < 0) me->set("force", 1);
    me->set_temp("hgs_die", time());
    remove_ride();
    me->clear_condition();
    me->remove_all_killer();
    if (me->query("family/family_name") == "方寸山三星洞"
      || me->query("family/family_name") == "南海普陀山"
      || me->query("family/family_name") == "五庄观")
      me->move("/u/xdao/hgs/eastroom");
    else me->move("/u/xdao/hgs/westroom");
    message_vision(HIY "天空传来声音：花果山内虽死无碍。\n" NOR, me);
    return;
  }

  if (me->query("rulaitask/get")) {
    guai = me->query("rulaitask/guai");
    if (guai == me->query_temp("last_damage_from") || guai == me->query_temp("last_opponent")) {
      me->set("eff_kee", me->query("max_kee"));
      me->set("eff_sen", me->query("max_sen"));
      me->set("kee", me->query("max_kee") / 3);
      me->set("sen", me->query("max_sen") / 3);
      if (me->query("force", 1) < 0) me->set("force", 1);
      me->add("combat_exp", -3000);
      me->add("daoxing", -3000);
      me->add("rulaitask_log/die", 1);
      me->delete("rulaitask/get");
      me->set("rulaitask/fail", 1);
      str = me->name() + "被" + guai->name() + "杀死了，幸好如来佛及时出手相救，才捡回一命。";
      message("channel:rumor", HIM "【长安夜话】某人：" + str + "\n" NOR, users());
      log_file("taskdeath", sprintf("[%s] %s is task killed by %s.\n",
        ctime(time()), this_object()->query("id"), guai->name()));
      remove_ride();
      me->clear_condition();
      me->move("/d/qujing/lingshan/daxiong");
      message_vision(HIY "如来佛一伸左手把$N的魂魄从地府里拉了回来，再一伸右手不知道从
哪里把$N的尸体抓了回来，接着两手一合，硬生生地把$N魂魄逼回身体。\n" NOR, me);
      me->unconcious();
      return;
    }
  }
  if (me->query("rulaitask/dget")) {
    guai = me->query("rulaitask/dguai");
    guai4 = me->query("rulaitask/dguai1");
    guai1 = me->query("rulaitask/guai");
    guai2 = me->query("rulaitask/guai1");
    guai3 = me->query("rulaitask/guai2");
    if (guai == me->query_temp("last_damage_from") || guai == me->query_temp("last_opponent")
      || guai1 == me->query_temp("last_damage_from") || guai1 == me->query_temp("last_opponent")
      || guai2 == me->query_temp("last_damage_from") || guai2 == me->query_temp("last_opponent")
      || guai3 == me->query_temp("last_damage_from") || guai3 == me->query_temp("last_opponent")
      || guai4 == me->query_temp("last_damage_from") || guai4 == me->query_temp("last_opponent"))

    {
      me->set("eff_kee", me->query("max_kee"));
      me->set("eff_sen", me->query("max_sen"));
      me->set("kee", me->query("max_kee") / 3);
      if (me->query("force", 1) < 0) me->set("force", 1);
      me->set("sen", me->query("max_sen") / 3);
      me->add("combat_exp", -6000);
      me->add("daoxing", -6000);
      me->add("rulaitask_log/die", 1);
      me->delete("rulaitask/dget");
      me->set("rulaitask/dfail", 1);
      str = me->name() + "被" + guai->name() + "杀死了，死状惨不忍睹，幸好如来佛及时出手相救，才捡回一条小命。";
      message("channel:rumor", HIM "【长安夜话】某人：" + str + "\n" NOR, users());
      log_file("taskdeath", sprintf("[%s] %s is task killed by %s.\n",
        ctime(time()), this_object()->query("id"), guai->name()));
      remove_ride();
      me->clear_condition();
      me->move("/d/qujing/lingshan/daxiong");
      message_vision(HIY "如来佛一伸左手把$N的魂魄从地府里拉了回来，再一伸右手不知道从
哪里把$N的尸体抓了回来，接着两手一合，硬生生地把$N魂魄逼回身体。\n" NOR, me);
      me->unconcious();
      return;
    }
  }




  if ((int)this_object()->query("max_gin") > 0 &&
    (int)this_object()->query("max_kee") > 0 &&
    (int)this_object()->query("max_sen") > 0) {
    //no damage to self_purged people.

    if (objectp(killer = query_temp("last_damage_from"))) {
      set_temp("my_killer", killer->query("id"));
      COMBAT_D->killer_reward(killer, this_object());
      "/adm/daemons/familyd"->deal_family_relation(this_object(), killer);
      // Clear all the conditions by death.
      this_object()->clear_condition();

      if (userp(this_object()))
        log_file("death", sprintf("[%s] %s is killed by %s.\n",
          ctime(time()), this_object()->query("id"),
          killer->query("id")));
    } else if (userp(this_object())) {
      //no obvious killer. by mon 8/17/97
      //for example, by poison.
      COMBAT_D->victim_penalty(this_object());
      if (str = this_object()->query_temp("death_msg"))
        //can set customized death message to death_msg.
        str = this_object()->name(1) + str;
      else
        str = this_object()->name(1) + "莫名其妙地死了。\n";
      COMBAT_D->announce(this_object(), "death_rumor", str);
      log_file("death", sprintf("[%s] %s is killed: %s.\n",
        ctime(time()), this_object()->query("id"),
        str));
    }
    remove_ride();
    if (objectp(corpse = CHAR_D->make_corpse(this_object(), killer)))
      corpse->move(environment());
  }

  this_object()->remove_all_killer();
  all_inventory(environment())->remove_killer(this_object());


  this_object()->dismiss_team();
  if (this_object()->self_purge()) return;

  if (userp(this_object())) {
    set("gin", 1); set("eff_gin", 1);
    set("kee", 1); set("eff_kee", 1);
    set("sen", 1); set("eff_sen", 1);

    //here is a good point to decrease life time...weiqi,98/12/31
    if (!this_object()->query("life/life_time")) this_object()->set("life/life_time", 60);
    if (!this_object()->query("life/no_death_decrease"))
      this_object()->set("life/life_time", (int)this_object()->query("life/life_time") - 1);
    //now we check if gameover.
    if (check_gameover()) return;
    ghost = 1;
    this_object()->move(DEATH_ROOM);
    DEATH_ROOM->start_death(this_object());

  } else
    destruct(this_object());
}


void reincarnate() {
  ghost = 0;
  // drop all, or they could take a ghost out of hell.
  //command("drop all");  by huarong 2004/11 不掉物品
  set("eff_gin", query("max_gin"));
  set("eff_kee", query("max_kee"));
  set("eff_sen", query("max_sen"));
}

int max_food_capacity() {
  int final;
  final = (int)query_weight() / 200;
  if (final < 100) {
    final = 100;
  }
  return final;
}

int max_water_capacity() {
  int final;
  final = (int)query_weight() / 200;
  if (final < 100) {
    final = 100;
  }
  return final;
}

int heal_up() {
  int update_flag;
  mapping my;
  object ob = this_object();  //////
  if (environment())
    if (environment()->query("no_time")) return -1;
  update_flag = 0;

  my = query_entire_dbase();

  // mon 01/23/99
  if (sizeof(query_temp("no_heal_up")))
    return update_flag;

  // mon 0122/99
  // allow_heal_up will allow a NPC to heal up
  // when fighting. default is no help up.
  if (!userp(this_object()) &&
    this_object()->is_fighting() &&
    !my["allow_heal_up"])
    return update_flag;

  //	if( my["water"] > 0 ) { my["water"] -= 1; update_flag++; }
  //	if( my["food"] > 0 ) { my["food"] -= 1; update_flag++; }
  /////////增加
  if (userp(ob)) {
    if (my["water"] > 0) {
      my["water"] -= 1;
      if (my["water"] == ob->max_water_capacity() * 0.3)
        tell_object(ob, HIY "\n你舔了舔干裂的嘴唇，看样子是渴了。\n" NOR);
      if (my["water"] == ob->max_water_capacity() * 0.1) {
        tell_object(ob, HIY "\n水，水，你扯着快冒火的嗓子干嚎着。\n" NOR);
        ob->delete_temp("waters");
      }
      update_flag++;
    } else {
      if (!ob->query_temp("waters")) {
        tell_object(ob, HIR "\n水，水，你扯着快冒火的嗓子干嚎着。\n" NOR);
        ob->set_temp("waters", 10);
      }

      if ((int)ob->query_temp("waters") > 1)
        ob->add_temp("waters", -1);
      else {
        tell_object(ob, HIR "\n你渴得快要死了。。。。\n" NOR);
        if (wizardp(ob)) {
          tell_object(ob, HIW "还好你是大唐西游的巫师，只见你伸手一挥，变出了一大瓶农夫山泉\n" +
            "迫不及待得一仰头连着瓶给整个地吞了下去？！哎，可怜的孩子，看来真得渴坏了！\n" NOR);
          ob->set("water", ob->max_water_capacity());
        } else if ((int)ob->query("age") < 16)  //改为16岁  huarong 2004/6
        {
          tell_object(ob, HIY "还好你没过断奶期...你掏出一个奶瓶狠狠的吸了两口，觉得好多了！\n" NOR);
          ob->set("water", ob->max_water_capacity());
        } else if (ob->query("nowf", 1) < 5) {
          ob->set_temp("waters", 10);
          ob->add("nowf", 1);
          ob->unconcious();
        } else {
          ob->set_temp("death_msg", "活活渴死了。");

          ob->set("nowf", 0);
          ob->set("water", ob->max_water_capacity());
          ob->set("food", ob->max_food_capacity());
          ob->die();
        }
      }
      update_flag++;
    }
    if (my["food"] > 0) {
      my["food"] -= 1;
      if (my["food"] == ob->max_food_capacity() * 0.3)
        tell_object(ob, HIY "\n你肚子咕咕直叫，看来得吃点东西了。\n" NOR);
      if (my["food"] == ob->max_food_capacity() * 0.1) {
        tell_object(ob, HIY "\n你饿得直发慌，赶快吃点东西吧。\n" NOR);
        ob->delete_temp("foods");
      }
      update_flag++;
    } else {
      if (!ob->query_temp("foods")) {
        tell_object(ob, HIR "\n你饿得直冒金星，实在是顶不住了。\n" NOR);
        ob->set_temp("foods", 10);
      }

      if ((int)ob->query_temp("foods") > 1)
        ob->add_temp("foods", -1);
      else {
        tell_object(ob, HIR "\n你饿得快要死了。。。。\n" NOR);
        if (wizardp(ob)) {
          tell_object(ob, HIY "还好你是大唐西游的巫师，只见你伸手一挥，变出了一大堆好吃的\n" +
            "哇，还有烤乳猪耶！，你哗啦两下就吃光了，看来你真是饿坏了！\n" NOR);
          ob->set("food", ob->max_food_capacity());
        } else if ((int)ob->query("age") < 16)  //改为16岁  huarong 2004/6
        {
          tell_object(ob, HIY "还好你没过断奶期...你掏出一个奶瓶狠狠的吸了两口，觉得好多了！\n" NOR);
          ob->set("food", ob->max_food_capacity());
        } else if (ob->query("nowf", 1) < 5) {
          ob->set_temp("foods", 10);
          ob->add("nowf", 1);
          ob->unconcious();
        } else {
          ob->set_temp("death_msg", "活活饿死了。");

          ob->set("nowf", 0);
          ob->set("water", ob->max_water_capacity());
          ob->set("food", ob->max_food_capacity());
          ob->die();
        }
      }
      update_flag++;
    }
  }
  ///////增加结束

  if (my["water"] < 1 && userp(this_object())) return update_flag;

  my["gin"] += my["con"] / 3 + my["atman"] / 10;
  if (my["gin"] >= my["eff_gin"]) {
    my["gin"] = my["eff_gin"];
    if (my["eff_gin"] < my["max_gin"]) { my["eff_gin"]++; update_flag++; }
  } else update_flag++;

  // kee and force depends on drink to heal.

  my["kee"] += my["con"] / 3 + my["force"] / 10;
  if (my["kee"] >= my["eff_kee"]) {
    my["kee"] = my["eff_kee"];
    if (my["eff_kee"] < my["max_kee"]) { my["eff_kee"]++; update_flag++; }
  } else update_flag++;

  if (my["max_force"] && my["force"] < my["max_force"]) {
    my["force"] += (int)this_object()->query_skill("force", 1) / 2;
    if (my["force"] > my["max_force"]) my["force"] = my["max_force"];
    update_flag++;
  }

  if (my["food"] < 1 && userp(this_object())) return update_flag;

  if (my["max_atman"] && my["atman"] < my["max_atman"]) {
    my["atman"] += (int)this_object()->query_skill("magic", 1) / 2;
    if (my["atman"] > my["max_atman"]) my["atman"] = my["max_atman"];
    update_flag++;
  }

  // sen and mana depends on food for heal.

  my["sen"] += my["con"] / 3 + my["mana"] / 10;
  if (my["sen"] >= my["eff_sen"]) {
    my["sen"] = my["eff_sen"];
    if (my["eff_sen"] < my["max_sen"]) { my["eff_sen"]++; update_flag++; }
  } else update_flag++;

  if (my["max_mana"] && my["mana"] < my["max_mana"]) {
    my["mana"] += (int)this_object()->query_skill("spells", 1) / 2;
    if (my["mana"] > my["max_mana"]) my["mana"] = my["max_mana"];
    update_flag++;
  }

  return update_flag;
}

int filter_items(object obj)  //选取有"changed"属性的装备
{
  if (obj->query("changed")) return 1;
  else return 0;
}
