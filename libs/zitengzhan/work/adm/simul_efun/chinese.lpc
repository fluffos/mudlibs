string chinese_number(int i) {
  return CHINESE_D->chinese_number(i);
}

string to_chinese(string str) {
  return CHINESE_D->chinese(str);
}

int is_chinese(string str) {
  // AGENTS.md §15h: this driver's strings are UTF-8 codepoints, not GBK
  // bytes -- str[0] > 160 && str[0] < 255 (a GBK lead-byte range check)
  // is always false against a real Unicode codepoint (e.g. 0x4e2d for
  // "中"). Replaced with a CJK Unified Ideographs codepoint range check.
  // Also: strlen(str)>=2 used to mean "at least one full 2-byte GBK
  // char" -- with UTF-8 char counts that's strlen(str)>=1.
  if (strlen(str) >= 1 && str[0] >= 0x4e00 && str[0] <= 0x9fff) return 1;
  return 0;
}
