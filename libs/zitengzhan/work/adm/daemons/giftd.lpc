
#include <ansi.h>
inherit F_DBASE;
// 2011-2-3 00:00:00 2011年新年时刻
#define NEWYEAR (1296662400-808)
// 奖励天数（离新年7天之内）
#define DAYS 7
#define DEMAND_IPS 5


void gift_monitor(int opt);
void deliver_gift(int opt);
void create()
{
		seteuid( getuid() );
		set("name","礼物大使");
		set("id","gifter");
		gift_monitor(0);
}

// 由任务调用，给玩家新年特别礼物
int gift(object who, int ratio)
{
	int bonus;
	int exp, daoxing, pot;
	
	bonus = time()-NEWYEAR; // 距离新年的时间
	if(bonus<0)
		bonus *= -1;
	bonus = DAYS*24*3600 - bonus; // 7天之内，离新年越近，奖励越多
	if(bonus<=0)
		return 0;
	bonus = bonus/250;
	if(bonus<=0)
		return 0;
	bonus = bonus*ratio/100; // 乘以任务系数
	exp = bonus;
	daoxing = bonus/2+random(bonus);
	pot = daoxing/3+random(daoxing/6);
	who->add("combat_exp", exp);
	who->add("daoxing", daoxing);
	who->add("potential",pot);
	
	tell_object(who, HIG"恭喜你获得了"+chinese_number(exp)+"点武学经验"+chinese_number(pot)+
                            "点潜能、"+COMBAT_D->chinese_daoxing(daoxing)+"道行的"HIW"新年特别奖励!\n\n"NOR);
	
}

// 新年前10个小时和后10个小时分别派送10个礼包
void gift_monitor(int opt)
{
	int time;

	remove_call_out("gift_monitor");

	if(!opt)
	{
		time = NEWYEAR - time(); // 
		if(time>=3600*16)
			call_out("gift_monitor", 3600, 0);
		else if(time>=3600*15+60)
			call_out("gift_monitor", time-3600*15-50, 0);
		else if(time>=3600*15)
			call_out("gift_monitor", time-3600*15, -16);
		else if(time>=3600*14)
			call_out("gift_monitor", time-3600*14, -15);
		else if(time>=3600*13)
			call_out("gift_monitor", time-3600*13, -14);
		else if(time>=3600*12)
			call_out("gift_monitor", time-3600*12, -13);
		else if(time>=3600*11)
			call_out("gift_monitor", time-3600*11, -12);
		else if(time>=3600*10)
			call_out("gift_monitor", time-3600*10, -11); // 之前为预告
		else if(time>=3600*9)
			call_out("gift_monitor", time-3600*9, -1);
		else if(time>=3600*8)
			call_out("gift_monitor", time-3600*8, -2);
		else if(time>=3600*7)
			call_out("gift_monitor", time-3600*7, -3);
		else if(time>=3600*6)
			call_out("gift_monitor", time-3600*6, -4);
		else if(time>=3600*5)
			call_out("gift_monitor", time-3600*5, -5);
		else if(time>=3600*4)
			call_out("gift_monitor", time-3600*4, -6);
		else if(time>=3600*3)
			call_out("gift_monitor", time-3600*3, -7);
		else if(time>=3600*2)
			call_out("gift_monitor", time-3600*2, -8);
		else if(time>=3600*1)
			call_out("gift_monitor", time-3600*1, -9);
		else if(time>=3600*0)
			call_out("gift_monitor", time-3600*0, -10);
		else if(time>=-3600*1)
			call_out("gift_monitor", time+3600*1, 1);
		else if(time>=-3600*2)
			call_out("gift_monitor", time+3600*2, 2);
		else if(time>=-3600*3)
			call_out("gift_monitor", time+3600*3, 3);
		else if(time>=-3600*4)
			call_out("gift_monitor", time+3600*4, 4);
		else if(time>=-3600*5)
			call_out("gift_monitor", time+3600*5, 5);
		else if(time>=-3600*6)
			call_out("gift_monitor", time+3600*6, 6);
		else if(time>=-3600*7)
			call_out("gift_monitor", time+3600*7, 7);
		else if(time>=-3600*8)
			call_out("gift_monitor", time+3600*8, 8);
		else if(time>=-3600*9)
			call_out("gift_monitor", time+3600*9, 9);
		else if(time>=-3600*10)
			call_out("gift_monitor", time+3600*10, 10);
		else
			{
				CHANNEL_D->do_channel(this_object(),"sys", "giftd shut down\n");
				log_file("gifts.log","giftd shut down\n");
			}
	}
	else
	{
		deliver_gift(opt);
		call_out("gift_monitor", 3550, 0);
	}
}


void deliver_gift(int opt)
{
	object ob, pob, gift;
	// Object env;
	mapping ips;
	string ip, *ks, stype;
	int num;
	int type; // 1除夕 2春节 3除夕彩排 4春节彩排
	
	if(opt<-10)
	{
		message("channel:chat",YEL"\n【春节礼物】"+CYN+"礼物大使：祝所有玩家"HIY"新年发财，万事如意"CYN"！\n\n"NOR,users());
		message("channel:chat",YEL"\n【春节礼物】"+CYN+"礼物大使："+chinese_number(-1*opt-10)+"小时后开始发放节日大礼包，敬请期待！\n\n"NOR,users());
		return;
	}

	CHANNEL_D->do_channel(this_object(),"sys", "delivering gift:"+opt+"\n");

	if(opt<0)
	{
		opt = -1*opt;
		type = 1; // 
		stype = MAG"除夕"NOR;
	}
	else
	{
		type = 2; // 
		stype = MAG"春节"NOR;
	}
	ips = ([ ]);
	num = 0;
	foreach (pob in users())
	{
		if (wizardp(pob) || !environment(pob) || environment(pob)->is_chat_room())
			continue;
		num++;
		ip = query_ip_number(pob);
		if (undefinedp(ips[ip])) 
			ips[ip] = ({ pob }); 
		else 
			ips[ip] += ({ pob });
	}	
	log_file("gifts.log","玩家："+num+" of "+sizeof(users())+"\n");
	if (sizeof(ips) >= DEMAND_IPS)
	{    
		// 需要五个以上的IP登录
		// 随机抽一个IP
		ks = keys(ips);
		log_file("gifts.log", "参与ip数量："+sizeof(ks)+"\n");
		ip = ks[random(sizeof(ks))];
		// 在该IP地址上随即抽取一个玩家
		pob = ips[ip][random(sizeof(ips[ip]))];
		// 产生礼物
		gift = new("/u/nanf/gifts/newyear_package.lpc");
		if(!gift)
		{
			log_file("gifts.log", log_time()+" 第"+chinese_number(opt)+"号"+stype+"礼物产生失败。\n");
			return;
		}
		gift->modify(opt, type);
		if(!gift->move(pob))
		{
			log_file("gifts.log", log_time()+" move()函数失败，第"+chinese_number(opt)+"号"+stype+"礼物派送失败。\n");
			return;
		}
		message_vision(HIG"\n四周隐隐响起鼓乐丝竹之声，甚是悦耳，半晌，一朵祥云从天而降。\n",pob);
		message_vision(HIG"\n祥云慢慢散去，"HIM"紫藤礼物大使"HIG"一脸喜色，笑吟吟地走了过来。\n",pob);
		message_vision(HIG"\n"HIM"紫藤礼物大使"HIG"对着$N一拱手，笑道：恭喜、恭喜！\n",pob);
		message_vision(HIG"\n"HIM"紫藤礼物大使"HIG"给了$N一个大礼包。\n",pob);
		message_vision(HIG"\n"HIM"紫藤礼物大使"HIG"一拱手：后会有期。说罢驾祥云而去。\n",pob);
		message("channel:chat",YEL"\n【春节礼物】"+CYN+"礼物大使：恭喜"+BLINK+WHT+pob->query("name")+"("+pob->query("id")+")"NOR+CYN"获得第"+RED+chinese_number(opt)+CYN"号"+stype+CYN"礼物！\n\n"NOR,users());
		if(opt<10 || type==1 || type==3)
			message("channel:chat",YEL"\n【春节礼物】"+CYN+"礼物大使：将在一小时后发放下一个礼包！\n\n"NOR,users());
		else
			message("channel:chat",YEL"\n【春节礼物】"+CYN+"礼物大使：所有节日礼包均已发放完毕，紫藤巫师组祝大家玩得愉快！\n\n"NOR,users());
		log_file("gifts.log", log_time()+" 第"+chinese_number(opt)+"号"+stype+"礼物获得者："+pob->query("name")+"("+pob->query("id")+")\n");
	}
	else
	{
		message("channel:chat",YEL"\n【春节礼物】"+CYN+"礼物大使：由于参与的玩家太少，第"+chinese_number(opt)+"号"+stype+CYN"礼物派送失败！\n\n"NOR,users());
		log_file("gifts.log", log_time()+" 由于玩家太少，第"+chinese_number(opt)+"号"+stype+"礼物派送失败。\n");
	}
}

