// jinguzhou.c
#include <ansi.h>

inherit SSERVER;

int cast(object me, object target)
{
        string msg;
        int damage, ap, dp, howlong=0, haveseal;
	object ob;

        if( !target ) target = offensive_target(me);
        if( (ob = present("jingu zhou", me))) 
                haveseal=1;
	else
                haveseal=0;
        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁念「紧箍咒」？\n");
	//	if(me->query("family/family_name")!="南海普陀山")
	if (!PFM_D->valid_family(me, "南海普陀山"))
                return notify_fail("不是佛门弟子不能用「紧箍咒」！\n");

        if((int)me->query_skill("spells") < 100)
                return notify_fail("你还没学会念「紧箍咒」\n");

	if((int)me->query("mana") < 25+(int)me->query("mana_factor") )
                return notify_fail("你的法力不够！\n");

        if((int)me->query("sen") < 10 )
                return notify_fail("你无法集中精力，别施用到自己头上！\n");

        me->add("mana", -25-(int)me->query("mana_factor"));
        me->receive_damage("sen", 10);

        if( random(me->query("max_mana")) < 50 ) {
                write("你失败了！\n");
                return 1;
        }

        msg = HIC"$N默默地将那「紧箍咒」念了几遍。\n" NOR;
 
        ap = me->query_skill("spells");
        ap = ( ap * ap * ap / (4 * 400) ) * (int)me->query("sen");
        ap += (int)me->query("daoxing");
        dp = target->query("daoxing");
        if( random(ap + dp) > dp/2 ) 
	{
                damage = (int)me->query("max_mana") / 5 + random((int)me->query("eff_sen") / 5);
                damage -= (int)target->query("max_mana") / 10 + random((int)target->query("eff_sen") / 5);         
                damage+=(int)me->query("mana_factor")-random((int)target->query("mana_factor"));
                if( damage > 0 ) 
		{
                	msg += HIC "把个$n痛得竖蜻蜓，翻筋斗，耳红面赤，眼胀身麻，不由得抓破了自己的头！\n" NOR;
			//finally damage also depends on enabled spells level.
                	damage +=random((damage*(int)me->query_skill("spells"))/180);
			if (!haveseal)
				damage = damage*2/3;
                        target->receive_damage("sen", damage, me);
                        target->receive_wound("sen", damage/2, me);
                        target->receive_damage("kee", damage, me);
                        target->receive_wound("kee", damage/2, me);
			target->set_temp("no_move", 1);
    //                  me->improve_skill("buddhism", 1, 1);
               		howlong = 15 + random((me->query_skill("spells") -100));
                	if(howlong>60) howlong=60;
			if(!haveseal)
				howlong /= 2;
                }
		else msg += "但是什么也没发生。\n";
	} 
        else
		msg += "但是什么也没发生。\n";

        message_vision(msg, me, target);

        if( damage > 0) 
	{
		if(!random(20))
			destruct(ob);
		COMBAT_D->report_status(target);
		call_out("free", howlong, target);
	}

        if( !target->is_fighting(me) ) 
	{
                if( living(target) ) 
		{
                        if( userp(target) ) 
				target->fight_ob(me);
                        else
				target->kill_ob(me);
                }
                me->fight_ob(target);
        }

    //  me->start_busy(1);
        return 5+random(5);
}

void free(object target)
{
        if(target) target->delete_temp("no_move");      
        return;
}


