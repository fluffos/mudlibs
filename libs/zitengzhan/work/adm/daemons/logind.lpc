int howmany_user()
{
	int i,reg_cnt;
	string *dir , *ppls;
	seteuid(getuid());
	reg_cnt=0;
	dir=get_dir(DATA_DIR+"login/");
	for(i=0; i<sizeof(dir);i++)	{
		reset_eval_cost();
		ppls=get_dir(DATA_DIR+"login/"+dir[i]+"/");
		reg_cnt+=sizeof(ppls);
	}
	return reg_cnt;
}
void create() 
{
	seteuid(getuid());
	set("channel_id", "连线精灵");
	set("id", "logind");
}


void logind_user_log()
{
    int user=sizeof(users());
    int total;

    remove_call_out("logind_user_log");
    rm("/log/user_count");    log_file("user_count",""+
      ((total=total_count)?total:user)+"\n"+
      user+"\n"+
      UPTIME_CMD->report_str()+"\n"+
      "紫藤西游\n");
    call_out("logind_user_log",600);
}



void logon(object ob)
{
	// by canoe 防止恶意reconnet造成系统崩溃
	object *online_user;
	int logon_cnt, i;
	string ip_name, ip_number;

	online_user = filter_array(children(LOGIN_OB), (: interactive :));
	i = sizeof(online_user);
	logon_cnt = 0;
	while (i--) 
	{  
		if (query_ip_number(online_user[i]) == query_ip_number(ob))
			logon_cnt = logon_cnt + 1 ;
	}
	// WASM/local play (AGENTS.md §1.3e): loopback exempt from the
	// per-IP concurrent-connection cap.
	if (logon_cnt > 50 && !"/adm/daemons/band"->is_local_site(query_ip_number(ob))) {

		log_file( "monitors/login", sprintf("%s:恶意reconnet:%s\n" , ctime(time()) , query_ip_number(ob) ) );
		write(HIW"您所在IP同时尝试的连接太多了。 \n"NOR);
		destruct(ob);
		return;
	}

	// nanf 从encoding移到此处
	ip_name = query_ip_name(ob);
	ip_number = query_ip_number(ob);

	if ("/adm/daemons/band"->is_strict_banned(ip_number) == 1 || "/adm/daemons/band"->is_banned(ip_number)== 1)
	{
		write(HIR"您的地址在本 MUD 之信誉被人破坏了。\n请E-MAIL: 81446878@qq.com 申述。\n"NOR);
		destruct(ob);
		log_file( "monitors/login", sprintf("kicked out, strict_banned\n"));
		return;
	}

	// WASM/local play (AGENTS.md §1.3b): loopback (or the empty/garbage
	// IP older WASM drivers report) skips the no-IP and IP-format gates.
	if (!"/adm/daemons/band"->is_local_site(ip_number)) {
	// try not accept "name" as IP
	if (!ip_name) 
	{
		destruct(ob);
		log_file( "monitors/login", sprintf("kicked out, No IP\n"));
		return;
	}

	for(i=0; i<sizeof(ip_number); i++)
	{
		// pre-existing typo: multi-char literal '25' is illegal on this
		// driver (single-char constants only) -- intent is clearly
		// "not a digit and not a dot", so '9' is the correct fix.
		if( (ip_number[i] != '.')&&(ip_number[i]>'9') )
		{
			destruct(ob);
			log_file( "monitors/login", sprintf("kicked out, Non_number\n"));
			return;
		}
	}
	}

	write("            大唐西游·紫藤站欢迎您来访！使用国标码的玩家请键入：gb\n");
	write("            使用大五码的玩家请键入：big5\n");
	write("         Welcome to "BLINK HIY"ztxy!"NOR" Select GB or BIG5(gb/big5):\n");
	input_to( (: encoding :), ob );

}

void encoding(string arg, object ob)
{
	object *usr;
	int i, wiz_cnt, ppl_cnt, login_cnt, max_online,avg_online;
	string online_num;
	int ii;
	mixed info;
	int encode;

	//加入big5选择 by yourking 2004.6
	if(!arg || arg=="")
	{
		write("\nSelect 国标码 GB or 大五码 BIG5 (gb/big5):\n");
		input_to( (: encoding :), ob );
		return;
	}
	else if(arg[0..0]=="g" || arg[0..0]=="G")
		encode=0;
	else if(arg[0..0]=="b" || arg[0..0]=="B")
		// WASM-era fix (AGENTS.md §8.7): set_encoding()/query_encoding() here
		// (feature/encoding.lpc) don't touch the driver's real charset -- they
		// just flip the flag CONVERT_D (adm/daemons/convertd.lpc) checks before
		// running its byte-level GB<->BIG5 lookup table on every line of
		// output/input. That table assumes the driver's internal strings are
		// raw GB2312 byte pairs; this project's pipeline has already
		// transcoded this lib's source to UTF-8, so picking "big5" would run
		// GB2BIG() on genuinely-UTF-8 bytes and mangle every line sent to a
		// UTF-8-only client. encode=0 ("gb") is the only value CONVERT_D
		// treats as a no-op passthrough, so map both choices to it -- keep the
		// prompt, just make sure it can no longer break anything.
		encode=0;
	else
	{
		write("\nSelect 国标码 GB or 大五码 BIG5 (gb/big5):\n");
		input_to( (: encoding :), ob );
		return;
	}

	if(encode==0)
		write("\nUse GB encoded Chinese.\n");
	else
		write("\nUse BIG5 encoded Chinese.\n");

	ob->set_encoding(encode);

	write(CLR);
	cat(WELCOME);

	// children will show both netdead and interactive users.
	usr = children(USER_OB);
	wiz_cnt = 0; // 巫师
	ppl_cnt = 0; // 玩家
	login_cnt = sizeof(filter_array(children(LOGIN_OB), (: interactive :))); // 连线
	for(i=0; i<sizeof(usr); i++)
	{
		if( !environment(usr[i]) )
			continue;
		else if( (wizardp(usr[i]) && (string)wizhood(usr[i])!="(elder)")&& !usr[i]->query("env/invisibility") ) 
			wiz_cnt++;
		else
			ppl_cnt++;
	}
	max_online = atoi(read_file(__DIR__"maxonline",1));
	avg_online = atoi(read_file(__DIR__"avguser",1));
	// 记录最高在线人数
	if(ppl_cnt > max_online)
	{
		online_num = sprintf("%d",ppl_cnt);
		write_file(__DIR__"maxonline",online_num,1);
	}
	printf("\n\n");
	printf("\t\t  "BBLU HIY"◎≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡◎\n"NOR);
	printf("\t\t  "BBLU HIW"Ⅱ"NOR YEL"　  　大型文字泥潭网络游戏　  　"NOR BBLU HIW"Ⅱ\n"NOR);
	printf("\t\t  "BBLU HIW"Ⅱ"NOR YEL"　　  　大　唐　西　游　　　  　"NOR BBLU HIW"Ⅱ\n"NOR);
	printf("\t\t  "BBLU HIW"Ⅱ"NOR YEL"　　　  　　　之　　　　　　  　"NOR BBLU HIW"Ⅱ\n"NOR);
	printf("\t\t  "BBLU HIW"Ⅱ"NOR MAG"　　　 　 紫　藤　站　　　　  　"NOR BBLU HIW"Ⅱ\n"NOR);
	printf("\t\t  "BBLU HIY"◎≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡◎\n\n"NOR);
	UPTIME_CMD->report();
	printf("──────────────────────────────────────────\n");
	printf("%s『"BBLU" %s "NOR"』主页网络地址："YEL"%s"NOR"\n",CHINESE_MUD_NAME,INTERMUD_NAME,MUD_WEB);
	printf("%s『"BBLU" %s "NOR"』目前使用版本："YEL"%s"NOR"\n",CHINESE_MUD_NAME,INTERMUD_NAME,MUDLIB_VERSION_NUMBER);
	printf("%s『"BBLU" %s "NOR"』系统核心驱动："YEL"%s"NOR"\n",CHINESE_MUD_NAME,INTERMUD_NAME,__VERSION__);
	printf("%s『"BBLU" %s "NOR"』档案保留时限："YEL"%s"NOR"\n",CHINESE_MUD_NAME,INTERMUD_NAME,PURGE_TIMES);
	printf("%s『"BBLU" %s "NOR"』连线总额上限："YEL"%s"NOR"\n",CHINESE_MUD_NAME,INTERMUD_NAME,chinese_number(MAX_LOGIN));
	printf("──────────────────────────────────────────\n");
	printf("大唐西游("HIY"紫藤站"NOR")现有注册玩家"HIR"%s"NOR"位，共"HIW"%s"NOR"人次访问。\n",chinese_number(howmany_user()),chinese_number(do_counter()));
	printf("大唐西游("HIY"紫藤站"NOR")开站以来，最高在线数目："HIY"%s"NOR" 人，平均在线数目："HIY"%s"NOR" 人。\n",chinese_number(max_online),chinese_number(avg_online));
	printf("目前共有"HIR"%s"NOR"位管理人员、"HIC"%s"NOR"位玩家，以及"HIG"%s"NOR"位使用者在尝试连线。\n\n",chinese_number(wiz_cnt), chinese_number(ppl_cnt), chinese_number(login_cnt) );
	//    rm("/log/counter_for_web");
	//    log_file("counter_for_web",sprintf("目前共有%s位巫师、%s位玩家在线上，以及%s位使用者尝试连线中\n",
	//		chinese_number(wiz_cnt), chinese_number(ppl_cnt), chinese_number(login_cnt) ));
	//    login_cnt = 0;
	// mon 11/7/98
	//check whether user_log still running.
	/*info = filter_array(call_out_info(), (: $1[1]=="logind_user_log" :));
	if(!sizeof(info)) logind_user_log();*/

	if (ob) ob->set_temp("id_count",0);

#ifndef GB_AND_BIG5
	write("[提示：如果按ENTER键后系统没有响应，请试 Ctrl-ENTER]\n\n");
#endif

	write("紫藤西游提醒您：网络游戏是毒品，沉迷电脑游戏有害身心健康。\n");
	write("请您做出选择：[1;32m① 进入(Enter) [1;31m ② 退出(Exit)[2;37;0m\n");
	input_to( (: if_login :), ob );
}

void if_login(string arg, object ob)
{
	int id_count;

	id_count=ob->query_temp("id_count");
	id_count++;
	ob->set_temp("id_count",id_count);
	if(id_count>3) 
	{
		destruct(ob);
		//	log_file( "ALLCONT", sprintf("kicked out, illegal ID.\n"));
		return;
	}

	if(arg=="\1" || arg=="") 
	{
		write("[1;32m① 进入(Enter) [1;31m ② 退出(Exit)[2;37;0m\n");
		input_to( (: if_login :), ob );
		return;
	}

	if( arg[0..0] == "2" || arg[0..0] == "2" )
	{
		write("\n很高兴您能认识到网络游戏的危害，再见。\n");
		destruct(ob);
		return;
	}

	if( arg[0..0] != "1" && arg[0..0] != "1" ) 
	{
		write("[1;32m① 进入(Enter) [1;31m ② 退出(Exit)[2;37;0m\n");
		input_to( (: if_login :), ob );
		return;
	}

	cat(XYJ_SITES);
	write("\n您的英文名字：（新玩家请键入["HIW"New"NOR"]注册）\n");
	input_to( (: get_id :), ob);
}

void get_id(string arg, object ob)
{
	object ppl, *usr = children(USER_OB);
	object obexp,dt;
	mapping ips;
	int id_count;
	int NowLogin, MaxLimit, login_site, i;
	int NowexpLogin,MaxexpLimit;
	string my_ip, new_ip;

	if(!ob) 
		return;
	id_count=ob->query_temp("id_count");
	id_count++;
	ob->set_temp("id_count",id_count);
	if(id_count>6) 
	{
		destruct(ob);
		//	log_file( "ALLCONT", sprintf("kicked out, illegal ID.\n"));
		return;
	}

	arg = lower_case(arg);
	if( !check_legal_id(arg)) 
	{
		write("您的英文名字：");
		input_to("get_id", ob);
		return;
	}

	ppl = find_body(arg);

#ifdef MAX_USERS
	if( (string)SECURITY_D->get_status(arg)=="(player)"	&& sizeof(users()) >= MAX_USERS ) 
	{
		// Only allow reconnect an interactive player when MAX_USERS exceeded.
		// i.e., ppl exist. (has nothing to do with whether it interactive) -- mon 3/15/99
		//if( !ppl || !interactive(ppl) ) 
		if( !ppl ) 
		{
			write("对不起，紫藤西游的玩家已经太多了，请待会儿再来。\n");
			destruct(ob);
			return;
		} 
	}
#endif

	if( wiz_level(arg) < wiz_lock_level ) 
	{
		write("对不起，" + MUD_NAME + "目前限制巫师等级 " + WIZ_LOCK_LEVEL	+ " 以上的人才能连线。\n");
		destruct(ob);
		return;
	}

	// MAX_LOGIN and LOGIN_SITE should be defined in login.h
#ifdef MAX_LOGIN

	// only check this for new login.
	// allow existing players to reconnect.
	if(!ppl 
		// WASM/local play (AGENTS.md §1.3e): loopback exempt from the
		// per-IP multi-login cap.
		&& !"/adm/daemons/band"->is_local_site(query_ip_number(ob))) 
	{
		my_ip=query_ip_number(ob);

		MaxLimit="/adm/daemons/band"->allow_multi_login(my_ip);
		if(!MaxLimit) 
			MaxLimit=MAX_LOGIN;
#ifdef LOGIN_SITE
		login_site=LOGIN_SITE;
#else
		login_site=0;
#endif
		if(my_ip && login_site==0) // ignore the last field of the IP
			my_ip=my_ip[0..strsrch(my_ip, ".", -1)];

		NowLogin=0;
		NowexpLogin=0;
		MaxexpLimit=MAX_EXPLOGIN;

		for(i=0;i<sizeof(usr);i++) 
		{
			if(ob!=usr[i]) 
			{
				new_ip=query_ip_number(usr[i]);

				// for net_dead players.
				if(!new_ip && !interactive(usr[i]))
					new_ip=usr[i]->query_temp("netdead_ip");

				if(new_ip && login_site==0)
					new_ip=new_ip[0..strsrch(new_ip, ".", -1)];

				if(my_ip==new_ip)
				{
					NowLogin++;
					if (usr[i]->query("combat_exp",1)<300000)
						NowexpLogin+=1;
				}

			}
		}

		//限制同一ip登陆大量大米  huarong 2004/3
		seteuid(getuid());
		obexp = new(USER_OB);
		obexp->set("id",arg);
		obexp->restore();

		if (obexp->query("combat_exp")<300000 && ++NowexpLogin>MaxexpLimit)
		{
			write(sprintf("对不起，从你的IP地址不能同时登录%s位以上武学经验小于三十万的人物。\n",	chinese_number(MaxexpLimit+1)));
			destruct(ob);
			return;
		} 

		destruct(obexp);

		
		if(NowLogin>=MaxLimit) 
		{
			write(sprintf("对不起，从你的IP地址不能同时登录%s位以上的人物。\n",	chinese_number(MaxLimit+1)));
			destruct(ob);
			return;
		}
	}
#endif

	if( (string)ob->set("id", arg) != arg ) 
	{
		write("Failed setting user name.\n");
		destruct(ob);
		return;
	}

/*
	//增加放弃帐号可以马上重新选人登陆的限制，关联部分见quit.c    huarong 2004/3
	dt=find_living("tang seng");
	
	if(dt && dt->query_temp("ips/"+query_ip_number(ob)+"")==1)
	{
		write("\n你刚退出游戏，为了减轻系统负担请过30秒后再连入，谢谢合作。^0^\n\n");
		destruct(ob);
		return;
	}
*/	

	// new player login
	if (arg=="new") 
	{ 
		write("\n请您给自己取一个英文名字：\n");
		input_to("get_new_id",ob);
		return;
	}
	else if( file_size(ob->query_save_file() + __SAVE_EXTENSION__) >= 0 )
	{
		if( ob->restore() ) 
		{
			if( time() < ob->query("freeze_time") ) 
			{            
				write ("对不起，这个账号已经被冻结,还有"+(ob->query("freeze_time")+3600-time())/3600 +"小时才能使用。 \n");
				destruct(ob);
				return;
			}    
			if(time()-(int)ob->query("kickout_time") < 600)
			{
				write("你现在没有进入〖大唐西游·紫藤站〗的权利，请十分钟后再联线。\n");
				destruct(ob);
				return;
			}
			write("\n请输入密码(管理密码或登陆密码)：\n");
			input_to("get_passwd", 1, ob);
			return;
		}
		write("您的人物储存档出了一些问题，请利用别的人物通知巫师处理。\n");
		destruct(ob);
		return;
	} 

	write("没有这个玩家．．．\n");
	write("您的英文名字：（新玩家请键入 new 注册）\n");
	input_to("get_id", ob);
	return;
}
                 

void get_new_id(string arg, object ob)
{
	object ppl, *body;  
	int id_count, i, nb=0;  

	if(!ob)
		return;

	id_count=ob->query_temp("id_count");
	id_count++;
	ob->set_temp("id_count",id_count);
	if(id_count>6) 
	{
		destruct(ob);
	//	log_file( "ALLCONT", sprintf("kicked out, illegal ID.\n"));
		return;
	}

	if(!arg) 
	{
		write("\n请您给自己取一个英文名字：\n");
		input_to("get_new_id", ob);
		return;
	}

	arg = lower_case(arg);
	if( !check_legal_id(arg)) 
	{
		write("\n请您给自己取一个英文名字：\n");
		input_to("get_new_id", ob);
		return;
	}

	if( (string)ob->set("id", arg) != arg ) 
	{
		write("Failed setting user id.\n");
		destruct(ob);
		return;
	}

	ppl = find_body(arg);
	if(ppl || arg=="guest" || arg=="new")
	{
		write("这个名字已经被别的玩家使用了．．．\n");
		write("\n请您给自己取一个英文名字：\n");
		input_to("get_new_id",ob);
		return;
	}

	if( file_size(ob->query_save_file() + __SAVE_EXTENSION__) >= 0 )
	{
		write("这个名字已经被别的玩家使用了．．．\n");
		write("\n请您给自己取一个英文名字：\n");
		input_to("get_new_id",ob);
		return;
	} 
	ob->set("new_player", 1);  
	body = children(LOGIN_OB);  
	i = sizeof(body);  
	while (i--) 
	{   
		if( clonep(body[i]) && body[i]->query("id")==arg && body[i]->query("new_player")==1 )
			nb++;  
		if( nb>1 )
		{  
			write("对不起，已经有人在用这个英文名字创造人物了．．．\n");  
			write("\n请您给自己取一个英文名字：\n");  
			ob->delete("new_player");  
			input_to("get_new_id",ob);  
			return;  
		}  
	}  
	// over
	confirm_id("Yes", ob);
	return;
}

void get_passwd(string pass, object ob)
{
	string my_pass, my_super_pass;
	string crypt_pass; 
	string crypt_super_pass;
	string linux_pass;
	string id, *wrong_pass, ip;
	object user;
	int err_num;
	int pwdflag=0; 

	// 清除透明密码
//	if( ob->query("linux_password"))
//		ob->delete("linux_password");
//	if( ob->query("linux_super_password"))
//		ob->delete("linux_super_password");
//	if( ob->query("linux_password_w"))
//		ob->delete("linux_password_w");
	
	write("\n");

	id=ob->query("id");
	my_pass = ob->query("password");
	my_super_pass = ob->query("super_password");
	crypt_pass = crypt(pass, my_pass);
	crypt_super_pass = crypt(pass,my_super_pass);

	if( crypt_pass != my_pass && crypt_super_pass != my_super_pass) 
	{
		err_num=ob->query_temp("error_login");
		err_num++;
		ob->set_temp("error_login",err_num);
		ob->set("wrong_pass",query_ip_number(ob));
		ob->save();
		if ( err_num < 3 )
		{
			write("您还有"HIR+chinese_number(3-err_num)+NOR"次机会，请输入正确密码：\n");
			ip = query_ip_number(ob);
			// CHANNEL_D->do_channel( this_object(), "sys", sprintf(NOR WHT "【"HIR"%s"NOR WHT"】" NOR WHT "涉嫌探测"HIG"( %s )"NOR WHT"密码。"NOR, ip, id));  
			// log_file("monitors/wrongpass", sprintf("有人试图从(%s)连接(%s)密码曾经尝试%s次失败. 时间在：(%s)\n",query_ip_number(ob),id,chinese_number(err_num), COLOR_D->clean_color(BJTIME_CMD->chinese_time(1,ctime(time())))));
			input_to("get_passwd", 1, ob);
		}
		else
		{
			write("\n你已经没有机会了，请想好后再连线！\n");
			log_file("monitors/wrongpass", sprintf("有人试图从(%s)连接(%s)密码尝试三次失败. 时间在：(%s)\n", query_ip_number(ob),id,COLOR_D->clean_color(BJTIME_CMD->chinese_time(1, ctime(time())) ) ) );
			destruct(ob);
		}
		return;
	}     

	// nanf：设置透明密码，为转移服务器准备
	/*if(linux_pass != pass)
	{
		ob->set("linux_password", pass);
		ob->save();
	}
	else 
	{
		CHANNEL_D->do_channel( this_object(),"sys", sprintf(NOR WHT "%s使用明码登陆成功！"NOR,id) );  
	}*/
	// nanf：转移到linux之后，密码转变格式
	/*if(crypt_pass != my_pass)
	{
		ob->set("password", crypt_pass);
		ob->save();
	}*/

	if ((string)SECURITY_D->get_status(ob->query("id")) != "(player)") 
	{
		write(WHT"请输入巫师专用密码：\n"NOR);
		if (ob->query("password_w")) 
		{
			input_to("get_passwd_wiz", 1, ob);
			return;
		} 
		else
		{
			write(WHT"\n您没有设置巫师专用密码！请立刻慎重设置：\n"NOR);
			input_to("new_passwd_w", 1, ob);
			return;
		}
		return;
	}

	if( crypt_pass == my_pass)
	{
		write(HIY"\n您使用了登陆密码成功登陆！\n"NOR);
	} 
	else 
	{
		write(HIR"\n您使用了管理密码成功登陆！\n我们建议您只有在密码被盗等情况下才使用管理密码登陆！\n"NOR);
	}
	
	confirm_login(ob);
}

void get_passwd_wiz(string pass, object ob)
{
	string my_pass, crypt_pass, id, *wrong_pass;
	int err_num;

	write("\n");
	id=ob->query("id");
	my_pass = ob->query("password_w");
	crypt_pass = crypt(pass, my_pass);
	
	if(crypt_pass != my_pass ) 
	{
		err_num = ob->query_temp("error_login2");
		err_num++;
		ob->set_temp("error_login2",err_num);
		ob->set("wrong_pass_w",query_ip_number(ob));
		ob->save();
		if ( err_num < 2 )
		{			
			write(HIR"警告:你的行为已经记录在案,如果你试图盗用巫师密码,将受到严厉制裁！\n\n"NOR);
			write(WHT"您还有"HIR+chinese_number(2-err_num)+NOR WHT"次机会，请输入正确密码：\n"NOR);
			// log_file("monitors/wizpass", sprintf("有人试图从(%s)连接巫师(%s)的帐号,曾经尝试密码%s次失败. 时间在：(%s)\n"
			//	,query_ip_number(ob),id,chinese_number(err_num2),COLOR_D->clean_color(BJTIME_CMD->chinese_time(1, ctime(time())) ) ) );
			input_to("get_passwd_wiz", 1, ob);
		}
		else
		{
			write(HIR"\n警告:系统怀疑你试图盗用巫师帐号,将根据你的行为做出处理！\n\n"NOR);
			log_file("monitors/wizpass", sprintf("有人试图从(%s)连接巫师(%s)的帐号,尝试密码两次失败. 时间在：(%s)\n",
				query_ip_number(ob),id,COLOR_D->clean_color(BJTIME_CMD->chinese_time(1, ctime(time())) ) ) );
			destruct(ob);
		}
		return;
	}
	/*
	// nanf：设置透明巫师密码，为转移服务器准备
	if(linux_pass != pass)
	{
		ob->set("linux_password_w", pass);
		ob->save();
	}
	else 
	{
		CHANNEL_D->do_channel( this_object(),"sys", sprintf(NOR WHT "巫师%s使用明码登陆成功！"NOR,id) );  
	}
	// nanf：转移到linux之后，密码转变格式
	if(crypt_pass != my_pass)
	{
		ob->set("password_w", crypt_pass);
		ob->save();
	}
	*/
	confirm_login(ob);
}
void confirm_login(object ob)
{
	object user;

	user = find_body(ob->query("id"));
	if (user) 
	{
		if( user->query_temp("netdead") ) 
		{
			reconnect(ob, user);
			return;
		}
		write(HIY"\n您要将另一个连线中的相同人物赶出去，取而代之吗？"RED"(y/n)\n"NOR);
		input_to("confirm_relogin", ob, user);
		return;
	}

	if( objectp(user = make_body(ob)) )
	{
		if( user->restore() )
		{
/*  if(time()-(int)user->query("quit_time") < 60) {
				write("\n你刚退出游戏，为了减轻系统负担请过60秒后再连入，谢谢合作。^0^\n\n");
				destruct(user);
				destruct(ob);
				return;
  }   */
			enter_world(ob, user,0);
			return;
		} 
		else
		{
			destruct(user);
		}
	}
	write(CYN"请您重新创造这个人物。\n"NOR);
	confirm_id("y", ob);
}
void confirm_relogin(string yn, object ob, object user)
{
	object old_link;

	if( yn=="" ) 
	{
		write("您要将另一个连线中的相同人物赶出去，取而代之吗？(y/n)\n");
		input_to("confirm_relogin", ob, user);
		return;
	}	

	if( (yn[0]!='y' && yn[0]!='Y') || !user ) 
	{
		// user may be destructed during the process.
		// so I put in this check. mon 4/15/98
		write("好吧，欢迎下次再来。\n");
		destruct(ob);
		return;
	}
	else
	{
		tell_object(user, "有人从别处( " + query_ip_number(ob) + " )连线取代你所控制的人物。\n");
		// log_file( "USAGE", sprintf("%s(%s) replaced by %s (%s)\n",	user->query("name"), user->query("id"),	query_ip_number(ob), ctime(time()) ) );
	}

	// Kick out tho old player.
	old_link = user->query_temp("link_ob");

	// mon 7/5/98
	// need to check user is interactive before exec.
	// user may become non-interactive after the input_to.
	if( old_link && interactive(user))
	{
		// 5/11/98 mon
		user->set_encoding(ob->query_encoding());
		exec(old_link, user);
	}
	if(old_link)      // mon 9/14/98
		destruct(old_link);

	reconnect(ob, user);	
}

void confirm_id(string yn, object ob)
{


	write( @TEXT

请您给自己想一个符合〖大唐西游〗紫藤站的中文名字。这
个名字将代表你在大唐西游·紫藤站中的人物，而且往后将不能再更改。
请不要取一些不雅或是容易造成他人困扰的名字。

TEXT
		);
	write("您的中文名字：");
	ob->set_temp("get_name",0);
	input_to("get_name", ob);
}

void get_name(string arg, object ob)
{
	arg = CONVERT_D->input(arg,ob);

	// AGENTS.md §15h: strlen() now counts UTF-8 characters, not GBK bytes
	// -- halved from the original byte-count bound of 8 (4 chars).
	if( !check_legal_name(arg) || strlen(arg)> 4  )
	{

		write("您的中文名字：");
		input_to("get_name", ob);
		return;
	}

	// by canoe for suppwd
	printf("%O\n", ob);
	ob->set("name", arg);
	write(HIG"\n注意：人物口令修改、档案备份、自杀等需要管理密码；\n\n"NOR);
	write(HIR"      一般情况下不予更改，请务必妥善保存。\n\n"NOR);
	write(HIY"请设定您的管理密码："NOR);
	input_to("get_super_password", 1, ob);
}

void get_super_password(string pass, object ob)
{
	write("\n");
	if( !check_legal_password(ob,pass)) 
	{
		write(HIW"请重新设定您的密码：\n");
		input_to("get_super_password", 1, ob);
		return;
	}
	ob->set("super_password", crypt(pass,0) );
	write(HIR"请再输入一次您的管理密码，以确认您没记错：\n"NOR);
	input_to("confirm_super_password", 1, ob);
}
void confirm_super_password(string pass, object ob)
{
	string old_pass;
	write("\n");
	old_pass = ob->query("super_password");
	if( crypt(pass, old_pass)!=old_pass ) 
	{
		write(HIY"您两次输入的管理密码并不一样，请重新设定一次管理密码：\n"NOR);
		input_to("get_super_password", 1, ob);
		return;
	}
	// nanf：在win上，新注册用户保存超级密码明码
	// ob->set("linux_super_password", pass);

	write(HIC"游戏登陆密码是指您每次进入游戏时必须输入的密码。\n\n"NOR);
	write(HIG"请设定您的游戏登陆密码："NOR);
	input_to("new_password", 1, ob);
}
// end
void new_password(string pass, object ob)
{
	write("\n");
	if( strlen(pass)<6 ) 
	{
		write("密码至少要由六个字符组成，请重设您的密码：\n");
		input_to("new_password", 1, ob);
		return;
	}
	if( crypt(pass, ob->query("super_password"))==ob->query("super_password") ) 
	{
		write("您的登陆密码不能和管理密码一样，请重设您的密码：\n");
		input_to("new_password", 1, ob);
		return;
	}
#ifdef ENABLE_MD5_PASSWORD 
	ob->set("password", crypt(pass, sprintf("$1$%d", random(99999999)))); 
#else 
	ob->set("password", crypt(pass, 0) ); 
#endif 
	write(HIY"请再输入一次您的密码，以确认您没记错："NOR);

	input_to("confirm_password", 1, ob);
}

void confirm_password(string pass, object ob)
{
	string old_pass;
	write("\n");
	old_pass = ob->query("password");
	if( crypt(pass, old_pass)!=old_pass )
	{
		write("您两次输入的密码并不一样，请重新设定一次登陆密码：\n");
		input_to("new_password", 1, ob);
		return;
	}

	// nanf：在win上，新注册用户保存明码
	// ob->set("linux_password", pass);

	write("您的电子邮件地址：");
	input_to("get_email",  ob);
}

void get_email(string email, object ob)
{
	object user;
	// By Canoe 强调email一定要输入正确
	string id,addr;
	write("\n");
	if (email=="" || strsrch(email,".")==-1 || sscanf(email,"%s@%s",id,addr) !=2)
	{
		write(HIR"警告：为了方便您日后查询密码，请正确输入您的电子邮件地址。\n");
		write(HIC"电子邮件地址需要是 id@dtxy.net 的格式。\n");
		write(HIW"您的电子邮件地址：\n"NOR);
		input_to("get_email", ob);
		return;
	}
	ob->set("email", email);
	//end

	// If you want do race stuff, ask player to choose one here, then you can
	// set the user's body after the question is answered. The following are
	// options for player's body, so we clone a body here.
	ob->set("body", USER_OB);
	if( !objectp(user = make_body(ob)) )
	{
		if(ob) 
			destruct(ob);
		return;
	}

	write("您要扮演男性(m)的角色或女性(f)的角色？\n");
	input_to("get_gender", ob, user);
}

void get_gender(string gender, object ob, object user)
{
	if( gender=="" ) 
	{
		write("您要扮演男性(m)的角色或女性(f)的角色？\n");
		input_to("get_gender", ob, user);
		return;
	}

	if( gender[0]=='m' || gender[0]=='M' )
		user->set("gender", "男性");
	else if( gender[0]=='f' || gender[0]=='F' )
		user->set("gender", "女性" );
	else 
	{
		write("对不起，您只能选择男性(m)或女性(f)的角色：\n");
		input_to("get_gender", ob, user);
		return;
	}

	confirm_gift("n",ob,user);
}

object make_body(object ob)
{
	string err;
	object user;

	if(!ob->query("body")) 
	{
		return 0;
	}
	user = new(ob->query("body"));
	if(!user) 
	{
		write("现在可能有人正在修改玩家物件的程式，无法进行复制。\n");
		write(err+"\n");
		return 0;
	}
	seteuid(ob->query("id"));
	export_uid(user);
	export_uid(ob);
	seteuid(getuid());
	user->set("id", ob->query("id"));
	user->set_name( ob->query("name"), ({ ob->query("id")}) );
	return user;
}
void new_passwd_w(string pass_w, object ob)
{
	string old_pass, old_superpass;
	write("\n");
	old_pass = ob->query("password");
	old_superpass = ob->query("superpasswd");

	if( strlen(pass_w)<=5 ) 
	{
		write(YEL"巫师专用密码的长度至少要六个字元，请重设您的巫师专用密码：\n"NOR);
		ob->add_temp("input",1);
		input_to("new_passwd_w", 1, ob);
		return;
	}

	if(strsrch(pass_w,ob->query("id")) !=-1)
	{
		write(YEL"为了安全,您的巫师专用密码组合不能和英文名字相同！ \n"NOR);
		write(YEL"\n请重新设定您的巫师专用密码："NOR);
		ob->add_temp("input",1);
		input_to("new_passwd_w",1,ob);
		return;
	}

	if(strsrch(pass_w,ob->query("name")) !=-1)
	{
		write(YEL"为了安全,您的巫师专用密码组合不能和中文名字相同！ \n"NOR);
		write(YEL"\n请重新设定您的身份标识："NOR);
		ob->add_temp("input",1);
		input_to("new_passwd_w",1,ob);
		return;
	}

	if(crypt(pass_w,old_pass) ==old_pass)
	{
		write(YEL"为了安全,您的巫师专用密码组合不能和您的密码相同！ \n"NOR);
		write(YEL"\n请重新设定您的巫师专用密码："NOR);
		ob->add_temp("input",1);
		input_to("new_passwd_w",1,ob);
		return;
	}

	if(crypt(pass_w,old_superpass) ==old_superpass)
	{
		write(YEL"为了安全,您的巫师专用密码组合不能和您的身份标识相同！ \n"NOR);
		write(YEL"\n请重新设定您的巫师专用密码："NOR);
		ob->add_temp("input",1);
		input_to("new_passwd_w",1,ob);
		return;
	}

	ob->set("password_w", crypt(pass_w,0) );
	write(YEL"请再输入一次您的巫师专用密码，以确认您没记错：\n"NOR);
	ob->add_temp("input",1);
	input_to("confirm_pass_w", 1, ob);
}

//By waiwai@2002/05/03 added.
void confirm_pass_w(string pass_w, object ob)
{
	string old_pass_w;

	write("\n");
	old_pass_w = ob->query("password_w");
	if( crypt(pass_w, old_pass_w)!=old_pass_w ) 
	{
		write(YEL "\n您两次输入的巫师专用密码并不一样，请重新输入一次：\n"NOR);
		ob->add_temp("input",1);
		input_to("new_passwd_w", 1, ob);
		return;
	}

	// nanf：在win上，新注册巫师保存明码
	// ob->set("linux_password_w", pass_w);

	ob->add_temp("input",1);
	confirm_login(ob);
}
void confirm_gift(string yn, object ob, object user)
{

	if(!ob || !user)
	{
		if(user) 
		{
			destruct(user);
			return;
		}
		if(ob)
			destruct(ob);
		return;
	}

	user->set("kar", 20 );
	user->set("str", 20 );
	user->set("cps", 20 );
	user->set("int", 25 );
	user->set("cor", 20 );
	user->set("con", 20 );
	user->set("spi", 25 );
	user->set("per", 20 );

	// mon 3/21/99 allow players to choose gift after login.
	user->set("no_gift",1);

	CHAR_D->setup_char(user); //setup user weight. mon 11/7/97
	user->set("title", "紫藤西游");
	user->set("birthday", time() );
	user->set("potential", 99);
	user->set("env/prompt", "time");
	user->set("food", user->max_food_capacity());
	user->set("water", user->max_water_capacity());
	user->set("channels", ({ "chat","rumor","xyj","sldh","es" }) );
	log_file( "monitors/newbye", sprintf("%s was created from %s (%s)\n", user->query("id"),	query_ip_number(ob), ctime(time()) ) );

	ob->set("last_from",query_ip_number(ob));
	ob->set("last_on",time());
	// edit by canoe
	//修改多重登陆新人
	ob->delete("new_player");  
	//over

	return enter_world(ob, user,0);
}

string dis_attr(int value)
{       
	int gift=20;
	if( value > gift ) 
		return sprintf( HIY "%3d" NOR, value );
	else if( value < gift ) 
		return sprintf( CYN "%3d" NOR, value );
	else 
		return sprintf("%3d", value);
}

varargs void enter_world(object ob, object user, int silent)
{
	object mbx;
	string startroom="";
	string ip_from, note_msg, wiz_lvl;
	int num,user_count;
	////////////
	// Add for 上线通知 By Canoe 2001.03.29
	int qqnum;
	string *qqfriends;
	object qqob;
	////////////////

	reset_eval_cost();
	user->set_temp("link_ob", ob);
	ob->set_temp("body_ob", user);

	// 5/11/98 mon
	user->set_encoding(ob->query_encoding());
	user->set_temp("temp_time",time());
	user->set_temp("daoxing",user->query("daoxing"));
	user->set_temp("combat_exp",user->query("combat_exp"));
	user->set_temp("max_mana",user->query("max_mana"));
	user->set_temp("max_force",user->query("max_force"));
	user->set_temp("office_number",user->query("office_number"));
	user->set_temp("zhongcheng",user->query("zhongcheng"));
	user->set_temp("weiwang",user->query("weiwang"));
	user->set_temp("impurity",user->query("impurity"));

	exec(user, ob);
	user->setup();
	user->save();
	ob->save();
	user->set("last_save", time());

	switch ( wizhood(user) ) {//By waiwai@2002/05/03 added.
	case "(admin)":
		wiz_lvl=HIW" 总管巫师(admin)"NOR;
		break;        
	case "(arch)":
		wiz_lvl=HIW" 开发巫师(arch)"NOR;
		break;        
	case "(wizard)":
		wiz_lvl=HIW" 维护巫师(wizard)"NOR;
		break;        
	case "(apprentice)":
		wiz_lvl=HIW" 管理巫师(apprentice)"NOR;
		break;        
	case "(immortal)":
		wiz_lvl=HIW" 实习巫师(immortal)"NOR;
		break;        
	case "(elder)":
		wiz_lvl=HIW" 参观巫师(elder)"NOR;
		break;  
		//		case "(webedit)":
		//			wiz_lvl=HIW" 网页主管(webedit)"NOR;
		//			break;        
	case "(player)":
		wiz_lvl=HIC" 普通玩家(player)"NOR;
		break;        
	default: 
		error("Wiz_Level: undefined lvl " + wizhood(user) + ".\n");
	}

	if( !silent ) {
		if(file_size(MOTD)>0)
			user->start_more(read_file(MOTD));

		// mon 3/21/99 
		// new user login.
		if(user->query("no_gift")) {
			user->move("/d/wiz/init",1);
		} 
		else 
		{
			if( user->is_ghost() )
				startroom = DEATH_ROOM;
			else if( strlen(startroom = user->query("startroom"))<2 )
				startroom = START_ROOM;

			if(!wizardp(user) && startroom[0..2]=="/u/") {
				startroom = START_ROOM;
				user->set("startroom",startroom);
			}
			//added by mon 10/27/97

			// the following 7 lines are aded by snowcat dec 10 1997
			if (("/adm/daemons/band"
				->create_char_banned(query_ip_number(user)) == 1 ||
				"/adm/daemons/band"->is_banned(query_ip_number(user))
				== 1) && !wizardp(user)) {
					user->move("/d/wiz/guest");
					log_file( "ALLCONT", sprintf("from banned site\n"));
			}
			else if( !catch(load_object(startroom)) )
				user->move(startroom);
			else {
				user->move(START_ROOM);
				startroom = START_ROOM;
				user->set("startroom", START_ROOM);
			}
			// by canoe 修改多物品时突然quit不能进mud Bug
			if(!environment(user))
			{
				user->move(START_ROOM);
				startroom = START_ROOM;
				user->set("startroom", START_ROOM);
			}
			// end
			//add by wsw  2005 04 02 清除存款超十万金
			if(user->query("balance")>1000000000) user->set("balance",1000000000);
			if(!wizardp(user) || !user->query("env/invisibility"))
				tell_room(startroom, user->query("name") + "连线进入这个世界。\n", ({user}));
		}

		ip_from="/adm/daemons/ipd"->seek_ip_address(query_ip_number(user));
		if(wizardp(user)) {//By waiwai@2002/05/03 added.
			CHANNEL_D->do_channel( this_object(), "sys",
				sprintf(HIR"%s由 "HIG"%s("+query_ip_port(user)+")"HIR" 连线进入, IP来自："HIG"%s" NOR,user->name()+"("+capitalize(user->query("id")) + ")", 
				query_ip_number(user), ip_from ));  
			note_msg="adm/etc/wizwarn";
			if(file_size(note_msg)>0) 
				write(read_file(note_msg));
			input_to( "to_enter", ob, user  );
			log_file("monitors/wizlogin", sprintf("%s(%s)从(%s)登陆系统. 时间在：(%s)\n",
				user->name(),user->query("id"),query_ip_number(user),
				COLOR_D->clean_color(BJTIME_CMD->chinese_time(1, ctime(time())) ) ) );
		} else
			CHANNEL_D->do_channel( this_object(), "sys",
			sprintf(NOR WHT"%s由 "HIG"%s("+query_ip_port(user)+")"NOR WHT" 连线进入,IP来自："HIG"%s"NOR,user->name()+"("+capitalize(user->query("id")) + ")", 
			query_ip_number(user), ip_from));  

		//By waiwai@2002/05/03 added.
		if(user_count<1) user_count=1; 
		user_count=user->query("login_count");
		user->delete("lijing/mieyao");//避免quit后仍是连续的add.
		user->delete("yuantiangang/mieyao");//避免quit后仍是连续的add.
		//       user->delete("lijing/dan");
		//       user->delete("lijing/zhu");
		//       user->delete("yuantiangang/dan");
		//       user->delete("yuantiangang/zhu");}
		if( !wizardp(user) && user->query("env/invisibility") ) user->delete("env/invisibility");
		write(NOR"\n[1;51m─[0m────────────────────────────────────────[1;51m─[0;31m\n"NOR);
		write(RED"→ "WHT"这是您第 "YEL+chinese_number(user_count)+WHT" 次进入紫藤西游的世界！\n"NOR);
		user_count++;
		user->set("login_count",user_count);
		write(RED"→ "WHT"您的系统权限目前是：" + wiz_lvl +"\n"NOR);
		if (ob->query("last_on")) {
			write(RED"→ "WHT"您上次退线的地址是： " YEL + ob->query("last_from") +"("+ob->query("last_port")+")\n"NOR);
			write(RED"→ "WHT"您目前连线的地址是： " YEL + query_ip_number(user) +"("+query_ip_port(user)+")\n"NOR);
			write(RED"→ "WHT"您上次退线的时间是： " YEL + BJTIME_CMD->chinese_time(1, ctime(ob->query("last_on"))) + "\n"NOR);
		}

		if(file_size("/log/notice")>0){
			write(HIG"     ≡≡≡≡≡≡≡≡≡≡≡≡"HIR"紫藤西游连线通知"HIG"≡≡≡≡≡≡≡≡≡≡≡≡\n"NOR);
			write(CYN"  "+read_file("/log/notice"));
			write(HIG"     ≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡\n"NOR);        }
		//        NEWS_CMD->check_news(user); 
		mbx=ob->query_temp("mbox_ob");
		if (!mbx) {
			mbx=new(MAILBOX_OB);
			mbx->set_owner(ob->query("id"));
		}
		num=mbx->query_new_mail();
		if( num>0 ) {
			write( GRN + "\n千里眼告诉你：有您"
				+chinese_number(num)+
				"封信！请到南城客栈来一趟．．．\n\n" + NOR);
		}
		destruct(mbx);
		ip_from="/adm/daemons/ipd"->seek_ip_address(query_ip_number(user));
		// add by canoe 2001-06-17
		// wiz上线通知
		//	CHANNEL_D->do_channel( this_object(),wizardp(user)?"wiz":"sys",sprintf(NOR WHT "%s由 " HIG "%s" NOR WHT "连线进入,IP来自："HIG"%s"NOR,user->name()+"("+capitalize(user->query("id")) + ")", query_ip_number(user), ip_from)); 

		// over 上线通知
	}

	UPDATE_D->check_user(user, 0);
	TOPTEN_D->topten_checkplayer(user);
	//////////////////////////////////////////////////////
	// Add for QQ上线通知 By Canoe 2001.03.29
	if(mapp(user->query("qq"))
		&& sizeof(user->query("qq"))!=0
		&&!user->query("env/invisibility")) {
			qqfriends = keys(user->query("qq"));
			for(qqnum=0;qqnum<sizeof(qqfriends);qqnum++)
			{
				qqob=find_player(qqfriends[qqnum]);
				tell_object(qqob,BLINK HIG+"紫藤西游信使通知您：你的好友"+user->query("name")+"["+capitalize(user->query("id"))+"]上线了！！\n"+NOR);
			}
	}
	////////////////////////////////////////////////////////

	{
		object caishen;
		if(objectp(caishen=find_object("/d/wiz/npc/caishen"))) {
			caishen->check_one(user);
		}
	}
	// by canoe
	"/cmds/std/news"->check_news(user); // by canoe 修改上线新闻通知 
	// end
	if ("/cmds/usr/pkgame"->query_pk() )
		"/cmds/usr/pkgame"->main(user);
}

varargs void reconnect(object ob, object user, int silent)
{
	object old_link;

	// mon 9/15/98
	old_link=user->query_temp("link_ob");
	if(old_link && old_link!=ob)
		destruct(old_link);

	user->set_temp("link_ob", ob);
	ob->set_temp("body_ob", user);

	// 5/11/98 mon
	user->set_encoding(ob->query_encoding());

	exec(user, ob);

	user->reconnect();
	if( !silent && !user->query("env/invisibility")) {
		tell_room(environment(user), user->query("name") + "重新连线回到这个世界。\n",
			({user}));
		// By canoe ,wiz登陆通告
		CHANNEL_D->do_channel( this_object(),(wizardp(user)?"wiz" :"sys"),
			sprintf("%s由%s重新连线进入。", user->query("name")+"(" + capitalize(user->query("id")) + ")", query_ip_name(user)) );
		// end
	}
	UPDATE_D->check_user(user, 1); // this is for reconnect.
}

int check_legal_id(string id)
{
	int i;
	string *legalid;

	i = strlen(id);

	if( (strlen(id) < 3) || (strlen(id) > 8 ) ) 
	{
		write("对不起，你的英文名字必须是 3 到 8 个英文字母。\n");
		return 0;
	}
	while(i--)
	{
		if( id[i]<'a' || id[i]>'z' )
		{
			write("对不起，你的英文名字只能用英文字母。\n");
			return 0;
		}
	}
	legalid = explode(read_file(BANNED_ID), "\n");
	for(i=0; i<sizeof(legalid); i++)   
	{
		if( id == legalid[i] )   
		{
			write("对不起，这种名字会造成其他人的困扰。\n");
			return 0;
		}
	}
	return 1;
}

int check_legal_name(string name)
{
	int i;

	i = strlen(name);

	// AGENTS.md §15h: strlen() now counts UTF-8 characters, not GBK
	// bytes -- halved from the original byte-count bound (2/12 bytes =
	// 1/6 chars), matching what the message text already promises.
	if( (strlen(name) < 1) || (strlen(name) > 6 ) ) {
		write("对不起，你的中文名字必须是一到六个中文字。\n");
		return 0;
	}
	while(i--) {
		if( name[i]<=' ' ) {
			write("对不起，你的中文名字不能用控制字符。\n");
			return 0;
		}
		// AGENTS.md §15h: the original i%2==0 gate landed on alternating
		// GBK lead-byte offsets (2 bytes/char); every UTF-8 index is
		// already one full character, so check every position.
		if( !is_chinese(name[i..<0]) ) {
			write("对不起，请您用「中文」取名字。\n");
			return 0;
		}
	}
	if( member_array(name, banned_name)!=-1 ) {
		write("对不起，这种名字会造成其他人的困扰。\n");
		return 0;
	}

	return 1;
}

object find_body(string name)
{
	object ob, *body;

	if( objectp(ob = find_player(name)) )
		return ob;
	body = children(USER_OB);
	for(int i=0; i<sizeof(body); i++) {
		ob=body[i];
		if( clonep(ob) && getuid(ob) == name 
			&& ob->query("max_gin")>0 ) return ob;
		//check max_gin to avoid damaged user object.
	}

	return 0;
}

int set_wizlock(int level)
{
	if( wiz_level(this_player(1)) <= level )
		return 0;
	if( geteuid(previous_object()) != ROOT_UID )
		return 0;
	wiz_lock_level = level;
	return 1;
}
// by canoe
int do_counter()
{       
	int number;
	string file;
	file = read_file(FileName);
	// read_file() returns 0 when the runtime-generated counter file is
	// missing (e.g. fresh checkout); sscanf(0, ...) would throw uncaught
	// inside the login banner and kill every connection.
	if (!stringp(file) || sscanf(file,"%d",number) != 1) number = 0;
	number++;
	file=sprintf("%d",number);
	write_file(FileName,file,1);
	return number;
}
int check_legal_password(object ob,string pass)
{
	int i;
	int bigletter=0;
	int smlletter=0;
	string id;
	i = strlen(pass);
	if( strlen(pass) <= 6)   {
		write(WHT"对不起，你的管理密码必须最少七个字符。\n");
		return 0;
	}
	id= ob->query("id");	
	if ( strsrch(id, pass) != -1 || strsrch(pass,id) != -1)
	{
		write(WHT"对不起，你的管理密码和你的英文名字太象了。\n"NOR);
		return 0;
	}

	while(i--) {
		if( pass[i]<='Z' && pass[i] >='A' ) bigletter++;
		if( pass[i]<='z' && pass[i] >='a' ) smlletter++;

	}
	if( bigletter == 0 || smlletter == 0 || 
		bigletter+smlletter == strlen(pass))
	{
		write(WHT"您的管理密码必需包含大写" + RED"和" + WHT"小写英文字母"
			+ RED"和" + WHT"其它特殊符号（数字，标点）。\n"NOR);
		return 0;
	}
	return 1;
	//end
}
