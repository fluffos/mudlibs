inherit ROOM;
void create()
{
set("short", "普通");
set("long", @LONG
普通房间普通房间普通房间
普通房间普通房间普通房间
普通房间普通房间普通房间
普通房间普通房间普通房间
普通房间普通房间普通房间

LONG
);
        set("exits", ([
"west" : "/p/residence/pujing1047026483.lpc",
]));
set("objects", ([
        "/u/pujing/npc/bangzhong":1,
       ]) );
        set("owner", "bigtie7001");
         set("banghui", "〖流氓天下会〗");
        set("valid_startroom",1);
        set("no_fight",1);

setup();
}
void init()
{
        add_action("do_invite","yqfriend");
}
int valid_enter(object me)
{
      //  int flag;
         if((string)me->query("banghui") != (string)query("banghui")
        &&(string)query("invite") != (string)me->query("id")
        &&(string)me->query("id") != (string)query("owner"))
        return 1;       

}
int do_invite(string arg)
{
        object me;
        me= this_player();
        if((string)me->query("id") != (string)query("owner"))
        return 0;
        set("invite",arg);
        write("你邀请"+arg+"来你的房间。\n");
        return 1;
}

