inherit ROOM;
void create() {
  set("short", "帮会总坛");
  set("long", @LONG
浴兰汤兮沐芳，华采衣兮若英①；
灵连蜷兮既留，烂昭昭兮未央；
謇将『澹』②兮寿宫，与日月兮齐光；
龙驾兮帝服，聊翱游兮周章；
灵皇皇兮既降③，『飙』④远举兮云中；
览冀洲兮有余，横四海兮焉穷；
思夫⑤君兮太息，极劳心兮忡忡；

LONG
  );
  set("exits", ([
    "east": "/p/residence/advance1101995931",
    "west": "/p/residence/advance1101995835",
    "north": "/p/residence/advance1101995726",
    "westup": "/p/residence/advance1101995435.lpc",
  ]));
  set("owner", "bigtie7001");
  set("banghui", "中华五千年");
  set("valid_startroom", 1);
  set("no_fight", 1);

  setup();
}
