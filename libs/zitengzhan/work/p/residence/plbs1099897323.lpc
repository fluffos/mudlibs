#include <ansi.h>
inherit ROOM;
void create()
{
set("short", "♀菩提の树下♂");
set("long", @LONG
悟真盘龙失败以后，并没有打击盘龙把式的信心；
他经过较长时间的努力，终于创立了自己的帮派，
同时有许多为求真盘龙而不悔的高手投奔其门下，
大家同心协力，以维护大唐和平为己任，
渐渐“♀菩提の树下♂”成为大唐声望最大的门派！

LONG
);
        set("exits", ([
"eastdown" : "/d/eastway/guangchang.lpc",
]));
set("objects", ([
       ]) );
        set("owner", "bigtie7001");
        set("banghui", "♀菩提の树下♂");

setup();
}

void init()
  {
     object ob=this_player();
if((string)ob->query("banghui")!=environment(ob)->query("banghui"))  {
     message("vision",YEL"【"MAG"帮会消息"YEL"】顺风耳："+YEL"" + ob->query("name") + "于" + NATURE_D->game_time() + "企图闯入" + environment(ob)->query("banghui") + "总坛,被扔了出来！\n"NOR,users());
message_vision(HIR"突然从里面冲出来几个守卫拖着$N就走,$N象小鸡一样,被扔了出来。\n"NOR,this_player());
       ob->move("/d/city/kezhan");
    }
      else return;
  }
