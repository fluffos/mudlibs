#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "成功之路");
  set("long", @LONG
成功之路就在脚下，快进来吧。
成功之路就在脚下，快进来吧。
成功之路就在脚下，快进来吧。
成功之路就在脚下，快进来吧。
成功之路就在脚下，快进来吧。
成功之路就在脚下，快进来吧。
成功之路就在脚下，快进来吧。
成功之路就在脚下，快进来吧。
成功之路就在脚下，快进来吧。

LONG
  );
  set("exits", ([
    "southwest": "/d/eastway/guangchang1.lpc",
  ]));
  set("objects", ([
  ]));
  set("owner", "bigtie7001");
  set("banghui", "秋天的童话");

  setup();
}

void init() {
  object ob = this_player();
  if ((string)ob->query("banghui") != environment(ob)->query("banghui")) {
    message(
      "vision",
      YEL "【" MAG "帮会消息" YEL "】顺风耳：" + YEL "" + ob->query("name") + "于" + NATURE_D->game_time() + "企图闯入" + environment(ob)->query("banghui") + "总坛,被扔了出来！\n" NOR,
      users()
    );
    message_vision(HIR "突然从里面冲出来几个守卫拖着$N就走,$N象小鸡一样,被扔了出来。\n" NOR, this_player());
    ob->move("/d/city/kezhan");
  } else return;
}
