// a skeleton for user rooms
//Last Modified By PKYOU@DHXY 2002/05/14
#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "逍遥派灵鸠宫正门");
  set("long", @LONG
逍遥派灵鸠洞为本派弟子修炼之场所：
自从帮主巫行云创建逍遥派以来，
本派弟子勤休武功，使得逍遥派已经成为大唐武林第一大门派。
帮主巫行云原名田小辫儿，出山于昆仑山月宫，曾经为大唐天下第一美女
昆仑山月宫第一人！
后从师大唐巫师筱勰，练就一身奇世武功称霸一方。
其门下首徒龙猫是曾经东海龙神，大唐龙宫开山鼻祖，龙宫后世弟子所仰慕！
得意门徒天下有血武功高强世间少有。
忘我后世弟子勤于修行，成就逍遥派明日辉煌！
开山师祖巫行云二零零四年十一月题于逍遥派总坛门匾之上。

LONG
  );
  set("exits", ([
    "southup": "/p/residence/ttpp1099784818",
    "northdown": "/d/eastway/guangchang.lpc",
  ]));
  set("objects", ([
  ]));
  set("owner", "bigtie7001");
  set("banghui", "逍遥派");

  setup();
}

void init() {
  object ob = this_player();
  if ((string)ob->query("banghui") != environment(ob)->query("banghui")) {
    message(
      "vision",
      YEL "【" MAG "帮会消息" YEL "】顺风耳：" + YEL "" + ob->query("name") + "于" + NATURE_D->game_time() + "企图闯入" + environment(ob)->query("banghui") + "总坛,被扔了出来！\n" NOR,
      users()
    );
    message_vision(HIR "突然从里面冲出来几个守卫拖着$N就走,$N象小鸡一样,被扔了出来。\n" NOR, this_player());
    ob->move("/d/city/kezhan");
  } else return;
}
