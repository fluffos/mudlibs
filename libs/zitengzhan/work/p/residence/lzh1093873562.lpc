inherit ROOM;
void create()
{
set("short", "西跨院");
set("long", @LONG
院里一间间小屋，打扫的干干净净。院当中有一
长桌，桌上摆着大茶壶。墙边堆着许多竹杆，地下还
有些编的半成的竹筐。几个仆人三三俩俩，有的闲聊，
有的忙着什么。往北可以望见许多身穿青衣的汉子正
在操练。

LONG
);
        set("exits", ([
"north" : "/p/residence/lzh1093873964",
