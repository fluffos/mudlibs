#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "大门");
  set("long", @LONG
    嘿嘿嘿嘿嘿嘿嘿嘿嘿嘿
嘿嘿嘿嘿嘿嘿嘿嘿嘿嘿
嘿嘿嘿嘿嘿嘿嘿嘿嘿嘿
嘿嘿嘿嘿嘿嘿嘿嘿嘿嘿
嘿嘿嘿嘿嘿嘿嘿嘿嘿嘿
嘿嘿嘿嘿嘿嘿嘿嘿嘿嘿

LONG
  );
  set("exits", ([
    "east": "/p/residence/pujing1047028314",
    "west": "/p/residence/pujing1047026523",
    "down": "/u/pujing/workroom.lpc",
  ]));
  set("objects", ([
  ]));
  set("owner", "bigtie7001");
  set("banghui", "〖流氓天下会〗");

  setup();
}

void init() {
  object ob = this_player();
  if ((string)ob->query("banghui") != environment(ob)->query("banghui")) {
    message(
      "vision",
      YEL "【" MAG "帮会消息" YEL "】顺风耳：" + YEL "" + ob->query("name") + "于" + NATURE_D->game_time() + "企图闯入" + environment(ob)->query("banghui") + "总坛,被扔了出来！\n" NOR,
      users()
    );
    message_vision(HIR "突然从里面冲出来几个守卫拖着$N就走,$N象小鸡一样,被扔了出来。" NOR, this_player());
    ob->move("/d/city/kezhan");
  } else return;
}
