inherit ROOM;
void create()
{
set("short", "逍遥派灵鸠洞总坛");
set("long", @LONG
逍遥派灵鸠洞为本派弟子修炼之场所：
自从帮主巫行云创建逍遥派以来，
本派弟子勤休武功，使得逍遥派已经成为大唐武林第一大门派。
帮主巫行云原名田小辫儿，出山于昆仑山月宫，曾经为大唐天下第一美女
昆仑山月宫第一人！
后从师大唐巫师筱勰，练就一身奇世武功称霸一方。
其门下首徒龙猫是曾经东海龙神，大唐龙宫开山鼻祖，龙宫后世弟子所仰慕！
得意门徒天下有血武功高强世间少有。
忘我后世弟子勤于修行，成就逍遥派明日辉煌！
开山师祖巫行云二零零四年十一月题于逍遥派总坛门匾之上。

LONG
);
        set("exits", ([
"south" : "/p/residence/ttpp1099788985",
"southup" : "/p/residence/ttpp1099785391",
"east" : "/p/residence/ttpp1099785271",
"west" : "/p/residence/ttpp1099785033",
"northdown" : "/p/residence/ttpp1099784702.lpc",
]));
        set("owner", "bigtie7001");
         set("banghui", "逍遥派");
        set("valid_startroom",1);
        set("no_fight",1);

setup();
}

