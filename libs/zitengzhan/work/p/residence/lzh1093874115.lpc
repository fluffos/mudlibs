inherit ROOM;
void create() {
  set("short", "萍水池");
  set("long", @LONG
池是褡裢形，有座桥高跨于池水之上，气势非凡。桥身以汉
白玉造就，既美观又坚固。桥下池水碧玉般清澈见底，汩汩湍湍，
时有游鱼跃起。显然，水是山溪汇聚而蓄，透着股秀气与灵气。

LONG
  );
  set("exits", ([
    "northup": "/p/residence/lzh1093875528",
    "south": "/p/residence/lzh1093870851.lpc",
  ]));
  set("owner", "bigtie7001");
  set("banghui", "诸神の黄昏");
  set("valid_startroom", 1);
  set("no_fight", 1);

  setup();
}
