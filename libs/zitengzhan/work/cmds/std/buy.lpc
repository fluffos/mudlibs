// buy.c
#define FAMILYD "/adm/daemons/familyd"
#define SHILI_D "/adm/daemons/shili"

inherit F_CLEAN_UP;

int main(object me, string arg) {
  string item, targ;
  object ob, owner, card;
  int price, afford, p, amount;
  string fname, opfaname, faname = me->query("family/family_name");
  string *slist;

  if ((card = present("card", me)) && card->query("stats") == "on") p = 1;
  else p = 0;
  if (this_player()->is_busy())
    return notify_fail("你现在正忙着呢。\n");

  if (!arg || sscanf(arg, "%s from %s", item, targ) != 2)
    return notify_fail("指令格式：buy <某物> from <某人> 或 buy <某物> from <某人> for <数量>\n");

  if (sscanf(targ, "%s for %d", targ, amount) != 2)
    amount = 1;

  if (amount <= 0)
    return notify_fail("你要买多少个？\n");
  if (amount > 100)
    return notify_fail("一次最多买100个！\n");



  if (!objectp(owner = present(targ, environment(me))))
    return notify_fail("你要跟谁买东西？\n");

  if (userp(owner)) {
    message_vision("$N想向$n购买「" + item + "」。\n", me, owner);
    notify_fail("对方好像不愿意跟你交易。\n");
    return 1;
  }

  if ((price = owner->buy_object(me, item)) == -1) return 1;
  if (price < 1) return 0;

  price = price * amount;

  fname = file_name(environment(me));
  slist = explode(fname, "/");
  opfaname = SHILI_D->query_family(slist[sizeof(slist) - 2]);

  if ((opfaname != "") && faname && (FAMILYD->family_relation(opfaname, faname) == -1)) {
    message_vision(
      "$n对$N说，" + SHILI_D->query_master(opfaname) + "说了，卖给贵门派弟子的东西，价格都要翻倍。\n",
      me,
      owner
    );
    price = price * 2;
  }

  if (afford = me->can_afford(price) || p == 1) {
    if (p == 1 && me->query("balance") - price < 0) return notify_fail("你帐户里的钱不够。\n");
    if (afford == 2 && p != 1)
      return notify_fail("你没有足够的零钱，而银票又没人找得开。\n");

    if (owner->complete_trade(me, item, amount)) {
      if (p != 1) {
        me->pay_money(price);
        return 1;
      } else {
        me->set("balance", me->query("balance") - price);
        return 1;
      }
      return 0;
    }
  } else
    return notify_fail("你的钱不够。\n");
}

int help(object me) {
  write(@HELP
指令格式: buy <something> from <someone>

这一指令让你可以从某些人身上买到物品。
HELP
  );
  return 1;
}
