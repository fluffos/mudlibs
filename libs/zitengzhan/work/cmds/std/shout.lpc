// shout.c
#include <ansi.h>
#include <localtime.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  string *ids = ({ "mem", "lthc" });
  mixed *lt;

  if (!wizardp(me)) {
    if (member_array(getuid(me), ids) != -1) {  //大唐名人堂
      if (!arg) return notify_fail("你想要大叫什么？\n");
      lt = localtime(time());
      if (lt[LT_MDAY] != me->query("shout/mday")) {
        me->set("shout/mday", lt[LT_MDAY]);
        me->set("shout/number", 10);
      } else me->add("shout/number", -1);
      if (me->query("shout/number") < 0) return notify_fail("你喉咙已经喊哑了，歇歇吧。\n");
      shout("\n" + HIB + BLINK + "【" + HIY + "大唐名人堂" + HIB + "】" + NOR + HIW + me->name() + "纵声长啸：" + arg + "\n\n" NOR);
      write("\n" + HIB + BLINK + "【" + HIY + "大唐名人堂" + HIB + "】" + NOR + HIW + "你纵声长啸：" + arg + "\n\n" NOR);
      write("你今天还可以长啸" + HIR + chinese_number(me->query("shout/number")) + NOR + "次。\n");
      return 1;
    }
    return notify_fail("目前暂不开放玩家 shout。\n");
  }

  if (!arg) return notify_fail("你想要大叫什么？\n");
  shout("\n" + HIB + BLINK + "【" + HIY + "巫师在线" + HIB + "】" + NOR + HIW + me->name() + "纵声长啸：" + arg + "\n\n" NOR);
  write("\n" + HIB + BLINK + "【" + HIY + "巫师在线" + HIB + "】" + NOR + HIW + "你纵声长啸：" + arg + "\n\n" NOR);
  return 1;
}
int help(object me) {
  write(@HELP
指令格式 : shout <讯息>
 
这个指令让你将 <讯息> 传送出去, 所有正在游戏中的人都
会听见你的话.
 
see also : tune
HELP
  );
  return 1;
}
