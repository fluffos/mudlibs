// go.c
inherit F_CLEAN_UP;
#include <ansi.h>
#include "/cmds/std/valid_move.h";
string ridemsg, mout, min, dir, msg, str, str1, ridename, mename;

mapping default_dirs = ([
	"north":                "北",
	"south":                "南",
	"east":                 "东",
	"west":                 "西",
	"northup":              "北边",
	"southup":              "南边",
	"eastup":               "东边",
	"westup":               "西边",
	"northdown":            "北边",
	"southdown":            "南边",
	"eastdown":             "东边",
	"westdown":             "西边",
	"northeast":            "东北",
	"northwest":            "西北",
	"southeast":            "东南",
	"southwest":            "西南",
	"up":                   "上",
	"down":                 "下",
	"out":                  "外",
	"enter":                "里",
	"left":                 "左",
	"right":                "右",
]);

void create() { seteuid(getuid()); }

// follow will have silent=2, so as to reduce the CPU load.
int main(object me, string arg, int silent)
{
	mixed dest;
	object env, obj, ridee;
	mapping exit;
	int valid,n;
	object ob,*excludes;

	if( !arg ) return notify_fail("你要往哪个方向走？\n");

	if(!valid_move(me)) return 0;

	env = environment(me);
	if(!env) return notify_fail("你哪里也去不了。\n");

	if( !mapp(exit = env->query("exits")) || !exit[arg] ||  undefinedp(exit[arg]) ) {
		if( query_verb()=="go")
			return notify_fail("这个方向没有出路。\n");
		else
			return 0;
	}

	dest = exit[arg];

	if (dest && objectp(dest))
		obj = dest;
	else if( !(obj = load_object(dest)) )
		return notify_fail("你要去的区域还没有连通。\n");
	else if( !(obj = find_object(dest)) )
		return notify_fail("无法移动。\n");
	if(me->query("taskguai2")&&obj->query("short")=="奇门遁甲阵")
		//for task2 难度四 huarong 2004/8
		return 0;

	valid=(int)env->valid_leave(me, arg);
	if( !valid ) return 0;
	// valid>1 also indicates fail, but return 1 here, not 0.
	if(valid>1) return 1;

	if( !undefinedp(default_dirs[arg]) )
		dir = default_dirs[arg];
	else
		dir = arg;

	// snowcat 12/20/97
	if (ridee = me->ride())
		ridemsg = ridee->query("ride/msg")+"着"+ridee->name();
	else  
		ridemsg = "";

	if(ridee && !valid_move(ridee)) 
		return notify_fail("你的座骑走动不了。\n");

	if(me->is_ghost()&&domain_file(base_name(environment(me)))!="death")
	{              
		write(BLU"突然间阴风阵阵，你耳边响起一阵空洞而又阴森的声音:‘回来哟，回来哟!’\n"NOR);
		write(HIW"一阵白雾将你裹了起来，你又回到了鬼门关\n"NOR);
		me->move("/d/death/gate");
		return 1;
	}

	//以下是关于白天和黑夜显示的区别

	n=NATURE_D->night();


	if( me->is_fighting() ) 
	{
		str="跌跌撞撞地跑了过来，模样有些狼狈。\n";
		str1="往" + dir + env->query("short") +"落荒而逃了。\n";
	}
	else
	{
		str="走了过来。\n";
		str1="往" + dir + "离开。\n";
	}

	if ( me->query("race") == "野兽")
	{
		mout = me->name() + "呼地往" + dir + "一窜就消失了。\n";
		min = me->name() + "从" + dir + env->query("short") + "呼地窜了出来，警惕地四周张望着。\n";
	}
	else
	{
		if(n) 
			mename="一条黑影";
		else
			mename=me->query("name");
		if (ridee = me->ride())
		{
			if(n) 
				ridename="宠物宝宝";
			else
				ridename=ridee->name();
			if( ridee && ridee->query("bird") )
			{
				str="骑着"+ridename+"从"+env->query("short") +"飞了过来。\n";
				str1="骑着"+ridename+"往" + dir  + "飞去。\n";
			}
			else
			{
				str="骑着"+ridename+"从"+env->query("short") +"一路疾驰而来。\n";
				str1="骑着"+ridename+"往" + dir + "疾驰而去。\n";
			}

		}
		else
		{
			str="从"+env->query("short") +"走了过来。\n";
			str1="往" + dir + "离开。\n";
		}
		mout = str1;
		min = str;                
	}
	//////////////////////白天黑夜限定结束

	if( !wizardp(me) || !me->query("env/invisibility") )
	{
		// nanf，for set brief_go
		excludes = ({me});
/*
		if(userp(me) && environment(me)) 
		{
			foreach (ob in all_inventory(environment(me)))
			{
				if(ob->query("env/brief_go"))
					excludes += ({ ob });
			}
		}
*/
		if (environment(me) && environment(me)->query("no_look"))
			tell_room(environment(me),"一个模糊的影子" +  mout, excludes );
		else
			tell_room(environment(me), mename + mout, excludes );
	}
	if( (! ridee || ridee->move(obj)) && me->move(obj, silent) ) 
	{
		me->remove_all_enemy();
		if( !wizardp(me) || !me->query("env/invisibility") ) 
		{
			// nanf，for set brief_go
			excludes = ({me});
/*
			if(userp(me) && environment(me)) 
			{
				foreach (ob in all_inventory(environment(me)))
				{
					if(ob->query("env/brief_go"))
						excludes += ({ ob });
				}
			}
*/
			if (environment(me) && environment(me)->query("no_look"))
				tell_room(environment(me), "一个模糊的影子"+min, excludes );
			else
				tell_room(environment(me), mename + min, excludes );
		}
		me->set_temp("pending", 0);
		// added by snowcat, to fix the bug of recursive move of mutual follow + move to same room 
		if (env != obj)
			all_inventory(env)->follow_me(me, arg);
		/////////////杀人犯通缉
		if (userp(me) && me->query_condition("no_pk_time") && me->query_temp("rumor_time")+10<time() 
			&& MISC_D->find_place(environment(me))!=me->query_temp("last_place"))
		{ 
			me->set_temp("last_place",MISC_D->find_place(environment(me)));
			msg="听说官府通缉杀人犯"+HIW+me->query("name")+HIM+"最近在"+HIC+me->query_temp("last_place")+HIM+"附近出没。\n";
			CHANNEL_D->do_channel(this_object(),"rumor",msg);
			me->set_temp("rumor_time",time());
		}                       
		return 1;
	}

	return 0;
}

void do_flee(object me)
{
	mapping exits;
	string *directions;

	if( !environment(me) || !living(me) ) return;
	exits = environment(me)->query("exits");
	if( !mapp(exits) || !sizeof(exits) ) return;
	directions = keys(exits);
	if (environment(me) && environment(me)->query("no_flee")) return;
	tell_object(me, "看来该找机会逃跑了．．．\n");
	if( me->query_temp("no_move") ) {
		tell_object (me, "可你被定住了，逃不掉！\n");
		return;
	}

	if( random(me->query_skill("dodge")/10 + me->query("kar")) < 10 ) {
		tell_object(me, "你逃跑失败。\n");
		return;
	}

	main(me, directions[random(sizeof(directions))], 0);
}

int help(object me)
{
        write(@HELP
指令格式 : go <方向>
 
让你往指定的方向移动。
 
HELP
    );
    return 1;
}

