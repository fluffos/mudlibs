
inherit F_CLEAN_UP;

#include <ansi.h>

int telling1 (object who);
int telling2 (object who);

string name;
mapping obstacles=([
        "baiyang"    :   "白羊宫",
        "jinniu"     :   "金牛宫",
        "shuangzi"   :   "双子宫",
        "juxie"      :   "巨蟹宫",
        "shizi"      :   "狮子宫",
        "shinu"      :   "处女宫",
        "tiancheng"   :   "天平宫",
        "renma"      :   "人马宫",
        "tianxie"    :   "天蝎宫",
        "mojie"   :   "山羊宫",
        "baoping"    :   "水瓶宫",
        "shuangyu"   :   "双鱼宫",
]);
int main(object me, string arg)
{
        object ob;

        if( !arg ) {
                ob = me;
                name = "你";
        } else if (wizardp (me)) {
                ob = find_player(arg);
                if(!ob) ob = find_living(arg);
        
                if(!ob) ob = LOGIN_D->find_body(arg);

                if(!ob || !me->visible(ob)) return notify_fail("没有这个人。\n");

                name = ob->query("name");
        } else
                return 0;

        telling1(ob);
        telling2(ob);

        return 1;
}

int help()
{
        write(@TEXT
指令格式：12gong <某人>

显示某人十二宫过关的资料。

TEXT
        );
        return 1;
}

int telling1 (object who)
{
  int size = sizeof(obstacles);
  string *names = keys(obstacles);
  string *values = values(obstacles);
  string *strs = allocate (size);
  int nb = 0;
  int i;

  for (i = 0; i < size; i++)
  {
    strs[i] = "none";
  }

  for (i = 0; i < size; i++)
  {
    if (who->query("12gong/"+names[i])=="done")
    {
      strs[nb] = values[i];
      nb++;
    }
  }

  if (nb == 0)
  {
    write (name+"尚未开始十二宫过关。\n");
  }
  else
  {
    write (HIY+name+HIY"黄道十二宫已过了"+chinese_number(nb)+"宫：\n"NOR);
    for (i = 0; i < nb; i++)
    {
      write ("    "+strs[i]+"\n");
    }
  }
  return 1;
}

int telling2 (object who)
{
  int size = sizeof(obstacles);
  string *names = keys(obstacles);
  string *values = values(obstacles);
  string *strs = allocate (size);
  int nb = 0;
  int i;

  for (i = 0; i < size; i++)
  {
    strs[i] = "none";
  }

  for (i = 0; i < size; i++)
  {
    if (who->query("12gong/"+names[i])!="done")
    {
      strs[nb] = values[i];
      nb++;
    }
  }

  if (nb == 0)
  {
    write (name+"成功救出女神雅典娜！\n");
  }
  else
  {
    write (HIY+name+ "黄道十二宫还须过"+chinese_number(nb)+"宫：\n"NOR);
    for (i = 0; i < nb; i++)
    {
      write ("    "+strs[i]+"\n");
    }
  }
  return 1;
}


