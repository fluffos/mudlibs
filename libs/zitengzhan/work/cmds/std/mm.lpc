inherit F_CLEAN_UP;

#include <ansi.h>
#include <maze.h>

int main(object me, string arg)
{
    int x,y;
    class maze_settings settings=new(class maze_settings);
    if(!arg || sscanf(arg, "%d %d", x, y) != 2)
        return 0;
    settings->width = x;
    settings->height = y;
    settings->maze_name = HIY"试验副本"NOR;
    settings->short_desc = "试验副本";
    settings->long_desc = "\n四周植物繁茂，古树丛生，上不见天，下不接地。\n";
    settings->life_time = time()+600;
    settings->initx = -1;
    settings->inity = 1;
    settings->entry_dir="north";
    settings->entry_pos=-1;
    settings->exit_dir="east";
    settings->exit_pos=2;
    settings->exit_link="/d/city/center";
    settings->boss = "/d/city/npc/libai.lpc";
    settings->boss_since = 2;
    MAZE_D->new_maze(this_player(),settings);
    return 1;
}


