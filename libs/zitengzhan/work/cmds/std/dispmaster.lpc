// dispmaster.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  int size;
  object *t;
  string *msg;
  string id, yid;
  object pmob, ob;
  mapping show;

  if (!arg)
    return notify_fail("你想和谁解除师徒关系？\n");

  id = me->query("id");
  yid = arg;

  pmob = new("/u/nanf/npc/pmaster.lpc");
  pmob->restore();

  if (yid == me->query("pmasterid")) {
    write("你觉得" + me->query("pmastername") + "已经不再适合做你师傅了，决定单飞。\n");
    me->delete_temp("last_channel_msg");
    CHANNEL_D->do_channel(
      me,
      "chat",
      HIY "我欲畅游天地，不愿再遭此束缚，从此我已不再是" + me->query("pmastername") + "的师门弟子。\n" NOR
    );
    me->delete("pmasterid");
    me->delete("pmastername");
    // ob->delete("pdizi/"+id);

    pmob->set(yid + "/dismissed/" + id + "/id", id);
    pmob->set(yid + "/dismissed/" + id + "/name", me->query("name"));
    pmob->set(yid + "/dismissed/" + id + "/time", time());
    pmob->save();
  } else if (me->query("pdizi/" + yid)) {
    write("你觉得" + me->query("pdizi/" + yid) + "已经不再适合做你徒弟了，决定解除与他的师徒关系。\n");
    me->delete_temp("last_channel_msg");
    CHANNEL_D->do_channel(
      me,
      "chat",
      HIY "罢了，罢了！" + me->query("pdizi/" + yid) + "从此非我门下弟子，所作所为皆与我无关，与我无关也。\n" NOR
    );
    //	ob->delete("pmasterid");
    //	ob->delete("pmastername");
    pmob->set(id + "/dismissed/" + yid + "/id", yid);
    pmob->set(id + "/dismissed/" + yid + "/name", me->query("pdizi/" + yid));
    pmob->set(id + "/dismissed/" + yid + "/time", time());
    pmob->save();
    me->delete("pdizi/" + yid);
    if (!sizeof(me->query("pdizi")))
      me->delete("pdizi");

  } else if (pmob->query(id + "/undercheck/" + yid)) {
    write("你不想做" + pmob->query(id + "/undercheck/" + yid + "/name") + "的师傅了，撤销了递交的申请。\n");
    pmob->delete(id + "/undercheck/" + yid);
    if (!sizeof(pmob->query(id + "/undercheck")))
      pmob->delete(id + "/undercheck");
    pmob->save();
  } else if (pmob->query(yid + "/undercheck/" + id)) {
    write("你不想做" + pmob->query(yid + "/undercheck/" + id + "/name") + "的徒弟了，撤销了递交的申请。\n");
    pmob->delete(yid + "/undercheck/" + id);
    if (!sizeof(pmob->query(yid + "/undercheck")))
      pmob->delete(yid + "/undercheck");
    pmob->save();
  } else {
    write("你们不是师徒关系。\n");
  }
  destruct(pmob);
  return 1;
}

int help(object me) {
  write(@HELP

dispmaster  <某人> - 解除双方的师徒关系或撤销申请。

师傅可以dispmaster徒弟，解除师徒关系
徒弟也可以dispmaster师傅，解除师徒关系
若处于申请阶段，dispmaster指令可以用来解除申请，见help pmaster

HELP
  );
  return 1;
}
