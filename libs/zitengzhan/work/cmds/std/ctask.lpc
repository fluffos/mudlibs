//edit for 难度四 huarong 2003.7
// time.c
#include <ansi.h>
#include <localtime.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  object ob;

  mixed *lt;
  int time;

  time = time();
  lt = localtime(time);


  seteuid(getuid(me));
  if (!arg) ob = me;
  else if (wizardp(me)) {
    ob = present(arg, environment(me));
    if (!ob) ob = find_player(arg);
    if (!ob) ob = find_living(arg);
    if (!ob) return notify_fail("您要察看谁的状态？\n");
  } else return notify_fail("只有巫师才可以察看别人的状态。\n");

  if (lt[LT_MDAY] != ob->query("rulaitask/whichdate")) {
    write("你今天尚未接过如来佛任何任务。\n");
    return 1;
  }


  if (ob->query("rulaitask/accomplish")) {
    write("你刚刚完成了一个难度" + chinese_number(ob->query("rulaitask/level")) + "的" + ob->query("rulaitask/kind") + "妖任务。\n");
    write("你今天已经拿了" + chinese_number(ob->query("rulaitask/oneday")) + "个任务，成功完成了" + chinese_number(ob->query("rulaitask/finish")) + "个。\n");
    return 1;
  }

  else if (ob->query("rulaitask/daccomplish")) {
    write("你刚刚完成了一个难度" + HIY + chinese_number(ob->query("rulaitask/level")) + NOR + "的" + HIY + ob->query("rulaitask/kind") + NOR + "的任务。\n");
    write("你今天已经拿了" + chinese_number(ob->query("rulaitask/doneday")) + "个高难度任务，成功完成了" + chinese_number(ob->query("rulaitask/dfinish")) + "个。\n");
    return 1;
  }

  else if (ob->query("rulaitask/fail")) {
    write("你任务失败了。\n");
    write("你今天已经拿了" + chinese_number(ob->query("rulaitask/oneday")) + "个任务，成功完成了" + chinese_number(ob->query("rulaitask/finish")) + "个。\n");
    return 1;
  }

  else if (ob->query("rulaitask/dfail")) {
    write("你的高难度任务失败了。\n");
    write("你今天已经拿了" + chinese_number(ob->query("rulaitask/doneday")) + "个高难度任务，成功完成了" + chinese_number(ob->query("rulaitask/dfinish")) + "个。\n");
    return 1;
  }

  else if (!ob->query("rulaitask/get") && !ob->query("rulaitask/dget")) {
    write("你没有任务在身。\n");
    write("你今天已经拿了" + chinese_number(ob->query("rulaitask/oneday")) + "个任务，成功完成了" + chinese_number(ob->query("rulaitask/finish")) + "个。\n");
    write("你今天已经拿了" + chinese_number(ob->query("rulaitask/doneday")) + "个高难度任务，成功完成了" + chinese_number(ob->query("rulaitask/dfinish")) + "个。\n");
    return 1;
  }

  else if (!ob->query("rulaitask/guai") && !ob->query("rulaitask/dguai")) {
    write("如来佛已经出手收了你的妖怪。\n");
    write("你今天已经拿了" + chinese_number(ob->query("rulaitask/oneday")) + "个任务，成功完成了" + chinese_number(ob->query("rulaitask/finish")) + "个。\n");
    write("你今天已经拿了" + chinese_number(ob->query("rulaitask/doneday")) + "个高难度任务，成功完成了" + chinese_number(ob->query("rulaitask/dfinish")) + "个。\n");
    return 1;
  }

  if (ob->query("rulaitask/get"))
    write("你现在的任务是" + ob->query("rulaitask/kind") + "妖," + ob->query("rulaitask/where") + "。\n");
  if (ob->query("rulaitask/dget"))
    write("你现在的任务是" + HIY + ob->query("rulaitask/kind") + NOR + "——" + ob->query("rulaitask/where") + "。\n");
  write("难度：" + chinese_number(ob->query("rulaitask/level")) + "\n");
  if (ob->query("rulaitask/oneday"))
    write("你今天已经拿了" + chinese_number(ob->query("rulaitask/oneday")) + "个任务，成功完成了" + chinese_number(ob->query("rulaitask/finish")) + "个。\n");
  if (ob->query("rulaitask/doneday"))
    write("你今天已经拿了" + chinese_number(ob->query("rulaitask/doneday")) + "个高难度任务，成功完成了" + chinese_number(ob->query("rulaitask/dfinish")) + "个。\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式: ctask

这个指令让你知道你现在的如来任务。

HELP
  );
  return 1;
}
