#include <ansi.h>
#include <combat.h>
#include "valid_kill.h";
inherit SSERVER;
//inherit F_CLEAN_UP;
inherit F_DBASE;


int main(object me, string arg)
{
 string msg , who, weaponid;
int  damage;
 object weapon, target;

  if(me->query("family/family_name")!="大雪山")
 return notify_fail("不是大雪山弟子不能使用驭器术！\n");

	if(environment(me)->query("no_fight") || 
           environment(me)->query("no_magic") )
              return notify_fail("此处无法施展驭器术！\n");

if(me->query_skill("ningxie-force",1) < 150)
 return notify_fail("你的冰谷凝血功太低！\n");

if(me->query("force")<1000)
 return notify_fail("你的内力太少了！\n");

if( time()-(int)me->query_temp("yuqi_end") < 60 )
  return notify_fail("你刚运用过驭器术，真气还未平复！\n");

if( !arg || arg == "")   
 return notify_fail("指令格式：yuqi <兵器> on <某人>！\n");

if( sscanf(arg, "%s on %s", weaponid, who) != 2)  
 return notify_fail("指令格式：yuqi <兵器> on <某人>！\n");

if(!objectp(weapon=present(weaponid, me)) ) 
        return notify_fail("你身上有这件兵器吗？。\n");

if(!weapon->query("weapon_prop") )
        return notify_fail("你身上有这件兵器吗？。\n");
 
target = find_player(who);
if(!target) target = find_living(who);
if(!target) target = LOGIN_D->find_body(who);
if(!target)
       return notify_fail("找不到你要攻击的生物。\n");
if(environment(target)==environment(me))
       return notify_fail("敌人不就在你身边吗？还费力气驭器干嘛。\n");

	if(environment(me)->query("no_fight") || 
           environment(me)->query("no_magic") )
              return notify_fail("此处无法施展驭器术！\n");


msg = HIW "$N你运起冰谷凝血功，全身真气澎湃！只听$N大喝一声：起!!!\n" NOR;
msg += HIW "只见 "+weapon->query("name")+" "+HIW+"嗖的一声！化成一颗流星飞向远处。\n" NOR;
    tell_object (target,HIC"  你似乎有种不祥的预感！不好！有危险正在临近！！\n"NOR);
tell_object (target,HIC"  掐指一算！原来是"+me->query("name")+""+HIC+"在偷袭你！！\n"NOR);
        message_vision(msg, me);
      me->add("force",-1000);
      me->set_temp("yuqi_end",time());
      me->start_busy(50);
      weapon->unequip();
      weapon->move("/d/wiz/blackroom");
 call_out("attack1",5,me,target,weapon);
 return 1;
 }

void attack1(object me,object target,object weapon)
 {
 message("channel:chat",HIY"       只见一道璀璨的流星划过天际，一闪而逝！\n"NOR,users());
 //remove_call_out("attack1");
 call_out("attack2",10,me,target,weapon);
//return 1;
 }

void attack2(object me,object target,object weapon)
 {
string msg;
int skill,tskill,type,damage,i,j,myexp,texp,myforce,tforce;
 //remove_call_out("attack2");
if(!target && !me)
           {
 message("channel:chat",HIY"       一颗流星突然出现，现出原型，原来是一把"+weapon->query("name")+"！\n"NOR,users());
 message("channel:chat",HIY"       "+weapon->query("name")+" "+HIY+"似乎失去了控制，掉了下去，也不知落到了何方！\n"NOR,users());
 destruct(weapon);
 return 0;
           }
if(!me && target)
           {
 msg = HIW"    只见虚空之中突然出现一把"+weapon->query("name")+" "+HIW+"雷霆霹雳般的向$N斩来。\n" NOR;
 msg += HIW"    突然之间"+weapon->query("name")+" "+HIW+"悲鸣了一声，哐当一声掉在地上，挣扎了几下没反应了。\n"NOR;
        message_vision(msg, target);
        weapon->move(environment(target));
 return 0;
           }
if(!target && me ||!living(target)||environment(target)->query("no_fight") || environment(target)->query("no_magic") )
           {
 msg = HIW"    $N正在运功驭器，但见"+weapon->query("name")+"嗖的一下又飞了回来，落在了你的手上。\n" NOR;
 msg += HIW"    "+weapon->query("name")+"轻巧的落在$N的手上，敌人似乎消失了！\n"NOR;
if(target) tell_object (target,HIC"  你吐了口浊气，全身放松下来。危机感消失了！\n"NOR);

        message_vision(msg, me);
        weapon->move(me);
        me->start_busy(1);
 return 0;
           }
myexp = me->query("combat_exp",1);
texp = target->query("combat_exp",1);
myforce = me->query("force");
tforce = target->query("force");
skill= me->query_skill("force");
type = weapon->query("skill_type");
skill += me->query_skill(type,1);
j = me->query_skill(type,1)/100;
if (j < 1) j = 1;
tskill = target->query_skill("dodge");
damage = weapon->query("weapon_prop/damage")*2; 
damage += me->query("force_factor");
damage += me->query(type,1);
damage -= target->query_temp("apply/armor");
if(damage < 1) damage = 1;

 msg = HIW"    只见虚空之中突然出现一把"+weapon->query("name")+" "+HIW+"雷霆霹雳般的向$N斩来。\n" NOR;
if(myexp+random(myexp) < texp/2 && tforce > myforce)
 {
 msg += HIW"    $N冷笑一声喝道：驭器术！小道尔。$N双手一圈一吸"+weapon->query("name")+" "+HIW+"毫无反抗的落到了$N的手中。\n" NOR;
  me->start_busy(1);
  weapon->move(target);
  message_vision(msg, target);
    tell_object (me,HIC"  糟糕！对手太强，你的"+weapon->query("name")+""+HIC"被对手收去了！\n"NOR);
  return 0;
    }
 else   message_vision(msg, target);
  
for(i=0;i<j;i++)
   {
if(skill/2+random(skill/2) > tskill/2+random(tskill/2) )
        {
  msg = HIR"    红光一闪！$N一不留神被"+weapon->query("name")+"击中了。\n"NOR;
  message_vision(msg, target);
     target->set_temp("last_damage_from",me);
     target->receive_damage("kee", damage);
     COMBAT_D->report_status(target);
        }
else
        {
   msg = HIR"    $N手指一弹！正好击中"+weapon->query("name")+"，一缕内劲把"+weapon->query("name")+"弹飞了。\n"NOR;
   message_vision(msg, target);
        }
   }

 if ( (target->query("eff_kee")<0 || !living(target)) )  
   {
 msg = HIM+target->name()+NOR+HIM"被"+me->name()+NOR+HIM"用雪山绝招"HIW"『驭器术』"NOR+HIM"暗杀于千里之外！据说到死都不知道是谁干的!";
message("channel:rumor",HIM"【空穴开风】某人："+msg+"\n"NOR,users());
   }

 message_vision(HIW " "+weapon->query("name")+" "+HIW+"后继无力，一个转身破开空间，消失了。\n"NOR, target);
 message_vision(HIW " 虚空中"+weapon->query("name")+" "+HIW+"突然出现，落在了$N的手上。看起来收获颇大！\n"NOR, me);
 weapon->move(me);
 me->start_busy(1);
 }



