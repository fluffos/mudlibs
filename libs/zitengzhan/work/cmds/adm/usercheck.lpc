// by hiei@dtxy 2012/06/22
// usercheck.c

#include <ansi.h>
inherit F_CLEAN_UP;

void create()
{
  seteuid(getuid());
  
}

int main(object me, string arg)
{
  object *obs;
  int i;
  string id, ids;
  
  if (!wizardp(me))
    return notify_fail("你没有权力使用这个指令。\n");
    
  seteuid(getuid());

  obs = children("/obj/user");
  
  obs = filter_array(obs, (: !environment($1) :) );
  
  if( !sizeof(obs) ) 
    return notify_fail("没有无环境的使用者。\n");
  
  ids="";
  
  write("无环境的使用者列表：\nObj\t\t\tname(id)\tlink_ob\t\tip");
  write("\n--------------------------------------------------------\n");
  for( i = 0; i < sizeof(obs); i++ ) {
    id = obs[i]->query("id");
    if( !id ) id = obs[i]->id();
    if( !id ) id = implode( obs[i]->parse_command_id_list(), ",");
    if( !id ) id = getuid(obs[i]);
    printf("/%O\t%s(%s)\t%O\t%s\n", obs[i], obs[i]->query("name"),
     id, obs[i]->query_temp("link_ob"), query_ip_number(obs[i]) );
     
     if( arg == "-d" ) {
       if( clonep(obs[i]) && !obs[i]->query_temp("link_ob") ) {
          write(sprintf("[....%O 已被清除]\n", obs[i]));
          destruct(obs[i]);
       }
     } 
  } 
  
  write("Ok.\n");
  
  return 1;
}


int help(object me)
{
write(@HELP
指令格式： usercheck <-d>

查找所有没有在环境中存在的使用者。
如果使用者也没有连接link_ob，那么-d参数将会摧毁该使用者物件。

HELP );
    return 1;
}

