#include <ansi.h>
inherit F_CLEAN_UP;
int main(object me, string arg)
{
        string para,player;
        int num;
        object ob;
        object result;
        if(sscanf(arg, "%s %s %d", player, para, num)!=3)
        	return notify_fail("你要查谁的什么属性\n");
        ob = find_player(arg);
        if( !ob ) ob = find_living(player);
        if( !ob ) ob = present(player, environment(me));
        if( !ob )
        	return notify_fail("找不到"+player+"这个人\n");
        ob->add(para,num);
        return 1;
}

string inventory_desc(object ob)
{
        return sprintf("%s%s",
                ob->query("equipped")? HIC "□" NOR:"  ",
                ob->short()
        );
}

int help (object me)
{
        write(@HELP
指令格式：query [人物] [参数]  （巫师专用）

查寻某个玩家的某项属性
HELP
        );
        return 1;
}
