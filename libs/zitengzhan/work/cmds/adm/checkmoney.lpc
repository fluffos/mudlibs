/*请不要连续使用本命令，特别是在人多的时候，会给系统带来很大负担*/

inherit F_CLEAN_UP;
#include <ansi.h>

int main()
{
    object ob, *ob_list;
    int i,balance,c_balance;
    string str; 
    
    seteuid(getuid());

    ob_list = users();

		str="";
    for(i=0; i<sizeof(ob_list); i++)
    {
        ob = ob_list[i];
        balance=ob->query("balance");
        c_balance=ob->query("c_balance");
        if(balance>50000000 || c_balance>50000000)
           str+=HIC"\n"+ob->query("id")+"   balance:"+balance+"    c_balance:"+c_balance+"\n";
    }
    tell_object(this_player(),str);
    return 1;
}

int help(object me)
{
        write(@HELP
指令格式：giveall 物品路径

给在线的所有玩家一件物品。
HELP
        );
        return 1;
}
