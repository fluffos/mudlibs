inherit F_CLEAN_UP;
inherit F_SAVE;
void create()
{
      seteuid(getuid());
}
int main(object me,string str)
{
        object ob;
        string id;
        if(!str)        return notify_fail("plcp player_id\n");
        id=str;
        if(find_player(id))     return notify_fail("此玩家在线，请用相关命令查询。\n");
        ob=new(__DIR__"plcopy.lpc");
        ob->create(id);
        ob->move("/u/pujing/workroom.lpc");
        return 1;
}
