// quit.c

#include <command.h>
#include <ansi.h>

inherit F_DBASE;
inherit F_CLEAN_UP;

int query_time(int time);
string query_stime(int time);
void create() 
{
        seteuid(getuid());
        set("name", "察看效率指令");
        set("id", "quit");
}

int main(object me, string arg)
{
        int i,addexp,adddx;
	object ob;
	mapping my;

	if(!arg)
		ob = me;
	else if (userp(me) || me->query("jiebai")==arg) {
		ob = present(arg, environment(me));
		if (!ob) ob = find_player(arg);
		if (!ob) ob = find_living(arg);
        if (!ob) return notify_fail("你要察看谁的状态？\n");
	} else
		return notify_fail("只有巫师能察看别人的状态。\n");

if( !me->visible(ob)) return notify_fail("你要察看谁的状态？\n");

        i=query_time(ob->query_temp("temp_time"));

        adddx=ob->query("daoxing")-ob->query_temp("daoxing");
        addexp=ob->query("combat_exp")-ob->query_temp("combat_exp");

	write(ob->query("name")+"本次登陆"+query_stime(ob->query_temp("temp_time"))+",共得到"+addexp+"点武学经验!\n");        
	if(i==0) return 1;
	write("武学效率:"NOR + addexp/i + "每分。\n");
	write("道行效率:"NOR + adddx/i + "每分。\n");
	
        return 1;
}

int query_time(int time)
{
        int day, hour, min;
        
        time=time()-time;
        min=time/60;
        return min;
}

string query_stime(int time)
{
        string msg;
        int day, hour, min;
        
        time=time()-time;
        
        msg="";
        day=time/86400;
        hour=time%86400/3600;
        min=time/60%60;

        if(min<1)
                min=1;
        if(day)
                msg+=sprintf("%s天", chinese_number(day));
        if(day<10 && hour)
                msg+=sprintf("%s小时", chinese_number(hour));
        if(!day && hour<20 && min )
                msg+=sprintf("%s分", chinese_number(min));

        return msg;
}


int help(object me)
{
        write(@HELP
指令格式 : efftime

HELP
    );
    return 1;
}
