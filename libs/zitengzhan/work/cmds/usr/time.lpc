// time.c
#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  if (time() - (int)me->query_temp("time_end") < 2)
    return notify_fail("等等，系统喘息！\n");
  write("现在是" HIR "大唐" HIG "盛世" NOR + NATURE_D->game_time() + "。\n");
  me->set_temp("time_end", time());
  return 1;
}

int help(object me) {
  write(@HELP
指令格式: time

这个指令让你知道现在的时辰。

HELP
  );
  return 1;
}
