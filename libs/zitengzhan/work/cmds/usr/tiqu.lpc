#include <room.h>

inherit F_CLEAN_UP;
int help(object me);
int main(object me,string arg)
{
	string type;
       object ob;
       object who=this_player();
  
      if(! arg)
		return notify_fail("你想要提取什么？(比如:tiqu 原石)\n");
     else 
        {
                sscanf(arg,"%s",type);
                        switch(type)
                        {
                        case "原石":
                           if (who->query("baoshi/bs_ys")<1)
                            return notify_fail("你所得的宝石不够! \n");
                                ob=new("/d/npc/vr_room/obj/baoshi.lpc");
                                if (objectp(ob)) 
                            {
                            ob->move(who);
                            who->add("baoshi/bs_ys",-1);
                                tell_object(who,"你提取了一颗"+ob->query("name")+"！\n");
                               }
                                break;
                        case "绿宝石":
                           if (who->query("baoshi/bs_g1")<1)
                            return notify_fail("你所得的宝石不够!\n");
                                ob=new("/d/npc/vr_room/obj/bs_g1.lpc");
                                if (objectp(ob)) 
                            {
                            ob->move(who);
                            who->add("baoshi/bs_g1",-1);
                                tell_object(who,"你提取了一颗"+ob->query("name")+"！\n");
                               }
                                break;
                        case "黄宝石":
                           if (who->query("baoshi/bs_y1")<1)
                            return notify_fail("你所得的宝石不够!\n");
                                ob=new("/d/npc/vr_room/obj/bs_y1.lpc");
                                if (objectp(ob)) 
                            {
                            ob->move(who);
                            who->add("baoshi/bs_y1",-1);
                                tell_object(who,"你提取了一颗"+ob->query("name")+"！\n");
                               }
                                break;

                        case "天晶石":
                           if (who->query("baoshi/bs_b1")<1)
                            return notify_fail("你所得的宝石不够!\n");
                                ob=new("/d/npc/vr_room/obj/bs_b1.lpc");
                                if (objectp(ob)) 
                            {
                            ob->move(who);
                            who->add("baoshi/bs_b1",-1);
                                tell_object(who,"你提取了一颗"+ob->query("name")+"！\n");
                               }
                                break;
                        case "生命宝石":
                           if (who->query("baoshi/stone")<1)
                            return notify_fail("你所得的宝石不够!\n");
                                ob=new("/d/npc/vr_room/obj/stone.lpc");
                                if (objectp(ob)) 
                            {
                            ob->move(who);
                            who->add("baoshi/stone",-1);
                                tell_object(who,"你提取了一颗"+ob->query("name")+"！\n");
                               }
                                break;
                          case "紫藤宝石":
                           if (who->query("baoshi/ztstone")<1)
                            return notify_fail("你所得的宝石不够!\n");
                                ob=new("/d/npc/vr_room/obj/ztstone.lpc");
                                if (objectp(ob)) 
                            {
                            ob->move(who);
                            who->add("baoshi/ztstone",-1);
                                tell_object(who,"你提取了一颗"+ob->query("name")+"！\n");
                               }
                                break;
                           case "蓝宝石":
                           if (who->query("baoshi/bs_b2")<1)
                            return notify_fail("你所得的宝石不够!\n");
                                ob=new("/d/npc/vr_room/obj/bs_b2.lpc");
                                if (objectp(ob)) 
                            {
                            ob->move(who);
                            who->add("baoshi/bs_b2",-1);
                                tell_object(who,"你提取了一颗"+ob->query("name")+"！\n");
                               }
                                break;

                         case "天青石":
                           if (who->query("baoshi/bs_tq")<1)
                            return notify_fail("你所得的宝石不够!\n");
                                ob=new("/d/npc/vr_room/obj/bs_tq.lpc");
                                if (objectp(ob)) 
                            {
                            ob->move(who);
                            who->add("baoshi/bs_tq",-1);
                                tell_object(who,"你提取了一颗"+ob->query("name")+"！\n");
                               }
                                break;


                        case "灵仙丹":
                           if (who->query("faith")<2000)
                            return notify_fail("你的门忠不够!\n");
                                ob=new("/u/wzx/obj/lxd.lpc");
                                if (objectp(ob)) 
                            {
                            ob->move(who);
                            who->add("faith",-2000);
                                tell_object(who,"你用2000点门忠换取了一颗"+ob->query("name")+"！\n");
                               }
                                break;
                        

                        }
        }  
return 1;

}


int help(object me)
{
write(@HELP

提取指令格式：
           tiqu 原石                    : 提取一颗原石
           tiqu 绿宝石                  : 提取一颗绿宝石
           tiqu 黄宝石                  : 提取一颗黄宝石
           tiqu 天晶石                  : 提取一颗天晶石
           tiqu 蓝宝石                  : 提取一颗蓝宝石（第六颗）
           tiqu 天青石                  : 提取一颗天青石（第六颗）
           tiqu 生命宝石                : 提取一颗生命宝石
           tiqu 紫藤宝石                : 提取一颗紫藤宝石
           tiqu 灵仙丹（随机加1点先天天赋）         : 换取一颗灵仙丹（暂定2000门忠)

查看数量: 请用quests指令.

HELP
    );
    return 1;
}



