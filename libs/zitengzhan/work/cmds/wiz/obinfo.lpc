// obinfo.c
// By hiei@dtxy 2012/06/22

inherit F_CLEAN_UP;
#include <ansi.h>
inherit F_DBASE;

int help(object me);

int main(object me, string arg) {
  string file, str;
  object ob;

  seteuid(geteuid(me));
  if (!arg) return notify_fail("指令格式 : obinfo <here>|<物件名> \n");
  ob = present(arg, me);
  if (!ob) ob = present(arg, environment(me));
  if (!ob) ob = find_player(arg);
  if (!ob) ob = find_living(arg);
  if (!ob) {
    file = resolve_path(me->query("cwd"), arg);
    if (file_size(file) < 0) {
      return notify_fail("指令格式 : obinfo <here>|<物件名> \n");
    } else {
      ob = find_object(file);
      if (!ob) ob = load_object(file);
      if (!ob) return notify_fail("指令格式 : obinfo <here>|<物件名> \n");
    }
  }

  printf("/%O\n---------------------------------\n", ob);
  write("档案：\t\t" + base_name(ob) + ".c\n");
  write("领域：\t\t" + domain_file(base_name(ob)) + "\n");
  write("作者：\t\t" + author_file(base_name(ob)) + "\n");
  write("权限：\t\tuid = " + getuid(ob) + ", euid = " + geteuid(ob) + "\n");
  write("等级：\t\t" + SECURITY_D->get_status(ob) + "\n");
  write("使用记忆体：\t" + memory_info(ob) + "\n");
  str = "";
  if (living(ob)) str += "生物 ";
  if (userp(ob)) str += "用户 ";
  if (interactive(ob)) str += "在线 ";
  if (wizardp(ob)) str += "巫师 ";
  if (clonep(ob)) str += "复制 ";
  if (virtualp(ob)) str += "虚拟 ";
  if (query_heart_beat(ob)) str += "心跳:" + query_heart_beat(ob) + " ";
  write("属性：\t\t" + str + "\n");
  write("复制个数：\t" + sizeof(children(base_name(ob) + ".lpc")) + "\n");
  write("参考连结：\t" + refs(ob) + "\n");

  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : obinfo <here>|<物件名>
 
显示物件信息。

HELP
  );
  return 1;
}
