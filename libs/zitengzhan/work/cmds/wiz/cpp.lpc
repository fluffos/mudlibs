inherit F_CLEAN_UP;

int main(object me, string arg) {
  string src, dst, *dirs;

  seteuid(geteuid(me));

  src = resolve_path(me->query("cwd"), src);
  dst = resolve_path(me->query("cwd"), dst);
  if (file_size(dst) == -2) {
    dirs = explode(src, "/");
    dst += "/" + dirs[sizeof(dirs) - 1];
  }
  if (cp(src, dst))
    write("Ok.\n");
  else
    write("你没有足够的读写权利。\n");
  return 1;
}
