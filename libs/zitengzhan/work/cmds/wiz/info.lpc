// testfile.c by zero. 测试一个文件

#include "/doc/help.h"
#include <ansi.h>

inherit F_CLEAN_UP;


int main(object me, string file) {
  int i;
  object obj, *inv;
  string err, arg, name;
  int force = 0;

  seteuid(geteuid(me));

  if (sscanf(file, "%s -%s", name, arg) == 2) {
    if (arg == "l") force = 1;
    else if (arg == "u") force = -1;
    else force = 0;
    file = name;
  } else { name = file; }
  if (!file)
    return notify_fail("你要测试什么档案？\n");

  file = resolve_path(me->query("cwd"), file);
  if (!sscanf(file, "%*s.lpc")) file += ".lpc";

  if (file_size(file) == -1)
    return notify_fail("没有这个档案。\n");

  me->set("cwf", file);
  if (find_object(file)) {
    write("文件已经加载了。\n");
  } else {
    err = catch(call_other(file, "???"));
    if (err) {
      printf("开始加载文件... 发生错误：\n%s\n", err); return 0;
    } else {
      write("开始加载文件... 成功！\n");
      if (obj = find_object(file)) {
        write("再次确认... 已经在系统中了！\n");
      } else { return notify_fail("再次确认... 发生错误！系统中仍然找不到该文件！\n"); }
      if (force == 0) force = -1;
    }
  }

  if (force == -1) {
    destruct(obj);
    if (obj) {
      return notify_fail("从系统中清除... 清除不成功！\n");
    } else { write("从系统中清除完毕。\n"); }
  }
  return 1;
}


int help(object me) {
  write(@HELP
指令格式 : testfile <文件名> (-l | -u)
-l 强制加载(load)。
-u 强制卸载(unload)。
无参数时，测试完毕后，新加载进来的文件会被清除。
 
 
HELP
  );
  return 1;
}
