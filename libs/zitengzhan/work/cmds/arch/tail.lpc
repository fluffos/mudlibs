// tail file.
#include <ansi.h>
inherit F_DBASE;
int help(object);

void create() {
  seteuid(getuid());
  set("name", "查看指令");
  set("id", "tail");
  set("channel_id", HIG "查看指令(tail)");
}
int main(object me, string arg) {
  string file, fileName;
  int line;

  seteuid(geteuid(me));
  if (!arg || arg == "")
    return help(me);

  if (sscanf(arg, "%s %d", fileName, line) != 2) {
    fileName = arg;
    line = 20;
  }
  if (file == "here") file = base_name(environment(me)) + ".lpc";
  else

    file = resolve_path(me->query("cwd"), fileName);

  if (file_size(file) < 0)
    return notify_fail("没有这个档案。\n");

  if (!(int)SECURITY_D->valid_read(file, me)) return notify_fail("没有找到这个档案。\n");

  /*
        log_file("static/查看指令", sprintf("%s%s tail %s (%s)\n", me->query("name"),
        "(" + me->query("id") + ")", file , ctime(time()) ));
        
        CHANNEL_D->do_channel(this_object(),"sys",me->query("name")+"("+me->query("id")+")"+" Tail "+
                file+"。\n");    
*/
  if (!read_file(file))  //                return notify_fail("文件太大，无法载入内存。\n");
  {
    me->set("cwf", file);
    //       write(implode(explode(read_file(file), "\n")[<50..],"\n"));
    // hiei 2012/04/13: fixed bug when read too large files, now return last 4000 bytes.
    write(implode(
      explode(read_buffer(read_buffer(file, file_size(file) - 4000, 4000)), "\n")[<50..],
      "\n"
    ));
    return 1;
  }
  me->set("cwf", file);
  write(implode(explode(read_file(file), "\n")[<line..], "\n"));
  write("\n");
  return 1;
}

int help(object me) {
  write("指令格式：tail <文件名> | <行数>。\n");
  return 1;
}
