// cat.c
#include <ansi.h>
inherit F_CLEAN_UP;
inherit F_DBASE;
int help(object me);

void create() {
  seteuid(getuid());
  set("name", "查看指令");
  set("id", "cat");
  set("channel_id", HIG "查看指令(cat)");
}

int main(object me, string arg) {
  string file;

  seteuid(geteuid(me));
  if (!arg) return notify_fail("你想要显示那个档案?\n");
  file = resolve_path(me->query("cwd"), arg);
  if (file_size(file) < 0) return notify_fail("没有这个档案。\n");
  log_file("static/查看指令", sprintf("%s%s cat %s (%s)\n", me->query("name"),
    "(" + me->query("id") + ")", file, ctime(time())));
  CHANNEL_D->do_channel(this_object(), "sys", me->query("name") + "(" + me->query("id") + ")" + " Cat " +
    file + "。\n");
  if (!(int)SECURITY_D->valid_read(file, me)) return notify_fail("没有找到这个档案。\n");

  cat(file);
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : cat <档案>

此指令可让你直接读取某档案之程式。
HELP
  );
  return 1;
}
