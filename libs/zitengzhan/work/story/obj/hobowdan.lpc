// hobowdan.c 荷包蛋
#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIY "荷包蛋" NOR, ({ "hebao dan", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "片");
    set("long", "这是用火云绝学掌心雷烘成的荷包蛋。\n");
    set("value", 0);
  }
  setup();
}

void init() {
  add_action("do_eat", "eat");
}

int do_eat(string arg) {
  object me = this_player();
  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  me->set("food", (int)me->max_food_capacity() * 5 + random(100));
  me->set("water", (int)me->max_water_capacity() * 5 + random(100));
  message_vision(HIY "$N吃下一片荷包蛋，感觉肚子涨得走不动路了。\n" NOR, me);
  destruct(this_object());
  return 1;
}
