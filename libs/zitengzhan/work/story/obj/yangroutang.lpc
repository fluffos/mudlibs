//create by huarong 2004/8
#include <ansi.h>
inherit ITEM;

void init();
int do_chi(string);

void create()
{
	set_name(HIY"大碗羊肉羹"NOR,({"yangrou geng", "geng"}));
	set_weight(50);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "以羊力大仙的羊肉制成，虽说有些妖气，但是对练功还是有些益处。\n");
		set("unit", "碗");
        set("value", 10000);
        set("remaining", 5);
        set("food_supply", 30);
    }
	
	setup();
}

void init()
{
  if (!wizardp(this_player())) {
    set("no_give","这么珍贵的羹，哪能随便给人？\n");
    set("no_drop","这么宝贵的羹，扔了多可惜呀！\n");
    set("no_sell","凡人哪里知道"+this_object()->query("name")+"的价值？还是自己留着吧。\n");
  }                                    
	add_action("do_chi", "chi");
	add_action("do_chi", "eat");
}


int do_chi(string arg)
{

    if( !this_object()->id(arg) ) return 0;
    if( this_player()->is_busy() )
        return notify_fail("你上一个动作还没有完成。\n");
    if(   (int)this_player()->query("food")
       >= (int)this_player()->max_food_capacity() )
     return notify_fail("你已经吃得太多了，再吃就撑死了。\n");

    this_player()->add("food", (int)query("food_supply"));

    if( this_player()->is_fighting() ) this_player()->start_busy(2);

    add("remaining", -1);
	if ( query("remaining") )
	{
                 this_player()->add("daoxing",1000);
   		 message_vision("$N拿起大碗羊肉羹吃了几口，$N觉得道行又长进了不少。\n", this_player());
	} else 
	{ 
   		 message_vision("$N把碗里的羊肉羹舔得干乾净净，羊肉骚味绕喉不绝。\n", this_player());
		
		destruct(this_object());
	}

	return 1;
}
