#include <ansi.h>

int give_gift(string money, int amount, string name);

private mixed *story = ({
  "～～子母河～～",
  "唐僧：  悟空，我好口渴啊，给我找点水喝好么？",
  "悟空：  靠！说了那么多的废话，当然渴啦！要是再说两句，就把你活活干死！",
  "导演：  请小朋友们注意，刚才悟空说的“干”是读一声的，而不是读四声的。谢谢",
  "沙僧：  大师兄，给你碗！",
  "悟空：  沙师弟，这里遍地是水，你又拿着碗，自己打水不就好了？为什么还叫我？",
  "沙僧：  师傅对你说他口渴的啊？",
  "悟空：  没想到你还真是听话啊？",
  "沙僧：  凡事最怕听话，而咱们出家人最讲“听话”二字。",
  "船家：  你们还不快一点？师傅都快渴死了！",
  "悟空：  啊？师傅！",
  "唐僧：  已经没事了，我刚才趴在船帮上，屁股朝天，拉长脖子，撅起嘴巴，伸出舌头，把头钻进河里，自己喝完了。",
  "沙僧：  哇！这么龌龊的姿势您都做的出来？",
  "唐僧：  哇你老木啊？学人家港台三流明星啊？是跟你二师兄学的！",
  "船家：  咦？河水怎么变浅了？",
  "悟空：  呆子！别喝了！水位已经下降了！再喝就只好走过河去了！",
  "八戒：  水都不让我喝够？没天理啊！早知道不当和尚了！",
  "沙僧：  快看！前面就是城门了！",
  "八戒：  哦，页！终于可以看到好多的美眉了！",
  "唐僧：  喊什么喊？咱们的形象全被你破~~~~~~~~~~~坏了！",
  (: give_gift, "gold", 1 + random(4), HIY "黄金" NOR :),
});

void create()

{
  seteuid(getuid());
}

mixed query_story_message(int step) {
  return step < sizeof(story) ? story[step] : 0;
}

int give_gift(string money, int amount, string name) {
  STORY_D->give_gift("/obj/money/" + money, amount,
    HIM "\n“啪”的一声一些" + name + HIM "掉到你面前。\n\n" NOR);
  return 1;
}
