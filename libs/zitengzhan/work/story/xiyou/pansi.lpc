#include <ansi.h>

int give_gift(string, string);

private mixed *story = ({
  "唐  僧：  请问几位大妈，听说这里住着七位蜘蛛女，不知道怎么找得到她们啊？",
  "大妈甲：  呵呵，我们几个就是啊！",
  "唐  僧：  不会吧？报纸上明明说蜘蛛女貌美如花啊？",
  "大妈乙：  那几个当记者的，给俩钱就听你使唤了。",
  "大妈丙：  再说了，貌美如花，你难道没见过如花么？",
  "唐  僧：  我的命好苦啊！555555~~~~~~~",
  "大妈丁：  别哭了，你是来干什么的？贫僧是东土大唐的和尚，去西天求经，我是来化斋的……",
  "大妈甲：  靠！编剧！我们虽然老了一些，但能不能给我们换个称谓啊？不要总是大妈大妈的！",
  "编  剧：  sorry，马上就换！",
  "蜘大蛛：  哇！原来你就是传说中的唐僧？",
  "唐  僧：  正是在下！",
  "蜘二蛛：  那就快请到寒舍一坐吧！",
  "唐  僧：  有劳各位为我做些斋饭先！",
  "蜘大蛛：  化斋？您可找对了门了，我们这里的斋饭含钙高、吸收快、沉积好、无激素，
                       还有特别适合老年人和糖尿病患者服用的无糖型斋饭呢！",
  "唐  僧：  一定是哈尔滨制药六厂的新产品吧？我们还是快准备吃饭吧！",
  "蜘大蛛：  来了……这是鱼香蝶丝！",
  (: give_gift, "dish1", "鱼香蝶丝" :),
  "唐  僧：  我只听说过鱼香肉丝。",
  "蜘二蛛：  东坡蚊子。",
  (: give_gift, "dish2", "东坡蚊子" :),
  "唐  僧：  东坡肘子吧？",
  "蜘二蛛：  对，是蚊子的肘子！",
  "唐  僧：  靠！",
  "蜘三蛛：  蚂蚁上树。",
  (: give_gift, "dish3", "蚂蚁上树" :),
  "唐  僧：  还真是蚂蚁啊！有没有新鲜点儿的？",
  "蜘四蛛：  有！我们有全蝇宴！这是沙锅绿豆蝇。",
  (: give_gift, "dish4", "沙锅绿豆蝇" :),
  "蜘五蛛：  这是白灼青头蝇。",
  (: give_gift, "dish5", "白灼青头蝇" :),
  "蜘六蛛：  这是红烧麻子蝇。",
  (: give_gift, "dish6", "红烧麻子蝇" :),
  "蜘七蛛：  。。。。。。",
  "唐  僧：  那你们哪来的这么多苍蝇？",
  "蜘五蛛：  自己养的啊？",
  "唐  僧：  自己养？用什么养？",
  "蜘二蛛：  你以为除了大便还有什么可以把他们养的这么胖么？",
  "唐  僧：  我又知道了，你们是妖精！",
  "……",
});

void create()

{
  seteuid(getuid());
}

mixed query_story_message(int step) {
  return step < sizeof(story) ? story[step] : 0;
}

int give_gift(string dish, string name) {
  STORY_D->give_gift("/story/obj/" + dish, 1,
    HIM "\n“啪”的一声一盘" + name + "掉到你面前。\n\n" NOR);
  return 1;
}
