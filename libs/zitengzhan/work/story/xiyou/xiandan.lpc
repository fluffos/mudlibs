
#include <ansi.h>

int give_gift();

private mixed *story = ({
      "（正所谓：酒不醉人人自醉，色不迷人人自迷，旷猴耶？大圣连吃带拿，醉醺醺的出了蟠桃主会场）", 
      "大圣：  嗯？这里不是麦当劳天宫分店--兜率宫么？听说太上老君就是在这里炼丹的。我也要么！ ",
      "      （一推门进了宫内）", 
      "大圣：  原来仙丹是蓝色的？哦！好爽！……我的头？啊~~~~~嗯~~~~~唔~~~~~哦~~~~~ ",
      "…… ",
      "大圣：  靠！什么仙丹，摇头丸！",
      "顺手一扔……",
         (: give_gift :),
});

void create()
{
        seteuid(getuid());
}

mixed query_story_message(int step)
{
        return step < sizeof(story) ? story[step] : 0;
}

int give_gift()
{
        STORY_D->give_gift("/story/obj/unknowdan", 1,
                           HIM "\n“啪”的一声一颗仙丹掉到你面前。\n\n" NOR);
        return 1;
}

