#include <ansi.h>

int give_gift();

private mixed *story = ({
  "悟空：  哇！太厉害了！这棵大树一定就是人参果树了，树上面还有一张告示，那么多字我也不认得，字典又卖给了猪八戒，
                     这下怎么办呀？算了，不管他，上去敲几个果子先！",
  "（果然这人参果十分神奇，孙悟空上树用手使劲摘了几下都没有摘下来，用金锤子轻轻一碰，
                     那人参果就掉下来了。可是悟空一不留神，果子掉到了地上，一下子就没了踪影）",
  "悟空：  嗯？这是怎么回事？难不成是被那土地老儿拿去了？看我把他叫出来好好问问！ ",
  "土地：  大圣叫我何事？ ",
  "悟空：  耶？我还没有叫你，你怎么就出来了？ ",
  "土地：  我是这一集的赞助商，出了不少钱呢！所以想早点出来和观众见见面。 ",
  "悟空：  不明白你再说什么，我问你，我那人参果是不是被你偷走了？ ",
  "土地：  啊？冤枉啊！我们厂生产的暖气片保证十年不漏水，我怎么会偷你的果子呢？ ",
  "悟空：  那我刚才掉在地上的果子怎么不见了？ ",
  "土地：  我们厂生产的暖气片是省优部优产品，还通过了“矮爱司欧9001”的认证，
                     您在打果子前一定没有看树上的“人参果使用说明”！ ",
  "悟空：  还有说明？我没看，上面说什么了？ ",
  "土地：  呵呵，上面说我们厂生产的…… ",
  "悟空：  对不起，可不可以拣重要的说？",
  "土地：  噢！明白！要想家里装修好，我厂暖气少不了！",
  "悟空：  SHUT UP！你虽然出了很多钱，但是我们还要演戏啊，求求你别提暖气片了。 ",
  "土地：  好好好！我们厂…… ",
  "悟空：  #￥·%—*`~ ",
  "土地：  啊~~~~~导演，他打人！ ",
  "导演：  不好意思，厂长，这段戏我们已经临时决定改成让孙悟空自己念告示了。",
  "土地：  他演的是文盲耶！ ",
  "导演：  你这样苦苦相逼，文盲都成CEO了！开拍！",
  "悟空：  哇！原来这人参果遇金而落、遇土而入、遇水而化、遇木而朽，欲火焚身！这次我可要小心的打几个了！ ",
  (: give_gift :),
});

void create() {
  seteuid(getuid());
}

mixed query_story_message(int step) {
  return step < sizeof(story) ? story[step] : 0;
}

int give_gift() {
  STORY_D->give_gift("/story/obj/renshen-huarong", 1,
    HIM "\n“啪”的一声一个人参果掉到你面前。\n\n" NOR);
  return 1;
}
