#include <ansi.h>

int give_gift(string money, int amount, string name);

private mixed *story = ({
      "金角：  老弟，不是说好了不拿老百姓一针一线的了吗？我们做妖精也是有原则的，这已经
                     是三天来你牵回的第四十七头猪了，咱家后院的猪现在睡觉的时候都是在叠罗汉的。",
      "银角：  大哥，您看好了，这可不是普通的猪啊！",
      "金角：  你一进来我就看出来了，这的确不是普通的猪，这是头好肥的猪！",
      "银角：  早就叫你关心一下国家大事了，这就是我最近常和你说的猪八戒啊。",
      "金角：  是那个“女人的问题女人办”？",
      "银角：  那是大药丸子！",
      "金角：  那就是“要想皮肤好，早晚按摩脚”？",
      "银角：  也不是洗浴中心！",
      "金角：  莫非是“黑头发，中国货”的？",
      "银角：  挖靠！还是我告诉你吧，他就是去西天取经的和尚啊！",
      "金角：  不对啊？电视里介绍的不是这个猪头模样啊？",
      "银角：  这是他的二徒弟猪八戒啊！",
      "金角：  噢！想起来了，就是《天竺日报》上说生吃会传染口蹄疫的那个。",
      "银角：  对啊！",
      "金角：  你抓他干什么？你活够了？",
      "银角：  抓到了他，唐僧就不远了。我早就想好了主意，我就……这么……这么……这么……",
      "金角：  哇！此计甚妙，虽然我完全不知道你在说什么，但是我知道你一定已经有了自己的想法了！来人啊！",
      "喽啰：  在！",
      "金角：  你们现在点火做水，等二大王将唐僧抓来蒸了吃掉！",
      "银角：  又是我？我刚抓回猪八戒，换一个可不可以啊？",
      "金角：  废话！谁知道你想的是什么主意啊？还不快去！",
      "银角：  切！不就是导演的小舅子嘛，嚣张。",
        (: give_gift, "gold", 1 + random(4), HIY"黄金"NOR :),
});

void create()
 
{
        seteuid(getuid());
}

mixed query_story_message(int step)
{
        return step < sizeof(story) ? story[step] : 0;
}

int give_gift(string money, int amount, string name)
{
        STORY_D->give_gift("/obj/money/" + money, amount,
                           HIM "\n“啪”的一声一些" + name + HIM+"掉到你面前。\n\n" NOR);
        return 1;
}

