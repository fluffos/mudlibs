//edit by vermin;
inherit NPC;

#include <ansi.h>
#include <obstacle.h>

int ask_for_shang();
int ask_for_go();
int ask_for_cancel();
int accept_object(object me,object obj);
int chuanshou();
void reward(object me);
void create()
{
  set_name(HIM"花雨"NOR, ({ "hua yu","yu" }));
  set("title", HIW"妙手天师飞雪之妻"NOR);
  set("gender", "女性");
  set("long", "云和山的彼端中天神飞雪的老婆，负责玩家解九迷事宜”。\n");
  set("age", 21);
  set("per", 30);
  set("combat_exp", 300000);
  set_skill("force", 200);
  set_skill("spells", 200);
  set_skill("unarmed", 200);
  set_skill("dodge", 200);
  set_skill("parry", 200);
  set_skill("sword", 200);
  set("gin", 3000);
  set("max_gin", 3000);
  set("kee", 3000);
  set("max_kee", 3000);
  set("sen", 3000);
  set("max_sen", 3000);
  set("force", 1000);
  set("max_force", 1000);
  set("mana", 1000);
  set("max_mana", 1000);
  set("force_factor", 200);
  set("inquiry", ([
                "奖赏"     : (: ask_for_shang :),
                "解九迷"     : (: ask_for_go :),
                "放弃九迷"     : (: ask_for_cancel :),
                  ]) );
  setup();
  carry_object("/d/obj/cloth/jinpao")->wear();
}

int ask_for_go()
{
object ob=this_player();
if(ob->query("ask_for_go"))
   {command("say 你不是正在做九迷吗？\n");
   return 1;}
else if((int)ob->query("daoxing")<=60000)
        {command("say 你道行不够，解不了九迷，等道行够了60年再来吧！\n");
         return 1;
        }
else if(ob->query("quest/pending"))
{command("say 先去销了上次的任务！！\n");
return 1;
}        
else{command("say 好吧，下面就是解九迷了，要努力呀，别轻言放弃！\n");
     ob->set("ask_for_go",1);
     ob->set("ask_for_cancel",0);
     ob->set("jiumi/xianglan",0);
     ob->set("jiumi/yulan",0);
     ob->set("jiumi/cuilan",0);
     ob->set("jiumi/zhu",0);
     ob->set("jiumi/yin",0);
     ob->set("jiumi/chen",0);
     ob->set("jiumi/hu",0);
     ob->set("jiumi/gong",0);
     ob->set("jiumi/po",0);
     return 1;
     }
}    	
	
int ask_for_shang()  //yourking 2004.6
{    
  int extra_bonus,potential_bonus,combat_exp_bonus,daoxing_bonus ,quest_x,i;
  object qs,ps;
  object ob=this_player();
  string job;

  
  extra_bonus = (ob->query("combat_exp")/1000)/5;
  if(extra_bonus > 700) extra_bonus = 700;
        potential_bonus = random(extra_bonus) + 700; //+ mapp["index"];
        combat_exp_bonus = extra_bonus*3 + (random(300) + random(400))*3;
        daoxing_bonus = extra_bonus*3 + (random(300) + random(400))*3;
        
                   //增加任务奖励系数 add by wsw  20051015
					QUESTS_D->add_quest("jiumi",1);
                   quest_x = QUESTS_D->query_quest_x("jiumi");

potential_bonus = potential_bonus*4*quest_x/1000;
combat_exp_bonus = combat_exp_bonus*4*quest_x/1000;
daoxing_bonus = daoxing_bonus*4*quest_x/1000;

  
  if(((int)ob->query("jiumi/xianglan")==1)&&((int)ob->query("jiumi/yulan")==1)
  &&((int)ob->query("jiumi/cuilan")==1)&&((int)ob->query("jiumi/zhu")==1)
  &&((int)ob->query("jiumi/yin")==1)&&((int)ob->query("jiumi/hu")==1)&&((int)ob->query("jiumi/gong")==1)
  &&((int)ob->query("jiumi/po")==1))
  {
  if (ob->query("quest/reward") > 0)//test player
  {
    command("say 你还是先赴长安进宫请赏吧！找我要奖赏也不急在这一时呀！\n");
    return 1;
  }	
  else
   {
    command("say 阁下功德圆满，果然了得，我有赏赐予你！\n");
    ob->add("daoxing",daoxing_bonus);
    ob->add("potential",potential_bonus);
    ob->add("combat_exp",combat_exp_bonus);
    
message_vision (HIR"$N本次九迷得到"+COMBAT_D->chinese_daoxing(daoxing_bonus)+"道行！\n"NOR,ob);
message_vision (HIR"$N本次九迷得到"+chinese_number(potential_bonus)+"点潜能！\n"NOR,ob);
message_vision (HIR"$N本次九迷得到"+chinese_number(combat_exp_bonus)+"点武学！\n"NOR,ob);    

job="本次完成九迷任务得到"+COMBAT_D->chinese_daoxing(daoxing_bonus)+"道行！";
job+=chinese_number(potential_bonus)+"点潜能！";
job+=chinese_number(combat_exp_bonus)+"点武学！";
//  tell_object(ob,"你得到了"+potential_bonus+"点潜能，"+combat_exp_bonus+"武学经验，"+COMBAT_D->chinese_daoxing(daoxing_bonus)+"道行。\n");
message("channel:rumor", HIC"【"+HIG"九"+HIR"迷"+HIB"连"+HIY"珠"+HIC"】"NOR+HIM"花雨(Hua yu)："+HIM""+ob->name()+job+"\n"NOR,users());

i=random(6);
if (i>5) i=5;
switch (i)
 {
  case  0: 
         qs = new ("/d/npc/vr_room/obj/bs_y1");
         qs->move(this_player());
        message("channel:rumor", HIC"【"+HIG"九"+HIR"迷"+HIB"连"+HIY"珠"+HIC"】"NOR+HIM"花雨(Hua yu)："+ob->query("name")+"完成九迷连珠特奖励"+qs->query("name")+"。\n"NOR,ob,qs);break;
case  1: 
         qs = new ("/d/npc/vr_room/obj/bs_g1");
         qs->move(this_player());
        message("channel:rumor", HIC"【"+HIG"九"+HIR"迷"+HIB"连"+HIY"珠"+HIC"】"NOR+HIM"花雨(Hua yu)："+ob->query("name")+"完成九迷连珠特奖励"+qs->query("name")+"。\n"NOR,ob,qs);break;
case  2: 
         qs = new ("/d/npc/vr_room/obj/ztstone");
         qs->move(this_player());
        message("channel:rumor", HIC"【"+HIG"九"+HIR"迷"+HIB"连"+HIY"珠"+HIC"】"NOR+HIM"花雨(Hua yu)："+ob->query("name")+"完成九迷连珠特奖励"+qs->query("name")+"。\n"NOR,ob,qs);break;
case  3: 
         qs = new ("/d/npc/vr_room/obj/soulbox");
         qs->move(this_player());
        message("channel:rumor", HIC"【"+HIG"九"+HIR"迷"+HIB"连"+HIY"珠"+HIC"】"NOR+HIM"花雨(Hua yu)："+ob->query("name")+"完成九迷连珠特奖励"+qs->query("name")+"。\n"NOR,ob,qs);break;
case  4: 
         qs = new ("/d/npc/vr_room/obj/zhufubox");
         qs->move(this_player());
        message("channel:rumor", HIC"【"+HIG"九"+HIR"迷"+HIB"连"+HIY"珠"+HIC"】"NOR+HIM"花雨(Hua yu)："+ob->query("name")+"完成九迷连珠特奖励"+qs->query("name")+"。\n"NOR,ob,qs);break;
case  5: 
         qs = new ("/d/npc/vr_room/obj/10gold-cash");
         qs->move(this_player());
        message("channel:rumor", HIC"【"+HIG"九"+HIR"迷"+HIB"连"+HIY"珠"+HIC"】"NOR+HIM"花雨(Hua yu)："+ob->query("name")+"完成九迷连珠特奖励"+qs->query("name")+"。\n"NOR,ob,qs);break;
default:
}

if (ob->query("jiumilianhuan") >= 9)
   {
    i=random(2);
   if (i>1) i=1;
    switch (i)
    {
     case 0:
      ps = new ("/d/npc/vr_room/obj/ztstone10");
      ps->move(this_player());
        message("channel:rumor", HIC"【"+HIG"九"+HIR"迷"+HIB"连"+HIY"珠"+HIC"】"NOR+HIM"花雨(Hua yu)：恭喜"+ob->query("name")+"连续完成九次九迷连珠任务获得十枚"+ps->query("name")+""HIM"的大奖。\n"NOR,ob,qs);break;
     case 1:
      ps = new ("/d/npc/vr_room/obj/stone");
      ps->move(this_player());
        message("channel:rumor", HIC"【"+HIG"九"+HIR"迷"+HIB"连"+HIY"珠"+HIC"】"NOR+HIM"花雨(Hua yu)：恭喜"+ob->query("name")+"连续完成九次九迷连珠任务获得一枚"+ps->query("name")+""HIM"的大奖。\n"NOR,ob,qs);break;
default:
    }
ob->set("jiumilianhuan",1);
   }
    ob->add("gain_daoxing",daoxing_bonus);
    ob->add("gain_potential",potential_bonus);
    ob->add("gain_combat_exp",combat_exp_bonus);
    ob->set("jiumi/xianglan",0);
    ob->set("jiumi/yulan",0);
    ob->set("jiumi/cuilan",0);
    ob->set("jiumi/zhu",0);
    ob->set("jiumi/yin",0);
    ob->set("jiumi/chen",0);
    ob->set("jiumi/hu",0);
    ob->set("jiumi/gong",0);
    ob->set("jiumi/po",0);
    ob->add("jiumilianhuan",1);
    return 1;
   }
  }
  else if(!(ob->query("ask_for_go")))
  {
  command("say 你又没在解九迷，要什么赏？小心我让我们家飞雪办你！！\n");
  return 1; 
  	}
  else
  {
  command("say 你还没解完这轮九迷呢！骗我？小心我让我们家飞雪办你！！\n");
  return 1; 
  }
 }




int ask_for_cancel()
{
object ob=this_player();
if(!(ob->query("ask_for_go")))
{
command("say 你又没在解九迷，放弃什么？");
return 1;
}
else if(ob->query("ask_for_cancel")==0){
command("say 放弃，对得起我们家飞雪写的程序吗？\n");
command("say 就不让你放弃!气死你!\n");
return 1;
}
else{
command("say 算了，不强求你，你去吧！\n");
command("say 别忘了销了你的任务！\n");
ob->delete("jiumi/xianglan");
ob->delete("jiumi/yulan");
ob->delete("jiumi/cuilan");
ob->delete("jiumi/zhu");
ob->delete("jiumi/yin");
ob->delete("jiumi/chen");
ob->delete("jiumi/hu");
ob->delete("jiumi/gong");
ob->delete("jiumi/po");
ob->delete("ask_for_go");
ob->delete("ask_for_cancel");
ob->delete("jiumilianhuan");
return 1;
}
}

int accept_object(object me,object obj)
{
	object ob=this_player();
        int dh;
        dh=ob->query("daoxing");
        dh=dh/10;
       if(!(ob->query("ask_for_go")))
       {return 0;
	} 
        else if( obj->value() >= dh )
        {
                message_vision("花雨对$N道："+RANK_D->query_respect(me)+"哎!早知如此,何必当初?\n", me);
                me->set("ask_for_cancel", 1);
                return 1;
        }
        else
        {
            command("say 这是干吗?多不好意思。");
            return 1;
        }
}
