inherit NPC;

#include <ansi.h>
string zhuzao(object me);
int chuanshou(object me);
int accept_object(object me, object obj);

void create() {
  set_name(WHT "飞雪" NOR, ({ "fei xue", "xue" }));
  set("gender", "男性");
  set("title", HIC "妙手天师" NOR);
  set("age", 33);
  set("long", "云和山的彼端的天神，精于武器铸造”。\n");
  set("combat_exp", 99999999);
  set("attitude", "friendly");
  set("int", 40);
  set("str", 40);
  set("spi", 40);
  set("per", 40);
  set("kar", 40);
  set("cps", 40);
  set("con", 40);
  set("cor", 40);
  set("class", "taoist");

  set("eff_dx", 999999);
  set("nkgain", 300);

  set_skill("unarmed", 999);
  set_skill("dodge", 999);
  set_skill("parry", 999);
  set_skill("spells", 999);
  set_skill("dao", 999);
  set_skill("literate", 999);
  set_skill("sword", 999);
  set_skill("qianjun-bang", 999);
  set_skill("jindouyun", 999);
  set_skill("dodge", 999);
  set_skill("force", 999);
  set_skill("wuxiangforce", 999);

  map_skill("spells", "dao");
  map_skill("unarmed", "puti-zhi");
  map_skill("force", "wuxiangforce");
  map_skill("stick", "qianjun-bang");
  map_skill("parry", "qianjun-bang");
  map_skill("dodge", "jindouyun");

  set("max_kee", 99999);
  set("max_gin", 99999);
  set("max_sen", 99999);
  set("force", 99999);
  set("max_force", 99999);
  set("force_factor", 9999);
  set("mana", 99999);
  set("max_mana", 99999);
  set("mana_factor", 99999);

  set("inquiry", ([
    "name": "在下飞雪，偏安于此。\n",
    "here": "这里是吾之住处所在。\n",
    //            "铸造" : (: zhuzao :),
    //            "兵器" : (: zhuzao :),            
    //            "weapon" : (: zhuzao :),
  ]));

  setup();
  carry_object("/d/lingtai/obj/cloth")->wear();
  carry_object("/d/obj/weapon/sword/qingfeng")->wield();
}

string zhuzao(object me) {
  object ob;
  me = this_player();

  if (me->query_temp("add_damage")) {
    message_vision("飞雪自顾自地凝望着墙上的墨竹画，不理$N了。\n", me);
    return RANK_D->query_respect(me) + "已经来过，请回吧。\n";
  }
  if (!me->query_temp("zhuzao/paid")) {
    if (me->query_temp("zhuzao/asked")) {
      message_vision("飞雪自顾自地凝望着墙上的墨竹画，不理$N了。\n", me);
      return RANK_D->query_respect(me) + "请回。\n";
    } else {
      me->set_temp("zhuzao/asked", 1);
      message_vision("飞雪看了$N一眼，摇了摇头。\n", me);
      return "心已淡泊如松，望勿打扰。\n";
    }
  } else {
    me->delete_temp("zhuzao");
    message_vision("飞雪叹了口气，对$N道：" + RANK_D->query_respect(me) + "既然如此看得起在下，当尽绵力。\n", me);
    if (!(ob = me->query_temp("weapon")))
      return "你没用兵刃，又怎能铸造？\n";
    else {
      message_vision("飞雪接过" + ob->name() + "，打磨铸炼，过了一会，又交还给$N。\n", me);
      message_vision("只见寒光一闪，" + ob->name() + "的锋锐比以前更胜一筹。\n", me);
      me->add_temp("apply/damage", random(8) + 5);
      me->set_temp("add_damage", 1);
      return "武器已经铸好，请回吧。\n";
    }
  }
}


int accept_object(object me, object ob) {
  if (ob->value() >= 500000) {
    message_vision("飞雪对$N道：" + RANK_D->query_respect(me) + "予我重金，可是有事相求？\n", me);
    me->set_temp("zhuzao/paid", 1);
    return 1;
  } else {
    command("say 不敢当不敢当……您太客气了。");
    return 1;
  }
}
