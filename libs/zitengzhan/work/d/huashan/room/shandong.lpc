//room

inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "山洞");
  set("long", @LONG
		
华山的内部，三圣母就被押在这里，大概已有了十几年了。这
里有一个法台，上面就押着圣母。法台上还有一道神符，只要
揭（jie）了它，圣母就自由了！
LONG);

  set("exits",
    ([  //sizeof() == 0

    ]));

  set("objects",
    ([  //sizeof() == 1
    //                __DIR__"npc/libai" : 1,
    ]));


  set("no_clean_up", 0);
  setup();
}

void init() {
  add_action("do_jie", "jie");
}

int do_jie(string arg) {
  object where = this_object();
  object me = this_player();
  object shengmu = present("san shengmu", where);

  if (arg != "fu")
    return notify_fail("你要揭什么？ \n");
  if (shengmu)
    return notify_fail(HIM "三圣母" NOR + "不是在吗？ \n");

  if (me->query("bld/done") == 1)
    return notify_fail("你不是揭过了吗？ \n");

  if (me->query("bld/dog") != 1 || me->query("bld/erlang") != 1 || me->query("bld/pi") != 1) {
    return notify_fail("你是怎么混进来的？ \n");
    return 1;
  }

  shengmu = new("/d/huashan/npc/shengmu");
  shengmu->move(where);
  message_vision(HIY "只见一道金光闪过，" + HIM "三圣母" NOR + HIY "从法台上飘了下来，你只觉香风拂面，让人联想翩翩！ \n" NOR, me);

  shengmu->command("chat " + me->query("name") + "救我出洞，一家团聚，功德无量！");
  me->add("combat_exp", 100000);
  me->add("daoxing", 20000);
  me->add("potential", 50000);
  me->add("balance", 15000000);
  me->add("str", 1);
  me->add("int", 1);
  me->add("spi", 1);
  me->add("con", 1);
  write("你得到膂力、悟性、灵性、根骨各多一点！ \n", me);
  me->delete("bld/monkey");
  me->delete("bld/chenxiang");
  me->delete("bld/monther");
  me->delete("bld/laozhe");
  me->delete("bld/taxue");
  me->delete("bld/erlang");
  me->delete("bld/dog");
  me->delete("bld/pi");
  me->set("bld/done", 1);
  write("你得到二十万武学，二十年道行，五万潜能，一千五百两黄金存款！ \n", me);
  shengmu->command("bye " + me->query("id"));
  shengmu->command("bye");
  destruct(shengmu);
  return 1;
}
