//赤龙
//modify for 大唐西游2 by huarong 2003/12
 
#include <ansi.h>
inherit NPC;
void create()
{
   set_name(HIR"小鬼"NOR, ({"ghost"}));
   set("age", 300);
   set("long", "他看得见你，你看不见他。\n");
   set("str", 30);
   set("cor", 40);
   set("con", 40);
   set("cps", 40);
   set("spi", 40);
   set("int", 40);
   set_temp("apply/damage", 150);
   set_temp("apply/armor", 800);
   set("max_kee", 1200);
   set("max_sen", 1200);
   set("force", 4000);
   set("max_force", 2000);
   set("force_factor", 100);
   set("mana", 4000);
   set("max_mana", 2000);
   set("mana_factor", 100);
   set_skill("spells", 150+random(50));
   set_skill("mysticism", 150+random(50));
   set_skill("force", 150+random(50));
   set_skill("butian-force", 150+random(50));
   set_skill("unarmed", 150+random(50));
   set_skill("ice_fire_zhang", 150+random(50));
   set_skill("dodge", 150+random(50));
   set_skill("binfen-steps", 150+random(50));
   set_skill("sword", 150+random(50));
   set_skill("spysword", 150+random(50));
   set_skill("whip", 150+random(50));
   set_skill("wuwei-fuchen", 150+random(50));
   map_skill("spells", "mysticism");
   map_skill("force", "butian-force");
   map_skill("dodge", "binfen-steps");
   map_skill("unarmed", "ice_fire_zhang");
   map_skill("sword", "spysword");
   map_skill("whip", "wuwei-fuchen");
   set("combat_exp", 500000);
   set("daoxing", 500000);
   set_weight(500000);
   setup();
   carry_object("/d/obj/weapon/18weapon.lpc")->wield();
}

