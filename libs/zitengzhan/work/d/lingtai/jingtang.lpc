// Room: some place in 西牛贺洲
// inside2.c

inherit ROOM;
#include <room.h>
#include <ansi.h>
void jiang_jing(object where);
void finish_jing(object where);
void check_time(object where);
int do_hear();
void create() {
  set("short", "讲经堂");
  set("long", @LONG

这里是三星洞的讲经堂，平时道士们便在这里讲经说法。若是
有什么大事，也在这里集会商议。左右整整齐齐地放着四五十
个软垫，也坐了一二十个道士。
LONG);

  set("exits", ([ /* sizeof() == 2 */
    "north": __DIR__ "houlang1.lpc",
    "southdown": __DIR__ "inside1.lpc",
  ]));
  set("objects", ([ /* sizeof() == 2 */
    __DIR__ "npc/xiao": 1,
    __DIR__ "npc/yunyang": 1,
  ]));
  set("valid_startroom", 1);

  setup();
}
/*
void init()
{
   object where=this_object();

    remove_call_out("check_time");
   check_time(where);
   add_action("do_hear","hear");
}
*/
void check_time(object where) {

  mixed *local = localtime((time() - 900000000) * 60);
  int t = local[2] * 60 + local[1];
  int phase = ((int)(t / 120));
  if (phase == 1 && (!query("jiangjing"))) jiang_jing(where);
  if (phase == 4 && query("jiangjing")) finish_jing(where);
  call_out("check_time", 60, where);
}

void jiang_jing(object where) {
  message(
    "channel:es",
    CYN + "◇" RED "方寸山三星洞" CYN "◇" WHT "云阳真人[Master yunyang]" HIM "：方寸山众弟子速到讲经堂领悟道家仙法。\n" + NOR,
    users()
  );
  tell_object(where, "云阳真人说道;众弟子归位开始领悟仙法。\n");
  tell_object(where, "一时仙云腾起，祥光呈照大厅。\n");
  set("jiangjing", 1);
}
void finish_jing(object where) {
  tell_object(where, "云阳真人朗声道:弟子们辛苦了。\n");
  set("jiangjing", 0);
}
int do_hear() {

  object me = this_player();

  if (me->is_busy())
    return notify_fail("你正忙着呢。\n");
  if (!query("jiangjing"))
    return notify_fail("方寸山还没有开始领悟神机。\n");

  if ((string)me->query("family/family_name") != "方寸山三星洞")
    return notify_fail("非方寸山三星洞弟子不得在此听经。\n");
  if (me->query("faith") > 40000)
    return notify_fail("你已经有一定功底,不用再领悟了。\n");
  tell_object(me, "你听着听着似乎若有所悟。\n");
  me->start_busy(5);
  if ((int)me->query_skill("dao", 1) < 700) {
    me->improve_skill("dao", random((int)(me->query("spi") + me->query("int")) / 2));
    tell_object(me, "你觉得道家仙法进步了！\n");
  } else { tell_object(me, "你的道家仙法已经达到一定高度，只能自己钻研了。\n"); }
  if ((int)me->query_skill("wuxiangforce", 1) < 700) {
    me->improve_skill("wuxiangforce", random((int)(me->query("spi") + me->query("int")) / 2));  //已cut liangyi 涨force功能 huarong 2003.5
    tell_object(me, "你觉得小无相功进步了！\n");
  } else { tell_object(me, "你的小无相功已经达到一定高度，只能自己钻研了。\n"); }

  me->receive_damage("kee", 20);
  me->receive_damage("sen", 20);
  return 1;
}

int valid_leave(object me, string dir) {
  if (dir == "up") {
    if (objectp(present("master yunyang", environment(me)))) {
      if ((string)me->query("family/family_name") == "方寸山三星洞") {
        if ((int)me->query("family/generation") < 2) {
          me->set("family/generation", 2);
          me->set("title", "方寸山三星洞第二代弟子");
        }
        if ((string)me->query("family/master_name") == "菩提祖师") {
          me->set("pending/kick_out", 1);
        }
        return ::valid_leave(me, dir);
      }
      return notify_fail("云阳真人说道：祖师清修，少见外人，您还是请回吧！\n");
    }
  }
  return ::valid_leave(me, dir);
}
