// grass.c

#include <ansi.h>

inherit ITEM;

int do_make(string);

void create() {
  set_name("翠竹", ({ "bamboo" }));
  set("long", "一根绿油油的翠竹你可以用它来做木筏（zha bamboo)。\n");
  set("unit", "根");
  set("no_sell", 1); set_weight(12000);

}



void init() {
  add_action("do_eat", "eat");
}


int do_eat(string arg) {
  object me = this_player();

  if (!id(arg)) return notify_fail("你要吃什么？\n");

  message_vision("请注意，这不是竹笋！\n", me);

  return 1;

}
