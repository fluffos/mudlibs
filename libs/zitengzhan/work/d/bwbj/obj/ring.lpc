#include <armor.h>
#include <ansi.h>

inherit FINGER;
//#include "chk_owner.lpc"

void create()
{
   set_name(HIG"猫眼"NOR, ({ "cat eyes" }) );
   set_weight(1000);
   if( clonep() )
   set_default_object(__FILE__);
   else {
     set("unit", "只");
      set("no_sell",1);
      set("no_give",1);
      set("no_drop",1);
      set("no_get",1);
       set("value",10);
     set("material", "diamon");
      set("armor_prop/armor",15);
  }
   setup();
}
int query_autoload() { return 1; }
