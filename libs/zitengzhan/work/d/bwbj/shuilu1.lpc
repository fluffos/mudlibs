//水路


#include <room.h>
inherit ROOM;

int bamboo_number;

void create() {
  set("short", "渭水河畔");
  set("long", @LONG
    
一条不是很宽广的沿江山路,路边有一片茂密的竹林(bamboo)
风吹过的时候，叶子舞着沙沙的声音。
LONG);

  set("item_desc", ([ "bamboo": "砍(chop)？\n"
  ]));

  set("exits", ([
    "northdown": __DIR__ "shuilu2",
    "southup": __DIR__ "sl3",
  ]));


  set("objects", ([
  ]));



  set("outdoors", 1);
  setup();
}



void init() {
  bamboo_number = 3;

  add_action("do_chop", "chop");
}


int do_chop(string arg) {
  object me = this_player();
  object bamboo;

  if (!arg || (arg != "bamboo"))
    return notify_fail("你要砍什么？\n");
  else if (bamboo_number == 0)
    return notify_fail("请注意保护生态环境!\n");
  else if (me->query("kee") < 100) {
    me->unconcious();
    return 1;
  } else {
    me->add("kee", -800);
    bamboo = new(__DIR__ "obj/bamboo");
    bamboo->move(me);
    me->start_busy(3); message_vision("$N大喝一声，震断了一棵绿竹。\n", me);
    bamboo_number--;
  }
  return 1;
}
