#include <ansi.h>;
inherit NPC;
#include "star.h"
void create()
{
       set_name("韩 信", ({ "han xin", "hanxin", "han" }) );
        set("gender", "男性" );
        set("long",
                "淮阴侯----韩信\n"
        );
  set("str", 25);
  set("per", 40);
  set("age", 40);
  set("cor", 30);
  set("task",1);
  set("cps", 75);
  set("kar", 100);
  set("int", 40);
  set("family/family_name","五庄观");
   set("con", 40);
  set("spi", 40);
  set("title", HIY"淮阴侯"NOR);
  set("combat_exp", 58000000);
  set("daoxing", 48000000);
  set("max_sen", 36000);
  set("max_kee", 36000);
  set("force", 12000); 
  set("max_force", 6000);
  set("force_factor", 200);
  set("max_mana", 6000);
  set("mana", 6000);
  set("mana_factor", 200);
  set("class","human");   
  set_skill("unarmed", 450);
  set_skill("wuxing-quan", 450);
  set_skill("dodge", 450);
  set_skill("baguazhen", 460);
  set_skill("parry", 450);
  set_skill("sword", 450);
  set_skill("sanqing-jian", 480);
  set_skill("staff", 450);
  set_skill("fumo-zhang", 450);
  set_skill("hammer", 450);
  set_skill("kaishan-chui", 450);
  set_skill("blade", 450);
  set_skill("yange-blade", 450);
  set_skill("force", 450);   
  set_skill("zhenyuan-force", 450);
  set("zjpfm",1);
   set_skill("literate", 450);
   set_skill("spells", 450);
   set_skill("taiyi", 450);
   map_skill("spells", "taiyi");
   map_skill("force", "zhenyuan-force");
   map_skill("unarmed", "wuxing-quan");
   map_skill("sword", "sanqing-jian");
   map_skill("dodge", "baguazhen");
   map_skill("staff", "fumo-zhang");
   map_skill("blade", "yange-blade");
   map_skill("hammer", "kaishan-chui");   
 set("chat_chance_combat", 90);
   set("chat_msg_combat", 
   ({
     (: cast_spell, "zhenhuo" :),
     (: cast_spell, "sanqing" :),
     (: perform_action, "sword","sanqing" :),
     (: perform_action, "sword","jianmang" :),

   }) );


        setup();
   carry_object("/d/obj/weapon/sword/qingfeng")->wield();
   carry_object("/d/obj/armor/jinjia")->wear();
}


void init()
{
        add_action("do_none","perform");
        add_action("do_none","cast");
add_action("do_none","get");
add_action("do_none","recall");
        add_action("do_none","whisper");
        add_action("do_none","ji");
}
int do_none()
{
        object me = this_object();
        message_vision("禁咒的世界，一切都是徒劳!\n",me);
        return 1;
} 


void die()
{

        object ob = query_temp("my_killer");

        if((ob&&ob->query("bieji1/jiu")=="done") && (ob&&ob->query("bieji1/shi")!="done"))
        {
        ob->start_busy(3);
        message("chat",HIG+"【十面埋伏--中军】刘 邦(Liu bang):"+ob->name()+
        "如此张狂，帐下执金吾，取我护甲，孤御驾亲征.\n"NOR,users());
        ob->set("bieji1/shi","done");
        ob->add("bieji1/number",1);
         ob->add("daoxing", 10000);
           ob->save();
         tell_object(ob,"你赢得了十年道行");

        }
message_vision(HIW"只见尸体的脸上露出了诡异的笑容！  \n"NOR,this_object() );
       ::die();
}


