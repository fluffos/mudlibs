#include <ansi.h>;
inherit NPC;

void create()
{
        set_name("刘 邦", ({ "liu bang" }) );
        set("gender", "男性" );
	set("long",
		"汉王----刘 邦\n"
	);
  set("str", 20);
  set("per", 130);
 set("age", 86);
  set("cor", 30);
  set("cps", 75);
  set("kar", 100);
  set("int", 40);
  set("con", 40);
  set("spi", 40);
  set("title", HIY"流氓天子，市井小儿"NOR);
  set("combat_exp", 6800000);
  set("daoxing", 8800000);
  set("max_sen", 16000);
  set("max_kee", 16000);
  set("family/family_name","方寸山三星洞");
set("class","xian");
  set("force", 6000); 
  set("max_force", 6000);
  set("force_factor", 0);
  set("max_mana", 6000);
  set("mana", 6000);
  set("mana_factor", 350);
	
              set_skill("literate", 500);
       set_skill("unarmed", 500);
       set_skill("dodge", 500);
       set_skill("parry", 500);
        set_skill("stick", 500);
        set_skill("sword", 500);
        set_skill("liangyi-sword", 500);
        set_skill("spells", 500);
        set_skill("dao", 500);
        set_skill("puti-zhi", 500);
        set_skill("wuxiangforce", 500);
        set_skill("force", 500);
        set_skill("qianjun-bang", 500);
        set_skill("jindouyun", 500);
        map_skill("spells", "dao");
	map_skill("unarmed", "puti-zhi");
	map_skill("force", "wuxiangforce");
	map_skill("stick", "qianjun-bang");
	map_skill("parry", "qianjun-bang");
	map_skill("dodge", "jindouyun");
	map_skill("sword", "liangyi-sword");
	setup();
   carry_object("/d/obj/weapon/stick/fake-jingubang")->wield();
   carry_object("/d/obj/armor/jinjia")->wear();
}


void init()
{
        add_action("do_none","perform");
        add_action("do_none","cast");
      add_action("do_none","move");
        add_action("do_none","ji");
}
int do_none()
{
        object me = this_object();
        message_vision("禁咒的世界，一切都是徒劳!\n",me);
        return 1;
} 


void die()
{

        object ob = query_temp("my_killer");

        if((ob&&ob->query("bieji1/shi")=="done") && (ob&&ob->query("bieji1/eleven")!="done"))
        {
        ob->start_busy(3);
        message("chat",HIG+"【十面埋伏---汉营】项 羽(Xiang yu):"+ob->name()+
        "逐退小儿，血我之耻，天见可怜，虞，时也命也，楚虽三户，亡汉必楚\n"NOR,users());
        ob->set("bieji1/eleven","done");
        ob->add("bieji1/number",1);
         ob->add("daoxing", 10000);
           ob->save();
         tell_object(ob,"你赢得了十年道行");

        }
message_vision(HIY"只见尸体的脸上露出了诡异的笑容！ \n"NOR,this_object() );
       ::die();
}



