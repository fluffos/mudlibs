#include <ansi.h>

inherit NPC;

void create()
{
  set_name("探 子", ({"tan zi","bing"}));
  set("gender", "男性");
  set("age", 40);
  set("long","这就是古代最早的情报兵了!\n");
  set("attitude", "aggressive");
  set("combat_exp", 5000000);
  set("daoxing", 5000000);
  
  set("no_nk_reward",1);

  set("per", 25);
  set_skill("parry", 280);
  set_skill("unarmed", 280);
  set_skill("dodge", 280);
  set_skill("blade", 280);
  set_skill("fork", 280);
  set_skill("gouhunshu", 300);
  set_skill("tonsillit", 300);
  set_skill("sword", 180);
  set_skill("stick", 180);
  set_skill("ghost-steps", 180);
  set_skill("hammer", 180);
  set_skill("rake", 180);
  set_skill("stick", 180);
  set_skill("staff", 180);
  set_skill("kusang-bang", 300);
map_skill("stick","kusang-bang");
map_skill("parry","jinghun-zhang");
map_skill("dodge","ghost-steps");
map_skill("force","tonsillit");
map_skill("spells","gouhunshu");
  set("max_sen",2400);
  set("max_gee",2400);
  set("max_gin",2400);
  set("force",2400);
  set("max_force",2400);
  set("max_mana",2400);
  set("force_factor",200);
  setup();
  carry_object("/d/koker/obj/baojia")->wear();
carry_object("/d/obj/weapon/stick/bintiegun")->wield();

}

void die ()
{
  object me = this_object();
  object where = environment (me);
  object bone = present ("bone 4",where);

  if (! bone)
  {
    bone = new ("/d/bwbj/obj/bone");
    bone->move(where);
  }

  message_vision ("\n$N倒了下去，只剩下一堆骨架。\n",me);  
  if (! present("tan zi 5",where) &&
      where->query("short")==HIR "十面埋伏" NOR)
  {
         object ob = new ("/d/bwbj/npc/tz"); 
    ob->move(where);
    message_vision ("\n让你见识一下潜伏术的利害！\n",me);   
  }
  destruct (me);  
}

void unconcious ()
{
  die();
}

