//by seawind
inherit NPC;
#include <ansi.h>
int do_ok(string arg);

void create() {
  set_name("兵士", ({ "bing shi", "bing" }));
  set("gender", "男性");
  set("age", 30);
  set("title", HIY "汉军探子" NOR);
  set("long", "一个贼头贼脑的汉军探子。");
  set("per", 20);
  set("str", 50);
  set("attitude", "friendly");
  set("combat_exp", 100000);
  set("max_force", 1000);
  set("force", 1000);
  set("force_factor", 40);
  set("max_kee", 300);
  set("kee", 300);
  set("sen", 300);
  set("max_sen", 300);
  set_skill("unarmed", 80);
  set_skill("parry", 80);
  set_skill("fork", 100);

  set("inquiry", ([
    "探子": "军机不可泄露。",
    "here": "这个地方叫做。。。我也不知道呀。。",
  ]));
  setup();

  carry_object("/d/obj/cloth/luoyi2")->wear();
  carry_object("/d/obj/weapon/spear/muqiang")->wield();
}

void init() {
  object ob = this_player();
  remove_call_out("check");
  call_out("check", 1, ob);
  add_action("do_ok", "ok");
}
void check(object ob) {
  if (this_object()->query("said")) return;
  if (environment()->query("short") == "山郊野岭" && ob->query_temp("tigers_kill") == "yes") {
    command("say 这位英雄真是厉害，是否有意参军，吾愿代为引荐。");
    command("say 军师就在左近，如不嫌弃，请随我一行(ok)？ ");
    this_object()->set("said", 1);
  }
  return;
}
int do_ok(string arg) {
  object me = this_player();
  object ob = this_object();

  if (!me->query_temp("tigers_kill"))
    return 0;
  // if( me->query("bieji1/san") == "done"||me->query("obstacle/er") != "done")
  // {
  // command("say 我还有点事情。\n");
  //command("hehe");
  //  call_out("des",1,ob);
  //  return 0;
  // }
  if (me->query("bieji1/er") == "done") {
    command("say 好吧，那我们走吧。");

    me->move("/d/bwbj/fight3");
    ob->move("/d/bwbj/fight3");
    message_vision(HIR "$N和探子急急的走下山坡。" NOR, me);
    command("say 参见军师，我已将匪徒成功引到！");
    destruct(ob);

    me->delete_temp("tigers_kill");
    return 1;
  }
}
void des() {
  destruct(this_object());
}
