// created by seawind
#include <ansi.h>

inherit NPC;

void create()
{
  set_name("汉 兵", ({"han bing","bing"}));
  set("gender", "男性");
  set("age", 40);
  set("long","一个威风凛凛的汉兵。巡逻在楚河汉界之间!\n");
  set("attitude", "aggressive");
  set("combat_exp", 4000000);
  set("daoxing", 4000000);
  
  set("no_nk_reward",1);

  set("per", 25);
  set_skill("parry", 180);
  set_skill("unarmed", 180);
  set_skill("dodge", 180);
  set_skill("blade", 180);
  set_skill("fork", 180);
  set_skill("gouhunshu", 180);
  set_skill("tonsillit", 180);
  set_skill("sword", 180);
  set_skill("whip", 180);
  set_skill("ghost-steps", 180);
  set_skill("hammer", 180);
  set_skill("rake", 180);
  set_skill("stick", 180);
  set_skill("staff", 180);
  set_skill("jinghun-zhang", 180);
map_skill("unarmed","jinghun-zhang");
map_skill("parry","jinghun-zhang");
map_skill("dodge","ghost-steps");
map_skill("force","tonsillit");
map_skill("spells","gouhunshu");
  set("max_sen",1400);
  set("max_gee",1400);
  set("max_gin",1400);
  set("force",1400);
  set("max_force",1400);
  set("max_mana",1400);
  set("force_factor",200);
  setup();
  carry_object("/d/koker/obj/baojia")->wear();
}

void die ()
{
  object me = this_object();
  object where = environment (me);
  object bone = present ("bone 4",where);

  if (! bone)
  {
    bone = new ("/d/bwbj/obj/bone");
    bone->move(where);
  }

  message_vision ("\n$N倒了下去，只剩下一堆骨架。\n",me);  
  if (! present("han bing 2",where) &&
      where->query("short")==HIW "古战场" NOR)
  {
    object ob = new ("/u/seawind/npc/hanbing");
    ob->move(where);
    message_vision ("\n突然，白骨重新站立了起来！汉兵又复活了！\n",me);   
  }
  destruct (me);  
}



