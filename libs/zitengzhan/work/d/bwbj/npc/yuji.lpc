inherit NPC;
string ask_bawang();
#include <ansi.h>

void create() {
  set_name("虞 姬", ({ "yu ji", "yji", "yu" }));
  set("gender", "女性");
  set("long",
    "其仙袂乍飘兮，闻麝兰之馥郁；荷花欲动兮，听环佩之铿锵。靥笑春
桃兮，云髻堆翠；唇绽樱颗兮，榴齿含香。\n" NOR
  );
  set("str", 25);
  set("per", 40);
  set("age", 18);
  set("cor", 30);
  set("cps", 75);
  set("kar", 100);
  set("int", 40);
  set("family/family_name", "月宫");

  set("con", 40);
  set("spi", 40);
  set("title", HIW "少 女" NOR);
  set("combat_exp", 5800000);
  set("daoxing", 4800000);
  set("max_sen", 6000);
  set("max_kee", 6000);
  set("force", 12000);
  set("max_force", 6000);
  set("force_factor", 200);
  set("max_mana", 15000);
  set("mana", 8000);
  set("mana_factor", 350);

  set_skill("literate", 350);
  set_skill("unarmed", 350);
  set_skill("dodge", 350);
  set_skill("force", 350);
  set_skill("parry", 350);
  set_skill("sword", 350);
  set_skill("spells", 350);
  set_skill("moonshentong", 350);
  set_skill("baihua-zhang", 350);
  set_skill("moonforce", 350);
  set_skill("snowsword", 350);
  set_skill("moondance", 350);
  map_skill("spells", "moonshentong");
  map_skill("unarmed", "baihua-zhang");
  map_skill("force", "moonforce");
  map_skill("sword", "snowsword");
  map_skill("parry", "snowsword");
  map_skill("dodge", "moondance");
  set("chat_chance_combat", 90);
  set("inquiry", ([
    "霸王": (: ask_bawang :) ]));
  setup();
  carry_object("/d/bwbj/obj/ring")->wear();
  carry_object("/d/bwbj/obj/wolfkiss")->wear();
  carry_object("/d/bwbj/obj/yikui")->wear();
}

string ask_bawang() {
  object ring;
  object ob = this_object();
  object me = this_player();
  object where = environment(me);
  if (me->query("bieji1/number") >= 11) {
    if (!me->query("bieji/gift")) {
      message_vision(HIG
        "$N叹道：三生石上空余恨，奈何桥头自彷徨。\n
	$N叹道：是非成败，利禄功名，尽归尘土！\n" NOR, ob, me);
      me->set("bieji/gift", 1);
      me->set("title", MAG "西 楚 霸 王" NOR);
      me->add("daoxing", 2500000);
      me->add("combat_exp", 2800000);
      me->set("yc1", 1);
      me->add("potential", 2300000);
      tell_object(me, BLINK + HIY "得到了2500年道行,280万武学,230万潜能！\n" NOR);
      message_vision(HIW " 虞姬轻轻的叹到，霸王，他可还好？
	$N轻移莲步，施施然向$n走来！在那一刹那间，$n震惊于虞姬那绝世的芳华，脑海一片空白！\n" NOR, ob, me);
    } else {
      if (present("cat eyes", me))
        return "霸王，来生是否还能再见？";
      else {
        command("ok" + me->query("id"));
        ring = new("/d/bwbj/obj/ring.lpc");
        ring->move(me);
        message_vision(HIG "$N缓缓的从手上取下一枚绿色的戒指，轻轻的告诉$n:你一路前来辛苦了，贱妾无以为谢，这枚戒指，唉，你留着吧！\n", ob, me);
      }
    }
  }
  return "大王果然没有走眼。";
}


void init() {
  add_action("do_none", "kill");
  add_action("do_none", "ji");
  add_action("do_none", "cast");
  add_action("do_none", "perform");
  add_action("do_none", "fight");
  add_action("do_none", "steal");
}

int do_none() {
  object me = this_object();
  message_vision("你，唉，你怎么就不开窍呢？\n", me);
  return 1;
}
