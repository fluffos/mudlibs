#include <ansi.h>;
inherit NPC;
#include "star.h"
void create()
{
        set_name("英 布", ({ "ying bu", "ying" }) );
        set("gender", "男性" );
        set("long",
                "降  将---英 布\n"
        );
  set("str", 20);
  set("per", 130);
  set("age", 86);
set("task",1);
  set("cor", 30);
  set("cps", 75);
  set("kar", 1000);
  set("int", 40);
  set("con", 40);
  set("spi", 40);
  set("title", MAG "降  将" NOR);
  set("combat_exp", 40000000);
  set("daoxing", 48000000);
  set("max_sen", 40000);
  set("max_kee", 40000);
  set("family/family_name","昆仑山玉虚洞");
  set("class","xian");
  set("force", 600000); 
  set("max_force", 30000);
  set("force_factor", 100);
  set("max_mana", 30000);
  set("mana", 6000);
  set("mana_factor", 100);
        
  set_skill("literate", 500);
  set_skill("unarmed", 500);
  set_skill("dodge", 500);
  set_skill("parry", 500);
  set_skill("sword", 500);
  set_skill("huntian-jian", 500);
  set_skill("spells", 500);
  set_skill("yuxu-spells", 500);
  set_skill("kaitian-zhang", 500);
  set_skill("xuanzong-force", 500);
  set_skill("force", 500);
        set_skill("lingyunbu", 500);
        set_skill("wugou-jian", 500);
        map_skill("spells", "yuxu-spells");
        map_skill("unarmed", "kaitian-zhang");
        map_skill("force", "xuanzong-force");
        map_skill("parry", "huntian-jian");
        map_skill("dodge", "lingyunbu");
        map_skill("sword", "huntian-jian");
 set("chat_chance_combat", 90);
   set("chat_msg_combat", 
   ({
     (: cast_spell, "fantian" :),
      (: perform_action, "sword","lin" :),
      (: perform_action, "unarmed","po" :),

   }) );

        setup();
   carry_object("/d/obj/weapon/sword/qinghong")->wield();
   carry_object("/d/obj/armor/jinjia")->wear();
}


void init()
{
        add_action("do_none","perform");
        add_action("do_none","cast");
      add_action("do_none","fight");
add_action("do_none","get");
 add_action("do_none","recall");
        add_action("do_none","whisper");
        add_action("do_none","ji");
}
int do_none()
{
        object me = this_object();
        message_vision("禁咒的世界，一切都是徒劳!\n",me);
        return 1;
} 


void die()
{

        object ob = query_temp("my_killer");

        if((ob&&ob->query("bieji1/ba")=="done") && (ob&&ob->query("bieji1/jiu")!="done"))
        {
        ob->start_busy(3);
        message("chat",HIG+"【十面埋伏---中军】韩 信(Ji Fa):"+ob->name()+
        "你这不知死活的黄毛小儿，本帅亲来会你！\n"NOR,users());
        ob->set("bieji1/jiu","done");
        ob->add("bieji1/number",1);
         ob->add("daoxing", 10000);
           ob->save();
         tell_object(ob,"你赢得了十年道行");

        }
message_vision(HIY"$N的尸体上露出诡异的笑容.... \n"NOR,this_object() );
       ::die();
}




