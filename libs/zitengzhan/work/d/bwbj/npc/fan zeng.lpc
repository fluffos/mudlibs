#include <ansi.h>
inherit NPC;
inherit F_MASTER;

string ask_bieji();

void create() {
  set_name(HIW "范 增" NOR, ({ "fan zeng", "zeng" }));
  set("long",
    "亚父--范增。千万年的守侯凝成的鬼气!\n");
  set("title", "亚 父");
  set("gender", "男性");
  set("age", 160);
  set("class", "xian");
  set("attitude", "friendly");
  set("rank_info/respect", "智者");
  set("per", 40);
  set("int", 30);
  set("max_kee", 9000);
  set("max_gin", 6000);
  set("max_sen", 8000);
  set("force", 8000);
  set("max_force", 8000);
  set("force_factor", 500);
  set("max_mana", 6000);
  set("mana", 6000);
  set("mana_factor", 400);
  set("combat_exp", 4000000);
  set("daoxing", 8000000);


  set("eff_dx", 200000);
  set("nkgain", 350);

  set_skill("literate", 480);
  set_skill("unarmed", 480);
  set_skill("dodge", 480);
  set_skill("force", 480);
  set_skill("parry", 480);
  set_skill("sword", 480);
  set_skill("spells", 480);
  set_skill("power", 480);
  set_skill("rukong-zhao", 480);
  set_skill("spirit-power", 480);
  set_skill("yuanwu-kungfu", 480);
  set_skill("wushen-steps", 400);
  map_skill("spells", "spirit-power");
  map_skill("unarmed", "rukong-zhao");
  map_skill("force", "power");
  map_skill("parry", "rukong-zhao");
  map_skill("dodge", "wushen-steps");

  create_family("格斗家", 2, "智囊");

  set("inquiry", ([
  ]));

  set("inquiry", ([

    "项羽": (: ask_bieji :),
    "虞姬": (: ask_bieji :),
    "刘邦": (: ask_bieji :),
  ]));

  setup();

  carry_object("/d/obj/armor/jinjia")->wear();
}

string ask_bieji() {
  object me = this_player();
  object ob = this_object();
  if (me->query("bieji1/yi") != "done") return "你若杀得张良，老夫就送你一程！";
  command("rascal");
  message_vision("$N来回踱了几步，一咬牙，说道：好吧，老夫就算拼了多年年的苦修，也要为霸王再尽一份心力。\n", ob);
  message_vision("$N咬破舌间，吐出一蓬碧血。\n", ob, me);
  tell_object(me, "在那一刹那间，乌骓一声长鸣，带着你再度破空而去。。。\n");
  me->move("/d/bwbj/fight0");
  return "唉！时也命也，谋事在人，成事在天！\n";
}
