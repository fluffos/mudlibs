#include <ansi.h>
#include <room.h>

inherit ROOM;

void create ()
{
  set ("short", HIG "霸王卸甲" NOR);   
  set ("long", @LONG   
   传言中霸王卸甲之地，必卧虎藏龙，可此地却阴气深深，坟茕遍野，哀歌四起,一位白发老者立在旷野之间，身影显的分外孤独!
LONG);

    set("exits", ([ 
                 "south" : __DIR__"end3",
                 ]));
    set("objects",([
                __DIR__"npc/fan zeng" : 1]));
    setup();
}
void init()
{ object ob;
 if( interactive( ob = this_player()))
 call_out("blowing", random(10) + 1, ob);
}
int blowing(object ob)
{
 int i;
 int damage;
        if(  ob && environment(ob) == this_object())
{
 tell_object(this_object(), HIC "\n\n一阵狂风吹过，你觉得眼睛都睁不开了。\n\n" NOR);
  ob->receive_damage("kee", random(100)+100);
 ob->receive_damage("sen", random(100)+100);
 COMBAT_D->report_sen_status(ob);
 if( environment(ob) == this_object())
 call_out("blowing",random(20)+1, ob);
}
 else
 return 1;
}
void reset()
{
 ::reset();
        remove_call_out("blowing");
}
