#include <ansi.h>
#include <room.h>

inherit ROOM;

void create() {
  set("short", HIW "月下小径" NOR);
  set("long", @LONG   
  朦朦的月光下,只见一身穿玄衣的老者,正在策骑狂奔!
LONG);

  set("exits", ([
    "northwest": __DIR__ "sl1",
    //"south" : __DIR__"fight2",
  ]));
  set("objects", ([
    __DIR__ "npc/qb": 4,
    __DIR__ "npc/ma": 5,
    __DIR__ "npc/xiaohe3": 1,
  ]));
  set("no_magic", 1);
  setup();
}
void init() {
  object ob;
  if (interactive(ob = this_player()))
    call_out("blowing", random(10) + 1, ob);
}
int blowing(object ob) {
  int i;
  int damage;
  if (ob && environment(ob) == this_object()) {
    tell_object(this_object(), HIC "\n\n月光撒落在你的身上，你一时觉得一切都是那么的虚无。\n\n" NOR);
    ob->receive_damage("kee", random(100) + 100);
    ob->receive_damage("sen", random(100) + 100);
    COMBAT_D->report_sen_status(ob);
    if (environment(ob) == this_object())
      call_out("blowing", random(20) + 1, ob);
  } else
    return 1;
}
int valid_leave(object me, string dir) {
  object man;
  if (dir == "home" || !man = present("xiao he", environment(me)))
    return ::valid_leave(me, dir);
  if (!living(man)) return ::valid_leave(me, dir);
  if (!me->query_temp("passed")) return notify_fail("萧何长笑道：你？勿要阻路!!!\n");
  return ::valid_leave(me, dir);

}
