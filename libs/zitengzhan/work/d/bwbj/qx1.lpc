

#include <room.h>
inherit ROOM;

void create ()
{
  set ("short", "下邳桥下");
 //1
set ("long", @LONG

到处都是脏兮兮的污泥，哪里去找什么鞋子,试着钻到桥洞里头去看看吧!
LONG); 
  set("position", "桥1");
  set("exits", ([ /* sizeof() == 2 */
  "northeast" : __DIR__"qx2",
  "southwest" : __DIR__"qx8",
]));

//  
  setup();
}

void init()
{
        add_action("do_zuan", "zuan");
}

int do_zuan(string arg)
{       
        object me;
        me=this_player();

        message_vision("$N缓缓的钻进桥洞，mmd,,鞋子怎么会掉这里头了???\n",me);
                me->move("/d/bwbj/qiaodong");
                me->set_temp("enter_position", "桥1");
                tell_room( environment(me), "可怜的你，狼狈不堪的钻进了桥底小洞。\n", ({me}));
                return 1;
}

