#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "青竹林");
  set("long", @LONG
    一望不到边的青竹林，密密葱葱，置身于此，日光都不再耀眼了。一
阵风吹过，竹叶沙沙做响，你似觉得有无数的眼睛在看着你。

LONG
  );
  set("exits", ([
    "northeast": __DIR__ "xianlingdao_24_6",
    "southwest": "/d/shuiyue/miaozhai/miaozhai_6_30",
  ]));
  set("outdoors", "xianlingdao");
  setup();
  //        replace_program(ROOM);
}
