#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "小山坡");
  set("long", @LONG
    一片清幽的小山坡，坡上长满了各色野花，几只彩蝶翩跹飞舞，令人心
醉不已。坡西有一间小凉亭，坡东则是一条小石桥，不知伸向何方。

LONG
  );
  set("exits", ([
    "northeast": __DIR__ "xianlingdao_20_8",
    "south": __DIR__ "xianlingdao_24_6",
    "northwest": __DIR__ "xianlingdao_20_4",
  ]));
  setup();
  //        replace_program(ROOM);
}
