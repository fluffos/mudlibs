#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "树林深处");
  set("long", @LONG
    再往北是个很陡的峭壁，只有一棵千年老树从峭壁下面一直长了上去，
看样子沿着老树可以爬到峭壁上面去(climb)。老树下面有间小茅草屋，里面
似乎有人居住。
LONG
  );
  set("exits", ([
    "southwest": __DIR__ "miaozhai_22_50",
    "enter": __DIR__ "house",
  ]));
  set("objects", ([
    "/d/take/obj/guo": 3,
  ]));
  set("outdoors", "miaozhai");
  setup();
  //        replace_program(ROOM);
}
void init() {
  add_action("do_climb", "climb");
}

int do_climb(string arg) {
  object me;
  me = this_player();
  if (me->is_busy() || me->query_temp("pending"))
    return notify_fail("你现在正忙着呢。\n");
  if (arg != "up")
    return notify_fail("你往哪里爬？\n");

  message_vision(HIY "$N揪着大树枝，一步一步的往大树上面爬。\n" NOR, me);
  if (me->query_skill("dodge") < 420) {
    message_vision(HIR "\n\n只见$N闭上眼睛一个虎跳，离峭壁还差几尺，结果从大树上重重的摔了下来。\n" NOR, me);
    //    me->receive_damage("kee", me->query("kee")-1);
    //    me->receive_damage("sen", me->query("sen")-1);
    me->move(__DIR__ "miaozhai_20_52");
    me->unconcious();
    return 1;
  }
  me->move(__DIR__ "miaozhai_19_52");
  message_vision(HIY "只见$N闭上眼睛一个虎跳，从晃晃悠悠的树干上面跳上了峭壁。\n" NOR, me);
  return 1;
}
