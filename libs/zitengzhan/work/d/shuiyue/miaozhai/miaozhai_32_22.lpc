#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "小溪边");
  set("long", @LONG
一条小溪蜿蜒伸入云雾间,小溪边泊着一只小船(chuan).
LONG
  );
  set("item_desc", ([ /* sizeof() == 1 */
    "chuan": "看样子只能坐下一人的小船上站着一位苗族打扮的姑娘。\n",
  ]));

  set("exits", ([
    //	"enter" : __DIR__"miaozhai_32_20",
    "east": __DIR__ "miaozhai_32_24",
  ]));
  set("outdoors", "miaozhai");
  setup();
  //        replace_program(ROOM);
}
void init() {
  add_action("do_enter", "enter");
}

int do_enter(string arg) {
  object who = this_player();
  if (!arg)
    return notify_fail("你要进到哪里去?\n");
  if (arg == "chuan") {
    message_vision("\n\n$N轻轻一跃,上了小船。\n\n" NOR, who);
    who->move("/d/shuiyue/miaozhai/miaozhai_32_20");
    return 1;
  }
  message_vision("\n$N望着水灵灵的姑娘不由得蹭了蹭口水。\n\n" NOR, who);
  return 1;
}
