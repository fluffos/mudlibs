#include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "树林深处");
        set("long", @LONG
    再往北走比来的路又陡了许多，往南是个峭壁，只有一棵很大很大的树从
下面一直长了上来，沿着大树可以爬下峭壁去(climb)。
LONG
);
        set("exits",([
	"northwest" : __DIR__"miaozhai_17_50",
        ]));
set("outdoors","miaozhai");
        setup();
//        replace_program(ROOM);
}
void init()
{
    add_action("do_climb", "climb");
}
 
int do_climb(string arg)
{
    object me;
    me=this_player();
   if (me->is_busy() || me->query_temp("pending"))
          return notify_fail("你现在正忙着呢。\n");
  if (arg!="down")
      return notify_fail("你往哪里爬？\n");

  message_vision(HIY "$N揪着大树枝，小心翼翼的沿着大树往下爬。\n" NOR, me);
   me->move(__DIR__"miaozhai_20_52");
   message_vision(HIR "只见$N一个不留神从大树上摔了下去，幸好只擦破点皮。\n" NOR, me);
   me->receive_damage("kee", 100);
   me->receive_damage("sen", 100);
   return 1;
}
