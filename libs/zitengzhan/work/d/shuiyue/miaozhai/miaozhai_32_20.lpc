inherit ROOM;
void create() {
  set("short", "小船中");
  set("long", @LONG
一条小船，看样子只能坐下一个人，苗族姑娘好像轻飘飘的站在船头,握着浆.
笑盈盈的看着你,似乎没有一点重量一样.看样子要做她的船还是要问问她过河的事
情。

LONG
  );
  set("exits", ([
    "out": __DIR__ "miaozhai_32_22",
  ]));
  set("objects",
    ([  //sizeof() == 1
    "/d/take/npc/miaonu": 1,
    ]));

  set("outdoors", "shuiyue");
  setup();
  //        replace_program(ROOM);
}
