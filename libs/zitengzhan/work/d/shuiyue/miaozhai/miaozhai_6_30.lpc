#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "小溪尽头");
  set("long", @LONG
     大海中竟然有个小岛,岛上鸟语花香,一片祥和,空气中参合着淡淡的花香
和海水拍起泥土的湿气.小岛的西南方向好像有片陆地,应该可以游过去.(swim)
LONG
  );
  set("exits", ([
    "northeast": "/d/shuiyue/xianlingdao/xianlingdao_26_4",
  ]));
  set("outdoors", "miaozhai");
  setup();
  //        replace_program(ROOM);
}

void init() {
  add_action("do_swim", "swim");
}

int do_swim() {
  object me;
  me = this_player();
  if (me->is_busy() || me->query_temp("pending"))
    return notify_fail("你现在正忙着呢。\n");
  message_vision(HIY "$N跃入海中，没想到海水冰凉刺骨，$N咬着牙向对岸游去。\n" NOR, me);
  me->move(__DIR__ "miaozhai_7_28");
  message_vision(HIY "只见$N浑身湿漉漉地从海中里游了上来。\n" NOR, me);

  me->receive_damage("kee", 300);
  me->receive_damage("sen", 300);
  return 1;
}
