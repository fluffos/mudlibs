#include <ansi.h>
inherit ROOM;
void create()
{
	set("short", HIY"悬崖"NOR);
set("long", @LONG
往下一望,深不见底.云雾缭绕间似乎透着一股仙气.
LONG
);
        set("exits",([
	"south" : __DIR__"shuiyue_14_8",
        ]));
set("outdoors","shuiyue");
        setup();
//        replace_program(ROOM);
}
void init ()
{
  add_action ("do_jump","jump");
}

int do_jump (string arg)
{
  object who = this_player();
  int i;
  i=random(5);
  message_vision (HIR"$N鼓足勇气往下跳去。\n\n\n"NOR,who);
  message_vision (HIR"$N砰地重重摔在下了悬崖。\n"NOR,who);
  who->add("eff_kee",-(who->query("eff_kee")-1));
  who->add("kee",-(who->query("kee")-1));
  who->unconcious();
	 if (i==0)
	{
		 who->move("/d/shuiyue/miaozhai/miaozhai_29_4");
		 return 1;
	}
	who->move("/d/shuiyue/gudi");
  return 1;
}