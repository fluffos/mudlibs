inherit NPC;
#include <ansi.h>

void create() {
  int i, j;
  i = 100;
  j = 50;
  set_name(HIW "黄四郎" NOR, ({ "huang silang", "huang" }));
  set("long", @LONG
欺压一方
LONG);
  set("gender", "男性");
  set("title", HIW "狂欠扁" NOR);
  set("age", 30);
  set("attitude", "aggressive");
  set("class", "yaomo");
  set("ljs_boss", 1);
  set("max_kee", 1200);
  set("max_sen", 1200);
  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 0);
  set("max_mana", 2000);
  set("mana", 2000);
  set("mana_factor", 0);
  //     add_temp("apply/damage", 200+random(150));
  //    add_temp("apply/armor", 300+random(300));
  //      add_temp("apply/armor_vs_force",300+random(300));
  //      add_temp("apply/armor_vs_spells",300+random(300));
  set("combat_exp", 250000);
  set("daoxing", 250000);
  set("baolv", 2);
  set("haveexp", 35000);
  set("family/family_name", "阎罗地府");
  set_skill("unarmed", i + random(j));
  set_skill("dodge", i + random(j));
  set_skill("parry", i + random(j));
  set_skill("force", i + random(j));
  set_skill("spells", i + random(j));

  set_skill("whip", i + random(j));
  set_skill("hellfire-whip", i + random(j));
  set_skill("stick", i + random(j));
  set_skill("kusang-bang", i + random(j));
  set_skill("sword", i + random(j));
  set_skill("zhuihun-sword", i + random(j));
  set_skill("ghost-steps", i + random(j));
  set_skill("jinghun-zhang", i + random(j));
  set_skill("tonsillit", i + random(j));
  set_skill("gouhunshu", i + random(j));

  map_skill("force", "tonsillit");
  map_skill("whip", "hellfire-whip");
  map_skill("sword", "zhuihun-sword");
  map_skill("whip", "hellfire-whip");
  map_skill("stick", "kusang-bang");
  map_skill("parry", "zhuihun-sword");
  map_skill("spells", "gouhunshu");
  map_skill("dodge", "ghost-steps");
  map_skill("unarmed", "jinghun-zhang");
  setup();
  carry_object("/d/obj/weapon/18weapon.lpc")->wield();
}
void kill_ob(object ob) {
  object me = this_object();
  set_temp("my_killer", ob);
  ::kill_ob(ob);
}

void init() {

  ::init();
  add_action("do_no", "ji");
}

int do_qk(string arg) {

  string cast_id, cast_name;
  object who = this_player();

  if (sscanf(arg, "%s on %s", cast_id, cast_name) == 2)

    if (cast_id == "qiankun" || arg == "qiankun")

      tell_object(who, "你不能这么做！\n");
  return 1;


}
int do_no(string arg) {
  object who = this_player();
  object me = this_object();
  message_vision("$N鬼鬼遂遂不知想干什么，$n警惕的盯着$N。\n", who, me);
  return 1;
}


void heart_beat() {
  object ob = this_object();
  object *inv;
  object env = environment(ob);
  object *enemy;
  int k, size, j;
  if (env) size = sizeof(inv = all_inventory(env));
  ::heart_beat();
  if (query("eff_kee") < query("max_kee")) {
    for (int i = 3; i > 0; i--) {
      carry_object("/d/npc/vr_room/obj/jinchuangyao.lpc"); command("eat jinchuang yao"); command("exert recover");
    }
  }

  if (query("eff_sen") < query("max_sen")) {
    for (int i = 3; i > 0; i--) {
      carry_object("/d/npc/vr_room/obj/hunyuandan.lpc"); command("eat hunyuan dan"); command("exert refresh");
    }
  }
  if (is_fighting() && query("force") < query("max_force") / 2)
    command("cast transfer");
  if (query("kee") < query("eff_kee") - 10)
    command("exert recover");
  if (query("sen") < query("eff_sen") - 10)
    command("exert refresh");
  if (!is_fighting() && query("force") < query("max_force"))
    set("force", (int)query("max_force"));
  if (!is_fighting() && query("mana") < query("max_mana"))
    set("mana", (int)query("max_mana"));
  if (ob && size) {
    for (j = 0; j < size; j++) {
      if (inv[j]->is_corpse())
        command("cast animate on corpse");
    }
  }


  if (is_fighting()) {
    enemy = ob->query_enemy();
    if (sizeof(enemy)) {
      for (j = 0; j < sizeof(enemy); j++) {
        command("gongji " + enemy[j]->query("id"));
      }
    }
    if (!ob->query_temp("ldlh")) command("perform ldlh");
    k = random(7);
    if (k > 6) k = 6;
    switch (k) {
      case 0:
        command("cast inferno"); break;
      case 1:
        command("perform cmwl"); break;
      case 2:
        command("cast miehun"); break;
      case 3:
        command("cast gouhun"); break;
      case 4:
        command("perform three"); break;
      case 5:
        command("perform xingyun"); break;
      case 6:
        command("perform yanluo"); break;
      default: return 0;
    }
  }
}

void die() {
  object me = this_object();
  object ps;
  string err;
  object newitem;
  object killer = query_temp("last_damage_from");
  int exp, baolv, pot, d;
  if (objectp(killer) && killer->query("is_guard") == 1)
    killer = killer->query("possessed");
  if (objectp(killer)) {
    exp = query("haveexp");
    exp = exp / 2 + random(exp / 2);
    pot = exp / 3;
    killer->add("combat_exp", exp);
    killer->add("daoxing", exp);
    killer->add("potential", pot);
    baolv = query("baolv");
    if (random(baolv) == 0) {
      d = random(6);
      if (d > 5) d = 5;
      switch (d) {
        case 0: ps = new("/d/npc/vr_room/obj/bs_zf.lpc"); break;
        case 1: ps = new("/d/npc/vr_room/obj/bs_lh.lpc"); break;
        case 2: ps = new("/d/npc/vr_room/obj/bs_fsl.lpc"); break;
        case 3: ps = new("/d/npc/vr_room/obj/bs_tq.lpc"); break;
        case 4: ps = new("/d/npc/vr_room/obj/bs_tj.lpc"); break;
        case 5: ps = new("/u/xdao/ljs/obj/stone.lpc"); break;
        default: ps = new("/d/npc/vr_room/obj/baoshi.lpc");
      }
      if (objectp(ps)) ps->move(me);
    } else {
      ps = new("/obj/money/silver.lpc");
      if (objectp(ps)) {
        ps->set_amount(random(50));
        ps->move(me);
      }
    }
    tell_object(killer, HIM "你得到了" + chinese_number(exp)
      + "点武学经验" + chinese_number(pot) +
      "点潜能、" + COMBAT_D->chinese_daoxing(exp) + "道行的奖励!\n" NOR);
    TEAMK_D->teamk(killer, exp);
    killer->set_temp("mieyao/level", 12);
    err = catch(newitem = NEWITEMS_OB->get_item(me, killer));
    message_vision(
      "$N杀死$n得到了一" + newitem->query("unit") + newitem->query("name") + "。\n",
      killer,
      me
    );
    newitem->move(killer);
  }
  set("eff_kee", query("max_kee"));
  set("kee", query("max_kee"));
  set("eff_sen", query("max_sen"));
  set("sen", query("max_sen"));
}
