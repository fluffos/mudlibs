#include <ansi.h>
inherit "/d/snowtu/npc/super_npc.lpc";

void create() {
  mapping name = NAME_D->random_name("male");
  if (!name)
    set_name("张三", ({ "zhang san", "zhang" }));
  else set_name(name["name"], name["id"]);
  create_family("长安镖局", 3, "镖师");
  set("family/family_name", "将军府");
  set("long", "长安武馆弟子，后来做了镖头。");
  set("age", random(20) + 20);
  set("str", 26);
  set("int", 28);
  set("con", 26);
  set("dex", 26);

  set("max_sen", 1000);
  set("max_kee", 1000);
  set("force", 1600);
  set("max_force", 800);
  set("force_factor", 100);
  set("combat_exp", 800000);
  set("daoxing", 800000);

  set_skill("spear", 100);
  set_skill("force", 100);
  set_skill("dodge", 100);
  set_skill("parry", 100);
  set_skill("yanxing-steps", 100);
  set_skill("bawang-qiang", 100);
  set_skill("lengquan-force", 100);
  set_skill("unarmed", 100);
  set_skill("changquan", 100);

  map_skill("force", "lengquan-force");
  map_skill("unarmed", "changquan");
  map_skill("spear", "bawang-qiang");
  map_skill("parry", "bawang-qiang");
  map_skill("dodge", "yanxing-steps");

  setup();
  add_money("gold", 2);
  carry_object("/d/city/npc/obj/armor")->wear();
  carry_object("/d/city/npc/obj/spear")->wield();
}

int heal_up() {
  object owner;
  owner = query("temp/owner");
  if (!owner || !living(owner) || !owner->is_character()) {
    say(name() + "说道：总镖头有事，我还是回去看看。\n");
    call_out("leave", 1);
    return 1;
  }
  if (time() > this_object()->query("temp/time") + this_object()->query("temp/start")) {
    say(name() + "说道：唉，走镖时间已过，我还是回去挨总镖头的训吧。\n");
    call_out("leave", 1);
    return 1;
  }
  return ::heal_up() + 1;
}

void leave() {
  message("vision", "\n" + name() + "一路小跑，急急忙忙的离开了。\n\n" NOR, environment(), this_object());
  destruct(this_object());
}

void unconcious() {
  command("die");
  leave();
}

void die() {
  unconcious();
}

int invocation(object me) {
  mapping skills;
  string *skill;
  int i, lvl;
  if (!me)
    return 0;
  if (query("temp/owner"))
    return 0;
  if (!living(me))
    return 0;
  if (!objectp(environment(me)))
    return 0;
  if (!me->query_temp("压镖/start"))  //没有接压镖任务的
    return 0;
  lvl = SDS_D->maxSkill(me);
  if (lvl < 100)
    lvl = 100;

  skills = query_skills();
  skill = keys(skills);
  for (i = 0; i < sizeof(skill); i++)
    this_object()->set_skill(skill[i], lvl);

  this_object()->add("max_kee", me->query("max_kee") / 10);
  this_object()->add("max_sen", me->query("max_sen") / 10);
  this_object()->add("max_force", me->query("max_force") / 40);
  this_object()->add("max_mana", me->query("max_mana") / 30);
  SDS_D->powerup(this_object());

  this_object()->set("temp/owner", me);
  this_object()->set("temp/start", me->query_temp("压镖/start"));
  this_object()->set("temp/time", me->query_temp("压镖/time"));

  if (!this_object()->move(environment(me))) {
    destruct(this_object());
    return 0;
  }

  message("vision", "\n只见堂下人声鼎沸，人群一分，" + name() + "径直走了出来，对着堂上作揖说道："
    +RANK_D->query_self(this_object()) + "愿意陪" + me->name() + RANK_D->query_respect(me) + "走这趟镖！\n", environment(), this_object());

  me->set("压镖/biaoshi", this_object());
  return 1;
}
