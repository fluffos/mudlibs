string do_job();
string do_cancel();

void create() {
  set_name("范左成", ({ "fan zuocheng", "fan", "zuocheng" }));
  set("gender", "男性");
  set("age", 55);
  create_family("长安镖局", 2, "总镖头");
  set("long", "他就是「长安镖局」的总镖头－－范左成。长安范家长子，从少林寺满师回来后就担任了
总镖头一职。\n");
  set("combat_exp", 30000000);
  set("max_force", 2000);
  set("force", 1000);
  set("force_factor", 600);
  set("family/family_name", "少林寺");
  set("per", 19);
  set("str", 35);
  set("kar", 39);

  set_skill("banruo-zhang", 280);
  set_skill("jingang-leg", 280);
  set_skill("yijinjing", 300);
  set_skill("chanzong", 300);
  set_skill("force", 300);
  set_skill("literate", 300);
  set_skill("spells", 300);
  set_skill("unarmed", 280);
  set_skill("dodge", 280);
  set_skill("shaolin-shenfa", 280);
  set_skill("parry", 280);
  map_skill("unarmed", "banruo-zhang");
  map_skill("parry", "jingang-leg");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("force", "yijinjing");
  map_skill("spells", "chanzong");

  set("inquiry", ([
    "运镖": (: do_job :),
    //      "护送" : (: do_job2:),        
    "放弃": (: do_cancel :),
  ]));
  setup();
  carry_object("/d/city/npc/obj/armor")->wear();
  carry_object("/d/city/npc/obj/stick")->wield();
  add_temp("apply/attack", 50);
  add_temp("apply/armor", 50);
  add_temp("apply/damage", 50);
}

string check_place(string dir) {
  int i;
  string *str, *dirs;
  if (!dir || !stringp(dir))
    return 0;
  dirs = values(place);
  if (member_array(dir, dirs) == -1)
    return 0;
  str = keys(place);
  for (i = 0; i < sizeof(str); i++) {
    if (place[str[i]] == dir)
      return str[i];
  }
  return 0;
}

object random_place(object me) {
  int i, j, k;
  object newob;
  string *dirs;
  mixed *file, exit;
  if (!me) return 0;
  dirs = values(place);
  if (!sizeof(dirs)) return 0;
  if (!sizeof(dirs)) return 0;

  i = random(sizeof(dirs));
  file = get_dir(dirs[i] + "*.lpc", -1);
  if (!sizeof(file)) {
    if (wizardp(me))
      write("size of file <0\n");
    return 0;
  }
  for (k = 0; k < 30; k++) {
    j = random(sizeof(file));
    if (file[j][1] > 0) {
      newob = load_object(dirs[i] + file[j][0]);
      if (newob) {
        if (!(exit = newob->query("exits")) || sizeof(exit) < 1)
          continue;
        else {
          me->set_temp("压镖/place", newob);
          me->set_temp("压镖/place_dir", dirs[i]);
          return newob;
        }
      } else {
        if (wizardp(me))
          write("can not find room in the dir\n");
        return 0;
      }
    } else {
      if (wizardp(me))
        write("no file.\n");
      return 0;
    }
  }
  return 0;
}

string do_job() {
  object env, npc, obj, me = this_player();
  string str, dir;
  //有任务的
  me->set("yuanbiaoask", time());
  if (mapp(me->query_temp("压镖"))) {
    if (!me->query_temp("压镖/done")) {
      str = "不是让你陪同";
      if (objectp(npc = me->query_temp("压镖/biaoshi")))
        str += npc->name();
      else str += "镖师";
      str += "一起将";
      if (objectp(obj = me->query_temp("压镖/biao")))
        str += obj->name();
      else str += "镖车";
      str += "压往";
      if (stringp(dir = me->query_temp("压镖/place_dir")))
        str += check_place(dir);
      else str += "某处";
      str += "吗?";
      return str;
    } else "恩，你已顺利完成任务。";
  }

  if (time() < query("biao_start") + 10) {
    message_vision("刚刚有人押了镖去了，你先下去歇歇。。。\n", me);
    me->move("d/city/wuguan");
    return "";
  }
  if (me->query("level") * 250000 < me->query("combat_exp"))
    return "你的等级不足，去运镖恐怕有些危险。\n";
  env = random_place(me);
  if (!env || !objectp(env)) {
    me->delete_temp("压镖");
    return "这位" + RANK_D->query_respect(me) + "，目前没有地方需要送镖。";
  }
  /*----------------------
镖车里有如下数据:
set_temp("temp/start",me->query("压镖/start"));
set_temp("temp/time",me->query("压镖/time"));
所以OBJ的invocation函数里
要记得 将这两个数据 
赋值给player
-----------------------*/
  obj = new(__DIR__ "biao");
  me->set_leader(0);
  if (!obj)
    return "这位" + RANK_D->query_respect(me) + "，目前没有镖需要压送。";

  if (!obj->invocation(me)) {
    me->delete_temp("压镖");
    destruct(obj);
    return "这位" + RANK_D->query_respect(me) + "，目前没有合适的镖需要压送。";
  }
  /*                
npc = new(__DIR__"biaoshi");
if ( !npc )
        return "这位"+RANK_D->query_respect(me)+"，目前镖局暂无镖师协助。";
if ( !npc->invocation(me) )
        {
        me->delete_temp("压镖");
        destruct(npc);  
        return "这位"+RANK_D->query_respect(me)+"，目前镖局暂无合适镖师协助。";
        }
*/
  say(name() + "手捻银髯，点了点头。\n");
  set("biao_start", time());
  return "你便在" + FINGER_D->age_string(me->query_temp("压镖/time")) + "内将" + obj->name() + "压往" + check_place(me->query_temp("压镖/place_dir")) + "吧。";
}

string do_cancel() {
  object me = this_player();
  if (!mapp(me->query_temp("压镖")))
    return "你有要任务吗？";
  message_vision(CYN "$n" CYN "对着$N" CYN "叹了口气，不知道哪里不对了。\n" NOR, me, this_object());
  me->delete_temp("压镖");
  me->add("压镖/success", -random(2));
  me->set("压镖/cancel", time());
  me->add("压镖/lost", 1);
  set("biao_start", time());
  return "算了，我还是另找能人吧。";
}
void init() {
  add_action("do_quest", "quest");
}

int do_quest() {
  object me = this_player();
  string msg;

  if (!me->query("压镖"))
    msg = "没有运过镖。";
  else {
    msg = "共运送过" + chinese_number(me->query("压镖/success") + me->query("压镖/lost")) + "次镖车，";
    msg += "完成率为" + me->query("压镖/success") * 100 / (me->query("压镖/success") + me->query("压镖/lost")) + "%";
  }
  msg = CYN + name() + CYN "对你说道：" WHT + msg + NOR "\n";
  tell_object(me, msg);
  return 1;
}
