#include <ansi.h>
inherit __DIR__ "k.lpc";
#include <family.h>

string *names = ({
  "土匪", "tu fei", "fei",
  "盗贼", "dao zei", "zei",
  "路霸", "lu ba", "ba",
  "逃犯", "tao fan", "fan",
  "强盗", "qiang dao", "dao",
  "恶霸", "e ba", "ba",
});

void create() {
  object ob;
  mapping mm;
  string name, id1, id2;
  int i;
  i = random(sizeof(names) / 3) * 3;
  name = names[i];
  id1 = names[i + 1];
  id2 = names[i + 2];

  mm = NAME_D->random_name(({ "male", "yaoguai", "japan" })[random(3)]);
  if (mm && mapp(mm)) {
    set_name(mm["name"], mm["id"]);
    set("title", stringp(mm["title"]) ? mm["title"] : "");
  } else set_name(name, ({ id1, id2 }));
  set("long", "凶神恶煞般一个土人，他目露凶光，满脸横肉。\n");
  set("age", 20 + random(20));
  set("per", random(20));
  set("gender", "男性");
  set("biao", 1);
  set("env/combat_brief", 1);
  set_temp("apply/dodge", 30);
  set_temp("apply/attack", 30);
  set_temp("apply/parry", 30);
  set_temp("apply/damage", 200);
  set_temp("apply/armor", 200);
  ob = new("/d/wizz/yhq/lianhua/armor");
  ob->move(this_object());
  ob = new("/d/wizz/yhq/lianhua/cloth");
  ob->move(this_object());
  ob = new("/d/wizz/yhq/lianhua/shoes");
  ob->move(this_object());
  ob = new("/d/wizz/yhq/lianhua/pifeng");
  ob->move(this_object());
  command("wear all");
  setup();
}

int copy_data(object me) {
  string fam, cls, *skills, *fams;
  object weapon;
  mapping skill;
  int i, lvl;

  if (!me)
    return 0;
  lvl = me->query_skill("force", 1);
  if (random(10)) lvl = lvl * 2 / 3 + random(lvl / 3);
  else lvl += lvl / 3;
  if (lvl < 150)
    lvl = 150;
  fams = keys(familys);
  fam = fams[random(sizeof(fams))];
  cls = familys[fam]["class"];
  skills = familys[fam]["skills"];
  weapon = new(familys[fam]["weapon"]);
  if (weapon && weapon->move(this_object())) command("wield all");
  create_family(fam, 2 + random(10), "外家弟子");
  set("class", cls);
  i = sizeof(skills);
  while (i--) {
    if (i % 2 == 0) {
      set_skill(skills[i], lvl);
      set_skill(skills[i + 1], lvl);
      map_skill(skills[i], skills[i + 1]);
    }
  }
  set("max_kee", me->query("max_kee") + lvl / 3 * 20);
  set("max_sen", me->query("max_sen") + lvl / 3 * 20);
  set("max_force", query_skill(query_skill_mapped("force")) * 10);
  set("max_mana", query_skill(query_skill_mapped("spells")) * 10);
  if (fam == "月宫")
    set("force_factor", 0);
  else set("force_factor", query_skill(query_skill_mapped("force")) / 3 * 2);
  set("mana_factor", query_skill(query_skill_mapped("spells")));
  set("combat_exp", me->query("combat_exp") / 2 * 3);
  set("daoxing", me->query("daoxing") / 2 * 3);

  set_temp("apply", me->query_temp("apply"));
  set("level", me->query("level"));

  set("str", 10 + random(40));
  set("spi", 10 + random(40));
  set("per", 10 + random(40));
  set("kar", 10 + random(40));
  set("cps", 5 + random(40));
  set("cor", 10 + random(40));
  set("con", 10 + random(40));
  set("int", 5 + random(40));
  SDS_D->powerup(this_object());
  this_object()->save();
  this_object()->move(environment(me));
  this_object()->command("wear all");
  return 1;
}

int invocation(object me) {
  if (!me)
    return 0;
  return copy_data(me);
}


void die() {
  string msg;
  object me;
  me = query_temp("last_damage_from");

  say("\n\n" + name() + "”啪“的一声摔倒在地！\n\n");
  COMBAT_D->announce(this_object(), "revive");
  message("system", HIY "\n慢慢地你终于又有了知觉．．．\n\n" NOR, this_object());
  say("\n\n" + name() + "爬起身来，一转身跑的不见了。。。。\n\n");
  if (me && me == query("temp/owner") && present(me, environment())) {
    me->add_temp("压镖/killer", 1);
    msg = sprintf(YEL "┣" HIW " 长安护镖" NOR YEL " ┫范左成(Fan) ：" WHT "%s " YEL "护镖有功，将劫镖贼" MAG " %s " WHT "%s " YEL "杀的狼狈而逃，天佑东土。\n" NOR,
      me->query("name"), (query("family/family_name") ? (query("family/family_name") + RED "孽徒") : ""), name());
    if (me->query_temp("压镖/killer") <= 10)
      tell_object(me, YEL "\n你杀死了一个劫镖贼，你的功勋增加了。\n");
    // message("channel:chat",msg,users());
  }
  destruct(this_object());
}


void init() {
  add_action("do_cmds", "", 1);
  add_action("do_halt", "halt");
  add_action("do_go", "go");
}

int do_go(string arg) {
  object me = this_player();
  if (me != query("temp/owner") || environment(me)->query("no_fight"))
    return 0;
  if (time() - query("killer") >= 120) {
    this_object()->die();
    return 0;
  }
  message_vision("$n一把拉住$N，把$P往死里掐“哪里走？！”\n", me, this_object());
  return 1;
}

int do_cmds(string verb) {
  string *cmds;
  object me = this_player();
  verb = query_verb();
  if (me != query("temp/owner") || wizardp(me))
    return 0;
  cmds = ({
    "go", "hp", "inventory", "look", "halt",
    "skills", "score", "home", "fly",
    "kill", "perform", "exert", "cast",          //保证仙族也能yunbiao
    "chat", "chat*", "say", "tell",
    "check", "wear", "remove", "wield",
    "unwield", "mount", "recall",
    "huhuan", "huan", "enchant", "enforce", "surrender",
    "shield", "zhenshens", "smash", "aim", "shoot", "eat", "enable", "jifa",
  });

  if (member_array(verb, cmds) == -1) {
    message_vision("$n一把拉住$N，把$P往死里掐：“留下买路钱！”\n", me, this_object());
    return 1;
  }
  return 0;
}

int heal_up() {
  if (!query("temp/owner")) {
    die();
    return 0;
  }
  if (!(query("temp/owner"))->query_temp("压镖")
    || !living(query("temp/owner"))) {
    delete_temp("last_damage_from");
    die();
    return 0;
  }
  return ::heal_up() + 1;
}

int do_halt() {
  object me = this_player();
  if (me != query("temp/owner"))
    return 0;
  if (!me->query_temp("压镖"))
    return 0;
  message_vision("$N见强盗横行，不由长叹一声：罢了，既然如此，我也放弃了！\n\n", me);
  command(":D " + me->query("id"));
  message_vision("$N哈哈一笑：算你识相。。。。\n\n", this_object());
  me->delete_temp("压镖");
  me->add("压镖/lost", 1);
  destruct(this_object());
  return 1;
}
