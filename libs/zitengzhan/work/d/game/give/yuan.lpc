void create()
{
set_name("袁天罡", ({"yuan tiangang", "yuan"}));
set("gender", "男性" );
set("age", 33);
set("long","袁天罡是天监台总管，听说他法术高深。
他为人正直仗义，脸上总是一股忧国忧民的神情。\n");
set("int", 30);
set("per", 25);
set("combat_exp", 5000000);
set("daoxing", 8000000);
        
        // discourage NK yuan.
set("eff_dx",1000);
set("nkgain",1);
set("env/wimpy",100);

set("attitude", "friendly");
set("title", "天监台正先生");

set_skill("unarmed",260);
set_skill("dodge", 250);
set_skill("parry", 150);
set_skill("spells", 200);
set_skill("baguazhou", 200);
set_skill("literate", 250);
set_skill("sword", 260);  
set_skill("changquan", 250);  

map_skill("spells", "baguazhou");
map_skill("unarmed", "changquan");

set("max_kee", 4000);
set("max_sen", 4000);
set("force", 5000);
set("max_force", 2500);
set("force_factor", 100);
set("mana", 6000);
set("max_mana", 3000);
set("mana_factor", 100);

set("chat_chance",5);
set("chat_msg", ({
        name()+"叹道：生逢乱世，妖魔横行啊！\n",
        name()+"问道：可有谁愿去为神仙寻宝？\n",
                    }));

seteuid(getuid());

set("inquiry", ([
        "寻宝" : (: work_me :),
        "取消" : (: cancel_me :),
        ]));

setup();
add_money("gold", 5);
carry_object("/d/obj/cloth/baguapao")->wear();
carry_object("/d/obj/weapon/sword/taomujian")->wield();
}

int accept_fight(object me)
{
write("袁天罡凛然道：学武乃是为了强身，不是打打杀杀！\n");
return 0;
}

int recognize_apprentice(object me)
{
if((int)me->query("yuan-learn"))
        return 1;
return notify_fail("袁天罡说道：您太客气了，这怎么敢当？\n");
}

int accept_object(object who,object ob)
{
int wx,pot,dx,t,tt,k;     

if ( ob==who->query("袁-送物/obj") )
        {
        t = time()-who->query("袁-送物/start");  
        tt = who->query("袁-送物/time"); 
        if ( wizardp(who) )  tell_object(who,"time()-start = "+t+",limit time = "+tt+"\n");
        if ( t>tt )
                {
                say(name()+"叹了口气：唉，东西是这东西，可惜你的时间用完了。\n");
                    call_out("destroy", 1, ob); 
                }
        else    {
               k = 1+tt-t;
                wx = (who->query("combat_exp")/1500000+1)*k*3/2;
                    call_out("destroy", 1, ob); 
                wx/= bt;
                if ( wx>2000 )
                        wx = 1000+random(1000);
                dx = wx/2+random(wx*2);
                pot = wx/10+random(wx/3);
                     who->add("combat_exp",wx*2); 
who->add("balance",50000);
                who->add("daoxing",dx);
                who->add("potential",pot*3);
                say(name()+"惊讶的说道：正是这个，我得给 "+ob->query("myowner")+" 送去。。。。\n");
                message("channel:chat",sprintf(YEL"┣ "HIG"送物"NOR YEL" ┫%s(%s)："WHT"%s "YEL"寻得 "HIR"%s"NOR YEL" 的"WHT" %s"YEL" ，耗时 "WHT+FINGER_D->age_string(t)+YEL" ，特奖励"WHT" %d "YEL"点武学经验、"WHT"%s "YEL"道行和 "WHT" %d "YEL"点潜能。\n"NOR,
                                                name(),capitalize(query("id")),
                                                who->query("name"),
                                                ob->query("myowner")?ob->query("myowner"):"神仙",ob->name(),
                                                wx,
                                                COMBAT_D->chinese_daoxing(dx),
                                                pot, ),
                        users());
                }
        who->delete("袁-送物"); 
      who->add("yuan_gived_num",1);
        who->save();
        return 1;
        }               
if (ob->query("id")=="fan he")
        {
        if (((string)who->query("family/family_name")=="将军府"))
                {
                who->set("yuan-learn", 1);
                write("袁天罡笑道：将军看起来一表人才，以后定是人前出头之辈！
袁天罡略为沉思，又道：若将军有何问题，可随时和我商讨，天罡若是知晓，定会答复．\n");
                call_out("destroy", 1, ob);
                return 1;
                }
        if (((string)who->query("family/family_name")!="将军府"))
                {
                command("say 多谢多谢，我正饿着哪！");
                command("give 1 silver to " + who->query("id"));                      
                call_out("destroy", 1, ob);
                return 1;
                }
        }
else return 0;
}

void destroy(object ob)
{
destruct(ob);
return;
}

object random_room()
{
int  i, j,k;
object newob;
mixed*  file, exit;
if( !sizeof(dirs) )  return 0;
if( !sizeof(dirs) )  return 0;

i = random(sizeof(dirs));    
file = get_dir( dirs[i]+"/*.lpc", -1 );
if( !sizeof(file) )
        {
        write("size of file <0\n");     
        return 0;
        }
for(k=0;k<30;k++) 
        { 
        j = random(sizeof(file));
        if( file[j][1] > 0 ) 
                {
                newob = load_object(dirs[i]+file[j][0]);
                if (newob) 
                        {  
                        if( newob->query("no_fight") || newob->query("no_magic") 
                         || !(exit=newob->query("exits")) || sizeof(exit)<1 
                        || sizeof(all_inventory(newob))<1 )
                                continue;
                        else    return newob;
                        }
                }
        else    {
                write("no file.\n");
                return 0;
                }       
        }
return 0;
}
        
string random_place(object ob,object me)
{
int  i, flag =0;
object  npc,newob,*inv;
string where;
int t;
        
if ( !ob || !me || !present(me,environment()) )
        return 0;

newob = random_room();

if ( !newob || !objectp(newob) )
        return 0;
        
inv = all_inventory(newob);
for(i=0;i<sizeof(inv);i++)
        {
        if ( inv[i] )
                {
                if ( userp(inv[i])
                  || !living(inv[i]) )
                        continue;
                else    {
                        npc = inv[i];   
                        flag++;
                        break;
                        }
                if ( flag )
                        break;
                }
        }
                                
if ( npc )
        {
        if ( ob->move(npc) )
                {
                me->set("袁-送物/obj",ob);
                me->set("袁-送物/start",time());
                me->set("袁-送物/place",MISC_D->find_place(environment(npc)));
                t = 60+me->query_kar()+random(me->query_kar());
                t*= bt;
                where = ob->short()+"目前流落在 ";      
                where+= YEL+MISC_D->find_place(newob)+NOR" 的";
     if ( (me->query("kar")/60)+random(me->query_kar())>=25 )    where+= YEL" "+npc->name()+NOR"("+capitalize(npc->query("id"))+") 身上，";   
                  else    {where+= YEL" 某某 身上，"; t = t+(random(t)*2);  }
                me->set("袁-送物/time",t);
                where+= "请这位"+RANK_D->query_respect(me)+"在 "HIW+FINGER_D->age_string(t)+" 内去将之寻来与吾。。。";
                return where;
                }
        else    {
                write("can not move to npc.\n");
                 call_out("destroy", 1, ob);
                return 0;
                }
        }
else    {
        write("no npc.\n");
                 call_out("destroy", 1, ob);
        return 0;
        }
}

string work_me()
{
object obj, me;
string where;
mapping sw;

me = this_player();
sw = me->query("袁-送物");
if ( sw )
        return "不是让你去将"+(sw["obj"]?sw["obj"]->short():"东西")+CYN"从"+(sw["place"]?sw["place"]:"那里")+"拿来交给我吗？";
  if ( time()<me->query("yuan_cancel")+8 )  return "你刚刚失败过，还是休息休息吧。";
obj = new(__DIR__"item");
if ( !obj )
        return "目前没有任务，你还是等会再来吧。";
obj->move(this_object());
where = random_place(obj,me);
if ( !where || !stringp(where) )
        return "目前还没有任务，你等会再来吧。";
me->delete_temp("yuan_cancel");
return where;
}

string cancel_me()
{
object me = this_player();
if ( !mapp(me->query("袁-送物")) )
     return "你说什么？我不懂。。。";
me->delete("袁-送物");
me->set("yuan_cancel",time());
me->add_temp("yuan_cancel",1);
if ( me->query_temp("yuan_cancel")>3 )
      me->add("yuan_gived_num",-1);
return "你真是没用！";
}

void init()
{
add_action("do_quest","quest");
add_action("do_time","time");
}

int do_quest(object me)
{
me = this_player();
if ( me->query("yuan_gived_num")<0 )
        me->delete("yuan_gived_num");
if ( !me->query("yuan_gived_num") )
    {
    tell_object(me,"你还没有开始为"+name()+"寻找宝贝。\n");
    }
else    tell_object(me,"你已为"+name()+"寻找了 "HIW+chinese_number(me->query("yuan_gived_num"))+NOR" 个宝贝了。\n");
return 1;
}

int do_time(string arg)
{
object me = this_player();
int num;
if ( !wizardp(me) )
   return 0;
if ( !arg || sscanf(arg,"%d",num)!=1 )
   return 0;
if ( num<1 ) num = 1;
                message("channel:chat",sprintf(YEL"┣ "HIG"送物"NOR YEL" ┫%s(%s)："WHT"%s "YEL"调整了 "HIR"本次任务"NOR YEL" 的时间要求为原来的 "HIR"%s"NOR YEL" 倍。\n"NOR, name(),capitalize(query("id")),me->query("name"),chinese_number(num) ),users());
bt = num;
write("ok\n");
return 1;
}
