void create() {
  set_name("马官", ({ "ma guan", "guan" }));
  set("age", 30);
  set("long", "开封府管马的马官，有时也靠组织赛马来赚点水酒钱。\n");
  set("inquiry", ([
    "赛马": (: sai_ma :),
    "参加": (: do_join :),
  ]));
  set("int", 40);
  set("gender", "男性");
  setup();
}

void remove_eff() {
  this_object()->delete("saima");
  this_object()->delete("first_player");
  this_object()->delete("ip");
  this_object()->delete("joiner");
}

string sai_ma() {
  mapping player;
  mixed lt;
  string ip;
  object who, pet, me = this_player();
  pet = me->query_temp("ridee");
  lt = localtime(time());
  if (lt[LT_HOUR] >= tlist[0] && lt[LT_HOUR] < tlist[1]) {
    if (query("saima_num") >= 3) {
      delete("saima_num");
    } else if (query("saima_num") >= 1) {
      return "上午赛马已经结束了。";
    }
  } else if (lt[LT_HOUR] >= tlist[2] && lt[LT_HOUR] < tlist[3]) {
    if (query("saima_num") >= 3) {
      delete("saima_num");
    } else if (query("saima_num") >= 2) {
      return "下午的赛马已经结束了。";
    }
  } else if (lt[LT_HOUR] >= tlist[4] && lt[LT_HOUR] < tlist[5]) {
    if (query("saima_num") >= 4) {
      return "晚上的赛马已经结束了。";
    }
  } else {
    return "还没有到赛马时间。";
  }

  if (!pet)
    return "你连坐骑也没有，怎么赛？";
  if (!living(pet))
    return "以你坐骑目前的状态，看来是不能比赛了。";
  if (strsrch(pet->name(), "马") == -1)
    return "你骑的是什么怪兽？！";
  player = query("joiner");
  if (!player || !mapp(player) || sizeof(keys(player)) < 1)
    return "目前没有赛事，你还是先参加吧。";
  if (!player[me->query("id")])
    return "你现在还没参加呢。";

  ip = query_ip_name(me);

  who = find_player(query("first_player"));
  if (!who || !present(who, environment()) || !who->query_temp("ridee")
    || !living(who->query_temp("ridee"))) {
    remove_eff();
    message("channel:chat", sprintf(WHT "【" HIG " 民间界 " NOR WHT "】" NOR HIC "马官(Ma guan):因发起者%s无故退出比赛,本次比赛取消,开始下一轮比赛!\n" NOR,
      objectp(who) ? who->query("name") : "",
    ),
      users());
    return "比赛取消，重新加入吧。";
  }
  if (me != who)
    return "还是让" + who->query("name") + "来和我说吧.";
  if (sizeof(keys(player)) < MAX_NUM)
    return "还是再来" + chinese_number(MAX_NUM - sizeof(keys(player))) + "位玩家再说吧.";
  if (query("saima") == "开始")
    return "目前正举行赛事呢.";
  if (query("saima") == "结束")
    return "本次比赛已经结束,各参赛者可以要奖励了.";
  if (start_game(keys(player))) {
    command("ok");
    message("channel:chat", sprintf(WHT "【" HIG " 民间界 " NOR WHT "】" NOR HIC "马官(Ma guan):%s发起的赛马比赛现在开始!\n" NOR,
      objectp(who) ? who->query("name") : "",
    ),
      users());
    set("saima", "开始");
    set("ip", 1);
    remove_call_out("remove_eff");
    call_out("remove_eff", 150);
    return "加油加油....";
  }
  return "比赛准备中,你稍候再试.";
}

string do_join() {
  mapping player;
  mixed lt;
  object who, pet, me = this_player();
  lt = localtime(time());
  if (lt[LT_HOUR] >= tlist[0] && lt[LT_HOUR] < tlist[1]) {
    if (query("saima_num") >= 3) {
      delete("saima_num");
    } else if (query("saima_num") >= 1) {
      return "上午赛马已经结束了。";
    }
  } else if (lt[LT_HOUR] >= tlist[2] && lt[LT_HOUR] < tlist[3]) {
    if (query("saima_num") >= 3) {
      delete("saima_num");
    } else if (query("saima_num") >= 2) {
      return "下午赛马已经结束了。";
    }

  } else if (lt[LT_HOUR] >= tlist[4] && lt[LT_HOUR] < tlist[5]) {
    if (query("saima_num") >= 4) {
      return "晚上的赛马已经结束了。";
    }
  } else {
    return "还没有到赛马时间。";
  }


  if (query("saima") == "开始")
    return "目前正举行赛事呢.";
  if (query("ip/" + query_ip_name(me)))
    return "你好似已经有其他的号参赛了。。。。";
  if (me->query_temp("saima"))
    return "....";
  pet = me->query_temp("ridee");
  if (!pet)
    return "你连坐骑也没有，怎么赛？";
  if (!living(pet))
    return "以你坐骑目前的状态，看来是不能比赛了。";
  if (strsrch(pet->name(), "马") == -1)
    return "你骑的是什么怪兽？！";
  player = query("joiner");
  if (!player || !mapp(player)) {
    set("first_player", me->query("id"));
    set("joiner/" + me->query("id"), 1);
    set("ip/" + query_ip_name(me), 1);
    message("channel:chat", sprintf(WHT "【" HIG " 民间界 " NOR WHT "】" NOR HIC "马官(Ma guan): 今%s特发起赛马比赛,欢迎大家报名!\n" NOR,
      me->query("name"),
    ),
      users());
    return "好,我这就去准备.";
  }
  if (player[me->query("id")])
    return "你已经参加了。";
  if (me->query("id") == query("first_player"))
    return "想进行比赛了吗?";

  command("ok");
  message("channel:chat", sprintf(WHT "【" HIG " 民间界 " NOR WHT "】" NOR HIC "马官(Ma guan):%s参加了本次赛马比赛!\n" NOR,
    me->query("name"),
  ),
    users());
  set("ip/" + query_ip_name(me), 1);
  set("joiner/" + me->query("id"), 1);
  return "加油加油....";
}

int start_game(string *ids) {
  string id, *dir;
  object mat, env1, env2, pet, who;
  int i, num = 0;

  switch (random(7)) {
    case 0: dir = dir1; break;
    case 1: dir = dir2; break;
    case 2: dir = dir3; break;
    case 3: dir = dir4; break;
    case 4: dir = dir5; break;
    case 5: dir = dir6; break;
    default: dir = dir7;
  }
  set("place", dir);
  env1 = find_object(dir[0]);
  if (!env1) {
    message("channel:sys", WHT "赛马:起始位置查找失败!\n" NOR, users());
    return 0;
  }
  env2 = find_object(dir[sizeof(dir) - 1]);
  if (!env2) {
    message("channel:sys", WHT "赛马:终点位置查找失败!\n" NOR, users());
    return 0;
  }

  if (env1->query_temp("saima_num"))
    env1->delete_temp("saima_num");
  if (env2->query_temp("saima_num"))
    env2->delete_temp("saima_num");

  for (i = 0; i < sizeof(ids); i++) {
    id = ids[i];
    who = find_player(id);
    if (!who) {
      message("channel:chat", sprintf(WHT "【" HIG " 民间界 " NOR WHT "】" NOR HIC "马官(Ma guan):%s无故退出了本次赛马比赛!\n" NOR,
        id,
      ),
        users());
      delete("joiner/" + id);
      return 0;
    }
    if (!present(who, environment())) {
      message("channel:chat", sprintf(WHT "【" HIG " 民间界 " NOR WHT "】" NOR HIC "马官(Ma guan):%s无故退出了本次赛马比赛!\n" NOR,
        who->query("name"),
      ),
        users());
      delete("joiner/" + id);
      return 0;
    }
    pet = who->query_temp("ridee");
    if (!pet || !living(pet) || strsrch(pet->name(), "马") == -1) {
      message("channel:chat", sprintf(WHT "【" HIG " 民间界 " NOR WHT "】" NOR HIC "马官(Ma guan):%s失去了坐骑,退出了本次赛马比赛!\n" NOR,
        who->query("name"),
      ),
        users());
      delete("joiner/" + id);
      return 0;
    }
    who->command("follow none");
    who->set_temp("saima", 1);
    who->set_temp("saima_zhongdian", env2);
    mat = present("ma bian", who);
    if (mat && mat->is_gameitem())
      destruct(mat);
    mat = new(__DIR__ "mabian");
    if (!mat->move(who))
      return 0;
    tell_object(who, HIR "你得到了" + mat->name() + HIR "！\n" NOR);
    pet->move(env1);
    who->move(env1);
    num++;
  }
  if (num < MAX_NUM) {
    delete("joiner");
    delete("first_player");
    message("channel:chat", sprintf(WHT "【" HIG " 民间界 " NOR WHT "】" NOR HIC "马官(Ma guan):本次赛马比赛人数不足,自动取消!\n" NOR),
      users());
    return 0;
  }

  message("channel:chat", sprintf(WHT "【" HIG " 民间界 " NOR WHT "】" NOR HIC "马官(Ma guan):本次赛马比赛起点站: %s ,终点战 %s !\n" NOR,
    env1->query("short"), env2->query("short")),
    users());
  add("saima_num", 1);

  return 1;
}
