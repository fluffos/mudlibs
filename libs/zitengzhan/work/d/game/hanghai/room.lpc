#include <ansi.h>
#include "errs_func.h"
inherit ROOM;
inherit F_SAVE;

#define MST             __DIR__"master"         // 经纬仪，游戏指令主支持
#define MAX_TIME        5400

void create() {
  set("short", HIC "〖" HIG "小航海时代" NOR HIC "〗" NOR WHT " 游戏室" NOR);
  set("long", YEL "
***********************************************
              〖小航海时代〗

    欢迎来到 小航海时代 游戏。这里是一个休闲
小游戏，您在游戏获得乐趣的同时，亦将能够得到
一定数量的MUD奖励，以资鼓励。

    进入游戏：         game start
    任何时候退出游戏： game over

***********************************************
\n" NOR);
  set("no_fight", "1");
  set("no_steal", "1");
  set("no_sleep_room", "1");
  set("valid_startroom", 1);  // 此两条分别为：非连线房间 及 起始房间
  set("cost", 0);

  set("exits", ([
    "west": "/d/city/clubup",
  ]));
  set("no_move", 1);
  setup();
}

string query_save_file() {
  return DATA_DIR "炼妖壶/npc/hanghai_room";
}

void init() {
  add_action("do_game", "game");
}

int do_game(string arg) {
  string ip;
  object me = this_player(), mst_obj;

  if (!arg || arg != "start")
    return 0;

  // "game over" 等操作，由 MST 物件进行。

  if (me->query_temp("hanghai_gameing"))
    return errs("你已身在游戏中！\n");

  if (file_size(MST + ".lpc") < 1)
    return errs("本游戏暂停开放！\n");

  write("\n========= 请稍候，正在执行操作…… ==========\n\n");

  ip = query_ip_number(me);
  if (time() < query("ip/" + ip) + MAX_TIME)
    return errs(HIR "你需要在" HIY + FINGER_D->age_string(query("ip/" + ip) + MAX_TIME - time()) + HIR "后才能再次进入本游戏！\n");
  if (time() < query("player/" + me->query("id")) + MAX_TIME)
    return errs(HIR "你需要在" HIY + FINGER_D->age_string(query("player/" + me->query("id")) + MAX_TIME - time()) + HIR "后才能再次进入本游戏！\n");

  set("ip/" + ip, time());
  set("player/" + me->query("id"), time());
  if (save())
    write(YEL "┝" NOR HIG " 小航海" NOR YEL " ┥ 游戏房间存储成功，可以进入。\n" NOR);
  else {
    write(YEL "┝" NOR HIG " 小航海" NOR YEL " ┥ 游戏房间存储失败，不得进入。\n" NOR);
    delete(ip);
    delete(me->query("id"));
    return 1;
  }
  mst_obj = new(MST);
  mst_obj->new_game(me);
  if (!mst_obj->move(me)) {
    delete(ip);
    delete(me->query("id"));
    save();
    return errs("你身上的东西太多了。\n");
  }
  return 1;
}

int valid_leave(object me, string dir) {
  if (me->query_temp("hanghai_gameing"))
    return notify_fail("你正在游戏中，不得离开！\n");
  return ::valid_leave(me, dir);
}

void reset() {
  ::reset();
  if (!restore())
    message(
      "channel:rumor",
      YEL "┝" NOR HIG " 小航海" NOR YEL " ┥ 小航海游戏初始" WHT ">>>>>>>>>>>>>>>" YEL "完毕\n" NOR,
      users()
    );
  else
    message(
      "channel:rumor",
      YEL "┝" NOR HIG " 小航海" NOR YEL " ┥ 小航海游戏读取" WHT ">>>>>>>>>>>>>>>" YEL "完毕\n" NOR,
      users()
    );
}

void clear_data() {
  delete("player");
  delete("ip");
  save();
  message(
    "channel:rumor",
    YEL "┝" NOR HIG " 小航海" NOR YEL " ┥ 小航海房间重置" WHT ">>>>>>>>>>>>>>>" YEL "完毕\n" NOR,
    users()
  );
}
