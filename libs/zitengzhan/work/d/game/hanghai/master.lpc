#include <ansi.h>
#include "errs_func.h"
inherit ITEM;

void no_fog_map(object);

#define B1              "灿烂夺目的黄金剑"      // 金剑  - YEL, HIY
#define B2              "装满金币的宝箱"        // 宝箱  - MAG, HIM
#define B3              "镶嵌钻石的金皇冠"      // 皇冠  - YEL, HIY
#define B4              "皇后的钻石项链"        // 项链  - CYN, HIC
#define B5              "圣洁的银杯"            // 银杯  - WHT, HIW
#define B6              "神秘的白金权杖"        // 权杖  - WHT, HIW
#define B7              "驱逐邪灵的圣十字架"    // 圣架  - HIM, HIM
#define B8              "预示未来的琉璃水晶"    // 水晶  - CYN, HIC
#define B9              "镶嵌红宝石的力量之戒"  // 宝戒  - RED, HIR
#define B10             "与希望同行的绿翡翠"    // 翡翠  - GRN, HIG

#define S1              "未知的暗夜手杖"
#define S2              "古老的吸血头盔"
#define S3              "神圣的光之法器"

int snowtu = 0;

mapping gifts = ([
  "灿烂夺目的黄金剑": 10000,
  "装满金币的宝箱": 50000,
  "镶嵌钻石的金皇冠": 80000,
  "皇后的钻石项链": 8000,
  "圣洁的银杯": 5000,
  "神秘的白金权杖": 100000,
  "驱逐邪灵的圣十字架": 50000,
  "预示未来的琉璃水晶": 80000,
  "镶嵌红宝石的力量之戒": 150000,
  "与希望同行的绿翡翠": 5000,
  "未知的暗夜手杖": 100000 + random(300000),
  "古老的吸血头盔": 200000 + random(200000),
  "神圣的光之法器": 300000 + random(100000),
]);

string game_now = "等待移动命令";
string att_now = "not_ok";
int target_hp, target_damage;
string pic_me, pic_target;

void new_game_set(int amount, string mark);
void map();
void check_hp();
object get_me();
string get_msg(int x, int y, string type);
void xunbaotu();
void fight_start(string who);
void be_attack();
void target_check_hp();

int finded_baowu(int which, string name) {
  object gold, me = get_me();
  int score, num;

  if (!me)
    return 0;
  snowtu++;
  add("be_finded", 1);
  set("b" + which, HIW + query("b" + which));
  map();
  num = gifts[name];
  num += random(num * 3);
  if (snowtu % 3 == 0)
    message("channel:rumor", sprintf(YEL "┝" NOR HIG " 小航海" NOR YEL " ┥ %s(%s)找到了" NOR HIY "%s" NOR YEL "，价值%s" YEL "。\n" NOR,
      me->query("name"), capitalize(me->query("id")), name, MONEY_D->money_str(num)),
      users());
  else write(YEL "┝" NOR HIG " 小航海" NOR YEL " ┥ 太幸运了！终于找到了 " + name + " ！\n" NOR);
  write(YEL "游戏奖励：" NOR HIW + MONEY_D->money_str(num) + YEL "自动存入了你的钱庄帐户。\n" NOR);
  me->add("balance", num);
  me->save();
  if (query("be_finded") == 10) {
    me->delete_temp("hanghai_gameing");
    game_now = "游戏结束";
    score = query("score");

    score += query("att_hp") * 100;
    score += query("att_jf") * 100;
    score += query("att_rs") * 100;
    score += query("att_yq") * 100;
    score += query("att_fd") * 100;

    score += query("hp") * 500;

    if (score < 1)
      score = 1;
    me->add("小航海/score", score);
    me->add("vip", 1);

    write(HIY "
=========================================
             〖小航海时代〗

    你找齐了十件宝物！！游戏胜利结束了。
    你的合计得分是 " + score + " 分(仅供参考)。

    你获得了 1 点 MUD里VIP.点数的奖励！
=========================================
\n" NOR);
    if (random(me->query_kar()) > 15) {
      num = me->query("小航海/score");
      num = num / 2 + random(num / 2);
      num /= 10;
      if (num < 1)
        num = 1;
      if (num > 10)
        num = 10;
      gold = new("/obj/money/jinbi");
      gold->set_amount(num);
      if (gold->move(me)) {
        write(HIR "恭喜您！您得到了游戏追加的奖励：" HIY + chinese_number(gold->query_amount()) + HIR "枚金币！\n" NOR);
        me->set("小航海/score", 0);
      }
    }
    message("channel:rumor", sprintf(YEL "┝" NOR HIG " 小航海" NOR YEL " ┥ %s(%s) 成功完成了小航海游戏！\n" NOR,
      me->query("name"), capitalize(me->query("id")),),
      users());
    write_file("/d/game/hanghai/winner", sprintf("%s : %s(%s) 完成小航海游戏.\n",
      ctime(time()), me->query("name"), getuid(me)));
    remove_call_out("del_me");
    call_out("del_me", 1);
  }
  return 1;
}


// 获得“me”
object get_me() {
  object me;
  if (!query("owner_id"))
    return 0;
  me = find_player(query("owner_id"));
  if (!me)
    return 0;
  return me;
}

// 获得攻击力段
int damage(int type)  // 6-11
{
  if (!type || type < 1 || type > 5)
    type = 1;

  switch (type) {
    case 1: return (6 + random(6));
    case 2: return (12 + random(6));
    case 3: return (18 + random(6));
    case 4: return (24 + random(6));
    case 5: return (30 + random(6));
  }

  return (6 + random(6));
}

void del_me() {
  destruct(this_object());
}

void create() {
  set_name(HIY "经纬仪（游戏道具）" NOR, ({ "jingwei yi", "yi" }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "〖小航海时代〗游戏的主要道具，有了它才可以进行游戏。
查询现在的游戏状态，输入： game check
任何时候结束游戏，输入：   game over
\n");
    set("unit", "具");
    set("value", 0);
  }
  set("no_get", 1);
  set("no_drop", 1);
  set("no_steal", 1);
  set("no_give", 1);
  setup();
}


void init() {
  add_action("do_game", "game");
  add_action("do_go", "go");
  add_action("do_liaowang", "liaowang");
  add_action("do_attack", "atk");
}

void new_game(object me) {
  if (!me)
    return del_me();

  set("owner_id", getuid(me));
  set("owner_name", me->query("name"));

  // ******************************************
  new_game_set(8, "岛屿");

  // ******************************************
  new_game_set(4, "望远镜");

  // ******************************************
  new_game_set(4, "报警探索仪");

  // ******************************************
  if (!random(50) && !wizardp(me))
    new_game_set(4, "寻宝图");
  else new_game_set(random(3), "幽冥恶魔");
  // ******************************************
  //      new_game_set( 2, "旋涡" );
  // 不要旋涡的设置！

  // ******************************************
  new_game_set(2, "冰山");

  // ******************************************
  new_game_set(3, "补给品");

  // ******************************************
  new_game_set(6, "扶桑海盗");

  // ******************************************
  new_game_set(6, "东海魔鱼");

  // ******************************************
  new_game_set(6, "蓬莱怪藤");

  // ******************************************
  new_game_set(6, "汤谷炎乌");

  // ******************************************
  new_game_set(6, "幽冥鬼舟");

  // 宝物部分
  // ******************************************
  new_game_set(1, B1);
  new_game_set(1, B2);
  new_game_set(1, B3);
  new_game_set(1, B4);
  new_game_set(1, B5);
  new_game_set(1, B6);
  new_game_set(1, B7);
  new_game_set(1, B8);
  new_game_set(1, B9);
  new_game_set(1, B10);


  new_game_set(1, "当前船只位置");

  set("att_rb", 999999);
  set("att_hp", 1);
  set("att_jf", 1);
  set("att_rs", 1);
  set("att_yq", 1);
  set("att_fd", 1);
  set("hp", 100);

  write(">>>>>>>  各类武器及船只补给完毕。\n");
  me->set_temp("hanghai_gameing", "waiting_go");
  write("\n============ 设置成功！正在进入游戏…… ============\n");


  set("b1", YEL "金剑" NOR);
  set("b2", YEL "宝箱" NOR);
  set("b3", YEL "皇冠" NOR);
  set("b4", CYN "项链" NOR);
  set("b5", WHT "银杯" NOR);
  set("b6", WHT "权杖" NOR);
  set("b7", RED "圣架" NOR);
  set("b8", CYN "水晶" NOR);
  set("b9", RED "宝戒" NOR);
  set("b10", GRN "翡翠" NOR);

  if (wizardp(me) && me->query("env/game_clear"))
    no_fog_map(me);
  call_out("game_start", 1);
}

void new_game_set(int amount, string mark) {
  int x, y;
  // 这里的 x, y ， x是竖数第几横，y是横数第几个。

  while (amount--) {
    x = 1 + random(10);
    y = 1 + random(16);

    if (query("aaa(" + x + "," + y + ")")) {
      amount++;
      continue;
    }

    set("aaa(" + x + "," + y + ")", mark);
    if (mark == "当前船只位置") {
      set("now_x", x);
      set("now_y", y);
    }
    if (mark == "岛屿")
      set("island(" + x + "," + y + ")", "new");

  }
  write(YEL ">>>>>>>  " NOR HIG + mark + NOR YEL " 设置完毕。\n" NOR);
}

void game_start() {
  object me = get_me();
  if (!me) return del_me();

  me->set_temp("hanghai_gameing", "ok");
  message_vision("$N进入了 小航海时代 游戏！\n", me);
  message("channel:rumor", sprintf(YEL "┝" NOR HIG " 小航海" NOR YEL " ┥ %s(%s)进入了小航海的世界。\n" NOR,
    me->query("name"), capitalize(me->query("id")),),
    users());

  write("\n**************************************
进入游戏成功！游戏目标为寻得10件宝物！
移动指令与 MUD 内相同。祝游戏愉快！
**************************************\n\n");

  map();
}


////////////////////////////////////
/////////  玩家操作函数  ///////////
////////////////////////////////////

int do_game(string arg) {
  object me = this_player(), who;
  who = get_me();

  if (!who || me != who) return 0;

  if (!arg || (arg != "check" && arg != "ck" && arg != "over"))
    return 0;

  if (!me->query_temp("hanghai_gameing"))
    return 0;

  if (arg == "check" || arg == "ck") {
    map();
    return 1;
  }

  if (arg == "over") {
    me->delete_temp("hanghai_gameing");
    message_vision("$N中途放弃，退出了 小航海时代 游戏。\n", me);
    message("channel:rumor", sprintf(YEL "┝" NOR HIG " 小航海" NOR YEL " ┥ %s(%s) 中途放弃，退出了小航海的世界。\n" NOR,
      me->query("name"), capitalize(me->query("id")),),

      users());
    write(HIR "\n  #########  已退出游戏，祝一切愉快！ #########\n\n" NOR);
    remove_call_out("del_me");
    call_out("del_me", 1);
    return 1;
  }
  return 1;
}

int do_go(string arg) {
  object me = this_player(), who;
  int x, y, old_x, old_y, i;

  string *dirs = ({
    "north", "south", "west", "east", "northwest", "northeast", "southwest", "southeast", });

  string here, msg;

  who = get_me();
  if (!who || who != me) return 0;
  if (member_array(arg, dirs) == -1) return 0;

  if (me->query_temp("hanghai_gameing") != "ok")
    return errs("现在不许移动！正在： " + game_now + " 。\n");

  x = query("now_x");
  y = query("now_y");

  old_x = x;
  old_y = y;

  switch (arg) {
    case "north": x--; break;
    case "south": x++; break;
    case "west": y--; break;
    case "east": y++; break;
    case "northwest": x--; y--; break;
    case "northeast": x--; y++; break;
    case "southwest": x++; y--; break;
    case "southeast": x++; y++; break;
  }

  if (x < 1 || y < 1 || x > 10 || y > 16)
    return errs("这个方向已经无法前进了！\n");

  set("be_finded(" + old_x + "," + old_y + ")", 1);


  if (query("island(" + old_x + "," + old_y + ")") == "new"
    || query("island(" + old_x + "," + old_y + ")") == "old") {
    set("island(" + old_x + "," + old_y + ")", "old");
    set("aaa(" + old_x + "," + old_y + ")", "旧的岛屿");
  }

  if (!query("island(" + old_x + "," + old_y + ")"))
    delete("aaa(" + old_x + "," + old_y + ")");

  here = query("aaa(" + x + "," + y + ")");

  set("aaa(" + x + "," + y + ")", "当前船只位置");
  set("now_x", x);
  set("now_y", y);

  // 各类判断！！！

  if (here == "岛屿") {
    add("att_hp", 1);
    add("att_jf", 1);
    add("att_rs", 1);
    add("att_yq", 1);
    add("att_fd", 1);
    add("hp", 20 + random(11));
    if (query("hp") > 100) set("hp", 100);
    map();
    write(YEL "┝" NOR HIG " 小航海" NOR YEL " ┥ 发现岛屿！得到了弹药补给和船只修理。\n" NOR);
    return 1;
  }

  if (here == "补给品") {
    add("hp", 20 + random(11));
    if (query("hp") > 100) set("hp", 100);
    map();
    write(YEL "┝" NOR HIG " 小航海" NOR YEL " ┥ 发现修补材料！船只得到了修理。\n" NOR);
    return 1;
  }

  if (here == "冰山") {
    add("hp", -(30 + random(11)));
    map();
    write(YEL "┝" NOR HIG " 小航海" NOR YEL " ┥ 糟糕！撞上了冰山！船受到了严重的损坏。\n" NOR);
    check_hp();
    return 1;
  }


  if (here == B1)
    return finded_baowu(1, B1);
  if (here == B2)
    return finded_baowu(2, B2);
  if (here == B3)
    return finded_baowu(3, B3);
  if (here == B4)
    return finded_baowu(4, B4);
  if (here == B5)
    return finded_baowu(5, B5);
  if (here == B6)
    return finded_baowu(6, B6);
  if (here == B7)
    return finded_baowu(7, B7);
  if (here == B8)
    return finded_baowu(8, B8);
  if (here == B9)
    return finded_baowu(9, B9);
  if (here == B10)
    return finded_baowu(10, B10);


  if (here == "望远镜") {
    game_now = "了望中 （指令： liaowang x y）";
    map();
    write(YEL "┝" NOR HIG " 小航海" NOR YEL " ┥ 发现了望远镜！输入 (liaowang x y) 指令查看该点周边海域的情形！ \n" NOR);
    me->set_temp("hanghai_gameing", "wangyuanjing");
    return 1;
  }

  if (here == "报警探索仪") {
    map();
    write(YEL "┝" NOR HIG " 小航海" NOR YEL " ┥ 发现了报警探索仪！\n" NOR);


    msg = HIM "\n报警仪探索中……自动探索 " + x + "," + y + " 区域的情况。\n\n";

    msg += get_msg(x - 1, y - 1, "bjy");
    msg += get_msg(x - 1, y, "bjy");
    msg += get_msg(x - 1, y + 1, "bjy");
    msg += get_msg(x, y - 1, "bjy");
    msg += get_msg(x, y, "bjy");
    msg += get_msg(x, y + 1, "bjy");
    msg += get_msg(x + 1, y - 1, "bjy");
    msg += get_msg(x + 1, y, "bjy");
    msg += get_msg(x + 1, y + 1, "bjy");

    msg += "\n探索危险区域报警完毕。\n\n" NOR;
    write(msg);
    return 1;
  }

  if (here == "寻宝图") {
    map();
    write(HIC "〖小航海时代〗  发现了寻宝图！\n" NOR);
    xunbaotu();
    return 1;
  }


  if (here == "扶桑海盗" || here == "汤谷炎乌" || here == "蓬莱怪藤"
    || here == "东海魔鱼" || here == "幽冥鬼舟" || here == "幽冥恶魔") {
    game_now = "与 " + here + " 战斗中！ 等待敌人攻击";
    me->set_temp("hanghai_gameing", "fighting");
    att_now = "not_ok";
    map();
    write(YEL "┝" NOR HIG " 小航海" NOR YEL " ┥ 糟糕！遭遇了 " NOR HIR + here + NOR YEL " ！进入紧急战斗状态！！！\n" NOR);
    set("who_name", here);
    remove_call_out("fight_start");
    call_out("fight_start", 1, here);
    return 1;
  }


  map();
  write(YEL "┝" NOR HIG " 小航海" NOR YEL " ┥  漫漫航程，什么也没有发现……\n" NOR);
  return 1;
}

void map() {
  string the_map = YEL "┝" NOR HIG " 小航海" NOR YEL " ┥ -- " NOR HIC "HP：" NOR HIR + query("hp") + NOR HIW "  宝物：" NOR HIR + query("be_finded") + NOR "\n\n        ", temp_map, temp2;
  int x, y, temp = 0;

  for (x = 1; x < 11; x++) {
    for (y = 1; y < 17; y++) {
      if (temp == 16) {
        temp = 0;
        the_map += "\n        ";
      }

      temp2 = "(" + x + "," + y + ")";

      if (query("be_finded" + temp2))
        temp_map = HIC "□" NOR;
      else if (query("weixian" + temp2))
        temp_map = HIR "■" NOR;
      else temp_map = HIC "■" NOR;
      if (query("aaa" + temp2) == "岛屿")
        temp_map = HIG "▲" NOR;
      if (query("aaa" + temp2) == "旧的岛屿")
        temp_map = HIG "△" NOR;
      if (query("aaa" + temp2) == "当前船只位置")
        temp_map = BLINK + HIY "≌" NOR;

      the_map += temp_map;
      temp++;
    }
  }

  the_map += "\n\n";

  //      for( temp = 1;temp<11;temp++)
  //      {
  //              set("b"+temp, HIW+query("b"+temp) );
  //      }

  the_map += sprintf("          %s  %s  %s  %s  %s
          %s  %s  %s  %s  %s\n\n",
    query("b1"), query("b2"), query("b3"),
    query("b4"), query("b5"), query("b6"),
    query("b7"), query("b8"), query("b9"),
    query("b10"));

  the_map += sprintf(HIW "  肉搏之刃(rb)：∞  火炮(hp)：%d  巨斧(jf)：  %d
  漫天飞刀(fd)：%d   鱼枪(yq)：%d  燃烧弹(rs)：%d\n" NOR,
    query("att_hp"), query("att_jf"),
    query("att_fd"), query("att_yq"), query("att_rs"));




  write(HIY "================================================\n" NOR + the_map +
    HIY "================================================\n" NOR "当前位置：(" + query("now_x") + "," + query("now_y") + ")  现在： " + game_now + " \n");

}

void check_hp() {
  object me = get_me();
  int x, y, temp = 0;
  string the_map, temp_map, temp2;

  if (!me) call_out("del_me", 1);

  if (query("hp") > 0) return;

  the_map = YEL "\n\t\t\t┝" NOR HIG " 小航海" NOR YEL " ┥\n" NOR HIR "  -- 失败结果公布( 共寻得" + query("be_finded") + "件宝物 )\n\n        " NOR;

  for (x = 1; x < 11; x++) {
    for (y = 1; y < 17; y++) {
      if (temp == 16) {
        temp = 0;
        the_map += "\n        ";
      }

      temp2 = query("aaa(" + x + "," + y + ")");
      temp_map = HIC "□" NOR;

      if (temp2 == "扶桑海盗")
        temp_map = HIR "盗" NOR;
      if (temp2 == "东海魔鱼")
        temp_map = HIR "鱼" NOR;
      if (temp2 == "蓬莱怪藤")
        temp_map = HIR "藤" NOR;
      if (temp2 == "汤谷炎乌")
        temp_map = HIR "鸟" NOR;
      if (temp2 == "幽冥鬼舟")
        temp_map = HIR "幽" NOR;
      if (temp2 == "幽冥恶魔")
        temp_map = BLINK HIB "魔" NOR;
      if (temp2 == "冰山")
        temp_map = HIW "冰" NOR;


      if (temp2 == "岛屿")
        temp_map = HIG "▲" NOR;
      if (temp2 == "旧的岛屿")
        temp_map = HIG "△" NOR;
      if (temp2 == "当前船只位置")
        temp_map = BLINK + HIB "≌" NOR;

      if (temp2 == B1 || temp2 == B2 || temp2 == B3
        || temp2 == B4 || temp2 == B5 || temp2 == B6
        || temp2 == B7 || temp2 == B8 || temp2 == B9 || temp2 == B10)
        temp_map = HIY "宝" NOR;

      if (temp2 == "望远镜")
        temp_map = HIM "望" NOR;
      if (temp2 == "报警探索仪")
        temp_map = HIM "警" NOR;
      if (temp2 == "补给品")
        temp_map = HIM "补" NOR;
      if (temp2 == "寻宝图")
        temp_map = HIM "图" NOR;

      the_map += temp_map;
      temp++;
    }
  }

  the_map += "\n\n";

  write(the_map);
  me->delete_temp("hanghai_gameing");
  game_now = "已经灭亡！";


  message_vision("$N游戏失败，退出了 小航海时代 游戏。\n", me);
  remove_call_out("game_over_over");
  call_out("game_over_over", 1);
  return;
}


void game_over_over() {
  write(HIR "
=========================================
             〖小航海时代〗

      你的船只损坏得再也无法支持，
          终于沉入了大海之中！
=========================================
\n" NOR);
  remove_call_out("del_me");
  call_out("del_me", 1);
  return;
}

int do_liaowang(string arg) {
  object me = this_player(), who;
  int x, y;
  string msg;

  who = get_me();
  if (!who || who != me) return 0;

  if (me->query_temp("hanghai_gameing") != "wangyuanjing")
    return 0;

  if (!arg || (sscanf(arg, "%d %d", x, y) != 2 && sscanf(arg, "%d,%d", x, y) != 2))
    return errs("请输入正确坐标！x -> 竖着数第几横  y -> 横着数第几个\n");
  if (x < 1 || x > 10 || y < 1 || y > 16)
    return errs("请输入正确坐标！x -> 竖着数第几横  y -> 横着数第几个\n");


  msg = HIM "了望中……你决定查看 " + x + "," + y + " 区域的情况。\n\n";

  msg += get_msg(x - 1, y - 1, "wyj");
  msg += get_msg(x - 1, y, "wyj");
  msg += get_msg(x - 1, y + 1, "wyj");
  msg += get_msg(x, y - 1, "wyj");
  msg += get_msg(x, y, "wyj");
  msg += get_msg(x, y + 1, "wyj");
  msg += get_msg(x + 1, y - 1, "wyj");
  msg += get_msg(x + 1, y, "wyj");
  msg += get_msg(x + 1, y + 1, "wyj");

  msg += "\n查看完毕。\n\n" NOR;

  write(msg);
  me->set_temp("hanghai_gameing", "ok");
  game_now = "等待移动命令";
  return 1;
}

string get_msg(int x, int y, string type) {
  string msg;

  if (x < 1 || x > 10 || y < 1 || y > 16) return "";

  msg = query("aaa(" + x + "," + y + ")");

  if (!msg) {
    if (type == "wyj") return "(" + x + "," + y + ") -----------\n";
    return "";
  }

  if (msg == "冰山" || msg == "扶桑海盗" || msg == "东海魔鱼"
    || msg == "蓬莱怪藤" || msg == "汤谷炎乌" || msg == "幽冥鬼舟") {
    set("weixian(" + x + "," + y + ")", 1);
    if (type == "wyj") return "(" + x + "," + y + ") " + msg + "\n";
    return "(" + x + "," + y + ") 有危险潜伏！\n";
  }

  if (type == "wyj") return "(" + x + "," + y + ") " + msg + "\n";
  else return "";
}

void xunbaotu() {
  int x, y;
  string msg;

  for (x = 1; x < 11; x++) {
    for (y = 1; y < 17; y++) {
      msg = query("aaa(" + x + "," + y + ")");
      if (msg == B1 || msg == B2 || msg == B3 || msg == B4
        || msg == B5 || msg == B6 || msg == B7 || msg == B8
        || msg == B9 || msg == B10) {
        write(HIM "(" + x + "," + y + ")    该处藏有宝藏！\n" NOR);
        return;
      }
    }
  }
}

void fight_start(string who) {
  switch (who) {
    case "扶桑海盗": pic_target = "≌"; target_damage = 2; break;
    case "东海魔鱼": pic_target = "∝"; target_damage = 4; break;
    case "蓬莱怪藤": pic_target = "※"; target_damage = 6; break;
    case "汤谷炎乌": pic_target = "∮"; target_damage = 8; break;
    case "幽冥鬼舟": pic_target = "≌"; target_damage = 10; break;
    case "幽冥恶魔": pic_target = "∵"; target_damage = 10; break;
  }

  if (who == "幽冥恶魔")
    target_hp = 100 + random(100);
  else target_hp = 50 + random(31);

  pic_me = "≌";

  remove_call_out("be_attack");
  call_out("be_attack", 1);
}

void be_attack() {
  int damage;
  string pic1, pic2;

  damage = target_damage + random(3);
  add("hp", -damage);

  pic1 = HIR + pic_target + " " + query("who_name") + "(" + target_hp + ")" NOR;
  pic2 = sprintf("    " HIG "(%|4d)航海者 " HIR "¤" NOR, query("hp"), pic_me);

  write(sprintf("
                     _ _ _ _ _ _ _ _ _ _       ATTACK!
            " HIR "-%-2d" NOR "    /                     `" HIY "¤" NOR "
%s                        %s
" NOR HIG "≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈\n\n", damage, pic2, pic1));

  write(YEL "┝" NOR HIG " 小航海" NOR YEL " ┥ 受到了 " + query("who_name") + " 的攻击，船只损坏 " NOR HIR "" + damage + NOR YEL " ！\n" NOR);
  check_hp();
  call_out("can_att", 1);
}

void can_att() {
  if (query("hp") < 1) return;

  write(YEL "┝" NOR HIG " 小航海" NOR YEL " ┥ 轮到你攻击了！(atk 方式)\n" NOR);
  write(sprintf(HIG "武器剩余：    rb:无限    hp:%d    jf:%d    rs:%d    yq:%d    fd:%d\n" NOR,
    query("att_hp"), query("att_jf"), query("att_rs"), query("att_yq"), query("att_fd")));
  game_now = "与 " + query("who_name") + " 战斗中！ 等待攻击指令";
  att_now = "ok";
}

int do_attack(string arg) {
  object me = this_player(), who;
  string target_name = query("who_name"), pic1, pic2, temp;
  int damage;

  who = get_me();
  if (!who || who != me) return 0;

  if (att_now != "ok") return errs("现在并不是你攻击的时候！\n");
  if (!arg || (arg != "rb" && arg != "hp" && arg != "jf" && arg != "rs"
    && arg != "yq" && arg != "fd"))
    return errs("你选择的武器不对！\n");

  if (query("att_" + arg) < 1) return errs("这种武器已经没有了！\n");
  add("att_" + arg, -1);

  switch (arg) {
    case "rb": temp = "肉搏之刃"; damage = damage(1); break;
    case "hp":
      temp = "火炮";
      if (target_name == "扶桑海盗") damage = damage(5);
      if (target_name == "东海魔鱼") damage = damage(4);
      if (target_name == "蓬莱怪藤") damage = damage(3);
      if (target_name == "汤谷炎乌") damage = damage(2);
      if (target_name == "幽冥鬼舟") damage = damage(1);
      if (target_name == "幽冥恶魔") damage = damage(3);
      break;
    case "jf":
      temp = "巨斧";
      if (target_name == "扶桑海盗") damage = damage(4);
      if (target_name == "东海魔鱼") damage = damage(1);
      if (target_name == "蓬莱怪藤") damage = damage(5);
      if (target_name == "汤谷炎乌") damage = damage(3);
      if (target_name == "幽冥鬼舟") damage = damage(2);
      if (target_name == "幽冥恶魔") damage = damage(3);
      break;
    case "rs":
      temp = "燃烧弹";
      if (target_name == "扶桑海盗") damage = damage(2);
      if (target_name == "东海魔鱼") damage = damage(3);
      if (target_name == "蓬莱怪藤") damage = damage(4);
      if (target_name == "汤谷炎乌") damage = damage(1);
      if (target_name == "幽冥鬼舟") damage = damage(5);
      if (target_name == "幽冥恶魔") damage = damage(3);
      break;
    case "yq":
      temp = "鱼枪";
      if (target_name == "扶桑海盗") damage = damage(1);
      if (target_name == "东海魔鱼") damage = damage(5);
      if (target_name == "蓬莱怪藤") damage = damage(2);
      if (target_name == "汤谷炎乌") damage = damage(4);
      if (target_name == "幽冥鬼舟") damage = damage(3);
      if (target_name == "幽冥恶魔") damage = damage(3);
      break;
    case "fd":
      temp = "漫天飞刀";
      if (target_name == "扶桑海盗") damage = damage(3);
      if (target_name == "东海魔鱼") damage = damage(2);
      if (target_name == "蓬莱怪藤") damage = damage(1);
      if (target_name == "汤谷炎乌") damage = damage(5);
      if (target_name == "幽冥鬼舟") damage = damage(4);
      if (target_name == "幽冥恶魔") damage = damage(3);
      break;
  }

  target_hp -= damage;
  add("score", damage);

  pic1 = HIR "¤" + " " + query("who_name") + "(" + target_hp + ")" NOR;
  pic2 = sprintf("    " HIG "(%|4d)航海者 %s" NOR, query("hp"), pic_me);


  write(sprintf("
       %|8s！    _ _ _ _ _ _ _ _ _ _
                   " HIY "¤" NOR "                     \\    " HIR "-%d" NOR "
%s                        %s
≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈\n\n", temp, damage, pic2, pic1));

  write(YEL "┝" NOR HIG " 小航海" NOR YEL " ┥ 使用 " + temp + " 对 " + query("who_name") + " 进行攻击！损害对方  " NOR HIR "" + damage + NOR YEL " 。\n" NOR);

  att_now = "not_ok";
  remove_call_out("target_check_hp");
  call_out("target_check_hp", 1);

  return 1;
}


void target_check_hp() {
  object me = get_me();
  string target_name = query("who_name");

  if (!me) {
    remove_call_out("del_me");
    call_out("del_me", 1);
    return;
  }

  if (target_hp < 1) {
    game_now = "等待移动命令";
    add("hp", 1 + (random(5)));
    if (query("hp") > 100) set("hp", 100);
    map();
    if (target_name != "幽冥恶魔") {
      write(YEL "\n┝" NOR HIG " 小航海" NOR YEL " ┥ 打败了 " + query("who_name") + " ！获得了少量的补给。继续出发吧！\n\n" NOR);
      add("score", 100);
    } else {
      message(
        "channel:chat",
        YEL "\n┝" NOR HIG " 小航海" NOR YEL " ┥ 打败了 " + query("who_name") + " ！获得了少量的补给。继续出发吧！\n" NOR,
        users()
      );
      add("score", 200);
      write(BLINK + HIB "你只见幽冥恶魔身上忽然爆出一条耀眼的光芒，消失在海面之上！\n" NOR);
      switch (random(4)) {
        case 0: new_game_set(1, S3); break;
        case 1: new_game_set(1, S2); break;
        default: new_game_set(1, S1); break;
      }
    }
    me->set_temp("hanghai_gameing", "ok");
    return;
  }

  be_attack();
}

void no_fog_map(object me) {
  int x, y, temp = 0;
  string the_map, temp_map, temp2;

  if (!me) call_out("del_me", 1);

  the_map = YEL "\n\t\t\t┝" NOR HIG " 小航海" NOR YEL " ┥\n" NOR HIR "  -- 失败结果公布( 共寻得" + query("be_finded") + "件宝物 )\n\n        " NOR;

  for (x = 1; x < 11; x++) {
    for (y = 1; y < 17; y++) {
      if (temp == 16) {
        temp = 0;
        the_map += "\n        ";
      }
      temp2 = query("aaa(" + x + "," + y + ")");
      temp_map = HIC "□" NOR;
      if (temp2 == "扶桑海盗")
        temp_map = HIR "盗" NOR;
      if (temp2 == "东海魔鱼")
        temp_map = HIR "鱼" NOR;
      if (temp2 == "蓬莱怪藤")
        temp_map = HIR "藤" NOR;
      if (temp2 == "汤谷炎乌")
        temp_map = HIR "鸟" NOR;
      if (temp2 == "幽冥鬼舟")
        temp_map = HIR "幽" NOR;
      if (temp2 == "冰山")
        temp_map = HIW "冰" NOR;
      if (temp2 == "岛屿")
        temp_map = HIG "▲" NOR;
      if (temp2 == "旧的岛屿")
        temp_map = HIG "△" NOR;
      if (temp2 == "当前船只位置")
        temp_map = BLINK + HIB "≌" NOR;

      if (temp2 == B1 || temp2 == B2 || temp2 == B3
        || temp2 == B4 || temp2 == B5 || temp2 == B6
        || temp2 == B7 || temp2 == B8 || temp2 == B9 || temp2 == B10)
        temp_map = HIY "宝" NOR;

      if (temp2 == "望远镜")
        temp_map = HIM "望" NOR;
      if (temp2 == "报警探索仪")
        temp_map = HIM "警" NOR;
      if (temp2 == "补给品")
        temp_map = HIM "补" NOR;
      if (temp2 == "寻宝图")
        temp_map = HIM "图" NOR;

      the_map += temp_map;
      temp++;
    }
  }
  the_map += "\n\n";
  write(the_map);
  return;
}
