#include <ansi.h>
inherit NPC;
inherit F_SAVE;
int  do_dispose(string arg);
void confirm_dispose(string arg,object me, object fabao_ob);

private string SAVE_NAME="pet_save";
private nosave int can_save=1;

//void try_move();

void create()
{	
	seteuid(getuid());	
        set_name("宠物", ({"pet"}) );
        set("gender", "女性");
//  set("race","野兽");
        set("age", 1);
      set("under_water",1);
	set("base_name","兔");
        set("attitude", "friendly");
        set("long","小家伙。\n");
        set("combat_exp", 1);
set("owner","xdao");
       set("now_petlevel",0);
       set("max_petlevel",0);
       set("limbs", ({ "头部", "身体", "前脚", "後脚", "尾巴" }) );
   set("verbs", ({ "bite", "claw" }) );
  	set("ride/msg", "骑");

	set("is_pet",1);
                set("no_give",1);


        setup();
}


void reset()
{
object pet;
pet=this_object();
        if( !environment() ||  //mon 2/4/98
                ! find_living(query("owner")) )
        {
            pet->save();    
                destruct(this_object());
                return;
        }
}

void die()
{
 object pet;
int exp,dao,kee,sen;
pet=this_object();
exp = pet->query("combat_exp")/100;
dao = pet->query("daoxing")/100;
pet->add("combat_exp",-exp);
pet->add("daoxing",-dao);
	message_vision("$N惨叫一声，化成点点月光消失了。\n",this_object());
kee = pet->query("max_kee");
sen = pet->query("max_sen");
pet->set("eff_kee",kee);
pet->set("eff_sen",sen);
pet->set("kee",kee);
pet->set("sen",sen);
pet->save();
   	message_vision("$N死亡损失："+exp+"点武学经验和"+COMBAT_D->chinese_daoxing(dao)+"道行!\n",pet);
 ::die();
}

void heart_beat()
{
object pet = this_object();
object master;
 ::heart_beat();
master = find_player(query("owner"));
if (!master) return reset();
if(environment(pet)!=environment(master)) 
pet->move(environment(master));
}

void unconcious()
{
	return die();
}

string query_save_file()
{
        string id;
        id = query("owner");
        if( !id ) return 0;
        return sprintf(DATA_DIR"pet/%c/%s", id[0], id);
}


int restore()
{
        string file;

        if( stringp(file = this_object()->query_save_file()) )
                return restore_object(file);
        return 0;
}

void init()
{	seteuid(getuid());
	add_action("do_kill",({"kill","fight","steal"}));
      add_action("do_get","get");
	add_action("do_drop","drop");
	add_action("do_dispose","dispose");//销毁宠物
	add_action("do_mount","mount");
        add_action("do_shape","shape");// 查看坐骑  ok
        add_action("do_cure","fumo");// 治疗pet  ok
        add_action("do_cundang","cundang");// 宠物save ok
}

int do_cure()
{
       object me;
       object pet = this_object();
       int sen,kee;
       me = this_player();
       kee = pet->query("max_kee");
       sen = pet->query("max_sen");
   if (me->is_busy())
       return notify_fail("你现在正忙着呢！\n");
   if (me->is_fighting())
        return notify_fail("你都自身难保了还想着宠物？\n");
	if(pet->query("owner")==me->query("id"))
        {         
                if (pet->query("kee") < pet->query("max_kee")
                   ||pet->query("sen") < pet->query("max_sen") )
               {
                  message_vision(HIC"$N怜爱的抱着$n，运起月光神术治疗着$n受伤的伤口。\n"NOR, me,pet);
                pet->add("sen",sen/10);
                if (pet->query("sen")>pet->query("max_sen")) pet->set("sen",sen);
                pet->add("kee",kee/10);
                if (pet->query("kee")>pet->query("max_kee")) pet->set("kee",kee);
                pet->add("eff_sen",sen/10);
                if (pet->query("eff_sen")>pet->query("max_sen")) pet->set("eff_sen",sen);
                pet->add("eff_kee",kee/10);
                if (pet->query("eff_kee")>pet->query("max_kee")) pet->set("eff_kee",kee);
             message_vision(HIC"$n亲密的舔了舔$N的手，情况看起来好多了。\n"NOR, me,pet);
                me->start_busy(3);
                   return 1;
                   }
             else {
                     message_vision(HIM"$n活蹦乱跳的围着$N打转，看起来状况非常好。\n"NOR, me,pet);
                 }
            }

        else write(HIW"这里有你的宠物?\n"NOR);
        return 1;
}
string status_color(int current, int max)
{
        int percent;

        if( max>0 ) percent = current * 100 / max;
        else percent = 100;
        if( percent > 100 ) return HIC;
        if( percent >= 90 ) return HIG;
        if( percent >= 60 ) return HIY;
        if( percent >= 30 ) return YEL;
        if( percent >= 10 ) return HIR;
        return RED;
}

int do_cundang()
{	
        object pet,me;
        pet=this_object();
	me=this_player();
	if(pet->query("owner")==me->query("id"))
	 { 
             if( time()-(int)me->query_temp("petsave_end") < 60 ) 
                return notify_fail("宠物存档需间隔1分钟！\n");
        	if(pet->save()) message_vision("$N存档成功!\n",pet);
        	else message_vision("$N存档失败!\n",pet);
              me->set_temp("petsave_end",time());
         }
        else write(HIW"这里有你的宠物?\n"NOR);
        return 1;
}
int do_shape(string arg)
{
          object me,who;
          me = this_player();
          who = this_object();
          if(who->query("owner")==me->query("id"))
           {       mapping my;
         int exp,mlevel,nlevel,i;
        exp=who->query("combat_exp");
        mlevel=who->query("max_petlevel");
        nlevel=who->query("now_petlevel");
        i = nlevel*nlevel*nlevel*10000 + 10000;
        my = query_entire_dbase();
        printf("★★★★★★★★★★★★★★★宠物属性★★★★★★★★★★★★★★★\n");
        printf("\n精：%s%3d/ %3d %s(%3d%%)"NOR"\n气：%s%3d/ %3d %s(%3d%%)"NOR"\n神：%s%3d/ %3d %s(%3d%%)\n"+NOR,
                status_color(my["gin"], my["eff_gin"]), my["gin"],my["eff_gin"],
                status_color(my["eff_gin"], my["max_gin"]),     my["eff_gin"] * 100 / my["max_gin"],
                status_color(my["kee"], my["eff_kee"]), my["kee"], my["eff_kee"],
                status_color(my["eff_kee"], my["max_kee"]),     my["eff_kee"] * 100 / my["max_kee"],
                status_color(my["sen"], my["eff_sen"]), my["sen"], my["eff_sen"],
                status_color(my["eff_sen"], my["max_sen"]),     my["eff_sen"] * 100 / my["max_sen"]
        );              
        printf("主人： %s\t经验： %d\t道行： %d\n",
        my["owner"], my["combat_exp"],my["daoxing"]
        );
        printf("最高等级： %d\t目前等级： %d\t升级经验：%d\t成长率：%d\n",
        mlevel, nlevel,i,who->query("levelup")
        );
        printf("膂力： %d\t悟性： %d\t灵性： %d\t根骨： %d\n",
        query_str(), query_int(),query_spi(),query_con()
        );
        printf("胆识： %d\t定力： %d\t容貌： %d\t福缘： %d\n\n",
        query_cor(), query_cps(),query_per(),query_kar()
        );
        printf("伤害力： %d\t盔甲防御力： %d\t内功防御力： %d\t法术防御力： %d\n\n",
        who->query_temp("apply/damage"), who->query_temp("apply/armor"),who->query_temp("apply/armor_vs_force"),who->query_temp("apply/armor_vs_spells")
        );
        printf("★★★★★★★★★★★★★★★骑乘附加★★★★★★★★★★★★★★★\n");
        printf("命中率： %d\t轻功等级： %d\t招架等级： %d\t法术等级： %d\n",
        who->query("ride/mingzhong"),who->query("ride/dodge"),who->query("ride/parry"),who->query("ride/spells")
        );
        printf("兵器伤害力： %d\t盔甲防御力： %d\t内功防御力： %d\t法术防御力： %d\n",
        who->query("ride/damage"),who->query("ride/armor"),who->query("ride/armor_vs_force"),who->query("ride/armor_vs_spells")
        );
        printf("★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★\n");

          }
        return 1;
}

int do_mount(string arg)
{
     object me=this_object(),who=this_player(),env;
     if(!arg) return 0;
     env = environment(who);
     if(present(arg,env)!=me) return 0;
     if(me->query("owner")==who->query("id")) return 0;
     message_vision("$n左躲右闪，$N累得满头大汗也没骑上去。\n",who,me);
     return 1;
}

int do_drop(string arg)
{
     object me=this_object(),who=this_player(),env;
     if(!arg) return 0;
     env = environment(who);
     if(present(arg,who)!=me) return 0;
     if(me->move(env)) {
       message_vision("$N把$n从怀里放了下来。\n",who,me);
       return 1;
     }
     return 0;
}

int do_get(string arg)
{    object me=this_object(),who=this_player(),env;
     
     if(!arg) return 0;
     env = environment(who);
     if(present(arg,env)!=me) return 0;
     if(who->query("id")==me->query("owner"))
      {
      if(me->move(who)) {
       message_vision("$N弯下腰把$n抱了起来，搂在怀里。\n",who,me);
      } else {
       message_vision("$N弯下腰一抱却没把$n抱起来，小家伙好沉哪！\n",who,me);
      }
     } else {
      message_vision("$N蹲下身朝$n伸开双手，$n却一下子闪开了．．．\n",who,me);
     }
     return 1;
}

int do_kill(string arg)
{       
	object me,who;
    string verb,what,obj;
	if (!arg) return 0;
	verb=query_verb();
	me=this_player();
	
	if(verb=="steal") {
	  if(sscanf(arg, "%s from %s", what, obj)!=2 ) 
	    return 0;
          }
        else obj=arg;

	if(!objectp(who=present(obj,environment(me))) 
	   || !living(who)) return 0;

	if(who==this_object()) {
	  switch(verb) {
	    case "kill":
	      tell_object(environment(this_object()),
	        who->query("name")+"拼命地哭了起来：主人，"+
                me->query("name")+"要杀我．．．快回来呀！\n");
	      break;
            case "fight":

	      tell_object(environment(this_object()),
		who->query("name")+"哭了起来：主人，"+
                me->query("name")+"要抢我的糖吃．．．快回来呀！\n");
              break;
	    case "steal":

	      tell_object(environment(this_object()),
		who->query("name")+"哭了起来：主人，"+
		me->query("name")+"要偷吃我的糖！\n");
              break;
          }
        }
        command(verb);
	return 0;
}

void relay_emote(object ob, string verb)
{
        if( !userp(ob) ) return;

        switch(verb) {
        case "kick":
           	command("say 主人～～，主人～～，"  + ob->query("name") + "踢我耶！");
		command("kick " + ob->query("id"));
                        break;
        case "slap":
                command("say 主人～～，主人～～，"  + ob->query("name") +
"打我耶，好痛啊～～～～");
                command("slap " + ob->query("id"));
                        break;
	case "hit":
                command("pain " + ob->query("id"));
                        break;
        case "bite":
                command("face " + ob->query("id"));
                        break;  
        case "papaya":
                command("pout");
                        break;  

                }
}
int  do_dispose(string arg)
{
   object me = this_player();
   object pet = this_object();
    
   if(pet->query("owner") != me->query("id")) 
      return notify_fail("这......这个宠物好象不是你的耶！\n");
   if(me->query_temp("ridee"))   
      return notify_fail("请先从宠物的背上下来吧！\n");
   write("你确定要抛弃你的"+pet->query("name")+"(y/n)");
   if (me->query_temp("pet")==1)
   {
     me->set_temp("apply/dodge",0);
     me->set_temp("pet",0);
   }

     
   input_to( (: confirm_dispose :), me, pet); 
   return 1;
}

void confirm_dispose(string arg,object me, object pet)
{
   string msg;

   if( arg == "y" || arg == "Y" )  {
	me->delete("pet");
	msg="$N哀怨地看了$n一眼，化成点点月光永远的消失了。\n";
	message_vision(msg,pet,me);
    me->delete_temp("ride/dodge");
    me->delete_temp("ride/parry");
    me->delete_temp("ride/spells");
    me->delete_temp("ride/damage");
    me->delete_temp("ride/armor");
    me->delete_temp("ride/armor_vs_force");
    me->delete_temp("ride/armor_vs_spells");
    me->delete_temp("ride/mingzhong");
    me->delete("pet/pet_id");
	destruct( pet );
   return;
   }

   return;
}

void relay_whisper(object me, string msg)
{
        if (me->query("id")!=query("owner"))
        {
                message_vision((string)this_object()->query("name")
                        + "疑惑地看着$N。\n", me);
                return;
        }

        if( strsrch(msg, "chat") != -1 ||
            strsrch(msg, "sldh") != -1 ||
            strsrch(msg, "es") != -1 ||
            strsrch(msg, "rumor") != -1 ||  
            strsrch(msg, "xyj") != -1 ||  
            strsrch(msg, "tell") != -1 ||
            strsrch(msg, "follow") != -1 ||
strsrch(msg, "ask") != -1 ||
strsrch(msg, "study") != -1 ||
strsrch(msg, "xiudao") != -1 ||
strsrch(msg, "mount") != -1 ||
strsrch(msg, "wield") != -1 ||
strsrch(msg, "wear") != -1 ||
strsrch(msg, "get") != -1 ||
strsrch(msg, "eat") != -1 ||
            strsrch(msg, "read") != -1 ||
            strsrch(msg, "apprentice") != -1 ||
            strsrch(msg, "recruit") != -1 )
                return;

        if (msg)
        {
                remove_call_out ("relaying");
                call_out ("relaying", 1+random(3), msg);
        }
}

void relaying (string msg)
{
        command (msg);
}

