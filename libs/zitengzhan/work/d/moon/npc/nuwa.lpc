#include <ansi.h>
inherit CJNPC_EASY;
inherit F_MASTER;
int begin_go();
int pfm_luoye();


void create()
{
       set_name("女娲娘娘",({"nu wa","niangniang"}));
       set("long", "容貌瑞丽，瑞彩翩□国色天姿，宛然如蕊宫仙子临凡\n");
       set("title", HIC"补天神女"NOR);
       set("gender", "女性");
       set("age", 30);
       set("str", 1000);
       set("class", "xian");
       set("attitude", "friendly");
       set("rank_info/respect", "娘娘");
       set("per", 30);
	set("int", 30);
       set("max_kee", 4000);
       set("max_gin", 4000);
       set("max_sen", 4000);
       set("kee", 4000);
       set("gin", 4000);
       set("sen", 4000);
       set("force", 16000);
       set("max_force", 8000);
       set("force_factor", 300);
       set("max_mana", 8000);
       set("mana", 16000);
       set("mana_factor", 300);
       set("combat_exp", 10000000);
       set("daoxing", 8000000);
       set("eff_dx", 100000);
       set("combat_exp", 12500000);
       set_skill("literate", 280);
       set_skill("unarmed", 280);
       set_skill("dodge", 280);
       set_skill("force", 280);
       set_skill("parry", 280);
       set_skill("blade", 280);
       set_skill("sword", 280);
       set_skill("spells", 280);
       set_skill("moonshentong", 280);
       set_skill("jueqingbian", 280);
       set_skill("xuanhu-blade", 280);
       set_skill("baihua-zhang", 280);
       set_skill("moonforce", 280);
       set_skill("snowsword", 280);
       set_skill("moondance", 280);
       set_skill("whip", 280);
       map_skill("spells", "moonshentong");
       map_skill("unarmed", "baihua-zhang");
       map_skill("whip", "jueqingbian");
       map_skill("force", "moonforce");
       map_skill("sword", "snowsword");
       map_skill("parry", "snowsword");
       map_skill("dodge", "moondance");
       map_skill("blade", "xuanhu-blade");

       create_family("月宫", 1, "弟子");
       set("chat_chance_combat", 90);
/*
       set("chat_msg_combat", ({
                (: cast_spell, "mihun" :),
                (: cast_spell, "arrow" :),
                (: cast_spell, "shiyue":),
                (: perform_action, "sword", "wuxue" :),
                (: perform_action, "sword", "tian" :),
          }) );
*/
     set("inquiry", ([
         "灵台观礼": (: begin_go :),
//	 "落叶飞花": (: pfm_luoye :),
		 ]) );
       setup();
       carry_object("/d/moon/obj/luoyi")->wear();
       carry_object("/d/npc/obj/sword2")->wield();
       
}

void init()
{
	::init();
	add_action("do_agree", "agree");
}

void attempt_apprentice(object ob)
{
   
   ob=this_player();
   if(ob->query("obstacle/number") < 26) {
	command("say 这位" + RANK_D->query_respect(ob) + "我等你取经归来的好消息！\n");
	command("addoil");
	return;
	}	
   if ((int)ob->query("daoxing") < 1000000 ) {
  	command("shake");
 	command("say 你道行不够高深。\n");
	return;
      }
   if( (int)ob->query_skill("moonshentong", 1) < 180 ) {
	command("say 这位" + RANK_D->query_respect(ob) + "对月宫仙法领会还不够深，现在收你也是勉为其难！\n");
	command("sigh");
	return;
	}   
   
     command("pat "+ob->query("id"));
     command("say 既然" + RANK_D->query_respect(ob)+ "如此，我就收下你了。\n");
        command("recruit " + ob->query("id") );
        return ;
}

int recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "xian");
     ob->set("title", HBBLU"广寒宫女娲传人"NOR);
}

int accept_object(object me, object ob)
{
	if ((ob->query_temp("owner")!=me)||(ob->query("name")!=RED"补天石"NOR))
	{
		command ("say 这是什么东西？");
		return 1;
	}
    message_vision(HIW"\n女娲娘娘道：没错，"+RANK_D->query_respect(me)+ "果然能打败苗族神兽，取回上古神器"+NOR""+HIY"补天石"+NOR""+HIW"！\n"NOR,me);
    me->set("fangcun/panlong_moon_stone","done");
	return 1;
}

int begin_go()
{
	object me,ob;
   	int dx,dx1,wx,qn;
    me=this_player();
	ob=this_object();
	dx=(me->query("daoxing"))/20;
if (dx>=100000) dx=100000;
	dx1=dx/1000;
	wx=(me->query("combat_exp"))/20;
if (wx>=10000) wx=10000;
	qn=30000;
    if (!me->query("fangcun/panlong_visite"))
	  return 0;
    if (me->query("guanli/moon"))
	  return 0;
    
		if (me->query("fangcun/panlong_moon")=="done")
	{
        message_vision(HIW"\n女娲娘娘道：既然"+RANK_D->query_respect(me)+ "来请,妾身这就动身！\n"NOR,me);
        message_vision(HIY"\n\n女娲娘娘飘然驾祥云往三星洞飞去！\n"NOR,me);
		ob->move("/d/lingtai/inside1");
        return 1;
	}
	    if ((me->query("fangcun/panlong_moon_stone")=="done")&&(me->query_temp("moon_pig")))
	{
		me->add("fangcun/panlong_visite",1);
		me->set("fangcun/panlong_moon","done");
		me->delete("fangcun/panlong_moon_stone");
		me->delete("fangcun/panlong_moon_pig");
       message("chat",HIC+"〖"+HIW+"大唐西游"+HIC+"〗女娲娘娘(Nu wa)："+me->query("name")+RANK_D->query_respect(me)+"为解救众生，不辞辛苦远赴苗疆，他日灵台观礼月宫定然前往祝贺！\n"NOR,users());
         message("chat",HIC+"〖"+HIW+"大唐西游"+HIC+"〗女娲娘娘(Nu wa)："+me->query("name")+"得到奖励：道行"+chinese_number(dx1)+"年，武学"+wx+"点，潜能30000点．\n"NOR,users());
   	    if (me->query("family/family_name")=="方寸山三星洞")
		   message_vision("\n女娲娘娘点头道：观礼之日还望" + RANK_D->query_respect(me) + "再来通知妾身一声.\n"NOR,me);
		me->add("daoxing",dx);
		me->add("combat_exp",wx);
		me->add("potential",30000);
           //added by mudbug on 2003/3/11 to perfect datawatch
        me->add("data_watch_exp",dx+wx);
       me->save();
	    if ((me->query("family/family_name")!="方寸山三星洞")||(me->query("fangcun/panlong_noway")))
			me->set("guanli/moon",1);
		return 1;
	}
/*	if ((me->query("fangcun/panlong_moon_stone")=="done")&&(me->query_temp("moon_pig")))
	{
              command("hmm "+me->query("id"));
    		  command("say 难道" + RANK_D->query_respect(me) + "不管那天蓬元帅了？\n");
			  return 1;
	}
*/
	if (me->query("fangcun/panlong_moon_stone")=="done")
	{
	          command("nod "+me->query("id"));
    		  command("say " + RANK_D->query_respect(me) + "帮我取来"+HIY"补天石"NOR""+CYN"解救天下众生于水火，真是功德不小．\n");
   //	  	      message_vision("\n女娲娘娘微笑着给$N一把金击子和一个丹盘．\n"NOR,me);
			  // 任务二，fangcun/panlong_moon_pig
			  me->set_temp("moon_pig",1);
			  return 1;
	}


    if (me->query("fangcun/panlong_moon")!="begin")
    {
	 me->set_temp("go_miaozhai",1);
	 command("say 既是菩提祖师派人来请，妾身理应即刻随" + RANK_D->query_respect(me) + "前往灵台观礼，只不过前日我
              夜观天际，发现天边破了一个小洞，如不及时寻来"+HIY"补天石"+NOR""+CYN"天火降于世间，生灵
              涂炭．" + RANK_D->query_respect(me) + "来得正好，不知" + RANK_D->query_respect(me) + "可否愿意去苗疆寻来"+HIY"补天石"+NOR""+CYN"解救天下众生
              于水火？"+NOR""+HIC"(agree)"+NOR""+CYN"\n");
	 me->set("fangcun/panlong_moon","begin");
	return 1;
	}
  command("say 唉。。。。。。我就再送" + RANK_D->query_respect(me) + "一程吧？\n\n");
  me->move("/d/shuiyue/miaozhai/miaozhai_34_24");
  return 1;
}

int do_agree(string arg)
{
      object me=this_player();
    if (!me->query_temp("go_miaozhai"))
		return 0;
	me->delete_temp("go_miaozhai");
	command("say " + RANK_D->query_respect(me) + "如此侠义心肠，不愧是菩提高徒，就让妾身送" + RANK_D->query_respect(me) + "一程吧？\n\n");
	me->move("/d/shuiyue/miaozhai/miaozhai_34_24");
	return 1;
}

int pfm_luoye()
{
	object me,ob;
	me=this_player();
	ob=this_object();
	if (me->query("fangcun/luoye_accept")=="done")
	{
        command("say " + RANK_D->query_respect(me) + "，你已经领悟了落叶飞花，还来干什么！\n");
		return 1;
	}
	if (me->query("family/family_name")!="月宫")
	{
		command("你非我月宫弟子怎么能学月宫镇宫绝学？\n");
		return 1;
	}
	if (!me->query("guanli/moon"))
	{
		command("say 徒儿，我看你学落叶飞花还不是时候，你还是过些时候再来吧。\n");
		return 1;
	}
  if (me->query("family/master_name") != "女娲娘娘" ||me->query("family/master_id") != "nu wa")// huarong 2003.8
   {
          command("say 徒儿，我看你学落叶飞花还不是时候，你还是磨练磨练再来吧。\n");
          return 1;
      }
	if (!me->query("fangcun/panlong_moon"))
	{
		command("say 徒儿，你资质有限，至于落叶飞花乃是可遇不可求。\n");
		return 1;
	}
	

	if (me->query("fangcun/panlong_visite")<=3)
	       {
	        command("say 徒儿，你所经历的磨练似乎不够！\n");
            return 1;
		   }
    if (me->query("betray/count"))
   {
     command("say 徒儿，你判师后来投我月宫，这落叶飞花你是学不会的．\n");
	 return 1;
   }
   me->delete("fangcun/panlong_moon");
//   target->set_temp("block_msg/all", 0);
   message_vision(NOR"\n\n\n\n女娲娘娘转过身来对$N道："+HIC"乖徒儿，落叶飞花既是月宫镇宫绝招，也是千万年来被禁招数，一旦使用
                        者入了魔道，唉。。。。。。注意看好了！\n\n\n\n\n"NOR,me);
   me->set_temp("block_msg/all", 1);
   call_out("direct_luoye",7,ob,me);
   return 1;
}

void direct_luoye(object me,object target)
{
	if (!target) return;
	target->set_temp("block_msg/all", 0);
	message_vision(HIC"\n                  $N使出月宫不传之密"+HIY"[落叶]"+NOR""+HIC"，身行顿时有如\n\n"NOR,me,target);
	message_vision(HIW"		    	      飘忽若风回，轻灵似雪舞 \n"NOR,me,target);
	message_vision(HIW"			      芙蓉羞闭月, 落叶舞飞花\n\n" NOR,me,target);
    message_vision(HIC"    刹那间方圆三尺之内剑气纵横,片片"+HIY"[落叶]"+NOR""+HIC"漫天飞舞,竟好似长了翅膀一样,向$n飞来！\n\n\n" NOR,me,target);
    target->set_temp("block_msg/all", 1);
	call_out("direct_luoye1",8,me,target);
}

void direct_luoye1(object me,object target)
{
	if (!target) return;
	target->set_temp("block_msg/all", 0);
	message_vision(CYN"\n\n\n风吹仙诀飘飘举,犹似霓裳羽衣舞,深秋月清空.不知乘月几人归,"+HIY"[落叶]"+NOR""+CYN"摇清满江树,清泉石上流.\n"NOR,me,target);
	message_vision(CYN"$N临风舞剑,招式虽柔,却暗藏杀机.剑气突然间呼啸暴起,飞沙走石,气势惊人.$n哪里分得"+NOR""+"\n"NOR,me,target);
    message_vision(CYN"清什么是人影,什么是"+HIY"[落叶]\n\n\n"NOR,me,target);
	target->set_temp("block_msg/all", 1);
    call_out("direct_luoye2",7,me,target);
}

void direct_luoye2(object me,object target)
{
	string weapon=me->query_temp("weapon");
	if (!target) return;
	target->set_temp("block_msg/all", 0);
	message_vision(HIW"\n\n\n                       疏星淡月,断云微渡,表里俱澄清.\n"NOR,me,target);
    message_vision(HIY"\n\n[落叶]"+NOR""+CYN"舞的正急,$n不知不觉看得痴了,"+HIY"[落叶]"+NOR""+CYN"怎会容情?"+CYN"$N悠悠道:$n接我"+HIY"[落叶]\n"NOR,me,target);
    message_vision(CYN"最后一招.$N话音未落,手中"+NOR""+weapon->query("name")+CYN"腾空而起,化作万道寒光射向$n\n\n\n\n\n"NOR,me,target);
	target->set_temp("block_msg/all", 1);
	call_out("direct_luoye3",8,me,target);
}

void direct_luoye3(object me,object target)
{
	string weapon=me->query_temp("weapon");
	if (!target) return;
	target->set_temp("block_msg/all", 0);
	message_vision(HIW"\n                       香雾云鬓湿,清辉玉臂寒.\n"NOR,me,target);
    message_vision(HIC"\n$N步履凌波,剑随人影动,丰肌清骨,容态尽天真.手中"+NOR""+weapon->query("name")+HIC"连动数下,$n已然中剑.\n\n\n\n\n"NOR,me,target);
	target->set_temp("block_msg/all", 1);
	call_out("direct_luoye4",7,me,target);
}

void direct_luoye4(object me,object target)
{
	string weapon=me->query_temp("weapon");
	if (!target) return;
	target->set_temp("block_msg/all", 0);
	message_vision(HIY"\n[落叶]"+NOR""+HIC"发挥到顶峰,$N只觉灵力源源不断的涌来,顿时精神大振,将"+HIY"[落叶]"+NOR""+HIC"发挥的淋漓尽致.\n"NOR,me,target);
    message_vision(HIC"只见$N手中"+NOR""+weapon->query("name")+HIC"脱手飞出回旋斩中$n腰间,又连起几剑.$n已身中数招.\n\n\n\n\n"NOR,me,target);
	target->set_temp("block_msg/all", 1);
	call_out("direct_luoye5",7,me,target);
}

void direct_luoye5(object me,object target)
{
	if (!target) return;
	target->set_temp("block_msg/all", 0);
	message_vision(HIY"\n[落叶]"+NOR""+HIC"招数已然用尽,$N头脑中却异常清醒,灵光闪过竟然在战斗中悟出"+HIY"[落叶]"+NOR""+HIC"失传绝招\n\n\n"NOR,me,target);
    message_vision(HIY"                        [叶落花飞封满江],[独映孤舟伴月眠]"+NOR"\n\n\n"+HIC"人影晃动间已不见$N的踪迹,留下漫天剑光闪动,$n大骇,全身不知中了多少剑,鲜血四下\n"NOR,me,target);
    message_vision(HIC"里喷了出来.\n\n\n\n"NOR,me,target);
	target->set_temp("block_msg/all", 1);
	call_out("direct_luoye6",8,me,target);
}

void direct_luoye6(object me,object target)
{
	string weapon=me->query_temp("weapon");
	if (!target) return;
	target->set_temp("block_msg/all", 0);
	message_vision(HIY"\n\n[落叶]"+NOR""+HIC"发挥到顶峰,$N忽觉灵力不济,内力断断续续传来,才知道招数至此已是强弩之末.\n"NOR,me,target);
  	message_vision(HIC"$N略一凝神,尽最后力气攻出一剑,只见$N手中"+NOR""+weapon->query("name")+HIC"脱手飞出回旋斩中$n腰间.\n\n\n\n\n\n"NOR,me,target);
	target->set_temp("block_msg/all", 1);
	call_out("direct_luoye7",7,me,target);
}

void direct_luoye7(object me,object target)
{
	if (!target) return;
	target->set_temp("block_msg/all", 0);
    message_vision(HIR"\n\n\n\n\n\n\n$n只看得身随意动，眼前女娲娘娘化作千万只影子一剑接一剑的向$n攻过来，剑影如"NOR+HIY"[落叶]"NOR+HIR"似"NOR+HIY"[飞花]"NOR+HIR"\n$N身中无数剑后，脑中一片空白，满身鲜血，终于支持不住晕了过去.\n"NOR,me,target);
	message("system", HIR "\n\n\n\n你的眼前一黑，接着什么也不知道了．．．\n\n" NOR,target);
	target->set_temp("block_msg/all", 1);
	call_out("direct_luoye8",15,me,target);
}

void direct_luoye8(object me,object target)
{
	if (!target) return;
	target->set_temp("block_msg/all", 0);
	message("system", HIR "\n\n\n\n冥冥中，你不知道自己到底在哪里，不知道自己是否还活着。。。。。。\n\n" NOR,target);
	target->set_temp("block_msg/all", 1);
	call_out("direct_luoye9",20,me,target);
}

void direct_luoye9(object me,object target)
{
	if (!target) return;
	target->set_temp("block_msg/all", 0);
	target->set("gin", 1);
	target->set("kee", 1);
	target->set("sen", 1);
        if (random(100)<=(95-3*(target->query("fangcun/panlong_visite"))))
	{
		message("system", HIR "\n\n\n\n过了许久。。。你慢慢醒了过来，脑子里一片混乱，什么飞花，什么落叶都没有一点印象，只有浑身的伤痛。\n\n" NOR,target);
		return;
	}
	message("system", HIY "\n\n\n\n过了许久。。。你慢慢醒了过来，飞花，落叶渐渐在脑子里聚成剑招，你一阵喜悦不由得双手乱舞，\n哪知带动一身剑伤迸裂，疼得一下子又晕了过去。\n\n\n\n" NOR,target);
	target->set("fangcun/luoye_accept","done");
	target->unconcious();
	return;
}







