//Cracked by Roath

inherit ROOM;
#include <room.h>
#include <ansi.h>
void jiang_jing(object where);
void finish_jing(object where);
void check_time(object where);
int do_hear();
void create() {
  set("short", "卧云轩");
  set("long", @LONG

此间乃是王母居处，收拾的与别处不同，竟分不出间隔来的。四面皆是雕
空玲珑木板，或「流云百蝠」，或「岁寒三友」，或山水人物，或翎毛花
卉，或集锦，或博古，或万万福寿，各种花样，皆名手雕镂，五彩销金嵌
宝的。一隔一隔，或有贮书处，或设鼎处，或安置笔砚处，或供花设瓶安
放盆景处，其格各式各样，或天圆地方，或葵花蕉叶，或连环半壁，真是
花团锦簇，剔透玲珑。
LONG);

  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/xiwangmu": 1,
  ]));
  set("exits", ([ /* sizeof() == 1 */
    "east": __DIR__ "huilang1",
  ]));

  setup();

}
/*
void init()
{
   object where=this_object();

    remove_call_out("check_time");
   check_time(where);
   add_action("do_hear","hear");
}
*/
void check_time(object where) {

  mixed *local = localtime((time() - 900000000) * 60);
  int t = local[2] * 60 + local[1];
  int phase = ((int)(t / 120));
  if (phase == 1 && (!query("jiangjing"))) jiang_jing(where);
  if (phase == 4 && query("jiangjing")) finish_jing(where);
  call_out("check_time", 60, where);
}

void jiang_jing(object where) {
  message(
    "channel:es",
    CYN + "◇" HIY "月宫" NOR "" CYN "◇" WHT "西王母[Xi wangmu]" HIR "：月宫众弟子速到卧云轩领悟月宫仙法。\n" + NOR,
    users()
  );
  tell_object(where, "西王母说道;众弟子归位开始领悟仙法。\n");
  tell_object(where, "一时仙云腾起，祥光呈照大厅。\n");
  set("jiangjing", 1);
}
void finish_jing(object where) {
  tell_object(where, "西王母朗声道:弟子们辛苦了。\n");
  set("jiangjing", 0);
}
int do_hear() {

  object me = this_player();

  if (me->is_busy())
    return notify_fail("你正忙着呢。\n");
  if (!query("jiangjing"))
    return notify_fail("月宫还没有开始领悟神机。\n");

  if ((string)me->query("family/family_name") != "月宫")
    return notify_fail("非月宫弟子不得在此听经。\n");
  if (me->query("faith") > 40000)
    return notify_fail("你已经有一定功底,不用再领悟了。\n");
  tell_object(me, "你听着听着似乎若有所悟。\n");
  me->start_busy(5);
  if ((int)me->query_skill("moonshentong", 1) < 700) {
    me->improve_skill(
      "moonshentong",
      random((int)(me->query("spi") + me->query("int")) / 2)
    ); tell_object(me, "你觉得月宫仙法进步了！\n");
  } else { tell_object(me, "你的月宫仙法已经达到一定高度，只能自己钻研了。\n"); }
  if ((int)me->query_skill("moonforce", 1) < 700) {
    me->improve_skill(
      "moonforce",
      random((int)(me->query("spi") + me->query("int")) / 2)
    ); tell_object(me, "你觉得圆月心法进步了！\n");
  } else { tell_object(me, "你的圆月心法已经达到一定高度，只能自己钻研了。\n"); }

  me->receive_damage("kee", 20);
  me->receive_damage("sen", 20);
  return 1;
}
