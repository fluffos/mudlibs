inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "荒坟堆");
  set("long", @LONG

这里是长安城南的一片荒地，周围密密麻麻地堆了好几十个坟头。
有些坟前还有些祭祀，烧纸的痕迹。四处荒凉，很少有人走动，偶
而有几只寻食的野狗跑过。
LONG);
  set("mai_corpse_able", 1);
  set("outdoors", __DIR__ "");
  set("exits", ([ /* sizeof() == 1 */
    "west": __DIR__ "broadway1",
    "down": "d/mingjie/city",

#if VRM_0001_SUPPORT
    "south": VRM_DIR "VRM_0001/entry",


#endif
  ]));


  setup();
}
int valid_leave(object me, string dir) {
  int i;
  object *inv;
  int zslev, exp, dx, xz;
  zslev = 0;
  exp = me->query("combat_exp");
  dx = me->query("daoxing");
  xz = 20000000;
  zslev = me->query("lunhui_zhuanshi");
  inv = all_inventory(this_player());
  for (i = 0; i < sizeof(inv); i++)
    if (dir == "south" && userp(inv[i])) {
      message_vision(HIM "一股强大的力量阻止了你。\n" NOR, this_player());
      me->start_busy(3);
      return notify_fail("");
    }

  if (dir == "south" && exp < xz) {
    me->start_busy(3);
    return notify_fail(HIW " 你的武学不够高，就别去送死了\n" NOR);
    return notify_fail("");
  }

  if (dir == "south" && dx < xz) {
    me->start_busy(3);
    return notify_fail(HIW " 你的道行不够高，就别去送死了\n" NOR);
    return notify_fail("");
  }

  if (dir == "south" && zslev > 0) {
    me->start_busy(3);
    return notify_fail(HIW " 转世过的玩家无法进入" HIM " 埋骨之地 " HIW "\n" NOR);
    return notify_fail("");
  }
  return ::valid_leave(me, dir);

}
