// hunpo.c


inherit COMBINED_ITEM;

void create()
{
        set_name("[1;37m魔灵魂魄[2;37;0m", ({"hunpo"}));
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long",    "魔头的本命魂魄，似乎兑换使者正需要它。\n");
                set("unit", "些");
                set("base_unit", "份");
                set("base_weight", 1);
                set("value", 1);
                }
        set_amount(1);
        setup();
}

