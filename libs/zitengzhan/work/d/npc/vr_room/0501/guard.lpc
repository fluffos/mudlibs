#include <ansi.h>
inherit NPC;

string *first_name = ({ "毒蛇", "巨蟒", "蛟蛇" });
string *first_id = ({ "dushe", "jumang", "jiaoshe" });
string *name_words = ({ "妖", "怪", "精" });
string *id_words = ({ "yao", "guai", "jing" });
void set_hp_status(object me);

void create(object ob) {
  object me = this_object();
  string name;
  int i, j, d, p;

  d = random(sizeof(first_name));
  name = first_name[d];
  p = random(sizeof(name_words));
  name += name_words[p];
  set_name(HIB + name + NOR, ({ first_id[d] + " " + id_words[p] }));
  i = 100;
  j = 50;

  set("race", "野兽");
  set("age", 20);
  set("vrm_guard", 1);
  set("long", "一条修炼成精的蛇类精怪。\n");
  set("attitude", "aggressive");
  set("class", "yaomo");
  set("combat_exp", 2000000 + random(2000000));
  set("daoxing", 2000000 + random(2000000));
  set("limbs", ({ "头部", "身体", "尾巴" }));
  set("verbs", ({ "bite" }));
  set("str", 30);
  set("max_kee", 4000);
  set("max_sen", 4000);
  set("max_force", 4000);
  set("force", 4000);
  set("max_mana", 4000);
  set("mana", 4000);
  set("food", 50000);
  set("water", 50000);
  set_weight(30000);
  set("no_steal", 1);
  set("force_factor", 100);
  set("mana_factor", 100);
  set("lunhui_zhuanshi", 0);
  add_temp("apply/damage", 100);
  add_temp("apply/attack", 100);
  // add_temp("apply/dodge", 40);
  //add_temp("apply/spells", 40);
  add_temp("apply/armor", 300);
  //add_temp("apply/armor_vs_force",100);
  //add_temp("apply/armor_vs_spells",100);
  set("title", HIR "喜食人肉" NOR);


  set_skill("huntian-qigong", i + random(j));
  set_skill("yaofa", i + random(j));
  set_skill("unarmed", i + random(j));
  set_skill("parry", i + random(j));
  set_skill("dodge", i + random(j));
  set_skill("force", i + random(j));
  set_skill("spells", i + random(j));
  map_skill("spells", "yaofa");
  map_skill("force", "huntian-qigong");
  create_family("陷空山无底洞", 3, "弟子");
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: command, "chan" :),
    (: command, "say 人肉！人肉！新鲜的人肉啊！" :),
    (: command, "exert recover" :),
  }));

  setup();
  carry_object("/d/npc/vr_room/0501/obj/tooth.lpc");
  add_money("gold", 10);
}

void kill_ob(object ob) {
  object me = this_object();
  set_temp("my_killer", ob);
  ::kill_ob(ob);
}

void init() {
  ::init();
  add_action("do_block", "", 1);
}

int do_block(string arg) {
  object me = this_object();
  object who = this_player();
  string verb = query_verb();

  int t;

  if (!userp(who) && wizardp(who)) return 0;

  if (verb != "go" &&
    verb != "fly" &&
    !(environment() && environment()->query("exits/" + verb)))
    return 0;

  t = 0;
  t = who->query_temp("passmaze");
  if (t > 0) {
    message_vision(HIY "$n身上发出万丈光芒，$N顿时被照的晕头转向，$n趁机溜了过去。\n" NOR, me, who);
    who->add_temp("passmaze", -1);
    return 0;
  }

  tell_object(who, HIM "" + me->name() + "身子一晃，堵住了你的去路！\n" NOR);
  return 1;
}

void die() {
  string owner;
  string str, err;
  string msg;
  object owner_ob, newitem;
  object me = this_object();
  object ob = query_temp("my_killer");
  object ps;
  object qs;
  object killer = query_temp("last_damage_from");
  object where = environment(me);
  int exp, dao, pot;
  exp = me->query("combat_exp") / 20000;
  dao = exp * 3 / 4;
  pot = exp / 3;
  owner_ob = ob;
  ob->add("combat_exp", exp);
  ob->add("daoxing", dao);
  ob->add("potential", pot);
  message_vision(HIY "$N高声呼喊：弟兄们为我报仇！！。\n" NOR, me);

  if (random(3) == 1) {
    ps = new("/d/npc/vr_room/0501/obj/tooth.lpc");
    ps->move(where);
    message_vision("\n" HIY "       喀嚓一声脆响，$N被你打落了一枚$n" HIY "掉在地上！\n" NOR, me, ps);
  }

  if (random(10) > 8)  //产生装备的百分比
  {
    ob->set_temp("mieyao/level", 8 + random(4));
    if (killer) err = catch(newitem = NEWITEMS_OB->get_item(me, killer));
    if (!err && newitem) {
      message_vision("$N丢下了一" + newitem->query("unit") + newitem->query("name") + "。\n", me);
      newitem->move(environment(me));
    }
  }

  tell_object(owner_ob, HIM "你得到了" + chinese_number(exp)
    + "点武学经验和" + chinese_number(pot) +
    "点潜能、" + COMBAT_D->chinese_daoxing(dao) + "道行!\n" NOR);
  if (random(2) == 1) {
    ps = new("/d/npc/vr_room/0501/guard");
    ps->move(where);
    message_vision("\n" HIY "       只见又一条蛇串了出来冲你叫道：拿命来！\n" NOR, me, ps);
  }
  if (random(50) == 1) {
    qs = new("/d/npc/vr_room/obj/redbox");
    qs->move(killer);
    message_vision(
      "\n" HIW "       叮的一声，$N爆出一只$n" HIW "落到了" + killer->query("name") + "的身上！\n" NOR,
      me,
      qs
    );
    message(
      "channel:rumor",
      HIC + "【副本信息】迷宫精灵：" + killer->query("name") + "杀死了" + me->query("name") + "得到了" HIR "红色宝箱" HIC "！\n" + NOR,
      users()
    );
  }

  if (random(100) == 1) {
    qs = new("/d/npc/vr_room/obj/bluebox");
    qs->move(killer);
    message_vision(
      "\n" HIW "       叮的一声，$N爆出一只$n" HIW "落到了" + killer->query("name") + "的身上！\n" NOR,
      me,
      qs
    );
    message(
      "channel:rumor",
      HIC + "【副本信息】迷宫精灵：" + killer->query("name") + "杀死了" + me->query("name") + "得到了" HIB "蓝色宝箱" HIC "！\n" + NOR,
      users()
    );
  }

  if (random(10) == 1) {
    qs = new("/d/npc/vr_room/obj/baoshi");
    //  qs->move(killer);
    killer->add("baoshi/bs_ys", 1);
    message_vision(
      "\n" HIW "       叮的一声，$N爆出一块$n" HIW "落到了" + killer->query("name") + "的身上！\n" NOR,
      me,
      qs
    );
    message(
      "channel:rumor",
      HIC + "【副本信息】迷宫精灵：" + killer->query("name") + "杀死了" + me->query("name") + "得到了" HIR "原石" HIC "！\n" + NOR,
      users()
    );
  }

  destruct(this_object());
  return;
}
