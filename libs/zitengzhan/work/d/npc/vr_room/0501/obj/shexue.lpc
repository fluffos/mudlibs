inherit COMBINED_ITEM;

void create() {
  set_name("[1;37m蛇血[2;37;0m", ({ "snake blood", "blood" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一滴蛇怪的精血，是提炼某种丹药的必须品。\n");
    set("unit", "些");
    set("base_unit", "滴");
    set("base_weight", 1);
    set("value", 10000);
  }
  set_amount(1);
  setup();
}
