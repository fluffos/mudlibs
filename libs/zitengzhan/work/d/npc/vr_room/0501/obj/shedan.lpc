inherit COMBINED_ITEM;

void create() {
  set_name("[1;37m蛇胆[2;37;0m", ({ "snake dan", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一枚蛇怪的内胆，是提炼某种丹药的必须品。\n");
    set("unit", "些");
    set("base_unit", "枚");
    set("base_weight", 1);
    set("value", 10000);
  }
  set_amount(1);
  setup();
}
