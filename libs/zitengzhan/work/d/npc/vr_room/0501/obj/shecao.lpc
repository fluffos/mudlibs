

inherit COMBINED_ITEM;

void create()
{
        set_name("[1;37m聚气草[2;37;0m", ({"snake grass", "grass"}));
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long",    "一份蛇怪最喜欢的草药，是提炼某种丹药的必须品。\n");
                set("unit", "些");
                set("base_unit", "份");
                set("base_weight", 1);
                set("value", 10000);
                }
        set_amount(1);
        setup();
}

