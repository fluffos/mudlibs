

inherit COMBINED_ITEM;

void create()
{
        set_name("[1;37m千年蛇胆[2;37;0m", ({"bigsnake dan", "dan"}));
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long",    "一枚蛇王的内胆，是提炼某种丹药的必须品。\n");
                set("unit", "些");
                set("base_unit", "枚");
                set("base_weight", 1);
                set("value", 10000);
                }
        set_amount(1);
        setup();
}

