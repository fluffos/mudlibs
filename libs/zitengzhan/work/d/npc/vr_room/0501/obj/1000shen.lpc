

inherit COMBINED_ITEM;

void create()
{
        set_name("[1;37m千年人参[2;37;0m", ({"big ginshen", "ginshen"}));
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long",    "一株已成人形的千年人参，是提炼某种丹药的必须品。\n");
                set("unit", "些");
                set("base_unit", "株");
                set("base_weight", 1);
                set("value", 10000);
                }
        set_amount(1);
        setup();
}

