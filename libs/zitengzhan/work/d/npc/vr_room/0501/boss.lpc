#include <ansi.h>
inherit NPC;

string *first_name = ({ "黄金", "九头"});
string *first_id = ({ "huangjin", "jiutou"});
string *name_words = ({ "巨蛇", "巨蟒"});
string *id_words = ({ "jushe", "jumang"});
void set_hp_status(object me);
int big_blowing();

void create(object ob)
{
  object me = this_object();
  string name;
  int i, j, d, p;

  d = random(sizeof(first_name));
  name = first_name[d];
  p = random(sizeof(name_words));
  name += name_words[p];
  set_name(HIW+name+NOR, ({ first_id[d]+" "+id_words[p] }) );
  i = 200;
  j = 50;
  
  set("race", "野兽");      
  set("age", 20);
  set("vrm_guard", 1);
  set("gender", random(2)?"男性":"女性");
  set("long", "一条修炼成精的蛇类精怪。\n");
  set("attitude", "aggressive");
  set("class", "yaomo");
  set("combat_exp", 10000000+random(5000000));
  set("daoxing", 10000000+random(5000000));
  set("limbs", ({ "头部", "身体", "尾巴" }) );
  set("verbs", ({ "bite"}));
        
        set("str",60);      
        set("max_kee",30000);
        set("max_sen", 30000);
        set("max_force",30000);
        set("force",30000);
        set("max_mana",30000);
        set("mana",30000);
        set("food",50000);
        set("water", 50000);
        set_weight(30000);
        set("no_steal",1);
       set("force_factor",250);
       set("mana_factor",250);
       set("lunhui_zhuanshi",1);
       add_temp("apply/damage", 150);
       add_temp("apply/attack", 150);
      // add_temp("apply/dodge", 40);
       //add_temp("apply/spells", 40);
       add_temp("apply/armor", 200);
       add_temp("apply/armor_vs_force",100);
       add_temp("apply/armor_vs_spells",100);
       set("title",HIR"修炼成精"NOR);
     
                 
       set_skill("huntian-qigong", i+random(j));
       set_skill("yaofa", i+random(j));
       set_skill("unarmed",i+random(j));
       set_skill("parry",i+random(j));
       set_skill("dodge",i+random(j));
       set_skill("force",i+random(j));
       set_skill("spells",i+random(j));
       map_skill("spells", "yaofa");
       map_skill("force", "huntian-qigong");
        create_family("陷空山无底洞", 3, "弟子");
       set("chat_chance_combat", 50 );
       set("chat_msg_combat", ({
              (: command, "heng" :),
              (: command, "say 我身上有宝物！有本事你来拿！" :),
              (: command, "exert recover" :),
              (: big_blowing :),
                              }) );

      setup();
        carry_object("/d/npc/vr_room/0501/obj/bigtooth.lpc");
        add_money("gold", 100);
}
   
void kill_ob(object ob)
{
 object me = this_object();
  set_temp("my_killer",ob);
  ::kill_ob(ob);
}

void init()
{
  ::init();
  add_action("do_block","",1);
}

int do_block(string arg)
{
    object me=this_object();
    object who=this_player();
    string verb=query_verb();

    int t;
         
    if(!userp(who)&&wizardp(who)) return 0;

    if(verb!="go" &&
	    verb!="fly" &&
	    !(environment() && environment()->query("exits/" + verb)))
	return 0;
       
    t = 0;    
    t = who->query_temp("passmaze");
   if (t > 0)
         {        
        message_vision(HIY"$n身上发出万丈光芒，$N顿时被照的晕头转向，$n趁机溜了过去。\n"NOR,me,who);
        who->add_temp("passmaze",-1);
        return 0;
    }
          
        tell_object(who,HIM""+me->name()+"身子一晃，堵住了你的去路！\n"NOR);
        return 1;
}

int big_blowing()
{
remove_call_out("hurting");
message_vision( HIR "\n\n$N深深的吸了一口气肚子涨大了好几倍，$N的眼神更加狠毒了。\n\n" NOR,
this_object());
call_out("hurting",random(10)+2);


        return 1;
}

int hurting()
{
        int i;
        int dam;
        object ob = this_object();
        object *inv;
        message_vision( HIR "\n\n$N张嘴喷出一团烟雾，很快的充实着整个房间，你顿时被熏了个晕头转向！！！\n\n",this_object());
        inv = all_inventory(environment(this_object()));
        for(i=sizeof(inv)-1; i>=0; i--)
        if( living(inv[i]))
        if( inv[i] != this_object())
        {
        dam = query("sen")/20;
        if(dam <0) dam = 0;
        inv[i]->receive_wound("kee",dam);
        COMBAT_D->report_status(inv[i],1);
        }
        return 1;
}


void die ()
{
  string owner;
  string str,err;
  string msg;
  object owner_ob,newitem;
  object me = this_object();
  object ob = query_temp("my_killer");
  object ps;
  object killer = query_temp("last_damage_from");
  int exp,dao,pot;
  exp = me->query("combat_exp") / 10000;
  dao = exp*3/4;
  pot = exp/3;
  owner_ob = ob; 
  ob->add("combat_exp",exp);
  ob->add("daoxing",dao);
  ob->add("potential",pot);
  message_vision (HIY"$N高声呼喊：下辈子投胎一定要做人！！。\n"NOR,me);
 
  ps = new ("/d/npc/vr_room/0501/obj/bigtooth.lpc");
  ps->move(environment(me));
  message_vision ("\n"HIY"       喀嚓一声脆响，$N被你打落了一枚$n"HIY"掉在地上！\n"NOR,me,ps);

 if (random(10) > 0)  //产生装备的百分比
	 {
            ob->set_temp("mieyao/level",8+random(4));
	     if (killer) err=catch(newitem=NEWITEMS_OB->get_item(me,killer));
	     if (!err&&newitem) 
	     {
		message_vision("$N丢下了一"+newitem->query("unit")+newitem->query("name")+"。\n",me);
		newitem->move(environment(me));
	     }
	 }	    
 if (random(10) > 0)  //产生装备的百分比
	 {
            ob->set_temp("mieyao/level",8+random(4));
	     if (killer) err=catch(newitem=NEWITEMS_OB->get_item(me,killer));
	     if (!err&&newitem) 
	     {
		message_vision("$N丢下了一"+newitem->query("unit")+newitem->query("name")+"。\n",me);
		newitem->move(environment(me));
	     }
	 }	    

tell_object(owner_ob, HIM"你得到了"+chinese_number(exp)
			    +"点武学经验和"+chinese_number(pot)+
			    "点潜能、"+COMBAT_D->chinese_daoxing(dao)+"道行!\n"NOR);

if (random(300) == 1)
   {
  ps = new ("/d/npc/vr_room/obj/ztstone");
  ps->move(killer);
  message_vision ("\n"HIW"       叮的一声，$N爆出一块$n"HIW"落到了"+killer->query("name")+"的身上！\n"NOR,me,ps);
 message("channel:rumor",HIC+"【副本信息】迷宫精灵："+killer->query("name")+"杀死了"+me->query("name")+"得到了"HIM"大唐宝石"HIC"！\n"+NOR,users());
   }

  if (random(5)<1)
   {
  ps = new ("/d/npc/vr_room/obj/redbox");
  ps->move(killer);
  message_vision ("\n"HIW"       叮的一声，$N爆出一只$n"HIW"落到了"+killer->query("name")+"的身上！\n"NOR,me,ps);
 message("channel:rumor",HIC+"【副本信息】迷宫精灵："+killer->query("name")+"杀死了"+me->query("name")+"得到了"HIR"红色宝箱"HIC"！\n"+NOR,users());
   }

if (random(10)<1)
   {
  ps = new ("/d/npc/vr_room/obj/bluebox");
  ps->move(killer);
  message_vision ("\n"HIW"       叮的一声，$N爆出一只$n"HIW"落到了"+killer->query("name")+"的身上！\n"NOR,me,ps);
 message("channel:rumor",HIC+"【副本信息】迷宫精灵："+killer->query("name")+"杀死了"+me->query("name")+"得到了"HIB"蓝色宝箱"HIC"！\n"+NOR,users());
   }

if (random(30)<1)
   {
  ps = new ("/d/npc/vr_room/obj/soulbox");
  ps->move(killer);
  message_vision ("\n"HIW"       叮的一声，$N爆出一只$n"HIW"落到了"+killer->query("name")+"的身上！\n"NOR,me,ps);
 message("channel:rumor",HIC+"【副本信息】迷宫精灵："+killer->query("name")+"杀死了"+me->query("name")+"得到了"HIM"灵魂宝箱"HIC"！\n"+NOR,users());
   }

   ps = new("/d/npc/vr_room/obj/baoshi");
//  ps->move(killer);
killer->add("baoshi/bs_ys",1);
  message_vision ("\n"HIW"       叮的一声，$N爆出一块$n"HIW"落到了"+killer->query("name")+"的身上！\n"NOR,me,ps);
 message("channel:rumor",HIC+"【副本信息】迷宫精灵："+killer->query("name")+"杀死了"+me->query("name")+"得到了"HIR"原石"HIC"！\n"+NOR,users());

 destruct (this_object());
 return ;
}
