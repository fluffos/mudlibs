#include <ansi.h>
inherit ITEM;

int do_use(string);
void create() {
  set_name(BLINK " " HIW "生命宝石" NOR, ({ "aquamarine life", "life" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("long", "一枚传说中能用来起死回生的宝石，使用后(use)能恢复使用者的死亡损失。\n");
    set("no_sell", 1);
    set("no_give", 1);
    set("no_put", 1);
    set("no_get", 1);
    set("no_drop", 1);
    set("value", 1000000);
  }
  setup();
}

void init() {
  add_action("do_use", "use");
}

int do_use(string arg) {
  object me = this_object();
  object who = this_player();

  if (!id(arg))
    return notify_fail("你要使用什么？\n");
  if (!who->query("death")) {
    return notify_fail("你没有死亡记录，不能使用生命宝石！\n");
  } else {
    message_vision("\n " HIW "生命宝石" NOR " " HIM "发出耀眼光芒围绕着$N的全身，顿时天悬地转乾坤倒置！\n" NOR, who);
    if (who->query("death/combat_exp_loss")) {
      tell_object(who, BLINK " " HIC "      你突然发现你的武学全部恢复了！\n" NOR);
      who->add("combat_exp", (int)who->query("death/combat_exp_loss"));
      who->add("data_watch_exp", (int)who->query("death/combat_exp_loss"));
    }
    if (who->query("death/dx_loss")) {
      tell_object(who, BLINK " " HIC "      你突然发现你的道行全部恢复了！\n" NOR);
      who->add("daoxing", (int)who->query("death/dx_loss"));
      who->add("data_watch_exp", (int)who->query("death/dx_loss"));
    }
    if (who->query("death/skill_loss")) {
      tell_object(who, BLINK " " HIC "      你突然发现你的武功全部恢复了！\n" NOR);
      who->skill_death_recover();
    }
    log_file("RECOVER", "[" + ctime(time()) + "] " + sprintf("%s(%s)使用了生命宝石。\n"
      , who->query("name"), who->query("id")));
    who->delete("death");
    who->save();

    message_vision("\n " HIW "生命宝石" NOR " " HIM "的光芒渐渐暗淡，终于化成一堆粉末，消散于天地之间！\n" NOR, who);
    destruct(this_object());
  }
  return 1;
}
int query_autoload() { return 1; }
