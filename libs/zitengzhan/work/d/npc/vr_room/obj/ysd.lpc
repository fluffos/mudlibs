#include <ansi.h>

inherit ITEM; 

int do_eat(string);
void init();

void init()
{
  if (!wizardp(this_player())) {
    set("no_drop","这么宝贵的丹药，扔了多可惜呀！\n");
    }
    if(this_player()==environment())
  add_action("do_eat", "eat");
}
void create()
{
  set_name( HIG "养神丹" NOR , ({"yangshen dan", "dan"}));
  set_weight(90);
  
  if (clonep())
    set_default_object(__FILE__);  else {
     set("unit", "颗"); 
    set("long", "一颗珍贵无比的养神丹，吃了它可以打通八脉中的任脉。\n");
    set("value", 10000000);
    set("drug_type", "补品");
  }
  setup();}

int do_eat(string arg)
{
   object ob = this_object();
  object me = this_player();
  if (!id(arg))
    return notify_fail("你要吃什么？\n");
            message_vision(HIW"$N吃下了一颗$n，"HIW"顿时觉得神清气爽，似乎潜能被开发出来了。\n"NOR, me,ob);  
           me->add("renmai", 5+random(6));
  if (me->query("renmai") > 99)
          {
           me->set("renmai",100);
            message_vision(HIR"$N浑身红光涌动，脸色涨红，头顶三花齐现！居然打通了任脉！！\n"NOR, me);  
          }
me->save();
           destruct(this_object());
   return 1;
}
