// thousand.c

inherit MONEY;

void create() {
  set_name("一百两金票", ({ "gold-cash", "gold-cash_money", "cash" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("money_id", "thousand-cash");
    set("long", "一张面额值一百两黄金的金票。\n");
    set("unit", "叠");
    set("base_value", 1000000);
    set("base_unit", "张");
    set("base_weight", 3);
  }
  set_amount(1);
}
