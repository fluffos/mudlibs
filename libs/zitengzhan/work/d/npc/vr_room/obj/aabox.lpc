#include <ansi.h>
inherit ITEM;

int do_open(string);
void create()
{
 set_name(HIG "祝福宝箱" NOR, ({"zhufu box", "box"}));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "一只充满魔力的神奇宝箱，你可以打开(open)它试试运气。\n");
    set("no_sell", 1);
  }
   setup();
}

void init()
{
        add_action("do_open", "open");
}

int do_open(string arg)
{
  object ob = this_object();
  object me = this_player();
  object qs;
  if (!id(arg))
    return notify_fail("你要打开什么？\n");
           message_vision(HIW"$N身手往"HIG"祝福宝箱"HIW"里使劲的摸，一会儿摸出一件东西藏进了怀里。\n"NOR, me);  
           qs = new ("/d/npc/vr_room/obj/book4");
           qs->move(me);
           tell_object(me, HIM"你得到了一本"HIW"修仙秘籍"HIM"的奖励。\n"NOR); 
 message("channel:rumor",HIW+"【奖励信息】元宵礼物"HIC"："+me->query("name")+"打开了"+ob->query("name")+" "HIC"得到了一本"HIW"修仙秘籍"HIC"！\n"+NOR,users());     
           destruct(this_object());
  return 1;
}

