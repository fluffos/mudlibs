// literate.c
#include <ansi.h>
inherit ITEM;

void create() {
  int i;
  set_name(HIG "修仙秘籍" NOR, ({ "book" }));
  set_weight(500);


  set("long", "一本修仙的基本秘籍。\n");
  set("unit", "本");
  set("value", 0);
  set("no_get", 1);
  set("no_sell", 1);
  set("no_put", 1);
  set("no_give", 1);
  set("material", "paper");
  i = random(15);
  switch (i) {
    case 0:
      set("skill", ([
        "name": "spells",
        "sen_cost": 10,
        "difficulty": 5,
        "max_skill": 180,
      ])); break;
    case 1:
      set("skill", ([
        "name": "force",
        "sen_cost": 10,
        "difficulty": 5,
        "max_skill": 180,
      ])); break;
    case 2:
      set("skill", ([
        "name": "parry",
        "sen_cost": 10,
        "difficulty": 5,
        "max_skill": 180,
      ])); break;
    case 3:
      set("skill", ([
        "name": "dodge",
        "sen_cost": 10,
        "difficulty": 5,
        "max_skill": 180,
      ])); break;
    case 4:
      set("skill", ([
        "name": "whip",
        "sen_cost": 10,
        "difficulty": 5,
        "max_skill": 180,
      ])); break;
    case 5:
      set("skill", ([
        "name": "axe",
        "sen_cost": 10,
        "difficulty": 5,
        "max_skill": 180,
      ])); break;
    case 6:
      set("skill", ([
        "name": "blade",
        "sen_cost": 10,
        "difficulty": 5,
        "max_skill": 180,
      ])); break;
    case 7:
      set("skill", ([
        "name": "fork",
        "sen_cost": 10,
        "difficulty": 5,
        "max_skill": 180,
      ])); break;
    case 8:
      set("skill", ([
        "name": "hammer",
        "sen_cost": 10,
        "difficulty": 5,
        "max_skill": 180,
      ])); break;
    case 9:
      set("skill", ([
        "name": "mace",
        "sen_cost": 10,
        "difficulty": 5,
        "max_skill": 180,
      ])); break;
    case 10:
      set("skill", ([
        "name": "rake",
        "sen_cost": 10,
        "difficulty": 5,
        "max_skill": 180,
      ])); break;
    case 11:
      set("skill", ([
        "name": "spear",
        "sen_cost": 10,
        "difficulty": 5,
        "max_skill": 180,
      ])); break;
    case 12:
      set("skill", ([
        "name": "staff",
        "sen_cost": 10,
        "difficulty": 5,
        "max_skill": 180,
      ])); break;
    case 13:
      set("skill", ([
        "name": "stick",
        "sen_cost": 10,
        "difficulty": 5,
        "max_skill": 180,
      ])); break;
    default:
      set("skill", ([
        "name": "sword",
        "sen_cost": 10,
        "difficulty": 5,
        "max_skill": 180,
      ]));

  }

}

int query_autoload() { return 1; }
