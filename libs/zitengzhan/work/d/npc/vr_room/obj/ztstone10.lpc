// ztstone.c
#include <ansi.h>


inherit COMBINED_ITEM;

void create()
{
        set_name(BLINK""HIM"大唐宝石"NOR, ({"ziteng stone"}));
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long",    "开天辟地时遗落的灵气碎片，似乎兑换使者正需要它。\n");
                set("unit", "堆");
                set("base_unit", "颗");
                set("base_weight", 1);
                set("value", 0);
                }
        set_amount(10);
        setup();
}

