#include <ansi.h>

inherit ITEM; 

int do_eat(string);
void init();

void init()
{
  if (!wizardp(this_player())) {
    set("no_drop","这么宝贵的丹药，扔了多可惜呀！\n");
    }
    if(this_player()==environment())
  add_action("do_eat", "eat");
}
void create()
{
  set_name( HIG "混沌丹" NOR , ({"hundun dan", "dan"}));
  set_weight(90);
  
  if (clonep())
    set_default_object(__FILE__);  else {
     set("unit", "颗"); 
    set("long", "一颗珍贵无比的混沌丹，吃了它可以打通八脉中的心脉。\n");
    set("value", 10000000);
    set("drug_type", "补品");
  }
  setup();}

int do_eat(string arg)
{
   object ob = this_object();
  object me = this_player();
  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  if (me->query("renxmai")<100&&me->query("dimai")<100&&me->query("tianmai")<100&&me->query("lingmai")<100)
        return notify_fail("现在吃太浪费了！先打通天地人灵四脉后才能打通心命二脉！\n");
            message_vision(HIW"$N吃下了一颗$n，"HIW"顿时觉得神清气爽，似乎潜能被开发出来了。\n"NOR, me,ob);  
           me->add("xinmai", 5+random(6));
if (me->query("xinmai") > 99)
          {
           me->set("xinmai",100);
            message_vision(HIR"$N浑身红光涌动，脸色涨红，头顶三花齐现！居然打通了心脉！！\n"NOR, me);  
          }
me->save();

           destruct(this_object());
   return 1;
}
