int big_blowing() {
  remove_call_out("hurting");
  message_vision(HIR "\n\n$N" HIR "嗡的一声，只见所有的兵器都颤抖不已，好似要脱手飞去。\n\n" NOR,
    this_object());
  call_out("hurting", random(10) + 2);


  return 1;
}

int hurting() {
  int i, j;
  int dam;
  object ob = this_object();
  object *inv;
  message_vision(HIR "\n\n$N" HIR "嗡嗡嗡急速连响，抖动的越来越厉害，嗖的一下，你手上的兵器飞了出去，插在了地上！！！\n\n", this_object());
  inv = all_inventory(environment(this_object()));
  for (i = sizeof(inv) - 1; i >= 0; i--)
    if (living(inv[i]))
      if (inv[i] != this_object()) {
        if (inv[i]->query_temp("weapon")) {
          j = inv[i]->query_temp("weapon");
          if (objectp(j)) j->move(environment(ob));
        }
      }
  return 1;
}

void init() {
  ::init();
  add_action("do_block", "", 1);
}


void kill_ob(object ob) {
  object me = this_object();
  set_temp("my_killer", ob);
  ::kill_ob(ob);
}



void heart_beat() {
  int free, free1, kee_cost, sen_cost, k;
  object guai = this_object();
  object ob = this_object(), newnew;
  object me = query_temp("my_killer");
  ::heart_beat();
  free = (int)query_skill("force") / 40;
  kee_cost = (free - 1) * 100;
  sen_cost = (free1 - 1) * 100;
  k = random(8);

  if (query("eff_kee") < query("max_kee")) {
    for (int i = 3; i > 0; i--) {
      carry_object("/d/npc/vr_room/obj/jinchuangyao.lpc"); command("eat jinchuang yao"); command("exert recover");
    }
  }

  if (query("eff_sen") < query("max_sen")) {
    for (int i = 3; i > 0; i--) {
      carry_object("/d/npc/vr_room/obj/hunyuandan.lpc"); command("eat hunyuan dan"); command("exert refresh");
    }
  }

  if (is_fighting() && query("force") < query("max_force") / 2)
    command("cast transfer");
  if (query("kee") < query("eff_kee") - 10)
    command("exert recover");
  if (query("sen") < query("eff_sen") - 10)
    command("exert refresh");
  if (!is_fighting() && query("force") < query("max_force"))
    command("dazuo " + kee_cost);
  if (!is_fighting() && query("mana") < query("max_mana"))
    command("mingsi " + sen_cost);

  if (is_fighting()) {
    if (query("family/family_name") == "将军府") {
      k = random(7);
      if (!ob->query_temp("powerup") && me->query_skill("force") > 149) command("exert jingxin");
      if (k > 6) k = 6;
      switch (k) {
        case 0:
          command("perform bafang"); break;
        case 1:
          newnew = new("/d/jjf/obj/thunder_seal.lpc");
          newnew->move(ob);
          command("ji thunder seal on " + me->query("id"));
        case 2:
          newnew = new("/d/jjf/obj/light_seal.lpc");
          newnew->move(ob);
          command("ji light seal on " + me->query("id"));
        case 3:
          command("perform lianhuan"); break;
        case 4:
          map_skill("mace", "wusi-mace");
          command("perform andu"); break;
        case 5:
          command("perform sanban"); break;
        case 6:
          map_skill("mace", "jinglei-mace");
          command("perform suo"); break;
        default: return 0;
      }

    }
    if (query("family/family_name") == "东海龙宫") {
      k = random(7);
      if (!ob->query_temp("powerup") && me->query_skill("force") > 149) command("exert shield");
      if (k > 6) k = 6;
      switch (k) {
        case 0:
          command("cast water"); break;
        case 1:
          command("perform sheshen"); break;
        case 2:
          command("perform fengbo"); break;
        case 3:
          command("perform leidong"); break;
        case 4:
          command("perform shenglong"); break;
        case 5:
          command("cast hualong on " + ob->query("id")); break;
        case 6:
          command("exert lsnh"); break;
        default: return 0;
      }

    }
    if (query("family/family_name") == "月宫") {
      k = random(6);
      if (!ob->query_temp("powerup") && me->query_skill("force") > 149) command("perform huanwu");
      if (k > 5) k = 5;
      switch (k) {
        case 0:
          command("cast arrow"); break;
        case 1:
          command("cast mihun"); break;
        case 2:
          command("cast shiyue"); break;
        case 3:
          command("perform tian"); break;
        case 4:
          command("perform flower"); break;
        case 5:
          command("perform feiwu"); break;
        default: return 0;
      }

    }
    if (query("family/family_name") == "南海普陀山") {
      k = random(7);
      if (k > 6) k = 6;
      switch (k) {
        case 0:
          command("cast lianhua"); break;
        case 1:
          command("cast bighammer"); break;
        case 2:
          command("perform chaodu"); break;
        case 3:
          command("perform lingxi"); break;
        case 4:
          command("cast dashi"); break;
        case 5:
          command("cast pudu"); break;
        case 6:
          command("cast jinguzhou"); break;
        default: return 0;
      }

    }
    if (query("family/family_name") == "陷空山无底洞") {
      k = random(7);
      if (!ob->query_temp("wdd_powerup") && me->query_skill("force") > 149) command("cast bianfu");
      if (k > 6) k = 6;
      switch (k) {
        case 0:
          command("cast huanying"); break;
        case 1:
          command("cast bite"); break;
        case 2:
          command("cast suliao"); break;
        case 3:
          command("unwield blade");
          command("unwield sword");
          command("perform yingfeng"); break;
        case 4:
          command("unwield sword");
          command("wield blade");
          command("perform pozhan"); break;
        case 5:
          command("unwield sword");
          command("wield blade");
          command("perform hebi"); break;
        case 6:
          command("unwield blade");
          command("wield sword");
          command("perform shixue"); break;
        default: return 0;
      }

    }
    if (query("family/family_name") == "五庄观") {
      k = random(4);
      if (k > 3) k = 3;
      switch (k) {
        case 0:
          command("cast baxian"); break;
        case 1:
          command("cast zhenhuo"); break;
        case 2:
          map_skill("sword", "sanqing-jian");
          command("perform bagua"); break;
        case 3:
          command("cast sanqing"); break;
        default: return 0;
      }

    }
    if (query("family/family_name") == "大雪山") {
      k = random(6);
      if (k > 5) k = 5;
      switch (k) {
        case 0:
          command("cast tuntian"); break;
        case 1:
          command("perform feijian"); break;
        case 2:
          command("perform chaofeng"); break;
        case 3:
          command("exert ningxie"); break;
        case 4:
          command("perform cuixin"); break;
        case 5:
          command("perform ansha on " + me->query("id"));
        default: return 0;
      }

    }
    if (query("family/family_name") == "方寸山三星洞") {
      k = random(6);
      if (k > 5) k = 5;
      switch (k) {
        case 0:
          command("perform qizhi"); break;
        case 1:
          command("cast light"); break;
        case 2:
          command("perform pili"); break;
        case 3:
          command("perform qiankun"); break;
        case 4:
          command("perform panlong"); break;
        case 5:
          command("cast fenshen"); break;
        default: return 0;
      }

    }
    if (query("family/family_name") == "阎罗地府") {
      if (!ob->query_temp("ldlh") && me->query_skill("force") > 249) command("perform ldlh");
      k = random(7);
      if (k > 6) k = 6;
      switch (k) {
        case 0:
          command("cast inferno"); break;
        case 1:
          command("perform cmwl"); break;
        case 2:
          command("cast miehun"); break;
        case 3:
          command("cast gouhun"); break;
        case 4:
          command("perform three"); break;
        case 5:
          command("perform xingyun"); break;
        case 6:
          command("perform yanluo"); break;
        default: return 0;
      }

    }

  }
}

int do_block(string arg) {
  object me = this_object();
  object who = this_player();
  string verb = query_verb();

  int t;

  if (!userp(who) && wizardp(who)) return 0;

  if (verb != "go" &&
    verb != "fly" &&
    !(environment() && environment()->query("exits/" + verb)))
    return 0;

  t = 0;
  t = who->query_temp("passmaze");
  if (t > 0) {
    message_vision(HIY "$n身上发出万丈光芒，$N顿时被照的晕头转向，$n趁机溜了过去。\n" NOR, me, who);
    who->add_temp("passmaze", -1);
    return 0;
  }

  tell_object(who, HIM "" + me->name() + "身子一晃，堵住了你的去路！\n" NOR);
  return 1;
}

void die() {
  object me = this_object();
  object ps;
  object killer = query_temp("last_damage_from");
  int exp, kexp, mexp, dao, pot, d;
  if (objectp(killer) && killer->query("is_guard") == 1)
    killer = killer->query("possessed");
  if (objectp(killer)) {
    message_vision(HIY "$N" + HIY + "一声咆哮！化成一柄宝剑，落倒了地上，原来是通天神兵所化。\n" NOR, me);
    kexp = killer->query("combat_exp");
    mexp = me->query("combat_exp");
    exp = mexp / 1000;
    exp += (mexp - kexp) / 1000;
    if (exp < 5000) exp = 5000;
    if (exp > 50000) exp = 50000;
    dao = exp;
    pot = exp / 3;
    if (pot < 1) pot = 1;

    killer->add("combat_exp", exp);
    killer->add("daoxing", dao);
    killer->add("potential", pot);

    tell_object(
      killer,
      HIM "你得到了" + exp + "点武学经验和" + pot + "点潜能、" + COMBAT_D->chinese_daoxing(dao) + "道行的奖励!\n" NOR
    );
    TEAMK_D->teamk(killer, exp);
    ps = new("/d/npc/vr_room/obj/weapon");
    if (objectp(ps)) ps->move(environment(me));
  }
  destruct(this_object());
  return;
}
