inherit COMBINED_ITEM;

void create() {
  set_name("[1;37m神器碎片[2;37;0m", ({ "shenqi suipian", "suipian" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "神器上的一块碎片，是提炼某种丹药的必须品。\n");
    set("unit", "些");
    set("base_unit", "块");
    set("base_weight", 1);
    set("value", 10000);
  }
  set_amount(1);
  setup();
}
