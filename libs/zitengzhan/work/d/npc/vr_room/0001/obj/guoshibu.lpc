inherit COMBINED_ITEM;

void create() {
  set_name("[1;37m裹尸布[2;37;0m", ({ "guoshi bu", "bu" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "僵尸身上的裹尸布，是提炼某种丹药的必须品。\n");
    set("unit", "些");
    set("base_unit", "张");
    set("base_weight", 1);
    set("value", 10000);
  }
  set_amount(1);
  setup();
}
