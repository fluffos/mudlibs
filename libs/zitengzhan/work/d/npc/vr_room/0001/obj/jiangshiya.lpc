

inherit COMBINED_ITEM;

void create()
{
        set_name("[1;37m僵尸之牙[2;37;0m", ({"jiangshi ya", "ya"}));
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long",    "僵尸身上的牙齿，坚固异常，是提炼某种丹药的必须品。\n");
                set("unit", "些");
                set("base_unit", "颗");
                set("base_weight", 1);
                set("value", 10000);
                }
        set_amount(1);
        setup();
}

