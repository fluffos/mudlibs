

inherit COMBINED_ITEM;

void create()
{
        set_name("[1;37m金丹[2;37;0m", ({"jin dan", "dan"}));
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long",    "上古神灵的灵力所化，是提炼某种丹药的必须品。\n");
                set("unit", "些");
                set("base_unit", "颗");
                set("base_weight", 1);
                set("value", 10000);
                }
        set_amount(1);
        setup();
}

