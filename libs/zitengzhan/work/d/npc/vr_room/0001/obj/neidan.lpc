inherit COMBINED_ITEM;

void create() {
  set_name("[1;37m亡灵内丹[2;37;0m", ({ "wangling neidan", "neidan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "亡灵生物的内丹精华，是提炼某种丹药的必须品。\n");
    set("unit", "些");
    set("base_unit", "颗");
    set("base_weight", 1);
    set("value", 10000);
  }
  set_amount(1);
  setup();
}
