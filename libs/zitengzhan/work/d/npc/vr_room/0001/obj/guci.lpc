// tooth.c


inherit COMBINED_ITEM;

void create()
{
        set_name("[1;37m骨刺[2;37;0m", ({"guci"}));
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long",    "遗骸身上的骨刺，似乎兑换使者正需要它。\n");
                set("unit", "些");
                set("base_unit", "根");
                set("base_weight", 1);
                set("value", 1);
                }
        set_amount(1);
        setup();
}

