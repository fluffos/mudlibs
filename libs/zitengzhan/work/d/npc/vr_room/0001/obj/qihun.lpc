// qihun.c

inherit ITEM;
#include <ansi.h>

void create()
{
        set_name(HIY"器魂"NOR, ({ "soul weapon" }) );
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "枚");
                set("long",    "似乎是某样兵器上的魂魄，好像很虚弱的样子，得赶快把它放回(insert soul weapon)主体。\n");
                set("value", 0);
                set("no_sell", 1);
           }
}
int query_autoload() { return 1; }      

