

inherit COMBINED_ITEM;

void create()
{
        set_name("[1;37m混沌元气[2;37;0m", ({"hundun yuanqi", "yuanqi"}));
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long",    "洪荒混沌元气，是提炼某种丹药的必须品。\n");
                set("unit", "些");
                set("base_unit", "份");
                set("base_weight", 1);
                set("value", 10000);
                }
        set_amount(1);
        setup();
}

