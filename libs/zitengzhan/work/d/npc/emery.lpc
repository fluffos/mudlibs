  ([ "name": "黄风怪", "id": "huangfeng guai", "mw": -1, ]),
  ([ "name": "黑风精", "id": "heifeng jing", "mw": 1, ]),
  ([ "name": "豹头怪", "id": "baotou guai", "mw": 1, ]),
  ([ "name": "申公豹", "id": "shengong bao", "mw": 1, ]),
  ([ "name": "风林", "id": "feng lin", "mw": -1, ]),
  ([ "name": "小风惨月精", "id": "canoe jing", "mw": -1, ]),
  ([ "name": "千年狐狸精", "id": "huli jing", "mw": 1, ]),
  ([ "name": "古墓老妖", "id": "gumu yao", "mw": -1, ]),
  ([ "name": "夜叉鬼", "id": "yecha gui", "mw": -1, ]),
  ([ "name": "玉石琵琶精", "id": "pipa jing", "mw": 1, ]),
  ([ "name": "九头雉鸡精", "id": "zhiji jing", "mw": -1, ]),
});

void create() {
  mapping npc;
  npc = data[random(sizeof(data))];
  set_name(npc["name"], ({ npc["id"] }));
  set("title", HIG "魔界妖魔" NOR);
  set("long", "它是天地以外的妖魔，据说来自第三界。\n");
  set("combat_exp", 10000000);
  //set("daoxing", 10000000);
  set("max_force", 4000);
  set("max_mana", 4000);
  set("force", 8000);
  set("mana", 8000);
  set("name_type", "刺杀者");
  set_skill("unarmed", 240);
  set_skill("dodge", 258);
  set_skill("spells", 258);
  set("chat_chance", 20);
  set("chat_msg", ({
    (: random_move :)
  }));
  setup();
  // carry_object("/d/obj/weapon/hammer/falun")->wield();
  carry_object("/d/obj/drug/jinchuang");
  carry_object("/d/obj/drug/jinchuang");
  carry_object("/d/obj/drug/jinchuang");
  carry_object("/d/obj/drug/jinchuang");
  carry_object("/d/obj/drug/jinchuang");
  carry_object("/d/obj/drug/jinchuang");
  carry_object("/d/obj/drug/jinchuang");
  carry_object("/d/obj/drug/jinchuang");
  carry_object("/d/obj/drug/jinchuang");
  carry_object("/d/obj/drug/jinchuang");

}

int accept_kill() {
  object me = this_player();
  object ob = this_object();
  if (me->query_temp("killing_yao") && (string)me->query_temp("killed_id") != (string)ob->query("id")) {
    write(WHT "注意：慢慢来，贪多嚼不烂的！:P\n\n" NOR);
    return 0;
  }
  ob->kill_ob(me);
  if (!ob->query("fighting", 1)) copy_status(ob, me);
  return 1;
}
void init() {
  remove_call_out("check_room");
  call_out("check_room", 2);
}
void check_room() {
  object me = this_object();
  object env = environment(me);

  if (!living(me)) return;
  if (env && (env->query("no_fight") ||
    env->query("no_magic"))) {
    random_move();
  }
  call_out("check_room", 2);
}

void leave() {
  if (environment()) {
    message("vision",
      name() + "说道：啊，天亮了，暂时先回去修炼修炼，下次我会再来的！\n\n"
      +name() + "念了几句咒语,消失在一阵狂风当中。\n", environment(), this_object());
  }
  if (this_object()->query("killer_by"))
    (this_object()->query("killer_by"))->delete_temp("killing_yao");
  if (this_object()->query_temp("last_damage_from"))
    (this_object()->query_temp("last_damage_from"))->delete_temp("killing_yao");
  destruct(this_object());
}

void die() {
  object me, corpse;
  int i, exp, pot, dao;
  me = query_temp("last_damage_from");
  if (!me || !"killer_by") {
    message_vision(HIR "$N一声怪叫,吼道:TNND,暗算老子!闪人先!\n" NOR, this_object());
    destruct(this_object());
    return;
  }
  if (!(me->delete_temp("killer_yao"))) write(HIY "没有清楚杀npc标记，也许有Bug,请说明具体情况.\n" NOR);
  message_vision(HIM "$N惨叫一声,吼道:猴爷，我对不起你!一头栽倒在地!\n" NOR, this_object());
  if (this_object()->query("killer_by")) (this_object()->query("killer_by"))->delete_temp("killing_yao");
  else write(HIY "不知道谁杀的，也许有Bug,请说明具体情况.\n" NOR);
  if (this_object()->query("killer_by") == me) {
    exp = 1000 + random(800);
    pot = 100 + random(250);
    me->add("combat_exp", exp);
    me->add("potential", pot);
    me->add("score", 4);
    log_file(
      "杀妖魔",
      ctime(time()) + " " + me->query("id") + " 杀妖魔 got " + pot + "潜能." + exp + "经验.\n"
    );
    tell_object(
      me,
      sprintf(HIY "恭喜!通过这次勇敢杀敌，你共获得了%s经验，%d点潜能值。\n" NOR, COMBAT_D->chinese_daoxing(exp), pot)
    );
    message(
      "channel:chat",
      HIB "【大唐威望】" + me->query("name") + "成功挫败魔界妖魔的阴谋，门派威望大大提高。\n" NOR,
      users()
    );
  } else {
    tell_object(me, "你误杀了探子,没有得到任何奖励!\n 你该为你的错误负责!\n");
    message("channel:chat", HIB "【大唐威望】" + me->query("name") + "失手杀死魔界探子，江湖一片哗然。\n" NOR, users());
    if ((int)me->query("score") > 10) me->add("score", -10);
    else me->set("score", 0);
  }
  corpse = new("/obj/corpse");
  corpse->set("name", HIY "妖魔的尸体" NOR);
  corpse->set("long", "他是魔界妖魔的得力部下，生前作恶多端.\n然而，他已经死了，剩下一具丑陋的尸体。\n");
  corpse->move(environment(this_object()));
  destruct(this_object());
  return;
}

void copy_status(object ob, object me)

{
  object *inv;
  mapping skill_status, map_status;
  string *sname, *mname;
  string files;
  int i, eff_dx, nk_factor;
  me->set_temp("killing_yao", 1);
  me->set_temp("killed_id", (string)ob->query("id"));
  ob->set("str", me->query("str"));
  ob->set("int", me->query("int"));
  ob->set("con", me->query("con"));
  ob->set("per", me->query("per"));
  ob->set("cor", me->query("cor"));
  ob->set("spi", me->query("spi"));
  ob->set("cps", me->query("cps"));
  ob->set("kar", me->query("kar"));

  ob->set("max_kee", me->query("max_kee"));
  ob->set("eff_kee", me->query("max_kee"));
  ob->set("kee", me->query("kee"));

  ob->set("max_gin", me->query("max_gin"));
  ob->set("eff_gin", me->query("max_gin"));

  ob->set("gin", me->query("gin"));

  ob->set("max_sen", me->query("max_sen"));
  ob->set("eff_sen", me->query("max_sen"));
  ob->set("sen", me->query("sen"));

  ob->set("max_force", me->query("max_force"));
  ob->set("force", me->query("max_force") * 2);
  ob->set("force_factor", me->query("max_force") / 15);
  ob->set("max_mana", me->query("max_mana"));
  ob->set("mana", me->query("max_mana") * 2);
  ob->set("mana_factor", me->query("max_mana") / 15);
  ob->set("daoxing", me->query("daoxing") * 6 / 5);
  ob->set("combat_exp", me->query("combat_exp") * 7 / 5);
  if (skill_status = me->query_skills()) {
    sname = keys(skill_status);
    for (i = 0; i < sizeof(skill_status); i++) {
      ob->set_skill(sname[i], skill_status[sname[i]] + random(50));
    }
  }
  if (map_status = me->query_skill_map()) {
    mname = keys(map_status);
    for (i = 0; i < sizeof(map_status); i++) {
      ob->map_skill(mname[i], map_status[mname[i]]);
    }
  }
  inv = all_inventory(me);
  for (i = 0; i < sizeof(inv); i++) {
    files = inv[i]->query("default_file");
    if (files && inv[i]->query("weapon_prop")) carry_object(files)->wield();
    if (files && inv[i]->query("armor_prop")) carry_object(files)->wear();
  }

  ob->set("stay_time", time() + 600 + random(60));
  ob->set("nk_gain", 100 + random(50));

  eff_dx = me->query("combat_exp");
  if (eff_dx > 1500000)
    nk_factor = 9;
  else if (eff_dx > 1000000)
    nk_factor = 8;
  else if (eff_dx > 600000)
    nk_factor = 7;
  else if (eff_dx > 300000)
    nk_factor = 6;
  else if (eff_dx > 100000)
    nk_factor = 5;
  else if (eff_dx > 50000)
    nk_factor = 4;
  else if (eff_dx > 20000)
    nk_factor = 3;
  else if (eff_dx > 10000)
    nk_factor = 2;
  else nk_factor = 1;
  ob->set("nk_factor", nk_factor);
  ob->set("type", random(3));
  ob->set("fighting", 1);
  ob->set("killer_by", me);
  ob->set("title", HIR "被" + me->name() + "追杀的" NOR);
  reset_eval_cost();
}

void heart_beat() {
  if (!query_temp("weapon") && !query_temp("added")) {
    set_temp("added", 1);
    set("force_factor", 100);
    set("force", 2000);
  }
  if (query("eff_kee") < query("max_kee")) {
    if (random(10))
      command("eat yao");
    else {
      command("surrender");
      call_out("exertheal", 1, this_object());
    }
  }

  ::heart_beat();
}
varargs int receive_damage(string type, int damage, object who) {
  object me = this_object();
  call_out("exertheal", 1, me);
  return ::receive_damage(type, damage, who);
}

void exertheal(object me) {
  me->command("exert recover");
}
//加的
int random_place(object emery, string dirs) {
  int fs, k;
  object newob;
  mixed *file, exit;
  file = get_dir(dirs + "/*.lpc", -1);
  if (!sizeof(file)) return 1;
  for (k = 0; k < 10; k++) {  // try 10 times
    fs = random(sizeof(file));
    if (file[fs][1] > 0) {
      newob = load_object(dirs + "/" + file[fs][0]);
      if (newob) {
        if (newob->query("no_fight") ||
          newob->query("no_magic") ||
          !(exit = newob->query("exits")) ||
          sizeof(exit) < 1)
          continue;
        if (emery->move(newob)) {
          //CHANNEL_D->do_channel(this_object(),"sys","出现在" + newob->query("short")+file[fs][0]+" 。\n");
          //CHANNEL_D->do_channel( this_object(), "rumor",
          //sprintf("选择地点"NOR+YEL"<%s>"HIM"了。"NOR, newob->query("short")));	   
          message_vision("$N耀武扬威地晃了过来。\n", emery);
          return 1;
        }
      }
    }
  }

  return 0;
}
