#include <ansi.h>
inherit ITEM;
void create() {
  set_name("凤凰涅磐", ({ "niepan", "pan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", HIR "一个五色的圆盘。上面刻着金木水火土五种符号NOR);
                set(" base_unit ", " 个 ");
                set(" base_weight ", 0);
                set(" no_sell "," 这 么 珍 贵 的 东 西 这 里 可 不 敢 收 ！ " );
                set(" no_get "," 这 个 东 西 拣 不 起 来 ");
                set(" no_give "," 这 么 珍 贵 的 东 西 给 别 人 不 大 好 吧 "); 
        }
         setup();
}

