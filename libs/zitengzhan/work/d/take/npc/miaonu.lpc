
#include <ansi.h>
inherit NPC;
int go_shuiyue(object me);

void create()
{
       set_name(HIW"阿奴"NOR, ({"a nu"}));
       set("long",HIY"\n\n    一个鬼灵精怪的苗族小丫头，水灵灵的大眼睛里好似深藏着一丝
忘却不了的惆怅．\n"NOR);
       set("gender", "女性");
       set("age", 16);
       set("attitude", "friendly");
       set("shen_type", 1);
       set("per", 40);
        set("combat_exp", 10000000);
	  set("daoxing", 10000000);

		set_skill("dodge", 300);
  set_skill("parry", 300);
  set_skill("unarmed", 300);
  set_skill("force", 300);
  set_skill("spells", 300);
  set_skill("bingxinjue", 300);
  set_skill("yuanlingforce", 300);
  set_skill("linghuan-finger", 300);
  set_skill("lingbo-step", 300);
  set_skill("sword", 300);
  set_skill("staff", 300);
   set_skill("wuyue-sword",300);
   set_skill("shengling-zhang", 300);
  map_skill("force", "yuanlingforce");
  map_skill("spells", "bingxinjue");
  map_skill("parry", "wuyue-sword");
  map_skill("sword", "wuyue-sword");
  map_skill("unarmed", "linghuan-finger");
  map_skill("dodge", "lingbo-step");

  set("max_sen",4000);
  set("max_kee",4000);

  set("force", 4000);
  set("max_force", 4000);
  set("force_factor", 200);
  set("mana", 4000);
  set("max_mana", 4000);
  set("mana_factor", 200);
		        set("inquiry", ([
                "水月宫": (: go_shuiyue :),
				"补天石": "嘻嘻，这个可要问我们巫后娘娘呀。\n",
                "过河": (: go_shuiyue :),
]) );

        setup();
        carry_object("/d/gao/obj/pink_cloth")->wear();

}

void init()
{
        object ob;

        ::init();
        add_action("do_choose", "answer");

		if( interactive(ob = this_player()) && !is_fighting()
        && !ob->query("env/invisibility") ) {
                remove_call_out("greeting");
                call_out("greeting", 2, ob);
        }
}

void greeting(object ob)
{
		if( !ob || !present(ob, environment(this_object())) ) return;
	        message("sound","\n\n阿奴望著悠悠群山,輕輕的唱著~~~~~~~~~~\n\n"NOR, environment());
            remove_call_out("greeting1");
			remove_call_out("greeting2");
			remove_call_out("greeting3");
			remove_call_out("greeting4");
			remove_call_out("greeting");
            call_out("greeting1", 3, ob);
}

void greeting1(object ob)
{
		if( !ob || !present(ob, environment(this_object())) ) return;
	        message("sound",HIY"\n      不識情愁枉少年\n\n"NOR, environment());
            remove_call_out("greeting2");
            call_out("greeting2", 3,ob);
}
void greeting2(object ob)
{
		if( !ob || !present(ob, environment(this_object())) ) return;
	        message("sound",HIR"\n\n\n            蒼下賜酒結仙緣\n\n"NOR, environment());
            remove_call_out("greeting3");
            call_out("greeting3", 3,ob);
}
void greeting4(object ob)
{
		if( !ob || !present(ob, environment(this_object())) ) return;
	        message("sound",HIW"\n\n\n             仗劍江湖為紅顔\n\n"NOR, environment());
          return;
}
void greeting3(object ob)
{
		if( !ob || !present(ob, environment(this_object())) ) return;
	        message("sound",HIC"\n\n\n      情難消受美人恩\n\n"NOR, environment());
            remove_call_out("greeting4");
            call_out("greeting4", 3,ob);
}

int go_shuiyue(object me)
{       me=this_player();
  //      if((string)me->query("family/family_name")=="水月宫") {
      message_vision(WHT"\n阿奴笑盈盈的对$N说:不知道"+RANK_D->query_respect(me) +"你是要到西岸去还是要到东岸去呀?(answer)\n"NOR,me);
//       me->set_temp("shuiyue","choose");
	   return 1;
//	   }
//       message_vision(WHT"\n阿奴笑盈盈的对$N说:这位"+RANK_D->query_respect(me) +"我不认识你呀!\n"NOR,me);
//       return 1;
}

int do_choose(string arg)
{
      int i;
      object* inv;
	  if(!this_player()->query("family/family_name")) 
		  return notify_fail("阿奴摇摇头说道：苗寨水月宫不是凡人能进去的。\n");
      if (!arg)
          return notify_fail("阿奴皱起眉头问:你到底要去那边呀?\n");
	  if (arg!="西岸" && arg!="东岸")
	      return notify_fail("阿奴想想了道:你说的那个地方我没去过呀.\n");
      inv = all_inventory(this_player());
      for(i=0; i<sizeof(inv); i++)
	   {
             if( userp(inv[i])) {
			message_vision(WHT"\n阿奴惊道:水月宫可不能让外人进去呀!\n"NOR,this_player());
			return 1;}
	   }
	  if (this_player()->query_max_encumbrance()/(this_player()->query_max_encumbrance()-this_player()->query_encumbrance())>=5)
	      return notify_fail("阿奴吓得大声道:你太重了,我的小船会沉的!\n");
	  message_vision(WHT"\n阿奴撑起了小船轻轻的哼着苗歌向"+arg+"荡去~~~~~~~~~~~\n"NOR,this_player());
	  this_player()->start_busy(6);
	  call_out("wait_river",5,this_player(),arg);
	  return 1;
}
void wait_river(object me,string arg)
{
      
	  if( !me || !visible(me) || environment(me) != environment() || me->query_temp("pending/exercising")|| me->is_fighting() || me->query_temp("pending/meditating")) return;
      
	  message_vision(WHT"\n阿奴缓缓的撑着小船来到了小溪对岸.\n"NOR,me);
      message_vision(WHT"\n\n\n$N轻轻一越就跳上了对岸.\n"NOR,me);
	  if (arg=="西岸")
	      me->move("/d/shuiyue/miaozhai/miaozhai_29_4");
	  if (arg=="东岸")
		  me->move("/d/shuiyue/miaozhai/miaozhai_30_46");
	  return;

}



