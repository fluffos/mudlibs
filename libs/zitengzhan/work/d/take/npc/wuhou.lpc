//Cracked by Take
#include <ansi.h>

inherit NPC;
inherit F_MASTER;
string expell_me(object me);
int go_stone();

void create()
{
  set_name("巫后娘娘", ({"wu hou","hou"}));
  set("gender", "女性");
  set("age", 30);
  set("title", HIG"水月宫主"NOR);
  set("long","苗族巫后娘娘乃女娲后裔，执掌水月宫数百年，武功已然深不可测。\n"NOR);
  set("combat_exp", 10000000+random(3000));
  set("daoxing", 10000000);
  set("rank_info/respect", "娘娘");
  set("per", 35);
  set_skill("dodge", 200);
  set_skill("parry", 200);
  set_skill("unarmed", 200);
  set_skill("force", 200);
  set_skill("spells", 200);
  set_skill("bingxinjue", 200);
  set_skill("yuanlingforce", 200);
  set_skill("linghuan-finger", 200);
  set_skill("lingbo-step", 200);
  set_skill("sword", 200);
  set_skill("staff", 200);
   set_skill("wuyue-sword",200);
   set_skill("shengling-zhang", 200);
  map_skill("force", "yuanlingforce");
  map_skill("spells", "bingxinjue");
  map_skill("parry", "shengling-zhang");
  map_skill("staff", "shengling-zhang");
  map_skill("unarmed", "linghuan-finger");
  map_skill("dodge", "lingbo-step");

  set("max_sen",8000);
  set("max_kee",5000);

  set("force", 5000);
  set("max_force", 5000);
  set("force_factor", 200);
  set("mana", 8000);
  set("max_mana", 8000);
  set("mana_factor", 250);

        set("inquiry", ([
           //     "离宫": (: expell_me :),
           //     "leave": (: expell_me :),
]) );

    create_family("水月宫", 1, "蓝");
	set("inquiry", ([
                "水月宫": "这里就是水月宫，有什么事吗？",
				"补天石": (: go_stone :),
]) );

  setup();

        carry_object("/d/gao/obj/pink_cloth")->wear();
}

void attempt_apprentice(object ob)
{       ob=this_player();

        if( (string)ob->query("family/family_name") != "水月宫") {
		command("say  我不收门外弟子，这水月宫乃我族圣地岂容你胡闹，你还是快快离去吧。\n");
		return;
	}
          if( ob->query_skill("spells") < 100)  {
		command("say  "+ RANK_D->query_respect(ob) +"还是先打好法术基础再来吧.\n");
		return;
	}
	if( ob->query("daoxing") < 200000)  {
		command("say  "+ RANK_D->query_respect(ob) +"的修为太浅，不要操之过急。\n");
		return;
	}
    if( ob->query("combat_exp") < 200000)  {
		command("say  "+ RANK_D->query_respect(ob) +"的战斗经验不足，不要操之过急。\n");
		return;
	}
	command("nod " + ob->query("id"));
    command("say 好徒儿，希望你学好武功为天下黎民解难，不枉女娲娘娘天佑我苗族百姓永世太平。\n");
	command("recruit " + ob->query("id"));
    return ;
}

int recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) ) {
                ob->set("class", "xian");
        }
}

int go_stone()
{
	object me,ob,fenghuang;
	me=this_object();
	ob=this_player();
	if (ob->query("fangcun/panlong_moon")!="begin")
		return 0;

	if (ob->query_temp("get_stone"))
	{
		command("say 见到金色凤凰了吗？\n");
		return 1;
	}
	message_vision(WHT"\n巫后娘娘凝神看着$N说:看样子"+RANK_D->query_respect(ob) +"是受女娲娘娘之托来取"+HIY"补天石"NOR+WHT"的，这"+HIY"补天石"NOR+WHT"乃上古神器，现在
                     就在水月宫禁地悬崖顶上，不过此石千万年来一直由苗族圣兽"+HIY"金色凤凰"NOR+WHT"守护
                     着，我族人都不得进入禁地，如果"+RANK_D->query_respect(ob) +"要取得"+HIY"补天石"NOR+WHT"只需击败守护神兽就
                     能拿到了。\n\n"NOR,ob);
	ob->set_temp("get_stone",1);
	fenghuang=new("/d/take/npc/fenghuang");
	fenghuang->set_temp("killer",ob);
	fenghuang->move("/d/shuiyue/xianlingdao/xianlingdao_0_6");
	return 1;
}

