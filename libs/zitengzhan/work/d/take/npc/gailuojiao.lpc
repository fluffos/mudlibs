//Cracked by Take
#include <ansi.h>

inherit NPC;
inherit F_MASTER;
int accept_object(object me, object ob);
int go_shuiyue(object me);
int go_test(object me);

void create() {
  set_name("盖罗娇", ({ "gai luojiao", "gai" }));
  set("gender", "女性");
  set("age", 30);
  set("title", HIW "白苗族大将军" NOR);
  set("long", HIC "白苗族女将军，在与黑苗族战斗中屡建战功，得巫后传授一身武功.\n" NOR);
  set("combat_exp", 5000000 + random(30000));
  set("daoxing", 5000000);
  set("rank_info/respect", "女将军");
  set("per", 28);
  set_skill("dodge", 120);
  set_skill("unarmed", 130);
  set_skill("linghuan-finger", 150);
  set_skill("parry", 130);
  set_skill("force", 120);
  set_skill("spells", 80);
  set_skill("bingxinjue", 100);
  set_skill("yuanlingforce", 120);
  set_skill("lingbo-step", 120);
  set_skill("staff", 130);
  set_skill("shengling-zhang", 130);
  map_skill("force", "yuanlingforce");
  map_skill("spells", "bingxinjue");
  map_skill("parry", "shengling-zhang");
  map_skill("staff", "shengling-zhang");
  map_skill("dodge", "lingbo-step");
  map_skill("unarmed", "linghuan-finger");


  set("max_sen", 1200);
  set("max_kee", 2500);

  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 200);
  set("mana", 1200);
  set("max_mana", 1200);
  set("mana_factor", 100);

  set("inquiry", ([
    "过路": (: go_shuiyue :),
    "补天石": "哦，这个可要问我们巫后娘娘。\n",
    "go": (: go_shuiyue :),
    "考验": (: go_test :),

  ]));

  create_family("水月宫", 2, "蓝");

  setup();

  carry_object("/d/qujing/kusong/obj/tongjia")->wear();
}

int accept_object(object me, object ob) {
  if ((string)me->query("family/family_name") != "水月宫")
    return 0;
  if (me->query("shuiyue/go"))
    return 0;
  if (ob->query("id") != "duwu") {
    command("say " + RANK_D->query_respect(me) + "这是什么？");
    call_out("destroy", 1, ob);
    return 1;
  }
  if (ob->query("name") == "五彩蜘蛛")
    me->set_temp("shuiyue/test_zhizhu", 1);
  if (ob->query("name") == "百足蜈蚣")
    me->set_temp("shuiyue/test_wugong", 1);
  if (ob->query("name") == "朱睛冰蟾")
    me->set_temp("shuiyue/test_hama", 1);
  if (ob->query("name") == "赤练小蛇")
    me->set_temp("shuiyue/test_she", 1);
  if (ob->query("name") == "双尾蝎")
    me->set_temp("shuiyue/test_xiezi", 1);
  command("nod " + me->query("id"));
  command("say " + RANK_D->query_respect(me) + "真是辛苦了！");
  call_out("destroy", 1, ob);
  return 1;
}

void attempt_apprentice(object ob) {
  ob = this_player();

  if ((string)ob->query("family/family_name") != "水月宫") {
    command("say  " + RANK_D->query_rude(ob) + "敢来白苗族闹事？\n");
    return;
  }
  if (ob->query_skill("unarmed") < 50) {
    command("say  " + RANK_D->query_respect(ob) + "还是先打好拳脚基础再来吧.\n");
    return;
  }
  if (ob->query_skill("staff") < 50) {
    command("say  " + RANK_D->query_respect(ob) + "基本杖法经验不足，还是过一阵子再来吧。\n");
    return;
  }
  if (ob->query("daoxing") < 100000) {
    command("say  " + RANK_D->query_respect(ob) + "的修为太浅，不要操之过急。\n");
    return;
  }
  if (ob->query("family/generation") < 3) {
    command("say  " + RANK_D->query_respect(ob) + "武功已非比从前，我没什么能教你的了.\n");
    return;
  }
  if ((string)ob->query("family/shuiyue_master") == "laolao") {
    command("say  " + RANK_D->query_respect(ob) + "法术已得月姥姥的指点,我这里一点花拳绣腿没什么好学的.\n");
    return;
  }


  command("haha " + ob->query("id"));
  command("say 只要你努力学，我一定会把水月宫武功精华传授给你的。\n");
  command("recruit " + ob->query("id"));
  ob->set("family/shuiyue_master", "gailuojiao");
  return;
}
int recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob)) {
    ob->set("class", "xian");
  }
}


int go_shuiyue(object me) {
  me = this_player();

  if ((string)me->query("family/family_name") != "水月宫") {
    message_vision(WHT "\n盖罗娇冷冷的对$N说:里面是巫后娘娘居住的圣地水月宫，你非我门人进去干什么？\n" NOR, me);
    return 1;
  }
  if (me->query("shuiyue/go")) {
    message_vision(WHT "\n盖罗娇点点头对$N道:请便。\n" NOR, me);
    return 1;
  }
  message_vision(
    WHT "\n盖罗娇略一思索对$N说:这位" + RANK_D->query_respect(me) + "你想要见巫后娘娘要先经过" + HIY "考验" NOR + WHT "!\n" NOR,
    me
  );
  return 1;
}

int go_test(object me) {
  me = this_player();
  if ((string)me->query("family/family_name") != "水月宫")
    return 0;
  if (sizeof(me->query_temp("shuiyue")) == 5) {
    me->set("shuiyue/go", 1);
    message_vision(WHT "\n盖罗娇点点头对$N道:你已经通过考验了，去吧。\n" NOR, me);
    return 1;
  }
  message_vision(
    WHT "\n盖罗娇对$N道:这个考验其实很简单，如果" + RANK_D->query_respect(me) + "能去大雪山捉齐" + HIY "五彩蜘蛛 百足蜈蚣 朱睛冰蟾 赤练小蛇 双尾蝎" NOR + WHT "这五种毒物给我，你就通过考验了。\n" NOR,
    me
  );
  return 1;
}

void destroy(object ob) {
  destruct(ob);
}
