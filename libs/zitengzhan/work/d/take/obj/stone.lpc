// by take

#include <ansi.h>

inherit ITEM;

void create()
{
  set_name( RED"补天石"NOR, ({"stone"}));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("long", "这是一块上古神石，女娲一心求得补天之漏洞，以救天下苍生。\n");
    set("value", 1);
    set("no_sell", 1);
    set("no_put", 1);
  }
  setup();
}
