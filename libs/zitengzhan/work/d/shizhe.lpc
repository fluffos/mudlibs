  command("whisper " + ob->query("id") + " " HIW "欢迎光临〖仙侣情缘·花卉站〗" + HIR + "(ask npc about newbie) " + NOR + HIW + "， 小的助您行走江湖．" NOR);
  command("xlqy " + HIC "〖仙侣情缘·大唐站〗，欢迎新老玩家光临。IP: www.flowerworld.com.cn Port: 6666 \n" NOR);
}

int give_bonnet() {
  object bonnet;
  string oname;
  object who = this_player();
  if (!userp(who)) {
    command("heng");
    command("say 什么小猫小狗也来要东西？！");
    command("qi");
    return 1;
  }
  if (who->query_temp("ask_bonnet") > time()) {
    message_vision("$N眼睛撇向一旁，'你不是刚刚要过吗？？'\n", this_object(), this_player());
    return 1;
  }
  bonnet = new("/d/lingtai/obj/faguan");
  oname = bonnet->query("name", 1);
  bonnet->move(who);
  message_vision(
    "$N念动咒语：哈库那玛他他!只见漫天雪飞，$N变出一顶" + oname + "。\n$N给$n一顶" + oname + "\n",
    this_object(),
    this_player()
  );
  who->set_temp("ask_bonnet", time() + 600);
  return 1;
}
string ask_me() {
  object me = this_player();
  object ob;
  mapping fam;

  if ((int)me->query("welcomexh"))
    return "呵呵～这就是您的不是了！小的已经对您施过法力了！";
  else {
    me->set("maximum_force", 10000);
    me->set("maximum_mana", 10000);
    me->set("force", 10000);
    me->set("max_kee", 10000);
    me->set("max_sen", 10000);
    me->set("eff_kee", 10000);
    me->set("eff_sen", 10000);
    me->set("see", 10000);
    me->set("kee", 10000);
    me->set("max_force", 10000);
    me->set("max_mana", 10000);
    me->set("mana", 10000);
    me->set("potential", 500000);
    me->set("daoxing", 50000000);
    me->set("faith", 1000);
    me->add("balance", 10000000);
    me->add("mudage", 3600000);
    //    me->add("water", 10000);
    me->set("combat_exp", 50000000);
    //下面就是给钱。其实除了move以外，还可以add存款。就是add banlance.
    //目前是1 gold.你自己选奖励是什么。

    CHANNEL_D->do_channel(
      me,
      "xlqy",
      sprintf(
        "在下%s今日光临〖仙侣情缘·花卉站〗（IP:www.flowerworld.com.cn Port: 6666）\n         现已得到新手指导的帮助和奖励！即日起开始行走江湖了！",
        me->name(1)
      )
    ); return "欢迎光临" NOR + HIR "〖仙侣情缘·花卉站〗" NOR "，小的护架来迟，罪该万死！在下可助您行走江湖！\n"
      HIW "突然天空中一道" HIM "七" HIY "彩" HIR "霞" HIC "光" HIW "笼罩四方，转瞬即逝！" NOR;
  }
}
int family_present() {
  object me = this_player();
  if (!me->query("family")) {
    command("say 你还没有拜师呢！");
    command("hehe");
    return 1;
  }
