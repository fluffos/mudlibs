void init()
{
add_action("do_quit", "quit");
add_action("do_drop", "drop");
}
int do_quit(){
  return 1;
}
int do_drop(string arg)
{
       object me= this_player();
       message_vision("柏鉴对$N说道："+me->query("name")+
       "，你也太调皮了，我早就告诉过你不要乱扔东西，乱扔东西会污染环境的，砸到小朋友怎么办？就算砸不到小朋友砸到花花草草也不好嘛！\n",me);
        return 1;
}
