void init() {
  add_action("do_swim", "swim");
}

int do_swim() {
  object me = this_player();
  //    if (!me->query("wuxingnew")) return notify_fail("先清了以前的数据再去吧。\n");
  message_vision(HIY "$N纵身一跃，跳入湖中。只见$N使足了全身力气，手足并用，向着湖对岸有了过去。\n" NOR, me);
  me->move("/d/wuxing/entrance");
  if (!me->query_temp("wuxingyao/swim")) {
    //  me->unconcious();
    message_vision(HIY "只见$N被湖水冲上了岸来。\n" NOR, me);
  } else
    message_vision(HIY "只见$N浑身湿漉漉地从水里爬了上来。\n" NOR, me);
  return 1;
}
