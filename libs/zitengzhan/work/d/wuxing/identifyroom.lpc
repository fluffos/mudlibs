//Cracked by Roath
inherit ROOM;

mapping itemlist = ([
  1: "axe",
  2: "blade",
  3: "fork",
  4: "hammer",
  5: "mace",
  6: "stick",
  7: "sword",
  8: "spear",
  9: "staff",
  10: "whip",
  11: "armor",
  12: "cloth",
  13: "finger",
  14: "hands",
  15: "pifeng",
  16: "kui",
  17: "shoes",
  18: "dun",
  19: "wrists",
  20: "waist"
]);
void create() {
  set("short", "欧冶池");

  set("long", @LONG

冶剑于山，淬剑于池。这里是欧冶子淬剑的地方。
LONG);

  set("exits",
    ([  //sizeof() == 4
    "south": __DIR__ "centre",
    ]));

  set("objects",
    ([  //sizeof() == 1
    "/d/wuxing/npc/ouyezi.lpc": 1,
    ]));



  setup();
}

void init() {
  add_action("do_list", "list");
  add_action("do_yao", "getback");
}

int do_list() {
  string ch, str = "";
  int i, k = 1;
  object me = this_player();
  for (i = 1; i <= 20; i++) {
    ch = "wuxing_fabao/" + itemlist[i];
    if (!me->query(ch)) continue;
    if (me->query_temp(ch)) continue;
    // 表示已经拿过了
    ch = itemlist[i];
    str += sprintf("%d     %s\n", k, ch);
    k++;
  }
  if (k == 1) return notify_fail("你没有在欧冶池存放装备。\n");
  str = "你现在共有" + chinese_number(k - 1) + "件装备存放在欧冶池：\n" + str;
  tell_object(me, str);
  return 1;
}

int do_yao(string arg) {
  string ch, item;
  int i;
  object me = this_player(), newob;
  if (!arg) return notify_fail("你要什么？\n");
  if (arg == "all") {
    for (i = 1; i <= 20; i++) {
      ch = "wuxing_fabao/" + itemlist[i];
      if (!me->query(ch)) continue;
      if (me->query_temp(ch)) continue;
      ch = "/d/wuxing/obj/" + itemlist[i];
      newob = new(ch);
      if (newob) {
        newob->set("owner_id", me->query("id"));
        newob->set_temp("befabao", 1);
        if (!newob->restore()) {
          tell_object(this_object(), "不能 restore fabao. \n");
          destruct(newob);
          continue;
        }
        newob->move(me);
        ch = "wuxing_fabao/" + itemlist[i];
        me->set_temp(ch, 1);
      }
    }
    return notify_fail("你取回来了所有存放在欧冶池的装备。\n");
  }
  ch = "wuxing_fabao/" + arg;
  if (!me->query(ch)) return notify_fail("你没有铸过这种类型的装备。\n");
  if (me->query_temp(ch)) return notify_fail("你已经拿走了。\n");
  ch = "/d/wuxing/obj/" + arg;
  newob = new(ch);
  if (newob) {
    newob->set("owner_id", me->query("id"));
    newob->set_temp("befabao", 1);
    if (!newob->restore()) {
      tell_object(this_object(), "不能 restore fabao. \n");
      destruct(newob);
      return 1;
    }
    ch = "wuxing_fabao/" + arg;
    me->set_temp(ch, 1);
    newob->move(me);
    tell_object(me, "你取回来了" + newob->query("name") + "。\n");
  }
  return 1;
}
