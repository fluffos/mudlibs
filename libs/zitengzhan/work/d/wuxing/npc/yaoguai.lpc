void setname1() {
  int i, j, k;
  string name, *id;

  i = (random(sizeof(names1) / 2)) * 2;
  j = (random(sizeof(names2) / 2)) * 2;
  k = (random(sizeof(names3) / 2)) * 2;

  name = names1[i] + names2[j] + names3[k];
  id = ({ names1[i + 1] + names2[j + 1] + " " +
    names3[k + 1], names3[k + 1] });

  set_name(name, id);

  set("race", "野兽");
  if (random(2) > 0) {
    set("gender", "雄性");
  } else {
    set("gender", "雌性");
  }
  yaoguai_type = 1;
}

void setname2() {
  int i, j;
  string name, *id;
  i = (random(sizeof(names4) / 2)) * 2;
  j = random(2);

  name = names4[i] + (j ? "精" : "怪");
  id = ({ names4[i + 1] + " " + (j ? "jing" : "guai"),
    (j ? "jing" : "guai") });

  set("race", "野兽");
  set("gender", (j ? "雌性" : "雄性"));
  set_name(name, id);
  yaoguai_type = 2;
}

