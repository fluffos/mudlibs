// here should be this NPC specific skills.
void set_skills(int j, int level) {
  object me = this_object();
  object weapon;

  me->set_skill("unarmed", j);
  me->set_skill("dodge", j);
  me->set_skill("parry", j);
  me->set_skill("force", j);
  me->set_skill("spells", j);

  me->set_skill("staff", j + random(15));
  me->set_skill("lunhui-zhang", j + random(15));
  me->set_skill("lotusmove", j + random(15));
  me->set_skill("buddhism", j + random(15));
  me->set_skill("jienan-zhi", j + random(15));
  me->set_skill("lotusforce", j + random(15));
  me->map_skill("force", "lotusforce");
  me->map_skill("staff", "lunhui-zhang");
  me->map_skill("parry", "lunhui-zhang");
  me->map_skill("spells", "buddhism");
  me->map_skill("dodge", "lotusmove");
  me->map_skill("unarmed", "jienan-zhi");

  //	set("chat_chance_combat", 10+2*level);
  set("chat_msg_combat", ({
    (: cast_spell, "bighammer" :),
  }));

  weapon = new("/d/obj/weapon/staff/budd_staff");
  weapon->move(me);
  carry_object("/d/obj/cloth/shoupiqun")->wear();
  command("wield all");
}

void copy_status(object me, object ob, int lv) {
  int j, lvl, k, m, kangxing, shuxing;
  string yg_type;
  object weapon, qm = new("/d/changan/npc/qianmian.lpc");
  int base = 20;

  lvl = 25;
  if (query("wuxing/level") > 89) lvl = 24 + (query("wuxing/level") - 89) * 2;
  if (lvl > 40) lvl = 40;

  if (qm) {
    mapping skill = ob->query_skills();
    int i = sizeof(skill);
    int *level, max_level;
    int max_sen, max_kee;

    if (i > 0) {
      level = values(skill);
      max_level = level[0];
      while (i--) {  // find out victim's maximum level
        if (level[i] > max_level)
          max_level = level[i];
      }
      max_level = max_level * lvl / base;

    } else max_level = 1;

    qm->copy_status(this_object(), ob, lvl);
    destruct(qm);

    k = (query("daoxing") + query("combat_exp")) / 2;
    for (m = 1; m < 300; m = m + 10) {
      if (m * m * m / 10 > k) break;
    }
    m = m * lvl / base / 3;
    if (max_level < m) max_level = m;

    // skill level will be set to the maximum level
    // of the player.
    set_skills(max_level, lv);

    max_sen = query("max_sen") * 2;
    max_kee = query("max_kee") * 2;
    add("eff_sen", max_sen);
    add("eff_kee", max_kee);
    add("sen", max_sen);
    add("kee", max_kee);
    add("max_sen", max_sen);
    add("max_kee", max_kee);

  } else {  // sth goes wrong.
    leave();
    return;
  }

  //          add("force",query("force"));
  set("max_force", ob->query("maximum_force") * lvl / 20);
  set("max_mana", ob->query("maximum_mana") * lvl / 20);
  set("force", query("force") * 2);
  set("mana", query("mana") * 2);
  set("force_factor", query_skill("force") / 2);
  set("mana_factor", query("max_mana") / 20 + 1);

  // 五行属性和抗性
  yg_type = query("wuxingtype");
  if (lv > 46) {
    kangxing = 50;
    shuxing = 100 + query("wuxing/level") * 4;
  } else if (lv > 36) {
    kangxing = 40;
    shuxing = 100 + query("wuxing/level") * 3;
  } else if (lv > 19) {
    kangxing = 30;
    shuxing = 75 + query("wuxing/level") * 3;
  } else if (lv > 9) {
    kangxing = 20;
    shuxing = 75 + query("wuxing/level") * 2;
  } else {
    kangxing = 10;
    shuxing = 50 + query("wuxing/level") * 2;
  }
  if ((shuxing) > 600) shuxing = 600;  //max 6 times of weapon damage
  set_temp("apply/jin_type", shuxing);
  set_temp("apply/mu_type", shuxing);
  set_temp("apply/shui_type", shuxing);
  set_temp("apply/huo_type", shuxing);
  set_temp("apply/tu_type", shuxing);
  yg_type = "apply/" + yg_type + "_type";
  set_temp("apply/all_ris", kangxing);
  set_temp(yg_type, shuxing);

  //兵器的damage
  weapon = query_temp("weapon");
  if (!weapon) return;
  if (lv > 46) {
    weapon->set("weapon_prop/damage", 100 + query("wuxing/level"));
  } else if (lv > 36) {
    weapon->set("weapon_prop/damage", 80 + query("wuxing/level"));
  } else if (lv > 19) {
    add_temp("apply/damage", query("wuxing/level"));
    add_temp("apply/parry", query("wuxing/level"));
    add_temp("apply/dodge", query("wuxing/level"));
    add_temp("apply/armor_vs_force", query("wuxing/level") * (20 + random(20)));
    add_temp("apply/armor_vs_spells", query("wuxing/level") * (20 + random(20)));
    weapon->set("weapon_prop/damage", 60 + query("wuxing/level"));
  } else if (lv > 9) {
    weapon->set("weapon_prop/damage", 50 + query("wuxing/level"));
  } else {
    weapon->set("weapon_prop/damage", 50);
  }

}

int random_place(object me) {
  int x, y, z;
  string j;
  object newob;
  x = random(5);
  y = random(5);
  z = random(4) + 1;
  j = sprintf("/d/wuxing/wanjiegu%d/0/%d/%d", z, x, y);
  newob = find_object(j);
  if (!newob) {
    newob = load_object("/d/wuxing/mgchukou");
    z = 10;
  }
  if (newob) {
    if (me->move(newob)) {
      message_vision("$N走了过来。\n", me);
      return z;
    }
  }
  return -1;
}

void _leave() {
  object me = this_object();

  // if in fighting, then don't disappear.
  if (me->is_fighting() || me->is_busy())
    return;
  leave();
}

void leave() {
  if (this_object()) {
    if (environment())
      message("vision", HIB + name() +
        "修炼结束，站起身来，大叫一声：走！身形一晃，无影无踪。\n" NOR, environment());
    this_object()->move("/obj/empty");
    call_out("leave2", 5);
  }
  return;
}

void leave2() {
  if (this_object()) {
    destruct(this_object());
  }
}

string invocation(object who, int level) {
  object me = this_object();

  copy_status(me, who, level - 2);

  return _invocation(who, level);
}

string _invocation(object who, int level) {
  object me = this_object(), env;
  string place;
  int i, lvl, x, y;
  float k;
  string where, long;

  set("owner", who->query("id"));
  set("owner_ob", who);
  //        long="一个在妖谷修炼的妖，在修炼中领悟到了"+wuxingtochinese[query("wuxingtype")]+"的真谛。\n";
  long = "一个在万劫谷修炼的妖，在修炼中领悟到了五行的真谛。\n";
  set("long", long);
  set("title", who->query("name") + "的五行妖");
  //        set("title",who->query("name")+"的"+wuxingtochinese[query("wuxingtype")]+"系妖怪");

  lvl = query("wuxing/level");

  set("env/wimpy", 0);

  // determine reward
  if (level > 46) pot_reward = 500 + lvl * (76 + random(25));
  else if (level > 36) pot_reward = 300 + lvl * (68 + random(15));
  //            else if (level>19) pot_reward=1000+lvl*(107+random(5));
  //            奖励提高     yog
  else if (level > 19) pot_reward = 2000 + lvl * (350 + random(100));
  else if (level > 9) pot_reward = 200 + lvl * (33 + random(5));
  else pot_reward = 150 + lvl * (18 + random(5));
  i = who->query("wuxing/level") - lvl;
  i = (int)(i - i % 5) / 5 + 1;
  if (i > 5) k = 0;
  else k = 1.0 / (float)i;
  pot_r = (int)pot_reward * k;

  me->set("stay_time", time());
  i = random_place(me);
  if (i == -1) {
    leave();
    return 0;
  }

  env = environment(me);
  where = me->query("name") + "(" + me->query("id") + ")";
  if (env) {
    /*               y=i%10;
              x=(int) (i-y)/10;
              if (x<3) {
                  if (y<3) place="西北方";
                  else if (y<7) place="北方";
                  else place="东北方";
              } else if (x<7) {
                  if (y<3) place="西方";
                  else if (y<7) place="中部";
                  else place="东方";
              } else {
                  if (y<3) place="西南方";
                  else if (y<7) place="南方";
                  else place="东南方";
              } */
    if (i != 10) place = sprintf("在万劫谷的第%d层", i);
    else place = sprintf("在万劫谷出口附近");
  }
  where += place;
  return where;
}

void init() {
  object me = this_object();
  object who = this_player();
  string type;
  int t = query("stay_time");

  ::init();

  // if overtime too long, then destroy. 
  if (t && time() > (t + 3600)) {
    remove_call_out("leave");
    call_out("leave", 1);
    return;
  }

}

void unconcious() {
  if (query("kee") < 0 || query("sen") < 0) die();
  else ::unconcious();
}

void die() {
  string owner;
  string skill;
  object newitem, owner_ob;
  object me = this_object();
  string str;
  string msg;
  int max_kee, max_sen, ratio;
  owner = query("owner");

  if (stringp(owner) && objectp(owner_ob = find_player(owner))) {
    if (environment(owner_ob) == environment() && living(owner_ob)) {
      message_vision(death_msg[random(sizeof(death_msg))],
        owner_ob, this_object());

      max_kee = query("max_kee");
      max_sen = query("max_sen");
      ratio = 100 * (max_kee - other_kee) / max_kee;
      if (ratio < 0) ratio = 0;
      ratio = ratio * (max_sen - other_sen) / max_sen;
      if (ratio < 0) ratio = 0;

    } else {
      message_vision("$N死了。\n", this_object());
      pot_r = 0;
    }

    if (query_temp("last_damage_from") != owner_ob) pot_r = 0;
    if (query_temp("last_damage_from") != owner_ob && (int)owner_ob->query_temp("wuxingyao/level") == 49)
      owner_ob->set_temp("wuxingyao/level", 48);
    str = " got " + pot_r + "/" + pot_reward + " newexp in level " + owner_ob->query_temp("wuxingyao/level") + ".\n";
    /*	             if(skill != "none"){
			msg="听说"+ owner_ob->query("name")+ "的"+ to_chinese(skill)+ "又有所进境了！\n";
     			CHANNEL_D->do_channel(me,"rumor",msg);
    			}
*/


    MONITOR_D->report_system_object_msg(owner_ob, str);

    tell_object(owner_ob, HIM "你得到了" + chinese_number(pot_r)
      + "点经验值！\n" NOR);
    owner_ob->add("wuxing/exp", pot_r);
    // 判断是否应该升级
    {
      int i, k;
      if (!owner_ob->query("wuxing/last_exp")) i = 0;
      else i = owner_ob->query("wuxing/last_exp");
      k = owner_ob->query("wuxing/level");
      if (owner_ob->query("wuxing/exp") - i >= 10000 + 500 * k * k) {
        tell_object(owner_ob, HIY "恭喜，你的级别提升了！\n" NOR);
        owner_ob->add("wuxing/level", 1);
        owner_ob->add("wuxingyao/kill_level", 1);
        owner_ob->add("wuxing/last_exp", 10000 + 500 * k * k);
      }
    }
    owner_ob->add("newexp", pot_r);


    owner_ob->set("wuxingyao/done", 1);
    // drop item
    if (random(10) < 8 && query_temp("last_damage_from") == owner_ob) {  //80% chance to drop
      ratio = random(sizeof(itemlist));
      newitem = new(itemlist[ratio]);
      newitem->set("no_identify", 1);
      newitem->disappear();
      newitem->move(owner_ob);
      newitem->first(owner_ob);
      newitem->set("newitem", 1);
      // 判断是否带孔
      // yog
      {
        int number;
        number = random(4);
        if (number) {
          newitem->set("socketed", 1);
          newitem->set("socketed_num", number);
        }
      }
      message_vision("天上掉下来了一些东西，砸到了$N的头上。\n", owner_ob);
    }

  } else {
    message_vision("$N死了。\n", this_object());
  }

  destruct(this_object());

}

varargs int receive_wound(string type, int damage, object who) {
  string owner = query("owner");
  object inv;

  if (who && who->query("id") != owner) {
    if (userp(who) || ((inv = who->query_temp("invoker")) &&
      inv->query("id") != owner)) {
      // can't use other's NPC to help kill.
      if (damage > 0) {
        switch (type) {
          case "kee": other_kee += damage; break;
          case "sen": other_sen += damage; break;
        }
      }
    }
  }
  return ::receive_wound(type, damage, who);
}

varargs int receive_damage(string type, int damage, object who) {
  string owner = query("owner");
  object inv;

  if (who && who->query("id") != owner) {
    if (userp(who) || ((inv = who->query_temp("invoker")) &&
      inv->query("id") != owner)) {
      // can't use other's NPC to help kill.
      if (damage > 0) {
        switch (type) {
          case "kee": other_kee += damage; break;
          case "sen": other_sen += damage; break;
        }
      }
    }
  }
  return ::receive_damage(type, damage, who);
}

// This is called in heart_beat() to perform attack action.
int attack() {
  object opponent;

  clean_up_enemy();

  opponent = select_opponent();
  if (objectp(opponent)) {
    string owner = query("owner");

    // if the owner faints, then will not attack
    // and leave. -- mon 3/8/99
    if (opponent->query("id") == owner
      && userp(opponent)
      && !living(opponent)
      && environment() == environment(opponent)) {
      if (opponent->query_temp("wuxingyao/level") != 0) opponent->add_temp("wuxingyao/level", -1);
      opponent->set("wuxingyao/done", 1);
      call_out("leave", 1);
      return 0;
    } else {
      set_temp("last_opponent", opponent);
      COMBAT_D->fight(this_object(), opponent);
    }
    if (opponent->query("id") == owner && userp(opponent) && environment() == environment(opponent))
      //              heart_ghost(opponent);
      return 1;
  } else
    return 0;
}

void heart_beat() {
  object me = this_object();
  object opponent;
  if (!is_busy()) chat();
  if (query("eff_kee") < query("max_kee")) {
    if (random(10)) {
      command("eat yao");
    } else {
      command("surrender");
      set_temp("forcefactor", query("force_factor"));
      command("exert heal");
      set("force_factor", query_temp("forcefactor"));
    }
  }
  if (query("kee") < query("eff_kee") - 2000)
    command("exert recover");
  if (query("eff_sen") < query("max_sen")) command("eat dan");
  if (query("sen") < query("eff_sen") - 200)
    command("exert refresh");
  /*      if (random(20-(int) (query_temp("apply/all_ris")/10))==0)
     {
        message_vision(HIW"$N嘿嘿的奸笑了一声。\n"NOR,this_object());
        set("wuxingtype",wuxingname[random(5)]); 
      } */
  if (is_fighting()) {
    opponent = select_opponent();
    if (opponent->query("id") == me->query("owner")) heart_ghost(opponent);
  }
  ::heart_beat();
}
void heart_ghost(object opponent) {
  int heart;
  object ob;
  heart = opponent->query_temp("heart_lost");
  if (heart > 600) {
    opponent->set_temp("heart_lost", 0);
    switch (opponent->query("family/family_name")) {
      case "南海普陀山":
        ob = new("/d/wuxing/xm_npc/yg-putuo");
        break;
      case "五庄观":
        ob = new("/d/wuxing/xm_npc/yg-wzg");
        break;
      case "大雪山":
        ob = new("/d/wuxing/xm_npc/yg-xueshan");
        break;
      case "阎罗地府":
        ob = new("/d/wuxing/xm_npc/yg-hell");
        break;
      case "东海龙宫":
        ob = new("/d/wuxing/xm_npc/yg-dragon");
        break;
      case "陷空山无底洞":
        ob = new("/d/wuxing/xm_npc/yg-wudidong");
        break;
      case "蜀山剑派":
        ob = new("/d/wuxing/xm_npc/yg-shushan");
        break;
      case "盘丝洞":
        ob = new("/d/wuxing/xm_npc/yg-pansi");
        break;
      case "方寸山三星洞":
        ob = new("/d/wuxing/xm_npc/yg-fangcun");
        break;
      case "火云洞":
        ob = new("/d/wuxing/xm_npc/yg-hyd");
        break;
      case "将军府":
        ob = new("/d/wuxing/xm_npc/yg-jjf");
        break;
      case "月宫":
        ob = new("/d/wuxing/xm_npc/yg-moon");
        break;
    }
    ob->copy_status(ob, opponent);
    message("system", HIY "【神灵精怪】 " HIR + opponent->query("name") + "的心魔出现了！\n" NOR, users());
    return;
  }
  opponent->add_temp("heart_lost", 1);
}
