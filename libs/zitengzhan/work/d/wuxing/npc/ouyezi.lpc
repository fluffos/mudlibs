inherit NPC;


void create() {
  seteuid(getuid());
  set_name("欧冶子", ({ "ouye zi" }));
  set("long", "他就是铸出有“天下第一剑”之誉的湛卢宝剑得著名铸剑师。\n");

  set("gender", "男性");
  set("class", "xian");
  set("age", 37);
  set("con", 30);
  set("per", 30);
  set("str", 25);
  set("int", 35);
  set("combat_exp", 50000000);
  set("daoxing", 50000000);
  set("attitude", "heroism");


  set_skill("dodge", 800);
  set_skill("force", 800);
  set_skill("parry", 800);
  set_skill("unarmed", 800);
  set_skill("spells", 800);
  set_skill("No.1_skill", 800);
  set_skill("sword", 800);
  set_skill("literate", 800);
  map_skill("sword", "No.1_skill");
  map_skill("parry", "No.1_skill");
  map_skill("force", "No.1_skill");
  map_skill("spells", "No.1_skill");
  map_skill("unarmed", "No.1_skill");
  map_skill("dodge", "No.1_skill");
  set("max_force", 20000);
  set("force", 40000);
  set("max_mana", 20000);
  set("mana", 40000);
  set("mana_factor", 300);
  set("force_factor", 300);
  set("max_kee", 70000);
  set("max_gin", 40000);
  set("max_sen", 50000);

  set("inquiry", ([
    "装备": "自己去冶山找去！（zhu）（hui）",
  ]));
  setup();
  carry_object("/obj/cloth")->wear();
  carry_object("/d/obj/weapon/sword/changjian")->wield();
  add_money("silver", 40);
}



void init() {
  add_action("do_identify", "jianding");
  add_action("do_dakong", "dakong");
}

int do_identify(string arg) {
  object ob, me = this_player();
  if (!arg) return notify_fail("你要鉴定什么？\n");
  if (!ob = present(arg, this_player()))
    return notify_fail("你身上没有这个东西。\n");
  if (!ob->query("newitem") || ob->query("identify") == "done") {
    command("say 这个装备还用鉴定？");
    return 1;
  }
  ob->initobject(me);
  ob->delete("no_identify");
  ob->set("identify", "done");
  command("say 我看看......");
  command("say 完了，你自己看看吧（show 装备）。");
  me->start_busy(3);
  return 1;
}

int do_dakong(string arg) {
  object ob, me = this_player();
  if (!arg) return notify_fail("你要给什么打孔？\n");
  if (!ob = present(arg, this_player()))
    return notify_fail("你身上没有这个东西。\n");
  if (!ob->query("newitem")) {
    return notify_fail("这东西不能打孔。\n");
  }
  if (ob->query("socketed")) return notify_fail("这东西不是已经有孔了吗？\n");
  if (me->query("balance") < 3000000) return notify_fail("打孔不能白打，打一次要300两黄金。你的存款不够。\n");
  command("say 你等等。。。");
  message_vision("$N走进内室，只听一阵叮叮当当的声音传来，一会$N从内室中走了出来。\n", this_object());
  command("say 行了。");
  me->add("balance", -3000000);
  ob->set("socketed", 1);
  ob->set("socketed_num", 1 + random(4));
  me->start_busy(3);
  ob->save();
  return 1;
}
