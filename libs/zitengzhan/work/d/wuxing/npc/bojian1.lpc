int do_sell(string arg) {
  object ob;
  int value;

  if (this_player()->is_busy())
    return notify_fail("你现在正忙着呢。\n");

  if (!arg || !(ob = present(arg, this_player())))
    return notify_fail("你要卖什么物品给柏鉴？\n");

  if (!ob->query("newitem")) return notify_fail("柏鉴不回收这种物品。\n");
  if (ob->query("owner_id")) return notify_fail("有主人的物品，柏鉴不收。\n");
  value = ob->query("value");
  if (value > 50000) value = 50000;
  message_vision("$N把身上的" + ob->query("name") + "卖掉，钱庄的存款增加了" + price_string(value) + "。\n",
    this_player());

  destruct(ob);

  this_player()->start_busy(1);
  this_player()->add("balance", value);

  return 1;
}
int find_hu() {
  object *lianyaohu;
  object hu, where;
  int i;
  string j, k;
  i = random(100);
  j = (string)save_variable(i);
  k = "/d/wuxing/yaogu" + j;
  lianyaohu = children("/d/shenqi/lianyaohu.lpc");
  if (sizeof(lianyaohu) > 1) {
    where = environment(lianyaohu[0]);
    if (!where) command("say 老夫也不知道这神器现在何处。");
    else if (userp(where)) command("say 这神器正被某位仙兄拿着。");
    else if (where->query("short") == "妖谷") command("say 这炼妖壶正放在妖谷的某处。您不放去找找看。");
    else command("say 这神器被人胡乱丢到了某个地方，你最好再打听打听。");
  } else {
    hu = new("/d/shenqi/lianyaohu.lpc");
    hu->move(load_object(k));
    command("say 这炼妖壶正放在妖谷的某处。您不放去找找看。");
  }

  return 1;
}
