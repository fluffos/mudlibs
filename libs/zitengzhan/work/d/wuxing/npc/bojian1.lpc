int do_dubo(string arg) {
  object ob, me = this_player();
  mapping goods;
  string *name;
  //     if (wizardp(me)) return notify_fail("巫师还用赌博吗?\n");
  if (!arg) return notify_fail("你要赌博什么？\n");
  goods = query("vendor_goods");
  if (!goods[arg]) return notify_fail("你要赌博什么物品？\n");
  if (!me->query("balance") || me->query("balance") < 100000) return notify_fail("你的存款不够。\n");
  ob = new(goods[arg]);
  command("nod");
  command("say 你到铸宝室里自己挑一件中意的吧。");
  me->command("enter");
  message_vision(YEL "$N俯下身子在那些废弃的装备里挑了半天。\n" NOR, me);
  message_vision(HIG "$N终于从里面拿了一" + ob->query("unit") + ob->query("name") + "站起身来。\n" NOR, me);
  me->command("out");
  ob->initobject(me);
  ob->disappear();
  ob->move(me);
  ob->first(me);
  me->add("balance", -100000);
  me->start_busy(2);
  return 1;
}
int do_list(string arg) {
  mapping goods;
  string list, *name;
  int i;
  string tlist;

  if (!mapp(goods = query("vendor_goods"))) return 0;
  if (arg && !this_object()->id(arg)) return notify_fail("你想看什么？\n");
  name = keys(goods);
  list = "你可以从柏鉴处赌博到下列物品：\n";
  for (i = 0; i < sizeof(name); i++) {
    tlist = sprintf("%s(%s)", goods[name[i]]->query("name"), name[i]);
    list += sprintf("%-30s：%s\n", tlist,
      price_string(100000));
  }
  write(list);
  return 1;
}

int do_yao(string arg) {
  object me = this_player();
  object ob, ob1 = this_object();
  if (!arg) return notify_fail("你想要什么？\n");
  if (arg != "xianglian" && arg != "necklace") return notify_fail("你想要什么？\n");
  if (!me->query("wuxing/jiezhen")) return notify_fail("你是怎么到这里的？\n");
  if (ob = present("wuxing xianglian", me))
    return notify_fail("你不是已经有了么？\n");
  ob = new("/d/wuxing/obj/wuxing_necklace");
  ob->move(me);
  ob1->command("say 这就是五行项链，对你有莫大的好处，拿好了。");
  message_vision("柏鉴给$N一串项链。\n", me);
  me->command("wear necklace");
  return 1;
}

int do_settype(string arg) {
  object me = this_player();
  if (!arg) return notify_fail("你要设定什么属性？\n");
  if (arg == "jin" || arg == "mu" || arg == "shui" || arg == "tu" || arg == "huo") {
    me->set("wuxingtype", arg);
    tell_object(me, "你设定攻击带" + wuxingtochinese[arg] + "系伤害。\n");
    return 1;
  }
  return notify_fail("你只能设定五行中的一种属性。\n");
}

int do_setlevel(string arg) {
  int i;
  mixed j;
  object me = this_player();
  if (!arg) return notify_fail("你要设定多少级别？\n");
  if (!me->query("wuxingyao/done") && me->query("wuxingyao")) return notify_fail("请先完成你现在的任务。\n");
  j = restore_variable(arg);
  if (!intp(j)) return notify_fail("你只能设定一个整数级别。\n");
  i = (int)j;
  if (i <= 0) return notify_fail("请设定一个正整数。\n");
  if (i > me->query("wuxing/level")) return notify_fail("你不能杀比自己级别高的妖怪。\n");
  me->set("wuxingyao/kill_level", i);
  me->delete_temp("wuxingyao");
  tell_object(me, "你设定的妖怪级别是" + arg + "。\n");
  return 1;
}

//this funtion is modified by vikee 2000-11-20 1:32
int cancel_me() {
  object ghost, me = this_player();
  //this modi by cnd delete here if for bug
  if (me->query("wuxingyao/done")) {
    command("say 你要放弃什么？\n");
    return 1;
  }
  if (!me->query_temp("wuxingyao/ob")) {
    command("say 好吧。");
    me->delete_temp("wuxingyao/name");
    me->delete_temp("wuxingyao/time_start");
    me->set("wuxingyao/done", 1);
    if (me->query_temp("wuxingyao/level") != 0) me->add_temp("wuxingyao/level", -1);
    return 1;
  }

  ghost = me->query_temp("wuxingyao/ob");
  if (!living(ghost)) {
    command("say " + ghost->query("name") + "已经修炼好了，跑到人间去了!\n");
    return 1;
  }
  me->delete_temp("wuxingyao/ob");
  // 删除灭妖资料
  me->delete_temp("wuxingyao/name");
  me->delete_temp("wuxingyao/time_start");
  //如果放弃这个怪物,当前的level-1.
  if (me->query_temp("wuxingyao/level") != 0) me->add_temp("wuxingyao/level", -1);
  command("sigh");
  command("say 看来他还是气数未尽，此乃天命使然。罢了！罢了！\n");
  me->set("wuxingyao/done", 1);
  destruct(ghost);
  return 1;
}

int work_me() {
  object ghost, me;
  int t, lvl;
  me = this_player();
  //     if (wizardp(me)) return notify_fail("巫师还用灭妖吗?\n");
  if (!present("wuxing xianglian", me)) {
    command("say 你先拿到五行项链再去吧。");
    return 1;
  }
  if (!me->query("wuxing/level")) {
    command("say 你不能灭这种妖。");
    return 1;
  }
  if (!me->query("wuxingyao/kill_level")) {
    command("say 你还没有设定妖怪的级别。\n");
    return 1;
  }
  if (!me->query("wuxingtype")) {
    command("say 你先准备自己的攻击属性吧。");
    return 1;
  }
  //for first time.
  if (!me->query("wuxingyao")) {
    call_out("start_job", 1, me);
    return 1;
  }
  //        if( (t=(int)me->query("mieyao/time_start")) &&
  if ((t = (int)me->query("wuxingyao/time_start")) &&
    //allenc
    (!me->query("wuxingyao/done"))) {

    command("?");
    command(
      "say 你还没有降服" + me->query("wuxingyao/name")
      + "呢！\n");
    return 1;

    // 同样的目的，改了一下  by daofeng.
    /*// here is modified by vikee for the #9 ask li about kill 's bug
	    // or the #8 {u;ask li about kill;d}'s bug,
	    // set a flag "mieyao/level_change" to judge the monster level.*/

    if (!me->query_temp("wuxingyao/level_changed")) {
      //command("say 不要急，慢慢说，我年纪大，说快了听不清。");
      lvl = me->query_temp("wuxingyao/level");
      if (!lvl) lvl = 0;
      me->set_temp("mieyao/level", lvl);
      me->set_temp("wuxingyao/level_changed", 1);
    }
    // allow ask again.
  } else {  // job done
    /*if(t<=time() &&
		    time()<t+360) {
		message_vision("$N对手中照妖镜一看，说"+
			"：这位"+RANK_D->query_respect(me)
			+",妖魔已除尽,不妨先去歇息。\n",
			this_object(), me);
		return 1;
	    }*/
    // succeed, increase lvl.
    if (!me->query_temp("wuxingyao/level_changed")) {
      lvl = me->query_temp("wuxingyao/level");
      if (lvl < 49) lvl++;  // total 50 levels: 0, ...,49
      else {
        if (me->query("wuxingyao/kill_level") == me->query("wuxing/level")) {
          me->add("wuxing/level", 1);
        }  // kill 50 same wuxinglevel's yao,add 1 wuxinglevel.
        command("say 你已经连续杀了一轮妖怪，辛苦了。\n");
        lvl = 1;  // reach the top level, reduce difficulty.
      }
      me->set_temp("wuxingyao/level", lvl);
      me->set_temp("wuxingyao/level_changed", 1);
    }
  }
  me->delete("wuxingyao/time_start");
  call_out("start_job", 1, me);
  return 1;
}
int start_job(object me) {
  string where;
  object ghost;
  int lvl;

  if (environment(me) != environment()) return 1;
  if (me->query("wuxingyao/time_start")) return 1;
  me->delete("wuxingyao/done");
  me->set_temp("wuxingyao/level_changed", 0);

  // determine levels.
  // use temp mark, if quit, then start over.
  lvl = me->query_temp("wuxingyao/level");

  ghost = new(__DIR__ + list[random(sizeof(list))]);
  ghost->set("wuxing/level", me->query("wuxingyao/kill_level"));
  where = ghost->invocation(me, lvl);

  message_vision("$N抬头仔细看看封神榜，对$n说道：有" + where + "合该前来封神"
    + "请你引他前来吧！\n"
    , this_object(), me);
  me->set("wuxingyao/time_start", time());
  me->set("wuxingyao/name", ghost->query("name"));
  me->set_temp("wuxingyao/ob", ghost);
  me->move("/d/wuxing/yaogu55");
  return 1;
}

int do_shift(string arg) {
  string to;
  int amount, bv1, bv2, bv3;
  object me = this_player();

  if (!arg || sscanf(arg, "%d to %s", amount, to) != 2)
    return notify_fail("指令格式：huan <数量>  to <种类>\n");

  if (this_player()->is_busy())
    return notify_fail("你现在正忙着呢...。\n");

  if (!shiftexp[to]) return notify_fail("你想把经验值换成什么？\n");
  if (!me->query("newexp")) return notify_fail("你还没有经验值呢。\n");
  if (amount < 1) return notify_fail("实际一点吧。\n");

  bv1 = me->query("newexp");
  if (bv1 < amount)
    return notify_fail("你的经验值不够，再去杀一会妖吧。\n");

  bv2 = (int)restore_variable(shiftexp[to][0]);
  bv3 = amount % bv2;
  bv3 = amount - bv3;
  bv1 = (int)bv3 / bv2;

  me->add("newexp", -bv3);
  me->add(to, bv1);
  message_vision(sprintf("$N把%s点经验值换成了%s点%s。\n",
    chinese_number(bv3), chinese_number(bv1), shiftexp[to][1]), me);
  me->save();
  return 1;
}
string price_string(int v) {
  string str = "";
  int val;

  val = v / 10000;
  if (val) str += chinese_number(val) + "两黄金";
  val = (v % 10000) / 100;
  if (val) str += chinese_number(val) + "两银子";
  val = (v % 100);
  if (val) str += chinese_number(val) + "文钱";

  if (str == "") str = "零文钱";

  return str;
}
void pay_player(object who, int amount) {
  object ob;

  if (amount < 1) amount = 1;
  if (amount / 100) {
    ob = new(SILVER_OB);
    ob->set_amount(amount / 100);
    if (!ob->move(who))
      ob->move(environment(who));
    amount %= 100;
  }
  if (amount) {
    ob = new(COIN_OB);
    ob->set_amount(amount);
    if (!ob->move(who))
      ob->move(environment(who));
  }
}

