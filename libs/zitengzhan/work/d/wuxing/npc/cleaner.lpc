inherit NPC;


void create() {
  seteuid(getuid());
  set_name("看守", ({ "cleaner" }));
  set("long", "万劫谷的看守。\n");
  set("gender", "男性");
  set("class", "xian");
  set("age", 37);
  set("con", 30);
  set("per", 30);
  set("str", 25);
  set("int", 35);
  set("combat_exp", 50000000);
  set("daoxing", 50000000);
  set("attitude", "heroism");
  set("chat_chance", 90);
  set("chat_msg", ({
    (: random_move :)
  }));


  set_skill("dodge", 800);
  set_skill("force", 800);
  set_skill("parry", 800);
  set_skill("unarmed", 800);
  set_skill("spells", 800);
  set_skill("No.1_skill", 800);
  set_skill("sword", 800);
  set_skill("literate", 800);
  map_skill("sword", "No.1_skill");
  map_skill("parry", "No.1_skill");
  map_skill("force", "No.1_skill");
  map_skill("spells", "No.1_skill");
  map_skill("unarmed", "No.1_skill");
  map_skill("dodge", "No.1_skill");
  set("max_force", 20000);
  set("force", 40000);
  set("max_mana", 20000);
  set("mana", 40000);
  set("mana_factor", 300);
  set("force_factor", 300);
  set("max_kee", 70000);
  set("max_gin", 40000);
  set("max_sen", 50000);

  setup();
  carry_object("/obj/cloth")->wear();
  carry_object("/d/obj/weapon/sword/changjian")->wield();
  add_money("silver", 40);
}
