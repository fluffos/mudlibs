//Cracked by Roath
inherit ROOM;
#include <ansi.h>
string *shenqis = ({
        "/d/shenqi/kunlunjing.lpc",
    "/d/shenqi/nvwashi.lpc",
        "/d/shenqi/fuxiqin.lpc",
        "/d/shenqi/shennongding.lpc",
        "/d/shenqi/kongdongyin.lpc",
});
int shenqi();
void create ()
{
        set ("short", "结阵之地");
        set ("long", @LONG

在这里用神农鼎、女娲石、伏羲琴、崆峒印、昆仑镜可以结阵前往
万劫谷(jiezhen)。
LONG);

        set("exits", 
        ([ //sizeof() == 4
                "west" : __DIR__"entrance",
                //"up" : __DIR__"***",
                //"down" : __DIR__"***",
        ]));

        set("objects", 
        ([ //sizeof() == 1
                //"/d/shenqi/shennongding" : 1,
                //__DIR__"npc/***" : 1,
        ]));


        set("outdoors", "wuxing");

        setup();
        shenqi();
}
void init()
{
   add_action("do_jiezhen","jiezhen");
//        shenqi();
}

int do_jiezhen()
{
        int i=1;
        object me=this_player();
        object ob,ob1,ob2,ob3,ob4,ob5;
         if (!me->query("dntg/number") || me->query("dntg/number")!=10) return notify_fail("你还是先过完大闹天宫吧。\n");
         if (!me->query("obstacle/number") || me->query("obstacle/number")!=34) return notify_fail("你还是先取经吧。\n");
        while(ob = present("wanling xue "+i,environment(me)))
        {
                i+=1;
        }
        if(!ob1 = present("kunlun jing",environment(me))) i-=1;
        if(!ob2 = present("nvwa shi",environment(me))) i-=1;
        if(!ob3 = present("shennong ding",environment(me))) i-=1;
        if(!ob4 = present("fuxi qin",environment(me))) i-=1;
        if(!ob5 = present("kongdong yin",environment(me))) i-=1;
    if(i<1 && !me->query("wuxing/jiezhen") ) return notify_fail("你先拿到五样神器吧。\n");

        if (!me->query("wuxing/jiezhen")) {me->set("wuxing/level",1);}
        message_vision(HIY"$N布成了忘却之阵，$N的身形嗖的不见了。\n"NOR,me);
        me->set("wuxing/jiezhen",1);
        me->set_temp("wuxingyao/swim",1);
        destruct(ob1);
        destruct(ob2);
        destruct(ob3);
        destruct(ob4);
        destruct(ob5);
        while(ob = present("wanling xue "+i,environment(me)))
        {
            destruct(ob);
         }
        me->move("/d/wuxing/shentai");
        message_vision(HIY"$N出现在一片金光中。\n"NOR,me);
        return 1;
}
int shenqi()
{
        object* shenqi;
        object qi;
        int i;
        for (i=0;i<5;i++){
        shenqi=children(shenqis[i]);
        if (sizeof(shenqi)>1) continue;
        qi=new(shenqis[i]);
        qi->move(this_object());
        }
        return 1;
}

