void init() {
  this_object()->set("alternative_die",1);

  add_action("do_back","back");
  if(random(200)<1) {
   new("/d/shenqi/yao/yaocai")->move(this_object());
   }
}

int do_back()
{
   object me=this_player();
   if(me->is_fighting()) return notify_fail("你现在正忙着呢...。\n");
   if(me->is_busy()) return notify_fail("你现在正忙着呢...。\n");
   me->move("/d/wuxing/shentai");
   message_vision("\n");
   message_vision(HIG"$N念动符文，遁回了封神台\n"NOR,me);
   message_vision("\n");
   return 1;
}

void alternative_die(object who)
{
   object yaoguai;
   int lostexp;
   if (!userp(who)) {
    set("alternative_die",0);
    who->die();
    set("alternative_die",1);
       return;
   }
   if (who->query_temp("last_damage_from")&&((!(yaoguai=who->query_temp("wuxingyao/ob")))|| who->query_temp("last_damage_from")!=yaoguai))
{
//   if (!who->query_temp("last_damage_from")) return;
           set("alternative_die",0);
           who->die();
           set("alternative_die",1);
           return;
   } else
   {
   if (who->query_temp("wuxingyao/ob")) destruct(who->query_temp("wuxingyao/ob"));
   message_vision(HIR"就在$N三魂七魄尽散之际，清福神浮现于空，救起了$N。\n"NOR,who);
   who->delete_temp("wuxingyao/name");
  who->delete_temp("wuxingyao/time_start");
   who->set("wuxingyao/done",1);
    if (who->query_temp("wuxingyao/level")!=0) who->add_temp("wuxingyao/level",-1);
   who->move("/d/wuxing/shentai");
   who->clear_condition();
   who->set("eff_kee",who->query("max_kee"));
   who->set("eff_sen",who->query("max_sen"));
   who->set("kee",who->query("max_kee"));
   who->set("sen",who->query("max_sen"));
   who->remove_all_killer();
   who->start_busy(2);
   if (who->query("combat_exp")) {
         lostexp=who->query("newexp")/10;
         who->add("newexp",-lostexp);
}
   who->add("wuxing/dead",1);
   return;
   }
}



