// bigaxe.c

#include <weapon.h>
#include <ansi.h>

inherit AXE;
#include "zhuangbei.h"
#define TYPE_NUM 7;
string *nametype = ({ "三板斧", "少林板斧", "凤头斧", "峨嵋斧", "宣花斧", "大斧", "鱼尾斧" });
string *longtype = ({ "古代长兵器的一种，又名“马战斧”。相传为程咬金所用。斧阔五寸，柄长七尺。\n",
  "长二尺八寸，斧头长一尺二寸，刃宽九寸。\n",
  "斧头长八寸，刃阔五寸。尾厚刃薄。柄长二尺五寸。是斧中较短的一种。\n",
  "长九寸，刃阔为五寸，柄长三尺，粗约盈把，常用于近战或地道内掘土所用。\n",
  "斧头刃的一面特别大，斧端之刺较一般长。\n",
  "斧重柄长，斧头有铜制和铁制两种。斧头一面有刃，刃阔八寸左右，尾部厚而窄，并带有突出往下弯曲的尖角。柄长丈余。\n",
  "斧头形似鱼故得其名。\n",
});
int *damagetype = ({ 75, 100, 130, 150, 200, 240, 270 });

void create() {
  set_name("斧", ({ "axe" }));
  set("type/kind", "axe");
  set("type/large", "weapon");
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是一把沉重的大板斧，砍起东西来非常顺手。\n");
    set("value", 11);
    set("wield_msg", "$N拿出一把$n，握在手中当作武器。\n");
    set("unwield_msg", "$N放下手中的$n。\n");
  }
  init_axe(11);
  setup();
}
void initobject(object me) {
  int level = me->query("wuxing/level");
  object ob = this_object();
  int type = TYPE_NUM;
  if (level > 100) level = 100;
  type = random(type * level / 100);
  initzhuangbei(me, ob, nametype[type], longtype[type], damagetype[type]);
}
