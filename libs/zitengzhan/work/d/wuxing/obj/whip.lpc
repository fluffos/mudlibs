// whip.c

#include <weapon.h>
#include <ansi.h>
inherit WHIP;
#include "zhuangbei.h"
#define TYPE_NUM 6;
string *nametype = ({ "短鞭", "皮鞭", "杆子鞭", "三节鞭", "九节鞭", "蛇形软鞭" });
string *longtype = ({
  "短鞭没有鞭把，只有鞭身，鞭身以生牛皮或生牛筋编制而成，长度为三尺至四尺半。\n",
  "以生牛皮或牛筋制成。也可以以麻绳编制后，用油浸透，方可使用。长度按需要而定，可长至二丈，也可短于数尺。\n"
  "短杆头系绳索装一镖头，杆尾有鐏。\n",
  "由鞭头、鞭把和中间两个钢节以铁环连接而成。\n",
  "铁或钢制，由九节短鞭组成。其顶端，节为鞭头，形状为枪头形成圆锥形，其后有环，以铁环与下一节相连。最尾端一节为鞭把，多为圆柱形。\n",
  "由橡胶带或者皮、麻类、索类等编织制成的，长约一丈。\n",
});
int *damagetype = ({ 75, 100, 150, 200, 240, 270 });


void create() {
  set_name("鞭", ({ "whip" }));
  set("type/kind", "whip");
  set("type/large", "weapon");
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一条长长的铁链，上面沾满了血．\n");
    set("unit", "条");
    set("value", 500);
    set("wield_msg", "只听「啪」的一声响，$N的手中闪出一条$n．\n");
    set("unwield_msg", "$N把手中$n缠回腰间．\n");
  }
  init_whip(25);
  setup();
}
void initobject(object me) {
  int level = me->query("wuxing/level");
  object ob = this_object();
  int type = TYPE_NUM;
  if (level > 100) level = 100;
  type = random(type * level / 100);
  initzhuangbei(me, ob, nametype[type], longtype[type], damagetype[type]);
}
