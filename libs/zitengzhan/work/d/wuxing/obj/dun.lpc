#include <armor.h>
#include <ansi.h>
inherit SHIELD;
#include "zhuangbei.h"
string *names = ({
  "青萝藤盾",
  "紫萝藤盾",
  "樟木盾",
  "楠木盾",
});

string *ids = ({
  "qingluo dun",
  "ziluo dun",
  "zhangmu dun",
  "nanmu dun",
});

void create()
{
  int i = random(sizeof(names));
  set_name(names[i], ({"dun"}));
        set("type/kind","dun");
        set("type/large","armor");
  set_weight(6000);
  if ( clonep() )
     set_default_object(__FILE__);
  else {
   set("unit", "件");
   set("value", 200);
   set("material", "wood");
   set("armor_prop/armor",100);
  }
  setup();
}
void initobject(object me)
{
            object ob=this_object();
            initzhuangbei(me,ob,query("name"),query("long"),100);
}
