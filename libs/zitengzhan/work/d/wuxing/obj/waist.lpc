#include <armor.h>
#include <ansi.h>
inherit WAIST;
#include "zhuangbei.h"

string *names = ({
  "铁护腰",
  "铜护腰",
});

string *ids = ({
  "tie hu yao",
  "tong hu yao",
});

void create() {
  int i = random(sizeof(names));
  set_name(names[i], ({ "waist" }));
  set("type/kind", "waist");
  set("type/large", "armor");
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 200);
    set("material", "metal");
    set("armor_prop/armor", 20);
  }
  setup();
}
void initobject(object me) {
  object ob = this_object();
  initzhuangbei(me, ob, query("name"), query("long"), 20);
}
