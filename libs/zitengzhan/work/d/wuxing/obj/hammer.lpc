#include <weapon.h>
#include <ansi.h>
inherit HAMMER;
#include "zhuangbei.h"
#define TYPE_NUM 7;
string *nametype=({"少林铜锤","立瓜锤","两头锤","八棱锤","金瓜锤","雷公锤","卧瓜锤"});
string *longtype=({
"全长二尺五寸，头长八寸。 \n",
"柄长七尺，一端为锤，锤为椭圆形，如竖立之瓜，故名。\n",
"柄长六尺，两端各有一锤。锤呈圆瓜形。\n",
"短锤的一种。因锤呈八棱形，故名。其柄约四尺。\n",
"短锤的一种，其柄短，锤头形状形如瓜可用来硬砸硬架。\n",
"形如圆柱形，端柄。\n",
"其形与金瓜锤相似，惟锤头如横卧之瓜，故得其名。\n",
});
int *damagetype=({75,100,140,170,200,240,270});

void create()
{
        set_name("锤", ({ "hammer" }) );
        set("type/kind","hammer");
        set("type/large","weapon");
        set_weight(8500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long", "这是一把沉重的金瓜，是皇城卫士的专用武器。\n");
                set("value", 1200);
                set("material", "iron");
                set("wield_msg", "$N拿出一把$n，试了试重量，然后握在手中。\n");
                set("unwield_msg", "$N放下手中的$n。\n");
        }

        init_hammer(25);
        setup();
}
void initobject(object me)
{
                int level=me->query("wuxing/level");
            object ob=this_object();
            int type=TYPE_NUM;
                if (level>100) level=100;
            type=random(type*level/100);
            initzhuangbei(me,ob,nametype[type],longtype[type],damagetype[type]);
}


