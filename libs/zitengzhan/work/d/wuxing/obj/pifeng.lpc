#include <armor.h>
#include <ansi.h>
inherit SURCOAT;
#include "zhuangbei.h"

void create()
{
  set_name("兽皮披风", ({"pifeng"}));
        set("type/kind","pifeng");
        set("type/large","armor");
  set_weight(4500);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "一件兽皮披风。\n");
    set("material", "leather");
    set("unit", "件");
    set("value", 700);
    set("armor_prop/armor", 120);
  }
  setup();
}
void initobject(object me)
{
            object ob=this_object();
            initzhuangbei(me,ob,query("name"),query("long"),120);
}


