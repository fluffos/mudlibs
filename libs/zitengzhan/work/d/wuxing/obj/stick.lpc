// stick.c

#include <weapon.h>
#include <ansi.h>
inherit STICK;
#include "zhuangbei.h"
#define TYPE_NUM 8;
string *nametype = ({ "齐眉棍", "盘花棍", "少林棍", "丈二棒", "杆棒", "杵棒", "狼牙棒", "金箍棒" });
string *longtype = ({
  "常以白蜡杆制成，粗有盈把，棍竖直与人眉高度齐，故得此名。\n",
  "因其棍身刻有花纹，故得其名。\n",
  "棍的一种。木制，长八尺至八尺五寸，通体一般粗细。\n",
  "其长度为一丈二尺，粗可盈把。棍术的特点是活动范围大，攻防意识强。\n",
  "长约六尺，粗可盈把，以白蜡杆或带有韧性之木制成。\n",
  "长五尺，尖长一寸二分。棒头的两端各长一尺五寸，上端植有小刺48个，下端植有小刺50个，小刺长五分，状如狼牙。\n",
  "长约六尺。棒头为蛋形圆木，上植许多铁钉，形如狼牙，故名。\n",
  "也属棍的一种。棍长八尺左右，棍梢和棍根处均套有尺余长的铁箍或铜箍。\n",
});
int *damagetype = ({ 75, 100, 130, 160, 190, 220, 250, 270 });

void create() {
  set_name("棍棒", ({ "stick" }));
  set("type/kind", "stick");
  set("type/large", "weapon");
  set_weight(8000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("value", 2000);
    set("material", "steel");
    set("long", "一根沉甸甸黑黝黝的镔铁棍。\n");
    set("wield_msg", "$N拿起一根$n，顺手舞了个棍花。\n");
    set("unwield_msg", "$N哼了一声，将$n插回后腰。\n");
  }
  init_stick(35);
  setup();
}
void initobject(object me) {
  int level = me->query("wuxing/level");
  object ob = this_object();
  int type = TYPE_NUM;
  if (level > 100) level = 100;
  type = random(type * level / 100);
  initzhuangbei(me, ob, nametype[type], longtype[type], damagetype[type]);
}
