// gangcha.c

#include <weapon.h>
#include <ansi.h>
inherit FORK;
#include "zhuangbei.h"
#define TYPE_NUM 6;
string *nametype=({"马架","抱头钢叉","二股叉","少林独股叉","少林两股猎叉","少林三股猎燕叉"});
string *longtype=({
"又称\"马叉\"。长1-3尺，除握手这一边外，其余三边均可击人。而且四角生钩。\n",
"中股长出其余二股三四寸，形如蛇。旁边二股由中股底端环抱而曲。柄长八尺，柄尾有鐏。\n",
"铁制，长杆，杆头有二股平行的锥叉，故名。\n",
"全长八尺，用于防身习武守院。\n",
"全长七尺半，用于防猛兽、盗贼之用。\n",
"全长七尺半。\n",
});
int *damagetype=({75,125,175,200,240,270});


void create()
{
        set_name("叉", ({ "fork" }) );
        set("type/kind","fork");
        set("type/large","weapon");
        set_weight(5000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("value", 1000);
                set("material", "iron");
                set("long", "一柄锋利的钢叉。\n");
                set("wield_msg", "$N抄起一柄$n，还拿衣服擦了擦叉尖。\n");
        }
        init_fork(25);
        setup();
}
void initobject(object me)
{
                   int level=me->query("wuxing/level");
            object ob=this_object();
            int type=TYPE_NUM;
                   if (level>100) level=100;
            type=random(type*level/100);
            initzhuangbei(me,ob,nametype[type],longtype[type],damagetype[type]);
}

