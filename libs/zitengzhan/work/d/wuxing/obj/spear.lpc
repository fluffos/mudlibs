// spear.c

#include <weapon.h>
#include <ansi.h>
inherit SPEAR;
#include "zhuangbei.h"
#define TYPE_NUM 8;
string *nametype=({"古矛枪","钩镰枪","九曲枪","太宁笔枪","花枪","雁翎枪","蛇矛","丈八蛇矛"});
string *longtype=({
"枪头长七寸，重四两。其方棱扁如荞麦，前头尖锐，用于透刺。\n",
"枪长七尺二寸，其中枪头为八寸。枪头上尖锐，其下部有侧向突出之倒钩，钩尖内曲。枪杆长六尺，粗圆径为四寸，以木制成，杆尾有铁鐏，长四寸。 \n",
"枪长一丈一，枪头如蛇形，顶尖而锋利，两侧薄刀，整个枪头长一尺余。\n",
"枪头锐利，枪头刃下数寸装一小铁盘，上面有刃。因其枪头如笔状，故得此名。\n",
"枪杆长五尺，梭形枪头，枪头下红缨，枪杆粗不攻把。由于枪杆较细，抖动时枪头颤抖不停，使人难以捉摸枪尖戳处，使人眼花缭乱，故得此名。\n",
"通体长七尺二寸，其中枪头为八寸，枪杆长六尺，粗约三寸余，硬木制成。枪头为炼铁所制，其式样与双钩镰枪相似。惟枪尖为扁平梭形状。杆尾有铁鐏，长为四寸。\n",
"通体铁制，由矛头、矛柄、矛鐏三部分组成。矛头长二尺余，扁平，弯曲如蛇形，两面有刃，故称蛇矛。\n",
"矛曲如蛇，长一丈八尺，故名。\n",
});
int *damagetype=({75,100,130,160,190,220,250,270});

void create()
{
        set_name("枪", ({"spear"}));
        set("type/kind","spear");
        set("type/large","weapon");
        set_weight(5000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long", "这是一把长枪，枪尖略显银光．\n");
                set("value", 500);
                set("material", "iron");
                set("wield_msg", "$N拿出一把$n，握在手中。\n");
                set("unwield_msg", "$N放下手中的$n。\n");
        }

        init_spear(25);
        setup();
}
void initobject(object me)
{
             int level=me->query("wuxing/level");
            object ob=this_object();
            int type=TYPE_NUM;
            if (level>100) level=100;
            type=random(type*level/100);
            initzhuangbei(me,ob,nametype[type],longtype[type],damagetype[type]);
}

