#include <armor.h>
#include <ansi.h>
inherit FINGER;
#include "zhuangbei.h"

string *names = ({
  "铁爪套",
  "铜爪套",
});

string *ids = ({
  "tie zhua tao",
  "tong zhua tao",
});

void create() {
  int i = random(sizeof(names));
  set_name(names[i], ({ "finger" }));
  set("type/kind", "finger");
  set("type/large", "armor");
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "副");
    set("value", 200);
    set("material", "metal");
    set("armor_prop/armor", 20);
  }
  setup();
}
void initobject(object me) {
  object ob = this_object();
  initzhuangbei(me, ob, query("name"), query("long"), 20);
}
