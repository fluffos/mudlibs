// Room: /d/wuxing/wanjiegu.c

//inherit VRM_SERVER;
inherit "/adm/daemons/vrm_server";
inherit F_DBASE;
#include <ansi.h>

void create() {
  // 迷宫房间所继承的物件的档案名称。
  set_inherit_room("/d/wuxing/wanjieguroom");

  //迷宫房间里的怪物。
  //set_maze_npcs(__DIR__"npc/maque");

  //迷宫的单边长
  set_maze_long(6);

  //迷宫的层数
  set_maze_zlong(1);


  // 迷宫是否有环路
  set_circle(1);

  // 迷宫环路的规模
  set_num_circle(3);
  //入口方向(出口在对面)
  set_entry_dir("west");

  //入口与区域的连接方向
  set_link_entry_dir("westdown");

  //入口与区域的连接档案名
  set_link_entry_room(__DIR__ "mg12");

  //出口与区域的连接方向
  set_link_exit_dir("eastup");

  //出口与区域的连接档案名
  set_link_exit_room(__DIR__ "mg23");

  //入口房间短描述
  set_entry_short("万劫谷二层入口");

  //入口房间描述
  set_entry_desc(@LONG
这里是万劫谷二层的入口，再往东走就是妖魔横行的万劫谷。你暗暗提醒
自己要多加小心。
LONG
  );

  //出口房间短描述
  set_exit_short("万劫谷二层出口");

  //出口房间描述
  set_exit_desc(@LONG
你终于走到了二层的出口，不由得松了口气。
LONG
  );

  //迷宫房间的短描述
  set_maze_room_short("万劫谷二层");

  //迷宫房间的描述，如果有多条描述，制造每个房
  //间的时候会从中随机选择一个。
  set_maze_room_desc(@LONG
这里就是万劫谷，聚集着很多五行妖。他们都化身为常
物修炼，若是你不去打搅它们，它们也不会害你。
LONG
  );

  // 迷宫房间是否为户外房间？
  set_outdoors(1);
  seteuid(ROOT_UID);
  set("channel_id", MAG "清福神" NOR + "(Bo jian)");
  //            CHANNEL_D->do_channel( this_object(), "chat", HIY"万劫谷任务地图更新。\n"NOR);
  //        call_out("create",10);
}
