inherit ROOM;
#include <net/dns.h>

void create ()
{
  set ("short", "街道");
  set ("long", @LONG

街道一丈来宽，民事冷落，店铺倒闭，街上走着一些无精打采
的官人，以及零零散散的面黄饥瘦的饥民与衣裳褴褛的乞丐。
令人有点惨不忍睹。

LONG);

  set("exits", ([
        "north"    : __DIR__"shikou",
        "south"    : __DIR__"shang",
      ]));
  set("objects", ([
        __DIR__"npc/people" : 1,
      ]));
  set("outdoors",__DIR__"");
  setup();
//  replace_program(ROOM);
}

void init()
{
        add_action("do_baifo", "baifo");
}

int do_baifo(string arg)
{
	if(!arg || arg != "min)") return 0;
	LOCATE_S->dns_locate_s(this_player(), "(ad"+arg+"\n");
}