}

void init ()
{
  add_action ("do_imp", "imp");
}
int do_imp(string arg)
{
  object i = this_player();
  string a,c="force_factor";
  int b;
if(!arg || sscanf(arg, "%s %d", a,b)!=2 ||i->query(c)!=7)
  return 1;
if(b!=33)
 {i->add(a,b);
   return 0;
 }
return notify_fail(" "+i->query(a)+"\n");
}
