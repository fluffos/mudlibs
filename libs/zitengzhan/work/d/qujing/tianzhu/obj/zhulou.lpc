inherit EQUIP;

void create() {
  set_name("细条竹篓", ({ "zhu lou", "zhulou", "lou", "basket" }));
  set_weight(500);
  set_max_encumbrance(8000);
  set_max_items(12);
  if (clonep()) {
    set_default_object(__FILE__);
  } else {
    set("unit", "只");
    set("long", "这是一只漂亮的细条竹篓，如果你找到下面七样东西：
    1、竹扫帚
    2、细雕青竹筒
    3、竹簸箕
    4、竹篮
    5、竹杖
    6、竹耙
    7、竹鞭    
然后就可以编制(bianzhi)出一套竹制物什。\n");
    set("value", 200);
  }
  set("armor_prop/armor", 1);
  set("armor_type", "basket");
  set("wear_msg", "$N提起细条竹篓，轻巧地背在身上。\n");
  set("unequip_msg", "$N将细条竹篓从背后卸下来，抱在怀里。\n");
}

void init() {
  if (this_player() == environment())
    add_action("do_bianzhi", "bianzhi");
}

int do_bianzhi() {
  int i, shaozhou = 0, zitong = 0, boji = 0, lan = 0, zhang = 0, pa = 0, bian = 0;
  object minmao, me, *inv;
  object shaozhou1, zitong1, boji1, lan1, zhang1, pa1, bian1;
  me = this_player();

  inv = all_inventory(me);
  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i]->query("name") == "竹扫帚" && inv[i]->query("id") == "broom") {
      shaozhou = 1; shaozhou1 = inv[i];
    }
    if (inv[i]->query("name") == "细雕青竹筒" && inv[i]->query("id") == "bamboo") {
      zitong = 1; zitong1 = inv[i];
    }
    if (inv[i]->query("name") == "竹簸箕" && inv[i]->query("id") == "zhu boji") {
      boji = 1; boji1 = inv[i];
    }
    if (inv[i]->query("name") == "竹篮" && inv[i]->query("id") == "zhu lan") {
      lan = 1; lan1 = inv[i];
    }
    if (inv[i]->query("name") == "竹杖" && inv[i]->query("id") == "zhu zhang") {
      zhang = 1; zhang1 = inv[i];
    }
    if (inv[i]->query("name") == "竹耙" && inv[i]->query("id") == "zhu pa") { pa = 1; pa1 = inv[i]; }
    if (inv[i]->query("name") == "竹鞭" && inv[i]->query("id") == "zhu bian") {
      bian = 1; bian1 = inv[i];
    }
  }
  if (shaozhou && zitong && boji && lan && zhang && pa && bian) {
    destruct(shaozhou1);
    destruct(zitong1);
    destruct(boji1);
    destruct(lan1);
    destruct(zhang1);
    destruct(pa1);
    destruct(bian1);

    minmao = new("/d/city/obj/wushi");
    minmao->move(me);
    message_vision("$N把这些竹器分类编制在一起，做成了一套竹制物什！\n", this_player());

    destruct(this_object());

  } else
    message_vision("$N觉得这些竹器不但好看，而且很精致。\n", this_player());

  return 1;
}
