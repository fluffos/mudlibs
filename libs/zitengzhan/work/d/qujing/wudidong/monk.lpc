void init() {

  object me = this_player();    
  add_action("do_quit",banned_action);
  if(!me->query_temp("mark/wudidong_opened_door")&&userp(me))
      {
       write(HIY"岂有此理! "+me->name()+HIY+"是怎么进来的?\n"+NOR);
       message_vision(HIB+"玉鼠精手一挥,两个狱卒将$N"+HIB+"扔了出去。\n"NOR,me);
       me->move("/d/qujing/wudidong/houdong.lpc");
     }
}



int do_quit( ) {
  write("你不能在这里用这条命令。\n");
  if (wizardp(this_player())) write("巫师请参阅同一路径内的banned.h文档。\n");
  return 1;
}

