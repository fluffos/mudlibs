//pansi妖怪for rulaitask难度四
//huarong 2003
#include <ansi.h>
inherit "/d/qujing/lingshan/npc/rulai2/yaoguai/cjguai.lpc";

void set_skills(int max_value, int level) {
  int guai_value;
  ::set_skills(max_value, level);

  guai_value = max_value + max_value / 4;

  set_skill("jiuyin-xinjing", guai_value + random(16));
  set_skill("yinsuo-jinling", guai_value + random(16));
  set_skill("qingxia-jian", guai_value + random(16));
  set_skill("chixin-jian", guai_value + random(16));
  set_skill("yueying-wubu", guai_value + random(16));
  set_skill("sword", guai_value + random(16));
  set_skill("lanhua-shou", guai_value + random(16));
  set_skill("pansi-dafa", guai_value + random(16));
  set_skill("qin", guai_value + random(16));
  set_skill("whip", guai_value + random(16));
  map_skill("spells", "pansi-dafa");
  map_skill("force", "jiuyin-xinjing");
  map_skill("unarmed", "lanhua-shou");
  map_skill("sword", "chixin-jian");
  map_skill("whip", "yinsuo-jinling");
  map_skill("parry", "chixin-jian");
  map_skill("dodge", "yueying-wubu");
  create_family("盘丝洞", 2, "弟子");
  carry_object("/d/pansi/obj/qin.lpc");
  carry_object("/d/obj/cloth/shoupiqun.lpc")->wear();
  carry_object("/d/obj/weapon/18weapon.lpc")->wield();
}

void kill_ob(object ob) {
  object me = this_object();
  me->set_leader(ob);
  remove_call_out("check");
  call_out("check", 1);
  ::kill_ob(ob);
}


void check() {
  object ob = this_object();
  object me = owner();
  if (!present(me, environment()) || !me->is_fighting(ob)) me = offensive_target(ob);
  if (!me) return;
  if (!present(me, environment()) || !ob->is_fighting() || !me->is_fighting(ob)) {
    remove_call_out("check");
    return;
  }
  command("enforce max");
  command("enchant max");
  remove_call_out("check2");
  call_out("check2", 0);
  command("wield weapon");

  if (me->is_busy()) {
    command("exert recover");
    if (random(10) > 3) {
      if (!ob->query_temp("BAIFA_perform")) command("perform lestat");
      map_skill("sword", "qingxia-jian");
      command("perform tongxin on " + me->query("id"));
      command("perform tongxin");
      map_skill("sword", "chixin-jian");
      command("perform hongyan on " + me->query("id"));
      command("perform hongyan");
    } else {
      command("cast wuzhishan");
    }
    remove_call_out("check");
    call_out("check", 3);
  }
  if (!me->is_busy()) {
    command("exert recover");
    command("perform wang on " + me->query("id"));
    command("perform wang");
    remove_call_out("check");
    call_out("check", 2);

  }
}
