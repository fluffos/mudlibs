//longgong妖怪for rulaitask难度四
//huarong 2003
#include <ansi.h>
inherit "/d/qujing/lingshan/npc/rulai2/yaoguai/cjguai.lpc";

void set_skills(int max_value, int level)
{
        int guai_value;
        ::set_skills(max_value, level);
        
        guai_value = max_value+max_value/4;
        set_skill("huntian-hammer", guai_value+random(16));
        set_skill("hammer", guai_value+random(16));
        set_skill("literate", guai_value+random(16));
        set_skill("fork", guai_value+random(16));
        set_skill("seashentong", guai_value+random(16));
        set_skill("dragonfight", guai_value+random(16));
        set_skill("dragonforce", guai_value+random(16));
        set_skill("fengbo-cha", guai_value+random(16));
        set_skill("dragonstep", guai_value+random(16));
        map_skill("hammer", "huntian-hammer");
        map_skill("spells", "seashentong");
        map_skill("unarmed", "dragonfight");
        map_skill("force", "dragonforce");
        map_skill("fork", "fengbo-cha");
        map_skill("parry", "fengbo-cha");
        map_skill("dodge", "dragonstep");
       create_family("东海龙宫", 1, "弟子");
       carry_object("/d/obj/cloth/shoupiqun.lpc")->wear();
       carry_object("/d/obj/weapon/18weapon.lpc")->wield();
}
   
void kill_ob (object ob)
{
          object me = this_object();  
          me->set_leader(ob);
          remove_call_out("check");
          call_out("check",1);
          ::kill_ob(ob);
}           


void check()
{
        object ob=this_object();
        object me = owner();
        int i=random(10);
        if( ! present(me,environment()) || !me->is_fighting(ob) ) me=offensive_target(ob);
        if( ! me ) return ;
   if(! present(me,environment()) ||!ob->is_fighting()||!me->is_fighting(ob))
     {
     remove_call_out("check");
     return;
     }
        command("enforce max");
        command("enchant max");                               
        remove_call_out("check2");
        call_out("check2",0);
        command("wield weapon");

  if(me->is_busy())
    {   
        command("exert recover");
    if (i<2)
           {
            command("perform sheshen on "+me->query("id"));
            command("perform sheshen");
           }
    else if(i<7)
           {
            command("perform shenglong on "+me->query("id"));
            command("perform shenglong");
           }
    else if(i<9)
           {
            command("perform leidong on "+me->query("id"));
            command("perform leidong");
           }
    else
           {
            command("cast water");
           }
        remove_call_out("check");
        call_out("check",4);
    }
  if(!me->is_busy())
    {
        command("exert recover");
        command("perform fengbo on "+me->query("id"));
        command("perform fengbo");
        remove_call_out("check");
        call_out("check",2);

    }

}
      


