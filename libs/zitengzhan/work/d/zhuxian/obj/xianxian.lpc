#include <ansi.h>
#include <weapon.h>
inherit WHIP;
inherit F_UNIQUE;
void create() {
  set_name(HIG "陷仙鞭" NOR, ({ "xianxian whip", "whip" }));
  set_weight(7000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long",

      "陷仙鞭\n"
    );
    set("value", 0);
    set("material", "steel");
    set("wield_msg", "$N「嗖」地一声抽出一条$n握在手中。\n");
    set("unequip_msg", "$N将手中的$n收入腰间。\n");
  }
  set("no_sell", 1);
  set("no_drop", 1);
  set("no_put", 1);
  set("no_give", 1);
  init_whip(90);
  setup();

}

mixed hit_ob(object me, object victim, int damage_bonus) {
  int pro;
  int dam;
  int damage;
  pro = (int)victim->query("force");
  dam = (int)me->query("force");

  damage = (int)me->query("force_factor");
  damage = damage / 3 + random(damage / 3);
  if (random(dam) > random(pro)) {
    victim->receive_damage("sen", damage / 2);
    victim->receive_damage("kee", damage / 2);
    return HIR "陷仙鞭银光一闪。\n" NOR;
  }
}
