// shoupi.c

#include <weapon.h>
#include <ansi.h>

inherit STICK;

void create() {
  //set_name("护腕", ({"wrists"}));
  //set_weight(60);
  set("skill_type", "whip");
  set("primitive_id", "nanf");  // 爆出此装备的id
  set("unique_code", time());  // 以时间定义装备唯一识别码
  set("bind_type", 1);  // 0不绑定，1装备绑定，2拾取绑定,3，直接绑定。
  set("changed", 1);  // 有此属性，系统自动保存此装备
  set("unbreak", 1);  // 有此属性，兵器不能被打断
  set_name(BLINK HIG "卓越的" NOR RED "勾魂索" NOR, ({ "gouhun suo", "whip" }));
  set("durability/max", 5000);  // 最大耐久度
  set("durability/now", 5000);  // 当前耐久度
  set_weight(60);  // 重量
  set("long", RED "勾魂索" NOR);  // 描述
  set("poison_attack/exp", 0);
  set("poison_attack/max_level", 120);
  set("material", "gold");  // 材质
  set("grade", 200);  // 灵性
  set("weapon_prop/damage", 500);
  // 防御力
  set("weapon_prop/luck", 10);  // 内功防御力
  set("weapon_prop/poison_attack", 1);
  set("weapon_prop/attack", 1000);  // 命中
  set("sockets/max", 150);
  // 安放宝石数
  set("value", 1);  // 价值
  set("weapon_wiel/exp", 0);  // 道行需求
  set("weapon_wiel/int", 10);  // 天赋需求
  set("weapon_wiel/max_kee", 0);  // 气血需求
  set("weapon_wiel/max_sen", 0);  // 精神需求
  set("weapon_wiel/skill", 1);  // 等级需求
  /**/

  if (clonep())
    set_default_object(__FILE__);
  else {
    // set("material", "iron");
    set("unit", "根");
    //	set("armor_prop/armor", 1);


  }
  setup();
}
