// 如果player不用finger允许装备武器
// By Canoe 2000-12-1
// /d/sea/obj/dragonfinger.c
// 龙宫弟子的福利，可以向龟八斗索要finger

#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIB "龙神指环" NOR, ({ "dragonfinger", "zhihuan", "finger" }));
  set("weight", 4000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "此物据说也是个神物，能使人攻防倍增,质地非金非铁，倒和当年\n齐天大圣用的定海神针铁有几分相似。你可以试着戴(dai)它或取下(quxia)它。");
    set("unit", "个");
    set("default_file", 1);
    set("no_steal", 1);
    set("value", 10);
    set("material", "gold");
    set("no_get", "这样东西拿不起来！\n");
    set("no_give", "这么珍贵的东西，哪能随便给人？\n");
    set("no_drop", "这么宝贵的指环，扔了多可惜呀！\n");
    set("no_sell", "凡人哪里知道" + this_object()->query("name") + "的价值？还是自己留着吧。\n");

  }
  setup();
}

void init() {
  add_action("do_dai", "dai");
  add_action("do_quxia", "quxia");
}

int do_dai(string arg) {
  object me = this_player();
  if (!arg && (arg != "finger") && (arg != "zhihuan") && (arg != "dragonfinger"))
    return notify_fail("你要戴什么？\n");
  if (!((string)me->query("family/family_name") == "东海龙宫")) return notify_fail("你非龙族，不能戴上" + this_object()->query("name") + "。\n");
  if (me->query_temp("dragonfinger") == 1) return notify_fail("你已经戴上了" + this_object()->query("name") + "。\n");
  if (me->query_temp("weapon")) return notify_fail("你已经装备武器了!\n");
  // 防止dai finger 2,重复dai,也防止了有武器再装备,如果还有漏洞，请指出!
  else {
    int skills_extra = me->query_skill("dragonfight", 1);
    me->set_temp("dragonfinger", 1);
    me->set_temp("dragonfinger_add", skills_extra);
    me->add_temp("apply/armor", skills_extra / 8);
    me->add_temp("apply/dodge", skills_extra / 5);
    me->add_temp("apply/damage", skills_extra / 4);
    // me->add_temp ("apply/unarmed",skills_extra/3);  
    write("你戴上一个" + this_object()->query("name") + "。除非你取下(quxia)指环，否则不能用wield了。\n");
    message_vision(HIR "$N戴上了个非金非铁的指环，全身似乎灵动多了。\n" NOR, me);
    add_action("block_cmd", "", 1);
    return 1;
  }
}

int do_quxia(string arg) {
  object me = this_player();
  int quxia_point;
  if (!(me->query_temp("dragonfinger"))) return notify_fail("你并没有戴上" + this_object()->query("name") + "。\n");
  quxia_point = me->query_temp("dragonfinger_add");
  me->add_temp("apply/armor", -quxia_point / 8);
  me->add_temp("apply/dodge", -quxia_point / 5);
  me->add_temp("apply/damage", -quxia_point / 4);
  me->set_temp("dragonfinger", 0);
  me->set_temp("dragonfinger_add", 0);
  // 
  message_vision(HIB "$N取下了手中的指环，四周似乎少了点龙的气息。\n" NOR, me);
  return 1;
}

int block_cmd(string args) {
  string verb;
  verb = query_verb();

  if ((verb == "wield") && this_player()->query_temp("dragonfinger")) return 1;
  // 还有什么要加的?
}
