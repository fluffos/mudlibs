#include <ansi.h>
inherit ROOM;

void create ()
{
  set ("short", "天魔宫大门");
  set ("long", @LONG

这就是天魔宫的大门了，门高两丈，雄伟壮观。门口站着两个看
守大门的门卫，在警惕的观察四周的动静。
LONG);

  set("objects", ([ /* sizeof() == 1 */
  __DIR__"npc/zhangmen" : 1,
  __DIR__"npc/menwei" : 2,
    ]));
  set("exits", ([ /* sizeof() == 2 */
  "south" : __DIR__"dadian",
  "north" : __DIR__"changlang2",
    "east" : __DIR__"rroad",
    "west" : __DIR__"lroad",
  ]));

  setup();
}
int valid_leave(object me, string dir)
{
  if (dir == "south" && 
      member_array("huo moshi",me->parse_command_id_list())==-1 &&
      member_array("bing moshi",me->parse_command_id_list())==-1 &&
      me->query("family/family_name") != "天魔宫" &&
      objectp(present("men wei", environment(me))))
    {
      message_vision(CYN"门卫大声喝道：不是本门弟子，请不要擅闯禁地！\n"NOR, me);
      return notify_fail("");
    }
  return ::valid_leave(me, dir);
}
