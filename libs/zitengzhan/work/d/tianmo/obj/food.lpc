// by snowcat oct 15 1997

inherit ITEM;
inherit F_FOOD;

string *names = ({
  "油炝大虾",
  "京酱肉丝",
  "糖醋排骨",
  "火腿竹笙羹",
  "五花焖肉",
  "皮蛋瘦肉粥",
  "醉子鸡",
  "熏腊肠",
  "走油脆肠",
  "时鲜蔬菜",
  "三鲜腐竹",
  "翡翠豆腐",
  "麝香冬笋",
  "细扒头肉",
  "青丝熏鱼",
  "爆炒腰花",
  "嫩汆猪肝",
  "红油肺片",
  "麻辣肚丝",
  "宫保鸡丁",
  "红烧素鹅",
  "脆皮烤鸭",

});

void create() {
  set_name("各种菜肴", ({ "food" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一盘香气喷鼻的好菜。\n");
    set("unit", "盘");
    set("value", 0);
    set("food_remaining", 5);
    set("food_supply", 35);
  }
  set("no_sell", 1);
}

void init() {
  if (query("name") == "各种菜肴")
    set_name(names[random(sizeof(names))], ({ "food" }));
  ::init();
}
