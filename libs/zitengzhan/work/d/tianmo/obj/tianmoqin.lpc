#include <ansi.h>
#include <weapon.h>
inherit MUSIC;
inherit F_UNIQUE;

void create() {
  set_name(HIW "天魔琴" NOR, ({ "tianmo qin", "qin" }));
  set_weight(90000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("value", 0);
    set("is_monitored", 1);
    set("no_sell", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_put", 1);
    set("material", "brass");
    set("name_recognized", "天魔琴");
    set("long", HIY "一张透明如玉的古琴，隐隐透出七色光彩，也不知是什么东西做成的。\n" NOR);
    set("wield_msg", HIY "\n$N从身后拿出一张透明如玉的古琴，顿时四周隐隐传来震慑人心的乐声。\n\n" NOR);
    set("unwield_msg", HIY "\n$N将手中的天魔琴背在身后，旁边的人才知道自己身在何处。\n\n" NOR);
  }
  init_music(90);
  setup();
}
