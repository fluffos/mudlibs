inherit NPC;
inherit F_MASTER;


void create() {
  set_name("天魔老祖", ({ "tianmo laozu", "laozu" }));
  set("title", "天魔宫宫主");
  set("long", @LONG
天魔老祖为远古天魔的再世之身，但由于经过百世托生，
因此已远远超过其上代天魔了，尤其他开创的天魔琴，更
是无比霸道。
LONG);
  set("gender", "男性");
  set("age", 50);
  set("attitude", "peaceful");
  set("rank_info/self", "本宫");
  set("rank_info/respect", "老祖");
  set("str", 24);
  set("per", 100);
  set("class", "yaomo");
  set("max_kee", 4500);
  set("max_gin", 5000);
  set("max_sen", 4500);
  set("force", 6500);
  set("max_force", 3600);
  set("force_factor", 190);
  set("max_mana", 4000);
  set("mana", 7000);
  set("mana_factor", 190);
  set("combat_exp", 4000000);
  set("daoxing", 4000000);
  set_skill("spells", 200);
  set_skill("tianmo-dafa", 200);
  set_skill("unarmed", 150);
  set_skill("tianmo-zhang", 150);
  set_skill("dodge", 180);
  set_skill("tianmostep", 180);
  set_skill("parry", 200);
  set_skill("force", 200);
  set_skill("tianmo-force", 200);
  set_skill("sword", 200);
  set_skill("blade", 200);
  set_skill("bingmo-sword", 200);
  set_skill("huomo-dao", 200);
  set_skill("tianmo-qin", 250);
  set_skill("music", 200);
  map_skill("spells", "tianmo-dafa");
  map_skill("unarmed", "tianmo-zhang");
  map_skill("dodge", "tianmostep");
  map_skill("force", "tianmo-force");
  map_skill("parry", "huomo-dao");
  map_skill("music", "tianmo-qin");
  map_skill("blade", "huomo-dao");
  map_skill("sword", "bingmo-sword");
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: cast_spell, "shihun" :),
    (: cast_spell, "chanshen" :),
    (: command("perform nine") :),
  }));

  create_family("天魔宫", 1, "宫主");
  setup();
  carry_object("/d/obj/cloth/choupao")->wear();
  carry_object("/d/city/npc/obj/qin.lpc")->wield();
}
void attempt_apprentice(object ob) {

  if ((string)ob->query("family/family_name") == "天魔宫") {
    if ((int)ob->query("family/generation") > 3) {
      command("hmm");
      command("say 你还是先拜左右护法，好好学学基础吧。\n");
    } else {
      if ((int)ob->query("combat_exp") >= 250000) {
        command("nod ");
        command("say 好，" + RANK_D->query_respect(ob) + "好好跟我学，将来帮为师称霸天下！\n");
        command("recruit " + ob->query("id"));
      } else {
        command("say 你的道行不够，练我的功夫会很危险的。\n");
      }
    }
  }

  else {
    command("hmm");
    command("say 这位" + RANK_D->query_respect(ob) + "，在本宫还是脚踏实地的来吧。\n");
  }

  return;
}
