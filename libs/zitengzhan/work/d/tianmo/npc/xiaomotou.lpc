// worker.c

inherit NPC;
inherit F_MASTER;
void create()
{
        set_name("小魔头", ({"xiao motou", "motou","mo"}));
        set("gender", "男性" );
        set("age", 40);
        set("long", "由于只知道玩耍，不知道用功，所以年纪不小的他居然还仅仅是三代弟子。\n");
        set("combat_exp", 80000);
        set("daoxing", 80000);
        set("attitude", "peaceful");
   set("int", 30);
   set("class", "yaomo");
        create_family("天魔宫", 3, "弟子");
   
        set("eff_dx", 30000);
        set("nkgain", 200);

        set_skill("unarmed", 60);
        set_skill("dodge", 60);
        set_skill("parry", 60);
        set_skill("spells", 60);  
        set_skill("tianmo-dafa", 60);
        set_skill("literate", 60);
        set_skill("blade", 60);  
        set_skill("huomo-dao", 60);
        set_skill("tianmo-zhang", 60);  
        set_skill("tianmostep", 60);
        set_skill("dodge", 60);  
        set_skill("force", 60);   
        set_skill("tianmo-force", 60);

        map_skill("spells", "tianmo-dafa");
        map_skill("unarmed", "tianmo-zhang");
        map_skill("force", "tianmo-force");
        map_skill("blade", "huomo-dao");
        map_skill("parry", "huomo-dao");
        map_skill("dodge", "tianmostep");


        set("per", 10);
        set("max_kee", 500);
        set("max_gin", 500);
        set("max_sen", 500);
        set("force", 450);
        set("max_force", 300);
        set("force_factor", 10);
        set("mana", 450);
        set("max_mana", 300);
        set("mana_factor", 5);
        setup();
        carry_object("/d/obj/weapon/blade/blade")->wield();
}
void attempt_apprentice(object ob, object me)
{
        command("say 很好，" + RANK_D->query_respect(ob) +
"多加努力，他日必定有成。\n");
        command("recruit " + ob->query("id") );
   return;
}     

int recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "yaomo");
}

