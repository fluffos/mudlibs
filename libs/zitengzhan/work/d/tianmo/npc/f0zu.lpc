inherit NPC;
inherit F_MASTER;

int do_drop(object, object);

void create()
{
   set_name("天魔佛祖", ({ "tianmo fozu", "fozu" }));
   set("title", "天魔宫佛祖");
   set("long", @LONG
天魔佛祖为远古天魔的再世之身，但由于经过百世托生，
因此已远远超过其上代天魔了，尤其他开创的天魔琴，更
是无比霸道。
LONG);
   set("gender", "男性");
   set("age", 50);
   set("attitude", "peaceful");
   set("rank_info/self", "本宫");
   set("rank_info/respect", "老佛祖");
   set("str",24);
   set("per",100);
   set("class", "yaomo");
   set("max_kee", 4500);
   set("max_gin", 5000);
   set("max_sen", 4500);
   set("force", 6500);
   set("max_force", 3600);
   set("force_factor", 190);
   set("max_mana", 4000);
   set("mana", 7000);
   set("mana_factor", 290);
   set("combat_exp", 4000000);
   set("daoxing", 4000000);
   set_skill("spells", 300);
   set_skill("tianmo-dafa", 300);
   set_skill("unarmed", 250);
   set_skill("tianmo-zhang", 250);
   set_skill("dodge", 280);
   set_skill("tianmostep", 280);
   set_skill("parry", 300);
   set_skill("force", 300);
   set_skill("tianmo-force", 300);
   set_skill("sword", 300);
   set_skill("blade", 300);
   set_skill("bingmo-sword", 300);
   set_skill("huomo-dao", 300);
   set_skill("tianmo-qin", 350);
   set_skill("music", 300);
   map_skill("spells", "tianmo-dafa");
   map_skill("unarmed", "tianmo-zhang");
   map_skill("dodge", "tianmostep");
   map_skill("force", "tianmo-force");
   map_skill("parry", "huomo-dao");
   map_skill("music", "tianmo-qin");
   map_skill("blade", "huomo-dao");
   map_skill("sword", "bingmo-sword");
   set("chat_chance_combat", 80);
   set("chat_msg_combat", ({
     (: cast_spell, "shihun" :),
     (: cast_spell, "chanshen" :),
     (: command("perform nine") :),
   }) );
   create_family("天魔宫", 1, "宫主");

   setup();
   carry_object("/d/obj/cloth/choupao")->wear();
   carry_object("/d/city/npc/obj/qin.lpc")->wield();
   }
void attempt_apprentice(object ob)
{
ob=this_player();
   if(ob->query("obstacle/number") < 26) {
  command("say 这位" + RANK_D->query_respect(ob) + "我等你取经归来的好消息！\n");
  command("addoil");
  return;
  }
  if( (string)ob->query("family/family_name")=="天魔宫" ){
     if( (int)ob->query("family/generation") > 3   ){
        command("hmm");
        command("say 你还是先拜左右护法，好好学学基础吧。\n");
     }
     else {
        if( (int)ob->query("daoxing") >= 1000000 ){
          command("nod ");
          command("say 好，" + RANK_D->query_respect(ob) + "好好跟我学，将来帮为师称霸天下！\n");
          command("recruit " + ob->query("id") );
        }
        else {
          command("say 你的道行不够，练我的功夫会很危险的。\n");
        }
     }
   }

   else{
     command("hmm");
     command("say 这位" + RANK_D->query_respect(ob) + "，在本宫还是脚踏实地的来吧。\n");
   }

   return;
}
int recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "xian");
     ob->set("title", HBBLU"天魔宫佛祖传人"NOR);
}
