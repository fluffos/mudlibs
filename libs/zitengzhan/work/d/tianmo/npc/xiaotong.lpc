// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

// worker.c

inherit NPC;

void create() {
  set_name("看门小童", ({ "xiao tong" }));
  set("gender", "男性");
  set("age", 13);
  set("long", "一个小孩子，经常在这里迎接前来拜访的客人。\n");
  set("combat_exp", 200);
  set("attitude", "friendly");
  set_skill("dodge", 10);
  set("per", 30);
  set("max_kee", 150);
  set("max_gin", 150);
  set("max_sen", 150);
  setup();
}
void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()
    && !this_player()->query("env/invisibility")) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || !present(ob, environment(this_object()))) return;
  say("小童说道：这位" + RANK_D->query_respect(ob) +
    "，欢迎到我们天魔宫来，入内请不要大声说话！\n");
}
