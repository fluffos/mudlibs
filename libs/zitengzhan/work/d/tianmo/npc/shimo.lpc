inherit NPC;

int give_food();

void create() {
  set_name("黑面食魔", ({ "heimian shimo", "shimo", "mo" }));
  set("gender", "男性");
  set("age", 40);
  set("attitude", "friendly");
  set("combat_exp", 250000);
  set("per", 10);
  set("max_sen", 600);
  set("max_gee", 600);
  set("max_gin", 600);
  set("force", 800);
  set("max_force", 800);
  set("max_mana", 800);
  set("force_factor", 25);
  set_skill("spells", 60);
  set_skill("unarmed", 60);
  set_skill("dodge", 60);

  setup();

  set("inquiry", ([
    "here": "这里当然是天魔宫了。\n",
    "天魔宫": "都在这里了还问什么问。\n",
    "name": "我是食魔，要是饿了可以找我。\n",
    "食物": (: give_food :),
    "food": (: give_food :),
  ]));
  carry_object("/d/obj/cloth/choupao")->wear();

}

int give_food() {
  object me = this_object();
  object who = this_player();
  object food;

  if (who->present("food", who)) {
    command("shake");
    command("say 你身上有吃的了还要啊！");
    return 1;
  }

  food = new("/d/tianmo/obj/food");
  food->move(me);
  command("hmm");
  command("give " + who->query("id") + " food");
  return 1;
}
