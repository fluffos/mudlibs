inherit NPC;
inherit F_MASTER;

void create()
{
       set_name("火魔使", ({"huo moshi", "huomoshi", "moshi"}));
       set("long", "火魔使是天魔老祖的大弟子，但由于性情火暴，做事从不考虑后果，
所以一直不得天魔老祖的欢心，但论武功，他却绝对是天魔宫的第一高手。\n");
        set("gender", "男性" );
        set("age", 30);
        set("title", "魔宫火使");
        set("combat_exp", 900000);
        set("daoxing", 900000);
        set("attitude", "friendly");
        set("rank_info/respect", "老子");
        create_family("天魔宫", 2, "弟子");
   set("int", 25);
   set("class", "yaomo");

        set("eff_dx", 90000);
        set("nkgain", 300);

       set_skill("unarmed", 120);
       set_skill("dodge", 120);
       set_skill("parry", 120);
   set_skill("blade", 120);
   set_skill("spells", 120);
   set_skill("tianmo-dafa", 120);
   set_skill("tianmo-zhang", 120);
   set_skill("tianmo-force", 120);
   set_skill("force", 120);
   set_skill("huomo-dao", 120);
   set_skill("tianmostep", 120);
   map_skill("spells", "tianmo-dafa");
   map_skill("unarmed", "tianmo-zhang");
   map_skill("force", "tianmo-force");
   map_skill("stick", "huomo-dao");
   map_skill("parry", "huomo-dao");
   map_skill("dodge", "tianmostep");
        set("chat_chance_combat", 40);
        set("chat_msg_combat", ({
     (: cast_spell, "shihun" :),
        }) );


        set("per", 30);
   set("str", 25);
        set("max_kee", 1300);
        set("max_gin", 1300);
        set("max_sen", 1300);
        set("force", 28000);
        set("max_force", 1500);
        set("force_factor", 40);
        set("mana", 2600);
        set("max_mana", 1400);
   set("mana_factor", 20);
        setup();
   carry_object("/d/obj/cloth/changpao")->wear();
   carry_object("/d/tianmo/obj/huomodao")->wield();
}
void attempt_apprentice(object ob)
{
   if ( ((int)ob->query("combat_exp") < 120000)) {
   command("say 你的道行太少，和我学不到什么东西，你还是练练再来吧！");
   return;
   }
        command("say 不错，" + RANK_D->query_respect(ob) +
"好好学，师傅我有的是好东西让你学。\n");
        command("recruit " + ob->query("id") );
}
int recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "yaomo");
}

