
inherit ITEM;   
int fail_to_push(object who);
int ok_to_push(object who);
        
void create()
{
         set_name("檀木桌",({"table"}));
        set_weight(5000000);
        if (clonep())
                set_default_object(__FILE__);
        else {  
                 set("long","一张不大的檀木桌，上面空空如也，好象可以放什么东西。\n");
                set("unit", "张");
    }
 
        setup();
}
        
