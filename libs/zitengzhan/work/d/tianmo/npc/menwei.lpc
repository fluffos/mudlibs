#include <ansi.h>
inherit NPC;

void create()
{
  set_name("门卫", ({"men wei", "wei", "monster"}));
  set("long","一个膀大腰圆的门卫，看上去相貌凶恶，如果没事还是不要惹他了。\n");
  set("gender", "男性");
  set("age", 20+random(15));
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("combat_exp", 130000);
  set_skill("unarmed", 100);
  set_skill("parry", 100);
  set_skill("dodge", 100);
  set_skill("staff", 100);
  set_skill("huomo-dao", 100);
  map_skill("blade", "huomo-dao");
  map_skill("parry", "huomo-dao");

  setup();
  carry_object("/d/obj/weapon/blade/blade")->wield();
  carry_object("/d/obj/armor/tenjia")->wear();
}
void init()
{
  object me;

  ::init();
  if( interactive(me = this_player()) && !is_fighting() ) {
    call_out("greeting", 1, me);
  }
}









