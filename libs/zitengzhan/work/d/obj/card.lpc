//Cracked by wangcy

#include <ansi.h>

inherit ITEM;

int set_number();
void create() {

        set_name(YEL"信用卡"NOR, ({"card", "ka"}));
                set("value",10);
        set_weight(10);
                set("unit", "张");
                set("long", "一张由钱庄开据的信用卡。卡号是:");
                set("no_get",1);
                set("no_give",1);
                set("no_put",1);
                set("no_sell",1);
                set("no_drop",1);
  setup();
}

void init() {
  add_action("do_card","card");
  if(userp(environment())) set_number();
}

int do_card(string arg){
     object ob=this_object();
     if(arg=="on")
     {
     ob->set("stats","on");
     write("你决定购物时使用信用卡。\n");
     return 1;
}
     if(arg=="off")
     {
     ob->set("stats","off");
     write("你决定购物时不使用信用卡。\n");
     return 1;
}
    return 0;
}
int query_autoload() { return 1; }
int set_number(){
   add("long",HIY+environment()->query("card_number")+NOR);
}
