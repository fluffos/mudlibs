// unarmed

#include <weapon.h>

inherit UNARMED;

void create() {
  set_name("拳套", ({ "quantao" }));
  set_weight(4000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "副");
    set("value", 500);
    set("material", "iron");
    set("long", "这是一副精致的拳套，份量大约二、三斤重，");
    set("wield_msg", "$N取出一副制作精良的拳套$n戴在手上。\n");
    set("unequip_msg", "$N将手上的$n收入怀中。\n");
  }
  init_unarmed(25);
  setup();
}
