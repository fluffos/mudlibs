// yunnandrug.c 云南白药

#include <ansi.h>
inherit F_LIQUID;
inherit ITEM;

void setup() {}

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIR "酒心巧克力" NOR, ({ "jiuxin qiaokeli", "qiaokeli", "jiuxin" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "粒");
    set("long", "吃了这个喝酒就醉，不信可以试试。\n");
    set("value", 5000);
    set("no_sell", 1);
    set("drug_type", "良药");
  }
  set("liquid", ([
    "type": "longgong_hot",
    "name": "酒",
    "remaining": 30,
    "drunk_apply": 50,
  ]));
  setup();
}

int do_eat(string arg) {
  if (!id(arg))
    return notify_fail("你要吃什么药？\n");
  if (!find_object("/daemon/condition/drunk.lpc")) call_other("/daemon/condition/drunk.lpc", "???");
  message_vision("$N拿起" + HIR "酒心巧克力" NOR + "往嘴里一丢，乱嚼几下咽了下去。\n", this_player());
  this_player()->set_temp("take/drunk", 1);
  destruct(this_object());
  return 1;
}
