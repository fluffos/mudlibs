inherit COMBINED_ITEM;

void setup()
{}

void init()
{
        add_action("do_eat", "eat");
}

void create()
{
        set_name("超级金创药", ({"chaoji yao", "yao", "chaoji"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("base_unit","包");
                set("unit","些");
                set("long", "这是一包治伤的金创药。\n");
        set_weight(5000);
                set("value", 50000);
                                set("drug_type", "良药");
        }
        set_amount(1);
        setup();
}

int do_eat(string arg)
{
        if (!id(arg))
                return notify_fail("你要吃什么药？\n");
        if ((int)this_player()->query("eff_kee") == 
            (int)this_player()->query("max_kee")&&
            (int)this_player()->query("eff_sen") ==
            (int)this_player()->query("max_sen"))
                return notify_fail("你现在不需要用金创药。\n");
        else {
        this_player()->receive_curing("kee", 1000);
        this_player()->receive_curing("sen", 1000);
                this_player()->add("kee",500);
                this_player()->add("sen",500);
                message_vision("$N吃下一包超级金创药，气色看起来好多了。\n",
                this_player());
                add_amount(-1);
                return 1;
        }
}
