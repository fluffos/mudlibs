// jinchuang.c 金创药

inherit COMBINED_ITEM;

void setup() {}

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name("金创药", ({ "jinchuang yao", "yao", "jinchuang" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("base_unit", "包");
    set("unit", "些");
    set("long", "这是一包治伤的金创药。\n");
    set("value", 100);
    set("drug_type", "良药");
  }
  set_amount(1);
  setup();
}

int do_eat(string arg) {
  object me = this_player();
  if (!id(arg))
    return notify_fail("你要吃什么药？\n");

  else if (this_player()->query("eff_kee") ==
    this_player()->query("max_kee")) {
    write("你现在不需要用金创药。\n");
    return 1;
  } else {
    if (random(25) > 2) {
      // nanf，提高了疗效
      me->receive_curing("kee", me->query("max_kee") / 5);
      message_vision("$N吃下一包金创药，气色看起来好多了。\n", this_player());
    } else {
      message_vision("$N吃下一包金创药，打了个嗝，好像没什么效果，可能过期失效了。\n", this_player());
    }
    if (query_amount() > 1)
      add_amount(-1);
    else destruct(this_object());
    return 1;
  }
}
