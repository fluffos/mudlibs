#include <weapon.h>
inherit AXE;
#include <ansi.h>

void create()
{
	set_name(HIR"狂邪斧"NOR, ({"kuang axe", "axe"}));
	set_weight(150);
	if (clonep())
		set_default_object(__FILE__);
	else 
	{
		set("unit", "把");
		set("long", "上古时代的一把神斧，听说是黄帝和蚩尤大战时遗留下的宝物。\n");
		set("value", 100000);
		set("material", "steel");
		set("no_drop",1);
		set("no_sell",1);
		set("no_steal",1);
		set("no_put",1);
		set("no_give",1);
		set("wield_msg", HIR"$N很费力举起一把$n"HIW"摆出一个视死如归的架势。\n"NOR);
		set("unwield_msg", HIR"$N将$n"HIW"放下，斗斗了手轻松了许多。\n"NOR);
	}
	init_axe(120);
	setup();
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
	int pro;
	int dam;
	dam = (int) me->query("force");
	if ( dam>=2500 ) dam=2500;
	victim->receive_damage("sen",dam/5);
	switch(random(2)) 
	{
		case 0:
			return "$w"HIR"与你合二为一，化斧而去！\n"NOR;
		case 1:
			return "$w"HIR"发出道道的邪光！\n"NOR;
	}        
}

