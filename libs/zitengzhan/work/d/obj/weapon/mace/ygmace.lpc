
#include <weapon.h>
inherit MACE;
#include <ansi.h>

void create()
{
   set_name(HIW"银光锏"NOR, ({"yinguang mace", "mace","yinguang"}));
   set_weight(150);
   if (clonep())
     set_default_object(__FILE__);
   else {
     set("unit", "把");
    set("long", "这是一柄精钢铸成的虎尾鞭，据说是上古时遗留下的宝物。。\n"); 
    set("value", 100000);
     set("material", "steel");
     set("no_drop",1);
     set("no_sell",1);
     set("no_steal",1);
     set("no_put",1);
     set("no_give",1);
    set("wield_msg", "$N从肩上取下一个布袋，解了开来，袋中竟然是$n！\n");
    set("unwield_msg", "$N收起了$n，长吁了一口气道：宝锏果然又显雄风！\n");
   }
   init_mace(120);
   setup();
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
        int pro;
        int dam;
        dam = (int) me->query("force");
        if ( dam>=2500 ) dam=2500;
        victim->receive_damage("sen",dam/5);
       if(me->query_skill("mace",1)<9999)
        me->improve_skill("mace",random(20));
                switch(random(2)) {
                        case 0: return "$w"HIC"发出摄人心魄的光芒！\n"NOR;
                        case 1: return "$w"HIC"发出道道的银芒！\n"NOR;
                      }        
}
