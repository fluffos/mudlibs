#include <ansi.h>
#include <weapon.h>
inherit STAFF;
void create()
{
	set_name( HIY "金刚杵" NOR, ({ "buddhism chu", "staff", "chu"}) );
	set_weight(150);
	if( clonep() )
		set_default_object(__FILE__);
	else
	{
		set("unit", "根");
		set("long", "一根金光闪闪的降魔杵，上面还有些奇怪的纂符。\n");
		set("value", 100000);                   
		set("material", "iorn");
		set("no_drop",1);
		set("no_sell",1);
		set("no_steal",1);
		set("no_put",1);
		set("no_give",1);
		set("wield_msg", "$N大喝一声，从背后的包袱中抽起一根金光闪闪的$n握在手中。\n");
		set("unwield_msg", "$N念了个佛号，将$n放回背后包袱中。\n");
	}
	init_staff(120);
	setup();
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
	int pro;
	int dam;
	dam = (int) me->query("force");
	if ( dam>=2500 ) 
		dam=2500;
	victim->receive_damage("sen",dam/5);
	return HIY "$N手中的$w"+ HIY "发出阵阵耀眼的金光！绕的$n心神不定。\n" NOR;
}
