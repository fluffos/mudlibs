//modify by ken@WH-xyj
#include <ansi.h>
#include <weapon.h>
inherit STAFF;
void create()
{
        set_name( HIY "金刚杵" NOR, ({ "buddhism chu", "staff"}) );
        set_weight(10000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "根");
                set("material", "gold");
//              set("value", 2000000);
                set("value", 100000);
                set("long", "一根金光闪闪的降魔杵，上面还有些奇怪的纂符。\n");
                set("wield_msg", "$N大喝一声，从背后的包袱中抽起一根金光闪闪的$n握在手中。\n");
                set("unwield_msg", "$N念了个佛号，将$n放回背后包袱中。\n");
                set("no_give", "此物乃是佛门至宝，怎能随便送人呢！\n");
           //     set("no_get", "这东西很重，你拿不起来．\n");
               // set("no_get", "掌柜悄悄的对你说道：佛祖的宝贝小的实在是不敢收啊。\n");
                set("no_put", "这么大一个东西，你能丢在那里去？\n");
                    set("no_drop",1);
        }
        init_staff(120);
        setup();
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
        int pro;
        int dam;
        dam = (int) me->query("force");
        victim->receive_damage("kee",dam/50);
       if(me->query_skill("staff",1)<9999)
        me->improve_skill("staff",random(20));
        return HIY "$N手中的"+ HIY"＂金刚杵＂" + HIY "发出阵阵耀眼的金光！绕的$n心神不定。\n" NOR;
}
