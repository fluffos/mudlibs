#include <weapon.h>
inherit STICK;
#include <ansi.h>

void create() {
  set_name(RED "鸳鸯棒" NOR, ({ "yuanyang bang", "stick", "bang" }));
  set_weight(150);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("long", "上古时代的一把神棒，听说是黄帝和蚩尤大战时遗留下的宝物。\n");
    set("value", 100000);
    set("material", "steel");
    set("no_drop", 1);
    set("no_sell", 1);
    set("no_steal", 1);
    set("no_put", 1);
    set("no_give", 1);
    set("wield_msg", RED "$N拿起一根$n" HIW "顺手舞了个棍花。\n" NOR);
    set("unwield_msg", RED "$N将$n" HIW "收了回去。\n" NOR);
  }
  init_stick(120);
  setup();
}
mixed hit_ob(object me, object victim, int damage_bonus) {
  int pro;
  int dam;
  dam = (int)me->query("force");
  if (dam >= 2500)
    dam = 2500;
  victim->receive_damage("sen", dam / 5);
  switch (random(2)) {
    case 0:
      return "$w" WHT "忽然迎风一抖,道出阵阵真气！\n" NOR;
    case 1:
      return "$w" WHT "发出摄人心魄的光芒！\n" NOR;
  }
}
