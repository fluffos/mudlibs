// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

#include <weapon.h>
#include <ansi.h>

inherit UNARMED;

void create() {
  set_name(MAG "安拳套" NOR, ({ "an quantao", "quantao" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一副柔软的拳套，带上打人不手疼．\n");
    set("unit", "副");
    set("value", 100000);
    set("material", "iorn");
    set("no_drop", 1);
    set("no_sell", 1);
    set("no_steal", 1);
    set("no_put", 1);
    set("no_give", 1);
    set("wield_msg", HIW "$N伸手往兜里一摸，拿出两个圆形的东西，套在左右手上，正是一副$n" HIW "！\n" NOR);
    set("unwield_msg", HIW "$N一用力，$n" HIW "撑得粉碎，片片散去。\n" NOR);
  }
  init_unarmed(120);
  setup();
}
mixed hit_ob(object me, object victim, int damage_bonus) {
  int pro;
  int dam;
  dam = (int)me->query("force");
  if (dam >= 2500)
    dam = 2500;
  victim->receive_damage("sen", dam / 5);
  switch (random(2)) {
    case 0:
      return "$w" HIC "忽然弹出，重重砸了开去！\n" NOR;
    case 1:
      return "$w" HIC "前端忽然打开，射出几道暗器！\n" NOR;
  }
}
