#include <weapon.h>
#include <ansi.h>
inherit BLADE;

void create() {
  set_name(HIW "寒意刀" NOR, ({ "hanyi dao", "blade", "dao" }));
  set_weight(150);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "上古时代的一把神刀，听说是黄帝和蚩尤大战时遗留下的宝物。\n");
    set("value", 100000);
    set("material", "steel");
    set("no_drop", 1);
    set("no_sell", 1);
    set("no_steal", 1);
    set("no_put", 1);
    set("no_give", 1);
    set("wield_msg", HIB "$N顺手拿起一把$n" HIW "舞了个刀花。\n" NOR);
    set("unwield_msg", HIW "$N将$n" HIW "放了回去。\n" NOR);
  }
  init_blade(120);
  setup();
}
mixed hit_ob(object me, object victim, int damage_bonus) {
  int pro;
  int dam;
  dam = (int)me->query("force");
  if (dam >= 2500) dam = 2500;
  victim->receive_damage("sen", dam / 5);
  switch (random(2)) {
    case 0:
      return "$w" HIB "突然寒气阵阵,道出条条刀光！\n" NOR;
    case 1:
      return "$w" HIW "发出摄人心魄的光芒！\n" NOR;
  }
}
