#include <weapon.h>
inherit SPEAR;
#include <ansi.h>

void create()
{
	set_name(HIW"霸王枪"NOR, ({"bawang qiang", "spear","qiang"}));
	set_weight(150);
	if (clonep())
		set_default_object(__FILE__);
	else 
	{
		set("unit", "杆");
		set("long", "上古时代的一把神枪，听说是黄帝和蚩尤大战时遗留下的宝物。\n");
		set("value", 100000);
		set("material", "iorn");
		set("no_drop",1);
		set("no_sell",1);
		set("no_steal",1);
		set("no_put",1);
		set("no_give",1);		;
		set("wield_msg", HIB"$N顺手拿起一杆$n。\n"NOR);
		set("unwield_msg", HIW"$N将$n"HIW"放了回去。\n"NOR);
	}
	init_spear(120);
	setup();
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
	int pro;
	int dam;
	dam = (int) me->query("force");
	if ( dam>=2500 ) 
		dam=2500;
	victim->receive_damage("sen",dam/5);
	return "$w"HIW"发出摄人心魄的光芒！\n"NOR;
}
