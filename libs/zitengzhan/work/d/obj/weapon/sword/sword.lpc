#include <weapon.h>
inherit SWORD;
#include <ansi.h>

void create()
{
	set_name(HIC"寒玉剑"NOR, ({"hanyu jian", "sword","jian"}));
	set_weight(150);
	if (clonep())
		set_default_object(__FILE__);
	else 
	{
		set("unit", "把");
		set("long", "上古时代的一把神棒，听说是黄帝和蚩尤大战时遗留下的宝物。\n");
		set("value", 100000);
		set("material", "steel");
		set("no_drop",1);
		set("no_sell",1);
		set("no_steal",1);
		set("no_put",1);
		set("no_give",1);
		set("wield_msg", HIC"$N拿起一把$n"HIW"顺手把剑指向敌人。\n"NOR);
		set("unwield_msg", HIC"$N将$n"HIW"收回了剑鞘。\n"NOR);
	}
	init_sword(120);
	setup();
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
	int pro;
	int dam;
	dam = (int) me->query("force");
	if ( dam>=2500 ) dam=2500;
	victim->receive_damage("sen",dam/5);
	switch(random(2)) 
	{
		case 0: 
			return "$w"HIC"忽然突然飞剑出鞘，自一体攻击！\n"NOR;
		case 1: 
			return "$w"HIC"发出道道的剑气！\n"NOR;
	}        
}

