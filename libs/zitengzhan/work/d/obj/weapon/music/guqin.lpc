#include <weapon.h>

inherit MUSIC;

void create() {
  set_name("古琴", ({ "gu qin", "qin", "music" }));
  set_weight(4000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "架");
    set("value", 500);
    set("material", "iron");
    set("long", "这是一架古色古香的琴，长长的，感觉好象很沉重的样子。\n");
    set("wield_msg", "$N轻轻的从背包里拿出了一架古色古香的$n。\n");
    set("unequip_msg", "$N将手中的$n轻轻的放入了背后的背包。\n");
  }
  init_music(25);
  setup();
}
