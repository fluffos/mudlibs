inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("雪梨", ({"xueli"}));
        set_weight(100);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "一颗雪梨，还是冻梨。\n");
                set("unit", "颗");
                set("value", 100);
                set("food_remaining", 3);
                set("food_supply", 50);
        }
}

