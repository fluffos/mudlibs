inherit NPC;
#include <ansi.h>
string give_migong();

void create()
{
        set_name("书生", ({"shu sheng","sheng"})); 
        set("gender", "男性");
        set("age", 60);
        set("per", 40);
        set("attitude", "peaceful");
        set("inquiry", ([
                "背阴巷" : (:give_migong:),
        ]));
        setup();
}

string give_migong()
{
        object me = this_player();
        if( time()<me->query("in_duanwu")+3600 )
                return "你刚刚进去过，还是休息休息再来。";
        if( me->query("combat_exp")<1000000 )
                return "你修为太低了，还是不要进去了。";
        if( MAZE_D->enter_maze(me, "duanwu") )
        {
                me->set_temp("in_duanwu",time());
                me->set("in_duanwu",time());
                me->set_temp("duanwu_start",environment(me));
        }
        return "...";
}
