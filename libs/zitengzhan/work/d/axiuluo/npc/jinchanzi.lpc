inherit NPC;
#include <ansi.h>
void create() {
  set_name("金婵子", ({ "jinchan zi", "jinchan", "zi" }));
  set("gender", "男性");
  set("age", 3000);
  set("class", "xian");
  set("long", "如来佛祖的弟子，唐三藏的前世，奉命在此看守穷极魔洞。\n");
  set("attitude", "aggressive");
  set("shen_type", 1);
  set("per", 10);
  set("family/family_name", "南海普陀山");
  set("str", 20);
  set("combat_exp", 5000000);
  set("daoxing", 15000000);
  set_skill("literate", 300);
  set_skill("unarmed", 300);
  set_skill("dodge", 350);
  set_skill("parry", 350);
  set_skill("sword", 350);
  set_skill("lunhui-zhang", 350);
  set_skill("spells", 350);
  set_skill("buddhism", 350);
  set("task", 1);
  set_skill("jienan-zhi", 330);
  set_skill("lotusforce", 350);
  set_skill("force", 350);
  set_skill("lotusmove", 350);
  map_skill("spells", "buddhism");
  map_skill("force", "lotusforce");
  map_skill("staff", "lunhui-zhang");
  map_skill("parry", "lunhui-zhang");
  map_skill("dodge", "lotusmove");
  set("force", 6000);
  set("max_force", 6000);
  set("force_factor", 200);
  set("max_kee", 4500);
  set("max_sen", 4500);
  set("mana", 6000);
  set("mana_factor", 250);
  set("max_mana", 6000);
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    //                (: cast_spell, "yinshen" :),
    (: cast_spell, "lianhua" :),
    (: cast_spell, "bighammer" :),
    (: cast_spell, "tianlei" :),
  }));
  setup();
  carry_object("/d/axiuluo/obj/key.lpc");
  carry_object("/d/nanhai/obj/tiezhang.lpc")->wield();
}
void init() {
  add_action("do_none", "perform");
  add_action("do_none", "cast");
  add_action("do_none", "ji");
}
int do_none() {
  object me = this_object();
  message_vision("此乃天界，岂容你乱来？\n", me);
  return 1;
}

void die() {
  object killer, yao;
  killer = query_temp("last_damage_from");
  yao = this_object();
  if (killer->query("xiuluo/jinchanzi") != "done") {
    killer->set("xiuluo/jinchanzi", "done");
    killer->add("daoxing", 80000);
    tell_object(killer, "你赢得了八十年道行!\n");
    message(
      "channel:rumor",
      HIR + "【阿修罗界】金婵子(jinchan zi): 佛祖，不好了！" + killer->query("name") + "已经拿到" HIM "穷极之匙" NOR "了！\n" + NOR,
      users()
    );
  }
  ::die();
}
