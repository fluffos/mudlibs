}

string daoxing(int dx)
{
        
        int day,hour;
        day = (dx) / 4;
        hour = (dx  - day * 4) * 3; 
        return day?(chinese_number(day)+"天"):""+hour?(chinese_number(hour)+"时辰"):"";
}


void announce (object me, string str)
{
  if (DEBUG)
  { 
    object snowcat = find_player ("snowcat");
    if (snowcat && wizardp(snowcat))
      tell_object (snowcat,"◆ "+str+"\n");
  }
  else
  {
    CHANNEL_D->do_channel(me,"chat",str);
  }
}

int recover_death()
{
  object me = this_object();
  object who = this_player();

/*  if (who->query("obstacle/mud_age") > who->query("death/mud_age"))
  {
    message_vision ("$N对$n摇了摇头：老夫未闻死迅也。\n",me,who);
    return 1;
  }*/
  if (!who->query("death"))
  {
    message_vision ("$N对$n摇了摇头：老夫未闻死迅也。\n",me,who);
    return 1;
  }

  if (! who->query("obstacle/reward"))
  {
    message_vision ("$N对$n摇了摇头：你先去西域过关吧。\n",me,who);
    return 1;
  }
  if (who->query("xtqj/haomao") < 1)
  {
    message_vision ("$N对$n摇了摇头：你的救命毫毛已用尽也，请继续努力。\n",me,who);
    return 1;
  }
  who->add("xtqj/jilu",1);
  who->add("xtqj/haomao",-1);
  message_vision ("\n$N拔出一根救命毫毛，佛手一扬……。\n",me);
  message_vision ("\n$N顿觉天悬地转乾坤倒置，刹那间禁不住浑身颤抖！\n",who);
  if(who->query("death/ispk"))
  {
  if (who->query("death/combat_exp_loss"))
  {
    tell_object (who,"你突然发现你的武学只恢复了一部分！\n");
    who->add("combat_exp", (int)who->query("death/combat_exp_loss")/2);
//    who->add_temp("combat_exp", (int)who->query("death/combat_exp_loss")/2);
  }
  if (who->query("death/dx_loss"))
  {
    tell_object (who,"你突然发现你的道行只恢复了一部分！\n");
    who->add("daoxing", (int)who->query("death/dx_loss")/2);
//    who->add_temp("daoxing", (int)who->query("death/dx_loss")/2);
  }
  if (who->query("death/skill_loss") && random(5))
  {
    tell_object (who,"你突然发现你的武功全部恢复了！\n");
    who->skill_death_recover();
  }

  }
else
 {
  if (who->query("death/combat_exp_loss"))
  {
    tell_object (who,"你突然发现你的武学全部恢复了！\n");
    who->add("combat_exp", (int)who->query("death/combat_exp_loss"));
//    who->add_temp("combat_exp", (int)who->query("death/combat_exp_loss"));
  }
  if (who->query("death/dx_loss"))
  {
    tell_object (who,"你突然发现你的道行全部恢复了！\n");
    who->add("daoxing", (int)who->query("death/dx_loss"));
//    who->add_temp("daoxing", (int)who->query("death/dx_loss"));
  }
  if (who->query("death/skill_loss"))
  {
    tell_object (who,"你突然发现你的武功全部恢复了！\n");
    who->skill_death_recover();
  }
}
log_file("RECOVER","["+ctime(time())+"] "+sprintf("%s(%s)使用了救命毫毛.\n",
  who->query("name"),who->query("id")));
  who->delete("death");
  who->save();
  return 1;

}
int reward_haomao()
{
  object me = this_object();
  object who = this_player();

  if (! who->query("obstacle/reward"))
  {
    message_vision ("$N对$n摇了摇头：你先去西域过关吧。\n",me,who);
    return 1;
  }
  if (who->query("xtqj/qweqwe") == 1)
  {
    message_vision ("$N对$n摇了摇头：毫毛我不是已经给你了吗？\n",me,who);
    return 1;
  }
  who->add("xtqj/qweqwe",1);
  if(who->query("xtqj/haomao")>=500)
  {
  message_vision ("$N对$n摇了摇头：你这么多毛了，还是贡献出来吧。\n",me,who);
  return 1;
 }
 else{
  who->add("xtqj/haomao",3);
  message_vision ("\n如来佛祖拔出三根救命毫毛来给了你……。\n",me);
  message_vision ("\n$N顿觉天悬地转乾坤倒置，刹那间禁不住浑身颤抖！\n",who);
}
  return 1;

}


void die()
{
  if (environment())
    message("sound", "\n\n如来缓缓一点头：佛法无边！\n\n", environment());

  set("eff_kee", 10000);
  set("eff_gin", 10000);
  set("eff_sen", 10000);
  set("kee", 10000);
  set("gin", 10000);
  set("sen", 10000);
  set("force", 10000);
  set("mana", 10000);
}

void unconcious()
{
  die ();
}

void destroy(object ob)
{
  destruct(ob);
  return;
}


int accept_object(object who,object ob)
{
              if( ob->query("id")=="qiankun-tu" )
  {
        if (who->query("obstacle/number") < 26){
        command("say 你还是先去取经吧!");
        return 0;}

       if ( (string)who->query("xiuluo/jinchanzi") != "done"){
       command("say 这图是你的吗?");
       return 0;}

       if ( (string)who->query("xiuluo/tu") != "done"){
       command("say 这图是你的吗?!");
       return 0;}

       if ( (string)who->query("xiuluo/jiemen") != "done"){
       command("say 这图是你的吗?!!");
              return 0;}

            else
                { command("u&me " + who->query("id"));
                  command("chat "+who->query("name")+"你居然如此胆大妄为！\n");
                  command("chat 看来你多年修成的正果只有白费了！\n");
                  tell_object(who,"\n如来佛大袖朝你一拂...\n\n你好象已经忘记了以前的记忆。\n\n");
                  command("rumor 听说"+who->query("name")+"被如来佛祖毁了西天修行！");
                  who->delete("obstacle");
                  who->delete("kill_tree");
                  who->delete("xtqj/qweqwe");
                  who->delete_temp("obstacle");
                  who->delete_temp("wudidong");
                  who->delete("xiuluo/tu");
		          who->delete("xiuluo/jinchanzi");
		          who->delete("xiuluo/jiemen");
			call_out("destroy", 1, ob);              
                  
                  who->save();  
                  return 1;
        }
            }
        else {
              this_object()->command("sigh");
        say("如来佛:这可不是我想要的东西阿。\n");
              return 0;
              }
}


string do_job()
{
    int n,t;
    object ob,npcts;
    string where;
    ob=this_player(); 

/*
    if(!ob->query_temp("lmud"))
	return "目前本任务仅对LMUD用户开放,请使用LMUD客户端 ！\n";
*/
    
    if(t=(int)ob->query("dajiu/time_start"))
    {
     if(t<=time() && time()<t+180) {
		command("heng");
//		message_vision("$N对$n说道：唐僧师徒目前正在取经途中,没有遇险 ！\n",this_object(),ob);
	        return "唐僧师徒目前正在取经途中,没有遇险 ！\n";
	    }
    }    

    npcts=new(__DIR__"shaheshang");
    if( !npcts )  return "你先下去休息休息。"; //add by snowtu for debug
    ob->set("dajiu/time_start", time());
    where=npcts->invocation(this_player(),query("place"));
//    npcts->set("master",ob->query("name"));
    npcts->set_temp("dajiu_id",ob->query("id"));
    ob->set_temp("asked",0);
    command("pat "+ob->query("id"));
    return "唐僧师徒西天取经途中在"+where+"遇险,你去帮帮他们吧。\n";
   
}

string do_give()
{
	int bonus;
	string where;  
	object ob,cart;
     	int dh,pot,wx,money,yb;

	  ob=this_player();

  if ( !ob->query_temp("dajiudone"))
    return "你任务完成了么？\n";

  ob->delete_temp("dajiudone"); 
  
  if(!ob->query_temp("lmud")) bonus=1000;
 else bonus=0;
wx = random(2000)+2500-bonus;
    dh = random(1000)+2000-bonus;
    pot = random(1000)+800-bonus/2;
//  money = random(100000)+50000;

  ob->add("combat_exp",wx);
  ob->add("daoxing",dh);
  ob->add("potential",pot);    
//  ob->add("balance",money);
  message("channel:rumor",HIY"【搭救唐僧】如来佛(Rulai fo)："+ob->name()+"帮助唐僧师徒团圆，得到了"+daoxing(dh)+"道行、"+chinese_number(wx)+"点武学经验得奖励！\n"NOR,users());

  command("pat "+ob->query("id"));
  return "做得不错！";
}
