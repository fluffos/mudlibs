#include <ansi.h>
#include <armor.h>
inherit WRISTS;
void create() {
  set_name(HIY "黄金护肩" NOR, ({ "golden waists", "waists" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("material", "gold");
    set("unit", "双");
    set("value", 200000);
    set("no_sell", 1);
    set("no_drop", 1);
    set("no_sell", 1);
    set("armor_prop/armor", 55);
    //    set("armor_prop/spells", 30);
    set("armor_prop/armor_vs_force", 400);
    set("need_level", 2);
  }
  setup();
}
