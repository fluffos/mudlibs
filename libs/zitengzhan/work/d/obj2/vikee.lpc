                           	if (objectp(ob)) 
                            {
                            ob->move(who);
                            who->add("faith",-10);
				tell_object(who,"你用10点门派忠诚度向首席长老换取了一件"+ob->query("name")+"！\n");
                               }
				break;
			case "pifeng":
