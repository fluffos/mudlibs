
#include <ansi.h>

inherit NPC;

void create()
{
	set_name(""HIY"首席长老"NOR"", ({"shouxi zhanglao", "zhanglao"}));
	set("long", "这是一位首席长老，负责门派内的各种奖励,你可以(list)查看想要的东西。\n");
	set("gender", "男性");
	set("age", 20);
	set("per", 40);
	set_skill("literate", 141);
	set("chat_chance",5);
    set("chat_msg", ({
        "首席长老轻声告诉你：你可以用list指令列出想要的东西！\n",
        "首席长老轻声告诉你：你可以用yao指令向我索取装备道具。\n",
        }));
	setup();
	carry_object("/d/obj/cloth/magua")->wear();
}
void init()
{
	::init();
  add_action("do_fight", "fight");
  add_action("do_kill", "kill");
  add_action("do_steal", "steal");
  add_action("do_cast", "cast");
  add_action("do_ji","ji");
  add_action("do_throw","throw");
  add_action("do_list","list");
  add_action("do_yao","yao");
}

void die()
{
 return;
}

int do_fight(string arg)
{
  object who = this_player();
  object me = this_object();

  if (arg && present(arg,environment(who))==me)
  {
	message_vision("$N看样子想打架，但首席长老很有涵养,不和$N动粗。\n",who,me);
     return 1;
  }
  return 0;
}

int do_kill(string arg)
{
  object who = this_player();
  object me = this_object();

  if (arg && present(arg,environment(who))==me)
  {
message_vision("$N看样子想杀死首席长老，但首席长老是文化人,没跟$N一般见识。\n",who,me);

    return 1;
  }
  return 0;
}

int do_cast(string arg)
{
  object who = this_player();
  object me = this_object();

  message_vision("$N对着首席长老结结巴巴的念了几句咒语，自己都感觉难听死了。\n",who,me);

  return 1;
}


int do_steal(string arg)
{
  object who = this_player();
  object me = this_object();

  message_vision("$N想偷东西，但总是有贼心没贼胆。\n",who,me);

  return 1;
}


int do_ji(string arg)
{
  object who = this_player();
  object me = this_object();

  message_vision("$N想对首席长老祭法宝，前思后想，还是没敢。\n",who,me);

  return 1;
}

int do_throw(string arg)
{
  object who = this_player();
  object me = this_object();

  message_vision("$N掏出暗器，看了看首席长老，信心不足，又把暗器收了起来。\n",who,me);

  return 1;
}

int do_list(string arg)
{
       object who = this_player();
	object me = this_object();
  message("vision",""HIG"\n────────────────普—通—道—具────────────────
          \n"HIC"盔甲：(每件10点门忠）"HIY"
          1. 连环锁子黄金(armor)   2. 黄金披风(pifeng)   3.黄金狮子盾(shield)
          4. 黄金头盔(kui)         5. 黄金战袍(cloth)    6.黄金战靴(shoes)
          7. 黄金要带(waist)       8. 黄金护肩(waists)   9.黄金手套(hand)
          10.黄金指环(finger)     11. 黄金护胸(neck)
          \n"HIC"丹药："HIY" 
          1.金疮药(jcyao)"HIG"   【1点门忠：100包】"HIY"2. 混元丹(hydan)"HIG"  【1点门忠：100包】"HIY" 
          3.护身云丹(yundan)"HIG"【20点门忠：1颗】"HIY" 4. 超级猕猴桃(tao)"HIG" 【10点门忠：1颗】"HIY" 
          \n"HIC"道具："HIY" 
          1.月光宝盒(he)"HIG"    【10点门忠：1个】"HIY" 2. 初级护身符(pass)"HIG"【5点门忠：1张】"HIY"
          3.中级护身符(pass1)"HIG"【10点门忠：1张】"HIY"4. 高级护身符(pass2)"HIG"【15点门忠：1张】"HIY"
          5.超级护身符(pass3)"HIG"【20点门忠：1张】"HIY"
"HIG"\n───────────────────────────────────────────\n"NOR"",who,me);
if (query("family/family_name") == "南海普陀山") 
 {
message("vision",""HIG"\n────────────────法—宝—兑—换───────────────────
         \n"HIC"法宝："HIY" 
         1.禁箍咒(jingu1)"HIG"    【5点门忠：1个】"HIY" 2. 金箍咒(jingu2)"HIG"【15点门忠：1个】"HIY"
         3.紧箍咒(jingu3)"HIG"    【100点门忠：1个】"HIY"
         "HIR"★ 说明：禁箍咒可使用20次，金箍咒可使用100次，紧箍咒可使用1000次。
"HIG"\n───────────────────────────────────────────\n"NOR"",who,me);
   }
if (query("family/family_name") == "月宫") 
 {
message("vision",""HIG"\n────────────────法—宝—兑—换───────────────────
         \n"HIC"法宝："HIY" 
         1.宠物蛋(egg)"HIG"    【100点门忠：1个】
         "HIR"★ 说明：宠物蛋需配合月光神术使用。
"HIG"\n───────────────────────────────────────────\n"NOR"",who,me);
   }
if (query("family/family_name") == "五庄观") 
 {
message("vision",""HIG"\n────────────────法—宝—兑—换───────────────────
         \n"HIC"法宝："HIY" 
         1.八卦符(bagua)"HIG"    【10点门忠：1个】
         "HIR"★ 说明：施展奇门遁甲阵的必备之物。
"HIG"\n───────────────────────────────────────────\n"NOR"",who,me);
   }

  return 1;
}

int do_yao(string arg)
{
	string type;
	object ob;
	object who=this_player();
        if (who->query("family/family_name")!=query("family/family_name"))
              return notify_fail("你不是本门中人，怎能给你! \n");
    if (!arg)
		return notify_fail("你想要什么？盔甲？丹药？还是道具？(比如:yao armor)\n");
	else 
	{
		sscanf(arg,"%s",type);
			switch(type)
			{
			//盔甲
			case "armor":
                           if (who->query("faith")<10)
                            return notify_fail("你对本门有过贡献吗？ :P\n");
