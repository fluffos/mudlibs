//create by huarong 2004/7
#include <ansi.h>
#include "valid_kill.h";

inherit F_CLEAN_UP;
void do_shengjian(object, object);
int main(object me, string arg) {
  object obj, weapon;
  string callname;
  object *inv;
  int i;

  if (me->query_temp("12gong/shengjian") != "done" && !wizardp(me))
    return notify_fail("没有修罗的传授,你如何会用圣剑?\n");

  if (!me->query_temp("canuseshengjian"))
    return notify_fail("无论你如何努力，都感受不到右臂中圣剑的存在。\n");

  if (!wizardp(me) && environment(me)->query("no_fight"))
    return notify_fail("这里不准战斗。\n");

  if (!arg)
    return notify_fail("你想对谁用圣剑？\n");

  if (!objectp(obj = present(arg, environment(me))))
    return notify_fail("这里没有这个人。\n");

  if (userp(obj))
    return notify_fail("你想对玩家下毒手?\n");

  if (!obj->is_character() || obj->is_corpse())
    return notify_fail("看清楚一点，那并不是活物。\n");

  if (obj == me)
    return notify_fail("用 suicide -f指令会比较快:P。\n");

  if (obj->query("age") <= 16 && userp(obj))
    return notify_fail("用圣剑对付小孩子，你太没人性了!\n");

  callname = RANK_D->query_rude(obj);

  message_vision("\n$N对着$n喝道：「"
    +callname + "！看我的绝招[圣剑]！」\n\n", me, obj);

  inv = all_inventory(obj);
  i = sizeof(inv);

  me->delete_temp("canuseshengjian");

  if (obj->query("id") == "hai jiangjun" && obj->query("name") == "克修拉") {
    obj->delete_temp("goldspear");
    for (int k = 0; k < i; k++) {
      if (inv[k]->query("name") == HIY "黄金枪" NOR && inv[k]->query("id") == "golden spear") {
        obj->set_temp("goldspear", 1);
        weapon = inv[k];
        break;
      }
    }
    if (obj->query_temp("goldspear")) {
      message_vision(HIC "$N小宇宙随之爆发,举起右手,犹如一把利剑向$n的黄金枪斩来!\n\n" NOR, me, obj);
      message_vision(MAG "            【　　　　                         \n" NOR, me);
      message_vision(
        MAG "　　  ◎■■■■】〓〓" + HIY + "圣" + NOR + MAG + "〓〓〓〓" + HIY + "剑" + NOR + MAG + "〓〓》　         \n" NOR,
        me
      );
      message_vision(MAG "            【　                               \n" NOR, me);
      message_vision(HIM + BLINK + "\n\n\t\t\t\t王 者 之 剑\n\n" NOR, me);
      message_vision(HIG + "\n\n“当”的一声，$n手中的黄金枪已段为两截！\n\n" NOR, me, obj);
      weapon->unequip();
      weapon->move(environment(obj));
      weapon->set("name", "断掉的" + weapon->query("name"));
      weapon->set("value", 0);
      weapon->set("weapon_prop", 0);
      weapon->set("armor_prop", 0);
      call_out("remove_broken_weapon",
        random(300) + 60, weapon);
      obj->set("dienumber", 2);
      obj->reset_action();
      obj->die();
      return 1;
    } else {
      message_vision(HIC "$N小宇宙随之爆发,举起右手,犹如一把利剑向$n的黄金枪斩来!\n\n" NOR, me, obj);
      message_vision(MAG "            【　　　　                         \n" NOR, me);
      message_vision(
        MAG "　　  ◎■■■■】〓〓" + HIY + "圣" + NOR + MAG + "〓〓〓〓" + HIY + "剑" + NOR + MAG + "〓〓》　         \n" NOR,
        me
      );
      message_vision(MAG "            【　                               \n" NOR, me);
      message_vision(HIM + BLINK + "\n\n\t\t\t\t王 者 之 剑\n\n" NOR, me);
      message_vision(HIG + "\n\n———————————————————————————————————\n" NOR, me);
      message_vision(HIG + "\n一道凌厉的剑光滑过，$N的七个星命点被全部击中！\n\n" NOR, obj, me);
      obj->set("dienumber", 3);
      obj->die();
      return 1;
    }
  }

  do_shengjian(me, obj);

  return 1;
}

void do_shengjian(object me, object obj) {
  object ob;
  me->kill_ob(obj);
  if (!userp(obj)) {
    if (!obj->accept_kill(me))
      obj->kill_ob(me);
  } else {
    obj->fight_ob(me);
    tell_object(obj, HIR "" + me->name() + "对你使用了[圣剑]\n" NOR);
  }
  message_vision(HIC "$N小宇宙随之爆发,举起右手,犹如一把利剑向$n斩来!\n\n" NOR, obj, me);
  message_vision(MAG "            【　　　　                         \n" NOR, me);
  message_vision(
    MAG "　　  ◎■■■■】〓〓" + HIY + "圣" + NOR + MAG + "〓〓〓〓" + HIY + "剑" + NOR + MAG + "〓〓》　         \n" NOR,
    me
  );
  message_vision(MAG "            【　                               \n" NOR, me);
  message_vision(HIM + BLINK + "\n\n\t\t\t\t王 者 之 剑\n\n" NOR, me);
  if (obj->query_temp("weapon")) {
    ob = obj->query_temp("weapon");
    ob->unequip();
    ob->set("value", 0);
    message_vision(HIW "只听见「啪」地一声，$N手中的" + obj->name() + "已经断为两截！\n" NOR, obj);
    ob->set("name", "断掉的" + ob->query("name"));
    ob->set("weapon_prop", 0);
    ob->set("armor_prop", 0);
    ob->move(environment(obj));
    call_out("remove_broken_weapon", random(300) + 60, ob);
  } else {
    message_vision(HIY "只见一道金色的剑光滑过，$N已被圣剑击中！\n" NOR, obj);
    obj->unconcious();
  }
  me->delete_temp("12gong/shengjian");
}

