//rewrited by huarong 2004/7
#include <ansi.h>
inherit NPC;
#include "/d/shengdoushi/7hai/star.h"
int rank_me();

void create() {
  set_name("艾尔扎克", ({ "hai jiangjun", "hai", "jiangjun", }));
  set("gender", "男性");
  set("age", 20);
  set("title", HIY "海将军" HIW "-" HIC "魔鬼鱼" NOR);
  set("long", "他是守护北冰洋之柱的海斗士。\n");
  set("combat_exp", 15000000);
  set("daoxing", 15000000);
  set("attitude", "peaceful");
  set("force", 15000);
  set("max_force", 7500);
  set("force_factor", 200);
  set("max_mana", 7500);
  set("mana", 15000);
  set("mana_factor", 200);
  set_skill("literate", 350);
  set_skill("dodge", 350);
  set_skill("force", 350);
  set_skill("parry", 350);
  set_skill("unarmed", 350);
  set_skill("sword", 350);
  set_skill("dragonforce", 350);
  set_skill("westsword", 350);
  set_skill("balei", 350);
  set_skill("boxing", 350);
  set_skill("baiyang", 350);
  map_skill("sword", "westsword");
  map_skill("parry", "westsword");
  map_skill("dodge", "balei");
  map_skill("unarmed", "boxing");
  map_skill("spells", "baiyang");
  map_skill("force", "dragonforce");
  set("max_kee", 15000);
  set("max_sen", 15000);
  add("armor_prop/armor", 400);
  add("armor_prop/dodge", 200);
  setup();
  carry_object("/d/shengdoushi/7hai/bby/obj/linyi")->wear();
}

void destruct_me(object me) {
  destruct(me);
}
void unconcious() {
  die();
}

void die() {
  object me = this_object();
  object ob = query_temp("last_damage_from");
  call_out("haihuang_appearing", 1, ob);
  load_object("/obj/empty");
  me->move("/obj/empty");
  call_out("destruct_me", 3, me);
}
void haihuang_appearing(object who) {
  object haihuang = new("/d/shengdoushi/7hai/bby/npc/haihuang");

  haihuang->announce_success(who);
  destruct(haihuang);
}

void init() {
  add_action("do_none", "perform");
  add_action("do_none", "cast");
  add_action("do_none", "ji");
  add_action("do_none", "burn");
  add_action("do_none", "tianlong");

}
int do_none() {
  object me = this_object();
  message_vision("$N冷笑一声：这里是我的管区，我说了算！！！\n", me);
  return 1;
}

int accept_fight(object ob) {
  object me = this_object();
  command("say 闲杂人等，在此骚扰，杀无赦！");
  me->kill_ob(ob);
  return 1;
}

void check() {
  object ob = this_object();
  object me = query_temp("my_killer");
  if (!present(me, environment())) {
    remove_call_out("check");
    return;
  }
  if (me->is_ghost()) {
    remove_call_out("check");
    return;
  }

  switch (random(2)) {
    case 0:
      {
        message_vision(HIM "$N：魔鬼鱼的咆哮！\n", ob, me);
        message_vision(HIW + "\n\n\t\t\t " + BLINK + "冰神拳 \n\n" NOR, me);
        if (random(2)) {
          message_vision(HIR "$N被凌厉的冻气扫了个正着！\n" NOR, me);
          me->add("eff_kee", -query("max_kee") / 15);
          me->add("eff_sen", -query("max_sen") / 15);
          me->apply_condition("ice_poison", 10);
        } else
          message_vision(HIG "$N躲过了$n的攻击！\n" NOR, me, ob);
      }
      break;

    case 1:
      {
        message_vision(HIC "$N：尝尝魔鬼鱼最强之拳吧！\n\n\n", ob, me);
        message_vision(HIW + "\t*＿＿＿＿＿＿＿＿＿＿＿＿＿*\n" NOR, me);
        message_vision(HIW + "\t*￣￣￣￣￣￣￣￣￣￣￣￣￣*\n" NOR, me);
        message_vision(HIW + "\t\t " + BLINK + "寒冷的极光  \n" NOR, me);
        message_vision(HIW + "\t*＿＿＿＿＿＿＿＿＿＿＿＿＿*\n" NOR, me);
        message_vision(HIW + "\t*￣￣￣￣￣￣￣￣￣￣￣￣￣*\n" NOR, me);
        if (random(2)) {
          message_vision(HIR "$N为对方迅速、华丽的招式惊得目瞪口呆，被打了个正着！\n" NOR, me);
          me->add("eff_kee", -query("max_kee") / 10);
          me->add("eff_sen", -query("max_sen") / 10);
        } else
          message_vision(HIG "$N一个鲤鱼翻身，躲过了$n的攻击！\n" NOR, me, ob);
      }
      break;
  }


  if (random(8) > 5)
    powerup();

  remove_call_out("check");
  call_out("check", 5 + random(2));
}
