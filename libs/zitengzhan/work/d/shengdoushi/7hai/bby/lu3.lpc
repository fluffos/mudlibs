inherit ROOM;

void create() {
  set("short", "小路");
  set("long", @LONG

    连接海底神殿和各海支柱的小路。

LONG);


  set("exits", ([ /* sizeof() == 2 */
    "southwest": __DIR__ "lu2",
    "northeast": __DIR__ "zhizhu",

  ]));

  set("no_fly", 1);
  setup();
}

void init() {
  if (!this_player()->query("7hai/nby"))
    set("exits/northeast", "/d/shengdoushi/7hai/nby/lu2");
  else
    set("exits/northeast", __DIR__ "zhizhu");
}
