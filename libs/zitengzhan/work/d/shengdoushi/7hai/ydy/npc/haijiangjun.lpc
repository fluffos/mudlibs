#include <ansi.h>
inherit NPC;
#include "/d/shengdoushi/7hai/star.h"
int rank_me();

void xiuluo(object me);
void xiuluo2(object me);
void xiuluo3(object me);
void xiuluo4(object me);
void xiuluo5(object me);
void xiuluo6(object me);
void xiuluo7(object me);

void create()
{
        set_name("克修拉", ({"hai jiangjun","hai","jiangjun",}));
        set("gender", "男性" );
        set("age", 20);
        set("per", 20);
        set("title",HIY"海将军"HIW"-"HIC"海皇子"NOR);
        set("long", "他是守护印度洋之柱的海斗士。\n");
        set("combat_exp", 15000000);
        set("daoxing",15000000);
        set("attitude", "peaceful");
        set("force", 15000);
        set("max_force", 7500);
        set("force_factor", 200);
        set("max_mana", 7500);
        set("mana", 15000);
        set("mana_factor", 200);
        set_skill("literate", 350);
        set_skill("dodge", 350);
        set_skill("force", 350);
        set_skill("parry", 350);
        set_skill("unarmed", 350);
        set_skill("sword", 350);
        set_skill("spear", 350);
        set_skill("bawang-qiang",350);
        set_skill("dragonforce",350);
        set_skill("westsword",350);
	set_skill("balei",350);
	set_skill("kaitian-zhang",350);
        set_skill("baiyang", 350);
        map_skill("sword","westsword");
        map_skill("spear","bawang-qiang");
	map_skill("parry","westsword");
	map_skill("dodge","balei");
        map_skill("unarmed","kaitian-zhang");
        map_skill("spells","baiyang");
        map_skill("force","dragonforce");
        set("max_kee", 15000);
        set("max_sen", 15000);
        add("armor_prop/armor", 400);
        add("armor_prop/dodge", 200);
        setup();
        carry_object("/d/shengdoushi/7hai/ydy/obj/linyi")->wear();
        carry_object("/d/shengdoushi/7hai/ydy/obj/qiang")->wield();
}

void destruct_me (object me)
{
  destruct (me);
}

void unconcious()
{
die ();
}

int accept_fight(object ob)
{       
     object me=this_object();
     command("say 闲杂人等，在此骚扰，杀无赦！");
     me->kill_ob(ob);
     return 1;
}

void die ()
{
  object me = this_object();
  object ob = query_temp("last_damage_from");

 if(me->query("dienumber") > 2)
  {
  message_vision(HIC"$N喃喃道：了不起啊，"+ob->query("name")+"......\n",me,ob);
  message_vision(HIC"“噗”的一声，"+me->query("name")+"倒下了。\n",ob);
  call_out ("haihuang_appearing",1,ob);
  load_object("/obj/empty");
  me->move("/obj/empty");
  ob->delete_temp("canuseshengjian");
  call_out ("destruct_me",3,me);
  }
 else if(me->query("dienumber")==2)
  {
  message_vision(CYN"克修拉：竟然把我的黄金枪折断......\n");
  message_vision(CYN"   "+ob->query("name")+"，你折断了我这黄金枪，反而引发了我的斗气！\n",ob);
  message_vision(CYN"    唤醒了我克修拉体内的宇宙能源————般若五行！\n",ob);
  message_vision(CYN"    接近我的人只有死，攻击我的任何招式都将会反弹！\n",ob);
  message_vision(YEL"克修拉的身体竟然漂浮于空中！\n",ob);
  ob->delete_temp("canuseshengjian");
  powerup();	
  me->set_temp("fantan",1);		
  }
 else if(me->query("dienumber")==1)
  {
  powerup();	
  }
 else
  {
  me->add("dienumber",1);
  powerup();
  }

}

void haihuang_appearing (object who)
{
  object haihuang = new ("/d/shengdoushi/7hai/ydy/npc/haihuang");

  haihuang->announce_success (who);
  destruct (haihuang);
}

void init()
{
        add_action("do_none","perform");
        add_action("do_none","cast");
        add_action("do_none","ji");
        add_action("do_none","burn");
        add_action("do_none","tianlong");

}

int do_none()
{
        object me = this_object();
        message_vision("$N冷笑一声：这里是我的管区，我说了算！！！\n",me);
        return 1;
} 

void xiuluo(object me)
{
    message_vision(YEL"\n战斗中，你的意识渐渐模糊......\n\n"NOR,me);
    remove_call_out("check");
    call_out("xiuluo2",1,me);
}

void xiuluo2(object me)
{
    message_vision(CYN"\n修罗说道：丧失斗志了吗？"+me->query("name")+"！\n"NOR,me);
    message_vision(CYN"\n          这一点都不像你！你不是说，你自己是最忠诚的圣斗士吗？\n"NOR,me);
    message_vision(CYN"\n          "+me->query("name")+"，别忘了你的伟大使命！\n"NOR,me);
    message_vision(CYN"\n          在我死之前已经把我的一切都传授给你了！\n\n"NOR,me);
    call_out("xiuluo3",1,me);
}

void xiuluo3(object me)
{
    message_vision(CYN"\n          “一只黄金枪又算得了什么？！\n"NOR,me);
    message_vision(CYN"\n          你得右臂中藏有我的灵魂......n"NOR,me);
    message_vision(CYN"\n          还有......\n\n"NOR,me);
    message_vision(HIC"\n                  圣剑\n\n"NOR,me);
    call_out("xiuluo4",1,me);
}

void xiuluo4(object me)
{
    message_vision(YEL"\n          想着想着，你又重新振作了起来.....\n"NOR,me);
    call_out("check",5);
}

void xiuluo5(object me)
{
    message_vision(CYN"\n克修拉说道：任何攻击都是徒劳的......\n"NOR,me);
    call_out("xiuluo6",1,me);
}

void xiuluo6(object me)
{
    message_vision(CYN"\n            除非你能一次击中我所有的星命点。\n"NOR,me);
    call_out("xiuluo7",1,me);
}

void xiuluo7(object me)
{
    message_vision(CYN"\n            但是......"+me->query("name")+"，这有可能吗？\n"NOR,me);
    me->set_temp("canuseshengjian",1);
}


void check()
{
        object ob=this_object();
        object me=query_temp("my_killer");
        int i,effkee,maxkee;
        
     if(! present(me,environment()) )
     {
     remove_call_out("check");
     return;
     }
     if( me->is_ghost() )
     {
     remove_call_out("check");
     return;
     }

    effkee=me->query("eff_kee");
    maxkee=me->query("max_kee");
    
    if (  effkee < maxkee/2 )
    {
      if( ob->query("dienumber")==1 )	
       {
          if( ob->query_temp("add_xiuluo")>3)
    	  {
    	    me->start_busy(10);
    	    ob->start_busy(10);
            message_vision(CYN"突然，$N耳边响起了一个声音：“怎么了？"+me->query("name")+"。”\n"NOR,me);
            message_vision(CYN"$N定睛一看，正是魔羯星座————"+HIY+"修罗"+NOR+CYN+"！\n",me);
            ob->delete_temp("add_xiuluo");
            me->set_temp("canuseshengjian",1);
            call_out("xiuluo",1,me);
    	  }
    	  ob->add_temp("add_xiuluo",1);
       }
      if( ob->query("dienumber")==2 )	
       {
          if( ob->query_temp("add_xiuluo2")>3)
    	  {
    	    me->start_busy(10);
    	    ob->start_busy(10);
            message_vision(CYN"$N受了般若五行强烈光芒的照射，眼前一切变得模糊了！\n"NOR,me);
            me->set_temp("canuseshengjian",1);
            ob->delete_temp("add_xiuluo2");
            call_out("xiuluo5",1,me);
    	  }
    	  else
    	  {
    	  ob->add_temp("add_xiuluo2",1);
    	  }       	
       }
    }
   if(ob->query("dienumber")<2)
    {    
     switch(random(3))
     {        
        case 0:
        {
        message_vision(HIC"$N大喝一声：\n",ob,me);
        message_vision(HIY+"\n\t\t\t"+BLINK+"黄  金  枪\n"NOR,me);
        message_vision(HIY+"
                         /\\     
                        (  )
                   /\\    )(    /\\
                  (  )  (  )  (  )
                   )(   /  \\   )( 
                  (  )  |  |  (  )
                   \\  ︶    ︶  /
                   ╰—┐  ┌—╯\n"NOR,me);
message_vision(HIB+"                        ██\n"NOR,me);
message_vision(HIR+"                        ‖‖
                        ‖‖
                        ‖‖
                        ‖‖
                        ‖‖
                        ‖‖
                        ‖‖
                        ‖‖
                        ‖‖
                        ‖‖
                        ‖‖
                        ‖‖
                        ‖‖
                        ‖‖
                        ‖‖
                        ‖‖
                        ╚╝  \n"NOR,me);
message_vision(HIB+"                         ◎  \n"NOR,me);


        if(random(2))        
                {
                 message_vision(HIR"尽管$N左突右闪，却始终不能逃脱枪尖的追捕！\n"NOR,me);
                 message_vision(HIR"“噗”的一声，已被刺中，鲜血直流！\n"NOR,me);
                 me->add("eff_kee",-query("max_kee")/10);
                 me->add("eff_sen",-query("max_sen")/10);
                }
        else
        message_vision(HIG"$N左突右闪，狼狈的躲过了$n的攻击！\n"NOR,me,ob);
        }
        break;


        case 1:
        {
        message_vision(HIC"$N：尝尝海皇子的绝招吧！\n"NOR,ob,me);
        message_vision(HIM+BLINK+"\n\t\t\t雷霆四面伏击\n"NOR,me);
        message_vision(HIC"\n无数只枪尖如同下雨一般向$N刺来！\n"NOR,me);

        if(random(2))
                {
               i=random(4)+1; 
               message_vision(HIR"$N一个不留神，已然中"+HIY+chinese_number(i)+HIR+"枪！\n"NOR,me);
               me->add("eff_kee",-i*query("max_kee")/30);
               me->add("eff_sen",-i*query("max_sen")/30);
                }
        else
        message_vision(HIG"$N看准方向，纵身跃起，躲过了枪雨！\n"NOR,me);
        }
        break;

      }
     }
//        if( random(7) > 5 )
//        powerup();

        remove_call_out("check");
        call_out("check",6+random(2));
}
