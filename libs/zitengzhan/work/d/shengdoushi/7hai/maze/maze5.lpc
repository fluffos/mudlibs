#include <room.h>
inherit ROOM;
#include <ansi.h>

string *ways = ({
  "/d/shengdoushi/7hai/maze/mazea",
  "/d/shengdoushi/7hai/maze/mazeb",
  "/d/shengdoushi/7hai/maze/mazec",
  "/d/shengdoushi/7hai/maze/mazed",
  "/d/shengdoushi/7hai/maze/mazee",
});

void create()
{
set("short", HIB"深海"NOR);
set("long", @LONG

海水又变的清澈了，但你已经很难找到方向了。    
不过四周的风景倒是很好，要是有一条美人鱼
做伴就好了。dream~~~

LONG );


