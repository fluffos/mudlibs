  "west"    : ways[random(sizeof(ways))],
  "east"    : ways[random(sizeof(ways))],
  "north"   : ways[random(sizeof(ways))],
  "south"   : ways[random(sizeof(ways))],
  "southeast"   : ways[random(sizeof(ways))],
  "northeast"   : ways[random(sizeof(ways))],
  "northwest"   : ways[random(sizeof(ways))],
  "southwest"   : __DIR__"maze6",
]));

