//rewrited by huarong 2004/7
#include <ansi.h>
inherit NPC;
#include "/d/shengdoushi/7hai/star.h"
int rank_me();
int do_shoot();
int do_shoot2(object me);
int do_shoot3(object me);
int do_shoot4(object me);
int do_shoot5(object me);
int do_shoot6(object me);
int do_shoot7(object me);
int do_shoot8(object me);

void create()
{
        set_name(HIC"波士顿"NOR, ({"hai huang","hai","king",}));
        set("gender", "男性" );
        set("age", 20);
        set("title",HIY"海皇"NOR);
        set("long", "他是掌管七海的海皇。\n"); 
        set("combat_exp", 20000000);
        set("daoxing",20000000);
        set("attitude", "peaceful");
        set("force", 18000);
        set("max_force", 9000);
        set("force_factor", 200);
        set("max_mana", 9000);
        set("mana", 18000);
        set("mana_factor", 400);
        set_skill("literate", 400);
        set_skill("dodge", 400);
        set_skill("force", 400);
        set_skill("parry", 400);
        set_skill("unarmed", 400);
        set_skill("spear", 400);
        set_skill("dragonforce",400);
        set_skill("dragonfight",400);
        set_skill("bawang-qiang",400);
	set_skill("balei",400);
	set_skill("boxing",400);
        set_skill("baiyang", 400);
        map_skill("spear","bawang-qiang");
	map_skill("parry","bawang-qiang");
	map_skill("dodge","balei");
        map_skill("unarmed","dragonfight");
        map_skill("spells","baiyang");
        map_skill("force","dragonforce");
        set("max_kee", 20000);
        set("max_sen", 20000);
        add("armor_prop/armor", 400);
        add("armor_prop/dodge", 200);
        setup();
        carry_object("/d/shengdoushi/7hai/shendian/obj/shenyi")->wear();
        carry_object("/d/shengdoushi/7hai/shendian/obj/qiang")->wield();
}

void renma(object me)
{
    message_vision(YEL"\n原来...是艾俄洛斯的灵魂命令圣衣来帮助你了...\n\n"NOR,me);
    message_vision(YEL"\n赶紧穿上圣衣，拿好黄金弓箭，然后射击（shoot）敌人吧！\n\n"NOR,me);
//    call_out("renma2",1,me);
}

void destruct_me (object me)
{
  destruct (me);
}
void unconcious()
{
die ();
}

void die ()
{
  object me = this_object();
  object ob = query_temp("last_damage_from");
  call_out ("haihuang_appearing",1,ob);
  load_object("/obj/empty");
  me->move("/obj/empty");
  call_out ("destruct_me",3,me);
}
void haihuang_appearing (object who)
{
  object haihuang = new ("/d/shengdoushi/7hai/shendian/npc/haihuang");

  haihuang->announce_success (who);
  destruct (haihuang);
}

void init()
{
	object ob=this_object();
        add_action("do_none","perform");
        add_action("do_none","cast");
        add_action("do_none","ji");
        add_action("do_none","burn");
        add_action("do_none","tianlong");
        add_action("do_shoot","shoot");
        ob->set_temp("fantan",1);
         if ( this_player()->query_temp("7hai/renma") )
            {
               if ( !this_player()->query_temp("7hai/shoot") )
                add_action("do_shoot","shoot");
               else 
                add_action("do_shoot8","shoot");
                
                add_action("do_noshoot","noshoot");
            }                      
}

int do_none()
{
        object me = this_object();
        message_vision("$N冷笑一声：这里是我的管区，我说了算！！！\n",me);
        return 1;
} 

void check()
{
        object ob=this_object();
        object shengyi;
        object me=query_temp("my_killer");
        int i,effkee,maxkee;
        
     if(! present(me,environment()) )
     {
     remove_call_out("check");
     return;
     }
     if( me->is_ghost() )
     {
     remove_call_out("check");
     return;
     }

    effkee=me->query("eff_kee");
    maxkee=me->query("max_kee");
    
    if (  effkee < maxkee/2 )
    {
    	  if( ob->query_temp("add_renma")>5)
    	  {
    	    me->start_busy(5);
    	    ob->start_busy(5);
            message_vision(CYN"突然，一股强大的小宇宙冲进了神殿！\n"NOR,me);
            message_vision(CYN"$N定睛一看，正是"+HIY+"射手座黄金圣衣"+NOR+CYN+"！\n",ob,me);
            me->set_temp("7hai/renma",1);
            shengyi=new("/d/shengdoushi/12gong/obj/rm_cloth");
            shengyi->move(me);
            me->remove_all_killer();
    	    ob->delete_temp("add_renma");
            call_out("renma",1,me);
    	  }
    	  ob->add_temp("add_renma",1);
    }

        remove_call_out("check");
        call_out("check",5+random(2));
}

int do_shoot()
{
        object me = this_player();
        message_vision(HIY"$N身上黄金圣衣闪闪发光！\n"NOR,me);
        message_vision(HIY"$N张弓搭箭，瞄准波士顿的头部！\n"NOR,me);
        call_out ("do_shoot2",3,me);
//        return notify_fail(HIY"$N张弓搭箭，瞄准波士顿的头部！\n"NOR,me);
        return 0;
} 

int do_shoot2(object me)
{
        message_vision(HIY"“嗖”的一声，黄金箭直奔波士顿！\n"NOR,me);
        call_out ("do_shoot3",3,me);
} 

int do_shoot3(object me)
{
        object ob=this_object();
        int i,j;
        i=(me->query("combat_exp",1)+me->query("daoxing",1))/2000;
        
        if (i>20000) i=20000;
        if (i<8000) i=8000;
        j=random(i);
           
     if (j>6000)
       {
        message_vision(HIY"“啪”的一声，波士顿的头盔被黄金箭射中，掉落在地上！\n\n"NOR,me);
        me->set_temp("7hai/shoot",1);
        call_out ("do_shoot4",3,me);       	      	
       }
     else
       {
        message_vision(HIR"不料黄金箭在波士顿面前转了个弯，直向$N自己飞去！\n\n"NOR,me);
        me->add("eff_kee",-2*me->query("eff_kee")/3);
        me->add("eff_sen",-2*me->query("eff_sen")/3);
        COMBAT_D->report_status(me);
       }
} 

int do_shoot4(object me)
{
        message_vision(HIM"\n\n波士顿突然恢复了以前的"+HIY+"朱里安·索罗"+HIM+"：\n"NOR,me);
        message_vision(HIM"“咦？怎么我在这里啊？我在这里干什么呀？”\n\n"NOR,me);
        call_out ("do_shoot5",3,me);
} 

int do_shoot5(object me)
{
	object yu;
        message_vision(CYN"\n\n$N张弓搭箭，正要再次瞄准波士顿的头部......\n"NOR,me);
        message_vision(CYN"“不要啊！”，一个急促的声音传进了$N的耳朵。\n"NOR,me);
        message_vision(CYN"$N定睛一看，来者正是"+HIY+"美人鱼"+HIG+"狄蒂丝"+NOR+CYN+"...\n\n"NOR,me);  
        yu=new("/d/shengdoushi/7hai/shendian/npc/yu");
        yu->move(environment(me));
        yu->command("say 朱里安...");
        message_vision(HIG+"\n\n狄蒂丝"+NOR+CYN+"跪倒在$N面前，眼泪在眼眶里面打转转...\n\n"NOR,me);        
        yu->command("say 求求你，不要杀他。");
        call_out ("do_shoot6",3,me);
} 

int do_shoot6(object me)
{
        message_vision(YEL"\n\n【话外音】"+WHT+"天狼星：波士顿将要恢复意识...\n"NOR,me);
        message_vision(WHT"                  如果恢复的话，后果将会不堪设想。\n"NOR,me);
        message_vision(WHT"                  你必须在30秒之内做出选择！\n\n"NOR,me);

        message_vision(YEL"【话外音】"+WHT+"天狼星：我建议你还是放箭（shoot）吧！\n\n"NOR,me);
        
        message_vision(MAG"这个时候突然又蹦出来个声音————\n\n"NOR,me);
        message_vision(YEL"【话外音】"+WHT+"宝宝猪：难道你真的忍心杀死美人鱼心爱的朱里安吗？！\n"NOR,me);
        message_vision(WHT"                  难道你真的想拆散他们吗？\n\n"NOR,me);
        message_vision(YEL"【话外音】"+WHT+"宝宝猪：我建议你还是不要放箭（noshoot）吧！\n\n"NOR,me);
        me->set_temp("shoot_countdown", 30);       
        me->start_busy( (: call_other, this_object(), "slow_shoot" :) );
//        call_out ("slow_shoot",0,me);
} 

int slow_shoot(object me)
{       
        int stage;
        stage = me->query_temp("shoot_countdown");
        me->add_temp("shoot_countdown", -1);
        if( stage > 1 ) {
                if( stage%5 == 0 )
                  tell_object(me, HIR "你还有 " + stage + " 秒的时间可以选择："
                          +"\n\t→1.shoot。\n\t→2.noshoot。\n这一刻世界掌握在你的手中！\n\n\n" NOR);
                return 1;
        }
        call_out ("do_shoot7",3,me);
}

int do_shoot7(object me)
{
        message_vision(HIM"你30秒之内没有做出决定，这个时候波士顿恢复了神的意识...\n"NOR,me);
        message_vision(CYN"波士顿捡起了头盔，拍了拍灰尘...然后戴上\n"NOR,me);
        message_vision(CYN"波士顿：你竟敢对神不敬————\n\n"NOR,me);
        me->start_busy(0);
        me->delete_temp("7hai/shoot");
        message_vision(HIR"波士顿目露凶光，杀机骤起！随后眼睛猛地一眨！\n\n"NOR,me);
        me->add("eff_kee",-2*me->query("eff_kee")/3);
        me->add("eff_sen",-2*me->query("eff_sen")/3);
        COMBAT_D->report_status(me);
        this_object()->kill_ob(me);
} 

