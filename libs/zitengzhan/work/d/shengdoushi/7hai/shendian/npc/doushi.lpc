inherit NPC;

void create() {
  set_name("海斗士", ({ "hai doushi", "doushi" }));
  set("long", "守护海界的海斗士。\n");
  set("gender", "男性");
  set("per", 10);
  set("str", 20);
  set("max_kee", 8000);
  set("max_sen", 8000);
  set("attitude", "heroism");
  set("combat_exp", 8000000 + random(4000000));
  set("daoxing", 8000000 + random(4000000));
  set("force", 10000);
  set("max_force", 5000);
  set("force_factor", 200);
  set("max_mana", 5000);
  set("mana", 10000);
  set("mana_factor", 200);
  set_skill("literate", 200);
  set_skill("dodge", 200);
  set_skill("force", 200);
  set_skill("parry", 200);
  set_skill("unarmed", 200);
  set_skill("sword", 200);
  set_skill("dragonforce", 200);
  set_skill("westsword", 200);
  set_skill("balei", 200);
  set_skill("boxing", 200);
  set_skill("baiyang", 200);
  map_skill("sword", "westsword");
  map_skill("parry", "westsword");
  map_skill("dodge", "balei");
  map_skill("unarmed", "boxing");
  map_skill("spells", "baiyang");
  map_skill("force", "dragonforce");
  add("armor_prop/armor", 100);
  add("armor_prop/dodge", 50);
  setup();
  carry_object("/d/shengdoushi/7hai/shendian/obj/linyi")->wear();
