
#include <armor.h>
#include <ansi.h>
#include <weapon.h>
inherit ARMOR;


void create()
{
        set_name(HIY"神衣"NOR, ({"shen yi", "armor"}));
        set_weight(30000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
		set("long", "一件神的圣衣．\n");
                set("material", "steel");
                set("value", 10000);
                set("armor_prop/armor", 100);
        }
        setup();
}
int query_autoload() { return 1; }

