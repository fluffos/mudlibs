#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create() {
  set_name(HIM "美人鱼磷衣" NOR, ({ "lin yi", "yi", "skirt" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("material", "cloth");
    set("unit", "件");
    set("value", 100);
    set("armor_prop/armor", 25);

  }
  setup();
}
