//rewrited by huarong 2004/7
#include <ansi.h>
inherit NPC;
#include "/d/shengdoushi/7hai/star.h"
int rank_me();

void create()
{
        set_name("巴尔安", ({"hai jiangjun","hai","jiangjun",}));
        set("gender", "男性" );
        set("age", 20);
        set("per", 23);
        set("title",HIY"海将军"HIW"-"HIC"海马"NOR);
        set("long", "他是守护北太平洋之柱的海斗士。\n");
        set("combat_exp", 15000000);
        set("daoxing",15000000);
        set("attitude", "peaceful");
        set("force", 15000);
        set("max_force", 7500);
        set("force_factor", 300);
        set("max_mana", 7500);
        set("mana", 15000);
        set("mana_factor", 300);
        set_skill("literate", 350);
        set_skill("dodge", 350);
        set_skill("force", 350);
        set_skill("parry", 350);
        set_skill("unarmed", 350);
        set_skill("sword", 350);
        set_skill("westsword",350);
	set_skill("balei",350);
	set_skill("boxing",350);
        set_skill("baiyang", 350);
        map_skill("sword","westsword");
	map_skill("parry","westsword");
	map_skill("dodge","balei");
        map_skill("unarmed","boxing");
        map_skill("spells","baiyang");
        set("max_kee", 12000);
        set("max_sen", 12000);
        add("armor_prop/armor", 400);
        add("armor_prop/dodge", 200);
        setup();
        carry_object("/d/shengdoushi/7hai/btpy/obj/linyi")->wear();
}

void destruct_me (object me)
{
  destruct (me);
}
void unconcious()
{
die ();
}

void die ()
{
object me = this_object();
 object ob = query_temp("last_damage_from");
 call_out ("haihuang_appearing",1,ob);
 load_object("/obj/empty");
  me->move("/obj/empty");
  call_out ("destruct_me",3,me);
}
void haihuang_appearing (object who)
{
  object haihuang = new ("/d/shengdoushi/7hai/btpy/npc/haihuang");
  haihuang->announce_success (who);
  destruct (haihuang);
}

void init()
{
        add_action("do_none","perform");
        add_action("do_none","cast");
        add_action("do_none","ji");
        add_action("do_none","burn");
        add_action("do_none","tianlong");

}
int do_none()
{
        object me = this_object();
        message_vision("$N冷笑一声：这里是我的管区，我说了算！\n",me);
        return 1;
} 

int accept_fight(object ob)
{       
     object me=this_object();
     command("say 闲杂人等，在此骚扰，杀无赦！");
     me->kill_ob(ob);
     return 1;
}

void check()
{
        object ob=this_object();
        object me=query_temp("my_killer");
    
     if(! present(me,environment()) )
     {
     remove_call_out("check");
     return;
     }
     if( me->is_ghost() )
     {
     remove_call_out("check");
     return;
     }
      
     switch(random(3))
     {        
        case 0:
        {
        message_vision(HIC"$N高举双手，分舞出一个大圆！\n",ob,me);
        message_vision(HIC"$N被周围像深海一般的压力压得喘不过气来。\n",me);
        message_vision(HIB+"\n\t\t\t⊙ "+BLINK+"神 压 拳"+NOR+HIB+" ⊙\n\n"NOR,me);
        if(random(2))        
                {
                 message_vision(HIR"紧接着，$N双臂一震，将$n击飞！\n"NOR,ob,me);
                 me->add("eff_kee",-query("max_kee")/30);
                 me->add("eff_sen",-query("max_sen")/30);
                }
        else
        message_vision(HIG"$N轻而易举的躲过了$n的攻击！\n"NOR,me,ob);
        }
        break;


        case 1:
        {
        message_vision(HIC"突然之间，海波骤起，四周海水窜动，气浪、海浪将$N包围住！\n"NOR,me);
        message_vision(HIC"$N：尝尝海马最强绝招吧！\n"NOR,ob,me);
        message_vision(HIM+BLINK+"\n\t\t\t旋  巨  拳\n"NOR,me);
        message_vision(HIM+BLINK+"\t\t\t  风  浪  \n\n"NOR,me);

        if(random(2))

                {
              message_vision(HIR"$N突然从$n面前出现，单手一掷，将$n抛入空中！\n"NOR,ob,me);
              me->add("eff_kee",-query("max_kee")/15);
              me->add("eff_sen",-query("max_sen")/15);
                }
        else
        message_vision(HIG"$N看准方向，纵身跃起，躲过这致命一击！\n"NOR,me);
        }
        break;

      }

        if( random(7) > 4 )
        powerup();

        remove_call_out("check");
        call_out("check",4+random(2));
}
