#include <ansi.h>
#include <weapon.h>
inherit F_UNIQUE;
inherit SWORD;

void create()
{
        set_name(HIY "魔笛"NOR, ({ "mo di","di"}));
        set_weight(7000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "只");
                set("long", HIW"海魔女的武器，魔笛。\n"NOR);
                set("value", 1000000);
                set("no_sell",1);
	        set("replace_file", "/d/obj/weapon/sword/yudi");
                set("no_drop", 1);
                set("no_put", 1);
                set("material", "crimsonsteel");
                set("wield_msg", HIC"$N凌空一指，变出了$n"+HIC+"握在手中。\n"NOR);
                set("unwield_msg", "$N把$n向海中抛去，$n消失了。\n");
                set("music/type", "xiao");
        }
        init_sword(70);
        setup();
}
