void invite() {
  object me = this_player();
  object oldp;
  int num;
  num = me->query_temp("12gong/tiaozhan", 1);

  oldp = find_player(all_biao[num]["id"]);

  if (!oldp) {
    write("咦？这个人死哪儿去了？\n");
    return;
  } else {
    oldp->set_temp("12gong/asked_tiaozhan", 1);
    oldp->set_temp("12gong/yingzhan_man", me);
    tell_object(
      oldp,
      HIR "\n你耳边传来" + HIY + "雅典娜" + HIR + "的声音：\n有人在挑战你" + all_biao[num]["title"] + HIY + "黄金圣斗士" + HIR + "的位置，限你在一分钟之内马上给出答复(yingzhan)！\n\n" NOR
    );
    message(
      "channel:chat",
      HIB + "【" + HIG + "圣域传说" + HIB + "】" + HIY + "雅典娜(Athena)：" + HIG + me->query("name") + HIC + "向" + NOR + all_biao[num]["title"] + HIY + "黄金圣斗士" + HIW + oldp->query("name") + HIC + "发出挑战！" + NOR + "\n\n",
      users()
    );
    call_out("check_yingzhan", 60, me, oldp);
    return;
  }
  me->delete_temp("12gong/tiaozhan");
  return;
}

void check_yingzhan(object me, object target) {
  int num = me->query_temp("12gong/tiaozhan", 1);
  num = num + 1;
  if (target->query_temp("12gong/in_tiaozhan")) return 0;
  if (target->query_temp("12gong/asked_tiaozhan")) {
    tell_object(
      target,
      HIR "你耳边传来" + HIY + "雅典娜" + HIR + "的声音：你自动放弃了本次" + HIY + "黄金圣斗士" + HIR + "的职位！\n\n" NOR
    );
    write(CYN "你耳边传来" + HIY + "雅典娜" + NOR + CYN + "的声音：" + target->query("name") + "不敢应战，你可以重新申请职位了。(apply)\n\n" NOR);
    me->set_temp("can_cancel", 1);
    me->command("cancel " + num);
    me->delete_temp("can_cancel");
    //              tell_object(find_player("huarong"),HIM+"num="+num+"\n"NOR);
    me->delete_temp("12gong/tiaozhan");
    target->delete_temp("12gong/asked_yingzhan");
  }
}

int help() {
  write("
        英雄榜记录着夺得黄金圣斗士称号的玩家名字，而且在这里可以拿到黄金圣衣。
        如想看英雄榜就 " + HIR + "view" + NOR + " ；如想拿圣衣" + HIR + " getarmor" + NOR + "；如想取得各种圣斗士称号" + HIR + " read " + NOR + "。

        silver 可被授予" + HIW + "白银圣斗士" + NOR + "。
        sea    可被授予" + HIB + "海洋圣斗士" + NOR + "。
        bronze 可被授予" + HIC + "青铜圣斗士" + NOR + "。
        dark   可被授予" + WHT + "黑暗圣斗士" + NOR + "。
        各种圣斗士名称不可兼得。

        成功闯过黄道十二宫的玩家可以在此申请黄金圣斗士称号
        命令格式  apply  <1-12>     例如申请狮子座： apply 5
        如果你所申请称号暂缺，则可以申请。
        如果你所申请称号的原玩家任职超过" + HIR + "10天" + NOR + "，则可以申请。
        每个玩家只能申请一个黄金圣斗士称号。

        榜上有名的黄金圣斗士可以取得盔甲防御力" + HIR + "一百五十点" + NOR + "的黄金圣衣(getarmor)。
        其它玩家只要闯过十二宫也可以取得防御力" + HIR + "一百点" + NOR + "的黄金圣衣(getarmor)。
        是否具有拿取圣衣的权利，" + HIR + "以英雄榜记载为准" + NOR + "。

        巫师可随意拿取圣衣，可随意申请称号，但不上英雄榜。
        命令 cancel <1-12> 可以删除一条英雄榜内容。(巫师专用)
        \n");
  return 1;
}
