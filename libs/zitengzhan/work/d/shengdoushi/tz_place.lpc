//create by huarong 2004/7
inherit ROOM;
#include <ansi.h>
string *banned_ji=({"seal","huicheng","fu"});
string *banned_cast=({"escape","tuoqiao","chuqiao","qiankun","huodun","jieti","tudun","shuidun","yinshen","sheqi","townportal"});
string *banned_action=({"practice","exercise","meditate","xiudao","learn","study","read","bian","quit","accept","fly","surrender","burn"});

void create ()
{
  set ("short", HIY"圣地"NOR);
  set ("long", @LONG
这里是圣斗士决斗的场所。
LONG);
  set("no_quit",1);
  set("no_flee",1);
  set("alternative_die",1);
  seteuid(getuid());
  setup();
}


void init ()
{
    add_action("do_quit",banned_action);
    add_action("do_cast",({"cast","perform","exert"}));
    add_action("do_ji","ji");
    add_action("do_kill", "kill");
}

int do_quit(string arg) {
  write("你不能在这里用这条命令。\n");
  if (wizardp(this_player())) write("巫师请参阅同一路径内的banned.h文档。\n");
  return 1;
}

int do_cast(string arg) {
    if(!arg) return 0;
    while(sscanf(arg,"%s %*s",arg)==2);
    if(member_array(arg,banned_cast)==-1) return 0;
    write("请勿使用"+arg+",多谢合作。\n");
    return 1;
}

int do_ji(string arg)
{
      object me = this_object();
      if(!arg) return 0;
      while(sscanf(arg,"%s %*s",arg)==2);
      if(member_array(arg,banned_ji)==-1) return 0;
        write("请勿使用回城符，多谢合作。\n");
      return 1;

}
void alternative_die (object me)
{
          object ob;
          string str;
	  int num;
	  num="/d/shengdoushi/tz_place"->query_temp("12gong/tiaozhan",1);

	  me->set("kee", 1);
	  me->set("sen", 1);
	  me->set("eff_kee",me->query("max_kee"));
	  me->set("eff_sen",me->query("max_sen"));
	  me->remove_all_killer();
	  all_inventory(environment(me))->remove_killer(me);
	  ob = me->query_temp("last_damage_from");
	  
	  if (! ob)
	    return;  
	  
	  if(!userp(ob)){
		destruct (ob);
		return ;
		}
	  if(!userp(me)){
		destruct (me);
		return ;
		}
	  
	  
	  if(!me->query_temp("12gong/tiaozhan")&&!me->query_temp("12gong/asked_tiaozhan"))
	       return;
	  message_vision ("\n$N重重地摔倒在地。\n",me);
	  message_vision ("\n$N慢慢从地上爬将起来。\n",me);

          set_temp("12gong/tz_loser",me);	  
          set_temp("12gong/tz_winner",ob);

          "/d/shengdoushi/bang.lpc"->do_apply2(num);
                    	  
	  me->delete_temp("12gong/tiaozhan");
	  ob->delete_temp("12gong/asked_tiaozhan");
          me->delete_temp("12gong/in_tiaozhan");
          ob->delete_temp("12gong/in_tiaozhan");
          delete_temp("12gong");	  
	}

int do_kill(string arg)
      {
         object who = this_player();
         object me = this_object();
         object ob;
        if(!arg || !objectp(ob = present(arg, environment(who))))
            return  1;
       
         if (ob->query_temp("12gong/tiaozhan")&&who->query_temp("12gong/asked_tiaozhan")) return 0;
     tell_object(me,"你没有在挑战中，不能在这里杀人！\n"NOR);
     return 1;
}

