inherit ROOM;

void create() {
  set("short", "台阶");
  set("long", @LONG

 通向教皇厅的台阶。
 
LONG);

  set("exits", ([
    "southdown": __DIR__ "rose1",
    "northup": __DIR__ "rose3",
  ]));
  set("outdoors", 1);

  setup();
}

void init() {
  add_action("do_fly", "fly");
}
int do_fly(string arg) {
  object me;
  me = this_player();

  message_vision("只见$N向上一飞，突然重重地摔了下来。\n", me);
  tell_object(me, "看样子在圣域里真是插翅难飞……\n");
  return 1;
}
