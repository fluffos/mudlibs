// by 九天(take)
inherit NPC;
string ask_cloth();
#include <ansi.h>
int bangpai();
int sevenhai();
int cike(object me);
int cike2(object me);

void create() {
  set_name(HIY "雅典娜" NOR, ({ "athena", "yadian na", "nv shen" }));
  set("title", HIY "女神" NOR);
  set("long", @LONG

LONG);
  set("gender", "女性");
  set("age", 20);
  set("attitude", "peaceful");
  set("per", 100);  //means no rong-mao description.
  set("max_kee", 12000);
  set("max_gin", 14000);
  set("max_sen", 12000);
  set("force", 12000);
  set("max_force", 24000);
  set("force_factor", 500);
  set("max_mana", 14000);
  set("mana", 28000);
  set("mana_factor", 600);
  set("combat_exp", 20000000);
  set("daoxing", 20000000);
  set_skill("spells", 900);
  set_skill("buddhism", 900);
  set_skill("unarmed", 900);
  set_skill("jienan-zhi", 900);
  set_skill("dodge", 900);
  set_skill("lotusmove", 900);
  set_skill("parry", 900);
  set_skill("force", 900);
  set_skill("lotusforce", 900);
  set_skill("staff", 900);
  set_skill("lunhui-zhang", 900);
  map_skill("spells", "buddhism");
  map_skill("unarmed", "jienan-zhi");
  map_skill("dodge", "lotusmove");
  map_skill("force", "lotusforce");
  map_skill("parry", "lunhui-zhang");
  map_skill("staff", "lunhui-zhang");
  set("no_get", "在雅典娜的神殿里,你怎敢对女神不敬?\n");
  set("chat_chance_combat", 90);
  set("inquiry", ([
    "圣斗士": (: bangpai :),
    "shengdoushi": (: bangpai :),
    "7hai": (: sevenhai :),
  ]));
  setup();
  carry_object("/d/shengdoushi/12gong/obj/armor")->wear();
  carry_object("/d/shengdoushi/12gong/obj/cloth")->wear();
  carry_object("/d/shengdoushi/12gong/obj/pifeng")->wear();
  carry_object("/d/shengdoushi/12gong/obj/shield")->wear();
  carry_object("/d/shengdoushi/12gong/obj/staff")->wield();
}

int bangpai() {
  object who = this_player();
  if (who->query("partys/party_name") == "黄道十二宫") {
    command("say 你已经加入圣斗士了！");
    return 1;
  } else if (who->query_temp("12gong/cike") == "done") {
    command("say 大胆刺客，还不束手就擒！");
    return 1;
  } else {
    if (who->query("12gong/shendian") != "done") {
      command("say 做人要厚道，还是一步一个脚印经受磨练吧。");
      return 1;
    }
    who->delete("partys");
    who->set("partys/party", "【圣斗士】");
    who->set("partys/job", "黄道十二宫");
    who->set("partys/party_name", "黄道十二宫");
    who->set("12gong/banghui", "yes");
    command("chat " + HIW + who->query("name") + "成为雅典娜的圣斗士！");
    command("say 恭喜你成为圣斗士！");
    if (who->query("12gong/number") >= 12 && !who->query("12gong/all") && who->query("12gong/shendian") == "done") {
      who->set("12gong/all", 1);
      who->add("daoxing", 100000);
      who->add("potential", 150000);
      who->add("data_watch_exp", 100000);
      who->save();
      command("say 你得到了一百年道行，15万点潜能！");
    }
    return 1;
  }
  return 1;
}

int sevenhai() {
  object who = this_player();
  if (this_player()->query("partys/party_name") == "黄道十二宫") {
    command("say 十二宫其实是对你的一个考验！如今......");
    call_out("cike", 1, who);
  }
  return 1;
}

int cike(object me) {
  message_vision(HIB "\n话间，出现一个黑影，双手一挥，将" + HIY + "雅典娜" + HIB + "虏走......\n\n\n" NOR, me);
  message_vision(HIB "眨眼之间，飞至半空之中，一回手......\n\n\n" NOR, me);
  me->start_busy(4);
  call_out("cike2", 3, me);
}

int cike2(object me) {
  message_vision(HIW "一道寒光驰过，你觉得头上一凉......\n\n\n" NOR, me);
  me->unconcious();
  me->move("/d/shengdoushi/12gong/haibian");
  destruct(this_object());
}
