#include <ansi.h>
inherit NPC;
#include "star.h"
int rank_me();

void create()
{
        set_name(HIR"教皇"NOR, ({"jiao huang","jiaohuang",}));
        set("gender", "男性" );
        set("age", 28);
        set("per", 35);        
        set("title",HIY"圣域的统制者"NOR);
        set("long", "他是拥有双重性格的男人。\n");
        set("combat_exp", 5500000);
        set("attitude", "peaceful");
        set("force", 11000);
        set("max_force", 5500);
        set("force_factor", 200);
        set("max_mana", 7000);
        set("mana", 14000);
        set("mana_factor", 300);
        set_skill("dodge", 350);
        set_skill("force", 350);
        set_skill("parry", 350);
        set_skill("unarmed", 350);
        set_skill("sword", 350);
        set_skill("westsword",350);
        set_skill("boxing",350);
        set_skill("balei",350);
        set_skill("spells",350);
        set_skill("shuangzi", 350);
        map_skill("sword","westsword");
        map_skill("unarmed","boxing");
        map_skill("spells","shuangzi");
        map_skill("dodge","balei");
        set("max_kee", 5000);
        set("max_sen", 5000);
        add("armor_prop/armor", 300);
        add("armor_prop/dodge", 200);
        add("armor_prop/parry", 100);
        setup();
        carry_object(__DIR__"obj/shuangzi")->wear();
        carry_object(__DIR__"obj/knife")->wield();
}

void init()
{
        add_action("do_none","perform");
        add_action("do_none","cast");
        add_action("do_none","ji");
        add_action("do_none","tianlong");
}
int do_none()
{
        object me = this_object();
        message_vision("$N冷笑一声：在我$N面前，你想耍什么花样？\n",me);
        return 1;
} 

void check()
{
        object ob=this_object();
        object me=query_temp("my_killer");
        if( ! me ) return ;

        if( ! me ) return ;
   if(! present(me,environment()) )
     {
     remove_call_out("check");
     return;
     }                            

     switch(random(4))
     {        
        case 0:
        {
        message_vision(HIC"$N"+HIC+"释放出小宇宙"+HIY+"[异次元空间]"+HIC+"，一阵狂风呼啸而起！\n",ob,me);

        if(random(3)==0)

                {
              message_vision(HIR"$N被卷进异次元空间，毫无半点力量！\n"NOR,me);
              me->add("eff_kee",-2*query("max_kee")/10);
              me->add("eff_sen",-2*query("max_sen")/10);
                }
        else
        message_vision(HIG"$N在风中旋转着，借助风的力量继续作战！\n"NOR,me);
        }
        break;


        case 1:
        {

        message_vision(HIC"$N"+HIC+"咆哮一声：\n\n\t\t"+HIW+"〓教〓皇〓粉〓星〓拳〓"+HIC+"\n\n一道闪电劈向$n！\n",ob,me);

        if(random(3)==0)

                {
              message_vision(HIR"$N被闪电劈了个正着，直电的头皮发麻！\n"NOR,me);
              me->add("eff_kee",-3*query("max_kee")/10);
              me->add("eff_sen",-3*query("max_sen")/10);
                }
        else
        message_vision(HIG"$N早就看清了闪电的方向，轻轻一闪，躲开了。\n"NOR,me);
        }
        break;

        case 2:
        {

        message_vision(HIC"$N"+HIC+"单手一指\n\n\t"+HIM+"—————————————幻胧魔皇拳————————————"+HIC+"\n\n一道利光射向$n！\n",ob,me);

        if(random(3)==0)

                {
              message_vision(HIR"一道寒光穿过了$N的大脑！\n"NOR,me);
              me->add("eff_kee",-query("max_kee")/10);
              me->add("eff_sen",-query("max_sen")/10);
              me->start_busy(2+random(1));
                }
        else
        message_vision(HIG"$N早就看清了寒光的方向，轻轻一闪，躲开了。\n"NOR,me);
        }
        break;

        case 3:
        {
        command("throw knife on "+me->query("id"));
        }
        break;

    }
        if( random(10) > 4 )
        powerup();

        remove_call_out("check");
        call_out("check",2+random(3));
}

int accept_fight(object ob)
{       
     object me=this_object();
     command("say 闲杂人等，在此骚扰，杀无赦！");
     me->kill_ob(ob);
     return 1;
}


void destruct_me (object me)
{
  destruct (me);
}
void unconcious()
{
die ();
}

void die ()
{
  object me = this_object();
  object ob = query_temp("last_damage_from");
  object who=query_temp("my_killer");
  int i;
  if (who->query("12gong/shendian") == "done")
     {
      destruct(me);
      return;
     }
  i = random(600);
  who->set("12gong/shendian","done");
  who->add("daoxing",i+10000);
  command("chat "+HIY+who->query("name")+HIC"★决战！雅典娜神殿！"NOR);

  if (!me->query_temp("12gong/cike"))
  command("chat "+HIY+who->query("name")+HIC"成功救出女神雅典娜！"NOR);
  tell_object (who,"你赢得了"+chinese_number(10)+"年"+
               chinese_number(i/4)+"天"+
               chinese_number((i-(i/4)*4)*3)+"时辰的道行！\n");
  who->save();
  destruct(me);
}


