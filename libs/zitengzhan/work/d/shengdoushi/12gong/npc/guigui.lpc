inherit NPC;
#include "star.h"
int sevenhai();

string *dirs = ({
	"北",
	"南",
	"东",
	"西",
	"东北",
	"西北",
	"东南",
	"西南",
});

string *yes = ({
	"north",
	"northeast",
	"west",
	"southeast",
	"north",
	"southwest",
	"east",
	"northwest",
	"south",
});

void create()
{
        set_name("贵鬼", ({"gui gui", "gui"}));
        set("long", "背天称黄金圣衣箱子的小孩子。鼻子特零，闻着美人鱼的味道找到的7海入口。穆的学生。 \n");
        set("gender","男性");
        set("title", "小孩子");
        set("age",10);
        set("attitude", "friendly");
        set("con",30);
        set("per",30);
        set("str",25);
        set("int",35);
        set("combat_exp",100000);
        set("daoxing",2600000);

          set_skill("dodge", 100);
          set_skill("force", 100);
          set_skill("parry", 100);
          set_skill("unarmed", 100);
          set_skill("sword", 100);
          set_skill("westsword",100);
          set_skill("boxing",100);
          set_skill("baiyang", 100);
          set_skill("yaofa", 100);
          map_skill("sword","westsword");
          map_skill("unarmed","boxing");
          map_skill("spells","yaofa");
          set("max_force", 1000);
          set("force", 2000);
          set("max_mana",1000);
          set("mana",2000);
          set("mana_factor",50);
          set("force_factor", 50);
          set("max_kee", 1000);
          set("max_gin", 1000);
          set("max_sen", 1000);
          set("inquiry",([
                "7hai":(:sevenhai:),
              ]));        
          setup();
        carry_object(__DIR__"obj/by_cloth")->wear();
}
 

int sevenhai()
{
  object me=this_player();
  object ob=this_object();
  message_vision(HIY"\n$N说到：我闻到了美人鱼的味道拉！我带你去吧！follow me!\n"NOR,ob,me);	
  remove_call_out("yinlu");
  call_out("yinlu", 10, ob,me,0);
  return 1;
}

void yinlu (object ob,object me,int k)
{
  string str;
  int i,j=3,n=3;
  
    if (k<9) 
     {
        for (i=0;i<3;i++)
        {
          str="贵鬼往" + dirs[random(sizeof(dirs))] + "离开。\n";
          if (random(j)<2)
          tell_object(me,str);	
         }
        me->command(yes[k]);
        k++;
        for (i=0;i<3;i++)
        {
         str="贵鬼往" + dirs[random(sizeof(dirs))] + "离开。\n";
         if (random(n)<2)
         tell_object(me,str);	
        }  

        call_out("yinlu", 10, ob,me,k);
     }
    else
     {
          ob->move("/d/shengdoushi/7hai/shendian/zhongxin");
          message_vision(CYN"$N说到：到了，赶快去解救"+HIY+"雅典娜"+NOR+CYN+"吧。\n"NOR,ob);
          message_vision(CYN"$N说完便往回走了。\n"NOR,ob);
          ob->move("/d/shengdoushi/7hai/maze/haidimigong");
     } 
}
