// nine-ring.c

#include <ansi.h>
#include <weapon.h>

inherit STAFF;

void create()
{
	set_name( HIY "黄金手杖" NOR, ({ "gold staff", "staff" }) );
	set_weight(90000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "根");
		set("long", HIY "胜利女神变的。\n" NOR);
		set("value", 50000);
		set("material", "brass");
		set("wield_msg", HIY "\n$N拿出一条黄金手杖握在手中，刹那间四周一片肃穆，连天地鬼神也为之震动。\n\n" NOR);
		set("unwield_msg", HIY "\n$N放下手中的黄金手杖，周围的人才喘过一口气来。\n\n" NOR);
	}

	init_staff(90);
	setup();
}
