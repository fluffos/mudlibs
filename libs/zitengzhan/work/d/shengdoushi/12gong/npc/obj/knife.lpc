#include <weapon.h>
#include <ansi.h>

inherit THROWING;

string *names = ({
  HIR "教皇匕首" NOR,
  HIY "黄金短剑" NOR,
});

void create() {
  int i = random(sizeof(names));
  set_name(names[i], ({ "knife" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一把匕首。\n");
    set("unit", "些");
    set("base_unit", "把");
    set("base_weight", 40);
    set("base_value", 1);
  }
  set("is_monitored", 1);
  set_amount(100);
  set("rigidity", 100);
  init_throwing(1000);
  setup();
}
