
#include <ansi.h>
inherit ROOM;

void create ()
{
  set ("short", HIY"天秤宫"+HIC+"大门"NOR);
  set ("long", HIW @LONG

           777777
          7      7
         7        7
         7        7
       777        777
        
       77777777777777

LONG NOR);

  set("exits", ([
  "westdown" : __DIR__"sn2tc2",
  "enter" : __DIR__"tianchen",
]));
  set("outdoors", 1);

  setup();
}


 void init()
{
  add_action("do_fly", "fly");
}
int do_fly (string arg)
{
  object me;
  me = this_player();

  message_vision("只见$N向上一飞，突然重重地摔了下来。\n", me);
  tell_object(me,"看样子在圣域里真是插翅难飞……\n");
  return 1;
}




