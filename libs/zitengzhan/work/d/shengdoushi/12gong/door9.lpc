
#include <ansi.h>
inherit ROOM;

void create ()
{
  set ("short", HIY"人马宫"+HIC+"大门"NOR);
  set ("long", HIW @LONG

                   99999
             99    9999
              99 999 9
               999
             99 99
           99    99
             
LONG NOR);

  set("exits", ([
  "eastdown" : __DIR__"tx2rm2",
  "enter" : __DIR__"renma",
]));
  set("outdoors", 1);

  setup();
}


 void init()
{
  add_action("do_fly", "fly");
}
int do_fly (string arg)
{
  object me;
  me = this_player();

  message_vision("只见$N向上一飞，突然重重地摔了下来。\n", me);
  tell_object(me,"看样子在圣域里真是插翅难飞……\n");
  return 1;
}




