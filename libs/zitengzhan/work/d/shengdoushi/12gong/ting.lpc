
#include <ansi.h>
inherit ROOM;

void create ()
{
  set ("short", HIM"圣域"HIW+"-"+HIG"教皇厅"NOR);
    set ("long", HIG @LONG

         教         皇         厅

LONG NOR);

  set("exits", ([
  "out" : __DIR__"door",
  "north" : __DIR__"palace",
]));
set("no_fly", 1);
set("objects", ([
      __DIR__"npc/jiaohuang" : 1,
      ]));

  setup();


}
int valid_leave(object me, string dir)
{
  if (dir == "north" ){
  if (me->query("12gong/shendian") != "done")
    return notify_fail ("有人对你喊道：见女神？先过我这关！\n");
  return 1;
  }
  return ::valid_leave(me, dir);
}



