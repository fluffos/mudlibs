
#include <ansi.h>
inherit ROOM;

void create ()
{
  set ("short", HIY"狮子宫"+HIC+"大门"NOR);
  set ("long", HIW @LONG

         555555
        5      5
         555555
             55555555
                   5      5
                    555555

LONG NOR);

  set("exits", ([
  "eastdown" : __DIR__"jx2sz2",
  "enter" : __DIR__"shizi",
]));
  set("outdoors", 1);

  setup();
}


 void init()
{
  add_action("do_fly", "fly");
}
int do_fly (string arg)
{
  object me;
  me = this_player();

  message_vision("只见$N向上一飞，突然重重地摔了下来。\n", me);
  tell_object(me,"看样子在圣域里真是插翅难飞……\n");
  return 1;
}




