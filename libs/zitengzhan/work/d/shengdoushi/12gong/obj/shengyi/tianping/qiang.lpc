#include <ansi.h>
#include <weapon.h>
inherit SPEAR;

void create()
{
        set_name(HIY "圣枪"NOR, ({ "qiang"}));
        set_weight(7000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "只");
                set("long", HIW"天秤座"+HIY+"黄金圣衣"+HIC+"的十二件武器之一。\n"NOR);
                set("value", 1);
                set("no_sell",1);
                set("no_give", 1);
                set("no_drop", 1);
                set("no_put", 1);
                set("material", "steel");
                set("weapon_prop/personality", 24);
                set("wield_msg", HIC"$N凌空一指，变出了$n"+HIC+"握在手中。\n"NOR);
                set("unwield_msg", "$N把$n向空中抛去，$n消失了。\n");
        }
        init_spear(150);
        setup();
}
