// baoping.c 黄金圣衣

#include <armor.h>
#include <ansi.h>
#include <weapon.h>
inherit ARMOR;
inherit F_UNIQUE;

void create() {
  set_name(
    HIW "宝瓶座" + HIY + "黄金圣衣" NOR,
    ({ "baoping golden armor", "golden armor", "shengyi", "armor" })
  );
  set_weight(30000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", HIC "十二件" + HIY + "黄金圣衣" + HIC + "之一。\n" NOR);
    set("material", "steel");
    set("value", 1);
    set("no_sell", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_put", 1);
    set("armor_prop/armor", 150);
    set("wear_msg", HIC "$N凌空一指变出了$n" + HIC + "穿在身上，防御能力迅速提升了！\n" NOR);
    set("remove_msg", "$N将$n脱了下来。\n");
    set("armor_prop/dodge", 30);
  }
  setup();
}
