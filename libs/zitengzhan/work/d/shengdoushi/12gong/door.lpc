
#include <ansi.h>
inherit ROOM;

void create ()
{
  set ("short", HIG"教皇厅"+HIC+"大门"NOR);
  set ("long", HIG @LONG

          教       皇       厅
              大       门

LONG NOR);

  set("exits", ([
  "southdown" : __DIR__"rose3",
  "enter" : __DIR__"ting",
]));
  set("outdoors", 1);

  setup();
}


 void init()
{
  add_action("do_fly", "fly");
}
int do_fly (string arg)
{
  object me;
  me = this_player();

  message_vision("只见$N向上一飞，突然重重地摔了下来。\n", me);
  tell_object(me,"看样子在圣域里真是插翅难飞……\n");
  return 1;
}




