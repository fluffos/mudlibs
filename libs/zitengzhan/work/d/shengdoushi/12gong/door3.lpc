#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIY "双子宫" + HIC + "大门" NOR);
  set("long", HIW @LONG

         3333333333
          3      3
           3    3
           3    3
          3      3
         3333333333
         
LONG NOR);

  set("exits", ([
    "southdown": __DIR__ "jn2sz1",
    "enter": __DIR__ "jn2sz2",
  ]));
  set("outdoors", 1);

  setup();
}


void init() {
  add_action("do_fly", "fly");
}
int do_fly(string arg) {
  object me;
  me = this_player();

  message_vision("只见$N向上一飞，突然重重地摔了下来。\n", me);
  tell_object(me, "看样子在圣域里真是插翅难飞……\n");
  return 1;
}
