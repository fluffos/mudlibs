//cglaem...12/12/96.
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIY "白羊宫" + HIC + "大门" NOR);
  set("long", HIW @LONG

              111   111
             1   1 1   1
                  1
                  1
                  1
         
LONG NOR);

  set("exits", ([
    "eastdown": __DIR__ "toby2",
    "enter": __DIR__ "baiyang",
  ]));
  set("outdoors", 1);

  setup();
}
void init() {
  add_action("do_fly", "fly");
}
int do_fly(string arg) {
  object me;
  me = this_player();

  message_vision("只见$N向上一飞，突然重重地摔了下来。\n", me);
  tell_object(me, "看样子在圣域里真是插翅难飞……\n");
  return 1;
}
