
#include <ansi.h>
inherit ROOM;

void create ()
{
  set ("short", HIY"巨蟹宫"+HIC+"大门"NOR);
  set ("long", HIW @LONG

           444444444
      444444       444444
                  4      4
       444444      444444
      4      4
       444444       444444
            444444444
            
LONG NOR);

  set("exits", ([
  "southdown" : __DIR__"sz2jx2",
  "enter" : __DIR__"juxie",
]));
  set("outdoors", 1);

  setup();
}


 void init()
{
  add_action("do_fly", "fly");
}
int do_fly (string arg)
{
  object me;
  me = this_player();

  message_vision("只见$N向上一飞，突然重重地摔了下来。\n", me);
  tell_object(me,"看样子在圣域里真是插翅难飞……\n");
  return 1;
}




