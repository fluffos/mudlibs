#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIY "山羊宫" + HIC + "大门" NOR);
  set("long", HIW @LONG

         AA   AAA
          AA AA AA AAA
           AAA   AA  AA
                  AAAA
                   AA
                  AA
              AAAAA
              
LONG NOR);

  set("exits", ([
    "northdown": __DIR__ "rm2mj2",
    "enter": __DIR__ "mojie",
  ]));
  set("outdoors", 1);

  setup();
}


void init() {
  add_action("do_fly", "fly");
}
int do_fly(string arg) {
  object me;
  me = this_player();

  message_vision("只见$N向上一飞，突然重重地摔了下来。\n", me);
  tell_object(me, "看样子在圣域里真是插翅难飞……\n");
  return 1;
}
