inherit ROOM;
#include <ansi.h>
void jiang_jing(object where);
void finish_jing(object where);
void check_time(object where);
int do_hear();
void create() {
  set("short", "紫云轩");
  set("long", @LONG
这里是紫霞仙子的卧房，每当夜幕降临的时候，紫霞仙子就不知去向了。
LONG);
  set("exits", ([
    "up": __DIR__ "shishi4",
  ]));
  set("objects", ([
    "/d/pansi/obj/yinsuo": 1,
  ]));

  setup();
}
/* 
void init()
{
   object where=this_object();

    remove_call_out("check_time");
   check_time(where);
   add_action("do_hear","hear");
}
*/
void check_time(object where) {

  mixed *local = localtime((time() - 900000000) * 60);
  int t = local[2] * 60 + local[1];
  int phase = ((int)(t / 120));
  if (phase == 4 && (!query("jiangjing"))) jiang_jing(where);
  if (phase == 7 && query("jiangjing")) finish_jing(where);
  call_out("check_time", 60, where);
}

void jiang_jing(object where) {
  message(
    "channel:es",
    HIY + "◇" NOR "" RED "盘丝洞" HIY "◇" WHT "紫霞仙子[Zixia xianzi]" HIY "：盘丝众仙速到紫云轩领悟大法。\n" + NOR,
    users()
  );
  tell_object(where, "紫霞仙子说道:众弟子归位开始领悟大法。\n");
  tell_object(where, "一时彩云腾起，香气呈照大厅。\n");
  set("jiangjing", 1);
}
void finish_jing(object where) {
  tell_object(where, "紫霞仙子朗声道:今日暂且讲到这里吧。\n");
  set("jiangjing", 0);
}
int do_hear() {

  object me = this_player();

  if (me->is_busy())
    return notify_fail("你正忙着呢。\n");
  if (!query("jiangjing"))
    return notify_fail("盘丝洞还没有开始领悟大法。\n");

  if ((string)me->query("family/family_name") != "盘丝洞")
    return notify_fail("非盘丝洞大仙不得在此听经。\n");
  if (me->query("faith") > 40000)
    return notify_fail("你已经有一定功底,不用再领悟了。\n");
  tell_object(me, "你听着听着似乎若有所悟。\n");
  me->start_busy(5);
  me->improve_skill("jiuyin-xinjing", random((int)(me->query("spi") + me->query("int")) / 2));
  me->improve_skill("pansi-dafa", random((int)(me->query("spi") + me->query("int")) / 2));
  me->improve_skill("qin", random((int)(me->query("spi") + me->query("int")) / 2));

  me->receive_damage("kee", 20);
  me->receive_damage("sen", 20);
  return 1;
}
