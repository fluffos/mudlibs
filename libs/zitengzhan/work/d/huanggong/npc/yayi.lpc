 // garrison.c
#include <ansi.h> 
inherit NPC; 
void create()
{
        set_name("长安衙役", ({ "yayi", "ya" }) );
        set("long",
                "正在上堂的衙役，千万不要惹他们\n"); 
        set("cor", 40);
        set("cps", 25); 
        set("combat_exp", 2000000); 
        set_skill("unarmed", 200);
        set_skill("parry", 150);
        set_skill("dodge", 150);
        
        set("chat_chance", 1);
        set("chat_msg", ({
"长安衙役低声宣道：威～～～～武～～～～\n"
        }) ); 
        setup(); 
        carry_object(__DIR__"obj/yafu")->wear();
        carry_object(__DIR__"obj/sawei")->wield();
}      
