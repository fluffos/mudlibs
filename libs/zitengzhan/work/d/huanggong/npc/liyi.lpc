// garrison.c
#include <ansi.h>
inherit NPC;
void create() {
  set_name("李乂", ({ "li yi", "yi" }));
  set("long",
    "一个精神饱满的年轻人，双眼炯炯有神，好似利剑般直刺人心，
  李乂，字尚真，赵州房子人，专抓作奸犯科之徒。\n");

  set("title", HIB "长安府 总捕头" NOR);
  set("age", 62);
  set("str", 5000);
  set("cor", 46);
  set("cps", 25);
  set("agi", 60);
  set("max_kee", 320000);
  set("combat_exp", 58000000);
  set("daoxing", 58000000);
  set("max_force", 10000);
  set("force_factor", 100);
  set_skill("unarmed", 800);
  set_skill("dodge", 800);
  set_skill("parry", 800);


  set("chat_chance", 5);
  set("chat_msg", ({
    "李总捕头用一双锐眼冷冷的看着你，似乎要将你看穿似的。\n",
  }));
  setup();
}
void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  if (ob->query("family/family_name") != "将军府") {
    if (ob->query_temp("fanren") != 1) {
      message_vision("李总镖头对$N说道：“衙门乃官府重地，岂容你来此放肆，左右与我打出！”\n", ob);
      message_vision("众衙役将$N乱棒打出。\n", ob);
      ob->move("/d/huanggong/chaoyangmen");
    }
  }
}
void init() {
  ::init();
  if (interactive(this_player())) {
    remove_call_out("greeting");
    call_out("greeting", 1, this_player());
  }
}
