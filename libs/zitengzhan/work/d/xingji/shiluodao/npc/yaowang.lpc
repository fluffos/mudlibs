inherit NPC;

void create()
{
  set_name("兽王", ({"yao wang", "wang" }));
  set("title","野兽之王");
  set("gender", "男性");
  set("age", 4320);
  set("attitude", "aggressive");
  set("shen_type", 1);
  set("per", 30);
  set("int", 30);
  set("max_kee", 2000);
  set("max_gin", 2000);
  set("max_sen", 2000);
  set("force", 10000);
  set("max_force", 5000);
  set("force_factor", 170);
  set("max_mana", 5000);
  set("mana", 10000);
  set("mana_factor", 140);
  set("combat_exp", 5603000);
  set("daoxing", 6003000);

  set_skill("unarmed", 300);
  set_skill("dodge", 300);
  set_skill("parry", 230);
  set_skill("spells", 270);
  set_skill("force", 270);
  set_skill("staff",230);
  set_skill("gouhunshu", 270);
  set_skill("tonsillit", 270);
  set_skill("ghost-steps", 300);
  set_skill("iori-kuihua", 300);
  set_skill("lunhui-zhang", 230);
  map_skill("unarmed", "iori-kuihua");
  map_skill("dodge", "ghost-steps");
  map_skill("staff", "lunhui-zhang");
  map_skill("parry", "lunhui-zhang");
  map_skill("force", "tonsillit");
  map_skill("spells", "gouhunshu");
        set("chat_chance_combat", 40);
        set("chat_msg_combat", ({
          (: perform_action, "unarmed", "three" :),
        }) ); 
  setup();
  carry_object("/d/obj/cloth/shoupiqun")->wear();
  
}

void die()
{
  object me = this_object();
  object where = environment();

  message_vision("只见$N摔倒在地，现了本形。原来是只麒麟兽！\n",me);
  set_name("麒麟兽", ({"yao wang", "wang" }));
  delete("title");
  ::die();
}

void unconcious()
{
  die();
}

