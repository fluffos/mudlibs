inherit NPC;

string *names = ({
  "守灵兽",
  "守护兽",
});

void create() {
  int i = random(9) + 1;
  string str;
  set_name(names[random(sizeof(names))], ({ "shouhuzhe" }));
  set("gender", "男性");
  set("age", 30 * i);
  set("attitude", "aggressive");
  set("combat_exp", 5000000);
  set("daoxing", 6000000);
  set("per", 10);
  set_skill("parry", 50 * i);
  set_skill("unarmed", 50 * i);
  set_skill("dodge", 50 * i);
  set_skill("blade", 50 * i);
  set_skill("fork", 50 * i);
  set_skill("mace", 50 * i);
  set_skill("spear", 50 * i);
  set_skill("sword", 50 * i);
  set_skill("whip", 50 * i);
  set_skill("axe", 50 * i);
  set_skill("hammer", 50 * i);
  set_skill("rake", 50 * i);
  set_skill("stick", 50 * i);
  set_skill("staff", 50 * i);
  set_skill("dagger", 50 * i);
  set("max_sen", 700 * i);
  set("max_gee", 700 * i);
  set("max_gin", 700 * i);
  set("force", 1000 * i);
  set("max_force", 1900 * i);
  set("max_mana", 1900 * i);
  set("force_factor", 10 * i);
  setup();
  carry_object("/d/qujing/baotou/obj/cloth1")->wear();
  str = "/d/qujing/baotou/obj/weapon0";
  str[strlen(str) - 1] = '0' + random(4);
  carry_object(str)->wield();
}
