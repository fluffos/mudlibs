#include <armor.h>

inherit BOOTS;

void create() {
  set_name("疾风靴", ({ "shoes" }));
  set_weight(800);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "双");
    set("no_sell", 1);
    set("no_drop", 1);
    set("no_put", 1);
    set("value", 100);
    set("material", "cloth");
    set("armor_prop/armor", 50);
  }
  setup();
}
