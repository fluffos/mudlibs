#include <ansi.h>
#include <armor.h>

//inherit F_UNIQUE;
inherit EQUIP;

void create() {
  set_name(BLINK + HIW "麒麟袍" NOR, ({ "qilin pao", "pao", "cloth" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一件麒麟丝袍。\n");
    set("no_sell", 1);
    set("no_drop", 1);
    set("no_put", 1);
    set("unit", "件");
    set("value", 1000);
    set("material", "crimsonsteel");
    set("armor_prop/armor", 120);
    set("armor_prop/dodge", 50);
    set("armor_prop/spells", 40);
  }
}
