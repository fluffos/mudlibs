#include <ansi.h>
inherit ITEM;

void setup() {}

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIY "消气丸" NOR, ({ "xiaoqi wan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "这是一种可以让人不生气的药。\n");
    set("value", 3000);
  }
  setup();
}

int do_eat(string arg) {
  if (!id(arg))
    return notify_fail("你要吃什么？\n");

  this_player()->add("bellicosity", -100);
  message_vision("$N吃下一颗" HIR "消气丸" NOR "顿时感到自己心情好多了\n", this_player());
  destruct(this_object());
  return 1;
}
