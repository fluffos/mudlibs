#include <ansi.h>
#include <armor.h>

inherit ARMOR;

void create() {
  set_name(BLINK + HIW "麒麟甲" NOR, ({ "qilin armor", "qilinjia", "jia", "armor" }));
  set_weight(30000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("no_sell", 1);
    set("no_drop", 1);
    set("no_put", 1);
    set("material", "crimsonsteel");
    set("value", 10000);
    set("armor_prop/armor", 120);
    set("armor_prop/dodge", 25);
  }
  setup();
}
