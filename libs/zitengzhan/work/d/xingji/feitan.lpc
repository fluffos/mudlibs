#include <ansi.h>
inherit ITEM;

void init()
{
        add_action("do_fly","wofei");
}

void create()
{
       set_name("飞毯", ({ "fei tan", "fei", "tan" }) );
       set_weight(10);
       if( clonep() )
               set_default_object(__FILE__);
       else {
               set("unit", "张");
               set("long", "这是一张给高手用的飞毯,你可以用wofei来快速飞行。\n");
                set("no_get", 1);
         set("value",2000000);
                set("no_put", 1);
                set("no_drop", 1);
 }
       setup();
}

int do_fly( )
{
  object ob, myenv;
  ob = this_player ( ) ;
  if (ob->is_busy())
  return notify_fail("你现在正忙着呢。\n");
  if (ob->is_fighting() )
  return notify_fail("你无法在战斗中使用飞毯！\n");


  if (ob->query("combat_exp") > 2000000 && environment(ob)->query("no_fight"))
  {
        message_vision("你发动了飞毯,你飞了起来。\n",ob);
        message_vision("你飞啊飞,飞了很长时间终于飞到了异次元空间......\n", ob);
        ob->add("sen",-100);
        ob->add("kee",-100);
        myenv = environment (ob) ;
        ob->move (__DIR__"kongjian");
        return 1;
  }
  else  
  message_vision("只有大于200万武学，并在安全地带就是不准战斗的地方??\n"
                 "才能使用飞毯!!!\n"
                 ,ob);
  return 1;
}

