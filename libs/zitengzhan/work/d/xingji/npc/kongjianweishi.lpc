inherit NPC;

void create() {
  set_name("空间卫士", ({ "kongjian weishi", "weishi" }));
  set("gender", "男性");
  set("combat_exp", 2500000);



  set("daoxing", 3000000);
  set("age", 30);
  set("per", 25);
  set("attitude", "friendly");
  set("shen_type", 1);
  set("people", "people");
  set("force_factor", 60);
  set("max_gin", 6000);
  set("max_kee", 6000);
  set("max_sen", 6000);
  set("max_force", 8000);
  set("force", 8000);
  set("mana", 8000);
  set("max_mana", 8000);
  set_skill("unarmed", 280);
  set_skill("dodge", 280);
  set_skill("parry", 280);
  set_skill("staff", 280);
  set_skill("force", 280);
  set_skill("spells", 280);
  set_skill("buddhism", 280);
  set_skill("lotusmove", 280);
  set_skill("lunhui-zhang", 280);
  set_skill("lotusforce", 280);
  set_skill("jienan-zhi", 280);
  map_skill("spells", "buddhism");
  map_skill("unarmed", "jienan-zhi");
  map_skill("dodge", "lotusmove");
  map_skill("force", "lotusforce");
  map_skill("parry", "lunhui-zhang");
  map_skill("staff", "lunhui-zhang");
  setup();
  carry_object("/d/obj/armor/jinjia")->wear();
  carry_object("/d/nanhai/obj/budd_staff")->wield();
  set("no_nk_reward", 1);
}

void init() {
  object ob = this_player();
  object me = this_object();

  if (living(ob))
    call_out("greeting", 1, ob);
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  if (ob && interactive(ob)) {
    if (!ob->query_temp("weishi_kill"))
      message_vision("$N喝道：贱民无法无天，擅闯异次元！\n", this_object());
    this_object()->kill_ob(ob);
    ob->set_temp("weishi_kill", 1);
  }
}
