void create ()
{
  set ("short", "休息室");
set ("long", @LONG

这里空荡荡的，只在靠近墙壁的地方整整齐齐地放着一些蒲团。
房里光线很暗，墙壁不知道是什么材料做的，会发出淡淡的黄
光。这里是休息(xiuxi)的好地方。你要是实在定不下心
也可以出去走走再回来( halt )。

LONG);

  set("exits", ([
   "east" : "d/baotu/kezhan",
            ]));
  
  set("no_fight", 1);
  set("no_magic", 1);
  set("no_magic", 1);
  setup();
}

void init()
{
    add_action("do_xiuxi", "xiuxi");
   add_action("do_none","move"); 

}
int do_none( )
{
  object me;
  me = this_player(); 

tell_object(me,"这里没有月光怎么使用"HIG"月"HIY"光"HIW"宝"HIM"盒"NOR"。\n");
return 1;
}


int do_xiuxi()
{       int xiuxi_time;

        object me = this_player();

        if (me->query("baotu/no_die"))
             {tell_object(me,"你有任务在身，定不下神来。\n"); 
              return 1;
             }

        if (me->query_temp("xiuxi"))
             {tell_object(me,"你正在休息中呢。\n");
              return 1;
             }

        message_vision(msg_xiuxi1[random(sizeof(msg_xiuxi1))]
                        +msg_xiuxi2[random(sizeof(msg_xiuxi2))]
                        +msg_xiuxi3[random(sizeof(msg_xiuxi3))],me);
        me->set_temp("no_move", 1);
        me->set_temp("xiuxi", 1);
        if ( !me->query("baotu") )  finish(me);
        else {
                xiuxi_time = 40+random(16);
                me->set_temp("xiuxi_time",xiuxi_time);
                    call_out("check_xiuxi",1,me);
              }
                     
        return 1;
}


void check_xiuxi(object me)
{       
        int xiuxi_time = me->query_temp("xiuxi_time");

        if ( xiuxi_time == 0 ) finish(me);
        
        else {
                if ( xiuxi_time%6 == 0 )
                      //tell_object(me,str[random(sizeof(str))]);
                        tell_object(me,msg_xiuxi3[random(sizeof(msg_xiuxi3))]);

                me->add_temp("xiuxi_time", -1);
                call_out("check_xiuxi",1,me);
              }
}

void finish(object me)
{
         message_vision(msg_finish1[random(sizeof(msg_finish1))]
                        + msg_finish2[random(sizeof(msg_finish2))]
                        + msg_finish3[random(sizeof(msg_finish3))]
                        + msg_finish4[random(sizeof(msg_finish4))],me);

        me->delete_temp("no_move");
        me->delete_temp("xiuxi");
        if (me->query_temp("baotu/gongde")) reward(me);
        me->delete("baotu");
}

void reward(object me)
{
        int pot,exp,daoxing,money;
        money = me->query_temp("baotu/gongde")*3000;
switch (random(3))
{
case 0 : exp = me->query_temp("baotu/gongde")*150;
         if(exp>4000000) exp=4000000+(exp-4000000)/3;
         daoxing = me->query_temp("baotu/gongde");
         pot = me->query_temp("baotu/gongde");break; 
case 1 : exp = me->query_temp("baotu/gongde")*80;
         if(exp>4000000) exp=4000000+(exp-4000000)/3;
         daoxing = me->query_temp("baotu/gongde")*2;
         pot = me->query_temp("baotu/gongde");break; 
case 2 : exp = me->query_temp("baotu/gongde")*80;
         if(exp>4000000) exp=4000000+(exp-4000000)/3;
         daoxing = me->query_temp("baotu/gongde");
         pot = me->query_temp("baotu/gongde")*10;break; 
}

// 防止player wx dx qn溢出，限制在20y
// add by bowl 11.29 2003
if (me->query("potential")/10>2000000000)
             pot=0;
if (me->query("combat_exp")/10>2000000000)
             exp=0;
if (me->query("daoxing")/10>2000000000)
             daoxing=0;
        me->add("potential", pot);
        me->add("combat_exp", exp);
        me->add("daoxing", daoxing);
        me->add("c_balance",money);
        me->add("baotu_killer",(int)me->query_temp("baotu/gongde")/150);
        me->delete_temp("baotu");
        tell_object(me,HIY"你的武学增加"+chinese_number(exp)+"点,道行增加"+COMBAT_D->chinese_daoxing(daoxing)+",潜能增加"+chinese_number(pot)+"点,得到"+chinese_number(money/10000)+"两黄金。\n"NOR);
		// message("channel:chat",HIG"┣ "HIW"强盗任务"HIG" ┫："+me->query("name")+HIY"的武学增加"+chinese_number(exp)+"点,道行增加"+COMBAT_D->chinese_daoxing(daoxing)+",潜能增加"+chinese_number(pot)+"点,得到"+chinese_number(money/10000)+"两黄金。\n"NOR,users());
		 message("channel:chat",HIG"┣ "HIW"强盗任务"HIG" ┫："+me->query("name")+HIY"的武学增加"+exp+"点,道行增加"+COMBAT_D->chinese_daoxing(daoxing)+",潜能增加"+pot+"点,得到"+money/10000+"两黄金。\n"NOR,users());
}                               

int do_halt()
{
      object me = this_player();

       if (me->query_temp("xiuxi"))
           {remove_call_out("check_xiuxi");
            me->delete_temp("xiuxi_time");
            message_vision(msg_finish4[random(sizeof(msg_finish4))],me);
            me->delete_temp("no_move");
            me->delete_temp("xiuxi");
            return 1;
           }
         else return 0;
}       
        



