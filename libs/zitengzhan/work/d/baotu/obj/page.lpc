#include <ansi.h>

inherit ITEM;

string *list = ({ "yg-ba", "yg-hell", "yg-jianzhang", "yg-jianmang",
  "yg-kunlun", "yg-jldl", "yg-moon", "yg-pansi", "yg-putuo", "yg-qiankun", "yg-shaolin",
  "yg-sanjie", "yg-shaolin", "yg-shushan", "yg-swordman", "yg-wudidong", "yg-youxia", "yg-zxzx",
});

int do_mieyao(string arg);

void create() {
  set_name(HIR "纸条" NOR, ({ "zhi tiao", "page" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("no_get", 1);
    set("no_put", 1);
    set("no_give", 1);
    set("no_drop", 1);
  }
  setup();
}

void init() {
  add_action("do_mieyao", "read");
}

int do_mieyao(string arg) {
  object me = this_player();
  int level;
  string kind, where, msg;
  object guai;

  if (!arg || !id(arg))
    return notify_fail("你要使用什么？\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢。\n");

  //确定任务等级
  level = random(3) + 1;

  //确定任务种类
  kind = "杀";

  me->delete("baotu/done");
  me->set("baotu/level", level);
  me->set("baotu/kind", kind);
  guai = new("d/wizz/baotu/" + list[random(sizeof(list))] + ".lpc");
  guai->set("baotu_level", query("level") + 1);
  where = guai->invocation(me, level);
  guai->set("host", me->query("id"));
  tell_object(me, HIY "只见纸上写道" + where + "快去联络。\n" NOR);
  me->set("baotu/guai", guai);
  me->set("baotu/where", where);
  //        me->set("baotu/start",time());
  me->set("baotu/no_die", 1);
  msg = me->name() + "接到一个难度" + chinese_number(level) + "的" + kind + "妖任务。";
  //        MONITOR_D->report_system_msg (msg);
  destruct(this_object());
  return 1;
}
