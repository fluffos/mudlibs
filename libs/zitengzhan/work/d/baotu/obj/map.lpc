void create() {
  set_name(HIR "藏宝图" NOR, ({ "cangbao tu", "map" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("no_get", 1);
    set("no_put", 1);
    set("no_give", 1);
    set("no_drop", 1);
  }
  random_plase();
  setup();
}

void init() {
  add_action("do_use", "use");
}
int do_use(string arg) {
  object who = this_player();
  string str, where;
  object money;
  int i;
  str = who->name();
  if (!arg || !id(arg))
    return notify_fail("你要使用什么？\n");
  if (who->is_busy())
    return notify_fail("你正忙着呢。\n");
  where = file_name(environment(who)) + ".lpc";
  if (where != query("where_id"))
    return notify_fail("你找的地方不对啊。\n");
  switch (query("level")) {
    case 1: i = random(5) + 1; break;
    case 2: i = random(10) + 1; break;
    case 3: i = random(15) + 1; break;
    case 4: i = random(20) + 1; break;
    case 5: i = random(25) + 1; break;
    case 6: i = random(30) + 1; break;
    case 7: i = random(35) + 1; break;
    case 8: i = random(40) + 1; break;
    case 9: i = random(45) + 1; break;
    case 10: i = random(50) + 1; break;
  }
  if (i == 5) {
    money = new("/clone/money/jinbi");
    money->set_amount(1 * query("level"));
    money->move(who);
    message(
      "channel:rumor",
      HIM "【通天界】天上人间II：" + str + "在宝藏中发现 " + query("level") + " 枚金币。\n" NOR,
      users()
    );
    message_vision(HIY "$N在宝藏中发现" + query("level") + "枚金币。\n" NOR, who);
    destruct(this_object());
    return 1;
  }
  if (i == 10) {
    message(
      "channel:rumor",
      HIM "【通天界】天上人间II：" + str + "在宝藏中发现 " + (5 * query("level")) + " 年道行。\n" NOR,
      users()
    );
    message_vision(HIY "突然一阵红光笼罩着$N。\n" NOR, who);
    who->add("potential", 5000 * query("level"));
    destruct(this_object());
    return 1;
  }
  if (i == 15) {
    message(
      "channel:rumor",
      HIM "【通天界】天上人间II：" + str + "在宝藏中发现 " + (5000 * query("level")) + " 潜能。\n" NOR,
      users()
    );
    message_vision(HIY "突然一阵红光笼罩着$N。\n" NOR, who);
    who->add("potential", 5000 * query("level"));
    destruct(this_object());
    return 1;
  }

  if (i == 20) {
    message(
      "channel:rumor",
      HIM "【通天界】天上人间II：" + str + "在宝藏中发现 " + (5000 * query("level")) + " 经验。\n" NOR,
      users()
    );
    message_vision(HIY "突然一阵红光笼罩着$N。\n" NOR, who);
    who->add("combat_exp", 5000 * query("level"));
    destruct(this_object());
    return 1;
  }

  /*if ( i == 25 )
        {
                
        }*/

  if (i == 30) {
    message(
      "channel:rumor",
      HIM "【通天界】天上人间II：" + str + "在宝藏中发现 " + (10 * query("level")) + " 年道行。\n" NOR,
      users()
    );
    message_vision(HIY "突然一阵红光笼罩着$N。\n" NOR, who);
    who->add("potential", 10000 * query("level"));
    destruct(this_object());
    return 1;
  }
  if (i == 35) {
    message(
      "channel:rumor",
      HIM "【通天界】天上人间II：" + str + "在宝藏中发现 " + (10000 * query("level")) + " 潜能。\n" NOR,
      users()
    );
    message_vision(HIY "突然一阵红光笼罩着$N。\n" NOR, who);
    who->add("potential", 10000 * query("level"));
    destruct(this_object());
    return 1;
  }

  if (i == 40) {
    message(
      "channel:rumor",
      HIM "【通天界】天上人间II：" + str + "在宝藏中发现 " + (10000 * query("level")) + " 经验。\n" NOR,
      users()
    );
    message_vision(HIY "突然一阵红光笼罩着$N。\n" NOR, who);
    who->add("combat_exp", 10000 * query("level"));
    destruct(this_object());
    return 1;
  }

  if (i == 45) {
    money = new("/u/ken/obj/qiannianzui");
    message("channel:rumor", HIM "【通天界】天上人间II：" + str + "在宝藏中发现1滴酒神葫芦千年醉。\n" NOR, users());
    message_vision(HIY "$N在宝藏中发现1滴酒神葫芦千年醉。\n" NOR, who);
    money->move(who);
    destruct(this_object());
    return 1;
  }


  if (i == 50 && random(2) == 1) {
    message("channel:rumor", HIM "【通天界】天上人间II：" + str + "在宝藏中发现 1 毫毛。\n" NOR, users());
    message_vision(HIY "突然一阵红光笼罩着$N。\n" NOR, who);
    who->add("haomao", 1);
    destruct(this_object());
    return 1;
  }
  if (i == 49 && random(2) == 1) {
    money = new("/d/obj/drug/renshen-guo");
    message("channel:rumor", HIM "【通天界】天上人间II：" + str + "在宝藏中发现1个人参果。\n" NOR, users());
    message_vision(HIY "$N在宝藏中发现1个人参果。\n" NOR, who);
    money->move(who);
    destruct(this_object());
    return 1;
  }

  message_vision(HIY "$N在宝藏中什么都没发现。\n" NOR, who);
  destruct(this_object());
  return 1;
}

int random_plase() {
  mixed *where;
  string where_id, where_name;
  int i, j;
  if (!sizeof(map))
    return 0;
  i = random(sizeof(map));
  set("where_map", map_name[i]);
  where = get_dir(map[i] + "/*.lpc", -1);
  if (!sizeof(where))
    return 0;
  j = random(sizeof(where));
  where_id = map[i] + "/" + where[j][0];
  where_name = where_id->query("short");
  set("where_id", where_id);
  set("where_name", where_name);
  set("long", _LONG);
}
