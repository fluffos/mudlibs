#include <ansi.h>
inherit NPC;
void create() {
  set_name("长安捕快", ({ "changan bukuai", "bukuai", "bu" }));
  set("gender", "男性");
  set("age", 35);
  set("long", "他是一个精干的巡捕。\n");
  set("nickname", HIR "铁面无私" NOR);
  set("title", "长安知府");

  set("combat_exp", 200000 + random(500000));
  set("shen_type", 1);
  set("pursuer", 2);
  set("str", 50);
  set("con", 50);
  set("max_force", 500);
  set("force", 500);
  set("jiali", 50);

  set_skill("force", 120);
  set_skill("blade", 150);
  set_skill("unarmed", 150);
  set_skill("dodge", 120);
  set_skill("parry", 120);

  set_temp("apply/attack", 50);
  set_temp("apply/defense", 50);
  set_temp("apply/damage", 50);

  setup();
  set("chat_chance", 8);
  set("chat_msg", ({
    "长安捕快说到：“你哪里的？好象没看见过，别在天子脚下捣乱！”\n",
    "长安捕快说到：“谁敢敢在长安捣乱，有他好看的！”\n",
    (: random_move :)
  }));
  carry_object("/d/obj/weapon/blade/blade")->wield();
  carry_object("/d/obj/cloth/linen")->wear();
}


void init() {
  object ob, me;
  me = this_object();
  ::init();
  if (interactive(ob = this_player()) &&
    (int)ob->query_condition("killer")) {
    me->set_leader(ob);
    command("say 站住！犯了事还敢跑？\n");
    me->set("chat_msg", ({
      "长安捕快说到：“小子，你别得意！出去就有你好看的！”\n",
      "长安捕快说到：“别看你现在没事，等下我弟兄们来了，要你好看！”\n",
      "长安捕快说到：“没事的别插手！不然一路砍！”\n",
    }));
    if (environment()->query("no_fight")) return;
    if (ob->query("no_kill")) return;
    else
      kill_ob(ob);
  }
  if (!ob->query_temp("armor/cloth") && ob->query("age") > 14 && ob->query_temp("rumor/dalao") && ob->query("race") == "人类"
    && ((int)ob->query_temp("summon_time") + 400) < time()) {
    remove_call_out("summon_ob");
    call_out("summon_ob", 1, ob);
    return;
    add_action("do_steal", "steal");
    add_action("do_kill", "cast");
    add_action("do_kill", "kill");
  }
}
int do_kill(string str) {
  object me, npc;
  me = this_player();
  npc = present(str, environment());
  if (npc == this_object()) {
    message_vision(CYN "长安捕快对$N怒道：你小子找死！！大家一起上，砍死他！\n" NOR, me);
    call_out("kill_me", 1, me);
  }
  return 0;
}

int do_steal() {
  object me;
  me = this_player();
  message_vision(CYN "长安捕快“哼”的冷笑一声：小子，胆子不小！居然敢在我面前偷鸡摸狗！\n" NOR, me);
  tell_object(me, "你只觉头皮发麻，赶忙把手缩了回来。\n");
  return 1;
}
int accept_fight(object who) {
  message_vision(CYN "长安捕快对着$N冷笑了两声：想造反？\n" NOR, who);
  return 0;
}
void summon_ob(object ob) {
  object room;
  if (!ob || environment(ob) != environment())
    return;
  if (!userp(ob)) return;
  if (!room = find_object("/d/city/misc/jianyu"))
    room = load_object("/d/city/misc/jianyu");
  message_vision("\n$N一把抓住$n，光天化日，当街裸跑，有伤风化！\n\n", this_object(), ob);
  message_vision("$N拎着$n向衙门走去！\n", this_object(), ob);
  CHANNEL_D->do_channel(this_object(), "es", ob->name() + "在光天化日，当街裸跑，有伤风化，打入大牢十天。");
  ob->move(room);
  ob->set_temp("summon_time", time());
  message("vision", CYN + "\n\n“扑通”一声，一个赤裸裸的家伙被扔了进来。\n\n" + NOR, room, ({ ob }));
  if (!room = find_object("/d/city/center"))
    room = load_object("/d/city/center");
  this_object()->move(room);
}
