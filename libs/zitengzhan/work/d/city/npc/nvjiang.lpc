#include <ansi.h>
inherit NPC;

void create() {
  set_name(HIR "女将" NOR, ({ "nvjiang", "jiang" }));
  set("title", HIY "高楼门总堂护卫将军" NOR);
  set("gender", "女性");
  set("age", 27);
  set("long",
    "这是高楼门总堂的女护卫将军，手按配剑，身材惹火，英姿飒爽。\n");

  set("age", 27);
  set("str", 70);
  set("cor", 70);
  set("cps", 70);
  set("spi", 40);
  set("per", 40);
  set("con", 70);
  set("int", 40);
  set("kar", 35);
  //        set("attitude", "aggressive");
  //        set("shen_type", -1);

  set("kee", 50000);
  set("max_kee", 50000);
  set("sen", 50000);
  set("max_sen", 50000);
  set("force", 8000);
  set("max_force", 10000);
  set("mana", 80000);
  set("max_mana", 80000);
  set("force_factor", 20);
  set("combat_exp", 5000000);
  //	set("score", 15000);
  set_temp("apply/attack", 60);
  set_temp("apply/defense", 60);
  set_temp("apply/damage", 40);

  set_skill("unarmed", 200);
  set_skill("force", 200);
  set_skill("dodge", 200);
  set_skill("parry", 200);
  set_skill("sword", 200);
  set_skill("staff", 200);
  set_skill("literate", 200);
  set_skill("wuxing-quan", 200);
  set_skill("ghost-steps", 200);
  set_skill("zhuihun-sword", 200);
  set_skill("zixia-shengong", 200);
  //	set_skill("jiuyin-xinjing", 200);
  set_skill("wuxiangforce", 200);

  map_skill("force", "zixia-shengong");
  map_skill("unarmed", "wuxing-quan");
  map_skill("dodge", "ghost-steps");
  map_skill("parry", "zhuihun-sword");
  map_skill("sword", "zhuihun-sword");
  create_family("阎罗地府", 3, "老子");

  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "sword", "yanluo" :),
  }));
  setup();

  carry_object("/d/city/npc/obj/sword")->wield();
  carry_object("/d/obj/armor/tongjia")->wear();
  add_money("gold", 10);
}

int accept_fight(object me) {
  message_vision("女武将对$N微微一笑：小家伙胆子不小，高楼门总堂前也敢胡闹！不过我喜欢。\n", me);
  me->apply_condition("killer", 100);
  kill_ob(me);
  return 1;
}
