#include <ansi.h>
inherit NPC;
#define gift_skill 300
string ask_me();
int family_present();
  int give_bonnet();
  


void create()
{
        set_name(MAG"大唐使者"NOR, ({ "ziteng shizhe", "shizhe" }) );
         set("nickname", HIY"不知情愁枉少年"NOR);
        set("gender", "男性" );
        set("age", 18);
         set("long", YEL"这位是〖大唐西游 紫藤站〗的使者，向他打听“大唐”，他会带给您想不到的惊喜。\n拜师之后还有额外的奖励呢(Ask 师门)！\n"NOR);
   //   set("shen_type", 1);
        set("combat_exp", 1000000);
        set("str", 30);
        set("dex", 30);
        set("con", 30);
        set("int", 30);
        set("per", 30);
        set("attitude", "friendly");
    //    set("max_qi", 100000);
    //    set("neili", 100000);
    //    set("max_neili", 100000);
    //    set("score", 100000);

        set("inquiry", ([
                         "大唐" : (: ask_me :),
                     "法冠":(: give_bonnet :),
                         "bonnet":(: give_bonnet :),
                         "师门" : (: family_present :),
                         "师门奖励" : (: family_present :),
        ]));
        setup();
        carry_object("/d/obj/cloth/magua")->wear();
}

void init()
{
        object ob;
        ob = this_player();     
        ::init();
        if( interactive(ob) && !is_fighting() )
               {
                        remove_call_out("greeting");
                        call_out("greeting", 1, ob);
                }
}

