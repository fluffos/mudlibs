 int give_bonnet()
 {
 object bonnet;
   string oname;
 object who=this_player();
if (!userp(who))
{ 
command("heng");
command("say 什么小猫小狗也来要东西？！");
command("qi");
return 1;
}
    if (who->query_temp("ask_bonnet") > time())
{
    message_vision("$N眼睛撇向一旁，'你不是刚刚要过吗？？'\n",this_object(),this_player());
    return 1;
}
      bonnet=new("/d/lingtai/obj/faguan.lpc");
     oname=bonnet->query("name",1);
  bonnet->move(who);
message_vision("$N念动咒语：哈库那玛他他!只见漫天雪飞，$N变出一顶"+oname+"。\n$N给$n一顶"+oname+"\n",this_object(),this_player());
       who->set_temp("ask_bonnet",time()+600);
 return 1;
  }
string ask_me()
 {
        object me = this_player();
        object ob; 
        mapping fam; 
        
         if ((int) me->query("welcomexhc"))
                return "呵呵～这就是您的不是了！小的已经对您施过法力了！";
               else
        {
                me->set("welcomexhc", 1);
                me->set("maximum_force", 4500);
                me->set("maximum_mana",4500);
                me->add("force",9000);
                me->add("max_force",4500);
                me->add("max_mana",4500);
                me->add("mana",9000);
                me->add("potential", 1000000);
                me->add("daoxing",10000000);
            //    me->add("food", 1300);
            //    me->add("water", 10000);
                me->add("combat_exp",10000000);
                
                me->add("c_balance",10000000);
//下面就是给钱。其实除了move以外，还可以add存款。就是add banlance.
//目前是1 gold.你自己选奖励是什么。

 CHANNEL_D->do_channel(me, "dtxy", sprintf("在下%s今日光临〖紫藤站〗（ip:211.137.126.122.cn port: 5555）\n         现已得到大唐使者的帮助和奖励！即日起开始行走江湖了！", me->name(1)));                return "欢迎光临"NOR+HIR"〖紫藤站〗"NOR"，小的护架来迟，罪该万死！在下可助您行走江湖！\n"
HIW"突然天空中一道"HIM"七"HIY"彩"HIR"霞"HIC"光"HIW"笼罩四方，转瞬即逝！"NOR;
        }
}
int family_present()
{
        object me = this_player();
      if(!me->query("family"))
      {
        command("say 你还没有拜师呢！");
        command("hehe");
        return 1;
       }
     if(me->query("family_present") || me->query("yudian/gift")=="got" ) {
                command("say 呵呵～这就是您的不是了！小的已经对您施过法力了！");
                return 1;
      }
                me->set_skill("force",gift_skill);
                me->set_skill("spells",gift_skill);
                me->set_skill("dodge",gift_skill);
                me->set_skill("parry",gift_skill);
                me->set_skill("literate",gift_skill);
                me->set_skill("unarmed",gift_skill);
