// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */
#include <ansi.h>

inherit NPC;
inherit F_VENDOR;

void create() {
  set_name(HIR "萧振远" NOR, ({ "xiao zhenyuan", "xiao", "zhenyuan" }));
  set("title", HIW "大英雄" NOR);
  set("gender", "男性");
  set("combat_exp", 500000);
  set("age", 64);
  set("attitude", "friendly");
  set("shen_type", 1);
  set_skill("unarmed", 300);
  set_skill("dodge", 300);
  set("vendor_goods", ([
    "whip": "/d/obj/weapon/whip/liehuobian",
    "blade": "/d/obj/weapon/blade/hanyidao",
    "fork": "/d/obj/weapon/fork/bihaicha",
    "chu": "/d/obj/weapon/staff/jingangchu",
    "mace": "/d/obj/weapon/mace/yinguangjian",
    "bang": "/d/obj/weapon/stick/yuanyangbang",
    "hammer": "/d/obj/weapon/hammer/hanxuechui",
    "axe": "/d/obj/weapon/axe/kuangxiefu",
    "spear": "/d/obj/weapon/spear/bawangqiang",
    "sword": "/d/obj/weapon/sword/hanyujian",
    "quantao": "/d/obj/weapon/quantao/anquantao",
  ]));

  setup();
  carry_object("/d/obj/cloth/choupao")->wear();
  add_money("silver", 5);
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 3, ob);
  }
  add_action("do_vendor_list", "list");
}

void greeting(object ob) {
  command("xia");
}
