inherit NPC;
#include <ansi.h>
//#include <login.h>
inherit F_SAVE;
int give_card(object me);
void reset_balance(object me);
void log_positions (object ob);
int do_open();
void create()
{
	restore();
	set_name("铁算盘", ({"tie suanpan", "tie", "zhanggui"}));
	set("title", "钱庄掌柜");
	set("gender", "男性");
	set("age", 54);
	set("kee", 800); 
	set("max_kee", 800);
	set("sen", 200);
	set("max_sen", 200);
	set("combat_exp", 50000);
	set("attitude", "friendly");
	set("env/wimpy", 50);
	set("chat_chance", 10);
	/*        set("chat_msg", ({
		"铁算盘嘿嘿嘿地笑了几声：我这把算盘几十年来可从来没错过。\n",
		"铁算盘骄傲的说道：提起本钱庄相老板，可以说是无人不晓。连当今皇上都跟他很熟。\n"
		}));
		*/
	set_skill("unarmed", 60);
	set_skill("parry", 60);
	set_skill("dodge", 60);
	set("inquiry", ([
		"信用卡" : (: do_open :),
		"card" : (: do_open :),
		]));
	setup();
	carry_object("/d/obj/cloth/choupao")->wear();
	add_money("gold", 1);
}

void init()
{
	add_action("do_transfer","transfer");
    call_out("reset_balance", 1, this_player());
	::init();
}
void reset_balance(object me)
{
    int myexp;
    int allowed, removed_gold;
    string myid;
    string NPCNAME=this_object()->name();

    if(!me) return;

    myexp=me->query("combat_exp")/1000;
    myid=me->query("id");

    if(myexp<1) myexp=1;
    if(myexp>100) myexp=100;
    allowed=myexp*3000000;//each year can have 100 gold, range 100-10000. 
    if (me->query("balance") > allowed)
    {
        me->set("balance_old", me->query("balance"));
         me->set("balance", allowed);
        removed_gold = (me->query("balance_old") - me->query("balance"))/10000;
	log_file("MONEY_RESET", ctime( time() )+"：魏大人收缴了"+me->query("name")+"("+me->query("id")+")"+removed_gold+"两黄金。\n");
	tell_object(me, GRN+NPCNAME+"在你的耳边悄声说道："+RANK_D->query_respect(me)+
		"，这、这真不知怎么说是好．．．\n"NOR);
	tell_object(me, GRN+NPCNAME+"在你的耳边悄声说道："+
		"昨日魏大人派人前来察案，发觉你老的黄金来路．．．\n"NOR);
	tell_object(me, GRN+NPCNAME+"在你的耳边悄声说道："+
		"若不是在下帮你老辩解，你老的钱就全都充公了．．．\n"NOR);
    }
    return;
}
void accept_kill(object me)
{       object ob;
        if(is_fighting()) return;
        if( query("called") ) return;

        command("help!");

        ob=present("xunluo guanbing");
        if( !ob) {
                seteuid(getuid());
                ob=new("/d/city/npc/xunluobing");
                ob->move(environment());
        }
        message_vision("\n忽然从门外冲进来个巡逻官兵，对$N大喊一声“干什么？想杀人谋财么！\n\n",me);        

        ob->kill_ob(me);
        ob->set_leader(me);
        me->fight_ob(ob);
        set("called", 1);
        call_out("regenerate", 300);
}
int regenerate()
{
        set("called", 0);
        return 1;
}
int do_transfer(string arg){
	int amount;
	string unit,target,str="";
	object ob,me;
	if(!arg) return notify_fail("指令格式：transfer <数量> <货币种类> to <某人>\n");
	if(sscanf(arg, "%d %s to %s", amount,unit,target)==3);
	else return notify_fail("指令格式：transfer <数量> <货币种类> to <某人>\n");
	if(amount>0);
	else return notify_fail("指令格式：transfer <数量> <货币种类> to <某人>\n");
	if(unit=="gold") amount=amount*10000;
	else if(unit=="silver") amount=amount*100;
	else if(unit=="coin") ;
	else return notify_fail("指令格式：transfer <数量> <货币种类> to <某人>\n");
	me=this_player();
	if(me->query("id")==target) return notify_fail("去，一边玩去。\n");
	if(me->query("balance")-amount<0){
		message_vision("$N帐户上没有那么多存款。\n",me);
		return 1;
	}
	ob=find_player(target);
	if(!ob) return notify_fail(HIY"没有这个玩家。\n"NOR);
	if(!ob->query("card_number")) {
		command("say 抱歉,"+ob->query("name")+"还没有在本钱庄开设信用卡服务。\n");
		return 1;
	}
	if(!me->query("card_number")) {
		command("say 抱歉,您没有在本钱庄开设信用卡服务。\n");
		return 1;
	}
	me->add("balance",-amount);
	ob->add("balance",amount);
	if((amount/10000)!=0) {
		str=str+chinese_number(amount/10000)+"两黄金";
		amount=amount%10000;
	}
	if((amount/100)!=0) {
		str=str+chinese_number(amount/100)+"两白银";
		amount=amount%100;
	}
	if(amount!=0) {
		str=str+chinese_number(amount)+"个铜板";
	}
	message_vision("$N("+me->query("card_number")+")将"+str+"转到了$n("+ob->query("card_number")+")的帐户上。\n",me,ob);
	return 1;
}
int do_open(){
	object me=this_player(),ob;
	object me1=this_object();
	int n;
	string num;
	if(me->query("card_number")) {
		if(ob=present("card",me))
			command("say 我不是已经把信用卡给您了吗？");
		else give_card(me);
		return 1;
	}
	if(me->query("balance")<10000000){
		command("say 开户至少需要有1000两黄金的存款");
		return 1;
	}

	n=me1->query("card/num");
	n=100001+n;
	num="ZT"+sprintf("%d",n);
	me1->add("card/num",1);
	if(me1->save()){
		me->set("card_number",num);
		message_vision(HIY"开户成功!!\n"+"$N的卡号为"+num+"\n",me);
		command("say 开户的费用是十两黄金，已从你的存款中扣除。");
		me->add("balance",-100000);
		give_card(me);
		log_positions(me);
		return 1;
	}
	else {
		message_vision(HIY"开户失败。\n"NOR,me);
		return 1;
	}
}
string query_save_file()
{
  return DATA_DIR+"card.o";
}
void log_positions (object ob)
{
	string file_name = "card.number";
	string name = ob->query("name");
	string id = ob->query("id");
	string number = ob->query("card_number");
	log_file (file_name,sprintf("\n  %s. %s %s",number,name,id));
	log_file (file_name,"\n "+ctime(time())+":\n");
}
int give_card(object me){
	object ob;
        ob=new("/d/obj/card.lpc");
	ob->move(me);
//        ob->add("long",HIY+me->query("card_number")+"\n"NOR);
	message_vision(NOR"$N得到了一张信用卡。\n",me);
	return 1;
}
