int give_dan() {
  object who = this_player();
  if (!userp(who)) {
    command("hate");
    command("say 小畜生回去多多修炼！");
    command("qi");
    return 1;
  }
  if (this_player()->query("lestat/gift") == "got") {
    message_vision("$N对着$n哼了一声。\n", this_object(), this_player());
    command("say 礼物只有一份！领过就不再给了！");
    return 1;
  }

  //added by mudbug on 2003/3/10 for avoid player to reduce exp
  if ((who->query(
    "combat_exp",
    1
  ) > 30000 || who->query(
    "daoxing",
    1
  ) > 30000) && (who->query("combat_exp", 1) + who->query("daoxing", 1)) > 60000) {
    message_vision("$N对着$n说道：“你现在的武学经验和道行修炼已经不要领新手礼物了!”\n", this_object(), this_player());
    return 1;
  }
  who->set("combat_exp", 30000);
  who->set("daoxing", 30000);
  who->set("force", 400);
  who->set("max_force", 400);
  who->set("max_mana", 400);
  who->set("mana", 400);
  who->set("maximum_force", 400);
  who->set("maximum_mana", 400);
  who->set("potential", 40000);
  message_vision("$N手一指，$n只觉得周身紫气环绕，似乎修为有所进境。\n", this_object(), this_player());
  who->set("lestat/gift", "got");
  return 1;
}
int give_baohong() {
  object who = this_player();
  if (!userp(who)) {
    command("hate");
    command("say 小畜生回去多多修炼！");
    command("qi");
    return 1;
  }
  if (this_player()->query("lestat/newbaohong") == "got")

  {
    command("say 补偿只有一份！领过就不再给了！");
    return 1;
  }
  who->add("potential", 50000);
  message_vision("$N手一指，$n只觉得浑身一爽，看来潜能加了不少。\n", this_object(), this_player());
  who->set("lestat/newbaohong", "got");
  return 1;
}
int give_bonnet()

{

  object bonnet;

  object who = this_player();

  if (!userp(who))

  {

    command("grin");

    command("say 什么东西,小心我把你抽筋扒皮？！");

    return 1;

  }
  bonnet = new("/d/lingtai/obj/faguan.lpc");
  bonnet->move(who);
  message_vision("$N左手一挥，$N变出一个天师法冠。\n$N给$n一顶天师法冠。\n", this_object(), this_player());

  command("say 好好练哦,如果干了坏事,小心黑山老妖抓你！");

  command("snicker");
  return 1;
}

int give_gqliwu(object me) {
  me = this_player();

  if (me->query("gift/02gq")) {
    write(HIY "你已经得到了礼物吧？\n" NOR);
    return 1;
  }
  write(HIY "节日快乐!\n你得到了50年道行，30000武学，30000潜能。\n" NOR);
  me->add("potential", 15000);
  me->add("daoxing", 25000);
  me->add("combat_exp", 15000);
  me->set("gift/02gq", 1);
  me->save();
  return 1;
}
