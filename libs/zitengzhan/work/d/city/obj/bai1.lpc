//inherit "/std/char/knower";
#define SKILLL 30
inherit NPC;
int call_moon();
int call_wzg();
int call_kunlun();
int call_putuo();
int give_bonnet();
int call_fangcun();
int call_xueshan();
int call_tianmo();
int call_shenjian();
int call_huoyundong();
int call_longgong();
int give_gqliwu(object me);
int call_wdd();
int call_hell();
int call_jjf();
int call_pansi();
int call_shushan();
int call_sanxian();
int give_gift();
int give_buchang();
int give_baohong();
#include <ansi.h>
int give_dan();

void create() {
  set_name(MAG "大唐使者" NOR, ({ "ziteng shizhe", "shizhe" }));
  set("nickname", HIG "help gift " NOR);
  set("long", @LONG

传说中的天神，她可以帮你得到你想要的功夫，
你就去问问(ask)她关于各大门派(putuo....)。
LONG);
  set("gender", "女性");
  set("title", HIW "不知情愁枉少年" NOR);
  set("age", 21);
  set("per", 40);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("max_kee", 10000);
  set("max_sen", 10000);
  set("force", 100000);
  set("max_force", 20000);
  set("force_factor", 1000);
  set("max_mana", 20000);
  set("mana", 100000);
  set("mana_factor", 1000);
  set("combat_exp", 50000000);
  set("daoxing", 50000000);

  set("inquiry", ([
    "moon": (: call_moon :),
    "huoyundong": (: call_huoyundong :),
    "jjf": (: call_jjf :),
    "wzg": (: call_wzg :),
    "xueshan": (: call_xueshan :),
    "fangcun": (: call_fangcun :),
    "putuo": (: call_putuo :),
    "kunlun": (: call_kunlun :),
    "hell": (: call_hell :),
    "tianmo": (: call_tianmo :),
    "longgong": (: call_longgong :),
    "shenjian": (: call_shenjian :),
    "wdd": (: call_wdd :),
    "pansi": (: call_pansi :),
    "shushan": (: call_shushan :),
    "sanxian": (: call_sanxian :),
    "天师法冠": (: give_bonnet :),
    "gift": (: give_dan :),
    "礼物": (: give_dan :),
  ]));
  setup();
}

void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}
int call_tianmo() {
  object who = this_player();
  if (!who->query("family")) {
    message_vision("$N狠狠一脚，把$n踹到臭水沟里洗澡去了。\n", this_object(), this_player());
    command("say 等你拜了门派再来找我吧！");
    return 1;
  }
  if (this_player()->query("yudian/skills") == "got") {
    message_vision("$N对着$n叹了口气。\n", this_object(), this_player());
    command("say 你不是已经要过功夫了吗？何必这样贪心呢！");
    return 1;
  }
  who->set_skill("force", SKILLL);
  who->set_skill("spells", SKILLL);
  who->set_skill("literate", SKILLL);
  who->set_skill("dodge", SKILLL);
  who->set_skill("parry", SKILLL);
  who->set_skill("unarmed", SKILLL);
  who->set_skill("tianmo-force", SKILLL);
  who->set_skill("tianmo-dafa", SKILLL);
  who->set_skill("sword", SKILLL);
  who->set_skill("tianmo-zhang", SKILLL);
  who->set_skill("tianmo-qin", SKILLL);
  who->set_skill("tianmostep", SKILLL);
  who->set_skill("sword", SKILLL);
  who->set_skill("blade", SKILLL);
  who->set_skill("bingmo-sword", SKILLL);
  who->set_skill("music", SKILLL);
  who->set_skill("huomo-dao", SKILLL);
  who->set_skill("tianmo-qin", SKILLL);
  who->set_skill("bingmo-sword", SKILLL);
  who->map_skill("spells", "tianmo-dafa");
  who->map_skill("force", "tianmo-force");
  message_vision("大唐使者念动咒语：@#$%&%*#$##@@!。\n", this_object(), this_player());
  command("say 好了！");
  who->set("yudian/skills", "got");
  return 1;
}
