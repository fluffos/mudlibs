*/

  if (!leitai) leitai=load_object(__DIR__"npc_leitai");
  if (leitai->query("busy")) 
    return notify_fail("有人正在陪练台上交手，请稍候。\n");

 if( challenger->query("combat_exp") <5000 )               
    return notify_fail("你根基尚浅，这里不合适你。\n");  

  if (!challenger->query_temp("npc_leitai/givemoney")&&!wizardp(challenger)) 
    return notify_fail("你尚未付钱，不能享受这款服务。\n");  

  message_vision("$N迫不及待的进入了幻境！\n",challenger);
  if (challenger->move(leitai)) 
  {
    challenger->delete("env/brief_message");
    challenger->delete_temp("npc_leitai/challenge");
    challenger->delete_temp("npc_leitai/givemoney");
    challenger->set("env/invisibility", 0);
    leitai->set("player",challenger);
    leitai->set("busy",1);
    npc = new("/u/huarong/npc/npc_tiaozhan/"+list2[random(sizeof(list2))]);
    npc->copy_status(challenger);
    leitai->set("npc",npc);
    npc->move(leitai);
    call_out("start",5,leitai);
   }
  return 1;
}

