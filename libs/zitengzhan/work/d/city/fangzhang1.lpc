int do_leap();
void reset();

void create() {
  set("short", "秘室");
  set("long", @LONG

这里是方丈室的一间密室，是一间石屋，有天窗，但是很宽敞，开来可以
容纳不少人。房间里也只点了一盏小油灯，显的特别昏暗，是方丈的避难室。

LONG);
  set("outdoors", 0);
  set("no_fight", 1);
  set("no_magic", 1);
  set("objects",
    ([  //sizeof() == 1
    "/d/qujing/lingshan/npc/rulai2/npc/chili": 1,
    ]));

  setup();
}
void init() {
  add_action("do_push", "push");
  add_action("do_push", "tui");
  add_action("do_get", "get");
}

int do_push(string arg) {
  object me = this_player();
  int myeffstr = me->query_skill("unarmed", 1) / 10 - 2 + me->query("str");
  int mystr = me->query_str();
  int myforce = me->query("maximum_force");

  if (!arg || ((arg != "men")))
    return notify_fail("你要推什么？ \n");
  if (mystr < 30 || myeffstr < 20)
    return notify_fail("你力气太小了，推不动！ \n");
  if (me->is_busy())
    return notify_fail("你正忙着呢!\n");
  message_vision("$N推门的一刹那，一股奇怪的力量把$N拽到了另一间房间去了。\n", me);
  me->move(__DIR__ "fangzhang");
  message_vision("$N掉了下来。\n", me);
  return 1;
}
