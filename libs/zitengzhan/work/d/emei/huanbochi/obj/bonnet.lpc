#include <armor.h>
#include <ansi.h>
inherit HEAD;

void create()
{
        set_name(HIY"天师法冠"NOR, ({ "loyal bonnet", "bonnet", "hat" }) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else 
        {
                set("unit", "顶");
                set("long", "一顶黄色象牙玉法冠。\n");
                set("material", "steel");
                set("value", 0);
                set("no_sell", 1);
                set("no_put",1);
                set("armor_prop/armor",15);
                set("series_no",2);
                set("armor_prop/intelligence", 7);
                set("no_steal",1);              
        }
        setup();
}

