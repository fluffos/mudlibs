#include <weapon.h>
#include <ansi.h>
inherit FORK;

void create() {
  set_name("赤阴飞叉", ({ "chiyin cha", "fei cha", "fork", "cha" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("value", 0);
    set("material", "iron");
    set("long", "妙化真人漆章之师赤霞神君丙融修炼的法宝之一。\n");
    set("wield_msg", HIB "$N口念真言，幻化出一柄$n，擎在手中掂了掂。\n" NOR);
    set("series_no", 1);
    set("no_steal", 1);
    set("no_put", 1);
  }
  init_fork(185);
  setup();
  set("weapon_prop/ad_fork", 10);
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  object fb;
  int damage = 300;
  if (!me || !victim || !me->is_fighting(victim)
    || damage_bonus <= 0)
    return 0;
  if (victim->is_busy()
    || random(100) > (int)victim->query_skill("spells") / ((int)me->query_skill("spells") + (int)victim->query_skill("spells")) * 100) {
    fb = victim->query_temp("armor/FABAO");
    if (fb)
      damage = fb->protect_qi(damage);
    if (damage > 0)
      victim->receive_wound("kee", 300, me);
    return NOR RED "只见" + query("name") + "上放出一道暗赤叉影，径直卷向$n$l" NOR RED "！\n" NOR;
  }
  return 0;
}
