//法宝类道具，均是唯一的，如有人拿了，则刷新出来的是replace_file

#include <ansi.h>
#include <combat.h>
inherit ITEM;
inherit F_UNIQUE;

void create() {
  set_name(YEL "红蛟剪" NOR, ({ "hongjiao jian", "jian", "fabao" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("level", 50);                                //法宝等级，人物等级低于则无法使用
    set("value", 0);
    set("material", "shuijing");
    set("long", "妙化真人漆章之师赤霞神君丙融修炼的法宝之一。\n");
    set("replace_file", "/d/obj/flower/hua");       //替代文件
    set("series_no", 4);                             //法宝类型 1是武器 2是防具 其他是道具，不用装备
    set("damage", 500);                              //法宝基本伤害
    set("no_put", 1);
    set("class", "邪");                              //法宝属性 正|邪|中 法宝克制用到
    set("wuxing", "火");                             //法宝五行 五行加成五行相克用到 
    set("no_busy", 1);
  }
  setup();
}

int ji(string id) {
  string msg, limb, *limbs, wx;
  int xk, ap, dp, damage;
  object fb, target, me;
  me = environment();
  if (!me || !living(me))
    return 0;
  if (me->query("mana") < 1000)
    return notify_fail("你的法力不足。\n");
  if (!me->is_fighting())
    return notify_fail("你要对谁祭法宝？\n");
  if (time() < query("last_ji") + 5)
    return notify_fail(query("name") + "刚刚祭出过。\n");
  if (id) {
    target = present(id, environment(me));
    if (!target)
      return notify_fail("这里没有" + id + "。\n");
  } else target = SSERVER->offensive_target(me);
  if (!target || !me->is_fighting(target))
    return notify_fail("你要对谁祭" + query("name") + "？\n");

  set("last_ji", time());
  ap = me->query("daoxing") / 100000 + me->query("level") * 1000;
  dp = target->query("daoxing") / 100000 + target->query("level") * 1000;

  if (me->query("env/no_msg") || target->query("env/no_msg"))
    message_vision(
      YEL "$N" YEL "对$n" YEL "使用了法宝「" HIY + query("name") + NOR YEL "」。\n" NOR,
      me,
      target
    );
  else {
    msg = YEL "$N" YEL "右肩摇处，身上红蛟剪化作两道暗赤色的朱虹，剪尾电掣直奔$n" YEL "$l而来！\n" NOR;
    limbs = target->query("limbs");
    limb = limbs[random(sizeof(limbs))];
    msg = replace_string(msg, "$l", limb);
    message_vision(msg, me, target);
  }
  me->add("mana", -1000);
  if (random(100) > dp / (ap + dp) * 90) {
    damage = me->query("mana_factor");
    damage += query("damage");
    //法宝伤害的五行加成，
    if (wx = query("wuxing")) {
      xk = SPELL_D->wuxing_xs(SPELL_D->query_time_wuxing(), wx);
      if (xk == 1)
        damage = damage / 2;  //如果时辰五行克制法宝五行
        else if (xk == -1)
          damage += damage / 3;  //如果法宝五行克制时辰五行
    }
    fb = target->query_temp("armor/FABAO");  //对方身上的防具类法宝，新加了这个armor_type，方便查询
    if (fb)
      damage = fb->protect_shen(damage, query("wuxing"));  //对方防御法宝对伤害的抵消，双方法宝的五行相克在这里单独定义
      //同理，还有一个protect_qi(damage,wx)函数
      //这个函数扩展自原月宫法宝      
      if (damage > 0) {
        msg = COMBAT_D->damage_msg(damage, "刺伤");
        msg = replace_string(msg, "$w", "红蛟剪");
        msg = replace_string(msg, "$l", limb);
        message_vision(msg, me, target);
        target->receive_wound("kee", damage, me);
        COMBAT_D->report_status(target, 1);
      }
  } else message_vision(
    HIC "$N" HIC "哼！了一声：米粒之珠，也放光华？说罢，将手一指，结果血光大盛，" + query("name") + HIC "发出一声哀鸣，从半空落了下来。\n" NOR,
    target
  );
  return 1;
}
