#include <armor.h>
#include <ansi.h>
inherit EQUIP;

void create()
{
        set_name("血色道袍", ({ "xue daopao","daopao","pao","cloth" }) );
        set_weight(1600);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("material", "cloth");
                set("value", 0);
                set("armor_type","FABAO");
                set("armor_prop/armor",18);
                set("armor_prop/spells",10);
                set("armor_prop/ob_hit",3);
                set("armor_prop/remove_kee_damage",5);
                set("armor_prop/remove_sen_damage",5);
                set("armor_prop/redamage_eff_sen_damage",3);
                set("armor_prop/redamage_eff_kee_damage",3);
                set("series_no",2);
                set("wear_msg","$N穿上一件$n，顿时浑身上下笼罩在一片赤红血光之中。\n");
                set("unequip_msg","$N撤去了护身妖光。\n");
                set("no_steal",1);  
                set("wuxing","火");  
                set("class","邪");   
                set("no_busy",1);                         
        }
        setup();
}

varargs int protect_qi(int damage,string wx)
{
        int xk;
        if( damage<=0 || !environment() 
         || !living(environment()) )
                return damage;
        if( time()<query_temp("last_protect_qi")+5 )
                return damage;
        if( !wx )
                wx = SPELL_D->query_time_wuxing();              
        if( wx && query("wuxing") )
        {       
                xk = SPELL_D->wuxing_xs(query("wuxing"),wx);
                if( xk==1 )
                        damage = damage/2;
                else    damage = damage-damage*5/100;           
        }       
        set("last_protect_qi",time());  
        if( environment()->query("mana")>100 )
        {
                environment()->add("mana",-100);
                message_vision(HIR"$N"HIR"护身妖光闪了一闪，卸去了不少的伤害。\n"NOR,environment());
                return damage/3;
        }
        return  damage; 
}

