#include <ansi.h>
inherit NPC;

void create()
{
        set_name("幻波池",({"huanbo chi",}));
        set("allow_heal_up",1);
        setup();
}

void powerup()
{
        set("kee",query("max_kee"));
        set("eff_kee",query("max_kee"));
        set("sen",query("max_sen"));
        set("eff_sen",query("max_sen"));
        set("force",query("max_force")*2);
        set("mana",query("max_mana")*2);
}       

int copy_data(object who)
{
        mapping skill;
        string *skills;
        int i,wx,sk;
        if( is_fighting() )
                return 0;
        if( !who || !userp(who) )
                return 0;
        set_temp("my_killer",who);
        if( query("level")<who->query("level") )
                set("level",who->query("level"));
        if( query("noboss") )   
                wx = who->query("combat_exp")/100*85;   
        else    wx = who->query("combat_exp")/100*95;   
        if( query("combat_exp")>=wx )
                return 1;
        sk = CHINESE_D->wx_sk(who->query("combat_exp"));
        if( sk<=query_skill("force",1) )
                return 1;
        skill = query_skills();
        skills = keys(skill);
        for(i=0;i<sizeof(skills);i++)
                set_skill(skills[i],sk);
        set("max_force",(sk*30/2));
        set("max_mana",(sk*30/2));
        set("combat_exp",wx);
        if( query("daoxing")<wx )
                set("daoxing",wx);
        set("mana_factor",sk*3/2);
        if( query("max_kee")<who->query("max_kee")*10 )
                set("max_kee",who->query("max_kee")*10);
        if( query("max_sen")<who->query("max_sen")*10 )
                set("max_sen",who->query("max_sen")*10);
        powerup();      
#ifdef SDS_D
        SDS_D->powerup(this_object());
#endif                  
        return 1;
}

void reward_ob(object who){return;}             

void super_attack(object who){ return; }

void kill_ob(object who)
{
        object target;
        if( !who || !environment() )
                return;
        if( query("owner") && who==query("owner") )
        {
                tell_object(who,CYN+query("name")+CYN"说道：这位道友，你着相了。\n"NOR);
                tell_object(who,query("name")+"不想和你动手。\n");
                who->remove_killer(this_object());
                this_object()->remove_killer(who);
                return;
        }
        if( userp(who) )
        {
                if( target=query_temp("my_killer") )
                {
                        if( who!=target || !present(target,environment()) )
                        {
                                delete_temp("my_killer");
                                tell_object(who,query("name")+"不想和你动手。\n");
                                who->remove_killer(this_object());
                                this_object()->remove_killer(who);
                                set("start_time",time()-600);                           
                                return;
                        }       
                }
                if( !query_temp("my_killer") )
                {
                        message_vision(CYN"$N"CYN"高傲的朝$n"CYN"瞥了一眼，然后不屑的从舌尖上吐出一个字“切”。\n",this_object(),who);
                        tell_object(who,CYN+query("name")+CYN"说道："+RANK_D->query_rude(who)+"，你不是"+RANK_D->query_self_rude(this_object())+"的对手。\n"NOR);      
                        tell_object(who,query("name")+"不想和你动手。\n");
                        who->remove_killer(this_object());
                        this_object()->remove_killer(who);
                        set("start_time",time()-600);
                        return;
                }
        }       
        if( query("kill_msg") )
                message_vision(query("kill_msg"),this_object());
        else    message_vision(CYN"$N"CYN"说道：要了你的命！\n"NOR,this_object());
        if( !query_temp("getdd/zhenshens") )
                command("zhenshens changeup");
        if( who->query("env/invisibility") )
                set("env/invisibility",1);
        else    set("env/invisibility",0);                      
        ::kill_ob(who);
}       


int sort_skill(string file)
{
        int i;
        if( !sscanf(file, "%*s.lpc") )  
                return 0;
        i = strlen(file);
        while(i--)
        {
                if( file[i] == '.' ) 
                        continue;
                if( file[i] < 'a' || file[i] > 'z' )
                        return 0;
        }
        return 1;
}

string checkSkill(string arg)
{
        int i;
        string *str,sk,exert,*file;
        object newSk,who=this_object();
        mapping skill;

        skill = who->query_skills();

        if( !skill || !mapp(skill) )  
                return 0;
        if( !skill[arg] )    
                return 0;
        str = keys(skill);
        for( i=0;i<sizeof(str);i++ )
        {
                if( who->query_skill_mapped(arg)==str[i] )
                {
                        sk = str[i];
                        break;
                }
        }
        if( !sk || !stringp(sk) )     
                return 0;
        if(file_size("/daemon/skill/"+sk+".lpc") < 1)
                return 0;
        if( (exert=("/daemon/skill/"+sk+".lpc")->perform_action_file("")) 
         && stringp(exert) )
        {
                file = get_dir(exert);
                if( sizeof(file)>0 )
                        file = filter_array(file, (: sort_skill :) );
        }
        else    return 0;
        if( sizeof(file)<=0 )
                return 0;

        i = random(sizeof(file));
        if( !file[i] )  
                return 0;
        exert = replace_string(file[i],".lpc","");
        set_temp("sdsd/checkskill",exert);
        return exert;
}

varargs void randomPfm()
{
        string arg,exert;
        object weapon,who=this_object();
        
        if( !who || !who->is_fighting() )
                return; 
        if( time()<query_temp("last_pfm")+1 )
                return; 
        if( !objectp(weapon=who->query_temp("weapon")) )
               arg = "unarmed";
        else   arg = weapon->query("skill_type");
        if( !arg || !stringp(arg) )   
                arg = "unarmed";
        exert = checkSkill(arg);
        if( !exert || !stringp(exert) )  
                return;
        set_temp("last_pfm",time());    
        if( !who->perform_action(arg,exert) )
                who->command("perform "+exert);
}

void heart_beat()
{
        int i,t,bb;
        mixed foo;
        object target;
        t = query("stay_time");
        if( t<=0 ) 
                t = 600;
        if( query("start_time")
         && time()>query("start_time")+t 
         && !this_object()->is_fighting() 
         && environment() 
         && ( !query("owner") || !environment(query("owner"))->is_huanbo()) )
        {
                foo = query("leave_msg");
                if( !foo )
                        message_vision("$N将身一滚，化成一溜青光，冲天而去。。\n",this_object());
                else if( stringp(foo) )
                        message_vision(foo,this_object());
                else if( arrayp(foo) )
                {
                        for(i=0;i<sizeof(foo);i++)
                                if( foo[i] )
                                        message_vision(foo[i],this_object());
                }                       
                destruct(this_object());
                return;         
        }
        if( !this_object()->is_fighting()
         && ( query("kee")<query("max_kee")
           || query("sen")<query("max_sen") ) )
        {
                powerup();
                set("force",query("max_force")*2);
                set("mana",query("max_mana")*2);
        }                                  
           
        if( query("eff_kee") < query("max_kee") && present("jinchuang yao") )
        {
                command("eat yao");
                command("eat yao");
        }       
        if( query("eff_sen") < query("max_sen") && present("hunhuan dan") )
        {
                command("eat dan");
                command("eat dan");
        }
        if( query("kee") < query("eff_kee") && query("force")>0 )
                command("exert recover");
        if( query("sen") < query("eff_sen") && query("force")>0 )
                command("exert refresh");
#ifdef SDS_D
        if( query("eff_kee") < query("max_kee") && query("force")>0 )
                SDS_D->addEffKee(this_object());
        if( query("kee") < query("eff_kee") && query("force")>0 )
                SDS_D->addKee(this_object());
        if( query("sen") < query("eff_sen") && query("force")>0 )
                SDS_D->addSen(this_object());
        if( query("eff_sen") < query("max_sen") && query("force")>0 )
                SDS_D->addEffSen(this_object());
#endif
        
        target = query_temp("my_killer");
        if( target )
        {
                bb = (int)query_busy();
                if( bb>0 )
                {
                        this_object()->start_busy(1,10000); 
                        this_object()->interrupt_me(this_object(),"道");  
                        this_object()->reset_action();  
                }
                if( query("remove_weapon") )
                {
                        if( time()>=query("remove_time")+t )
                        {
                                if( !query_temp("weapon") )
                                        command("wield "+query("remove_weapon"));
                                else    command("unwield "+query("remove_weapon"));
                        }       
                }
                randomPfm();
                super_attack(target);
                if( bb>=3 )
                        this_object()->start_busy(bb/3);        
                set("remove_time",time());      
        }       
        ::heart_beat();
}

void init()
{
        if( !query("start_time") 
         && userp(this_player()) )
                set("start_time",time());
        ::init();       
}                               

void unconcious()
{
        die();
}

void return_home(object ob)
{
        int t;
        object *team,leader;
        if( !environment() )
                ::return_home(ob);
        team = query_team();
        if( team && arrayp(team) )
        {
                leader = team[0];
                if( leader 
                 && environment(leader)->is_huanbo() )
                        return;          
        }
        if( query("owner") 
         && environment(query("owner"))->is_huanbo() )
                return;
        t = query("stay_time");                 
        if( t<=0 ) 
                t = 600; 
        if( query("start_time")
         && time()<query("start_time")+t )
                return;
        delete_temp("my_killer");       
        ::return_home(ob);      
}

int is_huanbo(){return 1;}
