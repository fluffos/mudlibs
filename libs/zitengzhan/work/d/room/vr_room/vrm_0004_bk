inherit VRM_SERVER;
#include <vrm.h>

void create()
{
   
    // 迷宫房间所继承的物件的档案名称。
    set_inherit_room( ROOM );

    // 迷宫进入要求最低等级。
    set_enter_min_level(3);

    // 迷宫进入要求最高等级。
    set_enter_max_level(3);

    // 迷宫房间时间ID和刷新时间。
    set_build_time("VRM_0004");

    //迷宫房间里的怪物。
//   set_maze_npcs(VRM_NPC"0004/guard");
   set_maze_npcs(VRM_NPC"0002/guard");

    // 迷宫中的怪物出现可能性
    set_maze_npcs_rate(70);

    //迷宫房间里的BOSS。
//   set_maze_boss(VRM_NPC"0004/boss");
   set_maze_boss(VRM_NPC"0002/boss");

    //迷宫的单边长
    set_maze_long(9);

    //入口方向(出口在对面)
    set_entry_dir("west");

    //入口与区域的连接方向
    set_link_entry_dir("out");

    //入口与区域的连接档案名
    set_link_entry_room("/d/changan/aolaiws");

    //出口与区域的连接方向
    set_link_exit_dir("out");

    //出口与区域的连接档案名
    set_link_exit_room("/d/changan/aolaiws");

    //入口房间短描述
    set_entry_short("冥河入口");

    //入口房间描述
    set_entry_desc(@LONG
这里就是传说中的血海冥河！据说是盘古开天身陨后体内污血所化，乃极阴之地。
血海冥河中有一神通广大的人物，名叫冥河老祖，元神化作三亿血神子，血海不枯
元神不灭！更是一手创造出了阿修罗一族！
LONG
);

    //BOSS房间短描述
    set_exit_short("血海中央");

    //BOSS房间描述
    set_exit_desc("此处便是血海中央，四周血红色的海水波涛汹涌，时而掀起万丈巨浪，声势浩大。");

    //迷宫房间的短描述
    set_maze_room_short("血海冥河");

    //迷宫房间的描述，如果有多条描述，制造每个房
    //间的时候会从中随机选择一个。
    set_maze_room_desc(@LONG
这里就是传说中的血海冥河！据说是盘古开天身陨后体内污血所化，乃极阴之地。
血海冥河中有一神通广大的人物，名叫冥河老祖，元神化作三亿血神子，血海不枯
元神不灭！更是一手创造出了阿修罗一族！
LONG
);

    // 迷宫房间是否为户外房间？
    //set_outdoors(1);
}
