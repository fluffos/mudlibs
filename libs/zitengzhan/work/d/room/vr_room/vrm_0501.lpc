//2009/11/18 by xdao

inherit VRM_SERVER;
#include <vrm.h>

void create()
{
   
    // 迷宫房间所继承的物件的档案名称。
    set_inherit_room( ROOM );

    // 迷宫进入要求最低等级。
    set_enter_min_level(0);

    // 迷宫进入要求最高等级。
    set_enter_max_level(10);

    // 迷宫房间时间ID和刷新时间。
    set_build_time("VRM_0501");

    //迷宫房间里的怪物。
    set_maze_npcs(VRM_NPC"0501/guard");

    // 迷宫中的怪物出现可能性
    set_maze_npcs_rate(100);

    //迷宫房间里的BOSS。
    set_maze_boss(VRM_NPC"0501/boss");

    //迷宫的单边长
    set_maze_long(7);

    //入口方向(出口在对面)
    set_entry_dir("south");

    //入口与区域的连接方向
    set_link_entry_dir("out");

    //入口与区域的连接档案名
    set_link_entry_room("/d/southern/wutai/guandao3");

    //出口与区域的连接方向
    set_link_exit_dir("out");

    //出口与区域的连接档案名
    set_link_exit_room("/d/southern/wutai/guandao3");

    //入口房间短描述
    set_entry_short("蛇洞入口");

    //入口房间描述
    set_entry_desc(@LONG
这里就是蛇洞了，周围杂草丛生，草丛里不时传来悉悉索索的声音。
越往里走，越是黑暗。阵阵阴风从洞内深处吹来，让人不禁而寒。
LONG
);

    //BOSS房间短描述
    set_exit_short("蛇王窟");

    //BOSS房间描述
    set_exit_desc("这里是蛇洞的最深处，只见一条硕大无比的巨蛇盘在洞内，正高昂着蛇头对你看。");

    //迷宫房间的短描述
    set_maze_room_short("蛇洞内");

    //迷宫房间的描述，如果有多条描述，制造每个房
    //间的时候会从中随机选择一个。
    set_maze_room_desc(@LONG
这里就是蛇洞了，周围杂草丛生，草丛里不时传来悉悉索索的声音。
越往里走，越是黑暗。阵阵阴风从洞内深处吹来，让人不禁而寒。
LONG
);

    // 迷宫房间是否为户外房间？
    //set_outdoors(1);
}