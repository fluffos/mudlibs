//2009/11/18 by xdao

inherit VRM_SERVER; 
#include <vrm.h>

void create()
{
   
    // 迷宫房间所继承的物件的档案名称。
    set_inherit_room( ROOM );

    // 迷宫进入要求最低等级。
    set_enter_min_level(4);

    // 迷宫进入要求最高等级。
    set_enter_max_level(4);

    // 迷宫房间时间ID和刷新时间。
    set_build_time("VRM_0005");

    //迷宫房间里的怪物。
    set_maze_npcs(VRM_NPC"0005/guard");

    // 迷宫中的怪物出现可能性
    set_maze_npcs_rate(80);

    //迷宫房间里的BOSS。
    set_maze_boss(VRM_NPC"0005/boss");

    //迷宫的单边长
    set_maze_long(9);

    //入口方向(出口在对面)
    set_entry_dir("north");

    //入口与区域的连接方向
    set_link_entry_dir("out");

    //入口与区域的连接档案名
    set_link_entry_room("/d/moon/butian");

    //出口与区域的连接方向
    set_link_exit_dir("out");

    //出口与区域的连接档案名
    set_link_exit_room("/d/moon/butian");

    //入口房间短描述
    set_entry_short("上古洪荒入口");

    //入口房间描述
    set_entry_desc(@LONG
你深吸一口气，便感觉此处灵气浓郁，处处是高耸入云的苍天巨木。
远处传来阵阵洪荒巨兽的嚎叫厮打声！地上波动越来越强，好像有
巨型猛兽在向你靠近。极远之处还有一座无边无际的巨山！高万万丈！
LONG
);

    //BOSS房间短描述
    set_exit_short("不周山");

    //BOSS房间描述
    set_exit_desc("这里便是洪荒的中心--不周山，相传不周山乃盘古开天身陨后的脊髓所化。");

    //迷宫房间的短描述
    set_maze_room_short("上古洪荒");

    //迷宫房间的描述，如果有多条描述，制造每个房
    //间的时候会从中随机选择一个。
    set_maze_room_desc(@LONG
你深吸一口气，便感觉此处灵气浓郁，处处是高耸入云的苍天巨木。
远处传来阵阵洪荒巨兽的嚎叫厮打声！地上波动越来越强，好像有
巨型猛兽在向你靠近。极远之处还有一座无边无际的巨山！高万万丈！
LONG
);

    // 迷宫房间是否为户外房间？
    //set_outdoors(1); 
}