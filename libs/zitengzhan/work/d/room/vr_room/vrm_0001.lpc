//2009/11/18 by xdao

inherit VRM_SERVER;
#include <vrm.h>

void create()
{
   
    // 迷宫房间所继承的物件的档案名称。
    set_inherit_room( ROOM );

    // 迷宫进入要求最低等级。
    set_enter_min_level(0);

    // 迷宫进入要求最高等级。
    set_enter_max_level(0);

    // 迷宫房间时间ID和刷新时间。
    set_build_time("VRM_0001");

    //迷宫房间里的怪物。
    set_maze_npcs(VRM_NPC"0001/guard");

    // 迷宫中的怪物出现可能性
    set_maze_npcs_rate(90);

    //迷宫房间里的BOSS。
    set_maze_boss(VRM_NPC"0001/boss");

    //迷宫的单边长
    set_maze_long(8);

    //入口方向(出口在对面)
    set_entry_dir("south");

    //入口与区域的连接方向
    set_link_entry_dir("out");

    //入口与区域的连接档案名
    set_link_entry_room("/d/changan/fendui");

    //出口与区域的连接方向
    set_link_exit_dir("out");

    //出口与区域的连接档案名
    set_link_exit_room("/d/changan/fendui");

    //入口房间短描述
    set_entry_short("埋骨之地入口");

    //入口房间描述
    set_entry_desc(@LONG
周围已看不大清楚了。偶有阵阵阴风袭来，让人不禁感觉毛骨悚然。
地上满是遗骸，四处漂浮着游荡的鬼火，隐隐还能听见嚎叫声，远处
好像耸立着一副巨大的骨架。
LONG
);

    //BOSS房间短描述
    set_exit_short("神之遗骸");

    //BOSS房间描述
    set_exit_desc("这里是埋骨之地的尽头了，高高耸立着一副巨大的遗骸，遗骸浑身散发着夺目的光彩。");

    //迷宫房间的短描述
    set_maze_room_short("埋骨之地");

    //迷宫房间的描述，如果有多条描述，制造每个房
    //间的时候会从中随机选择一个。
    set_maze_room_desc(@LONG
周围已看不大清楚了。偶有阵阵阴风袭来，让人不禁感觉毛骨悚然。
地上满是遗骸，四处漂浮着游荡的鬼火，隐隐还能听见嚎叫声，远处
好像耸立着一副巨大的骨架。
LONG
);

    // 迷宫房间是否为户外房间？
    //set_outdoors(1);
}
