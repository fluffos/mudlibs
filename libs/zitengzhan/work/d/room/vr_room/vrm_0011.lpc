//2009/11/18 by xdao

inherit VRM_SERVER;
#include <vrm.h>

void create() {

  // 迷宫房间所继承的物件的档案名称。
  set_inherit_room(ROOM);

  // 迷宫进入要求最低等级。
  set_enter_min_level(5);

  // 迷宫进入要求最高等级。
  set_enter_max_level(5);

  // 迷宫房间时间ID和刷新时间。
  set_build_time("VRM_0011");

  //迷宫房间里的怪物。
  set_maze_npcs(VRM_NPC "0011/guard");

  // 迷宫中的怪物出现可能性
  set_maze_npcs_rate(80);

  //迷宫房间里的BOSS。
  set_maze_boss(VRM_NPC "0011/boss");

  //迷宫的单边长
  set_maze_long(10);

  //入口方向(出口在对面)
  set_entry_dir("north");

  //入口与区域的连接方向
  set_link_entry_dir("out");

  //入口与区域的连接档案名
  set_link_entry_room("/d/33tian/33tian");

  //出口与区域的连接方向
  set_link_exit_dir("out");

  //出口与区域的连接档案名
  set_link_exit_room("/d/33tian/33tian");

  //入口房间短描述
  set_entry_short("归墟入口");

  //入口房间描述
  set_entry_desc(@LONG
这里是归墟之境，据说是鸿钧道祖从上一宇宙带来的空间！
空间内全是先天混沌之气，不知何处是乾坤。
LONG
  );

  //BOSS房间短描述
  set_exit_short("紫霄宫");

  //BOSS房间描述
  set_exit_desc("\n
      这里就是鸿钧道祖的道场--紫霄宫
  有诗云： 高卧九重云    蒲团了道真 
           天地玄黄外   吾当掌教尊 
           盘古生太极   两仪四象循
           一道传三友   二教阐截分
           玄门都领袖   一气化鸿钧
");

  //迷宫房间的短描述
  set_maze_room_short("归墟");

  //迷宫房间的描述，如果有多条描述，制造每个房
  //间的时候会从中随机选择一个。
  set_maze_room_desc(@LONG
这里是归墟之境，据说是鸿钧道祖从上一宇宙带来的空间！
空间内全是先天混沌之气，不知何处是乾坤。
LONG
  );

  // 迷宫房间是否为户外房间？
  //set_outdoors(1);
}
