// Room: /d/33tian/33tian
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "离恨天");
  set("long", @LONG

这里就是天的尽头。抬头望去，上面是白茫茫的一片，白云从你指间
流过。你的脚下就是天宫了，隐约能看到雕栏画栋，听到丝竹笙歌，
光彩流动，奇丽不可名状。这里没有昼夜之分，只有空气中不时传来
缕缕清香，令人感到平静安宁。
LONG);

  set("light_up", 1);
  set("exits", ([ /* sizeof() == 1 */
    "west": __DIR__ "west1",
#if VRM_0011_SUPPORT
    "north": VRM_DIR "VRM_0011/entry",
#endif
  ]));

  setup();
}

int valid_leave(object me, string dir) {
  int i;
  object *inv;
  int zslev, exp, dx, xz;
  zslev = 0;
  exp = me->query("combat_exp");
  dx = me->query("daoxing");
  xz = 20000000;
  zslev = me->query("lunhui_zhuanshi");
  inv = all_inventory(this_player());
  for (i = 0; i < sizeof(inv); i++)
    if (dir == "north" && userp(inv[i])) {
      message_vision(HIM "一股强大的力量阻止了你。\n" NOR, this_player());
      me->start_busy(3);
      return notify_fail("");
    }

  if (dir == "north" && exp < xz) {
    me->start_busy(3);
    return notify_fail(HIW " 你的武学不够高，就别去送死了\n" NOR);
    return notify_fail("");
  }

  if (dir == "north" && dx < xz) {
    me->start_busy(3);
    return notify_fail(HIW " 你的道行不够高，就别去送死了\n" NOR);
    return notify_fail("");
  }

  if (dir == "north" && zslev != 5) {
    me->start_busy(3);
    return notify_fail(HIW "  只有五转的玩家才能进入" HIM " 归墟 " HIW "！\n" NOR);
    return notify_fail("");
  }
  return ::valid_leave(me, dir);
}
