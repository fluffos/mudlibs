//by seawind
inherit ROOM;
string look_stone();
string do_quit(string arg);
void finish(int);
void fullup(object);
void create()
{
	set("short", "灵鹫仙境");
	set("long", @LONG
天地鹤翔。十方神佛的净土，沐浴着仙风灵气，一切显得那么高雅，娴静，却又暗藏杀机！不起眼的角落
上有个试剑石(stone) ，你想要什么？
LONG );
        set("outdoors", "city");
	set("item_desc", ([
		"stone" : (: look_stone :),
	]));

	set("exits", ([
		"up"        : __DIR__"wizroom",
		"eastdown"  : __DIR__"under1",
		"westdown"  : __DIR__"under2",
		"southdown" : __DIR__"under3",
		"northdown" : __DIR__"under4",
	]));
	set("objects", ([
                __DIR__"npc/referee": 1,
//                "/d/npc/wwb": 1,
	]));
	set("no_clean_up", 0);
	set("no_openstone", 1);
	setup();
}

string look_stone()
{
	return 
"\n
一块很有年头的大石头，上头布满绿斑。
架上插满了: 
                 钢刀(blade)    长剑(sword)
                 钢杖(staff)    长鞭(whip)
                 铁锤(hammer)   长棍(stick)
                 暗器(throwing) 短兵(dagger)
                 钢甲(armor)

参加比武者可以按需要，随便拿取(take)使用。

                                天上人间擂台  敬启
\n";
}

void init()
{
add_action("do_quit","quit");
add_action("do_quit","move");
add_action("do_quit","mark");
add_action("do_quit","fly");
add_action("do_quit","chuqiao");
add_action("do_quit","qiankun");
add_action("do_quit","heijie");
add_action("do_quit","jieti");
add_action("do_quit","escape");
add_action("do_quit","tudun");
add_action("do_quit","shuidun");
add_action("do_quit","bian");
add_action("do_quit","surrender");
add_action("do_quit","accept");
add_action("do_quit","lian");
}
int valid_leave(object me, string dir)
{
        if( dir=="up" && !wizardp(me) )
                return notify_fail("仙境只有被特邀才能进去。\n");
	me->set_temp("view_leitai",1);
        return ::valid_leave(me, dir);
}

int do_open()
{
	if(wizardp(this_player()))
	{
		message_vision("$N念了几句咒语，石头突然有了灵气！\n", this_player());
		this_object()->delete("no_openstone");
		return 1;
	}
	else return 0;
}
int do_close()
{
	if(wizardp(this_player()))
	{
		message_vision("$N念了几句咒语，石头傻了！\n", this_player());
		this_object()->set("no_openstone", 1);
		return 1;
	}
	else return 0;
}
int do_take(string arg)
{
	object obj,ob;
	ob = this_player();
	if(this_object()->query("no_openstone"))
	{
		message_vision("石头瞪了你一眼，pig你想干什么?\n", ob);
		return 1;
	}
	if( !arg || arg=="" )
	{
		message_vision("$N站在石头前，傻了，不知道要什么兵器好！\n", ob);
		return 1;
	}
	switch (arg)
	{
		case "sword":
			obj = new("/d/leitai/weapon/sword");
			obj -> move(ob);
			message_vision("$N从石头上取下一口长剑。\n",ob);
			break;
		case "blade":
			obj = new("/d/leitai/weapon/sword");
			obj -> move(ob);
			message_vision("$N从石头上取下一口钢刀。\n",ob);
			break;
		case "staff":
			obj = new("/d/leitai/weapon/sword");
			obj -> move(ob);
			message_vision("$N从石头上取下一杆钢杖。\n",ob);
			break;
		case "whip":
			obj = new("/d/leitai/weapon/sword");
			obj -> move(ob);
			message_vision("$N从石头上取下一条长鞭。\n",ob);
			break;
		case "club":
			obj = new("/d/leitai/weapon/sword");
			obj -> move(ob);
			message_vision("$N从石头上取下一条齐眉棍。\n",ob);
			break;
		case "hammer":
			obj = new("/d/leitai/weapon/sword");
			obj -> move(ob);
			message_vision("$N从兵器架上取下一把铁锤。\n",ob);
			break;
		case "throwing":
			obj = new("/d/leitai/weapon/sword");
			obj -> move(ob);
			message_vision("$N从石头上取下一包铁莲子。\n",ob);
			break;
		case "dagger":
			obj = new("/d/leitai/weapon/sword");
			obj -> move(ob);
			message_vision("$N从石头上取下一把匕首。\n",ob);
			break;
		case "armor":
			obj = new("/d/leitai/weapon/sword");
			obj -> move(ob);
			message_vision("$N从石头上取下一副铁甲。\n",ob);
			break;
		default:
			message_vision("$N站在石头前，还没想好要什么兵器。\n", ob);
	}
	return 1;
}
int do_quit(string arg) 
{
write("你不能在这里用这条命令。\n");
//if (wizardp(this_player())) write("巫师请参阅同一路径内的banned.h文档。\n");
return 1;
}

void fullup(object obj) 
{
string *conditions;
int *condition_values;

if (!obj) return;
  obj->set("kee",(int)obj->query_temp("leitai/kee"));
  obj->set("eff_kee",(int)obj->query_temp("leitai/eff_kee"));
  obj->set("sen",(int)obj->query_temp("leitai/sen"));
  obj->set("eff_sen",(int)obj->query_temp("leitai/eff_sen"));
  obj->set("force", (int)obj->query_temp("leitai/force"));
  obj->set("mana",(int)obj->query_temp("leitai/mana"));

  obj->clear_condition();
  if (conditions=obj->query_temp("leitai/conditions")) {
    condition_values=obj->query_temp("leitai/condition_values");
    for (int i=0;i<sizeof(conditions);i++) 
       obj->apply_condition(conditions[i],condition_values[i]);
  }
int do_quit(string arg) 
{
write("你不能在这里用这条命令。\n");
if (wizardp(this_player())) write("巫师请参阅同一路径内的banned.h文档。\n");
return 1;
}