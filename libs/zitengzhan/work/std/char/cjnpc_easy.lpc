inherit NPC;

#include <ansi.h>

string *banned_cast = ({ "chuqiao", "qiankun", "jieti", "jinsheng", "love", "jiushen" });
string *banned_perform = ({ "badao" });
string *banned_action = ({ "ji", "quit" });

object offensive_target(object me) {
  int sz;
  object *enemy;

  enemy = me->query_enemy();
  if (!enemy || !arrayp(enemy)) return 0;

  sz = sizeof(enemy);
  if (sz > 4) sz = 4;

  if (sz > 0) return enemy[random(sz)];
  else return 0;
}


void init() {
  ::init();
  add_action("do_ji", "ji");
  add_action("do_perform", "perform");
  add_action("do_bian", "bian");
  //        add_action("do_tianlong","tianlong");
  //        add_action("do_cast","cast");
  //        add_action("do_quit","quit");
}

int do_ji(string arg, object ob) {
  object me = this_object();
  ob = offensive_target(me);
  if (!arg) return 0;
  if (!me->is_fighting(ob)) return 0;
  if (!userp(ob)) return 0;
  message_vision("$N冷笑一声：你想耍什么花样？\n", me);
  return 1;
}


int do_quit(string arg) {
  object me = this_object();
  message_vision("$N冷笑一声：哪里走!\n", me);
  return 1;
}

int do_perform(string arg, object ob) {
  object me = this_object();
  ob = offensive_target(me);
  if (!arg) return 0;
  while (sscanf(arg, "%s %*s", arg) == 2);
  if (member_array(arg, banned_perform) == -1) return 0;
  if (!me->is_fighting(ob)) return 0;
  message_vision("$N冷笑一声：你想耍什么花样？\n", me);
  return 1;
}
int do_bian(string arg) {
  object me = this_object();
  if (!arg) return 0;
  while (sscanf(arg, "%s %*s", arg) == 2);
  if (!arg == this_object()->id(arg)) return 0;
  message_vision("$N冷笑一声：你想耍什么花样？\n", me);
  return 1;
}

int do_tianlong(string arg) {
  object me = this_object();
  if (!arg) return 0;
  while (sscanf(arg, "%s %*s", arg) == 2);
  if (!arg == this_object()->id(arg)) return 0;
  message_vision("$N冷笑一声：你想耍什么花样？\n", me);
  return 1;
}


int do_cast(string arg) {
  object me = this_object();
  if (!arg) return 0;
  while (sscanf(arg, "%s %*s", arg) == 2);
  if (member_array(arg, banned_cast) == -1) return 0;
  message_vision("$N冷笑一声：你想耍什么花样？\n", me);
  return 1;
}


void check2() {
  int i, k;
  object ob = this_object();
  object me = query_temp("my_killer");
  object weapon, weapon1, weapon2, *inv;
  inv = all_inventory(ob);
  i = sizeof(inv);
  if (ob->query_skill("sword")) {
    ob->delete_temp("have/sword");
    for (k = 0; k < i; k++) {
      if (inv[k]->query("skill_type") == "sword" || inv[k]->query("apply/skill_type") == "sword") {
        set_temp("have/sword", 1);
      }
    }
    if (!query_temp("have/sword")) {
      if (query("family/family_name") == "大雪山") weapon1 = new("/d/obj/weapon/sword/fenghuangqin");
      else weapon1 = new("/d/obj/weapon/sword/mujian");
      weapon1->move(ob);
      message_vision(HIW "只见白光一闪，$N" + HIW + "的手里多了柄" + weapon1->query("name") + "！\n" NOR, ob);
    }
  }
  if (ob->query_skill("blade")) {
    ob->delete_temp("have/blade");
    for (k = 0; k < i; k++) {
      if (inv[k]->query("skill_type") == "blade" || inv[k]->query("apply/skill_type") == "blade") {
        set_temp("have/blade", 1);
      }
    }
    if (!query_temp("have/blade")) {
      if (query("family/family_name") == "大雪山") weapon1 = new("/d/obj/weapon/blade/iceblade");
      else weapon1 = new("/d/obj/weapon/blade/zhudao");
      weapon1->move(ob);
      message_vision(HIW "只见白光一闪，$N" + HIW + "的手里多了柄" + weapon1->query("name") + "！\n" NOR, ob);
    }
  }
  if (ob->query_skill("mace")) {
    ob->delete_temp("have/mace");
    for (k = 0; k < i; k++) {
      if (inv[k]->query("skill_type") == "mace" || inv[k]->query("apply/skill_type") == "mace") {
        set_temp("have/mace", 1);
      }
    }
    if (!query_temp("have/mace")) {
      weapon1 = new("/d/obj/weapon/mace/bamboo");
      weapon1->move(ob);
      message_vision(HIW "只见白光一闪，$N" + HIW + "的手里多了柄" + weapon1->query("name") + "！\n" NOR, ob);
    }
  }
  if (ob->query_skill("stick")) {
    ob->delete_temp("have/stick");
    for (k = 0; k < i; k++) {
      if (inv[k]->query("skill_type") == "stick" || inv[k]->query("apply/skill_type") == "stick") {
        set_temp("have/stick", 1);
      }
    }
    if (!query_temp("have/stick")) {
      weapon1 = new("/d/obj/weapon/stick/shuzhi");
      weapon1->move(ob);
      message_vision(HIW "只见白光一闪，$N" + HIW + "的手里多了柄" + weapon1->query("name") + "！\n" NOR, ob);
    }
  }
  if (ob->query_skill("spear")) {
    ob->delete_temp("have/spear");
    for (k = 0; k < i; k++) {
      if (inv[k]->query("skill_type") == "spear" || inv[k]->query("apply/skill_type") == "spear") {
        set_temp("have/spear", 1);
      }
    }
    if (!query_temp("have/spear")) {
      weapon1 = new("/d/obj/weapon/spear/muqiang");
      weapon1->move(ob);
      message_vision(HIW "只见白光一闪，$N" + HIW + "的手里多了柄" + weapon1->query("name") + "！\n" NOR, ob);
    }
  }
  if (ob->query_skill("hammer")) {
    ob->delete_temp("have/hammer");
    for (k = 0; k < i; k++) {
      if (inv[k]->query("skill_type") == "hammer" || inv[k]->query("apply/skill_type") == "hammer") {
        set_temp("have/hammer", 1);
      }
    }
    if (!query_temp("have/hammer")) {
      weapon1 = new("/d/obj/weapon/hammer/hammer");
      weapon1->move(ob);
      message_vision(HIW "只见白光一闪，$N" + HIW + "的手里多了柄" + weapon1->query("name") + "！\n" NOR, ob);
    }
  }
  if (ob->query_skill("fork")) {
    ob->delete_temp("have/fork");
    for (k = 0; k < i; k++) {
      if (inv[k]->query("skill_type") == "fork" || inv[k]->query("apply/skill_type") == "fork") {
        set_temp("have/fork", 1);
      }
    }
    if (!query_temp("have/fork")) {
      weapon1 = new("/d/sea/obj/mucha");
      weapon1->move(ob);
      message_vision(HIW "只见白光一闪，$N" + HIW + "的手里多了柄" + weapon1->query("name") + "！\n" NOR, ob);
    }
  }
  if (ob->query_skill("axe")) {
    ob->delete_temp("have/axe");
    for (k = 0; k < i; k++) {
      if (inv[k]->query("skill_type") == "axe" || inv[k]->query("apply/skill_type") == "axe") {
        set_temp("have/axe", 1);
      }
    }
    if (!query_temp("have/axe")) {
      weapon1 = new("/d/obj/weapon/axe/ironaxe");
      weapon1->move(ob);
      message_vision(HIW "只见白光一闪，$N" + HIW + "的手里多了柄" + weapon1->query("name") + "！\n" NOR, ob);
    }
  }
  if (ob->query_skill("staff")) {
    ob->delete_temp("have/staff");
    for (k = 0; k < i; k++) {
      if (inv[k]->query("skill_type") == "staff" || inv[k]->query("apply/skill_type") == "staff") {
        set_temp("have/staff", 1);
      }
    }
    if (!query_temp("have/staff")) {
      weapon1 = new("/d/obj/weapon/staff/shugan");
      weapon1->move(ob);
      message_vision(HIW "只见白光一闪，$N" + HIW + "的手里多了柄" + weapon1->query("name") + "！\n" NOR, ob);
    }
  }

  if (ob->query_skill("whip")) {
    ob->delete_temp("have/whip");
    for (k = 0; k < i; k++) {
      if (inv[k]->query("skill_type") == "whip" || inv[k]->query("apply/skill_type") == "whip") {
        set_temp("have/whip", 1);
      }
    }
    if (!query_temp("have/whip")) {
      weapon1 = new("/d/obj/weapon/whip/wuchou");
      weapon1->move(ob);
      message_vision(HIW "只见白光一闪，$N" + HIW + "的手里多了柄" + weapon1->query("name") + "！\n" NOR, ob);
    }
  }
  remove_call_out("check2");
  call_out("check2", 2);
}

void kill_ob(object ob) {
  set_temp("my_killer", ob);
  remove_call_out("check2");
  call_out("check2", 1);
  ::kill_ob(ob);
}

