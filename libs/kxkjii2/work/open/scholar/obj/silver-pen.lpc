// sword.c : an example weapon
#include <ansi.h>
#include <weapon.h>

inherit STABBER;

void create()
{
    set_name("[1;37m逆麟银笔[0m",({"scale pen","pen"}));
	set_weight(7000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("value",30000);
		set("material", "steel");
        set("wield_msg", "[1;37m$N拿起$n, [1;37m身上散发着银光!![0m\n");
        set("unwield_msg", "$N将手中的$n插入腰间。\n");
	}
    init_stabber(100);
	setup();
}
