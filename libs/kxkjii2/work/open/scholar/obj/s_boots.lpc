#include <armor.h>
#include <ansi.h>
inherit BOOTS;
void create()
{
set_name("血豹\靴",({"boots"}));
        set_weight(2000);
        if ( clonep() )
                set_default_object(__FILE__);
        else{
                set("unit","双");
                set("value",12000);
// Swy QC 98/3/16
                set("armor_prop/armor",4);
                set("armor_prop/dodge",2);
                set("armor_prop/move",3);
                set("material","leather");
                set("long","此鞋取下血豹\毛皮所制。\n");
                setup();
        }
}
