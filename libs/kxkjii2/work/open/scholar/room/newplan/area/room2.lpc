// Room: /u/s/sueplan/newplan/area/room2
inherit ROOM;

void create ()
{
  set ("short", "[1;37m天机[1;33m星[0m");
  set ("long", @LONG
姜尚又名姜子牙，居住于昆仑山的深山里，向元始天尊学习仙道，
获得甚多的智慧。运气未到以前，无论哪一个英雄、贤哲、军师都和凡
人完全一样。姜尚到老年一直过着怀才不遇的生活。他的不幸，可以说
受到了配偶的影响。因为他和一位姓马的小姐结婚，所以一辈子赤贫如
洗。但是到了老年，他俩彼此同意离婚，各走各人的路。从那个时候起
，姜尚才开始走了红运。他每天一人在湖边垂钓，偶而被文王发现他的
才能，任周国军师。姜尚一向爱国忠王，文王死后也仍然辅佐武王，竭
力强国富国。因为他的智慧过人，可以预测未来，适应现在，所以他才
被任命为周日的军师。                                                   武王称霸天下以后，姜尚受封为齐国诸侯，不几年他终于逝世
了，他的灵魂被太白金星携回天界，永住于天机星。从此，天机星掌管
紫薇斗数中的‘智慧’。 
LONG);

  set("objects", ([ /* sizeof() == 1 */
  "/open/scholar/room/newplan/npc/scholar_kao.lpc" : 1,
]));
  set("light_up", 1);
  set("no_transmit", 1);
  set("exits", ([ /* sizeof() == 2 */
  "enter" : __DIR__"room3.lpc",
  "south" : __DIR__"room1.lpc",
]));

  setup();
}
int valid_leave(object me, string dir)
{
  if(dir=="enter"&&present("scholar",environment(me)))
    {
    return notify_fail("你发觉有人挡在你面, 不让你过!!!\n");
     }
  return 1;
}
