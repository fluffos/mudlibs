void init()
{
add_action("do_search","search");
add_action("do_go","go");
}
int do_go(string str)
{
  object me;
  me=this_player();
  if(str=="阵内")
  {
    if(me->query_temp("six_ask")==10)
    {
    write("你深深的吸了一口气, 进入了八卦阵内!!\n");
    me->move(__DIR__"q2.lpc");
    return 1;
    }
  else
  {
  write("你还不知道什么是八卦阵吧??\n");
  }
  }
}
int do_search()
{
  object me=this_player();
  if( me->query("family/family_name") =="儒门")
  {
  write("你发现有条路可以进入此阵(go 阵内)。\n");
  }
  else
  {
  write("你找不出个所以然出来\n");
  }
return 1;
}
