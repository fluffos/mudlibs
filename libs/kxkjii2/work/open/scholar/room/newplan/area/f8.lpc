// Room: /u/s/sueplan/newplan/area/f8.c
inherit ROOM;

void create() {
  set("short", "[1;37m云山下[0m");
  set("long", @LONG
行走至此，渐觉山风凉意徐来，一阵清心快意袭上心间，不觉满怀舒畅
，抬头望去，前方山头云气缭绕，朦胧翳入苍穹，不辨何谓山岭天际，犹如
飞雪漫漫凝结不散，故名为‘云山’；羊肠小路蜿蜒南去，杂花生树无名幽
香淡淡，树间山路盘峦而升(climb up)。
LONG);

  set("outdoors", "/u/s");
  set("exits", ([ /* sizeof() == 1 */
    "north": __DIR__ "f7",
  ]));

  setup();
}
void init() {
  add_action("do_climb", "climb");
}
int do_climb(string str) {
  object me;
  me = this_player();
  if (str == "up") {
    write("你一步一步爬了上去!!\n");
    me->move(__DIR__ "f9.lpc");
    return 1;
  }
}
