// Room: /u/s/sueplan/newplan/area/room8
inherit ROOM;

void create ()
{
  set ("short", "[1;37m太阴[1;33m星[0m");
  set ("long", @LONG
纣王手下有个尽忠的黄飞虎将军。黄飞虎的妻子年轻貌美，在殷朝
的天下是唯一能和妲己相比的美人。因此，妲己心哀很不高兴。黄飞虎
的太太又被称贾女人。                        
    殷朝时代，每逢过年那一天，诸大臣和将军都必须夫妻同行，进宫
向君主拜年。追是一种传统的惯例。贾夫人也跟随黄飞虎将军进宫拜年
。这时，妲己顿起邪念，恳请纣王准许他和贾夫人留宫聊天。黄将军便
独自先回家了。                                                    
    妲己诱贾夫人登上宫中高楼，然后造成机会，使贾夫人单独和纣王
面对乐宴。纣王一喝酒，便失去埋智，起了好色的本性，想非礼这位绝
世美人。貌美的贾夫人又是一位贞节闻名的女性，当然推辞拒绝纣王的
淫言乱行。纣王凭藉酒势，东追西抓，使贾夫人奔跑躲开而失足堕落。
贞节拒淫的贾夫人一坠便死。太白金星见她贞节超人，就把他的灵魂带
回天界。                  
    贾夫人除贞节外，还具有洁白的个性。无论给她那一星座，她总是不
表示同意。太白金星不得不请她住在清幽的月球上，把月球叫做太阴星。
在月球上的‘太阴’神贾夫人便从此掌管‘清洁’和‘住宅’。

LONG);

  set("objects", ([ /* sizeof() == 1 */
  "/open/scholar/room/newplan/npc/scholar_hace.lpc" : 1,
]));
  set("light_up", 1);
  set("no_transmit", 1);
  set("exits", ([ /* sizeof() == 2 */
  "enter" : __DIR__"room9.lpc",
  "south" : __DIR__"room7.lpc",
]));

  setup();
}
int valid_leave(object me, string dir)
{
  if(dir=="enter"&&present("scholar",environment(me)))
  {
  return notify_fail("你发觉有人挡在你面, 不让你过!!!\n");
  }
  return 1;
}
