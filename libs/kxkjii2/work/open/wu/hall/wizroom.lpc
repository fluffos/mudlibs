inherit ROOM;

object ob;
string *name=({"hitler","devils","norman","fary","datas","nsk","moi","boss","lys","stupid","oda"});
int number=11;

void create ()
{
  set ("short", "[1;32m武者巫师讨论室[0m");
  set ("long", @LONG
这里是武者制作巫师的讨论室, 有冷气、冰箱, 还有沙发等豪华家具,
尚有充足的光线及优雅的办公桌, 提供巫师们最舒适的环境! 并且设置了
巫师专用的布告栏, 让巫师们能将问题留言于上, 共同讨论。
办公桌上有一支麦克风(mac),呵...刚买的..:>>
LONG);

  set("item_desc", ([ /* sizeof() == 1 */
  "mac" : "这是一支可爱的麦克风, 你可以透过它来向目前
线上的武馆巫师传讯息..
用法: mac 你要说的话 ...
",
]));

  set("exits", ([ /* sizeof() == 2 */
  "up" : "/open/wu/room/school1",
  "down" : "/open/wiz/hall1",
]));

  set("no_fight", 1);

  set("no_magic", 1);

  set("no_clean_up", 0);

  set("valid_startroom", 1);


  setup();
        call_other("/obj/board/fexboard","???");
}

void init()
{
add_action("mac","mac");
}

int mac(string str)
{
int i,flag=0;

if(!str)
  {
   notify_fail("你总要说些话啊!!, 不然其他wiz 怎么能听得到呢?\n");
   flag=0;
   return 0;
  }
for(i=0;i<number;i++)
  {
    if(ob=find_player(name[i]))
    if(ob!=this_player())
    {
    tell_object(ob,"[1;37m[武者制作][1;33m "+this_player()->query("id")+"[1;37m 说: [0m"+str+"\n");
    flag++;
    }
  }
  if(flag!=0)
  {
  write("[36m你告诉全部的武者巫师："+str+"[0m\n");
  }
  else
  {
  write("目前没有其他武者巫师在线上, 所以没人听到你说的话。\n");
  }
  say(this_player()->query("name")+"("+this_player()->query("id")+")"+" 对着麦克风叽叽咕咕地说了些话..\n");
  flag=0;
  return 1;
}
