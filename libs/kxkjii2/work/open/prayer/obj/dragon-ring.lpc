inherit EQUIP;

void create()
{
        set_name("[33m龙睛宝戒[0m",({"dragon_eye ring","ring"}) );
        set_weight(4500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
        set("long","在戒指的中央镶上西域破邪洞窟内黄甲金龙的眼珠。\n");
        set("unit","件");
        set("value", 40000);
        set("material","gem");
        set("no_auc",1);
        set("no_give",1);
        set("armor_type","finger");
        set("wear_msg","戴上$n之后，$N的身上开始产生[33m金龙的斗气。[0m\n");
        set("armor_prop/move", -3);
        set("armor_prop/dodge", -3);
        set("armor_prop/armor", 10);
        }
        setup();
}        
