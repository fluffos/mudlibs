//浑天水晶(第六层玄混沌心法)

inherit ITEM;

void create()
{
        set_name("[30m黑水晶[0m", ({ "black-crystal","crystal" }));
        set("title", "浑天心法之");
        set_weight(500);
        if( clonep() )
          set_default_object(__FILE__);
        else
        {
          set("unit", "根");
          set("long","这是一根会发光的[30m黑色水晶[0m, 里面刻有[36m浑天宝鉴第六层[30m玄混沌心法[36m的练功\口诀。[0m\n");
          set("value", 600);
          set("material", "gem");
          set("no_drop", 1);
          set("no_get", 1);
          set("no_sell", 1);
          set("no_auc", 1);
          set("no_give", 1);
          set("skill", ([
          "name" : "superforce",  // name of the skill
          "exp_required" :  150000,     // to learn this skill.
          "sen_cost" : 25,              // gin cost every time study this
          "difficulty" : 25,             // modify is gin_cost's (difficulty - int)*5%
          "max_skill":  80
          ]) );
        }
}

int valid_learn(object me)
{
        if(me->query("family/family_name")!="圣火教")
          return -1;
        return 1;
}
