//黄甲金龙的鳞片()
#include <command.h>
inherit ITEM;

void create() {
  set_name("[33m黄甲金龙的鳞片[0m", ({ "dragon skin", "skin" }));
  set_weight(30000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("long", "这是破邪洞窟中[33m黄甲金龙[0m的鳞片, 传闻[33m黄甲金龙[0m全身上下均具有龙的魔力。
          如果将鳞片拿去做成防具或衣服!? 那不就可以刀枪不入了吗??..........\n");
    set("value", 800);
    set("material", "fur");
    set("no_sell", 1);
    set("no_auc", 1);
  }
}
