#include <command.h>
#include <weapon.h>
#include <ansi.h>

inherit UNARMED;

void create() {
  set_name("[36m圣火教的令牌[0m", ({ "wood board", "board" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", @LONG

     圣火教徒的信物之一, 此木牌是以桧木雕成, 并在其上刻以象征
     圣火教的圣火图样!!除了做为圣火教门徒的辨认之外, 更可以将
     它握在手中做为徒手功击的武器。
 
LONG);
    set("unit", "只");
    set("value", 60);
    set("no_sell", 1);
    set("no_give", 1);
    set("no_auc", 1);
    set("no_drop", 1);
    set("material", "wood");
  }
  init_unarmed(15);

  setup();
}
void init() {
  object me;
  seteuid(geteuid());
  me = this_player();
  this_object()->set_name(
    "" + (string)this_player()->name(1) + "的" HIC "令牌" NOR,
    ({ "wood board", "board" })
  );
}
