//黄甲金龙的皮革()
#include <command.h>
inherit ITEM;

void create() {
  set_name("[33m黄甲金龙的皮革[0m", ({ "dragon fur", "fur" }));
  set_weight(30000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "这是破邪洞窟中[33m黄甲金龙[0m的皮革, 传闻[33m黄甲金龙[0m全身上下均具有龙的魔力。
          只要将这块皮革拿去做成武器或防具!? 那不就..........\n");
    set("value", 800);
    set("material", "fur");
    set("no_sell", 1);
    set("no_auc", 1);
  }
}
