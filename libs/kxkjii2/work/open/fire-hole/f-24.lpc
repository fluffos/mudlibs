#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "[31m[1m火龙幻界[0m[1m--[31m红色结界[0m");
  set("long", @LONG
来到此地, 你往四周探了探, 这里的环境跟刚才你看到的地方不太一样
. 地上画了许多奇形怪状的图案, 更奇特的是, 上方竟有一道红色光芒照射
着这里, 你不禁感到惊奇, 在如此的地方竟有类似极光的景象, 真令你大开
眼界。
LONG);

  set("outdoors", 1);
  set("exits", ([ /* sizeof() == 5 */
    "northwest": __DIR__ "f-19.lpc",
    "northeast": __DIR__ "f-20.lpc",
    "southeast": __DIR__ "f-27.lpc",
    "southwest": __DIR__ "f-26.lpc",
    "east": __DIR__ "fire1.lpc",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    "/open/fire-hole/npc/dragon-r.lpc": 1,
  ]));

  setup();
}
int valid_leave(object who, string dir) {
  int exp, kar, cps, cor, intt, factor;
  object ob2;
  if (dir == "east" || dir == "northwest" || dir == "northeast" || dir == "southwest" || dir == "southeast") {
    if (present("red dragon", environment(who)) &&
      who->is_fighting())  //检查红光火龙是否还在与移动者是否在战斗中   
    {
      if (who->query_temp("flee") == 1) {
        return notify_fail(HIR "红光火龙仍然挡住了去路\n" NOR);
      }
      exp = who->query("combat_exp");
      kar = who->query("kar");
      cps = who->query("cps");
      cor = who->query("cor");
      intt = who->query("int");
      if (kar > 30)
        kar = 30;
      if (cps > 30)
        cps = 30;
      if (cor > 30)
        cor = 30;
      if (intt > 35)
        intt = 35;
      if (who->query("setgift-mk") == 1) {
        kar = who->query("setgift/kar");
        cps = who->query("setgift/cps");
        cps = who->query("setgift/cor");
        intt = who->query("setgift/int");
      }
      if (!exp)
        factor = 0;
      else if (exp < 10000000)
        factor = 10;
      else if (exp < 13000000)
        factor = 20;
      else if (exp < 15000000)
        factor = 30;
      else if (exp < 16000000)
        factor = 35;
      else
        factor = 40;
      if (random(180) > (factor + kar + cps + cor + intt)) {
        who->set_temp("flee", 1);
        if (who->query("class") == "fighter" && who->query_temp("keeup") == 1)
          call_out("remove_flee", 2, who);
        else
          call_out("remove_flee", 1, who);
        return notify_fail(HIR "\n红光火龙巨大的身体挡住了退路\n" NOR);
      }
    }
  }
  return ::valid_leave(who, dir);
}
int remove_flee(object who) {
  if (who)
    who->delete_temp("flee", 1);
  return 1;
}
