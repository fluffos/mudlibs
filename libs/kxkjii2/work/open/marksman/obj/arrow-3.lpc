#include <weapon.h>
#include <ansi.h>

inherit ARROW;

void create() {
  set_name("紫邪箭", ({ "violet arrow", "arrow" }));
  set_weight(15);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "袋");
    set("value", 0);
    set("base_unit", "支");
    set("material", "iron");

  }
  init_arrow(25);
  set_amount(300);
  setup();
}
