#include <ansi.h>
inherit NPC;

void create() {
  set_name("[31m极焰火凤凰[m",
    ({ "fire-phoenix", "fire", "phoenix", }));
  set("mount_id", "fire-phoenix");
  set("age", 12);
  set("race", "野兽");
  set("score", 1000000);
  set("gender", "女性");
  set("level", 1);
  set("rider", "phoenix");
  setup();
}
string *dodge_msg = ({
  "[47;30m$n[47;30m的黑色陆行鸟佯装要逃走[1m，[;47;30m趁$N[47;30m不注意的"
  "[1m，[;47;30m一个瞬间$n[47;30m已躲过$N[47;30m的攻击[1m。[m\n",
  "[47;30m$n[47;30m往上一跳[1m，[;47;30m在此瞬间黑色陆行鸟往前冲[1m，"
  "[;47;30m攻其不意[1m。[m\n",
});
string query_dodge_msg() {
  return dodge_msg[random(sizeof(dodge_msg))];
}
