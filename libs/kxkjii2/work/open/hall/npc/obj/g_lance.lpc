#include <weapon.h>

inherit HAMMER;

void create() {
  set_name("[1;34m落云枪[0m", ({ "cloudy lance", "lance" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "枪头隐隐透出蓝光，是把不可多得的神兵利器。\n");
    set("value", 10000);
    set("material", "blacksteel");
  }

  init_hammer(30);

  set("wield_msg", "$N「刹”地一声～$n已握在手中。\n");
  set("unwield_msg", "$N将手中的$n揹到身后。\n");

  setup();
}
