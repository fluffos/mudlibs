#include <weapon.h>

inherit SWORD;

void create()
{
        set_name("[1;31m赤血剑[0m", ({ "blood sword", "sword" }) );
        set_weight(3000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long", "一把以赤金和玄铁混合炼制的剑，是把能～削金断玉之利器。");
                set("value",10000);
                set("material", "blacksteel");
        }
        init_sword( 50);

        set("wield_msg", "$N手中[1;31m赤血剑[0m散发出眩目的红光～～\n");
        set("unwield_msg", "$N手中的$n的红光缓缓退去～\n");

        setup();
}
