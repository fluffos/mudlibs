inherit ROOM;
#include <ansi.h>
#include "soil.msg"
#include "damage03.lpc"

string *exit = ({ __DIR__ "soil09", __DIR__ "soil10", __DIR__ "soil11", __DIR__ "soil12", });

void create() {
  set("short", "土灵塔三楼");
  set("long", (: printf_msg :));
  set("exits", ([
    "south": exit[random(sizeof(exit))],
    "north": exit[random(sizeof(exit))],
    "east": exit[random(sizeof(exit))],
    "west": exit[random(sizeof(exit))],
  ]));
  set("light", 1);
  set("no_auc", 1);
  set("no_transmit", 1);
  setup();
}
