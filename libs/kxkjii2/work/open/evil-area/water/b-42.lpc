inherit ROOM;
#include <ansi.h>
#include "tree.lpc"
#include "tree.msg"

void create() {
  set("short", HIG "琰 扬 居 -- " NOR + YEL "大 松 树" NOR);
  set("long", (: printf_tree :));
  set("evil_area", 1);
  set("no_transmit", 1);
  set("exits", ([
    "up": __DIR__ "b-43",
    "down": __DIR__ "b-37",
  ]));
  setup();
}
