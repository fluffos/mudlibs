void init()
{
add_action("do_search","search");
}
int do_search()
{
object me;
me=this_player();
if(me->query_temp("get_amulet") >= 1)
{
tell_object(me,"你什么也没有发现。\n");
return 1;
}
else
{
tell_object(me,"你从尸骨的身上发现了一个护身符。\n");
me->set_temp("get_amulet",1);
new(__DIR__"obj/amulet")->move(me);
return 1;
}
}
