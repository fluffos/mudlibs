#include <ansi.h>
inherit ROOM;

void create ()
{
  set ("short", "[1;31m开阳楼[2;37;0m");
  set ("long", @LONG
你已经身在七星塔中的第三层了, 对于强烈的光线已不在对
你产生影响了, 在墙边, 你看到了一个火炉, 有位剑士正挥汗如
雨正在打造着兵器, 原来七星塔中所有剑士的剑, 都是由他一人
所打造的, 当他一望到你, 马上拿起放在一旁的剑, 镇守到楼梯
口的地方, 不让你擅入．
LONG);

  set("exits", ([ /* sizeof() == 2 */
  "up" : __DIR__"room7.lpc",
  "out" : __DIR__"room6.lpc",
]));
  set("light_up", 1);
  set("objects", ([ /* sizeof() == 1 */
  "/open/gsword/star/npc/star5.lpc" : 1,
]));

