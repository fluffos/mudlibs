// Room: /u/b/blue/room/star1.c
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "[1;33m玉衡楼[2;37;0m");
  set("long", @LONG
你已经到达第二层, 而塔中的亮度已经影响不到你了, 
往周围一望, 才发觉到这里的摆设十分的漂亮, 摆置着许许
多多的武器, 以及许多的花瓶及摆饰, 而楼主正站在向上的
楼梯口前, 静静的执行自己的职务, 但眼中仍有着一股漠落
的表情, 可能由于长年只能呆在这吧。
LONG);

  set("exits", ([ /* sizeof() == 2 */
    "up": __DIR__ "room5.lpc",
    "out": __DIR__ "room4.lpc",
  ]));
  set("light_up", 1);
  set("objects", ([ /* sizeof() == 1 */
    "/open/gsword/star/npc/star6.lpc": 1,
  ]));

  setup();
}
int valid_leave(object me, string dir) {
  if (dir == "up" && present("starman", environment(me)))
    if (!me->query_temp("allow_read", 1))
      return notify_fail("你以为你能活得过去吗??"
        +RANK_D->query_respect(me) + "你去死吧!\n");
  return ::valid_leave(me, dir);
}
