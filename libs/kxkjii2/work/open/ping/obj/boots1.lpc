#include <armor.h>

inherit BOOTS;

void create()
{
	set_name("劲云靴", ({ "cloud boots", "boots" }) );
	set_weight(9000);
	if( clonep() )
		set_default_object(__FILE__);
	else 
	{
	  set("long", "轻便且舒适的靴子, 两旁各绣着一朵云彩。\n");
	  set("unit", "双");
	  set("value", 2000);
	  set("material", "linen");
          set("armor_prop/armor", 4);
	}
	setup();
}

