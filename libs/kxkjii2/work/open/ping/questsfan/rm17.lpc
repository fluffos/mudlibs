inherit ROOM;
#include <ansi.h>
void create ()
{
  set ("short", "[0;32m云雾松林[2;37;0m");
  set ("long", @LONG
松林蔽日、云雾迷蒙、松果满地，这儿最奇怪的是一片大松林
竟没看到半株茎干，格外特别。不时有几只罕见的六尾松鼠狂奔而
过，不然就是昆虫的鸣叫声，特别的是牠们的一起突然的大鸣，然
后再一起的安静，那一起突发的鸣叫声真是相当令人震撼的。

LONG);

  set("exits", ([ /* sizeof() == 6 */
  "westup" : __DIR__"rm20",
  "westdown" : __DIR__"rm16",
  "southdown" : __DIR__"rm9",
  "northup" : __DIR__"rm19",
  "eastdown" : __DIR__"rm10",
  "eastup" : __DIR__"rm18",
]));
