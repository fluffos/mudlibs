void init()
{
    call_out("dhk",1,this_player());
}
void dhk(object who)
{
  if(who->query_temp("run")!=4 && who->query_temp("run")==3)
  {
tell_object(who,""WHT"这道黑色的人影又快速往西边山上奔去，好像有意要与你玩捉迷藏。"NOR"\n");
   who->set_temp("run",4);
   remove_call_out("dhk");
  }
}

