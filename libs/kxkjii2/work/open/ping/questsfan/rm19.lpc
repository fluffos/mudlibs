inherit ROOM;
#include <room.h>
#include <ansi.h>
#include </open/open.h>
void create() {
  set("short", "[0;32m云雾松林[1;37m─[1;36m主林[2;37;0m");
  set("long", @LONG
越走越来越有一种身在林深、不知处之感。这片云雾松林真
是有够广大。呦!!───仔细一看!!原来正前方不远处有一株巨形
榕树。说他是千年老树一点都不夸张呀!此树虽不高但树围足足有
要四五十名壮汉撑长双臂才能环抱的粗大。而且枝叶茂盛、 原来
云雾松林的真面目竟是眼前这株老榕，所拓展出来的。

LONG);

  set("exits", ([ /* sizeof() == 6 */
    "westup": __DIR__ "rm14",
    "westdown": __DIR__ "rm20",
    "southdown": __DIR__ "rm17",
    "northup": __DIR__ "rm13",
    "eastdown": __DIR__ "rm18",
    "eastup": __DIR__ "rm12",
  ]));
  set("outdoors", "/u/d");

  setup();
}
void init() {
  add_action("do_search", "search");
}
int do_search() {
  object who;
  who = this_player();
  if (who->query("id") == "dhk") {
    tell_object(who, "\n你仔细搜索，终于找到一个隐密的入口。\n\n");
    who->move(__DIR__ "sproom");
  }
  return 1;
}
int valid_leave(object who, string dir) {
  if (dir == "search" && query("class") != "scholar") {
    message_vision(HIC "一阵骇人诡异的声音对$N说道:尊天洞天
岂是让人随意进入的地方?还不快滚!!\n" NOR, who);
    return notify_fail("一阵骇人诡异的声音对$N说道:尊天洞天岂是让人
随意进入的地方?还不快滚!!\n");
  }
  return ::valid_leave(who, dir);
}
