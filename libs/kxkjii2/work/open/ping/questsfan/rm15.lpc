void init()
{
    call_out("dhk",1,this_player());
}
void dhk(object who)
{
  if(who->query_temp("run")!=6 && who->query_temp("run")==5)
  {
   tell_object(who,""WHT"这道黑色的人影这次又朝东边山上奔去，尽管你努力提气奔驰，还是追赶不及。"NOR"\n");
   who->set_temp("run",6);
   remove_call_out("dhk");
  }
}

