#include <weapon.h>
#include <ansi.h>

inherit SWORD;

void create()
{
        string na;
        object me;
        me = this_player();
        na = (me->name(0));

        if (me)
set_name(na+"[1;37m□的芦剑[0m",({"sword"}));
        else
{ set_name("[1;37m的芦剑[0m",({"sword"})); }
        seteuid(getuid());
        set_weight(5000);
        if( clonep() )
        set_default_object(__FILE__);
        else {
        set("unit", "把");
        set("long",@LONG

        一把精制的长剑, 铸剑师傅以其精湛的手艺将剑刃的两侧
        打薄, 藉以提高此剑的斩切能力!!是一把不可多得的好剑!!


LONG);
        set("value",12000);
        set("no_drop",1);
        set("no_get",1);
        set("no_sell",1);
        set("no_give",1);
        set("no_auc",1);
        set("material", "iron");
        set("wield_msg", "$N「唰”地一声抽出一把$n握在手中。\n");

        }
        init_sword(50);
        setup();
}
int query_autoload() { return 1; }



