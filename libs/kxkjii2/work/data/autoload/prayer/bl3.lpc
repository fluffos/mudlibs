#include <weapon.h>
#include <ansi.h>

inherit BLADE;

void create()
{
        string na;
        object me;
        me = this_player();
        na = (me->name(0));

        if (me)
           set_name(na+"的[32m龙牙镶金刀[0m",({"dragon-tooth blade","blade"}));
        else
         { set_name("[32m龙牙镶金刀[0m",({"dragon-tooth blade","blade"})); }
        seteuid(getuid());
        set_weight(25000);
        if( clonep() )
        set_default_object(__FILE__);
        else {
        set("unit", "把");
        set("long",@LONG

	一把铁制的大刀, 铸刀师傅在铸造的过程中加入了黄金 
	提高了此刀的硬度, 密度与强度!!并且在刀的两侧加上
	了龙牙做为增加杀伤力的利器!!

LONG);
        set("value",12000);
        set("no_drop",1);
        set("no_get",1);
        set("no_sell",1);
        set("no_give",1);
        set("no_auc",1);
        set("material", "iron");
//        set("wield_msg", "$N从刀鞘将$n拔出来之后，火光四溢。\n");
        }
        init_blade(90);
        setup();
}               
int query_autoload() { return 1; }

      