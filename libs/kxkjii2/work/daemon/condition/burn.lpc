#include <combat.h>
inherit F_CLEAN_UP;
int update_condition(object me, int duration) {
  if (!living(me)) {
    message("vision", me->name() + "[31m身上的灼伤尚未痊愈, 但是觉得似乎油尽灯枯\了!![0m\n",
      environment(me), me);
  } else if (duration > 10) {
    tell_object(me, "[31m你的灼伤似乎很严重, 伤口焦黑.[0m\n");
    message("vision", me->name() + "[1;31m身上发热巨痛, 并有严重脱水的现象.[0m \n",
      environment(me), me);
    me->receive_wound("kee", 300);
    me->receive_damage("kee", 300);
    if ((int)me->query("water") >= 50)
      me->add("water", -50);
    else
      me->set("water", 0);
  } else if (duration > 5) {
    tell_object(me, "[31m你觉得身上的灼伤开始褪皮了, 伤口红肿疼痛.[0m \n");
    message("vision", me->name() + "[1;31m伤口仍发热肿痛, 但脱水症状有所减轻[0m\n",
      environment(me), me);
    me->receive_wound("kee", 200);
    me->receive_damage("kee", 200);
    if ((int)me->query("water") >= 30)
      me->add("water", -30);
    else
      me->set("water", 0);
  } else if (duration > 1) {
    tell_object(me, "[1;37m你身上的灼伤开始结疤了, 也感觉不到痛苦了.[0m \n");
    message("vision", me->name() + "[1;31m的身上有一道新疤, 好像受到不轻的伤害.[0m \n",
      environment(me), me);
    me->receive_wound("kee", 100);
    me->receive_damage("kee", 100);
    me->add("kee", -2);
    if ((int)me->query("water") >= 10)
      me->add("water", -10);
    else
      me->set("water", 0);
  }
  me->apply_condition("burn", duration - 1);
  COMBAT_D->report_status(me, 1);
  if (duration < 2)
    return 0;
  return 1;
}
