#include <ansi.h>
#include <combat.h>
#include </open/open.h>
inherit NPC;
inherit F_MASTER;
void create()
{
        set_name("[1;34m魔刀莫测[0m",({"oldman"}));
set("long", "一个看起来全身脏盻盻的老人，脚上还有一个脚铐，看起来像是被关在这里的。\n");
        set("gender", "男性" );
        create_family("魔刀莫测",1,"开创始祖");
        set("family/family_name","魔刀莫测");
        set("have_book",1);
        set("title","魔仙雪～刀剑苍");
        set("age",70);
        set("env/魔性六斩","YES");
      set("mpower",2);
        set("str",45);
        set("class","blademan");
        set("guild_class","blademan");
        set("cor", 30);
        set("cps", 30);
        set("int", 25);
        set("max_gin",1000);
        set("max_sen",1000);
        set("max_force",4000);
        set("force",4000);
        set("force_factor",30);
        set("kee",5000);
        set("score",100000);
        set("max_kee",5000);
        set("bellicosity",3000);
        set_skill("cure",60);
        set_skill("riding",100);
        set_skill("force", 100);
        set_skill("blade",120);
        set_skill("dodge", 70);
        set_skill("move", 70);
        set_skill("powerforce", 100);
        set_skill("dragon-blade", 120);
        set_skill("parry", 100);
        map_skill("parry","dragon-blade");
        map_skill("blade","dragon-blade");
        map_skill("force","powerforce");
        set("combat_exp",1500000);
        set("chat_chance_combat",50);
        set_temp("apply/armor",100);
        set("chat_msg_combat",({
        (: perform_action, "blade.swy" :),
      }));
        set("inquiry", ([
"脚铐":"这个脚铐是用千年寒石打造的，一般兵器是砍不断的。\n",
"千年寒石":"这是经过千年孕育而成的坚硬石块，除非有神兵利器，不然无法砍断。\n",
"神兵利器":"听说人间至宝「金鳞蟒邪”配上「天邪石”可以毁灭千年寒石。\n",
"金鳞蟒邪":"听说金鳞蟒邪好像落在茅山派手上。\n",
"天邪石":"天邪石在独孤愁传人的手里。\n",
"失传奥义":"那招是狂龙刀法最后一招，可惜刀谱已被莫无乐给夺走了，
　　　　　　如果你能夺回来，我就传你那失传奥义。",
"莫无乐":"是我最喜爱的徒弟，可惜心术不正想篡我门，又夺取我刀法最后一式，
　　　　　最后被我儿子打败，就不知去向了，不过．．．．",
"不过":"不过，听说他去投靠世仇雪苍派去了，目前占据魔龙塔当作要塞。",
"魔龙塔":"在魔刀门内，自己去找吧！",
"镇教之宝":"哈哈......那是我当年威震武林时所用的配刀。\n",
"配刀":"那把刀是我刚闯荡江湖，而未创立魔刀时巧遇贵人，但那时他已经奄奄一息，从他口中得知刀冢位置之后，也知道最好的刀名叫‘妖刀村雨’。\n",
"妖刀村雨":"在二十年前与独孤愁在雪苍山一战后，那把刀就受损了，此刀以被葬回刀冢。\n",
"刀冢":"嗯...恐怕你不够资格到那吧。\n",
"资格":"只要你能接住我七招，我就把刀冢位置跟你说(test 资格)。\n",
"莫云":"不过他仙游已久，不过听说有传人，传人好像一直待在西域吧！\n",
        ]));
        add_temp("apply/dodge",30);
        setup();
        carry_object("/daemon/class/blademan/obj/iceblade")->wield();
}
void attempt_apprentice(object ob)
{
if(this_player()->query_skill("dragon-blade",1)<105)
{
command("say 狂龙刀法都学不好了！还想拜我！滚！你给我滚开！\n");
return ;
}
if(this_player()->query("have_book")!=1)
{
command("say 虽然你狂龙刀法已到达一定水准！但是尚缺上乘奥义！");
command("say 可惜！我毕生所钻研的刀谱！却被莫无乐给盗走了！");
command("say 如果你能追回的话！我就收你为徒！更传你魔刀最后失传奥义！");
return ;
}
        command("smile");
        command("say 嗯，果然青出于蓝，从今后老夫亲自传授于你。");
        command("say 但是魔刀武学不能外传，切记，切记。");
        ob->delete("family");
        command("recruit "+this_player()->query("id"));
if(this_player()->query("m_blade")==1) {
this_player()->set("title","[1;31m魔刀[1;37m‘三斩归元’[1;35m传人[0m"); } else {
        this_player()->set("title",HIC"魔刀绝世传人"NOR);
}
        this_player()->set("no_recruit", 1);
        message("system",HIB"魔刀莫测纵声狂笑:
\n哈哈哈哈～～魔刀一出～～血流成河～～无所匹敌。\n"NOR,users());
        return ;
        }
int accept_object(object who,object ob)
{
string ob_id;
ob_id=ob->query("id");
if(who->query("quests/blade_out")==0||who->query_skill("dragon-blade",1)>=105)
{
if(who->query("evil-mblade")==1) {
if(ob_id=="bad-evil-mblade") {
command("say 太好了，这正是我之前的配刀！");
command("say 可惜刀身以毁，当今世上只有‘莫云’会修！");
command("say 你去找他吧！");
command("give "+this_player()->query("id")+" bad-evil-mblade");
}}
if(ob->query("id")=="dragon-blade book"&&who->query("family/family_name")=="魔刀门")
{
if(who->query("have_book")==0)
{
destruct(ob);
command("say 你竟能将刀谱追回，果然是个可造之才！");
command("say 好，我就将狂龙刀法‘失传奥义’传给你！\n");
who->set("have_book",1);
}
}
if(ob_id=="stone"&&who->query_temp("give_1")==0)
{
destruct(ob);
command("say 我没看错吧，你竟然能将天邪石拿到手！");
this_player()->set_temp("give_1",1);
}
if(ob_id=="snake sword"&&who->query_temp("give_2")==0)
{
destruct(ob);
command("say 太好了，这正是我需要的东西！");
this_player()->set_temp("give_2",1);
}
if(who->query_temp("give_1")==1&&who->query_temp("give_2")==1&&who->query("quest/blade_out/get_force")==0)
{
    command("say 太好了！");
    message_vision(
             HIY
"$n将天邪石的神力注入金鳞蟒邪之中，然后运劲一砍，将脚铐砍断。\n" NOR,this_player(),this_object());
    CHANNEL_D->do_channel(this_object(),"mud",HIR
"远处传来魔刀莫测的大喝:\n我自由了！哈哈哈哈！\n独孤愁！你这个老贼等着吧！我要一雪这十几年禁锢之恨！\n"NOR);
           command("say 感谢你释放了我，我这就去宰了独孤老贼。");
           command("say 不过看在你曾帮我，好吧，我将部分内力传给你。");
           this_player()->add("max_force",100);
           this_player()->add("force",100);
           who->set("quests/blade_out",1);
           who->set("quest/blade_out/get_force",1);
           return 1;
}
}
}
void init()
{
   add_action("do_test","test");
}
int do_test(string str)
{
        int i;
        object ob=this_object();
        object me=this_player();
if(me->query_temp("sublade")==1)
return notify_fail("刀冢的路就在薜荔萝林内！\n");
if(me->query("m_blade")!=1)
return notify_fail("依你目前能力没资格接我七招，等你有三斩再来吧！\n");
    if(str=="资格")
        {
          command("say 好! 待老夫来试试你! 小心了");
     for(i=0;i<7;i++)
COMBAT_D->do_attack(ob, me, ob->query_temp("weapon"), TYPE_QUICK);

          if( me->query("kee") > 500 )
          {
 command("say 果然真有本事！如你能帮我把配刀取回，我就传你此刀！");
     command("say 刀冢的路就在薜荔萝林内！自行找吧。");
            me->set_temp("sublade",1);
          }
          else
          {
            command("say 你再加强自己本事吧！");
          }}
        else {
          write("接受什么?!\n");
        }
return 1;
}
void heart_beat()
{
object me,room,*target;
int i,j;
me=this_object();
if( me->is_fighting() && random(100) > 60 && !me->query_temp("fast-dest") ) 
{
message_vision(HIC"\n魔刀莫测吃起药丸补充血气。\n"NOR,me);
me->receive_curing("kee",1500);
me->receive_heal("kee",1500);
me->delete_busy();
me->clear_condition();
   }
  ::heart_beat();
  }
void die()
{
	object winner = query_temp("last_damage_from");
	int j;
	if(!winner)
	{
	::die();
	return ;
	}
   if (winner && userp(winner))  {
tell_object(users(),HIR"\n\n魔刀莫测仰天怒吼：\n\n\t想当年老夫刀法名震武林却败于"+winner->name()+HIR"手上！
\n\t没想到竟然有比独孤老贼更利害得人物！罢了罢了！\n\n"NOR);
   }
        :: die();
}

