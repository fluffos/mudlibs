// linbo-steps.c

inherit SKILL;

string *dodge_msg = 
({
"$n展开[1;36m‘乾坤大挪移’[0m，[1m「神龙负图出洛水，彩凤衔书碧云里．”[0m$n的身形如长虹经天，飞鹰逐日， 翩然游走于四面八方。\n",
"只见$n施展[1;36m‘乾坤大挪移’[0m，[1m「阴阳二遁分顺逆，纵棋十五在其中．”[0m在电光火石间，$n的身影瞬间消匿无踪。\n",
"$n踏出[1;36m‘乾坤大挪移’[0m，[1m「直符前三六合位，太阴之神在前二．”[0m$n脚踏阴阳五行方位，身法诡谲莫测。\n",
"$n使出[1;36m‘乾坤大挪移’[0m，[1m「伏兵但向太阴位，若逄六合利逃形．”[0m刹那间风云变色，天旋地转，敌人只感到时空完全扭曲，再也难辨$n的所在。\n",
"$n展现[1;36m‘乾坤大挪移’[0m，[1m「地遁日精紫云蔽，藏形遁迹斯为美．”[0m幻化出无数个虚虚实实的身影，敌人完全迷惑难以捉摸。\n",
"$n斜踏[1;36m‘乾坤大挪移’[0m，忽高忽低，有若[1;33m「坎蓬星水离为火，中宫坤艮土为营．”[0m只见$n脚踏坎位，再换离火，早已移转到敌人的身后了。\n",
});

int valid_enable(string usage) 
{
	return (usage=="dodge")||(usage=="move");
}

int valid_learn(object me)
{
        if(me->query_skill("literate",1)*2 <= me->query_skill("shift-steps",1))
        {
          write("你的知识不足，无法体会乾坤大挪移中易经六十四卦的精要变化。\n");
          return 0;
	}
 if(me->query("class") != "prayer")
return notify_fail("你非圣火徒不能学之\n");
	return 1;
}

string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
	if((int)me->query("kee")<5)
		return notify_fail("你的气不够，不能练乾坤大挪移。\n");
	me->receive_wound("kee",5);
	return 1;
}
