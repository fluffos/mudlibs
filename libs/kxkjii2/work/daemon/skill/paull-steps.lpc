// lum-steps.c
#include <ansi.h> 
inherit SKILL;
inherit SSERVER;          
string *dodge_msg = ({
"$n面露淡淡的微笑，柳腰一转，一招[1;35m「月儿倒钩”[0m，不慌不忙的轻轻闪过$N的杀着.\n",
"$n口中轻唸[1;35m「轻问清风声，闻声不见人”[0m，一双金莲犹如幻化千百双，$N的眼前瞬间出现好
几个人的身影，不知道哪个才是真的. \n",
"只见$n裙角一摆\，$n的身影已转到$N身后，并对着$N露出浅的一笑.\n",
"$n轻轻的原地旋转，舞出了[1;35m「落花散月，流水耀星”[0m，身子忽快忽慢，忽前忽后，实在是美
不胜收，只见$N呆呆站立，不晓得在想什么 .\n",
"$n袖子轻掩嘴角，左手轻捻，一招[1;35m「麒麟天地行，凤凰开天际”[0m，舞出了月影微步的精义
，$n身影轻轻地从$N的身边飘过.\n",
"$但是$n不慌不忙，左脚轻抬，一式[1;35m「天马追月”[0m，$n的身影已出现在半空中，有如蝴蝶□@般，轻轻的飘落在$N身影的一丈外.\n",
"月影微步的奥义，[1;35m「行者莫不住一脚，听君轻唱仕女音”[0m，在$n的舞动下，有如一朵盛开的
鲜花，鲜艳的彩蝶.\n"
});
 
int valid_skill_usage(string usage)
{
        return (usage=="dodge") || (usage=="move");
}
 int valid_enable(string usage)
 {
        return( usage=="dodge" || usage=="move") ;
 }
 
int valid_learn(object me)
{
        if( (int)me->query("max_force") < 10 )
                return notify_fail("你的内力不够，没有办法修炼月影微步 .\n");
 
        return 1;
}
string perform_action_file(string action)
{
return CLASS_D("dancer")+"/paull-steps/"+action;
} 
string query_dodge_msg(string limb)
{
        return dodge_msg[random(sizeof(dodge_msg))];
}
 
int practice_skill(object me)
{
        if( (int)me->query("kee") < 30
        ||      (int)me->query("force") < 5 )
                return notify_fail("你的气或内力不够，不能练月影微步 .\n");
        me->receive_damage("kee", 30);
        me->add("force", -3);
        return 1;
}
