        ([      "action":               "$N手中$w向外一分，使一招[32m「反覆无情”[0m反手对准$n$l一剑刺去",
                "dodge":                -20,
                "damage":               55,
                "damage_type":  "刺伤"
        ]),
        ([      "action":               "$N横剑上前，身形一转手中$w使一招[0m「散花如梦”[0m画出一道光弧斩向$n的$l",
