inherit SSERVER;

void berserk(object me,object victim,object weapon,int damage);

mapping *action = ({
        ([      "action":               "$N使一招[32m「天女拦花捧”[0m，手中$w使将出来剑光有如一花篮般, 向$n的$l疾驰而下",
