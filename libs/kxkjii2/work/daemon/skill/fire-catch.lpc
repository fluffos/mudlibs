// fire-catch.c
#include <combat.h>
inherit SKILL;
inherit SSERVER;

mapping *action = ({
        ([      "action":               "$N使出圣火奇功\[1;37m‘[31m绊[37m’[0m字诀，手中$w迅速狂扫向$n下盘！",
                "damage":               50,
                "force":            50,
	    "dodge":		-40,
	    "parry":		-40,
	    "damage_type":	"撞伤"
	]),
        ([      "action":               "$N使出圣火奇功\[1;37m‘[31m劈[37m’[0m字诀，手中$w从空往下狠劈向$n的$l！",
                "damage":               70,
                "force":            70,
	    "dodge":		-50,
                "parry":                    -50,
	    "damage_type":	"锤伤"
	]),
        ([      "action":               "$N转动手中$w，霎时[1;37m‘[31m转[37m’[0m字诀随棍而出闪电般击向$n的$l！",
                "damage":               90,
                "force":            90,
	    "dodge":		-35,
	    "parry":		-35,
	    "damage_type":	"击伤"
	]),
        ([      "action":               "$N挥动$w使出圣火奇功\[1;37m‘[31m封[37m’[0m字诀，霎时一阵棍雨飞击$n的$l！",
                 "damage":               100,
	                "force":            100,
     "dodge":		-30,
	     "parry":		-30,
	     "damage_type":	"击伤"
        ]),
        ([      "action":               "$N突然身影晃动，使出[1;37m‘[31m挑[37m’[0m字诀，手中$w由下往上抖向$n的$l！",
                "damage":               110,
                "force":            110,
                "dodge":                -30,
                "parry":                 -30,
                "damage_type":  "锤伤"
        ]),
        ([      "action":               "$N使出[1;37m‘[31m戳[37m’[0m字诀，只见手中$w化成团碧影，棍雨猛戳向$n的$l！",
                "damage":               120,
                "force":            120,
                "dodge":                -25,
                "parry":                  -25,
	    "damage_type":	"撞伤"
        ]),
        ([      "action":               "$N握住$w，使出[1;37m‘[31m引[37m’[0m字诀，棍随$n的攻击顺而点往$n的$l！",
                "force":            150,
                "damage":               150,
                "dodge":                -20,
                "parry":                  -20,
	    "damage_type":	"撞伤"
        ]),
        ([      "action":               "$N舞动$w使出[1;37m‘[31m缠[37m’[0m字诀，迅速使出一阵棍网猛击$n的$l！",
                "damage":              180,
                "force":            180,
                "dodge":                -20,
                "parry":                  -20,
                "damage_type":  "击伤"
        ]),
        ([      "action":               "$N手中$w一举，使出了[1;37m‘[31m怒火九重天[37m’[0m绵延不断的使出攻向$n的$l",
                "damage":              200,
                "force":            200,
                "dodge":                -10,
                "parry":                  -10,
                "damage_type":  "击伤"
        ]),
});

int valid_learn(object me)
{
	if((int)me->query("str") + (int)me->query("max_force") / 5 <50)
		return notify_fail("你的膂力还不够，也许\该练一练内力来增强力量。\n");
	return 1;
}

int valid_enable(string usage)
{
	return (usage=="stick") || (usage=="parry");
}

mapping query_action(object me, object weapon)
{
int skill_level, limit;
        skill_level=(int)me->query_skill("fire-catch", 1);
        limit=(int)skill_level/10;
        if (limit < 10)
                return action[random(limit)];
        else
                return action[random(sizeof(action))];
}

int practice_skill(object me)
{
	object weapon;
	if( !objectp(weapon = me->query_temp("weapon"))
	||	(string)weapon->query("skill_type") != "stick" )
                return notify_fail("你必须使用圣火教的令牌或是〔圣火令〕，才能使用圣火奇功\。\n");
	if(me->query_skill("force")*3<=me->query_skill("fire-catch",1))
          return notify_fail("你的内力根基不够, 不能用练圣火奇功\了。\n");
	if(me->query_skill("literate")*2<=me->query_skill("fire-catch",1))
          return notify_fail("你的知识不足，无法解读圣火令上的奇妙武学。\n");
	return 1;
	if( (int)me->query("kee") < 60 )
                return notify_fail("你的体力不够练〔圣火奇功\〕，还是先休息休息吧。\n");
	me->receive_damage("kee", 60);
	return 1;
}
string perform_action_file(string action)
{
        return CLASS_D("prayer")+"/fire-catch/"+action;
}
