

#include <ansi.h>

inherit ITEM;

void create()
{
	set_name("钵盂",({"bo yu","boyu"}));
	set_weight(400);
	if(clonep())
		set_default_object(__FILE__);
	else
	{
		set("task_owner","xingzhe");
		set("task_owner_cname","行者");
		set("reward_point",1);
		set("unit","个");
		set("no_sell",1);
                set("no_beg",1);
		set("value",2000);
	}
	
	setup();
	
}
