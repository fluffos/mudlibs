
string chinese_number(int i)
{
	return CHINESE_D->chinese_number(i);
}

string to_chinese(string str)
{
	return CHINESE_D->chinese(str);
}

int is_chinese(string str)
{
	// Was a GBK lead-byte range check (str[0] > 160 && str[0] < 255,
	// strlen>=2 meaning "at least one full 2-byte GBK char"). On this
	// driver str[i] is a Unicode codepoint and strlen() counts
	// characters, not bytes -- see AGENTS.md §15h. Use the CJK Unified
	// Ideographs codepoint range instead, and only require >=1 character.
	if( strlen(str)>=1 && str[0] >= 0x4e00 && str[0] <= 0x9fff ) return 1;
	return 0;
}
