inherit ITEM;
int top_cmd();

void create() {
  set_name("xxxx", ({ "book" }));
}


void init() {
  add_action("top_cmd", "top");
}

varargs int top_cmd(string arg) {

  string str;
  //      seteuid(geteuid(me));
  if (!arg || arg == "")
    return notify_fail("指令格式 : topten <类型>\n");
  str = TOP_D->topten_query(arg);
  write(str + "\n");
  return 1;
}
