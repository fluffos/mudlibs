// music   yangzhou's 兵勇

inherit NPC;

void create() {
  set_name("兵勇", ({ "bingyong", "bing", "yong" }));
  set("gender", "男性");
  set("age", 20);
  set("long",
    "呆若木鸡的兵勇。\n");
  set("mingwang", 1);
  set("combat_exp", 1000);
  set("str", 30);
  set("dex", 2);
  set("con", 2);
  set("int", 2);
  set("attitude", "peaceful");
  setup();
  carry_object("/obj/cloth")->wear();
  carry_object(__DIR__ "obj/gangdao")->wield();
  add_money("coin", 1);
}
