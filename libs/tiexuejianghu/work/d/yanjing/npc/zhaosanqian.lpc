inherit KZZNPC;
inherit F_VENDOR;

string query_save_file() { return DATA_DIR + "npc/赵三钱"; }
void create() {
#include <kzznpc.h>
  set("area_name", "燕京回春药铺");
  set("area_file", "/d/yanjing/yaopu.lpc");
  set("vendor_goods", ([
    "熊胆": __DIR__ "obj/xiongdan",
    "田七": __DIR__ "obj/tianqi",
    "没药": __DIR__ "obj/muoyao",
    "血竭": __DIR__ "obj/xuejie",
  ]));
  setup();
  carry_object("/d/obj/cloth/choupao")->wear();
  add_money("silver", 20);
}
void init() {
  ::init();
  add_action("do_vendor_list", "list");
}
