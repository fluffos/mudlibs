//Oldsix's 木钉

#include <weapon.h>

inherit THROWING;

void create() {
  set_name("木钉", ({ "muding", "ding" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "木头削成的尖钉。\n");
    set("unit", "些");
    set("base_value", 1);
    set("base_unit", "支");
    set("base_weight", 10);
  }
  set_amount(1);
  init_throwing(2);
  setup();
}
