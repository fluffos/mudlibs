// tieshou.c

#include <armor.h>

inherit "/std/weapon/unarmed.lpc";

void create() {
  set_name("铁手掌", ({ "tieshouzhang", "tie shouzhang", "shouzhang" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("material", "steel");
    set("value", 5000);
    set("unit", "双");
  }
  init_unarmed(20);
  setup();
}
