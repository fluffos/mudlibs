#include <ansi.h>

inherit KZZNPC;
inherit F_VENDOR;
string query_save_file() { return DATA_DIR + "npc/柳无生"; }

void create()
{
#include <kzznpc.h>
set("vendor_goods",([
"baizhengao":__DIR__"obj/baizhengao.lpc",
"congyoubaocui":__DIR__"obj/congyoubaocui.lpc",
"lvdougao":__DIR__"obj/lvdougao.lpc",
"puercha":__DIR__"obj/puercha.lpc",
]));
set("area_name","京城高升茶馆");
set("area_file","/d/huanggon/chaguan.lpc");
	setup();
carry_object("/obj/std/armor/tiejia")->wear();
carry_object("/obj/cloth")->wear();
add_money("silver",2);
}
void init()
{
::init();
  add_action("do_vendor_list","list");
}
