inherit NPC;
void create()
{
   set_name("白寒枫",({"bai hanfeng"}));
   set("gender","男性");
	set("shen_type",1);
   set("age",24);
   set("combat_exp",150000);
   set("force",600);
   set("max_force",600);
   set("force_factor",20);
   
   set("chat_chance",4);
   set("chat_msg",({
  "白寒枫在灵前哭道:哥哥你死得好惨,兄弟要为你报仇.\n",
  "白寒枫怒道:就是天地会那帮狗贼.\n",
  }));
   set_skill("unarmed",35);
   set_skill("parry",35);
   set_skill("dodge",35);
   set_skill("blade",35);
   set_skill("anying-fuxiang",35);
   set_skill("wuhu-duanmendao",35);
   set_skill("tiangang-zhi",35);
   map_skill("parry","tiangang-zhi");
   map_skill("dodge","anying-fuxiang");
   map_skill("blade","wuhu-duanmendao");
   setup();
   add_money("silver",20);
   carry_object("/obj/cloth")->wear();
 }
 
