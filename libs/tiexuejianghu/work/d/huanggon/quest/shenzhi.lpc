#include <ansi.h>
inherit ITEM;
inherit F_LIQUID;

void create()
{
	set_name(HIY"圣旨"NOR, ({ "shen zhi" }) );
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long","皇帝颁发的圣旨。\n");
		set("unit", "张");
		set("no_give",1);
		set("no_drop",1);
		set("no_steal",1);
		set("no_sell",1);
	}
}
