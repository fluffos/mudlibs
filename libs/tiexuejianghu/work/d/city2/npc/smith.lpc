// smith.c

inherit NPC;
inherit F_VENDOR;

void create()
{
        set_name("铁匠", ({ "tiejiang", "smith" }));
	set("title", "铁匠铺老板");
	set("shen_type", 1);

        set("gender", "男性" );
        set("age", 33);
        set("long", "铁匠正用铁钳夹住一块红热的铁块放进炉中。\n");

        set("combat_exp", 400);
	set("attitude", "friendly");
        set("vendor_goods",([
                   "长剑":"/obj/weapon/sword",
                   "钢刀":"/obj/weapon/blade",
                   "铁锤":"/obj/weapon/hammer",
                   "屠刀":"/d/city2/obj/tudao",
        ]));

	setup();
carry_object("/obj/cloth")->wear();
}

void init()
{
        add_action("do_vendor_list", "list");
}
