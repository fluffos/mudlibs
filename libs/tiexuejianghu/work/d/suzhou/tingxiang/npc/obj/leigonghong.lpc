// Mr.music yangzhou 竹叶


#include <weapon.h>

inherit THROWING;

void create() {
  set_name("雷公轰", ({ "leigong hong", "leigong", "hong" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "青城派的独门暗器。\n");
    set("unit", "柄");
    set("base_unit", "枚");
    set("base_weight", 5);
    set("value", 100);
  }
  set_amount(1);
  init_throwing(1);
  setup();
}
