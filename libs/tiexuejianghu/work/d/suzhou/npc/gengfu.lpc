// music   yangzhou's 店小二
#include <localtime.h>
#include <ansi.h>
inherit NPC;
nosave string *sym_dee = ({ "子","丑","寅","卯","辰","巳","午","未","申","酉","戌","亥" });

void create()
{
	set_name("更夫",({"geng fu","fu","geng"}));
	set("gender", "男性" );
	set("age",45);
	set("long",
		"苏州府内的打更人。\n");
	set("mingwang",1);
	set("combat_exp",2000);
	set("attitude", "friendly");
	setup();
}

void init()
{	
	object ob;

	::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
}

void greeting(object ob)
{
	string time;
	mixed *local;
	if( !ob || environment(ob) != environment() ) return;
	local=localtime(time()*60);
	time=sym_dee[((local[LT_HOUR]+1)%24)/2]+"时啊"+chinese_number((local[LT_MIN]+1)%2 * 2 + local[LT_MIN]/30 + 1)+"刻哟！";
	message_vision(CYN"只听得更夫大声吆喝："+time+"\n"NOR,ob);

}
