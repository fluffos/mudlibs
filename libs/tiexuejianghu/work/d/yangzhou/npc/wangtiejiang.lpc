inherit KZZNPC;
inherit F_VENDOR;

string query_save_file() { return DATA_DIR + "npc/王铁匠"; }
void create() {
#include <kzznpc.h>

  set("area_name", "扬州打铁铺");
  set("area_file", "/d/yangzhou/tiepu.lpc");

  set("vendor_goods", ([
    "长剑": __DIR__ "obj/changjian",
    "短剑": __DIR__ "obj/duanjian",
    "匕首": __DIR__ "obj/bishou",
    "钢刀": __DIR__ "obj/gangdao",
    "飞镖": __DIR__ "obj/feibiao",
    "tiejia": "/obj/std/armor/tiejia",
    "tongjia": "/obj/std/armor/tongjia",
    "pijia": "/obj/std/armor/pijia",
  ]));

  setup();
  carry_object("/obj/cloth")->wear();
  carry_object("/obj/weapon/hammer")->wield();
  carry_object("/obj/std/armor/tiekui")->wear();
  carry_object("/obj/std/armor/tiejia")->wear();
  carry_object("/obj/std/armor/tiexue")->wear();

  add_money("silver", 30);
}
void init() {
  ::init();
  add_action("do_vendor_list", "list");
}
