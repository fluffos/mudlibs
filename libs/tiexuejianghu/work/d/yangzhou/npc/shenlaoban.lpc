inherit KZZNPC;
inherit F_VENDOR;

string query_save_file() { return DATA_DIR + "npc/孙裁缝"; }
void create()
{
#include <kzznpc.h>

	set("area_name","扬州裁缝店");
	set("area_file","/d/yangzhou/caifengdian.lpc");

 	set("vendor_goods", ([
		"长衫":     __DIR__"obj/changshan",
		"猎装":     __DIR__"obj/liezhuang",
		"虎皮":     __DIR__"obj/hupi",
		"langpi":__DIR__"obj/langpi",
		"goupi":__DIR__"obj/goupi",
		"diaopi":__DIR__"obj/diaopi",
		"duanshan":__DIR__"obj/duanshan",
		"feicuiqun":__DIR__"obj/feicuiqun",
        ]) );

        setup();
carry_object("/obj/cloth")->wear();
add_money("coin",30);
}
void init()
{
	::init();
  add_action("do_vendor_list","list");
}



