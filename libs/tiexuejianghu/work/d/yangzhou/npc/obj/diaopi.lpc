//Mr.music yangzhou 虎皮

#include <armor.h>

inherit CLOTH;

void create() {
  set_name("貂皮大衣", ({ "diao pi", "diaopi", "pi" }));
  set_weight(4000);
  if (clonep())
    set_default_object(__FILE__);
  else {

    set("material", "pi");
    set("value", 8000);
    set("unit", "件");
    set("armor_prop/armor", 8);
    set("armor_prop/personality", 5);
  }
  setup();
}
