//Mr. music yangzhou 长衫

#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("短衫", ({"duan shan","shan", "duanshan","cloth" }) );
	set_weight(1500);
	if( clonep() )
		set_default_object(__FILE__);
	else {
                set("value", 200);
		set("unit", "件");
		set("material", "cloth");
		set("armor_prop/armor", 3);
	}
	setup();
}
