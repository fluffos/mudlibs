inherit NPC;

void create() {
  set_name("戌狗", ({ "dog" }));
  set("race", "野兽");
  set("age", 6);
  set("long", "浑身墨黑,犬牙半露,好一条吠天犬。\n");

  set("str", 25);
  set("cor", 24);
  set("combat_exp", 25000);
  set("kee", 800);
  set("max_kee", 800);

  set("limbs", ({ "犬牙", "身体", "前爪", "后爪", "尾巴" }));
  set("verbs", ({ "bite", "claw" }));

  set_temp("apply/attack", 10);
  set_temp("apply/armor", 20);

  set("chat_chance", 5);
  set("chat_msg", ({
    "吠天犬汪汪叫了两声,被镇晕落下的苍蝇掉了一地.\n",
    "吠天犬对着你滋牙咧齿,你一看,喔,都是蛀牙.\n",
  }));

  setup();
}

void die() {
  message_vision("$N汪汪--汪汪叫了一阵,跑出室外去了.\n", this_object());
  new(__DIR__ "obj/quanya.lpc")->move(environment(this_object()));
  destruct(this_object());
  return;
}
