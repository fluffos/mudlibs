#include <ansi.h>
inherit KZZNPC;

string query_save_file() { return DATA_DIR + "npc/阿布"; }
void create()
{
#include <kzznpc.h>

       set("area_name","乌蒙村落");
	set("area_file","/d/dali/wumeng.lpc");
	set("ziyuan","山羊");
	set("jizhi",40);
	set("kaifa",20);

        setup();
	carry_object(__DIR__"obj/wchangqun")->wear();
	carry_object("/obj/weapon/whip")->wield();
}

#include <die.h>