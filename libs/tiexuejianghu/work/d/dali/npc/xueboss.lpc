inherit KZZNPC;
inherit F_VENDOR;

string query_save_file() { return DATA_DIR + "npc/薛慕汉"; }
void create()
{
#include <kzznpc.h>

	 set("vendor_goods", ([
                "绣花小鞋":__DIR__"obj/shoes",
                "斗蓬":__DIR__"obj/doupeng",
             "对衿褂子": __DIR__"obj/guazi",
                "窄裉袄":__DIR__"obj/kenao",
	"白纱挑线镶边裙":__DIR__"obj/qun",
        ]) );

       set("area_name","大理薛记成衣铺");
       set("area_file","/d/dali/garments.lpc");
        setup();
carry_object("/d/obj/cloth/choupao")->wear();
add_money("silver",5);
}
void init()
{
::init();
 add_action("do_vendor_list","list");
}



