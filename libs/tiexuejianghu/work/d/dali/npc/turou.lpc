// turou.c 野兔肉 by ksusan 8/03/97 8:45

inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("兔肉", ({ "turou" }) );
	set_weight(80);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一块鲜血淋漓的野兔肉，饿急了生吃味道不坏。\n");
		set("unit", "块");
		set("value", 15);
		set("food_remaining", 3);
		set("food_supply", 60);
	}
}
