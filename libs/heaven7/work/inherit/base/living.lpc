/* classes array stuff */

status query_class(string str) {  
  if(!classes) classes = ({});
  return (member_array(str, classes) == -1) ? 0 : 1;
}  
  
void add_class(string str){  
  if(!query_class(str) && str) classes += ({ str, });
}  
  
void remove_class(string str){  
