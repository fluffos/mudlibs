#include <mudlib.h>
inherit BASE;

#ifdef NATIVE_MODE
void create() {
#else
void reset(status arg) {
  if(arg) return;
#endif /* native */

/* Default */

  set_weight(1);
  set_value(10);
  set_name("gem");
  set_alias("ruby");
  set_short("Gem");
  set_long("It looks like a small ruby.\n");
  set_extra_info("It doesn't look very valuable.\n");
  call_other(this_object(), "reset", 0);
}

status get() { return 1; }

string query_object_type() { return "Treasure"; }
