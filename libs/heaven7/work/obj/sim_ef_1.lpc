#endif /* not native */


mixed snoop(mixed snoopee) {
    int result;

    if (snoopee && query_snoop(snoopee)) {
     write("Busy.\n");
     return 0;
    }
#if defined(FLUFFOS)
    object ob_res = snoopee ? efun::snoop(this_player(), snoopee) : efun::snoop(this_player());
    result = ob_res ? 1 : 0;
#elif defined(NATIVE_MODE)
    result = efun::snoop(this_player(), snoopee);
#elif defined(COMPAT_FLAG)
    result = snoopee ? efun::snoop(this_player(), snoopee)
               : efun::snoop(this_player());
#endif /* compat - native */
    switch (result) {
     case -1:
         write("Busy.\n");
     case  0:
         write("Failed.\n");
     case  1:
         write("Ok.\n");
    }
    if (result > 0) return snoopee;
    return 0;
}

#endif /* amylaar or mudos */


