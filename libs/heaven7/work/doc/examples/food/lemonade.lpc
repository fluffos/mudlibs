/* Jug of Lemonade */

inherit "inherit/drink";

void reset(status arg) {
  if(arg) return;
  set_name("lemonade");
  set_alt_name("jug of lemonade");
  set_empty_container("jug");
  set_short("Jug of Lemonade");
  set_long("The jug contains some lemonade.\n"+
           "Its quite cool at the moment.\n");
  set_listen("You hear the lemonade sloshing around in the jug.\n");
  set_smell("You smell the strong smell of lemons.\n");
  set_room_msg("@@query_name:$this_player()$@@ puts the jug to "+
               "@@query_possessive:$this_player()$@@ mouth\n"+
               "and slurps down all the lemonade.\n");
  set_consumer_msg("You slurp down the jug of lemonade.\n");
  set_strength(3);   /* value is set by strength value */
  set_soft_drink(1); /* makes a soft drink */
}
