/* This monster does a bit of talking, while he is standing in the room */
/* Author : Goosestep                                                   */

inherit "inherit/monster";

void reset(status arg) {
  ::reset(arg);
  if(arg) return;
  set_name("butler");
  set_alt_name("jeeves");
  set_level(10);
  set_short("Jeeves the butler");
  set_long(
    "This is Goosestep's butler.  He looks attentive and willing\n"+
    "to serve. He is wearing a prominent set of noseplugs.\n");
  set_alignment(-50);
  set_race("human");
  load_chat(5, ({
    "The Butler looks at you with disdain.\n",
    "The Butler dusts off your clothing.\n",
    "The Butler says: Would you care for tea?\n",
    "The Butler says: The master will see you soon.\n",
    "The Butler says: The weather is poor today, Sir.\n",
  }));
}
