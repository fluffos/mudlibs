/* Bracers of Defence */
/* Read armour.doc for armour guidelines */

inherit "inherit/armour";

void reset(status arg) {
  if(arg) return;
  set_name("bracers");
  set_alt_name("arm bands");
  set_alias("bands");
  set_short("Arm Bands");
  set_long("These are small golden armbands, that slip onto your wrists.\n");
  set_ac(3);
  set_weight(2);
  set_value(2825);
  set_type("armour");
  set_armour_material("gold");
  set_enchanted(1);
  set_info("These are magical arm bands are Bracers of Defence.\n"+
           "It is effective as wearing chainmail.\n");
}
