/* general - combined spell weapon and armor bonus object */

inherit "inherit/base/base_obj";
inherit "inherit/timer";

int wc_bonus;
int left_wc_bonus;
int ac_bonus;

int set_wc_bonus(int i) { return wc_bonus = i; }
int set_left_wc_bonus(int i) { return left_wc_bonus = i; }
int set_ac_bonus(int i) { return ac_bonus = i; }

int weapon_class_bonus() { return wc_bonus; }
int left_weapon_class_bonus() { return left_wc_bonus; }
int armour_class_bonus() { return ac_bonus; }

void time_out() {
  wc_bonus = 0;
  left_wc_bonus = 0;
  ac_bonus = 0;
  tell_object(environment(), "The " + query_name() + " fades...\n");
  if (environment()) {
    environment()->recalc_wc();
    environment()->recalc_ac();
  }
  ::time_out();
}

void dispel_magic() { time_out(); }

status drop(status quit) {
  if (quit) time_out();
  return 1;
}

status id(string str) {
  return str == "external" || str == "spell" || str == "spell weapon" || str == "spell armor" || ::id(str);
}

/* Native Mode Move */

#include <move.h>
