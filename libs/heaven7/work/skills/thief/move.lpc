/* MOVE SILENTLY. Angel, August 1993.
 * This function simply toggles the players
 * stealth flag on and off.
 */

move(string arg) {
  if(arg != "silently") {
    notify_fail("move silently?\n");
    return 0;
  }
  this_player() -> toggle_stealth();
  return 1;
}

/* Skill command defines move(string arg), so skip move.h's move(mixed dest) */
