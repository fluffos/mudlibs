/* GOODBERRY SPELL */  

status goodberry(string targ, mixed alt_type) {

  if(!alt_type) alt_type = "nature_sphere";

  this_player()->load_spell(({
  "target",            this_player(),
  "name",              "Goodberry",
  "sphere",            alt_type, 
  "cost",              6,
  "level",             6,
  "cast time",         1,
  "passive",
  "component",         "berry",
  "spell object",      "skills/obj/berry",
  }));
  return 1;
}

/* Native Mode Move */

#include <move.h>
