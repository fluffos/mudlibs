#include <mudlib.h>
inherit ROOM;

void reset(status arg) {
   if(!arg) {
     set_short("Forest entrance");
     set_long(
     "The elfin forest lies just to the east. The newbie forest is the \n"+
     "home of many elves and forest creatures.  It is also the home of \n"+
     "a great evil. \n");
      set_exits(({
         "/room/newbie/new1.lpc",  "north",
         "/room/newbie/road1.lpc",  "west",
       }));
       set_weather(2,4,3);
    }
}

