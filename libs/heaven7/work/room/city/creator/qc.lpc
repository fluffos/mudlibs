#include <mudlib.h>
inherit ROOM;

void reset(status arg) {
object board;
  if(!present("board")) {
    board = clone_object(BULLETIN_BOARD);
    board -> set_save_file("ob_saves/QC_board");
    board -> set_short("A 'QC' notice board");
    move_object(board,this_object());
  }

  if(arg) return;
  set_short("The inner room of town hall");
  set_long(
     "This large chamber is used primarily as an announcement room \n"+
     "for QC related matters. If you wish to have an area, or item \n"+
     "approved, or queries about 'QC' matters, then post notes here.\n");

  set_exits(({
     "room/city/creator/inner1",   "south",
  })); 
  set_weather(2,1,0);
}
