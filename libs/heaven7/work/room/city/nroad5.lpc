inherit "inherit/room2";

void reset(status arg) {
  if(arg) return;

  set_weather(1, 1, 0);
  set_short("a long pathed road");
  set_long(
	"You stand on the north road, leading out of Tempus city and into  \n"+
	"the lands beyond. The road is of a fine sandy brown cobblestone,  \n"+
	"and beside the road, green trees sway in the breeze. Ahead, you can \n"+
	"see a tall building, sort of triangular in shape.\n");
  set_exits(({
	"room/city/nroad6", "north",
	"room/city/nroad4", "south",
  }));
  set_items(({
	"spire#tall spire#building",
	"Perhaps it is an ancient pyramid!",
	"road", "A long road that goes north",
	"cobblestone#cobblestones",
	"They are made of a fine sandy stone",
	"tree#trees",
		"They appear to be fine oak trees",
  }));
  set_listen("You can hear the trees rustling in the wind.\n");
  set_smell("The fine sweet smell of fresh air greets your senses.\n");
}
