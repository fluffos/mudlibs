inherit BULLETIN_BOARD;

#include <ansi.h>

void create()
{
        set_name(HIC"mafu 留言簿"NOR, ({ "board" }) );
        set("location", "/u/mafu/workroom");
        set("board_id", "mafu_b");
        set("long", "mafu 工作留言簿\n" );
        setup();
        set("capacity", 100);
        replace_program(BULLETIN_BOARD);
}
