#include <ansi.h>
inherit ITEM;
int cure_ob(string);
void init();

void create() {
  set_name(YEL "土茯苓" NOR, ({ "tu fuling", "fuling" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "钱");
    set("long", "土茯苓：根茎类，甘，淡，平，主治骨挛痈漏，骨挛痈漏。\n");
    set("value", 100);
    set("yaocai", 1);
    set("cure_s", 0);
    set("cure_d", 20);
    set("cure_n", 0);
  }
  setup();
}
