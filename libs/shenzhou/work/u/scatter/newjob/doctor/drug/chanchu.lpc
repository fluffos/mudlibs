//by keny
#include <ansi.h>
inherit ITEM;
int cure_ob(string);
void init();

void create() {
  set_name(HIC "蟾蜍" NOR, ({ "chanchu" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "只");
    set("long", "蟾蜍：虫部，气味蟾酥：甘辛，温，有毒‘辛、凉、微毒’ 主治拔取疔毒，破伤风。\n");
    set("value", 100);
    set("yaocai", 1);
    set("cure_s", 0);
    set("cure_d", 0);
    set("cure_n", 0);
  }
  setup();
}
