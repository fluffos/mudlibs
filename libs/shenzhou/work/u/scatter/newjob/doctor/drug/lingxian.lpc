#include <ansi.h>
inherit ITEM;
int cure_ob(string);
void init();

void create() {
  set_name(HIC "威灵仙" NOR, ({ "wei lingxian", "lingxian" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "钱");
    set("long", "威灵仙: 根茎类，味苦，气温，有驱痛，止血之效。\n");
    set("value", 100);
    set("yaocai", 1);
    set("cure_s", 0);
    set("cure_d", 20);
    set("cure_n", 0);
  }
  setup();
}
