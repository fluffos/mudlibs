#include <ansi.h>
inherit ITEM;
int cure_ob(string);
void init();

void create() {
  set_name(GRN "木香" NOR, ({ "mu xiang", "xiang" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "钱");
    set("long", "木香：根茎类，辛，温，行气止痛，健脾和胃。\n");
    set("value", 100);
    set("yaocai", 1);
    set("cure_s", 0);
    set("cure_d", 20);
    set("cure_n", 0);
  }
  setup();
}
