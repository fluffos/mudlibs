//by keny
#include <ansi.h>
inherit ITEM;
int cure_ob(string);
void init();

void create() {
  set_name(HIC "蝼蛄" NOR, ({ "lougu" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "只");
    set("long", "蝼蛄：虫部，咸，寒，主治水肿病，牙齿疼痛。\n");
    set("value", 100);
    set("yaocai", 1);
    set("cure_s", 0);
    set("cure_d", 0);
    set("cure_n", 0);
  }
  setup();
}
