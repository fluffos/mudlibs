// mashroom 蘑菇

#include <ansi.h>
inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("蘑菇", ({ "mo gu", "mashroom" }));
  set_weight(40);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一只灰白色小蘑菇。\n");
    set("unit", "只");
    set("value", 0);
    set("food_remaining", 3);
    set("food_supply", 10);
  }
}
