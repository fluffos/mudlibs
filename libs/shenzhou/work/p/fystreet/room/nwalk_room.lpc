//indoor.c zip@hero 2000.1.27 房子内部
#include <ansi.h>
#define ID 3600
inherit ROOM;
void create() {
  set("short", "[1;32m静瑶斋[37;0m");
  set("long", @LONGLONGAGO
你刚一进门，就被这所房子的气派镇住了！这所房子总共分前园后园和
中庭三个部分，前园青石板地上以被踩出了许多淡淡的足印，足见此屋主人
武功深厚，后园假山水池，一片春意盎然，你不禁奇怪，到底何方雅士有此
闲情雅致。刚进中庭，走出一位翩翩少女，你定睛一看，乖乖龙地东，此女
貌若天仙，真乃闭月羞花，沉鱼落雁，芙蓉妖艳，明媚回春！你不禁脚下一
软,晕了过去。
LONGLONGAGO);
  set("exits", ([
    "out": "/p/fystreet/street" + (string)ID,
  ]));
  set("owner", "nwalk");
  set("no_fight", 1);
  set("no_magic", 1);
  set("sleep_room", 1);
  set("if_bed", 1);
  set("NONPC", 1);
  set("no_dazuo", 1);
  set("no_study", 1);
  set("coor/x", 40 + (ID % 2) * 20);
  set("coor/y", 20 + (ID / 100) * 10);
  set("coor/z", 0);
  setup();
  call_other("/p/fystreet/board/nwalk_board", "???");
}
#include "indoor_func.lpc"
