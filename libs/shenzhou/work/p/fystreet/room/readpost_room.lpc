//indoor.c zip@hero 2000.1.27 房子内部
#include <ansi.h>
#define ID 2100
inherit ROOM;
void create() {
  set("short", "[1;36m踏[1;33m月[1;35m扫[1;37m雪[36m居[37;0m");
  set(
    "long",
    @LONGLONGAGO
左边的墙上挂着一把竹笛子，但是封满了尘，已经很久没有用过了。透过窗子，可以看到披着雾气的小湖；湖边长着好一些茉莉花，花香飘进屋子，使得人心旷神怡。屋顶不知道是用什么做的，可以看到天空。月光透过屋顶洒进来，使人仿佛置身于旷野之中。
LONGLONGAGO
  );
  set("exits", ([
    "out": "/p/fystreet/street" + (string)ID,
  ]));
  set("owner", "readpost");
  set("no_fight", 1);
  set("no_magic", 1);
  set("sleep_room", 1);
  set("if_bed", 1);
  set("NONPC", 1);
  set("no_dazuo", 1);
  set("no_study", 1);
  set("coor/x", 40 + (ID % 2) * 20);
  set("coor/y", 20 + (ID / 100) * 10);
  set("coor/z", 0);
  setup();
  call_other("/p/fystreet/board/readpost_board", "???");
}
#include "indoor_func.lpc"
