//indoor.c zip@hero 2000.1.27 房子内部
#include <ansi.h>
#define ID 2400
inherit ROOM;
void create()
{	set("short","[1;33m鸡窦[37;0m");
	set("long",@LONGLONGAGO
这是小狼的鸡窦,是男人寻乐的好地方.一进门,就令人精神一振.经过走廊,里面是很大的大厅.里面极之舒适,而且漂亮妹妹都处都是.令人意想不到的是,什么国家的妹妹都有.有中,法,日,美,俄,身材从32A至38F,衣着从学校服,到比坚尼,甚至没穿都有.小狼的朋友到这里来的,都舍不得走,说未玩够.
LONGLONGAGO	);
	set("exits",([
        "out":"/p/fystreet/street"+(string)ID,
		]));
	set("owner","zenklee");
       set("no_fight",1);
       set("no_magic",1);
       set("sleep_room",1);
       set("if_bed",1);
       set("NONPC",1);
       set("no_dazuo",1);
       set("no_study",1);
	set("coor/x",40+(ID%2)*20);
	set("coor/y",20+(ID/100)*10);
	set("coor/z",0);
	setup();
   call_other("/p/fystreet/board/zenklee_board","???");
}
#include "indoor_func.c"
