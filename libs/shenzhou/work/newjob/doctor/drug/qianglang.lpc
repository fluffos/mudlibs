//by keny
#include <ansi.h>
inherit ITEM;
int cure_ob(string);
void init();

void create() {
  set_name(WHT "蜣螂" NOR, ({ "qianglang" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "只");
    set("long", "蜣螂：虫部，气味咸，寒，有毒，主治疔肿恶疮，赤白痢。
\n");
    set("value", 100);
    set("yaocai", 1);
    set("cure_s", 0);
    set("cure_d", 0);
    set("cure_n", 0);
  }
  setup();
}
