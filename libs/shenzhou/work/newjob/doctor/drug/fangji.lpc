#include <ansi.h>
inherit ITEM;
int cure_ob(string);
void init();

void create() {
  set_name(BLU "防己" NOR, ({ "fang ji", "ji" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "钱");
    set("long", "防己：根茎类，辛，平，可治伤寒喘急，肺痿喘嗽。\n");
    set("value", 100);
    set("yaocai", 1);
    set("cure_s", 10);
    set("cure_d", 4);
    set("cure_n", 23);
  }
  setup();
}
