//by keny
#include <ansi.h>
inherit ITEM;
int cure_ob(string);
void init();

void create() {
  set_name(GRN "螳螂桑螵蛸" NOR, ({ "tanglang sangpiaoxiao", "tianlang" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "只");
    set("long", "螳螂桑螵蛸：虫部，咸，甘，平，主治遗精白浊，盗汗虚劳，咽喉肿塞。\n");
    set("value", 100);
    set("yaocai", 1);
    set("cure_s", 0);
    set("cure_d", 0);
    set("cure_n", 0);
  }
  setup();
}
