//by keny
#include <ansi.h>
inherit ITEM;
int cure_ob(string);
void init();

void create() {
  set_name(HIC "虫白蜡" NOR, ({ "chongbai la" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "只");
    set("long", "虫白蜡：虫部，甘，温，主治生肌止血，定痛补虚，续筋接骨。\n");
    set("value", 100);
    set("yaocai", 1);
    set("cure_s", 0);
    set("cure_d", 0);
    set("cure_n", 0);
  }
  setup();
}
