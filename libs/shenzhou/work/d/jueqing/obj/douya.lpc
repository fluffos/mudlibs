// /d/jueqing/obj/douya.c 素炒豆芽
// jiuer -- 08/15/2001

#include <ansi.h>
inherit ITEM;
inherit F_FOOD;

void create() {
  set_name(HIY "素炒豆芽" NOR, ({ "suchao douya", "dou ya", "douya" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一盆黄白相间，清香可口的素炒黄豆芽。\n");
    set("unit", "盆");
    set("value", 150);
    set("food_remaining", 4);
    set("food_supply", 40);
  }
}
