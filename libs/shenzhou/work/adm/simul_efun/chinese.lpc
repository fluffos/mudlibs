// Code of ShenZhou
// modify is_chinese() by Karlopex@sz at 06/03/2002
string chinese_number(int i) {
  return CHINESE_D->chinese_number(i);
}

string to_chinese(string str) {
  return CHINESE_D->chinese(str);
}

int is_chinese(string str) {
  int i;

  // AGENTS.md §15h: this driver indexes strings by Unicode codepoint,
  // not by raw GBK byte, so the original byte-range check (str[i] < 161
  // || str[i] == 255, plus a str[i] < 176 || str[i] >= 248 lead-byte
  // check on every other index) never matches real Chinese text under
  // UTF-8. Replaced with a straight CJK Unified Ideographs codepoint
  // range check, once per character (no byte-parity gating needed).
  if (strlen(str) < 1) return 0;

  for (i = 0; i < strlen(str); i++) {
    if (str[i] < 0x4e00 || str[i] > 0x9fff) return 0;
  }

  return 1;
}
