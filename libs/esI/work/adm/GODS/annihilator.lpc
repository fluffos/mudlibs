#include <races.h>

inherit RACE_GOD;

void create()
{
	::create();
	seteuid(getuid());
	set_level(19);
	set_name( "annihilator", "安尼席洛特尔" );
	add ("id", ({ "god" }) );
	set_short( "Annihilator the God", "安尼席洛特尔大神" );
	set_long(
		"This is the well-known primary god of ES. His name is the most\n"
		"powerful word in the mud. But, don't bother him with bug reports\n"
		"and your ideas. Those are not his job.\n",
		"这个人就是大家所知道的 Annihilator，如果你有事找他，请在远风镇的\n"
		"邮局寄信或用 E-mail 到 mschang@cis.nctu.edu.tw。\n"
	);
	set( "gender", "male" );

	set_perm_stat( "str", 30 );
	set_perm_stat( "int", 30 );
	set_perm_stat( "dex", 30 );
	set_perm_stat( "con", 30 );
	set_perm_stat( "pie", 30 );
	set_perm_stat( "kar", 30 );

	set_skill( "longblade", 100 );
	set_skill( "parry", 100 );
	set_skill( "dodge", 100 );

	set( "max_hp", 30000 );
	set( "hit_points", 30000 );
	set( "force_points", 100000 );
	set( "max_fp", 100000 );
	set( "wealth/platinum", 1 );
	set( "exp_reward", 1 );

	set_natural_weapon( 200, 50, 100 );
	set_natural_armor( 500, 500 );
	set( "special_defense", ([ "all": 100, "none": 100 ]) );
	
	set( "tactic_func", "add_explore" );

	set( "chat_chance", 5 );
	set( "chat_output", ({
		"Annihilator says: How about some more wars?\n",
		"安尼席洛特尔说：赶快引发战争吧，杀杀杀杀杀杀杀 .....\n",
		"Annihilator grins evily.\n",
		"安尼席洛特尔说：差不多该 Reboot 了吧。\n",
		"Annihilator looks at you.\n",
		"安尼席洛特尔说：孩子，夜深了，打个电话回家 ....。\n",
	}) );
	wield_weapon( "/d/noden/nodania/obj/anni_sword" );
	equip_armor( "/d/noden/nodania/obj/headband" );
}

int add_explore()
{
	object victim;

	if( victim = query_attacker() ) victim->set_explore("noden#18");
    return 0;
}
