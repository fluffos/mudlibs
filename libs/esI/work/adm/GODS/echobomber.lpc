#include <races.h>

inherit RACE_GOD;

void create() {
  ::create();
  seteuid(getuid());
  set_level(19);
  set_name("echobomber", "echobomber");
  add("id", ({ "god" }));
  set_short("echobomber the God", "echobomber the God");
  set_long("Echobomber the God \n",
    "来无影 ,去无踪 ,没有人能够掌握住他的行踪 .常常忽然出现於你的身边问候你 ,\n"
    "然而你却不知道他出现过 ,因为他总是以不同的身份出现於世间 .\n"
  );
  set("gender", "male");

  set_perm_stat("str", 30);
  set_perm_stat("int", 30);
  set_perm_stat("dex", 30);
  set_perm_stat("con", 30);
  set_perm_stat("pie", 30);
  set_perm_stat("kar", 30);

  set_skill("longblade", 100);
  set_skill("parry", 100);
  set_skill("dodge", 100);

  set("max_hp", 30000);
  set("hit_points", 30000);
  set("force_points", 300000);
  set("max_fp", 300000);
  set("wealth/platinum", 1);
  set("exp_reward", 1);

  set_natural_weapon(200, 50, 100);
  set_natural_armor(500, 500);
  set("special_defense", ([ "all": 100, "none": 100 ]));
  set("unbleeding", 1);
  wield_weapon("/d/noden/nodania/obj/god_sabre");
}
