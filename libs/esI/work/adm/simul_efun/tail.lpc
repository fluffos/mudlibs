// tail.lpc
// tail() was an efun of the MudOS this lib was written for; this driver does not have it.  It showed the end of a file
// to this_player() and returned 1, or 0 when the file could not be read.  This shows the last 1000 bytes, from the
// first complete line.

int tail(string path) {
  int size, start;
  string text, *lines;

  if ((size = file_size(path)) < 1) return 0;
  start = size > 1000 ? size - 1000 : 0;
  text = read_bytes(path, start, size - start);
  if (!text) return 0;
  if (start && sizeof(lines = explode(text, "\n")) > 1)
    text = implode(lines[1..], "\n");
  message("write", text, this_player());
  return 1;
}
