#adm/daemons/mailmesg.c
remain ({"aquarius",})
mesg "hi! Aquarius	/d/mage/cmds/_cast.c 里的silence那个字我已经改过来了。tape.c 里add_action(\"do_day\",\"shout\");拼错字。this_object()->set(\"short\",\"一条胶带正贴在\"+dest->query(\"c_name\")+\"的大嘴巴上\");这一行有什麽特殊用意吗？这好像会使受害者看到这个胶带的叙述怪怪的。还有尽量少用一些字串相加，可以用sprintf取代，原因在help optimizing_code 里有说。嗯，好像最近愈来愈婆婆妈妈的了。:pYueh"
