#include <../under.h>
inherit MONSTER;

void create() {
  ::create();
  set_level(15);
  set_name("Smith Chen", "装甲工匠 陈石");
  add("id", ({ "smith", "chen", }));
  set_short("装甲工匠 陈石");
  set_long(@C_LONG
你眼前是一个专注於工作的长发工匠，他是当今东方大陆首屈一指的装甲权威，据
说他一天可以打造出千人份的装备。他现在正在试穿新研发的合金装甲－六方甲，
脸上显得异常兴奋。
C_LONG
  );
  set("alignment", 1000);
  set("gender", "male");
  set("race", "human");
  set("unit", "个");
  set_perm_stat("dex", 20);
  set_perm_stat("str", 20);
  set_perm_stat("con", 25);
  set_perm_stat("kar", 20);
  set_perm_stat("pie", 25);
  set("max_hp", 600);
  set("hit_points", 600);
  set("wealth", ([ "gold": 80 ]));
  set_natural_weapon(70, 30, 50);
  set_natural_armor(66, 80);
  set("unbleeding", 1);
  set("aim_difficulty", ([ "critical": 70, "weakest": 70, "ganglion": 70, "vascular": 70 ]));
  set("special_defense", ([ "all": 30, "fire": 30, "none": 30 ]));
  set("weight", 400);
  set_skill("dodge", 100);
  set_skill("concentrate", 100);
  set("c_death_msg", "%s 脚下一个不稳，身躯随著沉重的装甲倒下，再也站不起来。\n");
  equip_armor(OBJS "plate");
}
