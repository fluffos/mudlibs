#include "mumar.h"

inherit MONSTER;
 
void create()
{      ::create();
       set_name("yogor cityguard","守卫");
       add("id",({"cityguard","guard"}) );
       set_short("守卫");
       set_long(
"看守这条小路的守卫，他已经累得眼睛都快睁不开了\n");
       set("unit","位");
       set("alignment",1000);
       set_level(13);
       set("hit_points",450);
       set("max_hp",450);
       set("wealth/gold",15);
       set("gender","male");
       set("race","human");
       set_perm_stat("str",17);
       set_perm_stat("dex",15);
       set_perm_stat("int",12);
       set_perm_stat("karma",10);
       set_natural_weapon(5,5,11);
       set_natural_armor(35,5);
       set_skill("parry",50);
       set_skill("thrusting",60);
       set_skill("tactic",35);
       set("tactic_func","berserk");
       set("aim_difficulty",(["vascular":20,"ganglion":35]) );
       set("special_defense",(["all":25,"none":5]) );
       set("weight",700);
       equip_armor(OBJS"mail01");
    wield_weapon(OBJS"lance");
}
