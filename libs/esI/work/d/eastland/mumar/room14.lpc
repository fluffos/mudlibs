#include <mumar.h>

inherit ROOM;

void create() {
  ::create();
  set_short("破落的小街");
  set_long(
    "走道这里，你看见这里一切都是那么的旧，那么的破，那么的败落。可是你仔细的查看
这里的一切以后竟然发现了一条通向远方城墙的小路。\n");
  set_outside("mumar");
  set("light", 1);
  set("exits", ([ "east": MUMAR "gate" ]));
  set("objects", ([ "guard1": MOB "guard1",
    "guard2": MOB "guard2" ]));
  reset();
}
