// m_war.c
// This object is inherited by all y_war fellows
#include <mudlib.h>

inherit MONSTER;

void kill_reward(object killer)
{
	int war_score;

		war_score = (int)query("mumarscore");
		killer->add("mumarscore", war_score );
		tell_object( killer, 
			"你得到 " + war_score + " 点功勋奖励。\n");
	::kill_reward(killer);
}

void heal_attacker(int heal)
{
	receive_healing( heal );
}

int stop_attack()
{
	object *people;

	people = all_inventory(environment());
	people -= ({ this_object() });
	if( sizeof(people) ) people->help_me_attacker( this_object(), this_player() );
	return 0;
}
