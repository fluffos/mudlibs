#include <mudlib.h>
//#include <magic.h>
//#include "mumar.h"
inherit "/d/eastland/mumar/war/mwar";

void create()
{
        ::create();
        set_level(18);
        set_name( "Tuss Wizard", "突斯魔法师" );
        add( "id", ({ "magician", "tuss mage", "mage" }) );
        set_short( "突斯魔法师" );
        set_long( @LONG
你看到一个猥琐矮小的家伙，他的体型实在不像是一般的蛮族，但是已经不知有多
少以他的外表来判定他的作战能力的人死在他的手中了。
LONG        );
        set( "unit", "名" );
	set( "race", "human" );
	set( "gender", "male" );
	set( "alignment", -1500 );
   set( "hit_points", 550 );
   set( "max_hp", 550 );
	set( "special_defense", ([ "all": 70,"none":20 ]) );
   set( "aim_difficulty", ([ "weakest" : 40, "vascular" : 40 ]) );
   set( "natural_armor_class", 50 );
	set( "natural_defense_bonus", 30 );
	set( "natural_weapon_class1", 10 );
	set( "natural_min_damage1", 10 );
	set( "natural_max_damage1", 10 );
   set( "natural_min_damage2", 10 );
   set( "natural_max_damage2", 15 );
	set( "wealth/gold", 400 );
	set( "wimpy", 150 );
	set( "killer", 1 );
	set( "tactic_func", "my_tactic" );
   set( "mumarscore", 400 );
	set_perm_stat( "str", 26 );
	set_perm_stat( "dex", 26 );
	set_perm_stat( "int", 26 );
	set_skill( "shortblade", 100 );
	set_skill( "wand", 100 );
   set_skill( "two-weapon", 100 );
	set_skill( "dodge", 100 );
        set( "chat_chance", 20 );
        set( "att_chat_output", ({
        }) );
	wield_weapon( "/d/eastland/mumar/war/obj/wand" );
	equip_armor( "/d/eastland/mumar/war/obj/plate" );
	equip_armor( "/d/eastland/mumar/war/obj/cape" );	
	equip_armor( "/d/eastland/mumar/war/obj/helmet" );
	equip_armor( "/d/eastland/mumar/war/obj/ring" );
	equip_armor( "/d/eastland/mumar/war/obj/gauntlets" );
}
int my_tactic()
{
	object *victim;
	int i;

	if( !(victim= query_attackers()) ) return 0;
	if( random(20)<4 ) {
	  for( i=0; i<sizeof(victim); i++ ) {
		message( "tell_object",
			"突斯魔法师口中念道: Del-Ka'ta Mu-ju'ra .....\n"
			"突然，一道刺骨的寒风夹著无数冰锥吹了过来，你闻到一股血腥的气味！\n",
			victim[i],
			this_object() );
	  }
		victim->receive_special_damage("magic", 70);
		return 1;
	} else return 0;
}
