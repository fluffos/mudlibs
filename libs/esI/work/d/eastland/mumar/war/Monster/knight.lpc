#include <mudlib.h>

inherit "/d/eastland/mumar/war/mwar";

void create()
{
	object ob1;

	::create();
	set_level(8);
	set_name( "Moorth Soldier", "蛮族士兵" );
	add( "id", ({ "soldier" }) );
	set_short( "蛮族士兵" );
	set_long(
		"你看到一个蛮族的士兵，他的任务是去侦察敌人的兵力部署并且企图建立战功\。\n"
	);
	set( "unit", "名" );
	set( "race", "human" );
	set( "gender", "male" );
	set( "alignment", -300 );
	set( "wealth/silver", 50 );
	set( "aggressive", 1 );
	set( "pursuing", 1 );
//	set( "moving", 1 );
	set( "speed", 30 );
// set( "war_value", 5 );
//   set( "war_value", 10 );
	set( "mumarscore",10);
	set_perm_stat( "str", 12 );
	set_perm_stat( "dex", 10 );
	set_skill( "longblade", 80 );
	set_skill( "parry", 30 );
//	set( "chat_chance", 20 );
	
	wield_weapon( "/d/eastland/mumar/war/obj/longsword" );
	equip_armor( "/d/eastland/mumar/war/obj/plate" );
	equip_armor( "/d/eastland/mumar/war/obj/shield" );	
	equip_armor( "/d/eastland/mumar/war/obj/helmet" );
//	equip_armor( "/d/eastland/mumar/war/obj/ring" );
}
