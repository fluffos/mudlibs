// war.c
// This daemon controls the wars in the mud. 
// By Annihilator@Eastern.Stories (1-6-94)
// pdyx修改完成于2002.9.2

#define MUMAR "/d/eastland/mumar/"
#define MOORTH_NPC "/d/eastland/mumar/war/monster/"

mapping attackers = ([
	MUMAR"room14": ({
		MOORTH_NPC"healer",
		MOORTH_NPC"mage",
		MOORTH_NPC"soldier",
		MOORTH_NPC"warlord"}),
	MUMAR"road1": ({
		MOORTH_NPC"knight",
		MOORTH_NPC"mage",
		MOORTH_NPC"soldier",
		MOORTH_NPC"healer"}),
	MUMAR"square01": ({
		MOORTH_NPC"knight",
		MOORTH_NPC"mage",
		MOORTH_NPC"soldier",
		MOORTH_NPC"healer"}),
	MUMAR"north_gate": ({
		MOORTH_NPC"healer",
		MOORTH_NPC"healer",
		MOORTH_NPC"soldier",
		MOORTH_NPC"soldier",
		MOORTH_NPC"soldier"}),
	MUMAR"square06": ({
		MOORTH_NPC"warlord",
		MOORTH_NPC"knight",
		MOORTH_NPC"knight",
		MOORTH_NPC"soldier",
		MOORTH_NPC"soldier",
	        MOORTH_NPC"warlock",
		MOORTH_NPC"healer" })
]);

int on_war;
object *army;

void create()
{
	seteuid(getuid());
}

void announce( string msg )
{
	object *usr;
	int i;

	usr = users();
	for( i=0; i<sizeof(usr); i++ ) {
		if( !environment(usr[i]) ) continue;
	usr[i]->quick_message(set_color(msg,"HIR",usr[i]));
	}
}

void start_war()
{
	if( sizeof(army)!=0 ) return;
	announce(
     "\n你看到，一片极其低矮而□黑的乌云由北而来，吞噬了整个东方大陆的天空....。\n"
     "\n一道雷光骤然而降，不偏不倚著打在牧马关北门的战旗上。\n"
     "\n应声折断的红色战旗似乎是什麽不祥的徵兆......\n"
        );
     call_out( "start_war1", 15 );
}
void start_war1()
{
	string *loc;
	int i, j;
	object ob, room;

	loc = keys(attackers);
	army = ({});
	call_out( "check_war", 300 );
	announce(
      "\n随著雷声的消失，豆粒般的红色雨滴夹著空气中不安的分子落在牧马关里。\n"
      "\n北方的沙漠传来一阵极其猥索的尖叫和笑声。\n"
      "\n李度大喊：「不怕死的蛮族又入侵了，死守牧马关！！」\n"
      );
	// Clone the attackers and put them to the pre-defined rooms.
	for(i=0; i<sizeof(loc); i++ ) {
		if( !(j= sizeof(attackers[loc[i]])) ) continue;
		// Find the room to put.
		room = find_object(loc[i]);
		if( !room ) call_other( loc[i], "???" );
		room = find_object(loc[i]);
		if( !room ) continue;

        tell_room( room,
            "突然，红色的雨滴似乎化成几个人影出现在你眼前！\n" );
		while( j-- ) {
			ob = new( attackers[loc[i]][j] );
			ob->move( room );
			army += ({ob});
		}
	}
	for( i=0; i<sizeof(army); i++ )
		army[i]->enable_war();
}


void check_war()
{
	// Remove those victims in the war.
	army -= ({ 0 });
	remove_call_out( "check_war" );
	if( !sizeof(army) ) {
           announce(
          "\n你听到，远方的天空中一声凄厉的长啸：你们将为此付出更大的代价～\n"
          "\n随著声音的回汤，东方大陆上空的乌云渐渐往北散去。\n"
          "\n柔和的阳光从云缝中淡出，金色的光线照著尸横遍野的大地和山岭。\n"
	  "\n李度的声音响澈整个牧马关上空：“感谢诸位勇士为牧马进一分心力”～\n"
          "\n*** 惨烈的牧马战役结束了 ***\n\n" );
                on_war = 0;
        return;
	}
	call_out( "check_war", 300 );
}
