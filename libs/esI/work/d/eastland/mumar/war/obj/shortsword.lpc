#include <mudlib.h>

inherit WEAPON;

void create() {
  set_name("shortsword", "古怪的骨剑");
  add("id", ({ "short sword", "sword" }));
  set_short("an alloyed shortsword", "古怪的骨剑");
  set_long(
    "You see a short sword made of some unknown alloyed metal.\n",
    "这是一把用某种动物的骨头铸成的短剑。\n"
  );
  set("unit", "把");
  set("type", "shortblade");
  set("weight", 50);
  set("weapon_class", 15);
  set("min_damage", 6);
  set("max_damage", 13);
  set("value", ({ 290, "silver" }));
}
