#include <mudlib.h>

inherit ARMOR;

void create() {
  set_name("alloyed platemail", "兽皮大衣");
  add("id", ({ "plate", "platemail", "mail" }));
  set_short("a suit of alloyed playemail", "兽皮大衣");
  set_long(
    "这是一套用某种不知名东东的毛坯缝合出来的大衣，看起来相当暖和。\n"
  );
  set("unit", "副");
  set("type", "body");
  set("material", "heavy_metal");
  set("armor_class", 25);
  set("weight", 300);
  set("value", ({ 1030, "silver" }));
}
