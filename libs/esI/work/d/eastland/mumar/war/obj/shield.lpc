#include <mudlib.h>

inherit ARMOR;

void create()
{
	set_name( "alloyed shield", "巨木盾" );
	add( "id", ({ "shield" }) );
	set_short( "an alloyed shield", "巨木盾" );
	set_long(
		"You see an alloyed shield. It looks pretty heavy and\n"
		"can supply good protection.\n",
		"这是一面用吐斯国的前年巨树作成的木盾，看起来相当有保护感。\n"
	);
	set( "unit", "面" );
	set( "type", "shield" );
	set( "material", "heavy" );
	set( "armor_class", 6 );
	set( "weight", 140 );
	set( "value", ({ 630, "silver" }) );
}