#include <mudlib.h>

inherit ARMOR;

void create()
{
	set_name( "black cape", "兽皮披风" );
	add( "id", ({ "cape" }) );
	set_short( "a black cape", "兽皮披风" );
	set_long(
		"You see a black cape with the symbol of Moorth Army on it.\n"
		"这是一件兽皮披风，不知道用什么东西的毛作成的，摸起来很舒服的样子。\n"
	);
	set( "unit", "件" );
	set( "type", "cloak" );
	set( "material", "cloth" );
	set( "armor_class", 5 );
	set( "defense_bonus", 6);
	set( "weight", 70 );
	set( "special_defense", ([ "evil":5,"divine":-7 ]) );
	set( "value", ({ 1000, "silver" }) );
	set( "no_sale", 1 );
}