#include <mudlib.h>

inherit ARMOR;

void create() {
  set_name("crystal ring", "水晶指环");
  add("id", ({ "ring" }));
  set_short("a crystal ring", "淡蓝色水晶戒指");
  set_long(
    "You see a crystal ring. It is glowing in a soft aura.\n",
    "这个水晶戒指是有一整个淡蓝色水晶镂空作成的，水晶周围似乎围绕著一\n"
    "圈淡蓝色的微光，可爱极了。\n"
  );
  set("type", "finger");
  set("material", "element");
  set("defense_bonus", 5);
  set("special_defense", ([ "energy": 15, "electric": -18 ]));
  set("weight", 3);
  set("value", ({ 1840, "silver" }));
}
