#include <mudlib.h>

inherit ARMOR;

void create() {
  set_name("alloyed gauntlets", "象牙手镯");
  add("id", ({ "gauntlets" }));
  set_short("a pair of alloyed gauntlets", "象牙手镯");
  set_long(
    "You see a pair of alloyed gauntlets. It looks pretty heavy and\n"
    "can supply good protection.\n",
    "这是一双用象牙作成的护手，非常精美。\n"
  );
  set("unit", "双");
  set("type", "hands");
  set("material", "heavy_metal");
  set("armor_class", 5);
  set("weight", 80);
  set("value", ({ 760, "silver" }));
}
