#include <../under.h>
inherit MONSTER;

void create() {
  ::create();
  set_level(15);
  set_name("Smith Wang", "刀斧工匠 王五");
  add("id", ({ "smith", "wang", }));
  set_short("刀斧工匠 王五");
  set_long(@C_LONG
你眼前是一个专注於工作的光头工匠，他是当今东方大陆首屈一指的刀斧权威，据
说他一天可以打造出三百多只刀剑。他现在正在试用新研发的武器--九龙连环刀，
眼中散发出如剑神般的光采。从他的身法看来，他可能是少林的俗家弟子。
C_LONG
  );
  set("alignment", 1000);
  set("gender", "male");
  set("race", "human");
  set("unit", "个");
  set_perm_stat("dex", 20);
  set_perm_stat("str", 20);
  set_perm_stat("con", 25);
  set_perm_stat("kar", 20);
  set_perm_stat("pie", 25);
  set("max_hp", 600);
  set("hit_points", 600);
  set("max_fp", 2000);
  set("force_points", 2000);
  set("wealth", ([ "gold": 80 ]));
  set_natural_weapon(60, 10, 30);
  set_natural_armor(70, 60);
  set("unbleeding", 1);
  set("aim_difficulty", ([ "critical": 65, "weakest": 35, "ganglion": 35, "vascular": 35 ]));
  set("special_defense", ([ "all": 20, "fire": 20, "none": 20 ]));
  set("weight", 400);
  set("attack_skill", "monk/general/wu_sur");
  set("gonfus/wu_sur", 100);
  set_skill("parry", 80);
  set_skill("blade", 80);
  set_skill("dodge", 80);
  set_skill("concentrate", 80);
  wield_weapon(OBJS "blade");
}
