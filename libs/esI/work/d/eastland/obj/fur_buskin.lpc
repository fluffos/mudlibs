#include <mudlib.h>

inherit ARMOR;

void create() {
  set_name("fur buskin", "兽皮短靴");
  add("id", ({ "buskin", "buskins" }));
  set_short("兽皮短靴");
  set_long(
    "这是一双肮脏的兽皮短靴，上面用皮绳缠了好几圈。\n"
  );
  set("unit", "双");
  set("type", "feet");
  set("material", "leather");
  set("weight", 40);
  set("armor_class", 2);
  set("defense_bonus", 1);
  set("special_defense", ([ "fire": -3, "cold": 1 ]));
  set("value", ({ 260, "silver" }));
}
