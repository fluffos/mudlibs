#include "mudlib.h"
inherit OBJECT;

#define NEED_MEMBERS 1

int create() {
  seteuid(getuid());
  set_name("skeleton", "\巨大的髑髅\");
	set_short(" \ 巨 大 的 髑 髅 \ ");
        set_long(" 这 具 巨 大 的 髑 髅 \ ， 看 起 来 像 是 人 类 的 遗 骸 ， 但 是 却 异 常 的 巨 大 ， \ n "
                 " 更 怪 的 是 ， 在 头 上 竟 然 生 了 两 只 利 角 ， 你 看 了 不 禁 倒 吸 一 口 凉 气 。 \ n "
                 " 不 过 不 管 怎 麽 说 ， 一 个 死 人 是 不 会 威 胁 到 你 的 ....\ n "
                 " 它 看 起 来 蛮 重 的 ， 不 知 道 是 那 个 家 伙 把 它 放 (put) 在 这 ? \ n ");
	set(" unit "," 具 ");
        set(" weight ",3000);
	set(" value ",({ 0, " silver "}) );
	set(" prevent_get ",1);
	set(" prevent_get_c_msg "," 这 东 西 太 重 了 ， 最 好 是 两 个 人 以 上 才 抬 的 (shift) 起 来 \ n "+
				" 要 把 他 放 下 ， 只 要 (put) 它 在 地 上 就 可 以 了 \ n ");
	set(" prevent_drop ",1);
}

void init()
{
	add_action(" to_get "," shift ");
}

int check_member(object *usr)
{
        int i,members=0;
        for( i=0; i<sizeof(usr); i++ ) 
        if (environment(usr[i]) == environment(this_player())) {
			members ++ ;
		}
        if ( members >= NEED_MEMBERS ) 
		return 1;
	return 0;
}
int check_force(object *usr,int num)
{	
	int i,force;
	for( i=0; i<sizeof(usr); i++ ) 
	{ 
		force=usr[i]->query(" max_load ");
		force-=usr[i]->query(" load ");
		if( force< 3000/num )
	return 0;
	}
	return 1;
}

int to_get(string arg)
{	
	int i,num;
	object *usr,me,obj;
	if( !arg || arg != " skeleton " ) return notify_fail(" 拿 什 麽 ? \ n ");
	me=this_player();
        usr = (mixed *)me->query_temp(" party_members ");
	num = sizeof(usr);
	if ( !check_member(usr)) 
		return notify_fail(" 糟 糕 !!这 实 在 太 重 了 又 不 好 施 力 ， 找 个 人 帮 你 吧 !!\ n "); 
	else if ( (string)me->query_temp(" leader ") != (string)me->query(" name "))
		return notify_fail(" 只 有 队 伍 的 领 导 者 ， 才 能 下 命 令 喔 。 \ n "); 
	else if ( !check_force(usr,num)) 
		return notify_fail(" 你 们 好 像 搬 不 动 这 具 巨 大 的 髑 髅 \ ， 丢 掉 一 些 装 备 吧 \ n ");
        for( i=0; i<sizeof(usr); i++ ) 
	{	usr[i]->set_temp(" carry_skeleton ",1); 
		tell_object(usr[i]," 一 ， 二 ， 三 ....你 费 尽 吃 奶 的 力 气 把 它 拿 起 来 \ n ");
                obj = new(" / d / eastland / liang_shan / obj / invis_load ");
        	obj->set(" weight ",3000/num);
        	obj->move(usr[i]);
	}
	remove();
	return 1;
}
