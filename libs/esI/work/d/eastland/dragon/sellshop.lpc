#pragma save_binary

//translation done. 2-21-94 what about menu? hmm..  -Elon

#include <mudlib.h>
inherit SELLER;
inherit ROOM;

void create()
{
	::create();
    set_short("骑宠宝宝专卖店");
	set_long( @LONG_DESCRIPTION
这里是幽国城城主秘密的骑宠宝宝培养基地。主要是为幽国城中的骑士团培养拥有非常战力的龙骑士。
这里有一个价格表(sign),你可以看看上面表明的价格，然后看看你自己拥有的战斗点数，考虑购买
那一级数的骑宠宝宝。具体的战斗点数请向这里的负责人(icer)咨询。嘿嘿-----祝你好运！！
LONG_DESCRIPTION
	);
	set("c_item_desc", ([
	"sign" : @C_SIGN
这张价格表上写著现在这里可以购买的骑宠宝宝:
——————————————————————————————————
等级          色 	种类/代号                     价 格
LV2           蓝色 	魔兽(teeth) 		   10000 战功
LV4           黄色 	猛虎(ytiger)               30000 战功
LV6           黑色      黑豹(cougar)               50000 战功
LV8           红色 	猛虎(rtiger)               70000 战功
LV10          绿色      绿龙(glong)               100000 战功   
LV14          紫色 	麒麟(chilin)              150000 战功
LV16          粉色 	凤凰(phoenix)             310000 战功       
LV18          蓝色 	暴龙(blong)               500000 战功    
——————————————————————————————————
C_SIGN
	]) );

	set( "light", 1 );
	set( "exits", ([ 
		"up" : "/d/eastland/dragon/cave26" ]) );
		set( "item_func", ([
		"menu" : "show_menu"
	]) );
	set_inventory( ({
//		({ "/d/zeq/knight/long2", 60, 60 }),
//		({ "/d/zeq/knight/cougar", 60, 60 }),
//		({ "/d/zeq/knight/tiger", 60, 60 }),
//		({ "/d/noden/farwind/items/branz_herb", 50, 50 }),
//		({ "/d/noden/farwind/items/plaster", 40, 40 }),
//		({ "/d/noden/farwind/items/white_plaster", 30, 30 }),
//		({ "/d/noden/farwind/items/mikira_potion", 30, 30 }),
//		({ "/d/noden/farwind/items/kira_potion", 30, 30 }),
//		({ "/d/noden/farwind/items/makira_potion", 20, 20 }),
	}) );
	reset();
}
void reset()
{
	room::reset();
	seller::reset();
}
