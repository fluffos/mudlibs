#include <yogor.h>

inherit ROOM;
int be_eated;
void create()
{
        ::create();
        set_short("东殿");
        set_long(
"金色的琉璃瓦覆盖在殿顶，巨大的雕龙石柱耸立於四方，楹柱上藻饰著许多
花纹，地板上铺著青色的石板，大殿中央有一高台，台上有一张银龙宝座，是皇
子接待贵宾或招见一些大臣时所坐的地方，左右各有一个偏门通往内殿，门边写
著：非经通报，请勿入内．\n"); 
        set( "light", 1 );
        set( "exits", (["northwest":YROOM"room25",
                        "east":YROOM"room27"]) );
        set( "pre_exit_func",([ "east":"to_east" ]) );
        set( "objects", (["prince":YMOB"prince"]) );
        reset();
}
int to_east()
{
   if ((int)this_player()->query("effort")>1800){
      this_player()->move_player(YROOM"room_4","SNEAK");
      this_player()->set("effort",(int)this_player()->query("effort")-50);
      return 1;
      }
   write("\n你对幽国城的贡献不够，不准进入．\n\n");
   return 0; 
}
