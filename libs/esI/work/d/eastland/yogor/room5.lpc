#include <yogor.h>

inherit ROOM;
int showed;
void create() {
  ::create();
  set_short("北街");
  set_long(
    "走在幽国城的北街上，你嗅到一丝战争後的风尘味，路上行人显得有些形色
匆匆，更有些戒慎恐惧的神情，征战的威胁似乎还影响著这里的人们，一阵风扬
起，吹起墙边一张草席的一角，西边有一家店，上有一匾〔仁心仁术〕，东边则
是一家商家，往南看到一大广场．\n"
  );

  set_outside("yogor");
  set("light", 1);
  set("exits", ([ "north": YROOM "room2",
    "west": YROOM "room4",
    "east": YROOM "room6",
    "south": YROOM "room11" ]));
  set("objects", ([ "dog": "/d/noden/farwind/monster/dog" ]));
  set("item_desc", ([ "草席": "一张破旧的草席(pallet)，底下彷佛躺著一个人．\n", "pallet": "一张破旧的草席，底下彷佛躺著一个人．\n" ]));
  set("search_desc", ([ "pallet": "@@search_pallet" ]));

  reset();
}
string search_pallet() {
  object ob;
  if (present("wanderer", this_object()) || showed)
    return " 一张破旧的草席．\n\n";
  write("你翻著那一张草席.......\n");
  write("突然一张蓬头垢面的脸从草席下冒出来，还破口大骂：靠夭！！ 你李登辉啊！！\n");
  write("你定睛一看，原来是一个流浪汉．\n\n");
  ob = new(YMOB "wanderer");
  ob->move(this_object());
  showed = 1;
  return "\n";
}
void reset() {
  ::reset();
  showed = 0;
}
