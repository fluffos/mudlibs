#include <yogor.h>

inherit ROOM;

void create()
{
        ::create();
        set_short("马房");
         set_long(
"这里是幽皇殿的专用马房，供养著一些进献的马匹，以及一些军用报讯快马
，你可以看到几位马夫正在细心照料这些马，尤其是那些城主喜欢的马，要是出
了什麽差错，可是会杀头的．\n");
        set( "light", 1 );
        set( "exits", (["north":YROOM"room25"]) );
        set( "objects", (["horse1":YMOB"horse1",
                          "horse2":YMOB"horse2" ]) );
        reset();
}
