#include <yogor.h>

inherit ROOM;

void create()
{
        ::create();
        set_short("东街");
        set_long(
"走在幽国城的东街上，你嗅到一丝战争後的风尘味，路上行人显得有些形色
匆匆，更有些戒慎恐惧的神情，征战的威胁似乎还影响著这里的人们，北边有一
商家，南边则是一家银行，西边通往一大广场．\n"
        );
        set_outside( "yogor" );
        set( "light", 1 );
        set( "exits", (["north":YROOM"room6",
                        "west":YROOM"room11",
                        "east":YROOM"room13",
                        "south":YROOM"room17"  ]) );
//        set( "objects", ([
 //                                                        ]) );
        reset();
}
