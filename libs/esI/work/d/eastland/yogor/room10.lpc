#include <yogor.h>

inherit ROOM;

void create()
{
        ::create();
        set_short("西街");
        set_long( 
"走在幽国城的西街上，你嗅到一丝战争後的风尘味，路上行人显得有些形色
匆匆，更有些戒慎恐惧的神情，征战的威胁似乎还影响著这里的人们．北边有一
家店，上有一匾〔仁心仁术〕，南边亦有一匾〔铲奸除恶〕，东方则有一广场．\n"
        );

        set_outside( "yogor" );
        set( "light", 1 );
        set( "exits", (["west":YROOM"room9",
                        "north":YROOM"room4",
                        "east":YROOM"room11",
                        "south":YROOM"room15" ]) );
//        set( "objects", ([
 //                                                        ]) );
        reset();
}
