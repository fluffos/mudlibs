#include <yogor.h>

inherit ROOM;

void create()
{
        ::create();
        set_short("後殿");
        set_long(
"金色的琉璃瓦覆盖在殿顶，巨大的雕龙石柱耸立於四方，楹柱上藻饰著许多
花纹，地板上铺著灰色的石板，比起其他三殿，後殿的规模要小得多，左方有一
道门可通往一个上阁楼的回旋梯．\n"); 
        set( "light", 1 );
        set( "exits", (["south":YROOM"room36",
                        "up":YROOM"room39"]) );
//        set( "objects", ([
 //                                                        ]) );
        reset();
}
