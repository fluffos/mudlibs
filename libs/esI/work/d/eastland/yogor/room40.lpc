#include <yogor.h>

inherit ROOM;

void create() {
  ::create();
  set_short("练武场");
  set_long(
    "你看到一些青年武者穿著武衣，有些手持兵刃，正在或单独演练，或互相比
划地在一个大广场内练武，场中还有一些练武用的道具，假人什麽的，令你不禁
手痒了起来，西边有一排厢房，看来是练武者休息的地方．\n");
  set_outside("yogor");
  set("light", 1);
  set("exits", ([ "west": YROOM "room41",
    "southeast": YROOM "room32" ]));
  set("objects", ([
    "paladin": YMOB "paladin",
    "teacher2": YMOB "teacher2" ]));
  reset();
}
