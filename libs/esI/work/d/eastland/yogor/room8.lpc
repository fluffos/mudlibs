#include <yogor.h>

inherit ROOM;

void create()
{
        ::create();
        set_short("幽国城");
        set_long( 
"你现在来到位於群山环抱的幽国城西门，幽国城自古以来一直是少商谷最大
的首府，少商谷物产丰富，四季如春，不过这几年西边太仓山兴起一股悍匪，官
兵几次围剿都没能平定，因此幽国城战时只开东门。\n"
        );

        set_outside( "yogor" );
        set( "light", 1 );
        set( "exits", (["east":YROOM"room9",
                        "west":"/d/eastland/3,15.east" ]) );
        set( "objects", (["guard1":YMOB"guard",
                          "guard2":YMOB"guard" ]) );
        reset();
}
