#include <yogor.h>

inherit ROOM;

void create() {
  ::create();
  set_short("库房");
  set_long(
    "一张桌子，数个堆满文件的柜子，是你走进这房间所看到的，这里是库房资
料室，右後方一个小门通往真正的库房，你进来的声音令一个原本在桌子後面整
理东西的人站了起来，他的眼光似乎在询问你有什麽事．\n");
  set("light", 1);
  set("exits", ([ "southwest": YROOM "room35" ]));
  set("objects", ([ "keeper": YMOB "cheng" ]));
  reset();
}
