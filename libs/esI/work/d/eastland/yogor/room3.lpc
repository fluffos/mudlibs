#include <yogor.h>

inherit ROOM;

void create() {
  ::create();
  set_short("幽皇殿殿门");
  set_long(
    "你站在幽皇殿的入口前，两侧的石麒麟雕像首先引起你的注意，壮阔的铜门闪著
金光，丝毫不见岁月的痕迹．你抬头仰望，门上有一雕玉牌额，上书:〔幽皇殿〕．\n"
  );

  set_outside("yogor");
  set("light", 1);
  set("exits", ([ "south": YROOM "room9"
    , "north": YROOM "room21" ]));
  //     set( "objects", ([
  //                                                      ]) );
  reset();
}
