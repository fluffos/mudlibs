#include <yogor.h>

inherit ROOM;

void create()
{
        ::create();
        set_short("正殿");
        set_long(
"金色的琉璃瓦覆盖在殿顶，巨大的雕龙石柱耸立於四方，楹柱上藻饰著许多
花纹，地板上铺著金棕色的石板，大殿中央有一高台，台上有一张金龙宝座，是
城主接待贵宾或招见一些大臣时所坐的地方，右边有一个偏门通往库房，左边则
有一道门通往後殿．\n"); 
        set( "light", 1 );
        set( "exits", (["south":YROOM"room34",
                        "northwest":YROOM"room36",
                        "northeast":YROOM"room42"]) );
        set( "objects", (["king":YMOB"king"]) );
        reset();
}
