#include <yogor.h>

inherit ROOM;

void create()
{
        ::create();
        set_short("东街");
        set_long(
"走在幽国城的东街上，你嗅到一丝战争後的风尘味，路上行人显得有些形色
匆匆，更有些戒慎恐惧的神情，征战的威胁似乎还影响著这里的人们，望向北边，
你看到一栋清素淡雅的建筑，门前插了一根旗子，上有绣字，仔细一瞧，是个酒
字．南边飘来阵阵香味儿，使你不觉感到饥肠辘辘．\n");
        set_outside( "yogor" );
        set( "light", 1 );
        set( "exits", (["north":YROOM"room7",
                        "south":YROOM"room18",
                        "west":YROOM"room12",
                        "east":YROOM"room14"  ]) );
//        set( "objects", ([
 //                                                        ]) );
        reset();
}
