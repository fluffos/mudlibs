#include <yogor.h>

inherit ROOM;

void create() {
  ::create();
  set_short("北回廊");
  set_long(
    "你走入一个曲折的回廊中，地上铺著暗红色的石板，略生青苔的石墙上，左右各
有一扇五角型洞窗，往窗外望去，可看见整理得井然有序的庭院，木制的廊檐雕刻著
精细的雕花，檐边垂著几枝绿□，显得生意盎然，北边有一座金碧辉煌的大殿．\n");
  set("light", 1);
  set("exits", ([ "north": YROOM "room35",
    "west": YROOM "room33" ]));
  set("objects", ([ "guard1": YMOB "royalguard",
    "guard2": YMOB "royalguard" ]));
  reset();
}
