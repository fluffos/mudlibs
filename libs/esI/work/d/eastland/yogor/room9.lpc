#include <yogor.h>

inherit ROOM;

void create() {
  ::create();
  set_short("西街");
  set_long(
    "刚走进幽国城，你感到此处久经征战的一种肃杀，建筑物略显残破，但其古
朴的雕楼画栋，精致的铺地，皆可显示此城过去的荣光与富裕．北边是幽国城的
行政中心－幽皇殿．\n"
  );
  set_outside("yogor");
  set("light", 1);
  set("exits", ([ "west": YROOM "room8",
    "east": YROOM "room10",
    "north": YROOM "room3" ]));
  //        set( "objects", ([
  //                                                        ]) );
  reset();
}
