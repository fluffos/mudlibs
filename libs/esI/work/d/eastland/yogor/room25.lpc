#include <yogor.h>

inherit ROOM;

void create()
{
        ::create();
        set_short("东回廊");
        set_long(
"你走入一个曲折的回廊中，地上铺著暗红色的石板，略生青苔的石墙上，左
右各有一扇五角型洞窗，往窗外望去，可看见整理得井然有序的庭院，木制的廊
檐雕刻著精细的雕花，檐边垂著几枝绿柳，显得生意盎然，东南方有一座大殿，
南边隐约传来马嘶声，好像是一间马房．\n");
        set( "light", 1 );
        set( "exits", (["southwest":YROOM"room24",
                        "southeast":YROOM"room27",
                        "south":YROOM"room26" ]) );
//        set( "objects", ([
 //                                                        ]) );
        reset();
}
