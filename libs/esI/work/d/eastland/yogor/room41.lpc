#include <yogor.h>

inherit ROOM;

void create() {
  ::create();
  set_short("休息厢房");
  set_long(
    "走进这里，你看到几个教头正在喝茶谈天，几个武者正或坐或站的在那儿休
息，也谈论著一些武功\招式，及刚才练武的情形，一两个小□正忙著给这些人
倒茶，拿凉水毛巾什麽的．\n");
  set("light", 1);
  set("exits", ([ "east": YROOM "room40" ]));
  set("objects", ([ "teacher1": YMOB "teacher1" ]));
  reset();
}
