#include <yogor.h>

inherit ROOM;
int showed;
void create() {
  ::create();
  set_short("醉月阁");
  set_long(
    "此处堆满了城主的收藏品，字画，瓷器，闪亮的盔甲，宝剑，还有一些珍稀
宝物，角落还堆著一堆魔法卷轴，你听到悉悉嗦嗦的声音从那堆卷轴(scrolls)
中传出，似乎还看到它动了动，你在怀疑是否是你的错觉，房间外面有一个天台
，夜晚可以在此欣赏夜景，旁边你看到一些饮食器皿，大概是城主在这一边喝酒
一边赏月，才将此命名为醉月阁吧．\n");
  set("exits", ([ "down": YROOM "room38" ]));
  set_outside("yogor");
  set("item_desc", ([ "scrolls": "一堆杂乱无章的魔法卷轴．\n" ]));
  set("search_desc", ([ "scrolls": "@@search_scrolls" ]));
  reset();
}
string search_scrolls() {
  object ob;
  if (present("mage", this_object()) || showed)
    return "一堆杂乱无章的魔法卷轴．\n";
  write("你翻著那一堆卷轴.......\n");
  write("突然一个圆滚滚的东西从卷轴中跑出来.....你吓了一大跳!\n");
  write("你定睛一看，原来是一个眼魔．\n\n");
  ob = new(YMOB "mage");
  ob->move(this_object());
  showed = 1;
  return "\n";
}
void reset() {
  ::reset();
  showed = 0;
}
