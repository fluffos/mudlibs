#include "yogor.h"

inherit MONSTER;

void create() {
  ::create();
  set_name("yogor prince", "王子");
  add("id", ({ "prince" }));
  set_short("幽国城王子");
  set_long(
    "一位英姿焕发，神情柔和的年轻人，一副邻家大男孩的模样，令人无法想像
他是幽国城的王子，他正在那儿跺著方步，似乎在思考著什麽事情．\n");
  set("unit", "位");
  set("alignment", 350);
  set_level(17);
  set("hit_points", 800);
  set("max_hp", 800);
  set("wealth/gold", 30);
  set("gender", "male");
  set("race", "human");
  set_perm_stat("str", 25);
  set_perm_stat("dex", 26);
  set_perm_stat("int", 23);
  set_perm_stat("karma", 22);
  set_perm_stat("con", 25);
  set_natural_weapon(20, 5, 7);
  set_natural_armor(50, 33);
  set_skill("chain", 80);
  set_skill("parry", 85);
  set_skill("dodge", 80);
  set_skill("tactic", 60);
  set("tactic", "melee");
  set("aim_difficulty", ([ "vascular": 10, "ganglion": 10, "weakest": 20 ]));
  set(
    "special_defense",
    ([
      "monk": 30,
      "scholar": 30,
      "evil": 38,
      "fire": 33,
      "cold": 40,
      "electric": 35,
      "energy": 40,
      "none": 40
    ])
  );
  set("weight", 70);
  equip_armor(YARM "cloth3");
  equip_armor(YARM "helmet8");
  wield_weapon(YWEA "star");
  set("inquiry", ([
    "permission": "@@ask_per",
    "help": "@@ask_help",
    "gift": "@@ask_gift" ]));
}
void ask_per(object who) {
  if ((int)this_player()->query_temp("finding") != 2) return;
  tell_object(who,
    "喔...是美尔琳思要的书...当然可以让你去找..不过你得先帮我一个忙．\n");
  return;
}
void ask_help(object who) {
  if ((int)this_player()->query_temp("finding") != 2) return;
  tell_object(who,
    "是这样的，练武场那ㄦ有一位女游侠，我很喜欢她，可是她一直都在逃避我，
希望你能帮助我送些礼物(gift)讨她欢心．\n");
  return;
}
void ask_gift(object who) {
  if ((int)this_player()->query_temp("finding") != 2) return;
  tell_object(who, " 我想..先送个金莎好了....拜托你了..:P \n");
  this_player()->set_temp("finding", 3);
  return;
}
void init() {
  ::init();
  add_action("report_prince", "report");
}
int report_prince(string arg) {
  string who, type;

  if (!arg || (sscanf(arg, "%s to %s", type, who) != 2))
    return notify_fail(
      "回报什麽事给(to)谁？\n");
  if (!id(who))
    return notify_fail(
      "你要向谁报告啊! 这里没这个人\n");

  if ((int)this_player()->query_temp("finding") < 4) return 1;
  if (type == "result") {
    if ((int)this_player()->query_temp("finding") == 4) {
      tell_object(this_player(),
        "是吗....她是这麽说吗....，看来我的攻势还不够，你能否在帮我一次，这次
我想送她蓝珍珠，有劳你了。\n");
      this_player()->set_temp("finding", 5);
      return 1;
    }
    if ((int)this_player()->query_temp("finding") == 6) {
      tell_object(this_player(),
        "是吗....看来我就快成功了...，请你帮我最後一次，这次我想送她漂亮的衣服
和漂亮的宝石项链，拜托你了。\n");
      this_player()->set_temp("finding", 7);
      return 1;
    }
    if ((int)this_player()->query_temp("finding") == 8) {
      tell_object(this_player(),
        "王子说道： 感谢你的帮忙，这是我的谢礼。说完王子给你一袋金币，接著说：另外
我的书房欢迎你使用。你看著不知情的王子，也不好多说些什麽，只能期盼他们俩能
有好的结果。\n");
      this_player()->credit("gold", 300);
      this_player()->set_temp("finding", 9);
      return 1;
    }
  }
  return 1;
}
