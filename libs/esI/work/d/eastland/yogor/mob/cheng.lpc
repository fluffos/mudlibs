#include "yogor.h"

inherit MONSTER;

void create() {
  ::create();
  set_name("Mr. cheng", "钱先生");
  add("id", ({ "cheng" }));
  set_short("钱先生");
  set_long(
    "两撇翘胡子，一双小眼睛，令你不禁连想到老鼠这种动物，但别小觑他，他可是
幽国城的第一总管，一些物品，财政的管理都是他一手包办，也负责奖赏的发放，
你可以问他你的功勋(effort)有多少了．\n");
  set("unit", "位");
  set("gender", "male");
  set_level(1);
  set("race", "human");
  set("chat_output", ({ "药房(drug store)...要添购..." }));
  set("chat_chance", 4);
  set("no_attack", 1);
  set("inquiry", ([
    "effort": "@@ask_effort",
    "store": "@@ask_store" ]));
}
void ask_effort(object who) {
  tell_object(who, "阁下的功勋有" + (int)who->query("effort") + "点．\n");
  return;
}
void ask_store(object who) {
  tell_object(who, "药店喔...在东殿内殿..不过只有对幽国城有贡献的人能使用．\n");
  return;
}
