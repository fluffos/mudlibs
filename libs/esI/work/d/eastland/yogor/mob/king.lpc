#include "yogor.h"

inherit MONSTER;
 
void create()
{      ::create();
       set_name("yogor king","城主");
       add("id",({"king"}) );
       set_short("幽国城城主");
       set_long(
"一位面容和蔼，看来三十馀岁的男子，於政事方面有不错的成绩，和皇后
二人皆受幽国城人民的爱戴，虽然看来书卷气浓厚，但双眼露出精光，看来
颇有修为，於武艺及法术上皆有不凡的造诣．\n");
       set("unit","位");
       set("alignment",900);
       set_level(19);
       set("hit_points",1000);
       set("max_hp",1000);
       set("wealth/gold",110);
       set("gender","male");
       set("race","human");
       set_perm_stat("str",28);
       set_perm_stat("dex",27);
       set_perm_stat("int",26);
       set_perm_stat("karma",24);
       set_perm_stat("con",30);
       set( "natural_weapon_class1", 20 );
       set( "natural_min_damage1", 20 );
       set( "natural_max_damage1", 35 );
       set( "natural_weapon_class2", 20 );
       set( "natural_min_damage2", 20 );
       set( "natural_max_damage2", 35 );
       set_natural_armor(62,32);
       set_skill("parry",100);
       set_skill("two-weapon",100);
       set_skill("dodge",70);
       set_skill("tactic",90);
       set_skill("shortblade",100);
       set("tactic","assault");
       set("stun_difficulty",20);
       set("tactic_func","spell");
       set("aim_difficulty",(["vascular":40,"ganglion":35,"weakest":40,"critical":50]) );
       set("special_defense",(["monk":20,"scholar":20,"fire":50,"cold":40,"evil":40,"energy":30,"electric":34,"none":45]) );
       set("weight",75);
       equip_armor(YARM"robe1");
       equip_armor(YARM"crown");
       equip_armor(YARM"ring2");
       wield_weapon(YWEA"sword5");
       wield_weapon2(YWEA"sword5");
       set("att_chat_output", ({"\n幽国城城主笑道: 孺子，你的修为还早呢！\n","\n幽国城城主道: 孩子，别傻了，快滚吧！\n"}) );
       set("chat_chance", 5 );
}
int spell(object victim)
{
       int vic_int,vic_kar;
       victim=this_object()->query_attacker();
       vic_int=(int)victim->query_stat("int");
       vic_kar=(int)victim->query_stat("kar");
       if (random(vic_int+vic_kar)>5) return 0;
       else{ 
       switch(random(3)){
   case 0:
       tell_room(environment(this_object()),set_color(" 城主的手中开始聚集一团火□, 逐渐形成一只炙热的火鸟 － 凯撒之鹰。\n\n"+" 城主的手向前一指, 炎鸟「凯萨之鹰」冲向此地中心, 「轰隆」的一声\n","HIR"),this_object());
       tell_room(environment(this_object()),sprintf(set_color(" 在你眼前突然一闪, 你只感到炙热的地狱之炎似乎要将一切烧成灰烬!\n\n","HIR")),this_object());
       victim->receive_special_damage("fire",40);
       return 1;
       break;
    case 1:
       tell_room(environment(this_object()),sprintf(set_color(" 突然间城主周围的气温急速下降，隐约的可看见小雪花。\n"+" 渐渐地，雪花凝聚成小小的冰块。\n"+" 这些冰块进而结成更大的冰柱。\n"+" 突然间城主周围布满了无数的冰晶。\n","HIW")),this_object());
       tell_room(environment(this_object()),sprintf(set_color(" 城主的手往前一挥，大喊「冰雪风暴」！\n\n"+" 突然间，无数的冰晶开始无情的肆掠起来！你彷如置身於可怕的\n"+" 暴风雪之中，无数的雪花在你的面前飞舞，彷佛要将大地吞噬！\n\n","HIW")),this_object());
        victim->receive_special_damage("cold",40);
        return 1;
        break;
    case 2:
       tell_room(environment(this_object()),sprintf(set_color(" 突然间天空中乌云密布，隐约可听到几声沈闷的雷声，由远而近....。\n"+" 突然，只听见「轰隆」之声不绝於耳，无数的闪电自天而降，\n\n","HIB")),this_object());
       tell_room(environment(this_object()),sprintf(set_color(" 你只见眼前眩目的白光一闪，脑中短暂的空白之後，随即感到一阵剧痛！\n\n","HIB")),this_object());
        victim->receive_special_damage("electric",40);
        return 1;
        break;
    default:
        return 0;}
    }
}


       
