#include "yogor.h"

inherit MONSTER;

void create() {
  ::create();
  set_name("weapon teacher", "枪棒教头");
  add("id", ({ "teacher" }));
  set_short("枪棒教头");
  set_long(
    "他是负责教导幽国城守卫枪棒武艺的教头，十八般武艺俱全，只是还不够
顶尖:p，但也足以教出那些看守城门的卫兵了，你看到他正喋喋不休的教导
那些菜鸟．\n");
  set("unit", "位");
  set("alignment", 500);
  set_level(14);
  set("hit_points", 400);
  set("max_hp", 400);
  set("wealth/gold", 10);
  set("gender", "male");
  set("race", "human");
  set_perm_stat("str", 27);
  set_perm_stat("dex", 23);
  set_perm_stat("int", 20);
  set_perm_stat("karma", 18);
  set_natural_weapon(16, 10, 6);
  set_natural_armor(40, 30);
  set_skill("blunt", 80);
  set_skill("parry", 75);
  set_skill("dodge", 50);
  set_skill("tactic", 50);
  set("tactic", "melee");
  set("aim_difficulty", ([ "vascular": 30, "ganglion": 10 ]));
  set("special_defense", ([ "all": 25, "none": 10 ]));
  set("weight", 85);
  equip_armor(YARM "cloth4");
  wield_weapon(YWEA "club1");
}
