#include "yogor.h"
inherit YMOB "army.lpc";

void create() {
  ::create();
  set_name("police captain", "易云");
  add("id", ({ "police", "captain" }));
  set_short("幽国城四大捕头之 易云");
  set_long(
    "四位幽国城捕头之一，由於其姓氏，人称〔 谈 何 容 易 〕，想要在幽国城做奸犯科
谈何容易，想逃出这四位捕头的追缉谈何容易，用以赞誉这四人的执法功绩．\n");
  set("unit", "位");
  set("alignment", 900);
  set_level(15);
  set("hit_points", 550);
  set("max_hp", 550);
  set("wealth/gold", 100);
  set("gender", "male");
  set("race", "human");
  set_perm_stat("str", 22);
  set_perm_stat("dex", 25);
  set_perm_stat("int", 22);
  set_perm_stat("con", 22);
  set_natural_weapon(15, 7, 10);
  set_natural_armor(65, 24);
  set_skill("axe", 70);
  set_skill("parry", 50);
  set_skill("dodge", 60);
  set_skill("tactic", 50);
  set("tactic", "melee");
  set("aim_difficulty", ([ "vascular": 30, "ganglion": 10 ]));
  set("special_defense", ([ "all": 20, "none": 10 ]));
  set("weight", 75);
  set("pursuing", 1);
  equip_armor(YARM "boot9");
  wield_weapon(YWEA "axe");
}
