#include "yogor.h"
#include <stats.h>
#include <conditions.h>

inherit MONSTER;
 
void create()
{      ::create();
       set_name("wondering-samurai sasaki kochiro","佐佐木小次郎");
       add("id",({"samurai","sasaki","kochiro","sasaki kochiro"}) );
       set_short("流浪武士 佐佐木小次郎");
       set_long(
"你看到一位全身布满风尘之色的旅者，背後背著一把长剑，你仔细一瞧，他竟是
闻名遐迩，和宫本武藏约战严流岛的佐佐木小次郎，你不禁疑问他为何(why)在此．
他坐在那ㄦ闭著眼睛似乎在统一精神，他似乎是居合斩的高手．\n");
       set("unit","位");
       set("alignment",200);
       set_level(19);
       set("hit_points",1100);
       set("max_hp",1100);
       set("wealth/gold",200);
       set("gender","male");
       set("race","human");
       set("exp_reward",36000);
       set_perm_stat("str",30);
       set_perm_stat("dex",30);
       set_perm_stat("int",24);
       set_perm_stat("karma",25);
       set_perm_stat("con",27);
       set_perm_stat("pie",25);
       set_natural_weapon(21,20,30);
       set_natural_armor(62,34);
       set_skill("parry",100);
       set_skill("dodge",60);
       set_skill("longblade",100);
       set_skill("tactic",80);
       set("tactic","melee");
       set("no_attack",1);
       set("tactic_func","f_bird");
       set("aim_difficulty",(["vascular":40,"weakest":40,"critical":60,"ganglion":60]) );
       set("special_defense",(["monk":35,"scholar":35]) );
       set("weight",70);
       equip_armor(YARM"sandal");
       equip_armor(YARM"robe2");
       wield_weapon(YWEA"sword4");
       set("inquiry", ([
            "why" : "@@ask_why",
            "things" : "@@ask_things",
            "swordship" : "@@ask_swordship",
            "challenge" : "@@ask_challenge"
            ]) ); 
}
void ask_why(object who)
{
        tell_object(who,"还不是因为宫本武藏那个家伙，约战严流岛不到，说是去寻找武士的正道，我看他是怕我赢他，就'烙跑'了，几个月前遇到一东方商船到我祖国， 就趁此机会到了这'东方大陆'，打听之下才知道武藏他在另一个大陆，本想追过去，但在幽国城附近遇到一些事(things)，就使我留在这里修行．\n");
        return;
}
void ask_things(object who)
{
        tell_object(who,"当时我遇到一些盗贼正在抢劫，於是出手阻止，但遇到一名高手，眼见性命不保，此时一名奇人出现助我，以令人惊异的剑术将该盗贼击毙，我向他请教剑术(swordship)，他就要我待在幽国皇城中修行，他不定时会来教我，但我并不知他的来历，而他似乎也并不愿意我提到这方面的事......\n");
        return;
}
void ask_swordship(object who)
{
        tell_object(who,"就是'居合斩'，是一种高超,致命性的剑术，你要试试(challenge)吗? \n");
        return;
}
void ask_challenge(object who)
{
        if((int)who->query_level()<14){
        tell_object(who,"你还不够格向我挑战！\n");
        return;
        }else{
        tell_object(who,"很好！！接招吧！！\n");
   //     set("no_attack",0);
  //      故意的

        tell_object(who,"佐佐木小次郎拔剑虎踞，双眼直视，在观察你全身的破绽，并且开始聚集全身的力量..........\n");
        tell_object(who,"佐佐木小次郎倏地冲向你，挥出致命的一剑！！\n");
        who->set("hit_points",1); 
        who->kill_ob(this_object());
        this_object()->set("stop_attack",3);
       }
        return; 
}        
int f_bird()
{
      int n;
      object *victim;
      victim=query_attackers();
      if(!victim) return 0;
      n=sizeof(victim);
      if(random(50)<=15) {
      tell_room(environment(this_object()),set_color("\n"+ this_object()->query("c_name"),"HIY") +set_color("的天之丛云发出耀眼的光芒，幻化出一只火鸟冲向敌人．\n","HIY")+"\n",this_object());
       while(n--){
       victim[n]->receive_damage(65+random(10));
       (CONDITION_PREFIX + "flamezone")->apply_effect(victim[n],1,5 );}
       }else{return 0;}
       return 1;
} 
