#include "yogor.h"

inherit "/u/i/innocence/yogor/war/y_war";

void create()
{           ::create();
            set_name("wei ding guo","魏定国");
            add("id",({"wei","guo"}) );
            set_short("〔神火将军〕魏定国");
            set_long("原亦为团练使的魏定国，也是这次的攻城副将，擅长用火器取人．\n");
            set("unit","位");
            set("alignment",-500);
            set("wealth/gold",100);
            set("gender","male");
            set("race","human");
            set("hit_points",800);
            set("max_hp",800);
            set("killer",1);
            set("effort",70);
            set_level(17);
            set_perm_stat("str",28);
            set_perm_stat("int",27);
            set_perm_stat("dex",26);
            set_perm_stat("karma",26);
            set_skill("parry",100);
            set_skill("dodge",90);
            set_skill("longblade",90);
            set_natural_weapon(30,15,16);
            set("tactic_func","fire");
            set_natural_armor(40,30);
            set("aim_difficulty",(["weakest":20,"ganglion":20,"vascular":10]) );
            set("special_defense",(["monk":20,"scholar":20,"fire":40,"cold":20,"evil":20,"none":30]) );
            set("weight",730);
            equip_armor(YARM"helmet2");
            equip_armor(YARM"plate3");
            equip_armor(YARM"cloak1");
            equip_armor(YARM"boot5");
            wield_weapon(YWEA"blade3");
}
void fire()
{
            object *victim;
            int i;
            if(!(victim=query_attackers())) return ;
            if (random(10)<4) return ;
            else{
              tell_room(environment(this_object()),"\n魏定国喝道: 火 烧 连 环 !\n",this_object());
              for(i=0;i<sizeof(victim);i++) 
                victim[i]->receive_special_damage("fire",30);
              return ;
                 }
}
