#include "yogor.h"

inherit "/u/i/innocence/yogor/war/y_war";

void create() {
  ::create();
  set_name("yan chin", "燕青");
  add("id", ({ "yan", "chin" }));
  set_short("〔浪子〕燕青");
  set_long(
    "六尺以上身材，三牙掩口髭须，十分腰细膀阔，一身雪练也似白肉，刺上了
似玉亭柱上铺著软翠的遍体花绣，一张川弩，箭到物落，燕青是也．\n");
  set("unit", "位");
  set("alignment", -500);
  set("wealth/gold", 50);
  set("gender", "male");
  set("race", "human");
  set("weight", 700);
  set("hit_points", 600);
  set("max_hp", 600);
  set("killer", 1);
  set("effort", 40);
  set_level(15);
  set_perm_stat("str", 23);
  set_perm_stat("dex", 26);
  set_perm_stat("int", 25);
  set_perm_stat("karma", 23);
  set_skill("parry", 80);
  set_skill("dodge", 90);
  set_skill("blunt", 80);
  set_natural_weapon(30, 20, 23);
  set_natural_armor(34, 25);
  set("aim_difficulty", ([ "weakest": 20, "ganglion": 20 ]));
  set("special_defense", ([ "monk": 15, "scholar": 15, "fire": 30, "evil": 30, "none": 30 ]));
  equip_armor(YARM "helmet4");
  equip_armor(YARM "plate4");
  equip_armor(YARM "boot2");
  equip_armor(YARM "amulet4");
  wield_weapon(YWEA "bow");

}
