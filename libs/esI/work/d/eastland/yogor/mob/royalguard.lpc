#include "yogor.h"
inherit YMOB "army.lpc";

void create() {
  ::create();
  set_name("yogor royal_guard", "皇家守卫");
  add("id", ({ "royal_guard", "guard" }));
  set_short("幽国城皇家守卫");
  set_long("他们是幽国城最後一道防线，负责保护皇室的安全，都是众守卫中的佼佼者，才能胜任此一职务．\n");
  set("unit", "位");
  set("alignment", 700);
  set_level(16);
  set("hit_points", 500);
  set("max_hp", 500);
  set("wealth/gold", 20);
  set("gender", "male");
  set("race", "human");
  set_perm_stat("str", 28);
  set_perm_stat("dex", 25);
  set_perm_stat("int", 20);
  set_perm_stat("karma", 20);
  set_natural_weapon(26, 10, 5);
  set_natural_armor(40, 27);
  set_skill("longblade", 90);
  set_skill("parry", 80);
  set_skill("dodge", 70);
  set_skill("tactic", 80);
  set("tactic", "melee");
  set("aim_difficulty", ([ "vascular": 20, "ganglion": 10, "weakest": 10 ]));
  set(
    "special_defense",
    ([ "fire": 50, "cold": 20, "evil": 60, "electric": 10, "energy": 10, "none": 15 ])
  );
  set("weight", 80);
  equip_armor(YARM "mail2");
  equip_armor(YARM "helmet9");
  equip_armor(YARM "boot7");
  wield_weapon(YWEA "sword2");
}
