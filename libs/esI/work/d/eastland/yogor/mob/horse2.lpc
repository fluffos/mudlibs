#include <mudlib.h>

inherit MONSTER;
inherit MOUNT;

void create()
{
	::create();
	set_level(14);
	set_name( "redrabbit horse",set_color("赤兔马","HIR") );
	add( "id", ({ "horse" }) );
	set_short( set_color("赤兔马","HIR") );
	set_long(
		"一只全身火红的高大骏马，为三国中关羽的坐骑，因此声名大噪。\n" );
	set( "unit", "只" );
	set_perm_stat( "str", 14 );
	set_perm_stat( "dex", 18 );
	set( "natural_armor_class", 35 );
	set( "natural_weapon_class1", 30 );
	set( "natural_min_damage1", 15 );
	set( "natural_max_damage1", 30 );
	set( "alignment", 100 );
        set( "exp_reward",1);
	set( "max_load", 2350 );
	set_c_limbs( ({ "头部", "身体", "後腿", "尾巴" }) );
	set_c_verbs( ({  "%s扑动火蹄，朵朵火花飞向%s", "%s烈尾一甩，火辣辣地扫过%s" }) );

}

void init()
{
	mount::init();
}
