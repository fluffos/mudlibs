#include "yogor.h"
inherit YMOB "army.lpc";

void create() {
  ::create();
  set_name("yogor cityguard leader", "幽国城守卫队长");
  add("id", ({ "cityguard", "guard", "leader" }));
  set_short("幽国城守卫队长");
  set_long("幽国城看守城门的守卫队长，负责领导幽国城的众守卫们，他可是幽国城的安全之钥．\n");
  set("unit", "位");
  set("alignment", 1000);
  set_level(16);
  set("hit_points", 550);
  set("max_hp", 550);
  set("wealth/gold", 20);
  set("gender", "male");
  set("race", "human");
  set_perm_stat("str", 19);
  set_perm_stat("dex", 17);
  set_perm_stat("int", 14);
  set_perm_stat("karma", 13);
  set_natural_weapon(25, 20, 30);
  set_natural_armor(35, 20);
  set_skill("parry", 70);
  set_skill("thrusting", 70);
  set_skill("tactic", 60);
  set("tactic_func", "melee");
  set("aim_difficulty", ([ "vascular": 30, "ganglion": 35, "weakest": 10 ]));
  set("special_defense", ([ "all": 30, "none": 5 ]));
  set("weight", 800);
  equip_armor(YARM "helmet7");
  equip_armor(YARM "mail1");
  wield_weapon(YWEA "spear3");
}
void die() {
  tell_room(environment(),
    "队长口吐鲜血倒在地上．\n"
    "幽...幽...幽国城的安全就毁在你的手上了．\n"
    "你还来不及反应，他已死了．\n\n",
    this_object());
  "/d/eastland/yogor/war/war"->start_war();
  ::die(1);
}
