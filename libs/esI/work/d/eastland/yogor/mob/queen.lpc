#include "yogor.h"

inherit MONSTER;
 
void create()
{      ::create();
       set_name("yogor queen","皇后");
       add("id",({"queen"}) );
       set_short("幽国城皇后");
       set_long(
"你看到一位丰姿绰约，风华绝代的女子，一身华服不单显示其地位，更
衬托其气质高贵，你向她望去时，她也回应你一个微笑，虽然她已有些年
纪了，但看起来仍很年轻，平时她也帮城主处理些事务，颇得民心．\n");
       set("unit","位");
       set("alignment",700);
       set_level(18);
       set("hit_points",800);
       set("max_hp",800);
       set("wealth/gold",100);
       set("gender","female");
       set("race","human");
       set_perm_stat("str",22);
       set_perm_stat("dex",25);
       set_perm_stat("int",22);
       set_perm_stat("karma",20);
       set_perm_stat("piety",19);
       set_perm_stat("con",23);
       set_natural_weapon(8,4,11);
       set_natural_armor(40,31);
       set_skill("anatomlogy",95);
       set_skill("dodge",80);
       set_skill("dagger",90);
       set_skill("tactic",50);
       set_skill("parry",85);
       set("aiming_loc","weakest");
       set("tactic_func","my_aimg");
       set("tactic","melee");
       set("aim_difficulty",(["vascular":40,"ganglion":40,"weakest":30,"critical":20]) );
       set("special_defense",(["monk":10,"scholar":10,"fire":50,"cold":45,"electric":40,"energy":43,"evil":42,"none":32]) );
       set("weight",45);
       equip_armor(YARM"cloth2");
       equip_armor(YARM"armband");
       wield_weapon(YWEA"dagger");
}
int my_aimg(object me,object victim)
{
        int my_int, vic_con,times;
        times=0;
        me=this_object();
        victim = this_object()->query_attacker();
        vic_con = victim->query_stat("con");
        if(random(100)<85) return 0;
        else{
        tell_object(victim, set_color(
  me->query("c_name") + "用锐利的眼神盯著你瞧，似乎在观察你的弱点....。\n"
            ,"HIC")
        );
        tell_room( environment(me),
             me->query("c_name") + "用锐利的眼神盯著" + victim->query("c_name")
+ "的行动，似乎在观察对手的弱点 ....。\n" ,
                ({ me, victim }) );
        if(vic_con<24) times=8;
        else{ times=6;}
                victim->block_attack(times);
                victim->set_temp("msg_stop_attack",
                 "( 你觉得刚才被打中的地方疼痛难当，失去一次攻击机会。 )\n");
        }
        return 0;
}
