#include "yogor.h"

inherit "/u/i/innocence/yogor/war/y_war";
 
void create()
{      ::create();
       set_name("chang ching","张清");
       add("id",({"chang","ching"}) );
       set_short("〔没羽箭〕张清");
       set_long(
"梁山泊马军八骠骑兼先锋使的[没羽箭]张清，是天罡三十六星中的天捷星，是这次攻城的
主将，擅长飞石打人，想当初遭遇梁山其他好汉时，连打一十五员大将，可说是一员虎将．\n");
       set("unit","位");
       set("alignment",-1100);
       set_level(19);
       set("hit_points",1000);
       set("max_hp",1000);
       set("wealth/gold",100);
       set("gender","male");
       set("race","human");
       set("killer",1);
       set("effort",100);
       set("exp_reward",36000);
       set_perm_stat("str",30);
       set_perm_stat("dex",30);
       set_perm_stat("int",30);
       set_perm_stat("karma",30);
       set_natural_weapon(26,15,30);
       set_natural_armor(45,26);
       set_skill("parry",100);
       set_skill("dodge",100);
       set_skill("thrusting",100);
       set("tactic_func","rock");
       set("detect_invis",1);
       set("aim_difficulty",(["vascular":30,"ganglion":40,"critical":35,"weakest":30]) );
       set("special_defense",(["all":33,"none":45,"monk":30,"scholar":30]) );
       set("weight",750);
       equip_armor(YARM"helmet5");
       equip_armor(YARM"plate5");
       equip_armor(YARM"cloak3");
       equip_armor(YARM"boot3");
       equip_armor(YARM"amulet2");
       wield_weapon(YWEA"spear1");
}
int rock()
{
       object victim;
       int vic_dex,n,i;
       if (!(victim=query_attacker())) return 0;
       vic_dex=(int)victim->query_stat("dex");
       if (random(70)<vic_dex*2)
          return 0;
       else{
            switch(n=random(3))
{
case 0:
 {   tell_room(environment(this_object()),set_color("\n 张清喝道: 呔 ! 吃我一石子 !! \n","HIW"));
     tell_object(victim,set_color("    你脸上挨了张清一石子，痛苦难当 !\n","HIM"));
     tell_room(environment(),sprintf("%s脸上挨了一石子，鲜血迸流．\n",victim->query("c_name")));
     victim->receive_special_damage("none",30);
     return 1;
 }
case 1:
 {   tell_room(environment(this_object()),set_color("\n 张清暗喝一声: 著 !\n","HIW"));
     tell_object(victim,set_color("    你鼻梁上挨了一石子，战意顿失 !\n","HIM"));
     tell_room(environment(),sprintf("%s鼻梁上挨了一石子，落荒而逃．\n",victim->query("c_name")));
       victim->run_away();
     return 1;
 }
case 2:
 {   tell_room(environment(this_object()),set_color("\n 张清大喝: 著 !!\n","HIW"));
     tell_object(victim,set_color("    你膝盖\上挨了张清一石子，该脚登时酥软，不能行动 !\n","HIM"));
     tell_room(environment(),sprintf("%s脚上挨了一石子，瘫倒在地．\n",victim->query("c_name")));
     victim->set("stop_attack",3);
     return 1;
 }
}
}
}
