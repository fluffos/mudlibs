#include "yogor.h"

inherit MONSTER;

void create() {
  ::create();
  set_name("little boy", "小童");
  add("id", ({ "boy" }));
  set_short("小童");
  set_long(
    "一个正在打扫整理书房的小童，别瞧他年纪小，一举一动中规中矩的，双眸中
隐隐闪著一丝狡滑的神情，似乎在告诉你:我也不是好欺负的!\n");
  set("unit", "位");
  set("alignment", 200);
  set_level(7);
  set("hit_points", 170);
  set("max_hp", 170);
  set("wealth/gold", 2);
  set("gender", "male");
  set("race", "human");
  set_perm_stat("str", 10);
  set_perm_stat("dex", 10);
  set_perm_stat("int", 9);
  set_perm_stat("karma", 8);
  set_natural_weapon(5, 2, 5);
  set_natural_armor(30, 10);
  set("tactic_func", "kick");
  set_skill("blunt", 35);
  set_skill("parry", 20);
  set_skill("dodge", 40);
  set("aim_difficulty", ([ "vascular": 10, "ganglion": 20 ]));
  set("special_defense", ([ "all": 8, "none": 5 ]));
  set("weight", 30);
  wield_weapon(YWEA "club2");
  set("inquiry", ([
    "book": "@@ask_book",
    "魔法大全": "@@ask_book" ]));
}
void ask_book(object who) {
  if ((int)this_player()->query_temp("finding") < 1) {
    tell_object(who, "问什麽!! 去去去...不要妨碍我打扫! \n");
    return;
  }
  tell_object(who, " 喔...是美尔琳思叫你来的吗..可是这里是王子的书房，不然这样吧，你去问问王子，有他的允许(permission)我再让你找．\n");
  this_player()->set_temp("finding", 2);
  return;
}
int kick(object victim) {
  if (!victim) return 0;
  if ((int)victim->query_level() > 12) {
    tell_object(victim, "\n  等级麽高还欺负弱小，不要脸!!\n");
    tell_object(victim, "小童一脚把你踹了出去．\n");
    tell_room(environment(victim),
      "小童一脚把" + victim->query("c_name") + "踹了出去。\n",
      victim);
    victim->receive_damage(random(10));
    victim->move_player(YROOM "room36", "SNEAK", "");
  }
  return 1;
}
