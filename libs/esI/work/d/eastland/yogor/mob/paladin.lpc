#include "yogor.h"

inherit MONSTER;

void create() {
  ::create();
  set_name("paladin", "萧是然");
  add("id", ({ "paladin" }));
  set_short("游侠 萧是然");
  set_long(
    "高挑健美的身材，飘逸的长发，令你一见惊鸿，一身的武装掩盖不了她
自然的个性美，潇洒的个性驱使她云游四海，可别因为她是女孩子就轻视
她，她可是一身的好武艺，瞧她眼中似乎有一丝淡淡的忧愁，不知有什麽
事困扰著她．\n");
  set("unit", "位");
  set("alignment", 1000);
  set_level(18);
  set("hit_points", 750);
  set("max_hp", 750);
  set("wealth/gold", 50);
  set("gender", "female");
  set("race", "human");
  set_perm_stat("str", 28);
  set_perm_stat("dex", 30);
  set_perm_stat("int", 25);
  set_perm_stat("karma", 20);
  set_perm_stat("con", 25);
  set_perm_stat("piety", 22);
  set_natural_weapon(22, 10, 20);
  set_natural_armor(50, 31);
  set_skill("longblade", 90);
  set_skill("parry", 90);
  set_skill("dodge", 70);
  set_skill("block", 80);
  set_skill("tactic", 75);
  set("tactic", "melee");
  set("tactic_func", "slash");
  set("aim_difficulty", ([ "vascular": 30, "ganglion": 20, "weakest": 20, "critical": 40 ]));
  set(
    "special_defense",
    ([ "fire": 50, "cold": 40, "evil": 70, "electric": 40, "energy": 30, "none": 40 ])
  );
  set("weight", 430);
  equip_armor(YARM "leggings1");
  equip_armor(YARM "robe3");
  equip_armor(YARM "boot8");
  equip_armor(YARM "shield");
  wield_weapon(YWEA "sword3");
}
void accept_item(object me, object item) {
  string name;
  object ob1;
  name = (string)item->query("name");
  if ((int)this_player()->query_temp("finding") < 3) return;
  if (!name || (name != "gold_chocolate" && name != "blue pearl" && name != "beautiful cloth" && name != "jewel necklace")) return;
  if ((int)this_player()->query_temp("finding") == 3 && name = "gold chocolate") {
    tell_object(me,
      "萧是然接过金莎，说道：啊..是王子送的吗..。 你看到她双颊略泛红晕，点头
说是，萧是然接著说：请你回禀王子，他的好意我接受，但感情方面的事我需要
时间......。 你听了也不好说什麽，只得先回报(report)王子结果(result)。\n");
    this_player()->set_temp("finding", 4);
    item->remove();
    return;
  }
  if ((int)this_player()->query_temp("finding") == 5 && name = "blue pearl") {
    tell_object(me,
      "萧是然接过蓝珍珠，说道：啊...又是他吗...。你看到她的欣喜而又带点惆怅的
表情而有些不解，但你忍住不探问，她接著说：请你回禀王子，请他在给我一些时
间考虑。 你只得再跑一趟回报结果。\n");
    this_player()->set_temp("finding", 6);
    item->remove();
    return;
  }
  if ((int)this_player()->query_temp("finding") == 7 && (name = "beautiful cloth" || name = "jewel necklace")) {
    item->remove();
    if (name = "beautiful cloth" || name = "jewel necklace") {
      tell_object(me,
        "萧是然接过礼物，叹了一口气说道：这样下去是不行的...。 她顿了一顿，接著
说道：好心人，这段时间我之所以如此犹豫，不肯接受王子的追求，是因为我心中
另有所属，但是那个人迟迟不表示他的心意，我也不好意思再拒绝王子的追求，请
你回禀王子说我愿意和他交往看看。另外....。说著萧是然拿出一张小纸片交给你，
说道：请你帮我交给那无缘的人，他应该就在城中某处躲著吧....。说著说著头低
下来，似乎难掩悲伤，你不好意思久留，匆忙去完成她交代的事。\n");
      this_player()->set_temp("finding", 8);
      item->remove();
      ob1 = new(YOBJ "paper");
      ob1->move(this_player());
      return;
    }
  }
  return;
}

int slash() {
  object victim, *victim1;
  int i;
  if (!(victim1 = query_attackers())) return 0;
  i = sizeof(victim1);
  if (!(victim = query_attacker()) || (random(10) > 3)) return 0;
  else {
    switch (random(3)) {
      case 0:
        tell_room(
          environment(victim),
          set_color(
            "\n萧大侠跃起数丈，一招猎鹰扑羊直袭",
            "WHT"
          ) + victim->query("c_name") + set_color("而去！\n\n", "WHT")
        );
        victim->receive_special_damage("magic", 30);
        break;
      case 1:
        tell_room(environment(victim), set_color("\n萧大侠一招白鹤亮翅，横扫敌人！\n\n", "HIW"));
        while (i--)
          victim1[i]->receive_special_damage("divin", 38);
        break;
      case 2:
        tell_room(environment(victim), set_color("\n萧大侠使出最强一式的百鸟朝凤重创敌人！\n\n", "HIC"));
        while (i--)
          victim1[i]->receive_special_damage("mental", 45);
        break;
      default:
        return 0;
    }
  }
}
