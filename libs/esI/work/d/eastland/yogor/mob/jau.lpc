#include "yogor.h"

inherit "/u/i/innocence/yogor/war/y_war";

void create() {
  ::create();
  set_name("jau ting", "焦挺");
  add("id", ({ "jau", "ting" }));
  set_short("〔没面目〕焦挺");
  set_long("中山府人氏，相扑的好手，平生最不讲交情．是这次攻城的先锋．\n");
  set("unit", "位");
  set("alignment", -700);
  set("weight", 800);
  set("hit_points", 600);
  set("max_hp", 600);
  set("killer", 1);
  set("effort", 40);
  set("gender", "male");
  set("race", "human");
  set("wealth/gold", 50);
  set_level(15);
  set_perm_stat("str", 28);
  set_perm_stat("dex", 26);
  set_perm_stat("int", 20);
  set_perm_stat("karma", 23);
  set_skill("dodge", 90);
  set_skill("unarmed", 100);
  set("tactic_func", "box");
  set_natural_weapon(55, 30, 45);
  set_natural_weapon2(45, 30, 45);
  set_natural_armor(38, 25);
  set("aim_difficulty", ([ "weakest": 20, "vascular": 10 ]));
  set(
    "special_defense",
    ([ "fire": 20, "cold": 10, "evil": 30, "none": 35, "monk": 20, "scholar": 10 ])
  );
  equip_armor(YARM "helmet6");
  equip_armor(YARM "plate2");
  equip_armor(YARM "boot6");
  equip_armor(YARM "amulet3");
}
void box() {
  object victim;
  int vic_kar, vic_dex;
  if (!(victim = query_attacker())) return;
  vic_dex = (int)victim->query_stat("dex");
  vic_kar = (int)victim->query_stat("karma");
  if (random(60) < (vic_dex + vic_kar)) return;
  else {
    tell_room(environment(this_object()), "\n焦挺喝道: 哈杀 !\n");
    tell_object(victim, "  焦挺打你个塔墩 !\n");
    tell_room(environment(), sprintf("%s被焦挺打倒在地．\n", victim->query("c_name")));
    victim->receive_damage(25);
    return;
  }
}
