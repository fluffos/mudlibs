#include "yogor.h"

inherit MONSTER;
 
void create()
{      ::create();
       set_name("wanderer","流浪汉");
       add("id",({"wanderer"}) );
       set_short("流浪汉");
       set_long("满头的乱发，一身破破烂烂的衣服，涣散的目光微微透露著一丝丝恐惧和愤怒．\n");
       set("unit","位");
       set("alignment",50);
       set_level(1);
       set("hit_points",20);
       set("max_hp",20);
       set("wealth/copper",1);
       set("gender","male");
       set("race","human");
       set_natural_weapon(5,3,5);
       set_natural_armor(5,2);
       set("weight",60);
}
int accept_item(object me,object item)
{
        string name;
        name=(string)item->query("name");
     if ( !name || (name!="little paper") ) return 1;
        if (name == "little paper")
    {
     tell_object(me,
@PAPER
    当他接过那张小纸片，眼中露出些许的疑惑，而他读著小纸片时，你看到他双手微微
颤抖著，读完，他抬起头对你说：谢谢你将她的消息传递给我....，他叹了口气，继续说
道：想不到她竟是等待我的表示，早知如此，就不必伪装成这样偷偷欣赏，关心她了..这
也是命运捉弄吧....，他看了你一眼说：孩子，记得当你真的喜欢一个人的时候，要勇敢
的表示啊..  说著他就转身离去了。
PAPER
        );
      me->credit("gold",100);
        remove();
        return 1;
    }
}
