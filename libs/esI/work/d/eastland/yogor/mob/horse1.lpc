#include <mudlib.h>

inherit MONSTER;
inherit MOUNT;

void create()
{
	::create();
	set_level(12);
	set_name( "sweatblood horse", set_color("汗血宝马","HIM") );
	add( "id", ({ "horse" }) );
	set_short( set_color("汗血宝马","HIM") );
	set_long("西域进贡的汗血宝马，能日行千里而不坠，疾速奔跑时会流出鲜红色的汗水，故名为汗血宝马．。\n" );
	set( "unit", "只" );
	set_perm_stat( "str", 13 );
	set_perm_stat( "dex", 20 );
	set( "natural_armor_class", 35 );
	set( "natural_weapon_class1", 30 );
	set( "natural_min_damage1", 15 );
	set( "natural_max_damage1", 30 );
	set( "alignment", 100 );
	set( "max_load", 2150 );
        set( "exp_reward",1);
	set_c_limbs( ({ "头部", "身体", "後腿", "尾巴" }) );
	set_c_verbs( ({  "%s扑动血蹄，片片红云飞向%s", "%s烈尾一甩，火辣辣地扫过%s" }) );

}

void init()
{
	mount::init();
}
