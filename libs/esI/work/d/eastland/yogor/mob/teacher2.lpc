#include "yogor.h"

inherit MONSTER;

void create() {
  ::create();
  set_name("unarmed teacher", "拳法教头");
  add("id", ({ "teacher" }));
  set_short("拳法教头");
  set_long(
    "他是教导幽国城守卫空手搏斗技能的教头，号称少林七十二绝技
皆有涉猎，他正耐心教导那些未来的守城尖兵．\n");
  set("unit", "位");
  set("alignment", 500);
  set_level(14);
  set("hit_points", 400);
  set("max_hp", 400);
  set("wealth/gold", 10);
  set("gender", "male");
  set("race", "human");
  set_perm_stat("str", 26);
  set_perm_stat("dex", 24);
  set_perm_stat("int", 18);
  set_perm_stat("karma", 17);
  set_natural_weapon(25, 10, 10);
  set_natural_armor(50, 30);
  set_skill("unarmed", 70);
  set_skill("parry", 70);
  set_skill("dodge", 80);
  set_skill("tactic", 50);
  set("tactic", "melee");
  set("aim_difficulty", ([ "vascular": 10, "ganglion": 20, "weakest": 10 ]));
  set("special_defense", ([ "all": 28, "none": 15 ]));
  set("weight", 70);
  equip_armor(YARM "cloth4");
  wield_weapon(YWEA "fist");
}
