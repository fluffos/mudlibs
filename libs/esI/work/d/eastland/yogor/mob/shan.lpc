#include "yogor.h"

inherit "/u/i/innocence/yogor/war/y_war";

void create()
{           ::create();
            set_name("shan ting gue","单廷贵");
            add("id",({"shan","gue"}) );
            set("unit","位");
            set_short("〔圣水将军〕单廷贵");
            set_long("原为团练使的单廷贵，是这次攻城的副将，善用决水浸兵之法．\n");
            set("alignment",-500);
            set("hit_points",800);
            set("max_hp",800);
            set("wealth/gold",150);
            set("gender","male");
            set("race","human");
            set("killer",1);
            set("effort",70);
            set_level(17);
            set_perm_stat("str",28);
            set_perm_stat("int",27);
            set_perm_stat("dex",25);
            set_perm_stat("karma",25);
            set_skill("parry",100);
            set_skill("dodge",90);
            set_skill("thrusting",100);
            set_natural_weapon(30,20,20);
            set_natural_armor(40,30);
            set("weight",720);
            set("tactic_func","water");
            set("aim_difficulty",(["ganglion":20,"weakest":20,"vascular":10]) );
            set("special_defense",(["monk":20,"scholar":20,"fire":30,"cold":30,"evil":20,"none":30]) );
            equip_armor(YARM"helmet3");
            equip_armor(YARM"plate1");
            equip_armor(YARM"cloak2");
            equip_armor(YARM"boot4");
            wield_weapon(YWEA"spear2");
}
void water()
{
            object *victim;
            int i;
            if(!(victim=query_attackers())) return ;
            if (random(10)<4) return ;
            else{
             tell_room(environment(this_object()),"\n单廷贵喝道: 水 淹 七 军 !\n",this_object());
              for(i=0;i<sizeof(victim);i++)
                victim[i]->receive_special_damage("cold",30);
              return ;
                 }
}
