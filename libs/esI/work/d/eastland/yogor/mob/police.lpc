#include "yogor.h"
inherit YMOB "army.lpc";

void create() {
  ::create();
  set_name("policeman", "捕快");
  add("id", ({ "police", "policeman" }));
  set_short("幽国城捕快");
  set_long("你看到一位认真执勤，四处留神有无非法事情的捕快，手上的铁链随时准备拘捕坏人．\n");
  set("unit", "位");
  set("alignment", 500);
  set_level(8);
  set("hit_points", 200);
  set("max_hp", 200);
  set("wealth/gold", 10);
  set("gender", "male");
  set("race", "human");
  set_perm_stat("str", 12);
  set_perm_stat("dex", 10);
  set_natural_weapon(15, 5, 8);
  set_natural_armor(30, 15);
  set_skill("parry", 50);
  set_skill("dodge", 35);
  set_skill("whip", 40);
  set("aim_difficulty", ([ "vascular": 10, "ganglion": 20 ]));
  set("special_defense", ([ "all": 10, "none": 5 ]));
  set("weight", 80);
  equip_armor(YARM "uniform");
  wield_weapon(YWEA "chain");
}
