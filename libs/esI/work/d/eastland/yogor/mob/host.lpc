#include "yogor.h"

inherit MONSTER;

void init() {
  ::init();
  add_action("have_menu", "menu");
  add_action("have_menu", "list");
}

void create() {
  ::create();
  set_level(19);
  set_name("host", "修竹阁阁主");
  add("id", ({ "host" }));
  set_short("修竹阁阁主");
  set_long(
    "这位是修竹阁的主人,看他面如羊脂,相貌清奇,一双凤眼英气勃勃,两道
鹰眉咄咄逼人,想必是位不简单的人物.他在这里经营卖酒生意已有一段时
日,但无人得知他的来历,是位神秘人物.\n"
  );
  set("alignment", 5000);
  set("exp_reward", 32000);
  set("race", "human");
  set("unit", "位");
  set("gender", "male");
  set_perm_stat("str", 28);
  set_perm_stat("dex", 30);
  set_perm_stat("int", 27);
  set_perm_stat("karma", 27);
  set("max_hp", 1000);
  set("hit_points", 1000);
  set("wealth", ([ "gold": 400 ]));
  set_natural_weapon(30, 5, 20);
  set_natural_armor(45, 21);
  set("aim_difficulty", ([ "critical": 50, "vascular": 50, "weakest": 20 ]));
  set(
    "special_defence",
    ([ "monk": 30, "scholar": 10, "magic": 50, "evil": 50, "fire": 50, "none": 30 ])
  );
  set("weight", 700);
  set("tactic_func", "sword");
  set_skill("parry", 100);
  set_skill("dodge", 100);
  set_skill("longblade", 100);
  wield_weapon(YWEA "sword1");
  equip_armor(YARM "cloth1");
  equip_armor(YARM "boot1");
  equip_armor(YARM "amulet1");
  equip_armor(YARM "ring1");
  equip_armor(YARM "helmet1");
  set("inquiry", ([
    "menu": @ALONG


		这是修竹阁的价目表，您参考看看...
		**********************************************
		*                   修竹阁                   *
		**********************************************
		         竹叶青(Ching)           60 silvers
		         茅台酒(Mao)             70 silvers
		         女儿红(Red)             60 silvers
		         高粱酒(Gou)             70 silvers
		       * 烤山鸡(Roast) *        120 silvers
		       * 青竹丝泡酒(Special) *  180 silvers
		**********************************************
ALONG
  ]));
}

int have_menu() {
  write(@BLONG
              阁主递了一张手工制的菜单给你，你看了看...
                **********************************************
                *                   修竹阁                   *
                **********************************************
                         竹叶青(Ching)           60 silvers
                         茅台酒(Mao)             70 silvers
                         女儿红(Red)             60 silvers
                         高粱酒(Gou)             70 silvers
                       * 烤山鸡(Roast) *        120 silvers
                       * 青竹丝泡酒(Special) *  180 silvers
                **********************************************
BLONG
  );
  return 1;
}
int sword() {
  object victim;
  int dam;
  dam = 35 + random(30);
  if (!(victim = query_attacker())) return 0;
  if (random(40) < 30) return 0;
  else {
    tell_room(environment(this_object()), "\n修竹阁阁主大喝:光 速 剑!!\n");
    tell_room(environment(), sprintf("一道金光击中%s的身体．\n", victim->query("c_name")));
    tell_object(victim, "你被一道金光击中，顿感撕心裂肺的剧痛．\n");
    victim->receive_special_damage("mental", dam);
    return 1;
  }
}
