#include "yogor.h"

inherit MONSTER;
 
void create()
{      ::create();
       set_name("yogor magician mallince","美尔琳思");
       add("id",({"mage","magician","mallince"}) );
       set_short("宫廷魔法师 美尔琳思");
       set_long(
"你看到一个有点忙碌，在书堆里翻东翻西的眼魔，她是幽国城城主请来的
驻宫廷魔法师，负责整理一些卷轴和古书，当然在幽国城有难时，她也会帮
忙击退敌人，别看她一副槌槌的模样，她可是和银塔巫师，地精大长老并称
三大魔法师的施法者呢！\n");
       set("unit","位");
       set("alignment",800);
       set_level(19);
       set("hit_points",750);
       set("max_hp",750);
       set("force_points",600);
       set("max_sp",1000);
       set("spell_points",1000);
       set("wealth/gold",50);
       set("gender","female");
       set("race","beholder");
       set_perm_stat("str",22);
       set_perm_stat("dex",24);
       set_perm_stat("int",30);
       set_perm_stat("karma",30);
       set_perm_stat("con",25);
       set_natural_weapon(16,13,18);
       set_natural_armor(50,30);
       set("time_to_heal",3);
       set_skill("wand",100);
       set_skill("dodge",100);
       set_skill("black-magic",100);
       set_skill("concentrate",100);
       set_skill("target",100);
       set_skill("elemental",100);
       set("guild_levels/black-magic",80);
       set("guild_levels/elemental",80);
       set("guild_levels/guild",80);
       set("tactic_func","multi_cast");
       set("aim_difficulty",(["vascular":30,"ganglion":50,"weakest":40,"critical":50]) );
       set("special_defense",(["all":50,"none":50,"monk":25,"scholar":30]) );
       set("weight",50);
       equip_armor(YARM"globe");
       wield_weapon(YWEA"wand");
       set("chat_chance",7);
       set("chat_output",({"找不到!!! 奇怪.....怎麽可能..."}) );
       set("inquiry", ([
            "help" : "@@ask_help",
            "找" : "@@ask_help" ]) );
}
void ask_help(object who)
{
      if((int)who->query("finish_finding")==1) return;
      tell_object(who,"啊...有一本魔法大全不见了...大概放在书房忘了拿过来..是否能请你帮忙拿过来...谢谢．\n");
      this_player()->set_temp("finding",1);
      return;
}
void accept_item(object me,object item)
{
        string name;
        name=(string)item->query("name");
       if((int)me->query_temp("finding")!=9) return;
        if ( !name || name!="magic book") return;
          tell_object(me," 啊...正是我要的! 多谢你了! \n");
           if((int)me->query("finish_finding")==1) return;
          tell_object(me," [你完成 魔法师 的任务，得到2000点经验。]\n");
        me->gain_experience(2000); 
        me->set("finish_finding",1);
        return;
}
int multi_cast()
{
    object victim;
    string name;
    int i,j,ran,vickar,vicint,ref;
    victim =this_object()->query_attacker();
    vicint = victim->query_perm_stat("int") ;
    vickar = victim->query_perm_stat("kar") ;

    i =30-vicint ;
    j =30-vickar ;

    if( i+j < 1 )  ref = 1 ;
    else ref = random(i+j) ;
    ran = random(50) ;

    if ( (int)this_object()->query("spell_points")< 500 )
         this_object()->set("spell_points",1000);

    if ( ran < ref  )
       { 
       set("spells/fireball",8);
       set("spells/sleet",6);
       set("spells/lightning",5);
       set("spells/flare",3);
          name=victim->query("name");
    switch(random(4)){
case 0:
    command("cast flare on "+name);
    break;
case 1:
    command("cast sleet on "+name);
    break;
case 2:
    command("cast fireball on "+name);
    break;
case 3:
    command("cast lightning on "+name);
    break;
default:
    return 1;
    }
          this_object()->set_temp("cast_busy",0);
          this_object()->set("stop_attack",0);
          this_player()->continue_attack();
          if (random(10)>4) return 0;
            else{
       set("spells/fireball",5);
       set("spells/sleet",3);
       set("spells/lightning",2);
       set("spells/flare",1);
          switch(random(4)){
case 0:
    this_object()->set("cast_busy",1);
    command("cast flare on "+name);
    this_object()->set("cast_busy",3);
    return 1;
    break;
case 1:
    this_object()->set("cast_busy",1);
    command("cast sleet on "+name);
    this_object()->set("cast_busy",3);
    return 1;
    break;
case 3:
    this_object()->set("cast_busy",1);
    command("cast fireball on "+name);
    this_object()->set("cast_busy",3);
    return 1;
    break;
case 2:
    this_object()->set("cast_busy",1);
    command("cast lightning on "+name);
    this_object()->set("cast_busy",3);
    return 1;
    break;
default:
    return 1;
    } } 
          return 1;
        }
    else
       {
          return 0;
        }
}
