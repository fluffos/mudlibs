#include <mudlib.h>

inherit WEAPON;

void create()
{
          set_name("black bamboo sword","墨竹剑");
          add("id",({"black","sword"}) );
          set_short("墨竹剑");
          set_long("一把通体墨黑的剑，用墨竹加上特殊的药熬炼制成，锐利又有弹性，是一把罕见的利器．\n");
          set("unit","把");
          set("weight",100);
          set("value",({100,"gold"}) );
          set("no_sale",1);
          setup_weapon("longblade",35,25,32);
}

