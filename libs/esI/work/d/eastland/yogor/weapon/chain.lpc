#include <mudlib.h>

inherit WEAPON;

void create() {
  set_name("drain_soul chain", "勾魂□");
  add("id", ({ "chain" }));
  set_short("勾魂□");
  set_long("幽国城捕快们用来拘捕犯人的武器．\n");
  set("unit", "条");
  set("weight", 60);
  set("value", ({ 20, "gold" }));
  setup_weapon("whip", 15, 10, 15);
  set_c_verbs(({ "%s套向%s", "%s挥向%s", "%s闪出一道白光砸向%s" }));
}
