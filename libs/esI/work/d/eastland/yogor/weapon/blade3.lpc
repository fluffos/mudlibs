#include <mudlib.h>

inherit WEAPON;

void create()
{ 
            set_name("copper blade","熟铜刀");
            add("id",({"copper","blade"}) );
            set_short("熟铜刀");
            set_long("一柄熟铜混金打造的沉重大刀，若无过人的膂力，很难使得好．\n");
            set("weight",280);
            setup_weapon("longblade",32,20,34);
            set("value",({100,"gold"}) );
            set("unit","柄");
}
