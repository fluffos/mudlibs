#include <mudlib.h>

inherit WEAPON;

void create() {
  set_name("iron spear", "铁长枪");
  add("id", ({ "iorn", "spear" }));
  set_short("铁长枪");
  set_long("一柄铁铸长枪，锋利的枪尖闪著白光，是幽国城守卫的制式武器．\n");
  set("unit", "柄");
  set("weight", 150);
  set("value", ({ 500, "silver" }));
  setup_weapon("thrusting", 25, 10, 24);
}
