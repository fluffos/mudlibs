#include <mudlib.h>

inherit WEAPON;

void create() {
  set_name("light wand", set_color("光魔杖", "YEL"));
  add("id", ({ "wand" }));
  set_short(set_color("光魔杖", "YEL"));
  set_long("一把金色的魔杖，缠绕著一条银索，看来是传说中吸收魔力转换成打击力的装置，杖端的紫水晶隐隐闪动，彷佛隐藏什麽神秘力量．\n");
  set("unit", "把");
  set("weight", 60);
  set("value", ({ 200, "gold" }));
  set("no_sale", 1);
  setup_weapon("wand", 40, 20, 35);
  set("hit_func", "@@wand_switch");
  set("power_on", 1);
  set("charge_left", 10);
  set("max_charge", 10);
  set("special_damage_type", "divine");
  set("special_damage", 40);
  set("special_c_msg", set_color("吸收法力，挥出一道金色光波！", "HIY"));
}
string wand_switch() {
  switch (random(2)) {
    case 0: return "wand"; break;
    case 1: return "wand_hit"; break;
    default: return "wand_hit";
  }
}
int wand(object victim) {
  int vic_sp, my_int, my_sp, my_msp, sp;
  object holder;
  if (!(holder = environment(this_object())) || !living(holder)) return 0;
  vic_sp = (int)victim->query("spell_points");
  if (vic_sp <= 0) return 0;
  my_int = (int)holder->query_stat("int");
  my_sp = (int)holder->query("spell_points");
  my_msp = (int)holder->query("max_sp");
  if (random(my_int * 2) < 51) return 0;
  else {
    sp = random(5);
    tell_object(holder, set_color("\n光魔杖杖顶的的水晶闪出一道暗光，夺取敌人的法力给你．\n\n", "MAG"));
    tell_room(environment(holder), set_color("\n光魔杖杖顶的的水晶闪出一道暗光，夺取敌人的法力给主人．\n\n", "MAG"), holder);
    vic_sp = vic_sp - sp;
    if (vic_sp < 0) vic_sp = 0;
    victim->set("spell_points", vic_sp);
    my_sp = my_sp + sp;
    if (my_sp > 0.5 * my_msp) my_sp = 0.5 * my_msp;
    holder->set("spell_points", my_sp);
    return 1;
  }
}
