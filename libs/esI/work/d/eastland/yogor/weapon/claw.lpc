#include <mudlib.h>

inherit WEAPON;

void create() {
  set_name("flash claw", set_color("闪电爪", "HIY"));
  add("id", ({ "claw" }));
  set_short(set_color("闪电爪", "HIY"));
  set_long("一把呈五只龙爪形状的黄白色百炼钢爪，爪背上刻有闪电图样，似乎有隐藏闪电的魔力．\n");
  set("unit", "把");
  set("weight", 80);
  set("value", ({ 100, "gold" }));
  set("second", 1);
  setup_weapon("unarmed", 30, 17, 30);
  set_c_verbs(({ "%s挥向%s", "%s抓向%s", "%s化做一道龙影抓向%s", "%s发出一道闪光射向%s" }));
}
