#include <mudlib.h>

inherit WEAPON;

void create() {
  set_name("fu-chen", "拂尘");
  add("id", ({ "fu-chen" }));
  set_short("拂尘");
  set_long("一柄有著银色长毛的拂尘，柄上刻有一道金色的刻痕．\n");
  set("unit", "柄");
  set("weight", 60);
  set("value", ({ 200, "silver" }));
  setup_weapon("blunt", 15, 8, 15);
  set("hit_func", "sweep");
}
int sweep(object victim) {
  object holder;
  int lv1, lv2, rate;

  if (!victim) return 0;
  if (!(holder = environment(this_object())) || !living(holder)) return 0;
  lv1 = (int)holder->query_level();
  rate = (23 - lv1);
  if (random(rate) < 7) return 0;
  else {
    tell_object(holder, set_color("\n  你的拂尘发出银光甩向敌人．\n", "HIW"));
    tell_object(
      victim,
      "\n  " + holder->query("c_name") + "的拂尘发出" + set_color("银光i", "HIW") + "甩向你脸上，你顿时觉得火辣辣的．\n"
    );
    if (holder->query("npc")) victim->receive_damage(5 + random(10));
  }
}
