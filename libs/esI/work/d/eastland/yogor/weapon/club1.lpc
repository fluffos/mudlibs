#include <mudlib.h>

inherit WEAPON;

void create()
{
          set_name("iron club","镔铁长棍");
          add("id",({"club"}) );
          set_short("镔铁长棍");
          set_long("一根精铁打造的长棍，教练实用两相宜的兵器．\n");
          set("unit","根");
          set("weight",120);
          set("value",({30,"gold"}) );
          setup_weapon("blunt",35,20,34);
}

