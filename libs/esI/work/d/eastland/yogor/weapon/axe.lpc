#include <mudlib.h>

inherit WEAPON;

void create() {
  set_name("yan-wan axe", "阎王斧");
  add("id", ({ "axe" }));
  set_short("阎王斧");
  set_long("一把闪著青光的双锋斧，锋口暗红的血迹彷佛在叙述它的战绩，是把令敌人畏惧的武器．\n");
  set("unit", "把");
  set("weight", 130);
  set("value", ({ 600, "silver" }));
  setup_weapon("axe", 25, 15, 27);
  set("bleeding", 10);
}
