#include <mudlib.h>
#include <stats.h>
#include <conditions.h> 

inherit WEAPON;
void create()
{
          seteuid(getuid());
          set_name("Amenomuragumo sword",set_color("天之丛云","MAG"));
          add("id",({"sword"}) );
          set_short(set_color("天之丛云","MAG"));
          set_long("一把看来年代久远的日本剑，剑柄上有樱花和太阳的图饰，握在手中，你彷佛感觉到一股神秘力量欲从剑中冲出．\n");
          set("unit","把");
          set("weight",150);
          set("value",({300,"gold"}) );
          setup_weapon("longblade",40,20,40);
          set("wield_func","g_wield");
          set("unwield_func","g_unwield");
}
void g_wield()
{
      int ali,n;
      object holder;
      if( !(holder = environment(this_object())) || !living(holder) ) return ;
      ali=holder->query("alignment");
      if (ali<10000) return ;
      else if(ali>10000 && ali<=50000){n=0;}
      else if(ali>50000 && ali<=100000){n=1;}
      else if(ali>100000 && ali <=200000){n=2;}
      else if(ali>200000 && ali <=330000){n=3;}
      else if(ali>330000 && ali <=450000){n=4;}
      else if(ali>450000){n=5;}
      switch(n){
      case 0:   
       set_name("Amenomuragumo sword",set_color("天之丛云","HIM"));
       set_short(set_color("天之丛云","HIM"));
       setup_weapon("longblade",42,22,45);
       return;   
       break;
      case 1:
       set_name("Amenomuragumo sword",set_color("天之丛云","HIB"));
       set_short(set_color("天之丛云","HIB"));
       setup_weapon("longblade",44,24,47);
       return;  
       break;
      case 2:
       set_name("Amenomuragumo sword",set_color("天之丛云","HIC"));
       set_short(set_color("天之丛云","HIC"));
       setup_weapon("longblade",45,26,48);
       return;     
       break;
      case 3:
       set_name("Amenomuragumo sword",set_color("天之丛云","HIG"));
       set_short(set_color("天之丛云","HIG"));
       setup_weapon("longblade",46,28,49);
       return; 
       break;
      case 4: 
       set_name("Amenomuragumo sword",set_color("天之丛云","HIY"));
       set_short(set_color("天之丛云","HIY"));
       setup_weapon("longblade",47,30,50);  
       return;   
       break;
      case 5:
       set_name("Amenomuragumo sword",set_color("天之丛云","HIW"));
       set_short(set_color("天之丛云","HIW"));
       set("type","longblade");
       set("weapon_class",48);
       set("max_damage",55);
       set("min_damage",30); 
       return;      
       break;
      default:
        return ;
            }
        return;
}
void g_unwield()
{
      set_name("Amenomuragumo sword",set_color("天之丛云","MAG"));
      set_short(set_color("天之丛云","MAG")); 
      setup_weapon("longblade",40,20,40);
      return;
}
