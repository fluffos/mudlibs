#include <mudlib.h>

inherit WEAPON;

void create()
{          
            set_name("iron silver spear",set_color("镔铁银枪","HIW"));
            add("id",({"iron","silver","spear"}) );
            set_short(set_color("镔铁银枪","HIW"));
            set_long("用精铁细磨打造的一支银光闪闪锋利长枪，是马上作战的利器．\n");
            set("unit","支");
            set("weight",150);
            setup_weapon("thrusting",43,23,40);
            set("vlaue",({150,"gold"}) );
            set("nosecond",1);
            set("no_sale",1);
            set("wield_func","horse_wield");
            set("unwield_func","horse_unwield");
}
void horse_wield()
{
         if( !this_player()->query_temp("mounting") )return;
         else {
              setup_weapon("thrusting",45,25,45);
              return;
              }
}
void horse_unwield()
{         
         setup_weapon("thrusting",43,23,40);
         return;
}
