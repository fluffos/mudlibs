#include <mudlib.h>
#include <stats.h>
#include <conditions.h>

inherit WEAPON;

void create() {
  seteuid(getuid());
  set_name("moon morningstar", "赶月流星");
  add("id", ({ "morningstar", "star" }));
  set_short("赶月流星");
  set_long("一个淡黄色的带钉钢球□在一条约五尺的百□钢□上，夜色下彷佛发著银光，看来是把有隐藏魔力的流星□．\n");
  set("unit", "把");
  set("weight", 180);
  set("value", ({ 200, "gold" }));
  set("hit_func", "star");
  set("special_c_msg", ("发出一个") + set_color("黄色光球", "HIY") + ("，击中敌人的神经中枢．\n"));
  setup_weapon("chain", 37, 25, 40);
}
int star(object victim) {
  object holder;
  int my_int, my_dex, vic_int, vic_dex;
  string c_msg;

  if (!victim) return 0;
  if (!(holder = environment(this_object())) || !living(holder)) return 0;
  my_int = (int)holder->query_stat("int");
  my_dex = (int)holder->query_stat("dex");
  vic_int = (int)victim->query_stat("int");
  vic_dex = (int)victim->query_stat("dex");
  if (random(my_dex * 7 / 2) < (vic_int + vic_dex)) return 0;
  else {
    c_msg = (string)query("special_c_msg");
    tell_object(holder, "\n你的" + query("c_name") + c_msg + "\n");
    tell_room(
      environment(holder),
      "\n" + holder->query("c_name") + "的" + query("c_name") + c_msg + "\n",
      holder
    );
    victim->set("last_attacker", holder);
    if (holder->query("npc"))
      (CONDITION_PREFIX + "weak")->apply_effect(victim, 10, 2);
  }
  return 1;
}
