#include <mudlib.h>

inherit WEAPON;

void create() {
  set_name("chuan bow", "川弩");
  add("id", ({ "chuan", "bow", }));
  set_short("川弩");
  set_long("一把短小的弓弩，但经特殊熬炼制成，亦颇有威力，是燕青的拿手兵器．\n");
  set("unit", "把");
  set("weapon_class", 30);
  set("type", "blunt");
  set("min_damage", 18);
  set("max_damage", 30);
  set("weight", 80);
  set("value", ({ 140, "gold" }));
  set_c_verbs(({
    "%s随手抽出一根箭，射向%s",
    "%s虚拉弓弦，发出飕的一声，一股气流射向%s",
    "%s一记百步穿杨，一箭射向%s．",
    "%s发出一声清啸，连珠般抽出三只小箭，用迅雷不及掩耳的手法射向%s",
  }));
  set("hit_func", "shoot_damage");
}

int shoot_damage(object victim) {
  object holder;
  int my_dex, vic_dex;
  string c_msg;

  if (!victim) return 0;
  if (!(holder = environment(this_object())) || !living(holder)) return 0;
  my_dex = (int)holder->query_stat("dex");
  vic_dex = (int)victim->query_stat("dex");
  if (random(my_dex * 3) < vic_dex * 2)
    return 0;
  else {
    c_msg = "\n%s喝一声:" + set_color("〔如意子～～～著 !!!〕", "HIW") + "一箭命中%s !!\n\n";
    victim->set("last_attacker", holder);
    tell_object(holder,
      sprintf(c_msg, "你", victim->query("c_name")));
    tell_object(victim, sprintf(c_msg, holder->query("c_name"), "你"));
    tell_room(environment(holder),
      sprintf(c_msg,
        holder->query("c_name"), victim->query("c_name")),
      ({ holder, victim }));
    if (holder->query("npc")) victim->receive_damage(20);
    return 1;
  }
}
