#include <mudlib.h>
#include <stats.h>
#include <conditions.h>

inherit WEAPON;

void create() {
  seteuid(getuid());
  set_name("wind shortsword", "疾风袖剑");
  add("id", ({ "sword", "shortsword" }));
  set_short("疾风袖剑");
  set_long("一把用七彩水晶加以神秘封印打造而成短剑，略钝的剑刃让你不禁怀疑它的威力．\n");
  set("unit", "把");
  set("weight", 80);
  set("value", ({ 2000, "silver" }));
  set("second", 1);
  set("hit_func", "blood");
  setup_weapon("shortblade", 35, 15, 30);
}
int blood(object victim) {
  object holder, wea1, wea2;
  int dam, my_dex, my_int;
  if (!victim) return 0;
  if (!(holder = environment(this_object())) || !living(holder)) return 0;
  my_dex = (int)holder->query_stat("dex");
  my_int = (int)holder->query_stat("int");
  wea1 = holder->query("weapon1");
  wea2 = holder->query("weapon2");
  if (random(my_dex) < 14) return 0;
  else {
    if (wea1 = wea2) {
      tell_object(holder, set_color("\n你的疾风袖剑嗡嗡作响，快速挥动．\n", "HIC"));
      tell_room(
        environment(holder),
        "\n" + holder->query("c_name") + set_color("的疾风袖剑造成数道真空气流，切断敌人的血管．\n\n", "HIR"),
        holder
      );
      if (holder->query("npc"))
        (CONDITION_PREFIX + "bleeding")->apply_effect(victim, 2, 10, 7);
    } else { return 0; }
  }
  return 1;
}
