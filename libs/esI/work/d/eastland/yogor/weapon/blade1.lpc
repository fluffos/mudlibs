#include <mudlib.h>

inherit WEAPON;

void create()
{
          set_name("life_steal blade","夺命刀");
          add("id",({"blade"}) );
          set_short("夺命刀");
          set_long("一把厚背薄刃的钢刀，似乎吸了不少恶人血而隐隐闪著"+set_color("红光．\n","HIR"));
          set("unit","把");
          set("weight",90);
          set("value",({100,"gold"}) );
          setup_weapon("longblade",30,20,32);
          set("bleeding",10);
          set_c_verbs(({"%s闪出一道"+set_color("红光砍向","RED")+"%s","%s画出一道"+set_color("血线","RED")+"，斩破%s的血管","%s用力劈向%s","%s砍向%s"}));
}

