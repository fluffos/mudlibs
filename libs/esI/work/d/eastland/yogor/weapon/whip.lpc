#include <mudlib.h>

inherit WEAPON;

void create()
{
          set_name("block-thousand-miles whip","封千里");
          add("id",({"whip"}) );
          set_short("封千里");
          set_long("一把非常长的九龙鞭，金光闪闪的如金龙飞舞．\n");
          set("unit","把");
          set("weight",70);
          set("value",({500,"silver"}) );
          setup_weapon("whip",30,20,32);
          set_c_verbs(({"%s挥向%s","%s卷向%s","%s幻化成一条金龙扑向%s","%s舞的密不透风，罩向%s"}));
}

