#include <mudlib.h>

inherit WEAPON;

void create() {
  set_name("two-hand huge sword", "双手巨剑");
  add("id", ({ "sword" }));
  set_short("双手巨剑");
  set_long("一把需要两手才拿得动的阔身长刃重剑，具有可怕的扫荡威力．\n");
  set("unit", "把");
  set("weight", 200);
  set("value", ({ 50, "gold" }));
  set("nosecond", 1);
  setup_weapon("longblade", 35, 19, 37);
}
