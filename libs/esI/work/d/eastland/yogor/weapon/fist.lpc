#include <mudlib.h>

inherit WEAPON;

void create()
{
          set_name("iron gauntlets","铁拳套");
          add("id",({"gauntlets"}) );
          set_short("铁拳套");
          set_long("一双武师用来练习用的拳套，但也有一定的破坏力．\n");
          set("unit","双");
          set("weight",80);
          set("value",({400,"silver"}) );
          set("second",1);
          setup_weapon("unarmed",30,20,30);
}

