#include <mudlib.h>

inherit WEAPON;

string gen;
object holder;
void create() {
  set_name("luo-meh dagger", set_color("柳眉刃", "HIG"));
  add("id", ({ "dagger" }));
  set_short(set_color("柳眉刃", "HIG"));
  set_long("一把弯如柳眉，微泛绿光的匕首，小小的握柄似乎专为女孩子设计的．\n");
  set("unit", "把");
  set("weight", 3);
  set("value", ({ 100, "gold" }));
  set("second", 1);
  set("wield_func", "lady_wield");
  set("unwield_func", "lady_unwield");
  setup_weapon("dagger", 40, 24, 37);
}
void lady_wield() {
  if (!(holder = environment(this_object())) || !living(holder)) return;
  gen = (string)holder->query("gender");
  if (gen == "male" || gen == "neuter") return;
  else {
    tell_object(holder, set_color("\n你握住柳眉刃，有一种很趁手的感觉．\n", "HIW"));
    setup_weapon("dagger", 43, 25, 39);
    holder->modify_stat("dex", -1);
    holder->modify_skill("anatomlogy", 10);
  }
  return;
}
void lady_unwield() {
  setup_weapon("dagger", 40, 24, 37);
  holder->modify_stat("dex", 1);
  holder->modify_skill("anatomlogy", -10);
  return;
}
