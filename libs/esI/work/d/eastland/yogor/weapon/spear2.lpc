#include <mudlib.h>

inherit WEAPON;

void create()
{
            set_name("black spear","黑杆枪");
            add("id",({"black","spear"}) );
            set_short("黑杆枪");
            set_long("一支枪杆乌亮的锋利长枪，握在手中沉甸甸的，使来有些费力．\n");
            set("unit","支");
            set("weight",200);
            setup_weapon("thrusting",35,15,36);
            set("value",({100,"gold"}) );
            set("nosecond",1);
}
