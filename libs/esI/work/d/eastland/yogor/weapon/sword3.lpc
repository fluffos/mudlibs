#include <mudlib.h>
#include <stats.h>
#include <conditions.h>

inherit WEAPON;

void create()
{
          seteuid(getuid());
          set_name("shou-shan-night-rain sword",set_color("潇湘夜雨","MAG"));
          add("id",({"sword"}) );
          set_short(set_color("潇湘夜雨","MAG"));
          set_long("透著寒光的淡蓝色剑身彷佛透明似的，暗黑的古铜剑柄不但显得此剑年代久远，更让此剑在黑夜中如凌空飞舞，剑柄上刻有四金篆字:"+set_color("潇 湘 夜 雨．\n","HIY"));
          set("unit","把");
          set("weight",130);
          set("value",({1000,"silver"}) );
          setup_weapon("longblade",40,25,36);
          set("hit_func","rain");
}
int rain(object victim)
{
          object holder;
          int vic_int,my_tactic;
          if (!victim) return 0;
          if (!(holder=environment(this_object())) || !living(holder)) return 0;
          vic_int=(int)victim->query_stat("int");
          my_tactic=(int)holder->query_skill("tactic");
          if ((random(my_tactic)*4/5)<(vic_int*2)) return 0;
          else {
          tell_object(holder,set_color("你手上的剑发出一道蓝光．\n","HIB"));
          tell_room(environment(victim),set_color("\n蓝光一闪，你眼前浮现一副 子夜梧桐林，萧萧风雨声 的景象．\n\n","HIC"));
          victim->set("last_attacter",holder);
          (CONDITION_PREFIX+"underwater")->apply_effect(victim,1,1);
          if(holder->query("npc"))
            (CONDITION_PREFIX+"confused")->apply_effect(victim,2,8,5);
          }
          return 1;
}           
