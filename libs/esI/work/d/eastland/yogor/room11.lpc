#include <yogor.h>
#include <daemons.h>

inherit ROOM;

void create() {
  ::create();
  set_short("幽国城广场");
  set_long(
    "这里是幽国城的交通要冲，也是一些行脚商人的集散地．广场中央有一钟塔，
若有战事，塔上警钟会由义民击响，告知方圆数里内的居民避难．也呼引一些壮
士来帮忙保卫此城．\n"
  );
  set_outside("yogor");
  set("light", 1);
  set("exits", ([ "north": YROOM "room5",
    "west": YROOM "room10",
    "east": YROOM "room12",
    "south": YROOM "room16" ]));
  set("objects", ([ "vender": "/obj/vendor",
    "police": YMOB "police",
    "captain": YMOB "captain3" ]));
  reset();
}
void init() {
  int min, hour, day, year;
  string month;
  sscanf(WEATHER_D->query_game_time(), "%d:%d, %s %d, Year %d", hour, min, month, day, year);
  if (day == 1 || day == 15) {
    write(set_color("\nWAR NOW!!\n", "HIR"));
    //                   "/u/i/innocence/yogor/war/war"->start_war();
    return;
  }
}
