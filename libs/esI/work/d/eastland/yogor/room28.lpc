#include <yogor.h>

inherit ROOM;

void create() {
  ::create();
  set_short("西回廊");
  set_long(
    "你走入一个曲折的回廊中，地上铺著暗红色的石板，略生青苔的石墙上，左
右各有一扇五角型洞窗，往窗外望去，可看见整理得井然有序的庭院，木制的廊
檐雕刻著精细的雕花，檐边垂著几枝绿柳，显得生意盎然．\n");
  set("light", 1);
  set("exits", ([ "northeast": YROOM "room23",
    "northwest": YROOM "room29" ]));
  //        set( "objects", ([
  //                                                        ]) );
  reset();
}
