#include <yogor.h>

inherit ROOM;

void create() {
  ::create();
  set_short("洗尘道");
  set_long(
    "你走在幽皇殿的殿前大道上，两侧高耸入云的苍松，和五彩缤纷的奇花异草，
走在其中感受著清风徐徐，混杂著松香和花香，令人无比舒畅，地上铺著精致的
铺地，虽然年代有些久远，但仍显得富丽堂皇．\n");
  set_outside("yogor");
  set("light", 1);
  set("exits", ([ "south": YROOM "room3",
    "north": YROOM "room22" ]));
  //        set( "objects", ([
  //                                                        ]) );
  reset();
}
