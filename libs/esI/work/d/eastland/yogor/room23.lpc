#include <yogor.h>

inherit ROOM;

void create() {
  ::create();
  set_short("幽皇殿广场");
  set_long(
    "这里遍地铺著大理石的四方铺地，中央的地方以七彩鹅卵石构成一巨大的龙
型图案，一步进这里，宽广的视野和壮阔的铺地令你顿时震摄於此美景．南方通
往殿前大道，另外三个方向各通往三个大殿．\n");
  set_outside("yogor");
  set("light", 1);
  set("exits", ([ "south": YROOM "room22",
    "southwest": YROOM "room28",
    "southeast": YROOM "room24",
    "northwest": YROOM "room32" ]));
  set("objects", ([ "guard1": YMOB "royalguard",
    "guard2": YMOB "royalguard" ]));
  reset();
}
