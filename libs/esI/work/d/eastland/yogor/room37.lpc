#include <yogor.h>

inherit ROOM;

void create() {
  ::create();
  set_short("书房");
  set_long(
    "你看到一张枣木书桌摆在房间的右侧，桌上摆著文房四宝，桌面的一角还有
一个盆栽，但你分辨不出来种的是什麽，桌上还有一个纸镇，亮晶晶的，似乎是
宝石制的．一张水墨画挂在正面墙上，你走过去瞧瞧，画的是黄山苍松云海，气
势磅礴，令你驻足良久，房间左侧有一书柜，陈列著数十本书，一个小童正在用
扫子清理这间书房．\n");
  set("light", 1);
  set("exits", ([ "east": YROOM "room36" ]));
  set("objects", ([ "boy": YMOB "boy" ]));
  reset();
}
void init() {
  add_action("do_search", "search");
}
int do_search(string arg, object ob1) {
  if (!arg || arg != "shelf" || arg != "书架")
    return notify_fail("找哪里? \n");
  if (!present("boy")) {
    write("你不知从何找起．\n"); return 1;
  } else {
    if (this_player()->query_temp("finding") != 9) {
      write("小童生气的说: 去去去..不要妨碍我打扫．\n"); return 1;
    }
    tell_object(this_player(), " 你从书架上找到了那本魔法大全．\n");
    ob1 = new(YOBJ "book");
    ob1->move(this_player());
    return 1;
  }
}
