#include <yogor.h>

inherit ROOM;

void create() {
  ::create();
  set_short("巡捕房");
  set_long(
    "走进巡捕房，你感觉到有些透不过气来，严肃的气氛略带杀气弥漫在空气中，
一些武器，刑具，排列在墙边，公差们盯著你，好像你犯了什麽罪似的，令你大
气也不敢喘一口．这里就是令恶人闻风丧胆的'幽冥捕房'．麻雀虽小，但幽国城
能屹立至今，此处可是一大功臣呢!!! \n");
  set_outside("yogor");
  set("light", 1);
  set("exits", ([ "north": YROOM "room10" ]));
  set("objects", ([ "police": YMOB "police",
    "captain1": YMOB "captain1",
    "captain2": YMOB "captain2" ]));
  reset();
}
