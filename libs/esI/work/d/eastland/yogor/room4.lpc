#include <yogor.h>

inherit ROOM;
inherit SELLER;

void create()
{
        ::create();
        set_short("养生堂");
        set_long(
"养生堂的堂主乃是多年前由少林出来寻药材的药王殿僧，因遇战事而逃入了
幽国城，而後凭他找到的药材及其医药知识，在此开了一家药铺．然而当你走进
店中时，却发现它似乎没有对外营业，而门外往来的痕迹让你不禁怀疑是否有甚
麽秘密隐藏其中．\n"
        );
        set( "light", 1 );
        set( "exits",(["east":YROOM"room5",
                       "south":YROOM"room10"]) );
        reset();
}
