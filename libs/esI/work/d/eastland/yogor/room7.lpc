#include <yogor.h>
#include <money.h>

inherit ROOM;
inherit SELLER;

void create() {
  ::create();
  set_short("修竹阁");
  set_long(
    "步入阁中，你看到周围摆著许多种类的竹子盆栽，如孟宗，墨竹，从竹型的
漏窗望出去，还可看见庭院内种植著大片金丝竹．由此可知，此阁之主是位爱竹
之人．另外，修竹阁的竹叶青，也是吸引爱酒之人前来的诱因．店小二忙里忙外
的招呼著，阵阵酒香使你不饮而醺．你可以向阁主要一份菜单(menu)来看．\n"
  );

  set("light", 1);
  set("exits", ([ "south": YROOM "room13" ]));
  set("objects", ([ "host": YMOB "host",
    "drunk": "/d/noden/farwind/monster/drunk" ]));
  set_inventory(({
    ({ YOBJ "ching.lpc", 10, 10 }),
    ({ YOBJ "mao.lpc", 10, 10 }),
    ({ YOBJ "red.lpc", 10, 10 }),
    ({ YOBJ "gou.lpc", 10, 10 }),
    ({ YOBJ "roast.lpc", 10, 10 }),
    ({ YOBJ "special.lpc", 10, 10 }),
  }));
  reset();
}
void init() {
  seller::init();
}
void reset() {
  room::reset();
  seller::reset();
}
