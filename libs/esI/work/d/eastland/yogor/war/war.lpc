// war.c
// This daemon controls the wars in the mud. 
// By Annihilator@Eastern.Stories (1-22-94)

#define YMOB "/d/eastland/yogor/mob/"
#define YROOM "/d/eastland/yogor/"
#define NG "/d/eastland/yogor/room1"
#define WG "/d/eastland/yogor/room8"
#define SG "/d/eastland/yogor/room20"

mapping attackers = ([
  YROOM "room14": ({ YMOB "chang",
    YMOB "small_bandit",
    YMOB "small_bandit" }),
  YROOM "room7": ({ YMOB "wei" }),
  YROOM "room18": ({ YMOB "shan" }),
  YROOM "room13": ({ YMOB "yan",
    YMOB "small_bandit" }),
  YROOM "room12": ({ YMOB "jau",
    YMOB "small_bandit" }),
]);

int on_war;
object *army;

void create() {
  seteuid(getuid());
}

void announce(string msg) {
  object *usr;
  int i;

  usr = users();
  for (i = 0; i < sizeof(usr); i++) {
    if (!environment(usr[i])) continue;
    tell_object(usr[i], set_color(msg, "HIR", usr[i]));
  }
}

void start_war() {
  string *loc;
  int i, j;
  object ob, room;

  if (on_war) return;
  loc = keys(attackers);
  army = ({});
  on_war = 1;
  call_out("check_war", 300);
  announce(
    "\n\n忽然．．．你听到一声炮响！！ 震碎了幽国城附近的宁静！！\n"
    "宋江大喊：孩儿们，向幽国城抽税的时间到了！！冲啊！\n\n");
  //关三个门
  find_object(YROOM "room1");
  find_object(YROOM "room8");
  find_object(YROOM "room20");
  NG->set("exits", ([ "south": YROOM "room2" ]));
  SG->set("exits", ([ "north": YROOM "room19" ]));
  WG->set("exits", ([ "east": YROOM "room9" ]));

  // Clone the attackers and put them to the pre-defined rooms.
  for (i = 0; i < sizeof(loc); i++) {
    if (!(j = sizeof(attackers[loc[i]]))) continue;
    // Find the room to put.
    room = find_object(loc[i]);
    if (!room) call_other(loc[i], "???");
    room = find_object(loc[i]);
    if (!room) continue;

    tell_room(room,
      "你看到一群山贼冲了过来！\n");
    while (j--) {
      ob = new(attackers[loc[i]][j]);
      ob->move(room);
      army += ({ ob });
    }
  }
  for (i = 0; i < sizeof(army); i++)
    army[i]->enable_war();
}


void check_war() {
  // Remove those victims in the war.
  army -= ({ 0 });
  if (!sizeof(army)) {
    announce("\n宋江叫道:可恶! 下次一定要血洗幽国城 !!\n"
      "**** 幽国城恢复安宁了*****\n");
    on_war = 0;
    //开门
    find_object(YROOM "room1");
    find_object(YROOM "room8");
    find_object(YROOM "room20");
    NG->set("exits", ([ "south": YROOM "room2",
      "north": "/d/eastland/4,14.east" ]));
    SG->set("exits", ([ "north": YROOM "room19",
      "south": "/d/eastland/4,16.east" ]));
    WG->set("exits", ([ "east": YROOM "room9",
      "west": "/d/eastland/3,15.east" ]));
    return;
  }
  call_out("check_war", 60);
}
