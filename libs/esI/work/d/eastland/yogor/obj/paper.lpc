#include "mudlib.h"

inherit OBJECT;

void create() {
  set_name("little paper", "一张小纸片");
  set_short("小纸片");
  set_long(
    "一张小小的纸片，上面写著满满的字。\n"
  );
  set("no_sale", 1);
  set("unit", "张");
  set("weight", 5);
  set("value", ({ 1, "copper" }));
}

void init() {
  add_action("read_paper", "read");
}

int read_paper(string str) {
  object ob;
  if (!str || str != "paper") return 0;
  else {
    ob = environment(this_object());
    if (ob != this_player())
      return 0;
    else {
      tell_object(ob, "上面写著一些奇怪的文句，大概是秘密用语．\n");
      return 1;
    }
  }
}
