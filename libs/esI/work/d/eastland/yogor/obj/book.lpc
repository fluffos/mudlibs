#include "mudlib.h"

inherit OBJECT;

void create() {
  set_name("magic book", "一本魔法大全");
  set_short("魔法大全");
  set_long(
    "一本厚厚的魔法全书。\n"
  );
  set("no_sale", 1);
  set("unit", "本");
  set("weight", 5);
  set("value", ({ 1, "silver" }));
}

void init() {
  add_action("read_paper", "read");
}

int read_paper(string str) {
  object ob;
  if (!str || str != "book") return 0;
  else {
    ob = environment(this_object());
    if (ob != this_player())
      return 0;
    else {
      tell_object(ob, set_color("突然迷情赤子伸手盖住你刚要打开的书，笑著对你说: 孩子，这对你来说太深奥了．\n", "HIG"));
      return 1;
    }
  }
}
