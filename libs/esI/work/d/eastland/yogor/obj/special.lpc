#include <mudlib.h>

#define LIMIT_TIME 10
inherit OBJECT;

void init() {
  add_action("quaff_potion", "drink");
}

void create() {
  set_name("special", "青竹丝泡酒");
  add("id", ({ "special" }));
  set_short("青竹丝泡酒");
  set_long("这是修竹阁特制的青竹丝泡酒,有特殊的功\效喔！！\n");
  set("unit", "杯");
  set("weight", 15);
  set("value", ({ 180, "silver" }));
  call_out("drink_it", LIMIT_TIME, this_object());
}

int quaff_potion(string arg) {
  if (!arg || arg != "special") return 0;

  write(
    "你喝下一杯青竹丝泡酒。感到精神好了一些。\n"
  );
  tell_room(environment(this_player()),
    this_player()->query("c_name") + "喝下一杯青竹丝泡酒，精神看起来好了一些!!\n", this_player()
  );
  this_player()->receive_healing(8 + random(5));
  remove();
  return 1;
}
