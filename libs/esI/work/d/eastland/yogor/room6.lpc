#include <yogor.h>

inherit SHOP;

void create() {
  ::create();
  set_short("揖峰商行");
  set_long(
    "这商行早在幽国城刚建时就有了，纵然历经多次战争仍屹立不摇，信誉卓著
使其成为南东方大陆旅者的最爱．店小二在柜台後微笑的招呼你，不厌其详的介
绍店里的东西．\n"
  );
  set("light", 1);
  set("exits", ([ "west": YROOM "room5",
    "south": YROOM "room12" ]));
  storeroom()->set("objects", ([
    "torch#0": "/obj/torch",
    "bandage#0": "/obj/bandage",
    "bag#0": "/obj/bag",
  ]));
  reset();
}
