#include <yogor.h>

inherit ROOM;

void create()
{
        ::create();
        set_short("听枫园");
        set_long( 
"这里是名闻遐迩的听枫园餐厅，主厨乃是四大御厨之一的郭寻，相传他是烹
调大师黄蓉的子孙，这里的名菜可是令人垂涎三丈呢！！不过要想□到郭大厨亲
手调制的菜，你得打通关节外加预定呢！走进这里，阵阵菜香令你四肢酥软，彷
佛饿了十数天似的．你非得叫一道菜来尝尝不可．\n");
        set( "light", 1 );
        set( "exits", (["north":YROOM"room13"
                                                         ]) );
        set( "objects", (["waiter":YMOB"waiter"]) );
        reset();
}
