#include <yogor.h>

inherit ROOM;

void create() {
  ::create();
  set_short("客房");
  set_long(
    "一间朴素，整理得有条不紊的客房，供给来晋见城主的一般使节之用，也让
一些来游学习武的年轻学梓停留．\n");
  set("light", 1);
  set("exits", ([ "north": YROOM "room29" ]));
  set("objects", ([ "samurai": YMOB "samurai" ]));
  reset();
}
