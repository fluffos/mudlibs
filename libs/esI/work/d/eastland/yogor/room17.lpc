#include <yogor.h>
#include <money.h>

inherit ROOM;
inherit "/std/exchange";

void create()
{
        room::create();
        set_short("银行");
        set_long(
"这里是南东方大陆的金融中心，往来的商人旅客为避免遭劫，常在此将现金藉银行
之手汇到其他各处，未有户头者也可在此以25元金币的代价开户(open account)，另外
银行也受理转换钱币(convert)的业务．\n");
        set_outside( "yogor" );
        set( "light", 1 );
        set( "exits", (["north":YROOM"room12",
                        "west":YROOM"room16" ]) );
        set("objects", (["captain":YMOB"captain4"]) );
        reset();
}
