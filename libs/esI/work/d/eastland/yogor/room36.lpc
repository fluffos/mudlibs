#include <yogor.h>

inherit ROOM;

void create()
{
        ::create();
        set_short("後院小路");
         set_long(
"刚走进这里，你感到一阵清凉和有些阴暗，仔细一瞧，这儿种了许多参天古
木和茂密竹丛，阳光几乎照不进来，阴暗和潮湿的空气使得小道上的石板长满了
青苔，走在上面你得小心不要滑倒了，西边竹林间隐隐约约有一间竹屋，不知是
做什麽用的，北边有一大殿．\n");
        set_outside( "yogor" );
        set( "light", 1 );
        set( "exits", (["west":YROOM"room37",
                        "north":YROOM"room38",
                        "southeast":YROOM"room35" ]) );
//        set( "objects", ([
 //                                                        ]) );
        reset();
}
