#include <mudlib.h>

inherit ARMOR;

void create() {
  set_name("green jade amulet", "青玉符");
  add("id", ({ "green", "amulet" }));
  set_short("青玉符");
  set_long("一块用透青宝玉制成的玉符，上面刻有一些篆文：元始乾坤．\n");
  set("unit", "块");
  set("type", "misc");
  set("material", "elemental");
  set("weight", 20);
  set("no_sale", 1);
  set("defense_bonus", 4);
  set("special_defense", ([ "electric": -20, "fire": 10, "magic": 30 ]));
  set("value", ({ 60, "gold" }));
}
