#include "yogor.h"

inherit ARMOR;

void create()
{   
      set_name("chilin cloth","麒麟衣");
      add("id",({"cloth"}) );
      set_short("麒麟衣");
      set_long("一件丝织的蓝色衣裳, 上面绣著一只绿色的麒麟．\n");
      set("unit","件");
      set("type","body");
      set("weight",65);
      set("no_sale",1);
      set("material","cloth");
      set("armor_class",25);
      set("defense_bonus",6);
      set("value",({400,"gold"}) );
}
      

   
