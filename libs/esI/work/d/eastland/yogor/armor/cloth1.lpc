#include "yogor.h"

inherit ARMOR;

void create() {
  set_name("green cloth", "碧竹袍");
  add("id", ({ "green", "cloth" }));
  set_short("碧竹袍");
  set_long("这件袍子闪著碧绿色的光芒，背後绣著劲竹凌风的图样，用碧天蚕丝编织而成，穿起来轻柔温润，还可反弹轻武器的攻击．是一件宝衣．\n");
  set("unit", "件");
  set("type", "body");
  set("weight", 100);
  set("no_sale", 1);
  set("material", "cloth");
  set("armor_class", 18);
  set("defense_bonus", 6);
  set("special_defense", ([ "cold": 10, "fire": -25, "evil": 15, "divine": -25, "magic": 25 ]));
  set("extra_stats", ([ "piety": -1 ]));
  set("value", ({ 200, "gold" }));
}
