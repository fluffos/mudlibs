#include "yogor.h"

inherit ARMOR;

void create()
{   
      set_name("white chrysanthemum robe","白菊武袍");
      add("id",({"robe"}) );
      set_short("白菊武袍");
      set_long("一件绣著一朵大黄菊花的白色武袍．\n");
      set("unit","件");
      set("type","body");
      set("weight",85);
      set("material","cloth");
      set("armor_class",25);
      set("defense_bonus",5);
      set("special_defense",(["cold":10,"evil":20,"divine":-20]) );
      set("value",({400,"gold"}) );
}
      

   
