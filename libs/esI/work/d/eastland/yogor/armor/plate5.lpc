#include <mudlib.h>

inherit ARMOR;

void create()
{
            set_name("leaf gold plate","柳叶贯金甲");
            add("id",({"leaf","plate"}) );
            set_short("柳叶贯金甲");
             set_long("由许多如柳叶般的铁片附在精铁灌金打造的铁甲上，构成一件防御力非凡的战甲．\n");
            set("unit","件");
            set("type","body");
            set("material","light_metal");
            set("weight",370);
            set("armor_class",33);
            set("defense_bonus",3);
            set("special_defense",(["none":18]) );
            set("value",({300,"gold"}) );
}
