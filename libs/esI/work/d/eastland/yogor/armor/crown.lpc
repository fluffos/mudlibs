#include "yogor.h"

inherit ARMOR;

void create()
{   
      set_name("gold crown","王冠");
      add("id",({"crown"}) );
      set_short("金王冠");
      set_long("一顶纯金打造的王冠．\n");
      set("unit","顶");
      set("type","head");
      set("weight",40);
      set("no_sale",1);
      set("material","light_metal");
      set("armor_class",7);
      set("defense_bonus",2);
      set("special_defense",(["cold":10]) );
      set("value",({400,"gold"}) );
}
      

   
