#include "yogor.h"

inherit ARMOR;

void create()
{   
      set_name("dragon scale shield","龙甲挡");
      add("id",({"shield"}) );
      set_short("龙甲挡");
      set_long("一个用巨龙的一片龙鳞制成的挡牌．\n");
      set("unit","个");
      set("type","shield");
      set("weight",100);
      set("no_sale",1);
      set("material","light_metal");
      set("armor_class",6);
      set("special_defense",(["none":15]));
      set("extra_skills",(["block":10]) );
      set("value",({100,"gold"}) );
}
      

   
