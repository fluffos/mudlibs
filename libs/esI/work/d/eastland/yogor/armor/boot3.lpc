#include <mudlib.h>

inherit ARMOR;

void create()
{
            set_name("iron beast boots","冷铁□猊靴");
            add("id",({"iron","boots"}) );
            set_short("冷铁□猊靴");
            set_long("一双用特殊锻铁制成，用金镀上猛兽□猊的图案，看来颇为凶猛．\n");
            set("unit","双");
            set("type","feet");
            set("material","heavy_metal");
            set("weight",100);
            set("armor_class",8);
            set("value",({150,"gold"}) );
} 
