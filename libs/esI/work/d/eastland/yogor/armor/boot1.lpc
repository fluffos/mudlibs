#include <mudlib.h>

inherit ARMOR;

void create()
{
          set_name("shuan-ji boots","玄机履");
          add("id",({"boots"}) );
          set_short("玄机履");
          set_long("一双皂色的布履，上以红线绣上几个金钮，两鞋各用银丝线绣上一字:〔玄〕，〔机〕．\n");
          set("unit","双");
          set("type","feet");
          set("material","cloth");
          set("weight",45);
          set("no_sale",1);
          set("armor_class",7);
          set("defense_bonus",2);
          set("value",({50,"gold"}) );
          set("extra_skills",(["sneak":6]) );
}
