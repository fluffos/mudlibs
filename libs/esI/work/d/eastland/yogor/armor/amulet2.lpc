#include <mudlib.h>

inherit ARMOR;

void create()
{
            set_name("beast heart_protect amulet","狴犴掩心镜");
            add("id",({"beast","amulet"}) );
            set_short("狴犴掩心镜");
            set_long("刻有奇兽狴犴图腾的护心宝镜．\n");
            set("unit","面");
            set("type","misc");
            set("material","heavy_metal");
            set("weight",70);
            set("defense_bonus",4);
            set("value",({100,"gold"}) );
}
