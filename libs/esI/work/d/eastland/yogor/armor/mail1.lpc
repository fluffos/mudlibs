#include "yogor.h"

inherit ARMOR;

void create() {
  set_name("steel chainmail", "钢锁子甲");
  add("id", ({ "chainmail", "mail" }));
  set_short("钢锁子甲");
  set_long("纯钢制成的严密锁子甲，是幽国城守卫的制式装备．\n");
  set("unit", "件");
  set("type", "body");
  set("weight", 200);
  set("material", "heavy_metal");
  set("armor_class", 24);
  set("defense_bonus", 3);
  set("special_defense", ([ "cold": -5, "fire": 5, "none": 3 ]));
  set("value", ({ 500, "silver" }));
}
