#include "yogor.h"

inherit ARMOR;

void create()
{   
      set_name("cloud silk leggings","邀月护胫");
      add("id",({"leggings"}) );
      set_short("邀月护胫");
      set_long("一对有李白力量加护的护胫．\n");
      set("unit","对");
      set("type","legs");
      set("weight",50);
      set("material","cloth");
      set("armor_class",6);
      set("defense_bonus",2);
      set("value",({100,"gold"}) );
}
      

   
