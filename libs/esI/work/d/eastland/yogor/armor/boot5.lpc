#include <mudlib.h>

inherit ARMOR;
 
void create()
{
            set_name("green cloud boots","翠云锦跟靴");
            add("id",({"green","cloud","boots"}) );
            set_short("翠云锦跟靴");
            set_long("一双绣著彩云和缤纷图样的靴子，穿上它让你有步花乘云的感觉．\n");
            set("type","feet");
            set("material","leather");
            set("weight",85);
            set("armor_class",6);
            set("defense_bonus",1);
            set("value",({110,"gold"}) );
}
