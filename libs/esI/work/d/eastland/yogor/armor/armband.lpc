#include "yogor.h"

inherit ARMOR;

void create() {
  set_name("platinum armband", "白金臂环");
  add("id", ({ "armband" }));
  set_short("白金臂环");
  set_long("一个白金打造的雕纹臂环．\n");
  set("unit", "个");
  set("type", "arms");
  set("weight", 30);
  set("no_sale", 1);
  set("material", "heavy_metal");
  set("armor_class", 4);
  set("defense_bonus", 4);
  set("value", ({ 400, "gold" }));
}
