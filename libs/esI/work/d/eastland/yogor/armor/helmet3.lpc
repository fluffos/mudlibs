#include <mudlib.h>
inherit ARMOR;

void create() {
  set_name("iron hat", "浑铁四方帽");
  add("id", ({ "hat" }));
  set_short("iron hat", "浑铁四方帽");
  set_long(
    "这是用镔铁铸成的方帽，如果再黑一点就很像毕业典礼用的那种． \n"
  );
  set("unit", "顶");
  set("type", "head");
  set("material", "light_metal");
  set("armor_class", 6);
  set("defense_bonus", 2);
  set("special_defense",
    ([ "none": 5 ]));
  set("weight", 70);
  set("value", ({ 100, "gold" }));
}
