#include <mudlib.h>

inherit ARMOR;

void create() {
  set_name("dragon tiger cloak", "龙虎战袍");
  add("id", ({ "dragon", "tiger", "cloak" }));
  set_short("龙虎战袍");
  set_long("一件绣有云中青龙图案的虎皮战袍，披上它真显得威风八面．\n");
  set("unit", "件");
  set("type", "cloak");
  set("material", "leather");
  set("weight", 150);
  set("armor_class", 3);
  set("defense_bonus", 6);
  set("special_defense", ([ "magic": 20 ]));
  set("value", ({ 200, "gold" }));
}
