#include <mudlib.h>

inherit ARMOR;

void create() {
  set_name("iron heart_protect amulet", "裹金生铁掩心");
  add("id", ({ "iron", "amulet" }));
  set_short("裹金生铁掩心");
  set_long("用参金生铁打造的掩心护镜．\n");
  set("unit", "面");
  set("type", "misc");
  set("material", "heavy_metal");
  set("weight", 35);
  set("defense_bonus", 4);
  set("value", ({ 40, "gold" }));
}
