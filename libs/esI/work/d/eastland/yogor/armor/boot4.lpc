#include <mudlib.h>

inherit ARMOR;

void create()
{
            set_name("cloud boots","嵌线云跟靴");
            add("id",({"cloud","boots"}) );
            set_short("嵌线云跟靴");
            set_long("这是一双嵌著银丝线，有绣著云形图案的鞋跟，穿起来颇舒服的兽皮靴．\n");
            set("unit","双");
            set("type","feet");
            set("material","leather");
            set("weight",80);
            set("armor_class",6);
            set("defense_bonus",2);
            set("value",({100,"gold"}) );
}
