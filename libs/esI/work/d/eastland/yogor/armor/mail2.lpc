#include "yogor.h"

inherit ARMOR;

void create() {
  set_name("steal mail", "钢战甲");
  add("id", ({ "mail" }));
  set_short("钢战甲");
  set_long("一件纯钢打造的战甲，是幽皇城皇家守卫的制式装备．\n");
  set("unit", "件");
  set("type", "body");
  set("weight", 250);
  set("material", "heavy_metal");
  set("armor_class", 25);
  set("defense_bonus", 3);
  set("value", ({ 100, "gold" }));
}
