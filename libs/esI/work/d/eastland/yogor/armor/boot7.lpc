#include "yogor.h"

inherit ARMOR;

void create() {
  set_name("steel boots", "钢靴");
  add("id", ({ "boots", "boot" }));
  set_short("钢靴");
  set_long("一双钢制的靴子，是幽皇城皇家守卫的制式装备．\n");
  set("unit", "双");
  set("type", "feet");
  set("weight", 50);
  set("material", "heavy_metal");
  set("armor_class", 4);
  set("value", ({ 50, "gold" }));
}
