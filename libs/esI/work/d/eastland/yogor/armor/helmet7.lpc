#include "yogor.h"

inherit ARMOR;

void create()
{   
      set_name("iron helmet","铁头盔");
      add("id",({"iron","helmet"}) );
      set_short("铁头盔");
      set_long("一顶铁制的头盔，是幽国城守卫的制式装备．\n");
      set("unit","顶");
      set("type","head");
      set("weight",80);
      set("material","heavy_metal");
      set("armor_class",4);
      set("defense_bonus",1);
      set("value",({200,"silver"}) );
}
      

   
