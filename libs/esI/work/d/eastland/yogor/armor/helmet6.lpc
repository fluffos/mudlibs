#include <mudlib.h>

inherit ARMOR;

void create()
{
            set_name("red hood","乾红凹面巾");
            add("id",({"red","hood"}) );
            set_short("乾红凹面巾");
            set_long("一顶深红色的头巾．\n");
            set("unit","顶");
            set("type","head");
            set("material","cloth");
            set("weight",30);
            set("armor_class",3);
            set("defense_bonus",3);
            set("value",({50,"gold"}) );
}
