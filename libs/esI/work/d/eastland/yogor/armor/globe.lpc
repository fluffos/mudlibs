#include "yogor.h"

inherit ARMOR;

void create() {
  set_name("force globe", "原力护盾");
  add("id", ({ "globe" }));
  set_short("原力护盾");
  set_long("一个能产生一个原力保护力场的圆球．\n");
  set("unit", "个");
  set("type", "globe");
  set("weight", 300);
  set("material", "mage");
  set("armor_class", 40);
  set("defense_bonus", 15);
  set(
    "special_defense",
    ([
      "evil": -10,
      "divine": 30,
      "none": 10,
      "electric": 30,
      "magic": -40,
      "energy": 20,
      "mental": -20
    ])
  );
  set("extra_stats", ([ "int": -1 ]));
  set("value", ({ 200, "gold" }));
}
