#include "yogor.h"

inherit ARMOR;

void create()
{   
      set_name("thunder gloves","雷动手套");
      add("id",({"gloves"}) );
      set_short("雷动手套");
      set_long("一双有雷神力量加护的手套．\n");
      set("unit","双");
      set("type","hands");
      set("weight",40);
      set("material","cloth");
      set("armor_class",5);
      set("defense_bonus",3);
      set("extra_skills",(["parry":3]) );
      set("value",({50,"gold"}) );
}
      

   
