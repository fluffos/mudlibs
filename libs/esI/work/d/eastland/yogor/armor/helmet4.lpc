#include <mudlib.h>
inherit ARMOR;

void create() {
  set_name("black silk-hood", "皂纱簇花巾");
  add("id", ({ "hood", "silk-hood", "black" }));
  set_short("black silk-hood", "皂纱簇花巾");
  set_long(
    "A beautiful black silk hood .\n",
    "这是一顶黑纱头巾，乌黑亮丽，闪闪动人． \n"
  );
  set("unit", "顶");
  set("type", "head");
  set("material", "cloth");
  set("armor_class", 5);
  set("defense_bonus", 2);
  set("special_defense",
    ([ "fire": 3, "acid": 5, "mental": 2 ]));
  set("weight", 50);
  set("value", ({ 106, "gold" }));
}
