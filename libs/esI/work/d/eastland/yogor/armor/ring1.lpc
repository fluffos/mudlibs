#include <mudlib.h>

inherit ARMOR;

void create() {
  set_name("chian-kun ring", "乾坤戒");
  add("id", ({ "ring" }));
  set_short("乾坤戒");
  set_long("这只戒指看起来晦暗无光，但彷佛有一种魔力拢罩在戒指四周，产生一股力量保护著你．\n");
  set("unit", "只");
  set("type", "finger");
  set("material", "stone");
  set("weight", 15);
  set("no_sale", 1);
  set("defense_bonus", 4);
  set("special_defense", ([ "magic": 30, "fire": 20, "cold": -30, "evil": 20, "divine": -30 ]));
  set("value", ({ 60, "gold" }));
}
