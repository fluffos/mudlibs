#include "yogor.h"

inherit ARMOR;

void create()
{   
      set_name("cop's uniform","捕快制服");
      add("id",({"uniform"}) );
      set_short("捕快制服");
      set_long("一件幽皇城捕快的制服．\n");
      set("unit","件");
      set("type","body");
      set("weight",80);
      set("material","cloth");
      set("armor_class",20);
      set("defense_bonus",3);
      set("value",({20,"gold"}) );
}
      

   
