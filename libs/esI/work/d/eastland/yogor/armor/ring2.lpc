#include "yogor.h"

inherit ARMOR;

void create()
{   
      set_name("emperor's ring","皇者之戒");
      add("id",({"ring"}) );
      set_short("皇者之戒");
      set_long("一只闪著彩光的钻戒, 凝视它时, 一种深沈的感觉透过你的双眼, 似乎一股力量加护其上．\n");
      set("unit","只");
      set("type","finger");
      set("weight",20);
      set("no_sale",1);
      set("material","elemental");
      set("defense_bonus",5);
      set("special_defense",(["none":30]) );
      set("value",({400,"gold"}) );
}
      

   
