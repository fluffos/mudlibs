#include "yogor.h"

inherit ARMOR;

void create() {
  set_name("short combat robe", "短武服");
  add("id", ({ "robe" }));
  set_short("短武服");
  set_long("一件练习用的武斗服．\n");
  set("unit", "件");
  set("type", "body");
  set("weight", 100);
  set("material", "cloth");
  set("armor_class", 20);
  set("defense_bonus", 5);
  set("value", ({ 30, "gold" }));
}
