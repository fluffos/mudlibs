#include "yogor.h"

inherit ARMOR;

void create() {
  set_name("golden boots", "金织履");
  add("id", ({ "boots", "boot" }));
  set_short("金织履");
  set_long("一双金丝线织成的柔软布鞋．\n");
  set("unit", "双");
  set("type", "feet");
  set("weight", 45);
  set("material", "cloth");
  set("armor_class", 6);
  set("defense_bonus", 3);
  set("value", ({ 100, "gold" }));
}
