#include <mudlib.h>

inherit ARMOR;

void create() {
  set_name("cloud pheonix helmet", "九云凤翅盔");
  add("id", ({ "cloud", "helmet" }));
  set_short("九云凤翅盔");
  set_long("一顶雕有云形，两侧有凤翅，薄金铸铁制成的头盔．\n");
  set("unit", "顶");
  set("type", "head");
  set("material", "light_metal");
  set("weight", 80);
  set("armor_class", 6);
  set("defense_bonus", 1);
  set("special_defense", ([ "magic": 20 ]));
  set("value", ({ 200, "gold" }));
}
