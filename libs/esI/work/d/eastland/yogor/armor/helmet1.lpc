#include <mudlib.h>

inherit ARMOR;

void create() {
  set_name("cloud crane crown", "云鹤冠");
  add("id", ({ "cloud", "crown" }));
  set_short("云鹤冠");
  set_long("此银白色的冠呈白鹤展翅的形状，戴上此冠，颇有一飞冲天之势．\n");
  set("unit", "顶");
  set("type", "head");
  set("weight", 150);
  set("no_sale", 1);
  set("material", "light_metal");
  set("armor_class", 6);
  set("defense_bonus", 3);
  set("value", ({ 100, "gold" }));
}
