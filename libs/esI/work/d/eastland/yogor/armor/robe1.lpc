#include "yogor.h"

inherit ARMOR;

void create() {
  set_name("dragon robe", "龙袍");
  add("id", ({ "robe" }));
  set_short("幽皇龙袍");
  set_long("一件金黄色的丝织长袍,上面绣著一只五爪金龙．\n");
  set("unit", "件");
  set("type", "body");
  set("weight", 70);
  set("no_sale", 1);
  set("material", "cloth");
  set("armor_class", 26);
  set("defense_bonus", 6);
  set("special_defense", ([ "cold": 10, "evil": 10 ]));
  set("value", ({ 400, "gold" }));
}
