#include "yogor.h"

inherit ARMOR;

void create() {
  set_name("steal helmet", "钢战盔");
  add("id", ({ "helmet" }));
  set_short("钢战盔");
  set_long("一顶纯钢打造的战盔，是幽皇城皇家守卫的制式装备．\n");
  set("unit", "顶");
  set("type", "head");
  set("weight", 80);
  set("material", "heavy_metal");
  set("armor_class", 5);
  set("value", ({ 50, "gold" }));
}
