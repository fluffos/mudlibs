#include "yogor.h"

inherit ARMOR;

void create() {
  set_name("golden hairpin", "束发金簪");
  add("id", ({ "hairpin" }));
  set_short("束发金簪");
  set_long("一个纯金打造的发簪．\n");
  set("unit", "个");
  set("type", "head");
  set("weight", 30);
  set("no_sale", 1);
  set("material", "light_metal");
  set("armor_class", 6);
  set("defense_bonus", 1);
  set("value", ({ 400, "gold" }));
}
