#include "yogor.h"

inherit ARMOR;

void create() {
  set_name("wind boots", "风行靴");
  add("id", ({ "boots", "boot" }));
  set_short("风行靴");
  set_long("一双有风神力量加护的靴子．\n");
  set("unit", "双");
  set("type", "feet");
  set("weight", 45);
  set("material", "cloth");
  set("armor_class", 6);
  set("defense_bonus", 2);
  set("extra_skills", ([ "dodge": 3 ]));
  set("value", ({ 100, "gold" }));
}
