#include <mudlib.h>

inherit ARMOR;

void create()
{
            set_name("copper heart_protect amulet","青铜护心镜");
            add("id",({"copper","amulet"}) );
            set_short("青铜护心镜");
            set_long("一面青铜打造的护心镜，看来有些年代，但防护力似乎还不错．\n");
            set("unit","面");
            set("type","misc");
            set("material","heavy_metal");
            set("weight",30);
            set("defense_bonus",4);
            set("value",({50,"gold"}) );
}
