#include <mudlib.h>
inherit ARMOR;

void create() {
  set_name("floral cloth", "绯红团花战袍");
  add("id", ({ "cloth", "floral" }));
  set_short("floralcloak", "绯红团花战袍");
  set_long(
    "This is a red cloak with some floral mark.\n",
    "一件双层绯红的战袍，绣了许\多美丽的花纹．\n"
  );
  set("unit", "件");
  set("type", "body");
  set("material", "cloth");
  set("armor_class", 24);
  set("defense_bonus", 6);
  set("weight", 100);
  set("value", ({ 1000, "silver" }));
}
