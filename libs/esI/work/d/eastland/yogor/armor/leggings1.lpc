#include "yogor.h"

inherit ARMOR;

void create() {
  set_name("golden puttee", "金丝绑腿");
  add("id", ({ "leggings", "puttee" }));
  set_short("金丝绑腿");
  set_long("一双用金丝缠绕牛皮制成的绑腿．\n");
  set("unit", "双");
  set("type", "legs");
  set("weight", 60);
  set("material", "light_metal");
  set("armor_class", 8);
  set("defense_bonus", 2);
  set("value", ({ 100, "gold" }));
}
