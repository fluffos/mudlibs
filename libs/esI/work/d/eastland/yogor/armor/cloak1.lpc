#include <mudlib.h>
inherit ARMOR;

void create() {
  set_name("beast cloak", "云霞绛红袍");
  add("id", ({ "cloak", "cape" }));
  set_short("beast cloak", "云霞绛红袍");
  set_long(
    "一件大红的毛皮披风，上面有云霞图案．\n"
  );
  set("unit", "件");
  set("type", "cloak");
  set("material", "leather");
  set("armor_class", 5);
  set("defense_bonus", 4);
  set("special_defense", ([ "none": 3, "magic": 4 ]));
  set("weight", 90);
  set("value", ({ 1300, "silver" }));
}
