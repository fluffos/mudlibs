#include <mudlib.h>

inherit ARMOR;

void create()
{
    set_name("purple cloth","紫绣团花战袍");
    add("id",({"purple","cloth"}) );
    set_short("紫绣团花战袍");
	set_long(
		"This is a platemail with beautiful marks....\n",
		"这是一件美丽的战袍，胸前绣满了美丽的图案，令人心旷神怡，你觉\n"
		"得拥有它的人必定是个很有品味的人．\n"
	);
	set( "unit", "件" );
	set( "weight", 130 );
	set( "type", "body" );
	set( "armor_class", 24 );
        set("material","cloth");
	set( "defense_bonus", 5 );
	set( "value", ({ 103, "gold" }) );
}
