#include <mudlib.h>

inherit ARMOR;

void create()
{
             set_name("hang boots","吊墩靴");
             add("id",({"hang","boots"}) );
             set_short("吊墩靴");
             set_long("一双形如倒吊桥墩的布靴．\n");
             set("unit","双");
             set("type","feet");
             set("material","cloth");
             set("weight",45);
             set("armor_class",5);
             set("defense_bonus",2);
             set("value",({50,"gold"}) );
}
