#include <yogor.h>

inherit ROOM;
inherit SELLER;

void create() {
  ::create();
  set_short("养生堂");
  set_long(@C_LONG_DESCRIPTION
    一进这里，你恍然大悟，原来养生堂是秘密营业，大概是避免遭匪徒侵
入利用吧，墙上有一张牛皮纸(paper)，标示著所贩卖的药品和价钱．
C_LONG_DESCRIPTION
  );
  set("light", 1);
  set("item_func", ([ "paper": "show_menu" ]));
  set("exits", ([ "east": YROOM "room5",
    "south": YROOM "room10" ]));
  set_inventory(({
    ({ "/obj/bandage", 60, 60 }),
    ({ "/d/eastland/easta/obj/spicy_plaster", 40, 40 }),
    ({ "/d/eastland/easta/obj/green_pill", 50, 50 }),
    ({ "/d/eastland/easta/obj/small_pill", 30, 30 }),
    ({ "/d/eastland/liang_shan/obj/snow_lily", 5, 5 }),
    ({ YOBJ "black_plaster", 5, 5 })
  }));
  reset();
}
void reset() {
  room::reset();
  seller::reset();
}
