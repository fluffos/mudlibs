#include <yogor.h>

inherit ROOM;

void create()
{
        ::create();
        set_short("西殿");
        set_long(
"金色的琉璃瓦覆盖在殿顶，巨大的雕龙石柱耸立於四方，楹柱上藻饰著许多
花纹，地板上铺著白色的石板，大殿中央有一高台，台上有一张凤銮宝座，是皇
后接待贵宾或招见一些大臣时所坐的地方，左右各有一个偏门通往内殿，门边写
著：非经通报，请勿入内．\n"); 
        set( "light", 1 );
        set( "exits", (["northeast":YROOM"room29"]) );
        set( "objects", (["queen":YMOB"queen"]) );
        reset();
}
