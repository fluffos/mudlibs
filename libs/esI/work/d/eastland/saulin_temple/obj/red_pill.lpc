#include <mudlib.h>

inherit PILL;

void create()
{
	pill::create();
	set_name( "shou-lin pill", "玉灵散" );
	add( "id", ({ "pill" }) );
	set_short( "玉灵散" );
	set_long(
		"玉灵散乃少林内服治伤良药\n" 
	);
	set_healing( 40 );
	set( "no_sale", 1 );
	set( "weight", 5 );
	set( "value", ({ 10, "gold" }) );
	set( "medication", 35 );
	set( "effect_critical", 75 );
}
