#include <mudlib.h>

inherit OBJECT;

void create() {
  set_name("Hawk's Meat", "魔鹰的肉");
  add("id", ({ "hawk's meat", "meat" }));
  set_short("魔鹰的肉");
  set_long(@LONG
           从魔鹰身上取得的肉。
LONG
  );
  set("unit", "块");
  set("value", ({ 1, "silver" }));
  set("no_sale", 1);
  set("quest_dragon", 1);
  set("weight", 3);
}
