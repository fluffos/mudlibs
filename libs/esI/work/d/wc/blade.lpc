//这是。。。传说中的那把恐怖分子用的刀。。。想象中是快被KO了开始拼命。因为血已经很少所以要
//一段时间内敌人攻击无效。。。最高理想是各个工会原来都是大好人，然后被逼上梁山，加入一个
//新的工会，原来的技能保留，但是随着新工会里一些使人腐化的威力的影响，逐渐忘却自我。。。
//然后越陷越深。。成为一个绝对恶毒的组织，力量增加，但是越来越单一而且具有不确定性
//（比如命中率变低而伤害增加）而且攻击永远带毒。。。

#include <mudlib.h>


#define COST_HP 5
#define COST_ALI 1000
inherit WEAPON;



void create()

{


  set_name("blade of hell", "修罗刀");

  add("id", ({ "hell", "blade" }));

  set_short("blade of hell", "修罗刀");

  set_long(@C_LONG
这是达摩院首席虚渡大师最锺爱的兵器，相传它原本是某位江洋大盗的兵器，
不知道已经沾染了多少鲜血，虽然年年浸染佛门香火，但它体内蕴藏的邪恶力量似乎仍未平息...
C_LONG
  );

  set("type", "longblade");

  set("weapon_class", 35);

  set("min_damage", 20);

  set("max_damage", 37);

  set("weight", 200);

  set("value", ({ 755, "silver" }));

  set("no_sale", 1);

  set("wield_func", "sa_wield");
  set("unwield_func", "sa_unwield");
}


void init() {
  add_action("sacrifice_blood", "sacrifice_blood");
}

void sa_wield() {
  this_player()->set_temp("ready", 1);
  return;
}

void sa_unwield() {
  object holder;
  if (!holder = environment(this_object())) return;
  if ((int)this_object()->query("wc_damaged")) {
    tell_object(this_player(), "你手中的『弑』突然幻化为一条火龙消失不见了....\n");
    tell_room(environment(this_player()),
      this_player()->query("c_name") + "手中的『弑』突然幻化为一条火龙就消失了....\n",
      this_player());
    this_object()->remove();
    return;
  } else {

    if ((string)this_player()->query("class") == "monk" && (int)this_player()->query_level() > 14) {
      tell_object(holder, set_color(
        "\n你脱手後，『弑』身上的火光逐渐散去，刀身内的冥界力量又沉睡了...\n\n"
        , "HIR"));
      tell_room(environment(holder), set_color(
        "\n" + holder->query("c_name") + "手中『弑』的火红色豪光逐渐散去...\n\n"
        , "HIR"), holder);
      set("weapon_class", 35);
      set("min_damage", 20);
      set("max_damage", 37);
      set("prevent_drop", 0);
      delete("extra_look");
      set_name("blade of hell", "修罗刀");
      set_short("修罗刀");
    }
    this_player()->set_temp("ready", 0);
    return;
  }
}


string color() {
  return set_color("$N的手中握着一把杀气腾腾的黑色长刃，红色的烟雾正不断从刀身散发出来...\n", "HIR");
}

int sacrifice_blood() {
  int ali, hp;
  //        object me;

  //        me=this_player();
  ali = (int)this_player()->query("alignment");
  hp = (int)this_player()->query("hit_points");
  if (hp >= 10 || hp <= COST_HP)
    return notify_fail("你的生命力并未处在适当的状态。\n");
  //   这里设置knight不能用是因为忘了“不是monk”怎么写。。。
  if ((string)this_player()->query("class") == "knight" || (int)this_player()->query_level() <= 15)
    return notify_fail("这样的事情只有高僧能做啦！\n");
  if ((int)this_player()->query_temp("ready") == 0 || !this_player()->query_temp("ready"))
    return notify_fail("你最好先把它装备起来...\n");

  set("prevent_drop", 1);
  //   这里可以模仿healer的poison技能里的命令加毒。。。。
  set("weapon_class", 95);
  set("min_damage", 720);
  set("max_damage", 935);
  set("extra_look", "@@color");
  this_player()->set("hit_points", hp - COST_HP);
  this_player()->set("alignment", ali - COST_ALI);
  tell_object(this_player(), set_color(
    "\n你用仅有的鲜血注入『修罗刀』刀柄的宝石，解开了修罗力量的封印...\n\n"
    , "HIR"));
  tell_room(environment(this_player()), set_color(
    "\n" + this_player()->query("c_name") +
    "把鲜血注入手中的『修罗刀』，只见刀身发出耀眼的火光，召唤出冥界的毁灭力量...\n\n"
    , "HIR"), this_player());
  set_name("Blade of Hate", set_color("『弑』", "HIR"));
  set_short(set_color("『弑』", "HIR"));
  return;
}
