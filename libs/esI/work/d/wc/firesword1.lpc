#include <mudlib.h>
#include <daemons.h>
inherit WEAPON;

void create() {
  set_name("red sword", "炎之刃");
  add("id", ({ "longsword", "sword" }));
  set_short("炎之刃");
  set_long(@C_LONG
这是一把用魔法火焰制作而成的火红色长剑，
如果和拥有无畏勇气的人相感应，就能换化成强力的攻击武器。
C_LONG
  );
  set("unit", "柄");
  set("second", 1);
  set("weapon_class", 35);
  set("type", "longblade");
  set("max_damage", 5);
  set("min_damage", 10);
  set("weight", 100);
  set("value", ({ 1000, "silver" }));
  set("special_damage", 80);
  set("wield_func", "daemon_wield");
  set("unwield_func", "daemon_unwield");
}

void daemon_wield() {
  if ((string)this_player()->query("class") == "knight" || (string)this_player()->query("class") == "scholar") {
    set("prevent_drop", 1);
    set("weapon_class", 95);
    set("min_damage", 720);
    set("max_damage", 935);
    set("extra_look", "@@color");
    tell_object(this_player(), set_color(
      "\n『炎之刃』感应到你无畏的勇气，而发出耀眼的红色豪光，幻化成一把长剑...\n\n"
      , "HIR"));
    tell_room(environment(this_player()), set_color(
      "\n" + this_player()->query("c_name") +
      "手中的『炎之刃』突然发出耀眼的火光，化成一把长剑...\n\n"
      , "HIR"), this_player());
    set_name("fire sword", "『火烧云』");
    set_short("『火烧云』");
    return;
  }
  return;
}

void daemon_unwield() {
  object holder;
  if (!holder = environment(this_object())) return;
  if ((int)this_object()->query("wc_damaged")) {
    tell_object(this_player(), "你手中的『火烧云』突然幻化为一条火龙消失不见了....\n");
    tell_room(environment(this_player()),
      this_player()->query("c_name") + "手中的『火烧云』突然幻化为一条火龙就消失了....\n",
      this_player());
    this_object()->remove();
    return;
  } else {
    set("weapon_class", 35);
    set("min_damage", 5);
    set("max_damage", 10);
    set("prevent_drop", 0);
    delete("extra_look");
    if ((string)holder->query("class") == "knight" || (string)holder->query("class") == "scholar") {
      tell_object(holder, set_color(
        "\n你脱手後，『火烧云』身上的火光逐渐散去，恢复成泛着可爱蓝色光茫的长剑，...\n\n"
        , "HIB"));
      tell_room(environment(holder), set_color(
        "\n" + holder->query("c_name") + "手中『火烧云』的火红色豪光逐渐散去...\n\n"
        , "HIB"), holder);
    }
    set_name("red sword", "炎之刃");
    set_short("炎之刃");
    return;
  }
}

string color() {
  return set_color("$N的手中缠绕着火红色的长剑样龙形气息...\n", "HIR");
}

int weapon_hit(object victim, int damage) {
  object owner;
  int my_pie, vic_pie, sp, dam;

  owner = this_player();
  sp = owner->query("spell_points");
  if (sp < 1) return 0;
  my_pie = (int)owner->query_stat("pie");
  vic_pie = (int)victim->query_stat("pie");
  if (random(my_pie * 8) < vic_pie * 2) return 0;
  if (!(dam = (int)query("special_damage"))) return 0;
  owner->set("spell_points", sp - 1);
  if ((int)owner->query_skill("longblade") < 95) {
    tell_object(owner,
      "\n你勉强挥动『火烧云』火焰所幻成的炎龙反蚀了自己.\n\n");
    tell_room(environment(owner),
      "\n" + owner->query("c_name") + "的火烧云火焰所幻成的炎龙反蚀了自己
.\n\n",
      owner);
    owner->receive_special_damage("divine", dam);
    return dam;
  }

  tell_object(owner, set_color(
    "\n你的『火烧云』挥出一道火焰，幻成一条炎龙向你的敌人扑去。\n\n", "HIR"));
  tell_room(environment(owner),
    "\n" + owner->query("c_name") + "的『火烧云』挥出一道火焰，幻成一条炎龙向敌人扑去。\n\n"
    , owner);
  victim->receive_special_damage("divine", dam);
  return dam;
}
