//忘了是从什么改的了，目的是用"skill"命令使自己skill加满（给wiz测试方便啦）
//不知道哪里出了bug，帮忙改改啦...

#include <mudlib.h>

inherit OBJECT;

void create() {
  set_name("skill book", "葵花宝典");
  set_short("葵花宝典");
  set_long("一本破破烂烂的武林密籍，所用的纸都发黄了...\n"
    "它的封面上写着：神啊，赐予我技能吧！(skillful)\n"
    "你不禁有试一试的冲动...\n"
  );
  add("id", ({ "book", "skill" }));
  set("unit", "本");
  set("weight", 10);
  set("value", ({ 400, "silver" }));
}

void init() {
  add_action("skill", "skill");
}

int skill() {
  this_player()->set_skill("unarmed", 100);
  this_player()->set_skill("identify", 100);
  this_player()->set_skill("consider", 100);
  //这里因为有许多skill，准备分开做几个void,然后用call other连接分段执行
  return 1;
}
