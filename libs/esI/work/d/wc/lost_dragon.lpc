#include <mudlib.h>

inherit MONSTER;
inherit MOUNT;

void create() {
  ::create();
  set_level(1);
  set("forgetful", 1);
  set_name("lost dragon", set_color("迷路的金色雷龙", "HIY"));
  add("id", ({ "lost dragon", "dragon" }));
  set_short(set_color("迷路的金色雷龙", "HIY"));
  set_long(@C_LONG
这是一只胖嘟嘟的金色雷龙，但是它好像迷路了，正无助地望着你。
C_LONG
  );
  set("unit", "只");
  set_perm_stat("str", 16);
  set_perm_stat("dex", 17);
  set_perm_stat("int", 13);
  set("natural_min_damage1", 15);
  set("natural_max_damage1", 25);
  set("max_hp", 1500);
  set("hit_points", 500);
  set("max_load", 2500);
  set_natural_armor(70, 28);
  set_natural_weapon(80, 10, 25);
  set("alignment", 500);
  set("exp_reward", 6000);

  set("tactic_func", "cry");
  set("chat_output", ({ "金宝宝哭道：我要回家...谁来帮帮我啊...\n" }));
  set("chat_chance", 40);
  set("mountable", 0);

  set_c_verbs(({ "%s凶猛地向%s一口咬去", "%s迅速地扑向%s" }));
  set_c_limbs(({ "的头", "的身体", "的脚" }));
  set("inquiry", ([
    "help": "@@ask_help",
  ]));
  //	set("c_death_msg","%s说：主人，请接受我的效忠！说著说著化成一面盾牌....\n");
  //       set("alt_corpse","/d/zeq/shield1");   
}

void init() {
  mount::init();
}

void hungry(object who) {
  tell_object(who, "你突然想起学校的自然课本上写着：雷龙是食肉的...");
  this_object()->kill_ob(who);
  who->kill_ob(this_object());
  return;
}

int cry() {
  object victim;

  if (random(20) > 4 || !(victim = query_attacker())) return 0;
  tell_room(environment(this_object()),
    "金宝宝说：小心我叫我爸爸来收拾你！\n"
    "说完就在你身上狠狠地咬了一口！\n",
    this_object());
  victim->receive_damage(30);
  return 1;
}

int accept_item(object who, object item) {
  if (!item->query("quest_dragon")) {
    tell_room(environment(),
      "金宝宝叹了口气，捏着鼻子把" + item->query("c_name") + "吃了下去。\n");
  } else {
    tell_room(environment(), "金宝宝眼睛一亮，一口就把" + item->query("c_name") + "吞了下去。\n");
    set("mountable", 1);
    set("chat_chance", 0);
    tell_object(who, "你现在可以骑金宝宝了，快把它带回家吧！\n");
  }
  item->remove();

  return 1;
}

int ask_help(object who) {
  if ((int)who->query_level() < 5) {
    command("sigh " + who->query("name"));
    write("然后说: 你还小, 帮不了我忙的!\n");
    return 1;
  } else {
    tell_object(who, @LONG
     金宝宝用一种奇怪的眼神盯着你，咽了一下口水。
     金宝宝说：我的家在悬崖边的大森林里哦。
LONG
    );
    call_out("hungry", 3, who);
    return 1;
  }
  return 1;
}
