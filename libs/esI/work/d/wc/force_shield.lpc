//由wind_shield改
//加fp用，值现在很BT
//需要std/condition里fp的增减补丁
//同样给scholar与monk(有fp嘛)
//由force effect决定ac,db(力图强调内功等级的作用，这样才有人争武林宝典，嘎嘎)

#include <mudlib.h>

inherit ARMOR;

mapping origin_fp;
void create()
{
    set_name("Force Shield","原力盾");
    add("id",({"shield"}));
    set_short("无形的原力盾");
    set_long(@LONG
据传说这是东方一位伟大的武者用毕生修为铸造的原力盾，可与武者的内力呼应，而变化大小。
LONG
            );
    set("unit","面");
    set( "power_on", 1);
    set("no_clean",1) ; 
    set("type","shield");
    set("material","cloth");
    set("armor_class",100);
    set("defense_bonus",100);
    set("special_defense",(["all":100,"none":100]) );
    set("weight",100);
    set("no_sale",1);
    set("value",({1500,"gold"}) );
    set("equip_func","daemon_wear");
    set("unequip_func","daemon_unwear");
}



void daemon_wear()
{
    int fe,addi;
      if( !(int)this_player()->query("force_effect") || 
           (int)this_player()->query("force_effect")==0  ){
      addi=200;  
        }
        else{
      fe=(int)this_player()->query("force_effect");
      addi=fe*100 + 200;
      }
    if( (string)this_player()->query("race")=="daemon" ||
        (string)this_player()->query("class")=="scholar"  ||
        (string)this_player()->query("class")=="monk"   ) {
      if( (int)this_player()->query_level() < 4){
        tell_object( this_player(),
        "你的修为尚不足以使盾将原力防护伸展出来....\n");
        }
        else{
    set("prevent_drop",1);
    set("armor_class",addi);
    set("defense_bonus",addi);
    set("light",1);
    set("extra_look","@@color");
    set("special_defense",(["all":50,"none":30]) );
    write( set_color(
       "\n原力盾呼应著你的内力，从你的身体里逐渐伸展出一道障壁，把你托起在球体防护中央...\n\n"
       ,"HIW") );
    tell_room( environment(this_player()),set_color(
       "\n原力盾缓缓的在"+this_player()->query("c_name")+
       "的身前身后“长”出球状防护层.........\n\n"
       ,"HIY"),this_player() );
    set_name("Force Field","原 力 场");
    set_short("原 力 场");
    origin_fp=this_player()->query("conditions/_heal_fp");
    this_player()->set("conditions/_heal_fp" , ({ 10, 100 }));
        }
    return;
    } 
    return;
}

void daemon_unwear()
{
	object holder;
	if ( !this_object() ) return ;
	if ( !holder=environment(this_object()) ) return;
    holder=this_player();
    if( (int)holder->query_level() >= 4){
    set("armor_class",100);
    set("defense_bonus",100);
    set("light",0);
    delete("extra_look");
    set("prevent_drop",0);
    if( (string)holder->query("race")=="daemon"  ||
        (string)holder->query("class")=="scholar"  ||
        (string)holder->query("class")=="monk" ) {
    tell_object( holder,set_color(
       "\n你脱手後，周围的无形防护缓缓的收拢，恢复成平凡的一个金属小球...\n\n"
       ,"HIW") );
    tell_room( environment(holder),set_color(
       "\n"+holder->query("c_name")+
       "周围的无形防护缓缓的收拢，变成一个平凡的金属小球...\n\n"
       ,"HIW"),holder );
    };
    set_name("Force Shield","原力盾");
    set_short("无形的原力盾");
    this_player()->set("conditions/_heal_fp", origin_fp); 
    return;
    }
    else return;
}                 

string color()
{ 
  return set_color("漂浮在原力防护中央的$N身影在你眼前缓缓升起，仿佛凌驾于万物之上...\n","HIY");
}