#include <mudlib.h>
inherit MONSTER ;

void create ()
{
        ::create();
        set("exp_reward",60000);
        set_level(19);
        set_name( "gold dragon", set_color("成年金色雷龙","HIY") );
        add ("id", ({ "dragon" }) );
        set_short(set_color("成年金色雷龙","HIY"));
        set("unit", "位");
        set("alignment",-2000);
        set("weight",2000);
        set("wealth/gold",1000);
        set_long(@C_LONG
它是一只十分凶残的雷龙，它曾经残杀无数的生灵，曾有无数的勇者死於其手。
C_LONG
        );
        set_perm_stat("int", 30);
        set_perm_stat("str", 30);
        set_perm_stat("dex", 30);
        set_perm_stat("kar", 30);
        set_perm_stat("pie", 30);
        set_perm_stat("con", 30);
        set("max_hp",2500);
        set("hit_points",2500);
        set_natural_weapon( 95, 50, 80 );
        set_natural_armor( 100, 70 );
//	set("unbleeding",1);
        set("special_defense",
        	([ "cold" : 90, "fire" : 70, "all" : 70 , "none" : 80 ]));
        set_skill("dodge",70);
        set("tactic_func","special_attack");
        set_c_limbs(({"身体","头部","脚部","手臂"}));
        set_c_verbs(({"%s用它的利爪向%s抓去","%s伸出它那长满利牙的嘴巴向%s咬去" }));                
}
       
int special_attack()
{// 20% use it! damage 40-70.
    object env,*inv,*victim;
    int i;
    env=environment(this_object());
    inv=all_inventory(env);
    if(random(10)<8) return 0;
    tell_room( environment( this_object() ), 
      "雷龙用它的尾巴，掀飞周围的树木，无数断木向每一个人砸去。\n",
      this_object()
    );
    i = sizeof(inv);
    while(i--) {
      if (inv[i]!=this_object()) 
        {
           inv[i]->receive_damage(random(30)+40);
           "/d/magic/magic"->report( this_object(), inv[i] );
        }
    }
    return 1;
}

void die()
{
    
    object ob1,ob2;
    
    ob1=query("last_attacker");
    tell_object(ob1,
"龙爸爸的声音从树林里远远地传了过来：恭喜你通过考验！我现在\n"
"正式把孩子托付给你，希望你以后好好地照顾它！\n");
    ob2=new("/d/u/w/whitecoffee/quest/jinlei");
    ob2->move(environment(this_player()));
  ::die(0);
}
