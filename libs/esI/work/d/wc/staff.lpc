//从firesword改。。。
//看也看出了吧，很BT的东东...可以一手一个。。。

#include <mudlib.h> 
#include <daemons.h>

inherit WEAPON;



void create()

{
    
    set_name( "iron staff", "粗铁杖");
    
    add ("id",({ "staff"}) );
    
    set_short( "iron staff", "粗铁杖");
    
    set("unit", "把");
    
    set_long(
     
       @C_LONG
这把粗铁杖外表黝黑没有光泽，还发出一股逼人的寒气，看起来十分沈重，
据说是由千年玄铁铸造而成。
C_LONG
 
            );
    
    set( "weapon_class", 25);
    
    set( "type", "bo");
    
    set( "min_damage", 25);
    
    set( "max_damage", 47);

    set( "second", 1);    
    set( "weight",80 );
    
    set( "value", ({ 3800, "silver" }) );
    set("wield_func","monk_wield");
    set("unwield_func","monk_unwield");
        set( "special_damage", 80 );
}



void monk_wield()
{
    if( (string)this_player()->query("class")=="monk") {
    set("prevent_drop",1);
    set("weapon_class",95);
    set("min_damage",720);
    set("max_damage",935);
    set("extra_look","@@color");
    tell_object( this_player(),set_color(
       "\n杖中的『般若心』感应到你无量的胸怀，渐渐变得通体透明...\n\n"
       ,"HIW") );
    tell_room( environment(this_player()),set_color(
       "\n"+this_player()->query("c_name")+
       "手中的铁杖渐渐变得通体透明了...\n\n"
       ,"HIW"),this_player() );
    set_name("holy staff","『般若虚空』");
    set_short("『般若虚空』");
    return;
    }
}

void monk_unwield()
{
	object holder ;
	if ( !holder = environment(this_object()) ) return;
    if( (int)this_object()->query("wc_damaged") ){
         tell_object( this_player(),"你手中的『般若虚空』突然幻化为一片光晕消失不见了....\n");
         tell_room( environment(this_player()),
           this_player()->query("c_name")+"手中的『般若虚空』突然幻化为一片光晕就消失了....\n",
           this_player() );
           this_object()->remove();
           return;
           }	
    else{
    set("weapon_class",25);
    set("min_damage",25);
    set("max_damage",47);
    set("prevent_drop",0);
    delete("extra_look");
    if( (string)holder->query("class")=="monk") {
    tell_object( holder,set_color(
       "\n你脱手後，『般若虚空』身上的光芒逐渐暗淡，恢复成原来的粗铁杖，...\n\n"
       ,"HIC") );
    tell_room( environment(holder),set_color(
       "\n"+holder->query("c_name")+"手中『般若虚空』的恢复成平凡的粗铁杖...\n\n"
       ,"HIC"),holder );
    };
	set_name( "iron staff","粗铁杖" );
        set_short("粗铁杖" );    
    return ;
    }
}                 

string color()
{
    return set_color("$N双手间一片光芒中似有一条铁杖样的幻影...\n","HIC");
}

int weapon_hit( object victim, int damage )
{
	object owner;
        int my_pie,vic_pie,sp,dam;

	owner = this_player();
        sp=owner->query("spell_points");
        if ( sp < 1 ) return 0;
        my_pie = (int)owner->query_stat("pie");
        vic_pie =(int)victim->query_stat("pie");
        if( random(my_pie*8) < vic_pie*2 ) return 0;
        if( !(dam = (int)query("special_damage")) ) return 0;
        owner->set("spell_points",sp-1);
        if ((int)owner->query_skill("bo")<95) {
          tell_object(owner,
              "\n你勉强挥动『般若虚空』所幻成的吸力反蚀了自己.\n\n");
          tell_room(environment(owner),
              "\n"+owner->query("c_name")+"的火烧云火焰所幻成的炎龙反蚀了自己
.\n\n",
              owner );
          owner->receive_special_damage("divine",dam);
          return dam;
        }

          tell_object(owner,set_color(
           "\n你手持『般若虚空』结阵，强大的吸力使敌人无法站稳。\n\n","HIW"));
          tell_room(environment(owner),
            "\n"+owner->query("c_name")+"手持『般若虚空』结阵，强大的吸力使敌人无法站稳。\n\n" 
            , owner );
           victim->receive_special_damage("divine",dam);
           return dam; 
}
