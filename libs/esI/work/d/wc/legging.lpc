//这个是由流云改出来的，计划是自动加HP而减FP
//要实现FP增减需要在std/condition里面照着其它的样子加一个fp增减的文件。
//穿的时候由force effect决定ac,db
//现在属性很ＢＴ。。。
//给monk与scholar的哦

#include <mudlib.h>



inherit ARMOR;



mapping origin_hp, origin_fp, origin_sp;
void create()

{

  set_name("red leggings", "鲜红色的胫甲");

  add("id", ({ "leggings" }));

  set_short("鲜红色的胫甲");

  set_long(

    "这件胫甲通体鲜红，据说是武者与魔界交易的工具。\n"

  );

  set("unit", "件");

  set("type", "legs");

  set("material", "cloth");

  set("armor_class", 6);

  set("defense_bonus", 4);

  set("special_defense", ([ "all": 100, "none": 100 ]));

  set("weight", 70);

  set("no_sale", 1);
  set("value", ({ 250, "gold" }));

  set("extra_stats", ([ "dex": 4, "str": 4, "pie": 4, "kar": 4 ]));
  set("equip_func", "daemon_wear");
  set("unequip_func", "daemon_unwear");
}








void daemon_wear() {
  int fe, addi;
  if (!(int)this_player()->query("force_effect") ||
    (int)this_player()->query("force_effect") == 0) {
    addi = 50;
  } else {
    fe = (int)this_player()->query("force_effect");
    addi = fe * 100 + 200;
  }
  if ((string)this_player()->query("race") == "daemon" ||
    (string)this_player()->query("class") == "scholar" ||
    (string)this_player()->query("class") == "monk") {
    if ((int)this_player()->query_level() < 4) {
      tell_object(this_player(),
        "你的修为尚不足以与魔界沟通....\n");
    } else {
      set("prevent_drop", 1);
      set("armor_class", addi);
      set("defense_bonus", addi);
      set("light", 1);
      set("extra_look", "@@color");
      set("special_defense", ([ "all": 100, "none": 100 ]));
      write(set_color(
        "\n你穿上鲜红色的胫甲，忽然感到一种血腥的气息在体内蔓延...\n\n"
        , "HIR"));
      tell_room(environment(this_player()), set_color(
        this_player()->query("c_name") +
        "穿上鲜红色的胫甲，它的表面竟慢慢地开始渗出鲜血.........\n\n"
        , "HIR"), this_player());
      set_name("Blood Drain", "血 魇 狂 魔");
      set_short("血 魇 狂 魔");
      this_player()->set("alignment", (int)this_player()->query("alignment") - 100);
      origin_hp = this_player()->query("conditions/_heal_hp");
      this_player()->set("conditions/_heal_hp", ({ 3, 170 }));
      origin_fp = this_player()->query("conditions/_heal_fp");
      this_player()->set("conditions/_heal_fp", ({ 10, 100 }));
      origin_sp = this_player()->query("conditions/_heal_sp");
      this_player()->set("conditions/_heal_sp", ({ 10, 150 }));
    }
    return;
  }
  return;
}

void daemon_unwear() {
  object holder;
  if (!this_object()) return;
  if (!holder = environment(this_object())) return;
  holder = this_player();
  if ((int)holder->query_level() >= 4) {
    set("armor_class", 100);
    set("defense_bonus", 100);
    set("light", 0);
    delete("extra_look");
    set("prevent_drop", 0);
    if ((string)holder->query("race") == "daemon" ||
      (string)holder->query("class") == "scholar" ||
      (string)holder->query("class") == "monk") {
      tell_object(holder, set_color(
        "\n你脱下血 魇 狂 魔，体内的邪恶之气也停止了扩散，又恢复了原来的样子...\n\n"
        , "HIR"));
      tell_room(environment(holder), set_color(
        "\n" + holder->query("c_name") +
        "的血 魇 狂 魔停止向外渗血了...\n\n"
        , "HIR"), holder);
    };
    set_name("red leggings", "鲜红色的胫甲");
    set_short("鲜红色的胫甲");
    this_player()->set("conditions/_heal_hp", origin_hp);
    this_player()->set("conditions/_heal_fp", origin_fp);
    this_player()->set("conditions/_heal_sp", origin_sp);
    return;
  } else return;
}

string color() {
  return set_color("$N的周围笼罩着一股邪恶的血腥之气...\n", "HIR");
}
