#include <mudlib.h>

inherit MONSTER;
inherit MOUNT;

void create() {
  ::create();
  set_level(1);

  set_name("golden dragon", set_color("金色雷龙", "HIY"));
  add("id", ({ "golden dragon", "dragon" }));
  set_short(set_color("金色雷龙", "HIY"));
  set_long(@C_LONG
这是一只胖嘟嘟的金色雷龙，脖子上挂着一个牌子，上面写着：我是金宝宝，请不要欺负我。
C_LONG
  );
  set("unit", "只");
  set_perm_stat("str", 16);
  set_perm_stat("dex", 17);
  set_perm_stat("int", 13);
  set("natural_min_damage1", 15);
  set("natural_max_damage1", 25);
  set("max_hp", 1500);
  set("hit_points", 1500);
  set("max_load", 2500);
  set_natural_armor(70, 28);
  set_natural_weapon(80, 10, 25);
  set("alignment", 500);
  set("exp_reward", 6000);

  set_c_verbs(({ "%s凶猛地向%s一口咬去", "%s迅速地扑向%s" }));
  set_c_limbs(({ "的头", "的身体", "的脚" }));
  //	set("c_death_msg","%s说：主人，请接受我的效忠！说著说著化成一面盾牌....\n");
  //       set("alt_corpse","/d/zeq/shield1");   
}

void init() {
  add_action("hit_enemy", "hit");
  mount::init();
}

int hit_enemy(string arg) {
  object owner, target;
  int rid, deb, dod, dam;

  owner = environment(this_object());

  if (!living(owner))
    return notify_fail("金宝宝不听你的指挥。\n");
  if (!arg) return notify_fail("你想咬谁？\n");
  if (!target = present(arg, environment(owner)))
    return notify_fail("这里没有那种东西。\n");
  if (arg == (string)owner->query("name"))
    return notify_fail("金宝宝看看三个月没洗澡的你，把头别了过去。\n");
  if (!living(target))
    return notify_fail("金宝宝狠狠地咬了"
      +target->query("c_name") + "一口，但是" + target->query("c_name") + "跟死猪似的没什么反应。\n");
  if (!visible(target, owner))
    return notify_fail("你想咬谁？\n");
  if (!owner->query_vision())
    return notify_fail("这里一片漆黑 ! 你什麽也看不到 !!\n");
  if (target->query("no_attack"))
    return notify_fail("这家伙－不能杀。\n");
  if (userp(target) && (int)target->query_level() < 5)
    return notify_fail("金宝宝狠狠地瞪了你一眼。\n");
  if ("berserk" == (string)owner->query("tactic"))
    return notify_fail("你必须换另一种战术。\n");
  if ("melee" == (string)owner->query("tactic"))
    return notify_fail("你必须换另一种战术。\n");
  if ("flank" == (string)owner->query("tactic"))
    return notify_fail("你必须换另一种战术。\n");
  if ((int)owner->query("talk_points") < 30)
    return notify_fail("你想命令金宝宝攻击敌人，张了张口却发现说不出话来。\n");
  if ((int)target->query("hit_points") < 50)
    return notify_fail("金宝宝似乎不愿意攻击快死的敌人。\n");

  if (target->query_temp("dodge_hit")) {
    tell_object(owner,
      "\n你命令金宝宝朝对方咬去, 但是敌人闪过了!\n\n");
    tell_object(target,
      "\n金宝宝张开大嘴向你咬来, 但是你闪过了!\n\n");
    tell_room(owner,
      owner->query("c_name") + "的金宝宝咬向" + target->query("c_name") + "\n\n",
      ({ owner, target }));
    owner->add("talk_points", -10);
    target->kill_ob(owner);
    owner->kill_ob(target);
    return 1;
  } else {
    rid = (int)owner->query_skill("riding");
    deb = (int)target->query("defense_bonus");
    dod = (int)target->query_skill("dodge");
    dam = rid / 2 - deb / 5 - random(dod) / 10;
    tell_object(owner,
      "\n你命令金宝宝向对方咬去, 敌人哀嚎着开始反击！\n\n");
    tell_object(target,
      "\n金宝宝一口咬住你的屁股, 你痛得连声大叫！\n\n");
    tell_room(owner,
      owner->query("c_name") + "的金宝宝咬向" + target->query("c_name") + "\n\n",
      ({ owner, target }));
    owner->add("talk_points", -30);
    target->add("hit_points", -dam);
    target->kill_ob(owner);
    owner->kill_ob(target);
    target->set_temp("dodge_hit", 1);
    return 1;
  }
  return 1;
}
