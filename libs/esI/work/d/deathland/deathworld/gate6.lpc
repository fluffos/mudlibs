// pdyx创建于公元2002年8月20日

#include <mudlib.h>
#include <move.h>
inherit ROOM;

int key_present = 1;
void create() {
  ::create();
  set_short("狭长的甬道");
  set_long(@LONG_DESCRIPTION
黑色的甬道，黑漆漆的一片，你什么都看不见，什么都看不清楚。
你提心吊胆的走着，鞋底走在路面发出喀嚓喀嚓的声音，好象踩
在骨头上一样。右边墙壁传来阵阵滴水的声音。
LONG_DESCRIPTION
  );

  //	set( "light", 1 );	
  set("objects", ([
    "yskeleton": "/d/deathland/deathworld/npc/yskeleton",
    "skeleton#1": "/d/deathland/deathworld/npc/skeleton",
    "skeleton#2": "/d/deathland/deathworld/npc/skeleton",
    "skeleton#3": "/d/deathland/deathworld/npc/skeleton",
    "skeleton#4": "/d/deathland/deathworld/npc/skeleton"
  ]));
  set("exits", ([
    "southeast": "/d/deathland/deathworld/gate7",
    "north": "/d/deathland/deathworld/gate5"
  ]));
  set("item_func", ([
    "pool": "look_pool" ]));
  reset();
}

void look_pool() {
  object key;

  if (!key_present)
    write(
      "这是一个有半人高的小水池，里面的水清澈见底。\n"
    );
  else {
    write(@ALONG
这是一个有半人高的小水池，里面的水清澈见底。
你发现水池的底部好象有个人的手掌，你伸手一探，将手掌从水池中那了起来。
ALONG
    );
    key_present = 0;
    key = new("/d/deathland/deathworld/obj/hand_key");
    if ((int)key->move(this_player()) != MOVE_OK)
      key->move(this_object());
    this_player()->set_explore("noden#24");
  }


}

void reset() {
  ::reset();
  key_present = 1;
}
