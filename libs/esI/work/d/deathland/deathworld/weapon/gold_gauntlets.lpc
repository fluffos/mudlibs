// pdyx创建于公元2002年8月20日
#include <mudlib.h>

inherit ARMOR;

string C_NAME="[33;1m金手套[37;0m";

void create()
{
	set_name( "gold gauntlets", C_NAME );
	add( "id", ({ "gauntlets" }) );
	set_short( C_NAME );
	set_long(
		"一双金色手套。\n"
	);
	set( "unit", "双" );
	set( "type", "hands" );
	set( "material", "knight" );
	set( "armor_class", 5 );
	set( "weight", 80 );
	set( "value", ({ 210, "gold" }) );
	set( "no_sale", 1);
}