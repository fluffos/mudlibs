// pdyx创建于公元2002年8月20日

#include <mudlib.h>

inherit WEAPON;
string name() { return set_color("Gold sword", "HIY"); }
string short() { return set_color("金色长剑", "HIY"); }
void create() {
  set_name("@@name", "金色长剑』");
  add("id", ({ "sword" }));
  set_short("@@short");
  set_long(
    "这是一把用千年的金精粹炼所铸成之剑，是金甲武士吃饭的家伙。\n");
  set("unit", "把");
  set("type", "longblade");
  set("second", 1);
  set("weight", 200);
  set("weapon_class", 45);
  set("min_damage", 10);
  set("max_damage", 30);
  set("special_damage", 40);
  set("value", ({ 500, "gold" }));
  set("no_sale", 1);

}
