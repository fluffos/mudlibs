// pdyx创建于公元2002年8月20日
#include <mudlib.h>

inherit ARMOR;

string C_NAME = "[33;1m金盔甲[37;0m";

void create() {
  set_name("gold platemail", C_NAME);
  add("id", ({ "plate", "platemail" }));
  set_short(C_NAME);
  set_long(
    "一套金色盔甲。\n"
  );
  set("unit", "套");
  set("type", "body");
  set("material", "knight");
  set("armor_class", 10);
  set("weight", 370);
  set("value", ({ 330, "gold" }));
  set("no_sale", 1);
}
