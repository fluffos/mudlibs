// pdyx创建于公元2002年8月20日
#include <mudlib.h>

inherit ARMOR;

string C_NAME = "[37;1m银盾[37;0m";

void create() {
  set_name("silver shield", C_NAME);
  add("id", ({ "shield" }));
  set_short(C_NAME);
  set_long(
    "一面银色盾牌。\n"
  );
  set("unit", "面");
  set("type", "shield");
  set("material", "knight");
  set("armor_class", 10);
  set("weight", 100);
  set("value", ({ 270, "gold" }));
  set("no_sale", 1);
}
