// pdyx创建于公元2002年8月20日
#include <mudlib.h>

inherit WEAPON;
string name(){ return set_color ("Silver sword","HIW");}
string short(){ return set_color ("银色长剑","HIW"); }
void create()
{
	set_name( "@@name", "银色长剑』" );
	add( "id", ({ "sword" }) );
	set_short( "@@short" );
	set_long(
   		"这是一把用千年的银精粹炼所铸成之剑，是银甲武士砍人的家伙。\n" );
	set( "unit", "把" );
	set( "type", "longblade" );
	set( "second", 1 );
	set( "weight", 200 );
	set( "weapon_class", 45 );
	set( "min_damage", 10 );
	set( "max_damage", 30 );
        set( "special_damage", 40 );
	set( "value", ({ 500, "gold" }) );
	set( "no_sale", 1 );

}

