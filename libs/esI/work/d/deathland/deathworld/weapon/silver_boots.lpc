#include  <mudlib.h>

inherit ARMOR;

string C_NAME="[37;1m银战靴[37;0m";

void create()
{
        set_name("silver boots", C_NAME);
        add( "id", ({ "boots" }) );
	set_short( C_NAME );
        set_long(
                "一双银色靴子。\n"
        );
        set( "unit", "双" );
        set( "type", "feet" );
        set( "material", "knight");
        set( "armor_class", 10 );
        set( "weight", 50 );
        set( "value", ({ 100, "gold" }) );
        set( "no_sale", 1); 
}