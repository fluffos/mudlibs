#include <mudlib.h>
inherit ROOM;

void create() {
  ::create();
  set_short("通向深渊的道路");
  set_long(@LONG_DESCRIPTION
天空的星光洒落在一条小路上，你凭着点点的星光勉强看得清楚周围的
环境。你看着不远处的北方，那里透出了一阵火光。“有人”！心里一
阵暗喜，不由得加快了脚步跑过去。
LONG_DESCRIPTION
  );

  set("light", 1);

  set("exits", ([
    "east": "/d/deathland/deathworld/path4",
    "north": "/d/deathland/deathworld/gate1"
  ]));
  reset();
}
