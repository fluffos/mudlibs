// pdyx创建于公元2002年8月20日
#include <mudlib.h>

inherit POTION;

void create() {
  potion::create();
  set_name("mikira potion", "恢复药水");
  add("id", ({ "potion" }));
  set_short("恢复药水");
  set_long(
    "这是恢复HP用的药水。你可以(drink potion)来使用。\n"
  );
  set_healing(30);
  set("no_sale", 1);
  set("unit", "瓶");
  set("weight", 20);
  set("value", ({ 100, "silver" }));
  set("medication", 5);
  set("effect_critical", 100);
}
