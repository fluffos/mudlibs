#include <mudlib.h>

inherit OBJECT;

void create() {
  set_name("Goldsoul", "黄金灵魂");
  set_short("黄金灵魂");
  set_long(
    @C_LONG
这是黄金武士的灵魂，破除黑色魔墙打开通向魔神殿大门的唯一凭证~
C_LONG
  );
  set("unit", "风");
  set("weight", 15);
  set("value", ({ 10, "silver" }));
  set("no_sale", 1);
}
