// pdyx创建于公元2002年8月20日
#include <mudlib.h>

inherit OBJECT;

void create() {
  set_name("altar key", "手骨匙");
  add("id", ({ "key" }));
  set_short("an altar key", "手骨匙");
  set_long(
    "这把钥匙拥有人手掌的形状，但是每根手指曾不同的弯曲。
不知道有什么作用。\n"
  );
  set("unit", "把");
  set("to_lock", "HAND_BONE_ENTRANCE");
  set("weight", 3);
  set("value", ({ 40, "silver" }));
  set("no_sale", 1);
}
