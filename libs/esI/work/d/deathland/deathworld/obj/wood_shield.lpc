// pdyx创建于公元2002年8月20日
#include <mudlib.h>

inherit ARMOR;

void create() {
  seteuid(getuid());
  set_name("wooden shield", "木盾");
  add("id", ({ "shield" }));
  set_short("木盾");
  set_long(
    "一面破破烂烂的木制盾牌，上面依稀还看得见原来画的一只张牙舞爪的龙。\n"
  );
  set("unit", "面");
  set("type", "shield");
  set("material", "wood");
  set("weight", 60);
  set("armor_class", 3);
  set("value", ({ 60, "silver" }));
}
