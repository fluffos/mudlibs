#include <mudlib.h>
inherit ROOM;

void create() {
  ::create();
  set_short("狭长的甬道");
  set_long(@LONG_DESCRIPTION
黑色的甬道，黑漆漆的一片，你什么都看不见，什么都看不清楚。
你提心吊胆的走着，鞋底走在路面发出喀嚓喀嚓的声音，好象踩
在骨头上一样。
LONG_DESCRIPTION
  );

  //	set( "light", 1 );
  set("c_item_desc", ([
    "wall": "
你凑近墙壁仔细的看了看，一股血腥味道扑面而来!\n" ]));

  set("objects", ([
    "bskeleton": "/d/deathland/deathworld/npc/bskeleton",
    "skeleton#1": "/d/deathland/deathworld/npc/skeleton",
    "skeleton#2": "/d/deathland/deathworld/npc/skeleton",
    "skeleton#3": "/d/deathland/deathworld/npc/skeleton",
    "skeleton#4": "/d/deathland/deathworld/npc/skeleton"
  ]));
  set("exits", ([
    "east": "/d/deathland/deathworld/gate4",
    "south": "/d/deathland/deathworld/gate6"
  ]));
  reset();
}
