// pdyx创建于公元2002年8月20日
#include <mudlib.h>

inherit MONSTER;

string short() { return set_color("黄色骷髅", "HIY"); }

void create() {
  object ob1, ob2;

  ::create();
  set_level(6);
  set_name("skeleton", "黄色骷髅");
  set_short("@@short");
  set_long(
    "这个骷髅的骨架是黄色的。和其他骷髅不同，似乎要厉害些。
看得出来 这骷髅生前一定是个骑士。它的右手提着一把破刀，左手拿了张破木盾
两眼闪着黄色的光芒。它似乎对冰有强烈的免疫能力。\n"
  );
  set("race", "undead");
  set_perm_stat("str", 6);
  set_skill("longblade", 40);
  set_skill("parry", 40);
  set_skill("block", 40);

  set("exp_reward", 700);
  set("tactic_func", "water");
  set("killer", 1);
  set("max_hp", 400);
  set("hit_points", 400);
  set("alignment", -100);
  set("natural_armor_class", 30);
  set("natural_weapon_class1", 10);
  set("natural_min_damage", 10);
  set("natural_max_damage", 20);
  set("block_aim", ({ "vascular", "ganglion" }));
  set("unbleeding", 1);
  //	set( "wealth/gold", 5 );

  ob1 = new("/d/noden/tomb/obj/sword");
  ob1->move(this_object());
  wield_weapon(ob1);
  ob2 = new("/d/deathland/deathworld/obj/wood_shield");
  ob2->move(this_object());
  equip_armor(ob2);
}

void water() {
  object *victim;
  int i;
  if (!(victim = query_attackers())) return;
  if (random(20) > 1) return;
  else {
    tell_room(environment(this_object()), set_color("\n
该死的生命，我奉魔王之令，带你们去见它。
看我的：“不～灭～龙～威～～～～～破!!!!”
一道黄色的光圈向你袭来，在你的四周全是骷髅的影子，围着你一阵乱砍～
\n", "HIG"), this_object());
    for (i = 0; i < sizeof(victim); i++)
      victim[i]->receive_special_damage("energy", 30);
    return;
  }
}

void die() {

  object ob1, ob2;

  ob1 = query("last_attacker");
  tell_object(ob1,
    "从尸体里掉出一些药水\n");
  ob2 = new("/d/deathland/deathworld/obj/potion");
  ob2->move(environment(this_player()));
  ::die(0);
}
