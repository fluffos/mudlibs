// pdyx创建于公元2002年8月20日
#include <mudlib.h>

inherit MONSTER;

string short() { return set_color("光骷髅", "HIW"); }

void create() {
  object ob1, ob2;

  ::create();
  set_level(6);
  set_name("skeleton", "光骷髅");
  set_short("@@short");
  set_long(
    "这个骷髅身体上发着淡淡的白光。他似乎会释放法术!\n"
  );
  set("race", "undead");
  set_perm_stat("str", 6);
  set_skill("longblade", 40);
  set_skill("parry", 40);
  set_skill("block", 40);

  set("exp_reward", 700);
  set("tactic_func", "water");
  set("killer", 1);
  set("max_hp", 400);
  set("hit_points", 400);
  set("alignment", -100);
  set("natural_armor_class", 30);
  set("natural_weapon_class1", 10);
  set("natural_min_damage", 10);
  set("natural_max_damage", 20);
  set("block_aim", ({ "vascular", "ganglion" }));
  set("unbleeding", 1);
  //	set( "wealth/gold", 5 );

  ob1 = new("/d/noden/tomb/obj/sword");
  ob1->move(this_object());
  wield_weapon(ob1);
  ob2 = new("/d/deathland/deathworld/obj/wood_shield");
  ob2->move(this_object());
  equip_armor(ob2);
}
void water() {
  object *victim;
  int i;
  if (!(victim = query_attackers())) return;
  if (random(20) > 1) return;
  else {
    tell_room(environment(this_object()), set_color("\n
骷髅的嘴开始一张一和不知道咕哝些什么....魔法～地～裂～爆～炎.....
裂开吧！大地，吐出你的愤怒火焰燃烧贻尽地上的生物吧——地裂爆炎！”
\n", "HIG"), this_object());
    for (i = 0; i < sizeof(victim); i++)
      victim[i]->receive_special_damage("cold", 30);
    return;
  }
}


void die() {

  object ob1, ob2;

  ob1 = query("last_attacker");
  tell_object(ob1,
    "从尸体里掉出一些药水\n");
  ob2 = new("/d/deathland/deathworld/obj/potion");
  ob2->move(environment(this_player()));
  ::die(0);
}
