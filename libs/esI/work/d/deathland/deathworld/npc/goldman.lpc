// pdyx创建于公元2002年8月20日

#include <mudlib.h>

#include "/include/move.h"

inherit MONSTER;

string name(){ return set_color ("Gold guard","HIY");}
string short(){ return set_color ("金甲卫士","HIY"); }

void create()
{
	::create();
	set_level(19);
	set_name( "@@name", "金甲卫士" );
	add ("id", ({ "guard1","guard","gold guard" }) );
	set_short( "@@short");
	set_long(
		"一个身上穿着黄金盔甲的武士，他正虎视耽耽的盯着你。
他在这里守护了很久了，眼神中充满了疲惫。\n"
	);
	set_perm_stat("str", 30 );
	set_perm_stat("con", 25 );
	set_skill( "thrusting", 10 );
	set_skill( "parry", 50 );
	set_skill( "block", 50 );
	set_skill( "axe",100 );
	set( "alignment", -150 );
	set( "tactic_func", "my_tactic" );

	set( "race", "human" );
	set( "gender", "male" );

	set("max_hp", 1350);
	set("max_sp", 400);        
        set("max_fp", 1100);
	set( "tactic_func", "my_tactic" );
	set("hit_points", 1350);
	set("spell_points",400);
        set("force_points",1100);
       set( "aim_difficulty",
    	([ "critical":60,"vascular":60,"weakest":60,"ganglion":60 ]) );
	set_natural_weapon( 20, 45, 30 );
	set_natural_armor( 20, 35 );
	set ("special_defense", ([
		"all": 50 , "none" : 50]) );
	set( "inquiry", ([   "stone" : "@@ask_stone",
			     "open" : "@@ask_open",
			"soul" : "@@ask_soul" ]) );

	equip_armor( "/d/deathland/deathworld/weapon/gold_boots" );
	equip_armor( "/d/deathland/deathworld/weapon/gold_gauntlets" );
	equip_armor( "/d/deathland/deathworld/weapon/gold_plate" );
	equip_armor( "/d/deathland/deathworld/weapon/gold_shield" );
	wield_weapon( "/d/deathland/deathworld/weapon/gold_sword" );


}

void ask_stone( object who )
{
	tell_room( environment(),
		"金甲武士说道:那一道黑石墙是魔法师-拉修帝设置的封印。
墙的另一端通向魔界，如果有谁破坏了这个禁止就会使封印失效，打破人间和
魔界的势力平衡，恶魔门的力量就会苏醒，从魔界出来危害人界。拉修帝怕
有不知道内情的冒险者破坏掉封印，命令我兄弟二人在这里看守接近七十六年了。\n",
		this_object()
	);
}
void ask_open( object who )
{
	tell_room( environment(),
		"金甲武士小声的告诉你：“普通的人是无法打开的，除非有人奉献给它一风黄金灵魂(soul)”。\n",
		this_object()
	);
}
void ask_soul( object who )
{
	tell_room( environment(),
		"普通人类的灵魂是没有颜色的，必须是天神庇护的神的使者才有黄金灵魂.
想干麻，别看着我，我只是普通人而已。我没有Goldsoul给你。\n",
		this_object()
	);
}

int my_tactic()
{
	object *atk;

	if( !(atk = query_attackers()) || random(20)<5) return 0;
	tell_room( environment(this_object()), set_color (
		"金甲卫士在预感到死亡的威胁时，使用了神赐予的神圣力量...  天使闪光  ....
一个美丽的白羽天使在他身后浮现，用白色光芒形成的翅膀拥抱着他的全身。\n","HIW"),
		this_object() );
	this_object()->receive_healing(100);
	return 1;
}
void die()
{
	object *usr, killer,ob1;
	int i;
	
	ob1 = new("/d/deathland/deathworld/obj/goldsoul" );
	killer = query("last_attacker");
	if( !killer ) {
		::die();
		return;
	}

	tell_object( killer,set_color("\n\n
你知不知道你闯下滔天大祸了，人间将从此刻起沦落成地狱。你会后悔终生的.......\n
话音刚落，本来漆黑色的夜空漫漫的变成了血红色，狂风四起。\n
只见金甲卫士的逐渐融化为光粒子发出点点光芒，那些光粒漫漫的融合成一个黄金颜色的小球\n
你叹了口气将小球拿了起来，放进衣兜里。\n
\n\n\n","HIG"));
	usr = users();
	for( i=0; i<sizeof(usr); i++ ) {
		if( !environment( usr[i] ) || usr[i] == killer ) continue;
			tell_object( usr[i], 
			set_color(sprintf("\n\n看守魔界障壁的金甲卫士被%s杀了，魔界的封印即将被打开。!\n\n\n" ,killer->query("c_name")), "HIR"));
	} 
	ob1->set("killer",(string)killer->query("name"));
   	if( (int)(ob1->move(killer)) != MOVE_OK )
		ob1->move(environment(this_object()));  
	tell_room(environment(),"黄金武士的灵魂化为了一颗小球。\n");
   this_object()->remove();
   return;
   ::die();   
}

