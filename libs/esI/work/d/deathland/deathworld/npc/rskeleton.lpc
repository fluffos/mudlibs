// pdyx创建于公元2002年8月20日
#include <mudlib.h>

inherit MONSTER;

string short() { return set_color("红色骷髅", "HIR"); }

void create() {
  object ob1, ob2;

  ::create();
  set_level(6);
  set_name("skeleton", "红色骷髅");
  set_short("@@short");
  set_long(
    "这个骷髅的骨架是红色的。和其他骷髅不同，似乎要厉害些。
它的双手凝聚着两团跳动着的火焰,两眼闪着红色的光芒。
它似乎对火有强烈的免疫能力。\n"
  );
  set("race", "undead");
  set_perm_stat("str", 6);
  set_skill("longblade", 40);
  set_skill("parry", 40);
  set_skill("block", 40);

  set("exp_reward", 700);
  set("tactic_func", "water");
  set("killer", 1);
  set("max_hp", 400);
  set("hit_points", 400);
  set("alignment", -100);
  set("natural_armor_class", 30);
  set("natural_weapon_class1", 10);
  set("natural_min_damage", 10);
  set("natural_max_damage", 20);
  set("block_aim", ({ "vascular", "ganglion" }));
  set("unbleeding", 1);
  //	set( "wealth/gold", 5 );


}
void water() {
  object *victim;
  int i;
  if (!(victim = query_attackers())) return;
  if (random(20) > 1) return;
  else {
    tell_room(environment(this_object()), set_color("\n
！！姆～旯～呃～哈～哦～　.....~~出来啊　守护我的 火的魔魂啊！
用您的气息燃尽打扰我们伟大的魔神睡眠人的灵魂吧～两道巨大的火球向你飞来～”
\n", "HIR"), this_object());
    for (i = 0; i < sizeof(victim); i++)
      victim[i]->receive_special_damage("fire", 30);
    return;
  }
}



void die() {

  object ob1, ob2;

  ob1 = query("last_attacker");
  tell_object(ob1,
    "从尸体里掉出一些药水\n");
  ob2 = new("/d/deathland/deathworld/obj/potion");
  ob2->move(environment(this_player()));
  ::die(0);
}
