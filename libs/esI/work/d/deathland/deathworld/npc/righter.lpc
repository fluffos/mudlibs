// pdyx创建于公元2002年8月20日
#include <mudlib.h>

inherit MONSTER;

void create() {
  ::create();
  set_level(16);
  set_name("righter", "马面守卫");
  add("id", ({ "righter" }));
  set_short("马面守卫");
  set("unit", "位");
  set_long(
    @DESC
你看到一个人身马脸的家伙，真是对不起上帝，也不知道他妈妈怎么生他出来的\n"
"他正悠闲的在你身边溜达！\n"
DESC
  );
  set("race", "undead");
  set_perm_stat("str", 20);
  set("max_hp", 700);
  set("hit_points", 700);
  set("natural_defense_bonus", 18);
  set("natural_weapon_class1", 17);
  set("natural_min_damage1", 9);
  set("natural_max_damage1", 24);
  set("alignment", -1000);
  set("unbleeding", 1);
  set("block_aim", ({ "vascular", "ganglion" }));
  set("tactic_func", "my_tactic");
  set("wealth/gold", 30);
  set("tactic_func", "group_attack");
  set("chat_chance", 7);
  set("att_chat_output", ({
    "马面喝道：别惹火了我，你是打不过我DI～～!!\n"
  }));

}

int check_partner(object obj) {
  if (obj->query_attacker()) return 0;
  if ((string)obj->query("name") == "lefter") return 1;
  return 0;
}

int group_attack() {
  object victim, *guard;
  int i;
  victim = query_attacker();
  if (!victim) return 0;
  guard = filter_array(all_inventory(environment(this_object())),
    "check_partner", this_object());
  for (i = 0; i < sizeof(guard); i++) {
    tell_room(environment(this_object()),
      "马面大喊：来来来，把脖子伸过来让我砍了你～\n"
    );
    guard[i]->kill_ob(victim);
  }
}
