// pdyx修改于公元2002年8月20日
#include <mudlib.h>

inherit MONSTER;

void create() {
  ::create();
  set_level(15);
  set_name("lefter", "牛头守卫");
  set_short("牛头守卫");
  set_long(
    "你看到一个人身牛头的家伙，孔武有力、精神健旺、不像是\n"
    "容易受伤的样子，他正伸出他的斧头，拦住了你的去路！"
  );
  set("race", "undead");
  set_perm_stat("str", 20);
  set("max_hp", 700);
  set("hit_points", 700);
  set("natural_defense_bonus", 18);
  set("natural_weapon_class1", 17);
  set("natural_min_damage1", 9);
  set("natural_max_damage1", 24);
  set("alignment", -1000);
  set("unbleeding", 1);
  set("block_aim", ({ "vascular", "ganglion" }));
  set("tactic_func", "my_tactic");
  set("wealth/gold", 30);

  set("unit", "只");
  set_c_verbs(({ "%s斧头伸缩不定，砍向%s", "%s发出「哦」的一声，手臂突然变长，拿着斧头往%s头上砍去",
    "%s用力的蹬地，直楞楞地对著%s冲了过来" }));

  set("alt_corpse", "/d/deathland/deathworld/npc/lefter");
}

int my_tactic() {
  object *victim;
  int i;

  if (random(20) < 13 || !(victim = query_attackers())) return 0;
  tell_room(environment(),
    "牛头怪口中咿呀怪叫，手中的巨大斧头向你扔了过来。使你感到一股无法抗拒的恐怖！\n");
  for (i = 0; i < sizeof(victim); i++)
    victim[i]->run_away();
  return 1;
}
