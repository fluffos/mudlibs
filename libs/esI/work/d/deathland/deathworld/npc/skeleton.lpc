// pdyx创建于公元2002年8月20日
#include <mudlib.h>

inherit MONSTER;


void create() {
  object ob1, ob2;

  ::create();
  set_level(6);
  set_name("skeleton", "骷髅");
  set_short("白色骷髅");
  set_long(
    "这个骷髅的骨架是白色的。它的右手提着一把破刀，
左手拿了张破木盾,两眼闪着令人恐惧的光芒。\n"
  );
  set("race", "undead");
  set_perm_stat("str", 6);
  set_skill("longblade", 20);
  set_skill("parry", 20);
  set_skill("block", 20);

  set("exp_reward", 200);
  //	set( "killer", 1 );
  set("alignment", -10);
  set("natural_armor_class", 30);
  set("natural_weapon_class1", 3);
  set("natural_min_damage", 4);
  set("natural_max_damage", 6);
  set("block_aim", ({ "vascular", "ganglion" }));
  set("unbleeding", 1);
  set("wealth/silver", 10);

  ob1 = new("/d/noden/tomb/obj/sword");
  ob1->move(this_object());
  wield_weapon(ob1);
  ob2 = new("/d/deathland/deathworld/obj/wood_shield");
  ob2->move(this_object());
  equip_armor(ob2);
}
