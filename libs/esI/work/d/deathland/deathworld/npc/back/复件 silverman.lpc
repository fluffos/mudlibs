// pdyx创建于公元2002年8月20日

#include <mudlib.h>

inherit MONSTER;

string name() { return set_color("Silver guard", "HIW"); }
string short() { return set_color("银甲武士", "HIW"); }
void create() {
  ::create();
  set_level(19);
  set_name("@@name", "银甲武士");
  add("id", ({ "guard", "silverguard" }));
  set_short("@@short");
  set_long(
    "一个虎背熊腰身上穿着银色盔甲的武士，他正虎视耽耽的盯着你。\n"
  );
  set_perm_stat("str", 25);
  set_perm_stat("con", 15);
  set_skill("thrusting", 40);
  set_skill("longblade", 100);
  set_skill("parry", 40);
  set_skill("dodge", 40);
  set_skill("block", 40);
  set("alignment", -140);
  set("tactic_func", "my_tactic");
  set("tactic_func", "water");

  set("race", "human");
  set("gender", "male");

  set("max_hp", 1150);
  set("max_sp", 1100);
  set("max_fp", 1100);
  set("hit_points", 1150);
  set("spell_points", 1100);
  set("force_points", 1100);
  set("aim_difficulty",
    ([ "critical": 60, "vascular": 60, "weakest": 60, "ganglion": 60 ]));
  set_natural_weapon(20, 5, 10);
  set_natural_armor(20, 10);
  set("special_defense", ([
    "all": 40, "none": 50 ]));

  equip_armor("/d/deathland/deathworld/weapon/silver_boots");
  equip_armor("/d/deathland/deathworld/weapon/silver_gauntlets");
  equip_armor("/d/deathland/deathworld/weapon/silver_plate");
  equip_armor("/d/deathland/deathworld/weapon/silver_shield");
  wield_weapon("/d/deathland/deathworld/weapon/silver_sword");

}

int my_tactic() {
  object *atk;

  if (!(atk = query_attackers()) || random(15) < 4) return 0;
  tell_room(environment(this_object()), set_color(
    "银甲卫士在预感到死亡的威胁时，使用了神赐予的神圣力量...  天使闪光  ....
一个美丽的白羽天使在他身后浮现，用白色光芒形成的翅膀拥抱着他的全身。\n", "HIW"),
    this_object());
  this_object()->receive_healing(100);
  return 1;
}

void water() {
  object *victim;
  int i;
  if (!(victim = query_attackers())) return;
  if (random(20) < 15) return;
  else {
    tell_room(environment(this_object()), set_color("\n
银甲双手紧握长剑,大声喊道: “～剑～气～乱～舞～　　　　五道剑气激射而出”
\n", "HIG"), this_object());
    for (i = 0; i < sizeof(victim); i++)
      victim[i]->receive_special_damage("cold", 30);
    return;
  }
}
