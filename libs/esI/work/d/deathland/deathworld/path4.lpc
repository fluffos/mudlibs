#include <mudlib.h>
inherit ROOM;

void create() {
  ::create();
  set_short("通向深渊的道路");
  set_long(@LONG_DESCRIPTION
天空的星光洒落在一条小路上，你凭着点点的星光勉强看得清楚周围的
环境，只见这条小路曲曲折折的弯来弯去，通向漆黑的远方。你眼光一
瞟好象看见路旁的的大石头上刻着几个字(word).
LONG_DESCRIPTION
  );

  set("light", 1);
  set("c_item_desc", ([
    "word": "
                 没有非凡的勇气和实力，还是请回头吧!\n" ]));
  set("exits", ([
    "west": "/d/deathland/deathworld/path5",
    "north": "/d/deathland/deathworld/path3"
  ]));
  reset();
}
