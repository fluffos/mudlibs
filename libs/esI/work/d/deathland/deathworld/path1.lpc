#include <mudlib.h>
inherit ROOM ;

void create()
{
	::create();
	set_short("通向深渊的道路");
	set_long( @LONG_DESCRIPTION
天空的星光洒落在一条小路上，你凭着点点的星光勉强看得清楚周围的
环境，只见这条小路曲曲折折的弯来弯去，通向漆黑的远方。在路边的
岩石上你发现了一个小牌子(sign)。
LONG_DESCRIPTION
	);

	set( "light", 1 );
	set( "c_item_desc", ([ 
		"sign" : "
                        @@@@@@@@@@@@@@@@@@@@@@@@@@@@
			  由此向前，通往失落的城市  
                         勇往直前，你会得到你的梦想
                        @@@@@@@@@@@@@@@@@@@@@@@@@@@@\n" ]) );
	set( "exits", ([ 
		"up" : "/d/noden/farwind/square",
		"south" : "/d/deathland/deathworld/path2", 
]) );
	reset();
}