#include <mudlib.h>
inherit ROOM ;

void create()
{
	::create();
	set_short("红色通道");
	set_long( @LONG_DESCRIPTION
血红色的通道充满了肃杀的感觉。血色的地面刺激着你紧绷着的神经。
你的眼睛打量着四周，发现墙面似乎在不断的变化，仿佛有什么在流
动一般。北面的通道传来了一阵奇怪的呻吟，你心中一阵紧张。
LONG_DESCRIPTION
	);

	set( "light", 1 );
	set( "c_item_desc", ([ 
		"wall" : "
这次你学乖了，捂着鼻子去看墙壁，发现墙面的纹路好象认得血管在弹动一般。
你用随身带的小刀轻轻的划了一下墙壁，有红色的液体溅出，落在了你的衣服上。\n" ]) );
	
	set( "exits", ([ 
		"south" : "/d/deathland/deathworld/gate2", 
		"north" : "/d/deathland/deathworld/gate4" 
]) );
	reset();
}