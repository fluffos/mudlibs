// File: /d/deathland/deathworld/gate1.c
// pdyx创建于公元2002年8月20日

#include <mudlib.h>
inherit ROOM;
int adv;

void create() {
  ::create();
  set_short("封印石墙");
  set_long(@LONG_DESCRIPTION
你看到一块巨大的黑色石头(stone)堵在了路的中央，看样子你没办法过
去了。石头上有块很大告示牌(sign)。石头前面不远处生着一堆篝火，正熊熊
燃烧着。两个人正坐在那里烤火，看见走过去，忙站了起来并整理整理了武器，
向你走了过来。
LONG_DESCRIPTION
  );

  set("light", 1);
  set("c_item_desc", ([
    "stone": "一堵相当厚实的黑色墙壁，泛着紫色光华的墙面看不到一丝的缝隙，
在门的正中有个黄金颜色的凹陷好象可以放上什么东西。\n",
    "sign": "
                 闲杂人等，禁止入内!\n" ]));
  set("objects", ([
    "goldman": "/d/deathland/deathworld/npc/goldman",
    "silverman": "/d/deathland/deathworld/npc/silverman"
  ]));
  set("exits", ([
    //		"north" : "/d/deathland/deathworld/gate2", 
    "south": "/d/deathland/deathworld/path5"
  ]));
  reset();
}

void init() {
  add_action("do_put", "put");
}

int do_put(string str) {
  object ob, player;
  string Goldsoul;
  player = this_player();

  if (!str || str != "goldsoul into hole") {
    write("你要做啥?\n");
    return 1;
  }
  ob = present("goldsoul", player);
  if (!ob) {
    write("你身上好象没有黄金灵魂！\n");
    return 1;
  }
  if (adv) {
    tell_object(player, set_color(
      "你双手捧着黄金灵魂，把它放到黄金凹陷中，凹陷周围发出了一阵血红色的光芒！\n"
      "\n"
      "你发现四周突然安静了下来，静得可怕.........\n"
      "\n"
      "你正紧张的注意周围的环境，忽然发现黑色的石墙转眼间变成了血红色。\n"
      "\n"
      "原本放黄金灵魂的凹陷变成了一个可以通过的“门”。\n"
      "\n"
      "通向魔界的通道打开了～！！～\n", "HIR"),
    );
    add("exits", ([ "north": "/d/deathland/deathworld/gate2" ]));
    //	new(DRO"teeder")->move(this_object());
    ob->remove();
    adv = 0;
    return 1;
  } else tell_object(player,
    "你将黄金灵魂放进了凹陷里，但是什麽事都没有发生。\n");
  ob->remove();
  return 1;
}

void reset() {
  room::reset();
  adv = 1;
  delete("exits/north");

}
