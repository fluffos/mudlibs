#include <mudlib.h>
inherit ROOM ;

void create()
{
	::create();
	set_short("通向深渊的道路");
	set_long( @LONG_DESCRIPTION
天空的星光洒落在一条小路上，你凭着点点的星光勉强看得清楚周围的
环境，只见这条小路曲曲折折的弯来弯去，通向漆黑的远方。
LONG_DESCRIPTION
	);

	set( "light", 1 );

	set( "exits", ([ 
		"west" : "/d/deathland/deathworld/path3", 
		"north" : "/d/deathland/deathworld/path1" 
]) );
	reset();
}