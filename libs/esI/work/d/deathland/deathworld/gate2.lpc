#include <mudlib.h>
inherit ROOM ;

void create()
{
	::create();
	set_short("红色通道");
	set_long( @LONG_DESCRIPTION
血红色的通道充满了肃杀的感觉。血色的地面刺激着你紧绷着的神经。
你的眼睛打量着四周，发现墙面似乎在不断的变化，仿佛有什么在流
动一般。
LONG_DESCRIPTION
	);

	set( "light", 1 );
	set( "c_item_desc", ([ 
		"wall" : "
你凑近墙壁仔细的看了看，一股血腥味道扑面而来!\n" ]) );
	
	set( "exits", ([ 
		"south" : "/d/deathland/deathworld/gate1", 
		"north" : "/d/deathland/deathworld/gate3" 
]) );
	reset();
}