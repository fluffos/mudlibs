// pdyx创建于公元2002年8月20日

#include <mudlib.h>

inherit DOORS;

inherit ROOM ;

void create()
{
	::create();
	set_short("狭长甬道的尽头");
	set_long( @LONG_DESCRIPTION
这里四周散落着很多的骷髅骨架、骷髅头和兵器，似乎爆发过一场激战。
但是没有发现任何人类的尸体。你跟着片地的骨架来到了一个巨大的洞穴
里。西面有一道金碧辉煌的大门，门上镶满了钻石、黄金和各种珠宝。
你心里想这难道就是魔神殿的大门了？
LONG_DESCRIPTION
	);

//	set( "light", 1 );
	set( "pre_exit_func", ([
		"west": "check_guard" ]) );	
	set( "objects", ([
                "lefter" : "/d/deathland/deathworld/npc/lefter",
		"righter" : "/d/deathland/deathworld/npc/righter",
//                "skeleton#1" : "/d/deathland/deathworld/npc/skeleton",
//		"skeleton#2" : "/d/deathland/deathworld/npc/skeleton",
//		"skeleton#3" : "/d/deathland/deathworld/npc/skeleton",
//		"skeleton#4" : "/d/deathland/deathworld/npc/skeleton"
        ]) );
	set( "exits", ([ 
		"west" : "/d/deathland/deathworld/ding1-1", 
		"northwest" : "/d/deathland/deathworld/gate6" 
]) );
	 create_door("west","east",([
                  "keyword" : ({"door","iron door"}),
                  "status"  : "closed",
                  "name"    : "Iron Door",
                  "c_name"  : "大门",
                  "c_desc"  : "一个金碧辉煌的大门\n",
		  "status" : "locked",
		  "lock" : "HAND_BONE_ENTRANCE"	
                  ]) );


	reset();
}
int check_guard()
{
	if( present( "lefter" ) ) {
		write(
		"牛头人伸出斧头挡住你的去路，说道: 想进去的话，先过我这关！\n"
		);	
		return 1;
	}
}

