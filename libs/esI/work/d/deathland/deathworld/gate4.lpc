#include <mudlib.h>
inherit ROOM;

void create() {
  ::create();
  set_short("红色通道");
  set_long(@LONG_DESCRIPTION
你来到一个大厅中。这里的中央是一根很粗大的石柱，柱子的顶上有一只
古怪的四手雕像(statue)。雕像的下面有一行细细的字(word)。四面的墙
壁上两个大大的火把正在燃烧，照亮了真个大厅。
你的四周忽然响起了很多奇奇怪怪的声响。
LONG_DESCRIPTION
  );

  set("light", 1);
  set("c_item_desc", ([
    "statue": "你看见一个栩栩如生的拥有四只手臂的石头
雕像。他的分别手上分别拿着枪、斧、棍、剑
四种武器。他的眼睛仰望着北方，脸上透露着
痛苦，悲哀的神色。\n",

    "word": "到这里的人将抛弃 信仰、名誉、忠诚、热血。\n" ]));

  set("objects", ([
    "rskeleton": "/d/deathland/deathworld/npc/rskeleton",
    "skeleton#1": "/d/deathland/deathworld/npc/skeleton",
    "skeleton#2": "/d/deathland/deathworld/npc/skeleton",
    "skeleton#3": "/d/deathland/deathworld/npc/skeleton",
    "skeleton#4": "/d/deathland/deathworld/npc/skeleton"
  ]));

  set("exits", ([
    "south": "/d/deathland/deathworld/gate3",
    "west": "/d/deathland/deathworld/gate5"
  ]));
  reset();
}
