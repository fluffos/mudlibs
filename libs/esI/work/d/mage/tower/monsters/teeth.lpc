#include <mudlib.h>
#include <move.h>
inherit MONSTER;
inherit WMOUNT;

void create()
{
	::create();
	set_level(18);
	set_name( "Light teeth",set_color("魔兽「光牙」","HIC"));
	add("id", ({"teeth"}) );
	set_short( set_color("魔兽「光牙」","HIC") );
	set_long(@C_LONG
    这似乎是那位魔法师召唤来的坐骑，一只全身发光，四处乱撞的魔兽。
你可以用(rode)命令它听话，不过它可不是乖宝宝哦！
C_LONG
	);
	set( "unit", "匹" );
	set_perm_stat("str", 10 );
	set_perm_stat("dex", 11 );
	set_skill("dodge", 40 );
	set_skill("tactic", 70 );
	set("tactic", "melee" );
	set("pursuing",1);
	set("max_hp", 200);
	set("hit_points", 200);
	set_natural_armor(45,10);
	set_natural_weapon(20,12,20);
	set( "max_load", 2200 );
	set("prevent_drop",1);

       set("c_killer_msg","突然地上射出一道光线，在冲向天空转了个弯後，向你袭来！\n");
       set_c_verbs( ({"%s突然笔直的射向%s","%s转了个弯儿向%s冲了过去",
              "%s在地上蜿蜒前进突然咬向%s"}) );
       set_c_limbs( ({"门面","牙齿","头部","身躯"}) );
//       set("c_death_msg","%s说：主人，请接受我的效忠！说著说著化成一把短刃....\n");
//       set("alt_corpse","/d/zeq/icedagger");   
}

void set_fuel(int fuel)
{
    call_out( "burn_out", fuel, this_object() );
}

void burn_out(object obj)
{
	object owner;

	owner = environment(obj);
	if( living(owner) ) {
	  tell_object( owner,"「光牙」突然说道：“主人，我们约定的时限到了”。然后变成一些暗色的发光离子消失了.\n");
	  tell_room( environment( owner ), 
	    owner->query("c_name")+"的「光牙」变成一些暗色的发光离子消失了。\n" ,
	    owner
	  );
	}
    obj->remove();
}

int move( mixed place )
{    
    if( objectp(place) && !living(place) )
      call_out( "disappear", 2, this_object() );
    return ::move(place);
}

void disappear( object obj )
{
    tell_room( environment(obj), 
      "「光牙」突然说道：“主人，我们约定的时限到了”。说完就变成一些暗色的发光离子消失了.\n" , obj
    );
    obj->remove();
}

void init()
{
	wmount::init();
}


