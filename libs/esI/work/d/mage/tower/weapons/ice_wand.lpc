#include <mudlib.h>
inherit WEAPON;

void create()

{
  set_name("ice wand", "寒冰杖");
  add("id", ({ "wand" }));
  set_short("a ice wand", "寒冰杖");
  set_long(@CLONG
        用玄天寒冰制成，据说能引起「冰雹」的魔杖。
CLONG
  );

  set("unit", "把");
  set("weapon_class", 40);
  set("type", "wand");
  set("min_damage", 20);
  set("max_damage", 40);
  set("weight", 50);
  set("no_sale", 1);
  set("value", ({ 3000, "silver" }));

  // set this weapon as magical weapon.
  set("hit_func", "wand_hit");
  set("power_on", 1);
  set("extra_look", set_color(
    "片片白色晶莹的雪花在$N的身边飞舞......\n", "HIW"));
  set("charge_left", 10);
  set("max_charge", 10);
  set("special_damage_type", "cold");
  set("special_damage", 75);
  set("special_msg", " causes sleet.");
  set("special_c_msg", set_color("引发了「冰雹」，风雪无情的向眼前的敌人肆虐着！", "HIW"));

}
