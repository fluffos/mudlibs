#include <mudlib.h>
inherit ARMOR;

mapping origin_sp;
void create()
{
	set_name( "wonderful hat", "内力帽子" );
	add( "id", ({ "hat", }) );
	set_short( "a wonderful hat", "内力的帽子");
	set_long(@DESC
    这是衰神戴过的破帽子，它只是用普通的布织成。\n".
DESC
	);
	set( "unit", "顶" );
	set( "weight", 15 );
	set( "type", "head" );
	set( "material", "cloth" );
	set( "armor_class", 10 );
	set( "defense_bonus", 5 );
	set( "special_defense", ([ "none": 6 ]) );
	set( "extra_skills", ([ "runes": 10 ]) );
	set( "no_sale", 1);
	set( "value", ({ 3000, "silver" }) );
	set( "equip_func", "heal_sp" );
	set( "unequip_func", "stop_heal_sp" );
	set( "extra_look",set_color(
             "$N戴著的帽子中散发出一股绿色的光芒。\n" ,"HIG") );

}
void heal_sp()
{
    object player;
    player = environment(this_object());
    tell_object( player,set_color( 
      "一股不可思议的光芒从帽子散出并包围著你。\n","HIG"));
    origin_sp=player->query("conditions/_max_fp");
    player->set("conditions/_heal_sp" , ({ 10, 5 }));
}
void stop_heal_sp()
{
    object player;
    player = environment(this_object());
    tell_object( player, 
      "你身上不可思议的光芒消失了。\n" );
    player->set("conditions/_max_fp", origin_sp);
}
