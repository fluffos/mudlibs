#include <mudlib.h>

inherit MONSTER;
string name(){ return set_color ("goldman","HIY");}
string short(){ return set_color ("皇家护卫团四将 毅","HIB"); }
void create()
{
	::create();
	set_level(19);
	set_name( "@@name", "毅" );
	add ("id", ({ "man", "knight", "goldman" }) );
	set_short( "@@short");
	set_long(
		"毅是诺顿王国中强大的骑士，他目前被派往蓝沙港去执行搜寻海盗的任务，同时\n"
		"也希望能招募更多强壮的年青人参加保卫国家的行列。\n"
	);
	set_perm_stat("str", 30 );
	set_perm_stat("con", 25 );
	set_skill( "thrusting", 10 );
	set_skill( "parry", 100 );
	set_skill( "block", 100 );
	set_skill( "axe",100 );
	set( "alignment", -15000 );

	set( "race", "human" );
	set( "gender", "male" );

	set("max_hp", 85350);
	set("max_sp", 5700);        
        set("max_fp", 5000);
	set("hit_points", 85350);
	set("spell_points", 5700);
        set("force_points",5000);
       set( "aim_difficulty",
    	([ "critical":60,"vascular":60,"weakest":60,"ganglion":60 ]) );
	set_natural_weapon( 80, 55, 80 );
	set_natural_armor( 60, 80 );
	set ("special_defense", ([
		"all": 50 , "none" : 50]) );

	wield_weapon( "/d/island/hole/weapon/axe1" );
	equip_armor( "/d/zeq/knight/silver_helmet" );
	equip_armor( "/d/zeq/knight/silver_cape" );
	equip_armor( "/d/zeq/knight/silver_arms" );
	equip_armor( "/d/zeq/knight/silver_boots" );
	equip_armor( "/d/zeq/knight/silver_amulet" );
	equip_armor( "/d/zeq/knight/silver_leggings" );
	equip_armor( "/d/zeq/knight/silver_gauntlets" );
	equip_armor( "/d/zeq/knight/silver_plate" );
	equip_armor( "/d/zeq/knight/silver_ring" );
	equip_armor( "/d/zeq/knight/silver_shield" );
}