#include <mudlib.h>

inherit MONSTER;

string name(){ return set_color ("stoneman","HIY");}
string short(){ return set_color ("皇家护卫团四将 强","HIG"); }
void create()
{
	::create();
	set_level(19);
	set_name( "@@name", "强" );
	add ("id", ({ "man", "knight", "stoneman" }) );
	set_short( "@@short");
	set_long(
		"强是诺顿王国中强大的骑士。黑森林目前出现很多怪兽伤人事件，国王耶拉曼派遣他来救援生还者\n"
		"解决制造麻烦的根源，并希望能发现传说中隐藏的秘密。\n"
	);
	set_perm_stat("str", 30 );
	set_perm_stat("dex", 25 );
	set_perm_stat("int", 25 );
	set_perm_stat("con", 25 );
	set_skill( "jousting", 100 );
	set_skill( "longblade", 100 );
	set_skill( "parry", 100 );
	set_skill( "dodge", 100 );
	set_skill( "block", 100);
	set( "alignment", 1500 );

	set( "race", "human" );
	set( "gender", "male" );

	set("max_hp", 85350);
	set("max_sp", 5700);        
        set("max_fp", 5000);
	set("hit_points", 85350);
	set("spell_points", 5700);
        set("force_points",5000);
       set( "aim_difficulty",
    	([ "critical":60,"vascular":60,"weakest":60,"ganglion":60 ]) );
	set_natural_weapon( 20, 5, 10 );
	set_natural_armor( 20, 10 );
	set ("special_defense", ([
		"all": 40 , "none" : 50]) );

        equip_armor( "/d/zeq/knight/silver_helmet" );
	equip_armor( "/d/zeq/knight/silver_cape" );
	equip_armor( "/d/zeq/knight/silver_arms" );
	equip_armor( "/d/zeq/knight/silver_boots" );
	equip_armor( "/d/zeq/knight/silver_amulet" );
	equip_armor( "/d/zeq/knight/silver_leggings" );
	equip_armor( "/d/zeq/knight/silver_gauntlets" );
	equip_armor( "/d/zeq/knight/silver_plate" );
	equip_armor( "/d/zeq/knight/silver_ring" );
	equip_armor( "/d/zeq/knight/silver_shield" );
	wield_weapon( "/d/zeq/sword1" );

set( "chat_chance", 30 );
set( "chat_output", ({
		"强突然自言自语的说: 慢著，小子别进去，怪兽很厉害的！\n",
		"强对你说道: 要进去可以但是把钱留下来，不然丢失了也就白丢了。\n",
		"强对你说道: 我不是在开玩笑，把你身上的钱全部留下来！我帮你保管！嘿嘿\n"
	}) );
}