//pdyx 2001.12.16

#include <mudlib.h>
#include <daemons.h>
inherit WEAPON;

int form;
string DAGGER_NAME = "[37;1m冰雪风暴[37;0m";

void create() {
  set_name("ice dagger", "冰刃");
  add("id", ({ "dagger" }));
  set_short("冰刃");
  set_long(
    "这是一把用冰精制作而成的精巧匕首，锋锐的刃上泛的可爱的蓝色光茫。\n"
  );
  set("unit", "把");
  set("type", "dagger");
  set("hit_func", "weapon_hit");
  set("weapon_class", 100);
  set("min_damage", 200);
  set("max_damage", 300);
  set("special_damage", 800);
  set("no_sale", 1);
  set("weight", 40);
  set("second", 1);
  set("value", ({ 1000, "gold" }));
  set("extra_look",
    "一条银色白龙若隐若现的团团围绕著$N的身躯，威风凛凛犹如天神下凡一般...\n");
  set("wield_func", "wield_dagger");
  set("unwield_func", "unwield_dagger");
  form = 0;
}

void unwield_dagger() {
  string name;
  object holder;

  if (!holder = environment(this_object())) return;
  name = holder->query("c_name");
  if (form == 1) {
    tell_room(environment(holder), name + "手中的" + DAGGER_NAME + "，渐渐变回了脆弱的冰刃。\n", holder);
    tell_object(holder, "失去信仰的力量指使，你手中的" + DAGGER_NAME + "渐渐变回了脆弱的冰刃。\n");
    set_name("Ice Dagger", "冰刃");
    set_short("泛着蓝光的冰刃");
    set("min_damage", 200);
    set("max_damage", 300);
    //		set( "prevent_drop",0 );
    delete("hit_func");
    form = 0;
    return;
  }
  return;
}

void wield_dagger() {
  string name;
  object env, holder;

  holder = environment(this_object());
  env = environment(holder);
  name = holder->query("c_name");

  if ((int)holder->query("alignment") < 1500) {
    tell_room(env, name + "的冰刃忽然炙炙作响，蓝光漫漫的形成一条龙形，逐渐将他的身体包裹起来,啊！" + DAGGER_NAME + "。\n", holder);
    tell_object(holder, "你对人生的信仰呼应冰刃蕴藏的魔力，使它幻化成人间的神器" + DAGGER_NAME + "。\n");
    set_name("ICES DAGGER ", "「冰雪风暴」");
    set_short("「冰雪风暴」");
    set("min_damage", 500);
    set("max_damage", 600);
    //		set( "prevent_drop",1 );
    set("hit_func", "ghost_fight");
    form = 1;
    return;
  }
  return;
}

int weapon_hit(object victim, int damage) {
  object owner;
  int my_pie, vic_pie, sp, dam;

  owner = environment();
  sp = owner->query("spell_points");
  if (sp < 6) return 0;
  my_pie = (int)owner->query_stat("pie");
  vic_pie = (int)victim->query_stat("pie");
  if (random(my_pie * 3) < vic_pie * 2) return 0;
  if (!(dam = (int)query("special_damage"))) return 0;
  owner->set("spell_points", sp - 6);
  if ((int)owner->query_skill("dagger") < 10) {
    tell_object(owner,
      "\n你的冰刃舞动时所幻成的冰气伤到了自己.\n\n");
    tell_room(environment(owner),
      "\n" + owner->query("c_name") + "的冰刃剑光所幻成的冰气反蚀了自己
.\n\n",
      owner);
    owner->receive_special_damage("cold", dam);
    return dam;
  }

  tell_object(owner,
    "\n你握住冰刃舞出一条细长的白色冰气，冰气漫漫变成了一条银白色的飞龙猛地向你的敌人扑去。\n\n");
  tell_room(environment(owner),
    "\n" + owner->query("c_name") + "大声喊到“冰雪神龙,把我们的敌人冻成冰珠吧！”银色飞龙在你的头顶盘旋，口吐着白色的火焰飞向敌人。\n\n"
    , owner);
  victim->receive_special_damage("cold", dam);
  return dam;
}
void body_effect() {
  object holder;

  holder = environment(this_object());
  tell_object(holder,
    "\n冰刃的剑身发出了银白的“气”将你全身笼罩了起来，最外层的“气”流动得越来越快，竟幻化为龙形。\n");
}
