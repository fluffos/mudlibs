#include <mudlib.h>

inherit MONSTER;

string name(){ return set_color ("woodman","HIY");}
string short(){ return set_color ("皇家护卫团四将 怒","HIR"); }
void create()
{
	::create();
	set_level(19);
	set_name( "@@name", "怒" );
	add ("id", ({ "man", "knight", "woodman" }) );
	set_short( "@@short");
	set_long(
		"怒是诺顿王国中强大的骑士，他目前被派来维持远风镇的治安，并希望\n"
		"能招募更多强壮的年青人参加保卫国家的行列。\n"
	);
	set_perm_stat("str", 30 );
	set_perm_stat("con", 15 );
	set_skill( "thrusting", 100 );
	set_skill( "longblade", 100 );
	set_skill( "parry", 100 );
	set_skill( "dodge", 100 );
	set_skill( "block", 100);
	set( "alignment", -1150000 );

	set( "race", "human" );
	set( "gender", "male" );

	set("max_hp", 85350);
	set("max_sp", 5700);        
        set("max_fp", 5000);
	set("hit_points", 85350);
	set("spell_points", 5700);
        set("force_points",5000);
       set( "aim_difficulty",
    	([ "critical":60,"vascular":60,"weakest":60,"ganglion":60 ]) );
	set_natural_weapon( 20, 5, 10 );
	set_natural_armor( 20, 10 );
	set ("special_defense", ([
		"all": 40 , "none" : 50]) );

        equip_armor( "/d/zeq/knight/silver_helmet" );
	equip_armor( "/d/zeq/knight/silver_cape" );
	equip_armor( "/d/zeq/knight/silver_arms" );
	equip_armor( "/d/zeq/knight/silver_boots" );
	equip_armor( "/d/zeq/knight/silver_amulet" );
	equip_armor( "/d/zeq/knight/silver_leggings" );
	equip_armor( "/d/zeq/knight/silver_gauntlets" );
	equip_armor( "/d/zeq/knight/silver_plate" );
	equip_armor( "/d/zeq/knight/silver_ring" );
	equip_armor( "/d/zeq/knight/silver_shield" );
	wield_weapon( "/d/zeq/sword1" );

}