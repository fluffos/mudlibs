#include <mudlib.h>

inherit ARMOR;

string C_NAME = "[37;1m银色臂环[37;0m";

void create() {
  set_name("silver armbands", C_NAME);
  add("id", ({ "armbands" }));
  set_short(C_NAME);
  set_long(
    "一对闪亮的银色臂环.\n"
  );
  set("unit", "双");
  set("type", "arms");
  set("material", "knight");
  set("armor_class", 20);
  set("defense_bonus", 24);
  set("extra_skills", ([ "block": 50 ]));
  set("weight", 100);
  set("value", ({ 270, "gold" }));
  set("no_sale", 1);
}
