#include <mudlib.h>

inherit ARMOR;
string C_NAME="[35;1m斧灵戒指[37;0m";

void create()
{
      set_name("ring",C_NAME);
      add("id",({"ring"}) );
      set_short(C_NAME);
      set_long(@LONG
这是武器之神的戒指!上面囚箍了斧神的灵魂。相传能赐予拥有者使用斧技的能力。
LONG
              );
      set("unit","枚");
      set("type","finger");
      set( "material", "light_metal" );
      set("armor_class",20);
      set("defense_bonus",20);
      set("special_defense",(["all":150]) );	
      set("weight",5);
      set("no_sale",1);
//      set("value",({500,"silver"}) );


}              
                    