#include <mudlib.h>

inherit MONSTER;
inherit MOUNT;

void create()
{
	::create();
	set_level(17);
	set_name( "Red tiger",set_color("红虎","HIR") );
	add( "id", ({ "red tiger","rtiger" }) );
	set_short( set_color("红虎","HIR") );
	set_long(@C_LONG
这是一只红色的凶猛野兽, 平常它并不会主动攻击人类, 但是你要小心哦。
C_LONG
	);
	set("unit","只");
	set_perm_stat( "str", 20 );
	set_perm_stat( "dex", 22 );
	set_perm_stat( "int", 24 );
	set( "natural_min_damage1", 35 );
	set( "natural_max_damage1", 45 );
	set("max_hp", 700);
	set("hit_points", 700);
	set( "max_load", 3000 );
    	set_natural_armor( 70, 28 );
    	set_natural_weapon( 80, 10, 25 );
	set("alignment", -1000 );
	set( "exp_reward",10000);

	set_c_verbs( ({ "%s凶猛地向%s一口咬去", "%s迅速地扑向%s" }) );
	set_c_limbs( ({ "的头", "的身体", "的脚" }) );
	set("c_death_msg","%s说：主人，请接受我的效忠！说著说著化成一柄长枪....\n");
       set("alt_corpse","/d/zeq/spear");   
}

void init()
{
	mount::init();
}
