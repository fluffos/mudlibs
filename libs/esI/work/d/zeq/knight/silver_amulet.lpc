#include <mudlib.h>

inherit ARMOR;
string C_NAME = "[37;1m银色护身符[37;0m";
void create() {
  set_name("silver amulet", C_NAME);
  add("id", ({ "amulet" }));
  set_short(C_NAME);
  set_long(@LONG
这是骑士王族中代表力量,信仰和热情的象徵信物，相传这是生灵之王赐于的信物！
LONG
  );
  set("unit", "枚");
  set("type", "misc");
  set("material", "element");
  set("armor_class", 20);
  set("defense_bonus", 18);
  set("special_defense", ([ "fire": 50, "cold": 50, "evil": 50 ]));
  set("extra_stats", ([ "pie": 4, "int": 4, "kar": 5, "con": 4, "dex": 4, "str": 4 ]));
  set("weight", 10);
  set("no_sale", 1);
  set("value", ({ 100, "gold" }));
}
