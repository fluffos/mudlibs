#include <mudlib.h>

inherit ARMOR;

string name(){ return set_color ("yring","HIC");}
string short(){ return set_color ("『黄色戒指』","HIC"); }

void create()
{
      set_name("@@name","『黄色戒指』");
      add("id",({"ring","yring"}) );
      set_short("@@short");
      set_long(@LONG
这是骑士工会中的专用戒指!上面除了没有魔法防御力以外,已经是最牢固了！
LONG
              );
      set("unit","枚");
      set("type","finger");
      set( "material", "light_metal" );
      set("armor_class",20);
      set("defense_bonus",20);
      set("weight",5);
      set("no_sale",1);
      set("value",({500,"silver"}) );


}              
                    