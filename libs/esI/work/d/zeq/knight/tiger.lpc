#include <mudlib.h>

inherit MONSTER;
inherit MOUNT;

void create() {
  ::create();
  set_level(15);
  set_name("yellow tiger", set_color("黄虎", "HIY"));
  add("id", ({ "yellow tiger", "ytiger" }));
  set_short(set_color("黄虎", "HIY"));
  set_long(@C_LONG
这是一只黄色的凶猛野兽, 平常它并不会主动攻击人类, 但是你要小心哦。
C_LONG
  );
  set("unit", "只");
  set_perm_stat("str", 16);
  set_perm_stat("dex", 17);
  set_perm_stat("int", 13);
  set("natural_min_damage1", 15);
  set("natural_max_damage1", 25);
  set("max_hp", 500);
  set("hit_points", 500);
  set("max_load", 2500);
  set_natural_armor(70, 28);
  set_natural_weapon(80, 10, 25);
  set("alignment", -500);
  set("exp_reward", 6000);

  set_c_verbs(({ "%s凶猛地向%s一口咬去", "%s迅速地扑向%s" }));
  set_c_limbs(({ "的头", "的身体", "的脚" }));
  set("c_death_msg", "%s说：主人，请接受我的效忠！说著说著化成一面盾牌....\n");
  set("alt_corpse", "/d/zeq/shield1");
}

void init() {
  mount::init();
}
