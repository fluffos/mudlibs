#include <mudlib.h>
#include <races.h>

inherit MONSTER;
inherit MOUNT;

void create() {
  ::create();
  set_level(16);
  set_name("Blue Dragon", set_color("蓝色暴龙", "HIB"));
  add("id", ({ "dragon", "long" }));
  set_short(set_color("蓝色暴龙", "HIB"));
  set_long(
    "一头全身呈蓝色的的巨大暴龙，为大神SNOW的坐骑，威猛无比。\n");
  set("unit", "头");
  set("race", "dragon");
  set("killer", 1);
  set("pursuing", 1);
  set_perm_stat("str", 24);
  set_perm_stat("dex", 28);
  set_natural_weapon(75, 50, 70);
  set_natural_armor(80, 40);
  set("natural_min_damage1", 45);
  set("natural_max_damage1", 60);
  set("alignment", 100);
  set("extra_look", set_color(
    "\n$N正骑著一头巨大的蓝色暴龙，看起来犹如天神一般...\n\n", "HIB"));
  set("exp_reward", 10000);
  set("max_load", 900000);
  set_c_limbs(({ "头部", "身体", "後腿", "尾巴" }));
  set_c_verbs(({ "%s扑动它那长满蛀牙的嘴巴，血红的舌头卷向%s", "%s的巨大尾巴一甩，%s似乎被重击了一下，顿时疼痛难忍" }));
  set("c_death_msg", "%s说：主人，请接受我的效忠！说著说著化成一把长剑....\n");
  set("alt_corpse", "/d/zeq/sword1");

}

void init() {
  mount::init();
}
