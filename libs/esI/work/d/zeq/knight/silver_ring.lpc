#include <mudlib.h>

inherit ARMOR;
string C_NAME = "[37;1m银戒指[37;0m";

void create() {
  set_name("ring", C_NAME);
  add("id", ({ "ring" }));
  set_short(C_NAME);
  set_long(@LONG
这是骑士工会中的专用戒指!上面除了没有魔法防御力以外,已经是最牢固了！
LONG
  );
  set("unit", "枚");
  set("type", "finger");
  set("material", "light_metal");
  set("armor_class", 20);
  set("defense_bonus", 20);
  set("extra_skills", ([ "axe": 90 ]));
  set("weight", 5);
  set("no_sale", 1);
  //      set("value",({500,"silver"}) );


}
