// hands.c

#include "/d/zeq/knight/armor/pdyx.h"

inherit ARMOR;
string name(){ return set_color ("magic gauntlets","HIC");}
string short(){ return set_color (" 铠魔手 ","HIC"); }
void create()
{
    set_name("@@name", "铠魔手");
    set_short("@@short");
    add("id", ({ "gloves", "gauntlets" }));
    set_long("由铠魔剑魔力幻化而成的手套。\n");
    set("unit", "双");
    set("weight", 0);
    set("type", "hands");
    set("material", "knight");
	set("special_defense",(["electric":100]) );
    set("armor_class", 4);
    set("defense_bonus", 4);
    set("no_sale", 1);
    set("prevent_drop", 1);
}

void unequip(int silent)
{
    tell_object(this_player(), "铠魔手拒绝离开你的身体!\n");
}

int remove()
{
    object p;
    p = environment(this_object());

    if (p && query("equipped"))
        ::unequip(0);
    return ::remove();
}