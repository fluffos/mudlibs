// helm.c

#include "/d/zeq/knight/armor/pdyx.h"

inherit ARMOR;
string name(){ return set_color ("magic helmet","HIC");}
string short(){ return set_color (" 铠魔盔 ","HIC"); }
void create()
{
    set_name("@@name", "铠魔盔");
    set_short("@@short");
    add("id", ({ "helmet", "helm" }));
    set_long("由铠魔剑魔力幻化而成的头盔。\n");
    set("unit", "顶");
    set("weight", 0);
    set("type", "head");
    set("material", "knight");
    set("special_defense",(["mental":100]) );
    set("armor_class", 8);
    set("defense_bonus", 3);
    set("no_sale", 1);
    set("prevent_drop", 1);
}

void unequip(int silent)
{
    tell_object(this_player(), "铠魔盔拒绝离开你的身体!\n");
}

int remove()
{
    object p;
    p = environment(this_object());

    if (p && query("equipped"))
	::unequip(0);
    return ::remove();
}