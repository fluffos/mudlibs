// arms.c

#include "/d/zeq/knight/armor/pdyx.h"

inherit ARMOR;
string name() { return set_color("magic arms", "HIC"); }
string short() { return set_color("铠魔臂", "HIC"); }
void create() {
  set_name("@@name", "铠魔臂");
  set_short("@@short");
  add("id", ({ "arms", "armband" }));
  set_long("由铠魔剑魔力幻化而成的臂环。\n");
  set("unit", "对");
  set("weight", 0);
  set("type", "arms");
  set("material", "knight");
  set("special_defense", ([ "fire": 100 ]));
  set("armor_class", 8);
  set("defense_bonus", 3);
  set("no_sale", 1);
  set("prevent_drop", 1);
}

void unequip(int silent) {
  tell_object(this_player(), "铠魔臂拒绝离开你的身体!\n");
}

int remove() {
  object p;
  p = environment(this_object());

  if (p && query("equipped"))
    ::unequip(0);
  return ::remove();
}
