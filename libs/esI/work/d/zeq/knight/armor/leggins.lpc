// leggings.c

#include "/d/zeq/knight/armor/pdyx.h"

inherit ARMOR;
string name() { return set_color("magic leggins", "HIC"); }
string short() { return set_color(" 铠魔裆 ", "HIC"); }
void create() {
  set_name("@@name", "铠魔裆");
  set_short("@@short");
  add("id", ({ "gloves", "gauntlets" }));
  set_long("由铠魔剑的魔力幻化而成的胫甲。\n");
  set("unit", "件");
  set("weight", 0);
  set("type", "legs");
  set("material", "knight");
  set("special_defense", ([ "acid": 100 ]));
  set("armor_class", 8);
  set("defense_bonus", 3);
  set("no_sale", 1);
  set("prevent_drop", 1);
}

void unequip(int silent) {
  tell_object(this_player(), "铠魔裆拒绝离开你的身体!\n");
}

int remove() {
  object p;
  p = environment(this_object());

  if (p && query("equipped"))
    ::unequip(0);
  return ::remove();
}
