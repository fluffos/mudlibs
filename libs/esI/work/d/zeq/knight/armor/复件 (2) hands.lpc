// hands.c

#include "/d/zeq/knight/armor/pdyx.h"

inherit ARMOR;
string name() { return set_color("magic gauntlets", "HIC"); }
string short() { return set_color(" 新手之手套 ", "HIC"); }
void create() {
  set_name("@@name", "新手之手套");
  set_short("@@short");
  add("id", ({ "gloves", "gauntlets" }));
  set_long("由新手之剑神力幻化而成的手套。\n");
  set("unit", "双");
  set("weight", 0);
  set("type", "hands");
  set("material", "leather");
  set("special_defense", ([ "electric": 100 ]));
  set("armor_class", 4);
  set("defense_bonus", 4);
  set("no_sale", 1);
  set("prevent_drop", 1);
}

void unequip(int silent) {
  tell_object(this_player(), "新手之手套拒绝离开你的身体!\n");
}

int remove() {
  object p;
  p = environment(this_object());

  if (p && query("equipped"))
    ::unequip(0);
  return ::remove();
}
