// plate.c

#include "/d/zeq/knight/armor/pdyx.h"

inherit ARMOR;
string name() { return set_color("magic plate", "HIC"); }
string short() { return set_color(" 新手之甲 ", "HIC"); }
void create() {
  set_name("@@name", "新手之甲");
  set_short("@@short");
  add("id", ({ "plate" }));
  set_long("由新手之剑的神力幻化而成的铠甲。\n");
  set("unit", "件");
  set("weight", 0);
  set("type", "body");
  set("material", "leather");
  set("special_defense", ([ "poison": 100 ]));
  set("armor_class", 10);
  set("defense_bonus", 6);
  set("no_sale", 1);
  set("prevent_drop", 1);
}

void unequip(int silent) {
  tell_object(this_player(), "新手之甲拒绝离开你的身体!\n");
}

int remove() {
  object p;
  p = environment(this_object());

  if (p && query("equipped"))
    ::unequip(0);
  return ::remove();
}
