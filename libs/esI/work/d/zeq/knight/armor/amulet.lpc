// amulet.c

#include "/d/zeq/knight/armor/pdyx.h"

inherit ARMOR;
string name(){ return set_color ("magic amulet","HIC");}
string short(){ return set_color ("铠魔护身符","HIC"); }
void create()
{
   	set_name( "@@name", "铠魔护身符" );
	add( "id", ({ "amulet" }) );
	set_short( "@@short" );
    set_long("由铠魔剑的魔力幻化而成的护身符。\n");
    set("unit", "枚");
    set("weight", 0);
    set("type","misc");
    set("material", "knight");
	 set("special_defense",(["none":100]) );    
set("armor_class", 1);
    set("defense_bonus", 6);
    set("no_sale", 1);
    set("prevent_drop", 1);
}

void unequip(int silent)
{
    tell_object(this_player(), "铠魔护身符拒绝离开你的身体!\n");
}

int remove()
{
    object p;
    p = environment(this_object());

    if (p && query("equipped"))
        ::unequip(0);
    return ::remove();
}
