// feet.c
#include "/d/zeq/knight/armor/pdyx.h"

inherit ARMOR;
string name(){ return set_color ("magic feet","HIC");}
string short(){ return set_color (" 新手之鞋 ","HIC"); }
void create()
{
    set_name("@@name", "新手之鞋");
    set_short("@@short");
    add("id", ({ "feet" }));
    set_long("由新手之剑神力幻化而成的鞋子。\n");
    set("unit", "双");
    set("weight", 0);
    set("type", "feet");
    set("material", "leather");
    set("special_defense",(["cold":100]) );
    set("armor_class", 8);
    set("defense_bonus", 3);
    set("no_sale", 1);
    set("prevent_drop", 1);
}

void unequip(int silent)
{
    tell_object(this_player(), "新手之鞋拒绝离开你的身体!\n");
}

int remove()
{
    object p;
    p = environment(this_object());

    if (p && query("equipped"))
        ::unequip(0);
    return ::remove();
}