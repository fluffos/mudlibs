// 加了eq的sword修改好的版本
// armsword.c
//		铠魔剑
//
//		Lilia

#include <move.h>
#include "/d/zeq/knight/armor/pdyx.h"

inherit WEAPON;
string name(){ return set_color ("Sword","HIC");}
string short(){ return set_color (" 新手之剑 ","HIC"); }
void create()
{
    seteuid(getuid());
    set_name("@@name", "新手之剑");
    set_short("@@short");
    add("id", ({"sword"}));
    set_long(@C_LONG
传说中的大神为了解救新来的冒险者用天上的云彩作成了这把美丽的剑，无论从任何角度欣赏，
都令人由衷赞叹铸造者的巧思。
C_LONG
    );
    set("unit", "把");
    set("no_sale", 1);
    set("weapon_class", 10);
    set("type", "longblade");
    set("min_damage", 10);
    set("max_damage", 15);
    set("weight", 10);
    set("second", 1);
}

void wield(int silent)
{
    object p, plate, hands,feet,shield;
    string s;
    p = environment(this_object());
    s = p->query("c_name");

    if( query("wielded") ) return;
    if( !p || !living(p) ) return;
    if( userp(p) && this_object()->stop_wield(p) ) return;

     if (p->query("class") != "knight" && !wizardp(p))
    {
	tell_object(p, "只有新手冒险者才能使用新手之剑。\n");
	::unwield(0);
	return;	

    if (p->query_perm_stat("int") < 1)
    {
	tell_object(p, "这把剑的构造太复杂，你不知如何使用它。\n");
	::unwield(0);
	return;
    }

   if (wizardp(p) || p->query("npc"))
    { 
        if (p->query("armor/plate") || p->query("armor/hands") || p->query("armor/feet")|| p->query("armor/shield"))
        {
            tell_object(p, "你必须卸下与新手之剑冲突的护具才能装备新手之剑。\n");
	    ::unwield(0);
	    return;
        }
    }
    else
    {
	if (p->query("armor/body"))
	{
	    tell_object(p, "你必须卸下与新手之剑冲突的护具才能装备新手之剑。\n");
            ::unwield(0);
            return;
        }
    }

    tell_room(environment(p), set_color(sprintf("\n%s将新手之剑高高举起，大喝一声：「神啊，给予我神圣的力量吧！」\n\n", p->query("c_name")), "HIR"), p);
    tell_object(p, set_color("\n你将新手之剑高高举起，大喝一声：「神啊，给予我神圣的力量吧！」\n\n", "HIR"));
    tell_object(p, set_color("新手之剑呼应著你的勇气，幻化出一整套武器装备。\n\n", "HIR"));

    plate = new(ARM"plate");
    plate->move(p);
    plate->equip(1);
    tell_object(p, "你顺利地穿上新手之甲。\n");
    tell_room(environment(p), s+"顺利地穿上新手之甲。\n", p);
    p->calc_armor_class();

    if (wizardp(p) || p->query("npc"))
    {
        
        hands = new(ARM"hands");
        hands->move(p);
        hands->equip(1);
        tell_object(p, "你顺利地戴上新手之手套。\n");
	tell_room(environment(p), s+"顺利地戴上新手之手套。\n", p);
        p->calc_armor_class();
        feet = new(ARM"feet");
        feet->move(p);
        feet->equip(1);
        tell_object(p, "你顺利地穿上新手之鞋。\n");
	tell_room(environment(p), s+"顺利地穿上新手之鞋。\n", p);
        p->calc_armor_class();
	shield = new(ARM"shield");
        shield->move(p);
        shield->equip(1);
        tell_object(p, "你顺利地拿起新手之盾。\n");
	tell_room(environment(p), s+"顺利地拿起新手之盾。\n", p);
        p->calc_armor_class();
    }

    tell_room(environment(p), set_color("新手之剑幻化出一套盔甲，顺利地穿在"+p->query("c_name")+"的身上!\n", "HIY"), p);
    set("prevent_drop", 1);
    set("wielded", 1);
    p->calc_weapon_class();
}

void unwield(int silent)
{
    object p, firstwep, secondwep, plate, hands, feet,shield;

    p = environment(this_object());

    // quit 或装备被吃掉 (如大国师)
    if (p->query("armor/body"))
    {
    	plate = p->query("armor/body");
	plate->remove();
    }

    if (wizardp(p) || p->query("npc"))
    {

	if (p->query("armor/feet"))
        {
            feet = p->query("armor/feet");
            feet->remove();
        }
	
	if (p->query("armor/hands"))
        {
            hands = p->query("armor/hands");
            hands->remove();
        }
	if (p->query("armor/shield"))
        {
            shield = p->query("armor/shield");
            shield->remove();
        }
	
}

    set("prevent_drop", 0);

    ::unwield(0);

}
