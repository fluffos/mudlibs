#include <mudlib.h>

inherit MONSTER;
inherit MOUNT;

void create() {

  ::create();
  set_level(19);
  set_name("Fire Phoenix", set_color("不死鸟浴火凤凰", "HIR"));
  add("id", ({ "Fire phoenix", "phoenix", "bird" }));
  set_short(set_color("不死鸟浴火凤凰", "HIR"));
  set_long(
    "不死鸟浴火凤凰全身都是火。据说每隔六百年她会冲进火山口中\n"
    "，重新获得新生命。传说喝了她的血可以长生不死。\n"
  );

  set("max_hp", 4000);
  set("max_sp", 4000);
  set("hit_points", 4000);
  set("spell_points", 4000);
  set_natural_armor(35, 35);
  set_natural_weapon(35, 30, 50);
  set("gender", "female");
  set("unit", "只");
  set("exp_reward", 50000);
  set("immortal", 1);
  set("max_load", 50000);
  set_c_limbs(({ "头部", "身体", "後腿", "尾巴" }));
  set("c_death_msg", "%s说：主人，请接受我的效忠！说著说著化成一把长刃....\n");
  set("alt_corpse", "/d/zeq/firesword");

}

void init() {
  mount::init();
}
