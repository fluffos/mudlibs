#include <mudlib.h>

inherit ARMOR;

void create() {
  set_name("Wind Shield", "云盾");
  add("id", ({ "shield" }));
  set_short("蓝色的云盾");
  set_long(@LONG
这是用天上的七色云彩炼化而成。
LONG
  );
  set("unit", "面");
  set("power_on", 1);
  set("no_clean", 1);
  set("type", "shield");
  set("material", "element");
  set("armor_class", 100);
  set("defense_bonus", 100);
  set("special_defense", ([ "all": 100, "none": 100 ]));
  set("weight", 100);
  set("no_sale", 1);
  set("value", ({ 1500, "gold" }));
  set("equip_func", "daemon_wear");
  set("unequip_func", "daemon_unwear");
}



void daemon_wear() {
  if ((string)this_player()->query("race") == "daemon" ||
    (string)this_player()->query("class") == "mage" ||
    (string)this_player()->query("class") == "knight") {
    if ((int)this_player()->query_level() < 4) {
      tell_object(this_player(),
        "你的魔力太小，不足以使盾将光之云翳伸展出来....\n");
    } else {
      set("prevent_drop", 1);
      set("armor_class", 200);
      set("defense_bonus", 200);
      set("light", 1);
      set("extra_look", "@@color");
      set("special_defense", ([ "all": 50, "none": 30 ]));
      write(set_color(
        "\n云盾呼应著你的魔力，从你的身体毛孔里发出七色的云雾逐渐伸展拢罩在你的四周...\n\n"
        , "HIW"));
      tell_room(environment(this_player()), set_color(
        "\n云盾缓缓的在" + this_player()->query("c_name") +
        "的身前身后“长”出七色的巨大云雾.........\n\n"
        , "HIY"), this_player());
      set_name("Wind Rain", "云 雨 之 夜");
      set_short("云 雨 之 夜");
    }
    return;
  }
  return;
}

void daemon_unwear() {
  object holder;
  if (!this_object()) return;
  if (!holder = environment(this_object())) return;
  holder = this_player();
  if ((int)holder->query_level() >= 4) {
    set("armor_class", 100);
    set("defense_bonus", 100);
    set("light", 0);
    delete("extra_look");
    set("prevent_drop", 0);
    if ((string)holder->query("race") == "daemon" ||
      (string)holder->query("class") == "mage" ||
      (string)holder->query("class") == "knight") {
      tell_object(holder, set_color(
        "\n你脱手後，七片七色云彩缓缓的散去，恢复成平凡的蓝色小盾...\n\n"
        , "HIB"));
      tell_room(environment(holder), set_color(
        "\n" + holder->query("c_name") +
        "身前的七色云彩缓缓的散去，变成一面泛着蓝色光芒的小盾...\n\n"
        , "HIB"), holder);
    };
    set_name("WIND Shield", "云盾");
    set_short("蓝色的云盾");
    return;
  } else return;
}

string color() {
  return set_color("拢罩著七色云雾的$N身影在你眼前模糊，仿佛与自然融为了一体...\n", "HIW");
}
