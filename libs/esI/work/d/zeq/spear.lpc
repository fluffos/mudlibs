#include <mudlib.h>
inherit WEAPON;

void create() {
  set_name("Chen-Sean", set_color("圣枪 征神", "HIY"));
  add("id", ({ "spear", "polearm" }));
  set_short(set_color("圣枪 征神", "HIY"));
  set_long(
    "这是一柄金黄色的长枪，枪身散发著凛冽的圣气，而且似乎锋利无比，它厚重的\n"
    "枪身让你觉得需要强大的力量才能运用自如。\n"
  );
  set("unit", "柄");
  set("weapon_class", 48);
  set("second", 1);
  set("type", "polearm");
  set("min_damage", 24);
  set("max_damage", 43);
  set("hit_func", "weapon_hit");
  set("extra_look", set_color(
    "\n$N手里拿着天下第一神兵-= 征 神 =-，眼中发射出强烈的“傻”气...\n\n", "HIY"));
  set("weight", 180);
  set("value", ({ 2000, "gold" }));
}

int weapon_hit(object victim, int damage) {
  object owner, target;
  int strr, t_strr, sp, dam, ali;

  owner = environment();
  target = owner->query_attacker();
  strr = owner->query_stat("str");
  t_strr = target->query_stat("str");
  sp = owner->query("spell_points");
  ali = owner->query("alignment");
  if (ali > 5000) dam = (strr - t_strr) * 5;
  else dam = (strr - t_strr) * ali / 1000;

  if (random(strr - t_strr) > 3 && sp > 8) {
    tell_object(owner, set_color(
      "\n你强大的力量突破敌人的防御，同时征神散射出一道金黄色的圣光，直劈敌人的要害。\n\n", "HIY"));
    tell_room(environment(owner),
      set_color(owner->query("c_name") + "手中的征神散射出一道金黄色的圣光，直劈敌人的要害。\n\n", "HIY")
      , owner);
    victim->receive_special_damage("divine", dam);
    owner->add("spell_points", -8);
    return dam;
  }
}
