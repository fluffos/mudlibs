ob_data (["c_short.text":"冒险者留言板","short.text":"Adventurer's bulletin board","c_long.text":"这是一个留言板，专供人留言纪事。详细用法请参看 help board。由於冒险者公会是属於大家的，因此任何人都欢迎在这里留言。","short":"@@query_short","silent_look":1,"long.text":"这是一个留言板，专供人留言纪事。详细用法请看 help board。","c_name":"留言板","id":({"board","bulletin board",}),"long":"@@query_long","name":"board",])
