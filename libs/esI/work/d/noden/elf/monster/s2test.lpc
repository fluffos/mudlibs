#include <mudlib.h>

inherit MONSTER;

void create()
{
        ::create();
        set_level(9);
        set_name("big snake", "巨蟒蛇");
        set_short("巨蟒蛇");
        set_long(
@C_LONG
这是一条凶猛巨大的大蟒蛇，看它肥胖的身躯，不知吞下多少东西！
C_LONG
        );
        set( "unit", "条" );
//        set( "pursuing", 1 );
//        set( "aggressive", 1 );
	set("exp_reward", 365 );
        set( "moving", 1 );
        set( "speed", 20 );
        set( "patrol", ({ "north","south"}) );
//        set( "killer", 1 );
        set( "alignment", -400 );
        set( "natural_weapon_class1", 8 );
        set( "natural_min_damage1", 4 );
        set( "natural_max_damage1", 5 );
        set_c_limbs( ({ "头部", "肥肥的身体", "粗粗的尾巴" }) );
        set_c_verbs( ({ "%s用力扭动，往%s卷去" }) );
}
void die()
{
    
    object ob1,ob2;
    
    ob1=query("last_attacker");
    tell_object(ob1,
".......你得到一块肉，也许可以拿去换钱！！.........\n");
    ob2->move(environment(this_player()));
  ::die(0);
}
