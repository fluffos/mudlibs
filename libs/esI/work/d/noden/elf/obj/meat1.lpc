#include <mudlib.h>

inherit PILL;

#define DECAY_TIME 1

int decay;

void create()
{
        ::create();
        decay = 3;
	set_name("Meat", "肉块（测试版）");
	add( "id", ({ "meat","meat" }) );
	set_short( "肉块" );
	set_long( @LONG
           不知从什么动物身上取得的肉。
LONG
);
        set("unit","块");
        set_healing(6);

        set("value",({50,"silver"}) );
	set( "medication", 0 );
	set( "effect_critical", 0 );

        set( "weight", 3 );
        call_out("decay", DECAY_TIME);
}

void decay()
{
   decay -= 1;
   if(decay > 1) {
	set_name("Meat", "发酸的肉块");
	add( "id", ({ "meat","meat" }) );
	set_short( "发酸的肉块" );
	set_long( @LONG
           不知从什么动物身上取得的肉。但它已有点变质了。
LONG
);
        set_healing(4);
        set("value",({35,"silver"}) );
	set( "medication", 20 );
	set( "effect_critical", 100 );
      call_out("decay", DECAY_TIME);
      return;
   }
   if(decay > 0) {
	set_name("Meat", "腐烂的肉块");
	add( "id", ({ "meat","meat" }) );
	set_short( "腐烂的肉块" );
	set_long( @LONG
           不知从什么动物身上取得的肉。它已经腐烂了。粘粘的看起来很恶心。
LONG
);
        set_healing(2);
        set("value",({10,"silver"}) );
	set( "medication", 50 );
	set( "effect_critical", 300 );
      call_out("decay", DECAY_TIME);
      return;
   }
   tell_object(this_player(),"你身上的肉块彻底烂掉了，你赶紧把它丢掉。\n");
   remove();
   return;
}