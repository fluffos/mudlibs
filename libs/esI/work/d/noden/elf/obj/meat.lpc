#include <mudlib.h>
inherit PILL;
void create() {
  pill::create();
#include <compress_obj.h>
  set_name("meat", "肉块");
  add("id", ({ "meat" }));
  set_short("肉块");
  set_long(@C_LONG
这是一块不知从什麽东西身上割下来的肉块
C_LONG
  );
  set_healing(4);
  set("unit", "块");
  set("weight", 20);
  set("value", ({ 50, "silver" }));
  set("medication", 0);
  set("effect_critical", 0);
}
