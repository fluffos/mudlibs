#include <mudlib.h>

void create(object ob) {
  if (!ob) return;
  ob->set_name("fat farmer", "胖农夫");
  ob->add("id", ({ "farmer" }));
  ob->set_short("胖农夫");
  ob->set_long(
    "这位农夫长得胖胖的，看起很老实。\n"
  );
  ob->set_level(1);
  ob->set("exp_reward", 135);
  ob->set_perm_stat("str", 3);
  ob->set_skill("dodge", 15);
  ob->set_natural_armor(10, 2);
  ob->set("wealth/silver", 5);
  ob->set("alignment", -50);

  ob->set("chat_chance", 5);
  ob->set("chat_output", ({
    "胖农夫自言自语的说道:孩子他妈，这孩子的病可咋办呀？ ！\n",
  }));

  ob->wield_weapon("/d/noden/item/fork");

  ob->equip_armor("/d/noden/item/hat");
}
