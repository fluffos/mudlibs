#include <mudlib.h>

inherit ARMOR;

void create()
{
        set_name( "Spark Leggings","雅典娜闪亮胫甲" );
        add( "id", ({ "leggings","spark leggings" }) );
        set_short( "雅典娜闪亮胫甲" );
        set_long(
                "希腊战神雅典娜最喜爱的胫甲，闪闪发光，看来似乎不错。\n"
        );
        set( "unit", "只" );
        set("material","knight");
        set( "type", "legs" );
        set( "armor_class", 1 );
        set( "defense_bonus", 1 );
        set( "weight", 50 );
        set( "value", ({ 4700, "silver" }) );
}