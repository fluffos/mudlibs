#include "/d/zeq/knight/armor/pdyx.h"

inherit ARMOR;
string name() { return set_color("magic ring", "HIG"); }
string short() { return set_color("铠之魔戒", "HIG"); }

void create() {
  set_name("@@name", "铠之魔戒");
  add("id", ({ "ring" }));
  set_short("@@short");
  set_long("由铠魔剑幻化而成的魔力戒指。\n");
  set("unit", "枚");
  set("type", "finger");
  set("material", "knight");
  set("armor_class", 20);
  //      set("defense_bonus",20);
  set("weight", 0);
  set("no_sale", 1);
  set("prevent_drop", 1);
}
void unequip(int silent) {
  tell_object(this_player(), "铠之魔戒拒绝离开你的身体!\n");
}

int remove() {
  object p;
  p = environment(this_object());

  if (p && query("equipped"))
    ::unequip(0);
  return ::remove();
}
