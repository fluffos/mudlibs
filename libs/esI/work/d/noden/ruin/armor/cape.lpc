// cape.c

#include "/d/zeq/knight/armor/pdyx.h"

inherit ARMOR;
string name() { return set_color("magic cape", "YEL"); }
string short() { return set_color("铠魔披风", "YEL"); }
void create() {
  set_name("@@name", "铠魔披风");
  add("id", ({ "cape" }));
  set_short("@@short");
  set_long("由铠魔剑的魔力幻化而成的披风。\n");
  set("unit", "件");
  set("weight", 0);
  set("type", "cloak");
  set("material", "knight");
  set("armor_class", 8);
  //    set("defense_bonus", 3);
  set("no_sale", 1);
  set("prevent_drop", 1);
}

void unequip(int silent) {
  tell_object(this_player(), "铠魔披风拒绝离开你的身体!\n");
}

int remove() {
  object p;
  p = environment(this_object());

  if (p && query("equipped"))
    ::unequip(0);
  return ::remove();
}
