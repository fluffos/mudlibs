#include <mudlib.h>
inherit ARMOR;

void create() {
  if (clonep(this_object())) {
    set_default_ob(__FILE__);
    return;
  }
  set_name("peg boots", "钉鞋");
  add("id", ({ "boots" }));
  set_short("Peg boots", "钉鞋");
  set_long(@AAA
这是一双钉鞋。
AAA
  );
  set("unit", "双");
  set("type", "feet");
  set("armor_class", 3);
  set("material", "light_metal");
  set("weight", 32);
  set("value", ({ 100, "silver" }));
}
