ob_data (["c_cap_name":"留言板","last_location":0,"c_name":"留言板","long.text":"This is a bulletin board. For information on how to use it, use `help board'.","silent_look":1,"c_long.text":"这是一个留言板，专供人报告 BUGS 。详细用法请参看 help board。由於 ES 是属於大家的，因此希望任何人都在此报告所发现的 BUGS 。","name":"board","short":"@@query_short","c_long":"@@query_c_long","c_short":"@@query_c_short","c_short.text":"ES BUGS 留言板","short.text":"ES bugs board","long":"@@query_long","id":({"board","bulletin board",}),"cap_name":"Board",])
messages ({(["title":"公告","id":1719,"time":1011585533,"body":"魔法师 新增召唤技能，可以召唤等级为10的 魔兽，具体功用自己看着办！","poster":"Snow",]),(["title":"新手侃侃1","id":1722,"time":1012406046,"body":"1.  善用look指令可以让你避开许多危险。因此对於你不熟悉的区域，请先look下 一个房间後再走。2.  每一个公会附近都有可能会导致许多主动攻击怪兽出现的事件，并且是可以由玩家所触发的，所以请自行保重。3.  东方故事目前共有三个大陆，除了一开始的诺顿大陆外，尚有东方大陆以及死亡大地，你可以由港口搭船前往其他的大陆。在冒险者公会有一张诺顿大陆的全图，对於新玩家相当具有参考价值。4.  如果你使用的连线程式支援VT100终端机，请键入set vt100 color，如此你可以享有一个充满色彩的东方故事!!希望你能很快地熟悉这个美丽又可爱的「 东方故事 」!!","poster":"Snow",]),(["title":"新手侃侃1地图","id":1723,"time":1012406086,"body":"{help map_noden.txt          诺顿大陆地图       :     help map_island.txt         谪仙岛地图;help map_east.txt           东方大陆地图       :     help map_ruoland.txt        若岚城地图;help map_ndcity.txt         诺达尼亚城地图     :     help map_magecity.txt       摩亚达城地图;help map_jinming.txt        津鸣城地图         :     help map_youguo.txt         幽国城地图;help map_bluesand.txt       蓝沙港地图         :     help map_farwind.txt        远风镇地图;help map_haiwei.txt         海威镇地图         :     help map_gumei.txt          古梅镇地图;help map_mumar.txt          牧马关地图         :     help map_shaolin.txt        少林寺地图;help map_kuangshi.txt       旷世村地图         :     help map_yanyu.txt          烟雨村地图;help map_dwarf.txt          矮人村地图         :     help map_city.txt           矮人国地图;help map_xindan.txt         薪胆村地图         :     help map_grass.txt          大草原地图;help map_drow.txt           黑暗精灵村地图     :     help map_elf.txt            精灵村地图;help map_xiyi.txt           蜥蜴人王宫地图     :     help map_wushibao.txt       武士堡地图;help map_dmine.txt          矮人矿坑地图       :}","poster":"Snow",]),(["title":"工会地点","id":1725,"time":1012414291,"body":"骑士(knight) gc.5n.8w.5n.3e魔法师(mage) gc.5n.9w.7s.enter tower","poster":"Snow",]),(["title":"医生和小偷工会地址","id":1726,"time":1012414505,"body":"医生(healer) gc.6s.3e.2s.open door小偷(thief) gc.6s.3e.3s.touch statuel","poster":"Snow",]),(["title":"关于中毒解毒","id":1727,"time":1012484922,"body":"新来得的玩家，常常被一些有毒的小动物伤害，所以我们特地在远风的药店卖解毒药。请大家需要的时候去购买。","poster":"Snow",]),(["title":"新手的装备","id":1731,"time":1012553977,"body":"新来的冒险者没有经过训练，不能对付野外的猛兽．所以　冒险者工会的前辈们特地委托优秀的铁匠smith先生订做一些武器供新手们防身．具体情况请问smith先生有关sword的问题．不过smith先生好象有什么要求才能答应你哦.而且你还的聪明才行.","poster":"Mage",]),(["title":"关于一些基本的explore","id":1732,"time":1012575729,"body":"东方部分：海港要好好转转，古梅镇有一个道观好好找找，烟雨村的任务做了，少林里有好多注意该敲的摸的亲的都做了木马关里多转转，尤其是一个platform的地方，梁山无用的棋盘死亡大陆：LUCKSIS的任务，和lucksis旁边的2个人说说话会有很多提示的，在矿井里用稿多挖挖会有发现，一些井最好进去看看诺顿大陆：最好每个地方都看看，能加的地方很多，不列举了","poster":"Power",]),(["title":"魔神宫殿","id":1734,"time":1047710751,"body":"新推出 魔神宫殿 地下12层一日游 请各位有志青年快来报名.uwho -l请等级19以上英雄探险游，巫师将提供最新装备以及十全大补丸供各位帅哥靓妹使用 机不可失哦 速速报名 .","poster":"Pdyx",]),})
