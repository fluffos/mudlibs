//  snake
//  yogi@163.net
//  99/09/9
//  yogi.163.net
#include <mudlib.h>
inherit ROOM;

object p;

void create() {
  set("short", "中级冒险训练教室");
  set("long", @LONG
你来到一间小小的教室, 前面的墙上一样有一块黑板, 上面写著：

    这里我们要教给你的是三个很重要的指令：hp, skills, 与score。
score与hp两个指令都是用来看自己的状况的, skills则是用来看自己学过的
技能。你现在可以试试看使用这几个指令。
LONG);
  set("exits", ([ "south": __DIR__ "basic2-who.lpc", ]));
  set("pre_exit_func", ([ "south": "exit_south" ]));
  set("light", 1);
  set("no_cast", 1);
  set("no_enhant", 1);
  reset();
}

void init() {
  p = this_player();

  p->set_temp("basic1-1", 0);
  p->set_temp("basic1-2", 0);
  p->set_temp("basic1-3", 0);

  write(@look
你把七份文件都摆整齐, 在笔记本上记下公会名称, 然后往出口走了出去。
look);
  if (p->query("basic1") <= 14) { p->set("basic1", 14); }

  add_action("command_hp1", "hp");
  add_action("command_skills1", "skills");
  add_action("command_score1", "score");
}

int exit_south() {
  if (p->query_temp("basic1-1") != 1 || p->query_temp("basic1-2") != 1 || p->query_temp("basic1-3") != 1) {
    write("你感觉对hp, skills, 与score还不是很熟悉，觉得再多了解一下比较好！\n");
    return 1;
  }
  return 0;
}

int command_hp1() {
  call_out("hp", 1, p);
  p->set_temp("basic1-1", 1);
  if (p->query_temp("basic1-1") == 1 && p->query_temp("basic1-2") == 1 && p->query_temp("basic1-3") == 1) {
    call_out("end", 1, p);
    return 0;
  }
  return 0;
}

void hp() {
  write(@look
一个年轻可爱的女孩的声音传了出来：「您好, 这里由我为您解说。」
「hp指令是score 指令的简化。在战斗中您可能没有时间用score指令来看,
这时您可以用hp指令来观察自己状态。『体力』是您的生命力, 当您的体力
降到零以下时您就会死亡, 所以要随时注意补充自己的体力。『精神力』就
是您的法力, 若您要施魔法, 就必须要用到法力, 法力不够就无法施法。除
了魔法以外还有其他许多可能会用到精神力的事情。『交谈能力』是您与别
人沟通的能力。我们在等一下会告诉您要如何与他人沟通。」
look);
}

int command_skills1() {
  call_out("skills", 1, p);
  p->set_temp("basic1-2", 1);
  if (p->query_temp("basic1-1") == 1 && p->query_temp("basic1-2") == 1 && p->query_temp("basic1-3") == 1) {
    call_out("end", 1, p);
    return 0;
  }
  return 0;
}

void skills() {
  write(@look
那个令你陶醉的声音又传了出来：
「skills指令是让您看到您所学过的技能。技能是在各公会学的, 您决定加
入哪一种职业的公会之后, 他们将会负责训练您的技能, 以及为您升级。学
习技能的方法您可以到各公会的所在地去查询。」
look);
}

int command_score1() {
  call_out("score", 1, p);
  p->set_temp("basic1-3", 1);
  if (p->query_temp("basic1-1") == 1 && p->query_temp("basic1-2") == 1 && p->query_temp("basic1-3") == 1) {
    call_out("end", 1, p);
    return 0;
  }
  return 0;
}

void score() {
  write(@look
那个让你意犹未尽的声音又响了起来：
「您下score指令后看到的第一行是您的姓名与等级。
『状态』指的是别人看到的您, 包括您的种族, 年龄与外观。
『经验』当然是您升级时的重要依据罗。『阵营』指的是您现在是好人还是坏人。
『状况』指的是您的身体状况。如果乱服药太多的话会有后遗症哦。
接下来的『体力』、『精神力』与『交谈能力』您可以参考hp的说明。
最后几行有六个数值, 是您的属性, 影响到您各方面的能力, 也是升级时的
重要依据哦。」
look);
}

void end() {
  write(@look
你觉得对这三个指令都很熟悉了, 差不多可以离开了。
look);
}
