//  snake
//  yogi@163.net
//  99/09/9
//  yogi.163.net
#include <mudlib.h>
inherit ROOM;

void create() {
  set("short", "中级冒险训练教室");
  set("long", @LONG
你来到一间小房间。跟前面的教室不太一样, 这里看起来有点像是卧
室。里面有一个和蔼可亲的老人, 坐在一张沙发(sofa)上亲切的对你微笑
著。另外还有一张单人床(bed) 。床的旁边有一小罐药品(medicine), 你
不禁有点好奇那小小的药品是什么东西。
LONG);
  set("exits", ([ "north": __DIR__ "basic2-say.lpc", ]));
  set("pre_exit_func", ([ "north": "exit_north" ]));
  set("objects", ([ "oldman": __DIR__ "item/oldman.lpc" ]));
  set("item_desc", ([
    "sofa": "你看看那张沙发, 突然觉得两脚很酸, 只可惜老人坐在沙发上, 你没办法坐。\n",
    "bed": "你看看那张床, 上面乱七八糟的, 没办法坐。\n"
  ]));
  set("item_func/medicine", "look_at_medicine");
  set("light", 1);
  set("no_cast", 1);
  set("no_enhant", 1);
  reset();
}

void init() {
  object p;
  p = this_player();

  p->set_temp("basic1-1", 0);
  p->set_temp("basic1-2", 0);

  write(@look
你拿出笔记本, 记下了who 的用法。然后轻飘飘地往出口走去。

look);
  p->set("basic1", 16);
}

int exit_north() {
  object p;
  p = this_player();
  if (p->query_temp("basic1-1") != 1 || p->query_temp("basic1-2") != 1) {
    write("你感觉对ask的用法还不是很熟悉，觉得再多练习一下比较好！\n");
    return 1;
  }
  return 0;
}

int look_at_medicine() {
  object p;
  p = this_player();
  write(@look
你拿起那小小的药瓶想看个仔细, 却发现上面没有任何标签。
老人看著你笑了笑, 说：「对那药瓶很好奇是吗? 冒险的过程中多多好
奇是好事。当你在解任务的过程中, 想要从像我这种非玩家的角色身上
获得线索时, 可以用ask 指令来问。ask 的语法你只要直接打ask 就会
告诉你了。例如当你想问我那罐药(medicine)的事情, 你可以打
"ask oldman about medicine"或"ask man about medicine"。」
look);
  p->set_temp("basic1-1", 1);
  add_action("command_ask", "ask");
}

int command_ask(string ob) {
  object p;
  string s1, s2, s3;

  p = this_player();

  if (!ob) return 0;
  if (sscanf(ob, "%s %s %s", s1, s3, s2) < 3)
    return 0;
  if ("oldman" != s1 || s3 != "about")
    return 0;
  if (s2 == "medicine") {
    write(@look
老人微笑著对你说：「你把它打开来看看吧。」

你把瓶盖打开来, 从里面拿出一片铝箔包著的药丸。
铝箔上面印著：威而钢(Viagra)。

你突然看到老人用很锐利的眼神盯著你全身上下瞧著, 嘴角露出残忍的微笑, 
你不禁颤抖了一下。想起自己全身上下光溜溜的, 赶忙把药放回原位, 
手护著自己的重要部位, 臀部也不禁紧紧的夹著, 希望能赶快离开。
look);
    p->set_temp("basic1-2", 1);
    return 1;
  }
  return 0;
}
