#include <mudlib.h>
inherit ROOM;

object p;

void create ()
{
set ("short", "基础冒险训练教室");
set ("long", @LONG
你来到一个比较大, 而且很空旷的教室。墙上同样有一个黑板, 但是
这回黑板上并没有写任何字。
LONG);
set("exits", ([ "south" : __DIR__"basic1-give.lpc", ]));
set("pre_exit_func", ([ "south" : "exit_south" ]));
set( "objects", ([ "stick" : __DIR__"item/stick.lpc" ]) );
set("light",1);
set("no_cast",1);
set("no_enhant",1);
reset();
}           

void init()
{
     p = this_player();

     p->set_temp("basic1-1", 0);
     p->set_temp("basic1-2", 0);

     write (@look
你拿出笔, 歪歪扭扭地在你的笔记本上记下了search的用法。然后往出口走了出去。

look);
     if ( p->query("basic1") <= 6 ) { p->set("basic1", 6) ;}
     call_out( "welcome1", 1, p );
     add_action("command_get","get") ;
}

void welcome1()
{
        write (@look
你看著地上的那一枝拐杖, 觉得有点好奇。心想把它拿起来(get)看看吧。
不久班主任的声音又传到了你的耳边：「用get stick可以把那支拐杖拿起
来。用get all则可以把地上所有的东西都拿起来。试试看吧, 孩子。」
look);
}

int exit_south()
{
       if ( p->query_temp("basic1-1")!=1 || p->query_temp("basic1-2")!=1 )
       {
           write ("你感觉对get和drop的用法还不是很熟悉，觉得再多练习一下比较好！\n");
           return 1 ; 
       } 
       return 0;
}

int command_get(string ob)
{
     object obj ;

     if( !ob ) {
       return 0 ; 
     }

     if( ob == "stick" || ob == "all" ) {
        remove_action("command_get","get") ;
        obj = new( __DIR__"item/stick.lpc" );
        obj->move(p);
        write (@look
你捡起一把拐杖。
look);
        call_out( "get", 1, p );
        p->set_temp("basic1-1", 1);
        add_action("command_drop","drop") ;
        add_action("command_get2","get") ;
        return 1;
     } 
     return 0;
}

void get()
{
        write (@look
你仔细地把玩著这枝拐杖, 发现其实没有什么特别的地方。有点像是海盗
在用的那种拐杖。班主任又说：「你可以用drop stick来把身上的这根拐　
杖丢掉。你也可以用drop all来把身上所有可以丢的东西丢掉。」
look);
}

int command_drop(string ob)
{
     object obj ;

     if( !ob ) {
       return 0 ; 
     }
     if( ob == "stick" || ob == "all" ) {
       obj = present("stick", p);
//       obj->move(environment(p));
       obj->remove();
//       remove_action("command_drop","drop") ;
        write (@look
你丢下一把木质拐杖。
look);
       call_out( "drop", 1, p );
       p->set_temp("basic1-2", 1);
       remove_action("command_drop","drop") ;
       add_action("command_drop2","drop") ;
       return 1 ; 
     } 
     return 0;
}

void drop()
{
       write (@look
你看了看这间大房间, 没什么其他好玩的地方了。你想你可以准备离开了。
look);
}

int command_get2(string ob)
{
     if( !ob ) {
       return 0 ; 
     }
     if( ob == "stick" || ob == "all") {
        call_out( "drop", 1, p );
        return 1;
     } 
     return 0;
}

int command_drop2(string ob)
{
     if( !ob ) {
       return 0 ; 
     }
     if( ob == "stick" || ob == "all") {
        call_out( "drop", 1, p );
        return 1;
     } 
     return 0;
}
