#include <mudlib.h>

inherit MONSTER;

void create() {
  ::create();
  set_level(20);
  set_name("master", "东方学园班主任");
  add("id", ({ "master" }));
  set_short("master", "东方学园班主任");
  set("unit", "位");
  set_long(@ANGEL
你看到一个浓眉大眼, 黑黑壮壮的青年人, 有韵味的眼睛透出闪闪发亮的
眼神。他就是被东方故事诸神委托开设冒险训练班 -- 东方学园的人。
ANGEL
  );
  set("no_attack", 1);
  set("gender", "male");
  set("race", "human");
}
