#include <mudlib.h>
inherit ROOM;
void create() {
  set("short", "仓库");
  set("long", @LONG
这里是东方学园的仓库, 堆满了杂物, 充满了灰尘。地上散放著一堆
奇形怪状的物体, 散发出浓浓的臭味, 一股不详而诡异的恐惧感升上你的
心头。
LONG);

  set("exits",
    ([
      "south": "../basic1-look2.lpc",
    ]));
  set("light", 1);
  reset();
}
