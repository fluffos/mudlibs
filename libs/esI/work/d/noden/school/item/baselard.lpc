#include <mudlib.h>

inherit WEAPON;

void create()
{
        set_name( "baselard", "短刀" );
        add( "id", ({ "baselard" }) );
        set_short( "短刀" );
        set_long(
                "这是一把短刀。\n"
        );
        set( "unit", "把" );
        set( "type", "dagger" );
        set( "weapon_class", 11 );
        set( "min_damage", 4 );
        set( "max_damage", 9 );
        set( "weight", 10 );
        set( "value", ({ 10, "silver" }) );
}
