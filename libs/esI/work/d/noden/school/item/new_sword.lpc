#include <mudlib.h>

inherit WEAPON;

void create() {
  //        seteuid(getuid());
  set_name("sword", "锋利的短剑");
  set_short("锋利的短剑");
  set("id", ({ "sword" }));
  set_long(@C_LONG
这是一把小小的剑, 虽然小但看起来很锋利。这是专门给新手使用的武器，
所以不能随便乱丢, 也不能随便给别人用, 否则就会消失不见喔。
C_LONG
  );
  set("unit", "把");
  set("type", "shortblade");
  set("weapon_class", 11);
  set("min_damage", 4);
  set("max_damage", 9);
  set("weight", 15);
  set("prevent_drop", 1);
  set("prevent_get", 1);
  set("prevent_insert", 1);
  set("value", 0);
}
