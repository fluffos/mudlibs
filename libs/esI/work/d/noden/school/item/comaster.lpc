#include <mudlib.h>

inherit MONSTER ;

void create ()
{
        ::create();
        set_level(1);
        set_name("comaster","东方学园副班主任" );
        add ("id", ({ "comaster"}) );
        set_short( "comaster","东方学园副班主任");
        set("unit","位");
        set_long(@ANGEL
东方学园副班主任长剑一挥，斩向你前胸，但是没有造成任何伤害。
一个年仅十三四岁的男孩, 长得跟东方学园的班主任很像, 似乎是父子。
ANGEL
        );
        set( "max_hp", 600 );
        set( "hit_points", 600 );
        set ("gender", "neutral");
        set ("race", "undead");
        set ("killer",1);
        wield_weapon(__DIR__"sword");
}

