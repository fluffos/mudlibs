#include <mudlib.h>

inherit OBJECT;

void init() {
  add_action("do_read", "read");
}

void create() {
  set_name("Notebook", "笔记本");
  add("id", ({ "notebook" }));
  set_short("笔记本");
  set_long(@C_LONG
这是一本笔记本, 你可以把在东方学园内学到的东西记在本子上。
用read notebook可以看看你以前记下来的东西。
C_LONG
  );
  set("unit", "本");
  set("no_sale", 1);
  set("no_drop", 1);
  set("prevent_drop", 1);
}

int query_auto_load() {
  return 1;
}

int do_read(string str) {

  object p;
  int lv;

  p = environment(this_object());

  if (str != "notebook")
    return notify_fail("读什麽?\n");

  lv = p->query("basic1");
  if (lv)
    tell_object(p, "你的笔记栏上面写著：\n\n");
  else
    return notify_fail("那上面一片空白，什麽也没有。\n");

  if (lv >= 1)
    tell_object(p, "1. 用look或l可以看四周环境, 用look <某物品名>可以看这个东西。\n");
  if (lv >= 2)
    tell_object(p, "2. 用inventory或i可以看身上有什么东西。\n");
  if (lv >= 3)
    tell_object(p, "3. look <身上的某物品> 可以看看身上的某些特定物品。\n");
  if (lv >= 4)
    tell_object(p, "4. 四周黑暗时, 如果身上有火把可以用light torch点燃火把。\n");
  if (lv >= 5)
    tell_object(p, "5. 火把亮著时可以用unlight torch熄灭火把。\n");
  if (lv >= 6)
    tell_object(p, "6. 用search可以搜查房间, search <某物品>可以搜查这个东西。\n");
  if (lv >= 7)
    tell_object(p, "7. 用get <某物品>或drop <某物品>可以拿起或丢下某物品。\n");
  if (lv >= 8)
    tell_object(p, "8. 用get all可以拿起所有在地上的东西。\n");
  if (lv >= 9)
    tell_object(p, "9. 用drop all可以丢下所有身上可以丢的东西。\n");
  if (lv >= 10)
    tell_object(p, "10. 用give <某物品> to <某人>可以把身上的东西给某玩家或某人。\n");
  if (lv >= 11)
    tell_object(p, "11. 用put <某物品> into bag可以把某个东西放进袋子。\n");
  if (lv >= 12)
    tell_object(p, "12. 用get <某物品> from bag可以把某个在袋子里的东西拿出来。\n");
  if (lv >= 13)
    tell_object(p, "13. 用look <方向> 可以在进入某个地方之前先观察那里有没有危险。\n");
  if (lv >= 14)
    tell_object(p, "14. 东方故事的公会有: 冒险者(adventurers), 医生(healers),\n",
      "    小偷(thieves), 和尚(monks), 书生(scholars), 骑士(knights)\n",
      "    以及魔法师公会(mages), 学技能要在公会里学。\n");
  if (lv >= 15)
    tell_object(p, "15. 用score或hp可以看自己的状况。用skills可以看自己学过的技能。\n");
  if (lv >= 16)
    tell_object(p, "16. 用who可以看线上有哪些玩家, 用who -l可以看到进一步的资料。\n");
  if (lv >= 17)
    tell_object(p, "17. 解决任务时用ask <谁> about <字>可以问非玩家问题得到线索。\n");
  if (lv >= 18)
    tell_object(p, "18. 用say <something>可以对同房间的玩家说话。其他房间的人听不到。\n");
  if (lv >= 19)
    tell_object(p, "19. 用chat <something>可以对chat频道上的玩家说话。\n");
  if (lv >= 20)
    tell_object(p, "20. 用tell <谁> <something>可以私下对某个玩家说话, 别人听不到。\n");
  if (lv >= 21)
    tell_object(p, "21. 用shout <something>可以对线上所有玩家说话。\n");
  if (lv >= 22)
    tell_object(p, "22. 用wear <某护具>可以穿上护具, 用remove <护具>可以把它脱掉。\n");
  if (lv >= 23)
    tell_object(p, "23. 用wield <武器> 可以装备武器。用unwield <武器>可以放下武器。\n");
  if (lv >= 24)
    tell_object(p, "24. 用secure <身上的物品>可以做标记, 不会被不小心丢掉。\n");
  if (lv >= 25)
    tell_object(p, "25. 用unsecure <被标记的物品>可以去掉标记。\n");
  if (lv >= 26)
    tell_object(p, "26. 用kill <目标>可以开始攻击, 只有任一方死亡或逃跑才能停止。\n");
  if (lv >= 27)
    tell_object(p, "27. 身上有外敷用药(plaster)时, 用apply plaster可以敷药。\n");
  if (lv >= 28)
    tell_object(p, "28. 身上有绷带时, 用bandage包扎, 用remove bandage解下来。\n");
  if (lv >= 29)
    tell_object(p, "29. 用help可以看许多指令的相关讯息。\n");
  if (lv >= 30)
    tell_object(p, "30. 用wimpy <hp值> <方向> 可以设定在hp降到设定值以下时自动逃跑。\n");
  if (lv >= 31)
    tell_object(p, "31. 用alias指令可以简化复杂的指令。(看help alias)。\n");
  if (lv >= 32)
    tell_object(p, "32. 用save指令可以存资料, 备份资料的话更为保险。方法可以看help save。\n");
  return 1;
}
