#include <mudlib.h>

inherit WEAPON;

void create() {
  set_name("wooden stick", "木质拐杖");
  add("id", ({ "stick" }));
  set_short("木质拐杖");
  set_long(
    "这是一根木质拐杖。\n"
  );
  set("unit", "根");
  setup_weapon("blunt", 25, 12, 29);
  set("weight", 30);
  set("value", ({ 30, "silver" }));
}
