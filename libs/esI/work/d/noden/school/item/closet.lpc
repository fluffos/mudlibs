#include <mudlib.h>

inherit OBJECT;

void create()
{
        seteuid(getuid());
	set_name("closet", "魔法橱柜");
	set_short("魔法橱柜");
	set("id", ({"closet"}) );
	set_long(@C_LONG
一个深不见底的橱柜。据说是亚默长老为了让刚进东方故事的新手更快适应
环境，而特地邀请拉修帝与半身人工匠李欧共同制作的。新手们只要对著这
个魔法橱柜请求(request)并付出十元银币后，它就会给你一套简单的装备。
C_LONG
	);
	set("prevent_get",1);
}
void init()
{
//      ::init();
      add_action("do_request","request");
}

int do_request() 
{
   object obj , p;
   p = this_player();
   
   if ( p->query_temp("closet") == 1 )
       {
           write ("你已经领过一套了，留些给其他人吧！\n");
           return 1 ; 
       } 
   if( p->debit( "silver", 10 ) ) {
      obj = new( __DIR__"new_sword.lpc" );
      obj->move(p);
      obj = new( __DIR__"new_shield.lpc" );
      obj->move(p);
      obj = new( __DIR__"new_cloth.lpc" );
      obj->move(p);
      obj = new( __DIR__"new_pants.lpc" );
      obj->move(p);
      p->set_temp("closet", 1);
     write(@look
你从投币口投下了十元硬币。
你看到橱柜里突然飞出一堆东西到你的手上，让你吓了一大跳。
橱柜里传来亚默长老亲切的声音：「好好运用吧，孩子。」
look);
     return 1;
   }
   return notify_fail(@look
橱柜里传来亚默长老亲切的声音：「孩子，装备也是要成本的。一套十元银币
对你应该不是很重的负担吧。」
look);
}
