#include <mudlib.h>

inherit MONSTER;

void create() {
  ::create();
  set_level(10);
  set_name("oldman", "老人");
  add("id", ({ "oldman" }));
  set_short("oldman", "老人");
  set("unit", "位");
  set_long(@ANGEL
一个满脸风霜, 看起来很慈祥和蔼的老人。但不知为何, 你觉得他盯著你看
的眼神总有一种说不出的恐怖。
ANGEL
  );

  set("gender", "male");
  set("race", "human");
  set("no_attack", 1);
}
