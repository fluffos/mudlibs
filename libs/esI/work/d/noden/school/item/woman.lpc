#include <mudlib.h>

inherit MONSTER;

void create() {
  ::create();
  set_level(10);
  set_name("woman", "女秘书");
  add("id", ({ "woman" }));
  set_short("woman", "女秘书");
  set("unit", "位");
  set_long(@ANGEL
这是一位女秘书，正在很焦急地找着什么东西。
ANGEL
  );

  set("gender", "female");
  set("race", "human");
  set("no_attack", 1);
  set("chat_chance", 20);
  set("chat_output", ({ "女秘书喃喃地说：「我的拆信刀放到哪儿去了? 」\n" }));
}

void reset() {
  set("chat_chance", 20);
}

int accept_item(object who, object item) {
  string name;

  name = (string)item->query("name");
  if (name == "knife") {
    item->remove();
    set("chat_output", ({ "女秘书把信一封封地拆开来看。\n" }));
  }
  return 1;
}
