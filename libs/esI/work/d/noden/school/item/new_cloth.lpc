#include <mudlib.h>

inherit ARMOR;

void create()
{
        seteuid(getuid());
        set_name( "cloth", "布衣" );
        add( "id", ({ "cloth" }) );
        set_short( "布衣" );
	set_long(@C_LONG
一件普通常见的布衣。虽然只是件布做的衣服，但你发现它的质料很耐磨，穿
起来又舒服。这是专门设计给新手使用的装备，所以不能随便乱丢, 也不能随
便给别人, 否则就会消失不见哦。衣服的正面印了几个字: 「东方学园董事长
圣人赞助。」
C_LONG
	);
        set( "unit", "件" );
        set( "type", "body" );
        set( "material", "cloth");
        set( "armor_class", 7 );
        set( "weight", 30 );
        set( "prevent_drop", 1 );
        set( "prevent_get", 1 );
        set( "prevent_insert", 1 );
	set( "value", 0 );
}
