
#include <mudlib.h>

inherit ARMOR;

void create()
{
        seteuid(getuid());
        set_name( "gray pants", "灰色长裤" );
        add( "id", ({ "pants" }) );
        set_short( "灰色长裤" );
	set_long(@C_LONG
一件普通常见的运动长裤。穿起来松松的很舒服, 不过似乎大了一点。
不过这件长裤是专门为新手设计的, 不能随便乱丢, 也不能随便给别人
用, 否则就会消失不见喔。
C_LONG
	);
        set( "unit", "件" );
        set( "type", "legs" );
        set( "material", "cloth");
        set( "armor_class", 5 );
        set( "weight", 30 );
        set( "prevent_drop", 1 );
        set( "prevent_get", 1 );
        set( "prevent_insert", 1 );
	set( "value", 0 );
}
