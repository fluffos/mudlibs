#include <mudlib.h>

inherit MONSTER ;

void create ()
{
        ::create();
        set_level(10);
        set_name("doll","人偶" );
        add ("id", ({ "doll"}) );
        set_short( "doll","人偶");
        set("unit","位");
        set_long(@ANGEL
一个跟真人一样大小的人偶, 立在房间的正中央。上面已经有很多
被刀砍过的痕迹, 你猜想这可能是用来练习攻击用的道具。
ANGEL
        );
        set ("gender", "neutral");
        set ("race", "undead");
}

