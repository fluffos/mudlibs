#include <mudlib.h>

inherit ARMOR;

void create() {
  set_name("fighter's robe", "武道服");
  seteuid(getuid());
  add("id", ({ "robe" }));
  set_short("武道服");
  set_long(
    "这是一件武道服。\n"
  );
  set("unit", "件");
  set("type", "cloak");
  set("material", "cloth");
  set("armor_class", 2);
  set("weight", 30);
  set("value", ({ 10, "silver" }));
}
