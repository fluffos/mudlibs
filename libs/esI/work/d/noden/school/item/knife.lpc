#include <mudlib.h>

inherit WEAPON;

void create()
{
        set_name( "knife", "拆信刀" );
        add( "id", ({ "knife" }) );
        set_short( "拆信刀" );
        set_long(
                "这是一把拆信刀。\n"
        );
        set( "unit", "把" );
        setup_weapon( "dagger", 25, 12, 29 );
        set( "weight", 30 );
        set( "value", ({ 30, "silver" }) );
}
