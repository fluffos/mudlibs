#include <mudlib.h>

inherit WEAPON;

void create() {
  set_name("sword", "长剑");
  add("id", ({ "sword" }));
  set_short("长剑");
  set_long(
    "这是一把长剑。\n"
  );
  set("unit", "把");
  set("type", "longblade");
  set("weapon_class", 1);
  set("min_damage", 1);
  set("max_damage", 1);
  set("weight", 30);
  set("value", ({ 20, "silver" }));
}
