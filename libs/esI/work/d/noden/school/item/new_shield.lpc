#include <mudlib.h>

inherit ARMOR;

void create()
{
        set_name( "wonderful wooden shield", "神奇木盾" );
        add( "id", ({ "shield" }) );
        set_short( "神奇木盾" );
	set_long(@C_LONG
一面朴素但坚硬的木制盾牌。这个是专门设计给新手使用的，不管是哪个公
会的新手，它都能完全配合。因为是给新手用的，不能乱丢，也不能随便给
别人用, 否则就会消失不见喔。
C_LONG
	);
        set( "unit", "面" );
        set( "weight", 20 );
        set( "type", "shield" );
        set( "material" ,"wood" );
        set( "armor_class", 3 );
        set( "prevent_drop", 1 );
        set( "prevent_get", 1 );
        set( "prevent_insert", 1 );
	set( "value",0);
}
