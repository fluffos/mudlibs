#include <mudlib.h>

inherit CONTAINER;

void create() {
  ::create();
  set_name("bag", "小布袋");
  set_short("bag", "小布袋");
  set_c_open_long("这个小布袋可以用来装一些小东西。\n");
  set("weight", 20);
  set("weight_apply", 50);
  set("max_load", 230);
  set("value", ({ 10, "silver" }));
  set("prevent_insert", 1);
  set("prevent_put_money", 1);
}
