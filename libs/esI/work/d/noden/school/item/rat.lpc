#include <mudlib.h>

inherit MONSTER ;

void create()
{
        ::create();
        set_level(1);
        set_name("rat","老鼠");
        add( "id", ({ "rat" }) );
        set_short("老鼠");
        set_long("这是一只又脏又小的老鼠, 正好给你开刀。\n");
        set("unit", "只");
        set("exp_reward",1);
}

