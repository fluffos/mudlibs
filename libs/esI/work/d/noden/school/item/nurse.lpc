#include <mudlib.h>

inherit MONSTER ;

void create ()
{
        ::create();
        set_level(10);
        set_name("nurse","女护士" );
        add ("id", ({ "nurse"}) );
        set_short( "nurse","女护士");
        set("unit","位");
        set_long(@ANGEL
一个穿著白色制服的护士, 微笑地看著你。
ANGEL
        );
        
        set ("gender", "female");
        set ("race", "human");
        set( "no_attack", 1 );
}
