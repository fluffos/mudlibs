//  yogi@163.net
//  99/09/9
//  yogi.163.net
#include <mudlib.h>
inherit ROOM;

object p;

void create ()
{
set ("short", "基础冒险训练教室");
set ("long", @LONG
你来到另一间教室。墙角有个橱柜(cupboard), 墙上同样有个黑板, 
上面写著：
    把东西装在袋子里能减轻你身上的负重。要把东西装进袋子内可以用
put <物品> in bag或者put <物品> into bag, 把东西从袋子内拿出来可
以用get <物品> from bag, 要看袋子内有哪些东西则用look bag。
LONG);
set("exits", ([ "west" : __DIR__"basic1-look2.lpc", ]));
set("pre_exit_func", ([ "west" : "exit_west" ]));
set("item_desc", ([ "cupboard" : "你看了看这个橱柜, 心想或许翻一翻(search)它能找到一些东西。\n" ]) );
set("light",1);
set("no_cast",1);
set("no_enhant",1);
reset();
}           

void init()
{
     p = this_player();

     p->set_temp("basic1-1", 0);
     p->set_temp("basic1-2", 0);
     p->set_temp("basic1-3", 0);
     p->set_temp("basic1-4", 0);

     write (@look
你临走前拿出笔记本, 记下了give的用法。
look);
     if ( p->query("basic1") <= 10 ) { p->set("basic1", 10) ;}
     call_out( "welcome1", 2, p );
     add_action("command_search","search") ;
}

void welcome1()
{
        write (@look
你看著黑板上的字, 抓了抓头, 心里在纳闷, 这里哪里来的袋子呢?
你的眼光落到了橱柜(cupboard)上。心想去看看吧。
look);
}

int exit_west()
{
       if ( p->query_temp("basic1-1")!=1 || p->query_temp("basic1-2")!=1 || p->query_temp("basic1-3")!=1 || p->query_temp("basic1-4")!=1)
       {
           write (@look
你感觉对袋子的用法还不是很熟悉，觉得再多练习一下比较好！
look);
           return 1 ; 
       } 
       return 0;
}

int command_search(string ob)
{
     object obj ;

     if( !ob ) {
       return 0 ; 
     }

     if( ob == "cupboard") {
        remove_action("command_search","search") ;
        write (@look
你捂住鼻子和嘴巴, 把橱柜里的灰尘拍了拍, 发现了一个布袋(bag)! 
你把这个布袋拿了起来。
你想起黑板上的字, 心想原来布袋是指这个, 看来是要练习布袋的用法了。
但是要把什么东西装进布袋里呢? 你想是不是还要再回去找找橱柜呢?
look);
        obj = new( __DIR__"item/bag.lpc" );
        obj->move(p);

        p->set_temp("basic1-1", 1);
        add_action("command_search2","search") ;
        return 1;
     } 
     return 0;
}

int command_search2(string ob)
{
     object obj ;

     if( !ob ) {
       return 0 ; 
     }

     if( ob == "cupboard") {
       remove_action("command_search2","search") ;
       write (@look
你再一次　住鼻子和嘴巴, 把橱柜彻底地翻了一翻, 又发现了一把小刀(knife)!
你把这把小刀拿了起来。
班主任的声音又传了出来：「干得好, 孩子。现在你可以照著黑板上的指示, 
练习一下把刀子放进布袋里去。」
look);
       obj = new( __DIR__"item/knife.lpc" );
       obj->move(p);

       p->set_temp("basic1-2", 1);
       add_action("command_put","put") ;
       return 1 ; 
     } 
     return 0;
}

int command_put(string ob)
{
     string s1,s2,s3;
     object obj ;

     if(!ob) return 0;
     if( sscanf(ob,"%s %s %s",s2,s3,s1)<3 )
        return 0;
     if("bag"!=s1 || s3!="in") 
        return 0;     
     if( s2 == "knife") {
       remove_action("command_put","put") ;
       call_out( "put", 1, p );
       p->set_temp("basic1-3", 1);
       add_action("command_get","get") ;
       return 0 ; 
     } 
     return 0;
}

void put()
{
        write (@look
耳边又传来班主任的声音：「试试把东西从袋子里拿出来吧。」
look);
}

int command_get(string ob)
{
     string s1,s2,s3;
     object obj ;

     if(!ob) return 0;
     if( sscanf(ob,"%s %s %s",s2,s3,s1)<3 )
        return 0;
     if("bag"!=s1 || s3!="from") 
        return 0;     
     if( s2 == "knife") {
//       remove_action("command_get","get") ;
       p->set_temp("basic1-4", 1);
       return 0 ; 
     } 
     return 0;
}
