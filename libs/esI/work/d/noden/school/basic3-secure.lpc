//  snake
//  yogi@163.net
//  99/09/9
//  yogi.163.net
#include <mudlib.h>
inherit ROOM;

object p;

void create() {
  set("short", "高级冒险训练教室");
  set("long", @LONG
你下了楼梯来到另一个小房间, 一样昏暗的灯光, 但没有布帘围著。
房间里空无一物, 让你有点不知所措。
LONG);
  set("exits", ([ "south": __DIR__ "basic3-doll.lpc", ]));
  set("pre_exit_func", ([ "south": "exit_south" ]));
  set("light", 1);
  set("no_cast", 1);
  set("no_enhant", 1);
  set("no_cast", 1);
  set("no_enhant", 1);
  reset();
}

void init() {
  p = this_player();

  p->set_temp("basic1-1", 0);
  p->set_temp("basic1-2", 0);

  write(@look
你拿出笔记本, 把wield与unwield的用法记了下来, 然后拨开布帘, 
往楼梯走了下去。
look);
  if (p->query("basic1") <= 23) { p->set("basic1", 23); }
  call_out("welcome1", 1, p);
  add_action("command_secure", "secure");
}

void welcome1() {
  write(@look
宁静的空气中传来了班主任的声音：「在你进入战斗以前, 我还要教你另一个
指令。当你身上有不少东西的时候, 为了避免drop all会把身上的护具武器等
通通丢掉, 或在商店卖东西时sell all不小心把不该卖的东西卖掉, 在东方故
事里提供了一个secure指令。你可以用secure <身上的某物品> 来为身上的某
些东西做标记。一旦做了标记之后, 这物品就不能丢, 也不能卖。你现在可以
试试看secure指令。」
look);
}

int exit_south() {
  if (p->query_temp("basic1-1") != 1 || p->query_temp("basic1-2") != 1) {
    write("你感觉对secure和unsecure的用法还不是很熟悉，觉得再多练习一下比较好！\n");
    return 1;
  }
  return 0;
}

int command_secure(string ob) {
  if (!ob) {
    return 0;
  }

  if (ob == "robe" || ob == "baselard" || ob == "all") {
    //       remove_action("command_secure","secure") ;
    p->set_temp("basic1-1", 1);
    call_out("secure", 1, p);
    add_action("command_unsecure", "unsecure");
    return 0;
  }
  return 0;
}

void secure() {
  write(@look
班主任又告诉你：「做了标记之后, 你可以试试看, 就没办法再丢掉了。
要解除标记, 就用unsecure <有标记的物品> 就可以了。试试看吧。」
look);
}

int command_unsecure(string ob) {
  if (!ob) {
    return 0;
  }

  if (ob == "robe" || ob == "baselard" || ob == "all") {
    //       remove_action("command_unsecure","unsecure") ;
    call_out("unsecure", 1, p);
    p->set_temp("basic1-2", 1);
    return 0;
  }
  return 0;
}

void unsecure() {
  write(@look
班主任告诉你：「把这两个指令弄熟, 就不怕会不小心丢掉重要物品了。
现在把你身上的武器和护具准备好, 我们要开始教你战斗了。继续前进, 
孩子。」
look);
}
