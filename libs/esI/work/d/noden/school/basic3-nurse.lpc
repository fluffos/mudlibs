//  yogi.163.net
#include <mudlib.h>
inherit ROOM;

object p;

void create() {
  set("short", "高级冒险训练教室");
  set("long", @LONG
你来到一间小教室, 前面令你怀念的黑板这时又出现在一面墙上。上
面写著：
    恭喜你, 高级训练班的课程已经接近尾声了。这里我们要教你简单为
自己医疗的方法。为了避免死亡, 你需要一些药物来恢复你的体力。东方
故事里的药物有内服的、以及外用敷伤口用的。内服药可以在各药店买到
, 你可以自己去找找, 但要注意内服药吃太多会造成身体不适。外敷用药
也可以在药店找到, 这里就要教你怎么敷药与包扎。你可以问问旁边的护
士, 告诉她你要学习医疗(heal)。
LONG);
  set("exits", ([ "up": __DIR__ "basic3-end.lpc", ]));
  set("pre_exit_func", ([ "up": "exit_up" ]));
  set("objects", ([ "nurse": __DIR__ "item/nurse.lpc" ]));
  set("light", 1);
  set("no_cast", 1);
  set("no_enhant", 1);
  reset();
}

void init() {
  p = this_player();

  p->set_temp("basic1-1", 0);
  p->set_temp("basic1-2", 0);
  p->set_temp("basic1-3", 0);
  p->set_temp("basic1-4", 0);

  if (p->query("basic1") <= 26) { p->set("basic1", 26); }
  add_action("command_ask", "ask");
}

int exit_up() {
  if (p->query_temp("basic1-1") != 1 || p->query_temp("basic1-2") != 1 || p->query_temp("basic1-3") != 1 || p->query_temp("basic1-4") != 1) {
    write("你感觉对药跟绷带的用法还不是很熟悉，觉得再多练习一下比较好！\n");
    return 1;
  }
  return 0;
}

int command_ask(string ob) {
  string s1, s2, s3;
  object obj;

  if (!ob) return 0;
  if (sscanf(ob, "%s %s %s", s1, s3, s2) < 3)
    return 0;
  if ("nurse" != s1 || s3 != "about")
    return 0;
  if (s2 == "heal") {
    write(@look
护士微笑著对你说：「你要来学治伤的方法吗? 这里有金创药和绷带, 先拿去。」
护士把金创药跟绷带交给你。
look);
    obj = new("/d/noden/farwind/items/plaster");
    obj->move(p);
    obj = new("/obj/bandage");
    obj->move(p);

    write(@look
护士小姐告诉你说：「身上有伤的时候, 要先敷药再包扎。敷药的方法
是当你身上有外用药的时候, 可以用apply plaster 来敷药。如果你要
帮别人敷药的话, 可以用apply plaster at <某人> 。当你身上有绷带
的时候, 可以包扎, 只要直接用bandage 即可包扎自己。要帮某人包扎
时可以用bandage <某人>。你在各公会都可以学到包扎(bandage) 技能
, 技能越高, 包扎后回复体力的速度就越快。你现在可以试试看。」
look);
    p->set_temp("basic1-1", 1);
    remove_action("command_ask", "ask");
    add_action("command_apply", "apply");
    return 1;
  }
  return 0;
}

int command_apply(string ob) {

  if (!ob) {
    return 0;
  }

  if (ob == "plaster") {
    remove_action("command_apply", "apply");
    write(@look
你在打开药盖的时候不小心割伤了手! 
look);
    call_out("apply", 1, p);
    p->set_temp("basic1-2", 1);
    add_action("command_bandage", "bandage");
    return 0;
  }
  return 0;
}

void apply() {
  write(@look
护士告诉你：「敷好药以后就可以去包扎了。包扎的用法还记得吧? 
就是用bandage 即可。」
look);
}

int command_bandage() {

  remove_action("command_bandage", "bandage");
  call_out("bandage", 1, p);
  p->set_temp("basic1-3", 1);
  add_action("command_remove", "remove");
  return 0;
}

void bandage() {
  write(@look
护士小姐告诉你：「要把绑好的绷带取下来, 就用remove bandage。你可以
试试看。」
look);
}

int command_remove(string ob) {

  if (!ob) {
    return 0;
  }

  if (ob == "bandage") {
    call_out("remove", 1, p);
    p->set_temp("basic1-4", 1);
    //       remove_action("command_remove","remove") ;
    return 0;
  }
  return 0;
}

void remove() {
  write(@look
你觉得对药与绷带的用法都很熟了。差不多可以走了。
look);
}
