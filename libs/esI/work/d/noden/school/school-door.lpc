#include <mudlib.h>
#include <move.h>

inherit ROOM;

object p;

void create() {
  set("short", "东方学园大门");
  set("long", @LONG
你穿过一道门, 沿著走道来到一栋大房子。房子的设计有点怪, 总共
有三个门。旁边有个牌子, 上面写著：

    欢迎来到东方故事！这是一个充满理想、惊奇与刺激的世界。而这里
正是你踏进东方故事这个国度的跳板。在这里, 我们将会给你指引, 让你
知道如何在这个国度里探险、生存。
    如果你刚踏进这个世界, 想要学习基本的冒险技能, 就往北(打north或n)。
    如果你已经通过基础训练, 要参加中级训练班, 请往西北(northwest或nw)。
    如果你已经准备接受高级训练的洗礼, 就往东北(northeast或ne)。
    如果你想回去冒险者公会, 就往南(south或s)走就行了。。
LONG);

  set("exits",
    ([
      "south": "/d/adventurer/hall/adv_guild",
      "north": __DIR__ "basic1-look.lpc",
      "northeast": __DIR__ "basic3-wear.lpc",
      "northwest": __DIR__ "basic2-look.lpc",
    ]));
  set("objects", ([ "master": __DIR__ "item/master.lpc" ]));
  set("pre_exit_func",
    ([
      "north": "exit_north",
      "northeast": "exit_northeast",
      "northwest": "exit_northwest",
    ]));
  set("light", 1);
  set("no_cast", 1);
  set("no_enhant", 1);
  reset();
}

void init() {
  p = this_player();
}

int exit_north() {
  int i;
  object obj, *obs;

  if (p->query("school1") == 1) {
    write(@look
你看到东方学园的班主任对你微笑著说：「孩子, 初级班你已经上过了, 还想
回去看看是吗? 」

look);
  }
  write("你看到东方学园的班主任往你身上一指, 你突然发现自己身上变得光溜溜的。\n\n");
  obs = all_inventory(p);
  obj = present("notebook", p);
  if (!obj) {
    write(@look

你看到东方学园的班主任满脸微笑地递了一本笔记本给你, 同时拍了拍你肩膀
对你说：「孩子, 记得把学到的心得记录下来。」

look);
    obj = new(__DIR__ "item/notebook.lpc");
    obj->move(p);
  }
  for (i = 0; i < sizeof(obs); i++) {
    if (obs[i]->query("prevent_drop")) continue;
    obs[i]->move(environment(p));
  }
}

int exit_northeast() {
  int i;
  object obj, *obs;

  if (p->query("school1") != 1) {
    write(@look

你看到东方学园的班主任走过来拍拍你的肩膀说：「孩子, 你还没到初级班看过
呢。先到初级班看看, 通过了再到中级班吧。」

look);
    return 1;
  }
  if (p->query("school2") != 1) {
    write(@look

你看到东方学园的班主任走过来拍拍你的肩膀说：「孩子, 你还没到中级班看过
呢。先到中级班看看, 通过了再来高级班吧。」

look);
    return 1;
  }
  if (p->query("school3") == 1) {
    write(@look
你看到东方学园的班主任对你微笑著说：「孩子, 高级班你已经上过了, 还想
回去看看是吗? 」

look);
  }
  write("你看到东方学园的班主任往你身上一指, 你突然发现自己身上变得光溜溜的。\n\n");
  obs = all_inventory(p);
  obj = present("notebook", p);
  if (!obj) {
    write(@look

你看到东方学园的班主任满脸微笑地递了一本笔记本给你, 同时拍了拍你肩膀
对你说：「孩子, 记得把学到的心得记录下来。」

look);
    obj = new(__DIR__ "item/notebook.lpc");
    obj->move(p);
  }
  obs = all_inventory(p);
  for (i = 0; i < sizeof(obs); i++) {
    if (obs[i]->query("prevent_drop")) continue;
    obs[i]->move(environment(p));
  }
}

