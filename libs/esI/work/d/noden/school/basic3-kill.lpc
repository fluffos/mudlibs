#include <mudlib.h>
inherit ROOM;

object p;

void create() {
  set("short", "高级冒险训练教室");
  set("long", @LONG
你来到一个大房间, 看起来有点像是道场之类的。地上一样铺满了塌
塌米。一个年轻的男孩正在蹋蹋米的中央练习舞剑。
LONG);
  set("exits", ([ "south": __DIR__ "basic3-nurse.lpc", ]));
  set("pre_exit_func", ([ "south": "exit_south" ]));
  set("objects", ([ "comaster": __DIR__ "item/comaster.lpc" ]));
  set("light", 1);
  set("no_cast", 1);
  set("no_enhant", 1);
  reset();
}

void init() {
  p = this_player();

  p->set_temp("basic1-1", 0);

  write(@look
你定了定神, 往出口走去。

look);
  if (p->query("basic1") <= 26) { p->set("basic1", 26); }
  call_out("kill", 3, this_player());
}

int exit_south() {
  if (p->query_temp("basic1-1") != 1) {
    all_inventory(environment(p))->cease_all_attacks();
    p->set_temp("basic1-1", 1);
    remove_call_out("kill");
    write(@look
副班主任把刀收了起来, 停止攻击你。
战斗结束了。
副班主任把你扶了起来, 对你说：「在东方故事里有一些怪物是会主动攻击
的, 在你踏进他领域的一瞬间就会对你发动攻击了, 所以你一定要特别小心
谨慎。也有些恶劣的玩家会对你进行攻击, 但在你升到第五级以前你都可以
不必担心被玩家攻击。一但长大了, 第五级以后, 你就要一切自己小心了。
我先帮你恢复一点体力吧。现在你可以到下一个房间去学简单的医疗与包扎
技术了。」
look);
    p->set("hit_points", p->query("max_hp") / 3);
    return 0;
  }
  return 0;
}

void kill() {
  all_inventory(environment(p))->cease_all_attacks();
  this_player()->set_temp("basic1-1", 1);
  write(@look
副班主任把刀收了起来, 停止攻击你。
战斗结束了。
副班主任把你扶了起来, 对你说：「在东方故事里有一些怪物是会主动攻击
的, 在你踏进他领域的一瞬间就会对你发动攻击了, 所以你一定要特别小心
谨慎。也有些恶劣的玩家会对你进行攻击, 但在你升到第五级以前你都可以
不必担心被玩家攻击。一但长大了, 第五级以后, 你就要一切自己小心了。
我先帮你恢复一点体力吧。现在你可以到下一个房间去学简单的医疗与包扎
技术了。」
look);
  p->set("hit_points", p->query("max_hp") / 3);
}
