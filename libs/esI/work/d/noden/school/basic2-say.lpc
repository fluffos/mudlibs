#include <mudlib.h>
inherit ROOM;

object p;

void create ()
{
set ("short", "中级冒险训练班");
set ("long", @LONG
你心有余悸地通过走到来到另一间房, 看起来像间正常的教室, 但没
有黑板。你注意到房间里摆了四张书桌(desk), 上面各有一块牌子。
后面则有一些文件。
LONG);

set("exits", ([ "northeast"  : __DIR__"school-door.lpc", ]));
set("pre_exit_func", ([ "northeast" : "exit_northeast" ]));
set("post_exit_func", ([ "northeast" : "exit2_northeast" ]));
set("light",1);
set("no_cast",1);
set("no_enhant",1);
reset();
}           

void init()
{
     p = this_player();

     p->set_temp("basic1-1", 0);
     p->set_temp("basic1-2", 0);
     p->set_temp("basic1-3", 0);
     p->set_temp("basic1-4", 0);
     p->set_temp("basic1-5", 0);
     write (@look
你赶紧往出口跑去, 把门紧紧关上, 心里总算松了一口气。
你把笔记本拿出来, 用你还有点在颤抖的手, 歪歪扭扭地把ask的用法记了下来。
look);
     add_action("command_look","look") ;
     if ( p->query("basic1") <= 17 ) { p->set("basic1", 17 ) ;}
}

int exit_northeast()
{
       if ( p->query_temp("basic1-1")!=1 || p->query_temp("basic1-2")!=1 || p->query_temp("basic1-3")!=1 || p->query_temp("basic1-4")!=1 || p->query_temp("basic1-5")!=1)
       {
           write ("你感觉对沟通的方法还不是很熟悉，觉得再多了解一下比较好！\n");
           return 1 ; 
       } 
       return 0;
}

int exit2_northeast()
{
       if ( p->query("school2")!=1 ) 
       {
          write (@look

[你完成了中级训练班的课程, 得到了1000点经验点。]

look);
          p->gain_experience(1000);
       }
       if ( p->query("basic1") <= 21 ) { p->set("basic1", 21 ) ;}
       p->set("school2", 1);
       return 0;
}

int command_look(string ob)
{
     if( !ob ) {
       return 0 ; 
     }
     if( ob == "desk") {
       write(@look
你看到这四张书桌上各有一块牌子, 上面分别写著:say, tell, shout, chat
四个字。你心想应该去读读(read)那些文件。
look);
       p->set_temp("basic1-1", 1);
       call_out( "look", 1, p );
       add_action("command_read","read") ;
       return 1 ; 
     } 
     return 0;
}

void look()
{
        write (@look
那个令你怀念的可爱女孩的声音又出现了：「这里是中级训练班的最后一
站, 我们将会教您在线上跟别的玩家沟通的方法。请您分别用read指令看
看这四张桌子上的文件。例如用read say可以看标记为say 的那张桌子上
头的说明。」
look);
}

int command_read(string ob)
{
        if( !ob ) {
          return 0 ; 
        }
	switch (ob) {
		case "say" : {
                        p->set_temp("basic1-2", 1);
                write (@look
你看著这份文件, 上面写著：
「say指令让你跟和你在同一个房间的玩家说话用的。你可以试著用say hello来看看。
  使用say指令时, 在其他房间的玩家将没有办法听到你说话。
  这种说话的方式不会用掉任何的交谈能力点数。」
look);
                        if ( p->query_temp("basic1-1")==1 && p->query_temp("basic1-2")==1 && p->query_temp("basic1-3")==1 && p->query_temp("basic1-4")==1 && p->query_temp("basic1-5")==1)
                           {
                             write ("你把四份文件都看完了, 觉得差不多可以走了。\n");
                             remove_action("command_read","read") ;
                             return 1; 
                           }      
                        return 1; 
		}
		case "tell" : {
                        p->set_temp("basic1-3", 1);
                write (@look
你看著这份文件, 上面写著:
「tell指令是让你跟某个特定的玩家秘密沟通用的。
  语法是: tell <某人> <你要说的话>。
  当你用这种方式说话时, 除了你沟通的对象以外, 没有其他任何人

  听得到你说的话。这种说话的方式不会用掉你的交谈能力点数。
  另外, 如果别人用tell跟你说话, 你只需要用reply <你要回答他的话>
  就可以直接回答他, 而不必再用tell指令。
  reply指令一次要用掉五点的交谈能力点数。
  交谈能力点数别忘了可以用hp或score来看喔。」
look);
                        if ( p->query_temp("basic1-1")==1 && p->query_temp("basic1-2")==1 && p->query_temp("basic1-3")==1 && p->query_temp("basic1-4")==1 && p->query_temp("basic1-5")==1)
                           {
                             write ("你把四份文件都看完了, 觉得差不多可以走了。\n");
                             remove_action("command_read","read") ;
                             return 1; 
                           }      
                        return 1; 
		}
		case "shout" : {
                        p->set_temp("basic1-4", 1);
                write (@look
你看著这份文件, 上面写著:
「shout指令是让所有在线上的玩家都能听到你说的话。
  通常只用于你要对大家宣布某些事情的时候。
  这种说话的方式一次要用掉五十点的交谈能力点数。
  另外, 等级三以下的玩家规定是不能使用shout指令的。」
look);
                        if ( p->query_temp("basic1-1")==1 && p->query_temp("basic1-2")==1 && p->query_temp("basic1-3")==1 && p->query_temp("basic1-4")==1 && p->query_temp("basic1-5")==1)
                           {
                             write ("你把四份文件都看完了, 觉得差不多可以走了。\n");
                             remove_action("command_read","read") ;
                             return 1; 
                           }      
                        return 1; 
		}
		case "chat" : {
                        p->set_temp("basic1-5", 1);
                write (@look
你看著这份文件, 上面写著:
「chat指令是让你能在chat频道上跟大家聊天。你现在可以试著使用chat hello
  来看看效果。这种方式只要线上的玩家有把chat频道打开, 都可以听到你说的话。
  这种说话的方式一次会用掉五点的交谈能力点数。」
look);
                        if ( p->query_temp("basic1-1")==1 && p->query_temp("basic1-2")==1 && p->query_temp("basic1-3")==1 && p->query_temp("basic1-4")==1 && p->query_temp("basic1-5")==1)
                           {
                             write ("你把四份文件都看完了, 觉得差不多可以走了。\n");
                             remove_action("command_read","read") ;
                             return 1; 
                           }      
                        return 1; 
		}
		default : {
			return 0 ;
		}
	}
        return 0;
} 

