//  snake
//  yogi@163.net
//  99/09/9
//  yogi.163.net
#include <mudlib.h>
inherit ROOM;

object p;

void create() {
  set("short", "高级冒险训练教室");
  set("long", @LONG
你踏进一个小房间, 前面有几张书桌(desk), 一样有几份文件放在桌
上。
LONG);

  set("exits", ([ "west": __DIR__ "school-door.lpc", ]));
  set("pre_exit_func", ([ "west": "exit_west" ]));
  set("post_exit_func", ([ "west": "exit2_west" ]));
  set("light", 1);
  set("no_cast", 1);
  set("no_enhant", 1);
  reset();
}

void init() {
  p = this_player();

  p->set_temp("basic1-1", 0);
  p->set_temp("basic1-2", 0);
  p->set_temp("basic1-3", 0);
  p->set_temp("basic1-4", 0);
  p->set_temp("basic1-5", 0);
  write(@look
你拿出笔记本, 把药跟绷带的用法记了下来, 然后往出口走去。

look);
  if (p->query("basic1") <= 28) { p->set("basic1", 28); }
  call_out("welcome1", 1, p);
  add_action("command_look", "look");
}

void welcome1() {
  write(@look
班主任的声音传了出来：「这里是最后一站了。最后我们要教你一些重要
的指令, 让你在冒险过程中更方便与更安全。读读桌上的文件吧, 并把这
些指令都要牢牢记住! 」
look);
}

int exit_west() {
  if (p->query_temp("basic1-1") != 1 || p->query_temp("basic1-2") != 1 || p->query_temp("basic1-3") != 1 || p->query_temp("basic1-4") != 1 || p->query_temp("basic1-5") != 1) {
    write("你还没读完桌上的文件，再多留一下比较好！\n");
    return 1;
  }
  return 0;
}

int exit2_west() {
  write(@look

班主任的声音传了出来：「恭喜你！你完成了东方学园的课程, 你可以出
去进行你的探险了。好好保存这本笔记本, 在你冒险的初期你会需要它的
帮忙。另外你可以用 help newbie看看东方故事给新手的指南, 也可以去
找在东方故事里的老手。你可以去跟他们请教很多事。好好享受冒险的生
活吧, 我的孩子。」
look);
  if (p->query("school3") != 1) {
    write(@look

[你完成了高级训练班的课程, 得到了1000点经验点。]

look);
    p->gain_experience(1000);
  }
  if (p->query("basic1") <= 32) { p->set("basic1", 32); }
  p->set("school3", 1);
  return 0;
}

int command_look(string ob) {

  if (!ob) {
    return 0;
  }
  if (ob == "desk") {
    write(@look
前面有四张书桌, 上面各有一份文件, 标题分别是help, alias, wimpy,
与save。你想起前面的经验, 应该是用read来读这些文件吧。
look);
    p->set_temp("basic1-1", 1);
    add_action("command_read", "read");
    return 1;
  }
  return 0;
}

int command_read(string ob) {

  if (!ob) {
    return 0;
  }
  switch (ob) {
    case "help": {
      p->set_temp("basic1-2", 1);
      write(@look
文件上写著：
help指令应该不必多说吧。它是让你取得相关资讯的指令。前面教过的许多
指令, 都可以用help看看它的用法。例如你想知道look指令的相关资讯, 你
就打help look 就可以看得到。想知道种族的相关资讯, 就打help races。
善用help指令, 许多事情就可以不必到处去问人了。
look);
      if (p->query_temp("basic1-1") == 1 && p->query_temp("basic1-2") == 1 && p->query_temp("basic1-3") == 1 && p->query_temp("basic1-4") == 1 && p->query_temp("basic1-5") == 1) {
        write("你放下文件, 心想终于完成了东方学园的学业了。应该可以准备出去大显身手了。\n");
        remove_action("command_read", "read");
        return 1;
      }
      return 1;
    }
    case "alias": {
      p->set_temp("basic1-3", 1);
      write(@look
文件上写著：
alias 指令是让你将复杂难打的指令简化的工具。例如要敷药时, 如果你把
药放在袋子里, 你就得先get plaster from bag把药从袋子里拿出来, 然后
再apply plaster 敷药。alias 指令提供你一个简单的方法。你可以用下列
方法来设定：
alias ap do get plaster from bag, apply plaster
第一个alias 是表示你要设定简化指令, 第二个ap则是你选定的替代指令。
后面的这个do表示你要把两个以上的动作合在一个指令里。后面则是你要做
的动作, 中间用逗号隔开。当你设定完以后, 以后你只要打ap, 它就自动帮
你把药从袋子里拿出来(第一个动作), 然后敷药(第二个动作)。再举个例, 
alias ga get all from corpse
表示你把get all from corpse(从尸体里取出所有的东西) 这个动作简化成
ga这个简单的指令, 以后你打死怪物以后, 就可以用ga来把尸体里所有的东
西全部拿出来。你一样可以用help alias来看看相关的说明。
look);
      if (p->query_temp("basic1-1") == 1 && p->query_temp("basic1-2") == 1 && p->query_temp("basic1-3") == 1 && p->query_temp("basic1-4") == 1 && p->query_temp("basic1-5") == 1) {
        write("你放下文件, 心想终于完成了东方学园的学业了。应该可以准备出去大显身手了。\n");
        remove_action("command_read", "read");
        return 1;
      }
      return 1;
    }
    case "wimpy": {
      p->set_temp("basic1-4", 1);
      write(@look
文件上写著：
wimpy 指令是让你在战斗中遇到危险的时候可以自动逃跑。你可以设定你的
体力hp值降到多少以下就自动逃跑以免死亡, 也可以再设定你逃跑时要往哪
个方向。指令格式是wimpy <hp值> <方向>。 例如你打wimpy 30就可以设定
hp降到30以下时自动逃跑, 若没设定方向则会自动选择可以跑的方向。输入
wimpy 30 north则会限制你往北边跑, 若北边没出口才会自动选择方向。你
也可以用help wimpy来看看相关说明。
look);
      if (p->query_temp("basic1-1") == 1 && p->query_temp("basic1-2") == 1 && p->query_temp("basic1-3") == 1 && p->query_temp("basic1-4") == 1 && p->query_temp("basic1-5") == 1) {
        write("你放下文件, 心想终于完成了东方学园的学业了。应该可以准备出去大显身手了。\n");
        remove_action("command_read", "read");
        return 1;
      }
      return 1;
    }
    case "save": {
      p->set_temp("basic1-5", 1);
      write(@look
文件上写著：
save指令是用于储存现在状态的资料于硬碟中。每隔一段时间东方故事的系
统会自动帮你下此一指令, 且当你在下quit指令时, 系统亦会自动下此指令
。此指令在机器或程式不稳定时相当重要, 当你觉得不稳定而快当掉(crash)
时, 请随时save, 以免努力的成果毁于一旦。
另外, 有时仍可能因crash 或其他因素而使得你的现有资料流失, 一旦流失
则你前面所练的功可能毁于一旦。为了避免你遭遇此种严重损失, 东方故事
提供了备份(backup)其资料的功能。备份之后, 一旦遇到现有资料损毁或流
失的情况, 你可以请求大神将你的资料从备份中取回(restore) 。备份的方
法有：
(1) 于『远风镇』之『露天英雄馆』(冒险者公会 go e,n,5 e)处 pray。
(2) 于『东方大陆』上『海威港』之『镇海将军庙』处 worship。
(3) 于『东方大陆』上『少林寺大雄宝殿』处 worship。
(4) 于『死亡大陆』中『矮人村落』的『教堂』处 pray。
(5) 于『津鸣城』的『征木神社』中 pray。
(6) 去找黑无常报到。(也就是死亡的时候啦。:P)
我们建议你每次上线或离线前至少去备份一次, 以免因任何可能的硬体错误
造成你不可弥补的损失。
look);
      if (p->query_temp("basic1-1") == 1 && p->query_temp("basic1-2") == 1 && p->query_temp("basic1-3") == 1 && p->query_temp("basic1-4") == 1 && p->query_temp("basic1-5") == 1) {
        write("你放下文件, 心想终于完成了东方学园的学业了。应该可以准备出去大显身手了。\n");
        remove_action("command_read", "read");
        return 1;
      }
      return 1;
    }
    default: {
      return 0;
    }
  }
  return 0;
}
