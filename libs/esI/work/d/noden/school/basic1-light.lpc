//  snake
//  yogi@163.net
//  99/09/9
//  yogi.163.net
#include <mudlib.h>
inherit ROOM;

object p;

void create() {
  set("short", "基础冒险训练教室");
  set("long", @LONG
你的四周一片漆黑, 只能靠手上的一点点亮光来看东西。你发现在你
脚边不远处有个往下(down)的楼梯。
LONG);

  set("exits",
    ([
      "down": __DIR__ "basic1-search.lpc",
    ]));
  set("pre_exit_func", ([ "down": "exit_down" ]));
  set("no_cast", 1);
  set("no_enhant", 1);
  reset();
}

void init() {
  p = this_player();

  p->set_temp("basic1-1", 0);
  p->set_temp("basic1-2", 0);
  p->set_temp("basic1-3", 0);

  write(@look
你想到应该把学到的东西记录下来。于是你拿出笔, 歪歪扭扭地在你的笔记本
上记下了look的用法。

look);
  if (p->query("basic1") <= 1) { p->set("basic1", 1); }

  write(@look
班主任的声音又传了出来：「这就对了, 孩子。以后你在这里学到的东西都应
该要把它记录下来, 或许对你初期的冒险生涯会有点帮助。」

look);
  call_out("welcome1", 1, this_player());
  add_action("command_inventory", "inventory");
}

void welcome1() {
  object obj;

  write(@look
你感觉有人塞了一个东西给你。你可以用inventory或i来看看自己身上有
哪些东西。
look);
  obj = new("/obj/torch.lpc");
  obj->move(p);
}

int exit_down() {
  if (p->query_temp("basic1-1") != 1 || p->query_temp("basic1-2") != 1 || p->query_temp("basic1-3") != 1) {
    write("你对使用火把的方法还不熟悉, 觉得还是练习练习比较好。\n");
    return 1;
  }
  return 0;
}

int command_inventory() {

  remove_action("command_inventory", "inventory");
  call_out("light1", 1, p);
  p->set_temp("basic1-1", 1);
  add_action("command_light", "light");
  return 0;
}

void light1() {
  write(@look
你发现身上多了一个火把(torch) 。班主任又告诉你：「火把是你在东方故事
里最常用到的照明用具。当然如果你学了其他技能, 也可以不用火把来照明。你
想点燃火把可以用light torch。要熄灭火把则用unlight torch。」
look);
}

int command_light(string ob) {
  if (!ob) {
    return 0;
  }
  if (ob == "torch") {
    remove_action("command_light", "light");
    p->set_temp("basic1-2", 1);
    add_action("command_unlight", "unlight");
    return 0;
  }
  return 0;
}

int command_unlight(string ob) {
  if (!ob) {
    return 0;
  }
  if (ob == "torch") {
    call_out("light2", 1, p);
    p->set_temp("basic1-3", 1);
    return 0;
  }
  return 0;
}

void light2() {
  write(@look
声音从暗处传了出来：「在冒险的初期火把是相当重要的工具。千万务必牢牢
记住怎么使用它。但是要记住, 火把虽然好用, 但总有烧完的时候。现在往下
走吧, 孩子。」

你看了看往下的楼梯, 决定硬著头皮走下去(打down或d)。

look);
}
