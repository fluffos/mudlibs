#include <mudlib.h>
inherit ROOM;

object p;

void create() {
  set("short", "高级冒险训练教室");
  set("long", @LONG
一个小小的房间, 地上杂乱地摆满了许多东西, 还带著一点血腥味。
突然地上冲出一只老鼠, 吓了你一大跳。你心想：来得正好, 让我练习
练习攻击的方法。
LONG);
  set("exits", ([ "west": __DIR__ "basic3-kill.lpc", ]));
  set("pre_exit_func", ([ "west": "exit_west" ]));
  //set( "objects", ([ "rat" : __DIR__"item/rat.lpc" ]) );
  set("light", 1);
  set("no_cast", 1);
  reset();
}

void init() {
  p = this_player();

  p->set_temp("basic1-1", 0);

  write(@look

班主任告诉你：「再来要面对的是真人实战了。准备好了吗? 」

look);
  if (p->query("basic1") <= 26) { p->set("basic1", 26); }

  //     add_action("command_kill","kill") ;
  add_action("command_look", "look");
  //     obj=new(__DIR__"item/rat");
}

int exit_west() {
  p = this_player();

  if (p->query_temp("basic1-1") != 1) {
    write("你感觉对攻击的用法还不是很熟悉，觉得再多练习一下比较好！\n");
    return 1;
  }
  return 0;
}

int command_look() {
  object obj;

  //     obj = find_living ( __DIR__"item/rat" );

  //     if ( !obj )
  //     {
  obj = new(__DIR__ "item/rat");
  obj->move(environment(p));
  //     }
  remove_action("command_look", "look");
  add_action("command_look2", "look");
  return 0;
}

int command_look2() {
  return 0;
}
