//  yogi.163.net
#include <mudlib.h>
inherit ROOM;

object p;

void create() {
  set("short", "高级冒险训练教室");
  set("long", @LONG
你来到一间宽大的房间, 地上铺著整片的塌塌米。中间立了一个有点
奇怪的大玩偶(doll), 你看到玩偶的旁边有一块牌子(sign)。
LONG);
  set("exits", ([ "south": __DIR__ "basic3-rat.lpc", ]));
  set("pre_exit_func", ([ "south": "exit_south" ]));
  set("objects", ([ "doll": __DIR__ "item/doll.lpc" ]));
  set("item_desc", ([
    "sign": @look
牌子上写著：
这里给你练习使用武器攻击的方法。当你打算攻击任一目标时, 
使用kill <目标> 指令就可以开始攻击。你可以以这个人偶为目
标, 开始练习攻击。
look
  ]));
  set("light", 1);
  set("no_cast", 1);
  reset();
}

void init() {
  p = this_player();

  p->set_temp("basic1-1", 0);

  write(@look
你拿出笔记本, 记下了secure与unsecure的用法, 怀著一颗忐忑不安的心,
往出口走去。

look);
  if (p->query("basic1") <= 25) { p->set("basic1", 25); }
  add_action("command_kill", "kill");
}

int exit_south() {
  if (p->query_temp("basic1-1") != 1) {
    write("你感觉对攻击的用法还不是很熟悉，觉得再多练习一下比较好！\n");
    return 1;
  }
  return 0;
}

int command_kill(string ob) {
  if (!ob) {
    return 0;
  }

  if (ob == "doll") {
    p->set_temp("basic1-1", 1);
    call_out("kill", 3, p);
    return 0;
  }
  return 0;
}

void kill() {
  all_inventory(environment(p))->cease_all_attacks();
  write(@look
班主任的声音传了出来：「很好, 孩子。你对攻击的方式应该有点心得了。
但是记住, 战斗一但开始就不能任意停止, 除非是任一方死亡, 或是有任一
方逃跑才能停止。有的怪物会记仇, 只要你打过他, 除非他死亡, 不然他是
会记恨于你的, 千万小心。现在你可以准备面对下一个挑战了。」
look);
}
