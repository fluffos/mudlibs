#include <mudlib.h>
inherit ROOM;

object p;

void create ()
{
set ("short", "基础冒险训练教室");
set ("long", @LONG
你来到一个房间, 有一张书桌(desk)靠墙摆著, 前面坐了一个女秘书
模样的女人。在铺著地毯的地板(ground)上有一个角落看来不太对劲。女
秘书的身后有一面黑板, 上面写著:

「当你解谜过程中, 可能要把某个物品交给某个人。或者平常你也有可能
要把某件装备或其他的东西交给某个玩家。give指令就是用来把某件物品
交给某个人时用的。用法是give <物品> to <某人>。 当然你也可以使用
give all to <某人>来把身上的能给的东西都给某人。你可以直接打give
来看看give的相关说明。」
LONG);
set("exits", ([ "south" : __DIR__"basic1-put.lpc", ]));
set("pre_exit_func", ([ "south" : "exit_south" ]));
set( "objects", ([ "woman" : __DIR__"item/woman.lpc" ]) );
set("light",1);
set("no_cast",1);
set("no_enhant",1);
reset();
}           

void init()
{
     p = this_player();

     p->set_temp("basic1-1", 0);
     p->set_temp("basic1-2", 0);

     write (@look
你拿出笔, 歪歪扭扭地在你的笔记本上记下了get与drop的用法。

look);
     if ( p->query("basic1") <= 9 ) { p->set("basic1", 9) ;}
     call_out( "welcome1", 1, p );
     add_action("command_search","search") ;
}

void welcome1()
{
        write (@look
你注意到地板(ground)的一个角落里有一点点反光。你心想去看看吧。
look);
}

int exit_south()
{
       if ( p->query_temp("basic1-1")!=1 || p->query_temp("basic1-2")!=1 )
       {
           write (@look
你感觉对give的用法还不是很熟悉，觉得再多练习一下比较好！
look);
           return 1 ; 
       } 
       return 0;
}

int command_search(string ob)
{
     object obj ;

     if( !ob ) {
       return 0 ; 
     }

     if( ob == "ground" ) {
        remove_action("command_search","search") ;
        obj = new( __DIR__"item/knife.lpc" );
        obj->move(p);

        call_out( "search", 1, p );
        p->set_temp("basic1-1", 1);
        add_action("command_give","give") ;
        add_action("command_search2","search") ;
        return 1;
     } 
     return 0;
}

int command_give(string ob)
{
     string s1,s2,s3;
     object obj ;

     if(!ob) return 0;
     if( sscanf(ob,"%s %s %s",s2,s3,s1)<3 )
        return 0;
     if("woman"!=s1 || s3!="to") 
        return 0;     
     if( s2 =="knife" || s2 =="all" ) {
//       obj = present("knife", p);
//       obj->remove();
//       remove_action("command_give","give") ;
       call_out( "give", 1, p );
       p->set_temp("basic1-2", 1);
       return 0 ; 
     } 
     return 0;
}

void search()
{
        write (@look
你翻起地毯, 发现了一把拆信刀(knife)! 你心想应该就是女秘书要找的拆信刀吧。
你把拆信刀捡了起来。是不是应该把拆信刀交还给(give)女秘书呢?
你想到黑板上的字。决定试试看吧!
look);
}

void give()
{
        write (@look
女秘书对你笑了笑, 点点头说：「谢谢! 」
look);
}

int command_search2(string ob)
{
     if( !ob ) {
       return 0 ; 
     }

     if( ob == "ground" ) {
        write (@look
一个你很熟悉的声音传了出来：「孩子, 这个地板角落(ground)你已经搜过了。
look);
        return 1;
     } 
     return 0;
}
