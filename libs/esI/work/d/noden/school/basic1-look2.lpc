#include <mudlib.h>
inherit ROOM;

object p;

void create ()
{
set ("short", "基础冒险训练教室");
set ("long", @LONG
你踏进了一间教室, 跟前面一样的在一面墙上有著一块大黑板。上面
写著：

恭喜你, 这里是基础训练班的最后一站。我们在这里要告诉你的是look指
令的另一项功能。当你深入一个危险区域时, 必须步步为营。此时你可以
用look指令来先观察你打算进入的地区。例如你打算往北走时, 在你还没
踏进去之前你可以先用look north来看看北边是不是有什么危险物品。相
同的用look southwest可以来看看西南方有什么危险在哪里等著你。只要
是任一个出口, 都可以用look指令来观察。你现在可以试试看。
LONG);

set("exits",
   ([
      "southwest"  : __DIR__"item/room2.lpc",
      "northeast"  : __DIR__"item/room2.lpc",
      "up" : __DIR__"school-door.lpc",
      "north"  : __DIR__"item/room1.lpc",
   ]));
set("pre_exit_func", 
   ([ 
      "up" : "exit_up" ,
      "north" : "exit_north" ,
      "northeast" : "exit_northeast" ,
      "southwest" : "exit_southwest" ,
   ]));
set("post_exit_func", ([ "up" : "exit2_up" ]));
set("light",1);
set("no_cast",1);
set("no_enhant",1);
reset();
}           

void init()
{
     p = this_player();

     p->set_temp("basic1-1", 0);
     p->set_temp("basic1-2", 0);
     p->set_temp("basic1-3", 0);
     p->set_temp("basic1-4", 0);
     if ( p->query("basic1") <= 12 ) { p->set("basic1", 12) ;}
     write (@look
你在笔记本上记下了袋子的用法, 然后心想应该可以离开了吧。
look);
     add_action("command_look","look") ;
}

int exit_up()
{
       if ( p->query_temp("basic1-1")!=1 || p->query_temp("basic1-2")!=1 || p->query_temp("basic1-3")!=1 || p->query_temp("basic1-4")!=1)
       {
           write ("你感觉对look方向的用法还不是很熟悉，觉得再多练习一下比较好！\n");
           return 1 ; 
       } 
       return 0;
}

int exit2_up()
{
       if ( p->query("school1")!=1 ) 
       {
          write (@look

[你完成了初级训练班的课程, 得到了1000点经验点。]

look);
          p->gain_experience(1000);
       }
       if ( p->query("basic1") <= 13 ) { p->set("basic1", 13) ;}
       p->set("school1", 1);
       return 0;
}

int exit_north()
{
           write (@look
你面对那恶心的臭味, 心里有点害怕, 觉得还是不要进去比较好。
look);
           return 1 ; 
}

int exit_northeast()
{
           write (@look
你正打算踏进去的时候, 听到了一声极其恐怖的尖叫, 一个东西掉下来打
到你头上, 吓得你赶紧缩了回来, 两脚都软掉了。
look);
           return 1 ; 
}

int exit_southwest()
{
           write (@look
你一脚踏进去, 赫然发现一群没穿衣服的女人正在里面扯八卦, 
你不由得一阵脸红赶快退了出来, 一边心里在想为什么在这里的人
都没有穿衣服? 难道这里是天体营吗? 
look);
           return 1 ; 
}

int command_look(string ob)
{
        if( !ob ) {
          return 0 ; 
        }
	switch (ob) {
		case "up" : {
                        p->set_temp("basic1-1", 1);
                        if ( p->query_temp("basic1-1")==1 && p->query_temp("basic1-2")==1 && p->query_temp("basic1-3")==1 && p->query_temp("basic1-4")==1)
                           {
                             write (@look

那个你再熟悉也没有的声音又在你耳边响起：「这就对了, 孩子。千万记得, 
在冒险的时候要多看多找多观察, 善加利用look指令可以让你避免很多危险。
善加利用search指令可以让你发现不少令你惊奇的事物。善加利用火把、布袋
等工具能让你在冒险过程中更加顺利。现在你可以出去了。」

你把初级训练班的课程又复习了一遍。觉得应该没有问题了。
look);
                             remove_action("command_look","look") ;
                             return 1; 
                           }      
                        return 0; 
		}
		case "north" : {
                        p->set_temp("basic1-2", 1);
                        if ( p->query_temp("basic1-1")==1 && p->query_temp("basic1-2")==1 && p->query_temp("basic1-3")==1 && p->query_temp("basic1-4")==1)
                           {
                             write (@look

那个你再熟悉也没有的声音又在你耳边响起：「这就对了, 孩子。千万记得, 
在冒险的时候要多看多找多观察, 善加利用look指令可以让你避免很多危险。
善加利用search指令可以让你发现不少令你惊奇的事物。善加利用火把、布袋
等工具能让你在冒险过程中更加顺利。现在你可以出去了。」

你把初级训练班的课程又复习了一遍。觉得应该没有问题了。
look);
                             remove_action("command_look","look") ;
                             return 1; 
                           }      
                        return 0; 
		}
		case "northeast" : {
                        p->set_temp("basic1-3", 1);
                        if ( p->query_temp("basic1-1")==1 && p->query_temp("basic1-2")==1 && p->query_temp("basic1-3")==1 && p->query_temp("basic1-4")==1)
                           {
                             write (@look

那个你再熟悉也没有的声音又在你耳边响起：「这就对了, 孩子。千万记得, 
在冒险的时候要多看多找多观察, 善加利用look指令可以让你避免很多危险。
善加利用search指令可以让你发现不少令你惊奇的事物。善加利用火把、布袋
等工具能让你在冒险过程中更加顺利。现在你可以出去了。」

你把初级训练班的课程又复习了一遍。觉得应该没有问题了。
look);
                             remove_action("command_look","look") ;
                             return 1; 
                           }      
                        return 0; 
		}
		case "southwest" : {
                        p->set_temp("basic1-4", 1);
                        if ( p->query_temp("basic1-1")==1 && p->query_temp("basic1-2")==1 && p->query_temp("basic1-3")==1 && p->query_temp("basic1-4")==1)
                           {
                             write (@look

那个你再熟悉也没有的声音又在你耳边响起：「这就对了, 孩子。千万记得, 
在冒险的时候要多看多找多观察, 善加利用look指令可以让你避免很多危险。
善加利用search指令可以让你发现不少令你惊奇的事物。善加利用火把、布袋
等工具能让你在冒险过程中更加顺利。现在你可以出去了。」

你把初级训练班的课程又复习了一遍。觉得应该没有问题了。
look);
                             remove_action("command_look","look") ;
                             return 1; 
                           }      
                        return 0; 
		}
		default : {
			return 0 ;
		}
	}
        return 0;
} 

