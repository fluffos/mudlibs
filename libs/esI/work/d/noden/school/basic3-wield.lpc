//  snake
//  yogi@163.net
//  99/09/9
//  yogi.163.net
#include <mudlib.h>
inherit ROOM;

object p;

void create ()
{
set ("short", "高级冒险训练教室");
set ("long", @LONG
跟刚才一样的小房间, 一样的灯光, 一样的布帘, 你心里的好奇与恐
惧感也一样的继续膨胀著。一个布帘的后面似乎有一个往下的楼梯。
LONG);
set("exits", ([ "down" : __DIR__"basic3-secure.lpc", ]));
set("pre_exit_func", ([ "down" : "exit_down" ]));
set("objects", ([ "baselard" : __DIR__"item/baselard.lpc" ]) );
set("light",1);
set("no_cast",1);
set("no_enhant",1);
reset();
}           

void init()
{
     p = this_player();

     p->set_temp("basic1-1", 0);
     p->set_temp("basic1-2", 0);
     p->set_temp("basic1-3", 0);
     p->set_temp("basic1-4", 0);

     write (@look

你把笔记本拿出来, 记下了wear与remove的用法, 然后往出口走去。

look);
     if ( p->query("basic1") <= 22 ) { p->set("basic1", 22) ;}
     call_out( "welcome1", 1, p );
     add_action("command_get","get") ;
}

void welcome1()
{
        write (@look
你注意到地上有把短刀。班主任的声音告诉你：「东方故事的武器有许多种, 
能拿哪些武器跟你的公会职业是有关系的, 但有些武器则是所有人都可以拿。
地上有把短刀, 你拿起来试试。装备武器的指令是wield <武器名>。」
look);
}

int exit_down()
{
       if ( p->query_temp("basic1-4") ==0 )
       {
           write ("你想起班主任叫你把武器装备起来, 还是把它装备起来吧。\n");
           return 1 ; 
       } 
       if ( p->query_temp("basic1-1")!=1 || p->query_temp("basic1-2")!=1 || p->query_temp("basic1-3")!=1 || p->query_temp("basic1-4")!=1)
       {
           write ("你感觉对wield和unwield的用法还不是很熟悉，觉得再多练习一下比较好！\n");
           return 1 ; 
       } 
       return 0;
}

int command_get(string ob)
{
     object obj ;

     if( !ob ) {
       return 0 ; 
     }

     if( ob == "baselard" || ob == "all" ) {
       obj = new( __DIR__"item/baselard.lpc" );
       obj->move(p);
       write (@look
你捡起一把短刀。
look);
       p->set_temp("basic1-1", 1);
       add_action("command_wield","wield") ;
       add_action("command_get2","get") ;
       return 1 ; 
     } 
     return 0;
}

int command_get2(string ob)
{
     if( !ob ) {
       return 0 ; 
     }
     if( ob == "baselard" || ob == "all") {
        write (@look
班主任的声音告诉你：「 孩子。你已经拿过一把了, 继续前进吧。」
look);
        return 1;
     } 
     return 0;
}

int command_wield(string ob)
{
     if( !ob ) {
       return 0 ; 
     }

     if( ob == "baselard" || ob == "all" ) {
       remove_action("command_wear","wear") ;
       call_out( "wield", 1, p );
       p->set_temp("basic1-2", 1);
       add_action("command_unwield","unwield") ;
       return 0 ; 
     } 
     return 0;
}

void wield()
{
        write (@look
你拿起地上的短刀, 试挥了一下, 觉得很满意。班主任又告诉你：「要
把武器拿下来, 用unwield <武器>就可以了。试试看吧, 孩子。」
look);
}

int command_unwield(string ob)
{
     if( !ob ) {
       return 0 ; 
     }

     if( ob == "baselard" || ob == "all" ) {
       remove_action("command_unwield","unwield") ;
       call_out( "remove", 1, p );
       p->set_temp("basic1-3", 1);
       add_action("command_wield2","wield") ;
       return 0 ; 
     } 
     return 0;
}

void remove()
{
        write (@look
班主任告诉你：「这就对了。以后根据你加入的公会不同, 会有不同的攻击
技能, 而不同的攻击技能会用到不同的武器, 但是装备的方法大都是用wield。
现在你就把这把刀装备起来, 下去准备练习战斗吧。」
look);
}

int command_wield2(string ob)
{
     if( !ob ) {
       return 0 ; 
     }

     if( ob == "baselard" || ob == "all" ) {
       p->set_temp("basic1-4", 1);
       return 0 ; 
     } 
     return 0;
}
