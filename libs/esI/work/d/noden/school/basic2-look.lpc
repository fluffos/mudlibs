#include <mudlib.h>
#define ADV_HELP "/doc/help/c_adventurers"
#define SCHO_HELP "/doc/help/c_scholars"
#define KNIGHT_HELP "/doc/help/c_knights"
#define MAGE_HELP "/doc/help/c_mages"
#define THIEF_HELP "/doc/help/c_thieves"
#define HEALER_HELP "/doc/help/c_healers"
#define MONK_HELP "/doc/help/c_monks"

inherit ROOM;

object p;

void create ()
{
set ("short", "中级冒险训练班");
set ("long", @LONG
你来到一间大教室, 里面有好几张书桌(desk)。前面的墙上一样有一
块大黑板, 上面写著：

    欢迎来到中级训练班。在这里一开始我们要介绍东方故事里的职业公
会。当你长大到第五级之前, 你都可以自由选择职业。在这里我们就要把
东方故事所有的职业公会介绍给你。不同的公会会影响你的属性上限, 同
时每个公会都有不同的技能要学, 也有不同的攻击方式。你可以自由翻阅
书桌上的文件, 以便更加了解各公会的详细资料。
LONG);

set("exits", ([ "southwest"  : __DIR__"basic2-hp.lpc", ]));
set("pre_exit_func", ([ "southwest" : "exit_southwest" ]));
set("light",1);
set("no_cast",1);
set("no_enhant",1);
reset();
}           

void init()
{
     p = this_player();

     p->set_temp("basic1-1", 0);
     p->set_temp("basic1-2", 0);
     p->set_temp("basic1-3", 0);
     p->set_temp("basic1-4", 0);
     p->set_temp("basic1-5", 0);
     p->set_temp("basic1-6", 0);
     p->set_temp("basic1-7", 0);
     p->set_temp("basic1-8", 0);
     write (@look

你看到班主任走过来微笑著对你说：「孩子, 好好的学吧! 」

look);
     add_action("command_look","look") ;
}

int exit_southwest()
{
       if ( p->query_temp("basic1-1")!=1 || p->query_temp("basic1-2")!=1 || p->query_temp("basic1-3")!=1 || p->query_temp("basic1-4")!=1 ||
            p->query_temp("basic1-5")!=1 || p->query_temp("basic1-6")!=1 || p->query_temp("basic1-7")!=1 || p->query_temp("basic1-8")!=1)
       {
           write ("你感觉对职业公会还不是很熟悉，觉得再多了解一下比较好！\n");
           return 1 ; 
       } 
       return 0;
}

int command_look(string ob)
{
     if( !ob ) {
       return 0 ; 
     }
     if( ob == "desk") {
       write(@look
你看到有七张书桌, 每张书桌上都放著一份文件。七张书桌上各有一块牌子, 
上头分别写著adv、scho、knight、mage、thief、healer、monk。你听到熟悉
的班主任的声音告诉你：「去看看那些文件吧, 用read adv可以看关于冒险者
公会的说明, 依此类推。
look);
       p->set_temp("basic1-1", 1);
       add_action("command_read","read") ;
       return 1 ; 
     } 
     return 0;
}

int command_read(string ob)
{
        if( !ob ) {
          return 0 ; 
        }
	switch (ob) {
		case "adv" : {
                        p->set_temp("basic1-2", 1);
			p->more(ADV_HELP) ;
                        if ( p->query_temp("basic1-1")==1 && p->query_temp("basic1-2")==1 && p->query_temp("basic1-3")==1 && p->query_temp("basic1-4")==1 &&
                             p->query_temp("basic1-5")==1 && p->query_temp("basic1-6")==1 && p->query_temp("basic1-7")==1 && p->query_temp("basic1-8")==1)
                           {
                             write ("你把七份文件都看完了, 觉得差不多可以走了。\n");
                             remove_action("command_read","read") ;
                             return 1; 
                           }      
                        return 1; 
		}
		case "scho" : {
                        p->set_temp("basic1-3", 1);
			p->more(SCHO_HELP) ;
                        if ( p->query_temp("basic1-1")==1 && p->query_temp("basic1-2")==1 && p->query_temp("basic1-3")==1 && p->query_temp("basic1-4")==1 &&
                             p->query_temp("basic1-5")==1 && p->query_temp("basic1-6")==1 && p->query_temp("basic1-7")==1 && p->query_temp("basic1-8")==1)
                           {
                             write ("你把七份文件都看完了, 觉得差不多可以走了。\n");
                             remove_action("command_read","read") ;
                             return 1; 
                           }      
                        return 1; 
		}
		case "knight" : {
                        p->set_temp("basic1-4", 1);
			p->more(KNIGHT_HELP) ;
                        if ( p->query_temp("basic1-1")==1 && p->query_temp("basic1-2")==1 && p->query_temp("basic1-3")==1 && p->query_temp("basic1-4")==1 &&
                             p->query_temp("basic1-5")==1 && p->query_temp("basic1-6")==1 && p->query_temp("basic1-7")==1 && p->query_temp("basic1-8")==1)
                           {
                             write ("你把七份文件都看完了, 觉得差不多可以走了。\n");
                             remove_action("command_read","read") ;
                             return 1; 
                           }      
                        return 1; 
		}
		case "mage" : {
                        p->set_temp("basic1-5", 1);
			p->more(MAGE_HELP) ;
                        if ( p->query_temp("basic1-1")==1 && p->query_temp("basic1-2")==1 && p->query_temp("basic1-3")==1 && p->query_temp("basic1-4")==1 &&
                             p->query_temp("basic1-5")==1 && p->query_temp("basic1-6")==1 && p->query_temp("basic1-7")==1 && p->query_temp("basic1-8")==1)
                           {
                             write ("你把七份文件都看完了, 觉得差不多可以走了。\n");
                             remove_action("command_read","read") ;
                             return 1; 
                           }      
                        return 1; 
		}
		case "thief" : {
                        p->set_temp("basic1-6", 1);
			p->more(THIEF_HELP) ;
                        if ( p->query_temp("basic1-1")==1 && p->query_temp("basic1-2")==1 && p->query_temp("basic1-3")==1 && p->query_temp("basic1-4")==1 &&
                             p->query_temp("basic1-5")==1 && p->query_temp("basic1-6")==1 && p->query_temp("basic1-7")==1 && p->query_temp("basic1-8")==1)
                           {
                             write ("你把七份文件都看完了, 觉得差不多可以走了。\n");
                             remove_action("command_read","read") ;
                             return 1; 
                           }      
                        return 1; 
		}
		case "healer" : {
                        p->set_temp("basic1-7", 1);
			p->more(HEALER_HELP) ;
                        if ( p->query_temp("basic1-1")==1 && p->query_temp("basic1-2")==1 && p->query_temp("basic1-3")==1 && p->query_temp("basic1-4")==1 &&
                             p->query_temp("basic1-5")==1 && p->query_temp("basic1-6")==1 && p->query_temp("basic1-7")==1 && p->query_temp("basic1-8")==1)
                           {
                             write ("你把七份文件都看完了, 觉得差不多可以走了。\n");
                             remove_action("command_read","read") ;
                             return 1; 
                           }      
                        return 1; 
		}
		case "monk" : {
                        p->set_temp("basic1-8", 1);
			p->more(MONK_HELP) ;
                        if ( p->query_temp("basic1-1")==1 && p->query_temp("basic1-2")==1 && p->query_temp("basic1-3")==1 && p->query_temp("basic1-4")==1 &&
                             p->query_temp("basic1-5")==1 && p->query_temp("basic1-6")==1 && p->query_temp("basic1-7")==1 && p->query_temp("basic1-8")==1)
                           {
                             write ("你把七份文件都看完了, 觉得差不多可以走了。\n");
                             remove_action("command_read","read") ;
                             return 1; 
                           }      
                        return 1; 
		}
		default : {
			return 0 ;
		}
	}
        return 0;
} 

