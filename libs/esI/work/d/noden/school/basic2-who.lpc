//  yogi@163.net
//  99/09/9
//  yogi.163.net
#include <mudlib.h>
inherit ROOM;

object p;

void create ()
{
set ("short", "中级冒险训练教室");
set ("long", @LONG
你来到一间教室, 前面的墙上一样有一块黑板, 上面写著：

    在东方故事里遇到困难时, 可以透过许多的沟通管道请教老玩家们。
这里教给你一些寻找老玩家的方法。who 指令可以看到目前在线上的玩家
们, 用who -l则可以看到他们更详细的资料。
LONG);
set("exits", ([ "southwest"  : __DIR__"basic2-ask.lpc", ]));
set("pre_exit_func", ([ "southwest" : "exit_southwest" ]));
set("light",1);
set("no_cast",1);
set("no_enhant",1);
reset();
}           

void init()
{
     p = this_player();

     p->set_temp("basic1-1", 0);
     p->set_temp("basic1-2", 0);

     write (@look

你在笔记本上记下了hp, score及skills的用法, 然后往出口走去。临走前
还不忘回头看看房间, 想看看那么甜美的声音的来源。

look);
     if ( p->query("basic1") <= 15 ) { p->set("basic1", 15 ) ;}

     add_action("command_who","who") ;
}

int exit_southwest()
{
       if ( p->query_temp("basic1-1")!=1 || p->query_temp("basic1-2")!=1)
       {
           write ("你感觉对who还不是很熟悉，觉得再多了解一下比较好！\n");
           return 1 ; 
       } 
       return 0;
}

int command_who(string ob)
{
     if( !ob ) {
       call_out( "who", 1, p );
       p->set_temp("basic1-1", 1);
       if ( p->query_temp("basic1-1")==1 && p->query_temp("basic1-2")==1 )
       {
          call_out( "end", 1, p );
          return 0; 
       }      
       return 0 ; 
     }

     if( ob == "-l") {
       call_out( "who2", 1, p );
       p->set_temp("basic1-2", 1);
       if ( p->query_temp("basic1-1")==1 && p->query_temp("basic1-2")==1 )
       {
          call_out( "end", 1, p );
          return 0; 
       }      
       return 0 ; 
     }
     return 0; 
}

void who()
{
     write (@look
那个令你念念不忘的女孩声音又传了出来：「who 指令的用途是将目前在东方
故事里探险的人们列出来给您看, 您想看更详细的资料, 可以试试who -l。」
look);
}

void who2()
{
     write (@look
还是那个甜美至极的声音告诉你：「who -l可以看到在东方故事内的玩家们更
进一步的资料。左边的数字是玩家的等级, 再来是他们的封号, 以及名字, 最
后括弧内的则是他们的id。这其实也就是您使用score 指令的第一行讯息。」
look);
}

void end()
{
     write (@look
你对who指令已经熟悉了, 觉得差不多可以走了。
look);
}
