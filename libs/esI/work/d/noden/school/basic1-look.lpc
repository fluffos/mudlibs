//  yogi.163.net
#include <mudlib.h>
inherit ROOM;

object p;

void create() {
  set("short", "基础冒险训练教室");
  set("long", @LONG
你来到一间大教室。一面墙上挂著许多图画(painting), 另外还有好
几幅很大的相片(picture)。另一面墙上有个大黑板, 上面写了一些字：

在探险过程中最重要的就是不断地「看」(look)。每到一个新地方, 你都
要用look指令先观察一下四周的环境再做下一步动作。你现在可以试试看
look指令。在东方故事里, 你也可以只打'l'来代替"look"。
LONG);

  set("exits",
    ([
      "north": __DIR__ "basic1-light.lpc",
    ]));
  set("pre_exit_func", ([ "north": "exit_north" ]));
  set("light", 1);
  set("item_func/painting", "look_at_painting");
  set("item_func/picture", "look_at_picture");
  set("no_cast", 1);
  set("no_enhant", 1);
  reset();
}

void init() {
  p = this_player();

  p->set_temp("basic1-1", 0);
  p->set_temp("basic1-2", 0);
  p->set_temp("basic1-3", 0);
  call_out("welcome1", 1, p);
  add_action("command_look", "look");
}

void welcome1() {
  write(@look
班主任的声音不知从哪儿传了出来：「孩子, 仔细观察观察这个房间。
用look painting可以看看图画, look picture可以看看照片。以后你在
冒险过程中遇到什么有趣的事物, 都要先用look来观察一番。」
look);
}

int exit_north() {
  if (p->query_temp("basic1-1") != 1 || p->query_temp("basic1-2") != 1 || p->query_temp("basic1-3") != 1) {
    write("你感觉对look的用法还不是很熟悉，觉得再多练习一下比较好！\n");
    return 1;
  }
  //       p->set("basic1", 1);
  return 0;
}

int command_look(string ob) {
  if (!ob) {
    p->set_temp("basic1-1", 1);
    return 0;
  } else if (p->query_temp("basic1-1") != 1) {
    write("你想看什么呢? 你现在只需要打 look 或 l 四处看看就可以了。\n");
    return 1;
  }
  return 0;
}

int look_at_painting() {
  write(@look
你仔细地端详墙上的画, 揣摩了半天, 最后决定它可能是一个三岁的小孩
随便涂鸦涂出来的。
look);
  p->set_temp("basic1-2", 1);
  if (p->query_temp("basic1-1") == 1 && p->query_temp("basic1-2") == 1 && p->query_temp("basic1-3") == 1) {
    write(@look

你把这个房间都观察完了, 觉得对look的用法也很熟悉了。心想应该可以
往教室的出口走了。
look);
    return 1;
  }

}

int look_at_picture() {
  write(@look
你看看墙上的相片, 中间一张很大的相片是一个浓眉大眼但很年轻的男人,
手里抓著一把电锯。底下有一行小字写著: 「圣人, 东方故事屠夫。」

大照片下面摆着一排照片，一张是一个精灵，下面的一个字写着：「蛇」。
旁边几张都是新摆上去的，全是熟悉的脸孔，就没仔细看了。

look);
  p->set_temp("basic1-3", 1);
  if (p->query_temp("basic1-1") == 1 && p->query_temp("basic1-2") == 1 && p->query_temp("basic1-3") == 1) {
    write(@look

你把这个房间都观察完了, 觉得对look的用法也很熟悉了。心想应该可以
往教室的出口走了。
look);
    return 1;
  }
}
