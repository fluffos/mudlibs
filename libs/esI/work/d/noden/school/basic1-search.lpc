//  yogi@163.net
//  99/09/9
//  yogi.163.net
#include <mudlib.h>
inherit ROOM;

object p;

void create ()
{
set ("short", "基础冒险训练教室");
set ("long", @LONG
又是一间同样的教室, 但是有点凌乱。同样有个黑板挂在墙上, 上面
写著：

「在探索过程中, 除了用眼睛不断观察外, 最好还能下去搜索(search)
一番。有时用look会发现一些特别的东西, 也可以下去搜索一下。你现在
可以用search指令来试试搜索房间。」
LONG);
set("light",1);
set("no_cast",1);
set("no_enhant",1);
reset();
}           

void init()
{
     p = this_player();

     p->set_temp("basic1-1", 0);
     p->set_temp("basic1-2", 0);
     p->set_temp("basic1-3", 0);
     p->set_temp("basic1-4", 0);

     write (@look
你临走前把火把点亮, 拿出笔就著火把的亮光, 歪歪扭扭地在你的笔记本上记
下了inventory及火把的用法, 顺手把火把熄掉, 沿著楼梯走了下去。

look);
//     command("unlight torch" );
     if ( p->query("basic1") <= 5 ) { p->set("basic1", 5) ;}

     add_action("command_search","search") ;
}

int exit_east()
{
       if ( p->query_temp("basic1-1")!=1 || p->query_temp("basic1-2")!=1 || p->query_temp("basic1-3")!=1 || p->query_temp("basic1-4")!=1 )
       {
           write ("你对搜索的方法还不熟悉, 觉得还是练习练习比较好。\n");
           return 1 ; 
       } 
       return 0;
}

int command_search()
{

     remove_action("command_search","search") ;
     write (@look
你把整个房间翻遍了, 只有一个东西吸引了你的注意, 是一个大箱子(box)。
班主任告诉你：「孩子, 当你发现一个特别的物品的时候, 你最好先看看
(look)它, 再翻一翻(search)。想要特别去翻某个物品, 用search <某物品>
。例如你想去翻箱子, 就用search box。
look);
     p->set_temp("basic1-1", 1);
     add_action("command_look","look") ;
}

int command_look(string ob)
{

     if( !ob ) {
       return 0 ; 
     }
     if( ob == "box") {
       remove_action("command_look","look") ;
       write ("一个很大的箱子。不知道里头有些什么东西。用search box来找找看吧。\n");
       p->set_temp("basic1-2", 1);
       add_action("command_search2","search") ;
       return 1 ; 
     } 
     return 0;
}

int command_search2(string ob)
{

     if( !ob ) {
       return 0 ; 
     }
     if( ob == "box") {
       remove_action("command_search2","search") ;
       write (@look2
你翻了翻这个大箱子, 里面有一些泛黄的旧书信, 不知道是谁的。你将它
们打开来看看, 却发现书已经被虫蛀得不堪入目了。
班主任的声音不知从哪里传了过来：「探险的根本基础就是多看, 多找。
look与search两个指令交互运用, 往往能给你不少的惊奇发现。孩子,
这一点千万记住! 现在你就运用刚才所学的, 自己设法找路出去吧! 」
look2);
       p->set_temp("basic1-3", 1);
       add_action("command_search3","search") ;
       return 1 ; 
     } 
     return 0;
}

int command_search3(string ob)
{

     if( !ob ) {
       return 0 ; 
     }
     if( ob == "box") {
       write ("你搬开这个大箱子, 找到了一个往东(east)的出口! 你可以用east或e来往东走。\n");
       this_player()->set_temp("basic1-4", 1);
       add("exits", ([ "east" : __DIR__"basic1-get.lpc", ]));
       set("pre_exit_func", ([ "east" : "exit_east" ]));
       return 1 ; 
     }
     return 0;
}
