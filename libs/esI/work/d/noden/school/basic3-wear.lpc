//  yogi.163.net
#include <mudlib.h>
inherit ROOM;

object p;

void create ()
{
set ("short", "高级冒险训练教室");
set ("long", @LONG
你来到一间小小的地方, 头顶上有个小小脏脏的灯泡, 微弱地发亮。
四周都是布围起来的。不知道为何, 一股神秘的紧张感在你的心中膨胀。
LONG);
set("exits", ([ "east" : __DIR__"basic3-wield.lpc", ]));
set("pre_exit_func", ([ "east" : "exit_east" ]));
set( "objects", ([ "robe" : __DIR__"item/robe.lpc" ]) );
set("light",1);
set("no_cast",1);
set("no_enhant",1);
reset();
}           

void init()
{
     p = this_player();

     p->set_temp("basic1-1", 0);
     p->set_temp("basic1-2", 0);
     p->set_temp("basic1-3", 0);
     p->set_temp("basic1-4", 0);

     write (@look

你看到班主任走过来微笑著对你说：「孩子, 好好的学吧! 」

look);
     call_out( "welcome1", 1, p );
     add_action("command_get","get") ;
}

void welcome1()
{
        write (@look
你注意到地上放了一件衣服。空气中又传来班主任那熟悉低沉有磁性的声音：
「终于来到高级训练班了。在这里一切要小心, 我们会教你一些跟战斗有关的
事情。在东方故事里, 护具依保护的位置不同分为十五种, 分别保护你的身体
各部位, 但有些护具是要特殊的种族才能穿, 其他种族是不能穿的。穿护具的
方法很简单, 用wear <护具名>即可。地上有件护具, 把它拿起来穿穿看吧。」
look);
}

int exit_east()
{
       if ( p->query_temp("basic1-4") ==0 )
       {
           write ("你想起班主任叫你把护具穿著, 还是把它穿起来吧。\n");
           return 1 ; 
       } 
       if ( p->query_temp("basic1-1")!=1 || p->query_temp("basic1-2")!=1 || p->query_temp("basic1-3")!=1 || p->query_temp("basic1-4")!=1)
       {
           write ("你感觉对wear的用法还不是很熟悉，觉得再多练习一下比较好！\n");
           return 1 ; 
       } 
       return 0;
}

int command_get(string ob)
{
     object obj ;

     if( !ob ) {
       return 0 ; 
     }

     if( ob == "robe" || ob == "all" ) {
       obj = new( __DIR__"item/robe.lpc" );
       obj->move(p);
       write (@look
你捡起一件武道服。
look);
       p->set_temp("basic1-1", 1);
       add_action("command_wear","wear") ;
       add_action("command_get2","get") ;
       return 1 ; 
     } 
     return 0;
}

int command_get2(string ob)
{

     if( !ob ) {
       return 0 ; 
     }
     if( ob == "robe" || ob == "all") {
        write (@look
班主任的声音告诉你：「 孩子。你已经拿过一件了, 继续前进吧。」
look);
        return 1;
     } 
     return 0;
}

int command_wear(string ob)
{
     if( !ob ) {
       return 0 ; 
     }

     if( ob == "robe" || ob == "all" ) {
       remove_action("command_wear","wear") ;
       call_out( "wear", 1, p );
       p->set_temp("basic1-2", 1);
       add_action("command_remove","remove") ;
       return 0 ; 
     } 
     return 0;
}

void wear()
{
        write (@look
你拿起地上的武道服, 试穿了一下, 觉得很满意。
班主任的声音又传了过来：「当你身上有很多件护具的时候, 也可以用wear all
来一次全部穿起来。要把护具脱下来用remove指令。用remove <某件装备>可以
把身上的某件装备脱下来, 用remove all则可以把所有的东西脱下来。试试看吧。」
look);
}

int command_remove(string ob)
{
     if( !ob ) {
       return 0 ; 
     }

     if( ob == "robe" || ob == "all" ) {
//       remove_action("command_remove","remove") ;
       call_out( "remove", 1, p );
       p->set_temp("basic1-3", 1);
       add_action("command_wear2","wear") ;
       return 0 ; 
     } 
     return 0;
}

void remove()
{
        write (@look
你把护具脱了下来。班主任的声音告诉你：「好极了, 孩子。现在你把护
具穿起来, 继续前进吧。」
look);
}

int command_wear2(string ob)
{
     if( !ob ) {
       return 0 ; 
     }

     if( ob == "robe" || ob == "all" ) {
       p->set_temp("basic1-4", 1);
       return 0 ; 
     } 
     return 0;
}
