#include <mudlib.h>

inherit OBJECT;

void create() {
  set_name("scroll", "卷轴");
  set_short("染血的卷轴");
  set_long(
    "/adm/daemons/npc_kills"->get_list(),
    "/adm/daemons/npc_kills"->get_list(1));
  set("unit", "卷");
  set("weight", 5);
  set("value", ({ 5, "silver" }));
  set("useless", 1);
}
