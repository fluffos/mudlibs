// armsword.c
//		铠魔剑
//
//		Lilia
#include <mudlib.h>
#include <move.h>
#define ARN "/d/noden/farwind/items/armor/"

inherit WEAPON;


void create()
{
    seteuid(getuid());
    set_name("Magic Sword", "新手之剑");
    set_short("新手之剑");
    add("id", ({"sword"}));
    set_long(@C_LONG
这是一把看起来普普通通的轻型剑，剑身上刻着“梦想成真”四个字。
C_LONG
    );
    set("unit", "把");
    set("no_sale", 1);
    set("weapon_class", 13);
    set("type", "longblade");
    set("min_damage", 12);
    set("max_damage", 20);
    set("weight", 60);
    set("second", 1);
}

void wield(int silent)
{
    object p, helm, plate, arms, hands, leggings, feet;
    string s;
    p = environment(this_object());
    s = p->query("c_name");

    if( query("wielded") ) return;
    if( !p || !living(p) ) return;
    if( userp(p) && this_object()->stop_wield(p) ) return;

     if (p->query_level() > 9 && !wizardp(p))
    {
	tell_object(p, "只有新手才能使用新手之剑。\n");
	::unwield(0);
	return;
    }

   if (p->query("wealth/silver") > 20000)
    {
        tell_object(p, "你突然想起，身上那么多银子还没交个人所得税。\n");
	::unwield(0);
	return;
    }

    if (p->query_perm_stat("int") < 2)
    {
	tell_object(p, "这把剑的构造太复杂，你不知如何使用它。\n");
	::unwield(0);
	return;
    }

    if (wizardp(p) || p->query("npc"))
    { 
        if (p->query("armor/head") || p->query("armor/body") || p->query("armor/arms") || p->query("armor/hands") || p->query("armor/legs") || p->query("armor/feet"))
        {
            tell_object(p, "你必须卸下与新手之剑冲突的护具才能装备新手之剑。\n");
	    ::unwield(0);
	    return;
        }
    }
    else
    {
	if (p->query("armor/body"))
	{
	    tell_object(p, "你必须卸下与新手之剑冲突的护具才能装备新手之剑。\n");
            ::unwield(0);
            return;
        }
    }

    tell_room(environment(p), set_color(sprintf("\n%s将新手之剑高高举起，高声喊道：「梦~想~成~真~！」\n\n", p->query("c_name")), "HIY"), p);
    tell_object(p, set_color("\n你将新手之剑高高举起，高声喊道：「梦~想~成~真~！」\n\n", "HIY"));
    tell_object(p, set_color("新手之剑呼应著你的勇气，幻化出一套盔甲。\n\n", "HIY"));

    plate = new(ARN"plate");
    plate->move(p);
    plate->equip(1);
    tell_object(p, "你顺利地穿上新手之甲。\n");
    tell_room(environment(p), s+"顺利地穿上新手之甲。\n", p);
    p->calc_armor_class();

   
        helm = new(ARN"helm");
        helm->move(p);
        helm->equip(1);
        tell_object(p, "你顺利地戴上新手之盔。\n");
	tell_room(environment(p), s+"顺利地戴上新手之盔。\n", p);
        p->calc_armor_class();
        arms = new(ARN"arms");
        arms->move(p);
        arms->equip(1);
        tell_object(p, "你顺利地戴上新手之臂。\n");
	tell_room(environment(p), s+"顺利地戴上新手之臂。\n", p);
        p->calc_armor_class();
        leggings = new(ARN"leggings");
        leggings->move(p);
        leggings->equip(1);
        tell_object(p, "你顺利地穿上新手之裆。\n");
	tell_room(environment(p), s+"顺利地穿上新手之裆。\n", p);
        p->calc_armor_class();
        hands = new(ARN"hands");
        hands->move(p);
        hands->equip(1);
        tell_object(p, "你顺利地戴上新手之手。\n");
	tell_room(environment(p), s+"顺利地戴上新手之手。\n", p);
        p->calc_armor_class();
        feet = new(ARN"feet");
        feet->move(p);
        feet->equip(1);
        tell_object(p, "你顺利地穿上新手之鞋。\n");
	tell_room(environment(p), s+"顺利地穿上新手之鞋。\n", p);
        p->calc_armor_class();
   
    tell_room(environment(p), set_color("新手之剑幻化出一套盔甲，顺利地穿在"+p->query("c_name")+"的身上!\n", "HIY"), p);
    set("prevent_drop", 1);
    set("wielded", 1);
    p->calc_weapon_class();
}

void unwield(int silent)
{
    object p, firstwep, secondwep, helm, plate, arms, leggings, hands, feet;

    p = environment(this_object());

    // quit 或装备被吃掉 (如大国师)
    if (p->query("armor/body"))
    {
    	plate = p->query("armor/body");
	plate->remove();
    }

    	if (p->query("armor/head"))
	{
     	    helm = p->query("armor/head");
	    helm->remove();
	}
	if (p->query("armor/arms"))
        {
            arms = p->query("armor/arms");
            arms->remove();
        }
	if (p->query("armor/feet"))
        {
            feet = p->query("armor/feet");
            feet->remove();
        }
	if (p->query("armor/legs"))
        {
            leggings = p->query("armor/legs");
            leggings->remove();
        }
	if (p->query("armor/hands"))
        {
            hands = p->query("armor/hands");
            hands->remove();
        }
   
    set("prevent_drop", 0);

    ::unwield(0);
}

int move( mixed place )
{    
    if( objectp(place) && !living(place) )
      call_out( "disappear", 2, this_object() );
    return ::move(place);
}

void disappear( object obj )
{
    tell_room( environment(obj), 
      "新手之剑掉在地上，消失了。\n" , obj
    );
    obj->remove();
}
