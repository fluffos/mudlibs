// arms.c

#include <mudlib.h>

inherit ARMOR;

void create() {
  set_name("magic arms", "新手之臂");
  set_short("新手之臂");
  add("id", ({ "arms", "armband" }));
  set_long("由魔力幻化而成的臂环。\n");
  set("unit", "对");
  set("weight", 0);
  set("type", "arms");
  set("material", "knight");
  set("armor_class", 2);
  set("defense_bonus", 2);
  set("no_sale", 1);
  set("prevent_drop", 1);
}

void unequip(int silent) {
  tell_object(this_player(), "新手之臂拒绝离开你的身体!\n");
}

int remove() {
  object p;
  p = environment(this_object());

  if (p && query("equipped"))
    ::unequip(0);
  return ::remove();
}
