// feet.c


#include <mudlib.h>

inherit ARMOR;

void create()
{
    set_name("magic feet", "新手之鞋");
    set_short("新手之鞋");
    add("id", ({ "feet" }));
    set_long("由魔力幻化而成的鞋子。\n");
    set("unit", "双");
    set("weight", 0);
    set("type", "feet");
    set("material", "knight");
    set("armor_class", 4);
    set("defense_bonus", 2);
    set("no_sale", 1);
    set("prevent_drop", 1);
}

void unequip(int silent)
{
    tell_object(this_player(), "新手之鞋拒绝离开你的身体!\n");
}

int remove()
{
    object p;
    p = environment(this_object());

    if (p && query("equipped"))
        ::unequip(0);
    return ::remove();
}
