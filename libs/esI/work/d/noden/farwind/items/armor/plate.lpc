// plate.c


#include <mudlib.h>

inherit ARMOR;

void create()
{
    set_name("magic plate", "新手之甲");
    set_short("新手之甲");
    add("id", ({ "plate" }));
    set_long("由魔力幻化而成的铠甲。\n");
    set("unit", "件");
    set("weight", 0);
    set("type", "body");
    set("material", "knight");
    set("armor_class", 25);
    set("defense_bonus", 3);
    set("no_sale", 1);
    set("prevent_drop", 1);
}

void unequip(int silent)
{
    tell_object(this_player(), "新手之甲拒绝离开你的身体!\n");
}

int remove()
{
    object p;
    p = environment(this_object());

    if (p && query("equipped"))
        ::unequip(0);
    return ::remove();
}
