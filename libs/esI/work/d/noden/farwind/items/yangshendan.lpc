#include <mudlib.h>

inherit OBJECT;

void init()
{
	add_action( "eat_food", "eat" );
}

void create()
{
	set_name( "dan", "养心丹" );
	add( "id", ({ "dan" }) );
	set_short( "养心丹" );
	set_long(@C_LONG
这是一颗乌溜溜的暗红色丹丸，据说服用(eat)后可以帮助集中精神。
C_LONG
	);
	set( "no_sale", 1 );
	set( "unit","颗");
	set( "weight", 1 );
	set( "value", ({ 300, "gold" }) );
}

int eat_food(string arg)
{
	if( !arg || ( arg !="dan" && arg !="yangxindan")  ) 
	return notify_fail("吃什麽??"); 
	write( 
	"你吃下一颗养心丹，全身疼痛不已，你心想糟了，吃到假货了......\n" );
	tell_room( environment(this_player()), 
	this_player()->query("c_cap_name")+
	"大叫一声，头上冒出一个一个豆大的汗珠~~\n" , this_player()
		);
//		this_player()->receive_healing( 3+random(2) );
		this_player()->set("spell_points",100);
//	        this_player()->set("spell_points",(int)this_player()->query("max_fp"));
	remove();
	return 1;
}

