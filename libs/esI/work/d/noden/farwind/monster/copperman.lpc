#include <mudlib.h>

inherit MONSTER;

void create() {
  ::create();
  set_level(1);
  set_name("copperman", "铜人");
  add("id", ({ "man" }));
  set_short("铜人");
  set_long(
    "一个脏西西的铜人，身上到处都是伤痕，好象经常被人殴打一般。\n"
  );
  set_heart_beat(1);
  set_perm_stat("dex", 3);
  set_perm_stat("str", 3);
  set("max_hp", 896000);
  set("hit_points", 896000);
  set("natural_armor_class", 1);
  set("natural_weapon_class1",);
  set("natural_min_damage1", 1);
  set("natural_max_damage1", 2);

}
