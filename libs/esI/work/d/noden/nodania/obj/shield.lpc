#include <mudlib.h>

inherit ARMOR;

void create() {
  set_name("steel shield", "钢盾");
  add("id", ({ "shield" }));
  set_short("钢盾");
  set_long(
    "一面擦得闪亮耀眼的钢盾。\n"
  );
  set("unit", "面");
  set("type", "shield");
  set("material", "heavy_metal");
  set("armor_class", 7);
  set("weight", 100);
  set("value", ({ 1130, "silver" }));
}
