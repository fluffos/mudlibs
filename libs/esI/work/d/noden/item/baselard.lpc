#include <mudlib.h>
//int box_moved;
inherit WEAPON;

void create() {
  seteuid(getuid());
  set_name("baselard", "短刀");
  set_short("短刀");
  set_long(
    "这是一把短刃的小型短刀，刀柄用布条缠著。\n"
  );
  set("unit", "把");
  set("type", "shortblade");
  set("weapon_class", 5);
  set("min_damage", 3);
  set("max_damage", 8);
  set("weight", 30);
  set("value", ({ 35, "silver" }));
}
