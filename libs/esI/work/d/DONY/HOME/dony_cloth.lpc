#include "mudlib.h"

inherit ARMOR;

void create()
{
        set_name("wonderful cloth","如意衣");
        add("id",({"cloth"}) );
        set_short("如意衣");
	set_long(@C_LONG
这是 宁丹 最爱穿的衣服。
C_LONG	         );
	set( "unit", "件" );
	set( "weight",1 );
	set( "type", "body" );
        set("material","knight");
	set( "defense_bonus", 1 );
	set( "value", ({ 3800, "silver" }) );
	set("no_sale",1);
        set("prevent_drop",1);
        set( "equip_func","equip_cloth");
        set( "unequip_func","unequip_cloth" );
}
void kk(object player,int a,int b,int c,int d,int e,int f,int g,int h,int i)
{
    player->set_perm_stat("str",a);
    player->set_perm_stat("dex",b);
    player->set_perm_stat("pie",c);
    player->set_perm_stat("int",d);
    player->set_perm_stat("con",e);
    player->set_perm_stat("kar",f);
    player->set_skill("parry",g);
    player->set_skill("block",h);
    player->set_skill("dodge",i);
}

int equip_cloth()
{
        this_player()->add_temp("can_pass_spell",1 );
        this_player()->delete("aiming_loc");
        set( "armor_class", 35 );
        switch(this_player()->query("class")){
        case "healer": set( "defense_bonus", 50 );
                       set("material","healer");
                       kk(this_player(),19,19,25,25,20,20,0,0,60);
                       break;
        case "mage":   set("defense_bonus",52);
                       set("material","mage");
                       kk(this_player(),15,20,20,27,15,23,0,0,60);
                       break;
        case "knight": set("defense_bonus",35);
                       set("material","knight");
                       set( "armor_class", 80 );
                       kk(this_player(),25,20,20,15,25,15,100,100,0);
                       break;
        case "scholar":set("defense_bonus",42);
                       kk(this_player(),17,25,17,25,18,18,60,0,60);
                       set("material","scholar");
                       break;
        case "monk":   set("defense_bonus",30);
                       set("material","monk");
                       kk(this_player(),24,24,16,14,27,15,0,0,100);
                       this_player()->set_skill("unarmed-parry",100);
                       break;
        case "thief":  set("defense_bonus",34);
                       set("material","thief");
                       kk(this_player(),16,27,14,20,18,25,0,0,100);
                       break;
            default :  set("defense_bonus",40);
            	       kk(this_player(),20,20,20,20,20,20,60,60,60);
            	       break;                                                                                                              
        }
        return 1;
}
int unequip_cloth()
{
        this_player()->add_temp("can_pass_spell",-1);
        return 1;
}
int query_auto_load() { return 1; }
