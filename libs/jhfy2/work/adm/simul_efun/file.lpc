private int valid(object obj, string filename) {
  string euid;

  if (!obj) return 0;
  euid = geteuid(obj);
  switch (SECURITY_D->get_status(obj)) {
    case "(player)": return 1;
    case "(immortal)": return 0;
    case "(wizard)":
      if (sscanf(filename, "/u/" + euid + "/%*s"))
        return 1;
      write("警告：你只能操作属于自己目录下的文件。\n");
      return 0;
    case "(admin)": return 1;
  }
  return 0;
}

void ed(string filename) {
  if (valid(previous_object(), filename))
    efun::ed(filename);
}

int cp(string src, string dst) {
  //    if ( valid(previous_object(),src) && valid(previous_object(),dst) )
  if (valid(previous_object(), dst))
    return efun::cp(src, dst);
}
int rm(string filename) {
  if (valid(previous_object(), filename))
    return efun::rm(filename);
}

void cat(string file) {
  if (file_size(file) < __LARGEST_PRINTABLE_STRING__)
    write(read_file(file));
  else
    write("文件“" + file + "”太长，请用more命令。\n");

}
void assure_file(string file);
void log_file(string file, string text) {
  // FIX (AGENTS.md §7.11-class): file may include a subdirectory under
  // LOG_DIR (e.g. "login/newid.log") that doesn't exist in a fresh
  // work/ tree -- write_file() throws uncaught in that case.
  // adm/daemons/logind.lpc's get_gender() (the LAST step of
  // new-character registration) calls
  // log_file("login/newid.log", ...) right before enter_world() --
  // same shape as ffxymud's/hc's/jhfy's originally-discovered bug
  // this session, which silently broke every fresh registration.
  assure_file(LOG_DIR + file);
  write_file(LOG_DIR + file, text);
}
void assure_file(string file) {
  string path, *dir;
  int i;
  if (file_size(file) != -1) return;
  seteuid(ROOT_UID);
  dir = explode(file, "/");
  dir = dir[0..sizeof(dir) - 2];
  path = "/";
  for (i = 0; i < sizeof(dir); i++) {
    path += dir[i];
    mkdir(path);
    path += "/";
  }
}
string base_name(object ob) {
  string file;
  if (sscanf(file_name(ob), "%s#%*d", file) == 2)
    return file;
  else
    return file_name(ob);
}
