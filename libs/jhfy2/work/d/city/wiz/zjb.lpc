#include <ansi.h>
inherit NPC;
void create()
{
        set_name(HIW "星空" NOR, ({ "zjb npc" }) );

        set("gender", "男性");
        set("age", 19); 
        set("long", 
"星空.一个不寻常的名字,他的主人也是一个不寻常的人\n"
"星空原来是风云再起中pker群中的其中一名pker,因为其\n"
"PK方法自成一派,和各位江湖好友一起先后成立了〖洪兴\n"
"社〗和〖恨天阁〗两个帮派,先后担任了两个帮派的帮主\n"
"后来因感到玩MUD无趣,改向WIZ方向发展,先后参与了好几\n"
"个MUD的开发,后因各种关系各个站点都分别关了,刚好好\n"
"友SNOW重开江湖风云,因是官方服务器,认为有前途,受邀\n"
"来到风云再起参与开发,先后写了通吃帮等新帮派上来,是\n"
"风云再起的主要的巫师之一.\n");
        set("attitude", "peaceful");
        set("title", HIG"孤独的男人"NOR);
        set("nickname", HIB"〖"HIC"恨天阁"HIB"〗" HIW"阁主"NOR);
        set("chat_chance", 3);        
               setup();
        carry_object("/clone/misc/cloth")->wear();
}

