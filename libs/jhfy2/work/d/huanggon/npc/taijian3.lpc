// 王太监

#include <ansi.h>
// lei 1998 10 26

inherit NPC;
	
inherit F_UNIQUE;
string ask_me();

void create()
{
	set_name("李公公", ({"li zongguan", "li", "zongguan"}));
	set("gender", "无性");
	set("age", 53);
	set("title", HIR "内务总管" NOR);
	set("long", 
"这家伙能爬到今天这个位置也够累的,可现在目空一切,胆大妄为,\n"
"在内宫里大肆收刮.你有黄金他才会给你好脸色.\n");
	set("combat_exp", 500000);

        set("str", 24);
        set("dex", 17);
        set("con", 28);
        set("int", 27);
	set("shen_type", 1);

        set("attitude", "friendly");
        set_skill("dodge", 470);

	set_skill("unarmed", 450);
	set_skill("parry", 460);
        set_skill("force", 440);
        set_temp("apply/attack", 40);
	set_temp("apply/defense", 40);
	setup();
        add_money("coin", 50);
	carry_object("/d/huanggon/obj/cloth2")->wear();
}
	
int accept_object(object who,object ob)
{
	object cloth;
	cloth = new("/d/huanggon/obj/cloth2");
	if(ob->query("money_id") && ob->value() >= 10000)
	{
		tell_object(who, "李公公扬了扬眉:还行.把这件穿上,小心别让人看破了,快点出来.");
		cloth->move(who);
		who->set_temp("neigong", 1);
	return 1;
	}
	return 0;
}

