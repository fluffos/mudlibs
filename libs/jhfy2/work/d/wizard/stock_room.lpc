// /d/wizard/stock_room.c
// change by edward

#include <room.h>
inherit ROOM;

void create()
{
        set("short", "秘密股票会客室");
        set("long", @LONG
这里是是股民们聚会的场所. 如果你有什么问题或有什么小道消息,
可以在这里留言(post)。欢迎提供准确信息, 大家一起发大财. 版主
会在玩家推荐后一段时间内跟踪相关消息,看谁的可信度最高.
LONG
        );

        set("exits", ([
                  "east": "/d/city/chatroom",
 "up" : "/d/city/qiyuan/qiyuan1",
           ]));
        set("no_fight", "1");

        setup();
        call_other("/clone/board/stock_b", "???");
}

void init()
{
      object tingyu_room=find_object("/d/city2/tingyu");
       if (!userp(this_player())) return;
      if (!objectp(tingyu_room))
          tingyu_room=load_object("/d/city2/tingyu");
}

