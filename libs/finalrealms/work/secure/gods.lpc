/* FluffOS PORT NOTE: secure/master.lpc's create2() calls
 * "/secure/gods.lpc"->query_gods() unconditionally on every boot to build
 * its `gods` array (the array query_lord()/high_programmer() check
 * permissions against), but this file never actually defined that
 * function -- a genuine pre-existing gap (query_boo() here is unrelated,
 * a per-name flavour-text lookup). Without it, call_other() to a
 * nonexistent function returns 0, so `gods` never gets "god" (or anyone)
 * added to it, silently breaking every query_lord()/high_programmer()
 * check mud-wide. Since the boot banner itself instructs first-time
 * admins to log in as 'god', that account is clearly meant to be a god;
 * added the minimal real definition. */
/* "fluffos" added per this project's admin-account convention (see
 * README.md's "Admin account" section) -- registered as a normal mortal
 * first, then granted here, matching how "god" itself is a plain
 * gods-list name, not any driver-level special-casing. */
string *query_gods() { return ({ "god", "fluffos" }); }

string query_boo(string str);

string query_boo(string str)
{
 switch(str)
 {
  case "god":
    return "Some stuff he has to decide upon";
  default:
    return 0;
 }
}  
