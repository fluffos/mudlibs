#include "path.h"
inherit "/std/storeroom";

inherit STOCK+"restock.lpc";

void setup()
{
	set_short("Darklor's Smithy");
     set_long("This is the storeroom for Darklor's Smithy.  There "
		"are weapons and armors lining the walls.\n\n");

   add_exit("out",ROOM+"dwarf32.lpc","out");
   set_light(60);
}

void reset() {

   call_out("after_reset", 0);
}

void after_reset() {

   restock(2,"chainmails",ARMOR+"dwarven_chain.lpc");
   restock(4,"pairs of gauntlets",ARMOR+"dwarven_gauntlets.lpc");
   restock(2,"leathers",ARMOR+"leather.lpc");
   restock(3,"helmets",ARMOR+"dwarven_helm.lpc");
   restock(5,"short swords",WEAPON+"short_sword.lpc");
   restock(4,"knives",WEAPON+"knife.lpc");
   restock(4,"gloves",ARMOR+"gloves.lpc");
   restock(10,"daggers",WEAPON+"dagger.lpc");
}
