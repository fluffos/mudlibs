#include "path.h"
inherit "/std/storeroom";

inherit ROOM+"restock.lpc";

setup() {
	set_short("Zundrin's Equipment Shop");
	set_long("This is the storeroom for Zundrin's Equipment "
		"shop.  There are several items on the shelves here.  "
		"\n\n");

   add_exit("out",ROOM+"dwarf30.lpc","out");
   set_light(60);
}

void reset() {

   call_out("after_reset", 0);
}

void after_reset() {

	restock(10,"torches",MISC+"torch.lpc");
	restock(4,"buckets",MISC+"wood_bucket.lpc");
	restock(5,"picks",MISC+"pick.lpc");
	restock(3,"leathers",ARMOR+"leather.lpc");
   restock(4,"Coils of rope", MISC + "rope.lpc");
}
