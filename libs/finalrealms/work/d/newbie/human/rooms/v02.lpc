#include "path.h"
inherit "/std/shop";
void setup()
{
    add_property("no_undead",1);
    set_short("Isle of Havmand: Shop");
    set_light(LIGHT);
    add_exit("east",HAVMAND+"t04.lpc","path");
    set_long("\nIsle of Havmand: Shop.\n\n"
    "   This is a small shop which doesn't seem to do a lot of business, mainly "
    "because everyone in this village is so poor.\n "
    "   Type \"list\" to get a list of the wonderful objects "
	 "\"browse\" to look at your object before you buy it, \"value\" "
	"to value your object before you \"sell\" it and of course \"buy\" "
    "to buy your wonderous object.\n\n");
   set_open_condition("do_check");
    set_store_room(HAVMAND+"storeroom.lpc");

   add_clone(CHARS+"woman",1);
   set_item_table(HAVMAND+"SHOP_TABLE");

}
void init() {
::init();
}

// AGENTS.md \S7.145: this used to be double-registered via
// add_action("do_check","buy")/add_action("do_check","sell") in init(),
// which since it's the MOST recently added sentence for those verbs, ran
// BEFORE (and instead of) /std/shop.lpc's own real add_action("buy","buy")/
// ("sell","sell") -- and because it unconditionally `return(1)`s whenever
// the shopkeeper is present, it silently swallowed every buy/sell command
// outright (a bare "handled, no output" success) without ever reaching the
// real shop logic. The already-present-but-commented-out
// set_open_condition("do_check") line above is /std/shop.lpc's actual,
// correct integration point for this exact 0/1 "is the shop open"
// contract (consulted internally by buy()/sell()/value()/etc via
// test_open()) -- restored that instead of the add_action pair.
int do_check(string str)
{
   if(!present("old woman"))
   {
      notify_fail("Sorry, the shopkeeper is not present to help you.\n");
        return 0;
   }
   return(1);
}



