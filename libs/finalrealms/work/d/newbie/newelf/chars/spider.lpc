inherit "obj/monster.lpc";
void setup()
{
    set_name("spider");
    set_short("Spider");
    set_long("This is a big, fat, hairy spider.  It is very black and seems "
      "to regard you rather intently.  Every now and again "
      "it will shift a leg slightly.\n\n");
    set_level(1);
    set_al(0);
    set_gender(random(2)+1);
    set_xp(200);
}

