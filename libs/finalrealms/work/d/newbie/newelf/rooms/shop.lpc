#include "path.h"
inherit "/std/shop";
void setup()
{
    add_property("no_undead",1);
    set_short("Galastriia :  Shop.");
    set_light(65);
    set_long("\nGalastriia :  Shop.\n\n"
      "This shop is set in the base of a long dead tree.  It appears to be quite old, and "
      "the family that mantains it manages to keep it relatively well stocked.\n"
      "Type \"list\" to see a list of what is offered for sale "
      "\"browse\" to look at something before you buy it.  \"Value\" "
      "is to see the how much your object is worth before you \"sell\" it, and \"buy\" is "
      "to purchase an object from the store.\n\n");
    set_open_condition("do_check");
    add_exit("north",ROOMS+"aaroc_center.lpc","door");
    set_store_room(ROOMS+"storeroom.lpc");

    add_clone(CHAR+"geldon.lpc",1);
    set_item_table(ROOMS+"SHOP_TABLE");



}
void init() {
    ::init();
}

// AGENTS.md \S7.145: this was double-registered via add_action(...,
// "buy"/"sell") in init(), which shadowed and completely swallowed
// /std/shop.lpc's own real buy()/sell() (see d/newbie/human/rooms/v02.lpc
// for the full writeup of that half of this bug) -- restored the correct
// set_open_condition("do_check") wiring above instead. Separately, this
// room's own shopkeeper NPC (chars/geldon.lpc, cloned above) is named
// "geldon", not "Old woman" -- the present() check below was copy-pasted
// from the generic "Old woman"-shopkeeper shop template other newbie
// zones use, so it would have permanently reported "shopkeeper not
// present" even after the dispatch fix. Corrected to match this room's
// actual NPC.
int do_check(string str)
{
    if(!present("geldon"))
    {
	notify_fail("Sorry, the shopkeeper is not present to help you.\n");
	return 0;
    }
    return(1);
}



