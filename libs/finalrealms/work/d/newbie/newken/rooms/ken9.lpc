#include "path.h"

inherit ROOMS+"gen.lpc";
void setup(){my_setup();
    set_short("Highlo : Forest Hill  \n");
    set_light(LIGHT);
    add_property("no_undead",1);
    set_long("Forest Hill.  \n\n"
      "\n\n");


    add_item(({"tree","trees","forest"}),TREE);
    add_sound(({"birds","wildlife","bird","songs"}),BIRDS);
    add_feel(({"ground","dirt","floor"}),GROUND);
    add_exit("northeast",ROOMS+"ken3.lpc","path");
    add_exit("south",ROOMS+"ken10.lpc","path");
    add_exit("southwest",ROOMS+"ken11.lpc","path");
    add_exit("west",ROOMS+"ken12.lpc","path");
}


