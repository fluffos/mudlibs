// waiter.c

inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("唐可卿", ({ "tang" }));
  set("gender", "女性");
  set("age", 22);
  set("long",
    "这位唐可卿笑咪咪地望着你。\n");
  set("combat_exp", 500000);
  set_skill("unarmed", 200);
  set_skill("dodge", 200);
  set_skill("move", 200);
  set("attitude", "friendly");
  set("vendor_goods", ([
    __DIR__ "obj/egg": 10,
  ]));
  setup();
  carry_object(__DIR__ "obj/ao")->wear();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(3)) {
    case 0:
      say("唐可卿笑咪咪地说道：这位" + RANK_D->query_respect(ob)
        + "，进来喝杯茶，歇歇腿吧。\n");
      break;
    case 2:
      say("唐可卿说道：这位" + RANK_D->query_respect(ob)
        + "，进来喝几盅小店的红酒吧，这几天才从窖子里开封的哟。\n");
      break;
  }
}
