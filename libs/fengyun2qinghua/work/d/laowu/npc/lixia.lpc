// mother.c
inherit NPC;

void create() {
  set_name("李霞", ({ "lixia" }));
  set("gender", "女性");
  set("age", 25);
  set("long", @LONG
这个女人看起来二十多岁了，看著她粗壮的身形，你觉得．．．。
LONG);

  set("attitude", "peaceful");

  setup();

  carry_object(__DIR__ "obj/ao")->wear();
}

int accept_object(object who, object ob) {
  if (ob->value() >= 100000) {
    write("李霞神秘的说：听说冰河的西南面有些古怪...\n");
    who->set_temp("fang/lixia", 1);
    return 1;
  } else {
    write("李霞说道：我的消息可不止这么些个钱。\n");
    return 1;
  }
}
