// mother.c
inherit NPC;

void create() {
  set_name("老屋人", ({ "laowuren" }));
  set("gender", "男性");
  set("age", 35);
  set("long", @LONG
这是一位久居拉哈苏的本地人。
LONG);
  set("combat_exp", 10000 + random(10) * 100);
  set_skill("unarmed", 10 + random(10));
  set_skill("dodge", 10 + random(10));
  set_skill("move", 10 + random(10));

  set("attitude", "peaceful");

  setup();

  carry_object(__DIR__ "obj/ao")->wear();
  add_money("silver", 10);
}
