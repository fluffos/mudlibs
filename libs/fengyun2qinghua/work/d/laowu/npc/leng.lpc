// waiter.c

inherit NPC;
inherit F_VENDOR;

void create()
{
	set_name("冷红儿", ({ "lehong" }) );
	set("gender", "女性" );
	set("age", 22);
    set("str", 200);
	set("long",
		"这位老板娘正斜依在柜台边，笑咪咪地望着你。\n");
	set("combat_exp", 500000);
    set_skill("unarmed", 200);
    set_skill("dodge", 200);
    set_skill("move", 200);
	set("attitude", "friendly");
	set("vendor_goods", ([
        __DIR__"obj/renshen" : 20,
        __DIR__"obj/xiong" : 20,
        __DIR__"obj/lurong" : 20,
	]) );
	setup();
    carry_object(__DIR__"obj/ao")->wear();
}

void init()
{	
	add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	switch( random(3) ) {
		case 0:
			say( "冷红儿纤腰微摆，露出羊脂般的玉臂，向你招了招手。\n");
			break;
	}
}
