// token.c


inherit ITEM;

void create()
{
        set_name("罗刹牌", ({ "luocha" }) );
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "块");
                set("value", 10000);		
                set("long", "一块象征的权威和力量的罗刹牌。\n");
                set("material", "paper");
        }
        setup();
}
