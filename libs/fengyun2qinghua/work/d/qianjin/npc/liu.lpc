// teacher.c

inherit NPC;

void create()
{
	set_name("湖上柳", ({ "liu" }) );
	set("gender", "女性" );
	set("age", 18);
    set("per", 30);
    set("title", "湖上八娇");
    set("long", 
"这是千金楼湖上八娇之一．
湖上柳，烟里不胜催。
宿雾洗开明媚眼，东风摇弄好腰肢，烟雨更相宜。
环曲岸，阴覆画桥低。
线拂行人春晚后，絮飞晴雪暖风时，幽意更依依。
\n");
    set("attitude", "friendly");
    set("combat_exp", 50000);
    set_skill("whip", 60);
    set_skill("unarmed", 60);
    set_skill("dodge", 60);
    set_temp("apply/liuyu", 1);
	setup();
    carry_object(__DIR__"obj/liucloth")->wear();
    carry_object(__DIR__"obj/wuqi")->wield();
    add_money("gold", 5);
}

int accept_object(object who, object ob)
{
    object obj;
    if(query_temp("apply/liuyu") && random((int)(ob->value() / 10000 - 98)))   {
    obj = new(__DIR__"obj/liuyu");
    obj -> move(who);
    delete_temp("apply/liuyu"); }
    return 1;
} 

