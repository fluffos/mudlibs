// cloth.c
//
// This is the basic equip for players just login.
#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create()
{
	set_name(YEL"团金褂"NOR, ({ "cloth" }) );
	set_weight(3000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("value", 1000);
		set("long", "这是一件绣着九龙九凤的团金褂。\n");
		set("material", "cloth");
		set("armor_prop/armor", 10);
	}
	setup();
}
