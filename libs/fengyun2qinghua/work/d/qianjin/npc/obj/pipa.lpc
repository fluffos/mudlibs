// hammer.c

#include <weapon.h>

inherit HAMMER;

void create()
{
        set_name("翠玉琵琶", ({ "pipa" }) );
        set_weight(8000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long", "一把翠玉琵琶。\n");
                set("value", 3);
                set("material", "iron");
                set("wield_msg", "$N拿出一把$n抱在怀中。\n");
                set("unwield_msg", "$N放下手中的$n。\n");
        }

        init_hammer(15);
        setup();
}
