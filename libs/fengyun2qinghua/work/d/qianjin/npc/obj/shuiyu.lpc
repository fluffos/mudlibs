// yu.c


inherit ITEM;

void create() {
  set_name("水玉璧", ({ "shuiyu" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("long", "一块晶莹剔透的水玉璧。\n");
    set("material", "paper");
    set("value", 0);
  }
  setup();
}

void init() {
  add_action("do_combine", "combine");
}

int do_combine() {
  object me, ob1, ob2, ob3, ob4, ob5, ob6, ob7, ob8, guyu;
  me = this_player();
  ob1 = this_object();
  if (!(ob2 = present("yueyu", me))) return 0;
  if (!(ob3 = present("liuyu", me))) return 0;
  if (!(ob4 = present("xueyu", me))) return 0;
  if (!(ob5 = present("nuyu", me))) return 0;
  if (!(ob6 = present("huayu", me))) return 0;
  if (!(ob7 = present("caoyu", me))) return 0;
  if (!(ob8 = present("jiuyu", me))) return 0;
  message_vision("$N拿着八块玉在手中摆弄了一阵，只听喀啦一声响，八玉合一，奇迹出现。\n", me);
  guyu = new(__DIR__ "guyu");
  guyu->move(me);
  destruct(ob8);
  destruct(ob7);
  destruct(ob6);
  destruct(ob5);
  destruct(ob4);
  destruct(ob3);
  destruct(ob2);
  destruct(ob1);
  return 1;
}
