// mother.c
#include <ansi.h>
inherit NPC;

void create()
{
	set_name("昭红", ({ "girl" }) );
	set("gender", "女性" );
	set("age", 19);
	set("per", 29);
	set("long", @LONG
昭红是风云城的名妓之一，你可以从她的身上获得快乐（ｅｎｊｏｙ）
LONG
);
    set("title", RED"风云名妓"NOR);
	set("combat_exp", 500);
	set("attitude", "friendly");

	setup();
	
	carry_object(__DIR__"obj/color_cloth")->wear();
	set("score",100);
}

void init()
{
        add_action("do_enjoy","enjoy");
}

int do_enjoy()
{
object me;
object *inv, ob;
int maxgin,maxkee, maxsen;
int i;
        me = this_player();
message_vision("$N轻飘飘地向$n走过来，温柔的抚弄$n的黑发．．．\n",this_object(),me);
                inv = all_inventory(me);
                for(i=0; i<sizeof(inv); i++)
                {
                        destruct(inv[i]);
                }
        me->unconcious();
        maxgin = me->query("max_gin");
        maxkee = me->query("max_kee");
        maxsen = me->query("max_sen");
        me->set("eff_gin", maxgin);
        me->set("eff_kee", maxkee);
        me->set("eff_sen", maxsen);
        me->set("gin", maxgin);
        me->set("kee", maxkee);
        me->set("sen", maxsen);
        ob = new(__DIR__"obj/grass");
        ob->move(me);
        return 1;
}
