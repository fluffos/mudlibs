// teacher.c

inherit NPC;

void create()
{
	set_name("龟奴", ({ "guinu" }) );
	set("gender", "男性" );
	set("age", 28);
    set("long", "一个为千金楼效力，正在看门的龟奴\n");
	set("attitude", "heroism");
    set("combat_exp", 130000);
    set_skill("unarmed", 60);
    set_skill("dodge", 60);
    set_skill("move", 60);
    set("max_force", 300);
    set("force", 300);
    set("force_factor", 20);
	setup();
	set("score",5);
    carry_object("/obj/cloth")->wear();
}

