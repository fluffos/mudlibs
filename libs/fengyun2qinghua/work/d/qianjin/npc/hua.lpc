// teacher.c

inherit NPC;

void create()
{
	set_name("湖上花", ({ "hua" }) );
	set("gender", "女性" );
	set("age", 18);
    set("per", 30);
    set("title", "湖上八娇");
    set("long", 
"这是千金楼湖上八娇之一．
湖上花，天水浸灵芽。
浅蕊水边匀玉粉，浓苞天外剪明霞，日在列仙家。
开烂熳，插鬓若相遮。
水殿春寒幽冷艳，玉轩晴照暖添华，清赏思何赊。
\n");
    set("attitude", "friendly");
    set("combat_exp", 50000);
    set_skill("unarmed", 60);
    set_skill("dodge", 60);
    set_temp("apply/huayu", 1);
	setup();
    carry_object(__DIR__"obj/huacloth")->wear();
    add_money("gold", 5);
}

int accept_object(object who, object ob)
{
    object obj;
    if ((string)ob->query("name")!="黑玉发簪")return 0;
    command("smile");
    command("say 多谢!");
    if(query_temp("apply/huayu"))   {
    obj = new(__DIR__"obj/huayu");
    obj -> move(who);
    delete_temp("apply/huayu"); }
    return 1;
} 
