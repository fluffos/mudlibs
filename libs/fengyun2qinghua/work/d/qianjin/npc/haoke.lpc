// mother.c
inherit NPC;

void create()
{
	set_name("大胡子豪客", ({ "haoke" }) );
	set("gender", "男性" );
	set("age", 35);
	set("long", @LONG
这是一位满脸胡子的大豪客
LONG
);
	set("combat_exp", 100000);
    set_skill("unarmed", 80);
    set_skill("dodge", 80);
    set_skill("move", 80);
	set("attitude", "friendly");

	setup();
	
	carry_object("/obj/cloth")->wear();
	set("score",-10);
}

