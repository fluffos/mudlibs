// teacher.c

inherit NPC;

void create()
{
	set_name("湖上月", ({ "yue" }) );
	set("gender", "女性" );
	set("age", 18);
    set("per", 30);
    set("title", "湖上八娇");
    set("long", 
"这是千金楼湖上八娇之一．
湖上月，偏照列仙家。
水浸寒光铺枕簟，浪摇晴影走金蛇，偏称泛灵槎。
光景好，轻彩望中斜。
清露冷侵银兔影，西风吹落桂花枝，开宴思无涯。
\n");
    set("attitude", "friendly");
    set("combat_exp", 50000);
    set_skill("hammer", 60);
    set_skill("unarmed", 60);
    set_skill("dodge", 60);
    set_temp("apply/yueyu", 1);
	setup();
    carry_object(__DIR__"obj/yuecloth")->wear();
    carry_object(__DIR__"obj/pipa")->wield();
    add_money("gold", 5);
}

int accept_object(object who, object ob)
{
    object obj;
    if ((string)ob->query("name")!="生烧扒翅")return 0;
    command("smile");
    command("say 多谢!");
    if(query_temp("apply/yueyu"))   {
    obj = new(__DIR__"obj/yueyu");
    obj -> move(who);
    delete_temp("apply/yueyu"); }
    return 1;
} 
