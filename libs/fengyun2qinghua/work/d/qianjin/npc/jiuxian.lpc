// mother.c
#include <ansi.h>
inherit NPC;

void create()
{
	set_name("卜亚男", ({ "girl" }) );
	set("gender", "女性" );
	set("age", 23);
	set("per", 26);
	set("long", @LONG
卜亚男从来没醉过，多少英雄好汉都倒在她的石榴裙下．
LONG
);
    set("title", MAG"酒仙"NOR);
	set("combat_exp", 0);
	set("attitude", "friendly");

	setup();
	
	carry_object(__DIR__"obj/shiliu")->wear();
}

int accept_object(object who, object ob)
{
    if ((string)ob->query("liquid/type")=="alcohol") {
        if ((int)ob->query("liquid/remaining") == 0) {
            command("shake");
            command("say 空的我不要...");
            return 0;
        }
        else {
            command("smile");
            command("say 多谢!");
            return 1;
        }
    }
    else return 0;
}
 
