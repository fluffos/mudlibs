#include <ansi.h>
#include <localtime.h>
inherit ROOM;
void create()
{
        set("short", "千金楼外");
        set("long", 
"此楼虽不在京都，但却是中原最有名的青楼。这里有最贵的酒，
也是最好的酒；这里有最贵的女人，也是最有味儿的女人；这里有最
贵的服务，也是最好的服务。朱红大门上牌（ｓｉｇｎ）一块，又高
悬一块御赐金匾：

                        "+HIR"春色无边"NOR+"

"
        );
        set("exits", ([ /* sizeof() == 4 */
  "east" : "/d/fy/swind4",
  "west" : __DIR__"qianjin1",
]));
        set("item_desc", ([
                "sign": "千金楼楼规：
１．不可夹带任何兵器入楼。
２．以防您被千金楼小姐误认为没有消费能力，
　　不可夹带任何食物，酒水入楼。
３．大家出门在外是朋友，相互给点面子，
　　打架，闹事者楼规处置。
４．＂赏头＂给得越多，您受的伺侯越好。\n"
        ]) );
        set("NONPC",1);
		set("no_fight",1);
        set("no_magic",1);
        set("objects", ([
                __DIR__"npc/guinu" : 2,
       ]) );

        setup();
}

int valid_leave(object me, string dir)
{
        object *inv;
        object ob;
    	mixed *local;
        int i;
    	local = localtime(time() * 60-890000000);
        if( dir == "west" && ob=present("guinu", this_object()))
        {
                inv = all_inventory(me);
                for(i=0; i<sizeof(inv); i++)
            if(inv[i]->query("weapon_prop") || inv[i]->query("food_remaining") || 
            inv[i]->query("liquid/remaining"))
            {
            message_vision("$N向$n笑道：你还是先看看告示吧。\n", ob, me); 
            return notify_fail("");
            }
            else if(((local[LT_HOUR]+1)%24)/2 > 1 && ((local[LT_HOUR]+1)%24)/2 < 9)
            {
            message_vision("$N望望天，对$n笑着说：时辰尚早，姑娘们还在睡，您．．．
忍耐一下吧！\n", ob, me);
            return notify_fail("");
            }
        me -> set("food", 0);
        me -> set("water", 0);
        }
        return 1;
}

