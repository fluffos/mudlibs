inherit ROOM;

string look_sign(object);

void create()
{
	set("short", "银钩赌坊大厅");
	set("long", @LONG
一眼看过去，这大厅里真是金碧辉煌，堂皇富丽，连烛台都是纯
银的，在这种地方输了千儿八百两金子，没人会觉得冤枉。大厅里摆
满了大大小小的赌桌，只要能说出名堂的赌具，这里都有。有匾
（ｓｉｇｎ）一块。
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
  		"east" : __DIR__"yingou",
  		"north" : __DIR__"yingou2",
]));
        set("item_desc", ([
                "sign": (: look_sign :),
        ]) );
    set("objects", ([
        __DIR__"npc/huang" : 1,
        __DIR__"npc/obj/book": 1,
                        ]) );
	setup();
}

string look_sign(object me)
{
    return ("
骰子的赌法：

ｂｅｔ　＜种类＞　＜银量＞

种类：　０，１，２，３到１８
０：　          赌小    （３－１０）    一赔一
１：            赌大    （１１－１８）  一赔一
２：　          赌围骰  （三粒骰子同点）一赔三十六
３－１８        赌单点                  一赔八

例子：
ｂｅｔ　０　５０
赌五十两在小上 \n\n");
}

int valid_leave(object me, string dir)
{
        me->delete_temp("betting/silver");
        me->delete_temp("betting/type");
        return 1;
}
