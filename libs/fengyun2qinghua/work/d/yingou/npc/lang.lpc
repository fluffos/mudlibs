// tao_2.c

inherit NPC;

void create() {
  set_name("蓝胡子", ({ "lang" }));
  set("gender", "男性");
  set("title", "银钩赌坊大老板");
  set("age", 34);
  set("long",
    "蓝胡子是银钩赌坊的大老板．\n"
  );
  set("combat_exp", 300000);
  set("score", 20);

  set("int", 30);
  set("str", 30);

  set_skill("unarmed", 50);
  set_skill("dodge", 40);
  set_skill("move", 60);

  set_temp("apply/damage", 30);

  setup();

  carry_object(__DIR__ "obj/yincloth2")->wear();
}
