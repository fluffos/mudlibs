// tao_2.c

inherit NPC;

void create()
{
        set_name("方玉香", ({ "xiang" }) );
        set("gender", "女性");
        set("title", "银燕子");
        set("age", 18);
        set("long",
"这位美人是银鹞子方玉飞的妹妹\n");
        set("combat_exp", 200000);
        set("score", 20);

        set("int", 30);
        set("str", 30);
        set("per", 30);

        set_skill("unarmed", 50);
        set_skill("dodge", 40);
        set_skill("move", 60);

        set_temp("apply/damage", 30);

        setup();

        carry_object(__DIR__"obj/jincloth")->wear();
}

int accept_object(object who, object ob)
{
        object obj;
        if( ob->query("id") != "luocha" )return 0;
        write("方玉香快乐地说：好心总是有好报的...\n");
        who ->set("fang/luochapai", 1);
        obj = new("/d/laowu/obj/pai2");
        obj ->move(who);
        return 1;
} 
