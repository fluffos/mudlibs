// tao_2.c

inherit NPC;

void create()
{
        set_name("方玉飞", ({ "fang" }) );
        set("gender", "男性");
        set("title", "银鹞子");
        set("age", 24);
        set("long",
"银鹞子方玉飞是银钩赌坊大老板的小舅子，吃喝嫖赌样样精通\n"
);
        set("combat_exp", 300000);
        set("score", 20);

        set("int", 30);
        set("str", 30);

        set_skill("unarmed", 50);
        set_skill("dodge", 40);
        set_skill("move", 60);

        set_temp("apply/damage", 30);

        setup();

        carry_object(__DIR__"obj/yincloth2")->wear();
}

