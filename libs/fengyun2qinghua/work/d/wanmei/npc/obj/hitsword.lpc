// sword.c : an example weapon

#include <weapon.h>

inherit SWORD;

void create()
{
	set_name("青衣刺", ({ "sword" }) );
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("long", "这是一把细得可怕的剑，只适合刺客使用。\n");
		set("value", 400000);
		set("material", "steel");
		set("wield_msg", "$N悄无声息地抽出一把$n握在手中。\n");
		set("unwield_msg", "$N将手中的$n插入腰间。\n");
	}
	init_sword(5);
	setup();
}
