// crazy_dog.c

inherit NPC;

void create() {
  set_name("金丝雀", ({ "sparrow" }));
  set("race", "野兽");
  set("age", 2);
  set("long", "一只闪亮的金丝雀\n");
  set("attitude", "peaceful");

  set("limbs", ({ "头部", "身体", "前脚", "尾巴" }));
  set("verbs", ({ "bite", "claw", "poke" }));

  set("combat_exp", 500);

  setup();
}
