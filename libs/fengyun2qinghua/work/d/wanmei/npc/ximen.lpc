// taolord.c
inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("西门吹雪", ({ "master ximen", "master", "ximen" }) );
        set("title", "万梅庄主");
        set("gender", "男性");
        set("age", 32);
        set("long",
"西门吹雪乃是当代绝顶高手之一．剑法已经到达了＂无剑＂的境界．．\n");
        set("combat_exp", 1000000);
        set("score", 200000);

        set("class", "swordsman");

        set("int", 30);
        set("cor", 20);
        set("cps", 30);
        set("spi", 30);

        set("force", 3000);
        set("max_force", 3000);
        set("force_factor", 30);

        set("inquiry", ([
                "七彩丝缎带": 
"月圆之夜，紫禁之巅，没有七彩丝缎带的人是进不了紫禁城的。\n",
                "叶孤城": 
"当今高手，也只有叶孤城堪称我的对手。\n",
                "武学": "武学之道....嗯....只可意会，不可言喻。\n",
                "拜师": 
"哦....我向来有个规矩，凡是想拜我为师的，得接我三招不死，你想试试(accept test)？\n"
        ]) );

        set("chat_chance_combat", 90);
        set("chat_msg_combat", ({
                (: perform_action, "dodge.feitiantui" :),
                (: perform_action, "sword.huiranyijian" :),
                (: exert_function, "powerup" :),
        }) );

        create_family("万梅山庄", 1, "庄主");

        set_skill("dodge", 80);
        set_skill("force", 100);
        set_skill("sword", 150);
        set_skill("literate", 60);
        set_skill("doomsteps", 90);
        set_skill("doomsword", 120);
        set_skill("parry", 100);
        set_skill("doomstrike", 100);
        set_skill("doomforce", 100);
    	set_skill("unarmed", 100);
        set_skill("move", 150);
        set_skill("throwing", 50);

        map_skill("parry", "doomsword");
        map_skill("sword", "doomsword");
        map_skill("force", "doomforce");
        map_skill("unarmed", "doomstrike");
        map_skill("dodge", "doomsteps");
        map_skill("move", "doomsteps");

        setup();

	carry_object(__DIR__"obj/sword")->wield();
    carry_object(__DIR__"obj/cloth")->wear();
}

void init()
{
        ::init();
        add_action("do_accept", "accept");
        add_action("give_quest", "quest");
}

int do_accept(string arg)
{
        mapping guild;

        if( arg== "test" ) {
                say("\n西门吹雪点了点头，说道：很好，这是第一招....\n\n");
                COMBAT_D->do_attack(this_object(), this_player(), 
query_temp("weapon"));
                if( (int)this_player()->query("kee") < 0 
                || !present(this_player(), environment())) {
                        
say("西门吹雪叹了口气，说道：连第一招都撑不过，真是自不量力....\n");
                        return 1;
                }
                say("\n西门吹雪说道：这是第二招....\n\n");
                COMBAT_D->do_attack(this_object(), this_player(), 
query_temp("weapon"));
                if( (int)this_player()->query("kee") < 0 
                || !present(this_player(), environment())) {
                        
say("西门吹雪「哼」地一声，说道：便是有这许多不怕死的家伙....\n");
                        return 1;
                }
                say("\n西门吹雪说道：第三招来了....\n\n");
                COMBAT_D->do_attack(this_object(), this_player(), 
query_temp("weapon"));
                if( (int)this_player()->query("kee") < 0 
                || !present(this_player(), environment())) {
                        
say("西门吹雪叹道：可惜，难道我一身武功竟无传人....\n");
                        return 1;
                }
                
say("\n西门吹雪哈哈大笑，说道：今日我终於觅得一个可造之才！\n\n");
                command("recruit " + this_player()->query("id") );
                return 1;
        }
        return 0;
}

void re_rank(object student)
{
        int exp;
        exp = (int) student->query("combat_exp");
        if( exp <= 32000 ) {
                student->set("title","万梅山庄佣人");
                return ;
        } else if ( exp <= 64000 ) {
                student->set("title","万梅山庄家丁");
                return ;
        } else if ( exp <= 128000 ) {
                student->set("title","万梅山庄护院");
                return ;
        } else if ( exp <= 256000 ) {
                student->set("title","万梅山庄小管家");
                return ;
        } else if ( exp <= 512000 ) {
                student->set("title","万梅山庄管家");
                return ;
        } else if ( exp <= 1024000 ) {
                student->set("title","万梅山庄大管家");
                return ;
        } else if ( exp <= 1536000 ) {
                student->set("title","万梅山庄小总管");
                return ;
        } else if ( exp <= 2304000 ) {
                student->set("title","万梅山庄总管");
                return ;
        } else if ( exp <= 3456000 ) {
                student->set("title","万梅山庄大总管");
                return ;
        } else if ( exp <= 5187000 ) {
                student->set("title","万梅山庄少庄主");
                return ;
        } else if ( exp <= 26244000 ) {
                student->set("title","万梅山庄二庄主");
                return ;
        } else
                student->set("title","万梅山庄庄主");
                return ;
}

