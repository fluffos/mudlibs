// banker.c

inherit NPC;

void create()
{
        set_name("冷血刺客", ({ "hitman" }) );

        set("gender", "男性" );
        set("age", 40);
        set("leave_msg", "＂嗖＂的一声，消失了");
        set("arrive_msg", "＂嗖＂的一声，蹿了过来");
        set("str", 10);

        set("long",
"这是一个面目不清的刺客．．．\n");

        set("combat_exp", 1000000);
        set("attitude", "friendly");
        set("env/wimpy", 70);

        set("max_force", 1000);         
        set("force", 1000);             
        set("force_factor", 3);

        set("chat_chance", 15 );
        set("chat_msg", ({
                (: random_move :),
        }) );

        set_skill("sword", 100);
        set_skill("unarmed", 100);
        set_skill("parry", 100);
        set_skill("dodge", 100);
        set_skill("force", 100);
        
        setup();
        
        carry_object(__DIR__"obj/hitsword")->wield();
        carry_object(__DIR__"obj/hitcloth")->wear();

}

