// banker.c

inherit NPC;

void create()
{
        set_name("小西门", ({ "xiao ximen", "ximen" }) );

        set("gender", "男性" );
        set("age", 7);
        
        set("long",
"西门吹雪乃是当代绝顶高手之一．剑法已经到达了＂无剑＂的境界．．
当然，他儿子很小，还没有很高的武功。\n");

        set("attitude", "friendly");

        setup();
        
        carry_object(__DIR__"obj/doudou")->wear();

}

