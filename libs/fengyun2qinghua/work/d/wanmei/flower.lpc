// token.c

inherit ITEM;

void create()
{
        set_name( "路边的野花" , ({ "flower" }) );
        set_weight(10000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "朵");
                set("long", "一朵路边的野花。\n");
                set("material", "wood");
                set("value", 0);
        }
        setup();
}
