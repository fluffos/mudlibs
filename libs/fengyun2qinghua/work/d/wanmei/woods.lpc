// token.c


inherit ITEM;

void create()
{
	string *names = ({
        "干木柴", "半干的木柴", "湿木柴"
	});
        set_name(names[random(sizeof(names))], ({ "woods" }) );
        set_weight(10000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "条");
                set("long", "一条"+query("name")+"。\n");
                set("material", "wood");
                set("value", 50);
        }
        setup();
}
