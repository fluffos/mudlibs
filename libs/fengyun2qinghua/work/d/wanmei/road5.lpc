inherit ROOM;
void create()
{
        set("short", "山庄前院");
        set("long", @LONG
十丈方园的院子两侧种着几排翠绿的蔬菜。院角有一口小井。井
口有一木桶，桶上系着麻绳，显然是用来汲水的。院子另一边堆着的
几捆刚砍下来的木柴正在太阳下慢慢晒干。
LONG
        );
        set("exits", ([ /* sizeof() == 4 */
  "east" : __DIR__"road6",
  "west":  __DIR__"road4",
  "north": __DIR__"wanmei1",
  "south": __DIR__"wanmei2",
  "southeast": __DIR__"wanmei3",
  "northeast": __DIR__"wanmei4",
]));
        set("item_desc", ([
                "蔬菜": "好青好绿的蔬菜呀！你如果不怕人骂，拔（ｐｕｌｌ）一棵吧！\n",
                "小井": "小井很滑，但你可以试着爬（ｃｌｉｍｂ）下去。\n",
                "木柴": "快干了的木材，拿（ｐｉｃｋ）几根儿？\n"
        ]) );
        set("vege_amount", 10);
        set("woods_amount", 10);
        set("outdoors", "wanmei");
        setup();
}

void init()
{
    add_action("do_pull", "pull");
    add_action("do_climb", "climb");
    add_action("do_pick", "pick");
}

int do_pull(string arg)
{
    object ob;
    if(query("vege_amount") < 1)return notify_fail("还拔什么，都被人拔光了。\n");
    add("vege_amount", -1);
    ob = new(__DIR__"obj/vege");
    ob -> move(this_player());
    write("你拔了一棵放在怀里。\n");
    return 1;
}

int do_climb(string arg)
{
    return notify_fail("你太胖了！！！\n");
}


int do_pick(string arg)
{
    object ob;
    if(query("woods_amount") < 1)return notify_fail("还拿什么，都被人拿完了。\n");
    add("woods_amount", -1);
    ob = new(__DIR__"obj/woods");
    ob -> move(this_player());
    write("你拿了一根放在怀里。\n");
    return 1;
}

