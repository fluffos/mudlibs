inherit ROOM;
void create()
{
        set("short", "风铃梅枝门");
        set("long", @LONG
一扇用干枯的梅枝扎结的庄门虚掩着。门上扎着一个紫铜风铃。
门随风开合，风铃发出断断续续的叮咚之声。门上隶书一行：
                无剑为上
LONG
        );
        set("exits", ([ /* sizeof() == 4 */
  "east" : __DIR__"road5",
  "west":  __DIR__"road3",
]));
        set("outdoors", "wanmei");
        setup();
}

int valid_leave(object me, string dir)
{
        if(dir == "east" && !me->query_temp("marks/古松琴"))
        return notify_fail("一股强劲的罡气挡住了你。\n");
        else
        return 1;
}

