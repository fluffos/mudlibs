// teacher.c
#include <ansi.h>
inherit NPC;

void create()
{
	set_name("勾魂使者", ({ "ghost" }) );
	set("gender", "男性" );
	set("age", 22);
    set("long", "他的脸赫然已被人一刀削平了。\n");
    set("attitude", "heroism");
    set("class", "ghost");
    create_family("幽灵山庄", 2, "弟子");

    set("str", 10);
    set("combat_exp", 400000);
    set_skill("sword", 80);
    set_skill("three-sword", 80);
    set_skill("dodge", 80);
    set_skill("move", 80);
    set_skill("unarmed", 80);
    set_skill("parry", 80);
    set_skill("taiji", 80);
    set_skill("five-steps", 80);
    set_skill("force", 80);
    set_skill("taijiforce", 80);
    map_skill("sword", "three-sword");
    map_skill("parry", "three-sword");
    map_skill("unarmed", "taiji");
    map_skill("dodge", "five-steps");
    map_skill("move", "five-steps");
    map_skill("force", "taiji-force");    
    set("max_force", 2000);
    set("force", 2000);
	setup();
    carry_object(__DIR__"obj/wumuzan")->wield();
    carry_object(__DIR__"obj/baicloth")->wear();
}

void init()
{
    add_action("do_accept", "accept");
}

int do_accept(string arg)
{
    if( arg!= "test" )return notify_fail("你要接受什么？\n");
    write("勾魂使者说道：好！给你五分钟时间准备！\n");
    remove_call_out("test");
    call_out("test", 15, this_player());
    return 1;
}

void test(object me)
{
    int old_kee, new_kee;
    if(is_fighting())return;
    write("勾魂使者说道：准备了！接我这一招！\n\n");
    old_kee = me->query("kee");
    COMBAT_D->do_attack(this_object(), me, query_temp("weapon"));
    new_kee = me->query("kee");
    if(old_kee > new_kee || !present(this_player(), environment(this_object())))
    write("勾魂使者说道：连一招都接不下，真是自不量力！....\n");
    else {
    write("勾魂使者对你说道：好功夫！你可以过去了。\n");
    me->set_temp("ghost/勾魂", 1);
    }
    return;
}

