// bag.c

inherit ITEM;

void create() {
  set_name("皮囊", ({ "bag" }));
  set_weight(500);
  set_max_encumbrance(8000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "口");
    set("long", "这是一口普通的皮囊，可以用来装一些暗器。\n");
    set("value", 100);
  }
}

int is_container() { return 1; }
