#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "原始丛林");
        set("long", @LONG
丛林中一片黑暗，黑暗中充满了各式各样的危险，每一种都可以
至命。若是在丛林中迷失了方向，饥渴就足以至命。
LONG
        );
        set("exits", ([ 
  "north" : __DIR__"conglin13",
  "south" : __DIR__"conglin8",
  "west"  : __DIR__"conglin8",
  "east"  : __DIR__"conglin9",
]));
        set("outdoors", "youling");
        setup();
}

void init()
{
    remove_call_out("do_say");
    call_out("do_say", 2);
}

int do_say()
{
    object ob;
    if(ob=present("gu du mei", this_object()))
	message("sound", CYN + ob->name() + "说道：向北走。\n" NOR,
		environment(ob), ob);
    return 1;
} 



