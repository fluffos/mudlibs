// bag.c

inherit ITEM;

void create() {
  set_name("青石", ({ "rock" }));
  set_weight(500);
  set("no_get", 1);
  set("no_shown", 1);
  set_max_encumbrance(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("prep", "under");
    set("long", "一块大青石。\n");
    set("value", 1);
  }
}

int is_container() { return 1; }
