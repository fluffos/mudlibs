// inn.c

#include <room.h>

inherit ROOM;

string look_sign(object me);

void create()
{
	set("short", "红花会议事厅");
	set("long", @LONG
你现在正站在红花会议事大厅,红花会的大小事情都在这里讨论,往北是舵主的
卧房,南面是厨房.
LONG
	);

	// This enables players to save this room as their startroom.
	set("valid_startroom", 1);

	set("exits", ([
		"west"    	: "/d/red/red_road2",
		"north"		: "/d/red/red_sleeproom",
		"south"		: "/d/red/red_kitchen" ]) );

	setup();

	// To "load" the board, don't ever "clone" a bulletin board.
	call_other( "/obj/board/common_b", "???" );
}

