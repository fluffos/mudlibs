// inn.c

#include <room.h>

inherit ROOM;

string look_sign(object me);

void create() {
  set("short", "红花会大门");
  set("long", @LONG
你现在正站在红花会的大门的入口,两只巨大的石狮镇守在大门的两侧，
里面时不时传来教众的声音,通过大门往东可以看见来来往往的红花会
的教众和不少慕名而来的各路英雄豪杰。大门上还挂着一个大牌子(sign)。
LONG
  );

  // This enables players to save this room as their startroom.
  //	set("valid_startroom", 1);

  set("item_desc", ([
    "sign": (: look_sign :),
  ]));

  set("exits", ([
    "east": "/d/red/red_register",
    "west": "/d/snow/mstreet4" ]));

  set("objects", ([
    "/d/red/npc/guard": 2 ]));
  //              "/d/npc/sungoku" : 1,
  //                "/d/snow/npc/waiter" : 1 ]) );

  setup();

  // To "load" the board, don't ever "clone" a bulletin board.
  "obj/board/red_b"->foo();
}

string look_sign(object me) {
  if (wizardp(me))
    return "招牌写著：红花会。旁边一排小字：snow 写的啦。\n";
  else
    return "招牌写著：红花会。\n";
}
