// inn.c

#include <ansi.h>
#include <room.h>

inherit ROOM;

void create() {
  set("short", "云烟山庄");
  set("long", @LONG
这是临时的云烟山庄.
LONG
  );

  set("exits", ([
    "east": "/d/snow/inn",
  ]));

  setup();

}


void init() {
  object ob;
  string exp;
  if (interactive(ob = this_player())) {
    if ((string)ob->query("gender") != "女性") {
      ob->move("/d/snow/inn");
      message_vision(HIW "\n$N被snow当了回来。\n\n" NOR, ob);
    }
  }
}
