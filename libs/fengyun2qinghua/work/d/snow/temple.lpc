#include <obj.h>

inherit ROOM;

void create()
{
	set("short", "城隍庙");
	set("long", @LONG
这是一间十分老旧的城隍庙，在你面前的神桌上供奉著一尊红脸的城
隍，庙虽老旧，但是神案四周已被香火薰成乌黑的颜色，显示这里必定相
当受到信徒的敬仰。
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
		"south" : "/d/snow/eroad1",
		"west" : "/d/snow/square",
	]));
        set("no_fight", 1);
        set("no_magic", 1);
	set("objects", ([ /* sizeof() == 2 */
		OBJ_PAPER_SEAL : 10,
		__DIR__"npc/keeper" : 1,
	]));

	setup();
	replace_program(ROOM);
}

void init()
{       object *ob, inok;
        inok = this_player();
        if( interactive( inok ) ) {
                ob = all_inventory(environment(inok));
                if(sizeof(ob) > 8) {
                        inok->move("/d/snow/square");
                        message_vision("\n小小的庙里面已经挤不下了。\n\n", inok) ;
                }
        }
}

