// token.c


inherit ITEM;

void create()
{
        set_name("火炮丸", ({ "bomb" }) );
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "颗");
                set("long", "一颗军用的火炮丸。\n");
                set("material", "wood");
                set("value", 1000);
                set("bomb", 1);
        }
        setup();
}
