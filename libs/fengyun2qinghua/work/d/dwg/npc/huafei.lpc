// mother.c
inherit NPC;

void create()
{
	set_name("花飞", ({ "huafei" }) );
	set("gender", "男性" );
	set("age", 23);
    set("per", 26);
	set("long", @LONG
此人满身锦衣，身亮欣长，苍白而清俊的面容上，带著一份孤傲冷削
之色，仿佛未将任何人看在眼里。
LONG    );
        set("class", "yinshi");
        create_family("帝王谷", 2, "弟子");
        set("chat_chance", 40);
        set("chat_msg", ({
(: random_move :)
 }));
	set("combat_exp", 300000);
    set_skill("unarmed", 70);
    set_skill("dodge", 70);
    set_skill("move", 70);
    set_skill("flying-dragon", 70);
    set_skill("zuixian-steps", 70);
    map_skill("dodge", "zuixian-steps");
    map_skill("move", "zuixian-steps");
    map_skill("unarmed", "flying-dragon");

	set("attitude", "heroism");

	setup();
	
    carry_object(__DIR__"obj/zhanpao2")->wear();
}

