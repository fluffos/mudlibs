// dart.c
#include <ansi.h>
#include <weapon.h>

inherit THROWING;

void create()
{
	set_name(HIC"毒龙沙"NOR, ({ "sand" }) );
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long",	"有强大杀伤力的巨毒无比的毒龙沙\n");
		set("unit", "些");
		set("base_unit", "颗");
		set("base_weight", 10);
		set("value", 200);
	}
	set_amount(3);
	init_throwing(10);
	setup();
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
        int poison;
        poison = me->query_skill("poison") + 20 + random(20);
        victim->apply_condition("wuying_poison", poison);
        return;
}
