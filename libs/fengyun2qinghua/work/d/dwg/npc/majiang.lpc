// mother.c
inherit NPC;

void create() {
  string *names = ({
    "东风", "西风", "南风", "北风", "红中" });
  set_name(names[random(sizeof(names))], ({ "playing girl", "girl" }));
  set("gender", "女性");
  set("age", 13);
  set("str", 40);
  set("long", @LONG
这是一位帝王谷的小丫头，专陪客人下棋．
LONG
  );
  set("class", "yinshi");
  set("combat_exp", 20000);
  set_skill("unarmed", 20);
  set_skill("dodge", 20);
  set_skill("move", 20);
  set("attitude", "peaceful");

  setup();

  carry_object("/obj/cloth")->wear();
  carry_object(__DIR__ "obj/majiang");
}
