// girl.c

inherit NPC;

void create() {
  set_name("神水宫女", ({ "girl" }));
  set("gender", "女性");
  set("age", 15);
  set("long",
    "这是神水宫的小宫女。\n");
  set("combat_exp", 5000);
  set("attitude", "friendly");
  setup();
  carry_object("/obj/cloth")->wear();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(3)) {
    case 0:
      say("宫女喝道：好个" + RANK_D->query_respect(ob)
        + "，居然敢擅闯神水宫。\n");
      break;
    case 1:
      say("宫女说：男人都不是好东西，这位" + RANK_D->query_respect(ob)
        + "，纳命来。\n");
      break;
    case 2:
      say("宫女呵斥道：" + RANK_D->query_respect(ob)
        + "，神水宫岂是你们这些臭男人随便进的。\n");
      break;
  }
}
