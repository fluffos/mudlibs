// girl.c
#include <ansi.h>
inherit NPC;

void create() {
  int i;
  string *names = ({
    "红拂", "黄筱", "青霞", "紫烟", "蓝月", "橙绫", "绿萍"
  });
  i = random(sizeof(names));
  set_name(names[i], ({ "color girl", "girl" }));
  set("gender", "女性");
  set("str", 40 + random(40));
  set("title", HIR "七" CYN "彩" BLU "宫" HIG "女" NOR);
  set("age", 17);
  set("long",
    "这是神水宫的七彩宫女。\n");
  set("combat_exp", 200000 + random(100) * 2000);
  set_skill("unarmed", 100 + random(100));
  set_skill("parry", 100 + random(100));
  set_skill("dodge", 100 + random(100));
  set_skill("nine-moon-claw", 50 + random(50));
  set_skill("nine-moon-steps", 50 + random(50));
  map_skill("unarmed", "nine-moon-claw");
  map_skill("dodge", "nine-moon-steps");
  set("attitude", "friendly");
  setup();
  carry_object(__DIR__ "obj/shayi" + sprintf("%d", i + 1))->wear();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(3)) {
    case 0:
      say("宫女说道：这位" + RANK_D->query_respect(ob)
        + "，里面请。\n");
      break;
  }
}
