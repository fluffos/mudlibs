// mother.c
inherit NPC;

void create()
{
	set_name("驼背老人", ({ "laoren" }) );
	set("gender", "男性" );
	set("age", 69);
    set("str", 40);
	set("long", @LONG
这是一位久经风霜的驼背老人。
LONG
);
    set("class", "yinshi");
	set("combat_exp", 10000);
    set_skill("unarmed", 30);
    set_skill("dodge", 30);
    set_skill("move", 30);
    set("bellicosity", 2000);
	set("attitude", "aggressive");

	setup();
	
    carry_object("/obj/cloth")->wear();
}

