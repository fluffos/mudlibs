// mother.c
inherit NPC;

void create()
{
	set_name("怪兽", ({ "heaven lion", "lion" }) );
	set("race", "野兽");
	set("age", 900);
	set("long", @LONG
这怪兽通体俱是赤红颜色，生得似狮非狮，似马非马。
LONG
);
    set("class", "yinshi");
	set("combat_exp", 500000);
    set("bellicosity", 2000);
	set("attitude", "aggressive");
    set_temp("apply/damage", 200);
	set("limbs", ({ "头部", "身体", "尾巴", "前脚", "后脚" }) );
	set("verbs", ({ "bite", "claw", "dunt" }) );
	setup();
}

