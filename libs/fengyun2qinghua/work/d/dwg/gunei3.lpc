#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "火窟");
        set("long", @LONG
才入洞口(hole)，就觉的一阵热气(air)扑面而来。入洞越深，
四周空气越热，渐渐热如火窟。你不禁汗如雨下，转目四望，只见四
面山壁(rock)，竞以变作了暗赤之色，仿佛随时会有火炎涌出。
LONG        );
        set("exits", ([ 
  "north" : __DIR__"gunei2",
]));
        setup();
}

void init()
{
        object ob;
        if( interactive( ob = this_player()))
        remove_call_out("do_fire");
        call_out("do_fire", 15, ob);
}

int do_fire(object ob)
{
        int i;
        int damage;
        if( environment(ob) == this_object())
        {
        message_vision(HIR"一股炽热的熔炎形成一个大火球向$N激射而出！！\n"NOR, ob);
        message_vision(HIR"$N被炽热的熔炎喷得焦偷烂额，奄奄一息！\n"NOR, ob);
        i = (int)ob->query("eff_kee");
        damage = random(10)+35  ;
        ob->set("eff_kee",(int) i - damage );
        i =  (int)ob->query("kee");
        ob->set("kee",(int) i - damage);
        if( environment(ob) == this_object())
        call_out("do_fire",5, ob);     
        }
        else
        return 1;
}    

