
inherit ROOM;

void create()
{
        set("short", "花园");
        set("long", @LONG
这是一座极大的花园，四面群山围绕，园中万花竞艳。牡丹芍药
，黄菊红玫，四季香花，在这地竞同时开放，抬眼望去，宛如置身一
片香涛花海之中。白石小径，青竹篱笆间，零乱地站了十余个红衣少
女，正在剪草灌花。
LONG
        );
        set("exits", ([ 
  "east" : __DIR__"nei5",
  "west": __DIR__"nei3",
  "north": __DIR__"huayuan1",
  "south": __DIR__"huayuan2",
]));
        set("objects", ([
        __DIR__"npc/dagu" : 1,
]));
        set("outdoors", "dwg");
        setup();
        replace_program(ROOM);
}

