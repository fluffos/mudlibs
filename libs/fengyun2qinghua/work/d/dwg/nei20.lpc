
inherit ROOM;

void create()
{
        set("short", "山阁");
        set("long", @LONG
小阁顶有八角，外观如亭，只是四面门窗紧闭。雕花窗棂间，蒙
有淡黄色的绡纱，八角飞檐下，挂有黄金的响铃，随风而动，与飞瀑
流泉争鸣。蔓草、青松、飞瀑、藤萝间，建筑这座精致玲珑，黄金为
顶，白玉为阶的小小楼阁，望之当真有如天上。
LONG
        );
        set("exits", ([ 
  "south" : __DIR__"nei21",
  "east": __DIR__"nei19",
]));
        set("outdoors", "dwg");
        setup();
        replace_program(ROOM);
}

