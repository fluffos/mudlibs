
inherit ROOM;

void create()
{
        set("short", "大厅");
        set("long", @LONG
一条猩红的地毯，自门口笔直地铺向远处，其长竟不止十丈。尽
头处又是十数级石阶，阶上又是一重门户。原来小阁楼里连接山腹，
外观虽小，里面却是宽容博大，两壁间灯光辉煌。
LONG
        );
        set("exits", ([ 
  "south" : __DIR__"nei22",
  "north": __DIR__"nei20",
]));
        set("outdoors", "dwg");
        setup();
}

void init()
{
        remove_call_out("check");
        call_out("check", 10);
}

void check()
{
    object *inv;
    int i;
    inv = all_inventory(this_object());
    if(sizeof(inv) < 1)return;
    for(i=0; i<sizeof(inv); i++)    {
    if(userp(inv[i]))   {
    if(!inv[i]->query_temp("marks/xiao"))inv[i]->set_temp("marks/xiao", 1);
    else inv[i]->add_temp("marks/xiao", 1);  }
    }
    remove_call_out("check");
    call_out("check", 10);
    return;
}

int valid_leave(object me, string dir)
{
    if(dir=="south" && (int)me->query_temp("marks/xiao") > 30)
    me->set_temp("marks/xiaowangsun", 1);
    me->delete_temp("marks/xiao");
    return 1;  
}
