
inherit ROOM;

void create()
{
        set("short", "溪边");
        set("long", @LONG
湍急的小溪到了这里，由于溪流的加宽而渐渐平稳安静了下来。
溪边有一丛一人多高的芦苇，还有几株垂柳。柳树把它们的柳丝垂到
了溪面上，微风佛过，在平静的溪面上画著圈圈点点，逗的水中的鱼
儿不停地跃出水面。几只羽毛艳丽的野鸭在水面上荡来荡去，不时地
把头探入水中寻找它们的食物，还有几只在岸边休息。
LONG
        );
        set("exits", ([ 
  "north" : __DIR__"dwg7",
  "west": __DIR__"dwg8",
  "east": __DIR__"dwg10",
]));
        set("amount/luwei", 1);
        set("objects", ([
        __DIR__"npc/duck" : 2,
                        ]) );
        set("outdoors", "dwg");

        setup();
}

void init()
{
    add_action("do_pick", "pick");
}

int do_pick(string arg)
{
    object ob;
    if(query("amount/luwei") == 0)return notify_fail("芦苇已经被你摘没了。\n");
    if(arg != "luwei" && arg != "芦苇")return 0;
    ob = new(__DIR__"obj/luwei");
    ob -> move(this_player());
    write("你摘了一根芦苇放在怀里。\n");
    add("amount/luwei", -1);
    return 1;
}
