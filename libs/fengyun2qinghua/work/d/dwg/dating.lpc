
inherit ROOM;

void create()
{
        set("short", "神水宫大厅");
        set("long", @LONG
神水宫起始于六百年前。到今天弟子已遍布天下。神水宫现任掌
门人已修炼到反老还童的境界。
LONG
        );
        set("exits", ([ /* sizeof() == 2 */
  "south" : __DIR__"shuimu4",
]));
       set("valid_startroom", 1);
       set("objects", ([
                __DIR__"npc/master" : 1,
                __DIR__"npc/hufa" : 2 
]) );
        setup();

}

void init()
{
	object me,obj;

	obj=present("master",this_object());
	if (objectp(obj))
	{
		obj->prevent_in(this_player());
	}
}

