
inherit ROOM;

void create()
{
        set("short", "坑底");
        set("long", @LONG
这是一个深坑的底部。在这里风声凄历，迷雾更浓。抬头仰望，
不见天日。四下鬼影重重，也不知是真是假。转目四望，但见坑中满
是被石蛇缠住的石人。哪有活人的人影。乎听身旁隐约有人喘息的声
音，你不禁毛骨悚然。
LONG
        );
        set("exits", ([ 
  "up" : __DIR__"gunei7",
]));
    set("objects", ([
        __DIR__"obj/eren" : 1,
                        ]) );
        setup();
}

void init()
{
    add_action("do_touch", "touch");
}

int do_touch(string arg)
{
        object me;
        if( !arg || arg=="" ) return 0;
        if( arg=="eren" || arg =="恶人像" ) {
                write("你俯身走了两步，伸手扳了扳地上的石像．\n");
                if( !query("exits/east") ) {
                set("exits/east", __DIR__"nei1");
                call_out("close_path", 2);
                write("＂呀＂地一声，深坑边的石壁上，竟裂开了一重门户。\n");
                return 1;
        }   }
        else return 0;
}

void close_path()
{
        if( !query("exits/east") ) return;
        message("vision",
"只听吱呀一声，石壁上的门户又关闭了。\n",
                this_object() );
                delete("exits/east");
}



