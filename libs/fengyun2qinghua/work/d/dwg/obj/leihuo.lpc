// token.c


inherit ITEM;

void create()
{
        set_name("雷火珠", ({ "pearl" }) );
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "颗");
                set("long", "一颗黑色的雷火珠。\n");
                set("material", "wood");
                set("value", 1000);
                set("bomb", 1);
        }
        setup();
}
