// bag.c

inherit ITEM;

void create()
{
	set_name("水草", ({ "shuicao" }) );
	set_weight(500);
    set("no_shown", 1);
    set("no_get", 1);
	set_max_encumbrance(30000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "些");
		set("long", "一大团带著烂泥的水草\n");
		set("value", 1);
	}
}

int is_container() { return 1; }
