inherit ITEM;
void create()
{
	set_name("刘仲甫的呕血谱", ({ "呕血谱", "棋谱" }));
	set_weight(600);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "局");
		set("long",
			"这是刘仲甫在骊山与仙姥所对奕的一局棋。\n");
		set("value", 0);
		set("material", "paper");
		set("no_shown",1);
		set("no_get",1);
		set("no_drop",1);
		set("skill", ([
			"name": 		"yiqiforce",	
			"exp_required":	200000,		
			"sen_cost":		50,	
			"difficulty":	50,	
			"max_skill":	15
		]) );
	}
}
