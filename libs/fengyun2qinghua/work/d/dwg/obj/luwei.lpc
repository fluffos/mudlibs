// token.c


inherit ITEM;

void create()
{
        set_name("芦苇", ({ "luwei" }) );
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "根");
                set("material", "wood");
                set("value", 0);
        }
        setup();
}
