// token.c


inherit ITEM;

void create()
{
        set_name("被石蛇缠住的恶人像", ({ "eren" }) );
        set("no_get", 1);
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "根");
            set("long", @LONG
这是一具被石蛇缠住的恶人像，手里似乎拿着什么东西，斜斜地指向
东面的一处山窟。
LONG);
                set("material", "wood");
                set("value", 0);
        }
        setup();
}
