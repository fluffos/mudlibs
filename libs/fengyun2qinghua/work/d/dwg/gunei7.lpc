
inherit ROOM;

void create()
{
        set("short", "坑道边");
        set("long", @LONG
道路到了这里又有了分岔，两条黄土路左右分开，当中却有一个
深坑。迷雾中望去，坑中人兽杂乱，也不知有多深。一个虬须判官的
石像，仰天立在坑边。风声过处，坑底仿佛飘上了一阵鬼啸之声。
LONG
        );
        set("exits", ([ 
  "west" : __DIR__"gunei6",
  "north" : __DIR__"gunei8",
  "south" : __DIR__"gunei9",
]));
        setup();
}

void init()
{
    add_action("do_down", "down");
}

int do_down(string arg)
{
    object me;
    me = this_player();
    message_vision("$N纵身跳入坑中．\n", me);
    me->move(__DIR__"gunei10");
    return 1;
}