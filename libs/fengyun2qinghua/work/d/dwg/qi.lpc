#include <ansi.h>
inherit ROOM;

void create()
{
        object con, item;
        set("short", "棋室");
        set("long", @LONG
这里是一间安静的棋室，室中站着一个侍女正在洒扫庭除，但是
室中并无棋具，只有墙上挂着一张刘仲甫的呕血谱，看起来高深莫测
，棋艺不够的话可不要妄自参修。
LONG
        );
        set("exits", ([ 
  "west"  : __DIR__"shuimu3",
]));
        set("objects",  ([
        __DIR__"npc/gongnu2" : 1,
        __DIR__"obj/qipu" : 1,
])  );
        setup();
}

void init()
{
    add_action("do_study", "study");
}

int do_study(string arg)
{
    object me;
    string qipu;
    int sen;
    if(sscanf(arg, "%s %d", qipu, sen) <= 0)return 0;
    if(qipu != "棋谱" && qipu != "呕血谱")return 0;
    me = this_player();
    message_vision("$N盯着墙上的棋谱，用尽心智进行参修。\n", me);
    if(!random((int)(me->query("combat_exp") / 200000)))   {
    write(
CYN"你觉得两眼一花，棋谱上的棋子开始活动起来，你好似来到了一个陌
生的世界，突然间你觉得心力交瘁。\n"NOR);
    me->unconcious();   }
    return 0;
}
