#include <ansi.h>
inherit ROOM;

void create()
{
        object con, item;
        set("short", "草坪");
        set("long", @LONG
这里是一片碧绿的草坪，一些巨大的松树环绕在草坪四周。草坪
上散缀著一些不知名的野花，有红的，黄的，兰的，白的。这些野花
（ｆｌｏｗｅｒ）把碧绿的草坪点缀的充满了生机。几头小鹿悠闲地
走来走去。透过树干的空隙，你隐约看见粼粼的水波。
LONG
        );
        set("exits", ([ 
  "west" : __DIR__"dwg6",
  "south" : __DIR__"dwg9",
]));
        set("objects", ([
        __DIR__"obj/flower" : 1,
        __DIR__"obj/wanghua" : 1,
        __DIR__"obj/guo" : 1,
                        ]) );
        set("outdoors", "dwg");
        setup();
        con = present("wanghua", this_object());
        item = present("wangguo", this_object());
        item->move(con);
        item = present("flower", this_object());
        con->move(item);
}

int valid_leave(object me, string dir)
{
        message_vision(HIG "一阵淡淡的花香飘过，你不由地深吸了一口气。\n" NOR, me);
        me->apply_condition("bixue_poison",5+random(5));
        return 1;
}


