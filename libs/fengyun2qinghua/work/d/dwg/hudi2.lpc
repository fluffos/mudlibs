#include <ansi.h>
inherit ROOM;

void create()
{
        object con, item;
        set("short", "湖底");
        set("long", @LONG
这里实在很美，很静。泉水清澈冰凉，各式各样的鱼虾在你的面
前悠闲的游来游去，看著水草在砂石间娥娜起舞，这种感觉不是未曾
经历此境的人所能领略得到的。
LONG
        );
        set("exits", ([ 
  "east" : __DIR__"hudi",
  "north" : __DIR__"hudi4",
  "south" : __DIR__"fenduo",
  "up" : __DIR__"dwg10",
]));
        set("outdoors", "dwg");
        setup();
        replace_program(ROOM);
}

