
inherit ROOM;

void create()
{
        object con, item;
        set("short", "湖底");
        set("long", @LONG
这里是一个静悄悄的世界，你几乎忘记了外面世界的喧哗。色彩
鲜艳，形状个异的鱼虾，擦著你的面颊悠闲地游来游去。水草在你的
身旁漂浮著。一大团带著烂泥的水草就在你的脚边。
LONG
        );
        set("exits", ([ 
  "east" : __DIR__"hudi2",
  "north" : __DIR__"hudi3",
  "south" : __DIR__"hudi",
]));
        set("no_cleanup",1);
        set("objects", ([
        __DIR__"obj/xiangzi" : 1,
        __DIR__"obj/shouhuan" : 1,
        __DIR__"obj/shuicao" : 1,
        __DIR__"obj/tianxiang" : 1
])  );
        set("item_desc", ([
                "水草": "一大团带著烂泥的水草\n"
        ]) );
        set("outdoors", "dwg");
        setup();
        con = present("woodcase",this_object());
        item = present("shouhuan",this_object());
        item->move(con);
        item = present("potion",this_object());
        item->move(con);
        con = present("shuicao",this_object());
        item = present("woodcase",this_object());
        item->move(con);
}

