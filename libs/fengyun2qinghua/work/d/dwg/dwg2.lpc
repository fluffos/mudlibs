inherit ROOM;

void create() {
  set("short", "岔路口");
  set("long", @LONG
路到这里再向前就分成两条。左面一条，满布著白色的晶石，甚
是平坦阅目，路旁种植两行花草，修剪整齐，香气袭人。往右的一条
黑石道路，却曲折地通向一坐阴森黝暗的丛林，道路崎岖坎坷，林中
随风吹出阵阵阴湿的臭气。
LONG
  );
  set("exits", ([
    "west": __DIR__ "bridge",
    "south": __DIR__ "dwg3",
    "north": __DIR__ "dwg4",
  ]));
  set("outdoors", "dwg");

  setup();
  replace_program(ROOM);
}
