inherit ROOM;
void create()
{
        set("short", "古树顶");
        set("long", @LONG
放眼望去，树海茫茫，了无边际。浓密的树枝象一块厚实的地毯
铺盖着整个大地。这棵树上粗壮的树枝极力向四周伸展，其中有一根
略为光滑，似乎是被人攀把过的痕迹。
LONG
        );
        set("exits", ([ /* sizeof() == 4 */
        "down": __DIR__"lin3c",
]));
        set("current_direction", "north");
        set("outdoors", "manglin");
        setup();
}

void init()
{
    add_action("do_swing", "swing");
    add_action("do_turn", "turn");
}

int do_turn(string arg)
{
    if(arg != "vine")
    return 0;
    else 
    {
    switch(query("current_direction")){
    case "north" : set("current_direction", "east");
    message_vision("$N用力扳动树枝，使它对着正东方。\n", this_player());
    break;
    case "east" : set("current_direction", "south");
    message_vision("$N用力扳动树枝，使它对着正南方。\n", this_player());
    break;
    case "south" : set("current_direction", "west");
    message_vision("$N用力扳动树枝，使它对着正西方。\n", this_player());
    break;
    case "west" : set("current_direction", "north");
    message_vision("$N用力扳动树枝，使它对着正北方。\n", this_player());
    break;
    }
}
    return 1;
}

int do_swing(string arg)
{
    if(arg != "vine")
    return 0;
    else
    {
    switch(query("current_direction")){
    case "north" : 
    message_vision("$N抓紧树枝，用力向北方荡去！      
听着耳边的呼呼风声，$N不禁惊叫道：
啊啊啊．．．哦哦哦哦哦哦．．．啊啊！！！\n", this_player());
    this_player()->move(__DIR__"tree2");
    break;
    case "east" : 
    message_vision("$N抓紧树枝，用力向东方荡去！      
听着耳边的呼呼风声，$N不禁惊叫道：
啊啊啊．．．哦哦哦哦哦哦．．．啊啊！！！\n", this_player());
    tell_room(__DIR__"lin3c", "远方传来一声长叫：＂啊啊啊．．．哦哦哦哦哦哦．．．啊啊啊！！＂\n");    
    this_player()->move(__DIR__"edge3");
    break;
    case "south" : 
    message_vision("$N抓紧树枝，用力向南方荡去！      
听着耳边的呼呼风声，$N不禁惊叫道：
啊啊啊．．．哦哦哦哦哦哦．．．啊啊！！！\n", this_player());
    this_player()->move(__DIR__"tree4");
    break;
    case "west" : 
    message_vision("$N抓紧树枝，用力向西方荡去！      
听着耳边的呼呼风声，$N不禁惊叫道：
啊啊啊．．．哦哦哦哦哦哦．．．啊啊！！！\n", this_player());
    this_player()->move(__DIR__"tree1");
    break;
    }
}
    return 1;
}
