// crazy_dog.c

inherit NPC;

void create() {
  set_name("紫斑巨蟒", ({ "snake" }));
  set("race", "野兽");
  set("long", "一条水桶粗细的巨蟒。\n");
  set("attitude", "aggressive");

  set("limbs", ({ "头部", "身体", "尾巴" }));
  set("verbs", ({ "bite" }));

  set("combat_exp", 2700000);
  set("bellicosity", 2000);

  set_temp("apply/damage", 140);

  setup();
}
