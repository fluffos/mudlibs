
inherit NPC;
inherit F_MASTER;
#include <ansi.h>
void create()
{
	set_name("裴冥通天", ({ "master peiming", "master", "peiming"}) );
	set("gender", "男性" );
	set("age", 45);
	set("int", 30);
	set("str", 60);
	set("per", 30);
    set("apprentice_available", 1);
    create_family("通天门", 1, "门主");
        set("nickname", HIB"五毒童子"NOR);
        set("class", "diabloist");
	set("long", 
"裴冥通天学艺于自然，以最毒之物为师，一身毒气杀人于无形．更精
于通天降．．\n" );
        set("force_factor", 200);
        set("max_gin", 3000);
        set("max_kee", 3000);
        set("max_sen", 3000);
        set("eff_gin", 3000);
        set("eff_kee", 3000);
        set("eff_sen", 3000);
        set("gin", 3000);
        set("kee", 3000);
        set("sen", 3000);
        set("max_atman", 300);
        set("atman", 300);
        set("max_force", 3000);
        set("force", 3000);
        set("max_mana", 300);
        set("mana", 300);
        set("chat_chance", 1);
        set("combat_exp", 9999999);
        set("score", 90000);
        set_skill("celecurse", 70);
        set_skill("cursism", 100);
        set_skill("dodge", 80);
        set_skill("force", 80);
        set_skill("parry", 80);
        set_skill("literate", 60);
        set_skill("move", 70);

        map_skill("cursism", "celecurse");

        setup();
        carry_object(__DIR__"cloth")->wear();
}

void reset()
{
        set("apprentice_available", 1);
}

void attempt_apprentice(object ob)
{
        if( query("apprentice_available") ) {
                if( find_call_out("do_recruit") != -1 )
                        command("say 慢著，一个一个来。");
                else
                        call_out("do_recruit", 2, ob);
        } else {
                command("say 本门主今天已经收了一个弟子，不想再收徒了。");
        }
}

void do_recruit(object ob)
{
                command("say 你日后必有大成！");
                command("smile");
                command("recruit " + ob->query("id") );
}

int recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "diabloist");
        add("apprentice_availavble", -1);
}

void init()
{
        add_action("give_quest", "quest");
}

void re_rank(object student)
{
        int exp;
        exp = (int) student->query("combat_exp");
        if( exp <= 32000 ) {
                student->set("title","通天门众");
                return ;
        } else if ( exp <= 128000 ) {
                student->set("title","通天门邪众");
                return ;
        } else if ( exp <= 512000 ) {
                student->set("title","通天门巡使");
                return ;
        } else if ( exp <= 1536000 ) {
                student->set("title","通天门护法");
                return ;
        } else if ( exp <= 3456000 ) {
                student->set("title","通天门总护法");
                return ;
        } else if ( exp <= 5187000 ) {
                student->set("title","通天门长老");
                return ;
        } else if ( exp <= 26244000 ) {
                student->set("title","通天门大长老");
                return ;
        } else
                student->set("title","通天门副门主");
                return ;

}

