// tufei1.c

inherit NPC;

void create()
{
	set_name("风骚雅人", ({ "yaren" }) );
	set("gender", "男性");
	set("age", 35);
	set("long",
		"一位吟诗作对的风骚雅人，正在诗台上写些什么。\n");
	set("combat_exp", 20000 + random (100) * 400 );

    set("attitude", "friendly");

	set("apply/attack", 20 + random(40));
	set("apply/defense", 20 + random(40));

	set_skill("unarmed", 40);
	set_skill("sword", 40);
	set_skill("parry", 40);
	set_skill("dodge", 40);
    set_skill("move", 40);
    
    set("max_force", 1000);
    set("force", 1000);

    set("force_factor", 3);
	setup();

        carry_object(__DIR__"obj/fycloth")->wear();

}