
inherit NPC;

void create()
{
        set_name("风云衙役", ({ "yayi" }) );
        set("long",
"正在上堂的衙役，千万不要惹他们\n");
        set("attitude", "heroism");
        set("vendetta_mark", "authority");
        set("str", 47);
        set("cor", 26);
        set("cps", 25);
        set("combat_exp", 200000+random(100) * 2000);
        set("chat_chance_combat", 15);
        set("chat_msg_combat", ({
                "风云衙役喝道：还不快放下武器束手就缚？\n",
                "风云衙役喝道：大胆刁民竟敢拒捕？反了！反了！\n"
        }) );
        set_skill("unarmed", 50+random(50));
        set_skill("dagger", 50+random(50));
        set_skill("parry", 50+random(50));
        set_skill("dodge", 50+random(50));
        set_skill("move", 50+random(50));

        set_temp("apply/attack", 50);
        set_temp("apply/defense", 50);
        set_temp("apply/armor", 50);
        set_temp("apply/damage", 30+random(70));
        set_temp("apply/move", 50);
        set("max_force", 1000);
        set("force", 1000);

        setup();

        carry_object(__DIR__"obj/fycf")->wear();
        carry_object(__DIR__"obj/swb")->wield();
}

void init()
{
        object ob;
        ::init();

	if( interactive(ob = this_player()) && !is_fighting() ) {
        if(ob->query("class") == "official" && 
ob->query("combat_exp") > 128000 && random(4) )
        set_leader(ob);
	}
}

