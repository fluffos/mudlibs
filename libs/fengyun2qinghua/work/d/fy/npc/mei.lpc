inherit NPC;
#include <command.h>
#include <ansi.h>
void create()
{
        set_name("寒梅先生", ({ "mei"}) );
        set("title", HIW"岁寒三友"NOR);
        set("gender", "男性" );
        set("age", 63);
	    set("str", 8);
        set("agi",25);
        set("int",30);
	set("attitude","heroism");
        set("max_force", 15000);
        set("force", 15000);
        set("max_atman",80);
        set("atman",80);
        set("long",
"寒梅先生是西方神教中鼎鼎有名的长老，与孤松，青竹鼎足而三，武
功不在羽天白之下，他们经常在都市中闲游。\n"
	);
        create_family("西方神教", 3, "长老");
        set("chat_chance_combat", 90);
        set("chat_msg_combat", ({
                (: perform_action, "unarmed.dimo" :),
                (: perform_action, "dodge.lianhuanbabu" :),
                (: perform_action, "unarmed.dimo" :),
                (: exert_function, "mihun" :)
        }) );
        set("combat_exp", 1000000);
        set("score", 200000);

        set_skill("move", 80);
        set_skill("parry",80);
        set_skill("dodge", 80);
        set_skill("force", 80);
        set_skill("literate", 80);
	set_skill("unarmed",80);
    set_skill("throwing", 80);
	set_skill("demon-steps",80);
	set_skill("demon-strike",80);
	set_skill("demon-force",80);
	set_skill("perception",80);
        map_skill("dodge", "demon-steps");
	map_skill("force", "demon-force");
	map_skill("unarmed", "demon-strike");
        set_temp("apply/move", 80);
        set("chat_chance", 40);
        set("chat_msg", ({
        (: random_move :),
        (: call_other, __FILE__, "get_all", this_object() :)
})  );
        setup();
        carry_object(__DIR__"obj/meicloth")->wear();
        carry_object(__DIR__"obj/stone")->wield();

}

void init()
{
	object	ob;

	::init();
    ob = this_player();
    if(ob->query("fang/luochapai")){
	message_vision("$N对$n大声喝道：竟敢偷盗我教的镇教之宝，我要杀了你。\n", this_object(), ob);
	this_object()->kill_ob(ob);
	this_object()->set_leader(ob);
    }
}

int get_all(object ob)
{
        object *inv;
        int i;
        inv = all_inventory(environment(ob));
        if(sizeof(inv) <= 0)return 0;
        else 
        for(i = 0; i<sizeof(inv); i++)
        GET_CMD->do_get(ob, inv[i]);
        return 1;       
}

int accept_object(object who, object ob)
{
        if( ob->query("id") != "luocha" )return 0;
        write("寒梅道：还好，算你知道厉害，不然...\n");
        who->delete("fang/luochapai");
        return 1;
} 
