// cloth.c
//
// This is the basic equip for players just login.

#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("小花裙", ({ "xiaoskirt", "skirt" }) );
	set_weight(3000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("value", 6000);
		set("long", "这是一条漂亮的小花裙。\n");
		set("material", "cloth");
		set("armor_prop/armor", 1);
	}
	setup();
}
