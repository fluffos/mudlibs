// dumpling.c

inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("蚧味鱼米", ({ "pwym" }) );
	set_weight(80);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一盘香喷喷的蚧味鱼米。\n");
		set("unit", "盘");
		set("value", 2000);
		set("food_remaining", 1);
		set("food_supply", 30);
	}
}
