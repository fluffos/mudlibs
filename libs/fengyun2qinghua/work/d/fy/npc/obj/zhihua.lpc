// token.c


inherit ITEM;

void create()
{
        set_name("纸花", ({ "zhihua", "flower" }) );
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long", "一把白色的纸花。\n");
                set("material", "paper");
                set("value", 1000);
        }
        setup();
}
