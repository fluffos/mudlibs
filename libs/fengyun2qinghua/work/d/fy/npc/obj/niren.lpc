// token.c


inherit ITEM;

void create()
{
        set_name("小泥人", ({ "niren" }) );
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("long", "一个憨态可鞠的小泥人。\n");
                set("material", "wood");
                set("value", 1000);
        }
        setup();
}
