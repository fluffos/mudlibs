// token.c


inherit ITEM;

void create() {
  set_name("小风车", ({ "small windmill", "windmill" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "只");
    set("long", "一只呼呼转动的小风车。\n");
    set("material", "paper");
    set("value", 1000);
  }
  setup();
}
