// book.c

inherit ITEM;

void create()
{
	set_name( "金瓶梅" , ({ "jinpingmei" }));
	set_weight(600);
	set("unit", "本");
	set("long", "这也是时下读书人常看的书籍，你可以阅读(read)它。\n");
	set("value", 260);
}

void init()
{
    add_action("do_read", "read");
}

int do_read(string arg)
{
    if(!stringp(arg))return 0;
    if(arg != "book")return 0;
    write("一股热气从你的丹田升起，你觉得有一种冲动。\n");
    this_player()->add("sen", -40);
    return 1;
}
