// token.c


inherit ITEM;

void create() {
  set_name("油油的纸", ({ "youzhi", "paper" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("long", "一张油油的纸，上面似乎可以写字。\n");
    set("material", "paper");
    set("value", 3);
  }
  setup();
}

void init() {
  add_action("do_print", "print");
}

int do_print(string arg) {
  if (!stringp(arg)) return 0;
  if (stringp(query("targetid"))) return notify_fail("这张纸已经写过字了。\n");
  else set("targetid", arg);
  write("ok.\n");
  return 1;
}
