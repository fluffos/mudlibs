// token.c

#include <ansi.h>
inherit ITEM;

void create() {
  set_name(RED "杀手牌" NOR, ({ "killer pai", "pai" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("long", "一块杀手用的腰牌。\n");
    set("material", "wood");
    set("value", 4000);
  }
  setup();
}
