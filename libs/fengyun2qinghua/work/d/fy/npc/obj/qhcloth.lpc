// cloth.c
//
// This is the basic equip for players just login.

#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create()
{
	set_name(HIY"浅黄小褂"NOR, ({ "yellow xiaogua", "cloth" }) );
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("value", 7000);
		set("long", "这是浣凤堂小童穿的衣服，看上去十分可爱。\n");
		set("material", "cloth");
		set("armor_prop/armor", 1);
	}
	setup();
}
