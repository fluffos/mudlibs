// dagger.c : an example weapon

#include <weapon.h>
#include <ansi.h>

inherit SWORD;

void create() {
  set_name(HIR "杀手剑" NOR, ({ "killer sword", "sword" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是一把杀手专用的剑，剑身细长，隐隐见到血痕。\n");
    set("value", 5000);
    set("material", "steel");
  }
  init_sword(30);

  // These properties are optional, if you don't set them, it will use the
  // default values.

  set("wield_msg", "$N从腰上拔出一把$n。\n");
  set("unwield_msg", "$N将手中的$n插如腰间。\n");

  // The setup() is required.

  setup();
}
