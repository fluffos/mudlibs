// dumpling.c

inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("素菜包", ({ "cai bao", "dumpling" }) );
	set_weight(80);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一个香喷喷、热腾腾的素菜包。\n");
		set("unit", "个");
		set("value", 70);
		set("food_remaining", 3);
		set("food_supply", 60);
	}
}
