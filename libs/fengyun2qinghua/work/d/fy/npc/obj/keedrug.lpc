// medicine.c

inherit ITEM;

void create() {
  set_name("云南白药", ({ "yunnan baiyao", "baiyao" }));
  set_weight(30);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "一颗白色的丹药，你可以用来(use)治伤 。\n");
    set("unit", "颗");
    set("value", 2000);
  }
}

void init() {
  add_action("apply_medicine", "use");
}

int apply_medicine() {
  int value = 20;
  int diff;

  if (this_player()->is_fighting())
    return notify_fail("战斗中不能用药治伤!\n");
  diff = this_player()->query("max_kee") - this_player()->query("eff_kee");
  if (!(diff)) return notify_fail("你没有受伤啊?\n");
  if (value > diff) value = diff;

  message_vision("$N吃下一颗云南白药，顿时气血旺盛 .\n", this_player());
  this_player()->add("eff_kee", value);
  destruct(this_object());
  return 1;
}
