// tea_leaf.c

#include <weapon.h>

inherit THROWING;

void create()
{
	set_name("小石子儿", ({ "little stone", "stone" }) );
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("base_unit", "颗");
		set("base_weight", 1);
		set("base_value", 0);
	}
	set_amount(80);
	init_throwing(2);
	setup();
}
