// dagger.c : an example weapon

#include <weapon.h>
#include <ansi.h>

inherit DAGGER;

void create()
{
	set_name("杀威棒", ({ "shawei" }) );
	set_weight(10000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "根");
		set("long", "这是风云衙役专用的武器--杀威棒。\n");
		set("value", 40000);
		set("material", "wood");
	}
	init_dagger(50);

// These properties are optional, if you don't set them, it will use the
// default values.

	set("wield_msg", "$N从身后提出一把$n握在手中。\n");
	set("unwield_msg", "$N将手中的$n背向身后。\n");

// The setup() is required.

	setup();
}
