// cloth.c
//
// This is the basic equip for players just login.

#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("铁线衣", ({ "stell cloth", "cloth" }) );
	set_weight(10000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("value", 100000);
		set("long", "这是一件用铁线织成的衣服。\n");
		set("material", "cloth");
		set("armor_prop/armor", 25);
	}
	setup();
}
