// token.c


inherit ITEM;

void create()
{
        set_name("《风云赞歌》", ({ "poem" }) );
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "本");
                set("long", 
"这是一首歌颂风云的诗歌，上面写着：

[35m					  是非成败转头空，
						    风云依旧在，
							几度血光红．




[30m
\n\n");
                set("material", "paper");
                set("value", 1);
        }
        setup();
}
