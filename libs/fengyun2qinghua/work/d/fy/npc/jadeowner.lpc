
inherit NPC;
inherit F_VENDOR;

void create()
{
        set_name("商玉龙", ({ "seller" }) );
        set("gender", "男性" );
        set("str", 300);
        set("age", 42);
        set("long", 
"这是一位肥肥胖胖店掌柜\n");
        set("combat_exp", 300000);
	set("str", 300);
        set("attitude", "heroism");
        set_skill("dodge", 100);
        set_skill("move", 100);
        set_skill("unarmed", 200);
        set("vendor_goods", ([
                __DIR__"obj/jade1" : 10,
                __DIR__"obj/jade2" : 10,
                __DIR__"obj/jade3" : 10,
                __DIR__"obj/jade4" : 10,
        ]) );

        setup();
//        add_money("tenthousand-cash", 50);
        carry_object("/obj/cloth")->wear();
}

void init()
{
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");
}
void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        switch( random(2) ) {
                case 0:
                        say( " 商老板笑着道：这位"
                                + RANK_D->query_respect(ob)
                                + "，买玉挡灾吗？ \n");
                        break;
                case 1:
                        say( " 商老板笑着道：这位"
                                + RANK_D->query_respect(ob)
                                + "，玉是吉祥之物，江湖凶险，还是买一块挡灾吧。 \n");
                        break;

        }
}



