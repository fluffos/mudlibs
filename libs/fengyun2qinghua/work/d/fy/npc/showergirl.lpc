// waiter.c

inherit NPC;
inherit F_VENDOR;

void create()
{
	set_name("小丫鬟", ({ "xiao yahuan", "yahuan" }) );
	set("gender", "女性" );
    set("title", "如花似玉");
	set("age", 12);
	set("long",
		"这位小丫鬟是专门出售浴具的，你可以在这里买到白毛巾。\n");
	set("combat_exp", 500000);
	set("attitude", "peaceful");
	set("vendor_goods", ([
        __DIR__"obj/whitetowel" : 10,
	]) );
    set_skill("unarmed", 20);
    set_skill("meihua-shou", 20);
    set_skill("dodge", 20);
    set_skill("fall-steps", 20);
    set_skill("move", 20);
    set_skill("force", 20);
    set_skill("qidaoforce", 20);
    map_skill("force", "qidaoforce");
    map_skill("move", "fall-steps");
    map_skill("dodge", "fall-steps");
    map_skill("unarmed", "meihua-shou");
    set("max_force", 1000);
    set("force", 1000);
    set("force_factor", 20);
	setup();
    carry_object(__DIR__"obj/qlcloth")->wear();
	set("score",40);
}

void init()
{	
	object ob;

	::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
	add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	switch( random(3) ) {
		case 0:
			say( "小丫鬟笑咪咪地说道：这位" + RANK_D->query_respect(ob)
				+ "，进来洗个澡吧。\n");
			break;
			break;
		case 2:
			say( "小丫鬟说道：这位" + RANK_D->query_respect(ob)
				+ "，我这有白毛巾卖哟。\n");
			break;
	}
}
