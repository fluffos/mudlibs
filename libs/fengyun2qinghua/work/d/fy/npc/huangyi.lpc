// tufei1.c

inherit NPC;

void create()
{
	set_name("黄衣卫", ({ "yellow guard", "guard" }) );
	set("gender", "男性");
	set("age", 20 + random(40));
	set("long",
		"这是一位金钱帮总舵的黄衣卫。\n");
	set("combat_exp", 50000 + random (100) * 500 );

    set("attitude", "heroism");

	set("apply/attack", 40 + random(40));
	set("apply/defense", 40 + random(40));

	set_skill("unarmed", 40);
	set_skill("sword", 40);
	set_skill("parry", 40);
	set_skill("dodge", 40);
    set_skill("move", 40);
    
    set("max_force", 1000);
    set("force", 1000);

    set("force_factor", 3);
	setup();

       carry_object(__DIR__"obj/huangcloth")->wear();
       carry_object("/obj/longsword")->wield();

	add_money("silver", 10);
}