// teacher.c

inherit NPC;

void create() {
  set_name("裸体男人", ({ "naked man", "man" }));
  set("gender", "男性");
  set("age", 20 + random(50));

  set("attitude", "heroism");
  set("long", "这里热气腾腾，每个人看起来火气都很大。\n");
  set("combat_exp", 100000 + random(100) * 1000);
  set_temp("apply/attack", 100);
  set_temp("apply/defense", 100);
  set_temp("apply/damage", 100);
  set_temp("apply/armor", 100);
  set("max_force", 3000);
  set("force", 3000);
  set("bellicosity", 2000);

  setup();
  set("score", 5);
}
