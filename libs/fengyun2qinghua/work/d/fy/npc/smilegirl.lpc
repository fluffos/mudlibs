// teacher.c

inherit NPC;

void create()
{
	set_name("楚楚", ({ "chuchu" }) );
	set("gender", "女性" );
	set("age", 12);
    set("long", "楚楚好奇地盯着你看，看的你都不好意思了。\n");
	set("attitude", "heroism");
    set("combat_exp", 500000);
    set_skill("unarmed", 100);
    set_skill("dodge", 100);
    set_skill("move", 100);
    set("max_force", 3000);
    set("force", 3000);
    set("force_factor", 10);

	setup();
	set("score",5);
    carry_object(__DIR__"obj/qlcloth")->wear();
}

