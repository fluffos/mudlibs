// tufei1.c

inherit NPC;

void create() {
  set_name("吴青", ({ "wuqing" }));
  set("gender", "男性");
  set("title", "金钱帮赏罚堂堂主");
  set("age", 46);
  set("long",
    "一个精明能干，武功高强的赏罚堂堂主。\n");
  set("combat_exp", 1600000 + random(100) * 10000);

  set("attitude", "heroism");

  set("apply/attack", 200 + random(200));
  set("apply/defense", 200 + random(200));

  set_skill("unarmed", 100 + random(100));
  set_skill("meihua-shou", 100 + random(100));
  set_skill("parry", 100 + random(100));
  set_skill("dodge", 100 + random(100));
  set_skill("jinhong-steps", 100 + random(100));
  set_skill("move", 100 + random(100));

  map_skill("move", "jinhong-steps");
  map_skill("dodge", "jinhong-steps");
  map_skill("unarmed", "meihua-shou");
  set("max_force", 3000);
  set("force", 3000);

  set("force_factor", 30);
  setup();

  carry_object(__DIR__ "obj/huangcloth")->wear();

}
