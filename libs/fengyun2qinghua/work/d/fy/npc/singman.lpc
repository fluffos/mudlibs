// singman.c

inherit NPC;
int give_poem();

void create()
{
	set_name("金榜总管", ({ "singman" }) );
	set("gender", "男性");
	set("age", 25);
	set("long",
		"一位管理点唱金榜的总管，你可以找他问问点唱金榜的事。\n");
	set("combat_exp", 2000000 + random (100) * 40000 );

    set("attitude", "friendly");

	set("apply/attack", 20 + random(40));
	set("apply/defense", 20 + random(40));

	set_skill("unarmed", 40);
	set_skill("sword", 40);
	set_skill("parry", 40);
	set_skill("dodge", 40);
    set_skill("move", 40);
    
    set("max_force", 10000);
    set("force", 10000);

    set("force_factor", 30);
        set("inquiry", ([
                "点唱" :        (: give_poem :),
                "点唱金榜" :    (: give_poem :),
                "sing" :        (: give_poem :),
                "song" :        (: give_poem :),
        ]));

	setup();

    carry_object(__DIR__"obj/fycloth")->wear();
	add_money("silver", 50);

}

int give_poem()
{
	object ob;
    if(this_player()->query("combat_exp") < 1000)  {
    command("say 你的功夫低微，还是好好练功为上，要知道玩物丧志啊。\n");
    return 1;   }
	command("say 看来你对歌曲颇有兴趣啊，我们可以共同探讨！！ \n");
	ob = new ("/obj/example/sing");
    write("金榜总管给你一本"+ob->query("name")+"。\n");
    ob ->move(this_player());
	return 1;
}
