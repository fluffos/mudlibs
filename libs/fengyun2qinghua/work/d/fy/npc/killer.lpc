// teacher.c

inherit NPC;

void create()
{
	set_name("杀手", ({ "killer" }) );
	set("gender", "男性" );
	set("age", 32);
    set("long", "杀手狠狠地瞪了你一眼，你觉得一股寒意直上心头。\n");
	set("attitude", "heroism");
    set("hired_killer", 1);
    set("max_force", 3000);
    set("force", 3000);
    set("force_factor", 10);

	setup();
	set("score",5);
    carry_object(__DIR__"obj/killer_pai");
    carry_object(__DIR__"obj/killer_sword")->wield();
}

void init()
{
	object	ob, targ;
	string	target;

	::init();
   	target = query("haunttar");
	if(objectp(targ = present(target, environment()))) {
			message_vision("$N冷冷地说道：有人花钱买你的命，你再劫难逃。\n", this_object(), targ);
			this_object()->kill_ob(targ);
			this_object()->set_leader(targ);
			targ->kill_ob(this_object());
        }
}

