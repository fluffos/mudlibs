// tufei1.c

inherit NPC;

void create()
{
	set_name("年青人", ({ "youngman" }) );
	set("gender", "男性");
    set("long", "一个单身的年青人，正盼着桃花运的降临。\n");
	set("age", 25);
	set("combat_exp", 2000 + random (100) * 20 );

    set("attitude", "peaceful");

	set("apply/attack", 20 + random(10));
	set("apply/defense", 20 + random(10));

    set("max_force", 400);
    set("force", 400);

    set("force_factor", 3);
    set("chat_chance", 40);
    set("chat_msg", ({
        "年青人扭过头去，对尝试者理都不理。\n"
})  );
   
	setup();

        carry_object("/obj/cloth")->wear();
 	add_money("gold", 1);
}