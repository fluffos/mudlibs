// herbalist.c

inherit NPC;
inherit F_VENDOR;

string heal_me(object me);

void create() {
  set_name("普生", ({ "pusheng" }));
  set("title", "赛华陀");
  set("gender", "男性");
  set("age", 34);
  set("long",
    "这位普生堂老板武功，医道精湛。救死扶伤无数。\n");
  set("combat_exp", 600000);
  set_skill("unarmed", 200);
  set_skill("dodge", 200);
  set_skill("move", 200);
  set("attitude", "peaceful");
  set("inquiry", ([
    "治伤": (: heal_me :),
    "疗伤": (: heal_me :),
    "开药": (: heal_me :),
  ]));

  set("vendor_goods", ([
    __DIR__ "obj/sendrug": 22,
    __DIR__ "obj/keedrug": 60,
    __DIR__ "obj/gindrug": 22,
  ]));

  set_skill("literate", 70);
  set_skill("dodge", 120);

  set_skill("unarmed", 120);
  setup();
  carry_object(__DIR__ "obj/fycloth")->wear();
}

string heal_me(object ob) {
  int ratio;
  object me;
  me = this_player();
  ratio = (int)me->query("eff_kee") * 100 / (int)me->query("max_kee");
  if (ratio >= 100)
    return "这位" + RANK_D->query_respect(me) + "，您看起来气色很好啊，不像有受伤的样子。";
  if (ratio >= 95)
    return "哦....我看看....只是些皮肉小伤，您买包云南白药药回去敷敷就没事了。";

}



void init() {
  object ob;

  ::init();
  add_action("do_vendor_list", "list");


}
