// teacher.c

inherit NPC;

void create()
{
	set_name("王仁德", ({ "kaoguan" }) );
	set("title", "御封考官");
	set("gender", "男性" );
	set("age", 47);
	set("int", 26);

	set("long",
"王仁德是个博学多闻的御封考官，他年轻时曾经中过举人，但是因为
生性喜爱年青人不愿做官，王仁德以监考为业，如果你愿学王仁德总
是会教的．\n");
	set("inquiry", ([
		"学费": "嗯....知识是无价的，不过如果你有心的话——只要五十两银子。\n",
		"读书识字": "对，读书识字。",
	]) );
	set("attitude", "peaceful");
	set_skill("literate", 100);

	setup();
	set("score",5);
    carry_object("/obj/cloth")->wear();
}

int recognize_apprentice(object ob)
{
	if( !ob->query("marks/王仁德") ){
		say("王仁德说道：咦？我不记得收过你这个学生啊....\n");
		return 0;
	}

	return 1;
}

int accept_object(object who, object ob)
{
	if( !who->query("marks/王仁德") ) {
		if( ob->value() >= 5000 ) {
			say("王仁德点了点头，说道：很好，从今天起你随时可以来问我有关读书识字(literate)\n"
				"                      的任何问题。\n");
			who->set("marks/王仁德", 1);
			return 1;
		} else {
			say("王仁德说道：你的诚意不够，这钱还是拿回去吧。\n");
			return 0;
		}
	} else
		say("王仁德点了点头，说道：哦，向你这麽有心的学生还真是不多见，好好努力\n"
			"                      将来必定前途无量，谢了。\n");
	return 1;
}
