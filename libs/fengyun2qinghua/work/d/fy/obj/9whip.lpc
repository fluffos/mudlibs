// rope.c

#include <weapon.h>

inherit WHIP;

void create()
{
        set_name( "九截鞭", ({ "nine whip", "whip" }) );
        set_weight(1500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "条");
                set("value", 500);
                set("material", "skin");
        }
        init_whip(15);

        set("wield_msg", "$N从腰间摸出一条$n握在手中。\n");
        set("unwield_msg", "$N将手中的$n束在腰间。\n");

        setup();
}

