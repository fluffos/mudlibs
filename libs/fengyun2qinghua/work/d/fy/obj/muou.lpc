// token.c


inherit ITEM;

void create()
{
        set_name("面目空白的小木像", ({ "statue" }) );
        set_weight(20);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "只");
                set("long", "一只面目空白的小木雕像。\n");
                set("material", "wood");
                set("value", 3);
        }
        setup();
}
