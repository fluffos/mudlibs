inherit ROOM;
void create()
{
	set("short", "巨大的镜子");
	set("long", @LONG
拉起空布幔便露出一面晶莹而巨大的镜子，镜框上镶满了翡翠和
珠宝，但就算这些价值连城的珠宝，也不能掩蔽镜子的光彩，这镜子
本身就象是带着神秘的魔力。
LONG
	);
	set("exits", ([ 
  "southup" : __DIR__"road10",
  "northup" : __DIR__"wu2",
]));

        setup();
        replace_program(ROOM);
}


