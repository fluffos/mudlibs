// taolord.c
#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create() {
  set_name("石观音", ({ "master shi", "master", "shi" }));
  set("gender", "女性");
  set("age", 22);
  set("per", 40);
  set("long",
    "石观音的美丽，竟已是今人不能想象的，因为她的美丽已全部占据了
人们的想象力。有很多人都常用“星眸”来形容女子的美丽，但星光
又怎及她这双眼睛的明亮与温柔。有很多人都常用“春山”来形容美
女的眉，但纵是雾里朦胧的春山也不及她秀眉的婉约。\n");
  set("combat_exp", 5000000);
  set("score", 200000);

  set("class", "assassin");

  set("str", 30);
  set("int", 30);
  set("cor", 20);
  set("cps", 30);
  set("spi", 30);

  set("force", 15000);
  set("max_force", 15000);
  set("force_factor", 150);

  set("inquiry", ([
    "迎风一刀斩":
    "迎风一刀斩自东瀛传入中国，是天下最强的刀法。\n",
    "天枫派":
    "天枫派的开山祖师是来自东瀛的天枫十四郎。\n"
  ]));

  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed.yaozhan" :),
    (: perform_action, "dodge.taixubaihuan" :),
    (: exert_function, "powerup" :),
  }));

  create_family("天枫派", 2, "掌门");

  set_skill("dodge", 100);
  set_skill("force", 100);
  set_skill("blade", 150);
  set_skill("literate", 100);
  set_skill("ghosty-steps", 100);
  set_skill("wind-blade", 130);
  set_skill("parry", 100);
  set_skill("kongshoudao", 100);
  set_skill("ghosty-force", 150);
  set_skill("unarmed", 100);

  map_skill("parry", "wind-blade");
  map_skill("blade", "wind-blade");
  map_skill("force", "ghosty-force");
  map_skill("unarmed", "kongshoudao");
  map_skill("dodge", "ghosty-steps");

  setup();

  carry_object(__DIR__ "obj/robe")->wear();
}

void attempt_apprentice(object ob) {
  call_out("do_recruit", 2, ob);
}

void do_recruit(object ob) {
  if ((string)ob->query("gender") != "女性")
    command("say 又是一个臭男人，给我滚远远的吧。");
  else {
    command("smile");
    command("say 你将来必有大成。");
    command("recruit " + ob->query("id"));
  }
}

int recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "assassin");
}

void init() {
  add_action("give_quest", "quest");
}

void re_rank(object student) {
  int exp;
  exp = (int)student->query("combat_exp");
  if (exp <= 32000) {
    student->set("title", "天枫流粉带三级");
    return;
  } else if (exp <= 64000) {
    student->set("title", "天枫流红带二级");
    return;
  } else if (exp <= 128000) {
    student->set("title", "天枫流棕带一级");
    return;
  } else if (exp <= 256000) {
    student->set("title", "天枫流黑带一段");
    return;
  } else if (exp <= 512000) {
    student->set("title", "天枫流黑带二段");
    return;
  } else if (exp <= 1024000) {
    student->set("title", "天枫流黑带三段");
    return;
  } else if (exp <= 1536000) {
    student->set("title", "天枫流黑带四段");
    return;
  } else if (exp <= 2304000) {
    student->set("title", "天枫流黑带五段");
    return;
  } else if (exp <= 3456000) {
    student->set("title", "天枫流黑带六段");
    return;
  } else if (exp <= 5187000) {
    student->set("title", "天枫流黑带七段");
    return;
  } else if (exp <= 26244000) {
    student->set("title", "天枫流黑带八段");
    return;
  } else
    student->set("title", "天枫流黑带九段");
  return;
}
