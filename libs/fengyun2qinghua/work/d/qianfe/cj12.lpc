#include <ansi.h>
inherit ROOM;
void create()
{
        set("short", "香积厨");
        set("long", @LONG
香积厨为禅寺的厨房，供奉的是万紧那罗王，相传曾显化为一火
头僧，运三尺棍趋散红巾首领的犯寺。
LONG
        );
        set("exits", ([ 
  "west"   : __DIR__"cj10"
]));
        set("objects", ([   
        __DIR__"npc/monk" : 1
])  );
        setup();
}

void init()
{
    add_action("do_push", "push");
}

void close_path()
{
    if(!query("exits/north") ) return;
    tell_room(this_object(), BLU"万紧那罗王嘎．．嘎．．嘎．．地又移回原位，向北的路口消失了。\n"NOR);
    delete("exits/north");
}

int do_push(string arg)
{   
    if(!arg)return 0;
    write("你推了推"+arg+"\n");
    if(arg == "万紧那罗王"){
    if(random(this_player()->query_temp("marks/push")) > 5)    {
    write(HIR"万紧那罗王嘎．．嘎．．嘎地移开了。\n"NOR);
    if( !query("exits/north") ) {
    set("exits/north", __DIR__"xing1");
    call_out("close_path", 3);  }
    this_player()->delete_temp("marks/push");
    }
    else this_player()->add_temp("marks/push", 1);
    }
    return 1;
}
    
