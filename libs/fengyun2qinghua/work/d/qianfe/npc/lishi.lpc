inherit NPC;
void create()
{
        set_name( "力士", ({ "lishi" }) );
        set("gender", "男性" );
        set("age", 42);
        set("no_shown", 1);
        set("long", "面貌雄伟，作忿怒相，上半身赤裸，两脚张开，呈紧张状．\n");
        set("combat_exp", 1000000);
        set("attitude", "heroism");
        set_skill("staff", 50);
        set_skill("unarmed", 50);
	    set_skill("dodge", 40);
        set("force",1000);
        set("force_factor",20);
        set("max_force",1000);
	
    	setup();
        carry_object(__DIR__"obj/chu")->wield();
        carry_object(__DIR__"obj/hat")->wear();
}

