// needle.c


inherit ITEM;

void create()
{
        string *names = ({
        "黑", "红", "白", "蓝", "绿", "黄", "紫", "青"
        });
        set_name(names[random(sizeof(names))]+"色细针", ({ "needle" }) );
        set_weight(5);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "根");
                set("long", "一根缝衣服用的细针。\n");
                set("material", "steel");
                set("value", 100);
        }
        setup();
}
