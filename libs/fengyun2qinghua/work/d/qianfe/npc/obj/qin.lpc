// qin.c


inherit ITEM;

void create()
{
        set_name("古松琴", ({ "qin" }) );
        set_weight(20000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("long", "一个古色古香的古松琴\n");
                set("material", "wood");
                set("value", 1000);
        }
        setup();
}

void init()
{
    add_action("do_play", "play");
}

int do_play()
{
    message_vision("$N双手一划琴弦，弹出一首流水般的曲子。\n", this_player());
    this_player()->set_temp("marks/古松琴", 1);
    return 1;
}
