// hat.c
#include <ansi.h>
inherit EQUIP;

void create()
{
	set_name(MAG"七彩丝缎带"NOR, ({ "silk" }) );
	set_weight(200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "条");
		set("long", 
"一条产自异域的七彩丝缎带，闪着奇异的光泽。\n");
		set("material", "cloth");
		set("armor_type", "waist");
        set("value", 20000);
		set("armor_prop/armor", 10);
        set("armor_prop/dodge", 10);
        set("armor_prop/spirituality", 3);
	}
}
