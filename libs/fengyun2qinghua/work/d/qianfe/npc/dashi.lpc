inherit NPC;
void create()
{
	string *order=({"凤", "龙", "无刀", "无剑", "宣", "肥", "兽", "虎"});
        set_name("天"+(order[random(8)]), ({ "dashi" }) );
        set("gender", "男性" );
        set("age", 20 + random(30));
        set("attitude", "peaceful");
        set("long", "他是兴国禅寺中颇有威望的天字辈大师\n");
        set("title", "兴国禅寺天字辈大师");
        set("combat_exp", random(100) * 10000);
        set_skill("unarmed", random(100) * 5);
    	set_skill("notracesnow",random(100) * 3);
	    set_skill("dodge", random(100) * 4);
    	set_skill("force",random(100) * 4);
	    map_skill("dodge","notracesnow");
        set("force",random(100) * 100);
        set("force_factor",random(100) * 2);
        set("max_force",random(100) * 100);
        set("chat_chance", 10);
        set("chat_msg", ({
		(: random_move :)
        }) );
	
	setup();
        carry_object(__DIR__"obj/huicloth")->wear();
        carry_object(__DIR__"obj/rshoe")->wear();
}

