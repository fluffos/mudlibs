// feng.c
#include <ansi.h>
inherit NPC;

void create() {
  set_name("风静", ({ "fengjing" }));
  set("gender", "男性");
  set("age", 34);
  set("combat_exp", 500);
  set("attitude", "peaceful");
  set("class", "bonze");

  set("force", 100);
  set("max_force", 100);

  set("inquiry", ([
    "兴国":
    "兴国大师乃我的师叔祖，在八识神通方面有极深的造诣。\n",
    "兴国大师":
    "兴国大师乃我的师祖叔，在八识神通方面有极深的造诣。\n",
    "定邦":
    "定邦大师乃我的师叔，在少林长拳方面有极深的造诣。\n",
    "定邦大师":
    "定邦大师乃我的师叔，在少林长拳方面有极深的造诣。\n",
    "参机":
    "参机大师乃我的师父，是本寺第一高手。\n",
    "参机大师":
    "参机大师乃我的师父，是本寺第一高手。\n"
  ]));

  set("title", "兴国禅寺风字辈大师");
  set("long", "他是兴国禅寺中颇有威望的风字辈大师\n");
  set_skill("dodge", 5);
  set_skill("force", 5);
  set_skill("literate", 5);
  set_skill("buddhism", 5);
  set_skill("notracesnow", 5);
  set_skill("parry", 5);
  set_skill("lotusforce", 5);
  set_skill("unarmed", 5);
  set_skill("chanting", 5);
  set_skill("cloudstaff", 5);
  set_skill("magic", 5);
  set_skill("staff", 5);
  set_skill("changquan", 5);

  map_skill("force", "lotusforce");
  map_skill("staff", "cloudstaff");
  map_skill("parry", "cloudstaff");
  map_skill("dodge", "notracesnow");
  map_skill("unarmed", "changquan");

  setup();

  carry_object(__DIR__ "obj/huicloth")->wear();
  carry_object(__DIR__ "obj/rshoe")->wear();
}
