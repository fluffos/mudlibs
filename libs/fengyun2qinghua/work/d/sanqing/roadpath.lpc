inherit ROOM;

void create()
{
	set("short", "青石小径");
	set("long", @LONG
这是一条幽静的小道，西北面直通三清宫的藏经阁，地上长满了
青苔，稍不留意就会滑倒，不过轻功高的人或许能安然度过。
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
  		"southeast" : __DIR__"da_dian",
        "northwest" : __DIR__"roadpath2",
]));
	setup();
}

int valid_leave(object me, string dir)
{
        if(random(5))
        message_vision("$N身子晃了一晃，幸好没有滑倒。\n", me);
        else{
        message_vision("$N一脚踩在青苔上, 不小心滑了一跤, 四脚朝天地摔在地上起不来。\n", me);
        me->unconcious();
        }
        return 1;
}

    
