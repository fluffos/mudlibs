
#include <room.h>

inherit ROOM;

void create()
{
	set("short", "鹰记商号");
	set("long", @LONG
鹰记一向是信用卓著，生意鼎盛的商号。从藏东来的藏香，从关
内来的瓷器和丝缎，从打箭炉来的茶砖，无论什么，只要是值钱的东
西，都可以在这里买卖。柜台上放著一块牌子(sign)。
LONG
	);
	set("item_desc", ([
		"sign": @TEXT
本商号财力雄厚，铜钱、银两、黄金、银票一概通用。本商号提供如
下服务。

pawn        典当货物。
value       估价货物。
sell        卖断货物。
redeem      赎回货物。
convert     兑换钱币。
withdraw    提取存款。
deposit     存入钱币。
balance     察寻存款。
loan        向钱庄借钱。

TEXT
	]) );
	set("exits", ([
		"west" : __DIR__"octo15",
	]));
        set("objects", ([
                __DIR__"npc/puying": 1,
                "/u/wudang/npc/xiaotong": 3 ]) );

	setup();

}
