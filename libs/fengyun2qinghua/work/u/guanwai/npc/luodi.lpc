// beggar.c

inherit NPC;

void create()
{       
        string *name  = ({
        "魏", "陶", "杨", "沈", "刘"});
        string *names = ({
        "欧派", "木耳", "妈唔", "闼闼"});
        set_name(name[random(sizeof(name))]+names[random(sizeof(names))], ({ "shusheng" }) );
        set("gender", "男性" );
        set("title", "落第秀才");
        set("age", 33);
        set("long", "一个考试没及第的秀才。\n");
        set("combat_exp", 1000);
        set("force", 200);
        set("max_force", 200);
        set("force_factor", 2);
        setup();
        carry_object("/obj/cloth");
}

