inherit ROOM;

void create()
{
        set("short", "乡间小路");
        set("long", @LONG
这是一条从小镇通出来的黄土小路。南面是小镇的郊外，你似乎
还可以听到从小镇传来的噪杂人声。往北是一望无际的平原。一座黑
朦朦的山从云雾里忽隐忽现。
LONG
        );
        set("exits", ([ 
  "southwest" : "/u/palace/palace_path1",
  "north" : __DIR__"dustyroad.lpc",
]));
        set("outdoors", "chuenyu");

        setup();
        replace_program(ROOM);
}

