// medicine.c

inherit ITEM;

void create() {
  set_name("金疮药", ({ "medicine" }));
  set_weight(30);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "一颗金疮药, 可以用来敷上(apply)治伤 。\n");
    set("unit", "颗");
    set("value", 2000);
  }
}

void init() {
  add_action("apply_medicine", "apply");
}

int apply_medicine() {
  this_player()->apply_condition("rose_poison", 0);
  destruct(this_object());
}
