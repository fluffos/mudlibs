// daqiangburu.c
#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me, int amount);

int perform(object me, object target)
{
    	int skill;

        if( target != me ) return 
notify_fail("你只能用刀枪不入加强自己的金刚不坏。\n");

        if( (int)me->query("force") < 100 )     return 
notify_fail("你的内力不够。\n");
        if( (int)me->query_temp("ironup") ) return 
notify_fail("你已经在运功中了。\n");

        skill = me->query_skill("iron-cloth");

        me->add("force", -100);
        me->receive_damage("kee", 0);

	    message_vision(BLU "$N口中念道：啊吧啦嗒嘎，默运密宗绝学：刀枪不入，只见一道金光隐隐现于$N的周围。", me);

        me->add_temp("apply/iron-cloth", skill/4);
        me->set_temp("ironup", 1);

        me->start_call_out( (: call_other, __FILE__, "remove_effect", me, 
skill/4 :), skill);

        if( me->is_fighting() ) me->start_busy(3);

        return 1;
}

void remove_effect(object me, int amount)
{
        me->add_temp("apply/iron-cloth", - amount);
        me->delete_temp("ironup");
        tell_object(me, "你的刀枪不入运行完毕，将内力收回丹田。\n");
}
 

