// longxianyuye.c

#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target)
{
	string msg;

	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("雷霆霹雳只能对战斗中的对手使用。\n");

	if (me->query_skill("blade") < 100)
	{
		return notify_fail("你刀法等级不够\n");
	}

	msg = HIR "$N向四周荡起几股刀风，手中"NOR+"$w"+HIR"幻出无穷刀影，闪电般地向$n的$l砍去！" NOR;
    me->add_temp("apply/damage", 100);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    me->add("apply/damage", -100);
	me->start_busy(2);
	return 1;
}
