// depoison.c
// modify by oda

#include <ansi.h>

int exert(object me)
{
	int need;

        if(me->query_skill("force")/2+me->query_skill("badforce", 1)<20)
          return notify_fail("你的内功太差，无法逼毒。\n");
	if( me->is_fighting() ) {
		tell_object(me, "战斗中不能逼毒。\n");
		return 1;
	}
        if((int)me->query("kee")<30 || (int)me->query("sen")<30 )
          return notify_fail("你的精或神不够，不能逼毒。\n");
	
        if((need=me->query_condition("snake_poison")*2)!=0)
        {
                if((int)me->query("force")< need)
                        return notify_fail("你的内力不足，不能逼毒。\n");
                message_vision(
                HIW"$N运起恶化魔功把蛇毒给逼了出来。\n"NOR, me);
                me->add("force", -need);
                me->apply_condition("snake_poison", 0);
        }
        else if((need=me->query_condition("hualiu_poison")*2)!=0)
        {
                if((int)me->query("force")< need)
                        return notify_fail("你的内力不足，不能逼毒。\n");
                message_vision(
                HIW"$N运起恶化魔功把花柳病毒给逼了出来。\n"NOR, me);
                me->add("force", -need);
                me->apply_condition("hualiu_poison", 0);
        }
        else if((need=me->query_condition("dark_poison")*3)!=0)
        {
                if((int)me->query("force")< need)
                        return notify_fail("你的内力不足，不能逼毒。\n");
                message_vision(
                HIW"$N运起恶化魔功把深宫奇毒给逼了出来。\n"NOR, me);
                me->add("force", -need);
                me->apply_condition("dark_poison", 0);
        }
        else if((need=me->query_condition("rose_poison")*3)!=0)
        {
                if((int)me->query("force")< need)
                        return notify_fail("你的内力不足，不能逼毒。\n");
                message_vision(
                HIW"$N运起恶化魔功把火玫瑰毒给逼了出来。\n"NOR, me);
                me->add("force", -need);
                me->apply_condition("rose_poison", 0);
        }
        else if((need=me->query_condition("five_poison")*4)!=0)
        {
                if((int)me->query("force")< need)
                        return notify_fail("你的内力不足，不能逼毒。\n");
                message_vision(
                HIW"$N运起恶化魔功把五毒神掌之毒给逼了出来。\n"NOR, me);
                me->add("force", -need);
                me->apply_condition("five_poison", 0);
        }
        else if((need=me->query_condition("ff_poison")*5)!=0)
        {
                if((int)me->query("force")< need)
                        return notify_fail("你的内力不足，不能逼毒。\n");
                message_vision(
                HIW"$N运起恶化魔功把无名之毒给逼了出来。\n"NOR, me);
                me->add("force", -need);
                me->apply_condition("ff_poison", 0);
        }
	else
	 return notify_fail("你并无中毒或是你所中的毒本心法尚无法解之，请自己保重。\n");
/*	message_vision(
     	HIY"$N运起恶化神功\加速身上的毒性运行，只见$N脸上肌肉扭曲，十分痛苦，一会儿，$N从口中吐出一只虫，虫一落地就化成一滩血水，而$N已经恢复正常。\n" NOR,
	me);
*/
	return 1;
}
