// longxianyuye.c

#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target) {
  string msg;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("玉环鸳鸯只能对战斗中的对手使用。\n");

  if (me->query_skill("unarmed") < 150) {
    return notify_fail("你少林长拳等级不够\n");
  }

  if (me->query("force") < 500) {
    return notify_fail("你内力不够\n");
  }

  message_vision(HIR "$N使出少林长拳中的［玉环鸳鸯拳］，一招连环七式向$n攻出！\n" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, YEL "上一拳！" NOR);
  me->add("str", 10);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, YEL "下一拳！" NOR);
  me->add("str", 10);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, YEL "左一拳！" NOR);
  me->add("str", 10);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, YEL "右一拳！" NOR);
  me->add("str", 10);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, YEL "前一拳！" NOR);
  me->add("str", 10);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, YEL "后一拳！" NOR);
  me->add("str", 10);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, YEL "最后再一拳！！" NOR);
  me->add("str", -60);
  me->add("force", -500);
  me->start_busy(5);
  return 1;
}
