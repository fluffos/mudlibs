// longxianyuye.c

#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target)
{
	string msg;

	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("龙现于野只能对战斗中的对手使用。\n");

	if (me->query_skill("staff") < 60)
	{
		return notify_fail("你杖法等级不够\n");
	}

	msg = HIR "$N低呼佛号，内力聚于双臂，手中的"NOR+"$w"+HIR"幻出一条金磷飞龙，闪电般的扑向$n！" NOR;
    me->add("str", 10);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    me->add("str", -10);
	me->start_busy(2);
	return 1;
}
