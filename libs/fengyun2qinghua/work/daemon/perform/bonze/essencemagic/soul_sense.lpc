// soul_sense.c

#include <ansi.h>

inherit SSERVER;

int conjure(object me, object target)
{
	int skill;
	if (me->query_skill("essencemagic",1) < 20)
	{
		return notify_fail("你法术等级不够\n");
	}

	if( me->query_temp("apply/astral_vision") )
		return notify_fail("你已经施展过灵识了。\n");

	if( (int)me->query("atman") < 30 )
		return notify_fail("你的灵力不够。\n");

	skill = me->query_skill("magic");

	me->add("atman", - 30);
	me->receive_damage("sen", 5);

	message_vision(
		HIB "$N微一凝神，施展「灵识」之术。\n" NOR, me);
	tell_room(environment(me),me->query("name")+"眉心一亮，出现了一只天眼！\n");
	me->add_temp("apply/astral_vision", 1);
	me->start_call_out( (: call_other, __FILE__, "remove_effect", me :), skill);

	if( me->is_fighting() ) me->start_busy(3);

	return 1;
}

void remove_effect(object me)
{
	me->add_temp("apply/astral_vision", -1);
	tell_object(me, "你的灵识失效了。\n");
}
