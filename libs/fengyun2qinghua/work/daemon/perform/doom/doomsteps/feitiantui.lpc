// feitiantui.c

#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target)
{
	string msg;

	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("飞天腿只能对战斗中的对手使用。\n");

	msg = HIR "$N身形突然纵起，双腿从意想不到的角度向$n连环踢出！" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg, "瘀伤");
	me->start_busy(2);
	return 1;
}
