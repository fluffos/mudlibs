// iceshock.c

#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration)
{
    object *inv;
    int i;
	me->receive_damage("gin", 19);
	me->receive_damage("kee", 19);
	me->receive_damage("sen", 19);
    me->receive_wound("gin", 19);
    me->receive_wound("kee", 19);
    me->receive_wound("sen", 19);

	me->apply_condition("bixue_poison", duration - 1);

	tell_object(me, "你中的"+HIG"碧血蛊"NOR+"发作了。\n" NOR );

	if( duration < 1 ) return 0;

	return CND_CONTINUE;
}
