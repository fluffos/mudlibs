// iceshock.c

#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration)
{
    object *inv;
    int i;
	me->receive_damage("sen", 5);

	me->apply_condition("hualiu_poison", duration - 1);

	tell_object(me, HIB "你觉得浑身又疼又痒。\n" NOR );
    message("vision", me->name() + "痛苦的呻吟着，看来是花柳病发作了。。。\n" , environment(me), me);

	if( duration < 1 ) return 0;

	return CND_CONTINUE;
}
