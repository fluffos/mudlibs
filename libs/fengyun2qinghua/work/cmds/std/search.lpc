// search.c

inherit F_CLEAN_UP;
int search_room_item(object me, string arg);

int main(object me, string arg)
{
	object obj;
	int result;
	if(!arg)return notify_fail("你找了又找，但是啥也没找到。\n");
    result = search_room_item(me, arg);
    return result;
}

int search_room_item(object me, string arg)
{
	object env;
	mapping item, exits;

	if( !objectp(env = environment(me)) )
		return notify_fail("这里只有灰蒙蒙地一片，什麽也没有。\n");

	if( mapp(item = env->query("search_desc")) && !undefinedp(item[arg]) ) {
		if( stringp(item[arg]) )
			write(item[arg]);
		else if( functionp(item[arg]) )
			write((string)(*item[arg])(me));
		return 1;
	}
	return notify_fail("你找了又找，但是啥也没找到。\n");
}
