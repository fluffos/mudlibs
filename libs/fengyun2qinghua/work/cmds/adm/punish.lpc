#include <ansi.h>
inherit F_CLEAN_UP;
int main(object me, string arg)
{
    string key, chinz;
    string classd;

    seteuid(geteuid());
    if( !arg || arg=="" )
        return notify_fail("指令格式：punish <受罚者> <刑罚>\n");

    if(sscanf(arg,"%s %s",classd,key)==2){
        switch(key)
        {
        case "no_call" :
            PUNISH_D->add_translate(classd,key,"no_call");
            break;
        default :
            return notify_fail("没有这种刑罚。\n");
        }
        
        return 1;
    }
	

    return 0;
}

int help()
{
    write ( @HELP
指令格式：punish <受罚者> <处罚>

HELP
    );
    return 1 ;
}
