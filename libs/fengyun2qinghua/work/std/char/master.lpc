#include <dbase.h>
#include <login.h>
#include <ansi.h>
#include <localtime.h>
int time_period(int timep, object me);
int give_quest(string arg);

int prevent_learn(object me, string skill)
{
        int betrayer;
	int level;
	int i;

	i=this_object()->query("nobetray");
	if (i!=0)
	{
		return 0;
	}
	level=this_object()->query_skill(skill, 1);
	level=level+ this_object()->query("xinzhi")*me->query("score")/5000;
        if (betrayer = me->query("betrayer")) {
                if( me->query_skill(skill, 1) >=level
- betrayer * 20 ) {
                        
message_vision("$N神色间似乎对$n不是十分信任，也许是想起$p从前背叛师门的事情 
...。\n",
                                this_object(), me );
                        command("say 嗯 .... 
师父能教你的都教了，其他的你自己练吧。");
                        return 1;
                }
        }

        if( !me->is_apprentice_of(this_object())
        &&      (int)this_object()->query_skill(skill, 1) <= 
(int)me->query_skill(skill, 1) * 3 ) {
                command("hmm");
                command("pat " + me->query("id"));
                command("say 虽然你是我门下的弟子，可是并非我的嫡传弟子 
....");
                command("say 
我只能教你这些粗浅的本门功夫，其他的还是去找你师父学吧。");
                return 1;
        }

        return 0;
}

int prevent_in(object ob)
{
	object me;
	int xinzhi,score;

	me=this_object();
	score=ob->query("score");
	score=score*(me->query("xinzhi"));
	if (score<0)
	{
		if (random(score/(-50))>50)
		{
			me->kill_ob(ob);
		}
	}
	return 1;
}
 
int give_quest(string arg)
{
	mapping quest ;
	object me;
	int j, combatexp, timep,factor,num;
    int quest_level;
  	mixed *local;
	string tag = "5187000";
    string *levels = ({
                        "0",
                        "4000",
                        "8000",
                        "16000",
                        "32000",
                        "64000",
                        "128000",
                        "256000",
                        "512000",
                        "1024000",
                        "1536000",
                        "2304000",
                        "3456000",
                        "5187000"
        });
    local = localtime(time() * 60-890000000);
   // if(((local[LT_HOUR]+1)%24)/2 < 3 || ((local[LT_HOUR]+1)%24)/2 > 10)
    //{
   // write("夜深了，还要什么任务！！\n");
   // return 1;
   // }
    if( ! arg )quest_level = 0;
    else quest_level = atoi (arg);
    if(quest_level < 0)quest_level = 0;
	me = this_player();
// Let's see if this player still carries an un-expired task
        if((quest =  me->query("quest")))
	{
	if( ((int) me->query("task_time")) >  time() )
		return 0;
	else
	{
		message_vision("$n向$N一甩袍袖，说道： 
真没用！不过看在你还回来见老夫的份上，就再给你一次机会．\n", me, this_object());
		me->set("kee", me->query("kee")/2+1);
        me->set_temp("quest_number", 0);
	}
	}
	combatexp = (int) me->query("combat_exp");
        for(j= sizeof(levels) - 1 ; j>=0; j--)
        {
                if( atoi(levels[j])  <= combatexp )
                        {
//                                tag = levels[j];
				num=j;
				factor=10;					
                                break;
                        }
        }
	if (num>0)
	{
		if (random(50+me->query_kar())>65)
		{
			num=num-1;
		}
	} else {
		if ((num<sizeof(levels)-1)&&(random(100)>95))
		{
			num=num+1;
			factor=15;
		}
	}
    num += quest_level;
	if (num > (sizeof(levels) - 1)) num=sizeof(levels) - 1;
    
	tag=levels[num];			
	quest = QUEST_D(tag)->query_quest();
	timep = quest["time"];	
	time_period(timep, me);
	if (quest["quest_type"] == "寻")
	{
        tell_object(me,"找回『"+quest["quest"]+"』给天机老人。\n" NOR);
	}
	        if (quest["quest_type"] == "杀")
        {
        tell_object(me,"替我杀了『"+quest["quest"]+"』。\n" NOR);
        }
        quest["exp_bonus"]=quest["exp_bonus"];
        quest["pot_bonus"]=quest["pot_bonus"];
        quest["score"]=quest["score"];

 	me->set("quest", quest);
	me->set("task_time", (int) time()+(int) quest["time"]);
	me->set("quest_factor",factor);
    if(!me->query_temp("quest_number"))
    me->set_temp("quest_number", 0);
    
return 1;
}

int time_period(int timep, object me)
{
        int t, d, h, m, s;
        string time;
        t = timep;
        s = t % 60;             t /= 60;
        m = t % 60;             t /= 60;
        h = t % 24;             t /= 24;
        d = t;

        if(d) time = chinese_number(d) + "天";
        else time = "";

        if(h) time += chinese_number(h) + "小时";
        if(m) time += chinese_number(m) + "分";
        time += chinese_number(s) + "秒";

        tell_object(me,this_object()->name()+"沉思了一会儿，说道：\n请在" + time + "内");
        return 1;
}
