// cloth.c
//
// This is the basic equip for players just login.

#include <weapon.h>

inherit SWORD;

void create()
{
     set_name("[1;34m断欲剑[2;37;0m", ({ "dysword" }) );
     set_weight(7000);
     set("no_get",1);
     set("no_drop",1);
	if( clonep() )
                set_default_object(__FILE__);
    else {
     set("unit", "把");
     set("material", "steel");
     set("owner", "boy");
     set("ji_gold", 8);
     set("wield_msg", "$N「唰」地一声抽出一把$n握在手中。\n");
     set("unwield_msg", "$N将手中的$n插入腰间的剑鞘。\n");
     init_sword(33);
     set("long",@LONG
这是一把黑黝黝的长剑，看上去不是很锋利。
LONG        );
        }
        setup();
}




