// hat.c

inherit EQUIP;

void create()
{
	set_name("[34m蓝雪帽[2;37;0m", ({ "bluemao" }) );
	set_weight(300);
    set("no_drop", 1);
    set("no_get", 1);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "顶");
		set("long", 
"一定自制的帽子，看上去华丽非常。\n");
		set("material", "cloth");
		set("armor_type", "head");
		set("armor_prop/armor", 14);
        set("bu_gold", 16);
        set("owner", "blue");
	}
}
