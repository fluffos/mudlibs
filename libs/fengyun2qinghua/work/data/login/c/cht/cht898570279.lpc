
#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("[1;33m御赐黄马褂[2;37;0m", ({ "suit" }) );
	set_weight(3000);
    set("no_drop", 1);
    set("no_get", 1);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("long", 
"一件自制的衣服，看上去华丽非常。\n");
		set("material", "cloth");
		set("armor_prop/armor", 18);
        set("bu_gold", 256);
        set("owner", "cht");
	}
	setup();
}
