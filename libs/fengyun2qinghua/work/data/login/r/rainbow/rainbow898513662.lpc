#include <armor.h>

inherit CLOTH;

void create() {
  set_name("[1;33m彩虹衫[2;37;0m", ({ "mycloth" }));
  set_weight(3000);
  set("no_drop", 1);
  set("no_get", 1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long",
      "一件自制的衣服，看上去华丽非常。\n");
    set("material", "cloth");
    set("armor_prop/armor", 25);
    set("bu_gold", 4096);
    set("owner", "rainbow");
  }
  setup();
}
