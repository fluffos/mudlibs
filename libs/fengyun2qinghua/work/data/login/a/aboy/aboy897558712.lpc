// hat.c

inherit EQUIP;

void create()
{
	set_name("[33m七星翻云靴[2;37;0m", ({ "xie" }) );
	set_weight(1000);
    set("no_drop", 1);
    set("no_get", 1);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "双");
		set("long", 
"一双自制的布鞋，看上去华丽非常。\n");
		set("material", "cloth");
		set("armor_type", "boots");
		set("armor_prop/armor", 16);
        set("bu_gold", 64);
        set("owner", "aboy");
	}
}
