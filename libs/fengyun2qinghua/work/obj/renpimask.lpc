// mask.c
//

inherit EQUIP;

void create() {
  set_name("人皮面具", ({ "mask" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("material", "skin");
    set("long", "这似乎是一张由人皮制成的面具。\n");
    set("armor_prop/armor", 1);
    set("armor_type", "face");
  }
  setup();
}
