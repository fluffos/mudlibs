// waiter.c
#include <ansi.h>
inherit NPC;

void create() {
  set_name("老板娘", ({ "boss" }));
  set("gender", "女性");
  set("age", 52);
  set("str", 200);
  set("long",
    "老板娘善长补衣服，补出来的衣服又牢固而且不难看。\n");
  set("combat_exp", 500);
  set("attitude", "friendly");
  setup();
  carry_object("/obj/cloth")->wear();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
  add_action("do_bu", "bu");
}

int do_bu(string arg) {
  int oldarmor, newarmor, oldgold, newgold;
  object ob, me, gold, newob;
  string newfile, filename, id;
  string old_str, new_str;
  me = this_player();
  id = me->query("id");
  if (!arg)
    return notify_fail("指令格式：bu <English name>。\n");
  if (me->is_busy())
    return notify_fail("你上一个动作还没有完成。\n");
  if (!objectp(ob = present(arg, me)))
    return notify_fail("你身上没有这样东西。\n");
  if (ob->query("equipped"))
    return notify_fail("你还穿着这样东西呢，怎么补呐。\n");
  if (!ob->query("bu_gold"))
    return notify_fail("这样东西不能补。\n");
  if (id != ob->query("owner"))
    return notify_fail("这样东西不是你的，你不可以补它。\n");
  gold = present("gold_money", this_player());
  if (!gold) return notify_fail("你身上没有金子。\n");
  if ((int)gold->query_amount() < ob->query("bu_gold"))
    return notify_fail("你身上没有那麽多金子。\n");
  oldarmor = ob->query("armor_prop/armor") - 9;
  oldgold = ob->query("bu_gold");
  newgold = oldgold * 2;
  newarmor = (int)(oldarmor / 10 + 1);
  filename = base_name(ob) + ".lpc";
  old_str = sprintf("set(\"bu_gold\", %d)", oldgold);
  new_str = sprintf("set(\"bu_gold\", %d)", newgold);
  newfile = read_file(filename);
  newfile = replace_string(newfile, old_str, new_str);
  old_str = sprintf("set(\"armor_prop/armor\", %d", oldarmor + 9);
  new_str = sprintf("set(\"armor_prop/armor\", %d", newarmor + oldarmor + 9);
  newfile = replace_string(newfile, old_str, new_str);
  gold->add_amount(-ob->query("bu_gold"));
  write("老板娘拿出针线在" + ob->query("name") + "上缝补了一会，说：这下结实了！\n");
  seteuid(ROOT_UID);
  rm(filename);
  destruct(ob);
  seteuid(getuid());
  filename = DATA_DIR + "login/" + id[0..0] + "/" + id + "/" + id + sprintf("%d", time()) + ".lpc";
  if (!write_file(filename, newfile, 1))
    return 0;
  newob = new(filename);
  if (newob->move(me)) {
    //	if (file_size(newob->query_save_file())>0) newob->restore();
    me->start_busy(1);
    return 1;
  }
  return 0;
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(3)) {
    case 0:
      say("老板娘说道：这位" + RANK_D->query_respect(ob)
        + "，你的衣衫都被人砍破了，来补一下吧。\n");
      break;
  }
}
