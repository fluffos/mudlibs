// cloth.c
//
// This is the basic equip for players just login.

#include <weapon.h>

inherit STAFF;

void create()
{
     set_name("订做的", ({ "order" }) );
     set_weight(10000);
     set("no_get",1);
     set("no_drop",1);
	if( clonep() )
                set_default_object(__FILE__);
    else {
     set("unit", "根");
     set("material", "steel");
     set("owner", "qiqi");
     set("ji_gold", 1);
     set("wield_msg", "$N把$n紧紧地握在手中。\n");
     set("unwield_msg", "$N松开了手中的$n。\n");
     init_staff(30);
     set("long",@LONG
这是一根相当普通的禅杖，看起来十分沉重。
LONG        );
        }
        setup();
}



