// waiter.c
#include <ansi.h>
inherit NPC;

void create() {
  set_name("樊夫人", ({ "furen" }));
  set("gender", "男性");
  set("age", 52);
  set("str", 200);
  set("long",
    "樊夫人是一个满面烟火的老道士，传说他原本是三清宫的火工头，后
来得罪了掌门而被开革出派，他的铸造技术是一流的。\n");
  set("combat_exp", 100000);
  set("attitude", "friendly");
  setup();
  carry_object("/obj/cloth")->wear();
}

void init() {
  add_action("do_ji", "ji");
}

int do_ji(string arg) {
  int olddamage, newdamage, oldgold, newgold;
  object ob, me, gold, newob;
  string newfile, filename, id;
  string old_str, new_str;
  me = this_player();
  id = me->query("id");
  if (!arg)
    return notify_fail("指令格式：ji <English name>。\n");
  if (me->is_busy())
    return notify_fail("你上一个动作还没有完成。\n");
  if (!objectp(ob = present(arg, me)))
    return notify_fail("你身上没有这样东西。\n");
  if (ob->query("equipped"))
    return notify_fail("你还带着这样东西呢，怎么祭呐。\n");
  if (!ob->query("ji_gold"))
    return notify_fail("这样东西不能祭。\n");
  if (id != ob->query("owner"))
    return notify_fail("这样东西不是你的，你不可以祭它。\n");
  gold = present("gold_money", this_player());
  if (!gold) return notify_fail("你身上没有金子。\n");
  if ((int)gold->query_amount() < ob->query("ji_gold"))
    return notify_fail("你身上没有那麽多金子。\n");
  olddamage = ob->query("weapon_prop/damage") - 29;
  oldgold = ob->query("ji_gold");
  newgold = oldgold * 2;
  newdamage = (int)(olddamage / 4 + 1);
  filename = base_name(ob) + ".lpc";
  old_str = sprintf("set(\"ji_gold\", %d)", oldgold);
  new_str = sprintf("set(\"ji_gold\", %d)", newgold);
  newfile = read_file(filename);
  newfile = replace_string(newfile, old_str, new_str);
  switch (ob->query("skill_type")) {
    case "axe":
      old_str = sprintf("init_axe(%d", olddamage + 29);
      new_str = sprintf("init_axe(%d", newdamage + olddamage + 29);
      break;
    case "blade":
      old_str = sprintf("init_blade(%d", olddamage + 29);
      new_str = sprintf("init_blade(%d", newdamage + olddamage + 29);
      break;
    case "dagger":
      old_str = sprintf("init_dagger(%d", olddamage + 29);
      new_str = sprintf("init_dagger(%d", newdamage + olddamage + 29);
      break;
    case "fork":
      old_str = sprintf("init_fork(%d", olddamage + 29);
      new_str = sprintf("init_fork(%d", newdamage + olddamage + 29);
      break;
    case "hammer":
      old_str = sprintf("init_hammer(%d", olddamage + 29);
      new_str = sprintf("init_hammer(%d", newdamage + olddamage + 29);
      break;
    case "staff":
      old_str = sprintf("init_staff(%d", olddamage + 29);
      new_str = sprintf("init_staff(%d", newdamage + olddamage + 29);
      break;
    case "sword":
      old_str = sprintf("init_sword(%d", olddamage + 29);
      new_str = sprintf("init_sword(%d", newdamage + olddamage + 29);
      break;
    case "whip":
      old_str = sprintf("init_whip(%d", olddamage + 29);
      new_str = sprintf("init_whip(%d", newdamage + olddamage + 29);
      break;
    default:
      return notify_fail("这里不会祭你的东西．\n");
  }
  newfile = replace_string(newfile, old_str, new_str);
  gold->add_amount(-ob->query("ji_gold"));
  write("樊夫人向" + ob->query("name") + "上吐了一口带血的唾沫，说道：好了！\n");
  seteuid(ROOT_UID);
  rm(filename);
  destruct(ob);
  seteuid(getuid());
  filename = DATA_DIR + "login/" + id[0..0] + "/" + id + "/" + id + sprintf("%d", time()) + ".lpc";
  if (!write_file(filename, newfile, 1))
    return 0;
  newob = new(filename);
  if (newob->move(me)) {
    //	if (file_size(newob->query_save_file())>0) newob->restore();
    me->start_busy(1);
    return 1;
  }
  return 0;
}
