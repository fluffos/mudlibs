#include <inherit.h>
#include <ansi.h>

inherit STANDARD_OBJECT;

void create()
{
	set_idname("bamboo rod", "竹製釣竿" );

	if( this_object()->set_shadow_ob() ) return;

	set("long", "這根竹製釣竿似乎跟平常的竹製釣竿不同。");
        set("unit", "根");
        set("value", -1);
        set("mass", 200);
        set("rod_level", 50);
        set("level", 10);
        set("flag/no_amount", 1);
        set("badsell", 1);

}
