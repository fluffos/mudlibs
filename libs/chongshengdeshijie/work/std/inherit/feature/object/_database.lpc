// 長存資料庫
private mapping database = allocate_mapping(0);
// 暫存資料庫
private nosave mapping temp_database = allocate_mapping(0);

/* -----------------------------------------------------------------
 * set()/query()/set_temp()/query_temp()/addn()/addn_temp()/delete()/
 * delete_temp() 原本是這個 mudlib 的原始驅動程式 (MudOS + 自訂
 * database package, 見 /doc/driver/modify/source_files/packages/
 * database.c) 內建的 EFUN, 直接以 C 層級尋找呼叫者物件一個名為
 * "database"/"temp_database" 的全域 mapping 變數來存取, 完全不需
 * 要任何 LPC 端的程式碼。FluffOS 沒有這個 package, 這些名稱在這個
 * 驅動程式上完全不存在, 整個 mudlib 有數千個呼叫點依賴它們。
 *
 * 這裡在 STANDARD_OBJECT 唯一 inherit 的 DATABASE 本檔中重新以純
 * LPC 實作相同語意 (巢狀路徑存取、選擇性的第三參數 object 轉向、
 * query() 的 shadow_ob 轉向), 讓每個繼承 STANDARD_OBJECT 的物件都
 * 有自己真正獨立的 database/temp_database 存放區, 而不是誤把
 * this_object() 這個物件自己以外的東西當成儲存目標 (見 AGENTS.md
 * §15 的 F_DBASE 陷阱)。少數不繼承本檔的特例 (如 login_ob.lpc)
 * 一律改為直接 inherit DATABASE, 而非另外宣告一份 database 變數,
 * 以便使用同一份實作。
 * -----------------------------------------------------------------
 */

/* 把路徑字串依 "/" 切開, 過濾掉因連續 "/" 造成的空字串區段 */
private string *db_split_path(string path) {
  if (!stringp(path) || !strlen(path)) return ({});

  return filter_array(explode(path, "/"), (: strlen($1) > 0 :));
}

/* 依路徑陣列在巢狀 mapping 裡查詢, 找不到回傳 0 */
private mixed db_nested_query(mapping map, string *parts) {
  mixed value = map;
  int i;

  for (i = 0; i < sizeof(parts); i++) {
    if (!mapp(value)) return 0;
    value = value[parts[i]];
  }

  return value;
}

/* 依路徑陣列在巢狀 mapping 裡設值, 中間路徑不存在時自動建立子 mapping */
private void db_nested_set(mapping map, string *parts, mixed value) {
  mixed sub;
  int i;

  for (i = 0; i < sizeof(parts) - 1; i++) {
    sub = map[parts[i]];
    if (!mapp(sub)) {
      sub = ([]);
      map[parts[i]] = sub;
    }
    map = sub;
  }

  map[parts[<1]] = value;
}

/* 依路徑陣列在巢狀 mapping 裡刪除該 key, 中間路徑不存在時直接不動作 */
private void db_nested_delete(mapping map, string *parts) {
  mixed sub;
  int i;

  for (i = 0; i < sizeof(parts) - 1; i++) {
    sub = map[parts[i]];
    if (!mapp(sub)) return;
    map = sub;
  }

  map_delete(map, parts[<1]);
}

varargs mixed set(string path, mixed value, object ob) {
  string *parts;

  if (objectp(ob) && ob != this_object())
    return ob->set(path, value);

  parts = db_split_path(path);
  if (!sizeof(parts)) return value;

  db_nested_set(database, parts, value);

  return value;
}

varargs mixed query(string path, object ob) {
  string *parts;
  mixed shadow;

  if (objectp(ob) && ob != this_object())
    return ob->query(path);

  shadow = database["shadow_ob"];
  if (objectp(shadow) && shadow != this_object())
    return shadow->query(path);

  parts = db_split_path(path);
  if (!sizeof(parts)) return 0;

  return db_nested_query(database, parts);
}

varargs mixed set_temp(string path, mixed value, object ob) {
  string *parts;

  if (objectp(ob) && ob != this_object())
    return ob->set_temp(path, value);

  parts = db_split_path(path);
  if (!sizeof(parts)) return value;

  db_nested_set(temp_database, parts, value);

  return value;
}

varargs mixed query_temp(string path, object ob) {
  string *parts;

  if (objectp(ob) && ob != this_object())
    return ob->query_temp(path);

  parts = db_split_path(path);
  if (!sizeof(parts)) return 0;

  return db_nested_query(temp_database, parts);
}

varargs mixed addn(string path, int delta, object ob) {
  string *parts;
  mixed cur;

  if (objectp(ob) && ob != this_object())
    return ob->addn(path, delta);

  parts = db_split_path(path);
  if (!sizeof(parts)) return delta;

  cur = db_nested_query(database, parts);
  if (!intp(cur)) cur = 0;
  cur += delta;

  db_nested_set(database, parts, cur);

  return cur;
}

varargs mixed addn_temp(string path, int delta, object ob) {
  string *parts;
  mixed cur;

  if (objectp(ob) && ob != this_object())
    return ob->addn_temp(path, delta);

  parts = db_split_path(path);
  if (!sizeof(parts)) return delta;

  cur = db_nested_query(temp_database, parts);
  if (!intp(cur)) cur = 0;
  cur += delta;

  db_nested_set(temp_database, parts, cur);

  return cur;
}

varargs void delete(string path, object ob) {
  string *parts;

  if (objectp(ob) && ob != this_object()) {
    ob->delete(path);
    return;
  }

  parts = db_split_path(path);
  if (!sizeof(parts)) return;

  db_nested_delete(database, parts);
}

varargs void delete_temp(string path, object ob) {
  string *parts;

  if (objectp(ob) && ob != this_object()) {
    ob->delete_temp(path);
    return;
  }

  parts = db_split_path(path);
  if (!sizeof(parts)) return;

  db_nested_delete(temp_database, parts);
}

/* 部分物件 (如 system/object/login_ob.lpc, 在 STANDARD_OBJECT 的一般
 * inherit 鏈之外自成一格) 需要在自己的 create() 之外被別的物件用
 * call_other 重設資料庫, 而不是直接碰觸 (私有的) database/temp_database
 * 變數本身 -- 統一在這裡提供。 */
void reset_database() {
  database = allocate_mapping(0);
  temp_database = allocate_mapping(0);
}

mapping query_database() {
  return copy(database);
}

mapping query_temp_database() {
  return copy(temp_database);
}

void set_temp_database(mapping tdb) {
  if (!mapp(tdb)) return;

  temp_database = copy(tdb);
}

varargs int set_shadow_ob(object ob) {
  if (clonep()) {
    set("shadow_ob", ob || load_object(base_name(this_object())));
    return 1;
  }
  return 0;
}

object query_shadow_ob() {
  return database["shadow_ob"];
}
