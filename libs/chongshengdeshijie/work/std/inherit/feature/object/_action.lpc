mapping query_actions() {
  mapping m;

  // Defensive: not every object inheriting this feature actually declares
  // an `actions` global (e.g. BULLETIN_BOARD) -- fetch_variable() throws
  // "Variable named 'actions' does not exist or is not visible" on those,
  // which broke every command evaluated in a room containing such an
  // object (first surfaced on the wizard-hall boards when the seeded
  // admin account logged in). Absent variable => no actions. Checked via
  // variables() first so nothing is thrown (the master error handler
  // reports even caught errors to wizards); catch() kept as a fallback
  // for the private-variable "not visible" case.
  if (member_array("actions", variables(this_object())) == -1)
    return 0;
  if (catch(m = fetch_variable("actions")))
    return 0;
  if (!mapp(m))
    return 0;
  return copy(m);
}
