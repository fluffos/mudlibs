#include <object.h>

//-----------------------------------------------------------------------------

#include "master/flag.lpc";/* 用來 Debug , 平時無需載入 */
#include "master/compile_object.lpc";/* 用來載入 MudOS 虛擬物件 */
#include "master/crash.lpc";/* 用來處理 Crash 時的緊急情況 */
#include "master/preload.lpc";/* 預先載入初始化動作 */
#include "master/error.lpc";/* 處理錯誤訊息的函式 */
#include "master/file.lpc";/* 關於 domain_file , author_file , privs_file */
#include "master/ed.lpc";/* 有關 Edit 的一些設定 */
#include "master/parse.lpc";/* 文法(對中文Mud而言似乎沒有用處?) */
#include "master/object.lpc";/* 環境遭到毀滅時, 所有內在物件都會呼叫此函式 */

//-----------------------------------------------------------------------------

#include "master/valid_asm.lpc";
#include "master/valid_author.lpc";
#include "master/valid_bind.lpc";/* 檢查函式指標與物件的結合 */
#include "master/valid_compile_to_c.lpc";/* 判斷是否可以用 LPC->C 編譯 */
#include "master/valid_domain.lpc";
#include "master/valid_hide.lpc";/* 檢查匿蹤能力 */
#include "master/valid_link.lpc";/* 控制 link 外部函式的用途 */
#include "master/valid_object.lpc";/* 讓你能控制是否要載入某個物件 */
#include "master/valid_override.lpc";/* 控制 efun:: 的用途 */
#include "master/valid_readwrite.lpc";/* 檢查是否有權讀取寫入檔案 */
#include "master/valid_save_binary.lpc";/* 控制一個物件是否可以儲存它已載入的程式 */
#include "master/valid_shadow.lpc";/* 控制哪些物件可以被投影 */
#include "master/valid_socket.lpc";/* 保護 socket 外部函式 */
#include "master/valid_database.lpc";

//-----------------------------------------------------------------------------

/* 這個驅動程式編譯時開啟 PACKAGE_UIDS，set_master() 要求
 * master::get_root_uid()/master::get_bb_uid() 一定要存在並回傳一個
 * uid 字串，否則直接 exit(-1)。這個 lib 原本沒有 uid package 的概念
 * (原始 MudOS build 沒開這個選項)，這裡補上最小可用的實作。
 * 見 AGENTS.md §7。*/
string get_root_uid() { return "ROOT"; }
string get_bb_uid() { return "ROOT"; }

/* 回傳連線物件 */
//        connect() 傳回的物件，會當作初始使用者物件 (initial user object)。
//        請注意，之後你可以使用 exec() 外部函式將改變使用者物件。

private object connect(int port) {
  object ob;

  if (!catch(ob = new(LOGIN_OB)))
    return ob;
  else
    printf("\n登錄程式正在修改中，請稍後再試。\n\n");
}

private void create() {
  printf("Master Object(/system/kernel/master.c) 載入成功\n");
}
