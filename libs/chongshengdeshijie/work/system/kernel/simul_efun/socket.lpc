// socket_status() is only defined when the driver is built with the
// sockets package (WASM builds are not -- AGENTS.md 1.3c); referencing
// it here unconditionally is a COMPILE-time "Undefined function" error,
// and because this file is #included directly into simul_efun.lpc, that
// error takes down the whole simul_efun object and the entire boot, not
// just this one debug command. dump_socket_status() is an admin-only
// diagnostic (no other code in the mudlib calls it) with no plain-LPC
// equivalent, so it is stubbed rather than reimplemented.
string dump_socket_status() {
#ifdef __WASM__
  return "socket_status() unavailable: WASM builds have no sockets package.\n";
#else
  string ret = @END
Fd    State      Mode       Local Address          Remote Address            Owner
--  ---------  --------  ---------------------  ---------------------  ---------------------
END;
  foreach (mixed *item in socket_status()) {
    ret += sprintf("%2d  %|9s  %|8s  %-21s  %-21s  %O\n",
      item[0], item[1], item[2], item[3], item[4], item[5]);
  }
  return ret;
#endif
}
