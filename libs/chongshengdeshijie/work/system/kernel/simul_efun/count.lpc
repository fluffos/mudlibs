/* This program is a part of RW mudlib
 -----------------------------------------
 * File   : count.lpc
 * Note   : count(n1, operator, n2) was originally a real driver EFUN (a
 *          bespoke "arith_operator" package -- see /doc/driver/modify/
 *          source_files/packages/arith_operator.c) providing arbitrary-
 *          precision (string-based) big-number arithmetic/comparison for
 *          currency and quantity math throughout this lib (300+ call
 *          sites: +, -, *, /, <, >, <=, >=, ==). FluffOS has no such
 *          package. Per AGENTS.md §15v, restore using ordinary native int
 *          arithmetic (this driver's int is wide enough for every value
 *          actually seen in this lib's economy) rather than reimplementing
 *          full bignum support -- simpler and sufficient in practice;
 *          only worth revisiting if some content genuinely needs values
 *          beyond int range.
 -----------------------------------------
 */

private int count_coerce(mixed n)
{
	if( intp(n) ) return n;
	if( floatp(n) ) return to_int(n);
	if( stringp(n) ) return to_int(n);

	return 0;
}

mixed count(mixed n1, string op, mixed n2)
{
	int a = count_coerce(n1);
	int b = count_coerce(n2);

	switch(op)
	{
		case "+":	return a + b;
		case "-":	return a - b;
		case "*":	return a * b;
		case "/":	return b ? a / b : 0;
		case "<":	return a < b;
		case ">":	return a > b;
		case "<=":	return a <= b;
		case ">=":	return a >= b;
		case "==":	return a == b;
	}

	return 0;
}
