"e"	:	1,
"z"	:	2,
"c"	:	3,
"w"	:	4,
"x"	:	4,
"a"	:	5,
"d"	:	5,
]);

mapping walls = ([
1	:	({ "╭","╮","╰","╯","─","│" }),
2	:	({ "╒","╕","╘","╛","═","│" }),
3	:	({ "╓","╖","╙","╜","─","║" }),
4	:	({ "┌","┐","└","┘","─","│" }),
5	:	({ "╔","╗","╚","╝","═","║" }),
]);

mapping doors = ([
6	:	({ "∥", 	"直門" }),
7	:	({ "＝", 	"橫門" }),
]);

mapping sceneries = ([
10	:	({ HIY"Γ"NOR, 		"路燈", ([METAL	:20, STONE:10, WOOD:5	]) }),
11	:	({ HIC"⊙"NOR, 		"水池", ([WATER	:50, STONE:20		]) }),
12	:	({ HIW"☆"NOR, 		"涼亭", ([WOOD	:15, STONE:15		]) }),
13	:	({ HIG"￥"NOR, 		"大樹", ([WATER	:30, WOOD:20		]) }),
14	:	({ NOR GRN"ω"NOR, 	"草皮", ([WATER	:15, WOOD:10		]) }),
15	:	({ HIM"〥"NOR, 		"雕像", ([STONE	:40, METAL:20		]) }),
]);

mapping others = ([
50	:	({ HIG BGRN"〃"NOR,	"農田",	([WOOD:20			]) }),
51	:	({ HIY BYEL"〃"NOR,	"牧場",	([WOOD:20			]) }),
52	:	({ HIB BBLU"〃"NOR,	"養殖場",([WOOD:20			]) }),
]);
void select_icon(object me, string arg);


void do_build(object me, object material, mixed * building_info, int type)
{

	int str_cost;
	int num;
	string mtr_name;
	mapping mtr_exerted = allocate_mapping(0);
	mapping mtr_ingredient;
	mixed * loc = query_temp("location", me);


	if( CITY_D->query_coor_data(loc, TYPE) )
	{
		tell(me, "這塊土地上已經有建物了，無法再次建造，除非"+pnoun(2, me)+"先拆除掉現有的建物。\n");
		tell(me, "\n輸入數字選項與使用的材料(例 2a by stone)，"HIW"ls"NOR" 顯示列表：\n");
		input_to((: select_icon, me :));
		return;
	}

	if( !objectp(material) )
	{
		if( !mapp(building_info[MTR_ELEM]) )
		{
			if( !me->cost_stamina(300) )
			{
				tell(me, "\n"+pnoun(2, me)+"已經沒有體力建造東西了。\n");
				return me->finish_input();
			}
			
			CITY_D->set_coor_data(loc, TYPE, type);
			CITY_D->set_coor_icon(loc, building_info[ICON_ELEM]);
		
			// 刪除 material 資訊
			CITY_D->delete_coor_data(loc, "material");

			tell(me, "耗費了 300 點體力，"HIG"["+me->query_stamina_cur()+"/"+me->query_stamina_max()+"]"NOR"。\n");
			msg("$ME成功地在這塊土地上建造了「"+building_info[NAME_ELEM]+" "+building_info[ICON_ELEM]+"」。\n",me,0,1);
			me->add_social_exp(30+random(51));
			
			tell(me, "\n輸入數字選項與使用的材料(例 2a by stone)，"HIW"ls"NOR" 顯示列表：\n");
			input_to((: select_icon, me :));
			return;
		}
		else
		{
			foreach( mtr_name, num in building_info[MTR_ELEM] )
				mtr_exerted[mtr_name] = CITY_D->query_coor_data(loc, "material/"+mtr_name);
	
			tell(me, "材料不足，建造「"+building_info[NAME_ELEM]+" "+building_info[ICON_ELEM]+"」需要"+MATERIAL_D->material_required_info(building_info[MTR_ELEM])+"，目前完成度 "+MATERIAL_D->material_percentage(building_info[MTR_ELEM], mtr_exerted)+"。\n\n");
			return me->finish_input();
		}
	}
	else
		mtr_ingredient = query("material", material);

	if( !mapp(mtr_ingredient) )
	{
		tell(me, material->query_idname()+"已經損壞了。\n");
		return me->finish_input();
	}

	if( sizeof(keys(mtr_ingredient) - keys(building_info[MTR_ELEM])) == sizeof(keys(mtr_ingredient)) )
	{
		tell(me, material->query_idname()+"不適合用來建造此建築物。\n");
		return me->finish_input();
	}
		
	foreach( mtr_name, num in building_info[MTR_ELEM] )
	{
		if( !me->cost_stamina(mtr_ingredient[mtr_name]*50) )
		{
			tell(me, "\n"+pnoun(2, me)+"已經沒有體力建造東西了。\n");
			return me->finish_input();
		}
		
		mtr_exerted[mtr_name] = CITY_D->add_coor_data(loc, "material/"+mtr_name, mtr_ingredient[mtr_name]);

		// 每單位的材料會耗費 50 點體力
		str_cost += mtr_ingredient[mtr_name]*50;
	}

	tell(me, "耗費了 "+str_cost+" 點體力，"HIG"["+me->query_stamina_cur()+"/"+me->query_stamina_max()+"]"NOR"。\n");

	me->add_social_exp(str_cost/10+random(31));
	msg("$ME利用"+material->query_idname()+"作為材料在這塊土地上建造「"+building_info[NAME_ELEM]+" "+building_info[ICON_ELEM]+"」，目前已完成："+MATERIAL_D->material_percentage(building_info[MTR_ELEM], mtr_exerted)+"。\n",me,0,1);
	
	destruct(material ,1);

	if( MATERIAL_D->is_accomplished(building_info[MTR_ELEM], mtr_exerted) )
	{
		msg("\n$ME所建造的「"+building_info[NAME_ELEM]+" "+building_info[ICON_ELEM]+"」完工了，請大家拍手鼓勵鼓勵！\n", me, 0, 1);

		BUILDING_D->materialize_outdoor_building(me, CITY_D->query_coor_data(loc, "owner"), loc, building_info[ICON_ELEM], building_info[NAME_ELEM], type);	
		
		me->finish_input();
		return;
	}

	tell(me, "\n輸入數字選項與使用的材料(例 2a by stone)，"HIW"ls"NOR" 顯示列表：\n");
	input_to((: select_icon, me :));
	return;
}

// 建築牆壁
void build_wall(object me, object material, int choice, int wall_type)
{
	if( !objectp(material) )
		do_build(me, material, ({ GRN+walls[choice][wall_type]+NOR, "茅草牆壁", 0}), WALL );
	else
	{
		mapping mtr_ingredient = query("material", material);
		
		if( mapp(mtr_ingredient) && mtr_ingredient[WOOD] )
			do_build(me, material, ({ NOR YEL+walls[choice][wall_type]+NOR, "木板牆壁", ([ WOOD : 10 ]) }), WALL );
		else if( mapp(mtr_ingredient) && mtr_ingredient[STONE] )
			do_build(me, material, ({ NOR +walls[choice][wall_type]+NOR, "石材牆壁", ([ STONE : 30 ]) }), WALL );
		else
		{
			tell(me, material->query_idname()+"並不適合作為牆壁的建材。\n\n");
			me->finish_input();
		}
	}
}

// 建築大門
void build_door(object me, object material, int choice)
{
	if( !objectp(material) )
		do_build(me, material, ({ GRN+doors[choice][0]+NOR, doors[choice][1], 0}), DOOR );
	else
	{
		mapping mtr_ingredient = query("material", material);

		if( mapp(mtr_ingredient) && mtr_ingredient[WOOD] )
			do_build(me, material, ({ NOR YEL+doors[choice][0]+NOR, doors[choice][1], ([ WOOD : 10 ]) }), DOOR );
		else if( mapp(mtr_ingredient) && mtr_ingredient[STONE] )
			do_build(me, material, ({ NOR +doors[choice][0]+NOR, doors[choice][1], ([ STONE : 30 ]) }), DOOR );
		else
		{
			tell(me, material->query_idname()+"並不適合作為門的建材。\n\n");
			me->finish_input();
		}
	}
}

// 建築景觀
void build_scenery(object me, object material, int choice)
{
	string my_id = me->query_id(1);
	string loc_owner = CITY_D->query_coor_data(query_temp("location", me), "owner");

	// 路燈只有政府能蓋
	if( choice == 10 )
	{
		if( !belong_to_government(loc_owner) )
			return tell(me, "這種景觀只能建造在政府土地上。\n");
	}
	else if( loc_owner != my_id && !ENTERPRISE_D->same_enterprise(loc_owner, my_id) )
	{
		tell(me, "這塊地不能建造這類的景觀。\n");
		return me->finish_input();
	}

	switch(choice)
	{
		case 10:
			do_build(me, material, sceneries[choice], LIGHT);
			break;
		case 11:
			do_build(me, material, sceneries[choice], POOL);
			break;
		case 12:
			do_build(me, material, sceneries[choice], PAVILION);
			break;
		case 13:
			do_build(me, material, sceneries[choice], TREE);
			break;
		case 14:
			do_build(me, material, sceneries[choice], GRASS);
			break;
		case 15:
			do_build(me, material, sceneries[choice], STATUE);
			break;
		default:
			tell(me, list+"\n輸入數字選項與使用的材料(例 2a by stone)，"HIW"ls"NOR" 顯示列表：\n");
			input_to((: select_icon, me :));
			return;
	}
			
}

// 建造其他特殊建築
void build_other(object me, object material, int choice)
{
	string my_id = me->query_id(1);
	string loc_owner = CITY_D->query_coor_data(query_temp("location", me), "owner");

	if( loc_owner != my_id && !ENTERPRISE_D->same_enterprise(loc_owner, my_id) )
	{
		tell(me, "這塊地不能建造這類的建築物。\n");
		return me->finish_input();
	}
	
	switch(choice)
	{
		// 農田
		case 50:
			if( !(CITY_D->query_coor_data(query_temp("location", me), "region") & AGRICULTURE_REGION) )
				return tell(me, "此地並不是農業區，無法建造農田。\n");

			do_build(me, material, others[choice], FARM);
			return;
		// 牧場
		case 51:
			if( !(CITY_D->query_coor_data(query_temp("location", me), "region") & AGRICULTURE_REGION) )
				return tell(me, "此地並不是農業區，無法建造牧場。\n");

			do_build(me, material, others[choice], PASTURE);
			return;
		// 養殖場
		case 52:
			if( !(CITY_D->query_coor_data(query_temp("location", me), "region") & AGRICULTURE_REGION) )
				return tell(me, "此地並不是農業區，無法建造養殖場。\n");

			do_build(me, material, others[choice], FISHFARM);
			return;
		default:
			tell(me, list+"\n輸入數字選項與使用的材料(例 2a by stone)，"HIW"ls"NOR" 顯示列表：\n");
			input_to((: select_icon, me :));
			return;
	}
}
		
		

void clean_build(object me)
{
	mixed * loc = query_temp("location", me);
	
	if( !CITY_D->query_coor_data(loc, TYPE) )
	{
		tell(me, "這塊土地上並沒有任何建築，不需要拆除。\n");
		
		return me->finish_input();
	}

	if( !me->cost_stamina(300) )
	{
		tell(me, pnoun(2, me)+"已經氣喘噓噓，沒有體力拆除這些東西了。\n");
		return me->finish_input();
	}

	msg("$ME將建造好的「"+CITY_D->query_coor_icon(loc)+"」拆除掉了。\n", me, 0, 1);
	tell(me, "耗費了 300 點體力，"HIG"["+me->query_stamina_cur()+"/"+me->query_stamina_max()+"]"NOR"。\n");

	CITY_D->delete_coor_data(loc, "growth");
	CITY_D->delete_coor_data(loc, "status");
	CITY_D->delete_coor_data(loc, TYPE);
	CITY_D->set_coor_icon(loc, BWHT"□"NOR);
	
	ESTATE_D->set_land_estate(CITY_D->query_coor_data(loc, "owner"), loc);
	
	tell(me, "\n輸入數字選項與使用的材料(例 2a by stone)，"HIW"ls"NOR" 顯示列表：\n");
	input_to((: select_icon, me  :));
	return;
}

mapping move_string = ([
    "n":        "north",
    "e":        "east",
    "w":        "west",
    "s":        "south",
    "u":        "up",
    "d":        "down",
    "nu":       "northup",
    "eu":       "eastup",
    "wu":       "westup",
    "su":       "southup",
    "nd":       "northdown",
    "ed":       "eastdown",
    "wd":       "westdown",
    "sd":       "southdown",
    "ne":       "northeast",
    "se":       "southeast",
    "nw":       "northwest",
    "sw":       "southwest",
]);
void select_icon(object me, string arg)
{
	int choice;
	string owner;
	mixed * loc = query_temp("location", me);
	
	string material_id;
	object material;

	if( !arg || !arg[0] )
	{
		tell(me, "\n輸入數字選項與使用的材料(例 2a by stone)，"HIW"ls"NOR" 顯示列表：\n");
		input_to((: select_icon, me :));
		return;
	}
	
	if( !arrayp(loc) || !environment(me)->is_maproom() ) 
	{
		tell(me, pnoun(2, me)+"不能在這裡建造任何建築物。\n");
		return me->finish_input();
	}

	owner = CITY_D->query_coor_data(loc, "owner");
	
	if( !owner ) 
	{
		tell(me, "這是一塊不屬於任何人的土地，"+pnoun(2, me)+"必須先買下這塊地才能在上面建造建築物。\n");
		return me->finish_input();
	}

	if( belong_to_government(owner) )
	{
		if( !CITY_D->is_mayor_or_officer(loc[CITY], me) )
		{
			tell(me, "這塊地是市政府用地，"+pnoun(2, me)+"沒有權利在這上面建造任何東西。\n");
			return me->finish_input();
		}
	}
	else if( belong_to_enterprise(owner) )
	{
		if( owner[11..] != query("enterprise", me) )
		{
			tell(me, pnoun(2, me)+"不是"+ENTERPRISE_D->query_enterprise_color_id(query("enterprise", me))+"企業集團的成員，無法在此建造任何東西。\n");
			return me->finish_input();
		}
	}
	else if( owner != me->query_id(1) && !ENTERPRISE_D->same_enterprise(owner, me->query_id(1)) ) 
	{
		tell(me, "這塊地是 "+capitalize(owner)+" 的私人土地，"+pnoun(2, me)+"沒有權利在這上面建造任何東西。\n");
		return me->finish_input();
	}

	foreach( string coor, mixed data in CITY_D->query_coor_range(loc, ROOM, 1) )
                if( data )
                {
                        tell(me, pnoun(2, me)+"必須先關閉這棟建築物才能重新建造。\n");
                        return me->finish_input();
		}
	
	if( ESTATE_D->query_loc_estate(loc) && ESTATE_D->query_loc_estate(loc)["type"] != "land" )
	{
		tell(me, pnoun(2, me)+"必須先關閉這棟建築物才能重新建造。\n");
                return me->finish_input();
	}
		
	arg = lower_case(arg);

	switch(arg)
	{
		case "lv":
		case "leave":
		{
			tell(me, "取消建造動作。\n");
			return me->finish_input();
		}
		case "l":
		case "look":
		{
			tell(me,MAP_D->show_map(query_temp("location", me), 0) || "地圖系統錯誤，請通知巫師處理。\n");
			tell(me, "\n輸入數字選項與使用的材料(例 2a by stone)，"HIW"ls"NOR" 顯示列表：\n");
			input_to((: select_icon, me :));
			return;
		}
		case "ls":
		case "list":
		{
			tell(me, list+"\n輸入數字選項與使用的材料(例 2a by stone)，"HIW"ls"NOR" 顯示列表：\n");
			input_to((: select_icon, me :));
			return;
		}
		case "er":
		case "erase":
		{
			evaluate((: clean_build, me :));
			return;
		}
	}

	if( sscanf( arg, "%d%s", choice, arg ) != 2 )
	{
		// 輸入方向指令 ?
		if( member_array(arg, keys(move_string)+values(move_string))!=-1)
		{
			if( member_array(arg, keys(move_string)) != -1 )
				arg = move_string[arg];

			if( MAP_D->valid_move(me, arg) <= 0  )
			{
				tell(me, "無法往該方向前進。\n");
				tell(me, "\n輸入數字選項與使用的材料(例 2a by stone)，"HIW"ls"NOR" 顯示列表：\n");
				input_to((:select_icon, me:));
				return;
			}
				
			CITY_D->move(me, arg);
		} 
		
		tell(me, "\n輸入數字選項與使用的材料(例 2a by stone)，"HIW"ls"NOR" 顯示列表：\n");
		input_to((: select_icon, me :));
		return;
	}
	
	// 解析材料物件
	if( sscanf(arg, "%s by %s", arg, material_id) == 2 )
	{
		if( !objectp(material = present(material_id, me) || present(material_id, environment(me))) )
		{
			tell(me, pnoun(2, me)+"的附近並沒有 "+material_id+" 這個東西。\n");
			tell(me, "\n輸入數字選項與使用的材料(例 2a by stone)，"HIW"ls"NOR" 顯示列表：\n");
			input_to((: select_icon, me :));
			return;
		}
	}

	switch(choice)
	{
		// 牆壁
		case 1..5:
			if( arg=="" || nullp(wall_type[arg]) )
			{
				tell(me, "\n輸入正確的數字選項與使用的材料(例 2a by stone)，"HIW"ls"NOR" 顯示列表：\n");
				input_to((: select_icon, me :));
				return;
			}
			evaluate((: build_wall, me, material, choice, wall_type[arg] :));
			break;
		// 門
		case 6..7:
			evaluate((: build_door, me, material, choice :));
			break;
		// 景觀預留範圍
		case 10..49:
			evaluate((: build_scenery, me, material, choice :));
			break;
		// 其他建築預留範圍
		case 50..99:
			evaluate((: build_other, me, material, choice :));
			break;

		default:
			tell(me, list+"\n輸入數字選項與使用的材料(例 2a by stone)，"HIW"ls"NOR" 顯示列表：\n");
			input_to((: select_icon, me :));
			return;
	}
}

private void do_command(object me, string arg)
{
	string owner;
	mixed * loc = query_temp("location", me);

	if( !arrayp(loc) || !CITY_D->is_city_location(loc) )
		return tell(me, pnoun(2, me)+"只能在城市地圖中建造建築物。\n");

	owner = CITY_D->query_coor_data(loc, "owner");
	
	if( !owner ) 
		return tell(me, "這是一塊不屬於任何人的土地，"+pnoun(2, me)+"必須先買下這塊地才能在上面建造建築物。\n");

	if( belong_to_government(owner) )
	{
		if( !CITY_D->is_mayor_or_officer(loc[CITY], me) )
			return tell(me, "這塊地是市政府用地，"+pnoun(2, me)+"沒有權利在這上面建造任何東西。\n");
	}
	else if( belong_to_enterprise(owner) )
	{
		if( owner[11..] != query("enterprise", me) )
			return tell(me, pnoun(2, me)+"不是"+ENTERPRISE_D->query_enterprise_color_id(query("enterprise", me))+"企業集團的成員，無法在此建造任何東西。\n");
	}
	else if( owner != me->query_id(1) && !ENTERPRISE_D->same_enterprise(owner, me->query_id(1)) ) 
		return tell(me, "這塊地是 "+capitalize(owner)+" 的私人土地，"+pnoun(2, me)+"沒有權利在這上面建造任何東西。\n");

	if( arg )
		return select_icon(me, arg);
	
	tell(me, list+"\n輸入數字選項與使用的材料(例 2a by stone)，"HIW"ls"NOR" 顯示列表：\n");

	input_to((: select_icon, me :));
}
