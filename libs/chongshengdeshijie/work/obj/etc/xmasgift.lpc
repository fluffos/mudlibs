#include <ansi.h>
#include <inherit.h>

inherit STANDARD_OBJECT;

mapping actions;

void do_open()
{
	object me = this_player();

	msg("$ME開心的開啟了"+this_object()->query_idname()+"，只見一陣白煙冒出，$ME在朦朧間似乎看見了一幅奇怪的景象...\n"+
	read_file("/wiz/home/liam/obj/xmas")+
	"$ME突然感覺到一陣暈眩。\n", me, 0, 1);

	set("abi/str/cur", 1, me);
	set("faint",1, me);
	
	me->add_title(HIC"聖誕夜"HIM"驚魂"NOR);

	destruct(this_object(), 1);
}

void create()
{
        set_idname(HIC"X'mas "HIM"gift"NOR, HIG"聖誕禮物"NOR);
	
	if( this_object()->set_shadow_database() ) return;
	
	set("unit", "個");
	set("capacity", 1);
	set("mass", 1);
	set("value", -1);
	set("badsell", 1);

	actions = ([ "open" : (: do_open :) ]);

}
