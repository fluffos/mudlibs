#include <inherit.h>

inherit STANDARD_OBJECT;

void create()
{
        set_idname("rose","[0m[31;1m玫瑰[0m");
        
        if( this_object()->set_shadow_ob() ) return;
        
        set("long","自古以來象徵愛情的[0m[31;1m玫瑰[0m，拿來送愛人可收意想不到的效果。\n");
        set("unit", "朵");
        set("mass", 5);
        set("value", 500);
}