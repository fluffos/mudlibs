#include <ansi.h>
#include <inherit.h>

inherit BULLETIN_BOARD;

void create()
{
	set_idname("liam's board", HIW"Lia"NOR"m's"WHT" Board "NOR);
	
	// 利用 shadow_ob 技術來做分散式公佈欄, 即時資料皆儲存於 shadow_ob 上
	if( clonep() ) 
		set("shadow_ob", find_object(base_name(this_object())));
	
	else
	{
		set("boardid", "liam");
		set("capacity", 9999);
		
		initialize_board();
	}
	startup_action();
}
