#include <ansi.h>
#include <inherit.h>

inherit STANDARD_OBJECT;

void create()
{
	set_idname(HIR"red envelope 2006"NOR, HIY"丙戌"NOR YEL"狗年"HIC"紀"NOR CYN"念"HIR"紅"NOR RED"包"NOR);
	
	if( this_object()->set_shadow_database() ) return;
	
	set("unit", "個");
	set("long", "2006 丙戌狗年紀念紅包");
	set("mass", 100);
	set("value", 100);
	set("flag/no_amount", 1);
}
