#include <inherit.h>

inherit STANDARD_OBJECT;

void create()
{
	set_idname("pearl","珍珠");
	
	if( this_object()->set_shadow_ob() ) return;
	
	set("long", "純白無瑕的珍珠。\n");
	set("unit", "顆");
	set("mass", 50);
	set("value", 60000);
}
