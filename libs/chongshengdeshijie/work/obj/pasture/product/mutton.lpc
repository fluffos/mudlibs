#include <inherit.h>

inherit STANDARD_OBJECT;

void create() {
  set_idname("mutton", "羊肉");

  if (this_object()->set_shadow_ob()) return;

  set("long", "帶著一層厚皮的羊肉。\n");
  set("unit", "塊");
  set("mass", 600);
  set("value", 12000);
}
