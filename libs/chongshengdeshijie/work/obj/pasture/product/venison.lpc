#include <inherit.h>

inherit STANDARD_OBJECT;

void create()
{
	set_idname("venison","鹿肉");
	
	if( this_object()->set_shadow_ob() ) return;
	
	set("long", "肉色鮮紅的鹿肉。\n");
	set("unit", "塊");
	set("mass", 600);
	set("value", 20000);
}
