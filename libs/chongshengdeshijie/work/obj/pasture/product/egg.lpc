#include <inherit.h>

inherit STANDARD_OBJECT;

void create()
{
	set_idname("egg","雞蛋");
	
	if( this_object()->set_shadow_ob() ) return;
	
	set("long", "略微透明的白黃色雞蛋。\n");
	set("unit", "顆");
	set("mass", 50);
	set("value", 100);
}
