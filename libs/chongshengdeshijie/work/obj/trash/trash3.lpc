#include <ansi.h>
#include <inherit.h>

inherit STANDARD_OBJECT;

void create() {
  set_idname(WHT "doll" NOR, "骯髒的充氣娃娃");

  set_temp("status", WHT "垃圾" NOR);

  if (this_object()->set_shadow_ob()) return;

  set("unit", "個");
  set("value", -1);
  set("mass", 70);
  set("garbage", 1);
}
