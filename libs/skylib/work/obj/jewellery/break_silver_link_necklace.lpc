// Autogenned file

inherit "/obj/jewellery/breakable_jewellery.lpc";

void setup(){

// #class
  set_name("necklace" );
  set_short("silver link necklace" );
  add_adjective(({ "silver", "link" }) );
  add_plural("jewellery" );
  add_alias( "jewellery" );
  set_long("This is a lovely necklace made from many delicately "
           "fashioned silver links.  Each link seems to be in the "
           "form of a tiny snake biting its own tail.\n" );
  set_weight(2 );
  set_value(2000 );
  add_property("shop type", "jewellers" );
  set_type("necklace" );
  setup_armour(640 );
  set_damage_chance(7);
} /* setup() */
