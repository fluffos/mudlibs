// kill.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  object obj;
  object obj2;

  string *killer, callname, man1, man2;

  if (!arg || sscanf(
    arg,
    "%s %s",
    man1,
    man2
  ) != 2) return notify_fail("指令格式：killtest <人物1> <人物2>\n");

  if (!objectp(obj = present(man1, environment(me))))
    return notify_fail("这里没有这个人。\n");
  if (!objectp(obj2 = present(man2, environment(me))))
    return notify_fail("这里没有这个人。\n");

  if (!obj->is_character() || obj->is_corpse())
    return notify_fail("看清楚一点，那并不是活物。\n");
  if (!obj2->is_character() || obj2->is_corpse())
    return notify_fail("看清楚一点，那并不是活物。\n");
  callname = RANK_D->query_rude(obj2);

  message_vision("\n$N对着$n喝道：「"
    +callname + "！今日不是你死就是我活！」\n\n", obj, obj2);



  obj->delete_temp("guarding");
  obj2->set_temp("guarding", 1);
  obj->kill_ob(obj2);
  if (!userp(obj2))
    obj2->kill_ob(obj);
  else {
    obj2->fight_ob(obj);
  }

  return 1;
}
int help(object me) {
  write(@HELP
指令格式 : killtest <人物> <人物>
 

其他相关指令: fight

有关 fight 跟 kill 的区分请看 'help combat'.
HELP
  );
  return 1;
}
