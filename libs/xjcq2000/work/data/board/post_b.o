{
        mapping sites=([
                \"少林派\":               ({\"/d/shaolin/guangchang1\",\"/d/shaolin/bamboo12\",\"/d/shaolin/bamboo1\",\"/d/shaolin/bamboo3\"}),
                \"峨嵋派\":               ({\"/d/emei/bailongdong\",\"/d/emei/baoguosi\",\"/d/emei/fuhusi\",\"/d/emei/guanyinqiao\"}),
                \"武当派\":               ({\"/d/wudang/guangchang\",\"/d/wudang/gudao1\",\"/d/wudang/xuanwumen\",\"/d/wudang/gudao2\"}),
                \"逍遥派\":               ({\"/d/xiaoyao/qingcaop\",\"/d/xiaoyao/xiaodao1\",\"/d/xiaoyao/xiaodao2\",\"/d/xiaoyao/xiaodao3\"}),
                \"嵩山派\":               ({\"/d/songshan/shanlu1\",\"/d/songshan/shanlu2\",\"/d/songshan/shanlu3\",\"/d/songshan/shanlu4\"}),
                  \"明教\":               ({\"/d/mingjiao/huangtuping\",\"/d/mingjiao/bishui.\",\"/d/mingjiao/shanjiao\",\"/d/mingjiao/shanyao\"}),
