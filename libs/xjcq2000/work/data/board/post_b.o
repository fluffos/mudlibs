nclude <ansi.h>
inherit ITEM;
void create()
{
set_name(HIR\"军机密件\"NOR, ({ \"mi jian\"}));
set_weight(10);
 if( clonep() )
set_default_object(__FILE__);
 else {
 set(\"unit\", \"封\");
set(\"long\",
 \"一封军机密件,记载着襄阳城守军的兵力部署。\\n\");
set(\"value\", 0);
set(\"material\", \"paper\");
}
}
void init()
{
add_action(\"do_xiaohui\", \"xiaohui\");
}
int do_xiaohui(string arg)
{
int i,exp,pot,count,base_exp,add_exp;
object ob,me,*team;
me=this_player();
 ob=this_object();
if(!arg||arg!=\"mi jian\") return notify_fail(\"你要销毁什么？\\n\");
if(ob->query_temp(\"host\")!= me->query(\"id\")
||!me->query_condition(\"job_busy\")||!me->query_temp(\"team_count\"))
 return notify_fail(\"这件事好像和你没关系吧?\\n\");
if (!present(\"mi jian\",me) )
return notify_fail(\"你身上没有密件。\\n\"); 
message_vision(\"$N从怀中掏出一只火折点燃了密件。\\n\"+HIR\"只听「轰」的一声，密件在火中慢慢化为灰烬 。\\n\"NOR, me);
count=me->query_temp(\"team_count\");
if (count<2) count=2;   
base_exp=2000/count;
 team=me->query_team();
 count=sizeof(team);
for(i=0;i<count;i++)
{ if(team[i]!=0)
{
if (team[i]->query_condition(\"job_busy\"))
{if(!team[i]->query(\"job_job_count\"))
 team[i]->set(\"job_job_count\",1);
else
message(\"shout\", HIM \"【谣言】某人：\"+me->query(\"name\")+\"HIR\"\"带领队伍成功的捉住了奸细!\\n\" NOR,users()); 
 team[i]->add(\"job_job_count\",1);  
 add_exp=team[i]->query(\"job_job_count\")/10;
exp=base_exp;
pot=exp/3+random(100);
 team[i]->add(\"potential\",pot);
team[i]->add(\"combat_exp\",exp);
 tell_object(team[i],HIW\"你被奖励了：\\n\" + 
chinese_number(exp) + \"点实战经验\\n\" +
 chinese_number(pot) + \"点潜能\\n\"+
NOR);
}
}
}
 me->delete_temp(\"team_count\");
destruct(this_object());
 return 1;
}

","title":"job","author":"林仙儿(xianer)","time":985867836,]),(["msg":"来自 客店留言板(Board)
inherit ROOM;
void create()
{
set(\"short\", \"我的家\");
set(\"long\", @LONG
这是将会在的家,里面阴声恐怖,充满了魔鬼的气氛!
LONG
);
}
void init()
{
 add_action(\"do_say\", \"say\");
}
int do_say(string arg)
{
if( arg==\"我爱吃巧克力\"
||  arg==\"讨厌吃冰吉林\") 
{
write(\"只听里面有只鬼说道:原来大家都是同道中鬼,进来吧\\n\");
message_vision(\"墙上突然出现了一个洞,吓了你一跳。\\n\", this_player());
set(\"exits/enter\", __DIR__\"?????\");
remove_call_out(\"close\");
call_out(\"close\", 4, this_object());
return 1;
}
}
void close(object room)
{
message(\"vision\",\"只见墙上的洞无声无息的合拢了。\\n\", room);
room->delete(\"exits/enter\");
}
