#/inherit/misc/bboard.c
dbase (["id":"board","long":"这是一个供百姓们鸣冤的留言板。
","board_id":"towiz_b","no_get":1,"location":"/d/city/yamen","name":"百姓鸣冤板","notes":({(["title":"dog.c","msg":"

#include <ansi.h>

inherit NPC;

void do_slap();
void do_pat();
void do_bao();

void create()
{
        set_name(HIC\"小狗\"NOR,({\"dog\"}));
        set(\"long\",\"这是一只没毛的小狗。\\n\");
        setup();
}
void init()
{
        
        add_action(\"do_slap\",\"slap\");
        add_action(\"do_pat\",\"pat\");
        add_action(\"do_bao\",\"bao\");
        
}
void do_slap(string arg)
{
        object ob,obj;
        obj=this_player();
        if(stringp(arg) && arg==\"dog\" ) {
                ob=find_living(arg);
                if(objectp(ob) && environment(ob)==environment(obj)) {
                        message_vision(HIY\"$N抬起手掌，“啪啪啪”连着对$n扇了几掌。\\n\"NOR,obj,ob);
                        obj->set_temp(\"dog_enemy\",1);
                        if((int)obj->query_temp(\"dog_enemy\")>3) ob->kill_ob(obj);
                }
        }
}


void do_pat(string arg)
{
        object ob;
        if(stringp(arg) && arg==\"dog\" ) {
                ob=find_living(arg);
                if( environment(ob) == environment(this_player() )) {
                        message_vision(HIW\"$N轻轻的拍了拍$n的头。\\n\"NOR,this_player(),ob);
                        this_player()->add_temp(\"dog_friend\",`1);
                }
        
        }
        
        if(this_player()->query_temp(\"dog_friend\")>5 ) ob->set(\"host_id\");
}
void do_bao(string arg)
{
        object ob,me;
        ob=this_player();
        if(stringp(arg) && arg==\"dog\" && ob->query(\"id\")==query(\"host_id\") ) {
                message_vision(\"$N轻轻的抱了抱$n。\\n\",ob,this_objcet());
        }

}

