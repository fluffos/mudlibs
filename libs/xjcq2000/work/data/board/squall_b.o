","title":"玩家 舞弊",]),(["time":984313001,"author":"凤舞(halen)","msg":"// /kungfu/skill/hamagong/puji.c  perform 蛤蟆扑击
// sdong, 10/24/98

inherit F_SSERVER
void tie_result(object me, object target)
void tie_hit(object me, object target)
void second_hit(object me, object target)

int perform(object me, object target)
{
        object armor,weapon
        int damage
        string *limb, type, result, str



        if( !target ) target = offensive_target(me)

        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail(你不在战斗中。\\n)


        if ( objectp(me->query_temp(weapon)) )
                return notify_fail(你不是空手。\\n)

        if ( me->query_condition(yyz_damage) )
                return notify_fail(你身受一阳指内伤，提不起真力施展蛤蟆击！\\n)

        if( (int)me->query_skill(hamagong, 1) < 120 )
                return notify_fail(你的蛤蟆功修为不够。\\n)

        if ( me->query_skill_mapped(force) != hamagong)
                                         return notify_fail(你所用内功不对！\\n)

        if( me->query(neili) <= 600 )
                                         return notify_fail(你的内力不够！\\n)

        if( me->query(jingli) <= 300 )
                                         return notify_fail(你的精力不够！\\n)

        message_vision(HIB $N双腿一弯，蹲下身来，“阁”的一声大叫，运起蛤蟆功劲力，双掌齐发，向前推出。这一推实乃毕生功力之所聚，$n猛然感受到山洪海啸般的劲力袭来。\\n\\n NOR, me,target)
        me->add(neili, -200)
        me->add(jingli, -100)
        if( random(me->query(combat_exp)) > (int)target->query(combat_exp)/2)
        {
                if( target->query_temp(armor/cloth) )

                if( (!armor || (armor && armor->query(armor_prop/armor)  150) )&& ( target-query_skill(dodge)+target->query_skill(parry) )  random((me-query_skill(strike) + me->query_skill(force))*2/3) )
                {
                        message_vision(HIR只听$N一声惨叫，这一掌正中小腹。但见$n一个身躯突然平平飞出，腾的一响，尘土飞扬，跌在丈许之外，直挺挺的躺在地下，再也不动。\\n\\nNOR, target,target )
                        target->receive_wound(qi, (int)target->query(qi), me)
                        target->receive_damage(qi, (int)target->query(qi)+1,  me)
                        me->add(neili, -me->query(jiali))
                        me->add(jingli, -me->query(jiajin))
                }
                else
                {
                        if(damage > 2000) damage = 2000
                        if(damage < 250) damage = 250
                        me->add(neili, -me->query(jiali)/2)
                        me->add(jingli, -me->query(jiajin)/2)

                        target->receive_damage(qi, damage,  me)
                        target->receive_wound(qi, (int)me->query_skill(strike), me)
                        target->start_busy(1+random(3))

                        if(random(2) ) type = 瘀伤
                        message_vision(result, me, target)

                        message_vision(($N+str+)\\n, target)
                }
                me->start_busy(2+random(3))
        }
        else if( ( random( target->query_skill(dodge) )   me-query_skill(strike)*2/3) && random(15) == 1 )
        {
                if(weapon)
                {
                        weapon->unequip()
                        weapon->move(environment(target))
                        target->reset_action()
                        message_vision(HIR$N猛觉得劲风罩来，心知不妙，手中NOR + weapon->name() + HIR脱手飞出，赶紧也是双掌向前平推。这一下是以硬接硬，刹那之间，两下里竟然凝住不动。\\nNOR, target )
                }
                else
                        message_vision(HIR$N猛觉得劲风罩来，心知不妙，也是双掌向前平推。这一下是以硬接硬，刹那之间，两下里竟然凝住不动。\\n\\nNOR, target )

                target->add(neili, -150)
                target->add(jingli, -80)
                me->start_busy(2+random(1))
                target->start_busy(2+random(1))
                remove_call_out(tie_hit)
                call_out(tie_hit,1+random(3),me,target)
        }
        else
        {
                message_vision(HIG $p眼见这一推来势凶猛，挡既不能，避又不可，当下双足一点，跃高四尺，躲开了这一推。只听身后腾的一声大响，$P这一推的劲力激起一股狂风巨浪，顿时尘土纷扬，令人惊骇不已。\\n\\n NOR, me, target)
                target->start_busy(1+random(2))
                me->start_busy(1)
                call_out(second_hit,1+random(2),me,target)
        }

        return 1
}

void second_hit(object me, object target)
{
        object armor
        int damage
        string *limb, type, result, str
        object weapon


        message_vision(HIY \\$N第一推刚完，第二推又已迅速异常的赶到，前劲未衰，后劲继至，掌风越发猛烈。\\n\\n NOR, me,target)
        me->add(neili, -150)
        me->add(jingli, -80)
        if( random(me->query(combat_exp)) > (int)target->query(combat_exp)/2){
                if( target->query_temp(armor/cloth) )

                if( (!armor || (armor && armor->query(armor_prop/armor)  150) )&& ( target-query_skill(dodge)+target->query_skill(parry) )  random((me-query_skill(strike) + me->query_skill(force))*2/3) )
                {
                        message_vision(HIR只听$N一声惨叫，这一掌正中小腹。但见$n一个身躯突然平平飞出，腾的一响，尘土飞扬，跌在丈许之外，直挺挺的躺在地下，再也不动。\\n\\nNOR, target,target )
                        target->receive_wound(qi, (int)target->query(qi), me)
                        target->receive_damage(qi, (int)target->query(qi)+1,  me)
                        me->add(neili, -me->query(jiali))
                        me->add(jingli, -me->query(jiajin))
                }
                else
                {
                        if(damage > 2000) damage = 2000
                        if(damage < 250) damage = 250
                        me->add(neili, -me->query(jiali)/2)
                        me->add(jingli, -me->query(jiajin)/2)

                        target->receive_damage(qi, damage,  me)
                        target->receive_wound(qi, (int)me->query_skill(strike, 1), me)
                        target->start_busy(1+random(3))


                        if(random(2) ) type = 瘀伤
                        message_vision(result, me, target)

                        message_vision(($N+str+)\\n, target)
                }
        }
        else if( ( random( target->query_skill(dodge) )   me-query_skill(strike)) && random(6) == 1 )
        {
                if(weapon)
                {
                        weapon->unequip()
                        weapon->move(environment(target))
                        target->reset_action()
                        message_vision(HIR$N猛觉得劲风罩来，心知不妙，手中NOR + weapon->name() + HIR脱手飞出，赶紧也是双掌向前平推。这一下是以硬接硬，刹那之间，两下里竟然凝住不动。\\nNOR, target )
                }
                else
                        message_vision(HIR$N猛觉得劲风罩来，心知不妙，也是双掌向前平推。这一下是以硬接硬，刹那之间，两下里竟然凝住不动。\\n\\nNOR, target )

                target->add(neili, -150)
                target->add(jingli, -80)
                target->start_busy(3+random(2))
                me->start_busy(2+random(2))
                remove_call_out(tie_hit)
                call_out(tie_hit,3+random(2),me,target)
        }
        else
        {
                message_vision(HIY $p眼见这一推气势汹汹，当下双足一点，侧跃三尺，又躲开了这一推。只听轰的一声大响，$P这一推的劲力激起一股狂风巨浪，又是一片尘土纷扬。。\\n NOR, me, target)
        }

        me->start_busy(2+random(2))
}

void tie_hit(object me, object target)
{
        int sum = me->query_skill(force) + me->query_skill(strike) + target->query_skill(force) + target->query_skill(parry)
        me->add(neili, -100 * sum / ( me->query_skill(force) + me->query_skill(strike) ) )
if(me->query(neili)0)me-set(neili,0)
        target->add(neili, -150 * sum / ( target->query_skill(force) + target->query_skill(strike) ) )
if(target->query(neili)0)target-set(neili,0)

        if( me->query_skill(force) + me->query_skill(strike) >= target->query_skill(force) + target->query_skill(parry) )
        
                message_vision(HIB 两人变得两具僵尸相似，连手指也不动一动，似乎气也不喘一口。$N脸上黑气大盛，蛤蟆功已发挥到极处。稍过片刻，$n已是全身大汗淋漓。\\n\\n NOR, me,target
        
        els
        
                message_vision(HIW 两人变得两具僵尸相似，连手指也不动一动，似乎气也不喘一口。$N脸上黑气大盛，蛤蟆功已发挥到极处，稍过片刻，已是全身大汗淋漓。$n似乎依然中气十足，头顶热气蒸蒸而上。\\n\\n NOR, me,target
        
        if( me->query(neili) > 0 && target->query(neili) > 0 && me->is_busy() && target->is_busy() && living(me) && living(target) 
        
                target->start_busy(3+random(2)
                me->start_busy(3+random(2)
                remove_call_out(tie_hit
                call_out(tie_hit,3+random(2), me,target
                retur
        
        remove_call_out(tie_result
        call_out(tie_result,1+random(3),me,target
void tie_result(object me, object target
        if( target->query(neili) <= 0 
        
                message_vision(HIR $N突然气喘不过来，全身发抖，原来内力已全部耗尽。突闻前胸一片骨裂之声，已被蛤蟆功一掌击中，哼也哼不出一声，仰身向后跌倒，双眼紧闭，脸如白纸，端的是生死难料。\\n\\n NOR, target
                target->receive_wound(qi, (int)target->query(qi), me
                target->receive_damage(qi, (int)target->query(qi)+1,  me
                retur
        
        if( me->query(neili) <= 0 
        
                message_vision(HIR $N脸上黑气大作，突然气喘不过来，全身发抖，原来内力已全部耗尽。蛤蟆功立时全部反弹回来，但闻前胸一片骨裂之声，哼也哼不出一声，俯身跌倒，双眼紧闭，脸如黑墨，端的是生死难料。\\n\\n NOR, me
                me->receive_wound(qi, (int)me->query(qi), target
                me->receive_damage(qi, (int)me->query(qi)+1,  target
        
","title":"to squall",]),(["time":984313887,"author":"凤舞(halen)","msg":"// shoot 喷毒之技


inherit F_SSERVER
inherit F_DBASE

void remove_shoot(object)

int perform(object me, object target)
{
        string msg
        object weapon
        int poi_amount, level

        if( !target ) target = offensive_target(me)

        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail(只能向战斗中的对手喷毒。\\n)

        if( (int)me->query_temp(shoot) && me->is_fighting())
                return notify_fail(毒液刚喷完！\\n)

//      if( me->query_skill(poison,1) <= 30 )
//               return notify_fail(你的毒技不够强！\\n)
        if (!objectp(weapon = me->query_temp(weapon)))
                 return notify_fail(空手不能喷毒。\\n)
        if ((string)weapon->query(id)!=shezhang &&
        (string)weapon->query(id)!=lingshe zhang )
                 return notify_fail(你的兵刃上没有喷毒的机关。\\n)
        if( me->query(neili)<100)
                return notify_fail(你的内力不够。\\n)
        if( me->query(jingli)<50)
                return notify_fail(你的精力不够。\\n)

        if( me->query_skill_mapped(force) != hamagong)
                return notify_fail(你所用的内功与「灵蛇杖法」气路相悖！\\n)

        if (level < 40 )
                return notify_fail(你的灵蛇杖法不够娴熟，无法操纵喷毒的机关。\\n)


        me->add(neili, -100)
        me->add(jingli, -50)
        if( !target->is_killing(me) ) target->kill_ob(me)

        if( me->query(neili) > random(target->query(neili)) 
        && me->query(combat_exp) > random(target->query(combat_exp)) ) {
                msg += $p一不留神，脸上被毒雾喷个正着！\\n NOR
                if( (string)weapon->query(id) == lingshe zhang ) 
                        target->apply_condition(bt_poison,
                        poi_amount*3 + target->query_condition(bt_poison))
                else 
                        target->apply_condition(snake_poison, 
                        poi_amount*3 + target->query_condition(snake_poison))
                        target->set(poisoner, me)
        } else {
                msg += 却见$p运动内力，双掌向前击出，“以其人之道，还治其人之身”，将毒雾逼到$P的身上！\\n NOR
                if( (string)weapon->query(id) == lingshe zhang )
                        me->apply_condition(bt_poison,
                        poi_amount/3 + me->query_condition(bt_poison))
                else            
                        me->apply_condition(snake_poison,
                        poi_amount/2 + me->query_condition(snake_poison))
                        me->set(poisoner, target)
        }

        me->set_temp(shoot,1)
        remove_call_out(remove_shoot)
        call_out(remove_shoot, 10,me)

        message_vision(msg, me, target)

        return 1
}

void remove_shoot(object me)
{
        me->delete_temp(shoot)

        tell_object(me, 你的蛇杖里的毒液准备好了。\\n)
}

","title":"about lingshe-zhang pfm",]),(["time":984313978,"author":"凤舞(halen)","msg":"// bite (纵蛇咬人)


inherit F_SSERVER
inherit F_DBASE

//void remove_bite(object)

int perform(object me, object target)
{
        string type, snake_path
        object weapon, snake
        int lv, poison, poi_amount, train_lv
        


        if( !target ) target = offensive_target(me)

        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail(你只能纵蛇偷袭战斗中的对手。\\n)
                
        if (lv < 200 )
                return notify_fail(你的灵蛇杖法不够娴熟，无法在使杖攻敌之余纵蛇伤人。\\n)

        if (poison < 200 )
                return notify_fail(你对使毒的法门所知有限。\\n)

        if (!objectp(weapon = me->query_temp(weapon)))
                 return notify_fail(你手上没有盘蛇的兵器。\\n)


        if ( !type && weapon->query(id) != shezhang)
                return notify_fail(你的+weapon->name()+上并没有蛇。\\n)

        if( (int)me->query_temp(baituo/bite) && me->is_fighting())
                return notify_fail(你刚刚已经纵蛇伤人，这麽快就故技重施，祗怕难以奏效。\\n)

        if( me->query_skill(training,1) < 100 )
               return notify_fail(你的驭兽术无法顺利驱使毒蛇伤人。\\n)

        if( me->query(neili) < poi_amount)
                return notify_fail(你的内力不够，难以在纵蛇袭击时稳控+weapon->name()+。\\n)

        if( me->query(jingli) < 300)
                return notify_fail(你的精力不够，难以在纵蛇袭击时稳控+weapon->name()+。\\n)

        if( me->query_skill_mapped(force) != hamagong)
                return notify_fail(你所用的内功与「灵蛇杖法」气路相悖！\\n)

        me->add(neili, -(poi_amount/2 +50))
        me->add(jingli, -200)

        switch (type) {
        case 怪蛇 :
        break
        case 灵蛇 :
        break
        default:
        }
        
        seteuid(getuid())

/*      if (snake->query(id) != ling she && snake->query(id) != guai she) {
                destruct(snake)
                return notify_fail(weapon->name()+上的+type+并非白驼山庄所驯养，临敌之时不如灵蛇、怪蛇熟习灵动！\\n)
        }
*/
        snake->set(bite_busy,1)
        snake->set(env/invisibility, 10)
        snake->set(owner,me)
        snake->move(environment(me))
        snake->set(default_actions, (: call_other, __FILE__, query_action :))
        snake->set(combat_exp,me->query(combat_exp))
        snake->set_skill(parry,me->query_skill(parry))
        snake->set_skill(dodge,me->query_skill(dodge))
        snake->add_temp(apply/speed, 5)
        snake->add_temp(apply/attack, lv*2 + train_lv)
        snake->add_temp(apply/damage, me->query_temp(apply/damage))
        snake->set(neili,me->query(max_neili))
        snake->set(snake_poison, poi_amount*3 )
        snake->kill_ob(target)
        message_vision(HIB\\n$N将+weapon->name()+HIB一抖，杖上金环当啷啷一阵乱响，一条+type+HIB从杖底直盘上来。\\nNOR,me)

        me->start_busy(1)

        COMBAT_D->do_attack(snake, target, snake->query_temp(weapon))
        
        if(weapon->query(snake) == 2) {
        snake->set(second_attack,1)
        COMBAT_D->do_attack(snake, target, snake->query_temp(weapon))
        }
        destruct(snake)

        target->kill_ob(me)
        me->set_temp(baituo/bite,1)

        remove_call_out(remove_bite)
        call_out(remove_bite, 10, me, type)

        return 1
}

int remove_bite(object me, string type)
{
        me->delete_temp(baituo/bite)
        tell_object(me, type+昂起了头，嘶地一吐舌头。\\n)
        return 1
}

mapping query_action(object me)
{
        string msg1, msg2
        return (
        \"action\": me->query(\"second_attack\") ? msg2 : msg1,
        \"force\" : 400,
        \"dodge\" : 0,
        \"parry\" : 0,
        \"damage\" : 400,
        \"weapon\" :\"毒牙\",
        \"damage_type\":\"咬伤\"])
}

