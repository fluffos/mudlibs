// shulin.c 

inherit ROOM;
void create() {
  set("short", "树林");
  set("long", @long
这里是华山村里的一片杨树林，如果你没有好身手，可千万不要在此
久留，据说这里强盗出没，抢劫、杀人的事情经常发生。
long);
  set("exits", ([
    "west": __DIR__ "shulin3",
    "north": "/d/hs/path1",
  ]));
  set("objects", ([
    "d/hs/npc/mu_renqing": 1,
  ]));
  setup();
}
void init() {
  object ob;
  ob = this_player();
  if (ob->query("family/master_name") == "风清扬")
    add_action("do_shenru", "shenru");
}
int do_shenru() {
  object ob, room;
  ob = this_player();
  room = load_object("/d/hs/feng_room");
  message_vision("$N向树林的深处走去，转眼间已经看不到人影了。\n", ob);
  ob->move(room);
  return 1;
}
