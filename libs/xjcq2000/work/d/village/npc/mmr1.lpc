// mmr.c

inherit NPC;
inherit F_UNIQUE;
inherit F_SAVE;
#include <ansi.h>
#include "skill.h"
#include "mmr1.h"
void create() {
  set_name("蒙面人", ({ "mengmian ren", "bandit", "ren" }));
  set("gender", "男性");
  set("age", 30);
  set("long",
    "这家伙满脸横肉一付凶神恶煞的模样，令人望而生畏。\n");
  set("combat_exp", 10000);
  set("shen", -15000);
  set("attitude", "aggressive");
  set("age", random(20) + 25);
  set("str", 20 + random(5));
  set("int", 20 + random(5));
  set("con", 20 + random(5));
  set("dex", 20 + random(5));
  set("combat_exp", 100000);
  set("shen_type", -1);
  set("attitude", "friendly");
  set("max_qi", 1200);
  set("max_jing", 1200);
  set("neili", 1000);
  set("max_neili", 1000);
  set("score", 10000);


  set_skill("force", 100);
  set_skill("unarmed", 100);
  set_skill("dodge", 100);
  set_skill("parry", 100);

  setup();

  carry_object("/clone/misc/cloth")->wear();

}
