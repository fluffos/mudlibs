//      shankou.c 山口
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", HIW "山口" NOR);
  set("long", @LONG 
这里是四川进入西藏的一处山口，遥望西方，隐隐看到远处白雪皑皑的高
山连绵起伏，仔细一看，在这其中似乎有一座金碧辉煌的庙宇，并且已经不是
十分遥远了。
LONG);
  set("exits", ([
    "eastdown": __DIR__ "shanlu",
    "westup": __DIR__ "xuedi01"

  ]));
  set("outdoors", "xizang");

  setup();
}
