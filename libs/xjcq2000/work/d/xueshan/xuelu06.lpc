//      xuelu06.c 积雪小路

#include <ansi.h>

inherit ROOM;


void create() {
  set("short", HIW "积雪小路" NOR);
  set("long", @LONG 
这是一条积满雪的小路，小路中央已经看到有马匹行人的足迹西藏人信仰
喇嘛教，每逢吉日，必然到庙宇朝拜，看来从这里上山是不会错了。一条小路
直通山下，隐约可见山下的藏民村落。向南看去，一座神秘的雪山。半山腰白
云飘渺，据说那里就是喇嘛们成佛升天的雪山绝顶、
LONG);
  set("exits", ([
    //    "south" : __DIR__"jueding",
    "northwest": __DIR__ "xuelu05",
    "northeast": __DIR__ "xuelu03",
    "eastdown": __DIR__ "xuelu04"

  ]));
  set("outdoors", "雪山");

  setup();
}
