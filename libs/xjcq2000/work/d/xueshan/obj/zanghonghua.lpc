//  zanghonghua
// by dubei

#include <ansi.h>

inherit ITEM;

void setup() {}

void init() {
  add_action("do_fu", "fu");
}

void create() {
  set_name(HIR "藏红花" NOR, ({ "zang honghua", "zang" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "包");
    set("long", "这是一包由生长在西藏高原上极其罕见的藏红花配置的丹药。\n"
      "传说藏红花五年一开花，其花有起死回生的效果，故此药也取名为藏红花。\n");
    set("value", 1000);
    set("no_drop", "这样东西不能离开你。\n");
    set("no_get", 1);
  }

  setup();
}

int do_fu(string arg) {
  object me = this_player();

  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  if ((int)this_player()->query("eff_qi") ==
    (int)this_player()->query("max_qi"))
    return notify_fail("你现在不需要用药物。\n");

  if (this_player()->is_busy() || this_player()->is_fighting())
    return notify_fail("你正忙着呢。\n");

  if (me->query_condition("medicine")) {
    message_vision(HIR "$N吃下一包藏红花，忽然头重脚轻，原来服药过频，伤势反而加重。\n" NOR, me);
    me->set("eff_qi", 1);
    me->start_busy(2);
    me->apply_condition("medicine", 30);
    destruct(this_object());

    return 1;
  }
  if (me->query_skill_mapped("force") != "longxiang-gong") {
    me->add("max_neili", -10);
    message_vision(HIR "$N吃下一包藏红花，只觉得丹田有如刀割，原来所练内功不符，反而大损真元！\n" NOR, me);
    me->unconcious();
    destruct(this_object());
    return 1;
  }

  else {
    me->set("eff_qi", me->query("max_qi"));
    me->set("qi", me->query("max_qi"));
    message_vision("$N吃下一包藏红花，吐出一口淤血，伤势大为好转。\n", this_player());
    me->apply_condition("medicine", 30);
    me->start_busy(1);

  }
  destruct(this_object());
  return 1;
}
