//      xuelu04.c 积雪小路

#include <ansi.h>

inherit ROOM;


void create() {
  set("short", HIW "积雪小路" NOR);
  set("long", @LONG 
这是一条积满雪的小路，小路中央已经看到有马匹行人的足迹西藏人信仰
喇嘛教，每逢吉日，必然到庙宇朝拜，看来从这里上山是不会错了。小路上积
雪又湿又滑，走上去十分艰难。一不小心，就会滑到山脚下去。
LONG);
  set("exits", ([
    "westup": __DIR__ "xuelu06",
    "eastdown": __DIR__ "shanjiao",
    "northeast": __DIR__ "xuelu03",
  ]));
  set("outdoors", "雪山");

  setup();
  replace_program(ROOM);
}
