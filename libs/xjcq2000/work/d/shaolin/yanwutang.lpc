// by jrx
#include <room.h>
inherit ROOM;
string look_bian();

void create() {
  set("short", "演武堂");
  set("long", @LONG
这里就是少林寺的罗汉堂的演武功房，少林开寺几百年来。
各派高手常来挑战，少林僧人便修筑了这样一个演武堂，以武
会友，免伤和气。厅的正中挂着一块红木大匾(bian)，上面镶
着四个金灿灿的大字。
LONG);
  set("exits", ([
    "out": "/d/shaolin/guangchang1",
  ]));
  set("item_desc", ([ "bian": (: look_bian :), ]));
  set("no_clean_up", 0);
  set("no_sleep_room", 1);
  set("notice_fight", 1);
  setup();
}

void init() {
  add_action("do_no", "dazuo");
  add_action("do_no", "exercise");
  add_action("do_no", "get");
  add_action("do_no", "hit");
  add_action("do_no", "kill");
  add_action("do_no", "ansuan");
  add_action("do_no", "touxi");
  add_action("do_no", "conjure");
  add_action("do_no", "persuade");
  add_action("do_no", "shexin");
  add_action("do_no", "quanjia");
  add_action("do_no", "perform");
  add_action("do_no", "yong");
}

int do_no(string arg) {
  write(this_player()->query("name") + "，在这儿不能这么做！\n");
  return 1;
}

string look_bian() {
  return "\n"
    "    ※※※※※※※※※※※※※※※※※※※※※※※※※※\n"
    "    ※※※※※※※　　　　　　　　　　　　※※※※※※※\n"
    "    ※※※※※※※　                　　　※※※※※※※\n"
    "    ※※※※※※※　　 以  武  会  友 　　※※※※※※※\n"
    "    ※※※※※※※                      　※※※※※※※\n"
    "    ※※※※※※※                      　※※※※※※※\n"
    "    ※※※※※※※※※※※※※※※※※※※※※※※※※※\n";
}
