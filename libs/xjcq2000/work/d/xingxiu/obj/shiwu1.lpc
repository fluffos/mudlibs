// qingke-m.c 青稞面

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("牛肉拉面", ({ "niurou lamian", "lamian", "mian" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一盆别有风味的牛肉拉面,里面可以看见大块大块的牛肉。\n");
    set("unit", "盆");
    set("value", 200);
    set("food_remaining", 4);
    set("food_supply", 60);
  }
}
