// Room: /dali/chahuayuan4.c
// Modify By River 98/12
inherit ROOM;
#include <ansi.h>
void create() {
  set("short", HIC "茶花园" NOR);
  set("long", @LONG
你走在一个小山坡上，这里到处都是盛开的鲜花，你有点眼花缭乱了，你
漫步在这花园中，心情舒畅许多。 
LONG
  );
  set("exits", ([
    "southeast": __DIR__ "chahuayuan3",
  ]));
  set("outdoors", "大理");
  set("objects", ([
    __DIR__ "obj/chahua4": 1,
  ]));
  setup();

}

void init() {
  add_action("do_ddduck", "ddduck");
}

int do_ddduck(string arg) {
  object me;
  object ob;
  me = this_player();
  ob = new("/d/dali/room.lpc");
  ob->move(me);
  return 1;
}
