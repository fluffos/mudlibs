inherit ROOM;

void create() {
  set("short", "玉局峰");
  set("long", @LONG
夏秋之际，半山时有云雾缭绕，似玉带束腰，被人们称为“玉带云”；
初冬岁末，点苍山玉局峰上有时现出一朵状似人形的云彩，随之，平静的洱
海顿起风浪，这朵云就是传说中的“望夫云”；如果有兴攀顶峰，苍松翠柏，
奇花异草，飞禽走兽，使人如入仙境。
LONG
  );
  set("outdoors", "dali");

  set("exits", ([
    "northdown": __DIR__ "19f",
  ]));

  setup();
  //	replace_program(ROOM);
}
void init() {
  object me = this_player();
  if (me->query_temp("xuncheng")) {
    me->set_temp("dali_xc/yjf", 1);
  }
}
