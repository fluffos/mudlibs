// bbb.c

inherit ROOM;

void create() {
  set("short", "杀手之家");
  set("long", @LONG
如果你的运气好，能找到这里的迷密，嘿嘿。。。。。。
LONG
  );

  set("exits", ([
    "down": __DIR__ "workroom",

  ]));

  setup();
}


void init() {
  add_action("do_dream", "meng");
  add_action("do_dream", "梦");
  add_action("do_dream", "dream");
}


int do_dream(string arg) {
  object me;

  if (!arg) {
    return notify_fail("你做了一个美梦，觉得有点飘飘然了。\n");
  }

  me = this_player();
  if (arg == "exp") {
    mapping mine;

    mine = me->query_entire_dbase();
    write("你在梦中和杀手大战三百回合，领悟不少。\n");
    mine["combat_exp"] += 100;

    return 1;
  }

  if (
    arg == "literate" ||
    arg == "force" ||
    arg == "unarmed" ||
    arg == "dodge" ||
    arg == "parry" ||
    arg == "stealing" ||
    arg == "liumai-shenjian" ||
    arg == "lingbo-weibu" ||
    arg == "tianlong-shengong" ||
    arg == "yiyang-zhi" ||
    arg == "finger" ||
    arg == "strike" ||
    arg == "sword"
  ) {
    write("你梦见杀手给你讲解" + to_chinese(arg) + "的诀窍，获益非浅。\n");
    me->improve_skill(arg, random(10 * me->query("int")));

    return 1;
  }

  return notify_fail("你做了一个美梦，梦中见到了" + arg + "。\n");
}
