// dan.c

#include <ansi.h>

inherit ITEM;

void setup() {}

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name("鹿茸", ({ "lu rong", "rong", "lu" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "枝");
    set("treasure", 1);
    set("long", "这是一枝鹿茸。\n");
    set("value", 3000);
  }

  setup();
}

int do_eat(string arg) {
  object me = this_player();

  if (!id(arg))
    return notify_fail("你要吃什么？\n");


  me->set("eff_qi", me->query("max_qi"));
  me->set("qi", me->query("max_qi"));
  me->set("eff_jing", me->query("max_jing"));
  me->set("jing", me->query("max_jing"));

  message_vision(HIG "$N吃下一枝鹿茸，只觉身体好多了。\n" NOR, me);
  destruct(this_object());
  return 1;

  me->apply_condition("bonze_drug", 50);

  destruct(this_object());
  return 1;
}
