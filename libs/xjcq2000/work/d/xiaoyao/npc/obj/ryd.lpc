// ruyi.c
// for 逍遥子
// By Lgg,1998.9

#include <ansi.h>
#include <weapon.h>
inherit BLADE;

void create() {
  set_name(HIY "逍遥如意刀" NOR, ({ "ruyi dao", "ruyi", "dao" }));
  set_weight(6000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "这是一口用黄金做成的宝刀，剑身上用金丝锩着几个字：\n"
      "逍遥如意刀\n");
    set("value", 0);
    set("material", "softsteel");
    set("no_give", 1);
    set("no_put", 1);
    set("no_drop", 1);
    set("weapon_prop/personality", 85);
    set("wield_msg", "$N默运北冥神功，将$n缓缓抽出刀鞘。\n");
    set("unwield_msg", "$N右手一晃，$n已然回鞘。\n");
  }
  init_blade(50);
  setup();
}
