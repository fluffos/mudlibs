// xiaoyaozi.c 逍遥子
// shilling 97.2
#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create() {
  set_name("逍遥子", ({ "xiaoyao zi", "xiaoyao", "zi" }));
  set("title", "逍遥派开山祖师");
  set("long",
    "他就是逍遥派开山祖师、但是因为逍遥派属于一个在江湖中\n"
    "的秘密教派，所以他在江湖中不是很多人知道，但其实他的\n"
    "功夫却是。。。。他年满七旬，满脸红光，须眉皆白。\n");
  set("gender", "男性");
  set("age", 75);
  set("class", "scholar");
  set("attitude", "friendly");
  set("shen_type", 1);
  set("str", 45);
  set("int", 45);
  set("con", 45);
  set("dex", 45);
  set("per", 30);
  set("kar", 30);

  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: exert_function, "recover" :),
    (: exert_function, "shield" :),
    (: perform_action, "blade.wx" :),
    (: perform_action, "blade.wx" :),
    (: perform_action, "blade.wx" :),
    (: perform_action, "blade.mie" :),
    (: perform_action, "blade.sx" :),
    (: perform_action, "blade.sx" :),
    (: command("unwield dao") :),
    (: command("unwield dao") :),
    (: command("unwield dao") :),
    (: command("unwield dao") :),
    (: command("wield dao") :),
    (: command("wield dao") :),
    (: command("wield dao") :),
    (: command("wield dao") :),
    (: perform_action, "unarmed.yinyang" :),
    (: perform_action, "unarmed.yinyang" :),
    (: perform_action, "hand.cuijingshou" :),
    (: perform_action, "unarmed.yinyang" :),
    (: perform_action, "unarmed.yinyang" :),
    (: perform_action, "unarmed.yinyang" :),
  }));

  set("max_qi", 6500);
  set("max_jing", 3000);
  set("neili", 9000);
  set("max_neili", 9000);
  set("jingli", 2000);
  set("max_jingli", 2000);
  set("jiali", 150);
  set("combat_exp", 2800000);
  set("score", 200000);

  set_skill("force", 300);
  set_skill("sword", 300);
  set_skill("beiming-shengong", 300);
  set_skill("dodge", 300);
  set_skill("lingboweibu", 300);
  set_skill("strike", 300);
  set_skill("liuyang-zhang", 300);
  set_skill("parry", 300);
  set_skill("blade", 300);
  set_skill("wxsxruyi-zhan", 300);
  set_skill("ruyi-dao", 300);
  set_skill("zhemei-shou", 300);
  set_skill("hand", 300);
  set_skill("literate", 300);
  set_skill("taoism", 300);

  map_skill("force", "beiming-shengong");
  map_skill("dodge", "lingboweibu");
  map_skill("hand", "zhemei-shou");
  map_skill("strike", "liuyang-zhang");
  map_skill("parry", "ruyi-dao");
  map_skill("blade", "ruyi-dao");

  prepare_skill("hand", "zhemei-shou");
  prepare_skill("strike", "liuyang-zhang");

  create_family("逍遥派", 1, "开山祖师");
  set("class", "taoist");

  setup();
  carry_object("/d/xiaoyao/npc/obj/ryd")->wield();
}

void attempt_apprentice(object ob) {
  int task;
  task = (int)ob->query("xytask");

  if ((int)ob->query_skill("beiming-shengong", 1) < 140) {
    command("say 我逍遥派内功的源泉来自于北冥神功的心法。");
    command("say " + RANK_D->query_respect(ob) +
      "的北冥神功是否还应该有所提高啊？");
    return;
  }

  if (ob->query_int() < 35) {
    command("say 我逍遥派武功最重视“逍遥”二字。");
    command("say 而何谓“逍遥”，这只能靠你自己去领悟。");
    command("say 但是" + RANK_D->query_respect(ob) + "的悟性似乎还有待提高啊。");
    return;
  }
  command("smile");
  command("chat 想不到在这世上竟然还有人可以继承我的逍遥心法！");
  command("chat 可惜沧海妹再也看不到了，可是秋水,行云!!");
  command("sigh");
  command("recruit " + ob->query("id"));
  ob->set("title", HIC "逍遥派无忧使者" NOR);
}
