#include <room.h>

inherit ROOM;

void create() {
  set("short", "飞云岩");
  set("long", @LONG
这里似洞非洞，顶上崖檐覆出，石乳倒垂。浮者若飞霞，亘
者若虹霓，豁然楼殿门阙，悬若铜鼓编磬，并有狮象蛟龙、莲荷
阡陌、蜂房水涡之属。其下澄潭邃谷，幽深无底，四面茂盛古树
参天，流水潆洄。
LONG
  );

  set("exits", ([
    "eastup": __DIR__ "xqx",
    "west": __DIR__ "wx",
  ]));



  set("outdoors", "襄阳");
  setup();
}
