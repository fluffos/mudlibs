inherit ROOM;
void create() {
  set("short", "祠堂");
  set("long", "这是一个破烂的小祠堂，几乎快倒了，地上有一滩血和几块人骨。\n旁边的墙上好像刻有什么字(word)。\n");

  set("item_desc", ([
    "word": "你向墙上的小字细看了一会，原来上面所刻着的竟然是炼心之术(lianxin)。\n",
  ]));
  set("exits", ([
    "out": "/d/xiangyang/houhua",
  ]));
  setup();
}
void init() {
  add_action("do_lianxin", "lianxin");
}
int do_lianxin() {
  object ob;
  ob = this_player();
  if (ob->is_busy() || ob->is_fighting()) return notify_fail("你正忙着呢。\n");
  message_vision("$N看着地上的血和人骨，嘴角露出一比冷笑。\n只见$N盘做于一旁双目内视，开始深思炼心之术。\n", ob);

  remove_call_out("halt_lianxin");
  call_out("halt_lianxin", 8, ob);
  ob->start_busy(8);
  return 1;
}
int halt_lianxin(object ob) {
  message_vision("$N拍了拍身上的灰新了起来，从身上涌出一阵杀气。\n", ob);
  ob->add("shen", -(random(30) + 20));
  ob->add("jing", -20);
  return 1;
}
