// ken 1999.12.8

#include <ansi.h>
inherit NPC;

void create() {
  set_name("小宝儿", ({ "baoer", "fang baoyu" }));
  set("gender", "男性");
  set("age", 12);
  set("long",
    "一个十一二岁的锦衣童子，长得唇红齿白，十分招人喜欢，正在竹塌上看书。\n"
  );
  set("attitude", "friendly");
  set("max_kee", 150);

  set("combat_exp", 5000);
  set_skill("dodge", 30);

  setup();
  //        carry_object(__DIR__"obj/jinyi")->wear();
  add_money("silver", 5);
}

int accept_object(object who, object ob) {
  object hb;
  if (ob->query("name") == "系上了线的花风筝") {
    message_vision(HIY "\n小宝儿笑着对你说到：辛苦你啦!\n" NOR, who);
    hb = new("/questobj/obj/hongbao1");
    hb->move(who);
    hb->move(who);
    message_vision(HIW "\n小宝儿偷偷塞给你一个大红包!\n" NOR, who);
    return 1;
  }
  return 0;
}

//}
