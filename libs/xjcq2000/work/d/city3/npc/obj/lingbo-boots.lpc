// lingbo_boot.c

#include <ansi.h>
#include <armor.h>

inherit BOOTS;

void create() {
  set_name(YEL "凌波皮靴" NOR, ({ "lingbo-boots", "boots" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "双");
    set("value", 8000);
    set("material", "cloth");
    set("armor_prop/armor", 1);
    set("armor_prop/dodge", 10);
  }
  setup();
}
