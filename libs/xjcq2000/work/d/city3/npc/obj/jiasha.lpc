#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create() {
  set_name(HIY "团龙" + HIR "袈裟" NOR, ({ "jiasha" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "cloth");
    set("armor_prop/armor", 20);
    set("value", 1000);
  }
  setup();
}
