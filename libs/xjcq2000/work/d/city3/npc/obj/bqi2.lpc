// pearl.c

#include <weapon.h>

inherit THROWING;

void create() {
  set_name("黑云子", ({ "black yun-piece", "yun-piece" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "黑色云子\n");
    set("unit", "盒");
    set("base_unit", "粒");
    set("base_weight", 1);
    set("base_value", 10);
  }
  set("value", 2000);
  set_amount(200);
  init_throwing(1);
  setup();
}
