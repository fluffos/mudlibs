#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "[1;32m棋院[2;37;0m");
  set("long", @LONG
大理人酷爱围棋，当地又出产云子，一个精明的商人就在这里开了一
个[1;32m大理棋院[2;37;0m。有两个年轻伙计趁着没人正在下棋，掌柜的则在一边看着。
LONG
  );
  set("exits", ([
    "north": __DIR__ "wroad1",
  ]));
  set("objects", ([
    __DIR__ "npc/fan2": 1,
    __DIR__ "npc/whiteman": 1,
    __DIR__ "npc/blackman": 1,
    __DIR__ "npc/obj/table": 1,
  ]));
  set("coor/x", -850);
  set("coor/y", -760);
  set("coor/z", 80);
  setup();
}

void reset() {
  object *inv;
  object con, item, item1, item2;
  ::reset();
  con = present("table", this_object());
  inv = all_inventory(con);
  if (!sizeof(inv)) {
    item = new(__DIR__ "npc/obj/bqi");
    item1 = new(__DIR__ "npc/obj/wqi");
    item2 = new(__DIR__ "npc/obj/qipan");
    item->move(con);
    item1->move(con);
    item2->move(con);
  }
}
