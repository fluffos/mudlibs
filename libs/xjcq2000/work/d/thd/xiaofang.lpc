inherit ROOM;
void create() {
  set("short", "箫房");
  set("long", @LONG
这是桃花岛的箫房，里面有各种各样的箫，随便拿一只吧。
LONG
  );
  set("exits", ([
    "out": __DIR__ "jicui",
  ]));
  set("no_clean_up", 0);
  set("objects", ([
    "/clone/weapon/biyuxiao": 1,
    "/clone/weapon/yuxiao": 1,
  ]));
  setup();
  replace_program(ROOM);
}
