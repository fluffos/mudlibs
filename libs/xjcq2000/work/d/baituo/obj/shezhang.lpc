//shezhang.c

#include <ansi.h>
#include <weapon.h>
inherit STAFF;

void create() {
  set_name(HIB "蛇杖" NOR, ({ "she zhang", "zhang" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("long", "这是一根蛇杖, 杖头一条小蛇, 红舌伸缩, 十分诡异。\n");
    set("value", 0);
    set("no_drop", 1);
    set("no_put", 1);
    set("no_give", 1);
    set("material", "leather");
    set("wield_msg", "$N缓缓的将$n握在手中！n");
    set("unwield_msg", "$N将手中的$n收回背后。\n");
  }
  init_staff(70);
  setup();
}
