#include <ansi.h>
inherit ROOM;
string* obj = ({
       BINGQI_D("gangzhang"),
       BINGQI_D("feihuangshi"),
       "/clone/mise/fire",
       BINGQI_D("changbian"),
       ARMOR_D("armor"),
       BINGQI_D("gangjian"),
       BINGQI_D("tiegun"),
       "/clone/food/hulu",
       BINGQI_D("blade"),
       ARMOR_D("changpao"),
       __DIR__"obj/book1",
       __DIR__"obj/book2",
       __DIR__"obj/book3",
       __DIR__"obj/book5",
       __DIR__"obj/shepi",
});

void create()
{
        set("short", "储藏室");
        set("long", @LONG
你一进门便闻到一股霉味，在门外射进来的阳光的照耀下，你看见这
里满屋的灰尘，成堆成堆的物品快堆满了整间房间。你很是奇怪为什么仆
役们离开时不把这些物品也带走。
LONG);
        set("exits", ([
              "west" : __DIR__"yuanzi",
        ]));
        setup(); 
}

void init()
{
        add_action("do_find", "find");
        add_action("do_find", "zhao");
        add_action("do_find", "fan");
}

int do_find()
{
        object me, ob;
        me = this_player();
       if( (int)me->query_temp("baituo_find") ) 
                return notify_fail("你已经拿了东西了，走吧。\n");
       if (me->query_skill("hamagong", 1) && 
           me->query_skill("poison", 1) > 30){
           message_vision("$N捏着鼻子在物品堆中乱翻着。\n", me);
           call_out("found", 0, me);    
           return 1;
          }
       if (me->query_skill("poison", 1) < 50){
           message_vision("$N捏着鼻子在物品堆中乱翻着。\n", me);
            if(random((int)me->query("kar")) < 10){
                  write("你吸了口气，突然觉得头中一阵眩晕。\n");
                  me->unconcious();
                  return 1;
                  }
            else {
            call_out("found", 0, me);    
            return 1;
                 }
            }
       else { 
           message_vision("$N捏着鼻子在物品堆中乱翻着。\n", me);
           write("你吸了口气，突然觉得头中一阵眩晕。。。不好！你中毒了！\n");
           me->apply_condition("snake_poison", 22);
           me->unconcious();
           return 1;
           }
}

int found(string arg)
{
        object me, ob;
        me = this_player();
        ob = new( obj[random(sizeof(obj))] );
        ob->move(me);
        message_vision("$N翻了半天，找到了" + ob->query("name") + "。\n", me);
        me->set_temp("baituo_find", 1);
        return 1;
}
