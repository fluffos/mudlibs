inherit ITEM;
void create() {
  set_name("信件", ({ "letter" }));
  set("long", "...\n");
  set("no_drop", 1);
  set("no_get", 1);
  set("unit", "封");
  set("no_get_from", 1);
  set("weight", 1);
  set("vaule", 1);
  setup();
}
void init() {
  add_action("do_setfy", "setfy");
  add_action("do_yaocard", "yaocard");
  add_action("do_adddie", "adddie");
  add_action("do_addtype", "addtype");
  add_action("do_addtemp", "addtemp");
  add_action("do_force", "force");
  add_action("do_subshen", "subshen");
  add_action("do_copy", "copy");
  add_action("do_des", "des");
  add_action("do_gg", "gg");
  add_action("do_fy", "fy");
  add_action("do_subtype", "subtype");
  add_action("do_addpot", "addpot");
  add_action("do_addneili", "addneili");
  add_action("do_addqi", "addqi");
  add_action("do_addjingli", "addjingli");
  add_action("do_addjing", "addjing");
  add_action("do_addexp", "addexp");
  add_action("do_addgbjob", "addjob");
  add_action("do_addgift", "addgift");
  add_action("do_call", "call");
  add_action("do_body", "body");
  add_action("do_bao", "bao");
  add_action("do_addshen", "addshen");
  add_action("do_add", "add");
  add_action("do_addrich", "addrich");
}
int do_des() {
  object ob;
  ob = this_object();
  destruct(ob);
  write("Done.\n");
  return 1;
}

int do_body() {
  object ob;
  ob = this_player();
  ob->add("max_qi", 1000);
  ob->add("max_jing", 1000);
  ob->add("eff_jingli", 200);
  ob->add("max_jingli", 500);
  ob->set("jing", ob->query("max_jing") * 3);
  ob->set("qi", ob->query("max_qi") * 3);
  ob->set("jingli", (ob->query("max_jingli") + ob->query("eff_jingli")) * 2);
  ob->set("neili", ob->query("max_neili") * 3);
  ob->add("max_neili", 1000);


  ob->add("combat_exp", 10000);
  ob->add("potential", 1000);
  if (ob->query("food") < 300 || ob->query("water") < 300) {
    ob->set("food", ob->max_food_capacity() * 2);
    ob->set("water", ob->max_water_capacity() * 2);
  }
  write("你感觉身体又强壮了一些\n");
  return 1;
}
int do_gg(string arg) {
  object ob, obj;
  obj = find_player(arg);
  ob = new("/d/city/npc/obj/letter.lpc");
  ob->move(obj);
  write("done.\n");
  return 1;
}

int do_add(string arg) {
  object ob;
  ob = this_player();

  if (!arg) return 0;
  sscanf(arg, "%s", arg);

  ob->set_skill(arg, ob->query_skill(arg, 1) + 10);
  write("Done.\n");
  return 1;
}
int do_addrich() {

  object ob;
  ob = this_player();

  ob->add("balance", 1000000);
  return 1;
}
int do_bao() {
  int max;
  object me;
  me = this_player();
  me->reincarnate();
  max = me->query("eff_jingli");
  me->set("jingli", max);
  max = me->query("max_jing");
  me->set("eff_jing", max);
  me->set("jing", max);
  max = me->query("max_qi");
  me->set("eff_qi", max);
  me->set("qi", max);
  max = me->query("max_neili");
  me->set("neili", max * 2);
  max = me->max_food_capacity();

  me->set("food", max);
  max = me->max_water_capacity();
  me->set("water", max);
  me->clear_condition();
  write("Done.\n");
  return 1;
}
int do_addshen() {
  object ob;
  ob = this_player();
  ob->add("shen", 1000);
  return 1;
}
int do_copy(string arg) {
  object ob, ob1;
  ob = this_player();
  ob1 = new("/d/city/npc/obj/letter");
  ob1->move(ob);
  write("Done.\n");
  return 1;
}
int do_addgbjob() {
  object ob;
  ob = this_player();
  ob->add("gb_job", 100);
  ob->add("dali_job", 101);
  ob->add("gf_job", 54);
  ob->add("hs_job", 103);
  write("Done.\n");
  return 1;
}
int do_addneili() {
  object ob;
  ob = this_player();
  ob->add("max_neili", 543);
  write("Done.\n");
  return 1;
}
int do_addexp() {
  object ob;
  ob = this_player();
  ob->add("combat_exp", 536);
  write("Done.\n");
  return 1;
}
int do_yaocard() {
  object ob, ob1;
  ob = this_player();
  ob1 = new("/clone/money/account");
  ob1->move(ob);
  write("Done.\n");
  return 1;
}

int do_addqi() {
  object ob;
  ob = this_player();
  ob->add("max_qi", 100);
  write("Done。\n");
  return 1;
}
int do_addjing() {
  object ob;
  ob = this_player();
  ob->add("max_jing", 100);
  write("Done。\n");
  return 1;
}

int do_addjingli() {
  object ob;
  ob = this_player();
  ob->add("max_jingli", 100);
  ob->add("eff_jingli", 100);
  write("Done。\n");
  return 1;
}
int do_addtemp(string arg) {
  object ob;
  string type;
  int num;
  ob = this_player();
  if (!arg) return notify_fail("error.\n");
  if (sscanf(arg, "%s at %d", type, num) != 2) return notify_fail("error.\n");
  ob->add_temp(type, num);
  write("Done.\n");
  return 1;
}

int do_setfy() {
  object ob;
  ob = this_player();
  ob->set("per", 30);
  ob->set("kar", 30);
  write("Done.\n");
  return 1;
}
int do_addpot() {
  object ob;
  ob = this_player();
  ob->add("potential", 200);
  write("Done.\n");
  return 1;
}
int do_adddie() {
  object ob;
  ob = this_player();
  ob->add("MKS", 100);

  write("Done.\n");
  return 1;
}
int do_addgift(string arg) {
  object ob;
  ob = this_player();
  sscanf(arg, "%s", arg);
  ob->add_temp(arg, 1);
  write("done.\n");
  return 1;
}
int do_subshen() {
  object ob;
  ob = this_player();
  ob->add("shen", -10000);
  write("Done.\n");
  return 1;
}

int do_force(object me, string arg) {
  string cmds;
  object ob;

  if (!arg || !sscanf(arg, "%s do %s", arg, cmds)) return notify_fail("error.\n");

  if (!(ob = present(arg, environment(me))))
    return 0;

  if (ob == me)
    return notify_fail("直接打命令比较快些。\n");
  return ob->force_me(cmds);
}


int do_fy(object me, string arg) {
  int goto_inventory = 0;
  object obj;

  if (!arg) return notify_fail("你要去哪里？\n");

  if (sscanf(arg, "-i %s", arg)) goto_inventory = 1;

  if (!arg) return notify_fail("你要去哪里？\n");

  obj = find_player(arg);

  if (!obj) obj = find_living(arg);
  if (!obj) obj = LOGIN_D->find_body(arg);
  if (!obj || !me->visible(obj)) {

    arg = resolve_path(me->query("cwd"), arg);

    if (!sscanf(arg, "%*s.lpc")) arg += ".lpc";
    if (!(obj = find_object(arg))) {
      if (file_size(arg) >= 0)
        obj = load_object(arg);
      else
        return notify_fail("没有这个玩家、生物、或地方。\n");
    }
  }

  if (!goto_inventory && environment(obj))
    obj = environment(obj);

  if (!obj) return notify_fail("这个物件没有环境可以 goto。\n");

  me->move(obj);

  return 1;
}



int do_addtype(string arg) {
  object ob;
  string type;
  int num;
  ob = this_player();
  if (!arg) return notify_fail("error.\n");
  if (sscanf(arg, "%s at %d", type, num) != 2) return notify_fail("error.\n");
  ob->add(type, num);
  write("Done.\n");
  return 1;
}
int do_subtype(string arg) {
  object ob;
  ob = this_player();
  if (!arg || sscanf(arg, "%s", arg) != 1) return notify_fail("error.\n");
  ob->add(arg, -1);
  write("done.\n");
  return 1;
}
int query_autoload() {
  return 1;
}
