    "这人光头黑发，黑布蒙面，只露出一双冷电般的眼睛。
他是契丹英雄，年纪虽老，不减犷悍之气。\n");
  set("gender", "男性");
  set("age", 56);
  set("attitude", "peaceful");
  set("shen", -18000);
  set("str", 35);
  set("int", 30);
  set("con", 25);
  set("dex", 35);
  set("per", 21);
  set("eff_jingli", 2000);
  set("max_qi", 2500);
  set("max_jing", 2500);
  set("jiali", 100);
  set("combat_exp", 1800000);
  set("chat_chance_combat", 60);
  set_skill("strike", 220);
  set_skill("sword", 220);
  set_skill("dodge", 220);
  set_skill("parry", 220);
  set_skill("staff", 220);
  set_skill("finger", 220);
  set_skill("force", 220);
  set_skill("literate", 220);

  set_skill("banruo-zhang", 240);
  set_skill("shaolin-shenfa", 240);
  set_skill("nianhua-zhi", 240);
  set_skill("yijin-jing", 240);
  set_skill("buddhism", 240);
  set_skill("pudu-zhang", 240);

  map_skill("force", "yijin-jing");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("parry", "nianhua-zhi",);
  map_skill("strike", "banruo-zhang");
  map_skill("staff", "pudu-zhang");
  map_skill("finger", "nianhua-zhi");

  prepare_skill("strike", "banruo-zhang");
  prepare_skill("finger", "nianhua-zhi");

  setup();
  carry_object("/d/shaolin/obj/xuan-cloth")->wear();


}
