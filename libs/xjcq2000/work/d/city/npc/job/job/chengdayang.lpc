//chengdayang 成大洋

inherit NPC;

void create() {
  set_name("成大洋", ({ "cheng dayang", "cheng", "dayang" }));
  set("nickname", "飞鱼帮帮主");
  set("long", "一个魁梧之极的大汉，脸庞极尽苍桑，精神却甚矍铄。\n");
  set("gender", "男性");
  set("age", 32);
  set("attitude", "peaceful");
  set("shen", 10000);
  set("str", 20 + random(10));
  set("int", 35 + random(10));
  set("con", 25 + random(10));
  set("dex", 27 + random(10));

  set("max_qi", 2500 + random(2000));
  set("max_jing", 2500 + random(2000));
  set("jiali", 120);
  set("combat_exp", 1200000 + random(800000));

  set_skill("force", 160 + random(50));
  set_skill("huagong-dafa", 180 + random(50));
  set_skill("dodge", 190 + random(50));
  set_skill("longzhua-gong", 160 + random(50));
  set_skill("parry", 190 + random(50));
  set_skill("xiaoyaoyou", 190 + random(50));
  set_skill("strike", 180 + random(50));
  set_skill("claw", 180 + random(50));
  set_skill("literate", 150 + random(50));
  set_skill("sword", 180 + random(50));
  set_skill("taiji-jian", 180 + random(50));
  set_skill("jinshe-zhangfa", 180 + random(50));
  set_skill("finger", 150 + random(50));
  map_skill("force", "huagong-dafa");
  map_skill("dodge", "xiaoyaoyou");
  map_skill("finger", "yizhi-chan");
  map_skill("blade", "fanliangyi-dao");
  map_skill("claw", "longzhua-gong");
  map_skill("parry", "jingang-quan");
  map_skill("sword", "taiji-jian");
  prepare_skill("claw", "longzhua-gong");
  prepare_skill("strike", "jinshe-zhangfa");

  setup();
  carry_object("clone/weapon/sword/sword")->wield();
  carry_object("/clone/misc/cloth")->wear();
  add_money("gold", 1);
}

#include "/d/city/npc/job/npc.h"
