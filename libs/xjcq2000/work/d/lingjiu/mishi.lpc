inherit ROOM;
#include <ansi.h>

int do_look(string arg);
int do_yanxi(string arg);
void create() {
  set("short", "密室");
  set("long", @LONG
你走着走着，突然发现你来到一间密室之内，旁边点着一盏发黄
的油灯，突然你在昏黄的灯光下，隐约发现两边的汉白玉墙壁上刻着
一些奇怪的图画(tuhua)。似乎是天女飞仙又似乎是....
LONG);
  set("item_desc", ([
    "tuhua": "一个女子正在翩翩起舞。\n",
  ]));

  set("exits", ([
    "out": __DIR__ "midao13",
  ]));
  set("no_clean_up", 0);
  setup();
  //        replace_program(ROOM);
}
void init() {
  add_action("do_yanxi", "yanxi");
  add_action("do_look", "look");
}

void relay_revive(object me) {
  add_action("do_yanxi", "yanxi");
  add_action("do_look", "look");
}
int do_look(string arg) {
  object me = this_player();

  if (me->query("family/master_name") != "天山童姥"
    || me->query_skill("sword", 1) < 150
    || me->query_skill("bahuang-gong", 1) < 150
    || me->query_int() < 40
    || !me->query_temp("babulongnvjian")) {
    set("long", @LONG
你走着走着，突然发现你来到一间密室之内，旁边点着一盏发黄
的油灯，突然你在昏黄的灯光下，隐约发现两边的汉白玉墙壁上刻着
一些奇怪的图画(tuhua)。似乎是天女飞仙又似乎是....
LONG
    );
    me->look(arg);
  } else {
    if (!arg) {
      set("long", @LONG
你走着走着，突然发现你来到一间密室之内，旁边点着一盏发黄
的油灯，突然你在昏黄的灯光下，隐约发现两边的汉白玉墙壁上刻着
一些奇怪的图画(tuhua)。旁边似乎还写了一些小字(code)
LONG
      );
      me->look(arg);
    } else if (arg == "code" || arg == "xiaozi" || arg == "wenzi") {
      write("八部龙女剑，剑阵动天下，龙女舞灵鹫(dragon)，留待有缘人。\n");
      me->set_temp("babulongnvjian1", 1);
      return 1;
    } else if ((arg == "tuhua" || arg == "dragon") && me->query_temp("babulongnvjian1")) {
      write("你发现图画中女子的动作似乎暗合某种剑法之意!看来得静静的研习(yanxi)一番了。\n");
      me->set_temp("babulongnvjian2", 1);
      return 1;
    }
  }
}
int do_yanxi(string arg) {
  object me;

  me = this_player();
  if (me->query_skill("babulongnv-jian", 1) >= 1)
    return notify_fail("你已经学会了这套剑法的基础，这图再也不能教你什么了!\n");
  if (!arg || (arg != "tuhua"))
    return notify_fail("什么？\n");
  if (!me->query_temp("babulongnvjian2"))
    return notify_fail("你想了半天也想不明白图画里的女子到底在做什么，还是放弃算了\n");

  if (random(25) > 10) {
    me->add("jing", (-15) * random(5));
    me->set_skill("babulongnv-jian", 1);
    write("你跟随着画中人翩翩起舞，蓦得灵光一现，似乎学会了一个全新的剑法!\n");
    CHANNEL_D->do_channel(this_player(), "rumor", BRED HIY "学会了八部龙女剑了\n\n" NOR);
  } else {
    write("你跟随着画中人翩翩起舞，脚步越来越快，一股内息无法调节，结果全身火烫，走火入魔了!\n");
    me->die();
  }
  return 1;

}
