// chaoyang.c 朝阳峰
inherit ROOM;
#include <ansi.h>
void create() {
  set("short", "朝阳峰");
  set("long", @LONG
这里就是华山的东峰—朝阳峰，於此俯瞰，黄河隐显东迤如带，南望
小孤峰背倚山河。东壁悬崖上，更有一个巨型掌印，相传为「河神巨灵」
劈山时所留下的。
LONG
  );
  set("exits", ([
    "westdown": __DIR__ "zhenyue",
  ]));
  set("outdoors", "华山");

  setup();
}

void init() {
  object me = this_player();
  object ob = this_object();
  object weapon = me->query_temp("weapon");
  if (me->query("family/family_name") == "华山派"
    && me->query_int() >= 28

    && weapon
    && weapon->query("skill_type") == "sword"
    && me->query_skill_mapped("sword") == "huashan-jianfa"
    && me->query("kar") >= 28
    && me->query("hswork") >= 1000
    && me->query_skill("sword") > 90
    && me->query_skill("huashan-jianfa") > 90
    && me->query("neili") > 500
    && me->query_skill("zixia-gong") > 90
    && random(10) <= 9) {
    tell_object(me, YEL "你站在朝阳峰顶上象下俯望华山美丽的风景，突然看到一位老者正在舞剑。\n" NOR);
    call_out("do_wujian", 4, me);
  }
  if (!me->query("not_bai_feng")) add_action("do_bihua", "bihua");
}

void do_wujian() {
  object me = this_player();
  //      object weapon = me->query("weapon");
  //      object name = weapon->query("name");
  tell_object(me, HIC "只见那位老者剑数精妙绝伦，你禁不住也跟着比划" HIR "(bihua)" HIC "起来。\n" NOR);
}
int do_bihua() {
  object me, weapon;
  me = this_player();
  weapon = me->query_temp("weapon");
  if (!objectp(weapon)) return notify_fail("你手中沒有劍，如何練呢？\n");
  if (me->query_temp("bai_feng")) return 0;
  message_vision(HIY "$N情不自禁的随着老者开始舞剑。\n" NOR, me);
  me->start_busy(5);
  call_out("bihua2", 4, me);
  return 1;
}
int bihua2(object me) {
  if (me->query_temp("bai_feng")) return 0;
  random(100) > 80 ? me->set("bai_feng", 1) : me->set("not_bai_feng", 1);
  message_vision(HIC "忽然，山上的老者发现$N也在舞剑后，“哼！……”了一声，急急的走了……\n" NOR, me);
  return 1;
}
