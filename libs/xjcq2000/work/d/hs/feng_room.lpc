// created by yixian

inherit ROOM;


void create() {
  set("short", "小木屋");
  set("long", "这是一个很普通的小木屋，四面的木头都已经烂了，已经看不\n出来这里有人住了。\n");
  set("exits", ([
    "north": "/d/village/shulin4",
  ]));
  setup();
}
void init() {
  object ob;
  ob = this_player();
  if (ob->query("family/master_name") == "风清扬")
    add_action("do_lingwu", "lingwu");
}
int do_lingwu() {
  object ob;
  ob = this_player();
  if (ob->is_busy() || ob->is_fighting()) return notify_fail("你现在正在忙着呢。\n");
  if ((int)ob->query("potential") < 1)
    return notify_fail("你从实战中得到的潜能已经用完了。\n");
  if (ob->query("jing") < 200) return notify_fail("你的精不够。\n");

  ob->start_busy(2);
  ob->improve_skill("dugu-jiujian", ob->query_int() * 3 / 2);
  message_vision("$N正在暝思苦想剑法上的问题。\n", ob);
  ob->add("jing", -20);
  ob->add("potential", -3);

  return 1;

}
