// xiaozhu-rest.c
// by KEN.Q.Z.ZHANG

#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIW "东廊" NOR);
  set("long", @LONG
走廊的东面是女弟子休息的地方，北面是男弟子休息的地方。
LONG);
  set("exits", ([ /* sizeof() == 2 */
    "east": __DIR__ "nu-xiuxishi",
    "north": __DIR__ "nan-xiuxishi",
    "west": __DIR__ "xiaozhu",
  ]));
  set("no_clean_up", 0);
  setup();
}

int valid_leave(object me, string dir) {
  if (wizardp(me)) return ::valid_leave(me, dir);
  if (me->query("gender") != "女性" && dir == "east")
    return notify_fail("看清楚点，那里是女弟子的休息室 ！\n");
  if (me->query("gender") != "男性" && dir == "north")
    return notify_fail("看清楚点，那里是男弟子的休息室 ！\n");
  return ::valid_leave(me, dir);
}
