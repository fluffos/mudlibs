#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIW "思过崖" NOR);
  set("long", @LONG
这是华山的思过崖。危崖上有个山洞(hole)，是华山派历代弟子犯规后囚禁受罚之
所。崖上光秃秃的寸草不生，更无一株树木。这危崖自来自来相传是玉女发钗上的一颗
珍珠，当年华山派的祖师以此危崖为惩罚弟子之所，主要是便此一处无草无木，无虫无
鸟，受罚的弟子在面壁思过之时，不致为外物所扰，心有旁鹜。
LONG);
  set("item_desc", ([
    "hole": "一个小山洞，似乎能走(enter)进去。\n",
  ]));
  set("exits", ([ /* sizeof() == 3 */
    "enter": __DIR__ "hole",
    "down": __DIR__ "yunu-siguo-4",
  ]));
  set("outdoors", "huashan");
  set("no_clean_up", 0);
  setup();
}
