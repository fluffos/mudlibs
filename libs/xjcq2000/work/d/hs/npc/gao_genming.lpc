// gao_genming.c 高根明

inherit NPC;
inherit F_MASTER;

void create() {
  set_name("高根明", ({ "gao genming", "gao", "genming" }));
  set("long",
    "双眼闪闪，颇有心计的是施戴子，手中总是拿着个算盘，他在同门中排行第五。\n");
  set("gender", "男性");
  set("age", 25);
  set("attitude", "peaceful");
  set("vendetta_mark", "authority");
  set("shen_type", 1);
  set("str", 23);
  set("int", 23);
  set("con", 23);
  set("dex", 23);

  set("max_qi", 400);
  set("max_jing", 200);
  set("neili", 400);
  set("max_neili", 400);
  set("jiali", 20);
  set("combat_exp", 40000);
  set("score", 5000);

  set_skill("sword", 50);
  set_skill("dodge", 50);
  set_skill("unarmed", 50);
  set_skill("force", 50);
  set_skill("parry", 50);
  set_skill("literate", 50);
  set_skill("hunyuan-zhang", 60);
  set_skill("strike", 60);
  set_skill("huashan-jianfa", 50);
  set_skill("huashan-shenfa", 50);
  set_skill("zixia-gong", 50);

  map_skill("force", "zixia-gong");
  map_skill("strike", "hunyuan-zhang");
  map_skill("parry", "huashan-jianfa");
  map_skill("sword", "huashan-jianfa");
  map_skill("dodge", "huashen-shenfa");
  prepare_skill("strike", "hunyuan-zhang");
  create_family("华山派", 14, "弟子");

  setup();
  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/clone/misc/cloth")->wear();

}
