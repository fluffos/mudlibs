#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int ask_book();

void create()
{
	set_name("岳灵珊", ( {"yue lingshan","yue","lingshan"} ) );

	set("long", "一张秀丽的瓜子脸蛋有着黑白分明的大眼睛，她就是岳不群的千金岳灵珊。 \n" );

	create_family("华山派", 14, "弟子");

	set("age", 18);
	set("gender", "女性");
	set("attitude", "peaceful");
	set("shen_type", 1);

	set("con", 24);
	set("dex", 24);
	set("int", 24);
	set("str", 24);

	set("max_jing", 220);
	set("max_neili", 300);
	set("max_qi", 300);
	set("jing", 220);
	set("neili", 300);
	set("qi", 300);

	set("jiali", 30);
	set("combat_exp", 50000);

	set("apply/attack", 30);
	set("apply/defense", 30);

	set_skill("cuff",  50);
	set_skill("dodge", 60);
	set_skill("force", 60);
	set_skill("literate", 60);
	set_skill("parry", 60);
	set_skill("sword", 60);
	set_skill("strike",50);

	set_skill("huashan-jianfa", 60);
//	set_skill("zixia-shengong", 60);
	set_skill("huashan-shenfa", 60);
	set_skill("hunyuan-zhang", 50);
	set_skill("pspy-quan", 50);

	map_skill("cuff",  "pspy-quan");
	map_skill("dodge", "huashan-shenfa");
	map_skill("force", "zixia-shengong");
	map_skill("parry", "huashan-jianfa");
	map_skill("sword", "huashan-jianfa");
	map_skill("strike","hunyuan-zhang");

	prepare_skill("cuff",	"pspy-quan");
	prepare_skill("strike",	"hunyuan-zhang");

	set("book_count", 1);
//        set("jian_count", 1);

	set("inquiry", ([
        "紫霞秘籍":(:ask_book:)
	]) );


	setup();

	carry_object("/clone/weapon/changjian")->wield();
	carry_object("/clone/misc/cloth")->wear();

}

int ask_book()
{
	object usr = this_player();
	mapping myfam;
	if ( !(myfam = usr->query("family")) || myfam["family_name"] != "华山派") return 0;
	if ( (int)usr->query_temp("masks/get_book") != 1)
	{
		command("say 紫霞秘籍我只听爹爹说过，但从来没有见过。");
		usr->set_temp("masks/get_book",1);
	}
	else
		command("say 你怎么问个没完没了的，烦死人了！");
	return 1;
}


int accept_object(object me, object ob)
{
	object usr,book;
	mapping myfam;
	usr = this_player();
	if ( !(myfam = usr->query("family")) || myfam["family_name"] != "华山派") return 0;
        if ((string)ob->query("name") !="碧水剑")		return 0;
	if ( usr->query_temp("masks/get_book") != 1 )	return 0;
        call_out("destroy", 1, ob);
	write("岳灵珊喜出望外：你既然找回了“碧水剑”，一定我大师兄的好朋友！\n");
	if (query("book_count") < 1 )
	{
	write("然后又悄悄对你的说道：紫霞秘籍已经托人去给大师兄了。\n");
	message("vision", "你看见岳灵珊神色紧张跟"+usr->name()+"小声说着话，好象在谈论什么大事。\n", 
		environment(usr), ({ usr }) );
	usr->delete_temp("masks/get_book");
	return 1;
	}
	else
	{
	write("岳灵珊偷偷摸摸塞给了你一本小册子，然后小声的说到：“这是我从
爹爹那儿偷来的《紫霞秘籍》，你赶快拿去救大师兄吧！\n");
	message("vision", "你看见岳灵珊偷偷摸摸塞给了"+usr->name()+"一本小册子。\n",
		environment(usr), ({ usr }) );
	usr->delete_temp("masks/get_book");
	book = new(__DIR__"obj/zixia-miji");
	book->move(usr);
	add("book_count", -1);
	return 1;
	}

}

void destroy(object ob)
{
        destruct(ob);
        return;
}