// yue_buqun.c 岳不群
inherit NPC;
inherit F_MASTER;
#include <ansi.h>
string ask_yinyin();
string ask_zhengqi();
string ask_me1();
string ask_me2();
string ask_work();
void create() {
  set_name("岳不群", ({ "yue buqun", "yue", "buqun" }));
  set("title", "华山派第十三代掌门人");
  set("nickname", "君子剑");
  set("long", "这就是在江湖中侠名远播，疾恶如仇，华山派掌门人。\n");
  set("age", 40);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);

  set("max_qi", 1800);
  set("qi", 1800);
  set("max_jing", 1400);
  set("jing", 1400);
  set("max_jingli", 1700);
  set("jingli", 1700);
  set("max_neili", 2000);
  set("neili", 2000);
  set("jiali", 50);
  set("combat_exp", 500000);
  set("score", 30000);
  set("chat_chance_combat", 40);
  set("chat_msg_combat", ({
    (: perform_action, "strike.wuji" :),
    (: perform_action, "sword.jianmang" :),
  }));
  set_skill("strike", 170);
  set_skill("hunyuan-zhang", 170);
  set_skill("sword", 170);
  set_skill("dodge", 170);
  set_skill("force", 170);
  set_skill("parry", 170);
  set_skill("literate", 170);
  set_skill("zixia-gong", 170);
  set_skill("huashan-jianfa", 170);
  set_skill("huashan-shenfa", 170);
  set_skill("ziyin-yin", 170);
  set_skill("zhengqi-jue", 170);

  map_skill("dodge", "huashan-shenfa");
  map_skill("force", "zixia-gong");
  map_skill("sword", "huashan-jianfa");
  map_skill("parry", "huashan-jianfa");
  map_skill("strike", "hunyuan-zhang");
  prepare_skill("strike", "hunyuan-zhang");
  create_family("华山派", 13, "掌门");


  set("inquiry", ([
    "惩恶扬善": (: ask_me1 :),
    "紫氤吟": (: ask_yinyin :),
    "复命": (: ask_me2 :),
    "功劳": (: ask_work :),
    "正气诀": (: ask_zhengqi :),

  ]));

  set("book_count", 1);

  setup();
  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/clone/misc/cloth")->wear();
}

void init() {
  object me, ob;
  ::init();
  ob = this_player();
  me = this_object();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }

}
void greeting(object me) {
  mapping myfam;
  int shen;
  myfam = (mapping)me->query("family");
  shen = me->query("shen");

  if (!myfam) command("say 不知到我华山有何事情？");
  else if (shen > 0 && shen < 100000) command("say 我华山弟子要多做侠义之事，你做的还不够？");
  else if (shen < 0 && myfam["family_name"] == "华山派") {


    command("say 你满眼瘴气，身带邪气，从今天起你不再是华山弟子了！");
    command("expell " + me->query("id"));
  } else command("say 你的功夫进展如何了？");
}

void attempt_apprentice(object ob) {
  mapping fam;
  if (mapp(fam = ob->query("family")) && (string)fam["family_name"] != "华山派" && (int)ob->query("is/huashan") == 1) {
    message_vision(CYN "$N！你这个华山派的叛徒还回来干什么 ？？？\n" NOR, ob);
    command("slap " + ob->query("id"));
    return;
  }
  if (ob->query("gender") != "男性") {
    command("say 我只收男徒" + RANK_D->query_respect(ob) + "请回吧。");
    return;
  }
  if ((int)ob->query("shen") < 0) {
    command("say 我华山派乃是堂堂名门正派，对弟子要求极严。");
    command("say 在德行方面，" + RANK_D->query_respect(ob) +
      "是否还做得不够？");
    return;
  }
  command("say 好吧，我就收下你了,你可要为我们华山派争口气。");
  ob->set("is/huashan", 1);
  command("recruit " + ob->query("id"));
}

string ask_me1() {
  string msg;
  mapping fam;
  int i;
  object ob, me, name1, ling;
  me = this_player();
  ob = this_object();
  ling = present("ling pai", me);
  name1 = me->query("id");
  i = me->query("shen");

  if ((int)me->query_condition("hs_job_busy") > 0)
    return "你等一会再来吧!";
  if (!(fam = this_player()->query("family")) || fam["family_name"] != "华山派")
    return "你不是华山弟子，不能接这个任务。";
  if (me->query_condition("gb_mission")
    || me->query_condition("gb_busy")
    || me->query_condition("xx_task"))
    return "你现在正忙着做任务呢！";

  if (i <= 5000)
    return "你的侠义正气太低了，我怎么能放心把任务交给你呢？\n";

  if (me->query_temp("hs/jobji"))
    return "你不能光说呀，到是做出点成绩给我看看！\n";

  ob = new("/d/hs/obj/ling");
  me->set_temp("hs/jobji", 1);
  command("nod " + me->query("id"));
  ob->move(me);
  ob->set_temp("hsjob", name1);
  tell_object(me, HIC "岳不群给你一只令牌。\n");
  return "听说现在山下出现一些恶贼，你去巡视一下，遇到恶人不可手软。\n";
}

string ask_yinyin() {
  mapping fam;
  object me, ob;
  int shen, exp, i;
  me = this_player();
  ob = this_object();
  shen = (int)me->query("shen", 1);
  exp = (int)me->query("combat_exp", 1);
  i = (shen - exp);
  fam = me->query("family");
  if (!fam || fam["family_name"] != "华山派")
    return RANK_D->query_respect(me) + "与本派素无来往，不知此话从何谈起？\n";
  if (i < 1000)
    return "你的侠义之气不够，如何叫我指点你的紫氤吟？\n";
  if ((int)me->query_skill("ziyin-yin", 1) < 150)
    return "你的紫氤吟未到火候，恐怕我无法指点你。\n";
  if ((int)me->query("jing", 1) < 100)
    return "你现在身体状况太差了，你无法领悟紫氤吟的绝妙之处。\n";
  if ((int)me->query("potential", 1) < 1)
    return "你现在潜能不足，我无法指点你关于紫氤吟。\n";
  me->improve_skill("ziyin-yin", 200);
  me->add("shen", -1000);
  me->receive_damage("jing", 100);
  tell_object(me, HIC "你感到你的紫氤吟进步了。\n" NOR);
  return "好吧，既然你问起我紫氤吟，我就指点你一下。\n";

}

string ask_zhengqi() {
  mapping fam;
  object me, ob;
  int shen, exp, i;
  me = this_player();
  ob = this_object();
  shen = (int)me->query("shen", 1);
  exp = (int)me->query("combat_exp", 1);
  i = (shen - exp);
  fam = me->query("family");
  if (!fam || fam["family_name"] != "华山派")
    return RANK_D->query_respect(me) + "与本派素无来往，不知此话从何谈起？\n";
  if (i < 1000)
    return "你的侠义之气不够，如何叫我指点你的正气诀？\n";
  if ((int)me->query_skill("zhengqi-jue", 1) < 150)
    return "你的正气诀未到火候，恐怕我无法指点你。\n";
  if ((int)me->query("jing", 1) < 100)
    return "你现在身体状况太差了，你无法领悟正气诀的绝妙之处。\n";
  if ((int)me->query("potential", 1) < 1)
    return "你现在潜能不足，我无法指点你关于正气诀。\n";
  me->improve_skill("zhengqi-jue", 200);
  me->add("shen", -1000);
  me->receive_damage("jing", 100);
  tell_object(me, HIC "你感到你的正气诀进步了。\n" NOR);
  return "好吧，既然你问起我正气诀，我就指点你一下。\n";

}

string ask_me2() {
  return "你的令牌呢？\n";
}

int accept_object(object me, object ling) {
  object name1;
  name1 = me->query("id");

  if (!ling)
    return notify_fail("你的令牌呢？\n");

  if (ling->query("id") != "ling pai")
    return 0;

  if (ling->query_temp("mmr") != name1)
    return notify_fail("这是你的令牌么？\n");
  if (me->query_temp("hsjob1")) return notify_fail("看你够辛苦大的了，先休息休息会吧。\n");
  // Will add more temp 
  if (ling->query_temp("hsjob") != name1)
    return notify_fail("这是你的令牌么？..........\n");

  if ((int)ling->query_temp("done", 1) < 4)
    return notify_fail("你还没完成师傅的任务呢。\n");

  if (!me->query_temp("hs/jobji"))
    return notify_fail("你还没有跟师傅领任务呢。\n");

  write("岳不群看了看令牌上的字。\n", me);
  command("haha " + me->query("id"));
  command("pat " + me->query("id"));
  command("say 好样的！你下去休息吧。\n");
  me->add("combat_exp", 150);
  me->add("hswork", 1);
  me->add("potential", 120);
  me->delete_temp("hs/jobji");
  me->set("job/ok", 4);
  call_out("destroying", 1, ling);
  me->set_temp("hsjob1", 1);
  me->start_call_out((: call_other, me, "delete_temp", "hsjob1" :), 180 + random(60));
  return 1;
}

void destroying(object ling) {
  destruct(ling);
  return;
}
string ask_work() {
  object me;
  int i;
  me = this_player();
  i = (int)me->query("hswork");
  if (!me->query("hswork"))
    return "你没做过任务，跑来问什么功劳呢?";
  message_vision("岳不群对$N说道，你目前做了" + chinese_number(i) + "次任务！\n", me);
  return "继续努力吧！。";
}
