// waiter.c 茶博士

inherit NPC;
inherit F_DEALER;

void create() {
  set_name("茶博士", ({ "cha boshi", "waiter" }));
  set("gender", "男性");
  set("age", 50);
  set("shen", 100);
  set("long",
    "这位茶博士靠在华山卖茶维生，由于岁月的流逝，他额头上布满皱纹。\n");
  set("combat_exp", 300);
  set("attitude", "friendly");
  set("vendor_goods", ({
    __DIR__ "obj/wan",
    __DIR__ "obj/tao"
  }));
  setup();
  carry_object("/clone/misc/cloth")->wear();
}

void init() {
  object ob;
  ::init();
  add_action("do_buy", "buy");
  add_action("do_kill", "kill");
  add_action("do_hit", "hit");
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  say("茶博士笑咪咪地说道：这位" + RANK_D->query_respect(ob)
    + "，进来喝杯茶，歇歇腿吧。\n");
}

int do_kill(string arg) {
  object usr, ob;
  usr = this_player();
  ob = this_object();
  if (environment(usr)->query("no_fight")) return 0;
  if (!arg) return 0;
  if (!objectp(ob = present(arg, environment(ob)))) return 0;
  if (ob->query("name") == "茶博士" && !userp(ob)) {
    command("chat* 茶博士瞪大眼，对着" + usr->name() + "大声喊道：“左右是个死，大爷我跟你拼了！”\n");
    kill_ob(usr);
    usr->kill_ob(ob);
    return 1;
  }
  return 0;
}

int do_hit(string arg) {
  object usr, ob;
  usr = this_player();
  ob = this_object();
  if (environment(usr)->query("no_fight")) return 0;
  if (!arg) return 0;
  if (!objectp(ob = present(arg, environment(ob)))) return 0;
  if (ob->query("name") == "茶博士" && !userp(ob)) {
    command("chat* 茶博士" + "被" + usr->query("name") + "吓得脸都白了。\n");
    fight_ob(usr);
    usr->fight_ob(ob);
    return 1;
  }
  return 0;
}
