// gao.c 高老者
#include <ansi.h>
inherit NPC;
inherit F_MASTER;

string ask_me();

void create() {
  set_name("高老者", ({ "gao laozhe", "gao" }));
  set("title", "华山派第十二代弟子");
  set("long", "这就是在江湖中隐居的华山派高老者。");
  set("age", 50);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("str", 32);
  set("int", 32);
  set("con", 32);
  set("dex", 32);

  set("max_qi", 1800);
  set("qi", 1800);
  set("max_jing", 1400);
  set("jing", 1400);
  set("max_jingli", 1700);
  set("jingli", 1700);
  set("max_neili", 2000);
  set("neili", 2000);
  set("jiali", 50);
  set("combat_exp", 650000);
  set("score", 30000);
  set("chat_chance_combat", 40);
  set("chat_msg_combat", ({
    (: perform_action, "blade.hebi" :),
  }));
  set_skill("blade", 170);
  set_skill("dodge", 170);
  set_skill("force", 170);
  set_skill("poyu-quan", 170);
  set_skill("cuff", 170);
  set_skill("parry", 170);
  set_skill("literate", 170);
  set_skill("zixia-gong", 170);
  set_skill("fanliangyi-dao", 170);
  set_skill("huashan-shenfa", 170);
  set_skill("ziyin-yin", 170);
  set_skill("zhengqi-jue", 170);

  map_skill("dodge", "huashan-shenfa");
  map_skill("force", "zixia-gong");
  map_skill("blade", "fanliangyi-dao");
  map_skill("parry", "fanliangyi-dao");
  map_skill("cuff", "poyu-quan");
  prepare_skill("cuff", "poyu-quan");
  create_family("华山派", 12, "弟子");

  setup();
  carry_object(__DIR__ "../obj/gangdao")->wield();
  carry_object("clone/misc/cloth")->wear();
}
void kill_ob(object me) {
  ::kill_ob(me);
}
void attempt_apprentice(object ob) {
  mapping fam;
  if (mapp(fam = ob->query("family")) && (string)fam["family_name"] != "华山派" && (int)ob->query("is/huashan") == 1) {
    message_vision(CYN "$N！你这个华山派的叛徒还回来干什么 ？？？\n" NOR, ob);
    command("slap " + ob->query("id"));
    return;
  }
  if ((int)ob->query("shen") <= 0) {
    command("say 我华山派乃是堂堂名门正派，对弟子要求极严。");
    command("say 在德行方面，" + RANK_D->query_respect(ob) +
      "是否还做得不够？");
    return;
  }

  if ((int)ob->query_skill("zixia-gong") < 50) {
    command("say 你的紫霞神功还未到火候,老朽我可不能收你为徒。\n");
    return;
  }

  if ((int)ob->query_skill("force") < 50) {
    command("say 你的内功还未到火候,老朽我可不能收你为徒。\n");
    return;
  }

  command("say 好吧，我就收下你了,你可要为我们华山派争口气。");
  ob->set("is/huashan", 1);
  command("recruit " + ob->query("id"));
}
