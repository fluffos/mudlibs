#include <room.h>
inherit ROOM;
void create() {
  set("short", "树林");
  set("long", @LONG
这是一片乱树林。几十丈高的树木簇在一块，密实的枝叶象一蓬蓬巨伞
般伸向天空，把阳光遮得丝毫也无。你一走进这这觉得阴阴森林的，你的感
觉告诉你，得赶快离开。
LONG);
  set("exits", ([
    "east": __DIR__ "shuling2",
    "west": __DIR__ "shenchu4",
    "south": __DIR__ "shuling5",
    "north": __DIR__ "shuling6",
  ]));
  set("objects", ([
    "/d/mingjiao/npc/chang": 1,
  ]));
  set("outdoors", "明教光明顶");
  setup();
  replace_program(ROOM);
}

void init() {
  string a, b, c, d;
  a = query("exits/west");
  b = query("exits/north");
  c = query("exits/south");
  d = query("exits/east");

  set("exits/north", a);
  set("exits/south", b);
  set("exits/west", c);
  set("exits/east", d);
}
