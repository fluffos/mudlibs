#include <room.h>
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "秘室");
  set("long", @LONG
这里是明教秘道里的一间小秘秘室。
LONG
  );

  set("exits", ([
    "south": __DIR__ "bidao15",
  ]));
  set("objects", ([
    "/d/mingjiao/npc/cheng": 1,
  ]));
  setup();
}
int valid_leave(object me, string dir) {
  if (dir == "out") {
    write(HIW "\n你出得洞来，强光闪耀，一时之间竟然睁不开眼。\n\n" NOR);
  }
  return 1;
}
