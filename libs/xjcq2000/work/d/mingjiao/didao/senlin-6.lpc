#include <room.h>
inherit ROOM;
void create() {
  set("short", "紫杉林");
  set("long", @LONG
这里是明教光明顶上的一片紫杉林。周围全是几十丈高的紫杉，密实的
枝叶象一蓬蓬巨伞般伸向天空，把阳光遮得丝毫也无。你一走进这阴阴的森林
直觉便告诉你，得赶快离开。
LONG);
  set("exits", ([
    "northwest": __DIR__ "senlin-" + (1 + random(8)),
    "west": "/d/mingjiao/jinqi",
    "southwest": __DIR__ "senlin-7",
    "northeast": __FILE__,
  ]));
  set("outdoors", "明教光明顶");
  setup();
}
