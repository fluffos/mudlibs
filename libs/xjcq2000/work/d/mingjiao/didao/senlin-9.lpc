#include <room.h>
inherit ROOM;

void create() {
  set("short", "紫杉林");
  set("long", @LONG
这里是明教光明顶上的一片紫杉林。周围全是几十丈高的紫杉，密实的
枝叶象一蓬蓬巨伞般伸向天空，把阳光遮得丝毫也无。你一走进这阴阴的森
林，直觉便告诉你得赶快离开。
LONG);
  set("exits", ([
    "north": __DIR__ "men-tian",
    "south": __DIR__ "men-di",
    "east": __DIR__ "men-feng",
    "west": __DIR__ "men-lei",
  ]));
  set("outdoors", "明教光明顶");
  setup();
}

