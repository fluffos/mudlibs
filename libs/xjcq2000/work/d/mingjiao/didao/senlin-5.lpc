#include <room.h>
inherit ROOM;
void create() {
  set("short", "紫杉林");
  set("long", @LONG
这里是明教光明顶上的一片紫杉林。周围全是几十丈高的紫杉，密实的
枝叶象一蓬蓬巨伞般伸向天空，把阳光遮得丝毫也无。你一走进这阴阴的森
林，直觉便告诉你得赶快离开。
LONG);
  set("exits", ([
    "northwest": __FILE__,
    "east": "/d/mingjiao/tuqi",
    "southeast": __DIR__ "senlin-6",
    "northeast": __DIR__ "senlin-" + (1 + random(8)),
  ]));
  set("outdoors", "明教光明顶");
  setup();
}
