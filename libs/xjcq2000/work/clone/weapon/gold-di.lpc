//gold-di.c
// created by yixian

#include <ansi.h>
#include <weapon.h>

inherit SWORD;

inherit F_UNIQUE;

void create() {
  set_name(HIY "金笛" NOR, ({ "jin di", "di" }));
  set_weight(4000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "传说这是当年金笛秀才所用的笛子，周身刻满了花纺，你可以试着\n吹吹看（cui di）\n");
    set("vaule", 9000);
    set("treasure", 1);
    set("material", "steel");
    set("rigidity", 6);
    set("unit", "支");
    set("sharpness", 5);
    set("unique", 1);
    set("no_give", HIM "这是红花会的东西，你怎么能随便送人呢？" NOR);
    set("wield_msg", HIC "$N从腰中缓缓的拿出了金笛握在手中。\n" NOR);
    set("unwield_msg", CYN "$N把手中的金笛又重新揣入怀中。\n" NOR);
  }
  init_sword(70);
  setup();


}

void init() {
  if (this_player()->query("family/family_name") == "红花会" && !this_player()->is_fighting()) add_action(
    "do_cui",
    "cui"
  );
  if (this_player()->is_fighting()) remove_action("do_cui", "cui");


}

int do_cui(string arg) {
  object ob, victim;
  ob = this_player();
  if (ob->is_busy()) return notify_fail("你现在正忙着呢。\n");
  if (!stringp(arg)) return 0;
  victim = present(arg, environment(ob));
  if (!objectp(victim)) return 0;

  if (!interactive(victim)) return 0;
  if (wizardp(victim)) return 0;

  message_vision(HIY "$N把看了看手中的笛子，对着$n微微一笑，慢慢的吹了起来\n" NOR, ob, victim);
  if (random(10) > 5) {
    message_vision(CYN "$N对$n的笛声没有什么反映……\n" NOR, victim, ob);
    ob->start_busy(5);
    message_vision(HIW "$N心中暗想：“tnnd,对牛弹琴……！”\n" NOR, ob);
  } else {
    message_vision(HIG "$N完全被笛声所吸引了……\n" NOR, victim);
    victim->start_busy(5);
  }

  return 1;
}
