// tie-ling.c 铁令

#include <weapon.h>
inherit BLADE;

void create() {
  set_name("铁令", ({ "tie ling", "ling" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "这是一柄两尺来长的铁令牌。\n");
    set("value", 1000);
    set("material", "steel");
    set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n插回腰间。\n");
  }
  init_blade(20);
  setup();
}
