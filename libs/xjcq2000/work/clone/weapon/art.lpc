///u/benlong 玄天琴
#include <weapon.h>
#include <ansi.h>

inherit SWORD;

void create() {
  set_name(HIW "玄天琴" NOR, ({ "xuantian qin", "qin", "art" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 1);
    set("material", "gem");
    set("unique", 1);
    set("treasure", 1);
    set("rigidity", 5);
    set("weapon_prop/dodge", 3);
    set("weapon_prop/parry", 1);
    set("wield_neili", 500);
    set("wield_maxneili", 1000);
    set("long", "这是昆仑派掌门铁琴先生何太冲心爱之物,是用万年玄铁所铸,\n琴身黝黑黝黑,琴尾有一断痕,想是年代久远之故。\n");
    set("wield_msg", "$N伸手轻轻一招，已把$n捧在手中,铮铮之声不绝于耳。\n");
    set("unwield_msg", "$N一声清啸，将$n插回腰间。\n");
  }
  init_sword(100);
  setup();
}
