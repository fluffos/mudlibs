// ruanweijia.c
#include <armor.h>
#include <ansi.h>
inherit CLOTH;
inherit F_UNIQUE;
void create() {
  set_name(YEL "软猬甲" NOR, ({ "ruanwei jia", "jia" }));
  set_weight(4500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一件通体是刺的软甲，不知道是用什么材料做成的，坚韧
无比，刀剑不能伤。此甲数年前被由东邪黄药师所得，乃是桃花岛的镇岛之宝。\n");
    set("material", "silk");
    set("unit", "件");
    set("unique", 1);
    set("sharpness", 1);
    set("treasure", 1);
    set("rigidity", 1); ;
    set("no_get", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("wear_msg", "$N将$n穿在身上，原来$n表面是刺，穿
起来却是大小正合适。\n" NOR);
    set("remove_msg", "$N将$n从身上脱了下来，折叠成小小的一团。\n" NOR);
    set("armor_prop/armor", 150);
  }
  setup();
}
