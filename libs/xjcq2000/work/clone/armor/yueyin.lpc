#include <ansi.h>
#include <armor.h>
inherit CLOTH;
void create() {
  set_name(MAG "月影倪衫" NOR, ({ "yueyin nishan", "shan" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("no_drop", "宝物是扔/卖不了的，也不能给别人。");
    set("value", 50000);
    set("unique", 1);
    set("no_get", 1);
    set("no_drop", 1);
    set("material", "gold");
    set("armor_prop/armor", 130);
  }
  setup();
}
