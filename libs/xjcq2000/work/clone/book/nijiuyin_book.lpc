// nijiuyin zhenjing 逆九阴
// by jrx
#include <ansi.h>

inherit ITEM;
inherit F_UNIQUE;
void setup() {}

void init() {
  add_action("do_du", "kan");
}

void create() {
  set_name("逆九阴真经", ({ "nijiuyin zhenjing", "book" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long",
      "原来这就是欧阳锋自己创的《逆九阴真经》心法，好好看(kan)这本书吧。\n");
    set("value", 0);
    set("material", "paper");
    set("treasure", 1);
  }
}

int do_du(string arg) {
  object me = this_player();
  object where = environment(me);
  object ob;
  mapping skill;
  int qklevel, lvl;
  int neili_lost;

  if (arg != "nijiuyin zhenjing")
    return notify_fail("你要读什么？\n");
  if (where->query("pigging"))
    return notify_fail("你还是专心拱猪吧！\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢。\n");
  if (me->is_fighting())
    return notify_fail("你无法在战斗中专心下来研读新知！\n");
  if (!id(arg) || !objectp(ob = present(arg, me)))
    return notify_fail("你要读什么？\n");
  //        if ((string)me->query("gender") == "女性" )
  //                return notify_fail("你先天不足，要修乾坤大挪移，恐怕走火入魔。\n");
  if (!me->query_skill("literate", 1))
    return notify_fail("你是个文盲，先学点文化(literate)吧。\n");
  if (!me->query_skill("hamashengong", 1))
    return notify_fail("你没有蛤蟆神功做根坻，读什么读啊？。\n");

  if ((int)me->query("jing") < 150)
    return notify_fail("你现在过于疲倦，无法专心下来研读新知。\n");

  if ((int)me->query("neili") < 1000) {
    write(CYN "忽然，你觉得内息一乱，知道不好！\n" NOR);
    me->unconcious();
    return 1;
  }

  qklevel = me->query_skill("hamashengong", 1);
  neili_lost = qklevel / 10;
  if (neili_lost < 5) neili_lost = 5;
  lvl = qklevel / 20;
  if (lvl < 1) lvl = 1;

  message("vision", me->name() + "专心研读逆九阴真经，脸色发青忽头下脚上，神情怪异无比\n", environment(me), me);



  if ((int)me->query_skill("force", 1) < 100)
    return notify_fail("就这么点基本内功还想学逆九阴蛤蟆神功？\n");

  if ((int)me->query("max_neili", 1) < 1500)
    return notify_fail("就这么点内力还想学逆九阴蛤蟆神功？\n");

  if ((int)me->query_skill("force", 1) < lvl)
    return notify_fail("你的基本内功火候还不够，小心走火入魔！\n");

  if ((int)(me->query("max_neili", 1) / 15) < lvl)
    return notify_fail("你的内力火候还不够，小心走火入魔！\n");

  if ((int)me->query("combat_exp") < (int)qklevel * qklevel * qklevel / 10)
    return notify_fail("你的实战经验不足，再怎么读也没用。\n");


  me->improve_skill("hamashengong", (int)me->query_skill("literate", 1) / 6 + 1);
  me->improve_skill("force", (int)me->query_skill("literate", 1) / 6 + 1);
  me->set("oyf_hamagong", 10);
  me->add("jing", -(20 + random(50)));
  me->add("neili", -(20 + random(50)));
  write("你研读《逆九阴真经》，颇有心得。\n");
  return 1;
}
