// wizardb.c

inherit NPC;

int ask_name();

void create() {
  set_name("巫师B", ({ "wizardb", "wizard", "wushib", "wushi" }));
  set("gender", "男性");
  set("age", 30);
  set("long", "这是一个成天无所事事的巫师。\n");

  set("str", 17);
  set("dex", 16);
  set("con", 15);
  set("int", 17);
  set("shen_type", 1);
  set_temp("apply/defense", 10);
  set("combat_exp", 100);
  set("attitude", "peaceful");

  setup();

  set("inquiry", ([
    "name": (: ask_name :),
    "rumors": "听说9月12日下午进行比武大会。",
    "here": "再烦我杀了你！",
    "bbb": "见到大爷我，难道没有任何表示吗？",
    "杀手": "见到大爷我，难道没有任何表示吗？",
  ]));

  carry_object("/clone/misc/cloth")->wear();
}

int ask_name() {
  object ob = this_player();

  command("smash " + ob->query("id"));
  say("没搞错吧？一声不吭就smash别人？准是BBB。\n");
  return 1;
}
