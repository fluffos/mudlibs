inherit NPC;
int ask_xinxiang();
void create() {
  set_name("叶离", ({ "ye li", "ye", "li" }));
  set("gender", "男性");
  set("age", 30);
  set("long", "这就是叶雨飞早年之徒——名满天下的江湖信使，他负责传递玩家们的日常信件。\n");
  set("score", 10000);
  set("attitude", "peaceful");
  set("nickname", "江湖信使");
  set("str", 28);
  set("con", 21);
  set("int", 20);
  set("dex", 25);
  set("shen", 5000);
  set("combat_exp", 550000);
  set("inquiry", ([
    "信箱": (: ask_xinxiang :),
  ]));
  setup();
  carry_object("/d/city/obj/cloth")->wear();
}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}
void greeting(object ob) {
  if (!ob || !present(ob, environment())) return;
  command("say 这位" + RANK_D->query_respect(ob) + "，想看自己的信箱么？请ask ye li about 信箱。");
}
int ask_xinxiang() {
  object me = this_player(), ob;
  if (!me->query_temp("get_mailbox")) {
    ob = new("/clone/misc/mailbox");
    ob->move(me);
    message_vision("$N转身取出一个信箱，交给了$n,说道：“请您遵守规定，不要发垃圾邮件。”\n", this_object(), me);
    me->set_temp("get_mailbox", 1);
    return 1;
  } else {
    message_vision("$N笑了笑，道：这位朋友真是健忘，信箱不就在你手上么?”\n", this_object(), me);
    return 1;
  }
}
