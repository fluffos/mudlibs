// squall_b.c
inherit BULLETIN_BOARD;
#include <ansi.h>
void create() {
  set_name(HIY "玩家意见留言板" NOR, ({ "board" }));
  set("location", "/u/squall/workroom");
  set("board_id", "squall_b");
  set("long", "\n专门为玩家提出意见或者发现BUG所做的留言板\n"
    "\n当玩家" + HIR "发现BUG" + NOR "或者有什么" + HIY "问题和建议" + NOR "都可以在这里留言\n"
    "\n当玩家的问题解决后,请玩家自己" + HIR "删除已经解决的post" + NOR "\n"
    "\n狂风会每天来看玩家的post,并" + HIC "根据缓急解决" + NOR "\n"
    HIR "\n请玩家不要提出不合理的建议或意见,凡是不合理的post将不予理睬。\n" NOR);
  setup();
  set("capacity", 200);
}
