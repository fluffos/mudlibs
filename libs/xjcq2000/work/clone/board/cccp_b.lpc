// /u/cccp/board.c
//from kittt's board
#include <ansi.h>;
inherit BULLETIN_BOARD;
void create() {
  set_name(HIM "门派事务留言簿" NOR, ({ "board" }));
  set("location", "/u/cccp/workroom");
  set("board_id", "cccp_b");
  set("long", "玩家对门派提意见留言簿，乱灌水杀无赦。\n");
  setup();
  set("capacity", 60);
  replace_program(BULLETIN_BOARD);
}
