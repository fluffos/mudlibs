#include <ansi.h>
inherit NPC;
int do_copy(object me, int maxpot, int type);

void create() {


  //           mapping name; 
  //   name = NAME_D->man_name();
  string weapon;

  set_name("玄性大师", ({ "xuan xin" }));
  set("age", 30 + random(30));
  set("title", HIY "少林派" NOR "" HIR "罗汉堂首座" NOR);
  set("gender", "男性"); set("attitude", "peaceful");
  set("quest_npc", 1);
  set("str", 25);
  set("con", 30);
  set("int", 30);
  set("dex", 30);
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: exert_function, "jingang" :),
    (: exert_function, "powerup" :),
    (: exert_function, "recover" :),
  }));

  weapon = random(2) ? "/clone/weapon/changbian" : "/clone/weapon/gangjian";
  setup();
  carry_object(weapon)->wield();
  carry_object("/d/shaolin/obj/xuan-cloth")->wear();

}
int do_copy(object me, int maxpot, int type) {

  object ob;
  ob = this_object();

  ob->set_skill("force", me->query_skill("force", 1) + random(5));
  ob->set_skill("dodge", me->query_skill("force", 1) + random(5));
  ob->set_skill("unarmed", me->query_skill("force", 1) + random(5));
  ob->set_skill("parry", me->query_skill("force", 1) + random(5));
  ob->set_skill("blade", me->query_skill("force", 1) + random(5));
  ob->set_skill("yijinjing", me->query_skill("force", 1) + random(5));
  ob->set_skill("longzhua-gong", me->query_skill("force", 1) + random(5));
  ob->set_skill("damo-jian", me->query_skill("force", 1) + random(5));
  ob->set_skill("riyue-bian", me->query_skill("force", 1) + random(5));
  ob->set_skill("hunyuan-yiqi", me->query_skill("force", 1) + random(5));
  ob->set_skill("claw", me->query_skill("force", 1) + random(5));
  ob->set_skill("shaolin-shenfa", me->query_skill("force", 1) + random(5));
  ob->set_skill("whip", me->query_skill("force", 1) + random(5));
  ob->set_skill("wuchang-zhang", me->query_skill("force", 1) + random(5));
  ob->set_skill("club", me->query_skill("force", 1) + random(5));
  ob->set_skill("sword", me->query_skill("force", 1) + random(5));
  ob->set_skill("cibei-dao", me->query_skill("force", 1) + random(5));
  ob->map_skill("blade", "cibei-dao");
  ob->map_skill("claw", "longzhua-gong");
  ob->map_skill("unarmed", "longzhua-gong");
  ob->map_skill("club", "wuchang-zhang");
  ob->map_skill("dodge", "shaolin-shenfa");
  ob->map_skill("force", "yijinjing");
  ob->map_skill("parry", "longzhua-gong");
  ob->map_skill("sword", "damo-jian");
  ob->map_skill("whip", "riyue-bian");
  return 1;
}

void init() {
  object me, ob;
  ::init();
  ob = this_player();
  me = this_object();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  call_out("dest", 300, ob);
}
void greeting(object ob) {
  if (!ob || !present(ob, environment())) return;
  switch (random(2)) {
    case 0:
      say("玄性大师说道：这位" + RANK_D->query_respect(ob)
        + "，前来挑战少林,想必是武功高强!我们就开始吧。(fight xuan xin)\n");
      break;
    case 1:
      say("玄性大师说道：这位" + RANK_D->query_respect(ob)
        + "，前来挑战少林,想必是武功高强!我们就开始吧。(fight xuan xin)\n");
      break;
  }
}
void dest() {
  object ob = this_object();
  object me = this_player();
  message_vision(HIY "玄性大师说道：施主武艺高强，老衲诚心佩服，咱们就此别过!比武之事,他日再谈。\n" NOR, this_player());
  this_player()->move("/d/shaolin/guangchang1");
  destruct(this_object());
}



int accept_fight() {
  object ob, me;
  me = this_object();
  ob = this_player();
  remove_call_out("checking");
  call_out("checking", 1, ob, me);
  return 1;
}

int checking(object me, object ob) {
  object obj, npc;
  int my_max_qi, his_max_qi;
  int kar, exp, pot, exp_reward, rate;

  my_max_qi = ob->query("max_qi");
  his_max_qi = me->query("max_qi");
  call_out("checking", 1, me, ob);
  if (!present(me, environment())) return 1;
  if (((int)ob->query("qi") * 100 / my_max_qi) <= 70) {
    command("say 施主武功高强，在下输得心服口服!\n");
    command("chat 今日" + me->query("name") + "施主挑战少林武功，在下输得心服口服!\n");
    me->apply_condition("over_tiao", 300);
    me->move("/d/shaolin/guangchang1");
    me->apply_condition("in_tiao", 0);
    me->move("/d/shaolin/guangchang1");
    message("vision", me->name() + "战胜了少林派的弟子,增加了一些经验和潜能。\n", me);
    me->add("combat_exp", 500 + random(500));
    me->add("potential", 200 + random(500));

    destruct(this_object());
    return 1;
  }
  if (((int)me->query("qi") * 100 / his_max_qi) < 70) {
    command("say 施主的武功似乎还有待提高啊！。\n");
    me->apply_condition("over_tiao", 150); me->apply_condition("in_tiao", 0);
    me->move("/d/shaolin/guangchang1");
    destruct(this_object());
    return 1;
  }
  return 1;
}
