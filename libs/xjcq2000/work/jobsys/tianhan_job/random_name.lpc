mapping md_name() {
  mapping name;
  int i;
  i = random(sizeof(nm1_md));
  name = ([
    "name": nm1_md[i] + nm2_md[random(sizeof(nm2_md))],
    "id": id_md[i],
  ]);
  return name;
}
