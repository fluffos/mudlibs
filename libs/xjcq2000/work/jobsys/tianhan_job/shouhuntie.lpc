// tieyan-ling.c 铁焰令
#include <ansi.h>
inherit ITEM;
void create() {
  set_name(HIR "收魂贴" NOR, ({ "shouhun tie", "tie" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("long", "这就是魔教的收魂贴，据说入了收魂贴的人都将堕入万劫不复的地狱，
你可以用它来收魂（shouhun)。\n");
    set("value", 0);
    set("no_give", 1);
    set("no_get", 1);
    set("no_drop", 1);
    set("material", "iron");
  }
  setup();
}
void init() {
  add_action("mark_success", ({ "shouhun", "收魂" }));
}

int mark_success(string arg) {
  object me, target, ob;
  me = this_player();
  if (!arg) return notify_fail("你要收谁的魂？\n");
  target = present(arg, environment(me));
  if (!target) return notify_fail("找不到这个东西。\n");
  if (!target->is_corpse()) return notify_fail("看清楚点，那不是尸体。\n");
  if (target->query("no_xinzang")) return notify_fail("那具尸体已经被掏心了。\n");
  if (!target->is_character()) return notify_fail("那具尸体已经腐烂了。\n");
  message_vision(RED "$N将收魂贴的尖刺往$n的胸前猛的一拽！\n" NOR, me, target);
  ob = new("/clone/misc/xinzang");
  ob->set_name(target->query("victim_name") + "的心脏", ({ "xinzang" }));
  ob->set("long", "这是一颗" + target->query("victim_name") + "的心脏。\n");
  if (target->query("victim_user"))
    ob->set("victim_user", 1);
  if (target->query("kill_by"))
    ob->set("kill_by", target->query("kill_by"));
  ob->set("victim_id", target->query("victim_id"));
  ob->set("victim_name", target->query("victim_name"));
  if (target->query("target_id"))
    ob->set_temp("target_id");

  target->delete("kill_by");
  message_vision(RED "$n已经落入了收魂贴中，真是好残忍啊！！。\n" NOR, me, ob);
  ob->move(me);
  target->set("name", "一具被掏了心的尸体");
  target->set("no_xinzang", 1);
  target->set("long", "一具尸体，腐臭四溢，情状可怖。\n");
  return 1;
}
