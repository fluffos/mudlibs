// shizhe.c
#include <ansi.h>
inherit __DIR__ "job_npc_status.lpc";
inherit __DIR__ "job_npc_skill.lpc";
inherit __DIR__ "jobwhere.lpc";
inherit NPC;
string ask_job();
string ask_count();
void create() {
  set_name("夏侯烈", ({ "xiahou lie", "lie" }));
  set("gender", "男性");
  set("title", HIR "西夏一品堂使者" NOR);
  set("no_quest", 1);
  set("age", 38);
  set("attitude", "friendly");
  set("no_get", 1);
  set("str", 58);
  set("int", 24);
  set("con", 20);
  set("dex", 26);
  set("qi", 5500);
  set("max_qi", 5500);
  set("jing", 2200);
  set("max_jing", 2200);
  set("neili", 4400);
  set("max_neili", 4400);
  set("jiali", 20);
  set("combat_exp", 330000);
  set_skill("literate", 400);
  set_skill("force", 400);
  set_skill("dodge", 400);
  set_skill("strike", 400);
  set_skill("parry", 400);
  set_skill("sword", 400);
  set_skill("cuff", 400);
  set("inquiry",
    ([
      "效力": (: ask_job :),
      "job": (: ask_job :),
      "效劳": (: ask_job :),
      "功劳": (: ask_count :),
    ]));
  setup();
  carry_object(__DIR__ "obj/pao15")->wear();
}
string ask_job() {
  mapping job;
  object me, job_npc, new_mz;
  int jobtime;
  jobtime = 30;

  me = this_player();
  if ((int)me->query("combat_exp") < 100000)
    return "你武功修为还不够，练好了再来吧!";
  if ((int)me->query_condition("mizhao_job_busy") > 0 || (int)me->query_condition("mizhao_job_time") > 0) {
    message_vision(CYN "\n夏侯烈对着$N摇了摇头\n" NOR, me);
    return "你等一会再来吧!";
  }
  if (present("mi zhao", me))
    return "你身上不是有密诏吗？";
  new_mz = new(__DIR__ "mizhao");
  job_npc = new(__DIR__ "yinshi");
  message_vision(CYN "\n夏侯烈点了点头\n" NOR, me);
  message_vision(CYN "\n夏侯烈从怀里摸出一件东西，对$N说道：“速按此诏行事，不得有误!”\n" NOR, me);
  message_vision(CYN "\n夏侯烈给$N一封" HIR "密诏\n" NOR, me);
  me->set_temp("mizhao_job_get", 1);
  set_npc_name(job_npc);
  set_npc_basedata(me, job_npc, 10, 60, 1);
  set_npc_skill(me, job_npc, 10 + random(5));
  job = query_job();
  new_mz->set_temp("mizhao_npc_name", job_npc->query("name") + "(" + job_npc->query("id") + ")");
  new_mz->set_temp("mizhao_job_where", job["c_place"]);
  me->set("mizhao_npc_name", job_npc->query("name") + "(" + job_npc->query("id") + ")");
  me->set("mizhao_job_where", job["c_place"]);
  new_mz->move(me);
  me->apply_condition("mizhao_job_busy", jobtime / 2);
  job_npc->apply_condition("mizhao_job_time", jobtime);
  me->apply_condition("mizhao_job_time", jobtime);
  job_npc->set("mizhao_killer", me->query("id"));
  job_npc->move(job["place"]);
  return RANK_D->query_respect(me) + "好好干，我西夏国绝不会亏待于你!";
}

string ask_count() {
  object me;
  int num;
  me = this_player();
  num = (int)me->query("mizhao_job_count");
  if (num == 0)
    command("kick " + me->query("id"));
  if (num < 100 && num > 0 && random(10) > 6)
    command("addoil " + me->query("id"));
  if (num > 100 && num < 300 && random(10) > 6)
    command("dhxy1 " + me->query("id"));
  if (num > 1000 && random(10) > 7)
    command("admire " + me->query("id"));
  return "你为我西夏国做了" + chinese_number(num) + "次贡献。\n";
}
