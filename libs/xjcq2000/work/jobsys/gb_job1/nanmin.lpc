// update by sunyc 23/12/00
#include <ansi.h>
inherit NPC;
void create() {
  set("title", "落魄剑客");
  set("long", @LONG
一名衣衫破烂的剑客，浑身浴血，显然是经过了一场九死一生的
搏斗。但是，他已经失血过多，变得非常衰弱了。
LONG);
}

void init() {
  object me = this_object();
  call_out("destroying", 40, this_object());
  add_action("do_rob", ({ "protect", "baohu" }));
  if (present("zhanglao", environment(me))
    call_out("story", 1);
  }

    int do_rob() {
      object me, ob;
      string arg;
      int stage, i;
      me = this_player();
      ob = this_object();
      stage = 0;
      i = sizeof(dest);
      arg = query("arg");
      if (!living(me)) return 0;
      if (!me->query("fam") || (int)me->query("combat_exp") <= 10000)
        return notify_fail("你还小，还是不要参与这种江湖仇杀吧。\n");
      if (objectp(present("zhanglao", environment(me))))
        return notify_fail("敌人看来武功不弱，你还是先打发了面前这个再说吧！\n");
      message_vision(HIY "$N对着$n说道：明教" + me->name() + "在此！你们放宽心走路就是！\n" NOR, me, ob);
      me->set_temp("gb_rob", 1);
      if (!ob->query("going")) {
        while (i--) if (arg == dest[i]["name"]) break;
        remove_call_out("go_stage");
        ob->set("f", 7 * (me->query_temp("j")));
        call_out("go_stage", 1, ob, stage, i, sizeof(dest[i]["context"]), me);
        ob->set("going", 1);
      }
      remove_call_out("make_bs");
      call_out("make_bs", 1, me, ob);
      return 1;
    }
  void make_bs(object me, object ob) {
    object obj;
    int j, i;
    j = (int)me->query_temp("j");
    if (j > 0) {
      new("/d/gaibang/npc/xietu")->move(environment(me));
      new("/d/gaibang/npc/xietu")->move(environment(me));
      me->add_temp("j", -1);
      return;
    } else {
      message_vision(HIW "$N见追兵已被杀退，对$n感谢万分，将本派信物交与$n以表示感激之情！\n" NOR, ob, me);
      obj = new("/d/gaibang/npc/obj/xinwu");
      obj->move(me);
      obj->set("owner", me->query("id"));
      me->add("combat_exp", 150);
      me->add("shen", (me->query("combat_exp") / 20));
      me->delete_temp("rob_start", 1);
      me->delete_temp("gb_rob");
      me->delete_temp("gb_job2");
      me->delete_temp("j");
      message_vision("$N扶老携幼，转了几个弯就不见了。\n", ob);
      destruct(ob);
    }
  }

  void go_stage(object me, int stage, int i, int size, object player) {
    object where;
    int f = me->query("f");
    if (stage < size) {
      message_vision(HIY "$N慌不择路地仓惶逃去。\n" NOR, me);
      me->move(dest[i]["context"][stage]);
      message_vision(HIY "$N仓皇失措地奔了过来。\n" NOR, me);
      where = environment(me);
      tell_object(
        player,
        HIM + me->query("name") + "好象在" + (string)where->query("short") + "一带遭遇了追兵。\n" NOR
      );
      call_out("go_stage", f, me, ++stage, i, size, player);
    } else {
      tell_object(player, HIM + me->query("name") + "难民们被恶徒们屠杀殆尽了。\n" NOR);
      message_vision(MAG "\n$N只见一阵乱箭飞来，难民纷纷中箭倒地。\n" NOR, me);
      destruct(me);
    }
  }
  void destroying(object me) {
    if (!me->query("going")) {
      message_vision("$N慌不择路地仓惶逃去。\n", me);
      destruct(me);
      return;
    } else call_out("destroying2", 420, me);
  }

  void destroying2(object me) {
    message_vision("$N慌不择路地仓惶逃去。\n", me);
    destruct(me);
    return;
  }
