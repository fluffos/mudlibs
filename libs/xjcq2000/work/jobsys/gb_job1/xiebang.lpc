#include <ansi.h>
inherit NPC;
inherit "/jobsys/xx_mz/job_npc_skill.lpc";
string ask_me();
void create() {
  set_name("邪派人士", ({ "xiepai renshi" }));
  if (random(10) > 7)
    set("gender", "男性");
  set("shen_type", -1);
  set("age", 30 + random(40));
  set("attitude", "friendly");
  set("no_quest", 1);
  set("str", 20);
  set("int", 20);
  set("con", 20);
  set("dex", 20);
  set("chat_chance", 2);
  if (!query("killing")) {
    set("chat_msg", ({
      (: random_move :)
    }));
  } else set("chat_chance_combat", 20);
  setup();
}

void init() {
  object me = this_player();
  if (query("gbjob1_killer") == me->query("id"))
    call_out("do_kill", 1);
  ::init();
}
void do_kill() {
  object ob, me, bz;
  int i, myexp;
  ob = this_object();
  me = this_player();
  myexp = me->query("combat_exp");
  if (environment(me)->query("no_fight")) {
    message_vision(CYN "$n哼了一声：这里不准战斗，$N有种上外面打去。\n", me, ob);
    message_vision("$n决定跟随$N一起行动", me, ob);
    ob->set_leader(me);
  } else if (!me->query_temp("kill_bangzhong") && !present("bang zhong", environment(ob))) {
    for (i = 1; i < 3; i++) {
      bz = new(__DIR__ "bangzhong");
      set_npc_basedata(me, bz, 40, 40, 1);
      set_npc_skill(me, bz, 60 + random(5));
      bz->set("combat_exp", myexp / 3);
      bz->move(environment(me));
      bz->set_leader(ob);
      bz->kill_ob(me);
    }
    message_vision(CYN "$n轻蔑的说道：“兄弟们，废了他！”\n" NOR, me, ob);
    message_vision(RED "两名邪派帮众怒吼一声，向$N冲去！\n" NOR, me);
    set("killing", 1);
    me->set_temp("kill_bangzhong", 1);
  } else {
    message_vision(CYN "$n冷目望着$N，说道：“小子，陪我玩玩吧！”\n" NOR, me, ob);
    ob->kill_ob(me);
  }
}
void die() {
  object now_killer, ob;
  ob = this_object();
  if (!objectp(now_killer = query_temp("last_damage_from"))) {
    message_vision(HIG "\n$N邪恶地笑道：可惜你永远拿不到青竹令了...\n" NOR, this_object());
    ::die();
  }
  if (now_killer->query("id") != query("gbjob1_killer")) {
    message_vision(HIG "\n$N愤声道：我们与你无缘无仇，你杀了我也永远拿不到青竹令...\n" NOR, this_object());
    ::die();
  }
  add_money("gold", 5);
  new(__DIR__ "obj/qzling")->move(ob);
  message_vision(HIG "\n$N长叹道：可惜我一生威名，竟至于斯！...\n" NOR, this_object());
  ::die();
}

void get_weapon() {
  carry_object(BINGQI_D((string)query("my_weapon")))->wield();
}

void pfm_select(int i) {
  switch (i) {
    case 0:
      set("chat_msg_combat", ({
        (: perform_action, "strike.xiaohun" :),
      }));
      break;
    case 1:
      break;
  }
}
