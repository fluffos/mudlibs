#include <ansi.h>
inherit ITEM;
void create() {
  set_name("感谢信", ({ "thank letter", "letter" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "封");
    set("long",
      "这是一封感谢信，是某个落难豪客感谢道上的朋友相帮的信。\n");
    set("value", 0);
    //             set ("no_drop",1);
    set("material", "paper");
  }
}
