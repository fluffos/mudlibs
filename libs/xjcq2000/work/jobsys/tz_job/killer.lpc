#include <ansi.h>
inherit NPC;
inherit "/jobsys/xx_mz/job_npc_skill.lpc";
string ask_me();
void create() {
  set_name("职业杀手", ({ "killer" }));
  set("gender", "男性");
  set("shen_type", -1);
  set("age", 30);
  set("attitude", "heroism");
  set("no_quest", 1);
  set("str", 20);
  set("int", 20);
  set("con", 20);
  set("dex", 20);
  set("chat_chance_combat", 20);
  setup();
}
void get_weapon() {
  carry_object(BINGQI_D((string)query("my_weapon")))->wield();
}
void pfm_select(int i) {
  switch (i) {
    case 0:
      set("chat_msg_combat", ({
        (: perform_action, "strike.xiaohun" :),
      }));
      break;
    case 1:
      break;
  }
}
