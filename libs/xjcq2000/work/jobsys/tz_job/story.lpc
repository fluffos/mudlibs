#include <ansi.h>

string *bad_story_msg_start = ({
  "你的眼前一闪，$n的身旁突然蹿出了一个黑衣人影，把剑喝道：“我今天将替天行道，纳命来吧！”", "$n暗地调整了一下$n背后背的剑，随时准备着动手。", CYN "$n喝道:“在下为人光明磊落，不知道哪一点得罪了这位仁兄？”" NOR, CYN "$N说道:“难不成还要我件件历数，你才肯认罪么？”" NOR, CYN "$n说道：“哼，我到要看看你有什么理由！" NOR,
});
mixed *bad_matter = ({
  ({
    "$N朗声道：“四川成都府的老武师万胜刀王天民，设场授徒数十年，",
    "一向安份守己，刚正不阿，与阁下又有什么冤仇？阁下竟当着$n数十弟子之面，",
    "踢了$n的场子，又重重的羞辱了$n一顿，使得$n在风烛之年，吐血而亡，这叫不叫‘卑鄙’？”",
    "“王老头子误人子弟，将数十百个青年的大好时光，浪费在$n那套毫无用处的刀法之上，我没有亲手",
    "杀$n，已经是客气的了。”",
  }),
  ({
    "“浙江永嘉的镖师没羽箭赵国明，妻子不守妇道，乘赵国明走镖在外，偷人养",
    "汉，赵国明不甘受辱，自然要将那一对奸夫淫妇杀之而快，哼！”$N词色渐厉",
    "，道，“可是阁下，却将赵国明点住要穴，任凭那一对奸夫淫妇逃走，这种违背天理、国法、人情的行为，又叫做什么？”",
    "“$n两人真情流露，男女两情欢悦，又有谁有这权利阻挡，赵国明不知爱护自己的妻子，岂能禁止别人爱护呢？”",
  }),
  ({
    "“河南开封府的神枪汪鲁平，有子忤逆，$n欲正之家法，阁下又有什么权利干涉？”",
    "“人命得之于天，老子有什么资格杀死儿子？”",
  }),
  ({
    "“河北保定府的离魂圈诸葛一平无意中得罪了你，被你逼得无地容身，逃到开州县外的八公桥，埋头一忍。”",
    "$N冷笑着道：“想不到你还要赶尽杀绝，到八公桥去将$n大卸八块，死状惨不忍睹，我说你也未免太毒了吧！”",
    "“诸葛一平鱼肉乡里，结交官府，为非作歹，此人不死，简直是毫无天理了！",
    "”$N又冷笑道：“就算诸葛一平与你有仇，$n的妻子与你又有何仇？你不但杀了$n，还将$n妻子剥得精光，吊在",
    "树上，恣意嘲弄，我说你简直卑鄙得像条没有人性的畜牲。”",
    "“诸葛一平的妻子在保定府引诱良家妇女，逼良成娼，这就是她的报应。”",
  }),
});
string *bad_story_msg_end = ({
  CYN "$n嘲弄地向$N道：“就算我所做的这些事是卑鄙的，可是这远比不上你在衡" NOR,
  CYN "州所做的那样事的万分之一。”" NOR,
  CYN "$n冷笑着，指着$N，道：“你若是以为你做的事神不知，鬼不觉，那你就大错了！”" NOR,
});
