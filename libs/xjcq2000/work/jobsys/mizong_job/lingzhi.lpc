#include <ansi.h>
inherit NPC;
inherit F_MASTER;
#include "job.h"

void create() {
  set_name("灵智上人", ({ "lingzhi shangren", "shangren" }));
  set("long", @LONG
灵智上人是雪山寺中地位较高的喇嘛。身穿一件青色袈裟，头带僧帽。
LONG
  );
  //set("nickname","上人");
  set("title", HIY "大喇嘛" NOR);
  set("gender", "男性");
  set("age", 40);
  set("attitude", "peaceful");
  set("shen", -9000);
  set("str", 28);
  set("per", 16);
  set("int", 27);
  set("con", 28);
  set("dex", 26);
  set("max_qi", 3000);
  set("max_jing", 3000);
  set("neili", 3000);
  set("max_neili", 2500);
  set("jiali", 100);
  set("combat_exp", 900000);
  set("eff_jingli", 1500);

  set_skill("lamaism", 161);
  set_skill("literate", 100);
  set_skill("force", 160);
  set_skill("longxiang-gong", 160);
  set_skill("dodge", 160);
  set_skill("yujiamu-quan", 160);
  set_skill("qingshen-fa", 160);
  set_skill("parry", 160);
  set_skill("staff", 160);
  set_skill("xiangmo-chu", 160);
  set_skill("hand", 160);
  set_skill("dashou-yin", 160);
  set_skill("mingwang-jian", 160);
  set_skill("sword", 100);
  set_skill("cuff", 160);
  set_skill("fuhu-quan", 160);


  map_skill("force", "longxiang-gong");
  map_skill("dodge", "qingshen-fa");
  map_skill("cuff", "fuhu-quan");
  map_skill("parry", "dashou-yin");
  map_skill("hand", "dashou-yin");
  map_skill("staff", "xiangmo-chu");
  prepare_skill("cuff", "fuhu-quan");
  prepare_skill("hand", "dashou-yin");
  create_family("密宗", 10, "大喇嘛");
  set("class", "lama");
  set("inquiry", ([
    "job": (: do_ask() :),
  ]));
  setup();
  carry_object("/clone/armor/q-jiasha")->wear();
  //       carry_object("/clone/armor/p-sengmao")->wear();

}
void attempt_apprentice(object ob) {
  mapping fam;

  string name, new_name;

  fam = ob->query("family");

  if (!fam || fam["family_name"] != "密宗") {
    command("say " + RANK_D->query_respect(ob) + "与本派素无来往，不知此话从何谈起？");
    return;
  }
  if ((int)ob->query_skill("longxiang-gong", 1) < 100 || (int)ob->query_skill("lamaism", 1) < 100) {
    command("say 我密宗派是以龙象般若功为基础,密宗心法为辅,你还差的远呢,回去多多修炼吧。");
    return;
  }
  if ((int)ob->query("shen") > -50000) {
    command("say 你好象没为密宗出过什麽力啊。");
    return;
  }
  if (fam["generation"] <= 10) {
    command("say 我密宗门规甚严,我怎麽能受你为徒呢！");
    return;
  }
  if ((string)ob->query("gender") != "男性") {
    command("say 修习密宗内功需要纯阳之体。");
    command("say 这位" + RANK_D->query_respect(ob) +
      "还是请回吧！");
    return;
  }


  if ((string)ob->query("class") != "lama") {
    command("say 我密宗的清规戒律甚多。");
    command("say 这位" + RANK_D->query_respect(ob) +
      "还是请回吧！");
    return;
  }

  command("smile");
  if (fam["generation"] != 11) {
    name = ob->query("name");
    new_name = "慧" + name[2..3];
    ob->set("name", new_name);

    command("say 好吧,我就收你为徒,今后法名就叫做" + new_name + "！");

  }

  command("recruit " + ob->query("id"));

}
