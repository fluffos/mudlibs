//xiaoyao 98/9/4

#include <ansi.h>
#include <combat.h>
inherit F_SSERVER;
int perform(object me, object target) {
  string msg;
  int extra, i;
  string *style = ({
    "天字阵－－$N抡动手中$w，狂风呼啸，打向$n的$l！",
    "人字阵－－$N手中$w叠影重重，将$n团团围住！",
    "合字阵－－$N向前一纵，手中$w狂舞，向$n猛扑过去！",
    "一字阵－－$N欺身急进，手中$w头尾齐出，分打$n的两处要害！",
    "丁字阵－－$N手中$w一顿，暗蓄内力，点向$n的$l！",
    "大字阵－－$N身形连纵连跃，手中$w威势陡增，连连向$n打去！",
    "日字阵－－$N身影绕着$n连续晃动，手中$w连发，扫向$n的$l！",
    "月字阵－－$N身形纵起，手中$w自上而下，迅猛无比，砸向$n的$l！" });
  object ob, *obs;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［打狗阵法］只能对战斗中的对手使用。\n");
  if (!pointerp(obs = me->query_team()) || !me->is_team_leader())
    return notify_fail("只有队伍领袖才可以发动此式！\n");
  // this loop just checking, make sure everyone use 打狗阵法
  if (sizeof(obs) >= 6)
    return notify_fail("队伍最多六个人！！\n");
  for (i = 0; i < sizeof(obs); i++) {
    if (!obs[i]) return notify_fail("你需要从新组合队伍。\n");
    if (environment(obs[i]) != environment(me)) return notify_fail("你队伍成员不全在你身边。\n");
    if (!obs[i]->query_skill("dagou-zhenfa")) return notify_fail("你队伍中有人不会打狗阵法。\n");
    if (!objectp(ob = obs[i]->query_temp("weapon"))) return notify_fail("你的队伍中有人没有兵器！\n");
    if (ob->query("skill_type") != "stick") return notify_fail("你的队伍中有人没有用棍法！\n");
    if (obs[i]->query_skill_mapped("stick") != "dagou-zhenfa") return notify_fail("你的队伍中有人没有使用打狗阵法！\n");
  }
  message_vision(HIY + "\n\n$N大叫一声：丐帮弟子组阵！\n立时发动了打狗大阵！\n\n", me);
  for (i = 0; i < sizeof(obs); i++) {
    ob = obs[i]->query_temp("weapon");
    msg = HIR + style[i] + NOR;
    extra = obs[i]->query_skill("stick");
    extra *= (i + 1);
    obs[i]->add_temp("apply/attack", extra);
    obs[i]->add_temp("apply/damage", extra);
    COMBAT_D->do_attack(obs[i], target, ob, TYPE_REGULAR, msg);
    obs[i]->kill_ob(target);
    obs[i]->add_temp("apply/attack", -extra);
    obs[i]->add_temp("apply/damage", -extra);
    obs[i]->start_busy(2);
  }
  return 1;
}
