#include <ansi.h>
#include <power_control.h>
inherit SKILL;
string *msg = ({
  "在呼呼风声中，$N使一招「捕风式」，双手如钩如戢，插向$n的$l",
  "$N猛地向前跃出，一招「捉影式」，两腿踢出，双手抓向$n的面门",
  "$N双手平伸，十指微微上下抖动，一招「抚琴式」打向$n的$l",
  "$N左手上拦，右手内挥，一招「击鼓式」击向$n胸口",
  "$N右手虚握，左手掌立如山，一招「批亢式」，猛地击向$n的$l",
  "$N腾步上前，左手护胸，右手探出，一招「掏虚式」击向$n的裆部",
  "$N双手平提胸前，左手护住面门，一招「抱残式」右手推向$n的$l",
  "$N两手胸前环抱，腋下含空，五指如钩，一招「守缺式」插向$n的顶门",
  "$N右腿斜插$n二腿之间，一招「抢珠式」，上手取目，下手反勾$n的裆部",
  "$N一手虚指$n的剑诀，一招「夺剑式」，一手劈空抓向$n的$l",
  "$N左手指向$n胸前的五道大穴，右手斜指太阳穴，一招「拿云式」使$n进退两难",
  "$N前脚着地，一手顶天成爪，一手指地，一招「追日式」劲气笼罩$n的全身",
});

int valid_enable(string usage) { return usage == "claw" || usage == "parry"; }

int valid_combine(string combo) {
  object me;
  me = this_player();
  if ((int)me->query_int() + (int)me->query_con() > 90)
    return combo == "yizhi-chan" || combo == "jingang-quan" || combo == "banruo-zhang" || combo == "ruying-suixingtui" || combo == "qianye-shou";
}

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练龙爪功必须空手。\n");
  if ((int)me->query_skill("yijin-jing", 1) < 60)
    return notify_fail("你的易筋经内功火候不够，无法学龙爪功。\n");
  if ((int)me->query_int() > 42) {
    return 1;
  } else {
    if ((int)me->query_skill("banruo-zhang") &&
      ("yizhi-chan") &&
      ("jingang-quan") &&
      ("qianye-shou") &&
      ("ruying-suixingtui"))
      return notify_fail("你的功力不够，无法同时学习两种以上的上乘功夫。\n");
  }

  if ((int)me->query("max_neili") < 600)
    return notify_fail("你的内力太弱，无法练龙爪功。\n");
  return 1;
}

mapping query_action(object me) {
  int level;
  string a_msg;
  level = (int)me->query_skill("longzhua-gong", 1);
  a_msg = msg[random(sizeof(msg))];
  if (random(level) > level - level / 6 || (int)me->query_temp("pfm/longzhua") == 1)
    a_msg = select_color() + a_msg + NOR;
  if ((int)me->query_temp("pfm/longzhua") == 1)
    a_msg = HBBLU + a_msg;
  return ([
    "damage_type": random(2) ? "内伤" : "抓伤",
    "action": a_msg
  ]) + query_my_power(me, level, at_type_hand, attack_lvl_high, defense_lvl_normal);
}

int practice_skill(object me) {
  if ((int)me->query("jingli") < 60)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 30)
    return notify_fail("你的内力不够练龙爪功。\n");
  me->receive_damage("jingli", 50);
  me->add("neili", -20);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "longzhua-gong/" + action;
}
