//九阴神功
#include <ansi.h>
inherit FORCE;
#include "/kungfu/skill/eff_msg.h";

int valid_enable(string usage) {
  return usage == "force";
}

int valid_learn(object me) {
  int lvl = (int)me->query_skill("jiuyin-shengong", 1);

  if (me->query("gender") == "无性")
    return notify_fail("以公公无根无性之身，练九阴神功容易走火入魔！\n");
  if (me->query("gender") == "无性" && lvl > 49)
    return notify_fail("你无根无性，阴阳不调，难以领会高深的九阴神功。\n");

  if ((int)me->query_skill("force", 1) < 30)
    return notify_fail("你的基本内功火候还不够，无法领会九阴神功。\n");
  if ((int)me->query_skill("taoism", 1) < 100)
    return notify_fail("九阴神功以道家之学为基础,你得先熟读一些道家的经文啊。\n");
  if (me->query_skill("jiuyang-shengong", 1)
    /*      || me->query_skill("beiming-shengong",1)
        || me->query_skill("bahuang-gong",1)
        || me->query_skill("hamagong",1)
        || me->query_skill("huagong-dafa",1)
        || me->query_skill("huntian-qigong",1)
        || me->query_skill("hunyuan-yiqi",1)
        || me->query_skill("longxiang",1)
        || me->query_skill("bibo-shengong",1)
        || me->query_skill("taiji-shengong",1)
        || me->query_skill("xiaowuxiang",1)
        || me->query_skill("yunlong-shengong",1)
*/ || me->query_skill("zixia-shengong", 1))
    return notify_fail("九阴和九阳相生相克,你不先散了九阳神功，怎能学九阴神功？！\n");

  return 1;
}



int practice_skill(object me) {
  return notify_fail("九阴神功只能用学习(learn)来增加熟练度。\n");
}

string exert_function_file(string func) {
  return __DIR__ "jiuyin-shengong/" + func;
}
mixed hit_ob(object me, object target, int damage_bonus, int factor) {
  mixed foo;
  int force;

  foo = ::hit_ob(me, target, damage_bonus, factor);
  if ((me->query_skill(
    "jiuyin-shengong",
    1
  ) > 120) && random(12) > 8 && me->query("neili", 1) > 200) {
    force = me->query_skill("force");
    target->receive_wound("jing", random(force) / 2);
    me->add("neili", 10 + (random(50)));
    return HIC "一股阴柔的内力自$N的指间射出,如丝,如针,直刺$n的丹田气,$n只觉得浑身一震,胸口似乎被大锤击打,浑身烦闷,说不出话来!\n" NOR;
  }
  return foo;
}
int ob_hit(object ob, object me, int damage) {
  object wp, wp1;
  string msg;
  int p, j, skill, neili, neili1;
  wp1 = ob->query_temp("weapon");
  skill = me->query_skill("jiuyin-shengong", 1);
  neili = me->query("neili");
  neili1 = ob->query("neili");


  if (me->query("jiali") && random(skill) > random(ob->query_skill("force", 1) * 2 / 3)
    && me->query("combat_exp") > ob->query("combat_exp") / 5
    && me->query_skill_mapped("force") == "jiuyin-shengong"
    && me->query_skill("jiuyin-shengong", 1) > 200
    && neili > 300
    && !ob->query("env/invisibility")) {
    if (objectp(wp1)) msg = HIW "一堵柔和之极的气墙自$N身上而起,将$n的" NOR "" + wp1->name() + "" HIW "一挡!\n" NOR;
    else msg = HIW "$n攻出的力道，被一堵柔和之极的气墙所阻!\n" NOR;
    if (random(12) >= 10) {
      msg += HIR "蓦的,$N身上却传出三股阴柔如剑的内力,直刺$n！\n" NOR;
      ob->receive_damage("qi", damage, me);
      me->add("neili", -(20 + random(50)));
      p = ob->query("qi") * 100 / ob->query("max_qi");
      msg += damage_msg(damage, "内伤");
      msg += "( $n" + eff_status_msg(p) + " )\n";
      j = -damage * 4;
    } else if (random(15) >= 10) {
      msg += HIC "$N肌肉一紧一收,将$n打来的力道消去了一半!\n" NOR;
      me->add("neili", -(20 + random(20)));
      j = -damage;
    } else {
      msg += HIY "$N的护体真气急运而起，将总算打消了$n一小半的力道!\n" NOR;
      me->add("neili", -(20 + random(10)));
      j = -damage * 2 / 3;
    }
    message_vision(msg, me, ob);
    return j;
  }
}
mapping exercise_msg(object me) {
  return ([
    "status_msg": HIR + me->name() + "盘膝而坐，全身衣物无风自起。" NOR,
    "start_my_msg": "你盘膝而坐，运转九阴，提气上行，由丹田流往潭中气海，自奇经八脉内环绕而行。\n",
    "halt_msg": HIR "$N全身微微一动，将内力导入丹田，站了起来。\n" NOR,
    "end_my_msg": "你抱元守一，内力运转一个小周天,只觉得奇经八脉内一股阴柔内力环绕而行。\n",
  ]);
}
