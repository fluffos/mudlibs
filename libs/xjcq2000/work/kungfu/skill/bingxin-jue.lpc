// bingxin-jue.c

#include <ansi.h>

inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

#include "force.h"

int valid_learn(object me) {
  int lvl = (int)me->query_skill("bingxin-jue", 1);
  int t = 1, j;

  for (j = 1; j < lvl / 10; j++) t *= 2;
  if (t > 5000) t = 5000;
  if (me->query("gender") == "无性" && lvl > 49)
    return notify_fail("你无根无性，阴阳不调，难以领会高深的氤氲紫气神功。\n");

  if (me->query_condition("killer"))
    return notify_fail("你的心绪不静无法修习冰心诀。\n");

  if ((int)me->query_skill("force", 1) < 30)
    return notify_fail("你的基本内功火候还不够。\n");

  return valid_public(me);
}

int practice_skill(object me) {
  return notify_fail("决心诀只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func) {
  return __DIR__ "bingxin-jue/" + func;
}

mapping exercise_msg(object me) {
  return ([
    "status_msg": HIB + me->name() + "随意的站在那里，由身体向四周散发出一阵冷气。" NOR,
    "start_my_msg": HIB "你随意而站，双目微闭，缓缓吸一口气，口中微念" + HIW "“" HIC + "心若冰清，天塌不惊" + HIW "”" + HIB "体内内息随心意而动。\n" NOR,
    "start_other_msg": HIB + me->name() + "随意而站，双目微闭，缓缓吸一口气，口中微念“" HIC + "心若冰清，天塌不惊" + HIC "”体内内息随心意而动。\n" NOR,
    "halt_msg": HIB "$N微一簇眉，凝聚心神，忽然张开了双眼。\n" NOR,
    "end_my_msg": HIB "你把心神一收，四周的冷气突然都消失了。\n" NOR,
    "end_other_msg": HIB + me->name() + "长出一口气后，缓缓的张开了双眼，四周的冷气一忽然消失了。\n" NOR
  ]);
}
