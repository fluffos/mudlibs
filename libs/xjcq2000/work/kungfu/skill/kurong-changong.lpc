#include <ansi.h>
#include <skill.h>
#include <power_control.h>
#include "/kungfu/skill/eff_msg.h"
inherit FORCE;
string *a_msg = ({
  "$N轻轻吟道：「常与无常」,身体旋转，右掌从胁下伸出，一股劲风向$n扑去",
  "$N双掌隐于袖中，断喝：「我与无我」，“哗”的一声衣泡冲天而起，一道气墙直击向$n",
  "$N双掌交错，凌空拔起,高声一吼：「乐与无乐」，一掌向$n的$l拍去",
  "$N拇指屈贴掌心，默咏：「净与无净」,右掌上抬，左掌向$n的$l插去",
  "$N一声大喝：「非假非空」,扬手拍出一股排山倒海的气浪",
  "$N似笑非笑，左掌一推，右掌一拉，一股旋转的气流将$n团团包围",
  HIY "$N双手合什，吟道：「亦枯亦荣」，双掌交替快速推出，掌力重重叠叠，直逼向$n" NOR,
});

string *parry_msg = ({
  "$n身体忽然整个后移,$N的攻势变得无处可击。?",
  "$n掌法突变,左掌缓慢的拍向$N,虽是后发却能先至,$N只得中途变招。\n",
  "$n口中高颂一声,双掌以无上内力逼出一道气墙,只见紫烟缭护住了$n的全身。\n?",
});

int valid_enable(string usage) { return usage == "force" || usage == "strike" || usage == "parry"; }

void skill_improved(object me) {
  int skill = me->query_skill("kurong-changong", 1);
  int skill1 = me->query_skill("qiantian-yiyang", 1);
  if (skill >= 200 && !me->query("kr_add")) {
    me->set("kr_add", 1);
    tell_object(me, HIG "\n忽然心中灵光一闪，不由得轻轻吟道:\n
         “一切有为法，如梦幻泡影”\n
         “如露亦如电，应做如是观”\n
         你的禅功修为到了一个新的境界！\n
         你的内力增加了！\n你的臂力增强了！\n" NOR);
    me->add("max_neili", random(skill1 + skill));  // fix dubei
    me->add("str", 1);
  }
}

mapping query_action(object me) {
  int level;
  level = (int)me->query_skill("kurong-changong", 1);
  return ([
    "damage_type": random(2) ? "内伤" : "震伤",
    "action": a_msg[random(sizeof(a_msg))]
  ]) + query_my_power(me, level, at_type_hand, attack_lvl_high, defense_lvl_normal);
}

int valid_learn(object me) {
  int i, l;
  int t = 1, j;
  mapping myfam = (mapping)me->query("family");
  for (j = 1; j < i / 10; j++) t *= 2;
  i = (int)me->query_skill("kurong-changong", 1);
  l = (int)me->query_skill("buddhism", 1);

  if (i > 120 && i < 180 && l < i - 10)
    return notify_fail("枯荣禅功需要深厚的佛学造诣，你的佛学不够！\n");

  if (me->query_skill("qiantian-yiyang", 1) < 120)
    return notify_fail("你的乾天一阳功火候还不够，无法领会枯荣禅功。\n");

  if (me->query("class") != "bonze")
    return notify_fail("你非我佛弟子，不可修习枯荣禅功。\n");

  if (me->query_skill("yiyang-zhi", 1) < 120)
    return notify_fail("枯荣禅功需要一阳指神功作为后盾。\n");
  if (myfam["master_name"] != "枯荣长老")
    return notify_fail("你辈分不够，不可以修习枯荣禅功。\n");
  return 1;
}


int practice_skill(object me) {
  return notify_fail("枯荣禅功不可随便练习。\n");
}

string exert_function_file(string func) {
  return __DIR__ "kurong-changong/" + func;
}

mapping exercise_msg(object me) {
  return ([
    "status_msg": HIG + me->name() + "面带凝涩之气，双目低垂内视。" NOR,
    "start_my_msg": "你盘膝坐下，垂目合什，默运枯荣禅功，只觉冷热两股真气开始在体内缓缓游动。\n",
    "start_other_msg": me->name() + "盘膝坐下，垂目合什，周身似乎笼罩在一层青气之中。\n",
    "halt_msg": "$N双掌一分，屈掌握拳，两股真气迅速交汇消融。\n",
    "end_my_msg": "你真气在体内运行了一个周天，冷热真气收于丹田，慢慢抬起了眼睛。\n",
    "end_other_msg": "只见" + me->name() + "慢慢睁开眼睛，周身笼罩的青气逐渐隐去。\n"
  ]);
}
string perform_action_file(string action) {
  return __DIR__ "kurong-changong/" + action;
}

int ob_hit(object ob, object me, int damage) {
  string msg;
  int j, skill, neili, neili1;
  skill = me->query_skill("parry", 1);
  neili = me->query("neili");
  neili1 = ob->query("neili");

  if ((random(skill) > (int)ob->query_skill("parry", 1) / 2 && random(6) > 3
    && neili > 800) || (damage > 1500 && me->query_temp("pf_ku") && random(6) > 3)) {
    msg = HIG "$N默运枯荣禅功的[枯]字大法，半边身子的隐隐透出青气，内力全部集中在$N的这半边身上。\n" NOR;
    tell_object(ob, HIR "你只见对手突然身子一侧，将半边身子迎了上来！\n" NOR);
    msg += "$n一招打在$N的身上，只觉似乎打在一块朽木上。\n";

    if (random(neili) > neili1 / 2) {
      msg += "结果$n的攻击被$N的枯荣禅功化掉了！\n",
        j = -8000;
    } else if (neili < random(neili1) + damage && neili * 2 > random(neili1) + damage) {
      msg += "结果$n的攻击被$N化掉了一半！\n",
        j = -damage / 2;
    } else {
      msg += "结果$N只化掉了$n的一小半力道！\n",
        j = -damage / 4;
    }
    message_vision(msg, me, ob);
    return j;
  }
}
