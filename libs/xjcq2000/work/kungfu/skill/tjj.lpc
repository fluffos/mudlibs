#include <ansi.h>
inherit SKILL;

string *msg = ({
  "$N一招「天马行空」，向前跃落，右手$w由上向前劈下，飘逸地点向$n的$l",
  "$N提起左腿转身垫步，右脚跟进，一招「黄峰入洞」，$w中宫直进，刺向$n的$l",
  "$N一招「射雁式」，左脚跃步落地，$w回抽，反手勾向$n的$l",
  "$N摆一个左虚步，$w划一个整圆，一式「小魁星」撩向$n的$l",
  "$N右脚独立，右手$w向后撤，再向前平平托起，一招「挑帘式」刺向$n的$l",
  "$N使一招「风扫梅花」，身体不停地旋转，右手$w随身转动，风雷电掣般向$n的$l扫去",
  "$N左脚前进一步，右手$w一招「顺水推舟」，向右后方刺向$n的$l",
  "$N右脚后撤一步，一转身，右手$w向后反击，一招「大鹏展翅」，抹向$n的$l",
  "$N双脚并步，身体立起，一招「白猿献果」，$w向前平刺$n的$l",
  "$N向前连跳两步，一招「野马跳涧」，$w向前平刺$n的$l",
  "$N右脚向前垫步，一招「海底捞月」，$w由上向后划一个大弧，向前撩向$n的$l",
  "$N左脚独立，右膝提起，双手捧剑，一招「虎抱头」，缓缓刺向$n的$l",
  "$N使出「三环套月」，$w划出三个圆圈，剑锋直出，绵绵不断划向$n的$l",
  "$N左脚踏实，右脚虚点，一招「仙人指路」，右手$w带着一团剑花，逼向$n的$l",
  "$N一招「右拦扫」，一招「左拦扫」，剑锋平指，一气呵成横扫$n的$l",
  "$N一招「乌龙摆尾」，右脚变虚步，右手回收，$w向下截劈$n的$l",
  "$N左脚向前进一步，$w由后划一整圆向前托起，一招「迎风掸尘」，刺向$n的$l",
  "$N使一招「青龙出水」，右脚向后回撤，$w随身体右后撤，突然向左前方刺向$n的$l",
  "$N一招「探海式」，右脚独立，左膝提起，$w向前抡劈$n的$l",
  "$N虚步提腰，一招「蜻蜓点水」，手中$w轻轻颤动，一剑剑点向$n的$l",
  "$N向前跨上一步，左手剑诀，右手$w使出一式「指南针」直刺$n的$l",
  "$N一招「燕子掠波」，$w自上而下划出一个大弧，平平地向$n的$l挥去",
  "$N一招「却步抽剑」，左脚跃步落地，$w回抽，反手勾向$n的$l",
  "$N右腿半屈般蹲，一招「如封似闭」，剑尖虚指，转身撩向$n的$l",
  "$N回身拧腰，右手虚抱，一招「拨云瞻日」，$w中宫直进，刺向$n的$l"
});

int valid_enable(string usage) {
  return usage == "sword" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  int i, j;
  i = random(me->query_skill("force")) + 20;
  if (i > 280) i = 280;
  if (i < 100) i = 100;
  j = random(30) - 5;

  if (me->query_temp("tjj/powerup") >= 1) {
    me->add_temp("tjj/powerup", -1);
    return ([
      "action": HIW + msg[random(sizeof(msg))] + NOR,
      "damage": (random(3) + 1) * 80,
      "damage_type": "刺伤",
      "dodge": j + random(20),
      "force": i + 100 + random(250),
    ]);
  }
  if (random(50) >= 45) me->add_temp("tjj/powerup", 1);
  return ([
    "action": msg[random(sizeof(msg))],
    "damage": (random(3) + 1) * 30,
    "damage_type": "刺伤",
    "dodge": j,
    "force": i,
  ]);
}

int practice_skill(object me) {
  object weapon = me->query_temp("weapon");

  if (!weapon || weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("jingli") < 50)
    return notify_fail("你的体力不够练太极剑法。\n");
  me->receive_damage("jingli", 20);
  return 1;
}

int valid_learn(object me) {
  if ((int)me->query("max_neili") < 100)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_skill("yinyun-ziqi", 1) < 20)
    return notify_fail("你的氤氲紫气火候太浅。\n");
  if ((int)me->query_skill("taiji-quan", 1) < 20)
    return notify_fail("你的太极拳火候太浅。\n");
  return 1;
}
string perform_action_file(string action) {
  return __DIR__ "taiji-jian/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  object weapon, weapon1;
  int wp, wp1;
  weapon = me->query_temp("weapon");
  weapon1 = victim->query_temp("weapon");
  wp = weapon1->query("sharpness");
  wp1 = weapon1->query("rigidity");

  if (weapon1 && me->query_skill("tjj", 1) > 150 && me->query("jiali")
    && me->query("max_neili") > 1200 && me->query("neili") > 1000 && wp <= wp1
    && random(me->query_int()) > 30 && !me->query_temp("tjj/powerup")
    && me->query("combat_exp") > victim->query("combat_exp")) {
    message_vision(
      MAG "$N左手剑诀斜引，" + weapon->name() + MAG "画个半圆，平搭在$n" + weapon1->name() + MAG "背脊上，劲力传出，" + weapon1->name() + MAG "登时一沉！\n" NOR,
      me,
      victim
    );
    if (random(me->query("str")) > victim->query("str") / 2) {
      me->add("neili", -50);
      message_vision(
        HIR "\n$N剑招渐见涩滞，只觉得手中" + weapon1->name() + HIR "倒似不断的在增加重量，一个把持不定，脱手飞出！\n" NOR,
        victim
      );
      weapon1->unequip();
      weapon1->move(environment(victim));
    } else message_vision(
      HIY "$N一招使出，真力运得不足，被" + weapon->name() + HIY "带着连转几个圈子，手中" + weapon1->name() + HIY "一震，险些脱手！\n" NOR,
      victim
    );
  }
}
