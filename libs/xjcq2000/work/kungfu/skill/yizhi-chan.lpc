// yizhi-chan.c 一指禅
#include <ansi.h>
#include <power_control.h>
inherit SKILL;
string *msg = ({
  "$N双指并拢，一式「佛恩济世」，和身而上，左右手一前一后戳向$n的胸腹间",
  "$N左掌护胸，一式「佛光普照」，右手中指前后划了个半弧，猛地一甩，疾点$n的$l",
  "$N身形闪动，一式「佛门广渡」，双手食指端部各射出一道青气，射向$n的全身要穴",
  "$N盘膝跌坐，一式「佛法无边」，左手握拳托肘，右手拇指直立，遥遥对着$n一捺",
});

int valid_enable(string usage) { return usage == "finger" || usage == "parry"; }

int valid_combine(string combo) {
  object me;
  me = this_player();
  if ((int)me->query_int() + (int)me->query_con() > 90)
    return combo == "jingang-quan" || combo == "longzhua-gong" || combo == "banruo-zhang" || combo == "ruying-suixingtui" || combo == "qianye-shou";
}


int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练一指禅必须空手。\n");
  if ((int)me->query_skill("yijin-jing", 1) < 60)
    return notify_fail("你的易筋经内功火候不够，无法学一指禅。\n");
  if ((int)me->query_int() > 42) {
    return 1;
  } else {
    if ((int)me->query_skill("banruo-zhang") &&
      ("longzhua-gong") &&
      ("jingang-quan") &&
      ("qianye-shou") &&
      ("ruying-suixingtui"))
      return notify_fail("你的功力不够，无法同时学习两种以上的上乘功夫。\n");
  }
  if ((int)me->query("max_neili") < 600)
    return notify_fail("你的内力太弱，无法练一指禅。\n");
  return 1;
}

mapping query_action(object me) {
  int level;
  string a_msg;
  level = (int)me->query_skill("yizhi-chan", 1);
  a_msg = msg[random(sizeof(msg))];
  if (random(level) > level - level / 12)
    a_msg = RED + a_msg + NOR;
  return ([
    "damage_type": random(2) ? "内伤" : "瘀伤",
    "action": a_msg
  ]) + query_my_power(me, level, at_type_hand, attack_lvl_high, defense_lvl_normal);
}

int practice_skill(object me) {
  if ((int)me->query("jingli") < 60)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 30)
    return notify_fail("你的内力不够练一指禅。\n");
  me->receive_damage("jingli", 50);
  me->add("neili", -20);
  return 1;
}
string perform_action_file(string action) {
  return __DIR__ "yizhi-chan/" + action;
}
