// jianzhi.c benlong 2001-02-21
#include <ansi.h>
inherit F_SSERVER;
int perform(object me, object target) {
  object weapon;
  int lvl;

  lvl = me->query_skill("duanjia-jianfa", 1);
  lvl += me->query_skill("yiyang-zhi", 1);
  lvl += me->query_skill("qingyan-zhang", 1);
  lvl += me->query_skill("tianlong-xiang", 1);
  lvl /= 4;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("你只能对战斗中的对手使用剑指和一。\n");
  weapon = me->query_temp("weapon");
  if (!weapon || !(weapon->id("sword")))
    return notify_fail("你必须拿剑才能使出剑指和一。\n");
  if ((int)me->query_skill("duanjia-jianfa", 1) < 150)
    return notify_fail("你的段家剑法不够娴熟，无法施展出剑指和一。\n");
  if ((int)me->query_skill("buddhism", 1) < 130)
    return notify_fail("你的禅宗心法修为不够，无法施展出剑指和一。\n");
  if ((int)me->query_skill("yiyang-zhi", 1) < 150)
    return notify_fail("你的一阳指不够娴熟，无法施展出剑指和一。\n");
  if ((int)me->query_skill("qingyan-zhang", 1) < 150)
    return notify_fail("你的五罗清烟掌不够娴熟，无法施展出剑指和一。\n");
  if ((int)me->query_skill("qiantian-yiyang", 1) < 150)
    return notify_fail("你的乾天一阳功火候不够，无法施展出剑指和一。\n");
  if ((int)me->query_skill("tianlong-xiang", 1) < 150)
    return notify_fail("你的天龙翔火候不够，无法施展出剑指和一。\n");
  if ((int)me->query("max_neili") < 1500)
    return notify_fail("你的内力不够，无法施展出剑指和一。\n");
  if ((int)me->query("neili") < 1000)
    return notify_fail("你的真气不够，无法施展出剑指和一。\n");
  if ((int)me->query("jingli") < 200)
    return notify_fail("你的精气不够，无法施展出剑指和一。\n");

  message_vision(HIB "$N吸一口气，剑交左手，右指左剑，其间还夹杂着掌法，向$n攻去！\n" NOR, me, target);

  me->add("neili", -(300 + random(100)));
  me->add("jingli", -150);

  me->add_temp("apply/attack", lvl / 20);
  me->add_temp("apply/damage", lvl / 30);
  message_vision(HIY "$N左手中的" + weapon->query("name") + HIY "横劈斜刺，极其潇洒的向$n攻去！\n" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
  message_vision(HIY "$n只觉得四面八方都是剑影，不知所措！\n\n" NOR, me, target);
  weapon->unequip();
  me->prepare_skill("finger");
  me->prepare_skill("strike");
  if (present(target, environment(me)) && me->is_fighting(target)) {
    message_vision(HIR "$N把剑插回腰间，双手如清风拂晓向$n拍去！\n" NOR, me, target);
    me->prepare_skill("strike", "qingyan-zhang");
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
    message_vision(HIR "$N正好拍到了$n的小腹关元穴！$n觉得真气无法重新凝聚！\n\n" NOR, me, target);
  }
  if (present(target, environment(me)) && me->is_fighting(target)) {
    message_vision(HIM "$N倏地转掌为指，$n觉得到处是指风，虚虚实实无法捉摸。\n" NOR, me, target);
    me->prepare_skill("strike");
    me->prepare_skill("finger", "yiyang-zhi");
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
    message_vision(HIC "$N出指如风，正好点在$n後心至阳穴上，$n不由得吐了口鲜血。\n\n" NOR, me, target);
  }
  if (present(target, environment(me)) && me->is_fighting(target)) {
    message_vision(HIR "$N指风尚未收劲，左手剑又攻到$n面前！\n" NOR, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
    message_vision(HIR "$N又是连环三剑，或刺，或削，或劈，逼的$n，连连後退，无暇出力！\n\n" NOR, me, target);
  }
  if (present(target, environment(me)) && me->is_fighting(target)) {
    message_vision(HIY "$N接着不等$n喘息，又连出掌攻向$n身前大穴！\n" NOR, me, target);
    me->prepare_skill("strike");
    me->prepare_skill("strike", "qingyan-zhang");
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
    message_vision(HIY "$N突然一掌向$n天灵盖拍去！掌未到而劲风先致，只见$n摇摇晃晃，举布为艰。\n\n" NOR, me, target);
  }
  if (random(me->query("combat_exp", 1)) > target->query("combat_exp", 1) / 3) {
    target->add("neili", -150);
    target->set("jiali", 0);
    target->add("jingli", -100);
    target->receive_wound("qi", 100);
    target->start_busy(3);
  }
  message_vision(HIY "\n$N剑指合一运使完毕，手一晃将剑又拿回手中。\n" NOR, me, target);
  weapon->wield();
  me->start_busy(random(2) + 1);
  me->add_temp("apply/attack", -lvl / 20);
  me->add_temp("apply/damage", -lvl / 30);
  me->start_perform(6, "「剑指合一」");
  return 1;
}
