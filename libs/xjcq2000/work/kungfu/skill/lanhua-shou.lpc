//    兰花拂穴手   桃花岛武功
#include <ansi.h>
#include <power_control.h>
inherit SKILL;
string *xue_name = ({
  "玉枕穴", "风府穴", "大雅穴", "灵台穴", "臂儒穴", "悬枢穴", "百汇穴", "白海穴", "曲池穴", "天突穴", "阴都穴", "内关穴", "外关穴", "会宗穴", "迎香穴", "阳谷穴" });
mapping *msg = ({
  "$N左手忽作兰花之形，五指轻拢慢抹，拂向$n的周身大穴",
  "$N巧笑嫣然，美目盼兮，于微波流转中双手交叉拂向$n，仪态万方",
  "$N右手轻摇，颤抖不定，便如兰花浴风般划向$n的$l",
  "$N回身一式「天女散花」，姿态极尽飘逸，宛若翩翩起舞，转瞬之间身子已飞至$n面前，右手疾点$n的$l",
  "$N一招「落花有意」，双手倏的化作几点带露桃花，飘然直指$n的$l",
  "$N一式「人面桃花」，左手向$n面门虚晃一晃，面目含情，右手轻轻拂向$n的$l",
  HIC "$N双手交叠，形如兰花新蕾初放，于轻风中微微摇摆。$n被这优雅的姿势吸引，微一发呆，却蓦然发现$N的十指已拂到面前！" NOR,
});
int valid_enable(string usage) { return usage == "hand" || usage == "parry"; }

int valid_combine(string combo) {
  return combo == "xuanfeng-tui" || combo == "luoying-zhang" || combo == "tanzhi-shentong";
}

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("学兰花拂穴手必须空手。\n");
  if ((int)me->query("max_neili") < 1200)
    return notify_fail("你的内力太弱，无法学兰花拂穴手。\n");
  if ((int)me->query_skill("bihai-chaosheng", 1) < 120)
    return notify_fail("你的碧海潮生功火候不够，无法学兰花拂穴手。\n");
  if ((int)me->query_skill("force", 1) < 120)
    return notify_fail("你的基本内功火候不够。\n");
  if (me->query_skill_mapped("force") != "bihai-chaosheng")
    return notify_fail("修习兰花拂穴手必须配合桃花岛本门心法。\n");
  return 1;
}
mapping query_action(object me, object weapon) {
  return ([
    "damage_type": random(2) ? "内伤" : "瘀伤",
    "action": msg[random(sizeof(msg))]
  ]) + query_my_power(
    me,
    (int)me->query_skill("lanhua-shou", 1),
    at_type_hand,
    attack_lvl_normal,
    defense_lvl_normal
  );
}

int practice_skill(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练兰花拂穴手必须空手。\n");
  if ((int)me->query("jingli") < 60)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 40)
    return notify_fail("你的内力不够练兰花拂穴手。\n");
  me->receive_damage("jingli", 40);
  me->add("neili", -30);
  return 1;
}
mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  string name;
  int skill = (int)me->query_skill("lanhua-shou", 1);
  name = xue_name[random(sizeof(xue_name))];
  if (random(skill) > (int)victim->query_skill(
    "dodge",
    1
  ) / 2 && random(6) > 3 && (int)me->query("neili") > 0 && skill > 100) {
    victim->start_busy(2);
    return HIR "$n被$N拂中" + name + "，只觉得一阵钻心的疼痛，真气不由得一滞！
\n" NOR;
  }
}

string perform_action_file(string action) {
  return __DIR__ "lanhua-shou/" + action;
}
