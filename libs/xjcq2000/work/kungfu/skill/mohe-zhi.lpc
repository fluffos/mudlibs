// mohe-zhi.c -摩诃指
#include <ansi.h>
#include <power_control.h>
inherit SKILL;
string *msg = ({
  "$N左指挥出，一式「叶不归根」，削向$n的掌缘",
  "$N全身之力聚于一指，一式「我心向佛」，指向$n的胸前",
  "$N左掌贴于神道穴，右手一式「以慈度心」，向$n的$l划过",
  "$N双目怒视，一式「三入地狱」，双指拂向$n的额、颈、肩、臂、胸、背",
  "$N一式「天衣无缝」，左掌掌心向外，右指蓄势点向$n的$l",
  "$N右手伸出，十指叉开，一式「念经诵佛」，小指拂向$n的太渊穴",
  "$N双迸出无数道劲气，一式「我佛慈悲」射向$n的全身",
});

int valid_enable(string usage) { return usage == "finger" || usage == "parry"; }

int valid_combine(string combo) {
  return combo == "luohan-quan" || combo == "fengyun-shou" || combo == "jimie-zhua" || combo == "shaolin-tantui" || combo == "weituo-zhang" || combo == "sanhua-zhang" || combo == "qianye-shou" || combo == "longzhua-gong" || combo == "jingang-quan" || combo == "banruo-zhang" || combo == "ruying-suixingtui";
}

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练摩诃指必须空手。\n");
  if ((int)me->query_skill("yijin-jing", 1) < 10)
    return notify_fail("你的易筋经内功火候不够，无法学摩诃指。\n");
  if ((int)me->query("max_neili") < 50)
    return notify_fail("你的内力太弱，无法练摩诃指。\n");
  return 1;
}
mapping query_action(object me) {
  int level;
  string a_msg;
  level = (int)me->query_skill("mohe-zhi", 1);
  a_msg = msg[random(sizeof(msg))];
  if (random(level) > level - level / 12)
    a_msg = select_color() + a_msg + NOR;
  return ([
    "damage_type": random(2) ? "内伤" : "瘀伤",
    "action": a_msg
  ]) + query_my_power(me, level, at_type_hand, attack_lvl_normal, defense_lvl_normal);
}

int practice_skill(object me) {
  if ((int)me->query("jingli") < 30)
    return notify_fail("你的精力太低了。\n");
  if ((int)me->query("neili") < 20)
    return notify_fail("你的内力不够练摩诃指。\n");
  me->receive_damage("jingli", 30);
  me->add("neili", -10);
  return 1;
}
