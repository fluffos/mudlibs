// huashan-jianfa.c 华山剑法
#include <ansi.h>
#include <power_control.h>
inherit SKILL;
string *msg = ({
  "$N一招「白云出岫」，做一起首试，顿时豪情一片，手中$w蓄试点向$n的$l",
  "$N使出「有凤来仪」，剑势飞舞而出，轻盈灵动，$w闪烁不定，刺向$n的$l",
  "$N一招「天绅倒悬」，满场游走，$w自上而下划出一个大弧，向$n劈砍下去",
  "$N向前跨上一步，手中$w看似来势既缓，又无力道，但是$N突然剑锋一转，使出「白虹贯日」直刺$n的$l",
  "$N手中的$w一晃，满场游走，一身青衫化成了一片青影，一招「苍松迎客」直刺$n的$l",
  "$N手中$w斜晃反挑，一式「无边落木」，这一下出招急快，抑且如梦如幻，直逼$n的$l",
  "$N突然右手后缩，跟着剑柄疾收，似乎要撞上自己的胸膛，突然一式「青山隐隐」,反身刺向$n",
  "$N右臂轻提，手中$w提了两尺，剑尖一抬，一招「古柏森森」只等$n撞了上来",
});

string *msg1 = ({
  "$N一招「白云出岫」，做一起首试，顿时豪情一片，手中$w蓄试点向$n的$l",
  "$N使出「有凤来仪」，剑势飞舞而出，轻盈灵动，$w闪烁不定，刺向$n的$l",
  "$N向前跨上一步，手中$w看似来势既缓，又无力道，但是$N突然剑锋一转，使出「白虹贯日」直刺$n的$l",
  "$N手中的$w一晃，满场游走，一身青衫化成了一片青影，一招「苍松迎客」直刺$n的$l",
  "$N手中$w斜晃反挑，一式「无边落木」，这一下出招急快，抑且如梦如幻，直逼$n的$l",
  "$N一柄$w自半空中横过，剑身似曲似直，如一件活物一般，一式「天外玉龙」奔腾矫夭，气势雄浑地向$n的$l",
  "$N威仪整肃一式「玉井天池」，$w轰然一动，犹如千军万马奔驰而来，疾疾刺向$n的$l",
  "$N剑转一式「叠翠浮青」，俨然长枪大戟，黄沙千里，$w电闪雷鸣，将$n笼罩于重重剑气之中",
  "$N剑尖向下，一招「龙啸九天」，$w忽然急转直上，剑气将$n的上身要害团团围住",
  "突然间剑光一吐，长剑化作一道白虹，$N使出一式「千古人龙」，剑气古朴，$w直刺$n的$l",
  "$N左手向外一分，右手$w向右掠出一招「无双无对」，剑气森然地向$n的$l挥去",
  "$N轻叹一声，手中$w怀中一抱，一时「落花无意」，$w锵然跃出倏的化作几点带露的桃花，飘然飞向$n的$l",
});

int valid_enable(string usage) { return (usage == "sword") || (usage == "parry"); }
int valid_learn(object me) {
  if ((int)me->query("max_neili", 1) < 100)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_skill("zixia-gong", 1) < 20)
    return notify_fail("你的紫霞神功火候太浅。\n");
  return 1;
}
mapping query_action(object me, object weapon) {
  int i, level;
  string a_msg;
  level = (int)me->query_skill("huashan-jianfa", 1);
  if (me->query("gender") != "女性") {
    a_msg = msg[random(sizeof(msg))];
    if (random(level) > level - level / 6)
      a_msg = select_color() + a_msg + NOR;
    return ([
      "damage_type": random(2) ? "割伤" : "刺伤",
      "action": a_msg
    ]) + query_my_power(me, level, at_type_weapon, attack_lvl_middle, defense_lvl_middle);
  }
  if (me->query("gender") == "女性") {
    a_msg = msg1[random(sizeof(msg1))];
    if (random(level) > level - level / 6)
      a_msg = select_color() + a_msg + NOR;
    return ([
      "damage_type": random(2) ? "刺伤" : "割伤",
      "action": a_msg
    ]) + query_my_power(me, level, at_type_weapon, attack_lvl_middle, defense_lvl_middle);
  }
}
int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("jingli") < 30)
    return notify_fail("你的体力不够练华山剑法。\n");
  me->receive_damage("jingli", 25);
  return 1;
}
string perform_action_file(string action) {
  return __DIR__ "huashan-jianfa/" + action;
}
mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  object weapon = me->query_temp("weapon");

  if (me->query_temp("jianzhang") && !me->query_temp("jianzhang_hit")
    && me->query_skill_prepared("strike") == "hunyuan-zhang"
    && me->query_skill_mapped("strike") == "hunyuan-zhang") {
    me->set_temp("jianzhang_hit", 1);
    weapon->unequip();
    COMBAT_D->do_attack(me, victim, me->query_temp("weapon"), 1);
    weapon->wield();
    me->delete_temp("jianzhang_hit");
    me->add_temp("jianzhang", -1);
  }
}
