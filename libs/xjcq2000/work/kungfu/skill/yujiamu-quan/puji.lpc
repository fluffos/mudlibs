//yujiamu-quan.c Modify by jrx

#include <ansi.h>

inherit F_SSERVER;

int perform(object me, object target) {
  string msg;
  int damage;
  int i;
  i = (me->query_skill("longxiang-gong", 1) / 30); if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("「扑击」只能对战斗中的对手使用。\n");

  if ((int)me->query_skill("longxiang-gong", 1) < 60)
    return notify_fail("你的龙象般若功必须要在第2层以上才能，使出「扑击」。\n");

  if ((int)me->query_skill("yujiamu-quan", 1) < 60)
    return notify_fail("你的金刚愈加母拳不够娴熟，使不出「扑击」。\n");

  if ((int)me->query("neili") < 500)
    return notify_fail("你的内力不够，无法使出「扑击」。\n");

  msg = HIC "$N怒喝一声，腾身跃起，一式“扑击”，自上而下，双拳连挥,击起" HIR + i + HIC "道拳风! \n";

  if (random(me->query("combat_exp")) > random(target->query("combat_exp") / 3)) {
    msg += "$n大惊之下,躲闪不及，被" HIR + i + HIC "道拳风分别击中！\n";
    damage = i * (int)me->query_skill("longxiang-gong", 1);
    damage = damage + random(50);
    target->receive_damage("qi", damage);
    target->receive_wound("qi", damage / 3);
    if (damage < 200) msg += HIM "$n喉头一甜，吐出一口淤血。\n" NOR;
    else if (damage < 1000) msg += HIR "$n被" HIC + i + HIR "道拳风击中要害,头晕目眩，不辩西东! \n" NOR;
    else msg += RED "$n被" HIC + i + RED "道拳风穿透而过,摇摇晃晃,“哇”的一口鲜血狂喷而出！\n" NOR;
    message_vision(msg, me, target);
  } else {
    msg += HIY "$n情急之中向后激飞，随机趴下，堪堪躲过了这致命一击。\n" NOR;
    message_vision(msg, me, target);
  }
  me->add("neili", damage / 2);
  target->start_busy(1);
  return 1;
}
