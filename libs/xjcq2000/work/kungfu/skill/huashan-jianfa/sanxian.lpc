#include <ansi.h>

inherit F_SSERVER;

#include "/kungfu/skill/eff_msg.h";

int perform(object me, object target) {

  int damage, p;
  object weapon;
  string msg, dodge_skill;


  weapon = me->query_temp("weapon");
  if (!target)
    target = offensive_target(me);

  if (!target || !me->is_fighting(target))
    return notify_fail("夺命三仙连环剑只能在战斗中对对手使用。\n");

  if (!weapon || weapon->query("skill_type") != "sword"
    || me->query_skill_mapped("sword") != "huashan-jianfa")
    return notify_fail("你手里没有剑，无法使用夺命三仙连环剑！\n");

  if ((int)me->query_skill("huashan-jianfa", 1) < 130)
    return notify_fail("你的华山剑法不够娴熟，不能使用夺命三仙连环剑！\n");

  if ((int)me->query_skill("sword", 1) < 130)
    return notify_fail("你的基本剑法等级不够，不能使用夺命三仙连环剑！\n");

  if (me->query_skill_mapped("force") != "zixia-gong")
    return notify_fail("你所使用的内功不对。\n");

  if ((int)me->query("max_neili") < 1500)
    return notify_fail("你的内力太弱，不能使用夺命三仙连环剑！\n");

  if ((int)me->query("neili") < 500)
    return notify_fail("你的内力太少了，无法使用出夺命三仙连环剑！\n");


  msg = MAG "\n$N默运紫霞神功，将浑身功力逼于剑上，只见剑身紫光暴涨，罩向$n神堂、风府、悬柱三处穴道！！\n" NOR;

  if (random(me->query_skill("force", 1)) > target->query_skill("force", 1) / 4) {
    me->start_busy(1);
    target->start_busy(5);
    me->add("neili", -100);
    me->add("jingli", -20);
    damage = (int)me->query_skill("huashan-jianfa", 1) / 6;
    damage = damage + random(damage);
    if (me->query("neili") > target->query("neili") * 2) damage += random(damage);
    target->receive_damage("qi", damage);
    target->receive_wound("qi", damage / 2);
    p = (int)target->query("qi") * 100 / (int)target->query("max_qi");

    msg += HIR "结果只听见 “嗤” 的一声轻响，$n只觉得三处穴道一麻，竟一时无法动弹！\n" NOR;
    msg += "( $n" + eff_status_msg(p) + " )\n";
    call_out("perform2", 0, me, target);
  } else {
    target->start_busy(1);
    me->add("neili", -100);
    dodge_skill = target->query_skill_mapped("dodge");
    if (!dodge_skill) dodge_skill = "dodge";
    msg += SKILL_D(dodge_skill)->query_dodge_msg(target, 1);
    call_out("perform2", 0, me, target);
  }
  message_vision(msg, me, target);
  return 1;
}

int perform2(object me, object target, int p) {
  int damage;
  object weapon;
  string msg, dodge_skill;
  weapon = me->query_temp("weapon");
  if (!target)
    target = offensive_target(me);

  if (!target || !me->is_fighting(target))
    return notify_fail("夺命三仙连环剑只能在战斗中对对手使用。\n");

  if (!weapon || weapon->query("skill_type") != "sword"
    || me->query_skill_mapped("sword") != "huashan-jianfa")
    return notify_fail("你手里没有剑，无法使用夺命三仙连环剑！\n");

  if (!living(target))
    return notify_fail("对手已经不能再战斗了。\n");

  if ((int)me->query("neili", 1) < 400)
    return notify_fail("你待要再出一剑，却发现自己的内力不够了！\n");

  msg = HIW "\n$N大喝一声，左手平托长剑，右手运起混元功猛地拍向剑柄，长剑脱手而出，电光火石般射向$n！\n" NOR;
  if (random(me->query_skill("force")) > target->query_skill("force") / 3 &&
    me->query_skill("huashan-jianfa", 1) > 124) {
    me->start_busy(1);
    target->start_busy(1);
    me->add("neili", -100);
    me->add("jingli", -30);
    damage = (int)me->query_skill("huashan-jianfa", 1) / 4;
    damage = damage * 2 + random(damage) * 2;
    if (me->query("neili") > target->query("neili") * 2) damage += random(damage);
    target->receive_damage("qi", damage);
    target->receive_wound("qi", damage / 2);
    p = (int)target->query("qi") * 100 / (int)target->query("max_qi");
    msg += HIR "结果只听见$n一声惨嚎，一道电光已在$n的左肩对穿而出，血气冲天而出！！！\n" NOR;
    msg += "( $n" + eff_status_msg(p) + " )\n";
    call_out("perform3", 0, me, target);
  } else {
    me->add("neili", -100);
    dodge_skill = target->query_skill_mapped("dodge");
    if (!dodge_skill) dodge_skill = "dodge";
    msg += SKILL_D(dodge_skill)->query_dodge_msg(target, 1);
    call_out("perform3", 0, me, target);
  }
  message_vision(msg, me, target);
  return 1;
}

int perform3(object me, object target, int p) {
  int damage;
  object weapon;
  string msg, dodge_skill;
  weapon = me->query_temp("weapon");
  if (!target)
    target = offensive_target(me);

  if (!target || !me->is_fighting(target))
    return notify_fail("夺命三仙连环剑只能在战斗中对对手使用。\n");

  if (!weapon || weapon->query("skill_type") != "sword"
    || me->query_skill_mapped("sword") != "huashan-jianfa")
    return notify_fail("你手里没有剑，无法使用夺命三仙连环剑！\n");

  if (!living(target))
    return notify_fail("对手已经不能再战斗了。\n");

  if ((int)me->query("neili", 1) < 200)
    return notify_fail("你待要再出一剑，却发现自己的内力不够了！\n");

  msg = HIY "\n紧跟着$N身形随剑疾至，一把握住长剑，紫霞功顿时由剑而生，激出一道无形剑气刺向$n！！这三招狠辣异常，正是华山的夺命三仙连环剑！！！\n" NOR;
  if (random(me->query_skill("force")) > target->query_skill("force") / 2 &&
    me->query_skill("huashan-jianfa", 1) > 149) {

    target->start_busy(random(2));
    me->add("neili", -100);
    me->add("jingli", -40);
    damage = (int)me->query_skill("huashan-jianfa", 1) / 2;
    damage = damage * 3 + random(damage) * 3;
    if (me->query("neili") > target->query("neili") * 2) damage += random(damage);
    target->receive_damage("qi", damage);
    target->receive_wound("qi", damage / 2);
    p = (int)target->query("qi") * 100 / (int)target->query("max_qi");
    msg += HIR "$n一声惨嚎，剑光在$n的身上刺出无数个细小的伤口，鲜血溅得满地！！！\n" NOR;
    msg += "( $n" + eff_status_msg(p) + " )\n";
  } else {
    me->start_busy(2);
    target->start_busy(1);
    me->add("neili", -200);
    target->add("jingli", -100);
    dodge_skill = target->query_skill_mapped("dodge");
    if (!dodge_skill) dodge_skill = "dodge";
    msg += SKILL_D(dodge_skill)->query_dodge_msg(target, 1);
  }
  message_vision(msg, me, target);
  return 1;
}
