#include <ansi.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target) {
  string msg, msg1;
  int i;
  object weapon;
  if (!target) target = offensive_target(me);
  if (!target || !me->is_fighting(target))
    return notify_fail("「龙行天下」只能在战斗中对对手使用。\n");


  if ((int)me->query_skill("longzhua-gong", 1) < 130)
    return notify_fail("你的龙爪功不够娴熟，不会使用「龙行天下」。\n");
  if (me->query_temp("weapon"))
    return notify_fail("你先放下手中的武器再说吧！\n"); if ((int)me->query_str() < 30)
      return notify_fail("你的臂力太低，不能使用「龙行天下」。\n");
  if ((int)me->query_temp("inpfm"))
    return notify_fail(HIW "你刚刚用完绝招，内息还未调匀！\n" NOR);
  if ((int)me->query("neili", 1) < 1000)
    return notify_fail("你现在内力太弱，不能使用「龙行天下」。\n");
  i = (me->query_skill("yijinjing", 1) / 10);
  msg = HIW "\n$N长啸一声，跃往半空，如巨龙翱翔于九天之上，蓦的直扑而下，好一式" HIC "[龙行天下]" HIW "！\n" NOR;
  msg1 = HIY "$N一招使完，退过一旁，调匀消耗的内力。\n" NOR;
  me->add_temp("apply/attack", i);
  me->add_temp("apply/dodge", i);
  me->add_temp("apply/claw", i);
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);

  me->add("neili", -100);
  me->start_busy(2);
  me->add_temp("apply/attack", -i);
  me->add_temp("apply/dodge", -i);
  me->add_temp("apply/claw", -i);
  message_vision(msg1, me, target);

  me->set_temp("inpfm", 1);  //设置绝招限制标记
  call_out("back", 15, me);  //一定要有，这个是还原的定时器。    
  return 1;
}
void back(object me) {
  tell_object(me, HIB "你已将内息调匀，又可以使用绝招了。\n" NOR);
  me->delete_temp("inpfm");
}
