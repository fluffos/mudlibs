//tianluo-diwang.c 天罗地网势 
#include <ansi.h>
#include <power_control.h>
#include <pfm_control.h>
#include <combat.h>
inherit SKILL;

string *dodge_msg = ({

  "$n腰肢轻摆，就如一朵菊花在风中微微一颤，斜身移步，早已避开。\n",
  "$n展开轻功提纵术，犹如疾风掠地，忽来忽往，瞬息之间进退数次，於丈许方圆之内腾挪奔跃，令$N无从进招！\n",
  "$n顺著$N攻势避过，身形一幌，竟然在$N身边一掠而过，趋退若神，步子微挫，早已让开。\n",
  "$n脚步轻盈，身手迅捷，轻功施展得圆转如意，身法之快，异乎寻常，矫夭腾挪，轻轻巧巧地避过$N这一招。\n",
  "却见$n潇洒自如，足下微尘不起，轻飘飘的似是缓步而行，不疾不徐地避了开去，的是飘逸无伦，变化万方！\n",
  "$n展开古墓派轻功，奔驰来去，斜窜急转，纵横飘忽，令$N难以确定出手的方位！\n",
  "$n衣襟当风，飘飘然如欲乘风而去，越奔越是轻捷，飞舞来去，脚下全不着力，$N不禁暗感难以捉摸！\n",
  "$n双足一登，身子腾空而起，犹似燕子穿林一般，离地尺许，平平掠过，相形之下，$N的招数似乎倒来迟一步！\n",
  "$n展开古墓派轻功，身随意走，一起脚，急奔如电，$N竟然跟随不上，心下暗暗惊佩！\n",
  "$n身子向前一挺，飞也似的滑了开去，但见$n东滑西闪，左转右折，实无瞬息之间停留，$N的诸般招式一一落空！\n",
});

string *msg = ({
  "$N一式「回望南山」，双掌一合，直向$n的$l击去",
  "$N身形一变，一式「笑指终南」，双掌似曲似直，拍向$n的$l",
  "$N使一式「湖光山色」，左掌如微风拂面，右掌似细雨缠身，直取$n的$l",
  "$N双手挥出，东边一收，西边一拍，将$n的周身去路全数挡住，双掌这边挡，那边拍，$n竟是难以脱出掌影笼罩三尺之外",
  "$N身形一转，使出一式「飞龙在天」，只见漫天掌影罩住了$n的全身",
  "$N突然身形一缓，使出一式「小雨初晴」，左掌凝重，右掌轻盈，击往$n的$l",
  "$N使一式「风雪江山」，双掌挟狂风暴雪之势，猛地劈向$n的$l",
  "$N一招「青云直上」，双掌带着萧瑟的秋气，拍向$n的$l",
  "$N身法陡然一变，使出一式「冰清玉洁」，掌影千变万幻，令$n无法躲闪",
  "$N清啸一声，一式「天罗地网」，双掌挥舞，如同雪花随风而转，击向$n的$l",
  "$N双掌一并，凭虚击去，这路「天罗地网势」的掌法使将出来，绵密无比，掌力虽不沉雄，但手法迅疾，东发一招、西劈一掌，飘忽灵动之极",
});


int valid_enable(string usage) { return usage == "strike" || usage == "parry" || usage == "dodge"; }

int valid_combine(string combo) { return combo == "meinu-quanfa"; }

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("天罗地网势必须空手。\n");
  if ((int)me->query_skill("yunu-xinjing", 1) < 120)
    return notify_fail("你的玉女心经火候不够，无法学天罗地网势。\n");
  if ((int)me->query("max_neili") < 1500)
    return notify_fail("你的内力太弱，无法练天罗地网势。\n");
  return 1;
}
mapping query_action(object me, object weapon) {
  string a_msg;
  a_msg = msg[random(sizeof(msg))];
  if ((int)me->query_temp("tldw_start") == 1)
    a_msg = select_color() + a_msg + NOR;
  return ([
    "damage_type": random(2) ? "内伤" : "瘀伤",
    "action": a_msg
  ]) + query_my_power(
    me,
    (int)me->query_skill("tianluo-diwang", 1),
    at_type_hand,
    me->query("gender") == "男性" ? attack_lvl_middle : attack_lvl_normal,
    defense_lvl_normal
  );
}

int practice_skill(object me) {
  if ((int)me->query("jingli") < 50)
    return notify_fail("你的精力太低了。\n");
  if ((int)me->query("neili") < 50)
    return notify_fail("你的内力太低了。\n");
  me->receive_damage("jingli", 35);
  me->add("neili", -30);
  return 1;
}
string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}


string perform_action_file(string action) {
  return __DIR__ "tianluo-diwang/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  if (!me->query_temp("pfm_tldw")) return 0;
  if (random((int)me->query_skill(
    "tianluo-diwang",
    1
  )) > (int)victim->query_skill("dodge", 1) / 2 && random(6) > 3 && (int)me->query("neili") > 0) {
    me->set_temp("tldw_start", 1);
    bei_none(me, "strike");
    me->prepare_skill("strike", "tianluo-diwang");
    me->add_temp("apply/attack", (int)me->query_skill("tianluo-diwang", 1) / 3);
    COMBAT_D->do_attack(me, victim, me->query_temp("weapon"), TYPE_RIPOSTE);
    me->add_temp("apply/attack", -(int)me->query_skill("tianluo-diwang", 1) / 3);
    bei_old(me);
    me->delete_temp("tldw_start");
  }
  return 0;
}
