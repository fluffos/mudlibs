// mianzhang.c 绵掌
// xQin 12/98

#include <combat.h>
inherit SKILL;

int huakai(object me, object victim);

mapping *action = ({
  ([ "action": "$N右掌左拳，一招「推心置腹」，出拳推掌，左右交叉，齐往$n心腹按去",
    "force": 145,
    "dodge": 5,
    "parry": 15,
    "damage_type": "内伤",
    "lvl": 0,
    "skill_name": "推心置腹"
  ]),
  ([ "action": "$N一招「偏花七星」，双切掌向前平推。发掌之际劲力雄浑，身形沉稳，凝重如山",
    "force": 160,
    "dodge": 5,
    "parry": 15,
    "damage_type": "瘀伤",
    "lvl": 10,
    "skill_name": "偏花七星"
  ]),
  ([ "action": "$N身腰左转成寒鸡式，双掌举过额角，左手虎口与右手虎口遥遥相对，却是一招「双圈手」",
    "force": 180,
    "dodge": 8,
    "parry": 10,
    "damage_type": "瘀伤",
    "lvl": 20,
    "skill_name": "双圈手"
  ]),
  ([ "action": "$N左掌握拳护腰，右掌切击而出，正式一招「右穿花手」。这一招气凝如山，掌势之出，有若长江大河",
    "force": 245,
    "dodge": 10,
    "parry": 10,
    "damage_type": "瘀伤",
    "lvl": 30,
    "skill_name": "右穿花手"
  ]),
  ([ "action": "$N招数忽变，双掌轻飘飘地，若有若无的拍出。一招「海底翻花」，左手虚引，右手倏出，向$n$l拍来",
    "force": 290,
    "dodge": 15,
    "parry": 15,
    "damage_type": "内伤",
    "lvl": 40,
    "skill_name": "海底翻花"
  ]),
  ([ "action": "$N踏上一步，使出一式「四通八达」，挥掌斜击$n$l。这一招出手极快，掌势大开大阖，甚具威力",
    "force": 335,
    "dodge": 10,
    "parry": 15,
    "damage_type": "瘀伤",
    "lvl": 50,
    "skill_name": "四通八达"
  ]),
  ([ "action": "$N错步转身，左一回右一旋，绕到了$n身後。一招「鹿死谁手」，猛地左手指节成虎爪之形，意传真气，向$p$l按落",
    "force": 370,
    "dodge": 10,
    "parry": 15,
    "weapon": "左手虎爪",
    "damage_type": "刺伤",
    "lvl": 60,
    "skill_name": "鹿死谁手"
  ]),
  ([ "action": "$N左手挥掌猛击$n右颊，右手出指疾点$p左肩“缺盆穴”。这一招「花开并蒂」十分厉害",
    "force": 400,
    "dodge": 15,
    "parry": 15,
    "weapon": "右手手指",
    "damage_type": random(2) ? "刺伤" : "瘀伤",
    "lvl": 70,
    "skill_name": "花开并蒂",
    "post_action": (: huakai :)
  ])
});

int valid_enable(string usage) { return usage == "strike" || usage == "parry"; }

int valid_combine(string combo) { return combo == "changquan"; }

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练习绵掌必须空手。\n");
  if ((int)me->query_skill("changquan", 1) < 30)
    return notify_fail("你的武当长拳火候不够，无法学习绵掌。\n");
  if ((int)me->query("max_neili") < 100)
    return notify_fail("你的内力太弱，无法练习绵掌。\n");
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  int i, level;

  if (me->query_temp("huakai")) {
    return ([
      "action": "双手递招之後，$N紧跟着左右互调，右掌击$n左颊，左手食指点$p右肩後“缺盆穴”",
      "force": 450,
      "dodge": 10,
      "parry": 10,
      "weapon": "左手食指",
      "damage_type": random(2) ? "刺伤" : "瘀伤" ]);
  }

  level = (int)me->query_skill("mianzhang", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me) {
  if ((int)me->query("jingli") < 30)
    return notify_fail("你的体力不够练绵掌。\n");
  if ((int)me->query("neili") < 20)
    return notify_fail("你的内力不够练绵掌。\n");
  me->receive_damage("jingli", 25, "精力透支过度死了");
  me->add("neili", -5);
  return 1;
}

int huakai(object me, object victim) {
  int level = me->query_skill("taiji-shengong", 1);

  if (me->query_skill_mapped("force") == "taiji-shengong" && random(level) > 50) {
    me->set_temp("huakai", 1);
    COMBAT_D->do_attack(me, victim, me->query_temp("weapon"));
    me->delete_temp("huakai");
    message_vision("\n这两招「花开并蒂」并成一招，连续四式，便如暴风骤雨般使出，势道之猛，手法之快，当真非同小可！\n", me);
    return 1;
  }

  return 1;
}
