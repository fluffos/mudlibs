#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;

int perform(object me, object target) {
  object weapon, ob;
  string msg;
  if (!me->is_fighting())
    return notify_fail("玄铁剑法「断」字决只能在战斗中使用。\n");
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("neili") < 200)
    return notify_fail("你的真气不够！\n");
  if ((int)me->query_skill("sword") < 60 ||
    me->query_skill_mapped("sword") != "xuantie-jianfa")
    return notify_fail("你的「玄铁剑法」还不到家，无法使用「断」字决！\n");
  msg = HIY "$N猛然伏地，使出玄铁剑法之玄铁剑断字决，顿时一片白光直向前滚去！\n" NOR;
  message_vision(msg, me);
  me->clean_up_enemy();
  ob = me->select_opponent();
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 1);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 1);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 1);
  me->add("neili", -150);
  me->start_busy(1);
  return 1;
}
