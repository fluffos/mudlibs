//xiangmo.c
// by kain
#include <ansi.h>
inherit F_SSERVER;
int perform(object me, object target) {
  int j = me->query_skill(
    "xiangmo-chu",
    1
  ) / 10 + me->query_skill("shenkong-xing", 1) / 10 + me->query_skill("longxiang-gong", 1) / 10;
  object weapon = me->query_temp("weapon");
  if (!target) target = offensive_target(me);
  if (!target || !me->is_fighting(target))
    return notify_fail("金刚降魔只能对战斗中的对手使用。\n");
  if ((int)me->query_skill("longxiang-gong", 1) < 120)
    return notify_fail("你的内功还未练成，不能使用金刚降魔！\n");
  if ((int)me->query_skill("xiangmo-chu", 1) < 120)
    return notify_fail("你的杖法还未练成，不能使用金刚降魔！\n");
  if (!weapon || weapon->query("skill_type") != "staff"
    || me->query_skill_mapped("staff") != "xiangmo-chu")
    return notify_fail("你手里没有杖，无法使用金刚降魔！\n");
  if (me->query_skill_mapped("force") != "longxiang-gong")
    return notify_fail("你的内功不是龙象般若功，无法使用金刚降魔！\n");
  if (me->query_skill_mapped("parry") != "xiangmo-chu")
    return notify_fail("你的招架功夫不对，无法使用金刚降魔！\n");
  if ((int)me->query("max_neili") < 1000)
    return notify_fail("你现在内力修为不够，不能使用金刚降魔！\n");
  if ((int)me->query("neili") < 500)
    return notify_fail("你现在内力不足，不能使用金刚降魔！\n");
  if ((int)me->query_skill("staff", 1) < 100)
    return notify_fail("你的基本杖法不够娴熟，不能使用金刚降魔。\n");
  message_vision(HIY "\n$N狂吼一声使出降魔金刚绝技--金刚降魔，人似疯狂一般冲向$n！\n" NOR, me, target);
  me->add("jingli", -50);
  me->add("neili", -200);
  me->start_perform(4, "金刚降魔");
  me->add_temp("apply/dexerity", j);
  me->add_temp("apply/damege", j);
  me->add_temp("apply/attack", j);
  me->add_temp("apply/dodge", j);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 2);
  weapon->wield();
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 2);
  weapon->wield();
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 2);
  weapon->unequip();
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 2);
  weapon->unequip();
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 2);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 2);
  weapon->wield();
  me->add_temp("apply/dexerity", -j);
  me->add_temp("apply/damege", -j);
  me->add_temp("apply/dodge", -j);
  me->add_temp("apply/attack", -j);
  me->start_busy(4);
  return 1;
}
