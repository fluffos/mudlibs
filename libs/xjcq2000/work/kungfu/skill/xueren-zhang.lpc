  ([ "action": RED "$N 使出血影掌的［血中魅影］，骤然间，一片刀光，一道血影，左右直扑$n！" NOR,
    "dodge": 100,
    "parry": 100,
    "force": 300,
    "damage_type": "瘀伤",
    "lvl": 30,
    "skill_name": "血中魅影"
  ]),
  ([ "action": RED "$N 使出血影掌的［血衣漩尘］，身上的金红袈裟激扬起来，覆盖了$n的视线，$N的一双“血影手”，已戳向$n。" NOR,
    "dodge": 50,
    "parry": 100,
    "force": 340,
    "damage_type": "内伤",
    "lvl": 40,
    "skill_name": "血衣漩尘"
  ]),
  ([ "action": RED "$N 马上知道$n变招，立时移开双手，却见［满天血影］，向$n扑去！" NOR,
    "dodge": 10,
    "parry": 100,
    "force": 150,
    "damage_type": "瘀伤",
    "lvl": 50,
    "skill_name": "满天血影"
  ]),
  ([ "action": RED "$N 左右开弓，使出血影掌的［影随人行］，迅如鬼魅，大肚和尚渐感招架不来。    血影大师五指并伸，十指如戟，左右疾刺$n！" NOR,
    "force": 460,
    "dodge": -400,
    "damage_type": "瘀伤",
    "lvl": 70,
    "skill_name": "影随人行"
  ]),
  ([ "action": RED "$N左手挥起，掌心朝天，掌中带红，直奔$n,一招［血影腥风］使了出来! " NOR,
    "dodge": 100,
    "parry": 100,
    "force": 850,
    "damage_type": "瘀伤",
    "lvl": 90,
