// dingtian.c
// created by yixian for tz
// second modifies by yixian for mr

#include <ansi.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target) {
  string msg, msg1;
  int i;
  object weapon;
  if (!target) target = offensive_target(me);
  if (!target || !me->is_fighting(target))
    return notify_fail("「一掌定天」只能在战斗中对对手使用。\n");
  weapon = me->query_temp("weapon");
  if (objectp(me->query_temp("weapon")))
    return notify_fail("你必须空手才能使用「一掌定天」神功！\n");

  if ((int)me->query_skill("shenyuan-gong", 1) < 180)
    return notify_fail("你的神元功不够娴熟，不会使用「一掌定天」。\n");

  if ((int)me->query_skill("xingyi-zhang", 1) < 160)
    return notify_fail("你的星移掌修为不够，不能使用「一掌定天」。\n");

  if (me->query_skill_mapped("force") != "shenyuan-gong")
    return notify_fail("你的内功等级不够，不能使用「一掌定天」。\n");

  if ((int)me->query("neili", 1) < 1000)
    return notify_fail("你现在内力太弱，不能使用「一掌定天」。\n");
  if ((int)me->query("jingli", 1) < 500)
    return notify_fail("你现在精力太少，不能使用「一掌定天」。\n");

  i = (me->query_skill(
    "shenyuan-gong",
    1
  ) + me->query_skill("strike") + me->query_skill("xingyi-zhang") / 3);

  weapon = target->query_temp("weapon");

  if (objectp(weapon)) {

    if (random(20) > 3) {

      message_vision(HIY "只见$N伸出右掌，微微向$n手中的兵器一拍。\n" NOR, me, target);

      if (weapon->query("rigidity") < 5) {
        weapon->move(environment(me));
        tell_room(environment(me), HIY "只听“啪！……”的一声，好像有什么东西掉在了地上。\n" NOR);
        me->start_busy(3);
        weapon->set("name", "断掉的" + weapon->query("name"));
        weapon->set("value", 1);
        weapon->set("weapon_prop", 0);
        me->add("neili", -300);
        me->start_perform(3, "「一掌定天」");
      } else {
        weapon->move(environment(me));
        me->start_busy(3);
        message_vision(HIW "$N手中兵器飞了出去……\n" NOR, target);
        me->add("neili", -300);
      }
    } else {
      message_vision("只听“啪！……”的一声$N手拍中了$n手中的兵器，$n心中一惊兵器差点被$N打飞。\n", me, target);
      message_vision(YEL "$N看到$n是的兵器仍在手中，心中一急忙攻出三招。\n" NOR, me, target);

      me->add_temp("apply/strength", i);
      me->add_temp("apply/attack", i);

      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK);
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK);
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK);

      me->add("neili", -400);
      me->start_busy(2);
      me->add_temp("apply/strength", -i);
      me->add_temp("apply/attack", -i);
      me->start_perform(5, "「一掌定天」");
    }
  }

  else {
    i = i * 2;

    me->add_temp("apply/strength", i);
    me->add_temp("apply/attack", i);
    message_vision(HIW "$N大叫一声，一招向$n攻了过去……\n" NOR, me, target);

    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK);

    me->add_temp("apply/strength", -i);
    me->add_temp("apply/attack", -i);
    me->add("neili", -400);
    me->start_busy(2);
    me->start_perform(3, "「一掌定天」");
  }

  return 1;
}
