  ([ "action": "$N气沉丹田，突然爆发出一声闷响，手中$w抖的笔直，一式[金龙出海]，急刺$n的$l",
    "dodge": 25,
    "damage": 200,
    "force": 350,
    "lvl": 200,
    "skill_name": "金龙出海",
    "damage_type": "刺伤"
  ]),
});
int valid_enable(string usage) { return (usage == "whip") || (usage == "parry"); }
int valid_learn(object me) {
  object weapon;
  if (!me->query("family") || me->query("family/family_name") != "神龙教")
    return notify_fail("你不是神龙弟子，如何能用这灵蛇鞭法？\n");
  if ((int)me->query("max_neili") < 100)
    return notify_fail("你的内力修为不足，没有办法练灵蛇鞭法。\n");
  if ((int)me->query_skill("shenlong-xinfa", 1) < 30)
    return notify_fail("你的神龙心法火候太浅。\n");
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "whip")
    return notify_fail("你必须先找一条鞭子才能练鞭法。\n");
  return 1;
}
string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}
mapping query_action(object me) {
  int i, level;
  level = (int)me->query_skill("lingshe-bian", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[NewRandom(i, 20, level / 5)];
}
int practice_skill(object me) {
  object weapon;
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "whip")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query_skill("shenlong-xinfa", 1) < 30)
    return notify_fail("你的神龙心法火候太浅。\n");
  if ((int)me->query("jingli") < 50)
    return notify_fail("你的体力不够练日月鞭法。\n");
  me->receive_damage("jingli", 70);
  return 1;
}
string perform_action_file(string action) {
  return __DIR__ "lingshe-bian/" + action;
}
