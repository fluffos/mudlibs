  ([ "action": "$N高喝一声，吸气催力，一式「天龙下凡」，手中$w急速转动，鞭影纵横，凌空绞向$n",
    "dodge": 15,
    "damage": 120,
    "force": 220,
    "lvl": 120,
    "skill_name": "天龙下凡",
