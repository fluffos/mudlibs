#include <ansi.h>

inherit F_SSERVER;

int perform(object me, object target) {
  int lvl;
  object weapon;
  weapon = me->query_temp("weapon");
  lvl = (int)me->query_skill("taiji-jian", 1) / 4;
  if (!target) target = offensive_target(me);

  if (!target || !me->is_fighting(target))
    return notify_fail("「动静六诀」只能在战斗中对对手使用。\n");

  if (!weapon || weapon->query("skill_type") != "sword"
    || me->query_skill_mapped("sword") != "taiji-jian")
    return notify_fail("你手里没有剑，无法使用「动静六诀」！\n");

  if ((int)me->query_skill("sword", 1) < 100)
    return notify_fail("你的基本剑法等级不够，不能使用「动静六诀」！\n");
  if ((int)me->query_skill("taiji-jian", 1) < 100)
    return notify_fail("你的太极剑法等级不够，不能使用「动静六诀」！\n");
  if ((int)me->query_skill("yinyun-ziqi", 1) < 100)
    return notify_fail("你的氤氲紫气等级不够，不能使用「动静六诀」！\n");
  if (me->query_skill_mapped("force") != "yinyun-ziqi")
    return notify_fail("你所使用的内功不对。\n");
  if ((int)me->query("max_neili") < 1000)
    return notify_fail("你的内力太弱，不能使用「动静六诀」！\n");

  if ((int)me->query("neili") < 300)
    return notify_fail("你的内力太少了，无法使用出「动静六诀」！\n");


  message_vision(HIG "\n$N身法忽急忽缓，不断绕着$n游走，突然使出武当绝技「动静六诀」！\n\n" NOR, me, target);
  if (random(me->query("combat_exp")) > (int)target->query("combat_exp") / 4) {
    message_vision(HIC "\n$n一时不查,竟被转了个头晕眼花!摹的,$N瞬息间便向$n刺出六剑！\n\n" NOR, me, target);
    me->add("neili", -350);
    me->add_temp("apply/dodge", lvl);
    me->add_temp("apply/attack", lvl);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
    me->add_temp("apply/dodge", -lvl);
    me->add_temp("apply/attack", -lvl);
    me->start_busy(2);
    target->start_busy(1);
  } else {
    message_vision(HIC "\n$n紧守门户,全力应对,$N眼见无法找出破绽,只得跳过一旁,那「动静六诀」便并未使全\n\n" NOR, me, target);
    me->add("neili", -300);
    me->start_busy(1 + random(3));
    target->start_busy(1);
  }
  return 1;
}
