// 通臂拳
// yun_control.h
#include <ansi.h>
#include <power_control.h>
inherit SKILL;
string *msg = ({
  "$N双拳平推，一招「力摧山河」，拳风加着雷声隐隐作响，击向$n。",
  "$N高高跃起，一招「巨石压顶」，向$n挥去,有巨石压顶之势。",
  "$N左拳急挥，右拳击向$n的$l，好一招「挥金断玉」，令$n防之不及。",
  "$N一招「孤海听涛」，左手虚晃，右拳向$n招呼过去。",
  "$N大喝一声，使出「雷霆一击」，出拳迅速击$n，突然手臂暴张内力外吐，$n措手不及。",
});
int valid_enable(string usage) { return usage == "cuff" || usage == "parry"; }
int valid_combine(string combo) { return combo == "suohou-shou"; }
mapping query_action(object me, object weapon) {
  return ([
    "damage_type": random(2) ? "内伤" : "瘀伤",
    "action": msg[random(sizeof(msg))]
  ]) + query_my_power(
    me,
    (int)me->query_skill("tongbi-quan", 1),
    at_type_hand,
    attack_lvl_high,
    defense_lvl_normal
  );
}
int practice_skill(object me) {
  object weapon;
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练通臂拳必须空手。\n");
  if ((int)me->query("jingli") < 60)
    return notify_fail("你的体力不够练通臂拳。\n");
  if ((int)me->query("neili") < 30)
    return notify_fail("你的内力不够练通臂拳。\n");
  me->receive_damage("jingli", 50);
  me->add("neili", -25);
  return 1;
}
int valid_learn(object me) {
  if ((int)me->query("max_neili") < 100)
    return notify_fail("你的内力修为不够。\n");
  if ((int)me->query_skill("huntian-qigong", 1) < 20)
    return notify_fail("你的混天气功火候不到。\n");
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "tongbi-quan/" + action;
}
