//fengmo.c
// by kain

#include <ansi.h>
inherit F_SSERVER;
int perform(object me, object target) {
  int j = me->query_skill(
    "tianshan-zhang",
    1
  ) / 10 + me->query_skill("chousui-zhang", 1) / 10 + me->query_skill("huagong-dafa", 1) / 10;
  object weapon = me->query_temp("weapon");
  if (!target) target = offensive_target(me);

  if (!target || !me->is_fighting(target))
    return notify_fail("疯魔乱舞只能对战斗中的对手使用。\n");

  if ((int)me->query_skill("huagong-dafa", 1) < 100)
    return notify_fail("你的内功还未练成，不能使用疯魔乱舞！\n");

  if ((int)me->query_skill("tianshan-zhang", 1) < 100)
    return notify_fail("你的杖法还未练成，不能使用疯魔乱舞！\n");

  if (!weapon || weapon->query("skill_type") != "staff"
    || me->query_skill_mapped("staff") != "tianshan-zhang")
    return notify_fail("你手里没有杖，无法使用疯魔乱舞！\n");

  if ((int)me->query_skill("chousui-zhang", 1) < 100)
    return notify_fail("你的掌法还未练成，不能使用疯魔乱舞！\n");

  if (me->query_skill_mapped("force") != "huagong-dafa")
    return notify_fail("你的内功不是化功大法，无法使用疯魔乱舞！\n");

  if (me->query_skill_mapped("strike") != "chousui-zhang"
    || me->query_skill_prepared("strike") != "chousui-zhang")
    return notify_fail("你没有用掌，无法使用疯魔乱舞！\n");

  if (me->query_skill_mapped("parry") != "chousui-zhang")
    if (me->query_skill_mapped("parry") != "tianshan-zhang")
      return notify_fail("你的招架功夫不对，无法使用疯魔乱舞！\n");

  if ((int)me->query("max_neili") < 1200)
    return notify_fail("你现在内力修为不够，不能使用疯魔乱舞！\n");

  if ((int)me->query("neili") < 600)
    return notify_fail("你现在内力不足，不能使用疯魔乱舞！\n");

  if ((int)me->query_skill("staff", 1) < 100)
    return notify_fail("你的基本杖法不够娴熟，不能使用疯魔乱舞。\n");

  if ((int)me->query_skill("strike", 1) < 100)
    return notify_fail("你的基本掌法不够娴熟，不能使用疯魔乱舞。\n");
  message_vision(HIY "\n$N狂吼一声使出天山杖法绝技--疯魔乱舞，人似疯狂一般冲向$n！\n" NOR, me, target);
  me->add("jingli", -50);
  me->add("neili", -200);
  me->start_perform(4, "疯魔乱舞");
  me->add_temp("apply/dexerity", j);
  me->add_temp("apply/damege", j);
  me->add_temp("apply/attack", j);
  me->add_temp("apply/dodge", j);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 2);
  weapon->wield();
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 2);
  weapon->unequip();
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 2);
  weapon->unequip();
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 2);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 2);
  weapon->wield();
  me->add_temp("apply/dexerity", -j);
  me->add_temp("apply/damege", -j);
  me->add_temp("apply/dodge", -j);
  me->add_temp("apply/attack", -j);
  me->start_busy(3);
  return 1;
}
