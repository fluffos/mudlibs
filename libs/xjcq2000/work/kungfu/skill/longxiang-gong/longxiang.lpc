// /kungfu/skill/longxiang-gong
// by dubei

#include <ansi.h>
#include <combat.h>
inherit F_SSERVER;

void remove_effect(object me) {
  int i, z, skill;
  skill = me->query_skill("longxiang-gong", 1);
  i = skill / 30;
  if (me && me->query_temp("mz_lx")) {
    me->add_temp("apply/strength", -i * i);
    me->add_temp("apply/dexerity", -i * i);
    me->add_temp("apply/dodge", -i * i);
    me->delete_temp("mz_lx");
    tell_object(me, HIR "你的「龙象般若神通」运功完毕，感到内劲渐渐消退。\n" NOR);
  }
}

int exert(object me) {

  int i, z, skill;
  skill = me->query_skill("longxiang-gong", 1);
  i = skill / 30;
  if (i > 13) i = 13;
  if ((int)me->query("neili") < i * i * 11 || (int)me->query("max_neili") < i * i * 11)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_temp("mz_lx"))
    return notify_fail("你已经在运功中了。\n");
  if (me->query_temp("honglian"))
    return notify_fail("你正在使用「红莲火」。\n");
  if (me->query_temp("combat_yield"))
    return notify_fail("哦。。。你现在正打不还手呢。\n");


  z = i * 5;
  me->add("neili", -500);

  message_vision(
    HIR "\n$N深吸一口气，运起第" HIC + i + HIR "乘的「龙象般若神通」，将内力运自全身上下，身边陡然出现" HIC + i + HIR "道金色的佛光，将$N笼罩在内！\n\n" NOR,
    me
  );
  me->add_temp("apply/strength", i * i);
  me->add_temp("apply/dexerity", i * i);
  me->add_temp("apply/dodge", i * i);
  me->set_temp("mz_lx", 1);
  me->add("neili", -i * i * 10);  //     check_fight(me);
  call_out("remove_effect", z, me);
  me->start_busy(1);
  return 1;
}
