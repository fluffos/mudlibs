// qingyan-zhang.c 五罗轻烟掌
#include <ansi.h>
#include <power_control.h>
inherit SKILL;
string *msg = ({
  "$N向后飘出尺许，转过身来，一招「五陵烟云」忽地左掌向后斜劈，飕的一声轻响切向$n的$l",
  "$N起手一式「烟雾弥漫」，右掌向后斜劈，荡起一股微风抚向$n的$l，不带丝毫霸气",
  "$N微微一笑，出掌按向$n的$l，如行云、如流水，潇洒之极，正是那招「烟雨朦胧」",
  "$N抬起头来，目不转瞬的向$n凝视，接着轻飘飘一转身「烟飘云散」左右两掌往后拍出",
  "$N身形随风飘动，一式「五罗轻烟」左右轻拍连出五掌，五丝轻风绕过$N的身子悄然向$n的$l袭去",
});

int valid_enable(string usage) { return usage == "strike" || usage == "parry"; }

int valid_combine(string combo) {
  object me = this_player();
  if ((int)me->query_skill("qingyan-zhang", 1) > 130 && (int)me->query("max_neili") > 1800)
    return combo == "yiyang-zhi";
}

mapping query_action(object me) {
  int level;
  string a_msg;
  level = (int)me->query_skill("qingyan-zhang", 1);
  a_msg = msg[random(sizeof(msg))];
  if (random(level) > level - level / 6)
    a_msg = select_color() + a_msg + NOR;
  return ([
    "damage_type": random(2) ? "内伤" : "瘀伤",
    "action": a_msg
  ]) + query_my_power(me, level, at_type_hand, attack_lvl_normal, defense_lvl_normal);
}

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("空手才能练习五罗轻烟掌。\n");

  if (!me->query_skill("kurong-changong", 1))
    if (!me->query_skill("qiantian-yiyang", 1))
      return notify_fail("练五罗轻烟掌需要有乾天一阳功的支持。\n");

  if (!me->query_skill("kurong-changong", 1))
    if ((int)me->query_skill("qiantian-yiyang", 1) < 10)
      return notify_fail("你的乾天一阳功根基不够。\n");
  if ((int)me->query("max_neili") < 100)
    return notify_fail("你内力修行太差, 练不了五罗轻烟掌掌。\n");
  return 1;
}

int practice_skill(object me) {
  if (!me->query_skill("kurong-changong", 1))
    if (!me->query_skill("qiantian-yiyang", 1))
      return notify_fail("练五罗轻烟掌需要有乾天一阳功的支持。\n");
  if ((int)me->query("jingli") < 30)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 20)
    return notify_fail("你的内力不够练五罗轻烟掌掌。\n");
  me->receive_damage("jingli", 30);
  me->add("neili", -10);
  return 1;
}
string perform_action_file(string action) {
  return __DIR__ "qingyan-zhang/" + action;
}
