// hunyuan-zhang.c 华山混元掌 
#include <ansi.h>
#include <power_control.h>
inherit SKILL;
string *msg = ({ "$N掌风激荡，双掌错落，来势神妙无方，一招「云断秦岭」，劈向$n的$l",
  "$N双掌骤起，一招「青松翠翠」，一掌击向$n面门，另一掌却按向$n小腹",
  "$N双掌互错，变幻莫测，一招「高山流水」，前后左右，瞬息之间向$n攻出了十六招",
  "$N一声清啸，呼的一掌，一招「山回路转」，自巧转拙，却是去势奇快，向$n的$l猛击过去，",
  "$N大喝一声，双掌交错，若有若无，飘渺间一招「金玉满堂」，掌风急速拍向$n的$l",
  "$N一招「青山断河」，右手一拳击出，左掌紧跟着在右拳上一搭，变成双掌下劈，击向$n的$l",
  "$N双手齐划，跟着双掌齐推，一招「风伴流云」，一股排山倒海的掌力，直扑$n面门",
  "$N突然滴溜溜的转身，一招「湮雨飘渺」，掌影飞舞，霎时之间将$n四面八方都裹住了",
});

int valid_enable(string usage) { return usage == "strike" || usage == "parry"; }
int valid_combine(string combo) { return combo == "poyu-quan"; }
int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练混元掌必须空手。\n");
  if (me->query_skill_mapped("force") != "zixia-gong")
    return notify_fail("你的紫霞神功火候不够，无法学习混元掌。\n");
  if ((int)me->query_skill("zixia-gong", 1) < 20)
    return notify_fail("你的紫霞神功火候不够，无法练混元掌。\n");
  if ((int)me->query("max_neili") < 100)
    return notify_fail("你的内力太弱，无法练混元掌。\n");
  return 1;
}

mapping query_action(object me) {
  int level;
  string a_msg;
  level = (int)me->query_skill("hunyuan-zhang", 1);
  a_msg = msg[random(sizeof(msg))];
  if (random(level) > level - level / 6)
    a_msg = select_color() + a_msg + NOR;
  return ([
    "damage_type": random(2) ? "劈伤" : "震伤",
    "action": a_msg
  ]) + query_my_power(me, level, at_type_hand, attack_lvl_middle, defense_lvl_middle);
}

int practice_skill(object me) {
  int lvl = me->query_skill("hunyuan-zhang", 1);
  int i = sizeof(msg);

  //	while (i--) if (lvl == msg[i]["lvl"]) return 0;

  if ((int)me->query("jingli") < 50)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 20)
    return notify_fail("你的内力不够练混元掌。\n");
  me->receive_damage("jingli", 30);
  me->add("neili", -8);
  return 1;
}


string perform_action_file(string action) {
  return __DIR__ "hunyuan-zhang/" + action;
}
