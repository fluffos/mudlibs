// ranmu-daofa.c 燃木刀法
#include <ansi.h>
#include <power_control.h>
inherit SKILL;
string *msg = ({
  "$N面带微笑，一招「烈火烧身」，举$w对着$n连砍了八八六十四刀，刀气纵横，迅雷不可挡",
  "$N运起内功一招「点木生火」，$w上带着无比劲气，划了一个大弧，从上而下劈向$n的$l",
  "$N手臂一沉，一招「张弓望月」，双手持$w划出一道雪亮刀光，接着拦腰反切，砍向$n的$l",
  "$N挥舞$w上劈下撩，左挡右开，使出一招「烈火腾云」，卷起阵阵刀风，齐齐罩向$n",
  "$N一招「火中取栗」，左脚跃步落地，手中$w单刀往前，挟着炙热的风声劈向$n的$l",
  "$N腾空而起，半空中一招「玉石俱焚」，手中$w挥出满天流光般的刀影，向$n的全身卷去",
});

int valid_enable(string usage) { return usage == "blade" || usage == "parry"; }

int valid_learn(object me) {
  if (!me->query("family") || me->query("family/family_name") != "少林派")
    return notify_fail("你不是少林弟子，如何能用这燃木刀法？\n");
  if ((int)me->query("max_neili") < 1000)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_skill("yijin-jing", 1) < 120)
    return notify_fail("你的易筋经内功火候太浅。\n");
  return 1;
}

mapping query_action(object me) {
  int level, at_lvl;
  string a_msg;
  at_lvl = attack_lvl_high;
  level = (int)me->query_skill("ranmu-daofa", 1);
  a_msg = msg[random(sizeof(msg))];
  if (random(level) > level - level / 8) {
    a_msg = HIR "$N忽然高宣一声佛号，身体急速的旋转，手中的$w散发出一股灼热的气流，袭向$n！" NOR;
    at_lvl = attack_lvl_super;
  }
  return ([
    "damage_type": random(2) ? "刺伤" : "割伤",
    "action": a_msg
  ]) + query_my_power(me, level, at_type_weapon, at_lvl, defense_lvl_normal);
}

int practice_skill(object me) {
  object weapon;
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("jingli") < 60)
    return notify_fail("你的精力不够练燃木刀法。\n");
  if ((int)me->query("neili") < 60)
    return notify_fail("你的内力不够练燃木刀法。\n");
  me->receive_damage("jingli", 50);
  me->add("neili", -50);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "ranmu-daofa/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  if (userp(me) && me->query_temp("fenwo_hit") &&
    victim->query("combat_exp") >= me->query("combat_exp") / 2
    && me->query("fenwo") < me->query_skill("blade"))
    me->add("fenwo", 1);  // for rmd's fenwo pfm 
}
void skill_improved(object me) {
  int skill;
  skill = me->query_skill("ranmu-daofa", 1);
  if (skill >= 200 && !me->query("rmd/200")) {
    tell_object(me, HIW "\n你将燃木刀法练习一边，忽然感觉自身修为提高了一步，哈哈大笑几声！\n" NOR);
    me->add("str", 1);
    me->add("int", 1);
    me->add("dex", 1);
    me->add("con", 1);
    me->set("rmd/200", 1);
  }
}
