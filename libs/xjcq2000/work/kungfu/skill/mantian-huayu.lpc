//mantian-huayu.c漫天花雨
// 19981010
//2000.09.29
#include <ansi.h>
#include <power_control.h>
#include <combat.h>
inherit SKILL;
string *msg = ({
  "$N身子左侧，一式「月下踏径」，右手$w从身体下方突然甩出，直射向$n的$l",
  "$w破空飞出，一式「长虹经天」，缓缓一个弧线，由左自右，绕向$n的$l，",
  "$N双手连扬，一式「破云见日」，两把$w向$n撒出，笼罩$n的全身上下",
  "$N向空中一撒，却是$n一招「秋日落叶」，数枚$w由空中缓缓落下",
  "$N身形急速向前滑动，一式「雪地追踪」，一枚$w向$n的胁下疾射而去",
  "$N一式「回首沧桑」，身体一转，反手掷出数枚$w，飞向$n的背部",
  "$N凌空一纵，一招「雨打浮萍」，居高临下，手中$w疾射，直向$n的$l",
  "$N一招「流星电闪」，手指弹出五枚$w，一点黑光射向$n的头部",
});
string *msg1 = ({ "晋", "小过", "中孚", "离", "明夷", "同人", "节", "丰", "损", });
int valid_enable(string usage) {
  return usage == "throwing" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  int level;
  string a_msg;
  level = (int)me->query_skill("mantian-huayu", 1);
  a_msg = msg[random(sizeof(msg))];
  if (random(level) > level - level / 8)
    a_msg = select_color() + a_msg + NOR;
  if (random(level) > level - level / 8 && level > 120 && (me->query_skill("qimen-bagua", 1) > 100))
    call_out("start_qimen", 1, me);
  return ([
    "damage_type": random(2) ? "刺伤" : "割伤",
    "action": a_msg,
    "post_action": (: call_other, WEAPON_D, "throw_weapon" :)
  ]) + query_my_power(me, level, at_type_weapon, attack_lvl_middle, defense_lvl_normal);

}
int practice_skill(object me) {
  object weapon;
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "throwing")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("jingli") < 50)
    return notify_fail("你的体力不够练漫天花雨。\n");
  me->receive_damage("jingli", 30);
  return 1;
}

int valid_learn(object me) {
  if ((int)me->query("max_neili") < 100)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_skill("force", 1) < 30)
    return notify_fail("你的内功火候太浅。\n");
  return 1;
}
string perform_action_file(string action) {
  return __DIR__ "mantian-huayu/" + action;
}
void start_qimen(object me) {
  int i;
  object target;
  string msg01, msg02, msg03, msg;
  target = offensive_target(me);
  if (!me || !living(me))
    return;
  if (!target
    || !target->is_character()
    || !me->is_fighting(target) || !living(target))
    return;
  msg01 = msg1[random(sizeof(msg1))];
  msg02 = msg1[random(sizeof(msg1))];
  msg03 = msg1[random(sizeof(msg1))];
  msg = HIB "$N双手一扬，三枚$w呈现品字型排列，呼啸而止，为" + msg01 + "、" + msg02 + "、" + msg03 + "三位\n直取$n的檀中、悬枢、气海三处要穴，
 正是" HIW "柯镇恶暗器绝学" HIY "『伏羲六十四卦打穴手法』" NOR;
  i = target->query_dex() * 2;
  me->add_temp("apply/attack", i);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_RIPOSTE, msg);
  me->add_temp("apply/attack", -i);
  return;
}
