#include <ansi.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target) {
  string msg, msg1;
  int i;
  object weapon;
  if (!target) target = offensive_target(me);
  if (!target || !me->is_fighting(target))
    return notify_fail("[四象斩]只能在战斗中对对手使用。\n");
  weapon = me->query_temp("weapon");
  if (!weapon || weapon->query("skill_type") != "blade"
    || me->query_skill_mapped("blade") != "wxsxruyi-zhan")
    return notify_fail("你必须使用在刀时才能使出[四象斩]！\n");

  if ((int)me->query_skill("wxsxruyi-zhan", 1) < 140)
    return notify_fail("你的五行四象如意斩不够娴熟，不会使用[四象斩]。\n");
  if ((int)me->query_temp("inpfm"))
    return notify_fail(HIW "你刚刚用完绝招，内息还未调匀！\n" NOR);
  if ((int)me->query_str() < 32)
    return notify_fail("你的臂力太低，不能使用[四象斩]。\n");
  if ((int)me->query("neili", 1) < 400)
    return notify_fail("你现在内力太弱，不能使用[四象斩]。\n");
  i = (me->query_skill("wxsxruyi-zhan", 1) * 1);
  msg = HIW "$N腾身跃起，一式[四象斩]，手中刀光幻为四色," CYN "
    “风”" HIR "“火”" HIC "“雷”" HIM "“电”" HIW "，轰鸣声中，急速的压向$n。\n";
  msg1 = HIW "$N落回地面，趁着$n慌乱之时，连接攻击。\n" NOR;
  me->add_temp("apply/strength", i);
  me->add_temp("apply/attack", i);
  me->add_temp("apply/dodge", i);
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK);

  me->add("neili", -400);
  target->start_busy(4);
  me->add_temp("apply/strength", -i);
  me->add_temp("apply/attack", -i);
  me->add_temp("apply/dodge", -i);
  message_vision(msg1, me, target);
  me->set_temp("inpfm", 1);  //设置绝招限制标记
  call_out("back", 15, me);  //一定要有，这个是还原的定时器。    
  return 1;
}

void back(object me) {
  tell_object(me, HIB "你已将内息调匀，又可以使用绝招了。\n" NOR);
  me->delete_temp("inpfm");
}
