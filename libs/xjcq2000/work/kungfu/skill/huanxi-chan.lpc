// buddhism.c

inherit SKILL;

void create() { seteuid(getuid()); }

string type() { return "knowledge"; }

int valid_learn(object me) {
  if (((string)me->query("family/family_name") != "雪山派" || (string)me->query("family/family_name") != "血刀门") && (int)me->query_skill(
    "huanxi-chan",
    1
  ) > 41)
    return notify_fail("你又没有出家当喇嘛，老学欢喜禅干什么？\n");
  return 1;
}

int practice_skill(object me) {
  return notify_fail("欢喜禅只能靠学(learn)来提高。\n");
}
