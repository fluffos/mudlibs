#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;
int update_condition(object me, int duration) {
  me->apply_condition("cu_fa", duration - 1);
  if (duration < 1) {
    me->move("/d/city/guangchang");
    tell_object(me, HIW "由于巫师们看你表现较好，所以把你放出来了。\n" NOR);
    return 0;
  }
  return CND_CONTINUE;
}

string query_type(object me) {
  return "sys";
}
