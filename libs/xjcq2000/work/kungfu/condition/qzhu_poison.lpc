#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;
int update_condition(object me, int duration) {

  tell_object(me, HIR "你只觉得气血翻涌，浑身犹如千万支毒蛛在咬嗤，痛苦难忍！\n" NOR);
  tell_room(environment(me), HIR + me->name() + "面孔扭曲，弯下腰不住低哼，浑身不停的颤抖！\n" NOR,
    ({ me }));
  me->receive_damage("qi", 15);
  me->receive_wound("jing", 15);
  me->set_temp("last_damage_from", "中千蛛万毒功");
  me->apply_condition("qzhu_poison", duration - 1);
  if (duration < 1) return 0;
  return CND_CONTINUE;
}

string query_type(object me) {
  return "poison";
}
