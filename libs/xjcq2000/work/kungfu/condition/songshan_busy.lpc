int update_condition(object me, int duration) {
  if (duration < 1) {
    if (!userp(me)) {
      me->delete_temp("songshan_job");
      me->delete_temp("last_lost_to");
      me->set("chat_chance", me->query("chat_c"));
      message(
        "vision",
        me->name() + "哼了一声：" + RANK_D->query_respect(me) + "我不耐烦了！说完便急急忙忙地离开了。\n",
        environment(),
        me
      );
      if (me->move(me->query("startroom")))
        message("vision", me->name() + "急急忙忙地走了过来。\n", environment(), me);
      else destruct(me);
    }
    return 0;
  }
  me->apply_condition("songshan_busy", duration - 1);
  return 1;
}

string query_type(object me) {
  return "job";
}
