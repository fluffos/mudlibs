  set("str", 32);
  set("int", 25);
  set("con", 30);
  set("dex", 32);
  set("max_qi", 1500);
  set("max_jing", 1500);
  set("neili", 2000);
  set("max_neili", 2000);
  set("jiali", 100);
  set("combat_exp", 450000);
  set("per", 10);
  set_skill("force", 100);
  set_skill("longxiang-gong", 100);
  set_skill("dodge", 100);
  set_skill("qingshen-fa", 100);
  set_skill("cuff", 100);
  set_skill("fuhu-quan", 100);
  set_skill("parry", 100);
  set_skill("lamaism", 100);
