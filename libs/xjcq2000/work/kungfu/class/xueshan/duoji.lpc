inherit NPC;
void create() {
  set_name("多吉大喇嘛", ({ "duoji dalama", "duoji" }));
  set("long", @LONG
多吉是大轮寺身份很高的大喇嘛，负责掌管藏经房的经书。
他身穿一件红色袈裟，头带僧帽。面色严肃，双母投射出一道精光。
LONG
  );
  set("gender", "男性");
  set("age", 55);
  set("attitude", "friendly");
  set("shen", 0);
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);
  set("max_qi", 3000);
  set("max_jing", 3000);
  set("neili", 3000);
  set("max_neili", 3000);
  set("jiali", 100);
  set("per", 18);
  set("eff_jingli", 2500);
  set("combat_exp", 1200000);
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: perform_action, "hand.dashouyin" :),
    (: exert_function, "fumozhou" :),
  }));
  set_skill("mizong-xinfa", 160);
  set_skill("literate", 160);
  set_skill("force", 160);
  set_skill("longxiang-gong", 160);
  set_skill("dodge", 160);
  set_skill("qingshen-fa", 160);
  set_skill("cuff", 160);
  set_skill("fuhu-quan", 160);
  set_skill("parry", 160);
  set_skill("hand", 160);
  set_skill("dashou-yin", 160);


  map_skill("force", "longxiang-gong");
  map_skill("dodge", "qingshen-fa");
  map_skill("cuff", "fuhu-quan");
  map_skill("parry", "dashou-yin");
  map_skill("hand", "dashou-yin");
  prepare_skill("cuff", "fuhu-quan");
  prepare_skill("hand", "dashou-yin");
  create_family("大轮寺", 10, "护教大喇嘛");
  set("class", "lama");

  setup();

  carry_object("/clone/armor/r-jiasha")->wear();
}
