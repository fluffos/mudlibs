// /kungu/class/xueshan/chengdi
// by dubei

inherit NPC;
void create() {
  set_name("胜谛喇嘛", ({
    "shengdi lama",
    "shengdi",
  }));
  set("long",
    "他就是血刀老祖的徒弟胜谛喇嘛。\n"
    "一个身材瘦小的和尚,皮肤黝黑,两眼透出精光.\n"
  );
  set("gender", "男性");
  set("attitude", "peaceful");
  set("class", "lama");
  set("per", 12);
  set("age", 48);
  set("shen", -6000);
  set("str", 35);
  set("int", 25);
  set("con", 30);
  set("dex", 32);
  set("max_qi", 2000);
  set("max_jing", 1500);
  set("neili", 2800);
  set("max_neili", 2800);
  set("jiali", 100);
  set("combat_exp", 650000);
  set("eff_jingli", 1500);
  set("chat_chance_combat", 40);
  set("chat_msg_combat", ({
    (: exert_function, "fumozhou" :),
    (: perform_action, "hand.dashouyin" :)
  }));
  set_skill("force", 150);
  set_skill("longxiang-gong", 150);
  set_skill("dodge", 130);
  set_skill("qingshen-fa", 130);
  set_skill("cuff", 120);
  set_skill("fuhu-quan", 140);
  set_skill("parry", 130);
  set_skill("lamaism", 140);
  set_skill("hand", 120);
  set_skill("dashou-yin", 150);
  set_skill("literate", 100);
  set_skill("blade", 150);
  set_skill("xuedao-daofa", 140);
  map_skill("force", "longxiang-gong");
  map_skill("dodge", "qingshen-fa");
  map_skill("cuff", "fuhu-quan");
  map_skill("parry", "xuedao-daofa");
  map_skill("hand", "dashou-yin");
  map_skill("blade", "xuedao-daofa");
  prepare_skill("hand", "dashou-yin");
  prepare_skill("cuff", "fuhu-quan");
  create_family("密宗", 11, "血刀门弟子");

  setup();
  carry_object("/clone/armor/yellow-cloth")->wear();
  carry_object("/clone/weapon/blade")->wield();
}
