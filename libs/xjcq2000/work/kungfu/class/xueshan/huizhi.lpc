// /kungfu/class/xueshan/huizhi  慧智大喇嘛
// by dubei

inherit NPC;
inherit F_MASTER;
string ask_me();
void create() {
  set_name("慧智大喇嘛", ({ "huizhi dalama", "huizhi" }));
  set("long", @LONG
他是密宗的慧智大喇嘛。身穿一件黄色袈裟，头带僧帽。
他负责掌管密宗的一些经书和药物。
LONG
  );
  set("gender", "男性");
  set("age", 35);
  set("attitude", "heroism");
  set("shen", -6500);
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);
  set("max_qi", 1500);
  set("max_jing", 2500);
  set("neili", 2000);
  set("max_neili", 2000);
  set("jiali", 100);
  set("combat_exp", 650000);
  set("eff_jingli", 1500);

  set_skill("lamaism", 100);
  set_skill("literate", 100);
  set_skill("force", 100);
  set_skill("longxiang-gong", 100);
  set_skill("dodge", 100);
  set_skill("qingshen-fa", 100);
  set_skill("cuff", 100);
  set_skill("fuhu-quan", 100);
  set_skill("parry", 100);
  set_skill("sword", 100);
  set_skill("mingwang-jian", 100);
  set_skill("staff", 100);


  map_skill("force", "longxiang-gong");
  map_skill("dodge", "qingshen-fa");
  map_skill("cuff", "fuhu-quan");
  map_skill("parry", "mingwang-jian");
  map_skill("sword", "mingwang-jian");
  prepare_skill("cuff", "fuhu-quan");
  create_family("密宗", 11, "弟子");
  set("class", "lama");
  set("inquiry", ([
    "藏红花": (: ask_me :),
  ]));
  set("dan_count", 18);
  setup();
  carry_object("/clone/armor/h-jiasha")->wear();

}

void attempt_apprentice(object ob) {
  mapping fam;

  string name, new_name;
  fam = ob->query("family");

  if (!fam || fam["family_name"] != "密宗") {
    command("say " + RANK_D->query_respect(ob) + "与本派素无来往，不知此话从何谈起？");
    return;
  }
  if ((int)ob->query_skill("longxiang-gong", 1) < 60 || (int)ob->query_skill("lamaism", 1) < 60) {
    command("say 我密宗派是以龙象般若功为基础,密宗心法为辅,你还差的远呢,回去多多修炼吧。");
    return;
  }

  if (fam["generation"] <= 11) {
    command("say 我密宗门规甚严,我怎麽能受你为徒呢！");
    return;
  }
  if ((string)ob->query("gender") != "男性") {
    command("say 修习密宗内功需要纯阳之体。");
    command("say 这位" + RANK_D->query_respect(ob) +
      "还是请回吧！");
    return;
  }


  if ((string)ob->query("class") != "lama") {
    command("say 我密宗的清规戒律甚多。");
    command("say 这位" + RANK_D->query_respect(ob) +
      "还是请回吧！");
    return;
  }

  command("smile");
  if (fam["generation"] != 12) {
    name = ob->query("name");
    new_name = "光" + name[2..3];
    ob->set("name", new_name);

    command("say 好吧,我就收你为徒,今后法名就叫做" + new_name + "！");

  }

  command("recruit " + ob->query("id"));

}
string ask_me() {
  mapping fam;
  object ob;

  if (!(fam = this_player()->query("family")) || fam["family_name"] != "密宗")
    return RANK_D->query_respect(this_player()) + "与密宗素无来往，不知此话从何谈起？";

  if ((int)this_player()->query_skill("longxiang-gong") < 30)
    return RANK_D->query_respect(this_player()) + "此药在经脉中需龙象般若功来运转药性，你龙象般若功火候还浅，以后再来找我吧，";

  if (present("zang honghua", this_player()))
    return RANK_D->query_respect(this_player()) + "此丹药配置不易，你身上尚有，不要太贪婪了!";

  if (query("dan_count") < 1) return "藏红花已经发散完了。";

  ob = new("/d/xueshan/obj/zanghonghua");

  ob->move(this_player());
  add("dan_count", -1);

  message_vision("$N获得一包藏红花。\n", this_player());
  return "好吧，此药为密宗圣药，非紧急关头切记不要轻易服用。";

}
