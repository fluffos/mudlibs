string chinese_number(int i) {
  return CHINESE_D->chinese_number(i);
}

string to_chinese(string str) {
  return CHINESE_D->chinese(str);
}

int is_chinese(string str) {
  // UTF8 FIX: str[i] on this driver returns the character's Unicode
  // codepoint, not a raw GBK byte -- this used to check the lead/trail
  // byte pair of a single GBK character (176-247/161-254, with a
  // reserved-codepoint exclusion for 215/>249). Checks the CJK Unified
  // Ideographs block (U+4E00-U+9FFF) instead.
  if (strlen(str) < 1) return 0;
  if (str[0] < 0x4e00 || str[0] > 0x9fff) return 0;
  return 1;
}
