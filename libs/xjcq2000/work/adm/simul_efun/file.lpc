// file.c

void cat(string file) {
  string content;

  // FIX: write(0) (a missing file) crashes deep in receive()/receive_message()
  // ("Bad argument 1 to receive(), Expected: string or buffer Got: 0"),
  // killing the whole connection with no player-visible message. Guard
  // against a missing/unreadable file instead of crashing on it.
  content = read_file(file);
  if (stringp(content))
    write(content);
}

void log_file(string file, string text) {
  // FIX: a missing log subdirectory (e.g. "nosave/") makes write_file()
  // throw, which otherwise aborts whatever caller invoked log_file() as
  // a bookkeeping side-effect (seen aborting do_quit() before me->save()
  // ran). A failed log write should never be allowed to abort real game
  // logic -- degrade gracefully instead.
  catch(write_file(LOG_DIR + file, text));
}

void assure_file(string file) {
  string path, *dir;
  int i;

  if (file_size(file) != -1) return;

  seteuid(ROOT_UID);
  dir = explode(file, "/");
  dir = dir[0..sizeof(dir) - 2];
  path = "/";
  for (i = 0; i < sizeof(dir); i++) {
    path += dir[i];
    mkdir(path);
    path += "/";
  }
}

string base_name(object ob) {
  string file;

  if (sscanf(file_name(ob), "%s#%*d", file) == 2)
    return file;
  else
    return file_name(ob);
}
