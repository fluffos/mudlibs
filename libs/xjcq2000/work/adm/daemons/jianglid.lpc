#include <ansi.h>
string name = "北京申办奥运成功";
string *list = ({
  "请您选择以下几种奖励方式",
  "经验值3000",
  "潜能值200",
  "黄金50两",
  "10000以内随机经验值",
  "1000以内随机潜能值",
  "300两以内随机黄金",
});
string now_jiangli() {
  return "北京申奥成功";
}
void give_gift(object me) {
  int i;
  write("为了庆祝" + name + "本MUD特此奖励。\n");
  for (i = 0; i < sizeof(list); i++)
    write(select_color() + i + ":" + list[i] + "。\n" + NOR);
  i = sizeof(list) - 1;
  write("请输入你的选择(1-" + i + "):");
  input_to("choose", me);
}
private void choose(string select, object me) {
  int i;
  switch (select) {
    case "1": me->add("combat_exp", 3000); break;
    case "2": me->add("potential", 200); break;
    case "3": me->add("balance", 50000); break;
    case "4": me->add("combat_exp", random(10000)); break;
    case "5": me->add("potential", random(1000)); break;
    case "6": me->add("balance", random(300) * 10000); break;
    default: give_gift(me);
    break;
  }
  sscanf(select, "%d", i);
  write("你已经获得了" + list[i] + "的奖励,请以后多多支持本mud.\n");
  me->set(now_jiangli(), 1);
  return;
}
