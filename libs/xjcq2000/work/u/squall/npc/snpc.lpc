#include <ansi.h>
inherit NPC;
void create() {
  set_name(HIM "看门机器狗" NOR, ({ "jiqi gou", "jiqi", "gou" }));
  set("title", HIY "半自动" NOR);
  set("gender", "无性");
  set("long",
    HIG "你摇了摇头,这种机器人也太原始了.\n" NOR);
  set("inquiry", ([
    "squall": "squall?这个笨蛋,把我做成这个样子.",
    "狂风": "狂风?这个笨蛋,把我做成这个样子.",
  ]));
  setup();
}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}
void greeting(object ob) {
  if ((string)ob->query("id") == "squall") {
    say("看门机器狗对着" + ob->query("name") + "使劲的摇着尾巴.\n");
    say("看门机器狗一个立正,对" + ob->query("name") + "说道:报告主人,一切正常.\n");
  }
  if ((string)ob->query("id") != "squall") {
    say("看门机器狗摇着尾巴：这位" + RANK_D->query_respect(ob) + "请进，热烈大欢迎。\n");
  }
}
