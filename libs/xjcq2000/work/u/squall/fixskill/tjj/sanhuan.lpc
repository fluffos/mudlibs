// kungfu\skill\taiji-jian
// sanhuan.c 三环套月
// create by jianxia 2000.12.15

#include <ansi.h>

inherit F_SSERVER;

int perform(object me, object target) {
  int lvl;
  object weapon;

  weapon = me->query_temp("weapon");
  lvl = (int)me->query_skill("taiji-jian", 1) / 4;
  if (!target)
    target = offensive_target(me);

  if (!target || !me->is_fighting(target))
    return notify_fail("三环套月只能在战斗中对对手使用。\n");

  if (!weapon || weapon->query("skill_type") != "sword"
    || me->query_skill_mapped("sword") != "taiji-jian")
    return notify_fail("你手里没有剑，无法使用三环套月！\n");

  if ((int)me->query_skill("taiji-jian", 1) < 130)
    return notify_fail("你的太极剑法不够娴熟，不能使用三环套月！\n");

  if ((int)me->query_skill("sword", 1) < 130)
    return notify_fail("你的基本剑法等级不够，不能使用三环套月！\n");

  if ((int)me->query_temp("tjj_sanhuan"))
    return notify_fail("你已经在运功中了。\n");

  if ((int)me->query_skill("yinyun-ziqi", 1) < 130)
    return notify_fail("你的氤氲紫气等级不够，不能使用三环套月！\n");

  if (me->query_skill_mapped("force") != "yinyun-ziqi")
    return notify_fail("你所使用的内功不对。\n");

  if ((int)me->query("max_neili") < 1500)
    return notify_fail("你的内力太弱，不能使用三环套月！\n");

  if ((int)me->query("neili") < 500)
    return notify_fail("你的内力太少了，无法使用出三环套月！\n");

  message_vision(HIG "\n$N长笑一声，使出全身力量，向$n奋力击出三剑。\n" NOR, me, target);
  me->add("neili", -400);

  me->add_temp("tjj_sanhuan", 1);
  me->add_temp("apply/strength", lvl / 4);
  me->add_temp("apply/dexerity", lvl / 4);
  me->add_temp("apply/dodge", lvl);
  me->add_temp("apply/attack", lvl);

  message_vision(HIG "\n$N使出「三环套月」，招式一变，左手抚剑把，右手托剑，剑尖青光闪动，以一个圆弧将手中剑向$n轻轻挑出！\n" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);

  message_vision(HIG "\n然后$N移进一步，右手左招，左手右招，同样一剑接着挥出，上下连续，不着一点停顿的痕迹！\n" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);

  message_vision(HIG "\n剑光紧接，$N手中剑又一次挥出急点$n右臂，这三剑剑势相联，剑气相叠，剑意相同，正合道家三清之属！\n" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);

  me->delete_temp("tjj_sanhuan");
  me->add_temp("apply/strength", -lvl / 4);
  me->add_temp("apply/dexerity", -lvl / 4);
  me->add_temp("apply/attack", -lvl);
  me->add_temp("apply/dodge", -lvl);

  me->start_busy(1 + random(3));
  return 1;
}
