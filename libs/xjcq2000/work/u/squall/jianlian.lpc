// jianlian.c
inherit F_SSERVER;
#include <ansi.h>
int perform(object me, object target) {
  string msg;
  if (!target) target = offensive_target(me);
  if (!target || !target->is_character()
    || !me->is_fighting(target) || !living(target))
    return notify_fail("「独孤九剑连」只能在战斗中使用。\n");
  if (!objectp(me->query_temp("weapon")))
    return notify_fail("没有武器不能使出「独孤九剑连」。\n");
  if ((int)me->query_skill("dugu-jiujian", 1) < 150 ||
    (int)me->query_skill("sword", 1) < 150)
    return notify_fail("你有的功夫还不够娴熟，不会使用「独孤九剑连」。\n");
  if (!me->query_skill("zixia-gong", 1))
    if (me->query_skill("zixia-gong", 1) < 150)
      return notify_fail("你的紫霞功还没练到家。\n");
  if (me->query_skill_mapped("force") != "zixia-gong")
    return notify_fail("你所使用的内功不对。\n");
  if (me->query_skill_mapped("sword") != "dugu-jiujian")
    return notify_fail("你现在无法使用「独孤九剑连」。");
  if (me->query_skill_mapped("parry") != "dugu-jiujian")
    return notify_fail("你所使用的招架不对。\n");
  if ((int)me->query("max_neili") < 2000)
    return notify_fail("你现在的内力修为不行！\n");
  if ((int)me->query("neili") < 600)
    return notify_fail("你的内力不够了！\n");
  msg = HIC "\n突然$N举剑乱舞，剑法更加杂乱无章，就如同小孩耍剑一般，每招都向$n的要害招呼。\n" + HIR "\n这便是独孤九剑绝杀「独孤九剑连」。\n" NOR;
  me->start_busy(2);
  target->start_busy(2);
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
  if (random(10) > 0) {
    call_out("perform2", 0, me, target);
    target->start_busy(2);
  } else {
    me->add("neili", -300);
    me->start_busy(4 + random(4));
    target->start_busy(0);
    msg = HIW "\n$n却越打越是心惊，不知道$N下一剑会打在自己什么地方，惊慌中地上一滚，躲过一剑，已经是满头大汗。\n" NOR;
    message_vision(msg, me, target);
    return 1;
  }
  me->add("neili", -200);
  return 1;
}
int perform2(object me, object target) {
  string msg;
  if (!me || !target) return 0;
  if (!living(target))
    return notify_fail("对手已经不能再战斗了。\n");
  if ((int)me->query("neili", 1) < 600)
    return notify_fail("你内力不够了！\n");
  msg = HIG "\n$N口中默念「反撩」，随手刺出第二剑。\n" NOR;
  me->start_busy(2);
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
  if (random(10) > 1) {
    call_out("perform3", 0, me, target);
    target->start_busy(2);
  } else {
    me->add("neili", -300);
    me->start_busy(2 + random(4));
    target->start_busy(0);
    msg = HIW "\n$n却越打越是心惊，不知道$N下一剑会打在自己什么地方，惊慌中地上一滚，躲过一剑，已经是满头大汗。\n" NOR;
    message_vision(msg, me, target);
    return 1;
  }
  me->add("neili", -200);
  return 1;
}
