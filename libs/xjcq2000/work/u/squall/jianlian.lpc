int perform8(object me, object target) {
  string msg;
  if (!me || !target) return 0;
  if (!living(target))
    return notify_fail("对手已经不能再战斗了。\n");
  if ((int)me->query("neili", 1) < 600)
    return notify_fail("你内力不够了！\n");
  msg = HIM "\n$N口中默念「平拉」，随手刺出第八剑。\n" NOR;
  me->start_busy(2);
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
  if (random(10) > 5) {
    call_out("perform9", 0, me, target);
    target->start_busy(2);
    CHANNEL_D->do_channel(
      this_object(),
      "rumor",
      me->short(1) + "成功的使完了独孤九剑之「" + HIR "独孤九剑连" + HIM "」。"
    );
  } else {
    me->add("neili", -300);
    me->start_busy(4 + random(4));
    target->start_busy(0);
    msg = HIW "\n$n却越打越是心惊，不知道$N下一剑会打在自己什么地方，惊慌中地上一滚，躲过一剑，已经是满头大汗。\n" NOR;
    message_vision(msg, me, target);
    return 1;
  }
  me->add("neili", -200);
  return 1;
}
int perform9(object me, object target) {
  string msg;
  if (!me || !target) return 0;
  if (!living(target))
    return notify_fail("对手已经不能再战斗了。\n");
  if ((int)me->query("neili", 1) < 600)
    return notify_fail("你内力不够了！\n");
  msg = HIC "\n$N剑招一变，一剑化为九剑分别刺向$n的头、双手、颈、腰、两腿、胸、眼九处。\n" NOR;
  me->start_busy(2);
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
  me->add("neili", -200);
  me->start_busy(4 + random(4));
  return 1;
}
