//Room: jianfang.c
//YZC 1995/12/04

#include <room.h>
inherit ROOM;

void create() {
  set("short", "兵器房");
  set("long", @LONG
“剑”并不重要，而是持剑人的修为，一个剑客的剑不应该在手上，
这是华山派的“武器库”剑房，华山弟子的佩剑都是从这里取用。
LONG
  );
  set("sword_count", 1);
  set("objects", ([
    "/d/hs/obj/zhujian": 2,
    "/d/hs/obj/changjian": 4,
  ]));

  set("exits", ([
    "west": "/d/hs/liangong",
  ]));
  setup();
}
void init() {
  add_action("do_na", ({ "qu", "na" }));
}
int do_na(string arg) {
  object sword, me;
  mapping fam;
  me = this_player();
  if (!arg || arg != "jian")
    return notify_fail("你要拿什麽？\n");
  if ((int)me->query_str() < 25)

    return notify_fail("你力气也太小了吧，怎么也拿不动宝剑。\n");
  if ((int)me->query("neili") < 2000)
    return notify_fail("你刚想拿下宝剑，只觉得内息一乱，连忙吸气调息。\n");
  if (!(fam = this_player()->query("family")) || fam["family_name"] != "华山派")
    return notify_fail("你不是华山弟子，不能动华山的东西。\n");
  if (random(10) != 6) {
    me->add("neili", -100);
    return notify_fail("你运起内力，想要拿下宝剑，可惜没有成功。\n");
  }
  　 　 　 　 　 　 message_vision("$N深吸了口气，潜运内力，一把抓住剑柄，把剑拿了下来。\n", me);
  me->add("neili", -500);
  me->set_temp("mark/sword", 1);
  sword = new("/u/squall/obj/qingfeng");
  if (!clonep(sword)) {
    message_vision("结果$N拿下来的是把竹剑，心里大叫倒霉，随手把竹剑丢在了地上。\n", me);
    return 1;
  }
  sword->move(me);
  return 1;
}
