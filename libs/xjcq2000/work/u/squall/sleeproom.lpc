#include <ansi.h>;
inherit ROOM;

void create() {
  set("short", HIY "卧室" NOR);
  set("long", @LONG
一间明亮宽敞的卧房。你进来后，首先看见的是一扇落地大窗户(window)，
站在窗户边远眺，你可以看见蔚蓝的大海，和远处美丽的小岛。一张非常舒
服的双人大床放在屋子中央，床头有这对新婚夫妇的婚纱照(photon)。
LONG
  );
  set("no_fight", 1);
  set("sleep_room", 1);
  set("exits", ([
    "east": "/u/squall/room",
    "west": "/u/halen/workroom",
  ]));
  set("item_desc", ([
    "window": "
:( (    ):::::   
(_,  * ) ,_)::                       |
:::-'--`--:::::::: ~~|     ,       * _ /
::::::::::::::::::: ,|`-._/|   -==  (_)  ==-
::::::::^^::::::::.' |   /||△     /   *
::::::^^::::::::.'   | ./ ||`△      |
:::::::::::::::/ `-. |/._ ||  △        
::::::::::::::|      ||   ||   △
 ~~=~_~^~ =~* ~~~~~~~'~~~~'~~~~/~~`` ~=~^~
~^^~~-=~^~ ^~ `--------------'~^~=~^~_~^=~^~
\n",
    "photon": "照片中的新郎新娘是" + HIC "Squall" + NOR "和" + HIY "Halen" + NOR "，新娘正靠在新郎的怀里，脸上露出幸福的笑容。\n",
  ]));

  setup();
}


int valid_leave(object me, string dir) {
  if (dir == "west" && !wizardp(me))
    return notify_fail(HIG "那是情花的卧室，乱闯不好吧。\n" NOR);
  return ::valid_leave(me, dir);
}
