// workroom.c
#include <ansi.h>
inherit ROOM;
void create() {
  set("short", HIG "会客厅" NOR);
  set("long", @LONG
这里是[1;36mSQUALL[0;37;0m会客的地方，里面摆设很讲究。几个玩家正坐在沙发上谈论着
昨天PK的过程，不时的哈哈大笑。正前有张办公用的写字桌，上面放了台[1;34m电脑[0;37;0m，
用来查阅玩家的资料。旁边有个[1;37m留言板[0;37;0m(board)，专门用来记录玩家的意见。
LONG
  );
  set("exits", ([
    "down": "/d/city/chmiao",
    "yzcc": "/d/city/guangchang",
    "up": "/d/wizard/wizard_room",
    "north": "/u/squall/room",
  ]));
  set("objects", ([
    "/u/squall/npc/snpc": 1,
    "/u/squall/bak/kuangfeng": 1,
  ]));
  set("no_fight", 1);
  setup();
  "/clone/board/squall_b"->foo();
}
int valid_leave(object me, string dir) {
  if (dir == "north" && !wizardp(me) || dir == "up" && !wizardp(me))
    return notify_fail("看门机器狗挡在你面前：别乱闯，私人地方。\n");
  return ::valid_leave(me, dir);
}
