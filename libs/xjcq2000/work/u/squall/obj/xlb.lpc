#include <ansi.h>
inherit ITEM;
void create() {
  set_name(HIW "小" HIR "禮" HIG "包" NOR, ({ "xiaolibao", "bao", "libao" }));
  set("long", HIY "這是一個不知道從什麽地方落下來的小禮包，快快收下吧！(可以用open xiaolibao打開)\n" NOR);
  set("unit", "個");
  set("weight", 1);
  set("no_drop", "這麽好的東西，你也想扔？？\n");
  set("no_get", "不是你的東西，你能要嗎？？？\n");
  set("no_give", "這麽重要的東西，你還是自己留著吧\n");
  set("no_steal", 1);
  setup();
}
void init() {
  add_action("do_open", "open");
}
int do_open(string arg) {
  object ob;
  ob = this_player();
  if (arg == "xiaolibao") {
    message_vision(HIM "$N打開禮包，哇！！！\n" NOR, ob);
    write(BLINK + HIG "\n你感覺增加了" HIW "5000EXP" HIG "," HIW "0GOLD" HIG "," HIW "8000POT" HIG "," HIW "100MAX_NEILI\n" NOR);
    ob->add("combat_exp", 5000);
    ob->add("potential", 8000);
    ob->add("max_neili", 100);
  } else {
    return 0;
  }
  destruct(this_object());
  return 1;
}
