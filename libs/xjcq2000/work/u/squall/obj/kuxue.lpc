#include <ansi.h>
#include <weapon.h>
inherit STICK;
void create() {
  set_name(HIW "酷雪棒" NOR, ({ "kuxue bang", "bang", "stick" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("long", "一根雪白晶莹的玉棒，让你爱不释手。\n");
    set("value", 1000);
    set("material", "bamboo");
    set("treasure", 1);
    set("unique", 1);
    set("weapon_prop/parry", 25);
    set("weapon_prop/dodge", 30);
    set("skill", ([
      "name": "stick",
      "exp_required": 50000,
      "difficulty": 25,
      "max_skill": 100,
    ]));
    set("wield_msg", HIW "只见白光闪烁，$N将一根雪白晶莹的玉棒握在手中。\n" NOR);
    set("unwield_msg", HIW "$N悄悄将玉棒藏在身后。\n" NOR);
  }
  init_stick(100);
  setup();
}
