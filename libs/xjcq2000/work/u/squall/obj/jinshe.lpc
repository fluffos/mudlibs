// jinshe
inherit ITEM;
#include <ansi.h>
void create() {
  set_name(HIY "金蛇秘籍" NOR, ({ "jinshe miji", "jinshe", "miji" }));
  set_weight(900);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long",
      HIY "这是一本金蛇郎君夏雪宜的武学秘籍，上面写满密密麻麻的小字。\n" NOR);
    set("value", 10000);
    set("unique", 1);
    set("material", "paper");
    set("no_drop", "这样东西不能离开你。\n");
    set("no_get", "这样东西不能离开那儿。\n");
    set("treasure", 1);
  }
}
void init() {
  add_action("do_lingwu", "lingwu");
}
int do_lingwu(string arg) {
  object me = this_player();
  object ob;
  mapping skill;
  int jlevel;
  int zlevel;
  int neili_lost;
  if (!(arg == "jianfa" || arg == "zhangfa"))
    return 0;
  if (arg == "jianfa") {
    if (me->is_busy()) {
      write("你现在正忙着呢。\n");
      return 1;
    }
    if (me->is_fighting()) {
      write("你很难在战斗中分心研读秘籍！\n");
      return 1;
    }
    if (me->query_skill("literate", 1) < 150) {
      write("以你现在的读书写字不能从这上面领悟到什么。\n");
      return 1;
    }
    if ((int)me->query_("str", 1) > 22) {
      write("你无法领悟金蛇剑法的要领。\n");
      return 1;
    }
    if ((int)me->query("jing") < 60) {
      write("你太疲倦了，无法研读武学秘籍。\n");
      return 1;
    }
    if (me->query_skill("sword", 1) < 150) {
      write("你的基础功没有打好，不能学习金蛇剑法。\n");
      return 1;
    }
    if ((int)me->query("neili") < neili_lost) {
      write("你内力不够，无法钻研这么高深的武功。\n");
      return 1;
    }
    if ((int)me->query("max_neili") < 2500) {
      write("你的内功修为不够。\n");
      return 1;
    }
    jlevel = me->query_skill("jinshe-jianfa", 1);
    if ((int)me->query("combat_exp") < (int)jlevel * jlevel * jlevel / 10) {
      write("你的实战经验不足，再怎么读也没用。\n");
      return 1;
    }
    if (me->query_skill("jinshe-jianfa", 1) >= 101) {
      write("你已经无法再从秘籍中学到什么，要想更高的修为必须自已练了。\n");
      return 1;
    }
    neili_lost = (int)(me->query_skill("jinshe-jianfa", 1) / 15);
    me->receive_damage("jing", 30);
    me->receive_damage("neili", 30);
    me->set("neili", (int)me->query("neili") - neili_lost);
    me->improve_skill("jinshe-jianfa", (int)me->query_skill("literate", 1) / 3 + 1);
    message("vision", me->name() + "拿着一本秘籍认真研读。\n", environment(me), me);
    write("你领悟《金蛇剑法》，颇有心得。\n");
    return 1;
  }
  if (arg == "zhangfa") {
    if (me->is_busy()) {
      write("你现在正忙着呢。\n");
      return 1;
    }
    if (me->is_fighting()) {
      write("你很难在战斗中领悟秘籍！\n");
      return 1;
    }
    if ((int)me->query_("str", 1) > 20) {
      write("你无法领悟金蛇掌法的要领。\n");
      return 1;
    }
    if (me->query_skill("literate", 1) < 150) {
      write("以你现在的读书写字不能从这上面领悟到什么。\n");
      return 1;
    }
    if ((int)me->query("jing") < 60) {
      write("你太疲倦了，无法研读武学秘籍。\n");
      return 1;
    }
    if (me->query_skill("strike", 1) < 150) {
      write("你的基础没有打好，不能研读金蛇秘籍。\n");
      return 1;
    }
    if ((int)me->query("neili") < neili_lost) {
      write("你内力不够，无法研读这么高深的武功。\n");
      return 1;
    }
    if ((int)me->query("max_neili") < 2500) {
      write("你的内功修为不够。\n");
      return 1;
    }
    zlevel = me->query_skill("jinshe-zhangfa", 1);
    if ((int)me->query("combat_exp") < (int)zlevel * zlevel * zlevel / 10) {
      write("你的实战经验不足，再怎么领悟也没用。\n");
      return 1;
    }
    if (me->query_skill("jinshe-zhangfa", 1) >= 101) {
      write("你已经无法再从秘籍中学到什么，要想更高的修为必须自已练了。\n");
      return 1;
    }
    neili_lost = (int)(me->query_skill("jinshe-zhangfa", 1) / 15);
    me->receive_damage("jing", 30);
    me->receive_damage("neili", 30);
    me->set("neili", (int)me->query("neili") - neili_lost);
    me->improve_skill("jinshe-zhangfa", (int)me->query_skill("literate", 1) / 3 + 1);
    message("vision", me->name() + "拿着一本秘籍认真研读。\n", environment(me), me);
    write("你钻研《金蛇游身掌》，颇有心得。\n");
    return 1;
  }
}
