//tianhong.c 
#include <ansi.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target) {
  string msg, msg1;
  int i;
  object weapon;
  if (!target) target = offensive_target(me);
  if (!target || !me->is_fighting(target))
    return notify_fail("「旭日天虹」只能在战斗中对对手使用。\n");
  weapon = me->query_temp("weapon");
  if (!weapon || weapon->query("skill_type") != "sword"
    || me->query_skill_mapped("sword") != "liujue-tianhongjian")
    return notify_fail("你必须使用在剑时才能使出「旭日天虹」！\n");

  if ((int)me->query_skill("liujue-tianhongjian", 1) < 80)
    return notify_fail("你的天虹剑法不够娴熟，不会使用「旭日天虹」。\n");

  if ((int)me->query_skill("beiming-shengong", 1) < 60)
    return notify_fail("你的北冥神功修为不够，不能使用「旭日天虹」。\n");

  if ((int)me->query_dex() < 30)
    return notify_fail("你的身法太低，不能使用「旭日天虹」。\n");

  if (me->query_skill_mapped("force") != "beiming-shengong")
    return notify_fail("你的内功等级不够，不能使用「旭日天虹」。\n");

  if ((int)me->query("neili", 1) < 400)
    return notify_fail("你现在内力太弱，不能使用「旭日天虹」。\n");
  if ((int)me->query("jingli", 1) < 200)
    return notify_fail("你现在精力太少，不能使用「旭日天虹」。\n");
  i = (me->query_skill("liujue-tianhongjian", 1) / 2);
  msg = HIY "$N用食指将剑身压弯，举过头顶，将全身内力灌注其中，剑身犹如雨后彩虹，又如旭日东升一般。突然，食指一送，剑身暴长，使出绝技「旭日天虹」。\n" NOR;
  msg1 = HIG "$N渐渐收回内力，手中剑光也渐渐暗淡下来。\n" NOR;
  me->add_temp("apply/strength", i);
  me->add_temp("apply/attack", i);
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
  me->add("neili", -200);
  me->start_busy(2);
  me->add_temp("apply/damage", 50);
  me->add_temp("apply/strength", -i);
  me->add_temp("apply/attack", -i);
  message_vision(msg1, me, target);
  return 1;
}
