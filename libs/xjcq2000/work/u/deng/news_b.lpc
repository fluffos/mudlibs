#include <ansi.h>
inherit BULLETIN_BOARD;

void create() {
  set_name(HIY "新闻留言簿" NOR, ({ "board" }));
  set("location", "/u/deng/workroom");
  set("board_id", "news_b");
  set("long", "这是一个专供发布新闻使用的留言板。\n");
  setup();
  set("capacity", 300);
  replace_program(BULLETIN_BOARD);
}
