// Room: /u/xdd/gumu/gmhout.c
//   dubei amend 98/8

#include <ansi.h>
#include <room.h>
inherit ROOM;

void create() {
  set("short", BLU "后堂" NOR);
  set("long", @LONG
堂上也是空荡荡的没什么摆设，只东西两壁都挂着一幅画。西首
(westpic)的画像是两个女郎，正是古墓派师尊林朝英和师祖婆婆的
肖像，东侧(eastpic)画像中却是一个道士。
LONG);

  set("exits", ([
    "east": __DIR__ "gmcc",
    "west": __DIR__ "gmzt",
    "north": __DIR__ "gmlg4",
    "south": __DIR__ "gmws",
  ]));

  set("item_desc", ([
    "westpic": "画中两个姑娘，一个二十五六岁，正在对镜
梳妆，画中镜里映出女郎容貌极美，秀眉入鬓，眼角却隐隐带着一层
杀气，真是古墓派师尊林朝英。另一个是十五六岁的丫鬟，手持面盆，
在旁伺候，憨态可掬，满脸稚气，后来便成了小龙女的师傅。\n",
    "eastpic": "像中道人身材甚高，腰悬长剑，右手食指指
着东北角，只是背脊向外，面貌却看不见。\n",
    "northeast": "东北角仍是一片石壁。看不出有何不同。\n",
  ]));
  create_door("south", "石门", "north", DOOR_CLOSED);
  setup();
}

void init() {
  add_action("do_search", "search");
  //     add_action("do_xian", "xian")
  // hva more good sword, close jzj svj
  add_action("do_ketou", "ketou");
  add_action("do_pull", "pull");
  add_action("do_tu", "tu");
  add_action("do_kan", "kan");
}

int do_search(string arg) {
  object me = this_player();

  if (!(arg || arg != "room")) return 0;

  if (me->query_temp("marks/search") == 2) {
    write("你为何还不行动呢？ \n");
    return 1;
  }

  message_vision(BLU "$N仔细地打量这间石室。\n" NOR, me);
  me->add_temp("marks/times", 1);

  if (me->query_temp("marks/times") <= 4) {
    message_vision(BLU "$N什么也没发觉。\n" NOR, me);
    return 1;
  } else
    message_vision(RED "$N似乎发现了什么。\n", me);
  write(RED "两幅画像有几分奇怪，不知后面藏了什么。你不由想掀开(xian)看看。\n" NOR);
  me->set_temp("marks/search", 2);
  me->delete_temp("marks/times");
  return 1;
}

int do_xian(string arg) {
  object me;
  me = this_player();

  if (me->query_temp("marks/search") != 2)
    return notify_fail("你要干什么？\n");

  if (arg == "westpic") {
    message_vision(HIY "$N掀起西首的画像。\n" NOR, me);
    message_vision(BLU "突然几点寒光由画像后的石壁中点射而出,直扑$N周身要穴。\n" NOR, me);

    if ((int)me->query_skill("yunu-shenfa", 1) <= 80) {
      message_vision(BLU "$N手足无措，闪乎间胸腹同时一麻，眼前顿时金星闪烁。\n" NOR, me);
      me->unconcious();
      return 1;
    }

    message_vision("$N心中灵光闪现，只瞬乎间已本能用玉女身法堪堪避过。\n", me);
    write("你心神稍定，开始凝视(kan westshibi)画后的石壁，只见壁上刻着几行字。\n");
    me->set_temp("marks/wpic", 2);
    remove_call_out("close");
    call_out("close", 15, me);
  }

  if (arg == "eastpic" && !me->query_temp("marks/epic")) {
    message_vision("$N轻轻掀起东首的画像。\n", me);

    if (me->query_skill("dodge") < 150) {
      message_vision("突然$N脚下石地一方下陷，$N不及惊呼，已掉下陷阱。\n", me);
      me->set_temp("last_damage_from", "掉进陷阱");
      me->move(__DIR__ "gmmshi1");
      me->die();
      return 1;
    }

    message_vision("$N脚下石地突然下陷，千钧一发际$N已腾身扬起，双足互点，避开下坠陷阱之险. \n", me);
    me->set_temp("marks/epic", 2);
    remove_call_out("close");
    call_out("close", 15, me);
  }
  return 1;
}

int do_kan(string arg) {
  object me;
  me = this_player();

  if ((me->query_temp("marks/wpic") != 2) || (me->query_temp("marks/epic") != 2))
    return 0;

  if (arg == "westshibi")
    write(BLU "入我古墓，先唾重阳，欲成神功，拜我祖师. \n" NOR);

  if (arg == "eastshibi") {
    if (query_temp("marks/sword") < 2)
      write(BLU "画像后的石壁中露出两把剑柄，黑漆漆的，剑刃似已全然没入石中。\n" NOR);
    if (query_temp("marks/sword") == 2)
      write(BLU "画像后的石壁中只露出一把剑柄，黑漆漆的，剑刃似已全然没入石中。\n" NOR);
    if (query_temp("marks/sword") > 2)
      write(BLU "石壁上只两个深深的窄洞。\n" NOR);
  }
  return 1;
}

void close(object me) {
  if (!me) return;
  tell_object(me, "画像回复原位，遮住了石壁所在. \n");
  me->delete_temp("marks/wpic");
  me->delete_temp("marks/etpic");
}

int do_ketou(string arg) {
  mapping fam;
  object me = this_player();

  if ((!arg) || (arg != "westpic")) return 0;
  if ((fam = this_player()->query("family")) && fam["family_name"] == "古墓派") {
    message_vision("$N双膝及地，恭恭敬敬向祖师婆婆的画像磕了一个头. \n", me);
    return 1;
  }


  if (me->query_temp("mark/tu") && me->query_temp("mark/gketou")
    && ((int)me->query("combat_exp", 1) < 10000 || !(fam = this_player()->query("family"))))  //&& (int)me->query("combat_exp",1)<10000 && fam["family_name"] != "古墓派")
  {
    me->set("family_name", "古墓派");
    me->set("title", BLU "古墓传人" NOR);
    me->create_family("古墓派", 3, "传人");
    me->delete_temp("mark/gketou");
    me->delete_temp("mark/tu");
    write(RED "恭喜你自愿成为一名古墓弟子。\n" NOR);
    return 1;
  }
  message_vision("$N向西跪倒，双膝及地，恭恭敬敬向祖师婆婆的画像磕了一个响头. \n", me);
  me->set_temp("mark/gketou", 1);
  return 1;
}

int do_tu(string arg) {
  object me = this_player();
  if ((!arg) || (arg != "eastpic")) return 0;
  if (!me->query_temp("mark/gketou"))
    return 0;
  message_vision("$N朝王重阳的画像狠狠唾了一口. \n", me);
  me->set_temp("mark/tu", 1);
  return 1;
}

int do_pull(string arg) {
  int n;
  object ob;
  n = this_player()->query("neili");

  if (this_player()->query_temp("marks/epic") != 2)
    return notify_fail("你要干什么？\n");

  if ((!arg) || (arg != "sword"))
    return notify_fail("你要拔什么？\n");

  if (query_temp("marks/sword") > 3)
    return notify_fail("你来晚一步，神兵利器已入他人之手. \n");

  if (query_temp("marks/sword") < 2) {
    message_vision("$N握住剑柄，用力向外拔. \n", this_player());

    if (n <= 300) {
      message_vision("$N的脸涨成猪肝颜色，双剑丝毫未动", this_player());
      this_player()->set("neili", 0);
      return 1;
    }
    message_vision(BLU "$N发力怒斥一声，剑柄徐徐后移，露出黑黑的剑刃,$N一加力长剑已然入手，满屋寒气顿盛. \n" NOR, this_player());
    ob = new("/clone/weapon/jzj");
    ob->move(this_player());
    set_temp("marks/sword", 2);
    this_player()->set("neili", n - 300);
    return 1;
  }

  if (query_temp("marks/sword") == 2) {
    message_vision("$N握住剑柄，用力向外拔. \n", this_player());
    if (n <= 300) {
      message_vision("$N的脸涨成猪肝颜色，双剑丝毫未动", this_player());
      this_player()->set("neili", 0);
      return 1;
    }
    message_vision(BLU "$N发力怒斥一声，剑柄徐徐后移，露出黑黑的剑刃,$N一加力长剑已然入手，满屋寒气顿盛. \n" NOR, this_player());
    ob = new("/clone/weapon/snj");
    ob->move(this_player());
    set_temp("marks/sword", 4);
  }
  return 1;
}
