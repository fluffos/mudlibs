#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "漫长的旅途");
  set("long", @LONG
这是通向未来的漫长的旅途。
LONG);
  set("no_fight", 1);
  set("no_get_from", 1);
  set("no_sleep_room", 1);
  set("no_death", 1);
  setup();
}

void init() {
  object me = this_player();
  call_out("wait", 2, me);
  add_action("do_action", "");
}

int do_action(string arg) {
  string action = query_verb();
  switch (action) {
    case "dazuo":
    case "l":
    case "exercise":
    case "lian":
    case "tuna":
    case "quit":
    case "save":
    case "practice":
      write("你身处滚滚轮回之中，怎能如此？\n");
      return 1;
  }
  return 0;
}
void wait() {
  string arg;
  object me;
  me = this_player();
  arg = me->query_temp("dest");
  tell_object(me, HBRED "你在滚滚轮回中不停前进，不知不觉中已停了下来。\n" NOR);
  if (arg == "kunlun") {
    me->move("/d/kunlun/sanshengtang");
    tell_object(me, CYN "你不觉中已到了昆仑派。\n\n" NOR);
  }
  if (arg == "mingjiao") {
    me->move("/d/mingjiao/gmd");
    tell_object(me, CYN "你不觉中已到了明教。\n\n" NOR);
  }
  if (arg == "gaibang") {
    me->move("/u/explorer/gb/fenduo1");
    tell_object(me, CYN "你不觉中已到了丐帮。\n\n" NOR);
  }

  if (arg == "wudang") {
    me->move("/d/wudang/sanqingdian");
    tell_object(me, CYN "你不觉中已到了武当派。\n\n" NOR);
  }
  if (arg == "tiezhang") {
    me->move("/d/tiezhang/wztang");
    tell_object(me, CYN "你不觉中已到了铁掌帮。\n\n" NOR);
  }
  if (arg == "taohua") {
    me->move("u/jpei/guiyun/qianting");
    tell_object(me, CYN "你不觉中已到了桃花岛。\n\n" NOR);
  }
  if (arg == "huashan") {
    me->move("/d/hs/zhengqi");
    tell_object(me, CYN "你不觉中已到了华山派。\n\n" NOR);
  }
  if (arg == "songshan") {
    me->move("/d/songshan/chanyuan");
    tell_object(me, CYN "你不觉中已到了嵩山派。\n\n" NOR);
  }
  if (arg == "shaolin") {
    me->move("/d/shaolin/guangchang1");
    tell_object(me, CYN "你不觉中已到了少林寺。\n\n" NOR);
  }
  if (arg == "mizong") {
    me->move("/d/xueshan/dadian");
    tell_object(me, CYN "你不觉中已到了密宗派。\n\n" NOR);
  }
  if (arg == "gumu") {
    me->move("/d/gumu/rukou");
    tell_object(me, CYN "你不觉中已到了古墓派。\n\n" NOR);
  }
  if (arg == "xiaoyao") {
    me->move("/d/xiaoyao/qingcaop");
    tell_object(me, CYN "你不觉中已到了逍遥派。\n\n" NOR);
  }
  if (arg == "lingjiu") {
    me->move("/d/lingjiu/dating");
    tell_object(me, CYN "你不觉中已到了灵鹫宫。\n\n" NOR);
  }
  if (arg == "baituo") {
    me->move("/d/baituo/dating");
    tell_object(me, CYN "你不觉中已到了白驼。\n\n" NOR);
  }
  if (arg == "tls") {
    me->move("/d/dali/shanhou");
    tell_object(me, CYN "你不觉中已到了大理城。\n\n" NOR);
  }
  if (arg == "shenlong") {
    me->move("/d/shenlong/zoulang");
    tell_object(me, CYN "你不觉中已到了神龙教。\n\n" NOR);
  }
  if (arg == "quanzhen") {
    me->move("/d/quanzhen/datang1");
    tell_object(me, CYN "你不觉中已到了全真。\n\n" NOR);
  }
  if (arg == "mr") {
    me->move("/d/mr/xiaodao");
    tell_object(me, CYN "你不觉中已到了慕容家。\n\n" NOR);
  }
  if (arg == "hh") {
    me->move("/d/huanhua/dating");
    tell_object(me, CYN "你不觉中已到了浣花剑派。\n\n" NOR);
  }
  if (arg == "emei") {
    me->move("/d/emei/qingyinge");
    tell_object(me, CYN "你不觉中已到了清音阁。\n\n" NOR);
  }
  if (arg == "shashou") {
    me->move("/d/shashou/yilou");
    tell_object(me, CYN "你不觉中已到了杀手楼。\n\n" NOR);
  }

  if (arg == "tiandi") {
    me->move("/d/city2/dating");
    tell_object(me, CYN "你不觉中已到了天地会总舵。\n\n" NOR);
  }
  if (arg == "xx") {
    me->move("/d/xingxiu/xxh2");
    tell_object(me, CYN "你不觉中已到了星宿。\n\n" NOR);
  }
  if (arg == "rysj") {
    me->move("/d/heimuya/chengdedian");
    tell_object(me, CYN "你不觉中已到了日月神教。\n\n" NOR);
  }
  if (arg == "hh") {
    me->move("/d/huanhua/dating");
    tell_object(me, CYN "你不觉中已到了浣花剑派。\n\n" NOR);
  }
  if (arg == "tm") {
    me->move("/d/tangmen/duanmuting");
    tell_object(me, CYN "你不觉中已到了四川唐门。\n\n" NOR);
  }
  if (arg == "wudu") {
    me->move("/d/wudujiao/lianwu");
    tell_object(me, CYN "你不觉中已到了五毒教。\n\n" NOR);
  }


  if (arg == "shenlong") {
    me->move("/d/shenlong/kongdi");
    tell_object(me, CYN "你不觉中已到了神龙教。\n\n" NOR);
  }
  tell_room(environment(me), me->name() + "一脸迷惘的飞了过来。\n" NOR,
    ({ me }));
  tell_object(me, HBRED "开始江湖之旅吧。\n" NOR);
  me->delete_temp("dest");
}
