// yuebing 月饼


inherit ITEM;
#include <ansi.h>
void create() {
  set_name(RED "奖励" NOR, ({ "hongbao", "gift" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是给找出bug的player的礼物，你可以open.。\n");
    set("unit", "只");
    set("no_get", 1);
    set("no_give", 1);
    set("no_drop", 1);

  }
}
void init() {
  add_action("do_open", "open");
}
int do_open() {
  object me;
  me = this_player();
  message_vision("$N用着颤抖的双手缓缓地打开了红包。\n", me);
  me->add("potential", 5000);
  tell_object(me, "你被补偿了5000潜能,请记住以后不要多存潜能,以免发生不便。\n");
  tell_object(me, "以后,pot quit后不能超上线,请玩家注意。\n");
  destruct(this_object());
  return 1;
}
