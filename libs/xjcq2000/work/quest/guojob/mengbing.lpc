#include <ansi.h>;
#include <command.h>;
inherit "/d/city/job/npcskill";
int accountpkerexp(int turn, object who);
int pkerf(int turn, object who);
int pkerm(int turn, object who);
int set_pker_qi_jing(int turn, object pker);
int accountlevel(int turn, object who);
int do_copy(object me, int flag);
int do_back(object me);
mapping userskills;

void create() {
  int pkerlevel;
  object who = this_player();
  object pkerob;
  int turn = 5;
  pkerlevel = accountlevel(turn, who);
  pkerob = this_object();

  set_name("蒙古大汉", ({ "menggu dahan", "dahan" }));
  set("gender", "男性");
  set("age", 30);
  set("long", "他是蒙古大汉手下的高手。\n");
  set("per", 10);
  pkerob->set("max_neili", pkerf(turn, who));
  pkerob->set("neili", (int)(pkerf(turn, who) * 6 / 5));
  pkerob->set("jiali", (int)(pkerf(turn, who) / 800));
  pkerob->set("max_jingli", pkerm(turn, who) * 3);
  pkerob->set("jingli", (int)(pkerm(turn, who) * 3));
  pkerob->set("combat_exp", accountpkerexp(turn, who));
  pkerob->set("neili_factor", (int)(pkerlevel / 2));
  pkerob->set("jingli_factor", (int)(pkerlevel / 2));
  set_pker_qi_jing(turn, pkerob);
  pkerob->setpkerskill(pkerlevel, pkerob);
  setup();
  //      carry_object("/clone/weapon/changjian")->wield();
  carry_object("/clone/misc/cloth")->wear();
}
int do_copy(object me, int flag) {
  object ob;
  ob = this_object();
  call_out("do_back", 350, ob);
  return 1;
}
int do_back(object me) {
  tell_room(environment(me), me->query("name") + "匆匆忙忙的离开了。\n", ({ me }));
  destruct(me);
  return 1;
}
int accountlevel(int turn, object who) {
  int level;
  level = who->query_skill("force") * 2 / 3;
  level = (int)level;
  return level;
}

int accountpkerexp(int turn, object who) {
  int userexp, pkerexp;
  userexp = who->query("combat_exp") * 14 / 10;
  pkerexp = userexp;
  return pkerexp;
}

int pkerf(int turn, object who) {
  int userneili, pkerneili;
  userneili = who->query("max_neili");
  pkerneili = userneili * 4 / 3;
  return pkerneili;
}

int pkerm(int turn, object who) {
  int userjingli, pkerjingli;
  userjingli = who->query("max_jingli");
  pkerjingli = userjingli * (70 + turn * 5) / 80;
  return pkerjingli;
}

int set_pker_qi_jing(int turn, object pker) {
  int maxqi, maxjing;
  maxqi = 200 + (int)pker->query("max_neili") * 100 / 200;
  maxjing = 200 + (int)pker->query("max_jingli") * 100 * 4 / 1000;
  pker->set_temp("maxqi", maxqi);
  pker->set("max_qi", maxqi);
  pker->set("eff_qi", maxqi);
  pker->set("qi", maxqi);
  pker->set("max_jing", maxjing);
  pker->set("eff_jing", maxjing);
  pker->set("jing", maxjing);
  return 1;
}


int setpkerskill(int level, object pkerob) {
  set_std_skills(level, pkerob);
  switch (random(8)) {
    case 0: set_wudang_pker(level, pkerob); break;
    case 1: set_shaolin_pker(level, pkerob); break;
    case 2: set_huashan_pker(level, pkerob); break;
    case 3: set_quanzhen_pker(level, pkerob); break;
    case 4: set_xiaoyao_pker(level, pkerob); break;
    case 5: set_gaibang_pker(level, pkerob); break;
    case 6: set_xuedao_pker(level, pkerob); break;
    case 7: set_baituo_pker(level, pkerob); break;
    case 8: set_mingjiao_pker(level, pkerob); break;
    case 9: set_xingxiu_pker(level, pkerob); break;
    case 10: set_taohua_pker(level, pkerob); break;
    case 11: set_baituo_pker(level, pkerob); break;
  }
}

void die() {
  object corpse;
  mixed killer;
  if (!living(this_object())) revive(1);
  else delete_temp("faint_by");
  COMBAT_D->announce(this_object(), "dead");
  if (!(killer = query_temp("last_damage_from")))
    killer = "莫名其妙地";
  if (objectp(corpse = CHAR_D->make_corpse(this_object(), killer)))
    corpse->move(environment());
  set_temp("last_damage_from", "莫名其妙地");
  corpse->set_temp("must_killby", this_object()->query_temp("must_killby"));
  this_object()->remove_all_killer();
  all_inventory(environment())->remove_killer(this_object());
  destruct(this_object());
}
