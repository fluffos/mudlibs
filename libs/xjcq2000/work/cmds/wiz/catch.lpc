#include <ansi.h>
inherit F_CLEAN_UP;
inherit F_DBASE;

void auto_post(string title, string arg);

void create() {
  seteuid(getuid());
  set("channel_id", "系统(sys)");
}
int main(object me, string arg) {
  object ob;
  int day;
  string who, why;
  if (!arg) return notify_fail("<格式>: catch <玩家> <天数> because <原因>.\n");

  if (sscanf(arg, "%s %d because %s", who, day, why) != 3)
    return notify_fail("<格式>: catch <玩家> <天数> because <原因>.\n");

  if (day < 1 || day > 10000)
    return notify_fail("catch player must up to 1~10000 day.\n");

  ob = LOGIN_D->find_body(who);

  if (!ob) return notify_fail("No suck player online now ...\n");

  // moving

  if (wizardp(ob))
    return notify_fail("大家一起工作，别这么黑啊！！\n");

  tell_object(ob, RED "\n\n一阵大风刮来, 你眼前一阵黑....\n\n" NOR);

  ob->set("block/time", time() + day * 60 * 60 * 24);

  ob->move("/u/zee/thy");

  tell_object(me, "你把" + (string)ob->query("name") + "关进了桃花源.\n");
  tell_object(ob, YEL "\n.... 醒来时发现是" + (string)me->query("name") +
    "把你关进了桃花源.\n\n" NOR);

  log_file("catch", sprintf("%s catch %s(%s) on %s because %s for %d day\n", (string)me->query("id"),
    (string)ob->query("name"), (string)ob->query("id"), ctime(time()),
    why, day));

  if (!wizardp(ob))
    CHANNEL_D->do_channel(this_object(), "chuanwen", ob->query("name") + "因为" + why + "被关进了桃花源。");
  write("ok!\n");
  return 1;
}

void auto_post(string title, string body) {
  mapping note;
  object POSTER;
  if (objectp(POSTER = load_object("/clone/board/wiz_b"))) {
    note = ([]);
    note["title"] = title; ;
    note["author"] = sprintf("%s(%s)", this_player()->query("name"), this_player()->query("id"));
    note["time"] = time();
    POSTER->done_post(this_player(), note, body);
  }
  return;
}

int help(object me) {
  write(@HELP
指令格式 : catch <某人> <天数> because <原因>
此指令可让你(你)将某人关到桃花源.
HELP
  );
  return 1;
}
