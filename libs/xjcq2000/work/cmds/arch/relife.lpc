#include <ansi.h>

inherit F_CLEAN_UP;


int main(object me, string arg) {
  string name, reason;
  string status;


  status = wizhood(me);

  if (me != this_player(1) || wiz_level(me) < wiz_level(status))
    return notify_fail("你没有权力使用这个指令。\n");

  if (!arg) return notify_fail("没有这个用户！\n");

  if (sscanf(arg, "%s because %s", name, reason) != 2)
    return notify_fail("relife <id> because <xxx>。\n");

  seteuid(getuid());

  if (file_size(DATA_DIR + "login/" + name[0..0] + "/" + name + ".ooo") < 0)
    return notify_fail("没有这位使用者。\n");

  if (file_size(DATA_DIR + "login/" + name[0..0] + "/" + name + ".o") > 0)
    return notify_fail("这个ID已经被重新注册了。\n");

  rename(
    DATA_DIR + "login/" + name[0..0] + "/" + name + ".ooo",
    DATA_DIR + "login/" + name[0..0] + "/" + name + ".o"
  );
  rename(
    DATA_DIR + "user/" + name[0..0] + "/" + name + ".ooo",
    DATA_DIR + "user/" + name[0..0] + "/" + name + ".o"
  );

  shout(HIW "〖系统通知〗使用者 " + capitalize(name) + " 的档案恢复了。\n" NOR);
  write(HIW "〖系统通知〗使用者 " + capitalize(name) + " 的档案恢复了。\n" NOR);
  log_file("relife", sprintf("[%s] %s relife %s because %s.\n",
    ctime(time())[0..15], geteuid(this_player(1)), name, reason));

  return 1;
}

int help(object me) {
  write(@HELP
指令格式：relife <使用者姓名> because <原因>

HELP
  );
  return 1;
}
