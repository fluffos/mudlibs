// shout.c by benlong
#include <ansi.h>
inherit F_CLEAN_UP;
int main(object me, string arg) {
  if (!wizardp(me)) {
    if ((int)me->query("max_neili") < 4000)
      return notify_fail("以你現在的內力還不能 shout。\n");
    if (!arg) return 0;
    if ((int)me->query_temp("xiao"))
      return 0;
    if ((int)me->query("neili") < 4000) return notify_fail("内力不够\n");
    shout(HIW + me->name(1) + "(" + me->query("id") + ")" + "纵声长啸：「" + arg + "」\n" NOR);
    write(HIW + "你纵声长啸： 「" + arg + "」 \n" NOR);
    me->add("neili", -2000);
    me->set_temp("xiao", 1);
    call_out("remove_effect", random(200), me);
  } else {
    shout(HIW + me->name(1) + "(" + me->query("id") + ")" + "纵声长啸：「" + arg + "」\n" NOR);
    write(HIW + "你纵声长啸： 「" + arg + " 」 \n" NOR);
  }
  return 1;
}
void remove_effect(object me) {
  me->delete_temp("xiao");
  tell_object(me, HIY "\n你又可以纵声长啸了。\n" NOR);
}
int help(object me) {
  write(@HELP
指令格式 : shout <讯息>

这个指令让你将 <讯息> 传送出去, 所有正在游戏中的人都
会听见你的话.

see also : tune
HELP
  );
  return 1;
}
