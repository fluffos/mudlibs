inherit F_CLEAN_UP;

//ppp 2000,12

int main(object me, string arg)

{
  object target, ob;
  me = this_player();
  if (!arg) return notify_fail("你要切什么？\n");
  target = present(arg, environment(me));
  if (!target) return notify_fail("找不到这个东西。\n");
  if (!target->is_corpse()) return notify_fail("看清楚点，那不是尸体。\n");
  if (target->query("no_head")) return notify_fail("那具尸体已经没有首级。\n");
  if (!target->is_character()) return notify_fail("那具尸体已经腐烂。\n");
  message_vision("$N从怀中掏出匕首，对准$n的脖子处猛地斩了下去！\n", me, target);
  ob = new("/clone/misc/head");
  ob->set_name(target->query("victim_name") + "的首级", ({ "head" }));
  ob->set("long", "这是一颗" + target->query("victim_name") + "的首级。\n");
  if (target->query("victim_user"))
    ob->set("victim_user", 1);
  if (target->query("kill_by"))
    ob->set("kill_by", target->query("kill_by"));
  target->delete("kill_by");
  message_vision("$N将$n斩了下来，提在手中。\n", me, ob);
  ob->move(me);
  target->set("name", "无头尸体");
  target->set("no_head", 1);
  target->set("long", "一具无头尸体，腐臭四溢，情状可怖。\n");
  return 1;
}
int help(object me) {
  write(@HELP
指令格式: qie (corpse)
 
可以斩尸体的首级。
 
HELP
  );
}
