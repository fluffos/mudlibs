// shout.c by benlong
#include <ansi.h>
inherit F_CLEAN_UP;
int main(object me, string arg) {
  if (!wizardp(me)) {
    if ((int)me->query_temp("shout"))
      return notify_fail("你刚刚长啸完毕，还是休息一会吧，别累到 。\n");
    if ((int)me->query("max_neili") < 4000)
      return notify_fail("以你現在的內力還不能 shout。\n");
    if (!arg) return 0;
    if ((int)me->query("neili") < 4000) return notify_fail("内力不够\n");
    shout(HIW + me->name(1) + "(" + me->query("id") + ")" + "纵声长啸：" + arg + NOR + "\n");
    write(HIW + "你纵声长啸： " + arg + NOR + " \n");
    me->add("neili", -4000);
    me->set_temp("shout", 1);
    me->start_call_out((: call_other, __FILE__, "remove_shout", me, 180 :), 180);
    //  me->start_busy(10);
  } else {
    shout(HIW + me->name(1) + "(" + me->query("id") + ")" + "纵声长啸：" + arg + NOR + "\n");
    write(HIW + "你纵声长啸： " + arg + NOR + " \n");
  }
  return 1;
}
int help(object me) {
  write(@HELP
指令格式 : shout <讯息>

这个指令让你将 <讯息> 传送出去, 所有正在游戏中的人都
会听见你的话.

see also : tune
HELP
  );
  return 1;
}
void remove_shout(object me, int amount) {
  me->delete_temp("shout");
  tell_object(me, "你经过一段时间的休息，又可以长啸了。\n");
}
