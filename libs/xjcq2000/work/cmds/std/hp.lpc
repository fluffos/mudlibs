// hp cmds (Mon  10-02-2001)
#include <ansi.h>
inherit F_CLEAN_UP;
string status_color(int current, int max);
int main(object me, string arg) {
  object ob;
  int lmt, i = 0;
  mapping my;
  seteuid(getuid(me));
  if (!arg)
    ob = me;
  else
    ob = present(arg, environment(me));
  if (wizardp(me)) {
    if (!ob) ob = LOGIN_D->find_body(arg);
    if (!ob) ob = find_living(arg);
    if (!ob) return notify_fail("你要察看谁的状态？\n");
    if (wiz_level(me) < wiz_level(ob))
      return notify_fail("你比他等级高吗，查他，是不是想降级啊？\n");
  } else if (ob != me)
    return notify_fail("你是巫师吗，别做梦了。\n");
  if (ob->is_corpse() || !ob->is_character())
    return notify_fail("你有毛病啊，那是活的吗？\n");
  my = ob->query_entire_dbase();
  if (userp(ob)) {
    lmt = my["combat_exp"];
    for (; i * i * i / 10 <= lmt; i++);
    my["max_pot"] = i + 100;
  }
  write(sprintf(" ·精血· %s%5d / %5d %s(%3d%%)" NOR "\t·精力· %s%5d / %5d %s(%3d%%)\n" NOR,
    status_color(my["jing"], my["eff_jing"]), my["jing"], my["eff_jing"],
    status_color(my["eff_jing"], my["max_jing"]), my["eff_jing"] * 100 / my["max_jing"],
    status_color(my["jingli"], my["eff_jingli"]), my["jingli"], my["eff_jingli"],
    status_color(my["jingli"], my["eff_jingli"]), my["jingli"] * 100 / my["eff_jingli"]));
  write(sprintf(" ·气血· %s%5d / %5d %s(%3d%%)" NOR "\t·内力· %s%5d / %5d (+%d)\n" NOR,
    status_color(my["qi"], my["eff_qi"]), my["qi"], my["eff_qi"],
    status_color(my["eff_qi"], my["max_qi"]), my["eff_qi"] * 100 / my["max_qi"],
    status_color(my["neili"], my["max_neili"]), my["neili"], my["max_neili"],
    my["jiali"]));
  write(sprintf(" %s %s%5d      " NOR "       ·内力上限· %s%5d / %5d\n" NOR,
    my["shen"] < 0 ? "·戾气·" : "·正气·", HIC,
    (my["shen"] < 0 ? -1 : 1) * my["shen"],
    HIC,
    ob->query_skill("force") * 8 + my["combat_exp"] / 1000,
    ob->query_skill("force") * 10 + my["age"] * 20 + my["combat_exp"] / 1000));
  write(sprintf(" ·食物· %s%3d.%s%3d%%      " NOR "\t·潜能· %s%5d / %3d\n" NOR,
    status_color(my["food"], ob->max_food_capacity()),
    //                my["food"], ob->max_food_capacity(),
    my["food"] * 100 / ob->max_food_capacity(),
    status_color(my["food"], ob->max_food_capacity()),
    my["food"] * 100 / ob->max_food_capacity() - 10,
    HIY, (int)ob->query("potential"),
    (int)ob->query("max_pot")));
  write(sprintf(" ·饮水· %s%3d.%s%3d%%     " NOR "\t\t·经验· %s%d\n" NOR,
    status_color(my["water"], ob->max_water_capacity()),
    //                my["water"], ob->max_water_capacity(),
    my["water"] * 100 / ob->max_water_capacity(),
    status_color(my["water"], ob->max_water_capacity()),
    my["water"] * 100 / ob->max_water_capacity() - 10,
    HIM, my["combat_exp"]));
  return 1;
}
string status_color(int current, int max) {
  int percent;
  if (max > 0) percent = current * 100 / max;
  else percent = 100;
  if (percent > 100) return HIC;
  if (percent >= 90) return HIG;
  if (percent >= 60) return HIY;
  if (percent >= 30) return YEL;
  if (percent >= 10) return HIR;
  return RED;
}
int help(object me) {
  write(@HELP
指令格式 : hp
           hp <对象名称>                   (巫师专用)
这个指令可以显示你(你)或指定对象(含怪物)的精, 气, 神数值。
see also : score
HELP
  );
  return 1;
}
