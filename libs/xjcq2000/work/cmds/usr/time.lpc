// time.c

inherit F_CLEAN_UP;

int main(object me, string arg) {
  int t = (time() - me->query_temp("time")) / 60;
  write("现在是" + CHINESE_D->chinese_date(time()) + "。\n");
  write("您这次已经连续玩了" + chinese_number(t / 60) + "小时" + chinese_number(t % 60) + "分钟。\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式: time

这个指令让你(你)知道现在的时辰。

HELP
  );
  return 1;
}
