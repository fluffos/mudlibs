//by mudgod@xssx
#include <ansi.h>
#include <mudlib.h>
inherit F_CLEAN_UP;

int level(mixed, mixed);
string wiz_rank(string hood);

string times(int t) {
  int y, n, d, h, m, s;
  string time;

  s = t % 60; t /= 60;
  m = t % 60; t /= 60;
  h = t % 24; t /= 24;
  d = t % 30; t /= 30;
  n = t % 12; t /= 12;
  y = t;

  time = chinese_number(s) + "秒钟";
  if (m) time = chinese_number(m) + "分钟";
  if (h) time = chinese_number(h) + "小时";
  if (d) time = chinese_number(d) + "天";
  if (n) time = chinese_number(d) + "月";
  if (y) time = chinese_number(d) + "年";
  return time;
}

int main(object me, string arg) {
  string *list, hood = "", str = "", *tasklist, wiz_name, wiz_task, wiz_mission;
  object ob = new(LOGIN_OB);
  int j = 0, i;
  mapping task_content, mission_content;

  seteuid(getuid());
  tasklist = explode(read_file("/data/tasklist.o"), "\n");
  task_content = allocate_mapping(sizeof(tasklist));
  mission_content = allocate_mapping(sizeof(tasklist));
  for (i = 0; i < sizeof(tasklist); i++) {
    if (tasklist[i][0] == '#'
      || sscanf(tasklist[i], "%s %s %s", wiz_name, wiz_task, wiz_mission) != 3) continue;
    task_content[wiz_name] = wiz_task;
    mission_content[wiz_name] = wiz_mission;
  }


  list = sort_array(SECURITY_D->query_wizlist(), (: level :));
  list = filter_array(list, (: $1 != "jeff" :));
  str = HIC + MUD_NAME + NOR + "巫师成员：\n";
  str += HIB "≡────────────────────────────────────────≡\n";
  str += HIY " 巫师等级级别        巫师ID     状态　　　　　   巫师任务级别   任务说明\n" NOR;
  str += HIB "──────────────────────────────────────────\n" NOR;
  for (i = 0; i < sizeof(list); i++, j++) {
    if (hood != wiz_rank(wizhood(list[i]))) {
      hood = wiz_rank(wizhood(list[i]));
      //                        if (j%7) str += "\n";
      str += hood;
      str = replace_string(str, "(", HIG);
      str = replace_string(str, ")", ": " NOR);
      if (i + 1 < sizeof(list)) {
        if (hood != wiz_rank(wizhood(list[i + 1])))
          str += "━━━";
        else
          str += "━┳━";
      } else str += "━━━";
      j = 0;
    }

    if (j && (i < sizeof(list) - 1 && hood == wiz_rank(wizhood(list[i + 1])))) str += "                ┣━";
    else if (j) str += "                ┗━";
    ob->set("id", list[i]);

    str += sprintf(" %s%s\t%-17s%-15s%s\n", HIW + list[i] + NOR,
      (i < sizeof(list) - 1 && hood == wizhood(list[i + 1])) ? ", " : "",
      //                ob->restore() ? (find_player(list[i]) ? "在线" + times(time()-ob->query("last_on")): "离线" + times(time()-ob->query("last_on"))) : "失踪",
      "正常",
      task_content[list[i]] ? task_content[list[i]] : "目前没有任务",
      mission_content[list[i]] ? mission_content[list[i]] : "待定");
  }
  str += HIB "≡────────────────────────────" HIR "《仙 剑 狂 侠 》" HIB "──────≡\n" NOR;
  str += HIY " 当职WIZ不在位时，狂侠小组在线wiz，无论任何职位，即时补弃。\n" NOR;
  str += sprintf("目前一共有: " HIR "%d" NOR "个巫师\n", sizeof(list));
  write(str);
  return 1;
}
string wiz_rank(string hood) {
  switch (hood) {
    case "(admin)":
      return HIR "【   天尊   】" NOR;
    case "(arch)":
      return HIY "【   地尊   】" NOR;
    case "(wizard)":
      return HIG "【   人尊   】" NOR;
    case "(apprentice)":
      return HIB "【   神仙   】" NOR;
    case "(immortal)":
      return HIC "【   巫师   】" NOR;
  }
}
int level(mixed ob1, mixed ob2) {
  if (wiz_level(ob1) != wiz_level(ob2))
    return wiz_level(ob1) - wiz_level(ob2);
  return ob1 < ob2 ? -1 : 1;
}

int help(object me) {
  write(@HELP \n指令格式 : wizlist\n"
HELP);
  return 1;
}
