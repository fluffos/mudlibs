// by tiantian(www.wangcf.com) 2001.4
// 快速从帮派回到城隍庙

#include <ansi.h>

int main(object me, string arg) {
  object env;

  env = environment(me);

  if (!me->query("group"))
    return notify_fail("你并没有加入任何帮派。\n");

  if (me->is_busy())
    return notify_fail("你的上一个动作还未完成。\n");

  if (me->is_fighting())
    return notify_fail("你在战斗中，正忙着呢。\n");

  if (env->query("group") != me->query("group/group"))
    return notify_fail("这里不是你的帮派领地，你无法返回起点。\n");

  if (me->is_ghost())
    return notify_fail("你现在还是鬼魂呢。\n");

  message_vision(HIC "$N轻轻地闭上眼睛，双腿盘膝而坐，嘴里默默地念叨着什么...\n" NOR, me);
  me->start_busy(3);
  call_out("move", 5, me);

  return 1;
}

void move(object me) {
  me->move("/d/city/chmiao");
  tell_room(environment(me), HIY "一阵人影飘动后"
    +(string)me->query("name") + "从人群中走了过来。\n" NOR, ({ me }));
}


int help(object me) {
  write(@HELP
----------------------------------------
指令格式: recall

这个指令可以让你从帮派领地迅速回到起点。
        
相关命令：ghome

----------------------------------------

HELP
  );
  return 1;
}
