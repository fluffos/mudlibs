#include <armor.h>
#include <ansi.h>
inherit SHIELD;

string *names = ({
  HIY"天蚕盾"NOR,
  BLU"地精盾"NOR,
  CYN"冰凌盾"NOR,
  YEL"风蚀盾"NOR,
});

string *ids = ({
  "tiancan dun",
  "dijing dun",
  "bingling dun",
  "fengshi dun",
});

void create()
{
  int i = random(sizeof(names));
  set_name(names[i], ({ids[i], "dun", "tian dun", "shield"}));
  set_weight(1000);
  if ( clonep() )
     set_default_object(__FILE__);
  else {
   set("unit", "件");
     set("value", 12000);
   set("no_zm",1);
   set("material", "skin");
   set("armor_prop/armor", 150);
   set("armor_prop/dodge", -10);
  }
  setup();
}
