#include <ansi.h>

inherit ITEM;
#include <task.h>

void create() {
  set_name(HIY "桃木剑" NOR, ({ "taomu jian", "jian" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", " 透着寒光的宝剑。\n");
    set("unit", "柄");
    set("owner_name", "袁天罡");
    set("owner_id", "yuan tiangang");
  }
}
