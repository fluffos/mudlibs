#include <ansi.h>
inherit ITEM;
void create()
{
    set_name(HIR"红丝巾"NOR, ({ "hongsijin" }) );
    set_weight(1);
    if( clonep() )
            set_default_object(__FILE__);
    else {
            set("unit", "袭");
            set("material", "silk");
            set("long", "一袭红丝巾\n");
          }

    setup();
}
