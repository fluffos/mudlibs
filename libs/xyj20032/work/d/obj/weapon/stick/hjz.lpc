#include <weapon.h>
#include <ansi.h>
inherit STICK;

void create() {
  set_name(HIY "鸿钧杖" NOR, ({ "jingu bang", "bang" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("value", 400);
    set("material", "steel");
    set("wield_msg", "$N「呼」地一声抽出一根$n握在手中。\n");
  }
  init_stick(1000);
  setup();
}
