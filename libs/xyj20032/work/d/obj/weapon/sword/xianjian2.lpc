#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create()
{
	set_name(RED"陷仙剑"NOR, ({"xianxian jian", "jian", "sword"}));
	set_weight(5000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "柄");
		set("long", "这是陷仙剑。\n");
		set("value", 5000);
		set("material", "steel");
		set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中。\n");
		set("unwield_msg", "$N将手中的$n插回剑鞘。\n");
	}
	init_sword(300);
	setup();
}
