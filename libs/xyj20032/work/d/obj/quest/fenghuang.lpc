#include <ansi.h>

inherit ITEM;
#include "task.h"
void create()
{
        set_name(HIY"凤凰琴"NOR, ({"fenghuang sword", "fenghuang"}));
        set_weight(80);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一尊玉雕刻成的凤凰琴。\n");
                set("unit", "把");
                set("owner_name","孔雀公主");
                set("owner_id","kongque gongzhu");
        }
}

