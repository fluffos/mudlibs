// sunwukong.c
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create()
{
        set_name(HIY"孙悟空"NOR, ({"sun wukong", "sun", "wukong"}));
        set("nickname", HIW"齐天大圣"NOR);
        set("gender", "男性" );
        set("class", "hgs");
        set("age", 18);
        set("long", "他乃是花果山美猴王。玉皇大帝亲封之为齐天大圣！\n");
  set("combat_exp", 10000000);
	set("daoxing", 10000000);
  set("attitude", "heroic");
	set("int", 40);
	set("con", 40);
	set("str", 40);
	set("dex", 40);
	set("cps", 20);
	set("cor", 40);
	set("spi", 40);
	set("per", 15);
	set("kar", 30);
  set("food", 1000);
  set("water", 1000);
  set("bellicosity", 300);
        create_family("花果山水帘洞", 1, "猴王");
	      set("eff_dx", 10000000);
        set("nkgain", 200);

        set_skill("unarmed", 400);
        set_skill("dodge", 500);
        set_skill("parry", 500);
        set_skill("spells", 500);  
        set_skill("houwang-xinjing", 500);
        set_skill("literate", 100);
        set_skill("stick", 600);  
        set_skill("qitian-gun", 600);
        set_skill("houwang-quan", 400);  
        set_skill("jindouyun", 500);
        set_skill("force", 500);   
        set_skill("houwang-force", 500);

        map_skill("spells", "houwang-xinjing");
        map_skill("unarmed", "houwang-quan");
        map_skill("force", "houwang-force");
        map_skill("stick", "qitian-gun");
        map_skill("parry", "qianjun-bang");
        map_skill("dodge", "jindouyun");


        set("max_kee", 50000);
        set("max_gin", 50000);
        set("max_sen", 50000);
        set("force", 40000);
        set("max_force", 20000);
        set("force_factor", 100);
        set("mana", 20000);
        set("max_mana", 10000);
        set("mana_factor", 5);

        setup();
        carry_object("/d/obj/armor/jinyipifeng")->wear();
        carry_object("/d/obj/weapon/stick/jingubang")->wield();
}
void attempt_apprentice(object ob, object me)
{
    if (random(this_player()->query_kar()) < 20 || this_player()->query("mark/hgs_sun")) 
     {
      this_player()->set("mark/hgs_sun", 1);
      command("shake");
  	  command("say 凭你也想成为俺老孙的徒弟？滚远点吧！\n");
  	  return;
  	 }
    else {
	command("pat "+ob->query("id"));
  command("say 既然" + RANK_D->query_respect(ob) +"与俺老孙有缘，俺老孙就收下你了。\n");
  command("say 很好，" + RANK_D->query_respect(ob) +"多加努力，他日必定有成。\n");
  command("recruit " + ob->query("id") );
  ob->set("class", "hgs");
	return;
       }
}		
