#include <ansi.h>
inherit ROOM;

void create()
{
  set ("short", HIY"天上天"NOR);
  set ("long", @LONG

这里是天上天。

LONG);

  set("exits", ([ /* sizeof() == 1 */
    "south": __DIR__"qiushi",
    "down" : __DIR__"nantian",
    "out" : __DIR__"twt",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    __DIR__"npc/ystz" : 1,
    __DIR__"npc/lbdj" : 1,
    __DIR__"npc/tslj" : 1,
  ]));
  setup();
}

int valid_leave (object who, string dir)
{
  object tianzun1 = present ("yuanshi tianzun", environment(who));
  object tianzun2 = present ("lingbao daojun", environment(who));
  object tianzun3 = present ("taishang laojun", environment(who));
  if (dir == "out" && living (tianzun1))
      return notify_fail (tianzun1->query("name")+"喝道：禁行！\n");
  if (dir == "out" && living (tianzun2))
      return notify_fail (tianzun2->query("name")+"喝道：禁行！\n");
  if (dir == "out" && living (tianzun3))
      return notify_fail (tianzun3->query("name")+"喝道：禁行！\n");
      return ::valid_leave(who, dir);
}
