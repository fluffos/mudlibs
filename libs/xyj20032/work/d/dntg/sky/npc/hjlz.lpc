// 神话世界·西游记·版本４．５０

/* <SecCrypt CPL V3R05> */
#include <ansi.h>
inherit NPC;

inherit F_MASTER;

void create()

{

  set_name(HIW "鸿钧老祖" NOR, ({ "hongjun laozu", "hongjun", "laozu" }));

  set("title", "万仙之祖");

  set("gender", "男性");

  set("age", 100);

  set("per", 100);

  set("str", 100);

  set("long", "鸿钧一道传三友\n");

  set("class", "xian");

  set("combat_exp", 100000000);
  set("daoxing", 100000000);

  set("food", 10000);
  set("water", 10000);
  set("attitude", "peaceful");

  create_family("道教", 1, "祖师");

  set_skill("unarmed", 800);

  set_skill("dragonfight", 800);

  set_skill("dodge", 800);

  set_skill("jindouyun", 800);

  set_skill("parry", 800);

  set_skill("stick", 800);

  set_skill("qianjun-bang", 800);

  set_skill("force", 800);

  set_skill("wuxiangforce", 800);

  set_skill("literate", 800);

  set_skill("spells", 800);

  set_skill("dao", 800);

  map_skill("spells", "dao");

  map_skill("force", "wuxiangforce");

  map_skill("unarmed", "dragonfight");

  map_skill("stick", "qianjun-bang");
  map_skill("parry", "qianjun-bang");
  map_skill("dodge", "jindouyun");

  set("max_kee", 800000);

  set("max_sen", 800000);

  set("force", 300000);

  set("max_force", 150000);

  set("mana", 300000);

  set("max_mana", 150000);

  set("force_factor", 800);

  set("mana_factor", 800);

  set("chat_chance_combat", 10);
  set("chat_msg_combat", ({
    (: cast_spell, "light" :),
    (: cast_spell, "thunder" :),
  }));


  setup();

  carry_object("/d/lingtai/obj/xianpao")->wear();

  carry_object("/d/obj/weapon/stick/hjz")->wield();

}
void attempt_apprentice(object ob) {
  command("say 贫道早就不收徒弟了。");
  return;
}
void die() {
  command("unwield bang");
  command("drop bang");
  command("remove pao");
  command("drop pao");
  command("say 贫道去也！");
  destruct(this_object());
}
