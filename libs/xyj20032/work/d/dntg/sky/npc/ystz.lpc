/* <SecCrypt CPL V3R05> */
#include <ansi.h>
inherit NPC;

inherit F_MASTER;

void create()

{

  set_name(HIR "元始天尊" NOR, ({ "yuanshi tianzun", "yuanshi", "tianzun" }));

  set("title", "玉清");

  set("gender", "男性");

  set("age", 83);

  set("per", 40);

  set("str", 40);

  set("long", "混元无极玉清元始大天尊！\n");

  set("class", "xian");

  set("food", 10000);
  set("water", 10000);
  set("combat_exp", 30000000);
  set("daoxing", 30000000);

  set("attitude", "peaceful");

  create_family("阐教", 1, "祖师");

  set_skill("unarmed", 500);

  set_skill("wuxing-quan", 500);

  set_skill("dodge", 500);

  set_skill("baguazhen", 500);

  set_skill("parry", 500);

  set_skill("sword", 500);

  set_skill("sanqing-jian", 500);

  set_skill("xiaofeng-sword", 500);

  set_skill("force", 500);

  set_skill("zhenyuan-force", 500);

  set_skill("literate", 500);

  set_skill("spells", 500);

  set_skill("taiyi", 500);

  map_skill("spells", "taiyi");

  map_skill("force", "zhenyuan-force");

  map_skill("unarmed", "wuxing-quan");

  map_skill("sword", "sanqing-jian");
  map_skill("parry", "sanqing-jian");

  map_skill("dodge", "baguazhen");

  set("max_kee", 100000);

  set("max_sen", 100000);

  set("force", 99000);

  set("max_force", 50000);

  set("mana", 99000);

  set("max_mana", 50000);

  set("force_factor", 300);

  set("mana_factor", 300);



  set("spell_qiankun_on", 1);  //to use cast qiankun, must set this.

  set("chat_chance_combat", 10);

  set("chat_msg_combat",

    ({

      (: cast_spell, "zhenhuo" :),

      (: cast_spell, "qiankun" :),

    }));



  setup();

  carry_object("/d/dntg/sky/obj/tianzunpao")->wear();

  carry_object("/d/obj/weapon/sword/xianjian2")->wield();

}
void attempt_apprentice(object ob) {
  command("say 贫道早就不收徒弟了。");
  return;
}

int valid_leave(string dir) {
  if (dir == "up")
    return notify_fail("元始天尊喝道：禁行！\n");
}
