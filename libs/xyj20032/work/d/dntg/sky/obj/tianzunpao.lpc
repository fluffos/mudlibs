#include <armor.h>
#include <ansi.h>
inherit CLOTH;

void create() {
  set_name(HIY "天尊袍" NOR, ({ "tianzun pao", "pao", "cloth" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 2000);
    set("material", "cloth");
    set("armor_prop/armor", 300);
    set("armor_prop/dodge", 5);
    set("armor_prop/spells", 5);
  }
  setup();
}
