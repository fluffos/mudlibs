//薯条

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("炸薯条", ({ "shu tiao", "shutiao" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一盒香喷喷的炸薯条\n");
    set("unit", "盒");
    set("value", 50);
    set("food_remaining", 2);
    set("food_supply", 100);
  }
}
