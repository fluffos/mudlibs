// wineskin.c  酒袋

#include <ansi.h>
inherit ITEM;
inherit F_LIQUID;

void create()
{
        set_name("青岛"+YEL+"啤酒"NOR, ({"pijiu"}));
        set_weight(700);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "一罐青岛啤酒。\n");
                set("unit", "罐");
                set("value", 20);
                set("max_liquid", 15);
        }

        // because a container can contain different liquid
        // we set it to contain wine at the beginning
        set("liquid", ([
                "type": "alcohol",
                "name": "啤酒",
                "remaining": 15,
                "drunk_supply": 6,
        ]));
}


