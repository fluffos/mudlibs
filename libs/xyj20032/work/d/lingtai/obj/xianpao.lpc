#include <ansi.h>
inherit EQUIP;

void create()
{
        set_name(HIW"鸿钧袍"NOR, ({"hongjun pao", "pao"}));
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("value", 10000);
                set("material", "cloth");
                set("armor_type", "cloth");
                set("armor_prop/armor", 1000);
                set("armor_prop/dodge", 100);
                set("armor_prop/spells", 100);
             }
}
