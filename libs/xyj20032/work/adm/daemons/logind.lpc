varargs void enter_world(object ob, object user, int silent)
{
    int user_count;
    string cname,startroom,wiz_lvl;
    string ip_number;
    string ip_from;

    if (!is_root(previous_object()))
     return;

    reset_eval_cost();
    user->set_temp("temp_time",time());    
    ob->set_temp("body_ob", user);
    user->set_temp("link_ob", ob);
    user->set_temp("big5", ob->query_temp("big5"));
    ob->set_temp("last_from", query_ip_name(ob)+"("+query_ip_number(ob)+")");

    exec(user, ob);
    user->setup();
    
    if( ob->query("name") != user->query("name")) 
    {
    // 曾用名记录，目前用于Fingerd.c
    ob->add("cname/cname","["+ob->query("name")+"] ");
    // 统一LOGIN_OB和USER_OB的name(如果采用login里给出自动起名字的方案时采用)
    ob->set("name", user->query("name"));
    }    
    user->save();
    ob->save();

    ip_number = query_ip_number(user);

        /*******************************************************************************/
        // Added by kuku@2004/05/01
        // Old code by waiwai
        // 这里配合quit为了避免巫师而因特殊原因而保留某些不该保留的巫师频道
        // 而泄密。设置在quit里面每次清空所有频道，这里重新设定一次
        switch ( wizhood(user) ) {
        case "(admin)":
                wiz_lvl=YEL"总管巫师(admin)"NOR;
        user->set("channels", 
        ({ "chat", "rumor", "sldh", "adm", "wiz", "err", "debug", 
        "sys", "party", "sj", "xiaodao", "mete", "job","gwiz"  }) );
                break;        
        case "(arch)":
                wiz_lvl=YEL"天界大神(arch)"NOR;
        user->set("channels", 
        ({ "chat", "rumor", "sldh", "wiz", "sys", "party", 
        "sj", "xiaodao", "mete", "job","gwiz" }) );
                break;        
        case "(wizard)":
                wiz_lvl=YEL"天界仙人(wizard)"NOR;
        user->set("channels", 
        ({ "chat", "rumor", "sldh", "wiz", "sys", "party", "sj", 
        "xiaodao", "mete", "job","gwiz" }) );
                break;        
        case "(apprentice)":
                wiz_lvl=YEL"天界散仙(apprentice)"NOR;
        user->set("channels", 
        ({ "chat", "rumor", "sldh", "wiz", "sys", "party", "sj", 
        "xiaodao", "mete", "job" }) );
                break;        
        case "(immortal)":
                wiz_lvl=YEL"天界灵官(immortal)"NOR;
        user->set("channels", 
        ({ "chat", "rumor",  "sldh", "wiz", "sys", "party", "sj", 
        "xiaodao", "mete", "job" }) );
                break;        
        case "(elder)":
                wiz_lvl=YEL"荣誉巫师(elder)"NOR;
        user->set("channels", 
        ({ "chat", "rumor", "sldh", "wiz", "sys", "party", "sj", 
        "xiaodao", "mete", "job" }) );
                break;  
        case "(player)":
                wiz_lvl=YEL"普通用户(player)"NOR;
        user->set("channels", 
        ({ "chat", "rumor", "sldh", "sj", "xiaodao", "party", "mete", "job" }) );
                break;        
        default: 
                error("wiz_lvl: undefined lvl " + wizhood(user) + ".\n");
        }
    if (!silent)
    {
        if (file_size(MOTD) > 0)
            user->start_more( color_filter( read_file(MOTD)) );
        user_count = user->query("login_count");
        if( user_count < 1 ) user_count = 1; 
        user_count++;
        user->set("login_count",user_count);

     write(CYN"     ≡≡≡≡≡≡≡≡≡≡≡≡"HIR+CHINESE_MUD_NAME+"连线信息"NOR CYN"≡≡≡≡≡≡≡≡≡≡≡≡\n"NOR);
             write("     ★  您是第 "YEL+chinese_number(user_count)+NOR " 次连接"+CHINESE_MUD_NAME+"。\n");
     write("     ★  您的系统权限目前是："YEL + wiz_lvl + "\n"NOR);
     write("     ★  您目前连线的地址是：" YEL + query_ip_number(user) +"("+query_ip_port(user)+")\n"NOR);
    // 如果是第一次连线则不显示下面设置
    if(ob->query("last_on"))
     { 
     write("     ★  您上次离线的地址是：" +ob->query("last_from") + "\n");
     write("     ★  您上次离线的时间是：" +COLOR_D->clean_color(BJTIME_CMD->chinese_time(1, ctime(ob->query("last_on"))))+ "\n");        
     }
     write(NOR CYN"     ≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡\n\n"NOR);        

        if (file_size("/etc/notice") > 0)
        {
            write(HIC"     ≡≡≡≡≡≡≡≡≡≡≡≡ "HIR"连线通知"NOR HIC" ≡≡≡≡≡≡≡≡≡≡≡≡\n");
            write(NOR"     " + color_filter(read_file("/etc/notice")));
            write(HIC"     ≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡\n"NOR);
        }
        
        user->set_temp("last_damage_from", "莫名其妙地");
        user->set_temp("logon_mudage", user->query("mud_age"));
             
	if (user->query("no_gift"))
	{
            user->move("/d/wiz/init",1);
        } 
        else{
        	write("请按回车继续......\n");
            	input_to("nothing", user);

		if (!stringp(startroom = user->query("startroom")))
                	startroom = START_ROOM;
            	if (startroom[0..2] != "/d/")
                	startroom = START_ROOM;
            	if (user->is_ghost())
               		startroom = DEATH_ROOM; 
            	if ((__DIR__"band"->create_char_banned(ip_number) == 1 ||
                __DIR__"band"->is_banned(ip_number)== 1) && !wizardp(user))
                	startroom = GUEST_ROOM;
            	if (wizardp(user))
                	startroom = WIZARD_ROOM;

            	if (catch(load_object(startroom)))
            	{
                	write("您上次退出的地方已经消失了。\n");
                	startroom = START_ROOM;
            	}

            	user->move(startroom);
            	user->set("startroom", startroom);
              user->set("env/combatd",0);
            	tell_room(startroom, user->query("name") +
                      "连线进入这个世界。\n", ({user}));
        }      

        ip_from = __DIR__"sited"->seek_ip_address(ip_number);
        CHANNEL_D->do_channel(this_object(), "sys",
            sprintf(NOR WHT "%s由 " HIG "%s" NOR WHT "连线进入,IP来自："HIG"%s"NOR,
                    user->name() + "(" + capitalize(user->query("id")) + ")",
                    ip_number, ip_from));  

        NEWS_D->prompt_user(user);
        __DIR__"maild"->check_mail(user);
    }

    if (//wizhood(user) != "(admin)" && 
        EXAMINE_D->query("log_by/" + user->query("id")))
        user->start_log();

    	user->set_temp("logon_time", time());
    	user->set_temp("logon_exp", user->query("combat_exp"));
    	user->set_temp("logon_daoxing", user->query("daoxing"));

	UPDATE_D->check_user(user, 0);
	MPTOP_D->check_mp_player(user);  
    	if (mapp(user->query("user_weapon"))) 
	USER_WEAPOND->check_user_weapon(user); 
	
    if(wizardp(user))
    {
        if (!ob->query("wiz_password"))
            write(HIR+BLINK"请用WIZPWD设定相应的WIZ密码！\n"NOR);
        CHANNEL_D->do_channel( this_object(), "wiz",
            sprintf(NOR "%s" HIY " 从 " HIG "%s" HIY " 进入连线。",
                    user->short(1), ip_number));
    } else
    {

        object caishen;
        if (objectp(caishen=find_object("/d/wiz/npc/caishen")))
            caishen->check_one(user);
        EXAMINE_D->examine_player(user);
        if ((user->query("kee") < 0 || user->query("sen") < 0) && living(user))
            user->unconcious();
    }

}

varargs void reconnect(object ob, object user, int silent)
{
    object old_link;

    old_link = user->query_temp("link_ob");
    
    if (old_link && old_link!=ob)
        destruct(old_link);

    user->set_temp("link_ob", ob);
    ob->set_temp("body_ob", user);
    user->set_temp("big5", ob->query_temp("big5"));
    ob->set_temp("last_from", query_ip_name(ob) + "(" + query_ip_number(ob) + ")");

    exec(user, ob);

    user->reconnect();

    if (!silent && (! wizardp(user) || !user->query("env/invisibility")))
        tell_room(environment(user), user->query("name") + "重新连线回到这个世界。Good Luck!\n",({user}));
    CHANNEL_D->do_channel(this_object(), wiz_level(user)?"wiz":"sys",
        sprintf("%s由%s重新连线进入。", user->query("name")+"(" + capitalize(user->query("id")) + ")", query_ip_number(user)));
    user->set("last_relogin", time());
    UPDATE_D->check_user(user, 1);
}

int check_legal_id(string id)
{
    int i;
    string *legalid;

    i = strlen(id);
  
    if (i < 3 || i > 8 )
    {
        write("对不起，你的英文名字必须是 3 到 8 个英文字母。\n");
        return 0;
    }
    while(i--)
        if( id[i]<'a' || id[i]>'z' )
        {
            write("对不起，你的英文名字只能用英文字母。\n");
            return 0;
        }
    legalid = explode(read_file(BANNED_ID), "\n");
    for (i=0; i<sizeof(legalid); i++)  
    {
        if ( id == legalid[i] )  
        {
            write("对不起，这种名字会造成其他人的困扰。\n");
            return 0;
        }
    }
//限制垃圾ID，禁止使用相同字母组合>3的ID，比如 aaaa ddddd
	if( strlen(id) > 3 )
        for( i = 0; i < strlen(id) - 3; i ++ )
            if( id[i] == id[i+1] && id[i] == id[i+2] && id[i] == id[i+3] ) 
            {
                write("\n对不起，请不要使用重复三个字母以上的字符做名字......\n");
                return 0;
            }
    return 1;
}

int check_legal_name(object ob, string name)
{
    int i;

    i = strlen(name);

    if (i < 2 || i > 12 || i%2)
    {
        write("对不起，你的中文名字必须是一到六个中文字。\n");
        return 0;
    }
    while(i--)
    {
        if( i%2==0 && !is_chinese(name[i..<0]) )
        {
            write("对不起，请您用「中文」取名字。\n");
            return 0;
        }
    }

    return 1;
}

object find_body(string name)
{
    return find_player(name);
}

int set_wizlock(int level)
{
    if( wiz_level(this_player(1)) <= level )
        return 0;
    if( geteuid(previous_object()) != ROOT_UID )
        return 0;
    wiz_lock_level = level;
    return 1;
}

