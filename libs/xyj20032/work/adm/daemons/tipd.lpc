#include <ansi.h>
#include <globals.h>

void tip(object me) {
  switch (random(7)) {
    case 0:
      CHANNEL_D->do_channel(me, "chat",
        sprintf(HIR "三界神话官方主页:http://www.sanjie.org" NOR));
      break;
    case 1:
      CHANNEL_D->do_channel(me, "chat",
        sprintf(HIW "三界神话各游戏服务器地址：\n
                    楚天站：  61.242.166.254 6666\n
                    嘉峪关站：61.134.64.101  9999\n                 
                    蛇口总站：61.134.64.101  2000" NOR));
      break;
    case 2:
      CHANNEL_D->do_channel(me, "chat",
        sprintf(YEL "如果你是新来的玩家，请多使用help来了解游戏。同时也要多注意news all里的内容。" NOR));
      break;
    case 3:
      CHANNEL_D->do_channel(me, "chat",
        sprintf(YEL "在客栈小二那里你可以向他打听一些小道消息（消息）。" NOR));
      break;
    case 4:
      CHANNEL_D->do_channel(me, "chat",
        sprintf(YEL "屈原可是个大诗人大爱国者大思想家，你可以向他要个箱子哦！" NOR));
      break;
    case 5:
      CHANNEL_D->do_channel(me, "chat",
        sprintf(YEL "多帮助其他人是我们中华民族的美德，希望你能做出榜样。" NOR));
      break;
    case 6:
      CHANNEL_D->do_channel(me, "chat",
        sprintf(YEL "发现bug有重奖，利用bug牟利将得到严惩，希望我们营造一个健康美好的家园。" NOR));
      break;
  }
}
