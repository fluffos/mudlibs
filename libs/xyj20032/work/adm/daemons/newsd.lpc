#include <ansi.h>
#include <command.h>
#include <getconfig.h>
#include <mudlib.h>

#pragma optimize
#pragma save_binary

inherit F_SAVE;
inherit F_DBASE;

// 最多一千条新闻
#define MAX_NEWS_CAPACITY       1000
//int     last_update_day = 0;
//mapping family_priority = ([ ]);

void create() {
  seteuid(getuid());
  restore();
  set_heart_beat(900);
}
void remove() {
  save();
}

void mud_shutdown() {
  save();
}

// prompt user
void prompt_user(object me) {
  int num;
  int total;
  mapping *notes;
  int last_read_time;

  last_read_time = me->query("last_read_news");
  if (!last_read_time) {  //修改了waiwai的描述，感觉这样的设计很好。
    if (me->query_temp("new_player"))
      tell_object(
        me,
        HIR "\n欢迎你来到" HIY "+CHINESE_MUD_NAME+CHINESE_SERVER_SITE+" HIR "的游戏世界。为了更好的帮助你游戏这个世界，请多使用" HIW "news" HIR "
来了解游戏的变动情况。如果你有什么不清楚的地方，可使用" HIW "help news" HIR "来了解具
体的使用方法。最后，祝你在游戏中游戏愉快。\n\n" NOR
      );

    // Added by waiwai@2003/04/20
    if (me->query("new_player"))
      me->delete("new_player");

    me->set("last_read_news", 0);
    return;
  }

  notes = query("notes");

  if (!pointerp(notes) || !sizeof(notes))
    return;

  num = sizeof(notes);
  total = 0;
  while (num--)
    if (notes[num]["time"] > last_read_time)
      total++;
    else
      break;

  if (!total) {
    // Added by waiwai@2003/04/09
    if (me->query("mud_age") > 0)
      write(RED "  → " NOR "您已经在" + CHINESE_MUD_NAME + "的世界里经历了" + FINGER_D->age_string((int)me->query("mud_age")) +
        "的岁月了。。。\n" NOR);
  } else
    tell_object(me, sprintf(GRN "\n你目前一共有 " YEL "%d" NOR
      GRN " 条来自天界的消息还没有得知。\n请您立即使用 "
      WHT "news" NOR GRN " 来查看最新的升级更新情况。\n" NOR, total));

  // 开始定时通知
  if (previous_object() == find_object(LOGIN_D))
    if (me->query("mud_age") > 1800 && !me->query("doing"))

      call_out("auto_notice", 10 + random(10), me);
}

// show all the news's title
// raw = 1: only show the non-read news
void show_news(object me, int raw) {
  mapping *notes;
  int i, i2, last_time_read;
  string msg;

  notes = query("notes");
  if (!pointerp(notes) || !sizeof(notes)) {
    tell_object(me, MUD_NAME + CHINESE_SERVER_SITE + "目前没有发布任何消息。\n");
    return;
  }

  last_time_read = me->query("last_read_news");
  i = sizeof(notes);
  i2 = sizeof(notes) - last_time_read;

  msg = "目前" + CHINESE_SERVER_SITE + "巫师组发布的所有公告如下：\n"
    GRN "───────────────────────────────────────────\n" NOR;
  while (i--) {
    if (raw && (notes[i]["time"] <= last_time_read))
      break;

    msg += sprintf("%s[%3d]" NOR " %-" + (35 + color_len(notes[i]["title"])) +
      "s %18s [%s]\n",
      (notes[i]["time"] > last_time_read ? HIR "(未读)" NOR : WHT "(已读)" NOR),
      i + 1, notes[i]["title"],
      notes[i]["author"],
      BJTIME_CMD->chinese_time(7, ctime(notes[i]["time"])));
  }
  if (i == sizeof(notes) - 1) {
    tell_object(me, "目前没有任何未查看过的消息。\n");
    return;
  }

  msg += GRN "─────────────────────────────── " HIR + CHINESE_SERVER_SITE + NOR GRN " ─────\n" NOR;

  me->start_more(msg);
}

// This is the callback function to process the string returned from the
// editor defined in F_EDIT of player object.
void done_post(object me, mapping note, int n, string text) {
  int i;
  int pl;
  string sign;
  string pure;
  mapping *notes;

  if (!n) n = me->query("env/default_sign");
  if (!stringp(sign = me->query(sprintf("env/sign%d", n)))) {
    // auto select the first none null sign
    for (i = 1; i <= 4; i++) {
      sign = me->query(sprintf("env/sign%d", i));
      if (stringp(sign)) break;
    }
  }

  if (stringp(sign)) {
    sign = replace_string(sign, "\\n", "\n");
    sign = trans_color(sign, 1);
    pure = filter_color(sign);
    if (strlen(pure) >= 1 &&
      pure[strlen(pure) - 1] != '\n')
      sign += "\n";

    pure = filter_color(text);
    pl = strlen(pure);
    if (pl >= 1 && pure[pl - 1] != '\n')
      text += "\n\n" + sign;
    else if (pl >= 2 && pure[pl - 2] != '\n')
      text += "\n" + sign;
    else
      text += sign;
  }

  text = color_filter(text) + NOR;

  note["msg"] = text;
  notes = query("notes");
  if (!pointerp(notes) || !sizeof(notes))
    notes = ({ note });
  else {
    i = sizeof(notes) - 1;
    if (note["time"] <= notes[i]["time"])
      note["time"] = notes[i]["time"] + 1;
    notes += ({ note });
  }

  // Truncate the notes if maximum capacity exceeded.
  if (sizeof(notes) > MAX_NEWS_CAPACITY)
    notes = notes[MAX_NEWS_CAPACITY / 1000..MAX_NEWS_CAPACITY];

  set("notes", notes);
  tell_object(me, HIG "\n标题新闻：" + HIR + note["title"] + HIG " 成功发布完毕，请检查错误，如果其中有错别字请给予更正。\n" NOR);
  message("channel:rumor",
    "\n\t    〓〓 〖 三界神话 〗有最新新闻发布！请用 news new 了解详细情况 〓〓\n\n", users());

  save();
}

// post a news
void do_post(object me, string arg) {
  int n;
  mapping note;

  if (!wizardp(me) || !interactive(me)) {
    tell_object(me, "只有巫师才能发布新闻。\n");
    return;
  }

  if ((string)SECURITY_D->get_status(me) != "(admin)") {
    tell_object(me, HIR "只有天神才能发布新闻。\n" NOR);
    return;
  }

  if (!arg) {
    tell_object(me, HIR "发布新闻必须指定一个标题。\n" NOR);
    return;
  }

  if (strlen(arg) < 4) {
    tell_object(me, HIR "新闻标题不得小于2个汉字字符。\n" NOR);
    return;
  }
  //为了显示规范，必须限制标题长度        
  if (strlen(arg) > 32) {
    tell_object(me, "标题过长,请控制在16个中文字符以内。\n");
    return;
  }

  if (sscanf(arg, "%s with %d", arg, n) != 2)
    n = 0;

  if (replace_string(arg, " ", "") == "")
    arg = "无标题";
  else
    arg = color_filter(arg) + NOR;

  note = allocate_mapping(4);
  note["title"] = arg;
  note["author"] = me->name(1) + "-" + me->query("id");
  note["time"] = time();
  me->edit((: call_other, __FILE__, "done_post", me, note, n :), me);
}

// read a news
void do_read(object me, string arg) {
  int num;
  mapping *notes;
  int last_read_time;

  last_read_time = me->query("last_read_news");
  notes = query("notes");

  if (!pointerp(notes) || !sizeof(notes)) {
    tell_object(me, HIR "目前没有任何消息。\n" NOR);
    return;
  }

  if (!arg) {
    tell_object(me, HIR "你想读那一条消息？\n" NOR);
    return;
  }

  if (arg == "new" || arg == "next") {
    if (!last_read_time)
      num = 1;
    else
      for (num = 1; num <= sizeof(notes); num++)
        if (notes[num - 1]["time"] > last_read_time)
          break;
  } else if (!sscanf(arg, "%d", num)) {
    tell_object(me, HIR "你要读第几条消息？\n" NOR);
    return;
  }

  if (num < 1 || num > sizeof(notes)) {
    tell_object(me, WHT "很抱歉，没有这条新闻。请用 " HIR "news all" NOR WHT " 查阅新闻条目。\n" NOR);
    return;
  }
  num--;
  me->start_more(sprintf("[%d] %-" + (35 + color_len(notes[num]["title"])) +
    "s %s [%s]\n─────────────────────────────────────\n",
    num + 1, notes[num]["title"], notes[num]["author"],
    BJTIME_CMD->chinese_time(7, ctime(notes[num]["time"]))) +
    notes[num]["msg"] + "───────────────────────────" HIR + CHINESE_SERVER_SITE + NOR GRN "────");

  // Keep track which post we were reading last time.
  if (notes[num]["time"] > (int)last_read_time)
    me->set("last_read_news", notes[num]["time"]);
}

// discard a news
void do_discard(object me, string arg) {
  mapping *notes;
  int num;
  string author, aid;

  if (!arg || sscanf(arg, "%d", num) != 1) {
    tell_object(me, HIR "你想删除哪一条新闻？\n" NOR);
    return;
  }

  notes = query("notes");
  if (!arrayp(notes) || num < 1 || num > sizeof(notes)) {
    tell_object(me, WHT "没有这条新闻。\n" NOR);
    return;
  }

  num--;

  if ((!stringp(author = notes[num]["author"]) ||
    sscanf(author, "%*s-%s", aid) != 2 ||
    aid != me->query("id")) &&
    (string)SECURITY_D->get_status(me) != "(admin)") {
    tell_object(me, HIR "只有天神才能删除他人发布的新闻。\n" NOR);
    return;
  }

  notes = notes[0..num - 1] + notes[num + 1..sizeof(notes) - 1];
  set("notes", notes);
  save();
  tell_object(me, HIG "删除第 " HIR + (num + 1) + HIG " 条新闻....Ok。\n" NOR);
}

// auto notice user
void auto_notice(object me) {
  int num;
  mapping *notes;
  string msg;
  int last_read_time;

  if (!objectp(me))
    return;

  last_read_time = me->query("last_read_news");
  notes = query("notes");

  if (!pointerp(notes) || !sizeof(notes))
    return;

  num = sizeof(notes) - 1;
  if (notes[num]["time"] <= last_read_time)
    return;

  call_out("auto_notice", 10 + random(10), me);

  if (!living(me) || me->query_temp("block_msg/all") || me->query("doing"))
    return;

  while (num-- > 0) {
    if (notes[num]["time"] <= last_read_time) {
      num++;
      break;
    }

    // contine to find next
  }

  if (num < 0) num = 0;

  switch (random(5)) {
    case 0:
      msg = GRN "\n一阵烟雾过后，土地老儿出现在你的面前，只见"
        "\n那土地慌慌张张的趴在你耳朵边上嘀咕了几句。\n" NOR;
      break;
    case 1:
      msg = GRN "\n地上突然开了一个裂缝，冒出一个白发大胡子的土"
        "\n地老儿，对着你鞠了个躬，然后喋喋不休的唠叨起来。\n" NOR;
      break;
    case 2:
      msg = GRN "\n你忽然听见有人喊你“上仙留步”，你回头一看"
        "\n原来是土地老儿满头大汗的在追着叫你。\n" NOR;
      break;
    case 3:
      msg = GRN "\n突然你眼前出现一股白色的烟雾，待烟雾散去以后"
        "\n只见一个土地老儿跪在地上说到：“上仙驾到，有失远迎”。\n" NOR;
      break;
    default:
      msg = GRN "\n一道金光闪过，土地从一股烟雾中出现在你的面前，"
        "\n土地对你鞠了个躬说道：“小仙在此恭候大驾多时了”。\n" NOR;
      break;
  }

  msg += HIG "土地(tu di)告诉你：请看来自天界最新的消息：\n" NOR;
  tell_object(me, msg);
  me->start_more(sprintf("[%d] %-" + (35 + color_len(notes[num]["title"])) +
    "s %s [%s]\n─────────────────────────────────────\n",
    num + 1, notes[num]["title"], notes[num]["author"],
    BJTIME_CMD->chinese_time(7, ctime(notes[num]["time"]))) +
    notes[num]["msg"] + "─────────────────────────── [ " HIR + CHINESE_MUD_NAME + NOR GRN " ] ─────");

  // Keep track which post we were reading last time.
  if (notes[num]["time"] > (int)last_read_time)
    me->set("last_read_news", notes[num]["time"]);

  tell_object(me, "\n土地说完后，消失在一阵烟雾之中。\n");
}

string query_save_file() { return DATA_DIR "newsd"; }
