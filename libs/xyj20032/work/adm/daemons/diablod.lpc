#include <ansi.h>
//Created By kuku@sjsh 2003-11-2
void drop(object npc,object user,int obj_level);
string random_file(string dir_path);//从dir_path目录中随机选取一个文件

void diablo(object npc,object user)
{
   int npc_exp,npc_dx,npc_total;
   int user_exp,user_dx,user_kar;
   int obj_level=1;//装备等级
   int user_success;//成功机率
   int user_kar_and_success;
   if (!npc) return;
   if (!userp(user)) return;
   //获得npc属性
   npc_exp=npc->query("combat_exp");
   npc_dx=npc->query("daoxing");
   
   npc_total=npc_exp+npc_dx;//把武学和道行相加.用于判断掉出装备的等级
   //获得user属性
   user_exp=user->query("combat_exp");
   user_dx=user->query("daoxing");
   user_kar=user->query("kar");  
   if(!user->query("chance"))
        user->set("chance",100);
   user_success=user->query("chance");
   user_kar_and_success=user_success+user_kar;

   //判断是否应该掉出装备.
   if ( (random(80)+random(user_success)+random(user_kar)) >10){
        //计算应该掉出哪个等级的装备
        if(random(1000)==1) obj_level=6;
        else if (npc_total>50000000 && (random(user_kar_and_success)>random(200) )) obj_level=5;
        else if (npc_total>30000000 && (random(user_kar_and_success)>random(150) )) obj_level=4;
        else if (npc_total>10000000 && (random(user_kar_and_success)>random(100) )) obj_level=3;
        else if (npc_total>5000000 && (random(user_kar_and_success)>random(50) )) obj_level=2;
        else obj_level=1;
        drop(npc,user,obj_level);
   }
}

void drop(object npc,object user,int obj_level)
{
        int i;
   object env;
   object obj;
   string temp_str;//temp_str="armor" or temp_str="weapon";
   string dir_path;//存放物品文件的目录名
   string file_name;
   string file_full_name;
   env=environment(npc);
   if (!env) return;
        if (random(4)==0) dir_path="/d/quest/newequip/wing"+""; 
        else if (random(4)==1) dir_path="/d/quest/newequip/weapon/"+obj_level+"";
        else if (random(4)==2) dir_path="/d/quest/newequip/beast"+"";
        else if (random(4)==3) dir_path="/d/quest/newequip/armor/"+obj_level+"";
        for(i=0;i<2;i++){
   		file_name=random_file(dir_path);
   		file_full_name=dir_path+"/"+file_name;
   //判断是否存在file
   		if (file_size(file_full_name) <0){
        		message_vision(file_full_name,npc);
        		return ;
   		}
   		obj=new(file_full_name);
   		obj->move(env);
   		message_vision(GRN+"从$N身上掉了出来一"+obj->query("unit")
                     +obj->name()+""GRN"「等级："+obj_level+" 」\n"+NOR,npc);
        }
   return;
}

string random_file(string dir_path)
{
   mixed* file;
   int j;
   file = get_dir( dir_path+"/*.lpc", -1 );
   if( !sizeof(file) ) return "";
   j = random(sizeof(file));
   return file[j][0];
}
