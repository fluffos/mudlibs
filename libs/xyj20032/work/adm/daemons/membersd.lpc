//stey
// 用来记录交付费用的会员..

#pragma save_binary
#include <ansi.h>
inherit F_DBASE;
inherit F_SAVE;

mapping club_members=([]);




void create()
{
        seteuid(getuid());
            restore(); 
        
}

string query_save_file() { return DATA_DIR + "membersd.o"; }

varargs string show_club_members(string type)
{
        string list,*club_name,*member_id;
        int i,j,k;
        club_name=keys(club_members);
        list ="共有"+ sizeof(club_name)+"位会员：\n";
       
                for(i=0;i<sizeof(club_name);i++)
                {
                        list+=sprintf("%s  %12s",club_members[club_name[i]],club_name[i]);
                       
                                if(k%5==0) list+="\n";
                        
                }
        
        

        list+="\n";
        return list;
}



void remove_club(string id)
{
        object ob;
        ob=this_player();
        if( wiz_level(ob)<wiz_level("(arch)") || !userp(ob) )
        {
                write("你没有足够的权限清除会员纪录！\n");
                return;
        }
        if(!mapp(club_members) || sizeof(club_members)<1)
        {
                write("目前没有会员纪录。\n");
                return;
        }

        if(undefinedp(club_members[id]))
        {
                write("没有这个会员纪录。\n");
                return;
        }

        write("这样会清除"+id+"会员！  确定要清除吗？(y/n)");
        input_to("comfirm_remove",id, ob);
}

private void comfirm_remove(string yn,string id, object ob)
{
        if( yn!="y" && yn!="Y" )
        {
                write("取消！\n");
                return;
        }

        log_file( "MEMBER", sprintf("[%s] %s(%s) 删除 %s 会员。\n备份资讯:\n",  ctime(time()),
                ob->query("name"),getuid(ob), id ));

        map_delete(club_members, id);
        save();
        write("["+id+"]会员已删除。\n");
        return;
}

int add_club(string id)
{
        object ob,obs,body;
        string cname;
        ob=this_player();
        if( wiz_level(ob)<wiz_level("(arch)") || !userp(ob) )
        {
                write("你没有足够的权限增加会员！\n");
                return 0;
        }

        if(!undefinedp(club_members[id]))
        {
                write("已经有这个会员了。\n");
                return 0;
        }
       obs = new(LOGIN_OB); 
       obs->set("id", id); 
       if (! obs->restore()) 
       { 
               destruct(obs); 
               write("没有这个玩家。\n");
               return 0 ;
       } 

       if (objectp(body = find_player(id)) && getuid(body) == id) 
       { 
               cname = body->query("name"); 
               
       } else 
       { 
               body = LOGIN_D->make_body(obs); 
               if (! body->restore()) { write("没有这个玩家。\n"); return 0;}
               cname = body->query("name"); 
               
               destruct(body); 
       } 


        club_members[id]=cname;
        write("新增会员OK！["+id+"]\n");
        save();
        return 1;
}

int check_member(string id)
{
        if(!undefinedp(club_members[id]))
        {
                notify_fail("没有这个会员!!\n");
                return 0;
        }
         return 1;
}





