		day_phase = read_table(N_S"summerC_sun"); break;
		case 2:
		day_phase = read_table(N_S"summerC_wind"); break;
		}
		break;
	/**********************************************************************************/
		// 初秋(autumnA-？)
		case "九": 
		if(get_day=="九") { // 农历的重阳
			msg = HIR"三界神话的重阳节到了，这是一个缅怀思念兄弟的日子！！！\n" NOR;
			message("system", HIR"┋"HIY"重阳佳节"HIR"┋"+ msg + "\n" NOR, users() );
			log_file( "daylog", sprintf("[%s][%s]: \n重阳佳节 %s",
