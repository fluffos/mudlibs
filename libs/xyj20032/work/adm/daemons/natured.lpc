		case 2:
		day_phase = read_table(N_S"autumnA_wind"); break;
		}
		break;

		// 秋季(autumn-？)
		case "十":
		switch(random(3)) {
		case 0:
		day_phase = read_table(N_S"autumn_rain");
		// Added by waiwai@2003/01/16 雨季的闪电
		message("system", "\n\t\t不远的高空划过一道闪电。不久后, 传来震耳欲聋的雷声，久久不绝……\n\n", users());
		call_out ("start_baoshi", 3);
		break;
		case 1:
		day_phase = read_table(N_S"autumn_sun"); break;
		case 2:
		day_phase = read_table(N_S"autumn_wind"); break;
		}
		break;

		// 深秋(autumnC-？)
		case "十一":
		if(get_day=="二十九") { // 农历的冬至
			msg = HIW "冬至到了，秋天即将远去，又一个寒冷的冬天来临了！\n" NOR;
			message("system", HIY"┋"HIR"四季交替"HIY"┋"+ msg + "\n" NOR, users() );
			log_file( "daylog", sprintf("[%s][%s]: \n四季交替 %s",
				game_time(), log_time(), filter_color(msg) ) );
			day_phase = read_table(N_S"autumnC_rain"); break;
			} else
		switch(random(3)) {
		case 0:
		day_phase = read_table(N_S"autumnC_rain");
		// Added by waiwai@2003/01/16 雨季的闪电
		message("system", "\n\t\t不远的高空划过一道闪电。不久后, 传来震耳欲聋的雷声，久久不绝……\n\n", users());
		call_out ("start_baoshi", 3);
		break;
		case 1:
		day_phase = read_table(N_S"autumnC_sun"); break;
		case 2:
		day_phase = read_table(N_S"autumnC_wind"); break;
		}
		break;

	/**********************************************************************************/
		// 初冬(winterA-？)
		case "零": 
		case "十二": 
		if(get_day=="二十二") { 
			msg = HIW "来自北方的寒流扫过大地，万物又开始了寂静的休眠。而三界神话世界的冬天却是温情的！\n" NOR;
			message("system", HIY"┋"HIR"四季交替"HIY"┋"+ msg + "\n" NOR, users() );
			log_file( "daylog", sprintf("[%s][%s]: \n四季交替 %s",
				game_time(), log_time(), filter_color(msg) ) );
			day_phase = read_table(N_S"winterA_sun"); break;
			} else
		switch(random(3)) {
		case 0:
		day_phase = read_table(N_S"winterA_snow"); 
		call_out ("start_baoshi", 3);
		break;
		case 1:
		day_phase = read_table(N_S"winterA_sun"); break;
		case 2:
		day_phase = read_table(N_S"winterA_wind"); break;
		}
		break;

		// 隆冬(winter-？)
		case "一":
		if(get_day=="一") { // 阳历新年
			msg = HIR"三界神话的元旦佳节来临了。快到年关了，春天也不远了！！！\n" NOR;
			message("system", HIR"┋"HIY"元旦佳节"HIR"┋"+ msg + "\n" NOR, users() );
			log_file( "daylog", sprintf("[%s][%s]: \n元旦佳节 %s",
				game_time(), log_time(), filter_color(msg) ) );
			day_phase = read_table(N_S"spring"); break;
			}
			else switch(random(3)) {
			case 0:
			day_phase = read_table(N_S"winter_snow"); 
			call_out ("start_baoshi", 3);
			break;
			case 1:		
			day_phase = read_table(N_S"winter_sun"); break;
			case 2:
			day_phase = read_table(N_S"winter_wind"); break;
			}
		break;

		// 冬末(winterC-？)
		case "二":
		if(get_day=="二") { // 农历的龙抬头
			msg = HIR"三界神话的龙头节日来临了，这是一个展望未来，寓意吉祥的日子！！！\n" NOR;
			message("system", HIR"┋"HIY"龙头佳节"HIR"┋"+ msg + "\n" NOR, users() );
			log_file( "daylog", sprintf("[%s][%s]: \n龙头佳节 %s",
				game_time(), log_time(), filter_color(msg) ) );
			day_phase = read_table(N_S"winterC_sun"); break;
			}
			else switch(random(3)) {
			case 0:
			day_phase = read_table(N_S"winterC_snow"); 
			call_out ("start_baoshi", 3);
			break;
			case 1:		
			day_phase = read_table(N_S"winterC_sun"); break;
			case 2:
			day_phase = read_table(N_S"winterC_wind"); break;
			}
			break;
			default:
			day_phase = read_table(N_S"day_phase");
		}
/**************************************************************************************************/
/*
	// 雨季的连绵夜雨，
	if( random( 8 ) == 0 ) {
	if( check_season()== "Summer-Rain" 
	|| check_season()== "Spring-Rain" 
	|| check_season()== "Autumn-Rain" ) {
		new(SOBJ"night-rain")->move(CITY_ROOM"nankou");
		new(SOBJ"night-rain")->move(CITY_ROOM"ximen");
		new(SOBJ"night-rain")->move(CITY_ROOM"dongmen");
		msg = "听说大唐长安城连绵夜雨不断！！！\n" NOR;
		message("system", WHT"\n┋风霜雨雪┋ "+ msg + "\n" NOR, users() );
			log_file( "nature/night_rain", sprintf("[%s][%s]: \n连绵夜雨(深夜)：%s",
				game_time(), log_time(), filter_color(msg) ) );
		}
	}
*/
}
/**************************************************************************************************/

// This is called everyday noon by update_day_phase, defined in the
// "event_fun" field in /adm/etc/nature/day_phase

void event_noon()
{
        object *ob;
        int i, skill;

        ob = users();
        for(i=0; i<sizeof(ob); i++) {
                if( !environment(ob[i]) ) continue;
                if( !environment(ob[i])->query("outdoors") ) continue;
                if( !ob[i]->query("mana") ) continue;
                if( !(skill = ob[i]->query_skill("spells", 1) )) {
                        tell_object(ob[i], "你觉得一阵晕眩，好像有一股能量从身上被人吸走了。\n");
                        ob[i]->set("mana", 0);
                        ob[i]->receive_damage("sen", 0);
                } else if( skill < 25 ) {
                        tell_object(ob[i], "随着太阳升到天空的正中央，你觉得你的法力开始消失了。\n");
                        ob[i]->set("mana", (int)ob[i]->query("mana") * skill / 25 );
                }
        }
}
/**************************************************************************************************/
// Added by kuku@2004/02/25
// 宝石的发布，取消cron里的调用，节省系统资源
void start_baoshi() 
{ 
    object ob;
    object newob;
             
    newob = new(CRON_DIR "baoshi");
    ob = NPC_D->task_npc(); 
    
    reset_eval_cost();

    if (newob->move(ob))
    { 
        CHANNEL_D->do_channel( this_object(), "sys", 
            "宝石落到了" + ob->query("name") + "(" + ob->query("id") + ")的身上。");  
        message_job(HIR"奇珍异宝："HIW"突然空中打了个炸雷，一个火球横空出世，拖着一道神光向"
                    + HIR+ob->query("place") +NOR HIW "的方向落去！"); 

        if (newob->query("b_lvl") > 14)
            message_job( HIR"奇珍异宝：" + newob->name() + "降临凡间！"); 

    } else
    {
        CHANNEL_D->do_channel( this_object(), "sys", "本次宝石发布失败"); 
    }            
    remove_call_out ("start_baoshi");
}
/**************************************************************************************************/
// 室外天气季节的描述
string outdoor_room_description()
{
        string month_desc;
	month_desc =XYJTIME_D->check_month_desc();

	return " " + sprintf( day_phase[current_day_phase]["desc_msg"],
		month_desc )+"";
}

string room_event_fun() { return day_phase[current_day_phase]["event_fun"]; }

// 季节(weather)
string check_weather() { return day_phase[current_day_phase]["weather_msg"]; } 
/**************************************************************************************************/

mapping *read_table(string file)
{
        string *line, *field, *format;
        mapping *data;
        int i, rn, fn;

        line = explode(read_file(file), "\n");
        data = ({});
        for(i=0; i<sizeof(line); i++) {
                if( line[i]=="" || line[i][0]=='#' ) continue;
                if( !pointerp(field) ) {
                        field = explode( line[i], ":" );
                        continue;
                }
                if( !pointerp(format) ) {
                        format = explode( line[i], ":" );
                        continue;
                }
                break;
        }

        for( rn = 0, fn = 0; i<sizeof(line); i++) {
                if( line[i]=="" || line[i][0]=='#' ) continue;
                if( !fn ) data += ({ allocate_mapping(sizeof(field)) });
                sscanf( line[i], format[fn], data[rn][field[fn]] );
                fn = (++fn) % sizeof(field);
                if( !fn ) ++rn;
        }
        return data;
}

mapping *query_day_phase() { return day_phase; }


