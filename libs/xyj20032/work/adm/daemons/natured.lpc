//每天的下午
//事件：收回尚存在的食人妖怪，门派刺客出现
void event_afternoon()
{
        object *ob_list;
        int i;  
        ob_list = children(YAOGUAI);
                for(i=0; i<sizeof(ob_list); i++) 
                if(environment(ob_list[i]))
                {
                message_vision("$N说道：今天吃了不少鲜活人肉,我闪！\n",ob_list[i]);
                        destruct(ob_list[i]);
                }
        if( random(10))  // 不要泛滥
        	CIKE->choose_mpc();       
}

// 每天的清晨,黎明.
// 事件：收回尚存在的傍晚出现的小贼，门派飞贼出现
void event_dawn()
{
        object *ob_list;
        int i;
        ob_list = children(FEIZEI);
                for(i=0; i<sizeof(ob_list); i++) 
                if(environment(ob_list[i]))
                {
                        message_vision("$N笑道：天亮了，东西也到手了，我闪！\n",ob_list[i]);
                        destruct(ob_list[i]);
                }
        if( random(10)==5 )  // 不要泛滥
        	FEIZEI1->choose_npc();       
}

// 事件：连绵夜雨的分布
//       雨季的闪电及季节的更新
void event_midnight()
{
	object badguy;
	object room;
       string get_month, get_day, msg;
	mixed *local;
    local = localtime(TIME_TICK);
	get_month = chinese_number(local[4]+1);
	get_day = chinese_number(local[3]);

	reset_eval_cost();	

/**************************************************************************************************/
	//Added by waiwai@2002/12/05
	switch(get_month) {
		// 初春(springA-？)
		case "三":
		if(get_day=="十九") { // 农历的谷雨 
			msg = HIG "农历的谷雨时节到了，经过了漫长的冬季，万物开始复苏。春天的喜雨开始滋润大地！\n" NOR;
			message("system", HIY"┋"HIR"四季交替"HIY"┋"+ msg + "\n" NOR, users() );
			log_file( "daylog", sprintf("[%s][%s]: \n四季交替 %s",
				game_time(), log_time(), filter_color(msg) ) );
			day_phase = read_table(N_S"springA_rain"); break;
			} else
 		switch(random(3)) {
		case 0:
		day_phase = read_table(N_S"springA_rain");
		// Added by waiwai@2003/01/16 雨季的闪电
		message("system", "\n\t\t不远的高空划过一道闪电。不久后, 传来震耳欲聋的雷声，久久不绝……\n\n", users());
		call_out ("start_baoshi", 3);
		break;
		case 1:
		day_phase = read_table(N_S"springA_sun"); break;
		case 2:
		day_phase = read_table(N_S"springA_wind"); break;
		}
		break;

		// 春季(spring-？)
		case "四":
		if(get_day=="十九") { // 农历的立夏 
			msg = HIG "农历的立夏时节到了，虽然夏天还远，但天气慢慢的变的热了起来！\n" NOR;
			message("system", HIY"┋"HIR"四季交替"HIY"┋"+ msg + "\n" NOR, users() );
			log_file( "daylog", sprintf("[%s][%s]: \n四季交替 %s",
				game_time(), log_time(), filter_color(msg) ) );
			day_phase = read_table(N_S"spring_wind"); break;
			} else
 		switch(random(3)) {
		case 0:
		day_phase = read_table(N_S"spring_rain");
		// Added by waiwai@2003/01/16 雨季的闪电
		message("system", "\n\t\t不远的高空划过一道闪电。不久后, 传来震耳欲聋的雷声，久久不绝……\n\n", users());
		call_out ("start_baoshi", 3);
		break;
		case 1:
		day_phase = read_table(N_S"spring_sun"); break;
		case 2:
		day_phase = read_table(N_S"spring_wind"); break;
		}
		break;

		// 春末(springC-？)
		case "五":
		if(get_day=="五") { // 农历的端午
			msg = HIR"三界神话的端午节到了，唐皇御赐各家百姓金字端午粽子！！！\n" NOR;
			message("system", HIR"┋"HIY"端午佳节"HIR"┋"+ msg + "\n" NOR, users() );
			log_file( "daylog", sprintf("[%s][%s]: \n端午佳节 %s",
				game_time(), log_time(), filter_color(msg) ) );
			day_phase = read_table(N_S"springC_sun"); break;
			} else
 		switch(random(3)) {
		case 0:
		day_phase = read_table(N_S"springC_rain");
		// Added by waiwai@2003/01/16 雨季的闪电
		message("system", "\n\t\t不远的高空划过一道闪电。不久后, 传来震耳欲聋的雷声，久久不绝……\n\n", users());
		call_out ("start_baoshi", 3);
		break;
		case 1:
		day_phase = read_table(N_S"springC_sun"); break;
		case 2:
		day_phase = read_table(N_S"springC_wind"); break;
		}
		break;
	/**********************************************************************************/
		// 初夏(summerA-？)
		case "六":
		if(get_day=="二十二") { // 农历的夏至(应该是5/23这里做阳历算吧) 
			msg = HIR "夏天来临了，天气越来越热，所有的生物都异常活跃。三界神话也呈现出一片繁荣的景象！\n" NOR;
			message("system", HIY"┋"HIR"四季交替"HIY"┋"+ msg + "\n" NOR, users() );
			log_file( "daylog", sprintf("[%s][%s]: \n四季交替 %s",
				game_time(), log_time(), filter_color(msg) ) );
			day_phase = read_table(N_S"summerA_wind"); break;
			} else
		switch(random(3)) {
		case 0:
 		day_phase = read_table(N_S"summerA_rain");
		// Added by waiwai@2003/01/16 雨季的闪电
		message("system", "\n\t\t不远的高空划过一道闪电。不久后, 传来震耳欲聋的雷声，久久不绝……\n\n", users());
		call_out ("start_baoshi", 3);
		break;
		case 1:
		day_phase = read_table(N_S"summerA_sun"); break;
		case 2:
		day_phase = read_table(N_S"summerA_wind"); break;
		}
		break;

		// 盛夏(summer-？)
		case "七":
		if(get_day=="七") { 
			msg = HIR"今天是三界神话牛郎织女每年相会的日子。凄美的故事总是让人难以忘怀！！！\n" NOR;
			message("system", HIR"┋"HIY"牛郎织女"HIR"┋"+ msg + "\n" NOR, users() );
			log_file( "daylog", sprintf("[%s][%s]: \n牛郎织女 %s",
				game_time(), log_time(), filter_color(msg) ) );
			day_phase = read_table(N_S"summer_sun"); break;
			} else
		switch(random(3)) {
		case 0:
 		day_phase = read_table(N_S"summer_rain");
		// Added by waiwai@2003/01/16 雨季的闪电
		message("system", "\n\t\t不远的高空划过一道闪电。不久后, 传来震耳欲聋的雷声，久久不绝……\n\n", users());
		call_out ("start_baoshi", 3);
		break;
		case 1:
		day_phase = read_table(N_S"summer_sun"); break;
		case 2:
		day_phase = read_table(N_S"summer_wind"); break;
		}
		break;

		// 夏末(summerC-？)
		case "八":
		if(get_day=="十五") { // 农历的仲秋
			msg = HIR"三界神话的又一个仲秋佳节来临了，在那月色美丽的夜晚，你是否也同样怀有一颗驿动的心？\n" NOR;
			message("system", HIR"┋"HIY"仲秋佳节"HIR"┋"+ msg + "\n" NOR, users() );
			log_file( "daylog", sprintf("[%s][%s]: \n仲秋佳节 %s",
				game_time(), log_time(), filter_color(msg) ) );
//			TREE2->power_lowtree();
			message("system", HIY"\n┋丹桂飘香┋农家小院的丹桂树的桂花随风飘落，清香随风飘散弥漫了整个长安城。。。\n\n" NOR, users() );
			day_phase = read_table(N_S"summerC_wind"); break;
			} else
		switch(random(3)) {
		case 0:
 		day_phase = read_table(N_S"summerC_rain");
		// Added by waiwai@2003/01/16 雨季的闪电
		message("system", "\n\t\t不远的高空划过一道闪电。不久后, 传来震耳欲聋的雷声，久久不绝……\n\n", users());
		call_out ("start_baoshi", 3);
		break;
