// follow.c
// Modified by kuku@2004/02/24

#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg)
{
        object ob;

        if( !arg ) return notify_fail("指令格式：follow <某人>|none。\n");

        if( arg=="none")
                if( me->query_leader() ) {
                        me->set_leader(0);
                        me->delete_temp("leader");
                        message_vision("$N决定自己单独行动。\n", me);
                        return 1;
                } else {
                        write("你现在并没有跟随任何人。\n");
                        return 1;
                }

        if( !objectp(ob = present(arg, environment(me))) )
                return notify_fail("这里没有 " + arg + "。\n");

        if( !ob->is_character() )
                return notify_fail("什么？跟随...." + ob->name() + "。\n");

        if( ob==me )
                return notify_fail("跟随自己？\n");
                
       //Added By kuku@2004/02/24
      if (userp(me) && !me->query("follow_ok")){
         if (wiz_level(me) < wiz_level(ob))
            return notify_fail(HIW"你不能跟随巫师。\n"NOR);
            }

      //Added By kuku@2004/02/24
	if( me->query_temp("k_bian") )
		return notify_fail(HIC"你已变为非活物，还能跟随他人飞上天啊？\n"NOR);
		
        if (ob == me->query_leader())
         return notify_fail("你已经这样做了。\n");
        if (ob->query_leader()== me)
         return notify_fail("他正跟着你呢。\n");
        me->set_leader(ob);
        me->set_temp("leader",1);
        if( !me->query("env/invisibility") )
		message_vision(YEL"$N"YEL"决定开始跟随$n"YEL"一起行动。\n"NOR, me, ob);
	else
		tell_object(me,WHT"你决定秘密地跟随"+ob->name(1)+WHT"("+ob->query("id")+WHT")一起行动。\n"NOR);
        	tell_object(me, "你决定开始跟随" + ob->name() +"一起行动。\n");
        if (ob->visible(me)) 
                tell_object(ob, me->name() + "决定开始跟随你一起行动。\n");
        return 1;
}

int help (object me)
{
        write(@HELP
指令格式 : follow [<生物>|none]
 
这个指令让你能跟随某人或生物。
如果输入 follow none 则停止跟随。
 
HELP
);
        return 1;
}

