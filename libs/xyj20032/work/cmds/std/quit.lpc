// quit.c
// Modify by mudring@SanJie

#include <mudlib.h>
#include <command.h>
#include <config.h>
#include <ansi.h>

inherit F_DBASE;
inherit XYJTIME_D;
int confirm(string yn, object me);

void create()
{
        seteuid(getuid());
        set("channel_id", "离线指令");
}

int main(object me, string arg)
{
        int i, qt, qt2, B, L, F, D, M;
    object *inv, link_ob;

    link_ob = me->query_temp("link_ob");

    // We might be called on a link_dead player, so check this.
    if (objectp(link_ob))
    {
        // Are we possessing in others body ?
        if (link_ob->is_character())
        {
            write("你的魂魄回到" + link_ob->name(1) + "的身上。\n");
            exec(link_ob, me);
            link_ob->setup();
            link_ob->write_prompt();
            return 1;
        }
        
        if (link_ob->query_temp("last_from"))
        {
            link_ob->set("last_on", time());
            link_ob->set("last_from",
                link_ob->query_temp("last_from"));
        me->add("wkz_quit", 1); 
            link_ob->set("registered",
                me->query("registered"));
            link_ob->save();
        }
        destruct(link_ob);
     }
        if (me->query_temp("no_move"))
        return notify_fail("你被定住了，哪里退得出游戏！\n");

    if (me->is_busy() && ! me->query("doing"))
        return notify_fail("你现在正忙着做其他事，不能退出游戏！\n");

    if (me->is_fighting())
        return notify_fail("你现在正在打架，怎么能说走就走？\n");

    if (me->query("kee") <= 0 || me->query("sen") <= 0)
        return notify_fail("你现在的身体状况不适合离开游戏！\n");

    if (me->is_pker())
        return notify_fail("你刚杀完人就想离开？做事情还是要负责任的！\n");

    if (environment(me)->query("no_quit"))
        return notify_fail("这里不准退出游戏。\n");

    if (me->run_override("quit"))
        return 1;
        
                // 注册时间不足10分钟自动删除档案
    /*    if( arg != "-lovesjsh" && me->query("mud_age") < 600 ) {
         write(CYN"\n你的账号是新建的，本站规定新建账号必须连续在线10分钟才能被有效保留，
退出游戏将删除你的账号(请注意一般的安全区是不会增长你的在线时间的)，
你确定要放弃该帐号而退出吗？(y/n)\n"NOR);
         input_to((: confirm :), me);
         return 1;
      }
   */
    

    

    if (me->query("doing"))
    {
        if (! interactive(me))
            return 1;

        write("你暂时离线，人物不退出...\n");
        message("vision", me->name() + "离线了。\n",
                environment(me), ({ me }));
        me->save();
        link_ob = new(LOGIN_OB);
        exec(link_ob, me);
        destruct(link_ob);
        return 1;
    }

#if INSTALL_EXAMINE
    EXAMINE_D->examine_player(me);
#endif
    me->log_command("quit");

    if (! wizardp(me))
    {
        int flag;
        flag = 0;
        inv = all_inventory(me);
        for (i = 0; i < sizeof(inv); i++)
            if (! inv[i]->query_autoload() && ! inv[i]->query("equipped") && !inv[i]->query("Is_Diablo_Obj"))
                        flag += DROP_CMD->do_drop(me, inv[i], 1);
        if (flag)
            message("vision", me->name() + "将身上的东西都丢了下来。\n",
                    environment(me), ({ me }));
    }

        // Update by kuku@2004/05/01
        me->set("channels",({ })); // 配合logind.c 为了频道安全

        /*******************************************************************************/
        // Added by kuku@2004/04/28  waiwai's old code
        L=me->query("wkz_quit");
        F=me->query("wkzF_quit");
        D=me->query("wkzD_quit");
        B=((int)me->query("login_count")-1);
        qt= L+F+D;
        M= B-qt;
        qt2= qt+M;

        // 以下是简单综合校正
        if( M > qt ) { 
        me->set("wkz_quit",B);
        me->set("wkz_Fquit",0);
        me->set("wkz_Dquit",0);
        }

        if( M < 0 ) { 
        M=M+F+D;
        L=L+M;
        if(M<0) M=0;
        }

        if( qt2 < B ) qt2=B;
        if( qt2 < 0 ) qt2=1;

        if( qt > B ) {
        qt2=B;
        F=0;
        D=0;
        M=0;
        }
        /*******************************************************************************/

        if( !me->query("env/makestart") ) {
        // Added by waiwai@2002/12/05
        write("\n"+log_id(me)+
"这是您第 "+qt2+" 次退出"+INTERMUD_NAME+" 本次上线你的累计游戏时间为："RED+query_time(me->query_temp("temp_time"))+NOR"
────────────────────────────────────────────
离线状态：[正常："+L+"次 发呆："+F+"次 断线："+D+"次 异常："+M+"] 
───────────────────────────────── "YEL"三界神话"NOR" ──────\n");
        write(GRN"[现在北京时间为："+COLOR_D->clean_color(BJTIME_CMD->chinese_time(1,ctime(time())))+"]  本站IP："+MUD_IP+"\n\n"NOR);
        }

        /*******************************************************************************/
    write("欢迎下次再来！\n");

    if (environment(me))
    {
        message("vision", me->name() + "离开游戏。\n",
            environment(me), ({ me }));
    }

    CHANNEL_D->do_channel(this_object(), wiz_level(me)?"wiz":"sys",
            me->name(1) + "(" + me->query("id") + ")离开游戏了，停留时间为："
            + chinese_time(time()-me->query_temp("logon_time")));

    log_file("stat", sprintf("%-8s %-10s %-18s %-18s %-15s.\n",
                             me->name(1), me->query("id"),
                             ctime(me->query_temp("logon_time")),
                             ctime(time()),
                             interactive(me) ? query_ip_number(me) : "unknow"));

    me->save();
    me->end_log();
    destruct(me);

    return 1;
}

int force_quit(object me)
{
        string name;
        object where;
        where = environment(me);

        name=me->query("id");
        
    if (previous_object() != me ||
        ! playerp(me))
        return notify_fail("你不能摧毁这个对象。\n");

    seteuid(getuid());
    
        // Added by waiwai@2003/04/12
        // 避免利用断线保留档案
        if( me->query("mud_age") < 600 ) {
         rm(DATA_DIR + "login/" + name[0..0] + "/" + name + __SAVE_EXTENSION__);
         rm(DATA_DIR + "user/" + name[0..0] + "/" + name + __SAVE_EXTENSION__);
        CHANNEL_D->do_channel(this_object(), "sys", 
        log_id(me)+"在"+MISC_D->find_place(where)+COLOR_D->clean_color(where->query("short"))+
        "异常离线退出，档案被删除。。。\n"NOR);
        NAME_D->remove_name(me->query("name"), me->query("id"));
         write(HIW"由于您登陆不足10分钟而退出三界神话，档案被系统自动删除。。。。。。\n"NOR);
        destruct(me);
        return 1;
        }
        
    CHANNEL_D->do_channel(this_object(), wiz_level(me)?"wiz":"sys",
            me->name(1) + "(" + me->query("id") + ")被系统强制离开了游戏，停留时间为："
            + chinese_time(time()-me->query_temp("logon_time")));

    me->save();
    if (environment(me) != find_object(VOID_OB))
        me->move(VOID_OB, 1);
    destruct(me);
    return 1;
}

int confirm(string yn, object me)
{
        int i,flag=0;
        object *inv, link_ob, where;
        where = environment(me);

        if( upper_case(yn) == "Y" ) {

        link_ob = me->query_temp("link_ob");

        if( !wizardp(me) && ( !link_ob || ( link_ob && !link_ob->is_character()) ) ) {
         inv = all_inventory(me);
        for (i = 0; i < sizeof(inv); i++)
            if (! inv[i]->query_autoload() && ! inv[i]->query("equipped") && !inv[i]->query("Is_Diablo_Obj"))
                        flag += DROP_CMD->do_drop(me, inv[i], 1);
           if (flag)
            message("vision", me->name() + "将身上的东西都丢了下来。\n",
                    environment(me), ({ me }));
//         for( i = 0; i < sizeof(inv); i ++ )
//            if( !inv[i]->query_autoload() ) do_drop(me, inv[i]);
        }

        write(HIW"您选择了放弃账号退出三界神话，档案被删除。。。。。。\n"NOR);

        CHANNEL_D->do_channel(this_object(), "sys", 
        log_id(me)+"在"+MISC_D->find_place(where)+COLOR_D->clean_color(where->query("short"))+
        "放弃帐号离线退出，档案被删除。。。\n"NOR);

        NAME_D->remove_name(me->query("name"), me->query("id"));
        seteuid(getuid());

        rm( link_ob->query_save_file() + __SAVE_EXTENSION__ );
        rm( me->query_save_file() + __SAVE_EXTENSION__ );
        destruct(link_ob);

        destruct(me);
        return 1;
        } else {
        write(CYN"您选择了放弃退出(Quit)，继续游戏。\n"NOR);
        return 1;
        }
}

int help(object me)
{
        write(@HELP
指令格式 : quit

当你想暂时离开时, 可利用此一指令。
HELP
    );
    return 1;
}
