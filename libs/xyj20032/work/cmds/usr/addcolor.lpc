// By Mudring@sjsh

#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  string color;
  int dx;
  object ob = me;

  dx = (int)me->query("daoxing");
  if (!wizardp(me) && dx < 3000000)
    return notify_fail("你的道行还不够给自己的名字增色，加油啊！\n");
  dx /= 3000000;
  if (!wizardp(me) && me->query("color_times")
    && (int)me->query("color_times") > (int)dx - 1)
    return notify_fail("你现在的道行还不够再次改变自己名字的颜色！\n");
  /*      if (!wizardp(me) && me->query("color"))
                return notify_fail("你不是加过颜色了吗？\n");*/
  if (!arg) return notify_fail("你要给名字加什么颜色？\n");
  if (wizardp(me) && sscanf(arg, "%s %s", color, arg) == 2)
    ob = present(color, environment(me));
  if (!ob) return notify_fail("这里没有这个人。\n");

  switch (arg) {
    case "RED": color = RED; break;
    case "GRN": color = GRN; break;
    case "YEL": color = YEL; break;
    case "BLU": color = BLU; break;
    case "MAG": color = MAG; break;
    case "CYN": color = CYN; break;
    case "HIR": color = HIR; break;
    case "HIG": color = HIG; break;
    case "HIY": color = HIY; break;
    case "HIB": color = HIB; break;
    case "HIM": color = HIM; break;
    case "HIC": color = HIC; break;
    case "HIW": color = HIW; break;
    case "NOR": color = NOR; break;
    default:
      return notify_fail("你要给名字加什么颜色？\n");
  }
  ob->set("color", color);
  if (!ob->query("color_times"))
    ob->set("color_times", 1);
  else
    ob->add("color_times", 1);
  write("加好了。\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : addcolor 颜色
 
如果你有三千年道行，那么你可以给你自己响亮的名字加上一个颜色。
以后每增加三千年道行才可以再改变一次名字的颜色！
请注意，假如你已经结婚，您的结婚戒指的颜色将会由你的名字颜色决定！
请选择以下颜色：

RED - 红色              HIR - 亮红色
GRN - 绿色              HIG - 亮绿色
YEL - 土黄色            HIY - 黄色
BLU - 深蓝色            HIB - 蓝色
MAG - 浅紫色            HIM - 粉红色
CYN - 蓝绿色            HIC - 天青色
                        HIW - 白色
HELP);
  return 1;
}
