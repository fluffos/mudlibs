// shengji.c
  
#include <ansi.h>  
  
inherit F_CLEAN_UP;  

int main(object me, string arg)  
{                          
        object *ob_list, *ilist;             // 合并的所有物品                          
        object obj,base;                     // 生成的物品  
        int i,k,j;  
  
        if (! arg )  
                return notify_fail("你要合并什么物品？\n");  
 
        if ( arg=="beast" )  
                return notify_fail("你要合并哪种灵兽？\n");   
        if (me->is_busy())  
                return notify_fail("先忙完了你的事情再做这件事情吧！\n");  
        if (me->is_fighting())  
                return notify_fail("你现在正在打架，没时间做这些事情。\n"); 
        if (!( base=present (arg,me))) 
                return notify_fail("你身上没有这样东西。\n"); 
        if (!base->query("life_points")) 
                return notify_fail("你不能用它创造出新东西。\n"); 
      	i=base->query("life_points");
        if ( i == 300) 
                return notify_fail("已经是最高级别了，不能再升级。\n"); 
        if (me->query("max_sen") < 800)  
                return notify_fail("你现在的精力修为有限，无法施展如此艰深的法力。\n");            
        if (me->query("sen") < 600)  
                return notify_fail("你现在精神不济，无法施展法力。\n");        	
       	ilist = all_inventory(me); 
        if (!ilist) 
                return notify_fail("你身上没有任何物品。\n"); 
        switch (arg) {
        	case "emo shou" :
        		i=100;
       			k=0; 
       			j = sizeof(ilist); 
        		while (j--) { 
                		if( ilist[j]->query("life_points")!=i)
                          		continue;               
              			k++; 
        		} 
        		if(k<=4) 
         			return notify_fail("你的灵兽数量不够，需要五个才可以创造出高级灵兽。\n");  
                        obj=new("/d/quest/newequip/beast/high/mowangshou"); 
      			k=5; 
        		ilist = all_inventory(me); 
         		for (j = 0; j<5; j++) {
             			base=present (arg,me);
                      		destruct(base);
                        }         
			message_vision(MAG "$N" MAG "将几只灵兽摆在一起，默运神通使它们变化。\n" NOR, me);  
        		if(obj->move(me)){ 
        			message_vision(HIG "数道光芒闪过，似乎发生了不同寻常的事情。\n" NOR, me);  
        			tell_object(me, HIC "你利用现有的灵兽创造了" + obj->name() + HIC "！\n" NOR);  
                        }
                        else { 
                    		message_vision(CYN "过了半天，似乎没有任何变化，$N" CYN "一脸悻悻。\n", me);    
                    	}             
        		me->start_busy(4);  
        		me->add("sen", -500);  
        		break;
		case "juling shou" :
        		i=150;
       			k=0; 
       			j = sizeof(ilist); 
        		while (j--) { 
                		if( ilist[j]->query("life_points")!=i)
                          		continue;               
              			k++; 
        		} 
        		if(k<=4) 
         			return notify_fail("你的灵兽数量不够，需要五个才可以创造出高级灵兽！。\n");  
                        obj=new("/d/quest/newequip/beast/high/mowangshou"); 
      			k=5; 
        		ilist = all_inventory(me); 
         		for (j = 0; j<5; j++) {
             			base=present (arg,me);
                      		destruct(base);
                        }         
			message_vision(MAG "$N" MAG "将几只灵兽摆在一起，默运神通使它们变化。\n" NOR, me);  
        		if(obj->move(me)){ 
        			message_vision(HIG "数道光芒闪过，似乎发生了不同寻常的事情。\n" NOR, me);  
        			tell_object(me, HIC "你利用现有的灵兽创造了" + obj->name() + HIC "！\n" NOR);  
                        }
                        else { 
                    		message_vision(CYN "过了半天，似乎没有任何变化，$N" CYN "一脸悻悻。\n", me);    
                    	}             
        		me->start_busy(4);  
        		me->add("sen", -500);  
        		break;
        	case "tianshi shou" :
        		i=200;
       			k=0; 
       			j = sizeof(ilist); 
        		while (j--) { 
                		if( ilist[j]->query("life_points")!=i)
                          		continue;               
              			k++; 
        		} 
        		if(k<=4) 
         			return notify_fail("你的灵兽数量不够，需要五个才可以创造出高级灵兽！。\n");  
                        obj=new("/d/quest/newequip/beast/high/mowangshou"); 
      			k=5; 
        		ilist = all_inventory(me); 
         		for (j = 0; j<5; j++) {
             			base=present (arg,me);
                      		destruct(base);
                        }         
			message_vision(MAG "$N" MAG "将几只灵兽摆在一起，默运神通使它们变化。\n" NOR, me);  
        		if(obj->move(me)){ 
        			message_vision(HIG "数道光芒闪过，似乎发生了不同寻常的事情。\n" NOR, me);  
        			tell_object(me, HIC "你利用现有的灵兽创造了" + obj->name() + HIC "！\n" NOR);  
                        }
                        else { 
                    		message_vision(CYN "过了半天，似乎没有任何变化，$N" CYN "一脸悻悻。\n", me);    
                    	}             
        		me->start_busy(4);  
        		me->add("sen", -500);  
        		break;
        	case "mowang shou" :
        		i=255;
       			k=0; 
       			j = sizeof(ilist); 
        		while (j--) { 
                		if( ilist[j]->query("life_points")!=i)
                          		continue;               
              			k++; 
        		} 
        		if(k<=4) 
         			return notify_fail("你的灵兽数量不够，需要五个才可以创造出高级灵兽！。\n");  
                        obj=new("/d/quest/newequip/beast/high/tianzunshou"); 
      			k=5; 
        		ilist = all_inventory(me); 
         		for (j = 0; j<5; j++) {
             			base=present (arg,me);
                      		destruct(base);
                        }         
			message_vision(MAG "$N" MAG "将几只灵兽摆在一起，默运神通使它们变化。\n" NOR, me);  
        		if(obj->move(me)){ 
        			message_vision(HIG "数道光芒闪过，似乎发生了不同寻常的事情。\n" NOR, me);  
        			tell_object(me, HIC "你利用现有的灵兽创造了" + obj->name() + HIC "！\n" NOR);  
                        }
                        else { 
                    		message_vision(CYN "过了半天，似乎没有任何变化，$N" CYN "一脸悻悻。\n", me);    
                    	}             
        		me->start_busy(4);  
        		me->add("sen", -500);  
        		break;
        	default : 
                        tell_object(me,"命令格式combin xxx(灵兽ID)\n"); 
                        return 1; 
	}       	
	return 1;          
}  
  
int help(object me)  
{  
write(@HELP  
指令格式 : shengji <特殊物品>  
  
这个指令可以让你将低等级的灵兽升级，第四级灵兽只能用前三个等级的灵兽
升级，并且必须是同一类型，数量五个。最高等级的灵兽（等级五）只能用第四
级的灵兽升级，数量五个。比如身上现有五个恶魔兽，如果要升级，需要输入： 
  
shengji emo shou 

HELP  
    );  
    return 1;  
}  
