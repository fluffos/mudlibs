// Room: /u/mudring/workroom.c

#include <ansi.h>
inherit ROOM;

#define ANSIA WHT
#define ANSIB YEL
#define ANSIC HIR
#define ANSID CYN

string room_long();
string look_gaoshi();
string day_event() {return NATURE_D->outdoor_room_event();} 

void create ()
{
        set ("short","Ice Wind");
        set("long", (:room_long:));

        set("exits", ([ //
                "north" : "/adm/npc/wizroom",
                "down" : "/d/city/kezhan",
                "west" : "/d/wiz/meeting",
                "east" : "/obj/empty",
        ]));
/*
        set("objects", ([ //
                "/d/wizz/mudring/npc/parrot":1,
                "/d/wizz/mudring/npc/fly":1,
        ]));
*/
        set("item_desc", ([ //
                "gaoshi" : (:look_gaoshi:),
        ]));
        set("doing", 1);
        set("no_fight", 1);
        set("valid_startroom", 1);
        set("sleep_room", 1);
        set("if_bed", 1);
         set("outdoors", 1);
        setup();
}

void init()
{
        add_action("say_log",({ "say","'"}));
        if (this_player()->query("id") != "mudring")
                message_vision("$N偷偷溜了过来。\n", this_player());
//      if (this_player()->query("id") == "axj" || this_player()->query("id") == "xianzi") message_vision("风铃轻轻地捧起$N的脸，给了$N一个无限温柔的吻。！。\n", this_player());
        if (this_player()->query("id") == "mudring" )
                tell_object(this_player(),BLINK HIR"\n\n\t\t心胸应该象草原一样辽阔\n\n"NOR);
/*
        else
                message_vision("四周响起一片“打倒"+this_player()->name(1)+"”的口号声，$N假装没听见。\n", this_player());
*/
}

int clean_up()
{
        return 0;
}

void reset()
{
/*
        tell_room(this_object(), BLINK+HIR"Reset.\n"NOR);
*/
        tell_room(this_object(),COLOR_D->random_jjww() + "我心何在？\n"NOR);
/*
message("channel:chat",
HIC"〖"HIG"谈天说地"HIC"〗失去？来过(Mudring)："HIW"招募新巫师 "HIG"<本站玩家> "HIR"help wiz_apply .\n"NOR, users());
*/
        ::reset();
}

int say_log(string msg)
{
        object me = this_player();
        if( !msg ) return 0;
        else
        "/cmds/std/say.lpc"->main(me, msg);
        MONITOR_D->mudring_log("wizsay", me, msg, 1);
        return 1;
}

