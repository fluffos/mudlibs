int do_vendor_list(string arg) {
  mapping goods;
  string list, *name;
  int i;
  string tlist;

  if (!mapp(goods = query("vendor_goods"))) return 0;
  if (arg && !this_object()->id(arg)) return 0;
  name = keys(goods);
  list = this_object()->query("name") + "(" + this_object()->query("id") + ")" + "处现货销售下列商品，概不赊帐: \n" NOR;
  list += "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n";
  list += "[名      称]                              [单 位]   [单 价]\n";
  list += "──────────────────────────────────────\n";
  for (i = 0; i < sizeof(name); i++) {
    tlist = sprintf("%s(%s)",
      filter_color(goods[name[i]]->query("name")), goods[name[i]]->query("id"));
    if (goods[name[i]]->query("base_unit"))
      list += sprintf("%-40s → 每%s     %s \n",
        tlist, goods[name[i]]->query("base_unit"),
        MONEY_D->price_str(goods[name[i]]->query("base_value")));
    else
      list += sprintf("%-40s → 每%s     %s \n", tlist, goods[name[i]]->query("unit"),
        MONEY_D->price_str(goods[name[i]]->query("value")));
  }
  list += "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n";
  list += "注:你可以用 buy 数量 名称  from ID 来购买物品.\n\n";
  write(list);
  return 1;
}
