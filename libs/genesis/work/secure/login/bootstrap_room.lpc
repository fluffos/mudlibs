/*
 * /secure/login/bootstrap_room.c
 *
 * FluffOS PORT NOTE: this file never existed upstream. This repo ships
 * no /d/Genesis domain at all (see the note at the top of
 * config/sys/local.h), so none of the real starting rooms this mudlib
 * expects (WIZ_ROOM, RACESTART's per-race entries, DEFAULT_START, ...)
 * exist -- every one of them is a genuine, undecidable content gap
 * (this project's standing rule is to fix real compile/driver-compat
 * bugs, never invent narrative/world content).
 *
 * But std/player.lpc's own login fallback chain (query_def_start() and
 * friends) already anticipates "no valid start room" as a real
 * possibility and degrades gracefully for it -- for a MORTAL, by
 * printing an explanatory message and destruct()ing the character
 * (see std/player.lpc:872-880) *before* the very first save_me() call
 * ever runs, which made it impossible to register any character
 * (including this project's own "fluffos" admin/test account, per
 * this project's standard admin-seeding convention) at all: there was
 * no way to reach a first successful save to seed wizard rank onto
 * afterward, and no way to observe a WIZARD's login (who skip the
 * destructive path but still land with no environment at all) either.
 *
 * This is a deliberately bare, purely-functional landing room -- pure
 * bootstrap infrastructure to unblock login/testing, not a piece of
 * game content -- serving as WIZ_ROOM and every RACESTART entry (see
 * config/sys/local.h and secure/auto.h).
 */

#pragma save_binary
#pragma strict_types

inherit "/std/room";

#include <stdproperties.h>

void
create_room()
{
    set_short("a bare landing room");
    set_long("This is a deliberately bare landing room. It exists only " +
        "because this mudlib's real starting rooms are missing " +
        "content (see the FluffOS port note at the top of this " +
        "file's source) -- it is not meant to represent anything in " +
        "the game world.\n");
    add_prop(ROOM_I_INSIDE, 1);
    add_prop(ROOM_I_LIGHT, 1);
}
