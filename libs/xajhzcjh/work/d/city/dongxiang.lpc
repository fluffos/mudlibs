inherit ROOM;
void create() {
  //房间名称叙述
  set("short", "财主东厢");
  set("long", @LONG
这是一个昏暗的房间，窗户都被钉死。地上放着皮鞭、木棍等刑具，显然
这是财主私立公堂，折磨仆人、丫鬟的所在。一个丫鬟被绳子绑着，浑身赤裸跪在
地上哭哭啼啼，身上是一道道的伤口。
LONG
  );
  //房间出口	
  set("exits", ([
    "west": __DIR__ "houyuan",
  ]));
  //房间物品人物	
  set("objects", ([
    __DIR__ "npc/yahuan": 1,
  ]));
  setup();
}
