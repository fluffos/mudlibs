// cloth.c
//
// This is the basic equip for players just login.
// AGENTS.md content-gap note: this file was missing entirely from the raw
// archive (d/city/obj/ only shipped box/gourou/jitui/table/zhubang.lpc),
// even though 47 NPC files across many different zones hardcode
// carry_object("/d/city/obj/cloth") as their standard starting garment --
// restored verbatim from the byte-identical sibling template that DOES
// exist in this lib (d/city/npc/obj/cloth.lpc, d/village/npc/obj/cloth.lpc,
// d/tangmen/obj/cloth.lpc, etc. all share this exact same boilerplate), not
// fabricated new content.
#include <armor.h>
inherit CLOTH;
void create() {
  set_name("布衣", ({ "cloth" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "cloth");
    set("armor_prop/armor", 1);
  }
  setup();
}
int query_autoload() { return 1; }
