#include <room.h>
inherit ROOM;
string look_sign(object me);
void create() {
  //房间名称叙述
  set("short", "赌场");
  set("long", @LONG
你现在正站在赌场里，靠近门口的地方有一块乌木雕成的招牌(sign)。
LONG
  );
  set("item_desc", ([
    "sign": (: look_sign :),
  ]));
  //房间出口   
  set("exits", ([
    "east": __DIR__ "duchang",
  ]));
  //房间物品人物
  set("objects", ([
    __DIR__ "npc/judge": 1,
  ]));
  setup();
}
string look_sign(object me) {
  return "赌：胜者赢双。\n";
}
