#include <room.h>//设置门开关DOOR_CLOSED时需要的
inherit ROOM;
void create() {
  //房间名称叙述
  set("short", "兵器库");
  set("long", @LONG
这里是兵器库，到处银光闪闪，让人眼花缭乱。宝刀、宝剑、金箍棒，大
刀、长剑、哨棒，短刀、短剑、短棍，各色各样的兵器应有尽有，你一时不知道挑
什么好。
LONG
  );
  //房间出口
  set("exits", ([
    "north": __DIR__ "bingyin",
  ]));
  //设置一个门	
  create_door("north", "铁门", "south", DOOR_CLOSED);  //注意此处需要放房间出口后面
  setup();
}
