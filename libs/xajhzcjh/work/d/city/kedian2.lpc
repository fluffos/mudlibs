inherit ROOM;
void create() {
  //房间名称叙述
  set("short", "客店二楼");
  set("long", @LONG
	你正走在客店二楼的走廊上，可以听到从客房里不时地呼呼
的打酣声，一阵高过一阵。不时有睡意朦胧的旅客进进出出，到楼下
的掌柜处付了钱再上来睡觉。
LONG);
  //房间出口
  set("exits", ([
    "down": __DIR__ "kedian",
    "enter": __DIR__ "kedian3",
  ]));
  //房间物品人物	
  set("objects", ([
    CLASS_D("shaolin") + "/xingzhe": 1,
  ]));
  setup();
  replace_program(ROOM);
}
