#include <room.h>//设置门开关DOOR_CLOSED时需要的
inherit ROOM;
void create() {
  //房间名称叙述
  set("short", "东厂暗道");
  set("long", @LONG
这是一条暗道，是专为鳌拜从鳌府直接到东厂用的。
南边是一扇木门(door)。
LONG);
  set("item_desc", ([
    "door": "这是一扇极厚的木门。\n",
  ]));
  //房间出口	
  set("exits", ([
    "south": __DIR__ "aobai6",
    "northeast": __DIR__ "aobai11",
  ]));
  //设置一个门
  create_door("south", "木门", "north", DOOR_CLOSED);
  setup();
}
