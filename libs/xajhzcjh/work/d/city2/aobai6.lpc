#include <room.h>//设置门开关DOOR_CLOSED时需要的
inherit ROOM;
void create() {
  //房间名称叙述
  set("short", "鳌拜卧房");
  set("long", @LONG
	这是鳌拜的卧房。鳌拜躺在床上睡着了，粗声粗气地打着呼噜。
北边有一扇门(door)。
LONG);
  //房间属性
  set("item_desc", ([
    "door": "这是一扇极厚的木门。\n",
  ]));
  //房间出口	
  set("exits", ([
    "east": __DIR__ "aobai4",
    "north": __DIR__ "aobai10",
  ]));
  //房间物品人物
  set("objects", ([
    __DIR__ "npc/aobai": 1,
  ]));
  //设置一个门	
  create_door("north", "木门", "south", DOOR_CLOSED);
  setup();
}
