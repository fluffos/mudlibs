inherit ROOM;
void create() {
  //房间名称叙述
  set("short", "鳌府厨房");
  set("long", @LONG
一进门，一股香气扑鼻而来，熏得你直流口水。灶台上满是油烟，
一个肥肥胖胖的家伙正在炒菜,一看就象个大厨师。
LONG);
  //房间出口
  set("exits", ([
    "south": __DIR__ "aobai3",
  ]));
  //房间物品人物
  set("objects", ([
    __DIR__ "npc/chushi": 1,
  ]));
  setup();
}
