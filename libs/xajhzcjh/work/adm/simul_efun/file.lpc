// file.c
// AGENTS.md #6.5: forward declaration -- assure_file() is defined further
// down in this same file, but this driver requires a prototype (or
// preceding definition) for any function called before its own textual
// definition within the same compilation unit.
void assure_file(string file);
void cat(string file) {
  if (file_size(file) > 8192)
    write("\n文件太长，请用more指令！\n\n");
  else
    write(read_file(file));
}
void log_file(string file, string text) {
  // AGENTS.md #7.11: file may include a subdirectory under LOG_DIR
  // (e.g. "login/newid.log") that doesn't exist in a fresh work/ tree --
  // write_file() throws "No such file or directory" uncaught in that case,
  // silently aborting whichever daemon function called log_file() (this hit
  // every single new-character registration via get_gender()'s unguarded
  // log_file("login/newid.log", ...), which meant the rest of that
  // function -- including the enter_world() call -- never ran: no banner,
  // no working commands, no save).
  assure_file(LOG_DIR + file);
  write_file(LOG_DIR + file, text);
}
void assure_file(string file) {
  string path, *dir;
  int i;
  if (file_size(file) != -1) return;
  seteuid(ROOT_UID);
  dir = explode(file, "/");
  dir = dir[0..sizeof(dir) - 2];
  path = "/";
  for (i = 0; i < sizeof(dir); i++) {
    path += dir[i];
    mkdir(path);
    path += "/";
  }
}
string base_name(object ob) {
  string file;
  if (sscanf(file_name(ob), "%s#%*d", file) == 2)
    return file;
  else
    return file_name(ob);
}
