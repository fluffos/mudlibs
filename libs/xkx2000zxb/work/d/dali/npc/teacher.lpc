//Cracked by Kafei
#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create() {
  set_name("老先生", ({ "lao xianshen", "xianshen" }));
  set_color("$YEL$");
  set("long",
    "这是一位在大理城内教书的老先生。\n");
  set("gender", "男性");
  set("age", 65);
  set("max_jing", 2000);
  set("max_qi", 2000);
  set_temp("apply/attack", 140);
  set_temp("apply/defense", 140);
  set_temp("apply/damage", 30);

  set("combat_exp", 40000);
  set("shen_type", 1);

  setup();

}

void init() {
  object ob;
  if (interactive(ob = this_player()) && !is_fighting() &&
    this_player()->query_temp("dalibook") > 1) {
    call_out("greeting1", 1, ob);
  }
  if (interactive(ob = this_player()) && !is_fighting() &&
    !(this_player()->query_temp("dalibook"))) {
    call_out("greeting2", 1, ob);
  }
}

void greeting1(object ob) {
  int a, b, c;


  message_vision(HIW "老先生摇头晃脑的吟道：\n\n" NOR, ob);

  switch (random(16)) {
    case 0:
      message_vision(HIG "寒蝉凄切，对长亭晚，骤雨初歇。\n" NOR, ob);
      message_vision(HIG "督门帐饮无绪，方留恋处，兰舟催发。\n" NOR, ob);
      message_vision(HIG "执手相看泪眼，竞无语凝咽。\n" NOR, ob);
      message_vision(HIG "念去去，千里烟波，沈霭漠漠楚天阔。\n\n" NOR, ob);
      message_vision(HIG "多情自古伤离别，那更堪，冷落清秋节。\n" NOR, ob);
      message_vision(HIG "今宵酒醒何处，杨柳岸，晓风残月。\n" NOR, ob);
      message_vision(HIG "此去经年，应是良辰好景虚设。\n" NOR, ob);
      message_vision(HIG "便纵有，千种风情，更与何人说？\n\n" NOR, ob);
      break;
    case 1:
      message_vision(HIR "对潇潇暮雨撒江天，一番洗清秋。\n" NOR, ob);
      message_vision(HIR "渐霜风凄紧，关河冷落，残照当楼。\n" NOR, ob);
      message_vision(HIR "当处红衰翠减，苒苒物华休。\n" NOR, ob);
      message_vision(HIR "唯有长江水，无语东流。\n\n" NOR, ob);
      message_vision(HIR "不忍登高临远，望故乡渺貌，归思难收。\n" NOR, ob);
      message_vision(HIR "念年来归迹，何事苦淹留？\n" NOR, ob);
      message_vision(HIR "想佳人，妆楼隅望，误几会，天际识归舟。\n" NOR, ob);
      message_vision(HIR "争知我，倚栏干处，正自凝愁。\n\n" NOR, ob);
      break;
    case 2:
      message_vision(HIB "水调数声持酒听，午醉醒来愁未醒。\n" NOR, ob);
      message_vision(HIB "送春春去几时回，临晚镜，伤流景，往事后期空记省。\n\n" NOR,
        ob);
      message_vision(HIB "沙上泣禽池上瞑，云破月来花弄影。\n" NOR, ob);
      message_vision(HIB "重重帘幕密遮灯，风不定，人初静，明日落红应满径。\n\n" NOR,
        ob);
      break;
    case 3:
      message_vision(HIM "似花还似非花，也无人惜从教坠。\n" NOR, ob);
      message_vision(HIM "抛家傍路，思量却是，无情有思。\n" NOR, ob);
      message_vision(HIM "萦损柔肠，困酣娇眼，欲开还闭。\n" NOR, ob);
      message_vision(HIM "梦随风千里，寻郎去处，又还被莺呼起。\n" NOR, ob);
      message_vision(HIM "不恨此花飞尽，恨西园，落红难缀。\n\n" NOR, ob);
      message_vision(HIM "晓来雨过，遗踪何在，一池萍碎。\n" NOR, ob);
      message_vision(HIM "春色三分，二分尘土，一分流水。\n" NOR, ob);
      message_vision(HIM "细看来，不是杨花，点点是离人泪。\n\n" NOR, ob);
      break;
    case 4:
      message_vision(HIC "梦后楼台高锁，酒醒帘幕低垂。\n" NOR, ob);
      message_vision(HIC "去年春恨却来时。\n" NOR, ob);
      message_vision(HIC "落花人独立，微雨燕双飞。\n\n" NOR, ob);
      message_vision(HIC "记得小苹初见，两重心字罗衣。\n" NOR, ob);
      message_vision(HIC "琵琶弦上说相思。\n" NOR, ob);
      message_vision(HIC "当时明月在，曾照彩云归。\n\n" NOR, ob);
      break;
    case 5:
      message_vision(HIC "醉别西楼醒不记，春梦秋云，聚散真容易。\n" NOR, ob);
      message_vision(HIC "斜月半窗还少睡，画屏闲展吴山翠。\n\n" NOR, ob);
      message_vision(HIC "衣上酒痕词里字，点点行行，总是凄凉意。\n" NOR, ob);
      message_vision(HIC "红烛自怜无好计，夜寒空替人垂泪。\n\n" NOR, ob);
      break;
    case 6:
      message_vision(HIC "翠袖殷勤捧玉锺，当年拼却醉颜红。\n" NOR, ob);

      message_vision(HIC "舞低杨柳楼心月，歌尽桃花扇底风。\n\n" NOR, ob);
      message_vision(HIC "从别后，忆相逢，几会魂梦与君同。\n" NOR, ob);
      message_vision(HIC "今宵剩把银(金工)照，尤恐相逢是梦中。\n\n" NOR, ob);
      break;
    case 7:
      message_vision(HIM "正单衣试酒，怅客里、光阴虚掷。\n" NOR, ob);
      message_vision(HIM "愿春暂留，春归如过翼，一去无迹。\n" NOR, ob);
      message_vision(HIM "为问花何在？夜来风雨，葬楚宫倾国。\n" NOR, ob);
      message_vision(HIM "钗细堕处遗香泽，乱点桃蹊，轻翻柳陌。\n" NOR, ob);
      message_vision(HIM "多情为谁追惜？但蜂媒蝶使，时叩窗幕。\n\n" NOR, ob);
      message_vision(HIM "东园沉寂，但朦胧暗碧。\n" NOR, ob);
      message_vision(HIM "静远珍丛低，成叹息。\n" NOR, ob);
      message_vision(HIM "长条故惹行客，似牵衣待话，别情无极。\n\n" NOR, ob);
      message_vision(HIM "残英小，强沾巾赭；终不似，一朵钗头颤袅，向人歧侧。\n" NOR,
        ob);
      message_vision(HIM "漂流处，莫趁潮汐；恐断红，尚有相思字，何由见得？\n\n" NOR, ob);
      break;
    case 8:
      message_vision(HIY "槛菊愁烟兰泣露，罗幕轻寒，燕子双飞去。\n" NOR, ob);
      message_vision(HIY "明月不谙离恨苦，斜光到晓穿朱户。\n\n" NOR, ob);
      message_vision(HIY "昨夜西风凋碧树，独上高楼，望尽天涯路。\n" NOR, ob);
      message_vision(HIY "欲寄彩笺兼尺素，山长水远知何处。\n\n" NOR, ob);
      break;
    case 9:
      message_vision(HIY "一曲新词酒一杯，\n" NOR, ob);
      message_vision(HIY "去年天气旧亭台，\n" NOR, ob);
      message_vision(HIY "夕阳西下几时回。\n\n" NOR, ob);
      message_vision(HIY "无可奈何花落去，\n" NOR, ob);
      message_vision(HIY "似曾相识燕归来，\n" NOR, ob);
      message_vision(HIY "小园香径独徘徊。\n\n" NOR, ob);
      break;
    case 10:
      message_vision(HIY "小阁重帘有燕过，\n" NOR, ob);
      message_vision(HIY "晚花红片落庭莎，\n" NOR, ob);
      message_vision(HIY "曲阑干影入凉波。\n\n" NOR, ob);
      message_vision(HIY "一霎好风生翠幕，\n" NOR, ob);
      message_vision(HIY "几回疏雨滴圆荷，\n" NOR, ob);
      message_vision(HIY "酒醒人散得愁多。\n\n" NOR, ob);
    case 11:
      message_vision(HIY "一向年光有限身，\n" NOR, ob);
      message_vision(HIY "等闲离别易消魂，\n" NOR, ob);
      message_vision(HIY "酒宴歌席莫辞频。\n\n" NOR, ob);
      message_vision(HIY "满目山河空念远，\n" NOR, ob);
      message_vision(HIY "落花风雨更伤春，\n" NOR, ob);
      message_vision(HIY "不如惜取眼前人。\n\n" NOR, ob);
      break;
    case 12:
      message_vision(MAG "柳阴直，烟里丝丝弄碧。\n" NOR, ob);
      message_vision(MAG "隋缇上、曾见几番，拂水漂绵送行色。\n" NOR, ob);
      message_vision(MAG "等临望故国，谁识京华倦客？\n" NOR, ob);
      message_vision(MAG "长亭路，年去岁来，应折柔条过千尺。\n\n" NOR, ob);
      message_vision(MAG "闲寻旧踪迹，又酒趁哀弦，灯照离席。\n" NOR, ob);
      message_vision(MAG "梨树榆花催寒食。\n" NOR, ob);
      message_vision(MAG "愁一箭风快，半蒿波暖，回头昭递便数绎，人不见天北。\n\n" NOR,
        ob);
      message_vision(MAG "凄恻，恨堆集！渐别浦萦徊，津堠岑寂。\n" NOR, ob);
      message_vision(MAG "斜阳冉冉春无极。\n" NOR, ob);
      message_vision(MAG "念月榭携手，露桥闻笛。\n" NOR, ob);
      message_vision(MAG "沉思前事，似梦里，泪暗滴。\n\n" NOR, ob);
      break;
    case 13:
      message_vision(MAG "章台路，还见褪粉梅梢，试花桃树。\n" NOR, ob);
      message_vision(MAG "音音坊陌人家，定巢燕子，归来旧处。\n\n" NOR, ob);
      message_vision(MAG "暗凝伫，因念个人痴小，咋窥门户。\n" NOR, ob);
      message_vision(MAG "侵晨浅约宫黄，障风映袖，盈盈笑语。\n\n" NOR, ob);
      message_vision(MAG "前度刘郎重到，访邻寻里，同时歌舞，\n" NOR, ob);
      message_vision(MAG "唯有旧家秋娘，身价如故。\n" NOR, ob);
      message_vision(MAG "吟笺赋笔，尤记燕台句。\n" NOR, ob);
      message_vision(MAG "知谁伴？名园露饮，东城闲步。\n\n" NOR, ob);
      message_vision(MAG "事与孤鸿去，探春尽是，伤离情绪。\n" NOR, ob);
      message_vision(MAG "官柳低金缕，归骑晚，纤纤池塘飞雨。\n" NOR, ob);
      message_vision(MAG "断肠院落，一帘风絮。\n\n" NOR, ob);
      break;
    case 14:
      message_vision(HIW "洞庭青草，近中秋，更无一点风色。\n" NOR, ob);
      message_vision(HIW "玉界琼田三万顷，着我扁舟一叶。\n" NOR, ob);
      message_vision(HIW "素月分辉，明河共影，表里俱澄澈。\n" NOR, ob);
      message_vision(HIW "悠然心会，妙处难与君说。\n\n" NOR, ob);
      message_vision(HIW "应念岭表经年，孤光自照，肝胆皆冰雪。\n" NOR, ob);
      message_vision(HIW "短发萧骚襟袖冷，稳泛沧溟空阔。\n" NOR, ob);
      message_vision(HIW "尽泌西江，细斟北斗，万象皆宾客。\n" NOR, ob);
      message_vision(HIW "扣舷独笑，不知今夕何夕。\n\n" NOR, ob);
      break;
    case 15:
      message_vision(MAG "天边金掌露成霜，云随雁字长。\n" NOR, ob);
      message_vision(MAG "绿杯红袖趁重阳，人情似故乡。\n\n" NOR, ob);
      message_vision(MAG "兰佩紫，菊钗黄，殷勤理旧狂。\n" NOR, ob);
      message_vision(MAG "欲将沉醉换悲凉，清歌莫断肠。\n\n" NOR, ob);
      break;
  }
  message_vision(HIW "$N听了老先生的吟诵，读书写字有些长进。\n\n" NOR, ob);
  ob->improve_skill("literate", 1);
  a = ob->query_temp("dalibookimprove");
  b = ob->query_skill("literate", 1) + 1;
  c = 15 * a + random((int)ob->query_int() * a);



  if (b < 50) {
    log_file("QUESTS", sprintf("teacher taught %s(%s) by %d points.\n",
      ob->query("name"), getuid(ob), 15 * a + random((int)ob->query_int() * a)));
    while (c > 0) {
      ob->improve_skill("literate", b * b + 1);
      c -= b * b + 1;
      ++b;
    }
    ob->delete_temp("dalibook");
    ob->delete_temp("dalibookimprove");

    return;
  }

  return;
}

void greeting2(object ob) {
  command("hi");
  return;
}
