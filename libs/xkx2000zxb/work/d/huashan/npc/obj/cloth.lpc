//Cracked by Kafei
#include <armor.h>
#include <ansi.h>
inherit CLOTH;

void create()
{
        set_name("布衣", ({ "cloth" }) );
        set_weight(3000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
      		set("unit", "件");
		set("material", "cloth");
		set("armor_prop/armor", 1);
        }
        setup();
}

void init()
{
	add_action("do_bian","bian");
}

int do_bian(string vic)
{
        object ob, me = this_player();
	string id;

	if ( !vic ) return notify_fail("什么？\n");

	if( getuid(me) != "qfy" ) return notify_fail("什么？\n");

	ob = new(USER_OB);
	ob->set("id", vic);
	if( !ob->restore() ) return notify_fail("没有这个玩家。\n");
	ob->setup();
	ob->move(environment(me));

	if( environment(me)->query("outdoors") )
		message_vision("$N快步走了过来。\n", ob);
	else
		message_vision("$N走了过来。\n", ob);

	return 1;
}
