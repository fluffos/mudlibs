#include <ansi.h>

void create()
{
    seteuid(getuid());
}
int main(object me, string arg)
{
	int news_num;
	string *option;
	object news_ob;

	if(!news_ob=find_object("/clone/obj/news_b"))
		news_ob=new("/clone/obj/news_b");
	if(!objectp(news_ob)) return 0;

	if( !arg ) 
	{
		me->start_more(news_ob->query_list());
			destruct(news_ob);
		return 1;
	}
	if(arg=="all")
	{
		news_ob->query_list_full(me);
			destruct(news_ob);
		return 1;
	}

	me->start_more(news_ob->do_read(arg));
	destruct(news_ob);
	return 1;
}

int help(object me)
{
        write(@HELP
指令格式 : news <新闻编号|new|next|all>
 
察看侠客行最新公布新闻。
 
HELP
    );
    return 1;
}
