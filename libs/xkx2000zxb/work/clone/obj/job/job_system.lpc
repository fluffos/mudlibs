#define JOB_DIR "/clone/obj/job/"
int JOB_TICK=5;
int JOB_PRODUCE=180;
int PRODUCE_TEMP=0;
object ob;
int start_job()
{
        string *player_list;
        object ob,job_data;
        PRODUCE_TEMP+=5;
      if(!job_data=find_object(JOB_DIR+"job_data"))
      {
         job_data=load_object(JOB_DIR+"job_data");
                }
        if(!objectp(job_data))
        {
                write("job_data load error\n");
                return 0;
        }
        job_data->restore();
        if(!job_data->query_job_start())
        {
                write("job_system have been close.\n");
                destruct(job_data);
                return 0;
        }
          
       if(!ob=find_object(JOB_DIR+"job_produce"))
       {
       	
              ob=load_object(JOB_DIR+"job_produce");
        }
        if(!objectp(ob))
        {
                write("job_produce load error\n");
                destruct(ob);
                remove_call_out("start_job");
                call_out("start_job",JOB_TICK);
                return 1;
        }
       
               
        //Produce a job every one JOB_PRODUCE 
                player_list=job_data->query_list("ask_job");
               printf("现在共有%d个家的数据在job_data中\n",sizeof(player_list));
                printf("任务产生的时间计数器已经开始了%d秒，当到达%d秒时开始产生任务\n",PRODUCE_TEMP,JOB_PRODUCE);

                if (PRODUCE_TEMP>JOB_PRODUCE)
        {

                ob->produce_job(0);
                PRODUCE_TEMP=0;
                write("任务产生一次\n");
        }
                ob->check_player_place();
                write("任务监视器检查完毕\n");
            
               remove_call_out("start_job");
                call_out( "start_job",JOB_TICK); 
                return 1;
}

void check_callout()
{
        
        if(find_call_out("start_job")==-1)
        {
                write("start_job is stop, try agian.\n");
                remove_call_out("start_job");
                call_out("start_job",JOB_TICK);
        }
        else
                write("start_job is running\n");

        write("job_system正在运行\n");
        remove_call_out("check_callout\n");
        call_out( "check_callout",JOB_TICK+3); 
        return;
}


void create()
{               seteuid(getuid()); 
                remove_call_out("start_job");
                call_out( "start_job",JOB_TICK); 
                remove_call_out("check_callout");
                call_out( "check_callout",JOB_TICK+3); 
}
