//Cracked by Kafei

#include "mingjiao_npc.lpc"
#include <ansi.h>

int auto_perform();
string get_room();
int heal_move();
void do_suck(object);
int suck_player();

void create() {
  mapping S_skills = ([]);
  mapping I_inquiry = ([]);
  mixed Skill_name;
  set_name("韦一笑", ({ "wei yixiao", "wei" }));
  set("title", "明教护教法王");
  set("nickname", HIB "青翼蝠王" NOR);

  set("long", "
这就是明教护教法王之一的青翼蝠王。他身披青条子白色长袍，身材高
瘦，脸色略为苍白。此人轻功极高，当世无匹。\n");
  set("gender", "男性");
  set("age", 40);
  set("attitude", "peaceful");
  set("shen", -2000000);
  create_family("明教", 35, "法王");

  I_inquiry["name"] = "在下就是明教护教法王韦一笑，不知阁下有何指教。";
  /*
	Skill_name=({"shenghuo-xuanming","qingfu-shenfa","hanbing-mianzhang",
		     "bagua-dao","riyue-shenzhang","shenghuo-quan","guangming-xinfa"});

	Set_Inquiry(I_inquiry,Skill_name);
*/
  Set_Npcattrib(27, 5, 5000, 500, 9000, 900, 9000, 1000, 6000, 1000, 3000000, 500000);

  set("dex", 40);

  S_skills["force"] = "shenghuo-xuanming";
  S_skills["dodge"] = "qingfu-shenfa";
  S_skills["parry"] = "hanbing-mianzhang";
  //	S_skills["blade"]="bagua-dao";
  S_skills["strike"] = "hanbing-mianzhang";
  //	S_skills["cuff"]="shenghuo-quan";
  //	set_skill("riyue-shenzhang",200+random(20));
  //	set_skill("guangming-xinfa",200+random(20));
  set_skill("literate", 200 + random(20));

  Set_Npcskills(300, 20, S_skills);
  set_skill("dodge", 400 + random(20));  // high dodge for wei.

  prepare_skill("strike", "hanbing-mianzhang");

  set("chat_chance", 50);
  set("chat_msg", ({
    (: suck_player :),
    (: heal_move :),
  }));
  set("chat_chance_combat", 70);
  set("chat_msg_combat", ({
    (: auto_perform :),
  }));

  if (sizeof(children(base_name(this_object()) + ".lpc")) > 2) {
    remove_call_out("dest_me");
    call_out("dest_me", 1, this_object());
  }

  setup();

  set("max_qi", 7000);
  set("eff_qi", 7000);
  set("qi", 7000);
  set("max_jingli", 9000);
  set("eff_jingli", 9000);
  set("jingli", 9000);
  set("jiali", 0);

  set("do_move", 1);
  set("target", 0);

  carry_object("/d/kunlun/obj/changpao")->wear();
}

void init() {
  ::init();
  set_heart_beat(1);
}

int auto_perform() {
  object me = this_object();
  object target = me->select_opponent();
  object weapon = me->query_temp("weapon");

  if (me->is_fighting()) {
    if (me->query("eff_qi") < me->query("max_qi") / 3
      || me->query("qi") < me->query("max_qi") / 4
      || me->query("neili") < 1000) {
      command("halt");
      command("say 老子有事，不陪你玩了！");
      message_vision("韦一笑长啸一声，展开身法，如一道青烟般飞奔而去。\n", me);
      move(get_room());
      message_vision("只见一个青影从你面前掠过，仔细一看，竟是青翼蝠王韦一笑！他似乎受伤不轻。\n", me);
      return 1;
    }
    if (!query_temp("qingyi"))
      return exert_function("qingyi");
    else
      return perform_action("strike.blood");
  }

}

int accept_fight(object ob) {
  command("grin");
  command("say 想死还不容易！");
  kill_ob(ob);

  return 1;
}

int heal_move() {
  object me = this_object();

  if (!query("do_move")) return 1;
  if (random(20) != 1) {
    random_move();
    return 1;
  }

  message_vision("一道青影闪过，你揉了揉眼睛，什么都没看清。\n", me);
  move(get_room());
  message_vision("只见一个青影从你面前掠过，仔细一看，竟是青翼蝠王韦一笑！\n", me);
  if (me->query("eff_qi") < me->query("max_qi"))
    me->receive_curing("qi", me->query("max_qi") / 10);

  if (me->query("neili") < me->query("max_neili"))
    me->add("neili", 1000);

  return 1;
}

string get_room() {
  string *room;

  room = ({
    "/d/emei/emroad3",  // 三不管
    "/d/city/nandajie1",  // 南集市
    "/d/quanzhou/citong_w1",  // 刺桐西路
    "/d/qilian/gulang",  // 古浪
    "/d/xingxiu/shanjiao",  // 天山脚下
  });

  return room[random(5)];   // update
}


int suck_player() {
  int i;
  object me = this_object();
  object *inv;
  object *chars = ({});
  object target;

  if (query("target") || me->query_condition("wei_pk")) return 1;

  inv = all_inventory(environment(me));

  if (sizeof(inv) == 1)
    return 1;

  for (i = 0; i < sizeof(inv); i++)
    if ((string)inv[i]->query("race") == "人类"
      && inv[i] != me
      && interactive(inv[i])
      && inv[i]->query("family/family_name") != "明教"
      && inv[i]->query("combat_exp") > 1000000
      && !wizardp(inv[i]))
      chars += ({ inv[i] });

  if (sizeof(chars) == 0)
    return 1;

  target = chars[random(sizeof(chars))];

  command("look " + target->query("id"));
  command("taste " + target->query("id"));
  message_vision("韦一笑打了一个冷颤，脸色看起来十分可怕。\n", me);
  set("do_move", 0);
  set("target", 1);
  remove_call_out("do_suck");
  call_out("do_suck", 5, target);

  return 1;
}

void do_suck(object victim) {
  object me = this_player();

  if (present(victim, environment(me)))
    command("perform blood " + victim->query("id"));
  set("do_move", 1);
  set("target", 0);
}

void dest_me(object me) {
  message_vision(HIY "$N匆匆忙忙地离开了。\n" NOR, me);
  destruct(me);
}
