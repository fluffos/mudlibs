//xQin 15/2/99

inherit NPC;
inherit F_MASTER;


int auto_perform();

void create()
{
        set_name("殷梨亭", ({ "yin liting", "yin" }));
        set("nickname", "武当六侠");
        set("long", 
                "他就是张三丰的六弟子殷梨亭。\n"
                "只见他满脸风尘之色，两鬓微见斑白，\n"
                "在武当七侠中排名第六，对剑法尤为精通。\n");
        set("gender", "男性");
        set("age", 40);
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("str", 26);
        set("int", 26);
        set("con", 26);
        set("dex", 26);
        
        set("max_qi", 1700);
        set("max_jing", 1700);
        set("neili", 3500);
        set("max_neili", 3500);
        set("jiali", 100);
        set("combat_exp", 850000);
        set("shen", 80000);

        set_skill("force", 170);
        set_skill("taiji-shengong", 170);
        set_skill("dodge", 170);
        set_skill("tiyunzong", 170);
        set_skill("cuff", 170);
        set_skill("chang-quan", 170);
        set_skill("strike", 170);
        set_skill("mian-zhang", 170);
        set_skill("parry", 170);
        set_skill("sword", 170);
        set_skill("taiji-jian", 170);
	set_skill("taoism", 130);
        set_skill("literate", 50);
        set("wudang/shenmen", 1);
//  
        map_skill("force", "taiji-shengong");
        map_skill("dodge", "tiyunzong");
        map_skill("cuff", "chang-quan");
        map_skill("strike", "mian-zhang");
        map_skill("parry", "taiji-jian");
        map_skill("sword", "taiji-jian");

        prepare_skill("cuff", "chang-quan");
        prepare_skill("strike", "mian-zhang");

        create_family("武当派", 2, "弟子");
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
                (: perform_action("sword.shenmen") :),
        }) );


        set("inquiry", ([
                "纪晓芙" : "可怜我那未过门的妻子，居然被杨逍那淫徒。。。",
                "杨逍" : "总有一天我要手刃这魔教淫贼，以祭晓芙在天。。。",
		"神门十三剑" : "神门十三剑乃。。。 唉，可怜晓芙居然被杨消那淫徒。。。",

        ]));

	
        setup();
        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/d/wudang/obj/whiterobe")->wear();
}


void attempt_apprentice(object ob)
{
        mapping fam;

        if( mapp(fam = ob->query("family")) && fam["family_name"] != "武当派" )
        {
                command ("say " + RANK_D->query_respect(this_player())
                        + "并非我门中人，习武还是先从各位道长起吧！");
                return;
        }

        if ((int)ob->query_skill("taiji-shengong", 1) < 60) {
                command("say 我武当派乃内家武功，最重视内功心法。"); 
                command("say " + RANK_D->query_respect(ob) + 
                        "是否还应该在太极神功上多下点功夫？");
                return;
        }

        if ((int)ob->query("shen") < 80000) {
                command("say 我武当乃是堂堂名门正派，对弟子要求极严。");
                command("say " + RANK_D->query_respect(ob) + "若能做出" +
                        "几件侠义之事，我一定收你。");
                return;
        }
        command("sigh");
        command("say 虽然" + RANK_D->query_respect(ob) + "也是" +
                "我辈中人，但自晓芙去后，我已无心收徒；不过你我今日"+
                "相见也是有缘，我就传你一式“天地同寿”，也不枉你我相"+
                "识一场。");

        ob->set("yinliting_teach",1);
}


// End of file 
