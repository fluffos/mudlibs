#include <ansi.h>

//inherit F_DBASE;
//inherit F_SSERVER;
inherit SKILL;
void wakeup(object, object);
int forgive(object, object);

int forgive(object me, object target)
{
    command ("sorry " + target->query("id"));
    if( !target->is_character() || target->is_corpse() ){
        return 1;
    }
    else {
        message_vision(
        HIG "will you forgive me?。\n" NOR, me);
        tell_object(target,  "he is asking for your forgiveness。\n");
        return 0;
    }     
}
   
int exert(object me, object target)
{
    object obj, weapon;
    int xf, af, sp, ap, sucess,i,j;  
    
    // perform conditions
    //if( !target ) target = offensive_target(me);
    if( !objectp(target) )
        return notify_fail("你想干嘛？\n");
    if( target == me ) 
        return notify_fail("想睡觉就用 sleep \n");
    if( !target->is_character() || target->is_corpse() )
        return notify_fail("看清楚一点，那并不是活物。\n");
	if ((int)me->query("jingli") < 300)
        return notify_fail("你的精力不够。\n");
    if( (int)me->query("neili") < 600 )
        return notify_fail("你的内力不够。\n");
    if( (int)me->query_skill("shexin-shu",1) < 30 )
        return notify_fail("你的摄心术功力不够！\n");
    if( target->query_temp("block_msg/all", 1) )
        return notify_fail("此人已然入睡了！\n");

    // perform massages
    me->add("neili", -400 + me->query_skill("shexin-shu"));
    me->receive_damage("jingli",  50);
    message_vision(
        BLU "$N摇头晃脑。\n" NOR, me);
        tell_object(target,  "你觉得。\n");

    // success conditions  
    xf = (me->query_skill("shexin-shu", 1));
    ap = target->query("jing")/10 + target->query_skill("force") + target->query("con")  + target->query("int") ; 
    sp = me->query_skill("force") + me->query("jing")/20 + xf;
    sp *= me->query("combat_exp")/1000;
	ap *= target->query("combat_exp")/1000;
    sucess = 0;
    
    // how is the chance
    if (userp(target)) {
        if (random(sp) > (ap*2.5))
            sucess = 1;
	}  
    else {
        if (random(sp) > (ap*1.2))
            sucess = 1;
    }
    
    // victim defense
    j = target->query("jing");
    j = j - me->query_skill("shexin-shu",1);
    if (j<0) j=0;
    target->set("jing",j);

    // performing
    if( sucess ){ //when succeeded
        tell_object(target, HIR "你只觉得。\n" NOR);
        message_vision("你看见" +target->query("name") +"\n", me);
      	target->apply_condition("gb_shexin-shu", (int)(me->query_skill("shexin-shu", 1)/20));
        target->set("gaibang/shexin_list", me->query("id"));
        target->set_temp("block_msg/all", 1);
        target->disable_player("<睡梦中>");
//        call_out("wakeup",random(60 - me->query("con")), me, where);      
        if((int)target->query("combat_exp") > me->query("combat_exp")/2
          && userp(target)){
            me->improve_skill("shexin-shu", me->query("int"));
            //no exp added.
            //me->add("combat_exp", 1);
        }
        return 1;
    }
    else{ //if failed, will laugh to faint?
       	//dying
       	i = me->query_skill("qi");
       	while(i>0){
       	    tell_object(me, command ("laugh"));
       	    me->add("qi", -1);
       	    me->start_busy(random(7));
            //asking for forgiving
            if(forgive(me, this_player())) break;
            i = me->query_skill("qi");
       	}
       	return 1;
    }
}