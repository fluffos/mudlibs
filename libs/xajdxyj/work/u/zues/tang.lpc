//这是给大家的元宵礼物的一个礼物
inherit ITEM;
inherit F_FOOD;
#include <ansi.h>
void create() {
  set_name(HIW "汤圆" NOR, ({ "tang yuan", "tang" }));
  set_weight(5);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一碗热气腾腾的汤圆，散发出沁人心脾的清甜。\n");
    set("unit", "碗");
    set("value", 1);
  }
}
void init() {
  add_action("do_drink", "drink");
}
int do_drink(string arg) {
  int fy;



  object me = this_object();
  object who = this_player();
  fy = who->query_kar() * 10;
  fy = random(fy);
  if (!arg || (arg != "tang yuan" && arg != "tang"))
    return notify_fail("你要吃什么？\n");
  if (who->query("combat_exp") < 1000)
    return notify_fail("你的奶牙还没有长齐呢，吃什么汤圆呀？\n");
  if (who->query("drink_yuanxiao_tang_count") > 0)
    return notify_fail("为了那么点东西，就这么拼命折磨自己，至于吗？\n");
  who->add("combat_exp", 5000 + fy);
  who->add("potential", 5000 + fy);
  who->add("max_mana", 10);
  who->add("max_force", 10);
  who->set_skill("jueqingbian", 10);
  who->set("age", 20);
  who->set("per", 30);
  who->set("drink_yuanxiao_tang_count", 1);
  message_vision(HIY "$N喝下一碗" HIW "汤圆" NOR "，看起来精神好多了。\n" NOR, who);
  destruct(this_object());
  return 1;
}
