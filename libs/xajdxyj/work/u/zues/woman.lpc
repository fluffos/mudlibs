inherit NPC;
#include <ansi.h>
inherit F_DEALER;
void greeting(object ob);
void create() {
  set_name(HIC "小吃大娘" NOR, ({ "woman", "seller" }));
  set("long", "这是位远近闻名的卖小吃的。\n");
  set("gender", "女性");
  set("title", HIW "好再来" NOR);
  set("age", 40);
  set("con", 30);
  set("per", 50);
  set("str", 25);
  set("int", 35);
  set("combat_exp", 10000000);
  set("attitude", "heroism");
  set_skill("dodge", 300);
  set_skill("force", 300);
  set_skill("unarmed", 300);
  set_skill("parry", 300);
  set_skill("sword", 300);
  set_skill("qing", 300);
  set_skill("moondance", 300);
  map_skill("dodge", "moondance");
  map_skill("sword", "qing");
  set("max_force", 2000);
  set("force_factor", 100);
  set("max_kee", 2000);
  set("max_gin", 4000);
  set("max_sen", 5000);

  set("yuanxiao_count", 3);
  set("inquiry", ([
    "礼物": "我哪里有什么礼物，只是在这里给大家送点汤圆暖暖身子。\n",
  ]));
  set("vendor_goods", ({
    "/u/zues/tang",
  }));
  setup();
  carry_object("/obj/cloth")->wear();
  carry_object("/d/obj/weapon/sword/changjian")->wield();
  add_money("coin", 1);
}
void init() {
  object ob;
  ::init();
  add_action("do_list", "list");
  add_action("do_buy", "buy");
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}
void greeting(object ob) {
  object obn;
  if (!ob || environment(ob) != environment()) return;
  if (!present("denglong", ob) && random(2) == 1) {
    tell_object(ob, "这位" + RANK_D->query_respect(ob) + "，我这里有" HIR "「花灯」" NOR "，\n" +
      "看人家孩子都有灯笼挑，也给你一个吧！\n");
    obn = new("/u/zues/denglong");
    obn->move(ob);
    return;
  }
  say("小吃大娘殷勤地说：这位" + RANK_D->query_respect(ob) + "，来喝碗热" HIW "汤圆" NOR "，暖暖身子。\n");
  return;
}
int accept_fight(object ob) {
  object obn;
  if (!objectp(present("guanyin pusa", environment(ob)))) {
    add("yuanxiao_count", -1);
    if (!query("yuanxiao_count")) { message_vision("小吃大娘哼了一声：不捧老娘的生意，却来砸场子！！！ \n", ob); return 1; }
    message_vision("小吃大娘大喝一声：你看看我到底是谁？！------不要逼我出手！！！\n", ob);
    obn = new("/u/zues/pusa");
    obn->move(environment(ob));
    obn->kill_ob(ob);
    return 1;
  }
  message_vision("小吃大娘大怒道：让你小子尝尝老娘的厉害。\n", ob);
  return 1;
}
