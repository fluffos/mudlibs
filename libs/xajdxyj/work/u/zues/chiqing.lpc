//By zues 2001/1/12
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int orforce;
  object weapon;
  int extra;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail(HIW "痴心一片" NOR "只能对战斗中的对手使用。\n");

  extra = me->query_skill("qing", 1) * 100;
  me->add_temp("apply/attack", extra);
  me->add_temp("apply/damage", extra);
  msg = HIW "$N眼中泪光一闪，双手抱剑，整个人都向$n扑过去，\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  msg = HIM "痴\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  msg = HIM "心\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  msg = HIM "情\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  msg = HIM "长\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  msg = HIW "一阵剑气过后,人，剑，泪都化做云，烟，雾,随雨，随风，随缘．．．．\n" NOR;
  message_vision(msg, me, target);
  me->add_temp("apply/attack", -extra);
  me->add_temp("apply/damage", -extra);
  target->receive_wound("kee", target->query("max_kee") / 3);
  target->receive_damage("kee", 1 + target->query("kee") / 2);
  target->start_busy(2);
  return 1;
}
