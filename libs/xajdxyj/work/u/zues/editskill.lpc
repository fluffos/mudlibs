  // ZHAOSHI :0

  ([
    "action": "$N两眼微醉，略向后退，突然一招『贵妃醉酒』，双拳急出，攻向$n的头部",
    "damage": 50,
    "dodge": 10,
    "parry": 10,
    "damage_type": "瘀伤",
    "skill_name": "贵妃醉酒"
  ]),
  // ZHAOSHI :1

  ([
    "action": "$N左手斜举，右手五指弹起，作了个弹琵琶的姿式，正是一招『昭君出塞』，五根手指一一弹在$n头上",
    "damage": 80,
    "dodge": -10,
    "parry": -10,
    "damage_type": "瘀伤",
    "skill_name": "昭君出塞"
  ]),
  // ZHAOSHI :2

  ([
    "action": "$N双眉微蹙，略显病态，然后用一招『西施捧心』，左拳打出，正中$n心口",
    "damage": 100,
    "dodge": -20,
    "parry": -20,
    "damage_type": "瘀伤",
    "skill_name": "西施捧心"
  ]),
  // ZHAOSHI :3

  ([
    "action": "$N右手一探，使出『貂蝉拜月』从那化子肩头绕了过去，掌缘狠狠的斩向$n肩后",
    "damage": 130,
    "dodge": -30,
    "parry": -30,
