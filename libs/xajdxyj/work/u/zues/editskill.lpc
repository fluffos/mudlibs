  // ZHAOSHI :4

  ([
    "action": "$N右手挥左，左手送右，作了个掷梭织布之状，这一挥一送，双手又都打在$n的肩头，正是『天孙织绵』",
    "damage": 150,
    "dodge": -50,
    "parry": -40,
    "damage_type": "瘀伤",
    "skill_name": "天孙织锦"
