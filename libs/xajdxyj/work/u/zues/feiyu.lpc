inherit NPC;
#include <ansi.h>
void create() {
  set_name(HIM "绯雨" NOR, ({ "feiyu", "king" }));
  set("long", "绯雨阁的缔造者，曾经的巾帼英雄。\n");
  set("gender", "女性");
  set("title", HIW "痴心人" NOR);
  set("age", 20);
  set("con", 30);
  set("per", 50);
  set("str", 25);
  set("int", 35);
  set("combat_exp", 10000000);
  set("attitude", "heroism");
  set("chat_chance", 20);
  set("chat_msg", ({
    "绯雨低声长吟道：问世间情为何物，直教人以死相许。\n",
  }));
  set("chat_chance", 10);
  set_skill("dodge", 300);
  set_skill("force", 300);
  set_skill("unarmed", 300);
  set_skill("parry", 300);
  set_skill("sword", 300);
  set_skill("qing", 300);
  set_skill("moondance", 300);
  map_skill("dodge", "moondance");
  map_skill("sword", "qing");
  set("max_force", 2000);
  set("force_factor", 100);
  set("max_kee", 2000);
  set("max_gin", 4000);
  set("max_sen", 5000);
  setup();
  carry_object("/obj/cloth")->wear();
  carry_object("/d/obj/weapon/sword/changjian")->wield();
  add_money("gold", 10);
}
