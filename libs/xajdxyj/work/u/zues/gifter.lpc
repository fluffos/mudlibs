// zues@happy
inherit NPC;
#include <ansi.h>
inherit F_DEALER;
void greeting(object ob);
void create() {
  set_name(HIY "节日使者" NOR, ({ "shi zhe", "zhe", "gifter" }));
  set("long", "这是新纪元里边的礼物专使，给大家发放礼物的。\n");
  set("gender", "女性");
  set("title", HIW "Welcome" NOR);
  set("age", 18);
  set("con", 30);
  set("per", 50);
  set("str", 25);
  set("int", 35);
  set("combat_exp", 10000000);
  set("attitude", "heroism");
  set_skill("dodge", 300);
  set_skill("force", 300);
  set_skill("unarmed", 300);
  set_skill("parry", 300);
  set_skill("sword", 300);
  set_skill("qing", 300);
  set_skill("moondance", 300);
  map_skill("dodge", "moondance");
  map_skill("sword", "qing");
  set("max_force", 2000);
  set("force_factor", 100);
  set("max_kee", 2000);
  set("max_gin", 4000);
  set("max_sen", 5000);

  set("yuanxiao_count", 3);
  set("inquiry", ([
    "礼物": "我这里有礼物呀，不过要买的，很便宜。\n",
  ]));
  set("vendor_goods", ({
    "/d/obj/drug/cake",
  }));
  setup();
  carry_object("/obj/cloth")->wear();
  carry_object("/d/obj/weapon/sword/changjian")->wield();
  add_money("coin", 1);
}
void init() {
  object ob;
  ::init();
  add_action("do_list", "list");
  add_action("do_buy", "buy");
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}
void greeting(object ob) {
  object obn;
  if (!ob || environment(ob) != environment()) return;
  if (!present("denglong", ob) && random(2) == 1) {
    tell_object(ob, "这位" + RANK_D->query_respect(ob) + "，我这里有" HIR "节日礼物" NOR "，\n" +
      "来看看呀，不过要收小费的哟！你可以通过list查看都有什么东西的.\n");
    /* obn=new("/u/zues/denglong");
obn->move(ob);
*/
    return;
  }
  say("节日使者殷勤地说：这位" + RANK_D->query_respect(ob) + "，来带上我们的祝福" HIW "蛋糕" NOR "。\n");
  return;
}
