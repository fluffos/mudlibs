#include <ansi.h>
inherit NPC;
void create()
{
        set_name(HIY"九爪金龙"NOR,({"dragon"}));
        set("race", "野兽");
        set("age", 20);
        set("long", "一只模样高大，极有气势的龙。\n");
        set("str", 40);
        set("cor", 30);
   set("con", 30);
   set("cps", 30);
   set("spi", 30);
   set("int", 30);
        set_temp("apply/damage", 500);
        set_temp("apply/armor", 500);
        set("max_kee", 5000);
        set("max_sen", 5000);
   set("force", 10000);
   set("max_force", 5000);
   set("force_factor", 100);
   set("mana", 10000);
   set("max_mana", 2000);
   set("mana_factor", 100);
   set_skill("unarmed", 300);
   set_skill("dodge", 300);
   set_skill("parry", 300);
   set_skill("dragonfight", 300);
   set_skill("dragonstep", 300);
   map_skill("unarmed", "dragonfight");
   map_skill("dodge", "dragonstep");
   set("combat_exp", 10000000);
        set("limbs", ({ "头部", "身体", "前爪", "尾巴", "肚皮", "后爪"}) );
        set("verbs", ({ "bite", "claw"}) );
   set_weight(100000);
        setup();
}
void copy_status(object me,object ob)
{
   me->set_skill("unarmed", (int)ob->query_skill("unarmed", 1));
   me->set_skill("dodge", (int)ob->query_skill("dodge", 1));
   me->set_skill("parry", (int)ob->query_skill("parry", 1));
   me->set_skill("dragonfight", (int)ob->query_skill("dragonfight",
1) + 20);
   me->set_skill("dragonstep", (int)ob->query_skill("dragonstep", 1)
+ 20);
        me->set("combat_exp",ob->query("combat_exp"));
}
int heal_up()
{
        if( environment() && !is_fighting() ) {
                call_out("leave", 1);
                return 1;
        }
        return ::heal_up() + 1;
}
void invocation(object who)
{
       int i;
        object *enemy;
   object me=this_object();
        copy_status(me,who);
        message("vision", HIG"忽然狂风大做，半空现出一条"+ name() +
"来！\n\n"NOR,environment(), this_object() );
        enemy = who->query_enemy();
        i = sizeof(enemy);
        while(i--) {
                if( enemy[i] && living(enemy[i]) ) {
                        kill_ob(enemy[i]);
                        if( userp(enemy[i]) )
enemy[i]->fight_ob(this_object());
                        else enemy[i]->kill_ob(this_object());
                }
        }
}
