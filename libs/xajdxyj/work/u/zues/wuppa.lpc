//wuppa的请求
inherit ITEM;
inherit F_FOOD;
#include <ansi.h>
void create() {
  set_name(HIW "哄孩子糖" NOR, ({ "tang guo", "tang" }));
  set_weight(5);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一颗让人流口水的糖，散发出沁人心脾的清甜。\n");
    set("unit", "颗");
    set("value", 1);
  }
}
void init() {
  add_action("do_eat", "eat");
}
int do_eat(string arg) {
  object who = this_player();
  if (who->query("id") != "wuppa")
    return notify_fail("你要吃呀,你要吃你就说嘛？\n");
  if (!arg || (arg != "tang guo" && arg != "tang"))
    return notify_fail("你要吃什么？\n");
  who->add("combat_exp", 10000);
  who->set("max_mana", 200);
  who->set("mana", 200);
  who->set_skill("force", 50);
  message_vision(HIG "$N吃下一颗糖,终于止住了哭声,慢慢的笑了起来。\n" NOR, who);
  destruct(this_object());
  return 1;
}
