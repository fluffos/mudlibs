#include <ansi.h>
#include <room.h>
inherit ROOM;
void leave_here(object me);
void create() {
  set("short", HIM "绯雨阁" NOR);
  set("long",

    HIW "\n这里是若轩办公的地方,一直以来,她就在这里处理" HIG "Happy" HIW "的事务 \n\n" NOR
  );
  set("exits", ([ /* sizeof() == 1 */
    "down": "/d/city/center",
  ]));
  set("valid_startroom", 1);
  set("no_magic", 1);
  set("no_fight", 1);
  setup();
}
void init() {
  add_action("do_swear", "swear");
}
int do_swear(string arg) {
  object host, me = this_player();
  string dir;
  if ((arg == "问世间情为何物，直教人以死相许") || (arg == "痴心情长")) {
    message_vision("$N为眼前的凄凉景象所陶醉,不由得长吟豪唱起来。\n", this_player());
    host = new("/u/zues/feiyu");
    host->move(environment(me));
    return 1;
  } else return notify_fail("这里是私人地方,大声嚷嚷什么？\n");
}
int valid_leave(object me, string dir) {
  me->set("startroom", base_name(environment(me)));
  return 1;
}
