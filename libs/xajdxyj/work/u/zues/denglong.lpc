#include <ansi.h>
inherit ITEM;
string *names = ({
  HIR "花灯" NOR,
  HIG "花灯" NOR,
  HIY "花灯" NOR,
  HIB "花灯" NOR,
  HIM "花灯" NOR,
  HIC "花灯" NOR,
  HIW "花灯" NOR,
  RED "花灯" NOR,
  GRN "花灯" NOR,
  YEL "花灯" NOR,
  BLU "花灯" NOR,
  MAG "花灯" NOR,
  CYN "花灯" NOR,
  WHT "花灯" NOR,
});
void create() {
  set_name(names[random(sizeof(names))], ({ "denglong", "huadeng", "deng" }));
  set_weight(5);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("value", 1);
    set("long", "一个花灯，元宵节的时候大家玩闹花灯是用的。\n");
  }
  setup();
}
