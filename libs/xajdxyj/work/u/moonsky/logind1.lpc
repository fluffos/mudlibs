void create() {
  seteuid(getuid());
  set("channel_id", "连线精灵");
  set("id", "logind");
}

// added by snowcat Mar 11 1998
int total_players() {
  mapping mud_list;
  mixed *muds;
  string output;
  int loop, size, nb, total = 0;

  if (!find_object(DNS_MASTER))
    return 0;

  mud_list = (mapping)DNS_MASTER->query_muds();
  if (!mud_list)
    return 0;

  muds = keys(mud_list) - ({ "DEFAULT" });
  for (loop = 0, size = sizeof(muds); loop < size; loop++) {
    if (mud_list[muds[loop]]["MUDLIB"] == "A Journey to the West" &&
      !undefinedp(mud_list[muds[loop]]["USERS"])) {
      sscanf(mud_list[muds[loop]]["USERS"], "%d", nb);
      total += nb;
    }
  }
  return total;
}

void logon(object ob) {
  cat(BANNER);
  write(HIC BLINK "\n\n\t欢迎您在学习和工作之余光临欢乐园！\n" NOR);
  //    write(YEL"\n\t\t同时提醒您：临近期末考试，请把握好时间。\n"NOR);

  {  // 30 秒钟内不得反复登录
    mapping usage = IP_USAGE_D->query_ip_usage(query_ip_number(ob));
    if (!undefinedp(usage["login"])) {
      if (time() - usage["login"] < 30) {
        call_out("encoding", 30, " ", ob);
        write("请稍候");
        return;
      }
    }
    if (!undefinedp(usage["logout"])) {
      if (time() - usage["logout"] < 30) {
        call_out("encoding", 30, " ", ob);
        write("请稍候");
        return;
      }
    }
    if (!undefinedp(usage["replace"])) {
      if (time() - usage["replace"] < 30) {
        call_out("encoding", 30, " ", ob);
        write("请稍候");
        return;
      }
    }
  }

  input_to((: encoding :), ob);
}

private void encoding(string arg, object ob) {
  object *usr, control_center;
  int i, ttl_cnt, wiz_cnt, ppl_cnt, login_cnt, multi;
  string ip_name, ip_number;
  int ii, encode = 0;

  if (!ob) return;

  if (control_center = find_object(CONTROL_CENTER)) {
    if (arg != "let me be happy" && time() - control_center->query("MUD_SRART_TIME") < 180) {
      write(MUD_NAME + "服务器正在进行启动前事务处理，请稍候再来。\n");
      destruct(ob);
      return;
    }
  }

  ob->set_temp("input_time", time());
  /*
    if( strlen(arg) < 3 )
    {
        write(HIG"\n为了防止您的密码被盗，请任意输入至少三个字符："NOR);
        input_to( (: encoding :), ob );
        return;
    }
*/
  ob->set_encoding(encode);

  ip_name = query_ip_name(ob);
  ip_number = query_ip_number(ob);

  if (new_start == 0) {  //only check for once.
    new_start++;
  }

  // snowcat dec 10 1997
  // try strict ban here...weiqi.
  if (BAN_D->is_strict_banned(ip_number) == 1) {
    write("您的地址在本 MUD 的信誉被人破坏了。\n");
    destruct(ob);
    log_file("ALLCONT", sprintf("kicked out %s, strict_banned\n", ip_number));
    return;
  }

  // log all connections.
  //    log_file( "ALLCONT", sprintf("IP_name--number  %s--%s (%s)\n", ip_name, ip_number,
  //        ctime(time()) ) );

  // try not accept "name" as IP
  if (!ip_name) {
    destruct(ob);
    //        log_file("ALLCONT", sprintf("kicked out, No IP\n"));
    return;
  }

  for (ii = 0; ii < sizeof(ip_number); ii++) {
    if ((ip_number[ii] != '.') && (ip_number[ii] > '9')) {
      destruct(ob);
      log_file("ALLCONT", sprintf("kicked out, Non_number\n"));
      return;
    }
  }

  write(ESC + "[1A" + ESC + "[200D" + ESC + "[K                                          ");
  write(ESC + "[1A" + ESC + "[200D" + ESC + "[K\n");
  cat(WELCOME);
  UPTIME_CMD->report();
  write("现在是" + TIME_D->xyj_time2(time()) + "。\n\n");

  usr = users();
  wiz_cnt = 0;
  ppl_cnt = 0;
  login_cnt = 0;
  for (i = 0; i < sizeof(usr); i++) {
    if (ob != usr[i] && query_ip_name(usr[i]) == ip_number) multi++;
    if (!environment(usr[i])) login_cnt++;
    else if ((wizardp(usr[i]) && (string)wizhood(usr[i]) != "(elder)") && !usr[i]->query("env/invisibility"))
      wiz_cnt++;
    else ppl_cnt++;
  }
  // snowcat Mar 11 1998
  ttl_cnt = total_players();
  if (ttl_cnt == 0) printf("目前");  // info not available
  else printf("目前共有%d位玩家在线上。本站", ttl_cnt);
  printf("共有%d位管理人员、%d位玩家，以及%d位在尝试连线。\n\n", wiz_cnt, ppl_cnt, login_cnt);

  // mon 4/19/98
  // reduce number of pending login users.
#ifdef MAX_USERS
  if (sizeof(usr) > (MAX_USERS + 10)) {
    write("对不起，" + MUD_NAME + "的玩家已经太多了，请待会儿再来。\n");
    destruct(ob);
    return;
  }
#endif

  /*  ----- 限制多重登录 -----  */
  if (ip_number == "202.200.43.33" || ip_number == "202.200.39.31" || ip_number == "202.200.39.32" ||
    ip_number == "210.45.208.1" || ip_number == "202.117.103.128" && multi <= 7)
    multi = 0;
  if (ip_name == "bbs") multi = 10;
  if (multi > 1 || (multi == 1 && ppl_cnt > 80 && arg != "Give me an extra")) {
    write("===== 对不起，" + MUD_NAME + "限制相同IP多重登录 =====\n");
    write("===== 如果有特殊原因，请向园长申请 =====\n");
    destruct(ob);
    return;
  }

  if (ob) ob->set_temp("id_count", 0);
  //mon 10/15/97 to prevent flooding illegal ID after login.

  write("\n请输入您的英文名字：");
  input_to((: get_id :), ob);
}

private void get_id(string arg, object ob) {
  object ppl;
  int i;
  int id_count;
  string err;
  string src, ok, bad;

  if (!ob) return;

  id_count = ob->query_temp("id_count");
  // mon 7/19/97 to prevent flooding by repeating illegal id.
  id_count++;
  ob->set_temp("id_count", id_count);
  if (id_count > 6) {
    destruct(ob);
    //        log_file( "ALLCONT", sprintf("kicked out, illegal ID.\n"));
    return;
  }

  arg = lower_case(arg);
  if (!check_legal_id(arg)) {
    write("请输入您的英文名字：");
    input_to("get_id", ob);
    return;
  }

#ifdef MAX_USERS
  if ((string)SECURITY_D->get_status(arg) == "(player)" && sizeof(users()) >= MAX_USERS) {
    ppl = find_body(arg);
    // Only allow reconnect an interactive player when MAX_USERS exceeded.
    if (!ppl || !interactive(ppl)) {
      write("对不起，" + MUD_NAME + "的玩家已经太多了，请待会儿再来。\n");
      destruct(ob);
      return;
    }
  }
#endif
  for (i = 0; i < sizeof(banned_id); i++) {
    if (arg == banned_id[i]) {
      write("对不起，这种名字会造成其他人的困扰。\n");
      destruct(ob);
      return;
    }
  }


  if (wiz_level(arg) < wiz_lock_level) {
    write("对不起，" + MUD_NAME + "目前限制巫师等级 " + WIZ_LOCK_LEVEL
      + " 以上的人才能连线。\n");
    destruct(ob);
    return;
  }


  if ((string)ob->set("id", arg) != arg) {
    write("Failed setting user name.\n");
    destruct(ob);
    return;
  }

  if (arg == "guest") {
    // If guest, let them create the character.
    confirm_id("Yes", ob);
    return;
  } else if (file_size(ob->query_save_file() + __SAVE_EXTENSION__) >= 0) {


    // 登录存档检测，以及自动恢复
    err = catch(call_other(ob, "restore"));
    if (err) {  // 无法载入的情形（文件格式不对）
      log_file("bad_login_data", ctime(time()) + " " + arg + " can't load\n");
      write("噢，天哪！你的人物存档出了一些问题！\n试试你的备份存档……\n\n");
      if ((string)ob->set("id", arg) != arg) {
        write("还是不行，请等候园长来处理吧。\n");
        destruct(ob);
        return;
      }

      src = ob->query_save_file();
      ok = src + ".a.o";
      bad = src + ".b";
      if (file_size(ok) < 10) {  // 寻找自动备份的存档
        write("真不幸，找不到你的备份存档！请等候园长来处理吧。\n");
        destruct(ob);
        return;
      }

      if (cp(src + ".o", bad) && cp(ok, src + ".o")) {  // 用自动备份的存档覆盖坏的存档
        // If guest, let them create the character.
        confirm_id("Yes", ob);
        return;
      } else if (file_size(ob->query_save_file() + __SAVE_EXTENSION__) >= 0) {


        // 登录存档检测，以及自动恢复
        err = catch(call_other(ob, "restore"));
        if (err) {  // 无法载入的情形（文件格式不对）
          log_file("bad_login_data", ctime(time()) + " " + arg + " can't load\n");
          write("噢，天哪！你的人物存档出了一些问题！\n试试你的备份存档……\n\n");
          if ((string)ob->set("id", arg) != arg) {
            write("还是不行，请等候园长来处理吧。\n");
            destruct(ob);
            return;
          }

          src = ob->query_save_file();
          ok = src + ".a.o";
          bad = src + ".b";
          if (file_size(ok) < 10) {  // 寻找自动备份的存档
            write("真不幸，找不到你的备份存档！请等候园长来处理吧。\n");
            destruct(ob);
            return;
          }

          if (cp(src + ".o", bad) && cp(ok, src + ".o")) {  // 用自动备份的存档覆盖坏的存档
            if ((string)ob->set("id", arg) != arg) {
              write("还是不行，请等候园长来处理吧。\n");
              destruct(ob);
              return;
            }
            err = catch(call_other(ob, "restore"));
            if (err) {
              write("还是不行，请等候园长来处理吧。\n");
              destruct(ob);
              return;
            }
            if (!ob->query("id") || ob->query("id") != arg) {
              write("还是不行，请等候园长来处理吧。\n");
              destruct(ob);
              return;
            }
            write("ＯＫ！找到了你的备份存档！\n");  // 载入成功！
            log_file("bad_login_data", ctime(time()) + " " + arg + " is auto recovered\n");
            write("\n请输入密码：\n");
            input_to("get_passwd", 1, ob);
            return;
          }
          write("复制备份存档出错，请等候园长来处理。\n");  // 无法覆盖
          destruct(ob);
          return;
        }

        if (!ob->query("id") || ob->query("id") != arg) {  // 能载入但账号不对
          log_file("bad_login_data", ctime(time()) + " " + arg + " wrong id\n");
          if ((string)ob->set("id", arg) != arg) {
            write("您的人物存档出了一些问题，请等候园长来处理。\n");
            destruct(ob);
            return;
          }
          write("噢，天哪！你的人物存档出了一些问题！\n试试你的备份存档……\n\n");
          src = ob->query_save_file();
          ok = src + ".a.o";
          bad = src + ".b";
          if (file_size(ok) < 10) {
            write("真不幸，找不到你的备份存档！请等候园长来处理吧。\n");
            destruct(ob);
            return;
          }
          if (cp(src + ".o", bad) && cp(ok, src + ".o")) {
            if ((string)ob->set("id", arg) != arg) {
              write("还是不行，请等候园长来处理吧。\n");
              destruct(ob);
              return;
            }
            err = catch(call_other(ob, "restore"));
            if (err) {
              write("还是不行，请等候园长来处理吧。\n");
              destruct(ob);
              return;
            }
            if (!ob->query("id") || ob->query("id") != arg) {
              write("还是不行，请等候园长来处理吧。\n");
              destruct(ob);
              return;
            }
            write("ＯＫ！找到了你的备份存档！\n");
            log_file("bad_login_data", ctime(time()) + " " + arg + " is auto recovered\n");
            write("\n请输入密码：\n");
            input_to("get_passwd", 1, ob);
            return;
          }
          write("复制备份存档出错，请等候园长来处理。\n");
          destruct(ob);
          return;
        }
        write("\n请输入密码：\n");  // 存档完好的情形
        input_to("get_passwd", 1, ob);
        return;
      }

      // snowcat dec 10 1997
      if (BAN_D->create_char_banned(query_ip_number(ob)) == 1 ||
        BAN_D->is_banned(query_ip_number(ob)) == 1) {
        write("对不起，你目前不能创造新人物。\n");
        destruct(ob);
        log_file("ALLCONT", sprintf("%s kicked out, create char banned %s\n",
          ctime(time()), query_ip_number(ob)));
        return;
      }

      {  // 创建新人后 5 小时内不能再创建新人
        mapping usage = IP_USAGE_D->query_ip_usage(query_ip_number(ob));
        if (!undefinedp(usage["create"])) {
          if (time() - usage["create"] < 18000) {
            write("错误的英文名字！\n");
            destruct(ob);
            return;
          }
        }
      }
      write("使用 " + (string)ob->query("id") + " 这个名字将会创造一个新的人物，您确定吗(y/n)？");
      input_to("confirm_id", ob);
    }

    private void get_passwd(string pass, object ob) {
      string my_pass, err;
      object user;
      int len;
      string id, src, ok, bad;

      // added by FoF  (10/14/1999)
      // 采用另一种加密方法，取密码的后8位，前面多输入的字符无效
      len = strlen(pass);
      if (len > 8)
        pass = pass[(len - 8)..(len - 1)];

      my_pass = ob->query("password");
      if (crypt(pass, my_pass) != my_pass) {
        //      !SECURITY_D->match_wiz_site(ob, query_ip_number(ob)) ) {
        write("密码错误！");
        write("请重新连线，键入正确的密码或另取一个新的英文名字。\n");
        destruct(ob);
        return;
      }

      id = ob->query("id");
      // Check if we are already playing.
      user = find_body(id);
      if (user) {
        if (user->query_temp("netdead")) {
          reconnect(ob, user);
          return;
        }
        write("您要将另一个连线中的相同人物赶出去，取而代之吗？(y/n)");
        input_to("confirm_relogin", ob, user);
        return;
      }

      if (objectp(user = make_body(ob))) {  // 数据存档检测，以及自动恢复
        err = catch(call_other(user, "restore"));

        if (err) {  // 无法载入的情形
          log_file("bad_user_data", ctime(time()) + " " + id + " can't load\n");
          write("噢，天！你的人物存档有点问题！\n试试你的备份存档……\n\n");
          if ((string)user->set("id", id) != id) {
            write("抱歉，还是不行！请等候园长来处理吧。\n");
            destruct(ob);
            destruct(user);
            return;
          }
          src = user->query_save_file();
          ok = src + ".a.o";
          bad = src + ".b";
          if (file_size(ok) < 100) {
            write("真不幸，找不到你的备份存档！请等候园长来处理吧。\n");
            destruct(ob);
            destruct(user);
            return;
          }
          if (cp(src + ".o", bad) && cp(ok, src + ".o")) {
            if ((string)user->set("id", id) != id) {
              write("抱歉，还是不行！请等候园长来处理吧。\n");
              destruct(ob);
              destruct(user);
              return;
            }
            err = catch(call_other(user, "restore"));
            if (err) {
              write("抱歉，还是不行！请等候园长来处理吧。\n");
              destruct(ob);
              destruct(user);
              return;
            }
            if (!user->query("id") || user->query("id") != id) {
              write("抱歉，还是不行！请等候园长来处理吧。\n");
              destruct(ob);
              destruct(user);
              return;
            }
            write("ＯＫ！找到了你的备份存档！\n");

            log_file("bad_user_data", ctime(time()) + " " + id + " is auto recovered\n");
            log_file("USAGE", sprintf("%s %s(%s) loggin from %s\n", ctime(time()),
              user->query("name"), user->query("id"), query_ip_number(ob)));

            enter_world(ob, user);
            return;
          }
          write("复制备份存档出错，请等候园长来处理。\n");
          destruct(ob);
          destruct(user);
          return;
        }

        // 能载入但账号不对的情形
        if (!user->query("id") || user->query("id") != id) {
          log_file("bad_user_data", ctime(time()) + " " + id + " wrong id\n");
          if ((string)user->set("id", id) != id) {
            write("您的人物存档出了一些问题，请登录 guest 人物通知园长来处理。\n");
            destruct(ob);
            destruct(user);
            return;
          }
          write("噢，天哪！你的人物存档出了一些问题！\n试试你的备份存档……\n\n");
          src = user->query_save_file();
          ok = src + ".a.o";
          bad = src + ".b";
          if (file_size(ok) < 100) {
            write("真不幸，找不到你的备份存档！请等候园长来处理吧。\n");
            destruct(ob);
            destruct(user);
            return;
          }
          if (cp(src + ".o", bad) && cp(ok, src + ".o")) {
            if ((string)user->set("id", id) != id) {
              write("抱歉，还是不行！请等候园长来处理吧。\n");
              destruct(ob);
              destruct(user);
              return;
            }
            err = catch(call_other(user, "restore"));
            if (err) {
              write("抱歉，还是不行！请等候园长来处理吧。\n");
              destruct(ob);
              destruct(user);
              return;
            }
            if (!user->query("id") || user->query("id") != id) {
              write("抱歉，还是不行！请等候园长来处理吧。\n");
              destruct(ob);
              destruct(user);
              return;
            }
            write("真幸运，你的备份存档找到了！\n");

            log_file("bad_user_data", ctime(time()) + " " + id + " is auto recovered\n");
            log_file("USAGE", sprintf("%s %s(%s) loggin from %s\n", ctime(time()),
              user->query("name"), user->query("id"), query_ip_number(ob)));

            enter_world(ob, user);
            return;
          }
          write("复制备份存档出错，请等候园长来处理。\n");
          destruct(ob);
          destruct(user);
          return;
        }

        // 档案无问题
        log_file("USAGE", sprintf("%s %s(%s) loggin from %s\n", ctime(time()),
          user->query("name"), user->query("id"), query_ip_number(ob)));

        // FoF 00-5-16
        if (user->query("proved") != 1 && user->query("combat_exp") < 1)
          user->set_temp("is_newbie", 1);

        enter_world(ob, user);
        return;
      }
      write("请您重新创造这个人物。\n");
      confirm_id("y", ob);
    }

    private void confirm_relogin(string yn, object ob, object user) {
      object old_link;

      if (yn == "") {
        write("您要将另一个连线中的相同人物赶出去，取而代之吗？(y/n)");
        input_to("confirm_relogin", ob, user);
        return;
      }

      if ((yn[0] != 'y' && yn[0] != 'Y') || !user) {
        // user may be destructed during the process.
        // so I put in this check. mon 4/15/98
        write("好吧，欢迎下次再来。\n");
        destruct(ob);
        return;
      } else {
        tell_object(user, "有人从别处( " + query_ip_number(ob) +
          " )连线取代你所控制的人物。\n");

        // FoF 00-5-14
        call_out("log_usage", 1, user->query("id"), query_ip_number(user), "replace");

        log_file("USAGE", sprintf("%s(%s) replaced by %s (%s)\n",
          user->query("name"), user->query("id"), query_ip_number(ob), ctime(time())));
      }

      // Kick out the old player.
      old_link = user->query_temp("link_ob");
      if (old_link) {

        // 5/11/98 mon
        user->set_encoding(ob->query_encoding());

        exec(old_link, user);
        destruct(old_link);
      }

      reconnect(ob, user);
    }

    private void confirm_id(string yn, object ob) {
      if (yn == "") {
        write("使用这个名字将会创造一个新的人物，您确定吗(y/n)？");
        input_to("confirm_id", ob);
        return;
      }

      if (yn[0] != 'y' && yn[0] != 'Y') {
        write("好吧，那么请重新输入您的英文名字：");
        input_to("get_id", ob);
        return;
      }

      write(@TEXT

请您给自己取个好名字。不要取一些不雅或是容易造成他人困扰的名字，
否则将不允许参加游戏。

TEXT
      );
      write("您的中文名字：");
      ob->set_temp("get_name", 0);
      input_to("get_name", ob);
    }

    private void get_name(string arg, object ob) {
      if (!check_legal_name(arg)) {
        ob->add_temp("get_name", 1);
        if (ob->query_temp("get_name") > 5) {
          // the user can't input proper chinese name.
          // assign one for him/her.    mon 4/19/98

          arg = default_prefix[random(sizeof(default_prefix))] + default_name[random(sizeof(default_name))];
          write("因为你不能输入适当的中文名字，系统指定你的名字为：" + arg + "\n");
          write("请在进入游戏后请管理员帮助修改。\n");
        } else {
          write("您的中文名字：");
          input_to("get_name", ob);
          return;
        }
      }

      printf("%O\n", ob);
      ob->set("name", arg);
      write("请设定您的密码：");
      input_to("new_password", 1, ob);
    }

    private void new_password(string pass, object ob) {
      int len;
      write("\n");
      if (strlen(pass) < 5) {
        write("密码的长度至少是五个字符，请重设您的密码：");
        input_to("new_password", 1, ob);
        return;
      }

      // added by FoF  (10/14/1999)
      // 采用另一种加密方法，取密码的后8位，前面多输入的字符无效
      len = strlen(pass);
      if (len > 8)
        pass = pass[(len - 8)..(len - 1)];

      ob->set("password", crypt(pass, 0));
      write("请再输入一次您的密码，以确认您没记错：");
      input_to("confirm_password", 1, ob);
    }

    private void confirm_password(string pass, object ob) {
      string old_pass;
      object user;
      int len;

      // If you want do race stuff, ask player to choose one here, then you can
      // set the user's body after the question is answered. The following are
      // options for player's body, so we clone a body here.
      ob->set("body", USER_OB);
      if (!objectp(user = make_body(ob)))
        return;

      write("\n");

      // added by FoF  (10/14/1999)
      // 采用另一种加密方法，取密码的后8位，前面多输入的字符无效
      len = strlen(pass);
      if (len > 8)
        pass = pass[(len - 8)..(len - 1)];

      old_pass = ob->query("password");
      if (crypt(pass, old_pass) != old_pass) {
        write("您两次输入的密码并不一样，请重新设定一次密码：");
        input_to("new_password", 1, ob);
        return;
      }

      write("您要扮演男性(m)的角色还是女性(f)的角色？");
      input_to("get_gender", ob, user);
    }

    private void get_gender(string gender, object ob, object user) {
      if (gender == "") {
        write("您要扮演男性(m)的角色还是女性(f)的角色？");
        input_to("get_gender", ob, user);
        return;
      }

      if (gender[0] == 'm' || gender[0] == 'M')
        user->set("gender", "男性");
      else if (gender[0] == 'f' || gender[0] == 'F')
        user->set("gender", "女性");
      else {
        write("对不起，您只能选择男性(m)或女性(f)的角色：");
        input_to("get_gender", ob, user);
        return;
      }

      write("您的电子邮件地址(如果没有直接按回车)：");
      input_to("get_email", ob, user);
    }

    private void get_email(string email, object ob, object user) {
      ob->set("email", email);
      confirm_gift("n", ob, user);
    }

    object make_body(object ob) {
      string err;
      object user;
      int n;

      if (!ob->query("body")) return 0;

      user = new(ob->query("body"));
      if (!user) {
        write("现在可能有人正在修改使用者物件的程式，无法进行复制。\n");
        write(err + "\n");
        return 0;
      }
      seteuid(ob->query("id"));
      export_uid(user);
      export_uid(ob);
      seteuid(getuid());
      user->set("id", ob->query("id"));
      user->set_name(ob->query("name"), ({ ob->query("id") }));
      return user;
    }

    private void confirm_gift(string yn, object ob, object user) {
      int n;

      if (!ob || !user) {
        if (user) {
          destruct(user);
          return;
        }
        if (ob) destruct(ob);
        return;
      }

      if (yn != "") {
        if (yn[0] == 'y' || yn[0] == 'Y') {
          CHAR_D->setup_char(user);  //setup user weight. mon 11/7/97
          user->set("title", "普通百姓");
          user->set("birthday", time());
          user->set("potential", 99);
          user->set("food", user->max_food_capacity());
          user->set("water", user->max_water_capacity());
          user->set("speed/food", 1);
          user->set("channels", ({ "chat", "rumor", "xyj", "sldh", "pop", "es", "y2k" }));
          user->set("maps/all", 1);
          user->set("maps/changan", 1);
          user->set("maps/changan-east", 1);
          user->set("maps/changan-west", 1);
          user->set("maps/changan-south", 1);
          user->set("maps/qujing", 1);
          user->set("maps/kaifeng", 1);

          log_file("USAGE", sprintf("%s %s was created from %s\n", ctime(time()),
            user->query("id"), query_ip_number(ob)));

          // FoF 00-5-16
          user->set_temp("is_newbie", 1);

          call_out("log_usage", 1, user->query("id"), query_ip_number(ob), "create");

          return enter_world(ob, user);
        } else if (yn[0] == 'q' || yn[0] == 'Q') {
          destruct(user);
          destruct(ob);
          return;
        }
      }

      user->set("kar", 0);
      while (user->query("kar") < 10 || user->query("kar") > 30) {
        user->set("str", 10 + random(21));
        user->set("cps", 10 + random(21));
        user->set("int", 25 + random(6));
        user->set("cor", 10 + random(21));
        user->set("con", 20 + random(10));
        user->set("spi", 10 + random(21));
        user->set("per", 10 + random(21));
        n = user->query("str") + user->query("cps") + user->query("int") + user->query("cor");
        n = n + user->query("con") + user->query("spi") + user->query("per");
        user->set("kar", 168 - n);
      }
      write("\n");
      printf(" 膂力：[%s]  胆识：[%s]  悟性：[%s]  灵性：[%s]\n"
        " 定力：[%s]  容貌：[%s]  根骨：[%s]  福缘：[%s]\n\n",
        dis_attr(user->query_str()),
        dis_attr(user->query_cor()),
        dis_attr(user->query_int()),
        dis_attr(user->query_spi()),
        dis_attr(user->query_cps()),
        dis_attr(user->query_per(), 1),
        dis_attr(user->query_con()),
        dis_attr(user->query_kar(), 1));
      write("您同意这组天赋数值吗？[n|y|q]");
      input_to("confirm_gift", ob, user);
      return;
    }

    varargs string dis_attr(int value, int no_value) {
      int gift = 20;
      if (no_value) {
        if (value > gift) return sprintf(HIY "%3s" NOR, "XX");
        else if (value < gift) return sprintf(CYN "%3s" NOR, "XX");
        else return sprintf("%3s", "XX");
      } else {
        if (value > gift) return sprintf(HIY "%3d" NOR, value);
        else if (value < gift) return sprintf(CYN "%3d" NOR, value);
        else return sprintf("%3d", value);
      }
    }


    varargs void enter_world(object ob, object user, int silent) {
      object cloth, room, mbx;
      string startroom = "";
      int num, bellicosit;

      reset_eval_cost();

      user->set_temp("link_ob", ob);
      ob->set_temp("body_ob", user);

      // 5/11/98 mon
      user->set_encoding(ob->query_encoding());

      exec(user, ob);
      /*
    // default wiz
   if( sizeof(SECURITY_D->query_wizlist()) == 0 ) {
       SECURITY_D->add_wiz(user->query("id"), "(admin)", "");
   }
*/

      if (ob->query("last_from")) {
        write(HIY "上次从：" + ob->query("last_from") + "登录\n");
        write(HIY "时　间：" + ctime(ob->query("last_on")));
      }
      write(HIG "\n\n\t目前权限：" + wizhood(user) + "\n" NOR);
      user->setup();

      // FoF 0-1-3
      ob->set("name", user->query("name"));
      if (ob->query_temp("input_time") == time())
        write(HIR "如果您使用Ｚｍｕｄ登录，请注意别把密码留在上面。\n" NOR);

      // In case of new player, we save them here right aftre setup
      // compeleted.
      user->save();
      ob->save();

      /*  if( user->query_temp("is_newbie") ) {
      object blocker;
      if( find_prover(user) )
         write(HIW "\n************************************************************\n"
            "重要信息：\n"
            "你是一个新玩家，根据" HIG MUD_NAME HIW "的规定，新玩家必须找一位老玩家作保证，\n"
            "才允许参加游戏。你的保证人是 " HIY + user->query("prover") + HIW
            "，请等候他（她）为你作证。\n"
            "************************************************************" NOR);
      else
         write(HIW "你是新玩家，你的身份还没有通过验证，不能正常参加游戏。\n" NOR);
      
      blocker = new("/obj/blocker");
      blocker->move(user);
   }
   */

      /*.   if (user->query("gender")=="女性")
        {
          cloth = new("/obj/loginload/skirt.lpc");
     cloth->move(user);
     cloth->wear();
          cloth = new("/obj/loginload/shoes.lpc");
     cloth->move(user);
     cloth->wear();
        }
        else
        cloth = new("/obj/loginload/linen.lpc");
     cloth->move(user);
     cloth->wear();
*/
      if (!silent) {
        if (file_size(MOTD) > 0)
          user->start_more(read_file(MOTD), 0);
        if (user->is_ghost())
          startroom = DEATH_ROOM;
        else if (strlen(startroom = user->query("startroom")) < 2)
          startroom = START_ROOM;
        if (!wizardp(user) && startroom[0..2] == "/u/") {
          startroom = START_ROOM;
          user->set("startroom", startroom);
        }
        //added by mon 10/27/97

        // the following 7 lines are aded by snowcat dec 10 1997
        if ((BAN_D->create_char_banned(query_ip_number(user)) == 1 ||
          BAN_D->is_banned(query_ip_number(user)) == 1) && !wizardp(user)) {
          user->move("/d/wiz/guest");
          log_file("ALLCONT", sprintf("%s from banned site\n", user->query("name")));
        } else if (!catch(load_object(startroom)))
          user->move(startroom);
        else {
          user->move(START_ROOM);
          startroom = START_ROOM;
          user->set("startroom", START_ROOM);
        }
        tell_room(startroom, user->query("name") + "连线进入这个世界。\n", ({ user }));

        //following 12 lines are modified by FoF (10/17/1999)
        if (user->query("bellicosity"))
          bellicosit += user->query("bellicosity");
        if (user->query("bellicosity_a"))
          bellicosit -= user->query("bellicosity_a");
        if (user->query("score"))
          bellicosit -= user->query("score");
        if (startroom == START_ROOM && bellicosit >= 200) {
          tell_room(
            startroom,
            message_vision(HIY "\n只见几个巡逻官兵冲了过来，喝道：哪里来的奸人，速速离城！接着把$N架走了。\n" NOR, user)
          );
          user->move("/d/changan/nbridge");
          tell_room("/d/changan/nbridge", message_vision(YEL "\n巡逻官兵连推带喝地把$N押了过来。\n" NOR, user));
          tell_room("/d/changan/nbridge", YEL "\n巡逻官兵向北离去。\n" NOR);
        }

        mbx = ob->query_temp("mbox_ob");
        if (!mbx) {
          mbx = new(MAILBOX_OB);
          mbx->set_owner(ob->query("id"));
        }
        num = mbx->query_new_mail();
        if (num > 0) {
          write(GRN + "\n顺风耳告诉你：有您" + chinese_number(num) +
            "封信！请到南城客栈来一趟．．．\n\n" + NOR);
        }
        destruct(mbx);
      }

      //added by FoF  Oct,1999
      mudage(user);
      // FoF 00-5-14
      call_out("log_usage", 1, user->query("id"), query_ip_number(user), "login");
      PAIMING_D->set_paiming(user);

      CHANNEL_D->do_channel(this_object(), "sys", sprintf("%s由%s连线进入。",
        user->name() + "(" + capitalize(user->query("id")) + ")", query_ip_name(user)));
      UPDATE_D->check_user(user);

      {
        object caishen;
        if (objectp(caishen = find_object("/d/wiz/npc/caishen"))) {
          caishen->check_one(user);
        }
      }
    }

    varargs void reconnect(object ob, object user, int silent) {
      user->set_temp("link_ob", ob);
      ob->set_temp("body_ob", user);

      // 5/11/98 mon
      user->set_encoding(ob->query_encoding());

      exec(user, ob);

      user->reconnect();
      if (!silent && !user->query("env/invisibility")) {
        tell_room(environment(user), user->query("name") + "重新连线回到这个世界。\n",
          ({ user }));
      }
      CHANNEL_D->do_channel(this_object(), "sys", sprintf("%s由%s重新连线进入。",
        user->query("name") + "(" + capitalize(user->query("id")) + ")", query_ip_name(user)));
      UPDATE_D->check_user(user);
    }

    int check_legal_id(string id)  // FoF changed (12/06/1999)
    {
      int i;
      string *legalid;

      i = strlen(id);

      if ((strlen(id) < 3) || (strlen(id) > 8)) {
        write("对不起，你的英文名字必须是 3 到 8 个英文字母。\n");
        return 0;
      }
      while (i--)
        if (id[i] < 'a' || id[i] > 'z') {
          write("对不起，你的英文名字只能用英文字母。\n");
          return 0;
        }
      legalid = explode(read_file(BANNED_ID), "\n");
      for (i = 0; i < sizeof(legalid); i++) {
        if (id == legalid[i]) {
          write("对不起，这种名字会造成其他人的困扰。\n");
          return 0;
        }
      }
      if (strlen(id) >= 4)
        for (i = 0; i < strlen(id) - 3; i++)
          if (id[i] == id[i + 1] && id[i] == id[i + 2] && id[i] == id[i + 3]) {
            write("对不起，请不要使用这样的名字。\n");
            return 0;
          }

      return 1;
    }

    int check_legal_name(string name)  // FoF changed (12/06/1999)
    {
      int i;
      string str_n = "丂★①ＡあイΨЖ↗㊣疈獱";

      i = strlen(name);

      if ((strlen(name) < 2) || (strlen(name) > 12)) {
        write("对不起，你的中文名字必须是 1 到 6 个中文字。\n");
        return 0;
      }
      while (i--) {
        if (name[i] <= ' ') {
          write("对不起，你的中文名字不能用控制字元。\n");
          return 0;
        }
        if (i % 2 == 0)
          if ((name[i] < str_n[0] || name[i + 1] < '@')
            || name[i] >= str_n[2] && name[i] <= str_n[18]
            || name[i] >= str_n[18] && name[i] <= str_n[20] && name[i + 1] > str_n[23]) {
            write("对不起，请您用「中文」取名字。\n");
            return 0;
          }
      }
      for (i = 0; i < sizeof(banned_name); i++) {
        if (sscanf(name, "%s" + banned_name[i], str_n)) {
          write("对不起，这种名字会造成其他人的困扰！。\n");
          return 0;
        }
      }

      return 1;
    }

    object find_body(string name) {
      object ob, *body;

      if (objectp(ob = find_player(name)))
        return ob;
      body = children(USER_OB);
      for (int i = 0; i < sizeof(body); i++) {
        ob = body[i];
        if (clonep(ob) && getuid(ob) == name && ob->query("max_gin") > 0)
          return ob;
        //check max_gin to avoid damaged user object.
      }
      return 0;
    }

    int set_wizlock(int level) {
      if (wiz_level(this_player(1)) <= level)
        return 0;
      if (geteuid(previous_object()) != ROOT_UID)
        return 0;
      wiz_lock_level = level;
      return 1;
    }

    private void mudage(object me) {
      int hrs, day, mon, age;
      string out_str;

      return;
      age = (int)me->query("mud_age");
      age /= 3600;
      hrs = age % 24;
      age /= 24;
      day = age % 30;
      mon = age / 30;

      out_str = (mon ? chinese_number(mon) + "月" : "") + (day ? chinese_number(day) + "天" : "") + (hrs ? chinese_number(hrs) + "小时" : "");
      if (strlen(out_str))
        write(HIG "你已经为西游正果奋斗" + out_str + "了。\n" NOR);
      /*
   if( (int)me->query("mud_age") - (int)me->query("mud_age_gift") >= 86400 ) {
      write(HIG"请到皇宫领一份小小的奖励。\n"NOR);
      if( (int)me->query("quest/reward") == 0 ) me->set("quest/reward", -1);
   }
*/
      return;
    }

    // FoF 00-5-14
    private int log_usage(string id, string ip_number, string mode) {
      IP_USAGE_D->log_ip(id, ip_number, mode);
      USAGE_D->log_id(id, ip_number, mode);
    }

