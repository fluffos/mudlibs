// "/u/oldcat/lijing/zhanyaojian.lpc"

#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create()
{
        set_name(HIY"斩妖剑"NOR, ({"zhanyao sword", "sword", "jian",
                "zhanyao"}));
        set_weight(10000);
        if( clonep() )
                set_default_object(__FILE__);
        else 
            {
                set("long","相传此乃与玉帝赐予李天王镇妖降魔的宝剑。\n");
                set("unit", "把");
     set("wield_msg",
"$n「唰」地从剑鞘中弹出，落入$N的手中，剑身立刻大放光芒。\n");
     set("unwield_msg",
"$N长吁了一口气，将手中的$n插入腰间。\n");
                set("value", 5000);
                set("weapon_prop/courage", 10);
             }
        init_sword(100);
        setup();
}