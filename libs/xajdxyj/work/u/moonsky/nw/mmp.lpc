#include <ansi.h>  //包含定义了颜色的库文件

inherit F_CLEAN_UP;  //继承"/feature/clean_up.lpc",cmds就要继承此类。

int main(object me, string arg)  //int main()相当于做NPC时用的create(),object me是使用
//命令的人（this_player()),string arg 当然是 cmds的参数
//比如"kill moonsky"中的"moonsky".
{
  object *ob, *target;  //定义两个物件组。
  int i;            //定义整型变量i
  string mefam, obfam;  //定义两个字符串变量。

  mefam = (string)me->query("family/family_name");
  if (mefam == 0)
    return notify_fail("你没有加入任何门派");
  ob = users();
  i = sizeof(ob);
  while (i--) {
    obbang = (string)ob[i]->query("family/family_name");
    if ((obbang != 0) && (obbang != "空") && (mebang == obbang)) {
      if (sizeof(target) == 0) {
        target = ({ ob[i] });
      } else {
        target += ({ ob[i] });
      }
    }
  }

  message("vision", HIW "【门派】" + me->name() + "：" + arg + "\n" NOR, target);
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : mmp

门派频道，说的话只有同门派的人能够看见.
HELP
  );
  return 1;
}
