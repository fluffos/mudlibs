int max_skill_level(object ob)
{  
   int s,i=0,maxlevel=1;
   string *str;
   userskills=ob->query_skills();
   if (!mapp(userskills)) return 20;
   str=keys(userskills);
   s=sizeof(str);
   if (s<2) return userskills[str[0]]; 
   while (s>0)
     {
       s-=1;
       i=userskills[str[s]];
       if (i>maxlevel) maxlevel=i;
     }
   if (maxlevel<20) maxlevel=20;
   return maxlevel;
}

int accountlevel(int turn,object ob)
{
   int level;
   level=max_skill_level(ob);
   level=(int)level*(80+turn*3)/100;
   return level;
}

string randomlocation(int i1)
{
   string *str1,*str2,loca;
   int i2,temp;
   str1=keys(allloca);
   str2=allloca[str1[i1]];
   i2=sizeof(str2);
   temp=random(i2);
   if (temp==0 || temp==i2) temp=1;
   loca=str2[0]+str2[temp];
   return loca;
}
      
int give_quests()
{
   object guaiob,userob;
   object me,who,tempob;
   int chooseguai,rewardpot,rewardexp,maxkee,turn;
   int questbusytime,giveuptime,guailevel;
   int temp,i1;
   string *strtemp,locastr;
   me=this_object();
   who=this_player();
   turn=who->query_temp("turn");
   giveuptime=who->query_temp("questtime2");
   questbusytime=who->query_temp("questtime1");
   if (who->query("combat_exp")<2000000)
     {
     	message_vision("$N对$n摇摇头道:你道行尚浅,本大圣的妖魔你是打不过的!\n",me,who);
     	return 1;
     }
   if ((int)who->query("potential") -(int)who->query("learned_points")>=100000  )
     {
     	message_vision("$N对$n摇摇头道:你现在应该潜心修炼,以达佛法最高境界.\n",me,who);
     	return 1;
     }	
   if (who->query_temp("kill"))
     {
       if (time()<giveuptime)
        {      
         message_vision ("$N对$n说道：这位"+RANK_D->query_respect(who)
          +"，老孙我不是请你去降服"+who->query_temp("guainame")+"吗？\n",me,who);
          return 1;
        }
        else turn=0;
     }
   else
     {
       if (time()<questbusytime) 
        {
        message_vision ("$N睁开火眼金睛朝凡间一看,对$n说道：\n"
        
        +"这位"+RANK_D->query_respect(who)+",妖魔已经搞定，不妨先去找点乐子。\n"
        ,me,who);
        return 1;
        }
      }
     
//每十二个怪算一轮，用turn 做参数
 //改为十个妖为一轮  
 if (!turn || turn>9||turn<0) 
      {
        who->set_temp("turn",0);
        turn=0;
      }
   turn=turn+1;
   guailevel=accountlevel(turn,who);
   guaiob=new("/u/moonsky/sun/questguai"); 
   
   guaiob->set_heart_beat(1);
   guaiob->set_temp("killername",(string)who->query("id"));
   guaiob->set("killer_id",(string)who->query("id"));
   

//设置怪的mana,force,exp,

   guaiob->set("max_force",guaif(turn,who));
   guaiob->set("force",(int)(guaif(turn,who)*5/3));
   guaiob->set("max_mana",guaim(turn,who));
   guaiob->set("combat_exp",aguaiexp(turn,who));
   guaiob->set("mana",(int)(guaim(turn,who)*4/3));
    guaiob->set("force_factor",(int)(guailevel*2/3));
         guaiob->set("mana_factor",(int)(guailevel*2/3));  
   set_guai_kee_sen(turn,guaiob);

//set guai's "long" and "title" 
  
    switch (random(3))
     {
      case 1 :
       guaiob->set("long","一头"+guaiob->query("name")
                +",在深谷中汲取万物精华，颇有了些道行。\n");break;
      case 2 :
       guaiob->set("long","一头"+guaiob->query("name")
              +"，修练了有"+chinese_number((int)(guaiob->query("combat_exp")/1000))
               +"年道行。它通体透出一丝仙气。\n");break;
      default :
       guaiob->set("long","一头"+guaiob->query("name")
              +"，修练了有"+chinese_number((int)(guaiob->query("combat_exp")/1000))
               +"年道行。它混身上下妖气逼人。\n");
     }
    
   chooseguai=random(10);
   setguaititle(chooseguai,guaiob);   

//rewardexp and rewardpot 是杀怪后得到的qn and exp
   
   rewardexp=getexp(turn,guailevel,who);
   rewardexp=rewardexp*7/32;
   rewardpot=rewardexp*7/32;
   guaiob->set_temp("killrewardpot",rewardpot);
   guaiob->set_temp("killrewardexp",rewardexp);
   guaiob->set_temp("player",who);
   guaiob->setguaiskill(chooseguai,guailevel,guaiob);
   guaiob->check_time();  

//确定怪的位置 
   strtemp=keys(allloca);
   i1=sizeof(strtemp);
   temp=random(i1);
   if (temp==i1) temp=0;
   locastr=randomlocation(temp);  
   tempob=load_object(locastr);

//if we get a wrong path,these can help us 
   if (!tempob) 
     {
      message_vision(HIR"$N发现好象有什么地方不对劲了，可是"
      +"又说不上来。\nwrong room :"+locastr+"\n"NOR,who);
      return 1;
     }
   guaiob->move(tempob);

//设置玩家的暂时参数
   who->set_temp("questtime1",time()+150); 
   who->set_temp("questtime2",time()+300);
   who->set_temp("guainame",guaiob->query("name"));
   who->set_temp("turn",turn);
   who->set_temp("kill",1);
   message_vision("$N对$n点了点头,然后睁开火眼金睛朝凡间看了看,\n",me,who);
   message_vision("$N对$n说道：近有"+HIW+guaiob->query("name")+NOR+"("
        +guaiob->query("id")+")在"
        +HIY+strtemp[temp]+NOR+"为非作歹，请速去降服！\n",me,who); 
   return 1;
}
int aguaiexp(int turn,object who)
{ 
   int userexp,guaiexp;
   userexp=who->query("combat_exp");
   guaiexp=userexp*(70+turn*5)/100;
   return guaiexp;
}

// guaif 计算怪的内力
int guaif(int turn,object who)
{
   int userforce,guaiforce;
   userforce=who->query("max_force");
   guaiforce=userforce*(90+turn*5)/100;
   return guaiforce;
}
int guaim(int turn,object who)
{
   int usermana,guaimana; 
   usermana=who->query("max_mana");
  guaimana=usermana*(90+turn*5)/100;
   return guaimana;
}
int set_guai_kee_sen(int turn,object guai)
{
   int maxkee,maxsen;
     maxkee=300+(int)guai->query("max_force")*(120+turn*20)/800;
     maxsen=300+(int)guai->query("max_mana")*(120+turn*8)/600;
   guai->set_temp("maxkee",maxkee);
   guai->set("max_kee",maxkee);
   guai->set("eff_kee",maxkee);
   guai->set("kee",maxkee);
   guai->set("max_sen",maxsen);
   guai->set("eff_sen",maxsen);
   guai->set("sen",maxsen);
   return 1;
}
//杀怪得到的exp,与玩家的skills ,exp,dx,turn 有关
int getexp(int turn,int level,object who)
{
   int exp,userexp;
   userexp=who->query("combat_exp");
   exp=50+random(60)+turn*70+turn*userexp/25000
         +who->query_temp("continue_kill_guai")*4*turn/10;
   return exp;
}

