#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)

{
        object weapon;
        if( !target ) target = offensive_target(me);
     if( !target
||      !target->is_character()
||      target->is_corpse()
||      target==me)
return notify_fail("你要对谁施展这一招"+HIR"「回风六剑」"+NOR"？\n");
if(!me->is_fighting())
return notify_fail(""+HIR"「回风六剑」"+NOR"只能在战斗中使用！\n");
if((int)me->query("max_force") < 1000 )
return notify_fail("你的内力不够！\n");
if((int)me->query("force") < 1000 )
return notify_fail("你的内力不足！\n");
if((int)me->query("sen") < 800 )
return notify_fail("你的精神不足，没法子施用外功！\n");
if((int)me->query_skill("snowsword", 1) < 120)
return notify_fail("你的风回雪舞剑法级别还不够，使用这一招会有困难！\n");

me->delete("env/brief_message");
target->delete("env/brief_message");
message_vision(HIC"\n$N嫣然一笑，随风而舞，$n不由得看呆了.\n  
$N突然脸色一变，突然间连续向$n刺出了六剑！\n"NOR,me,target);
write(HIR"\n第一剑！！！  \n"NOR);
me->set_temp("SW_perform", 3);
COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

write(HIR"\n第二剑！！！  \n"NOR);
me->set_temp("SW_perform", 4);  
COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 

write(HIR"\n第三剑！！！  \n"NOR);
me->set_temp("SW_perform", 6);
COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
write(HIR"\n第四剑！！！  \n"NOR);       
me->set_temp("SW_perform", 1);
COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
write(HIR"\n第五剑！！！  \n"NOR); 
me->set_temp("SW_perform", 5);
COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
write(HIR"\n第六剑！！！  \n"NOR);  
me->set_temp("SW_perform", 2);
COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

me->delete_temp("SW_perform");
me->receive_damage("sen", 400);
me->add("force", -400);

if( !target->is_fighting(me) ) {
if( living(target) ) {
if( userp(target) ) target->fight_ob(me);
else target->kill_ob(me);
}
}
me->start_busy(3);
return 1;
}
