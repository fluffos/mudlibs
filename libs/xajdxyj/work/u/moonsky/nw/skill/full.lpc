#include <combat.h>

#include <ansi.h>

int main(object me) {
  int var;
  me->set("food", (int)me->max_food_capacity() * 3 + random(120));
  me->set("water", (int)me->max_water_capacity() * 3 + random(120));
  var = me->query("max_kee");
  me->set("eff_kee", var);
  me->set("kee", var);
  var = me->query("max_sen");
  me->set("eff_sen", var);
  me->set("sen", var);
  var = me->query("max_force");
  me->set("force", var);
  var = me->query("max_mana");
  me->set("mana", var);
  write(HIC " OK!\n " NOR);

  return 1;
}

int help(object me) {
  write(@HELP

指令格式: full

这个指令用于恢复巫师的气血,精神,内力,法力.
HELP
  );
  return 1;
}
