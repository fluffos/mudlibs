// by txin


#include <ansi.h>


inherit SSERVER;

void free(object target);

int cast(object me, object target) {
  string msg;
  int success, ap, dp, howlong;

  if (!target) target = offensive_target(me);

  if ((int)me->query_skill("spells") < 60)
    return notify_fail("你还没学会卷鼻。\n");

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你想把谁定住？\n");

  if (target->query_temp("no_move"))
    return notify_fail(target->query("name") + "已经动弹不得了！\n");

  if ((int)me->query("mana") < 500)
    return notify_fail("你的法力不够！\n");

  if ((int)me->query("sen") < 50)
    return notify_fail("你无法集中精力！\n");

  me->add("mana", -200);
  me->receive_damage("sen", 50);

  msg = HIR "激战中,$N突然跳出圈外,大喝一声[白象尊者]何在!\n 只见半空中现出[白象尊者]巨大的身形,甩动长鼻向$n卷去! \n" NOR;

  success = 1;
  ap = me->query_skill("spells");
  ap = ap * ap * ap / 10;
  ap += (int)me->query("combat_exp");
  dp = target->query("combat_exp");
  if (random(ap + dp) < dp) success = 0;

  ap = (int)me->query("mana");
  dp = (int)target->query("mana");
  if (random(ap + dp) < dp) success = 0;

  howlong = 0;
  if (success == 1) {
    msg += HIR "结果$n被长鼻卷住，动弹不得。\n\n" NOR;
    target->set_temp("no_move", 1);

    howlong = 30 + random(10);
  } else
    msg += HIR "结果被$n躲了过去。\n\n" NOR;

  message_vision(msg, me, target);

  if (living(target)) target->kill_ob(me);
  if (success == 0) return 1 + random(2);
  if (howlong > 0) call_out("free", howlong, target);

  return 3 + random(5);
}

void free(object target) {
  if (target) target->delete_temp("no_move");
  return;
}
