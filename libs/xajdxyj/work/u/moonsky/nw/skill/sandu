//ningxie-force--sandu.c

#include <ansi.h>
inherit F_CLEAN_UP;

void remove_effect(object me, int amount);


int exert(object me, object target)
{ int skill;


        skill = me->query_skill("ningxie-force",1);
       if(me->query("family/family_name") != "大雪山")
                        return notify_fail("非大雪山弟子不会散毒。\n");
        if(me->query_skill("ningxie-force",1)<100)
                        return notify_fail("你的凝血神功还不够深厚,散毒会有危险。\n");

        if( (int)me->query("force") < 800 )
                return notify_fail("你的真气不够。\n");
              if( (int)me->query_temp("sandu") ) 
                return notify_fail("你已经在运功中了。\n");

         write( HIC "你眉头一皱，决定使毒！\n" NOR);
        me->add("force", -500);
        message("vision",
                HIC + me->name() +
"微一皱眉，运起凝血神功，身上立刻笼罩了淡淡的一股蓝雾。\n"
NOR,
                environment(me), me);

       me->set_temp("sandu",1);
        me->set("force_factor", 0);
        me->start_call_out( (: call_other, __FILE__, "remove_effect", me, skill/5 :), skill);
        return 1;
}

void remove_effect(object me, int amount)
{
        if(!me) return;       
        me->delete_temp("sandu");
        tell_object(me, "你的毒效已发挥完毕。\n");
}
