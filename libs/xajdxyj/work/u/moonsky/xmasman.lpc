// xmasman.c 圣诞老人
// FoF 99-12-25

inherit NPC;
#include <ansi.h>

object curr_user, new_user, curr_env;
int no_player = 0;

int MAX_MANA = 4000, SPELLS = 200, DAOXING = 1000000;
string *dirs = ({
  "/d/city/",
  "/d/changan/",
  "/d/eastway/",
  "/d/westway/",
  "/d/kaifeng/",
  "/d/gao/",
  "/d/4world/",
  "/d/sea/",
  "/d/nanhai/",
  "/d/moon/",
  "/d/erlang/",
  "/d/lingtai/",
  "/d/xueshan/",
  "/d/meishan/",
  "/d/qujing/wuzhuang/",
  "/d/qujing/baotou/",
  "/d/qujing/baoxiang/",
  "/d/qujing/bibotan/",
  "/d/qujing/biqiu/",
  "/d/qujing/chechi/",
  "/d/qujing/dudi/",
  "/d/qujing/fengxian/",
  "/d/qujing/firemount/",
  "/d/qujing/jilei/",
  "/d/qujing/jindou/",
  "/d/qujing/jinping/",
  "/d/qujing/jisaiguo/",
  "/d/qujing/maoying/",
  "/d/qujing/nuerguo/",
  "/d/qujing/pansi/",
  "/d/qujing/pingding/",
  "/d/qujing/qilin/",
  "/d/qujing/qinfa/",
  "/d/qujing/qinglong/",
  "/d/qujing/tianzhu/",
  "/d/qujing/tongtian/",
  "/d/qujing/wudidong/",
  "/d/qujing/wuji/",
  "/d/qujing/xiaoxitian/",
  "/d/qujing/yinwu/",
  "/d/qujing/yuhua/",
  "/d/qujing/zhujie/",
  "/d/qujing/zhuzi/",
});

int random_walk();
void find_obj();
void find_newplace();
void auto_recovery();
void move_away();
void do_give(object user);
int find_user();
object find_player();
void give_gift(object);
void new_y2kbug();
void cycle();

void create() {
  set_name(HIY "圣" HIG "诞" HIR "老" HIC "人" NOR, ({ "shengdan laoren", "laoren" }));
  set("gender", "男性");
  set("age", 60);
  set("long", "一位相貌和蔼可亲的老人，身后背着一个大包，哇噻！里面肯定有很多好东西！\n");
  set("attitude", "friendly");

  set("chat_chance", 15);
  set("chat_msg", ({
    (: random_walk :),
  }));

  set("str", 40);
  set("cor", 30);
  set("cps", 35);
  set("int", 35);

  set("max_kee", 5000);
  set("max_gin", 5000);
  set("max_sen", 5000);
  set("max_force", 5000);
  set("max_mana", MAX_MANA);
  set("mana", MAX_MANA);

  set("combat_exp", DAOXING);

  set_skill("spells", SPELLS);
  set_skill("force", 240);
  set_skill("unarmed", 240);
  set_skill("dodge", 500);
  set_skill("parry", 240);
  set_temp("apply/damage", 10000);

  setup();
  add_money("gold", 5);
  cycle();
}

void init() {
  ::init();
  if (wizardp(this_player())) {
    add_action("do_sleep", "merryxmas");
  }
}

int do_sleep(string str) {
  object who = this_player();

  if (!who) return 0;
  call_out("give_gift", 2, who);

  return 0;
}

int random_walk() {
  int ran;
  object *bug, user, me = this_object();

  bug = children("/u/fof/y2kbug");
  if (sizeof(bug) < 10) new_y2kbug();

  if (user = find_player()) call_out("give_gift", random(5), user);

  no_player++;
  if (no_player > 10) {
    no_player = 0;
    find_newplace();
    return 1;
  }
  // try move away.
  move_away();
  return 1;
}

object find_player() {
  object *obj, me = this_object(), ob;
  int size, i;

  obj = all_inventory(environment(me));
  size = sizeof(obj);
  if (size) {
    for (i = 0; i < size; i++) {
      if (userp(obj[i])) {
        ob = obj[i];
        if (random(3) == 0) return ob;
      }
    }
    if (ob) return ob;
  }
  return 0;
}

void move_away() {
  int i;

  find_newplace();
  return;
}

void give_gift(object ob) {
  object obj, *all_cake;

  if (!ob) return;
  if (!environment(ob) || environment(ob) != environment()) return;
  if (ob->query("year2000/newyear_gift") && ob->query("year2000/eat_cake") > 60)
    return;
  if (present("dan gao", ob)) return;
  all_cake = children("/u/fof/newyearcake");
  for (int i = sizeof(all_cake) - 1; i >= 0; i--)
    if (all_cake[i]->query("owner_id") == ob->query("id")) return;

  obj = new("/u/fof/newyearcake");
  obj->set_owner(ob);
  obj->move(ob);
  ob->add("year2000/newyear_gift", 1);
  command("say " + HIR "Happy " HIG "New " HIY "Year " HIB "to " HIM "you !" HIC " :-)" NOR);
  message_vision("$N" YEL "从背后的大包里挑出一样东西，是一个大蛋糕耶！\n" +
    "$N" YEL "对$n说道：新年到了，送你一份新年礼物吧！\n" +
    "$N" YEL "笑眯眯地把大蛋糕塞到$n怀里。\n" +
    HIY "这么好的礼物，可别弄丢了咯！\n" NOR, this_object(), ob);
  return;
}

void find_newplace() {
  object me = this_object();

  message_vision("$N背着一大包东西高高兴兴地走了。\n", me);

  if (find_user() && me->move(curr_env = environment(new_user))) {
    curr_user = new_user;
    command("sys current user is " + curr_user->query("id"));
    if (random(2) && new_user) give_gift(new_user);
  } else {
    curr_env = ({ "/d/city/center" })[random(1)];
    me->move(curr_env);
  }

  me->remove_all_killer();
  message_vision("$N背着一大包东西走了过来。\n", me);
  return;
}

int find_user() {
  object *users, ob, env;
  int size, i;

  users = children("/obj/user");
  size = sizeof(users);

  if (size > 1) {
    for (i = 0; i < 10; i++) {
      ob = users[random(size)];
      if (ob == curr_user) continue;
      if (!env = environment(ob)) continue;
      if (env == curr_env) continue;
      new_user = ob;
      return 1;
    }
  }
  return 0;
}

int accept_kill(object ob) {
  return notify_fail("新年到了，这么高兴的日子，你还是安分些吧！\n");
}

void unconcious() {
  die();
}

void die() {
  object killer;

  if (objectp(killer = query_temp("last_damage_from"))) {
    set_temp("my_killer", killer->query("id"));
    COMBAT_D->killer_reward(killer, this_object());
  }
  auto_recovery();
  find_newplace();
}

void auto_recovery() {
  object me = this_object();

  me->set("eff_gin", (int)me->query("max_gin"));
  me->set("gin", (int)me->query("max_gin"));
  me->set("eff_kee", (int)me->query("max_kee"));
  me->set("kee", (int)me->query("max_kee"));
  me->set("eff_sen", (int)me->query("max_sen"));
  me->set("sen", (int)me->query("max_sen"));

  me->set("force", (int)me->query("max_force"));
  me->set("atman", (int)me->query("max_atman"));
  me->set("mana", (int)me->query("max_mana"));
}

void new_y2kbug() {
  int i, j, k;
  mixed *file;
  object y2kbug, room;

  while (1) {  // pick up one directory
    i = random(sizeof(dirs));
    file = get_dir(dirs[i] + "*.lpc", -1);
    if (sizeof(file)) break;
  }

  k = sizeof(file);
  while (1) {
    j = random(k);
    if (file[j][1] > 0) break;  // pick up a file with size > 0
  }

  y2kbug = new("/u/fof/y2kbug");

  if ((room = find_object(dirs[i] + file[j][0]))) {
    y2kbug->move(room);
  } else {
    seteuid(getuid());
    room = load_object(dirs[i] + file[j][0]);
    if (room)
      y2kbug->move(room);
    else {
      destruct(y2kbug);
      return;
    }
  }
}

void cycle() {
  set_heart_beat(1);
  remove_call_out("cycle");
  call_out("cycle", 600);
}
