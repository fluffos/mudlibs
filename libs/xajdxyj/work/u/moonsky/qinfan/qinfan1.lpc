//Ansi 99.8
#include <ansi.h>
inherit NPC;

void create()
{       
   	int skill,j;
        object me=this_object();
   	set_name("米国间谍", ({ "jian die", "spyer"}) );
   	set("title","九级通缉犯");
      	set("age", 18+random(50));
      	j=120;
   	set("combat_exp",j*10000+random(600));
	set("max_kee",j*12+random(1001));
	set("max_sen",j*12+random(1001));
	set("max_force",j*12+random(1001));
	set("max_mana",j*12+random(1001));
	set("force",j*12+random(1001));
	set("mana",j*12+random(1001));
	set("force_factor",j-70);
	set("mana_factor", j-70);
	set("class","qinfan");
	set("reward_pot",j*2);
	set("env/wimpy", j/5);
	me->set_skill("unarmed", j);
        me->set_skill("dodge", j);
        me->set_skill("parry", j);
        me->set_skill("force", j);
        me->set_skill("spells", j);
 
        me->set_skill("fork", j+random(15));
        me->set_skill("fengbo-cha", j+random(15));
        me->set_skill("hammer",j+random(15));
        me->set_skill("huntian-hammer",j+random(15));
        me->set_skill("dragonstep", j+random(15));
        me->set_skill("dragonfight", j+random(15));
        me->set_skill("dragonforce", j+random(15));
        me->set_skill("seashentong", j+random(15));

        me->map_skill("force", "dragonforce");
        me->map_skill("fork", "fengbo-cha");
        me->map_skill("hammer","huntian-hammer");
        me->map_skill("parry", "huntian-hammer");
        me->map_skill("spells", "seashentong");
        me->map_skill("dodge", "dragonstep");
        me->map_skill("unarmed", "dragonfight");

         set("chat_chance_combat", j/4);
        set("chat_msg_combat", ({
        (: cast_spell, "freez" :),
        (: cast_spell, "breathe" :),
        (: exert_function, "roar" :),
        (: exert_function, "shield" :),
        }) );

        
      
       
       add_temp("apply/damage", 10+j/5);
       add_temp("apply/armor", 30+j/5);
   	setup();
	carry_object("/d/obj/weapon/hammer/jingua")->wield();
   	carry_object("/d/obj/cloth/jinpao.lpc")->wear();
}

