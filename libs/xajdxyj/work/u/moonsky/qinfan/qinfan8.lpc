//Ansi 99.8
#include <ansi.h>
inherit NPC;

void create()
{
   	int skill,j;
	object me=this_object();
   	set_name("大唐叛国犯", ({ "panguo fan", "fan"}) );
   	set("title","二级通缉犯");
      	set("age", 18+random(50));
      	j=260;
   	set("combat_exp",j*10000+random(600));
	set("max_kee",j*12+random(1001));
	set("max_sen",j*12+random(1001));
	set("max_force",j*12+random(1001));
	set("max_mana",j*12+random(1001));
	set("force",j*12+random(1001));
	set("mana",j*12+random(1001));
	set("force_factor",j-70);
	set("mana_factor", j-70);
	set("class","qinfan");
	set("reward_pot",j*2);
	set("env/wimpy", j/5);
       me->set_skill("unarmed", j);
        me->set_skill("dodge", j);
        me->set_skill("parry", j);
        me->set_skill("force", j);
        me->set_skill("spells", j);
 
        me->set_skill("blade", j+random(15));
        me->set_skill("kugu-blade", j+random(15));
        me->set_skill("sword",j+random(15));
        me->set_skill("qixiu-jian",j+random(15));
        me->set_skill("lingfu-steps", j+random(15));
        me->set_skill("yaofa", j+random(15));
        me->set_skill("huntian-qigong", j+random(15));
        me->set_skill("yinfeng-zhua", j+random(15));

        me->map_skill("force", "huntian-qigong");
        me->map_skill("blade", "kugu-blade");
        me->map_skill("sword","qixiu-jian");
        me->map_skill("parry", "kugu-blade");
        me->map_skill("spells", "yaofa");
        me->map_skill("dodge", "lingfu-steps");
        me->map_skill("unarmed", "yinfeng-zhua");

                  set("chat_chance_combat", j/4);
        set("chat_msg_combat", ({
        (: cast_spell, "huanying" :),
        (: cast_spell, "suliao" :),
     (: cast_spell, "tudun" :),
        }) );

        

       add_temp("apply/damage", 10+j/5);
       add_temp("apply/armor", 30+j/5);
   	setup();
	carry_object("/d/obj/weapon/blade/jindao")->wield();
   	carry_object("/d/obj/cloth/jinpao.lpc")->wear();
}

