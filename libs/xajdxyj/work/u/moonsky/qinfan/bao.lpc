//Ansi 99.8
inherit NPC;
#include <ansi.h>
#include "location.h"

string *list = ({ "qinfan1", "qinfan2", "qinfan3",
  "qinfan4", "qinfan5", "qinfan6",
  "qinfan7", "qinfan8",
  "qinfan9",
});
string ask_me(object me);
string chinese_daoxing(int gain);
string randomlocation(int i1);
void create() {
  set_name("海大帅", ({ "hai dashuai", "hai", "dashuai" }));
  set("title", "大唐监狱总管");
  set("nickname", HIY "刚刚我升级了,现在是2.1版." NOR);
  set("age", 55);
  set("str", 40);
  set("per", 30);
  set("cor", 20);
  set("cps", 20);
  set("class", "officer");
  set("long", "
他就是闻名海内外的海大帅啊，看帅不帅???
");
  set("combat_exp", 800000);
  set_skill("sword", 90);
  set_skill("force", 90);
  set_skill("xiaofeng-sword", 110);
  set_skill("dodge", 150);
  set_skill("parry", 150);
  set_skill("spells", 60);
  set_skill("literate", 80);
  set_skill("ghost-steps", 150);
  set_skill("lengquan-force", 80);
  map_skill("force", "lengquan-force");
  map_skill("sword", "xiaofeng-sword");
  map_skill("parry", "xiaofeng-sword");
  map_skill("dodge", "ghost-steps");
  set("max_sen", 1500);
  set("max_kee", 1500);
  set("force", 2000);
  set("max_force", 1200);
  set("force_factor", 40);
  set("max_mana", 1000);
  set("mana", 1000);
  set("mana_factor", 40);
  set("inquiry", ([
    "抓拿钦犯": (: ask_me :),
    "钦犯": (: ask_me :),

  ]));

  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: exert_function, "jingxin" :),
  }));

  setup();
  carry_object("/d/obj/weapon/sword/qingfeng.lpc")->wield();
  carry_object("/d/obj/cloth/baipao.lpc")->wear();
}

string ask_me(object me) {

  if (this_player()->query("combat_exp") > 5000000)
    return "你都成大虾了，我哪敢劳师动众啊！";
  if (me->query_temp("zhua_qinfan"))
    return "上一批钦犯还没有全抓到！";
  if (me->query_temp("zhua_time") > 10)
    return "哪里有这么多钦犯可以抓！";
  command("grin");
  command("say 这要看你会不会做啦。");
  this_player()->add_temp("ask_qinfan", 1);
  return "你一定知道我喜欢什么的！";
}

int accept_fight(object me) {
  command("say 老夫久未和江湖人动手过招了，今日也不想破例。");
  return 0;
}

int accept_object(object who, object ob) {
  object me = this_object();
  int exp, pot, wpot, val, place;
  string str, place_name, place_id;
  string *strtemp, locastr;
  int temp, i1;
  object qin, tempob;
  val = ob->value();
  if (!me->query_temp("zhua_qinfan") && who->query_temp("ask_qinfan")) {
    if (val && val > 9999) {
      tell_object(who, "说道：就给你一个任务吧．．\n");
      me->add_temp("zhua_time", 1);
      //	place = (int)random(3)+1;
      //确定怪的位置 
      strtemp = keys(allloca);
      i1 = sizeof(strtemp);
      temp = random(i1);
      if (temp == i1) temp = 0;
      locastr = randomlocation(temp);
      tempob = load_object(locastr);

      //if we get a wrong path,these can help us 
      if (!tempob) {
        message_vision(HIR "$N发现好象有什么地方不对劲了，可是"
          + "又说不上来。\nwrong room :" + locastr + "\n" NOR, who);
        return 1;
      }
      qin = new(__DIR__ + list[random(sizeof(list))]);
      qin->move(tempob);



      who->delete_temp("ask_qinfan");
      me->set_temp("zhua_qinfan", 1);
      CHANNEL_D->do_channel(
        me,
        "xyj",
        "皇上有令，现有" + qin->name() + "(" + qin->query("id") + ")逃窜在外，最大恶极，格杀勿论！\n"
      );
      return 1;
    } else return 0;
  }
  if (me->query_temp("zhua_qinfan")) {
    if (who->query("mud_age", 1) < 86400 * 2) {
      command("say " + who->query("name") + "你还是小孩子，不要到这里来玩啊!");
      return 0;
    }
    if (who->query("combat_exp", 1) < 100000) {
      command("say " + who->query("name") + "你的道行不太够啊，这不太可能是你抓的吧!");
      return 0;
    }


    if (who->query("zhua_qinfan_wait", 1) > time()) {
      command("say " + who->query("name") + "，你刚刚抓过，还是先休息一会儿吧！");
      return 0;
    }
    if (ob->query("class") == "qinfan") {
      command("say 好，压下去！");
      message_vision("只见几个狱卒快手快脚，把人犯给压了进去！\n", who);
      exp = ob->query("reward_pot") * 3 + random(50);
      pot = ob->query("reward_pot") + random(60);
      wpot = ob->query("reward_pot") / 40;
      str = chinese_daoxing(exp);
      who->add("combat_exp", exp);
      who->add("potential", pot);
      who->add("wwscore", wpot);
      who->add("zhua_qinfan_time", 1);
      who->set("zhua_qinfan_wait", time() + 300 + random(301));
      tell_object(who, HIW "你被奖励了：\n" +
        str + "道行\n" +
        chinese_number(pot) + "点潜能\n" +
        chinese_number(wpot) + "点江湖威望\n" NOR);
      CHANNEL_D->do_channel(me, "xyj", who->query("name") + "抓到通缉犯，获得"
        +chinese_daoxing(exp) + "点道行,\n" + chinese_number(pot) + "点潜能和" + chinese_number(wpot) + "点江湖威望！");
      me->delete_temp("zhua_qinfan");
      return 1;
    }
    if (ob->query("mark") == "toulu") {
      command("say 好，拿下去！");
      message_vision("只见几个狱卒走过来，拿走了通缉犯的头颅！\n", who);
      exp = ob->query("reward_pot") * 3 + random(50);
      pot = ob->query("reward_pot") + random(60);
      wpot = ob->query("reward_pot") / 40;
      exp = exp * 4 / 5;
      pot = pot * 4 / 5;
      wpot = wpot * 4 / 5;
      str = chinese_daoxing(exp);
      who->add("combat_exp", exp);
      who->add("potential", pot);
      who->add("wwscore", wpot);
      who->add("zhua_qinfan_time", 1);
      who->set("zhua_qinfan_wait", time() + 300 + random(301));
      tell_object(who, HIW "你被奖励了：\n" +
        str + "道行\n" +
        chinese_number(pot) + "点潜能\n" +
        chinese_number(wpot) + "点江湖威望\n" NOR);
      CHANNEL_D->do_channel(me, "xyj", who->query("name") + "杀死通缉犯，获得"
        +chinese_daoxing(exp) + "点道行,\n" + chinese_number(pot) + "点潜能和" + chinese_number(wpot) + "点江湖威望！");
      me->delete_temp("zhua_qinfan");
      return 1;
    }
    command("shake " + who->query("id"));
    return 0;
  }
  return 1;
}

string chinese_daoxing(int gain) {
  int year, day, hour;
  string str;

  year = gain / 1000;
  day = (gain - year * 1000) / 4;
  hour = (gain - year * 1000 - day * 4) * 3;
  str = "";
  if (year) str = str + chinese_number(year) + "年";
  if (day) str = str + chinese_number(day) + "天";
  if (hour) str = str + chinese_number(hour) + "时辰";

  return str;
}
string randomlocation(int i1) {
  string *str1, *str2, loca;
  int i2, temp;
  str1 = keys(allloca);
  str2 = allloca[str1[i1]];
  i2 = sizeof(str2);
  temp = random(i2);
  if (temp == 0 || temp == i2) temp = 1;
  loca = str2[0] + str2[temp];
  return loca;
}
