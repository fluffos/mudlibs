//Ansi 99.8
#include <ansi.h>
inherit NPC;

void create() {
  int skill, j;
  object me = this_object();

  set_name("荒淫和尚", ({ "huangyin heshang", "heshang" }));
  set("title", "一级通缉犯");
  set("age", 18 + random(50));
  j = 280;
  set("combat_exp", j * 10000 + random(600));
  set("max_kee", j * 12 + random(1001));
  set("max_sen", j * 12 + random(1001));
  set("max_force", j * 12 + random(1001));
  set("max_mana", j * 12 + random(1001));
  set("force", j * 12 + random(1001));
  set("mana", j * 12 + random(1001));
  set("force_factor", j - 70);
  set("mana_factor", j - 70);
  set("class", "qinfan");
  set("reward_pot", j * 2);
  set("env/wimpy", j / 5);
  me->set_skill("unarmed", j);
  me->set_skill("dodge", j);
  me->set_skill("parry", j);
  me->set_skill("force", j);
  me->set_skill("spells", j);

  me->set_skill("staff", j + random(15));
  me->set_skill("lunhui-zhang", j + random(15));
  me->set_skill("lotusmove", j + random(15));
  me->set_skill("buddhism", j + random(15));
  me->set_skill("jienan-zhi", j + random(15));
  me->set_skill("lotusforce", j + random(15));

  me->map_skill("force", "lotusforce");
  me->map_skill("staff", "lunhui-zhang");
  me->map_skill("parry", "lunhui-zhang");
  me->map_skill("spells", "buddhism");
  me->map_skill("dodge", "lotusmove");
  me->map_skill("unarmed", "jienan-zhi");

  set("chat_chance_combat", j / 4);
  set("chat_msg_combat", ({
    (: cast_spell, "bighammer" :),

    (: cast_spell, "yinshen" :),
  }));


  add_temp("apply/damage", 10 + j / 5);
  add_temp("apply/armor", 30 + j / 5);
  setup();
  carry_object("/d/obj/weapon/staff/budd_staff")->wield();
  carry_object("/d/obj/cloth/jinpao.lpc")->wear();
}
