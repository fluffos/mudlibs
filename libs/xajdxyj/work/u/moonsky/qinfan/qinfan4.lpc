//Ansi 99.8
#include <ansi.h>
inherit NPC;

void create() {
  int skill, j;
  object me = this_object();
  set_name("黑店老板", ({ "killer boss", "boss" }));
  set("title", "六级通缉犯");
  set("age", 18 + random(50));
  j = 180;
  set("combat_exp", j * 10000 + random(600));
  set("max_kee", j * 12 + random(1001));
  set("max_sen", j * 12 + random(1001));
  set("max_force", j * 12 + random(1001));
  set("max_mana", j * 12 + random(1001));
  set("force", j * 12 + random(1001));
  set("mana", j * 12 + random(1001));
  set("force_factor", j - 70);
  set("mana_factor", j - 70);
  set("class", "qinfan");
  set("reward_pot", j * 2);
  set("env/wimpy", j / 5);
  me->set_skill("unarmed", j);
  me->set_skill("dodge", j);
  me->set_skill("parry", j);
  me->set_skill("force", j);
  me->set_skill("spells", j);

  me->set_skill("spear", j + random(15));
  me->set_skill("bawang-qiang", j + random(15));
  me->set_skill("axe", j + random(15));
  me->set_skill("sanban-axe", j + random(15));
  me->set_skill("yanxing-steps", j + random(15));
  me->set_skill("changquan", j + random(15));
  me->set_skill("lengquan-force", j + random(15));
  me->set_skill("baguazhou", j + random(15));

  me->map_skill("force", "lengquan-force");
  me->map_skill("axe", "sanban-axe");
  me->map_skill("spear", "bawang-qiang");
  me->map_skill("parry", "bawang-qiang");
  me->map_skill("spells", "baguazhou");
  me->map_skill("dodge", "yanxing-steps");
  me->map_skill("unarmed", "changquan");

  set("chat_chance_combat", j / 4);
  set("chat_msg_combat", ({
    (: perform_action, "axe", "sanban" :),
    (: exert_function, "jingxin" :),
  }));



  add_temp("apply/damage", 10 + j / 5);
  add_temp("apply/armor", 30 + j / 5);
  setup();
  carry_object("/d/obj/weapon/axe/huafu")->wield();
  carry_object("/d/obj/cloth/jinpao.lpc")->wear();
}
