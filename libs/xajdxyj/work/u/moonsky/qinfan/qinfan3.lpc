//Ansi 99.8
#include <ansi.h>
inherit NPC;

void create() {
  int skill, j;
  object me = this_object();

  set_name("黑手歌星", ({ "bad singer", "singer" }));
  set("title", "七级通缉犯");
  set("age", 18 + random(50));
  j = 160;
  set("combat_exp", j * 10000 + random(600));
  set("max_kee", j * 12 + random(1001));
  set("max_sen", j * 12 + random(1001));
  set("max_force", j * 12 + random(1001));
  set("max_mana", j * 12 + random(1001));
  set("force", j * 12 + random(1001));
  set("mana", j * 12 + random(1001));
  set("force_factor", j - 70);
  set("mana_factor", j - 70);
  set("class", "qinfan");
  set("reward_pot", j * 2);
  set("env/wimpy", j / 5);
  me->set_skill("unarmed", j);
  me->set_skill("dodge", j);
  me->set_skill("parry", j);
  me->set_skill("force", j);
  me->set_skill("spells", j);

  me->set_skill("whip", j + random(15));
  me->set_skill("hellfire-whip", j + random(15));
  me->set_skill("stick", j + random(15));
  me->set_skill("kusang-bang", j + random(15));
  me->set_skill("ghost-steps", j + random(15));
  me->set_skill("jinghun-zhang", j + random(15));
  me->set_skill("tonsillit", j + random(15));
  me->set_skill("gouhunshu", j + random(15));

  me->map_skill("force", "tonsillit");
  me->map_skill("whip", "hellfire_whip");
  me->map_skill("stick", "kusang-bang");
  me->map_skill("parry", "kusang-bang");
  me->map_skill("spells", "gouhunshu");
  me->map_skill("dodge", "ghost-steps");
  me->map_skill("unarmed", "jinghun-zhang");

  set("chat_chance_combat", j / 4);
  set("chat_msg_combat", ({
    (: perform_action, "whip", "three" :),
    (: cast_spell, "gouhun" :),
    (: exert_function, "sheqi" :),
  }));


  add_temp("apply/damage", 10 + j / 5);
  add_temp("apply/armor", 30 + j / 5);
  setup();
  carry_object("/d/obj/weapon/whip/tielian")->wield();
  carry_object("/d/obj/cloth/jinpao.lpc")->wear();
}
