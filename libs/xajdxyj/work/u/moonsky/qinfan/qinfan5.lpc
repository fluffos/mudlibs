//Ansi 99.8
#include <ansi.h>
inherit NPC;

void create()
{
   	int skill,j;
	object me=this_object();
   	set_name("杜十二娘", ({ "du niang", "niang"}) );
   	set("title","五级通缉犯");
      	set("gender", "女性");
      	set("age", 18+random(50));
      	j=200;
   	set("combat_exp",j*10000+random(600));
	set("max_kee",j*12+random(1001));
	set("max_sen",j*12+random(1001));
	set("max_force",j*12+random(1001));
	set("max_mana",j*12+random(1001));
	set("force",j*12+random(1001));
	set("mana",j*12+random(1001));
	set("force_factor",j-70);
	set("mana_factor", j-70);
	set("class","qinfan");
	set("reward_pot",j*2);
	set("env/wimpy", j/5);
        me->set_skill("unarmed", j);
        me->set_skill("dodge", j);
        me->set_skill("parry", j);
        me->set_skill("force", j);
        me->set_skill("spells", j);
 
        me->set_skill("whip", j+random(15));
        me->set_skill("jueqingbian", j+random(15));
        me->set_skill("sword",j+random(15));
        me->set_skill("snowsword",j+random(15));
        me->set_skill("moondance", j+random(15));
        me->set_skill("moonshentong", j+random(15));
        me->set_skill("baihua-zhang", j+random(15));
        me->set_skill("moonforce", j+random(15));

        me->map_skill("force", "moonforce");
        me->map_skill("sword", "snowsword");
        me->map_skill("whip","jueqingbian");
        me->map_skill("parry", "jueqingbian");
        me->map_skill("spells", "moonshentong");
        me->map_skill("dodge", "moondance");
        me->map_skill("unarmed", "baihua-zhang");

                   set("chat_chance_combat", j/4);
        set("chat_msg_combat", ({
        (: cast_spell, "arrow" :),
        (: cast_spell, "mihun" :),
        }) );

       
       add_temp("apply/damage", 10+j/5);
       add_temp("apply/armor", 30+j/5);
   	setup();
	carry_object("/d/obj/weapon/sword/qingfeng")->wield();
   	carry_object("/d/obj/cloth/jinpao.lpc")->wear();
}

