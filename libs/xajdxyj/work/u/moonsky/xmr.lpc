void create()

{
	  set_name("小梅儿", ({ "xiao meier","xmr" }));
          set("long",
          MAG"只见她一张瓜子脸，清丽无伦，一双乌溜溜的大眼晶光灿烂，
              闪烁如星，流波转盼，灵活之极，似乎单是一双眼睛便能说
              话一般，她言笑晏晏，让人一见顿生亲近之意。\n"NOR);

        set("title",MAG"聊天协会"NOR);
        set("nickname", HIM"爱漂亮的"NOR);
        set("gender", "女性");
        set("age", 17);
        set("attitude", "friendly");
        set("str", 30);
        set("int", 30);
        set("con", 30);
        set("dex", 30);
        set("per" ,30);
        set("max_kee", 100000);
        set("max_gin", 100000);
        set("max_sen", 100000);
        set("force", 100000);
        set("max_force", 100000);
        set("force_factor", 100000);
        set("max_mana", 100000);
        set("mana", 100000);
        set("combat_exp", 500000000000);
        set("chat_chance", 10);
        set("chat_msg", ({

            "小梅儿笑咪咪地说：我最愿意交朋友了，你愿意和我聊天吗?\n",

            "小梅儿朝你顽皮地扮了个鬼脸: 可别忘了复习功课，mud慢慢玩不要紧?\n",
            "小梅儿振臂高呼：打倒恶性PK！\n",
         (: random_move :) 

     }) );
     
  set("inquiry", (

       [ "name":   "我叫小梅儿呵，你不知道吗。\n",

        "moonsky":   "月天是我和莫小言的好朋友，他吗，谁能嫁给他可是福气了。\n",

        "dancing":   "莫小言是个可爱的女孩哦，她很喜欢朋友的!\n",

        "莫小言":   "莫小言是个可爱的女孩哦，她很喜欢朋友的!\n",
        "admin":   "天神都不知道，该打，他在到处逛呢，不好找!\n",
        "marry" : (: give_flower :),
        "求婚" : (: give_flower :),
       "all":  "我知道的消息有:\n

       name,moonsky,dancing,莫小言, admin,求婚,marry,\n",

     

]));


        set("no_flower", 0);


        setup();
 if( clonep() ) CHANNEL_D->register_relay_channel("chat");

       carry_object("/d/obj/cloth/shoes")->wear();

       carry_object("/d/obj/cloth/xianyi")->wear();

//       carry_object("/d/obj/weapon/sword/tianshen")->wield();

}

