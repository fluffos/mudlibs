string give_flower(object me)

{
 me=this_player();
   me->set_temp("need_flower", 1);


   return "怎么，你要向心爱的人求婚了吗(yes)？\n";
}



void init()


{

 
   object ob;



        ::init();
      if( interactive(ob = this_player()) && !is_fighting() )

         {


                remove_call_out("greeting");

                call_out("greeting", 1, ob);

   
}

  add_action("do_yes", "yes");

  add_action("do_kill",({"kill","fight","steal"}));


 

}

int do_yes(string arg)
{
   object ob;



   ob=this_player();


   
   if(ob->query_temp("need_flower")) 

   {

     message_vision("$N脸上一阵飞红，害羞地说：嗯！\n\n", ob);

     if( query("no_flower") == 0 )

     {

        message_vision("小梅儿笑着说：好！那这一束花快送给她吧！\n", ob);
   ob->set_temp("need_flower", 0);



        carry_object("/d/obj/flower/rose999");

        command("give flower to " + ob->query("id"));

        set("no_flower", 1);



        call_out("regenerate", 480);
     }
     else

     {

        message_vision("小梅儿说道：今天真是个好日子，这么多人结婚，花都送完了。\n", ob);
 }




     return 1;

   }

   return 0;
}




int regenerate()

{
   set("no_flower", 0);
 return 1;

}

void greeting(object ob)


{






        if( !ob || !visible(ob) || environment(ob) != environment() ) return;

        if( ob->query("id")=="moonsky")
        { say("小梅儿高兴地说："+ob->query("name")+"我好想你呵!\n");
           command("jump"+ob->query("id"));
            return;}


        switch( random(6) ) {

                case 0:
   say( "小梅儿笑咪咪地说：" +

ob->query("name")

                                + "，功课做完了吗， 可别逃课呵？\n");


                        break;
                case 1:

                        command ("face " + ob->query("id") );

                        break;



                case 2:
                        command ("hi " + ob->query("id") );
                        break;

 case 3:

                        command ("xixi " + ob->query("id") );



                       break;
                case 4:
                        command ("look " + ob->query("id") );


                        break;

                case 5:
                        say( "小梅儿笑咪咪地说：" +

ob->query("name")+ "跟我聊天好吗，我们做个朋友吧!\n");

                        break;
        }




}



int do_kill(string arg)



{       

   object ob,who;
   string name,verb,what,obj;
   if (!arg) return 0;
   verb=query_verb();

   ob=this_player();
   if(verb=="steal") {



     if(sscanf(arg, "%s from %s", what, obj)!=2 ) 
       return 0;
          }
        else obj=arg;

   if(!objectp(who=present(obj,environment(ob))) 

      || !living(who)) return 0;

//   if(who->query("is_baby")) {

   if(who==this_object()) {

     switch(verb) {

       case "kill":
//         command("chat* "+

         tell_object(environment(this_object()),

           who->query("name")+"叹了口气"+

                ob->query("name")+"要杀我，这可是你自寻死路,怪不得我！\n");


         break;
            case "fight":

//         command("chat* "+

         tell_object(environment(this_object()),
 who->query("name")+"看了"+

                ob->query("name")+"一眼，摇了摇头：你不是我对手，女孩家不打架的！\n");

              break;

       case "steal":

//         command("chat* "+

         tell_object(environment(this_object()),

     who->query("name")+"大叫起来："+

     ob->query("name")+"，你再这样我就不客气了！\n");

              break;

          }
    }



        command(verb);



   return 0;

}

int accept_object(object me, object ob)
{


   

     if ((string)ob->query("id")=="flower") {
            command("say " + RANK_D->query_respect(me) + "太谢谢你了。\n");
            command("wear flower");

            //command("give guo to " + me->query("id"));
               return 1;


        }

}
