//moonsky
 
inherit NPC;
void new_cake();
void do_announce();
void create()
{
        set_name("风之鹰者", ({ "winyard" }));
        set("age", 20);
        set("gender", "男性");
        set("long","他就是月天。\n");
        set("attitude", "peaceful");
   set("str", 40);
        set("combat_exp", 20000);
   set("max_kee", 400);
   set("max_sen", 400);
   set("max_force", 200);
   set("force", 200);
   set("force_factor", 10);
        set_skill("unarmed", 40);
        set_skill("dodge", 40);
        set_skill("parry", 40);
        set_skill("blade", 40);
        set_skill("force", 40);

        setup();
        carry_object("/d/obj/weapon/blade/blade")->wield();
        carry_object("/d/obj/cloth/bingfu")->wear();
        call_out("new_cake", 1);
     call_out("do_announce",1);

}
void new_cake()
{      object xman;
	remove_call_out("new_cake");
	
        
	xman=new("/u/moonsky/xmasman");
	xman->move(environment(this_object()));
	CHANNEL_D->do_channel( this_object(), "sys", "圣诞老人重现江湖！\n");

	call_out("new_cake",1800+random(600));
}
void do_announce()
{
               object me = this_object();
             CHANNEL_D->do_channel( this_object(), "xyj", "最近交大网络中心不知道为何常停电。\n");
              CHANNEL_D->do_channel( this_object(), "xyj", "请大家即时备份自己的档案。\n");
           CHANNEL_D->do_channel( this_object(), "xyj", "档案有错的post在国宾观，集中解决。\n");
                   CHANNEL_D->do_channel( this_object(), "xyj", "莫须有的申报，会给予处罚，谢谢合作。\n");        
               remove_call_out("do_announce");
              call_out("do_announce",600+random(300));
}
	
	

