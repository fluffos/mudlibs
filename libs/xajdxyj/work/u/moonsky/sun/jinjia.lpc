// jinjia.c 金甲
#include <armor.h>
#include <ansi.h>
inherit F_UNIQUE;
inherit ARMOR;

void create()
{
        set_name(HIM"七"HIR"彩"HIY"金甲"NOR, ({"qicai jinjia","jinjia"}));
        set_weight(30000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
		set("long", "一件七蔡金线织就的宝甲．\n");
                set("material", "steel");
                set("value", 20000);
                set("replace_file", "/d/obj/armor/jinjia");
                set("armor_prop/armor", 100);
		set("armor_prop/dodge", -5);
        }
        setup();
}


