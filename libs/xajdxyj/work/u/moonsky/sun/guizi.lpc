// FoF copy from FY3 (11/01/1999)

#include <ansi.h>
inherit NPC;
void do_chat();

void create()
{
    set_name("日本鬼子", ({ "riben guizi", "guizi" }) );
    set("long", "一个满脸横肉的家伙。\n");
    set("attitude", "aggressive");
    set("vendetta/authority", 1);
    set("cor", 30);
    set("str", 25);
    set("cps", 20);
    set("per", 13);
    set("con", 20);
//    set("agi", 40);
    set("pursuer",1);
    set("combat_exp", 20000 + random(20000));
    set("bellicosity", 2000);
    set("chat_chance", 50);
    set("chat_msg", ({
        (: random_move :),
        (: do_chat :),
    }) );

    set("chat_chance_combat", 50);
    set("chat_msg_combat", ({
       (: random_move :),
    }) );

    set_skill("unarmed", 60 + random(40));
    set_skill("parry", 60 + random(40));
    set_skill("dodge", 60 + random(40));
    set_skill("spear", 60 + random(40));
    set_temp("apply/attack", 20);
    set_temp("apply/defense", 20);
    set_temp("apply/armor", 20);
    set_temp("apply/damage", 20 + random(10));
    set_temp("apply/move", 20);

    setup();

    carry_object("/u/fof/guizi_cloth")->wear();
    carry_object("/u/fof/guizi_gun")->wield();
}
void init()
{
    remove_call_out("hunting");
    if( !environment()->query("no_fight") )
        call_out("hunting",3);
}

void hunting()
{
    int i;
    object *ob;

    ob = all_inventory(environment());
    if( !sizeof(ob) ) return;
    for( i = sizeof(ob) - 1; i >= 0; i -- ) {
        if( !ob[i]->is_character() || ob[i] == this_object() || !living(ob[i]) ) continue;
        if( ob[i]->query("vendetta/authority") ) continue;
        if( userp(ob[i]) && random(ob[i]->query("bellicosity")) < 50 ) continue;
        command("heng");
        command("emote 喝道：你的——什么的干活！！\n"),
        kill_ob(ob[i]);
        ob[i]->fight(this_object());
    }
}

void do_chat()
{
	if( !random(10) )
        CHANNEL_D->do_channel( this_object(), "rumor", "鬼子进村啦！\n");
	return;
}

int accept_fight()
{
    object who = this_player();

    if( who->query("gender") == "女性" )
        write("日本鬼子笑道：啊～呀～～！花～姑娘！我的喜欢！！\n");
    else
        write("日本鬼子叫道：爸哥呀鲁！胆敢冒犯皇军！死啦死啦的！！\n");
    this_object()->kill_ob(who);
    return 1;
}

int die()
{
	object killer;

    if( objectp(killer = query_temp("last_damage_from")) ) {
        if( userp(killer) ) {
            set_name("欢乐园爱国会", ({ "agh" }) );
            CHANNEL_D->do_channel( this_object(), "chat", killer->query("name") + "打败作恶多端的日本鬼子，为欢乐园做出贡献！\n");
            set_name("日本鬼子", ({ "riben guizi", "guizi" }) );
        	killer->add("potential", 100+random(50));
        }
    }
	return ::die();
}

