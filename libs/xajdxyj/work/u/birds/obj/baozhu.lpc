// newcard.c
#include <ansi.h>;
#include <command.h>;
inherit ITEM;

void create() {
  set_name(HIR "二踢脚" NOR, ({ "pao zhang" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long",
      "这是一个" HIR "二踢脚" NOR "，送给每位在我们欢乐园奋斗
的玩家。你可以放(fang)来看看.
希望大家在新世纪里，天天快乐，学习进步!\n");
    set("value", 0);
    set_weight(10);
  }
  setup();
}
void init() {
  add_action("do_fang", "fang");
  add_action("do_dian", "dian");
}
int do_fang(string arg) {
  object me = this_player();
  string message;
  int col;
  if (arg == "pao zhang") {
    tell_object(me,
      HIR "\n" +
      "你拿起了一根火柴，双手颤抖的去点那个二踢脚，只听到“呲呲...”的响声
吓得你双腿一软坐在了地上，连滚代爬的向远处躲去，只听见怦的一声巨响，
红爆竹化作了满天的花朵，徐徐飘落下来。\n" NOR);
  }
  return 1;
}
int do_dian() {
  object me = this_player();
  message_vision("$N试图再次去点燃二踢脚，发现它已经被放过了。\n", me);
  return 1;
}

string query_autoload() {
  return 1 + "";
}
