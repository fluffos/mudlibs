//  节日礼物

#include <ansi.h>
inherit ITEM;
int do_eat(string);
void init()
{
  if (!wizardp(this_player())) {
    set("no_steal","什么？\n");
    set("no_drop","什么！\n");
    set("no_give","什么？\n");
    set("no_sell","什么？\n");
  }
  add_action("do_eat", "eat");
}

void create()
{
  set_name( HIW "小蛋糕" NOR , ({"cake","liwu"}));
  set_weight(90);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("long", HIR "这是一份节日礼物,是欢乐园巫师给一直支持他们的各位泥友的。\n");
    set("value", 0);
    set("drug_type", "补品");
  }
   set("is_monitored",1);
  setup();
}
int do_eat(string arg)
{
  object me = this_player();
  if (arg!="liwu" && arg!="cake")  return 0;
if (me->query("eat_cake")>0)
{
   message_vision("这东西,吃多了也不怕撑出问题来.\n",me);
   return 1;
}
  me->add("potential",5000);
  me->add("combat_exp",10000);
  message_vision("$N吃下一份节日礼物,高兴的蹦了起来.\n",me);
me->set("eat_cake",1);
  destruct(this_object());
  return 1;
}
