// This is the basic equip for players just login.

#include <armor.h>

inherit BOOTS;

void create()
{
        set_name("运动鞋", ({ "shoe" }) );
        set_weight(3000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "双");
                set("material", "shoe");
                set("armor_prop/armor", 10);
        }
        setup();
}
void init()
{
        object ob;

        if( this_player() && environment()==this_player() ) {
        set_name( this_player()->name(1) + "的运动鞋", ({ "shoe"}) );
        }
}
