#include <ansi.h>

#include <weapon.h>

inherit SWORD;
inherit F_UNIQUE;

void create() {
  set_name(HIR "痴情长剑" NOR, ({ "chiqing sword", "sword" }));
  set_weight(7000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是一把用天然乌金炼制的一把宝剑,锋利无比,剑气逼人。\n");
    set("value", 4000);
    set("material", "steel");
  }
  init_sword(100);


  set("wield_msg", "$N「唰」地一声抽出一把$n握在手中。\n");
  set("unwield_msg", "$N将手中的$n插入腰间的剑鞘。\n");


  setup();
}
