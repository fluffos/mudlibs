#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create() {
  set_name(HIY "五彩云衣" NOR, ({ "yun yi", "yi" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 1000);
    set("material", "cloth");
    set("armor_prop/armor", 1);
  }
  setup();
}
