#include <ansi.h>
#include <armor.h>

inherit SURCOAT;

void create()
{
  set_name(HIW"莲花披风" NOR, ({"lianhua pifeng", "pifeng", "cloth"}));
  set_weight(4500);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "一件用莲花精心制作的披风。\n");
    set("material", "leather");
    set("unit", "件");
    set("value", 10000);
    set("armor_prop/armor", 50);
  }
  setup();
}


