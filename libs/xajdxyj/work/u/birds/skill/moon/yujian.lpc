// s
#include <ansi.h>

inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int extra, i, skill_force;
  int orforce;
  extra = me->query_skill("sword");
  if (extra < 60) return notify_fail("你的风回雪舞剑还不够纯熟！\n");
  if (me->query_skill_mapped("force") != "moonforce")
    return notify_fail("你还不会[圆月心法]呢。\n");
  skill_force = me->query_skill("force");
  if (skill_force < 60) return notify_fail("你的[圆月新法]级别还不够高呀。\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［玉剑回飞］只能对战斗中的对手使用。\n");
  me->add("force_factor", extra / 5);
  orforce = (int)me->query("force");
  me->add("force", extra / 5 * 100);
  me->add_temp("apply/attack", extra / 10);
  msg = HIY "$N使出风回雪舞剑中的［玉剑回飞］，身体腾空而起剑花顿起,一连四势向$n攻出！\n" NOR;
  message_vision(msg, me, target);
  msg = HIY "玉\n" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  msg = HIY "剑\n" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  msg = HIY "回\n" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  msg = HIY "飞\n" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  me->start_busy(3);
  me->set("force_factor", 0);
  me->set("force", orforce);
  me->add_temp("apply/attack", -extra / 10);
  return 1;
}
