#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  string msg;
  int success, ap, dp;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你想把谁定住？\n");

  if (!me->is_fighting())
    return notify_fail("「破绽计」只能在战斗中使用！\n");
  if (target->is_busy())
    return notify_fail(target->query("name") + "已经动弹不得了！\n");

  if ((int)me->query_skill("kugu-blade", 1) < 100)
    return notify_fail("你的枯骨刀不够熟练.\n");
  if ((int)me->query("force") < 1500)
    return notify_fail("你的内力不够！\n");

  if ((int)me->query("sen") < 500)
    return notify_fail("你无法集中精力！\n");
  me->add("force", -500);
  me->receive_damage("sen", 50);

  msg = HIR
    "激战中,$N忽然佯装不敌,连连后退,趁$n疏忽之际,使出了枯骨刀的绝技[破绽计]! \n" NOR;

  success = 1;
  ap = (int)me->query("combat_exp");
  dp = (int)target->query("combat_exp");
  if (random(ap + dp) < dp) success = 0;

  ap = (int)me->query("wudidong/sell_reward");
  dp = (int)target->query_cps();
  if (random(ap + dp) < dp) success = 0;

  ap = (int)me->query("force_factor");
  dp = (int)target->query("force_factor");
  if (random(ap + dp) < dp) success = 1;
  if (success == 1) {
    msg += HIR "$n果然中计,动弹不得! \n" NOR;
    target->start_busy(15 + random(5));
  } else {
    msg += HIR "$n对你的小伎俩不屑一顾! \n" NOR;
  }
  message_vision(msg, me, target);
  if (success == 0) {
    me->start_busy(5);
    return 1;
  }
  return 1;
}
