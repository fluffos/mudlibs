// moon@happy
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int extra;
  int orforce;
  object weapon;
  if (me->is_busy())
    return notify_fail("你现在没空！！\n");
  extra = me->query_skill("stick");
  if ((int)me->query_skill("qianjun-bang", 1) < 80)
    return notify_fail("你的千钧棒法还不够纯熟！\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("[ 霹雳三打 ]只能对战斗中的对手使用。\n");
  me->add("force_factor", extra / 8);
  orforce = (int)me->query("force");
  me->add("force", extra / 8 * 100);
  me->add_temp("apply/attack", extra);
  weapon = me->query_temp("weapon");
  msg = HIC "$N运足精神，身形一转，霹雳间连续向$n攻出了三招！!\n" NOR;
  message_vision(me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  message_vision(me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  message_vision(me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  me->start_busy(3);
  me->set("force_factor", 0);
  me->set("force", orforce);
  me->add_temp("apply/attack", -extra);
  return 1;

}
