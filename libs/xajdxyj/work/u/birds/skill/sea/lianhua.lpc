#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
     int extra;

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展这一招「四海龙腾」？\n");

        if(!me->is_fighting())
                return notify_fail("「四海龙腾」只能在战斗中使用！\n");
        if((int)me->query("max_force") < 800 )

                return notify_fail("你的内力不够！\n");

        if((int)me->query("force") < 500 )
                return notify_fail("你的内力不足！\n");

        if((int)me->query("sen") < 500 )
                return notify_fail("你的精神不足，没法子施用外功！\n");

        if((int)me->query_skill("fengbo-cha", 1) < 100)
                return notify_fail("你的风波叉级别还不够，使用这一招会有困难！\n");

        me->delete("env/brief_message");
        target->delete("env/brief_message");

     message_vision(HIC"\n$N身形暴长，瞬间向$n连续攻出了四招！只见叉影翻飞,龙吟阵阵,仿佛四海也为之咆哮!\n"NOR,me,target);

     extra=me->query_skill("fengbo-cha",1);
     extra=extra/2;

        me->add_temp("apply/attack",extra);
        me->add_temp("apply/damage",extra);

        me->set_temp("FBC_perform", 8);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

        me->set_temp("FBC_perform", 9);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

        me->set_temp("FBC_perform", 10);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

        me->set_temp("FBC_perform", 11);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

        me->delete_temp("FBC_perform");
        me->add_temp("apply/attack",-extra);

        me->add_temp("apply/damage",-extra);
        me->receive_damage("sen", 100);

        if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
        }
        me->start_busy(3);
        return 1;
}
