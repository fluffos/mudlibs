// s
#include <ansi.h>

inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int extra, i;
  int orforce;
  object weapon;
  seteuid(getuid());
  if (me->query("dragonfight_on") != 1)
    return notify_fail("你还不会[满天飞龙]。\n");
  extra = me->query_skill("unarmed");
  if (extra < 100) return notify_fail("你的龙形搏击还不够纯熟！\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［满天飞龙］只能对战斗中的对手使用。\n");
  me->add("force_factor", extra / 5);
  orforce = (int)me->query("force");
  me->add("force", extra / 5 * 100);
  me->add_temp("apply/attack", extra / 10);
  weapon = me->query_temp("weapon");
  msg = HIY "$N使出龙形搏击中的［满天飞龙］，一招连环四式向$n攻出！\n" NOR;
  message_vision(msg, me, target);
  msg = HIY "飞龙下凡 \n" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  msg = HIY "飞龙探爪 \n" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  msg = HIY "飞龙摆尾 \n" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  msg = HIY "龙翔四海 \n" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  me->start_busy(5);
  me->set("force_factor", 0);
  me->set("force", orforce);
  me->add_temp("apply/attack", -extra / 10);
  return 1;
}
