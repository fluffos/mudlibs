int valid_learn(object me)
{    object ob;
          if( (int)me->query("max_force") < 100 )
                return notify_fail("你的内力不够，没有办法练百鸟剑。\n");
        if( !(ob = me->query_temp("weapon"))
        ||      (string)ob->query("skill_type") != "sword" )
                return notify_fail("你必须先找一把剑才能练剑法。\n");
     if((int)me->query_skill("bainiao-sword",1)>(int)me->query_skill("ningxie-force",1)*2)
          return notify_fail("你的凝血神功不够火候 .\n");
     return 1;
   }

int valid_enable(string usage)
{
         return usage=="sword"||usage=="parry";
}

mapping query_action(object me, object weapon)
{
    return action[random(sizeof(action))];
}

int practice_skill(object me)
{
          if( (int)me->query("kee") < 50
        ||      (int)me->query("force") < 10 )
                return notify_fail("你的内力或气不够，没有办法练习百鸟剑！n");
     if((int)me->query_skill("bainiao-sword",1)>(int)me->query_skill("ningxie-force",1)*2)
          return notify_fail("你的凝血神功不够火候 .\n");
        me->receive_damage("kee", 40);
        me->add("force", -10);
        write("你按着所学练了一遍百鸟剑法。\n");
        return 1;
}
string perform_action_file(string func)
{
return CLASS_D("yaomo") + "/xueshan/bainiao-sword/" + func;
}
