#include <ansi.h>


inherit NPC;
inherit F_VENDOR;

void create()

{
  set_name("科学家", ({ "kexue jia", "jia" }));
  set("gender", "男性");
  set("age", 40);
  set("title", HIY "中国科学院院士" NOR);
  set("long", "这是一位我国科学院士.手里拿着笔不停的写着什么．\n");
  set("age", 65);
  set("combat_exp", 1000);
  set("max_kee", 300);
  set("max_sen", 300);
  set("attitude", "peaceful");
  set("per", 15);
  set("vendor_goods", ([
    "dan": "/u/birds/obj/dabudan.lpc",
    "cha": "/u/birds/obj/food.lpc",
  ]));
  setup();
  add_money("gold", 2);
  carry_object("/u/birds/obj/zhongshan-zhuang.lpc")->wear();
}
void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
}

void greeting(object ob) {
  if (!ob || !present(ob, environment(this_object()))) return;
  say("科学家对你轻声的说道：这位" + RANK_D->query_respect(ob) +
    "，想不想变得更加年轻呀,我最近发明了一种新药,效果特灵,想不想试试?\n");
}
