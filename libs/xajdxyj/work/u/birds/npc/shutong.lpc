#include <ansi.h>


inherit NPC;

void create() {
  set_name("灵儿", ({ "ling er", "linger" }));
  set("gender", "女性");
  set("age", 13);
  set("title", HIR "伴读书童" NOR);
  set("long", "这是飞鹰的伴读书童,面貌清秀,手脚非常灵巧．\n");
  set("combat_exp", 200);
  set("attitude", "friendly");
  set_skill("dodge", 10);
  set("per", 30);
  set("max_kee", 150);
  set("max_gin", 150);
  set("max_sen", 150);
  setup();
  carry_object("/u/birds/obj/yunyi.lpc")->wear();
}
void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()
    && !this_player()->query("env/invisibility")) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || !present(ob, environment(this_object()))) return;
  say("灵儿说道：这位" + RANK_D->query_respect(ob) +
    "，定是前来拜见我家公子的吧,快请进！\n");
}
