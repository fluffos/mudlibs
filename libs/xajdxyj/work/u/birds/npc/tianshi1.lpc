//NPC 节日庆祝者
#include <ansi.h>
inherit NPC;
inherit F_DEALER;
void consider();
void greeting(object ob);
void create() {
  set_name(HIY "小天使" NOR, ({ "tian shi", "shi" }));
  set("long", HIW "她是来自天国的使者,给人类带来福音。\n" NOR);
  set("title", HIR "节日使者" NOR);
  set("nickname", HIY "圣诞快乐!" NOR);
  set("gender", "女性");
  set("age", 15);
  set("attitude", "friendly");
  set("shen_type", 1);
  set("str", 25);
  set("int", 24);
  set("con", 25);
  set("dex", 26);
  set("per", 30);
  set_skill("unarmed", 200);
  set("max_kee", 2000000);
  set("max_sen", 20000000);
  set_skill("dodge", 200);
  set_skill("parry", 200);
  set_skill("force", 200);
  set_skill("moonforce", 200);
  map_skill("force", "moonforce");
  set("max_neili", 2000);
  set("neili", 2000);
  set_temp("apply/damage", 20000);
  set("jiali", 100);
  set("combat_exp", 1000000);
  set("chat_chance", 5);
  set("chat_msg", ({
    HIR "小天使笑道:各位泥友,辛苦了!\n" NOR,
    HIR "小天使笑道:各位泥友,圣诞快乐!\n" NOR,
    HIR "小天使笑道:各位泥友,别忘了给好友打个电话,今天.\n" NOR,
    HIR "小天使笑道:各位泥友,我给大家带来了礼物!\n" NOR,
  }));
  set("inquiry", ([
    "礼物": "我给大家带来了圣诞礼物.\n",
  ]));
  setup();
  carry_object("/u/birds/obj/yunyi.lpc")->wear();
}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}
void greeting(object ob) {
  object obn, obm;
  if (!ob || environment(ob) != environment()) return;
  tell_object(ob, HIC "这位" + RANK_D->query_respect(ob) + "，我这里有礼物幺?!\n" NOR +
    HIG "快来看看呀!很好的幺?\n" NOR);
  if (ob->query("liwu_count") > 0) {
    tell_object(ob, HIM "这位" + RANK_D->query_respect(ob) + "，好象已经要过礼物了?!\n" NOR +
      HIY "圣诞快乐!\n" NOR);
    return;
  }
  if (ob->query("combat_exp") < 10000) {
    tell_object(ob, HIM "这位" + RANK_D->query_respect(ob) + "，我这里可不给大米礼物的呀!\n" NOR +
      HIY "圣诞快乐!\n" NOR);
    return;
  }
  obn = new("/u/birds/obj/card.lpc");
  obm = new("/u/birds/obj/dangao.lpc");
  obn->move(ob);
  obm->move(ob);
  ob->set("liwu_count", 1);
  command("chat* hi");
  command("chat* gongxi");
  command("chat 各位泥友，祝大家圣诞快乐！");
  command("chat 欢乐园欢迎各位大侠光临！");
  return;
}
