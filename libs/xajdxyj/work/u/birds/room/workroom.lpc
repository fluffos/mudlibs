#include <ansi.h>
inherit ROOM;

void init();
void create() {
  set("short", HIY "工作室" NOR);

  set("long", HIC "\n    这是飞鹰用来办公的专用工作室，窗前放着蓝色的写字台(desk）,一把
转椅放在写字台的正后方，两面墙壁上挂着几幅世界名画。\n\n" NOR);
  set("item_desc", ([
    "desk": HIB "这是一个全新的进口写字台，上边放着飞鹰用来办公的笔墨
纸砚，旁边放着一个花瓶，各种鲜花散发着阵阵的芳香。\n" NOR
  ]));
  set("exits", ([ /* sizeof() == 4 */
    "east": "/d/city/center.lpc",
  ]));
  set("no_clean_up", 0);
  set("no_magic", 1);
  set("valid_startroom", 1);
  set("sleep_room", 1);
  set("no_clean_up", 1);
  set("objects", ([
    "/u/birds/npc/shutong.lpc": 1,
  ]));
  setup();
}
