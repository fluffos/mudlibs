// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

// power_sword.c 尚方宝剑
// by FoF 98-3-7
// 惩罚说脏话的人

#include <ansi.h>
inherit F_UNIQUE;
inherit ITEM;

void create()
{
    set_name(HIW"尚方宝剑"NOR, ({"shangfang baojian", "baojian", "power sword" }));
    set_weight(1000);
    if( clonep() )
        set_default_object(__FILE__);
    else {
        set("long", HIW"一把象征着权力与威望的宝剑，据说是专门用来惩治(jail)不讲文明的人的。\n"
HIY"使用者千万注意：只能用该宝剑的特权来惩治说脏话、骂人、恶意人身攻击者。
使用时一定要把罪证一并记录。禁止滥用，否则后果自负。\n"NOR);
        set("unit", "把");
        set("value", 100000);
        set("no_drop", 1);
        set("no_sell", 1);
        set("no_steal", 1);
        set("no_give", 1);
        set("no_clean_up", 1);
    }

    setup();
    call_out("destruct_me", 600);
}

void init()
{
	if( !environment() || !environment()->is_character() )
		call_out("destruct_me", 2);
	if( environment()->is_character() && this_player()->query("combat_exp") >= 2100000 ) {
		add_action("do_jail", "jail");
		add_action("query_rumor", "whorumor");
		call_out("tell_me", 3 + random(20), this_player());
	}
}

int do_jail(string arg)
{
	object who, me = this_player();
	string reason;

	if( this_player()->query("combat_exp") < 1200000 )
		return notify_fail("你的道行还不够，没有使用宝剑特权的资格。\n");
	if( !arg || sscanf(arg, "%s %s", arg, reason) != 2 )
		return notify_fail("请用 jail < someone > < 记录的罪证 > 来行使权力。\n");
	if( !who = find_player(arg) ) return notify_fail("没有 " + arg + " 这个人。\n");
	if( who == me ) return notify_fail("没有搞错吧？你要送自己进监狱？\n");
	if( wizardp(who) ) return notify_fail("对方是管理人员，你不能这样做！\n");
	if( me->query("jail_player") > 20 )
		return notify_fail("你是不是抓了太多人了？松松手吧！\n");

	tell_room(environment(environment()), message_vision(HIY"$N口中念念有词，忽然大喝一声：$n！欢乐园乃文明场所，岂容
你撒野？！\n"NOR, me, who));
	tell_room(environment(who), message_vision(HIY"忽然空中一道强光闪过，一条粗大的铁链从云端伸下来，把$N捆了个结
实，然后铁链一收，不见了。\n"NOR, who));
	tell_object(who, CYN"一个声音对你说道：你太不老实了，送你到一个安静的地方玩玩。\n"NOR);
	who->move("/d/wiz/punish");
	who->command_function("rumor " + who->query("name") + "被抓到监狱里去了。\n");
	log_file("jail", sprintf("%s %s send %s to jail because\n%s\n", ctime(time()),
		me->query("id"), who->query("id"), reason));
	me->add("jail_player", 1);

    return 1;
}

int query_rumor()
{
	string *rumorer;
	int i;
	object me = this_player();

	if( me->is_busy() ) return notify_fail("你现在正忙着呢！\n");
	rumorer = sort_array(CHANNEL_D->query_rumorer(), "sort_keys", this_object());
	if( !sizeof(rumorer) ) return 1;
	write("刚才造了谣的人有：\n");
	for( i = sizeof(rumorer) - 1; i >= 0; i -- )
		write(rumorer[i] + "\n");
	me->start_busy(2);
	return 1;
}

void destruct_me()
{
	message_vision("$N化作一道白光，向长安城皇宫方向飞去。\n", this_object());
	destruct(this_object());
}

void tell_me(object who)
{
	if( !who ) return;
	tell_object(who, "一个声音悄悄地告诉你：可以用 whorumor 指令来查看谁造了谣。\n");
}

