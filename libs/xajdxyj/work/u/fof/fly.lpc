// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

// cglaem...12/17/96.
// FoF changed (12/03/1999)

#include <ansi.h>
#define SKYS_DIR "/d/skys/"

int main(object me, string arg) {
  string loc = 0, env, above, envi;
  int mana_cost;
  object ridee, map;

  seteuid(getuid());

  if (me->is_fighting())
    return notify_fail("你正在战斗，飞不开。\n");
  if (me->is_busy() || me->query_temp("pending/exercising"))
    return notify_fail("你正忙着呢，没工夫腾云驾雾。\n");
  if (!wizardp(me) && !environment(me)->query("outdoors"))
    return notify_fail("周围没有一片云，没办法腾云驾雾。\n");
  if (!wizardp(me) && me->is_ghost())
    return notify_fail("做了鬼了，就老实点吧！\n");
  if (!arg)
    return notify_fail("你要飞到哪里去？\n");
  if (me->query_temp("no_move"))
    return notify_fail("你被定住了，哪里飞得起来！\n");
  if (!wizardp(me) && (int)me->query("combat_exp") < 10000) {
    message_vision(HIY "$N奋力望上一跳，似乎想飞起来。结果离地不到三尺就一个倒栽葱摔了下来。\n" NOR, me);
    return notify_fail("可能是你道行还不够。\n");
  }
  if (!wizardp(me) && (int)me->query("mana") < 200) {
    message_vision(HIY "$N奋力望上一跳，似乎想飞起来。结果离地不到三尺就一个倒栽葱摔了下来。\n" NOR, me);
    return notify_fail("可能是你法力还不够。\n");
  }
  if ((int)me->query("sen") * 100 / (int)me->query("max_sen") < 10)
    return notify_fail("你现在头脑不太清醒，当心掉下来摔死。\n");
  if ((int)me->query("kee") * 100 / (int)me->query("max_kee") < 10)
    return notify_fail("你想飞起来，可是体力似乎有点不支。\n");

  mana_cost = -(100 - (int)me->query_skill("spells")) / 4 - 40;
  if (mana_cost > 0) mana_cost = 0;

  if ((string)me->query("family/family_name") == "阎罗地府") {
    message_vision(HIY "$N手一指，平地间一股阴风刮起，将$N裹了起来，\n再吹一声口哨，随之飘去不见了。。。\n\n" NOR, me);
  } else if ((string)me->query("family/family_name") == "大雪山"
    || (string)me->query("family/family_name") == "陷空山无底洞") {
    message_vision(HIY "$N手一指，「呼」地一阵狂风刮起，吹的人都睁不开眼睛，\n再吹一声口哨，随之飘去不见了。。。\n\n" NOR, me);
  } else {
    message_vision(HIY "$N手一指，召来一朵云彩，高高兴兴地坐了上去，\n再吹一声口哨，随之往上冉冉地升起。。。\n\n" NOR, me);
  }

  me->add("mana", mana_cost);

  if (arg == "stone" && (wizardp(me) || me->query("maps/aolai"))) loc = "/d/4world/entrance";
  //   else if(arg=="kaifeng") loc="/d/kaifeng/tieta";
  else if (arg == "kaifeng") loc = "/d/kaifeng/chengmen";
  else if (arg == "moon" && (wizardp(me) || me->query("maps/moon"))) loc = "/d/moon/ontop2";
  else if ((arg == "lingtai" || arg == "fangcun") && (wizardp(me) || me->query("maps/fangcun"))) {
    loc = "/d/lingtai/gate";
    arg = "lingtai";
  } else if (arg == "putuo" && (wizardp(me) || me->query("maps/putuo"))) loc = "/d/nanhai/gate";
  //   else if(arg=="changan") loc="/d/city/center";
  else if (arg == "changan") loc = "/d/changan/nanchengkou";
  else if (arg == "sky") loc = "/d/sky/nantian";
  else if (arg == "wuzhuang" && (wizardp(me) || me->query("maps/wzg"))) loc = "/d/qujing/wuzhuang/gate";
  else if (arg == "meishan" && (wizardp(me) || me->query("maps/meishan"))) loc = "/d/meishan/erlangwai";

  else if (arg == "penglai") {
    if (!(map = present("eastsea map", me)) && !wizardp(me)) {
      write("你在天上转了半天也不知该往那边飞。。。\n");
      message_vision("\n$N失望地从云上跳了下来！\n", me);
      return 1;
    }
    if (!wizardp(me) && (string)map->query("unit") != "张") {
      write("你在天上转了半天也不知该往那边飞。。。\n");
      message_vision("\n$N失望地从云上跳了下来！\n", me);
      return 1;
    }
    write("你驾着祥云向东边海中飞去。。。\n\n");
    loc = "/d/penglai/penglai";
  } else if (arg == "xueshan") {
    if (!(map = present("xueshan map", me)) && !wizardp(me)) {
      write("你在天上转了半天也不知该往那边飞。。。\n");
      message_vision("\n$N失望地从云上跳了下来！\n", me);
      return 1;
    }
    if (!wizardp(me) && (string)map->query("unit") != "张") {
      write("你在天上转了半天也不知该往那边飞。。。\n");
      message_vision("\n$N失望地从云上跳了下来！\n", me);
      return 1;
    }
    write("你驾着祥云向大雪山飞去。。。\n\n");
    loc = "/d/xueshan/binggu";
  } else if (arg == "baoxiang" && (wizardp(me) || me->query("maps/baoxiang"))) {
    loc = "/d/qujing/baoxiang/bei1.lpc";
    loc[strlen(loc) - 3] = '1' + random(4);
  } else if (arg == "pingding" && (wizardp(me) || me->query("maps/pingding"))) {
    loc = "/d/qujing/pingding/ping1.lpc";
    loc[strlen(loc) - 3] = '1' + random(4);
  } else if (arg == "yalong" && (wizardp(me) || me->query("maps/pingding"))) {
    loc = "/d/qujing/pingding/yalong1.lpc";
    loc[strlen(loc) - 3] = '1' + random(3);
  } else if (arg == "wuji" && (wizardp(me) || me->query("maps/wuji"))) {
    loc = "/d/qujing/wuji/square.lpc";
    //loc[strlen(loc)-3] = '1'+random(9);
  } else if (arg == "chechi" && (wizardp(me) || me->query("maps/chechi"))) {
    loc = "/d/qujing/chechi/jieshi1.lpc";
    loc[strlen(loc) - 3] = '1' + random(9);
  } else if (arg == "tongtian" && (wizardp(me) || me->query("maps/tongtian"))) {
    loc = "/d/qujing/tongtian/hedong1.lpc";
    loc[strlen(loc) - 3] = '1' + random(6);
  } else if (arg == "jindou" && (wizardp(me) || me->query("maps/jindou"))) {
    loc = "/d/qujing/jindou/jindou1.lpc";
    loc[strlen(loc) - 3] = '1' + random(4);
  } else if (arg == "nuerguo" && (wizardp(me) || me->query("maps/nuerguo"))) {
    loc = "/d/qujing/nuerguo/towna1.lpc";
    /*
     if (me->query("obstacle/nuerguo")!="done" && !wizardp(me)){
        write("\n一阵风把你东倒西歪地吹了回来！\n");
        write("看样子飞不过去。\n");
        return 1;
        }
     */
    loc[strlen(loc) - 4] = 'a' + random(3);
    loc[strlen(loc) - 3] = '1' + random(3);
  } else if (arg == "dudi" && (wizardp(me) || me->query("maps/dudi"))) {
    loc = "/d/qujing/dudi/dudi1.lpc";
    loc[strlen(loc) - 3] = '1' + random(4);
  } else if (arg == "firemount" && (wizardp(me) || me->query("maps/firemount"))) {
    loc = "/d/qujing/firemount/cuiyun1.lpc";
    loc[strlen(loc) - 3] = '1' + random(5);
  } else if (arg == "jilei" && (wizardp(me) || me->query("maps/jilei"))) {
    loc = "/d/qujing/jilei/jilei1.lpc";
    loc[strlen(loc) - 3] = '1' + random(3);
  } else if (arg == "jisaiguo" && (wizardp(me) || me->query("maps/jisaiguo"))) {
    loc = "/d/qujing/jisaiguo/east1.lpc";
    loc[strlen(loc) - 3] = '1' + random(4);
  } else if (arg == "jingjiling" && (wizardp(me) || me->query("maps/jingji"))) {
    loc = "/d/qujing/jingjiling/jingji1.lpc";
  } else if (arg == "xiaoxitian" && (wizardp(me) || me->query("maps/xiaoxitian"))) {
    loc = "/d/qujing/xiaoxitian/simen.lpc";
  } else if (arg == "zhuzi" && (wizardp(me) || me->query("maps/zhuzi"))) {
    loc = "/d/qujing/zhuzi/zhuzi1.lpc";
    loc[strlen(loc) - 3] = '1' + random(5);
  } else if (arg == "qilin" && (wizardp(me) || me->query("maps/qilin"))) {
    loc = "/d/qujing/qilin/yutai.lpc";
  } else if (arg == "pansi" && (wizardp(me) || me->query("maps/pansi"))) {
    loc = "/d/qujing/pansi/ling1.lpc";
    loc[strlen(loc) - 3] = '1' + random(6);
  } else if (arg == "biqiu" && (wizardp(me) || me->query("maps/biqiu"))) {
    loc = "/d/qujing/biqiu/jie1.lpc";
    loc[strlen(loc) - 3] = '1' + random(9);
  } else if (arg == "qinghua" && (wizardp(me) || me->query("maps/biqiu"))) {
    loc = "/d/qujing/biqiu/zhuang.lpc";
  } else if (arg == "wudidong" && (wizardp(me) || me->query("maps/wudidong"))) {
    loc = "/d/qujing/wudidong/firemount-wudidong3.lpc";
    loc[strlen(loc) - 3] = '1' + random(3);
  } else if (arg == "qinfa" && (wizardp(me) || me->query("maps/qinfa"))) {
    loc = "/d/qujing/qinfa/jiedao1.lpc";
    loc[strlen(loc) - 3] = '1' + random(8);
  } else if (arg == "yinwu" && (wizardp(me) || me->query("maps/yinwu"))) {
    loc = "/d/qujing/yinwu/huangye1.lpc";
  } else if (arg == "fengxian" && (wizardp(me) || me->query("maps/fengxian"))) {
    loc = "/d/qujing/fengxian/jiedao1.lpc";
    loc[strlen(loc) - 3] = '1' + random(9);
  } else if (arg == "yuhua" && (wizardp(me) || me->query("maps/yuhua"))) {
    loc = "/d/qujing/yuhua/xiaojie1.lpc";
    loc[strlen(loc) - 3] = '1' + random(9);
  } else if (arg == "baotou" && (wizardp(me) || me->query("maps/baotou"))) {
    loc = "/d/qujing/baotou/shanlu1.lpc";
    loc[strlen(loc) - 3] = '1' + random(9);
  } else if (arg == "zhujie" && (wizardp(me) || me->query("maps/zhujie"))) {
    loc = "/d/qujing/zhujie/shanlu11.lpc";
    loc[strlen(loc) - 3] = '1' + random(8);
  } else if (arg == "jinping" && (wizardp(me) || me->query("maps/jinping"))) {
    loc = "/d/qujing/jinping/xiaojie1.lpc";
    loc[strlen(loc) - 3] = '1' + random(7);
  } else if (arg == "qinglong" && (wizardp(me) || me->query("maps/qinglong"))) {
    loc = "/d/qujing/qinglong/shanjian.lpc";
  } else if (arg == "tianzhu" && (wizardp(me) || me->query("maps/tianzhu"))) {
    loc = "/d/qujing/tianzhu/jiedao11.lpc";
    loc[strlen(loc) - 3] = '1' + random(8);
  } else if (arg == "maoying" && (wizardp(me) || me->query("maps/maoying"))) {
    loc = "/d/qujing/maoying/shanpo1.lpc";
    loc[strlen(loc) - 3] = '1' + random(9);
  } else if (arg == "lingshan" && (wizardp(me) || me->query("maps/lingshan"))) {
    loc = "/d/qujing/lingshan/dalu1.lpc";
    loc[strlen(loc) - 3] = '1' + random(3);
    /*        }else if(arg=="es"){
            loc = "/d/suburb/es/snow/square.lpc";
            if (file_size(loc)==-1)
                loc = 0;
        }else if(arg=="xkx"){
            loc = "/d/suburb/xkx/city/guangchang.lpc";
            if (file_size(loc)==-1)
                loc = 0;
        }else if(arg=="fy"){
            loc = "/d/suburb/fy/fy/fysquare.lpc";
            if (file_size(loc)==-1)
                loc = 0;
*/
  } else {
    write("\n\n你在天上转了半天也不知该往那边飞。。。\n");
    message_vision("\n$N失望地从云上跳了下来！\n", me);
    return 1;
  }

  if (!loc) {
    write("\n\n你在天上转了半天也不知该往那边飞。。。\n");
    message_vision("\n$N失望地从云上跳了下来！\n", me);
    return 1;
  }

  env = base_name(environment(me));
  if (env)
    if (sscanf(env, "/d/qujing/%s/%s", above, envi) != 2)
      if (sscanf(env, "/d/%s/%s", above, envi) != 2)
        above = "default";
  if (above == "city") above = "changan";
  if (above == "4world") above = "stone";
  if (above == "nanhai") above = "putuo";
  if (above == "33tian") above = "default";
  if (above == "eastway") above = "default";
  if (above == "erlang") above = "meishan";
  if (above == "gao") above = "lingtai";
  if (above == "huanggong") above = "changan";
  if (above == "jjf") above = "default";
  if (above == "ourhome") above = "default";
  if (above == "pantao") above = "default";
  if (above == "sea") above = "default";
  if (above == "westway") above = "default";
  if (above == "wiz") above = "default";
  if (above == "skys") above = "default";
  if (above == "bibotan") above = "jisaiguo";
  me->set_temp("fly/destination", loc);
  me->set_temp("fly/action", "fly_up");
  me->set_temp("fly/arg", arg);
  if (ridee = me->ride()) {
    ridee->move(SKYS_DIR + above);
  }
  me->move(SKYS_DIR + above);
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : fly [目的地]

当你的道行和法力高强时，你可以腾云驾雾。
但目的地必须是去过的地方，即必须知道目的地的地图。

目前你可以飞到的地方：
changan     ->长安城            kaifeng     ->开封城
stone       ->花果山仙石        sky         ->南天门
moon        ->昆仑山月宫        penglai     ->蓬莱仙岛
lingtai     ->灵台方寸山        putuo       ->南海普陀山
xueshan     ->大雪山寒冰谷      meishan     ->梅山灌江口
wuzhuang    ->万寿山五庄观

baoxiang    ->宝象国            pingding    ->平顶山
yalong      ->压龙山            wuji        ->乌鸡国
chechi      ->车迟国            tongtian    ->通天河
jindou      ->金兜山            nuerguo     ->女儿国
dudi        ->毒敌山            firemount   ->火焰山
jilei       ->积雷山            jisaiguo    ->祭赛国
jingjiling  ->荆棘岭            xiaoxitian  ->小西天
zhuzi       ->朱紫国            qilin       ->麒麟山
pansi       ->盘丝岭            biqiu       ->比丘国
qinghua     ->清华庄            wudidong    ->无底洞
qinfa       ->钦法国            fengxian    ->凤仙郡
yinwu       ->隐雾山            yuhua       ->玉华县
baotou      ->豹头山            zhujie      ->竹节山
jinping     ->金平府            qinglong    ->青龙山
tianzhu     ->天竺国            maoying     ->毛颖山
lingshan    ->灵山

如果是《西游记》扩充版，你可以飞到：
es          ->东方故事          xkx         ->侠客行
fy          ->风云

HELP
  );
  return 1;
}
