#include <ansi.h>
#define JUDGER "/u/fof/judger"

void create() { seteuid( getuid() ); }

int check_pker(mixed who)
{
	if( JUDGER->query_wanted(who) ) {
		tell_object(who, "有人要找你决斗。请稍候。\n");
		who->move("/d/kaifeng/");
		return 1;
	} else return 0;
	return 1;
}

int tell_challege(object who)
{
	string challege = JUDGER->query_wanted(who);
	if( !challege )  return 0;
	tell_object(challege, "你要挑战的人：" + who->query("name") + "，已经来了。请到水陆大会来与之决斗。\n");
	return 1;
}

