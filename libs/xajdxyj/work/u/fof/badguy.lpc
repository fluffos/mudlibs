// FoF copy from FY3 (11/01/1999)

#include <ansi.h>
inherit NPC;
void create()
{
    set_name("山西土匪", ({ "tufei", "shanxi tufei" }) );
    set("long", "一个满脸伤疤加横肉的家伙。\n");
    set("attitude", "aggressive");
    set("vendetta/authority", 1);
    set("cor", 30);
    set("agi", 40);
    set("pursuer",1);
    set("combat_exp", 200000 + random(200000));
    set("bellicosity", 2000);
    set("chat_chance", 80);
    set("chat_msg", ({
        "山西土匪喝道：今天老子要钱又要命！！\n",
        "山西土匪笑道：贼娘的，去死吧！\n",
        "山西土匪唱道：爱，爱，爱爱我淄博宁山西～～～\n",
        (: random_move :),
    }) );

    set("chat_chance_combat", 90);
//    set("chat_msg_combat", ({
//       (: perform_action, "blade.tiandirenmo" :),
//       (: random_move :),
//    }) );

//  set_skill("force",100);
//  set_skill("demon-force",100);
//  map_skill("force","demon-force");
    set_skill("unarmed", 100 + random(200));
    set_skill("blade", 100 + random(200));
    set_skill("parry", 100 + random(200));
    set_skill("dodge", 100 + random(200));
    set_skill("move", 100 + random(200));
    set_skill("demon-blade", 100 + random(50));
    set_skill("demon-steps", 100);
    set_temp("apply/attack", 70);
    set_temp("apply/defense", 70);
    set_temp("apply/armor", 70);
    set_temp("apply/damage", 100 + random(100));
    set_temp("apply/move", 100);
    map_skill("dodge","demon-steps");
    map_skill("blade","demon-blade");
    map_skill("move","demon-steps");

    setup();

    carry_object("/obj/cloth")->wear();
    carry_object(__DIR__"obj/guiblade")->wield();
}
void init()
{
    remove_call_out("hunting");
    if(!environment()->query("no_fight"))
        call_out("hunting",3);
}

void hunting()
{
    int i;
    object *ob;
    ob = all_inventory(environment());
    for( i = sizeof(ob) - 1; i >= 0; i -- ) {
        if( !ob[i]->is_character() || ob[i] == this_object() || !living(ob[i]) ) continue;
        if( ob[i]->query("vendetta/authority") ) continue;
        kill_ob(ob[i]);
        ob[i]->fight(this_object());
    }
}

