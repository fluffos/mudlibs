// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

// newyearcake.c 新年蛋糕
// by FoF 0-12-31

#include <ansi.h>
inherit ITEM;

string *eat_msg = ({
  "$N拿起手中的大蛋糕吃了几口。一股香甜直入心脾，$N觉得舒服极了。\n",
  "$N拿起手中的大蛋糕吃了几口。一股香甜直入心脾，$N觉得舒服极了。\n",
  "$N拿起手中的大蛋糕吃了几口。一股香甜直入心脾，$N觉得舒服极了。\n",
  "$N拿起手中的大蛋糕吃了几口。一股香甜直入心脾，$N觉得舒服极了。\n",
});

void init();
void eat();

void create() {
  set_name(HIG "大" HIY "蛋糕" NOR, ({ "dan gao", "dangao", "cake" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", HIY "一个特制的大蛋糕，散发着诱人的香气，看着看着你的口水都要流出来了。\n" NOR);
    set("unit", "个");
    set("value", 1000);
    set("remaining", 20);
    set("food_supply", 20);
  }

  setup();
}

void init() {
  add_action("do_chi", "eat");
}

int do_chi(string arg) {

  int heal, recover, sen, e_sen, m_sen, remaining, gain;
  object who = this_player();

  if (!this_object()->id(arg)) return 0;
  if (who->is_busy())
    return notify_fail("你上一个动作还没有完成。\n");
  if ((int)who->query("food")
    >= (int)who->max_food_capacity())
    return notify_fail("你已经吃得太多了，再吃就撑死了。\n");

  who->add("food", (int)query("food_supply"));

  if (who->query("id") == query("owner_id")) {

    gain = 20 + random(who->query("combat_exp") / 10000);
    if (random(2)) who->add("potential", gain);
    else who->add("combat_exp", gain);
    who->add("year2000/eat_cake", 1);

    m_sen = (int)who->query("max_sen");
    e_sen = (int)who->query("eff_sen");
    heal = (int)who->query_con() / 3;

    if (e_sen < m_sen) {
      if ((e_sen + heal) >= m_sen)
        who->set("eff_sen", m_sen);
      else
        who->add("eff_sen", heal);
    }

    e_sen = (int)who->query("eff_sen");
    sen = (int)who->query("sen");
    recover = 15 + heal;

    if (sen < e_sen) {
      if ((sen + recover) >= e_sen)
        who->set("sen", e_sen);
      else
        who->add("sen", recover);
    }

    if (who->is_fighting()) who->start_busy(2);

    add("remaining", -1);
    if (query("remaining"))
      message_vision("$N拿起手中的大蛋糕吃了几口。一股香甜直入心脾，$N觉得舒服极了。\n", who);
    else {
      message_vision("$N把大蛋糕吃得干干净净，用舌头搅了搅嘴角上的奶油，仍是意尤未尽。\n", who);
      destruct(this_object());
    }
  } else {
    add("remaining", -1);
    if (query("remaining"))
      message_vision("$N拿起手中的大蛋糕吃了几口。\n", who);
    else {
      message_vision("$N把大蛋糕吃得干干净净，打了一个大大的饱嗝。\n", who);
      destruct(this_object());
    }
  }

  return 1;
}

void set_owner(object who) {
  set("owner_id", who->query("id"));
  set("long", HIY "一个特制的大蛋糕，散发着诱人的香气，看着看着你的口水都要流出来了。\n" +
    "蛋糕上用奶油歪歪扭扭地涂了几个字：" HIR "祝" + who->query("name") + "新年快乐！\n" NOR);
}
