// ip.c

#include <ansi.h>

int main( object me,string arg )
{
	int i,j,flag;
	object *ob;
	string ip;
	
	
	
	if( arg=="warn" ) flag=1;
	ob=users();
	ip="==============check multi IP address===============\n";
	
	for( i=0;i<sizeof(ob);i++ )
	{
		if( !ob[i] || ob[i]->query_temp("use") ) continue;
		for( j=0 ; j<sizeof(ob); j++ )
		{
			if( i==j || !ob[j] || ob[j]->query_temp("use") ) continue;
			if( query_ip_number( ob[i] ) == query_ip_number( ob[j]))
			{
				ob[i]->set_temp("use",1);
				ob[j]->set_temp("use",1);
				ip+=ob[j]->query("id")+"\t";
				if(flag) tell_object(ob[j],HIR"系统负载过重,请不要多重登录!\n"NOR);
			}
		}
		if( ob[i]->query_temp("use")){
			ip+=ob[i]->query("id")+"\t["+query_ip_number(ob[i])+"]\n";
			if( flag )
			tell_object(ob[i],HIR"系统负载过重,请不要多重登录!\n"NOR);
		}
	}
	
	me->start_more( ip );
	for( i=0;i<sizeof(ob);i++)
	if( ob ) ob[i]->set_temp("use",0);
	return 1;
}
