// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

// y2kdan.c
// 千年丹

#include <ansi.h>
inherit ITEM;

void destruct_me();

void create()
{
	set_name("千禧珠", ({ "qianxi zhu", "zhu", "ball" }));
	set("long", "一颗晶莹剔透的小珠子，闪着淡淡的白光。\n");
	set("no_give", 1);
	set("no_drop", 1);
	set("no_sell", 1);

	setup();
	call_out("destruct_me", 600);
}

void init()
{
	add_action("do_eat", "eat");
}

int do_eat(string arg)
{
	object who = this_player();
	if( !arg || member_array(arg, parse_command_id_list()) == -1 ) return notify_fail("你要吃什么？\n");
	if( query("eat_effect") && who->query("year2000/gift_addjust") < 8 ) {
		if( who->query("year2000/gift_add") < 3 ) {
			who->add("year2000/gift_add", 1);
			who->add(query("eat_effect"), 1);
		} else if( who->query("year2000/gift_reduce") + who->query("year2000/gift_add") >
			who->query("year2000/gift_addjust") ) {
			who->add(query("eat_effect"), 1);
		}		
		who->add("year2000/gift_addjust", 1);
		message_vision("$N把一颗" + query("name") + "放到嘴边，嗖～～的一下吞了下去。\n" +
			query("color") + "$N感到身上起了奇妙的变化。\n"NOR, who);
	} else if( query("eat_effect") && who->query_temp("year2000/gift_addjust") < 5 ) {
		who->add_temp("apply/" + query("eat_effect_temp"), 1);
		who->add_temp("year2000/gift_addjust", 1);
		message_vision("$N把一颗" + query("name") + "放到嘴边，嗖～～的一下吞了下去。\n" +
			query("color") + "$N感到身上起了奇妙的变化。\n"NOR, who);
	} else {
		message_vision("$N把一颗" + query("name") + "放到嘴边，捏着喉咙吞了下去。\n" +
			HIR + "$N感到感到一阵反胃，蹊里哗啦地吐了满地。\n"NOR, who);
	}
	destruct(this_object());
	return 1;
}

void re_set()
{
	set_name(query("color") + "千禧珠" NOR, ({ "qianxi zhu", "zhu", "ball" }));
	set("long", "一颗晶莹剔透的小珠子，闪着淡淡的" + query("color2") + "光" NOR "。\n");
}

void destruct_me()
{
	if( environment() ) tell_room(environment(), "一道" + this_object()->query("color2") +
		"光" NOR "闪过，" + name() + "忽然消失了。\n");
	destruct(this_object());
	return;
}

