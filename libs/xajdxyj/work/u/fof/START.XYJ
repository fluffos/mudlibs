#!/bin/sh
ulimit -n 256
workdir=/home/xyj/xiyou/mirror

touch $workdir/xyj.out
nice $workdir/addr_server 6665 >>$workdir/xyj.out &
while true
do
  \mv -f $workdir/world/log/debug.log \
         $workdir/world/log/debug`date +"%m%d%H%M%S"`
  $workdir/driver $workdir/config.xiyou >>$workdir/xyj.out 
  nice $workdir/addr_server 6665 >>$workdir/xyj.out &
  sleep 10 
done

