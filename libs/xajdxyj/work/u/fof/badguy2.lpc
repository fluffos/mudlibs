// FoF copy from FY3 (11/01/1999)

#include <ansi.h>
inherit NPC;
void do_chat();

void create() {
  set_name("山西土匪", ({ "tufei", "shanxi tufei" }));
  set("long", "一个满脸伤疤加横肉的家伙。\n");
  set("attitude", "aggressive");
  set("vendetta/authority", 1);
  set("cor", 30);
  set("str", 25);
  set("cps", 20);
  set("per", 15);
  set("con", 20);
  //    set("agi", 40);
  set("pursuer", 1);
  set("combat_exp", 20000 + random(20000));
  set("bellicosity", 1000);
  set("chat_chance", 50);
  set("chat_msg", ({
    "山西土匪喝道：今天老子要钱又要命！！\n",
    "山西土匪笑道：贼娘的，去死吧！\n",
    "山西土匪唱道：爱，爱，爱爱我淄博宁山西～～～\n",
    (: random_move :),
    (: do_chat() :),
  }));

  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    //       (: perform_action, "blade.tiandirenmo" :),
    (: random_move :),
  }));

  //  set_skill("force",100);
  //  set_skill("demon-force",100);
  //  map_skill("force","demon-force");
  set_skill("unarmed", 40 + random(20));
  set_skill("blade", 40 + random(20));
  set_skill("parry", 40 + random(20));
  set_skill("dodge", 40 + random(20));
  //    set_skill("move", 40 + random(30));
  set_skill("demon-blade", 40 + random(20));
  set_skill("demon-steps", 40);
  set_temp("apply/attack", 20);
  set_temp("apply/defense", 20);
  set_temp("apply/armor", 20);
  set_temp("apply/damage", 20 + random(10));
  set_temp("apply/move", 20);
  map_skill("dodge", "demon-steps");
  map_skill("blade", "demon-blade");
  //    map_skill("move","demon-steps");

  setup();

  carry_object("/d/obj/cloth/magua")->wear();
  carry_object("/d/obj/weapon/blade/blade")->wield();
}
void init() {
  remove_call_out("hunting");
  if (!environment()->query("no_fight"))
    call_out("hunting", 3);
}

void hunting() {
  int i;
  object *ob;
  ob = all_inventory(environment());
  for (i = sizeof(ob) - 1; i >= 0; i--) {
    if (!ob[i]->is_character() || ob[i] == this_object() || !living(ob[i])) continue;
    if (ob[i]->query("vendetta/authority")) continue;
    if (userp(ob[i]) && random(ob[i]->query("bellicosity")) < 50) continue;
    kill_ob(ob[i]);
    ob[i]->fight(this_object());
  }
}

void do_chat() {
  if (!random(3))
    command("chat 月黑杀人，风高放火！");
  return;
}
