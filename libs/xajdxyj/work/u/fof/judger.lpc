#include <ansi.h>
inherit NPC;

void create() {
  set_name("判官", ({ "judger" }));
  set("gender", "男性");
  set("combat_exp", 1000000);
  set("per", 30);
  set("str", 30);
  set("cor", 30);
  set("cps", 30);
  set("spi", 30);
  set("age", 22);
  set("attitude", "peaceful");
  set("shen_type", 1);

  setup();
  carry_object("/d/obj/cloth/choupao")->wear();
}

void init() {
  add_action("do_challege", "challege");
  add_action("do_challege", "tiaozhan");
}

int do_challege(string target_id) {
  object target;

  if (!target_id)
    return notify_fail("你要挑战谁？\n");

  target = new(LOGIN_OB);
  target->set("id", target_id);
  if (!target->restore()) {
    destruct(target);
    return notify_fail("没有这个玩家。\n");
  }

  if (objectp(body = find_player(name))
    set("challeger/" + this_player()->query("id"), target);
    if (!target = find_player(target_id))
      return notify_fail("判官说道：你要挑战的人不在这里，不过我给你记下了，下次他（她）来的时候我会通知你的。\n");
      //	command("chat " + this_player()->query("name") + "前来挑战" + target->query("name") + "。");
      return 1;
  }

    int tell_challege(object target) {
      string *my = query_entire_dbase();
      string *list = keys(my["challeger"]);
      for (i = 0; i < sizeof(my["challeger"]); i++) {
        if (list[i] = target->query("id")) {
          tell_object();
          target->move(environmeng());
        }
      }
    }
