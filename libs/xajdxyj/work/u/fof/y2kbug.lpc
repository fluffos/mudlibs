// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

// y2kbug.c
// 千年虫

#include <ansi.h>
inherit NPC;

string *id = ({
  "red y2k bug",
  "orange y2k bug",
  "yellow y2k bug",
  "green y2k bug",
  "cyn y2k bug",
  "blue y2k bug",
  "purple y2k bug",
});
string *name = ({
  HIR "赤色千年虫" NOR,
  YEL "橙色千年虫" NOR,
  HIY "黄色千年虫" NOR,
  HIG "绿色千年虫" NOR,
  CYN "青色千年虫" NOR,
  HIB "蓝色千年虫" NOR,
  HIM "紫色千年虫" NOR,
});
string *color = ({
  HIR,
  YEL,
  HIY,
  HIG,
  CYN,
  HIB,
  HIM,
});
string *color2 = ({
  HIR "赤",
  YEL "橙",
  HIY "黄",
  HIG "绿",
  CYN "青",
  HIB "蓝",
  HIM "紫",
});
string *eat_effect = ({
  "str",
  "cps",
  "spi",
  "con",
  "int",
  "cor",
  "per",
  "kar",
});
string *eat_effect_temp = ({
  "strength",
  "composure",
  "spirituality",
  "constitution",
  "intelligence",
  "courage",
  "personality",
  "karma",
});

void destruct_me();

void create() {
  int i = random(sizeof(name));
  set_name(name[i], ({ id[i], "y2k bug", "y2k", "bug" }));
  set("long", "一条怪模怪样的" + color2[i] + "色小虫。\n" NOR);
  set("eat_effect", eat_effect[i]);
  set("eat_effect_temp", eat_effect_temp[i]);
  set("color", color[i]);
  set("color2", color2[i]);

  setup();
  call_out("destruct_me", 600);
}

void die() {
  object me = this_object();
  object dan = new("/u/fof/y2kdan");
  dan->set("eat_effect", query("eat_effect"));
  dan->set("eat_effect_temp", query("eat_effect_temp"));
  dan->set("color", query("color"));
  dan->set("color2", query("color2"));
  dan->re_set();
  dan->move(environment(me));
  message_vision("$N身子一蜷，一道亮光闪过，化作一颗小珠子，在地上闪着淡淡的" +
    query("color2") + "光" NOR "。\n", me);
  destruct(me);
}

void destruct_me() {
  if (environment())
    message_vision("$N身子一蜷，一道亮光闪过，化作一道烟消失了。\n", this_object());
  destruct(this_object());
  return;
}
