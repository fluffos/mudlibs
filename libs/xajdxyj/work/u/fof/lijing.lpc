int test_player();
int quest_reward(object);
int log(int);

void create() {
  set_name("李靖", ({ "li jing", "lijing", "li" }));
  set("long", "一位身披战袍，手托宝塔的天王。\n");
  set("title", "托塔天王");
  set("gender", "男性");
  set("age", 100);
  set("per", 30);
  set("attitude", "peaceful");
  set("class", "fighter");
  set("shen_type", 1);
  set("combat_exp", 1200000);
  set_skill("unarmed", 300);
  set_skill("dodge", 300);
  set_skill("parry", 300);
  set_skill("force", 300);
  set_skill("spells", 300);
  set("max_kee", 2800);
  set("max_sen", 2800);
  set("max_force", 3000);
  set("max_mana", 3000);
  set("force_factor", 200);
  set("mana_factor", 200);
  set("chat_chance", 5);
  set("chat_msg", ({
    "李天王怒道：杀尽天下妖魔鬼怪！\n",
    "李天王说道：要扫除一切牛鬼蛇神！\n",
    "李天王说道：坚持就是胜利！\n",
    "李天王说道：一定要把扫荡牛鬼蛇神的斗争进行到底！\n",
  }));
  set("inquiry", ([
    "name": "托塔天王李靖是也。\n",
    "妖魔": (: test_player() :),
    "鬼怪": (: test_player() :),
    "牛鬼": (: test_player() :),
    "蛇神": (: test_player() :),
    "任务": (: test_player() :),
  ]));
  setup();
  carry_object("/d/obj/cloth/zhanpao")->wear();
}

void rewarding(object who);

void init() {
  call_out("check_player", 2 + random(3), this_player());
}

int test_player() {
  string *places, *dirs, str, *strs = ({
    "李天王将手中的宝剑一指，说道：$w有$N，为害不浅，请速与我灭之！\n",
    "李天王怒发冲冠，喝道：$w有$N为非作歹，请火速去将之了结掉！\n",
    "李天王将手一指，喝道：有$N在$w一带作乱，速去将之了结！\n",
  });
  int i, j, k;
  object yao, newob, me = this_object(), who = this_player();
  mixed *file;

  if (is_busy()) {
    write("对方正忙着呢，等等吧。\n");
    return 1;
  }

  if (who->query_temp("quest/lijing/name") && who->query_temp("quest/lijing/kill") != "done") {
    message_vision("$N对$n说道：这位" + RANK_D->query_respect(who) +
      "，我不是请您去降服" + who->query_temp("quest/lijing/name") + "吗？\n", me, who);
    return 1;
  }

  if (time() - who->query("quest/lijing/last_done") < 200) {
    message_vision("$N对$n说道：这位" + RANK_D->query_respect(who) +
      "，暂时还没有任务给你，先歇一歇吧。\n", me, who);
    return 1;
  }

  me->start_busy(1);

  dirs = keys(map);
  places = values(map);

  while (1) {  // pick up one directory
    i = random(sizeof(dirs));
    if (who->query("combat_exp") < 10000)
      i = random(14);
    file = get_dir(dirs[i] + "*.lpc", -1);
    if (sizeof(file)) break;
  }

  k = sizeof(file);
  while (1) {
    j = random(k);
    if (file[j][1] > 0) break;  // pick up a file with size > 0
  }

  yao = new(__DIR__ "yao");
  yao->copy_status(who);
  yao->set("killer_id", who->query("id"));
  if (who->query("combat_exp") < 2000)
    yao->set("name", "小小" + yao->query("name"));
  else if (who->query("combat_exp") < 10000)
    yao->set("name", "小" + yao->query("name"));

  if ((newob = find_object(dirs[i] + file[j][0]))) {
    yao->move(newob);
  } else {
    seteuid(getuid());
    newob = load_object(dirs[i] + file[j][0]);
    if (newob)   // now this is not necessary, only for debug use
      yao->move(newob);
    else {
      destruct(yao);
      return 1;
    }
  }

  who->set_temp("quest/lijing/name", yao->name());
  who->set_temp("quest/lijing/where", places[i]);
  str = strs[random(sizeof(strs))];
  str = replace_string(str, "$w", places[i]);
  str = replace_string(str, "$N", yao->name());
  tell_room(environment(), str);
  //   message_vision(str, yao, who);

  return 1;
}

void check_player(object who) {
  object me = this_object();
  int t;

  if (!who || !visible(who))
    return;

  if (!who || environment(who) != environment(me))
    return;

  if (!who->query_temp("quest/lijing/name")) return;

  if (who->query_temp("quest/lijing/kill") != "done") {
    message_vision("$N对$n说道：这位" + RANK_D->query_respect(who) +
      "，我不是请您去降服" + who->query_temp("quest/lijing/name") + "吗？\n", me, who);
    return;
  }

  rewarding(who);
}

void rewarding(object who) {
  object me = this_object();
  string reason;
  int reward;
  string *strs = ({
    "慢慢地一小团祥云在$N的身边升起。\n",
    "$N的身上慢慢升起一股祥云。\n",
    "一小股祥云在$N的身上缓缓升起。\n",
    "只见$N的身上徐徐飘浮起一小团祥云。\n",
    "一团小祥云在$N的身上慢慢升起。\n",
  });

  reason = "除妖灭怪，降服了" + who->query_temp("quest/lijing/name") + "，";
  message_vision("$N对$n说道：多谢这位" + RANK_D->query_respect(who) +
    reason + "真是品行可嘉也。\n", me, who);
  reward = quest_reward(who);
  who->add("quest/lijing/reward", reward);
  //  reporting(who, reason, reward, "奖分");
  who->add("combat_exp", reward);
  who->add("potential", reward);
  who->delete_temp("quest/lijing/kill");
  who->delete_temp("quest/lijing/name");
  who->set("quest/lijing/last_done", time());
  log_file(
    "lijing_kill",
    who->query("id") + "(" + who->query("combat_exp") + ") was rewarded " + reward + " on " + ctime(time()) + "\n"
  );
  //  call_out ("quest_done", 1, who);
  who->add("score", 1);
  message_vision(strs[random(sizeof(strs))], who);
  tell_object(who, "你得到了" + COMBAT_D->chinese_daoxing(reward) + "道行！\n");
  tell_object(who, "你的潜能增加了" + reward + "点！\n");
}

int quest_reward(object who) {
  int reward;
  int exp = who->query("combat_exp");

  reward = 15 + random(who->query("cps"));  // initial value
  //  reward += MAXREWARD // normal value
  reward = reward * (3 + log(exp / 1000));  // high value
  reward += random(who->query_int()) + random(who->query_kar());  // base value
  if (reward >= MAXREWARD)
    reward = MAXREWARD + random(who->query("kar") * 5);
  return reward;
}

int log(int i) {
  int j = 0;
  while (i = i / 2)
    j++;
  return j;
}
