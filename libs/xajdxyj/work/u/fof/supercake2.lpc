// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

// supercake.c 超级千禧蛋糕
// by FoF 99-12-31

#include <ansi.h>
inherit ITEM;

string *eat_msg = ({
  "$N目露凶光，对准$n猛地就是一口。\n",
});


void init();
void eat();

void create() {
  set_name(HIR "超级" HIG "千禧" HIY "蛋糕" NOR, ({ "super cake", "cake" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", HIG "一个特制的超级大蛋糕。\n" NOR);
    set("unit", "个");
    set("value", 1000);
    set("no_get", 1);
    set("weight", 10000);
    set("remaining", 2000);
    set("food_supply", 50);
  }

  setup();
}

void init() {
  add_action("do_chi", "eat");
  add_action("do_look", "look");
}

int do_chi(string arg) {
  int heal, recover, sen, e_sen, m_sen, kee, e_kee, m_kee, remaining, gain;
  object who = this_player();

  if (!this_object()->id(arg)) return 0;
  if (who->is_busy())
    return notify_fail("你上一个动作还没有完成。\n");
  if ((int)who->query("food")
    >= (int)who->max_food_capacity() * 3)
    return notify_fail("你已经吃得太多了，再吃就撑死了。\n");

  who->add("food", (int)query("food_supply"));

  gain = random(20) + random(who->query("combat_exp") / 20000);
  if (random(2)) who->add("potential", gain);
  else who->add("combat_exp", gain);

  m_sen = (int)who->query("max_sen");
  e_sen = (int)who->query("eff_sen");
  heal = (int)who->query_spi() / 5;
  if (e_sen < m_sen) {
    if ((e_sen + heal) >= m_sen)
      who->set("eff_sen", m_sen);
    else
      who->add("eff_sen", heal);
  }

  e_sen = (int)who->query("eff_sen");
  sen = (int)who->query("sen");
  recover = 15 + heal;
  if (sen < e_sen) {
    if ((sen + recover) >= e_sen)
      who->set("sen", e_sen);
    else
      who->add("sen", recover);
  }

  m_kee = (int)who->query("max_kee");
  e_kee = (int)who->query("eff_kee");
  heal = (int)who->query_con() / 5;
  if (e_kee < m_kee) {
    if ((e_kee + heal) >= m_kee)
      who->set("eff_kee", m_kee);
    else
      who->add("eff_kee", heal);
  }

  e_kee = (int)who->query("eff_kee");
  kee = (int)who->query("kee");
  recover = 15 + heal;
  if (sen < e_sen) {
    if ((sen + recover) >= e_sen)
      who->set("sen", e_sen);
    else
      who->add("sen", recover);
  }

  if (who->is_fighting()) who->start_busy(2);

  add("remaining", -1);
  if (query("remaining")) {
    if ((int)who->query("food") >= (int)who->max_food_capacity() * 3)
      message_vision("$N懒洋洋地搅了一把奶油塞到嘴里，打了一个大大的饱嗝。\n", who);
    else message_vision(eat_msg[random(sizeof(eat_msg))], who, this_object());
  } else {
    message_vision(HIY "$N把最后一块蛋糕吃得干干净净，用舌头搅了搅嘴角上的奶油，\n得意地打了个响指：哈哈！\n" HIY, who);
    tell_room(environment(), name() + "被吃完了！\n");
    destruct(this_object());
  }

  return 1;
}

void do_look(string arg) {
  string msg;
  if (!arg) return 0;
  if (member_array(arg, parse_command_id_list()) == -1) return 0;
  msg = read_file(__DIR__ "cake");
  tell_object(this_player(), msg);
}
