// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration) {
  int i = random(100), j = random(80);
  if (!living(me)) {
    message("vision", me->name() + "痛苦地哼了一声。\n", environment(me), me);
  } else {
    tell_object(me, HIM "想起以前的种种，你不由的一阵阵痛心！\n" NOR);
    //      message("vision", me->name() + "想起以前所做的亏心负心事情，牙关格格地响了起来。\n",
    message_vision(HIM "$N想起以前所做的亏心负心事情，牙关格格地响了起来。\n" NOR, me);
    //            environment(me), me);
  }
  me->receive_damage("kee", 25);
  me->receive_damage("sen", 10);
  if (i > me->query("str")) me->receive_wound("kee", i - me->query("str"));
  else me->receive_wound("kee", 50);
  if (j > me->query("str")) me->receive_wound("sen", j - me->query("str"));
  else me->receive_wound("sen", 40);
  me->apply_condition("qing_damage", duration - 1);
  if (duration < 1) return 0;
  return CND_CONTINUE;
}
