// fangcun@happy
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int extra;
  int orforce, orff;
  object weapon;
  if (me->is_busy())
    return notify_fail("你现在没空！！\n");
  extra = me->query_skill("qianjun-bang", 1);
  if ((int)me->query_skill("qianjun-bang", 1) < 80)
    return notify_fail("你的千钧棒法还不够纯熟！\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("[ 霹雳三打 ]只能对战斗中的对手使用。\n");

  if ((int)me->query("force") < 300)
    return notify_fail("你的内力不足！\n");

  if ((int)me->query("sen") < (int)(me->query("max_sen") / 2))
    return notify_fail("你的精神不足，没法子施展[ 霹雳三打 ]！\n");
  orff = (int)me->query("force_factor");

  orforce = (int)me->query("force");
  me->add("force_factor", extra / 5);
  me->add_temp("apply/attack", extra);
  me->add_temp("apply/damage", (int)(me->query_skill("qianjun-bang", 1) / 6));
  weapon = me->query_temp("weapon");
  msg = HIC "$N运足精神，身形一转，霹雳间连续向$n攻出了三招！!\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  me->set_temp("QJB_perform", 1);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  me->set_temp("QJB_perform", 6);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  me->start_busy(3);
  me->set("force_factor", orff);
  me->set("force", orforce - 200);
  me->add_temp("apply/attack", -extra);
  me->add_temp("apply/damage", -(int)(me->query_skill("qianjun-bang", 1) / 6));
  me->receive_damage("sen", 100);

  return 1;

}
