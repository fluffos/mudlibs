// tie@fengyun
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
	string dodskill,msg;
	int extra;
	object weapon;
	extra = me->query_skill("demon-blade",1);
	if ( extra < 180) return notify_fail("你的［天地人魔连环八式］还不够纯熟！\n");
    weapon = me->query_temp("weapon");
    if (!weapon) return notify_fail("你没带兵器！\n");
	if( (string)weapon->query("skill_type") != "blade" )
    return notify_fail("红雪快刀只能和刀法配合！\n");
	dodskill = (string) me->query_skill_mapped("dodge");
	if ( dodskill != "demon-steps")
			return notify_fail("［红雪快刀］需要如意人魔连环八步的配和！\n");
	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("［红雪快刀］只能对战斗中的对手使用。\n");
        if(me->is_busy())
         return notify_fail("你正忙着呢。\n");
	weapon = me->query_temp("weapon");
	msg = HIY "$N的黑刀如狂风暴雨般地施展开来，快得令人难以置信!"HIW"弧月斩\n"NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        msg = HIY  "横劈！" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        msg = HIY  "竖砍！" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        msg = HIY  "反撩！" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        msg = HIY  "斜披！" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        msg = HIY  "倒钩！" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        msg = HIY  "直戳！" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        msg = HIW  "十字斩！" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
   me->start_busy(1);
	return 1;
}
