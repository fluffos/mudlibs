// moon@happy
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int extra;
  int orforce, orff;
  object weapon;
  if (me->is_busy())
    return notify_fail("你现在没空！！\n");
  if (me->query("family/family_name") != "月宫")
    return notify_fail(HIM "想偷用别人的功夫?你还真是个天才呀!\n");
  extra = me->query_skill("sword");
  if ((int)me->query_skill("snowsword", 1) < 80)
    return notify_fail("你的风回雪舞剑还不够纯熟！\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("[ 泪雨纷飞 ]只能对战斗中的对手使用。\n");

  if ((int)me->query("force") < 300)
    return notify_fail("你的内力不足！\n");

  if ((int)me->query("sen") < (int)(me->query("max_sen") / 2))
    return notify_fail("你的精神不足，没法子施展[ 泪雨纷飞 ]！\n");
  orff = (int)me->query("force_factor");
  orforce = (int)me->query("force");
  me->add("force_factor", extra / 8);
  me->add_temp("apply/attack", extra / 2);
  weapon = me->query_temp("weapon");
  msg = HIY "$N手中宝剑突然向上一挑，使出了本门绝学[ 泪雨纷飞 ]之势，一时对方竟不知如何破解!!\n" NOR;
  message_vision(msg, me, target);
  msg = HIR "胭脂泪！" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIW "冰雪情！" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIM "碎心剑！" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  me->start_busy(3);
  me->set("force_factor", orff);
  me->set("force", orforce - 300);
  me->add_temp("apply/attack", -extra / 2);
  return 1;

}
