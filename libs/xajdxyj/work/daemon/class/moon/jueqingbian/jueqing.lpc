// moon@happy
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
	string msg;
	int extra;
	int orforce,orff;
	object weapon;
	if(me->is_busy())
		return notify_fail("你现在没空！！\n");
       if(me->query("family/family_name")!="月宫")
        return notify_fail(HIM"想偷用别人的功夫?你还真是个天才呀!\n");
        extra = me->query_skill("whip");
       if ((int)me->query_skill("jueqingbian", 1) < 80) 
           return notify_fail("你的绝情鞭法还不够纯熟！\n");
	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
                return notify_fail("[ 绝情三势 ]只能对战斗中的对手使用。\n");
    
	if((int)me->query("force") < 300 )
		return notify_fail("你的内力不足！\n");

    if((int)me->query("sen") < (int)(me->query("max_sen")/2) )
                return notify_fail("你的精神不足，没法子施展[ 绝情三势 ]！\n");
    orff=(int)me->query("force_factor");
	orforce=(int)me->query("force");
	me->add("force_factor",extra/5);
   me->add_temp("apply/attack",extra*2/3);
	weapon = me->query_temp("weapon");
            msg = HIY  "$N手中长鞭向后一收，猛然使出[ 绝情三势 ]，连连向$n要害部位发起猛击!!\n"NOR;
	message_vision(msg,me,target);
         write (HIR  "绵绵深情！" NOR);
       COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
         write ( HIW  "恨无人赏！" NOR);
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
         write ( HIM  "魂断欲绝！" NOR);
     COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
       me->start_busy(3+random(2));     
          me->set("force_factor",orff);
	me->set("force",orforce-300);
       me->add_temp("apply/attack",-extra*2/3);
	return 1;

  }
 
