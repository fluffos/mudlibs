//Ansi 99.8
#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
	object where;
        string msg;
        int damage, ap, dp, chance, w_num;

        if( !target ) target = offensive_target(me);

   where=environment(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展「无尽风波」？\n");

	if( !me->is_fighting() )
		return notify_fail("「无尽风波」只能在战斗中使用。\n");
        if(me->query("family/family_name")!="东海龙宫")
                return notify_fail("你不能用别派的特殊攻击\n");
        if((int)me->query("force") < 300 )
                return notify_fail("你的内力不够！\n");

        if((int)me->query("kee") < 100 )
                return notify_fail("你的气血不足，没法子施用外功！\n");

   if((int)me->query_skill("fengbo-cha", 1) <100)
     return notify_fail("你的风波十二叉级别还不够！\n");

        me->add("force", -300);
        me->receive_damage("kee", 100);

   	msg = HIC"$N掀起「无尽风波」, 铺天盖地地卷向$n。\n";
	ap=(int)me->query_skill("fork");
	ap=ap*ap*ap/10 + (int)me->query("combat_exp");

	dp=(int)target->query_skill("parry");
	dp=dp+(int)target->query_skill("dodge")/10;
	dp=dp*dp*dp/10 + (int)target->query("combat_exp");
     if( random( ap+dp ) > dp ) {
		w_num = random(me->query_skill("fork")/12) + me->query_skill("fork")/12 + 1;
                damage = w_num * 25;
		target->receive_wound("kee",damage/3);
		target->receive_damage("kee",damage/2);
		target->start_busy(random(1)+1);
		msg += CYN"结果「无尽风波」在$n身上造成"+ chinese_number(w_num) +"处伤害！\n"NOR;
	}
	
	else 
                msg += "但是被$n躲开了。\n"NOR;
        message_vision(msg, me, target);
        if( damage > 0 ) COMBAT_D->report_status(target);
   
        if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
        }

        me->start_busy(3);
        return 1;
}
