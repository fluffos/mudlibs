//Cracked by Roath
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
        string msg;
        int extra,i,lmt;
        object weapon;
        extra = me->query_skill("xiaofeng-sword",1);
        if ( extra < 80) return notify_fail("你的晓风残月剑还不够纯熟！\n");
        extra = me->query_skill("zhenyuan-force",1);
        if ( extra < 80) return notify_fail("你的镇元神功还不够纯熟，无法发挥晓风残月剑的威力！\n");
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("［风月无边］只能对战斗中的对手使用。\n");

        if((int)me->query("force")<500)
              return notify_fail("你的内力不足");

        weapon = me->query_temp("weapon");
        msg = HIR  "$N狂性大发，使出了绝技［风月无边］，手中的"+ weapon->name()+  HIR"狂风暴雨般地向$n袭来！" NOR;
        message_vision(msg,me,target);
        me->add_temp("apply/attack",extra/2);
        me->add_temp("apply/damage",extra/5);
        lmt = random(2)+3;
        
        for(i=1;i<=lmt;i++)
        {
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"));
        }
        me->add_temp("apply/attack",-extra/2);
        me->add_temp("apply/damage",-extra/5);
        me->start_busy(3);
        me->add("force",-500);
        return 1;
}
