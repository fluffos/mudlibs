// blood-ice.c 血意寒冰 for xueshan
// by FoF (11/02/1999)

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
    object weapon;
                
    if( !target ) target = offensive_target(me);

    if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
        return notify_fail("看清楚了，你要对谁施展「血意寒冰」？\n");

    if(!me->is_fighting())
        return notify_fail("「血意寒冰」只能在战斗中使用！\n");

    if((int)me->query("max_force") < 1000 )
        return notify_fail("你的内力不够！\n");

	if((int)me->query("force") < 1000 )
		return notify_fail("你的内力不足！\n");

    if((int)me->query("sen") < 300 )
        return notify_fail("你的精神不足，没法子施用外功！\n");

    if((int)me->query_skill("bingpo-blade", 1) + (int)me->query_cor() < 150 )
        return notify_fail("你的冰魄寒刀级别还不够，使不出这一招！\n");

    me->delete("env/brief_message");
	target->delete("env/brief_message");

    message_vision(HIB"\n$N突然嗥叫一声，挥刀割向自己的前臂，再转身将刀一挥，\n"HIR"鲜血瞬间凝成寒冰射向$n！\n"NOR,me,target);

    me->set_temp("BI_perform", 5);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    me->set_temp("BI_perform", 6);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

    me->delete_temp("BI_perform");

    me->receive_damage("sen", 100);
    me->add("force", -200);

    if( !target->is_fighting(me) ) {
        if( living(target) ) {
            if( userp(target) ) target->fight_ob(me);
            else target->kill_ob(me);
        }
    }
    me->start_busy(2);
    return 1;
}

