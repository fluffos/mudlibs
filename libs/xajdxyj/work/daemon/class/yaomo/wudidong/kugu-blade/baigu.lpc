// wdd@happy
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int extra;
  int orforce;
  object weapon;
  if (me->is_busy())
    return notify_fail("你现在没空！！\n");
  extra = me->query_skill("kugu-blade", 1);
  if ((int)me->query_skill("kugu-blade", 1) < 80)
    return notify_fail("你的[枯骨刀]还不够纯熟！\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("[ 百骨绝杀 ]只能对战斗中的对手使用。\n");

  orforce = (int)me->query("force_factor");
  me->add("force_factor", extra / 8);
  me->add_temp("apply/attack", extra / 2);
  weapon = me->query_temp("weapon");
  msg = HIM "$N突然加快步伐,手中厉刃犹如旋风一般,不顾一切的向$n飞扑过去！!\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  me->set_temp("QJB_perform", 1);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  me->start_busy(2);
  me->set("force_factor", orforce);
  me->add_temp("apply/attack", -extra / 2);
  me->receive_damage("sen", 100);
  me->add("force", -200);
  return 1;

}
