*** 关于被杀死后技能损失的改进
提出：fof
简要说明：原来对死亡的惩罚太严重（各项技能减1级），对玩家打击太大，并且受到惩罚
    的概率很高，rancom(100) > (int)victim->query("kar") 这个条件是很容易满足的，
    且与捐钱加的福缘无关。
编程实现：fof
完成度：80%
做法：
修改/feature/skill.c中的skill_death_penalty()函数和skill_death_recover()函数
int skill_death_penalty()
{
  string *sk;
  int i,ii,n;

  if( wizardp(this_object()) || !mapp(skills) ) return 0;

  sk = keys(skills);

  n = random(10 - this_object()->query_kar() / 5); //随机减少若干项技能，跟福缘有关
  for(i = 0; i < n; i ++) {                        //n 是减少的技能的总级数
    ii = random(sizeof(sk));                       //有可能一项技能被连续减掉几级
    skills[sk[ii]] --;
    if(skills[sk[ii]] < 0) delete_skill(sk[ii]);
        this_object()->add("death_skill_loss/" + sk[ii], 1);//把损失的技能记录起来
  }
  skill_map = 0;
  return 1;
}

int skill_death_recover()
{
  string *sk;
  object obj;
  int i, amount;

  if( !mapp(skills) ) return 0;
  sk = keys(skills);
  obj = this_object();

  for(i = 0; i < sizeof(sk); i ++) {                //所有损失的技能同时恢复
    amount = obj->query("death_skill_loss/"+sk[i]);
    if （ amount > 10 )  amount = 10;               //每项技能最多恢复10级
    skills[sk[i]] += amount;
  }
  obj->delete("death_skill_loss");
  return 1;
}

