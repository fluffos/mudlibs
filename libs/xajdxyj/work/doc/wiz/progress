string asked_guo()
{
   int i, j, n, max, gived;
   object guo, me, who, *list;
   me = this_object();

   //if no renshenguo party at all...
   if( query_temp("ready") != 1 ) return ("人参果可是个好东西。\n");

   //if not in the right place, no guo...
   //need the right name, also right outdoors(so ppls can not use fake room).
   if( environment(me)->query("short") != room_short || environment(me)->query("outdoors") != "wuzhuang" )
	  return ("请速到" + room_short + "参加人参果大会。\n");

	//if has not waited for 3 minutes...
   if( query_temp("ready1") != 1 ) return ("不要急，再等等。\n");

   //if finished...
   if( query_temp("finished") == 1 ) return ("人参果已分发完了。\n");

	//check who are invited first and give them renshen guo...
	list = all_inventory( environment(this_object()) );
	j = sizeof(list);
	n = 1;
	gived = 0;
	max = 0;
	while(gived < 5)                  //最多给5个人参果，可以适当修改
	{
		for (i =0; i < j; i ++)       //根据接受邀请的人的名单确定发果的顺序
   		{
			if ( n == 1 )             //找出接受邀请的人数最大值以减少循环次数
   			{
	   			if ( me->query_temp("accepted/" + list[i]->query("id") ) > max )
   					max = me->query_temp("accepted/" + list[i]->query("id") );
   			}
			if ( n == me->query_temp("accepted/" + list[i]->query("id")) )
			{			
				guo = new("/d/obj/drug/renshen-guo");
				guo->move(list[i]);
				message_vision("$N给$n一枚人参果。\n", me, list[i]);
				announce (me, "恭喜恭喜！" + list[i]->query("name") + "获得人参果一枚。\n");
				gived ++;
				if ( gived == 5 )  break;    //跳出for循环，gived=5，也必跳出
			}                                //while 循环而结束分果
		}
		n ++;
		if ( n > max )   break;       //减少循环次数
	}
	if ( gived == 0 ) return ("谁要人参果？\n");

    set_temp("finished", 1);
    me->delete_temp("accepted");      //把接受邀请的人的名单删掉
    call_out("finishing", 10);

    return ("好！人参果分发完毕，诸位仙贤尽情享用吧。\n");
}
void inviting (object me)
{
   int i, j;
   object *list;

   if (! me->query_temp("invite"))
   return;

   if(acpt_n < 30)           //最多接受30人
   {
   	 remove_call_out ("inviting");
     call_out ("inviting", 3, me);
   }

   list = all_inventory( environment(this_object()) );//找出这个房间里所有的物件

   j = sizeof(list);
   for (i =0; i < j; i ++)       //挨个判断是否把玩家纳入分果人名单
   {
     string here, there;

     reset_eval_cost();
    
     if (environment(list[i]) != environment(this_object()) )
        continue;  //地方不对的，不管
    
     if (list[i]->query_temp("accepted") && !list[i]->query_temp("accept"))
     	continue;  //没有使accept zhenyuan daxian 的和已经被纳入名单的，不管

     if (list[i]->is_fighting())
        continue;  //正在打架的，不管
    
     if (list[i]->is_busy())
        continue;  //忙着的，不管
    
     if (list[i]->query_temp("no_move"))
        continue;  //动不了的，不管
    
     if (!living(list[i]))
        continue;  //死了的，不管
    
     if ((string)list[i]->query_temp("accept")!=me->query("id"))
        continue;  //不是接受zhenyuan daxian 邀请的，不管

     if (list[i]->query_kar() < 20 && random(6) < 2)  //福缘太低就得多等一会儿
     	continue;

     list[i]->set_temp("accept",0);
     list[i]->set_temp("accepted",1);
     me ->set_temp("accepted/" + list[i]->query("id"), acpt_n);//把玩家的id及
     acpt_n ++;                    //接受邀请的序号纪录起来，以便后来分果时用
	}
}
