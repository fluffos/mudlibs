inherit ITEM;
inherit F_UNIQUE;
#include <ansi.h>
void create() {
  set_name(CYN "金饭盆" NOR, ({ "jinfanpen", "pen" }));
  set_weight(10);
  set("no_put", 1);
  set("is_task", "金角大王");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "金角大王用的金制的盆子。\n");
    set("unit", "个");
    set("value", 0);

  }
  set("is_monitored", 1);
}
