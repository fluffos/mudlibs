//DHNY2000
#include <armor.h>
inherit CLOTH;
inherit F_UNIQUE;

void create() {
  set_name("破烂肚兜", ({ "pldudou", "dudou" }));
  set_weight(2000);
  set("no_put", 1);
  set("is_task", "法明长老");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "法明长老的破烂肚兜。\n");
    set("value", 0);
    set("material", "cloth");
    set("armor_prop/armor", 1);
  }
  set("is_monitored", 1);
  setup();
}
