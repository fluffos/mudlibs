inherit ITEM;
inherit F_UNIQUE;
#include <ansi.h>
void create()
{
        set_name(HIB"墨镜"NOR, ({"mojing"}));
        set_weight(10);
       set("no_put",1);
        set("is_task","田鼠精");
        if( clonep() )
                set_default_object(__FILE__);
        else {
                 set("long", "一副田鼠精的专用墨镜。\n");
                set("unit", "副");
                set("value", 0);
                
        }
        set("is_monitored",1);
}


