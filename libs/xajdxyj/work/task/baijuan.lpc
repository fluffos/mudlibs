inherit ITEM;
inherit F_UNIQUE;
#include <ansi.h>
void create()
{
        set_name(HIW "白卷" NOR, ({"baijuan", "juan"}));
        set_weight(10);
      set("no_put",1);
        set("is_task","萧升");
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "当年萧升全靠这个白卷才当上振远镖局总镖头。\n");
                set("unit", "本");
                set("value", 0);
                
        }
        set("is_monitored",1);
}


