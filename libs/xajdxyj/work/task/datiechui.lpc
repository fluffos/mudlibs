inherit ITEM;
inherit F_UNIQUE;
#include <ansi.h>
void create()
{
        set_name(YEL "大号铁锤" NOR, ({"datiechui", "chui"}));
        set_weight(100);
        set("no_put",1);
        set("is_task","周铁匠");
        if( clonep() )
                set_default_object(__FILE__);
        else {
                  set("long", "周铁匠打铁用的锤子。\n");
                set("unit", "把");
                set("value", 0);
                
        }
        set("is_monitored",1);
}


