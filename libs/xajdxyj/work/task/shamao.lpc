 
#include <armor.h>
#include <ansi.h>
inherit HEAD;
inherit F_UNIQUE;

void create()
{
        set_name("傻帽", ({ "shamao", "sha mao", "mao","hat" }) );
        set_weight(1000);
     set("no_put",1);
        set("is_task","鹦鹉将军");
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "顶");
     set("long", "鹦鹉将军的傻帽\n");
                set("material", "cloth");
                set("value", 1000);
     set("no_sell", 1);
                set("armor_prop/armor", 3);
     set("armor_prop/intelligence",-1);
     }
      set("is_monitored",1);
        setup();
}

