inherit ITEM;
inherit F_UNIQUE;
#include <ansi.h>
void create() {
  set_name(HIG "碧海叉" NOR, ({ "bihai" }));
  set_weight(10);
  set("no_put", 1);
  set("is_task", "龙女");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是龙女专用的武器。\n");
    set("unit", "把");
    set("value", 0);

  }
  set("is_monitored", 1);
}
