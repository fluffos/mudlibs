inherit ITEM;
inherit F_UNIQUE;
#include <ansi.h>
void create()
{
        set_name(BLK "羊肉泡沫" NOR, ({"yangroupaomo", "paomo"}));
        set_weight(30);
        set("no_put",1);
        set("is_task","疥顶小僧");
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "疥顶小僧最喜欢的东西。\n");
                set("unit", "碗");
                set("value", 0); 
        }
        set("is_monitored",1);
}


