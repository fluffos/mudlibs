inherit ITEM;
inherit F_UNIQUE;
#include <ansi.h>
void create() {
  set_name(HIW "冰袋" NOR, ({ "bingdai", "dai" }));
  set_weight(10);
  set("no_put", 1);
  set("is_task", "鹦鹉将军");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "鹦鹉将军用来装冰块的袋子。\n");
    set("unit", "件");
    set("value", 0);

  }
  set("is_monitored", 1);
}
