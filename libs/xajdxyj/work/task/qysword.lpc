//dhny 2000
#include <weapon.h>
#include <ansi.h>
inherit SWORD;
inherit F_UNIQUE;

void create()
{
   set_name(HIC"青云宝剑"NOR, ({"qysword", "jian", "sword"}));
   set_weight(3000);
   set("no_put",1);
   set("is_task","魔礼青");
   if (clonep())
     set_default_object(__FILE__);
   else {
     set("unit", "柄");
     set("long", "这是魔礼青的青云宝剑。\n");
     set("value", 0);
     set("material", "steel");
     set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中。\n");
     set("unwield_msg", "$N将手中的$n插回剑鞘。\n");
   }
   set("is_monitored",1);
   init_sword(70);
   setup();
}
