//DHNY2000
 
inherit ITEM;
inherit F_UNIQUE;
#include <ansi.h>
void create()
{
        set_name(HIW"驻颜丹"NOR, ({ "zydan", "dan"}) );
        set_weight(100);
        set("is_task","嫦娥");
        set("no_put",1);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "颗");
                set("long","嫦蛾的驻颜丹，据说吃了可以驻颜。\n");
        }
	set("is_monitored",1);
}
void init()
{
  add_action("do_eat","eat");
}
int do_eat(string arg)
{
object who=this_player();
object me=this_object();
if (!arg) return notify_fail("你要吃什么? \n");
if (arg=="zydan")
  {
 message_vision(HIW"$N捏起一颗驻颜丹,轻轻放到口里.\n
 $N顿时觉的浑身充满了新的力量,好象漂亮了许多.\n"NOR,who);
  who->add_temp("apply/personality",6);
       destruct(me);
  }
else return notify_fail("什么?\n");
return 1;
}