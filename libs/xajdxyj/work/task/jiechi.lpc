//DHNY2000

#include <weapon.h>
#include <ansi.h>
inherit SWORD;
inherit F_UNIQUE;
void create() {
  set_name(WHT "戒尺" NOR, ({ "jiechi", "sword" }));
  set_weight(3000);
  set("no_put", 1);
  set("is_task", "平等王");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "平等王的戒尺\n");
  }
  set("is_monitored", 1);
}
