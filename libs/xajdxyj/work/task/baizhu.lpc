inherit ITEM;
inherit F_UNIQUE;
#include <ansi.h>
void create()
{
        set_name(HIW "白猪" NOR, ({"baizhu", "zhu"}));
        set_weight(10);
  set("no_put",1);
        set("is_task","卢生");
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "卢生养的宠物,看起来白白胖胖,挺可爱的。\n");
                set("unit", "头");
                set("value", 0);
                
        }
        set("is_monitored",1);
}


