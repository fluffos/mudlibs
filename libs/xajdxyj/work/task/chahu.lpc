inherit ITEM;
inherit F_UNIQUE;
#include <ansi.h>
void create()
{
        set_name(HIB"茶壶"NOR, ({"chahu"}));
        set_weight(10);
     set("no_put",1);
        set("is_task","吴文");
        if( clonep() )
                set_default_object(__FILE__);
        else {
                 set("long", "村长吴文用来沏茶的茶壶。\n");
                set("unit", "把");
                set("value", 0);
                
        }
        set("is_monitored",1);
}


