//DHNY2000

inherit ITEM;
inherit F_UNIQUE;

#include <ansi.h>
void create() {
  set_name(HIW "云母粉" NOR, ({ "yunmufen", "yunmu fen", "fen" }));
  set_weight(100);
  set("is_task", "何仙姑");
  set("no_put", 1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "贴");
    set("long", "何仙姑的云母粉，据说吃了可以成仙。\n");
  }
  set("is_monitored", 1);
}
