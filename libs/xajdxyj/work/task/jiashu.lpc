//DHNY2000

inherit ITEM;
inherit F_UNIQUE;
#include <ansi.h>
void create() {
  set_name(YEL "家书" NOR, ({ "jiashu", "jia shu", "mail" }));
  set_weight(100);
  set("no_put", 1);
  set("is_task", "红孩儿");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "封");
    set("long", "铁扇公主给红孩儿的一封家书。\n");
  }
  set("is_monitored", 1);
}
