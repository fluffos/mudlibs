inherit ITEM;
inherit F_UNIQUE;
#include <ansi.h>
void create()
{
        set_name(YEL"道德经"NOR, ({"daodebook", "book"}));
        set_weight(10);
        set("no_put",1);
        set("is_task","法明长老");
        if( clonep() )
                set_default_object(__FILE__);
        else {
                 set("long", "法明长老的书本。\n");
                set("unit", "本");
                set("value", 0);
                
        }
        set("is_monitored",1);
}


