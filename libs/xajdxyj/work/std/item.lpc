/* <SecCrypt CPL V3R05> */

// item.c

#include <dbase.h>
#include <move.h>
#include <name.h>

inherit F_CLEAN_UP;
inherit F_DBASE;
inherit F_MOVE;
inherit F_NAME;

varargs string short(int raw);
string set_short();
varargs string name(int raw);
mixed set(string prop, mixed data);
int delete(string prop);

void setup() {
  seteuid(getuid());
  call_out("set_short", 1);
}

int is_item() { return 1; }

varargs string short(int raw)  // give short
{
  string str;

  if (str = query_temp("short_desc")) return str;
  return set_short();
}

string set_short()  // set short
{
  string str;

  if (!stringp(str = query("short")))
    str = name() + "(" + capitalize(query("id")) + ")";
  set_temp("short_desc", str);

  return str;
}

varargs string name(int raw) {
  string str;

  if (stringp(str = query("name"))) return str;
  else return file_name(this_object());
}

mixed set(string prop, mixed data) {
  mixed ret = ::set(prop, data);
  if (prop[0..4] == "short" || prop[0..3] == "name") call_out("set_short", 1);
  return ret;
}

int delete(string prop) {
  ::delete(prop);
  if (prop[0..4] == "short" || prop[0..3] == "name") call_out("set_short", 1);
}
