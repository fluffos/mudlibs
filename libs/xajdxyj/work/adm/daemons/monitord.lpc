#pragma optimize

#include <ansi.h>

inherit F_DBASE;

nosave string *log_msg = ({ });
nosave string *log_msg2 = ({ });
nosave int last_log = 0;

void do_log();

void create()
{
   seteuid(getuid());
   set("name", "监控精灵");
   set("id", "monitord");
}

void report_system_msg (string msg)
{
   CHANNEL_D->do_channel(this_object(), "sys", msg);
   log_msg += ({ "[" + ctime(time()) + "] " + msg + "\n" });
   do_log();
//   log_file("monitord", "[" + ctime(time()) + "] " + msg + "\n");
}

void report_system_object_msg (object ob, string msg)
{
   CHANNEL_D->do_channel(this_object(), "sys", ob->name() +
      "(" + capitalize(ob->query("id")) + ")" + msg);
   log_msg += ({ "[" + ctime(time()) + "] " + ob->name() + "(" +
      capitalize(ob->query("id")) + ")" + msg + "\n" });
   do_log();
//   log_file("monitord","["+ctime(time())+"] "+
//     ob->name()+"("+capitalize(ob->query("id"))+")"+msg+"\n");
}

void do_log()
{
   if( time() - last_log < 5 ) return;
   if( sizeof(log_msg) ) {
      log_msg2 = log_msg;
      log_msg -= log_msg2;
      log_file("monitord", implode(log_msg2, "\n"));
   }
}

