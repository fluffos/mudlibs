#include <globals.h>
#include <net/daemons.h>
#include <net/macros.h>

int LAST_HARD_DIS = 0;
void init_cron();
void announce_task();
void check_dns();


void create() {
  seteuid(ROOT_UID);
  init_cron();
}
int query_last_hard_dis() {
  return LAST_HARD_DIS;
}
int set_last_hard_dis() {
  LAST_HARD_DIS = time();
  return time();
}
void init_cron() {
  mixed *local;
  local = localtime(time());



  if (!((local[1] % 30))) announce_task();

  // 每七十六分钟出一颗龙珠，当七颗全齐时，要等12小时再重现，到时旧的会消失
  //	if ( !((local[1]%76))) announce_db();
  //	if ( !((local[1]%720))) renew_db();
  // Check pets that's lost heartbeat
  //if( !(local[1]%5)) 
  //if(!find_object(VOID_OB))
  //      call_other(VOID_OB,"???");
  //check_pets();
  //	}
  // if dns_master not working, every 15 mins re-initalize it

  call_out("init_cron", 60);
}




void announce_task() {
  object *user;
  user = users();
  TASK_D->init_dynamic_quest();
  message("vision", HIW "\n【任务】欢乐园任务重新分配 ．．．", users());
  message("vision", HIW "分配完毕。\n" NOR, users());
}
