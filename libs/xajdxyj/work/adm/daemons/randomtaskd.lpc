string *roomlines;
mapping *read_table(string file);

varargs void init_dynamic_quest(int hard);
varargs int spread_quest(string one_quest, int hard);
object find_env(object ob);
varargs int already_spreaded(string str, int hard);
varargs int destruct_spreaded(string str,int hard);
string dyn_quest_list();
string randomlocation(int i1);

void create()
{
	string file;
//	quests = read_table("/daemon/quest/task.obj");
        file = read_file("/daemon/quest/address.map");
	roomlines = explode(file,"\n");	
	//CRON_D->set_last_hard_dis();
	init_dynamic_quest(1);
}

varargs void init_dynamic_quest(int hard)
{
	int i;
	for( i=0; i < sizeof(quests); i++)
		spread_quest(quests[i],hard);
}

string dyn_quest_list()
{
	string output="";
	object owner,item;
	string nnm;
        int i;
        for( i=0; i < sizeof(quests); i++)
	{
	reset_eval_cost();
	//if(!objectp(owner= find_object(quests[i]["owner_name"])))
	//owner = load_object(quests[i]["owner_name"]);
        if(!objectp(item= find_object(quests[i])))
        item = load_object(quests[i]);
    //    nnm=item->query("name");
	if(already_spreaded(quests[i]))
	{
	if(random(2))
	output += sprintf("%s（%s）\n",item->query("name"),item->query("id"));
	else
	output = sprintf("%s（%s）\n",item->query("name"),item->query("id")) + output;
	}
	else
	{
	if(random(2))
	output += sprintf("%s（%s）〔已完成〕\n",item->query("name"),item->query("id"));
	else
	output = sprintf("%s（%s）〔已完成〕\n",item->query("name"),item->query("id")) + output;
	}
	}
	return output;
}

varargs int spread_quest(string quest, int hard)
{
	object obj0,obj1,obj2,obj3,tempob;
	object cur_obj;
	object next_obj;
	object tar;
	object *inv;
	object *target=({});
	int l;
	string location;
	int temp,i1;
    string *strtemp,locastr;
	
         int  i, j, k;
        mixed*  file, exit;
//	if(already_spreaded(quest,hard)) return 0;
    if(already_spreaded(quest,hard))destruct_spreaded(quest,hard);
	reset_eval_cost();
     strtemp=keys(allloca);
   i1=sizeof(strtemp);
   temp=random(i1);
   if (temp==i1) temp=0;
   locastr=randomlocation(temp);  
   obj0=load_object(locastr);
        

	if(obj0)
	obj0->reset();
	else
	obj0=load_object(locastr);
	cur_obj =obj0;
	if(cur_obj)
	{
	inv = all_inventory(cur_obj);
	for(i=0; i<sizeof(inv); i++) {
	if(inv[i]->is_character() && !userp(inv[i]))
	target += ({ inv[i] });
	if(inv[i]->is_container()) target += ({ inv[i] });
		}
	}
	if(sizeof(target)) cur_obj = target[random(sizeof(target))];
	if(cur_obj)
	{
	tar = new(quest);
	tar->set("value",0);
	tar->move(cur_obj);		
	}
return 1;
}
varargs int destruct_spreaded(string str,int hard)
{
        object ob,*ob_list;
        int i;
        if(!str) return 0;
	if(hard)
	{
        ob_list = children(str);
        for(i=0; i<sizeof(ob_list); i++) {
                ob=find_env(ob_list[i]);
                if(ob)
		{ ob_list[i]->move(VOID_OB);
		 destruct(ob_list[i]);
		}
	}
	return 0;
	}
	else
	{
	if(!str) return 0;
	ob_list = children(str);
	for(i=0; i<sizeof(ob_list); i++) {
                ob=find_env(ob_list[i]);
                if(ob){destruct(ob_list[i]);
			return 1;}
	}
	return 0;
	}
}
varargs int already_spreaded(string str,int hard)
{
        object ob,*ob_list;
        int i;
        if(!str) return 0;
	if(hard)
	{
        ob_list = children(str);
        for(i=0; i<sizeof(ob_list); i++) {
                ob=find_env(ob_list[i]);
                if(ob)
		{ ob_list[i]->move(VOID_OB);
		 destruct(ob_list[i]);
		}
	}
	return 0;
	}
	else
	{
	if(!str) return 0;
	ob_list = children(str);
	for(i=0; i<sizeof(ob_list); i++) {
                ob=find_env(ob_list[i]);
                if(ob)
			return 1;
	}
	return 0;
	}
}

object find_env(object ob)
{
	while(ob)
	{
	if(ob->query("short") ) return ob;
	else ob=environment(ob);	
	}
	return ob;
}

mapping *read_table(string file)
{
	string *line, *field, *format;
	mapping *data;
	int i, rn, fn;

	line = explode(read_file(file), "\n");
	data = ({});
	for(i=0; i<sizeof(line); i++) {
		if( line[i]=="" || line[i][0]=='#' ) continue;
		if( !pointerp(field) ) {
			field = explode( line[i], ":" );
			continue;
		}
		if( !pointerp(format) ) {
			format = explode( line[i], ":" );
			continue;
		}
		break;
	}

	for( rn = 0, fn = 0; i<sizeof(line); i++) {
		if( line[i]=="" || line[i][0]=='#' ) continue;
		if( !fn ) data += ({ allocate_mapping(sizeof(field)) });
		sscanf( line[i], format[fn], data[rn][field[fn]] );
		fn = (++fn) % sizeof(field);
		if( !fn ) ++rn;
	}
	return data;
}
string randomlocation(int i1)
{
   string *str1,*str2,loca;
   int i2,temp;
   str1=keys(allloca);
   str2=allloca[str1[i1]];
   i2=sizeof(str2);
   temp=random(i2);
   if (temp==0 || temp==i2) temp=1;
   loca=str2[0]+str2[temp];
   return loca;
}