#pragma optimize

#include <localtime.h>
#include <ansi.h>

inherit F_DBASE;

#define XYJ_O_YEAR_TIME 946656000
// 欢乐纪元元年的时间

nosave string *c_digit = ({ "零", "十", "百", "千", "万", "亿", "兆" });
nosave string *c_num = ({
  "零",
  "一",
  "二",
  "三",
  "四",
  "五",
  "六",
  "七",
  "八",
  "九",
  "十",
  "十一",
  "十二",
  "十三",
  "十四",
  "十五",
  "十六",
  "十七",
  "十八",
  "十九",
  "二十",
  "二十一",
  "二十二",
  "二十三"
});
nosave string *sym_tien = ({ "甲", "乙", "丙", "丁", "戊", "己", "庚", "辛", "壬", "癸" });
nosave string *sym_dee = ({ "子", "丑", "寅", "卯", "辰", "巳", "午", "未", "申", "酉", "戌", "亥" });
nosave string *c_season = ({ "春", "夏", "秋", "冬" });
nosave string *c_week = ({ "日", "一", "二", "三", "四", "五", "六" });
nosave mapping festival_Jan = ([ "1": "元旦" ]);
nosave mapping festival_Feb = ([ "14": "情人节" ]);
nosave mapping festival_Mar = ([ "5": "雷锋同志诞辰纪念", "8": "妇女节", "12": "植树节" ]);
nosave mapping festival_Apr = ([ "1": "愚人节" ]);
nosave mapping festival_May = ([ "1": "劳动节" ]);
nosave mapping festival_Jun = ([ "1": "儿童节" ]);
nosave mapping festival_Jul = ([ "1": "党的生日" ]);
nosave mapping festival_Aug = ([ "1": "建军节" ]);
nosave mapping festival_Sep = ([ "10": "教师节" ]);
nosave mapping festival_Oct = ([ "1": "国庆节" ]);
nosave mapping festival_Nov = ([]);
nosave mapping festival_Dec = ([]);
nosave int current_hour;
nosave int current_bj_hour;

string chinese_date(int);
string xyj_date(int);
string xyj_time(int);
string xyj_time2(int);
string xyj_season(int);
int query_timen(int, string);
string query_timec(int, string);
mixed query_bj_time(int, string);
void time_recycle();
void time_event();
void hour_event(int);
void day_event();
void month_event();

void create() {
  seteuid(ROOT_UID);
  set("name", "计时精灵");
  set("id", "timed");
  set_heart_beat(1);
  time_recycle();
}

string chinese_number(int i) {
  if (i < 0) return "负" + chinese_number(-i);
  if (i < 11) return c_num[i];
  if (i < 20) return c_num[10] + c_num[i - 10];
  if (i < 100) {
    if (i % 10) return c_num[i / 10] + c_digit[1] + c_num[i % 10];
    else return c_num[i / 10] + c_digit[1];
  }
  if (i < 1000) {
    if (i % 100 == 0)
      return c_num[i / 100] + c_digit[2];
    else if (i % 100 < 10)
      return c_num[i / 100] + c_digit[2] + c_num[0] + chinese_number(i % 100);
    else if (i % 100 < 20)
      return c_num[i / 100] + c_digit[2] + c_num[1] + chinese_number(i % 100);
    else return c_num[i / 100] + c_digit[2] + chinese_number(i % 100);
  }
  if (i < 10000) {
    if (i % 1000 == 0)
      return c_num[i / 1000] + c_digit[3];
    else if (i % 1000 < 100)
      return c_num[i / 1000] + c_digit[3] + c_digit[0] + chinese_number(i % 1000);
    else
      return c_num[i / 1000] + c_digit[3] + chinese_number(i % 1000);
  }
  if (i < 100000000) {
    if (i % 10000 == 0)
      return chinese_number(i / 10000) + c_digit[4];
    else if (i % 10000 < 1000)
      return chinese_number(i / 10000) + c_digit[4] + c_digit[0] + chinese_number(i % 10000);
    else
      return chinese_number(i / 10000) + c_digit[4] + chinese_number(i % 10000);
  }
  if (i < 1000000000000) {
    if (i % 100000000 == 0)
      return chinese_number(i / 100000000) + c_digit[5];
    else if (i % 100000000 < 10000000)
      return chinese_number(i / 100000000) + c_digit[5] + c_digit[0] + chinese_number(i % 100000000);
    else
      return chinese_number(i / 100000000) + c_digit[5] + chinese_number(i % 100000000);
  }
  if (i % 1000000000000 == 0)
    return chinese_number(i / 1000000000000) + c_digit[6];
  else if (i % 1000000000000 < 100000000000)
    return chinese_number(i / 1000000000000) + c_digit[6] + c_digit[0] + chinese_number(i % 1000000000000);
  else
    return chinese_number(i / 1000000000000) + c_digit[6] + chinese_number(i % 1000000000000);
}

string chinese_date(int time) {
  mixed *local;

  local = localtime(time);

  return sprintf("%s%s年%s月%s日%s(%s)时%s刻",
    sym_tien[(local[LT_YEAR] + 6) % 10], sym_dee[(local[LT_YEAR] + 10) % 12],
    chinese_number(local[LT_MON] + 1),
    chinese_number(local[LT_MDAY] + (local[LT_HOUR] > 23 ? 1 : 0)),
    sym_dee[(local[LT_HOUR] % 24) / 2],
    chinese_number(local[LT_HOUR]),
    chinese_number(local[LT_HOUR] % 2 * 2 + local[LT_MIN] / 30 + 1));
}

string xyj_date(int time)  // 获取日期
{
  int y, m, d, xtime = time - XYJ_O_YEAR_TIME;
  string date_str;

  while (xtime < 0) {  // 计算欢乐纪元前的年份
    xtime += 518400;
    y--;
  }

  if (y >= 0) y = xtime / 518400;
  m = xtime / 43200 % 12;  // 月份
  m++;
  d = xtime / 1440 % 30;  // 日期
  d++;
  if (y < 0) {
    y = -y;
    date_str = "欢乐纪元前" + chinese_number(y) + "年";
  } else if (y == 0)
    date_str = "欢乐纪元元年";
  else date_str = "欢乐纪元" + chinese_number(y) + "年";
  date_str += chinese_number(m) + "月";
  date_str += chinese_number(d) + "日";

  return date_str;
}

string xyj_time(int time)  // 获取时间
{
  int xtime = time - XYJ_O_YEAR_TIME;
  int h, q;
  string time_str;

  while (xtime < 0) xtime += 518400;

  h = xtime / 60 % 24;
  q = xtime / 30 % 4;

  time_str = xyj_date(time) + sprintf("%s时", sym_dee[h / 2]);
  time_str += q ? (chinese_number(q) + "刻") : "";
  return time_str;
}

string xyj_time2(int time) {
  int xtime = time - XYJ_O_YEAR_TIME;
  int h, q;
  string time_str;

  while (xtime < 0) xtime += 518400;

  h = xtime / 60 % 24;
  q = xtime / 30 % 4;

  time_str = xyj_date(time) + sprintf("%s(%s)时", sym_dee[h / 2], chinese_number(h));
  time_str += q ? (chinese_number(q) + "刻") : "";
  return time_str;
}

string xyj_season(int time) {
  return query_timec(time, "season");
}

int query_timen(int time, string mode)  // 获取时间的各个参数（数字形式）
{
  int xtime = time() - XYJ_O_YEAR_TIME;
  int year, season, month, day, week, hour, quarter, minute;

  while (xtime < 0) {
    xtime += 518400;
    year--;
  }

  switch (mode) {
    case "year":
      if (year >= 0) year = xtime / 518400;
      return year;
      break;
    case "season":
      season = (xtime / 43200 - 2) % 12 / 4;
      // 这里把除得的月份减 2 ，形成 2、3、4 月是春季，5、6、7 月是夏季……
      season++;
      return season;
      break;
    case "month":
      month = xtime / 43200 % 12;
      month++;
      return month;
      break;
    case "day":
      day = xtime / 1440 % 30;
      day++;
      return day;
      break;
    case "week":
      week = xtime / 1440 % 7;  // 欢乐纪元前的星期计算可能不大正确
      return week;
      break;
    case "hour":
      hour = xtime / 60 % 24;
      return hour;
      break;
    case "minute":
      minute = xtime % 60;
      return minute;
      break;
    case "quarter":
      quarter = xtime / 30 % 4;
      return quarter;
    default:
  }
  return 0;
}

string query_timec(int time, string mode)  // 获取时间的各个参数（中文形式）
{
  int xtime = time() - XYJ_O_YEAR_TIME;
  int year, season, month, day, week, hour, quarter, minute;

  while (xtime < 0) {
    xtime += 518400;
    year--;
  }
  switch (mode) {
    case "year":
      if (year >= 0) year = xtime / 518400;
      return chinese_number(year) + "年";
      break;
    case "season":
      season = (xtime / 43200 - 2) % 12 / 4;
      season++;
      return c_season[season - 1];
      break;
    case "month":
      month = xtime / 43200 % 12;
      month++;
      return chinese_number(month) + "月";
      break;
    case "day":
      day = xtime / 1440 % 30;
      day++;
      return chinese_number(day) + "日";
      break;
    case "week":
      week = xtime / 1440 % 7;
      return "星期" + c_week[week];
      break;
    case "hour":
      hour = xtime / 60 % 24;
      return chinese_number(hour) + "时";
      break;
    case "minute":
      minute = xtime % 60;
      return chinese_number(minute) + "分";
      break;
    case "quarter":
      quarter = xtime / 30 % 4;
      return chinese_number(quarter) + "刻";
    default:
  }
  return 0;
}

mixed query_bj_time(int now, string mode)  // 获取北京时间的各个参数
{
  mixed *lt;

  lt = localtime(now);

  switch (mode) {
    case "year":
      return lt[LT_YEAR];
      break;
    case "month":
      return lt[LT_MON];
      break;
    case "day":
      return lt[LT_MDAY];
      break;
    case "week":
      return lt[LT_WDAY];
      break;
    case "hour":
      return lt[LT_HOUR];
      break;
    case "minute":
      return lt[LT_MIN];
      break;
    case "second":
      return lt[LT_SEC];
    default:
  }
  return 0;
}

void heart_beat() {
  if ((query_timen(time(), "hour") + 24 - current_hour) % 24 > 0) {
    current_hour = query_timen(time(), "hour");
    call_out("hour_event", 0, current_hour);
  }

  if ((query_bj_time(time(), "hour") + 24 - current_bj_hour) % 24 > 0) {
    current_bj_hour = query_bj_time(time(), "hour");
    call_out("bj_hour_event", 0, current_bj_hour);
  }
}

void time_recycle()  // 确保计时精灵的心跳能一直继续下去
{
  set_heart_beat(1);
  call_out("time_recycle", 60);
}

void bj_hour_event(int current_hour)  // 北京时间钟点事件
{
  if (current_hour == 8)
    shout("【校园广播】现在是北京时间早上 8 点整。\n");
  if (current_hour == 10)
    shout("【校园广播】现在是北京时间上午 10 点整。\n");
  if (current_hour == 12)
    if (random(2))
      shout("【校园广播】现在是北京时间中午 12 点整，该吃午饭啰！\n");
    else
      shout("【校园广播】现在是北京时间中午 12 点整。\n");
  if (current_hour == 14)
    shout("【校园广播】现在是北京时间下午 14 点整。\n");
  if (current_hour == 18)
    if (random(2))
      shout("【校园广播】现在是北京时间傍晚 18 点整，该吃晚饭啰！\n");
    else
      shout("【校园广播】现在是北京时间傍晚 18 点整。\n");
  if (current_hour == 22)
    if (random(2))
      shout("【校园广播】现在是北京时间晚上 22 点整，该回去睡觉啰！\n");
    else
      shout("【校园广播】现在是北京时间晚上 22 点整。\n");
  if (current_hour == 23)
    shout("【校园广播】现在是北京时间晚上 23 点整。\n");
}

void hour_event(int current_hour)  // 钟点事件
{
  if (current_hour == 3 || current_hour == 7 || current_hour == 9 ||
    current_hour == 12 || current_hour == 15 || current_hour == 18 ||
    current_hour == 21 || current_hour == 23)
    NATURE_D->update_day_phase();
  if (current_hour == 0) {
    call_out("day_event", 0);
    NATURE_D->init_day_phase();
  }
}

void day_event()  // 每日事件
{
  int day;

  day = query_timen(time(), "day");
  if (day == 14 && query_timen(time(), "month") == 2)
    message("outdoor:vision", HIG "【计时精灵】情人节到了，愿天下有情人终成眷属！\n" NOR, users());
  if (day == 1) call_out("month_event", 0);
  call_out("festival", 0);
}

void week_event()  // 每周事件
{
  int week_day;

  week_day = query_timen(time(), "week");
  if (week_day == 1) { return; }
}

void weekend_event()  // 周末事件
{}

void month_event()  // 每月事件
{
  int month;

  month = query_timen(time(), "month");
  if (month == 4)
    message("outdoor:vision", HIB "【计时精灵】今天是愚人节，大伙要小心啦！\n" NOR, users());
  if (month == 1) call_out("year_event", 0);
  //   message("outdoor:vision", "month_event\n", users());
}

void year_event()  // 年度事件
{
  message("outdoor:vision", HIW "【计时精灵】新年到，大家新年好，恭喜发财！\n" NOR, users());
}

void festival()  // 节日、节气
{
  int month, day, week_day;

  week_day = query_timen(time(), "week");
  month = query_timen(time(), "month");
  day = query_timen(time(), "day");
  if (week_day == 5 || week_day == 6) weekend_event();

  if (month == 1 && (day == 6 || day == 21) ||
    month == 2 && (day == 4 || day == 19) ||
    month == 3 && (day == 5 || day == 20) ||
    month == 4 && (day == 4 || day == 20) ||
    month == 5 && (day == 5 || day == 21) ||
    month == 6 && (day == 5 || day == 21) ||
    month == 7 && (day == 7 || day == 22) ||
    month == 8 && (day == 7 || day == 23) ||
    month == 9 && (day == 7 || day == 23) ||
    month == 10 && (day == 8 || day == 23) ||
    month == 11 && (day == 7 || day == 22) ||
    month == 12 && (day == 7 || day == 21))
    NATURE_D->update_jie_qi();
}
