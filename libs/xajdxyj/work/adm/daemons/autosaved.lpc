#include <ansi.h>
#pragma save_binary

inherit F_DBASE;

void auto_save();
void do_save(object *, int, int);
void clear_net_dead();

void create()
{
    seteuid(ROOT_UID);
    set("channel_id", "存盘精灵");
    CHANNEL_D->do_channel( this_object(), "sys", "自动存盘系统已经启动。\n");
    call_out("auto_save", 60);
}

void auto_save()
{
    object *user;

    user = users();
    do_save(user, sizeof(user), 0);
    remove_call_out("auto_save");
    call_out("auto_save", 300 + random(300));
    clear_net_dead();
}

void do_save(object *user, int size, int i)
{
	object link_ob;
	string id, src, src_l, dst, dst_l;

    seteuid(getuid());

	if( i >= size ) return;
	call_out("do_save", 2, user, size, i + 1);

	if( !user[i] ) return;
	if( time() - (int)user[i]->query("auto_save/last_save") < 300 ) return;
	if( (int)user[i]->query("mud_age") < 1800 ) return;
	id = (string)user[i]->query("id");
	if( !id ) return;
	if( !environment(user[i]) ) return;
	if( !objectp(link_ob = user[i]->query_temp("link_ob")) ) return;
	if( (string)link_ob->query("id") != id ) return;
	
//	src = (string)user[i]->query_save_file();
//	src_l = (string)link_ob->query_save_file();
//	dst = src + ".a.o";  // 与玩家自己的备份文件(.oo.o)区分开
//	dst_l = src_l + ".a.o";
//	if( user[j]->save() )
//		tell_object(user[i], "自动存储完毕。\n");
	if( (int)link_ob->save() && (int)user[i]->save() ) {
	//	if( cp(src + ".o", dst) && cp(src_l + ".o", dst_l) )
			user[i]->set("auto_save/last_save", time());
		tell_object(user[i], HIR"【存盘精灵】自动存盘完毕。\n"NOR);
	} else {
//		message("channel:chat", HIG"【备份】您的档案备份失败，请与巫师联系。\n"NOR, user[i]);
	    CHANNEL_D->do_channel( this_object(), "sys", "自动备份" + user[i]->query("id") + "的档案失败。\n");
		log_file("nosave/auto_save", sprintf("%s %s(%s) fail to auto save\n",
			ctime(time()), user[i]->query("name"), id) );
	}
}

void clear_net_dead()
{
	object *list;

	list = children(USER_OB);
	for( int i = sizeof(list) - 1; i > 0; i -- ) {
		if( interactive(list[i]) ) continue;
		if( list[i]->query_temp("link_ob") ) continue;
		if( environment(list[i]) ) continue;
		destruct(list[i]);
	}
}

