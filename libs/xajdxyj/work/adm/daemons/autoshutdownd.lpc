// autoshutdownd.c
// file:        Auto Shutdown Daemon
// creator:     FoF
// date:        2000-5-2
// 运行机制：定期（间隔30秒）检查，如果存在 /log/do_shut_down 这一文件，
// 就执行关闭程序，保存所有在线玩家的数据，把 /log/do_shut_down 改名为
// /log/not_shut_down ，关闭服务器。

#include <net/daemons.h>
inherit F_DBASE;

void auto_shut();
int do_shut();

void create() {
  seteuid(ROOT_UID);
  set("channel_id", "关闭精灵");
  set("id", "shut down daemon");
  set("name", "自动关闭精灵");
  CHANNEL_D->do_channel(this_object(), "sys", "自动关闭精灵已经启动。\n");
  call_out("auto_shut", 60);
}

void auto_shut() {
  string file1 = "/log/do_shut_down", file2 = "/log/not_shut_down";

  if (file_size(file1) > 1 && file_size(file2) < 1) {
    if (rename(file1, file2) == 0) {
      CHANNEL_D->do_channel(this_object(), "chat", MUD_NAME + "将立即重新启动。\n");
      call_out("do_shut", 5);
      return;
    }
  }
  remove_call_out("auto_shut");
  call_out("auto_shut", 30);
}

int do_shut() {
  object link_ob, *user;

  user = users();
  for (int i = 0; i < sizeof(user); i++) {
    if (!environment(user[i])) continue;
    user[i]->save();
    link_ob = user[i]->query_temp("link_ob");
    if (objectp(link_ob)) link_ob->save();
  }
  if (find_object(DNS_MASTER)) DNS_MASTER->send_shutdown();

  shutdown(0);
  return 1;
}
