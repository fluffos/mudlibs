// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */
 
// aliasd.c

mapping global_alias = ([
   "l":    "look",
   "n":    "go north",
   "e":    "go east",
   "w":    "go west",
   "s":    "go south",
   "nu":   "go northup",
   "eu":   "go eastup",
   "wu":   "go westup",
   "su":   "go southup",
   "nd":   "go northdown",
   "ed":   "go eastdown",
   "wd":   "go westdown",
   "sd":   "go southdown",
   "ne":   "go northeast",
   "se":   "go southeast",
   "nw":   "go northwest",
   "sw":   "go southwest",
   "u":    "go up",
   "d":    "go down",
   "i":    "inventory",
   "tt":   "team talk",
     "tt*":  "team talk*",
   "ct":     "coupletalk",
   "bai":    "apprentice",
   "dazuo":  "exercise",
   "du":     "study",
   "mingsi": "meditate",
   "tuo":    "remove",
   "c":     "chat",
   "cc":    "chat*",
   "x":     "xyj",
   "xx":    "xyj*",
   "sc":    "score",
   "ga":    "get all",
   "cun":   "deposit",
   "qu":    "withdraw",
   "r":     "reply",
]);

string process_global_alias(string arg)
{
   string *word;

   if (arg[0]=='\'') return "say " + arg[1..strlen(arg)-1];

   word = explode(arg, " ");
   if( sizeof(word) && !undefinedp(global_alias[word[0]]) ) {
     word[0] = global_alias[word[0]];
     return implode(word, " ");
   }

   return arg;
}
