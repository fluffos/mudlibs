#include <ansi.h>
#include <net/dns.h>
#include <net/macros.h>
inherit F_DBASE;

mapping channels = ([
  "sys": ([ "msg_speak": HIR "【系统】%s：%s\n" NOR, "wiz_only": 1 ]),
  "wiz": ([ "msg_speak": HIW "【巫师】%s：%s\n" NOR,
    "msg_emote": HIW "【巫师】%s\n" NOR,
    "wiz_only": 1,
  ]),
  /* xkx100's wiz & es channel
        "wiz":  ([      "msg_speak": HIY "【巫师】%s：%s\n" NOR,
                        "msg_emote": HIY "【巫师】%s" NOR,
                        "wiz_only": 1,
                        "intermud": GCHANNEL,
                        "intermud_emote": 1,
                        "channel": "wiz",
                        "omit_address": 0,
                        "filter":1,
                        "filter": (: $1["MUDLIB"]=="The story of Life" :)
                ]),
        "es":   ([  "msg_speak": HIR+BOLD+"【网际】"+NOR+BOLD+"%s：%s\n" NOR,
				        "msg_emote": HIR+BOLD+"【网际】"+NOR+BOLD+"%s" NOR,
        				"msg_color": NOR+BOLD,
       					"intermud": GCHANNEL,
        				"intermud_emote": 1,
         				"channel": "es",
            			"filter": 1,
            			"omit_address": 0, 
        		]),
*/
  "gwiz": ([ "msg_speak": HIW "【网际巫师】%s：%s\n" NOR,
    "msg_emote": HIW "【网际巫师】%s\n" NOR,
    "wiz_only": 1, "intermud": GWIZ, "channel": "CREATOR",
    "filter": 1,
    "intermud_emote": 1,
  ]),
  // FoF added 99-11-6 11:29  for display debug message 
  "debug": ([ "msg_speak": HIW "【调试】%s：%s\n" NOR,
    "msg_emote": HIW "【调试】%s\n" NOR,
    "wiz_only": 1,
  ]),
  "snp": ([ "msg_speak": HIB "【窃听】%s：%s\n" NOR,
    "msg_emote": HIB "【窃听】%s\n" NOR,
    "wiz_only": 1,
  ]),
  "xyj": ([ "msg_speak": HIG "【西游记】%s：%s\n" NOR,
