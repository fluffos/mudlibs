  ]),
  //keep the channel name as "es" to be compatible with other ES2 type muds.
  "es": ([ "msg_speak": WHT "【网际闲聊】%s：%s\n" NOR,
    "msg_emote": WHT "【网际闲聊】%s\n" NOR,
    "intermud": GCHANNEL, "channel": "es",
    "filter": 1,
