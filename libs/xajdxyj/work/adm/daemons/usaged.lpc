#include <login.h>
#include <ansi.h>

inherit F_DBASE;
inherit F_SAVE;

string file_name = "file_name";
int last_save;
mapping id = ([ ]);

string query_save_file();
int save();
private int do_save();

void create()
{
    string err;
    
    seteuid(ROOT_UID);
    restore();
}

// 存档文件名的格式：4 位数的年份加上三个字符的月份简称，例如：2000May
string query_save_file()
{
    string ret, now = ctime(time());
    
    ret = DATA_DIR "usage/" + now[20..23] + now[4..6] + now[8..8];
    if( ret[<1..<1] == "3" ) ret[<1..<1] = "2";
    if( ret[<1..<1] == " " ) ret[<1..<1] = "0";
    return ret;
}

// 传回 id 的使用情况
// 按月份查询功能待加
mapping query_usage(string user_id)
{
    if( undefinedp(id[user_id]) )
        return ([ "0" : "无此使用者！" ]);
    
    return id[user_id];
}

int log_id(string user_id, string ip_number, string mode)
{
    int a, b, c, d;
    string tmp_id;
    
    if( !stringp(ip_number) ) return 0;
    
    if( sscanf(ip_number, "%d.%d.%d.%d", a, b, c, d) != 4 ) return 0;
    
    if( mode != "login" && mode != "create" && mode != "logout" && mode != "replace" )
        return 0;
    
    if( !user_id ) return 0;
    
    if( query_save_file() != file_name ) { // 不同的月份存为不同的文件
        save();
        file_name = query_save_file();
        id = ([ ]);
    }
    
    if( undefinedp(id[user_id]) ) {
        id += ([ user_id : ([ time() : ip_number + " " + mode ]) ]);
        id[user_id] += ([ mode : time() ]);
    } else {
/*
        // 登录、退出登录的时间间隔在 1 分钟内的视同连续游戏
        if( mode == "login" ) {
            if( !undefinedp(id[user_id]["logout"]) ) {
                if( time() - id[user_id]["logout"] < 60 )
                    return 0;
            } else
                id[user_id] += ([ "login" : time() ]);
        } else if( mode == "replace" ) {
            if( !undefinedp(id[user_id]["replace"]) ) {
                if( time() - id[user_id]["replace"] < 60 )
                    return 0;
            }
        } else if( mode == "logout" ) {
            if( !undefinedp(id[user_id]["logout"]) ) {
            	a = id[user_id]["logout"];
                if( time() - a < 60 ) {
                    if( sscanf(id[user_id][a], "%s logout", tmp_id) == 1 )
                    id[user_id] += ([ mode : 999 ]);
                        //map_delete(id, id[user_id][id[user_id]["logout"]]);
                }
            }
        }
*/
        id[user_id] += ([ mode : time() ]);
        id[user_id] += ([ time() : ip_number + " " + mode ]);
    }
    
    return save();
}

int save() // 避免频繁地写文件，使用 call_out
{
    if( time() - last_save > 30 ) {
        remove_call_out("do_save");
        last_save = time();
        return do_save();
    }
    remove_call_out("do_save");
    call_out("do_save", 30);
    return 1;
}

private int do_save()
{
    return ::save();
}

