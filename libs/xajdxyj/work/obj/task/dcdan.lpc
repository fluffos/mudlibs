//DHNY2000

inherit ITEM;
#include <ansi.h>
void create() {
  set_name(HIM "五" + NOR "毒断肠丹", ({ "dcdan", "dan" }));
  set_weight(100);
  set("is_task", "乌鸦先生");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "乌鸦先生的五毒断肠丹。\n");
  }
  set("is_monitored", 1);
}
