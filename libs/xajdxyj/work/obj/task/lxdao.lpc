//Ansi 99.8
#include <weapon.h>
#include <ansi.h>
inherit THROWING;

void create()
{
   set_name(HIY"秘刀流星"NOR, ({"lxdao", "throwing"}));
   set("is_task","田鼠精");
   if (clonep())
     set_default_object(__FILE__);
   else {
     set("long", "这是田鼠精的秘刀流星，是飞刀中的极品。\n");
     set("value", 0);
     set("material", "steel");
     set("base_weight", 400);
     set("base_value", 0);
     set("base_unit", "柄");
   }
   set("is_monitored",1);
   set_amount(1);
   init_throwing(20);
   setup();
}
