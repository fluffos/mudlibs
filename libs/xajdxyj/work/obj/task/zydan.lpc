//DHNY2000

inherit ITEM;
#include <ansi.h>
void create() {
  set_name(HIW "驻颜丹" NOR, ({ "zydan", "dan" }));
  set_weight(100);
  set("is_task", "痴梦仙姑");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "痴梦仙姑的驻颜丹，据说吃了可以驻颜。\n");
  }
  set("is_monitored", 1);
}
