#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIB "黑" + HIW "白" + NOR "帐本", ({ "hbbook" }));
  set_weight(200);
  set("long", "这是铁算盘的帐本。\n");
  set("is_task", "铁算盘");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("material", "paper");
    set("value", 0);
    set("no_sell", 1);
  }
  setup();
  set("is_monitored", 1);
}
