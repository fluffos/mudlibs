// dhny2000

inherit ITEM;
#include <ansi.h>

void create()
{
 set_name(HIB"〖拳脚秘传〗"NOR, ({"ksd"}));
        set_weight(600);
set("is_task","急如火");
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "本");
     set("value", 0);
set("long", "急如火的拳脚功夫的秘传。\n");
        set("material", "paper");
        set("skill", ([
"name": "unarmed",
                        "sen_cost": 20,
                        "difficulty": 20,
                        "max_skill": 20,
]) );
        }
	set("is_monitored",1);
}
