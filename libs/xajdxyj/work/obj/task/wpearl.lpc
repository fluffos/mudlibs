//DHNY2000
 
inherit ITEM;
#include <ansi.h>
void create()
{
        set_name(HIC"水灵珠"NOR, ({ "wpearl", "pearl"}) );
        set_weight(100);
        set("is_task","蒲牢");
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "颗");
                set("long","蒲牢的水灵珠。\n");
        }
        set("is_monitored",1);
}

