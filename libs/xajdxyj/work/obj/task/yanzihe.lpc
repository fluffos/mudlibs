//dhny2000
#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIM "胭脂水粉盒" NOR, ({ "yanzihe", "box" }));
  set_weight(500);
  set("is_task", "小公主");
  set_max_encumbrance(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "这是小公主的胭脂水粉盒。\n");
    set("value", 0);
  }
  set("is_monitored", 1);
  setup();
}

int is_container() { return 1; }
