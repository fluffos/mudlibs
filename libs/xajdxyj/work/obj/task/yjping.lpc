// dhny2000

inherit ITEM;
inherit F_LIQUID;
#include <ansi.h>
void create() {
  set_name(HIG "甘露玉净瓶" NOR, ({ "yjping" }));
  set_weight(500);
  set("is_task", "观音菩萨");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "观音菩萨的甘露玉净瓶。\n");
    set("unit", "个");
    set("value", 0);
    set("max_liquid", 500);
  }

  // The liquid contained in the container is independent, we set a copy
  // in each cloned copy.
  set("liquid", ([
    "type": "water",
    "name": "甘露",
    "remaining": 500,
    "drunk_apply": 5,
  ]));
  set("is_monitored", 1);
}
