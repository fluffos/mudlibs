//DHNY2000
 
#include <ansi.h>
#include <armor.h>
inherit CLOTH;

void create()
{
 set_name(HIW "佛教僧袍" NOR, ({"zmpao","pao"}));
        set_weight(2000);
 set("is_task","惠岸行者");
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
 set("long","佛家僧袍，代表佛家的最高荣誉,传说是南海观音首徒惠岸行者所有\n");
                set("value", 0);
                set("material", "cloth");
                set("armor_prop/armor", 30);
                set("armor_prop/armor_vs_spells",100);
             }
             set("is_monitored",1);
   setup();
}

