// dhny2000

inherit ITEM;
inherit F_LIQUID;
#include <ansi.h>
void create()
{
	set_name(HIM"波丝葡萄酒"NOR, ({ "ptwine"}) );
	set_weight(500);
	set("is_task","张果老");
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "醉道士的波丝葡萄酒，。\n");
		set("unit", "个");
		set("value", 0);
		set("max_liquid", 100);
	}
        set("liquid", ([
                "type": "alcohol",
                "name": "葡萄酒",
                "remaining": 100,
                "drunk_apply": 10,
        ]) );
        set("is_monitored",1);
}
