//dhny 2000
#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create() {
  set_name(HIG "秘剑无心" NOR, ({ "wxsword", "jian", "sword" }));
  set_weight(3000);
  set("is_task", "镇元大仙");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "这是镇元大仙的秘剑无心，蕴藏着秘密力量。\n");
    set("value", 0);
    set("material", "steel");
    set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n插回剑鞘。\n");
  }
  set("is_monitored", 1);
  init_sword(30);
  setup();
}
