// /obj/board/pop_bbs.c

#include "ansi.h"

inherit BBS_BOARD;

void create() {
  set_name(HIG "欢乐园" HIY "流行" HIC "话题" HIM "讨论板" NOR, ({ "bbs board", "bbs" }));
  set("location", "/d/wiz/entrance");
  set("board_id", "pop_bbs");
  set("long", "这是一个供大家讨论热门话题的新闻板。\n");
  setup();
  set("capacity", 300);
}
