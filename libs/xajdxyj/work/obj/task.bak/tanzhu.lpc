//DHNY2000

#include <ansi.h>
inherit ITEM;
inherit F_UNIQUE;

void create() {
  set_name(RED "弹珠" NOR, ({ "tanzhu" }));
  set_weight(100);
  set("is_task", "龙少爷");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "粒");
    set("long", "龙少爷常玩的弹珠。\n");
  }
  set("is_monitored", 1);
}
