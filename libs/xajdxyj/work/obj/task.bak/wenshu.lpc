//DHNY2000
 
inherit ITEM;
inherit F_UNIQUE;
#include <ansi.h>
void create()
{
        set_name(YEL"文书"NOR, ({ "wenshu", "shu"}) );
        set_weight(100);
   set("is_task","阴长生");
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "封");
                set("long","阴长生的文书\n");
        }
        set("is_monitored",1);
}
