// 限制输入指令，用于新手上路，身份未经验证前
// 限制垃圾帐号
// by FoF@Happy 00-5-16

inherit ITEM;

void create()
{
   set_name("指令限制器", ({ "blocker" }));
   set("env/invisibility", 1);
   set_weight(1);
   set("no_get", 1);
   set("no_give", 1);
   set("no_sell", 1);
   set("no_drop", 1);
   setup();
}

void init()
{
   object who = this_player();
   
   if (who->query("proved")) return;
   if (who->query("combat_exp") > 2000) return;
   if (wizardp(who) ) return;
   
   add_action("block_cmd", "", 1);
}

int block_cmd(string arg)
{
   string verb;
   
   if (this_player()->query("proved")) return 0;
   
   verb = query_verb();
   if (verb == "quit") return 0;
   if (verb == "look") return 0;
   if (verb == "go") return 0;
   if (verb == "inventory") return 0;
   if (verb == "say") return 0;
   if (verb == "who") return 0;
   if (verb == "help") return 0;
   if (verb == "finger") return 0;
   if (verb == "managers") return 0;
   if (verb == "news") return 0;
   if (verb == "map") return 0;
   if (verb == "hp") return 0;
   if (verb == "score") return 0;
   
   remove_call_out("prompt");
   call_out("prompt", 5 + random(5));

   return 1;
}

int prompt(object who)
{
   object prover;
   
   if( !who ) return 0;
   
   tell_object(who, "你的身份还没有通过验证，不能正常参加游戏。\n");
   
   prover = find_player(who->query("prover"));
   if( !random(3) && prover && !prover->query_temp("no_prove") )
      tell_object(prover, "请用 prove 命令为新玩家" + who->short() + "作证。\n");
   
   return 1;
}

