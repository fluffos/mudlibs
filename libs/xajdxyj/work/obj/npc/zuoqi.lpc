void update_age()
{
   if( !query_temp("last_age_set") )
   set_temp("last_age_set", time());
   add("mud_age", time() - (int)query_temp("last_age_set"));
   set_temp("last_age_set", time());
   set("age", 1 + (int)query("mud_age") / 86400);
}

void die()
{
    int exp;
    if( !environment() ) return;
    set("death_time", time());
    exp = query("combat_exp");
    set("combat_exp", exp * 98 / 100);
    set("last_die", time());
    save();
    ::die();
}

int accept_object(object who, object ob)
{
   if( query("owner_id") == who->query("id") )
      return 1;
   message_vision(query("name")+"向$N摇了摇头!\n",who);
   return 0;
}

void move_to(object who)
{
   object rider;
   object me = this_object();
   if( me->is_fighting() )  {
      tell_object(who, name() + "正在战斗，无法脱身！\n");
      return;
   }
   if( me->is_busy() || me->query_temp("pending/exercising")) {
      tell_object(who, name() + "正忙着呢！\n");
      return;
   }
   if( me->query_temp("no_move") )  {
      tell_object(who, name() + "被定住了。\n");
      return;
   }
   if( !living(me) )  {
      tell_object(who, name() + "正处于昏迷状态。\n");
      return;
   }
//   if( environment() != environment(who) )
//      message_vision("$N听到$n呼唤，腾空而去。\n", me, who);
   if( rider = query_temp("rider") )
      rider->add_temp("apply/dodge", query("ride/dodge"));
   remove_ride();
   move(environment(who));
   //can add "come_msg"
   message_vision("$N从天而降，来到$n的面前。\n", this_object(), who);
   set_leader(who);
   return;
}
