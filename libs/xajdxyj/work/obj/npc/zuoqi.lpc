#include <ansi.h>

inherit F_SAVE;
inherit F_BACKUP;
inherit NPC;
//inherit NPC_SAVE;

void update_age();

void set_name_id();
void create()
{
   set("race", "野兽");
   set_name("玩家坐骑物件", ({ "ridee", "zuoqi" }));
   set("verbs", ({ "bite","claw","hoof" }));
   set("ride/msg", "骑");
   set("unit","匹");
   setup();
}

void initialize()
{
   int dodge, attack;

   restore();

   update_age();
   set_name_id();
   set("actions", (: call_other, "/adm/daemons/race/beast.lpc", "query_action" :));
   dodge = query_skill("dodge");
   attack = query_skill("unarmed");
   if( dodge > 50 ) dodge = dodge * 2 / 3;
   set("ride/dodge", 5 + dodge / 2);
   set_temp("apply/attack", attack);
   set_temp("apply/armor", dodge / 2);
   set("eff_kee", query("max_kee"));
   set("eff_sen", query("max_sen"));
   set("kee", query("max_kee"));
   set("sen", query("max_sen"));
   set("mana", query("max_mana"));
   set("force", query("max_force"));
}

int is_zuoqi() { return 1; }

void set_name_id()
{
   set_name(query("name"), ({ query("id"), "zuoqi", "ridee" }));
}

void reset()
{
   if( !environment() )
      destruct(this_object());
}

string query_save_file()
{
   string id, series;

   id = query("owner_id");
   if( !id ) return 0;
   return sprintf(DATA_DIR "toy/%c/%s_zuoqi", id[0], id);
}

int save()
{
   if( this_object()->is_busy() || time() - query("last_save") < 10 ) {
      write("坐骑正忙着，过一会儿才能储存。\n");
      return 0;
   }

   set("last_save", time());
   return ::save();
}

void leave()
{
   if( this_object()->is_busy() )  {
      write("坐骑正忙着，不能离开！\n");
      return 0;
   }

   if( ! save() ) return 0;
   // can add "leave_msg"
   message_vision("$N一溜烟没影了。\n", this_object());
   destruct(this_object());
}

int do_order(string arg)
{
   object who = this_player();
   string str;

   if( who->query("id") != query("owner_id") )  return 0;
   if( !arg ) return 0;
   if( !living(this_object()) )
      return notify_fail("还是先把" + query("name") + "弄醒再说吧！\n");

   message_vision("$N在$n耳边悄悄说了几句话。\n", who, this_object());
   if( sscanf(arg, "chat%s", str) == 1   ||
      sscanf(arg, "xyj%s", str) == 1    ||
      sscanf(arg, "tell%s", str) == 1   ||
      sscanf(arg, "es%s", str) == 1     ||
      sscanf(arg, "sldh%s", str) == 1   ||
      sscanf(arg, "wield%s", str) == 1  ||
      sscanf(arg, "mount%s", str) == 1  ||
      sscanf(arg, "apprentice%s", str) == 1 ||
      sscanf(arg, "chat%s", str) == 1 )
//       strsrch(arg, "apprentice ") != -1 ||
//       strsrch(arg, "recruit ") != -1    ||
//       strsrch(arg, "study ") !=-1       ||
//       strsrch(arg, "touch ") !=-1       ||
//       strsrch(arg, "es") != -1          ||
//       strsrch(arg, "sldh")!= -1         ||
//       strsrch(arg, "pop") !=-1          ||
//       strsrch(arg, "ask ") != -1        ||
//       strsrch(arg, "wield ") !=-1       ||
//       strsrch(arg, "mount ") != -1 )
   {
   	  tell_object(who, "但" + query("name") + "似乎听不懂你的话。\n");
      return 1;
   }

   if( arg == "save" ) {
      if( save() ) tell_object(who, "您的坐骑数据储存完毕。\n");
      return 1;
   }

   if( arg == "quit" ) {
      if( !living(this_object()) ) {
         tell_object(who, "您的坐骑正处于昏迷之中！\n");
         return 1;
      }
   	  
   	  who->remove_ride();
    this_object()->remove_ride();
      
      if( ! leave() ) {
         tell_object(who, "您的坐骑无法离开！\n");
         return 1;
      }
      
      tell_object(who, "您的坐骑离开了。\n");
      return 1;
   }

   remove_call_out("execute");
   call_out("execute", random(3), arg);

   return 1;
}

void execute(string arg)
{
   if( !command(arg) )
      write(query("name") + "无法执行你的命令！\n");
}

void init()
{
   object who = this_player();
   object owner;

   if( who->query("id") == query("owner_id") )
      add_action("do_order", "order");
   
   owner = find_player( query("owner_id") );

   if( !owner ) {
      remove_call_out ("leave");
      call_out ("leave", 1);
   }
}

varargs int move(mixed dest, int silently)
{
   object owner;
   int flag = 0;

   flag = ::_move(dest, silently);
   if( flag && owner = query_temp("rider") )
      if( environment(owner) != environment() ) remove_ride();
   else call_out("dest_obj", 2, this_object());
   return flag;
}

