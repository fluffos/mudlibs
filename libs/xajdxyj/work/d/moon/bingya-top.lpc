//bingya-top.c

inherit ROOM;

void create() {
  set("short", "冰崖顶");
  set("long", @LONG

这里是冰崖的顶端，向下只能看到一段刀削斧劈似的冰崖。脚下雪雾
缭绕，阳光照耀，美不胜收。

LONG);

  set("exits",
    ([  //sizeof() == 4
    ]));

  set("objects",
    ([  //sizeof() == 1
    "/d/xueshan/obj/xuelian": 1,
    ]));

  set("outdoors", "moon");

  setup();
}

void init() {
  add_action("do_climb", "climb");
  add_action("do_climb", "pa");
}

int do_climb(string arg) {
  object me;

  me = this_player();

  if (!arg || arg != "down") {
    return notify_fail("你要爬到哪里去？\n");
  }
  message_vision("$N手足并用，攀住冰崖向下爬了过去。\n", me);
  me->move(__DIR__ "bingya-up6");
  message_vision("$N气喘呼呼地从上面爬了过来。\n", me);
  return 1;
}
