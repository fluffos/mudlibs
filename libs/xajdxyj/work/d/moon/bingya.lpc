inherit ROOM;

void create() {
  set("short", "冰崖底");
  set("long", @LONG

好险的一道冰崖！陡峭的崖壁几乎与地面垂直。崖壁上有一些凹槽，
好像有人经常在这里爬上爬下。四周冰缝中长着一些洁白的雪莲。

LONG);

  //set("item_desc", ([" *** " : " *** ", ]));
  //for look something.

  set("exits",
    ([  //sizeof() == 4
    //"up" : __DIR__"***",
    "down": __DIR__ "bingdao",
    ]));

  set("objects",
    ([  //sizeof() == 1
    __DIR__ "obj/xuelian": 1,
    ]));

  set("outdoors", "moon");

  setup();
}

void init() {
  add_action("do_climb", "climb");
  add_action("do_climb", "pa");
}

int do_climb(string arg) {
  object me;

  me = this_player();

  if (!arg || arg != "up") {
    return notify_fail("你要爬到哪里去？\n");
  }
  message_vision("$N手足并用，攀住冰崖向上爬了过去。\n", me);
  me->move(__DIR__ "bingya-up1");
  message_vision("$N气喘呼呼地从下面爬了过来。\n", me);
  return 1;
}
