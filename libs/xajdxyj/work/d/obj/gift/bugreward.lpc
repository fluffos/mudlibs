// 百年人参

#include <ansi.h>

inherit ITEM;

int do_eat(string);
void init();

void init() {
  add_action("do_eat", "eat");
  add_action("do_setid", "setid");
  add_action("do_setpot", "setpot");
}

void create() {
  set_name(HIW "奖励蛋糕" NOR, ({ "dan gao", "gao" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "欢乐园为了奖励提供bug者特意定做的超级大蛋糕。\n");
    set("value", 0);
    set("no_drop", 1);
    set("no_steal", 1);
    set("no_sell", 1);
    set("drug_type", "补品");
    set("pot", "1");
  }

  set("is_monitored", 1);
  setup();
}

int do_eat(string arg) {
  int i, j, k;
  string pots = this_object()->query("pot");
  object me = this_player();

  if (!id(arg)) return notify_fail("你要吃什么？\n");

  if (this_object()->query("owner") != me->query("id"))
    return notify_fail("这个东西不是你的! \n");
  me->set("food", (int)me->max_food_capacity());
  if (pots == "1") k = 5000;
  else if (pots == "2") k = 10000;
  else if (pots == "3") k = 15000;
  else if (pots == "4") k = 20000;
  else if (pots == "5") k = 30000;
  else return notify_fail("请让巫师为你设定奖励级数");
  i = k / 1000;
  j = k / 50;

  me->add("max_force", i);
  me->add("max_mana", i);
  me->add("potential", k);
  me->add("wwscore", j);
  tell_object(me, "你得到了" + chinese_number(k) + "点潜能和" + chinese_number(j) + "点江湖威望！\n
你的最大内力增加了" + chinese_number(i) + "点,最大法力增加了" + chinese_number(i) + "点！\n");

  message_vision(HIW "$N为欢乐园作出贡献，功德圆满，可喜可贺。\n" NOR, me);
  log_file(
    "bug_reward",
    sprintf("(%s)%s be rewarded %s 级奖励 for bug.\n", ctime(time()), me->query("id"), pots)
  );

  destruct(this_object());

  return 1;
}

int do_setid(string arg) {
  object me = this_player();
  if (!wizardp(me)) return 0;
  if (!arg) return notify_fail("你要给谁这个奖励蛋糕？\n");
  this_object()->set("owner", arg);
  tell_object(me, "你准备把奖励给" + arg + ".\n");
  return 1;
}
int do_setpot(string arg) {
  object me = this_player();
  object ob = this_object();
  if (!wizardp(me)) return 0;
  if (!arg) return notify_fail("你准备设定奖励为多少级(1-5)?\n");
  if (arg != "1" && arg != "2" && arg != "3" && arg != "4" && arg != "5") return notify_fail("奖励级数应在1到5级内.\n");

  ob->set("pot", arg);
  tell_object(me, "你设定奖励级数为" + arg + "级.\n");
  return 1;
}
