// 百年人参

#include <ansi.h>

inherit ITEM;

int do_eat(string);
void init();

void init() {
  add_action("do_drink", "drink");
  add_action("do_setid", "setid");
  add_action("do_setpot", "setpot");
}

void create() {
  set_name(HIW "可口可乐" NOR, ({ "cocacola", "cola" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "杯");
    set("long", "欢乐园为了奖励新手特意准备的可乐，味道好极了！\n");
    set("value", 0);
    set("no_drop", 1);
    set("no_steal", 1);
    set("no_sell", 1);
    set("no_give", 1);
    set("drug_type", "补品");
    set("pot", "1");
  }

  set("is_monitored", 1);
  setup();
}

int do_drink(string arg) {
  int i, j, k;
  string pots = this_object()->query("pot");
  object me = this_player();

  if (!id(arg)) return notify_fail("你要吃什么？\n");

  if (this_object()->query("owner") != me->query("id"))
    return notify_fail("这个东西不是你的! \n");
  me->set("water", (int)me->max_food_capacity());
  if (!me->query("newplayer_reward")) {
    k = 4000 + random(4000);
    j = k / 100;
    i = k / 150;

    me->add("max_force", i);
    me->add("max_mana", i);
    me->add("potential", k);
    me->add("wwscore", j);
    me->set("newplayer_reward", 1);
    tell_object(me, "你得到了" + chinese_number(k) + "点潜能和" + chinese_number(j) + "点江湖威望！\n
你的最大内力增加了" + chinese_number(i) + "点,最大法力增加了" + chinese_number(i) + "点！\n");
    log_file(
      "newplayer_reward",
      "(" + ctime(time()) + ")" + me->query("id") + " be rewarded" + k + ".\n"
    );
  }
  message_vision(HIW "$N一口气喝光杯中的可乐，感觉爽极了！\n" NOR, me);


  destruct(this_object());

  return 1;
}

int do_setid(string arg) {
  object me = this_player();
  if (!wizardp(me)) return 0;
  if (!arg) return notify_fail("你要给谁这个奖励蛋糕？\n");
  this_object()->set("owner", arg);
  tell_object(me, "你准备把奖励给" + arg + ".\n");
  return 1;
}
int do_setpot(string arg) {
  object me = this_player();
  object ob = this_object();
  if (!wizardp(me)) return 0;
  if (!arg) return notify_fail("你准备设定奖励为多少级(1-5)?\n");
  if (arg != "1" && arg != "2" && arg != "3" && arg != "4" && arg != "5") return notify_fail("奖励级数应在1到5级内.\n");

  ob->set("pot", arg);
  tell_object(me, "你设定奖励级数为" + arg + "级.\n");
  return 1;
}
