// dabudan.c

inherit ITEM;
#include <ansi.h>

string *strs = ({
  "回春丹",
  "美容丹",
});

string *eat_msg = ({
  "$N拿出一颗$n放到嘴里,身体剧烈疼痛起来,许久才恢复了平静。\n",
  "$N拿出一颗$n放到嘴里,顿时感觉到身体发生了奇特的变化。\n",
});

void create() {
  //   set_name(strs[random(sizeof(strs)]), ({"meirong yao","dan"}));
  set_name("各式美容药品", ({ "meirong yao", "dan" }));
  set_weight(5);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一包能美容的灵丹妙药。\n");
    set("unit", "颗");
    set("value", 2000000);
    set("food_remaining", 1);
    set("food_supply", 10);
  }
}

void init() {
  if (query("name") == "各式美容药品")
    set_name(strs[random(sizeof(strs))], ({ "meirong yao", "dan" }));
  add_action("do_eat", "eat");
}

int do_eat(string arg) {
  object me = this_object();
  object who = this_player();
  if (!arg || (arg != "dan" && arg != "meirong yao"))
    return 0;
  message_vision(HIY + eat_msg[random(sizeof(eat_msg))] + NOR, who, me);
  if (who->query("food") < who->max_food_capacity())
    who->add("food", 10);
  who->add("per", 1);
  destruct(me);
  return 1;
}
