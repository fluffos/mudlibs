// yaoguai.c

#include <ansi.h>

inherit NPC;

void create()
{
        set_name("安禄山乱兵", ({ "luan bing", "bing"  }));
	set("long", "安禄山乱兵长年跃马横枪，十分骁勇。\n");
	set("age", 18+random(10));
        set("gender", "男性");
        set("attitude", "peaceful");
        set("str", 40);
        set("sxy", 1);
        set("combat_exp",200000+random(2000000));
        set("daoxing",200000+random(2000000));
        set("max_kee", 2000);
        set("max_sen", 2000);
        set("max_force", 2000);
        set("force", 2000);
        set("force_factor", 200);
        set_skill("unarmed", 100+random(100));
        set_skill("dodge", 100+random(100));
        set_skill("parry", 100+random(100));
        set_skill("spear", 100+random(100));
        set_skill("force", 100+random(100));
	set_skill("xuanyuan-archery",100+random(100));
	set_skill("mace", 100+random(100));
	set_skill("archery", 100+random(100));
	set_skill("wusi-mace", 100+random(100));
	set_skill("yanxing-steps", 100+random(100));
	set_skill("bawang-qiang", 100+random(100));
	set_skill("lengquan-force", 100+random(100));
	set_skill("unarmed", 100+random(100));
	set_skill("changquan", 100+random(100));
	map_skill("mace", "wusi-mace");
	map_skill("force", "lengquan-force");
	map_skill("unarmed", "changquan");
	map_skill("spear", "bawang-qiang");
	map_skill("archery", "xuanyuan-archery");
	map_skill("parry", "bawang-qiang");
	map_skill("dodge", "yanxing-steps");
	create_family("将军府", 2, "蓝");
	set("chat_msg_combat", ({
                (: perform_action, "spear", "qiangjian" :),
  }) );
  setup();
        carry_object("/d/obj/weapon/spear/yinqiang")->wield();
 	carry_object("/d/obj/armor/tiejia")->wear();
	carry_object("/d/obj/weapon/mace/copperjian");

}

int heal_up()
{
	if( environment() && !is_fighting() ) {
		call_out("leave", 1);
		return 1;
	}
	return ::heal_up() + 1;
}

void leave()
{
	object owner;
	message("vision",
		 name() + "说道：鸣金收兵了，今天就先回去了吧！\n\n"
		+ name() + "把武器一拖，回头就跑不见了。\n" , environment(),
		this_object() );
	destruct(this_object());
}

