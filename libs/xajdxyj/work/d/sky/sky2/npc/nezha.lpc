#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void go_away();
void create() {
  set_name("哪吒", ({ "nezha santaizi", "nezha", "santaizi" }));
  set("title", HIR "三坛海会之神" NOR);
  create_family("陷空山无底洞", 2, "弟子");
  set("class", "xian");
  set("long", "一位唇红齿白的美少年。\n");
  set("gender", "男性");
  set("age", 16);
  set("attitude", "heroism");
  set("rank_info/respect", "小太子");
  set("rank_info/rude", "乳臭未干的小儿");
  set("per", 40);
  set("str", 30);
  set("cor", 40);
  set("int", 40);
  set("spi", 40);
  set("cps", 40);
  set("kar", 40);
  set("max_kee", 1800);
  set("max_gin", 1800);
  set("max_sen", 1800);
  set("force", 2600);
  set("max_force", 2600);
  set("force_factor", 100);
  set("max_mana", 2700);
  set("mana", 2700);
  set("mana_factor", 120);
  set("combat_exp", 1200000);
  set_skill("spells", 180);
  set_skill("unarmed", 170);
  set_skill("yaofa", 180);
  set_skill("yinfeng-zhua", 170);
  set_skill("dodge", 180);
  set_skill("lingfu-steps", 170);
  set_skill("parry", 190);
  set_skill("force", 180);
  set_skill("huntian-qigong", 170);
  set_skill("spear", 170);
  set_skill("huoyun-qiang", 150);
  set_skill("blade", 170);
  set_skill("sword", 160);
  map_skill("spells", "moyunshentong");
  map_skill("unarmed", "yinfeng-zhua");
  map_skill("spear", "huoyun-qiang");
  map_skill("parry", "huoyun-qiang");
  map_skill("dodge", "lingfu-steps");
  map_skill("force", "huntian-qigong");
  set("chat_chance_combat", 500);
  set("chat_msg_combat", ({
    (: cast_spell, "santouliubi" :),

  }));

  set("inquiry", ([
    "name": "我乃托塔天王三太子哪吒是也。",
    "here": "这里是托塔天王府。",
    "rumors": "玉帝敕封家严为降魔大元帅，在下为三坛海会之神，专管降妖除魔。",
    "玉鼠精": "无底洞的玉鼠精？那是我爹的义女。",
  ]));
  setup();
  carry_object("/u/birds/obj/lianhuapifeng.lpc")->wear();
  carry_object("/u/birds/obj/jinjia.lpc")->wear();
  carry_object("/d/qujing/jindou/obj/qiang")->wield();
  if ("/d/obj/fabao/huntian-ling"->in_mud())
    carry_object("/d/obj/fabao/huntian-fake");
  else
    carry_object("/d/obj/fabao/huntian-ling");
  if ("/d/obj/fabao/qiankun-quan"->in_mud())
    carry_object("/d/obj/fabao/qiankun-quan");
  else
    carry_object("/d/obj/fabao/qiankun-fake");
}

void init() {
  add_action("do_kill", "fight");
  add_action("do_kill", "kill");
  add_action("do_spells", "cast");
  add_action("do_spells", "ji");
  add_action("do_learn", "xuexi");
}
void attempt_apprentice(object ob) {
  command("say 我年纪尚小，徒弟我是不收的。");
  if ((string)ob->query("family/family_name") == "陷空山无底洞") {
    command("say " + RANK_D->query_respect(ob) + "若愿意学，看在我妹子的份上，我到可以点拨一二。");
  } else {
    command("sorry");
  }
}

int prevent_learn(object me, string skill) {
  int myyaofa = me->query_skill("yaofa", 1);

  if (skill == "dao") {
    if (myyaofa != 0) {
      command("sigh");
      command("say " + RANK_D->query_respect(me) + "妖气太重，不能学道家仙法。");
      return 1;
    }
  }
  return 0;
}

int do_kill(string arg) {
  object target, me = this_player();
  if (!arg) return 0;
  target = present(arg, environment(me));
  if ((string)environment(me)->query("short") != "花果山校军场") return 0;
  if (target == this_object() && !me->query_temp("dntg/lijing")) {
    go_away();
    return 1;
  }
  return 0;
}

int do_spells(string arg) {
  object target, me = this_player();
  string spl, trg;
  if ((string)environment(me)->query("short") != "花果山校军场") return 0;
  if (sscanf(arg, "%s on %s", spl, trg) == 2) {
    target = present(trg, environment(me));
    if (target == this_object() && !me->query_temp("dntg/lijing")) {
      go_away();
      return 1;
    }
  }
  return 0;
}

void check_fight(object me, object who) {
  if (me->is_fighting()) {
    call_out("check_fight", 2, me, who);
    return;
  }
  if (!present(me, environment(who)))
    go_away();
}
void die() {
  object taibai, lijing, juling, me = this_object()->query_temp("last_damage_from");
  if (!me) ::die();
  juling = present("juling shen", environment());
  lijing = present("li jing", environment());
  if ((int)me->query_temp("dntg/lijing")) {
    message("vision", "哪吒三太子痛心疾首地说：完了！完蛋了！
哪吒被你杀得大败，丢盔弃甲，狼狈不堪地逃了回去。\n", environment());
    lijing->command("kick " + this_object()->query("id"));
    lijing->command("sigh");
    lijing->command("say 既然如此，不必与他相持，且去上界，多遣天兵，围捉这厮，未为迟也。");
    message("vision", "李靖手一挥，带着手下敲锣打鼓班师回朝。\n", environment());
    if (lijing) destruct(lijing);
    if (juling) destruct(juling);
    taibai = new("/d/pantao/npc/taibai");
    taibai->command("chat 奉玉帝圣旨," + me->query("name") + "武功盖世,法术超群,加封为齐天大圣！");
    // add gain here .  .   .
    me->add("cor", 3);
    tell_object(me, "你得到了三点胆识! \n");
    me->delete_temp("dntg/lijing");
    me->set("dntg/n5", 1);
    me->add("dntg/number", 1);
    destruct(taibai);
    destruct(this_object());
  } else ::die();
}
void go_away() {
  object lijing, juling;
  lijing = present("li jing", environment());
  juling = present("juling shen", environment());
  message("vision", "哪吒喝道 : 想以多欺少吗 ?\n哼! 本少爷去也 !\n", environment());
  if (lijing) destruct(lijing);
  if (juling) destruct(juling);
  destruct(this_object());
}

string *reject_msg = ({
  "说道：您太客气了，这怎么敢当？\n",
  "像是受宠若惊一样，说道：请教？这怎么敢当？\n",
  "笑著说道：您见笑了，我这点雕虫小技怎够资格「指点」您什么？\n",
});

int do_learn(string arg) {
  string skill, teacher, master;
  object me = this_player(), ob;

  int master_skill, my_skill, sen_cost;
  if (!arg || sscanf(arg, "%s from %s", skill, teacher) != 1)
    return notify_fail("指令格式：xuexi <技能> from <某人>\n");
  if (me->is_fighting())
    return notify_fail("临阵磨枪？来不及啦。\n");
  if (!(ob = present(teacher, environment(me))) || !ob->is_character())
    return notify_fail("你要向谁求教？\n");

  if (!living(ob))
    return notify_fail("嗯．．．你得先把" + ob->name() + "弄醒再说。\n");

  if (!master_skill = ob->query_skill(skill, 1))
    return notify_fail("这项技能你恐怕必须找别人学了。\n");

  if ((string)me->query("family/family_name") != "陷空山无底洞")
    return 0;
  if ((int)me->query("combat_exp") < 500000) return 0;

  if (skill != "unarmed" && skill != "blade" && skill != "parry" && skill != "force" && skill != "dodge" && skill != "spells" && skill != "huntian-qigong")
    return notify_fail(ob->name() + reject_msg[random(sizeof(reject_msg))]);

  notify_fail(ob->name() + "不愿意教你这项技能。\n");
  if (ob->prevent_learn(me, skill))
    return 0;
  my_skill = me->query_skill(skill, 1);
  if (my_skill >= master_skill)
    return notify_fail("这项技能你的程度已经不输你师父了。\n");
  notify_fail("依你目前的能力，没有办法学习这种技能。\n");
  if (!SKILL_D(skill)->valid_learn(me)) return 0;
  sen_cost = 250 / (int)me->query_int();
  if (!my_skill) {
    sen_cost *= 2;
    me->set_skill(skill, 0);

  }
  if ((int)me->query("learned_points") >= (int)me->query("potential"))
    return notify_fail("你的潜能已经发挥到极限了，没有办法再成长了。\n");

  printf("你向%s请教有关「%s」的疑问。\n", ob->name(),
    to_chinese(skill));
  if (ob->query("env/no_teach"))
    return notify_fail("但是" + ob->name() + "现在并不准备回答你的问题。\n");

  tell_object(ob, sprintf("%s向你请教有关「%s」的问题。\n",
    me->name(), to_chinese(skill)));
  if ((int)ob->query("sen") > sen_cost / 5 + 1) {
    if (userp(ob)) ob->receive_damage("sen", sen_cost / 5 + 1);
  } else {
    write("但是" + ob->name() + "显然太累了，没有办法教你什么。\n");
    tell_object(ob, "但是你太累了，没有办法教" + me->name() + "。\n");
    return 1;
  }

  if ((int)me->query("sen") > sen_cost) {
    if ((string)SKILL_D(skill)->type() == "martial"
      && my_skill * my_skill * my_skill / 10 > (int)me->query("combat_exp")) {
      printf("也许是道行不够，你对%s的回答总是无法领会。\n", ob->name());
    } else {
      printf("你听了%s的指导，似乎有些心得。\n", ob->name());
      me->add("learned_points", 1);
      me->improve_skill(skill, random(me->query_int()));
    }
  } else {
    sen_cost = me->query("sen");
    write("你今天太累了，结果什么也没有学到。\n");
  }
  me->receive_damage("sen", sen_cost);
  return 1;
}
