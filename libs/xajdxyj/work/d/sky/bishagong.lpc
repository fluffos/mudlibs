#include <room.h>
inherit ROOM;

void create() {
  set("short", "毗沙宫");
  set("long", @LONG
    
毗沙宫中站立着几个庄严的武士，扫视着没一
个来往的人。
LONG);


  set("exits", ([
    "south": __DIR__ "tongmingdian",
    "north": __DIR__ "tonglugong",
  ]));


  set("objects", ([
    "/u/birds/stars/taf": 1,
  ]));



  setup();
}
