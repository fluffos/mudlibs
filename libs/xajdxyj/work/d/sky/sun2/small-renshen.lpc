// 百年人参

#include <ansi.h>

inherit ITEM;

int do_eat(string);
void init();

void init()
{
   add_action("do_eat", "eat");
}

void create()
{
   set_name(HIW "百年人参" NOR, ({"ren shen", "shen"}));
   set_weight(100);
   if (clonep())
     set_default_object(__FILE__);
   else {
     set("unit", "枚");
     set("long", "一颗百年人参。生于天地之间，吸取日月之精华，传说中给用功的人吃了以后会有奇效。\n");
     set("value", 50000);
     set("drug_type", "补品");
   }
  
   set("is_monitored",1);
   setup();
}

int do_eat(string arg)
{
   int i,j,k;
   object me = this_player();
  
   if (!id(arg)) return notify_fail("你要吃什么？\n");

  
   me->set("food", (int)me->max_food_capacity());
     i=3+random(4);
     j=3+random(4);
    k=4000+random(4000);

     me->add("max_force",i);
     me->add("max_mana",j);
     me->add("potential",k);
tell_object(me, "你得到了"+chinese_number(k)+"点潜能,你的最大内力增加了"+chinese_number(i)+"点,最大法力增加了"+chinese_number(j)+"点！\n");

   message_vision(HIW "$N把百年人参吃下去，头上冒出一股白烟。\n" NOR, me);  

   destruct(this_object());

   return 1;
}

