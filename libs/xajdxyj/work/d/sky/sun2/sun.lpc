inherit NPC;
#include <ansi.h>

string *list = ({ "yg-putuo", "yg-moon", "yg-wzg",
  "yg-fangcun", "yg-hell", "yg-jjf",
  "yg-dragon", "yg-xueshan",
  "yg-wudidong",
});

int work_me();
int delete_ask(object me);

void create() {



  set_name("孙大圣", ({ "sun dasheng", "sun", "dasheng" }));
  set("title", HIY "斗战胜佛" NOR);
  set("class", "xian");
  set("long", "身披七彩金甲，手拿如意金箍棒的孙大圣乃是西方极乐世界如来座下的斗战胜佛是也!\n");
  set("gender", "男性");
  set("age", 8800);
  set("attitude", "friendly");
  set("rank_info/respect", "佛爷");
  set("rank_info/rude", "老妖猴");
  set("per", 16);
  set("str", 100000);
  set("con", 30);
  set("cor", 100000);
  set("int", 40);
  set("spi", 40);
  set("cps", 10);
  set("kar", 40);
  set("max_kee", 15000);
  set("max_gin", 15000);
  set("max_sen", 15000);
  set("force", 80000);
  set("max_force", 40000);
  set("force_factor", 200);
  set("max_mana", 40000);
  set("mana", 80000);
  set("mana_factor", 200);
  set("combat_exp", 8000000);
  set_skill("spells", 500);
  set_skill("dao", 500);
  set_skill("unarmed", 500);
  set_skill("puti-zhi", 500);
  set_skill("dodge", 500);
  set_skill("stick", 500);
  set_skill("qianjun-bang", 500);
  set_skill("parry", 500);
  set_skill("force", 500);
  set_skill("wuxiangforce", 500);
  set_skill("jindouyun", 500);
  map_skill("unarmed", "puti-zhi");
  map_skill("stick", "qianjun-bang");
  map_skill("dodge", "jindouyun");
  map_skill("parry", "qianjun-bang");
  map_skill("force", "wuxiangforce");
  map_skill("spells", "dao");
  set_temp("apply/damage", 50000);
  set_temp("apply/armor", 100000);
  set("chat_chance", 2);
  set("chat_msg", ({
    "孙大圣怒道：杀尽天下妖魔鬼怪！\n",
    "孙大圣说道：那位得道高人愿替本佛除妖降魔？\n",
    "孙大圣恨恨的说：如此多的妖魔鬼怪,老孙我都杀烦了,谁愿去,谁愿去?\n",
  }));
  set("inquiry", ([
    "name": "分特,连老孙都不认识,你是白在西游记里混了吧?",
    "here": "这里是如来老官儿送给老孙我的斗战胜佛宫,怎样,还可以吧?七折卖给你?",
    "mieyao": (: work_me :),
    "kill": (: work_me :),
    "灭妖": (: work_me :),
  ]));



  seteuid(getuid());



  setup();
  carry_object("/u/moonsky/sun/jingubang")->wield();
  carry_object("/u/moonsky/sun/jinjia")->wear();
}

int work_me() {
  object ghost, me;
  int t, lvl;
  me = this_player();
  me->start_busy(3);
  if (!userp(me)) return 1;
  if (me->query_temp("asked/sun")) return 1;
  me->set_temp("asked/sun", 1);
  call_out("delete_ask", 1, me);
  //for first time.
  if (me->query("combat_exp") < 1330000) {
    message_vision("$N对$n摇摇头道:你道行尚浅,本大圣的妖魔你是打不过的!\n", this_object(), me);
    return 1;
  }
  if ((int)me->query("potential") - (int)me->query("learned_points") >= 100000) {
    message_vision("$N对$n摇摇头道:你现在应该潜心修炼,以达佛法最高境界.\n", this_object(), me);
    return 1;
  }
  if (!me->query("mieyao2")) {
    call_out("start_job", 1, me);
    return 1;
  }
  if ((t = (int)me->query("mieyao2/time_start")) &&
    !me->query("mieyao2/done")) {

    if (t <= time() &&
      time() < t + 240) {
      command("heng");
      command(
        "say 老爷子不是派你去降服" + me->query("mieyao2/name")
        + "吗？\n");
      return 1;
    }
    // failed, decrease lvl.
    lvl = me->query_temp("mieyao2/level");
    if (lvl > 0) lvl = 0;
    me->set_temp("mieyao2/level", lvl);

    // allow ask again.
  } else {  // job done
    if (t <= time() &&
      time() < t + 150) {
      message_vision("$N睁开火眼金睛朝凡间一看,对$n说道" +
        "：这位" + RANK_D->query_respect(me)
        + ",妖魔已经搞定，不妨先去找点乐子。\n",
        this_object(), me);
      return 1;
    }
    // succeed, increase lvl.
    lvl = me->query_temp("mieyao2/level");
    if (lvl < 9) lvl++;  // total 10 levels: 0, ..., 9
    else
      lvl = 1;  // reach the top level, reduce difficulty.
      me->set_temp("mieyao2/level", lvl);

  }
  me->delete("mieyao2/time_start");
  call_out("start_job", 1, me);
  return 1;
}
int start_job(object me) {
  string where;
  object ghost;
  int lvl;

  if (environment(me) != environment()) return 1;
  if (me->query("mieyao2/time_start")) return 1;
  me->delete("mieyao2/done");

  // determine levels.
  // use temp mark, if quit, then start over.
  lvl = me->query_temp("mieyao2/level");

  ghost = new(__DIR__ + list[random(sizeof(list))]);
  where = ghost->invocation(me, lvl);

  message_vision("$N对$n点了点头,然后睁开火眼金睛朝凡间看了看,\n", this_object(), me);
  message_vision("$N对$n说道：近有" + where + "为非作歹，"
    + "请速去降服！\n"
    , this_object(), me);
  me->set("mieyao2/time_start", time());
  me->set("mieyao2/name", ghost->query("name"));
  return 1;
}
int delete_ask(object me) {
  me->delete_temp("asked/sun");
  return 1;
}
