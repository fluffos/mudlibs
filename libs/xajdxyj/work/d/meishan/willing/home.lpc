#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", HIB"心雪苑"NOR);
        set("long", @LONG
这里是willing的工作室蒹宿舍.再靠窗的地方有一张办公桌,
上面放着他的那台破旧的286电脑,在边上最显眼的地方,赫然
放着一杯冰红茶(icetea)和几盒伍伯的音乐磁带.\n
LONG
);
	set("no_fight",1);
        set("valid_startroom",1);
        
   set("exits", ([
                     "out":"/d/meishan/guanjiang1",
                     "kezhan":"/d/city/kezhan",
                    "longgong":"/d/sea/gate",
                     "penglai":"/d/penglai/yanshang",
                     "yaochi":"/d/pantao/palace1",
                     
            ]));
            
   set("objects",
   ([
   	__DIR__"buwawa":1,
   	__DIR__"table":1,
        __DIR__"seat" : 2,
        __DIR__"bedlook":1,

   	]));
                                              
        setup();
}

void init()
{
   object me = this_player();
   string id;

id=me->query("id");

if(id!="willing"&&id!="wuppa"&&!me->query_temp("invited")){
     tell_object(me, "啊哈！ 闯进来了！\n");
     tell_object(me, "某某飞起一脚，正好踢中你的屁股 。  \n");
     me->move("/d/city/kezhan");
     message_vision("$N似乎被人一脚踢了出来，神色有点狼狈。\n", me);
   }
   add_action("do_bed", "gosleep");
   add_action("do_bed", "gobed" );
   add_action("do_bed", "bed");
   add_action("do_stand", "stand");
   add_action("do_sit", "sit");
   add_action("do_get","get");
   add_action("do_look","look");
   me->delete_temp("invited");
}

int do_look(string arg)
{
object obj,me=this_player();
if(me->query("id")!="willing"&&me->query("id")!="wuppa"){
	if(arg=="willing"){
   		if(!objectp(obj = present(arg, environment(me))))
			return notify_fail("这里没有这个人.\n");
		else{ 
		tell_object(me,"他就是willing啊,不认识了?\n");
		return 1;}
		}
	if(arg=="wuppa"){
		if(!objectp(obj = present(arg, environment(me))))
			return notify_fail("这里没有这个人.\n");
		else {
			tell_object(me,HIR"你一看到她,突然感到头脑一阵发热,心怦怦的跳,天哪,我要死了,我要死了!\n"NOR);
			return 1;}
		}
	}

}
int do_get(string arg)
{
   object me=this_player();
   object ob;
   if(me->query("id")=="willing"||me->query("id")=="wuppa"){
	tell_object(me,"willing抬头看了一下你笑道:'原来是你啊,嘻嘻~~\n'");
	if(!arg) tell_object(me,"想要什么啊?\n");
	if(arg=="icetea"){
		ob=new(__DIR__"cha");
		if (!ob) return notify_fail("faint,没有找到啊\n");
		ob->set("no_give",1);
		ob->setup();
		if(!ob->move(me)) ob->move(environment(me));
		
		}
	if(arg!=""&&arg!="icetea") tell_object(me,"你要的东西家里还没有去买呢~\n");
	return 1;
	}
   else{
        if(!arg) tell_object(me,HIR"这里的东西可不是乱拿的,heihei~~~~~~~\n"NOR);
        else {tell_object(me,HIR"你给我出去,到处乱拿东西!\n"NOR);
        this_player()->move("/d/city/kezhan");}
   	return 1;
   	}
}
int do_bed()
{       object me;
        me=this_player();
         message_vision(HIY "$N掀开纱帐，准备上床了。\n\n" NOR, me);
     me->move("/d/meishan/willing/bed");
            message_vision(HIY "\n沙帐轻轻一动，$N钻了进来。\n" NOR, me);
            return 1;
}
int do_sit(string arg)
{     
      object me;

      me=this_player();

   if ( !arg || ((arg != "seat")&&(arg != "table") ))
     return notify_fail("你要坐在什么上面？\n");   
   
   if (this_player()->query_temp("marks/sit"))
     return notify_fail("你已经坐下了。\n");   
      
   if ( arg != "seat")   
         return notify_fail("坐桌子上？太不雅观了吧。\n");
           
   this_player()->set_temp("marks/sit", 1);
   message_vision("$N舒舒服服地在石凳上坐下来，翘起了二郎腿。\n",me);
      return 1;   
}

int do_stand(string arg)
{
      object me;

      me=this_player();

      if (!this_player()->query_temp("marks/sit"))
          return notify_fail("你本来就站着。\n");

      this_player()->set_temp("marks/sit", 0);
      message_vision("$N伸了个懒腰，站了起来。\n", me);
      return 1;
}
