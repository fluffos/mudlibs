//made by FoF
// sweet.c

inherit ITEM;
inherit F_FOOD;
#include <ansi.h>

string *strs = ({
  "酥糖",
  "奶糖",
  "软糖",
  "大白兔奶糖",
  "脆糖",
  "喜糖",
  "麦芽糖",
  "水果糖",
  "巧克力糖",
  "夹心糖",
  "减肥糖",
  "润喉糖",
  "聪明豆",
});

string *eat_msg = ({
  "$N拿出一粒$n放到嘴里，轻轻一咬，脸上顿时露出了愉快的微笑。\n",
  "好一颗精巧玲珑的$n！$N喜滋滋地把它放到嘴边，心一急，簌地吞了下去。\n",
  "$N从怀里掏出一粒$n放到嘴里，啧啧啧地嚼着。\n",
  "$N鬼魅地一笑，道一声：变！手里立即出现了一粒$n！$N乐呵呵地把放到了嘴里。\n",
  "$N把手中的$n向天空一抛，随即张大嘴巴去接，$n落了个正着，一下掉进了$N的喉咙里。\n",
  "$N把手中的$n向天空一抛，随即张大嘴巴去接，$n不偏不倚打中了$N的大鼻子，又嘣地弹了起来，$N急忙伸出舌头把它卷了回来。\n",
  "$N袖子一抖，手里立即多出了一颗$n。$N把$n放到嘴里，慢慢地品尝。\n",
  "$N把手中的$n放到嘴里，大口大口地嚼着，发出咯吱咯吱的响声。\n",
  "$N拿出一粒$n放到左手上，右手一拍左手，$n立即弹了起来，不偏不倚正好弹到了$N的嘴里！\n",
});

void create() {
  //   set_name(strs[random(sizeof(strs)]), ({"tang", "sweat"}));
  set_name("各式糖果", ({ "tang", "sweat" }));
  set_weight(5);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一粒包装精美、气味香甜的糖果，看到它你就直流口水。\n");
    set("unit", "粒");
    set("value", 5);
    set("food_remaining", 1);
    set("food_supply", 10);
  }
}

void init() {
  if (query("name") == "各式糖果")
    set_name(strs[random(sizeof(strs))], ({ "tang", "sweet" }));
  add_action("do_eat", "eat");
  ::init();
}

int do_eat(string arg) {
  object me = this_object();
  object who = this_player();
  if (!arg || (arg != "sweet" && arg != "tang"))
    return 0;
  message_vision(HIY + eat_msg[random(sizeof(eat_msg))] + NOR, who, me);
  if (who->query("food") < who->max_food_capacity())
    who->add("food", 10);
  destruct(me);
  return 1;
}
