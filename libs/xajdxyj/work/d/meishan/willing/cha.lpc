// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

// jiudai.c  酒袋

inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name("冰红茶", ({ "cha", "hongcha", "binghongcha" }));
  set_weight(700);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "冰红茶一听,hiahiahiahiahia\n");
    set("unit", "听");
    set("value", 100);
    set("max_liquid", 15);
  }

  // because a container can contain different liquid
  // we set it to contain wine at the beginning
  set("liquid", ([
    "type": "alcohol",
    "name": "冰红茶",
    "remaining": 150,
    "drunk_apply": 15,
  ]));
}
