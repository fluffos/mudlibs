#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", HIB"心雪苑"NOR);
        set("long", @LONG
这里是willing的工作室蒹宿舍.再靠窗的地方有一张办公桌,
上面放着他的那台破旧的286电脑,在边上最显眼的地方,赫然
放着一杯冰红茶(icetea)和几盒伍伯的音乐磁带.
LONG
);
	set("no_fight",1);
            set("valid_startroom",1);
        
   set("exits", ([
                     "out":"/d/menshan/guanjiang1",
                     "kezhan":"/d/city/kezhan",
                    "longgong":"/d/sea/gate",
                     "penglai":"/d/penglai/yanshang",
                     "yaochi":"/d/pantao/palace1",
                     
            ]));
            
   set("objects",
   ([
   	"/obj/toy/buwawa":1,
   	"/d/ourhome/obj/table":1,
        "/d/ourhome/obj/seat" : 2,

   	]));
                                              
        setup();
}

void init()
{
   object me = this_player();
   string id;

id=me->query("id");

if(id!="willing"&&id!="wuppa"){
     tell_object(me, "啊哈！ 闯进来了！\n");
     tell_object(me, "某某飞起一脚，正好踢中你的屁股 。  \n");
     me->move("/d/city/kezhan");
     message_vision("$N似乎被人一脚踢了出来，神色有点狼狈。\n", me);
   }
   add_action("do_bed", "gosleep");
   add_action("do_bed", "gobed" );
   add_action("do_bed", "bed");
}

int do_bed()
{       object me;
        me=this_player();
         message_vision(HIY "$N掀开纱帐，准备上床了。\n\n" NOR, me);
     me->move("/d/meishan/bed");
            message_vision(HIY "\n沙帐轻轻一动，$N钻了进来。\n" NOR, me);
            return 1;
}
