inherit ROOM;

void create ()
{
  set ("short", "御花园");
  set ("long", @LONG

葱翠艳丽的御花园，四周种满五颜六色龙形凤姿的奇花异蕊
中间是数条回转的青玉石雕花小径互为交错。煦风吹过，真
是葩醇花香无比，令人恍然纷醉。在一条小径的旁边树着一
张牌子，上面画着一张地图(map)。

LONG);

  set("exits", ([ /* sizeof() == 2 */
  "north" : __DIR__"yhy1a.lpc",
  "south" : __DIR__"yhy3a",
]));
  set("outdoors", "/d/huanggong");

  setup();
}

void init()
{
	add_action("do_read", "read");
}

int do_read(string arg)
{
	if ( !arg || arg != "map" )
		return notify_fail("你要读什么？\n");
	cat("/doc/map/yanwuchang");
	if( this_player()->query("maps/yanwuchang") )
		return 1;
	this_player()->set("maps/yanwuchang", 1);
	this_player()->save();
	return 1;
}
