// FoF modified 98-3-7 for 尚方宝剑

inherit NPC;
#include "reporting.h"

int test1();
int test2();
int test3();
int give_sword();

void create() {
  set_name("唐太宗", ({ "tang taizong", "tang", "tai zong", "zong", "king", "emperor" }));
  set("long", "大唐国之皇帝唐太宗。\n");
  set("title", "大唐国");
  set("gender", "男性");
  set("rank_info/respect", "陛下");
  set("age", 80);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("per", 30);
  set("int", 30);
  set("max_kee", 700);
  set("max_gin", 700);
  set("max_sen", 700);
  set("force", 800);
  set("max_force", 800);
  set("force_factor", 50);
  set("max_mana", 800);
  set("mana", 800);
  set("mana_factor", 40);
  set("combat_exp", 220000);
  set_skill("unarmed", 50);
  set_skill("dodge", 50);
  set_skill("parry", 50);
  set_skill("spells", 50);
  set_skill("force", 50);
  set_skill("seashentong", 50);
  set_skill("dragonforce", 50);
  set_skill("dragonstep", 50);
  set_skill("dragonfight", 50);
  map_skill("unarmed", "dragonfight");
  map_skill("dodge", "dragonstep");
  map_skill("force", "dragonforce");
  map_skill("spells", "seashentong");
  set_weight(5000000);
  setup();
  carry_object("/d/obj/cloth/mangpao")->wear();
  set("inquiry", ([
    "潜能": (: test1 :),
    "道行": (: test2 :),
    "黄金": (: test3 :),
    //   "尚方宝剑" : (: give_sword :),
  ]));

}

void init() {
  call_out("test_player", 1, this_player());
}

string *strs = ({
  "$N对$n惊叹道：",
  "$N对$n赞赏道：",
  "$N微笑着对$n说道：",
  "$N赞许地对$n说道：",
});

void test_player(object who) {
  object me = this_object();
  object where = environment(me);
  object dachen;
  int i = 10;

  if (who->query("quest/reward") < 1)
    return;

  message_vision("\n一进大殿，$N身上涌起淡淡的祥云。\n", who);
  while (i--) {
    string str = "da chen 1";

    // str[strlen(str)-1] = '1'+random(5);
    switch (random(32))  // mon 4/5/98 changed range to 32 from 16
    {
      case 0: case 1: case 2: case 3: case 4: case 5: case 6:
      case 16: case 17: case 18: case 19: case 20: case 21: case 22:
        {
          str = "duan zhixian";
          break;
        }
      case 7: case 8:
        {
          str = "du ruhui";
          break;
        }
      case 9:
        {
          str = "zhang shiheng";
          break;
        }
      case 10: case 11:
        {
          str = "meng ziru";
          break;
        }
      default:
        {
          str = "xu maogong";
          break;
        }
    }
    dachen = present(str, where);

    if (!interactive(dachen))
      break;
  }

  if (!dachen)
    dachen = present("da chen", where);

  if (!dachen ||
    interactive(dachen)) {
    message_vision("$N对$n说道：大臣们不在，" + RANK_D->query_respect(who) +
      "稍候也。\n", me, who);
    return;
  }
  message_vision(strs[random(sizeof(strs))] + RANK_D->query_respect(who) +
    "祥云缭绕，面生瑞气，朕果然有赏御赐与你！\n", me, who);
  message_vision("\n$N走上前，赶紧在$n的殿前俯身跪下。\n", who, me);
  who->start_busy(3, 3);
  call_out("reward_player", 2, me, who, dachen);
}

void reward_player(object me, object who, object dachen) {
  message_vision("\n旁边闪过大臣$N低声向$n说了几句，$n点了点头。\n", dachen, me);
  dachen->reward(who);
  message_vision("\n$N连忙俯身一拜，小心翼翼地站起来。\n", who, me);
  who->delete("quest/reward");
  who->interrupt_me();
}

int test1() {
  object me = this_object(), who = this_player();
  object dachen = present("duan zhixian", environment());
  int points = (int)who->query("mud_age") - (int)who->query("mud_age_gift");

  if (!dachen) {
    write("唐太宗说道：段爱卿不在。\n");
    return 1;
  }

  if (points > 86400) {
    if (time() - who->query_temp("last_mud_age_gift") < 3) {
      write("唐太宗说道：勿急。\n");
      return 1;
    }

    points = 1000;
    message_vision("\n旁边闪过大臣$N低声向$n说了几句，$n点了点头。\n\n", dachen, me);
    message_vision("$N对$n一拜：陛下有旨，赐" + RANK_D->query_respect(who) +
      chinese_number(points) + "点潜能！\n", dachen, who);
    message_vision("\n$N连忙俯身一拜，小心翼翼地站起来。\n", who);
    who->add("potential", points);
    who->add("mud_age_gift", 86400);
    reporting(who, "为西游正果努力奋斗", points, "点潜能");
    return 1;
  } else {
    write("唐太宗说道：只要你多多努力，朕必有赏于你。\n");
    return 1;
  }
}

int test2() {
  object me = this_object(), who = this_player();
  object dachen = present("xu maogong", environment());
  int points = (int)who->query("mud_age") - (int)who->query("mud_age_gift");

  if (!dachen) {
    write("唐太宗说道：徐爱卿不在。\n");
    return 1;
  }

  if (points > 86400) {
    if (time() - who->query_temp("last_mud_age_gift") < 3) {
      write("唐太宗说道：勿急。\n");
      return 1;
    }

    points = 2000;
    message_vision("\n旁边闪过大臣$N低声向$n说了几句，$n点了点头。\n\n", dachen, me);
    message_vision("$N对$n一拜：陛下有旨，赐" + RANK_D->query_respect(who) +
      COMBAT_D->chinese_daoxing(points) + "道行！\n", dachen, who);
    message_vision("\n$N连忙俯身一拜，小心翼翼地站起来。\n", who);
    who->add("combat_exp", points);
    who->add("mud_age_gift", 86400);
    reporting(who, "为西游正果努力奋斗", points, "点道行");
    return 1;
  } else {
    write("唐太宗说道：只要你多多努力，朕必有赏于你。\n");
    return 1;
  }
}

int test3() {
  object me = this_object(), who = this_player(), gold;
  object dachen = present("meng ziru", environment());
  int points = (int)who->query("mud_age") - (int)who->query("mud_age_gift");

  if (!dachen) {
    write("唐太宗说道：孟爱卿不在。\n");
    return 1;
  }

  if (points > 86400) {
    if (time() - who->query_temp("last_mud_age_gift") < 3) {
      write("唐太宗说道：勿急。\n");
      return 1;
    }

    points = 50;
    message_vision("\n旁边闪过大臣$N低声向$n说了几句，$n点了点头。\n\n", dachen, me);
    message_vision("$N对$n一拜：陛下有旨，赐" + RANK_D->query_respect(who) +
      chinese_number(points) + "两黄金！\n", dachen, who);
    gold = new("/obj/money/gold");
    gold->set_amount(points);
    if (!(gold->move(who))) gold->move(environment(who));
    message_vision("$N递给$n一包黄金。\n", dachen, who);
    message_vision("\n$N连忙俯身一拜，小心翼翼地站起来。\n", who);
    who->add("mud_age_gift", 86400);
    reporting(who, "为西游正果努力奋斗", points, "两黄金");
    return 1;
  } else {
    write("唐太宗说道：只要你多多努力，朕必有赏于你。\n");
    return 1;
  }
}

int give_sword() {
  object sword, *swords, where, who = this_player(), me = this_object();
  int i = 0;

  if (who->query("combat_exp") < 2100000) {
    message_vision("唐太宗对$N说道：尚方宝剑乃特权之物，须德高望重之人方有资格持有。\n", who);
    command("shake " + who->query("id"));
    return 1;
  }
  if ("/u/fof/power_sword"->in_mud()) {
    swords = children("/u/fof/power_sword.lpc");
    if (clonep(swords[i])) sword = swords[i];
    else sword = swords[i + 1];
    if (sword) where = environment(sword);
    if (where && where->is_character()) {
      if (where = who)
        message_vision("唐太宗对$N说道：尚方宝剑不是已经交给你了吗？\n", who);
      else
        message_vision("唐太宗对$N说道：尚方宝剑已经交给" + where->short() + "了。\n", who);
    } else
      message_vision("唐太宗对$N说道：尚方宝剑已经交给他人了。\n", who);
    return 1;
  }
  sword = new("/u/fof/power_sword.lpc");
  sword->move(who);
  message_vision("唐太宗交给$N一把$n。\n", who, sword);
  return 1;
}
