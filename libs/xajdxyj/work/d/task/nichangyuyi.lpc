//dhny2000
#include <ansi.h>
inherit ITEM;
inherit F_UNIQUE;

void create() {
  set_name(HIM "霓裳羽衣" NOR, ({ "nichangyuyi", "nichang yuyi", "yuyi" }));
  set_weight(500);
  set("is_task", "嫦娥");
  set_max_encumbrance(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "这是嫦娥的霓裳羽衣，别人是穿不了的。\n");
    set("value", 0);
  }
  set("is_monitored", 1);
  setup();
}

int is_container() { return 1; }
