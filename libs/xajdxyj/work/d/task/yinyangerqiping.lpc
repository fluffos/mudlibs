//dhny 2000
#include <weapon.h>
#include <ansi.h>
inherit HAMMER;
inherit F_UNIQUE;

void create() {
  set_name(HIG "阴阳二气瓶" NOR, ({ "yinyangerqiping", "yinyang erqi ping", "yinyang", "ping" }));
  set_weight(3000);
  set("is_task", "秃鹰尊者");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "只");
    set("long", "这是一只阴阳二气瓶，蕴藏着秘密力量。\n");
    set("value", 0);
    set("material", "steel");
    set("wield_msg", "$N小心翼翼地拿起$n捧在手中。\n");
    set("unwield_msg", "$N念念咒語，$n自动飞回衣袖。\n");
  }
  set("is_monitored", 1);
  init_hammer(80);
  init_hammer(80);
  setup();
}
