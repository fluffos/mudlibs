#include <ansi.h>

inherit ITEM;
inherit F_UNIQUE;

void create() {
  set_name(YEL "天师符法" NOR, ({ "tianshifufa", "tianshi fufa", "book" }));
  set_weight(200);
  set("long", "相传为天师张道陵所著，后为蜀山修仙锄魔的基本章法。\n");
  set("is_task", "张道陵");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("material", "paper");
    set("value", 0);
    set("no_sell", 1);
  }
  setup();
}
