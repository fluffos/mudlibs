//Ansi 99.8
#include <weapon.h>
#include <ansi.h>
inherit BLADE;
inherit F_UNIQUE;

void create() {
  set_name(HIR "圆月弯刀" NOR, ({ "yuanyue wandao", "wandao", "blade" }));
  set_weight(3000);
  set("is_task", "田鼠精");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "这是田鼠精的圆月弯刀，是碧鼠修得正果的法宝。\n");
    set("value", 0);
    set("material", "steel");
    set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n插回刀鞘。\n");
  }
  set("is_monitored", 1);
  init_blade(80);
  setup();
}
