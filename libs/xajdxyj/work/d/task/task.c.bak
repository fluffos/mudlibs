#include <ansi.h>
int main(object me, string str)
{
	string output;
	me->add("sen",-5);
	output = HIR"南游记宝藏一览\n" NOR;
	output += "———————————————————————————\n";
	output += TASK_D->dyn_quest_list();
	output += "———————————————————————————\n\n";

	me->start_more(output);
	return 1;
}
