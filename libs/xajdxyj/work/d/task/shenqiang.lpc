//DHNY2000

#include <weapon.h>
#include <ansi.h>
inherit SPEAR;
inherit F_UNIQUE;

void create() {
  set_name(HIC "神枪" NOR, ({ "shenqiang", "spear" }));
  set_weight(9000);
  set("is_task", "罗成");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "罗成的神枪\n");
    set("material", "iron");
    set("wield_msg", "$N拿出一把$n，握在手中．\n");
    set("unwield_msg", "$N放下手中的$n。\n");
  }
  set("is_monitored", 1);
  init_spear(50);
  setup();
}
