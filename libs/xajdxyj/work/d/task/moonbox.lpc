//dhny2000
#include <ansi.h>
inherit ITEM;
inherit F_UNIQUE;

void create()
{
   set_name(HIY"月光宝盒"NOR, ({ "moonbox" }) );
   set_weight(500);
   set("is_task","西王母");
   set_max_encumbrance(2000);
   if( clonep() )
     set_default_object(__FILE__);
   else {
     set("unit", "个");
     set("long", "这是西王母的月光宝盒。\n");
     set("value", 0);
   }
	set("is_monitored",1);
	setup();
}

int is_container() { return 1; }
