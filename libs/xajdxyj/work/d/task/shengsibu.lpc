    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "

※※※※※※※※※
※　　　　　　　※
※" + HIR + "　生  死  簿 " + NOR + " ※
※　　　　　　　※
※※※※※※※※※
\n
");
    set("material", "paper");
    set("value", 0);
  }

  set("is_monitored", 1);
}
