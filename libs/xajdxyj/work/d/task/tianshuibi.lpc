//dhny2000
#include <ansi.h>
inherit ITEM;
inherit F_UNIQUE;

void create() {
  set_name(HIC "天水璧" NOR, ({ "tianshuibi", "tianshui bi", "bi" }));
  set_weight(500);
  set("is_task", "龙女");
  set_max_encumbrance(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "枚");
    set("long", "这是龙女的一枚天水璧。\n");
    set("value", 0);
  }
  set("is_monitored", 1);
  setup();
}

int is_container() { return 1; }
