// nyj21cn Ansi
object find_env(object ob);
inherit F_CLEAN_UP;

int main(object me, string arg) {
  object ob, item, *ob_list;
  string sh;
  int i;
  if (!arg) return notify_fail("指令格式: locate <物品>\n");

  if (!objectp(item = find_object("/task/" + arg)))
    return notify_fail("此物品不存在或者该物品不能被追踪。\n");

  ob_list = children("/obj/task/" + arg);
  if (ob_list) {
    for (i = 0; i < sizeof(ob_list); i++) {
      ob = find_env(ob_list[i]);
      me->add("sen", -5);
      if (ob) {
        if (ob->name())
          write(ob->name());
        else {
          sh = undefinedp(ob->query("short")) ? ob->short() : ob->query("short");
          write(item->name() + "在" + sh + "。\n");
        }
      }
    }
  } else write("无法找到该物品。\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式: locate <物品>

这个指令是用来得知使命物品的位置。

HELP
  );
  return 1;
}

object find_env(object ob) {
  while (ob) {
    if (ob->query("short")) return ob;
    else ob = environment(ob);
  }
  return ob;
}
