#include <ansi.h>
#include <net/dns.h>
#include <net/telnet.h>
#include <net/socket.h>
#include <net/socket_errors.h>
#include <socket_err.h>
#include <mudlib.h>

inherit ROOM;

nosave int my_socket0 = 0;
nosave string smtp_ip = "202.117.1.88 25";
nosave string smtp_domain = "internet.xjtu.edu.cn";
nosave string sender = "fof@263.net", rcpt, msg;
// nosave int status = 0;
object me;

private int write_message(string arg);
private string make_password();

void log_fail(string arg) {
  log_file("reg_mail", sprintf("%s %s(%s) - %s\n",
    ctime(time()), me->query("id"), me->query("name"), arg));
}

void create() {
  set("id", "mail register");
  seteuid(getuid());
  set("short", HIC "注册区" NOR);
  set("long", "\n　　欢迎来到" + HIG MUD_NAME NOR +
    "注册区！参加游戏的玩家都必须进行注册，才能享
有全部的权利（更改密码、保护数据档案等），验证的方法是通过电子
邮件，请提供一个有效的 E-mail 地址，使用如下命令：\n\t"
    HIC + "register " + HIG + "你的Email地址" + NOR +
    "\n    如果别人正在注册中，请稍候。邮件发送后，请退出游戏，看看自
己的 Email 信箱（交大校内信箱一般马上就可以收到，263 的可能要稍
等几分钟），使用注册密码重新登录一次，完成注册。
    注意：
    系统发给你的 E-mail 请务必保存好。当你的人物密码被盗或遗失
时，只能通过注册信为凭证更改。
    一路好运 Good Luck!
Ps : 功能完善中。
\n");

  set("exits", ([
    "east": "/d/wiz/entrance",
  ]));
  set("no_fight", 1);
  set("no_magic", 1);
  set("objects", ([
  ]));
  set("status", "ready");
  set("connected", 0);

  setup();
}

void init() {
  if (!wizardp(this_player()))
    add_action("do_none", "", 1);
  add_action("do_register", "register");
}

int do_none(string arg) {
  string *msg1 = ({
    "你可以用 register E-mail 来注册。\n",
    "注册完你才可以使用别的命令。\n",
    "请你先注册。\n",
    "注册命令是 : register Email。\n",
    "欢迎你来到欢乐园。\n",
  });
  if (arg == "register") return 0;
  if (arg == "say") return 0;
  if (arg == "look") return 0;

  return notify_fail(msg1[random(sizeof(msg1))]);
}

int do_register(string dest) {
  int my_socket, err;
  string passwd;
  object link_ob;

  if (query("status") != "ready")
    return notify_fail("注册系统忙，请稍候。\n");

  if (!dest || !sscanf(dest, "%*s@%*s.%*s"))
    return notify_fail("电子邮件地址错误。\n");

  // status = 0;
  rcpt = dest;

  me = this_player();
  link_ob = me->query_temp("link_ob");

  if (link_ob->query("registed") || link_ob->query("reg_mail_send"))
    return notify_fail("你已经注册过了。\n");

  if (me->query_temp("registering"))
    return notify_fail("你已经在注册了。\n");

  me->start_busy(10);  // hehe

  passwd = make_password();
  me->set_temp("reg_passwd", passwd);
  me->set_temp("email", dest);

  msg = me->query("id") + "\n    你好！欢迎光临" + INTERMUD_NAME + "！"
    "\n    你已经成功地在" + INTERMUD_NAME + "注册，请使用下面提供的注册密码登录"
    "\n完成注册。"
    "\n    你的注册密码是：" + passwd +
    "\n    请妥善保存好该密码，因为它将是验证你身份的依据，将来你"
    "\n要修改登录口令，自杀或恢复档案等都要用到这个密码。"
    "\n    遇到问题，请与管理员联系："
    "\n\n    fof@263.net"
    "\n\n\t" + ctime(time());
  msg = "TO:" + dest + "\n" +
    "SUBJECT:" + INTERMUD_NAME + "注册信件\n" +
    "FROM:" + me->query("id") + "@" + INTERMUD_MUD_NAME + "\n" +
    "MIME-Version:1.0\n" +
    "DATE:" + ctime(time()) + "\n" +
    "X-MAILER:Lpc Smtp client v0.1\n" + "\n" +
    msg;

  my_socket = socket_create(STREAM, "read_callback", "close_callback");

  if (my_socket < 0) {
    log_fail("failed to create socket");
    tell_object(me, "注册失败，请再试一试。");
    return 1;
  }

  my_socket0 = my_socket;
  err = socket_connect(my_socket0, smtp_ip, "read_callback", "write_callback");

  // 如果成功设置连接标记 = 1
  if (err == EESUCCESS) {
    tell_object(me, "成功连接到邮件服务器，正在发送邮件……\n");
    set("connected", 1);
  } else {
    log_fail("cannot connect to SMTP Server");
    tell_object(me, "无法连接到邮件服务器！注册失败，请再试一试。");
  }

  if (!my_socket0) return notify_fail("无法连接到邮件服务器！\n");

  remove_call_out("clear_registering");
  call_out("clear_registering", 8);
  return 1;
}

void clear_registering() {
  if (me) me->delete_temp("registering");
}

int close_socket() {
  if (query("connected")) {
    if (socket_close(my_socket0)) {
      log_fail("close socket\n");
      delete("connected");
    } else
      log_fail("fail to close socket");
  } else
    log_fail("socket_close -- not connected");

  return 1;
}

void read_callback(int fd, mixed message) {
  string cur_status = query("status");

  // 配合 call_out
  if (cur_status != "helo" && message == "250 mailfrom") return;

  if (message != "250 mailfrom")
    tell_object(me, BOLD + "→" + NOR + message);

  switch (cur_status) {
    case "ready":
      if (sscanf(message, "220%*s")) {
        // status ++;
        write_message("HELO " + smtp_domain);
        set("status", "helo");

        // 当系统或网络忙的时候得用一下延时
        call_out("read_callback", 3, fd, "250 mailfrom");
        /*
call_out("read_callback", 4, fd, "250 mailfrom");
call_out("read_callback", 6, fd, "354 mailfrom");
call_out("read_callback", 8, fd, "451 mailfrom");
*/
        return;
      }
      break;
    case "helo":
      if (sscanf(message, "250%*s")) {
        // status ++;
        write_message("MAIL FROM:<mud.xjtu.edu.cn>");
        set("status", "mailfrom");
        return;
      }
      break;
    case "mailfrom":
      if (rcpt && sscanf(message, "250%*s")) {
        // status ++;
        write_message("RCPT TO:<" + rcpt + ">");
        set("status", "rcptto");
        return;
      }
      break;
    case "rcptto":
      if (sscanf(message, "250%*s")) {
        // status ++;
        write_message("DATA");
        set("status", "data");
        return;
      }
      break;
    case "data":
      if (sscanf(message, "354%*s")) {
        // status ++;
        write_message(msg + "\n.\n");
        set("status", "dataend");
        return;
      }
      break;
    case "dataend":
      if (sscanf(message, "451%*s"))
        log_fail("Smtp Server 接收数据出错！请另选服务器。");
      else
        tell_object(me, "\n注册信件已经正确发送了，请退出游戏，查看你的邮件信箱，使用注册\n"
          "密码重新登录。如果你使用263网信箱，你可以马上收取注册信。否则请过几\n" +
          "分钟后再打开你的信箱查收。\n\n\t欢乐园注册精灵\n\n");
      set("status", "ready");
      break;
    default:
      log_fail("wrong status");
  }

  //if( status != 5 || !sscanf(message, "250%*s") )
  //    log_fail("发送出错");
  // status = 0;
  write_message("QUIT\r\t");
  close_socket();

  {
    object link_ob = me->query_temp("link_ob");
    set("status", "ready");
    me->delete_temp("registering");
    link_ob->set("reg_mail_send", 1);
    link_ob->set("reg_passwd", crypt(me->query_temp("reg_passwd"), 0));
    link_ob->set("email", me->query_temp("email"));
    me->delete_temp("email");
    me->delete_temp("reg_passwd");
    me->start_busy(1);
    link_ob->save();
  }

  return;
}

void write_callback(int fd) {
  int res;

  if (query("connect")) return;
  res = socket_write(fd, "");
  if (res == EESUCCESS || res == EECALLBACK) {
    set("connected", 1);
  }
}

private int write_message(string arg) {
  if (!arg) arg = "";

  socket_write(my_socket0, arg + "\n");

  return 1;
}

string make_password() {
  int i, j;
  string passwd = "ASDFGHJK";

  i = 5 + random(4);  // passwd 长度在 5->8 位之间
  for (j == 0; j < i; j++) {
    passwd[j] = '1' + random(73);
  }

  // 密码的第一个字符不要用 '!' 号
  if (passwd[0] == '!') passwd[0]++;

  return passwd;
}
