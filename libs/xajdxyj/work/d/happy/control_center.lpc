// control_center.c
// MUD 控制中心
// by FoF 00-3-7

#include <ansi.h>
inherit ROOM;

nosave mapping status = ([ 
	"LOGIN" : "ON",
	"CREAT_CHARACTER" : "ON",
	]);

string mud_status(string);
int set_status(string);

void create ()
{
	set ("short", HIR"◎控制中心◎"NOR);
	set ("long", @LONG

这里是整个世界的控制中心。
请用 mud_status 指令来查询参数
     set_status 指令来设置参数
LONG);

	set("exits", ([ /* sizeof() == 2 */
		"down" : __DIR__"wizroom",
	]));
	set("no_clean_up", 1);
	set("MUD_SRART_TIME", time());

	setup();
}

void init()
{   
	if( wizardp(this_player()) ) {
		add_action("mud_status", "mud_status");
		add_action("set_status", "set_status");
	}
}

string mud_status(string arg)
{
	if( !arg ) {
		write(sprintf("当前状态是：\n%O\n", status));
		return "";
	} else if( !undefinedp(status[upper_case(arg)]) ) {
		return status[upper_case(arg)];
	}
}

int set_status(string arg)
{
	string arg1, arg2;

	if( !arg || sscanf(arg, "%s %s", arg1, arg2) != 2 )
		return notify_fail("指令格式：set_status < 参数 > < 参数的值 >\n");
	arg1 = upper_case(arg1);
	arg2 = upper_case(arg2);
	status[arg1] = arg2;
	write(sprintf("设置 %s 的值为 %s 。\n", arg1, arg2));

	return 1;
}

