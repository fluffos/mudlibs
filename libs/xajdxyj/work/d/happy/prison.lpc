// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */
 
// Room: /d/wiz/prison.c
// 监狱

#include <ansi.h>
inherit ROOM;

void create()
{
   set("short", "监狱");
   set("long", @LONG

监狱，这里的的确确是监狱，没有自由的监狱，想不到，今天你自己
也会进到这里，任凭你怎么喊怎么叫，也没人理。
LONG
   );

   set("no_update_age", 1);
   set("valid_startroom", 1);

   setup();
}

void init()
{
    object who = this_player();
    int prison_time;
    
    if( !wizardp(who) ) {
        who->set("startroom", __FILE__);
        who->save();
        add_action("block_cmd", "", 1);
        if( ! prison_time = who->query("prison_time") )
            prison_time = 1440;
        if( prison_time <= 1440 ) prison_time = 1440;
        else call_out("one_day", 1440, who);
        call_out("set_free", prison_time, who);
        message_vision(HIR "一个声音对$N吆喝道：" + who->query("name") +
            "，你的刑期还有" + chinese_number(prison_time/1440) +
            "天，老老实实蹲着！\n" NOR, who);
    }
    remove_call_out("hehe");
    call_out("hehe", 2, who);
}

int is_prison() { return 1; }

int block_cmd()
{
    string verb = query_verb();

    if( verb == "say" ) return 0; //allow say
    if( verb == "help" ) return 0;
    if( verb == "look" ) return 0;
    if( verb == "quit" ) return 0;
    return 1;
}

// added by bula, just for fun.

void hehe()
{
    if( ! this_player() ) return;
    tell_room(environment(this_player()), "\n" +
     "隔壁的牢房里传来阵阵惨叫声！\n" +
     "你隐隐约约听到隔壁牢房里有人大喊：你招还是不招！\n" +
     "隔壁的牢房里传来阵阵皮鞭声！\n" +
     "你隐隐约约听到隔壁牢房里有人喊到：我们的政策是坦白从宽，抗拒从严！\n" +
     "你隐隐约约听到有人说话，可又听不大清楚！\n" +
     "隔壁的牢房里有人笑道：你早些招了，就不必吃这顿鞭子了！\n");
    return;
}

void one_day(object who) // 坐完一天的牢，刑期减少一天
{
    int prison_time;
    
    if( ! who ) return;
    
    tell_object(who, "你好不容易熬过了一天。\n");
    who->add("prison_time", -1440);
    who->save();
    
    prison_time = who->query("prison_time");
    if( prison_time <= 0 ) who->delete("prison_time");
    if( prison_time <= 1440 ) return;
    call_out("one_day", 1440, who);
    return;
}

void set_free(object who)
{
    if( ! who ) return;
    message_vision("两个狱卒走过来，把$N领了出去。\n", who);
    tell_object(who, "你的刑期已满，出去好好做人吧！\n");
    who->move("/d/city/kezhan");
    who->set("startroom", "/d/city/kezhan");
    who->delete("prison_time");
    who->save();
    return;
}

