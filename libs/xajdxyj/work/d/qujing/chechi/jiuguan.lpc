inherit ROOM;

void create ()
{
  set ("short", "酒馆");
  set ("long", @LONG

小酒馆里边酒柜齐胸高。后面可以看见三个大酒缸。墙上挂着一张地图(map)，
旁边吊些酒葫芦酒袋，案桌上放着大块的熟牛肉。酒保一边招待客人，一边切
着熟牛肉。

LONG);

  set("exits", ([
        "east"         : __DIR__"caichang",
      ]));

  set("objects", ([
         __DIR__"npc/jiubao" : 1,
      ]));

  setup();
}

void init()
{
	add_action("do_read","read");
}

int do_read(string arg)
{
	if ( !arg || arg != "map" )
		return notify_fail("你要读什么？\n");
	cat("/doc/map/chechi");
	if( this_player()->query("maps/chechi") )
		return 1;
	this_player()->set("maps/chechi", 1);
	this_player()->save();
	return 1;
}
