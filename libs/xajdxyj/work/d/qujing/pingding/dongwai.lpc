inherit ROOM;

void create ()
{
  set ("short", "洞外");
  set ("long", @LONG

一道山涧从脚下流过，发出潺潺的流水声。山涧的去处有一片
绿色林木，林木的后面有一山洞，洞的上沿有一凿平的石壁，
上面刻着：平顶山莲花洞。旁边不知是谁用碳头画了幅图(map)。

LONG);

  set("exits", ([
        "northwest"   : __DIR__"ping3",
        "southeast"   : __DIR__"dongmen",
      ]));
  set("objects", ([
    __DIR__"npc/chong"   : 1,
    __DIR__"npc/gui"   : 1,
  ]));
  set("outdoors", __DIR__);

  setup();
}

void init()
{
	add_action("do_read","read");
}

int do_read(string arg)
{
	if ( !arg || arg != "map" )
		return notify_fail("你要读什么？\n");
	cat("/doc/map/pingding");
	if( this_player()->query("maps/pingding") )
		return 1;
	this_player()->set("maps/pingding", 1);
	this_player()->save();
	return 1;
}


