inherit ROOM;

void create ()
{
  set ("short", "客店");
  set ("long", @LONG

客店里有两张大桌子，八把木椅，墙边还有两条长长的条凳，
供行人歇脚。店后面有一柜台，上面摆着一些小吃之类的食
品。店北临街，不时有客进出。墙上贴着一幅地图(map)。

LONG);

  set("exits", ([
        "north"   : __DIR__"xiaojie5",
      ]));
  set("objects", ([
        __DIR__"npc/dianzhu"   : 1,
      ]));
  set("valid_startroom",1);

  setup();
}

void init()
{
	add_action("do_read","read");
}

int do_read(string arg)
{
	if ( !arg || arg != "map" )
		return notify_fail("你要读什么？\n");
	cat("/doc/map/jinping");
	if( this_player()->query("maps/jinping") )
		return 1;
	this_player()->set("maps/jinping", 1);
	this_player()->save();
	return 1;
}

