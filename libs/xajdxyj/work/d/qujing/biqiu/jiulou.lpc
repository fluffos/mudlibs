inherit ROOM;

void create() {
  set("short", "酒楼");
  set("long", @LONG

酒楼里摆着几张桌子，上面有几碟小菜几盘炒豆。柜台上放着
几坛老酒，香气扑鼻令人垂涎。屋角有一木炭烤架，架子上的
肉熏得紫红紫红。一边墙上挂着一幅青绿山水图(map)，甚是
好看。

LONG);

  set("exits", ([
    "southeast": __DIR__ "jie4",
  ]));
  set("objects", ([
    __DIR__ "npc/kanduli": 1,
  ]));
  setup();
}

void init() {
  add_action("do_read", "read");
}

int do_read(string arg) {
  if (!arg || arg != "map")
    return notify_fail("你要读什么？\n");
  cat("/doc/map/biqiu");
  if (this_player()->query("maps/biqiu"))
    return 1;
  this_player()->set("maps/biqiu", 1);
  this_player()->save();
  return 1;
}
