// room: /d/nuerguo/maowu.c

inherit ROOM;

void create ()
{
  set ("short", "茅屋");
  set ("long", @LONG

这是一间简陋的小茅屋。四壁以芦杆搭成，一边扯着张破布，上面画的
好像是幅地图(map)。屋内只有一些简单的生活用具。一位老婆婆倚门而
坐。以年龄看来似是摆渡老妇人的姐姐。
LONG);

  set("exits", ([ 
        "south" : __DIR__"westriver",
      ]));

  set("objects",([
        __DIR__"npc/oldwoman" : 1,
       ]));

  setup();
}

void init()
{
	add_action("do_read","read");
}

int do_read(string arg)
{
	if ( !arg || arg != "map" )
		return notify_fail("你要读什么？\n");
	cat("/doc/map/nuerguo");
	if( this_player()->query("maps/nuerguo") )
		return 1;
	this_player()->set("maps/nuerguo", 1);
	this_player()->save();
	return 1;
}





