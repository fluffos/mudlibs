inherit ROOM;

void create ()
{
  set ("short", "羊肉馆");
  set ("long", @LONG

一座沿街搭棚而建的羊肉馆，一群食客盘腿席地而坐，围着一圈陶
盆陶盘聚在一起撕着羊肉进餐。从里面的厨房里不断地传出阵阵羊
肉香味。梁上挂着张羊皮，看上面的图案像是幅地图(map)。

LONG);

  set("exits", ([
        "north"       : __DIR__"xi2",
      ]));

  set("objects", ([ 
    __DIR__"npc/laoban" : 1,
  ]));
  setup();
}

void init()
{
	add_action("do_read","read");
}

int do_read(string arg)
{
	if ( !arg || arg != "map" )
		return notify_fail("你要读什么？\n");
	cat("/doc/map/baoxiang");
	if( this_player()->query("maps/baoxiang") )
		return 1;
	this_player()->set("maps/baoxiang", 1);
	this_player()->save();
	return 1;
}
