//renshenguo-yuan.c
// FoF changed 99-11-4 12:48

inherit ROOM;

void create() {
  set("short", "人参果园");
  set("long", @LONG

好大的一遍人参果园！巨大的果树上吊着一枚枚令人垂涎欲滴的
人参果。只是不知道怎样才能弄将下来。据说这人参果娇贵无比，
要是乱摘一气什么都吃不上。
LONG);

  set("exits",
    ([  //sizeof() == 4
    ]));

  set("objects",
    ([  //sizeof() == 1
    ]));

  set("outdoors", "wuzhuang");

  setup();
}

void init() {
  call_out("zydx_appear", 2);
}

void zydx_appear() {
  object me, zhenyuan;
  string room, room_short;

  me = this_player();

  if (me->query_temp("used_huangtong_key") != 1)
    return;

  me->delete_temp("used_huangtong_key");
  switch (random(10)) {
    case 0:
    case 1:
    case 2:
      {
        room = __DIR__ "wangxian";
        room_short = "望仙台";
        break;
      }
    case 3:
    case 4:
    case 5:
      {
        room = __DIR__ "xunzhen";
        room_short = "寻真台";
        break;
      }
    case 6:
    case 7:
      {
        room = __DIR__ "renshenguo-yuan";
        room_short = "人参果园";
        break;
      }
    case 8:
    case 9:
      {
        room = __DIR__ "mudanting";
        room_short = "牡丹亭";
        break;
      }
  }
  message_vision("\n只听几声哈哈大笑，镇元大仙走了出来。\n", me);
  message_vision("镇元大仙说道：居然被你发现了。那我们就开个人参果大会吧！\n\n\n", me);

  if (!objectp(zhenyuan = present("zhenyuan daxian", environment(me)))) {  //if zhenyuan already here, we do not need creat another one.
    if (objectp(load_object(__DIR__ "chengyun")) && !zhenyuan = find_living("zhenyuan daxian"))
      zhenyuan = new(__DIR__ "npc/zhenyuan");
    zhenyuan->move(room);
    if (room_short != "人参果园") {
      message_vision("只见眼前一晃．．．\n\n", me);
      me->move(room);
    }
  }
  zhenyuan->start_renshen(room, room_short);
}
