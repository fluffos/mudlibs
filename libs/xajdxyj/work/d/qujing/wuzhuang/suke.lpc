inherit ROOM;

void create ()
{
   set ("short", "俗客坊");
   set ("long", @LONG

这里是供香客休息的俗客坊。左右平架着两张木板床。中间的墙上有一张
五庄观游园指南(map)。
LONG);

   set("exits", 
   ([ //sizeof() == 1
     "west" : __DIR__"shaoxiang",
   ]));

   set("objects", 
   ([ //sizeof() == 1
     __DIR__"npc/tieguaili" : 1,
   ]));


   set("outdoors", "wuzhuang");

   setup();
}

void init()
{
	add_action("do_read","read");
}

int do_read(string arg)
{
	if ( !arg || arg != "map" )
		return notify_fail("你要读什么？\n");
	cat("/doc/map/wzg");
	if( this_player()->query("maps/wzg") )
		return 1;
	this_player()->set("maps/wzg", 1);
	this_player()->save();
	return 1;
}
