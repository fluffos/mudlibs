// create by snowcat.c 12/8/1997

inherit ROOM;

void create ()
{
  set ("short", "石门");
  set ("long", @LONG

一个幽幽的门洞，洞顶上挂有一个石牌，上边刻着：九曲盘恒洞
五个大字，右边刻着一幅地图(map)。洞的西北边有一入口通向一
个大厅，东边有一通道通向餐厅。

LONG);

  set("exits", ([
        "east"   : __DIR__"can",
        "northwest"   : __DIR__"da",
        "southwest"   : __DIR__"shanlu10",
      ]));
  set("objects", ([
        __DIR__"npc/yao"  : 2,
      ]));

  setup();
}

void init()
{
	add_action("do_read","read");
}

int do_read(string arg)
{
	if ( !arg || arg != "map" )
		return notify_fail("你要读什么？\n");
	cat("/doc/map/zhujie");
	if( this_player()->query("maps/zhujie") )
		return 1;
	this_player()->set("maps/zhujie", 1);
	this_player()->save();
	return 1;
}


