inherit ROOM;

void create ()
{
  set ("short", "酒楼");
  set ("long", @LONG

酒楼里八仙桌摆了二九一十八张，十分豪华。酒楼临街的窗上
扎满了各色彩灯笼，象是有什么喜宴要在这里举办。酒楼的里
间厨房里飘来一阵烤乳猪的香味。墙上除了挂有几幅画之外，
还有一幅玉华县的地图(map)。

LONG);

  set("exits", ([
        "east"   : __DIR__"xiaojie3",
      ]));
  set("objects", ([
        __DIR__"npc/jiubao"  : 1,
      ]));

  setup();
}

void init()
{
	add_action("do_read","read");
}

int do_read(string arg)
{
	if ( !arg || arg != "map" )
		return notify_fail("你要读什么？\n");
	cat("/doc/map/yuhua");
	if( this_player()->query("maps/yuhua") )
		return 1;
	this_player()->set("maps/yuhua", 1);
	this_player()->save();
	return 1;
}
