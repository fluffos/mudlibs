// hill.c

inherit ROOM;

void create ()
{
  set ("short", "内堂");
  set ("long", @LONG

后殿中铜炉熏香，又有细廊通向两旁，细廊的一侧挂着一幅地图(map)。
殿后有一台，台中几个宫女正陪着龙婆观景。台外有一片花园，老梅吐
萼，遍地鹿苔。远处平林尽被烟雾笼罩。
LONG);

  set("objects", ([ /* sizeof() == 3 */
  __DIR__"npc/long9.lpc" : 1,
  __DIR__"npc/longpo" : 1,
  __DIR__"npc/gonge" : 2,
]));
  set("exits", ([ /* sizeof() == 4 */
  "south" : __DIR__"huayuan1.lpc",
  "north" : __DIR__"huayuan.lpc",
  "west" : __DIR__"inside3",
  "east" : __DIR__"yidao.lpc",
]));
  setup();
}

void init()
{
	add_action("do_read", "read");
}

int do_read(string arg)
{
	if ( !arg || arg != "map" )
		return notify_fail("你要读什么？\n");
	cat("/doc/map/longgong");
	if( this_player()->query("maps/longgong") )
		return 1;
	this_player()->set("maps/longgong", 1);
	this_player()->save();
	return 1;
}
