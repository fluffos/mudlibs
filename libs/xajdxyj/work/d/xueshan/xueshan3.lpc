inherit ROOM;

int reset_maze();
void create ()
{
   set ("short", "茫茫雪峰");
   set ("long", @LONG

北风呼啸，飞雪茫茫，四面望去均是绵延不尽的雪峰。天地之间
似已毫无生迹，除了雪还是雪。
LONG);

   //set("item_desc", ([" *** " : " *** \n", ]));
   //for look something.

   set("exits", 
   ([ //sizeof() == 4
     "southeast" : __DIR__"xueshan2",
     "north" : __DIR__"snowmaze1",
   ]));
   
   set("outdoors", "xueshan");

   setup();
}

void init()
{
   reset_maze();
}

int reset_maze()
{
	switch ( random(3) ) //随机变换 3 * 3 的迷宫形状
	{
		case 0:
		__DIR__"snowmaze8"->set("exits/north", __DIR__"snowmaze4");
		__DIR__"snowmaze5"->set("exits/east", __DIR__"snowmaze7");
		__DIR__"snowmaze7"->set("exits/west", __DIR__"snowmaze5");
		__DIR__"snowmaze4"->set("exits/south", __DIR__"snowmaze8");

		__DIR__"snowmaze2"->set("exits/north", __DIR__"snowmaze6");
		__DIR__"snowmaze8"->set("exits/east", __DIR__"snowmaze6");
		__DIR__"snowmaze1"->set("exits/west", __DIR__"snowmaze6");
		__DIR__"snowmaze7"->set("exits/south", __DIR__"snowmaze6");
	
		__DIR__"snowmaze5"->set("exits/north", __DIR__"snowmaze9");
		__DIR__"snowmaze2"->set("exits/east", __DIR__"snowmaze9");
		__DIR__"snowmaze4"->set("exits/west", __DIR__"snowmaze9");
		__DIR__"snowmaze1"->set("exits/south", __DIR__"snowmaze9");
		break;

		case 1:
		__DIR__"snowmaze8"->set("exits/north", __DIR__"snowmaze3");
		__DIR__"snowmaze5"->set("exits/east", __DIR__"snowmaze3");
		__DIR__"snowmaze7"->set("exits/west", __DIR__"snowmaze3");
		__DIR__"snowmaze4"->set("exits/south", __DIR__"snowmaze3");

		__DIR__"snowmaze2"->set("exits/north", __DIR__"snowmaze7");
		__DIR__"snowmaze8"->set("exits/east", __DIR__"snowmaze1");
		__DIR__"snowmaze1"->set("exits/west", __DIR__"snowmaze8");
		__DIR__"snowmaze7"->set("exits/south", __DIR__"snowmaze2");
	
		__DIR__"snowmaze5"->set("exits/north", __DIR__"snowmaze9");
		__DIR__"snowmaze2"->set("exits/east", __DIR__"snowmaze9");
		__DIR__"snowmaze4"->set("exits/west", __DIR__"snowmaze9");
		__DIR__"snowmaze1"->set("exits/south", __DIR__"snowmaze9");
		break;

		case 2:
		__DIR__"snowmaze8"->set("exits/north", __DIR__"snowmaze3");
		__DIR__"snowmaze5"->set("exits/east", __DIR__"snowmaze3");
		__DIR__"snowmaze7"->set("exits/west", __DIR__"snowmaze3");
		__DIR__"snowmaze4"->set("exits/south", __DIR__"snowmaze3");

		__DIR__"snowmaze2"->set("exits/north", __DIR__"snowmaze6");
		__DIR__"snowmaze8"->set("exits/east", __DIR__"snowmaze6");
		__DIR__"snowmaze1"->set("exits/west", __DIR__"snowmaze6");
		__DIR__"snowmaze7"->set("exits/south", __DIR__"snowmaze6");
	
		__DIR__"snowmaze5"->set("exits/north", __DIR__"snowmaze1");
		__DIR__"snowmaze2"->set("exits/east", __DIR__"snowmaze4");
		__DIR__"snowmaze4"->set("exits/west", __DIR__"snowmaze2");
		__DIR__"snowmaze1"->set("exits/south", __DIR__"snowmaze5");
		break;
	}
	return 1;
}

