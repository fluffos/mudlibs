// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */
 
// caiyaoren.c

inherit NPC;
void create()
{
     set_name("采药人", ({ "caiyao ren" }) );
     set("gender", "男性" );
     set("age", 48);
     set("per", 20);
     set("shen", 5);
     set("long", "一位满面风霜的采药人。\n");
     set("combat_exp", 40000);
     set("attitude", "friendly");
     set("env/wimpy", 70);
     set_skill("unarmed", 50);
     set_skill("dodge", 50);
     set("chat_chance",4);
     set("chat_msg",({
        "采药人叹到：不少人进了雪山迷宫，就再也走不出来了，唉！\n",
        "采药人面带喜色道：大雪山可是个大药仓！\n",
       }));
     set("inquiry", ([
"name": "我叫什么名字？我独自采了四十年的药，很少有人陪我说话，我连自\n己叫什么都忘了。\n",
"here": "这里是大雪山。不少人为了得到冰山雪莲，误入雪山迷宫，就再也走\n不出来了，悲哉！\n",
"冰山雪莲": "冰山雪莲可是种好药材，对滋阴养颜有奇效！\n",
"雪莲": "冰山雪莲可是种好药材，对滋养容颜有奇效！\n",
"雪山迷宫": "我在这一带呆了四十年，雪山迷宫也去过，只要不迷路，就有希\n望走出来。\n",
"迷路": "如果看到雪地上有人的脚印，可千万别高兴，那说不定就是你自己的\n脚印。\n",
       ]) );

     setup();
     add_money("silver", 2);
     carry_object("/d/obj/cloth/buxie")->wear();
     carry_object("/d/obj/cloth/choupao")->wear();
}

