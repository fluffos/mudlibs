// xuelian.c 冰山雪莲
// FoF 修改 (09/28/1999)

#include <ansi.h>
inherit ITEM;

void init();
void eat();

void create()
{
   set_name("冰山雪莲",({"xue lian", "xuelian", "lian"}));
   set_weight(20);
   if (clonep())
     set_default_object(__FILE__);
   else {
     set("long", "一朵雪莲花，只生长于绝峰极寒之处。\n");
     set("unit", "朵");
     set("value", 800);
       }
   setup();
}

void init()
{
   add_action("do_eat", "eat");
}

int do_eat(string arg)
{
	int gain;
	object who = this_player();

   if( !this_object()->id(arg) ) return 0;

   if( who->is_busy() )
       return notify_fail("你上一个动作还没有完成。\n");

   if(!arg) return 0;

   if ( (int)who->query("max_atman")>0)
   {
     message_vision(RED "$N吃下一朵雪莲花，忽觉一阵反胃，又尽数吐了出来。\n" NOR, who);
   } 
   else 
   { 
     if(who->query("gender")=="男性")
     	message_vision(GRN "$N吃下一朵雪莲花，看起来精神多了。\n" NOR, who);
     else
     	message_vision(GRN " $N吃下一朵雪莲花，脸显酡红，倍增娇艳。\n" NOR, who);
	 gain = 40 - who->query("con") + random(30);
	 if ( who->query("eat_xuelian") >= 1000 )
	 	gain /= 5;
	 if ( (int)who->query("eat_xuelian")/100 < (int)(who->query("eat_xuelian")+gain)/100 )
	 	if ( who->query("per") < 30 )
	 		who->add("per", 1);
     who->add("eat_xuelian", gain);
   }   
   destruct(this_object());
   return 1;
}

