// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

inherit ROOM;
#include <ansi.h>

void create()
{
	set("short", "西长安街");
	set("long", @LONG
你走在一条宽阔的现代化街道上，路两旁有绚丽多彩的小花圃，还
有郁郁葱葱的树木；再向东便是天安门广场；北面是中国文化的明珠—
—故宫，高高的红色宫墙，精妙绝伦的角楼和宫殿隐约可见；南面是一
处游乐园，一些小男孩和小女孩在家人的呵护下，快快乐乐的在那里玩
耍。

LONG
	);
    set("exits",([
		"east":__DIR__"center",
    	"west":__DIR__"west2",
	]));
	set("no_fight", "1");
	set("no_magic", "1");
	set("no_clean_up", 0);
	set("no_steal", "1");
	set("outdoors", "beijing");

	setup();
}

void init()
{
	add_action("block_cmd", "", 1);
}

int block_cmd(string arg)
{
	string *forbid_verb = ({ "fly", "order", "kill", "fight", "steal", "practice", "xiudao",
"exert", "cast", "meditate", "exercise", "perform", "jjf_bing", "ji", "curse", "teamkill",
"conjure", "check", });
	string verb = query_verb();
	if( member_array(verb, forbid_verb) != -1 ) return 1;
}

