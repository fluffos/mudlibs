// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

inherit ROOM;

void create()
{
	set("short", "东长安街");
	set("long", @LONG
你走在一条宽阔的现代化街道上，路两旁有绚丽多彩的小花圃，还
有郁郁葱葱的树木；再向西便是天安门广场；北面是中国文化的明珠
——故宫，在这里你已经可以渐次欣赏到故宫突出的美丽亭阁；南面
是一处大商场，人们在那里兴高采烈的购买自己所需要的物品。

LONG
	);
    set("exits",([
		"east":__DIR__"east2",
		"west":__DIR__"center",
	]));
	set("no_fight", "1");
	set("no_magic", "1");
	set("no_clean_up", 0);
	set("no_steal", "1");
	set("outdoors", "beijing");

	setup();
}

void init()
{
	add_action("block_cmd", "", 1);
}

int block_cmd(string arg)
{
	string *forbid_verb = ({ "fly", "order", "kill", "fight", "steal", "practice", "xiudao",
"exert", "cast", "meditate", "exercise", "perform", "jjf_bing", "ji", "curse", "teamkill",
"conjure", "check", });
	string verb = query_verb();
	if( member_array(verb, forbid_verb) != -1 ) return 1;
}

