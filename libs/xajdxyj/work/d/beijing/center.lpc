inherit ROOM;
#include <ansi.h>

void create()
{
	set("short", HIG"长安街中心"NOR);
	set("long", @LONG
这里便是十里长安街的中心，来来往往的车辆与兴高采烈的人们在
这里川流不息，向南看去就是万人瞩目的天安门广场，北边则是雄伟高
大的天安门城楼。这里到出扬溢着一种盛大节日的热烈气氛，华夏儿女
迎来了他们可爱祖国的五十华诞。

LONG
	);
	
	set("exits",([
		"east" : __DIR__"east1",
		"west" : __DIR__"west1",
		"south" : __DIR__"guangchang",
		"northup" : __DIR__"chenlou",
	]));
    set("objects", ([
		__DIR__"npc/lingling" : 1,
		__DIR__"npc/obj/box" : 1,
    ]));
	set("no_fight", "1");
	set("no_magic", "1");
	set("no_clean_up", 0);
	set("no_steal", "1");
	set("outdoors", "beijing");

	setup();
}

void init()
{
	add_action("block_cmd", "", 1);
}

int block_cmd(string arg)
{
	string *forbid_verb = ({ "fly", "order", "kill", "fight", "steal", "practice", "xiudao",
"exert", "cast", "meditate", "exercise", "perform", "jjf_bing", "ji", "curse", "teamkill",
"conjure", "check", });
	string verb = query_verb();
	if( member_array(verb, forbid_verb) != -1 ) return 1;
}

