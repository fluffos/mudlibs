//guangchang.c
//迎接澳门回归祖国升旗仪式
//FoF 99-12-14 20:07

#include <ansi.h>
inherit ROOM;

private int ready;
private int start;
private int line;
string *str;
mixed msgs = ({
  CYN "你掂起脚尖看了看，人真多！大家都是来看升旗的。时间：6:56，快到了！\n" NOR,
  CYN "不远处传来了一阵整齐的脚步声。“快开始了！”\n大家精神为之一震，纷纷站起来翘首以盼庄严的升旗仪式。\n" NOR,
  CYN "国旗班迈着整齐坚定的步伐来到了广场中心，啪的一声站齐了。\n" NOR,
  CYN "主旗手护旗手出列，轻轻地把一面鲜艳的五星红旗挂上旗杆。
广场静了下来。你心中一阵激动，不由的站直了。\n" NOR,
  HIR "　　一轮红日正从东方冉冉生起，一片红光穿过城楼檐角掩照过来。\n" NOR,
  "\n",
});
string *forbid_verb = ({ "fly", "order", "kill", "fight", "steal", "practice", "study",
  "xiudao", "exert", "cast", "bian", "meditate", "exercise", "perform", "jjf_bing", "surrender",
  "wield", "ji", "curse", "teamkill", "conjure", "find", "drop", "get", "follow", "mount",
  "destroy", "check", "whistle" });

void start_shengqi();
void pre_show(int);
void start();
void show(object);
void finish();

void create() {
  set("short", HIG "天安门广场" NOR);
  set("long", @LONG

　　这是华夏儿女心中的圣地——天安门广场。每天早上都有人来这里
观看升旗仪式。这里长宽俱有二十余丈长，广场中央高高耸立着人民英
雄纪念碑(monument)。四周则星罗棋布散布着各式雄伟建筑。古代宫殿
的红砖黄瓦于现代建筑的宏伟壮丽在在这里交相辉映，更显出中华文民
的灿烂辉惶。广场北边隔着长安街是天安门城楼，南边是毛主席纪念馆，
东西两边是革命历史博物馆和人民大会堂。
　　今逢澳门回归祖国，天安门广场更显神圣而庄严，华夏儿女将在她
的怀抱里庆祝这极度喜庆的日子。

LONG);

  set("item_desc", ([ "monument": "　　这是一座用花岗岩筑就的高大纪念碑，正面有毛主席草书：" + HIY + "“人民
英雄永垂不朽”" + NOR + "八个金光闪闪的大字，背面是周总理手书纪念英雄之文
篇。底座四周雕刻有八幅栩栩如生的浮雕，分别是：" + HIR + "虎门销烟，三原里
人民抗英，五四运动，毛主席在安源，武昌起义，卢沟桥事变，三大战
役，百万雄师过大江。\n\n" + NOR ]));

  set("exits", ([  //sizeof() == 4
  "north": __DIR__ "center",
    "west": __DIR__ "dahuitang",
    "east": __DIR__ "bowuguan",
    "south": __DIR__ "jinianguan",
  ]));

  set("objects", ([  //sizeof() == 1
  __DIR__ "npc/guard": 2,
    //		__DIR__"obj/monument" : 1,
    __DIR__ "npc/obj/qigan": 1,
  ]));

  set("no_fight", 1);
  set("no_magic", 1);
  set("outdoors", "beijing");
  set("no_clean_up", 1);
  setup();
}

void init() {
  object who = this_player();
  add_action("block_cmd", "", 1);
  if (start == 1 && userp(who)) {
    who->set_temp("channels", who->query("channels"));
    who->delete("channels");
    if (!who->query("env/block_tell"))
      who->set_temp("env/block_tell", "NO");
    who->set("env/block_tell", "YES");
    show(who);
  }
}

int block_cmd(string arg) {
  string verb;
  verb = query_verb();
  if (verb == "update") return 0;
  if (verb == "call") return 0;
  if (start == 1) {
    tell_object(this_player(), "升旗仪式期间请保持安静。\n");
    call_out("show", 0, this_player());
    return 1;
  } else if (ready == 1 && (verb == "go" || verb == "east" || verb == "south" || verb == "west" || verb == "north")) {
    tell_object(this_player(), "难得来看一次升旗，就这么走啦？\n");
    return 1;
  }
  if (member_array(verb, forbid_verb) != -1) return 1;
}

void start_shengqi() {
  int i;
  object *list;

  ready = 1;
  list = all_inventory();
  for (i = 0; i < sizeof(list); i++) {
    if (!userp(list[i])) continue;
    list[i]->set_temp("channels", list[i]->query("channels"));
    list[i]->delete("channels");
    if (!list[i]->query("env/block_tell"))
      list[i]->set_temp("env/block_tell", "NO");
    list[i]->set("env/block_tell", "YES");
  }

  call_out("pre_show", 5, 0);
  return;
}

void pre_show(int i) {
  object qishou, room = this_object();
  if (i == 2) {
    qishou = new(__DIR__ "npc/qishou");
    qishou->move(room);
    qishou = new(__DIR__ "npc/qishou");
    qishou->move(room);
    qishou = new(__DIR__ "npc/qishou");
    qishou->move(room);
  }

  tell_room(this_object(), msgs[i]);
  i++;
  if (i < sizeof(msgs))
    call_out("pre_show", 5, i);
  else start();
  return;
}

void start() {
  int i;
  start = 1;
  set_temp("start", 1);
  str = explode(read_file(__DIR__ "words"), "\n");
  for (i = 0; i < 28; i++)
    tell_room(this_object(), str[i] + "\n");
  line = i;
  call_out("show", 3, this_object());
}

void show(object who) {
  if (who != this_object()) {
    if (line < sizeof(str)) {
      for (int i = 0; i < line; i++)
        tell_object(who, str[i] + "\n");
    } else call_out("finish", 3);
    return;
  } else {
    if (line < sizeof(str)) {
      tell_room(this_object(), str[line] + "\n");
      line++;
      call_out("show", 2, this_object());
    } else call_out("finish", 3);
    return;
  }
}

void finish() {
  object *list = all_inventory();
  if (start == 0) return;
  start = 0;
  ready = 0;
  set_temp("start", 0);
  for (int i = 0; i < sizeof(list); i++) {
    if (!userp(list[i])) continue;
    list[i]->set("year2000/shengqi", 1);
    if (list[i]->query_temp("channels")) {
      list[i]->set("channels", list[i]->query_temp("channels"));
      list[i]->delete_temp("channels");
    }
    if (list[i]->query_temp("env/block_tell") == "NO")
      list[i]->delete("env/block_tell");
    list[i]->delete_temp("env/block_tell");
  }
  list = children(__DIR__ "npc/qishou");
  tell_room(this_object(), "升旗仪式结束了。\n国旗班护旗手迈着整齐的正步离去。\n");
  for (int i = 0; i < sizeof(list); i++)
    destruct(list[i]);
}
