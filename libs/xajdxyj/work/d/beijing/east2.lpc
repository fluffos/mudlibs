// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

inherit ROOM;

void create() {
  set("short", "长安街东");
  set("long", @LONG
你走在一条宽阔的现代化街道上，西边就快到天安门广场了；北面
是玉带河，隔着又高又长的宫墙，远方露出了故宫的亭阁；南面是一座
摩天大厦，用来接待各地的游客们；前边是宽敞的停车场，还有一个美
丽的大喷泉。来往的人们都是喜气洋洋，被北京的迷人风景深深吸引着。

LONG
  );
  set("exits", ([
    "west": __DIR__ "east1",
  ]));
  set("no_fight", "1");
  set("no_magic", "1");
  set("no_clean_up", 0);
  set("no_steal", "1");
  set("outdoors", "beijing");

  setup();
}

void init() {
  add_action("block_cmd", "", 1);
}

int block_cmd(string arg) {
  string *forbid_verb = ({ "fly", "order", "kill", "fight", "steal", "practice", "xiudao",
    "exert", "cast", "meditate", "exercise", "perform", "jjf_bing", "ji", "curse", "teamkill",
    "conjure", "check", });
  string verb = query_verb();
  if (member_array(verb, forbid_verb) != -1) return 1;
}
