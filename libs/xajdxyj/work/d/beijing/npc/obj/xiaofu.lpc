#include <ansi.h>
#include <armor.h>
inherit CLOTH;

void create()
{
    set_name( WHT"校服"NOR, ({ "xiao fu", "xiaofu" }) );
    set_weight(1000);
    if( clonep() )
        set_default_object(__FILE__);
    else {
        set("long", "一件洁白整齐的校服。\n");
        set("unit", "件");
        set("value", 1000);
        set("material", "cloth");
        set("armor_prop/armor", 10);
    }
    setup();
}

