// 神话世界·西游记版本４．５０
/* <SecCrypt CPL V3R05> */

// box.c 功德箱

#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIR "希望工程捐款箱" NOR, ({ "juankuan xiang", "box", "xiang" }));
  set_weight(300000000);
  set_max_encumbrance(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "小女孩做的一个纸糊的捐款箱，上面歪歪扭扭地写着：
大哥哥大姐姐们，人人献爱心给希望工程！\n");
    set("value", 1000);
    set("material", "wood");
    set("no_get", 1);
    set("no_drop", 1);
    set("amount", 30);
  }
  setup();
}
