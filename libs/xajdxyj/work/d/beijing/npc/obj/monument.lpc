// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

// monument.c 人民英雄纪念碑

#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIW "人民英雄纪念碑" NOR, ({ "monument", "memorial", "bei" }));
  set_weight(300000000);
  set_max_encumbrance(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "座");
    set("long", "　　这是一座用花岗岩筑就的高大纪念碑，正面有毛主席草书：" HIY "“人民
英雄永垂不朽”" NOR "八个金光闪闪的大字，背面是周总理手书纪念英雄之文
篇。底座四周雕刻有八幅栩栩如生的浮雕，分别是：" HIR "虎门销烟，三原里
人民抗英，五四运动，毛主席在安源，武昌起义，" HIR "卢沟桥事变，三大战
役，百万雄师过大江。" NOR);
    set("value", 10);
    set("material", "stone");
    set("no_get", 1);
    set("no_drop", 1);
    set("amount", 1);
  }
  setup();
}
