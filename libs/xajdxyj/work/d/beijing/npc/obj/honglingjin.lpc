/* <SecCrypt CPL V3R05> */

#include <ansi.h>
#include <armor.h>
inherit NECK;

void create() {
  set_name(HIR "红领巾" NOR, ({ "hong lingjin", "jin" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一条鲜艳的红领巾，在阳光下散发出青春的色彩。\n");
    set("unit", "条");
    set("value", 100);
    set("material", "cloth");
    set("armor_prop/armor", 5);
  }
  setup();
}
