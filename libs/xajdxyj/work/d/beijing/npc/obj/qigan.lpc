// qigan.c 旗杆

#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIW "旗　杆" NOR, ({ "qi gan", "qigan" }));
  set_weight(300000000);
  set_max_encumbrance(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("long", "一根用金属制成的旗杆，鲜艳的五星红旗在旗杆顶端迎风飘扬。\n");
    set("value", 10);
    set("material", "iron");
    set("no_get", 1);
    set("no_drop", 1);
    set("amount", 1);
  }
  setup();
}
