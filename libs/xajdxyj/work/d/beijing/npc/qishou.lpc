// qishou.c

#include <ansi.h>
inherit NPC;

private int do_shengqi();
void create()
{
	set_name("护旗手", ({ "qi shou", "qishou", "guard" }));
	set("long", "一名国旗班的战士。\n");
	set("gender", "男性");
	set("title", HIY"国旗班"NOR);
	set("age", 20);
	set("attitude", "friendly");

	set("per", 30);
	set("int", 99);

	set("combat_exp", 20000);
	set_skill("unarmed", 50);
	set_skill("dodge", 50);
	set_skill("literate", 50);

	setup();

}

int accept_fight(object who)
{
	return notify_fail("护旗手说道：这位" + RANK_D->query_respect(who) + "请自重！\n");
}

