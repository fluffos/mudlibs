#include <ansi.h>

inherit NPC;

void create() {
  set_name("卫　士", ({ "wei shi", "weishi", "guard" }));
  set("long", "一名国旗班的战士。\n");
  set("gender", "男性");
  set("title", HIY "国旗班" NOR);
  set("age", 20);
  set("attitude", "friendly");

  set("per", 30);
  set("int", 99);

  set("combat_exp", 20000);
  set_skill("unarmed", 50);
  set_skill("dodge", 50);
  set_skill("literate", 50);

  setup();
}

int accept_fight(object who) {
  return notify_fail("卫士说道：这位" + RANK_D->query_respect(who) + "请自重！\n");
}
