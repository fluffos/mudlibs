#include <ansi.h>
inherit F_MASTER;

inherit NPC;

void greeting(object);
int accept_object(object, object);
int test_player();
void select(string, object);

void create() {
  set_name("小玲玲", ({ "ling ling", "lingling" }));
  set("long", "
一位可爱的小学生，带着一条鲜艳的红领巾，一副天真活泼的样子。
据说巫师把庆祝澳门回归祖国的礼物给了她，你可以问一问。\n");
  set("title", HIY "少先队员" NOR "戴" HIR "红领巾" NOR "的");
  set("gender", "女性");
  set("age", 12);
  set("attitude", "friendly");
  set("per", 30);
  set("int", 100);
  set("spi", 30);
  set("str", 999);
  set("combat_exp", 5000);
  set_skill("unarmed", 10);
  set("inquiry", ([
    "name": "大家都叫我小玲玲。",
    "礼物": (: test_player() :),
    "澳门回归": "为了庆祝澳门回归祖国，我有好好的礼物要送给大家，猜猜是什么？",
    "新年": "新年马上就要到了，你高兴吗？",
    "新年礼物": "新年礼物呀，现在还没到新年呢。",
  ]));
  set("chat_chance", 5);
  set("chat_msg", ({
    "小玲玲向你敬了个礼。\n",
    "小玲玲对你说：大家都来庆祝澳门回归祖国，你也来呀！\n",
    "小玲玲对你俏皮的笑了笑。\n",
    "小玲玲自言自语：“新年到了，山区里的小朋友们在干什么呢？”\n",
    "小玲玲邹着眉头说：“新年到了，山区的小朋友们在干什么呢？”\n",
    "小玲玲对你说：“大家都给希望工程捐点款吧！\n",
    "小玲玲对你说：节日快乐！\n",
    "小玲玲拿着书念到：祖国祖国，我爱你！\n",
    "小玲玲西西的笑着说：巫师要发礼物拉！\n",
    "小玲玲撇着小嘴,好象生谁的气啦。\n",
    "小玲玲托着下巴喃喃到：“没书读的孩子真可怜！”",
    "小玲玲说：快到冬天了，山区的小朋友们怕不怕冷？\n",
    "小玲玲高兴的问你说：你看过升国旗仪式么？\n",
  }));

  setup();
  carry_object(__DIR__ "obj/xiaofu")->wear();
  carry_object(__DIR__ "obj/honglingjin")->wear();
  add_money("coin", 10);
  add_money("silver", 1);
}

int accept_object(object who, object ob) {
  string name;
  object new_ob;
  if (!who || environment(who) != environment()) return 0;

  if (!objectp(ob)) return 0;

  if (!present(ob, who)) {
    tell_object(who, "你要给人家什么东西？\n");
    return 0;
  }
  if (ob->query("material") == "cloth") {
    tell_object(who, "小玲玲高兴地对你说：您真好心，小朋友们会很高兴的！\n小玲玲向你敬了个礼！\n");
    write("玲玲把" + ob->query("name") + "叠好了放在捐款箱边上。\n");
    who->set("year2000/donated", 1);
  } else if (ob->query("material") == "book") {
    tell_object(who, "小玲玲高兴地对你说：您真好心，小朋友们能读书啦！\n小玲玲向你敬了个礼。\n");
    write("玲玲把书放在捐款箱边上。\n");
    who->set("year2000/donated", 1);
  } else if (ob->query("money_id") == "silver" || ob->query("money_id") == "coin"
    || ob->query("money_id") == "gold") {
    tell_object(who, "小玲玲嘻嘻地对你笑了笑，说：是给希望工程的吧！\n");
    tell_object(who, "小玲玲高兴地把你的钱放进了捐款箱。\n");
    who->set("year2000/donated", 1);
  } else if (ob->query("material") == "food") {
    write("小玲玲惊讶的说：这些吃的半路上会坏的。嗯，我回去问一下老师。\n");
    write("小玲玲向你道谢！\n");
    ob->move(who);
  } else {
    tell_object(who, "小玲玲对你说：给我这些干嘛？是捐给希望工程的么？\n");
    tell_object(who, "这些东西山区的小朋友们怎么用呀！\n小玲玲不收你的东西。\n");
    return 0;
  }
  return 1;
}

int test_player() {
  int i;
  object room, gift, gift1;
  mixed answer = ({
    "玲玲嘻嘻地笑了笑，给你扮了个鬼脸 :(\n",
    "玲玲撇着小嘴对你说，偏不给你，嘻嘻！",
    "玲玲笑着说：巫师说过啦，不捐款不去看升旗仪式不给礼物。\n",
    "玲玲笑着说：巫师说过啦，不捐款不去看升旗仪式不给礼物。\n",
    "玲玲对你说道：礼物是有的，不过……\n",
  });

  if ((int)this_player()->query("year2000/gift") >= 2) {
    if ((int)this_player()->query("year2000/ask_times") > 5) {
      message_vision(printf("小玲玲生气地说：大家来看看，%s这家伙老来骗我要礼物，讨厌！\n",
        this_player()->query("name")));
      tell_object(this_player(), "你羞得无地自容，恨不得地下裂开一条缝钻进去。\n");
      if (room = load_object("/d/beijing/west2"))
        this_player()->move(room);
      return 1;
    } else if (this_player()->query("year2000/ask_times") > 3) {
      tell_object(this_player(), "玲玲对你说道：你烦不烦呀！老来要礼物！\n");
      this_player()->add("year2000/ask_times", 1);
      return 1;
    } else {
      tell_object(this_player(), "玲玲对你说道：老师说要做诚实的好孩子，你怎么老来要礼物呀！\n");
      this_player()->add("year2000/ask_times", 1);
      return 1;
    }
    return 1;
  }
  if (this_player()->query("year2000/shengqi") != 1) {
    tell_object(this_player(), "玲玲说：大家都去参加升国旗仪式了，你怎么没去呀！\n");
    return 1;
  }
  if (this_player()->query("year2000/donated") != 1) {
    tell_object(this_player(), "玲玲说道：你这人呀没爱心，光知道要礼物。\n");
    return 1;
  }

  // give first gift ---- 国旗、国歌播放器、祖国之花
  i = random(3);
  gift1 = new(__DIR__ "gift/gift" + i);
  if (!this_player()->query("year2000/ask_book")) {  // 为选书者加入这个判断条件
    if (gift1->move(this_player())) {
      this_player()->add("year2000/gift", 1);
      message_vision(GRN "玲玲送给$N一个" + gift1->query("name") + "\n" NOR, this_player());
      tell_object(this_player(), "玲玲对你说到，还有呢。猜猜看是什么？\n\n");
    }
  }
  // give second gift ---- guo, wan, book
  if (this_player()->query("combat_exp") < 20000) {
    gift = new(__DIR__ "gift/guo");
    tell_object(this_player(), "玲玲又送了你一个" + gift->query("name") + "！\n");
    if (gift->move(this_player())) {
      gift->set("owner", this_player()->query("id"));
      gift->move(this_player());
      this_player()->add("year2000/gift", 1);
      this_player()->set("year2000/gift_name", gift->query("name"));
      this_player()->save();
    }
    return 1;
  } else if (this_player()->query("combat_exp") < 700001) {
    gift = new(__DIR__ "gift/wan" + random(1));
    tell_object(this_player(), "玲玲又送了你一个" + gift->query("name") + "！\n");
    if (gift->move(this_player())) {
      gift->set("owner", this_player()->query("id"));
      this_player()->add("year2000/gift", 1);
      this_player()->set("year2000/gift_name", gift->query("name"));
      this_player()->save();
    }
    return 1;
  } else if (this_player()->query("combat_exp") > 700000) {
    if (!this_player()->query("year2000/ask_book", 1)) {
      tell_object(this_player(), "玲玲又说道：巫师给了我一本《天书》，可以多学几级武功。我先说了，只能学一样噢！\n");
      tell_object(this_player(), "小玲玲问你：你要学什么技能呢？( q 暂时放弃 )\n");
      this_player()->set("year2000/ask_book", 1);
    } else {
      tell_object(this_player(), "小玲玲问你：想好了学什么技能？( q 暂时放弃 )\n");
    }
    input_to("select", this_player());
    return 1;
  }
}

void select(string skill, object me) {
  object gift;
  int skills;
  if (skill == "q") {
    tell_object(this_player(), "小玲玲嘟着小嘴说：回去想好了再来！\n");
    return;
  }
  if (!(skills = me->query_skill(skill, 1))) {
    tell_object(this_player(), "你不会这项技能！请重新输入：\n");
    input_to("select", me);
  } else {
    gift = new(__DIR__ "gift/book");
    if (gift->move(this_player())) {
      tell_object(this_player(), "“好拉，”小玲玲说道，“小心拿着，别丢了！\n");
      gift->set("owner", this_player()->query("id"));
      this_player()->add("year2000/gift", 1);
      this_player()->set("year2000/gift_name", "book");
      this_player()->set("year2000/book_skill", skill);
      this_player()->set("year2000/book_max_skills", skills + 5);
      this_player()->save();
    }
    return;
  }
}
