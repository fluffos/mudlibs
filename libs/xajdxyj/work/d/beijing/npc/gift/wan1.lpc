// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIG "九花玉露丸" NOR, ({ "wan" }));
  set_weight(100);

  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "巫师专用名药。");
    set("unit", "颗");
    set("value", 500);
    set("material", "wan");
    set("no_give", 1);
    set("no_drop", GRN "巫师送的礼物,扔了多可惜呀！\n" NOR);
    set("no_sell", GRN "卖不了几个铜板的！ :(\n" NOR);
  }
  setup();
}

void init() {
  add_action("do_eat", "eat");
  add_action("do_eat", "chi");
}

int do_eat(string arg) {

  int add_exp;
  object me, obj;
  me = this_player();
  obj = this_object();

  if (!arg && arg != "wan")
    return notify_fail("你要吃什么？\n");

  if (obj->query("owner") != me->query("id")) {
    tell_object(this_player(), HIR "乱吃别人的东西会坏肚子的！\n" NOR);
    return 0;
  }

  if ((me->query("guoqing/gift")) == 2) {
    tell_object(this_player(), RED "“唉！”半空中传来一声叹息。\n" NOR);
    me->set("force", 1);
    me->set("mana", 1);
    destruct(obj);
    me->save();
    return 1;
  }

  if (me->is_busy()) return notify_fail("一边练功一边吃东西，你可真会享受！\n");

  add_exp = 2000 + me->query("combat_exp") / 100;
  me->add("combat_exp", add_exp);
  me->set("guoqing/gift", 2);
  me->set("guoqing/gift_name", "wan1");
  me->set("guoqing/add_exp", add_exp);
  me->save();
  tell_object(this_player(), MAG "你一拿到九花玉露丸，就急不可待地吞了下去。\n
只听见你的肚子噼里啪啦的一阵乱响,吓了你一大跳。\n" NOR);
  destruct(obj);
  return 1;
}
