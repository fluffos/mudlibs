// 神话世界·西游记版本４．５０
/* <SecCrypt CPL V3R05> */
 
// lipao.c

inherit ITEM;
#include <ansi.h>

void create()
{
    set_name(HIY"国庆礼炮"NOR, ({ "li pao", "pao" }) );
    set_weight(350);
    if( clonep() )
     	set_default_object(__FILE__);
    else {
     	set("long", "这是一门制做精巧的国庆礼炮，你可以用(fire pao)点着它.");
     	set("unit", "门");
     	set("value", 50000);
     	set("material", "cloth");
     	set("no_give", 1);
     	set("no_drop", HIY"不会吧，国庆礼炮你都要扔！！！\n"NOR);
     	set("no_sell", "这你也要用来赚钱。\n"NOR);
    }
    setup();
}

void init()
{
        add_action("do_fire", "fire");
}

int do_fire(string arg)
{
    if(arg != "pao" && arg != "li pao" ) return 0;
	message_vision("$N点着了国庆礼炮。\n礼炮冲天而起。\n天空中散出了五十朵漂亮的礼花。\n",
		this_player());
    destruct(this_object());
	return 1;
}

