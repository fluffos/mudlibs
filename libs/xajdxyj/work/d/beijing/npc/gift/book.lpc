// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

inherit ITEM;
#include <ansi.h>

void create()
{
	set_name(HIR"天　书"NOR, ({ "tian shu", "tianshu", "book" }));
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "本");
		set("long", "一本包装精致的书。\n");
		set("material", "paper");
		set("value", 0);
        set("no_sell", 1);
	}
}

void init()
{
	add_action("do_yuedu", "read");
	add_action("do_yuedu", "yuedu");
}

int do_yuedu(string arg)
{
	object me = this_player(), book = this_object();

	int sen_cost, gain, max_skills, exp, lev;
	string skill;

	if( book->query("owner") != me->query("id") ) {
		return notify_fail("书不是你的，再教你你也不明白的啦。\n");
	}

	skill = me->query("year2000/book_skill");
	max_skills = me->query("year2000/book_max_skills");

	if( me->is_busy() )
	    return notify_fail("你现在忙着呢，还是等静下心来再读书吧！\n");

	if( me->is_fighting())
	    return notify_fail("临阵磨枪可来不及啦！\n");

	if( (int)me->query_skill(skill, 1) > max_skills ) {
		return notify_fail("你在这方面已经很有造诣，这本书不会让你长进多少。\n");
	}

	exp = (int)me->query("combat_exp");
	lev = (int)me->query_skill(skill, 1);
	if(exp*10 < lev*lev*lev)
		return notify_fail("你的道行不够，再怎么读也没用。\n");

	sen_cost = 10 + (40-(int)me->query_int()) + (35-(int)me->query_kar()) + (int)lev / 5;
	if( (int)me->query("sen") < sen_cost )
		return notify_fail("你现在头晕脑胀，该休息休息了。\n");
	me->receive_damage("sen", sen_cost);

	gain = (int)me->query_skill("literate", 1) / 5;
	gain += random(me->query("int"));
	gain += random(me->query_kar());
	if( gain < 0 ) gain = 0;

	me->improve_skill(skill, gain);

	tell_room(environment(me), me->name() + "正专心地研读" + book->query("name") + "。\n", me);
	tell_object(me, "你仔细钻研天书上的神秘文字，似乎有些心得。\n");

	return 1;
}

