// 神话世界·西游记版本４．５０
/* <SecCrypt CPL V3R05> */

inherit ITEM;
#include <ansi.h>

void create()
{
	set_name(HIY"宠物商店优惠卡"NOR, ({"card" }) );
	set_weight(100);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", YEL"一张金黄色的卡片，等宠物商店开了你可以凭这张卡购买你喜欢的小宠物"NOR);
		set("unit", "张");
		set("value", 5);
		set("material", "cloth");
		set("no_drop", 1);
		set("no_sell", 1);
		set("no_give", 1);
	}
	setup();
}

int query_autoload()
{
	this_object()->set("owner", this_player()->query("id"));
	return 1;
}
