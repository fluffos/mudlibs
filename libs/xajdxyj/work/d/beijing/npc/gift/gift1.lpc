// nationflower.c 祖国之花

inherit ITEM;
#include <ansi.h>

void create() {
  set_name(HIY "祖国之花" NOR, ({ "flower", "hua" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一束正在焕发着蓬勃生机，鲜艳美丽的祖国之花，你试着闻闻(smell)她。");
    set("unit", "束");
    set("value", 50000);
    set("material", "cloth");
    set("no_drop", HIY " 这样鲜艳的一束花咋能扔掉呢，你想了一下，又后悔了。！！！\n" NOR);
    set("no_sell", HIY "这样鲜艳的一束花咋忍心卖掉呢，你想了一下，又后悔了。\n" NOR);
    set("no_give", 1);
  }
  setup();
}

void init() {
  add_action("do_smell", "smell");
}

int do_smell(string arg) {
  object me = this_player();
  object hua = this_object();

  if (!arg && arg != "hua" && arg != "flower")
    return notify_fail("你要闻什么？\n");

  if (me->is_busy())
    return notify_fail("你正在忙着呢，没工夫享受花的芬芳。\n");
  me->set("eff_sen", (int)me->query("max_sen"));
  me->set("eff_kee", (int)me->query("max_kee"));
  me->set("food", (int)me->max_food_capacity());
  me->set("water", (int)me->max_water_capacity());
  message_vision(HIY "$N凑过去，优雅的闻了闻祖国之花。\n$N觉的精神好多了！
$N觉的浑身充满了力气！\n$N看起来和气多了！\n", me);
  if (me->query("max_sen") > me->query("sen"))
    me->add("sen", (int)me->query("max_sen") * 5 / 100);

  if (me->query("max_kee") > me->query("kee"))
    me->add("kee", (int)me->query("max_kee") * 5 / 100);
  if (me->query("bellicosity") > 200)
    me->add("bellicosity", -50);
  destruct(hua);
  return 1;
}
