// 神话世界·西游记版本４．５０
/* <SecCrypt CPL V3R05> */

// songplayer.c 国歌播放器

#include <ansi.h>
inherit ITEM;

void show_song(int i);

void create() {
  set_name(HIY "国歌播放器" NOR, ({ "singer", "player" }));
  set_weight(350);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一个国歌播放器，请用(play singer)播放国歌");
    set("unit", "个");
    set("value", 50000);
    set("material", "iron");
    set("no_drop", HIY "国歌是神圣的，国歌播放器是不容人贱踏的！！！\n" NOR);
    set("no_sell", HIY "爱国是无价的，您就这样将其出卖吗？\n" NOR);
  }
  setup();
}

void init() {
  add_action("do_play", "play");
}

int do_play(string arg) {
  object me = this_player();
  if (arg != "singer") return notify_fail("你要播放什么？\n");
  message_vision(HIY "$N打开了国歌播放器...\n" NOR, me);
  call_out("show_song", 1, 0);
  return 1;
}

void show_song(int i) {
  string *sing_msg = ({

    HIG "国歌播放器传出了雄壮的声音：\n" NOR,
    HIR "起来，不愿作奴隶的人们！\n" NOR,
    HIR "\n把我们的血肉，\n" NOR,
    HIR "\n筑成我们新的长城！\n" NOR,
    HIR "\n中华民族，到了\n" NOR,
    HIR "\n最危险的时候……\n" NOR,
    HIR "\n每个人被迫着发出最后的吼声！\n" NOR,
    HIR "\n起来！起来！起来！！\n" NOR,
    HIR "\n我们万众一心，\n" NOR,
    HIR "\n冒着敌人的炮火，\n" NOR,
    HIR "\n前进！前进！前进进！！！\n" NOR,
    "",
    HIG "\n一曲终了，人们还久久沉浸在国歌的高亢激昂中。\n",
  });

  tell_room(environment(environment(this_object())), sing_msg[i]);

  if (i > sizeof(sing_msg))
    return;
  i++;
  call_out("show_song", 1, i);
  return;
}
