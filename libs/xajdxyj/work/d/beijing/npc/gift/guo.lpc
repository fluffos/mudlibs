// 神话世界·西游记版本４．５０
/* <SecCrypt CPL V3R05> */

#include <ansi.h>
inherit ITEM;

void create()
{
   	set_name(HIG"人参果"NOR, ({"guo"} ));
   	set_weight(100);

   	if( clonep() )
     	set_default_object(__FILE__);
   	else {
     	set("long", "孙悟空偷来的人身果,形状怪怪的。");
     	set("unit", "颗");
     	set("value", 500);
     	set("material", "food");
     	set("no_drop", GRN"巫师送的礼物,扔了多可惜呀！\n"NOR);
     	set("no_sell", GRN"这倒是个挣钱的好办法。 :(\n"NOR);
		set("no_give",1);
    }
   	setup();
}

void init()
{
    add_action("do_eat", "eat");
    add_action("do_eat", "chi");
}

int do_eat(string arg)
{
	object me,obj;
	me = this_player();
	obj = this_object();

    if( !arg && arg != "guo" )
      	return notify_fail("你要吃什么？\n");

    if( obj->query("owner") != me->query("id") ) {
    	tell_object(this_player(),"不义之财，还是别贪为好！\n");
    	return 1;
	}

    if( (me->query("guoqing/gift")) == 2 ) {
    	tell_object(this_player(), HIC"你背过身忙把人身果放到嘴边，忽然半空中飞来一阵烟雾，
你还没反应过来，那人已经把果拿走了。\n"NOR);
    	me->set("force",0);
    	me->set("mana",0);
    	destruct(obj);
    	return 1;
	}

	if(me->is_busy()) return notify_fail("一边练功一边吃东西，你可真会享受！\n");

    me->add("max_force", 10 + me->query("kar"));
    me->add("max_mana", 10 + me->query("kar"));
	me->set("guoqing/gift", 2);
	me->set("guoqing/gift_name", "guo");
    tell_object(this_player(), GRN"你拿到果子想都不想就整个吞下去了，撇撇嘴对旁边的人说：刚才我吃的太快了，
还没吃出味道纳，恩，你的你的...\n"NOR);
	destruct(obj);
	return 1;
}

