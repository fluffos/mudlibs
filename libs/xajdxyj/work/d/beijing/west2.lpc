// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

inherit ROOM;

void create()
{
	set("short", "西长安街");
	set("long", @LONG
你走在一条宽阔的现代化街道上，路两旁栽种着绚丽多彩的小花圃，
还有郁郁葱葱的树木。东边就快到了可爱的天安门了，你可以看到天安
门城楼巍峨的身影耸立在面前。北面是玉带河，远方露出了故宫的亭阁。
南面是一家银行，来来往往的多是来自五湖四海的人们，显得热闹非凡。

LONG
       );
    set("exits",([
	    "east" : __DIR__"west1",
	    "down" : "/d/city/center",
	]));
	set("no_fight", "1");
	set("no_magic", "1");
	set("no_steal", "1");
	set("outdoors", "beijing");

	setup();
}

void init()
{
	add_action("block_cmd", "", 1);
}

int block_cmd(string arg)
{
	string *forbid_verb = ({ "fly", "order", "kill", "fight", "steal", "practice", "xiudao",
"exert", "cast", "meditate", "exercise", "perform", "jjf_bing", "ji", "curse", "teamkill",
"conjure", "check", });
	string verb = query_verb();
	if( member_array(verb, forbid_verb) != -1 ) return 1;
}

