#include <ansi.h>
inherit ROOM;

void start();
int block_cmd(string);
void show_msgs(int i);
int no;

mixed msgs = ({
  CYN "不远处传来了一阵整齐的脚步声。“快开始了！”\n大家精神为之一震，纷纷站起来翘首以盼庄严的升旗仪式。\n" NOR,

  CYN "国旗班迈着整齐坚定的步伐来到了广场中心，啪的一声站齐了。" NOR,

  CYN "主旗手护旗手出列，轻轻地把一面鲜艳的五星红旗挂上旗杆。
广场静了下来。你心中一阵激动，不由的站直了。" NOR,

  HIR "　　一轮红日正从东方冉冉生起，一片红光穿过城楼檐角掩照过来。\n" NOR,

  "",

  HIY "　　　　起来！" NOR,

  HIY "　　    不愿作奴隶的人们！" NOR,

  HIY "　　　　把我们的血肉" NOR,

  HIY "　　　　筑成我们新的长城！\n\n"
  HIR "　　五星红旗在朝阳下冉冉升起。" NOR,

  HIY "　　　　中华民族" NOR,

  HIY "        到了  最危险的时候！" NOR,

  HIY "　　　　每个人被迫着发出最后的吼声 ……" NOR,

  HIY "　　　　起来！  起来！  起来！！！" NOR,

  HIY "        我们万众一心，冒着敌人的炮火，" NOR,

  HIY "　　　　前进！  前进！  前进进！！！" NOR,

  "",

  "",

  HIY "　　　　起来！" NOR,

  HIY "　　    不愿作奴隶的人们！……" NOR,

  HIC "　　五星红旗迎风飘展，你仰望国旗，心中思思绪万千。\n" NOR,

  HIC "　　国旗在我心中！祖国在我心中！你紧紧的握住了拳头。\n" NOR,

  "",

  YEL "　　　　…… 冒着敌人的炮火   前进！  前进！  前进进！！！……" NOR,

  GRN "你从沉思中惊醒，抬头看了看，鲜艳的五星红旗已经高高伸到蓝天里，迎风飘扬。\n" NOR,

  GRN "升旗仪式结束了，“冒着敌人的炮火 前进！ 前进！前进进！！……”的歌声\n还在你脑海里回荡着。\n" NOR,

});

void create() {
  set("short", HIR "天安门广场" NOR);
  set("long", @LONG
这是华夏儿女心中的圣地--天安门广场。这里长宽俱有二十余丈长，
广场中央高高耸立着人民英雄纪念碑。四周则星罗棋布散布着各式雄伟建
筑。古代宫殿的红砖黄瓦于现代建筑的宏伟壮丽在在这里交相辉映，更显
出中华文民的灿烂辉惶。
    今日实逢国庆五十周年大典。天安门广场更显神圣而庄严，华夏儿女
将在她的怀抱里庆祝这极度喜庆的日子。
    广场北边是天安门城楼，南边是毛主席纪念馆，东西两边是人民大会
堂与革命历史博物馆。

LONG);

  set("exits", ([
    "north": __DIR__ "road5",
    "west": __DIR__ "dahuitang",
    "east": __DIR__ "guan2",
    "south": __DIR__ "guan1",
  ]));

  set("objects", ([  //sizeof() == 4
  //        __DIR__"obj/bei" : 1,
  //        __DIR__"obj/qigan" : 1,
  //        __DIR__"npc/guard" : 2,
  ]));
  set("start_shengqi", 0);
  set("no_cleanup", 1);
  set("out_door", __DIR__);
  setup();
}

void init() {
  add_action("block_cmd", "", 1);
}

int block_cmd(string args) {
  string verb;
  verb = query_verb();

  if (verb == "xiudao") return 1;
  if (verb == "exert") return 1;
  if (verb == "kill") return 1;
  if (verb == "fight") return 1;
  if (verb == "steal") return 1;
  if (verb == "practice") return 1;
  if (verb == "study") return 1;
  if (verb == "learn") return 1;
  if (verb == "fly") return 1;
  if (verb == "cast") return 1;
  if (verb == "ji") return 1;
  if (verb == "exercise") return 1;
  if (verb == "meditate") return 1;
  if (verb == "go")
    if (query("start_shengqi") == 1) {
      tell_object(this_player(), "难得看一次国旗，就这样走了？\n");
      return 1;
    } else return 0;
}

void start() {
  int i, k;
  string *tuned_ch;
  object room, me, qishou, *who;

  room = this_object();

  set("start_shengqi", 1);
  tell_room(room, CYN "你掂起脚尖看了看，人真多！大家都是来看升旗的。时间：6:56，快到了！\n");
  qishou = load_object(__DIR__ "npc/qishou");
  qishou->move(room);

  who = all_inventory(room);
  no = 0;
  for (k = 0; k < sizeof(who); k++) {
    me = who[k];
    tuned_ch = me->query("channels");
    if (pointerp(tuned_ch) && member_array("chat", tuned_ch) != -1)
      tuned_ch -= ({ "chat" });
    if (pointerp(tuned_ch) && member_array("rumor", tuned_ch) != -1)
      tuned_ch -= ({ "rumor" });
    me->set("channels", tuned_ch);
    me->set("env/block_tell", 1);
    me->set("channel/tell_block", time() + 120);
    me->set("guoqing/shengqi", 1);
  }
  call_out("show_msgs", 3, 0);
  return;
}

void show_msgs(int i) {
  int k;
  string *tuned_ch;
  object room, me, qishou, *who;

  room = this_object();
  no = i + 1;
  if ((no - 1) < sizeof(msgs)) {
    tell_room(room, "\n" + msgs[no - 1] + "\n");
    call_out("show_msgs", 2, no);
    return;
  }
  who = all_inventory(room);
  for (k = 0; k < sizeof(who); k++) {
    me = who[k];
    tuned_ch = me->query("channels");
    if (pointerp(tuned_ch) && member_array("chat", tuned_ch) == -1)
      tuned_ch += ({ "chat" });
    if (pointerp(tuned_ch) && member_array("rumor", tuned_ch) == -1)
      tuned_ch += ({ "rumor" });
    me->set("channels", tuned_ch);
    me->delete("env/block_tell");
  }
  set("start_shengqi", 0);
}
