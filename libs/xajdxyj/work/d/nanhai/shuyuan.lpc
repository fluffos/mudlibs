// Room: /d/nanhai/shuyuan
inherit ROOM;

void create() {
  set("short", "书院");
  set("long", @LONG

这里就是普陀山书院，书架上摆着无数书籍，墙上挂着一幅地
图(map)。普陀山门人弟子中有来提高基本读书识字的，更多的
是来钻研佛经修练佛法的，以期早日修得正果。
LONG);

  set("exits", ([ /* sizeof() == 1 */
    "east": __DIR__ "zoulang",
  ]));
  set("objects", ([ /* sizeof() == 3 */
    "/d/obj/book/san.lpc": 1,
    "/d/obj/book/jingang": 1,
    __DIR__ "npc/shami": 1,
  ]));
  set("light_up", 1);

  setup();
}

void init() {
  add_action("do_read", "read");
}

int do_read(string arg) {
  if (!arg || arg != "map")
    return notify_fail("你要读什么？\n");
  cat("/doc/map/putuo");
  if (this_player()->query("maps/putuo"))
    return 1;
  this_player()->set("maps/putuo", 1);
  this_player()->save();
  return 1;
}
