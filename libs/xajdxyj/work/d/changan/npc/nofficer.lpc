// changan/npc/nofficer.c
// made by FoF (09/28/1999)

inherit NPC;
void announce (object me, string str);
int check_legal_name(string name);

void create()
{
   set_name("赵钱孙", ({"zhao qiansun", "zhao"}));
   set("title", "户管所所长");
   set("gender", "男性");
   set("age", 45);
   set("per", 25);
   set("kee", 800);
   set("max_kee", 800);
   set("sen", 200);
   set("max_sen", 200);
   set("combat_exp", 50000);
   set("attitude", "friendly");
   set("chat_chance", 5);
   set("chat_msg", ({
   "赵所长嘿嘿嘿地笑了几声：我这把算盘几十年来可从来没错过。\n",
   "赵所长骄傲的说道：虽说我是个小小的所长，可是人人都喜欢我。\n谁家生了个小孩都来找我给起名字。\n"
   "赵所长傻笑了几声：呵呵...呵呵...\n",
   "赵所长叹道：这年头！真正文化修养高的人可不多啊！\n",
}));
   set("inquiry",([
   "all": "来找我的都是天生爹妈没给起好名字的。你要问点什么？\n名字(name)\n改名字(rename)\n费用(prize)",
   "name": "你要改名字吗？",
   "名字": "你要改名字吗？",
   "rename": "你总共可以改三次名字。如果你要改，请使 apply rename 新名字。",
   "改名字": "你总共可以改三次名字。如果你要改，请使 apply rename 新名字。",
   "费用": "第一次改名字要交50两黄金手续费，第二次交100两，第三次交200两。",
   "prize": "第一次改名字要交50两黄金手续费，第二次交100两，第三次交200两。",
]));
   set_skill("unarmed", 100);
   set_skill("dodge", 100);
   set_skill("literate", 100);
   set_skill("parry", 100);

   setup();
   carry_object("/d/ourhome/obj/choupao")->wear();
   add_money("gold", 2);
}


void init()
{
	add_action("do_rename", "apply");
}

int do_rename(string arg)
{
	object who = this_player();
           if(!userp(who))return 1;
	if ( !arg )
		return notify_fail("赵所长说道：请用 apply rename 新名字 来申请改名字。\n");
	if ( !sscanf(arg, "rename %s", arg) )
		return notify_fail("赵所长说道：申请改名字请用 apply rename 新名字 。\n");
	if ( !LOGIN_D->check_legal_name(arg) )
		return notify_fail("另起一个吧。\n");
	if ( !who->query("name1") )  {
		if ( who->query("balance") < 500000 )
			return notify_fail("赵所长说道：这里使用银行转账，你银行的存款不够。\n");
		who->set("name1", who->query("name"));
		who->add("balance", -500000);
	} else if ( !who->query("name2") )  {
		if ( who->query("balance") < 1000000 )
			return notify_fail("赵所长说道：这里使用银行转账，你银行的存款不够。\n");
		who->set("name2", who->query("name"));
		who->add("balance", -1000000);
	} else if ( !who->query("name3") )  {
		if ( who->query("balance") < 2000000 )
			return notify_fail("赵所长说道：这里使用银行转账，你银行的存款不够。\n");
		who->set("name3", who->query("name"));
		who->add("balance", -2000000);
	} else return notify_fail("赵所长说道：你已经改过三次名字，不能再改了。\n");

	announce(this_object(), who->query("name")+"("+who->query("id")+")从现在起改名为"+arg+"，特此公告！\n");
    log_file("nosave/changename", geteuid(who)      //goat add at 1999.10.24
         + "  change name from  " + who->name() + " to " + arg + "  at  " + ctime(time()) + "\n" );
  
	who->set("name", arg);
	who->save();

	return 1;
}

void announce (object me, string str)
{
     CHANNEL_D->do_channel(me,"xyj",str);
}

