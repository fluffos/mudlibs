// whistle.c
// 呼唤坐骑
// by FoF@Happy
// last modified 00-5-15

#define ZUOQI "/obj/npc/zuoqi"
inherit F_CLEAN_UP;

int find_allzuoji(string str);

int main(object me)
{
   object zuoqi, *zuoqis;
   int i;

   if( random(2) )
      message_vision("$N撅起嘴巴吹了一声口哨：～～～～～！\n", me);
   else
      message_vision("$N吹了一声很响很响的口哨：～～～～～～～！\n", me);
   
   if( !me->query("zuoqi/id") || !me->query("zuoqi/name") )
       return 1;
   
   if( zuoqi = present(me->query("zuoqi/id"), me) )
      if( zuoqi->is_zuoqi() && zuoqi->query("owner_id") == me->query("id") ) {
         write(zuoqi->name() + "躺在你的怀里睡着了。\n");
         return 1;
      }
   
   if( zuoqi = present(me->query("zuoqi/id"), environment(me)) )
      if( zuoqi->is_zuoqi() && zuoqi->query("owner_id") == me->query("id") ) {
         message_vision("$N听到口哨声，欢快地蹦了一下。\n", zuoqi);
         return 1;
      }
   
   // find zuoqi
   zuoqis = children(ZUOQI);
   if( sizeof(zuoqis) )
      for( i = 0; i < sizeof(zuoqis); i ++ )
         if( zuoqis[i]->query("owner_id") == me->query("id") ) {
         	if( time() - zuoqis[i]->query("last_die") < 300 )
         	   return notify_fail("你的坐骑正正在投胎转世中！\n");
            
            remove_call_out("appear");
            call_out("appear", 1 + random(3), zuoqis[i], me);
            return 1;
         }
   
   zuoqi = new(ZUOQI);
   zuoqi->set("owner_id", me->query("id"));
   if( !zuoqi->restore() )
      return notify_fail("您的坐骑存档出了些问题，请通知管理员处理。\n");
   
   zuoqi->initialize();
   if( time() - zuoqi->query("last_die") < 300 )
      return notify_fail("你的坐骑正正在投胎转世中！\n");
   
   remove_call_out("appear");
   call_out("appear", 1 + random(3), zuoqi, me);
   return 1;
}

int appear(object ob, object me)
{
   if( ob && me )
      ob->move_to(me);
}

int help(object me)
{
    write(@HELP

指令格式：whistle

此指令可让你呼唤自己的坐骑，当然首先你必须得有属于自己的坐骑。

HELP
   );
   return 1;
}

