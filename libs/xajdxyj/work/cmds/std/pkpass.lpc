// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */
 
// suicide.c
// modified by FoF 00-3-16

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
   if( me->is_busy() )
      return notify_fail("你上一个动作还没完成。\n");

   if( me->query("pkpass") )
      return notify_fail("你的pk执照已经打开了。\n");
       

   if( arg != "open" ) 
      return notify_fail(" 你要打开你的pk执照吗？请用pkpass open \n");

   write(HIW "如果你选择打开pk执照的话，你将步入另外一个江湖，请务必\n"
 "考虑清楚，一旦打开,将不能关闭.确定的话请输入您的密码：" NOR);
   input_to("check_password", 1, me, 2);
   return 1;
}

private void check_password(string passwd, object me, int forever)
{
   object link_ob;
   string old_pass;

   link_ob = me->query_temp("link_ob");
   old_pass = link_ob->query("password");
   if( ! old_pass ) old_pass = "(*%&$%^!";

   if( crypt(passwd, old_pass) != old_pass ) {
      write("密码错误！\n");
      return;
   }

   if( forever ) {
      tell_object( me,
         HIR "\n\n你决定打开你的pk执照。\n\n\n" NOR);
      me->set("pkpass",1);
      CHANNEL_D->do_channel(me,"xyj", "我打开了pk执照，哈哈哈哈哈哈哈哈哈!别惹我!!!\n"NOR, 0);

   log_file( "pk_pass_log", sprintf("(%s)%s 打开了pk执照.\n", ctime(time()), me->query("id")));
   }
}


int help (object me)
{
   write(@HELP
指令格式: pkpass [open]
 
用这个命令可以打开pk执照，打开以后可以参与pk与被pk.
默认为关闭状态。
pk执照关闭的时候,被玩家pk不会降任何东西，但不能pk其他玩家。
pk执照一旦打开将不能被关闭，请慎重选择 :-)
 
HELP
);
   return 1;
}

