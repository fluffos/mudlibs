// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

// follow.c
#include <ansi.h>
inherit F_CLEAN_UP;
int leave_here(string arg, object ob);

int main(object me, string arg) {
  object ob;
  mapping exits;
  string *dirs;
  int size;
  object env = environment(me);

  if (!arg) return notify_fail("指令格式：drive <妖怪的id>。\n");



  if (!objectp(ob = present(arg, environment(me))))
    return notify_fail("这里没有 " + arg + "。\n");

  if (!ob->is_character())
    return notify_fail("你要驱赶什么? \n");

  if (ob == me)
    return notify_fail("你要驱赶你自己？\n");
  if (!ob->query("yguai")) return notify_fail("这不是妖怪.\n");
  if (ob->query_temp("killername") != (string)me->query("id") &&
    ob->query("killer_id") != (string)me->query("id"))
    return notify_fail("这不是你的妖怪.\n");
  message_vision(HIW "$N大喝一声,$n,看你往哪里逃!$n吓得拔腿就跑.\n" NOR, me, ob);



  if (!mapp(exits = environment(me)->query("exits"))) return 1;
  dirs = keys(exits);
  size = sizeof(dirs);
  if (size > 0) ob->command_function("go " + dirs[random(size)]);
  return 1;
}





int help(object me) {
  write(@HELP
指令格式 : drive [妖怪id]
 
这个指令让你能驱赶妖怪。
 
HELP
  );
  return 1;
}
