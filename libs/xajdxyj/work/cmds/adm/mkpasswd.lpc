// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */
 
// mkpasswd.c
// 生成一个随机密码
// FoF 00-6-28

int main(object me, string arg)
{
    int i, j;
    string passwd = "ASDFGHJK";
    
    i = 7 + random(2); // passwd 长度在 7->8 位之间
    for( j == 0; j < i; j ++ ) {
        passwd[j] = '1' + random(73);
    }
    
    // 密码的第一个字符不要用 '!' 号
    if( passwd[0] == '!' ) passwd[0] ++;
    
    write("\n" + passwd + "\n");
    
    return 1;
}

int help(object me)
{
	write(@HELP

指令格式: mkpasswd

生成一个长度在 7-8 位之间的随机密码。

HELP );
	return 1;
}

