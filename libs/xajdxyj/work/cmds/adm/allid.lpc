// all account
// for check dodge skills

int main(object me, string arg) {
  object *list, link_ob;

  list = users();
  for (int i = sizeof(list) - 1; i >= 0; i--) {
    if (list[i]->query_temp("apply/dodge") > 100) write(list[i]->short() + "\n");
  }
  return 1;
}
