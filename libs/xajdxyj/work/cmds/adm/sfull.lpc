//by moonsky

//full.c

int main(object me, string arg)

{
  object obj;
  if (!arg || arg == "me") {
    me->set("eff_kee", me->query("max_kee"));
    me->set("kee", me->query("max_kee"));
    me->set("eff_sen", me->query("max_sen"));
    me->set("sen", me->query("max_sen"));
    me->set("food", (int)me->max_food_capacity() * 3 + random(120));
    me->set("water", (int)me->max_water_capacity() * 3 + random(120));

    me->set("force", me->query("max_force") * 2 - 10);
    me->set("mana", me->query("max_mana") * 2 - 10);
    me->clear_condition();
    write("ok!\n");
    return 1;
  }
  obj = present(arg, environment(me));
  if (!obj) obj = present(arg, me);
  if (!obj) obj = find_player(arg);
  if (!obj || !me->visible(obj)) obj = find_object(resolve_path(me->query("cwd"), arg));

  if (!obj) return notify_fail("找不到指定的物件。\n");
  //    if(obj!=me)return notify_fail("你不能设定别人的状态。\n");

  obj->set("eff_kee", obj->query("max_kee"));
  obj->set("kee", obj->query("max_kee"));
  obj->set("eff_sen", obj->query("max_sen"));
  obj->set("sen", obj->query("max_sen"));
  obj->set("food", (int)obj->max_food_capacity() * 3 + random(120));
  obj->set("water", (int)obj->max_water_capacity() * 3 + random(120));

  obj->set("force", obj->query("max_force") * 2 - 10);
  obj->set("mana", obj->query("max_mana") * 2 - 10);
  obj->clear_condition();
  write("ok!\n");
  return 1;
}
