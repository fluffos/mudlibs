// 检测玩家数据是否存在错误
// 包括登录、档案、法宝、坐骑、邮件、房屋等物件
// FoF@Happy 00-3-5 9:18
// 这个程序专为欢乐园设计，如果要转到其它MUD使用，请作相应的修改
// 程序运行时系统资源消耗很大，特别是在线玩家很多的时候

#include <ansi.h>
inherit F_CLEAN_UP;

void check_login(int count, string *dir, int i, object me);
void check_user(int count, string *dir, int i, object me);
void check_fabao(int count, string *dir, int i, object me);
void check_zuoqi(int count, string *dir, int i, object me);
void check_mail(int count, string *dir, int i, object me);
void check_home(int count, string *dir, int i, object me);

int main(object me, string arg) {
  string *dir;

  if (!wizardp(me)) return notify_fail("你没有权力使用这个指令。\n");

  seteuid(getuid());
  switch (arg) {
    case "login":
      write("寻找登录存档有错误的的使用者：\n");
      dir = get_dir(DATA_DIR + "login/");
      call_out("check_login", 0, 0, dir, 0, me);
      break;
    case "user":
      write("寻找存档有错误的的使用者：\n");
      dir = get_dir(DATA_DIR + "user/");
      call_out("check_user", 0, 0, dir, 0, me);
      break;
    case "fabao":
      write("寻找法宝存档有错误的的使用者：\n");
      dir = get_dir(DATA_DIR + "fabao/");
      call_out("check_fabao", 0, 0, dir, 0, me);
      break;
    case "zuoqi":
      write("寻找坐骑存档有错误的的使用者：\n");
      dir = get_dir(DATA_DIR + "toy/");
      call_out("check_zuoqi", 0, 0, dir, 0, me);
      break;
    case "mail":
      write("寻找邮件存档有错误的的使用者：\n");
      dir = get_dir(DATA_DIR + "mail/");
      call_out("check_mail", 0, 0, dir, 0, me);
      break;
    default:
      write("请使用：    checkbad login   寻找登录存档有错误的的使用者
            checkbad user    寻找存档有错误的的使用者
            checkbad fabao   寻找法宝存档有错误的的使用者
            checkbad zuoqi   寻找坐骑存档有错误的的使用者
            checkbad mail    寻找邮件存档有错误的的使用者\n");
      return 1;
  }
  return 1;
}

void check_login(int count, string *dir, int i, object me) {
  object ob;
  int j, len;
  string *ppls, id, info, info2, err;

  if (i == sizeof(dir)) {
    tell_object(me, "共有" HIR + chinese_number(count) + NOR "位使用者登录档案有错。\n");
  } else {
    ppls = get_dir(DATA_DIR + "login/" + dir[i] + "/");
    tell_object(me, dir[i] + "\n");
    for (j = 0; j < sizeof(ppls); j++) {
      reset_eval_cost();  // 防止循环过深而中止程序运行
      if (sscanf(ppls[j], "%s.a.o", id) == 1) continue;  // 略过自动备份文件
      if (sscanf(ppls[j], "%s.t.o", id) == 1) continue;  // 略过临时文件
      if (sscanf(ppls[j], "%s.o", id) == 1) {
        /*
                info = read_file(DATA_DIR + "login/" + dir[i] + "/" + ppls[j]);
                len = strlen(info);
                if( len < 100 || !sscanf(info, "#/obj/login.c%s", info2) || info[len-4..len-1] != "])\n" && info[len-3..len-1] != "])\n" && info[len-2..len-1] != "])" ) {
                    tell_object(me, "发现 "HIR + str + NOR" 档案有错！文件格式不对！\n");
                    count ++;
                    continue;
                }
*/
        ob = new(LOGIN_OB);
        ob->set("id", id);
        err = catch(call_other(ob, "restore"));
        if (err) {
          tell_object(me, "发现 " HIR + id + NOR " 登录档案有错！无法载入！\n");
          destruct(ob);
          count++;
          continue;
        }
        /*                if( ! ob->restore() ) {
                    tell_object(me, "发现 "HIR + id + NOR" 登录档案有错！无法载入！\n");
                    destruct(ob);
                    count ++;
                    continue;
                }
*/
        if (!ob->query("id") || ob->query("id") != id) {
          tell_object(me, "发现 " HIR + id + NOR " 登录档案有错！帐号与存档文件不符！\n");
          destruct(ob);
          count++;
          continue;
        }
        destruct(ob);
      }
    }
    i++;
    call_out("check_login", 0, count, dir, i, me);
  }
}

void check_user(int count, string *dir, int i, object me) {
  object ob;
  int j;
  string *ppls, id, err;

  if (i == sizeof(dir)) {
    tell_object(me, "共有" HIR + chinese_number(count) + NOR "位使用者档案有错。\n");
  } else {
    ppls = get_dir(DATA_DIR + "user/" + dir[i] + "/");
    tell_object(me, dir[i] + "\n");
    for (j = 0; j < sizeof(ppls); j++) {
      reset_eval_cost();  // 防止循环过深而中止程序运行
      if (sscanf(ppls[j], "%s.oo.o", id) == 1) continue;  // 略过备份文件
      if (sscanf(ppls[j], "%s.a.o", id) == 1) continue;  // 略过自动备份文件
      if (sscanf(ppls[j], "%s.t.o", id) == 1) continue;  // 略过临时文件
      if (sscanf(ppls[j], "%s.o", id) == 1) {
        ob = new(USER_OB);
        ob->set("id", id);
        err = catch(call_other(ob, "restore"));
        if (err) {
          tell_object(me, "发现 " HIR + id + NOR " 档案有错！无法载入！\n");
          destruct(ob);
          count++;
          //                    rename(DATA_DIR + "user/" + dir[i] + "/" + ppls[j], "/data/bad/user/" + ppls[j]);
          continue;
        }
        if (!ob->query("id") || ob->query("id") != id) {
          tell_object(me, "发现 " HIR + id + NOR " 档案有错！帐号与存档文件不符！\n");
          destruct(ob);
          count++;
          //                    rename(DATA_DIR + "user/" + dir[i] + "/" + ppls[j], "/data/bad/user/" + ppls[j]);
          continue;
        }
        destruct(ob);
      }
    }
    i++;
    call_out("check_user", 0, count, dir, i, me);
  }
}

void check_fabao(int count, string *dir, int i, object me) {
  object ob;
  int j;
  string *ppls, id, no, err;

  if (i == sizeof(dir)) {
    tell_object(me, "共有" HIR + chinese_number(count) + NOR "位使用者档案有错。\n");
  } else {
    ppls = get_dir(DATA_DIR + "fabao/" + dir[i] + "/");
    tell_object(me, dir[i] + "\n");
    for (j = 0; j < sizeof(ppls); j++) {
      reset_eval_cost();  // 防止循环过深而中止程序运行
      if (sscanf(ppls[j], "%s-%s.oo.o", id, no) == 2) continue;  // 略过备份文件
      if (sscanf(ppls[j], "%s-%s.a.o", id, no) == 2) continue;  // 略过自动备份文件
      if (sscanf(ppls[j], "%s-%s.o", id, no) == 2) {
        ob = new("/obj/fabao");
        ob->set("owner_id", id);
        ob->set("series_no", no);
        err = catch(call_other(ob, "restore"));
        if (err) {
          tell_object(me, "发现 " HIR + id + "-" + no + NOR " 法宝档案有错！无法载入！\n");
          destruct(ob);
          count++;
          continue;
        }
        if (!ob->query("owner_id") || ob->query("owner_id") != id) {
          tell_object(me, "发现 " HIR + id + "-" + no +
            NOR " 法宝档案有错！帐号与存档文件不符！\n");
          destruct(ob);
          count++;
          continue;
        }
        destruct(ob);
      }
    }
    i++;
    call_out("check_fabao", 0, count, dir, i, me);
  }
}


void check_zuoqi(int count, string *dir, int i, object me) {
  object ob;
  int j, len;
  string *ppls, id, no, err;

  if (i == sizeof(dir)) {
    tell_object(me, "共有" HIR + chinese_number(count) + NOR "位使用者档案有错。\n");
  } else {
    ppls = get_dir(DATA_DIR + "toy/" + dir[i] + "/");
    tell_object(me, dir[i] + "\n");
    for (j = 0; j < sizeof(ppls); j++) {
      reset_eval_cost();  // 防止循环过深而中止程序运行
      if (sscanf(ppls[j], "%s_zuoqi.a.o", id) == 1) continue;  // 略过备份文件
      if (sscanf(ppls[j], "%s_zuoqi.a.o", id) == 1) continue;  // 略过自动备份文件
      if (sscanf(ppls[j], "%s_zuoqi.o", id) == 1) {
        ob = new("/obj/npc/zuoqi");
        ob->set("owner_id", id);
        err = catch(call_other(ob, "restore"));
        if (err) {
          tell_object(me, "发现 " HIR + id + NOR " 坐骑档案有错！无法载入！\n");
          destruct(ob);
          count++;
          continue;
        }
        if (!ob->query("owner_id") || ob->query("owner_id") != id) {
          tell_object(me, "发现 " HIR + id + NOR " 坐骑档案有错！帐号与存档文件不符！\n");
          destruct(ob);
          count++;
          continue;
        }
        destruct(ob);
      }
    }
    i++;
    call_out("check_zuoqi", 0, count, dir, i, me);
  }
}

int help(object me) {
  write(@HELP
请使用：checkbad login   寻找登录存档有错误的的使用者
        checkbad user    寻找存档有错误的的使用者
        checkbad fabao   寻找法宝存档有错误的的使用者
        checkbad zuoqi   寻找坐骑存档有错误的的使用者
        checkbad mail    寻找邮件存档有错误的的使用者
HELP
  );
  return 1;
}
