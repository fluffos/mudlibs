#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
   if(!arg)arg="...";
   message("vision", HIW "【系统通告】"+me->name()+"("+me->query("id")+"): "+arg+"\n"NOR, users());
	
   return 1;
}

int help(object me)
{
write(@HELP

用于向玩家公布系统的更新及维护信息.
HELP
    );
    return 1;
}
