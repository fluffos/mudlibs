// halt.c

#include "/doc/help.h"
inherit F_CLEAN_UP;

int main(object me, string arg) {
  object obj, *env;
  int i;

  if (!arg || arg == "me") {
    if (!me->is_fighting())
      return notify_fail("你现在并没有在战斗。\n");
    me->remove_all_killer();
    message_vision("$N用巫师的神力停止了这场打斗。\n", me);
    write("Ok.\n");
    return 1;
  }
  if (arg == "all") {

    env = all_inventory(environment(me));
    message_vision("$N大喊道：你们统统给我住手！\n", me);
    for (i = 0; i < sizeof(env); i++) {
      if (!env[i]->is_character()) continue;
      if (!env[i]->is_fighting()) continue;
      env[i]->remove_all_killer();
    }
    return 1;
  }
  obj = present(arg, environment(me));
  if (!obj) obj = present(arg, me);
  if (!obj) obj = find_player(arg);
  if (!obj || !me->visible(obj)) obj = find_object(resolve_path(me->query("cwd"), arg));

  if (!obj) return notify_fail("找不到指定的物件。\n");
  if (!obj->is_fighting())
    return notify_fail("该人现在并没有在战斗。\n");
  obj->remove_all_killer();
  message_vision("$N用巫师的神力停止了这场打斗。\n", me);
  write("Ok.\n");
  return 1;


}

int help(object me) {
  write(@HELP
指令格式: shalt <id>

可以停止所有与某人有关的战斗。
HELP
  );
  return 1;
}
