// checkalias.c
// 检查玩家的 alais 以验证身份、恢复密码、档案等

int main(object me, string arg) {
  object who;
  mapping alias;

  seteuid(getuid(me));

  if (me->query("id") != "moonsky") {
    write("你无权使用这个命令！\n");
    return 1;
  }
  if (!arg) return notify_fail("请指定要检查的玩家 id 。\n");

  if (who = find_player(arg)) {
    write(arg + " 正在连线中，不属于检查对象。\n");
    return 1;
  }

  who = new(USER_OB);
  who->set("id", arg);
  if (who && who->restore()) {
    alias = who->query_all_alias();
    write(who->short() + sprintf("定义的 alias 有：\n%O\n", alias));
    write("请选择 2 - 5 个适当的 alias 来提问。\n");
    log_file(
      "checkalias",
      sprintf("%s %s check %s's alias\n", ctime(time()), me->query("id"), arg)
    );
  } else {
    write("使用者 " + arg + "档案读取失败！\n");
  }

  destruct(who);

  return 1;
}
