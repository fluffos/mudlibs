#include <net/dns.h>
#include <mudlib.h>
#include <ansi.h>
#include <command.h>
inherit F_CLEAN_UP;
//发呆中。。。
#define IDLE HIR"@"NOR
//断线中...
#define NETDEAD HIY"#"NOR
//官匪。
//#define AUTH   HIR"*"NOR

int sort_user(object, object);
int sort_family(object, object);

void create() { seteuid(getuid()); }

mixed main(string arg) {
  mixed mud;
  string verbose;
  RWHO_Q->send_rwho_q(arg, this_player(), verbose);
  return "网路指令传送过程可能需要一些时间，请稍候。\n";
}
