/* <SecCrypt CPL V3R05> */
 
// xregpasswd.c
// ported to CCTX by JackyBoy@CuteRabbits Studio 1999/4/1
// FoF changed for Happy

#include <login.h>;
inherit F_CLEAN_UP;

void create()
{
    seteuid(getuid());
}

int main(object me, string arg)
{
    int len;
    object ob, link_ob;
    string id, password;
    
    if( me->query("id") != "fof" )
    	return notify_fail("这个指令是临时指令，只有 fof 能使用。\n");
    
    if( !arg || sscanf(arg, "%s %s", id, password) != 2 )
        return notify_fail("指令用法：xpasswd ID 新密码\n"
            "此操作容易损害玩家利益，你必须先调查清楚！\n");
    
    ob = find_player(id);

    // added by FoF  (10/14/1999)
    // 采用另一种加密方法，取密码的后8位，前面多输入的字符无效
    len = strlen(password);
    if( len > 8 )
        password = password[(len-8)..(len-1)];

    if( !ob ) {
        ob = new(LOGIN_OB);
        ob->set("id", id);
        if( !ob->restore() )
            return notify_fail("没有这个玩家。\n");
        else {                                    
            ob->set("reg_passwd", crypt(password, 0));
            tell_object(me, "玩家" + ob->query("id") + "(" + ob->query("name") +
                ")的注册密码已经更改为：" + password + "\n请务必记得用电子邮件通知该玩家。\n");
            log_file( "nosave/changepassword", sprintf("%s %s(%s)修改了%s(%s)的注册密码\n",
                ctime(time()), me->query("name"), me->query("id"),
                ob->query("name"), ob->query("id")));
            ob->save();
            destruct(ob);
            return 1;
        }
    }
    link_ob = ob->query_temp("link_ob");
    if( link_ob ) {
        link_ob->set("password", crypt(password, 0));
        link_ob->save();
        tell_object(me, "玩家" + ob->query("id") + "(" + ob->query("name") +
            "的注册密码已经更改为：" + password + "\n");
        log_file( "nosave/changepassword", sprintf("%s %s(%s)修改了%s(%s)的注册密码\n",
            ctime(time()), me->query("name"), me->query("id"),
            ob->query("name"), ob->query("id")));
        return 1;
    } else
        return notify_fail("错误！无法进行修改！\n");
    return 1;
}


int help(object me)
{
    write(@HELP
指令格式 : xregpasswd ID 新密码

这个指令可以修改玩家的注册密码，目的是为没有收到注册信的玩家
重新发送注册信。请谨慎使用，修改注册密码后一定要用电子邮件通
知玩家。

HELP
    );
    return 1;
}

