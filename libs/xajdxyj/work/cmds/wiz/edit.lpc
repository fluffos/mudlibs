// edit.c

#include "/doc/help.h"
#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string file)
{
	string file_name;
	if( !file ) return notify_fail("指令格式：edit <档名>\n");

	if( in_edit(me) ) return notify_fail("你已经在使用编辑器了。\n");

        seteuid(geteuid(me));
	file_name=resolve_path(me->query("cwd"), file);
        me->set("cwf",file_name);
	ed(file_name);
	
    // 这种信息用不着给玩家看的啦，只要互相交流就够了。
    CHANNEL_D->do_channel(me,"sys", "编辑了物件 "+file_name+" 的档案。\n"NOR, 0);

   log_file( "EDIT_LOG", sprintf("(%s)
%s edited %s\n", ctime(time()), me->query("name"), file_name));
	return 1;
}

int help(object me)
{
  write(@HELP
指令格式 : edit <档名>, edit here

利用此一指令可直接在线上编辑档案。
HELP
    );
    return 1;
}
