// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

// /cmds/usr/nick.c
// modified by FoF (09/28/1999)

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  int i;
  string str;

  if (!arg) return notify_fail("你要替自己取什么绰号？\n");

  if (arg == "none") {
    me->delete("nickname");
    return 1;
  }

  i = strlen(arg);
  while (i--) {
    if (arg[i] < ' ')
      return notify_fail("对不起，你的绰号不能用控制字元。\n");
  }

  str = arg;
  str = replace_string(str, "BLK", "");
  str = replace_string(str, "RED", "");
  str = replace_string(str, "GRN", "");
  str = replace_string(str, "YEL", "");
  str = replace_string(str, "BLU", "");
  str = replace_string(str, "MAG", "");
  str = replace_string(str, "CYN", "");
  str = replace_string(str, "WHT", "");
  str = replace_string(str, "HIR", "");
  str = replace_string(str, "HIG", "");
  str = replace_string(str, "HIY", "");
  str = replace_string(str, "HIB", "");
  str = replace_string(str, "HIM", "");
  str = replace_string(str, "HIC", "");
  str = replace_string(str, "HIW", "");
  str = replace_string(str, "NOR", "");
  str = replace_string(str, "BNK", "");

  str = replace_string(str, "BRED", "");
  str = replace_string(str, "BGRN", "");
  str = replace_string(str, "BYEL", "");
  str = replace_string(str, "BBLU", "");
  str = replace_string(str, "BMAG", "");
  str = replace_string(str, "BCYN", "");
  str = replace_string(str, "BWHT", "");

  i = strlen(str);
  if (i > 30)
    return notify_fail("你的绰号太长了，想一个短一点的、响亮一点的。\n");

  arg = replace_string(arg, "BLK", BLK);
  arg = replace_string(arg, "RED", RED);
  arg = replace_string(arg, "GRN", GRN);
  arg = replace_string(arg, "YEL", YEL);
  arg = replace_string(arg, "BLU", BLU);
  arg = replace_string(arg, "MAG", MAG);
  arg = replace_string(arg, "CYN", CYN);
  arg = replace_string(arg, "WHT", WHT);
  arg = replace_string(arg, "HIR", HIR);
  arg = replace_string(arg, "HIG", HIG);
  arg = replace_string(arg, "HIY", HIY);
  arg = replace_string(arg, "HIB", HIB);
  arg = replace_string(arg, "HIM", HIM);
  arg = replace_string(arg, "HIC", HIC);
  arg = replace_string(arg, "HIW", HIW);
  arg = replace_string(arg, "NOR", NOR);
  arg = replace_string(arg, "BNK", BLINK);

  str = replace_string(str, "BRED", BRED);
  str = replace_string(str, "BGRN", BGRN);
  str = replace_string(str, "BYEL", BYEL);
  str = replace_string(str, "BBLU", BBLU);
  str = replace_string(str, "BMAG", BMAG);
  str = replace_string(str, "BCYN", BCYN);
  str = replace_string(str, "BWHT", BWHT);

  me->set("nickname", arg + NOR);
  write("Ok.\n");
  return 1;
}
int help(object me) {
  write(@HELP
指令格式 : nick <外号, 绰号>
      nick none   取消

这个指令可以让你为自己取一个响亮的名号或头衔，你如果希望在绰号中
使用 ANSI 的控制字元改变颜色，可以用以下的控制字串：

BLK - [30m黑色[2;37;0m       NOR - [2;37;0m恢复正常颜色[2;37;0m
RED - [31m红色[2;37;0m       HIR - [1;31m亮红色[2;37;0m
GRN - [32m绿色[2;37;0m       HIG - [1;32m亮绿色[2;37;0m
YEL - [33m土黄色[2;37;0m     HIY - [1;33m亮黄色[2;37;0m
BLU - [34m深蓝色[2;37;0m     HIB - [1;34m亮蓝色[2;37;0m
MAG - [35m浅紫色[2;37;0m     HIM - [1;35m粉红色[2;37;0m
CYN - [36m蓝绿色[2;37;0m     HIC - [1;36m天青色[2;37;0m
WHT - [37m浅灰色[2;37;0m     HIW - [1;37m亮白色[2;37;0m
BRED [37m[41m红色背景[2;37;0m    BNK - [5m闪动字符[2;37;0m
BGRN [37m[42m绿色背景[2;37;0m
BYEL [37m[43m土黄色背景[2;37;0m
BBLU [37m[44m深蓝色背景[2;37;0m
BMAG [37m[45m浅紫色背景[2;37;0m
BCYN [37m[46m蓝绿色背景[2;37;0m
BWHT [47m浅灰色背景[2;37;0m

其中系统自动会在字串尾端加一个 NOR。

HELP
  );
  return 1;
}
/*
 HBRED [41;1m亮红色背景[2;37;0m
 HBGRN [42;1m亮绿色背景[2;37;0m
 HBYEL [43;1m亮黄色背景[2;37;0m
 HBBLU [44;1m亮蓝色背景[2;37;0m
 HBMAG [45;1m粉红色背景[2;37;0m
 HBCYN [46;1m天青色背景[2;37;0m
 HBWHT [47;1m亮白色背景[2;37;0m
*/
