// who.c
//by lion@hero
// modified by moonsky for Happy
#include <net/dns.h>
#include <mudlib.h>
#include <ansi.h>
#include <command.h>
inherit F_CLEAN_UP;
//发呆中。。。
#define IDLE HIR"@"NOR
//断线中...
#define NETDEAD HIY"#"NOR
//官匪。
//#define AUTH   HIR"*"NOR

int sort_user(object, object);
int sort_family(object, object);

void create() { seteuid(getuid()); }

mixed main(object me, string arg, int remote) {
  string str, name, *option;
  object *list;
  int i, j, ppl_cnt;
  int opt_long, opt_id, opt_family, opt_wiz;

  if (arg) {
    string verbose = "", rwho = "";
    option = explode(arg, " ");
    i = sizeof(option);
    while (i--)
      switch (option[i]) {
        case "-l": opt_long = 1; verbose += "-l "; continue;
        case "-w": opt_wiz = 1; verbose += "-w "; continue;
        default:
          return notify_fail("指令格式：who [-l|-w]\n");
      }
  }
  if ((opt_long) && !remote) {
    if ((int)me->query("sen") < 20)
      return notify_fail("你的精神太差了，没有办法得知其他玩家的详细资料。\n");
    me->receive_damage("sen", 10);
  }

#ifdef INTERMUD_NAME
  str = "★ " HIW + INTERMUD_NAME + NOR;
#else
  str = "★ " HIY + MUD_NAME + NOR;
#endif

  str += "\n─────────────────────────────────────\n";

  // Get a list of the visible user
  list = filter(users(), (: environment($1) && this_player()->visible($1) :));

  //    list = users();     
  //  list = sort_array(users(), (: sort_user :));
  ppl_cnt = 0;

  if (opt_long || opt_wiz) {

    list = sort_array(list, (: sort_family :));
    j = sizeof(list);
    while (j--) {
      if (remote && (list[j]->query("env/invisibility") && wizardp(list[j]))) continue;
      if (opt_wiz && (!wizardp(list[j]) || (string)wizhood(list[j]) == "(elder)")) continue;  //here won't show "elder" as wiz, added by weiqi.
      str = sprintf("%s%12s %s\n",
        str,
        RANK_D->query_rank(list[j]),
        list[j]->short()
      );
      str = replace_string(str, "$N", list[j]->query("name"));
      str = replace_string(str, "$n", me->query("name"));
      ppl_cnt++;
    }
  } else {
    list = sort_array(list, (: sort_user :));
    j = sizeof(list);
    while (j--) {
      if (remote &&
        list[j]->query("env/invisibility"))
        continue;

      //       if(list[j]->query("vendetta/authority"))
      //     str+=AUTH;
      //  else if(query_idle(list[j])>150)
      if (query_idle(list[j]) > 150)
        str += IDLE;
      else str += " ";
      //女性用红色，男性用黄色？       
      if (list[j]->query("gender") == "女性")
        name = list[j]->name(1) + "(" + HIM + capitalize(list[j]->query("id")) + NOR + ")";
      else
        name = list[j]->name(1) + "(" + HIY + capitalize(list[j]->query("id")) + NOR + ")";
      str = sprintf("%s%-25s%s", str, name,
        (ppl_cnt % 3 == 2 ? "\n" : (strlen(list[j]->name(1) + list[j]->query("id")) > 12 ? "\t" : "\t\t"))
      );

      //       str = sprintf("%s%s%-22s%s",
      //          str,stat,
      //          opt_id ? capitalize(list[j]->query("id")): (list[j]->name(1)+"("+list[j]->query("id")+")"),
      //          (ppl_cnt%3==2? "\n": "")
      //        );

      ppl_cnt++;
    }
    if (ppl_cnt % 3) str += "\n";
  }

  str += "─────────────────────────────────────\n";

  if (!remote || strlen(str) < 1024) {
    //don't add last two lines for remote who if it is too long.
    //small packets maybe arrived to remote machine out of order.
    str = sprintf("%s共有 %d 位使用者连线中，系统负担：%s\n", str, ppl_cnt,
      query_load_average());
    str += "注：" + HIR "@" NOR + "表示发呆中，紫色ID表示女性，黄色ID表示男性。\n";
  }

  if (remote) return str;

  me->start_more(str);
  return 1;
}
//按照玩家id的字母顺序排序。
//by lion@hero
int sort_user(object ob1, object ob2) {
  int i, id_str;
  string id1, id2;
  id1 = getuid(ob1);
  id2 = getuid(ob2);
  id_str = strlen(id1) < strlen(id2) ? strlen(id1) : strlen(id2);
  for (i = 0; i < id_str; i++) {
    if (id1[i] == id2[i]) continue;
    else if (id1[i] > id2[i]) return -1;
    else return 1;
  }
  return strlen(id2) - strlen(id1);
}
//按玩家门派排序。
int sort_family(object ob1, object ob2) {
  string name1, name2;
  if (wiz_level(ob1) != wiz_level(ob2))
    return wiz_level(ob2) - wiz_level(ob1);
  name1 = ob1->query("family/family_name");
  name2 = ob2->query("family/family_name");
  if (intp(name1)) name1 = "";
  if (intp(name2)) name2 = "";
  if (name1 > name2) return -1;
  if (name1 < name2) return 1;
  return (int)ob2->query("combat_exp") - (int)ob1->query("combat_exp");
}

int help(object me) {
  write(@HELP
指令格式 : who [-l|-w]

这个指令可以列出所有在线上的玩家及其等级。

-l        列出线上玩家的详细资料。
-w        只列出线上所有的巫师。

相关指令： finger
HELP
  );
  return 1;
}
