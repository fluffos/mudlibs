// prove.c
// Created by FoF 00-5-15
// 新手上路前必须找一个老手来证明：自己不是一个垃圾帐号

#include <ansi.h>

inherit F_CLEAN_UP;

int help(object me);

int main(object me, string arg) {
  object who;

  if (!arg) return help(me);

  who = find_player(arg);
  if (!who) return notify_fail("没有这个玩家！\n");

  if (who->query("prover") != me->query("id"))
    return notify_fail("你不是负责验证该玩家的人。\n");

  if (who->query("proved"))
    return notify_fail("该玩家已经通过了验证。\n");

  write("你确定" + who->short() + "不是一个垃圾帐号，而且\n"
    "不含有人身攻击的倾向吗？(Yes/No)");
  input_to("do_prove", who, me);

  return 1;
}

int do_prove(string yn, object who, object me) {
  object blocker;

  if (yn != "Yes") {
    write(who->short() + " 没有通过验证。\n");
    return 1;
  }

  me->command_function("xyj " + who->short() + " 加入" + MUD_NAME +
    "，我们又多了一个新朋友！");
  me->add("prove", ({ who->query("id") }));
  who->set("proved", 1);

  blocker = present("blocker", who);
  if (blocker) destruct(blocker);

  log_file("newbie_prove", sprintf("%s %s prove %s\n", ctime(time()),
    me->query("id"), who->short()));

  write("OK. 谢谢你的合作！\n");
  tell_object(who, HIW + me->short() + " 为你作保证，你现在可以正常参加游戏了。\n" + NOR);

  return 1;
}

int help(object me) {
  write(@HELP
指令格式：prove <id>

该指令用来验证新玩家的身份是否合法，如果姓名和帐号中存在人身
攻击的因素，或者根本就是一个垃圾帐号，将不允许参加游戏。
HELP
  );
  return 1;
}
