// map.c
// written by FoF

#include <ansi.h>
#define MAP_DIR "/doc/map/"
// inherit F_CLEAN_UP;
inherit F_DBASE;

void creat()  // FoF 00-5-21
{
  int i;
  mixed *files, *text;

  set("name", "地图精灵");
  set("id", "mapper");
  files = get_dir(MAP_DIR);
  i = sizeof(files);
  while (i--) {
    reset_eval_cost();
    if (file_size(MAP_DIR + files[i]) > 0) {
      text = explode(read_file(MAP_DIR + files[i]), "\n");
      set("/" + files[i], text);
    }
  }
}

int main(object me, string arg) {
  string *maps, text;
  int i;

  // initialize
  if (!query("/")) creat();

  if (!arg) {
    maps = keys(me->query("maps"));
    write(HIC "\n你目前能察看的地图有：\n\n" HIG);
    for (i = 0; i < sizeof(maps); i++)
      write(sprintf("%-15s%s", maps[i], i % 5 == 4 ? "\n" : ""));
    write("\n\n" NOR);
    me->more("first", query("/index"), 0);
    return 1;
  }


  if (text = query("/" + arg)) {
    if (me->query("maps/" + arg) != 1 && !wizardp(me))
      return notify_fail("你脑子里对那个地方没有印象。\n");
    me->more("first", text, 0);
  } else return notify_fail("你要看哪个地方的地图？\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式: map [someplace]

这个指令让你查看已知地区的地图。未知地区的地图要亲自到该地区取得，
一经阅读(read)就可以永远记住。

HELP
  );
  return 1;
}
