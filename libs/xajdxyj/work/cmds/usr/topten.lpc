// 神话世界·欢乐园·版本４．５０
/* <SecCrypt CPL V3R05> */

// topten.c (goat & FoF  10-26-1999)

#include <ansi.h>

int main(object me, string arg) {
  int i, j, code;
  string id, name, title, *paiming_list, output;
  string *top = ({
    HIY "   ΩΩΩΩΩΩΩ=    欢乐园十大富翁排行榜    =ΩΩΩΩΩΩΩ\n",
    HIG "   ♀♀♀♀♀♀♀=  欢乐园十大道行高手排行榜    =♀♀♀♀♀♀♀\n",
    HIR "   ※※※※※※※=    欢乐园十大魔头排行榜    =※※※※※※※\n",
    HIC "   ≈≈≈≈≈≈≈=    欢乐园十大老手排行榜    =≈≈≈≈≈≈≈\n",
    HIB "   〓〓〓〓〓〓〓   欢乐园十大悲情人物排行榜   〓〓〓〓〓〓〓\n",
    HIG "   ♀♀♀♀♀♀♀=  欢乐园十大内力高手排行榜    =♀♀♀♀♀♀♀\n",
    HIG "   ♀♀♀♀♀♀♀=  欢乐园十大法力高手排行榜    =♀♀♀♀♀♀♀\n",
  });
  string *middle = ({
    HIY "    ＄                                                    ＄\n",
    HIG "    ☆                                                    ☆\n",
    HIR "    ★                                                    ★\n",
    HIC "    §                                                    §\n",
    HIB "    △                                                    △\n",
    HIG "    ☆                                                    ☆\n",
    HIG "    ☆                                                    ☆\n",
  });
  string *bottom = ({
    HIY "   ΩΩΩΩΩΩΩΩΩΩΩΩΩΩΩΩΩΩΩΩΩΩΩΩΩΩΩΩΩ\n" NOR,
    HIG "   ♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂\n" NOR,
    HIR "   ※※※※※※※※※※※※※※※※※※※※※※※※※※※※※\n" NOR,
    HIC "   ≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈≈\n" NOR,
    HIB "   〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓\n" NOR,
    HIG "   ♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂\n" NOR,
    HIG "   ♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂♂\n" NOR,
  });
  string *str_left = ({
    HIY "    ＄ " HIM,
    HIG "    ☆ " HIY,
    HIR "    ★ " HIB,
    HIC "    § " YEL,
    HIB "    △ " MAG,
    HIG "    ☆ " HIY,
    HIG "    ☆ " HIY,
  });
  string *str_center = ({
    HIG,
    HIC,
    MAG,
    WHT,
    CYN,
    HIC,
    HIC,
  });
  string *str_right = ({
    HIY "＄\n",
    HIG "☆\n",
    HIR "★\n",
    HIC "§\n",
    HIB "△\n",
    HIG "☆\n",
    HIG "☆\n",
  });

  if (!arg)
    return notify_fail("请用：topten richman  看当今天下十大富翁排行
　　　topten motou    看当今天下十大魔头排行
      topten laoshou  看当今天下十大老手排行
　　　topten exp      看当今天下十大道行老手排行
      topten force    看当今天下十大内力高手排行
      topten mana     看当今天下十大法力高手排行
　　　topten loser    看当今天下十大悲情人物排行\n\n");

  if (!find_object(PAIMING_D)) return notify_fail("排名精灵没有载入。\n");

  if (arg == "richman") {
    paiming_list = PAIMING_D->query_paiming("富翁");
    j = 0;
  } else if (arg == "exp") {
    paiming_list = PAIMING_D->query_paiming("道行高手");
    j = 1;
  } else if (arg == "motou") {
    paiming_list = PAIMING_D->query_paiming("魔头");
    j = 2;
  } else if (arg == "laoshou") {
    paiming_list = PAIMING_D->query_paiming("老手");
    j = 3;
  } else if (arg == "loser") {
    paiming_list = PAIMING_D->query_paiming("悲情人物");
    j = 4;
  } else if (arg == "force") {
    paiming_list = PAIMING_D->query_paiming("内力高手");
    j = 5;
  } else if (arg == "mana") {
    paiming_list = PAIMING_D->query_paiming("法力高手");
    j = 6;
  } else return notify_fail("对不起，暂时还没有这项排名！\n");

  output = top[j];
  output += middle[j];
  for (i = 0; i < 10; i++) {
    sscanf(paiming_list[i], "%d %s %s %s", code, id, name, title);
    output += str_left[j] + sprintf(
      "%24s %s %-25s",
      title,
      str_center[j],
      name + "(" + id + ")"
    ) + str_right[j];
  }
  output += middle[j];
  output += bottom[j];

  tell_object(me, output);

  return 1;
}
