/* <SecCrypt CPL V3R05> */

// suicide.c
// modified by FoF 00-3-16

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  if (me->is_busy())
    return notify_fail("你上一个动作还没完成。\n");

  if (!arg) {
    message_vision("$N深深吸了一口空气，自言自语道：干吗要寻死呢？走自己的路，"
      "让别人去说吧！ 我一定要好好地活下去，重新做人！\n", me);
    return 1;
  }

  if (arg != "forever")
    return notify_fail("自杀有两种，您是要永远死掉还是重新投胎？\n");
  if (wizardp(me)) return notify_fail("你是巫师，不能自杀！\n");

  write(HIW "如果您选择永远死掉的自杀方式，这个人物的资料就永远删除了，请务必\n"
    "考虑清楚，确定的话请输入您的密码：" NOR);
  input_to("check_password", 1, me, 2);
  return 1;
}

private void check_password(string passwd, object me, int forever) {
  object link_ob;
  string old_pass;

  link_ob = me->query_temp("link_ob");
  old_pass = link_ob->query("password");
  if (!old_pass) old_pass = "(*%&$%^!";
  /*
   if( strlen(passwd) > 2 && forever == 2 ) {
      if( passwd[<1] == passwd[<2] ) passwd = passwd[0..<2];
      else {
         write("密码错误！\n");
         return;
      }
   }
*/
  if (crypt(passwd, old_pass) != old_pass) {
    write("密码错误！\n");
    return;
  }

  if (forever) {
    tell_object(me,
      HIR "\n\n你决定要自杀了，如果三十秒钟内不后悔，就真的永别了。\n\n\n" NOR);
    me->set_temp("suicide_countdown", 30);
    me->start_busy((: call_other, this_object(), "slow_suicide" :));
  }
}

private int slow_suicide(object me) {
  object link_ob, my_couple;
  int stage;
  string myid, coupleid, err;
  mapping fabao;

  stage = me->query_temp("suicide_countdown");
  me->add_temp("suicide_countdown", -1);
  if (stage > 1) {
    if (stage % 5 == 0)
      tell_object(me, HIR "你还有 " + stage + " 秒的时间可以后悔。\n" NOR);
    return 1;
  }

  link_ob = me->query_temp("link_ob");
  if (!link_ob) return 0;

  log_file("nosave/SUICIDE", sprintf("%s %s(%s) suicide from %s\n",
    ctime(time()), geteuid(me), me->name(), (string)query_ip_name(me)));

  seteuid(getuid());
  //   rm( link_ob->query_save_file() + __SAVE_EXTENSION__ );
  rename(link_ob->query_save_file() + __SAVE_EXTENSION__,
    link_ob->query_save_file() + ".sui");
  //   rm( me->query_save_file() + __SAVE_EXTENSION__ );
  rename(me->query_save_file() + __SAVE_EXTENSION__,
    me->query_save_file() + ".sui");
  myid = me->query("id");
  coupleid = me->query("couple/id");

  // remove player home.
  //   rm( "/data/playerhomes/h_" + myid + __SAVE_EXTENSION__ );
  if (file_size("/data/playerhomes/h_" + myid + __SAVE_EXTENSION__) > 1)
    rename("/data/playerhomes/h_" + myid + __SAVE_EXTENSION__,
      "/data/playerhomes/h_" + myid + ".sui");

  // remove mailbox.
  //   rm( "/data/mail/" + myid[0..0] + "/" + myid + __SAVE_EXTENSION__ );
  if (file_size("/data/mail/" + myid[0..0] + "/" + myid + __SAVE_EXTENSION__) > 1)
    rename("/data/mail/" + myid[0..0] + "/" + myid + __SAVE_EXTENSION__,
      "/data/mail/" + myid[0..0] + "/" + myid + ".sui");

  // remove fabao. (not completed)
  fabao = me->query("fabao");
  if (sizeof(fabao)) {
    for (int i = sizeof(fabao); i > 0; i--)
      if (file_size("/data/fabao/" + myid[0..0] + "/" + myid + "-" + i + __SAVE_EXTENSION__) > 1)
        rename("/data/fabao/" + myid[0..0] + "/" + myid + "-" + i + __SAVE_EXTENSION__,
          "/data/fabao/" + myid[0..0] + "/" + myid + "-" + i + ".sui");
    //         rm( "/data/fabao/" + myid[0..0] + "/" + myid + "-" + i + __SAVE_EXTENSION__ );
  }

  // remove couple's home as well. (the home is registered by the couple.)
  coupleid = me->query("couple/id");
  if (coupleid && strlen(coupleid) > 2) {
    //      rm( "/data/playerhomes/h_" + coupleid + __SAVE_EXTENSION__ );
    if (file_size("/data/playerhomes/h_" + coupleid + __SAVE_EXTENSION__) > 1)
      rename(
        "/data/playerhomes/h_" + coupleid + __SAVE_EXTENSION__,
        "/data/playerhomes/h_" + coupleid + ".sui"
      );
    if (my_couple = find_player(coupleid)) {
      my_couple->delete("couple");
      my_couple->save();
      tell_object(my_couple, HIR "你的配偶自杀了。 :-(\n" NOR);
    } else {
      my_couple = new(USER_OB);
      my_couple->set("id", coupleid);
      if (!err = catch(call_other(my_couple, "restore"))) {
        my_couple->restore();
        my_couple->delete("couple");
        my_couple->save();
      }
      destruct(my_couple);
    }
  }

  write("好吧，永别了 :(\n");
  tell_room(environment(me), me->name() + "自杀了，以后你再也看不到这个人了。\n", ({ me }));
  CHANNEL_D->do_channel(this_object(), "rumor", me->name() + "自杀了。");
  destruct(link_ob);
  destruct(me);
  return 0;
}

int help(object me) {
  write(@HELP
指令格式: suicide [forever]
 
如果因为某种原因你不想活了，你可以选择自杀。
自杀分两种：
 
suicide         ：重新投胎
suicide forever ：永远的除去玩家资料，系统会要求你输入密码以确认身份。
 
请慎重选择 :-)
 
HELP
  );
  return 1;
}
