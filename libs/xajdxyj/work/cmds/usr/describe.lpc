// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

// describe.c

#include "ansi.h"

inherit F_CLEAN_UP;

int main(object me, string arg) {
  string *txt;

  if (!arg) return notify_fail("指令格式：describe <描述>\n");

  txt = explode(arg, "\n");
  if ((!wizardp(me) && sizeof(txt) > 10) || sizeof(txt) > 15)
    return notify_fail("请将您对自己的描述控制在十行以内。\n");

  arg = implode(txt, "\n") + "\n";

  arg = replace_string(arg, "BLK", BLK);
  arg = replace_string(arg, "RED", RED);
  arg = replace_string(arg, "GRN", GRN);
  arg = replace_string(arg, "YEL", YEL);
  arg = replace_string(arg, "BLU", BLU);
  arg = replace_string(arg, "MAG", MAG);
  arg = replace_string(arg, "CYN", CYN);
  arg = replace_string(arg, "WHT", WHT);
  arg = replace_string(arg, "HIR", HIR);
  arg = replace_string(arg, "HIG", HIG);
  arg = replace_string(arg, "HIY", HIY);
  arg = replace_string(arg, "HIB", HIB);
  arg = replace_string(arg, "HIM", HIM);
  arg = replace_string(arg, "HIC", HIC);
  arg = replace_string(arg, "HIW", HIW);
  arg = replace_string(arg, "NOR", NOR);
  arg = replace_string(arg, "BNK", BLINK);

  arg = replace_string(arg, "BRED", BRED);
  arg = replace_string(arg, "BGRN", BGRN);
  arg = replace_string(arg, "BYEL", BYEL);
  arg = replace_string(arg, "BBLU", BBLU);
  arg = replace_string(arg, "BMAG", BMAG);
  arg = replace_string(arg, "BCYN", BCYN);
  arg = replace_string(arg, "BWHT", BWHT);

  me->set("long", arg + NOR);
  write("Ok.\n");
  return 1;
}

int help() {
  write(@TEXT
指令格式：describe <描述>

这个指令让你设定当别人用 look 指令看你时，对你的描述，当你的描述超过
一行时可以用 to describe 的方式来输入。
你如果希望在绰号中使用 ANSI 的控制字元改变颜色，可以用以下的控制字串：

BLK - [30m黑色[2;37;0m       NOR - [2;37;0m恢复正常颜色[2;37;0m
RED - [31m红色[2;37;0m       HIR - [1;31m亮红色[2;37;0m
GRN - [32m绿色[2;37;0m       HIG - [1;32m亮绿色[2;37;0m
YEL - [33m土黄色[2;37;0m     HIY - [1;33m亮黄色[2;37;0m
BLU - [34m深蓝色[2;37;0m     HIB - [1;34m亮蓝色[2;37;0m
MAG - [35m浅紫色[2;37;0m     HIM - [1;35m粉红色[2;37;0m
CYN - [36m蓝绿色[2;37;0m     HIC - [1;36m天青色[2;37;0m
WHT - [37m浅灰色[2;37;0m     HIW - [1;37m亮白色[2;37;0m
BRED [37m[41m红色背景[2;37;0m    BNK - [5m闪动字符[2;37;0m
BGRN [37m[42m绿色背景[2;37;0m
BYEL [37m[43m土黄色背景[2;37;0m
BBLU [37m[44m深蓝色背景[2;37;0m
BMAG [37m[45m浅紫色背景[2;37;0m
BCYN [37m[46m蓝绿色背景[2;37;0m
BWHT [47m浅灰色背景[2;37;0m
 
系统自动会在尾端加一个 NOR。

TEXT
  );
  return 1;
}
