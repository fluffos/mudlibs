#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  object couple;
  object wiz;
  if (!arg) arg = "．．．";
  if (!me->query("couple/id")) return notify_fail("你还没有结婚呢！\n");
  if (!couple = find_player(me->query("couple/id")))
    return notify_fail("你爱人不在这里。\n");
  message("vision", HIW "【夫妻】" + me->name(1) + "：" + arg + "\n" NOR, ({ me, couple }));

  return 1;
}

int help(object me) {
  write(@HELP

指令格式 : coupletalk [讯息]    或   ct [讯息]

夫妻密谈，其他人是听不见的哟！

HELP
  );
  return 1;
}
