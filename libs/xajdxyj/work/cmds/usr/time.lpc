#include <ansi.h>

inherit F_CLEAN_UP;

int calendar();

int main(object me, string arg) {
  if (arg != "-l") {
    write("现在是" + NATURE_D->game_time() + "。\n");
    return 1;
  }
  return calendar();
}

int calendar() {
  string cal;
  int t = time();

  cal = sprintf(HBCYN HIB "\n┏━━━━━━━━━━┓\n"
    "┃☆" HIY "欢乐纪元%6s" HIB "☆┃\n"
    "┃" HIG "%6s %2d 日    " HIW "%2s" HIB "  ┃\n"
    "┃   %s       " HIW "%2s" HIB "  ┃\n"
    "┃" HIY "%8s %s " HIB "★★★┃\n"
    "┗━━━━━━━━━━┛\n" NOR,
    TIME_D->query_timec(t, "year"), TIME_D->query_timec(t, "month"),
    TIME_D->query_timen(t, "day"), NATURE_D->query_jie_qi()[0..1],
    TIME_D->query_timec(t, "week"), NATURE_D->query_jie_qi()[2..3],
    TIME_D->query_timec(t, "hour"), TIME_D->query_timec(t, "quarter"));
  write(cal);
  return 1;
}

int help(object me) {
  write(@HELP
指令格式: time [-l]

这个指令让你知道现在的时辰。

HELP
  );
  return 1;
}
