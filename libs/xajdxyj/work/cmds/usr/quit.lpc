// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */
 
// quit.c
// modified by FoF 00-3-16

#include <command.h>

inherit F_DBASE;
inherit F_CLEAN_UP;

int do_drop(object me, object obj);
int confirm(string yn, object me);
int do_quit(object me);
int log_usage(string id, string ip_number, string mode);

void create() 
{
   seteuid(getuid());
   set("name", "离线指令");
   set("id", "quit");
}

int main(object me, string arg)
{
   int i;
   object *inv, link_ob;

   link_ob = me->query_temp("link_ob");
   if(me->query_temp("now_no_quit"))
        return notify_fail("你现在不能退出游戏!!!\n");

   if( me->query_temp("no_move") )
      return notify_fail("你被定住了，哪里退得出游戏！\n");

   if( !me->query_temp("suicide_countdown") ) {
      if( me->is_busy() )
      return notify_fail("( 你上一个动作还没有完成，不能退出。)\n");
   } //to allow halt suicide :D by mon 9/9/97

   if( !wizardp(me) && environment(me) && environment(me)->query("no_quit") && link_ob )
      return notify_fail("这里不准退出游戏。\n");
/*
      // by FoF
      // 新手在线时间必须大于 2 小时才能保留账号，避免账号泛滥
      if( arg != "-force" && !wizardp(me) && me->query("mud_age") < 3600 && me->query("combat_exp") < 500 ) {
         write("你的账号是新建的，本站规定新建账号必须连续在线１小时才有效，
退出游戏将删除你的账号，你确定吗？(y/n)");
         input_to((: confirm :), me);
         return 1;
      }
*/
   if( !wizardp(me) && ( !link_ob || ( link_ob && !link_ob->is_character()) ) ) {
      inv = all_inventory(me);
      for( i = 0; i < sizeof(inv); i ++ )
         if( !inv[i]->query_autoload() ) do_drop(me, inv[i]);
         // since drop commands when quit is a little different from normal
         // drop commands the do_drop is revised here. wuliao@xyj Feb 1997
   }

   // We might be called on a link_dead player, so check this.
   if( link_ob ) {
      // Are we possessing in others body ?
      if( link_ob->is_character() ) {
         write("你的魂魄回到" + link_ob->name(1) + "的身上。\n");
         exec(link_ob, me);
         link_ob->setup();
         return 1;
      }

      link_ob->set("last_on", time());
      link_ob->set("mud_age", me->query("mud_age"));
      link_ob->set("last_from", query_ip_name(me));

      link_ob->save();
      destruct(link_ob);
   }

   write("欢迎下次再来！\n");
   message("system", me->name() + "离开游戏。\n", environment(me), me);

   CHANNEL_D->do_channel(this_object(), "sys",
      me->name() + "(" + capitalize(me->query("id")) + ")" + "离开游戏了。");

if(!wizardp(me))me->delete("env/invisibility");
me->set("env/not_be_get",1);
   me->save();
   call_out("log_usage", 1, me->query("id"), query_ip_number(me), "logout");
   destruct(me);

   return 1;
}

int confirm(string yn, object me)
{
   int i;
   object *inv, link_ob;

   if( upper_case(yn) == "Y" ) {
      link_ob = me->query_temp("link_ob");

      if( !wizardp(me) && ( !link_ob || ( link_ob && !link_ob->is_character()) ) ) {
         inv = all_inventory(me);
         for( i = 0; i < sizeof(inv); i ++ )
            if( !inv[i]->query_autoload() ) do_drop(me, inv[i]);
      }
      write("你选择了放弃账号，欢迎下次再来！\n");

      seteuid(getuid());
      rm( link_ob->query_save_file() + __SAVE_EXTENSION__ );
      rm( me->query_save_file() + __SAVE_EXTENSION__ );
      destruct(link_ob);
      call_out("log_usage", 1, me->query("id"), query_ip_number(me), "logout");
      destruct(me);
      return 1;
   } else {
      write("放弃退出，继续游戏。\n");
      return 1;
   }
}

int do_drop(object me, object obj)
{
   if( obj->query("no_drop") ) {
      destruct(obj);
      return 0;
   }
   if( obj->move(environment(me)) ) {
      if( obj->is_character() )
         message_vision("$N将$n从背上放了下来，躺在地上。\n", me, obj);
      else {
         message_vision( sprintf("$N丢下一%s$n。\n", obj->query("unit")), me, obj );
         if( !obj->query("value") && !obj->value() ) {
            tell_object(me, "因为这样东西并不值钱，所以人们并不会注意到它的存在。\n");
            destruct(obj);
         }
      }
      return 1;
   }
   return 0;
}

// FoF 00-5-14
private int log_usage(string id, string ip_number, string mode)
{
    IP_USAGE_D->log_ip(id, ip_number, mode);
    USAGE_D->log_id(id, ip_number, mode);
}

int help(object me)
{
   write(@HELP
指令格式 : quit

当你想暂时离开时, 可利用此一指令。
HELP
    );
    return 1;
}

