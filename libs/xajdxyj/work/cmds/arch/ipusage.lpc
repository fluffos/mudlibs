// ipusage.c

#include <ansi.h>
inherit F_DBASE;
inherit F_CLEAN_UP;

string ip2add(string);
int strnotlast(string, string);
int check_multi_login(object);

int main(object me, string arg)
{
    int a, b, c, d;
    int i, *out;
    string *key, *val;
    mapping usage;

    if( !wizardp(me) )
        return notify_fail("你没有权力使用这个指令。\n");

    if( !arg ) return notify_fail("请指定一个 IP 地址。\n");

    if( sscanf(arg, "%d.%d.%d.%d", a, b, c, d) != 4 )
        return notify_fail("地址错误！\n");

    usage = IP_USAGE_D->query_ip_usage(arg);
    map_delete(usage, "login");
    map_delete(usage, "logout");
    map_delete(usage, "replace");
    map_delete(usage, "create");
    map_delete(usage, "last");
    key = keys(usage);
    val = values(usage);
    out = sort_array(key, -1);
    
    write(sprintf("地址：" + arg + " 的使用情况如下：\n"));
    for( i = sizeof(out) - 1; i >= 0; i -- ) {
    	if( !undefinedp(usage[out[i]]) && intp(out[i]) )
            write(sprintf("%s\t%s\n", ctime(out[i]), usage[out[i]]));
    }
    write(sprintf("共有 " + sizeof(out) + " 条记录。\n"));
    
    return 1;
}

int help(object me)
{
    write(@HELP
指令格式： ipusage <IP 地址>

查找本月该地址的所有使用情况。
HELP
    );
    return 1;
}
