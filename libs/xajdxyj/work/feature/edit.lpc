// edit.c

#include <ansi.h>

int edit(function callback)
{
   write("结束离开用 '.'，取消输入用 '~q'。\n"); // ，使用内建列编辑器用 '~e'。\n");
   write("————————————————————————————————————————\n");
   input_to("input_line", "", 0, callback);
   return 1;
}

int color_edit(function callback) // FoF add for colorful chat, emote, etc. :-)
{
   write("结束离开用 '.'，取消输入用 '~q'。\n"); // ，使用内建列编辑器用 '~e'。\n");
   write("————————————————————————————————————————\n");
   input_to("color_input_line", "", 0, callback);
   return 1;
}

#define MAXLINES 100
#define MAXCOL 80

void input_line(string line, string text, int lines, function callback)
{
   if( strlen(line) > MAXCOL ) {
      write("一行只能包含 " + MAXCOL + " 个字符，多余部分被忽略。\n");
      line = line[0..MAXCOL-1];
   }

   if( line == "." ) {
      (*callback)(text);
      return;
   } else if( line == "~q" ) {
      write("输入取消。\n");
      return;
//   } else if( line=="~e" ) {
   }

  if( lines >= MAXLINES ) {
     write("正文超过 " + MAXLINES + " 行，多余部分被忽略。\n");
  } else {
     text += line + "\n";
     lines ++;
  }
  input_to("input_line", text, lines, callback);
}

void color_input_line(string line, string text, int lines, function callback)
{
   string str = line;
   str = replace_string(str, "BLK", "");
   str = replace_string(str, "RED", "");
   str = replace_string(str, "GRN", "");
   str = replace_string(str, "YEL", "");
   str = replace_string(str, "BLU", "");
   str = replace_string(str, "MAG", "");
   str = replace_string(str, "CYN", "");
   str = replace_string(str, "WHT", "");
   str = replace_string(str, "HIR", "");
   str = replace_string(str, "HIG", "");
   str = replace_string(str, "HIY", "");
   str = replace_string(str, "HIB", "");
   str = replace_string(str, "HIM", "");
   str = replace_string(str, "HIC", "");
   str = replace_string(str, "HIW", "");
   str = replace_string(str, "NOR", "");
   str = replace_string(str, "BNK", "");

   line = replace_string(line, "BLK", BLK);
   line = replace_string(line, "RED", RED);
   line = replace_string(line, "GRN", GRN);
   line = replace_string(line, "YEL", YEL);
   line = replace_string(line, "BLU", BLU);
   line = replace_string(line, "MAG", MAG);
   line = replace_string(line, "CYN", CYN);
   line = replace_string(line, "WHT", WHT);
   line = replace_string(line, "HIR", HIR);
   line = replace_string(line, "HIG", HIG);
   line = replace_string(line, "HIY", HIY);
   line = replace_string(line, "HIB", HIB);
   line = replace_string(line, "HIM", HIM);
   line = replace_string(line, "HIC", HIC);
   line = replace_string(line, "HIW", HIW);
   line = replace_string(line, "NOR", NOR);
   line = replace_string(line, "BNK", BLINK);
   line = replace_string(line, "【", "〖");
   line = replace_string(line, "】", "〗");

   if( strlen(str) > MAXCOL ) {
      write("一行只能包含 " + MAXCOL + " 个字符，多余部分被忽略。\n");
      line = line[0..MAXCOL-1];
   }

   if( line == "." ) {
      (*callback)(text);
      return;
   } else if( line == "~q" ) {
      write("输入取消。\n");
      return;
//   } else if( line=="~e" ) {
   }

   if( lines >= MAXLINES ) {
      write("正文超过 " + MAXLINES + " 行，多余部分被忽略。\n");
   } else {
      text += line + "\n";
      lines ++;
   }
   input_to("color_input_line", text, lines, callback);
}

