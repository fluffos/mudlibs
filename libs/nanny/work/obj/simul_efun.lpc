varargs int tail(string fname) {
  int offset;
  string str;

  if (!stringp(fname)) return 0;
  offset = file_size(fname);
  if (offset < 0) return 0;
  offset -= 54 * 20;
  if (offset < 0) offset = 0;
  str = read_bytes(fname, offset, 1080);
  if (!str) return 0;
  if (offset)
    str = str[strsrch(str, "\n") + 1..];
  write(str);
  return 1;
}

varargs mixed *exclude_array(mixed *arr, int from, int to) {
  if (!pointerp(arr)) return ({});
  if (undefinedp(to)) to = from;
  if (from < 0) from = 0;
  if (to < from) return arr;
  return arr[0..from - 1] + arr[to + 1..<1];
}

varargs int cat(string file, int start, int num) {
  string content;
  string *lines;
  int len, i, end;

  content = read_file(file);
  if (!content) return 0;
  if (!start) {
    write(content);
    return 0;
  }
  lines = explode(content, "\n");
  len = sizeof(lines);
  if (start < 1) start = 1;
  end = (start - 1) + num;
  if (end > len) end = len;
  for (i = start - 1; i < end; i++)
    write(lines[i] + "\n");
  return end - (start - 1);
}

varargs void move_object(mixed item, mixed dest) {
  if (undefinedp(dest)) {
    if (previous_object())
      previous_object()->_fluffos_move_to(item);
    return;
  }
  if (stringp(item))
    item = load_object(item);
  if (objectp(item))
    item->_fluffos_move_to(dest);
}

varargs int command(string str, object ob) {
  if (!ob) ob = previous_object();
  if (!ob) return 0;
  return (int)ob->_fluffos_cmd(str);
}

int transfer(mixed item, mixed dest) {
  int weight;
  object from;

  if (stringp(item)) item = load_object(item);
  if (stringp(dest)) dest = load_object(dest);
  if (!objectp(item) || !objectp(dest)) return 3;

  weight = (int)item->query_weight();
  if (!item) return 3;

  from = environment(item);
  if (from) {
    if (living(from)) {
      if (item->drop() || !item) return 2;
    } else if (environment(from)) {
      if (!from->can_put_and_get() || !from) return 3;
    }
  }

  if (environment(dest) && !living(dest)) {
    if (item->prevent_insert()) return 4;
    if (!dest->can_put_and_get() || !dest) return 5;
  }

  if (living(dest)) {
    if (!item->get() || !item) return 6;
  }

  if (environment(dest) && weight) {
    if (!dest->add_weight(weight) || !dest) return 1;
  }

  if (from && environment(from) && weight)
    from->add_weight(-weight);

  move_object(item, dest);
  return 0;
}

string process_string(string str) {
  int start, end, colon, bar;
  string tag, func, objpath, argstr, result;
  string *args;
  object target;
  mixed err, val;

  if (!stringp(str)) return str;
  start = strsrch(str, "@@");
  if (start == -1) return str;
  end = strsrch(str, "@@", start + 2);
  if (end == -1) return str;

  tag = str[start + 2..end - 1];
  bar = strsrch(tag, "|");
  if (bar != -1) {
    argstr = tag[bar + 1..<1];
    tag = tag[0..bar - 1];
    args = explode(argstr, "|");
  } else {
    args = ({});
  }

  colon = strsrch(tag, ":");
  if (colon == -1) {
    func = tag;
    target = previous_object();
  } else {
    func = tag[0..colon - 1];
    objpath = tag[colon + 1..<1];
    target = find_object(objpath);
    if (!target) catch(target = load_object(objpath));
  }

  result = "";
  if (target) {
    err = catch(val = call_other(target, ({ func }) + args));
    if (!err) {
      if (stringp(val)) result = val;
      else if (intp(val) && val) result = "" + val;
    }
  }
  return str[0..start - 1] + result + process_string(str[end + 2..<1]);
}

