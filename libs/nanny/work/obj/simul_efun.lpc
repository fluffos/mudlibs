int _isclone(object ob) {
  if (!ob) ob = previous_object();
  return ob ? clonep(ob) : 0;
}

object _next_clone(object ob) {
  object *all;
  int i;
  if (!ob) ob = previous_object();
  if (!ob) return 0;
  all = children(base_name(ob));
  if (!sizeof(all)) return 0;
  i = member_array(ob, all);
  if (i == -1) return all[0];
  return all[(i + 1) % sizeof(all)];
}

mixed *_file_stat(string file) {
  mixed *s;
  if (!stringp(file)) return 0;
  s = stat(file);
  if (!pointerp(s) || !sizeof(s)) return 0;
  return ({ 0644, s[0], s[1], s[1], s[2] });
}

