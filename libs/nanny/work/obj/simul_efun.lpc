int query_prevent_shadow() { return 1; } /* Lpd 920120 */

void log_file(string file, string str) {
  PROFILE(log_file);
  write_file("/log/" + file, str);
}

varargs string extract(string str, int start, mixed end) {
  int len, iend;

  PROFILE(extract);
  if (!str) return 0;
  len = strlen(str);
  if (undefinedp(end)) iend = len - 1;
  else iend = (int)end;
  if (start < 0) start = 0;
  if (iend >= len) iend = len - 1;
  if (start > iend) return "";
  return str[start..iend];
}

varargs string creator(object ob) {
  string fname, wiz;

  PROFILE(creator);
  if (!ob) ob = previous_object();
  if (!ob) return 0;
  fname = file_name(ob);
  if (sscanf(fname, "/players/%s/%*s", wiz) == 2 ||
    sscanf(fname, "players/%s/%*s", wiz) == 2)
    return wiz;
  return 0;
}

varargs string line_break(string s, string pre, int width) {
  int e;
  string done, a, b;

  PROFILE(line_break);

  if (!stringp(pre)) pre = "";

  if (!width) {
    if (this_player())
      width = this_player()->query_cols();

    if (!width)
      width = 80;

    width -= strlen(pre) + 2;
  }

  done = "";
  while (strlen(s)) {
    e = 5000;
    if (strlen(s) >= 5000) {
      e = 5000;
      while (e >= 0 && s[e] != ' ') e--;
      if (e == -1) return done + "   " + s + "\n";
    }
    done += sprintf("%s%-=*s", pre, width, s[0..e - 1]);
    pre = "                                                                                                               "[1..strlen(pre)];
    s = s[e + 1..strlen(s) - 1];
    if (!strlen(s)) {
      if (done[<1] != '\n') done += "\n";
      return done;
    }
    for (e = strlen(done) - 1; e >= 0 && done[e] != '\n'; e--);

    a = 0;
    b = "";
    sscanf(s, "%s %s", a, b);
    while (a && strlen(a) + strlen(done) - e <= width + 2) {
      done += " " + a;
      s = b;
      a = 0;
      b = "";
      sscanf(s, "%s %s", a, b);
    }
    done += "\n";
  }
  return done;
}

string big_linebreak(string s, int width) {
  log_file("FIX", "big_linebreak: " + file_name(previous_object()) + "\n");
  PROFILE(big_linebreak);
  if (!width) width = 79;
  return line_break(s, "", width);
}

