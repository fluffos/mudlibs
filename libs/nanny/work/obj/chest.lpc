int local_weight;
int chest_is_open;

init() {
  add_action("open", "open");
  add_action("close", "close");
}

id(str) { return str == "chest"; }

short() {
  return "a chest";
}

query_name() { return "chest"; }

long() {
  write("A chest that seems to be of a high value.\n");
  if (chest_is_open)
    write("It is open.\n");
  else
    write("It is closed.\n");
}

query_value() { return 200; }

query_weight() { return 10; }

get() { return 1; }

can_put_and_get() { return chest_is_open; }

add_weight(w) {
  if (w + local_weight > 8)
    return 0;
  local_weight += w;
  return 1;
}

close(str) {
  if (!id(str))
    return 0;
  chest_is_open = 0;
  write("Ok.\n");
  return 1;
}

open(str) {
  if (!id(str))
    return 0;
  chest_is_open = 1;
  write("Ok.\n");
  return 1;
}

reset(arg) {
  if (arg)
    return;
  chest_is_open = 0;
}

void create() {
  this_object()->reset(0);
}
