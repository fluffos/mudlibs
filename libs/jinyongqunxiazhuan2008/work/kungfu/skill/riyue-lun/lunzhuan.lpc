//Cracked by Roath
//lunzhuan.c 五轮旋转 

#include <ansi.h>

inherit F_DBASE;
inherit F_SSERVER;

int perform(object me, object target)
{
	string weapon;
	object weapon1;
	int    lvl1, lvl2, amount;

	if( !target ) target = offensive_target(me);
  
  if ( (me->query("family/family_name") != "雪山寺"))
	  	return notify_fail("你不是雪山寺弟子，无法施展「五轮旋转」。\n");
	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("五轮旋转只能对战斗中的对手使用。\n");

	weapon1 = me->query_temp("weapon");
        if( !objectp(weapon1) || weapon1->query("skill_type") != "hammer" )
                return notify_fail("你手中无锤无轮，如何使得五轮旋转？\n");

	if( me->query_skill("riyue-lun", 1) < 100 )
		return notify_fail("你的日月轮法火候未到，无法施展五轮旋转！\n");

	lvl1=me->query_skill("force");

	lvl2=me->query_skill("hammer");

	amount = (lvl1+lvl2) / 15;

	if ( amount < 40 ) amount = 40;
	if ( amount > 80 ) amount = 80;

	if( me->query("neili") <= amount*4 )
		return notify_fail("你的内力不够施展五轮旋转！\n");

	weapon = me->query_temp("weapon");

	me->add_temp("apply/damage", amount);
	me->add_temp("apply/attack", amount/2);
	me->add_temp("apply/dodge", amount/2);

	message_vision(HIR "\n$N大吼一声「"+CYN"爬你姐！"+HIR"」,手中金轮向$n旋转砸来！\n\n" NOR, me, target);

	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  
	me->start_busy(2);
	me->add_temp("apply/damage", -amount);
	me->add_temp("apply/attack", -amount/2);
	me->add_temp("apply/dodge", -amount/2);
	me->add("neili", -amount);

	return 1;
}
