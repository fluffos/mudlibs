//Cracked by Roath
//dielang.c 连环三叠浪 

#include <ansi.h>

inherit F_DBASE;
inherit F_SSERVER;

int perform(object me, object target)
{
	string weapon;
	object weapon1;
	int    lvl1, lvl2, amount;
  if ( userp(me) && (me->query("family/family_name") != "丐帮"))
	  	return notify_fail("你不是丐帮弟子，无法施展「连环三叠浪」。\n");
	  	
	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("连环三叠浪只能对战斗中的对手使用。\n");

	weapon1 = me->query_temp("weapon");
        if( objectp(weapon1) )
                return notify_fail("连环三叠浪必须空手才能使用。\n");

	if( me->query_skill("xianglong-zhang", 1) < 120 )
		return notify_fail("你的降龙十八掌火候未到，无法施展连环三叠浪！\n");

	lvl1=me->query_skill("force");

	lvl2=me->query_skill("strike");

	amount = (lvl1+lvl2) / 15;

	if ( amount < 40 ) amount = 40;
	if ( amount > 80 ) amount = 80;

	if( me->query("neili") <= amount*4 )
		return notify_fail("你的内力不够使用连环三叠浪！\n");
	
	weapon = me->query_temp("weapon");

	me->add_temp("apply/damage", amount);
	me->add_temp("apply/attack", amount*2);
	me->add_temp("apply/dodge", amount*2);

	message_vision(HIW "\n$N大喝一声「"+YEL"干你大姨妈！"+HIW"」,掌风一浪高过一浪猛地向$n奔腾而来！\n\n" NOR, me, target);

	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	
	me->add_temp("apply/damage", -amount);
	me->add_temp("apply/attack", -amount*2);
	me->add_temp("apply/dodge", -amount*2);
	me->add("neili", -amount);
	return 1;
}
