// /cmds/admin/cmd_tests.c
// 執行系統自動化測試指令

inherit "/std/object";

#include "/include/ansi.h"

int main(object me, string verb, string arg) {
  if (me->query_role() != "god") {
    write("只有管理員可以使用此指令。\n");
    return 1;
  }

  write("$HIW$🚀 開始執行 MudScript 核心功能驗證...\n$NOR$");

  string old_lang = me->query_lang();
  me->set_lang("zh-TW");  // 🚀 強制設定為中文，以滿足測試案例中的硬編碼斷言

  string *test_files = ({
    "/tests/test_quit_restore.lpc",
    "/tests/test_efuns.lpc",
    "/tests/test_initialization.lpc",
    "/tests/test_syntax.lpc",
    "/tests/test_slice.lpc",
    "/tests/test_closure_type.lpc",
    "/tests/test_logic.lpc",
    "/tests/test_coords.lpc",
    "/tests/test_control_flow.lpc",
    "/tests/test_logic.lpc",

    "/tests/test_nature.lpc",
    "/tests/test_save.lpc",
    "/tests/test_ternary.lpc",
    "/tests/test_security.lpc",
    "/tests/test_language.lpc",
    "/tests/test_quest.lpc",
    "/tests/test_crafting.lpc",
    "/tests/test_skills.lpc",
    "/tests/test_combat_classes.lpc",
    "/tests/test_guilds.lpc",
    "/tests/test_combat_team.lpc",
    "/tests/test_currency_chat.lpc",
    "/tests/test_pets_mounts.lpc",
    "/tests/test_death_corpse.lpc",
    "/tests/test_incident.lpc",
    "/tests/test_i18n.lpc",
    "/tests/test_new_efuns.lpc",
    "/tests/test_init_action.lpc",
    "/tests/test_look_dir.lpc",
    "/tests/test_localization.lpc",
    "/tests/p3_test.lpc",
    "/tests/p4_test.lpc",
    "/tests/test_file_mgmt.lpc",
    "/tests/test_var_decl.lpc",
    "/tests/test_yaml.lpc",
    "/tests/test_canon_world.lpc",
    "/tests/test_reveal_validation.lpc",
    "/tests/test_log_file.lpc",
    "/tests/test_look_travel_debug.lpc",
    "/tests/test_world_events.lpc"
  });

  int total = 0;
  int passed = 0;

  foreach (string file in test_files) {
    object test_ob = load_object(file);
    if (!test_ob) {
      write("$HIR$❌ 無法載入測試檔案: $NOR$" + file + "\n");
      continue;
    }

    test_ob->run_tests(me);
    total += test_ob->query_total();
    passed += test_ob->query_passed();

    // 測試完後銷毀，確保下次執行是乾淨的
    destruct(test_ob);
  }

  write("$HIW$==========================================$NOR$" + "\n");
  if (passed == total) {
    write("$HIG$✨ 恭喜！所有核心測試全部通過！(" + passed + "/" + total + ")$NOR$" + "\n");
  } else {
    write("$HIR$⚠️ 警報！共有 " + (total - passed) + " 個測試項目失敗！$NOR$" + "\n");
  }
  write("$HIW$==========================================$NOR$" + "\n");

  me->set_lang(old_lang);  // 🚀 恢復原本語系

  return total - passed;  // 回傳失敗次數
}

string help() {
  return "【管理指令】\n" +
    "  tests    執行系統核心功能自動化測試，驗證直譯器正確性\n";
}

string *query_verbs() { return ({ "tests" }); }
string query_category() { return "Admin"; }
