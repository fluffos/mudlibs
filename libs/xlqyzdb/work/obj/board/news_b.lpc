#include <ansi.h>
inherit BULLETIN_BOARD;

void create() {
  set_name(HIM "XLQY浙大站新闻版" NOR, ({ "news" }));
  set("location", "/d/wiz/newsroom");
  set("board_id", "news_b");
  set("long", "XLQY浙大站新闻版上用刀刻着几行大字：

晓风残月,天下无敌！:D
——————————————————————————————\n");
  setup();
  set("capacity", 500);
}
