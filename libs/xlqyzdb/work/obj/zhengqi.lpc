//Creat by Repoo 29/8/2001
#include <ansi.h>

string give_skill(object me);
inherit ITEM;

void create() {
  set_name(HBBLU HIR "天地正气" NOR, ({ "tiandi zhengqi", "zhengqi" }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "此乃万物众生的力量。\n");
    set("value", 0);
    set("no_sell", 1);
    set("drug_type", "补品");
  }
  setup();
}

void init() {
  add_action("do_heyi", "heyi");
  add_action("do_xiangqian", "xiangqian");
}
int do_heyi(string arg) {
  object me = this_player();
  object ob = this_object();
  if (!arg) return notify_fail("你想吃什么？\n");
  if (ob->query("owner") != me->query("id")) return notify_fail("拿别人东西,这习惯不好!\n");
  if ((arg == "tiandi zhengqi" || arg == "zhengqi")) {
    message_vision(HIW "$N嘴中念念有词，只见" + HBBLU HIR "天地正气" NOR + HIW "化做一股青烟钻入$N的鼻孔!\n\n" NOR, me);
    give_skill(me);
  }
  return 1;
}
string give_skill(object me) {
  mapping skill = me->query_skills();
  string *skillnames;
  string selected, msg;
  int level, inc = 1, pot;

  if (!skill) return "none";

  skillnames = keys(skill);
  selected = skillnames[random(sizeof(skillnames))];

  level = skill[selected];

  me->set_skill(selected, level + 1);
  if (!me->query("tianlongzhan/zhengqi_point"))
    me->set("tianlongzhan/zhengqi_point", 0);
  me->add("tianlongzhan/zhengqi_point", 1);
  tell_object(me, "你得到了一级" + to_chinese(selected) + "。\n");
  message(
    "channel:rumor",
    HIY + "\n【" + HIR " 丹臣子 " NOR + HIY "】：" + me->query("name") + "得到浩然" + HBBLU HIR " 天地正气 " NOR + HIY ",领悟到一级 " + HBBLU HIW "" + to_chinese(selected) + "" NOR + HIY " ！\n\n" + NOR,
    users()
  );
  destruct(this_object());
  return selected;
}

int do_xiangqian() {
  object me, ob, obj, blade;
  me = this_player();
  ob = this_object();
  obj = present("tianlong dao", me);

  if (!objectp(obj))
    return notify_fail("刀都没有，往哪里镶嵌啊？\n");

  message_vision(HIW "\n$N把手中的天地正气镶嵌进天龙刀内，咔，天龙刀发出五光十色的光芒！\n" NOR, me);
  message_vision(HIW "\n$N定睛一看，手里多了一把刻有龙文的反刃刀\n" NOR, me);
  blade = new("/obj/longzhan");
  blade->move(me, 1);
  message(
    "channel:rumor",
    HIY + "\n【" + HIR " 丹臣子 " NOR + HIY "】：大胆" + me->query("name") + ",竟然偷走了我的" + CYN " 天龙斩 " NOR + HIY " ！\n\n" + NOR,
    users()
  );
  obj->move("/cmds/std/quitroom");
  ob->move("/cmds/std/quitroom");
  destruct(obj);
  destruct(ob);
  return 1;
}
