// by bugbug & alading @ 缥缈水云间, 2003-4-5
inherit ROOM;
#include "bancast.h"

void create() {
  set("short", "陷仙门");
  set("long", @LONG   
此乃“陷仙门”，门上挂一口宝剑，名曰：“陷仙剑”。
‘诛戳陷绝   死生在我    自倚才能   有来无回’ 
LONG);
  set("exits", ([
    "south": __DIR__ "xianxian",
    "west": __DIR__ "xianxian",
    "north": __DIR__ "xianxian",
    "east": __DIR__ "xianxian1",
  ]));
  set("objects", ([
    __DIR__ "npc/guard": 2,
  ]));
  setup();
}

void init() {
  add_action("do_quit", "quit");
  add_action("do_ji", banned_action);
  add_action("do_cast", ({ "cast", "burn" }));
}

int valid_leave(object me, string dir) {
  object a;
  if (dir == "east") {
    if (objectp(a = present("guard", environment(me))) && living(a))
      return notify_fail("守卫拦住你说道：想进阵先过了我这一关！\n");
  }
  return ::valid_leave(me, dir);
}
