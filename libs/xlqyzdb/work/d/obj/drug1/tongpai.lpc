// by bugbug & alading @ 缥缈水云间, 2003-4-5
// jiudai.c  酒袋
#include <ansi.h>
inherit ITEM;
void init();

void create() {
  set_name(YEL "铜牌" NOR, ({ "tong pai", "pai" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "水陆大会专用铜质奖章(gua)。\n");
    set("unit", "块");
    set("material", "gold");
    set("value", 10000);
    set("no_steal", 1);
    set("no_get", 1);
    set("no_drop", "如此宝贵的奖励品再世难求啊。\n");
    //        set("no_give", "这种奖励品怎么能轻易送人呢?\n");
    set("no_sell", "卖?这种奖励品谁买得起啊!\n");
  }
}
void init() {
  add_action("do_gua", "gua");
}

int do_gua(string arg) {
  object me = this_player();
  string str;

  if (arg != "pai") return notify_fail("你要挂什么？\n");
  me->add("potential", 5000);
  me->add("combat_exp", 5000);
  tell_object(me, "你获得了" + chinese_number(5000) + "点武学、" + chinese_number(5000) + "点潜能！\n");
  str = me->name() + "被授予水陆大会铜质奖章，获得了" + YEL "" + chinese_number(5000) + "点武学和" + chinese_number(5000) + "点潜能！\n";
  message("channel:rumor", HIW "【水陆大会】：" + str + "\n" NOR, users());

  destruct(this_object());
  return 1;
}
