// gaoyao.c

inherit COMBINED_ITEM;
#include <ansi.h>

void setup() {}

void init() {
  add_action("do_tie", "tie");
}

void create() {
  set_name("狗皮膏药", ({ "goupi gaoyao", "goupi", "gaoyao" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("base_unit", "帖");
    set("unit", "些");
    set("long", "这是一帖(tie)从大街上耍把式的那里买来的狗皮膏药。\n");
    set("value", 500);
  }
  set_amount(1);
  setup();
}

int do_tie(string arg) {
  object me = this_player();
  if (!id(arg))
    return notify_fail("你要贴什么药？\n");
  if (me->is_busy())
    return notify_fail("现在你没空贴狗皮膏药了。\n");
  if ((int)me->query("eff_kee") == (int)me->query("max_kee") && (int)me->query("eff_sen") == (int)me->query("max_sen"))
    return notify_fail("你现在不需要用狗皮膏药。\n");
  else {
    me->receive_curing("kee", 20 + random(80));
    me->receive_curing("sen", 20 + random(80));
    message_vision(CYN "$N啪的一声在伤口上贴了一帖狗皮膏药，气色看起来好多了。\n" NOR, me);
    me->start_busy(2);
    add_amount(-1);
    return 1;
  }
}
