#include <weapon.h>

inherit STICK;

void create()
{
        set_name(YER"金刚降魔棒"NOR, ({"jingang","xiangmo bang", "bang"}));
        set_weight(8000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
		set("no_sell", 1);
		set("no_steal", 1);
		set("no_give", 1);
		set("no_drop", 1);
		set("long", "一把血红色的短棒，上面有金光暗闪，如同一条金龙般绕在棒上。\n");
                set("material", "steel");
                set("wield_msg", "$N「呼」地一声抽出一把$n握在手中。\n");
        }
        init_stick(250);
        setup();
}


