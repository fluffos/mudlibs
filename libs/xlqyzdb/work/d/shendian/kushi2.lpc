#include <ansi.h>
#include <room.h>
inherit ROOM;
void create() {
  set("short", HIC "天神台三层" NOR);
  set("long", @LONG

这里是天神台上的其中一个阁楼。是众神修行(xiuxing)的地方。

LONG);
  set("exits", ([ /* sizeof() == 1 */
    "down": __DIR__ "kushi1",
  ]));
  set("objects",
    ([  //sizeof() == 1
    //       "quest/shijienan/baimei" : 1,
    ]));
  set("no_clean_up", 1);
  set("no_fight", 1);
  set("no_magic", 1);
  set("alternative_die", 1);
  set("sleep_room", 1);
  set("outdoors", 0);
  setup();
}
void init() {
  add_action("do_zuochan", "xiuxing");
  add_action("do_kiss", "want");
}

int do_kiss() {
  object me = this_player();
  object baoshi = new("/d/baoshi/obj/bs_y1");

  if (!me->query_temp("alading"))
    return notify_fail(HIW "你想要什么就说嘛！ \n" NOR);
  if (!random(2)) {
    baoshi->move(me);
    message("channel:rumor", HIW + "【神灯】：" + me->query("name") + "拿到了一份alading的特殊礼物"
      +baoshi->query("name") + " \n" + NOR, users());
    me->delete_temp("alading");
  } else {
    return notify_fail(HIW "你想要？想要就说清楚嘛！  \n" NOR);
  }

  me->start_busy(5);
  return 1;
}

int do_zuochan() {
  int myforce, myspi, learned, sencost;
  object me = this_player();
  int num;

  num = 450;

  if (me->query("combat_exp") < 20000000)
    return notify_fail("你的武学不够，领悟不了什么的！\n");

  if (me->query_skill(me->query_skill_mapped("spells"), 1) < num
    || me->query_skill("spells", 1) < num)
    return notify_fail("你的法术修为太差了，学好了再来吧！\n");

  if (!(int)me->query_temp("mark/wanxian"))
    return notify_fail(HIW "你先去万仙阵练练再来吧！\n" NOR);

  if ((int)me->query_skill(me->query_skill_mapped("spells"), 1) < 600) {
    if (me->query("babu/shendian") == "done") {
      myforce = me->query_skill("spells");
      myspi = (int)me->query_spi();
      learned = (myforce + myspi) / 10;

      sencost = 50 + (myforce / 5);

      if ((int)me->query("sen") <= sencost)
        return notify_fail("你神智不清，再这样下去会有危险的！\n");
      if (me->query("mana") <= sencost)
        return notify_fail("你的法力不足，难以领会高深的法术。\n");

      me->receive_damage("sen", sencost);
      me->add("mana", -sencost);
      tell_object(me, "你的法术略有进展。\n");
      me->add_temp("mark/wanxian", -1);
      me->improve_skill(me->query_skill_mapped("spells"), learned);
      return 1;
    } else {
      message_vision(HIY "$N怎么进来的，回去吧！\n" NOR, this_player());
      message_vision(HIY "$N被一只无行的手抓回了南城客栈！\n" NOR, this_player());
      this_player()->move("/d/city/kezhan");
      return 1;
    }
  } else {
    message_vision(HIW "$N的修为已经够高了！\n" NOR, this_player());
    return 1;
  }
}
