inherit NPC;
#include <ansi.h>

void create() {
  set_name(HIW "小文" NOR, ({ "star wenn", "wenn" }));
  set("gender", "男性");
  set("title", HIC "移山大圣" NOR);
  set("age", 70);
  set("attitude", "heroism");
  set("class", "scholar");
  set("long", HIR "为爱一生长相守,苦等爱人一世情。\n" NOR);
  set("combat_exp", 11154575);
  set("daoxing", 6840740);
  set("kee", 1924);
  set("max_kee", 1924);
  set("sen", 1606);
  set("max_sen", 1606);
  set("max_force", 5204);
  set("force", 10408);
  set("max_mana", 4840);
  set("mana", 9680);
  set("force_factor", 250);
  set("mana_factor", 250);
  set("str", 40);
  set("per", 30);
  set_skill("buddhism", 306);
  set_skill("dodge", 402);
  set_skill("force", 351);
  set_skill("jienan-zhi", 310);
  set_skill("lotusforce", 350);
  set_skill("lotusmove", 401);
  set_skill("lunhui-zhang", 402);
  set_skill("parry", 402);
  set_skill("spells", 358);
  set_skill("staff", 403);
  set_skill("unarmed", 306);
  map_skill("dodge", "lotusmove");
  map_skill("staff", "lunhui-zhang");
  map_skill("parry", "lunhui-zhang");
  map_skill("unarmed", "jienan-zhi");
  map_skill("force", "lotusforce");
  map_skill("spells", "buddhism");
  set("chat_chance_combat", 100);
  set("chat_msg_combat", ({
    (: perform_action, "staff", "pudu" :),
    (: perform_action, "staff", "sandu" :),
    (: cast_spell, "bighammer" :),
  }));
  create_family("南海普陀山", 2, "弟子");
  setup();
  carry_object("/d/dntg/sky/stars/obj/deat")->wield();
  carry_object("/d/dntg/sky/stars/obj/xwenn")->wear();
  carry_object("/d/dntg/sky/stars/obj/xjessy")->wear();
}
void die() {
  if (environment())
    message("sound", "\n" + this_object()->query("name") + "嘿嘿的奸笑了几声。\n\n", environment());
  set("eff_kee", 2000);
  set("eff_sen", 1600);
  set("kee", 2000);
  set("sen", 1600);
}
void unconcious() {
  die();
}
