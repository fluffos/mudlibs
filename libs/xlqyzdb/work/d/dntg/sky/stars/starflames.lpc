inherit NPC;
#include <ansi.h>

void create() {
  set_name(HIW "西门庆" NOR, ({ "star flames", "flames" }));
  set("gender", "男性");
  set("title", HIC "覆海大圣" NOR);
  set("age", 77);

  set("attitude", "heroism");
  set("class", "xian");
  set("combat_exp", 6235426);
  set("daoxing", 22369930);
  set("kee", 1888);
  set("max_kee", 1888);
  set("sen", 1573);
  set("max_sen", 1573);
  set("max_force", 4957);
  set("force", 9900);
  set("max_mana", 4850);
  set("mana", 9800);
  set("force_factor", 250);
  set("mana_factor", 250);
  set("str", 40);
  set("per", 30);
  set_skill("chixin-jian", 372);
  set_skill("dodge", 393);
  set_skill("force", 350);
  set_skill("jiuyin-xinjing", 339);
  set_skill("literate", 400);
  set_skill("pansi-dafa", 310);
  set_skill("parry", 393);
  set_skill("qin", 394);
  set_skill("qingxia-jian", 364);
  set_skill("spells", 351);
  set_skill("sword", 393);
  set_skill("unarmed", 245);
  set_skill("whip", 302);
  set_skill("yinsuo-jinling", 331);
  set_skill("yueying-wubu", 372);
  map_skill("dodge", "yueying-wubu");
  map_skill("parry", "chixin-jian");
  map_skill("sword", "chixin-jian");
  map_skill("force", "jiuyin-xinjing");
  map_skill("spells", "pansi-dafa");
  map_skill("whip", "yinsuo-jinling");
  map_skill("literate", "qin");
  set("chat_chance_combat", 100);
  set("chat_msg_combat", ({
    (: perform_action, "sword", "hongyan" :),
    (: perform_action, "sword", "haotan" :),
  }));
  create_family("盘丝洞", 2, "弟子");
  setup();
  carry_object("/d/dntg/sky/stars/obj/longlove")->wield();
  carry_object("/d/dntg/sky/stars/obj/feihan")->wear();
  carry_object("/d/dntg/sky/stars/obj/marryring")->wear();
  carry_object("/d/pansi/obj/qin");
}
void die() {
  if (environment())
    message("sound", "\n" + this_object()->query("name") + "嘿嘿的奸笑了几声。\n\n", environment());
  set("eff_kee", 2000);
  set("eff_gin", 1000);
  set("eff_sen", 1500);
  set("kee", 2000);
  set("sen", 1500);
  set("gin", 1000);
}
void unconcious() {
  die();
}
