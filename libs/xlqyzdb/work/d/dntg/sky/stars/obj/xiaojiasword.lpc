#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create() {
  set_name(HIM "莎拉公主" HIR "剑" NOR, ({ "xiaojiasword" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "爱人的名字，无敌的力量。\n");
    set("value", 0);
    set("material", "steel");
    set("keenness", 50);
    set("music/type", "xiao");
  }
  init_sword(76);
  setup();
}
