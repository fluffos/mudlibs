#include <armor.h>
#include <ansi.h>

inherit WAIST;

void create() {
  set_name(HIY "龙神" HIB "之翼" NOR, ({ "longyi" }));
  set("weight", 100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "心");
    set("long", "龙神之翼。\n");
    set("value", 1000);
    set("material", "gold");
    set("armor_prop/armor", 10);
    set("armor_prop/personality", 5);
  }
  setup();
}
