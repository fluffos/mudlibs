#include <armor.h>
#include <ansi.h>

inherit WAIST;

void create() {
  set_name("最爱成都", ({ "jmz" }));
  set("weight", 100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "王母娘娘的挚爱。\n");
    set("value", 1000);
    set("material", "gold");
    set("armor_prop/armor", 10);
    set("armor_prop/personality", 5);
  }
  setup();
}
