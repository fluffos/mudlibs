#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create() {
  //        set_name(HIG "黯然销魂剑" NOR, ({"sword"}));
  set_name(HIR "黯然" HIY "销魂" HIC "剑" NOR, ({ "sword" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "黯然销魂剑。\n");
    set("value", 0);
    set("material", "steel");
    set("keenness", 50);
    set("music/type", "xiao");
  }
  init_sword(10);
  setup();
}
