int ask_name();

inherit F_VENDOR_SALE;
// inherit NPC;
void create() {
  object yaopai;

  set_name("穷秀才", ({ "qiong xiucai", "xiucai" }));
  set("gender", "男性");
  set("age", 36);
  set("title", "书贩子");

  set("long", "一个落魄的书生，此时正挑着十年寒窗苦读的典籍变卖。\n");
  set("combat_exp", 50000);
  set("attitude", "peaceful");
  set_skill("unarmed", 120);
  set_skill("dodge", 120);
  set_skill("parry", 110);

  set("per", 11);
  set("max_kee", 150);

  set("vendor_goods", ([
    "parry": "/d/obj/book/parrybook2",
    "spells": "/d/obj/book/mihou-book",
    "force": "/d/obj/book/forcebook2",
  ]));


  setup();
  carry_object("/d/obj/cloth/linen")->wear();
  set("chat_msg", ({
    "穷秀才吆喝道：各位乡亲父老，在下有家传秘籍出售，欢迎大家选购！\n",
  }));
  set("chat_chance", 10);
}

void init() {
  add_action("do_vendor_list", "list");
}
