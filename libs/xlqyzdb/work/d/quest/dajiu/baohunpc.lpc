  //weap->wield();	
}

void copy_status(object me, int level) {
  mapping me_skill;
  int *skill_value, max_value, i;

  me_skill = me->query_skills();
  i = sizeof(me_skill);
  if (i > 0) {
    skill_value = values(me_skill);
    max_value = skill_value[0];
    while (i--) {  // 找出玩家skill最大值
      if (skill_value[i] > max_value)
        max_value = skill_value[i];
    }
  } else max_value = 1;
  set("stay_time", time() + 1000 + random(600));
  set_skills(max_value, level);

  set_hp_status(me, level);

}

void set_skills(int max_value, int level) {
  object guai = this_object();
  int guai_value;

  if (level == 1) guai_value = max_value + max_value / 18;
  else if (level == 2) guai_value = max_value + max_value / 16;
  else guai_value = max_value + max_value / 12;  // alading adjust

  set_skill("unarmed", guai_value + random(16));
  set_skill("dodge", guai_value + random(16));
  set_skill("parry", guai_value + random(16));
  set_skill("force", guai_value + random(16));
  set_skill("sword", max_value + random(16));
  set_skill("spells", guai_value + 20 + random(16));
  set_skill("literate", guai_value);

  set_skill("moonshentong", guai_value + 20 + random(16));
  set_skill("baihua-zhang", guai_value + random(16));
  set_skill("moonforce", guai_value + random(16));
  set_skill("snowsword", guai_value + random(16));
  set_skill("moondance", guai_value + 10 + random(16));
  map_skill("spells", "moonshentong");
  map_skill("unarmed", "baihua-zhang");
  map_skill("force", "moonforce");
  map_skill("sword", "snowsword");
  map_skill("parry", "snowsword");
  map_skill("dodge", "moondance");
  set("chat_chance_combat", 40);
  set("chat_msg_combat", ({
    (: cast_spell, "mihun" :),
    (: cast_spell, "arrow" :),
  }));
}


void set_hp_status(object me, int level) {
  int max_kee, max_sen, skill_force, maximum_mana, exp, daoxing;
  max_kee = me->query("max_kee");
  max_sen = me->query("max_sen");
  skill_force = query_skill("force");
  maximum_mana = me->query("maximum_mana");
  exp = me->query("combat_exp");
  daoxing = me->query("daoxing");

  set("max_force", skill_force * 10);
  set("force", skill_force * 20);
  set("force_factor", skill_force / 6);
  set("mana_factor", query_skill("spells", 1) / 2);

  if (exp < 8000000) {
    set("max_kee", max_kee * 2);
    set("eff_kee", max_kee * 2);
    set("max_sen", max_sen * 2);
    set("eff_sen", max_sen * 2);
    set("kee", max_kee * 2);
    set("sen", max_sen * 2);
    set("max_mana", maximum_mana);
    set("mana", maximum_mana);
    set("combat_exp", exp + exp / 20 + random(exp / 20));
    set("daoxing", daoxing + daoxing * 1 / 16 + random(daoxing * 1 / 16));
    set_temp("apply/armor", 160);
    //                set_temp("apply/damage", 80);
  }

  else {
    set("max_kee", max_kee * 2);
    set("eff_kee", max_kee * 2);
    set("max_sen", max_sen * 2);
    set("eff_sen", max_sen * 2);
    set("kee", max_kee * 3 / 2);
    set("sen", max_sen * 3 / 2);
    set("max_mana", maximum_mana);
    set("mana", maximum_mana);
    set("combat_exp", exp + exp / 16 + random(exp / 16));
    set("daoxing", daoxing + daoxing * 1 / 12 + random(daoxing * 1 / 12));
    set_temp("apply/armor", 220);
    //                set_temp("apply/damage", 100);
  }




}
int random_place(object me, string *dirs) {
  int i, j, k;
  object newob;
  mixed *file, exit;

  if (!sizeof(dirs)) return 0;

  i = random(sizeof(dirs));    // pick up one directory

  file = get_dir(dirs[i] + "/*.lpc", -1);
  if (!sizeof(file)) return 0;

  for (k = 0; k < 30; k++) {  // try 30 times
    j = random(sizeof(file));
    if (file[j][1] > 0) {
      newob = load_object(dirs[i] + "/" + file[j][0]);
      if (newob) {
        if (newob->query("no_fight") ||
          newob->query("no_magic") ||
          newob->query("no_mieyao") ||
          !(exit = newob->query("exits")) ||
          sizeof(exit) < 1 ||
          !newob->query("outdoors"))
          continue;

        if (me->move(newob)) {
          message_vision("$N走了过来。\n", me);
          return 1;
        }
      }
    }
  }

  return 0;
}
string invocation(object me, int level) {
  object guai, env;
  string *dirs, where;

  dirs = dirs1;
  guai = this_object();
  copy_status(me, level);
  guai->set("title", me->query("name") + "搭救的");
  set("owner", me);
  set("level", level);

  if (!random_place(guai, dirs)) return "没人在。";

  env = environment(guai);
  where = guai->query("name");

  if (env)
    where += "在" + MISC_D->find_place(env);
  return where;
  call_out("destruct_me", 900);


}

void init() {
  object me = this_object();
  object who = this_player();
  int type;
  int t = query("stay_time");
  ::init();
  add_action("do_no", ({ "ji", "bian" }));   //  alading 2002-8-11  add " bian "
  add_action("do_qk", "cast");
  add_action("do_block", "", 1);
  add_action("do_baohu", "baohu");
  add_action("do_baohu", "dajiu");
  add_action("do_healup", "heal");



  if (t && time() > (t + 300)) {
    remove_call_out("leave");
    call_out("leave", 1);
    return;
  }

  if (t && time() > t) {
    remove_call_out("_leave");
    call_out("_leave", 300);
  }
  if (!living(this_object())) return;
  if (!living(who)) return;
  remove_call_out("check_room");
  call_out("check_room", 2);

}

int do_qk(string arg) {

  string cast_id, cast_name;
  object who = this_player();

  if (sscanf(arg, "%s on %s", cast_id, cast_name) == 2)

    if (cast_id == "qiankun" || arg == "qiankun" || cast_id == "zhuang" || arg == "zhuang")  // alading add zhuang
    {
      tell_object(who, "你隐隐的听到镇元大仙的声音：你这逆徒！休要烂用我观中法术！\n");

      return 1;
    }
  return 0;

}
int do_healup() {
  object who = this_player();
  object ob = this_object();
  if (ob->query("kee") > (ob->query("max_kee") - 20)) {
    message_vision("$N说了声谢谢!\n$N气色不错。\n", ob);
    return 1;
  }
  if (who->query("kee") < 300 || who->query("force") < 1000) {
    tell_object(who, "你气色更差！\n");
    return 1;
  }
  who->add("force", -300);
  ob->add("kee", 50);
  message_vision("$N受到了$n的真气灌入!\n$N的气色看起来好多了。\n", ob, who);
  return 1;
}

int do_no(string arg) {
  object who = this_player();
  object me = this_object();
  message_vision("$N鬼鬼遂遂不知想干什么，$n警惕的盯着$N。\n", who, me);
  return 1;
}

int do_baohu() {
  object me = this_player();
  object ob2 = this_object();
  object ob, killer1, killer2, killer3;
  string where, where1, where2;
  int level;



  if (me != owner()) {
    message_vision(CYN "$N说道：你不是我等的那个人。哎。。。。\n" NOR, ob2);

    return 1;
  }
  if (me->is_busy()) return notify_fail("你正忙着呢。\n");

  me->command("say 我来也，救人一命，胜及七级浮屠。");

  ob2->command("wield sword");
  level = random(10);
  if (level < 5) level = 1;
  else if (level < 8) level = 2;
  else level = 3;

  if (!me->query("baohu/kk")) {
    killer1 = new("/d/wizz/stey/kill1/" + list[random(sizeof(list))]);
    where = killer1->invocation(me, level);
    killer2 = new("/d/wizz/stey/kill1/" + list[random(sizeof(list))]);
    where1 = killer2->invocation(me, level);
    killer3 = new("/d/wizz/stey/kill1/" + list[random(sizeof(list))]);
    where2 = killer3->invocation(me, level);
    me->set_temp("baohu/killer1", killer1);
    me->set_temp("baohu/killer2", killer2);
    me->set_temp("baohu/killer3", killer3);


    killer1->move(environment(ob2));
    message_vision("\n" + killer3->query("name") + "突然跳了出来......\n", me);
    killer2->move(environment(ob2));
    message_vision("\n" + killer2->query("name") + "突然跳了出来......\n", me);
    killer3->move(environment(ob2));
    message_vision("\n" + killer1->query("name") + "突然跳了出来......\n", me);

    killer1->command("follow hua xian");
    killer2->command("follow hua xian");
    killer3->command("follow hua xian");
    killer1->kill_ob(ob2);
    killer2->kill_ob(ob2);
    killer3->kill_ob(ob2);
    me->set("baohu/kk", 1);
    me->delete("bauhu_killer");

    //  ob2->command("follow "+me->query("id"));
    return 1;
  }
  return 1;
}

int accept_object(object who, object ob) {
  object guai, me, silver;
  int i, j;
  string str;

  guai = this_object();
  me = this_player();
  //  mapping skills = me->query_skills();
  silver = new("/obj/money/silver");

  if (me != owner()) {
    message_vision(CYN "$N说道：你不是我等的那个人。\n" NOR, guai);

    return 0;
  }
  if (!me->query("baohu/done")) {
    message_vision(CYN "$N说道：我还没脱险，别磨磨蹭蹭，动作快点。\n" NOR, guai);
    return 0;
  }
  if (me->query_temp("baohu/get")) {
    message_vision(CYN "$N道了万福说道：谢谢。\n" NOR, guai);
    return 0;
  }
  if (ob->name() != "水晶鞋" || ob->query("id") != "shuijing xie") {
    message_vision(CYN "$N说道：这是什么玩意儿，快带我回家。\n" NOR, guai);
    return 0;
  } else {

    me->add("baohuhuaxian", 1);

    i = 1000 + random(1000) + (int)me->query("baohuhuaxian");
    if ((int)me->query("baohuhuaxian") > 1000)
      i = 2000 + random((int)me->query("baohuhuaxian"));
    if (i > 5000)
      i = 5000 + random(1500);

    me->add("potential", i);
    tell_object(me, "\n除了战斗所得，你还赢得了" + chinese_number(i) + "点潜能的奖励！\n");
    str = chinese_number(i) + "点潜能";

    i = 1000 + random(1600) + (int)me->query("baohuhuaxian");

    if ((int)me->query("baohuhuaxian") > 1200)
      i = 2400 + random((int)me->query("baohuhuaxian"));

    if (i > 5000)
      i = 5000 + random(1500);

    me->add("daoxing", i);
    tell_object(me, "\n除了战斗所得，你还赢得了" + COMBAT_D->chinese_daoxing(i) + "道行！\n");
    str = str + "、" + COMBAT_D->chinese_daoxing(i) + "道行";

    i = 1600 + random(2000) + (int)me->query("baohuhuaxian");
    if ((int)me->query("baohuhuaxian") > 1200) i = 3000 + random((int)me->query("baohuhuaxian"));
    if (i > 5000)
      i = 5000 + random(1500);

    me->add("combat_exp", i);
    tell_object(me, "\n除了战斗所得，你还赢得了" + chinese_number(i) + "点武学！\n");
    str = str + "和" + chinese_number(i) + "点武学";
    message("channel:rumor", HIG "【姜子牙】：" + me->name() + "搭救花仙成功赢得了" + str + "！\n" NOR, users());
    i = 10 + random(60);
    silver->set_amount(i);
    tell_object(me, "\n除了战斗所得，你还赢得了" + chinese_number(i) + "两银子的奖励！\n");
    if (!(silver->move(me)))
      silver->move(environment(me));
    message_vision("$N递给$n一包银子。\n", this_object(), me);

    guai->command("kiss6 " + me->query("id"));
    guai->command("job " + me->query("name") + "成功搭救了" + guai->query("name") + "。");

    message_vision(CYN "$N道了万福说道：谢谢你搭救了我！。\n" NOR, guai);
    message_vision(CYN "$N说完，穿上水晶鞋蹭了蹭，消失了！。\n" NOR, guai);

    me->set_temp("baohu/get", 1);
    me->set("baohu/done", "done");
    //       me->delete("baohu/kk");     
    call_out("destruct_ob", 0, ob);
    return 1;

  }
}


void destruct_ob(object ob) {
  object guai;
  guai = this_object();
  destruct(ob);
  load_object("/obj/empty");
  guai->move("/obj/empty");
  destruct(guai);

}

void die() {


  object ob = query_temp("last_damage_from");
  object me = this_object();
  object where = environment(me);

  if (ob != owner()) {
    message_vision(CYN "$N说道：你武功太烂了，害死我，你。。。。这个。。天。杀的。。，\n$N气绝身亡了。\n" NOR, me);
    destruct(me);
    return;
  }


  message_vision(CYN "$N说道：你武功太烂了，害死我，你。。。。这个。。天。杀的。。，$N气绝身亡了。\n" NOR, me);

  ob->set("baohu/fail", 1);
  ob->delete("baohu/get");
  ob->delete("baohu/kk");

  //    load_object("/obj/empty");
  //   me->move("/obj/empty");
  destruct(me);
}


void unconcious() {
  die();
}

void _leave() {
  object me = this_object();
  if (me->is_fighting() || me->is_busy())
    return;
  leave();
}

void leave() {
  if (this_object()) {
    if (environment()) {

      message("vision", HIB + name() +
        "化为地上的一朵鲜花。\n" NOR, environment());
    }
    destruct(this_object());
  }
  return;
}

void check_room() {
  object me = this_object();
  object env = environment(me);
  if (!living(me)) return;
  if (env && (env->query("no_fight") ||
    env->query("no_magic"))) {
    random_move();
  }
}
void heart_beat() {
  object guai = this_object();
  /*        if (!query_temp("weapon") && !query_temp("added"))
        {
        	set_temp("added", 1);
        	set("force_factor",200);
        	set("force",2000);
        }*/
  if (query("eff_kee") < query("max_kee")) {
    if (random(10) < 5)
      command("eat yao");
    else
      call_out("exertheal", 1, this_object());
  }

  ::heart_beat();

}
varargs int receive_damage(string type, int damage, object who) {
  object me = this_object();
  call_out("exertheal", 1, me);
  return ::receive_damage(type, damage, who);
}

void exertheal(object me) {
  me->command("exert recover");

}

int do_block(string arg) {
  object me = this_object();
  object who = this_player();
  string verb = query_verb();
  int t;


  if (!userp(who)) return 0;


  if (who->query_temp("baohu_kill") == 0) return 0;

  if (verb != "go" &&
    verb != "fly" &&
    !(environment() && environment()->query("exits/" + verb)))
    return 0;

  t = random(1);

  if (t == 1) {

    message_vision("$n不管$N死活，撒手跑了。\n", me, who);
    return 0;
  }

  message_vision("$N一伸手拦在$n面前，高声叫道：\n" +
    " 死妖怪，还不来就我，我要死了。\n\n", me, who);
  tell_object(who, me->name() + "一把拦住了你！\n");
  return 1;
}
