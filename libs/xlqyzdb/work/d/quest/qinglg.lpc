inherit ROOM;

void create() {
  set("short", "玉虚宫前");
  set("long", @LONG
        　　
    过了麒麟崖，行至玉虚宫,只见门外奇花布锦，桥边瑶草生香；
岭上蟠桃红锦烂，洞门茸草翠丝长。时间仙鹤唳，每见瑞鸾翔；仙
鹤唳时，声振九臬霄汉远；瑞鸾翔处，毛辉五色彩云光。白鹿玄猿
时隐现，青狮白象任行藏；细观灵福地。

LONG);
  set("exits", ([
    "northup": __DIR__ "fengshentai",
    "southdown": __DIR__ "wutx",
    "enter": __DIR__ "yuxugong",
  ]));

  set("outdoors", __DIR__);

  setup();

}
