#include <ansi.h>

inherit NPC;
string *list = ({ "xian-jjf", "xian-jjf2", "xian-jjf3", "xian-hyd",
  "xian-fangcun", "xian-hell", "xian-jjf4", "xian-dragon1",
  "xian-dragon2", "xian-moon", "xian-xueshan1", "xian-dragon3", "xian-pansi",
  "xian-putuo", "xian-shushan", "xian-wdd",
});


void create() {
  set_name(HIB "通天教主" NOR, ({ "tongtian jiaozhu", "tongtian", "jiaozhu" }));
  set("title", HIR "截教掌教" NOR);
  set("long", "穿大红白鹤绛绡衣，手执宝剑,全无道气，一脸凶光。\n");
  set("gender", "男性");
  set("age", 13500);
  set("str", 40);
  set("per", 40);
  set("attitude", "peaceful");
  set("combat_exp", 10000000);
  set("daoxing", 10000000);
  set("eff_kee", 10000);
  set("eff_sen", 10000);
  set("max_kee", 10000);
  set("max_sen", 10000);
  set("sen", 10000);
  set("kee", 10000);
  set("max_force", 10000);
  set("max_mana", 10000);
  set("mana", 10000);
  set("force", 20000);
  set("force_factor", 500);
  set("mana_factor", 500);
  set_skill("dao", 301);
  set_skill("spells", 301);
  set_skill("force", 301);
  set_skill("yaofa", 301);
  set_skill("whip", 301);
  set_skill("staff", 301);
  set_skill("blade", 301);
  set_skill("spear", 301);
  set_skill("hammer", 301);
  set_skill("dengxian-dafa", 301);
  set_skill("tonsillit", 301);
  set_skill("gouhunshu", 301);
  set_skill("ningxie-force", 301);
  set_skill("huntian-qigong", 301);
  set_skill("stick", 301);
  set_skill("dodge", 301);
  set_skill("unarmed", 301);
  set_skill("parry", 301);
  set_skill("sword", 301);
  set_skill("pingtian-dafa", 301);
  set_skill("huomoforce", 301);
  set_skill("fork", 301);
  set_skill("literate", 301);
  map_skill("force", "huomoforce");
  map_skill("spells", "dao");

  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: cast_spell, "light" :),
    (: cast_spell, "thunder" :),
    (: cast_spell, "dingshen" :),
    (: cast_spell, "fenshen" :),
    (: exert_function, "fire" :)
  }));
  setup();
  carry_object("/d/quest/obj/pao2")->wear();
}

int accept_fight(object me) {

  return 1;
}

int recognize_apprentice(object me) {
  object ob = this_player();

  if (!(int)ob->query_temp("mark/魔"))
    return notify_fail(HIR "看起来" HIC "通天教主" HIR "想杀死你！\n" NOR);
  if ((ob->query("family/family_name") != "阎罗地府"
    && ob->query("family/family_name") != "陷空山无底洞"
    && ob->query("family/family_name") != "大雪山"
    && ob->query("family/family_name") != "火云洞")
    || ob->query("combat_exp") < 2000000)
    return notify_fail(HIR "看起来" HIC "通天教主" HIR "想杀死你！\n" NOR);

  ob->add_temp("mark/魔", -1);
  return 1;
}

void init() {
  add_action("do_task", "newtask");
  add_action("do_cancel", "cancel");
}

int do_task() {
  object me = this_player();
  object guai, obj;
  int level, i, t, lv;
  string bugs;
  string kind, where, msg;


  if ((me->query("family/family_name") != "大雪山"
    && me->query("family/family_name") != "陷空山无底洞"
    && me->query("family/family_name") != "火云洞"
    && me->query("family/family_name") != "阎罗地府"))

  {
    message_vision(CYN "\n通天教主道：你不是我截教门人,速速离开。\n" NOR, me);
    return 1;
  }

  me->command("say 敢问教主，招弟子前来何事？");

  if (me->query("combat_exp") < 3000000) {
    message_vision(CYN "\n通天教主恨恨的说：你小子就这点本事？一边玩去。\n" NOR, me);
    return 1;
  }
  if (me->query("obstacle/number") < 34) {
    message_vision(CYN "\n通天教主道：你尚未历经劫难，得成正果，还是先下山修炼去吧。\n" NOR, me);
    return 1;
  }
  if (me->query("yao/get")) {
    message_vision(CYN "\n通天教主说道：我不是已经给了任务你吗，快快起程。\n" NOR, me);
    return 1;
  }

  t = (int)me->query("yao/start_time");
  if (me->query("yao/fail")) {
    if (objectp(obj = me->query("yao/guai"))) destruct(obj);
    if (t <= time() && time() < t + 900) {
      message_vision("$N沉思片刻说:" +
        "：这位" + RANK_D->query_respect(me)
        + "你自身修行不够,还是不妨先去自行修炼。\n",
        this_object(), me);
      return 1;
    }
    me->delete("yao/fail");
  } else {
    if (t <= time() && time() < t + 360) {
      message_vision("$N用赞许的目光看着你，说" +
        "：这位" + RANK_D->query_respect(me)
        + ",干得不错,不妨先去歇息。\n",
        this_object(), me);
      return 1;
    }
  }




  //确定任务等级
  lv = random(10);

  if (lv <= 6) level = 3;
  if (lv <= 4) level = 2;
  if (lv <= 2) level = 1;
  if (lv == 7) level = 4;
  if (lv == 8) level = 4;
  if (lv == 9) level = 5;


  //确定任务种类
  i = random(4);
  if (i == 0) kind = "杀";
  else if (i == 1) kind = "擒";
  else if (i == 2) kind = "降";
  else kind = "劝";

  me->set("yao/get", time());
  me->set("yao/level", level);
  me->set("yao/kind", kind);
  bugs = list[random(sizeof(list))];
  //   write(bugs); 
  guai = new("/d/quest/xian/" + bugs);
  where = guai->invocation(me, level);
  switch (kind) {
    case "杀": {
      message_vision(CYN "\n通天教主说道：现有一阐教门徒" + where + "附近出现，此人
辱骂我截教，是可忍孰不可忍,你这就去把它杀掉吧。\n" NOR, me); break;
    }
    case "擒": {
      message_vision(CYN "\n通天教主说道：现有一散仙" + where + "附近出现，此人
根骨不错，你这就去把它生擒回来，教他入我截教。\n" NOR, me); break;
    }
    case "降": {
      message_vision(CYN "\n通天教主说道：现有一阐教门徒" + where + "附近出现，
处处与我作对，看在元始师兄面上,你只需狠狠教训它一顿即可。\n" NOR, me); break;
    }
    case "劝": message_vision(CYN "\n通天教主说道：现有一散仙" + where + "附近出现，此
人刚被逐出师门，你这就去劝他加入我教吧。\n" NOR, me);
  }
  me->set("yao/guai", guai);
  me->set("yao/where", where);
  me->set("yao/start_time", time());
  msg = me->name() + "接到一个难度" + chinese_number(level) + "的" + kind + "仙任务。";
  MONITOR_D->report_system_msg(msg);
  return 1;
}


int do_cancel() {
  object me = this_player();
  object obj;
  if (!me->query("yao/get")) {
    tell_object(me, "你没有任务在身。\n"); return 1;
  }

  me->command("say 这个任务弟子恐怕无能为力。");
  message_vision(CYN "\n通天教主说道：混账东西，只好我亲自下山一趟，你滚吧。\n" NOR, me);
  me->set("yao/fail", 1);
  me->delete("yao/get");
  if (objectp(obj = me->query("yao/guai"))) destruct(obj);
  return 1;
}
