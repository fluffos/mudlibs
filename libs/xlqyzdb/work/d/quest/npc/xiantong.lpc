#include <ansi.h>

inherit NPC;
string ask_qin(object me);
string ask_quan(object me);
string ask_sha(object me);
string ask_xiang(object me);
void create() {
  set_name(HIW "白鹤童子" NOR, ({ "baihe tongzi", "tongzi", "tong" }));
  set("gender", "男性");
  set("title", "元始天尊座下");
  set("long", "元始天尊座下白鹤童子是也");
  set("age", 20);
  set("attitude", "peaceful");
  set("str", 30);
  set("per", 30);
  set("max_kee", 3000);
  set("max_gin", 3000);
  set("max_sen", 3000);
  set("force", 6000);
  set("max_force", 3000);
  set("force_factor", 300);
  set("max_mana", 3000);
  set("mana", 6000);
  set("mana_factor", 200);
  set("combat_exp", 3000000);
  set("daoxing", 3000000);

  set_skill("unarmed", 150);
  set_skill("dodge", 170);
  set_skill("parry", 170);
  set_skill("sword", 150);
  set_skill("liangyi-sword", 150);
  set_skill("spells", 200);
  set_skill("dao", 180);
  set_skill("puti-zhi", 150);
  set_skill("wuxiangforce", 180);
  set_skill("force", 200);
  set_skill("jindouyun", 180);
  map_skill("spells", "dao");
  map_skill("unarmed", "puti-zhi");
  map_skill("force", "wuxiangforce");
  map_skill("parry", "qianjun-bang");
  map_skill("dodge", "jindouyun");
  set("chat_chance_combat", 100);
  set("chat_msg_combat", ({
    (: cast_spell, "light" :),
    (: cast_spell, "dingshen" :),
    (: cast_spell, "thunder" :)
  }));
  create_family("方寸山三星洞", 2, "弟子");
  set("inquiry", ([
    "擒": (: ask_qin :),
    "劝": (: ask_quan :),
    "杀": (: ask_sha :),
    "降": (: ask_xiang :),

  ]));
  setup();
  carry_object("/d/obj/cloth/sengyi")->wear();
  carry_object("/d/obj/weapon/sword/changjian")->wield();
}

string ask_qin(object me) {
  return ("就是把妖怪打昏，然后带回来交天尊处罚。\n");

}

string ask_quan(object me) {
  return ("就是在妖怪差不多打死的时候，用persuade命令，劝妖怪回山。\n");

}

string ask_sha(object me) {
  return ("就是把妖怪杀掉。\n");

}

string ask_xiang(object me) {
  return ("就是跟妖怪比武fight，打赢两次即可。如果guai受伤了,要给他jinchuang。\n");

}
