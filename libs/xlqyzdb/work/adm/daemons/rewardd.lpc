//以李靖的任务为基准,基本算法来自/d/dntg/yulong/yaoguai.c
//所传参数分别为 玩家who，奖励类型type("dx","exp","pot"),等级lv ( 0-->9)
//bugbug,2002.2.10


#define EXP_ADJUST 1.4
#define POT_ADJUST 1.6
#define DX_ADJUST  0.42

//DX = 0.42 * EXP

int reward(object who, string type, int lv) {
  int exp, exp_reward, pot_reward, dx_reward;

  if (lv > 9)
    lv = 9;
  if (lv < 0)
    lv = 0;

  exp = (who->query("combat_exp") +
    who->query("daoxing")) / 2;
  if (exp < 30000) {
    exp_reward = 500 + exp / 60;
    pot_reward = 200 + exp / 300;
  } else if (exp < 300000) {
    exp_reward = 1000 + exp / 600;
    pot_reward = 300 + exp / 6000;
  } else if (exp < 3000000) {
    exp_reward = 1500 + exp / 6000;
    pot_reward = 350 + exp / 20000;
  } else {
    exp_reward = 2000;
    pot_reward = 500;
  }

  exp_reward = exp_reward * (lv + 1) / 10;
  pot_reward = pot_reward * (lv + 1) / 10;

  exp_reward = (exp_reward) * EXP_ADJUST;
  pot_reward = (pot_reward) * POT_ADJUST;
  dx_reward = exp_reward * DX_ADJUST;

  if (type == "dx") {
    who->add("daoxing", dx_reward);
    return dx_reward;
  }
  if (type == "exp") {
    who->add("combat_exp", exp_reward);
    return exp_reward;
  }
  if (type == "pot") {
    who->add("potential", pot_reward);
    return pot_reward;
  }

  if (type == "all") {
    who->add("daoxing", dx_reward);
    who->add("combat_exp", exp_reward);
    who->add("potential", pot_reward);
    return exp_reward;
  }
}
