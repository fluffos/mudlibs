#include <ansi.h>

inherit F_CLEAN_UP;

mapping lists = ([
  "(admin)": HIW "★天   神" NOR "  (admin)   : ",
  "(arch)": HIG "★开发巫师" NOR "   (arch)   : ",
  "(wizard)": HIB "★管理巫师" NOR "  (wizard)  : ",
  "(apprentice)": HIG "★见习巫师" NOR "(apprentice): ",
  "(immortal)": HIM "★客座巫师" NOR " (immortal) : ",
  "(elder)": HIC "★当班巫师" NOR "  (elder)  : ",
]);


int level(mixed, mixed);

int main(object me, string arg) {
  string *list, hood = "", str;
  int j = 0;

  list = sort_array(SECURITY_D->query_wizlist(), (: level :));
  str = HIM "〖仙侣情缘〗" HIY "" NOR "巫师组全家福(本站暂时不招收巫师)\n";
  for (int i = 0; i < sizeof(list); i++, j++) {
    if (hood != wizhood(list[i])) {
      hood = wizhood(list[i]);
      if (j % 7) str += "\n";
      str += lists[hood];
      j = 0;
    }
    if (list[i] != "just" && list[i] != "yuzhen" && list[i] != "pizi" && list[i] != "yanp") str += sprintf("%s%s", list[i],
      (j % 7 == 6) ? "\n" : (i < sizeof(list) - 1 && hood == wizhood(list[i + 1])) ? "  " : "");
  }
  me->start_more(str);
  return 1;
}

int level(mixed ob1, mixed ob2) {
  if (wiz_level(ob1) != wiz_level(ob2))
    return wiz_level(ob2) - wiz_level(ob1);
  return ob1 < ob2 ? -1 : 1;
}

int help(object me) {
  write("\n指令格式 : wizlist\n"
    "用途 : 列出目前所有的巫师名单。\n"
  );
  return 1;
}
