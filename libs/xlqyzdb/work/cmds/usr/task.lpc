inherit F_CLEAN_UP;
#include <ansi.h>;
int main(object me, string arg) {
  string output;
  if (me->query("sen") < 100)
    return notify_fail("你的精神不够了!\n");
  me->add("sen", -20);

  output = "/adm/daemons/questd"->dyn_quest_list();
  me->start_more(output);
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 :task
显示仙侣奇缘使命榜。
HELP
  );
  return 1;
}
