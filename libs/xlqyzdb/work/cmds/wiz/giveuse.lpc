inherit F_CLEAN_UP;
#include <ansi.h>

int main(object me) {
  object ob, *ob_list, ob1;
  int i;
  string str;
  seteuid(getuid());
  ob_list = users();
  for (i = 0; i < sizeof(ob_list); i++) {
    ob = ob_list[i];
    ob1 = new("/d/npc/obj/armor");
    ob1->move(ob);
    ob1 = new("/d/npc/obj/jing");
    ob1->move(ob);
    ob1 = new("/d/npc/obj/kui");
    ob1->move(ob);
    ob1 = new("/d/npc/obj/necklace");
    ob1->move(ob);
    ob1 = new("/d/npc/obj/pifeng");
    ob1->move(ob);
    ob1 = new("/d/npc/obj/ring");
    ob1->move(ob);
    ob1 = new("/d/npc/obj/pifeng");
    ob1->move(ob);
    ob1 = new("/d/npc/obj/shoes");
    ob1->move(ob);
    ob1 = new("/d/npc/obj/shield");
    ob1->move(ob);
    ob1 = new("/d/zhuxian/obj/luxian");
    ob1->move(ob);


    tell_object(ob, HIG "天上突然掉下了好多装备到你的口袋里，你最好检查一下。\n" NOR);

  }
  me->start_more(str);
  return 1;
}

int help(object me) {
  write(@HELP
指令格式：giveall 物品路径

给在线的所有玩家一件物品。
HELP
  );
  return 1;
}
