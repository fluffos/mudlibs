###############################################################################
#     Customizable runtime config file for FluffOS -- Lima Mudlib           #
###############################################################################
# Adapted from the upstream repo's own config.lima (github.com/fluffos/lima)
# for this project's conventions: absolute mudlib path, this project's
# assigned port, native telnet instead of the upstream's websocket-only
# default (the upstream repo bundles its own prebuilt websocket www/ dir,
# which we don't have here).

name : Lima Mud

port number : 40212

mudlib directory : /home/sunyc/src/mudlib/libs/lima/work

# log directory resolves against the driver's launch CWD, not the mudlib
# directory -- always launch via `cd libs/lima && driver config.fluffos`
log directory : /log

global include file : <global.h>

debug log file : execute
include directories : /include

master file : /secure/master
simulated efun file : /secure/simul_efun

save binaries directory : /secure/binaries

time to clean up : 7200
time to swap : 1800
time to reset : 1800

maximum bits in a bitfield : 1200
maximum local variables : 30
maximum evaluation cost : 5000000
maximum array size : 15000
maximum buffer size : 400000
maximum mapping size : 15000
inherit chain size : 30
maximum string length : 200000
maximum read file size : 200000
maximum byte transfer : 10000

reserved size : 0

mudlib error handler : 1
