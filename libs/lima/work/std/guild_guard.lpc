#include <mudlib.h>

inherit ADVERSARY;
inherit M_BLOCKEXITS;

private
nosave string guard_for = "<no guild assigned yet>";

private
mixed handle_blocks(string dir)
{
   string *allies;
   mixed err;

   /* is the player a member of our guild or a member of an ally? */
   if (this_body()->query_member_guild(guard_for))
      return 0;

   /* GUILD_D->query_guild_allies() errors out for a guild name that was
    * never actually defined via GUILD_D (e.g. this guard was set up for
    * a guild that only exists in a sample/spec file that nobody loaded).
    * query_member_guild() above already treats an undefined guild as
    * "not a member" gracefully -- do the same here instead of letting an
    * uncaught error abort the player's move.
    */
   err = catch(allies = GUILD_D->query_guild_allies(guard_for));
   if (err)
      allies = ({});

   if (allies && sizeof(this_body()->guilds_belong() & allies) != 0)
      return 0;

   return ::handle_blocks(dir);
}

void mudlib_setup(string guild)
{
   ::mudlib_setup();

   guard_for = guild;

   set_name("guard");
   set_in_room_desc("A guard is here.");
   set_gender(1); // default male.
   set_block_action("The $n $vpush $t back. \"Guild members only\", $n $vgrowl.");
}
