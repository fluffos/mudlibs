//Yangzhou : yuelao_ci.c
//by trill 03/20/97

inherit ROOM;
inherit MARRIAGEROOM;

#include <ansi.h>

void create() {
  set("short", YEL "月老祠" NOR);
  set("long", @LONG
小小的祠庙，香火稀少，坐落在扬州城的北面的角落上。少有人员来往。偶然
有些年轻男女匆匆的进入，喜忧参半的离开。进得庙中，中间供着和蔼可亲的月老
月老面前一张供桌，两块跪石，简简单单的的陈设。
LONG
  );
  set("exits", ([ /* sizeof() == 3 */
    "southwest": __DIR__ "tianning_xiang",
  ]));
  set("wiz", 1);
  set("no_kill", "yangzhou");
  setup();
}

void init() {
  add_action("do_swear", "swear");
  add_action("do_annouce", "marry");
  add_action("do_divorce", "divorce");
  // add by xli 99.3 to give ring and xifu、hunsha and no lian gong
  add_action("do_giveob", "fa");
  add_action("do_bufa", "bufa");
  add_action("do_liangong", ({ "xiulian", "dazuo", "kill", "fight", "bihua", "lian", "exert" }));
}

int do_divore(string arg) {
  return 1;
}

int do_liangong(string arg) {
  tell_object(this_player(), "这里是办喜事的地方，怎么能在这里练功刹风景呢？赶快离开！\n");
  return 1;
}
int do_bufa(string arg) {
  object who, what;
  if (!wizardp(this_player())) {
    tell_object(this_player(), "你不是神仙，没有这个权限哦！\n");
    return 1;
  }
  who = get_object(arg);
  what = new("/clone/toy/marry/ring");
  what->move(who);
  tell_object(this_player(), "已经将戒指补发给了" + who->query("name") + "。\n");
  tell_object(who, "这是给你补发的结婚戒指，呵呵，不要再弄掉了哦！\n");
  return 1;
}

// the function
int do_giveob(string arg) {
  object me, man, woman, thing;
  string wiz_status, male_name, female_name;

  me = this_player();  // 发的人
  if (me != this_player(1)) return 0;

  wiz_status = SECURITY_D->get_status(me);
  if (wiz_status != "(admin)"
    && wiz_status != "(arch)"
    && wiz_status != "(wizard)"
    && wiz_status != "(apprentice)"
    && wiz_status != "(immortal)")
    return notify_fail("只有巫师才能发的，你可不要越俎代庖哦！\n");
  if (!arg)
    return notify_fail("use age: fa male female\n");

  if (sscanf(arg, "%s %s", male_name, female_name) != 2)
    return notify_fail("arg err.. fa male female\n");
  man = get_object(male_name);
  woman = get_object(female_name);
  if (man->query("gender") != "男性")
    return notify_fail("新郎是谁啊？\n");
  if (woman->query("gender") != "女性")
    return notify_fail("新娘是谁啊？\n");
  thing = new("/clone/toy/marry/xifu");
  thing->move(man);
  message_vision("$N凌空一指，一件西服飘然而至，落到了$n的身上...\n", me, man);
  thing = new("/clone/toy/marry/hunsha");
  thing->move(woman);
  message_vision("$N凌空一指，一件婚纱飘然而至，落到了$n的身上...\n", me, woman);
  thing = new("/clone/toy/marry/ring");
  thing->move(man);
  thing = new("/clone/toy/marry/ring");
  thing->move(woman);
  message_vision("$N手中腾起一朵小小的彩云，只听钟鼓齐鸣，仙乐飘飘，彩云散去后，两枚晶莹闪亮的结婚钻戒静静地躺在$N手心。\n", me);
  message_vision("$N轻轻将两枚钻戒交给了这对幸福的新婚夫妻，四下顿时响起了众神的祝福之声！\n", me);
  return 1;
}
