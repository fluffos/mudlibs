
void init()
{
    add_action( "do_enter", ({ "enter", "jinru" }) );
}

int do_enter( string arg )
{
    object xinfang, me;
    mapping owner;
    string *all_owner_id, owner_id, my_id;
    int i;
   
    me = this_player();
    my_id = me->query( "id" );

    if ( !arg ) arg = my_id; 
    if ( !xinfang = new( MISC_DIR + "xinfang.lpc" ) )
    {
        write( "create xinfang fail...\n" );
        return 0;
    }
    xinfang->restore();
    owner = xinfang->query( "owner" );
    all_owner_id = keys( owner );
    for ( i = 0; i < sizeof( all_owner_id ); i ++ )
    {
        if ( all_owner_id[ i ] == arg ||
            me->query( "have_married/" + all_owner_id[ i ] ) )
        {
            owner_id = all_owner_id[ i ];  
            break;
        }    
    }    
    if ( !owner_id )
    {
        write( "你想进入的新房还未创建。\n" );
        return 1;
    }
    if ( !me->query_temp( owner_id + " invited" ) )
    {
        write( "你未受主人邀请，不能进入他们的新房。\n" );
        return 1;
    }

    xinfang->set_temp( "owner_id", owner_id ); 
    xinfang->change_description( owner_id );
   
    message( "vision", me->query( "name" ) + "离开这里。\n", 
        environment( me ), ({ me }) );
    tell_object( me, "你进入了" + short + "。\n" );
        me->move( xinfang );
    message( "vision", me->query( "name" ) + "进入了这里。\n",
        environment( me ), ({ me }) );
    return 1;
}

