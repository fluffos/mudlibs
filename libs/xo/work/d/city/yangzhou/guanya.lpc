// Room: /d/city/yangzhou/guanya.c

#include <ansi.h>
inherit ROOM;

string look_north();

void create() {
  set("short", YEL "扬州官衙" NOR);
  set("long", @LONG
一个不大的院子，几个衙役面无表情的站着。北向升阶而上为一朱红大门，
上面有一匾额「扬州」，大门半掩着，依稀可以看到几个人影。一边架子摆着个
皮鼓，挂着一对木棰。朝西，是一月洞门，门额上刻着隶书「郡圃」。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "west": __DIR__ "tianjing",
    "south": __DIR__ "tongsi_jie",
    "north": __DIR__ "gongtang",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/yayi": 4,
  ]));
  set("item_desc", ([
    "north": (: look_north :),
  ]));
  set("no_clean_up", 0);
  set("outdoors", "yangzhou");

  setup();
}

string look_north() {
  return "大门半掩者，你看不清楚里面的东西。\n";
}

int valid_leave(object me, string dir) {
  object ob;
  if (dir == "west")
    if (objectp(ob = present("ya yi", environment(me)))
      && living(ob)) {
      message_vision("数个衙役围了过来，对$N叱到：官衙重地，休得乱闯！\n", me);
      return notify_fail("看来你是过不了衙役这一关了。\n");
    }
  return ::valid_leave(me, dir);
}
