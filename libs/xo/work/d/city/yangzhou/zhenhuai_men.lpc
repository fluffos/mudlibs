//Yangzhou : zhenghuai_men.c 镇淮门
//by trill 03/20/97 & lala 1997-12-11

inherit ROOM;
#include "men.h"
#include <ansi.h>

void create()
{
    set("short", YEL"镇淮门"NOR);
    set("long",@LONG
这是扬州的北门「镇淮门」，城门两边站着几个士兵，盘查着过往行人车辆。
门前有一道深深的护城河，左右各开一水门，连接护城河和官河及小秦淮河。城
门建有高高的门楼，上有几个士兵持枪在警戒。门楼上悬着金字匾额「镇淮门」。
城门口贴着几张榜文。出了北门就是上汴京的官道。
LONG
    );
    set("bangwen", "yangzhou");
    set("no_clean_up", 0);
    set("no_kill", "yangzhou");
    set("exits",([ /* sizeof() ==  */
        "northeast" : __DIR__"hangou2", 
        "south"     : __DIR__"beimen_dajie",
        "up"        : __DIR__"chenglou",
    ]));
    set("objects", ([ /* sizeof() == */
        __DIR__"npc/xiaowei" : 1,
        __DIR__"npc/shibing1" : 1,
        __DIR__"npc/shibing2" : 1,
    ]));
    set("detail" , ([ /* sizeof() == */
        "榜文"      : (: look_bangwen :),
        "bangwen"   : (: look_bangwen :),
        "bang wen"  : (: look_bangwen :),
    ]));

    setup();
}
int valid_leave(object me, string dir)
{
    if ( me->query("no_leave_yangzhou") && dir == "northeast" )
    {
        write("你现在不能离开扬州。\n");
        return 0;
    }
    return ::valid_leave( me, dir );
}


