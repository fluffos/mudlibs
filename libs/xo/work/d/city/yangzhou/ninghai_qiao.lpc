inherit ROOM;
#include <ansi.h>

void create() {
  set("short", YEL "宁海桥" NOR);
  set("long", @LONG
宁海桥是一座新建的联拱石桥，座落在小秦淮河上，是连接扬州新旧两城的
要道，因此修的极为宽阔平整，可供四辆马车同时并行。桥名由现任知州欧阳修
亲笔题写，悬在桥的两侧。桥的东南边有一个码头，许多船只停靠着。西边是扬
州旧城的甘泉街。
LONG
  );
