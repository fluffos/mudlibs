//Npc : teacher.c
//by trill 05/07/97

#include <ansi.h>
inherit NPC;

void create() {
  set_name(YEL "吴古贤" NOR, ({ "wu guxian", "wu", "teacher" }));
  set("title", "资政书院先生");
  set("gender", "男性");
  set("age", 55);
  set("long", @LONG
吴古贤据说在资政学院已经教了十几年的书，年纪也大了，变的越来越
迂腐，学问和年轻时差的远了；又当今的大儒增先生开始授课，吴先生
的资政学院几乎成了一些顽劣儿童的乐园。
LONG
  );
  set("attitude", "peaceful");
  set("combat_exp", 10);
  set("social_exp", 100000);
  set("positive_score", 100);
  set("str", 15);
  set("cor", 18);
  set("cps", 20);
  set("per", 21);
  set_wugong("literate", 60, 60, 0);
  set("talk_msg", ({
    "现在的孩子呀，唉！！！！！\n",
    "老朽已经不中用了，该回老家过过清闲日子了。",
    "教几十年的书，学问却越来越差了，唉。。。。",
  }));
  set("inquiry", ([
    "戒尺": "戒尺，这把戒尺我已有十数年未用了。"
    "说完，吴古贤长叹一声。",
  ]));
  setup();
  carry_object(CLOTH_DIR "mabu_kuanshan")->wear();
  carry_object(HEAD_DIR "mabu_toujin")->wear();
  carry_object(WAIST_DIR "chahe_luandai")->wear();
  carry_object(BOOTS_DIR "sixie")->wear();
}

int valid_teach(object me, string skill) {
  if (me->query_temp("can_teach_wu")) {
    me->add_temp("can_teach_wu", -1);
    return 1;
  }
  return 1;
}

int accept_object(object me, object ob) {
  if (ob->value() >= 5000) {
    me->add_temp("can_teach_wu", ob->value() / 5000);
    message_vision("吴古贤对$N笑道：既然你如此有向学之心，我就教你吧。\n", me);
    return 1;
  }
  return 0;
}
