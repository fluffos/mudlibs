//longjing.c

inherit ITEM;

void create()
{
//实际玩家买到应该是个茶壶。一开始是满的。
	set_name("龙井茶",({"cha hu", "hu"}));
 	set_weight(120);
	if (clonep())
		 set_default_object(__FILE__);
	 else {
 		set("long", "一壶新沏的龙井茶，悠悠地冒着香气~~~~~~\n");
		set("unit", "壶");
 		set("value", 80);
        set("remaining",10);
	set("drink_supply", 20);
    }

 setup();
}

void init()
{
	add_action("do_drink", "drink");
	add_action("do_fill", "fill");
}

int do_fill(string arg)
{
	object me = this_player();
	int afford, price, base;
	if ( !arg ) return 0;

	if ( environment(me)->query("chashi") ) return 0;
	
	if ( query("remaining") >= 10 ) return notify_fail("你的茶壶是满的。\n");

	if ( arg != "龙井茶" && arg != "魁尖" && arg != "富春茶" 
		&& arg != "安徽魁尖" && arg != query("id") ) 
		return notify_fail("你要想要在壶里装什么茶？\n");
	if ( arg == query("id") ) arg = "龙井茶";
	switch ( arg ) {
		case "龙井茶" :
			base = 6;
			break ;
		case "魁尖" : case "安徽魁尖" :
			base = 5;
			break ;
		case "富春茶":
			base = 4;
			break;
	}	
	price = 10 * base;
	if ( afford = me->can_afford(price) ) {
    	if ( afford == 2 ) 
			return notify_fail("你没有足够的零钱，而对方也找不开银票...。\n");
       	me->start_busy(1);
	    me->pay_money(price, 0);
	    me->save();
	}
	set("remaining", 10);
	set("name", arg);
	set("unit", "壶");
	set("long", "一壶新沏的"+arg+"，悠悠地冒着香气~~~~~~\n");
	return notify_fail("茶博士把你的茶壶给重新沏满"+arg+"了。\n");
}

int do_drink(string arg)
{

    int heal, recover, jin, e_jin, m_jin, remaining;
	
	heal = 2;
	recover = 3;

	if( arg != "tea" && arg !="hu" && arg !="cha hu" 
		&& arg != "cha" ) return 0;

	if( this_player()->is_busy() )
    	return notify_fail("你上一个动作还没有完成。\n");

    if(   (int)this_player()->query("water")
      	 >= (int)this_player()->max_water_capacity() )
		return notify_fail("你已经喝太多了，再也灌不下一滴水了。\n");
	
	if ( !remaining = query("remaining") ) return notify_fail("这个茶壶是空的。\n");

	if( this_player()->is_fighting() ) return notify_fail("你在战斗，还是老实一点比较安全。\n");

	set("value", (int)query("value")-10);
	jin = (int)this_player()->query("jin");
	e_jin = (int)this_player()->query("eff_jin");
	m_jin = (int)this_player()->query("max_jin");
	this_player()->add("water", (int)query("drink_supply"));

    if ( remaining > 1) {
		add("remaining", -1);
	   	message_vision("$N端起茶壶，喝下一口"+query("name")+"。细细品味，只觉得\n"+
     	 "一股香气直入心脾，$N觉得精神好多了。\n", this_player());
    }
	else {
		add("remaining", -1);
    	message_vision("$N端起茶壶，把剩下的"+query("name")+"一饮而尽。\n"+
     	 "一股香气直入心脾，$N觉得精神好多了。\n", this_player());
     	set("long", "一个空茶壶。\n");
     	set("name", "茶壶");
     	set("unit", "个");
    }
    if ( e_jin < m_jin ) e_jin += heal;
    if ( jin < e_jin ) {
    	if ( (jin + recover) > e_jin ) jin = e_jin;
    	else jin += recover;
    }
    this_player()->set("jin", jin);
    this_player()->set("e_jin", e_jin);
    return 1;
}
