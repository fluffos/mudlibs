inherit CLOTH;

void create()
{
	set_name("", ({"", "cloth"}));
	set_weight(1500);
	if ( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "");
		set("unit", "套");
		set("value", );
		set("material", "cloth");
		set("armor_prop/armor", 2);
	}
	setup();
}



