//Npc popi2.c
//by trill 05/02/97

inherit NPC;

string talk_me();

void create()
{
    set_name("李是五", ({"po pi","punk"}) );
    set("gender", "男性" );
    set( "title", "泼皮" );
    set("age", 20);
    set("long", "这人是个泼皮，整天无所事事，到处闲逛。。\n");
    set_wugong( "unarmed", 100, 100, 1 );
    set_wugong( "jiben-qinggong", 100, 100, 1 );
    set_xiuwei_by_type( "unarmed", 300 );
    set_xiuwei_by_type( "dodge", 300 );
    set("combat_exp", 2000);
    set("str", 25);
    set("per", 20);
    set("inquiry", ([
        "here" : "挣大眼睛自己看看，没看老子正忙着吗？！",
    ]) );
    set("no_leave_yangzhou", 1);
    set("talk_msg", ({
        (: talk_me :)
    }));
    setup();
    set("chat_chance", 30);
    set("chat_msg", ({
"李是五骂骂咧咧的说道：赌场老板真他妈不是东西，老子欠债又不\n"
"是不能还了，竟敢把老子轰出来？！\n",
"李是五盯着自己的手看了半天，咕咕囔囔的叨唠着：”真是怪事，这\n"
"手尽抓瘪十！？\n",
"妈的！李是五不满的嘟囔着：人都他妈死绝了，老子一没钱了，连个\n"
"鬼影都见不到了！\n",
    (:random_move:),
    }) );
    carry_object(__DIR__"obj/po_yi")->wear();
}

string talk_me()
{
    object me, ob;
    me = this_player();
    ob = this_object();
    switch ( random( 3 ) )
    {
    case 0 :
        tell_object( me, "李是五说道：去去，一边去，大爷正烦着呢！\n");
        break;
    case 1 :
        tell_object( me, "李是五打量者你，不知道想做些什么。\n");
        break;
    case 2 :
        command( "whisper " + me->query( "id" ) + " 我知道个秘密，怎么样，咱最近手头有点紧。\n");
        command( "hehe " + me->query( "id" ) );
        me->set_temp("popi_talk", 1);
        break;
    }
    return "";
}

int accept_object(object me, object ob)
{
    int val;

    val = ob->value();
    if ( val < 5000  )
    {
        message_vision("李是五对$N一翻大眼，这么一点钱就想打发大爷我？\n", me);
        command( "kick " + me->query( "id" ) );
        return 0;
    }
    if ( me->query_temp( "popi_talk" ) )
        command( "whisper " + me->query("id") + " 那晚我从府衙路过，见到有人从墙头越出呢！" );
    else
    {
        command( "look " + me->query( "id" ) );
        command( "say 现在真是怪事多，还到处硬塞钱的，那我就收下了。");
    }
    return 1;
}
