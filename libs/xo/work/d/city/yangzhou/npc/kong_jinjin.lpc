// waiter.c

#include <ansi.h>
inherit NPC;
inherit F_VENDOR;

void create() {
  set_name(YEL "孔进金" NOR,
    ({ "kong jinjin", "kong", "jinjin", "seller", "boss" }));
  set("gender", "男性");
  set("title", "孔家头巾铺老板");
  set("age", 47);
  set("long", @LONG
孔进金孔老板开了这家头巾铺已经有好几年了，颇受大家的好评，他的
生意也越做越大，可是他却不享清福，仍然亲自站柜台，招呼生意。这
样既省了人手又可以监视伙计们，让他们没有偷懒的机会。
LONG
  );
  set("talk_msg", ({
    "哟，客官，一看您就是练武的人，练武人戴块青色的头巾最好了。",
    "客官，您听说没有，大理的段王爷出钱开通了到大理的马车。",
    "来，客官，选一块喜欢的头巾吧，我给您打个九五折怎么样？",
    "呵呵，客官，您要是不买您就多看看货色，我这儿还忙着呢。",
  }));
  set("inquiry", ([
    "头巾": "哎，一看您就是有眼光的主儿，要不怎么想买咱家的头巾呢？",
    "here": "哎哟，客官，您是头回来扬州吧？好好转转吧。",
  ]));
  set("attitude", "friendly");
  set("rank_info/respect", "老哥");
  set("rank_info/rude", "老王八蛋");
  set("vendor_goods", ([
    "范阳毡大帽": HEAD_DIR "damao",
    "麻布头巾": HEAD_DIR "mabu_toujin",
    "遮尘暖帽": HEAD_DIR "nuanmao",
    "青纱抓角头巾": HEAD_DIR "qingsha_jin",
    "三山帽": HEAD_DIR "sanshan_mao",
    "万字巾": HEAD_DIR "wanzi_jin",
    "一字巾": HEAD_DIR "yizi_jin",
    "皂纱转角簇花巾": HEAD_DIR "zaosha_huajin",
    "红缨毡帽": HEAD_DIR "zhanmao",
  ]));
  set("positive_score", 10);
  set("no_kill", "yangzhou");
  set("combat_exp", 100);
  set("social_exp", 100);

  set_xiuwei_by_type("unarmed", 50);
  setup();
  carry_object(CLOTH_DIR "cloth4")->wear();
}

void init() {
  object ob = this_player();
  ::init();
  if (this_object()->can_act()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  message_vision("孔老板见有人进来，连忙吆喝：“瞧一瞧，看一看，咱家的头巾真不赖！”\n",
    ob);

}
