//Npc : yang_wanxiao.c
//by trill 05/13/97

inherit NPC;
#include <ansi.h>

string ask_room1();

void create()
{
    set_name( YEL "杨万萧" NOR, ({"yang wanxiao", "wang", "wanxiao"}) );
    set( "age", 48 );
    set( "int", 25 );
    set( "con", 26 );
    set( "per", 22 );
    set( "attribute", "peaceful" );

    set( "long", @LONG
杨家是扬州名门望族，杨万萧是杨府现今的主人，五柳长须，
看上去很是儒雅，据说杨万萧诗文做的极好，和现任知州－
欧阳修是好友，经常是做诗相和。
LONG
    );
    set( "combat_exp", 10000 );
    set( "social_exp", 30000 );
    set( "positive_score", 10000 );

    set_wugong( "literate", 100, 100, 0 );

    set( "no_kill", "yangzhou" );
    set( "inquiry", ([
        "小玲珑山馆" : (: ask_room1 :),
        "杨府" : (: ask_room1 :),
        "扬州" : "天下三分明月夜，无奈二分在扬州，哈哈。。。",
    ]) );
    set( "talk_msg", ({
        "。。。只是从你微微一笑，却什么也不说。",
    }) );
    setup();
    carry_object( CLOTH_DIR "mabu_kuanshan" )->wear();
}


string ask_room1()
{
    return "那是祖上留下的，不过却也是有些特色了。\n";
}

