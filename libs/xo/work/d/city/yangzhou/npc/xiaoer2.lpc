// xiaoer2.c

#include <ansi.h>

inherit NPC;
inherit F_VENDOR;
void create()
{
	set_name(YEL "店小二" NOR, ({ "xiao er","waiter"}) );
	set("gender", "男性" );
	set("age", 22);
	set("long",
	"店小二身穿青布衣衫，肩上搭着块白布巾，正在忙着招呼客人。\n"
	);
	set("combat_exp", 1200);
	set("chat_chance_combat", 5);
	set("chat_msg_combat",({
		"店小二大声喊道：“你不要命了，敢在扬州城里杀人放火了？！！！”\n",
		"店小二边打边喊：“杀人啦！！救命啊！！！”\n",
	}) );
/*	set("inquiry", ([
		"二楼" : "我也没去过，老板吩咐了，没有请帖的一律不让上。\n",
	]) );        
	*/
	set("attitude", "friendly");
	set("rank_info/respect", "小二哥");
	set("vendor_goods", ([
	    "干菜包子" : FOOD_DIR "gancai", 
        "生肉蒸饺" : FOOD_DIR "jiaozi",
        "荠菜包子" : FOOD_DIR "jicai",
        "糯米烧卖" : FOOD_DIR "nuomi",
        "三丁包子" : FOOD_DIR "sanding",
        "翡翠烧卖" : FOOD_DIR "shaomai",
        "生肉包子" : FOOD_DIR "shengrou",
        "水晶包子" : FOOD_DIR "shuijing",
        "笋肉包子" : FOOD_DIR "sunrou",
        "小菜包子" : FOOD_DIR "xiaocai",
        "蟹黄包子" : FOOD_DIR "xiehuang",
        "稀沙包子" : FOOD_DIR "xisha",
        "芝麻包子" : FOOD_DIR "zhima",
        "鸭菜包子" : FOOD_DIR "yacai",
        "千层油糕" : FOOD_DIR "yougao",
        "火腿粽子" : FOOD_DIR "zongzi",
       
    ]) );
	setup();
	carry_object(__DIR__"obj/qingbu_yi")->wear();

}

void init()
{
	object ob;
	::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
	add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	switch( random(5) ) {
	case 0 : case 1 :
		break;
	case 2:
		say( "店小二用肩上的白布巾抹了抹桌子，说道：这位" + RANK_D->query_respect(ob)
			+ "，请这边坐。\n");
		break;
	case 3:
		say( "店小二说道：这位" + RANK_D->query_respect(ob)
		+ "，本店刚从外地进了一批好酒，不想尝尝？\n");
		break;
	case 4:
		say("店小二用肩上的白布巾抹了抹桌子，说道：这位" + RANK_D->query_respect(ob)
		+ "，您是要喝酒还是点菜？\n");
		break;
	}
}
