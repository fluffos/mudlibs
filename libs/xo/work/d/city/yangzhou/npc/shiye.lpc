//Npc : shiye.c
//by trill 05/03/97

inherit NPC;

string ask_xinfang();

void create() {
  set_name("刘飞扬", ({ "liu feiyang", "liu", "shiye" }));
  set("gender", "男性");
  set("age", 40);
  set("title", "扬州官衙师爷");
  set("attribute", "peaceful");
  set("long", @LONG
他看上去甚是友善，却总使人感到难以亲近，也许是身上的官架子
始终去不掉，使人有种虚伪的感觉。
LONG
  );
  set_wugong("unarmed", 40, 40, 1);
  set_wugong("jiben-qinggong", 40, 40, 1);
  set_xiuwei_by_type("unarmed", 100);
  set_xiuwei_by_type("dodge", 100);

  set("combat_exp", 1000);
  set("inquiry", ([
    "新房": (: ask_xinfang :),
    "买新房": (: ask_xinfang :),
  ]));
  set("str", 25);
  set("per", 20);
  set("con", 26);
  set("int", 25);

  setup();
  carry_object(CLOTH_DIR + "baiduan_shan")->wear();
}

string ask_xinfang() {
  object xinfang, me;

  me = this_player();
  if (me->query("age") < 18)
    return "你还太小，等到成人再买也不迟啊。\n";
  if (this_player()->query("have_room"))
    return "你有自己的房子了，现在一人只能有一间。\n";
  if (!me->query_temp("can_buy_xinfang") && !wizardp(me))
    return "买房子先交钱，现在涨价了，一百二十两金子一间。\n";

  if (!xinfang = load_object(MISC_DIR "xinfang")) {
    return "无法创建..请报告巫师.";
  }
  this_player()->set("have_room", 1);
  xinfang->set(getuid(me), ([ "short": "空房子",
    "long": "这是一间什么都没有的空房子.\n" ]));
  xinfang->save();
  this_player()->save();
  return "呵呵，你的新房在通泗街的南面，不过现在可是空屋子。别忘了自己改改啊。\n";
}

int accept_object(object me, object item) {
  object xinfang;
  if (me->query("age") < 18) {
    command("say 你还太小，等到成人再买也不迟啊。\n");
    return 0;
  }
  if (me->query("have_room")) {
    write("刘师爷说道：你有自己的房子了，现在一人只能有一间。\n");
    return 0;
  }
  if (item->value() < 1200000) {
    write("刘师爷不满的说道：我说过是一百二十两金子一间。\n");
    return 0;
  }
  xinfang = load_object(MISC_DIR "xinfang");
  if (!xinfang)
    return 0;
  xinfang->set(getuid(me), ([ "short": "空房子",
    "long": "这是一间什么都没有的空房子.\n" ]));
  xinfang->save();
  this_player()->save();
  write("\n刘师爷笑道：呵呵，你的新房在通泗街的南面，不过现在可是空屋子。\n");
  return 1;
}
