// qiang_w.c

#include <ansi.h>
#include <dbase.h>
#include <armor.h>

inherit NECK;

void create() {
  set_name(MAG "紫蔷薇" NOR, ({ "qiang wei" }));
  set_weight(100);
  set("long", "一朵明丽的" + query("name") + "。\n");
  set("value", 20);
  set("unit", "朵");
  set("armor_prop/armor", 1);
  set("female_only", 1);
  setup();
}

int init() {
  add_action("do_wear", "wear");
  add_action("do_wear", "dai");
  add_action("do_remove", "remove");
  add_action("do_remove", "zhai");
  add_action("do_smell", "smell");
  add_action("do_smell", "wen");
}

int do_wear(string arg) {
  object flower = this_object();
  string name = flower->query("name");
  string msg;

  if (arg != "flower")
    return 0;

  if (this_player()->query("gender") != "女性") {
    return 0;
  }
  switch (random(4)) {
    case 0:
      { msg = "$N拿起" + name + "轻轻插在发际，低头婉尔一笑。\n"; break; }
    case 1:
      { msg = "$N将" + name + "轻轻别在发际，不禁满面羞红。\n"; break; }
    case 2:
      { msg = "$N温柔地把" + name + "别在发鬏上。双眉一弯，甜甜地笑了。\n"; break; }
    case 3:
      { msg = "$N将长发轻轻一甩，将" + name + "别在上面。\n"; break; }
  }
  flower->set("wear_msg", msg);
  return 0;
}

int do_remove(string arg) {
  object flower = this_object();
  string name = flower->query("name");
  string msg;

  if (arg != "flower")
    return 0;

  if (this_player()->query("gender") != "女性") {
    tell_object(this_player(), "一个大男人，带什么花？");
    return 0;
  }

  msg = "$N将" + name + "轻轻地摘下来……\n";
  flower->set("unequip_msg", msg);
  return 0;
}

int do_smell(string arg) {
  object me = this_player();
  object flower = this_object();
  string name = flower->query("name");
  string msg;

  if (arg != "flower")
    return 0;

  if (this_player()->query("gender") != "女性") {
    msg = "$N拿起" + name + "闻了闻，一股香气扑鼻。\n";
  } else {
    switch (random(4)) {
      case 0:
        { msg = "$N轻轻闻着" + name + "的扑鼻香气，不禁痴了……\n"; break; }
      case 1:
        { msg = "$N捧着" + name + "闻了一下：幸福地笑了。\n"; break; }
      case 2:
        { msg = "$N低头看着手中的" + name + "，思绪竟仿佛这花香一样越飘越远。\n"; break; }
      case 3:
        { msg = "$N低头将" + name + "轻轻一嗅，不禁晕红满面。\n"; break; }
    }
  }
  message_vision(YEL + msg + NOR, me);
  return 1;
}
