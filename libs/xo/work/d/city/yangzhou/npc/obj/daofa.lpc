// jianshu.c

inherit ITEM;

void create()
{
    set_name("「刀术」", ({ "daoshu rumen", "book", "shu" }));
    set_weight(300);
        if( clonep() )
                set_default_object(__FILE__);
        else {
        set("unit", "本");
        set("long",     "这是一本普普通通的介绍刀法的书，字迹很是潦草。\n");
        set("value", 20);
        set("material", "paper");
       set("skill", ([
                        "name"             :  "jiben-daofa",  
                        "xiuwei_required"  : 10,
                        "literate_required" : 20,
                        "gin_cost"         : 10+random(10),
                        "max_jibie"        : 80,
                        "max_lingwu"        : 20,
                        "bonus_jilei"      : 0,
                        "bonus_xiuwei"     : 2,
//                      "max_xiuwei"       : 400,
                        "bonus_combat_exp" : 1,
                        "max_combat_exp"   : 1000,
                        "bonus_social_exp" : 0,
//                      "max_social_exp"   : 0,
                ]) );
        }
}
