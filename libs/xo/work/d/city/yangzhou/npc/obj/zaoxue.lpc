#include <armor.h>

inherit BOOTS;

void create() {
  set_name("皂靴", ({ "zao xue", "xue", "boots" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "双");
    set("value", 200);
    set("material", "cloth");
    set("armor_prop/armor", 1);
    set("armor_prop/dodge", 4);
  }
  setup();
}
