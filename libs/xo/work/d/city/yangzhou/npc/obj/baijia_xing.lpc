// baijia_xing.c

inherit ITEM;

void create() {
  set_name("百家姓", ({ "baijia xing", "shu" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long",
      "这是一本很是破旧的百家姓，人们通常用来学习读书识字。\n"
    );
    set("value", 70);
    set("material", "paper");
    set("skill", ([
      "name": "literate",
      "exp_required": 0,
      "sen_cost": 20,
      "difficulty": 20,
      "max_skill": 10, ]));
  }
}
