// jianshu.c

inherit ITEM;

void create() {
  set_name("「乡书」", ({ "xiang shu", "book", "shu" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "这本书封皮有点旧，上面写着「乡书」几个字。\n");
    set("value", 1000);
    set("material", "paper");
    set("skill", ([
      "name": "literate",
      "xiuwei_required": 0,
      "literate_required": 20,
      "gin_cost": 5 + random(10),
      "max_lingwu": 60,
      "bonus_jilei": 10,
      //		        "bonus_xiuwei"     : 2,
      //		        "max_xiuwei"       : 400,
      //	 	        "bonus_combat_exp" : 1,
      //		        "max_combat_exp"   : 100,
      "bonus_social_exp": 2,
      "max_social_exp": 2000,
    ]));
  }
}
