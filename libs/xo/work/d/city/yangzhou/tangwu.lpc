#include <ansi.h>
inherit ROOM;

void create()
{
    set("short",YEL"堂屋"NOR);
    set("long",@LONG
北墙贴着一张孔子画像，下面点着一柱清香。东边倚墙放着一书架，稀稀拉
拉放着几本书。中间放着几张木桌和凳子，却没有一个学童在屋里，只有一个老
儒生在边上坐着拿本书在独自读着，边上摆着一把戒尺。
LONG
    );
    set("exits",([ /* sizeof() ==  */
        "south" : __DIR__"zizheng_shuyuan",
    ]));
    set("objects", ([ /* sizeof() == */
        __DIR__"npc/wu_guxian" : 1,
    ]));
    set("detail" , ([ /* sizeof() == */
        "戒尺" : "戒尺上落满了灰尘，象是许久未用了。\n",
    ]));
    set("no_clean_up", 0);
    set("no_kill", "yangzhou");
    setup();
    
}


