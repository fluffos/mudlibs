//Biaoju : biaoju_dating.c 
//by trill 05/01/97

inherit ROOM;

#include <ansi.h>
#include <room.h>

void create() {
  set("short", "天井");
  set("long", @LONG
这是个小小的院子，摆着几盆花，地面扫的一尘不染，也很安静，没有前院
的吆喝声。南边就是周总镖头的住处了。西面是睡房，镖局弟子中在扬州没有住
处都在那里休息。东面是个厨房，一般的镖局弟子都在那里吃喝。
LONG
  );
  set("no_clean_up", 0);
  set("exits", ([
    "east": __DIR__ "chufang",
    "south": __DIR__ "zhuchu",
    "west": __DIR__ "nan_shuifang",
    "southwest": __DIR__ "nv_shuifang",
    "northwest": __DIR__ "biaoju_dating",
    "northeast": __DIR__ "biaoju_dating",
  ]));
  set("outdoors", "yangzhou");
  set("no_kill", "penglai");
  setup();
}

void init() {
  add_action("sao_di", "sao");
}

int valid_leave(object me, string dir) {
  if (dir == "west" && (
    me->query("zuzhi/zuzhi_name") != "凤翔镖局"
    || me->query("gender") != "男性"))
    return notify_fail("你进那地方作什么？\n");
  if (dir == "southwest" && (
    me->query("zuzhi/zuzhi_name") != "凤翔镖局"
    || me->query("gender") != "女性"))
    return notify_fail("你进那地方作什么？\n");
  return ::valid_leave(me, dir);
}

int sao_di(string arg) {
  object me;
  me = this_player();
  if (!arg || arg != "天井")
    return notify_fail("你要扫什么？\n");
  if (arg == "天井") {
    if (query_temp("been_cleaned"))
      return notify_fail("这里已经被打扫得干干净净了。\n");
    if (query_temp("being_cleaned"))
      return notify_fail(query_temp("being_cleaned")
        + "正在打扫这里呢，你不用再打扫了。\n");
    if ((int)me->query("sen") < 50)
      return notify_fail("你现在太累了，连拿扫帚的力气都没有，还是先歇息一下吧。\n");
    else {
      tell_object(me, "你在角落里拿起一把扫帚，开始打扫天井....\n"
        "你一下一下地扫着，只觉得越来越累......\n");
      set_temp("being_cleaned", me->name());
      me->start_busy(10);
      call_out("cleaning", 10, me);
      return 1;
    }
  }
}

int cleaning(object me) {
  tell_object(me, "终于，天井被你打扫干净了，你也累了个半死。\n");
  set_temp("been_cleaned", 1);
  delete_temp("being_cleaned");
  me->receive_damage("sen", 50);
  if (me->query("quest/quest") == "扫天井")
    me->set("done_quest", "扫天井");
  remove_call_out("no_clean");
  call_out("no_clean", 120);
  return 1;
}

void no_clean() {
  if (query_temp("been_cleaned"))
    delete_temp("been_cleaned");
}
