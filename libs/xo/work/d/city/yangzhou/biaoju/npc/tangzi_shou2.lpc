inherit NPC;

void create()
{
    set_name("镖局弟子", ({"biaoju dizi", "dizi"}) );
    set("gender", "男性");
    set("long", @LONG
这个是凤翔镖局的一个趟子手，显得略微老成一些。
LONG
    );
    set("str", 21);
    set("con", 22);
    set("age", 28);
    set( "combat_exp", 2000 );
    set( "social_exp", 500 );

    set_wugong( "jiben-quanfa", 50, 50, 1 );
    set_wugong( "changquan", 15, 15, 1 );
    set_wugong( "jiben-qinggong", 40, 40, 1 );
    set_wugong( "xingyun-shenfa", 10, 10, 1 );
   
    set_xiuwei_by_type( "unarmed", 150 );
    set_xiuwei_by_type( "dodge", 150 );
    create_zuzhi( "凤翔镖局", 4, "趟子手" );
    setup();
    carry_object(CLOTH_DIR "cloth6")->wear();
}

