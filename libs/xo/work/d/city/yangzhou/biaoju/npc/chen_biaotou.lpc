inherit NPC;
#include "biaoju_master.h"

void create()
{
    set_name("陈镖头", ({"biao shi", "shi"}) );
    set("title", "凤翔镖局");
    set("long", @LONG
这是凤翔镖局的一个镖头，在镖局干了十几年了，江湖阅历很丰富。
LONG
    );
    set("str", 21);
    set("con", 22);
    set("age", 32);
    set( "combat_exp", 10000 );
    set( "social_exp", 3000 );
    
    set_wugong( "jiben-quanfa", 60, 60, 1 );
    setup();
    carry_object(CLOTH_DIR "mabu_kuanshan")->wear();
    carry_object(BOOTS_DIR "baodi_kuaixue")->wear();
}


