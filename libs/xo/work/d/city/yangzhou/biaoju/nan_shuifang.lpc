#include <ansi.h>
#include <room.h>
inherit ROOM;

void create()
{
    set("short", "男弟子睡房");
    set("long", @LONG
几张木板床一字排开，床的被褥叠的整整齐齐，床头各有一个小柜子，除了
这些，屋内就别无它物。看来镖局弟子虽然在扬州这繁华之地，生活也是很清苦
的。
LONG
    );
    set("no_clean_up", 0);
    set("exits", ([
        "east" : __DIR__"tianjing"
    ]));
    set("objects", ([ ]));
    set("no_kill", "penglai");
    set( "sleep_room", "inn" );
    setup();
}
