// Room: /d/city/yangzhou/caiyi_xijie.c

inherit ROOM;
#include <ansi.h>

void create()
{
    set("short", YEL"彩衣西街"NOR);
    set("long", @LONG
一入彩衣街，你才明白扬州为何被称为「商贾如织」。只见彩衣街两面临街
开店，而且都是衣帛香粉铺。店店相连，间有茶坊酒店。街面狭窄，人流拥挤。
各店客商进出频繁，更有女子满挂珠翠，进出店铺，购置自己喜欢的衣帛饰物。
一入夜，各店铺挑起灯笼，彻夜喧哗，灯火不绝。见到此景，真是「九里三十步
街中，珠翠阗咽，邈如仙境」。
LONG
    );

    set("no_clean_up", 0);
    set("outdoors", "yangzhou");
    set("no_kill", "yangzhou");

    set("objects", ([
    ]));
    set("exits", ([ /* sizeof() == 4 */
        "east" : __DIR__"caiyi_dongjie",
        "south" : __DIR__"toujin_pu",
        "west" : __DIR__"caiyi_jiekou",
        "north" : __DIR__"caibo_pu",
    ]));
    setup();
    
}

