inherit ROOM;
void create()
{
    set("short", YEL"草河南小街"NOR);
    set("long", @LONG
这里街道比草河东岸的长街窄的多，也干净平整的多，行人稀少，河岸边上
的杨柳、碧桃倒影河中，摇曳多姿，整条街显的极为幽静。街边少有店铺酒楼，
大多门户紧闭，两边伺立着一对石狮，看来这一带住的大多是官宦缙绅人家。
LONG
    );
    set("outdoors", "yangzhou");
    set("no_kill", "yangzhou");
    set("no_clean_up", 0);
    set("exits", ([ /* sizeof() == 3 */
