#include <ansi.h>
inherit ROOM;

void create()
{
    set("short",YEL"甘泉街"NOR);
    set("long",@LONG
甘泉街原本是扬州最繁华的街道之一，由于小秦淮河东岸的扬州新城的扩建，
商家多搬去新城了，甘泉街才冷清许多，也干净许多。在新城未建之前，甘泉街
南北两面尽是茶肆酒楼，各色店铺。店家纷纷侵街搭设凉棚，摆设花木，装饰店
面，造成街道拥挤不勘，河对面的漕运署官员的车马无法通行，所以特建新城，
把店铺挪至对岸。北面的小秦淮酒楼是扬州最著名的酒楼，所以没有迁走。
LONG
    );
    set("no_kill", "yangzhou");
    set("no_clean_up", 0);
    set("exits",([ /* sizeof() ==  */
        "east"  : __DIR__"ninghai_qiao",
        "south" : __DIR__"keyu",
        "west"  : __DIR__"shili_changjie2",
        "north" : __DIR__"jiulou"
    ]));
    set("outdoors", "yangzhou");
    set("objects",([
    "/clone/misc/stealer"  :  1+random(2),
    ]));
    setup();
    
}


