#include <ansi.h>
inherit NPC;

void create()
{
    set_name(YEL "监工" NOR, ({"jian gong", "jian"}));
    set("title", "扬州漕运码头");
    set("age", 33);
    set("gender", "男性");
    set("str", 26);
    set("dex", 25);
    set("long", "监工面无表情的站在码头边上，手里握着一根鞭子。\n");
    set("max_kee", 500);
    set("max_sen", 500);
    set("attitude", "heroism");
    set("combat_exp", 20000);
    set("positive_score", 2000);
    set("no_kill", "yangzhou");

//    set_wugong("kuangfeng-bian", 100, 100, 1);
    set_wugong("jiben-qinggong", 100, 100, 1);
    set_xiuwei_by_type("whip",1000);
    set_xiuwei_by_type("dodge",1000);

	setup();
	carry_object(__DIR__"obj/whip")->wield();
	carry_object(__DIR__"obj/heiyi")->wear();
}
