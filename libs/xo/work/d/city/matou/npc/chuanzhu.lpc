// chuanzhu.c

#include <localtime.h>

inherit NPC;

void create()
{
	set_name("陈大", ({ "chen da", "chuan zhu", "worker" }) );
	set("gender", "男性" );
	set("title", "船主");
	set("age", 22);
	set("long","陈大是这条客船的主人，他长年来回于汴梁和扬州之间。\n");
	set("attitude", "friendly");
	setup();
}

void init()
{	
	object me;

	if( interactive ( me = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, me);
	}
}


void greeting(object me)
{
	if( !me || environment(me) != environment() ) return;
	say( "陈大笑眯眯的说：船马上就要开了，这位" + RANK_D->query_respect(me)
			+ "，快坐好。\n");
}

