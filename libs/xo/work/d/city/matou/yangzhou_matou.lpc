#define __YANGZHOU__   "/d/city/yangzhou/"
#include <room.h>
#include <ansi.h>

inherit ROOM;

void create()
{
    set("short", YEL"宁海桥码头"NOR);
    set("long",@LONG
这里是扬州城里最大的码头，南方的粮食，两淮的盐铁在此卸下由漕运署的
官员抽查，或转运或暂时储存。这里人员繁杂，有小贩在叫卖，有工人在搬运粮
袋，有官员手持长鞭在监工，有几个泼皮在转来转去，不知打些什么主意。南边
就是漕运署。东边是达士街，新开了几家店铺。

        岸边停靠着一条客船。

LONG);
    set("long1",@LONG
这里是扬州城里最大的码头，南方的粮食，两淮的盐铁在此卸下由漕运署的
官员抽查，或转运或暂时储存。这里人员繁杂，有小贩在叫卖，有工人在搬运粮
袋，有官员手持长鞭在监工，有几个泼皮在转来转去，不知打些什么主意。南边
就是漕运署。东边是达士街，新开了几家店铺。
LONG);
    set("long2",@LONG
这里是扬州城里最大的码头，南方的粮食，两淮的盐铁在此卸下由漕运署的
官员抽查，或转运或暂时储存。这里人员繁杂，有小贩在叫卖，有工人在搬运粮
袋，有官员手持长鞭在监工，有几个泼皮在转来转去，不知打些什么主意。南边
就是漕运署。东边是达士街，新开了几家店铺。

        岸边停靠着一条客船。

LONG);
    set("exits",([
        "southeast" : __YANGZHOU__"xincheng_cangjie",
        "north"     : __YANGZHOU__"beiliu_xiang",
        "west"      : __YANGZHOU__"ninghai_qiao",
        "east"      : __YANGZHOU__"dashi_jie",
    ]));
    set("objects",([
        __DIR__"npc/jiangong" :1,
    ]));
    set("outdoors","yangzhou");
    setup();
}
int valid_leave(object me, string dir)
{
    if ( userp(me) ) 
        return ::valid_leave( me, dir );
    if ( me->is_character() && dir == "enter" && !me->query("can_enter") )
        return 0;
    return ::valid_leave( me, dir );
}

void init()
{
    object boat;
    add_action("do_work", ({"work", "ganhuo"}) );
    if ( !boat = find_object(__DIR__"kechuan") )
        boat = load_object(__DIR__"kechuan");
    if ( boat = find_object(__DIR__"kechuan") )
        if (!boat->query("moving") ) {
            if ( !query("exits/enter") ) {
                set("exits/enter",__DIR__"kechuan");
                boat->set("exits/out", __FILE__);
            }
            remove_call_out("on_river");
            call_out("on_river", 10, boat, this_object(), 1);
            boat->set("moving", 1);
        }
    return ;
}

int do_work()
{
    object me = this_player();
    if ( me->query_temp("working") )
        return notify_fail("你已经在干活了！！\n");
    if ( !objectp( present ("jian gong", environment(me) ) ) )
        return notify_fail("码头上现在不需要人干活，下次吧！\n");
    if ( (int)me->query("sen") < 30
        || (int)me->query("kee") < 10 ) {
        message_vision(
"监工冲着$N就是一鞭子，$N身上顿时起了一道血痕，$N踉踉跄跄躲到一\n"
"边去了。“妈的，你小子这副萎靡不振的样子还想干活？！！”监工骂\n"
"到：“滚！！”\n", me);
        me->add("kee", -5);
        me->add("eff_kee", -3);
        return 1;
    }
    write("监工拿鞭子指了指，说道：“去那里搬麻袋吧。”\n");
    write("你搬起一个麻袋，开始干活。\n");
    me->start_busy(3);
    me->set_temp("working",1);
    remove_call_out("work_end");
    call_out("work_end", 3, me);
    return 1;
}

int work_end(object me)
{
    object coin;
    write(
"终于做完苦工了，搬了一天的麻袋，累个半死。\n"
"监工过来拍了拍你的肩膀，说道：“小子，好样的，这是你的工钱。”\n");
    me->receive_damage("sen",50);
    me->receive_damage("kee",40);
    coin = new( MONEY_DIR "coin" );
    coin->set_amount(80);
    coin->move(me);
    if ( me->query_temp("working") )
        me->delete_temp("working");
    return 1;
}


void boat_start(int i)
{
    switch ( i ) {
        case 0 :
            remove_call_out("open_yangzhou");
            call_out("open_yangzhou",1);
            break;
        case 1 :
            remove_call_out("open_capital");
            call_out("open_capital",1);
            break;
        default : i = 1 ;break;
    }
}

void open_yangzhou()
{
    object boat;
    if ( !boat=find_object(__DIR__"kechuan") )
        boat=load_object(__DIR__"kechuan");
    if ( boat=find_object(__DIR__"kechuan") ){
        message("vision", "只见客船渐渐慢了下来，陈大冲客舱喊了一声：“扬州到了！ ”\n",
            boat );
        boat->set("exits/out", __FILE__);
        message("vision", "一条客船渐渐靠上了岸，一个船工把一架木梯搭上了岸。\n", this_object() );
        set("exits/enter", __DIR__"kechuan");
        set("long", (string)this_object()->query("long2") );
    }
    remove_call_out("on_river");
    call_out("on_river", 10, boat, this_object(), 1);
}

void open_capital()
{
    object boat, room;
    if ( !room = find_object(__DIR__"bianhe_matou") )
        room = load_object(__DIR__"bianhe_matou");
    if ( room == find_object(__DIR__"bianhe_matou") ) {
        message("vision", "一条客船渐渐靠上了岸，一个船工把一架木梯搭上了岸。\n", room);
        room->set("exits/enter", __DIR__"kechuan");
        room->set("long", (string)room->query("long2") );
    }
    if ( !boat = find_object(__DIR__"kechuan") )
        boat = load_object(__DIR__"kechuan");
    if ( boat == find_object(__DIR__"kechuan")) {
        message("vision", "只见客船渐渐慢了下来，陈大冲客舱喊了一声：“汴梁到了！ ”\n",
            boat);
        boat->set("exits/out", __DIR__"bianhe_matou");
    }
    remove_call_out("on_river");
    call_out("on_river", 10, boat,room, 0);
}

void on_river(object boat, object room,int i)
{
    room->set("long", (string)room->query("long1") );
    message("vision", "陈大喊了一声“开船了~~~~~~~”，收起木梯，几个船工合力一点长\n"+
        "篙，客船缓缓开动了。\n", boat);
    boat->delete("exits/out");
    message("vision", "陈大喊了一声“开船了~~~~~~~”，收起船上的木梯，几个船工合力\n"+
        "一点长篙，客船缓缓向河中央驶去。\n", room);
    room->delete("exits/enter");
    remove_call_out("boat_start");
    call_out("boat_start", 30, i);
    return ;
}

