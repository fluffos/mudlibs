// npc:  king of death   edit by lin on March 7,1997
//modified by trill
//modified by nerd 

#include <ansi.h>
#include <login.h>

inherit NPC;

string *death_msg = ({
  HIW "判官用奇异的眼光盯着你，好像要看穿你的一切似的。\n\n" NOR,
  HIW "判官对你说道：喂！该你了！\n\n" NOR,
  HIW "判官「哼」的一声，从袖中掏出一本像帐册的东西翻看著。\n\n" NOR,
  HIW "判官合上册子，说道：嗯，你阳寿未尽，怎麽跑到这里来了？\n\n" NOR,
  HIW "判官搔了搔头，叹道：罢了罢了，你还是回阳间吧。\n\n"
  "一股阴冷的浓雾突然出现，很快地包围了你。\n\n" NOR,
});

void create() {
  set_name(YEL "判官" NOR, ({ "pan guan", "guan" }));
  set("long", @LONG
    地狱阴司中执掌管带众鬼，以施奖惩之官，手中拿着记载人寿命的生死簿.
LONG);
  set("gender", "男性");
  set("str", 1000);
  set("title", HIW "查察司" NOR);
  set("attitude", "peaceful");
  set("age", 1000);
  set("combat_exp", 100000000);
  set("max_gin", 10000);
  set("max_kee", 10000);
  set("max_sen", 10000);
  set("max_force", 10000);
  set("force", 10000);
  set("force_factor", 100);
  setup();
  carry_object(__DIR__ "obj/shsbu")->wear();
}


void init() {
  object ob;
  ::init();
  if (!(ob = previous_object()) || !userp(ob))
    return;
  if (!ob->is_ghost()) {
    command("say 喂！阳人来阴间做什麽？");
    kill_ob(ob);
    ob->fight_ob(this_object());
    return;
  }
  call_out("check_rein", 2, ob);
}

void check_rein(object ob) {
  int mud_age, rein_time;
  mud_age = (int)ob->query("mud_age");
  rein_time = (int)ob->query("rein_time");
  if ((int)ob->query("age") <= 15 || mud_age >= rein_time) {
    if (ob->query_temp("death_stage_active")) return;
    ob->set_temp("death_stage_active", 1);
    call_out("death_stage", 1, ob, 0);
  }
}

void death_stage(object ob, int stage) {
  object *obs;
  if (!ob || !present(ob)) {
    if (ob) ob->delete_temp("death_stage_active");
    return;
  }
  if (stage != 4)
    tell_object(ob, death_msg[stage]);
  else {
    obs = deep_inventory(ob);
    if (sizeof(obs)) {
      command("hmm");
      tell_object(ob, HIW "判官说道：“不过阴间的东西是不能带到阳间的，你先要把你身上的东西放下来。”\n" NOR);
      ob->delete_temp("death_stage_active");
      return;
    } else
      tell_object(ob, death_msg[stage]);
  }
  if (++stage < sizeof(death_msg)) {
    call_out("death_stage", 3, ob, stage);
    return;
  }
  ob->delete_temp("death_stage_active");
  ob->reincarnate();
  if (stringp(ob->query("hydra/desert/from"))
    && ob->query("hydra/desert/from") == "西域") {
    ob->move("/d/city/gaochang/center");
  } else {
    switch (random(3)) {
      case 0:
        ob->move("/d/city/yangzhou/kuixing_ge");
        break;
      case 1:
        // was "/d/map/zhongyuan/nanmen" -- that path doesn't exist in
        // this trimmed "mini" archive, so move() silently failed
        // (F_MOVE: destination doesn't exist) and permanently stranded
        // the reincarnated player in the death realm (no live map
        // connection back). Repointed to the one confirmed-live
        // destination already used elsewhere in this same function,
        // matching AGENTS.md #7.18's fix pattern.
        ob->move("/d/city/yangzhou/kuixing_ge");
        break;
      case 2:
        // was "/d/city/lanzhou/guangchang" -- same stranding bug as
        // case 1 above ("lanzhou" doesn't exist in this archive either).
        ob->move("/d/city/yangzhou/kuixing_ge");
        break;
    }
  }
  message("vision",
    "你忽然发现前面多了一个人影，不过那人影又好像已经在那里\n"
    "很久了，只是你一直没发觉。\n", environment(ob), ob);
}
