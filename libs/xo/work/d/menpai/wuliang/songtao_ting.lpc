#include <room.h>
inherit ROOM;
void create()
{
   set("short","松涛亭");
   set("long",@LONG
这是一座小小的六角亭子。南面和西面都是山崖，岩石缝隙中生长着很多松
树。北面是一条碎石小径，两边种满了花；东面是一间精巧的卧室，银红色的纱
帘在微风中飘动着。
LONG
);
    set("exits",([
      "north" : __DIR__"xiaojing",
       "east" : __DIR__"woshi",
    ]));
  create_door("east","红木门","west",DOOR_CLOSED);
  setup();
}
