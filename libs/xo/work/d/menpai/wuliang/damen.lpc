#include <room.h>
inherit ROOM;
void create() {
  set("short", "剑湖宫大门");
  set("long", @LONG
剑湖宫坐落在无量山顶，高高在上，气势磅渤。大门依山势而建，两边是陡
峭的山崖。门上有一块匾额，上书“剑湖宫”三个篆文大字，年代似已很久远的
样子，两边是一副对联(duilian)。
LONG
  );
  set("exits", ([
    "southdown": __DIR__ "shidao",
    "north": __DIR__ "qianyuan",
  ]));
  set("objects", ([
    __DIR__ "npc/dizi4": 2,
  ]));
  create_door("north", "沉重的大木门", "south", DOOR_CLOSED);
  set("outdoors", "wuliang");
  setup();
  replace_program(ROOM);
}
