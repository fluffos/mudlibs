#include <room.h>

inherit ROOM;

void create()
{
	set("short","谷底");
	set("long",@LONG
只见左边山崖上一条大瀑布如玉龙悬空，滚滚而下，倾入东面一座清澈异常
的大湖之中，大瀑布不断注入，湖水却不满溢，想来另有泄水之处，瀑布注入处
湖水翻滚，只离得瀑布十馀丈，湖水便一平如镜；这湖作椭圆之形，名为剑湖，
剑湖宫即由此得名，湖畔花木甚多，风景极是秀美。
LONG 
);
	set("exits", ([
    	"west" : __DIR__"pubu",
        "northeast" : __DIR__"jianhu_pan",
         ]));
        set("outdoors","wuliang");
        setup();
	replace_program( ROOM );
}
