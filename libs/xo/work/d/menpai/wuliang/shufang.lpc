inherit ROOM;
void create() {
  set("short", "书房");
  set("long", @LONG
正面一张松木书桌，上面有笔墨纸砚，一块玉狮子镇纸下面压了张字帖，墙
上挂了几张字画，年代似乎颇久，泛出些许古意，茶几上燃了一炉香，旁边书架
上摆满了书，但好象很久没人翻动了，上面积了一层厚厚的尘土。
LONG
  );
  set("exits",
    ([
      "west": __DIR__ "xi_xiangfang",
      "east": __DIR__ "ceting",
    ]));
  set("objects", ([
    __DIR__ "npc/shutong": 1,
  ]));
  if (random(2) > 0) {
    set("search_things", ([
      "书桌": __DIR__ "npc/obj/shu",
    ]));
  } else {
    set("search_things", ([
      "书桌": __DIR__ "npc/obj/shu1",
    ]));
  }
  setup();
}
