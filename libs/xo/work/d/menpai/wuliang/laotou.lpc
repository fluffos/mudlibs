int ask_me(object me);

inherit NPC;
void create() {
  set_name("怪老头", ({ "guai laotou", "laotou" }));
  set("gender", "男性");
  set("age", 65);
  set("attitude", "peaceful");
  set("str", 200);
  set("per", 14);
  set("int", 40);
  set("inquiry", ([
    "悟剑居": (: ask_me :), ]));
  set("combat_exp", 1000000);

  set_skill("sword", 100);
  set_skill("unarmed", 100);
  set_skill("lingxiao-nayun-shou", 80);
  set_skill("parry", 80);
  set_skill("wuliang-jian", 100);

  map_skill("sword", "wuliang-jian");
  map_skill("parry", "wuliang-jian");
  map_skill("unarmed", "lingxiao-nayun-shou");
  setup();
  carry_object(__DIR__ "obj/cloth")->wear();
  carry_object(__DIR__ "obj/jian3")->wield();
  add_money("gold", 3);
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || !present(ob, environment(this_object()))) return;
  say("怪老头眯着一双醉眼，对你笑道：“" + RANK_D->query_respect(ob)
    + "，到这来是想进悟剑居吗？\n");
}
int ask_me(object me) {
  //     if( me->query_temp("掌门/permit")){
  //         command("pat"+ me->query("id"));
  //         command("say 哈哈，快进去吧，能否参出剑道就看你的造化了！");
  //         message_vision("怪老头把$N推进门，然后把门又关上。\n"
  //         ,me);                                                            
  //         me->delete_temp("掌门/permit");
  me->move(__DIR__ "wujian_ju");
  //         return 1; 
  //         }
  //         else{
  command("heng");
  command("say 要想进悟剑居，先得过我这一关！");
  return 1;
}
}
