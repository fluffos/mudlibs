inherit ROOM;
void create() {
  set("short", "菜园");
  set("long", @LONG
  这里是西宗的菜地。一垄垄的菜地被勤劳的弟子弄得整整齐齐。绿油油的青菜长
得生气勃勃。近处，几个师兄在给菜地拔草，施肥。远处还可以看见几只蝴蝶在翩翩起
舞，一股土地的清香迎面扑来，你不禁感到心旷神怡。
LONG
  );
  set("exits", ([
    "west": __DIR__ "chufang",
  ]));
  set("outdoors", "wuliang");
  setup();
  replace_program(ROOM);
}
