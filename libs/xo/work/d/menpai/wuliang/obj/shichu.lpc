inherit ITEM;
void create()
{
        int i;
        object food;
        seteuid(getuid());
        seteuid(geteuid());
        set_name("食橱", ({ "shi chu", "chu" }));
        set_weight(40000);
        set_max_encumbrance(50000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "只");
                set("no_get",1);
                set("long", "一个未涂漆的大木头橱子，里面放着些食物。\n");
        }
        for(i=1;i<6;i++){
        food = new("/clone/eat/food/mantou");
        food->move(this_object());
        }
        food = new("/clone/eat/liquid/hulu");
        food->move(this_object());
        food = new("/clone/eat/liquid/hulu");
        food->move(this_object());
}

int is_container() { return 1; }
