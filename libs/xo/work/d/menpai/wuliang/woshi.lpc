#include <room.h>
inherit ROOM;
void create()
{
        set("short", "卧室");
        set("long", @LONG
这是剑湖宫中布置最精心的一间卧室，一般是由掌门人居住。屋子很大，正
中是一张八仙桌，两把高背檀木椅，铺着缎面垫子；墙上挂着几把样式古朴的长
长剑。东面有一扇木门，透过窗子可以看到松涛亭。
LONG
        );
        set("exits", ([
		"west" : __DIR__"songtao_ting",
		"north" : __DIR__"xi_xiangfang",
	]));
        create_door("west","红木门","east",DOOR_CLOSED);
        create_door("north","绣缎门帘","south",DOOR_CLOSED);
        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}
