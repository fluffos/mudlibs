inherit ROOM;
void create() {
  set("short", "山腰");
  set("long", @LONG
这里是无量山的山腰，山路至此，稍稍变得开阔了一些，形成一块空地。西
面是万丈绝崖，崖边有一块丈许方圆的大石，小小的六角亭建在石上，专为登山
的人上到半途休息用。东面有一条小路通东山，北边另有一条小路，通向主山。
向上望去隐约可见深黑的屋瓦。南面一条小路可以下山去。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "northup": __DIR__ "jieti2",
    "southdown": __DIR__ "shanlu2",
    "enter": __DIR__ "xiao_shanting",
    "northeast": "/d/menpai/shennong/xiaodao4",
  ]));
  set("objects", ([
    __DIR__ "npc/dizi1": 2,
  ]));
  set("outdoors", "wuliang");
  setup();
}

int valid_leave(object who, string dir) {
  if (present("wuliang dizi", this_object()))
    if ((dir == "northup")
      && (string)who->query("family/family_name") != "无量剑派东宗"
      && (string)who->query("family/family_name") != "无量剑派西宗"
      && !(int)who->query("hydra/出师/无量剑派东宗")
      && !(int)who->query("hydra/出师/无量剑派西宗"))
      if (!who->query_temp("go/yes")) {
        message_vision("弟子拦住了$N，说：“你不是我派弟子，请回吧。”\n", who);
        return notify_fail("你被弟子挡了回来。\n"); ;
      }
  who->delete_temp("go/yes");
  return ::valid_leave(who, dir);
}
