#include <room.h>
inherit ROOM;
void create() {
  set("short", "碎花小径");
  set("long", @LONG
一条鹅卵石小径弯弯曲曲，一直引向南面的松涛亭，小径两旁栽了许多茶花
，栀子花等，四下里暗香浮动，草木清新，东面是两级石阶，石阶尽处一扇红门
与西厢房隔开。
LONG
  );
  set("exits",
    ([
      "south": __DIR__ "songtao_ting",
      "east": __DIR__ "xi_xiangfang",
    ]));
  create_door("east", "红门", "west", DOOR_CLOSED);
  set("outdoors", "wuliang");
  set("objects", ([
    __DIR__ "npc/hudie": 4, ]));
  setup();
}
