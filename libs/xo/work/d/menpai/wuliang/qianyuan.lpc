#include <room.h>
inherit ROOM;
void create() {
  set("short", "前院");
  set("long", @LONG
这是一个打扫得很干净的院子，再往里走就是剑湖宫的正厅;西边是一个精
致的小院。南面是大门。
LONG
  );
  set("exits", ([
    "south": __DIR__ "damen",
    "north": __DIR__ "dating",
    "west": __DIR__ "qianting",
  ]));
  create_door("south", "沉重的大木门", "north", DOOR_CLOSED);
  set("outdoors", "wuliang");
  setup();
  replace_program(ROOM);
}
