//qyz & falcon
//let player can change a master when he becomes strong...
string change_master(object who)
{
    string msg;
    object me;

    me = this_player();
    if ( me->query(" family / family_name ") != " 无 量 剑 派 东 宗 " )
        return " 这 位 " + RANK_D->query_respect(me) + " 说 笑 了, 老 朽 无 德 无 能, 何 言 指 点.\ n ";
    // 如果还没有 master, 就先指定商余庆. 不过怎么可能没有呢!!!
    if ( !me->query(" master ") )
    {
        me->set( " master ", " shang yuqing " );
        msg = " 从 今 天 起 ， 你 就 去 跟 商 余 庆 师 兄 学 习 本 门 基 本 武 功 吧 。 \ n ";
    }
    else if ( me->query(" defeat_master ")!=me->query(" master ") )
    {
        if ( !me->query_temp(" fight_master ") )
        {
            me->set_temp(" fight_master ", me->query(" master "));
            printf( " 左 子 穆 沉 思 了 一 会 ... \ n " );
            msg = sprintf( " 好 ， 你 去 跟 % s 比 试 一 下 ， 再 做 决 定 吧 。 \ n ",
                master_name(me) );
        }
        else
        {
            printf( " 左 子 穆 有 些 发 怒 。 \ n " );
            msg = sprintf( " 好 高 骛 远 ， 是 学 不 好 功 夫 的 ， 你 还 是 先 跟 % s 多 学 点 东 西 再 说 。 \ n ",
                master_name(me));
            me->add(" class_score / 无 量 剑 派 东 宗 ", -1);
        }
    }
    else
    {
        me->delete(" defeat_master ");
        me->delete_temp(" fight_master ");
        switch ( me->query(" master ") )
        {
            case " shang yuqing ":
                me->set( " master ", " qu lianxing " );
                msg = " 好 ， 你 现 在 可 以 去 跟 曲 连 兴 师 兄 学 习 了 。 \ n ";
                LOG_D->do_log(me, " 你 击 败 了 商 余 庆 而 获 准 向 曲 连 兴 学 习 更 高 深 的 武 功 。 ");
                break;

            case " qu lianxing ":
                me->set( " master ", " rong ziju " );
                msg = " 嗯 ， 不 错 ， 现 在 就 让 你 容 师 叔 来 指 导 你 吧 。 \ n ";
                LOG_D->do_log(me, " 你 击 败 了 曲 连 兴 ， 并 获 准 向 容 子 矩 请 教 更 高 深 的 武 功 。 ");
                break;

            case " rong ziju ":
                me->set( " master ", " zuo zimu " );
                msg = " 好 徒 儿 ， 从 今 天 开 始 ， 为 师 亲 自 指 点 于 你 ！ \ n ";
                LOG_D->do_log(me, " 在 你 击 败 容 子 矩 后 ， 左 子 穆 对 你 特 别 赏 识 ， 并 决 定 全 心 培 养 你 。 ");
                break;

            // 我认为 zuo 在这儿应该是给一个令牌什么的
            case " zuo zimu ":
                me->set(" marks / 悟 剑 居 ", 1);
                msg = " 你 武 功 已 至 如 此 境 界 ， 看 来 足 以 领 悟 悟 剑 居 中 本 派 的 武 学 精 华 。 \ n ";
                LOG_D->do_log(me, " 你 武 功 终 于 大 成 ， 你 被 左 子 穆 获 准 去 参 修 无 量 剑 最 高 深 的 武 功 － － 石 壁 绝 学 。 ");
                //" 你 可 以 到 \ n 悟 剑 居 去 参 修 本 派 的 至 高 武 学 。 \ n ";
        }
    }
    return msg;
}

string master_name( object me )
{
    string master_id;
    master_id = me->query(" master ");
    switch ( master_id )
    {
        case " shang yuqing " : return " 你 商 师 兄 ";
        case " qu lianxing " : return " 你 曲 师 兄 ";
        case " rong ziju " : return " 你 容 师 叔 ";
        case " zuo zimu " : return " 为 师 我 ";
        default : error( " master_name " );
    }
}

//lnwm:here is for 四川的无名老人

string about_yubi( object me )
{
	string msg;

	me = this_player();

	if ( me->query(" family / family_name ") != " 无 量 剑 派 东 宗 " )
	{
		message_vision(CYN" \ n 左 子 穆 冷 冷 地 看 了 $P 一 眼 ： 这 是 我 无 量 的 地 方 ， 关 你 什 么 事 ？ ！ \ n "NOR, me );
		msg = " 以 后 请 不 要 再 问 这 个 问 题 。 ";
		return msg;
	}

	if ( me->query(" lnwm / maowu / 问 左 子 穆 ") == 1 )
	{
		if ( me->query(" class_score / 无 量 剑 派 东 宗 ") >= 500 )
		{
			if ( !random(20) )
			{
				tell_object( me, CYN" \ n 左 子 穆 稍 稍 犹 豫 了 一 下 ： 你 最 好 不 要 再 问 这 个 问 题 。 \ n "NOR);
				tell_object( me, CYN" 左 子 穆 深 深 地 看 了 你 一 眼 ： 当 年 你 的 一 位 师 叔 就 是 在 参 看 玉 壁 的 秘 密 后 突 然 失 踪 的 。 \ n "NOR);
				me->delete(" lnwm / maowu / 问 左 子 穆 ");
				me->set(" lnwm / maowu / 师 叔 " , 1 );
				msg = " 玉 壁 是 我 无 量 的 秘 密 ， 你 现 在 还 是 不 知 道 的 好 些 ， 去 吧 。 \ n ";
				return msg;
			}
			else
			{
				msg = " 玉 壁 是 我 无 量 的 秘 密 ， 你 现 在 还 是 不 知 道 的 好 些 ， 去 吧 。 \ n ";
				return msg;
			}
		}
		else
		{
			tell_object( me, CYN" \ n 左 子 穆 略 微 有 些 不 快 ： 你 问 这 个 问 题 做 什 么 ？ \ n "NOR);
			msg = " 你 还 是 想 想 如 何 为 师 门 多 做 些 贡 献 吧 。 ";
			return msg;
		}
	}
	else
	{
		tell_object( me , CYN" \ n 左 子 穆 一 脸 茫 然 。 \ n "NOR);
		msg = " 你 怎 么 想 起 来 问 这 个 问 题 呢 ？ ";
		return msg;
	}
}


//Hydra:add for 出师 19980507
string leave_east( object me )
{
    object this;
    me = this_player();
    this = this_object();

    if( me->query(" hydra / 出 师 / 无 量 剑 派 东 宗 "))
    {
        return " 你 不 是 已 经 出 师 了 吗 ？ ";
    }
    if( me->query(" family / family_name ") != " 无 量 剑 派 东 宗 " )
    {
        command( " ? "+me->query(" id ") );
        return " 你 又 不 是 我 无 量 东 宗 之 人 ， 何 来 出 师 之 说 。 ";
    }

    if( me->query( " class_score / 无 量 剑 派 东 宗 " ) < 1000 )
    {
        message_vision(CYN" $N 对 $n 道 ： “ 你 在 我 门 下 多 年 ， 却 不 尽 心 为 师 门 "
" 效 力 ， 怎 么 就 想 离 开 了 呢 ？ ” \ n "NOR,this,me );
        me -> add( " class_score / 无 量 剑 派 东 宗 ",-10);
        return " 你 还 是 先 为 光 大 师 门 多 干 点 事 吧 ！ \ n ";
    }

    if( me->query_jibie(" liuyun - jian ") >= 90 )
    {
        if(!me->query(" marks / 悟 剑 居 ") )
        {
            me -> add( " class_score / 无 量 剑 派 东 宗 ",-10);
            return " 你 功 夫 未 成 ， 还 是 在 我 手 下 多 学 几 年 吧 。 \ n ";
        }
        else if( me->query(" age ") < 24 )
        {
            message_vision(CYN" $N 对 $n 说 道 ： “ 你 年 纪 轻 轻 就 出 去 ， 人 家 会 以 为 我 无 量 "
" 无 人 的 。 ” \ n "NOR,this,me);
            me -> add( " class_score / 无 量 剑 派 东 宗 ",-10);            
            return " 过 两 年 再 说 吧 。 \ n ";
        }
        else
        {
             command( " snow "+me->query(" id "));
             message_vision(CYN" $N 看 看 了 $n ， 道 ： “ 既 然 这 样 ， 我 也 知 道 留 你 不 住 了 。 "
" 出 去 了 可 不 要 忘 了 为 师 和 你 的 师 兄 弟 们 啊 。 \ n "NOR,this,me);
             me -> delete(" marks / 悟 剑 居 ");
             me -> delete(" master ");
             me -> set(" title "," 普 通 百 姓 ");
             me -> delete(" family ");
             me -> delete(" class ");
             me -> set(" hydra / 出 师 / 无 量 剑 派 东 宗 ",1);
             get_sword(me);
             LOG_D->do_log(me,sprintf(" 你 获 得 了 左 子 穆 的 允 许 ， 从 无 量 东 宗 出 师 。 \ n "));
             log_file(" chushi ",sprintf(" % s(% s) 于 % s 顺 利 从 无 量 东 宗 出 师 。 \ n ",me->query(" name "),
                getuid(me),ctime(time()) ) );
             message_vision(" $N 恭 恭 敬 敬 地 跪 了 下 来 ， 向 $n 磕 了 四 个 响 头 。 \ n ",me,this);
             return " 罢 了 ， 罢 了 。 。 。 ";
         }
    }
    else
    {
        return " 学 艺 未 精 ， 出 去 岂 非 给 我 无 量 东 宗 丢 脸 ！ ";
    }
    return " ";
}        

void get_sword( object me )
{
    object *inv;
    inv = all_inventory( me );
    foreach( object ob in inv )
    {
        if( ob->query(" id ")==" chang jian " 
            && ob->query(" name ")==HIY" 长 剑 "NOR )
        {
            say(CYN" 左 子 穆 说 道 ， “ 你 身 上 的 剑 就 不 要 带 着 了 吧 。 \ n "
            " 说 着 把 你 身 上 的 长 剑 拿 走 了 。 \ n "NOR );
            ob -> move(environment(me));
            destruct(ob);
         }
    }
}
