// qu_lianxing.c

inherit NPC;

#include "east_master.h"

void create() {
  set_name("曲连兴", ({ "qu lianxing", "qu" }));
  create_family("无量剑派东宗", 6, "弟子");
  set("gender", "男性");
  set("age", 25);

  set_wugong("unarmed", 80, 80, 1);
  set_wugong("nanshan-liushi", 40, 30, 1);
  set_wugong("jiben-qinggong", 90, 90, 0);
  set_wugong("taizu-quan", 70);
  set_wugong("haoran-zhengqi", 50, 40, 1);
  set_wugong("sword", 60, 40, 1);
  set_wugong("wuliang-jian", 50, 50, 1);
  set_wugong("liuyun-jian", 50, 50, 1);
  set_wugong("wuliang-shenfa", 80, 80, 1);
  set_xiuwei_by_type("sword", 1000);
  set_xiuwei_by_type("dodge", 700);
  set_xiuwei_by_type("unarmed", 1000);

  set("max_force", 1500);
  set("force", 1000);
  set("force_factor", 50);
  set("combat_exp", 20000);
  setup();
  carry_object(__DIR__ "obj/cloth")->wear();
  //carry_object(CLONE_DIR"weapon/sword/sword1")->wield();
}

void init() {
  add_action("do_leave", "go");
}

int do_leave(string arg) {
  if (arg == "eastup") {
    message_vision("曲连兴拦住了$N，说：'后山是本派重地，你请回吧。'\n",
      this_player());
    return 1;
  }
}
