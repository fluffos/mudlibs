// Room: ../wuliang/qianyuan.c
//by trill 01/26/97

inherit ROOM;

void create() {
  set("short", "前院");
  set("long", @LONG
你站在一个很为宽敞的院子，几株梧桐长的郁郁葱葱，绿荫满地，给这里带
来几分阴凉。一个老仆正在专心打扫院子，似乎并没有觉察到你的到来。北面是
西宗招待宾客的客厅。南面是西宗的山门。
LONG
  );
  set("no_clean_up", 0);
  set("exits", ([ /* sizeof() == 2 */
    "north": __DIR__ "keting",
    "south": __DIR__ "shanmen",
  ]));
  set("need_clean", "无量剑派西宗");

  setup();
}



void init() {
  add_action("da_sao", "sao");
  add_action("da_sao", "clean");
}

int da_sao(string arg) {
  object me;
  mapping quest;
  me = this_player();
  if (!me->can_act()) return notify_fail("你现在无法打扫。\n");

  if (call_other("/cmds/verb/clean", "main", me, arg)) {
    if (quest = me->query("quest")) {
      if (quest["quest"] == "扫前院")
        me->set("done_quest", "扫前院");
      return 1;
    }
    return 1;
  }
  return 0;
}
