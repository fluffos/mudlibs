// /d/menpai/wuliang/west/npc/zhu_guangquan.c 无量西宗的诸光泉
// Changed by lala 1997/09/08


inherit NPC;
#include "west.h"
#include "west_master.h"

string *wugong = ({
  "基本拳法", "基本剑法", "基本轻功", "凌霄拿云手", "南山六式",
  "无量身法", "雁行长空",
});


string ask_qingjiao(object who);
string ask_wugong(object who);

void create() {
  set_name("褚光泉", ({ "zhu guangquan", "zhu", "dizi" }));
  set("gender", "男性");
  set("age", 20);

  set("no_kill", "west_wuliang");
  set("str", 20);
  set("cor", 20);
  set("cps", 20);
  set("per", 26);
  set("int", 20);

  set("attitude", "peaceful");

  set("max_force", 600);
  set("force", 600);
  set("force_factor", 5);

  set("long", @LONG
他是一名无量剑派西宗的弟子，由于上次比剑失利了，现在正苦练剑法。
LONG
  );

  create_family("无量剑派西宗", 6, "弟子");

  set("combat_exp", 5000);

  set("inquiry", ([
    "请教": (: ask_qingjiao :),
    "学习": (: ask_qingjiao :),
    "职责": "我们的职责是入主剑湖宫！",
    "功夫": (: ask_wugong :),
    "武功": (: ask_wugong :),
  ]));

  set_wugong("unarmed", 70, 70, 0);
  set_wugong("taizu-quan", 60, 60, 0);
  set_wugong("nanshan-liushi", 30, 30, 1);

  set_wugong("haoran-zhengqi", 30, 30, 1);

  set_wugong("jiben-qinggong", 80, 80, 0);
  set_wugong("wuliang-shenfa", 60, 60, 0);
  set_wugong("yanxing", 20, 20, 1);

  set_wugong("sword", 60, 60, 0);
  set_wugong("wuliang-jian", 50, 50, 1);

  set_xiuwei_by_type("sword", 250);
  set_xiuwei_by_type("dodge", 350);
  set_xiuwei_by_type("unarmed", 360);

  setup();

  carry_object(__DIR__ "obj/sword")->wield();
  carry_object(__DIR__ "obj/baishan")->wear();
}

string ask_qingjiao(object who) {
  return "如果掌门人让你来向我请教, 那么你可以向我学习本门基本武功了.";
}

string ask_wugong(object who) {
  return "你可以向我学..." + wugong[random(sizeof(wugong))] + "...";
}
