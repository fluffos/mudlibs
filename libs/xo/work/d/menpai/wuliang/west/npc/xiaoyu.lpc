// Npc: xiaoyu.c 在花园里的女弟子
//by trill 02/04/97

#include "include/xing.mark"

inherit NPC;
#include "west.h";

int ask_me1();

void create()
{

    set_name("邢小玉", ({"xiao yu","nv dizi", "dizi"}));
    set("long",@LONG
这是一位无量剑派西宗的女弟子。她面目娟秀，长发披肩，身材苗条，看上
去甚是斯文，但腰间挂着一柄长剑，增加了几分英挺之气，看上去更见秀丽。
LONG
    );
    set("no_kill", "west_wuliang");

    set("gender", "女性");
    set("attitude", "peaceful");
    set("inquiry" , ([ /* sizeof() == 2 */
        "花" : "你在院子里找找看，兴许开了几朵。\n",
        "情人":"你瞎嚼什么舌头？....小玉说着就羞红了脸，象是被人说中了心事。\n",
        "男朋友" : "你瞎嚼什么舌头？....小玉说着就羞红了脸，象是被人说中了心事。\n",
        "心事" : (:ask_me1:),
    ]));    
    set("age", 20);
    set("per", 25);
    set("max_kee", 350);
    set("max_gin", 200);
    set("force", 600);
    set("max_force", 500);
    set("combat_exp", 15000);
    set_wugong("unarmed",50,50,1);
    set_wugong("nanshan-liushi",40,30,1);
    set_wugong("haoran-zhengqi",60,40,1);
    set_wugong("sword",60,40,1);         
    set_wugong("wuliang-jian",30,20,1);
    set_xiuwei_by_type("sword",120);
    set_xiuwei_by_type("dodge",120);
    set_xiuwei_by_type("unarmed",120);
    create_family("无量剑派西宗" , 6, "弟子");
    setup();
    carry_object(__DIR__"obj/hua")->wear();
    carry_object(__DIR__"obj/sword")->wield();
    carry_object(__DIR__"obj/jadering")->wear();
    carry_object(__DIR__"obj/pink-cloth")->wear();
}

int ask_me1()
{
    command( "sigh " + ( string ) this_player()->query( "id" ) );
    message_vision( "小玉说道：我能有什么心事呢？不要听我爹爹瞎猜。\n", this_player() );
    return 1;
}

int accept_object(object ppl, object letter)
{
    
    int xing_temp_mark = ( int ) ppl->GetTempMark( "xing" );
    if ( !userp(letter) && (string)letter->query("name") == "信" )
    {
        if ( xing_temp_mark & X_HELPING_XIAOLANG ) 
        {
            xing_temp_mark  &= NOT( X_HELPING_XIAOLANG );
            ppl->SetTempMark( "xing", xing_temp_mark );
        }
        message_vision( "$N对小玉说：这是小郎让我给你的。\n", ppl );
        letter->move( this_object() );
        ppl->start_busy( 3 );
        message_vision( "小玉拆开了信，看着...看着...\n\n", ppl );
        remove_call_out( "read_letter" );
        call_out( "read_letter", 3, ppl );
        return 1;
    }
    return 0;
}

void read_letter(object ppl)
{
    object letter, jadering;
    int xing_temp_mark = ( int ) ppl->GetTempMark( "xing" );
    message_vision( "看着...小玉的脸就红了。\n", ppl );
    message_vision( "一看完，小玉就把信给藏了起来。\n", ppl );
    if ( objectp( letter = present("letter", this_object()) ) )
        destruct(letter);
    if ( objectp( jadering = present("jadering", this_object()) ) )
    {
        command ("remove jadering");
    }
    else
    {
        jadering = new( __DIR__"obj/jadering" );
        message_vision( "小玉从怀里取出一个$n。\n", jadering );
    }
    message_vision( "小玉给$N一串$n。\n", ppl, jadering );
    jadering->move( ppl );
    command( "whisper " + ( string ) ppl->query("id")+" 请你把这个玉连环给他，并..\n" );
    message_vision( "小玉犹豫了一下。\n", ppl );
    command( "whisper " + ( string ) ppl->query( "id" ) + " 并告诉他我在这里等他..." );
    xing_temp_mark |= X_BACK;
    ppl->SetTempMark( "xing", xing_temp_mark );
    return ;
}

