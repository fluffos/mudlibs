// Room: /d/menpai/wuliang/west/nandizi_shi.c

inherit ROOM;

void create() {
  set("short", "男弟子休息室");
  set("long", @LONG
这里是男弟子休息室，里头被打扫得很干净。门的左右两边各是几张床。床
上的被子叠得整整齐齐，旁边还放着几件干净的衣服。除此以外，就没有什麽东
西了。看来，他们的生活是比较清苦的。
LONG
  );
  set("sleep_room", "无量剑派西宗");
  set("no_fight", 1);
  set("exits", ([ /* sizeof() == 1 */
    "east": __DIR__ "xishi_lu",
  ]));
  set("no_clean_up", 0);

  setup();
}

void init() {
  object me = this_player();

  if (me->query("gender") != "男性" && !wizardp(me)) {
    write("你跑到男弟子休息室做什么？小心出事哦...\n");
    me->move(__DIR__ "xishi_lu");
  }
}
