  // Room: ../wu_liang/shanmen.c

inherit ROOM;

void create()
{
        set("short", "西宗山门");
	set("long", @LONG
两边陡峭的山崖夹着一个高大的木牌坊，上书「无量派西宗」五个大字，字
迹娟秀飘逸，只是有些模糊了，想必是岁月留下的痕迹。两旁个有一个女弟子手
持长剑在守卫山门。旁边立着一块石碑。两旁的松林被风吹的呼呼的响，一片肃
穆之气。
LONG
	);
	set("no_clean_up", 0);
	set("exits", ([ /* sizeof() == 2 */
		"north" : __DIR__"qianyuan",
		"south" : __DIR__"liangting",
	]));
	set("objects" , ([ /* sizeof() == 2 */
		__DIR__"npc/nv_dizi1" : 1,
		__DIR__"npc/nv_dizi2" : 1,
	]));
	setup();
//	replace_program(ROOM);
}

int valid_leave(object me, string dir)
{
	string resp;
	if ( dir != "north" ) return ::valid_leave(me, dir);
	if ( me->query("family") && 
		(string)me->query("family/family_name") =="无量剑派西宗" ) {
		if ( (string)me->query("gender") == "男性" ) resp = "师兄";
		else resp = "师姐" ;
		if ( objectp( present("nv dizi", environment(me) )) ) {
			message_vision("女弟子对$N笑了笑，说道：\n"+
 		resp+"辛苦了，回山休息休息吧。\n", me);
			return ::valid_leave(me, dir);
		}
	}
	if ( objectp( present("nv dizi", environment(me) )) ) 
		message_vision("女弟子向$N道了个万福,说道：\n"+
	"这位"+RANK_D->query_respect(me)+"，欢迎来无量西宗。\n", me);
	return ::valid_leave(me, dir);
}

	
	