 // Room: ../wuliang/chuqang.c
//buy trill 01/29/97

inherit ROOM;

void create()
{
    set("short", "厨房");
	set("long", @LONG
这是无量剑派西宗的厨房。屋子里摆着几张桌子，几张凳子，一些西宗的弟
子正坐着进餐，谈着一些江湖见闻和掌故。屋子里飘着一股饭菜香，你顿时感到
肚子有些个饿了，也赶紧坐(zuo)下吃饭吧。 
LONG
	);
    set( "no_kill", "west_wuliang" );
	set("no_clean_up", 0);
    set("exits", ([ /* sizeof() == 2 */
		"south" : __DIR__"xishi_lu",
        "east"  : __DIR__"caiyuan",
    ]));

	set("objects", ([
                MISC_DIR "chaidao" : 2,
    ]) );
	setup();
}

void init()
{
	add_action("do_zuo",({"zuo","sit"}));
}

int do_zuo()
{
	object me = this_player();

    if ( me->query("family") 
    	&& (string)me->query("family/family_name") == "无量剑派西宗") {
 		message_vision("$N找了个空位子坐了下来。\n", me);
		me->start_busy(2);
		message_vision("师姐给$N送上了一饭菜，你开始吃喝起来。\n", me);
		remove_call_out("chuihe");
		call_out("chuihe", 2, me);
		return 1;
 	}
  	return notify_fail("你想吃白食啊？\n");
}

void chuihe(object me)
{
 	message_vision("$N吃饱喝足，站了起来。\n", me);
	me->set("food", (int)me->max_food_capacity());
	me->set("water", (int)me->max_water_capacity());
}

