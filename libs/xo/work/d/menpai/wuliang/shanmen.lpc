#include <room.h>

inherit ROOM;

void create()
{
	set("short","后山门");
	set("long",@LONG
从这里再出去就是后山了，平时人迹罕至，破旧的木门上一把锈迹斑斑的铁
锁将木门扣住，但似乎只要轻轻一扯，那锁便会断开。
LONG);
	set("exits",
	([ "south" : __DIR__"wuhou",]));
	setup();
}

void init()
{
        add_action("do_che","che");
        add_action("do_che","pull");
}

int do_che(string arg)
{
        object me;
        int str,astr;

        me = this_player();
        str = me->query("str");
      if( !arg || arg=="")return 0;
        if( arg=="suo")
        {
                if((astr=str*random(10))>100)
                {
                  message_vision(
                 "$N用力一扯那把铁锁，只听一声脆响，铁锁已被崩断，那\n"
                 "小破门一下子被拉开了。\n",me,);
                 set("exits",
                 (["north" : __DIR__"houshan",
                   "south" : __DIR__"wuhou",
                 ]));
                 return 1;
                 }
        else 
          return notify_fail("你用尽了全身力气，可还是扯不开那把破锁。\n");
      }
}
