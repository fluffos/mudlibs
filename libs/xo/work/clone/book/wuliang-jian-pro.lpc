// force_book.c

inherit ITEM;

void create() {
  set_name("残破无量剑谱", ({ "wuliang jianpu", "shu", "book" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "这本书的纸张都已经泛黄了，看上去相当破旧。\n");
    set("value", 10000);
    set("material", "paper");
    set("skill", ([
      // 提高的 技能的名字
      "name": "wuliang-jian",
      // 该 player 的 xiuwei 必须大于 xiuwei_required  
      "xiuwei_required": 400,
      // 该 player 的 literate 必须大于 literate_required 
      // 否则读不懂
      "literate_required": 20,
      // 每次耗的精神 
      "gin_cost": 10 + random(10),
      // 能读到的最高的jibie
      "max_jibie": 150,
      // 如果这本书是涨 jilei 的 那么不再判断领悟比是否小于 < 90
      // 否则 就当 领悟比 < 90 必须去练了
      "bonus_jilei": 0,
      // 每次获得的xiuwei 
      "bonus_xiuwei": 3,
      // 最高可能获得的修为，就是当PLAYER的修为大于max_xiuwei
      // 就不能再涨修为了
      "max_xiuwei": 700,
      // 以下是涨combat_exp 和 social_exp 和修为类似
      "bonus_combat_exp": 10,
      "max_combat_exp": 10000,
      "bonus_social_exp": 10,
      "max_social_exp": 10000,
    ]));
  }
}
