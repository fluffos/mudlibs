#include <ansi.h>

inherit ITEM;
inherit F_FRUIT;

void init()
{
    add_action("do_eat", "eat");
}

void create()
{
    set_name(RED"小红果"NOR, ({"xiao hongguo", "hongguo","guo"}));
    set_weight(40);
    set("long", "一个红彤彤的小野果子。");
    set("unit", "个");
    set("life", 4);
    set("value", 3);
    set("fruit_remaining", 1); //可以吃6口
    set("food_supply", 30 );   //每口加10的food
    set("water_supply", 55);  //每口可以加10的water
    //每次吃的msg,没有也可以的。
    set("eat_msg", "$N拿起$n，大大的啃了一口。\n");
    //最后一口的msg，没有亦可
    set("end_msg", "$N一口就吞完了这个$n。\n");
    //吃饱了的msg, 没有亦可，但不能有代词。
    set("over_msg", "吃这么多？小心撑破肚皮！！！！\n");
    // 水果吃完剩下的东西 :-)
    setup();
}

