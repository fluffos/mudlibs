inherit ITEM;
inherit F_FOOD;
void create() {
  set_name("猪肉", ({ "zhu rou", "rou" }));
  set_weight(1500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一块血淋淋的猪肉。\n");
    set("unit", "块");
    set("value", 100);
    set("food_remaining", 7);
    set("food_supply", 30);
  }
}

int do_eat(string arg) {
  return notify_fail("这还是生的，怎么吃呀。\n");
}
