// 楚州（淮安）的鸡汤蒲菜 /clone/eat/food/jitang_pucai.c
// by lala, 1997-12-14

inherit ITEM;
inherit F_FOOD;

void create()
{
    set_name("鸡汤蒲菜", ({"jitang pucai"}) );
    set_weight(250);
    set("long", @LONG
这是用蒲草的洁白肥嫩的根茎放入鸡汤里外加作料烩制的一道楚州名菜。
LONG
    );        
    if( clonep() ) 
        set_default_object(__FILE__);
    else {
        set("unit", "大碗");
        set("value", 1200);
        set("food_remaining", 8);
        set("food_supply", 30);
        set("gifts", ([
            "per" : 2,
            "int" : 1,
        ]));
    }
    setup();
}
