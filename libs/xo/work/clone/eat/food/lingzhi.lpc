// FOOD in new file_standard. Lin edited in JUNE 1997
inherit ITEM;
inherit F_FOOD;

#include <ansi.h>

void create() {
  set_name(HIM "灵芝" NOR, ({ "ling zhi" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一株刚刚摘下的灵芝，上面还带着露水。\n");
    set("unit", "株");
    set("value", 30000);
    set("food_remaining", 4);
    set("food_supply", 20);
    set("eat_msg", "$N拿起$n咬了一口.\n");
    set("end_msg", "$N将剩下的$n吃的干干净净.\n");
  }
}
int eat_effect(object me, object this) {
  me->add("force", 10);
  me->receive_heal("kee", 40);
  me->add("food", 50);
  if (random(30) == 1)
    me->add("max_force", 2);
  if (me->query("age") > 20)
    me->add("mud_age", -150);
  return 0;
}
int cannot_search(object me) {
  if (!me->query_temp_marks("lin/在百草岭山顶")) {
    if (me->query("kar") < 25 && random(10) != 0)
      return 1;
    else if (random(5) != 0)
      return 1;
    else
      return 0;
  } else {
    if (random(5) == 1)
      return 1;
    else return 0;
  }

}
