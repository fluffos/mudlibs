// 葛藤粉 /clone/eat/food/geteng_fen.c
// by lala, 1997-12-16

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("葛藤粉", ({ "geteng fen", "fen" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", @LONG
一包海州云台山上所产的葛藤制成的粉，是名贵的滋补品。
LONG
    );
    set("unit", "包");
    set("value", 2000 + random(1000));
    set("food_remaining", 1);
    set("food_supply", 15);
    set("gifts", ([
      "per": 1,
      "int": 1,
      "dex": 1,
      "spi": 1,
      "con": 1,
    ]));
  }
}
