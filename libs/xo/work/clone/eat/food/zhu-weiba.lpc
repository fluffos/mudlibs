inherit ITEM;
inherit F_FOOD;
void create()
{
        set_name( "猪尾巴" , ({"zhu weiba", "weiba"}));
        set_weight(1500);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "一条长长的猪尾巴。\n");
                set("unit", "条");
		set("value", 80 );
                set("food_remaining", 7);
                set("food_supply",30);
        }
}

int do_eat( string arg )
{
    return notify_fail("这还是生的，怎么吃呀。\n");
}
