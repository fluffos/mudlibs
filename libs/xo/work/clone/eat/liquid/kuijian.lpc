// longging.c
// by trill

inherit ITEM;
inherit F_LIQUID;

void create()
{
    //实际玩家买到应该是个茶壶。一开始是满的。
    set_name("魁尖茶",({"kuijian cha", "cha hu", "hu"}));
    set_weight(120);
    if (clonep())
         set_default_object(__FILE__);
    else {
        set("long", "一壶新沏的魁尖，悠悠地冒着香气~~~~~~\n");
        set("unit", "个");
        set("value", 30);
        set("drink_supply",30);
    	set("liquid", ([
            "remaining" : 10,
            "name" : "魁尖",
        ]) );
    }

    setup();
}

int do_fill(string arg)
{
    string id;
    object me = this_player();
    int afford, price, base;

    if ( !arg ) return ::do_fill( arg );

    if ( !environment(me)->query("chashi") )
    {
        set("no_tea", ::do_fill(arg));
        return 1;
    }
    
    if ( query("liquid/remaining") >= 10 ) return notify_fail("你的茶壶是满的。\n");

    if ( arg != "龙井茶" && arg != "魁尖" && arg != "富春茶" 
        && arg != "安徽魁尖" && arg != query("id") ) 
        return notify_fail("你要想要在壶里装什么茶？\n");
    if ( arg == query("id") ) arg = "魁尖";
    switch ( arg )
    {
        case "龙井茶" :
            id = "lingging cha";
            base = 6;
            break ;
        case "魁尖" : case "安徽魁尖" :
            id = "kuijian cha";
            base = 5;
            break ;
        case "富春茶":
            id = "fuchun cha";
            base = 4;
            break;
    }    
    price = 10  * base;
    if ( afford = me->can_afford(price) )
    {
        if ( afford == 2 ) 
           return notify_fail("你没有足够的零钱，而对方也找不开银票...。\n");
        me->start_busy(1);
        me->pay_money(price, 0);
        me->save();
    }
    set("liquid/remaining", 10);
    set_name("茶壶", ({ id, "cha hu", "hu"}) );
    delete("no_tea");
    set("long", "一壶新沏的"+arg+"，悠悠地冒着香气~~~~~~\n");
    write("茶博士把你的茶壶给重新沏满"+arg+"了。\n");
    return 1;
}

int do_drink(string arg)
{

    int heal, recover, gin, e_gin, m_gin, remaining;
    
    heal = 2;
    recover = 2;
    
    if ( query("no_tea") ) return ::do_drink( arg );
    if( arg != "tea" && arg !="hu" && arg !="cha hu"
              && arg != "cha" ) return ::do_drink( arg );

    if( !this_player()->can_act() )
        return notify_fail("你上一个动作还没有完成。\n");

    if( (int)this_player()->query("water")
           >= (int)this_player()->max_water_capacity() )
        return notify_fail("你已经喝太多了，再也灌不下一滴水了。\n");
    
    if ( !remaining = query("liquid/remaining") )
        return notify_fail("这个茶壶是空的。\n");

//    set("value", (int)query("value")-10);
    set("value",0);
    gin = (int)this_player()->query("gin");
    e_gin = (int)this_player()->query("eff_gin");
    m_gin = (int)this_player()->query("max_gin");
    this_player()->add("water", (int)query("drink_supply"));

    add("liquid/remaining", -1);
    if ( remaining > 1)
    {
        message_vision("$N端起茶壶，喝下一口"+query("liquid/name")+"。细细品味，只觉得\n"+
          "一股香气直入心脾，$N觉得精神好多了。\n", this_player());
    }
    else
    {
        message_vision("$N端起茶壶，把剩下的"+query("liquid/name")+"一饮而尽。\n"+
          "一股香气直入心脾，$N觉得精神好多了。\n", this_player());
        set("long", "一个空茶壶。\n");
        set_name( "茶壶", ({ "cha hu", "hu" }) );
        set("no_tea", 1);
    }
    if ( e_gin < m_gin ) e_gin += heal;
    if ( gin < e_gin )
    {
        if ( (gin + recover) > e_gin ) gin = e_gin;
        else gin += recover;
    }
    this_player()->set("gin", gin);
    this_player()->set("e_gin", e_gin);
    return 1;
}
