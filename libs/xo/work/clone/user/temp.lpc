// Filename : /clone/misc/user.c

#include <origin.h>
#include <user.h>
#include <ansi.h>
#include <options.h>
#include <command.h>

inherit CHARACTER;
inherit F_AUTOLOAD;
inherit F_SAVE;
inherit F_AUTOSAVE;

nosave string user_id;

void create(string id) {
  char::create();
  set_name("使用者物件", ({ "user object", "user", "object" }));
  user_id = id;
}

// This is used by F_SAVE to determine the filename to save our data.
string query_save_file() {
  return sprintf(DATA_DIR "user/%c/%s", user_id[0], user_id);
}

void heart_beat() {
  ::heart_beat();
}

void setup() {
  ::setup();
  restore_autoload();
}
