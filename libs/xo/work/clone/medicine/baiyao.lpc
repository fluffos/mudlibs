inherit ITEM;
void create()
{
        set_name( "云南白药" , ({"bai yao", "medicine"}));
        set_weight(30);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "这便是外科圣药云南白药。你可以用“ｆｕ ｙａｏ”命令来使用它。\n");
                set("unit", "包");
                set("value", 5000);
        }
}

void init()
{
    add_action("do_fu", "fu" );
}

int do_fu( string arg )
{
    object me;
    me = this_player();

    if( !arg || arg != "yao" )
    return notify_fail("你要敷什么？\n");

    if( me->query("eff_kee") >= me->query("max_kee") )
    return notify_fail("你身上没有伤口，你要把药敷在哪里？\n"); 

    message_vision("$N从怀中掏出一包云南白药，小心翼翼地敷在伤口上。\n", me);
    call_out("dest_me", 1, this_object() );
    me->apply_condition("healing", 5 );
    return 1;
}

void dest_me( object ob )
{
    destruct(ob);
}
