#include <armor.h>
inherit WAIST;
void create()
{
        set_name("腰牌", ({ "yao pai", }) );
        set_weight(200);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long","这是标名官兵身份的证据，上面刻着姓名，军蕃。\n");
                set("unit", "只");
                set("value",100);
                set("material", "iron");
                set("armor_prop/armor",1);
        }
        setup();
}
