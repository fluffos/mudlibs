/*
NPC: /clone/misc/stealer.c
Usage:小偷，调整城市金融
特性：
    1.平时和普通人一样，年龄在10岁至30岁不等。
    2.偷钱的几率和偷钱数基本随机，但和该人的江湖阅历、年龄、福缘、膂力有关
      具体来说，江湖阅历高，被偷的几率小，年龄很低或很高，被偷的几率大
    3.如果不得手，被发现了，会自动和你打架（bihua）
    4.得手后即跑掉（random_move）
版本：V1.0.0
编写：Xli for XO_Group 1999.9.2
Last Modified: Xli 1999.9.2
*/
#include <ansi.h>
inherit NPC;

int time=300;    //暂定5分钟下手一次
int stealer_index;  // 该小偷的内部编号，由此决定其年龄、描述，0--3，共四种
int stealer_gender_num; // 性别编号，0为男，1为女

string * stealer_gender = ({"男性","女性"});

string * stealer_name=    // 小偷的名字，单数为男，双数为女
({
       HIG"小男孩"NOR,HIG"小女孩"NOR,  // 10--15岁
       CYN"少年"NOR,CYN"小姑娘"NOR,    // 15--20岁
       HIB"小伙子"NOR,HIB"少女"NOR,    // 20--25岁
       HIK"年轻人"NOR,HIK"小妇人"NOR,  // 25--30岁
});

string * stealer_long=    // 小偷的描述，单数为男，双数为女
({
       	"一个个头不高的小男孩，头发有些蓬乱，穿着一件打着几个补丁的衣服，两只眼睛四处乱转。\n",
       	"一个瘦弱的小女孩，身量未足，头发蓬乱，身上衣衫破烂，仅能蔽体，两只眼睛略带惊慌地四处乱转。\n",

       	"一个普普通通的少年，头发随便耷拉着，一件破旧的衣衫胡乱披在身上，\n"+
       	"不时瞟你一眼，大拇指神经质地摩擦着食指。\n",
       	"一个普通的小姑娘，头发上扎了两个小辫子，穿着一件露出了些许棉花的小花袄，\n"+
       	"不时看你一眼，迅疾又转开了视线。\n",

       	"一个普普通通的小伙子，昏暗的眼神里透露出几丝狡黠，走路时快时慢，\n"+
       	"不时停在路边，整理一下身上的衣服。\n",
        "一位已显成熟的少女，一身衣服还算整齐，头发上没有任何头饰，\n"+
        "低着头在路上走着，不时抬起头向四周扫视一眼，赶紧又低下头来，似乎很害羞的样子。\n",

       	"一位显得很老成的年轻人，皱纹过早地显露在额头上，头发稍微有些条理地归拢在一起，\n"+
       	"四处走着，眼神有些浑浊，好象什么都没看，又好象谁都被他看在了眼里。\n",
       	"一位已显老成的小妇人，年纪不大，眼角却已经出现了几丝鱼尾纹，低眉顺眼的，\n"+
       	"走在街上，谁都不会注意这么一个普普通通的人。\n",
});

string * stealer_message=   // 偷的信息，单数为男，双数为女
({
	    "小男孩突然加紧脚步，好象看见了什么似的，从你身边匆匆走过。\n",
	    "小女孩突然加紧脚步，好象看见了什么似的，从你身边匆匆擦过。\n",
	    "少年慢慢蹭到了你身边，身子轻轻晃了一下，马上转身，离你而去。\n",
        "小姑娘轻手轻脚的来到了你身旁，好象很随意地绕你转了半圈，似乎在给你让路。\n",
        "小伙子走过你旁边，手臂无意间蹭了你一下。\n",
        "少女从你旁边走过，好象无意间碰着了你，立刻抬头看了看你，嘴角好象有一丝笑容。\n",
        "年轻人慢慢路过你身边，突然象睬着了什么，身子歪了一下，随即又恢复了正常。\n",
        "小妇人走过你身边，掏出了一方手帕，擦了擦汗，然后塞了回去，继续走路。\n",
});
string * stealer_escape=  // 小偷得手后给被偷者的信息，单数为男，双数为女
({
	    HIR"只见这个小男孩突然拼了命的往远处跑去，你正纳闷间，一摸口袋，顿时发现钱少了好多。\n"+
	    "再抬头搜寻那个小男孩，已经不知道跑到哪里去了......\n"NOR,
		HIR"只见这个小女孩突然拼了命的往远处跑去，你正纳闷间，一摸口袋，顿时发现钱少了好多。\n"+
	    "再抬头搜寻那个小女孩，已经不知道跑到哪里去了......\n"NOR,
	    HIR"只见少年突然一纵身，钻进了旁边一个小巷子，等到你回过神，发现身上少了钱财的时候，他已经不知去向了。\n"NOR,
	    HIR"只见小姑娘钻进了街边一个小铺子，等到你回过神，发现少了钱财追进去的时候，她已经不在那里了。\n"NOR,
        HIR"小伙子又走出了丈许后，突然身子一转，立刻消失在一条小巷的出口处，你这才发现身上少了不少钱财。\n"NOR,
        HIR"少女突然加快了脚步，好象做错了什么事情一样，几步就拐进一条小胡同，你这才发现身上少了不少钱财。\n"NOR,
        HIR"年轻人若无其事地走了过去，不时向两边的店铺瞄几眼，一会就不见踪影了。你这才发现身上少了不少钱财。\n"NOR,
        HIR"小妇人拍了拍衣服上的灰尘，显出一丝疲惫的神情，消失在人丛中。你这才发现身上少了不少钱财。\n"NOR,
});

int steal_money(object); //判断object身上是否有钱并偷窃的函数

void create()
{   
	string name,miaoshu;
	
	stealer_index=random(4);
	stealer_gender_num=random(2);
	name=stealer_name[2*stealer_index+stealer_gender_num];
	miaoshu=stealer_long[2*stealer_index+stealer_gender_num];
	
	set_name(name, ({ "pingmin" }) );
    set("long",miaoshu);
    set("gender", stealer_gender[stealer_gender_num] );
    set("age",10+5*stealer_index+random(5));
    set_wugong("unarmed",10+5*stealer_index);
    set_xiuwei("unarmed",20+10*stealer_index);
    set_xiuwei("dodge",20+10*stealer_index);
    set("combat_exp",150+100*stealer_index);
    set("social_exp",150+100*stealer_index);
  	set("chat_chance", 20);
    set("chat_msg", ({ (: random_move :) }));
    setup();
    call_out("do_steal",time,this_object()); 
}

int do_steal(object stealer)
{
	object* who;
	int i;
	int chance; //被偷的几率
	
	if(stealer->query("have_steal")) // 上次偷过，则清除记号
	    stealer->delete("have_steal");
	    
	who=all_inventory(environment(stealer));
	for(i=0;i<sizeof(who);i++)
	{   
		if(!stealer->query("have_steal") && living(stealer)) //选了半天还没有下过手
		{
			if(userp(who[i]) && living(who[i]) )
	    	{
	    		chance=(who[i]->query("age")-10)/10 - 2 ;  //30岁几率最小
	    		if( chance < 0 )
		    	   	chance = -2*chance;
		    	chance+=5-who[i]->query("social_exp")/10000; //江湖阅历越低几率越大
        	    chance+=4-who[i]->query("kar")/10;   //福缘高自然几率小
            	chance+=4-who[i]->query("str")/10; //膀大腰圆自然几率小
            	if(chance > 5+random(3) ) //选中对象了 grin
            	{
            		set("have_steal",1); // 下手了，做个记号
            		tell_object(who[i],stealer_message[2*stealer_index+stealer_gender_num]);
            		// 出现偷的信息了
	            	if(chance < 8+random(4) ) // 被发现了
    	        	{
        	    		tell_object(who[i],HIY"你突然发现他鬼鬼祟祟的，一只手正插在你的钱包里面！\n"NOR);
        	    		tell_object(who[i],RED"你大喝一声，抓住他的手不放，与他扭打了起来。\n"NOR);
        	    		who[i]->bihua_ob(stealer);
        	    		stealer->bihua_ob(who[i]);
        	    		return 1;
        	    	}
            		if(steal_money(who[i]) )  //  身上有钱且偷到手了
	    	    	{
	    	    		tell_object(who[i],stealer_escape[2*stealer_index+stealer_gender_num]);
	    	    		random_move();
	    	    		call_out("do_steal",time,stealer);
	    	    		return 1;
	    	    	}
	    	    	tell_object(who[i],stealer->query("name")+"拍了拍手，轻声骂了句“穷鬼”，匆匆走开了！\n");
	    	    }
	        }
    	}
    }
	random_move();
	if(random(10) == 1)
		destruct(stealer);
	else
	    call_out("do_steal",time,stealer);
	return 1;
}

int steal_money(object poorguy)
{
	object* things;
	int i;
	int amount;
	int getit=0;
	
	things=all_inventory(poorguy);
	for(i=0;i<sizeof(things);i++)
	{
		if(things[i]->query("id")=="thousand-cash"
		|| things[i]->query("id")=="gold"
		|| things[i]->query("id")=="silver"
		|| things[i]->query("id")=="coin")
		{
			amount=things[i]->query_amount();
			if(amount==1)
			    destruct(things[i]);
			else
			    things[i]->set_amount(amount/2); // 拿走一半
			getit=1;
		}
		    
	}
	return getit;
}

int lose_bihua( object ppl )
{
    command("fear");
    command("say 今天我算是栽了，青山不改，绿水常流，咱们走着瞧！\n");
    random_move();
    call_out("do_steal",time,this_object());
    return 1;
    
}

int win_bihua( object ppl )
{
	command("laugh "+ppl->query("id"));
	command("say 就这点本事还出来混，哼！\n");
	random_move();
	call_out("do_steal",time,this_object());
	return 1;
}

	