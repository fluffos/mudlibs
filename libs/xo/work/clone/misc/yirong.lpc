// yirong yougao for yipin_tang 
// by lnwm 97-12-11


#include <ansi.h>
inherit ITEM;

int end( object ob );

void create()
{
        set_name( "易容油膏" , ({"yirong yougao", "yougao"}));
        set_weight(30);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "西夏一品堂的易容油膏，制作方法为不传之密。用来装扮(zhuang)成某人。\n使用效能与使用者的易容术有很大关系。\n");
                set("unit", "包");
                set("value", 10);
        }
}

void init()
{
    add_action("do_pretend", "pretend" );
	add_action("do_pretend", "zhuang");	
}

int do_pretend(string arg)
{
	object who;
	object me;

	me = this_player();

	if (!arg)
		return notify_fail("你要易容为谁？\n");
	
	if ( me->query_condition("mask") )
		return notify_fail("你正在易容当中。\n");

	if ( !me->query_jibie("yirong-shu") )
		return notify_fail("你不会易容术，如何使用易容油膏？\n");
 
    if ( arg == "none" || arg == "cancel") 
	{
		this_player()->delete_temp_marks("apply/name");
		this_player()->delete_temp_marks("apply/id");
		this_player()->delete_temp_marks("apply/short");
		this_player()->delete_temp_marks("apply/long");
        this_player()->clear_condition("mask");
		tell_object(me , "你抹去脸上的油彩，还原为本来面目。\n");
		call_out("end", 1, this_object() );
		return 1;
	}

	if ( this_object()->query("lnwm/yirong_yougao/用过") == 1 )
	{
		tell_object(me,"易容膏只能用一次。这块已经被用过了。\n");
		return 0;
	}		

	if(!objectp(who = present(arg, environment(this_player()))) || 
		!living(who))
		return notify_fail("你易容为谁？\n");

	tell_object(me ,YEL"你打开油彩包，开始易容为"NOR + who->name() + YEL"。\n"NOR);

	this_object()->set("lnwm/yirong_yougao/用过",1);
	me->set_temp_marks("apply/name", ({who->query("name")}));
	me->set_temp_marks("apply/id", ({who->query("id")}));
	me->set_temp_marks("apply/short", ({who->short()}));
	me->set_temp_marks("apply/long", ({who->long()}));
	me->apply_condition( "mask", me->query_jibie("yirong-shu")/10 );
	call_out("end",1,this_object() );
    return 1;
}

int end( object ob )
{
	destruct( ob );
}
