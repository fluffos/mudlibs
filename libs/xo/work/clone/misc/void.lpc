// void.c (re-created after Elon screwed it up on 07-24-95)

#include <room.h>

inherit ROOM;

void create() {
  set("short", "天涯海角，梦的尽头");
  set("long", @LONG
这儿是 ... 空寂 ... 虚无 ... 幻灭 ... 无声无息 ... 无边无界 ...
无始无终。你可以待在这儿想想你的过去，现在和将来，不过你最好早些离开这
块本不该凡人呆的地方。
LONG
  );
  set("exits", ([
    "out": "/d/city/yangzhou/jiulou",
  ]));

  setup();
}
