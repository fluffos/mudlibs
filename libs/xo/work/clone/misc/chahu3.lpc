// chahu1.c

inherit ITEM;
inherit F_LIQUID;

void create()
{
	set_name("彩瓷茶壶", ({ "cha hu", "pot" }) );
	set_weight(500);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一个名贵的彩瓷茶壶，大概装得几升水。\n");
		set("unit", "个");
		set("value", 2000);
		set("max_liquid", 20);
	}

	// The liquid contained in the container is independent, we set a copy
	// in each cloned copy.
	set("liquid", ([
		"name": "茶水",
		"remaining": 10,
	]) );
}
