// bandage.c changed by cry 9.25.98

#include <ansi.h>
#include <armor.h>

inherit ITEM;

void do_wear(object who);
int do_help(string arg);
void create() {
  set_name("布条", ({ "cloth piece", "cloth", "piece" }));
  set_weight(150);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "条");
    set("material", "cloth piece");
    set("unequip_msg", YEL "$N将$n从伤口处拆了下来。\n" NOR);
    set("armor_prop/attack", -10);
    set("armor_prop/defense", -10);
    set("armor_prop/unarmed", -10);
  }
}

void init() {
  add_action("do_bandage", "bandage");
  add_action("do_help", "help");
  add_action("do_remove", "remove");
}

int wear() { return 0; }

int do_bandage(string arg) {
  object me = this_player(), who, ob = this_object();
  int i;
  string tpart, target, str;
  string *part = ({ "chest", "leg", "foot", "head",
    "neck", "waist", "hand", "arm" });

  if (query("blood_soaked") >= 2)
    return notify_fail(name() + "已经被鲜血浸透，不能再用了。\n");

  if (query("equipped"))
    return notify_fail(name() + "已经裹在你的伤口上了，如果你要用来包扎别人，请你先把它除下来。\n");

  if (!arg) {
    do_help("bandage");
    return 1;
  }

  if (sscanf(arg, "%s for %s", tpart, target) == 2) {
    if (target != "me")
      who = present(target, environment(me));
    else
      who = me;
    if (!who || !who->is_character())
      return notify_fail("你要替谁裹伤？\n");
    arg = tpart;
    tpart = "";
  } else
    who = me;
  for (i = 0; i < sizeof(part); i++)
    if (arg == part[i]) {
      tpart = arg;
      break;
    }
  if (!stringp(tpart))
    return notify_fail("你要给什么地方裹伤？\n");

  if (me->is_fighting() || who->is_fighting())
    return notify_fail("战斗中不能裹伤。\n");

  if ((int)who->query("eff_kee") == (int)who->query("max_kee"))
    return notify_fail((who == me ? "你" : who->name())
      + "并没有受到任何外伤。\n");

  if (!move(who)) return notify_fail("这个布条不能移动。\n");

  switch (tpart) {
    case "chest":
      str = YEL "$N将一条" + "$n裹在身上。\n" NOR;
      set("armor_type", "cloth");
      break;
    case "foot":
      str = YEL "$N将一条" + "$n裹在脚上。\n" NOR;
      set("armor_type", "boots");
      break;
    case "arm":
      str = YEL "$N将一条" + "$n裹在左臂上。\n" NOR;
      set("armor_type", "wrists");
      break;
    case "leg":
      str = YEL "$N将一条" + "$n裹在右腿上。\n" NOR;
      set("armor_type", "armor");
      break;
    case "head":
      str = YEL "$N将一条" + "$n裹在头上。\n" NOR;
      set("armor_type", "head");
      break;
    case "neck":
      str = YEL "$N将一条" + "$n缠在脖子上。\n" NOR;
      set("armor_type", "neck");
      break;
    case "hand":
      str = YEL "$N将一条" + "$n缠在手上。\n" NOR;
      set("armor_type", "hands");
      break;
    case "waist":
      str = YEL "$N将一条" + "$n裹在腰间。\n" NOR;
      set("armor_type", "waist");
      break;
  }
  set("wear_msg", str);

  if (who->query_temp("armor/" + ob->query("armor_type")))
    if (who == me)
      return notify_fail("你的伤口上有其它的东西，无法裹伤。\n");
    else
      return notify_fail(who->name() + "的伤口上有其它的东西，无法裹伤。\n");

  who->apply_condition("bandaged", 40);
  add("blood_soaked", 1);
  message_vision(str, who, ob);
  set("equipped", "worn");
  do_wear(who);
  return 1;
}

void do_wear(object who) {
  object ob = this_object();
  mapping armor_prop, applied_prop;
  string *apply, type;

  armor_prop = query("armor_prop");
  type = ob->query("armor_type");
  who->set_temp("armor/" + type, ob);
  apply = keys(armor_prop);
  applied_prop = who->query_temp("apply");
  if (!mapp(applied_prop))
    applied_prop = ([]);
  for (int i = 0; i < sizeof(apply); i++)
    if (undefinedp(applied_prop[apply[i]]))
      applied_prop[apply[i]] = armor_prop[apply[i]];
    else
      applied_prop[apply[i]] += armor_prop[apply[i]];
  who->set_temp("apply", applied_prop);
}

int unequip() {
  object who = environment();
  mapping prop, applied_prop;
  string *apply, equipped;

  if (!who->is_character())
    return 0;

  equipped = query("equipped");

  if (equipped == "worn") {
    who->delete_temp("armor/" + query("armor_type"));
    prop = query("armor_prop");
  }

  apply = keys(prop);
  applied_prop = who->query_temp("apply");
  for (int i = 0; i < sizeof(apply); i++)
    applied_prop[apply[i]] -= prop[apply[i]];

  delete("equipped");
  return 1;
}

void remove(string euid) {
  ::remove(euid);
  if (query("equipped") && environment()) {
    environment()->apply_condition("bandaged", 0);
    delete("armor_type");
  }
}

int do_help(string arg) {
  if (arg == "bandage") {
    write(@HELP
指令格式：bandage <部位> [for <生物>]
 
这个指令用来给别人或自己裹伤。

部位名称：chest: 胸    leg: 腿   foot: 脚   head: 头
          waist: 腰    arm: 臂   neck: 颈   hand: 手  
 
HELP);
    return 1;
  }
  return 0;
}
