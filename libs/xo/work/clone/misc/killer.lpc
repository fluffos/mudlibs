// chashang.c
inherit NPC;

string *blade = ({
  "xuedao",
  "bidao",
  "sidao",
});

string *first_name = ({
  "张", "李", "王", "赵", "杨", "花", "白", "周",
});

string *last_name = ({
  "大", "二", "三", "四", "五", "六", "七", "八",
});

void create() {
  string name;
  name = first_name[random(sizeof(first_name))];
  name += last_name[random(sizeof(last_name))];
  set_name(name, ({ "mosheng ren", "stranger", "ren" }));
  set("title", "陌生人");
  set("gender", "男性");
  set("age", 15 + random(50));
  set("kee", 400);
  set("max_kee", 400);
  set("eff_kee", 400);
  set("sen", 400);
  set("max_sen", 400);
  set("eff_sen", 400);

  set("long",
    "这是一名看起来平平常常的普通人，没有什么特殊的地方。\n");
  set("chat_chance", 40);
  set("chat_msg", ({
    (: random_move :)
  }));
  set("combat_exp", 100000 + random(400000));
  set("social_exp", 100000 + random(400000));
  set("attitude", "friendly");
  setup();
  carry_object(CLONE_DIR + "wear/cloth/cloth4")->wear();
  add_money("coin", random(1000));
  set("possitive_score", 100 - random(400));
}

void init() {
  object me = this_player();
  if (query("is_following")) return;
  if (interactive(me)) {
    if ((me->query("positive_score") > 3000 + random(2000) ||
      me->query("negative_score") > 3000 + random(2000)) ||
      me->query("PKS") > 10 &&
      random(10) > 7) {
      remove_call_out("follow_u");
      call_out("follow_u", 1, me);
    }
  }
}

void follow_u(object me) {
  object ob = this_object();

  if (!me || environment() != environment(me)) return;
  set_leader(me);
  set("is_following", me->query("id"));

  if (!ob->query("is_ready")) {
    set("str", 100 + random(400));
    set_wugong("unarmed", 100 + random(100));
    set_wugong("blade", 100 + random(200));
    set_xiuwei("unarmed", 500 + random(1000));
    set_xiuwei("blade", 1000 + random(2000));
    carry_object(CLONE_DIR + "weapon/blade/blade")->wield();
    set("corpse_ob", CLONE_DIR + "misc/killer_corpse");
    set("is_ready", 1);
  }
  set("chat_chance", 0);
  if (random(me->query_spi()) > 15 && random(me->query("social_exp")) > 10000)
    tell_object(me, "你有一种奇怪的感觉....好象有人在盯着你...?\n");
  call_out("kill_u", random(50), me);
}

void kill_u(object me) {
  object ob;
  ob = this_object();

  if (!me || environment() != environment(me)) {
    delete("is_following");
    set("chat_chance", 40);
  } else {
    message_vision("只听$N用低沉的声音对$n说：“有人出钱买你的命，到了地狱可休得怨我！”\n",
      ob, me);
    ob->kill_ob(me);
  }
}

void killed_enemy(object me) {
  if (!query("is_following")) return;
  message_vision("$N轻轻地擦去刀上的血，悄然而逝....\n", this_object());
  destruct(me);
}

void die() {
  message_vision("$N惨然一笑，喃喃自语道：“终于我得到了解脱...”\n"
    "大笑三声，倒在地上....\n", this_object());
  ::die();
}
