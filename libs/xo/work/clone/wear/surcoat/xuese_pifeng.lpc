#include <ansi.h>
#include <armor.h>

inherit SURCOAT;

void create() {
  set_name(RED "血色披风" NOR, ({ "xuese pifeng", "pi feng", }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 1400);
    set("material", "cloth");
    set("armor_prop/armor", 10);
  }
  setup();
}
