#include <ansi.h>
#include <armor.h>

inherit HEAD;

void create()
{
    set_name( RED"龙女花"NOR,({"longnv hua", "flower","hua" }) );
    set_weight( 15 );                       //三钱；
    if ( clonep() )
        set_default_object( __FILE__ );
    else 
    {
     set("long","一朵红艳艳的龙女花，传说中的神雕大侠命名的。\n" );
        set( "unit", "朵" );
        set( "value", 3300 );               //价格：(1*100)防御力价格
                                            //+(200*15)黄金价格
                                            //+(4*50)附加价格=3300总价格；
        set( "material", "gold" );          //质地：黄金（单价
                                            //２００，０００文／千克）
        set( "armor_prop/armor", 1 );       //防御力：+1；
        set( "armor_prop/personality",100 );
        set( "female_only", 1 );            //女性专用。
    }

    setup();
}
