#include <armor.h>
inherit CLOTH;
void create() {
  set_name("黑色劲装", ({ "heise jingzhuang", "jingzhuang", "cloth" }));
  set("long", "一件黑布的劲装，穿起来很是干净利落。\n");
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "cloth");
    set("value", 10);
    set("armor_prop/armor", 1);
  }
  setup();
}
