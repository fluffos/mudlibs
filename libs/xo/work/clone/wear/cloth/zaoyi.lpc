//zao_yi.c
#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("皂衣", ({ "zao yi", "cloth" }));
	set("long","一套黑色的棉布衣服。背心上一个大白圈，里面写着一个'捕'字\n");
	set_weight(1000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("material", "cloth");
		set("unit", "套");
		set("value", 300);
		set("cant_sell", "扬州官衙的东西，小人哪敢收。\n");
		set("armor_prop/armor", 1);
	}
	setup();
}
