#include <armor.h>
inherit CLOTH;
void create() {
  set_name("青布僧衣", ({ "qingbu sengyi", "sengyi", "cloth" }));
  set("long", "一件小小巧巧的青布僧衣，全寺大概也是独一份的。\n"
    "小则小已，质料手工却绝非粗制滥造。盍寺僧侣对这\n"
    "位小和尚的疼爱可见一斑。");
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "cloth");
    set("value", 400);
    set("armor_prop/armor", 50);
  }
  setup();
}

int wear() {
  object owner;

  owner = environment();
  if (!(owner)->is_character())
    return 0;
  if (owner->query("age") > 13)
    return notify_fail("想要钻进这样小的衣服，你在缩骨功上还要再加把劲才行......:P\n");

  return ::wear();
}
