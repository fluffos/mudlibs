#include <armor.h>

inherit CLOTH;

void create() {
  set_name("绿罗团花袄", ({ "tuanhua ao", "cloth" }));
  set_weight(1500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "套");
    set("value", 700);
    set("material", "cloth");
    set("armor_prop/armor", 3);
  }
  setup();
}
