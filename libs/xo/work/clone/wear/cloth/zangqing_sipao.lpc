#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create()
{
    set_name(HIB"藏青丝袍"NOR, ({ "zangqing sipao","si pao" }) );
    set_weight(400);
    if( clonep() )
        set_default_object(__FILE__);
    else {
        set("unit", "套");
        set("value",1200);
        set("material", "cloth");
        set("armor_prop/armor", 10);
    }
    setup();
}
