#include <ansi.h>
#include <armor.h>
inherit WAIST;
void create()
{
    set_name(WHT "茶褐銮带" NOR, ({"chahe luandai", "yaodai", "waistband"}));
    set_weight(100);
    if ( clonep() )
        set_default_object(__FILE__);
    else {
        set("unit", "根");
        set("value", 400);
        set("material", "silk");
        set("armor_prop/armor", 1);
    }
    setup();
}
