//  少林齐眉棍
//Xli 1998/10/14

#include <weapon.h>
#include <ansi.h>
inherit GUN;

void create()
{
	set_name("齐眉棍", ({ "qimei gun","gun","long"}) );
	set_weight(1500);
        set("long","一根齐眉棍.\n");
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("value", 800);
		set("material", "wood");
	}
	init_gun(10);
	set("wield_msg", "$N抽出一根$n握在手中。\n");
	set("unwield_msg", "$N将手中的$n插在地上。\n");
	setup();
}
