//shuihuo_gun.c
#include <weapon.h>
#include <ansi.h>
inherit STAFF;
void create() {
  set_name(
    BLU "水" + RED "火" + NOR "棍",
    ({ "shui huo gun", "wood gun", "woodstick", "gun", "stick" })
  );
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", @LONG
      一根衙役用的水火棍，一头黑，一头红；长约四尺。
LONG);
    set("unit", "根");
    set("value", 15);
    set("cant_sell", "衙门的东西小店怎敢乱收，你还是快带着它走人吧。\n");
    set("material", "wood");
  }
  init_staff(30);
  set("wield_msg", "$N将一根$n紧握在胸前。\n");
  set("unwield_msg", "$N将手中的$n放下。\n");
  setup();
}
