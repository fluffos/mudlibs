// common 市卖物品：武器。：鞭子.
#include <ansi.h>
#include <weapon.h>

inherit STICKWHIP;

void create()
{
        set_name( "三节棍", ({ "san jie gun","gun","stickwhip" }) );
        set_weight(500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long","三根各长径尺的木棍，用铁环连在了一起。\n");
                set("unit", "根");
                set("value", 300);
                set("material", "wood");
        }
        init_stickwhip(10);

        set("wield_msg", "$N将一根$n握在手中。\n");
        set("unwield_msg", "$N将手中的$n收了起来。\n");

        setup();
}

