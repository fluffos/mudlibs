
// tiesuanpan.c
// by lnwm 

#include <weapon.h>
#include <ansi.h>
inherit PLATE;

void create()
{
	set_name("铁算盘", ({"tie suanpan","suanpan" }) );
	set_weight(1000);
	if ( clonep() )
		set_default_object(__FILE__);
	else
    {
		set("unit", "块");
		set("value", 1700);
		set("material", "iron");
	}
	init_plate(30);

// These properties are optional, if you don't set them, it will use the
// default values.

	set("wield_msg", "$N拿出一块$n握在手中。\n");
	set("unwield_msg", "$N将手中的$n收起来。\n");

// The setup() is required.

	setup();
}
