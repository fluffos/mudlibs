// hook.c
// modified by lin 21/05/97
#include <weapon.h>
#include <ansi.h>
inherit HOOK;

void create() {
  set_name("单钩", ({ "dan gou", "single hook", "gou", "hook" }));
  set_weight(250);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "支");
    set("long", "一支江湖上最普遍使用的单钩，尖上包着铁皮。\n");
    set("value", 200);
    set("material", "wood");
  }
  init_hook(5);

  // These properties are optional, if you don't set them, it will use the
  // default values.

  set("wield_msg", "$N从怀中摸出一把$n握在手中。\n");
  set("unwield_msg", "$N将手中的$n藏入怀中。\n");

  // The setup() is required.

  setup();
}
