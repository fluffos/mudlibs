//  标准乞丐    /clone/npc/beggar.c
//  等级：
//  【巳等】小门派的弟子，江湖闲汉
//          零级修为（      ０－  １００）一级武功（    ０－  ６０）
//          经验（        ０－  ７５００）声望（          ０－         ７５）
//  By lin
//  Changed by lala, 1998-04-03

inherit NPC;

void create() {
  set_name("乞丐", ({ "qi gai", "qigai", "beggar" }));
  set("gender", "男性");                //性别：男
  set("str", 25);                       //臂力：25
  set("long", @LONG
    一个满脸污垢沿街乞讨的乞丐。见你正在注意他，便笑嘻嘻地凑过来讨钱。
LONG
  );

  set("combat_exp", 500);               //战斗经验：500

  set("CantPass", 1);                   //不能通过各个关卡
  set("chat_chance", 15);
  set("chat_msg", ({
    "乞丐说道：“好心的大爷哪～赏我要饭的几文钱吧～”\n",
    "乞丐突然面色一正，忧心的说道：“江湖风波恶呀……”\n",
    "乞丐懒洋洋地打了个哈欠。\n",
    "乞丐伸手捉住了身上的虱子，骂道：“老子身上没几两肉，全叫你们给咬糜了。"
    + "”\n",
    (: random_move :)
  }));

  setup();
  carry_object(CLOTH_DIR + "cloth2")->wear();       //粗布衣
}

void init() {
  object ppl = this_player();

  ::init();

  if (!userp(ppl)
    || !can_act())
    return;

  remove_call_out("Greeting");
  call_out("Greeting", 1, ppl);
}

void Greeting(object ppl) {
  command("say “好心的" + RANK_D->query_respect(ppl) +
    "哪～赏我要饭的几文钱吧～～”");
}

int accept_object(object ppl, object obj)  //收了东西说好话。
{
  command("smile");
  switch (random(2)) {
    case 0:
      command("say “多谢这位" + RANK_D->query_respect(ppl)
        + "，您好心一定会有好报的！”");
      break;
    case 1:
      command("say “多谢这位" + RANK_D->query_respect(ppl)
        + "了, 江湖风波险恶，您这几天可要注意了呀……”");
      break;
  }
  return 1;
}

int accept_fight(object ppl)              //不接受挑战。
{
  command("say “" + RANK_D->query_respect(ppl)
    + "饶命！小的这就滚开！”");
  random_move();
  return 0;
}
