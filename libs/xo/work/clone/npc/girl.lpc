inherit NPC;

void create()
{
    set_name( "小女孩", ({ "xiao nvhai", "nvhai", "girl" }) );
    set( "gender", "女性" );                //性别：女
    set( "age", 7 );                        //年龄：7
    set( "str", 8 );                        //臂力：8
    set( "long", @LONG
    这是个很可爱的小女孩，正在和同伴玩耍。
LONG
    );

    set("combat_exp", 50);                  //战斗经验：50

    setup();
    carry_object( CLOTH_DIR + "cloth0" )->wear();       //女孩服装
}
