// card.c
// 新年贺卡，99元旦所用
// xli 98-12-27

#include <ansi.h>

inherit ITEM;

void create() {
  set_name(RED "新年贺卡" NOR, ({ "card" }));
  set_weight(20);
  set("long", @LONG
	一张精美的贺卡，封面印有XO全体巫师的合影，上面还有签名及给你的赠语：
	笑傲江湖(XO)的全体巫师感谢您一年来对于XO的支持！在这新旧交替的时刻，
	我们祝福你：
	    新    年    快    乐    万    事    如    意    ！
	
	请用新年特殊的 WISH 指令来看看我们给你的新年礼物！ :)
LONG);
  set("unit", "张");
  set("value", 10000);
  set("cant_sell", "呵呵，这个贺卡啊，大街上是个人就有，我们不买的啦！\n");
  this_player()->set("xli_marks/havecard", 1);  // 做个拿过贺卡的记号
  setup();
}
