// /system/std/weapon/sword.c

#include <weapon.h>

#ifdef AS_FEATURE
#include <dbase.h>
#else
inherit WEAPON;
#endif

varargs void init_sword(int damage, int wound, int flag)
{
	if ( clonep( this_object() ) ) 
		return;

	set( "weapon_prop/damage", damage );
	if ( undefinedp(wound) )
		set( "weapon_prop/wound", damage );
	else set("weapon_prop/wound", wound  );
	set( "flag", (int)flag | EDGED );
	set( "skill_type", "sword" );  
	set( "weapon_type","sword");
	set( "verbs", ({ "slash", "slice", "thrust" }) );
}
