// filename : long_blade.c

#include <weapon.h>

#ifdef AS_FEATURE
#include <dbase.h>
#else
inherit WEAPON;
#endif

varargs void init_long_blade(int damage, int wound, int flag) {
  if (clonep(this_object()))
    return;

  set("weapon_prop/damage", damage);
  if (undefinedp(wound))
    set("weapon_prop/wound", damage);
  else set("weapon_prop/wound", wound);
  set("flag", (int)flag | POINTED);
  set("skill_type", "long");
  set("weapon_type", "long_blade");
  set("verbs", ({ "thrust", "slash", "slice", "hack" }));
}
