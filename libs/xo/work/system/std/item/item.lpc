// filename : /std/item.c

#include <dbase.h>
#include <move.h>
#include <name.h>

inherit F_CLEAN_UP;
inherit F_DBASE;
inherit F_MOVE;
inherit F_NAME;

private mapping Property;

void setup() {
  set_temp("create_time", time());
  this_object()->stats(0);
  seteuid(getuid());
}

int is_infective() {
  if (this_object()->query("infectivity"))
    return 1;
  return 0;
}

int is_medicine() {
  if (this_object()->query("is_medicine"))
    return 1;
  return 0;
}

int valid_leave(object me, string dir) {
  return 1;
}

int CanRecieve() {
  if (!nullp(Property) && Property["can_recieve"]) {
    return 1;
  } else {
    return 0;
  }
}

void SetProperty(string prop, mixed arg) {
  if (nullp(Property)) {
    Property = ([ prop: arg ]);
  } else {
    Property[prop] = arg;
  }
}
