// poison.c  
// by lnwm 98/03/31

// 基本想法：毒药有阳性，阴性和中性之分
//           体内同时种两种类型的毒药，当有互相克制的现象
//           但毕竟是毒药，当同时中两种类型的毒时，阴阳相消转为毒性相对较低的中性毒药。
//           中性毒药可看作是体内毒素的存留，不能解消，除非借助其他手段。

//           另外，毒药分对精气神不同的伤害。(gin,kee,sen)
//           同时还分硬伤和软伤。(receive_wound和recieve_damage)

//           中毒方式则应分为1。涂在兵器上，砍中后引发。(涉及combatd）
//                           2。放在食物，饮水里。(涉及put,eat,drink等cmds或标准饮食)
//                           3。散布在空气中，人走进去后引发。(涉及标准房间) 
//                           4。其他方式。(用add_action使用)

//           考虑毒药的慢发作特性，所有效果都作为condition存在在人身上。
//           由每次update_condition时判断发作状况。

// this is the standard inheritable poison.

//==================================================================================
//               poison.c ver1.1  新的毒药的继承文件                               
//               modified by xli   begin in 98/12/4                                  
//               各个属性及使用方法见程序注释
//==================================================================================

#include <dbase.h>
#include <ansi.h>
#include <poison.h>

inherit ITEM;

private class Poison poison = 0;

void setup()
{
	seteuid( getuid() );
	this_object()->reset();
}

void IsPoison()
{
    return 1;
}

void SetType(string m_type)
{
}
