// marry_npc.c
// by trill
#include <family.h>

string ask_about_marry() {
  object this, me, she;
  string my_id, her_id, my_family, her_family;
  int family_relation;

  this = this_object();
  me = this_player();

  if (me->query("can_swear"))
    return "我不是允许了你的婚事了吗？\n";

  if (me->query("gender") == "男性" && me->query("age") < 20 ||
    me->query("gender") == "女性" && me->query("age") < 18) {
    message_vision("$N冲$n笑了笑，", this, me);
    return "这件事不是你该问的吧？\n";
  }
  if (!me->query("will_marry")) {
    message_vision("$N迷惑地看着$n，", this, me);
    if (me->query("gender") == "男性")
      return "有谁答应嫁给你了？\n";
    else
      return "你答应嫁给谁了？\n";
  }
  my_id = me->query("id");
  her_id = me->query("will_marry");
  if (!objectp(she = present(her_id, environment(this)))) {
    message_vision("$N迷惑的看着$n，", this, me);
    return "你的心上人在哪里呢？快带来让师傅我看看了。\n";
  }

  my_family = me->query("family/family_name");
  her_family = she->query("family/family_name");
  family_relation = FAMILY_D->family_relation(my_family, her_family);

  command("look " + her_id);

  // 判断是不是本门的公敌。
  if (FAMILY_D->is_family_enemy(my_family, she)) {
    message_vision("$N狠狠的瞪了$n一眼，说道：你还敢来这里，滚！\n",
      this, me);
    return "你怎么就喜欢这个人，这人是本门公敌呀。\n";
  }
  // 判断 my_family 和 her_family 的敌对度
  if (family_relation == FAMILY_ENEMY) {
    message_vision("$N对$n摇摇头说道：本派与" + her_family +
      "是敌多年，你还是请回吧。\n", this, she);
    return "我不同意你的婚事。\n";
  }
  // 判断是不是本门的大叛徒。
  if (she->query("class_score/" + my_family) < -50) {
    message_vision("$N对$n怒斥：你还有脸来见我？\n", this, she);
    return "天下这么多人，你怎么喜欢上这个人？我不同意！i\n";
  }

  // 可以同意了。
  // TODO 如果条件合适师傅就送份贺礼。

  me->set("can_swear", 1);
  return "为师我同意你的婚事了，呵呵！\n";
}
