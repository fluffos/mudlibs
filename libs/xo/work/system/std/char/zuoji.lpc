//标准坐骑，所有要让人骑的东西都要inherit它 /d/system/std/char/zuoji.c

inherit NPC;

void create() {
  set("can_be_ride", 1);      //给一个这种动物可以骑的标记，在ride.c里面判断
  set("is_rided_by", 0);      //这个动物的骑乘者的名字
  set("str", 100);      //这个动物的膂力
  set("max_sen", 800);      //这个动物的体能
  set("sen", 800);
  set("max_xingcheng", 200);  //这个动物最大的行程，超过行程就要倒毙。对于标准的马来说，
  //为200，也就是说可以在标准的地图上行走200个room，大概是
  //兰州到大理的两个来回。沙漠、沼泽、戈壁可以参照这个标准
  //设计。
  set("xingcheng", 0);
  set("speed", 200);  //这个动物的速度，速度高的可以follow低的，可以和玩家的身法折算
  //公式在/system/feature/team.c里面规定。好马等应该比200高，驴
  //骆驼、牛等应该慢(建议不要设为10以下，因为不知道什么时候有人
  //可能要做骑乌龟、骑蜗牛...:PP
  set_max_encumbrance(200000);
}
