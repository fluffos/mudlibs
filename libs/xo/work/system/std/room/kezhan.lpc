inherit ROOM;

void init() {
  seteuid(getuid());
  seteuid(geteuid());

  add_action("DoSave", "jicun");
  add_action("DoLoad", "tiqu");
  add_action("DoCheck", "check");
}

string value_string(int value) {
  if (value < 1)
    value = 1;
  else if (value < 1000)
    return chinese_number(value) + "文钱";
  else
    return chinese_number(value / 1000) + "两"
      +(value % 1000 ? "又" + chinese_number(value % 1000) + "文钱" : "");
}

int DoSave(string arg) {
  string item;
  object env, ob, me;
  me = this_player();
  env = environment(me);

  if (query("temp/busy"))
    return notify_fail("伙计赔笑着说：“客官稍等片刻，就好就好。”\n");

  if (!arg || sscanf(arg, "%s", item) != 1)
    return notify_fail("指令格式：jicun <物品> \n");

  if (!objectp(ob = present(item, me)))
    return notify_fail("你身上没有这样东西。\n");

  if (ob->query("value") > 1000000)
    return notify_fail(
      "伙计赔笑着说：“客官的东西太贵重了，小店不敢收哇。”\n");

  message_vision("$N取出身上的" + ob->query("name") + "，交给伙计收了
起来。\n", me);
  message_vision("$N对伙计说：“好好保管，我以后再来取！”\n", me);
  write(base_name(ob));
  me->set("jicun/" + base_name(ob), file_name(env));
  destruct(ob);
  env->set("temp/busy", 1);
  remove_call_out("Dest");
  call_out("Dest", 1, ob);
  return 1;
}
