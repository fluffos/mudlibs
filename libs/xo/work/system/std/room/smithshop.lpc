// 标准铁匠铺   /std/room/smithshop.c
// By Lin on March 7,1997
// Changed by Lala, 1998-03-23

inherit ROOM;

void init() {
  seteuid(getuid());
  add_action("DoSell", "sell");         //可以收购铁器的函数。
}

int DoSell(string arg)                    //可以收购铁器的函数。
{                                           //arg：要收购的物品名。
  object ob, ppl = this_player();
  string mat;
  int weight, value;

  if (!ppl->can_act())
    return 0;

  if (!arg
    || !(ob = present(arg, ppl)))
    return notify_fail("你要卖断什么物品？\n");

  mat = ob->query("material");

  if (!mat                               //判断物品的质地：是否为“铁”或者
  || (mat != "iron"                  //“钢”。
  && mat != "steel"))
    return notify_fail("这里只收铁器。\n");

  weight = ob->query_weight();

  if (!value = ob->query("value")) {
    if (mat == "iron")
      value = weight / 25;                //铁单价为：４０（文钱／千克）
      else
        value = weight / 20 * 3;            //钢单价为：１５０（文钱／千克）
  }

  value = value / 3;

  if (!value)
    return notify_fail("这样东西不值钱。\n");

  if (ob->query("cant_sell"))
    return notify_fail(ob->query("cant_sell"));

  message_vision("$N把身上的" + ob->query("name") + "卖了"
    +PriceString(value) + "。\n", ppl);         //计价。

  PayPlayer(ppl, value);                //付款。

  destruct(ob);

  return 1;
}
