// zuo_zimu.c

#define QUEST(x) ("/d/menpai/wuliang/quest/quest"+x)

inherit NPC;
inherit F_MASTER;

#include <ansi.h>
#include "east_master.h"

int time_period(int timep, object me);
//string ask_me(object who);
string change_master(object who);
string master_name(object me);

void create() {
  set_name("左子穆", ({ "zuo zimu", "zuo", "zimu" }));
  set("class", "swordsman");
  set("gender", "男性");
  set("age", 50);
  set("str", 30);
  set("cor", 30);
  set("cps", 30);
  set("int", 25);
  set("ker", 24);
  set("kar", 30);
  set("max_force", 1500);
  set("force", 1500);
  set("force_factor", 3);

  set("rank_info/respect", "左先生");
  set("class", "swordsman");

  set("long", "左子穆身材极为高大，目光犀利，但也儒雅有礼，显然曾读过不少书。\n");

  create_family("无量剑派东宗", 5, "掌门人");

  set("combat_exp", 1000000);
  set("social_exp", 200000);

  set_wugong("lingxiao-shou", 100);
  set_wugong("nanshan-liushi", 70);
  set_wugong("force", 50);
  set_wugong("literate", 40);
  set_wugong("haoran-zhengqi", 60);
  set_wugong("wuliang-jian", 100);
  set_wugong("wl-shenfa", 120);
  set_wugong("liuyun-jian", 120);
  set("inquiry", ([
    "此地": "这里便是无量剑派。",
    "姓名": "嗯，你既知我姓左，怎会不知在下便是无量东宗掌门人左子穆？,
        " 指 点 武 功 " : (: change_master :),
    ]) );

    setup();
    carry_object(__DIR__" obj / xuanquan ")->wield();
    carry_object(__DIR__" obj / choushan ")->wear();
}

void init()
{
    object this, env, me;

    add_action( " do_kneel ", ({ " kneel ", " ketou " }) );
    //add_action(" give_quest ", " quest ");

    this = this_object();
    env = environment( this );
    me = this_player();
    if (( env->query( " short " ) == " 侧 厅 " ) &&
        ( this->query_temp( " bai_zuo " ) == me->query( " id " ) ))
    {
        remove_call_out( " tell_mengui " );
        call_out( " tell_mengui ", 1, me );
    }
}

// 这儿我希望实现的是当 ppl 拜了 zuo 以后, zuo 走去侧厅等待 ppl 完成拜师
// 仪式. 可能出现的意外情况是 ppl 不过去, 这种情况 zuo 会记住谁放了他鸽
// 子, 在这次 MUD 运行中就拒收这个 ppl.
int attempt_apprentice(object me)
{
    object this, env;
    string my_id;

    my_id = me->query( " id " );
    this = this_object();
    env = environment( this );
    if ( env->query(" short ") == " 侧 厅 " )
    {
        message_vision(" 左 子 穆 向 东 一 指 ， 对 $N 说 ： 你 先 去 大 厅 等 我 。 \ n ", me);
        return 1;
    }
    if ( env->query(" short ") != " 大 厅 " )
    {
        message_vision(" 左 子 穆 说 ： 一 切 从 权 吧 ， 入 了 我 门 ， 可 得 守 规 矩 呀 。 。 。 \ n ", me);
        command( " recruit " + me->query(" id ") );        
        message_vision(" 左 子 穆 对 $N 说 ： 什 么 时 候 你 再 去 跟 老 高 领 把 剑 吧 。 ” \ n ", me);
        return 1;
    }
    if ( this->query_temp( " bai_list / " + my_id ) )
    {
        command( " heng " + my_id );
        message_vision(" 左 子 穆 冷 冷 地 对 $N 说 ： 你 品 性 不 正 ， 不 配 入 我 门 。 \ n ", me);
        return 1;
    }
    command( " nod " + my_id );
    this->set_temp( " bai_zuo ", my_id );
    this->set_temp( " bai_list / " + my_id, 1 );
    call_out( " back_dating ", 30 );
    message_vision(" 左 子 穆 对 $N 说 ： 既 然 这 样 ， 先 随 我 去 拜 过 了 祖 师 。 \ n ", me);
    command( " go west " );
}

void back_dating()
{
    if ( environment( this_object() )->query(" short ") == " 侧 厅 " )
    {
        command( " go east " );
    }
}

void tell_mengui( object me )
{
    message_vision(YEL@MSG
左子穆对$N说: 既然入我门下，第一便是要恪守本派门规。你听好了，我无量剑派

        首戒欺师灭祖，不敬尊长；  二戒同门操戈，兄弟不和。
        三戒心猿意马，不用心练功；四戒恃强凌弱，擅伤无辜。
        五戒奸淫好色，调戏妇女；  六戒口出妄言，行事不正。
        
这些门规，你要记牢了，如有违反，我定严惩不殆！！
好了，给祖师爷磕头吧！
MSG NOR, me);
    me->set_temp( " bai_zuo ", 1 );
}

int do_kneel(string arg)
{
    object sword, me, this;
    mapping family;

    me = this_player();
    this = this_object();
    if ( environment( this )->query(" short ") != " 侧 厅 " )
    {
        tell_object( me, " 你 打 算 给 谁 磕 头 啊 ？ \ n " ); 
        return 1;
    }
    if ( me->query_temp( " bai_zuo " ) )
    {
        message_vision(" $N 对 着 墙 上 挂 着 的 祖 师 像 拜 了 八 拜 ， 站 起 身 来 。 \ n ", me);
        message_vision(" 左 子 穆 高 兴 对 $N 笑 了 笑 ， 说 ： 很 好 很 好 。 \ n ", me);
        message_vision(" $n 决 定 收 $N 为 弟 子 。 \ n \ n "
                " $N 跪 了 下 来 向 $N 恭 恭 敬 敬 地 磕 了 四 个 响 头 ， 叫 道 ： 「 师 父 ！ 」 \ n ",
                me, this);
        recruit_apprentice( me );
        family = me->query(" family ");
        tell_object( me,
            sprintf(" 恭 喜 您 成 为 % s 的 第 % s 代 弟 子 。 \ n ", family[" family_name "],
            chinese_number(family[" generation "]) ));
        me->set(" class "," swordsman ");
        sword = new(__DIR__" obj / sword ");
        sword->move( me );
        sword->set(" long "," 一 把 无 量 剑 派 本 门 使 用 的 长 剑 ， 剑 上 刻 着 " + HIY " 无 量 剑 " +
            me->query(" name ") + NOR" \ n ");
        me->delete_temp( " bai_zuo " );
        this->delete_temp( " bai_zuo " );
        this->delete_temp( " bai_list / " + me->query(" id ") );
        message_vision(" 左 掌 门 将 一 把 刻 着 $N 名 字 的 长 剑 交 给 了 $N ， 说 ： 这 把 剑 就 归 你 "
                   " 随 身 携 带 使 用 。 \ n 记 住 ， 剑 在 人 在 ， 剑 亡 人 亡 ！ \ n ", me);
        command( " go east " );
        return 1;
    }
    return 0; 
}

int recruit_apprentice(object me)
{
    ::recruit_apprentice(me);
    me->set(" master "," shang yuqing ");
    message_vision(" 左 子 穆 对 $N 说 ： 你 现 在 先 去 跟 商 师 兄 学 点 本 门 的 基 本 功 夫 吧 。 \ n ", me);
    return 1;
}
                
// qyz & falcon
// let player can change a master when he becomes strong...
string change_master(object who)
{
    string master_id, msg;
    object me;

    me = this_player(); 
    if ( me->query(" family / family_name ") != " 无 量 剑 派 东 宗 " )
        return " 这 位 " + RANK_D->query_respect(me) + " 说 笑 了, 老 朽 无 德 无 能, 何 言 指 点.\ n ";
    // 如果还没有 master, 就先指定商余庆. 不过怎么可能没有呢!!!
    if ( !me->query(" master ") )
	{
        me->set( " master ", " shang yuqing " );
		msg = " 从 今 天 起 ， 你 就 去 跟 商 余 庆 师 兄 学 习 本 门 基 本 武 功 吧 。 \ n ";
	}
    else if ( !me->query(" defeat_master ") )
    {
        if ( !me->query_temp(" fight_master ") )
        {
            me->set_temp(" fight_master ", 1);
            printf( " 左 子 穆 沉 思 了 一 会 ... \ n " );
            msg = sprintf( " 好 ， 你 去 跟 % s 比 试 一 下 ， 再 做 决 定 吧 。 \ n ",
                master_name(me) );
        }
        else
        {
            printf( " 左 子 穆 有 些 发 怒 。 \ n " );
            msg = sprintf( " 好 高 骛 远 ， 是 学 不 好 功 夫 的 ， 你 还 是 先 跟 % s 多 学 点 东 西 再 说 。 \ n ",
                master_name(me));
            me->add(" class_score ", -1);
        }
    }
	else
	{
    	me->delete(" defeat_master ");
    	switch ( me->query(" master ") )
		{
        	case " shang yuqing ":
                me->set( " master ", " qu lianxing " );
                msg = " 好 ， 你 现 在 可 以 去 跟 曲 连 兴 师 兄 学 习 了 。 \ n ";
                break;

            case " qu lianxing ":
                me->set( " master ", " rong ziju " );
                msg = " 嗯 ， 不 错 ， 现 在 就 让 你 容 师 叔 来 指 导 你 吧 。 \ n ";
                break;
	
            case " rong ziju ":
                me->set( " master ", " zuo zimu " );
                msg = " 好 徒 儿 ， 从 今 天 开 始 ， 为 师 亲 自 指 点 于 你 ！ \ n ";
                break;
		}
	}
    return msg;
}

string master_name( object me )
{
    string master_id;
    master_id = me->query(" master ");
    switch ( master_id )
    {
        case " shang yuqing " : return " 你 商 师 兄 ";
        case " qu lianxing " : return " 你 曲 师 兄 ";
        case " rong ziju " : return " 你 容 师 叔 ";
        case " zuo zimu " : return " 为 师 我 ";
        default : error( " master_name " );
    }
}

//modify qyz 1997-3-26
int give_quest()
{
	mapping quest ;
	object me,ob;
	int j, class_score, timep, bonus,num;  
	string tag = " 1000000 ";
         string *levels = ({
                        " 0 ",
                        " 400 ",
                        " 900 ",
                        " 1600 ",
                        " 2500 ",
                        " 3600 ",
                        " 4900 ",
                        " 6400 ",
                        " 8100 ",
                        " 10000 ",
                        " 12100 ",
                        " 14400 ",
                        " 40000 ",
                        " 50000 ",
                        " 60000 ",
                        " 80000 ",
                        " 100000 ",
                        " 200000 ",
                        " 400000 ",
                        " 800000 ",
                        " 1000000 "
        });
	me = this_player();
        ob = this_object();
        if(me->query(" family / family_name ")!=this_object()->query(" family / family_name ") )
        {
             tell_object(me,ob->name()+" 疑 惑 地 看 着 你 ： “ 这 位 "+RANK_D->query_respect(me)+" 想 要 做 什 么 ？ ” \ n ");
                return 1;
        }
        if(quest = me->query(" quest "))
        {
             if( me->query(" done_quest ") == quest[" quest "] )
             {
                    tell_object(me,quest[" reward_msg "]);
                    me->add(" class_score ",quest[" bonus "]);
                    printf(HIR"->师 门 忠 诚 度 升 高 % s 点 \ n "NOR
                        ,chinese_number(quest[" bonus "]) );
                    if( quest[" positive_score "])
                    {
                        me->add(" positive_score ",quest[" positive_score "]);
                        printf(HIG"->正 评 价 升 高 % s 点 \ n "NOR
                        , chinese_number(quest[" positive_score "]) );
                    }
                    if( quest[" negative_score "])
                    {
                        me->add(" negative_score ",quest[" negative_score "]);
                        printf(HIC"->负 评 价 升 高 % s 点 \ n "NOR
                        ,chinese_number(quest[" negative_score "]) );
                    }
                    me->delete(" done_quest ");
                    me->delete(" quest ");
                    return 1;
              }

              else 
              {
                 if( ((int) me->query(" task_time ")) >  time() && quest[" time "])
                      return 0;
                  else
                  {
		      tell_object(me,quest[" fail_msg "]);
                      me->add(" class_score ",-quest[" bonus "]/3);
                      if(quest[" bonus "]/3)
                        printf(HIY"->师 门 忠 诚 度 下 降 % s 点 \ n "NOR
                        ,chinese_number(quest[" bonus "]/3) ); 
		      me->delete(" quest ");
                      return 1;
                  }
               }            
         }
         if((int)me->query(" task_time ")&&
                (int)me->query(" task_time ") > time()) 
         {                     
                message_vision(refuse_msg[random(sizeof(refuse_msg))],ob);        
                return 1;
         }
        class_score = (int)me->query(" class_score ");
        for(j= sizeof(levels) - 1 ; j>=0; j--)
        {
                if( atoi(levels[j])  <= class_score )
                        {
				num=j;
                                break;
                        }
        }
/*	if (num>0)
	{
		if (random(50+me->query_kar())>65)
		{
			num=num-1;
		}
	} else {
		if ((num<sizeof(levels)-1)&&(random(100)>95))
		{
			num=num+1;
			factor=15;
		}
	}
*/
	if (num>9)
	{
		num=9;
	}
	tag=levels[num];			
//现在先共用一个quest库。
        tag = 0;
        quest = QUEST(tag)->query_quest();
        tell_object(me,quest[" quest_msg "]);
       	me->set(" quest ", quest);
        me->delete(" task_time ");
        if( timep = quest[" time "] )
        {
            time_period( timep, me);
            me->set(" task_time ", (int) time()+(int) quest[" time "]);
        }
        return 1;
}

int time_period(int timep, object me)
{
        int t, d, h, m, s;
        string time;
        t = timep;
        s = t % 60;             t /= 60;
        m = t % 60;             t /= 60;
        h = t % 24;             t /= 24;
        d = t;

        if(d) time = chinese_number(d) + " 天 ";
        else time = " ";

        if(h) time += chinese_number(h) + " 小 时 ";
        if(m) time += chinese_number(m) + " 分 ";
        time += chinese_number(s) + " 秒 ";

        tell_object(me,HIW " 你 有 " + time + " 的 时 间 \ n 去 完 成 你 师 傅 给 的 任 务 。 \ n "NOR);
        return 1;
}

int accept_object(object who, object ob)
{
	string test;
	mapping quest;
        if(!(quest =  who->query(" quest ")))
	{
        tell_object(who,this_object()->name()+" 笑 道 ： “ 你 给 我 东 西 干 什 么 ？ ” \ n ");
	return 0;
	}
        if( " 取 "+ob->name(1) != quest[" quest "] || ob->is_character())
        {
        tell_object(who,this_object()->name()+" 皱 眉 说 ： “ 我 当 初 可 不 是 让 你 去 找 这 个 呀 ！ ” \ n ");
        return 0;
        }
        if ( who->query(" task_time ") && (int) who->query(" task_time ") < time() )
        {
        tell_object(who,quest[" delay_msg "]);
        who->delete(" quest ");
        return 1;
        }
        else
        {
                    tell_object(who,quest[" reward_msg "]);
                    who->add(" class_score ",quest[" bonus "]);
                    printf(HIR"->师 门 忠 诚 度 升 高 % s 点 \ n "NOR
                        ,chinese_number(quest[" bonus "]) );
                    if( quest[" positive_score "])
                    {
                        who->add(" positive_score ",quest[" positive_score "]);
                        printf(HIG"->正 评 价 升 高 % s 点 \ n "NOR
                        , chinese_number(quest[" positive_score "]) );
                    }
                    if( quest[" negative_score "])
                    {
                        who->add(" negative_score ",quest[" negative_score "]);
                        printf(HIC"->负 评 价 升 高 % s 点 \ n "NOR
                        ,chinese_number(quest[" negative_score "]) );
                    }
                    who->delete(" quest ");
                    return 1;
        }
}

