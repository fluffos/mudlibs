// qu_lianxing.c

inherit NPC;

#include "east_master.h"

string *wugong = ({
	"基本拳法(unarmed)",
    "基本剑法(sword)",
    "基本轻功(jiben-qinggong)",
    "凌霄拿云手(linxiao-shou)",
    "南山六式(nanshan-liushi)",
}); 

string ask_qingjiao( object );
string ask_wugong( object );

void create()
{   
	set_name("曲连兴", ({ "qu lianxing","qu" }) );
    set("gender", "男性" );
    set("age",25);
    create_family("无量剑派东宗", 6, "弟子");
    
	set_wugong("unarmed",80,80,1);
    set_wugong("nanshan-liushi",40,30,1);
    set_wugong("taizu-quan",70);
    set_wugong("force",80,80,1);         
    set_wugong("haoran-zhengqi",50,40,1);
    set_wugong("sword",60,40,1);         
    set_wugong("wuliang-jian",40,20,1);
    set_wugong("parry",80,50,1);
	set_wugong("wl-shenfa",80,80,1);
    set_xiuwei_by_type("parry",100);
    set_xiuwei_by_type("sword",100);
    set_xiuwei_by_type("dodge",100);
    set_xiuwei_by_type("unarmed",100);
    
	set("max_force",1500);
    set("force",1000);
    set("force_factor",50);
    set("combat_exp",20000);

    set( "inquiry", ([
        "请教" : (: ask_qingjiao :),     
        "学习" : (: ask_qingjiao :),
        "职责" : "我同商余庆负责看守通往后山的要道，职责重大。",
        "后山" : "这个问题我不能回答你，要问，问掌门人去。",
        "功夫" : (: ask_wugong :),
        "武功" : (: ask_wugong :),
    ]) );

    setup();
    //carry_object(__DIR__"obj/cloth")->wear();
}

void init()
{ 
    add_action("do_leave","go");
}

int do_leave(string arg)
{
    if ( arg == "eastup" )
	{
    	message_vision( "曲连兴拦住了$N，说：后山是本派重地，你请回吧。\n",
			this_player() );
      	return 1;
    }
}

string ask_qingjiao(object who)
{
	return "你连商余庆都打不过，就想让我指点于你？";
}

string ask_wugong(object who)
{
    if ( random( 100 ) > 70 )
    	return "我能指点你" + wugong[ random(sizeof(wugong)) ] + "。\n";
    else if ( random( 100 ) > 50 )
    	return "我能教你" + wugong[ random(sizeof(wugong)) ] + "，怎么样，想学吗？\n";
    else
        return "你入本门也是有些时间的啦，怎么还不知道情况呢？\n";
}
 
