// rong_ziju.c

inherit NPC;

#include <ansi.h>
#include "east_master.h"

string ask_me(object);

void create()
{
    seteuid( getuid() );
    
    set_name("容子矩", ({ "rong ziju", "rong" }) );

    set("gender", "男性" );
    set("age", 50);
    set("str", 25);
    set("int", 30);
    set("per",24);
    set("long","容子矩为人极为精明,办事干练,无量派上上下下的事都要经他的手.\n");
    set("combat_exp", 10000);
    set("social_exp", 10000);
    set("class_score", 1000);
    set("attitude", "herosim");
    create_family("无量剑派东宗", 5, "弟子");

    set("inquiry",([
        "武功" : (: ask_me :),
    ]) );
        
    set("force", 2000);
    set("max_force", 2000);
    set("force_factor", 10);
    set("kee",200);
    set("max_kee",200);

    set_wugong("unarmed", 100);
    set_wugong("lingxiao-shou", 80);
	set_wugong("wl-shenfa", 100,100,1);
    set_wugong("force", 80);
    set_wugong("haoran-zhengqi", 60);
    set_wugong("sword", 100);
    set_wugong("wuliang-jian", 80);
    set_wugong("taizu-quan", 60);
    set_wugong("parry", 100);
    set_xiuwei("parry", 100);
    set_xiuwei("dodge", 100);
    set_xiuwei("unarmed", 100);
    set_xiuwei("sword", 100);
    
    setup();
    //carry_object(__DIR__"obj/cloth")->wear();
    carry_object(__DIR__"obj/xuanquan")->wield();
    //add_money("silver", 10);
}

void init()
{
    object ob;

    ::init();
    if ( interactive( ob = this_player() ) &&
         !is_fighting() &&
         random( 100 ) > 50 )
    {
        remove_call_out("greeting");
        call_out("greeting", 1, ob);
    }
}

void greeting(object ob)
{
    if ( !ob || !present(ob, environment(this_object()) ) ||
         !is_tongmen_of( ob ) )
    {
        return;
    }
    say( "容子矩笑眯眯地说:过来一块练练吧!\n"NOR );
}

