int GetSeason()
{
    return Season;
}

int GetTime()
{
    return Time;
}

int Season( int month )
{
    if( month >= 3 && month <= 5 )
        return SPRING;
    else if( month >=6 && month <= 8 )
        return SUMMER;
    else if( month >=9 && month <= 11 )
        return AUTUMN;
    else if( month == 12 || month >=1 && month <= 2 )
        return WINTER;
    else 
        return SPRING;
}

int Time( int shichen )
{
    if( shichen >= 4 && shichen <= 6 )
        return MORNING;
    else if( shichen >= 7 && shichen <= 8 )
        return NOON;
    else if( shichen >= 9 && shichen <= 10 )
        return AFTERNOON;
    else if( shichen >= 11 && shichen <= 12 )
        return EVENING;
    else if( shichen >= 1 && shichen <= 3 )
        return NIGHT;
    else
        return MORNING;
}

void StartBadWeather( string place, int weather )
{
    switch( place )
    {
        case "XIYU":        
            call_out( "EndBadWeather", 100 + random( 500 ), place, CLOUD ); 
            XiYuBW = weather;       break;
        case "XIBEI":       
            call_out( "EndBadWeather", 100 + random( 300 ) ,place, CLOUD ); 
            XiBeiBW = weather;      break;
        case "ZHONGYUAN":   
            call_out( "EndBadWeather", random( 300 ), place, CLOUD );         
            ZhongYuanBW = weather;  break;
        case "GUANWAI":     
            call_out( "EndBadWeather", random( 400 ), place, CLOUD );         
            GuanWaiBW = weather;    break;
        case "XINAN":       
            call_out( "EndBadWeather", random( 400 ), place, CLOUD );         
            XiNanBW = weather;      break;
        case "JIANGNAN":    
            call_out( "EndBadWeather", 100 + random( 500 ), place, CLOUD );         
            JiangNanBW = weather;   break;                                
        case "OTHER":       
            call_out( "EndBadWeather", random( 100 ), place, CLOUD );         
            OtherBW = weather;      break;
    }
}

void EndBadWeather( string place, int weather )
{
    switch( place )
    {
        case "XIYU":        
            XiYuBW = weather;       break;
        case "XIBEI":       
            XiBeiBW = weather;      break;
        case "ZHONGYUAN":   
            ZhongYuanBW = weather;  break;
        case "GUANWAI":     
            GuanWaiBW = weather;    break;
        case "XINAN":       
            XiNanBW = weather;      break;
        case "JIANGNAN":    
            JiangNanBW = weather;   break;                                
        case "OTHER":       
            OtherBW = weather;      break;
    }
}

int GetWeather( string place, int season )
{
    switch( place )
    {
        case "XIYU":        
            if ( XiYuBW >= 3 )
                return XiYuBW;
            break;
        case "XIBEI":       
            if ( XiBeiBW >= 3 )
                return XiBeiBW;
            break;
        case "ZHONGYUAN":   
            if ( ZhongYuanBW >= 3 )
                return ZhongYuanBW;
            break;
        case "GUANWAI":     
            if ( GuanWaiBW >= 3 )
                return GuanWaiBW;
            break;
        case "XINAN":       
            if ( XiNanBW >= 3 )
                return XiNanBW;
             break;
        case "JIANGNAN":    
            if ( JiangNanBW >= 3 )
                return JiangNanBW;
            break;
        case "OTHER":       
            if ( OtherBW >= 3 )
                return OtherBW;
             break;
    }
    
    if( season == WINTER )
    {
        switch( place )
        {
            case "XIYU":
            case "XIBEI":
            case "GUANWAI":
                if( Random1 == 0 )
                {
                    StartBadWeather( place, SNOW );
                    return CLOUD;
                };
                break;
            case "ZHONGYUAN":
                if( Random2 == 0 )
                {
                    StartBadWeather( place, SNOW );
                    return CLOUD;
                };
                break;
            default:
                if( random(2))
                    return FINE;
                else
                    return CLOUD;
        };
        if( random(2) )
            return FINE;
        else
            return CLOUD;
    }
    else if( season == SUMMER )
    {
        switch( place )
        {
            case "XINAN":
            case "JIANGNAN":
                if( Random1 == 0 )
                {
                    StartBadWeather( place, RAIN );
                    return CLOUD;
                };
                break;
            case "XIBEI":
            case "XIYU":
            case "ZHONGYUAN":
                if( Random2 == 0  )
                {
                    StartBadWeather( place, RAIN );
                    return CLOUD;
                };
                break;
            default:
                if( random(2))
                    return FINE;
                else
                    return CLOUD;
        };
        if( random(2) )
            return FINE;
        else
            return CLOUD;
    }
    else if( random(2) )
        return FINE;
    else
        return CLOUD;
}

string GetDescription( string place, int season, int time , int weather )
{
    if( weather == SNOW )
        return Snow[random(2)];
    else if ( weather == RAIN )
        return Rain[random(2)];
    else if( weather == CLOUD )
        return Cloud[time-1];
    else if( weather == FINE )
        return Fine[time-1];
    else
        return "其他天气";
}

string GetPlaceDescription( string place, int season, int time , int weather )
{
    if( weather == SNOW )
        return SnowPlace[random(2)];
    else if ( weather == RAIN )
        return RainPlace[random(2)];
    else if( weather == CLOUD )
        return CloudPlace[time-1];
    else if( weather == FINE )
        return FinePlace[time-1];
    else
        return "其他天气";
}


void create()
{
//	day_phase = read_table(SYSTEM_CONFIG_DIR + "day_phase"); 
    init_day_phase();
}

void init_day_phase()
{
	Season = Season( QueryMonth() );
    Time = Time( QueryShiChen() );
    Random1 = random( 4 );
    Random2 = random( 8 );
    call_out( "update_day_phase", 1 );
}

void update_day_phase()
{
    object room;
    string str;

    Season = Season( QueryMonth() );
    Time = Time( QueryShiChen() );

    remove_call_out("update_day_phase");
    
    foreach( object ppl in users() )
    {
        room = environment( ppl );
        if( room && room->query("outdoors") )
        {
            str = GetDescription( PLACE_D->Contain( room ), 
                        GetSeason(), GetTime(), 
                        GetWeather( PLACE_D->Contain( room ), GetSeason() ) );
            // bu ....
//            if(wizardp(ppl)) 
//            printf( "Season: %d, Place: %s, Weather: %d\n",
//                        GetSeason(), PLACE_D->Contain( room ), 
 //                       GetWeather( PLACE_D->Contain( room ), GetSeason() ) );
            tell_object( ppl, str + "\n" );
        }             
    }
    OpenGate();// lin的东西，放着好了。
    Random1 = random( 4 );
    Random2 = random( 8 );
    call_out( "update_day_phase", 60 );
}

string outdoor_room_description( object room )// 在look.c里要用，不过返回的就不用原来的了。
{
//	return "    " + day_phase[current_day_phase]["desc_msg"] + "。\n";
//    printf( "Season: %d, Place: %s, Weather: %d\n",
//                        GetSeason(), PLACE_D->Contain( room ), 
//                        GetWeather( PLACE_D->Contain( room ), GetSeason() ) );
    return "    " + GetPlaceDescription( PLACE_D->Contain( room ), 
                        GetSeason(), GetTime() , 
                        GetWeather( PLACE_D->Contain( room ), GetSeason() ) ) + "\n";
}

