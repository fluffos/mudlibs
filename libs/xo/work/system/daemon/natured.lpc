// NATURE_D
// 重写了关于时辰和季节的表示，原来的不合理。
// 另外加了气候和不同区域的气候表现。
// by lnwm 98-09-22

// 24小时一年。6小时一个季节。
// 那么我们的一天就不能严格按时间换算，否则是3分钟一天。未见得合适。
// 现在我们约定15分钟一天，那么一个季节是24天。
// (实际上在长期上，我们的时间系统与系统时间吻合，
// 既我们的一年就是系统的一年。而原来的natured与系统时间脱离)
// 每天要有日落日出。黑夜要有黑夜的表现。

// 天气是依附于区域的，不同区域气候表现要不同。

// 这样就存在两套时间系统(例如：QueryShiChen和query_shichen)。
// 我建议以后全部使用前一种，也就是natured中规定的时间系统。

#include <ansi.h>

#define ND_YEAR         0   
#define ND_SEASON       1
#define ND_MONTH        2
#define ND_DAY          3
#define ND_SHICHEN      4
#define ND_SHIKE        5
#define ND_MIN          6

#define SPRING      1
#define SUMMER      2
#define AUTUMN      3
#define WINTER      4

#define MORNING     1
#define NOON        2
#define AFTERNOON   3
#define EVENING     4
#define NIGHT       5     

#define FINE        1
#define CLOUD       2
#define RAIN        3
#define SNOW        4   //这些将来移到nature.h里。

mapping *day_phase;
private int Season;     //春，夏，秋，冬
private int Time;       //清晨，中午，下午，晚上，深夜
