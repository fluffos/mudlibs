void OpenGate()// lin的东东
{
    object where;
    if ( where = find_object( "/d/city/lanzhou/beimen" ) )
        where->init();
}                   

mixed *RealTime()
{
    mixed *result = allocate(10);
    int time = time();

    if (time < 0)
        time = -time;

    result[ND_YEAR] = time / 86400;     //一年是86400秒
    time %= 86400;
    result[ND_SEASON] = time / 21600;   //一季度是21600秒
    time %= 21600;
    result[ND_MONTH] = time / 7200;     //一月是7200秒
    time %= 7200;                       //按我们的约定，一个月是8天。
    result[ND_DAY] = time / 900;        //一天是900秒(15分钟)。
    time %= 900;
    result[ND_SHICHEN] = time / 75;     //一个时辰是75秒。
    time %= 75;
    result[ND_SHIKE] = time/19;         //一刻是18。75秒 
    time %= 19;
    result[ND_MIN] = time;              //再往下就用不着了吧。

    return result;
}

int QueryYear() 
{
    return RealTime()[ND_YEAR] + 1;
}

int QuerySeason()
{
    return RealTime()[ND_SEASON] + 1;
}

int QueryMonth()
{
    return RealTime()[ND_SEASON] * 3 + RealTime()[ND_MONTH] + 1;
}

int QueryDay()
{
    return RealTime()[ND_DAY] + 1;
}

int QueryShiChen()
{
    return RealTime()[ND_SHICHEN] + 1;
}

int QueryShiKe()
{
    return RealTime()[ND_SHIKE];
}

int AtNight()
{
    if( Time == EVENING || Time == NIGHT )
        return 1;
    else 
        return 0;
}
