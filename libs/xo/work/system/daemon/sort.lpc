#include "include/sort.h"

int ComparePlayer(object Player1, object Player2)
{
    int result = 0;
    
    if ( result = CompareWizardLevel( wiz_level( Player1 ),
        wiz_level( Player2 ) ) )
    {
    }
    else if ( result = CompareFamily( Player1->query( "family/family_name" ), 
        Player2->query( "family/family_name" ) ) )
    {
    }
    else if ( result = CompareZuzhi( Player1, Player2 ) )
    {
    }
    else if ( result = CompareAge( Player1->query( "age" ),
        Player2->query( "age" ) ) )
    {
    }
    else if ( result = CompareId( Player1->query( "id" ),
        Player2->query( "id" ) ) )
    {
    }
    else
    {
        result = 0;
    }
    return result;
}

int CompareFamily( string family1, string family2 )
{
    function f = function( string family )
        {
            for ( int i = 0; i < sizeof( Families ); i ++ )
            {
                if ( family == Families[ i ] ) return i;
            }
        };
    return sign( evaluate( f, family1 ) - evaluate( f, family2 ) );
}

int CompareZuzhi( mixed one, mixed two )
{
    return 0;
}

int CompareWizardLevel( int level1, int level2 )
{
    return sign( level1 - level2 );
}

int CompareAge(int age1, int age2 )
{
    return sign( age1 - age2 );
}

int CompareId(string id1, string id2)
{
    if ( !stringp( id1 ) || !stringp( id2 ) )
    {    
        return 0;
    }
    else
    {
        return strcmp( id1, id2 ); 
    }
}

int CompareIp( string ip1, string ip2 )
{
    if ( !stringp( ip1 ) || !stringp( ip2 ) )
    {
        return 0;
    }
    else
    {
        return strcmp( ip1, ip2 );
    }
} 
