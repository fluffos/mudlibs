// eff_status_msg() &  status_msg()
// 因此把其注释如下
// 替换在下面

    if ( effective )     
        message_vision( "( $N" +
                        eff_status_msg( eff_kee * 100 / max_kee ) + " )\n", ob );
    else
        message_vision( "( $N" +
                        status_msg( kee * 100 / max_kee ) + " )\n", ob );

