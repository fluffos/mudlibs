#include <lib.h>
#include <mudlib.h>
#include <network.h>

inherit LIB_CLIENT;

private void create() {
  SetSocketType(STREAM);
  SetDestructOnClose(1);
  seteuid(ROOT_UID);
}

varargs int SendEmail(string dest, string sub, string msg, string replyto) {
  if (!dest)
    return 0;
  if (!replyto)
    //replyto=this_player()->query("email"); //?????????
    replyto = ADMIN_EMAIL;
  eventCreateSocket("127.0.0.1", 25);  // connect to SMTP server;
  msg = replace_string(msg, "\n.\n", "\n..\n");
  //    catch
  //    {
  eventWrite("HELO " + mud_id() + "\n");
  eventWrite("MAIL FROM: <" mud_id() " LPMUD>\n");
  eventWrite("RCPT TO: " + dest + "\n");
  eventWrite("DATA\n");
  eventWrite("From: \"" + MUD_NAME + "\" <" + ADMIN_EMAIL ">\n");
  eventWrite("To: <" + dest + ">\n");
  eventWrite("Reply-To: <" + replyto + "> (" +
    geteuid(this_player()) + "@" + mud_id() + ">\n");
  eventWrite("Subject: " + sub + "\n\n");
  eventWrite(msg + "\n.\n");
  eventWrite("QUIT\n");
  //    }
}

void eventRead(mixed buf) {
  log_file("smtp", sprintf("%O", buf));
}

void eventWrite(mixed buf) {
  log_file("smtp", sprintf("%O", buf));
  client::eventWrite(buf);
}
