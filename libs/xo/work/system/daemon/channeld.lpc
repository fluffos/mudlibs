// change newbie to new by cry 10.7.98

#include <ansi.h>
#include <options.h>
#include <channels.h>

#include <net/daemons.h>

private string family;

mapping channels = ([
  "sys": ([ "msg_speak": SYSTEM_STRING "%s：%s\n" NOR, "wiz_only": 1 ]),
  "wiz": ([ "msg_speak": WIZ_STRING "%s：%s\n" NOR, "wiz_only": 1 ]),
  "gwiz": ([ "msg_speak": GWIZ_STRING "%s：%s\n" NOR, "wiz_only": 1,
    "intermud": 1, "gchannel": "gwiz"
  ]),
  "xo": ([ "msg_speak": XO_STRING "%s：%s\n" NOR,  //"wiz_only" : 1,
  "gchannel": "gchat", "intermud": 1
  ]),
  "chat": ([ "msg_speak": CHAT_STRING "%s：%s\n" NOR ]),
  "rumor": ([ "msg_speak": RUMOR_STRING "%s：%s\n" NOR, "anonymous": "某人" ]),
  "ft": ([ "msg_speak": HIW "【%s】%s\n" NOR, "family": 1 ]),
  "new": ([ "msg_speak": NEWBIE_STRING "%s：%s\n" NOR ]),
]);

mapping g_channels = ([
  "xo": XO_STRING,
  "gwiz": GWIZ_STRING,
  "admin": GADMIN_STRING
]);

int repeat_count = 0;

void create() {
  // This is required to pass intermud access check.
  seteuid(getuid());
}

varargs int do_channel(object me, string verb, string arg, int emote) {
  object *ob;
  string *tuned_ch, who, real;

  if (!mapp(channels) || undefinedp(channels[verb]))
    return 0;

  if ((int)me->query("chblk_rumor") && (verb == "rumor" || verb == "rumor*"))
    return notify_fail(HIY "你的谣言频道被关闭了！\n" NOR);
  if ((int)me->query("chblk_chat") && (verb == "chat" || verb == "chat*"))
    return notify_fail(HIY "你的闲聊频道被关闭了！\n" NOR);
  if ((int)me->query("chblk_sys") && verb == "sys")
    return notify_fail(HIY "你的系统频道被关闭了！\n" NOR);

  if (userp(me) && newbiep(me) && !wizardp(me) && verb != "new" && verb != "ft")
    return notify_fail(HIY "新手只能使用新手频道(new)。\n" NOR);
  //add newbie channel by lnwm 98-09-16

  if (!me->query("family") && verb == "ft")
    return notify_fail("你现在不属于任何门派。\n");

  if (userp(me)) {
    if (channels[verb]["wiz_only"] && !wizardp(me))
      return 0;

    if (!wizardp(me)) {
      if (arg == (string)me->query_temp("last_channel_msg"))
        repeat_count++;
      else
        repeat_count = 0;
      if (repeat_count >= CHAT_REPEAT_LIMIT)
        return notify_fail(HIR "用交谈频道说话请不要多次重复。\n" NOR);
      // TODO : 记录下越限的 ppl, 因为他们有灌水之嫌
    }

    // If we speaks something in this channel, then must tune it in.
    tuned_ch = me->query("channels");
    if (!pointerp(tuned_ch))
      me->set("channels", ({ verb }));
    else if (member_array(verb, tuned_ch) == -1)
      me->set("channels", tuned_ch + ({ verb }));
  }

  if (userp(me) || !stringp(who = me->query("channel_id")))
    who = me->query("name") + "(" + capitalize(me->query("id")) + ")";

  if (channels[verb]["anonymous"]) {
    real = who;
    who = channels[verb]["anonymous"];
  }

  if (channels[verb]["family"]) {
    family = me->query("family/family_name");
    arg = sprintf("%s：%s", who, arg);
    who = family;
  }

  // Ok, now send the message to those people listening us.
  ob = filter_array(users(), "filter_listener",
    this_object(), channels[verb]);

  if (userp(me))
    me->set_temp("last_channel_msg", arg);

  if (!arg) arg = "...";

  if (channels[verb]["anonymous"]) {
    message("channel:sys",
      format_string(sprintf(channels["sys"]["msg_speak"],
        real + "的谣言", arg)), ob);
  }
  message("channel:" + verb,
    format_string(sprintf(emote ? channels[verb]["msg_emote"] :
      channels[verb]["msg_speak"], who, arg)), ob);

  if (arrayp(channels[verb]["extra_listener"])) {
    channels[verb]["extra_listener"] -= ({ 0 });
    if (sizeof(channels[verb]["extra_listener"]))
      channels[verb]["extra_listener"]->relay_channel(me, verb, arg);
  }

  if (!undefinedp(channels[verb]["intermud"])) {
#ifdef DEBUG
    object snooper = find_player("nerd");
    if (snooper) message("visoin", " sending intermud msg", snooper);
#endif
    INTERMUD_D->eventSendRMsg(this_player()->query("name"),
      channels[verb]["gchannel"], arg);
  }

  return 1;
}

int filter_listener(object ppl, mapping ch) {
  // Don't bother those in the login limbo.
  if (!environment(ppl)) return 0;

  if (ch["wiz_only"])
    return wizardp(ppl);

  if (ch["family"] && ppl->query("family/family_name") != family)
    return wizardp(ppl);

  return 1;
}

void register_relay_channel(string channel) {
  object ob;

  ob = previous_object();
  if (undefinedp(channels[channel]) || !ob) return;
  if (arrayp(channels[channel]["extra_listener"])) {
    if (member_array(ob, channels[channel]["extra_listener"]) >= 0)
      return;
    channels[channel]["extra_listener"] += ({ ob });
  } else
    channels[channel]["extra_listener"] = ({ ob });
}

void eventReceiveRMsg(string uid, string uname, string mud, string channel, string msg) {
  object *listener;
  string theMsg;
  /*    if (previous_object() != SERVICES_D)
        return;
*/
  switch (channel) {
    case "gchat":
    case "chat":
    case "xo":
    case "new":
    case "es2":     // :PP
      channel = "xo";
      listener = users();
      break;
    case "gwiz":
    case "wiz":
      channel = "gwiz";
      listener = filter(users(), (: wizardp :));
      break;
    case "admin":
      listener = filter(users(), (: wiz_level($1) > 3 :));
      break;
    default:
      listener = users();
  }
  if (undefinedp(g_channels[channel]))    // unkown channel...
  {
    log_file("intermud/channel", sprintf("Unkown Channel `%s' Received from %s\n",
      channel, mud));
    return;
  }
  theMsg = sprintf("%s(%s@%s)：", uname, capitalize(uid), mud);
  theMsg = format_string(g_channels[channel] + theMsg + msg + NOR "\n");
  message("channel:" + channel, theMsg, listener);
}
