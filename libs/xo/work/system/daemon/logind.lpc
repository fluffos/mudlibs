object find_body(string name) {
  object ob, *body;

  ob = find_player(name);
  if (objectp(ob)) return ob;
  body = children(USER_OB);
  for (int i = 0; i < sizeof(body); i++)
    if (clonep(body[i]) && getuid(body[i]) == name)
      return body[i];

  return 0;
}

int set_wizlock(int level) {
  if (wiz_level(this_player(1)) <= level)
    return 0;
  if (geteuid(previous_object()) != ROOT_UID)
    return 0;
  wiz_lock_level = level;
  return 1;
}


//Modified hydra 1998/10/05
//给新出生的人加上标记，注明是中原还是西域人
string select_start_room(object user) {
  string start_room;
  start_room = start_rooms[random(sizeof(start_rooms))];
  if (start_room == "/d/city/gaochang/center") {
    user->set("hydra/desert/from", "西域");
  } else {
    user->set("hydra/desert/from", "中原");
  }
  return start_room;
}

void log_login(object ob, object user, string format) {
  if (wiz_level(user->query("id")))
    log_file(WIZ_USAGE_LOG, sprintf(format,
      user->query("id"), user->query("name"),
      query_ip_name(ob), ctime(time())));
  else
    log_file(PPL_USAGE_LOG, sprintf(format,
      user->query("id"), user->query("name"),
      query_ip_name(ob), ctime(time())));
}

int new_random() {
  float base, u1, u2, n, N;

  N = -0.1;
  while (N < 0) {
    base = random(9999) + 1;
    u1 = base / 10000;
    base = random(9999) + 1;
    u2 = base / 10000;
    n = sqrt(-2 * log(u1)) * cos(2 * 3.1415 * u2);
    N = n * 4.7 + 10.5;
  }
  return to_int(N);
}

int select_max_age(object user) {
  int max_age;
  int per, Int, spi, con;

  per = user->query("per");
  Int = user->query("int");
  spi = user->query("spi");
  con = user->query("con");
  max_age = BASE_MAX_AGE + new_random();
  max_age -= (per - 20) / 3 + (Int - 20) / 3 + (spi - 20) / 3;
  max_age += con / 6;
  return max_age;
}

void replace_some_mark(object user) {
  if (user->query("family/family_name") == "无量剑派西宗") {
    user->set("no_kill", "west_wuliang");
  }
  if (user->query("class") == "bonze1") {
    user->set("bonze");
  }
  if (!user->query("max_age")) {
    user->set("max_age", select_max_age(user));
  }
  if (user->query("title") == "镇南王府第二代弟子") {
    user->set("title", "镇南王府见习家丁");
  }
}

///////////////////////////////////////////////////////////////////////////////
// Internal Functions

protected void read_config_file() {
  string file, *tmp;

  banned_name = ({});
  if (file = read_file(BANNED_NAME)) {
    tmp = filter(explode(file, "\n"), (: $1 && $1[0] != '/' :));
    foreach (string s in tmp) {
      s = replace_string(s, " ", "");
      banned_name += explode(s, ",");
    }
  }

  banned_id = ({});
  if (file = read_file(BANNED_ID)) {
    tmp = filter(explode(file, "\n"), (: $1 && $1[0] != '/' :));
    foreach (string s in tmp) {
      s = replace_string(s, " ", "");
      banned_id += explode(s, ",");
    }
  }
}

protected void read_multi_config_file() {
  string file, ip, id_list;
  string *lines;

  multi_allow = ([]);
  if (file = read_file(MULTI_ALLOW)) {
    lines = filter(explode(file, "\n"),
      (: $1 && $1[0] != '#' :)) - ({ 0 });
    foreach (string line in lines) {
      sscanf(line, "%s:%s", ip, id_list);
      multi_allow[ip] = explode(id_list, ",");
    }
  }
  if (file = read_file(MULTI_DENY))
    multi_deny = filter(explode(file, "\n"),
      (: trim($1) && $1[0] != '#' :)) - ({ 0 });
  if (sizeof(multi_deny))
    multi_deny = map(multi_deny, (: trim($1) :)) - ({ "" });
}

void read_revise_file() {
  string file, old_skill, new_skill;
  string *tmp;
  //int i;

  skill_revise = ([]);
  file = read_file(SKILL_REVISE);
  if (!file) return;

  tmp = filter(explode(file, "\n"), (: trim($1) && trim($1)[0] != '#' :));
  foreach (string s in tmp) {
    sscanf(s, "%s:%s", old_skill, new_skill);
    skill_revise[old_skill] = new_skill;
  }
}

void revise_illegal_data(object user) {
  int i, jibie, lingwu, jilei;
  string *old_skills;

  old_skills = keys(skill_revise);
  for (i = 0; i < sizeof(old_skills); i++) {
    jibie = user->query_jibie(old_skills[i]);
    if (jibie) {
      lingwu = user->query_lingwu(old_skills[i]);
      jilei = user->query_jilei(old_skills[i]);
      user->delete_wugong(old_skills[i]);
      user->set_wugong(skill_revise[old_skills[i]],
        jibie, lingwu);
      user->set_jilei(old_skills[i], jilei);
    }
  }

  user->delete_wugong("force");
  user->delete_wugong("parry");
  if (user->query("class") == "bonze")
    user->set("marks/leonhart/和尚", 1);
  user->save();
}

string trim(string str) {
  int j, i = 0;
  if (!strlen(str))
    return str;
  j = strlen(str) - 1;
  while (i < j && (str[i] == ' ' || str[i] == '\t'))
    i++;
  while (i < j && (str[j] == ' ' || str[j] == '\t'))
    j--;
  return str[i..j];
}
