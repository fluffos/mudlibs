// emoted.c
// Add new version support self rank calling and 
// calling target.
// modify 3/18/1997 Phoebus
// refuse newbie by lnwm 89-09-16

#define IGNORE_RETURN   1

#include <options.h>
#include <channels.h>

inherit F_SAVE;

mapping emote;

int repeat_count;
//    The emote mapping contains the data base of emote definitions. Each emote
//    is defined in a sub-mapping with the following structure:
//
//    myself    - the message emoter will see
//    target    - the message the target will see when targeted
//    others    - the message others will see when no argument.
//
//    The emote mapping is indexed with the emote 'pattern' instead of emote
//    verb. For example, typing "smile" without argument will cause the daemon
//    search the emote mapping with "smile" as key, and typing "smile someone"
//    will cause the daemon search the emote mapping with "smile $" pattern as
//    the key, while $ means one argument.
//
//    In the message string, the following substitutions will be applied before
//    sending the messages:
//
//    $N        - name of emoter
//    $n        - name of target
//    $P        - pronoun of emoter
//    $p        - pronoun of target
//
//    Original by Annihilator@ESII (11/09/94)
//      方便起见，这里用中文解释(GB CODE)
//      $K              - 对自己的一般称呼。（如：在下）
//      $k              - 对自己的粗鲁称呼。（如：愚兄）
//      $F              - 对别人的尊称。    （如：这位师太）
//      $f              - 对别人的粗鲁称呼。（如：死秃驴）
//      以上都是annihilator在/doc/mudlib/daemons/rank说明过的。
//      $Z              - 对自己的谦虚称呼。（如：笨弟我或愚兄我）
//      $z              - 对别人的呢称。    （如：大哥你或小弟你）
//      $Z 对应的参数回传是query_target_me。（系统自动判断哪个obj年龄大）
//      $z 对应的参数回传是query_me_target。（系统自动判断哪个obj年龄大）
//      add new by phoebus@xo(3/18/97)

// function prototype

void create() {
  if (!restore() && !mapp(emote))
    emote = ([]);

  repeat_count = 0;
}

int remove() {
  save();
  return 1;
}

string query_save_file() { return DATA_DIR + "daemon/emoted"; }

int do_emote(object me, string verb, string arg) {
  string str, str1, my_gender, target_gender, msg_postfix;
  object target;
  string arg1, who, *tuned_ch;
  int chat_flag, rumor_flag, wiz_flag, no_target = 0, channel_emote = 0;
  object env;

  if (verb == "wiz*" && !wizardp(me))
    return 0;
  if (verb == "chat*" || verb == "rumor*" || verb == "wiz*")
    if (userp(me) && newbiep(me) && !wizardp(me))
      return notify_fail(HIY "新手只能使用新手频道(new)。\n" NOR);
    else
      channel_emote = 1;

  if ((int)me->query("chblk_rumor") && verb == "rumor*")
    return notify_fail(HIY "你的谣言频道被关闭了！\n" NOR);
  if ((int)me->query("chblk_chat") && verb == "chat*")
    return notify_fail(HIY "你的闲聊频道被关闭了！\n" NOR);
  if ((int)me->query("chblk_sys") && verb == "chat*")
    return notify_fail(HIY "你的系统频道被关闭了！\n" NOR);
  /*  让新手可以用emote吧 changed by cry 10.7.98
        if( userp( me ) && newbiep( me ) && !wizardp( me ) && verb != "new" )
        return 0;
*/
  // return notify_fail( HIY "新手只能使用新手频道(newbie)。\n" NOR );
  // add by lnwm 98-09-16  ( need newbie* ?? I don't think so.. )
  // newbie 太长了，改成new了！ by cry 10.7.98

  if (channel_emote) {
    tuned_ch = me->query("channels");
    if (!pointerp(tuned_ch))
      me->set("channels", ({ verb[0..<2] }));
    else if (member_array(verb[0..<2], tuned_ch) == -1)
      me->set("channels", tuned_ch + ({ verb[0..<2] }));
    if (userp(me) && !wizardp(me)) {
      if (arg == (string)me->query_temp("last_channel_msg"))
        repeat_count++;
      else
        repeat_count = 0;
      if (repeat_count >= CHAT_REPEAT_LIMIT)
        return notify_fail(HIR "用交谈频道说话请不要多次重复。\n" NOR);
      // TODO : 记录下越限的 ppl, 因为他们有灌水之嫌
    }
  };

  if (userp(me) || !stringp(who = me->query("channel_id")))
    who = me->query("name") + "(" + capitalize(me->query("id")) + ")";

  if (channel_emote && userp(me))
    me->set_temp("last_channel_msg", arg);

  if (verb == "rumor*")
    message("channel:sys", HIB + format_string(SYSTEM_STRING + who
      + "的谣言：" + arg + "\n") + NOR, users());

  if (verb == "chat*" && !stringp(arg)) {
    message("channel:chat", XO_STRING + me->name() + "看起来表情丰富\n" NOR, users());
    return 1;
  };
  if (verb == "wiz*" && !stringp(arg)) {
    message("channel:wiz", BCYN BLU + WIZ_STRING + me->name() + "看起来表情丰富\n" + NOR, users());
    return 1;
  };

  if (verb == "rumor*" && !stringp(arg)) {
    message("channel:rumor", MAG + "【谣言】某人" + "看起来表情丰富\n" + NOR, users());
    return 1;
  };

  chat_flag = rumor_flag = 0;
  wiz_flag = 0;

  if (verb == "chat*" && arg != "") {
    if (sscanf(arg, "%s %s", verb, arg1) == 0)
      verb = arg;
    arg = arg1;
    chat_flag = 1;
  };

  if (verb == "wiz*" && arg != "") {
    if (sscanf(arg, "%s %s", verb, arg1) == 0)
      verb = arg;
    arg = arg1;
    wiz_flag = 1;
  };

  if (verb == "rumor*" && arg != "") {
    if (sscanf(arg, "%s %s", verb, arg1) == 0)
      verb = arg;
    arg = arg1;
    rumor_flag = 1;
  };

  if (stringp(arg) && arg != "") {
    // 连 env 都没有, 就别做 emote 了
    env = environment(me);
    if (!objectp(env)) return 0;

    target = present(arg, env);

    if (!chat_flag && !rumor_flag && !wiz_flag) {
      if (!objectp(target)) return 0;

      if (!target->is_character())
        return notify_fail("你要对谁做这个动作？\n");
    };

    if (!objectp(target) || !target->is_character()) {
      target = find_player(arg);
      if (!objectp(target)) no_target = 1;
    };

    if (!no_target) {
      target_gender = target->query("gender");

      if (target == me) {
        msg_postfix = "_self";
        target = 0;
      } else
        msg_postfix = "_target";
    };
  } else
    msg_postfix = "";

  if (!mapp(emote) || undefinedp(emote[verb]) || no_target) {
    if (chat_flag) {
      if (stringp(arg) && arg != "")
        message("channel:chat", CYN +
          format_string(XO_STRING + me->name() + verb + " " + arg)
          +NOR + "\n", users());
      else
        message("channel:chat", BBLU CYN +
          format_string(XO_STRING + me->name() + verb) + NOR + "\n", users());
      return 1;
    } else if (rumor_flag) {
      if (stringp(arg) && arg != "")
        message("channel:rumor", MAG +
          format_string(RUMOR_STRING + "某人" + verb + " " + arg)
          +NOR + "\n", users());
      else
        message("channel:rumor", MAG +
          format_string(RUMOR_STRING + "某人" + verb) + NOR + "\n", users());
      return 1;
    } else if (wiz_flag) {
      if (stringp(arg) && arg != "")
        message("channel:wiz", WHT BBLU +
          format_string(WIZ_STRING + me->name() + verb + " " + arg) +
          NOR + "\n", users());
      else
        message("channel:wiz", WHT BBLU +
          format_string(WIZ_STRING + me->name() + verb) +
          NOR + "\n", users());
      return 1;
    } else
      return 0;
  };

  my_gender = me->query("gender");
  str = emote[verb]["myself" + msg_postfix];

  if (stringp(str) && !chat_flag && !rumor_flag && !wiz_flag) {
    str = replace_string(str, "$N", me->name());
    str = replace_string(str, "$P", gender_self(my_gender));
    str = replace_string(str, "$K", RANK_D->query_self(me));
    str = replace_string(str, "$k", RANK_D->query_self_rude(me));
    if (objectp(target)) {
      str = replace_string(str, "$Z", RANK_D->query_target_me(target));
      str = replace_string(str, "$z", RANK_D->query_me_target(target));
      str = replace_string(str, "$F", RANK_D->query_respect(target));
      str = replace_string(str, "$f", RANK_D->query_rude(target));
      str = replace_string(str, "$n", target->name());
      str = replace_string(str, "$p", gender_pronoun(target_gender));
    }
    message("emote", CYN + format_string(str, 70, IGNORE_RETURN) + NOR, me);
  }

  if (objectp(target) &&
    stringp(str = emote[verb]["target"]) &&
    !chat_flag && !rumor_flag && !wiz_flag) {
    str = replace_string(str, "$N", me->name());
    str = replace_string(str, "$P", gender_pronoun(my_gender));
    str = replace_string(str, "$K", RANK_D->query_self(me));
    str = replace_string(str, "$k", RANK_D->query_self_rude(me));
    str = replace_string(str, "$Z", RANK_D->query_target_me(target));
    str = replace_string(str, "$z", RANK_D->query_me_target(target));
    str = replace_string(str, "$F", RANK_D->query_respect(target));
    str = replace_string(str, "$f", RANK_D->query_rude(target));
    str = replace_string(str, "$n", target->name());
    str = replace_string(str, "$p", gender_self(target_gender));
    message("emote", CYN + format_string(str, 70, IGNORE_RETURN) + NOR, target);
  }

  str = emote[verb]["others" + msg_postfix];

  if (stringp(str = emote[verb]["others" + msg_postfix])) {
    str1 = str;
    str = replace_string(str, "$N", me->name());
    str = replace_string(str, "$P", gender_pronoun(my_gender));
    str = replace_string(str, "$K", RANK_D->query_self(me));
    str = replace_string(str, "$k", RANK_D->query_self_rude(me));
    if (objectp(target)) {
      str = replace_string(str, "$Z", RANK_D->query_target_me(target));
      str = replace_string(str, "$z", RANK_D->query_me_target(target));
      str = replace_string(str, "$F", RANK_D->query_respect(target));
      str = replace_string(str, "$f", RANK_D->query_rude(target));
      str = replace_string(str, "$n", target->name());
      str = replace_string(str, "$p", gender_pronoun(target_gender));
    }

    if (!chat_flag && !rumor_flag && !wiz_flag) {
      env = environment(me);
      if (!objectp(env)) return 0;

      message("emote", CYN + format_string(str, 70, IGNORE_RETURN) + NOR,
        env, ({ me, target }));
    } else if (chat_flag) {
      message("channel:chat", BBLU CYN +
        format_string(XO_STRING + str, 70, IGNORE_RETURN) + NOR,
        users());
    } else if (wiz_flag) {
      message("channel:wiz", WHT BBLU +
        format_string(WIZ_STRING + str, 70, IGNORE_RETURN) + NOR,
        users());
    } else {
      str1 = replace_string(str1, "$N", "某人");
      str1 = replace_string(str1, "$P", gender_pronoun(my_gender));
      str1 = replace_string(str1, "$K", RANK_D->query_self(me));
      str1 = replace_string(str1, "$k", RANK_D->query_self_rude(me));
      if (objectp(target)) {
        str1 = replace_string(str1, "$Z", RANK_D->query_target_me(target));
        str1 = replace_string(str1, "$z", RANK_D->query_me_target(target));
        str1 = replace_string(str1, "$F", RANK_D->query_respect(target));
        str1 = replace_string(str1, "$f", RANK_D->query_rude(target));
        str1 = replace_string(str1, "$n", target->name());
        str1 = replace_string(str1, "$p", gender_pronoun(target_gender));
      };
      message("channel:rumor", MAG +
        format_string(RUMOR_STRING + str1, 70, IGNORE_RETURN) + NOR,
        users());
    };
  }

  if (objectp(target))
    target->relay_emote(me, verb);

  return 1;
}

int set_emote(string pattern, mapping def) {
  emote[pattern] = def;
  save();
  return 1;
}

int delete_emote(string pattern) {
  map_delete(emote, pattern);
  save();
  return 1;
}

mapping query_emote(string pattern) {
  if (!undefinedp(emote[pattern]))
    return emote[pattern];
  else
    return ([]);
}

string *query_all_emote() {
  return keys(emote);
}

