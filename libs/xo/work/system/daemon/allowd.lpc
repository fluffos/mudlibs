// allowd.c
// Created by Yuhj@XO for Experimental running period
// all users in the allowed_list will be allowed to loign
// regardless to any limit

// #include <net/telnet.h>
#include <localtime.h>
#include "options.h"

#define ALLOWED_LIST    "/system/etc/allowed_list"
#define TESTER_LIST     "/system/etc/tester_list"

void load_allow_list();
void load_tester_list();
void add_allow(string user_id);
void remove_allow(string user_id);
void add_tester(string user_id);
int is_allowed(string user_id);
void print_allow_list();
void print_tester_list();

string *ID_list;
string *tester_list;

void create() {
  seteuid(getuid());
  load_allow_list();
  load_tester_list();
}

void load_allow_list() {
  string *tmp, file;
  int loop;

  ID_list = ({});

  // reads in the id list from allowed list

  file = read_file(ALLOWED_LIST);
  if (!file) return;

  tmp = explode(file, "\n");
  for (loop = 0; loop < sizeof(tmp); loop++)
    if (tmp[loop][0] == '#' || tmp[loop][0] == '\n' || tmp[loop] == "")
      continue;
    else
      ID_list += ({ tmp[loop] });
}

void load_tester_list() {
  string *tmp, file;
  int loop;

  tester_list = ({});

  file = read_file(TESTER_LIST);
  if (!file) return;

  tmp = explode(file, "\n");
  for (loop = 0; loop < sizeof(tmp); loop++)
    if (tmp[loop][0] == '#' || tmp[loop][0] == '\n' || tmp[loop] == "")
      continue;
    else
      tester_list += ({ tmp[loop] });
}

int is_allowed(string user_id) {
  int i;
  mixed *lt;

  for (i = 0; i < sizeof(ID_list); i++)
    if (user_id == ID_list[i])
      return 1;

  for (i = 0; i < sizeof(tester_list); i++)
    if (user_id == tester_list[i]) {
      lt = localtime(time());
      if ((lt[LT_HOUR] >= TEST_START_TIME) &&
        (lt[LT_HOUR] <= TEST_END_TIME)) {
        return 1;
      }
      return 0;
    }

  return 0;
}

void print_allow_list() {
  int i;
  write("当前所有登记的 allowed list:\n");
  for (i = 0; i < sizeof(ID_list); i++)
    write(ID_list[i] + "\n");
}

void print_tester_list() {
  int i;
  string msg;

  msg = "当前所有登记的 tester list:\n";
  for (i = 0; i < sizeof(tester_list); i++) {
    msg = sprintf("%s %-15s", msg, tester_list[i]);
    if ((i + 1) % 4 == 0) msg += "\n";
  }
  msg += sprintf("\n一共有 %d 个测试者, 测试允许时间是 %d - %d\n",
    sizeof(tester_list), TEST_START_TIME, TEST_END_TIME);
  write(msg);
}

void add_allow(string user_id) {
  ID_list += ({ user_id });
  write_file(ALLOWED_LIST, ID_list[sizeof(ID_list) - 1] + "\n", 0);
}

void remove_allow(string user_id) {
  //printf( "this %O, me %O, prev %O\n",
  //    this_object(), this_player(), previous_object( -1 ) );
  if (!is_allowed(user_id)) {
    write(user_id + "并不在allowed list里面\n");
    return;
  };

  write("请直接修改" + ALLOWED_LIST + " 减掉" + user_id + "\n");
}

void add_tester(string user_id) {
  tester_list += ({ user_id });
  write_file(TESTER_LIST, tester_list[sizeof(tester_list) - 1] + "\n", 0);
}
