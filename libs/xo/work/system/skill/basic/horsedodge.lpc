// horsedodge.c

inherit SKILL;

mapping *action = ({
  ([ "action": "$n一拨马头，移开几寸，未能击中。", ]),
  ([ "action": "被$n机灵地一让，藏在马肚下，躲开了。", ]),
  ([ "action": "$n身子一侧，躲在马一侧,闪开了$N的这一击。", ]),
  ([ "action": "$n及时一夹马肚，向前一窜，避了开去。", ]),
  ([ "action": "$n已有准备，拨转马头,不慌不忙的躲开。", ]),
});

int valid_learn(object me) {
  return 0;
}

int valid_lian(object me) {
  return 0;
}

int is_native_skill() {
  return 3;
}

mapping query_action() {
  return action[random(sizeof(action))];
}

string query_xiuwei_type() {
  return "dodge";
}
