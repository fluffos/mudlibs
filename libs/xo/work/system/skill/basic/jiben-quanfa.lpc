inherit SKILL;

mapping *action = ({
  ([ "action": "$N冲着$n挥出一拳",
    "lian": "$N猛地向前挥出一拳",
    "jibie": 5,
    "sen": 1,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N兜手揽步，右肘使劲向$n撞去.......",
    "lian": "$N兜手揽步，猛地向右一撞，险些摔倒......",
    "jibie": 20,
    "sen": 1,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N右晃一步，左手冲着$n就是一拳!!",
    "lian": "$N倒了倒步子，一拳向左挥出，体会着出招的路数.....",
    "jibie": 25,
    "sen": 1,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N大喝一声，站稳马步，一拳打向$n的$l",
    "lian": "$N站稳马步，辨准方向，「呼」地打出一拳......",
    "jibie": 30,
    "sen": 1,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N双拳互错，跨上一步，双拳齐出砸向$n。。。。",
    "lian": "$N跨上一步，双拳互错，慢慢挥拳出招，体会着用力的诀窍...",
    "jibie": 40,
    "sen": 1,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N脚下移步换位，左手护胸，右手成拳，一拳向$n捶去.....",
    "lian": "$N左手护胸，右手一拳挥出",
    "jibie": 47,
    "sen": 1,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N一招「马步横踢」，右腿蜷，左脚铲，左手微拳，向$n腹部击去....",
    "lian": "$N摆起「马步横踢」的架式，右腿蜷，左脚铲，重心左移，带动左拳挥出。。。。",
    "jibie": 55,
    "sen": 1,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N大喝一声，跳起有二尺来高，左腿踢向$n肋下，同时双拳挥出，直击$n面门...",
    "lian": "$N大喝一声，纵身而起，二拳一腿同时攻出，尽力保持着身体的平衡......",
    "jibie": 64,
    "limb": "面门",
    "sen": 1,
    "damage_type": "瘀伤"
  ]),
});

string *parry_msg = ({
  "$n挥拳挡开了$N的进攻。\n",
  "$n双手护住要害，成功的架开了$N的攻势。\n",
});

string *unarmed_parry_msg = ({
  "$n挥臂一格，架住$P的这招。\n",
  "$n双拳与$N一对，双方全身均是一震。\n",
});

int valid_learn(object me) {
  return 1;
}

int valid_lian(object me) {
  object weapon;

  weapon = me->query_temp("weapon");
  if (weapon)
    return notify_fail("你必须空手练习\n");

  return 1;
}

mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}

string query_xiuwei_type() { return "unarmed"; }

// 返回这路武功的等级, 第一等返回 1, 第十等返回 10.
int query_dengji() { return 1; }

string query_parry_msg(object weapon) {
  if (!objectp(weapon))
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}
int query_youxiao_jibie() { return 8; }
int query_parry_ratio() { return 8; }
