inherit SKILL;

mapping *action = ({
  ([ "action": "$N双手划了个半圈，双掌按向$n的$l",
    "lian": "$N双手划了个半圈，双掌向前缓缓推出",
    "dodge": 10,
    "parry": 10,
    "sen": 5,
    "jibie": 0,
    "damage": 100,
    "damage_type": "淤伤"
  ]),
  ([ "action": "$N左手一记虚按，身形急旋，闪到$n的一侧，右掌向$n的$l拍去",
    "lian": "$N左手一记虚按，身形急旋，右掌发力拍出",
    "dodge": 15,
    "parry": 15,
    "sen": 5,
    "jibie": 25,
    "damage": 100,
    "damage_type": "淤伤"
  ]),
  ([ "action": "$N大喝一声，双掌幻化出满天的掌影，拍向$n",
    "lian": "$N大喝一声，双掌幻化出满天的掌影。",
    "dodge": 20,
    "parry": 20,
    "sen": 7,
    "jibie": 50,
    "damage": 120,
    "damage_type": "淤伤"
  ]),
  ([ "action": "$N左手虚划，右手立掌如刀，击向$n的$l",
    "lian": "$N左手虚划，右手立掌如刀，用力劈下",
    "dodge": 25,
    "parry": 25,
    "sen": 8,
    "jibie": 75,
    "damage": 170,
    "damage_type": "淤伤"
  ]),
  ([ "action": "$N气发丹田，力运掌心，双掌按向$n的$l",
    "lian": "$N气发丹田，力运掌心，双掌急速向前拍出",
    "dodge": 30,
    "parry": 30,
    "sen": 10,
    "jibie": 100,
    "damage": 170,
    "damage_type": "淤伤"
  ]),
  ([ "action": "$N双掌交错，左右穿插翻飞，拍向$n",
    "lian": "$N双掌交错，左右穿插翻飞，向前拍出",
    "dodge": 30,
    "parry": 30,
    "sen": 15,
    "jibie": 125,
    "damage": 150,
    "damage_type": "淤伤"
  ]),
  ([ "action": "$N双掌交错，变幻吞吐，幻化出一个光球，缓缓推向$n",
    "lian": "$N双掌交错，变幻吞吐，幻化出一个光球",
    "dodge": 30,
    "parry": 30,
    "sen": 15,
    "jibie": 150,
    "damage": 180,
    "damage_type": "淤伤"
  ]),
});

string *parry_msg = ({
  "$n双掌上架，架住了$N的攻势。\n",
  "$n双掌幻化出无数掌影，护住全身。\n",
  "$n双掌交错，左右穿插翻飞，全力防住了$N的攻势。\n",
  "$n身形急旋，向右闪开，左掌上架，档住了$N这一招。\n"
});


int valid_learn(object me) {
  if (me->query("social_exp") < 20000) {
    return notify_fail("你还需要在江湖中历练才能领悟这门武功。\n");
  } else if (me->query_temp("weapon")) {
    return notify_fail("学习绵掌必须空手。\n");
  } else {
    return 1;
  }
}

int valid_lian(object me) {
  if ((int)me->query("max_force") < 1000) {
    return notify_fail("你的内力不够，没有办法练绵掌。\n");
  } else if (me->query_temp("weapon")) {
    return notify_fail("学习绵掌掌必须空手。\n");
  } else {
    return 1;
  }
}

string query_xiuwei_type() {
  return "unarmed";
}

int query_dengji() {
  return 5;
}

//mapping query_action(object me,object weapon)
mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}

string *query_lian() {
  string *lian_msg;
  mapping lian_act;

  lian_msg = allocate(sizeof(action));
  for (int i = 0; i < sizeof(action); i++) {
    lian_act = action[i];
    lian_msg[i] = (string)lian_act["lian"];
  }
  return lian_msg;
}

string query_parry_msg(object weapon) {
  return parry_msg[random(sizeof(parry_msg))];
}

string perform_action_file(string action) {
  return __DIR__ "mian-zhang/" + action;
}
