// sharen-daofa ...trill 官兵、巡捕的武功
// by trill

inherit SKILL;

mapping *action = ({
  ([ "action": "$N大喝一声，双手握刀，全力向$n劈下。",
    "lian": "$N大喝一声，双手握刀，全力劈下。",
    "sen": 10,
    "jibie": 20,
    "damage": 100,
    "damage_type": "劈伤"
  ]),
  ([ "action": "$N双手持刀，发力迅速斜削向$n的$l。",
    "lian": "$N双手持刀，发力迅速向下斜削下去。",
    "sen": 10,
    "jibie": 40,
    "damage": 100,
    "damage_type": "劈伤"
  ]),
  ([ "action": "$N刀交左手，反手从一个诡异的角度砍向$n。",
    "lian": "$N刀交左手，反手从一个诡异的角度砍出。",
    "sen": 10,
    "jibie": 60,
    "damage": 100,
    "damage_type": "劈伤"
  ]),

});

string *parry_msg = ({
  "$n手中的$v舞成一团刀花，护住了全身。\n",
  "$n用手中的$v架开$N的攻势。\n",
});

int valid_learn(object me) {
  return 0;
}

int valid_lian(object me) {
  return 0;
}

string query_xiuwei_type() { return "blade"; }
string query_weapon_type() { return "blade"; }

int query_dengji() { return 3; }

mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}

string query_parry_msg(object weapon) {
  return parry_msg[random(sizeof(parry_msg))];
}

int query_youxiao_jibie() { return 20; }

int query_parry_ratio() { return 10; }
