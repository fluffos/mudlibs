//duoluoye-zhi.c  多罗叶指
//多罗叶指，据我构思是一种以指力弹，划，点，刺刺伤敌人为主的功夫。
//为少林七十二绝技之一。应是第七层的功夫。其招式名皆取自“四十二章经”。
//含佛法戒欲，无求，忍性，绝情的意思。
//若多罗叶指可以perform应该是有些类似六脉神剑吧。
//未用招名: 达世知幻,直心出欲,念等本空,心寂欲除,我空怖灭,行道在心,转重令轻
//假真并观,无著得道 
// leonhart 97/5 
mapping *action = ({
  ([ "action": "$N一式「出家证果」，左掌内含，右手呈兰花指轮番向$n胸前七坎要穴弹出。",
    "lian": "$N演一式「出家证果」，左手内扣，右手呈兰花指轮番向外弹出。",
    "zhaoshi": "「出家证果」",
    "damage": 20,
    "parry": 5,
    "dodge": 5,
    "jibie": 0,
    "sen": 6,
    "damage_type": "刺伤",
  ]),
  ([ "action": "$N身形微闪，幻化出数个身影，双手十指如电光石火般直插$n的\n"
    "$l，一式「断欲绝求」，招式之快，令人叹为观止。",
    "lian": "$N身形微闪，幻化出数个身影，双手十指如电光石火般向前直插而出\n"
    "一式「断欲绝求」，招式之快，令人叹为观止。",
    "zhaoshi": "「断欲绝求」",
    "damage": 30,
    "parry": 10,
    "dodge": 10,
    "jibie": 10,
    "sen": 7,
    "damage_type": "刺伤",
  ]),
  ([ "action": "$N左手虚划半圆罩向$n胸前三尺之内，右手轻撮，疾点向$n的$l，正是一式\n"
    "「割爱去贪」。",
    "lian": "$N左手虚划半圆罩向前方，右手撮成鹤指从中疾穿而出，体会「割爱去贪」\n"
    "内含的佛家禅意。",
    "zhaoshi": "「割爱去贪」",
    "damage": 40,
    "parry": 20,
    "dodge": 20,
    "jibie": 25,
    "sen": 6,
    "damage_type": "刺伤",
  ]),
  ([ "action": "$N轻提一口丹田气，已从头顶越向$n身后，趁$n惊惶失措，看也不看向背后连点\n"
    "三指，一式「明来暗谢」令$n退避不及。",
    "lian": "$N转一式「转重令轻」，轻提一口丹田气，向上跃起，随手向后点出三指。\n"
    "出手轻柔，正是「明来暗谢」一式的精要所在。",
    "zhaoshi": "「明来暗谢」",
    "damage": 50,
    "parry": 30,
    "dodge": 0,
    "jibie": 35,
    "sen": 7,
    "damage_type": "刺伤",
  ]),
  ([ "action": "$N口宣一声佛号，以一式「忍恶无嗔」，右手食指指地，斜斜向上\n"
    "勾出，指气如剑，直指$n$l。",
    "lian": "$N口宣一声佛号，以一式「忍恶无嗔」，右手食指指地，斜斜向上勾出。",
    "zhaoshi": "「忍恶无嗔」",
    "damage": 60,
    "parry": 0,
    "dodge": 30,
    "jibie": 50,
    "sen": 6,
    "damage_type": "刺伤",
  ]),
  ([ "action": "$N卖个破绽，待得$n来攻时，一手上引护胸，一手如莲花初绽，欲开却合\n"
    "几道隐约的指影直射$n$l，却是一招妙绝精微的「恶还本身」。",
    "lian": "$N一手上引护胸，一手如莲花初绽，欲开却合，几道隐约的指影直射出去，\n"
    "却是一招妙绝精微的「恶还本身」。",
    "zhaoshi": "「恶还本身」",
    "damage": 70,
    "parry": 30,
    "dodge": 30,
    "jibie": 60,
    "sen": 8,
    "damage_type": "刺伤",
  ]),
  ([ "action": "$N对$n的攻式视若不见，使出一式「问道宿命」，身形如渊凝立，右手\n"
    "拇指斜斜向$n$l捺去。",
    "lian": "$N身形如渊凝立，右手拇指斜斜向外捺去，似已修得「问道宿命」一招\n"
    "个中三味。",
    "zhaoshi": "「问道宿命」",
    "damage": 80,
    "parry": 40,
    "dodge": 0,
    "jibie": 75,
    "sen": 9,
    "damage_type": "刺伤",
  ]),
  ([ "action": "$N突地单足点地，身形疾转，双手交叉轮指如飞，丝丝白气向$n周身射去\n"
    "正是「多罗叶指」的最后一式「生即有灭 」",
    "lian": "$N单足点地，身形疾转，双手交叉轮指如飞，丝丝白气向周遭射去，正是\n"
    "「多罗叶指」的最后一式「生即有灭 」",
    "zhaoshi": "「生即有灭」",
    "damage": 90,
    "parry": 40,
    "dodge": 40,
    "jibie": 90,
    "sen": 10,
    "damage_type": "刺伤",
  ])
});
string *parry_msg = ({
  "$n身形不动，觑得$n招式递老，左肩一沉，轻轻卸开了$N的招式。",
  "$n气沉双腿，一式「铁板桥」向后仰身，险险避过$N的一招。",
  "$n左跨数步，双掌飞舞而出，护住$l要害",
  "$n大喝一声，以攻为守，双手幻化出千道指影，挡住了$N的攻势",
});
string *unarmed_parry_msg = ({
  "$n身形不动，觑得$n招式递老，左肩一沉，轻轻卸开了$N的招式。",
  "$n气沉双腿，一式「铁板桥」向后仰身，险险避过$N的一招。",
  "$n左跨数步，双掌飞舞而出，护住$l要害",
  "$n大喝一声，以攻为守，双手幻化出千道指影，挡住了$N的攻势",
});

int valid_learn(object me) {
  if ((int)me->query("max_force") < 250)
    return notify_fail("你的内力不够，没有办法练多罗叶指。\n");

  return 1;
}

int valid_lian(object me) {
  if (me->query_temp("weapon"))
    return notify_fail("你得先把手中的兵刃放下才能修习多罗叶指。\n");

  return valid_learn(me);
}

string query_xiuwei_type() { return "unarmed"; }

string query_weapon_type() { return "unarmed"; }

int query_dengji() { return 4; }

mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}

string query_parry_msg(object weapon) {
  if (!weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string query_zhaoshi(int jibie) {
  int i;
  for (i = 0; i < sizeof(action); i++) {
    if (action[i]["jibie"] >= jibie)
      return action[i]["zhaoshi"];
  }
  return "";
}

int query_youxiao_jibie() { return 13; }

int query_parry_ratio() { return 8; }
