    "lian": "$N一挽手中$w，使出一招「蓝采和击板行歌」，只见$N吐声发力，$w遥遥\n"
    "点出，一股劲气夹着「啪、啪」的声音向前涌去。\n",
    "sen": 8,
    "jibie": 90,
    "dodge": 30,
    "parry": 20,
    "damage": 110,
    "wound": 65,
    "zhaoshi": "「蓝采和击板行歌」",
    "damage_type": "刺伤" ]),
});


string *parry_msg = ({
  "$n手中$v舞出无数剑花，一招「韩湘子风雪拥蓝关」封住$N手中的$w。\n",
  "$n不闪不避，左跨一步，右跨一步，迎着$N的攻势，一招「曹国舅捧笏上\n"
  "朝」$v化出一片光影全然封出了$N的攻势。\n",
  "$n一个趔趄，如醉酒一般向一侧跌出，$v接连刺出，一招「吕洞宾醉酒戏\n"
  "牡丹」化解了$N手中$w的攻势。\n",
});
string *unarmed_parry_msg = ({
  "$n手中$v舞出无数剑花，一招「韩湘子风雪拥蓝关」封住$N的攻势。\n",
  "$n不闪不避，左跨一步，右跨一步，迎着$N的攻势，一招「曹国舅捧笏上\n"
  "朝」$v化出一片光影全然封出了$N的攻势。\n",
  "$n一个趔趄，如醉酒一般向一侧跌出，$v接连刺出，一招「吕洞宾醉酒戏\n"
  "牡丹」化解了$N的攻势。\n",
});

int valid_learn(object me) {
  if (me->query("family/family_name") != "蓬莱派")
    return notify_fail("八仙剑不传授给非蓬莱派的弟子。\n");
  //这叫做不讲理.
  if ((int)me->query("max_force") < 100)
    return notify_fail("你的内力不够，没有办法练八仙剑法。\n");

  if ((string)me->query("using_force") != "penglai-xinfa")
    return notify_fail("八仙剑法必须配合蓬莱心法才能练。\n");

  return 1;
}

int valid_lian(object me) {
  object ob;
  ob = me->query_temp("weapon");
  if (!ob || (string)ob->query("weapon_type") != "sword")
    return notify_fail("你必须先找一把剑才能练习剑法。\n");

  return valid_learn(me);
}

string query_xiuwei_type() { return "sword"; }
string query_weapon_type() { return "sword"; }

int query_dengji() { return 4; }

mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string query_zhaoshi(int jibie) {
  int i;
  for (i = 0; i < sizeof(action); i++) {
    if (action[i]["jibie"] >= jibie)
      return action[i]["zhaoshi"];
  }
  return "";
}

int query_youxiao_jibie() { return 9; }

int query_parry_ratio() { return 8; }
