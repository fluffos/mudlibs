    "sen": 7,
    "jibie": 80,
    "dodge": 20,
    "parry": 20,
    "damage": 110,
    "wound": 60,
    "zhaoshi": "「吕洞宾醉酒戏牡丹」",
    "damage_type": "刺伤" ]),
  ([ "action": "$N一挽手中$w，使出一招「蓝采和击板行歌」，只见$N吐声发力，$w遥遥\n"
