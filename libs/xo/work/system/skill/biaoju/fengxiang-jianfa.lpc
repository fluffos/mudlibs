inherit SKILL;

mapping * action=({
    ([  "action"  : "$N使一招「登彼太行」，手中$w自下而上，沉猛无比地向$n的小腹挑去。",
        "lian"    : "$N使一招「登彼太行」，手中$w自下而上，发力向上挑出。",
        "jibie"   : 8,
        "sen"     : 5,
        "parry"   : 0,
        "dodge"   : 10,
        "damage"  : 50,
        "wound"   : 50,
        "limb"    : "小腹",
        "zhaoshi" : "「登彼太行」", 
        "damage_type":"刺伤"
    ]),
    ([  "action"  : "$N快步跨出，一招「声之于羌」，左手平托$w，右掌猛推剑尾，顶向$n的胸口。",
        "lian"    : "$N快步跨出，一招「声之于羌」，左手平托$w，右掌猛推剑尾，向前捅出。",
        "jibie"   : 16,
        "sen"     :  6,
        "parry"   :  10,
        "dodge"   :  0,
        "damage"  : 60,
        "wound"   : 50,
        "limb"    : "胸口",
        "zhaoshi" : "「声之于羌」",
        "damage_type":"刺伤"
    ]),
    ([  "action"  : "$N双手握持$w，一招「道不自器」，全身跃起，手中$w搂头盖顶地向$n劈去。",
        "lian"    : "$N双手握持$w，一招「道不自器」，全身跃起，手中$w向下劈去。",
        "jibie"   : 24,
        "sen"     :  7,
        "parry"   :  0,
        "dodge"   :  10,
        "damage"  : 60,
        "wound"   : 40,
        "zhaoshi" : "「道不自器」",
        "damage_type":"刺伤"
    ]),
    ([  "action"  : "$N一招「水理漩沌」，$w对准$n猛地一搅，如同平地刮起一阵旋风。",
   //这都是什么破招式名字呀？
        "lian"    : "$N一招「水理漩沌」，$w猛地一搅，如同平地刮起一阵旋风。",
        "jibie"   : 32,
        "sen"     :  5,
        "parry"   :  0,
        "dodge"   :  10,
        "damage"  : 65,
        "wound"    : 45,
        "zhaoshi" : "「水理漩沌」",
        "damage_type":"刺伤"
    ]),
    ([  "action"  : "$N横持$w，一招「悠悠花香」，$w出无数个圆圈，凝滞沉重，把$n圈在其中。",
        "lian"    : "$N横持$w，一招「悠悠花香」，$w出无数个圆圈，凝滞沉重。",
        "jibie"   : 40,
        "sen"     :  5,
        "parry"   :  10,
        "damage"  : 70,
        "wound"   : 50,
        "zhaoshi" : "「悠悠花香」",
        "damage_type":"刺伤"
    ]),
    ([  "action"  : "$N滚倒在地，手中$w护住全身，突出一招「翠绕羊肠」，$w倒转刺向$n小腹。",
        "lian"    : "$N滚倒在地，手中$w护住全身，突出一招「翠绕羊肠」，$w倒转向上刺出。",
        "jibie"   : 48,
        "sen"     :  6,
        "parry"   :  10,
        "dodge"   :  0,
        "damage"  : 70,
        "wound"   : 50,
        "limb"    : "小腹",
        "zhaoshi" : "「翠绕羊肠」",
        "damage_type":"刺伤"
    ]),
    ([  "action"  : "$N双手夹住$w，躬身一招「杳霭深玉」，$w自双掌飞出，拦腰向$n斩去。",
        "lian"    : "$N双手夹住$w，躬身一招「杳霭深玉」，$w横削一下。",
        "jibie"   : 56,
        "sen"     :  6,
        "parry"   :  0,
        "dodge"   :  10,
        "damage"  : 75,
        "wound"    : 50,
        "zhaoshi" : "「杳霭深玉」",
        "damage_type":"割伤"
    ]),
    ([  "action"  : "$N一招「如幽匪藏」，$w如飞龙般自掌中跃出，直直刺向$n的胸口。",
        "lian"    : "$N一招「如幽匪藏」，$w如飞龙般自掌中跃出，直直刺出。",
        "jibie"   : 64,
        "sen"     :  7,
        "parry"   :  0,
        "dodge"   :  0,
        "damage"  :  85,
        "wound"   :60,
        "zhaoshi" : "「如幽匪藏」",
        "damage_type":"刺伤"
    ]),
});

string *parry_msg = ({
    "$n横持$v，一招「悠悠花香」，$v出无数个圆圈，凝滞沉重，护住全身。\n",
    "$n全身滚倒，手中$v护住全身，突出一招「翠绕羊肠」，$v倒转向上架开$N的$w。\n",
    "$n双手夹住$v，躬身一招「杳霭深玉」，手中$v险险的架开了$N手中的$w。\n",
});

string *unarmed_parry_msg = ({
    "$n横持$v，一招「悠悠花香」，$v出无数个圆圈，凝滞沉重，护住全身。\n",
    "$n全身滚倒，突出一招「翠绕羊肠」，躲开了$N的攻势。\n",
    "$n双手夹住$v，躬身一招「杳霭深玉」，迫使$N转攻为守。\n",
});

int valid_learn(object me)
{
    return 1;     
}

int valid_lian( object me )
{
    object weapon;

    weapon = me->query_temp( "weapon" );
    if ( !weapon || weapon->query("weapon_type") != "sword" )
        return notify_fail("你必须先找一把剑才能练剑法。\n");

    return 1;
}

mapping query_action(int jibie)
{
    int i, size;

    size = sizeof( action );
    for ( i = 0; i < sizeof( action ); i++ )
        if ( action[ i ][ "jibie" ] > jibie )
        {
            size = i;
            break;
        }
    return action[ random( size ) ];
}

string query_xiuwei_type() { return "sword"; }     
string query_weapon_type() { return "sword"; }

int query_dengji() { return 3; }

string query_parry_msg(object weapon)
{
    if ( weapon )
        return parry_msg[random(sizeof(parry_msg))];
    else
        return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int query_youxiao_jibie() { return 8; }
int query_parry_ratio() { return 7; }

