string *parry_msg = ({
	"$n左脚一收，身体向左倾斜，使出一招「汉钟离玉洞论道」，右手上\n"
	"架，身形向左闪开。\n",
	"$n双掌一错，在身前一封，一招「韩湘子风雪拥蓝关」封住$n的门户。\n",
    "$n一个趔趄，如醉酒一般向一侧跌出，一招「吕洞宾醉酒戏牡丹」双掌\n"
    "接连拍出，化解了$N的攻势。\n",
});
string *unarmed_parry_msg = ({
	"$n左脚一收，身体向左倾斜，使出一招「汉钟离玉洞论道」，右手上\n"
	"架，身形向左闪开。\n",
	"$n双掌一错，在身前一封，一招「韩湘子风雪拥蓝关」封住$n的门户。\n",
    "$n一个趔趄，如醉酒一般向一侧跌出，一招「吕洞宾醉酒戏牡丹」双掌\n"
    "接连拍出，化解了$N的攻势。\n",
});

int valid_learn(object me)
{
    if ( me->query( "family/family_name" ) != "蓬莱派" )
        return notify_fail( "八仙掌不传授给非蓬莱派的弟子。\n");

	if( (int)me->query("max_force") < 100 )
		return notify_fail("你的内力不够，没有办法练八仙掌。\n");
	
	if( (string)me->query("using_force") != "penglai-xinfa" )
		return notify_fail("八仙掌必须配合蓬莱心法才能练。\n");

//	if( me->query_temp("weapon") )
//		return notify_fail("学习八仙掌必须空手。\n");  ?这是什么规矩？
	return 1;
}

int valid_lian( object me )
{
	if ( me->query("using_force") != "penglai-xinfa" )
        return notify_fail("八仙掌必须配合蓬莱心法才能练。\n");
	if( me->query_temp("weapon") )
		return notify_fail("练习八仙掌必须空手。\n");
	return 1;
}

string query_xiuwei_type()
{   
	return "unarmed";
}

int query_dengji()
{
    return 4;
}


mapping query_action(int jibie)
{
	int i, size;

	size = sizeof( action );
	for ( i = 0; i < sizeof( action ); i++ )
		if ( action[ i ][ "jibie" ] > jibie )
		{
			size = i;
			break;
		}
    return action[ random( size ) ];
}

string query_parry_msg(object weapon)
{   
    if ( weapon )
        return parry_msg[random(sizeof(parry_msg))];
    else
        return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string query_zhaoshi( int jibie )
{
    int i;
    for ( i = 0; i < sizeof(action); i++ )
    {
        if ( action[ i ][ "jibie" ] >= jibie )
            return action[ i ][ "zhaoshi" ];
    }
    return "";
}

int query_youxiao_jibie() { return 11; }

int query_parry_ratio() { return 10 ; }
