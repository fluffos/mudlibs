        "lian"  :"$N手拿$w，一招「玉石俱焚」，快速击出。",
        "sen"   :8,
        "jibie" :40,
        "dodge" :10,
        "parry" :10,
        "zhaoshi":"「玉石俱焚」",
        "damage" :110,
        "wound":90,
        "damage_type":"刺伤"    ]),
});

string *parry_msg = ({
    "$n使出一招「海天一线」手中的$v化作一条长虹，磕开了$N的$w。\n",
    "$n使出一招「以攻为守」，手中的$v化做漫天雪影，荡开了$N的$w。\n",
    "$n手中的$v一抖，一招「曲觞流水」，向$N拿$w的手腕削去。\n",
    "$n反手一招「天河倒泻」，手中$v化成一道光芒击出，\n",
    "$n使出一招「义无返顾」，$w直刺$N的双手。\n",
});

string *unarmed_parry_msg = ({
    "$n双手舞得密不透风，使出「如封似闭」，封住了$N的攻势。\n",
    "$n反手一招「海天一线」，挡开了$N的这一招。\n",
    "$n使出一招「以守为攻」，架住了$N的攻势。\n",
    "但见$n一招「玉石俱焚」，迫得$N连连后退。\n",
});

int valid_learn(object me)
{
    if ( me->query("max_force") < 600 )
    {   
        return notify_fail("你的内力不够，没有办法练石壁绝剑。\n");
    }
    if ( me->query_lingwu("haoran-zhengqi") < me->query_lingwu("jue-jian") )
    {   
        return notify_fail("石壁绝剑必须配合深厚的浩然正气才能练。\n");
    }
    return 1;
}

int valid_lian( object me )
{   
    object ob = me->query_temp("weapon");
    if ( !ob || (string)ob->query("weapon_type") != "sword" )
    {   
        return notify_fail("你必须先找一把剑才能练剑法。\n");
    }
    return valid_learn(me);
}

mapping query_action(int jibie)
{
	int i, size;

	size = sizeof( action );
	for ( i = 0; i < sizeof( action ); i++ )
		if ( action[ i ][ "jibie" ] > jibie )
		{
			size = i;
			break;
		}
    return action[ random( size ) ];
}

string query_parry_msg(object weapon)
{   
    if ( weapon )
        return parry_msg[random(sizeof(parry_msg))];
    else
        return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string query_xiuwei_type() { return "sword"; }         
string query_weapon_type() { return "sword"; }

int query_dengji() { return 4; }

int query_youxiao_jibie() { return 9; }

int query_parry_ratio() { return 8; }
