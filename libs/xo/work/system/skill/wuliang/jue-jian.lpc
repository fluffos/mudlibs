        "dodge" :40,
        "zhaoshi":"「以守为攻」",
        "damage" :85,
        "wound":30,
        "damage_type":"刺伤" ]),
    ([  "action":"$N左手捏了个剑诀，右手一招「海天一线」，手中$w微横，斜斜指向$n$l。",
        "lian"  :"$N左手捏了个剑诀，右手一招「海天一线」，手中$w微横，全身无一处破绽。",
        "sen"   :7,
        "jibie" :20,
        "dodge" :20,
        "parry" :30,
        "zhaoshi":"「海天一线」",
        "damage" :95,
        "wound":65,
        "damage_type":"割伤"    ]),
    ([  "action":"只见$N双手紧握$w，一招「如封似闭」，划出千百个大大小小的圈子，遮在$n身前。",
        "lian"  :"$N一个弓步，使出一招「如封似闭」，划出千百个大大小小的圈子。",
        "sen"   :8,
        "jibie" :30,
        "dodge" :30,
