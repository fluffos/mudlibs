// to add some new function from groupd.c(zuzhid.c)
//  说明：
//    每个组织有一个自己的文件"zuzhi".c，放在/system/feature/zuzhi/下面，
//  用来记载每个组织的一些数据库和单独的函数。每个人应该允许参加多个组织
//  正因为如此，一般上不应该让别人看到这个人的组织归属情况。
//  现在还是不让其它人看到组织属性，如果另一个人是你所在的组织中的上级，那么
//  他可以看到你是这个组织的什么人。（这个交给look.c去完成）
//  由于有TRILL 原来用的"zuzhi"数据存在，现在的组织数据改用"group"这个mapping.
#include <dbase.h>

string * GetZuzhiName();
//玩家一共参加的组织 
string * GetZuzhiId();
int IsMemberOf( string zuzhiname );
//检查这个玩家是否是这个组织的成员 
int JoinedZuzhiNumber();
//加入的组织的数目 
mapping GetZuzhi( string zuzhiname );
string ZuzhiName( string zuzhiname );
  //  组织的名称（正式中文名称） 
string ZuzhiId( string zuzhiname );
  //  这个id实际上就是zuzhiname
string ZuzhiTouxian( string zuzhiname );
  //  玩家在组织中的头衔 
string ZuzhiZhiwu( string zuzhiname );
  //  职务 
int EnterZuzhiTime( string zuzhiname );
  //  加入组织的时间（在加入组织时记录的） 
int LastContactTime( string zuzhiname );
  //  获取上次与组织联系的时间：应该就是上个quest的时间吧？ 
int ZuzhiScore( string zuzhiname );
  //  给出组织中的score.相当于family中的师门忠诚度.
void JoinZuzhi( string zuzhiname, string touxian, string zhiwu );
//加入组织,三项可以全是中文，也可以后两项是中文,
void LeaveZuzhi( string zuzhiname );
//离开组织
void IncreaseZuzhiTouxian( string zuzhiname, int step );
// 升级
int SetZuzhiTouxian( string zuzhiname, string touxian );
// 设定头衔
int SetZuzhiZhiwu( string zuzhiname, string zhiwu );
int DoneContact( string zuzhiname );
// 接触组织的记录
int SetZuzhiName( string zuzhiname, string name );
int SetZuzhiScore( string zuzhiname, int score );
int AddZuzhiScore( string zuzhiname, int score );
void Welcome( object who, string zuzhiname );//吸收who加入自己的组织.
//  这个函数可以先不写，因为是留给玩家用来接纳其他玩家加入自己的组织的.
//  这里只是对于数据的读出给予各种函数接口，关于数据的写入，一律由zuzhid.c完成，
//  以便记录在系统的文件中.

mapping group;
  //由于这里不能直接设值，所以在下面：
  // GetZuzhiname(),GetZuzhiId(),GetZuzhi( zuzhiname )
  //三个函数中定义了group = query("group");
  //而其他函数都要先调用到这三个函数否则不能得到group的数值。

string * GetZuzhiName()
{
    string *name;
    int i,num;
    if ( !group )
        return ({});
    num = JoinedZuzhiNumber();
    name = allocate( num );
    for ( i = 0; i < num; i++ )
        name[ i ] = ZuzhiName( keys( group )[ i ] );
    return name;
}
string * GetZuzhiId()
{
    string *id;
    int i,num;
    if ( !group )
        return ({});
    num = JoinedZuzhiNumber();
    id = allocate( num );
    for ( i = 0; i < num; i++ )
        id[ i ] = ZuzhiId( keys( group )[ i ] );
    return id;
}
int IsMemberOf( string zuzhiname )
{
    string *zuzhi;
    int i;
    if ( file_size( ZUZHI_DIR + zuzhiname + ".lpc" ) < 0 )
        return 0;
    zuzhi = GetZuzhiId();
    if ( !zuzhi )
        return 0;
    for ( i = 0; i < sizeof( zuzhi ); i++ )
        if ( zuzhi[ i ] == zuzhiname && !group[ zuzhi[i] ][ "deleted" ] )
            return 1;
    return 0;
}
int JoinedZuzhiNumber()
{
    if ( !group )
        return 0;
    return sizeof( keys( group ) );
}
mapping GetZuzhi( string zuzhiname )
{
    if( !group )
        return ([]);
    if( !group[ zuzhiname ] )
        return ([]);
    return group[ zuzhiname ];
}
string ZuzhiName( string zuzhiname )
{
    return GetZuzhi( zuzhiname )[ "name" ];
}
string ZuzhiId( string zuzhiname )
{
    return GetZuzhi( zuzhiname )[ "id" ];
}
string ZuzhiTouxian( string zuzhiname )
{
    return GetZuzhi( zuzhiname )[ "touxian" ];
}
string ZuzhiZhiwu( string zuzhiname )
{
    return GetZuzhi( zuzhiname )[ "zhiwu" ];
}
int EnterZuzhiTime( string zuzhiname )
{
    return GetZuzhi( zuzhiname )[ "entertime" ];
}
int ZuzhiScore( string zuzhiname )
{
    return GetZuzhi( zuzhiname )[ "score" ];
}
int ZuzhiTouxianJibie( string zuzhiname )
{
    string * all_touxian;
    int jibie,i;
    string touxian; 

    all_touxian = ( ZUZHI_DIR + zuzhiname )->QueryTouxian( this_object() );
    touxian = ZuzhiTouxian( zuzhiname );
    jibie = 0;
    for( i=0; i < sizeof( all_touxian ); i++ )
        if ( touxian == all_touxian[i] )
            jibie = i;
    return jibie; 
}
int ZuzhiZhiwuJibie( string zuzhiname )
{
    string * all_zhiwu;
    int jibie,i;
    string zhiwu; 

    all_zhiwu = ( ZUZHI_DIR + zuzhiname )->QueryZhiwu( this_object() );
    zhiwu = ZuzhiZhiwu( zuzhiname );
    jibie = 0;
    for( i=0; i < sizeof( all_zhiwu ); i++ )
        if ( zhiwu = all_zhiwu[i] )
            jibie = i;
    return jibie; 
}
int LastContactTime( string zuzhiname )
{
    return GetZuzhi( zuzhiname )[ "lastcontacttime" ];
}
void JoinZuzhi( string zuzhiname, string touxian, string zhiwu )
{
//加入组织,三项可以全是中文，也可以后两项是中文
//  就是说，touxian必须有，而zhiwu可以省略,当然，都省略是可以的。
//    SetTouxian( touxian, zuzhiname );// touxian
//    if ( GetZuzhi( zuzhiname ) )
//        return notify_fail( "你已经是这个组织的成员了啊？！\n" );
//    这个好象不用在这里判断吧？应该放在命令里。
    group = ZUZHI_D->SetupZuzhi( this_object(), zuzhiname, touxian, zhiwu, group );
    return;
}
void IncreaseZuzhiTouxian( string zuzhiname, int step )
{
    string * all_touxian;
    int jibie;
  
    all_touxian = ( ZUZHI_DIR + zuzhiname )->QueryTouxian( this_object() );
    jibie = ZuzhiTouxianJibie( zuzhiname ) + step;
    if ( jibie < 0 )
        jibie = 0;
    if ( jibie > sizeof( all_touxian ) )
        jibie = sizeof( all_touxian );
    SetZuzhiTouxian( zuzhiname, all_touxian[ jibie ] );
    return;
}
int SetZuzhiTouxian( string zuzhiname, string touxian )
{
    group[ zuzhiname ][ "touxian" ] = touxian;
    return 1;
}
int SetZuzhiZhiwu( string zuzhiname, string zhiwu )
{
    group[ zuzhiname ][ "zhiwu" ] = zhiwu;
    return 1;
}
int DoneContact( string zuzhiname )
{
    group[ zuzhiname ][ "lastcontacttime" ] = this_object()->query("mud_age");
    return 1;
}
int SetZuzhiName( string zuzhiname, string name )
{
    group[ zuzhiname ][ "name" ] = name;
    return 1;
}
int SetZuzhiScore( string zuzhiname, int score )
{
    group[ zuzhiname ][ "score" ] = score;
    return 1;
}
int AddZuzhiScore( string zuzhiname, int score )
{
    group[ zuzhiname ][ "score" ] = ZuzhiScore( zuzhiname ) + score;
    return 1;
}
void LeaveZuzhi( string zuzhiname )
{
    group = ZUZHI_D->DeleteZuzhi( this_object(), zuzhiname, group );
    return;
}
int IsRefusedBy( string zuzhiname )
{
    string *family, *zuzhi;
    int i;
    zuzhi = ( ZUZHI_DIR + zuzhiname  )->RefusedZuzhi();
    family = ( ZUZHI_DIR + zuzhiname  )->RefusedFamily();
    for ( i = 1; i < sizeof( family ); i++ )
        if ( query("family/family_name") == family[ i ] )
            return 1;
    for ( i = 1; i < sizeof( zuzhi ); i++ )
        if ( IsMemberOf( zuzhi[ i ] ) )
            return 1;
    return 0;
}
int IsBossOf( object mate, string zuzhiname )
{
    int my_jibie, his_jibie;
    if ( !IsMemberOf( zuzhiname ) || !mate->IsMemberOf( zuzhiname ) )
        return 0;
    my_jibie = ZuzhiTouxianJibie( zuzhiname );
    his_jibie = mate->ZuzhiTouxianJibie( zuzhiname );
    if ( my_jibie > his_jibie )
        return 1;
    return 0;
}
