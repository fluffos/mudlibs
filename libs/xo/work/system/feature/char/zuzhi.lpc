//  这个函数可以先不写，因为是留给玩家用来接纳其他玩家加入自己的组织的。
//  以下的函数是原来TRILL 搞的，要保留，并且要注意新的系统不能和这个老的
//  系统混淆。

int is_chairman_of( object chairman )
{
    mapping zuzhi;

    if ( !mapp( zuzhi = query( "zuzhi" ) ) )
        return 0;

    if ( zuzhi[ "chairman_id" ] == (string)chairman->query( "id" ) &&
         zuzhi[ "chairman_name" ] == (string)chairman->query( "name" ) )
        return 1;

    return 0;
}

int is_tongshi_of(object obj)
{
    mapping my_zuzhi, your_zuzhi;

    my_zuzhi = query("zuzhi");
    your_zuzhi = obj->query("zuzhi");
    if ( !mapp( my_zuzhi ) || !mapp( your_zuzhi ) )
        return 0;

    if ( my_zuzhi[ "zuzhi_name" ] == your_zuzhi[ "zuzhi_name" ] )
    {
        return 1;
    }
    return 0;
}

int in_samezuzhi_with(object obj)
{
    string *MyZuzhi, *UrZuzhi;

    MyZuzhi = GetZuzhiId();
    UrZuzhi = obj->GetZuzhiId();
    if ( !arrayp( MyZuzhi ) || !arrayp( UrZuzhi ) )
        return 0;

    foreach( string Zuzhi in MyZuzhi )
    {
        if ( member_array( Zuzhi, UrZuzhi ) != -1 )
            return 1;
    }
    return 0;
}

void assign_chengyuan(string title, int privs)
{
    mapping zuzhi;

    if ( !mapp( zuzhi = query("zuzhi") ) )
        return;

    zuzhi[ "title" ] = title;
    zuzhi[ "privs" ] = privs;

    if ( userp( this_object() ) || !query( "title" ) )
    {
        if ( zuzhi[ "generation" ] == 1 )
        {
            if ( zuzhi[ "title" ] )
                set( "title", sprintf( "%s%s", zuzhi[ "zuzhi_name" ],
                    zuzhi[ "title" ] ) );
            else
                set( "title", zuzhi[ "zuzhi_name" ] + "大首领" );
        }
        else
            set( "title", sprintf( "%s%s", zuzhi[ "zuzhi_name" ],
                zuzhi[ "title" ] ) );
    }

}

// This is used for NPC, or start a new zuzhi for a player.
varargs void create_zuzhi(string zuzhi_name, int generation, string title)
{
    mapping zuzhi;

    zuzhi = allocate_mapping( 6 );

    zuzhi[ "zuzhi_name" ] = zuzhi_name;
    zuzhi[ "generation" ] = generation;

    set( "zuzhi", zuzhi );

    // priv = -1 for ALL privileges.
    assign_chengyuan( title, -1 );
}

varargs int recruit_chengyuan(object dizi, string title)
{
    mapping my_zuzhi, zuzhi;

    if ( dizi->is_shouxia_of( this_object() ) )
        return 0;
    if ( !mapp( my_zuzhi = query( "zuzhi" ) ) )
        return 0;
    if ( !title ) title = "弟子";
    zuzhi = allocate_mapping( sizeof( my_zuzhi ) );
    zuzhi[ "chairman_id" ] = query( "id" );
    zuzhi[ "chairman_name" ] = query( "name" );
    zuzhi[ "zuzhi_name" ] = my_zuzhi[ "zuzhi_name" ];
    zuzhi[ "generation" ] = my_zuzhi[ "generation" ] + 1;
    zuzhi[ "enter_time" ] = time();
    dizi->set( "zuzhi", zuzhi );
    dizi->assign_chengyuan( title, 0 );
    LOG_D->do_log( dizi, sprintf( "你加入%s的%s，成为%s。",
        zuzhi[ "chairman_name" ], zuzhi[ "zuzhi_name" ],
         dizi->query( "title" ) ) );
    return 1;
}

string get_tongshi_guanxi(object obj)
{
    object me;
    mapping my_zuzhi, your_zuzhi;
    int my_gen, your_gen;
    int my_time, your_time;
    string my_gender;

    me = this_object();
    my_zuzhi = me->query( "zuzhi" );
    your_zuzhi = obj->query( "zuzhi" );

    if ( your_zuzhi[ "title" ] ) return your_zuzhi[ "title" ];

    if (( obj != me ) && mapp( my_zuzhi ) && mapp( your_zuzhi ) &&
        ( my_zuzhi[ "zuzhi_name" ] == your_zuzhi[ "zuzhi_name" ] ))
    {
        my_gen = my_zuzhi[ "generation" ];
        your_gen = your_zuzhi[ "generation" ];
        my_time = my_zuzhi[ "enter_time" ];
        your_time = your_zuzhi[ "enter_time" ];
        my_gender = me->query( "gender" );
        if ( my_gen == your_gen )
        {
            if ( my_gender == "男性" || my_gender == "无性" )
            {
                if ( my_time < your_time )
                    return "大哥";
                else
                    return "贤弟";
            }
            else
            {
                if ( my_time < your_time )
                    return "大姐";
                else
                    return "小妹";
            }
        }
        else if ( my_gen > your_gen )
        {
            return "属下";
        }
        else
        {
            if ( your_zuzhi[ "chairman_id" ] == me->query( "id" ) )
                return "在下";
            else
                return "先生";
        }
    }
    return 0;
}



