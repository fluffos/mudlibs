// filename : /feature/apprentice.c

#include <dbase.h>

int is_apprentice_of(object master) {
  mapping family;

  if (!mapp(family = query("family")))
    return 0;

  if (family["master_id"] == (string)master->query("id") &&
    family["master_name"] == (string)master->query("name")) {
    return 1;
  }

  return 0;
}

int is_tongmen_of(object obj) {
  mapping my_family, your_family;

  my_family = query("family");
  your_family = obj->query("family");
  if (!mapp(my_family) || !mapp(your_family))
    return 0;

  if (my_family["family_name"] == your_family["family_name"]) {
    return 1;
  }
  return 0;
}

void assign_apprentice(string title, int privs) {
  mapping family;

  if (!mapp(family = query("family")))
    return;

  family["title"] = title;
  family["privs"] = privs;

  if (userp(this_object()) || !query("title")) {
    if (family["generation"] == 1)
      set("title", family["family_name"] + "开山祖师");
    else
      set("title", sprintf("%s第%s代%s", family["family_name"],
        chinese_number(family["generation"]), family["title"]));
  }
}

// This is used for NPC, or start a new family for a player.
void create_family(string family_name, int generation, string title) {
  mapping family;

  family = allocate_mapping(6);

  family["family_name"] = family_name;
  family["generation"] = generation;

  set("family", family);

  // priv = -1 for ALL privileges.
  assign_apprentice(title, -1);
}

int recruit_apprentice(object dizi) {
  mapping my_family, family, score;
  string f_name, my_fam;

  if (dizi->is_apprentice_of(this_object()))
    return 0;
  if (!mapp(my_family = query("family")))
    return 0;
  if (dizi->query("quest"))
    dizi->delete("quest");
  if (dizi->query("done_quest"))
    dizi->delete("done_quest");
  if (dizi->query("task_time"))
    dizi->delete("task_time");

  my_fam = query("family/family_name");
  f_name = dizi->query("family/family_name");
  score = dizi->query("class_score");
  if (mapp(score))
    // 把mapp 和下面的判断分开。--by lnwm 98/01/20
    if (f_name && f_name != my_fam) {
      if (score[f_name] > 0) {
        score[f_name] /= 10;
        score[f_name] *= -1;
        tell_object(dizi, "你对" + f_name + "的忠诚度下降了。\n");
      } else {
        //              score[f_name] *= 2;
        tell_object(dizi, "你叛出了" + f_name + "。\n");
      }
      if (!undefinedp(score[my_fam]) && score[my_fam] < 0) {
        //               score[my_fam] *= 2;
        tell_object(dizi, "你隐隐看到" + this_object()->name() + "的脸上有"
          "一丝不快。\n");
      } else score[my_fam] = 0;
    } else dizi->set("class_score/" + my_fam, 0);
  // 这样就不出现在同门内换师傅时class_score清0的情况。
  family = allocate_mapping(sizeof(my_family));
  family["master_id"] = query("id");
  family["master_name"] = query("name");
  family["family_name"] = my_family["family_name"];
  family["generation"] = my_family["generation"] + 1;
  family["enter_time"] = time();
  dizi->delete("class");
  dizi->set("family", family);
  dizi->assign_apprentice("弟子", 0);
  FAMILY_D->remove_family_enemy(my_family["family_name"], dizi->query("id"));
  LOG_D->do_log(dizi, sprintf("你决意拜到%s门下，成为%s。",
    family["master_name"], dizi->query("title")));
  return 1;
}

// 返回的字串说明 me 是 obj 的什么关系
string get_tongmen_guanxi(object obj) {
  object me;
  mapping my_family, your_family;
  int my_gen, your_gen;
  int my_time, your_time;
  string my_gender;

  me = this_object();
  my_family = me->query("family");
  your_family = obj->query("family");
  if ((obj != me) && mapp(my_family) && mapp(your_family) &&
    (my_family["family_name"] == your_family["family_name"])) {
    my_gen = my_family["generation"];
    your_gen = your_family["generation"];
    my_time = my_family["enter_time"];
    your_time = your_family["enter_time"];
    my_gender = me->query("gender");
    if (my_gen == your_gen) {
      if (my_gender == "男性" || my_gender == "无性") {
        // 先入为大
        if (my_time < your_time)
          return "师兄";
        else
          return "师弟";
      } else {
        if (my_time < your_time)
          return "师姐";
        else
          return "师妹";
      }
    } else if (my_gen > your_gen) {
      if (my_family["master_id"] == obj->query("id"))
        return "弟子";
      else if (my_gen - your_gen == 1)
        return "师侄";
      else
        return "徒孙";
    } else {
      if (your_family["master_id"] == me->query("id"))
        return "师父";
      else if (your_gen - my_gen == 1) {
        if (my_time < your_time)
          return "师伯";
        else
          return "师叔";
      } else if (your_gen - my_gen == 2) {
        if (my_time < your_time)
          return "师伯祖";
        else
          return "师叔祖";
      } else {
        if (my_time < your_time)
          return "太师伯祖";
        else
          return "太师叔祖";
      }
    }
  }
  return 0;
}
