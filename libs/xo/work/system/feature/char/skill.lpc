// Filename : /system/feature/skill.c

#include <ansi.h>
#include <dbase.h>
#include <options.h>

mapping m_jibie;
mapping m_lingwu;
mapping m_jilei;
mapping m_xiuwei;
mapping m_enable;
mapping m_hide;

////////////////////////////////////////////////////////////////////////////
// Function prototype

int lingwu_limit( string );
varargs private int can_break_limit( string, int);
void check_skill( string );
int valid_skill( string );
int sort_wugong( string );

mapping query_jibie_map() { return m_jibie; }
mapping query_lingwu_map() { return m_lingwu; }
mapping query_jilei_map() { return m_jilei; }
mapping query_xiuwei_map() { return m_xiuwei; }
mapping query_enable_map() { return m_enable; }

/////////////////////////////////////////////////////////////////////////////

void set_jibie(string skill, int val)
{
	check_skill( skill );

	if ( !mapp( m_jibie ) )
		m_jibie = ([ skill: val ]);
	else 
		m_jibie[ skill ] = val;
}

int query_jibie(string skill)
{
	if ( mapp( m_jibie ) && !undefinedp( m_jibie[ skill ] ) ) 
		return m_jibie[ skill ];
	return 0;
}

void set_jilei(string skill, int val)
{
	check_skill( skill );

	if ( !mapp( m_jilei ) ) 
		m_jilei = ([ skill: val ]);
	else 
		m_jilei[ skill ] = val;
}

int query_jilei(string skill)
{
	if ( mapp( m_jilei ) && !undefinedp( m_jilei[ skill ] ) ) 
		return m_jilei[ skill ];
	return 0;
}

void set_lingwu(string skill, int val)
{
	check_skill( skill );

	if ( !mapp( m_lingwu ) ) 
		m_lingwu = ([ skill: val ]);
	else 
		m_lingwu[ skill ] = val;
}

int query_lingwu(string skill)
{
	if ( mapp( m_lingwu ) && !undefinedp( m_lingwu[ skill ] ) ) 
		return m_lingwu[ skill ];
	return 0;
}

void set_xiuwei(string skill, int val)
{
	string type;

    if ( !valid_skill( skill ) )
	    type = skill;
	else
	    type = SKILL_D(skill)->query_xiuwei_type();
	if ( !mapp( m_xiuwei ) )
		m_xiuwei = ([ type : val ]);
	else
		m_xiuwei[ type ] = val;
} 

int query_xiuwei(string skill)
{
	string type;

	check_skill( skill );
	type = SKILL_D(skill)->query_xiuwei_type();
	if ( mapp( m_xiuwei ) && !undefinedp( m_xiuwei[ type ] ) ) 
		return m_xiuwei[ type ];
	return 0;
}

void set_xiuwei_by_type(string type, int val)
{
//	string type;

	if ( !mapp( m_xiuwei ) )
		m_xiuwei = ([ type : val ]);
	else
		m_xiuwei[ type ] = val;
} 

int query_xiuwei_by_type(string type)
{
	if ( mapp( m_xiuwei ) && !undefinedp( m_xiuwei[ type ] ) ) 
		return m_xiuwei[ type ];
	return 0;
}

int query_xiuwei_jibie(string type)
{
	int ob_xiuwei;
	if ( mapp( m_xiuwei ) && !undefinedp( m_xiuwei[ type ] ) )
	{
		ob_xiuwei = query_xiuwei_by_type( type );
		if ( ob_xiuwei > 23100 ) return 10;
		else if ( ob_xiuwei > 14200 ) return 9;
		else if ( ob_xiuwei > 8700  ) return 8;
		else if ( ob_xiuwei > 5300  ) return 7;
		else if ( ob_xiuwei > 3200  ) return 6;
		else if ( ob_xiuwei > 1900  ) return 5;
		else if ( ob_xiuwei > 1100  ) return 4;
		else if ( ob_xiuwei > 600   ) return 3;
		else if ( ob_xiuwei > 300   ) return 2;
		else if ( ob_xiuwei > 100   ) return 1;
		else return 0;
	}
	return 0;
}

int query_xiuwei_dengji(string type)
{
    return query_xiuwei_jibie( type );
}

int enable_skill(string skill)
{
//	string type;

    if ( !valid_skill( skill ) ) return 0;
	if ( !mapp( m_lingwu ) || !m_lingwu[ skill ] )
		return 0;
	if ( !mapp( m_enable ) )
		m_enable = ([ skill : 1 ]);
	else
		m_enable[ skill ] = 1;

	return 1;
}

int check_hide_skill(string skill)
{
    if ( !stringp(skill) ) 
    {
        error("Invalid skill name!\n");
    }
    if( !mapp(m_hide) ) return 0;
    return (!undefinedp(m_hide[skill]));
}

int hide_skill(string skill)
{
    if ( !stringp(skill) ) return 0;
    if ( !valid_skill(skill) ) return 0;
    if ( !mapp(m_hide) )
    {
        m_hide = ([ skill : 1 ]);
    }
    else 
    {
        m_hide[skill] = 1;
    }
    return 1;
}

int display_skill(string skill)
{
    if ( !stringp(skill) ) return 0;
    if ( !valid_skill(skill) ) return 0;
    if ( !mapp(m_hide) || 
         undefinedp(m_hide[skill] ) )
    {
        return 0;
    }
    else
    {
        map_delete( m_hide, skill); 
        return 1;
    }
}
        
void disable_skill(string skill)
{
	//check_skill( skill );
	if ( mapp( m_enable ) )
	{
		map_delete( m_enable, skill );
	}
}

int delete_wugong(string skill)
{
	int retVal;

	if ( mapp(m_jibie) ) map_delete( m_jibie, skill );
	if ( mapp(m_lingwu) ) map_delete( m_lingwu, skill );
	if ( mapp(m_jilei) ) map_delete( m_jilei, skill );
	if ( mapp(m_enable) ) map_delete( m_enable, skill );
	retVal = undefinedp( m_jibie[ skill ] );
	retVal = retVal && undefinedp( m_lingwu[ skill ] );
	retVal = retVal && undefinedp( m_jilei[ skill ] );
	retVal = retVal && undefinedp( m_enable[ skill ] );
	return retVal;
}

void delete_all_wugong()
{
    m_jibie = ([]);
    m_lingwu = ([]);
    m_jilei = ([]);
    m_enable = ([]);
}

// 由武器类型在enable数组中找出此类的武功, 然后随机挑选一种
string query_wugong(string type)
{
	int i;
	string *skills, *select;
	string skill_type;

	if ( !mapp( m_enable ) ) return 0;
	skills = keys( m_enable );
	select = ({});
	for ( i = 0; i < sizeof( skills ); i++ )
	{
		skill_type = SKILL_D(skills[ i ])->query_weapon_type();
		if ( !skill_type )
		    skill_type = SKILL_D(skills[i])->query_xiuwei_type();
		if ( skill_type == type )
			select += ({ skills[ i ] });
	}
	if ( sizeof( select ) )
	{
		return select[ random( sizeof( select ) ) ];
	}
	return 0;
}

// 由武器类型在jibie数组中找出此类的武功, 返回筛选出的数组 
string * query_wugong_list(string weapon_type)
{
	int i;
	string *skills, *select;
	string skill_type;

	if ( !mapp( m_jibie ) ) return 0;
	skills = keys( m_jibie );
	select = ({});
	for ( i = 0; i < sizeof( skills ); i++ )
	{
		skill_type = SKILL_D(skills[ i ])->query_weapon_type();  
		if ( !skill_type )
		    skill_type = SKILL_D(skills[i])->query_xiuwei_type();
		if ( weapon_type == skill_type )
			select += ({ skills[ i ] });
	}
	if ( sizeof( select ) )
	{
		return select;
	}
	return 0;
}

// 返回选择的进攻的action
// attack_skill 属性表示角色这一招所属的技能
mapping select_attack_action()
{
    object weapon, this;
    string skill, type;
    mapping action;

    this = this_object();

    // 动作取决于有否武器, 现在如果不会相应的武功, 我们
    // 就用基本动作
    weapon = query_temp( "weapon" );
    if ( objectp( weapon ) )
        type = weapon->query( "weapon_type" );
    else
        type = "unarmed";
    skill = query_wugong( type );
    //printf( "skill %s\n", skill );
    if ( stringp( skill ) )
    {
        int jibie = m_jibie[ skill ];
        set_temp( "attack_skill", skill );
        action = SKILL_D( skill )->query_action( jibie );
    }
    else if ( objectp( weapon ) )
    {
        set_temp( "attack_skill", "wuqi" );
        action = SKILL_D( "wuqi" )->query_action( weapon );
    }
    else
    {
        switch ( query( "race" ) )
        {
        case "野兽":
            set_temp( "attack_skill", "yeshou" );
            action = SKILL_D( "yeshou" )->query_action();
            break;

        case "人类":
        default:
            set_temp( "attack_skill", "kongshou" );
            action = SKILL_D( "kongshou" )->query_action();
            break;
        }
    }
    if ( !mapp( action ) )
    {
        CHANNEL_D->do_channel( this, "sys",
            sprintf( "select_attack_action 失败, %s(%s) skill %s, action %O",
                this->name(1), this->query("id"), skill, action ) );
    }
    return action;
}

// 在enable的技能中选择一种特殊 parry, 如果没有, 从 kongshou
// 或 wuqi 中获得 parry 的信息. 这里, his_weapon 是敌人使用
// 的武器, 用来选择相应的招架信息.   
// lin on March 21,1997
// parry 可以选用同类修为的所有功夫。( is it right? )
string select_parry_action(object enemy_weapon)
{
    object weapon, this;
    string skill, type, action;

    weapon = query_temp( "weapon" );
    if ( objectp( weapon ) )
        type = weapon->query( "weapon_type" ); 
    else
        type = "unarmed";
    skill = query_wugong( type );
    if ( !stringp( skill ) )
    {
        if ( objectp( weapon ) )
            skill = "wuqi";
        else
            skill = "kongshou";
    }

    // 以后可以是级别决定使出的parry招数
    //int jibie = m_jibie[ skill ];
    set_temp( "parry_skill", skill );
    action = SKILL_D( skill )->query_parry_msg( enemy_weapon );
    if ( !stringp( action ) )
    {
        this = this_object();
        CHANNEL_D->do_channel( this, "sys",
            sprintf( "select_parry_action 失败, %s(%s) skill %s",
                this->name(1), this->query("id"), skill ) );
    }
    return action;
}

// 在enable的技能中选择一种特殊dodge, 如果没有, 用基本dodge 
// dodge 当然和武器无关啦。 lin.
mapping select_dodge_action()
{
	string skill;

	skill = query_wugong( "dodge" );
	if ( stringp( skill ) )
    {
        int jibie = m_jibie[ skill ];
        set_temp( "dodge_skill", skill );
        return SKILL_D( skill )->query_action( jibie );
    }
	set_temp( "dodge_skill", "dodge" );
	return SKILL_D( "dodge" )->query_action();
}

void improve_jibie(string skill, int amount)
{
    check_skill( skill );
	
	if ( !mapp( m_jibie ) ) 
		m_jibie = ([ skill : amount ]);
	else 
		m_jibie[ skill ] += amount;
}

void improve_lingwu(string skill, int amount)
{
    check_skill( skill );
	
	if ( !mapp( m_lingwu ) ) 
		m_lingwu = ([ skill : amount ]);
	else 
		m_lingwu[ skill ] += amount;
}

void improve_jilei(string skill, int amount)
{
	int limit, bonus,ob_jibie;
	string type;

	check_skill( skill );

	// NPC 暂时不考虑能增加积累
	if ( !userp( this_object() ) ) 
	{
		return;
		//if ( !mapp(skills) ) skills = ([]);
		//if ( undefinedp( skills[ skill ] ) ) skills[ skill ] = 0;
	}

	if ( !amount || !m_jibie[ skill ] ) return;

	if ( !mapp( m_jilei ) ) 
		m_jilei = ([ skill : amount ]);
	else 
		m_jilei[ skill ] += amount;

	if ( !mapp( m_lingwu ) ) m_lingwu = ([]); 
	limit = lingwu_limit( skill );
	if ( m_jibie[ skill ] > m_lingwu[ skill ] ) 
	{
 		if ( m_jilei[ skill ] > limit  && can_break_limit( skill ) )
		{
			m_lingwu[ skill ]++;
			m_jilei[ skill ] = 0;
			tell_object( this_object(),
				HIC "你的「" + to_chinese(skill) + "」进步了！\n" NOR );
			if ( functionp( SKILL_D(skill)->skill_improved() ) )
				SKILL_D(skill)->skill_improved(this_object());

    		type = SKILL_D( skill )->query_xiuwei_type();
        	sort_wugong( type );

    	    // PLAYER在武功的勤学苦练中，当武功取得一定进步后
	        // 武学修为应该相应有所进步的。
    	    // 当武功每进步十级后，相应的武学修为有所进步。
        	// 每次奖励5乘以这门武功的等级。
	        // 在PLAYER练了从第一等到第九等的九门60级武功时
    	    // 总共能获得1350点修为，占到总修为的10%
	        // 比例不是很高，修为还是主要从师傅请教所得。     
	        // lin: 还是改成越往后得的越多好一点，我倾向于到了后边是没有师傅的。

			if ( m_lingwu[ skill ] % 10 == 0 )
			{
				bonus = SKILL_D( skill )->query_dengji();
				//----------------------------------------
				// 这里须加入对当前修为等级的判断，主要是高等级修为练
				// 低等级武功应该涨的少
				ob_jibie=(int)this_object()->query_xiuwei_jibie(type);
				if( bonus > ob_jibie )
				    bonus *= 5;
				else
				// 这就是高等级修为练低等级武功了，例如1级修为练unarmed（1级武功）
				{
                	ob_jibie=ob_jibie-bonus;
					bonus = bonus * (4-ob_jibie);
					if(bonus < 0)
					    bonus=0;
				}
				//----------------------------------------
				
				bonus += (int)this_object()->query_xiuwei_by_type( type );
				set_xiuwei_by_type( type, bonus );
			}
		}
	}

	//当LINGWU超过JIBIE时

	else
	{
		if ( m_jilei[ skill ] > 2 * limit  && can_break_limit( skill, 2 ) )
		{
			m_lingwu[ skill ]++;
			m_jilei[ skill ] = 0;
			tell_object( this_object(),
				HIC "你的「" + to_chinese(skill) + "」进步了！\n" NOR );
			if ( functionp( SKILL_D(skill)->skill_improved() ) )
				SKILL_D(skill)->skill_improved(this_object());

    		type = SKILL_D( skill )->query_xiuwei_type();
        	sort_wugong( type );

         	// 如果LINGWU > JIBIE应该多奖励一点，是原来的两倍
         	// 但是练习的速度，也只有原来的1/2了
			if ( m_lingwu[ skill ] % 5 == 0 )
			{
				bonus = SKILL_D( skill )->query_dengji();
				//----------------------------------------
				// 这里须加入对当前修为等级的判断，主要是高等级修为练
				// 低等级武功应该涨的少
				ob_jibie=(int)this_object()->query_xiuwei_jibie(type);
				if( bonus > ob_jibie )
				    bonus *= 5;
				else
				// 这就是高等级修为练低等级武功了，例如1级修为练unarmed（1级武功）
				{
                	ob_jibie=ob_jibie-bonus;
					bonus = bonus * (4-ob_jibie);
					if(bonus < 0)
					    bonus=0;
				}
				//----------------------------------------
				bonus += (int)this_object()->query_xiuwei_by_type( type );
				set_xiuwei_by_type( type, bonus );
			}
		}
	}
}

void improve_xiuwei(string type, int amount)
{
	if ( !mapp( m_xiuwei ) ) 
		m_xiuwei = ([ type : amount ]);
	else 
		m_xiuwei[ type ] += amount;
}

// qyz : make it easy to set skills of npc. 
// modify by nerd : make it varargs and delete set xiuwei
varargs int set_wugong(string skill, int jibie, int lingwu, int enable)
{   
	if ( !jibie ) jibie = 10;
	if ( !lingwu ) lingwu = jibie;
	if ( !enable ) enable = 0;
	set_jibie( skill, jibie );
	set_lingwu( skill, lingwu );
    set_jilei( skill, 0 );
	if ( enable ) enable_skill(skill);
    sort_wugong( SKILL_D(skill)->query_xiuwei_type() );
	return 1;
}

int skill_death_penalty()
{
	string *sk;
	int i;
	int enable ;

	if ( wizardp( this_object() ) ||
         !mapp( m_lingwu ) ||
         this_object()->query( "age" ) < SKILL_PENALTY_LIMIT )
    {
        return 0;
    }

    // 现在有三种选择
    enable = random( 3 );

	sk = keys( m_lingwu );
	if ( !mapp( m_jilei ) )
		for ( i = 0; i < sizeof( sk ); i++ ) 
		{
		    if ( SKILL_D( sk[i] )->is_knowledge() ) continue;
		    if ( enable == 2 || !mapp( m_enable ) ) m_lingwu[ sk[1] ] -= random(2);
		    else if ( mapp( m_enable ) && m_enable[ sk[i] ] - enable )
				m_lingwu [ sk[ i ] ] --;
			if ( m_lingwu[ sk[ i ] ] < 0 ) 
				m_lingwu[ sk[i] ] = 0;
		}
	else
		for ( i = 0; i < sizeof( sk ); i++ ) 
		{
			if ( ( (int)m_jilei[ sk[ i ] ] > 
				 ( m_lingwu[ sk[ i ] ] + 1 ) * ( m_lingwu[ sk[ i ] ] + 1 ) / 2 )
			&& ( mapp( m_enable ) &&  m_enable[ sk[i] ] - enable ) )
			{
			    if ( SKILL_D( sk[i] )->is_knowledge() ) continue;				
				m_jilei[ sk[ i ] ] = 0;
			}
			else 
			{
			    if ( SKILL_D( sk[i] )->is_knowledge() ) continue;
			    if ( enable == 2 || !mapp( m_enable ) ) m_lingwu[ sk[i] ] -= random(2);
			    else if ( mapp( m_enable ) && m_enable[ sk[i] ] - enable ) 
					m_lingwu [ sk[ i ] ] --;
				if ( m_lingwu[ sk[ i ] ] < 0 ) 
					m_lingwu[ sk[ i ] ] = 0;
			}
		}
//	skill_map = 0;
	return 1;
}

// 为计算 wugong_power 所必须的排序
int sort_wugong( string type )
{
    int i, j;
    int dengji_i, lingwu_i, dengji_j, lingwu_j;
    string *skills, temp;

    skills = query_wugong_list( type );
    if ( !sizeof( skills ) ) delete_temp("sort_wugong/" + type);
    for ( i = 0; i < sizeof( skills ); i++ )
    {
        dengji_i = SKILL_D( skills[ i ] )->query_dengji();
        if ( !mapp( m_lingwu ) )
            m_lingwu = ([]);
        lingwu_i = m_lingwu[ skills[ i ] ];
        for ( j = i + 1; j < sizeof( skills ); j++ )
        {
            dengji_j = SKILL_D( skills[ j ] )->query_dengji();
            lingwu_j = m_lingwu[ skills[ j ] ];
            if (( dengji_i < dengji_j ) ||
                (( dengji_i == dengji_j ) && ( lingwu_i < lingwu_j )))
            {
                temp = skills[ i ];
                skills[ i ] = skills[ j ];
                skills[ j ] = temp;

                dengji_i=dengji_j;
                lingwu_i=lingwu_j;
            }
        }
    }
    set_temp( "sort_wugong/" + type, skills );
    return 1;
}

/////////////////////////////////////////////////////////////////////
// helper function

// 技能有效检查
void check_skill( string skill )
{
	if ( !stringp( SKILL_D(skill) ) ||
        ( !find_object( SKILL_D(skill) ) &&
		 file_size( SKILL_D(skill) + ".lpc" ) < 0 ))
	{
		error("F_SKILL: No such skill (" + skill + ")\n");
	}
}

int valid_skill( string skill )
{
	if ( !stringp(SKILL_D(skill)) ||
        ( !find_object( SKILL_D(skill) ) &&
		 file_size( SKILL_D(skill) + ".lpc" ) < 0 ) )
	{
        return 0;
	}
    return 1;
}

// 领悟的阈值公式
int lingwu_limit( string skill)
{
	int lingwu, dengji;

	lingwu = m_lingwu[ skill ];
	dengji = SKILL_D( skill )->query_dengji();
	
	return lingwu * lingwu * ( dengji * dengji + 1 ) * 7 / 202 + 10;
}

// 级别突破公式
varargs private int can_break_limit( string skill, int usage )
{
	int lingwu, limit, jilei;

	lingwu = m_lingwu[ skill ] + 1;
	limit = lingwu_limit( skill );
	jilei = query_jilei( skill );
	if ( usage <= 0 ) usage = 1;

	//原来的公式:
	//if ( 100 / lingwu > random( 100 ) + 1 )
	//	return 1;
	if ( random( lingwu ) == 0 || jilei > usage * limit * 3 /2 )
		return 1;
	return 0;
}
