// filename : /feature/liquid.c

#include <dbase.h>
#include <name.h>

int drink_effect(object ppl, object this);
void init() {
  add_action("do_drink", "drink");
  add_action("do_fill", "fill");
}

int is_food() {
  return 1;
}

string extra_long() {
  int amount, max;
  string str;

  amount = query("liquid/remaining");
  if (amount) {
    max = query("max_liquid");
    if (amount == max)
      str = "里面装满了" + query("liquid/name") + "。\n";
    else if (amount >= max * 7 / 10)
      str = "里面装了七、八分满的" + query("liquid/name") + "。\n";
    else if (amount >= max * 5 / 10)
      str = "里面装了五、六分满的" + query("liquid/name") + "。\n";
    else if (amount > max * 2 / 10)
      str = "里面装了少许的" + query("liquid/name") + "。\n";
    else
      str = "里面装了很少的一点" + query("liquid/name") + "。\n";
    return str;
  } else
    return 0;
}

int do_drink(string arg) {
  object this, ppl;
  string end, over, drink;
  int mum, over_value;
  this = this_object();
  ppl = this_player();
  if (!this->id(arg)) return 0;
  if (!ppl->can_act()) {
    write("你上一个动作还没有完成。\n");
    return 1;
  }
  if (!query("liquid/remaining")) {
    if (end = query("end_msg"))
      write(end + "\n");
    else
      write(name() + (query("liquid/name") ?
        "已经被喝得一滴也不剩了\n" : "是空的。\n"));
    return 1;
  }
  if ((int)ppl->query("water") >= ppl->max_water_capacity()) {
    if (over = query("over_msg"))
      write(over + "\n");
    else
      write("你已经喝太多了，再也灌不下一滴水了。\n");
    return 1;
  }
  over_value = this->query("over_value");
  if (!over_value)
    over_value = 0;
  set("value", over_value);
  add("liquid/remaining", -1);
  if (drink = query("drink_msg"))
    message_vision(drink, ppl, this_object());
  else
    message_vision("$N拿起" + name() +
      "咕噜噜地喝了几口" + query("liquid/name") + "。\n", ppl);
  mum = this->query("liquid/drink_apply");
  if (!mum) mum = this->query("drink_supply");
  if (!mum) mum = 30;
  ppl->add("water", mum);
  if (ppl->is_fighting())
    ppl->start_busy(2);
  if (!query("liquid/remaining"))
    write("你已经将" + name() + "里的" +
      query("liquid/name") + "喝得一滴也不剩了。\n");

  // This allows customization of drinking effect.
  if (this_object()->drink_effect(ppl, this_object()) == 1)
    return 1;

  switch (query("liquid/type")) {
    case "alcohol":
      ppl->apply_condition("drunk",
        (int)ppl->query_condition("drunk") +
        (int)query("liquid/drunk_apply"));
      break;
      //to which be added poison from sb.
    case "poison":
      ppl->unconcious();
      break;
  }

  return 1;
}

int do_fill(string arg) {
  object this, ppl, env;
  string type, name, place;
  this = this_object();
  ppl = this_player();
  env = environment(ppl);
  type = env->query("watertype");
  if (!type) type = "water";
  place = env->query("fillplace");
  if (!place) place = "井";
  name = env->query("watername");
  if (!name) name = "清水";

  if (!this->id(arg)) return 0;

  if (!ppl->can_act())
    return notify_fail("你上一个动作还没有完成。\n");

  if (!env->query("resource/water"))
    return notify_fail("这里没有地方可以装水。\n");

  if (query("liquid/remaining"))
    message_vision("$N将" + name() + "里剩下的" +
      query("liquid/name") + "倒掉。\n", ppl);

  message_vision("$N从" + place + "里打了满满一" + name() + name + "\n", ppl);

  set("liquid/type", type);
  set("liquid/name", name);
  set("liquid/remaining", query("max_liquid"));

  return 1;
}
