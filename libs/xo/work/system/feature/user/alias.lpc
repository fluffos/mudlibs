// filename : /feature/alias.c

#define MAX_REPEAT 		30
#define MAX_ALIASES 	40
#define HIS_BUF_SIZE 	10	// history buffer size

mapping alias;

private nosave string *history, last_input;
private nosave int last_cmd, repeat_cnt = 0;

string process_input(string str) {
  string *args, cmd, argstr;
  int i, j;

  if (!environment(this_object())) {
    tell_object(this_object(), "对不起，由于你没有环境，转移到void...\n");
    move_object(VOID_OB);
  }
  if (str == last_input) {
    repeat_cnt++;
    if (repeat_cnt > MAX_REPEAT) {
      tell_object(this_object(),
        "\n孙悟空骑着一朵筋斗云飞了过来。\n"
        "\n大声喝道：你这婆婆妈妈的家伙是唐僧!!! 滚吧!!\n\n");
      if (wizardp(this_object())) {
        tell_object(this_object(),
          "突然间孙悟空的嗓子哑了，回头一看……\n\n"
          "原来是一只狐狸在后面掐着孙悟空的脖子。\n"
          "孙悟空谄媚道：“嘿嘿，小的该死，您老请便，请便。\n");
        repeat_cnt = 0;
      } else
        command("quit");
    }
  } else {
    repeat_cnt = 0;
    last_input = str;
  }

  if (str[0] == '!') {
    if (pointerp(history) && sizeof(history)) {
      if (sscanf(str, "!%d", i))
        str = history[(HIS_BUF_SIZE + last_cmd - i) % HIS_BUF_SIZE];
      else
        str = history[last_cmd];
    } else
      return "";
  } else {
    if (!pointerp(history))
      history = allocate(HIS_BUF_SIZE);
    last_cmd = (last_cmd + 1) % HIS_BUF_SIZE;
    history[last_cmd] = str;
  }

  if (mapp(alias)) {
    if (!undefinedp(alias[str]))
      return replace_string(alias[str], "$*", "");

    i = sscanf(str, "%s %s", cmd, argstr);
    if (i == 2 && !undefinedp(alias[cmd])) {
      cmd = replace_string(alias[cmd], "$*", argstr);
      args = explode(argstr, " ");
      if (j = sizeof(args))
        for (i = 0; i < j; i++)
          cmd = replace_string(cmd, "$" + (i + 1), args[i]);
      return cmd;
    }
  }

  return (string)ALIAS_D->process_global_alias(str);
}

int set_alias(string verb, string replace) {
  if (!replace) {
    if (mapp(alias))
      map_delete(alias, verb);
    return 1;
  } else {
    if (!mapp(alias))
      alias = ([ verb: replace ]);
    else if (sizeof(alias) > MAX_ALIASES)
      return notify_fail("您设定的 alias 过多，请先删掉一些不常用的。\n");
    else
      alias[verb] = replace;
    return 1;
  }
}

mapping query_all_alias() {
  return alias;
}
