// kill_soldier.c
// 这是对于军队这一特殊的“门派”所设的追杀令，非城市所用也，如果用了这个
//condition，就是天下一起捕了。。。。。。可怕
inherit F_CLEAN_UP;

int update_condition(object me, int duration) {
  object env;
  env = environment(me);
  me->apply_condition("kill_government", duration - 1);
  if (!duration) {
    return 0;
  }
  if ((duration / 10) * 10 == duration) {
    tell_object(me, "朝廷正发下海捕文书，四处捉拿你......\n");
    return 1;
  }
  return 1;
}
