// dazuo.c
// created by qyz 1997 4-19

inherit F_CLEAN_UP;

#include <skill.h>
#include <ansi.h>


int main(object me, string arg) {
  object where;
  int force_cost;

  seteuid(getuid());

  if (!where = environment(me))
    return notify_fail("怎么，想在空中打坐么？真的成圣贤了？\n");
  if (where->query("wiz"))
    return notify_fail(HIR "这是属于神的房间，不能用来练功。\n" NOR);

  if (!arg || sscanf(arg, "%d", force_cost) != 1 || force_cost < 0)
    return notify_fail("指令格式：dazuo < 消耗内力数量 >\n");

  if (!me->query("using_force"))
    return notify_fail("你必须先修炼一门内功。\n");

  if (me->is_busy() || me->query_temp("mask/dazuo"))
    return notify_fail("你现在正忙着呢。\n");

  if (me->is_fighting())
    return notify_fail("战斗中不能打坐，你不会想走火入魔吧。\n");

  if (me->is_duilianing())
    return notify_fail("对练中不能打坐，会走火入魔的。\n");

  if (force_cost > (int)me->query("force"))
    return notify_fail("你现在没有那么多的内力。\n");
  if (force_cost < 20)
    return notify_fail("你用来运功的内力太少，无法运行周天。\n");

  message_vision(HIC "$N盘腿坐下，运气恢复。\n" NOR, me);
  write(HIW "你渐渐地将内力凝集起来，让它在体内缓缓流动。\n"
    "一股真气在你全身运转起来......\n" NOR);
  me->disable_player("< 打坐中 >");
  me->set_temp("mask/dazuo", 1);
  me->set_temp("force_cost", force_cost);
  me->set_temp("block_msg/all", 1);
  me->set("no_get", 1);
  me->set("no_get_from", 1);

  call_out("halt_dazuo", 5, me);
  return 1;
}

int halt_dazuo(object me) {
  int force_cost, force_level, gain_points;
  int gin_bonus, kee_bonus, sen_bonus;
  string force;

  force = me->query("using_force");
  force_level = (SKILL_D(force)->query_level()) * (me->query_lingwu(force));
  force_cost = me->query_temp("force_cost");
  gain_points = force_cost * force_level / 50;

  gin_bonus = random((int)me->query("int") * force_cost / 30);
  kee_bonus = random((int)me->query("cor") * force_cost / 30);
  sen_bonus = random((int)me->query("con") * force_cost / 30);

  me->enable_player();
  me->add("force", -force_cost);
  me->delete_temp("block_msg/all");
  me->delete_temp("mask/dazuo");
  me->delete("no_get");
  me->delete("no_get_from");

  me->receive_heal("gin", gain_points + gin_bonus);
  me->receive_heal("kee", gain_points + kee_bonus);
  me->receive_heal("sen", gain_points + sen_bonus);

  message_vision(HIC "$N神满气闲地站起来，全身充满了活力。\n" NOR, me);
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : dazuo < 消耗内力数量 > 

坐下来调息以恢复精力，体能以及生命。

HELP
  );
  return 1;
}
