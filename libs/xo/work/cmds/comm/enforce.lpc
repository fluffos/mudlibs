// enforce.c
// qyz

inherit F_CLEAN_UP;

int main(object me, string arg) {
  int pts, factor;
  //    mapping enable_map;
  string using_force;

  if (!arg || (arg != "none" && !sscanf(arg, "%d", pts)))
    return notify_fail("指令格式：enforce <使出几成内力伤敌> | none");

  if (!using_force = me->query("using_force"))
    return notify_fail("你必须先 xiulian 一种特殊内功。\n");

  if (arg == "none")
    me->delete("force_factor");
  else {
    if (pts < 0 || pts > 10)
      return notify_fail("你只能用 none 表示不运内力，或数字表示每一击用几成内力。\n");
    factor = me->query("max_force") * pts / 100;
    me->set("force_factor", factor);
  }

  write("Ok.\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式: enforce <使出几点内力伤敌>|none
 
这个指令让你指定每次击中敌人时，要发出几点内力伤敌。

enforce none 则表示你不使用内力。 

SEE ALSO : enable, enchant
HELP
  );
  return 1;
}
