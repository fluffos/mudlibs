// hide.c
// by Qyz

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  string skill;

  seteuid(getuid());

  if (!arg) {
    return notify_fail("指令格式：hide <武功名称>\n");
  }

  if (sscanf(arg, "%s", skill) != 1)
    return notify_fail("指令格式：hide <技能名称>\n");

  if (!me->valid_skill(skill))
    return notify_fail("你不会这种技能。\n");

  if (!me->hide_skill(skill))
    return notify_fail("无法隐藏这门武功。\n");

  write("Ok.\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : hide <技能名称>

这个指令让你在输出技能信息的时候隐藏起那些不重要的。
无论何时，你都可以用skills -a来显示所有武功，或者用
display <技能名称> 来解除。
 
HELP
  );
  return 1;
}
