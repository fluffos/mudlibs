// display.c
// by Qyz

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  //    mapping map;
  string skill;
  //    int i, modify;

  seteuid(getuid());

  if (!arg || sscanf(arg, "%s", skill) != 1)
    return notify_fail("指令格式：disable <技能名称>\n");

  if (!me->query_jibie(skill))
    return notify_fail("你没有这门武功。\n");

  me->display_skill(skill);
  write("Ok.\n");

  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : display <技能名称>

这个指令让你重新显示某门武功。
 
HELP
  );
  return 1;
}
