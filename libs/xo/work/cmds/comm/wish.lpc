// wish.c
// 用于1999年元旦

// by xli 1998.12.28

#include <ansi.h>

inherit F_CLEAN_UP;

string *gift_type = ({ "膂力", "胆识", "悟性", "容貌", "灵性", "定力", "机敏", "根骨", "福缘" });
string *gift = ({ "str", "cor", "int", "per", "spi", "cps", "dex", "con", "kar" });

string *xiuwei_type = ({ "刀法", "剑术", "拳脚", "轻功", "短兵刃", "长兵刃", "鞭法", "总纲" });

string *xiuwei = ({ "blade", "sword", "unarmed", "dodge", "short", "long", "whip", "zonggang" });

int main(object me, string str) {
  //    int i;
  string my_family;
  //    object obj;

  my_family = me->query("family/family_name");

  if (!str || str == "") {
    tell_object(me, "你要祝福什么？(可以help wish)\n");
    return 1;
  }
  if (me->query("wish_time") > 3) {
    tell_object(me, "所谓事不过三，新年的礼物还是少点好。:)\n");
    tell_object(me, "这样能给你留下美好的回忆哟！\n");
    return 1;
  } else if (member_array(str, gift) + 1) {
    me->add(str, 1);
    me->add("wish_time", 1);
    tell_object(me, CYN "你张开双臂，向着冥冥中的上苍祝福自己的健康...\n" +
      "你忽然有种祥和的感觉，身体里好象发生了一些变化。\n" NOR);
    tell_object(me, MAG "你的" + gift_type[member_array(str, gift)] +
      "增加了。\n" NOR);
    return 1;
  } else if (member_array(str, gift_type) + 1) {
    me->add(gift[member_array(str, gift_type)], 1);
    me->add("wish_time", 1);
    tell_object(me, CYN "你张开双臂，向着冥冥中的上苍祝福自己的健康...\n" +
      "你忽然有种祥和的感觉，身体里好象发生了一些变化。\n" NOR);
    tell_object(me, MAG "你的" + gift_type[member_array(str, gift_type)] +
      "增加了。\n" NOR);
    return 1;
  } else if (str == "寿命" || str == "max_age") {
    me->add("max_age", 1);
    me->add("wish_time", 1);
    tell_object(me, CYN "你张开双臂，向着冥冥中的上苍祝福身体的康健...\n" +
      "你忽然有种祥和的感觉，身体里好象发生了一些变化。\n" NOR);
    tell_object(me, MAG "你的寿命延长了。\n" NOR);
    return 1;
  } else if (str == "师门忠诚度" || str == "class_score") {
    if (!me->query("family")) {
      tell_object(me, "你还没拜过师呢。\n");
      return 1;
    }
    me->add("class_score/" + my_family, 100 + random(200));
    me->add("wish_time", 1);
    tell_object(me, CYN "你张开双臂，向着冥冥中的上苍祝福师父的健康...\n" +
      "你忽然有种奇怪的感觉，好象你的师父就在你面前对你微笑着。\n" NOR);
    tell_object(me, MAG "你的师门忠诚度增加了。\n" NOR);
    return 1;
  } else if (member_array(str, xiuwei_type) + 1) {
    if (str == "总纲")
      me->improve_xiuwei(xiuwei[member_array(str, xiuwei_type)], 30 + random(20));
    else
      me->improve_xiuwei(xiuwei[member_array(str, xiuwei_type)], 50 + random(30));
    me->add("wish_time", 1);
    tell_object(me, CYN "你张开双臂，向着冥冥中的上苍祝福来年的好运...\n" +
      "你心中忽然一动，仿佛忽然明白了些什么。\n" NOR);
    tell_object(me, MAG "你的" + str + "修为增加了。\n" NOR);
    return 1;
  } else if (str == "实战经验" || str == "combat_exp") {
    tell_object(me, CYN "你张开双臂，向着冥冥中的上苍祝福来年的好运...\n" +
      "你心中忽然一动，仿佛忽然明白了些什么。\n" NOR);
    tell_object(me, MAG "你的实战经验增加了。\n" NOR);
    me->add("wish_time", 1);
    me->add("combat_exp", 3000 + random(1000));
    return 1;
  } else if (str == "女人" || str == "媳妇" || str == "girl" ||
    str == "woman" || str == "老婆" || str == "太太") {
    tell_object(me, MAG "呵呵。这个嘛。。咳。。嗯。。。\n");
    tell_object(me, "我们神仙自己还找不到呢。:PP :) \n");
    tell_object(me, "嘻嘻。。共同努力啦。\n" NOR);
    return 1;
  } else if (str == "钱" || str == "红包" || str == "利市" ||
    str == "money" || str == "gold" || str == "黄金") {
    tell_object(me, YEL "首先祝你多多发财。:)\n" NOR);
    tell_object(me, YEL "红包当然要发的啦，不过要向在线上的神仙要啦。\n" NOR);
    return 1;
  }
  tell_object(me, GRN "这个。老兄，别的还行… 这个“" + str + "”我可没那么大的本事给你。\n" NOR);
  tell_object(me, GRN "还是找破树要吧！\n" NOR);
  return 1;
}

int help(object obj) {
  write(@HELP
指令格式 :  wish <内容>

你可以祝福你想要的东西。比如增加你的天赋(膂力，悟性。。。)啦，
增加你的寿命(max_age)啦，让你的师傅更喜欢你(class_score)啦。。等等。。
或者你想不劳而获得到一些武功的进境，还可以祝福增加你的武功修为
（剑术，刀法。。)，或者实战经验。。等等。。。

不过只有1999年元旦才有效哟。而且你祝福的次数有限，要想好再祝福哟。:)
HELP
  );
  return 1;
}
