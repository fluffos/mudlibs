#include <ansi.h>
inherit F_CLEAN_UP;

void get_title(object who,string title);
void do_report(object who,string title,string text);

int main(object who,string arg)
{
    if(!arg)
    {
        printf("请先指定一个标题：");
        input_to( (:get_title,who:) );
        return 1;
    }
    printf("请输入正文：");
    who->edit( (: do_report,who,arg:) );
    return 1;
}

void get_title(object who,string title)
{
    printf("请输入正文：");
    who->edit ( (: do_report,who,title :) );
    return;
}

void do_report( object who,string title,string text )
{
    string env="unknown";
    if(environment(who))
        env=file_name(environment(who));
    log_file("static/report",sprintf(YEL BBLU"%s(%s) reported at %s %s\n"NOR,who->name(),
            who->query("id"),env,ctime(time())));
    log_file("static/report",YEL BBLU "title : " + title + "\n" NOR );
    log_file("static/report",text + "\n" );
    log_file("static/report","---------------------------------------------\n");
    printf("\nＸＯ全体人员多谢您的合作。\n");
}

int help(object who)
{
    write(@HELP

指令格式： report [title]
这个指令是目前笑傲江湖用来供玩家报告ＢＵＧ时用的。
如果你发现哪里有什么错误，或者一些莫名其妙的东东，就可以使用这个指令。
当然，请您的文字尽量简明扼要，给我们的工作带来方便。

HELP );
    return 1;
}
