});

string skill_level(string, int);

int main(object me, string arg)
{
    object ob;
    mapping m_lingwu, m_jibie, m_jilei, m_xiuwei, m_enable;
    string *sname;
    int i, jibie, lingwu, jilei,xiuwei, opt_all;
    string tag;

    seteuid( getuid() );

    if ( !arg || arg == "" )
    {
    	ob = me;
        opt_all = 0;
    }

    else if ( arg == "-a" )
    {
        ob = me;
        opt_all = 1;
    }

    else
    {
        if (  sscanf(arg, "%s -a", tag) < 1 )
        {
    	    ob = present(arg, environment(me));
    	    if (!ob) ob = find_player(arg);
    	    if (!ob) ob = find_living(arg);
    	    if (!ob) return notify_fail("你要察看谁的技能？\n");
            opt_all = 0;
        }
        else
        {
            ob = present(tag, environment(me));
            if (!ob) ob = find_player(tag);
            if (!ob) ob = find_living(tag);
            if (!ob) return notify_fail("你要察看谁的技能？\n");
            opt_all = 1;
        }
    }
    
    if ( ob != me && !wizardp(me) )
    	return notify_fail("只有神仙才能察看他人的技能。\n");

    m_jibie = ob->query_jibie_map();
    if ( !sizeof(m_jibie) )
    {
    	write( (ob == me ? "你" : ob->name()) + "目前并没有学会任何技能。\n");
    	return 1;
    }
    write( (ob == me ? "你" : ob->name()) +"目前所学过的技能：\n\n");
    
    sname  = sort_array( keys(m_jibie), (: strcmp :) );

    
    m_lingwu = ob->query_lingwu_map();
    m_jilei = ob->query_jilei_map();
    m_xiuwei = ob->query_xiuwei_map();
    m_enable = ob->query_enable_map();

    if ( !mapp(m_jilei) )  m_jilei  = ([]);
    if ( !mapp(m_lingwu) ) m_lingwu = ([]);
    if ( !mapp(m_xiuwei) ) m_xiuwei = ([]);
    if ( !mapp(m_enable) ) m_enable = ([]);

    if ( wizardp(me) )
    {
        write("--------------------------------------------"
              "---级别-领悟-积累-领悟比-积累比\n");
        for ( i = 0; i < sizeof( m_jibie ); i++ )
    	{
            if ( SKILL_D( sname[ i ] )->is_native_skill() )
                continue;

            if ( ob->check_hide_skill(sname[i]) && !opt_all )
                continue;

    	    jibie = m_jibie[ sname[ i ] ];
    	    jilei = m_jilei[ sname[ i ] ];
    	    lingwu = m_lingwu[ sname[ i ] ];
            xiuwei = m_xiuwei[ sname[ i ] ];
            if ( !jibie && !lingwu ) continue;
    	    printf( "%s"HIG"%-12s%-28s"NOR"※%-10s※%4d%4d/%5d %3d%%   %3d%%\n",
                m_enable[ sname[i] ] ? HIR"★"NOR : "  ",
                to_chinese(sname[i]), HIY" 〖" + sname[i] + "〗",
                skill_level( SKILL_D( sname[i] )->type(), jibie ),
    	    	jibie, lingwu, jilei,
                ob->query_lingwu_ratio( sname[ i ] ),
                ob->query_jilei_ratio( sname[ i ] ) );
    	}
    }
    else
    { 
        write("--------------------------------------------"
              "---领悟比-积累比\n");
        for ( i = 0; i < sizeof(m_jibie); i++ )
    	{
            if ( SKILL_D( sname[ i ] )->is_native_skill() )
                continue;
            if ( ob->check_hide_skill(sname[i]) && !opt_all)
                continue;

    	    jibie = m_jibie[ sname[ i ] ];
    	    jilei = m_jilei[ sname[ i ] ];
    	    lingwu = m_lingwu[ sname[ i ] ];
    	    printf( "%s"HIG"%-40s"NOR"※%-10s※ %3d%% - %3d%%\n", 
                m_enable[ sname[i] ] ? HIR"★"NOR : "  ",
                to_chinese( sname[i] ) + HIY" 〖" + sname[i] + "〗",
                skill_level( SKILL_D( sname[ i ] )->type(), jibie ),
    	     	ob->query_lingwu_ratio( sname[ i ] ),
                ob->query_jilei_ratio( sname[ i ] ) );             
    	}
    }
    write("\n");
    return 1;
}

string skill_level(string type, int level)
{
    int grade, count;

    grade = level / 5;
    count = level%5;

    switch ( type )
    {
    	case "knowledge":
    	    if ( grade >= sizeof(knowledge_level_desc) )
    	    	grade = sizeof(knowledge_level_desc) - 1;
    	    return knowledge_level_desc[grade];
    	default:
    	    if ( grade >= sizeof(skill_level_desc) )
    	    	grade = sizeof(skill_level_desc) - 1;
    	    return skill_level_desc[grade];
    }
}

int help(object me)
{
    write(@HELP
指令格式 : skills [<某人>]

这个指令可以让你查询所学过的技能。但你不可以查询你师父的技能。
我们将提供各个门派的拜师指南, 你也可以通过询问教你武功的 NPC
来知道可以学习什么。 

神仙可以查询任何人或 NPC 的技能状况。

深不可测对应的是150级，相应的信息是：
   『技能类』                             『知识类』

    初学乍练   心领神会   超群绝伦         新学乍用   马马虎虎   卓尔不群
    不知所以   深入浅出   登峰造极         不甚了了   轻车熟路   满腹经纶
    粗通皮毛   挥洒自如   卓然大家         不知端倪   运用自如   豁然贯通
    略识之无   驾轻就熟   一代宗师         平淡无奇   触类旁通   博古通今
    渐有所悟   出类拔萃   独步天下         司空见惯   深入浅出   博大精深
    半生不熟   初入佳境   空前绝后         初窥门径   已有小成   超群绝伦
    马马虎虎   神乎其技   旷古绝伦         略知一二   心领神会   举世无双
    平淡无奇   威不可当   登堂入室         茅塞顿开   了然于胸   独步天下
    平平常常   出神入化   超凡入圣         略识之无   见多识广   震古铄今
    触类旁通   豁然贯通   返璞归真         滚瓜烂熟   无所不通   超凡入圣
                          深不可测                               深不可测
HELP
    );
    return 1;
}
