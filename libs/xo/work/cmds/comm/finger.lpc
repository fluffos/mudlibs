// dfinger.c
// change log: nerd on Mar 3,1997
// wiz need not to decrease their gins...
// nerd 98-5     : add intermud functions.
// nerd 98-06-21: rewrite the check dup ip codes.

#include <ansi.h>
#include <net/daemons.h>

inherit F_CLEAN_UP;

void create()
{
    seteuid(getuid());
}

int main(object me, string arg)
{
    mixed * ppls;
    string msg;
    int i;

    if ( !arg )
    {
        if (wizardp(me))
        {
            ppls = map( filter(users(), (: environment($1) :)),
                function(object ob)
                {
                    return ({ ob, 0 , query_ip_name(ob) });
                } );
            ppls = sort_array( ppls,(: $1[2]>$2[2]?1:-1 :) );
            for ( i =0 ; i < sizeof(ppls)-1; i++ )
            {
                if ( ppls[i][2] == ppls[i+1][2] )
                {
                    ppls[i][1] = 1;
                    ppls[i+1][1] = 1;
                }
            }
            msg = "";
            for ( i = 0; i < sizeof( ppls ); i++ )
            {
                msg +=sprintf("%s%-14s%-10s%-30s%s"NOR"\n",
                        ppls[i][1]?BRED:"", ppls[i][0]->query("name"),
                        geteuid(ppls[i][0]),
                        FINGER_D->age_string( (int)ppls[i][0]->query("mud_age")),
                        ppls[i][2] );
            }
            me->start_more(msg);
        }
        else
        {
            if( me->query("sen") < 32 )
                return notify_fail("你的精神无法集中。\n");
            me->start_more( FINGER_D->finger_all());
            me->receive_damage("sen",30);
        }
    }
    else
    {
        string user, mud;
        if (!wizardp(me))
        {
            if ( (int)me->query("sen") < 15 )
                return notify_fail("你的精神无法集中。\n");
            me->receive_damage("sen", 15);
        }
        if ( ( sscanf ( arg, "%s@%s", user, mud ) ) == 2 )
        {
            if ( user != "" && mud != "" && mud = INTERMUD_D->GetMudName(mud) )
                INTERMUD_D->eventSendFingerRequest(user, mud);
            return 1;
        }
        else
            write( FINGER_D->finger_user(arg) );
    }
    return 1;
}

int help(object me)
{
  write(@HELP
指令格式 : finger [使用者姓名]
 
这个指令, 如果没有指定使用者姓明, 会显示出所有正在线上玩家
的连线资料. 反之, 则可显示有关某个玩家的连线, 权限等资料.
 
see also : who
HELP
    );
    return 1;
}
 
