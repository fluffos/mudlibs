// test.c 
#include <ansi.h>

inherit F_CLEAN_UP;
void printlevel(object);
int QueryLevel(object);

void create() {
  seteuid(ROOT_UID);
}
int main(object me, string arg) {
  object ob;

  if (!arg) {
    foreach (object u in users())
      printlevel(u);
  }
  if (!(ob = get_object(arg)))
    return notify_fail("没有这个人。。\n");
  if (wizardp(ob) || !ob->is_character())
    return notify_fail("这个东西没有等级。\n");
  printlevel(ob);
  return 1;
}

void printlevel(object ob) {
  printf("%s 的 等级因子是: %d\n", ob->name(), QueryLevel(ob));
}

//Hydra added 1998/10/13
int QueryLevel(object ppl) {
  int points = 0;
  string *known = ({ "sword", "blade", "unarmed", "dodge", "short", "whip", "long", "zonggang" });
  mapping xiuwei;     // = ob->query_xiuwei_map();
  xiuwei = ppl->query_xiuwei_map();
  if (sizeof(xiuwei))
    foreach (string type, int num in xiuwei)
      if (member_array(type, known) != -1)
        points += num * num;
  points = sqrt(points);
  points += ppl->query("max_force") / 1.2;
  points += ppl->query("combat_exp") / 500;
  return points;
}

