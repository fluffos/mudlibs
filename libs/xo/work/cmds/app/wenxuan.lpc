// Filename : /cmds/wenxuan.c
//
// ChangeLog:
//	1997-02-22	Falcon	create

inherit F_CLEAN_UP;

void create()
{
	seteuid( getuid() );
}

int main(object me, string arg)
{
	string *options;
	int year, month, num, i;
	object obj;
	mapping *notes;

	if ( arg )
	{
		options = explode( arg, " " );
		i = sizeof( options );
	    switch ( i )
		{
			case 1:
				sscanf( arg, "%d", num );
				break;

			default:
				return 0;
		}
		year = me->query( "wx_year" );
		month = me->query( "wx_month" );
		obj = new( MISC_DIR + "wenxuan.lpc" );
		if ( !obj )
        {
            write( "无法产生新的文选对象。\n" );
            return 0;
        }
        export_uid( obj );
        obj->set( "year", year );
        obj->set( "month", month );
        if ( file_size( obj->query_save_file() + __SAVE_EXTENSION__ ) >= 0 )
        {
            obj->restore();
			notes = obj->query( "notes" );
			if ( num < 1 ) num = 1;
			if ( num > sizeof( notes ) ) num = sizeof( notes );
			num--;
		    me->start_more( sprintf(
"[%d] %-40s %s(%s) - [%s]\n----------------------------------------------------------------------\n",
		    num + 1, notes[ num ][ "title" ], notes[ num ][ "author" ],
        	notes[ num ][ "id" ],
        	ctime( notes[ num ][ "time" ] )[0..9] ) + notes[ num ][ "msg" ] );
            destruct( obj );
        }
        else
        {
            destruct( obj );
            return notify_fail( "没有该月的文选。\n" );
        }
	}
	else
		return notify_fail( "你要读那篇文章?\n" );
	return 1;
}

int help(object me)
{
write(@HELP
指令格式 : wenxuan 编号 

这个指令用来阅读文选中的文章。

相关指令： wxmulu 
HELP
    );
    return 1;
}
