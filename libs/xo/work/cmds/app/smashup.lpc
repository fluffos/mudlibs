// smashup.c dragon 10/07/98
 
inherit F_CLEAN_UP;
 
int main(object me, string arg)
{
	object ob;
	string name1, name2;

	if (!arg) return notify_fail("指令格式: smashup <living>\n");
	ob = present(arg, environment(me));
	if (!ob) return notify_fail("找不到这个生物.\n");
	name1 = (string)me->query("name");
	name2 = (string)ob->query("name");
	tell_room(environment(me),
	name1+"抬头向天，高举双手，大喝一声：去死把！只见天地变色，日月无光，
突然一道闪电自九天飞来，刹那间照亮了整个世界，咔喳一声巨响，
不偏不倚击中"+name2+"大头, 立刻将之化为灰烬.\n", 
	({me, ob}));
	tell_object(ob, name1+"抬头向天，高举双手，大喝一声：去死把！只见天地变色，日月无光，
突然一道闪电自九天飞来，刹那间照亮了整个世界，咔喳一声巨响，
不偏不倚击中你.\n");
	
	write("你抬头向天，高举双手，大喝一声：去死把！只见天地变色，日月无光，
突然一道闪电自九天飞来，刹那间照亮了整个世界，咔喳一声巨响，
不偏不倚击中"+name2+"大头, 立刻将之化为灰烬.\n");
	write("哈哈哈哈哈哈..... 好爽啊!!!\n");
	ob -> die();
	return 1;
}
 
int help(object me)
{
   write(@HELP
指令格式: smashup <生物>
 
heihei...........

HELP
   );
   return 1;
}
