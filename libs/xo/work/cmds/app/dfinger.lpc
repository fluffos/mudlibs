// dfinger.c
// change log: nerd on Mar 3,1997
// wiz need not 
#include <ansi.h>

inherit F_CLEAN_UP;

void create() {
  seteuid(getuid());
}

object *check_dup_ip(object the_user) {
  object *usr, *usr1;
  int num_dup = 0, i, j = 0;

  string the_user_ip = query_ip_name(the_user);
  usr = users();


  for (i = 0; i < sizeof(usr); i++)
    if (the_user_ip == query_ip_name(usr[i]) && environment(usr[i]))
      num_dup++;


  if (num_dup <= 1) return 0;
  else num_dup--;

  usr1 = allocate(num_dup);

  for (i = 0; i < sizeof(usr); i++)
    if (the_user_ip == query_ip_name(usr[i]) && the_user != usr[i] && environment(usr[i]))
      usr1[j++] = usr[i];


  return usr1;
}

int main(object me, string arg) {

  object *ob, *usr;
  string msg;
  int i;
  if (!arg) {
    ob = users();
    for (i = 0; i < sizeof(ob); i++) {
      msg = "";
      if (this_player() && !this_player()->visible(ob[i]))
        continue;

      usr = check_dup_ip(ob[i]);

      if (arrayp(usr))
        msg = sprintf(HIR "%s%-20s  %-20s  %-10s %s\n" NOR,
          msg, ob[i]->query("name"), ob[i]->query("id"),
          FINGER_D->age_string((int)ob[i]->query("mud_age")),
          query_ip_name(ob[i]));
      else
        msg = sprintf("%s%-20s  %-20s  %-10s %s\n",
          msg, ob[i]->query("name"), ob[i]->query("id"),
          FINGER_D->age_string((int)ob[i]->query("mud_age")),
          query_ip_name(ob[i]));

      write(msg);


    }


  } else {
    if (!wizardp(me)) {
      if ((int)me->query("sen") < 15)
        return notify_fail("你的精神无法集中。\n");
      me->receive_damage("sen", 15);
    }
    write(FINGER_D->finger_user(arg));
  }
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : dfinger [使用者姓名]
 
这个指令, 如果没有指定使用者姓明, 会显示出所有正在线上玩家
的连线资料. 反之, 则可显示有关某个玩家的连线, 权限等资料.
 
see also : who
HELP
  );
  return 1;
}
