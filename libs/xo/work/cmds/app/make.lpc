/* /cmds/app/make.c
 * make room from a file automaticly
 */

#define VERSION "Alpha test 1"

inherit F_CLEAN_UP;

void parse_line(string *lines);
int file_exists(string file);
string format_text(string text);

int main(object who, string arg) {
  string content;
  string *lines;
  seteuid(geteuid(who));

  if (!arg)
    return notify_fail("You need give a file name to read.\n");

  if (!file_exists(arg))
    arg = who->query("cwd") + arg;
  if (!file_exists(arg))
    return notify_fail("文件在哪里啊？\n");

  content = read_file(arg);
  if (!content || !(sizeof(lines = explode(content, "\n"))))
    return notify_fail("别拿空文件来懵我！\n");
  parse_line(lines);
  return 1;
}

void parse_line(string *lines) {
  string *words;
  string file, text, long;
  int i = 0;

  text = sprintf("// $FILENAME$\n//created by %s %s\n//this file is created "
    "by room auto-mapper %s.\n\n#include <ansi.h>\n\ninherit ROOM;\n\n"
    "void create()\n{\n    set(\"short\",\"$SHORT$\");\n    set(\"long\","
    "@LONG\n$LONG$\nLONG );\n",
    geteuid(this_player(1)), ctime(time()), VERSION);
  file = 0;  //no filename first.
  while (i < sizeof(lines)) {
    printf(lines[i] + "\n");
    if (!lines[i]) {
      i++;
      continue;
    }
    printf("1\n");
    words = explode(lines[i], "::");
    if (sizeof(words) == 2) {
      switch (words[0]) {
        case "filename":
          file = words[1];
          text = replace_string(text, "$FILENAME$", file);
          // todo : file can be a relative name. the end shoud seach $F..
          break;
        case "short":
          text = replace_string(text, "$SHORT$", words[1]);
          break;
        case "long":
          long = words[1];
          while (strsrch(lines[++i], "::") == -1)
            long += lines[i];
          i--;  // pattern not found,rollback one line.
          text = replace_string(text, "$LONG$", format_text(long));
          break;
        default:  //!more works!such as items.object...mapping data..
          text += sprintf("    set(\"%s\",%s);\n", words[0], words[1]);
          break;
      }
    } else
      write("warning : Unknown format at line :" + i + "\n");
    i++;
  }
  text += "    setup();\n}";
  if (!file) {
    file = resolve_path(this_player(1)->query("cwd")) + "tmproom.c0";
    write("Fatal Error: cannot get dest infomation.\nFile written to " + file + "\n");
    write_file(file, text);
  } else {
    write_file(file, text);
    write("Room created sucessfully.\n");
  }
}

int file_exists(string file) {
  return (file_size(file) > 0);
}

string format_text(string text) {
  return EMOTE_D->normal(text);
}
