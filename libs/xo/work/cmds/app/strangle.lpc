// strangle.c dragon 10/08/98
//大家都看到了，这个家伙没事就长篇大论、婆婆妈妈、叽叽歪歪，就好象整 
//天有一只苍蝇，嗡嗡嗡。。。对不起，不是一只苍蝇，是一堆苍蝇围着你呀，嗡嗡 
//嗡。。。，飞到你的耳朵里面，救命呀。。。救命呀。。。所以呢，我就抓住苍蝇， 
//挤破它的肚皮，把它肠子扯出来，再用它的肠子勒住它的脖子，用力一拉。厄。。。， 
//整条舌头都伸出来了，我就手起刀落，哗，整个世界都清净了。现在大家明白，我 
//为什么要杀他了吗？ 


inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object ob;
	string name1, name2;

	if (!arg) return notify_fail("指令格式: strangle <living>\n");
	ob = present(arg, environment(me));
	if (!ob) return notify_fail("找不到这只苍蝇.\n");
	name1 = (string)me->query("name");
	name2 = (string)ob->query("name");
	tell_room(environment(me),
	name1+"指着"+name2+"说道：大家都看到了，这个家伙没事就长篇大论、婆婆妈妈、
叽叽歪歪，就好象整天有一只苍蝇，嗡嗡嗡．．．对不起，不是一只苍蝇，是一堆
苍蝇围着你呀，嗡嗡嗡．．．飞到你的耳朵里面，救命呀．．．救命呀．．．
所以呢，我就抓住"+name2+"这只苍蝇，挤破它的肚皮，把它肠子扯出来，再用
它的肠子勒住它的脖子，用力一拉。厄．．．整条舌头都伸出来了，我就手起刀落，
哗．．．整个世界都清净了。
现在大家明白，我为什么要杀他了吗？ 
\n", 
	({me, ob}));
	tell_object(ob, name1+"指着你说道：大家都看到了，这个家伙没事就长篇大论、婆婆妈妈、
叽叽歪歪，就好象整天有一只苍蝇，嗡嗡嗡．．．对不起，不是一只苍蝇，是一堆
苍蝇围着我呀，嗡嗡嗡．．．飞到我的耳朵里面，救命呀．．．救命呀．．．
所以呢，我就抓住你这只苍蝇，挤破你的肚皮，把你肠子扯出来，再用你的肠子
勒住你的脖子，用力一拉。厄．．．整条舌头都伸出来了，我就手起刀落，
哗．．．整个世界都清净了。
现在大家明白，我为什么要杀他了吗？ 
\n");
	
	write("你指着"+name2+"说道：大家都看到了，这个家伙没事就长篇大论、婆婆妈妈、
叽叽歪歪，就好象整天有一只苍蝇，嗡嗡嗡．．．对不起，不是一只苍蝇，是一堆
苍蝇围着你呀，嗡嗡嗡．．．飞到你的耳朵里面，救命呀．．．救命呀．．．
所以呢，我就抓住"+name2+"这只苍蝇，挤破它的肚皮，把它肠子扯出来，再用
它的肠子勒住它的脖子，用力一拉。厄．．．整条舌头都伸出来了，我就手起刀落，
哗．．．整个世界都清净了。
现在大家明白，我为什么要杀他了吗？\n");
	write("哈哈哈哈哈哈..... 好爽啊!!!\n");
	ob -> die();
	return 1;
}
 
int help(object me)
{
   write(@HELP
指令格式: strangle <生物>
 
阴森地...嘿嘿嘿......

HELP
   );
   return 1;
}
