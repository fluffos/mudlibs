// Filename : /cmds/app/unconcious.c
inherit F_CLEAN_UP;

int main(object me, string str)
{
//    int min;
    object obj;

    if (!str || str == "") return notify_fail("指令格式 : unconcious <对象>\n");
    
    if (!obj=present(str,environment(this_player())))
        return notify_fail ("对象错误: 找不到"+str+"\n");

    if (me == obj) return notify_fail ("你想把自己弄晕????不好吧？\n");

    obj->unconcious();
    return 1;
}

int help(object me)
{
  write(@HELP
指令格式 : unconcious <对象>

利用此指令可使清醒的生物昏迷。
HELP
    );
    return 1;
}
