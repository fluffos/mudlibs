// by trill

inherit F_CLEAN_UP;

int main(object me, string arg)
{
    int result;
    object money;
    string msg;

    seteuid( getuid() );
    if ( !money = new( MONEY_DIR + "money.lpc" ) )
        return 0;
    if ( !arg ) 
        msg = sprintf( "现在钱庄中共存有： %d文钱。\n", money->check_money() );
    else if ( sscanf( arg, "%d", result ) )
    {
        msg = "";
        foreach( string id, int number in money->CheckMoney( result ) )
        {
            msg = sprintf( "%s%s在钱庄存有  %d文钱。\n", msg, id, number );
        }
    }
    else
        msg = sprintf( "%s在钱庄中存有： %d文钱。\n", arg, money->check_money( arg ) );
    destruct( money );
    write( msg );
    return 1;
}

int help(object me)
{
write(@HELP
指令格式 : check <某个id> 

可以得知这个id在钱庄存有多少钱
如果不输入id，那么可以得知钱庄中一共存有多少钱

HELP
    );
    return 1;
}
