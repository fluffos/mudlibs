// Filename : /cmds/app/revive.c
inherit F_CLEAN_UP;

int main(object me, string str) {
  object who;

  if (!str) who = me;
  else {
    if (!who = present(str, environment(me)))
      if (!who = find_player(str))
        if (!who = find_living(str))
          return notify_fail("对象错误, 没有找到" + str + "\n");
  }
  if (!who->is_character() || who->is_corpse())
    return notify_fail("看清楚点，那不是活物。\n");
  who->remove_call_out("revive");
  who->revive();
  who->reincarnate();
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : revive <对象>

利用此指令可使昏迷的生物醒来。
HELP
  );
  return 1;
}
