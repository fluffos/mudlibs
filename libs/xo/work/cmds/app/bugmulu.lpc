#include <localtime.h>

inherit F_CLEAN_UP;

void list_mulu(object me, object obj);
int help(object me);

void create() {
  seteuid(getuid());
}

int main(object me, string arg) {
  string *options;
  int i, year, month;
  mixed *local;
  object obj;

  if (!arg) {
    local = localtime(time());
    year = local[LT_YEAR];
    month = local[LT_MON] + 1;
  } else {
    options = explode(arg, " ");
    i = sizeof(options);
    switch (i) {
      case 1:
        sscanf(arg, "%d", month);
        local = localtime(time());
        year = local[LT_YEAR];
        break;

      case 2:
        sscanf(arg, "%d %d", year, month);
        break;

      default:
        return 0;
    }
  }
  seteuid(getuid());
  obj = new(MISC_DIR + "bug.lpc");
  if (!obj) {
    write("无法产生新的记录对象。\n");
    return 0;
  }
  export_uid(obj);
  obj->set("year", year);
  obj->set("month", month);
  if (file_size(obj->query_save_file() + __SAVE_EXTENSION__) >= 0) {
    me->set("bg_year", year);
    me->set("bg_month", month);
    obj->restore();
    list_mulu(me, obj);
    destruct(obj);
  } else {
    string temp;
    temp = sprintf("没有 %d 年 %d 月的 bug 记录。\n", year, month);
    destruct(obj);
    return notify_fail(temp);
  }
  return 1;
}

void list_mulu(object me, object obj) {
  mapping *notes;
  string msg;
  int i;

  msg = sprintf("\n--------------------------------------------------------------------\n%30s bug 记录%d年%d月号\n----------------------------------------------------------------------\n",
    mud_name(), obj->query("year"), obj->query("month"));
  notes = obj->query("notes");
  for (i = 0; i < sizeof(notes); i++)
    msg += sprintf("[%3d] %-40s %12s (%s)\n",
      i + 1, notes[i]["title"], notes[i]["author"],
      ctime(notes[i]["time"])[8..15]);
  me->start_more(msg);
}

int help(object me) {
  write(@HELP
指令格式 : bugmulu [年] [月] 

这个指令列出指定的 bug 记录文档的目录。

相关指令： bug, wdmulu, wendang, wxmulu, wenxuan 
HELP
  );
  return 1;
}
