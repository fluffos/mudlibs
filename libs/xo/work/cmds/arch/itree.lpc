// itree.c
// draw the inherit tree of a object
// by nerd @ today
#include <ansi.h>

inherit F_CLEAN_UP;

void drawtree(object ob, int level);

int main(object me, string arg)
{
    object theob;
    if ( ! theob = get_object( arg ) )
        return notify_fail("找不到这个东西。\n");
    write(REF "\n");
    drawtree(theob, 0);
    write(NOR "\n");
    return 1;
}

void drawtree(object ob, int level)
{
    string * pig;
    int i = level;
    if (!ob)
        return;
/*    while ( i-- > 0)
        write("   ｜");
    write("\n");
    i = level;
*/
    write(RED);
    while ( --i > 0 )
        write("   ｜");
    if (level)
        write("   ├—");
    write(GRN);
    write(base_name(ob) + NOR "\n");
    pig = inherit_list(ob);
    if (!sizeof( pig))
        return;
    foreach( string str in pig)
    {
        object obj;
        obj = get_object(str);
        if (!obj)
            catch( obj = new (str) );
        if (!obj)
            return;
        drawtree( obj , level +1);
    }
    return;
}

