// filename : /cmds/wiz/info.c
#include <ansi.h>

inherit F_CLEAN_UP;

int help(object me);
string format_page(string *items, int columns);

int main(object me, string arg) {
  object obj;
  string str;
  mixed *tmparr, fun;
  mapping tmpmap;

  if (!arg) return help(me);

  seteuid(geteuid(me));

  if (arg == "me")
    obj = me;
  else if (arg == "my link")
    obj = me->query_temp("link_ob");
  else {
    obj = present(arg, me);
    if (!obj) obj = present(arg, environment(me));
    if (!obj) obj = find_object(resolve_path(me->query("cwd"), arg));
    if (!obj) return notify_fail("没有这样物件....。\n");
  }

  str = sprintf(GRN "物件 [%O]" NOR
    "\n-----------------------------------------------------\n", obj);
  str += GRN "档案：" NOR "\t\t" + base_name(obj) + ".c\n";
  str += GRN "领域：" NOR "\t\t" + domain_file(base_name(obj)) + "\n";
  str += GRN "作者：" NOR "\t\t" + author_file(base_name(obj)) + "\n";
  str += GRN "权限：" NOR "\t\tuid = " + getuid(obj) + ", euid = " + geteuid(obj) + "\n";
  str += GRN "等级：" NOR "\t\t" + wizhood(obj) + "\n";
  str += GRN "使用内存：" NOR "\t" + memory_info(obj) + "\n";
  str += GRN "属性：" NOR "\t\t";
  if (living(obj))
    str += "生物 ";
  if (userp(obj))
    str += "使用者 ";
  if (interactive(obj))
    str += "线上 ";
  if (wizardp(obj))
    str += "巫师 ";
  if (clonep(obj))
    str += "复制 ";
  if (virtualp(obj))
    str += "虚拟 ";
  if (query_heart_beat(obj))
    str += GRN "心跳:" NOR + query_heart_beat(obj) + " ";
  str += "\n";
  str += GRN "复制个数：" NOR "\t" + sizeof(children(base_name(obj) + ".lpc")) + "\n";
  str += GRN "参考连结：" NOR "\t" + refs(obj) + "\n";

  tmparr = stat(base_name(obj) + ".lpc");
  //    str = YEL"Object: " + topic + NOR"\n"
  str += GRN "上次修改时间：" NOR + ctime(tmparr[1]) + "\n";
  if (tmparr[2]) {
    str += GRN "上次载入时间：" NOR + ctime(tmparr[2]) + "\n\n";
  }
  tmparr = inherit_list(obj);  // = find_object(topic));
  if (!sizeof(tmparr)) {
    str += GRN "未继承任何物件。" NOR "\n\n";
  } else {
    str += GRN "继承：" NOR "\n" + format_page(tmparr, 2) + "\n";
  }
  tmparr = functions(obj, 1);
  tmpmap = ([]);
  foreach (fun in tmparr) {
    if (function_exists(fun[0], obj) != base_name(obj))
      continue;
    if (fun[0] == "#global_init#")
      continue;
    if (tmpmap[fun[0]])
      continue;
    else {
      tmpmap[fun[0]] = ([ "type": fun[2],
        "args": (fun[1] ? fun[3..] : ({})) ]);
    }
  }
  if (!sizeof(tmparr)) {
    str += GRN "无任何函数。" NOR "\n\n";
  } else {
    string fnc;

    str += GRN "函数：" NOR "\n";
    tmparr = sort_array(keys(tmpmap), 1);
    foreach (fnc in tmparr) {
      str += tmpmap[fnc]["type"] + fnc + "(" + implode(tmpmap[fnc]["args"], ", ") + ");\n";
    }
  }
  me->start_more(str);  // so long.
  return 1;
}

string format_page(string *items, int columns) {
  int i, j;
  string ret;

  if (!columns)
    columns = 2;
  ret = "";
  /*    if (this_player())
        width = ((int *) this_player()->GetScreen())[0];
    else
    width = 75;
    width = width / columns;
    for (i = 0, x = sizeof(items); i < x; i += columns)
    {
        for (j = 0; j < columns; j++)
        {
            if (i + j >= x)
                break;
            ret += arrange_string(items[i + j], width);
        }
        ret += "\n";
    }*/
  for (i = 0; i <= sizeof(items) / columns; i++) {
    for (j = 0; j < columns; j++) {
      if (i * columns + j >= sizeof(items))
        return ret;
      ret += sprintf(sprintf("%%-%ds", 80 / columns), items[i * columns + j]);
    }
    ret += "\n";
  }
  return ret;
}

int help(object me) {
  write(@HELP
指令格式 : info <物件之名称或文件名>

利用此一指令可得知一些有关该物件的信息。
HELP
  );
  return 1;
}
