// Filename : /cmds/wiz/llist.c 

//inherit F_CLEAN_UP;

#define OPT_ALL				0
#define OPT_OBJECT_NAME		1	
#define OPT_FILENAME		2
#define OPT_EMPTY			3

int main(string str, string arg)
{
	string *temp;
	object *obs;
    int i, option;

	option = OPT_ALL;
	if ( arg )
	{
		temp = explode( arg, " " );
		i = sizeof( temp );
	}
    obs = livings();
    obs = sort_array( obs, function( object ob1, object ob2 )
                        {
                            return strcmp( ob1->query( "id" ), ob2->query( "id" ) );
                        } );

    if ( arrayp( obs ) ) 
        foreach( object ob in obs )
    	{
         	write( sprintf( "%15s : %30s\n", ob->query( "id" ),
    	    	file_name( ob ) ) );
        }

    if ( !arrayp( obs ) || !sizeof( obs ) )
        write( "\nNo living object was founded.\n" );
    else if ( sizeof( obs ) > 1 )
        write( sprintf( "\nTotal %d living objects.\n", sizeof( obs ) ) );
    else write( "\nOnly 1 living object.\n" );

    return 1;
}

int help(object me)
{
write(@HELP
指令格式 : llist

将所有的生物显示出来。
HELP
    );
    return 1;
}
