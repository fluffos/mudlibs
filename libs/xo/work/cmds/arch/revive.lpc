// Filename : /cmds/app/revive.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string str) {
  object who;

  if (!str) who = me;
  else who = get_object(str);
  if (!who)
    return notify_fail("没有这个人..\n");
  who->remove_call_out("revive");
  who->revive();
  who->reincarnate();
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : revive <对象>

利用此指令可使昏迷的生物醒来。
HELP
  );
  return 1;
}
