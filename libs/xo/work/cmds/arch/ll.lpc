// localcmds.c

#include <action.h>

inherit F_CLEAN_UP;

string hehe(object obj) {
  string msg = "";
  foreach (class Action action in obj->GetGiveActions())
    msg += sprintf("%-15s %-40O\n", action->verb,
      action->func);
  return msg;
}

int main(object me, string path) {
  object obj;
  if (!objectp(obj = present(path, environment(me))))
    return 1;
  printf(hehe(obj));
  return 1;
}

int help() {
  write(@TEXT
指令格式：localcmds

列出你身上及四周的物品与所在的环境提供的所有指令。
TEXT
  );
  return 1;
}
