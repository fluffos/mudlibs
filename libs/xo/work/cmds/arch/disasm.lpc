inherit F_CLEAN_UP;

int main(object who, string arg) {
  string ob, file;
  object targ;
  if (!arg)
    return notify_fail("synatx: disasm <object> <file> \n");
  if ((sscanf(arg, "%s %s", ob, file) != 2))
    return notify_fail("syntax: disasm <object> <file> \n");
  targ = get_object(ob);
  if (!targ)
    return notify_fail("cannot find the object.\n");
  if (!who->query("cwd"))
    return 0;
  dump_prog(targ, 0, "/dump.file");  //resolve_path(who->query("cwd")) + file);
  return 1;
}
