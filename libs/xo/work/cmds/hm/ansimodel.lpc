// ansimodel.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me)
{
        write(HIW "测试开始。。。。。。\n\n" NOR);
        write(
BLK"       BLK       "+RED"        RED        "+GRN"        GRN        \n"+
YEL"       YEL       "+BLU"        BLU        "+MAG"        MAG        \n"+
CYN"       CYN       "+WHT"        WHT        "+HIK"        HIK        \n"+
HIR"       HIR       "+HIG"        HIG        "+HIY"        HIY        \n"+
HIB"       HIB       "+HIM"        HIM        "+HIC"        HIC        \n"+
HIW"       HIW       "+NOR"        NOR        \n"
);
        write(HIW "测试完成。\n" NOR);
//        me->add("social_exp",100);
        return 1;
}
int help(object me)
{
        write(@HELP
指令格式 : ansimodel

    这个指令是专门用来检验各种ANSI颜色和状态在正在使用的机器及软件
  中的效果的。

HELP
        );
        return 1;
}
