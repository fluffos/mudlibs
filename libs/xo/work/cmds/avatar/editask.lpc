// edit ask somebody about something.
//by trill 03/21/97 

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object obj;
	string who, msg, answer_msg;
	
    if (!arg)
        return notify_fail("<Syntax>: editask <player id> about <message> <answer_massage>\n");
    
    if (sscanf(arg, "%s about %s %s", who, msg, answer_msg) != 3) 
        	return  notify_fail("<Syntax>: editask <player id> about <message> <answer_massage>\n");

	if ( who == (string)me->query("id") ) 
		obj = me;
	else {
		if ( !userp ( obj = present ( who, environment(me) ) ) ) 
			return notify_fail("你只能编辑你身边的人或自己的的ask。\n");
		if ( wizardp(obj) )
			return notify_fail("神仙们的ask应该自己写，不用别人代劳。\n");
	}
	if ( obj->query("trill_ask/"+msg) )
		obj->delete("trill_ask/"+msg);
	obj->set("trill_ask/"+msg, answer_msg);
	obj->save();
	write("编辑完毕。\n");
	return 1;
}

int help(object me)
{
write(@HELP
指令格式 : editask <某人的id> about <要问的消息> <回答的消息>
或者可以用 to editask <id> about <要问的消息>
比如
to editask falcon about falcon
结束离开用 '.'，取消输入用 '~q'。
—————————————————————————————
$N一本正经的说道：虽然我叫falcon，其实我是狐儿。
.
编辑完毕

再 ask falcon about falcon
就会看到

狐儿一本正经的说道：虽然我叫falcon，其实我是狐儿。
HELP
    );
    return 1;
}
