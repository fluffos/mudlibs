// kill.c
// rewrited by qyz

#include <ansi.h>

inherit F_CLEAN_UP;

void create() {
  seteuid(getuid());
}

int main(object ppl, string arg) {
  object obj, here = environment(ppl);
  string callname;


  if (here->query("wiz"))
    return notify_fail(HIR "这是属于神的房间，不能用来练功\n" NOR);

  if (here->query("no_fight"))
    return notify_fail("这里不准战斗。\n");

  if (here->query("no_kill") == 1)
    return notify_fail("这里不准杀人。\n");

  if (here->query("no_kill") && userp(ppl)) {
    //      ppl->apply_condition( "kill_" + here->query( "no_kill" ), 100 );
    //      苯。crime_d已经设过了apply_condition。 -- by lnwm
    CRIME_D->set_crime(ppl, here->query("no_kill"));
  }

  if (!arg)
    return notify_fail("你想杀谁？\n");

  if (!objectp(obj = present(arg, here)))
    return notify_fail("看清楚些，这里没有这个人。\n");

  if (!obj->is_character()
    || obj->is_corpse())
    return notify_fail("看清楚一点，那并不是活物。\n");

  if (!living(obj)
    && obj->query("disable_type") == "<睡梦中>")
    return notify_fail("在光天化日之下杀一个正在睡觉的人？还是等他醒来再较量吧。\n");
  if (obj == ppl)
    return notify_fail("用 suicide 指令会比较快。:P\n");

  if (ppl->query_lianing())
    return notify_fail("练习时就想杀人，呵呵，你真行。\n");

  if (ppl->is_duanling())
    return notify_fail("等对练结束了再杀人也不迟嘛。\n");

  callname = RANK_D->query_rude(obj);

  if (userp(obj)) {
    if (newbiep(obj))
      return notify_fail("这么小的孩子你也杀？太残忍了。\n");
    if (newbiep(ppl))
      return notify_fail("你自己还需要人保护呢，就别动手杀人了。\n");
  }

  message_vision("\n$N对着$n喝道：「"
    +callname + "！今日不是你死就是我活！」\n\n", ppl, obj);
  if (userp(obj)) {
    ppl->kill_ob(obj);
    obj->fight_ob(ppl);
    // 如果是动物, 怎么还能是"这个人"呢?
    if (!obj->is_killing(ppl->query("id")))
      tell_object(obj, HIR "看来" + ppl->query("name")
        + "( " + ppl->query("id") + " )" +
        "想杀死你，你如果想跟这个人性命相搏，不死不休,请你也对\n"
        "这个人下一个 kill 指令\n" NOR);
    return 1;
  } else if (!userp(obj)) {
    if (obj->refuse_killing(ppl))
      return 1;
    ppl->kill_ob(obj);
    obj->kill_ob(ppl);
  }
  return 1;
}

int help(object ppl) {
  write(@HELP
指令格式 : kill <某人> | sha <某人>
 
这个指令让你主动开始攻击一个人物，并且尝试杀死对方，由于 kill 只需要单方
面一厢情愿就可以成立，因此你对任何人使用 kill 指令都会开始战斗，通常如果
对方是 NPC 的话，他们也会同样对你使用 kill。

当有人对你使用 kill 指令时会出现红色的字样警告你，对于一个玩家而言，如果
你没有对一名敌人使用过 kill 指令，你将会反击直到将敌人打昏为止，当然，也
可能存在失手将对方打死的可能性。

其他相关指令: bihua( tiaozhan ), duilian, qiecuo( fight ) 

HELP
  );
  return 1;
}
