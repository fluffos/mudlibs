// Filename : /cmds/verb/wield.c

inherit F_CLEAN_UP;

int do_wield(object me, object ob);

int main(object me, string arg) {
  object ob, *inv;
  int i;

  if (!arg)
    return notify_fail("你要装备什么武器？\n");

  if (arg == "all")   // add by cry 10.8.98
  {
    inv = all_inventory(me);
    for (i = 0; i < sizeof(inv); i++)
      if (!stringp(inv[i]->query("equipped"))) {
        do_wield(me, inv[i]);
      }
    write("Ok.\n");
    return 1;
  }

  ob = present(arg, me);
  if (!objectp(ob))
    return notify_fail("你身上没有这样东西。\n");

  if (ob->query("equipped"))
    return notify_fail("你已经装备这件武器了。\n");

  if (me->is_lianing())
    return notify_fail("练习的时候换武器干嘛？ \n");

  return do_wield(me, ob);
}

int do_wield(object me, object ob) {
  string str;

  if (ob->wield()) {
    str = ob->query("wield_msg");
    if (!stringp(str))
      str = "$N装备$n作武器。\n";
    message_vision(str, me, ob);
    return 1;
  } else
    return 0;
}

int help(object me) {
  write(@HELP
指令格式：wield <武器名称>
 
这个指令让你装备某件物品作武器，当然你必须拥有这样物品。 

其他相关指令: remove, unwield, wear 
 
HELP
  );
  return 1;
}
