// lead.c
//by lnwm
#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object ob;

        if ( environment(me)->query("wiz"))
                return notify_fail(HIR "这是属于神的房间，不能用来练功\n" NOR);

        if( !arg ) return notify_fail("指令格式：lead <某人>。\n");

	if( arg=="none")
    {
        me->delete("env/lead_newbie");
        tell_object( me , "你现在不让任何新手跟随。\n");
        return 1;
    }

	if( !objectp(ob = present(arg, environment(me))) )
		return notify_fail("这里没有 " + arg + "。\n");

	if( !ob->is_character() )
		return notify_fail("什麽？带领...." + ob->name() + "。\n");

	if( ob==me )
		return notify_fail("带领自己？\n");
	
    if( userp( ob ) && !newbiep( ob ) )
        return notify_fail("人家可不是小孩，不是你想甩就甩的掉的。\n");
    else
        me->set("env/lead_newbie/" + arg, 1 );
    
	message_vision("$N决定带领$n一起行动。\n", me, ob);
    tell_object( ob, "如果你想跟着" + me->query("name") + "一起行动，就用follow指令。\n" );

	return 1;
}

int help (object me)
{
        write(@HELP
指令格式 : lead [<生物>|none]
 
这个指令让你能带领一个或几个新手一起行动。
如果输入 lead none 则不让任何新手跟随。
如果只想让某个新手不跟着你行动，请用unlead指令。
 
HELP
);
        return 1;
}
