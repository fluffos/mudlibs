// Filename : /cmds/verb/give.c

inherit F_CLEAN_UP;

int do_give(object ppl, object obj, object who);

void create() {
  seteuid(getuid());
}

int main(object ppl, string arg) {
  string target, item;
  object obj, who, *inv, obj2;
  int i, amount;

  if (!arg)
    return notify_fail("你要给谁什么东西？\n");

  if (sscanf(arg, "%s to %s", item, target) != 2
    && sscanf(arg, "%s %s", target, item) != 2)
    return notify_fail("你要给谁什么东西？\n");

  if (!objectp(who = present(target, environment(ppl))))
    return notify_fail("这里没有这个人。\n");
  if (target == ppl->query("id"))
    return notify_fail("自己把东西给自己？你就这么无聊吗？\n");
  if (!living(who))
    return notify_fail(who->name() + "现在可接受不了你的东西。\n");
  if (who->query("env/refuse_give"))
    return notify_fail(who->name() + "好象不大愿意接收你的物品。\n");

  if (sscanf(item, "%d %s", amount, item) == 2) {
    if (!objectp(obj = present(item, ppl)))
      return notify_fail("你身上没有这样东西。\n");
    if (obj->query("no_drop"))
      return notify_fail("这样东西不能随便给人。\n");
    if (!obj->query_amount())
      return notify_fail(obj->name() + "不能被分开给人。\n");
    if (amount < 1)
      return notify_fail("东西的数量至少是一个。\n");
    if (amount > obj->query_amount())
      return notify_fail("你没有那么多的" + obj->name() + "。\n");
    else {
      if (amount == (int)obj->query_amount())
        return do_give(ppl, obj, who);
      else {
        obj->set_amount((int)obj->query_amount() - amount);
        obj2 = new(base_name(obj));
        obj2->set_amount(amount);
        obj2->set_temp("amount", amount);
        return do_give(ppl, obj2, who);
      }
    }
  }
  if (item == "all") {
    inv = all_inventory(ppl);
    for (i = 0; i < sizeof(inv); i++) {
      do_give(ppl, inv[i], who);
    }
    write("Ok.\n");
    return 1;
  }

  if (!objectp(obj = present(item, ppl)))
    return notify_fail("你身上没有这样东西。\n");
  return do_give(ppl, obj, who);
}

int do_give(object ppl, object obj, object who) {
  if (obj->query("no_drop"))
    return notify_fail("这样东西不能随便给人。\n");
  if (obj->query("equipped"))
    return notify_fail("已经装备了的东西是不能给人的。\n");

  ppl->eventTaskEnd("give", who, obj);
  if (!obj->CanRecieve() && !interactive(who) &&
    !who->accept_special_object(ppl, obj) &&
    !who->accept_object(ppl, obj)) {
    if (obj->query_temp("amount")) {
      obj->delete_temp("amount");
      obj->move(ppl);
    }
    return notify_fail(who->name() + "好象不大愿意接收你的物品。\n");
  }
  if (userp(who) && who->query("env/no_accept"))
    return notify_fail(who->name() +
      "说：“我怎么能要你的东西？”\n对方不愿接受你的东西。");
  if (!userp(who) && obj->value()) {
    message_vision("$N拿出" + obj->short() + "给$n。\n", ppl, who);
    destruct(obj);
    return 1;
  } else if (obj->move(who)) {
    printf("你给%s一%s%s。\n", who->name(), obj->query("unit"),
      obj->name());
    message("vision", sprintf("%s给你一%s%s。\n", ppl->name(),
      obj->query("unit"), obj->name()), who);
    message("vision", sprintf("%s给%s一%s%s。\n", ppl->name(), who->name(),
      obj->query("unit"), obj->name()), environment(ppl), ({ ppl, who }));
    return 1;
  } else return 0;
}

int help(object ppl) {
  write(@HELP
指令格式：give <物品名称> to <某人>
      或：give <某人> <物品名称>
 
这个指令可以让你将某样物品给别人，当然，首先你要拥有这样物品。
 
HELP
  );
  return 1;
}
