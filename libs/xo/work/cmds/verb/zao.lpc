#include <ansi.h>
#include <room.h>

inherit F_CLEAN_UP;

int do_zao( string arg );

void create() { seteuid(getuid()); }

int main(object me, string arg)
{
	return do_zao( arg );
}

int do_zao( string arg )
{
      object *inv;
      object me,ob,room,obj;
      mapping resouse;
      int i,j;
	        
      me = this_player();
      
      if ( !ob = find_object(__DIR__"zaoman") )
            ob = load_object(__DIR__"zaoman");
      
      room = environment(me);  
      
      if ( !arg ) return notify_fail("你要制作什么？\n");

      if ( arg == "mu wu" )
      {
         inv = all_inventory( room );
         j = 0;
         for ( i = 0; i < sizeof(inv); i++ )
         {
              if( inv[i]->query("id")    == "mu wu" )
              {
                  j = 1;
              }
         }
         if ( j == 1 )
         return notify_fail("已经有一间屋子了......\n");
      }
      
      if ( arg == "mu wu" )
      {
         if ( room->query("short")!=GRN"草地"NOR )
         return notify_fail("这里地势不适于造木屋......\n");
      }
      
      if ( mapp( ob -> query(arg)) )
      {     
         resouse = ob ->query( arg );
         inv = all_inventory( room );
         j = 0;
         
         for ( i = 0; i < sizeof(inv); i++ )
         {
              if( inv[i]->query("id")    == "mu liao" )
              {
                  j = j + 1;
              }
         }
         
         if ( j < resouse["muliao"] )
         return notify_fail("木料不够啊.或者是你要把原料放在地上.....\n");
         
         obj = new( resouse["dir"] ) ;
         obj ->move( room );
         message_vision("$N把原料制成$n...",me,obj);
         
         j = 0;
         for ( i = 0; i < sizeof(inv); i++ )
         {
              if( inv[i]->query("id") == "mu liao" )
              {
                  j = j + 1;
                  if ( i < resouse["muliao"]+1 )
                  {
                      destruct( inv[i] );
                  }    
              }
         } 
        
         if ( arg == "mu wu" )
         { 
             room-> add("exits/in","/d/place/xkdao/muwu");
             room->create_door("in","木门","out",DOOR_CLOSED);         
         }
         return 1;
      }   
      
      message_vision("$N不要浪费原料，节约是人的美德!\n",me);
      return 1;
}  

int help(object me)
{
	write(@HELP
指令格式：zao <物品名>
 
这个指令让你加工某物品。
提供接口:     *make_resouse 
              *make_condition---make_result
建议将上面的内容写在原料上
HELP
    );
    return 1;
}
