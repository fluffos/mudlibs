// search.c                                 
// qyz

#include <ansi.h>

inherit F_CLEAN_UP;

void create() { seteuid(getuid()); }

int main(object me, string arg)
{   
    string *key,*gain_item;
    mapping searchs;
    mixed item;
    object env; 
    int i,k;
 
    if( !arg ) 
        return notify_fail("你要搜什麽东西？\n");
  
    if( !me->can_act() ) 
        return 0;

    env = environment(me);

    if( !searchs = env->query("search_things") )
    {
        if ( strsrch( env->query( "long" ), arg ) >= 0 )
        return notify_fail("这里的"+arg+"没有东西可搜。\n");
        else
        return notify_fail("这里没有"+arg+"\n");
    }
    if( !item = searchs[arg] )    
    {
        if ( strsrch( env->query( "long" ), arg ) >= 0 )
        return notify_fail("这里的"+arg+"没有东西可搜。\n");
        else
        return notify_fail("这里没有"+arg+"\n");                          
    }

    message_vision("$N开始仔细搜寻这里的"+arg+"......\n",me); 
    me->set_temp("block_msg/all",1);
    me->disable_player("<搜索中>");
    if( stringp( item ) || functionp( item ) )
    {
        if ( functionp(item) )
        {
            item = evaluate ( item );
        }
         me->disable_command("verb","你现在正在搜索中。\n");
         call_out("find_it",3,me,arg,item);
         return 1;
    } 
    if ( ! mapp(item) )
    {
        return notify_fail("这里的程序出错,请向巫师报告. + item type:" +
                typeof(item) + "\n");
    }
    key = keys(item);
    gain_item = key; 
    me->disable_command("verb","你现在正在搜索中。\n");   

    k = 0;
    for( i = 0; i < sizeof( key ); i++ )
    {                         
        if( item[key[i]] <= me->query("social_exp") )  
        {
             gain_item[k] = key[i];
             k += 1;
        }
    }
    if( k > 0 )    
        call_out("find_it", 3, me, arg, gain_item[random(k)]);  
    else
        call_out("fail_find",3,me);
    return 1;
}

protected void find_it( object me, string arg, string item )
{
    mapping founds;
    string msg;                   
    object env,obj;

    env = environment(me);
    me->receive_damage("gin" , 10);    
    founds = env->query_temp_marks("been_got");
    me->delete_temp("block_msg/all");
    if ( !mapp(founds) ) founds = ([]);          
    if ( !undefinedp(founds[item] )
         || item->cannot_search(me)  )
    msg = "结果什么也没有发现。\n";
    else
    {
        obj=new(item);
    if( obj->query_weight() < 200000 )
        obj->move(me);
    else
        obj->move(environment(me));
        me->add("social_exp", 8+random(6));
        msg = "$N找到了一"+item->query("unit")+item->name()+"！\n";
        founds[item] = 1;
        env->set_temp_marks("been_got", founds );
    }
    message_vision(msg,me); 
    me->enable_player();
    me->enable_path();
}                   
void fail_find(object me)
{
    me->delete_temp("block_msg/all");
    tell_room(environment(me),"结果什么也没有发现。\n");
    me->enable_player();
    me->enable_path();   
}

int help(object me)
{
    write(@HELP
指令格式 : search <物品名称> 
 
这个指令可以让你搜索房间里的某样物品。
 
HELP
    );
    return 1;
}
 
