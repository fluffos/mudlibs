// power.c writen by tea 10.15.98

#include <ansi.h>

inherit F_CLEAN_UP;

void printlevel(object, int);
int querylevel(object, string, int);
void create() {
  seteuid(ROOT_UID);
}

int main(object me, string arg) {
  object ob;
  string swt;

  if (!wizardp(me) && me->query("id") != "inf") {
    return 0;
  }
  if (!arg) {
    foreach (object u in users())
      printlevel(u, 0);
    return 1;
  }
  if (sscanf(arg, "%s %s", swt, arg) == 2 && swt == "-d") {
    if (!(ob = get_object(arg)))
      return notify_fail("没有这个人。。\n");
    if (!ob->is_character())
      return notify_fail("这是什么东西呀，乱测！！！\n");
    printlevel(ob, 1);
  } else {
    if (!(ob = get_object(arg)))
      return notify_fail("没有这个人。。\n");
    if (!ob->is_character())
      return notify_fail("这是什么东西呀，乱测！！！\n");
    printlevel(ob, 0);
  }
  return 1;
}

void printlevel(object ob, int detail) {
  if (!ob->name())
    return;
  if (detail) {
    printf(YEL "%s 的攻击因子是：%-10d\n" NOR, ob->name(), querylevel(ob, "TYPE_ATTACK", detail));
    printf(GRN "%s 的招架因子是：%-10d\n" NOR, ob->name(), querylevel(ob, "TYPE_PARRY", detail));
    printf(CYN "%s 的躲闪因子是：%-10d\n" NOR, ob->name(), querylevel(ob, "TYPE_DODGE", detail));
  } else
    printf(WHT "%-14s" YEL "攻击因子是：%-10d" GRN "招架因子是：%-10d" CYN "躲闪因子是：%-10d\n" NOR,
      ob->name() + "的", querylevel(ob, "TYPE_ATTACK", detail), querylevel(ob, "TYPE_PARRY", detail),
      querylevel(ob, "TYPE_DODGE", detail));
}

int querylevel(object ppl, string usage, int detail) {
  int power, xiuwei, temp;
  int skill_lingwu, skill_dengji;
  int attack = ppl->query_gongfang();
  string type, skill;
  int *power_ratio = ({ 1, 2, 4, 7, 11, 16, 22, 29, 37, 46, 56 });


  power = ppl->query("combat_exp") / 400;
  if (detail)
    printf("实战经验：%d", temp = power);

  xiuwei = (int)ppl->query_xiuwei_by_type("zonggang");
  power += xiuwei / 2;
  if (detail) {
    printf("  总纲修为：%d", power - temp);
    temp = power;
  }

  switch (usage) {
    case "TYPE_ATTACK":
      if (ppl->query_temp("weapon")) power += 30;
      if (!(skill = ppl->query_temp("attack_skill")))
        if (ppl->query_temp("weapon"))
          skill = "wuqi";
        else
          skill = "kongshou";
      break;

    case "TYPE_DODGE":
      if (!ppl->query_temp("weapon")) power += 30;
      if (!(skill = ppl->query_temp("dodge_skill")))
        skill = "dodge";
      break;

    case "TYPE_PARRY":
      if (ppl->query_temp("weapon")) power += 30;
      if (!(skill = ppl->query_temp("parry_skill")))
        if (ppl->query_temp("weapon"))
          skill = "wuqi";
        else
          skill = "kongshou";
      break;
  }

  if (skill == "kongshou") {
    type = "unarmed";
    skill_dengji = 0;
  } else if (skill == "wuqi") {
    object weapon = ppl->query_temp("weapon");
    type = weapon->query("skill_type");
    skill_dengji = 0;
  } else if (skill == "dodge") {
    type = "dodge";
    skill_dengji = 0;
  } else {
    type = SKILL_D(skill)->query_xiuwei_type();
    skill_dengji = SKILL_D(skill)->query_dengji();
  }

  xiuwei = ppl->query_xiuwei_by_type(type);
  power += xiuwei;
  if (detail) {
    printf("  武功修为：%d", power - temp);
    temp = power;
  }

  skill_lingwu = power_ratio[skill_dengji] * (ppl->query_lingwu(skill) + 1);
  power += skill_lingwu;
  if (detail) {
    printf("  技能水平：%d", power - temp);
    printf("  基本攻击因子：%d\n", power);
  }

  switch (usage) {
    case "TYPE_ATTACK":

      power += ppl->query_str();
      if (attack >= 50)
        power = power * (50 + (attack - 50) * 2) / 50;
      else
        power = power * (10 + attack * 4 / 5) / 50;
      if (intp(ppl->query_temp("apply/attack")))
        power += ppl->query_temp("apply/attack");
      if (detail)
        printf("攻防比影响：%d", power);
      power = power * SKILL_D(skill)->query_youxiao_jibie() / 10;
      if (detail)
        printf("  武功参数影响：%d", power);
      break;

    case "TYPE_DODGE":

      power += ppl->query_dex();
      if (attack > 50)
        power = power * (10 + (100 - attack) * 4 / 5) / 50;
      else
        power = power * (50 + (50 - attack) * 2) / 50;
      if (intp(ppl->query_temp("apply/dodge")))
        power += ppl->query_temp("apply/dodge");
      if (detail)
        printf("攻防比影响：%d", power);
      break;

    case "TYPE_PARRY":

      power += ppl->query_cps();
      if (attack > 50)
        power = power * (10 + (100 - attack) * 4 / 5) / 50;
      else
        power = power * (50 + (50 - attack) * 2) / 50;
      if (intp(ppl->query_temp("apply/parry")))
        power += ppl->query_temp("apply/parry");
      if (detail)
        printf("攻防比影响：%d", power);
      power = power * SKILL_D(skill)->query_parry_ratio() / 10;
      if (detail)
        printf("  武功参数影响：%d", power);
      break;
  }

  power = power * (100 - ppl->query_encumbrance() * 50 / ppl->query_max_encumbrance()) / 100;
  if (detail) {
    printf("  负重影响：%d", power);
  }

  power = power * ppl->query_shili() / 100;
  if (detail)
    printf("  实力比影响：%d\n", power);

  if (power < 4) power = 4;
  if (ppl->is_busy()) power /= 2;
  return power;
}

int help(object me) {
  write(@HELP
指令格式: power [-d] [<调查对象>]
	-d：详细情况
HELP
  );
  return 1;
}
