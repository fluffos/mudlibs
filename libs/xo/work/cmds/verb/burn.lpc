#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  object obj;
  string oname, mat;

  if (!arg)
    return notify_fail("你要点燃什么东西？\n");
  if (objectp(obj = present(arg, me))) {
    if (obj->is_character())
      return notify_fail("活人你也要点呀？开玩笑吧。\n");
    oname = obj->query("name");
    mat = obj->query("material");
    if (obj->query("is_burning"))
      return notify_fail("你手中的" + oname + "已经被点燃了。\n");
    if (mat == "wood") {
      call_out("burn_obj", 1, obj, oname);
      call_out("dest_obj", obj->query_weight(), obj, oname);
      message_vision(HIR "$N点燃一" + obj->query("unit") + oname + "拿在手中。\n" NOR, me);
      return 1;
    }
    if (mat == "paper" || mat == "cloth" || mat == "silk") {
      call_out("burn_obj", 1, obj, oname);
      message_vision(HIR "$N点燃一" + obj->query("unit") + oname + "拿在手中。\n" NOR, me);
      call_out("dest_obj", obj->query_weight() / 10, obj, oname);
      return 1;
    }
    return notify_fail("你无法点燃这个东西。\n");
  }
  if (objectp(obj = present(arg, environment(me)))) {
    if (obj->is_character())
      return notify_fail("活人你也要点呀？开玩笑吧。\n");
    oname = obj->query("long");
    mat = obj->query("material");
    if (obj->query("is_burning"))
      return notify_fail("地上的" + oname + "已经被点燃了。\n");
    if (mat == "wood") {
      call_out("burn_obj", 1, obj, oname);
      call_out("dest_obj", obj->query_weight(), obj, oname);
      message_vision(HIR "$N点燃了地上的一" + obj->query("unit") + oname + "。\n" NOR, me);
      return 1;
    }
    if (mat == "paper" || mat == "cloth" || mat == "silk") {
      call_out("burn_obj", 1, obj, oname);
      message_vision(HIR "$N点燃了地上的一" + obj->query("unit") + oname + "。\n" NOR, me);
      call_out("dest_obj", obj->query_weight() / 10, obj, oname);
      return 1;
    }
    return notify_fail("你无法点燃这个东西。\n");
  }

  return notify_fail("你要点燃什么东西？\n");
}

void burn_obj(object obj, string oname) {
  obj->set("name", "点燃的" + oname);
  obj->set("value", 0);
  obj->set("is_burning", 1);
}

void dest_obj(object obj, string oname) {
  object env = environment(obj);

  if (userp(env))
    message_vision("$N手中的" + oname + "烧完了。\n", env);
  if (env->IsRoom())
    tell_room(env, "地上的" + oname + "烧完了。\n");
  destruct(obj);
}

int help(object me) {
  write(@HELP
指令格式: burn <某物>

这个指令可以让你点燃木制、纸制、布制或丝制的物品。

HELP
  );
  return 1;
}
