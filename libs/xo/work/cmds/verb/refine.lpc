//refine.c.加工
//data:1997.10.23
// by dan

#include <ansi.h>

inherit F_CLEAN_UP;

string *real_name = ({
  "野兔", "泽鹿", "拟绒鼠", "毛猬", "鼯鼠", "穿山甲", "果子狸", "豪猪", "云豹",
});

string *real_id = ({
  "ye tu", "zelu", "nirongshu", "maowei", "wushu", "chuanshanjia", "guozili", "haozhu", "yunbao",
});

int do_refine(object me, object ob);

void create() { seteuid(getuid()); }

int main(object me, string arg) {
  object ob;

  if (!arg) return notify_fail("你要加工什么？\n");

  if (!objectp(ob = present(arg, me)))
    return notify_fail("你身上没有这样东西。\n");

  return do_refine(me, ob);
}

int do_refine(object me, object ob) {
  object obj;
  int i;
  string str, str1, name, id, lon;
  if (!ob->query("refine_name"))
    return notify_fail("这东西好象没法加工啊....\n");
  str = "/d/place/xkdao/npc/obj/";
  str1 = (string)(ob->query("refine_name"));
  str += str1;
  obj = new(str);
  i = ob->query("number");
  if (i != 0) {
    name = real_name[i] + "肉";
    lon = "一块未加工过的" + name;
    id = real_id[i] + " rou";
    obj->set("name", name);
    obj->set("id", id);
    obj->set("number", i);
    obj->set("long", lon);
  }
  obj->move(me);
  if (!ob->query("refine_msg")) {
    message_vision("$N拿起$n开始加工......\n", me, ob);
  } else {
    str = (string)(ob->query("refine_msg"));
    message_vision(str, me, ob);
  }
  destruct(ob);
  return 1;


}

int help(object me) {
  write(@HELP
指令格式：refine <物品名>
 
这个指令让你加工某物品。
 
HELP
  );
  return 1;
}
