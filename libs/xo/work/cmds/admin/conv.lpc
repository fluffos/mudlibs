// convert.c 
// 通过/clone/user/templet来实现玩家数据档案的转换。
// writed by peacock
// 1998.02.10

#include <ansi.h>

inherit F_CLEAN_UP;

int convert( string );

int main(object me, string arg)
{
    mixed *UserDirInfo, *SubDirInfo;
    string UserDirName, SubDirName, FileName;
    int failed = 0;

    UserDirName = "/data/user/";
    UserDirInfo = get_dir( UserDirName, -1 );

    if ( !UserDirInfo )
    {
        write( "这个目录不存在。\n" );
        return 1;
    }

    UserDirInfo = filter( UserDirInfo, function( mixed *item )
                    { return item[1] == -2; } );
                    
    foreach( mixed *Item in UserDirInfo )
    {
        SubDirName = UserDirName + Item[0] + "/";
        printf ( "%s %d %d\n", SubDirName, Item[1], Item[2] );
        SubDirInfo = get_dir( SubDirName, -1 );

        SubDirInfo = filter( SubDirInfo, function( mixed *item )
                    { return item[1] > 0; } );
        foreach( mixed *item in SubDirInfo )
        {
            FileName = SubDirName + item[0];
            printf ( "\t%s\t%d\t%d\n", FileName, item[1], item[2] );
            if ( sscanf( item[0], "%s.o", item[0] ) == 1 )
            {
                if ( !convert( item[0] ) )
                    failed ++;
            }
        }
    }

    if ( failed > 0 )
        printf( "有%d个玩家存档转换失败。详情参见/log/convert\n" );

    return 1;
}

int convert( string target )
{
    object ob;

    ob = load_object( "/clone/user/templet" );
    ob->SetTarget( target );
    ob->restore();

    if ( ob->convert() )
    {
        ob->save();
        destruct( ob );
        return 1;
    }
    else
    {
        printf( "user %s's document convert failed..." );
        destruct( ob );
        return 0;
    }
}

int help(object me)
{
     write(@HELP
指令格式: test
HELP
    );
    return 1;
}
