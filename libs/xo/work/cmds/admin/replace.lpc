// replace.c

inherit F_CLEAN_UP;

int main(object me, string arg)
{
    string *files, content;
    int i;

    //return 0;    
    files = get_dir( arg );
    //printf( "%O\n", files );
    for ( i = 0; i < sizeof( files ); i++ )
    {
        content = read_file( arg + files[ i ] );
        if ( stringp( content ) )
        {
            printf( "Processing %s...\n", arg + files[ i ] );
            content = replace_string( content, "$A", "$N" );
            content = replace_string( content, "$D", "$n" );
            content = replace_string( content, "$W", "$w" );
            content = replace_string( content, "$V", "$v" );
            content = replace_string( content, "$L", "$l" );
            write_file( arg + files[ i ], content, 1 );
        }
    }

	return 1;
}

int help(object me)
{
  write(@HELP
指令格式 : home

利用此一指令可直接回到自己的工作室。
如果你有 'msg_home' 这个设定, 则在场的人都会看到那个讯息.
HELP
    );
    return 1;
}
