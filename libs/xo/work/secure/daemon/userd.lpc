#define MIN_HM_POINT 6500
inherit F_SAVE;
// problem: should be private :(( but my mudos's wrong ...kick
string *avatars;
string *hms;

private void create() {
  seteuid(ROOT_UID);
  restore();
  if (!pointerp(avatars)) {
    hms = ({});
    avatars = ({});
  }
}

int is_avatar(mixed ob) {
  if (objectp(ob))
    ob = geteuid(ob);
  if (!ob || !stringp(ob))
    return 0;
  if (!sizeof(avatars))
    return 0;
  return member_array(ob, avatars) != -1;
}

string *get_avatars() {
  return avatars;
}

string *get_high_mortals() {
  return hms;
}

void CheckUserLevel(object ob) {
  int x;
  string *known = ({ "sword", "blade", "unarmed", "dodge", "short", "whip", "long", "zonggang" });
  mapping xiuwei = ob->query_xiuwei_map();
  x = 0;

  if (wizardp(ob))
    return;

  if (sizeof(xiuwei))
    foreach (string type, int num in xiuwei)
      if (member_array(type, known) != -1)
        x += num * num;
  x = sqrt(x);
  x += ob->query("max_force") / 1.2;
  x += ob->query("combat_exp") / 500;
  if (x > MIN_HM_POINT && ob->query("PKS") < 10
    && ob->query("betrayer") < 5
    && !ob->query("high_mortal")) {    // this is a high mortal lah..
    ob->set("high_mortal", 1);
    hms += ({ geteuid(ob) });
    message("vision", "恭喜！由于你的勤学苦练，从今天起，你就是高级玩家啦！\n", ob);
    save();
  } else if ((x <= MIN_HM_POINT || ob->query("PKS") >= 10 || ob->query("betrayer") >= 5)
    && (ob->query("high_mortal"))) {
    hms -= ({ geteuid(ob) });
    message("vision", "很抱歉，由于你的懒惰或恶行，从今天开始，你降为普通玩家。\n", ob);
    save();
  }
}

string query_save_file() {
  return DATA_DIR "dameon/userd";
}

// should this be open to any program? possible no...
string add_avatar(string who) {
  // add security control here :)
  avatars += ({ who });
  save();
}

int remove() {
  save();
  return 1;
}
