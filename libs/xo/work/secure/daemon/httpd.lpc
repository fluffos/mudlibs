#include "httpd.h"

private void create()
{
    seteuid("nobody");
    log_file("static/httpd", "connection created at " + ctime(time()) + "\n");
    // for security...
}

// figures out what is being requested, and how to get there
private nomask string convert_to_actual_path (string path)
{
    string file;
    if (path == "/")
        return HTTP_ROOT + "/" + DEFAULT_PAGE;
    if (path[<1] == '/')
        path = path[0..<2];
    //if (path[<2] == ".lpc")    /* this is ugly, but works for now */
        /*file = SECURE_CGI_DIR + "/" + explode (path, "/")[<1];
    else
    {*/
    if (path[1] == '~')
    {
        string user;
        if (sscanf (path[2..], "%s/%s", user, file) == 2)
        file = WIZ_DIR + "/" + user + HTTP_USER_HOME + "/" + file;
        else
        file = WIZ_DIR + "/" + path[2..] + HTTP_USER_HOME;
    }
    else
        file = HTTP_ROOT + path;
    //}
    /* if its a dir, so we want the default page */
    if (file_size (file) == -2)
        (file[<1] == '/') ? file += DEFAULT_PAGE : file += "/" + DEFAULT_PAGE;
    return file;
}

private string content_type(string file)
{
    if ( strlen(file) < 5 )
        return "text/plain";
    if ( file [ strlen(file)-5 ] == '.' )
    switch (file[<4..])
    {
        case "html":
            return "text/html";
        case "jpeg":
            return "image/jpeg";
        default:
            return "text/plain";
    }
    else if ( file [ strlen(file) - 4 ] == '.' )
    switch ( file [<3..] )
    {
        case "htm":
            return "text/html";
        case "gif":
            return "image/gif";
        case "jpg":
            return "image/jpeg";
        default:
            return "text/plain";
    }
    return "text/unknown";
}

nomask string process_input (buffer data)
{
    string file, args, request;

    // initial connect
    request = read_buffer (data);
    if (!request)
        return "";

    // We arent doing anything with the HTTP version  
    if (sscanf (request, "GET %s %*s", file) != 2)
        return "";
    log_file ("static/httpd", "Processing Request : Get " + file + "\n");
    sscanf (file, "%s?%s", file, args);
    file = convert_to_actual_path (file);
    if (file_size (file) < 1)
    {
        receive ("HTTP/1.1 404 Not Found\n\n");
        receive (read_file(NOT_FOUND_PAGE));
    }
    else if (file[<2..] == ".lpc")    // assume this is a cgi-bin :)
    {
        string result, err;
        mapping arg;
        // convert the args to mapping...
        // this should in another routine :)
        string * temp = explode(args, "&") - ({ });
        if ( sizeof( temp ) )
        {
            arg = allocate_mapping(1);
            foreach( string t in temp )
            {
                string * x = explode(t,"=");
                if ( sizeof(x) >= 2 )
                    arg[x[0]] = x[1];
            }
        }
        if ( sizeof( arg ) ) //bug: if the speical char in the keys...
        {
            arg = map(arg, (: replace_string($2, "+", " ") :) );
            arg = map(arg, (: replace_string($2, "%26", "&") :) );
            arg = map(arg, (: replace_string($2, "%2B", "+") :) );
            arg = map(arg, (: replace_string($2, "%3D", "=") :) );
            arg = map(arg, (: replace_string($2, "%25", "%") :) );
        }

        log_file("static/httpd", sprintf("arg: %O",arg));
        err = catch (result = file->main (arg));

        if (!result)
            result = "<title>ERROR</title><h1>Error in gateway</h1>" + err;
        while ( strlen(result) > 8192 )// max printable string 的问题
        {
            receive(result[0..8191]);
            result = result[8192..];
        }
        receive (result + "\n");
    }
    else
    {
        int curr = 0;
    	int size = file_size(file);
        string tm=ctime(stat(file)[1]);
        receive("HTTP/1.1 200 OK\n");
        receive("Server: XO mud server.\n");
        receive(sprintf("Date: %s GMT\nLast Modified: %s GMT\n",ctime(time()),tm));
        receive("Content-length: " + size + "\n");
        receive( sprintf("Content-type: %s\n\n", content_type(file) ));
        if ( size > MAX_BYTE_TRANSFER )
        {
            while( curr < size ) // 10000
            {
                receive( read_buffer(file,curr,MAX_BYTE_TRANSFER) );
                curr += MAX_BYTE_TRANSFER;
            }
            curr -= MAX_BYTE_TRANSFER;
        }
        receive (read_buffer(file,curr,size-curr));
    }

    destruct (this_object ());
}
