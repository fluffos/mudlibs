 * from XO lib I
 * daemon handle add_action
 * created by Trill 19970827
 * version : 1.0
 * last modified : 97/08/27
 */

void add_action(string func, mixed verb)
{
    object ob, env;

    ob = previous_object();
    env = environment(ob);
    ob->GiveAction(verb,func);
    foreach(object tmp in all_inventory(ob))
        tmp->AddAction(verb, ob, func);
    if (env)
        foreach(object tmp in all_inventory(env) + ({ env }))
            tmp->AddAction(verb, ob, func);
}
