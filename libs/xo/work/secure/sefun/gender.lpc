string gender_pronoun(string subject)
{
    switch (objectp(subject) ? subject->query("gender") : subject)
    {
    case "deity":
        return "??";

    case "男性":
        return "他";

    case "女性":
        return "她";

    case "male-animal":
    case "female-animal":
        return "它";

    default:
        return "它";
    }
}
