int new_random()
{
    float base, u1, u2, n, N;

    N = -0.1;
    while (N < 0)
    {
        base = random(9999) + 1;
        u1 = base / 10000;
        base = random(9999) + 1;
        u2 = base / 10000;
        n = sqrt(-2 * log(u1)) * cos(2 * 3.1415 * u2);
        N = n * 4.7 + 10.5;
    }
    return to_int(N);
}

int sign(int i)
{
    if (i > 0)
    {
        i = 1;
    }
    else if (i < 0)
    {
        i = -1;
    }
    return i;
}

int NOT(int i)
{
    return (4294967295 ^ i);
}
