// baobei_zhu
// 宝贝猪
inherit ZUOJI;

#include <ansi.h>

void create()
{
    set_name(HIM"宝贝猪"NOR, ({"baobei zhu", "zhu", "pig", }) );
    zuoji::create();
    set("long", "这是一只非常可爱的"+HIM"宝贝猪"NOR+"，小巧玲珑，人见人爱！\n");
    set("race", "野兽");
    set("gender", "雌性");
    set("attitude", "friendly");
    set("unit", "只");
    setup();
}

void init()
{
        add_action("do_ken","ken");
        add_action("do_hi","hiall");
}

int do_hi(string arg)
{
        object* who;
        int i;
        who=all_inventory(environment(this_object()));
        for(i=0;i<sizeof(who);i++)
        {
                if(userp(who[i]) && living(who[i]))
                tell_object(who[i],
HIM"宝贝猪"NOR+"不知道从哪里掏出了一个小喇叭，对着你叫道：\n"+
who[i]->query("name")+"，"+who[i]->query("name")+
"，我是"+HIM"宝贝猪"NOR+"，我是"+HIM"宝贝猪"NOR+"，听到了请回答！\n");
        }
        return 1;
}
int do_ken(string arg)
{
        object ob,me;
                me=this_player();
        ob = present( arg, environment(me) );
        if( !objectp( ob ))
            return notify_fail("没有这个人耶！\n");
        if( ob->query("id")=="xli")
            return notify_fail("宝贝猪怎么可能咬自己的主人呢？*_^\n");
        if( ob->query("id")=="baobei zhu" )
            return notify_fail("搞没搞错啊，自己怎么能咬自己呢？\n");
        message_vision("$N指着"+ob->query("name")+"，轻轻一拍宝贝猪...\n",me);
        message_vision("只见宝贝猪宛然一笑，跳上前去，冲着$N的鼻子就是一口...\n",ob);
        message_vision("哇~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\n",ob);
        message_vision("宝贝猪哼道：叫你记得我宝贝猪，嘿嘿！\n",ob);
        return 1;
}       
