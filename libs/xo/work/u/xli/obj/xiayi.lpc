//xiayi.c  五彩霞衣
#include <armor.h>
#include <ansi.h>

inherit SKIRT;
inherit F_SAVE;
inherit F_AUTOLOAD;

void create() {
  set_name(HIR "五彩霞衣" NOR, ({ "wucai xiayi", "xiayi", "skirt" }));
  set("long", "一件五彩斑斓的" HIR "霞衣" NOR "，真丝织就，上面点缀着无数凤凰的羽毛。\n"
    "羽毛中间杂着许多很小的珍珠，闪烁出颜色各异的" HIY "光芒" NOR "。\n");
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 20000);
    set("cant_sell", "这件衣服是宝物，怎么能随便卖呢？\n");
    set("material", "silk");
    set("armor_prop/armor", 10000);
  }
  setup();
}

void init() {
  add_action("do_full", "ful");
  add_action("do_xlihome", "xlihome");
}

int do_xlihome(string arg) {
  object who;
  who = this_player();
  if (!who
    || (who->query("id") != "rft" && who->query("id") != "xli")
  )
    return notify_fail("什么，你想干什么？\n");
  tell_object(who, "一团祥云渐渐包围了你，你只觉身体轻飘飘的......\n");
  tell_object(who, "不一会，你就来到了宝宝贝贝的私人小屋。\n");
  who->move("/u/xli/workroom");
  return 1;
}

int do_full(string arg)          //补满精气神等
{
  object who;
  who = this_player();
  if (!who
    || (who->query("id") != "rft" && who->query("id") != "xli")
  )
    return notify_fail("什么，你想干什么？\n");
  who->set("gin", who->query("max_gin"));
  who->set("eff_gin", who->query("max_gin"));
  who->set("kee", who->query("max_kee"));
  who->set("eff_kee", who->query("max_kee"));
  who->set("sen", who->query("max_sen"));
  who->set("eff_sen", who->query("max_sen"));
  who->set("food", who->max_food_capacity());
  who->set("water", who->max_water_capacity());
  who->set("force", who->query("max_force"));
  tell_object(this_player(), "OK！\n");
  return 1;
}

int query_autoload() {
  if (!this_player()
    || (this_player()->query("id") != "rft" && this_player()->query("id") != "xli")
  ) return 0;
  return 1;
}

int IsAutoLoad() { return 1; }
