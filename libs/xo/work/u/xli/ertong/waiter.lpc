// waiter.c 店小二  发礼物的
// by xli
// 1999.5.31

#include <ansi.h>

inherit NPC;
string *gift_id = ({
  __DIR__ "lemon",   // 加修为的柠檬
  __DIR__ "kele",    // 加内力的可乐
  __DIR__ "hongniu",  // 加容貌、膂力的红牛
  __DIR__ "baozi"    // 加天赋的包子
});

object GetGift();
int do_giveit(object);

void create() {
  set_name(YEL "店小二" NOR, ({ "waiter" }));
  set("gender", "男性");
  set("age", 18);
  set("title", "发礼物的"),
    set("long", "他是一个年轻的小伙子，正忙着给大家分发礼物呢。\n");

  set("per", 30);

  set("chat_chance", 30);
  set("chat_msg", ({
    YEL "店小二" NOR + "说道：好忙啊，人家过儿童节等着拿礼物，我过儿童节到处发礼物！”\n",
    (: random_move :),
  }));
  setup();
  call_out("do_giveit", 20, this_object());  // 20秒送一次
  call_out("do_destruct", 3600, this_object());  // 送一个小时
}

void init() {
  add_action("do_all", ({ "kill", "sha", "fight", "bihua", "duilian", "follow" }));
}


object GetGift() {
  int i;
  object gift;
  i = random(200);
  if (i > 100)
    gift = new(gift_id[3]);
  else if (i > 50)
    gift = new(gift_id[2]);
  else if (i > 20)
    gift = new(gift_id[1]);
  else
    gift = new(gift_id[0]);
  return gift;
}

int do_giveit(object thisman) {
  object *things;
  object gift;
  int i;

  things = all_inventory(environment(thisman));
  for (i = 0; i < sizeof(things); i++) {
    if (userp(things[i]) && living(things[i])) {
      if (things[i]->query("age") < 18) {

        command("tell " + things[i]->query("id") + " 小朋友，节日快乐哦！来来来，这是给你的礼物！");
        gift = GetGift();
        gift->move(things[i]);
        command("tell " + things[i]->query("id") + " 这是一" + gift->query("unit") + gift->query("name") + "，拿好了哦！");
      } else if (random(4) == 1) {
        command("tell " + things[i]->query("id") + " 来，小孩子的节日，我们也来凑个热闹！");
        gift = GetGift();
        gift->move(things[i]);
        command("tell " + things[i]->query("id") + " 这是一" + gift->query("unit") + gift->query("name") + "，拿好了哦！");
      }
    }

  }
  call_out("do_giveit", 20, thisman);
  return 1;
}

int do_all(string arg) {
  if (!arg || arg != "waiter")
    return 0;
  tell_object(this_player(), YEL "店小二" NOR + "冲你嚷到：没看见我很忙么，不要给我捣乱！\n");
  return 1;
}

void do_destruct(object thisman) {
  destruct(thisman);
}
