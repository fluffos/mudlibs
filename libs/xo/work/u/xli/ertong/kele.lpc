// kele.c 可乐 有一定几率涨内力
#include <ansi.h>
inherit ITEM;
inherit F_LIQUID;
void create()
{
    set_name(HIC"可乐"NOR, ({"cola"}));
    set_weight(100);
    if (clonep())
        set_default_object(__FILE__);
    else 
    {
        set("long", "一瓶可乐，气泡充足，一看就很解渴。\n");
        set("unit", "瓶");
        set("value",10);
        set("kele_remaining", 8); // 可以喝8口
    }
    setup();
}

void init()
{
    add_action( "di_drink", ({"drink","he"}) );
}


int di_drink(string arg)
{
    int now_neili,add_neili;
    object me=this_player();
    
    if( !arg || arg!="cola" )
    	return notify_fail("你要喝什么啊？\n");
	if( me->query("water") >= me->max_water_capacity() )
	    return notify_fail("你已经喝的太多了，一滴可乐都喝不下去了。\n");
    if( query("kele_remaining")==1 )
    {
    	tell_object(me,"你把剩下的"+HIC"可乐"NOR+"一饮而尽。\n");
    	destruct(this_object());
    }
    else
    {
    	tell_object(me,"你拿起"+HIC"可乐"NOR+"咕嘟咕嘟喝了一口。\n"); 
    	add("kele_remaining",-1);
    }
    me->add("water",30);
    if( random(15)!=1 )
	    return 1;
	now_neili=me->query("max_force");
	add_neili=20-random(me->query("age")/5+sqrt(now_neili));
	if( add_neili < 5 )
	    add_neili=5;
	me->set("max_force",now_neili+add_neili);
	me->set("force",now_neili+2*add_neili);
	tell_object(me,"你感觉精神倍爽，内息也颇为通畅，似乎有所增益。\n");
    return 1; 
}


/*
你拿起可口可乐咕噜噜地喝了几口可口可乐。
可口可乐已经被喝得一滴也不剩了
*/