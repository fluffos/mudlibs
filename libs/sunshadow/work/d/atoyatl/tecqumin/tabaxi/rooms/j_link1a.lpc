#include <std.h>
#include <terrain.h>
#include "../../tecqumin.h"
inherit J_MAZE;

void create() {
  ::create();
  set_exits( ([ "south" : JUNG_ROOM + "j_link1", ]) );
}
void init(){
  object mazeroom, builder;
  mapping mazes;
  string *exits, *saved_exits, file;
  ::init();
  mazeroom = find_object_or_load(JUNG_ROOM + "j_maze0.lpc");
  exits = mazeroom->query_exits();
  if (sizeof(query_exits())<2){
    BUILDER->restore_exits(TO);
  }
  file = file_name(TO);
  mazes = BUILDER->query_saved_mazes();
  saved_exits = mazes[file];
  if (sizeof(exits)<1 && sizeof(saved_exits)<1){
    "/d/atoyatl/maze_d.lpc"->set_roompath(JUNG_ROOM + "j_maze");
    "/d/atoyatl/maze_d.lpc"->set_southroom(WEMIC + "path14.lpc");
    "/d/atoyatl/maze_d.lpc"->set_northroom(JUNG_ROOM + "j_link1.lpc");
    "/d/atoyatl/maze_d.lpc"->set_eastroom(JUNG_ROOM + "j_link8a.lpc");  
    "/d/atoyatl/maze_d.lpc"->set_special_rooms( ({JUNG_ROOM + "jung_clearing.lpc", JUNG_ROOM 
                                                  + "jung_waterhole"}) );
    "/d/atoyatl/maze_d.lpc"->init_maze(5, 5, JUNG_ROOM + "j_maze", 30);
  }    
  set_had_players(3);
}