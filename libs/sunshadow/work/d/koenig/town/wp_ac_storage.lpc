#include <std.h>
inherit ROOM;

void create() {
  ::create();
   set_property("no teleport",1);
  set_properties( (["light":1, "indoors":1]) );
  set_short("A storage room for the weapons and armour shop.");
  set_long("Supplies are stored here for the shop.");
  set_exits( (["east" : "/d/koenig/town/store2.lpc"]) );
}
void reset() {
  ::reset();
if (!present("bastard",this_object())) {
  new("/d/common/obj/weapon/bastard.lpc")->move(this_object());
  new("/d/common/obj/weapon/bastard.lpc")->move(this_object());
}

if (!present("broad",this_object())) {
  new("/d/common/obj/weapon/broad.lpc")->move(this_object());
  new("/d/common/obj/weapon/broad.lpc")->move(this_object());
}

if (!present("dagger",this_object())) {
  new("/d/common/obj/weapon/dagger.lpc")->move(this_object());
  new("/d/common/obj/weapon/dagger.lpc")->move(this_object());
}
if (!present("axe",this_object()))
  new("/d/common/obj/weapon/battle_axe.lpc")->move(this_object());

if (!present("mace",this_object()))
  new("/d/common/obj/weapon/mace.lpc")->move(this_object());

if (!present("staff",this_object()))
  new("/d/common/obj/weapon/quarter_staff.lpc")->move(this_object());

if (!present("banded",this_object()))
  new("/d/common/obj/armour/banded.lpc")->move(this_object());

if (!present("chain",this_object())) {
  new("/d/common/obj/armour/chain.lpc")->move(this_object());
  new("/d/common/obj/armour/chain.lpc")->move(this_object());
}

if (!present("field",this_object())) {
  new("/d/common/obj/armour/field.lpc")->move(this_object());
  new("/d/common/obj/armour/field.lpc")->move(this_object());
}

if (!present("robe",this_object())) {
  new("/d/common/obj/armour/robe.lpc")->move(this_object());
  new("/d/common/obj/armour/robe.lpc")->move(this_object());
}

if (!present("shield",this_object())) {
  new("/d/common/obj/armour/mshield.lpc")->move(this_object());
  new("/d/common/obj/armour/mshield.lpc")->move(this_object());
}

if (!present("buckler",this_object())) 
  new("/d/common/obj/armour/buckler.lpc")->move(this_object());

if (!present("helm",this_object())) {
  new("/d/common/obj/armour/helm.lpc")->move(this_object());
  new("/d/common/obj/armour/helm.lpc")->move(this_object());
}

}
