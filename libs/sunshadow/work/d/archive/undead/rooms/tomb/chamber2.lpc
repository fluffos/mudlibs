#include <std.h>
#include "../../undead.h"

inherit INH+"tomb_five.lpc";

void create() 
{
    ::create();

    set_exits(([
        "east"      :HALL+"hall9"
             ]));

}

void reset() 
{
    ::reset();

    if(!present("ghoul"))
    {
        {
          object new_ob = new(MON"ghoul");
          if (new_ob) new_ob->move(TO);
        }
        {
          object new_ob = new(MON"ghoul");
          if (new_ob) new_ob->move(TO);
        }
    }
}
