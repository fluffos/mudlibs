#include "../../undead.h"

inherit INH+"forest_one.lpc";

void create() 
{
    ::create();

    set_exits(([
        "south"     :PATH+"room47"
             ]));

}


void reset()
{
  ::reset();
    if(!present("sister"))
    {
    {
      object new_ob = new(MON"sister_of_fate1");
      if (new_ob) new_ob->move(TO);
    }
    {
      object new_ob = new(MON"sister_of_fate2");
      if (new_ob) new_ob->move(TO);
    }
    {
      object new_ob = new(MON"sister_of_fate3");
      if (new_ob) new_ob->move(TO);
    }
    }
}
