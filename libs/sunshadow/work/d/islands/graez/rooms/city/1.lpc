#include <std.h>
#include "../../graez.h"

inherit STORAGE"street.lpc";



void create(){
   ::create();
   set_long(::query_long()+"%^C058%^\nTo the south is a sprawling deep harbor dock.%^CRST%^\n");


set_exits(([
"east" : TOWN"2",
"south" : "/d/shadow/virtual/sea/undead.dock",
"north" : TOWN"4",
"west" : TOWN"3",

]));

}

void reset(){
   ::reset();
   if(!present("ambiance device")){
      new(MOBS"harbor_ambiance.lpc")->move(TO);
   }
}

