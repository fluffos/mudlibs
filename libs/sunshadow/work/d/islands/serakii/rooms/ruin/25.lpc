#include <std.h>
#include "../../serakii.h"

inherit STORAGE"ruins.lpc";

void create(){
   ::create();


   set_exits(([


          "east" : RUINS"13",
          "north" : RUINS"26"

   ]));

}

void reset(){
   ::reset();
   if(!present("font")){
      new(OBJ"font.lpc")->move(TO);
   }
   if(!present("spirit_of_the_shrine")){
      new(MOBS"shrine_spirit.lpc")->move(TO);
   }
}