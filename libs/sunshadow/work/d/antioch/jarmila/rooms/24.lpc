
#include <std.h>
#include "../jarmila.h"
inherit STORAGE"hill.lpc";

void create(){
   ::create();
   set_exits(([
      "east" : ROOMS"23",
      "southwest" : ROOMS"25",
   ]));
}

void reset(){
   ::reset();
   if(!present("chunk of sunstone")){
      new(OBJ"sunstone.lpc")->move(TO);
   }
}



