#include <std.h>
#include "../jarmila.h"
inherit STORAGE"hill.lpc";

void create(){
   ::create();
   set_exits(([
      "northwest" : ROOMS"14",
      "northeast" : ROOMS"16",

   ]));
}

void reset(){
   ::reset();
   if(!present("chunk of sunstone")){
      new(OBJ"sunstone.lpc")->move(TO);
   }
}

