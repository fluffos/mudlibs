// /d/magic/symbols/shar_symbol.c
// Museum §6.15: archive never shipped Shar's holy symbol; same thin
// deity wrapper every other *_symbol.lpc in this directory uses.

#include <std.h>

inherit "/d/magic/symbols/holy_symbol.lpc";

void create(){
   ::create();
   set_id(({"holy symbol","symbol","shar_holy_symbol","medallion","amethyst medallion"}));
   set_name("holy symbol");
   set_short("holy symbol");
   set_long("This is a holy symbol.");
}

void init(){
   ::init();
   set_name("amethyst medallion");
   set_short("%^BOLD%^%^BLACK%^amethyst medallion%^RESET%^");
   set_long("%^BOLD%^%^BLACK%^This medallion is a disk of polished onyx ringed in %^RESET%^%^MAGENTA%^amethyst%^BOLD%^%^BLACK%^. The face bears a circle of %^RESET%^%^MAGENTA%^purple flame%^BOLD%^%^BLACK%^ around a deeper void — the sign of Shar, Lady of Loss.%^RESET%^");
}
