#include <std.h>

inherit DAEMON;

int cmd_dummy() 
{
    tell_object(TP,"%^RED%^Creating Test Dummy.%^RESET%^");
    tell_room(ETP,"%^RED%^"+TP->QCN+" snaps "+TP->QP+" fingers "
        "and a test dummy appears.%^RESET%^",TP);
    {
      object new_ob = new("/realms/ares/testdummy");
      if (new_ob) new_ob->move(ETP);
    }
    return 1;
}
