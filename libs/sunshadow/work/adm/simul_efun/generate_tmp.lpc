//      /adm/simul_efun/generate_tmp.lpc
//      Generates a unique scratch filename under DIR_TMP.
//      Not present anywhere in the shipped archive -- wrap.lpc's
//      long-string-truncation branch (a rarely-hit >7900-char path) is the
//      only caller and would otherwise leave the whole simul_efun object
//      uncompilable ("Undefined function generate_tmp"), which blocks the
//      entire mudlib from booting. Added for FluffOS-compat porting; see
//      NOTES.md.

#include <dirs.h>

string generate_tmp()
{
    return DIR_TMP + "/wrap_" + time() + "_" + random(1000000);
}
