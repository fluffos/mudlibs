#include <std.h>

string *msg_buffer;

void force_me(string cmd)
{
    command(cmd);
}

void receive_message(string msg_class, string msg)
{
    msg_buffer += ({msg});
}

void clear_buffer()
{
    msg_buffer = ({});
}

string *query_buffer()
{
    return msg_buffer;
}

void remove()
{
    destruct(TO);
}
