inherit "std/npc";

void create()   {
  ::create();
  set_name("bob");
  set_short("Bob");
  set_id(({"bob","Bob"}));
  set_long("This is bob");
  set_level(10);
  set("race","human");
  set_gender("male");
  set_body_type("dragon");
  // set_base_topic("nothin"); -- set_base_topic() was never implemented
  // anywhere in this archive; this is dead example/test content (unused
  // "bob" NPC, not referenced from anywhere else), so the call is
  // commented out rather than inventing a function to satisfy it.
}
