###############################################################################
#              Customizable runtime config file for MudOS v22                 #
###############################################################################

# name of this mud
name : SunderingShadows

# port number to accept users on
port number : 40232

# absolute pathname of mudlib
mudlib directory : /home/sunyc/src/mudlib/libs/sunshadow/work

# debug.log and author/domain stats are stored here
log directory : /log

# the directories which are searched by #include <...>. Original
# fluffos.cfg.example said "/adm/include:/include" (first entry wins).
include directories : /adm/include:/include

# The global include file is included automatically before every compile.
global include file : "/adm/include/std.h"

# Directory to save binaries in.  (if BINARIES is defined)
save binaries directory : /binaries

# the file which defines the master object
master file : /adm/obj/master

# the file where all global simulated efuns are defined.
simulated efun file : /adm/obj/simul_efun

# alternate debug.log file name (assumed to be in specified 'log directory')
debug log file : debug.log

time to clean up : 1200
time to swap : 600
time to reset : 800
maximum bits in a bitfield : 12000
maximum local variables : 128
maximum evaluation cost : 10000000
maximum array size : 15000
maximum buffer size : 400000
maximum mapping size : 150000
inherit chain size : 40
maximum string length : 200000
maximum read file size : 200000
maximum byte transfer : 200000
hash table size : 7001
object table size : 8000
default fail message : Why?
default error message : Error: you should probably contact a dev.

maximum users : 110
evaluator stack size : 9000
compiler stack size : 600
maximum call depth : 256
living hash table size : 256
