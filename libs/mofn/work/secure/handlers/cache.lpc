// helps out with scheduled cache clearing
inherit HANDLER_BASE;

#include <driver.h>

object *have_cache = ({ });

void register_object() {
  object ob = PO;

  if(member_array(ob, have_cache) == -1)
    have_cache += ({ ob });
  if(find_call_out("walk_cache") == -1)
    call_out("walk_cache", 30, 0);
}

object *query_caching() {
  return have_cache;
}

void walk_cache(int n) {
  int s;
  have_cache -= ({ 0 });
  s = sizeof(have_cache);
  if(n >= 0 && n < s) {
    if(objectp(have_cache[n]))
      have_cache[n] -> clear_cache();
    n++;
  }
  if(n >= s) n = 0;
  if(s == 0) s = 1;
  if(s > 20) s = 20;
  call_out("walk_cache", 600 / s, n);
}

void clear_cache() {
  have_cache -= ({ 0 });
  if(PO == TO || origin() == ORIGIN_LOCAL)
    have_cache -> clear_cache();
}
