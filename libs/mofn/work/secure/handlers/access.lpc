#include <access.h>
#include <driver.h>

inherit HANDLER_BASE;

// we need to be able to assign permissions to groups
// we need to also be able to deny permissions

// we could put these into a dbm file -- would allow proftpd and
// mod_perl to use them for web/ftp access to file system
// dbm files are changing to mysql databases...
// maps perm type to filename

// permissions table:
//   id   char(255),
//   allowed int,
//   disallowed int,
//   type char(16),
//   path char(255)
//   primary index: type-path-id
//   secondary index: id-type-path

string *t_already_seen;
mapping cache;
mapping qp_cache;

void create() {
  cache = ([ ]);
  qp_cache = ([ ]);
  t_already_seen = ({ });
  CACHE_H -> register_object();
  ::create();
}

mapping query_perms(string type, string path) {
  int i;
  mixed rows;
  mixed *res;
  mapping ret;

  if(undefinedp(cache[type+":"+path])) {
    rows = DB_H -> exec("SELECT id,allowed,disallowed FROM permissions WHERE type=\"" + DB_H -> escape(type) + "\" AND path=\"" + DB_H -> escape(path) + "\"");

    if(!rows)
      return ([ ]);

    if(stringp(rows)) {
      return ([ ]);
    }

    ret = ([ ]);

    for(i = 1; i <= rows; i++) {
      res = DB_H -> fetch(i);
      if(arrayp(res) && sizeof(res) == 3) 
        ret[res[0]] = ({ res[1], res[2] });
    }
    cache[type+":"+path] = ret;
  }
  return cache[type+":"+path];
}

int *_query_permissions(string id, string type, string path, mapping perms);

varargs int query_permissions(mixed ob, string type, string path) {
  string id, t, *bits;
  int *p, ret, i, found;
  mapping perms;

  found = 0;
  if(objectp(ob)) {
    if(interactive(ob)) {
      id = ob -> query_name();
    } else {
      id = base_name(ob);
    }
  } else {
    id = ob;
  }

  if(!undefinedp(qp_cache[id+":"+type+":"+path]))
    return qp_cache[id+":"+type+":"+path];
  bits = ({ "" }) + explode(path, "/");
  for(i = 0; i < sizeof(bits); i++) {
    t = implode(bits[0..i], "/");
    if(sizeof(t) == 0 || t[0] != '/')
      t = "/" + t;
    t_already_seen = ({ });
    perms = query_perms(type, t);
    p = _query_permissions(id, type, t, perms);
    if(arrayp(p)) {
      ret &= ~p[1];
      ret |= p[0];
      qp_cache[id+":"+type+":"+t] = ret;
      found = 1;
    }
  }

  if(0 && TP)
    TP -> receive_message("debug",
         sprintf("query_permissions(%s,%s,%s) => (%d,%d)\n",
             id, type, path, found, ret));

  return found ? ret : -1;
}

int *_query_permissions(string id, string type, string path, mapping perms) {
  string *groups, group;
  string *bits;
  int allowed, disallowed, found, *p;

  if(member_array(id, t_already_seen) != -1)
    return 0;
  t_already_seen += ({ id });

  groups = GROUPS_H -> query_groups(id);

  allowed = 0;
  disallowed = 0;
  found = 0;
      
  // now figure out what is allowed and disallowed...
  // start with groups first
  foreach(group in groups) {
    if(!undefinedp(perms["group:" + group])) {
      p = _query_permissions("group:" + group, type, path, perms);
      allowed |= p[0];
      disallowed |= p[1];
      found = 1;
    }
  }
  if(!undefinedp(perms[id])) {
      allowed = allowed & ~(disallowed|perms[id][1]) | perms[id][0];
      disallowed = disallowed & ~(allowed|perms[id][0]) | perms[id][1];
      found = 1;
  }

  return found ? ({ allowed, disallowed }) : 0;
}

varargs int has_permission(mixed ob, string type, string path, int p) {
  int t;
  t = query_permissions(ob, type, path);
  if(t == -1) return 0;
  return((t & p) == p);
  //return((query_permissions(ob, type, path) & p) == p);
}

int query_guarded_access(string type, string path, int p) {
  object *obs = previous_object(-1);
  object ob;
  int access, t;

  access = -1;
  foreach(ob in obs) {
    t = query_permissions(ob, type, path);
    if(t != -1)
      access &= t; // query_permissions(ob, type, path, p);
  }
  if(access == -1)
    access = query_permissions("group:EVERYTHING", type, path);
  return access == -1 ? 0 : access;
}

int has_guarded_access(string type, string path, int p) {
  return((query_guarded_access(type, path, p) & p) == p);
}

// need to be able to add and subtract permissions...
// difference between disallowing and removing
int modify_permissions(string id, string type, string path, 
                       int allowed_a, int allowed_o, 
                       int disallowed_a, int disallowed_o) {
  int e_a, e_d, ep;
  mixed rows, *res;

  // need to be able to specify granting here...
  ep = query_guarded_access(type, path, 0);

  if(!(ep & PERM_GRANT))
    return 0;

  allowed_a &= ~ep;
  allowed_o &= ep;
  disallowed_a &= ~ep;
  disallowed_o &= ep;

  rows = DB_H -> exec( 
           "SELECT allowed,disallowed FROM permissions"
           " WHERE type=\"" + DB_H -> escape(type) + 
           "\" AND path=\"" + DB_H -> escape(path) + 
           "\" AND id=\"" + DB_H -> escape(id) + "\"");
  if(stringp(rows))
    return 0;
  if(rows) {
    res = DB_H -> fetch(1);
    e_a = res[0];
    e_d = res[1];
    if(!(e_a & PERM_GRANT) && (((~allowed_a)&PERM_GRANT) || (allowed_o&PERM_GRANT) || ((~disallowed_a)&PERM_GRANT) || (disallowed_o&PERM_GRANT)) && !(ep&PERM_GRANTGRANT))
      return 0;
    e_a = (e_a & ~allowed_a) | allowed_o;
    e_d = (e_d & ~disallowed_a) | disallowed_o;
    if(e_a == 0 && e_d == 0) {
      if(!stringp(DB_H -> exec( 
        "DELETE FROM permissions WHERE"
        " type=\"" + DB_H -> escape(type) + 
        "\" AND path=\"" + DB_H -> escape(path) + 
        "\" AND id=\"" + DB_H -> escape(id) + "\""))) {
        if(mapp(cache[type + ":" + path]))
          map_delete(cache[type+":"+path], id);
        return 1;
      }
    } else {
    if((((~allowed_a)&PERM_GRANT) || (allowed_o&PERM_GRANT) || ((~disallowed_a)&PERM_GRANT) || (disallowed_o&PERM_GRANT)) && !(ep&PERM_GRANTGRANT))
      return 0;
      if(!stringp(DB_H -> exec( 
        "UPDATE permissions"
        " SET allowed=" + e_a + 
        ", SET disallowed=" + e_d + 
        " WHERE type=\"" + DB_H -> escape(type) + 
        "\" AND path=\"" + DB_H -> escape(path) + 
        "\" AND id=\"" + DB_H -> escape(id) + "\""))) {
        if(mapp(cache[type+":"+path]))
          cache[type+":"+path][id] = ({ e_a, e_d });
        return 1;
      }
    }
  } else if((((~allowed_a)&PERM_GRANT) || (allowed_o&PERM_GRANT) || ((~disallowed_a)&PERM_GRANT) || (disallowed_o&PERM_GRANT)) && !(ep&PERM_GRANTGRANT))
      return 0;
  else if(!stringp(DB_H -> exec( 
    "INSERT INTO permissions (id, type, path, allowed, disallowed)"
    " VALUES (\"" + 
      DB_H -> escape(id) + "\", \"" + 
      DB_H -> escape(type) + "\", \"" + 
      DB_H -> escape(path) + "\", " + 
      allowed_o + ", " + 
      disallowed_o + ")"))) {
    if(mapp(cache[type+":"+path]))
      cache[type+":"+path][id] = ({ allowed_o, disallowed_o });
    return 1;
  }
  return 0;
}

int set_permissions(string id, string type, string path, int allowed, int disallowed) {
  return modify_permissions(id, type, path, -1, allowed, -1, disallowed);
}

int check_password(string, string);

varargs int set_password(string name, string pass, string old) {
  // the following may need to change, but will do for now
  if(!(
      base_name(PO) == PLAYER_OBJ &&
      PO -> query_name() == name  ||
      base_name(PO) == LOGIN_OBJ
    )) 
    return 0;

  if(base_name(PO) != LOGIN_OBJ && !check_password(name, old))
    return 0;

  pass = crypt(pass, 0);

  if(DB_H -> exec(
      "SELECT name FROM users WHERE name=\"" + DB_H ->
escape(name) + "\""))
    return !stringp(DB_H -> exec(
      "UPDATE users"
      " SET password=\"" + DB_H -> escape(pass) + 
      "\" WHERE name=\"" + DB_H -> escape(name) + "\""));
  else
    return !stringp(DB_H -> exec(
      "INSERT INTO users (name, password) VALUES (\"" + 
        DB_H -> escape(name) + "\", \"" + 
        DB_H -> escape(pass) + "\")"));
}

int check_password(string name, string pass) {
  mixed res;

  if(base_name(PO) != LOGIN_OBJ && origin() != ORIGIN_LOCAL)
    return 0;

  res = DB_H -> exec("SELECT password FROM users WHERE name=\"" + DB_H -> escape(name) + "\"");
  if(stringp(res) || res != 1)
    return 0;

  res = DB_H -> fetch(1);

  DB_H -> exec("status"); // clear reference to password stuff

  return res[0] == crypt(pass, res[0]);
}

int remove_user(string name) {
  if(base_name(PO) != LOGIN_OBJ)
    return 0;

  return !stringp(DB_H -> exec("DELETE FROM users WHERE name=\"" + DB_H -> escape(name) + "\""));
}

int query_is_user(string name) {
  mixed res;

  res = DB_H -> exec(
    "SELECT name FROM users WHERE name=\"" + DB_H -> escape(name) + "\"");
    
  if(stringp(res) || res == 0)
    return 0;

  return 1;
}

void clear_cache() {
  if(PO && base_name(PO) != CACHE_H)
    return;

  cache=([ ]);
  qp_cache=([ ]);
}
