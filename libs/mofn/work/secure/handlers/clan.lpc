// liege/clan system

inherit HANDLER_BASE;

#define SAVE_FILE SECURE_DIR SAVE_DIR HANDLER_DIR "/liege"

string *query_liegences(string);

mapping clans, requested;
nosave mapping leader_cache;

#define CLAN_TITLE 0
#define CLAN_URL   1
#define CLAN_HEAD  2

void create() {
  clans = ([ ]);
  requested = ([ ]);

  leader_cache = ([ ]);
  ::create();
}

void load_me() {
  if(unguarded( (: file_size, SAVE_FILE ".o" :) ))
    unguarded((:restore_object,SAVE_FILE:));
}

void save_me() {
  unguarded((:save_object,SAVE_FILE:));
}

string query_clan_leader(string nom) {
  string l, l2;

  if(leader_cache[nom])
    return leader_cache[nom];

  l = nom;
  while((l2 = USER_H -> query_liege(l)) && (l2 != ""))
    l = l2;

  if(l == nom && !sizeof(query_liegences(nom)))
    return "";

  leader_cache[nom] = l;

  return l;
}

int query_clan_level(string nom) {
  string l, l2;
  int lvl;

  if(USER_H -> query_liege(nom) == "")
    return 0; // can't be in a clan

  l = query_clan_leader(nom);

  if(undefinedp(clans[l]))
    return 0; // top player doesn't have a clan
  if(l == nom)
    return 1; // at the top

  l = nom;
  lvl = 1;
  while((l2 = USER_H -> query_liege(l)) && (l2 != "")) {
    lvl++;
    l = l2;
  }
  return lvl;
}

string query_clan_name(string nom) {
  string l;

  l = query_clan_leader(nom);

  if(undefinedp(clans[l]))
    return "None";

  return clans[l][CLAN_TITLE];
}

int set_clan_name(string l, string nom) {
  if(undefinedp(clans[l]))
    return 0;

  clans[l][CLAN_TITLE] = nom;
  call_out("save_me", 0);
  return 1;
}

int set_clan_head(string l, string head) {
  if(undefinedp(clans[l]))
    return 0;

  if(query_clan_leader(head) != l)
    return 0;

  clans[l][CLAN_HEAD] = head;
  return 1;
}

string *query_clan_members(string nom) {
  string l;
  l = query_clan_leader(nom);
  if(clans[l]) {
    return USER_H -> query_liegence_tree(l);
  }
  return ({ });
}


