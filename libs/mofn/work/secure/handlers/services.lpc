#include <network.h>

// from dw-wibble-r8.88

mapping get_services();

inherit HANDLER_BASE;
inherit "/secure/handlers/services/auth";
inherit "/secure/handlers/services/channel";
inherit "/secure/handlers/services/emoteto";
inherit "/secure/handlers/services/error";
inherit "/secure/handlers/services/finger";
inherit "/secure/handlers/services/locate";
inherit "/secure/handlers/services/tell";
inherit "/secure/handlers/services/who";

mapping get_services() {
  return ([
            "http" : PORT_HTTP,
          ])
       + auth::get_services()
       + channel::get_services()
       + emoteto::get_services()
       + error::get_services()
       + finger::get_services()
       + locate::get_services()
       + tell::get_services()
       + who::get_services();
}

void event_shutdown(int secs) {
  if(file_name(PO) != SHUTDOWN_H)
    return;

  IMUD_H -> event_write( ({ "shutdown", 5, mud_name(), 0,
    IMUD_H -> get_nameserver(), 0, secs }) );
}
