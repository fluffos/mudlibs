// handles timed events, such as shutdowns
// kinda like callouts, but saved across mud shutdowns

mixed *queue;

class event {
  mixed  ob;
  string func;
  mixed  *data;
  int    recurring;
  int    next_occurance;
};

private check_queue() {
  class event item;
  int i;

  i = 0;
  while(i < sizeof(queue) && queue[i] -> next_occurance <= time()) {
    call_out("run_item", queue[i]);
    // do we need to reschedule this item now?
    if(queue[i] -> recurring)
      _schedule_item(queue[i]);
    i++
  }
  queue = queue[i..];
  if(sizeof(queue))
    call_out("check_queue", queue[0] -> next_occurance - time());
}

private run_item(class event item) {
  catch(call_other(item->ob, item->func, item->data));
}

private _schedule_item(class event item) {
  // need to look at timing data and figure out when the next schedule is
  // this part removes the already finished occurance
}

private int schedule_item(class event item) {
}

varargs int submit_schedule(mixed *timing, string f, mixed *data) {
  class event item;
  object ob = PO;

  item = new(class event);
  if(base_name(ob) == file_name(ob))
    item->ob = base_name(ob);
  else
    item->ob = ob;
  item->func = f;
  item->data = copy(data);
  if(sizeof(timing) > 1)
    item->recurring = 1;
  else
    item->recurring = 0;
  item->timing_data = copy(timing);
  return schedule_item(item);

}
