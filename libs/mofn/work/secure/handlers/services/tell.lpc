// Intermud 3 tell services

// from dw-wibble-r8.88

mapping get_services() {
  return ([
    "tell" : 1,
  ]);
}

void event_receive_tell(mixed *packet) {
    object ob;                        
    string who;
               
    if( file_name(PO) != IMUD_H ) return;
    who = lower_case(packet[5]);                            
    if( !(ob = find_player(who)) || (int)ob->query_invis() ) {
        IMUD_H->event_write(({ "error", 5, mud_name(), 0, packet[2],
                                  packet[3], "unk-user",               
                                  capitalize(packet[5]) + " is nowhere to "
                                    "be found on " + mud_name() + ".",     
                                  packet }));                         
        return;
    }          
    if (!ob->query_creator()) {
        IMUD_H->event_write(({ "error", 5, mud_name(), 0, packet[2],
                                  packet[3], "unk-user",               
                                  capitalize(packet[5]) + " is a player "
                                  " and cannot be the target of intermud "
                                  "tell s on " + mud_name() + ".",        
                                  packet }));                     
        return;
    }          
    ob->event_person_tell(this_object(), packet[6]+"@"+packet[2]+
                           " tells you: ", packet[7], "common");
    ob -> set_property("reply", packet[6] + "@" + packet[2]);
}

void event_send_tell(string who, string where, string msg) {
    string pl, plc;                                       

    pl = (string)this_player(1)->query_name();
    plc = (string)this_player(1)->query_cap_name();
    where = (string)IMUD_H->get_mud_name(where);
    IMUD_H->event_write(({ "tell", 5, mud_name(), pl, where,
                              lower_case(who), plc, msg }));
}
