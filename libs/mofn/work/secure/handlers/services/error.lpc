// provides error handling

// from dw-wibble-r8.88

mapping get_services() {
  return ([
    //"auth" : 1,
  ]);
}

void event_receive_error(mixed *packet) {
    object ob;
    string error_code, mud, target, msg;

    if(find_player("luggage")) {
      tell_object(find_player("luggage"),
        sprintf("Error packet: %O\n", packet));
    }

    if(packet[5]) {
        target = (string)packet[5];
        if( !(ob = find_player(target)) ) return;
    }

    mud = packet[2];
    error_code = packet[6];
    msg = packet[7];       
    packet = packet[8];
    switch(error_code) {
      case "unk-dst":     
      case "not-imp":
      case "unk-src":
      case "bad-pkt":
      case "bad-proto":
          log_file("/log/intermud", error_code + ": " + msg + "\n");
          log_file("/log/intermud", "Name of sending mud: "+mud+"\n");
          if (!packet) return;
          log_file("/log/intermud", "Offending packet: "+
              sprintf("%O\n", packet));
          return;
      case "unk-channel":
      case "not-allowed":
          log_file("/log/intermud", error_code + ": " + msg + "\n");
          if (!packet) {
             return;
          }
          log_file("/log/intermud", "Channel name: "+packet[6]+"\n");
          return;
      case "unk-type":
          log_file("/log/intermud", error_code + ": " + msg + "\n");
          log_file("/log/intermud", "Name of sending mud: "+mud+"\n");
          if (!packet) return;
          log_file("Type of offending packet: "+packet[0]+"\n");
          return;
      case "unk-user":
          if( !ob ) return;
          tell_object(ob, (msg ? msg : "Unknown user reported from " + mud +
                             "."));
          return;
    }
}

