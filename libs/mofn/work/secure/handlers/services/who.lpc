// provides Intermud 3 who services

// from dw-wibble-r8.88

mapping get_services() {
  return ([
    "who" : 1,
  ]);
}

void event_receive_who_reply(mixed *packet) {
  string *list;
  mixed *who;
  object ob;

  if(find_player("luggage")) {
    tell_object(find_player("luggage"), sprintf("who reply: %O\n", packet));
  }
  if( file_name(PO) != IMUD_H ) return;
  if( !packet[5] || !(ob = find_player(packet[5])) ) return;
  list = ({ "Remote who information from " + packet[2] + ":" });
  foreach(who in packet[6])
    if (who[1] > 0)        
      list += ({ who[0] + " (Idle for " + who[1] + " second"+
                   (who[1]>1?"s":"")+"): " + who[2] });
    else                                               
      list += ({ who[0] + " (Not Idle): " + who[2] });
  ob->more_string(implode(list, "\n")+"\n", "Who");
}

string query_status(object ob) {
  if(adminp(ob))
    return "Admin";
  if(creatorp(ob))
    return "Creator";
  return "Player";
}

void event_receive_who_request(mixed *packet) {
    mixed *msg;

    if( file_name(previous_object()) != IMUD_H ) return;
    msg = map(filter(users(), (: !((int)$1->query_invis()) :)),
        (: ({ (string)$1->query_cap_name(), query_idle($1),
                    query_status($1) }) :));
    IMUD_H->event_write(({ "who-reply", 5, mud_name(), 0, packet[2],
            packet[3], msg }));
}

void event_send_who_request(string mud, string who) {
  IMUD_H -> event_write(({ "who-req", 5, mud_name(), who, mud, 0 }));
}
