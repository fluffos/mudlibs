// provides Intermud 3 emoteto services

// from dw-wibble-r8.88

mapping get_services() {
  return ([
    "emoteto" : 1,
  ]);
}

void event_receive_emote(mixed *packet) {
  object ob;
  string who;

  if( file_name(PO) != IMUD_H) return;
  who = lower_case(packet[5]);
  if( !(ob = find_player(who)) || (int)ob->query_invis() ) {
    IMUD_H->event_write(({ "error", 5, mud_name(), 0, packet[2],
                                packet[3], "unk-user",             
                                capitalize(packet[5]) + " is nowhere to "
                                "be found on " + mud_name() + ".",       
                                packet }));                       
    return;                                
  }
  packet[7] = replace_string(packet[7], "$N", packet[6] + "@" + packet[2]);
  ob->event_emote(this_object(), "%^MAGENTA%^"+ packet[7]+ "%^RESET%^\n");
}
 
void event_send_emote(string who, string where, string msg) {
  string pl, plc;

  pl = (string)this_player(1)->query_name();
  plc = (string)this_player(1)->query_cap_name();
  where = (string)IMUD_H->get_mud_name(where);
  IMUD_H->event_write(({ "emoteto", 5, mud_name(), pl, where,
                              lower_case(who), plc, "$N "+msg }));
}
