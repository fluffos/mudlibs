// provide oob services

// from dw-wibble-r8.88

mapping get_services() {
  return ([
    "oob" : 1,
  ]);
}

void event_receive_oob_request(mixed *packet) {
  if(file_name(PO) != IMUD_H) return;
  if (sizeof(packet) != 6) return;
  if (!packet[2]) return;
  sessions[packet[2]] = -1; /* Special value for non auth services. */
  call_out(event_timeout, 600, packet[2]);
  OOB_H->event_listen();
}

