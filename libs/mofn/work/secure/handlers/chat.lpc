inherit HANDLER_BASE;

#define SAVE_FILE "/secure/save/handlers/chat"

class channel {
  string *list;
  mixed allowed_p;
  string   intermud;
  string *history;
}

mapping channels, guilds, orders, clans;

varargs int add_channel(string ch, mixed a_p, string ich) {
  if(!undefinedp(channels[ch]))
    return 0;
  if(PO && PO != master() && !adminp(TP))
    return 0;

  channels[ch] = new(class channel);
  channels[ch]->allowed_p = a_p;
  channels[ch]->list = ({ });
  channels[ch]->intermud = ich;
  call_out("save_me", 0);
  return 1;
}

string * query_channels() {
  return keys(channels);
}

private varargs class channel query_chan_info(string ch, string g) {
  class channel info;

  switch(ch) {
    case "guild" :
      if(adminp(TP) && g) {
        info = guilds[g];
      } else {
        info = guilds[TP->query_guild()];
      }
      break;
    case "order" :
      if(adminp(TP) && g) {
        info = orders[g];
      } else {
        info = orders[TP->query_order()];
      }
      break;
    case "clan"  :
      if(adminp(TP) && g) {
        info = clans[g];
      } else {
        info = clans[TP->query_clan()];
      }
      break;
    default      :
      info = channels[ch];
      break;
  }
  return info;
}

varargs string *query_listening(string ch, string g) {
  class channel info = query_chan_info(ch, g);

  if(!info) return ({ });

  return copy(info -> list);
}

varargs int add_guild_channel(mixed a_p) {
  // need PO to be the guild object
}

varargs int add_order_channel(mixed a_p) {
  // need PO to be the order object
}

varargs int add_clan_channel(mixed a_p) {
  // this needs to be called when the clan is created
}

int is_creator(object user, string ch) {
  return creatorp(user);
}

void create() {
  channels = ([ ]);
  guilds = ([ ]);
  orders = ([ ]);
  clans = ([ ]);
