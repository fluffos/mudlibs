void load_me() {
  if(file_size(SAVE_FILE + ".o") > 0)
    unguarded((: restore_object, SAVE_FILE :));
}

void save_me() {
  unguarded((: save_object, SAVE_FILE :));
}

void event_send_channel(string from, string channel, string msg, int emote, string target, string targmsg) {
  object *obs;
  string t;
  class channel info = query_chan_info(channel);

  if(!info) return;

  obs = map(info -> list, (: find_player($1) :));
  obs -= ({ 0 });
  if(sizeof(obs) == 0) return;

  if(emote) {
    obs -> receive_message("channel", t = sprintf("[%s] %s%%^RESET%%^\n", channel, replace_string(msg, "$N", from)));
  } else {
    obs -> receive_message("channel", t = sprintf("[%s] %s: %s%%^RESET%%^\n", channel, from, msg));
  }
  if(!arrayp(info -> history)) info->history = ({ });
  info -> history += ({ t });
  info -> history = info -> history[0..40];
}

int parse(object user, string *bits, string *path) {
  int intermud;
  class channel info = 0;
  string *xtra;
  int    emote;
  string remote, cmd;

  if(sizeof(bits) == 1) {
    switch(bits[0]) {
      case "channels" :
        // show the channels the user is on
        xtra = filter(keys(channels), (: member_array($(user)->NAME, $(channels)[$1]->list) != -1 :));
        if(member_array(user->NAME, query_listening("guild")) != -1)
          xtra += ({ "guild" });
        if(member_array(user->NAME, query_listening("order")) != -1)
          xtra += ({ "order" });
        if(member_array(user->NAME, query_listening("clan")) != -1)
          xtra += ({ "clan" });
        if(sizeof(xtra) == 0) {
          tell_object(user, "You are not listening on any channels.\n");
        } else if(sizeof(xtra) == 1) {
          tell_object(user, "You are listening on " + xtra[0] + ".\n");
        } else {
          tell_object(user, "You are listening on: " + implode(xtra, ", ") + ".\n");
        }
        return 1;
    }
  }

  // bits[0] must be a channel that the user is subscribed to
  switch(bits[0]) {
    case "clan" :
     if(user -> query_clan()) 
       info = clans[user -> query_clan()];
       break;
    case "guild" :
     if(user -> query_guild()) 
       info = clans[user -> query_guild()];
       break;
    case "order" :
     if(user -> query_order()) 
       info = clans[user -> query_order()];
       break;
    default      :
      if(undefinedp(channels[bits[0]])) return 0;
      info = channels[bits[0]];
      break;
  }

  if(!info) return 0;

  xtra = explode(implode(bits[1..], " "), "@");
  if(sizeof(xtra) == 2 && info->intermud) {
    cmd = xtra[0];
    remote = IMUD_H -> get_mud_name(xtra[1]);
  } else if(sizeof(bits) == 2) {
    cmd = bits[1];
  } else {
    cmd = "";
  }

  if(cmd && cmd != "") {
    switch(cmd) {
      case "add"  :
      case "join" :
        if(info -> allowed_p) {
          if(arrayp(info->allowed_p)) {
            if(!call_other(info->allowed_p[0], info->allowed_p[1], user, bits[0], info->allowed_p[2..]))
              return 0;
          }
        }
        if(member_array(user->NAME, info->list) != -1) {
          notify_fail(user, "You are already listening on " + bits[0] + ".\n");
          return 0;
        }
        info->list += ({ user->NAME });
        tell_object(user, "You start listening on " + bits[0] + ".\n");
        call_out("save_me", 0);
        return 1;
      case "delete" :
      case "leave" :
        if(member_array(user->NAME, info->list) == -1)
          return 0;
        info->list -= ({ user->NAME });
        tell_object(user, "You stop listening on " + bits[0] + ".\n");
        call_out("save_me", 0);
        return 1;
      case "who" :
        if(member_array(user->NAME, info->list) == -1)
          return 0;
        if(remote && remote != "") {
          SERVICES_H -> event_send_channel_who_request(info->intermud, remote);
        } else {
          xtra = filter(info->list, (: find_player($1) :)) - ({ user->NAME });
          if(sizeof(xtra)) {
            tell_object(user, "The following people are listening on " + bits[0] + 
                              ": " + implode(xtra, ", ") +
                              ".\n");
          } else {
            tell_object(user, "You are the only person on " + bits[0] + ".\n");
          }
        }
        return 1;
      case "history" :
        if(member_array(user->NAME, info->list) == -1)
          return 0;
        user -> more_string(implode(info->history, "\n"), "history");
        return 1;
    }
  }

  if(member_array(user -> NAME, info->list) == -1) {
    return 0;
  }

  if(bits[1][0] == '@') {
    emote = 1;
    bits[1] = "$N " + bits[1][1..];
  }

  if(!info -> intermud || info -> intermud == "") {
    TO -> event_send_channel(user->NAME, bits[0], implode(bits[1..], " "), emote);
  } else {
    SERVICES_H -> event_send_channel(user->NAME, info->intermud, implode(bits[1..], " "), emote);
    //TO -> event_send_channel(user->NAME, bits[0], implode(bits[1..], " "), emote);
  }
  return 1;
}
