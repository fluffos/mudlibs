inherit HANDLER_BASE;

// from dw-wibble-r8.88

private nosave mapping _living;
private nosave mapping _lnames;

void create() {
  _living = ([ ]);
  _lnames = ([ ]);
}

void enable_commands(object ob){
  _living[ob] = 1;
}

void set_living_name(string name, object ob){
  if(!_lnames[name])
    _lnames[name] = ({ob});
  else
    _lnames[name] += ({ob});
}

int living(object ob){
  return _living[ob];
}

object find_living(string it){
  object *people;
  object ret;

  if(_lnames[it]){
    _lnames[it] = filter(_lnames[it], (:$1:));
    if(sizeof(_lnames[it]))
      return _lnames[it][0];
  }

  people = keys(_living);
  people = filter(people, (:$1 && ($1->query_name() == $(it)):));

  if(sizeof(people))
    return people[0];

  return ret;
}

object find_player(string it){
  object ret, *people = users();

  people = filter(people, (:$1->query_name() == $(it) &&
                           (inherits(PLAYER_OBJ, $1) || base_name($1) == PLAYER_OBJ):));

  if(sizeof(people))
    return people[0];

  people = filter(keys(_living), (:$1 && (inherits(PLAYER_OBJ, $1) || base_name($1) == PLAYER_OBJ) :) );
  people = filter(people, (:$1->query_name() == $(it):));

  if(sizeof(people))
    return people[0];
  
  return ret;
}
