inherit HANDLER_BASE;

#define DB_HOST "localhost"
#define DB_USERNAME "mud"
#define DB_PASSWORD "password"
#define DB_DATABASE "mofn"

int handle;
string *allowed;

void create() {
  handle = 0;
  allowed = ({ ACCESS_H, GROUPS_H, CBANK_H, USER_H });
  ::create();
}

void ping() {
  if(handle && stringp(db_exec(handle, "SELECT COUNT(*) FROM passwords"))) {
    db_close(handle);
    handle = 0;
  }

  if(!handle)
    handle = db_connect(DB_HOST, DB_DATABASE, DB_USERNAME, DB_PASSWORD);
}

string escape(string s) {
  if(!stringp(s))
    return "";

  return replace_string(
           replace_string(
             replace_string(s, 
               "\\", "\\\\"), 
             "%", "\\%"),
           "\"", "\\\"");
}

mixed exec(string s) {
  if(member_array(base_name(PO), allowed) == -1)
    return 0;

  ping();

  //filter(previous_object(-1), (: interactive($1) :)) -> receive_message("", "Query: [" + s + "]\n");

  return db_exec(handle, s);
}

mixed *fetch(int row) {
  if(member_array(base_name(PO), allowed) == -1)
    return ({ });

  return db_fetch(handle, row);
}

void dest_me() {
  db_close(handle);
  ::dest_me();
}
