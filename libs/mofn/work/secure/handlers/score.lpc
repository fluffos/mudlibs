// this handles scoring and experience awards

inherit HANDLER_BASE;

mapping guests;

void create() {
   guests = ([ ]);
   ::create();
}

// normally xp propagates up the liege structure, but certain situations
// probably shouldn't do so -- such as xp grants
varargs int adjust_xp(string player, int amt, int no_prop) {
  int l1, l2, x;
  mixed *res;
  string liege;

  if(!ACCESS_H -> query_is_user(player)) {
    if(undefinedp(guests[player]))
      guests[player] = amt;
    else
      guests[player] += amt;
    if(guests[player] < 0)
      guests[player] = 0;
    return 1;
  }

  if(amt > 0 && !no_prop) {
    // check for liege
    liege = USER_H -> query_liege(player);
    if(liege != "") {
      l1 = USER_H -> query_liege_factor(player);
      l2 = USER_H -> query_liege_factor(liege);
      if(l1 && l2) {
        amt -= SCORE_H -> adjust_xp(liege, fuzzy_divide(amt * l1, l2 * 10));
        USER_H -> set_xp(player, USER_H -> query_xp(player) + amt);
        return amt;
      }
    }
  }

  USER_H -> set_xp(player, USER_H -> query_xp(player) + amt);
  return amt;
}

int query_xp(string player) {
  if(undefinedp(guests[player]))
    return USER_H -> query_xp(player);
  return guests[player];
}
