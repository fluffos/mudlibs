// this handles group memberships, which eventually lead to
// domains and other things, but especially permissions
inherit HANDLER_BASE;

#include <driver.h>

mapping cache = ([ ]);

void create() {
  CACHE_H -> register_object();
  ::create();
}

string *query_groups(string id) {
  // find all groups, non-recursively
  mixed rows;
  string *ret;
  int i;

  ret = ({ });

  if(!id || id == "" || id == "group:EVERYTHING")
    return ret;

  if(undefinedp(cache[id])) {
    rows = DB_H -> exec("SELECT membership FROM groups WHERE id=\"" + DB_H -> escape(id) + "\"");

    if(intp(rows))
      for(i = 1; i <= rows; i++)
        ret += ({ (DB_H -> fetch(i))[0] });

    if(strsrch(id, ':') == -1) {
      if(strsrch(id, '/') >= 0) {
        if(member_array("LIVING", ret) == -1 && sizeof(filter(previous_object(-1), (: living($1) && base_name($1) == $(id) :) )))
          ret = ({ "LIVING" }) + ret;
      } else { // an interactive, perhaps?
        if(find_player(id) && !sizeof(ret))// member_array("PLAYER", ret) == -1)
          ret = ({ "PLAYER" }) + ret;  // allows PLAYER to get masked
      }
    }
    // make EVERYTHING the top of the heap
    if(0 && sizeof(ret) == 0)
      ret = ({ "EVERYTHING" });
    cache[id] = ret;
  }

  return cache[id];
}

int query_member(string group, string id) {
  string *groups, g;

  if(!id || id == "")
    return 0;

  if(!group || group == "")
    return 0;

  groups = query_groups(id);

  if(member_array(group, groups) != -1)
    return 1;

  foreach(g in groups)
    if(query_member(group, "group:" + g))
      return 1;

  return 0;
}

void clear_cache() {
  if(base_name(PO) != CACHE_H && origin() != ORIGIN_LOCAL)
    return;
  cache = ([ ]);
}
