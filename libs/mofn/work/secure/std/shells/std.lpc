#include <access.h>

inherit SHELL_MOD;

int parse(object, string *);

// we want to handle simple commands right now
protected string _process_input(string str) {
  object tp, user;
  string verb;
  string *bits;

  if(!str || str == "")
    return "";

  if(str[0] == '\'') 
    str = "say " + str[1..]; 
  else if(str[0] == ':')
    str = "emote " + str[1..];

  bits = explode(str, " ");

  tp = TP;
  set_this_player(query_owner());
  

  verb = bits[0];
  set_verb(verb);

  user = query_owner();

  notify_fail("What?\n");

  if(!TO -> parse(query_owner(), bits)) // handle shell built-ins :)
    if(!user -> parse(user, bits))
      if(!COMMAND_H -> parse(user, bits, undefinedp(variables["path"]) ?
                                             ({ }) : variables["path"]))
        if(!SOUL_H -> parse(user, bits, undefinedp(variables["spath"]) ? 
                                             ({ }) : variables["spath"]))
          if(!CHAT_H -> parse(user, bits, undefinedp(variables["spath"]) ?
                                             ({ }) : variables["spath"]))
            if(query_notify_fail())
              notify_fail(0);
  set_this_player(tp);
  return "";
}

int parse(object user, string *bits) {
  int t;

  switch(bits[0]) {
    case "cd" :
      if(!creatorp(user))
        return 0;
      if(sizeof(bits) > 2)
        return 0;
      if(sizeof(bits) == 1)
        bits += ({ "~" });
      bits[1] = TO -> get_path(bits[1]);
      if(!ACCESS_H -> has_guarded_access("file", bits[1], PERM_READ))
        return notify_fail("Permission denied.\n");
      t = file_size(bits[1]);
      if(t == -2) {
        set_path(bits[1]);
        return 1;
      }
      if(t < 0)
        return notify_fail("Directory does not exist.\n");
      return notify_fail("Not a directory.\n");
      break;
    case "pwd" :
      if(sizeof(bits) > 1)
        return 0;
      message("shell", TO -> query_path() + "\n", user);
      return 1;
      break;
    default:
      return ::parse(user, bits);
      break;
  }
  return ::parse(user, bits);
}
