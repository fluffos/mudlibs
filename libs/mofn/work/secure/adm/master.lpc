private nosave  object unguarded_ob;

// parts are taken from dw-wibble-r8.88

void create() {
  unguarded_ob = 0;
  if(file_size("/driver.core") > 0)
    rm("/driver.core");
  // make sure certain things will load
  call_other(PLAYER_OBJ, "??");
  call_other(ROOM_VOID, "??");
  call_other("/secure/std/protocols/none", "??");
  call_other("/secure/handlers/command", "??");
  call_other(SOUL_H, "??");
  call_other(IMUD_H, "??");
  call_other(SHUTDOWN_H, "??");
}

