inherit COMMAND_BASE;

// from dw-wibble-r8.88

void setup() {
  set_synonyms(({"go"}));
}

int cmd(string str) {
  object dest;
  string *names, nick;
  string tname;

  if (!str)
    return notify_fail("Teleport where?\n");

  nick = (string)TP->expand_nickname(str);
  dest = find_living(nick);
  if (!dest && objectp(TP->get_obvar(str))) {
    dest = TP->get_obvar(str); 
    if (dest == environment(TP))              
      return notify_fail("You look around and realise you are already there.\n");
    TP->set_last_location(base_name(environment(TP)));
    TP->move_with_look( dest,                                  
                        (string)TP->query_mmsgin(),
                        (string)TP->query_mmsgout());
    return 1;

  }
  if (dest) {
    if(dest = environment(dest)) {
      if (dest == environment(TP))
        return notify_fail("You look around and realise you are already "
                           "there.\n");  

      TP->set_last_location(base_name(environment(TP)));
      TP->move_with_look( dest,
                          (string)TP->query_mmsgin(),
                          (string)TP->query_mmsgout() );
      return 1;
    } else
      return notify_fail(capitalize(nick) + " is not standing in a location.\n"); 
  } else {
    names = (string *)TP->get_cfiles(str);
    if(sizeof(names))  
      str = names[0];
    else
      return notify_fail("No such room.\n");
    if (!(dest = find_object(str))) {      
      catch(str->come_and_see_the_stars());
      dest = find_object(str);
    }                         
    if (!dest)
      return notify_fail("Failed to load " + str + "\n");
    else if(!dest->query_property("location"))
      return notify_fail("Not a room: " + str + "\n");     
    else {
      if (dest == environment(TP)) {
        notify_fail("You look around and realise you are already there.\n");
        return 0;
      }

      tname = environment(TP)->query_property("terrain name");
      if (tname) {

        TP->set_last_location(
          ({ tname, environment(TP)->query_co_ord() })
          );
      } else {
        TP->set_last_location(
          base_name(environment(TP))
          );
      }
      TP->move_with_look( dest,
                          (string)TP->query_mmsgin(),
                          (string)TP->query_mmsgout());
      return 1;
    }
  }
}
