inherit COMMAND_BASE;

// from dw-wibble-r8.88

void setup() {
  set_synonyms( ({ "mk" }) );
}

int cmd(string str) {
  if (!str || str == "") {
    notify_fail("Make what directory?\n");
    return 0;                             
  }        
  str = TP->get_path(str);

  str = replace(str, " ", "_");

  if (!str)
    return 1;

  if (file_size(str) != -1) {
    notify_fail(str + " already exists.\n");
    return 0;                               
   }        
       
  if (!mkdir(str)) {
    notify_fail("Couldn't make dir.\n");
    return 0;                           
  }
  write("Ok.\n");
  return 1;
}
