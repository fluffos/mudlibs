inherit COMMAND_BASE;

// from dw-wibble-r8.88

mixed cmd(string str) {
  object *things;

  if(!str) {
    notify_fail("More which file(s)/object?\n");
    return 0;
  }
  if(sizeof(things = PARSER_H->wiz_present(str, this_player()))) {
    str = file_name(things[0]);
    sscanf(str, "%s#%*d", str);
    if (file_size(str) <= 0)
      str += ".lpc";
  }
  return this_player()->more_file(str);
}
