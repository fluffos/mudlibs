inherit COMMAND_BASE;

void setup() {
  set_patterns(([
    1 : ({ "now <string'reason'>" }),
    0 : ({ "<number'number of minutes'> <string'reason'>" }),
  ]));
}

protected int cmd(string arg, object user, object *dir, object *indir, 
                  string dir_match, string indir_match, mixed *add_com,
                  string pattern)
{

  // need to log a reason, too
  
  if(stringp(add_com[0]))
    call_out("shut", 0);
  else
    call_out("shut", (int)add_com[0]*60);
  return 1;
}

void shut() {
  shutdown(0);
}
