inherit COMMAND_BASE;

// from dw-wibble-r8.88

void setup() {
  add_pattern("", 0);
}
    

mixed cmd( string str ) {
  int i;
  string ret, item;
  mixed *junk;
  mapping count;

  junk = call_out_info();
  if(sizeof(junk) < 1000) {
    junk = sort_array( junk, (: ( $1[ 2 ] > $2[ 2 ] ) -
                              ( $1[ 2 ] < $2[ 2 ] ) :) );
  }
   
  ret = "";
  for ( i = 0; i < sizeof( junk ); i++ ) {
    switch(str) {                         
    case "-c":   
      if(!count)
        count = ([ ]);
      count[base_name(junk[i][0]) + ":" + junk[i][1]] += 1;
      break;                                               
    case "-b":
      if(junk[i][1] != "effect_timer" &&
         junk[i][1] != "print_messages")
        ret += sprintf( "%O: %O in %O\n", junk[ i ][ 0 ],
                        junk[ i ][ 1 ], junk[ i ][ 2 ] );
      break;
    default:
      if ( str != "" ) {
        if ( sscanf( file_name( junk[ i ][ 0 ] ), "%*s"+ str +"%*s" ) == 2)
          ret += sprintf( "%O: %O in %O\n", junk[ i ][ 0 ],
                          junk[ i ][ 1 ], junk[ i ][ 2 ] );
      } else
        ret += sprintf( "%O: %O in %O\n", junk[ i ][ 0 ],
                        junk[ i ][ 1 ], junk[ i ][ 2 ] );
    }
  }

  if(count)
    foreach(item in keys(count))
      ret += sprintf("%-30s %d\n", item, count[item]);

  this_player()->more_string( ret, "Callouts" );
  return 1;
}
