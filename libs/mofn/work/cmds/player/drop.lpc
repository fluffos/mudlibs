inherit COMMAND_BASE;

// from dw-wibble-r8.88

#include <move.h>

void setup() {
  set_patterns(([
    0 : ({ "<direct:object>" }),
  ]));
}

protected int cmd(string arg, object user, object *dir, object *indir, 
                  string dir_match, string indir_match, string *add_com,
                  string pattern)
{
  object *dropped, *notdropped, ob;

  dropped = ({ });
  notdropped = ({ });

  foreach(ob in dir) {
    if(ob -> move(ENV(user)) == MOVE_OK)
      dropped += ob;
    else
      notdropped += ob;
  }

  // need a global way of handling succeeded/failed messages
  if(sizeof(dropped))
    add_succeeded_mess(dropped, "$N drop$s $D.\n", ({ }));
  else
    add_failed_mess(notdropped, "$N $try|tries$ to drop $D.\n", ({ }));
  return 1;
}
