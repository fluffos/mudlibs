inherit COMMAND_BASE;

protected int cmd(string arg, object user, object *dir, object *indir, 
                  string dir_match, string indir_match, string *add_com,
                  string pattern)
{
  // we want to log the string to a file along with the user's name
  log_file("NEWSOUL", "%s: %s\n", user -> NAME, arg);
  user -> receive_message("info", "Your suggestion has been logged.\n");
  return 1;
}
