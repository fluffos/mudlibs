inherit COMMAND_BASE;

// from dw-wibble-r8.88

string ooo() {
    return implode( allocate( 3 + random( 15 ),
        (: ({ "O", "o" })[ random( 2 ) ] :) ), "" );
} /* ooo() */

int haunt_player( object *victims ) {
    if ( !this_player()->query_property("dead") ) {
        return notify_fail( "You are no where near wispy enough to "
          "haunt people.  You could probably scare a table or "
          "chair, though.\n" );
    }
    
    TP -> add_succeeded_mess( "$N wave$s $p arms about anxiously and say$s: \"" + ooo() + "\" at $I.\n", victims );
    return 1;
} /* haunt_player() */


int cmd() {
    if ( !this_player()->query_property("dead") ) {
        return notify_fail( "You are no where near wispy enough to "
          "haunt people.  You could probably scare a table or "
          "chair, though.\n" );
    }
    TP -> add_succeeded_mess( "$N wave$s $p arms about anxiously and intone$s: \"" +
        ooo() + "\".\n" );
    return 1;
} /* cmd() */

void setup() {
  set_patterns(([
    0 : ({ "" }),
    1 : ({ "<indirect:any-living>" }),
  ]));
  set_pattern_handlers(([
    "" : (: cmd() :),
    "<indirect:any-living>" : (: haunt_player($4) :),
  ]));
}
