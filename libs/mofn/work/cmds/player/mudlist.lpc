inherit COMMAND_BASE;

void setup() {
  set_patterns(([
    0 : ({ "" }),
    1 : ({ "<string>" }),
  ]));
}

protected int cmd(string arg, object user, object *dir, object *indir, 
                  string dir_match, string indir_match, string *add_com,
                  string pattern)
{
  mapping list;
  string *ret;
  string *muds;
  string mud;
  mixed info;

  if(!arg || arg == "") {
    list = IMUD_H -> get_mud_list();
    ret = ({ sprintf("%|*'-'s", user->query_cols(),
                     "=======[ There are " + sizeof(list) + " muds ]======="),
          });
    muds = sort_array(keys(list), 1);
    //foreach(mud in muds) {
      ret += ({ sprintf("%#-*s", user->query_cols(), implode(muds, "\n")) });
    //}
    user -> more_string(implode(ret, "\n"), "mudlist");
  } else {
    arg = IMUD_H -> get_mud_name(arg);
    if(!arg) 
      return notify_fail("There is no mud by that name.\n");

    info = (IMUD_H -> get_mud_list())[arg];

    ret = keys(info[11]); // services
    
    ret = ({ arg + ":",
             "  Connect: " + info[1] + " " + info[2],
             "  Services: " + implode(ret, ", "),
             "  Type: " + info[8],
             "  Driver: " + info[7],
             "  Mudlib: " + info[5],
             "  State: " + info[9],
             "  Admin email: " + info[10],
          });

    if(info[11]["http"])
      ret += ({ "  Web site: http://" + info[1] + ":" + info[11]["http"] + "/" });

    user -> more_string(implode(ret, "\n"), "mudlist");
  }
  return 1;
}
