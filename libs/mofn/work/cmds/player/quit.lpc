inherit COMMAND_BASE;

void setup() {
  set_patterns(([
    0 : ({ "" }),
  ]));
}

protected int cmd(string arg, object user, object *dir, object *indir, 
                  string dir_match, string indir_match, string *add_com,
                  string pattern)
{
  object *obs, ob;

  if(!creatorp(user)) {
    obs = all_inventory(user);
    foreach(ob in obs) {
      if(!ob->short()) continue;
      if(ob -> query_property("no drop on quit")) continue;
      if( function_exists("do_drop", ob) ) {
        call_other(ob, "do_drop");
      } else
        ob -> move(ENV(user));
    }
  }
  tell_object(user, "Quitting now...\n");
  return user -> quit();
}
