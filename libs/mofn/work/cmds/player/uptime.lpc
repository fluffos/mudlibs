inherit COMMAND_BASE;

// from dw-wibble-r8.88

void setup() {
  set_patterns(([
    0 : ({ "" }),
  ]));
}

protected int cmd(string arg, object user, object *dir, object *indir, 
                  string dir_match, string indir_match, string *add_com,
                  string pattern)
{
  mapping u;
  int tim, num;
  string *bits, us;

  num = sizeof(users());
  if(num == 1) {
    us = "There is 1 user.";
  } else if(num) {
    us = "There are " + num + " users.";
  } else {
    us = "There are no users.";
  }

  tim = uptime();
  bits = ({ });
  if (tim > 60*60*24)
    bits += ({ (num=tim/(60*60*24))+" day"+(num==1?"":"s") });
  if (tim > 60*60 && tim%(60*60*24))
    bits += ({ (num=(tim/(60*60))%24)+" hour"+(num==1?"":"s") });
  if (tim > 60 && tim%(60*60))
    bits += ({ (num=(tim/60)%60)+" minute"+(num==1?"":"s") });
  if (sizeof(bits) == 1) {
   tell_object(user, sprintf("%-=*s\n",
                  (int)this_player()->query_cols(),
                  mud_name() + " has been up for "+
                  bits[0]+ ".  " + us));
  } else if (sizeof(bits) > 1) {
   tell_object(user, sprintf("%-=*s\n",
                  (int)this_player()->query_cols(),
                  mud_name() + " has been up for "+
                  implode(bits[0..<2], ", ") + " and " + bits[<1] + ".  " + us));
  }

  if(creatorp(user)) {
    u = rusage();

    tell_object(user, sprintf("The load average is " + query_load_average() + 
                  ".  This has taken %.2f%% of the cpu and %.2fMB of memory.\n",
                  ((u["stime"] + u["utime"]) / 10.0) / uptime(),
                  (memory_info() / 1024000.0)));
  }
  return 1;
}
