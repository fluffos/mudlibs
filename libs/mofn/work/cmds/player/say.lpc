inherit COMMAND_BASE;

protected int cmd(string arg) {
  int bang = arg[<1];
  string v,vs;

  switch(arg[<1]) {
    case '!' : v = "exclaim";
               vs= "exclaims";
               break;

    case '?' : v = "ask";
               vs= "asks";
               break;

    default  : v = "say";
               vs= "says";
  }

  TP -> receive_message("say", "You " + v + ": " + arg + "\n");

  message("say", TP -> CNAME + " " + vs + ": " + arg + "\n", ENV(TP), ({ TP }));
  return 1;
}
