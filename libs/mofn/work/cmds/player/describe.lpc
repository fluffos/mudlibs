inherit COMMAND_BASE;

// from dw-wibble-r8.88

#define MAX_DESC 480

void setup() {
  set_patterns(([ 
    0 : ({ "<string>", "" }),
    1 : ({ "edit", "clear" }),
  ]));
}

protected int cmd(string arg, object user, object *dir, object *indir, 
                  string dir_match, string indir_match, string *add_com,
                  string pattern)
{
  string desc = user -> query_desc();

  if(!arg || arg == "") {
    add_succeeded_mess(((desc) ? "Description reads:\n" + desc : 
                             "No description set.") + "\n");
    return 1;
  }

  if(lower_case(arg) == "clear") {
    user -> set_desc(0);
    add_succeeded_mess("Description cleared.\n");
    return 1;
  }

  if(lower_case(arg) == "edit") {
    user -> do_edit(desc ? desc : 0, "finish_desc_edit");
    add_succeeded_mess("");
    return 1;
  }

  if (strlen(arg) > MAX_DESC) {
    add_failed_mess("Description unchanged, too long.  (max: " + MAX_DESC + ")\n");
    return 0;
  }

  user -> set_desc(arg);
  add_succeeded_mess("Ok.\n");
  return 1;
}

void finish_desc_edit(string str) {
  if(!str) {
    message("notice", "Description unchanged.\n", TP);
    return;
  }

  if(strlen(str) > MAX_DESC) {
    message("notice", "Description unchanged, too long.  (max: " + MAX_DESC + ")", TP);
    return;
  }

  TP -> set_desc(str);
  message("notice", "Description set.\n", TP);
}
