inherit "/cmds/base/position";

// from dw-wibble-r8.88

#include <position.h>

void setup() {
   setup_position("stand", "up", STANDING);
   set_patterns( ([
      0 : ({ "", "up" }),
      2 : ({ "on [the] floor" }),
      1 : ({ "{on|at|in|beside} <indirect:object>" }),
   ]));
   set_pattern_handlers( ([
      "" : (: position($2, 0) :),
      "up" :  (: position($2, 0) :),
      "on [the] floor" : (: position_floor($2, 0) :),
      "{on|at|in|beside} <indirect:object>" :
                    (: position_object($4, $7[0], $2) :)
    ]) );
}
