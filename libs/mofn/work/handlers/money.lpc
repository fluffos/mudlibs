// handles common tasks regarding money
// such as comparing amounts...

#include <money.h>


int *normalize_coins(int *c) {
  int *r;
  int i;

  if(!c) return 0;

  r = copy(c);

  for(i = 0; i < sizeof(r)-1; i++) {
    while(r[i] < MONEY_RATIO[i]) {
      r[i] += MONEY_RATIO[i];
      r[i+1]--;
    }
    r[i+1] += r[i] / MONEY_RATIO[i];
    r[i] = r[i] % MONEY_RATIO[i];
  }

  return r;
}

int compare_coins(int *aa, int *bb) {
  int i, n;
  int *a, *b;

  if(!aa && !bb)
    return 0;

  if(!aa) {
    b = normalize_coins(bb);
    for(i = sizeof(b)-1; i >= 0; i--) {
      if(b[i] > 0) return -1;
      if(b[i] < 0) return 1;
    }
    return 0;
  }
  if(!bb) {
    a = normalize_coins(aa);
    for(i = sizeof(a)-1; i >= 0; i--) {
      if(a[i] > 0) return 1;
      if(a[i] < 0) return -1;
    }
    return 0;
  }

  a = normalize_coins(aa);
  b = normalize_coins(bb);

  if(sizeof(a) > sizeof(b)) {
    n = sizeof(b);
    for(i = sizeof(a)-1; i >= n; i--) {
      if(a[i] > 0) return 1;
      if(a[i] < 0) return -1;
    }
  } else if(sizeof(a) < sizeof(b)) {
    n = sizeof(a);
    for(i = sizeof(b)-1; i >= n; i--) {
      if(b[i] > 0) return -1;
      if(b[i] < 0) return 1;
    }
  }
  for(i = n-1; i >= 0; i--) {
    if(a[i] > b[i]) return 1;
    if(a[i] < b[i]) return -1;
  }
  return 0;
}

varargs string coins_string(int *coins, int flag) {
  string *ret = ({ });

  if(compare_coins(coins, 0) <= 0) 
    return "nothing";
  
  for (int i = sizeof(MONEY_TYPES); i;) {
    i--;
    ret += coins[i] ? ({ coins[i] + ((flag) ? CAP(sprintf("%c",
           MONEY_TYPES[i][0])) : " " + MONEY_TYPES[i]) }) : ({ });
  }

  return query_multiple_short(ret) + ((flag) ? "" : " coins");
}

int *query_coins_from_string(string str) {
  string *bits;
  int    *coins = allocate(sizeof(MONEY_TYPES));
  int    i, j, index;

  if(!str || str == "")
    return 0;

  bits = explode(lower_case(str), " ");

  if(sizeof(bits) < 2) 
    return 0;
  
  index = sizeof(bits);
  
  while(index--) {
    if((i = member_array(bits[index], MONEY_TYPES)) == -1) {
      j = sizeof(MONEY_TYPES);
      i = -1;
      while(j--) {
        if(bits[index] == MONEY_TYPES[j][0..sizeof(bits[index])-1])
          i = j;
      }
    }
    if(i == -1) 
      return 0;
    index--;
    if(sscanf(bits[index], "%d", j) != 1)
      return 0; 
    coins[i] += j;
  }

  return coins;
}
