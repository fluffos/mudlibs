/*    /lib/key.c
 *    from the Nightmare V Object Library
 *    handles such things as breaking when someone uses it
 *    created by Descartes of Borg 960121
 *
 *    Every key also inherits LIB_ITEM, whose LIB_LOCK_WITH already carries
 *    the breakage (Disabled, DisableChance) and the lock/unlock applies, so
 *    this file adds only the key's id.  It used to keep its own copy of all
 *    of them, which won in every key and left the saved "Disabled" behind.
 */

#include "include/key.h"

private string KeyID;

protected void create() {
  this_object()->AddSave(({ "Disabled", "DisableChance", "KeyID" }));   /* the item's (persist); lock_with's Disabled/DisableChance */
  KeyID = "";
}

string SetKeyID(string i) { return KeyID = i; }

string GetKeyID() { return KeyID; }
