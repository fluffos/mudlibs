/* leather_jerkin
  Luna 12/14/98
*/
#include <lib.h>
#include <armour_types.h>
#include <armour_class.h>
#include <damage_types.h>
inherit LIB_ARMOUR;

nosave void create() {
  armour::create();
  SetArmourClass(ARMOUR_LEATHER);
  SetMaterials(({ "leather", "wood" }));
  SetKeyName("jerkin");
  SetShort("a leather jerkin");
  SetId(({ "jerkin" }));
  SetAdjectives(({ "brown", "leather", "hard-wearing" }));
  SetLong("This dark brown leather jerkin is preferred "
    "by soldiers and mercenaries for its hard-wearing "
    "quality. It has wooden buttons with leather thong "
    "loops.");
  SetMass(60);
  SetValue(75);
  SetDamagePoints(1000);
  SetWarmth(10);
  SetArmourType(A_VEST);
}
