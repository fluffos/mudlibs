#include <lib.h>
inherit LIB_DOOR;

nosave void create() {
  ::create();
  SetSide("down", ([ "id": ({ "hatchway", "hatch" }),
    "short": "a hatchway",
    "long": "The hatchway, sturdy and made of wood, covers "
    "up the exit going down.",
    "lockable": 1,
    "keys": "parvahospital_storagekey",
  ]));
  SetSide("up", ([ "id": ({ "hatchway", "hatch" }),
    "short": "a hatchway",
    "long": "The hatchway, sturdy and made of wood, covers "
    "the exit above.",
    "lockable": 1,
    "keys": "parvahospital_storagekey",
  ]));
  SetClosed(1);
  SetLocked(1);
  // SetPick(1); -- SetPick() takes a function (a custom pick-check
  // closure), not a boolean; this line never matched the real API and
  // just failed to compile (same author misunderstanding already
  // self-corrected via a commented-out SetPick(1) in std/obj/lootchest.lpc).
  SetLockStrength(2);
}
