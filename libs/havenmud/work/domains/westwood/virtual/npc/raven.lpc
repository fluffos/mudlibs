#include <lib.h>
inherit LIB_NPC;

nosave void create() {
  npc::create();
  SetKeyName("black raven");
  SetShort("a black raven");
  SetId(({ "black raven", "raven", "bird" }));
  SetLong("The raven is slightly larger than the average crow, and "
    "stands cunningly on its two small feet.");
  SetRace("bird");
  SetClass("animal");
  SetLevel(3);
  SetGender("male");
}
