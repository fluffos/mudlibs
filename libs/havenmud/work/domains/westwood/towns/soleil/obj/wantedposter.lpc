/*  A wanted poster */
#include <lib.h>
inherit LIB_ITEM;
#include "../wanted.h"
void ReadMe();

nosave void create() {
  item::create();
  SetKeyName("poster");
  SetId(({ "poster" }));
  SetAdjectives(({ "wanted" }));
  SetPreventGet("It is nailed firmly to the tree.");
  SetMass(450);
  SetShort("a wanted poster");
  SetLong("This is a poster listing the names and crimes of all "
    "people wanted in Soleil. One could read it.");
  SetRead("default", (: ReadMe :));
}

void ReadMe() {
  foreach (string person in keys(Crimes)) {
    this_player()->eventPrint(capitalize(person) + " is wanted for " +
      Crimes[person] + ".");
  }
}
