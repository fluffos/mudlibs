#include <lib.h>
#include <meal_types.h>
#include <vendor_types.h>

inherit LIB_MEAL;

nosave void create() {
  ::create();
  SetKeyName("green apple");
  SetId(({ "apple" }));
  SetAdjectives(({ "green" }));
  SetShort("a green apple");
  SetLong(
    "This piece of fruit is that from a green apple tree. This apple is a "
    "mild sweet fruit which is very popular amongst a variety of people. "
  );
  SetStrength(20);
  SetValue(15);
  SetMealType(MEAL_FOOD);
  SetMealMessages(({
    "$N eat a delicious green apple. ",
    "$N eats a green apple. ",
  }));
}
