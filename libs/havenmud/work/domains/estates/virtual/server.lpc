object compile_object(string file) {
  string *path;
  object ob;
  int x, y;

  if (previous_object() != master()) return 0;
  path = explode(file, "/");
  if (sizeof(path) != 6) return 0;
  if (file_size(__DIR__ + path[3] + ".lpc") < 1) return 0;
  if (!(ob = new(__DIR__ + path[3], path[4], path[5]))) return 0;
  return ob;
}
