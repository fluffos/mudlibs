#include <lib.h>
#include <std.h>
#include "../hive.h"
inherit LIB_ROOM;

nosave void create() {
  ::create();
  SetClimate("underground");
  SetAmbientLight(0);
  SetShort("a dark sandy tunnel below Yozrath");
  SetLong(""
  );
  SetInventory(([
    HIVE_OBJ "largecrystal": 1,
  ]));
  SetExits(([
    "north": HIVE_ROOM "room2",
    "south": HIVE_ROOM "room4",
  ]));
}
