#include <lib.h>
#include "../tam.h"
inherit LIB_ROOM;

nosave void create() {
  room::create();

  SetClimate("arid");
  SetShort("road west of the river");
  SetLong(
    "This is the road on the west side of the river. west is "
    "more road leading out to your death in the desert. east is town. "
  );
  SetSmell(([
    "default": "This is smells.",
  ]));
  SetListen(([
    "default": "This is noises.",
  ]));
  SetItems(([
  ]));
  SetItemAdjectives(([
  ]));
  SetInventory(([
  ]));
  SetEnters(([
  ]));
  SetExits(([
    "east": TAM_ROOM "rw7c",
    //     "west" : desert,
  ]));
}
