#include <lib.h>
#include "../tam.h"
inherit LIB_ROOM;

nosave void create() {
  room::create();

  SetClimate("arid");
  SetShort("the river");
  SetLong(
    "This is the river. You are drowning. East and west are "
    "road, south is more river. north is blocked by bridge."
  );
  SetSmell(([
    "default": "This is smells.",
  ]));
  SetListen(([
    "default": "This is noises.",
  ]));
  SetItems(([
  ]));
  SetItemAdjectives(([
  ]));
  SetInventory(([
  ]));
  SetEnters(([
  ]));
  SetExits(([
    "east": TAM_ROOM "re8",
    "south": TAM_ROOM "river6",
    "west": TAM_ROOM "rw8",
  ]));
}
