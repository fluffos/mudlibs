#include <lib.h>
#include "../tam.h"
inherit LIB_ROOM;

nosave void create() {
  room::create();

  SetClimate("arid");
  SetShort("road east of the river");
  SetLong(
    "This is the road on the east side of the river. west is "
    "more road, east is more road. "
  );
  SetSmell(([
    "default": "This is smells.",
  ]));
  SetListen(([
    "default": "This is noises.",
  ]));
  SetItems(([
  ]));
  SetItemAdjectives(([
  ]));
  SetInventory(([
  ]));
  SetEnters(([
  ]));
  SetExits(([
    "east": TAM_ROOM "re7b",
    "west": TAM_ROOM "re7",
  ]));
}
