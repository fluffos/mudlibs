#include <lib.h>
#include "../tam.h"
inherit LIB_ROOM;

nosave void create() {
  room::create();

  SetClimate("arid");
  SetShort("the river");
  SetLong(
    "This is the river. You are drowning. East and west are "
    "road, north is more river. south is blocked by bridge."
  );
  SetSmell(([
    "default": "This is smells.",
  ]));
  SetListen(([
    "default": "This is noises.",
  ]));
  SetItems(([
  ]));
  SetItemAdjectives(([
  ]));
  SetInventory(([
  ]));
  SetEnters(([
  ]));
  SetExits(([
    "east": TAM_ROOM "re6",
    "north": TAM_ROOM "river3",
    "west": TAM_ROOM "rw6",
  ]));
}
