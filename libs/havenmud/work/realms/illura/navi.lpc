//Illura@Haven
//Navicat!
#include <lib.h>
inherit LIB_NPC;
nosave void create() {
  npc::create();
  SetShort("Navi the cat");
  SetLong("This is a Illura's housecat.");
  SetRace("cat");
  SetGender("female");
  SetClass("animal");
  SetLevel(1);
  SetKeyName("Navi");
  SetId(({ "housecat", "cat" }));
  SetAction(5, ({
    "Navi stretches.",
    "!say Hello there.",
    "!say I'm hungry.",
    "Navi tears something up indiscriminantly.",
  })
  );
}
