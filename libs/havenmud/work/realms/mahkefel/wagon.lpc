//  Gypsy Camp near Gothic Manor/Cemetery
//  Alessandra 2014

#include <lib.h>
inherit LIB_STORAGE;
inherit LIB_EXITS;
inherit LIB_MESSAGES;

protected void create() {
  storage::create();

  SetKeyName("wagon");
  SetMaterials(({ "natural" }));
  SetShort("a colorful wagon");
  SetId(({ "wagon", "caravan", "vardo" }));
  SetAdjectives(({ "colorful" }));
  SetLong(
    "This is a wagon. Which has no description."
  );
  SetPreventGet("You can't be serious.");

}

mixed direct_enter_obj() {
  return 1;
}

/* LIB_ENTER was inherited too, but LIB_EXITS (eventEnter, GetEnter, SetDoor)
 * and LIB_STORAGE (open, close, lock) supplied every function the two
 * shared; this is the one it added that the wagon answers. */
mixed direct_enter_into_obj() {
  return direct_enter_obj();
}
