#include <lib.h>
#include "../crypt.h"
inherit LIB_ROOM;

protected void create() {
  room::create();

  SetClimate("temperate");
  SetShort("a garden");
  SetLong(0);
  SetSmell();
  SetListen();
  SetItems(0);
  SetItemAdjectives(0);
  SetEnters(([
    "south": CRYPT_ROOM + "fronthall",
    "north": CRYPT_ROOM + "shrine"
  ]));
}
