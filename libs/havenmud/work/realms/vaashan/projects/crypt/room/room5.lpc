#include <lib.h>
#include "../crypt.h"
inherit LIB_ROOM;

protected void create() {
  room::create();

  SetAmbientLight(30);
  SetClimate("indoors");
  SetShort("a lavishly appointed bedroom");
  SetLong(0);
  SetSmell();
  SetListen();
  SetItems(0);
  SetItemAdjectives(0);
  SetEnters(([
    "west": CRYPT_ROOM + "room4",
    "east": CRYPT_ROOM + "room6"
  ]));
}
