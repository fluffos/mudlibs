#include <lib.h>
#include "../crypt.h"
inherit LIB_ROOM;

protected void create() {
  room::create();

  SetAmbientLight(30);
  SetClimate("indoors");
  SetShort("a guard tower");
  SetLong(0);
  SetSmell();
  SetListen();
  SetItems(0);
  SetItemAdjectives(0);
  SetEnters(([
    "down": CRYPT_ROOM + "room12"
  ]));
}
