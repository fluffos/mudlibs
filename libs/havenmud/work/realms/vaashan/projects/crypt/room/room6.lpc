#include <lib.h>
#include "../crypt.h"
inherit LIB_ROOM;

protected void create() {
  room::create();

  SetAmbientLight(30);
  SetClimate("indoors");
  SetShort("a hallway");
  SetLong(0);
  SetSmell();
  SetListen();
  SetItems(0);
  SetItemAdjectives(0);
  SetEnters(([
    "south": CRYPT_ROOM + "room7",
    "west": CRYPT_ROOM + "room5",
    "northeast": CRYPT_ROOM + "room11"
  ]));
}
