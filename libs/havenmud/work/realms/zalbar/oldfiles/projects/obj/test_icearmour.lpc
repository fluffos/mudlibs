#include <lib.h>
#include <armour_class.h>
#include <armour_types.h>
#include <damage_types.h>
#include <vendor_types.h>
#include <size.h>

inherit LIB_ARMOUR;

nosave void create() {
  armour::create();
  SetKeyName("armour");
  SetId(({ "armour" }));
  SetAdjectives(({ " " }));
  SetShort("armour");
  SetLong("armour");
  SetVendorType(VT_ARMOUR);
  SetMass(20);
  SetMaterial(({ "natural" }));
  SetArmourClass(ARMOUR_NATURAL);
  SetWarmth(0);
  SetValue(0);
  SetDamagePoints(1000);
  SetProperty("magic",
    "The enchantment on this suit of armor "
    "blocks most magic, but lets fire pass through.");
  SetArmourType(A_ARMOUR);
  SetProtectionBonus(COLD, 50);
  SetProtectionBonus(WATER, 20);
  SetSize(SIZE_LARGE);
}
