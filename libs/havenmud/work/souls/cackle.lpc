#include <lib.h>
inherit LIB_SOUL;

nosave void create() {
  ::create();
  SetVerb("cackle");
  SetRules("", "LIV", "STR", "STR LIV", "LIV STR");
  SetMessages(([
    "": "$agent_name $agent_verb gleefully.",
    "LIV": "$agent_name $agent_verb gleefully at $target_name.",
    "STR": "$agent_name $agent_verb $adverb.",
    "STR LIV": "$agent_name $agent_verb $adverb at $target_name.",
    "LIV STR": "$agent_name $agent_verb $adverb at $target_name.",
  ]));
}
