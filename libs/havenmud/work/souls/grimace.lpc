// Laoise@Haven grimaces

#include <lib.h>
inherit LIB_SOUL;

nosave void create() {
  ::create();
  SetVerb("grimace");
  SetRules("", "LIV", "STR", "LIV STR", "STR LIV");
  SetErrorMessage("Do what?");
  SetMessages(([
    "": "$agent_name $agent_verb horribly.",
    "LIV": "$agent_name $agent_verb horribly "
    "at $target_name.",
    "STR": "$agent_name $agent_verb $adverb.",
    "STR LIV": "$agent_name $agent_verb $adverb "
    "at $target_name.",
    "LIV STR": "$agent_name $agent_verb $adverb "
    "at $target_name.",
  ]));
}
