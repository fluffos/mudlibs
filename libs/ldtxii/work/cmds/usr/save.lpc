// mouse
// save.c
#include <ansi.h>
#include <options.h>
inherit F_CLEAN_UP;
int main(object me, string arg)
{
	object link_ob, *inv;
        int livetime, i;
	seteuid(getuid());
	if( !objectp(link_ob = me->query_temp("link_ob")) )
		return notify_fail(RED"【系统】你不是经由正常连线进入，不能储存。\n"NOR);
        if ( ((int)time() - (int)me->query("save_time")) < 30 )
                 return notify_fail(WHT"【系统】多存盘对服务器硬盘有害，请过一会儿再 save 吧。\n"NOR);
	if( environment(me)->query("valid_startroom") ) {
		me->set("startroom", base_name(environment(me)));
		write("当你下次连线进来时，会从这里开始。\n");
	}
        livetime = time() - me->query("birthday");
        if(!wizardp(me) && livetime <= CAN_SAVE_LIMIT_TIME )
        {
        return notify_fail(RED "初次进入不玩够 15 分钟以上，不能储存。\n" NOR);
        }
        if((int)link_ob->save() && (int)me->save()) 
        {                            
        UNIQUE_D->check_unique_for_delete( me );
        inv = all_inventory(me);
        for ( i = 0 ; i < sizeof( inv ) ; i++ )
            if ( inv[i]->is_unique() )
                UNIQUE_D->change_user_for_unique( inv[i], me ); 
        write(HIG"【系统】您的进度已经被存储了。\n"NOR);
        me->set("save_time", time());
        return 1;
        } 
        else 
        {
        write(HIW"你发现这个世界上有什么奇怪的事情正在发生着，要当心了。\n" NOR);
        return 0;
        }
}
int change_user( object me )
{
    object *inv;
    int i;
    inv = all_inventory(me);
    for( i=0 ; i < sizeof( inv ) ; i++ )
        if( inv[i]->is_unique() )
            UNIQUE_D->change_user_for_unique( inv[i], me ); 
    write(HIY "OK.\n" NOR);
    return 1;
}
int help(object me)
{
	write(@HELP
指令格式：save

把你辛苦奋斗的结果存起来。
HELP
	);
	return 1;
}
