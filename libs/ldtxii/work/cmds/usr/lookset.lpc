// lookset.c 

inherit F_CLEAN_UP;

int help();

int main(object me, string arg) {
  if (arg == "n") me->set("look", "n");
  else if (arg == "y") me->set("look", "y");
  else return help();
  write("ok!!\n");
  return 1;
}

int help() {
  write(@TEXT
指令格式：lookset <y/n> 
 
这个指令让你设定是否可以看到人物的状况，若不设定为“YES”
 
TEXT
  );
  return 1;
}
