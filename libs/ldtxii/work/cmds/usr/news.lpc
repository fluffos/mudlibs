// news.c
#include <ansi.h>
inherit F_CLEAN_UP;
inherit F_SAVE;
int news(object me);
int help(object me);
int main(object me, string arg)
{
           if(arg)
                return help(me);
                return news(me);
}
int news(object me)
{
        mapping *notes;
        object b;
        string msg;
        int i,unread;
        if(!( b = find_object("/clone/misc/reporter")) )
        b = load_object("/clone/misc/reporter");
        b->restore();
        notes = b->query("notes");
        msg = HIW+MUD_NAME+"消息公布栏：\n\n"NOR;
        if( !pointerp(notes) || !sizeof(notes) )
        msg += "\n"+MUD_NAME+"现在没有新的没有最新的消息。\n";
        for(i=0; i<sizeof(notes); i++)
                msg += sprintf(HIY"第%d条："NOR
                "%s\n %28s\n %40s\n",
                i+1, notes[i]["notes"], notes[i]["author"], ctime(notes[i]["time"])[0..21]  );
       me->start_more(msg);
       return 1;
}
        
int help(object me)
{
        write(@Help
指令格式: news 

这是给玩家知道最新消息的命令。
Help
        );
        return 1;
}
