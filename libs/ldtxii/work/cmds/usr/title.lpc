// title.c
// writed by shadow

#include <ansi.h>

int help();

inherit F_CLEAN_UP;

int check_legal_title(string, int);

int main(object me, string arg)
{
	string arg2;
	int titlelength=0;

	if ( !arg )
	{
		printf("你目前的头衔及门派：\n");
		printf(BOLD "%s" NOR "%s\n\n", RANK_D->query_rank(me), me->short(1));
		if (strlen(me->query("added_title"))>1)
			printf("其中头衔自设部份：%s\n", (string)me->query("added_title"));
		return 1;
	}

	if( arg=="none" )
	{
		me->delete("added_title");
		printf("好，删掉头衔自设部份。\n");
		return 1;
	}

	if ( sscanf(arg, "-w %s", arg2) == 1 )
	{
		if ( !wizardp(me) && wizhood(me) !="(immortal)" )
		{
			write("对不起，参数-w目前只能提供给巫师使用。\n");
			return 1;
		}
		me->set("title", arg2);
		return 1;
	}

	if ( (me->query("combat_exp") >= 3000000) || wizardp(me) )
	{
		titlelength=8;
	}
	else if (me->query("combat_exp") >= 1000000)
	{
		titlelength=6;
	}
	else if (me->query("combat_exp") >= 500000)
	{
		titlelength=4;
	}
	else titlelength=0;

	if (check_legal_title(arg, titlelength) == 0) return 1;	

	me->set("added_title", arg);

	return 1;
}

int check_legal_title(string addtitle, int titlelength)
{
	int i;

	i = strlen(addtitle);

	if (titlelength<=0)
	{
		write("对不起，目前你还不能给自己设头衔。\n");
		return 0;
	}

	if (titlelength < strlen(addtitle))
	{
		printf("对不起，目前你最多只能设%s个中文字作为头衔。\n", chinese_number(titlelength/2));
		return 0;
	}

	while(i--)
	{
		if ( addtitle[i]<=' ' )
		{
			write("对不起，你的头衔不能用控制字元。\n");
			return 0;
		}
		if ( i%2==0 && !is_chinese(addtitle[i..<0]) )
		{
			write("对不起，请您用「中文」设头衔。\n");
			return 0;
		}
	}
	return 1;
}

int help()
{
	write("
指令格式：title [****|-w ****]

自己设定头衔，不加参数显示你目前的头衔及门派。
参数-w方便不能用call的巫师设置自己的title。

经验值超过3000000点可以设四个中文字，
经验值超过1000000点可以设三个中文字，
经验值超过 500000点可以设两个中文字，
经验值少于 500000点还得继续努力。

title none　删掉头衔自设部份。
"
	);
	return 1;
}
