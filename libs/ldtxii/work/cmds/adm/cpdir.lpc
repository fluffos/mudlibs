inherit F_CLEAN_UP;
void decide_cp(string arg, string src, string dst);
void do_cp(string src, string dst);

int main(object me, string arg) {
  string src, dst;

  if (!arg || arg == "")
    return notify_fail("Usage:cpdir <src> <dst>.\n");
  if (sscanf(arg, "%s %s", src, dst) != 2)
    return notify_fail("Usage:cpdir <src> <dst>.\n");

  src = resolve_path(me->query("cwd"), src);
  dst = resolve_path(me->query("cwd"), dst);
  if (file_size(src) == -1) return notify_fail("原目录不存在.\n");
  if (src[sizeof(src) - 1] != '/') src += "/";
  if (dst[sizeof(dst) - 1] != '/') dst += "/";

  if (file_size(dst) == -1) {
    write("目标目录不存在.此操作将自动创建一个目录.\n");
    mkdir(dst);
    write("新创建目录" + dst + "成功.\n");
  }

  printf("这个操作将拷贝%s下的所有文件到%s，并将覆盖所有同名文件，确定吗？(y or n)", src, dst);
  input_to((: decide_cp :), src, dst);
  return 1;
}

void decide_cp(string arg, string src, string dst) {
  if (!arg || arg == "n") {
    write("取消。\n");
    return;
  }
  if (arg != "y") {
    printf("这个操作将拷贝%s下的所有文件到%s，并将覆盖所有同名文件，确定吗？(y or n)", src, dst);
    input_to((: decide_cp :), src, dst);
    return;
  }
  do_cp(src, dst);
}

void do_cp(string src, string dst) {
  string *file;
  int i;
  file = get_dir(src);

  for (i = 0; i < sizeof(file); i++) {
    if (file_size(src + file[i]) == -2)
      if (file_size(dst + file[i] + "/") != -2)
        if (!mkdir(dst + file[i] + "/")) {
          write("拷贝子目录" + src + file[i] + "/失败。\n");
        } else do_cp(src + file[i] + "/", dst + file[i] + "/");
    if (!cp(
      src + file[i],
      dst + file[i]
    )) printf("cp %s \e[31mERROR\e[2;37;0m\n,not copyed", src + file[i]);
    else printf("cp %s \e[33mTO\e[2;37;0m %s ok.\n", src + file[i], dst + file[i]);
  }
}

int help() {
  write(@TEXT
指令格式：cpdir <源目录名> <目标目录名>

这个指令可以拷贝整个目录，同时覆盖目标目录中的所有同名文件。
TEXT
  );
  return 1;
}
