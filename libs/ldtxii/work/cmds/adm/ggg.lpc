// giveletter.c

#include <ansi.h>
inherit F_CLEAN_UP;

int do_give(object me, object obj, object who);

void create() { seteuid(getuid()); }


int main(object me, string arg)
{
        object obj, who;
        mapping quest = me->query("quest");

        if(!arg) return notify_fail("你要给谁什么东西？\n");

        if(!objectp(who = present(arg, environment(me))) || !living(who))
                return notify_fail("这里没有这个人。\n");

        if(who->name() != quest["quest"])
                return notify_fail("这封信不是给这个人。\n");

        if(userp(who)) return notify_fail("你不能把这封信给这个人.\n");

        if(!objectp(obj = present("letter", me)))
                return notify_fail("你身上没有这样东西。\n");

        return do_give(me, obj, who);
}

int do_give(object me, object obj,object who)
{
       int bonus, exp, pot, factor;
        mapping quest;
          if ((int) who->query("task_time") < time() )
        {
        tell_object(who,"真可惜！你没有在指定的时间内把信送到！\n");

       destruct(this_object());

        return 1;
        }
         else
        {
        tell_object(who,"%S感激的对你说道：谢谢，谢谢！\n");
        exp = quest["exp_bonus"]/2 + random(quest["exp_bonus"]/2);
        pot = quest["pot_bonus"]/2 + random(quest["pot_bonus"]/2);
        factor=who->query("quest_factor");
      
        if( obj->move(who) ) {
        printf("你给%s一%s%s。\n", who->name(), obj->query("unit"),
                obj->name());
        message("vision", sprintf("%s给你一%s%s。\n", me->name(),
                        obj->query("unit"), obj->name()), who );
        message("vision", sprintf("%s给%s一%s%s。\n", me->name(), who->name(),
                obj->query("unit"), obj->name()), environment(me), ({me, who}) );
         if (factor)
        {
        exp=exp*factor/10;
        pot=pot*factor/10;
        }
        bonus = (int) who->query("combat_exp");
        bonus += exp;
        who->set("combat_exp", bonus);
        bonus = (int) who->query("potential");
        bonus = bonus - (int) who->query("learned_points");
        bonus = bonus + pot;
        bonus += (int) who->query("learned_points");
        who->set("potential", bonus );

       tell_object(who,HIW"你被奖励了：\n" + chinese_number(exp)
          + "点实战经验\n"+ chinese_number(pot) + "点潜能\n"NOR);
        me->delete("task_time");
        me->delete("quest_factor");
        me->delete("last_task_time");
        me->save();
        destruct(this_object());
        return 1;
        }
        else 
          return 0;
        }
}


int potential_lv(int exp)
{
        int grade;
        grade = 100 + exp /500;
        return grade;
}


int help(object me)
{
write(@HELP
指令格式 : givelette  <某人>

 
这个指令是专门用来送信的。
 
HELP
    );
    return 1;
}


