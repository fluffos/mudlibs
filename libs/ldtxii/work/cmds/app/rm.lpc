inherit F_CLEAN_UP;
int help(object me);
void DeleteAllFilesUnderDir(string, object);

int main(object me, string file) {
  seteuid(geteuid(me));
  if (!file) return notify_fail("你要删除那个档案?\n");
  if (file == "*.*") {
    write("您确认要删除" + me->query("cwd") + "下的所有文件和目录吗？(y/n)");
    input_to("check_delete", 0, me);
    return 1;
  }
  file = resolve_path(me->query("cwd"), file);
  if (file_size(file) == -1)
    return notify_fail("你要删除那个档案?\n");

  if (rm(resolve_path(me->query("cwd"), file))) {
    write("Ok.\n");
    log_file("nosave/rmfile",
      sprintf("%s(%s) delete (%s%s) on %s at %s.\n", me->name(),
        me->query("id"), resolve_path(me->query("cwd")), file, query_ip_name(me), ctime(time())));
  } else
    write("你没有删除这个档案的权利。\n");
  return 1;
}

void check_delete(string arg, object me) {
  string dir;
  mixed *files;

  if (arg != "y")
    return;

  dir = me->query("cwd");
  files = get_dir(dir);
  if (!sizeof(files)) {
    if (file_size(dir) == -2) {
      write("这个目录是空的。\n");
      return;
    } else {
      write("没有这个目录。\n");
      return;
    }
  }

  DeleteAllFilesUnderDir(dir, me);
  return;
}

void DeleteAllFilesUnderDir(string dir, object me) {
  mixed *files;
  string dfile;
  int i;

  write(sprintf("the command dir is %s\n", dir));
  files = get_dir(dir);
  if (!sizeof(files)) {
    if (file_size(dir) == -2) {
      write("这个目录是空的。\n");
      rmdir(dir);
      write(sprintf("Directory %s deleted .\n", dir));
      return;
    } else {
      write("没有这个目录。\n");
      return;
    }
  }

  for (i = 0; i < sizeof(files); i++) {
    dfile = files[i];
    if (file_size(resolve_path(dir, dfile)) == -1) {
      write(sprintf("你要删除的档案%s已经不存在！\n", resolve_path(dir, dfile)));
    }
    if (file_size(resolve_path(dir, dfile)) == -2) {

      if (rmdir(resolve_path(dir, dfile)))
        write(sprintf("Directory %s deleted .\n", dfile));
      else {
        write(sprintf("目录%s非空。\n", dfile));
        DeleteAllFilesUnderDir(resolve_path(dir, dfile) + "/", me);
      }
    }
    if (rm(resolve_path(dir, dfile))) {
      write(sprintf("%s deleted .\n", dfile));
      log_file("nosave/rmfile",
        sprintf("%s(%s) delete (%s%s) on %s at %s.\n", me->name(),
          me->query("id"), resolve_path(me->query("cwd")), dfile, query_ip_name(me), ctime(time())));
    } else {
      if (rmdir(resolve_path(dir, dfile)))
        write(sprintf("Directory %s deleted .\n", dfile));
      else write(sprintf("你没有删除档案%s的权利。\n", resolve_path(dir, dfile)));
    }
  }
  write("ok!");
  return;
}


int help(object me) {
  write(@HELP
指令格式 : rm <档名>
特殊用法 : rm *.*  可以将当前目录下的文件和目录全部删除.

此指令可让你删除有权修改的档案。
HELP
  );
  return 1;
}
