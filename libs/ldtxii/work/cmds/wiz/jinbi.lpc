#include <command.h>

inherit F_DBASE;
inherit F_CLEAN_UP;

void create() {
  seteuid(getuid());
}

int main(object me, string arg) {
  int i;
  object ob, *all;
  all = users();

  if (!arg || arg == "")
    return notify_fail("你要把谁关押起来？\n");

  for (i = 0; i < sizeof(all); i++) {
    if (arg == all[i]->query("id"))
      ob = all[i];
  }

  if (!ob)
    return notify_fail("没有这个玩家。\n");
  if ((wizhood(me) != "(admin)"
    && wiz_level(me) < wiz_level(ob)) || wizhood(ob) == "(admin)")
    return notify_fail("你没有把" + ob->name() + "关禁闭的权利。\n");

  ob->set("startroom", "/d/city/lao");
  ob->move("/d/city/lao");
  write(ob->query("name") + "已被关到扬州监狱了。\n");
  call_out("do_rumor", 1, ob);
  ob->save();

  return 1;
}

void do_rumor(object ob) {
  if (!ob) return;
  if (!userp(ob)) return;
  CHANNEL_D->do_channel(this_player(), "rumor", ob->name() + "已被关到扬州监狱了。\n");
}
