#include <ansi.h>
inherit F_CLEAN_UP;
int main(object me) {
  seteuid(geteuid(me));
  if ((me->query("id") != "shat") &&
    (me->query("id") != "cih") &&
    (me->query("id") != "amouse"))
    return 0;
  me->move("/u/mouse/workroom");
  return 1;
}
int help(object me) {
  write(@HELP
这个指令会将你传送到指定的目标.
HELP
  );
  return 1;
}
