inherit F_CLEAN_UP;


int main(object me, string arg)
{
        object ob;

        if( !arg ) return notify_fail("你要邀请谁参加你的帮会？\n");

if( !objectp(ob = find_player(arg)))
         {
            tell_object(me,"你提的人目前不在这世界吧？\n");
            return 1;
         }
if( !stringp( me->query("banghui_leader")) )
         return notify_fail("你自己没有加入帮会？\n");
if( !me->query("banghui") )
         return notify_fail("你自己没有加入帮会？\n");
if( me->query("banghui") == "              " )
         return notify_fail("你自己没有加入帮会？\n");

      if(!present(arg,environment(me)))
        {
         tell_object(me,ob->query("name")+"现在不在这里。\n");
         return 1;
        }
      tell_object(me,"你邀请"+ob->query("name")+"加入你的帮会。\n");
      say(me->query("name")+"<"+me->query("banghui")+">邀请"+ob->query("name")+"加入帮会。\n");
      me->set_temp("yaoqing",arg);

        return 1;
}


int help(object me)
{
        write(@HELP
指令格式：yaoqing <对方id>
 
这个指令让你邀请别人加入你的帮会.
当然你自己必须是帮会成员但不一定是领袖。

HELP
    );
    return 1;
}
