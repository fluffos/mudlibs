// card.c
#include <ansi.h>;
#include <command.h>;
inherit ITEM;

void create() {
  set_name(HIR "感谢卡" NOR, ({ "Thank card", "card" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("long",
      "这是一张很漂亮的" HIR "感谢卡" NOR "，是送给发现ＢＵＧ并通告
巫师和大力支持我们并提出宝贵意见的玩家。 你可以打开(dakai)来
看看，卡片不要丢掉哦，记住上边所给的编号，每过一段时间，我们
会从这些卡号中选出一个幸运者接受我们给的幸运礼物。\n");
    set("value", 0);
    set_weight(10);
  }
  setup();
}
void init() {
  add_action("do_dakai", "dakai");
  add_action("do_chaikai", "chaikai");
}
int do_dakai(string arg) {
  object me = this_player();
  if (arg == "card") {
    tell_object(me,
      HIW "\n" +
      "     ┏━━━━━━━━━ " HIR "感 谢 卡" HIW " ━━━━━━━━━┓\n" +
      "     ┃  ┌──────  Thank Card  ──────┐  ┃\n" +
      "     ┃  │                                      │  ┃\n" +
      "     ┃  │                                      │  ┃\n");
    if (strlen(me->query("name")) == 2) tell_object(me,
      HIW "     ┃  │  亲爱的 " HIY + me->query("name") + HIW "：                         │  ┃\n");
    if (strlen(me->query("name")) == 4) tell_object(me,
      HIW "     ┃  │  亲爱的 " HIY + me->query("name") + HIW "：                       │  ┃\n");
    if (strlen(me->query("name")) == 6) tell_object(me,
      HIW "     ┃  │  亲爱的 " HIY + me->query("name") + HIW "：                     │  ┃\n");
    if (strlen(me->query("name")) == 8) tell_object(me,
      HIW "     ┃  │  亲爱的 " HIY + me->query("name") + HIW "：                   │  ┃\n");
    if (strlen(me->query("name")) == 10) tell_object(me,
      HIW "     ┃  │  亲爱的 " HIY + me->query("name") + HIW "：                 │  ┃\n");
    tell_object(me,
      HIW "     ┃  │                                      │  ┃\n" +
      "     ┃  │      非常感谢您对我们工作的支持，为  │  ┃\n" +
      "     ┃  │  此，我们给您一份小小的礼物，对您表  │  ┃\n" +
      "     ┃  │  示感谢！                            │  ┃\n" +
      "     ┃  │                                      │  ┃\n" +
      "     ┃  │          " NOR GRN "*" HIM "T" NOR GRN "*^*" HIM "H" NOR GRN "*$*" HIM "A" NOR GRN "*&*" HIM "N" NOR GRN "*#*" HIM "K" NOR GRN "*" HIW "         │  ┃\n" +
      "     ┃  │         " NOR GRN "*^ * *" HIB "Y" NOR GRN "* ^" HIB "O" NOR GRN "^ *" HIB "U" NOR GRN "* * ^*" HIW "        │  ┃\n" +
      "     ┃  │          " GRN "^" YEL "Y" GRN "^\\\\_^\\\\\\//^_//^" YEL "Y" GRN "^" HIW "         │  ┃\n" +
      "     ┃  │          " GRN "^\\_^\\_\\_\\//_/_/^_/^" HIW "         │  ┃\n" +
      "     ┃  │           " GRN "^^\\_^\\_\\\\/_/^_/^^" HIW "          │  ┃\n" +
      "     ┃  │             " GRN "^^\\_ \\// _/^^" HIW "            │  ┃\n" +
      "     ┃  │                 " GRN "\\_\\_/" HIW "                │  ┃\n" +
      "     ┃  │                  " GRN "/|\\" HIW "                 │  ┃\n" +
      "     ┃  │                 " GRN "/\\\\/\\" HIW "                │  ┃\n" +
      "     ┃  │                                      │  ┃\n" +
      "     ┃  │                 " RED " 【雄霸天下】" CYN "(西安站)" HIW "  │  ┃\n" +
      HIW "     ┃  └───────────────────┘  ┃\n" +
      "     ┗━━━━━━━━━━━━━━━━━━━━━━━┛\n" +
      "\n" + NOR); /*HIY+"         卡编号："+me->query("cardnum")+"\n"NOR);*/
  }
  return 1;
}
int do_chaikai() {
  object me = this_player();
  message_vision("$N试图拆开感谢卡，发现这张卡已经被拆开过了。\n", me);
  return 1;
}

string query_autoload() {
  return 1 + "";
}
