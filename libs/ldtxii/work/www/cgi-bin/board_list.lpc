// board_list.c
#include <mudlib.h>

inherit F_CLEAN_UP;

private mapping vaild_boards = ([
  //	board_id : {board_name,allow post}
  "towiz_b": ({ "系统公告板", 0 }),
  "kedian_b": ({ "过客留言板", 1 }),
]);

string gateway() {
  int i;
  string str, *list;

  list = keys(vaild_boards);
  sort_array(list, 1);

  str = sprintf(
    "<title>留言板</title>"
    "<body background=/images/body_bg.jpg><font color='#ff0000' face='幼圆'>"
    "<h3 align='center'>%s</font><font face='幼圆'> "
    "%s</font></h3><p><hr></p>",
    CHINESE_MUD_NAME,
    "留言版"
  );

  str += "<center><table border=3>";

  for (i = 0; i < sizeof(list); i++) {
    str += sprintf(
      "<tr><td><center><a href=board_read?%s&0&9999><font size=3 face='幼圆'>%s</font></td></a></center>"
      "<td><font size=3 face='幼圆'>%s</font></td>",
      list[i],
      vaild_boards[list[i]][0],
      vaild_boards[list[i]][1] == 1 ? "读写" : "只读"
    );
  }

  str += "</table></center></body>";
  return str;
}

mapping query_boards() {
  return vaild_boards;
}
