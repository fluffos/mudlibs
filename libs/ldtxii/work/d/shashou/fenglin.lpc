// fenglin.c

inherit ROOM;

void create() {
  set("short", "枫林");
  set("long", @LONG
    秋风阴冷，吹绽一树树的枫红，枫红如血浪般冉冉散开。
每片枫叶皆鲜红欲滴，红得就象是一滴血泪。
LONG
  );
  set("exits", ([ /* sizeof() == 3 */
    "south": __DIR__ "xiaolu",
    "west": __DIR__ "fenglin1",
    "north": __DIR__ "jiaochang",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "shashou");

  setup();
  replace_program(ROOM);
}
