// wizard_room.c 巫师休息室
// writed by shadow

#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIC "巫师休息室" NOR);
  set("long",
    "这里就是「" HIY "雄霸天下" NOR "」巫师的休息所在，刚粉刷过的四周墙壁上光秃秃\n"
    "的什么都没有，屋子的正中央放着一张楠木桌，上面摆着一本巫师留言簿\n"
    "(board)。\n");
  set("valid_startroom", 1);
  set("no_fight", "1");
  set("no_clean_up", 0);

  set("exits", ([
    "up": __DIR__ "arch_room",
    //		"enter" : "/adm/room/meeting_room",
    "down": __DIR__ "guest_room",
  ]));

  setup();

  call_other("/clone/board/wiz_b", "???");
}

void init() {
  object ob = this_player();
  if (!wizardp(ob) && wizhood(ob) != "(immortal)") {
    ob->move(__DIR__ "guest_room");
    return;
  }
}
