// kaoya.c 烤鸭

inherit ITEM;
inherit F_FOOD;

void create()
{
       set_name("火腿肠", ({"huotui chang", "chang"}));
	set_weight(200);
	if (clonep())
		set_default_object(__FILE__);
	else {
                set("long", "一根双汇牌的火腿肠。\n");
          set("unit", "根");
           set("value", 200);
           set("food_remaining", 3);
        set("food_supply", 40);
	}
}
