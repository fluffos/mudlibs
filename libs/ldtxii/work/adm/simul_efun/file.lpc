// file.c

void cat(string file) {
  write(read_file(file));
}

void assure_file(string file);
void log_file(string file, string text) {
  // FIX (AGENTS.md §7.11-class): file may include a subdirectory under
  // LOG_DIR (e.g. "buglog/npc_save", "nosave/BACKUP") that doesn't
  // exist in a fresh work/ tree -- write_file() throws uncaught in
  // that case. adm/daemons/logind.lpc's get_passwd() calls
  // log_file("buglog/npc_save", ...) as its very first statement --
  // fires on EVERY login/registration password submission, not just
  // new characters, making this higher-priority than the usual
  // admin-only nosave/* paths. Fixed with the standard assure_file()
  // call.
  assure_file(LOG_DIR + file);
  write_file(LOG_DIR + file, text);
}

void assure_file(string file) {
  string path, *dir;
  int i;

  if (file_size(file) != -1) return;

  seteuid(ROOT_UID);
  dir = explode(file, "/");
  dir = dir[0..sizeof(dir) - 2];
  path = "/";
  for (i = 0; i < sizeof(dir); i++) {
    path += dir[i];
    mkdir(path);
    path += "/";
  }
}

string base_name(object ob) {
  string file;

  if (sscanf(file_name(ob), "%s#%*d", file) == 2)
    return file;
  else
    return file_name(ob);
}
