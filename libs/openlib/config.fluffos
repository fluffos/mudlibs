###############################################################################
#              Customizable runtime config file for MudOS v22                 #
###############################################################################
# Adapted from this archive's own /adm/etc/config (a real MudOS v22.1a6
# development config, per its GETTING_STARTED doc) for this project's
# conventions -- see NOTES.md.

# name of this mud
name : OpenLib

# port number to accept users on
port number : 40245

# absolute pathname of mudlib
mudlib directory : /home/sunyc/src/mudlib/libs/openlib/work

# debug.log and author/domain stats are stored here
log directory : /log

# the directories which are searched by #include <...>
include directories : /adm/include:/include

# file to include in all LPC objects (optional)
global include file : <config.h>

# Directory to save binaries in.  (if BINARIES is defined)
save binaries directory : /adm/data/binaries

# the file which defines the master object
master file : /adm/obj/daemon/master

# the file where all global simulated efuns are defined.
simulated efun file : /adm/obj/daemon/simul_efun

# debug.log file name (assumed to be in specified 'log directory')
debug log file : debug

time to clean up : 1800
time to swap : 0
time to reset : 1800
maximum bits in a bitfield : 1200
maximum evaluation cost : 5000000
maximum array size : 15000
maximum buffer size : 400000
maximum mapping size : 15000
inherit chain size : 30
maximum string length : 200000
maximum read file size : 200000
maximum byte transfer : 700000
reserved size : 500000
hash table size : 7001
object table size : 1501
default fail message : What??
default error message : A runtime error just occurred! Please report to a wiz.

maximum users : 40
maximum local variables : 30
evaluator stack size : 5000
compiler stack size : 200
maximum call depth : 30
living hash table size : 100
