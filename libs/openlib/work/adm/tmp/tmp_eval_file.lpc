#include <mudlib.h>
#include <daemons.h>
#include <net/daemons.h>

mixed
eval()
{
  function f = function() { object me = this_player(); object m = filter(all_inventory(environment(this_player())), (: file_name($1)[0..17]=="/obj/clone/monster" :))[0]; m->die(); return "done";; };
  mixed priv = (this_interactive() ? query_privs(this_interactive()) : 0);

  return unguarded(f, priv);
}
