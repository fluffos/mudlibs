inherit SKILL;

////////////////////////////////

mapping *action = ({

  // ZHAOSHI :0

  ([
    "action": "$N怀里抱着宝宝，宝宝哭了，$N轻轻拍了几下，$n双眼一翻，$l掉在地上",
    "damage": 50,
    "dodge": 10,
    "parry": 10,
    "damage_type": "瘀伤",
    "skill_name": "宝宝哭了"
  ]),
  // ZHAOSHI :1

  ([
    "action": "$N抱着宝宝，宝宝突然笑了，$n也跟着傻笑起来，一时失去防备，被击中$l",
    "damage": 80,
    "dodge": 15,
    "parry": 15,
    "damage_type": "瘀伤",
    "skill_name": "宝宝笑了"
  ]),
  // ZHAOSHI :2

  ([
    "action": "$N刚走开，宝宝又闹了，$N气急败坏，气没出发，一拳打在$n的$l",
    "damage": 100,
    "dodge": 20,
    "parry": 20,
    "damage_type": "瘀伤",
    "skill_name": "宝宝闹了"
  ]),
  // ZHAOSHI :3

  ([
    "action": "$N正逗宝宝玩，$n冲了过来，宝宝烦了，$N大怒，一指戳去，$n$l一下子被戳了一个洞",
    "damage": 130,
    "dodge": 25,
    "parry": 30,
    "damage_type": "瘀伤",
    "skill_name": "宝宝烦了"
  ]),
  // ZHAOSHI :4

  ([
    "action": "$N发现宝宝饿了，哇哇大哭，随手一挥，奶瓶飞了出去，正中$n$l！！！误伤！！！",
    "damage": 150,
    "dodge": 30,
    "parry": 40,
    "damage_type": "瘀伤",
    "skill_name": "宝宝饿了"
  ]),
  // ZHAOSHI :5

  ([
    "action": "$N哄了半天，终于发现宝宝困了，就要睡着了，心头一喜，在也支持不住，到在$n的$l上。",
    "damage": 180,
    "dodge": 40,
    "parry": 50,
    "damage_type": "瘀伤",
    "skill_name": "宝宝困了"
  ]),
  // ZHAOSHI :6

  ([
    "action": "$N抱着宝宝，突然发现宝宝尿了，$N运起内力，一股尿直射向$n的$l",
    "damage": 200,
    "dodge": 50,
    "parry": 60,
    "damage_type": "瘀伤",
    "skill_name": "宝宝尿了"
  ]),
  // ZHAOSHI :7

  ([
    "action": "$N正在看电视，宝宝不开心了，$N只好扔下手中遥控，赶紧去哄他，遥控在空中划出一道弧线，正中$n$l。",
    "damage": 220,
    "dodge": 80,
    "parry": 70,
    "damage_type": "瘀伤",
    "skill_name": "宝宝不开心了"
  ]),
});
// ZHAOSHI :8
int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练" + "宝宝拳" + "必须空手。\n");
  if ((int)me->query("max_force") < 50)
    return notify_fail("你的内力太弱，无法练" + "宝宝拳" + "。\n");
  return 1;
}
int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }
int effective_level() { return 20; }
mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}
int practice_skill(object me) {
  if ((int)me->query("kee") < 30)
    return notify_fail("你的体力不够了，休息一下再练吧。\n");
  if ((int)me->query("force") < 30)
    return notify_fail("你的内力不够了，休息一下再练吧。\n");
  me->receive_damage("kee", 30);
  me->add("force", -30);
  return 1;
}
string *parry_msg = ({
  "$n利用身法引偏了$N的$w。\n",
});
string *unarmed_parry_msg = ({
  "$n轻描淡写的化解了$N的攻势。\n",
});
string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}
int learn_bonus() {
  return 30;
}
int practice_bonus() {
  return -30;
}
int black_white_ness() {
  return 320;
}
string perform_action_file(string action) {
  return CLASS_D("player") + "/" + "unarmed" + "/" + action;
}
