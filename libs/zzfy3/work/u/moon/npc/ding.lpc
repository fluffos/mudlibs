// ken 1999.12.13

#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int wieldblade();
void create() {
  set_name("丁鹏", ({ "master ding peng", "master" }));
  create_family("圆月山庄", 1, "庄主");
  set("nickname", HIY "刀神" NOR);
  set("gender", "男性");
  set("age", 35);
  set("combat_exp", 15000000);
  set("attitude", "peaceful");
  set("long",
    "丁鹏已经变了，已经不是以前那个冲动无知的年轻人。现在不但
成熟而稳重，而且带着种超越一切的自信。\n"
  );
  set("max_force", 3000);
  set("force", 64000);
  set("max_mana", 2000);
  set("mana", 2000);
  set("max_atman", 2000);
  set("atman", 2000);
  set("force_factor", 200);
  set("int", 30);
  set("str", 30);
  set("max_kee", 10000);
  set("max_sen", 10000);
  set("max_gin", 10000);
  set("per", 40);
  set("spi", 35);
  set_skill("move", 200);
  set_skill("parry", 220);
  set_skill("blade", 200);
  set_skill("literate", 180);
  set_skill("unarmed", 150);
  set_skill("dodge", 100);
  set_skill("force", 100);
  set_skill("incarnation", 330);
  set_skill("yueforce", 200);
  map_skill("force", "yueforce");
  set_skill("moon-steps", 160);
  map_skill("dodge", "moon-steps");
  set_skill("moon-blade", 160);
  map_skill("blade", "moon-blade");
  map_skill("parry", "moon-blade");
  set("chat_chance", 15);
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: wieldblade :),
  }));
  setup();
  carry_object(__DIR__ "obj/cloth3")->wear();
  carry_object(__DIR__ "obj/wandao");
  carry_object("/obj/money/tenthousand-cash");
}
int wieldblade() {
  command("wield wandao");
  perform_action("blade.daoshen");
  command("unwield wandao");
  return 1;
}

void attempt_apprentice(object ob) {
  call_out("do_recruit", 1, ob);
}

void recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("class", "moon");
}
void do_recruit(object ob) {
  if ((int)ob->query_skill("blade", 1) < 60) {
    command("say 你的武功根基太差了，无法领悟本庄神技！\n");
    return;
  }
  if (!ob->query("marks/killyu") == 1) {
    command("sigh");
    command("say 羽天白以我宝刀为害武林，我欲除之而后快!\n");
    return;
  }
  command("smile");
  command("say 很好，很好，很好。");
  command("recruit " + ob->query("id"));
}

void re_rank(object student) {
  int exp;
  exp = (int)student->query("combat_exp");
  if (exp <= 128000) {
    student->set("title", "圆月山庄弟子");
    return;
  } else if (exp <= 512000) {
    student->set("title", "圆月山庄神刀统领");
    return;
  } else if (exp <= 1536000) {
    student->set("title", "圆月山庄神刀大统领");
    return;
  } else if (exp <= 3456000) {
    student->set("title", "圆月山庄刀魔");
    return;
  } else
    student->set("title", "圆月山庄刀神");
  return;

}
