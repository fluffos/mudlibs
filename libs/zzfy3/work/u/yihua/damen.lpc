// TIE@FY3 ALL RIGHTS RESERVED
inherit ROOM;
void create() {
  set("short", "移花宫");
  set("long", @LONG
一座高大的单檐建筑，门额上悬着一块金字的黑漆方匾：
[33m
       
          移          花          神          殿  	

[37m
LONG
  );
  set("exits", ([
    "south": __DIR__ "shidao3",
    "north": __DIR__ "qiandian",
  ]));
  set("objects", ([
    __DIR__ "npc/shizhe": 1,
    __DIR__ "npc/shizhe1": 1,
  ]));
  set("no_magic", 1);
  set("outdoors", "yihua");
  set("coor/x", -180);
  set("coor/y", 215);
  set("coor/z", 30);
  setup();
}
int valid_leave(object me, string dir) {
  object *inv;
  object ob;
  int i;
  if (userp(me)) {
    if (me->query("class") != "yihua" && dir == "north" && ob = present("shi zhe", this_object())) {
      inv = all_inventory(me);
      for (i = 0; i < sizeof(inv); i++)
        if (inv[i]->query("baipao") && (int)inv[i]->query("equipped"))
          return 1;
      return notify_fail(ob->name() + "向你拱手道：我移花宫与江湖认识交接全靠武功.这位壮士请先过了我们这关!\n");
    }
    return 1;
  } else return 1;
}

void reset() {
  object *inv, ob;
  int i;
  ::reset();
  ob = present("shi zhe", this_object());
  if (ob) ob->set("chat_chance_combat", 50);
  inv = all_inventory();
  if (ob) {
    ob->dismiss_team();
    for (i = 0; i < sizeof(inv); i++)
      if (inv[i]->query("id") == "shi zhe" && inv[i] != ob)
        if (i <= 1)
          ob->add_team_member(inv[i]);
  }
}
