// laodenuo.c 

inherit NPC;
#include <ansi.h>
int send_ring();
void create() {
  set_name("唐方", ({ "tang fang", "fang" }));
  set("nickname", RED "神州结义排行第五" NOR);
  set("long",
    "唐门唐方是唐门年轻一代的高手，是唐老太太最喜欢的孙女。\n");
  set("gender", "女性");
  set("age", 25);
  set("str", 18);
  set("int", 23);
  set("con", 20);
  set("per", 30);
  set("agi", 43);
  set("combat_exp", 100000);
  set("inquiry", ([
    "萧秋水": (: send_ring :),
    "xiao": (: send_ring :), ]));


  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "throwing.tanghua" :),
    (: perform_action, "dodge.rain" :),
    (: perform_action, "throwing.qizigangbiao" :),
    (: ccommand, "love" :),
  }));
  set("attitude", "friendly");
  set("max_force", 5000);
  set("force", 5000);
  set("force_factor", 10);
  set("max_kee", 1500);
  set("max_gin", 999);
  set("max_sen", 699);
  set("eff_kee", 1500);
  set("kee", 1500);
  set("chat_chance", 1);
  set("chat_msg", ({
    "唐方轻声长叹：“萧大哥，你在哪里？\n",
  }));
  set_skill("force", 60);
  set_skill("tangforce", 60);
  set_skill("dodge", 100);
  set_skill("parry", 70);
  set_skill("throwing", 100);
  set_skill("move", 100);

  set_skill("tang-throwing", 120);
  set_skill("tang-steps", 60);

  map_skill("dodge", "tang-steps");
  map_skill("force", "tangforce");
  map_skill("throwing", "tang-throwing");
  create_family("唐门", 24, "弟子");
  setup();
  carry_object(__DIR__ "obj/dart")->wield();
  carry_object(__DIR__ "obj/ring");
}
int send_ring() {
  object ping, me;

  me = this_player();
  say("唐方说道：这位" + RANK_D->query_respect(me) +
    "，你知道萧大哥在哪儿吗？我也正在找他。\n");
  if (ping = present("ring", this_object())) {
    say("唐方又说道：请这位" + RANK_D->query_respect(me) +
      "见着萧大哥时把这个给他。\n");

    ping->move(me);
    message_vision(HIY "$N将一枚戒指交给了$n，又开始叹气了。\n" NOR, this_object(), me);
  }
  return 1;
}
