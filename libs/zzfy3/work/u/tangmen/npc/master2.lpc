// taolord.c

inherit NPC;
#include <ansi.h>
void create()
{
        set_name( "唐老太太" , ({ "master laotai", "master" }) );
        set("nickname",HIB "叱咤唐门，权威女人" NOR);
        set("gender", "女性");
        set("age", 56);
        set("long",
                
"唐老爷子的元配，施放暗器手法一流，无人能看清。\n");

        set("combat_exp", 10000000);
        set("score", 200000);

        set("class", "tangmen");

        set("str", 40);
        set("int", 40);
        set("cor", 40);
        set("cps", 40);
        set("spi", 40);

        set("force",100000);
        set("max_force", 100000);
        set("force_factor", 100);

        set("atman", 1400);
        set("max_atman", 1400);

        set("mana", 4000);
        set("max_mana", 2000);
        set("mana_factor", 5);

        set("apprentice_available", 3);
        set("chat_chance_combat", 80);
       

        create_family("唐门", 3, "掌门");

         set_skill("literate", 150);
        set_skill("magic", 40);
        set_skill("force", 170);
        set_skill("move", 160);
        set_skill("tangforce", 180);
	set_skill("spells",50);
        set_skill("unarmed", 30);
       
        set_skill("parry", 100);
        set_skill("dodge", 170);
        set_skill("throwing", 200);
	set_skill("tang-throwing", 200);
	
        set_skill("tang-steps", 200);
        
        map_skill("throwing", "tang-throwing");
        map_skill("move", "tang-steps");
        map_skill("dodge", "tang-steps");
        map_skill("force", "tangforce");
set("chat_msg_combat", ({
                (: perform_action, "dodge.rain" :), }) );

        set_temp("apply/dodge", 20);
        set_temp("apply/armor", 20);
        setup();

        carry_object(__DIR__"obj/dart")->wield();

}

void attempt_apprentice(object me)
{
	if(this_player()->query_temp("rutangmen"))
	{
	command("say 既是我们唐门的人，好，我收你为徒！\n");
       command("recruit " + me->query("id") );
	}
	else
	command("shake");
	}

void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "tangmen");
}
void init()
{
        add_action("give_quest", "quest");
}

void re_rank(object student)
{
        int exp;
        exp = (int) student->query("combat_exp");
        if( exp <= 32000 ) {
                student->set("title","唐门弟子");
                return ;
        } else if ( exp <= 128000 ) {
                student->set("title","唐门小徒");
                return ;
        } else if ( exp <= 512000 ) {
                student->set("title","唐门小侠");
                return ;
        } else if ( exp <= 1536000 ) {
                student->set("title","唐门大侠");
                return ;
        } else if ( exp <= 3456000 ) {
                student->set("title","唐门魔侠");
                return ;
        } else if ( exp <= 5187000 ) {
                student->set("title","唐门奇侠");
                return ;
        } else if ( exp <= 26244000 ) {
                student->set("title","唐门总管");
                return ;
        } else
                student->set("title","唐门长老");
                return ;
}
 

