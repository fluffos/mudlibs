// laodenuo.c 

inherit NPC;
#include <ansi.h>
void create() {
  set_name("唐十九", ({ "tang shijiu", "shijiu" }));
  set("nickname", RED "九死一生" NOR);
  set("long",
    "唐门唐十九是唐门负责通讯的。\n");
  set("gender", "男性");
  set("age", 50);
  set("attitude", "peaceful");
  set("str", 28);
  set("int", 25);
  set("con", 40);
  set("per", 10);
  set("agi", 35);

  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "throwing.tanghua" :),
    (: perform_action, "dodge.rain" :),
  }));
  set("attitude", "friendly");
  set("max_force", 10000);
  set("force", 10000);
  set("force_factor", 20);
  set("max_kee", 9999);
  set("max_gin", 999);
  set("max_sen", 999);
  set("eff_kee", 9999);
  set("kee", 9999);
  set("chat_chance", 1);
  set("chat_msg", ({
    "唐十九朝天上望了一下。\n",
  }));


  set_skill("force", 70);
  set_skill("tangforce", 80);
  set_skill("dodge", 80);
  set_skill("parry", 90);
  set_skill("throwing", 110);
  set_skill("move", 120);
  set_skill("blade", 50);
  set_skill("tang-blade", 70);
  set_skill("tang-throwing", 100);
  set_skill("tang-steps", 70);

  map_skill("dodge", "tang-steps");
  map_skill("force", "tangforce");
  map_skill("throwing", "tang-throwing");
  map_skill("blade", "tang-blade");
  create_family("唐门", 18, "弟子");
  set("combat_exp", 3670000);
  setup();
  carry_object(__DIR__ "obj/dart")->wield();
}
