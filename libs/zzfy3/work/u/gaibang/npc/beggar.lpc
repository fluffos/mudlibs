// sku@00-11-19 
inherit NPC;
void create() {
  string *name = ({ "老", "年轻", });
  set_name(name[random(sizeof(name))] + "乞丐", ({ "beggar" }));
  set("gender", "男性");
  set("age", random(20) + 32);
  create_family("丐帮", 5, "乞丐");
  set("title", "丐帮一袋弟子");
  set("long", "这是丐帮的乞丐.\n");
  set("vendetta_mark", "wudujiao");
  set("combat_exp", random(100000) + 100000);
  set("attitude", "friendly");
  set_skill("unarmed", 60 + random(100));
  set_skill("dragonstrike", random(100) + 150);
  set_skill("dodge", 100);
  set("chat_chance", 2);
  set("chat_msg", ({
    name() + "说道：教主夫人到底去了那里？！\n",
  }));
  set_skill("move", 80);
  set_skill("force", 200);
  map_skill("unarmed", "dragonstrike");
  set("chat_chance_combat", 10);
  set("force", 500);
  set("chat_msg_combat", ({
    name() + "笑道：非本帮弟子不得入内？！\n",
    (: perform_action, "unarmed.xianglongwuhui" :),
  }));
  set("max_force", 500);
  set("force_factor", 15);
  setup();
  carry_object("/obj/cloth")->wear();
  //       carry_object(__DIR__"obj/book");
}

int accept_object(object who, object ob) {
  if ((int)ob->value() == 50000) {
    say(name() + "掂了掂手中的" + ob->name() + "，笑道：啊？？．．哈哈哈．．\n");
    say(name() + "顺手将" + ob->name() + "揣入了怀中。\n");
    who->set_temp("gaibang", 1);
    return 1;
  } else {
    command("shake");
    return 0;
  }
  return 0;
}
