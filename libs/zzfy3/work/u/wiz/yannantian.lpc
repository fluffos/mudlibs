#include <ansi.h>
inherit NPC;
inherit F_VENDOR;
inherit F_MASTER;
string ask_me();
void create() {
  set_name("燕南天", ({ "master yan", "master", "yan" }));
  set("long",
    "他是小鱼儿的师傅，当代第一大侠，全身经脉震断，气若游丝。\n");
  set("nickname", HIY "血燕惊天" NOR);
  create_family("雁羽门", 3, "门主");
  set("str", 45);
  set("cor", 45);
  set("cps", 45);
  set("agi", 45);
  set("int", 45);
  set("attitude", "friendly");
  set("max_kee", 999999999);
  set("max_sen", 999999999);
  set("max_gin", 999999999);
  set("max_kee", 20000);
  set("max_sen", 20000);
  set("max_gin", 20000);
  set("max_force", 20000);
  set("max_atman", 5000);
  set("max_mana", 6000);
  set("force", 20000);
  set("force_factor", 30);
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({ (: perform_action, "jingtianyijian" :),
    (: perform_action, "jingtianyijian" :), }));
  set("inquiry", ([
    "雁羽门": "雁羽门是我师公天鹰老人所创。 \n",
    "邀月": (: ask_me :),
  ]));
  set("combat_exp", 999999999);
  set_temp("apply/damage", 500);
  set_skill("unarmed", 500);
  set_skill("force", 500);
  set_skill("parry", 500);
  set_skill("dodge", 500);
  set_skill("move", 500);
  set("chat_chance", 200);
  set("chat_msg", ({
    "燕南天说道：若能找到月奴就好了。\n",
    "燕南天说道：邀月还没有死，在那里了，我一定要杀她,为月奴报仇。\n",
  }));

  setup();
  carry_object("/obj/cloth")->wear();
}
string ask_me() {
  object ob;
  if ((int)this_player()->query("combat_exp") < 3000000)
    return RANK_D->query_respect(this_player()) + "你的经验太浅了。";
  if ((int)this_player()->query("kill_yaoyue") == 0)
    return RANK_D->query_respect(this_player()) + "对不起我有心事未了?";
  ob = new("/d/yihua/npc/obj/xueyan");
  ob->move(this_player());
  this_player()->set("for_badp");
  message_vision("$N拿到了飞燕剑。\n", this_player());

  return "好吧，能不能对你有用就看你的造化了。";

}
void attempt_apprentice(object me) {
  switch (random(4)) {
    case 0:
      message_vision("$N对$n道：你拜小鱼儿就可以了，我可是废人？\n", this_object(), me);
      break;
    case 1:
      message_vision("$N对$n道：邀月一天没有死，我都不会死，你回去吧，我不收徒？＂\n", this_object(), me);
      break;
    case 2:
      message_vision("$N对$n道：是什么东西让你这么想拜我为师？\n", this_object(), me);
      break;
    case 3:
      message_vision("$N对$n道：我没有什么值得你去学的，看看我现在就知道了？\n", this_object(), me);
      break;
  }
  return;

}

void recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("class", "yanyu");
}
void re_rank(object student) {
  int exp;
  exp = (int)student->query("combat_exp");
  if (exp <= 5000000) {
    student->set("title", "雁羽门关门弟子");
    return;
  } else
    student->set("title", "雁羽门第三代副门主");
  return;
}
int is_ghost() { return 1; }
