#include <ansi.h>
#include <weapon.h>
inherit SWORD;
void create() {
  set_name(HIR "断掉的飞燕神剑" NOR, ({ "duan-feiyan", "duan-sword" }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("value", 100000);
    set("no_sell", 1);
    set("no_drop", 1);
    set("no_give", 1);
    set("unit", "把");
    set("sxwuqi", 1);
    set("long", "一把红色宝剑,剑身刻有:飞燕两个字。\n");
    set("skill", ([
      "name": "feiyan-shenjian",
      "exp_required": 0,
      "sen_cost": 200,
      "difficulty": 80,
      "max_skill": 1
    ]));
  }
  init_sword(20);
  setup();
}
