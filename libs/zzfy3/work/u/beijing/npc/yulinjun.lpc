//sku@00-11-25 
#include <ansi.h>
inherit NPC;
void create() {
  set_name("[22m御林军[0m", ({ "yu lin jun", "jun" }));
  set("long",
    "这是个正在执行守城任务的军队，负责保护宋朝的天子。\n"
    "他们是有训练有素的部队。\n"
    /*"[31m你最好也不要招惹他们。 [37m\n"  */);
  set("attitude", "heroism");
  set("vendetta_mark", "pksbeijing");
  set("str", 27);
  set("cor", 26);
  set("cps", 25);
  set("combat_exp", 100000 + random(4000000));
  set("chat_chance_combat", 45);
  set("chat_msg_combat", ({
    "御林军喝道：还不快放下武器束手就缚？\n",
    "御林军喝道：天子脚下你竟敢拒捕？反了！反了！\n",
    (: perform_action, "spear.suomengpanhun" :),
  }));

  set_skill("unarmed", 70 + random(100));
  set_skill("spear", 10 + random(50));
  set_skill("parry", 70 + random(100));
  set_skill("dodge", 70 + random(100));
  set_skill("move", 100 + random(100));
  set_skill("duanhun-spear", 151);
  map_skill("spear", "duanhun-spear");
  set_temp("apply/attack", 70);
  set_temp("apply/defense", 70);
  set_temp("apply/damage", 30 + random(200));
  set_temp("apply/armor", 70);
  set_temp("apply/move", 100);

  setup();

  carry_object(__DIR__ "obj/kuijia")->wear();
  carry_object(__DIR__ "obj/spear")->wield();
}

int accept_object(object who, object ob) {
  if ((int)ob->value() >= 1000000) {
    say("御林军呵呵的笑道：好说，好说...\n");
    who->set("vendetta/beijing", 0);
    who->remove_all_killer();
    return 1;
  } else {
    say("御林军说道：天子脚下你想贿赂我。\n");
    return 0;
  }
  return 0;
}
