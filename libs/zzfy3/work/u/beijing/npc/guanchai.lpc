#include <ansi.h>

inherit NPC;

void create() {
  set_name("官差", ({ "guan", "guan chai" }));
  set("long",
    "开封府的官差，专门负责捉拿通缉犯。\n");

  set("attitude", "heroism");
  set("vendetta_mark", "pksbeijing");
  set("pursuer", 1);
  set("intellgent", 1);
  set("str", 40);
  set("cor", 26);
  set("cps", 25);

  set("combat_exp", 500000 + random(500000));

  set_skill("guan-blade", 100 + random(200));
  set_skill("blade", 120 + random(200));
  set_skill("parry", 70 + random(200));
  set_skill("dodge", 70 + random(200));
  set_skill("move", 100 + random(200));

  map_skill("blade", "guan-blade");
  map_skill("dodge", "demon-steps");

  set_temp("apply/attack", 70);
  set_temp("apply/defense", 70);
  set_temp("apply/damage", 30 + random(100));
  set_temp("apply/armor", 70);
  set_temp("apply/move", 100);
  set("chat_chance", 1);
  set("chat_msg", ({
    "风云衙役低声宣道：威～～～～武～～～～\n"
  }));

  setup();

  carry_object(__DIR__ "obj/caifu")->wear();
  carry_object(__DIR__ "obj/dao")->wield();
}
