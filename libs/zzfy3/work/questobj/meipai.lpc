#include <ansi.h>
inherit ITEM;
void create()
{
    set_name(HIM"梅牌"NOR, ({ "meipai" }) );
    set_weight(1);
    if( clonep() )
            set_default_object(__FILE__);
    else {
            set("unit", "块");
            set("material", "stone");
            set("long", "寒梅先生的令牌。\n");
          }

    setup();
}
