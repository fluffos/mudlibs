inherit NPC;
int direct();
void create() {
  set_name("采药老人", ({ "laoren" }));
  set("gender", "男性");
  set("age", 60);
  set("str", 40);
  set("long",
    "这是一个衣装简朴的采药老人．．\n");
  set("combat_exp", 500000);
  set("chat_chance", 2);
  set("chat_msg", ({
    "采药老人自言自语的说道:我小的时跟爷爷采药的时候，见到了一个仙子在花丛上飞？！！\n",
    "采药老人自言自语的说道:她真美呀！我这一辈子都没见到那么漂亮的女人....\n",
  }));
  set("inquiry", ([
    "仙子": (: direct :),
    "xianzi": (: direct :)

  ]));


  set("attitude", "friendly");
  setup();

}

int direct() {
  object me;
  object room;
  me = this_player();
  message_vision("$N老人咳嗽了几声，对$n说：我依稀记得她好象在那边...
的花丛中！！\n", this_object(), me);
  room = load_object("/d/baihuagu/mroom");
  message_vision("$N按着老人指点的方向进入花丛！\n", me);
  me->move(room);
  if (!me->query("m_success/巧遇百花仙")) {
    me->set("m_success/巧遇百花仙", 1);
    me->add("score", 50);

  }

  return 1;
}
