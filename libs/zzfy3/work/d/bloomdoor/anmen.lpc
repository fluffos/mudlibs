inherit ROOM;
#include <room.h>
void create()
{
  set("short","暗门内");
  set("long",@LONG

这是一间暗室，仅有一桌一椅而已。
LONG
  );
  set("exits",([
         "south":__DIR__"huanxisi.lpc",
               ]));
  set("objects", ([
      __DIR__"obj/desk.lpc": 1,
   ]) );
        set("coor/x",0);
        set("coor/y",0);
        set("coor/z",0);
        setup();
        create_door("south", "暗门", "north", DOOR_CLOSED);

}
void reset()
{
   object *inv;
   object item1, item2, desk;
   ::reset();
   desk = present("desk", this_object());
   inv = all_inventory(desk);
   if( !sizeof(inv)) {
      item1 = new(__DIR__"obj/book1");
      item1->move(desk);
      item2 = new(__DIR__"obj/book2");
      item2->move(desk);
   }
}