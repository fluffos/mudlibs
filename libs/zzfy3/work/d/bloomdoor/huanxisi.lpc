#include <room.h>
inherit ROOM;
void create()
{
  set("short","欢喜寺");
  set("long",@LONG
西域的一间寺庙，香火不是很鼎盛，寺庙中供奉的是一
对裸体交媾的神像，名曰欢喜神。蒲团上半卧着一个红光满
面的老和尚。江湖中人都知道。这里其实是专干采花勾当的
血刀门总舵。
LONG
  );
  set("exits",([
         "south":__DIR__"greenland.lpc",
         "north":__DIR__"anmen.lpc",
               ]));
        set("objects", ([
                __DIR__"npc/laozu" : 1,
               ]));
        set("valid_startroom", 1);

        set("coor/x",-1090);
        set("coor/y",-60);
        set("coor/z",0);
        setup();
        create_door("north", "暗门", "south", DOOR_CLOSED);
}
int valid_leave(object me, string dir)
{
        object ob;
        if( dir == "north" && ob=present("xuedao laozu", this_object()))
                return notify_fail("这个方向的路被"+ob->name()+"挡住了 。\n");
        if( dir == "north" && !query("exits/north"))
                return notify_fail("你必须先把暗门打开！\n");
        return 1;
}