inherit ROOM;
#include <command.h>
void create()
{
	 set("short", "湖底");
        set("long", @LONG
这里实在很美，很静。泉水清澈冰凉，各式各样的鱼虾在你的面前悠
闲的游来游去，看著水草在砂石间娥娜起舞，这种感觉不是未曾经历此境
的人所能领略得到的。
LONG
	);
        set("coor/x",0);
	set("coor/y",12150);
	set("coor/z",-20);
	setup();
	
}
void init()
{		
	add_action("do_swim","swim");
if(userp(this_player())) call_out("heal",5+random(1),this_player());
}

int do_swim()
{
   object me;

   me = this_player();
   if (me->is_fighting() ) return 0;
   if (me->is_busy() ) return 0;
   message_vision("$N在水中游起了泳，慢慢地向岸上游去。\n", me);
	
      me->move(__DIR__"seaside.lpc");
return 1;
}

int heal(object me)
{
message_vision("急流太快，你若不快点游过去，就要死在湖底了。。。\n",me);

return 1;
}

