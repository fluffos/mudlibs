// Room: /d/quanli/road.c

inherit ROOM;

void create()
{
	set("short", "水王亭");
	set("long", @LONG
从这儿一直往北走，就能到权力帮了。权力帮是天下第一大帮,很少人有不知道的。
LONG
	);
	set("no_clean_up", 0);
	set("exits", ([ /* sizeof() == 2 */
  "south" : __DIR__"f",
  "north" : __DIR__"h",
]));
set("coor", ([ /* sizeof() == 3 */
  "z" : 0,
  "y" : 12130,
  "x" : 0,
]));

	setup();
	
}
int valid_leave(object me, string dir)
{
if(dir == "north" && !me->query_temp("won_jiexika"))
{
message_vision("只听传来了一阵声音：你没经过水王的同意，是不能进权力帮的。\n",me);
return notify_fail("");
}
return 1;
}
