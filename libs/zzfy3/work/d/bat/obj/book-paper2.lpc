inherit ITEM;
void create() {
  set_name("蝙蝠岛攻防篇", ({ "shu" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long",
      "这是一本薄薄的小册，上面密密麻麻的写满了蝇头小楷，八股文章。\n");
    set("value", 70);
    set("material", "paper");
    set("skill", ([
      "name": "dodge",
      "exp_required": 0,
      "sen_cost": 30,
      "difficulty": 20,
      "max_skill": 50
    ]));
  }
}
