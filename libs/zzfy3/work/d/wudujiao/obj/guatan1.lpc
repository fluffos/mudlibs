inherit ITEM;
void create() {
  set_name("挂毯", ({ "挂毯", "guatan" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("long",
      "赤蝎鳞甲织成的“勤练挂毯”。\n");
    set("value", 70);
    set("material", "stone");
    set("no_shown", 1);
    set("no_get", 1);
    set("no_drop", 1);
    if (random(2))

      set("skill", ([
        "name": "dodge",
        "exp_required": 0,
        "sen_cost": 50,
        "difficulty": 50,
        "max_skill": 49
      ]));
    else
      set("skill", ([
        "name": "unarmed",
        "exp_required": 0,
        "sen_cost": 50,
        "difficulty": 50,
        "max_skill": 49
      ]));
  }
}
