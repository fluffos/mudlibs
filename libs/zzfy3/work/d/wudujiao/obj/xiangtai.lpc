inherit	ITEM;

void create()
{
	set_name("香台", ({ "xiangtai" , "香台"}) );
	set_weight(500);
	set_max_encumbrance(8000);
	set("no_get", 1);
	set("no_shown",	1);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "张");
		set("long", "一张古铜色的香台。\n");
		set("value", 1);
	}
}

int is_container() { return 1; }