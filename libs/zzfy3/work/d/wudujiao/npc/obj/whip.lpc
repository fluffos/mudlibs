// TIE@FY3
#include <weapon.h>
#include <ansi.h>
inherit	WHIP;
void create()
{
	set_name(MAG  "褐蜈鞭" NOR, ({ "hewu whip" }) );
	set_weight(10000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("long", "一把红秉长鞭。\n");
		set("value", 50000);
		set("rigidity",2000);	
		set("material",	"steel");
		set("max_enchant",7);
		set("for_create_weapon",1);
	}
	init_whip(50);

	setup();
}