// TIE@FY3
#include <weapon.h>
#include <ansi.h>
inherit BLADE;
void create() {
  set_name(WHT "墨蛛刀" NOR, ({ "mozhu blade" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "一把绿油油的长柄刀。\n");
    set("value", 50000);
    set("rigidity", 2000);
    set("material", "steel");
    set("max_enchant", 7);
    set("for_create_weapon", 1);
  }
  init_blade(50);

  setup();
}
