// TIE@FY3
#include <weapon.h>
#include <ansi.h>
inherit HAMMER;
void create() {
  set_name(HIW "白蟾锤" NOR, ({ "bc_hammer", "hammer" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "一把白铁做的闪闪发光的大锤。\n");
    set("value", 50000);
    set("rigidity", 2000);
    set("material", "steel");
    set("max_enchant", 7);
    set("for_create_weapon", 1);
  }
  init_hammer(50);

  setup();
}
