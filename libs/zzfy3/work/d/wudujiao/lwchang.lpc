inherit	ROOM;

void create()
{
	set("short", "练武场");
	set("long", @LONG
大厅的一旁是一块空地，是个练武的好地方。空地旁边有个喷泉，
汩汩的清水从喷泉中涌出，五毒教教徒练武渴了，经常饮用泉水来
解渴。
LONG
	);
	set("exits", ([	
  "south" : __DIR__"dt",
  "west" : __DIR__"wuku",
]));
	set("resource/water",1);
	set("outdoors",	"wudujiao");

	set("coor/x",-10);
	set("coor/y",-420);

	set("coor/z",0);
	set("coor/x",-10);
	set("coor/y",-420);
	set("coor/z",0);
	set("coor/x",-10);
	set("coor/y",-420);
	set("coor/z",0);
	setup();
}

void init()
{
	
	add_action("do_fillwater", "fillwater");
}

int do_fillwater(string	arg)
{
	object *list, ob;
	int i, can_fillwater;

	string dir;

	if( !arg || arg=="" ) return notify_fail("你要往什么东西里灌水？\n");
;

	if( arg=="skin"	|| arg=="wineskin" ) {
		list = all_inventory(this_player());
		i = sizeof(list);
		can_fillwater =	0;
		while (i--) {
		  if (((string)list[i]->query("liquid/type") ==	"alcohol")
 || ((string)list[i]->query("liquid/type") == "water")	       ) {
			ob = list[i];			      
			can_fillwater =	1;	
			ob->set("liquid", ([
				"type":	"water",
				"name":	"清水",
				"remaining": 15,
				"drunk_apply": 6,
			]) );

			write("你从喷泉里装满了清水! \n");
			return 1;
		   }
		}
		if (can_fillwater ==0) {
			write("你没有装水的东西啊啊....\n");
			return 1;
		}
	}
	else {
		write("你要往什么东西里灌水？\n");
	}
	return 1;
}