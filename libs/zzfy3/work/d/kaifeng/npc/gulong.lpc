#include <ansi.h>
#define GIVED "jangli1"
inherit NPC;
int give_y2k();
void create() {
  set_name(HIC "古龙" NOR, ({ "gulong" }));
  set("title", HIR "醉卧美人膝" NOR);
  set("gender", "男性");
  set("age", 25);
  set("long", "一代天骄，专门佳奖天下英雄儿女。\n");
  set("combat_exp", 80000000);
  set("attitude", "friendly");
  set("str", 100000);
  set("max_force", 1000000);
  set("force", 1000000);
  set("force_factor", 30000);
  set("max_kee", 999999);
  set("max_gin", 999999);
  set("max_sen", 999999);
  set("eff_kee", 999999);
  set("kee", 999999);
  set_skill("unarmed", 200);
  set_skill("duan-yiyangzhi", 200);
  set_skill("liumaishenjian", 200);
  map_skill("unarmed", "duan-yiyangzhi");
  map_skill("duan-yiyangzhi", "liumaishenjian");
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "duan-yiyangzhi.liumai" :),
  }));

  set("chat_chance", 1);
  set("chat_msg", ({
    "古龙举杯一饮而尽，叹道：好酒！好酒！\n",
  }));
  set("inquiry", ([
    "补偿": (: give_y2k :),
  ]));
  setup();
  add_money("gold", 5000);
  carry_object("/d/fy/npc/obj/whitecloth")->wear();

}

int give_y2k() {
  object obj, me;
  me = this_player();
  if (me->query("mud_age") < 86400) {
    command("say 你连线不够24小时，不能拿千喜红包。\n");
    return 1;
  }
  if (!me->query(GIVED)) {
    obj = new("/d/kaifeng/npc/hongbao.lpc");
    message_vision("古龙轻轻的拍了拍卖$n的头。\n", this_object(), me);
    obj->move(this_player());
    me->set(GIVED, 1);

  } else
    command("say 你已经拿过千喜红包了，不能再拿．\n");
  return 1;
}
