// add by atu for LSFY 2000/01/10
#include <ansi.h>
inherit NPC;
int ask_me();

void create()
{
        set_name("仙鹤花纹", ({ "picture"}) );
        set("gender", "男性" );
        set("age", 34);
        set("long",
                "这是全身都罩在黑纱中的神秘人，全身散发着一股阴森的气息。\n");
        set("max_kee", 5000);
        set("max_sen", 5000);
        set("max_gin", 5000);
        set("max_force", 5000);
        set("force_factor", 500);
        set("combat_exp", 4000000);
        set("attitude", "friendly");
       set("str", 20);
       set("dex", 20);
       set("con", 20);
       set("int", 20);
        set("title", "");
        set_skill("dodge", 500);
        set_skill("unarmed",500);
        set_skill("parry", 500);
        set_skill("force",500);
        set_skill("literate", 500);
        set_skill("changquan", 500);
        set_skill("xiaoyao-steps", 500);
        set_skill("sword", 500);
        set_skill("wuzheng-force", 500);
//        set_skill("jiuyin-baiguzhao", 500);
//        set_skill("yunlong-shenfa", 500);
       
       set("no_see", 1);
       set_weight(5);
       map_skill("force", "wuzheng-force");
       map_skill("dodge", "xiaoyao-steps");
//       map_skill("claw", "jiuyin-baiguzhao");
       map_skill("unarmed", "changquan");
       map_skill("parry", "changquan");
//        prepare_skill("claw","jiuyin-baiguzhao");
        set("chat_chance_combat", 30);
        set("chat_msg_combat", ({
                (: perform_action, "unarmed.yuhuan" :),
//                (: exert_function, "recover" :),
       }) );
        setup();
}

void init()
{       
        object ob,obj;
       int maxskill;
//      ::init();
        if( interactive(ob = this_player()) && !this_object()->query_temp("kf_inited")) {
       this_object()->set_temp("kf_inited",1);
       obj=this_object();
       maxskill=query("maxskill");
        set_skill("dodge", maxskill);
        set_skill("unarmed", maxskill);
        set_skill("parry", maxskill);
        set_skill("sword", maxskill);
        set_skill("force", maxskill);
//        set_skill("claw", maxskill);
        set_skill("sixsun-strike", maxskill);
        set_skill("xiaoyao-steps", maxskill);
        set_skill("wuzheng-force", maxskill);
//        set_skill("yunlong-shengong", maxskill);
//        carry_object("/clone/weapon/changjian")->wield();
       obj->set("title","开元神偷");
       obj->set_weight(500000);
        set_name("李元奎", ({ "li yuankui","li"}) );
        remove_call_out ("destroy_npc");
        call_out ("destroy_npc", 900); // 15 min
        }
}
void destroy_npc()
{
        message_vision("" + (string)this_object()->query("name") + "忽然打了个哆嗦，不由心生惧意，身形一晃，顿时混入莽莽人海之中。\n", environment(this_object()));
        destruct(this_object());
}
//int active_died()
void die()
{
        object ob,me;
        string own;
    message_vision("$N倒在地上，死了！\n", this_object());
    ob = this_object();
    own = ob->query_temp("kf_ownname");
    if(own) me = find_player(own);
    if ( me && ob->query_temp("last_damage_from")==me){
        if (ob->query_temp("kf_npc")==me->query_temp("kf_npc"))
               me->set_temp("kf_finish",1);
     }
        destruct(this_object());
}

