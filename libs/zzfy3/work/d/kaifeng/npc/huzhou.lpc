#include <ansi.h>
inherit NPC;
int gethelp();
void create()
{
        set_name(HIC "天风" NOR, ({"player huzhou"}) );
        set("title",HIR "郑州风云第一带混混" NOR);
        set("gender", "男性" );
        set("age", 25);
        set("long","混到如今了。\n");
        set("combat_exp", 20000000);
        set("attitude", "friendly");
        set("str",100000);
        set("max_force",1000000);
        set("force",1000000);
        set("force_factor", 30000);
        set("max_kee",999999);
        set("max_gin",999999);
        set("max_sen",999999);
        set("eff_kee",999999);
        set("kee",999999);
        set_skill("unarmed", 200);
        set_skill("duan-yiyangzhi",200);
        set_skill("liumaishenjian",200);
        map_skill("unarmed","duan-yiyangzhi");
        map_skill("duan-yiyangzhi","liumaishenjian");
        set("chat_chance_combat", 90);
        set("chat_msg_combat", ({
                (: perform_action, "duan-yiyangzhi.liumai" :),
        }) );

        set("chat_chance", 1);
        set("chat_msg", ({
                "天风哭丧着脸说：擦干眼泪，奋起再混！！。\n",
                        }) );
        set("inquiry", ([
"帮助" : (:gethelp:),
        ]));
        setup();
        add_money("gold", 5000);
        carry_object("/d/fy/npc/obj/whitecloth")->wear();


}

void gethelp()
{
	object ob;
 ob=this_player();
 command("say 难得老弟不嫌弃在下，那我就陪你江湖一游。\n");
command("follow %s",ob->query("id"));
}

void followhim(object ob)
{
object room;
if( present(ob, environment()))
{       set_leader(ob);
      ob->set("marks/老刘", 1);
}
}
void goaway()
{
destruct(this_object());
}
