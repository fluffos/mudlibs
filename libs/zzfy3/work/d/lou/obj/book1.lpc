// huanyublade-book.c

inherit ITEM;

void create() {
  set_name("幻雨秘籍", ({ "book" }));
  set_weight(5);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long",
      "这本秘籍的纸张都已经破烂不堪了，上面隐约可以看清有一些图解\n"
      "似乎是幻雨刀法的入门图解。\n");
    set("value", 50000);
    set("material", "paper");
    set("skill", ([
      "name": "huanyu-blade",
      "exp_required": 0,

      "sen_cost": 40,
      "difficulty": 30,
      "max_skill": 50
    ]));
  }
}
