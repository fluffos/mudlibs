//liuyun-steps.c

inherit	ITEM;

void create()
{
	set_name("流云秘籍", ({	"book" }));
	set_weight(5);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "本");
		set("long",
			"这本秘籍的纸张都已经破烂不堪了，上面隐约可以看清有一些图形\n"
			"似乎是似乎是江湖中传闻已久的流云步法图解。\n");
		set("value", 50000);
		set("material",	"paper");
		set("skill", ([
			"name":			"liuyun-steps",	
			"exp_required":	0,				

			"sen_cost":		40,				
			"difficulty":	30,		
			"max_skill":	50		
		]) );
	}
}