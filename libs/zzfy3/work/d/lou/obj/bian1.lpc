//lmd@wenxin
#include <ansi.h>

inherit ITEM;

void create() {
  set_name("牌匾", ({ "bian", "匾" }));
  set_weight(500);
  set_max_encumbrance(800);
  set("no_get", 1);
  set("no_shown", 1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("long", HIY " 一块金漆大匾上写着：\n\n" NOR + HIW "			    观云台\n " NOR);
    set("value", 1);
  }
}


int is_container() { return 1; }
