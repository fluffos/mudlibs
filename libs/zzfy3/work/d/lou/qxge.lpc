inherit	ROOM;
#include <ansi.h>
void create()
{
	set("short", "清馨阁");
	set("long", @LONG
这里是耗子的工作间，屋子不算太大。一张很大的电脑桌上放着一台笔记本电脑。
几张光盘，和几本小说零星的放在旁边。几盆热带花木错落有秩的放在屋子的各个角
落。从花木中散发出的清新让人有种说不出的舒服感。
一张条幅横挂在雪白的墙上，上面草草的写着：

		  ┏━━━━━━━━━┓
		  ┃	 清 馨 阁     ┃
		  ┗━━━━━━━━━┛


LONG
	);
	set("exits", ([	
 "down"	: __DIR__"jobroom",

]));
	set("objects", ([
	__DIR__"obj/gui" : 1,
			]) );
	set("outdoors",	"fengyun");

	set("coor/x",0);
	set("coor/y",0);
	set("coor/z",50);
	setup();
}
void reset()
{
	object *inv;
	object con, item;
	::reset();
	con = present("gui", this_object());
	inv = all_inventory(con);
	if( !sizeof(inv)) {
	item = new(__DIR__"obj/book");

	item->move(con);
	}
}