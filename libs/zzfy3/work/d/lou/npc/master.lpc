inherit NPC;
inherit F_MASTER;
#include <ansi.h>
int kill_him();
void create() {
  set_name("独孤天虹", ({ "master hong", "master" }));
  set("nickname", HIW "八方云雨" NOR);
  //  set("vendetta_mark","shaolin");
  set("gender", "男性");
  set("age", 51);
  set("agi", 50);
  set("cps", 100);
  set("str", 100);
  set("per", 35);
  set("int", 30);
  set("attitude", "friendly");
  set("max_force", 15000);
  set("force", 15000);
  set("kee", 150000);
  set("max_kee", 150000);
  set("gin", 150000);
  set("max_gin", 150000);
  set("sen", 150000);
  set("max_sen", 150000);

  set("force_factor", 250);
  set("max_mana", 15000);
  set("mana", 15000);
  set("max_atman", 15000);
  set("atman", 15000);
  set("long",
    "
清风细雨楼楼主，他的武功高深莫测，武林中难封敌手。\n"
  );
  create_family("清风细雨楼", 1, "楼主");
  set("chat_chance_combat", 20);
  set("chat_msg_combat", ({
    (: perform_action, "blade.liuyunxiyu" :)
  }));
  set("combat_exp", 10000000);
  set_skill("move", 150);
  // set_skill("parry",150);
  set_skill("dodge", 150);
  set_skill("force", 180);
  set_skill("literate", 120);

  set_skill("unarmed", 180);
  set_skill("liuyun-steps", 150);
  set_skill("yingfengzhi", 150);
  set_skill("cloudforce", 150);
  set_skill("huanyu-blade", 130);
  set_skill("blade", 150);
  map_skill("dodge", "liuyun-steps");
  map_skill("force", "cloudforce");
  map_skill("unarmed", "yingfengzhi");
  // map_skill("parry","huanyu-blade");
  map_skill("blade", "huanyu-blade");
  setup();
  //	  carry_object(__DIR__"obj/monk_cloth")->wear();
  carry_object(__DIR__ "obj/long-blade")->wield();

}

void attempt_apprentice(object me) {
  //if(me->query("gender") != "男性")

  //{
  //command("say 本楼主只收男弟子。。。\n");
  //return;
  //}
  if (me->query_temp("won_master_yan")) {
    command("smile");
    command("recruit " + me->query("id"));
    return;
  } else {
    command("shake");
  }
}

void recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("glass", "lou");

}
void re_rank(object student) {
  student->set("title", "清风细雨楼副楼主");
  return;

}
int accept_fight(object me) {
  if (me->query("family/family_name") == query("family/family_name") &&
    me->query("family/master_id") == query("id")) {
    command("say 好，胜了我,你就可在江湖中扬名立腕万了！\n");
    return 1;
  } else {
    command("say 螳臂当车，快点在本楼主眼前消失，不然。。。。\n");
    return 0;
  }

}
void win_enemy(object loser) {
  command("say 徒儿还要努力呀，你离青出于蓝还远着呢！\n");
}
void lose_enemy(object winner) {
  command("say 好！好！好！我终于教出了个象样的徒弟。\n");
  winner->set_temp("won_master", 1);
}
