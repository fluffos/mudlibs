// dizi1.c
#include <ansi.h>

inherit	NPC;

string kill_passenger(object who);

void create()
{
	set_name("青龙堂守库弟子", ({ "dizi" })	);
	set("gender", "男性" );
	set("title", HIC "一指青龙" NOR);
	set("age", 27);
	set("str", 27);
	set("int", 12);
	set("per", 10);
	set("max_kee", 10000);
	set("long", @LONG
他是二十多岁的精明强干的青龙堂弟子，由于武功非常出众，又是楼主的亲信所以

被派来看守宝库。
LONG
);
	set("attitude",	"killer");

	set("combat_exp", 700000);
	set("bellicosity", 3000	);
	set("chat_chance", 50);
	set("chat_msg",	({
"没有手谕，竟敢善闯本教禁地！！！\n",
	 }) );
	set_skill("unarmed", 90);
	set_skill("dodge", 90);
	set_skill("parry", 90);
	set_skill("liuyun-steps",50);  
	set_skill("yingfengzhi",80);
	map_skill("unarmed","yingfengzhi");
	map_skill("dodge", "liuyun-steps");
	set("score", 100);


	setup();

	add_money("gold", 5); 
}
void init()
{
	object ob;
	::init();
	if( interactive(ob = this_player()) ) {
	message_vision("竟敢善闯本教禁地,否则就是死！！！\n",ob);
		kill_ob(ob);
	}
}