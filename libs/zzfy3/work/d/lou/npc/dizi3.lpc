inherit NPC;

void create() {
  set_name("巡楼弟子", ({ "dizi" }));
  set("gender", "男性");
  set("age", 20);
  set("long", "一名精明强干的细雨楼的弟子，警惕的巡视着四周。\n");
  set("combat_exp", 400000);
  set("int", 30);
  set("str", 27);
  set("force", 200);
  set("force_factor", 50);
  set("max_force", 200);
  set("force_factor", 30);
  set("chat_chance", 30);
  set("chat_msg", ({
    "堂主交给我这个重任，我一定办好。\n",
    "巡楼弟子围着你转了一圈问到：今天的口令是什么？\n",

    (: random_move :),
    (: random_move :),
    (: random_move :),
  }));
  set_skill("blade", 60);
  set_skill("huanyu-blade", 50);
  set_skill("force", 60);
  set_skill("parry", 60);
  set_skill("move", 60);
  set_skill("liuyun-steps", 60);
  map_skill("move", "liuyun-steps");
  map_skill("parry", "huanyu-blade");
  map_skill("blade", "huanyu-blade");
  setup();
  //	  carry_object(__DIR__"obj/greencloth")->wear();
  carry_object(__DIR__ "obj/blade")->wield();
}
