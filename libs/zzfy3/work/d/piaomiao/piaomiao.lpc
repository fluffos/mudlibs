#include <room.h>
inherit ROOM;
void create() {
  set("short", "缥缈峰");
  set("long", @LONG
这里便是缥缈峰了。整个山峰终年云封雾锁，远远望去，若有
若无，因此叫作缥缈峰。此峰十分险要，仅有一条小路通往峰顶，
且有十八天险，攀登此峰九死一生。
LONG
  );
  set("exits", ([
    "southdown": "d/chenxiang/cxs1.lpc",
    "northup": __DIR__ "duanhun.lpc",
  ]));

  set("outdoors", "piaomiao");
  set("coor/x", 0);
  set("coor/y", 0);
  set("coor/z", 0);

  setup();
  replace_program(ROOM);
}
