// cloth.c
//

#include <armor.h>

inherit CLOTH;
#include <ansi.h>
void create() {
  set_name("彩衣", ({ "color cloth" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "一件五彩丝编成的衣服\n");
    set("material", "cloth");
    set("value", 5000);
    set("armor_prop/armor", 30);
  }

  setup();
}
