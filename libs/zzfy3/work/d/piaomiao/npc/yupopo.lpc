// yupopo.c
inherit NPC;
void create() {
  set_name("余婆婆", ({ "yu popo" }));
  set("gender", "女性");
  set("age", 59);
  set("str", 20);
  set("per", 6);
  set("max_force", 1500);
  set("force", 1500);
  set("long", @LONG
    余婆婆是灵鹫宫的管家,负责打点整个灵鹫宫的大小事物.
LONG
  );
  set("combat_exp", 1000000);
  set("attitude", "friendly");
  set("chat_chance", 5);
  set("chat_msg", ({
    "余婆婆向你喝到:你是何人?为何擅闯灵鹫宫! \n",


  }));
  set_skill("unarmed", 100);
  set_skill("parry", 50);
  set_skill("sixsun-strike", 80);
  set_skill("move", 100);
  map_skill("unarmed", "sixsun-strike");
  set("chat_chance_combat", 15);
  set("chat_msg_combat", ({
    "余婆婆喝道：你当这里是什么地方，敢来这里撒野？\n",
  }));
  setup();
  carry_object(__DIR__ "obj/color_skirt")->wear();
}
