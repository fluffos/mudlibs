inherit NPC;
inherit F_MASTER;
#include <ansi.h>
void create() {
  set_name("虚竹子", ({ "master xuzhu", "master", "master	xuzhu" }));
  set("nickname", HIW "西夏驸马" NOR);
  set("gender", "男性");
  set("age", 32);
  set("str", 40);
  set("cor", 30);
  set("cps", 30);
  set("int", 30);
  set("per", 30);
  set("agi", 30);
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed.xianqingtian" :),
    (: perform_action, "move.zizaixiaoyao" :),
  }));

  set("attitude", "friendly");
  set("max_force", 5000);
  set("force", 5000);
  set("force_factor", 30);
  set("max_kee", 2300);
  set("max_gin", 2300);
  set("max_sen", 2300);
  set("eff_kee", 2300);
  set("kee", 2300);
  set("chat_chance", 1);
  set("long",
    "一心向佛却尘缘未了的和尚,虽然长的不出众,但
是他的一身绝世武功不容小视\n");
  create_family("灵鹫宫", 2, "宫主");
  set("combat_exp", 20000000);
  set("score", 200000);

  set_skill("move", 100);
  set_skill("parry", 120);
  set_skill("dodge", 100);

  set_skill("force", 150);
  set_skill("literate", 100);
  set_skill("unarmed", 150);
  set_skill("scratching", 80);
  set_skill("sixsun-strike", 100);
  set_skill("xiaoyao-steps", 100);
  map_skill("dodge", "xiaoyao-steps");
  map_skill("unarmed", "sixsun-strike");
  map_skill("move", "xiaoyao-steps");


  setup();
  carry_object(__DIR__ "obj/free_ring")->wield();

}

void attempt_apprentice(object me) {
  command("recruit " + me->query("id"));
}


void recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("class", "piaomiao");
}

void re_rank(object student) {
  int exp;
  exp = (int)student->query("combat_exp");
  if (exp <= 32000) {
    student->set("title", "灵鹫宫弟子");
    return;
  } else if (exp <= 128000) {
    student->set("title", "八部副领班");
    return;
  } else if (exp <= 512000) {
    student->set("title", "八部领班");
    return;

  } else if (exp <= 1536000) {
    student->set("title", "灵鹫宫账房");
    return;
  } else if (exp <= 3456000) {
    student->set("title", "灵鹫宫管家");
    return;
  } else if (exp <= 5187000) {
    student->set("title", "灵鹫宫大管家");
    return;
  } else if (exp <= 26244000) {
    student->set("title", "灵鹫宫总管");
    return;
  } else
    student->set("title", "灵鹫宫副宫主");
  return;

}
