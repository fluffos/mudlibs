inherit	NPC;
#include <ansi.h>
void create()
{
	set_name("兰剑", ({ "lanjian" }) );
	set("gender", "女性" );
	set("title", HIY "灵鹫四婢" NOR);
	set("age", 22);
	set("max_force", 1500);
	set("force", 1500);
	set("long",
		"一个面目清秀的妙龄少女\n");
	set("combat_exp", 2000000);
	set("attitude",	"friendly");
	set("per",30);
	set("str",20);
	set("chat_chance", 5);
set("chat_msg",	({
"兰剑说到:宫主以德服人,灵鹫宫上上下下都敬佩万分! \n",


	}) );
	set_skill("unarmed",80);
	set_skill("sword",100);
	set_skill("dodge",85);
	set_skill("parry",85);
	setup();
	carry_object(__DIR__"obj/color_cloth")->wear();
	carry_object(__DIR__"obj/lingjiu_sword")->wield();
}