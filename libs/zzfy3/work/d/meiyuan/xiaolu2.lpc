inherit ROOM;
#include <ansi.h>
void create() {
  set("short", HIY "小路" NOR);
  set("long", @LONG
一条幽静小路。全是用青石子铺成的。路的两旁全是梅花。
现在正值梅花盛开季节，满眼美丽的梅花。使人用情，令人陶
醉。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "south": __DIR__ "xiaolu",
    "north": __DIR__ "huayuan"
  ]));

  set("coor/x", -640);
  set("coor/y", -490);
  set("coor/z", 30);
  setup();

}
