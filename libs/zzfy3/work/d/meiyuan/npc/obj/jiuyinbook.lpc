// XXDER
inherit ITEM;
void create() {
  string *names = ({
    "《九阴真经》[ 上册 ]",
  });

  set_name(names[random(sizeof(names))], ({ "jiuyin-book" }));
  set_weight(600);
  set("unit", "本");
  set("long", "天下第一武学奇书。\n");
  set("value", 1000000);
  set("skill", ([
    "name": "force",      //	name of	the skill
    "exp_required": 0,    // minimum combat experience required
    // to learn this skill.
    "sen_cost": 40,    // gin cost every time study this
    "difficulty": 50,    // the base int	to learn this skill
    // modify is gin_cost's	(difficulty - int)*5%

    "max_skill": 200     // the	maximum	level you can learn
    // from	this object.
  ]));
}
