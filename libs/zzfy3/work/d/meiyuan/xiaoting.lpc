inherit ROOM;
#include <ansi.h>
void create() {
  set("short", HIC "沧浪亭" NOR);
  set("long", @LONG
这小亭是个下棋的好地方。亭中摆着四个石凳和一张
石桌，石桌上刻着一张棋盘，桌角放着上好的云子。亭中
悬下一根细绳，绳子上绑一木片，上书“请勿高声”，木
片随风摇摆。小亭上挂着一块木匾

		  ┏━━━━━━━━━┓
		  ┃   沧   浪	亭    ┃
		  ┗━━━━━━━━━┛

LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "out": __DIR__ "xiaohu",


  ]));

  set("coor/x", -640);
  set("coor/y", -490);
  set("coor/z", 30);
  setup();
  replace_program(ROOM);
}
