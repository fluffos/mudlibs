inherit	ROOM;
void create()
{
	set("short", "潭边");
	set("long", @LONG
你现在正站在一个深不见底的水潭边上，一条白练般的瀑
布从数百丈高的悬崖上冲激而下，直注潭中，水花溅得你全身
湿透四周陡峭的山壁近乎直立，抬头只见一个半圆形的天空。
LONG
	);
	set("exits", ([	/* sizeof() == 1 */
  "north" : __DIR__"yading.lpc",
]));
	set("item_desc", ([
		"mountain": "潭水深不见底，但是瀑布后面好像别有洞天。你似乎可以试着游(swim)过去。\n",
		"瀑布":	"潭水深不见底，但是瀑布后面好像别有洞天。你似乎可以试着游(swim)过去。\n",
		"waterfall": "潭水深不见底，但是瀑布后面好像别有洞天。你似乎可以试着游(swim)过去。\n",
	]) );
	set("outdoors",	"moondoor");
	set("coor/x",0);

	set("coor/y",0);
	set("coor/z",0);
	setup();
}
void init()
{
	add_action("do_swim", "swim");
}
int do_swim(string arg)
{
	object obj;
	object me;
	if(!arg	|| arg=="")
	{
		write("你要向哪里游？\n");
		return 1;
	}
	if( arg	== "瀑布" || arg == "mountain" || arg == "waterfall")
	{
	me = this_player();

	message_vision("$N慢慢地向瀑布后面游去。\n", me);
	me->move(__DIR__"pubu.lpc");
	return 1;
	}
	else
	{
		write("你不可以游"+arg+"\n");
		return 1;
	}
}