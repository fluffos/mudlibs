inherit ROOM;
void create() {
  set("short", "崖顶");
  set("long", @LONG
你现在正站在崖顶的岩石上，两边的山壁看起来又高又陡，
看来要爬上来实在很不容易，即使是轻功绝顶的高手也跃不上
来。崖上落脚处似乎可以帮上忙。南边是一个深不见底的水潭
北边崖壁上则有一个山洞。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "south": __DIR__ "tanbian.lpc",
    "north": __DIR__ "shandong.lpc",
  ]));
  set("item_desc", ([
    "mountain": "悬崖虽陡，但还有落脚之处。你似乎可以试着爬(climb)下去。\n",
    "悬崖": "悬崖虽陡，但还有落脚之处。你似乎可以试着爬(climb)下去。\n",
    "down": "悬崖虽陡，但还有落脚之处。你似乎可以试着爬(climb)下去。\n",
  ]));

  set("outdoors", "moondoor");
  set("coor/x", 0);
  set("coor/y", 0);
  set("coor/z", 0);
  setup();
}
void init() {
  add_action("do_climb", "climb");
}
int do_climb(string arg) {
  object obj;
  object me;
  if (!arg || arg == "") {
    write("你要爬什么？\n");
    return 1;
  }
  if (arg == "悬崖" || arg == "mountain" || arg == "down")

  {
    me = this_player();
    message_vision("$N慢慢地往悬崖下爬去。\n", me);
    me->move(__DIR__ "haidao.lpc");
    return 1;
  } else {
    write("你不可以爬" + arg + "\n");
    return 1;
  }
}
