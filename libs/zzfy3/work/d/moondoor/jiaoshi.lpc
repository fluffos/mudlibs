// seaside.c
inherit	ROOM;
void create()
{
	set("short", "礁石背面");
	set("long", @LONG
这是一块大礁石的背面，不知谁藏了一条小船。
LONG
	);
	set("exits", ([	
//  "down" : __DIR__"boat",

]));
	set("outdoors",	"moondoor");
	set("coor/x",1000);
	set("coor/y",110);
	set("coor/z",-10);
	setup();
}


void init()
{
   add_action("do_around", "around");
   add_action("do_push", "push");
}

int do_around(string arg)
{
   object me, room;

 if(!arg || arg=="")
  {
   write("你要绕过什么？\n");
   return 1;
  }
 if( arg == "礁石" || arg == "stone" ||	arg == "jiaoshi")
  {
   me =	this_player();
   message_vision("$N转到礁石前面！！\n", me);
   room	= find_object(__DIR__"haidao");

   if(!objectp(room)) room=load_object(__DIR__"haidao");
   me->move(room);
   return 1;
  }
  else
   {
    write("你不可以绕过"+arg+"\n");
    return 1;
   }
}

int do_push(string arg)
{
 object	boat;
 object	me,oob;
 int i;

 if(!arg || arg=="")
  {
   write("你要推什么？\n");

   return 1;
  }
 if( arg == "小船" || arg == "boat" || arg == "chuan")
  {
   me =	this_player();
   message_vision("$N奋力把小船推到海里。\n", me);
  }
  else
   {
    write("你不可以推"+arg+"\n");
    return 1;
   }
	
 if (query("exits/down")) return 1;
 if (!objectp(boat=find_object(__DIR__"boat")))
  boat=load_object(__DIR__"boat");
 boat->set("exits/up",__DIR__"haidao");
 boat->set("no_fight",1);
 boat->set("no_magic",1);
 set("exits/down",__DIR__"boat");

 boat->set_temp("mark/dest","gangwan1");
 call_out("boat_leave",10,boat);
 return	1;
}

void boat_leave(object boat)
{
	if (query("exits/down")) delete("exits/down");
	if (boat->query("exits/up")) boat->delete("exits/up");
	message("vision","小船被海水冲上了海岸。\n",this_object()); 
	message("vision","你拿起了船桨划离了海边。\n",boat);
	boat->delete("no_fight");
	boat->delete("no_magic");
	boat->boat_run(0);
}