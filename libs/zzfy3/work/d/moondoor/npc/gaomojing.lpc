#include <ansi.h>
inherit	NPC;

int send_fan();

void create()
{
	set_name("高莫静", ({ "gao mojing", "mojing" })	);
	set("gender", "女性");
	set("age", 24);
	set("long",
		"一个容貌娇好，但双眼失明，双腿残废且左臂枯瘦且发
黑的女子。\n"
	);
	set("attitude",	"peaceful");
	set("combat_exp", 10000000);
	set("env/wimpy", 100);
	set("inquiry", ([
		"婴儿" : (: send_fan :),
		"芮玮" : "他的儿子被我从潭中救起，可是我却无法还给他。"

	]) );
	setup();
	carry_object(__DIR__"obj/kid");
}

int send_fan()
{
	object bag, me;

	me = this_player();
	say("高莫静说道：这个婴儿是月形门掌门芮玮的独子,此子名为芮纪野。\n");
	if( bag	= present("kid", this_object())) {
		say("高莫静停了一下又说道：如果这位" + RANK_D->query_respect(me) +
			"可以把他交还给芮玮,小女子感激不尽.\n");
		bag->move(me);
		message_vision(HIY "$N将一个婴儿交给了$n。\n" NOR, this_object(), me );
	}
	return 1;
}