#include <ansi.h>
#include <weapon.h>
inherit	RING;
void create()
{
	set_name( HIY "金丝手套" NOR, ({ "jinsi" }) );
	set_weight(7000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "只");
		set("long", "这是一只用金丝编织而成的金色手套。\n");
		set("timestamp","jbaofom");
		set("rigidity",50);
		set("value", 10000);
		set("material",	"gold");
		set("wield_msg", "$N从怀中摸出一只$n戴在左手上。\n");
		set("unwield_msg", "$N将左手上的$n藏入怀中。\n");
	}
	init_ring(20);

	setup();
}