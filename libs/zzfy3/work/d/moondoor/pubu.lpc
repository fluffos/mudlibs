inherit	ROOM;
void create()
{
	set("short", "瀑布后");
	set("long", @LONG
原来瀑布后面竟然别有洞天．从悬崖而下的注入水潭的瀑
布挡住了这个山洞．由于阳光透过瀑布照射到山洞里，所以光
线昏暗，能见度及低．山洞里有个模糊的黑影，你定睛一看，
竟然是一个怀抱婴儿的女子.
LONG
	);
	set("item_desc", ([
		"mountain": "潭水深不见底，你似乎可以试着游(swim)回去。\n",
		"水潭":	"潭水深不见底，你似乎可以试着游(swim)回去。\n",
		"tan": "潭水深不见底，你似乎可以试着游(swim)回去。\n",
	]) );
	set("objects", ([
		__DIR__"npc/gaomojing" : 1	 
	]) );
	set("outdoors",	"moondoor");

	set("coor/x",0);
	set("coor/y",0);
	set("coor/z",0);
	setup();
}
void init()
{
	add_action("do_swim", "swim");
}
int do_swim(string arg)
{
	object obj;
	object me;
	if(!arg	|| arg=="")
	{
		write("你要向哪里游？\n");
		return 1;
	}
	if( arg	== "水潭" || arg == "mountain" || arg == "tan")
	{

	me = this_player();
	message_vision("$N慢慢地游了回去。\n", me);
	me->move(__DIR__"tanbian.lpc");
	return 1;
	}
	else
	{
		write("你不可以游"+arg+"\n");
		return 1;
	}
}