// copy to /d/wsc/npc/obj/zipao.c
#include <armor.h>
#include <ansi.h>
inherit CLOTH;
void create()
{
	set_name(MAG "紫袍" NOR, ({ "zipao" }) );
	set_weight(3000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("material", "cloth");
		set("value", 50000);
		set("armor_prop/armor", 30);
	}
	setup();
}
