// copy to /d/wsc/npc/obj/dysword.c
#include <weapon.h>
#include <ansi.h>
inherit SWORD;
void create() {
  set_name(HIB "大禹剑" NOR, ({ "dysword" }));
  set_weight(15000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这把剑形式古朴，相传是大禹治水时的佩剑。\n");
    set("value", 400000);
    set("material", "steel");
  }
  init_sword(75);
  set("wield_msg", "$N「唰」地一声抽出一把$n握在手中。\n");
  set("unwield_msg", "$N将手中的$n插入腰间的剑鞘。\n");
  setup();
}
