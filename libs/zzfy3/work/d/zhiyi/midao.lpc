// copy to /d/wsc/midao.c
inherit ROOM;
void create()
{
        set("short", "密道");
        set("long", @LONG
密道里并不象一般的地道一样阴暗潮湿，两旁的墙壁上点着几盏长明
灯。在密道的尽头，有一扇精钢所制的门，门上有一个小孔(hole),似乎
刚好可以放一把钥匙进去。
LONG
        );
	set("no_fight",1);
	set("no_magic",1);
	set("no_spells", 1);
        set("exits", ([ 
        "out" : __DIR__"hkting",

]));

        set("item_desc", ([
                "hole": "很明显这是个钥匙孔，如果你有钥匙，就应该很容易打开(open)门了。\n",
                "小孔": "很明显这是个钥匙孔，如果你有钥匙，就应该很容易打开(open)门了。\n",

        ]) );
        set("coor/x",1010);
	set("coor/y",-310);
	set("coor/z",0);
	setup();
}
void init()
{
        add_action("do_open", "open");
}
int do_open(string arg)
{
        object obj;
        object me;
        if(!arg || arg=="")
        {
                write("你要打开什么？\n");
                return 1;
        }
        if( arg == "door" || arg == "门" )
	{
	me = this_player();
	obj = me->query_temp("weapon");
	if( !obj ) 
	{
	write("你手中没有钥匙，怎么开门？\n");
	return 1;
	}
	if( obj->query("turekey"))
	{
	if( !query("exits/north") ) {
        set("exits/north", __DIR__"mishi");
	message_vision(sprintf("$N将密室钥匙插入小孔中，轻轻地转了转，只听'嗒'的一声，门开了！！\n",obj->name()),
		me);
	destruct(obj);
        call_out("close_path", 5);
	}
	}
	else
 	message_vision(sprintf("$N将手中的%s插到小孔中去，但不管怎么转，还是一点动静也没有．\n",obj->name()),
		me);
	}
	else
	 write("你要打开什么？\n");
                return 1;
}
void close_path()
{
        if( !query("exits/north") ) return;
        message("vision",
"只听传来一声异响，门又自动关上了。\n",
                this_object() );
                delete("exits/north");
}
