string chinese_number(int i) {
  return CHINESE_D->chinese_number(i);
}

string to_chinese(string str) {
  return CHINESE_D->chinese(str);
}

int is_chinese(string str) {
  // AGENTS.md §15h: this driver's strings are native UTF-8 codepoints,
  // not GBK bytes -- str[0] is a full CJK codepoint here, not a lead byte,
  // and strlen() counts characters, not bytes. Old GBK byte-range check
  // (str[0] > 160 && str[0] < 255, strlen>=2 meaning "at least 1 full
  // 2-byte character") replaced with a CJK Unicode codepoint range check.
  if (strlen(str) >= 1 && str[0] >= 0x4e00 && str[0] <= 0x9fff) return 1;
  return 0;
}
