#pragma optimize
#pragma save_binary


//仓库存盘字段
//只需要将相同属性有不同设置的或原属性会有可能发生改变的做存储即可 by luoyun  2013.4.19 优化
string query_save_prop_string(object item) {
  string prop, result;
  mapping sx, sla;
  string *shuxing, *slb;
  int point, k;
  result = "";

  reset_eval_cost();
  if (prop = item->query("name")) result += sprintf("name:%s,", prop);  //中文名字
  if (prop = item->query("id")) result += sprintf("id:%s,", prop);  //英文ID
  if (point = item->query("backold_weapon_prop")) result += sprintf(
    "backold_weapon_prop:%d,",
    point
  );  //待修兵器标志
  if (point = item->query("backold_armor_prop")) result += sprintf("backold_armor_prop:%d,", point);  //待修防具标志
  if (point = item->query("long_bei")) result += sprintf("long_bei:%d,", point);  //损坏标志
  if (point = item->query("value")) result += sprintf("value:%d,", point);  //价值
  if (point = item->query("item_old_value")) result += sprintf("item_old_value:%d,", point);  //待修复的价值
  if (point = item->query_weight()) result += sprintf("weight:%d,", point);  //装备重量
  if (point = item->query_amount()) result += sprintf("amount:%d,", point);  //叠加数量
  if (point = item->query("is_wiz_level")) result += sprintf("is_wiz_level:%d,", point);  //WIZ使用clone产生的物品等级（与WIZ权力等级相同）
  if (point = item->query("xyzx_save_item")) result += sprintf("xyzx_save_item:%d,", point);  //可动态存档标志  
  if (point = item->query("owner_id")) result += sprintf("owner_id:%d,", point);  //可动态存档标志
  if (prop = item->query("old_copy_log")) result += sprintf("old_copy_log:%s,", prop);  //描述备份
  if (prop = item->query("material")) result += sprintf("material:%s,", prop);  //物品类别
  if (point = item->query("xyzx_sys/bind_type")) result += sprintf("xyzx_sys/bind_type:%d,", point);  //绑定标志
  if (prop = item->query("flag")) result += sprintf("flag:%d,", prop);  //使用类型（单/双手）
  if (prop = item->query("skill_type")) result += sprintf("skill_type:%s,", prop);  //应用类型（一般是兵器）
  if (point = item->query("female_only")) result += sprintf("female_only:%d,", point);  //防具性别

  if (point = item->query("remaining")) result += sprintf("remaining:%d,", point);  //蜂浆瓶的可变属性
  if (point = item->query("food_remaining")) result += sprintf("food_remaining:%d,", point);  //食物可变属性
  if (point = item->query("liquid/remaining")) result += sprintf("liquid/remaining:%d,", point);  //饮水可变属性
  if (point = item->query("item_t")) result += sprintf("item_t:%d,", point);  //计时装备可变属性
  if (point = item->query("get_拉1")) result += sprintf("get_拉1:%d,", point);  //黄金斧的可变属性

  if (item->query("id") == "buzhen xiang") {
    if (point = item->query("jian")) result += sprintf("jian:%d,", point);  //布阵箱可变属性
  }
  //武器
  if (item->query("weapon_prop")) {
    sx = item->query("weapon_prop");
    shuxing = keys(sx);

    for (int i = 0; i < sizeof(shuxing); i++) {
      if (point = item->query("weapon_prop/" + shuxing[i])) result += sprintf(
        "weapon_prop/" + shuxing[i] + ":%d,",
        point
      );
    }
  }
  //防具
  if (item->query("armor_prop")) {
    sx = item->query("armor_prop");
    shuxing = keys(sx);

    for (int i = 0; i < sizeof(shuxing); i++) {
      if (point = item->query("armor_prop/" + shuxing[i])) result += sprintf(
        "armor_prop/" + shuxing[i] + ":%d,",
        point
      );
    }
  }


  return result;


}

void set_prop_baseon_string(object item, string prop) {
  string *str, type, chars;
  int size, i, index = 0;

  if (!item || !prop) return;

  str = explode(prop, ",");
  size = sizeof(str);

  for (i = 0; i < size; i++) {
    if (sscanf(str[i], "%s:%s", type, chars) == 2) {
      if (type == "file") continue;

      //tell_object(find_player("luoyun"), sprintf("type== %O    chars==%O\n", item, type, chars));
      if (type == "weight") item->set_weight(to_int(chars));
      else if (type == "amount") item->set_amount(to_int(chars));
      else if (index = to_int(chars)) item->set(sprintf("%s", type), index);
      else item->set(sprintf("%s", type), chars);
    }
  }
}
