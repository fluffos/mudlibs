//zhangwuji.c

#include <ansi.h>
inherit NPC;
inherit F_MASTER;
//inherit F_UNIQUE;


void greeting(object ob);
void create()
{
	int jibie;
	jibie = 7000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性	
    set("shen_type", 0); 
    seteuid(getuid());
	set_name("张无忌", ({ "zhang wuji", "zhang", "wuji" }));
	set("long", "明教教主张无忌，统领天下十万教众，豪气干云，叱咤千秋，\n"
               +"「九阳神功」、「乾坤大挪移」独步天下，是江湖中不世出的\n"
               +"少年英雄。\n");
    set("title","明教教主");
	set("gender", "男性");
    set("age", 20);
    set("attitude", "friendly");

    set("str", 30);
    set("int", 30);
    set("con", 30);
    set("dex", 30);

    set("qi", 330050);
    set("max_qi", 330050);
    set("jing", 30050);
    set("max_jing", 30050);
    set("neili", 5000000);
    set("max_neili", 1000000);
    set("jiali", 22200);
    set("combat_exp", 29000000);
    set("score", 455000);
    
    set_skill("force", 500+jibie/3+random(jibie/5));
    set_skill("unarmed", 500+jibie/3+random(jibie/5));
    set_skill("dodge", 500+jibie/3+random(jibie/5));
    set_skill("parry", 500+jibie/3+random(jibie/5));
    set_skill("sword",500+jibie/3+random(jibie/5));
    set_skill("jiuyang-shengong", 100+jibie/10+random(jibie)/10);
    set_skill("qiankundanuoyi", 500+jibie/3+random(jibie/5));
    set_skill("qishang-quan", 500+jibie/3+random(jibie/5));
    set_skill("liehuo-jian",500+jibie/3+random(jibie/5));
    set_skill("shenghuo-ling",500+jibie/3+random(jibie/5));
    set_skill("shenghuo-jian",500+jibie/3+random(jibie/5));
    set_skill("shenghuo-quan",500+jibie/3+random(jibie/5));	
	set_skill("shenghuo-shengong",500+jibie/3+random(jibie/5));
    set_skill("literate",500+jibie/3+random(jibie/5));
	map_skill("force", "jiuyang-shengong");
    map_skill("dodge", "qiankundanuoyi");
    map_skill("unarmed", "qishang-quan");
	map_skill("sword","shenghuo-ling");
	map_skill("parry","qiankundanuoyi");

    create_family("明教",34, "教主");

		set("chat_chance",3000);
       set("chat_msg",({
         "张无忌愤然说道“大丈夫当以国为家, 捐躯沙场, 抗元大业未成, 同辈仍需努力!”\n",
        "张无忌道“我教兄弟听了: 生于乱世, 当克己为公, 行侠仗义, 荡寇驱魔!”\n",
//            "张无忌道“我教兄弟听了: 生于乱世, 当克己为公, 行侠仗义, 荡寇驱魔!”\n",
            (: random_move :)
             }));

//        set("inquiry",(
//       "明教" : "明教正在编写之中，请君稍候。\n",
//    "金毛狮王" :
//    "谢逊" :
//             ]))
		setup();
		carry_object("/d/mingjiao/obj/yitianjian")->wield();
//    	carry_object("/d/mingjiao/obj/jiaozhumingpao")->wear();
		add_money("gold",70);
}

void init()
{
	object ob;

	::init();

	if( interactive(ob=this_player()) && !is_fighting())
	{
		remove_call_out("greeting");
		call_out("greeting",1,ob);
	}
}

void greeting(object ob)
{
	if(!ob || environment(ob)!=environment()) return;
	if((int)ob->query("shen")<-50000)
	{
//      command("say
		command("wield yitian jian");
		command("hit"+(string)ob->query("id"));
		command("unwield uitian jian");
	}
	else if((int)ob->query("shen")<-100000)
	{
		command("say 魔从心起，于武学不利，其道必诛，劝君放下屠刀，立地成佛.");
	}
	else if((int)ob->query("shen")<-10000)
	{
		command("say 这位朋友，人行江湖，言行当正，切务走进邪魔歪道.");
	}
	else if((int)ob->query("shen")>=0)
	{
		command("say 光明正道任人走，劝君多加保重.");
	}
	else if((int)ob->query("shen")>100000)
	{
		command("say 大侠在上，受无忌一礼，大侠它日必为武林翘楚.");
	}
	return;
}



void attempt_apprentice(object ob)
{
	if((int)ob->query("str",1)<30)
	{
		command("say 你的臂力太低了，不适合学习我的功夫。");
		return ;
	}
	if((int)ob->query("con",1)<30)
	{
		command("say 你的根骨太低了，不适合学习我的功夫。");
		return ;
	}	
/*	if((string)ob->query("gender")!="男性")
	{
		command("say 你阳气不足，习我功夫恐将走火如魔。");
		return ;
	}*/
	if ((int)ob->query("xyzx_sys/level")<1000)
    {
        command("say 这位"+RANK_D->query_respect(ob)+"实战能力太差了，还是去江湖上历练吧。");
		return ;
    }
	if ((int)ob->query_skill("force", 1) < 1000) {
		command("shake");
		command("say 我的九阳真气乃是以深厚的基本内功为基础的！");
		command("say 你的基本功还未练好，现在我没什么可以教你的！");
		command("sigh");
		return;
	}	
	if ((int)ob->query_skill("shenghuo-shengong", 1) < 1000) {
		command("shake");
		command("say 我教武功博大精深！");
		command("say 你的入门内功功还未练好，现在我没什么可以教你的！");
		return;
	}
	if ((int)ob->query("max_neili", 1) < 100000) {
		command("shake");
		command("say 九阳真气是需要深厚的内力！");
		command("say 你的内力不足，现在我没什么可以教你的！");
		return;
	}
	if ((int)ob->query_skill("parry", 1) < 1000) {
		command("shake");
		command("say 我的武功神奇无比，你的招架不够！");
		command("say 你的基本功还未练好，现在我没什么可以教你的！");
		return;
	}	
	if((int)ob->query("score") <= 100000)
	{
		command("say 你应当去江湖上游历一番，名声响亮再来吧。");
		return 0;
	}	
	if((int)ob->query("shen") <= 1000000)
	{
		command("say 你应当多作些行侠仗义的事，以修身心。");
		return 0;
	}
	command("say 好，我就收下你这位好兄弟");
	command("say 再接再砺！");
	command("recruit " + ob->query("id"));
	return;
}

int accept_fight(object ob)
{
    if(((int)ob->query("combat_exp")<30000)&&((int)ob->query("shen")>0))
    {
        message_vision("武林中人最忌争强斗狠，你不是我的对手，回去吧。\n",ob);
        return 0;
    }
    message_vision("张无忌一拱手说道：这位"+RANK_D->query_respect(ob)+
	"，在下领教了。\n", ob);
    return 1;
}


