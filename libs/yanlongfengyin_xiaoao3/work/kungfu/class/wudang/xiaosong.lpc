// xiaosong.c 宋青书
inherit NPC;
void create()
{
	int jibie;
	jibie = 1000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性	
    set("shen_type", -1); 
    set_name("宋青书", ({ "song qingshu", "song" }));
    set("long", 
        "他就是宋远桥的儿子宋青书。\n"
        "但见他眉目清秀，俊美之中带着三分轩昂气度，令人一见之下，自然心折。\n");
    set("gender", "男性");
    set("age", 20);
    set("attitude", "peaceful");

    set("str", 25);
    set("int", 28);
    set("con", 25);
    set("dex", 25);
    
    set("max_qi", 1000);
    set("max_jing", 500);
    set("neili", 1000);
    set("max_neili", 1000);
    set("jiali", 30);
    set("combat_exp", 80000);
    set("score", 10000);
    set_skill("force", 500+jibie/3+random(jibie/5));
    set_skill("taiji-shengong", 500+jibie/3+random(jibie/5));
    set_skill("dodge", 500+jibie/3+random(jibie/5));
    set_skill("tiyunzong", 500+jibie/3+random(jibie/5));
    set_skill("unarmed", 500+jibie/3+random(jibie/5));
    set_skill("taiji-quan", 500+jibie/3+random(jibie/5));
    set_skill("parry", 500+jibie/3+random(jibie/5));
    set_skill("sword", 500+jibie/3+random(jibie/5));
    set_skill("taiji-jian", 500+jibie/3+random(jibie/5));
    set_skill("taoism", 500+jibie/3+random(jibie/5));
    set_skill("literate", 500+jibie/3+random(jibie/5));
    map_skill("force", "taiji-shengong");
    map_skill("dodge", "tiyunzong");
    map_skill("unarmed", "taiji-quan");
    map_skill("parry", "taiji-jian");
    map_skill("sword", "taiji-jian");
    create_family("武当派", 3, "弟子");
    setup();
    carry_object("/clone/weapon/changjian")->wield();
    carry_object("/d/wudang/obj/whitecloth")->wear();
}
