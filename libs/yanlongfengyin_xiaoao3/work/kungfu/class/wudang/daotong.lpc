// daotong.c 道童
inherit NPC;
void create()
{
	int jibie;
	jibie = 100;
	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性	
    set("shen_type", 0); 
    set_name("道童", ({ "daotong", "dao", "tong" }));
    set("long", 
        "他是武当山的小道童。\n");
    set("gender", "男性");
    set("age", 16);
    set("attitude", "peaceful");

    set("str", 20);
    set("int", 20);
    set("con", 22);
    set("dex", 25);
    
    set("max_qi", 300);
    set("max_jing", 200);
    set("neili", 200);
    set("max_neili", 200);
    set("combat_exp", 2000);
    set("score", 1000);
    set_skill("force", 500+jibie/3+random(jibie/5));
    set_skill("dodge", 500+jibie/3+random(jibie/5));
    set_skill("unarmed", 500+jibie/3+random(jibie/5));
    set_skill("parry", 500+jibie/3+random(jibie/5));
    set_temp("apply/attack", 15);
    set_temp("apply/defense", 15);
    set_temp("apply/damage", 5);
    create_family("武当派", 5, "弟子");
    setup();
    
    carry_object("/d/wudang/obj/greyrobe")->wear();
}
