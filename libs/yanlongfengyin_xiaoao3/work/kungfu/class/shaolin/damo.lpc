// damo.c 达摩祖师
inherit NPC;
inherit F_MASTER;
void create()
{
	int jibie;
	jibie = 10000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性	
    set("shen_type", 0); 
    set_name("达摩祖师", ({ "damo zushi", "damo" }));
    set("nickname", "一苇渡江");
    set("long", 
        "他就是少林派开山鼻祖、当今武林的隐世高僧达摩祖师。\n"
        "身穿一件锦兰袈挲，手执禅杖。\n"
        "身材高大，年满百岁，满脸红光，须眉皆白。\n");
    set("gender", "男性");
    set("age", 500);
    set("attitude", "peaceful");
    set("str", 50);
    set("int", 50);
    set("con", 50);
    set("dex", 250);

    set("max_qi", 3210000);
    set("max_jing", 1225000);
    set("neili", 4210000);
    set("max_neili", 710000);
    set("jiali", 25000);
    set("combat_exp", 42300000);
    set("score", 1000000);
    set_skill("force", 500+jibie/3+random(jibie/5));
    set_skill("yijinjing", 500+jibie/3+random(jibie/5));
    set_skill("dodge", 500+jibie/3+random(jibie/5));
    set_skill("yijing-force", 500+jibie/3+random(jibie/5));
    set_skill("unarmed", 500+jibie/3+random(jibie/5));
    set_skill("sword", 500+jibie/3+random(jibie/5));
    set_skill("parry", 500+jibie/3+random(jibie/5));
    set_skill("shaolin-shenfa", 500+jibie/3+random(jibie/5));
    set_skill("wuying-jian", 500+jibie/3+random(jibie/5));	
    set_skill("damo-force", 500+jibie/3+random(jibie/5));
    set_skill("whip", 500+jibie/3+random(jibie/5));
//    set_skill("damo-jian", 500+jibie/3+random(jibie/5));
//    set_skill("jingang-quan", 500+jibie/3+random(jibie/5));	
//    set_skill("yizhi-chan", 500+jibie/3+random(jibie/5));
    set_skill("nianhua-zhi", 500+jibie/3+random(jibie/5));	
    set_skill("buddhism", 500+jibie/3+random(jibie/5));
    set_skill("literate", 500+jibie/3+random(jibie/5));
    set_skill("riyue-bian", 500+jibie/3+random(jibie/5));
	set_skill("hunyuan-yiqi", 500+jibie/3+random(jibie/5));
    map_skill("force", "yijinjing");
    map_skill("dodge", "shaolin-shenfa");
    map_skill("unarmed", "nianhua-zhi");
    map_skill("parry", "nianhua-zhi");
    map_skill("sword", "wuying-jian");
    map_skill("whip", "riyue-bian");
    set_temp("apply/armor_vs_force",1000);
    create_family("少林派", 1, "开山祖师");
    set("class", "bonze");
set("chat_chance_combat", 100);	
    set("chat_msg_combat", ({
        (: perform_action, "whip.chan" :),
        (: exert_function, "tong" :),
		(: exert_function, "jingang" :),
		(: exert_function, "chang" :),
    }) );
    setup();
    carry_object("/d/shaolin/obj/jingang-zhao")->wear();    
    carry_object("/clone/weapon/changbian")->wield();
}
void attempt_apprentice(object ob)
{
    object me; 
    mapping ob_fam, my_fam;
    string name, new_name;
    me = this_object();
    my_fam  = me->query("family");
    name = ob->query("name");
    if (!(ob_fam = ob->query("family")) || ob_fam["family_name"] != "少林派")
    {
        command("say " + RANK_D->query_respect(ob) + "与本派素无来往，不知此话从何谈起？");
        return;
    }
    if ( (string)ob->query("class")!="bonze" && ob_fam["family_name"] == "少林派") 
    {
        command("say " + RANK_D->query_respect(ob) + "是俗家弟子，不能在寺内学艺。");
        return;
    }
    if ( ob_fam["generation"] <= my_fam["generation"] )
    {
        command("say " + RANK_D->query_respect(ob) + "，贫僧哪里敢当 !");
        return;
    }
    if ((int)ob->query_skill("hunyuan-yiqi", 1) < 1000) {
        command("say 我少林派乃内家武功，最重视内功心法。"); 
        command("say " + RANK_D->query_respect(ob) + 
            "是否还应该在内功上多下点功夫？");
        return;
    }	
    if ((int)ob->query_skill("buddhism", 1) < 1000) {
        command("say 悟禅之人，德义为先，功夫的高低倒还在其次，未练武，要先学做人。");
        command("say 在禅宗心法方面，" + RANK_D->query_respect(ob) +
            "是否还做得不够？");
        return;
    }
    if ((int)ob->query_skill("dodge", 1) < 2000) {
        command("say 在轻功方面，" + RANK_D->query_respect(ob) +
            "是否还做得不够？");
        return;
    }
    if ((int)ob->query_skill("shaolin-shenfa", 1) < 1000) {
        command("say 在轻功方面，" + RANK_D->query_respect(ob) +
            "是否还做得不够？");
        return;
    }
    if ((int)ob->query_skill("force", 1) < 2000) {
        command("say 在内功方面，" + RANK_D->query_respect(ob) +
            "是否还做得不够？");
        return;
    }
    if ((int)ob->query_skill("parry", 1) < 2000) {
        command("say 在基本功方面，" + RANK_D->query_respect(ob) +
            "是否还做得不够？");
        return;
    }
    if (ob->query_MKS() > 0 ) {
        command("say 万事都讲一个缘字。");
        command("say " + RANK_D->query_respect(ob) + "与佛无缘，还是请回吧。");
        return;
    }
    if ((int)ob->query("str", 1) < 25 || (int)ob->query("int", 1) < 25 || (int)ob->query("con", 1) < 25 || (int)ob->query("dex", 1) < 25) {
        command("say 我少林派武功，博大精深，集众家武学之长，去芜存菁。"); 
        command("say 依我看，以" + RANK_D->query_respect(ob) +  "的资质恐怕不适合拜入我的门下？");
        return;
    }
//  if ( ( ob_fam["generation"] + 35 ) == (my_fam["generation"]) )
    if ( ob->query("family/generation") == 36 )
    { 
            command("say 老衲垂死之年，又得一可塑之才，真是可喜可贺 !");
            name = ob->query("name");
            new_name = "渡" + name[2..3];
            ob->set("name", new_name);
            ob->set("family/generation", 35);
            command("say 从今以后你的法名叫做" + new_name + "，恭喜你荣升为少林派渡字辈罗汉之一 !");
            command("recruit " + ob->query("id"));
			ob->set("title", "达摩祖师嫡传弟子");
    }
    return;
}
