#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int ask_daojian();

void create() {
  int jibie;
  jibie = 4000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性	
  set("shen_type", 1);
  set_name("苗人凤", ({ "miao renfeng", "miao", "renfeng" }));
  set("gender", "男性");
  set("nickname", YEL "金面佛" NOR);
  set("title", "中原苗家");
  set("age", 48);
  set("long", @LONG 
他就是号称打遍天下无敌手的「金面佛」苗人 
凤。只见他脸色透黄，似乎蒙上了一层淡淡的 
金纸。他身材高大魁梧，四肢修长，却是全然 
不修篇幅，令人称奇。 
LONG);
  set("attitude", "peaceful");

  set("str", 32);
  set("int", 31);
  set("con", 33);
  set("dex", 31);

  set("qi", 25500);
  set("max_qi", 25500);
  set("jing", 24000);
  set("max_jing", 24000);
  set("neili", 26800);
  set("max_neili", 26800);
  set("jiali", 200);
  set("level", 50);
  set("combat_exp", 9500000);
  set("score", 20000);

  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("lengyue-shengong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sixiang-bufa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("miaojia-jian", 500 + jibie / 3 + random(jibie / 5));
  //        set_skill("blade", 500+jibie/3+random(jibie/5)); 
  //        set_skill("hujia-dao", 100+jibie/10+random(jibie)/10); 
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("tianchang-zhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  //        set_skill("daojian-guizhen", 500+jibie/3+random(jibie/5));         
  map_skill("force", "lengyue-shengong");
  map_skill("dodge", "sixiang-bufa");
  map_skill("sword", "miaojia-jian");
  //        map_skill("blade", "hujia-dao"); 
  map_skill("parry", "miaojia-jian");
  map_skill("unarmed", "tianchang-zhang");

  create_family("胡苗世家", 2, "传人");
  //        create_family("中原苗家", 2, "传人"); 
  //        create_family("关外胡家", 2, "友人"); 
  set("inquiry", ([

    "胡家刀法": "胡家刀法乃是我当年从胡世兄处习得，当真精妙无比。",
    "胡一刀": "当年我中了奸人毒计杀害了他，令我遗憾终生！",
    "刀剑归真": (: ask_daojian :),
  ]));


  setup();

  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/clone/cloth/cloth")->wear();

}

void attempt_apprentice(object ob) {

  if (ob->name(1) == "苗人凤") {
    command("hmm");
    command("say 你怎么也取这个名字？");
    return;
  }

  if (ob->name(1) == "苗若兰") {
    command("hmm");
    command("say 你就不能换个别的名字？");
    return;
  }

  if (ob->name(1) == "苗鬼凤" || ob->name(1) == "苗人龙") {
    command("hmm");
    command("say 你安心要和我作对是不是？");
    return;
  }
  if ((int)ob->query("str", 1) < 25) {
    command("say 这位" + RANK_D->query_respect(ob) + "臂力太差了。");
    return;
  }
  if ((int)ob->query("int", 1) < 25) {
    command("say 这位" + RANK_D->query_respect(ob) + "悟性太差了，恐怕学不了我苗家剑法。");
    return;
  }
  if ((int)ob->query("xyzx_sys/level") < 1000) {
    command("say 这位" + RANK_D->query_respect(ob) + "实战能力太差了，还是去江湖上历练吧。");
    return;
  }
  if (ob->query_skill("lengyue-shengong", 1) < 1000) {
    command("say 这位" + RANK_D->query_respect(ob) + "对我关外的基础武功领会的不够。");
    return;
  }
  command("sigh");
  command("recruit " + ob->query("id"));
  command("say 我本已打算不收徒弟，让我田家与胡、苗、范三家的纷争得以平息。");
  command("say 可是这祖传三十七势苗家剑就在我处失传，未免太过不孝。");
  return;
}


int recognize_apprentice(object me) {
  if ((int)me->query("shen") < 0) {
    command("sigh");
    command("say 你怎能走上邪路？我可不能教你苗家剑。");
    return 0;
  }

  if ((int)me->query("xyzx_sys/level") < 2000) {
    command("say 你此时实力太弱，还是先打好基础再说吧。");
    return 0;
  }
  if ((int)me->query("weiwang") < 50 || (int)me->query("score") < 50000) {
    command("say 我不会把剑法传授给无名之辈，等你在江湖上闯出点名头来，再找我吧。");
    return 0;
  }
  /*       if (skill != "miaojia-jian")
        {
                command("say 我只教你苗家剑法，别的就不要来烦我了！"); 
                return 0;
        }
  
        if ((int)me->query_skill(skill, 1) >= 400) 
        {
               command("say 够了！我就教你到这里吧，武功还是要靠自己多研究才是！"); 
               return 0; 
        }
 */
  command("say 看在当年我中了奸人毒计害了胡一刀，令我遗憾终生的事上，我就传你苗家剑法。");
  return 1;
}

int ask_daojian() {
  object me, ob;
  me = this_player();
  ob = this_object();

  if ((string)me->query("family/family_name") == "胡苗世家" && me->query("family/master_id") == "miao renfeng" && me->query_temp("jm_miao2")) {
    message_vision(HIB "苗人凤叹了一口气道：当年与胡大侠一战，得胡大侠之助，才对刀剑归真略有了解！” \n" NOR, me);
    message_vision(HIB "苗人凤说道：当年一战真是大雪纷飞，于漫天飞雪之间，才对刀剑归真若有所思。\n" NOR, me);
    message_vision(HIB "苗人凤说道：你可去长白山雪花纷飞之处，领悟刀剑真义。\n" NOR, me);
    message_vision(HIB "苗人凤突然沉思一下说道道：哦，听说我胡苗两家先辈与那袁承志有过节，你去山东一带打听看看。\n" NOR, me);
    me->set_temp("jm_miao3", 1);
    return 1;
  } else if ((string)me->query("family/family_name") == "胡苗世家" && me->query("family/master_id") == "miao renfeng") {
    message_vision(HIB "苗人凤说道：你我切磋一番，我可指点你一些苗家剑法的精要！” \n" NOR, me);
    me->set_temp("jm_miao1", 1);
    return 1;
  } else {
    message_vision(YEL "苗人凤说道：刀剑归真？没听说此事！” \n" NOR, me);
  }

  return 1;
}


int accept_fight(object ob) {
  object me = this_object();

  if (!ob->query_temp("jm_miao1")) return 1;
  remove_call_out("checking");
  call_out("checking", 1, me, ob);
  //    ob->delete_temp("jm_miao1");

  return 1;
}
int checking(object me, object ob) {
  int my_max_qi, his_max_qi;
  my_max_qi = me->query("max_qi");
  his_max_qi = ob->query("max_qi");
  if (me->is_fighting()) {
    call_out("checking", 3, me, ob);
    return 1;
  }
  if (!present(ob, environment())) return 1;
  if (me->is_busy() && me->query_busy() > 5) {
    message_vision("苗人凤笑道：这位" + RANK_D->query_respect(ob) + "，我们只是切磋武艺而已，没必要使用这种点穴功夫吧。\n", ob);
    return 1;
  }
  if (((int)ob->query("qi") * 100 / his_max_qi) < 50 && ob->query("family/master_id") == "miao renfeng" && ob->query_temp("jm_miao1")) {
    message_vision("苗人凤微微一笑道：这位" + RANK_D->query_respect(ob) + "的本领还需要在历练几年吧......\n", ob);
    ob->delete_temp("jm_miao1");
    return 1;
  }
  if (((int)me->query("eff_qi") * 100 / my_max_qi) < 50 && ob->query("family/master_id") == "miao renfeng" && ob->query_temp("jm_miao1")) {
    command("say 孽徒，竟敢弑师！\n");
    message_vision("苗人凤将你开除师门了！\n", ob);
    ob->delete_temp("jm_miao1");
    command("expell " + ob->query("id"));
    ob->add("betrayer", 1);
    ob->set("title", "苗人凤" + RED + "弃徒" NOR);
    return 1;
  }
  if (((int)me->query("qi") * 100 / my_max_qi) <= 50 && ((int)me->query("eff_qi") * 100 / my_max_qi) >= 50 && ob->query("family/master_id") == "miao renfeng" && ob->query_temp("jm_miao1")) {
    command("say 青出於蓝胜於蓝，不愧是我金面佛的弟子！\n");
    message_vision("苗人凤说道：我苗家剑法你已经掌握的很娴熟了，若你能将胡家刀法练至深处，或许能参悟出更高深的武学。\n", ob);
    ob->delete_temp("jm_miao1");
    ob->set_temp("jm_miao2", 1);
    return 1;
  }

  return 1;
}
