// masteryue.c
inherit NPC;
inherit F_MASTER;
int ask_guoxiang();
int ask_kunlun();

void create() {
  int jibie;
  jibie = 6000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性	
  set("shen_type", 0);
  set_name("何足道", ({ "he zudao", "master", "he" }));
  set("title", "昆仑三圣");
  set("nickname", "何三圣");
  set("gender", "男性");
  set("age", 162);
  set("long", "他就是昆仑派的开山祖师，江湖上人称“昆仑三圣”的何足道。\n");
  set("attitude", "peaceful");
  set("str", 85);
  set("int", 85);
  set("con", 80);
  set("per", 25);
  set("dex", 140);

  set("max_qi", 2000000);
  set("max_jing", 1000000);
  set("jingli", 800000);
  set("max_jingli", 1000000);
  set("neili", 3150000);
  set("max_neili", 700000);
  set("jiali", 13000);
  set("rank_info/respect", "何师祖");
  set("combat_exp", 27500000);

  set_skill("art", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("throwing", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("qidao", 500 + jibie / 3 + random(jibie / 5));
  set_skill("finger", 500 + jibie / 3 + random(jibie / 5));
  set_skill("xuantian-wuji", 500 + jibie / 3 + random(jibie / 5));
  set_skill("xunlei-sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("liangyi-jian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("kunlun-zhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("kunlun-shenfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("mantianhuayu", 500 + jibie / 3 + random(jibie / 5));
  map_skill("dodge", "kunlun-shenfa");
  map_skill("force", "xuantian-wuji");
  map_skill("unarmed", "kunlun-zhang");
  map_skill("throwing", "mantianhuayu");
  map_skill("parry", "liangyi-jian");
  map_skill("sword", "liangyi-jian");
  map_skill("finger", "qidao");

  set("inquiry", ([
    "郭襄": (: ask_guoxiang :),
    "昆仑三圣": (: ask_kunlun :),
  ]));

  create_family("昆仑派", 13, "三圣");
  setup();
  carry_object("/clone/cloth/long_cloth")->wear();
  carry_object("/d/kunlun/obj/qizi")->wield();
  carry_object("/clone/weapon/changjian")->wield();
}
void attempt_apprentice(object ob) {
  if ((int)ob->query("xyzx_sys/level") < 1000) {
    command("say 这位" + RANK_D->query_respect(ob) + "实战能力太差了，还是去江湖上历练吧。");
    return;
  }
  if ((int)ob->query_skill("xuantian-wuji", 1) < 1000) {
    command("say " + RANK_D->query_respect(ob) + "是否还应该多练练本门的内功心法？");
    return;
  }
  if ((int)ob->query("score", 1) < 100000) {
    message_vision("何足道疑惑的看着你说道：你对我派似乎不够忠诚？\n", ob);
    return;
  }
  if ((int)ob->query("int", 1) < 30) {
    command("say " + RANK_D->query_respect(ob) + "看起来呆头呆脑的，恐怕难以将我昆仑武功修炼到高深处！");
    return;
  }
  command("chat 哈哈哈哈！！！！");
  command("chat 我昆仑又觅得一位英才，昆仑扬威江湖指日可待。");
  command("recruit " + ob->query("id"));
  return;
}
void recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "swordsman");
}

int ask_guoxiang() {
  object me, ob;
  me = this_player();
  ob = this_object();

  if (me->name() == "杨过" || me->name(1) == "杨过" || me->query("family/master_id") == "yang guo") {
    message_vision(YEL "何足道大怒道：老子平生最恨杨过，耽误了郭襄终生！！！” \n" NOR, me);
    ob->kill_ob(me);
    me->fight_ob(ob);
    return 1;
  }
  if (me->query("family/master_id") == "he zudao" && (string)me->query("family/family_name") == "昆仑派") {
    message_vision(HIB "何足道微微一叹道：郭女侠实乃女中豪杰，我不如也。\n" NOR, me);
    message_vision(HIB "何足道似乎回忆起往事，说道：郭襄女侠乃吾梦中情人，可惜相逢恨晚！” \n" NOR, me);
    me->set_temp("jm_kunlun1", 1);
  } else {
    message_vision(YEL "何足道大怒道：郭襄神女也是尔等凡夫俗子可问的！！！” \n" NOR, me);
    ob->kill_ob(me);
    me->fight_ob(ob);
  }

  return 1;
}

int ask_kunlun() {
  object me, ob;
  me = this_player();
  ob = this_object();

  if (me->name() == "杨过" || me->name(1) == "杨过" || me->query("family/master_id") == "yang guo") {
    message_vision(YEL "何足道大怒道：老子平生最恨杨过，耽误了郭襄终生！！！ \n" NOR, me);
    ob->kill_ob(me);
    me->fight_ob(ob);
    return 1;
  }
  if (me->query("family/master_id") == "he zudao" && (string)me->query("family/family_name") == "昆仑派" && me->query_temp("jm_kunlun6")) {
    message_vision(HIC "何足道微微一笑道：昆仑三圣只是江湖中人抬举而已，何足道也。\n" NOR, me);
    message_vision(HIC "何足道说道：我昆仑师祖曾于昆仑绝巅参悟出了琴、棋、剑三绝！ \n" NOR, me);
    message_vision(HIC "何足道说道：吾徒可去昆仑峭壁参悟我派绝学！ \n" NOR, me);
    me->set_temp("jm_kunlun7", 1);
  } else {
    message_vision(YEL "\n按长剑，抚瑶琴。空山独吟，翎羽绕缤纷。\n" NOR
      YEL "\n清水白石何离离？剑点沟壑，独弈求知音。\n" NOR
      YEL "\n奏考槃，诉蒹葭。\n" NOR
      YEL "\n伊硕白衣，痴向曲中音。\n" NOR
      YEL "\n古刹钟声撼山应，昆仑情断，何足道虚名？ \n" NOR, me);
  }

  return 1;
}
