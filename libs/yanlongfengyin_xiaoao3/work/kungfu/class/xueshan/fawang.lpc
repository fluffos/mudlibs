//
// /kungfu/class/xueshan/fawang.c  金轮法王
// by secret
#include <ansi.h>
inherit NPC;
inherit F_MASTER;

int ask_riyuelun();
void create() {
  int jibie;
  jibie = 6000;
  //	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性	
  set("xyzx_sys/level", jibie);  //2017.9.1阿飞调整NPC等级为固定值，取消20%的浮动设定		
  set("shen_type", -1);
  set_name("金轮法王", ({ "jinlun fawang", "fawang" }));
  set("long", @LONG
他是雪山寺的护教法王。在雪山寺的地位仅次与掌门人鸠摩智。
身穿一件紫红袈裟，头带僧帽。
LONG
  );
  set("title", HIY "法王" NOR);
  set("gender", "男性");
  set("age", 50);
  set("attitude", "peaceful");
  set("str", 60);
  set("int", 60);
  set("con", 60);
  set("dex", 160);
  set("max_qi", 1550000);
  set("max_jing", 1255000);
  set("neili", 4500000);
  set("max_neili", 400000);
  set("jiali", 13100);
  set("combat_exp", 3500000);

  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("longxiang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("shenkong-xing", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yujiamu-quan", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("mingwang-jian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("mizong-xinfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("hammer", 500 + jibie / 3 + random(jibie / 5));
  set_skill("riyue-lun", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dashou-yin", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "longxiang");
  map_skill("dodge", "shenkong-xing");
  map_skill("unarmed", "yujiamu-quan");
  map_skill("parry", "riyue-lun");
  map_skill("sword", "mingwang-jian");
  map_skill("hammer", "riyue-lun");
  create_family("雪山寺", 2, "护教法王");
  set("class", "bonze");
  set("inquiry", ([ "日月轮": (: ask_riyuelun :), ]));
  setup();
  carry_object("/d/xueshan/obj/jinlun")->wield();
  carry_object("/d/xueshan/obj/goldlun")->wield();
  carry_object("/d/xueshan/obj/p-jiasha")->wear();
  carry_object("/d/xueshan/obj/sengmao")->wear();
  add_money("gold", 1);
}
void attempt_apprentice(object ob) {
  if ((string)ob->query("gender") != "男性") {
    command("say 修习密宗内功需要纯阳之体。");
    command("say 这位" + RANK_D->query_respect(ob) +
      "还是请回吧！");
    return;
  }
  if ((string)ob->query("class") != "bonze") {
    command("say 我佛门的清规戒律甚多。");
    command("say 这位" + RANK_D->query_respect(ob) +
      "还是请回吧！");
    return;
  }
  if ((string)ob->query("family/family_name") != "雪山寺") {
    command("say 这位" + RANK_D->query_respect(ob) +
      "既非本寺弟子，还是请回吧！");
    return;
  }
  if ((int)ob->query_skill("mizong-xinfa", 1) < 1000) {
    command("say 入我雪山寺，修习密宗心法是首要的。");
    command("say 这位" + RANK_D->query_respect(ob) +
      "是否还应该多多钻研本门的心法？");
    return;
  }
  if ((int)ob->query_skill("longxiang", 1) < 1000) {
    command("say 入我雪山寺，修习本门内功是苦行的基础。");
    command("say 这位" + RANK_D->query_respect(ob) +
      "是否还应该多多钻研本门的内功？");
    return;
  }
  if ((int)ob->query_skill("shenkong-xing", 1) < 1000) {
    command("say 入我雪山寺，苦行也是很重要的修行。");
    command("say 这位" + RANK_D->query_respect(ob) +
      "是否还应该多多钻研本门的身法？");
    return;
  }
  if ((int)ob->query("str", 1) < 30) {
    command("say 这位" + RANK_D->query_respect(ob) + "看起来柔弱无力，恐怕难以修炼我雪山寺刚猛武功。");
    return;
  }
  if ((int)ob->query("xyzx_sys/level") < 1000) {
    command("say 这位" + RANK_D->query_respect(ob) + "实战能力太差了，还是去江湖上历练吧。");
    return;
  }
  command("smile");
  command("nod");
  command("say 你就随我学习佛法吧！");
  command("recruit " + ob->query("id"));
  ob->set("title", HIY "活佛" NOR);
}

int ask_riyuelun() {
  object ob;
  ob = this_player();
  if (!ob->query("jm/xueshan")) {
    if (ob->query("family/master_id") == "jinlun fawang") {
      if (ob->query_temp("jm_xueshan6")) {
        tell_object(ob, "金轮法王说道：你已替为师了结了中原的恩怨，为师已经将日月轮的秘密传授于你了，还问什么！！！\n");
        if (ob->query_temp("jm_xueshan4")) tell_object(
          ob,
          "金轮法王说道：你既明白了日月轮与火焰刀的秘密，可以去雪山寺禅室融会贯通了！\n"
        );
      } else {
        tell_object(ob, "金轮法王说道：日月轮乃雪山寺喇嘛教最高绝学，吾在中原有一桩恩怨未结！\n");
        ob->set_temp("jm_xueshan5", 1);
      }
    } else {
      tell_object(ob, "金轮法王说道：日月轮的秘密只传给我的嫡传弟子！\n");
      return 1;
    }
  } else {
    tell_object(ob, "金轮法王说道：你已经深得日月轮的精髓了！\n");
    return 1;
  }
  return 1;
}

int accept_object(object me, object ob) {
  if ((string)ob->query("id") == "guojing rentou" && me->query("id") == ob->query("owner")) {
    if ((int)me->query_temp("jm_xueshan5")) {
      message_vision("$N对$n说道：哈哈哈！这郭靖小儿多次坏我大事，总算是死掉了。\n", this_object(), me);
      message_vision("$N对$n说道：中原再无能抵抗蒙古大军的人物了，元帅铁骑可以长驱直入南宋腐朽朝廷了。\n", this_object(), me);
      message_vision("$N对$n说道：徒儿果然有本事，这日月轮的秘密就传授给你了.........\n", this_object(), me);
      me->set_temp("jm_xueshan6", 1);
      return 1;
    } else {
      message_vision("$N对$n说道：这郭靖小儿多次阻当元帅大军，迟早都是要死的。\n", this_object(), me);
      return 1;
    }
  }
  return 0;
}
