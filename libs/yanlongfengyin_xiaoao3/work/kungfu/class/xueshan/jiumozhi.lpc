#include <ansi.h>
inherit NPC;
inherit F_MASTER;

int ask_huoyandao();
void create() {
  int jibie;
  jibie = 6000;
  //	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性	
  set("xyzx_sys/level", jibie);  //2017.9.1阿飞调整NPC等级为固定值，取消20%的浮动设定		
  set("shen_type", 1);
  set_name("鸠摩智", ({ "jiumo zhi", "zhi", "ming wang" }));
  set("nickname", HIG "大轮明王" NOR);
  set("long", @LONG
他就是雪山寺的掌门，人称大轮明王的鸠摩智。他对佛法有精深的研究。
身穿一件大红袈裟，头带僧帽。
LONG
  );
  set("title", "雪山寺掌门");
  set("gender", "男性");
  set("age", 60);
  set("attitude", "peaceful");
  set("str", 60);
  set("int", 60);
  set("con", 80);
  set("dex", 180);
  set("max_qi", 1500000);
  set("max_jing", 1075000);
  set("neili", 1500000);
  set("max_neili", 400000);
  set("jiali", 200);
  set("combat_exp", 6400000);
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("xiaowuxiang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("shenkong-xing", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yujiamu-quan", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("mingwang-jian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("mizong-xinfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("staff", 500 + jibie / 3 + random(jibie / 5));
  set_skill("xiangmo-chu", 500 + jibie / 3 + random(jibie / 5));
  set_skill("huoyan-dao", 500 + jibie / 3 + random(jibie / 5));
  set_skill("necromancy", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "xiaowuxiang");
  map_skill("dodge", "shenkong-xing");
  map_skill("unarmed", "huoyan-dao");
  map_skill("parry", "mingwang-jian");
  map_skill("sword", "mingwang-jian");
  map_skill("staff", "xiangmo-chu");
  create_family("雪山寺", 2, "掌门");
  set("class", "bonze");
  set("inquiry", ([ "火焰刀": (: ask_huoyandao :), ]));
  setup();
  //        carry_object("/clone/weapon/changjian")->wield();
  carry_object("/d/xueshan/obj/r-jiasha")->wear();
  carry_object("/d/xueshan/obj/sengmao")->wear();
  add_money("gold", 1);
}
void attempt_apprentice(object ob) {
  if ((string)ob->query("gender") != "男性") {
    command("say 修习密宗内功需要纯阳之体。");
    command("say 这位" + RANK_D->query_respect(ob) +
      "还是请回吧！");
    return;
  }
  if ((string)ob->query("class") != "bonze") {
    command("say 我佛门的清规戒律甚多。");
    command("say 这位" + RANK_D->query_respect(ob) +
      "还是请回吧！");
    return;
  }
  if ((string)ob->query("family/family_name") != "雪山寺") {
    command("say 这位" + RANK_D->query_respect(ob) +
      "既非本寺弟子，还是请回吧！");
    return;
  }
  if ((int)ob->query_skill("mizong-xinfa", 1) < 1000) {
    command("say 入我雪山寺，修习密宗心法是首要的。");
    command("say 这位" + RANK_D->query_respect(ob) +
      "是否还应该多多钻研本门的心法？");
    return;
  }
  if ((int)ob->query_skill("xiaowuxiang", 1) < 1000) {
    command("say 入我雪山寺，修习本门内功是苦行的基础。");
    command("say 这位" + RANK_D->query_respect(ob) +
      "是否还应该多多钻研本门的内功？");
    return;
  }
  if ((int)ob->query_skill("shenkong-xing", 1) < 1000) {
    command("say 入我雪山寺，苦行也是很重要的修行。");
    command("say 这位" + RANK_D->query_respect(ob) +
      "是否还应该多多钻研本门的身法？");
    return;
  }
  if ((int)ob->query("str", 1) < 30) {
    command("say 这位" + RANK_D->query_respect(ob) + "看起来柔弱无力，恐怕难以修炼我雪山寺刚猛武功。");
    return;
  }
  if ((int)ob->query("xyzx_sys/level") < 1000) {
    command("say 这位" + RANK_D->query_respect(ob) + "实战能力太差了，还是去江湖上历练吧。");
    return;
  }
  command("chat 哈哈哈哈！！！！！");
  command("chat 我雪山寺真是后继有人，真是可喜可贺。");
  command("chat 哈哈哈哈！！！！！");
  command("recruit " + ob->query("id"));
  ob->set("title", HIY "法王" NOR);
}

int ask_huoyandao() {
  object ob;
  ob = this_player();
  if (!ob->query("jm/xueshan")) {
    if (ob->query("family/master_id") == "jiumo zhi") {
      if (ob->query_temp("jm_xueshan3")) {
        tell_object(ob, "鸠摩智说道：火焰刀的秘密就在于将内力凝聚掌缘，内力外放，以虚无缥缈的虚劲伤人！\n");
        ob->set_temp("jm_xueshan4", 1);
        if (ob->query_temp("jm_xueshan6")) tell_object(
          ob,
          "鸠摩智说道：你既明白了火焰刀与日月轮的秘密，可以去雪山寺禅室融会贯通了！\n"
        );
      } else {
        tell_object(ob, "鸠摩智说道：火焰刀乃雪山寺密宗派最高绝学，吾曾经与慕容博有一桩心愿未了！\n");
        ob->set_temp("jm_xueshan1", 1);
      }
    } else {
      tell_object(ob, "鸠摩智说道：火焰刀的秘密只传给我的嫡传弟子！\n");
      return 1;
    }
  } else {
    tell_object(ob, "鸠摩智说道：你已经深得火焰刀的精髓了！\n");
    return 1;
  }
  return 1;
}
