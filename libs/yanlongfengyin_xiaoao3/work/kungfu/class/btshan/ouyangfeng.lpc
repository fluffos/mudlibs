///ouyangfeng.c
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int zhidian_jiuyin();
void create()
{
	int jibie;
	jibie = 8000;
	set("xyzx_sys/level", jibie);	//2017.9.1阿飞调整NPC等级为固定值，取消20%的浮动设定	
    set("shen_type", -1); 	
    set_name("欧阳锋", ({ "ouyang feng", "ouyang", "feng" }));
    set("long", "他是白驼山庄主，号称“西毒”的欧阳锋。\n"
           +"由于习练「九阴真经」走火入魔，已变得精\n"
           +"神错乱，整日披头散发。\n");
    set("title", "老毒物");
    set("gender", "男性");
    set("age", 53);
    set("nickname", HIR "西毒" NOR);        	          	
    set("attitude", "peaceful");
    set("no_get",1);
	
    set("str", 100);
    set("int", 70);
    set("con", 50);
    set("dex", 100);

	set("qi",1000000);
	set("max_qi",1000000);
	set("jing",1000000);
	set("max_jing",1000000);
    set("neili", 1000000);
    set("max_neili", 1000000);
    set("jingli", 1000000);
    set("max_jingli", 1000000);
    set("jiali", 20000);
	set("combat_exp", 100000000);
 	set("score", 100000);
    set_skill("literate", 500+jibie/2+random(jibie/5));		
    set_skill("force", 500+jibie*2+random(jibie/5));
    set_skill("unarmed", 500+jibie*2+random(jibie/5));
    set_skill("dodge", 500+jibie*2+random(jibie/5));
    set_skill("parry", 500+jibie*2+random(jibie/5));
    set_skill("staff", 500+jibie*2+random(jibie/5));
    set_skill("hamagong", 500+jibie/2+random(jibie/5));
    set_skill("chanchu-bufa",500+jibie/2+random(jibie/5));
    set_skill("training",500+jibie/2+random(jibie/5));	
    set_skill("shexing-diaoshou",500+jibie/2+random(jibie/5));
    set_skill("lingshe-zhangfa",500+jibie/2+random(jibie/5));	
    map_skill("force", "hamagong");
    map_skill("dodge", "chanchu-bufa");
    map_skill("unarmed", "shexing-diaoshou");
    map_skill("parry", "lingshe-zhangfa");
    map_skill("staff", "lingshe-zhangfa");
	
    create_family("白驼山派",1, "开山祖师");
    set("inquiry", ([
		"九阴真经" :(: zhidian_jiuyin :)
    ]) );
        set("chat_chance",2);
        set("chat_msg",({
         "欧阳锋自言自语道：何日白驼山派才能重霸江湖呢…\n",
         "欧阳锋道：我儿欧阳克必能够重振白驼山雄风！\n",
         "欧阳锋道：江湖险恶，困难重重哪！\n",
        }));
    setup();
    carry_object("/d/baituo/obj/shenshezhang")->wield();
    carry_object("/clone/cloth/cloth")->wear();
    add_money("silver",50);
}
void attempt_apprentice(object ob)
{
	if ((int)ob->query("xyzx_sys/level")<1000)
    {
		message_vision("欧阳锋对你笑道：你的实战经验太低了,我还不能收你！\n",ob);
		return ;
    }
	if ((int)ob->query("con",1)<30)
    {
		message_vision("欧阳锋对你笑道：我派武功最重根骨，你体质太差了！\n",ob);
		return ;
    }
	if ((int)ob->query("score",1)<100000)
    {
		message_vision("欧阳锋疑惑的看着你说道：你对我派似乎不够忠诚？\n",ob);
		return ;
    }	
	if ((int)ob->query_skill("hamagong",1)<1000)
    {
		message_vision("欧阳锋对你笑道：我派武功以蛤蟆功为根基，你先打好基础再来！\n",ob);
		return ;
    }
	
   message_vision("欧阳锋拍拍你的头，微微点了点头。\n",ob);
   command("recruit " + ob->query("id"));
   return;
}

int zhidian_jiuyin()
{
	object me,ob;
	me = this_player();
	ob = this_object();
	

	if ( me->query_temp("jm/baituo3") && me->query("family/master_id") == "ouyang feng")
	{
		message_vision(HIB"老毒物说道：昔年败给王重阳，为师一直心有不服。\n" NOR,me);
		message_vision(HIB"虽然黄蓉那小丫头将九阴真经改的颠三倒四，但万物阴阳变幻，祸福相依！” \n" NOR,me);
		message_vision(HIB"这本九阴真经看起来文理相通，但真心运行又似乎不太通顺，让为师仔细参详一遍！” \n" NOR,me);
		message_vision(HIC"这本经文需要以蛤蟆功为基础，似乎可以领悟到经脉逆转的绝技！你拿去参悟吧” \n" NOR,me);
		me->set_temp("jm/baituo4",1);
	}
	else 
	{
		message_vision(YEL"欧阳锋笑道：非我嫡传弟子，我不会指点你！” \n" NOR,me);
		message_vision(YEL"你没有九阴真经，如何能指点你！” \n" NOR,me);
		message_vision(YEL"再瞎叨叨，小心砍死你！！！\n", me);
		return 1;		
	}
	
	return 1;
}
//全真教解密-挑战天下五绝
int accept_fight(object ob)
{
    object me  = this_object();
    
    if ( !ob->query_temp("jm_quanzhen2") ) return 1;
    remove_call_out("checking");
    call_out("checking", 1, me, ob);   
    return 1;
}
int checking(object me, object ob)
{
    int my_max_qi, his_max_qi;
    my_max_qi  = me->query("max_qi");
    his_max_qi = ob->query("max_qi");
    if (me->is_fighting()) 
    {
        call_out("checking",3, me, ob);
		return 1;
    }
    if ( !present(ob, environment()) ) return 1; 
    if (( (int)ob->query("qi")*100 / his_max_qi) < 50 && ob->query("family/master_id")=="wang chongyang" && ob->query_temp("jm_quanzhen2")) 
    {
		message_vision("欧阳锋哈哈大笑，这位" + RANK_D->query_respect(ob) + "自以为学了王老道几招，就想挑战老夫！\n", ob);
		ob->delete_temp("jm_quanzhen2");
        return 1;
    }	
    if ( ((int)me->query("eff_qi")*100 / my_max_qi) < 50 && ob->query("family/master_id")=="wang chongyang" && ob->query_temp("jm_quanzhen2")) 
    {
		message_vision("欧阳锋阴阴一笑道：这位" + RANK_D->query_respect(ob) + "果然是我辈中人，趁你病要你命！\n", ob);
		message_vision("欧阳锋冷哼一声：臭道士欺负到老子头上来了！\n", ob);
		message_vision("欧阳锋大吼一声：~~~狂~~~风~~~扫~~~落~~~叶！只见你受到种种一击，如枯草败叶跌落在地......\n", ob);
		ob->unconcious();
		ob->delete_temp("jm_quanzhen2");
        return 1;
    }	
    if (((int)me->query("qi")*100 / my_max_qi) <= 50 && ((int)me->query("eff_qi")*100 / my_max_qi) >= 50 && ob->query("family/master_id")=="wang chongyang" && ob->query_temp("jm_quanzhen2")) 
    {
        command("say 青出於蓝胜於蓝，不愧是重阳真人嫡传弟子！\n");
        message_vision("欧阳锋哈哈一笑道：长江后浪推前浪，一代新人换旧人。\n", ob);
		ob->delete_temp("jm_quanzhen2");
        ob->set_temp("jm_quanzhen_xidu",1);
        return 1;
    }
	
    return 1;  
}
//丐帮解密
void die()
{
    object me;        
    me = query_temp("last_damage_from");
	if (me && (string)me->query("family/family_name") == "丐帮" )
	{
		tell_room(environment(this_player()), "欧阳锋大喝道：臭叫花子居然都欺到我头上了！！！\n");
		tell_room(environment(this_player()), "九阴真经啊！！！\n");
		tell_room(environment(this_player()), "欧阳锋突然狂性大发，不一会死了.....．\n");
		me->set_temp("jm_gaibang/ouyangfeng",1);
	}
	::die();
}