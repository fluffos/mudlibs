// ning.c 宁中则
inherit NPC;
inherit F_MASTER;
int ask_book(string str);
void create()
{
	int jibie;
	jibie = 4000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性	
    set("shen_type", 1); 
    set_name("宁中则", ({ "ning zhongze", "ning", "zhongze", "shiniang" }));
        set("long",   @LONG
她就是华山派的现任掌门人——“君子剑”岳不群的夫人。她为人和蔼可 
亲，颇受华山派中弟子敬仰。虽然已是三十出头了，但是却风韵尤存。一
看就知道她以前必定是个美人。 
LONG );
        set("inquiry", ([
                "华山剑谱": (: ask_book :),
        ]) );
    set("gender", "女性");
    set("age", 38);
    set("attitude", "peaceful");

    set("str", 20);
    set("int", 35);
    set("con", 30);
    set("per", 28);
    set("dex", 30);

	set("qi",1200);
	set("max_qi",1200);
	set("jing",600);
	set("max_jing",600);
    set("neili", 1000);
    set("max_neili", 1000);
    set("jingli", 500);
    set("max_jingli", 500);
    set("jiali", 1000);

 	set("score", 1000);
	set_skill("unarmed", 500+jibie/3+random(jibie/5));
	set_skill("force", 500+jibie/3+random(jibie/5));
	set_skill("blade", 500+jibie/3+random(jibie/5));
	set_skill("sword", 500+jibie/3+random(jibie/5));
	set_skill("dodge", 500+jibie/3+random(jibie/5));
	set_skill("parry", 500+jibie/3+random(jibie/5));
	set_skill("strike", 500+jibie/3+random(jibie/5));
	set_skill("zixia-shengong", 500+jibie/3+random(jibie/5));
	set_skill("poyu-quan", 500+jibie/3+random(jibie/5));
	set_skill("fanliangyi-dao", 500+jibie/3+random(jibie/5));
	set_skill("huashan-jianfa", 500+jibie/3+random(jibie/5));
	set_skill("hunyuan-zhang", 500+jibie/3+random(jibie/5));
    set_skill("huashan-shenfa",500+jibie/3+random(jibie/5));
    set_skill("huashan-zhangfa",500+jibie/3+random(jibie/5));	
	set_skill("literate", 500+jibie/3+random(jibie/5));	
	map_skill("unarmed", "huashan-zhangfa");
	map_skill("force", "zixia-shengong");
    map_skill("dodge", "huashan-shenfa");
    map_skill("parry", "huashan-jianfa");
	map_skill("blade", "fanliangyi-dao");
	map_skill("sword", "huashan-jianfa");
	map_skill("strike", "hunyuan-zhang");

    create_family("华山派", 12, "弟子");
    set("chat_chance_combat", 100);
    set("chat_msg_combat", ({
        (: perform_action, "sword.jianzhang" :),
        (: perform_action, "sword.wushuang" :),
        (: exert_function, "recover" :),
    }) );
    setup();
    carry_object("/clone/cloth/pink_cloth")->wear();
    carry_object("/clone/weapon/changjian")->wield();
}
void attempt_apprentice(object ob)
{
    if ((string)ob->query("gender") != "女性") {
        command("say 阁下开什么玩笑！我怎么能够收男子为徒呢？真是羞人嗒嗒的。");
        command("say 我只收女弟子，你还是去拜我丈夫吧。");
        return;
    }
    if ((int)ob->query("shen") < 100000) {
        command("say 我华山派乃是堂堂名门正派，对弟子要求极严。");
        command("say 在德行方面，" + RANK_D->query_respect(ob) +
            "是否还做得不够？");
        return;
    }
	if ((int)ob->query("score",1)<40000)
    {
		message_vision("宁中则笑着说道：你对我派似乎不够忠诚？\n",ob);
		return ;
    }
	if( (int)ob->query("con",1) < 25 )
    {
        command("say 我华山气宗以内功为主，依我看"+RANK_D->query_respect(ob)+"的根骨不适合学我华山内功。");
		return;
    }
    if ((int)ob->query("dex",1) < 25) {
        command("say 我华山剑宗以剑法为主，依我看" + RANK_D->query_respect(ob) + "的身法似乎不适合学我华山派剑法？");
        return;
    }
    if ((int)ob->query_skill("zixia-shengong",1) < 1000)
    {
        command("say 我看" + RANK_D->query_respect(ob) + "的华山内功还没学到家吧。");
        return;
    }
    command("say 好吧，我就收下你了。");
    command("recruit " + ob->query("id"));
//    if((string)ob->query("class") != "swordsman") ob->set("class", "swordsman");
	return;
}
int ask_book(string arg)
{
        object me;
        object ning;
        object book;
        ning=this_object();
        me=this_player();
        if (me->query("class")!="swordsman")  
                {
                  command("say 对不起，华山剑谱不可以给你。");
                  return 1;
                }
        else {
                if (ning->query_temp("sign"))  
                        {
                        command("say 你来晚啦，华山剑谱早被人拿走啦。");
                        return 1;
                        }
                else {
                        message_vision(CYN "宁中则微笑着从怀中取出华山剑谱，交了给$N \n" NOR,me);
                        book=new("/d/huashan/obj/sword-book");
                        book->move(me);
                        ning->set_temp("sign",1);
                        return 1;
                        }
                }
}
