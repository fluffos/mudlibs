// tuwu.c

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;

int perform(object me, object target)
{
	int busy_skill,damage;
	int ap,dp;
	string msg;
	object weapon;
	
	if( !target ) target = offensive_target(me);
	if( !target|| !target->is_character()||	!me->is_fighting(target) )
		return notify_fail("金蛇吐雾只能在战斗中使用。\n");
//	if ( !objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("id") != "jinshe zhui" )
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "throwing")
		return notify_fail("你没用暗器，不能使用绝招！\n");
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");
	if( (int)me->query_skill("jinshe-zhui", 1) < 500 )
		return notify_fail("你的金蛇锥法不够娴熟，不会使用金蛇吐雾。\n");
	if (me->query_skill_mapped("throwing") != "jinshe-zhui")
		return notify_fail("你没正确激发该技能 。\n");
	if( (int)me->query("neili") < 1000 )
		return notify_fail("你内力不够了。\n");
    if( (int)me->query("jingli") < 1000 )
        return notify_fail("你的精力不够！\n");
    if( (int)me->query("max_neili") < 200000 )
        return notify_fail("你的内力修为太差！\n");
    if( (int)me->query("max_jingli") < 200000 )
        return notify_fail("你的精力修为太差！\n");
	if(target && target->query_temp("block_msg"))
		return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧。\n");
//	if ( target && target->query_temp("busy_mianyi") )	//冲穴成功后免疫busy，2017.9.29阿飞添加
//		return notify_fail(target->name() + "奇经八脉浑然一体，真气浩浩荡荡，点穴似乎没什么作用。\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

	msg = HIY"$N阴阴一笑，手中似乎金光一闪，手中金蛇锥突然分裂成满天碎片。\n"NOR;
	message_vision(msg, me, target);		
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1		
	busy_skill = me->query_skill("jinshe-zhui", 1)/2;
	ap = me->query("xyzx_sys/level") + me->query_skill("jinshe-zhui", 1) + me->query_skill("throwing") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	damage = me->query_skill("jinshe-zhui", 1) + me->query_skill("throwing",1)+me->query_skill("force");
	damage = damage + random(damage);
	if ((string)weapon->query("id") == "jinshe zhui") damage = damage*2;
	if ((string)weapon->query("id") == "jinshe zhui") busy_skill = me->query_skill("jinshe-zhui", 1)*2;
	me->add("neili", -200);
	me->add("jingli", -200);
	if (random(ap) > dp/3 )
	{
		target->receive_damage("qi", damage,me);
		target->receive_wound("qi", damage,me);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage +"。\n" NOR);
		message_vision( HIY "只听一阵狂风扫叶般的声响中，$N手中的"YEL"金蛇锥"HIY"闪出夺目的光芒，闪耀得$n眼冒金花，金蛇吐雾！除了眼前一重重的雾气外，$n啥也看不见了！\n" NOR, me, target);
		COMBAT_D->do_attack(me, target,me->query_temp("weapon"));
		target->set_temp("block_msg/all",1);
		call_out("tuwu_end", 5+(30*busy_skill)/(busy_skill+2000), me, target);
	}
	else
	{
		msg = HIY"$p情急智生，用剑气迫开了$P的雾气。\n"NOR;
		message_vision(msg, me, target);
	}

	if(!target->is_fighting(me)) target->fight_ob(me);
	me->start_busy(1);
	return 1;
}
void tuwu_end(object me, object target)
{
	if ( !objectp(target) ) return;
	//if ( environment(me) != environment(target) ) return;
	//target->enable_player();
	target->delete_temp("block_msg/all");
	message_vision("$N抹了抹满脸的"HIR"鲜血"NOR"，终于睁开了眼。\n", target);
	tell_object(target, HIR"你终于抹掉了满脸的鲜血，看到了周围的情景。\n"NOR);
	return;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}