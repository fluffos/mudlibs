int valid_enable(string usage) { return (usage == "throwing") || (usage == "parry"); }

int valid_learn(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if ((int)me->query("max_neili") < 10000)
		return notify_fail("你的内力不够。\n");
	if ((int)me->query_skill("biyun-xinfa", 1) < 100)
		return notify_fail("你的碧云心法火候太浅。\n");
	if ((int)me->query_skill("biye-wu", 1) < 100)
		return notify_fail("你的碧叶随风舞火候太浅。\n");
    if (me->query("family/family_name")!="唐门")
   return notify_fail("你不加入唐门，不能传授唐门高深的暗器功夫。\n");		
	return 1;
		
}


string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me)
{
	object weapon;
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if (!objectp(weapon = me->query_temp("weapon"))
	|| (string)weapon->query("skill_type") != "throwing")
		return notify_fail("你使用的武器不对。\n");
	if ((int)me->query("qi") < 50)
		return notify_fail("你的体力不够，练不了霹雳镖。\n");
    if (me->query("family/family_name")!="唐门")
   return notify_fail("你不加入唐门，不能领悟暗器的精髓。\n");		
	me->receive_damage("qi", 30);
	return 1;
}


mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{

	int ap, dp,damage2;

    ap = (int) me->query_skill("pili-biao",1);
    dp = (int) victim->query_skill("dodge",1);

	damage2 = (int)me->query_skill("pili-biao",1);	
	
    if( damage_bonus < 100 ) return 0;
	if ( me->query_skill("biyun-xinfa",1) < 100)	 return 0;
	if ( me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "biyun-xinfa") return 0;	
	if (damage2<10) damage2=10;	
	
if (random(6)==0 && me->query_skill_mapped("force") == "biyun-xinfa" && me->query("jiali") > 0 && random(ap) > dp/10)
{
	me->add("neili", -100 );
    victim->receive_damage("qi",damage2+damage_bonus/2,me);
    victim->receive_wound("qi",damage2+damage_bonus/2,me);
    victim->apply_condition(du[random(sizeof(du))], 25);
//	if (!victim->is_busy()) victim->start_busy(2);	
 return HIR "$n随手就接住了这一只飞镖，正沾沾自喜！没想到居然爆炸开来，顿时被炸了个绿头黑脸！！\n";
}
 
}


string perform_action_file(string action)
{
		return __DIR__"pili-biao/" + action;
}
	//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{

 	object weapon = me->query_temp("weapon");
	string msg,*limbs;
    int level, ap,dp,j;
        
    limbs = ob->query("limbs");
    level = (int) me->query_skill("pili-biao",1);
	ap = (int) me->query_skill("pili-biao",1);
    dp = (int) ob->query_skill("dodge",1);

    if( damage < 10 ) damage =10;
	if (random(6)==0 && level>=300 
	&& me->query_skill_mapped("force") == "biyun-xinfa" 
	&& random(ap) > dp/10
	&& weapon
	&& weapon->query("skill_type") == "throwing"
	&& me->query("neili") > 200
	&& me->query("max_neili") > 900)
    {
            msg = HIC"$n出招时，突然所用的内力随着伤口流出!\n"NOR;
			message_vision(msg, me, ob);
			j = -damage/3;
            if (ob->query("neili") > level) ob->add("neili",-level);
            me->add("neili",-level/5);
//             if (!ob->is_busy()) ob->start_busy(2+random(2));
		return j;
	}
}