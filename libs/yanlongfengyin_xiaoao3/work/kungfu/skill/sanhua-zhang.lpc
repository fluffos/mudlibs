int valid_enable(string usage) { return usage=="unarmed" || usage=="strike" || usage=="parry"; }
int practice_level(){   return 72;  }

int valid_learn(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
        return notify_fail("练散花掌必须空手。\n");
    if ((int)me->query("max_neili") < 100000)
        return notify_fail("你的内力太弱，无法练散花掌。\n");
    if (me->query_skill("unarmed", 1) <=me->query_skill("sanhua-zhang", 1))
        return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
    if ( me->query("con",1) < 25 )
        return notify_fail("散花掌对根骨要求很高，以你的资质难以领悟。\n");	
    if (me->query("family/family_name")!="少林派")
   return notify_fail("你不是佛门中人，无法学习少林绝技。\n");		
    if ((int)me->query_skill("hunyuan-yiqi", 1) < 100 && (int)me->query_skill("yijing-force", 1) < 100 && (int)me->query_skill("yijinjing", 1) < 100 && (int)me->query_skill("damo-force", 1) < 100)
    return notify_fail("你的少林气功火候不够，无法学习少林武技。\n");
    return 1;
}
string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}
mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}
int practice_skill(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
        return notify_fail("练散花掌必须空手。\n");
    if (me->query("family/family_name")!="少林派")
   return notify_fail("你不是佛门中人，偷练少林绝技会走火入魔。\n");		
    if ((int)me->query("qi") < 30)
        return notify_fail("你的体力太低了。\n");
    if ((int)me->query("neili") < 20)
        return notify_fail("你的内力不够练散花掌。\n");
    me->receive_damage("qi", 30);
    me->add("neili", -10);
    return 1;
}

string perform_action_file(string action)
{
	return __DIR__"sanhua-zhang/" + action;
}
mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb)
{                                                                                                                
	int ap,dp,skill1,skill2,skill3,skill4,damage2;
	int flag;
	flag = 1;
    ap = (int) me->query_skill("sanhua-zhang",1);
    dp = (int) victim->query_skill("force",1);
	skill1 = (int) me->query_skill("yijing-force",1);
	skill2 = (int) me->query_skill("hunyuan-yiqi",1);
	skill3 = (int) me->query_skill("yijinjing",1);	
	skill4 = (int) me->query_skill("damo-force",1);
	damage2 = (int) me->query_skill("sanhua-zhang",1);
if (damage_bonus < 100) return 0;
if (skill1 < 300 && skill2 < 200 && skill3 < 100 && skill4 < 200) return 0;
if (me->query_skill_mapped("force") != "yijinjing" && me->query_skill_mapped("force") != "hunyuan-yiqi" && me->query_skill_mapped("force") != "yijing-force" && me->query_skill_mapped("force") != "damo-force") return 0;
if ( me->query("jiali") < 1 || me->query("neili") < 100 ) return 0;	
if (damage2<10) damage2=10;
if (me->query_skill_mapped("force") == "yijinjing" ) flag = 4;
if (me->query_skill_mapped("force") == "hunyuan-yiqi" ) flag = 3;
if (me->query_skill_mapped("force") == "yijing-force" ) flag = 1;
if (me->query_skill_mapped("force") == "damo-force" ) flag = 3;
if ( random(6)==2 && random(ap) > dp/10 && me->query("jiali")>0 )
{
	victim->receive_wound("qi", damage2 * flag/2+damage_bonus/2,me);
	victim->receive_damage("qi", damage2 * flag/2+damage_bonus/2,me);
	me->add("neili", -100 );
	return HIR"$N十指如绕兰花，一掌拍来，似乎无数兰花绽放。$n躲避不及，顿时被兰花击中！\n"NOR;
}
}
