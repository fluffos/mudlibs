//huohai.c 炼狱火海
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

#include "/kungfu/skill/eff_msg.h";
inherit F_SSERVER;
int perform(object me, object target)
{
//	string msg;
	int extra,ap,dp;
	int damage,damage1,skill1,skill2;
	object weapon;

	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("只能对战斗中的对手使用。\n");
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对。\n");
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
	if(me->is_busy())
		return notify_fail("你现在没空！！\n");
	if( (int)me->query("max_neili") < 1000000  )
		return notify_fail("你的内力修为不够。\n");
	if( (int)me->query("max_jingli") < 200000 )
		return notify_fail("你的精力修为还不够高。\n");
	if( (int)me->query("neili") < 10000 )
		return notify_fail("你的内力不够。\n");
	if( (int)me->query("jingli") < 10000 )
		return notify_fail("你的精力不够了。\n");
	if( !wizardp(me) &&(int)me->query_skill("shenghuo-jian", 1) < 1000 )
		return notify_fail("你的圣火剑法火候不够!不能贯通使用！\n");
	if(!wizardp(me) && (int)me->query_skill("liehuo-jian", 1) < 1000 )
		return notify_fail("你的烈火剑法不够高!不能贯通使用！\n");
	if(!wizardp(me) && (int)me->query_skill("shenghuo-shengong", 1) < 1000 )
		return notify_fail("你的本门内功不够高!不能贯通使用！\n");
	if ( !wizardp(me) && me->query_skill_mapped("force") != "shenghuo-shengong")
		return notify_fail("不使用本门内功，如何使用本门绝学!\n");
	if (me->query_skill_mapped("sword") != "liehuo-jian")
		return notify_fail("你没正确激发该技能 。\n");	
	if (!(int)me->query("breakup"))
        return notify_fail("你任督二脉未通,无法使用[" HIR "炼狱火海" NOR "]\n"NOR); 
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	message_vision(HBWHT "$N贯通明教武学，使出了明教的绝学之精髓！\n" NOR, me, target);
	message_vision(HIM "$N领悟明教【炼狱火海】的精髓，顿时周身如坠地狱，火焰遍布。熊熊圣火，焚我残躯！\n" NOR, me, target);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 5, me);	//CD写法1	
	ap = me->query("xyzx_sys/level") + me->query_skill("liehuo-jian", 1) +me->query_skill("shenghuo-jian", 1) + me->query_skill("sword") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	extra = (int)me->query_skill("liehuo-jian",1)+(int)me->query_skill("shenghuo-jian",1);
	skill1 = (int)me->query_skill("liehuo-jian",1);
	skill2 = (int)me->query_skill("shenghuo-jian",1);
	if ( random(ap) > dp/3 ) 
	{
		
	message_vision(WHT "$N高歌：为善除恶，惟光明故！喜乐悲愁，皆归尘土！\n" NOR, me, target);
	me->add_temp("apply/attack", extra);
	me->add_temp("apply/damage", extra);	
	//if (!target->is_busy() && random(3)==1) target->start_busy(3);	
	message_vision(HIR"............为善除恶............\n" NOR, me, target);
	COMBAT_D->do_attack(target,target, target->query_temp("weapon"),TYPE_REGULAR);
	damage1 = skill2*2+random(skill2*2);
	target->receive_damage("qi",damage1,me);
	if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage1 +"。\n" NOR);
	
	message_vision(HIR"............唯光明故............\n" NOR, me, target);
	COMBAT_D->do_attack(target,target, target->query_temp("weapon"),TYPE_REGULAR);
	damage1 = skill2*2+random(skill2*2);
	target->receive_damage("qi",damage1,me);
	if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage1 +"。\n" NOR);
	
	message_vision(HIR"............喜乐悲愁............\n" NOR, me, target);
	COMBAT_D->do_attack(target,target, target->query_temp("weapon"),TYPE_REGULAR);
	damage1 = skill2*2+random(skill2*2);
	target->receive_damage("qi",damage1,me);
	if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage1 +"。\n" NOR);
	
	message_vision(HIR"............皆归尘土............\n" NOR, me, target);
	COMBAT_D->do_attack(target,target, target->query_temp("weapon"),TYPE_REGULAR);
	damage1 = skill2*2+random(skill2*2);
	target->receive_damage("qi",damage1,me);
	if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage1 +"。\n" NOR);
	
//	message_vision(msg, me, target);
	me->add_temp("apply/attack", -extra);
	me->add_temp("apply/damage", -extra);
	me->add("neili", -1000);	
	}
	if ( me->query_skill("liehuo-jian", 1) > 2000 && me->query_skill("shenghuo-jian", 1) > 2000 ) 
	{
	message_vision(HIC"$N高歌：喜乐悲愁，皆归尘土。怜我世人，忧患实多！怜我世人，忧患实多！\n" NOR,me,target);
	//if (!target->is_busy() && random(3)==1) target->start_busy(3);	
	message_vision(HIG"紧跟着$N使出烈火剑法中的绝招［炼狱火海］闪电般向$n攻出四剑！\n\n" NOR,me,target);
	me->add_temp("apply/attack", extra);
	me->add_temp("apply/damage", extra);
	message_vision(RED"............烈火剑法............\n" NOR, me, target);
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR);
	damage1 = skill1*2+random(skill1*2);
	target->receive_wound("qi",damage1,me);
	if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的内伤为"+ damage1 +"。\n" NOR);
	
	message_vision(HIY"............圣火剑法............\n" NOR, me, target);
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR);
	damage1 = skill2*2+random(skill2*2);
	target->receive_wound("qi",damage1,me);
	if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的内伤为"+ damage1 +"。\n" NOR);
	
	message_vision(HIB"............圣火拳法............\n" NOR, me, target);
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR);
	damage1 = skill2*2+random(skill2*2);
	target->receive_wound("qi",damage1,me);
	if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的内伤为"+ damage1 +"。\n" NOR);
	
	message_vision(HIW"............烈焰焚城............\n" NOR, me, target);
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR);
	damage1 = skill2*2+random(skill2*2);
	target->receive_wound("qi",damage1,me);
	if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的内伤为"+ damage1 +"。\n" NOR);
	
	me->add_temp("apply/attack", -extra);
	me->add_temp("apply/damage", -extra);
	me->add("neili", -1000);	
	}
	
if(	me->query_skill("liehuo-jian", 1) > 3000 && me->query_skill("shenghuo-jian", 1) > 3000)
{
	message_vision(HIW"你悄悄运起"HIB"烈火焚身"HIW"，将一股极灼热的内力积贮于一点，从"+weapon->name()+"上传出，直刺"+target->name()+"！\n" NOR,me,target);
	if(random(ap) > dp/3)
	{           
		damage = (me->query_skill("liehuo-jian",1)+me->query_skill("shenghuo-jian", 1) - target->query_skill("force", 1))*me->query("con",1) + me->query_skill("shenghuo-shengong",1) + me->query_skill("sword",1) + me->query_skill("force",1);
		if (damage<100) damage = 100;
		damage = damage + random(damage);
		if (target->query_temp("shield")) damage = damage/2;  //若对方有九阳护体，则伤害削弱
		if (damage>200000) message_vision(HIB"\n突然之间，$n胸口一痛，似乎被一枚极细的尖针刺了一下。这一下刺痛突如其来，似有形，实无质，一股火劲突破$n的护体神功，直钻入心肺！\n" NOR,me,target);
		else if (damage>100000) message_vision(HIY"\n突然之间，$n胸口一痛，似乎被一枚极细的尖针刺了一下。幸好$n护体神功遍护全身，这火劲虽是凝聚如丝发之细，倏钻陡戳，难防难当，却也伤他不得！\n" NOR,me,target);
		else if (damage>10000) message_vision(HIB"\n突然之间，$n胸口被尖针刺了一下。刺痛似有形，实无质，一股火劲突破$n的护体神功，直侵内脏！火劲入体，立即消失，但这一刺可当真疼痛入骨！\n" NOR,me,target);
		else message_vision(HIY"你连运“烈火焚身”的内劲，但见对方竟是毫不费力的抵挡了下来！\n" NOR,me,target);
		target->receive_damage("qi", damage,me);
		target->receive_wound("qi", damage/2,me);
		target->add("neili", -damage); 
		me->add("neili", -500);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"，杀内力"+ damage +"。\n" NOR);	   
	}         
	else 
	{
		me->add("neili", -200);         
		tell_object(me, HIY"结果烈火焚身内劲还没触到"+target->name()+"便已经散了。\n"NOR);        
	}		
}	

if(	me->query_skill("liehuo-jian", 1) > 4000 && me->query_skill("shenghuo-jian", 1) > 4000)
{	
	message_vision(HIM"$N高歌：“焚我残躯，熊熊圣火，生亦何欢，死亦何苦？为善除恶，惟光明故！\n" NOR,me,target);
	if( target->query_temp("weapon") )
	{
		if ( random(ap) >dp/3 )
		{
			if (me->query("jm/mingjiao")) damage = me->query_skill("shenghuo-jian",1)*me->query("str",1) + me->query_skill("liehuo-jian",1)*me->query("con",1)+ me->query_skill("shenghuo-shengong",1)*me->query("con",1) + me->query_skill("sword",1) + me->query_skill("force",1) +target->query_skill("force",1)+target->query("qi")/40;
			else damage = me->query_skill("shenghuo-jian",1)*me->query("str",1) + me->query_skill("liehuo-jian",1)*me->query("con",1)+ me->query_skill("shenghuo-shengong",1)*me->query("con",1) + me->query_skill("sword",1) + me->query_skill("force",1)+target->query_skill("force",1)+target->query("qi")/60;
			damage = random(damage)+damage;
			if (target->query_temp("shield")) damage = damage/2;  //若对方有九阳护体，则伤害削弱
			target->receive_damage("qi", damage,me);
			target->receive_wound("qi", damage/2,me);
			me->add("neili", -1000);
			target->add("neili", -damage/3);
			message_vision(HIR"\n$n只觉得全身受到烈火灼烧，钻心般巨痛，一口鲜血喷出，手中" +target->query_temp("weapon")->query("name")+HIR"坠地而出。\n"NOR, me, target);
			target->query_temp("weapon")->move(environment(target));
			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"，杀内力"+ damage/3 +"。\n" NOR);
		}
		else
		{
			me->add("neili", -300);
			message_vision("$n提起全身真气，护体神功笼罩，阻挡了$N的烈火真元。\n", me, target);
		}
	}
	else
	{
		if (random(ap) >dp/3 )
		{
			if (me->query("jm/mingjiao")) damage = me->query_skill("shenghuo-jian",1)*me->query("str",1) + me->query_skill("liehuo-jian",1)*me->query("con",1)+ me->query_skill("shenghuo-shengong",1)*me->query("con",1) + me->query_skill("sword",1) + me->query_skill("force",1) +target->query_skill("force",1)+target->query("qi")/50;
			else damage = me->query_skill("shenghuo-jian",1)*me->query("str",1) + me->query_skill("liehuo-jian",1)*me->query("con",1)+ me->query_skill("shenghuo-shengong",1)*me->query("con",1) + me->query_skill("sword",1) + me->query_skill("force",1)+target->query_skill("force",1)+target->query("qi")/80;
			damage = damage + random(damage);
			target->receive_damage("qi", damage,me);
			target->receive_wound("qi", damage/2,me);
			me->add("neili", -3000);
			target->add("neili", -damage/2);
			message_vision(HIR"\n$n只全身受到烈火灼烧，皮肤被烤的冒烟，一口鲜血喷出。\n"NOR, me, target);
			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"，杀内力"+ damage/3 +"。\n" NOR);
		}
		else
		{
			me->add("neili", -300);
			message_vision( CYN"\n$n护体神功笼罩全身，$N的烈火真气无法侵入，只好放弃了这一招！。\n" NOR, me, target);
		}

	}
}
	me->start_busy(1);
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}