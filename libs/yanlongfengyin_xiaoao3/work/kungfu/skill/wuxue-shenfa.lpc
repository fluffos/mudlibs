//  舞雪身法
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SKILL;

string *dodge_msg = ({
  "$n一个「急转步」，随着$N的攻势飘起，从容躲过这一招。\n",
  "$n使出一招「捕风捉影」，猛然纵起丈余，结果$N扑了个空。\n",
  "$n身形一摇，幻出几个人影，一招「花影重重」躲过了$N的攻势。\n",
  "$n一招「虚无飘渺」纵身跃起，倏忽已落至$N身后。\n",
  "$n左一摇，右一晃，一招「倾灭无常」已轻松闪过。\n",
  "$n双足一点，斜斜飞起，使出「世代相随」已闪到$N身侧。\n",
});

int valid_enable(string usage) {
  return (usage == "dodge");
}

int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("max_neili") < 1000)
    return notify_fail("你的内力太差了，不能练舞雪身法。\n");
  if (me->query("family/family_name") != "日月神教")
    return notify_fail("你不是日月神教弟子，不能传授给你。\n");
  if ((int)me->query_skill("tianmo-shengong", 1) < 100)
    return notify_fail("你的天魔神功火候太浅。\n");
  return 1;
}

string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query("family/family_name") != "日月神教")
    return notify_fail("你不是日月神教弟子，不能练习本门武功。\n");
  if ((int)me->query("qi") < 100)
    return notify_fail("你的体力太差了，不能练舞雪身法。\n");
  me->receive_damage("qi", 20);
  return 1;
}

//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage) {
  int j, ap, dp, level;

  ap = me->query_skill("tianmo-shengong", 1) + me->query_skill("wuxue-shenfa", 1);
  dp = ob->query_skill("dodge", 1);
  level = (int)me->query_skill("tianmo-shengong", 1);
  if (damage < 10) damage = 10;
  if (random(6) == 0
    && random(level) >= 300
    && me->query_skill_mapped("force") == "tianmo-shengong"
    && random(ap) > dp / 10
    && me->query("jiali") > 100
    && me->query("neili") > 1000) {
    if (ob->query("neili") > level) ob->add("neili", -level);
    if (me->query("neili") < me->query("max_neili")) me->add("neili", level);
    message_vision(HIC "$N" HIC "一声冷笑! 隔空吸功!! " HIC "$n" HIC "全身功力如流水般源源不绝地吸入$N的身体！\n" NOR, me, ob);
  }
  if (random(ap) > dp / 10
    && me->query_skill("tianmo-shengong", 1) > 300
    && me->query_skill_mapped("force") == "tianmo-shengong"
    && me->query("neili") > 1000
    && random(5) == 0) {
    message_vision(HIC "$N身法突然加快，幻化出茫茫雪花！$n只见数点雪花飞舞，却不见人影！\n" NOR, me, ob);
    j = -(damage + random(damage));
    me->add("neili", -100);
    return j;
  }
}
