// zhen.c 「震」字诀
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;
int perform(object me, object target)
{
    int damage,skill;
	int ap,dp;
    string msg;
	
    if( !target ) target = offensive_target(me);
    if( !target || !target->is_character() || !me->is_fighting(target) )
        return notify_fail("神功震敌只能对战斗中的对手使用。\n");
    if( objectp(me->query_temp("weapon")) )
        return notify_fail("你必须空手才能使用「震」字诀！\n");    
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
	if( (int)me->query_skill("zhentian-quan", 1) < 300 )
        return notify_fail("你的震天拳不够娴熟，不会使用「震」字诀。\n");
	if (me->query_skill("zhenfeng-xinfa", 1)<300)
		return notify_fail("你的内功火候未到，不会使用「震」字诀！\n");
	if( me->query_skill_mapped("force") != "zhenfeng-xinfa")
		return notify_fail("你所用的内功与震天拳气路相悖！\n");   
	if (me->query_skill_mapped("unarmed") != "zhentian-quan")
		return notify_fail("你没正确激发该技能 。\n");			
	if( me->query("neili") <= 1000 )
		return notify_fail("你现在内力太弱，不能使用「震」字诀。\n");
	if( me->query("jingli") <= 1000 )
		return notify_fail("你现在精力太弱，不能使用「震」字诀。\n");
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");			
 	if( target && target->is_busy() )
		return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧。\n");  
	if ( target && target->query_temp("busy_mianyi") )	//冲穴成功后免疫busy，2017.9.29阿飞添加
		return notify_fail(target->name() + "奇经八脉浑然一体，真气浩浩荡荡，点穴似乎没什么作用。\n");	
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 		
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
    msg = CYN "$N默运神功，使出震天拳「震」字诀，企图以内力震伤$n。\n"NOR;
	message_vision(msg, me, target);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1
	
    skill = (int)me->query_skill("zhentian-quan", 1);
	ap = me->query("xyzx_sys/level") + me->query_skill("zhentian-quan", 1) + me->query_skill("unarmed") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");

    if (random(ap) > dp/3 )
    {
		msg = HIR"结果$n被$N的内力一震，眼前一黑，身子向后飞出丈许！！眼前无数星星闪耀。\n"NOR;
		message_vision(msg, me, target);	
        target->start_busy(5+(30*skill)/(skill+2000));  
		tell_object(target, HIY"你陷入忙乱之中，一时无法动弹。\n"NOR);
        damage = (int)me->query_skill("zhentian-quan",1)*2;
		damage = damage + random(damage);        
        target->receive_damage("jing", damage,me);
        target->receive_wound("jing", damage,me);
        me->add("neili", -300);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人精神的外伤为"+ damage +"，内伤为"+ damage +"。\n" NOR);
    } else 
    {

		me->add("neili", -50);
        msg = CYN"可是$p看破了$P的企图，并没有上当。\n"NOR;
		message_vision(msg, me, target);
    }
	me->start_busy(1);
    return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}