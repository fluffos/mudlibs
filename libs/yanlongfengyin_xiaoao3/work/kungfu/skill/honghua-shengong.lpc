#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit FORCE;
//inherit F_DBASE;
/*
public string query_type()
{
	return "yang";
}*/
int valid_enable(string usage)
{
	return usage == "force";
}
int valid_learn(object me)
{
	mapping skl;
	string *sname;
	int i;
	int lvl = (int)me->query_skill("honghua-shengong", 1);
	int t = 1, j;
	if (lvl<=100)
		for (j = 1; j < lvl / 10; j++)
			t*=2;
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if (me->query("family/family_name")!="红花会")
   return notify_fail("你未得到本会认可，不能学习本会技能。\n");	
	if ((int)me->query_skill("force", 1) < 100)
		return notify_fail("你的基本内功火候还不够。\n");
	if(lvl<=100)
	{
		if (lvl > 10 && (int)me->query("shen") < t * 120)
			return notify_fail("你的侠义正气太低了。\n");
	}
	else
	{
		if ((int)me->query("shen") < (51200 + (lvl - 100) * 1000))
			return notify_fail("你的侠义正气太低了。\n");
	}

	if ( me->query("gender") == "无性" && me->query_skill("honghua-shengong",1) > 49)
		return notify_fail("你无根无性，阴阳不调，难以领会高深的红花神功。\n");
	skl = this_player()->query_skills();
	sname  = keys(skl);
	for (i=0; i<sizeof(skl); i++)
	{
		if (sname[i]=="yijing-force") continue;
		if (sname[i]=="honghua-shengong") continue;
		if (sname[i]=="xixing-dafa") continue;
		if( SKILL_D(sname[i])->valid_enable("force") )
			return notify_fail("你不先散了别派内功，怎能学红花神功？！\n");
	}
	return 1;
}
int practice_skill(object me)
{
	return notify_fail("红花神功只能用学(learn)的来增加熟练度。\n");
}
string exert_function_file(string func)
{
	return __DIR__"honghua-shengong/" + func;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
	int ap,dp,damage2;
	damage2 = (int)me->query_skill("honghua-shengong",1);	
	ap = me->query_skill("honghua-shengong",1);
	dp = victim->query_skill("force",1);
    if( damage_bonus < 100 ) return 0;
	if ( me->query_skill("honghua-shengong",1) < 100)	 return 0;
	if ( me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "honghua-shengong") return 0;	
	if (damage2<10) damage2=10;	

	if ( random(ap) > dp/20 && random(6)==0 && me->query("jiali") > 0) 
	{
		victim->receive_wound("qi", damage2+100+damage_bonus/2,me);
		me->add("neili", -100 );
		return HIB "$N发挥出"+HIR+"红花神功"NOR HIB"的精髓，粉红真气摧毁了$n的真元！！！！\n" NOR;
	}
}

