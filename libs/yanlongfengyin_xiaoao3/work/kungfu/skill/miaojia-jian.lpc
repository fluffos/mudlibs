string main_skill() { return "daojian-guizhen"; }

int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }

int valid_learn(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query("family/family_name") != "胡苗世家")
    return notify_fail("你不是关外胡家或中原苗家弟子，没法传授给你。\n");

  if ((int)me->query("int", 1) < 25)
    return notify_fail("你的悟性不够，恐怕学不了苗家剑法。\n");

  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力修为不够。\n");

  if ((int)me->query_skill("lengyue-shengong") < 100)
    return notify_fail("你的冷月神功火候太浅。\n");

  if ((int)me->query_skill("sword", 1) < 500)
    return notify_fail("你的基本剑法火候不够，无法学习苗家剑法。\n");

  /*  if ((int)me->query_skill("sixiang-bufa", 1) < 120)
        return notify_fail("你的四象步法火候不够，无法学习苗家剑法。\n");

    if ((int)me->query_skill("tianchang-strike", 1) < 120)
        return notify_fail("你的天偿掌法火候不够，无法学习苗家剑法。\n");

    if ((int)me->query_skill("hujia-quan", 1) < 120)
        return notify_fail("你的胡家拳法火候不够，无法学习苗家剑法。\n");*/

  if ((int)me->query_skill("sword", 1) < (int)me->query_skill("miaojia-jian", 1))
    return notify_fail("你的基本剑法水平有限，无法领会更高深的苗家剑法。\n");

  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me) {
  object weapon;

  //		if (!wizardp(me))
  //	return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query("family/family_name") != "胡苗世家")
    return notify_fail("你不是关外胡家或中原苗家弟子，没法练习。\n");

  //        if ((int)me->query_skill("daojian-guizhen", 1))
  //                return notify_fail("你已经将苗家剑法和胡家刀法二者合一了。\n");

  if (!objectp(weapon = me->query_temp("weapon")) ||
    (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");

  if ((int)me->query("qi") < 60)
    return notify_fail("你的体力目前没有办法练习苗家剑法。\n");

  if ((int)me->query("neili") < 100)
    return notify_fail("你的内力不够，无法练习苗家剑法。\n");

  me->receive_damage("qi", 53);
  me->add("neili", -84);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "miaojia-jian/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  int ap, dp, damage2;
  ap = me->query_skill("miaojia-jian", 1);
  dp = victim->query_skill("parry", 1);
  damage2 = (int)me->query_skill("miaojia-jian", 1);

  if (damage_bonus < 100) return 0;
  if (me->query_skill("lengyue-shengong", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "lengyue-shengong") return 0;
  if (damage2 < 10) damage2 = 10;

  if (random(ap) > dp / 10 && me->query("jiali") > 0 && random(6) == 1 && me->query_skill_mapped("force") == "lengyue-shengong") {
    victim->receive_damage("qi", damage2 + 10 + damage_bonus / 2, me);
    victim->receive_wound("qi", damage2 + 10 + damage_bonus / 2, me);
    me->add("neili", -100);
    return HIR "霎时只见剑芒一闪，一股鲜血从$n胸前射出。\n" NOR;
  }
}
