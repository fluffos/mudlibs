// roar.c 君临天下
#include <ansi.h>
inherit F_CLEAN_UP;
int exert(object me, object target)
{
    object *ob;
    int i, skill, damage;
	
    if ( !wizardp(me))
		return notify_fail("这是巫师专用技能，你没有权限使用。\n");
	if( (int)me->query("jingli") < 1000 )
		return notify_fail("你的精力不够了。\n");	
	if( (int)me->query("neili") < 1000 )
		return notify_fail("你的内力不够了。\n");
//	if (target && target->query_temp("apply/shade_vision")) 
//		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
    skill = me->query_skill("force");
    message_vision(
        HIY "$N气凝丹田，运集全身内力吟出一曲「君临天下」！\n" NOR, me);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1
	me->start_busy(1);	
    ob = all_inventory(environment(me));
    for(i=0; i<sizeof(ob); i++) {
        if( !living(ob[i]) || ob[i]==me ) continue;
        if (userp(ob[i]) && !wizardp(ob[i])) continue;
        if( skill/2 + random(skill/2) < (int)ob[i]->query("con") * 2 ) continue;
        
        damage = skill*5 + random(skill*5);
        if( damage > 0 ) {
            ob[i]->receive_damage("jing", damage*2 );
            ob[i]->receive_wound("jing", damage);
            tell_object(ob[i], "你只觉得眼前一片模糊，朦胧中......\n");
			if (userp(me) && me->query("env/no_combat_msg")<4) message_vision( HIW"该绝招对敌人精神的外伤为"+ damage*2 +"，内伤为"+ damage +"。\n" NOR,me);
        }       
        if( !ob[i]->is_killing(me) ) ob[i]->kill_ob(me);
        if( !me->is_killing(ob[i]) ) me->fight_ob(ob[i]);
    }
    return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}