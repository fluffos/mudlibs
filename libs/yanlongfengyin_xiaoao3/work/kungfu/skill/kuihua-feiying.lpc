
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SKILL;

string *dodge_msg = ({
"突然$n对着$N轻轻吹了口气，$N只觉得香风扑面，忙向后纵出丈许避开。\n",
"$N只觉眼前白光一闪，$n的人影已经站在两丈开外，$N的招式全部打在空处。\n",
"$n身子一晃，$N的眼前顿时出现了四个$n的身形，当真不知哪个是真哪个是假。\n",
"$n身形一转，向后闪出尺余，在电光火石之间逼过了$N的攻击。\n",
"$N只觉眼前一花，似乎见到$n身形一幌，但随即又见$n回到原地，却似从未离开。\n",
"$N眼睛一花，便没了$n的踪影。回头一看，$n已经站在$N的身后。\n",
"$n一声长笑，身子倒纵出去，已离开$N有三丈远近，侧头向$N瞪视，一言不发。\n"
});

int valid_enable(string usage) 
{ 
    return (usage == "dodge") ; 
}

string query_dodge_msg(string limb)
{
        return dodge_msg[random(sizeof(dodge_msg))];
}
int valid_learn(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if ((int)me->query("neili") < 10000)
		return notify_fail("你的内力不够。\n");
//	if (((int)me->query_skill("kuihua-feiying", 1)+100) < (int)me->query_skill("kuihua-dafa", 1))
//		return notify_fail("你的葵花飞影术太低了。\n");
	if ((int)me->query_skill("kuihua-xinfa", 1) < 100)
		return notify_fail("你的葵花心法太低了。\n");
    if (me->query("family/family_name")!="日月神教")
   return notify_fail("不加入日月神教，学不了东方不败的技能。\n");	
    if( (int)me->query("dex",1) < 30 )
        return notify_fail("天下武功，唯快不破。\n");
	if ((int)me->query_skill("pixie-jian", 1) < 300)
		return notify_fail("你的「辟邪剑法」火候太浅。\n");

	if ( (string)me->query("gender")=="女性" )
		return notify_fail("自古就没有女子可以使用.\n");
	if ( (string)me->query("gender")=="男性" )
		return notify_fail("欲练神功，必先自宫，欲使神功，快快进宫.\n");
	if ( (string)me->query("genderbak")=="男性" )
		return notify_fail("你个假太监，赶紧去割了.\n");

	return 1;
}
int practice_skill(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
        if( (int)me->query("jing") < 40 )
                return notify_fail("你的体力太差了，不能练习葵花飞影术。\n");
	    if (me->query("family/family_name")!="日月神教")
   return notify_fail("不加入日月神教，练不了东方不败的技能。\n");	
	if ( (string)me->query("gender")=="女性" )
		return notify_fail("自古就没有女子可以使用.\n");
	if ( (string)me->query("gender")=="男性" )
		return notify_fail("欲练神功，必先自宫，欲使神功，快快进宫.\n");
	if ( (string)me->query("genderbak")=="男性" )
		return notify_fail("你个假太监，赶紧去割了.\n");		
        me->receive_damage("jing", 30);
        return 1;
}

string perform_action_file(string action)
{
        return __DIR__"kuihua-feiying/" + action;
}
	//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{

        int j,ap,dp,neili,neili1;
		ap = me->query_skill("kuihua-feiying", 1) * me->query("dex",1);
		dp = ob->query_skill("dodge", 1) * ob->query("con",1);

        neili = me->query("neili");
        neili1 = ob->query("neili");

	if (damage <10)  damage=10;  
 	if (me->query_skill("kuihua-feiying",1) > 500 
		&& me->is_busy()
		&& me->query("neili") > 1000
		&& (me->query_skill_mapped("force") == "kuihua-xinfa" || me->query_skill_mapped("force") == "kuihua-dafa")
		&& random(6)==1)
		{
			message_vision(HIC"$N阴阴一笑，默运葵花心法，僵硬的身子轻柔起来!\n"NOR, me, ob);
			me->start_busy(1);
			me->add("neili", -100 );	
		}
		
      if(random(ap) > dp/10
		&& (me->query_skill("kuihua-xinfa",1) > 100 || me->query_skill("kuihua-dafa",1) > 100)
		&& me->query_skill("kuihua-feiying", 1) > 200
		&& (me->query_skill_mapped("force") == "kuihua-xinfa" || me->query_skill_mapped("force") == "kuihua-dafa")
        && me->query("neili") > 1000
		&& random(6)==0	)
        { 	
			message_vision(HIG"$N一颦一笑都充满阴柔之力，充分发挥出女人柔软身段，一扭就闪开了$n的招式！。\n"NOR, me, ob); 		
			if (!ob->is_busy()) ob->start_busy(1);
			me->add("neili", -100 );
			if(neili >= random(neili1)+damage)
			{
				message_vision( HIB"$n大笑三声！萝莉有三好：身轻，体柔，易推倒！\n"NOR, me, ob);
				j = -(damage*2+random(damage*2));
            }
			else
			{
				j = -(damage+random(damage));
				message_vision( HIB"$n大笑三声！少妇有三好：娇羞，好玩，水灵灵！\n"NOR, me, ob);
			}
           return j;
        }          
}
