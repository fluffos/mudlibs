// yunshang-xinjing.c 云裳心经
// By suimeng
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>
inherit FORCE;

int valid_enable(string usage) { return usage=="force"; }
int valid_learn(object me)
{
    mapping skl;
    string *sname;
    int i;
    int lvl = (int)me->query_skill("yunshang-xinjing", 1);
	//	if (!wizardp(me))
	//	return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if ( me->query("gender") == "无性" && me->query("gender") == "男性")
        return notify_fail("云裳心经只有女性才可以学习。\n");
    if (me->query_skill("force",1) <=lvl)
        return notify_fail("你的基本内功基础不够，再学下去会走火入魔的。\n");
    if (me->query_skill("force",1)<100)
        return notify_fail("你的基本内功基础不够，怎能学云裳心经。\n");
	if ((int)me->query("score",1) < 5000)
		return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");

    skl = this_player()->query_skills();
    sname  = keys(skl);
    for (i=0;i<sizeof(skl);i++){
        if (sname[i]=="yunshang-xinjing") continue;
        if (sname[i]=="yijing-force") continue;
		if (sname[i]=="xixing-dafa") continue;	
		if (sname[i]=="jiuyin-zhenjing") continue;			
            if( SKILL_D(sname[i])->valid_enable("force") )
            return notify_fail("你不先散了别派内功，怎能学云裳心经？！\n");
    }
	if (random(100)==1) me->add("score",-5);		
    return 1;
}
mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
    string msg;
	int skill;
	skill = (int)me->query_skill("yunshang-xinjing",1);
        if( random(me->query("neili")) > random(victim->query("neili")) && random(3)==0)
        {
            msg = "$N"HIR"舞起曼华绝伦的舞姿，$n迷离于其中，停下了一切行动.........\n" NOR;
                victim->receive_wound("qi", skill,me);
                victim->receive_damage("jing", skill,me);
                victim->apply_condition("no_perform", 10);
                victim->apply_condition("no_enforce", 10);
                victim->apply_condition("no_exert", 10);
                return msg;
        }
}
	//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{
	string msg;
	int damage2, j;
	damage2= (int) me->query_skill("yunshang-xinjing",1)*10+1000;
	if (random(5)==0 && me->query_skill("yunshang-xinjing",1)>=300  )
    {
		if (me->query("eff_qi") < me->query("max_qi"))
		{
			me->add("eff_qi",damage2);
		}		
		if (me->query("qi") < me->query("eff_qi"))
		{
			me->add("qi",damage2);
		}
		msg = HIB "$N" HIR "运起云裳心经，若凤鸣、若蝶舞、若莺啼、若雨滴!!\n" NOR;
		ob->apply_condition("no_perform", 10);
		message_vision(msg, me, ob);
		return j;
	}       
}

int practice_skill(object me)
{
    return notify_fail("云裳心经只能用学(learn)的来增加熟练度。\n");
}
string exert_function_file(string func)
{
    return __DIR__"yunshang-xinjing/" + func;
}

