//xiaoyao 逍遥刀

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>
inherit F_SSERVER;
int perform(object me, object target)
{
	object weapon;
	int extra,ap,dp;
	string msg;
	int damage,maxnei;
	
	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("只能在战斗中使用。\n");
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "blade")
		return notify_fail("必须用刀才能施展。\n");
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
	if(me->is_busy())
		return notify_fail("你现在没空！！\n");
	if( (int)me->query("neili") < 10000  )
		return notify_fail("你的内力不够。\n");
	if( (int)me->query("max_jingli") < 200000 )
		return notify_fail("你的精力修为还不够高。\n");
	if( (int)me->query("jingli") < 10000 )
		return notify_fail("你的精力不够了。\n");
	if( (int)me->query("max_neili") < 500000 )
		return notify_fail("你的内力不够。\n");
	if( !wizardp(me) &&(int)me->query_skill("ruyi-dao", 1) < 1000 )
		return notify_fail("你的本门外功不够!不能贯通使用！\n");
	if( !wizardp(me) &&(int)me->query_skill("zhemei-shou", 1) < 1000 )
		return notify_fail("你的本门拳脚不够!不能贯通使用！\n");
	if(!wizardp(me) && (int)me->query_skill("beiming-shengong", 1) < 1000 )
		return notify_fail("你的本门内功不够高!不能贯通使用！\n");
	if(!wizardp(me) && (int)me->query_skill("lingboweibu", 1) < 1000 )
		return notify_fail("你的本门身法不够高!不能贯通使用！\n");
	if ( !wizardp(me) && me->query_skill_mapped("force") != "beiming-shengong")
		return notify_fail("不使用本门内功，如何使用本门绝学!\n");
	if (me->query_skill_mapped("blade") != "ruyi-dao")
		return notify_fail("你没正确激发该技能 。\n");
	if (!(int)me->query("breakup"))
        return notify_fail("你任督二脉未通,无法使用「逍遥」！\n"NOR);
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	msg = HBWHT "$N贯通逍遥派武学，使出了逍遥派的绝学之精髓！\n" NOR;
	message_vision(msg, me, target);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 5, me);	//CD写法1
	maxnei = me->query("max_neili");		
	extra = me->query_skill("ruyi-dao",1) + me->query_skill("lingboweibu",1);
	ap = me->query("xyzx_sys/level") + me->query_skill("ruyi-dao", 1) +me->query_skill("lingboweibu",1)+ me->query_skill("blade") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	me->set_temp("ruyi");
	//if (!target->is_busy() && random(3)==1)  target->start_busy(3);
	
	me->add_temp("apply/attack", extra);
	me->add_temp("apply/damage", extra);
	
	msg = HIY "$N一声长笑，只觉世事如意，豪气满胸，哪管什么是非荣辱，反手一刀砍出！\n"NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
	
	msg = HIB"$N刀风过处，意犹未尽，反手又是一刀！\n"NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
	
	msg = HIR"$N身随刀转，顺手又是一刀！\n"NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);

	msg = HIG"$N身随刀转，顺手再是一刀！\n"NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);

	msg = HIC"$N身随刀转，顺手最后一刀！\n"NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);

	msg = HIW"$N身形再转，如意一刀又回转回来！\n"NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);

	msg = BLU "$N化水为冰，凝于掌中，双指一弹，手上几道青光急速射向$n。\n";
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
	
	target->apply_condition("ss_poison", random(me->query_skill("lingboweibu",1)/100) + 5 + target->query_condition("ss_poison"));
	me->delete_temp("ruyi");
	me->add_temp("apply/attack", -extra);
	me->add_temp("apply/damage", -extra);
	me->add("neili", -1000);
	
if(me->query_skill("ruyi-dao",1) > 2000 && me->query_skill("lingboweibu",1)>2000)	
{	
	msg = HIC "$N手中长刀刀芒跃动，刀光暴长，一刀砍出，刀尖渐渐逼近$n，\n"NOR;
	msg += HIM"$n看到漫天刀光，抽身后跃，只这一刹，漫天刀影化为一刀直劈$n前胸，\n"NOR;
	msg += HIR"**************我自逍遥随风去***************"NOR;
	message_vision(msg, me, target);
	if( weapon = target->query_temp("weapon") )
	{
		if( random(ap) > dp/3 )
		{
			msg = HIM"\n$p只觉得浑身一热，手掌虎口巨痛，手中"+ target->query_temp("weapon")->query("name") + "脱手而出。\n" NOR;
			message_vision(msg, me, target);		
			target->query_temp("weapon")->move(environment(target));
		//	if (!target->is_busy()) target->start_busy(2);
			damage = me->query_skill("ruyi-dao",1) + me->query_skill("blade",1) + me->query_skill("lingboweibu",1)+ me->query_skill("force");
			damage = damage + random(damage);
			target->receive_damage("qi", damage,me);
			target->receive_wound("qi", damage/2,me);
			me->add("neili", -2000);
			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
		}
		else
		{
			msg = HIY"\n$p危急中突然伏地翻滚而出，避过了这致命一击，已吓得脸色苍白！\n" NOR;
			message_vision(msg, me, target);
			me->add("neili", -2000);
		}		
	}
	else
	{
		if( random(ap) > dp/3 )
		{
		//	if (!target->is_busy()) target->start_busy(random(3));
			damage = me->query_skill("beiming-shengong",1)*2 + me->query_skill("ruyi-dao",1)*2 + me->query_skill("lingboweibu",1)*2;
			target->receive_damage("qi", damage,me);
			target->receive_wound("qi", damage/2,me);
			msg = HIR"\n结果只听见几声喀喀轻响，一刀砍中正胸,$n一声惨叫，像滩软泥般塌了下去！！\n"NOR;
			message_vision(msg, me, target);
			me->add("neili", -2000);
			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
		}
		else
		{
			msg = HIY"\n$p危急中突然伏地翻滚而出，避过了这致命一击，已吓得脸色苍白！\n" NOR;
			message_vision(msg, me, target);
			me->add("neili", -2000);
		}		
	}
}
if(me->query_skill("ruyi-dao",1) > 3000 && me->query_skill("lingboweibu",1)>3000)	
{
	if( random(ap) > dp/3 )
	{
		//if (!target->is_busy()) target->start_busy(random(3));
		if (me->query("jm/xiaoyao")) damage = me->query_skill("dodge",1) + me->query_skill("blade",1) + me->query_skill("ruyi-dao",1)*me->query("dex",1) + me->query_skill("force") + me->query_skill("lingboweibu",1)*me->query("dex",1)+me->query_skill("beiming-shengong",1)*me->query("int",1)+me->query("neili")/400;
		else damage = me->query_skill("dodge",1) + me->query_skill("blade",1) + me->query_skill("ruyi-dao",1)*me->query("dex",1) + me->query_skill("force") + me->query_skill("lingboweibu",1)*me->query("dex",1)+me->query_skill("beiming-shengong",1)*me->query("int",1)+me->query("neili")/500;
		damage = damage + random(damage);
		target->receive_damage("qi", damage,me);
		target->receive_wound("qi", damage/2,me);
		target->add("neili",-damage);
//		me->add("max_neili",1+random(me->query("con",1)));
		me->add("neili", -2000);
		msg = HIR"\n$N将逍遥二字发挥的淋漓尽致，手中如意刀使的潇洒至极！！\n"NOR;
		msg += HIC"\n$N身法仿佛兮若轻云之蔽月 飘飘兮若流风之回雪！！\n"NOR;
		msg += HIB"\n$n一个不慎，随即刀锋击在破绽之处，连绵数刀，将$n削的体无完肤！！\n"NOR;
		message_vision(msg, me, target);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage +"，杀内力"+ damage +"。\n" NOR);
		if (me->query("neili") < maxnei) me->add("neili",damage/3);
		msg = HIM"\n$N诡异的伸出了手指，搭在了$n的手腕上，内力如流水般源源不绝地流入$N的身体！！\n"NOR;
		message_vision(msg, me, target);
	}
	else
	{
		msg = HIY"\n$n危急中手忙脚乱，乱拳飞舞，居然福缘深厚的击中了$N的刀背，将这一招给档了开来！\n" NOR;
		message_vision(msg, me, target);
		me->add("neili", -2000);
	}
}
  me->start_busy(1);
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}