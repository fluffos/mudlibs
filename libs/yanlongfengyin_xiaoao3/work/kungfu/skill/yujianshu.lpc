int valid_learn(object me) {
  object ob;
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("max_neili") < 100000)
    return notify_fail("你的内力修为不够深，御剑术学了也没用。\n");
  if (me->query("family/family_name") != "蜀山派")
    return notify_fail("御剑术乃蜀山不外传绝技。\n");
  if ((int)me->query_skill("shushan-force", 1) < 300)
    return notify_fail("你的蜀山心法火候不够，无法学习御剑术。\n");
  //	if ((int)me->query_skill("yujianshu", 1) > 500)
  //		return notify_fail("御剑术只能教到这里了，更高深的只能靠你自己去领悟了。\n");
  if ((int)me->query("con", 1) < 25)
    return notify_fail("你的根骨不够，御不了剑术。\n");
  if ((int)me->query("int", 1) < 25)
    return notify_fail("你的悟性不够，领悟不了御剑术。\n");
  if (!(ob = me->query_temp("weapon")) || (string)ob->query("skill_type") != "sword")
    return notify_fail("你必须先找一柄剑才能练习剑法。\n");
  if ((int)me->query("score", 1) < 10000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (random(10) == 1) me->add("score", -10);
  return 1;
}

int practice_skill(object me) {

  int dod = (int)me->query_skill("dodge", 1);
  int swo = (int)me->query_skill("yujianshu", 1);

  //		if (!wizardp(me))
  //	return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (dod < swo / 2)
    return notify_fail("你的身法跟不上剑法，练下去很可能会伤到自己。\n");
  if ((int)me->query("qi") < 30)
    return notify_fail("你体质欠佳，强练御剑术有害无益。\n");
  if ((int)me->query("neili") < 5)
    return notify_fail("你内力不足，强练御剑术有走火入魔的危险。\n");
  if (me->query("family/family_name") != "蜀山派")
    return notify_fail("御剑术乃蜀山不外传绝技，你自己练不了。\n");
  me->receive_damage("qi", 30);
  me->add("force", -5);
  message_vision("$N默默回忆了一会儿，然后练了一遍御剑术。\n", me);
  return 1;
}

int valid_enable(string usage) {
  return usage == "sword" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}
/*string query_parry_msg(object weapon)
{
    return action[random(sizeof(action))]["parry_msg"];
}*/
string perform_action_file(string func) {
  return __DIR__ "yujianshu/" + func;
}


mixed hit_ob(object me, object victim, int damage_bonus) {
  int ap, dp, damage2;
  damage2 = (int)me->query_skill("yujianshu", 1);
  ap = me->query_skill("yujianshu", 1);
  dp = victim->query_skill("dodge", 1);
  if (damage_bonus < 100) return 0;
  if (me->query_skill("shushan-force", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "shushan-force") return 0;
  if (damage2 < 10) damage2 = 10;
  if (me->query("jiali") > 0
    && me->query_skill_mapped("force") == "shushan-force"
    && random(ap) > dp / 10
    && random(5) == 0) {
    victim->receive_wound("qi", damage2 + damage_bonus / 2, me);
    //		if (!victim->is_busy()) victim->start_busy(2);
    me->add("neili", -100);
    return HIW "$N以气御剑，化气为剑！剑气漫天，$n一个不慎，顿时中了一剑！\n" NOR;
  }
}
