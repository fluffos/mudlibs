// fenfei.c 雪花太山
 
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>
 
inherit F_SSERVER;

int perform(object me, object target)
{
        string msg, msg_1, msg_2,force_skill;
        object weapon;
        int skill,skill1, skill2, skill3, skill4, skill5;
        int qi_wound, count, i;
		int flag,ap,dp,damage;
		flag = 1;
    
	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("「雪花太山」只能在战斗中使用。\n");
    if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
        return notify_fail("笨蛋，不使剑怎么能使「雪花太山」？\n");
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
	if(me->is_busy())
        return notify_fail("你现在正忙着！\n");
    if( (int)me->query("max_neili") < 1000000 )
        return notify_fail("你的内力修为还不够高！\n");
	if ((int)me->query("max_jingli")<300000)								
		return notify_fail("你的精力修为不够。\n");
	if( (int)me->query("jingli") < 10000 )
		return notify_fail("你的精力不够。\n");	
    if( (int)me->query("neili") < 10000 )
        return notify_fail("你现在的内力不足！\n");
    if( me->query_skill_mapped("sword") != "tianhe-jian") 
        return notify_fail("你没有激发天河剑法，无法使用「雪花太山」！\n");	
	if ((int)me->query_skill("huaxue-dafa", 1) < 1000 && (int)me->query_skill("yiriguan-riyue", 1) < 1000 && (int)me->query_skill("longmen-shengong", 1) < 1000)
		return notify_fail("你的本门内功火候不够，恐怕无法使用绝技。\n");	
	if ( me->query_skill_mapped("force") != "huaxue-dafa" && me->query_skill_mapped("force") != "yiqiguan-riyue" && me->query_skill_mapped("force") != "longmen-shengong") 
		return notify_fail("你未使用本门内功，如何能使用本门绝技。\n");
    if( me->query_skill("tianhe-jian",1) < 1000 )
        return notify_fail("你天河剑法的修为不够，不能使用「雪花太山」! \n");
    if( me->query_skill("feixue-quan",1) < 1000)
        return notify_fail("你的飞血拳太差，不能使用「雪花太山」! \n");
    if( me->query_skill("youran-bu",1) < 1000)
        return notify_fail("你的悠然步太差，不能使用「雪花太山」! \n");
	if (!(int)me->query("breakup"))
        return notify_fail("你任督二脉未通,无法使用[" HIR "雪花太山" NOR "]\n"NOR); 
	if (target && !living(target))
		return notify_fail("对方都已经这样了，用不着这么费力吧？\n");	
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

        skill = me->query_skill("tianhe-jian",1);
        skill2 = me->query_skill("youran-bu",1);
        skill3 = me->query_skill("feixue-quan",1);
        skill4 = target->query_skill("parry",1);
        skill5 = target->query_skill("dodge",1);			
	ap = me->query("xyzx_sys/level") + me->query_skill("tianhe-jian", 1)+me->query_skill("feixue-quan",1) + me->query_skill("sword") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");			
	message_vision(HBWHT "$N贯通血河派武学，使出了血河派的绝学之精髓！\n" NOR, me, target);	
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 5, me);	//CD写法1
        msg = HIW "\n$N怒啸一声，左刺右刺，前刺後刺，左刺右刺，这是「雪花太山」，即封死了$n的退路，虚虚实实十一剑，分袭$n。\n\n"NOR;
        message_vision(msg, me, target);
	force_skill=me->query_skill_mapped("force");
	skill1 = (int)me->query_skill(force_skill, 1);		
		if (me->query_skill_mapped("force")=="huaxue-dafa") flag = 1;
		if (me->query_skill_mapped("force")=="longmen-shengong") flag = 5;
		if (me->query_skill_mapped("force")=="yiqiguan-riyue") flag = 3;	       

        if (skill < 2000 || skill3 < 2000)
        {
                if (random(ap) > dp/3)
                {
                        msg_1 = "$n看着满眼的剑光，已经无暇顾及判断哪剑是实、哪剑是虚了。\n";
                        msg_2 = "$n只得硬起头皮，向着其中的一道剑光挡了上去。\n";
                        count = 3;
                }
                else
                {
                        msg_1 = "$n一瞥之间便已明了，这虚虚实实十一剑只有一剑是实招，其他皆是虚招。\n";
                        if (random(skill * skill3) > random(skill4 * skill5 / 2))
                            msg_2 = "$n虽然看出了一实十虚，却无法找到真正杀招之所在，只得硬起头皮，向着其中的一道剑光挡了上去。\n";
                        else msg_2 = "$n的眼光实在是敏锐之极，电光星闪之间已经判断到了$N真正杀招之所在，毫不犹豫的挡了上去。\n";
                        count = 1;
                }
        }
        else if (skill < 3000 || skill3 < 3000)
        {
                if (random(ap) > dp/3)
                {
                        msg_1 = "$n看着满眼的剑光，已经无暇顾及判断哪剑是实、哪剑是虚了。\n";
                        msg_2 = "$n只得硬起头皮，向着其中的几道剑光胡乱的挡了上去。\n";
                        count = 6;
                }
                else
                {
                        msg_1 = "$n一瞥之间心中不禁一惊，由于$N的剑移动得极快，这虚虚实实十一剑居然有六剑皆实招，实在难防之极。\n";
                        if (random(skill * skill3) > random(skill4 * skill5 / 2))
                                msg_2 = "$n虽然看出了五虚六实，却无法找到真正杀招之所在，只得硬起头皮，向着其中的几道剑光胡乱的挡了上去。\n";
                        else msg_2 = "$n的眼光实在是敏锐之极，电光星闪之间已经判断到了$N真正杀招之所在，毫不犹豫的挡了上去。\n";
                        count = 3;
                }
        }
        else
        {
                if (random(ap) > dp/3)
                {
                        msg_1 = "$n看着满眼的剑光，已经无暇顾及判断哪剑是实、哪剑是虚了。\n";
                        msg_2 = "$n只得硬起头皮，向着其中的几道剑光胡乱的挡了上去。\n";
                        count = 9;
                }
                else
                {
                        msg_1 = "$N这招一出$n不禁大惊失色，原来这这虚虚实实十一剑变幻无常，不停的实变虚、虚变实，根本无从判断。\n";
                        msg_1 = "$n知道对这十一剑的判断毫无意义，便毫不犹豫的向着所有剑光迎了上去。\n";
                        count = 5;
                }
        }
        message_vision(HIC + msg_1 + msg_2 + "\n" + NOR, me, target);
		
		me->add_temp("apply/attack",skill);
		me->add_temp("apply/strength",skill2);
		me->add_temp("apply/damage",skill3);
        for (i=0;i<count;i++)
        {
			switch ( random(5) )
			{
				case 0: msg = HIG"一时间剑光人影交织在一起，叮叮当当一阵乱响之后，$N的这一式「雪花太山」竟然被$n完全封了下来，一剑未中。\n\n"NOR;
						break;
				case 1: msg = HIM"一时间剑光人影交织在一起，然后只听一声闷哼，人影陡然分开。\n"
                        + "只见$n身上已经渐渐渗出了血迹，虽然$n奋力招架，毕竟还是有一剑透过了重重防御刺中了$n。\n"NOR;
						break;
				case 2: msg = HIM"一时间剑光人影交织在一起，然后只听一声闷哼，人影陡然分开。\n"
                        + "只见$n身上鲜血喷涌，原来虽然$n奋力招架，但虚虚实实的「雪花太山」还是有两三剑刺中了$n。\n"NOR;
						break;
				case 3: msg = HIR"一时间剑光人影交织在一起，然后只听一声惨叫，人影陡然分开。\n"
                        + "只见$n身上数道鲜血喷涌而出，$n的招架已经形同虚设，虚虚实实的「雪花太山」竟然有七八剑刺中了$n。\n"NOR;
						break;
				case 4: msg = HIR"一时间剑光人影交织在一起，然后只听一声惨叫，人影陡然分开，$n已经摇摇欲倒了。\n"
                        + "只见$n已经几乎变成了一个血人，虚虚实实的「雪花太山」的数十招剑无虚发，全部刺中了$n。\n"NOR;
						break;						
			}
			message_vision(msg, me, target);
				
			COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        }
		me->add_temp("apply/attack",-skill);
		me->add_temp("apply/strength",-skill2);
		me->add_temp("apply/damage",-skill3);

        qi_wound = skill+skill3 + random(skill+skill3) ;
//        if(qi_wound > target->query("qi")) qi_wound = target->query("qi");
        target->receive_damage("qi", qi_wound,me);
        target->receive_wound("qi", qi_wound/2,me);
        me->add("neili",-1000);
		me->add("jingli",-1000);
		target->add("neili",-qi_wound);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ qi_wound +"，内伤为"+ qi_wound +"。\n" NOR);
	//	if (!target->is_busy()) target->start_busy(1+2*flag);
		
		
if(skill > 2000 && skill3 > 2000)	
{
	damage = me->query_skill("tianhe-jian",1)*flag + me->query_skill("youran-bu",1)*flag + me->query_skill("feixue-quan",1)*flag + me->query_skill("force") + me->query_skill("unarmed") + me->query_skill("sword");
	message_vision(HIB "$N汇聚汇聚天河之力，一剑光寒十四州，剑气如庐山瀑布！\n" NOR, me, target);
	if (random(ap)>dp/3)
	{
		message_vision(HIG "$N挥洒一剑，顿时剑气如天河之水，倾泻而来！\n" NOR, me, target);
		message_vision(BLU "$n只觉无数水花，迅速凝结为雪花，浩浩荡荡，翩翩若飞！\n" NOR, me, target);
		message_vision(HIW "$n一时无法动弹，被雪花堆成一个雪人，无法呼吸！\n" NOR, me, target);
		target->receive_damage("qi", damage,me);
		target->receive_wound("qi", damage/2,me);
		target->receive_damage("jing", damage,me);
		target->receive_wound("jing", damage/2,me);	
		target->add("neili", -damage);	
		target->apply_condition("no_force", 10);
		me->add("neili",-2000);
		me->add("jingli",-2000);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"，精神的外伤为"+ damage +"，内伤为"+ damage/2 +"，杀内力"+ damage +"。\n" NOR);
	}
	else
	{
		message_vision(HIM "$n将全身功力运转到极致，最终累个半死融化了身上的雪花！\n" NOR, me, target);
		me->add("neili",-500);
	}
}		
		
if(skill > 3000 && skill3 > 3000)	
{
	if (me->query("jm/xuehe")) damage = me->query_skill("tianhe-jian",1)*me->query("int",1)*3/2 + skill1*me->query("con",1)*3/2 + me->query_skill("feixue-quan",1)*me->query("con",1)*3/2 + me->query_skill("sword") + me->query_skill("force") + me->query_skill("unarmed") + me->query("jiali")+me->query_skill("tianhe-jian",1)*flag + me->query_skill("feixue-quan",1)*flag+me->query("qi")/50;
	else damage = me->query_skill("tianhe-jian",1)*me->query("int",1) + skill1*me->query("con",1) + me->query_skill("feixue-quan",1)*me->query("con",1) + me->query_skill("sword") + me->query_skill("force") + me->query_skill("unarmed") + me->query("jiali")+me->query_skill("tianhe-jian",1)*flag + me->query_skill("feixue-quan",1)*flag+me->query("qi")/80;
	damage = damage + random(damage);
	message_vision(HIB "$N藏剑于剑鞘，身形凝聚于虚空之中，剑将出未出！\n" NOR, me, target);
	if (random(ap)>dp/3)
	{
		message_vision(HIG "$N白衣胜雪，周身雪花飞舞。雪白世界，自独立！\n" NOR, me, target);
		message_vision(BLU "只见剑光一闪，$N身形快如闪电，拔剑、杀人、飞雪！\n" NOR, me, target);
		message_vision(HIW "$n看到剑光一闪，对方身形一晃，似乎原地未动！不多时，意识已渐渐逝去！\n" NOR, me, target);
		target->receive_damage("qi", damage,me);
		target->receive_wound("qi", damage/2,me);
		target->receive_damage("jing", damage,me);
		target->receive_wound("jing", damage/2,me);	
		me->add("neili",-3000);
		me->add("jingli",-3000);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"，精神的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	}
	else
	{
		message_vision(HIM "$n全神贯注，于雪花纷飞中，捕捉到一丝剑光！\n" NOR, me, target);
		message_vision(HIW "$n以梦幻般的角度，伸出双指，恰好一段剑尖出现在指间！\n" NOR, me, target);
		message_vision(HIB "$n付出了不小的代价，挡住了这一招夺命之剑！\n" NOR, me, target);
		me->add("neili",-2000);
		me->add("jingli",-2000);
		target->receive_damage("qi", damage/3,me);
		target->receive_wound("qi", damage/5,me);
		target->add("neili", -damage/5);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage/3 +"，内伤为"+ damage/5 +"，杀内力"+ damage/5 +"。\n" NOR);
	}
}			
  me->start_busy(1);		
        return 1;
}

    
void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}    
