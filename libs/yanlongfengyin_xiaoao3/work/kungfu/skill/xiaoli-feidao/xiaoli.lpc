// xiaoli   小李飞刀
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;

int perform(object me, object target)
{
	string msg;
	int i, skill, max,ap,dp,damage;
	object weapon;

	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("「小李飞刀」只能在战斗中对对手使用。\n");
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");
	if ( !objectp(weapon=me->query_temp("weapon")) || (string)weapon->query("skill_type") != "throwing" )
		return notify_fail("你必须使用暗器时才能使出「小李飞刀」！\n");
	if ( me->query_skill_mapped("throwing") != "xiaoli-feidao" )
		return notify_fail("你未使用「小李飞刀」！\n");
//	if (target && target->query_temp("apply/shade_vision")) 
//		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 
	if (me->query_temp("apply/shade_vision")) 
		return notify_fail("纳尼！隐身了恐怕使不了飞刀。\n"); 	
	if ((int)me->query_skill("xiaoli-feidao", 1) < 3000 )
		return notify_fail("你的满天星还不够娴熟，使不出「小李飞刀」。\n");
	if( (int)me->query_skill("force",1) < 5000 )
		return notify_fail("你的内功等级不够，使不出「小李飞刀」。\n");
	if( (int)me->query_skill("throwing",1) < 5000 )
		return notify_fail("你的暗器等级不够，使不出「小李飞刀」。\n");	
	if( (int)me->query("max_jingli") < 1000000 )
		return notify_fail("你现在精力修为太弱，使不出「小李飞刀」。\n");  
	if( (int)me->query("max_neili") < 300000 )
		return notify_fail("你现在内力修为太弱，使不出「小李飞刀」。\n");     
	if( (int)me->query("neili") < (int)me->query_skill("xiaoli-feidao", 1)*4 )
		return notify_fail("你现在真气太弱，使不出「小李飞刀」。\n"); 	
	if( (int)me->query("jingli") < 10000 )
		return notify_fail("你现在真气太弱，使不出「小李飞刀」。\n"); 	
	if (!(int)me->query("breakup"))
        return notify_fail("你任督二脉未通,无法使用「小李飞刀」。\n"NOR); 	
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
 	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

	skill = me->query_skill("xiaoli-feidao", 1);
	max = me->query_skill("xiaoli-feidao", 1)/600; 		
	msg = BLU"\n$N天上地下从来没有人知道他的飞刀在哪里，也没有人知道他是怎么发出来的......\n"NOR;
	msg += HIC"\n刀未出手前，谁也想象不到他的速度与力量......\n"NOR;
	msg += GRN"\n天上地下，你绝对找不到任何人能代替他......\n"NOR;
	msg += HIY"\n若不能了解他那种伟大精神，就绝不能发出那种足以惊天动地的刀！！！\n"NOR;
	msg += CYN"\n飞刀！飞刀还未出手，可是刀的精神已在！\n"NOR;
	msg += HIB"\n那并不是杀气，但却比杀气更令人胆怯！\n"NOR;
	msg += HIR"\n只见$N手中的"+weapon->name()+"突然光芒一闪，一点星光如暴风骤雨般射向$n。\n"NOR;
	message_vision(msg, me, target);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1	
	ap = me->query("xyzx_sys/level") + me->query_skill("xiaoli-feidao", 1) + me->query_skill("throwing") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	damage = target->query("qi")/50 + target->query("xyzx_sys/level") + me->query_skill("xiaoli-feidao", 1)*me->query("int",1) + me->query_skill("throwing") + target->query_skill("force");
	damage = damage + random(damage);
	if ( random(ap) > random(dp) )
	{
		message_vision(HIM"\n\n从来没有人见过小李飞刀，见过的人都死了！！！\n\n"NOR, me, target);
		me->add("jingli",-5000);
		target->die();
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招直接秒杀了敌人。\n" NOR);
	}
	else
	{		
		if ( random(ap) > dp/3 ) 
		{
			if (max < 1) max = 1;
			if (max > 50) max = 50;
			message_vision(HIB"\n\n刀既已出手，就必然在他该在的地方！瞬间一道蓝光已在$n身上当胸穿过！！！\n\n"NOR, target ,me);
			target->receive_damage("jing", damage,me);
			target->receive_wound("jing", damage/2,me);
			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人精神的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
			me->add_temp("apply/strength", skill);
			me->add_temp("apply/attack", skill); 
//			me->add_temp("lianzhao", max);	 //2016.6.1阿飞改，增加连招标记，用于削弱连招伤害	
			for ( i=0; i<max; i++ )
			{
				msg = BLU"\n小李飞刀，例无虚发\n"NOR;
				message_vision(msg, me, target);
				COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
			} 
			me->add("neili",-max*200);   
			me->add_temp("apply/strength", -skill);
			me->add_temp("apply/attack", -skill);
//			me->delete_temp("lianzhao");  //2016.6.1阿飞改，连招结束取消连招标记
		}
		else
		{
			message_vision(HIR"\n\n飞刀一出，不死不归，不是他死就是我亡！\n\n"NOR,me);
			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招没杀到敌人，反杀了自己。\n" NOR);	
			me->die();			
		}
	}
	me->start_busy(1);
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}