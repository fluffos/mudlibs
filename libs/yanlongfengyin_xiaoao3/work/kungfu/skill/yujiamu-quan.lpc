int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }
int practice_level(){   return 56;  }
int valid_learn(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
        return notify_fail("练金刚瑜迦母拳必须空手。\n");
    if ((int)me->query("max_neili") < 10000)
        return notify_fail("你的内力不够。\n");
	if (me->query("family/family_name")!="雪山寺")
		return notify_fail("你不加入雪山寺，学不了金刚瑜伽母拳。\n");
    if ((int)me->query_skill("longxiang", 1) < 100 && (int)me->query_skill("xiaowuxiang", 1) < 100)
        return notify_fail("你的雪山寺内功似乎火候太浅。\n");
    if (me->query_skill("unarmed", 1) <=me->query_skill("yujiamu-quan", 1))
        return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
	return 1;	
}
string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}
mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}
int practice_skill(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
        return notify_fail("练金刚瑜迦母拳必须空手。\n");
    if ((int)me->query_skill("longxiang", 1) < 100 && (int)me->query_skill("xiaowuxiang", 1) < 100)
        return notify_fail("你的雪山寺内功似乎火候太浅。\n");
 if (me->query("family/family_name")!="雪山寺")
   return notify_fail("你不加入雪山寺，练习不了金刚瑜伽母拳。\n");
    if ((int)me->query("qi") < 40)
        return notify_fail("你的体力不够，练不了金刚瑜迦母拳。\n");
    me->receive_damage("qi", 20);
    return 1;
}

string perform_action_file(string action)
{
	return __DIR__"yujiamu-quan/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
	int ap,dp,damage2;
	damage2 = (int)me->query_skill("yujiamu-quan",1);	
	ap = me->query_skill("yujiamu-quan",1);
	dp = victim->query_skill("force",1);
    if( damage_bonus < 100 ) return 0;
	if ( me->query_skill("xiaowuxiang",1) < 100 && me->query_skill("longxiang",1) < 100)	 return 0;
	if ( me->query("jiali") < 1 || me->query("neili") < 100 || (me->query_skill_mapped("force") != "xiaowuxiang" && me->query_skill_mapped("force") != "longxiang")) return 0;	
	if (damage2<10) damage2=10;	
	if (me->query_skill_mapped("force") == "longxiang") damage2 = damage2*2 + me->query("jiali");
	if( random(ap) > dp/10 && random(6)==4 && me->query("jiali")>0 )
	{
		victim->receive_wound("qi", damage2+100+damage_bonus/2,me);
		me->add("neili",-100);
		return HIR "$N左手成爪，右手竖立胸前！面目狰狞，右掌猛地推出，念叨：嗔！一股大力向$n袭来！\n" NOR;
	}
}