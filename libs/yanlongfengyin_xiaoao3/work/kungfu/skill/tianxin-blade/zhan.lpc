// 「玄幻一斩」

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target)
{
	int damage1,damage,ap,dp,extra;
	string msg;
	object weapon,weap;

	if (!target ) target = offensive_target(me);
	if (!target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("「玄幻一斩」只能对战斗中的对手使用。\n");	
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "blade")
		return notify_fail("开什么玩笑，没刀子也想使用「玄幻一斩」？\n"NOR);
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 
    if(me->is_busy())
        return notify_fail("你现在正忙着！\n");
	if ( !wizardp(me) && me->query_skill_mapped("force") != "lingyuan-xinfa")
		return notify_fail("不使用本门内功，如何使用本门绝学!\n");
	if (me->query_skill_mapped("blade") != "tianxin-blade")
		return notify_fail("你没正确激发该技能 。\n");
	if ((int)me->query_skill("tianxin-blade", 1) < 1000 )
		return notify_fail("你的天行刀法不够娴熟，还使不出「玄幻一斩」。\n"NOR);
	if ((int)me->query_skill("cuixin-zhang", 1) < 1000 )
		return notify_fail("你没能领悟催心掌的阴柔内劲，还使不出「玄幻一斩」。\n"NOR);
	if ((int)me->query_skill("lingyunbu", 1) < 1000 )
		return notify_fail("你的凌云步法没学到家，不够身法配合「玄幻一斩」。\n"NOR);
	if ((int)me->query_skill("lingyuan-xinfa", 1) < 1000 )
		return notify_fail("你的灵元心法火候不够，「玄幻一斩」不成招式。\n"NOR);
	if ((int)me->query("max_neili")<1000000)
		return notify_fail("你的内力修为不足，无法运足「玄幻一斩」的内力。\n"NOR);
	if ((int)me->query("neili")<10000)	
		return notify_fail("你现在内力不够，没能将「玄幻一斩」完美使出！\n"NOR);
	if ((int)me->query("max_jingli")<500000)								
		return notify_fail("你的精力修为不够。\n");
	if( (int)me->query("jingli") < 10000 )
		return notify_fail("你的精力不够。\n");	
	if (!(int)me->query("breakup"))
        return notify_fail("你任督二脉未通,无法使用「玄幻一斩」！\n"NOR);	
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	msg = HBWHT "$N贯通玄天派武学，使出了玄天派的绝学之精髓！\n" NOR;
	message_vision(msg, me, target);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 5, me);	//CD写法1
	extra = me->query_skill("tianxin-blade",1) + me->query_skill("cuixin-zhang",1);
	ap = me->query("xyzx_sys/level") + me->query_skill("tianxin-blade", 1) +me->query_skill("cuixin-zhang",1)+ me->query_skill("blade") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");	
	msg = HIC "      $N凝神聚元，集中全身力量在手中利器之上，\n"NOR;
	msg += HIC"      准备施展天行刀法究极绝技「玄幻一斩」！！\n"NOR;
	msg += HIC"      $n被$N的杀气震慑，竟然动弹不得！！\n"NOR;	
	message_vision(msg, me, target);
	if (random(ap) > dp/3 && target->query_temp("weapon"))
	{
		weap = target->query_temp("weapon");
		message_vision(HIR "\n$N潜运全身真劲全力一刀劈下，只听 乒! 的一声巨响，" + weap->name() + "被"+weapon->name()+""HIR"从$N"HIR"手中直劈成两段，$N"HIR"情急之下只好空手应战。\n" NOR, target );
		weap->move(environment(me));
		weap->set("name", "破掉的"+ weap->query("name") );
		weap->set("value", 0);
		weap->set("weapon_prop", 0);
		weap->set("long", "一把破掉的武器，从中断开，破口整齐，看来是被绝顶高手一刀劈开的。\n");
		target->reset_action();
		me->add("neili",-200);
	}
	if (random(ap)>dp/3)
	{
	//	if (!target->is_busy()) target->start_busy(random(5));
		damage = (int)me->query_skill("tianxin-blade",1)+(int)me->query_skill("lingyuan-xinfa",1)+(int)me->query_skill("force");
		damage = damage + random(damage)+1000;
		target->receive_damage("qi", damage,me);
		target->receive_wound("qi", damage,me);
		msg = HIR"$n眼睁睁看着$N聚气成龙，充满杀意刀锋正缓缓的向自己斩下却一动也不能动！\n"NOR;
		msg += HIR"鲜血溅射而出，$n跟本没觉得疼痛，只知道冷冰冰的刀锋已经切入自己体内！！\n"NOR;
		message_vision(msg, me, target);
		me->add("neili", -2000);
		me->add("jingli", -1000);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage +"。\n" NOR);
	}
	else
	{
		msg = HIY"$p定力非常，终于在$P的刀锋斩在自己身上的时候转身闪开了\n"NOR;
		message_vision(msg, me, target);
		me->add("neili", -500);
	}
	me->fight_ob(target);
	if(!target->is_fighting(me)) target->fight_ob(me);
	
if(me->query_skill("tianxin-blade",1)>2000 && me->query_skill("cuixin-zhang",1)>2000)
{
		msg = HIR "      $N一个转身，反手又是连续三刀使出。\n"NOR;		
		message_vision(msg, me, target);
		me->add_temp("apply/attack", extra);    
		me->add_temp("apply/damage", extra);
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
		me->add_temp("apply/attack", -extra);    
		me->add_temp("apply/damage", -extra);
		me->add("neili", -300);
	if (random(ap)>dp/3)
	{
		damage1 = (int)me->query_skill("tianxin-blade",1)*2+(int)me->query_skill("cuixin-zhang",1)*2+(int)me->query_skill("force")+(int)me->query_skill("blade",1)+me->query_skill("unarmed",1);
		if (me->query("jm/xuantian")) damage1 += extra;
		damage = damage1 + random(damage1)+1000;
		target->receive_damage("qi", damage,me);
		target->receive_wound("qi", damage,me);	
		msg = HIR"$n没想到这三刀还夹杂着天行刀的刀意！一时失察，天马行空刀意侵入全身经脉，顿时肝肠寸断，痛不欲生！\n"NOR;
		me->add("neili", -1000);
		message_vision(msg, me, target);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage +"。\n" NOR);
	}
	else
	{
		msg = HIY"$n心神镇静，脚步后移，躲开了这致命一击！！\n"NOR;
		message_vision(msg, me, target);
	}
	
}	
	
if(me->query_skill("tianxin-blade",1)>3000 && me->query_skill("cuixin-zhang",1)>3000 )
{
		msg = HIR "$N忽然身法变的极慢，气势凝重起来，刀锋拖在地上，滋滋滋的火星四射。\n"NOR;
		msg += HIW "$N气势凝聚到极点，$n无法忍受，只好提前出招。\n"NOR;	
		msg += HIC "$N动若如闪电，一柄大大大大大大大的刀锋，以极极极极极极玄幻的角度，朝$n力劈而来！！！。\n"NOR;	
		message_vision(msg, me, target);
		me->add("jingli", -5000);
       message_vision(HIR
		"\n         刀刀刀刀刀刀刀刀刀刀刀刀刀刀刀刀刀刀刀刀刀刀          \n"
		"\n                         刀                        刀          \n"
		"\n                         刀                        刀          \n"
        "\n                         刀                        刀          \n"
        "\n                         刀                        刀          \n"
        "\n                         刀                        刀          \n"
        "\n                         刀                        刀          \n"
        "\n                        刀                         刀          \n"
        "\n                       刀                          刀          \n"
		"\n                      刀                           刀          \n"
        "\n                     刀                            刀          \n"
        "\n                    刀                             刀          \n"
		"\n                   刀                              刀          \n"
		"\n                  刀                               刀          \n"
        "\n                 刀                                刀          \n"
        "\n                刀                                 刀          \n"
        "\n              刀                            刀     刀          \n"
        "\n            刀                                刀   刀          \n"
        "\n          刀                                   刀刀刀          \n"NOR, me, target);

	if (me->query("jm/xuantian"))
		damage = (int)me->query_skill("tianxin-blade",1)*me->query("str",1)*3/2+(int)me->query_skill("cuixin-zhang",1)*me->query("int",1)*3/2+(int)me->query_skill("lingyuan-xinfa",1)*me->query("kar",1)*3/2+(int)me->query_skill("force",1)+(int)me->query_skill("blade",1)+me->query_skill("unarmed",1)+me->query_skill("art",1)+me->query_skill("qimen-wuxing",1)*me->query("kar",1);
	else damage = (int)me->query_skill("tianxin-blade",1)*me->query("str",1)+(int)me->query_skill("cuixin-zhang",1)*me->query("int",1)+(int)me->query_skill("lingyuan-xinfa",1)*me->query("kar",1)+(int)me->query_skill("force",1)+(int)me->query_skill("blade",1)+me->query_skill("unarmed",1)+me->query_skill("art",1)+me->query_skill("qimen-wuxing",1);
	if (random(ap)>dp/3)
	{
		damage = damage + random(damage);
		target->receive_damage("qi", damage,me);
		target->receive_wound("qi", damage,me);		
		msg = HIG"$n直接被巨大刀气透顶而过，刀气猛烈的爆发起来，浑身血箭飚射！\n"NOR;
		message_vision(msg, me, target);
		me->add("neili", -3000);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage +"。\n" NOR);
	}
	else
	{
		damage = damage/3 + random(damage/3);
		msg = HIY"$n身法变的虚幻起来，提起全身功力，连接变幻了三十六步才堪堪避开了这一刀！\n"NOR;
		msg += HIY"$n好不容易躲开了这必杀的一刀，累的半死不活！！\n"NOR;
		message_vision(msg, me, target);
		me->add("neili", -1000);
		target->add("neili",-damage);
		target->receive_damage("qi", damage,me);
		target->receive_wound("qi", damage/2,me);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"，杀内力"+ damage +"。\n" NOR);
	}
}	
	me->start_busy(1);		
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}