#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>
inherit F_SSERVER;

int perform(object me, object target)
{
	object weapon,weapon2;
	string msg;
	int extra,ap,dp;
	int i,count;

	if (!target ) target = offensive_target(me);
	if (!target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("「三分刀」只能在战斗时使用。\n");
	if( me->is_busy() ) return notify_fail("你上一招未使完！\n");
	if ( !wizardp(me) && me->query_skill_mapped("force") != "lingyuan-xinfa")
		return notify_fail("不使用本门内功，如何使用本门绝学!\n");
	if( (int)me->query_skill("lingyuan-xinfa", 1) < 300 )
		return notify_fail("你的灵元心法不够熟练，不会使用「三分刀」。\n");	
	if (!objectp(weapon = me->query_temp("weapon"))|| (string)weapon->query("skill_type") != "blade")
		 return notify_fail("你使用的武器不对。\n");
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	 
	if ((int)me->query("max_neili")<200000)								
		return notify_fail("你的内力修为不够。\n");
	if ((int)me->query("max_jingli")<10000)								
		return notify_fail("你的精力修为不够。\n");
	if( (int)me->query("jingli") < 1000 )
		return notify_fail("你的精力不够。\n");	
	if( (int)me->query("neili") < (int)me->query_skill("tianxin-blade",1)*4 )
		return notify_fail("你的真气不够！\n");	
	if( (int)me->query_skill("tianxin-blade",1) < 300 || me->query_skill_mapped("blade") != "tianxin-blade")
		return notify_fail("你的「天行刀法」还不够精纯，无法使用「三分刀」！\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	msg = HIY "$N脚踏太虚，步法缥缈，瞬间已闪至$n的面前，“刷……刷……刷”三刀已砍向$n！\n" NOR;
	message_vision(msg, me, target);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1
	ap = me->query("xyzx_sys/level") + me->query_skill("tianxin-blade", 1) + me->query_skill("blade") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	if( objectp(weapon2 = target->query_temp("weapon")) )
	{
		message_vision(HIR"$N刀上散发出来的死起竟然化作一只似有似无的巨手，凌空抓向$n手中兵刃 一一「死神锁」\n"NOR, me, target);		
		if( random(ap) > dp/3 )
		{
			if(userp(me)) me->add("neili",-200);
			msg = HIC"$n一惊，急忙向后退去，忽觉手中一轻，"+ weapon2->name() +"已脱手飞出。\n" NOR;
			message_vision(msg, me, target);
			weapon2->move(environment(me));
			me->add("neili",-200);
		}
		else
		{
			msg = HIW"左躲右闪，连变数种身法，终於保住了兵器在手，不至空手死战。\n"NOR;
			message_vision(msg, me, target);
		}
	} else
	{
		message_vision(HIR"$N刀上散发出来的死起竟然化作一只似有似无的巨手，凌空劈向$n 一一「死神斩」\n"NOR, me, target);	
		if( random(ap) > dp/3 )
		{
			target->apply_condition("no_force", 10);
			msg = HIC"$n被刀气扫过，浑身冰凉，顿时提不起气来。\n" NOR;
			message_vision(msg, me, target);			
		} else
		{
			msg = HIW"$n真气护体，刀气劈来，荡起一阵涟漪，无关痛痒。\n"NOR;
			message_vision(msg, me, target);			
		}			
	}
	
	extra = me->query_skill("tianxin-blade",1);
	me->add_temp("apply/attack", -extra);    
    me->add_temp("apply/damage", -extra);
	me->add_temp("apply/strength", -extra);
	count =  me->query_skill("tianxin-blade",1)/600;
	if(count < 1 ) count = 1;
	if (me->query("jm/xuantian"))
	{
		if (count > 100) count = 100;
	} else 
	{
		if (count > 50)	count = 50;
	}
	
//	me->add_temp("lianzhao", count);	 //2016.6.1阿飞改，增加连招标记，用于削弱连招伤害	
	for(i = 0; i < count; i++)
	{
		msg = HIY "刀光涣散！\n" NOR;
		COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);
	}
	me->add_temp("apply/attack", extra);    
    me->add_temp("apply/damage", extra);
	me->add_temp("apply/strength", extra);
	me->add("neili", -150*count);
//	me->delete_temp("lianzhao");  //2016.6.1阿飞改，连招结束取消连招标记
	me->start_busy(1);
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}