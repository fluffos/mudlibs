// jinshe-jianfa perform
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;

int perform(object me, object target)
{
	string msg;
	int i, extra, max;
	object weapon;
		
	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("「化血神针」只能在战斗中对对手使用。\n");
    if(me->is_busy())
        return notify_fail("你现在正忙着！\n");
	if ( me->query_skill_mapped("force") != "huaxue-dafa" && me->query_skill_mapped("force") != "yiqiguan-riyue" && me->query_skill_mapped("force") != "longmen-shengong") 
		return notify_fail("你未使用本门内功，如何能使用本门绝技。\n");
	if ( !objectp(weapon=me->query_temp("weapon")) || (string)weapon->query("skill_type") != "throwing"  || me->query_skill_mapped("throwing") != "huaxue-shenzhen" )
		return notify_fail("你必须使用暗器时才能使出「化血神针」！\n");
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	
	if(me->query_skill("huaxue-shenzhen", 1) < 500 )
		return notify_fail("你的化血神针还不够娴熟，使不出「化血神针」。\n");
	if( (int)me->query_skill("huaxue-dafa",1) < 300 && (int)me->query_skill("yiqiguan-riyue",1) < 300 && (int)me->query_skill("longmen-shengong",1) < 300)
		return notify_fail("你的内功等级不够，使不出「化血神针」。\n");
	if( (int)me->query("max_neili") < 100000 )
		return notify_fail("你现在内力修为太弱，使不出「化血神针」。\n");      
	if( (int)me->query("jingli") < 1000 )
		return notify_fail("你的精力不够。\n");
	if( (int)me->query("neili") < me->query_skill("huaxue-shenzhen", 1)*4 )
		return notify_fail("你现在真气不够，使不出「化血神针」。\n"); 
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

	extra = me->query_skill("huaxue-shenzhen", 1);
	max = me->query_skill("huaxue-shenzhen", 1)/60;	
	msg = BLU"\n$N纵身跃起，衣袖一挥，手中的"+weapon->name()+"同时射向$n。\n\n"NOR;
	message_vision(msg, me, target);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1	
	me->add_temp("apply/damage", -extra);
	me->add_temp("apply/attack", -extra); 
	me->add_temp("apply/strength", -extra);
	if (max < 1) max = 1;
	if (me->query("jm/xuehe")) 
	{
		if (max > 150) max = 150;
	} else 
	{
		if (max > 50) max = 50;
	}		
		
		me->add_temp("lianzhao", max);	 //2016.6.1阿飞改，增加连招标记，用于削弱连招伤害	
		for ( i=0; i<max; i++ )
		{
	        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
		}
 
		me->add("neili",-max*50);   
        me->add_temp("apply/damage", extra);
        me->add_temp("apply/attack", extra);
		me->add_temp("apply/strength", extra);
		me->delete_temp("lianzhao");  //2016.6.1阿飞改，连招结束取消连招标记		
		me->start_busy(1);
      //  if (!target->is_busy()) target->start_busy(random(3));
        return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}