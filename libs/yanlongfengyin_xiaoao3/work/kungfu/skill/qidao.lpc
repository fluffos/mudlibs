int valid_enable(string usage)
{
	return usage=="finger"  || usage=="unarmed"|| usage=="parry";
}

int valid_combine(string combo)
{
	return combo=="music";
}

int valid_learn(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if ( me->query("int",1) < 25 )
		return notify_fail("琴棋书画乃是极其风雅之事，" +RANK_D->query_respect(me)+" 似乎太过于俗气了些。\n");
	if ((int)me->query_skill("force", 1) < 100)
		return notify_fail("你的内功心法火候不够。\n");
	if ((int)me->query("max_neili") < 10000)
		return notify_fail("你的内力太弱。\n");
	if( (int)me->query_skill("art", 1) < 300 )
		return notify_fail("你的琴棋书画还不到家！\n");
    if( (int)me->query_skill("qidao", 1) > (int)me->query_skill("art", 1) )
         return notify_fail("学习棋道要以琴棋书画为基础！\n");
	if ((int)me->query("score",1) < 10000)
		return notify_fail("琴棋书画需要体验人间百态，一看你就知道阅历不丰。\n");
	if (random(100)==1) me->add("score",-10);	
	return 1;
}

int practice_skill(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if ( me->query("int",1) < 25 )
		return notify_fail("琴棋书画乃是极其风雅之事，" +RANK_D->query_respect(me)+" 似乎太过于俗气了些。\n");
	if ((int)me->query("qi") < 100)
	return notify_fail("你的体力太低了。\n");
	if ((int)me->query("neili") < 100)
		return notify_fail("你的内力不够。\n");
	if( (int)me->query_skill("art", 1) < 500 )
		return notify_fail("你的琴棋书画还不到家，不能自行研究！\n");
    if( (int)me->query_skill("qidao", 1) > (int)me->query_skill("art", 1) )
         return notify_fail("学习棋道要以琴棋书画为基础！\n");

	me->receive_damage("qi", 50);
	return 1;
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb)
{
	int level, level2;
	object weapon;
	string name;
	name = xue_name[random(sizeof(xue_name))];
	weapon = me->query_temp("weapon");
	level = (int) me->query_skill("xuantian-wuji",1);
	level2= (int) me->query_skill("xuantian-wuji",1);

	if (random(5)==0 && level>=200 && me->query("neili")>200 && me->query_skill_mapped("force") == "xuantian-wuji")
	{

//		if (!victim->is_busy()) victim->start_busy(2);
        me->add("neili", -150);
		victim->receive_damage("qi", me->query_skill("qidao", 1)/3  + damage_bonus / 2,me);
		victim->receive_wound("qi", me->query_skill("qidao", 1)/3  + damage_bonus / 2,me);
		if (random(2)==0)
			return  WHT"\n$N身侧的玉色光芒忽如蝶翼般片片飞向$n，$n只觉" HIY "『" + name + "』" NOR + WHT "中一阵灼痛。\n"NOR;
		else
			return  HIC"\n$N将内力凝为一线，攻入$n"+HIC"的体内。\n"NOR;

	}

}
	//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{

	int skill;
	int my_exp, your_exp;

	my_exp=me->query("combat_exp");
	your_exp=ob->query("combat_exp");

	skill=me->query_skill("music",1);


	if (random(6)==0 && me->is_busy())
	{
		message_vision(HIG"$N心神合一，琴弈相通，弈道的"+(order[random(13)])+""+(order[random(13)])+"「得算篇」"NOR""NOR"历历在目，身形骤然轻巧起来。\n"NOR, me);
		if (me->query("eff_qi")< me->query("max_qi") )
		{
			me->add("qi",me->query_skill("art",1)+200);
			me->add("eff_qi",me->query_skill("art",1)+200);
		}
		if (me->is_busy()) me->start_busy(1);
	}


}

string perform_action_file(string action)
{
	return __DIR__"qidao/" + action;
}