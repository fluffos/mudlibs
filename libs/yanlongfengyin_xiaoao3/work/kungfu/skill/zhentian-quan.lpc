int valid_enable(string usage) { return usage=="cuff" || usage=="parry"|| usage=="unarmed"; }
int valid_combine(string combo) { return combo=="chuanyun-tui"; }


int valid_learn(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练「震天拳」必须空手。\n");
        if ((int)me->query_skill("zhenfeng-xinfa", 1) < 100)
                return notify_fail("你的「震风心法」火候不够，无法学「震天拳」。\n");
    if (me->query("family/family_name")!="圣剑魔宫")
   return notify_fail("你不是圣剑魔宫传人，无法学习震天拳。\n");		
	if ((int)me->query("max_neili") < 5000)
		return notify_fail("你的内力太弱，无法练「震天拳」。\n");
	return 1;
}

string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int level = (int)me->query_skill("zhentian-quan",1);
	if (random(5)==1 && random(level)>300 && me->query("jiali")>100)
	{
		return ([
		"action": "$N手中招式突然加快，一招“拳腿双绝”，隔空向$n击出一拳，随即双腿连环踢出",
		"attack":	300,
		"parry":	300,
		"dodge":	300,
		"damage":	300,
		"force":	300,
		"damage_type": "内伤"
		]);
	}

	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if ((int)me->query("jing") < 30)
		return notify_fail("你的精力太低了。\n");
    if (me->query("family/family_name")!="圣剑魔宫")
   return notify_fail("你不是圣剑魔宫传人，无法练习震天拳。\n");	
	if ((int)me->query("qi") < 20)
		return notify_fail("你的内力不够练「震天拳」。\n");
	me->receive_damage("jing", 25);
	me->receive_damage("qi", 5);
	return 1;
}

string perform_action_file(string action)
{
    return __DIR__"zhentian-quan/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
	int ap,dp,damage2;
	damage2 = (int)me->query_skill("zhentian-quan",1);	
	ap = me->query_skill("zhentian-quan",1);
	dp = victim->query_skill("force",1);
    if( damage_bonus < 100 ) return 0;
	if ( me->query_skill("zhenfeng-xinfa",1) < 100)	 return 0;
	if ( me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "zhenfeng-xinfa") return 0;	
	if (damage2<10) damage2=10;	
	if(me->query("jiali") > 0
	    && me->query_skill_mapped("force") == "zhenfeng-xinfa"
	    && random(ap) > dp/10
		&& random(6)==2 )
	{
		victim->receive_wound("qi", damage2+damage_bonus/2 ,me);
//		if (!victim->is_busy()) victim->start_busy(1);
		me->add("neili", -100 );		
		return HIR "只听$n一声闷哼，被$N的震天拳打的砰砰作响，劲气入体，吐了一口鲜血！\n" NOR;
	}
}
