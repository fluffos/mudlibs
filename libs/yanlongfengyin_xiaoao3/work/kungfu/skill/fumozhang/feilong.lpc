#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>
inherit F_SSERVER;
int perform(object me, object target)
{
      string msg;
      object weapon, weapon2;
      int ap,dp,skill;

	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("飞龙探云手只能对战斗中的对手使用。\n");
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");
	if (objectp(weapon = me->query_temp("weapon")))
		return notify_fail("你必须空手。\n");
//	if (target && target->query_temp("apply/shade_vision")) 
//		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	
	if( target && target->is_busy() )
		return notify_fail(target->name() + "已经不能动了！\n");
	if ( target && target->query_temp("busy_mianyi") )	//冲穴成功后免疫busy，2017.9.29阿飞添加
		return notify_fail(target->name() + "奇经八脉浑然一体，真气浩浩荡荡，点穴似乎没什么作用。\n");
	if( me->query_skill("fumozhang",1) < 500)
		return notify_fail("你的伏魔掌等级不够, 不使用飞龙探云手！\n");
	if( me->query_skill("shushan-force",1) < 300)
		return notify_fail("你的伏魔掌等级不够, 不使用飞龙探云手！\n");
	if( me->query("max_neili") < 100000 )
		return notify_fail("你的内力修为不够，无法飞龙探云手！\n");
	if( me->query("neili") < 1000 )
		return notify_fail("你的内力不够，无法飞龙探云手！\n");
	if( (int)me->query("jingli") < 1000 )
		return notify_fail("你的精力不够。\n");	
	if ( me->query_skill_mapped("force") != "shushan-force" )
		return notify_fail("你不使用本门内功，如何能使用本门绝技！\n");		  
	if (me->query_skill_mapped("unarmed") != "fumozhang")
		return notify_fail("你没正确激发该技能 。\n");	
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	msg = CYN "$N凝神闭息，打算施展飞龙探云手夺取对方兵器. \n";
	message_vision(msg, me, target);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1
	ap = me->query("xyzx_sys/level") + me->query_skill("fumozhang", 1) + me->query_skill("unarmed") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	skill = (int)me->query_skill("fumozhang", 1);
	if (objectp(weapon2 = target->query_temp("weapon")))
	{
		if( random(ap) > dp/4 )
		{
            if(userp(me)) me->add("neili",-300);
            msg = HIW"$N使出飞龙探云手的绝招, $n顿时觉得眼前一花，手腕一麻，手中"HIM+weapon2->query("name")+HIW"到了$N的手中！\n" NOR;
			message_vision(msg, me, target);
			weapon2->move(me);
			target->apply_condition("no_equip", 10);
		}
		else
		{
			msg = "可是$n的看破了$N的企图，立刻采取守势，使$N没能夺下兵刃。\n"NOR;
			message_vision(msg, me, target);
		}
	} else
	{
		if( random(ap) > dp/3 )
		{
			msg = HIW "$n企图突破$N的攻击范围，但是被$N的掌风避的毫无退路。\n" NOR;
			message_vision(msg, me, target);
			target->start_busy((30*skill)/(skill+2000)+5);
			tell_object(target, HIY"你陷入忙乱之中，一时无法动弹。\n"NOR);
			me->add("neili", -300);
		}
		else
		{
			msg = HIC "$p一眼看出了$N的破绽，躲了过去。\n" NOR;
			message_vision(msg, me, target);
		}		
	}
	me->start_busy(1);
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}