int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }

int valid_learn(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练铁线拳必须空手。\n");
  if ((int)me->query_skill("guiyuan-dafa", 1) < 150)
    return notify_fail("你的归元大法不够，无法学铁线拳。\n");
  if (me->query("family/family_name") != "浣花剑派")
    return notify_fail("你未加入浣花派，没法学习。\n");
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力太弱，无法练铁线拳。\n");
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}


mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
  if ((int)me->query("qi") < 30)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 20)
    return notify_fail("你的内力不够练铁线拳。\n");
  if (me->query("family/family_name") != "浣花剑派")
    return notify_fail("你未加入浣花派，没法练习。\n");
  me->receive_damage("qi", 25);
  me->add("neili", -10);
  return 1;
}


string perform_action_file(string action) {
  return __DIR__ "tiexian-quan/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  int ap, dp, damage2;
  damage2 = (int)me->query_skill("tiexian-quan", 1);
  ap = me->query_skill("tiexian-quan", 1);
  dp = victim->query_skill("force", 1);
  if (damage_bonus < 100) return 0;
  if (me->query_skill("guiyuan-dafa", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "guiyuan-dafa") return 0;
  if (damage2 < 10) damage2 = 10;

  if (me->query("jiali") > 0
    && me->query_skill_mapped("force") == "guiyuan-dafa"
    && random(ap) > dp / 10
    && random(5) == 0) {
    victim->receive_wound("qi", damage2 + damage_bonus / 2, me);
    //		if (!victim->is_busy()) victim->start_busy(1);
    me->add("neili", -100);
    return HIR "只见$N的招式直来直去，化繁为简，$n只能与你硬拼，哪知$N的拳劲带有螺旋劲，$n吐了一口鲜血！\n" NOR;
  }
}
