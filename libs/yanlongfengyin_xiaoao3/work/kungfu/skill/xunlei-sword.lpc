int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }
int practice_level(){   return 150;  }
int valid_learn(object me)
{
    object weapon;
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    if (!objectp(weapon = me->query_temp("secondary_weapon"))
    || (string)weapon->query("skill_type") != "sword")
        return notify_fail("你必须先弄把剑才能学迅雷剑法。\n");
    if (me->query("family/family_name")!="昆仑派")
   return notify_fail("你不是昆仑弟子，无法学习。\n");			
    if ((int)me->query_skill("xuantian-wuji", 1) < 100)
    return notify_fail("你的玄天无极火候不够，无法学习。\n");		
    if (me->query_skill("sword", 1) <= me->query_skill("xunlei-sword",1))
       return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
    return 1;
}
string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}
mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}
int practice_skill(object me)
{
    object weapon;
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    if (!objectp(weapon = me->query_temp("secondary_weapon"))
    || (string)weapon->query("skill_type") != "sword")
        return notify_fail("你使用的武器不对。\n");
		    if (me->query("family/family_name")!="昆仑派")
   return notify_fail("你不是昆仑弟子，无法练习。\n");	
    if ((int)me->query("qi") < 50)
        return notify_fail("你的体力不够练迅雷剑。\n");
    if ((int)me->query("neili") < 50)
        return notify_fail("你的内力不足以练迅雷剑。\n");
    me->receive_damage("qi", 25);
    me->add("neili",-20);
    return 1;
}

string perform_action_file(string action)
{
        return __DIR__"xunlei-sword/" + action;
}


mixed hit_ob(object me, object victim, int damage_bonus)
{

		int ap,dp,level,damage2;
        level = (int) me->query_skill("xunlei-sword",1);  
		ap = (int) me->query("dex",1) * (int) me->query_skill("xunlei-sword",1) + me->query_skill("art",1);
		dp = (int) victim->query("con",1) * (int) me->query_skill("parry",1);
		damage2 = (int)me->query_skill("xunlei-sword",1);	
	
    if( damage_bonus < 100 ) return 0;
	if ( me->query_skill("xuantian-wuji",1) < 100)	 return 0;
	if ( me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "xuantian-wuji") return 0;	
	if (damage2<10) damage2=10;	
	
        if (random(5) == 0 && level > 100 && me->query("neili") > 500 && random(ap)>dp/10 && me->query("jiali")>0)
		{
           message_vision(HIY"$N突然身法加快，出剑速度极快，剑身雷电闪烁。\n"NOR, me, victim); 
           me->add("neili", -100 );
    //       if (!victim->is_busy()) victim->start_busy(random(3));
           message_vision(CYN"$n越战越吃力，只觉得$N剑身的力道越来越重，一道道雷电之力慢慢侵入$n的经脉！。\n"NOR, me, victim);    
		   victim->receive_wound("qi", damage2+damage_bonus/2 ,me);
		   victim->receive_damage("qi", damage2+damage_bonus/2 ,me);

        }

	return;
}
