int valid_enable(string usage) { return (usage == "spear") || (usage == "parry"); }

int valid_learn(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力修为不够。\n");
  if (((int)me->query_skill("yuejia-qiang", 1)) >= (int)me->query_skill("spear", 1))
    return notify_fail("你的基本枪法太低了。\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你江湖阅历不足，怎么可能传授你武功呢。\n");
  if (random(100) == 1) me->add("score", -5);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "yuejia-qiang/" + action;
}
string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}
mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  int skill, ap, dp, damage2;
  object weapon;
  weapon = me->query_temp("weapon");
  skill = (int)me->query_skill("yuejia-qiang", 1);
  ap = (int)me->query_skill("yuejia-qiang", 1);
  dp = victim->query_skill("parry", 1);
  damage2 = (int)me->query_skill("yuejia-qiang", 1);
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "spear") return 0;
  if (damage_bonus < 100) return 0;
  if (me->query_skill("yuejia-qiang", 1) < 100) return 0;
  if (me->query("neili") < 100) return 0;
  if (damage2 < 10) damage2 = 10;
  if (random(6) == 0 && random(ap) > dp / 10 && me->query("jiali") > 0) {
    victim->receive_damage("qi", damage2 + damage_bonus / 2, me);
    victim->receive_wound("qi", damage2 + damage_bonus / 2, me);
    return HIG "$N使出一招「壮怀激烈」，整个人消失在一团枪影之中!\n" NOR;
  }

  if (random(6) == 0 && random(ap) > dp / 10 && me->query("jiali") > 0 && random(skill) > 300) {
    victim->receive_damage("jing", damage2 + damage_bonus / 2, me);
    victim->receive_wound("jing", damage2 + damage_bonus / 2, me);
    return HIR "$N使出一招「怒发冲冠」，将手中的$w舞得密不透风!\n" NOR;
  }
}

int practice_skill(object me) {
  object weapon;
  //		 	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	  
  if (((int)me->query_skill("yuejia-qiang", 1)) >= (int)me->query_skill("spear", 1))
    return notify_fail("你的基本枪法太低了。\n");
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "spear")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力修为不够。\n");
  if ((int)me->query("jing") < 100)
    return notify_fail("你的体力不够。\n");
  if ((int)me->query("neili") < 100)
    return notify_fail("你的内力不够。\n");

  me->receive_damage("jing", 30);
  me->add("neili", -10);

  return 1;
}


//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage) {
  object wp, wp1;
  int j, neili, neili1, skill, ap, dp;
  string msg, wpname;

  wp = me->query_temp("weapon");
  wp1 = ob->query_temp("weapon");
  neili = me->query("neili");
  neili1 = ob->query("neili");
  skill = me->query_skill("yuejia-qiang", 1);
  ap = me->query("xyzx_sys/level", 1);
  dp = ob->query("xyzx_sys/level", 1);

  if (objectp(wp = me->query_temp("weapon")) && (string)wp->query("skill_type") != "spear") {
    wpname = wp->query("name");
    if (living(me) && random(skill) > 300 && random(6) == 1 && random(ap) > random(dp) / 4) {
      msg = HIY "$N豪气干云，吟道：「笑谈渴饮匈奴血」，手中的" + wpname + "由下而上，荡出了几道枪气，让$n不知所措!\n" NOR;
      if (!ob->is_busy()) ob->start_busy(2);
      message_vision(msg, me, ob);
    }

    if (living(me)
      && skill > 200
      && neili > 500
      && random(ap) > random(dp) / 4
      && me->query_skill_mapped("parry") == "yuejia-qiang"
      && living(ob)
      && random(20) > 12) {
      me->add("neili", -(random(50)));
      if (wp1) {
        msg = YEL "$N吟道：「凭栏处，潇潇雨歇」，手中的" + wpname + "舞得密不透风，将$n封于丈外。\n" NOR;
        message_vision(msg, me, ob);
        ob->receive_damage("jing", skill + 30, me);
        ob->receive_wound("jing", skill + 30, me);
        j = -damage;
      } else {
        msg = GRN "$N慷慨的诵道：「莫等闲白了少年头，空悲切」，手中的" + wpname + "化做漫天残照，荡开了$N。\n" NOR;
        message_vision(msg, me, ob);
        ob->receive_damage("qi", skill + 30, me);
        ob->receive_wound("qi", skill + 30, me);
        j = -damage;
      }
    }
    return j;
  }
}
