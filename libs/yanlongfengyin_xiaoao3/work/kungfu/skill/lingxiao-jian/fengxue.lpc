#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>


inherit F_SSERVER;

int perform(object me, object target)
{
	object ob;
	object weapon;
	string msg;
	int skill,ap,dp;
	ob=me->query_temp("weapon");
	
	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail(HIC"「风"HIW"雪"HIC"回剑」"NOR+"只能对战斗中的对手使用。\n");
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对。\n");	
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
	if((int)me->query_skill("bingxue-xinfa",1) < 300)
		return notify_fail("你的冰雪心法修为不够，还不能运用"+HIC"「风"HIW"雪"HIC"回剑」"NOR+"。\n");
	if((int)me->query_skill("lingxiao-jian",1) < 300)
		return notify_fail("你的凌霄剑法不够娴熟，使不出"+HIC"「风"HIW"雪"HIC"回剑」"NOR+"！\n");
    if ( me->query_skill_mapped("force") != "bingxue-xinfa")
        return notify_fail("不使用本门内功，如何使用本门绝学!\n");
	if (me->query_skill_mapped("sword") != "lingxiao-jian")
		return notify_fail("你没正确激发该技能 。\n");
	if((int)me->query("neili") < 1000)
		return notify_fail("你内力还现在不够。 \n");
	if( (int)me->query("jingli") < 1000 )
		return notify_fail("你的精力不够了。\n");
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");
	if( target && target->is_busy() )
		return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧。\n");
	if ( target && target->query_temp("busy_mianyi") )	//冲穴成功后免疫busy，2017.9.29阿飞添加
		return notify_fail(target->name() + "奇经八脉浑然一体，真气浩浩荡荡，点穴似乎没什么作用。\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 		
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	skill = (int)me->query_skill("lingxiao-jian",1);
	ap = me->query("xyzx_sys/level") + me->query_skill("lingxiao-jian", 1) + me->query_skill("sword") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	msg = HIC "$N回剑旋舞，剑势不断加快，剑气呼啸四散，如片片雪花遇风，飘然而出。\n形成一个雪花形旋涡，将$n裹在内里。\n"NOR;
	message_vision(msg, me, target);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1	
	if(random(ap)>dp/3)
	{
		msg =HIG "$n只觉得四周压力越来越大，道道暗流缠绕周身，动弹不得。\n" NOR;
		message_vision(msg, me, target);
		target->start_busy( 5+(30*skill)/(skill+2000));
		tell_object(target, HIY"你陷入忙乱之中，一时无法动弹。\n"NOR);
		me->add("neili", -100);
	}
	else
	{
		msg =HIR "可是$n运足内力，雪花顿时全部溶解，一片不剩，脱出重围。\n" NOR;
		message_vision(msg, me, target);
	}
	if(!target->is_fighting(me)) target->fight_ob(me);	
	me->start_busy(1);
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}