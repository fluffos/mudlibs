int valid_learn(object me) {
  object ob;
  //  	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query_skill("throwing", 1) < 300)
    return notify_fail("你的基本暗器还不够纯熟。\n");
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力不够，挥不动暗器！\n");
  if ((int)me->query("int", 1) < 30)
    return notify_fail("你悟性太差，无法领悟游刃箭的终极绝技伤心小箭！\n");
  if (me->query("family/family_name") != "血河派")
    return notify_fail("你不加入血河派，恐怕学不了血河派技能。\n");
  if ((int)me->query_skill(
    "huaxue-dafa",
    1
  ) < 100 && (int)me->query_skill(
    "yiriguan-riyue",
    1
  ) < 100 && (int)me->query_skill("longmen-shengong", 1) < 100)
    return notify_fail("你的本门内功火候不够，无法学习本门绝技。\n");
  if (!objectp(ob = me->query_temp("weapon")) || (string)ob->query("skill_type") != "throwing")
    return notify_fail("手中无箭怎能领悟所学？\n");
  return 1;
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

int valid_enable(string usage) {
  return (usage == "throwing" || usage == "parry");
}

int practice_skill(object me) {
  object weapon;
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "throwing")
    return notify_fail("没有箭如何练？\n");
  if (me->query("family/family_name") != "血河派")
    return notify_fail("你不加入血河派，恐怕练习不了血河派技能。\n");
  if ((int)me->query("qi") < 40 || (int)me->query("neili") < 10)
    return notify_fail("你的体力不足，挥不动弓！\n");
  me->receive_damage("qi", 20);
  me->add("neili", -5);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "youren-jian/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus) {

  int ap, dp, level, flag, damage2;
  flag = 1;
  level = (int)me->query_skill("youren-jian", 1);
  ap = (int)me->query("con", 1) * (int)me->query_skill("youren-jian", 1);
  dp = (int)victim->query("dex", 1) * (int)victim->query_skill("parry", 1);
  damage2 = (int)me->query_skill("youren-jian", 1);
  if (damage_bonus < 100) return 0;
  if (me->query_skill(
    "huaxue-dafa",
    1
  ) < 200 && me->query_skill(
    "yiqiguan-riyue",
    1
  ) < 200 && me->query_skill("longmen-shengong", 1) < 100) return 0;
  if (me->query_skill_mapped("force") != "huaxue-dafa" && me->query_skill_mapped("force") != "yiqiguan-riyue" && me->query_skill_mapped("force") != "longmen-shengong") return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100) return 0;
  if (damage2 < 10) damage2 = 10;
  if (me->query_skill_mapped("force") == "longmen-shengong") flag = 3;
  if (me->query_skill_mapped("force") == "huaxue-dafa") flag = 1;
  if (me->query_skill_mapped("force") == "yiqiguan-riyue") flag = 2;
  if (random(6) == 2 && level > 100 && me->query("neili") > 500 && random(ap) > dp / 10 && me->query("jiali") > 0) {
    me->add("neili", -100);
    victim->receive_wound("qi", damage2 * flag + damage_bonus / 2, me);
    victim->receive_damage("qi", damage2 * flag + damage_bonus / 2, me);
    victim->apply_condition("xiangsi", 15);
    return HIY "$N体会到情人离别之苦，使出伤心一箭，伤人，伤心！。\n" NOR;
  }
}
