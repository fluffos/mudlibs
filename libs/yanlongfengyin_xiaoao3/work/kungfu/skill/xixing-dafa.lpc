// xixing-dafa.c 吸星大法
// By suimeng
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit FORCE;
int valid_enable(string usage) { return usage == "force"; }
int valid_learn(object me) {

  int lvl = (int)me->query_skill("xixing-dafa", 1);
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  //2016.5.22阿飞和谐下面两行，将吸星大法定义为全面兼容
  //    if ( me->query("gender") == "无性")
  //       return notify_fail("你无根无性，阴阳不调，难以领会吸星大法。\n");
  if (me->query_skill("force", 1) <= lvl)
    return notify_fail("你的基本内功基础不够，再学下去会走火入魔的。\n");
  if (me->query_skill("force", 1) < 100)
    return notify_fail("你的基本内功基础不够，怎能学吸星大法。\n");
  //2016.5.22阿飞和谐下面两行，将吸星大法定义为全面兼容
  //    if ( me->query_skill("kuihua-xinfa",1) || me->query_skill("beiming-shengong",1)|| me->query_skill("huagong-dafa",1))
  //		return notify_fail("你不先散了别派内功，怎能学吸星大法？！\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (random(100) == 1) me->add("score", -5);
  return 1;
}
int practice_skill(object me) {
  return notify_fail("吸星大法只能用学的，或是从运用(exert)中增加熟练度。\n");
}
string exert_function_file(string func) {
  return __DIR__ "xixing-dafa/" + func;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  int lvl, ap, dp, damage2;
  ap = me->query_skill("xixing-dafa", 1);
  dp = victim->query_skill("force", 1);
  lvl = me->query_skill("xixing-dafa", 1);
  damage2 = (int)me->query_skill("xixing-dafa", 1);

  if (damage_bonus < 100) return 0;
  if (me->query_skill("xixing-dafa", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "xixing-dafa") return 0;
  if (damage2 < 10) damage2 = 10;

  if (random(ap) > dp / 20 && random(6) == 0 && me->query("jiali") > 0) {
    me->add("neili", -100);
    victim->receive_damage("qi", damage2 + damage_bonus / 4 + 100 + me->query("jiali"), me);
    victim->receive_wound("qi", damage2 + damage_bonus / 4 + 100 + me->query("jiali"), me);
    return HIR "吸星大法，无所不吸。$n只觉得全身气血流失！\n" NOR;
  }
}
