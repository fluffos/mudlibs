int valid_enable(string usage) { return (usage == "whip") || (usage == "parry"); }

int valid_learn(object me)
{
        object weapon;
        int lvl = (int)me->query_skill("duanyun-bian", 1);
        int t = 1;
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");			
        if( (int)me->query("max_neili") < 5000 )
                return notify_fail("你的内力不足，没有办法练断云鞭法, 多练些内力再来吧。\n");
    if (me->query("family/family_name")!="全真教")
   return notify_fail("你不是全真教弟子，无法领悟本门技能的精髓。\n");
        if ((int)me->query_skill("xiantian-qigong", 1) < 100 && (int)me->query_skill("tiangang-zhengqi", 1) < 100)			
                return notify_fail("你的本门内功火候太浅。\n");

        if ( !objectp(weapon = me->query_temp("weapon"))
        || ( string)weapon->query("skill_type") != "whip" )
                return notify_fail("你必须先找一条鞭子才能练鞭法。\n");
        if(lvl<=100)
        {
                if (lvl > 10 && (int)me->query("shen") < t * 100) 
                        return notify_fail("你的侠义正气太低了。\n");
        }
        else
        {
                if ((int)me->query("shen") < (51200 + (lvl - 100) * 1000)) 
                        return notify_fail("你的侠义正气太低了。\n");
        }
        return 1;
}

string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me)
{
        object weapon;
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "whip")
                return notify_fail("你使用的武器不对。\n");
	 if (me->query("family/family_name")!="全真教")
   return notify_fail("你不是全真教弟子，无法领悟本门技能的精髓。\n");
        if ((int)me->query("qi") < 50)
                return notify_fail("你的体力不够练断云鞭法。\n");
        me->receive_damage("qi", 5);
        return 1;
}

string perform_action_file(string action)
{
                return __DIR__"duanyun-bian/" + action;
}


mixed hit_ob(object me, object victim, int damage_bonus)
{

		int ap,dp,level,damage2;
        level = (int) me->query_skill("duanyun-bian",1);  
		ap = (int) me->query("str",1) * (int) me->query_skill("duanyun-bian",1) ;
		dp = (int) victim->query("int",1) * (int) me->query_skill("force",1);
	damage2 = (int)me->query_skill("duanyun-bian",1);	
	
    if( damage_bonus < 100 ) return 0;
	if ( me->query_skill("tiangang-zhengqi",1) < 100 && me->query_skill("xiantian-qigong",1) < 100)	 return 0;
	if ( me->query("jiali") < 1 || me->query("neili") < 100 || (me->query_skill_mapped("force") != "tiangang-zhengqi" && me->query_skill_mapped("force") != "xiantian-qigong")) return 0;	
	if (damage2<10) damage2=10;	
		
        if (random(5) == 0 && level > 100 && me->query("neili") > 500 && random(ap)>dp/10 && me->query("jiali")>0)
		{
           message_vision(HIY"$n与你越斗越吃力，只感觉$N的鞭子越来越紧，浑身踹不过起来！。\n"NOR, me, victim); 
           me->add("neili", -100 );
		   if (me->query_skill_mapped("force") == "xiantian-qigong")
		   {
//				if (!victim->is_busy()) victim->start_busy(random(3)); 
				victim->receive_wound("qi", damage2*2+damage_bonus/2 ,me);
				victim->receive_damage("qi", damage2*2+damage_bonus/2 ,me);			   
		   }
           else
		   {
				victim->receive_wound("qi", damage2+damage_bonus/2,me );
				victim->receive_damage("qi", damage2+damage_bonus/2,me);			   
		   }
        }

	return;
}

