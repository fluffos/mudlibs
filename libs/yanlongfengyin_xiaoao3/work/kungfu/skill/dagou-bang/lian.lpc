// lian.c 打狗棒法「连」字诀	

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target)
{
	object weapon;
	string msg;
	int i, attack_time;
	int ap,dp;
	
	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("「连」字诀只能对战斗中的对手使用。\n");
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "club")
		return notify_fail("你使用的武器不对。\n");
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	
	if( me->query("neili") < (int)me->query_skill("dagou-bang", 1)*4 )
		return notify_fail("你的内力不够，不会使用「连」字诀。\n");
	if( (int)me->query("jingli") < 1000 )
		return notify_fail("你的精力不够。\n");	
	if( me->query("max_neili") < 200000 )
		return notify_fail("就你这点内力，打啥子狗哦。\n");
	if( (int)me->query_skill("dagou-bang", 1) < 500 )
		return notify_fail("你的打狗棒法不够娴熟，不会使用「连」字诀。\n");
	if ((int)me->query_skill("huntian-qigong", 1) < 500)
		return notify_fail("你的本门内功火候不够，无法使用。\n");
	if ((int)me->query_skill("xiaoyaoyou", 1) < 500)
		return notify_fail("你的本门轻功火候不够，无法使用。\n");
	if ( me->query_skill_mapped("force") != "huntian-qigong")
		return notify_fail("你必须激发混天气功才能使用「「连」字诀」！\n"); 	
	if (me->query_skill_mapped("club") != "dagou-bang")
		return notify_fail("你没正确激发该技能 。\n");	
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	msg = HIG "$N使出打狗棒法「连」字诀，棒头颤动幻出无数条棒影，连绵不绝地挑向$n各处要害。\n";	
	message_vision(msg, me, target);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1	
	attack_time = (int)me->query_skill("dagou-bang", 1) / 60;
	if(attack_time < 1) attack_time = 1;	
	if (me->query("jm/gaibang")) 
	{
		if(attack_time > 150) attack_time = 150;
	} else 
	{
		if(attack_time > 50) attack_time = 50;
	}	

	ap = me->query("xyzx_sys/level") + me->query_skill("dagou-bang", 1) + me->query_skill("club") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	if(random(ap) > dp/4 )
	{
		me->add_temp("lianzhao", attack_time);	 //2016.6.1阿飞改，增加连招标记，用于削弱连招伤害
		msg = MAG "结果$n发现四周都是打狗棍，棒雨铺天盖地！\n" NOR;
		message_vision(msg, me, target);
		for(i = 0; i < attack_time; i++)
		{
			COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
		}
		me->add("neili", -100*attack_time);
		me->delete_temp("lianzhao");  //2016.6.1阿飞改，连招结束取消连招标记		
	}
	else
	{
		msg = HIY  "可是$p"+ HIY +"看破了$P的企图，并没有上当。\n" NOR;
		message_vision(msg, me, target);
	}
	 me->start_busy(1);
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}