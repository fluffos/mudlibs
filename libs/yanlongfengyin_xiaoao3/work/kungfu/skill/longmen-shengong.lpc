// made by lks;

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }


int valid_learn(object me) {
  mapping skl;
  string *sname;
  int i;
  int lvl = (int)me->query_skill("longmen-shengong", 1);
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query("gender") == "无性" && lvl > 49)
    return notify_fail("你无根无性，阴阳不调，难以领会高深的化血大法。\n");
  if (me->query("family/family_name") != "血河派")
    return notify_fail("你未加入血河派，无法学习本门技能。\n");
  if (me->query("class") == "bonze")
    return notify_fail("龙门神功讲究杀气御敌，有违佛家之意，" + RANK_D->query_respect(me) + "欲修此功，已是罪过。\n");
  if ((int)me->query("con", 1) < 30)
    return notify_fail("龙门神功需要在暗河激流中领悟，以你的体质恐怕会被激流撕成碎片。\n");
  if ((int)me->query_skill("longmen-shengong", 1) < 300)
    return notify_fail("龙门神功只能先通过领悟来打好基础。\n");
  if (me->query_skill("force", 1) <= lvl)
    return notify_fail("你的基本内功火候还不够，无法领会龙门神功。\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (!me->query("jm/xuantian"))
    return notify_fail(CYN "我血河派第十一代掌门欧阳驼于六十年前失踪，江湖上流传的摧心掌似乎与我派有关。\n" CYN "这位" + RANK_D->query_respect(me) + CYN "可否先为我派去玄天派探听其秘密，将来必有回报。\n" NOR);
  if ((int)me->query("family_score") < 8)
    return notify_fail(CYN "这位" + RANK_D->query_respect(me) + CYN "对江湖不够了解啊，我派功夫恐怕不能传授于你。\n" NOR);


  skl = me->query_skills();
  sname = keys(skl);
  for (i = 0; i < sizeof(skl); i++) {
    if (sname[i] == "huaxue-dafa") continue;
    if (sname[i] == "yiqiguan-riyue") continue;
    if (sname[i] == "longmen-shengong") continue;
    if (sname[i] == "xixing-dafa") continue;
    if (sname[i] == "yijing-force") continue;
    if (SKILL_D(sname[i])->valid_enable("force"))
      return notify_fail("你不先散了别派内功，怎能学化血大法？\n");
  }
  if (random(100) == 1) me->add("score", -5);
  return 1;
}


int practice_skill(object me) {
  return notify_fail("龙门神功不能通过练习来增加熟练度。\n");
}

string exert_function_file(string func) {
  return __DIR__ "longmen-shengong/" + func;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  int ap, dp, damage2;
  damage2 = (int)me->query_skill("longmen-shengong", 1);
  ap = me->query_skill("longmen-shengong", 1);
  dp = victim->query_skill("force", 1);
  if (damage_bonus < 100) return 0;
  if (me->query_skill("longmen-shengong", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "longmen-shengong") return 0;
  if (damage2 < 10) damage2 = 10;
  if (random(ap) > dp / 20 && random(6) == 0 && me->query("jiali") > 0) {
    victim->receive_damage("qi", damage2 + damage_bonus / 2, me);
    victim->receive_wound("qi", damage2 + damage_bonus / 2, me);
    //		if (!victim->is_busy()) victim->start_busy(3);
    me->add("neili", -100);
    return HIB "$N发挥出" + HIR + "龙门神功" NOR HIB "的真髓，摧毁了$n的精血！！！！\n" NOR;

  }
}
