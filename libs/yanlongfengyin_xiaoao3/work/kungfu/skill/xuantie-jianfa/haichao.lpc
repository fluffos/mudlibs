// 海潮汹涌

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target)
{		
	object weapon;
	int skill,times,i;
        
	if (!target ) target = offensive_target(me);
	if (!target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("「海潮汹涌」只能在战斗中对对手使用。\n");
	if (!objectp(weapon=me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
		return notify_fail("你必须使用剑才能使用「海潮汹涌」！\n");  
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");	
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
//	if(!( me->query_temp("weapon")->id("xuantie jian")))
//		return notify_fail("你必须手持玄铁剑才能使用「海潮汹涌」！\n");
	if( (int)me->query_skill("xuantie-jianfa", 1) < 300 )
		return notify_fail("你的玄铁剑法还不够娴熟，使不出「海潮汹涌」绝技。\n");
	if( (int)me->query_skill("yunv-xinfa", 1) < 300 && (int)me->query_skill("yunv-xinjing", 1) < 300)
		return notify_fail("你的玉女心法还不够娴熟，使不出「海潮汹涌」绝技。\n");			
	if( (int)me->query_skill("force",1) < 1000 )
		return notify_fail("你的基本内功等级不够，不能使用「海潮汹涌」。\n");
	if( (int)me->query_str(1) < 35 )
		return notify_fail("你的膂力还不够强劲，使不出「海潮汹涌」来。\n");
	if ( me->query_skill_mapped("sword") != "xuantie-jianfa" )
		return notify_fail("你现在无法使用「海潮汹涌」！\n");  
	if ( me->query_skill_mapped("force") != "yunv-xinfa" && me->query_skill_mapped("force") != "yunv-xinjing")
		return notify_fail("你不运转玉女心法，无法使用「海潮汹涌」！\n"); 		   
	if( (int)me->query("max_neili") < 200000 )
		return notify_fail("你现在内力太弱，使不出「海潮汹涌」。\n");   
	if ((int)me->query("max_jingli") < 100000)								
		return notify_fail("你的精力修为不够。\n");
	if( (int)me->query("jingli") < 1000 )
		return notify_fail("你的精力不够。\n");		
	if( (int)me->query("neili") < (int)me->query_skill("xuantie-jianfa", 1)*4 )
		return notify_fail("你现在真气太弱，使不出「海潮汹涌」。\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
		skill = me->query_skill("xuantie-jianfa", 1);
        if ((string)weapon->query("id") == "xuantie jian") skill = -skill;
        message_vision(HIY BBLU"\n$N大吼一声，手持玄铁剑挟巨浪潮涌之势,从轻而响，从响而轻，忽寂然无声，忽轰轰之声，反复七次，向$n席卷而去。\n"NOR,me,target);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1
        me->add_temp("apply/strength", -skill);
        me->add_temp("apply/attack", -skill);
		me->add_temp("apply/damage", -skill); 
        times = me->query_skill("xuantie-jianfa",1)/60;
	if(times < 1) times = 1;	
	if (me->query("jm/gumu"))
	{
		if(times > 150) times = 150;
	} else 
	{
		if(times > 50) times = 50;
	}		

		me->add_temp("lianzhao", times);	 //2016.6.1阿飞改，增加连招标记，用于削弱连招伤害		
        for (i=0;i<times;i++)
        {
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
        }
        me->add_temp("apply/strength", skill);
        me->add_temp("apply/attack", skill);
		me->add_temp("apply/damage", skill); 
        me->add("neili", -200*times);
        me->add("jingli", -500);
		me->delete_temp("lianzhao");  //2016.6.1阿飞改，连招结束取消连招标记		
         me->start_busy(1);
    //    if (!target->is_busy()) target->start_busy(1);
        return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}