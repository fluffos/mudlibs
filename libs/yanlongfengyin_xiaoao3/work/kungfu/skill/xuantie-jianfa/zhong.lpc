// zhong.c 举重若轻

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;


string *xue_name = ({
  "劳宫穴", "膻中穴", "曲池穴", "关元穴", "曲骨穴", "中极穴", "承浆穴", "天突穴", "百会穴",
  "幽门穴", "章门穴", "大横穴", "紫宫穴", "冷渊穴", "天井穴", "极泉穴", "清灵穴", "至阳穴",
});

int perform(object me, object target) {
  string msg, name;
  int skill, ap, dp, flag, damage;
  object weapon;
  flag = 1;


  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("玄铁剑法的「举重若轻」只能在战斗中对对手使用。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你必须使用武器才能使用「举重若轻」！\n");
  if ((int)me->query_skill("xuantie-jianfa", 1) < 1000)
    return notify_fail("你的玄铁剑法还不够娴熟，使不出「举重若轻」意境。\n");
  if ((int)me->query_skill("anranxiaohun-zhang", 1) < 1000)
    return notify_fail("你的黯然销魂掌还不够娴熟，使不出「举重若轻」意境。\n");
  if ((int)me->query_skill(
    "yunv-xinfa",
    1
  ) < 1000 && (int)me->query_skill("yunv-xinjing", 1) < 1000)
    return notify_fail("你的玉女心法等级还不够，使不出「举重若轻」意境。\n");
  if (me->query_skill_mapped("force") != "yunv-xinfa" && me->query_skill_mapped("force") != "yunv-xinjing")
    return notify_fail("你不运转玉女心法，无法使用「举重若轻」！\n");
  if ((int)me->query_skill("force", 1) < 2000)
    return notify_fail("你的基本内功等级不够，不能使用「举重若轻」。\n");
  if ((int)me->query_str(1) < 100 && userp(me))
    return notify_fail("你的膂力还不够强劲，使不出「举重若轻」来。\n");
  if (me->query_skill_mapped("sword") != "xuantie-jianfa")
    return notify_fail("你现在无法使用「举重若轻」！\n");
  //	if (target && target->query_temp("apply/shade_vision")) 
  //		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 				
  if ((int)me->query("max_jingli") < 500000)
    return notify_fail("你的精力修为不够。\n");
  if ((int)me->query("jingli") < 10000)
    return notify_fail("你的精力不够。\n");
  if ((int)me->query("max_neili") < 1000000)
    return notify_fail("你现在内力太弱，使不出「举重若轻」。\n");
  if ((int)me->query("neili") < 10000)
    return notify_fail("你的真气不够。\n");
  if (!(int)me->query("breakup"))
    return notify_fail("你任督二脉未通,无法使用[" HIR "举重若轻" NOR "]\n" NOR);
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  if (me->query("gender") == "男性") {
    skill = me->query_skill("xuantie-jianfa", 1) * 2;
  } else {
    skill = me->query_skill("xuantie-jianfa", 1) / 2;
  }

  if ((string)weapon->query("id") == "xuantie jian") flag = 2;

  message_vision(HBWHT "$N贯通古墓武学，使出了古墓派的绝学之精髓！\n" NOR, me, target);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 5, me);  //CD写法1		
  message_vision(HIB "\n$N突然顿悟玄铁剑法的「举重若轻」意境，持" + weapon->query("name") +
    HIB "挟巨浪潮涌之势，剑气形成一个旋转的气涡，向$n笼罩过去。\n" NOR, me, target);

  ap = me->query("xyzx_sys/level") + me->query_skill(
    "xuantie-jianfa",
    1
  ) + me->query_skill(
    "anranxiaohun-zhang",
    1
  ) + me->query_skill("sword") + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
  damage = me->query_skill(
    "anranxiaohun-zhang",
    1
  ) + me->query_skill("xuantie-jianfa", 1) + me->query_skill("force");

  if (random(ap) > dp / 3) {
    message_vision(HIR "结果$n全身被剑气所形成的气涡所笼罩着，只觉得犹如身陷洪涛巨浪，跌跌撞撞。\n" NOR, me, target);
    damage = damage * flag + random(damage * flag);
    me->add("neili", -300);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);


    if ((int)me->query("neili") > target->query("neili") && me->is_fighting(target)) {
      message_vision(HIB "\n$N微笑不语，趁势将手中的" + weapon->query("name") +
        HIB "从轻而响，从响而轻，忽寂然无声，忽轰轰之声，向$n席卷而去。\n" NOR, me, target);
      target->receive_damage("qi", damage, me);
      target->receive_wound("qi", damage / 2, me);
      me->add("neili", -1000);
      me->add("jingli", -1000);
      if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
        me,
        HIW "该绝招对敌人气血的外伤为" + damage + "，内伤为" + damage / 2 + "。\n" NOR
      );
      me->add_temp("apply/damage", skill);
      me->add_temp("apply/attack", skill);
      //      if (!target->is_busy() && random(3)==1)  target->start_busy(3);
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
      me->add_temp("apply/damage", -skill);
      me->add_temp("apply/attack", -skill);
      me->add("neili", -500);

    }
  } else {
    me->add("neili", -500);
    //	if (!target->is_busy()) target->start_busy(5);
    msg = HIB "\n$n在海潮般的内劲中，使出了吃奶的气力，好不容易才从淤泥中爬了出来。\n" NOR;
    message_vision(msg, me, target);
  }



  if (me->query_skill(
    "xuantie-jianfa",
    1
  ) > 2000 && me->query_skill("anranxiaohun-zhang", 1) > 2000) {
    name = xue_name[random(sizeof(xue_name))];
    msg = HIB "\n$N好不容易缓过劲来，$N身形飘忽，转了几转，移步向西，紧跟一剑刺向$n的" RED + name + HIB "。\n" NOR;
    message_vision(msg, me, target);
    damage = me->query("xyzx_sys/level") + me->query_skill(
      "xuantie-jianfa",
      1
    ) + me->query_skill(
      "anranxiaohun-zhang",
      1
    ) + me->query_skill("sword") + me->query_skill("force");
    damage = damage * flag + random(damage * flag);
    if (random(ap) > dp / 3) {
      msg = CYN "$n顿觉眼前一阵迷惑，一时不备，身上的" RED + name + CYN "已被" + weapon->name() + CYN "点中。\n" NOR;
      message_vision(msg, me, target);
      target->receive_damage("qi", damage, me);
      target->receive_wound("qi", damage / 2, me);
      me->add("neili", -2000);
      me->add("jingli", -2000);
      if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
        me,
        HIW "该绝招对敌人气血的外伤为" + damage + "，内伤为" + damage / 2 + "。\n" NOR
      );
      if (random(2) == 1) {
        target->apply_condition("no_perform", 10 + random(20));
        //   if (!target->is_busy()) target->start_busy(3);
      } else {
        target->apply_condition("no_exert", 10 + random(20));
        //  if (!target->is_busy()) target->start_busy(3);
      }

    } else {
      me->add("neili", -500);
      msg = CYN "$n凝神静气，捕捉到$N的剑招所在，一个凌空翻身，总算是躲过了这一招。\n" NOR;
      message_vision(msg, me, target);
    }

  }


  if (me->query_skill(
    "xuantie-jianfa",
    1
  ) > 3000 && me->query_skill("anranxiaohun-zhang", 1) > 3000) {
    name = xue_name[random(sizeof(xue_name))];
    msg = HIB "\n$N的神情突然凝重起来，手中的" + weapon->query("name") + HIB "变得沉重起来，但是$N舞动起来似乎又毫无重量，反手一剑刺向$n的" RED + name + HIB "。\n" NOR;
    message_vision(msg, me, target);
    if (me->query("jm/gumu")) damage = me->query_skill(
      "anranxiaohun-zhang",
      1
    ) * me->query(
      "con",
      1
    ) * 3 / 2 + me->query_skill(
      "xuantie-jianfa",
      1
    ) * me->query(
      "str",
      1
    ) * 3 / 2 + me->query_skill("force") + me->query_skill(
      "sword",
      1
    ) + me->query_skill(
      "unarmed",
      1
    ) + (me->query_skill(
      "anranxiaohun-zhang",
      1
    ) + me->query_skill(
      "xuantie-jianfa",
      1
    )) * me->query("age", 1) / 10 + target->query_dex() + target->query("qi") / 150;
    else damage = me->query_skill(
      "anranxiaohun-zhang",
      1
    ) * me->query(
      "con",
      1
    ) + me->query_skill(
      "xuantie-jianfa",
      1
    ) * me->query(
      "str",
      1
    ) + me->query_skill("force") + me->query_skill(
      "sword",
      1
    ) + me->query_skill(
      "unarmed",
      1
    ) + (me->query_skill(
      "anranxiaohun-zhang",
      1
    ) + me->query_skill(
      "xuantie-jianfa",
      1
    )) * me->query("age", 1) / 10 + target->query_dex() / 2 + target->query("qi") / 200;
    damage = damage + random(damage);
    if (random(ap) > dp / 3) {
      msg = CYN "$n看见这一招似乎稀松平常，哪知道重若千钧，一时不备，身上的" RED + name + CYN "已被" + weapon->name() + CYN "点中。\n" NOR;
      msg += RED "重若千钧的力量将$n击的鲜血狂喷！。\n" NOR;
      message_vision(msg, me, target);
      target->receive_damage("qi", damage, me);
      target->receive_wound("qi", damage / 2, me);
      target->receive_damage("jing", damage / 2, me);
      target->receive_wound("jing", damage / 4, me);
      me->add("neili", -3000);
      me->add("jingli", -3000);
      if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
        me,
        HIW "该绝招对敌人气血的外伤为" + damage + "，内伤为" + damage / 2 + "，精神的外伤为" + damage / 2 + "，内伤为" + damage / 4 + "。\n" NOR
      );
    } else {
      me->add("neili", -500);
      target->receive_damage("qi", damage / 3, me);
      target->receive_wound("qi", damage / 5, me);
      msg = CYN "$n神情严肃，这一招看似简单实则不可能硬碰。$n使出浑身解数，将$N的剑上的力量导入地下，但仍受到不小的内伤。\n" NOR;
      message_vision(msg, me, target);
      if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
        me,
        HIW "该绝招对敌人气血的外伤为" + damage / 3 + "，内伤为" + damage / 5 + "。\n" NOR
      );
    }

  }
  me->start_busy(1);
  return 1;
}



void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
