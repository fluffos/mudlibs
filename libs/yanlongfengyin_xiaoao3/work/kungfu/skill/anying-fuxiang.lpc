// anying-fuxiang.c
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SKILL;

string *dodge_msg = ({
    "$n一个「"+YEL+"月上柳梢头"+NOR+"」，随着$N的攻势飘起，从容躲过这一招。\n",
    "$n使出一招「"+RED+"大漠孤烟直"+NOR+"」，猛然纵起丈余，结果$N扑了个空。\n",
    "$n身形一摇，幻出几个人影，一招「"+HIY+"碎影舞斜阳"+NOR+"」躲过了$N的攻势。\n",
    "$n一招「"+HIY+"燕子三抄水"+NOR+"」纵身跃起，倏忽已落至$N身后。\n",
    "$n左一摇，右一晃，一招「"+HIB+"云深不知处"+NOR+"」已轻松闪过。\n",
    "$n双足一点，斜斜飞起，使出「"+HIR+"斜日杏花飞"+NOR+"」已闪到$N身侧。\n",
});
int valid_enable(string usage) 
{ 
    return (usage == "dodge") ;
}
int practice_level(){   return 60;  }
int valid_learn(object me) 
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
	if ((int)me->query_skill("bibo-shengong", 1) < 100)
   return notify_fail("你的碧波神功不够熟练。\n");
    if (me->query("family/family_name")!="桃花岛")
   return notify_fail("你不是本门中人，无法领悟本门技能的精髓。\n");
    if (me->query_skill("dodge",1)<=me->query_skill("anying-fuxiang",1))
        return notify_fail("你的基本轻功基础不够，无法领会更高深的技巧。\n");
   
        return 1;
    
}
string query_dodge_msg(string limb)
{
        return dodge_msg[random(sizeof(dodge_msg))];
}
int practice_skill(object me)
{
	if (!wizardp(me))
		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	    if (me->query("family/family_name")!="桃花岛")
			return notify_fail("你不是本门中人，如何学到本门高深技能，我要告诉掌门去。\n");
        if( (int)me->query("qi") < 30 )
            return notify_fail("你的体力太差了，不能练暗影浮香。\n");

        me->receive_damage("qi", 10);

        return 1;
}

string perform_action_file(string action)
{
        return __DIR__"anying-fuxiang/" + action;
}
	//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡bug有关
int ob_hit(object ob, object me, int damage)
{

        int j,ap,dp;
		ap = me->query_skill("anying-fuxiang", 1) ;
		dp = ob->query_skill("dodge", 1) ;

	if (damage <10)  damage=10;      	
      if(random(ap) > dp/10
		&& me->query_skill("bibo-shengong",1) > 100
		&& me->query_skill("anying-fuxiang", 1) > 200
		&& me->query_skill_mapped("force") == "bibo-shengong"
        && me->query("neili") > 1000
		&& random(5)==0	)
        { 	
        message_vision(HIG"$N举头望明月，低头轻吟：人约黄昏后，月上柳梢头！$n长叹一声：如此良辰美景，打打杀杀大煞风景！\n"NOR, me, ob); 		
            j = -(damage+random(damage)); 
			me->add("neili", -100 );
			return j;        
        }  
		
}
