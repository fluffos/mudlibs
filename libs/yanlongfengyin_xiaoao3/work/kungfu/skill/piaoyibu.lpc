// piaoyibu.c
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SKILL;

string *dodge_msg = ({
        "$n一个「银鹭渡海」，跃起数尺，躲过了$N这一招。\n",
        "$n身形向后一纵，使出一招「玉兔落尘」，避过了$N的攻击。\n",
        "$n使出「锦鲤穿沙」，恰好躲过了$N的攻势。\n",
        "$n一招「灵狐幻遁」，姿态美妙地躲了开去。\n"
});

int valid_enable(string usage)
{
        return (usage == "dodge");
}

int valid_learn(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
        if ((int)me->query_skill("zhenfeng-xinfa", 1) < 200)
                return notify_fail("你的「震风心法」火候不够，无法学「飘逸步法」。\n");
    if (me->query("family/family_name")!="圣剑魔宫")
   return notify_fail("你不是圣剑魔宫传人，无法学习飘逸步法。\n");					
        if ((int)me->query("max_neili") < 10000)
                return notify_fail("你的内力太弱，无法练「飘逸步法」。\n");
        return 1;
}


string query_dodge_msg(string limb)
{
        return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
        if( (int)me->query("qi") < 40 )
                return notify_fail("你的体力太差了，不能练飘逸步法。\n");
    if (me->query("family/family_name")!="圣剑魔宫")
   return notify_fail("你不是圣剑魔宫传人，无法练习飘逸步法。\n");				
        if (me->query_skill("piaoyibu", 1) < 30)
                me->receive_damage("qi", 10);
        else if (me->query_skill("piaoyibu", 1) < 60)
                me->receive_damage("qi", 20);
        else
                me->receive_damage("qi", 30);
        return 1;
}
string perform_action_file(string action)
{
        return __DIR__"piaoyibu/" + action;
}

	//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{

        int j,ap,dp;
		ap = me->query_skill("piaoyibu", 1) * me->query("int",1);
		dp = ob->query_skill("dodge", 1) * ob->query("dex",1);

	if (damage <10)  damage=10;      	
      if(random(ap) > dp/10
		&& me->query_skill("zhenfeng-xinfa",1) > 100
		&& me->query_skill("piaoyibu", 1) > 200
		&& me->query_skill_mapped("force") == "zhenfeng-xinfa"
        && me->query("neili") > 200
		&& random(5)==0	)
        { 	
        message_vision(HIG"$N脚踏天、地、人三元方位，飘飘乎在三者之间随意流转！\n"NOR, me, ob); 		
            j = -(damage+random(damage));
			me->add("neili", -100 );
			ob->add("neili", -(me->query("jiali") +1000) );
			return j;        
        }  
		
}
