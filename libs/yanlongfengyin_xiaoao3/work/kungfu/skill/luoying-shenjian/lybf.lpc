// lybf.c 落英神剑之落英缤纷
// by victori
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target)
{
	object weapon;
	int damage,damage2,skill1,skill2;
	int ap,dp;
	string msg;

	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("「落英缤纷」只能对战斗中的对手使用。\n");
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对。\n");
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	
	if( me->is_busy() )
		return notify_fail("你现在正忙着呢，哪有空运功？\n");
	if( (int)me->query_skill("luoying-shenjian", 1) < 300 )
		return notify_fail("你的落英神剑不够娴熟，不能使用「落英缤纷」。\n");
	if( (int)me->query_skill("qimen-wuxing", 1) < 300)
		return notify_fail("你的奇门五行修为太低，不能使用「落英缤纷」。\n");
	if( (int)me->query_skill("bibo-shengong", 1) < 300)
		return notify_fail("你的碧波神功修为太低，不能使用「落英缤纷」。\n");
	if( me->query_skill_mapped("force") != "bibo-shengong")
		return notify_fail("不使用本门内功，如何能使用本门绝技！\n");
	if (me->query_skill_mapped("sword") != "luoying-shenjian")
		return notify_fail("你没正确激发该技能 。\n");
	if( (int)me->query("neili", 1) < 1000 )
		return notify_fail("你现在内力太弱，不能使用「落英缤纷」。\n");
	if( (int)me->query("jingli") < 1000 )
		return notify_fail("你的精力不够了。\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	msg = HIM "$N配合奇门五行之奥妙阵法，使出桃花岛落英剑法之「落英缤纷」，剑锋直逼$n。\n"NOR;
	message_vision(msg, me, target);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1

	ap = me->query("xyzx_sys/level") + me->query_skill("luoying-shenjian", 1) + me->query_skill("sword") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	skill1 = me->query_skill("qimen-wuxing",1);
	if (target->query_skill("qimen-wuxing",1)) skill2 = target->query_skill("qimen-wuxing",1);
	else skill2 = 0;
	if (random(ap) > dp/3 )
	{
		damage = (int)me->query_skill("luoying-shenjian") + (int)me->query_skill("qimen-wuxing");
		damage = damage + random(damage);
		target->receive_damage("qi", damage,me);
		target->receive_wound("qi", damage,me);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage +"。\n" NOR);
		if(skill1>skill2)
		{
			damage2 = (skill1-skill2)*5;
			damage2 = damage2 + random(damage2);
			target->receive_damage("jing", damage2,me);
			target->receive_wound("jing", damage2,me);
			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人精神的外伤为"+ damage2 +"，内伤为"+ damage2 +"。\n" NOR);
		}
		me->add("neili", -300);
		msg = HIR"$n无法识破奇门五行之精髓所在，身陷囹圄，面对$N的攻势，然不知所措！\n$N乘势又是刺出5剑...\n"NOR;
		message_vision(msg, me, target);
		//再出5招的写法
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
	}
	else
	{
		msg = CYN"可是$n看破了$N的企图，$N的招数尽被化解。\n"NOR;
		message_vision(msg, me, target);
	}
	  me->start_busy(1);

	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}