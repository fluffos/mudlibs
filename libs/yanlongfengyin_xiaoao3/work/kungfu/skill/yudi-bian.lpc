    "force": 100,
    "lvl": 15,
    "skill_name": "开道斩蛇",
    "damage_type": "刮伤"
  ]),
  ([ "action": "$N一招「顶天立地」，手中$w直绕向$n的$l",
    "attack": 100,
    "parry": 100,
    "dodge": 100,
    "damage": 100,
    "force": 100,
    "lvl": 20,
    "skill_name": "顶天立地",
    "damage_type": "内伤"
  ]),
  ([ "action": "$N一招「怒屈金虹」，手中$w腾空一卷，一声脆响入磬，猛地向$n劈头打下",
    "attack": 200,
