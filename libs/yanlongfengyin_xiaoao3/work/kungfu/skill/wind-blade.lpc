		"parry":	100,
		"dodge":	100,
		"damage":	100,
		"force":	100,
                "lvl" : 0,
                "skill_name" : "日本无敌",
    		"damage_type":	"割伤"
	]),
	([	"action":		"$N手中的$w迎风狂舞，象暴风中的滚沙，裹向$n的$l",
		"attack":	200,
		"parry":	200,
		"dodge":	200,
		"damage":	200,
		"force":	200,
                "lvl" : 20,
                "skill_name" : "东亚共荣",
		"damage_type":	"割伤"
	]),
	([	"action":		"$N手中的$w象狂风中的流云，忽聚忽散地砍向$n的$l",
		"attack":	200,
		"parry":	200,
		"dodge":	200,
		"damage":	200,
		"force":	200,
                "lvl" : 40,
                "skill_name" : "中日亲善",
                "damage_type":	"割伤"
	]),
	([	"action":		"$N晃动手中的$w，刀光忽隐忽现，象秋风中的落叶，一刀连一刀地散向$n的$l",
		"attack":	300,
		"parry":	300,
		"dodge":	300,
		"damage":	300,
		"force":	300,
                "lvl" : 80,
                "skill_name" : "天皇万岁",
                "damage_type":	"割伤"
	]),
	([	"action":		"$N聚起全身的功力，手中的$w象刺骨寒风般割向$n",
		"attack":	300,
