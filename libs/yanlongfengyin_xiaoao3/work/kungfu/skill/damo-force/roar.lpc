#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

//inherit F_CLEAN_UP;
inherit F_SSERVER;
int exert(object me, object target)
{
        object *ob;
        int i, skill, damage;

		
	if (target == me || ! target)
	{
		me->clean_up_enemy();
		target = me->select_opponent();
	}
	if (! me->is_fighting(target))
       return notify_fail("达摩神功只能在战斗中使用。\n");	
//	if (target && target->query_temp("apply/shade_vision")) 
//		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	   
	if (me->query_temp("apply/shade_vision")) 
		return notify_fail("隐身了还大吼大叫，会暴露的。\n"); 	
	if( me->is_busy() )
		return notify_fail("你现在正忙着呢，哪有空运功？\n");
	if( (int)me->query("neili") < 1000  )
		return notify_fail("你鼓足真气\"喵\"的吼了一声, 结果吓走了几只老鼠。\n");
	if( (int)me->query("jingli") < 1000 )
		return notify_fail("你的精力不够。\n");	
	if( (int)me->query("max_neili") < 100000  )
		return notify_fail("你内力修为不足，恐怕难以使用佛门狮子吼。\n");
	if( (int)me->query_skill("damo-force",1) < 300  )
		return notify_fail("你的达摩神功火候不足。\n");
	if ( !wizardp(me) && me->query_skill_mapped("force") != "damo-force")
		return notify_fail(HIC"不使用本门内功，如何使用本门绝学!\n"NOR);
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
        skill = me->query_skill("force",1)+(int)me->query_skill("damo-force",1)*2;
        me->add("neili", -300);
		me->add("jingli", -300);
        message_vision( HIY "$N深深地吸一囗气，真力迸发，发出一声惊天动地的巨吼ⅵ\n" NOR, me);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1
        ob = all_inventory(environment(me));
        for(i=0; i<sizeof(ob); i++) {
                if( !living(ob[i]) || ob[i]==me ) continue;
                if( skill/2 + random(skill/2) < (int)ob[i]->query("con") * 2 ) continue;
                
                damage = skill * 2;
				damage =  damage + random(damage);
                if( damage > 0 ) 
				{
                        ob[i]->receive_damage("jing", damage,me);
                        ob[i]->receive_wound("jing", damage);
                        tell_object(ob[i], "你觉得眼前一阵金星乱冒，耳朵痛得像是要裂开一样ⅵ\n");
						if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对"+ i +"敌人精神的外伤为"+ damage +"，内伤为"+ damage +"。\n" NOR);
                }
                if( !ob[i]->is_killing(me) ) ob[i]->kill_ob(me);
                if( !me->is_killing(ob[i]) ) me->fight_ob(ob[i]);
        }
		 me->start_busy(1);
        return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}