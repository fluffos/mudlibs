// sanxian.c 华山剑法「夺命连环三仙剑」

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

#define XIAN "「" HIM "夺命连环三仙剑" NOR "」"

inherit F_SSERVER;

int perform(object me, object target)
{
	int damage,extra;
	string msg;
	object weapon;
	int ap, dp;


	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() ||!me->is_fighting(target) )
		return notify_fail(XIAN "只能在战斗中对对手使用。\n");
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");
	if (! objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对！\n");
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	
    if( (int)me->query_skill("zixia-shengong",1) < 1000 )
        return notify_fail("你的本门内功还不到家，无法使用本门绝技！\n");
	if ((int)me->query_skill("huashan-jianfa", 1) < 1000)
		return notify_fail("你华山剑法不够娴熟，无法施展" XIAN "。\n");
	if ((int)me->query_skill("huashan-shenfa", 1) < 1000)
		return notify_fail("你华山身法修为不够，无法施展" XIAN "。\n");
	if ((int)me->query_skill("kuangfeng-jian", 1) < 1000)
		return notify_fail("你狂风剑法修为不够，无法施展" XIAN "。\n");
	if ((int)me->query("max_neili") < 1000000)
		return notify_fail("你现在内力修为不够，无法施展" XIAN "！\n");
	if ((int)me->query("neili") < 10000)
		return notify_fail("你现在内力不够，无法施展" XIAN "！\n");
	if ((int)me->query("max_jingli") < 300000)
		return notify_fail("你现在精力修为不够，无法施展" XIAN "！\n");
	if ((int)me->query("jingli") < 10000)
		return notify_fail("你现在精力不够，无法施展" XIAN "！\n");
	if (me->query_skill_mapped("sword") != "huashan-jianfa")
		return notify_fail("你没有激发华山剑法，无法使用" XIAN "。\n");
	if (me->query_skill_mapped("force") != "zixia-shengong")
		return notify_fail("你没有激发紫霞神功，无法使用" XIAN "。\n");	
	if (!(int)me->query("breakup"))
        return notify_fail("你任督二脉未通,无法领悟[" HIR "夺命连环三仙剑" NOR "]\n"NOR); 	
	if (target && !living(target))
		return notify_fail("对方都已经这样了，用不着这么费力吧？\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
		message_vision(HBWHT "$N贯通华山派武学，使出了华山派的绝学之精髓！\n" NOR, me, target);	
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 5, me);	//CD写法1
	ap = me->query("xyzx_sys/level") + me->query_skill("huashan-jianfa", 1) + me->query_skill("kuangfeng-jian", 1) + me->query_skill("sword") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	damage = me->query_skill("huashan-jianfa",1)+me->query_skill("kuangfeng-jian",1)+me->query_skill("zixia-shengong",1) + me->query_skill("sword",1);
	extra = me->query_skill("huashan-jianfa",1)+me->query_skill("kuangfeng-jian",1);
	message_vision(HIW "\n$N" HIW "长啸一声，手中" + weapon->name() + HIW "随即不停转动，汹涌而"
	               "出，正是华山剑宗绝技「" HIM "夺命连环三仙剑" HIW "」，但是" + weapon->name() + HIW
	               "\n剑锋突变，一剑顿时化为三剑，袭向$n" HIW "……\n" NOR, me, target);
	me->add_temp("apply/attack", extra);
	me->add_temp("apply/dodge", extra);
	me->add_temp("apply/damage", extra);
	msg = HIM "$N" HIM "将内力全都运到了剑上，呼的一剑，当头直劈。\n" NOR;
	message_vision(msg, me, target);
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	msg = HIM "\n$N" HIM "圈转" + weapon->name() + HIM "，拦腰横削，剑势恢弘，剑气纵横，令人匪夷所思。\n" NOR;
	message_vision(msg, me, target);
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	msg = HIM "\n$N" HIM "圈转" + weapon->name() + HIM "，拦腰横削，剑势恢弘，剑气纵横，令人匪夷所思。\n" NOR;
	message_vision(msg, me, target);
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));	
	me->add_temp("apply/attack", -extra);
	me->add_temp("apply/dodge", -extra);
	me->add_temp("apply/damage", -extra);	
	me->add("neili",-500);
	me->add("jingli",-500);
	msg = HIM "$N" HIM "连环三剑之后，一道剑气涌出，只奔$n而去。\n" NOR;
	message_vision(msg, me, target);
	if (random(ap) > dp/3)
	{
		damage = damage + random(damage);
		target->receive_damage("qi", damage,me); 
		target->receive_wound("qi", damage,me); 
		me->add("neili",-500);
		msg =HIR "$n" HIR "急忙后退，竟然躲避不及，被$N"
		      HIR "这一剑震得口吐鲜血，接连后退。\n" NOR;
		message_vision(msg, me, target);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage +"。\n" NOR);
	}		
	else
	{
		msg = CYN "$n" CYN "纵身从剑上越过。\n" NOR;
		message_vision(msg, me, target);
	}
	
	
if (me->query_skill("huashan-jianfa", 1)>2000 && me->query_skill("kuangfeng-jian", 1)>2000)	
{
	msg = HIM "\n$N运起紫霞神功，" HIM "手中" + weapon->name() + HIM "紫气剑芒暴涨三尺，剑芒所到之处，湮灭一切。\n" NOR;
	message_vision(msg, me, target);
	if (random(ap) > dp/3)
	{
		damage = me->query_skill("huashan-jianfa",1) + me->query_skill("kuangfeng-jian",1) + me->query_skill("zixia-shengong",1)+me->query_skill("sword",1) + me->query_skill("huashan-shenfa",1) + me->query_skill("force",1);
		damage = damage + random(damage);
		target->receive_damage("qi", damage,me); 
		target->receive_wound("qi", damage/2,me); 
		target->receive_damage("jing", damage,me); 
		target->receive_wound("jing", damage/2,me);
		me->add("neili",-1000);
		me->add("jingli",-1000);
		msg =HIB "此招来势当真快及，$n" HIR "哪里来得及闪"
		      "避招架？只见$N" HIR "剑光闪过，$n"
		      HIB "腰间霎时鲜血淋漓！\n" NOR;
		message_vision(msg, me, target);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"，精神的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);		
	extra = me->query_skill("huashan-jianfa",1)+me->query_skill("kuangfeng-jian",1)+me->query_skill("huashan-shenfa",1)+me->query_skill("zixia-shengong",1);	
	me->add_temp("apply/attack", extra);
	me->add_temp("apply/damage", extra);			
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	me->add_temp("apply/attack", -extra);
	me->add_temp("apply/damage", -extra);

	}
	else
	{
		msg = CYN "$n" CYN "身在空中，不及变招，只能挥出一招，正击中$N"
		       CYN "剑上，略一借力，飘然避去。\n" NOR;	
		message_vision(msg, me, target);
	}
}	

if (me->query_skill("huashan-jianfa", 1)>3000 && me->query_skill("kuangfeng-jian", 1)>3000)	
{	
	msg = HIC "\n$N战斗中融汇贯通华山派剑、气两宗的精髓。\n" NOR;
	msg += HIC "\n$N剑上紫芒闪烁，剑招使的精妙无比，使出了华山派真正的「" HIM "夺命连环三仙剑" HIW "」。\n" NOR;
	msg += HIC "\n这一招精妙无比，又凝聚华山险峻的气势，真正的是一往无前！！！。\n" NOR;
	message_vision(msg, me, target);
	if (me->query("jm/huashan")) damage = me->query_skill("huashan-jianfa",1)*me->query("dex",1)*15/10+me->query_skill("kuangfeng-jian",1)*me->query("dex",1)*15/10+me->query_skill("zixia-shengong",1)*me->query("con",1)*15/10+me->query_skill("sword",1)+me->query_skill("force",1)+me->query_skill("huashan-shenfa",1)*me->query("dex",1)*15/10;
	else damage = me->query_skill("huashan-jianfa",1)*me->query("dex",1)+me->query_skill("kuangfeng-jian",1)*me->query("dex",1)+me->query_skill("zixia-shengong",1)*me->query("con",1)+me->query_skill("sword",1)+me->query_skill("force",1)+me->query_skill("huashan-shenfa",1)*me->query("dex",1);
	damage = damage + random(damage);	
		me->add("neili",-3000);
		me->add("jingli",-2000);
	if (random(ap) > dp/3)
	{
		target->receive_damage("qi", damage,me); 
		target->receive_wound("qi", damage/2,me); 
		target->receive_damage("jing", damage,me); 
		target->receive_wound("jing", damage/2,me); 		
		msg =HIR "$n身在半空中" HIR "被这一剑的气势惊吓的，满脸绝望！这一剑"
		      HIR "从$n绝对想不到的位置，直刺而来。" HIR "$n惨叫一声，被这一剑钉在岩壁之上，鲜血狂流！\n" NOR;
		message_vision(msg, me, target);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"，精神的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	}
	else
	{
		target->receive_damage("qi", damage/3,me); 
		target->receive_wound("qi", damage/5,me); 		
		msg =CYN "$n" CYN "身在空中，急忙变招？但只见$N"
		      CYN "此剑掠过，$n" CYN "大声惨呼，鲜血四下飞溅！\n" NOR;	
		message_vision(msg, me, target);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage/3 +"，内伤为"+ damage/5 +"。\n" NOR);
	}

}	
	me->start_busy(1);	
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}