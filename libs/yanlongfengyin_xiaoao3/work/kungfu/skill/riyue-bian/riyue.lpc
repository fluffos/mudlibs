// riyue 日月鞭-日月
// campsun

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>
inherit F_SSERVER;
int perform(object me, object target)
{
	string msg,force_skill;
	int exert,flag,damage;
	int ap,dp,mapforce;
	object weapon;
	flag = 1;
	
	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("「日月轮转」只能在战斗中对对手使用。\n");
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "whip")
		return notify_fail("手中没有武器,如何使用「日月轮转」！\n");
	if( (int)me->query_skill("riyue-bian", 1) < 1000 )
		return notify_fail("你的日月鞭法不够娴熟，不会使用「日月轮转」。\n");
	if( (int)me->query_skill("nianhua-zhi", 1) < 1000 )
		return notify_fail("你的拈花指不够娴熟，不会使用「日月轮转」。\n");	
	if( (int)me->query_skill("fumo-jian", 1) < 1000 )
		return notify_fail("你的伏魔剑法不够娴熟，不会使用罗汉伏魔圈的「日月轮转」。\n");	
    if ((int)me->query_skill("hunyuan-yiqi",1) < 1000 && (int)me->query_skill("yijing-force",1) < 1000 && (int)me->query_skill("yijinjing",1) < 1000 && (int)me->query_skill("damo-force",1) < 1000)
		return notify_fail("你的佛门内功等级不够，不能使用「日月轮转」。\n");
  	if (me->query_skill_mapped("force") != "yijinjing" && me->query_skill_mapped("force") != "hunyuan-yiqi" && me->query_skill_mapped("force") != "yijing-force" && me->query_skill_mapped("force") != "damo-force") 
		return notify_fail("你未使用佛门内功, 不能使用这一绝技 !\n"); 
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
	if (me->query_skill_mapped("whip") != "riyue-bian")
		return notify_fail("你没正确激发该技能 。\n");
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");	
	if (!(int)me->query("breakup"))
        return notify_fail("你任督二脉未通,无法使用[" HIR "日月轮转" NOR "]\n"NOR); 
	if (target && !living(target))
		return notify_fail("对方都已经这样了，用不着这么费力吧？\n");
    if ( (int)me->query("max_neili") < 500000 )
        return notify_fail("你现在内力修为太弱，使不出「日月轮转」。\n"); 	
	if( (int)me->query("neili") < 10000 )
		return notify_fail("你现在内力太弱，不能使用「日月轮转」。\n");
    if ( (int)me->query("max_jingli") < 300000 )
        return notify_fail("你现在精力修为太弱，使不出「日月轮转」。\n"); 	
	if( (int)me->query("jingli") < 10000 )
		return notify_fail("你现在精力太弱，不能使用「日月轮转」。\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

	exert = (int)me->query_skill("riyue-bian", 1);
	force_skill=me->query_skill_mapped("force");
	mapforce = (int)me->query_skill(force_skill, 1);		
	if (me->query_skill_mapped("force") == "yijing-force" ) flag = 1;
	if (me->query_skill_mapped("force") == "hunyuan-yiqi" ) flag = 2;
	if (me->query_skill_mapped("force") == "damo-force" ) flag = 3;	
	if (me->query_skill_mapped("force") == "yijinjing" ) flag = 5;
	ap = me->query("xyzx_sys/level") + me->query_skill("riyue-bian", 1) +me->query_skill("nianhua-zhi", 1)+ me->query_skill("whip") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");	
	message_vision(HBWHT "$N贯通少林派武学，使出了少林派的绝学之精髓！\n" NOR, me, target);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 5, me);	//CD写法1	
	msg = HIR "$N口中高宣佛号，使出日月鞭中「日月」绝技，手中长索滚动飞舞，宛若灵蛇乱颤，自上而下劈向$n,\n" NOR;
	msg += HIR "接着$N手腕一抖，便如张牙舞爪的墨龙相似，急升而上，又往$n扑到。\n";
	message_vision(msg, me, target);

	me->add_temp("apply/attack", exert);
	me->add_temp("apply/damage", exert);
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));	
	me->add_temp("apply/attack", -exert);
	me->add_temp("apply/damage", -exert);
	
	if ((int)me->query_skill("riyue-bian", 1)>2000 && (int)me->query_skill("nianhua-zhi", 1)>2000 && (int)me->query_skill("fumo-jian", 1)>2000)
	{
		msg = HIY"紧跟着$N高宣“阿弥陀佛！”，使出「日」字诀，手中长索一扬，向$n的咽喉点去，索头未到，索上所挟"
		      +"劲风犹如红日当空，令对方一阵气窒，只听见「啪啪」几声巨响，索头昂起，便如一条假死的毒蛇忽地反"
		      +"噬挥动，带动无数风沙，呼啸而出。\n"NOR;
		message_vision(msg, me, target);
		damage = me->query_skill("riyue-bian", 1)*flag + me->query_skill("nianhua-zhi",1)*flag +me->query_skill("fumo-jian",1)*flag+ mapforce*flag+ me->query_skill("force",1) + me->query_skill("whip",1)+me->query_skill("sword",1);
		damage = damage + random(damage);
		if (random(ap)>dp/3)
		{
			me->add_temp("apply/attack", exert);
			me->add_temp("apply/damage", exert);
			COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
			COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
			me->add_temp("apply/attack", -exert);
			me->add_temp("apply/damage", -exert);

			target->receive_damage("qi", damage,me);
			target->receive_wound("qi", damage/2,me);
			me->add("neili",-1000);	
			me->add("jingli",-2000);	
			target->apply_condition("no_force", 10*flag);
			msg=HIR"结果$n一不小心，被鞭头击中谭中要穴，一时半会提不起内功。\n"NOR;
			message_vision(msg,me,target);
			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
		}
		else
		{
			me->receive_damage("qi", damage,target);
			me->receive_wound("qi", damage/2,target);
			target->add("neili",-1000);
			me->add("neili",-damage/10);
			msg=HIR"结果$n于混乱之中抓住了$N的鞭子，破除了这一招，导致$N后续招式无法施展，顺势一掌打的$N后退一步。\n"NOR;
			message_vision(msg,me,target);
			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对自己气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
		}

	}
		
	
	if ((int)me->query_skill("riyue-bian", 1)>3000 && (int)me->query_skill("nianhua-zhi", 1)>3000 && (int)me->query_skill("fumo-jian", 1)>3000)
	{
		msg = BCYN "紧跟着$N又宣“我佛慈悲！”，使出「月」字诀，内力返照空明，功力精纯，不露棱角，手中长索舞动时瞧不见半点影子无声无息，似缓实急，却又无半点风声，如鬼似魅，说不尽的诡异莫名。\n"NOR;
		message_vision(msg,me,target);
		if (me->query("jm/shaolin")) damage = me->query_skill("riyue-bian", 1)*me->query("int",1)*3/2 + me->query_skill("nianhua-zhi",1)*me->query("int",1)*3/2+me->query_skill("fumo-jian",1)*me->query("con",1)*3/2+mapforce*me->query("con",1)*3/2 + me->query_skill("force",1) + me->query_skill("whip",1) + me->query_skill("unarmed",1)+ me->query_skill("sword",1)+me->query_skill("riyue-bian", 1)*flag + me->query_skill("nianhua-zhi",1)*flag +me->query_skill("fumo-jian",1)*flag+mapforce*flag+target->query_dex()+me->query("qi")/150;
		else damage = me->query_skill("riyue-bian", 1)*me->query("int",1) + me->query_skill("nianhua-zhi",1)*me->query("int",1)+me->query_skill("fumo-jian",1)*me->query("con",1)+mapforce*me->query("con",1) + me->query_skill("force",1) + me->query_skill("whip",1) + me->query_skill("unarmed",1)+ me->query_skill("sword",1)+me->query_skill("riyue-bian", 1)*flag + me->query_skill("nianhua-zhi",1)*flag +me->query_skill("fumo-jian",1)*flag+mapforce*flag+target->query_dex()/2+me->query("qi")/200;
		damage = damage + random(damage);
		if (random(ap)>dp/3)
		{
			COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
			msg=HIR"结果$n一不小心，登时淹没在$N发出的漫天鞭影之中。\n"NOR;
			message_vision(msg,me,target);
			target->receive_damage("qi", damage,me);
			target->receive_wound("qi", damage/2,me);
			target->map_skill("dodge");
			target->apply_condition("no_enforce", 10*flag);
			me->add("neili",-3000);
			me->add("jingli",-3000);	
			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage +"。\n" NOR);
		}
		else
		{
			msg=HIR"可是$n眼眸横成一线，光芒一闪，双指出人意料的夹住了长鞭。$N的鞭子被夹住，难以动弹。\n"NOR;
			message_vision(msg,me,target);
			me->add("neili",-500);			
		}
	}
  me->start_busy(1);	
	return 1;

}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}