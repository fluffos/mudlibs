int valid_enable(string usage)
{
	return (usage == "sword") || (usage == "parry");
}
int valid_learn(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if ((int)me->query("max_neili") < 100000)
		return notify_fail("你的内力不够。\n");
	if ((int)me->query("str") < 30)
		return notify_fail("你的臂力不够。\n");	
	if ((int)me->query_skill("yunv-xinjing", 1) <300 && (int)me->query_skill("yunv-xinfa", 1) <300)
		return notify_fail("你的古墓内功火候太浅。\n");
	if (me->query("family/family_name")!="古墓派")
		return notify_fail("你不是古墓弟子，不能传授技能给你。\n");
	if ( me->query("gender") != "男性" )
       return notify_fail("玄铁剑法这种厚重的武功你一个女子怎么能使用？\n");
	if ((int)me->query_skill("xuantie-jianfa", 1) >350)
		return notify_fail("师傅只能教你到这，以后靠你自己勤加练习了。\n");
	if (me->query_skill("sword", 1) <=me->query_skill("xuantie-jianfa", 1))
		return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
	if ((int)me->query("score",1) < 5000)
		return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
	if (random(100)==1) me->add("score",-5);	
	return 1;
}
mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}
int practice_skill(object me)
{
	object weapon;
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if (!objectp(weapon = me->query_temp("weapon"))
	        || (string)weapon->query("skill_type") != "sword")
		if (!objectp(weapon = me->query_temp("secondary_weapon"))
		        || (string)weapon->query("skill_type") != "sword")
			return notify_fail("你使用的武器不对。\n");
    if (me->query("family/family_name")!="古墓派")
   return notify_fail("你看起来不像是古墓出来的人，练习不了玄铁剑法。\n");	
  if ( me->query("gender") != "男性" )
       return notify_fail("玄铁剑法这种厚重的武功你一个女子怎么能使用？\n");		
	if ((int)me->query("qi") < 50)
		return notify_fail("你的体力不够练玄铁剑法。\n");
	me->receive_damage("qi", 30);
	return 1;
}
	//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{
	string msg;
	int j,ap,dp,skill;
	ap = (int) me->query_skill("xuantie-jianfa",1);
	dp = (int) ob->query_skill("parry",1);
	skill = (int) me->query_skill("xuantie-jianfa",1);
	if (damage <10)  damage=10; 	
	if (random(6)==4 && random(ap)>dp/10 && me->query("neili") > 100 && (me->query_skill_mapped("force") == "yunv-xinjing" || me->query_skill_mapped("force") == "yunv-xinfa") )
	{
		msg = HIC"$N"+HIC+"满场游走，招断意连，绵绵不绝，一招未毕，二招至 !$n双眼一花不知所措！\n" +NOR;
		j = -damage+random(damage);  
		if (random(2)==0)
		{
			msg += HIY"$N"+HIY+"目光一闪，一把玉锋针扔出 !$n 一不当心，身上连中了几枚！\n" +NOR;
			ob->apply_condition("yf_poison",20);
			ob->receive_wound("qi",skill,me);
			ob->receive_damage("qi",skill,me);			
		}
		message_vision(msg, me, ob);
		if (!ob->is_busy()) ob->start_busy(3);
		me->add("neili", -100 );
		return j;
	}
	
}

string perform_action_file(string action)
{
	return __DIR__"xuantie-jianfa/" + action;
}


mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
	int level,damage2,ap,dp;
	level  = (int) me->query_skill("xuantie-jianfa",1);
	damage2 = (int)me->query_skill("xuantie-jianfa",1);	
	ap = me->query("xyzx_sys/level");
	dp = victim->query("xyzx_sys/level");
    if( damage_bonus < 100 ) return 0;
	if ( me->query_skill("yunv-xinfa",1) < 100 && me->query_skill("yunv-xinjing",1) < 100)	 return 0;
	if ( me->query("jiali") < 1 || me->query("neili") < 100 || (me->query_skill_mapped("force") != "yunv-xinfa" && me->query_skill_mapped("force") == "yunv-xinjing")) return 0;	
	if (damage2<10) damage2=10;	

	if( random(ap) > dp/10
	    && level > 200 
		&& me->query("jiali") > 0
	    && random(7)==0 )
	{
		if (victim->query("neili") > 500) victim->add("neili",-500);
			if (victim->query("qi") > level*2)
			{
				victim->receive_wound("qi", damage2+damage_bonus/2,me);
				victim->receive_damage("qi", damage2+damage_bonus/2,me);
				me->add("neili", -100);
			}
		return HIR"$N领悟举重若轻之意，玄铁重剑乎重乎轻，$n被内劲入侵，吐出一口鲜血！\n"NOR;
	}

	if(  random(ap) > dp/10
	        && level > 500
	        && random(7)==4
			&& me->query("jiali") > 100
			&& me->query("str") > 30 )
	{
		if (victim->query("neili") > 500) victim->add("neili",-500);
			if (victim->query("qi") > level*2)
			{
				victim->receive_wound("qi", damage2*3+damage_bonus,me);
				victim->receive_damage("qi", damage2*3+damage_bonus,me);
				me->add("neili", -100 );
			}
		return HIR"$N顿悟重剑无锋，大巧不工，这一剑随意使出，$n无法抵挡，剑气透体！\n"NOR;
	}
}