int valid_enable(string usage)
{
        return usage == "sword" || usage == "parry";
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}

int valid_learn(object me)
{
	return notify_fail("八部龙女剑只能通过解密五岳派来得到。\n");   

}
int practice_skill(object me)
{
    return notify_fail("八部龙女剑只能通过演练八部飞天来提高。\n");   
}

string perform_action_file(string action)
{
        return __DIR__"babulongnv-jian/" + action;
}
mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{    
	object weapon, weapon1;   
	int damage2,ap,dp;
  
    weapon = me->query_temp("weapon");
    weapon1= victim->query_temp("weapon");
	damage2 = (int)me->query_skill("babulongnv-jian",1);
	ap = me->query_skill("babulongnv-jian", 1);
	dp = victim->query_skill("dodge", 1);
	if ( damage_bonus < 100 ) return 0;
	if (damage2<10) damage2=10;	
    if ( me->query_skill("babulongnv-jian", 1) > 150 && me->query("jiali")>0
    && me->query("max_neili") > 1200 && me->query("neili") > 1000 && random(6) == 2
    && me->query_int(1) > 30
    && me->query_skill_mapped("sword") == "babulongnv-jian"
    && random(ap) > dp/10)
	{		
		if(weapon1 && me->query("str") > victim->query("str"))
		{           
			me->add("neili", -100 );
			victim->receive_damage("qi", 100+damage2+damage_bonus/2,me);
			victim->receive_wound("qi", 100+damage2+damage_bonus/2,me);

			message_vision(HIR"\n$n只觉得手中"+weapon1->name()+HIR"被八股不同的力道牵引环流，一个把持不定，脱手飞出！\n"NOR, victim);
			weapon1->unequip();
			weapon1->move(environment(victim));
			if (me->query_skill_mapped("force") != "zixia-shengong") victim->apply_condition("no_perform", 5);
			if (me->query_skill_mapped("force") != "hanbing-zhenqi") victim->apply_condition("cold_poison", victim->query_condition("cold_poison") + 5);			
        }
		else
		{
			me->add("neili", -100 );
			victim->receive_damage("qi", 100+damage2+damage_bonus/2,me);
			victim->receive_wound("qi", 100+damage2+damage_bonus/2,me);

			message_vision(HIY"$N眼见这八招似乎毫无章法，但不知$n是否有更厉害的后招，手中"+weapon->name()+HIY"连劈带刺，以进为退，破解了$n的绝杀！\n"NOR, victim);
		//	if (!victim->is_busy()) victim->start_busy(1);
			if (me->query_skill_mapped("force") != "zixia-shengong") victim->apply_condition("no_perform", 5);
			if (me->query_skill_mapped("force") != "hanbing-zhenqi") victim->apply_condition("cold_poison", victim->query_condition("cold_poison") + 5);			
        }
		return HIM"$N飞身跃起，"+weapon->name()+HIM"连出八式，招招刺向$n双臂，劲力传出，手上登时一沉！\n"NOR;
    }	
}
	//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡bug有关
int ob_hit(object ob, object me, int damage)
{
        object wp,wp1;     
        int j, neili, neili1,ap,dp;
        wp = me->query_temp("weapon");
        wp1 = ob->query_temp("weapon");
        neili = me->query("neili");
        neili1 = ob->query("neili");
		ap = me->query_skill("babulongnv-jian", 1);
		dp = ob->query_skill("parry", 1);
 	if (damage <10)  damage=10;  
		if(me->query("jiali")>0 && random(ap) > dp/10
        && me->query_skill_mapped("parry") == "babulongnv-jian"
        && me->query_skill("babulongnv-jian", 1) > 150
        && neili > 300 
        && objectp(wp) && wp->query("skill_type")== "sword"
        && random(5)==1)
        {        
			if(neili >= neili1)
			{
				message_vision(HIY"结果$n的力道被$N手中"+wp->name()+HIY"一挡一挑，卸在了一旁!\n"NOR,me,ob); 
				j = -(damage*3+random(damage*3));
				me->add("neili", -100 );
            }
           else if(neili < random(neili1)+damage && neili*2 > random(neili1)+damage)
			{
				message_vision(HIY"结果$n的力道被$N手中"+wp->name()+HIY"一圈，卸掉了一半!\n"NOR,me,ob); 
				j = -(damage*2+random(damage*2));
				me->add("neili", -100 );
            }
           else
			{
				message_vision(HIY"$N手中"+wp->name()+HIY"回挡，卸掉了$n一小半的力道!\n"NOR,me,ob); 
				j = -(damage+random(damage));
				me->add("neili", -100 );
            }           
        return j;
       }          
}
