// jifeng.c 疾风斩

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>
inherit F_SSERVER;

int perform(object me, object target) {
  string msg;
  object weapon, weapon2;
  int skill, ap, dp, damage;
  int i, attack_time;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("疾风斩只能对战斗中的对手使用。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "axe")
    return notify_fail("你使用的武器不对。\n");
  if (target && target->query_temp("apply/shade_vision"))
    return notify_fail("对方隐身了，你看不到" + target->query("name") + "。\n");
  if ((int)me->query_skill("wangran-xinfa", 1) < 300)
    return notify_fail("你的本门心法火候不够，无法使用。\n");
  if ((int)me->query("shen") < 0)
    return notify_fail("你的侠义正气太低了，无法集中心志！\n");
  if (me->query_skill_mapped("axe") != "wangxiang-fufa")
    return notify_fail("你没正确激发该技能 。\n");
  if (me->query_skill_mapped("force") != "wangran-xinfa")
    return notify_fail("你没激发该门派内功 。\n");
  if ((int)me->query_skill("shuiyue", 1) < 300)
    return notify_fail("你的本门轻功火候不够，无法使用。\n");
  if ((int)me->query_skill("wangxiang-fufa", 1) < 300)
    return notify_fail("你的妄想斧法等级不够, 不能使用疾风斩！\n");
  if ((int)me->query("jingli") < (int)me->query_skill("wangxiang-fufa", 1))
    return notify_fail("你的精力不够。\n");
  if ((int)me->query("neili") < (int)me->query_skill("wangxiang-fufa", 1) * 4)
    return notify_fail("你的内力不够，无法运用疾风斩！\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  msg = HIW "$N潜运妄想斧法之" HIG "疾风斩" HIW "手中痴心斧如幻影般连续奋力的向$n" HIW "攻去。\n" NOR;
  message_vision(msg, me, target);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1
  ap = me->query("xyzx_sys/level") + me->query_skill(
    "wangxiang-fufa",
    1
  ) + me->query_skill("axe") + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
  skill = (int)me->query_skill("wangxiang-fufa", 1);
  attack_time = (int)me->query_skill("wangxiang-fufa", 1) / 60;
  if (attack_time < 1) attack_time = 1;
  if (me->query("jm/chixin")) {
    if (attack_time > 100) attack_time = 100;
  } else {
    if (attack_time > 50) attack_time = 50;
  }

  if (random(ap) > dp / 4) {
    me->add_temp("lianzhao", attack_time);  //2016.6.1阿飞改，增加连招标记，用于削弱连招伤害
    for (i = 0; i < attack_time; i++) {
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    }
    me->add("neili", -100 * attack_time);
    me->add("jingli", -10 * attack_time);
    me->delete_temp("lianzhao");  //2016.6.1阿飞改，连招结束取消连招标记			

    if (objectp(weapon2 = target->query_temp("weapon"))) {
      weapon2->move(environment(me));
      msg += YEL "$n虎口一麻！手中兵刃不由自主的掉在了地上！\n" NOR;
      message_vision(msg, me, target);
      target->apply_condition("no_equip", 20);
      msg = HIY "结果一击命中, $n" HIY "顿时觉得身上一痛，" HIR "鲜血" NOR "" HIY "喷射而出。\n" NOR;
      message_vision(msg, me, target);
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
      damage = 300 + skill + random(skill);
      target->receive_damage("qi", damage, me);
      target->receive_wound("qi", damage, me);
      if (userp(me)) me->add("neili", -150);
      if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
        me,
        HIW "该绝招对敌人气血的外伤为" + damage + "，内伤为" + damage + "。\n" NOR
      );
    }
  } else {
    if (userp(me)) me->add("neili", -100);
    msg = RED "可是$n机警地闪开了$N的攻击。\n" NOR;
    message_vision(msg, me, target);
  }
  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
