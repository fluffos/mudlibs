int valid_learn(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if (me->query("family/family_name")!="明教")
   return notify_fail("这是波斯明教绝艺，非明教弟子不传。\n");	
        if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
                return notify_fail("练波斯怪招必须空手。\n");
	if ((int)me->query_skill("shenghuo-shengong", 1) < 100)
		return notify_fail("你的圣火神功火候不够，无法学波斯怪招。\n");
			if( (int)me->query("max_neili") < 10000 )
                return notify_fail("你的内力太弱，无法练波斯怪招。\n");
        return 1;
}

int valid_enable(string usage) 
 { return usage=="unarmed" || usage=="parry"; }

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}
int practice_skill(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
	if (me->query("family/family_name")!="明教")
   return notify_fail("你不是明教中人，偷练本门技能，我要告诉掌门去。\n");	
        if (me->query_skill("unarmed", 1) <=me->query_skill("bosi-guaizhao", 1))
        return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
        if( (int)me->query("qi") < 10 )
                return notify_fail("你的体力不够了，休息一下再练吧。\n");
        if( (int)me->query("neili") < 10 )
                return notify_fail("你的内力不够了，休息一下再练吧。\n");
        me->receive_damage("qi", 10);
        me->add("neili", -10);
        return 1;
}

int practice_level()
{   
        return 200;
} 


string perform_action_file(string action)
{
        return __DIR__"bosi-guaizhao/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{

		int ap,dp,level,damage2;
        level = (int) me->query_skill("bosi-guaizhao",1);  
		ap = (int) me->query("dex",1) * (int) me->query_skill("bosi-guaizhao",1);
		dp = (int) victim->query("str",1) * (int) me->query_skill("parry",1);
		damage2 = (int)me->query_skill("bosi-guaizhao",1);	
	
    if( damage_bonus < 100 ) return 0;
	if ( me->query_skill("shenghuo-shengong",1) < 100)	 return 0;
	if ( me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "shenghuo-shengong") return 0;	
	if (damage2<10) damage2=10;	
	
        if (random(5) == 0 && level > 100 && me->query("neili") > 500 && random(ap)>dp/10 && me->query("jiali")>0)
		{
           me->add("neili", -100 );
 //          if (!victim->is_busy()) victim->start_busy(random(3));
		   victim->receive_wound("qi", damage2+damage_bonus/2,me);
		   victim->receive_damage("qi", damage2+damage_bonus/2,me );
			return HIY"$N双脚交错，招式突然错乱起来！出手之处变得不可思议。\n"CYN"$n突然被$N变招打的不知所措，瞬间已是中了数掌！\n"NOR;
        }
}
