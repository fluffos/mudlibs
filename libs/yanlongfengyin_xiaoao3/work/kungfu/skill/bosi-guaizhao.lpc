			"dodge":	100,
			"damage":	100,
			"force":	100,
                "damage_type":  "瘀伤"
        ]),
        ([      "action": "$N身形转动，忽然双手击向$n的$l。",
			"attack":	100,
			"parry":	100,
			"dodge":	100,
			"damage":	100,
			"force":	100,
                "damage_type":  "瘀伤"
        ]),
        ([      "action": "$N左手招架，右手却突然从让人难料的角度向$n打去！",
			"attack":	200,
			"parry":	200,
			"dodge":	200,
			"damage":	200,
			"force":	200,
                "damage_type":  "瘀伤"
        ]),
