// lingxiao.c 天罡指穴法 「凌空指穴」

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;

int perform(object me, object target)
{
	string msg;
	int skill,ap,dp;
	
	if (!target ) target = offensive_target(me);
	if (!target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("你要对谁使用凌空指穴绝技。\n");
	if( objectp(me->query_temp("weapon")))
		return notify_fail("你先放下手中的武器再说吧？！\n");
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");
	if (target && target->is_busy()) 
		return notify_fail("对方现在已经处于忙乱中了！\n");
	if ( target && target->query_temp("busy_mianyi") )	//冲穴成功后免疫busy，2017.9.29阿飞添加
		return notify_fail(target->name() + "奇经八脉浑然一体，真气浩浩荡荡，点穴似乎没什么作用。\n");	
	if((int)me->query_skill("linji-zhuang",1) < 300)
		return notify_fail("你临济十二庄的功力不够不能使用凌空指穴!\n");
	if((int)me->query_skill("tiangang-zhi",1) < 300)
		return notify_fail("你的天罡指不够不能使用凌空指穴!\n");
	if( (int)me->query("jingli") < 1000 )
		return notify_fail("你的精力不够。\n");	
	if((int)me->query("neili") < 1000)
		return notify_fail("你内力现在不够, 不能使用凌空指穴! \n");
    if( me->query_skill_mapped("force") != "linji-zhuang" )
         return notify_fail("你所用的并非临济桩，使不出凌空点穴！\n");	
	if (me->query_skill_mapped("unarmed") != "tiangang-zhi")
		return notify_fail("你没正确激发该技能 。\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	skill = (int)me->query_skill("tiangang-zhi",1);
	ap = me->query("xyzx_sys/level") + me->query_skill("tiangang-zhi", 1) + me->query_skill("unarmed") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	msg = HIY "$N使出天罡指穴法绝技「凌空指穴」，回过身来，背后竟似生了眼睛一般，左手食中二指向$n接连戳去，"
	              "一连七指，全是对向$n的头脸与前胸重穴。$n不及攻敌，拼力躲避$N指力顿时动作大乱。\n"NOR;
	message_vision(msg, me, target);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1
	if( random(ap)>dp/3)
	{
		msg =  HIG "结果$p被$P指力点中几处穴道! \n" NOR;
		message_vision(msg, me, target);
		target->start_busy( (30*skill)/(skill+2000) + 5);
		tell_object(target, HIY"你陷入忙乱之中，一时无法动弹。\n"NOR);
		me->add("neili", -100);
	}
	else
	{
		msg = HIM "$p情急智生，狠力一跃，退出老远。\n" NOR;
		message_vision(msg, me, target);
	}
	me->fight_ob(target);
//	target->kill_ob(me);	//强制对方下kill不太合适吧
	target->hit_ob(me);	
	me->start_busy(1);
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}