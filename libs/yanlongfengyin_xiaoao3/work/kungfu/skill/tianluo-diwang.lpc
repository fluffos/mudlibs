int valid_enable(string usage) { return usage=="unarmed" || usage=="parry"; }

int valid_learn(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
        if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
                return notify_fail("空手方能练习天罗地网势。\n");
    if (me->query("family/family_name")!="古墓派")
   return notify_fail("你不是古墓中人，无法学习天罗地网。\n");	
		if ((int)me->query_skill("yunv-xinfa", 1) < 100 && (int)me->query_skill("yunv-xinjing", 1) < 100)
                return notify_fail("你的玉女心法领悟不够，无法修习天罗地网势。\n");
        if ((int)me->query_skill("unarmed", 1) < 200)
                return notify_fail("你的基本拳脚太差，无法研习天罗地网势。\n");
        return 1;
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
          if ((int)me->query("jing") < 40)
                return notify_fail("你的体力太低了。\n");
    if (me->query("family/family_name")!="古墓派")
   return notify_fail("你不是古墓中人，无法练习天罗地网。\n");				
          me->receive_damage("jing", 30);
        me->add("neili", -10);
        return 1;
}


mixed hit_ob(object me, object victim, int damage_bonus)
{
        string msg;
        int ap,dp,damage2;
		ap = (int) me->query_skill("tianluo-diwang",1);  
		damage2 = (int)me->query_skill("tianluo-diwang",1);	
		dp = victim->query_skill("dodge",1);
    if( damage_bonus < 100 ) return 0;
	if ( me->query_skill("yunv-xinfa",1) < 100 && me->query_skill("yunv-xinjing",1) < 100)	 return 0;
	if ( me->query("jiali") < 1 || me->query("neili") < 100 || (me->query_skill_mapped("force") != "yunv-xinfa" && me->query_skill_mapped("force") == "yunv-xinjing")) return 0;	
	if (damage2<10) damage2=10;	

    if (me->query("per",1) > 24 && random(10) > 7 && random(ap) > dp/10 )
	{
           msg= HIY"\n$N悄退数步，右手成掌，左手挥拳，掌风形成数个圆圈，将$n笼罩在内。\n"NOR;
        if (random(me->query("str",1)) > random(victim->query("str",1)) /3 * 2)
		{
           me->add("neili", -100 );
  //         if (!victim->is_busy()) victim->start_busy(random(10));
				victim->receive_wound("qi", damage2+damage_bonus/2,me );
				victim->receive_damage("qi", damage2+damage_bonus/2 ,me);		   
           msg +=CYN"\n$n被$N的掌法笼罩在内，左闪右躲也无法脱离$N的天罗地网，只好硬挨一掌！。\n\n"NOR;
        }
       else 
	   {
           me->add("neili", -100 );
 //          if (!me->is_busy()) me->start_busy(random(2));
           msg +=CYN"\n结果$n看清了$N的拳势，轻轻一跃就闪避开来。\n\n"NOR;
        }
         return msg;
    }
}
string perform_action_file(string action)	
{
return __DIR__"tianluo-diwang/" + action;	
}

