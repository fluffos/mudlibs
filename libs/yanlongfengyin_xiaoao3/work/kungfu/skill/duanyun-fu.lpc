int valid_enable(string usage) { return usage == "axe" || usage == "parry"; }

int valid_learn(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	

  if (me->query("family/family_name") != "铁掌帮")
    return notify_fail("你不是铁掌山弟子，无法领悟本门技能的精髓。\n");
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力太弱，无法练断云斧。\n");
  if ((int)me->query_skill("guiyuan-tunafa", 1) < 100)
    return notify_fail("你的归元吐呐法火候不够，无法学断云斧。\n");
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me) {
  object weapon;
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "axe")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("qi") < 50)
    return notify_fail("你的体力太低了。\n");
  if (me->query("family/family_name") != "铁掌帮")
    return notify_fail("你不是铁掌山弟子，无法领悟本门技能的精髓。\n");
  if ((int)me->query("neili") < 20)
    return notify_fail("你的内力不够练断云斧。\n");
  me->receive_damage("qi", 25);
  return 1;
}
string perform_action_file(string action) {
  return __DIR__ "duanyun-fu/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  int lev, ap, dp, damage2;
  object weap;
  ap = me->query_skill("duanyun-fu", 1);
  dp = victim->query_skill("parry", 1);
  weap = victim->query_temp("weapon");
  lev = me->query_skill("duanyun-fu", 1);

  damage2 = (int)me->query_skill("duanyun-fu", 1);

  if (damage_bonus < 100) return 0;
  if (me->query_skill("guiyuan-tunafa", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "guiyuan-tunafa") return 0;
  if (damage2 < 10) damage2 = 10;
  if (random(ap) > dp / 10 && me->query("jiali") > 0 && me->query_skill_mapped("force") == "guiyuan-tunafa") {
    if (random(lev) > 300 && random(7) == 3) {
      victim->receive_damage("qi", damage2 + damage_bonus / 2, me);
      victim->receive_wound("qi", damage2 + damage_bonus / 2, me);
      return HIW "只听 “刺啦” 的一声! $n以为被斧头劈成了两半！万幸，只是被削掉了一块肉！\n" NOR;
    }
    if (me->query("neili") > 1000
      && victim->query_temp("weapon")
      && random(lev) > 300
      && random(me->query_str(1)) > victim->query_str(1) / 2
      && random(3) == 0) {
      //     if (random((int)weap->query("rigidity"))<3 && random(5)==1)
      if (random(5) == 1) {
        message_vision(
          HIY "$N挥舞斧头，使出断云技巧，只听见「咔嚓」" NOR "地一声，$n手中的" + weap->name() + "被砍为两截！\n" NOR,
          me,
          victim
        );
        weap->move(environment(me));
        weap->set("name", "断掉的" + weap->query("name"));
        weap->set("value", 0);
        weap->set("weapon_prop", 0);
        me->add("neili", -100);
        me->kill_ob(victim);
        if (!victim->is_killing(me)) victim->kill_ob(me);
        message_vision(HIY "$N摧毁了$n的武器！$n非得跟你玩命不可！\n" + NOR, me, victim);
      } else {
        message_vision(
          HIW "$N挥舞斧头，使出断云技巧，只听见「当」" NOR "地一声，$n手中的" + weap->name() + "被劈落在地上！\n" NOR,
          me,
          victim
        );
        weap->move(environment(me));
        me->add("neili", -100);
      }
      victim->reset_action();
      return 1;
    }

  }


}
