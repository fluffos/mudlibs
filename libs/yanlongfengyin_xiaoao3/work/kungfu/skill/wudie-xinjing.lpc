// wudie-xinjing.c 舞蝶心经
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit FORCE;
int valid_enable(string usage) { return usage == "force"; }
int valid_learn(object me)
{
        int lvl = (int)me->query_skill("wangran-xinfa", 1);
        int t = 1, j;
        if (lvl<=100)
                for (j = 1; j < lvl / 10; j++)
                        t*=2;
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");						
		if ( me->query("gender") == "男性")
                return notify_fail("你又不是女人，难以领会高深的舞蝶心经。\n");
        
		if ( me->query("gender") == "无性" && lvl > 49)
                return notify_fail("你无根无性，阴阳不调，难以领会高深的舞蝶心经。\n");
    if (me->query("family/family_name")!="舞蝶仙")
   return notify_fail("你不是舞蝶仙传人，不能传授给你。\n");			 
		if ((int)me->query_skill("force", 1) < 100)
                return notify_fail("你的基本内功火候还不够。\n");
		
		if(lvl<=100)
        {
                if (lvl > 10 && (int)me->query("shen") < t * 100) 
                        return notify_fail("你的侠义正气太低了。\n");
        }
        else
        {
                if ((int)me->query("shen") < (51200 + (lvl - 100) * 1000)) 
                        return notify_fail("你的侠义正气太低了。\n");
        }
        return 1;
}
int practice_skill(object me)
{
        return notify_fail("舞蝶心经只能用学(learn)的来增加熟练度。\n");
}
string exert_function_file(string func)
{
        return __DIR__"wudie-xinjing/" + func;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
	int ap,dp,damage2;
	damage2 = (int)me->query_skill("wudie-xinjing",1);	
	ap = me->query_skill("wudie-xinjing",1);
	dp = victim->query_skill("force",1);
    if( damage_bonus < 100 ) return 0;
	if ( me->query_skill("wudie-xinjing",1) < 100)	 return 0;
	if ( me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "wudie-xinjing") return 0;	
	if (damage2<10) damage2=10;	
	if ( random(ap) > dp/20 && random(6)==0 && me->query("jiali") > 0) 
	{
		victim->receive_damage("qi", damage2+damage_bonus/2,me);
		victim->receive_wound("qi", damage2+damage_bonus/2,me);
		me->add("neili", -100 );
		return HIB "$N发挥出"+HIR+"舞蝶心经"NOR HIB"的真髓，蝴蝶翩翩摧毁了$n的真元！！！！\n" NOR;
	}
}
