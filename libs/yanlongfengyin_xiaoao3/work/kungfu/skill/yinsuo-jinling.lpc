int valid_enable(string usage)
{
	return (usage == "whip") || (usage == "parry");
}


int valid_learn(object me)
{
	object weapon;
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if (me->query("family/family_name")!="古墓派")
   return notify_fail("你不是古墓弟子，不能学习该技能。\n");	
	if( (int)me->query("max_neili") < 5000 )
		return notify_fail("你的内力不足，没有办法练银索金铃, 多练些内力再来吧。\n");
	if ((int)me->query_skill("yunv-xinjing", 1) < 100 && (int)me->query_skill("yunv-xinfa", 1) < 100)		
		return notify_fail("你的玉女心经内功火候太浅。\n");
	if ( !objectp(weapon = me->query_temp("weapon"))
	        || ( string)weapon->query("skill_type") != "whip" )
		return notify_fail("你使用的武器不对。\n");
	return 1;
}

int practice_skill(object me)
{
	object weapon;
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if (!objectp(weapon = me->query_temp("weapon"))
	        || (string)weapon->query("skill_type") != "whip")
		return notify_fail("你使用的武器不对。\n");
    if (me->query("family/family_name")!="古墓派")
   return notify_fail("你不是古墓弟子，不能练习该技能。\n");			
	if ((int)me->query_skill("yunv-xinjing", 1) < 100)
		return notify_fail("你的玉女心经内功火候太浅。\n");
	if ((int)me->query("jing") < 50)
		return notify_fail("你的体力不够练银索金铃。\n");
	if ((int)me->query("neili") < 30)
		return notify_fail("你的内力不够练银索金铃。\n");
	me->receive_damage("jing", 35);
	me->add("neili", -15);
	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
		if(level >= action[i]["lvl"])
			return action[i]["skill_name"];
}
mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}
string perform_action_file(string action)
{

	return __DIR__"yinsuo-jinling/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
	int damage2,ap,dp;
	object weap,weap1;
	weap = victim->query_temp("weapon");
	weap1 = me->query_temp("weapon");
	damage2 = (int)me->query_skill("yinsuo-jinling",1);	
	ap = me->query_str(1) + me->query_dex(1);
	dp = victim->query_str(1) + victim->query_dex(1);
    if( damage_bonus < 100 ) return 0;
	if ( me->query_skill("yunv-xinfa",1) < 100 && me->query_skill("yunv-xinjing",1) < 100)	 return 0;
	if ( me->query("jiali") < 1 || me->query("neili") < 100 || (me->query_skill_mapped("force") != "yunv-xinfa" && me->query_skill_mapped("force") == "yunv-xinjing")) return 0;	
	if (damage2<10) damage2=10;	
if (random(6)==2)
{
	if(victim->query_temp("weapon")) 
	{
		message_vision(HIW "只见$N挥舞" + weap1->name() + "，转出无数个大小圈子，以阴柔之劲缠向$n的" + weap->name() +"！\n" NOR, me, victim  );		
		if (random(ap) > dp/10)
		{
			message_vision(HIY "\n$N气运手臂用力一拽，" + weap->name()  + "却无法从"+weap1->name()+"的缠绕中脱开，情急之下只好放弃了手中的" + weap->name()  + "。\n" NOR, victim );
			weap->move(environment(me));
			victim->reset_action();
			victim->receive_damage("qi", damage2+damage_bonus/2,me );			
	//		if (!victim->is_busy()) victim->start_busy(2);
			me->add("neili", -100 );
			victim->add("neili", -(me->query("jiali") +100) );				
		}
		else
		{
			message_vision(HIY "\n$N暗运巧劲，" + weap->name()   + "顺着方向快速旋转数下，解开了"+weap1->name()+"的缠绕。\n" NOR, victim );
			victim->add("neili", -(me->query("jiali") +100) );
			me->add("neili", -100 );
		}		
	}
	else
	{
		message_vision(HIW "只见$N挥舞" + weap1->name() + "，转出无数个大小圈子，以阴柔之劲缠住了$n。。。\n" NOR, me, victim  );
		
		if (random(ap) > dp/10)
		{
			message_vision(HIY "\n$n一个不慎，被鞭子缠住了脖子，气息不畅，吐了一口鲜血。\n" NOR, victim );
			victim->receive_wound("qi", damage2+damage_bonus/2 ,me);
			victim->receive_damage("qi", damage2+damage_bonus/2 ,me);
	//		if (!victim->is_busy()) victim->start_busy(2);	
			me->add("neili", -100 );
			victim->add("neili", -(me->query("jiali") +100) );				
		}
		else
		{
			message_vision(HIY "\n$N暗运巧劲，左手连弹数下，荡开了"+weap1->name()+"的缠绕。\n" NOR, victim );
	//		if (!me->is_busy()) me->start_busy(2);	
			victim->add("neili", -(me->query("jiali") +100) );
			me->add("neili", -100 );
		}		
	}
}
	return 1;
}
	//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{
	string msg;
	int j,level,ap,dp;
	level = (int) me->query_skill("yinsuo-jinling",1);
	dp = (int) ob->query_skill("parry",1);
	ap = (int) me->query_skill("yinsuo-jinling",1);

	if (damage <10)  damage=10; 		
	if (random(6)==4 && random(ap)>dp/10 && me->query("neili") > 100 && (me->query_skill_mapped("force") == "yunv-xinjing" || me->query_skill_mapped("force") == "yunv-xinfa"))
	{
		msg = HIC"$N"+HIC+"满场游走，招断意连，绵绵不绝，一招未毕，二招至 !$n双眼一花不知所措！\n" +NOR;
		j = -(damage+random(damage));  
		if (random(2)==0)
		{
			msg += HIY"$N"+HIY+"目光一闪，一把玉锋针扔出 !$n 一不当心，身上连中了几枚！\n" +NOR;
			ob->apply_condition("yf_poison",20);
			ob->receive_wound("qi",level,me);
			ob->receive_damage("qi",level,me);
		}
		message_vision(msg, me, ob);
		if (!ob->is_busy()) ob->start_busy(3);
		me->add("neili", -100 );
		return j;
	}	
}
