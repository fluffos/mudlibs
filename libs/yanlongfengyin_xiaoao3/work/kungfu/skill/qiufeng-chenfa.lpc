int valid_enable(string usage) { return (usage == "whip") || (usage == "parry"); }
int practice_level() { return 120; }
int valid_learn(object me) {
  object weapon;
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("max_neili") < 1000)
    return notify_fail("你的内力不足，没有办法练秋风尘法, 多练些内力再来吧。\n");
  if ((int)me->query_skill("force", 1) < 200)
    return notify_fail("你的基本气功火候太浅。\n");
  if ((int)me->query_skill("yunv-xinfa", 1) < 100 && (int)me->query_skill("yunv-xinjing", 1) < 100)
    return notify_fail("你的玉女心法火候不够，无法学习本门技能。\n");
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "whip")
    if (!objectp(weapon = me->query_temp("secondary_weapon"))
      || (string)weapon->query("skill_type") != "whip")
      return notify_fail("你必须先找一条拂尘才能练尘法。\n");
  if (me->query("family/family_name") != "古墓派")
    return notify_fail("你未加入古墓派，不能学习本门高深功夫。\n");
  if (me->query_skill("whip", 1) <= me->query_skill("qiufeng-chenfa", 1))
    return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
  return 1;
}
string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}
mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me) {
  object weapon;
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "whip")
    if (!objectp(weapon = me->query_temp("secondary_weapon"))
      || (string)weapon->query("skill_type") != "whip")
      return notify_fail("你使用的武器不对。\n");
  if (me->query("family/family_name") != "古墓派")
    return notify_fail("你未加入古墓派，不能练习本门高深功夫。\n");
  if ((int)me->query("qi") < 50)
    return notify_fail("你的体力不够练秋风尘法。\n");
  me->receive_damage("qi", 35);
  return 1;
}
string perform_action_file(string action) {
  return __DIR__ "qiufeng-chenfa/" + action;
}


mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  int damage2, ap, dp;
  object weap, weap1;
  weap = victim->query_temp("weapon");
  weap1 = me->query_temp("weapon");
  damage2 = (int)me->query_skill("qiufeng-chenfa", 1);
  ap = me->query_str(1) + me->query_dex(1);
  dp = victim->query_str(1) + victim->query_dex(1);
  if (damage_bonus < 100) return 0;
  if (me->query_skill("yunv-xinfa", 1) < 100 && me->query_skill("yunv-xinjing", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || (me->query_skill_mapped("force") != "yunv-xinfa" && me->query_skill_mapped("force") == "yunv-xinjing")) return 0;
  if (damage2 < 10) damage2 = 10;
  if (random(6) == 1) {
    if (victim->query_temp("weapon")) {
      message_vision(
        HIW "只见$N挥舞" + weap1->name() + "，如天女散花漫天飞舞，以阴柔之劲缠住了$n的" + weap->name() + "！\n" NOR,
        me,
        victim
      );
      if (random(ap) > dp / 10) {
        weap->move(environment(me));
        victim->reset_action();
        victim->receive_damage("qi", damage2 / 2 + damage_bonus / 3, me);
        //			if (!victim->is_busy()) victim->start_busy(2);
        me->add("neili", -100);
        return HIY "\n$N气运手臂用力一拽，" + weap->name() + "却无法从" + weap1->name() + "的缠绕中脱开，手上被割裂了一道口子，情急之下只好放弃了手中的" + weap->name() + "。\n" NOR;
      } else {
        //			if (!victim->is_busy()) victim->start_busy(3);
        me->add("neili", -100);
        victim->add("neili", -(me->query("jiali") + 100));
        return HIY "\n$N暗运巧劲，" + weap->name() + "顺着方向快速旋转数下，解开了" + weap1->name() + "的缠绕。\n" NOR;
      }
    } else {
      message_vision(HIW "只见$N挥舞" + weap1->name() + "，如天女散花漫天飞舞，以阴柔之劲缠住了$n。。。\n" NOR, me, victim);
      if (random(ap) > dp / 10) {
        victim->receive_wound("qi", damage2 + damage_bonus / 2, me);
        victim->receive_damage("qi", damage2 + damage_bonus / 2, me);
        //		if (!victim->is_busy()) victim->start_busy(2);	
        me->add("neili", -100);
        victim->add("neili", -(me->query("jiali") + 100));
        return HIY "\n$n一个不慎，被鞭子缠住了脖子，气息不畅，吐了一口鲜血。\n" NOR;
      } else {
        //		if (!me->is_busy()) me->start_busy(2);	
        victim->add("neili", -(me->query("jiali") + 100));
        me->add("neili", -100);
        return HIY "\n$n集中精力，一指点中了$N的手腕，破开了" + weap1->name() + "的缠绕。\n" NOR;
      }
    }
  }

}
