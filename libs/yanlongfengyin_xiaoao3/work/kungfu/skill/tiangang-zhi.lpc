int valid_enable(string usage) { return usage=="unarmed" || usage=="finger" || usage=="parry"; }
int valid_combine(string combo) { return combo=="jinding-zhang"; }

int valid_learn(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
            return notify_fail("学习「天罡指穴法」必须空手。\n");
        if ((int)me->query_skill("linji-zhuang", 1) < 200)
            return notify_fail("你的「临济十二庄」火候不够，无法学习「天罡指穴法」。\n");
    if (me->query("family/family_name")!="峨嵋派")
   return notify_fail("你不是峨嵋弟子，无法学习。\n");		
	if ((int)me->query("max_neili") < 10000)
            return notify_fail("你的内力太弱，无法学习「天罡指穴法」。\n");
	return 1;
}

string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
    if (me->query("family/family_name")!="峨嵋派")
   return notify_fail("你不是峨嵋弟子，偷练技能小心啊。\n");	
	if ((int)me->query("qi") < 30)
           return notify_fail("你的体力不够，休息一下再练吧。\n");

	if ((int)me->query("neili") < 20)
           return notify_fail("你的内力不够练「天罡指」。\n");

        me->receive_damage("qi", 30);
	me->add("neili", -10);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"tiangang-zhi/" + action;
}
mixed hit_ob(object me, object victim, int damage_bonus)
{	
	int ap,dp,damage2;
	ap =  me->query_skill("tiangang-zhi",1)*me->query("dex",1);
	dp = victim->query_skill("parry",1)*me->query("con",1);
	damage2 = (int)me->query_skill("tiangang-zhi",1);
    if( damage_bonus < 100 ) return 0;
	if ( me->query_skill("linji-zhuang",1) < 100)	 return 0;
	if ( me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "linji-zhuang") return 0;	
	if (damage2<10) damage2=10;	
	if( random(5)==0 && random(ap) > dp/10 && me->query("jiali")>0)
	{
		me->add("neili", -100);		
		victim->receive_damage("qi", damage2+damage_bonus/2,me);
//		if (!victim->is_busy()) victim->start_busy(2);
		return HIR "$n听到“噗嗤”一声！被一道指风击中，穴道似乎淤塞了。\n";
	}
}