// tiyunzong.c 梯云纵
// written by Xiang
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SKILL;
string *dodge_msg = ({
    "只见$n一招「"+WHT+"白鹤冲天"+NOR+"」，身体向上笔直地纵起丈余，躲过了$N这一招。\n",
    "$n一个「"+RED+"鹞子翻身"+NOR+"」，向后纵出数丈之远，避开了$N的凌厉攻势。\n",
    "$n使出「"+MAG+"大鹏展翅"+NOR+"」，向一旁飘然纵出，轻轻着地。\n"
});
int valid_enable(string usage) { return (usage == "dodge"); }
int practice_level(){   return 60;  }
int valid_learn(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
    if (me->query_skill("dodge", 1) <=me->query_skill("tiyunzong", 1))
        return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
	    if (me->query("family/family_name")!="武当派")
   return notify_fail("你未加入武当派，没法学习。\n");	
    if ((int)me->query_skill("taiji-shengong", 1) < 100)
    return notify_fail("你的太极神功不足，学不了武当技能。\n");
    return 1;
}
string query_dodge_msg(object me,string limb)
{
        if (me) me->set_temp("fight/dodge",random(2*me->query_skill("tiyunzong",1)));
        return dodge_msg[random(sizeof(dodge_msg))];
}
int practice_skill(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
        if( (int)me->query("qi") < 40 )
                return notify_fail("你的体力太差了，不能练梯云纵。\n");
	    if (me->query("family/family_name")!="武当派")
   return notify_fail("你未加入武当派，练习不了。\n");				
        me->receive_damage("qi", 30);
        return 1;
}

string perform_action_file(string action)
{
        return __DIR__"tiyunzong/" + action;
}

	//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{

        int j,ap,dp;
		ap = me->query_skill("tiyunzong", 1) * me->query("dex",1);
		dp = ob->query_skill("dodge", 1) * ob->query("int",1);

	if (damage <10)  damage=10;   	
      if( me->query_skill("tiyunzong", 1) > 300
		&& (me->query_skill_mapped("force") == "taiji-shengong" ||  me->query_skill_mapped("force") == "yinyun-ziqi")
        && me->query("neili") > 100
		&& random(5)==0	
		&& random(ap) > dp/10)
        { 	
        message_vision(HIB"$N腾空拔地而起，虚空中连踏三步，$n一个招式落空，顿时真气迟滞。\n"NOR, me,ob); 
		if (!ob->is_busy()) ob->start_busy(1);		
		me->add("neili", -100 );
        message_vision( HIC"$N脚底阴阳图浮现，足不沾地，浑厚真元化作阴阳二气，荡漾周身，万法不沾身！\n"NOR, me,ob);
        j = -(damage+random(damage));  
        return j;
        }          
}