int valid_learn(object me)
{
    object ob;
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if( (int)me->query("max_neili") < 5000 )
        return notify_fail("你的内力不够，没有办法练华山剑法。\n");
    if( (int)me->query("con",1) < 25 )
        return notify_fail("气宗剑法讲究以气御剑，以你这根骨恐怕不行。\n");	
 if ((int)me->query_skill("zixia-shengong", 1) < 100)		
        return notify_fail("你的紫霞神功火候不够，无法学习本门身法。\n");
    if (me->query("family/family_name")!="华山派")
   return notify_fail("你未加入华山派，学不了本派技能。\n");		
    if( !objectp(ob = me->query_temp("weapon")) || (string)ob->query("skill_type") != "sword" )
        return notify_fail("你必须先找一把剑才能练剑法。\n");

    return 1;
}

int valid_enable(string usage)
{
    return usage=="sword" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
    return action[random(sizeof(action))];
}


mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb)
{
	int ap,dp, skill,damage2;
	object weapon;
	weapon = me->query_temp("weapon");
    ap = me->query_skill("huashan-jianfa",1);
	dp = victim->query_skill("parry",1);
    skill= (int) me->query_skill("zixia-shengong",1);
	damage2 = (int)me->query_skill("huashan-jianfa",1);	
	
    if( damage_bonus < 100 ) return 0;
	if ( me->query_skill("zixia-shengong",1) < 100)	 return 0;
	if ( me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "zixia-shengong") return 0;	
	if (damage2<10) damage2=10;	
		
	if (random(8)==2 
	&& random(ap) > dp/10
	&& random(skill)>500
	&& me->query_skill_mapped("force") == "zixia-shengong" 
	&& me->query("jiali") > 0)
	{
//		if (!victim->is_busy()) victim->start_busy(2);
		victim->receive_wound("qi", damage2*2+200+damage_bonus*2,me);
		me->add("neili", -100);
        return random(2) ? HIR "$N" HIR "运起紫霞神功，一剑攻出，剑气横飞，,$n双眼一花,不知如何是好!\n" NOR:
                           HIR "$N" HIR "剑随意走,手中" + weapon->name() + HIR "犹如生了眼睛一般，随意挥出几剑,$n双眼一花,不知如何是好!\n"NOR;
	}
            
	if (random(8)==1 
	&& random(ap) > dp/10
	&& me->query("jiali") > 0
	&& me->query_skill_mapped("force") == "zixia-sengong" )
	{
		victim->receive_wound("qi", damage2+damage_bonus/2,me);
		me->add("neili", -100 );
		return HIM"$N剑气纵横! 一道剑气划过了$n的$l。结果鲜血狂奔!\n"NOR;        
	}
}

int practice_skill(object me)
{
    object weapon;
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    if (!objectp(weapon = me->query_temp("secondary_weapon"))
    || (string)weapon->query("skill_type") != "sword")
        return notify_fail("你使用的武器不对。\n");
    if (me->query("family/family_name")!="华山派")
   return notify_fail("你未加入华山派，练不了本派技能。\n");		
    if ((int)me->query("qi") < 50)
        return notify_fail("你的体力不够练华山剑法。\n");
    me->receive_damage("qi", 30);
    return 1;
}

string perform_action_file(string action)
{
        return __DIR__"huashan-jianfa/" + action;
}

