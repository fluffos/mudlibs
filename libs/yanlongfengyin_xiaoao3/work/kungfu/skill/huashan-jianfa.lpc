	//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{
	
        string msg;
        int ap,dp,j;
        
        ap = me->query_skill("huashan-jianfa", 1);
		dp = ob->query_skill("literate",1) + ob->query_skill("art",1) + ob->query_skill("count",1);
        if( damage < 10 ) damage=10;
       
    if ( random(6) == 3 && random(ap) > dp/10 && me->query_skill_mapped("force")=="zixia-shengong" && me->query("neili") > 200)
	{
        msg = YEL"$N机缘巧合，获得华山思过崖石洞中的失传已久的剑招，剑走偏锋，一招击中$n的破绽。\n"NOR;
        msg += YEL"$n真气运行淤塞，出手顿时一滞，力道减轻了不少!!。\n"NOR;
		if (!ob->is_busy()) ob->start_busy(3);
		me->add("neili", -100 );
		j = -(damage+random(damage));  
		message_vision(msg, me, ob);
		return j;
	}
           
}