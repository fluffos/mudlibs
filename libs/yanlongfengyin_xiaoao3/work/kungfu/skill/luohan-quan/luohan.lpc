// jinshe-jianfa perform
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;

int perform(object me, object target)
{
	string msg;
	int i, skill, max;
	object weapon;

	if ( !target ) target = offensive_target(me);
	if ( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("「十八罗汉」只能在战斗中使用。\n");
	if (objectp(weapon=me->query_temp("weapon")))
		return notify_fail("你必须空手才能使用罗汉拳的「十八罗汉」。\n");
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	
    if (me->query_skill("luohan-quan", 1) < 300 )
        return notify_fail("你的罗汉拳还不够娴熟，使不出「十八罗汉」。\n");
    if((int)me->query_skill("hunyuan-yiqi",1) < 300 && (int)me->query_skill("yijing-force",1) < 300 && (int)me->query_skill("yijinjing",1) < 300 && (int)me->query_skill("damo-force",1) < 300)	 
        return notify_fail("你的佛门内功的修为不够, 不能使用这一绝技 !\n");
	if (me->query_skill_mapped("force") != "yijinjing" && me->query_skill_mapped("force") != "hunyuan-yiqi" && me->query_skill_mapped("force") != "yijing-force" && me->query_skill_mapped("force") != "damo-force") 
		return notify_fail("你未使用佛门内功, 不能使用这一绝技 !\n");  
    if ( (int)me->query("max_neili") < 20000 )
        return notify_fail("你现在内力太弱，使不出「十八罗汉」。\n");  
	if( (int)me->query("max_jingli") < 100000 )
		return notify_fail("你的精力修为还不够高。\n");
	if( (int)me->query("jingli") < 1000 )
		return notify_fail("你的精力不够了。\n");	    
    if ( (int)me->query("neili") < me->query_skill("luohan-quan", 1)*4 )
        return notify_fail("你现在真气太弱，使不出「十八罗汉」。\n"); 
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");		
	if (me->query_skill_mapped("unarmed") != "luohan-quan")
		return notify_fail("你没正确激发该技能 。\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		

        skill = me->query_skill("luohan-quan", 1);
		max = me->query_skill("luohan-quan", 1)/60; 
        msg = BLU"\n$N大喝一声：十八罗汉归位！组罗汉大阵降魔！。\n"NOR;
        message_vision(msg, me, target);
        me->add_temp("apply/damage", -skill);
        me->add_temp("apply/attack", -skill);
 		me->add_temp("apply/strength", -skill);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1
	if (max < 1) max = 1;
	if (me->query("jm/shaolin")) 
	{
		if (max > 150) max = 150;
	} else 
	{
		if (max > 50) max = 50;
	}		

		me->add_temp("lianzhao", max);	 //2016.6.1阿飞改，增加连招标记，用于削弱连招伤害	
		for ( i=0; i<max; i++ )
		{
		switch ( random(18) )
		{
			case 0: msg = RED"降龙罗汉！\n" NOR;
					break;
			case 1: msg = GRN"坐鹿罗汉！\n" NOR;
					break;
			case 2: msg = YEL"举钵罗汉！\n" NOR;
					break;
			case 3: msg = BLU"过江罗汉！\n" NOR;
					break;
			case 4: msg = MAG"伏虎罗汉！\n" NOR;
					break;
			case 5: msg = CYN"静坐罗汉！\n" NOR;
					break;
			case 6: msg = WHT"长眉罗汉！\n" NOR;
					break;
			case 7: msg = HIR"布袋罗汉！\n" NOR;
					break;
			case 8: msg = HIG"看门罗汉！\n" NOR;
					break;
			case 9: msg = HIY"探手罗汉！\n" NOR;
					break;
			case 10: msg = HIB"沉思罗汉！\n" NOR;
					break;
			case 11: msg = HIM"骑象罗汉！\n" NOR;
					break;	
			case 12: msg = HIC"欢喜罗汉！\n" NOR;
					break;
			case 13: msg = HIW"笑狮罗汉！\n" NOR;
					break;
			case 14: msg = HIC"开心罗汉！\n" NOR;
					break;
			case 15: msg = HIG"托塔罗汉！\n" NOR;
					break;		
			case 16: msg = HIY"芭蕉罗汉！\n" NOR;
					break;
			case 17: msg = BLU"挖耳罗汉！\n" NOR;
					break;				
		}
		message_vision(msg, me,target);
	        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
		}
		me->add("neili",-max*150);  
        me->add_temp("apply/damage", skill);
        me->add_temp("apply/attack", skill);
		me->add_temp("apply/strength", skill);
		me->delete_temp("lianzhao");  //2016.6.1阿飞改，连招结束取消连招标记		
        me->start_busy(1);
      //  if (!target->is_busy()) target->start_busy(random(3));
        return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}