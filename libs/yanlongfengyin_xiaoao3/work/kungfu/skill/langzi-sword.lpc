//langzi-sword.c 	浪子三招	下乘武学100~300
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SKILL;
mapping *action = ({
  ([ "action": "$N将手中$w握紧，暴喝一声，不顾$n的凌厉攻击，刺向$n的头顶",
    "attack": 100,
    "parry": 100,
    "dodge": 100,
    "damage": 100,
    "force": 100,
    "lvl": 0,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N手中$w一抖将$n的攻势化去，紧跟着反身一剑刺向$n",
    "attack": 200,
    "parry": 200,
    "dodge": 200,
    "damage": 200,
    "force": 200,
    "lvl": 200,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$n使出最后杀着，怎知$N也使出了最后绝技手中$w向$n对刺过去",
    "attack": 300,
    "parry": 300,
    "dodge": 300,
    "damage": 300,
    "force": 300,
    "lvl": 500,
    "damage_type": "刺伤",
  ]),
});
int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }
int practice_level() { return 200; }
int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query_skill("fanyun-force", 1) < 300 && (int)me->query_skill("damo-force", 1) < 300)
    return notify_fail("你的本门内功火候不够，无法浪子三招。\n");
  if (me->query("family/family_name") != "通吃帮")
    return notify_fail("你不是通吃帮弟子，无法学习本门技能。\n");
  if (me->query_skill("sword", 1) <= me->query_skill("langzi-sword", 1))
    return notify_fail("你的基础不够，无法领会更高深的技巧！\n");
  return 1;
}
string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}
mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me) {
  object ob;

  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
  if ((int)me->query("qi") < 50
    || (int)me->query("neili") < 35)
    return notify_fail("你的内力或气不够，没有办法练习浪子三招。\n");
  if (me->query("family/family_name") != "通吃帮")
    return notify_fail("你不是通吃帮弟子，无法练习本门技能。\n");
  if (!objectp(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword")
    if (!objectp(ob = me->query_temp("secondary_weapon"))
      || (string)ob->query("skill_type") != "sword")
      return notify_fail("你装备的武器不对。\n");
  me->receive_damage("qi", 30);
  me->add("neili", -20);
  me->add_temp("pratice_sword", 1);
  if (me->query_temp("pratice_sword") > me->query_skill("langzi-sword", 1) / 20) {
    if ((int)ob->query_amount() == 1) {
      ob->unequip();
      tell_object(me, BOLD "\n你的" + ob->query("name") + "用完了！\n\n" + NOR);
    }
    ob->add_amount(-1);
    me->delete_temp("pratice_sword");
  }
  write("你按著所学练了一遍浪子三招。\n");
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "langzi-sword/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  int flag, damage2, ap, dp;
  flag = 1;
  damage2 = (int)me->query_skill("langzi-sword", 1);
  ap = me->query_skill("langzi-sword", 1);
  dp = victim->query_skill("parry", 1);
  if (damage_bonus < 100) return 0;
  if (me->query_skill("fanyun-force", 1) < 100 && me->query_skill("damo-force", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || (me->query_skill_mapped("force") != "fanyun-force" && me->query_skill_mapped("force") != "damo-force")) return 0;
  if (damage2 < 10) damage2 = 10;
  if (me->query_skill_mapped("force") == "damo-force") flag = 2;
  if (me->query("jiali") > 0
    && random(ap) > dp / 10
    && random(7) == 3) {
    victim->receive_wound("qi", damage2 * flag + damage_bonus / 2, me);
    victim->receive_wound("jing", damage2 * flag + damage_bonus / 2, me);
    //		if (!victim->is_busy()) victim->start_busy(2);
    me->add("neili", -100);
    return HIW "$N形骸浪荡，出手放荡不羁，霸气侧漏！$n被$N的霸气伤的体无完肤！\n" NOR;
  }
}



