// 舞蝶步
// wudie-bu
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SKILL;


string *dodge_msg = ({
  "但是$n一招·" HIR "近寒" HIW "食雨" HIB "草萋萋" NOR "·轻松躲过。\n",
  "突然$n如" WHT "" BLINK "蝴蝶" NOR "飞舞，一招·" HIY "著麦" HIG "苗风" HIM "柳映堤" NOR "·闪开了$N的攻击。\n",
  "只见到$n身形一变，使出·" HIY "等是" CYN "有家" HIR "归未得" NOR "·向后轻飘飘的跳开。\n",
  "却见$n毫不慌张的使出·" HIM "杜鹃" YEL "休向" HIW "耳边啼" NOR "·左右闪躲，避开了攻击！\n" });

int valid_enable(string usage) { return (usage == "dodge"); }

int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
  if (me->query("family/family_name") != "舞蝶仙")
    return notify_fail("你不是舞蝶仙传人，不能传授给你。\n");
  if ((int)me->query("per", 1) < 25)
    return notify_fail("舞蝶步如同蝴蝶翩翩起舞，以你的身姿恐怕只是毛毛虫吧。\n");
  if ((int)me->query_skill("wudie-xinjing", 1) < 100)
    return notify_fail("你的舞蝶心经火候不够，无法学习舞蝶步。\n");

  return 1;
}

string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me) {
  //	if (!wizardp(me))
  //	return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
  if ((int)me->query("qi") < 45)
    return notify_fail("你的体力太差了，不能练舞蝶步。\n");
  if (me->query("family/family_name") != "舞蝶仙")
    return notify_fail("你不是舞蝶仙传人，练习不了舞蝶步。\n");
  me->receive_damage("qi", 35);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "wudie-bu/" + action;
}
//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage) {

  int j, ap, dp;
  ap = me->query_skill("wudie-bu", 1) * me->query("dex", 1);
  dp = ob->query_skill("dodge", 1) * ob->query("str", 1);

  if (damage < 10) damage = 10;
  if (random(ap) > dp / 10
    && me->query_skill("wudie-bu", 1) > 300
    && me->query_skill_mapped("force") == "wudie-xinjing"
    && me->query("neili") > 1000
    && random(5) == 0) {
    message_vision(HIG "$N战斗中穿花弄蝶，伴随蝴蝶翩翩起舞，$n被舞姿迷住，一时放弃了攻击。\n" NOR, me, ob);
    j = -(damage + random(damage));
    me->add("neili", -100);
    return j;
  }

}
