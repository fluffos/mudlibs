int valid_enable(string usage)
{
	return usage=="strike" || usage=="parry" ||usage=="unarmed" ;
}

int valid_learn(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练绝情掌必须空手。\n");
	if ((int)me->query_skill("mingyu-shengong", 1) < 100)
		return notify_fail("你的冥雨神功火候不够，无法学绝情掌。\n");
    if (me->query("family/family_name")!="移花宫")
   return notify_fail("你不是移花宫弟子，不能学习本门技能。\n");		
	if ((int)me->query("max_neili") < 10000)
		return notify_fail("你的内力太弱，无法练绝情掌。\n");
	if ((int)me->query("score",1) < 5000)
		return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
	if (random(100)==1) me->add("score",-5);
	return 1;
}

string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me)
{
//		if (!wizardp(me))
	//	return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if ((int)me->query("qi") < 30)
		return notify_fail("你的体力太低了。\n");
	if ((int)me->query("neili") < 40)
		return notify_fail("你的内力不够练绝情掌。\n");
    if (me->query("family/family_name")!="移花宫")
   return notify_fail("偷练本门技能，两位宫主追究起来你承担不起。\n");		
	me->receive_damage("qi", 30);
	me->add("neili", -10);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"jueqing-zhang/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{

	int ap,dp,damage2;
	damage2 = (int)me->query_skill("jueqing-zhang",1);	
	ap = me->query_skill("jueqing-zhang",1);
	dp = victim->query_skill("parry",1);
    if( damage_bonus < 100 ) return 0;
	if ( me->query_skill("mingyu-shengong",1) < 100)	 return 0;
	if ( me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "mingyu-shengong") return 0;	
	if (damage2<10) damage2=10;	
	if(me->query("jiali") > 0
	    && me->query_skill_mapped("force") == "mingyu-shengong"
	    && random(ap) > dp/10
		&& random(6)==0 )
	{
		victim->receive_wound("qi", damage2+damage_bonus/2,me);
		me->add("neili", -100 );
//		if (!victim->is_busy()) victim->start_busy(1);		
		return HIR "$N冷若冰霜，面无表情，使出「绝情绝命」的精义！$n被掌力打了个透心凉！\n" NOR;
	}
}