// qingfu-shenfa.c 青蝠身法
// pal 1997.05.26
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SKILL;
string *dodge_msg = ({
    "只见$n一招「"+RED+"福满乾坤"+NOR+"」，身形陡然纵起，躲过了$N这一招。\n",
    "$n一式「"+YEL+"五蝠献寿"+NOR+"」，身形晃动，向一旁飘出，避开了$N这一招。。\n"
    "$n使出「"+BLU+"洞天福地"+NOR+"」，一个空心筋斗向后翻出，避开了$N的凌厉攻势。\n",
    "$n一招「"+HIW+"云龙百蝠"+NOR+"」，身随意转，$N只觉眼前一花，$n已绕至$N的身后。\n",
});
int practice_level(){   return 60;  }
int valid_enable(string usage)
{
    return usage == "dodge";
}
int valid_learn(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if (me->query("family/family_name")!="明教")
   return notify_fail("这是韦蝠王的独门轻功，不加入明教恐怕不能传授。\n");	
    if ((int)me->query_skill("shenghuo-shengong", 1) < 200)
    return notify_fail("你的圣火神功不够，学不了本教技能。\n");	
    if (me->query_skill("dodge", 1) <=me->query_skill("qingfu-shenfa", 1))
        return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
    return 1;
}
string query_dodge_msg(string limb)
{
        return dodge_msg[random(sizeof(dodge_msg))];
}
int practice_skill(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
        if( (int)me->query("qi") < 40 )
                return notify_fail("你的体力太差了，不能练青蝠身法。\n");
    if (me->query("family/family_name")!="明教")
   return notify_fail("这是韦蝠王的独门轻功，不加入明教你也敢自练！。\n");				
        me->receive_damage("qi", 30);
        return 1;
}

string perform_action_file(string action)
{
        return __DIR__"qingfu-shenfa/" + action;
}
	//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{

        int j,ap,dp;
		ap = me->query_skill("qingfu-shenfa", 1) * me->query("con",1);
		dp = ob->query_skill("dodge", 1) * ob->query("str",1);

	if (damage <10)  damage=10;      	
      if( me->query_skill("shenghuo-shengong",1) > 100
		&& me->query_skill("qingfu-shenfa", 1) > 200
		&& me->query_skill_mapped("force") == "shenghuo-shengong"
        && me->query("neili") > 1000
		&& random(5)==0	)
        { 	
        message_vision(HIB"$N展开披风，迎风一展，化身青翼蝙蝠，双翅展开遮云闭月，$n身形缓慢了不少。\n"NOR, me, ob); 		
		if (!ob->is_busy()) ob->start_busy(1);
		me->add("neili", -100 );
		if(random(ap) > dp/10)
		   {
              message_vision( HIC"$N突然一口咬在$n的脖子上，$n吓了一跳，只好放弃了这次出手！\n"NOR, me, ob);
              j = -(damage*2+random(damage*2));
//			  ob->receive_wound("qi",1000 + me->query("jiali"),me);
            }else
			{
				j = -(damage+random(damage));
				message_vision( HIC"$N突然一口咬在$n的脖子上，$n反手一掌，然而掌力减轻了不少！\n"NOR, me, ob);
			}
           return j;
        }          
}
