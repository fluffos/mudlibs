int valid_enable(string usage)
{
	return usage=="unarmed" || usage=="parry"|| usage=="hand";
}

int valid_combine(string combo)
{
	return combo=="liuyang-zhang";
}
int practice_level()
{
	return 100;
}

int valid_learn(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练天山折梅手必须空手。\n");
	    if (me->query("family/family_name")!="逍遥派" && me->query("family/family_name")!="灵鹫宫")			
   return notify_fail("你不是逍遥传人或灵鹫宫弟子，无法学习折梅手。\n");
    if ((int)me->query("int", 1) < 25)
		return notify_fail("以你的悟性恐怕难以领悟折梅手。\n");	
	if ((int)me->query("max_neili") < 10000)
		return notify_fail("你的内力太弱，无法练天山折梅手。\n");
    if ((int)me->query_skill("beiming-shengong", 1) < 300 && (int)me->query_skill("bahuang-gong", 1) < 300 && (int)me->query_skill("xiaowuxiang", 1)< 300)
    return notify_fail("你的逍遥门内功火候不够，无法学习折梅手。\n");	
	if (me->query_skill("unarmed", 1) <=me->query_skill("zhemei-shou", 1) )
		return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
	if ((int)me->query("score",1) < 5000)
		return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
	if (random(100)==1) me->add("score",-5);	
	return 1;
}

int practice_skill(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练天山折梅手必须空手。\n");
	if (me->query("family/family_name")!="逍遥派" && me->query("family/family_name")!="灵鹫宫")				
   return notify_fail("你不是逍遥传人或灵鹫宫弟子，无法练习折梅手。\n");
	if ((int)me->query("qi") < 30)
		return notify_fail("你的体力太低了。\n");
	if ((int)me->query("neili") < 20)
		return notify_fail("你的内力不够练天山折梅手。\n");
	me->receive_damage("qi", 25);
	me->add("neili", -10);
	return 1;
}

mapping query_action(object me, object weapon)
{
	int level = (int) me->query_skill("zhemei-shou",1);

	if ( random(level) > 300 && random(20) ==1 && me->query("jiali")>100 )
	{

			return ([
            "action": HIC"$N右手一弯，掌上凝聚阴柔之力，无声无息劈向$n的「至阳穴」，跟着左拳猛击而出，击向$n胸口的「膻中穴」"NOR,
            "damage_type": "内伤",
		"attack":	500,
		"parry":	500,
		"dodge":	500,
		"damage":	500,
		"force":	500,
			        ]);
	}
	if ( random(level) > 300 && random(20) ==2 && me->query("jiali")>100 )
	{
			return ([
            "action": HIG"$N左手袍袖一拂，激出一股内劲，袖力中夹着掌力，一前一后击向$n"NOR,
            "damage_type": "内伤",
		"attack":	500,
		"parry":	500,
		"dodge":	500,
		"damage":	500,
		"force":	500,
			        ]);
	}
	if ( random(level) > 300 && random(20) ==3 && me->query("jiali")>100 )
	{
			return ([
            "action": HIB"$N手腕转了个小圈，既快且准，三只手指搭上$n手腕，大拇指和小指跟着便即收拢，扣住$n脉门，$n顿时动弹不得"NOR,
            "damage_type": "瘀伤",
		"attack":	500,
		"parry":	500,
		"dodge":	500,
		"damage":	500,
		"force":	500,
			        ]);
	}
	if ( random(level) > 300 && random(20) ==4 && me->query("jiali")>100 )
		{
			return ([
            "action": HIW"$N双手连抓，使出「天山折梅手」的高深武功，抓中带扣，扣中夹掌，连攻$n的命门大穴"NOR,
            "damage_type": "瘀伤",
		"attack":	500,
		"parry":	500,
		"dodge":	500,
		"damage":	500,
		"force":	500,	
			        ]);


		}
	if ( random(level) > 300 && random(20) ==5 && me->query("jiali")>100 && me->query_temp("powerup"))
	{
		return
		    ([
         "action": HIR"这时$N内力生发，将「逍遥」二字发挥得淋漓尽致，姿势优雅美观，潇洒如意\n"
		         "然而逍遥派武学的诸般狠辣招数自然而然的也使了出来，所使招数渐趋阴险刻毒\n"
		         "$N招招凶险，皆攻向$n要害，直欲致$n死得惨酷无比"NOR,
         "damage_type": "瘀伤",
		"attack":	600,
		"parry":	600,
		"dodge":	600,
		"damage":	600,
		"force":	600,	
		     ]);

	}
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}

string perform_action_file(string action)
{
	return __DIR__"zhemei-shou/" + action;
}
mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
	int lvl,damage2,ap,dp,maxnei;
	maxnei = (int)me->query("max_neili");
	damage2 = (int)me->query_skill("zhemei-shou",1);	
	ap = me->query_skill("zhemei-shou",1);
	dp = victim->query_skill("parry",1);
	lvl = me->query("jiali") + me->query_skill("beiming-shengong", 1) + me->query_skill("bahuang-gong", 1) + me->query_skill("xiaowuxiang", 1);
	if (me->query("jm/xiaoyao")) maxnei = (int)me->query("max_neili")*2;
    if( damage_bonus < 100 ) return 0;
	if ( me->query_skill("beiming-shengong",1) < 100 && me->query_skill("bahuang-gong",1) < 100 && me->query_skill("xiaowuxiang",1) < 100) return 0;
	if ( me->query("jiali") < 1 || me->query("neili") < 100 ) return 0;	
	if (me->query_skill_mapped("force") != "beiming-shengong" && me->query_skill_mapped("force") != "bahuang-gong" && me->query_skill_mapped("force") != "xiaowuxiang") return 0;
	if (damage2<10) damage2=10;	

	if (random(6)==0 && random(ap) > dp/10 && me->query_skill_mapped("force") == "bahuang-gong")
	{		
		victim->receive_damage("qi", damage2+damage_bonus/2,me);
		victim->receive_wound("qi", damage2 +damage_bonus/2,me);
		victim->apply_condition("ss_poison", 10 + victim->query_condition("ss_poison"));		
		me->add("neili", -100 );		
		return HIR "$n" HIR "的一只手臂，被$N用力弯折！疼痛难忍！我靠，居然还夹杂着生死符！\n" NOR;
	}
	if (random(6)==1 && random(ap) > dp/10 && me->query_skill_mapped("force") == "beiming-shengong")
	{
		me->add("neili", -100 );
		if (victim->query("neili") > lvl) victim->add("neili",-lvl);
		victim->receive_damage("qi", damage2+damage_bonus/2,me);
		victim->receive_wound("qi", damage2+damage_bonus/2,me);
		if (me->query("neili") < maxnei) me->add("neili",lvl);
		return HIC "$n" HIC "的一只手臂，被$N用力弯折！全身功力如流水般源源不绝地流入$N的身体！\n" NOR;
	}
	if (random(6)==1 && random(ap) > dp/10 && me->query_skill_mapped("force") == "xiaowuxiang")
	{
		me->add("neili", -100 );
		victim->receive_damage("qi", damage2+damage_bonus/2,me);
		victim->receive_wound("qi", damage2+damage_bonus/2,me);
		return HIC "$n" HIC "的一只手臂，被$N用力弯折！无形无相，无我无他！\n" NOR;
	}	
}

	//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{
	string msg;
	int level,level2,damage2,ap,dp,j,maxnei;
	level = (int) me->query_skill("bahuang-gong",1);
	level2 = (int) me->query_skill("beiming-shengong",1);
	damage2 = me->query_skill("bahuang-gong",1) + me->query_skill("beiming-shengong",1);
	ap = me->query_skill("zhemei-shou", 1);
	dp = me->query_skill("unarmed", 1);
	if (damage <10)  damage=10; 
	if (me->query("jm/xiaoyao")) maxnei = (int)me->query("max_neili")*2;
	if (random(7)==5 && random(ap)>dp/10 && (me->query_skill_mapped("force") == "bahuang-gong" || me->query_skill_mapped("force") == "beiming-shengong" || me->query_skill_mapped("force") == "xiaowuxiang"))
	{
		msg = HIC"$N手掌微微弯曲，从意向不到的位置，击中$n的手腕，$n攻击的力道似乎减轻不少。\n"NOR;
		j = -(damage+random(damage));
		me->add("neili", -100);			
		if (me->query_skill_mapped("force") == "beiming-shengong")
		{
			if (ob->query("neili") > damage2) ob->add("neili",-damage2);
			if (me->query("neili") < maxnei) me->add("neili",damage2);
			msg += HIR"$N突然发招,$n全身内力如流水般源源不绝地流入$N的身体\n"NOR;			
		}
		if (me->query_skill_mapped("force") == "bahuang-gong")
		{
			if (!ob->is_busy())	ob->start_busy(2);
			ob->receive_damage("qi", 100+damage2,me);			
			msg += HIB"$N不由自主的唱道：八荒六合，唯我独尊，天山童姥，容颜不老！\n"NOR;
		}
		if (me->query_skill_mapped("force") == "xiaowuxiang")
		{
			if (!ob->is_busy())	ob->start_busy(2);
			ob->receive_damage("jing", 100+damage2,me);
			msg += HIB"$N哈哈一笑道：小而无形，无形无迹，无相无我！\n"NOR;
		}
		message_vision(msg, me, ob);
		return j;
	}
}