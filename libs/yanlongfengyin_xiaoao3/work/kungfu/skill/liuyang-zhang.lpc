int valid_enable(string usage)
{
	return usage=="unarmed" || usage=="parry";
}
int practice_level()
{
	return 120;
}
int valid_combine(string combo)
{
	return combo=="zhemei-shou";
}
int valid_learn(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练天山六阳掌必须空手。\n");
    if (me->query("family/family_name")!="灵鹫宫" && me->query("family/family_name")!="逍遥派")
		return notify_fail("你不是出身逍遥门，无法学习逍遥绝学。\n");	
    if ((int)me->query_skill("bahuang-gong", 1) < 300 && (int)me->query_skill("beiming-shengong", 1) && (int)me->query_skill("xiaowuxiang", 1)< 300)	
        return notify_fail("你的逍遥门内功火候不够，无法学六阳掌。\n");
	if ((int)me->query("con",1) < 25)
		return notify_fail("六阳掌化水为冰，以冰聚符，以你的体质恐怕不行。\n");		
	if ((int)me->query("max_neili") < 10000)
		return notify_fail("你的内力太弱，无法练六阳掌。\n");
	if (me->query_skill("unarmed", 1) <=me->query_skill("liuyang-zhang", 1))
		return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
	if ((int)me->query("score",1) < 10000)
		return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
	if (random(10)==1) me->add("score",-10);	
	return 1;
}

int practice_skill(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练天山六阳掌必须空手。\n");
    if (me->query("family/family_name")!="灵鹫宫" && me->query("family/family_name")!="逍遥派")
   return notify_fail("你不是出身逍遥门，无法练习逍遥绝学。\n");	
	if ((int)me->query("qi") < 30)
		return notify_fail("你的体力太低了。\n");
	if ((int)me->query("neili") < 20)
		return notify_fail("你的内力不够练天山六阳掌。\n");
	me->receive_damage("qi", 25);
	me->add("neili", -10);
	return 1;
}
mapping query_action(object me, object weapon)
{
	int level;
	string  msg;
	
	level = (int)me->query_skill("liuyang-zhang", 1);
		if( random(level) > 300 && random(20)>15 && me->query("jiali") > 100 && me->query_temp("powerup"))
		{
			switch( random(3) )
			{
			case 1:
				msg = HIW"不料$N左掌一带，掌力绕过$N的身子，直拍向$p$l"NOR;
				break;
			case 2:
				msg = WHT"谁知$N一掌未竭第二掌又至，连催两重劲，掌力便如长蛇之游，奇诡不可设想"NOR;
				break;
			default:
				msg = WHT"突然间$N掌力破空，拍向$n，劲风扑面，锋利如刀，转而斜砍$p$l"NOR;
				break;
			}

			return ([
            "action": msg,
			"attack":	1000,
			"parry":	1000,
			"dodge":	1000,
			"damage":	1000,
			"force":	1000,
			"skill_name" : "白虹掌力",
            "damage_type":"内伤",
//            "post_action": (: baihong :)
			        ]);
		}
	
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
	
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
	int ap, dp,flvl,damage2,maxnei;
	object weapon;
	weapon = me->query_temp("weapon");
	ap = (int) me->query_skill("beiming-shengong",1) + (int) me->query_skill("bahuang-gong",1);
	dp = (int) victim->query_skill("force",1);
	flvl = me->query("jiali") + me->query_skill("bahuang-gong", 1) + me->query_skill("beiming-shengong", 1) + me->query_skill("xiaowuxiang", 1);
	damage2 = (int)me->query_skill("liuyang-zhang",1);	
	maxnei = me->query("max_neili");
    if( damage_bonus < 100 ) return 0;
	if ( me->query_skill("bahuang-gong",1) < 100 && me->query_skill("beiming-shengong",1) < 100 && me->query_skill("xiaowuxiang",1) < 100)	 return 0;
	if ( me->query("jiali") < 1 || me->query("neili") < 100 ) return 0;	
	if (me->query_skill_mapped("force") != "beiming-shengong" && me->query_skill_mapped("force") != "bahuang-gong" && me->query_skill_mapped("force") != "xiaowuxiang") return 0;
	if (damage2<10) damage2=10;	
	if (me->query("jm/xiaoyao")) maxnei = (int)me->query("max_neili")*2;

	if (random(6)==1 && me->query_skill_mapped("force") == "bahuang-gong" && random(ap)>dp/10)
	{
			me->add("neili", -100 );
			victim->receive_damage("qi", 100+damage2+damage_bonus/2,me);
			victim->receive_wound("qi", 100+damage2+damage_bonus/2,me);
			victim->apply_condition("ss_poison", 10 + victim->query_condition("ss_poison"));	
		return HIW "$N使出白虹掌力打断了$n几根骨头，$n身上中了几道生死符!!\n" NOR;
	}
	
	if (random(6)==2 && me->query_skill_mapped("force") == "beiming-shengong" && random(ap)>dp/10)
	{
		me->add("neili", -100 );
		victim->receive_damage("qi", 100+damage2+damage_bonus/2,me);
		victim->receive_wound("qi", 100+damage2+damage_bonus/2,me);
		if (victim->query("neili") > flvl) victim->add("neili",-flvl);
		if (me->query("neili") < maxnei) me->add("neili",flvl);
		return HIW"$N使出逍遥掌劲震伤了$n的经脉,$n全身真元如流水般源源不绝地流入$N的身体!\n"NOR;
	}
	if (random(6)==3 && me->query_skill_mapped("force") == "xiaowuxiang" && random(ap) > dp/10)
	{
		me->add("neili", -100 );
		victim->receive_damage("qi", damage2+damage_bonus/2,me);
		victim->receive_wound("qi", damage2+damage_bonus/2,me);
		return HIC "$N低唱一声：无形无相，无我无他！$n只觉得一股内力似乎要将自己化为无形。\n" NOR;
	}	
}

	//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{
	string msg;
	int j,ap,dp,damage2,maxnei;
	ap = (int) me->query_skill("liuyang-zhang",1);
	dp = (int) ob->query_skill("unarmed",1);

	damage2 = (int) ob->query("neili",1)/10;
	maxnei = (int)me->query("max_neili");
	if (damage2 > 50000 ) damage2 =50000;
	if (damage2 < 0 ) damage2 =0;
	if (damage <10)  damage=10; 
	if (me->query("jm/xiaoyao")) maxnei = (int)me->query("max_neili")*2;
	if (random(7)==4 && random(ap)>dp/10 && (me->query_skill_mapped("force") == "bahuang-gong" || me->query_skill_mapped("force") == "beiming-shengong" || me->query_skill_mapped("force") == "xiaowuxiang"))
	{
		msg = HIR"$N突然掌心光芒闪耀，$n只觉眼前出现六个太阳，招式转向落在空处。\n"NOR;
		j = -(damage+random(damage));		
		me->add("neili", -100);			
		if (me->query_skill_mapped("force") == "beiming-shengong")
		{
			ob->add("neili",-damage2);
			if (me->query("neili") < maxnei) me->add("neili",damage2);
			msg += HIR"$N突然发招,$n全身内力如流水般源源不绝地流入$N的身体\n"NOR;
		}
		if (me->query_skill_mapped("force") == "bahuang-gong")
		{
			if (!ob->is_busy())	ob->start_busy(1);
			ob->receive_damage("qi", 100+damage2,me);	
			msg += HIB"$n不由自主的唱道：八荒六合，唯我独尊，天山童姥，容颜不老！\n"NOR;
		}	
		if (me->query_skill_mapped("force") == "xiaowuxiang")
		{
			if (!ob->is_busy())	ob->start_busy(2);
			ob->receive_damage("jing", 100+damage2,me);
			msg += HIB"$N哈哈一笑道：小而无形，无形无迹，无相无我！\n"NOR;
		}		
		message_vision(msg, me, ob);
		return j;
	}

}

string perform_action_file(string action)
{
	return __DIR__"liuyang-zhang/" + action;
}

