
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit FORCE;

int valid_enable(string usage) { return usage=="force"; }

int valid_force(string force) { return 1; }

int query_neili_improve(object me)
{
    int lvl;

    lvl = (int)me->query_skill("lengyue-shengong", 1);
    return lvl * lvl * 15 * 15 / 100 / 200;
}

int valid_learn(object me)
{
    mapping skl;
    string *sname;
    int i ;

		
//			if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if ( me->query("gender") == "无性" && (int)me->query_skill("zixia-shengong", 1) > 49)
        return notify_fail("你无根无性，阴阳不调，难以领会高深的冷月神功。\n");
    if ((int)me->query_skill("force", 1) < 100)
        return notify_fail("你的基本内功火候还不够，还不能学习冷月神功。\n");
	if (me->query("family/family_name")!="胡苗世家" )
		return notify_fail("你不是关外胡家或中原苗家弟子，没法传授给你。\n");

    if (me->query_skill("force",1)<=(int)me->query_skill("zixia-shengong", 1))
        return notify_fail("你的基本内功基础不够，再学下去会走火入魔的。\n");
    skl = me->query_skills();
    sname  = keys(skl);
    for (i=0;i<sizeof(skl);i++){
        if (sname[i]=="yijing-force") continue;
		if (sname[i]=="xixing-dafa") continue;
        if (sname[i]=="lengyue-shengong") continue;			
            if( SKILL_D(sname[i])->valid_enable("force") )
        return notify_fail("你不先散了别派内功，怎能学冷月神功？！\n");
    }
    return 1;
}

int practice_skill(object me)
{
    return notify_fail("冷月神功只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func)
{
    return __DIR__"lengyue-shengong/" + func;
}


mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
	int ap,dp,damage2;
	damage2 = (int)me->query_skill("lengyue-shengong",1);	
	ap = me->query_skill("lengyue-shengong",1);
	dp  = victim->query_skill("force",1);
    if( damage_bonus < 100 ) return 0;
	if ( me->query_skill("lengyue-shengong",1) < 100)	 return 0;
	if ( me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "lengyue-shengong") return 0;	
	if (damage2<10) damage2=10;	
	
    if ( damage_bonus < 100 ) return 0;
	if ( random(ap) > dp/20 && random(6)==0 && me->query("jiali") > 0) 
	{
		victim->receive_wound("qi", damage2+100+damage_bonus/2,me);
		me->add("neili", -100);
		return HIB "$N发挥出"+HIR+"冷月神功"NOR HIB"的精髓，摧毁了$n的真元！！！！\n" NOR;
	}
}

