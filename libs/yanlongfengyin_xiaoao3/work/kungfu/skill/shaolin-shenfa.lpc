// shaolin-shenfa.c 少林身法
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SKILL;
string *dodge_msg = ({
"$n一式「"+HIG+"一苇渡江"+NOR+"」，前后脚脚尖脚跟相靠，身体如行云流水般滑出丈余。\n",
"$n一式「"+WHT+"雨燕掠波"+NOR+"」，双臂前伸，全身贴地平飞，顿时闪过了$N的凌厉攻势。\n",
"$n一式「"+CYN+"移步换形"+NOR+"」，足不动，手不抬，一转眼间便绕到了$N的身后。\n",
"$n一式「"+MAG+"分身化影"+NOR+"」，一转身间，四面八方飘动着无数个$n的身影，令$N手无足措。\n",
"$n一式「"+HIY+"孤骛落日"+NOR+"」，全身笔直，拔地而起，在半空中一转，已落到几丈远的地方。\n",
"$n一式「"+BLU+"鸿雁双飞"+NOR+"」，两臂鹏举如翼，在剌剌风声中，从$N头顶横跃而过。\n",
"$n一式「"+RED+"苍龙出水"+NOR+"」，双脚点地，全身化为一道白影，急速绕着$N打了几转。\n",
"$n一式「"+HIR+"稚凤归巢"+NOR+"」，身体如陀螺般急转，气流形成一个个漩涡，令$N陷身其间，动弹不得。\n",
});
int practice_level(){   return 60;  }
int valid_enable(string usage)
{
    return usage == "dodge";
}
int valid_learn(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if (me->query_skill("dodge", 1) <=me->query_skill("shaolin-shenfa", 1))
        return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
    if (me->query("family/family_name")!="少林派")
   return notify_fail("你不是佛门中人，无法学习少林绝技。\n");	
    if ((int)me->query_skill("hunyuan-yiqi", 1) < 100 && (int)me->query_skill("yijing-force", 1) < 100 && (int)me->query_skill("yijinjing", 1) < 100 && (int)me->query_skill("damo-force", 1) < 100)
    return notify_fail("你的少林气功火候不够，无法学习少林武技。\n");	
    return 1;
}
string query_dodge_msg(object me,string limb)
{
        me->set_temp("fight/dodge",me->query_skill("shaolin-shenfa",1));
        return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if( (int)me->query("qi") < 40 )
        return notify_fail("你的体力太差了，不能练少林身法。\n");
    if (me->query("family/family_name")!="少林派")
   return notify_fail("你不是佛门中人，偷练少林绝技会走火入魔。\n");		
    me->receive_damage("qi", 30);
    return 1;
}

string perform_action_file(string action)
{
    return __DIR__"shaolin-shenfa/" + action;
}
	//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{

        int j,ap,dp;
		ap = me->query_skill("shaolin-shenfa", 1);
		dp = ob->query_skill("dodge", 1);

	if (damage <10)  damage=10;      	
      if(random(ap) > dp/10
		&& me->query_skill("shaolin-shenfa", 1) > 300
		&& (me->query_skill_mapped("force") == "yijing-force" || me->query_skill_mapped("force") == "damo-force" || me->query_skill_mapped("force") == "hunyuan-yiqi" || me->query_skill_mapped("force") == "yijinjing")
        && me->query("neili") > 1000
		&& random(5)==0	)
        { 	
        message_vision(HIG"少林强则国强，少林富则国富，少林自由则国自由。我为少林，则我自由！\n"NOR, me, ob); 		
            j = -(damage+random(damage)); 
			me->add("neili", -100 );
			return j;        
        }  
		
}
