// hubo.c
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit ITEM;
//inherit SKILL;
void create() { seteuid(getuid()); }
void init()
{
    add_action("do_hubo","hubo");
}
string type() { return "knowledge"; }
int valid_learn(object me) 
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
        if(((string)me->query("gender") == "男性" && (int)me->query("int",1) >= 15 ) || ((string)me->query("gender") == "女性" && (int)me->query("int",1) <= 25 ))
           return  notify_fail("你的天性不适合学习双手互博之术!\n" ) ;
    return 1;
}
void do_hubo ( string arg )
{
    write( "你全身放松，坐下来开始运功疗伤。\n" );
    return ;
}
