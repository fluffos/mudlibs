// ban.c 「般若波罗蜜」
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;
int perform(object me, object target)
{
    int damage,damage1;
    string msg;
    if( !target ) target = offensive_target(me);
    if( !target || !target->is_character() || !me->is_fighting(target) )
        return notify_fail("「般若波罗蜜」只能对战斗中的对手使用。\n");
    if( objectp(me->query_temp("weapon")) )
        return notify_fail("你必须空手才能使用「般若波罗蜜」！\n");   
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	
    if((int)me->query_skill("hunyuan-yiqi",1) < 300 && (int)me->query_skill("yijing-force",1) < 300 && (int)me->query_skill("yijinjing",1) < 300 && (int)me->query_skill("damo-force",1) < 300)		 
        return notify_fail("你的佛门内功的修为不够, 不能使用这一绝技 !\n");
	if (me->query_skill_mapped("force") != "yijinjing" && me->query_skill_mapped("force") != "hunyuan-yiqi" && me->query_skill_mapped("force") != "yijing-force" && me->query_skill_mapped("force") != "damo-force") 
		return notify_fail("你未使用佛门内功, 不能使用这一绝技 !\n");        
    if( (int)me->query_skill("banruo-zhang", 1) < 500 )
        return notify_fail("你的般若掌不够娴熟，不会使用「般若波罗蜜」。\n");  
	if ( me->query_skill_mapped("unarmed") != "banruo-zhang")
		return notify_fail(HIC"你未激发般若掌!\n"NOR);	
    if( (int)me->query("neili") < 1000 )
        return notify_fail("你现在内力太弱，不能使用「般若波罗蜜」。\n");
	if( (int)me->query("jingli") < 1000 )
		return notify_fail("你的精力不够。\n");	
    if( (int)me->query("max_neili") < 100000 )
        return notify_fail("你现在内力修为太差，不能使用「般若波罗蜜」。\n");
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");    
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n");     
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
    msg = CYN "$N默运神功，使出般若掌最朴实无华的一招「般若波罗蜜」，迫使$n与你比拼内力。\n"NOR;
    message_vision(msg, me, target);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1	
	
    me->add("neili", -100);	
    if ( me->query("max_neili") > target->query("max_neili") )
    {
 
     //   if (!target->is_busy()) target->start_busy(3);        
        damage1 = (me->query("max_neili") - target->query("max_neili"))/500;
		damage = damage1+random(damage1)+100;       
        target->receive_damage("qi", damage,me);
        target->receive_wound("qi", damage/2,me);      
		msg = RED"结果$n被$N以内力一震，胸口有如受到一记重锤，连退了五六步！\n"NOR;
		message_vision(msg, me, target);
        if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
    } else 
    {
	  //  if (!target->is_busy()) target->start_busy(random(3));        
        damage1 = (target->query("max_neili") - me->query("max_neili"))/500;
		damage = damage1+random(damage1)+100;       
        me->receive_damage("qi", damage,target);
        me->receive_wound("qi", damage/2,target);  	
        msg = CYN"结果$N被$n的内力一震，眼前一黑，身子向后倒飞出丈许！！\n"NOR;
		message_vision(msg, me, target);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对自己气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
    }
	me->start_busy(1);

    return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}