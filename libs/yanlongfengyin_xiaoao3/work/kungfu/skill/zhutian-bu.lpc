// zhutian-bu.c 诸天化身步
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SKILL;

mapping *action = ({
  ([ "action": "$n一式「天地钩」，拔地而起，忽的一个空翻，飘然落在几丈远的地方。\n",
    "dodge": 10
  ]),
  ([ "action": "$n一式「凤点头」，两臂鹏举如翼，如一阵清风，从$N头顶横跃而过。\n",
    "dodge": 20
  ]),
  ([ "action": "$n一式「鹰爪松」，身体如一只苍鹰般腾空而起，舒缓地闪过了$N的凌厉攻势。\n",
    "dodge": 30
  ]),
  ([ "action": "$n一式「风摆柳」，身体曼妙的轻轻摆动，横着飘出近一丈远\n",
    "dodge": 50
  ]),
  ([ "action": "$n一式「阴阳箭」，双脚点地，全身化为一道白影，倏的拔地而起，令$N不敢仰视。\n",
    "dodge": 80
  ]),
  ([ "action": "$n一式「日月扣」，身形陡地变得飘忽不定，流水般地滑出丈余。\n",
    "dodge": 110
  ]),
});

mapping query_action(object me, object weapon) {
  int zhaoshu, level;

  zhaoshu = sizeof(action);
  level = (int)me->query_skill("zhutian-bu");

  if (level < 80)
    zhaoshu--;

  if (level < 60)
    zhaoshu--;

  if (level < 40)
    zhaoshu--;

  return action[random(zhaoshu)];
}

int valid_enable(string usage) {
  return usage == "dodge";
}

int valid_learn(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query("family/family_name") != "峨嵋派")
    return notify_fail("你不是峨嵋派弟子，无法学习诸天化身步。\n");

  if ((int)me->query_skill("linji-zhuang", 1) < 100)
    return notify_fail("你的临济十二庄火候不够，无法学习诸天化身步。\n");

  return 1;
}

string query_dodge_msg(string limb) {
  object me, ob;
  mapping action;

  me = this_player();
  action = query_action(me, ob);

  return action["action"];
}

int practice_skill(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query("family/family_name") != "峨嵋派")
    return notify_fail("你不是峨嵋派弟子，无法练习诸天化身步。\n");

  if ((int)me->query("qi") < 40)
    return notify_fail("你的体力太差了，不能练「诸天化身步」。\n");
  me->receive_damage("qi", 30);
  return 1;
}
string perform_action_file(string action) {
  return __DIR__ "zhutian-bu/" + action;
}
//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage) {

  int j, ap, dp, neili, neili1;
  ap = me->query_skill("zhutian-bu", 1) * me->query("con", 1);
  dp = ob->query_skill("dodge", 1) * ob->query("str", 1);

  neili = me->query("neili");
  neili1 = ob->query("neili");

  if (damage < 10) damage = 10;
  if (random(ap) > dp / 10
    && me->query_skill("linji-zhuang", 1) > 100
    && me->query_skill("zhutian-bu", 1) > 200
    && me->query_skill_mapped("force") == "linji-zhuang"
    && me->query("neili") > 1000
    && random(6) == 0) {
    message_vision(HIG "$N顿悟阴阳交泰，天地二气流转全身，化身万千。\n" NOR, me, ob);
    if (me->query("eff_qi") < me->query("max_qi") * 9 / 10) {
      me->add("eff_qi", damage / 2);
      //		me->add("qi",damage/2);
      me->add("neili", -100);
      message_vision(HIM "$N化自在千古！万千化身汇聚吾身，受到伤势似乎好了一些。\n" NOR, me, ob);
    }

    message_vision(HIW "$n被$N的万千化身迷住，无法分辨其真身所在，不知所措！。\n" NOR, me, ob);
    if (!ob->is_busy()) ob->start_busy(1);
    if (neili >= random(neili1) + damage) {
      message_vision(HIC "$n击中的几乎都是$N的化身！\n" NOR, me, ob);
      j = -(damage * 2 + random(damage * 2));
      me->add("neili", -100);
    } else {
      message_vision(HIB "$n隐隐约约看见了$N的真身！\n" NOR, me, ob);
      j = -(damage + random(damage));
      me->add("neili", -100);
    }
    return j;
  }
}
