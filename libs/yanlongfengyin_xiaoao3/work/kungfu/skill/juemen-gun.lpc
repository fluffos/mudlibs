// juemen-gun.c 绝门棍	下乘武学100~300
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SKILL;
string *dodge_msg = ({
  "$n右脚轻轻一点跃开躲过了$N的攻击。\n",
  "$n向旁边扑出，顺势一滚，闪到一边。\n",
  "$n斜里冲前一步，身法诡异，$N这一招落到空处。\n",
  "$n忽然直身飞入半空，很久也不见人影，半响后竟闪到了$N的背后。\n",
  "$n突然一个急转身，$N的这一招滑到了一边。\n",
});
