// longshan 天翔龙闪
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include "/kungfu/skill/eff_msg.h";
inherit F_SSERVER;
int perform(object me, object target) {
  object weapon;
  string msg;
  int extra, damage, damage1;
  int ap, dp;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("只能在战斗中使用。\n");
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "blade")
    return notify_fail("你使用的武器不对。\n");
  //	if (target && target->query_temp("apply/shade_vision")) 
  //		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");
  if ((int)me->query("neili") < 10000)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query("max_neili") < 500000)
    return notify_fail("你的内力修为不够。\n");
  if ((int)me->query("jingli") < 10000)
    return notify_fail("你的精力不够。\n");
  if ((int)me->query("max_jingli") < 500000)
    return notify_fail("你的精力修为不够。\n");
  if ((int)me->query_skill("enmeiryu", 1) < 1000)
    return notify_fail("你的陆奥圆明流等级太低!不能贯通使用！\n");
  if ((int)me->query_skill("feitian-yujianliu", 1) < 1000)
    return notify_fail("你的飞天御剑流等级太低!不能贯通使用！\n");
  if ((int)me->query_skill("shayi-xinfa", 1) < 1000)
    return notify_fail("你的杀意心法!不能贯通使用！\n");
  if (!wizardp(me) && me->query_skill_mapped("force") != "shayi-xinfa")
    return notify_fail("不使用本门内功，如何使用本门绝学!\n");
  if (me->query_skill_mapped("blade") != "feitian-yujianliu")
    return notify_fail("你没正确激发该技能 。\n");
  //	if( !wizardp(me) && !me->query("feitian/tianxiang"))
  //		return notify_fail("你只听说过,但不会用「天翔龙闪」！\n");
  if (!wizardp(me) && !(int)me->query("breakup"))
    return notify_fail("你任督二脉未通,无法使用「天翔龙闪」。\n" NOR);
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  msg = HBWHT "$N贯通飞天御剑流武学，使出了御剑流的绝学之精髓！\n" NOR;
  message_vision(msg, me, target);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 5, me);  //CD写法1	
  ap = me->query("xyzx_sys/level") + me->query_skill(
    "feitian-yujianliu",
    1
  ) + me->query_skill("enmeiryu", 1) + me->query_skill("sword") + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
  extra = me->query_skill("feitian-yujianliu", 1) + me->query_skill("shayi-xinfa", 1);

  message_vision(RED "$N本来死灰色的眼睛中突然出现了生的光彩$n。\n" NOR, me, target);
  msg = HIR "$N速度突然加快!向九个方使出了九种不同的招术! $n尽然感到无法防御和躲避！！\n" NOR;
  message_vision(msg, me, target);
  msg = HIG "壹！唐竹！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIC "贰！袈裟斩！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIB "叁！逆袈裟！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIY "肆！左刺！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIR "伍！右刺！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIM "陆！左切上！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIW "柒！右切上！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = CYN "捌！逆风！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = BLU "玖！刺突剑！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);

  damage1 = me->query_skill("shayi-xinfa", 1) + random(me->query_skill("shayi-xinfa", 1));
  target->receive_damage("qi", damage1, me);
  target->receive_wound("qi", damage1, me);
  me->add("neili", -2000);
  if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
    me,
    HIW "该绝招对敌人气血的外伤为" + damage1 + "，内伤为" + damage1 + "。\n" NOR
  );

  if (me->query_skill("enmeiryu", 1) > 2000 && me->query_skill("feitian-yujianliu", 1) > 2000) {
    msg = HIW "\n$N突然身形一晃，脸上一阵红色，全身好象有使不完的力量一样！\n   一剑击出，直逼$n而去！\n" NOR;
    message_vision(msg, me, target);
    if (random(ap) > dp / 3) {
      //	if (!target->is_busy()) target->start_busy(1);
      me->add("neili", -1000);
      damage = me->query_skill("enmeiryu", 1) + me->query_skill("feitian-yujianliu", 1);
      damage = damage + random(damage);
      target->receive_damage("qi", damage, me);
      target->receive_wound("qi", damage / 3, me);
      if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
        me,
        HIW "该绝招对敌人气血的外伤为" + damage + "，内伤为" + damage / 3 + "。\n" NOR
      );
    } else {
      //	if (!target->is_busy()) target->start_busy(1);
      me->add("neili", -500);
      tell_object(target, HIG "你但觉一股强大至极的剑气扑面而来，你知道不妙，连忙跃开数尺。\n" NOR);
    }
  }


  if (me->query_skill("enmeiryu", 1) > 3000 && me->query_skill("feitian-yujianliu", 1) > 3000) {
    msg = RED "\n「拔刀术!」$N身如鬼魅，身法突然加快。\n   在$n没有产生抵抗力时给予第二击，一剑横空！\n" NOR;
    message_vision(msg, me, target);
    me->add_temp("apply/attack", extra);
    me->add_temp("apply/damage", extra);
    msg = HIG "\n「拔刀术!」第一击！\n" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    msg = HIC "\n「拔刀术!」第二击！\n" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    me->add_temp("apply/attack", -extra);
    me->add_temp("apply/damage", -extra);
    if (random(ap) > dp / 3) {
      //	if (!target->is_busy()) target->start_busy(1);
      me->add("neili", -2000);
      if (me->query("jm/feitian")) damage = me->query_skill("enmeiryu") + me->query_skill("feitian-yujianliu") * me->query(
        "int",
        1
      ) * 3 / 2 + me->query_skill("shayi-xinfa");
      else damage = me->query_skill("enmeiryu") + me->query_skill("feitian-yujianliu") * me->query(
        "int",
        1
      ) + me->query_skill("shayi-xinfa");
      damage = damage + random(damage);
      target->receive_damage("qi", damage / 2, me);
      target->receive_wound("qi", damage / 3, me);
      if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
        me,
        HIW "该绝招对敌人气血的外伤为" + damage + "，内伤为" + damage + "。\n" NOR
      );
    } else {
      me->add("neili", -500);
      tell_object(target, HIG "你喘息未定，抵抗力还未产生，只好跃开数尺，狼狈地避开。\n" NOR);
    }
  }

  if (me->query_skill("enmeiryu", 1) > 4000 && me->query_skill("feitian-yujianliu", 1) > 4000) {
    msg = HIR "\n「燕返!」$N身形急转，将两种剑法融会贯通。\n   $n躲开了拔刀术的致命之伤，正沾沾自喜！第二刀折返而回，胸口一刀透体！\n" NOR;
    message_vision(msg, me, target);
    me->add_temp("apply/attack", extra);
    me->add_temp("apply/damage", extra);
    msg = HIG "\n「燕返!」第一刀！\n" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    msg = HIC "\n「燕返!」第二刀！\n" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    me->add_temp("apply/attack", -extra);
    me->add_temp("apply/damage", -extra);
    if (random(ap) > dp / 3) {
      //	if (!target->is_busy()) target->start_busy(random(3));
      me->add("neili", -3000);
      if (me->query("jm/feitian")) damage = me->query_skill(
        "enmeiryu",
        1
      ) * me->query(
        "int",
        1
      ) * 3 / 2 + me->query_skill(
        "feitian-yujianliu",
        1
      ) * me->query(
        "dex",
        1
      ) * 3 / 2 + me->query_skill("shayi-xinfa") * me->query(
        "int",
        1
      ) * 3 / 2 + me->query_skill("shayi") * me->query(
        "int",
        1
      ) * 3 / 2 + me->query_skill("blade") + me->query_skill("force") + target->query("qi") / 50;
      else damage = me->query_skill(
        "enmeiryu",
        1
      ) * me->query(
        "int",
        1
      ) + me->query_skill(
        "feitian-yujianliu",
        1
      ) * me->query(
        "dex",
        1
      ) + me->query_skill("shayi-xinfa") * me->query(
        "int",
        1
      ) + me->query_skill("shayi") * me->query(
        "int",
        1
      ) + me->query_skill("blade") + me->query_skill("force") + target->query("qi") / 80;
      damage = damage + random(damage);
      target->receive_damage("qi", damage, me);
      target->receive_wound("qi", damage / 2, me);
      if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
        me,
        HIW "该绝招对敌人气血的外伤为" + damage + "，内伤为" + damage / 2 + "。\n" NOR
      );
    } else {
      me->add("neili", -1000);
      tell_object(target, HIG "你用尽全身力量向右一纵一滚，摇摇欲倒地站了起来，但总算躲开了这致命的一击！\n" NOR);
    }
  }
  me->start_busy(1);
  return 1;
}


void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
