int valid_enable(string usage) {
  return usage == "unarmed" || usage == "parry";
}
int practice_level() {
  return 80;
}
int valid_combine(string combo) {
  return combo == "yunlong-shou";
}
int valid_learn(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练云龙爪必须空手。\n");
  if (me->query("family/family_name") != "云龙门")
    return notify_fail("不加入云龙门，学不了本门技能。\n");
  if ((int)me->query_skill("yunlong-shengong", 1) < 100)
    return notify_fail("你的云龙神功火候不够，无法学习本门技能。\n");
  if ((int)me->query("max_neili") < 1000)
    return notify_fail("你的内力太弱，无法练云龙爪。\n");
  if ((int)me->query_skill("unarmed", 1) < 100)
    return notify_fail("你的基本爪法火候不够，无法学云龙爪。\n");
  if (me->query_skill("unarmed", 1) <= me->query_skill("yunlong-zhua", 1))
    return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}


int practice_skill(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练云龙爪必须空手。\n");
  if ((int)me->query("qi") < 30)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 20)
    return notify_fail("你的内力不够练云龙爪。\n");
  if (me->query("family/family_name") != "云龙门")
    return notify_fail("不加入云龙门，练习不了本门技能。\n");
  me->receive_damage("qi", 30);
  me->add("neili", -10);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "yunlong-zhua/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  int ap, dp, damage2;

  ap = me->query_skill("yunlong-zhua", 1);
  dp = victim->query_skill("parry", 1);
  damage2 = (int)me->query_skill("yunlong-zhua", 1);

  if (damage_bonus < 100) return 0;
  if (me->query_skill("yunlong-shengong", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "yunlong-shengong") return 0;
  if (damage2 < 10) damage2 = 10;
  if (random(6) == 3 && random(ap) > dp / 10) {
    victim->apply_condition(
      "zhua_poison",
      random(me->query_skill("yunlong-zhua", 1) / 100) + 11 + victim->query_condition("zhua_poison")
    );
    victim->receive_wound("qi", damage2 + damage_bonus / 2, me);
    victim->receive_damage("qi", damage2 + damage_bonus / 2, me);
    me->add("neili", -100);
    return HIR "只听$n" HIR "一声惨嚎，看来受到了云龙爪毒劲的干扰！\n" NOR;
  }
}


//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage) {
  string msg;
  int j, skill, neili, neili1;
  int level, level2, damage2;
  level = (int)me->query_skill("unarmed", 1);
  level2 = (int)me->query_skill("yunlong-zhua", 1);
  skill = me->query_skill("yunlong-shengong", 1);
  neili = me->query("neili");
  neili1 = ob->query("neili");
  damage2 = (int)ob->query("neili", 1) / 10;
  if (damage2 > 5000) damage2 = 5000;
  if (damage2 < 0) damage2 = 0;
  if (damage < 10) damage = 10;
  if (random(8) == 0 && level2 >= 300 && (me->query_skill_mapped("force") == "yunlong-shengong")) {
    j = -(damage + random(damage));
    msg = HIR "$N手臂伸展，左手聚成虎爪状! 如云龙出渊，一把抓住$n的" + xue_name[random(sizeof(xue_name))] + NOR;

    message_vision(msg, me, ob);
    if (ob->query("qi") > damage2) {
      ob->apply_condition("zhua_poison", 10);
      ob->receive_damage("qi", damage2, me);
      ob->receive_wound("qi", damage2 / 2, me);
    }
    if (!ob->is_busy()) ob->start_busy(2);
    return j;
  }

}
