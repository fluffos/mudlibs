// biyun-xinfa.c 碧云心法
// cleansword
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit FORCE;

int valid_enable(string usage)
{
	return usage == "force";
}

int valid_learn(object me)
{
	mapping skl;
	string *sname;
	int i,lvl;
	lvl = (int)me->query_skill("biyun-xinfa", 1);
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if ( (me->query("family/family_name") != "唐门"))
		return notify_fail("碧云心法乃唐门独门神功, 非唐门弟子不传!\n");
	if ( me->query("gender") == "无性" && lvl > 49)
		return notify_fail("唐门不要你这种无根无性的人，你无法领会高深的碧云心法。\n");
	if ((int)me->query_skill("force", 1) < 100)
		return notify_fail("你的基本内功火候还不够，无法领会碧云心法。\n");
    if ((int)me->query_skill("force",1)<=(int)me->query_skill("biyun-xinfa", 1))
        return notify_fail("你的基本内功基础不够，再学下去会走火入魔的。\n");	

	if (!me->query("jm/huanhua"))
		return notify_fail(CYN"这神州结义萧秋水好大的胆子，竟敢强闯我唐门禁地！\n"CYN"这位"+RANK_D->query_respect(me)+CYN"欲入我唐门，需得去浣花派为唐门了结此段恩怨！\n"NOR);
	if ((int)me->query("family_score")<6)
		return notify_fail(CYN"这位"+RANK_D->query_respect(me)+CYN"对江湖不够了解啊，我派功夫恐怕不能传授于你。\n"NOR);			
	
	skl = this_player()->query_skills();
	sname  = keys(skl);
	for (i=0; i<sizeof(skl); i++)
	{
		if (sname[i]=="yijing-force") continue;
		if (sname[i]=="biyun-xinfa") continue;
		if (sname[i]=="xixing-dafa") continue;
		if( SKILL_D(sname[i])->valid_enable("force") )
			return notify_fail("你不先散了别派内功，怎能学碧云心法？！\n");
	}
	return 1;
}

string exert_function_file(string func)
{
	return __DIR__"biyun-xinfa/" + func;
}

mapping exercise_msg(object me)
{
  return ([
        "status_msg" : "双目微闭，周围落叶环绕。\n" ,
        "start_my_msg" : "双臂做环抱装，周身落叶随风起舞，环绕在周身。\n",
        "start_other_msg" :  me->name() + "双臂做环抱装，周身落叶随风起舞，环绕在周身。\n",
        "heal_my_msg" : "全身衣服鼓起，周围有旋风刮起，落叶随风起舞，愈演愈烈，逐渐将周身环绕在内。\n",
        "heal_other_msg" :  me->name() + "全身衣服鼓起"+ me->name() + "周身落叶飞舞，愈演愈烈，将"+ me->name() + "全身都遮没了。\n",
        "halt_msg" :  "长出一口气，将内息急速退了回去，站了起来，周围一地落叶。\n",
        "end_my_msg" : "睁开双眼，缓缓站起，周围落叶突然失去支撑，落了一地。\n",
        "end_other_msg" : me->name()+"睁开双眼，缓缓站起，周围落叶突然失去支撑，落了一地。\n",		
        "hover_my_msg" : "全身骨节爆响，落叶风随云转。过了良久，风声渐止，云停叶落。\n",
        "hover_other_msg" : "只听得"+me->name()+"全身骨节爆响，落叶风随云转。过了良久，风声渐止，云停叶落。\n",	
    ]);
}


mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
	int ap,dp,damage2;
	damage2 = (int)me->query_skill("biyun-xinfa",1);	
	ap = me->query_skill("biyun-xinfa",1);
	dp = victim->query_skill("force",1);
    if( damage_bonus < 100 ) return 0;
	if ( me->query_skill("biyun-xinfa",1) < 100)	 return 0;
	if ( me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "biyun-xinfa") return 0;	
	if (damage2<10) damage2=10;	
	if ( random(ap) > dp/20 && random(6)==0 && me->query("jiali") > 0) 
	{
		victim->receive_wound("qi", damage2+damage_bonus/2,me);
		me->add("neili", -100 );
		return HIB "$N运转"+HIR+"碧云心法"NOR HIB"的精髓，摧毁了$n的真元！！！！\n" NOR;
	}
}