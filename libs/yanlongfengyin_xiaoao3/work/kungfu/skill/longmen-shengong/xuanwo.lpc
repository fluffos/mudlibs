// made by lks

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
int exert(object me, object target) {
  int damage, skill, ap, dp;
  string msg;

  if (target == me || !target) {
    me->clean_up_enemy();
    target = me->select_opponent();
  }
  if (!me->is_fighting(target))
    return notify_fail("「旋涡劲」只能对战斗中的对手使用。\n");
  if ((int)me->query_skill("force", 1) < 1000)
    return notify_fail("你的内功底子太薄，不能使用。\n");
  if (!wizardp(me) && me->query_skill_mapped("force") != "longmen-shengong")
    return notify_fail(HIC "不使用本门内功，如何使用本门绝学!\n" NOR);
  //	if (target && target->query_temp("apply/shade_vision")) 
  //		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	
  if ((int)me->query_skill("longmen-shengong", 1) < 300)
    return notify_fail("你的龙门神功不够熟练。\n");
  if ((int)me->query("max_neili") < 100000)
    return notify_fail("你的内力修为还不够高。\n");
  if ((int)me->query("max_jingli") < 100000)
    return notify_fail("你的精力修为还不够高。\n");
  if ((int)me->query("jingli") < 1000)
    return notify_fail("你的精力不够了。\n");
  if ((int)me->query("neili", 1) < 1000)
    return notify_fail("你现在内力太弱，不能使用「旋涡劲」。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着！\n");
  //   if( target && target->is_busy() )
  //       return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧!\n");  
  //	if (target && target->query_temp("busy_mianyi") )	//冲穴成功后免疫busy，2017.9.29阿飞添加
  //		return notify_fail(target->name() + "奇经八脉浑然一体，真气浩浩荡荡，点穴似乎没什么作用。\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  msg = HIC "$N气贯丹田，双掌齐出，推出一股带着旋涡的气流。罩向$n。\n" NOR;
  message_vision(msg, me, target);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1		
  skill = (int)me->query_skill("longmen-shengong", 1);
  ap = me->query("xyzx_sys/level") + me->query_skill(
    "longmen-shengong",
    1
  ) + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("force");

  if (random(ap) > dp / 3) {
    //          target->start_busy( (100*skill)/(skill+1000) + 5);               
    damage = (int)me->query_skill("force", 1) + (int)me->query_skill("longmen-shengong", 1);
    damage = damage + random(damage);
    target->receive_damage("qi", damage, me);
    target->receive_wound("qi", damage / 3, me);
    me->add("neili", -500);
    msg = WHT "$n只觉人如舟子在掀天巨浪中颠簸起落，全不能自己！\n" NOR;
    message_vision(msg, me, target);
    if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
      me,
      HIW "该绝招对敌人气血的外伤为" + damage + "，内伤为" + damage / 3 + "。\n" NOR
    );
  } else {
    msg = YEL "可是$p向旁边侧身一闪,跳出了旋涡的攻击范围。\n" NOR;
    message_vision(msg, me, target);
    me->add("neili", -100);
  }
  message_vision(msg, me, target);
  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
