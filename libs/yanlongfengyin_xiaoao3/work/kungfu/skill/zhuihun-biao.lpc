int valid_enable(string usage) { return (usage == "throwing") || (usage == "parry"); }

int valid_learn(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("max_neili") < 100000)
    return notify_fail("你的内力不够。\n");
  if (me->query("family/family_name") != "唐门")
    return notify_fail("你不是唐门弟子，无法学习追魂镖。\n");
  if ((int)me->query_skill("biyun-xinfa", 1) < 300)
    return notify_fail("你的碧云心法火候不够。\n");
  if ((int)me->query_skill("biye-wu", 1) < 300)
    return notify_fail("你的碧叶随风舞火候太浅。\n");
  if ((int)me->query("dex", 1) < 30)
    return notify_fail("唐门的暗器技巧最重身法。\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (random(100) == 1) me->add("score", -5);
  return 1;
}

mapping query_action(object me, object weapon) {
  int zhaoshu, level;

  zhaoshu = sizeof(action) - 1;
  level = (int)me->query_skill("zhuihun-biao", 1);

  if (level < 700) zhaoshu--;
  if (level < 600) zhaoshu--;
  if (level < 500) zhaoshu--;
  if (level < 400) zhaoshu--;
  if (level < 300) zhaoshu--;
  if (level < 200) zhaoshu--;
  if (level < 100) zhaoshu--;

  return action[random(zhaoshu)];
}

int practice_skill(object me) {
  object weapon;
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "throwing")
    return notify_fail("你使用的武器不对。\n");
  if (me->query("family/family_name") != "唐门")
    return notify_fail("你不是唐门弟子，无法练习追魂镖。\n");
  if ((int)me->query("qi") < 50)
    return notify_fail("你的体力不够练追魂夺命镖。\n");
  me->receive_damage("qi", 30);
  return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor) {

  int ap, dp, damage2;

  ap = (int)me->query_skill("zhuihun-biao", 1);
  dp = (int)victim->query_skill("dodge", 1);

  damage2 = (int)me->query_skill("zhuihun-biao", 1);

  if (damage_bonus < 100) return 0;
  if (me->query_skill("biyun-xinfa", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "biyun-xinfa") return 0;
  if (damage2 < 10) damage2 = 10;

  if (random(6) == 0 && me->query_skill_mapped("force") == "biyun-xinfa" && me->query("jiali") > 0 && random(ap) > dp / 10) {
    me->add("neili", -100);
    victim->receive_damage("qi", damage2 + damage_bonus / 2, me);
    victim->receive_wound("qi", damage2 + damage_bonus / 2, me);
    victim->apply_condition(du[random(sizeof(du))], 25);
    //	if (!victim->is_busy()) victim->start_busy(2);	
    return HIR "$n虽然接住了这一只追魂镖，但是这暗器居然化成了水！顿时感觉三魂似乎要飞走！\n";
  }

}

string perform_action_file(string action) {
  return __DIR__ "zhuihun-biao/" + action;
}
