// 喧哗流拳法.三重劲sanchong

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include "/kungfu/skill/eff_msg.h";

inherit F_SSERVER;

int perform(object me, object target)
{
	int damage,ap,dp,extra;
	string msg;

	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) || !living(target) )
		return notify_fail("三重劲只能对战斗中的对手使用。\n");
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");
	if( (int)me->query_skill("xuanhualiu-quanfa", 1) < 1000 )
		return notify_fail("你的喧哗流拳法还不够熟练，不能使用三重劲！\n");
	if( (int)me->query_skill("ittouryu", 1) < 1000 )
		return notify_fail("你的一刀流剑术还不够熟练，不能使用三重劲！\n");
	if( objectp(me->query_temp("weapon")) )
		return notify_fail("你必须空手才能使用「三重劲」！\n");
//	if (target && target->query_temp("apply/shade_vision")) 
//		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
	if ( me->query_skill_mapped("unarmed") != "xuanhualiu-quanfa")
		return notify_fail("你必须先将喧哗流拳法运用于拳脚之中才行。\n");
	if ((int)me->query_skill("shayi-xinfa", 1) < 1000)
		return notify_fail("你的杀意心法火候不够。\n");
    if( me->query_skill_mapped("force") != "shayi-xinfa" )
         return notify_fail("你所用的并非杀意心法，没法凝聚杀意，用不了本门绝技！\n");
	if( (int)me->query("neili") < 10000 )
		return notify_fail("你现在内力不足，使不出「三重劲」的绝招！\n");
	if( (int)me->query("max_neili") < 1000000 )
		return notify_fail("你现在内力修为不足，使不出「三重劲」的绝招！\n");
	if ((int)me->query("max_jingli") < 1000000)								
		return notify_fail("你的精力修为不够。\n");	
//	if( userp(me) && !me->query("feitian/sanchong"))
//		return notify_fail("你只听说过,但不会用「三重劲」！\n");
	if( (int)me->query("jingli") < 10000 )
		return notify_fail("你现在精神不够集中，使不出「三重劲」功的绝招！\n");
	if( (int)me->query_skill("unarmed", 1) < 2000 )
		return notify_fail("你的拳法不够娴熟，使不出「三重劲」功的绝招！\n");
	if (!wizardp(me) && !(int)me->query("breakup") )
		return notify_fail("你任督二脉未通,无法使用「三重劲」。\n"NOR);	
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	message_vision(HBWHT "$N贯通飞天御剑流武学，使出了御剑流的绝学之精髓！\n" NOR, me, target);	
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 5, me);	//CD写法1
	ap = me->query("xyzx_sys/level") + me->query_skill("xuanhualiu-quanfa", 1) +me->query_skill("ittouryu", 1)+ me->query_skill("unarmed") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	extra = me->query_skill("xuanhualiu-quanfa",1) + me->query_skill("ittouryu", 1);
	
	message_vision(HIB "$N虽然只打出一拳，但是拳劲蕴含道家内劲三重意境，一重打死牛！二重打死仙！三重打死神！\n"NOR, me, target);
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"));	
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"));	
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"));	
	message_vision(HIC "$n连中三重劲，脸色憋的通红，一口鲜血喷出！！！！\n"NOR, me, target);	

	msg = HIW "$N突然全身骨骼作响打出一拳，脸上一阵红色，全身好象有使不完的力量一样！\n   一拳打出，拳风直逼$n而去！\n"NOR;
	message_vision(msg, me, target);
	if (random(ap) > dp/3)
	{
//		if (!target->is_busy()) target->start_busy(1);
		me->add("neili", -1000);
		me->add("jingli", -1000);
		damage = me->query("xyzx_sys/level") + me->query_skill("xuanhualiu-quanfa", 1) +me->query_skill("ittouryu", 1)+ me->query_skill("unarmed") + me->query_skill("force");
		damage = damage + random(damage);
		if(me->query("neili") > target->query("neili")*2 ) damage += random(damage);
		target->receive_damage("qi", damage,me);
		target->receive_wound("qi", damage/2,me);
		msg = HIC"$N使出内家拳第一重劲，一重摧筋断骨！\n"NOR;
		me->add_temp("apply/attack",extra);
		me->add_temp("apply/damage",extra);		
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
		me->add_temp("apply/attack",-extra);
		me->add_temp("apply/damage",-extra);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	}
	else
	{
//		if (!target->is_busy()) target->start_busy(1);
		me->add("neili", -1000);
		msg=HIG"你但觉一股强大至极的力道扑面而来，你知道不妙，连忙跃开数尺。\n" NOR;
		message_vision(msg, me, target);
	}
	
		
if( (int)me->query_skill("xuanhualiu-quanfa", 1) > 2000 && (int)me->query_skill("ittouryu", 1) >2000)
{	
	msg = RED "\n「二重劲!」$N左拳劲力未消，右拳也跟着打出。\n   在$n没有产生抵抗力时给予第二击,拳风排山倒海般涌向$n！\n"NOR;
	message_vision(msg, me, target);
	if (random(ap) > dp/3)
	{
//		if (!target->is_busy()) target->start_busy(1);
		me->add("neili", -2000);
		me->add("jingli", -2000);
		damage = me->query("xyzx_sys/level") + me->query_skill("xuanhualiu-quanfa", 1) +me->query_skill("ittouryu", 1)+ me->query_skill("unarmed") + me->query_skill("force");
		damage = damage*2 + random(damage*2);
		if(me->query("neili") > target->query("neili")*2 ) damage += random(damage);
		target->receive_damage("qi", damage,me);
		target->receive_wound("qi", damage/2,me);
		msg = HIC"$N使出内家拳第二重劲，二重勾魂夺魄！\n"NOR;
		me->add_temp("apply/attack",extra*2);
		me->add_temp("apply/damage",extra*2);		
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
		me->add_temp("apply/attack",-extra*2);
		me->add_temp("apply/damage",-extra*2);			
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	}
	else
	{
		me->add("neili", -2000);
		msg=HIG"你喘息未定，抵抗力还未产生，只好跃开数尺，狼狈地避开。\n" NOR;
		message_vision(msg, me, target);
	}
}

	
if( (int)me->query_skill("xuanhualiu-quanfa", 1) > 3000 && (int)me->query_skill("ittouryu", 1) >3000)
{
	msg = HIR "\n「三重劲!」$N全身骨骼一阵爆响,拼尽毕生功力使出了喧哗流拳法的终极绝技。\n   $n连同身前方圆三丈全在「三重劲!」劲力笼罩之下！\n"NOR;
	message_vision(msg, me, target);
	if (random(ap) > dp/3)
	{
//		if (!target->is_busy()) target->start_busy(random(3));
		me->add("neili", -3000);
		me->add("jingli", -3000);
		if (me->query("jm/feitian")) damage = me->query_skill("shayi-xinfa", 1)* me->query("int",1)*3/2+me->query_skill("shayi", 1)* me->query("int",1)*3/2 + me->query_skill("xuanhualiu-quanfa", 1)* me->query("int",1)*3/2 +me->query_skill("ittouryu", 1)* me->query("dex",1)*3/2+ me->query_skill("unarmed")+ me->query_skill("blade") + me->query_skill("force") + target->query("qi")/50;
		else damage = me->query_skill("shayi-xinfa", 1)* me->query("int",1)+me->query_skill("shayi", 1)* me->query("int",1) + me->query_skill("xuanhualiu-quanfa", 1)* me->query("int",1) +me->query_skill("ittouryu", 1)* me->query("dex",1)+ me->query_skill("unarmed")+ me->query_skill("blade") + me->query_skill("force") + target->query("qi")/80;
		damage = damage + random(damage);
		if(me->query("neili") > target->query("neili")*2 ) damage += random(damage/2);
		target->receive_damage("qi", damage,me);
		target->receive_wound("qi", damage/2,me);
		msg = HIC"$N使出内家拳第三重劲，三重神挡杀神，佛挡灭佛！\n"NOR;
		me->add_temp("apply/attack",extra*3);
		me->add_temp("apply/damage",extra*3);		
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
		me->add_temp("apply/attack",-extra*3);
		me->add_temp("apply/damage",-extra*3);	
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);		

	}
	else
	{
//		if (!target->is_busy()) target->start_busy(2);
		me->add("neili", -1000);
		msg=HIG"你用尽全身力量向右一纵一滚，摇摇欲倒地站了起来，但总算躲开了这致命的一击！\n" NOR;
		message_vision(msg, me, target);
	}

}	
	me->start_busy(1);		
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}