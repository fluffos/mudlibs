#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>
inherit F_SSERVER;
int perform(object me, object target)
{
        object weapon,weapon2;
        int damage,ap,dp;
        string msg;

	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("「独孤情仇」只能在战斗中使用。\n"); 	
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
		return notify_fail("「 独孤情仇 」必须用剑才能施展。\n");  
//	if (target && target->query_temp("apply/shade_vision")) 
//		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");
	if( (int)me->query_skill("dugu-jiujian", 1) < 1000 )     	
		return notify_fail("你的「 独孤九剑 」不够娴熟，不会使用「独孤情仇」。\n");     	
	if (me->query_skill_mapped("sword") != "dugu-jiujian")
		return notify_fail("你没正确激发该技能 。\n");
	if( (int)me->query("neili") < 1000  ) 	
		return notify_fail("你的内力不够。\n");
	if( (int)me->query("jingli") < 1000 )
		return notify_fail("你的精力不够。\n");	
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		   	 	
	damage = me->query_skill("sword",1) +  (int)me->query_skill("dugu-jiujian", 1)*me->query("int",1);	
	damage = damage + random(damage);
	ap = me->query("xyzx_sys/level") + me->query_skill("dugu-jiujian", 1) + me->query_skill("sword") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	msg = HIC "$N弹指抚剑神情漠然,"+weapon->name()    +""HIC"信手挥出,「独孤九剑」总诀式应手而出，剑影闪动"+weapon->name() +""HIC"直直击向$n。\n" NOR;
	message_vision(msg, me, target);  
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1
	
	if ( random(ap) > dp/3) 
	{                   		
		msg = HIR "$n顿时觉得眼前剑影闪动,不知来剑究竟指向何处，只觉一阵刺痛已然中招！\n"           	
			HIC "$N神游虚外,已然忘我,手中" + weapon->name() + HIC "自然而然随意击划,剑式变幻九剑诀连绵递出！\n" NOR;      	
		message_vision(msg, me, target);
	
		msg = HIR"破箭式！\n"NOR;	
        message_vision(msg, me, target);
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
		msg = HIY"破鞭式！\n"NOR;	
        message_vision(msg, me, target);
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"));	
		msg = HIC"破刀式！\n"NOR;       	
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
		msg = HIG"破枪式！\n"NOR;               	
		message_vision(msg, me, target);	
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"));	
		msg = HIM"破索式！\n"NOR;       	
		message_vision(msg, me, target);	
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"));	
		msg = CYN"破掌式！\n"NOR;       	
		message_vision(msg, me, target);	
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"));	
		msg = RED"破锤式！\n"NOR;       	
		message_vision(msg, me, target);	
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"));	
		msg = HIB"破剑式！\n"NOR;	
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
		msg = HIW"破气式！\n"NOR;	
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
		
		target->receive_damage("qi", damage,me);
		target->receive_wound("qi", damage/2,me);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
		me->add("neili", -1000);
		if (objectp(weapon2 = target->query_temp("weapon")) )	
		{
			weapon2->move(environment(me));
			target->apply_condition("no_equip", 10);
			message_vision(HIW"$N随手几招向$n刺来,一看只下尽全是刺向$n武功的弱点，$n心中一慌，不由自主的丢下了"NOR+weapon2->name()+NOR HIW"！\n" NOR, me, target);
		}
		else
		{    
			target->add("neili",-damage );
			message_vision(	HIR "$N手中的剑发出无数道的剑气,一道一道的剑气向$n刺去，$n气海穴上微微一痛，全身真气狂泄而出！\n" NOR, me, target);
			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招杀内力为"+ damage +"。\n" NOR);
		}	
	} else 
	{                	
		msg = HIG "$n心下一惊,急急出招迎向来势,匆忙中险险架住了$N的" + weapon->name() + HIG"。\n" NOR;                 	
		message_vision(msg, me, target);             		
	}
	me->start_busy(1);
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}