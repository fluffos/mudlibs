int valid_enable(string usage) {
  return usage == "parry" || usage == "unarmed" || usage == "strike";
}


int valid_learn(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练排云掌必须空手。\n");
  if (me->query("family/family_name") != "杀手楼")
    return notify_fail("你不加入杀手楼，无法学习排云掌。\n");
  if ((int)me->query_skill("wuji-shengong", 1) < 300)
    return notify_fail("你的无极神功火候不够，无法学排云掌。\n");
  if ((int)me->query("max_neili") < 100000)
    return notify_fail("你的内力太弱，无法练排云掌。\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (random(100) == 1) me->add("score", -5);
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("qi") < 30)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 40)
    return notify_fail("你的内力不够练排云掌。\n");
  if (me->query("family/family_name") != "杀手楼")
    return notify_fail("你不是杀手楼中人，偷练杀手楼绝技是活腻了吧。\n");
  me->receive_damage("qi", 30);
  me->add("neili", -10);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "fanyun-zhang/" + action;
}


mixed hit_ob(object me, object victim, int damage_bonus) {
  int ap, dp, damage2;
  damage2 = (int)me->query_skill("fanyun-zhang", 1);
  ap = me->query_skill("fanyun-zhang", 1);
  dp = victim->query_skill("parry", 1);
  if (damage_bonus < 100) return 0;
  if (me->query_skill("wuji-shengong", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "wuji-shengong") return 0;
  if (damage2 < 10) damage2 = 10;
  if (me->query_skill("force", 1) > 300
    && random(ap) > dp / 3
    && me->query_skill_mapped("force") == "wuji-shengong"
    && random(5) == 0
    && me->query("jiali") > 0) {
    victim->receive_wound("qi", damage2 + damage_bonus / 2, me);
    return HIR "只听一声“咔嚓”的一声，$n被$N的排云掌打断了几根肋骨！\n" NOR;
    //		if (!victim->is_busy()) victim->start_busy(1);
    me->add("neili", -100);

  }
}
