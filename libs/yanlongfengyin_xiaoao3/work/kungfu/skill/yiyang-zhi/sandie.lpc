#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>

inherit F_SSERVER;


int perform(object me, object target)
{
	string msg;
	int damage,ap,dp;

	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("「阳关三叠」只能在战斗中使用。\n");
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");
	if( objectp( me->query_temp("weapon")) )
		return notify_fail("只有空手才能施展「阳关三叠」。\n");
	if( (int)me->query_skill("yiyang-zhi", 1) < 500 )
		return notify_fail("你的一阳指功夫还不够娴熟，不会使用「阳关三叠」。\n");
	if(me->query_skill("kumu-shengong", 1) <500)
		return notify_fail("以你现在的内功修为还使不出「阳关三叠」。\n");
//	if (target && target->query_temp("apply/shade_vision")) 
//		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
	if (me->query_skill_mapped("force") != "kumu-shengong" )
		return notify_fail("你不激发枯木神功，恐怕使用不了阳关三叠。\n");
    if ( me->query_skill_mapped("unarmed") != "yiyang-zhi" )
        return notify_fail("你现在无法使用「阳关三叠」进行攻击。\n");
	if (me->query_skill_mapped("parry") != "yiyang-zhi")
		return notify_fail("你所使用的招架不对。\n");
	if( (int)me->query("max_neili") < 200000 )
		return notify_fail("你的内力修为太弱，不能使用「阳关三叠」！\n");
	if ((int)me->query("max_jingli") < 100000)								
		return notify_fail("你的精力修为不够。\n");
	if( (int)me->query("jingli") < 1000 )
		return notify_fail("你的精力不够。\n");	
	if( (int)me->query("neili") < 1000 )
		return notify_fail("你的真气不够！\n");
	if (target && !living(target))
		return notify_fail("对方都已经这样了，用不着这么费力吧？\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1		
	ap = me->query("xyzx_sys/level") + me->query_skill("yiyang-zhi", 1) + me->query_skill("unarmed") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	if (target->query_skill_mapped("force")=="hamagong" || target->query_skill_mapped("unarmed") == "hamagong")
	{
		msg = YEL "\n$N背向$n，凝气于指，一式「阳关三叠」反手缓缓点出，纯阳指力直袭$n胸口！\n" NOR;
		message_vision(msg, me, target);
		if (random(ap) > dp/3 )
		{
			damage = (int)me->query_skill("yiyang-zhi", 1)*5 + me->query_skill("unarmed",1)+ target->query_skill("hamagong",1)*10+(int)me->query_skill("kumu-shengong", 1) + target->query_skill("unarmed",1)+ target->query_skill("force",1);
			damage = damage + random(damage)+150;
			target->receive_damage("qi", damage,me);
			target->receive_wound("qi", damage/2,me);
			me->add("neili", -200);
			me->add("jingli", -200);
			msg = HIR "$n一见之下，大为失色，发现这似乎正是自己的克星！\n"NOR;
			message_vision(msg, me, target);
			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
		}
		else
		{
			me->add("neili", -100);
			msg = HIY"$n见这反手点穴似乎正是蛤蟆功的克星，识得厉害，危及之中一个铁板桥，上身向后一倒，艰难的躲过这一招。\n"NOR;
			message_vision(msg, me, target);
		}
	}
	else
	{
		msg = YEL "\n$N凝气于指，一式「阳关三叠」点出，但听得嗤嗤声响，一股纯阳的内力直袭$n胸口！\n" NOR;
		message_vision(msg, me, target);
		if (random(ap) > dp/3 )
		{
			damage = (int)me->query_skill("yiyang-zhi", 1) + (int)me->query_skill("kumu-shengong", 1) +me->query_skill("unarmed",1);
			damage = damage + random(damage);
			target->receive_damage("qi", damage,me);
			target->receive_wound("qi", damage,me);
			me->add("neili", -200);
			me->add("jingli", -200);
			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage +"。\n" NOR);
		}
		else
		{
			me->add("neili", -100);
			msg = HIY"可是$n一个巧云翻身，远远的躲了开去。\n"NOR;
			message_vision(msg, me, target);
		}
	}

if (me->query_skill("yiyang-zhi",1)>1000)
{
	msg = YEL "\n接着$N踏前一步，出第二指隔空点向$n胸前“玉堂穴”，认穴竟无厘毫之差！\n"NOR;
	message_vision(msg, me, target);
	if (random(me->query_skill("yiyang-zhi",1)) > target->query_skill("dodge",1) / 5)
	{
		msg = HIR "结果一指点中，$n只觉得全身气脉通道阻塞，真气立受干挠！\n"NOR;
		message_vision(msg, me, target);
		damage = (int)me->query_skill("yiyang-zhi", 1)*3 + (int)me->query_skill("kumu-shengong", 1) +me->query_skill("unarmed",1);
		damage = damage + random(damage);
		target->apply_condition("no_force", 10);
		me->add("neili", -200);
		me->add("jingli", -200);
		target->add("neili", -damage);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人杀内力"+ damage +"。\n" NOR);
	}
	else
	{
		me->add("neili", -100);
		msg = HIY"\n$p眼看逼无可逼，便也一指点去，两根指尖相碰，$p顺势跳了开去。\n" NOR;
		message_vision(msg, me, target);
	}
}

if (me->query_skill("yiyang-zhi",1)>2000)
{
	msg = YEL "\n紧跟着$N一阳指第三次点出，以纯阳内力，同时透入$n体内任脉紫宫穴、阴维脉大横穴、冲脉幽门穴、带脉章门穴和阴跤脉晴明穴！\n"NOR;
	message_vision(msg, me, target);
	if (random(me->query_skill("yiyang-zhi",1)) > target->query_skill("parry",1) / 5)
	{
		damage = (int)me->query_skill("yiyang-zhi", 1)*5 + (int)me->query_skill("kumu-shengong", 1) +me->query_skill("unarmed",1);
		damage = damage + random(damage);
		me->add("neili", -200);
		me->add("jingli", -200);
		msg = HIR "$n只觉体内奇经八脉中内息为之一怠，全身气力竟然提不起来了！\n" NOR;
		message_vision(msg, me, target);
		target->apply_condition("no_exert", 10);
		target->receive_damage("jing", damage,me);
		target->receive_wound("jing", damage,me);		
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人精神的外伤为"+ damage +"，内伤为"+ damage +"。\n" NOR);
	}
	else
	{
		me->add("neili", -100);
		msg = HIY"\n$p喘息未定，见$P指力如狂风般点来，连忙又跃开数尺，狼狈地避开。\n" NOR;
		message_vision(msg, me, target);
	}
}	
	me->start_busy(1);
	return 1;
}


void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}