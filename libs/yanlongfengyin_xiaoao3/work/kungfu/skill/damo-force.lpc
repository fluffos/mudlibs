
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit FORCE;

int valid_enable(string usage) 
{ 
        return      usage=="force";

}

int valid_learn(object me)
{
    mapping skl;
    string *sname;
    int i;
    int lvl = (int)me->query_skill("damo-force", 1);
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
    if ( me->query("gender") == "无性" && lvl > 49)
        return notify_fail("你无根无性，阴阳不调，难以领会高深的达摩神功。\n");
	if (me->query("family/family_name")!="通吃帮" && me->query("family/family_name")!="少林派")
		return notify_fail("你不是本门中人，无法领悟本门技能的精髓。\n");
	if (me->query("kar",1) < 25)
       return notify_fail("你的富缘不够，没法传授达摩神功。\n");
	if (me->query_skill("force",1)<300)
		return notify_fail("你的基本内功基础不够，无法领会达摩神功。\n");  
	if (me->query_skill("force",1)<=lvl)
		return notify_fail("你的基本内功基础不够，再学下去会走火入魔的。\n");
	if (!me->query("jm/songshan"))
		return notify_fail(CYN"这嵩山派与我寺同处一山，欲夺取武林盟主之位，我少林表示不服。\n"CYN"这位"+RANK_D->query_respect(me)+CYN"可否先为我少林潜入嵩山派夺取其秘密？我寺将来必有厚报。\n"NOR);
	if ((int)me->query("family_score")<10)
		return notify_fail(CYN"这位"+RANK_D->query_respect(me)+CYN"对江湖不够了解啊，我寺功夫恐怕不能传授于你。\n"NOR);	
			
    skl = me->query_skills();
    sname  = keys(skl);
    for (i=0;i<sizeof(skl);i++){
        if (sname[i]=="hunyuan-yiqi") continue;
        if (sname[i]=="damo-force") continue;
        if (sname[i]=="yijing-force") continue;
        if (sname[i]=="yijinjing") continue;		
         if (sname[i]=="fanyun-force") continue;
         if (sname[i]=="xixing-dafa") continue;
            if( SKILL_D(sname[i])->valid_enable("force") )
        return notify_fail("你不先散了别派内功，怎能学达摩神功？！\n");
    }
 
    return 1;
}

int practice_skill(object me)
{
        return notify_fail("达摩神功只能用学的，或是从运用(exert)中增加熟练度。\n");
}

int effective_level() { return 21; }



string exert_function_file(string func)
{
        return __DIR__"damo-force/" + func;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
	int ap,dp,damage2;
	damage2 = (int)me->query_skill("damo-force",1);	
	ap = me->query_skill("damo-force",1);
	dp = victim->query_skill("force",1);
    if( damage_bonus < 100 ) return 0;
	if ( me->query_skill("damo-force",1) < 100)	 return 0;
	if ( me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "damo-force") return 0;	
	if (damage2<10) damage2=10;	
	if ( random(ap) > dp/20 && random(6)==0 && me->query("jiali") > 0) 
	{
		victim->receive_damage("qi", damage2+damage_bonus/2,me);
		victim->receive_wound("qi", damage2+damage_bonus/2,me);
		me->add("neili", -100 );
		return HIB "$N发挥出"+HIR+"达摩神功"NOR HIB"的真髓，达摩真言摧毁了$n的真元！！！！\n" NOR;
	}
}

mapping exercise_msg(object me)
{
  return ([
        "status_msg" : "脸色红润，宝相庄严，三花聚顶。\n" ,
        "start_my_msg" : "双腿盘坐，手做佛祖拈花状，面露微笑。\n",
        "start_other_msg" :  me->name() + "盘膝坐下，手捏兰花指，面露微笑，头顶三尊佛陀隐隐约约。\n",
        "heal_my_msg" : "面露微笑，头顶三尊佛陀时隐时现，似有诵经声从远古传来。\n",
        "heal_other_msg" :  me->name() + "面露微笑，头顶三尊佛陀时隐时现，诵经声从远古慢慢传来。\n",
        "halt_msg" :  "双臂划圆，两掌合十，缓缓站了起来。\n",
        "end_my_msg" : "双臂划太极，缓缓站起，头顶佛尊汇聚轮海。\n",
        "end_other_msg" : me->name()+"头顶佛像不断汇聚轮海，待法相入体，"+me->name()+"双掌合十，缓缓站起。\n",		
        "hover_my_msg" : "佛祖诵经声铮铮入耳，头顶三尊佛像逐渐清晰。过了良久，佛像入体，佛光也渐渐淡了。\n",
        "hover_other_msg" : me->name()+"只觉佛祖诵经声从远古传来，头顶佛像逐渐清晰。过了良久，法相入体，佛光也渐渐淡了。\n",	
    ]);
}