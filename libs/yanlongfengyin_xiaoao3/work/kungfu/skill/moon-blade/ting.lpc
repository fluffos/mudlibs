#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;
string name() { return HIM "小楼一夜听春雨" NOR; }

int perform(object me, object target) {
  object weapon, weapon2;
  string msg;
  int ap, dp, md, ly, damage, i, count;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail(name() + "只能对战斗中的对手使用。\n");
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "blade")
    return notify_fail("你使用的武器不对，难以施展" + name() + "。\n");
  //	if (target && target->query_temp("apply/shade_vision")) 
  //		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
  if ((int)me->query_skill("force") < 2000)
    return notify_fail("你的内功火候不够，难以施展" + name() + "。\n");
  if ((int)me->query_skill("blade") < 5000)
    return notify_fail("你的基本刀法火候不够，难以施展" + name() + "。\n");
  if ((int)me->query_skill("moon-blade", 1) < 1000)
    return notify_fail("你的圆月弯刀还不到家，难以施展" + name() + "。\n");
  if (me->query_skill_mapped("blade") != "moon-blade")
    return notify_fail("你没有激发圆月弯刀，难以施展" + name() + "。\n");
  if ((int)me->query("max_neili") < 1000000)
    return notify_fail("你的内力修为还不够高。\n");
  if ((int)me->query("max_jingli") < 1000000)
    return notify_fail("你的精力修为还不够高。\n");
  if (me->query("jingli") < 10000)
    return notify_fail("你的精力不够，难以施展" + name() + "。\n");
  if (me->query("neili") < 10000)
    return notify_fail("你的真气不够，难以施展" + name() + "。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");
  if (target && !living(target))
    return notify_fail("对方都已经这样了，用不着这么费力吧？\n");
  //	if (!(int)me->query("breakup"))
  //		return notify_fail("你任督二脉未通,无法使用" + name() + "。\n"NOR);	
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  message_vision(HBWHT "$N贯通魔刀刀法，使出了圆月弯刀的绝学之精髓！\n" NOR, me, target);
  msg = HBRED "小楼一夜听春雨：圆月落，刀光起。纵横大地十万里。刀光寒如雪，何处听春雨？\n" NOR HIY "只听唰的一声，" + weapon->name() + HIY "出手了！一切只能以一个快字去形容，发生在肉眼难看清楚的高速下，\n"
    "$N" HIY "这一刀劈出时，好像也是直直的，但是这笔直劈出来的一刀，竟忽然闪起了一道弯弯的刀光。\n"
    "弯弯的刀，弯弯的刀光，开始时宛如一弯新月，忽然间就变成了一道飞虹。这一道弯弯的刀光闪起时，\n"
    +weapon->name() + HIY "上的妖异之气，使人为之震眩迷惑。\n" NOR;
  message_vision(msg, me, target);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 5, me);  //CD写法1
  ap = me->query("xyzx_sys/level") + me->query_skill(
    "moon-blade",
    1
  ) + me->query_skill("blade") + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");

  md = me->query_skill("moon-blade", 1);
  if (target->query_skill("lonely-sword", 1)) ly = target->query_skill("lonely-sword", 1);
  else ly = 0;
  damage = me->query_skill("blade", 1) + me->query("jiali") + me->query_skill("moon-blade", 1) * 4;
  damage = damage + random(damage);
  if (random(ap) > dp / 3) {
    if (random(me->query_skill("blade")) > target->query_skill("sword") && random(md) > ly) {
      me->add("neili", -2000);
      me->add("jingli", -2000);
      msg = HIR "当$n" HIR "感到$N" HIR "出手时，" + weapon->name() + HIR "早已挥出，化作满月时的月光，划过两丈的虚空劈向$n。\n"
        "$n" HIR "只感到周遭所有的气流和生气都似被$N" HIR "这惊天动地的一招吸个一丝不剩，一派生机尽绝，\n"
        "死亡和肃杀的骇人味儿。只听得轻轻的一声响，那道弯弯的刀光却还在，又弯弯地一转。然后美如月光的刀气消失了，\n"
        "所有的声音都沉寂，所有的动作都停顿。$N" HIR "还是像一瞬前那么样静静地站在那里，好像根本没有动过。可是$N"
        HIR "手里的" + weapon->name() + HIR "已经在滴着血。\n" NOR;
      message_vision(msg, me, target);
      if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(me, HIW "该绝招直接秒杀了敌人。\n" NOR);
      target->die(me);
    } else {
      target->receive_damage("qi", damage, me);
      target->receive_wound("qi", damage / 2, me);
      msg = HIR "结果$p" HIR "闪避不及，只觉得一股冰寒的刀气掠过全身，$n全身顿时鲜血淋漓！\n" NOR;
      message_vision(msg, me, target);
      if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
        me,
        HIW "该绝招对敌人气血的外伤为" + damage + "，内伤为" + damage / 2 + "。\n" NOR
      );
    }
  } else {
    me->addn("neili", -300);
    msg = CYN "可是$p" CYN "识破了$P" CYN "这一招，斜斜一跃避开。\n" NOR;
    message_vision(msg, me, target);
  }
  if ((int)me->query_skill("moon-blade", 1) > 2000) {
    msg = HIY "$N" HIY "刀气横空，刀光烁闪，连环七刀，每刀均令$n" HIY "不得不全神应付，\n"
      "每刀均是朴实古拙，偏又有，明月当空的感觉。\n"
      "且刀刀均针对$n" HIY "的身形变化，似是把$n" HIY "看通看透一般！\n" NOR;
    message_vision(msg, me, target);
    damage = me->damage_power(
      "blade",
      1
    ) + me->query("jiali") + me->query_skill("moon-blade", 1) * 2;
    damage = damage * 3 + random(damage * 3);
    if (random(ap) > dp / 3) {
      me->add("neili", -2000);
      me->add("jingli", -2000);
      target->receive_damage("qi", damage, me);
      target->receive_wound("qi", damage / 2, me);
      msg = HIR "霎时一股冰寒的刀气掠过全身，$n" HIR "全身顿时鲜血淋漓，摇摇欲倒！\n" NOR;
      message_vision(msg, me, target);
      if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
        me,
        HIW "该绝招对敌人气血的外伤为" + damage + "，内伤为" + damage / 2 + "。\n" NOR
      );
    } else {
      msg = CYN "$p" CYN "大吃一惊，也不招架，当即向后"
        "横移数尺，避开了$P" CYN "这一招。\n" NOR;
      message_vision(msg, me, target);
      me->add("neili", -100);
    }
  }
  if ((int)me->query_skill("moon-blade", 1) > 3000) {
    msg = HIC "$N凝神静气，刀影翻飞，天上地下幻化出两道刀光，将$n全方位封死，这就是圆月弯刀至高无上的绝技" HIY "「刀至上，至上刀」\n" NOR;
    message_vision(msg, me, target);
    damage = me->query_skill(
      "blade",
      1
    ) + me->query_skill("moon-blade", 1) * 2 + me->query("jiali");
    if (objectp(weapon2 = target->query_temp("weapon"))) {
      msg = HBYEL "$N" HBYEL "双手持刀，一跃而起，劲运刀身，划出一道完美的弧线，一股刀劲" HBYEL "如一轮新月袭向$n。\n" NOR;
      message_vision(msg, me, target);
      if (random(ap) > dp / 3) {
        me->add("neili", -500);
        msg = HIR "$n" HIR "暗叫不好，连忙举起手中兵器抵挡，却不想虎口剧痛，手中" + weapon2->name() + HIR "捏不住，脱手而出。\n" NOR;
        message_vision(msg, me, target);
        weapon2->move(environment(me));
      } else {
        me->add("neili", -500);
        msg = CYN "$n" CYN "提升十成功力，头上青筋暴出，紧握手中" + weapon2->name() + CYN "硬是将$N" CYN "的劲气抵挡化解了。\n" NOR;
        message_vision(msg, me, target);
      }

    }

    msg = HBBLU "霎时间$N" HBBLU "身法变得飘忽，不知何时已闪至$n的身前，一招" HIY "「刀至上」\n" NOR + HBBLU "刀尖由下至上划出一个形如满月的气劲飞向$n，誓要把$n一分两半" HBBLU "。\n" NOR;
    message_vision(msg, me, target);
    if (random(ap) > dp / 3) {
      damage = damage * 6 + random(damage * 6);
      target->receive_damage("jing", damage, me);
      target->receive_wound("jing", damage / 2, me);
      msg = HIR "$n" HIR "只觉呼吸紧迫，一股劲风扑面而来，根本避无所避，被$N的劲气袭中全身，各大穴道血气翻腾，血入箭般喷出。\n" NOR;
      message_vision(msg, me, target);
      me->add("neili", -2000);
      me->add("jingli", -2000);
      if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
        me,
        HIW "该绝招对敌人气血的外伤为" + damage + "，内伤为" + damage / 2 + "。\n" NOR
      );
    } else {
      msg = CYN "$n" CYN "眼见$N" CYN "来势汹涌，丝毫不敢小觑，急忙闪在了一旁。\n" NOR;
      message_vision(msg, me, target);
      me->add("neili", -200);
    }


    msg = HBMAG "紧跟着$N" HBMAG "跃向空中，另一杀招" HIB "「至上刀」" NOR + HBMAG "手中刀狂舞，一瞬间天空中多出了无数个满月，一起向$n" HBMAG "飞去。\n" NOR;
    message_vision(msg, me, target);

  }
  if ((int)me->query_skill("moon-blade", 1) > 4000) {
    if (random(ap) > dp / 3) {
      msg = HIR "$n" HIR "面对$N" HIR "这排山倒海般的攻势，完全无法抵挡，招架散乱，连连退后。\n" NOR;
      message_vision(msg, me, target);
      count = ap / 2;
    } else {
      msg = HIC "$n" HIC "心底微微一惊，心知不妙，急忙凝聚心神，竭尽所能化解$N" HIC "数道刀劲。\n" NOR;
      message_vision(msg, me, target);
      count = ap / 5;
    }


    me->add_temp("apply/attack", count);
    me->add_temp("apply/damage", count);

    for (i = 0; i < 12; i++) {
      if (!me->is_fighting(target))
        break;
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
    }
    me->add("neili", -1000);
    me->add_temp("apply/attack", -count);
    me->add_temp("apply/damage", -count);
  }
  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
