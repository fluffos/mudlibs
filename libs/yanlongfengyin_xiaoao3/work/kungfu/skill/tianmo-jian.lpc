int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }

int valid_combine(string combo) { return combo=="tianmo-dao"; }

int valid_learn(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if (me->query("family/family_name")!="日月神教")
		return notify_fail("你不是本门中人，无法学习本门技能。\n");	
	if ((int)me->query("max_neili") < 10000)
		return notify_fail("你的内力不够。\n");
	if ((int)me->query_skill("tianmo-shengong", 1) < 500)
		return notify_fail("你的天魔神功火候太浅。\n");
	if ((int)me->query_skill("sword", 1) < (int)me->query_skill("tianmo-jian", 1))
		return notify_fail("你的剑法基础太差。\n");
	return 1;
}

string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
	int ap,dp,damage2,level;
	level = (int)me->query_skill("tianmo-shengong",1);  
	ap = (int) me->query("str",1) * (int) me->query_skill("tianmo-jian",1);
	dp = (int) victim->query("dex",1) * (int) me->query_skill("parry",1);
	damage2 = (int)me->query_skill("tianmo-jian",1);
    if( damage_bonus < 100 ) return 0;
	if ( me->query_skill("tianmo-shengong",1) < 100)	 return 0;
	if ( me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "tianmo-shengong") return 0;	
	if (damage2<10) damage2=10;		
	if (random(5) == 0 && (int)me->query_skill("tianmo-jian",1) > 300 && me->query("neili") > 500 && random(ap)>dp/10 && me->query("jiali")>0)
	{
		me->add("neili", -100 );
		victim->receive_wound("qi", damage2*2+damage_bonus ,me);
		victim->receive_damage("qi", damage2*2+damage_bonus ,me); 
		me->receive_damage("qi", level,victim); 
		return HIY"$N默运天魔解体大法，剑气暴涨，只见$n一着不慎，血冒三丈。\n"NOR;		
	}
}

int practice_skill(object me)
{
        object weapon;
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
        if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
                return notify_fail("你使用的武器不对。\n");
        if ((int)me->query("qi") < 50)
                return notify_fail("你的体力不够练天魔剑法。\n");
	if (me->query("family/family_name")!="日月神教")
		return notify_fail("你不是日月神教弟子，不能练习本门武功。\n");
	if ((int)me->query_skill("sword", 1) < (int)me->query_skill("tianmo-jian", 1))
		return notify_fail("你的剑法基础太差。\n");
        me->receive_damage("qi", 25);
        return 1;
}
string perform_action_file(string action)
{
        return __DIR__"tianmo-jian/" + action;
}

