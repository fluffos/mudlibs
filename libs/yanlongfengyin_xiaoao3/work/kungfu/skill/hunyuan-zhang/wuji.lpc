// wuji.c 混元无极

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;

int perform(object me, object target) {
  string msg;
  int skill, ap, dp, neili_wound, damage;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("「混元无极」只能对战斗中的对手使用。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");
  if (objectp(me->query_temp("weapon")))
    return notify_fail("你使用了武器。\n");
  if (target && target->query_temp("apply/shade_vision"))
    return notify_fail("对方隐身了，你看不到" + target->query("name") + "。\n");
  if (me->query_skill("hunyuan-zhang", 1) < 300)
    return notify_fail("你的「混元掌」等级不够, 不能使用「混元无极」！\n");
  if (me->query("neili") < 1000)
    return notify_fail("你的内力不够，无法运用「混元无极」！\n");
  if (me->query("max_neili") < 100000)
    return notify_fail("你的内力修为不够，无法运用「混元无极」！\n");
  if ((int)me->query("jingli") < 1000)
    return notify_fail("你的精力不够。\n");
  if ((int)me->query_skill(
    "zixia-shengong",
    1
  ) < 300 || me->query_skill_mapped("force") != "zixia-shengong")
    return notify_fail("你的本门内功还不到家，无法使用本门绝技！\n");
  if (me->query_skill_mapped("unarmed") != "hunyuan-zhang")
    return notify_fail("你没正确激发该技能 。\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  skill = me->query_skill("hunyuan-zhang", 1);
  msg = HIC "$N潜运「混元无极」，双拳挟着隐隐的风雷之声向$n击去。\n" NOR;
  message_vision(msg, me, target);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1
  ap = me->query("xyzx_sys/level") + me->query_skill(
    "hunyuan-zhang",
    1
  ) + me->query_skill("unarmed") + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
  if (random(ap) > dp / 3) {
    me->add("neili", -100);
    msg = HIG "$n只觉得胸前一阵剧痛，“哇”的一声喷出一口鲜血！\n" NOR;
    message_vision(msg, me, target);
    neili_wound = 100 + skill + random(skill);
    damage = neili_wound * 3;
    target->add("neili", -neili_wound);
    target->receive_damage("qi", damage, me);
    if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
      me,
      HIW "该绝招对敌人气血的外伤为" + damage + "，杀内力" + damage + "。\n" NOR
    );
    //      if (!target->is_busy()) target->start_busy(2);
  } else {
    msg = HIG "只见$n不慌不忙，轻轻一闪，躲过了$N的必杀一击！\n" NOR;
    message_vision(msg, me, target);
    me->add("neili", -100);
  }

  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
