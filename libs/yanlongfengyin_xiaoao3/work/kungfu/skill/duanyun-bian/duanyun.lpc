// duanyun.c 断云止雾

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>


inherit F_SSERVER;

int perform(object me, object target)
{
	object weapon;
	string msg;
	int skill,damage;
	
	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("「断云止雾」只能在战斗中使用。\n");
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "whip")
		return notify_fail("「断云止雾」开始时必须拿着鞭子！\n");
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");
	if( (int)me->query("neili") < 1000 )
		return notify_fail("你的真气不够！\n");
	if( (int)me->query("jingli") < 1000 )
		return notify_fail("你的精力不够。\n");	
	if( (int)me->query_skill("duanyun-bian",1) < 300 )
		return notify_fail("你的断云鞭法还不到家，无法使用「断云止雾」！\n");
	if (me->query_skill_mapped("whip") != "duanyun-bian")
		return notify_fail("你没正确激发该技能 。\n");
	if( me->query_skill("xiantian-qigong",1) < 300 || me->query_skill("tiangang-zhengqi")<300)
		return notify_fail("你的本门内功火候不够，无法使用「断云止雾」！\n");
	if( me->query_skill_mapped("force",1) != "tiangang-zhengqi" && me->query_skill_mapped("force",1) != "xiantian-qigong")	
		return notify_fail("你不使用本门内功，无法使用本门绝技！\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	msg = YEL "$N使出全真派绝技「断云止雾」，身法陡然加快,手握鞭子晃成三条白龙！\n" NOR;
	message_vision(msg, me,target);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1
	
	skill = (int)me->query_skill("duanyun-bian",1);
	damage = (int)me->query_skill("duanyun-bian",1)*2 + (int)me->query_skill("whip",1);
	damage = damage + random(damage);
	
        me->add_temp("apply/damage", skill);
        me->add_temp("apply/attack", skill);
	msg = WHT  "赤血金龙！" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
	msg = WHT  "化血银龙！" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
	msg = WHT "怒血毒龙！" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        me->add_temp("apply/damage", -skill);
        me->add_temp("apply/attack", -skill);
		
		target->receive_damage("qi", damage,me);
		target->receive_wound("qi", damage,me);		
	if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage +"。\n" NOR);
	me->add("neili", -100);
	  me->start_busy(1);

	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}