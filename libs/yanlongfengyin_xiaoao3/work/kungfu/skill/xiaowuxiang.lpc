// xiaowuxiang.c 小无相功
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit FORCE;
int valid_enable(string usage) {
  return usage == "force";
}
int valid_learn(object me) {
  mapping skl;
  string *sname;
  int lvl = (int)me->query_skill("xiaowuxiang", 1);
  int i;

  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
  if (me->query("family/family_name") != "逍遥派" && me->query("family/family_name") != "雪山寺")
    return notify_fail("你的门派似乎不适合学习小无相功。\n");
  if ((int)me->query_skill("force", 1) < 100)
    return notify_fail("你的基本内功火候不足，不能学小无相功。\n");
  if (me->query("gender") == "无性" && lvl > 49)
    return notify_fail("你无根无性，阴阳不调，难以领会高深的小无相功。\n");
  if (me->query_skill("force", 1) <= lvl)
    return notify_fail("你的基本内功基础不够，再学下去会走火入魔的。\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");

  skl = this_player()->query_skills();
  sname = keys(skl);
  for (i = 0; i < sizeof(skl); i++) {
    if (sname[i] == "xiaowuxiang") continue;
    if (sname[i] == "xixing-dafa") continue;
    if (sname[i] == "yijing-force") continue;
    if (sname[i] == "longxiang") continue;
    if (sname[i] == "beiming-shengong") continue;
    if (sname[i] == "bahuang-gong") continue;
    if (SKILL_D(sname[i])->valid_enable("force"))
      return notify_fail("你不先散了别派内功，怎能学小无相功。\n");
  }
  if (random(100) == 1) me->add("score", -5);
  return 1;
}
int practice_skill(object me) {
  return notify_fail("小无相功只能用学(learn)的来增加熟练度。\n");
}
string exert_function_file(string func) {
  return __DIR__ "xiaowuxiang/" + func;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  int ap, dp, damage2;
  damage2 = (int)me->query_skill("xiaowuxiang", 1);
  ap = me->query_skill("xiaowuxiang", 1);
  dp = victim->query_skill("force", 1);
  if (damage_bonus < 100) return 0;
  if (me->query_skill("xiaowuxiang", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "xiaowuxiang") return 0;
  if (damage2 < 10) damage2 = 10;

  if (random(ap) > dp / 20 && random(6) == 0 && me->query("jiali") > 0) {
    victim->receive_damage("qi", damage2 + 100 + damage_bonus / 2, me);
    victim->receive_wound("qi", damage2 + 100 + damage_bonus / 2, me);
    me->add("neili", -100);
    return HIR "$N幻化出法相，低吟道：万物幻化，变化由心！无相我相，相由心生！\n" NOR;
  }
}

mapping exercise_msg(object me) {
  return ([
    "status_msg": "口中禅唱入耳，宝象庄严。\n",
    "start_my_msg": "盘膝坐下，双手合十，口诵佛祖真言，周身佛光隐现。\n",
    "start_other_msg": me->name() + "盘膝坐下，双手合十，口诵佛祖真言，周身佛光隐现。\n",
    "heal_my_msg": "口吐佛祖真言，缭绕不散，周身佛光隐现，背后如来法相渐渐清晰。\n",
    "heal_other_msg": me->name() + "口吐佛祖真言，缭绕不散，周身佛光隐现，背后如来法相渐渐清晰。\n",
    "halt_msg": "长出一口气，将内息急速退了回去，站了起来。\n",
    "end_my_msg": "睁开双眼，缓缓站起，周围佛光汇聚丹田。\n",
    "end_other_msg": me->name() + "周身佛光不断汇聚丹田，待法相入体，" + me->name() + "睁开双眼，缓缓站起。\n",
    "hover_my_msg": "佛祖真言铮铮入耳，佛光逐渐清晰。过了良久，如来法相入体，佛光也渐渐淡了。\n",
    "hover_other_msg": me->name() + "只觉佛祖真言铮铮入耳，佛光逐渐清晰。过了良久，如来法相入体，佛光也渐渐淡了。\n",
  ]);
}
