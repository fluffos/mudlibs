int valid_enable(string usage)
{
        return usage=="sword" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}

string query_parry_msg(string limb)
{
        return parry_msg[random(sizeof(parry_msg))];
}

int valid_learn(object me)
{
        object ob;

        mapping myfam;
        myfam = (mapping)me->query("family");
		
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
	if(!myfam || myfam["family_name"] != "圣剑魔宫"|| myfam["master_id"] != "a fei")	
		return notify_fail("独孤九剑只有向圣剑魔宫阿飞学习。\n");	
	if( (int)me->query("max_neili") < 6000 )
		return notify_fail("你的内力不够，没有办法练独孤九剑。\n");
	if( !(ob = me->query_temp("weapon")) || (string)ob->query("skill_type") != "sword" )
		return notify_fail("你必须先找一把剑才能练剑法。\n");
    if ((int)me->query("int",1) < 30)
        return notify_fail("以你的悟性难以领悟独孤剑意。\n");				
	if ((int)me->query_skill("lonely-sword",1) > 300)
		return notify_fail("这套剑法我就教到这儿，以后就要靠你自己练了。\n");
    if ((int)me->query_skill("sword", 1) < 5000)		
        return notify_fail("你的基础剑法不够深厚，无法支持独孤剑意。\n");			
	if ((int)me->query("score",1) < 10000)
		return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
	if (random(10)==1) me->add("score",-10);	
        return 1;
}

int practice_skill(object me)
{
        return notify_fail("独孤九剑只能通过"+(order[random(13)])+"「问魂式」"NOR"来演练。\n");
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb)
{       
    int jiali,damage2,ap,dp;
	object weapon;
	weapon = me->query_temp("weapon");
	jiali = me->query("jiali");
	damage2 = (int)me->query_skill("lonely-sword",1) + (int)me->query_skill("sword",1);
	ap = (int)me->query_skill("lonely-sword",1);
	dp = (int)victim->query_skill("parry",1);
    if (random(me->query_skill("lonely-sword",1)) < 100 || me->query_skill("force",1) < 100 ) return 0;
	
    if (random(me->query_skill("lonely-sword",1)) > 200 
		&& random(me->query_skill("sword",1))>300 
		&& me->query_skill("force",1) > 250 
		&& me->query("jiali") > 0
		&& random(8) == 0 )
	{
        me->add("neili", -100 );
        victim->map_skill("dodge");	//下特殊轻功
//        if (!victim->is_busy()) victim->start_busy(random(3)+1);
        message_vision(HIC "$N突然举剑一刺，剑招随便无章，却莫明奇妙地突破了$n的攻势，大出$n意料！" NOR, victim,me  );
        return HIR"$n大吃一惊，竟然忘了闪避！\n"NOR;       
	}
    if (random(me->query_skill("lonely-sword",1)) > 300 
		&& random(me->query_skill("sword",1))>300 
		&& me->query_skill("force",1) > 200 
		&& me->query("jiali") > 0
		&& random(8) == 1 )	
	{
        me->add("neili", -100 );
        victim->map_skill("parry");	//下特殊招架
//        if (!victim->is_busy()) victim->start_busy(random(3)+1);
        message_vision(HIC "$N举剑反攻，后发先至地刺向$n，不仅把$n招术封死，更进一步发出攻击！" NOR, victim,me);
        return HIY"$n难以看清剑招来势,竟然忘了招架！\n"NOR;
	} 
    if (random(me->query_skill("lonely-sword",1)) > 400 
		&& random(me->query_skill("sword",1))>300 
		&& me->query_skill("force",1) > 150 
		&& me->query("jiali") > 0
		&& random(8) == 2 )
	{
        me->add("neili", -100 );
//        if (!victim->is_busy()) victim->start_busy(random(3)+1);
		victim->map_skill("unarmed");	//下特殊拳脚
        message_vision(HIC "$N提剑回刺，落点正是$n的破绽，$n不得不撤招严守，身形一晃间已退出丈许！" NOR, victim,me );
        return HIG"$n手忙脚乱，慌乱不堪，竟然忘了使用拳脚！\n"NOR;
	} 
    if (random(me->query_skill("lonely-sword",1)) > 150 
		&& random(me->query_skill("sword",1))>200 
		&& me->query_skill("force",1) > 120 
		&& me->query("jiali") > 0
		&& random(8) == 3  )	
	{
        victim->add("neili", -damage2);	//破内力
		me->add("neili", -100 );
//        if (!victim->is_busy()) victim->start_busy(random(3)+1);		
        message_vision(HIC "$N一转剑势，剑招源源而出，连续攻向$n周身大穴！\n" NOR, victim,me );
		return HIM"$n只觉得气海穴一痛，浑身真气一泻而出！\n"NOR;
	}
    if (random(me->query_skill("lonely-sword",1)) > 250 
		&& random(me->query_skill("sword",1))>200 
		&& me->query_skill("force",1) > 100 
		&& me->query("jiali") > 0
		&& random(8) == 4
		&& !victim->is_busy())	
	{
        if (!victim->is_busy()) victim->start_busy(random(10)+3);	//busy对方
		me->add("neili", -100 );
        message_vision(HIC "$N眼见避无可避，只好提剑乱刺一通，居然出乎意料地将$n的攻击接去大半。" NOR, victim,me );
		return HIW"$n顿时手足无措，不知如何是好！\n"NOR;
	} 
	
	if( damage_bonus > 100 
		&& random(me->query_skill("lonely-sword",1))>100  
		&& random(8) == 5 
		&& me->query("jiali") > 0) 
	{
		victim->receive_wound("qi", damage2 + jiali+damage_bonus/2,me );	//伤气血上限
		return HIM"$N剑气纵横! 一道剑气划过了$n的$l。结果鲜血狂奔!\n"NOR;
	}
}

string perform_action_file(string action)
{
        return __DIR__"lonely-sword/" + action;
}

	//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{
	object weapon = me->query_temp("weapon");
        string msg,dodge_skill,*limbs;
        int i, j, ap,dp, p, q;
        
	if ((int)me->query("qi")>1 && (int)me->query("eff_qi")>1)
	{
		i = (int)me->query("max_qi") / (int)me->query("eff_qi") ;
		if ( i < 1 ) i = 1;
        if ( i > 10 ) i = 10;
	}
	else i=1;
        limbs = ob->query("limbs");
        ap = me->query_skill("lonely-sword", 1);
		dp = ob->query_skill("dodge", 1);
        if( me->is_busy()) return 1;
	if (damage <10)  damage=10;  
        if (  random(ap) > dp/10
         && me->query_skill_mapped("sword") =="lonely-sword"
         && me->query_skill_mapped("parry") =="lonely-sword"
         && me->query("fengset")
         && weapon
         && weapon->query("skill_type") == "sword"
         && me->query_skill("sword") > 300
         && random(me->query_skill("lonely-sword",1)) > 150
         && !me->is_busy()
         && me->query("neili") > 200 
         && me->query("max_neili") > 4000
         && random(me->query_int()) >= 20 )
		{
            me->add("neili", -100);
            msg = HIW"$N身子摇摇欲坠，行动不便，知道这一招无可躲避，当即挺剑刺出，后发先至，噗的一声刺向$n的咽喉。\n"NOR;
            if ( random(6) ==1 )
			{
             q = damage * i ;
             if ( q > 3500 ) q = 3500 + ( q - 3500 )/ 100;
             ob->receive_damage("qi", q,me);
             ob->receive_wound("qi", q/3,me);
             if (!ob->is_busy()) ob->start_busy(2+random(2));
             if ( random(me->query("xyzx_sys/level")) > ob->query("xyzx_sys/level") / i)
             p = ob->query("qi")*100/ob->query("max_qi");
             msg += damage_msg(damage, "刺伤") + "( $n"+eff_status_msg(p)+" )\n";
             msg = replace_string(msg, "$l", limbs[random(sizeof(limbs))]);
             msg = replace_string(msg, "$w", "剑刃");
             j = -(damage*2+random(damage*2));
            }
            else 
			{
              dodge_skill = ob->query_skill_mapped("dodge");
             if( !dodge_skill ) dodge_skill = "dodge";
            msg += SKILL_D(dodge_skill)->query_dodge_msg(ob, 1);
              j = -(damage+random(damage));
            }
            message_vision(msg, me, ob);
            return j;
        }
}
