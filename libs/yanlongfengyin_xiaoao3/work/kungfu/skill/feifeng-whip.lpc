int valid_enable(string usage) { return (usage == "whip") || (usage == "parry"); }

int valid_learn(object me)
{
	object weapon;
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if ((int)me->query_skill("kumu-shengong", 1) < 100)
		return notify_fail("你的枯木神功火候太浅。\n");
	if ((int)me->query("per", 1) < 25)
		return notify_fail("人丑鞭子舞的再好看也没用。\n");
	if ( me->query("gender") != "女性")
		return notify_fail("大老爷们学这飞凤鞭？天资不足吧。\n");
    if (me->query("family/family_name")!="大理段家")
   return notify_fail("你不加入大理段家，无法学习飞凤鞭。\n");	
	if ( !objectp(weapon = me->query_temp("weapon"))
	|| ( string)weapon->query("skill_type") != "whip" )
		return notify_fail("你必须先找一条长鞭才能练鞭法。\n");

	return 1;
}

string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me)
{
	object weapon;
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if ( me->query("gender") != "女性")
		return notify_fail("大老爷们学这飞凤鞭？天资不足吧。\n");
	if (!objectp(weapon = me->query_temp("weapon"))
	|| (string)weapon->query("skill_type") != "whip")
		return notify_fail("你使用的武器不对。\n");
	if ((int)me->query("qi") < 50)
		return notify_fail("你的体力不够练飞凤鞭法。\n");
	    if (me->query("family/family_name")!="大理段家")
   return notify_fail("你不是大理段家弟子，练习不了飞凤鞭法。\n");
	me->receive_damage("qi", 10);
	return 1;
}


mixed hit_ob(object me, object victim, int damage_bonus)
{

		int ap,dp,damage2;
        int level= (int) me->query_skill("feifeng-whip",1);  
		ap = (int) me->query("dex",1) * (int) me->query_skill("feifeng-whip",1);
		dp = (int) victim->query("dex",1) * (int) me->query_skill("parry",1);
	damage2 = (int)me->query_skill("feifeng-whip",1);
    if( damage_bonus < 100 ) return 0;
	if ( me->query_skill("kumu-shengong",1) < 100)	 return 0;
	if ( me->query("neili") < 100 || me->query_skill_mapped("force") != "kumu-shengong") return 0;	
	if (damage2<10) damage2=10;		
        if (random(5) == 0 && level > 300 && me->query("neili") > 500 && random(ap)>dp/10 && me->query("jiali")>0)
		{
           message_vision(HIY"$N的鞭子使的如凤凰飞舞，煞是好看！。\n"NOR, me, victim);  
           me->add("neili", -100 );
 //          if (!victim->is_busy()) victim->start_busy(1+random(2));
           message_vision(CYN"$n被$N的飞凤羽衣舞吸引，不自觉意淫起来！。\n"NOR, me, victim);  
		   victim->receive_wound("qi", damage2+damage_bonus/2,me);
		   victim->receive_damage("qi", damage2+damage_bonus/2,me );

        }
         return;
}


string perform_action_file(string action)	
{
return __DIR__"feifeng-whip/" + action;	
}


