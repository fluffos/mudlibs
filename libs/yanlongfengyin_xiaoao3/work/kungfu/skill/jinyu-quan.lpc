int valid_enable(string usage) { return usage=="cuff" || usage=="unarmed"|| usage=="parry"; }

int valid_combine(string combo) { return combo=="jinyu-quan"; }

int valid_learn(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if ((int)me->query_skill("kumu-shengong",1) < 100)
		return notify_fail("你的枯木神功火候不够，无法练金玉拳。\n");
    if (me->query("family/family_name")!="大理段家")
   return notify_fail("你不是大理段家弟子，无法学习大理段家技能。\n");		
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练金玉拳必须空手。\n");
	if ((int)me->query("max_neili") < 10000)
		return notify_fail("你的内力太弱，无法练金玉拳。\n");
	return 1;
}
mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if ((int)me->query("qi") < 50)
		return notify_fail("你的体力太低了。\n");
	if ((int)me->query("neili") < 20)
		return notify_fail("你的内力不够练金玉拳。\n");
    if (me->query("family/family_name")!="大理段家")
   return notify_fail("你不是大理段家弟子，偷学大理武功会被通缉。\n");		
	me->receive_damage("qi", 30);
	me->add("neili", -10);
	return 1;
}


mixed hit_ob(object me, object victim, int damage_bonus)
{

		int ap,dp,level,damage2;
        level = (int) me->query_skill("jinyu-quan",1);  
		ap = (int) me->query("con",1) * (int) me->query_skill("jinyu-quan",1);
		dp = (int) victim->query("con",1) * (int) me->query_skill("parry",1);
	damage2 = (int)me->query_skill("jinyu-quan",1);
    if( damage_bonus < 100 ) return 0;
	if ( me->query_skill("kumu-shengong",1) < 100)	 return 0;
	if ( me->query("neili") < 100 || me->query_skill_mapped("force") != "kumu-shengong") return 0;	
	if (damage2<10) damage2=10;		
        if (random(5) == 0 && level > 300 && me->query("neili") > 500 && random(ap) > dp/10 && me->query("jiali")>0)
		{
           message_vision(HIY"$N使出一招 「金玉其外，败絮其中」。\n"NOR, me, victim);   
           me->add("neili", -100 );
 //          if (!victim->is_busy()) victim->start_busy(random(5));
           message_vision(CYN"$n以为这招中看不中用，结果$N虚则实之实则虚之，$n如中败絮！。\n"NOR, me, victim);   
		   victim->receive_wound("qi", damage2 +damage_bonus/2,me);
		   victim->receive_damage("qi", damage2+damage_bonus/2,me);

        }
        
         return;
}


string perform_action_file(string action)	
{
return __DIR__"jinyu-quan/" + action;	
}


