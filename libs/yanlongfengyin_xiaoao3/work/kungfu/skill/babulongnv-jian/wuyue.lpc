// maze.c 五岳倒为轻

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>
inherit F_SSERVER;
int perform(object me,object target)
{
	object weapon;
	int damage,ap,dp;

	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("「五岳倒为轻」只能对战斗中的对手使用。\n");
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对。\n");	
//	if (target && target->query_temp("apply/shade_vision")) 
//		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");
    if( (int)me->query("neili") < 1000 )
        return notify_fail("你的真气不够。\n");
	if( (int)me->query("jingli") < 1000  )
		return notify_fail("你的精力不够。\n");
	if( (int)me->query("max_jingli") < 200000  )
		return notify_fail("你的精力修为不够。\n");
	if( (int)me->query_skill("qimen-wuxing",1) < 1000  )
		return notify_fail("你的奇门五行不够。\n");
	if( (int)me->query_skill("babulongnv-jian",1) < 1000  )
		return notify_fail("你的八部龙女剑不够。\n");
	if( me->query_skill("zixia-shengong", 1) < 1000 && me->query_skill("hanbing-zhenqi", 1) < 1000 )		
		return notify_fail("你的五岳派内功修为火候未到，还未领悟「五岳倒为轻」！\n");
	if ( me->query_skill_mapped("sword") != "babulongnv-jian" )
        return notify_fail("你必须激发八部龙女剑为剑法才能使用「五岳倒为轻」！\n"); 	
	if ( me->query_skill_mapped("force") != "zixia-shengong" && me->query_skill_mapped("force") != "hanbing-zhenqi" )
        return notify_fail("你必须激发五岳派内功才能使用「五岳倒为轻」！\n"); 	
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	damage = (int)me->query_skill("babulongnv-jian", 1)*5;
	ap = me->query("xyzx_sys/level") + me->query_skill("babulongnv-jian", 1) + me->query_skill("sword") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	message_vision(HIG "$N脚下缓缓踩着九宫八卦方位，口中念念有词，使出移山倒海大法......\n"NOR, me,target);

	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1	
	message_vision( HIC "$N挥剑向$n一指，高歌一声：三杯吐然诺，五岳倒为轻。\n" NOR, me,target);	
	message_vision(HIM "$N剑光斗长，射出无数如丝一般的剑气，绵绵不决的向$n缠绕过去。\n"NOR, me, target);
	if (random(ap)>dp/3)
	{
		message_vision(HIC " 结果$n被$N射出的丝般剑气包裹在其中，动弹不得。\n" NOR, me, target);
		damage = damage+random(damage);
		target->receive_damage("qi", damage,me);
		target->receive_wound("qi", damage,me);		
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage +"。\n" NOR);
		if (me->query_skill_mapped("force") != "zixia-shengong") target->apply_condition("no_perform", 10);
		if (me->query_skill_mapped("force") != "hanbing-zhenqi") target->apply_condition("cold_poison", 10);
		me->add("jingli", -200);
	}
	else
	{
		message_vision(HIM "$n大吃一惊，知道其中历害，连忙跳了出来。\n" NOR, me,target);
	}
	
	if (living(target) && random(ap) > dp/3)
	{
		message_vision(HIM "$n眼前一黑，五座大山劈头盖脸的压了下来，轰的一声巨响。。。。。。\n"NOR
		+HIR"嗖的一声，$n被砸的晕头转向，不知所踪！！！\n" NOR, me,target);
		if (random(12)==0)
			target->move("/d/dali/nandajie3");
		else if (random(12)==1)
			target->move("d/shushan/feipu");
		else if (random(12)==2)
			target->move("/d/lingxiao/dilao");
		else if (random(12)==3)
			target->move("/d/xiakedao/shiroom24");
		else if (random(12)==4)
			target->move("/d/heimuya/house1");
		else if (random(12)==5)
			target->move("/d/heimuya/guifang");
		else if (random(12)==6)
			target->move("/d/city/guangchang");
		else if (random(12)==7)
			target->move("/d/city2/xisi");
		else if (random(12)==8)
			target->move("/d/city3/guangchang");
		else if (random(12)==9)
			target->move("/d/automap4/fuben100");
		else if (random(12)==10)
			target->move("/d/automap5/fuben100");
		else if (random(12)==11)
			target->move("/d/death/gate");
		else
			target->move("/d/automap6/fuben100");
		
		if (!target->is_busy()) target->start_busy(5);
	}

	me->add("jingli", -500);			
	me->start_busy(1);
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}