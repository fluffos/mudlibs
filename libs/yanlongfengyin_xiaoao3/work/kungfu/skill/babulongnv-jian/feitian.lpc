// feitian.c 「总诀式」

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;

int perform(object me)
{
	string msg;
	object weapon;
	int skill, jing_cost,xtint,addtime,jineng_exp_add;
	float flag;

	skill = me->query_skill("babulongnv-jian",1);
	xtint = me->query("int",1);
	jing_cost = me->query_skill("babulongnv-jian",1);
	
	if( me->is_fighting() )
		return notify_fail("「八部飞天」不能在战斗中演练。\n");
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
		return notify_fail("你必须先去找一把剑。\n");
	if (me->query("family/family_name")!="华山派" 
	&& me->query("family/family_name")!="嵩山派" 
	&& me->query("family/family_name")!="泰山派"
	&& me->query("family/family_name")!="衡山派"
	&& me->query("family/family_name")!="恒山派")
		return notify_fail("你不是五岳派的弟子，无法演练八部龙女剑。\n");
	if ( me->query_skill_mapped("sword") != "babulongnv-jian" )
        return notify_fail("你必须激发八部龙女剑为剑法！\n"); 
	if( me->query_skill("babulongnv-jian",1) < 100 )
		return notify_fail("你的八部龙女剑基础太低了吧！\n");
	if( me->query_skill("babulongnv-jian",1) > me->query_skill("sword",1) )
		return notify_fail("你的剑法基础太低了吧！\n");	
	if( me->query("neili") < jing_cost )
		return notify_fail("你的内力不够，没有力气演练「八部飞天」！\n");
	if( me->query("max_neili") < 100000 )
		return notify_fail("你的内力修为不够，无法演练「八部飞天」！\n");
	if( me->query("max_jingli") < 100000 )
		return notify_fail("你的精力修为不够，无法演练「八部飞天」！\n");
	if( me->query("jingli") < jing_cost )
		return notify_fail("你现在太累了，无法集中精神演练「八部飞天」！\n");
    if( skill>(me->query("xyzx_sys/level")+300)*2 )
        return notify_fail("你的实战经验不够，无法演练「八部飞天」！\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	msg = HIC "$N使出八部龙女剑之「八部飞天」，手中" + weapon->name() + ""HIC"围着自己不停绕动。\n";
	message_vision(msg, me);
	if ( me->query_exp_times() > 1 ) addtime = 2;
	else addtime = 1;
	if(me->query("xyhy_type")==2) flag = 1.25;	//2016.6.20阿飞改，黄金会员自练速度为1.25倍
	else flag = 1;
	if (me->query_temp("jineng_exp_add")) jineng_exp_add = (int)me->query_temp("jineng_exp_add",1);	//处于技能自练提升状态时
	else jineng_exp_add = 0;		
	me->add("neili", -random(jing_cost));
	me->add("jingli",-random(jing_cost));
	me->improve_skill("babulongnv-jian", 100 + (int)me->query_int(1)*(jineng_exp_add+100)/100*xtint*3*addtime*flag*8/10,0);
	msg = MAG"$P的「八部龙女剑法」进步了！\n"NOR;
	message_vision(msg, me);	
	me->start_busy(1);
	return 1;
}

