int valid_enable(string usage) { return usage == "blade"|| usage=="parry"; }
int valid_learn(object me)
{
    object weapon;
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
    if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
    if (!objectp(weapon = me->query_temp("secondary_weapon"))
    || (string)weapon->query("skill_type") != "blade")
        return notify_fail("你还是先找把刀来吧。\n");
	if ((int)me->query("str",1) < 25)
		return notify_fail("你的手无缚鸡之力，拿不了刀。\n");
    if ((int)me->query("max_neili") < 20000)
        return notify_fail("你的内力不够。\n");
    if (me->query_skill("blade", 1)<=me->query_skill("tianxin-blade",1))
        return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
       if ((int)me->query_skill("lingyuan-xinfa", 1) < 100)
        return notify_fail("你的灵元心法火候太浅。\n");
    if (me->query("family/family_name")!="玄天派")
   return notify_fail("你不是玄天派弟子，没法学习。\n");	
 //       if (me->query("family/master_id")!="wuming laoren")
//        return notify_fail("天行刀法乃是无名老人的得意武功，你只能找他学习。\n");
    if ((int)me->query_skill("tianxin-blade",1) > 1000)
        return notify_fail("这套刀法我就教此处，你今后在这套刀法上的成就就要看你自己了。\n");
	if ((int)me->query("score",1) < 5000)
		return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
	if (random(100)==1) me->add("score",-5);		
     return 1;
}


mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
      object weap,weap1;
	  int ap,dp,damage2;
      weap = victim->query_temp("weapon");
      weap1 = me->query_temp("weapon");
	ap = me->query_skill("tianxin-blade",1);
	dp = victim->query_skill("force",1);	  
	damage2 = (int)me->query_skill("tianxin-blade",1);	
	if (me->query("jm/xuantian")) damage2 = me->query_skill("tianxin-blade",1) + me->query_skill("blade",1);
    if( damage_bonus < 100 ) return 0;
	if ( me->query_skill("lingyuan-xinfa",1) < 100)	 return 0;
	if ( me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "lingyuan-xinfa") return 0;	
	if (damage2<10) damage2=10;	

       if( random(me->query_skill("tianxin-blade")) > 300 
	   && me->query("neili") > 1000
       && victim->query_temp("weapon") 
       && random(7) == 2 
	   && random(ap)>dp/10 )
	{
       message_vision(HIY "只见$N手中" + weap1->name() + ""HIY"如风火轮一般，一刀连着一刀将对方的" + weap->name() +""HIR"劈的火星直冒！\n" NOR, me ); 
	   me->add("neili", -(me->query("jiali") +100) );
       if (random(me->query_skill("force") *3/2) > random(victim->query_skill("force")) && me->query("jm/xuantian"))
	   {
       message_vision(HIR "\n潜运全身真劲全力一刀劈下，只听 乒! 的一声巨响，" + weap->name() + "被"+weap1->name()+""HIR"从$N"HIR"手中直劈成两段，$N"HIR"情急之下只好空手应战。\n" NOR, victim );
       weap->move(environment(me));
       weap->set("name", "断掉的"+ weap->query("name") );
       weap->set("value", 0);
       weap->set("weapon_prop", 0);
       weap->set("long", "一把断掉的武器，从中断开，破口整齐，看来是被绝顶高手一刀劈开的。\n");
	   victim->reset_action();
	   me->add("neili",-200);
       } 
	   else 
	   {
      message_vision(HIY "\n$N暗运卸字决，" + weap->name() + ""HIY"顺着方向快速旋转数下，将"+weap1->name()+""HIY"上的真劲全数卸去。\n" NOR, victim );
      victim->add("neili", -500);
       }
     
    }


 //  第五等级的伤气
      if( me->query_skill("tianxin-blade",1)>1000&& me->query_skill("lingyuan-xinfa",1)>1000 && me->query("jm/xuantian") && random(20) == 1 && random(ap)>dp/10 && me->query("jm/xuantian")) 
	  {
              victim->receive_damage("qi", damage2*2+damage_bonus/2 , me);
			  victim->receive_wound("qi", damage2*2+damage_bonus/2 , me);
			   me->add("neili", -100 );
return WHT "$N体内的灵元心法的刚劲与刀招中发出的天行刀意融合为一，化做一股混元真力震碎了$n的心脉！！！\n" NOR;
  }      

 //  第四等级的伤气
      if( me->query_skill("tianxin-blade",1)>800 && me->query_skill("lingyuan-xinfa",1)>800  && random(20) == 2 && random(ap)>dp/10 && me->query("jm/xuantian")) 
	  {
              victim->receive_damage("qi", damage2*3/2+damage_bonus/2 , me);
			  victim->receive_wound("qi", damage2*3/2+damage_bonus/2 , me);
			   me->add("neili", -100 );
            return YEL "$N的天行刀已到第五等级，一刀随意挥出,如生了眼睛一般扑向$n！！！！！\n" NOR;
  }      
      if( damage_bonus < 100 ) return 0;

 //  第三等级的伤气
      if( me->query_skill("tianxin-blade",1)>600 && me->query_skill("lingyuan-xinfa",1)>600  && random(20) == 3 && random(ap)>dp/10  ) 
	  {
              victim->receive_damage("qi", damage2+damage_bonus/2 , me);
			  victim->receive_wound("qi", damage2+damage_bonus/2 , me);
		 me->add("neili", -100 );
        return MAG "$N的天行刀已到第四等级，配合灵元心法发出阵阵刀影罩住$n！！！！！\n" NOR;
  }  

 //  第二等级的伤气
        if( me->query_skill("tianxin-blade",1)>400  && me->query_skill("lingyuan-xinfa",1)>400 && random(20) == 4 && random(ap)>dp/10   ) 
		{
              victim->receive_damage("qi", damage2*3/4+damage_bonus/3 , me);
			  victim->receive_wound("qi", damage2*3/4+damage_bonus/3 , me);
				 me->add("neili", -100 );
return CYN "$N的天行刀已入返璞归真境界，随意一招带出无数劲气扑向$n！！！！！\n" NOR;
  }  
 // 第一等级的伤气
        if ( me->query_skill("tianxin-blade",1)>200 && me->query_skill("lingyuan-xinfa",1)>200 && random(20) == 5 && random(ap)>dp/10 ) 
		{
              victim->receive_damage("qi", damage2/2+damage_bonus/3 , me);
			  victim->receive_wound("qi", damage2/2+damage_bonus/3 , me);
			  me->add("neili", -100);
        return RED "$N暗暗运功将灵元心法的柔劲混入天行刀法阴柔的刀气内攻向$n！！！\n" NOR;
}    
}
/*	//2017.12.31阿飞改，移风剑改成正常自练方式
int practice_skill(object me)
{
    return notify_fail("天行刀法只能通过「"+HIC+"天马行空式"+NOR+"」来提升。\n");
}
*/
int practice_skill(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if( (int)me->query("jingli") < 1000 ||  (int)me->query("neili") < 1000 )
		return notify_fail("你的内力或精力不够，没有办法练习天行刀！\n");
	if (me->query("family/family_name")!="玄天派")
		return notify_fail("你还是先入了日月神教再来练习。\n");	   
	if( (int)me->query_skill("tianxin-blade",1) < 200 )
		return notify_fail("你对天行刀不甚了解吧！\n");
	if( (int)me->query_skill("tianxin-blade",1) > (int)me->query_skill("blade",1) )
		return notify_fail("你的刀法不够精湛！\n");
	if( (int)me->query_skill("lingyuan-xinfa",1) < 200 )
		return notify_fail("你对玄天派的内功不了解，如何能练的了天行刀！\n");
	me->add("neili", -100);
	me->add("jingli", -100);
	write("你按著所学练了一遍移风剑。\n");
	return 1;
}
string perform_action_file(string action)
{
        return __DIR__"tianxin-blade/" + action;
}


