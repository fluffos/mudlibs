// 万毒至尊
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>
inherit F_SSERVER;
string *du=(
{
	"ice_poison",
	"ill_dongshang",
	"ill_fashao",
	"ill_kesou",
	"ill_shanghan",
	"ill_zhongshu",
	"xx_poison",
	"cold_poison",
	"flower_poison",
	"rose_poison",
	"sanpoison",
	"scorpion_poison",
	"qx_snake_poison",
	"anqi_poison",
	"yf_poison",
	"nx_poison",
	"chilian_poison",
	"yufeng_poison",
	"insect_poison",
});
int perform(object me, object target)
{
	string msg;
	int damage;
	int extra,i,count;
	int ap,dp;
	
	object weapon = me->query_temp("weapon");
	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("只能对战斗中的对手使用。\n");
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
		return notify_fail("开始时必须拿着一把剑！\n");
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	
	if(me->is_busy())
		return notify_fail("你现在没空！！\n");
	if( (int)me->query("max_neili") < 1000000  )
		return notify_fail("你的内力修为不够。\n");
	if ((int)me->query("max_jingli") < 500000)								
		return notify_fail("你的精力修为不够。\n");
	if( (int)me->query("jingli") < 10000 )
		return notify_fail("你的精力不够。\n");	
	if( (int)me->query("neili") < 10000 )
		return notify_fail("你的内力不够。\n");
	if( !wizardp(me) &&(int)me->query_skill("wudu-goufa", 1) < 1000 )
		return notify_fail("你的五毒钩法不够熟练!不能贯通使用！\n");
	if(!wizardp(me) && (int)me->query_skill("qianzhu-wandushou", 1) < 1000 )
		return notify_fail("你的千蛛万毒手不够熟练!不能贯通使用！\n");
	if(!wizardp(me) && (int)me->query_skill("wudu-yanluobu", 1) < 1000 )
		return notify_fail("你的五毒烟罗步不够熟练!不能贯通使用！\n");
	if(!wizardp(me) && (int)me->query_skill("wudu-shengong", 1) < 1000 )
		return notify_fail("你的五毒神功不够熟练!不能贯通使用！\n");
	if (me->query_skill_mapped("sword") != "wudu-goufa")
		return notify_fail("你没正确激发该技能 。\n");
	if ( !wizardp(me) && me->query_skill_mapped("force") != "wudu-shengong")
		return notify_fail("不使用本门内功，如何使用本门绝学!\n");
	if (!wizardp(me) && !(int)me->query("breakup") )
		return notify_fail("你任督二脉未通,无法使用「万毒至尊」。\n"NOR);
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	msg = HBWHT "$N贯通五毒教武学，使出了五毒教的绝学之精髓！\n" NOR;
	message_vision(msg, me, target);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 5, me);	//CD写法1
	ap = me->query("xyzx_sys/level") + me->query_skill("wudu-goufa", 1)+me->query_skill("qianzhu-wandushou", 1) + me->query_skill("sword") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");	
	extra = me->query_skill("wudu-goufa", 1)+me->query_skill("qianzhu-wandushou", 1);
	count = me->query_skill("wudu-goufa", 1)/600;
	if (count> 6) count=6;
	for(i=0; i<count; i++)
	{
		me->add_temp("apply/attack", extra);
		me->add_temp("apply/damage", extra);
		msg = HIB "$N运起五毒神功,头顶黑气蒸腾，一剑刺了出来！\n" NOR;
		COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);
		me->add_temp("apply/attack", -extra);
		me->add_temp("apply/damage", -extra);
	}
	me->add("neili",-100*count);
	me->add("jingli",-1000);
	msg = HIR "$N一声狞笑飞身纵起，凌空一指向$n的眉心点去。\n";
	message_vision(msg, me, target);
	target->apply_condition("chilian_poison",
	                        (int)target->query_condition("chilian_poison") + 5 );
	target->apply_condition("snake_poison",
	                        (int)target->query_condition("snake_poison") + 5 );
	target->apply_condition("wugong_poison",
	                        (int)target->query_condition("wugong_poison") + 5 );
	target->apply_condition("zhizhu_poison",
	                        (int)target->query_condition("zhizhu_poison") + 5 );
	target->apply_condition("xiezi_poison",
	                        (int)target->query_condition("xiezi_poison") + 5 );
	target->apply_condition("chanchu_poison",
	                        (int)target->query_condition("chanchu_poison") + 5 );
	damage=(int)me->query_skill("qianzhu-wandushou",1)+(int)me->query_skill("wudu-shengong",1)+(int)me->query_skill("wudu-goufa",1)+(int)me->query_skill("sword",1);
if (me->query_skill("wudu-goufa", 1) > 2000 && me->query_skill("qianzhu-wandushou", 1) > 2000)
{
	damage = damage + random(damage);
	if( random(ap) > dp/3  )
	{
		msg = HIR"只见一缕黑气从$N的指尖透出，只一闪就没入$n的眉心！\n" NOR;
		message_vision(msg, me, target);
		if(target->query_skill("hunyuan-yiqi",1)>me->query_skill("qianzhu-wandushou",1)*12/10 && random(2)==0)
		{
			msg = RED"$N忽然觉得指力被一团无形的劲力包裹着，紧接着只听$n一声大喝，$N顿时如一根稻草般被抛向远处。\n" NOR;
			message_vision(msg, me, target);
			msg = RED"$P只觉得一股如山的劲力顺指尖猛攻过来，只觉得全身毒气狂窜。忽然胸口一痛，不由“哇”的一声吐出一口黑血！\n" NOR;
			message_vision(msg, me,target);
			me->receive_wound( "qi",damage,target);
			me->receive_damage( "qi",damage,target);
			me->apply_condition(du[random(sizeof(du))], 15);
			me->add("neili",-1000);
			me->add("jingli",-1000);
			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage +"。\n" NOR);
		}
		else
		{
			msg = HIR"$n不由一声惨嚎摔倒在地，身体已痛苦得蜷缩成一团！\n" NOR;
			message_vision(msg, me, target);
			target->receive_wound( "qi",damage/3,me);
			target->receive_damage( "qi",damage/3,me);
		//	if (!target->is_busy()) target->start_busy(4);
			me->add("neili",-500);
			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage/3 +"，内伤为"+ damage/3 +"。\n" NOR);
		}
	}
	else
	{
		msg = HIG "可是$n早有准备，一个懒驴打滚，堪堪躲过了这一招。\n" NOR;
		message_vision(msg, me, target);
		me->add("neili",-200);
	}
}
	
if (me->query_skill("wudu-goufa", 1) > 3000 && me->query_skill("qianzhu-wandushou", 1) > 3000)
{	
	msg = HIM "只见$N从怀中，拿出一大包不知道是什么东西的药粉，一把撒向$n的周身!\n"NOR;
	message_vision(msg, me, target);
	if (me->query("jm/wudu")) damage=me->query_skill("qianzhu-wandushou",1)*me->query("con",1)*3/2+me->query_skill("wudu-shengong",1)*me->query("con",1)*3/2+me->query_skill("wudu-goufa",1)*me->query("con",1)*3/2+me->query_skill("sword",1)+me->query_skill("force",1)+me->query_skill("wudu-yanluobu",1)+me->query_skill("unarmed",1);
	else damage=me->query_skill("qianzhu-wandushou",1)*me->query("con",1)+me->query_skill("wudu-shengong",1)*me->query("con",1)+me->query_skill("wudu-goufa",1)*me->query("con",1)+me->query_skill("sword",1)+me->query_skill("force",1)+me->query_skill("wudu-yanluobu",1)+me->query_skill("unarmed",1);
	damage = damage + random(damage);
	if( random( ap) > dp/3  )
	{
		msg = HIR"$n没有防范，全身上下被撒了一个正着！\n" NOR;
		message_vision(msg, me, target);
	//	if (!target->is_busy()) target->start_busy(3 + random(3));
		COMBAT_D->report_status(target);		
		target->receive_damage( "qi",damage,me);
		target->receive_wound( "qi",damage,me);
		me->add("neili",-3000);
		me->add("jingli",-3000);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage +"。\n" NOR);
		target->apply_condition(du[random(sizeof(du))], 15);
		target->apply_condition(du[random(sizeof(du))], 15);
		target->apply_condition(du[random(sizeof(du))], 15);
		target->apply_condition(du[random(sizeof(du))], 15);
		target->apply_condition(du[random(sizeof(du))], 15);
	}
	else
	{
		msg = "$p急提内力奋力一震，将$N撒出的毒粉卸在了身旁!\n" NOR;
		message_vision(msg, me, target);
		me->add("neili",-1000);
	}
}
  me->start_busy(1);
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}