int valid_enable(string usage) { return usage == "throwing" || usage == "parry"; }
int practice_level() { return 200; }
int valid_learn(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query("family/family_name") != "血河派")
    return notify_fail("你未加入血河派，无法学习本门技能。\n");
  if (me->query_skill("throwing", 1) <= me->query_skill("huaxue-shenzhen", 1))
    return notify_fail("你的基础不够，无法领会更高深的技巧！\n");
  if ((int)me->query_skill("yiqiguan-riyue", 1) < 100)
    return notify_fail("你的一气贯日月火候太浅。\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (random(100) == 1) me->add("score", -5);
  return 1;
}
string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me) {
  object ob;

  //	if (!wizardp(me))
  //	return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("qi") < 50
    || (int)me->query("neili") < 35)
    return notify_fail("你的内力或气不够，没有办法练习化血神针。\n");
  if (me->query("family/family_name") != "少林派")
    return notify_fail("你未加入血河派，无法练习本门技能。\n");
  if (!objectp(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "throwing")
    if (!objectp(ob = me->query_temp("secondary_weapon"))
      || (string)ob->query("skill_type") != "throwing")
      return notify_fail("你装备的武器不对。\n");
  me->receive_damage("qi", 30);
  me->add("neili", -20);
  me->add_temp("pratice_throwing", 1);
  if (me->query_temp("pratice_throwing") > me->query_skill("huaxue-shenzhen", 1) / 20) {
    if ((int)ob->query_amount() == 1) {
      ob->unequip();
      tell_object(me, BOLD "\n你的" + ob->query("name") + "用完了！\n\n" + NOR);
    }
    ob->add_amount(-1);
    me->delete_temp("pratice_throwing");
  }
  write("你按著所学练了一遍化血神针。\n");
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "huaxue-shenzhen/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus) {

  int ap, dp, level, flag, damage2;
  flag = 1;
  level = (int)me->query_skill("huaxue-shenzhen", 1);
  ap = (int)me->query("con", 1) * (int)me->query_skill("huaxue-shenzhen", 1);
  dp = (int)victim->query("dex", 1) * (int)me->query_skill("parry", 1);
  damage2 = (int)me->query_skill("huaxue-shenzhen", 1);
  if (damage_bonus < 100) return 0;
  if (me->query_skill(
    "huaxue-dafa",
    1
  ) < 200 && me->query_skill(
    "yiqiguan-riyue",
    1
  ) < 200 && me->query_skill("longmen-shengong", 1) < 100) return 0;
  if (me->query_skill_mapped("force") != "huaxue-dafa" && me->query_skill_mapped("force") != "yiqiguan-riyue" && me->query_skill_mapped("force") != "longmen-shengong") return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100) return 0;
  if (damage2 < 10) damage2 = 10;
  if (me->query_skill_mapped("force") == "longmen-shengong") flag = 2;
  if (me->query_skill_mapped("force") == "huaxue-dafa") flag = 3;
  if (me->query_skill_mapped("force") == "yiqiguan-riyue") flag = 1;
  if (random(5) == 2 && level > 100 && me->query("neili") > 500 && random(ap) > dp / 10 && me->query("jiali") > 0) {
    message_vision(HIY "$N屈指一弹，一道血丝飞出。$n感觉似被蚊子咬了一下，不一会，感觉浑身热血沸腾！。\n" NOR, me, victim);
    me->add("neili", -100);
    victim->receive_wound("qi", damage2 * flag + damage_bonus / 2, me);
    victim->receive_damage("qi", damage2 * flag + damage_bonus / 2, me);
    victim->apply_condition("wuxing_poison", 10 * flag);
  }

  return;
}


