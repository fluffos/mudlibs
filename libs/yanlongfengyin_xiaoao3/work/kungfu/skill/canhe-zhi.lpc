int valid_combine(string combo) {
  object me = this_player();
  mapping myfam = (mapping)me->query("family");
  if (myfam["master_name"] == "慕容博")
    return combo == "xingyi-zhang";
}
int valid_enable(string usage) {
  return usage == "finger" || usage == "unarmed" || usage == "parry";
}

int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练参合指必须空手。\n");
  if (me->query("family/family_name") != "姑苏慕容")
    return notify_fail("你不是慕容世家的弟子，无法领悟本门技能的精髓。\n");
  if ((int)me->query_skill("shenyuan-gong", 1) < 500)
    return notify_fail("你的神元功火候不够，无法学参合指。\n");
  if ((int)me->query("int", 1) < 30)
    return notify_fail("你的悟性不够，无法学参合指。\n");
  if ((int)me->query("max_neili") < 100000)
    return notify_fail("你的内力太弱，无法练参合指。\n");
  if ((int)me->query("score", 1) < 10000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (random(10) == 1) me->add("score", -10);
  return 1;
}

string query_skill_name(int level) {
  int i = sizeof(action);

  while (i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  int level, skill;
  level = (int)me->query_skill("canhe-zhi", 1);
  skill = (int)me->query_skill("parry", 1);
  if (random(10) == 1 && me->query("jiali") >= 50 && random(level) > 200 && random(skill) > 200) {
    return ([
      "action": HIY "$N默运神元神功，指风轻飘飘地点向$n，一股内劲无声无息的绕向$n周身大穴！" NOR,
      "attack": 800,
      "parry": 800,
      "dodge": 800,
      "damage": 800,
      "force": 800,
      "damage_type": "内伤" ]);
  }
  if (random(10) == 2 && me->query("jiali") >= 50 && random(level) > 200 && random(skill) > 200) {
    return ([
      "action": HIY "$N指风犀利，似一道无形剑气，将$n笼罩于内！$n只见眼前剑光闪动，茫然不知所措。" NOR,
      "attack": 800,
      "parry": 800,
      "dodge": 800,
      "damage": 800,
      "force": 800,
      "damage_type": "刺伤" ]);
  }

  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}
int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("jingli") < 10000)
    return notify_fail("你的精力太低了。\n");
  if ((int)me->query("neili") < 10000)
    return notify_fail("你的内力不够练参合指。\n");
  if (me->query("family/family_name") != "姑苏慕容")
    return notify_fail("你一个外人，竟敢偷练慕容世家的绝技！\n");
  if ((int)me->query_skill("shenyuan-gong", 1) < 500)
    return notify_fail("你的神元功不够，无法练习参合指。\n");
  me->add("neili", -100);
  me->add("jingli", -100);
  return 1;
}
string perform_action_file(string action) {
  return __DIR__ "canhe-zhi/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus)

{
  int ap, dp, sp, damage2;
  string name;

  name = xue_name[random(sizeof(xue_name))];
  damage2 = (int)me->query_skill("canhe-zhi", 1);
  ap = me->query_skill("canhe-zhi", 1);
  dp = victim->query_skill("force", 1);
  sp = victim->query_skill("unarmed", 1);
  if (damage_bonus < 100) return 0;
  if (me->query_skill("shenyuan-gong", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "shenyuan-gong") return 0;
  if (damage2 < 10) damage2 = 10;

  if (random(ap) > dp / 10 && random(6) == 0 && me->query("jiali") > 0) {
    me->add("neili", -100);
    victim->receive_wound("qi", damage2 + damage_bonus / 2);
    return HIY "只听一声惨嚎，一股鲜血从$n被参合指劲气扫中的伤口喷出！\n" NOR;
  }

  if (random(6) == 1 && (me->query("neili") > 200) && random(ap) > sp / 10 && me->query("jiali") > 0) {

    me->add("neili", -100);
    victim->receive_wound("qi", damage2 + damage_bonus / 2, me);
    if (victim->query("neili") <= damage2) victim->set("neili", 0);
    else
      victim->add("neili", -damage2);

    return HIW "$N默运神元神功，指风轻飘飘地点向$n，一股内劲无声无息的绕向$n周身大穴！\n"
      HIW "$n只觉全身一麻，已被一招点中「" HIR + name + HIW "」！\n" NOR;
  }

}

//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡bug有关
int ob_hit(object ob, object me, int damage) {
  string msg;
  int j, skill, neili, neili1;
  int level, level2, damage2;
  level = (int)me->query_skill("canhe-zhi", 1);
  level2 = (int)ob->query_skill("parry", 1);
  skill = me->query_skill("douzhuan-xingyi", 1);
  neili = me->query("neili");
  neili1 = ob->query("neili");

  damage2 = (int)ob->query("neili") / 10;
  if (random(6) == 4 && random(level) > random(level2 / 2) && random(skill) > 200 && me->query_skill_mapped("force") == "shenyuan-gong") {
    j = -damage / 2;
    if (damage2 > 5000) damage2 = 5000;
    if (damage2 < 0) damage2 = 0;
    msg = HIC "$N" + HIC + "凝神运气向$n猛攻快打，使出的招数好似$n的成名绝技，把$n的招数化于无行！\n" NOR;

    me->add("neili", -(me->query("jiali") + 100));
    if (random(2) == 0) {
      msg += HIC "$N" + HIC + "使出星移斗转，$n这招莫名其妙的在中途转了方向，直奔自己袭来!" + NOR;
      if (ob->query("qi") > damage2) {
        ob->receive_damage("qi", damage2 / 2, me);
        ob->receive_wound("qi", damage2 / 2, me);
      }

    }

    message_vision(msg, me, ob);
    return j;
  }
}
