int valid_enable(string usage) { return usage=="unarmed" ||  usage=="parry"; }

int valid_learn(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
        if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
                return notify_fail("练大嵩阳神掌必须空手。\n");
        if ((int)me->query_skill("force", 1) < 100)
                return notify_fail("你的内功修为不够，无法学大嵩阳神掌。\n");
        if ((int)me->query("max_neili") < 10000)
                return notify_fail("你的内力太弱，无法练大嵩阳神掌。\n");
        if ((int)me->query("str",1) < 25)
                return notify_fail("你的臂力太弱，无法练大嵩阳神掌。\n");
    if (me->query("family/family_name")!="嵩山派")
   return notify_fail("你未加入嵩山，学不了。\n");	
    if ((int)me->query_skill("hanbing-zhenqi", 1) < 100)
    return notify_fail("不学会寒冰真气，学不了。\n");			
        return 1;
}

string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
        int level;
        level = (int)me->query_skill("songyang-zhang", 1);
        
        if (me->query("jiali") >100 && random(5)==1 && random(level)>300)
		{
            return([      
				"action": BLU "紧接着$N"BLU"右手一转一收，在$n"BLU"还没有反应过来时飞身欺前，腾出左手翻腕就是一式「震山掌」！"NOR,        
				"attack":	300,
				"parry":	300,
				"dodge":	300,
				"damage":	300,
				"force":	300,
				"damage_type" : "瘀伤",
				"skill_name" : "震山掌"
                   ]);
		}
        return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me)
{
//   	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	    
        if ((int)me->query("jingli") < 50)
                return notify_fail("你的精力太低了。\n");
        if ((int)me->query("neili") < 20)
                return notify_fail("你的内力不够练大嵩阳神掌。\n");
    if (me->query("family/family_name")!="嵩山派")
   return notify_fail("你未加入嵩山，练习不了。\n");				
        me->add("jingli", -30);
        me->add("neili", -10);

        return 1;
}

string perform_action_file(string action)
{
        return __DIR__"songyang-zhang/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
	int ap,dp,damage2;
	ap  = (int) me->query_skill("songyang-zhang",1);
	dp = victim->query_skill("unarmed",1);
	damage2 = (int)me->query_skill("songyang-zhang",1);	
	
    if( damage_bonus < 100 ) return 0;
	if ( me->query_skill("hanbing-zhenqi",1) < 100)	 return 0;
	if ( me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "hanbing-zhenqi") return 0;	
	if (damage2<10) damage2=10;	
	if( random(6)==0 
	&& me->query_skill("songyang-zhang",1) > 200
	&& me->query_skill("hanbing-zhenqi",1) > 200
	&& me->query_skill_mapped("force") == "hanbing-zhenqi"
	&& me->query("jiali") > 0
	&& random(ap) > dp/10)
	{
	//	if (!victim->is_busy()) victim->start_busy(1);
		victim->receive_wound("qi", damage2+100+damage_bonus/2,me);
		victim->add("neili",-(me->query("jiali")+300));
		me->add("neili", -100);
		victim->apply_condition("cold_poison", victim->query_condition("cold_poison") + 4);
		return HIC"$N运用寒冰真气驾驭阳刚的嵩阳掌，左手阳，右手阴，$n受到一阴一阳的内劲影响，吐了一口鲜血！\n"NOR;
	}

}