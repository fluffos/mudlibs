// beimin-shengong.c 北冥神功
// By Hop
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit FORCE;
int valid_enable(string usage) { return usage=="force"; }
int valid_learn(object me)
{
    mapping skl;
    string *sname;
    int i;
    int lvl = (int)me->query_skill("beiming-shengong", 1);
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if ( me->query("gender") == "无性" && lvl > 49)
        return notify_fail("你无根无性，阴阳不调，难以领会高深的北冥神功。\n");
    if (me->query_skill("force",1)<=lvl)
        return notify_fail("你的基本内功基础不够，再学下去会走火入魔的。\n");
    if (me->query_skill("force",1)<100)
        return notify_fail("你的基本内功基础不够，怎能学北冥神功。\n");
    if (me->query("family/family_name")!="灵鹫宫" && me->query("family/family_name")!="逍遥派")
   return notify_fail("北冥神功是逍遥派不传之密，不加入门派是不能传授该技能的。\n");	
	if ((int)me->query("score",1) < 5000)
		return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");

    skl = this_player()->query_skills();
    sname  = keys(skl);
    for (i=0;i<sizeof(skl);i++){
        if (sname[i]=="beiming-shengong") continue;		
        if (sname[i]=="yijing-force") continue;
        if (sname[i]=="bahuang-gong") continue;	
        if (sname[i]=="xiaowuxiang") continue;			
  //      if (sname[i]=="xixing-dafa") continue;		//2016.5.22阿飞增加xixing-dafa兼容
            if( SKILL_D(sname[i])->valid_enable("force") )
            return notify_fail("你不先散了别派内功，怎能学北冥神功？！\n");
    }
	if (random(100)==1) me->add("score",-5);	
    return 1;
}
int practice_skill(object me)
{
    return notify_fail("北冥神功只能用学的，或是从运用(exert)中增加熟练度。\n");
}
string exert_function_file(string func)
{
    return __DIR__"beiming-shengong/" + func;
}

mapping exercise_msg(object me)
{
  return ([
        "status_msg" : "胸口雾气迷漫，若隐若现。\n" ,
        "start_my_msg" : "盘膝坐下，双目紧闭，雾气逐渐笼罩全身，一轮明月升到头顶。\n",
        "start_other_msg" :  me->name() + "盘膝坐下，双目紧闭，雾气逐渐笼罩全身，一轮明月升到头顶。\n",
        "heal_my_msg" : "雾气自胸口而出，缭绕不散，渐渐愈来愈浓，逐渐成为一团白雾，将你全身笼罩在内。\n",
        "heal_other_msg" :  me->name() + "胸口白雾缭绕不散，笼罩"+ me->name() + "全身，渐渐愈来愈浓，逐渐成为一团白雾，将"+ me->name() + "全身笼罩在内。\n",
        "halt_msg" :  "轻喝一声“拙”，待白雾快速聚集胸口消散，你站了起来。\n",
        "end_my_msg" : "只见白雾不断往胸口聚集，待全身白雾吸尽，你睁开双眼，缓缓站起。\n",
        "end_other_msg" : me->name()+"胸口不断吸入白雾，待全身白雾吸尽，"+me->name()+"睁开双眼，缓缓站起。\n",		
        "hover_my_msg" : "全身雾气迷漫，愈来愈浓，一轮明月升起。过了良久，明月垂落，跟着全身白雾也渐渐淡了。\n",
        "hover_other_msg" : "只听得"+me->name()+"全身雾气迷漫，愈来愈浓。过了良久，头顶明月垂落，跟着全身白雾也渐渐淡了。\n",	
    ]);
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
	int ap,dp,damage2,maxnei;
	damage2 = (int)me->query_skill("beiming-shengong",1);	
	ap = me->query_skill("beiming-shengong",1);	
	dp = victim->query_skill("force",1);
	maxnei = (int)me->query("max_neili");
    if( damage_bonus < 100 ) return 0;
	if ( me->query_skill("beiming-shengong",1) < 100)	 return 0;
	if ( me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "beiming-shengong") return 0;	
	if (damage2<10) damage2=10;	
	if (me->query("jm/xiaoyao")) maxnei = (int)me->query("max_neili")*2;
	if ( random(ap) > dp/20 && random(6)==0 && me->query("jiali") > 0) 
	{
		victim->receive_damage("qi", damage2+damage_bonus/2,me);
		victim->receive_wound("qi", damage2+damage_bonus/2,me);
		me->add("neili",-100);
		if (me->query("neili") < maxnei)  me->add("neili", damage2 );
		if (victim->query("neili") > damage2) victim->add("neili",-damage2 );
		return HIB "$N发挥出"+HIR+"北冥神功"NOR HIB"的北冥真气，吸走了$n的真元！！！！\n" NOR;
		
	}
}