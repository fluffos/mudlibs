// zhenfeng-jianfa 震风剑法	下乘武学100~300
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SKILL;

mapping *action = ({
([      "action" : "$N手中$w点向$n的$l",
		"attack":	100,
		"parry":	100,
		"dodge":	100,
		"damage":	100,
		"force":	100,
        "lvl"    : 0,
        "damage_type" : "刺伤"
]),
([      "action" : "$N使出[1;30m「乱舞狂风」[0m，$w闪烁不定，刺向$n的$l",
		"attack":	100,
		"parry":	100,
		"dodge":	100,
		"damage":	100,
		"force":	100,
        "lvl"    : 0,
        "damage_type" : "刺伤"
]),
([      "action" : "$N一招[1;34m「天昏地暗」[0m，无数$w上下刺出，直向$n逼去",
		"attack":	200,
		"parry":	200,
		"dodge":	200,
		"damage":	200,
		"force":	200,
        "lvl"    : 10,
        "damage_type" : "刺伤"
]),
([      "action" : "$N向前跨上一步，手中$w使出[1;33m「剑气封喉」[0m直刺$n的喉部",
		"attack":	200,
		"parry":	200,
		"dodge":	200,
		"damage":	200,
		"force":	200,
        "lvl"    : 20,
        "damage_type" : "刺伤"
]),
([      "action" : "只见$N抡起手中的$w，使出[5;1;31m?[5m?[5m?[5m?[5m?[5m?[5m?[5m?[5m?[5m?[5m?[5m?[0m万点金光直射$n",
		"attack":	300,
		"parry":	300,
		"dodge":	300,
		"damage":	300,
		"force":	300,
        "lvl"    : 60,
        "damage_type" : "刺伤"
]),
});


int valid_enable(string usage) { return (usage == "sword") || (usage == "parry"); }

int valid_learn(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
        if ((int)me->query_skill("zhenfeng-xinfa", 1) < 100)
                return notify_fail("你的「震风心法」火候不够，无法学「震风剑法」。\n");
    if (me->query("family/family_name")!="圣剑魔宫")
   return notify_fail("你不是圣剑魔宫传人，无法学习震风剑法。\n");				
        if ((int)me->query("max_neili") < 10000)
                return notify_fail("你的内力太弱，无法练「震风剑法」。\n");
        return 1;
}

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}

int practice_skill(object me)
{
        object weapon;
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "sword")
                return notify_fail("你使用的武器不对。\n");
    if (me->query("family/family_name")!="圣剑魔宫")
   return notify_fail("你不是圣剑魔宫传人，无法练习震风剑法。\n");					
        if ((int)me->query("qi") < 50)
                return notify_fail("你的体力不够练「震风剑法」。\n");
        if ((int)me->query("neili") < 30)
                return notify_fail("你的内力不够练「震风剑法」。\n");
        me->receive_damage("qi", 30);
        me->add("neili",-15);
        return 1;
}

string perform_action_file(string action)
{
        return __DIR__"zhenfeng-jianfa/" + action;
}


mixed hit_ob(object me, object victim, int damage_bonus)
{
	int ap,dp,damage2;
	damage2 = (int)me->query_skill("zhenfeng-jianfa",1);	
	ap = me->query_skill("zhenfeng-jianfa",1);
	dp = victim->query_skill("parry",1);
    if( damage_bonus < 100 ) return 0;
	if ( me->query_skill("zhenfeng-xinfa",1) < 100)	 return 0;
	if ( me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "zhenfeng-xinfa") return 0;	
	if (damage2<10) damage2=10;	
	if(me->query("jiali") > 0
	    && me->query_skill_mapped("force") == "zhenfeng-xinfa"
	    && random(ap) > dp/10
		&& random(5)==0 )
	{
		victim->receive_wound("qi", damage2+damage_bonus/2 ,me);
		me->add("neili", -100 );		
		return HIW "$N剑上突然震出一道风刃！$n大叫一声，似乎被割掉了一块肉！\n" NOR;
	}
}