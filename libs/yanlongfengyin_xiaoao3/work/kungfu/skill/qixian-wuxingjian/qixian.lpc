#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>

#define QIXIAN "「" HIW "七弦连环诛" NOR "」"

inherit F_SSERVER;

int perform(object me, object target) {
  string msg;
  object weapon;
  int i;
  int damage, neili;
  int an, dn;
  int count;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail(QIXIAN "只能对战斗中的对手使用。\n");
  if (me->query_skill("wuzheng-xinfa", 1) < 1000)
    return notify_fail("你的无争心法修为不够，现在无法使用" QIXIAN "。\n");
  if (me->query_skill("qixian-wuxingjian", 1) < 1000)
    return notify_fail("你的七弦无形剑修为有限，现在无法使用" QIXIAN "。\n");
  if (me->query_skill("wuyun-jianfa", 1) < 1000)
    return notify_fail("你的五蕴七弦剑修为有限，现在无法使用" QIXIAN "。\n");
  if (me->query("max_neili") < 200000)
    return notify_fail("你的内力修为不够，无法运用" QIXIAN "。\n");
  if (me->query("neili") < 10000)
    return notify_fail("你的真气不够，无法运用" QIXIAN "。\n");
  if ((int)me->query("max_jingli") < 1000000)
    return notify_fail("你的精力修为还不够高。\n");
  if ((int)me->query("jingli") < 10000)
    return notify_fail("你的精力不够了。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");
  if (me->query_skill_mapped("force") != "wuzheng-xinfa")
    return notify_fail("不使用本门内功，如何能使用本门绝技。\n");
  if (objectp(weapon = me->query_temp("weapon"))) {
    if ((string)weapon->query("skill_type") != "sword" || me->query_skill_mapped("sword") != "qixian-wuxingjian")
      return notify_fail("你不能使用这种兵器施展" QIXIAN "。\n");
  } else {
    if (me->query_skill_mapped("unarmed") != "qixian-wuxingjian")
      return notify_fail("你未准备施展" QIXIAN "。\n");
  }
  //	if (target && target->query_temp("apply/shade_vision")) 
  //		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	
  //	if (!(int)me->query("breakup"))
  //		return notify_fail("你任督二脉未通,无法使用「七弦连环诛」。\n"NOR);	
  if (target && !living(target))
    return notify_fail("对方都已经这样了，用不着这么费力吧？\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  count = me->query_skill("qixian-wuxingjian") + me->query_skill("wuyun-jianfa", 1);
  an = me->query("max_neili");
  dn = target->query("max_neili");
  //	message_vision(HBWHT "$N贯通梅庄武学，使出了梅庄的绝学之精髓！\n" NOR, me, target);

  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 5, me);  //CD写法1
  if (objectp(weapon = me->query_temp("weapon"))) {
    msg = HIR "只见$N" HIR "双目微闭，单手在" + weapon->name() + HIR "上轻轻拨动，顿时只听“啵啵啵”破空之声连续不断"
      "，数股破\n体无形剑气激射而出，直奔$n" HIR "而去。\n" NOR;
    message_vision(msg, me, target);
  } else {
    msg = HIR "只见$N" HIR "双目微闭，双手轻轻舞弄，陡然间十指一"
      "并箕张，顿时只听“啵啵啵”破空之声连续不\n断，数股破"
      "体无形剑气激射而出，直奔$n" HIR "而去。\n" NOR;
    message_vision(msg, me, target);
  }

  me->add("neili", -500);
  me->add("jingli", -1000);
  me->add_temp("apply/attack", count);
  me->add_temp("apply/damage", count);
  for (i = 0; i < 6; i++) {
    if (!me->is_fighting(target))
      break;
    COMBAT_D->do_attack(me, target, weapon, 0);
  }
  me->add_temp("apply/attack", -count);
  me->add_temp("apply/damage", -count);


  if (me->query_skill("qixian-wuxingjian", 1) > 2000 && me->query_skill("wuyun-jianfa", 1) > 2000) {
    if (weapon) {
      msg = HIM "只见$N" HIM "一声冷哼，以内劲催动" + weapon->name() + HIM "，激荡出无形琴音，铮然大响，只听“啵”的\n一声破空"
        "之响，一束无形剑气澎湃射出，直贯$n" HIM "而去。\n" NOR;
      message_vision(msg, me, target);
    } else {
      msg = HIM "只见$N" HIM "一声冷哼，狂催内劲激荡出无形琴音，铮"
        "然大响，只听“啵”的一声破空之\n响，一束无形剑气澎湃"
        "射出，直贯$n" HIM "而去。\n" NOR;
      message_vision(msg, me, target);
    }
    if (random(an) > dn / 3) {
      msg = HIY "$p" HIR "只感到$P" HIR "内力澎湃，汹涌而至，霎"
        "时心神惧碎，呆立当场！\n" NOR;
      message_vision(msg, me, target);
      damage = me->query_skill(
        "qixian-wuxingjian",
        1
      ) + me->query_skill(
        "wuyun-jianfa",
        1
      ) + me->query_skill(
        "wuzheng-xinfa",
        1
      ) + me->query_skill("sword", 1) + me->query_skill("force");
      damage = damage + random(damage) + 1000;
      target->receive_damage("qi", damage, me);
      target->receive_wound("qi", damage / 2, me);
      target->add("neili", -damage);
      if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
        me,
        HIW "该绝招对敌人气血的外伤为" + damage + "，内伤为" + damage / 2 + "，杀内力" + damage + "。\n" NOR
      );
      me->add("neili", -1000);
      me->add("jingli", -2000);
    } else {
      msg = HIC "$n" HIC "只感到$P" HIC "内力澎湃，汹涌而至，急"
        "忙凝神聚气，小心应付。\n" NOR;
      message_vision(msg, me, target);
      target->add("neili", -damage / 2);
      me->add("neili", -2000);
      me->add("jingli", -1000);
      if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
        me,
        HIW "该绝招杀内力" + damage / 2 + "。\n" NOR
      );
    }

  }

  if (me->query_skill("qixian-wuxingjian", 1) > 3000 && me->query_skill("wuyun-jianfa", 1) > 3000) {
    if (weapon) {
      msg = HIY "只见$N" HIY "一声暴喝，单手迅速在" + weapon->name() + HIY "上拨动数下，顿时琴音铮铮大响，只听“啵”的\n一声破空"
        "之响，一束无形剑气澎湃射出，直贯$n" HIY "而去。\n" NOR;
      message_vision(msg, me, target);
    } else {
      msg = HIY "只见$N" HIY "一声暴喝，陡然间十指一并箕张，顿时琴音"
        "铮铮大响，只听“啵”的一声破空之\n响，一束无形剑气澎湃"
        "射出，直贯$n" HIY "而去。\n" NOR;
      message_vision(msg, me, target);
    }
    if (random(an) > dn / 3) {
      msg = HIR "$n" HIR "只觉得$N" HIR "内力激荡，琴"
        "音犹如一柄利剑穿透鼓膜，“哇”的喷出一口"
        "鲜血。\n";
      message_vision(msg, me, target);

      neili = me->query("jingli") - target->query("jingli");
      if (neili > 50000000) neili = 50000000;
      if (me->query("jm/meizhuang")) damage = me->query_skill(
        "qixian-wuxingjian",
        1
      ) * me->query(
        "con",
        1
      ) * 3 / 60 + me->query_skill(
        "wuyun-jianfa",
        1
      ) * me->query(
        "con",
        1
      ) * 3 / 60 + me->query_skill(
        "wuzheng-xinfa",
        1
      ) * me->query("con", 1) * 3 / 60 + me->query_skill("sword", 1) + me->query_skill("force", 1);
      else damage = me->query_skill(
        "qixian-wuxingjian",
        1
      ) * me->query(
        "con",
        1
      ) / 30 + me->query_skill(
        "wuyun-jianfa",
        1
      ) * me->query(
        "con",
        1
      ) / 30 + me->query_skill(
        "wuzheng-xinfa",
        1
      ) * me->query("con", 1) / 30 + me->query_skill("sword", 1) + me->query_skill("force", 1);
      if (neili > 0) damage = damage + random(damage) + neili / 1000;
      else damage = damage - random(damage);
      target->receive_damage("qi", damage, me);
      target->receive_wound("qi", damage, me);
      target->receive_damage("qi", damage, me);
      target->receive_wound("qi", damage, me);
      target->add("neili", -damage);
      target->apply_condition("no_exert", 20);
      me->add("neili", -2000);
      me->add("jingli", -2000);
      if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
        me,
        HIW "该绝招对敌人气血的外伤为" + damage + "，内伤为" + damage + "，精神的外伤为" + damage + "，内伤为" + damage + "，杀内力" + damage + "。\n" NOR
      );
    } else {
      msg = HIY "可是$n" HIY "内力深厚，轻而易举受下$N"
        HIY "这一招，丝毫无损。\n" NOR;
      message_vision(msg, me, target);
      me->add("neili", -2000);
      me->add("jingli", -1000);
    }

  }
  me->start_busy(1);

  return 1;
}
void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
