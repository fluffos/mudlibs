	"force":	400,
"skill_name" : "风起云涌",
"damage_type" : "瘀伤"
	 ]),
([      "action" : "$N倏忽欺至$n身前，一招「"BLINK HIY"扬波起浪"NOR"」直拍$n的$l",
	"attack":	500,
	"parry":	500,
	"dodge":	500,
	"damage":	500,
