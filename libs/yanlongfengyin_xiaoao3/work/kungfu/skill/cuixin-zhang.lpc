	 ]),
});

mapping *action2 = (
{
([      "action" : HIB"$N身形拔起，在半空一招「"BLINK HIC"急电惊雷"NOR HIB"」右掌猛击$n的$l"NOR,
	"attack":	800,
	"parry":	800,
	"dodge":	800,
	"damage":	800,
	"force":	800,
	"lvl" : 500,
"skill_name" : "急电惊雷",
"damage_type" : "瘀伤"
	 ]),
([      "action" : YEL"$N使一招「"BLINK HIR"含沙射影"NOR YEL"」，纵起丈余直击$n的$l"NOR,
	"attack":	900,
	"parry":	900,
	"dodge":	900,
	"damage":	900,
	"force":	900,
	"lvl" : 1000,
"skill_name" : "含沙射影",
"damage_type" : "瘀伤"
	 ]),
([      "action" : MAG"$N一声大喝使出「"BLINK HIG"夺魄催心"NOR MAG"」，幻出满天掌影，掌掌不离$n的$l"NOR,
	"attack":	1000,
	"parry":	1000,
	"dodge":	1000,
	"damage":	1000,
	"force":	1000,
	"lvl" : 1500,
