	 ]),
});

int valid_enable(string usage)
{
	return usage=="unarmed" || usage == "parry"|| usage=="strike";
}

int valid_learn(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if ( me->query("family/family_name")!="玄天派")
		return notify_fail("摧心掌乃是玄天派绝学，外人怎么可能传授呢。\n");
	if ((int)me->query("max_neili") < 10000)
		return notify_fail("你的内力不够。\n");
	if ((int)me->query("int",1) < 25)
		return notify_fail("你的悟性不够，无法领悟摧心掌的掌力。\n");
    if (me->query_skill("lingyuan-xinfa",1)<300)
        return notify_fail("你的本门内功不够，怎能学摧心掌呢。\n");
	if (me->query_skill("unarmed", 1) <=me->query_skill("cuixin-zhang", 1))
		return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
	if ((int)me->query_skill("cuixin-zhang",1) > 1000)
		return notify_fail("这套武功太过阴毒，我就教到这了，以后就靠你自己提高了。\n");
	if ((int)me->query("score",1) < 10000)
		return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
	if (random(20)==1) me->add("score",-10);
	return 1;
}


mapping query_action(object me, object weapon)
{
	if (me->query("jm/xuantian"))
		return action2[random(sizeof(action2))];
	else return action[random(sizeof(action))];
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
	int ap,dp,damage2;
	ap = me->query_skill("cuixin-zhang",1);
	dp = victim->query_skill("force",1);
	damage2 = (int)me->query_skill("cuixin-zhang",1);	
	if (me->query("jm/xuantian")) damage2 = me->query_skill("cuixin-zhang",1) + me->query_skill("unarmed",1);
    if( damage_bonus < 100 ) return 0;
	if ( me->query_skill("lingyuan-xinfa",1) < 100)	 return 0;
	if ( me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "lingyuan-xinfa") return 0;	
	if (damage2<10) damage2=10;	

// 第一等级的伤气
	if ( me->query_skill("cuixin-zhang",1)>200
	        && me->query_skill("lingyuan-xinfa",1)>200
	        && me->query_skill("cuixin-zhang",1)>200
			&& random(ap)>dp/10
			&& me->query("jiali")>0
			&& me->query_skill_mapped("force")=="lingyuan-xinfa"
	        && random(7)==1 )
	{
		victim->receive_damage("qi", damage2 +damage_bonus/2,me);
		victim->receive_wound("qi", damage2 +damage_bonus/2,me);
		return HIW "$N暗暗运功将灵元心法的柔劲混入催心掌阴柔的掌力内攻向$n！！！\n" NOR;
	}

//  第二等级的伤气
	if( me->query_skill("cuixin-zhang",1)>500 
	&& me->query("zjb_dj/dj")>=7 
	&& me->query_skill("lingyuan-xinfa",1)>500
	&& random(ap)>dp/10
	&& me->query("jiali")>0
	&& me->query_skill_mapped("force")=="lingyuan-xinfa"	
	&& random(7)==2 
	&& me->query("jm/xuantian"))
	{
		victim->receive_damage("qi", damage2*2+damage_bonus/2,me );
		victim->receive_wound("qi", damage2*2+damage_bonus/2,me );
		return HIB "$N体内的灵元心法的"BLINK HIG"刚劲"NOR HIB"与手中攻出的"BLINK HIM"催心柔劲"NOR HIB"融合为一，化做一股"BLINK BLK"混元真力"NOR HIB"震碎了$n的心脉！！！\n" NOR;
	}

}

int practice_skill(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
	if ( me->query("family/family_name")!="玄天派")
		return notify_fail("你不是本门中人，无法练习本门技能的精髓。\n");
	if ((int)me->query("qi") < 40)
		return notify_fail("你的体力太低了。\n");
	if ((int)me->query("neili") < 10)
        return notify_fail("你的内力不够了！休息一下再练吧。\n");
	me->receive_damage("qi", 30);
	me->add("neili", -5);
	return 1;
}


string perform_action_file(string action)
{
	return __DIR__"cuixin-zhang/" + action;
}

