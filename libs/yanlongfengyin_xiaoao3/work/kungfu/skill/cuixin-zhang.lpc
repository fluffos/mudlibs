	 ]),
([      "action" : "$N身形绕$n一转，一招「"BLINK HIG"风雷并起"NOR"」向$n$l接连出掌",
	"attack":	600,
	"parry":	600,
	"dodge":	600,
	"damage":	600,
	"force":	600,
"skill_name" : "风雷并起",
