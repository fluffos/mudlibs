// /kungfu/skill/cuixin-zhang.c	摧心掌	上乘武学400~1000

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SKILL;

string type()
{
	return "zhongji";
}
