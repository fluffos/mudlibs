int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }

int valid_combine(string combo) { return combo == "luoying-zhang"; }

int valid_learn(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query_temp("weapon"))
    return notify_fail("旋风扫叶腿必须空手。\n");
  if (me->query("family/family_name") != "桃花岛")
    return notify_fail("你不是东邪传人，学不了桃花岛武功。\n");
  if ((int)me->query_skill("bibo-shengong", 1) < 100)
    return notify_fail("你的碧波神功火候不够，无法学旋风扫叶腿。\n");
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力太弱，无法练旋风扫叶腿。\n");
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me) {
  //	if (!wizardp(me))
  //	return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("qi") < 30)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 20)
    return notify_fail("你的内力不够练旋风扫叶腿。\n");
  if (me->query("family/family_name") != "桃花岛")
    return notify_fail("你不是东邪传人，怎么能练习桃花岛技能。\n");
  me->receive_damage("qi", 20);
  me->add("neili", -1);
  return 1;
}
string perform_action_file(string action) {
  return __DIR__ "xuanfeng-tui/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb) {
  int level, level2, ap, dp, damage2;

  level = (int)me->query_skill("bibo-shengong", 1);
  level2 = (int)me->query_skill("xuanfeng-tui", 1);

  ap = level + level2;
  dp = victim->query_skill("dodge", 1);
  damage2 = (int)me->query_skill("xuanfeng-tui", 1);

  if (damage_bonus < 100) return 0;
  if (me->query_skill("bibo-shengong", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "bibo-shengong") return 0;
  if (damage2 < 10) damage2 = 10;
  if (random(6) == 3 && level2 >= 300 && me->query("jiali") > 0 && random(ap) > dp / 10) {
    victim->receive_wound("qi", damage2 + damage_bonus / 2, me);
    victim->receive_damage("qi", damage2 + damage_bonus / 2, me);
    me->add("neili", -100);
    return HIR "$N身法突然加快，双腿快速的踢向$n，$n左闪右躲，最后还是发现衣服上被踩了好几个脚印！！\n";
  }
}
