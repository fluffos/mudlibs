// yijinjing.c 少林 易筋经神功
// Feb.21 1998 by Java
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include "/kungfu/skill/eff_msg.h"
inherit FORCE;

int valid_enable(string usage) {
  return usage == "force";
}

int valid_learn(object me) {
  int i, nb, nf, oh, nh;
  mapping skl;
  string *sname;
  nb = (int)me->query_skill("buddhism", 1);
  nf = (int)me->query_skill("force", 1);
  oh = (int)me->query_skill("hunyuan-yiqi", 1);
  nh = (int)me->query_skill("yijinjing", 1);

  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (oh < 1000)
    return notify_fail("你的混元一气太低，无法学习易筋经！\n");
  if (me->query("couple/have_couple") || me->query("marry"))
    return notify_fail("你已经破了色戒，无法再学习易筋经！\n");
  if (me->query("gender") != "男性")
    return notify_fail("你非童男之体，不能练习易筋经。\n");
  if (me->query("con", 1) < 25)
    return notify_fail("易筋经对根骨要求极高。\n");
  if (me->query("int", 1) < 25)
    return notify_fail("以你的悟性，恐怕一辈子也领悟不到易筋经的精髓。\n");
  if (me->query("family/family_name") != "少林派")
    return notify_fail("你不是佛门中人，无法学习少林易筋经。\n");
  if (nb < 1000)
    return notify_fail("你的禅宗心法修为不够，无法领会更高深的易筋经。\n");
  if (nf < 1000)
    return notify_fail("你的基本内功火候还不够，无法领会易筋经。\n");
  if (nh > oh)
    return notify_fail("你的少林内功火候还不够，无法继续领会易筋经。\n");
  if ((int)me->query("score", 1) < 10000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (!me->query("jm/songshan"))
    return notify_fail(CYN "这嵩山派与我寺同处一山，欲夺取武林盟主之位，我少林表示不服。\n" CYN "这位" + RANK_D->query_respect(me) + CYN "可否先为我少林潜入嵩山派夺取其秘密？我寺将来必有厚报。\n" NOR);
  if ((int)me->query("family_score") < 10)
    return notify_fail(CYN "这位" + RANK_D->query_respect(me) + CYN "对江湖不够了解啊，我寺功夫恐怕不能传授于你。\n" NOR);

  skl = this_player()->query_skills();
  sname = keys(skl);
  for (i = 0; i < sizeof(skl); i++) {
    if (sname[i] == "yijinjing") continue;
    if (sname[i] == "hunyuan-yiqi") continue;
    if (sname[i] == "yijing-force") continue;
    if (sname[i] == "xixing-dafa") continue;
    if (sname[i] == "damo-force") continue;
    if (SKILL_D(sname[i])->valid_enable("force"))
      return notify_fail("你不先散了别派内功，怎能学易筋经神功？！\n");
  }
  if (random(10) == 1) me->add("score", -10);
  return 1;
}

int practice_skill(object me) {
  return notify_fail("易筋经神功只能用学(learn)的来增加熟练度。\n");
}

mapping exercise_msg(object me) {
  return ([
    "status_msg": "脸上佛光隐现，气象庄严\n",
    "start_my_msg": "五心向天，排除一切杂念，内息顺经脉缓缓流动。\n",
    "start_other_msg": me->name() + "五心向天，一会工夫，从口鼻处缓缓吐出白气，白气越吐越浓，渐渐笼罩了全身。\n",
    "heal_my_msg": "双手合什，盘膝而坐，口中念起“往生咒”，开始运功疗伤。\n",
    "heal_other_msg": me->name() + "缓缓站起，只觉全身说不出的舒服畅快，便道：善哉！善哉！本门易筋经当真是天下绝学！\n",
    "halt_msg": "长出一口气，将内息急速退了回去，站了起来。\n",
    "end_my_msg": "你将内息走了个小周天，流回丹田，收功站了起来。\n",
    "end_other_msg": "只见笼罩" + me->name() + "的白气渐渐消散，又从口鼻处吸了回去。\n",
    "hover_my_msg": "低唱“阿弥陀佛”，吐出莲花，缓缓站起，良久，内息慢慢平静，神清气爽。\n",
    "hover_other_msg": me->name() + "一声：“阿弥陀佛”双袖挥动，吐出莲花，良久，内息慢慢平静，站起身来。\n",
  ]);
}

string *fanzhen_msg = ({
  "只震得$n胸内腹中，有如五脏一齐翻转！\n",
  "抢先反震，将$n震得脸如白纸，全无血色！\n",
  "震得$n心肺欲裂，腾腾腾连退数步！\n",
  "功力已布满全身，将$n的力量反震回去！\n",
  "震得$n天旋地转，腾腾腾连退七八步！\n",
  "和$n一撞，只震的$p胸口气血翻涌！\n",
  "$n便如撞在一堵棉花作面，钢铁为里的厚墙上一般，震退数步！\n",
  "$n刚碰到$P，突然身子一震，登时飞了出去！\n",
});

//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage) {
  string msg;
  int ap, dp, p, skill, neili, neili1, j, i = 1;
  object weapon;
  skill = me->query_skill("yijinjing", 1) + me->query_skill("force", 1);
  neili = me->query("neili") + 1;
  neili1 = ob->query("neili") + 1;
  ap = me->query_skill("yijinjing", 1);
  dp = ob->query_skill("force", 1);
  if (damage < 10) damage = 10;
  if (skill > 300) i += me->query_temp("combat_yield");
  if (living(me)
    && me->query_temp("fanzhen")
    && random(skill) * i + 30 > ob->query_skill("parry", 1) / 2
    && random(ap) > dp / 20
    && skill > 199
    && neili > 500
    && living(ob)
    && !ob->query("env/invisibility")
    && random(6) == 0) {
    if (!objectp(weapon = ob->query_temp("weapon"))) {
      me->add("neili", -(10 + random(70)));
      msg = random(2) ? HIR "$N身上生出一股反震之力，" : HIR "$N身上金刚不坏体神功随心而起，";
      if (neili1 > neili * 4 * i || random(damage) > (5000 + me->query_con(1) * 40 * i)) {
        msg += "但却被$n的劲力一招震碎！\n" NOR;
        j = -(damage * 3 + random(damage * 3));
      } else if (neili1 > neili * 3 * i) {
        msg += "但却根本无法阻挡$n的劲力！\n" NOR;
        j = -(damage * 2 + random(damage * 2));
      }

      else if (neili1 > neili * 3 / 2 * i) {
        msg += "结果抵消了部分$n的劲力！\n" NOR;
        j = -(damage + random(damage * 2));
      } else {
        msg += fanzhen_msg[random(sizeof(fanzhen_msg))] + NOR;
        p = (neili / neili1) * i;
        if (damage < 1) damage = 1;
        if (p < 1) p = 1;
        p *= damage / 2;
        if (ob->query_skill("force", 1) > me->query_skill("force", 1) * 3 / 2) p = p * 2 / 3;
        if (p < 10) p = 10;

        if (ob->query("qi") > p) {
          ob->receive_damage("qi", p, me);
          ob->receive_wound("qi", p / 5 * i, me);
        }
        // if(wizardp(me)) tell_object(me, "Fanzhen damage: "+p+"。\n");
        msg += "$N冷哼一声，就你这点力量，滚回家吃奶去吧！\n" NOR;
        p = ob->query("qi") * 100 / ob->query("max_qi");
        msg += "( $n" + eff_status_msg(p) + " )\n";

        j = -(damage + random(damage));
      }
      message_vision(msg, me, ob);
    } else {
      msg = HIR "好似有一堵无形的墙在$N面前阻挡着，";
      switch (weapon->query("skill_type")) {
        case "whip": p = 10; break;
        case "sword": p = 8; break;
        case "hook": p = 6; break;
        case "blade": p = 5; break;
        case "club":
        case "stick": p = 2; break;
        case "staff":
        case "axe":
        case "hammer": p = 1; break;
        default: p = 3; break;
      }
      p *= weapon->query("rigidity");
      if (random(me->query("str") + p) * i > (ob->query("str") + p) / 2 && neili * i > neili1 * 2 / 3) {
        message_vision(
          HIR "结果$N身上生出一股反震之力，$n只觉虎口一热，" + weapon->name() + HIR "顿时脱手而出，飞出丈外！\n\n" NOR,
          me,
          ob
        );
        weapon->unequip();
        weapon->move(environment(ob));
        ob->reset_action();
        msg += "$N大笑道，你这体格弱不禁风的，还是回家再练几年！\n" NOR;
        if (!ob->is_busy()) ob->start_busy(2 + random(3));
        j = -(damage + random(damage));
      } else if (neili * i > neili1 * 2) {
        msg += "结果$n" HIR "一下子被反弹，震得" + ob->name() + HIR "手臂发麻！\n" NOR;
        if (!ob->is_busy()) ob->start_busy(1 + random(3));
        j = -(damage * 4 + random(damage * 3));
      } else if (neili * i > neili1 * 3 / 2) {
        msg += "结果$n" HIR "不能前进一丝一毫！\n" NOR;
        j = -(damage * 3 + random(damage * 3));
      } else if (neili * i > neili1) {
        msg += "结果减缓了$n" HIR "前进的速度！\n" NOR;
        j = -(damage * 2 + random(damage * 2));
      } else if (neili * 2 * i > neili1) {
        msg += "但并没有起到什么作用！\n" NOR;
        j = -(damage + random(damage * 2));
      } else {
        msg += "但却被$n" HIR "一下打破！\n" NOR;
        j = damage + random(damage);
      }
      message_vision(msg, me, weapon);
    }
    me->add("neili", -100);
    return j;
  }
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  int ap, dp, damage2;
  damage2 = (int)me->query_skill("yijinjing", 1);
  ap = me->query_skill("yijinjing", 1);
  dp = victim->query_skill("force", 1);
  if (damage_bonus < 100) return 0;
  if (me->query_skill("yijinjing", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "yijinjing") return 0;
  if (damage2 < 10) damage2 = 10;
  if (random(ap) > dp / 20 && random(6) == 0 && me->query("jiali") > 0) {
    victim->receive_damage("jing", damage2 * 2 + damage_bonus / 2, me);
    victim->receive_wound("jing", damage2 * 2 + damage_bonus / 2, me);
    me->add("neili", -100);
    return HIB "$N发挥出" + HIR + "少林易筋经" NOR HIB "的真髓，混元真气摧毁了$n的精元！！！！\n" NOR;
  }
}

string exert_function_file(string func) {
  return __DIR__ "yijinjing/" + func;
}
