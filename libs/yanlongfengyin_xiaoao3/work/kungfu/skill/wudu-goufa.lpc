int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }

int valid_learn(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
	if ((int)me->query("max_neili") < 10000)
		return notify_fail("你的内力不够。\n");
    if (me->query("family/family_name")!="五毒教")
   return notify_fail("你不是五毒教弟子，不能传授给你。\n");		
	if ((int)me->query_skill("wudu-shengong", 1) < 100)
		return notify_fail("你的五毒神功火候太浅。\n");
	if ((int)me->query("score",1) < 5000)
		return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
	if (random(100)==1) me->add("score",-5);	
	return 1;
}

string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}
mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}


int practice_skill(object me)
{
	object weapon;
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
	if (!objectp(weapon = me->query_temp("weapon"))
	|| (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对。\n");
    if (me->query("family/family_name")!="五毒教")
   return notify_fail("你不是五毒教弟子，练习不了毒功。\n");			
	if ((int)me->query("qi") < 40)
		return notify_fail("你的体力不够练五毒钩法。\n");
	me->receive_damage("qi", 20);
	me->add("neili", -5);
	return 1;
}
mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
	int ap,dp,damage2;
	ap = me->query_skill("wudu-goufa",1) ;
	dp = victim->query_skill("sword",1);
	damage2 = (int)me->query_skill("wudu-goufa",1);	
	
    if( damage_bonus < 100 ) return 0;
	if ( me->query_skill("wudu-shengong",1) < 100)	 return 0;
	if ( me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "wudu-shengong") return 0;	
	if (damage2<10) damage2=10;	

  if( random(ap) > dp/10
	&& me->query("jiali") > 0
	&& me->query_skill_mapped("force")=="wudu-shengong" 
	&& random(6) ==1 ) 
{
		victim->receive_wound("qi", damage2+damage_bonus/2 ,me);
		me->add("neili", -100 );
		return HIB "$N运转五毒神功，剑气乌黑！$n一个不慎，顿时中了一剑，伤口流出一丝黑血！\n" NOR;
	
  if ( victim->query("family/family_name")!= "五毒教" && me->query_skill("wudu-shengong",1)>100) 
  {
	 switch( random(5) ) 
	{
		case 0:
            victim->apply_condition("snake_poison", (me->query_skill("wudu-shengong"))/300 +
			victim->query_condition("snake_poison"));
			break;
		case 1:
            victim->apply_condition("zhizhu_poison", (me->query_skill("wudu-shengong"))/300 +
			victim->query_condition("zhizhu_poison"));
			break;
		case 2:
            victim->apply_condition("wugong_poison", (me->query_skill("wudu-shengong"))/300 +
			victim->query_condition("wugong_poison"));
			break;
		case 3:
            victim->apply_condition("xiezi_poison", (me->query_skill("wudu-shengong"))/300 +
			victim->query_condition("xiezi_poison"));
			break;
		case 4:
            victim->apply_condition("chanchu_poison", (me->query_skill("wudu-shengong"))/300 +
			victim->query_condition("chanchu_poison"));
			break;
	}
        return HIR "$n只觉得伤处一阵发麻，似乎中毒了。\n" NOR;
   }
}
}
string perform_action_file(string action)
{
	return __DIR__"wudu-goufa/" + action;
}
