// zuida.c 八仙醉打

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>
inherit F_SSERVER;

int perform(object me, object target) {
  int i, extra, attack_time;
  string msg;
  object weapon;

  if (!target) target = offensive_target(me);
  if (!target || !me->is_fighting(target) || !living(target))
    return notify_fail("「八仙醉打」只能在战斗中对对手使用。\n");
  if (!objectp(weapon = me->query_temp("weapon")) || weapon->query("skill_type") != "club" || me->query_skill_mapped("club") != "zui-gun")
    return notify_fail("你现在无法使用「八仙醉打」。\n");
  if (target && target->query_temp("apply/shade_vision"))
    return notify_fail("对方隐身了，你看不到" + target->query("name") + "。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");
  if ((int)me->query_skill(
    "hunyuan-yiqi",
    1
  ) < 300 && (int)me->query_skill(
    "yijing-force",
    1
  ) < 300 && (int)me->query_skill(
    "yijinjing",
    1
  ) < 300 && (int)me->query_skill("damo-force", 1) < 300)
    return notify_fail("你佛门内功修为不够，不能使用这一绝技!\n");
  if (me->query_skill_mapped("force") != "yijinjing" && me->query_skill_mapped("force") != "hunyuan-yiqi" && me->query_skill_mapped("force") != "yijing-force" && me->query_skill_mapped("force") != "damo-force")
    return notify_fail("你未使用佛门内功, 不能使用这一绝技 !\n");
  if ((int)me->query_skill("zui-gun", 1) < 500)
    return notify_fail("你的醉棍不够娴熟，不会使用「八仙醉打」！\n");
  if ((int)me->query("str", 1) < 25)
    return notify_fail("你的臂力不够强，不能使用「八仙醉打」！\n");
  if ((int)me->query("max_neili") < 200000)
    return notify_fail("你的内力修为太弱，不能使用「八仙醉打」！\n");
  if ((int)me->query("jingli") < 1000)
    return notify_fail("你的精力不够。\n");
  if ((int)me->query("neili") < (int)me->query_skill("zui-gun", 1) * 4)
    return notify_fail("你的内力太少了，无法使用出「八仙醉打」！\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  extra = (int)me->query_skill("zui-gun", 1);
  attack_time = (int)me->query_skill("zui-gun", 1) / 60;
  message_vision(HIY "\n$N突然一个醉嗝，顿时借着酒劲猛打，醉棍威力大增！\n" NOR, me);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1

  if (random(2) == 0) target->apply_condition("drunk", 30);
  if (attack_time < 1) attack_time = 1;
  if (me->query("jm/shaolin")) {
    if (attack_time > 150) attack_time = 150;
  } else {
    if (attack_time > 50) attack_time = 50;
  }

  me->add_temp("apply/attack", -extra);
  me->add_temp("apply/parry", -extra);
  me->add_temp("apply/dodge", -extra);
  me->add_temp("apply/damage", -extra);
  me->add_temp("lianzhao", attack_time);  //2016.6.1阿飞改，增加连招标记，用于削弱连招伤害	
  for (i = 0; i < attack_time; i++) {
    msg = HIR "$N突然一个醉嗝，不知从何处打出第" + (i + 1) + "棍！\n" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  }
  me->add_temp("apply/attack", extra);
  me->add_temp("apply/parry", extra);
  me->add_temp("apply/dodge", extra);
  me->add_temp("apply/damage", extra);
  me->add("neili", -200 * attack_time);
  me->delete_temp("lianzhao");  //2016.6.1阿飞改，连招结束取消连招标记

  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
