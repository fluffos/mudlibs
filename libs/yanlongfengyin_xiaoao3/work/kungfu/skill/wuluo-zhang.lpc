int valid_enable(string usage) { return usage=="strike" || usage=="unarmed" || usage=="parry"; }

int valid_combine(string combo) { return combo=="jinyu-quan"; }

int valid_learn(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
	if ( me->query("gender") != "女性" )
                return notify_fail("你又不是女人练不了五罗轻烟掌？\n");
    if ((int)me->query("dex", 1) < 30)
        return notify_fail("五罗轻烟掌需要身体轻盈才能练习。\n");
    if ((int)me->query("int", 1) < 30)
        return notify_fail("你笨头笨脑的领会不了五罗轻烟掌。\n");
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练五罗轻烟掌必须空手。\n");
	if ((int)me->query_skill("kumu-shengong",1) < 200)
		return notify_fail("你的枯木神功太弱，无法练五罗轻烟掌。\n");
    if (me->query("family/family_name")!="大理段家")
   return notify_fail("你不是大理段家弟子，不能传授给你。\n");		
	if ((int)me->query("max_neili") < 10000)
		return notify_fail("你的内力太弱，无法练五罗轻烟掌。\n");
	if ((int)me->query("score",1) < 5000)
		return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
	if (random(100)==1) me->add("score",-5);	
	return 1;
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
	if ( me->query("gender") != "女性" )
                return notify_fail("你又不是女人练不了五罗轻烟掌？\n");

	if ((int)me->query("qi") < 50)
		return notify_fail("你的体力太低了。\n");
	if ((int)me->query("neili") < 20)
		return notify_fail("你的内力不够练五罗轻烟掌。\n");
    if (me->query("family/family_name")!="大理段家")
   return notify_fail("这是大理段家不传之密，你一个外人怎么能够练习呢。\n");		
	me->receive_damage("qi", 30);
	me->add("neili", -10);
	return 1;
}


mixed hit_ob(object me, object victim, int damage_bonus)
{

		int ap,dp,damage2;
        int level= (int) me->query_skill("wuluo-zhang",1);  
		ap = (int) me->query("dex",1) * (int) me->query_skill("wuluo-zhang",1);
		dp = (int) victim->query("dex",1) * (int) me->query_skill("parry",1);
	damage2 = (int)me->query_skill("wuluo-zhang",1);
    if( damage_bonus < 100 ) return 0;
	if ( me->query_skill("kumu-shengong",1) < 100)	 return 0;
	if ( me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "kumu-shengong") return 0;	
	if (damage2<10) damage2=10;		
	if (random(5) == 0 && level > 300 && me->query("neili") > 500 && random(ap)>dp/10 && me->query("jiali")>0)
	{
		me->add("neili", -100 );
		victim->receive_wound("qi", damage2+damage_bonus/2 ,me);
		victim->receive_damage("qi", damage2+damage_bonus/2 ,me); 
		return HIY"$N越战越猛，双掌逐渐笼罩在烟雾之中，$n越发难以看见$N的掌式，不知不觉间已中了好几掌。\n"NOR;
	}      
}

string perform_action_file(string action)	
{
return __DIR__"wuluo-zhang/" + action;	
}

