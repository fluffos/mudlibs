#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;
int perform(object me, object target)
{
	string msg;
	int extra,damage;
	object weapon;
	

	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("［八方藏刀式］只能对战斗中的对手使用。\n");	
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "blade")
		return notify_fail("你使用的武器不对。\n");
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
	if (me->query_skill_mapped("blade") != "zijinbagua-dao")
		return notify_fail("你没正确激发该技能 。\n");
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");
	if( (int)me->query_skill("zijinbagua-dao",1) < 300)
		return notify_fail("你目前功力还使不出「八方藏刀式」。\n");
	if( (int)me->query("jingli") < 1000)
		return notify_fail("你目前精力不够,还使不出「八方藏刀式」。\n");
	if( (int)me->query("neili") < 1000)
		return notify_fail("你目前内力不够,还使不出「八方藏刀式」。\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	extra = me->query_skill("zijinbagua-dao",1);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1	
	me->add_temp("apply/attack",extra);
	me->add_temp("apply/damage",extra);	
	msg = HIY  "$N使出紫金八卦刀中的［八方藏刀式］，假意抽身急退，脚踏谦位反身劈出一刀！" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
	msg = HIY  "$N紧跟着脚踏坤位，反手又是一刀！！" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
	msg = HIY  "$N竟然不回头，反身一转，脚踏坎位，又是一刀！" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
	msg = HIY  "$N跨步直上，脚踏离位，迎面照着$n面门就是一刀！" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);	
	me->add_temp("apply/attack",-extra);
	me->add_temp("apply/damage",-extra);		
	damage = extra + random(extra);
	target->receive_damage("qi", damage,me);
	if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"。\n" NOR);
	me->add("neili",-300);
	me->add("jingli", -300);
	me->start_busy(1);
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}