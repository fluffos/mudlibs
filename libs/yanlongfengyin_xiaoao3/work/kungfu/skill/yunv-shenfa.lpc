// yunv-shengfa 玉女身法
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SKILL;

string *dodge_msg = ({
HIW"$n一招「洛神凌波」，长袖舞动，掩住身形去处，轻飘飘腾身丈外，躲过了$N这一招。\n"NOR,
HIR"$n嫣然一笑，风姿绝代，$N惊为天人，手下不由一顿，$n已借这「一笑倾国」之势，
避开了$N的凌厉攻势。\n"NOR,
 HIG"$n使出「贵妃醉酒」，满面红晕，脚步踉跄中已饶至$N的身后。\n"NOR,
HIC"$n左足点地，眼看$N杀招堪堪袭来，左膝一弯，右腿踢出，正是一招「红拂夜奔」，
身躯已借势平移，闪过一旁。\n"NOR,
HIY"$n一式「绿珠坠楼」，身体贴地滑行，真叫人匪夷所思，令$N的攻击已然扑空。\n"NOR,
});

int valid_enable(string usage) { return (usage == "dodge") ; }

int valid_learn(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	    if (me->query("family/family_name")!="古墓派")
   return notify_fail("你不是古墓派弟子，无法学习玉女身法。\n");
        if ((int)me->query("max_neili") < 10000)
                return notify_fail("你的内力不够。\n");
        if ((int)me->query("per",1) < 25)
                return notify_fail("玉女身法岂是丑八怪能练的。\n");
        if (me->query_skill("yunv-shenfa", 1) >= me->query_skill("dodge",1))
                return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
        if (me->query_skill("yunv-xinjing",1)<100 && me->query_skill("yunv-xinfa",1)<100)			
                return notify_fail("你的玉女心经功力不够。\n");
        return 1;
}

string query_dodge_msg(object me,string limb)
{
	 if (me) me->set_temp("fight/dodge",random(2*me->query_skill("yunv-shenfa",1)));
        return dodge_msg[random(sizeof(dodge_msg))];

}

int practice_skill(object me)
{
	//	if (!wizardp(me))
	//	return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
		    if (me->query("family/family_name")!="古墓派")
   return notify_fail("你不是古墓派弟子，无法练习玉女身法。\n");
          if((int)me->query("qi") < 30 )
         return notify_fail("你该休息一下了，等会再练玉女身法吧。\n");
	 
          me->receive_damage("qi", 30);
        return 1;
}
string perform_action_file(string action)
{
        return __DIR__"yunv-shenfa/" + action;
}
	//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{

        int j,ap,dp,neili,neili1;
		ap = me->query_skill("yunv-shenfa", 1) * me->query("per",1);
		dp = ob->query_skill("dodge", 1) * ob->query("str",1);

        neili = me->query("neili");
        neili1 = ob->query("neili");

	if (damage <10)  damage=10;      	
      if(random(ap) > dp/10
		&& (me->query_skill("yunv-xinfa",1) > 100 || me->query_skill("yunv-xinjing",1) > 100)
		&& me->query_skill("yunv-shenfa", 1) > 200
		&& (me->query_skill_mapped("force") == "yunv-xinfa" || me->query_skill_mapped("force") == "yunv-xinjing")
        && me->query("neili") > 1000
		&& random(5)==0	)
        { 	
        message_vision(HIG"$N使出一招【玉女献身】，身姿妩媚至极，$n看呆了，神魂颠倒！。\n"NOR, me, ob); 		
		if (!ob->is_busy()) ob->start_busy(1);
		me->add("neili", -100 );
           if(neili >= random(neili1)+damage)
		   {
              message_vision( HIC"$n被你的娇媚迷的心软不已，下手轻飘飘的！\n"NOR, me, ob);
              message_vision( HIB"$n看的口水直流，哎呀！这么个大美女怎么好意思出手呢！\n"NOR, me, ob);
              j = -(damage+random(damage));  
            }           
           return j;
        }          
}
