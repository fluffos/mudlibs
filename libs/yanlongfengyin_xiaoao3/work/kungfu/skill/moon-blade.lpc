string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me)
{
        object weapon;

//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
        if( !objectp(weapon = me->query_temp("weapon") )
         || weapon->query("skill_type") != "blade" )
                return notify_fail("你使用的武器不对。\n");

        if( me->query("qi")<70 )
                return notify_fail("你的体力不够，练不了圆月弯刀。\n");

        if( me->query("neili")<70 )
                return notify_fail("你的内力不够，练不了圆月弯刀。\n");

        if (! me->present("moon blade") && me->query_skill("moon-blade") < 400)
                return notify_fail("你的圆月刀法大成之前必须有圆月弯刀配合才能练习。\n");

        me->receive_damage("qi", 55);
        me->add("neili", -61);
        return 1;
}

mixed hit_ob(object me, object victim, int damage)
{
        int lvl;
		string msg;
		lvl = me->query_skill("moon-blade", 1);
		lvl *= 2;
        if (damage < 100) return 0;

        if (random(damage) > victim->query_str() / 10)
        {
                victim->receive_wound("qi", lvl,me);
				me->add("neili",-100);
                msg =  HIW "$N" HIW "仰天一啸，刀劲迸发，满天具是雪亮的刀光，犹如满月的月光般美丽，\n"
                           "但却让人感到落入森罗地狱般，全身止不住的战抖，\n"
                            HIR "霎时一股冰寒的刀气掠过$n" HIR "全身，$n" HIR "全身顿时鲜血淋漓，摇摇欲倒。\n" NOR ;

                return msg;
        }
}

string perform_action_file(string action)
{
        return __DIR__"moon-blade/" + action;
}
