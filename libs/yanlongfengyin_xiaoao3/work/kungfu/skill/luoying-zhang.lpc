int valid_enable(string usage)
{
	return usage=="strike" ||  usage=="parry"|| usage=="unarmed";
}

int valid_combine(string combo)
{
	return combo=="xuanfeng-tui";	
}

int valid_learn(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练落英神剑掌必须空手。\n");
    if (me->query("family/family_name")!="桃花岛")
   return notify_fail("你不是桃花岛弟子，无法学习本门技能。\n");	
	if ((int)me->query_skill("bibo-shengong", 1) < 100)
		return notify_fail("你的碧波神功火候不够，无法学落英神剑掌。\n");
	if ((int)me->query("max_neili") < 10000)
		return notify_fail("你的内力太弱，无法练落英神剑掌。\n");
	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
		if(level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if ((int)me->query("qi") < 30)
		return notify_fail("你的体力太低了。\n");
	if ((int)me->query("neili") < 20)
		return notify_fail("你的内力不够练落英神剑掌。\n");
    if (me->query("family/family_name")!="桃花岛")
   return notify_fail("你不是桃花岛弟子，无法练习本门技能。\n");	
	me->receive_damage("qi", 20);
	me->add("neili", -1);
	return 1;
}
string perform_action_file(string action)
{
	return __DIR__"luoying-zhang/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb)
{
	int level,level2,level3,level4,ap,dp,damage2;

	level = (int) me->query_skill("bibo-shengong",1);
	level2 = (int) me->query_skill("luoying-zhang",1);
	level3 = (int) me->query_skill("qimen-wuxing",1);
	level4 = (int) me->query_skill("luoying-shenjian",1);
	ap = level + level2 + level3 + level4;
	dp = victim->query_skill("force",1) + victim->query_skill("dodge",1);
	damage2 = (int)me->query_skill("luoying-zhang",1);	
	
    if( damage_bonus < 100 ) return 0;
	if ( me->query_skill("bibo-shengong",1) < 100)	 return 0;
	if ( me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "bibo-shengong") return 0;	
	if (damage2<10) damage2=10;	
	if (random(6)==3 && level2>=300 && me->query("jiali")>0 && random(ap)>dp/10 )
	{
		victim->receive_wound("qi", damage2+damage_bonus/2,me );
		me->add("neili", -100);
//		if (!victim->is_busy()) victim->start_busy(2);
		return HIR "$N脚踏五行，施展开落英神剑掌，落英缤纷，$n被桃花迷住了双眼，顿时被打的如桃花般灿烂！！\n";
	}
}
	//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{

	string msg, *limbs;
	int ap,dp,j;

	limbs = ob->query("limbs");
	ap = me->query_skill("luoying-zhang", 1);
	dp = ob->query_skill("force", 1);
	if (  random(ap)>dp/10 && random(5)==1 && me->query("neili")>100 && me->query_skill_mapped("parry") == "luoying-zhang" && me->query_skill_mapped("force") == "bibo-shengong")
	{
		msg = HIC"$n出招时，$N脚踏五行，$n心头一乱!\n"NOR;
		if (!ob->is_busy()) ob->start_busy(2+random(2));
		me->add("neili",-100);
		j = -damage/2;
		return j;
	}

}