// shenghuo.c 圣火不灭
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>
inherit F_SSERVER;
#include "/kungfu/skill/eff_msg.h";

int perform(object me, object target)
{        
	object weapon;
	int damage,ap,dp;

	if( !target) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("「圣火不灭」只能对战斗中的对手使用。\n");
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n"); 
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
		return notify_fail("你必须使用武器来传递「圣火不灭」内劲！\n");   
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
	if( (int)me->query_skill("shenghuo-shengong",1) < 300 )
		return notify_fail("你的圣火神功等级不够，不能施展「圣火不灭」内劲！\n");
	if( (int)me->query_skill("shenghuo-jian",1) < 300 )
		return notify_fail("你的圣火剑法等级不够，不能施展「圣火不灭」内劲！\n");
	if ( !wizardp(me) && me->query_skill_mapped("force") != "shenghuo-shengong")
		return notify_fail("不使用本门内功，如何使用本门绝学!\n"); 
	if (me->query_skill_mapped("sword") != "shenghuo-jian")
		return notify_fail("你没正确激发该技能 。\n");
	if( (int)me->query_skill("force", 1) < 1000 )
		return notify_fail("你的基本内功等级不够，不能施展「圣火不灭」内劲！\n");
	if( (int)me->query("neili") < 1000 )
		return notify_fail("你的真气不足，不能施展「圣火不灭」内劲！\n");
	if( (int)me->query("max_neili") < 100000 )
		return notify_fail("你的内力不足，不能施展「圣火不灭」内劲！\n");
	if( (int)me->query("jingli") < 1000 )
		return notify_fail("你的精力不足，不能施展「圣火不灭」内劲！\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	ap = me->query("xyzx_sys/level") + me->query_skill("shenghuo-jian", 1) + me->query_skill("sword") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
    tell_object(me, HIW"\n你悄悄使出"BLU"「圣火不灭」"HIW"，运起一股无形无质的灼热之气，直插"+target->name()+"胸口玉堂穴要穴！\n"NOR); 
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1
    if(random(ap) > dp/3)
	{                
           damage = me->query_skill("shenghuo-jian",1)*3 + me->query_skill("shenghuo-shengong",1);
           damage = damage + random(damage);

           if(damage > 10000)
		    {
              tell_object(target, HIB"\n突然之间，一股无形无质、利如钢刃的灼热之气直插入你胸口的“玉堂穴”中！"HIR"你霎时之间气息散乱，全身动弹不得！\n"NOR);
              if (!target->is_busy()) target->start_busy(3);
            }
           else
		    {
              tell_object(target, HIY"\n突然之间，一股利如钢刃般的灼热之气直插你胸口的玉堂穴！幸好你护体神功遍护全身，这股「圣火不灭」虽利，却也伤你不得！\n"NOR);
              tell_object(me, HIY"你连运「圣火不灭」的内劲，但见对方竟是毫不费力的抵挡了下来！\n"NOR);
            }

           target->receive_damage("qi", damage,me);
           target->receive_wound("qi", damage/3,me);
           target->add("neili", -damage); 
           tell_room(environment(target), HIR + target->name()+"突然全身猛地一震，面如金纸，震退了数步，彷佛被什么人在胸口处猛击了一下似的！\n" NOR, ({ target })); 
			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/3 +"，杀内力"+ damage +"。\n" NOR);    
           if(!target->is_killing(me->query("id"))) target->kill_ob(me);      
           me->add("neili", -400);
		   me->add("jingli", -400);
    }
    else 
	{       
          me->add("neili", -100);
          tell_object(me, HIY"结果「圣火不灭」内劲还没触到"+target->name()+"的身体便已经散了。\n"NOR);        
    }
	me->start_busy(1);
    return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}