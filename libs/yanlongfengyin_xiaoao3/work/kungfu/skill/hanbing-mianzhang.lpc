int valid_enable(string usage)
{
	return usage=="unarmed" || usage=="parry" ;
}
int valid_combine(string combo)
{
	return combo=="sougu";
}
int valid_learn(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练寒冰绵掌必须空手。\n");
    if (me->query("family/family_name")!="明教")
   return notify_fail("你未加入明教，无法学习韦一笑的绝技。\n");	
    if ((int)me->query_skill("shenghuo-shengong", 1) < 200)		
        return notify_fail("你最好先学点圣火神功，不然寒毒反噬可不是闹着玩的。\n");
	if ((int)me->query("max_neili") < 10000)
		return notify_fail("你的内力太弱，无法练寒冰绵掌。\n");
	if ((int)me->query("score",1) < 5000)
		return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
	if (random(100)==1) me->add("score",-5);
	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
		if(level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if ((int)me->query("qi") < 30)
		return notify_fail("你的体力太低了。\n");
	if ((int)me->query("neili") < 40)
		return notify_fail("你的内力不够练寒冰绵掌。\n");
    if (me->query("family/family_name")!="明教")
   return notify_fail("你未加入明教，练习不了韦一笑的绝技。\n");	
	me->receive_damage("qi", 30);
	me->add("neili", -10);
	return 1;
}



string perform_action_file(string action)
{
	return __DIR__"hanbing-mianzhang/" + action;
}


mixed hit_ob(object me, object victim, int damage_bonus)
{

		int ap,dp,level,damage2;
        level = (int) me->query_skill("hanbing-mianzhang",1);  
		ap = (int) me->query("com",1) * (int) me->query_skill("hanbing-mianzhang",1);
		dp = (int) victim->query("con",1) * (int) me->query_skill("force",1);
		damage2 = (int)me->query_skill("hanbing-mianzhang",1);	
	
    if( damage_bonus < 100 ) return 0;
	if ( me->query_skill("shenghuo-shengong",1) < 100)	 return 0;
	if ( me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "shenghuo-shengong") return 0;	
	if (damage2<10) damage2=10;	
	
        if (random(5) == 0 && level > 100 && me->query("neili") > 500 && random(ap)>dp/10 && me->query("jiali")>0)
		{
           message_vision(HIY"$N双掌结冰，一掌拍来，寒气大盛！。\n"NOR, me, victim); 
           me->add("neili", -100 );
  //         if (!victim->is_busy()) victim->start_busy(random(3));
           message_vision(CYN"$n与$N拼斗了几招，看似无关紧要，但是已经被寒气入体！。\n"NOR, me, victim);    
		   victim->receive_wound("qi", damage2+damage_bonus/2,me);
		   victim->receive_damage("qi", damage2+damage_bonus/2,me );
		   victim->apply_condition("ice_poison", random(me->query_skill("hanbing-mianzhang",1)/100) + 6 );

        }

	return;
}
     