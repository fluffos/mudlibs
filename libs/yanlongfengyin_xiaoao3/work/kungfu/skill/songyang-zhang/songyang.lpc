// songyangjue.c by darken@SJ
// Lklv@SJ modified 2001.10.22

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>

inherit F_DBASE;
inherit F_SSERVER;

int perform(object me, object target)
{
	object weapon;
	string msg;
	int ap,dp,extra,damage, neili, neili2;
	int addqi,addjing,addneili,addjingli;

	if (!target ) target = offensive_target(me);
	if (!target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("嵩阳诀只能对战斗中的对手使用。\n");
	if (objectp(weapon = me->query_temp("weapon")) )
		return notify_fail("你还是先下了武器再说吧！\n");
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");	
	if( me->query_skill("hanbing-zhenqi", 1) < 1000 )
		return notify_fail("你的寒冰真气不够，无法施展「嵩阳诀」！\n");
	if( me->query_skill("songshan-jian", 1) < 1000 )
		return notify_fail("你的嵩山剑法修为不够，还不能使用「嵩阳诀」！\n");
	if( me->query_skill("songyang-zhang", 1) < 1000 )
		return notify_fail("你对大嵩阳掌认识还不够，无法施展「嵩阳诀」！\n");
    if( me->query("max_neili")<1000000 ) 
        return notify_fail("你此时的内力修为不足，难以施展「嵩阳诀」。\n"); 
    if( me->query("max_jingli")<200000 ) 
        return notify_fail("你此时的精力修为不足，难以施展「嵩阳诀」。\n"); 			
    if( me->query("neili")<10000 ) 
        return notify_fail("你此时的内力不足，难以施展「嵩阳诀」。\n"); 
    if( me->query("jingli")<10000 ) 
        return notify_fail("你此时的精力不足，难以施展「嵩阳诀」。\n"); 	 
	if( me->query_skill_mapped("sword") != "songshan-jian"  )
		return notify_fail("你必须使用嵩山剑法！\n");
	if( me->query_skill_mapped("force") != "hanbing-zhenqi"  )
		return notify_fail("你必须使用寒冰真气！\n");	
//	if (!(int)me->query("breakup"))
//		return notify_fail("你任督二脉未通,无法使用「嵩阳诀」。\n"NOR);	
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	ap = me->query("xyzx_sys/level") + me->query_skill("songshan-jian", 1) +me->query_skill("songyang-zhang", 1)+ me->query_skill("unarmed") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	damage = me->query_skill("songshan-jian",1) + me->query_skill("songyang-zhang",1) + me->query_skill("hanbing-zhenqi",1);
	extra = me->query_skill("songshan-jian", 1) +me->query_skill("songyang-zhang", 1);	
//	message_vision(HBWHT "$N贯通嵩山派武学，使出了嵩山派的绝学之精髓！\n" NOR, me, target);		
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 5, me);	//CD写法1	
	message_vision(HIR "$N使出嵩山派失传已久的绝技---【嵩阳诀】！剑带寒冰，掌附烈阳，寒阳交替，变幻无穷！\n" NOR, me, target);	
	message_vision(HIC"\n$N伸出左手拇指、食指、中指三根手指，握住了剑尖，右手一松，突然弹起，剑柄在前，不住地晃动。\n"
					"\n突然$N绕着$n快速攻击，连续三剑，人剑合一，幻作一条金龙腾空而起，自半空中横过，剑身似曲似直，倏的罩向$n！\n\n"NOR, me, target);
	me->add_temp("apply/attack",extra);
	me->add_temp("apply/damage",extra);
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
	me->add_temp("apply/attack",-extra);
	me->add_temp("apply/damage",-extra);	
	me->add("neili", -500);
	me->add("jingli", -300);
	damage = damage + random(damage);
	target->receive_damage("qi", damage,me);
	target->receive_wound("qi", damage/2,me);
	if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);

if(me->query_skill("songshan-jian",1)>2000 && me->query_skill("songyang-zhang",1)>2000)
{
	message_vision(HIW"\n$N长啸一声，剑法突变，手中剑向后一背，电石火光间猛然施展出大嵩阳掌的招数！\n" NOR, me,target);
	damage = me->query_skill("songshan-jian",1) + me->query_skill("songyang-zhang",1) + me->query_skill("hanbing-zhenqi",1) + me->query_skill("force") + me->query_skill("unarmed");
	damage = damage + random(damage);
	if (random(ap) > dp/3)
	{
		message_vision(YEL"\n$N右手衣袖鼓了起来，犹似吃饱了风的帆篷一般，全身劲力都集中到了右臂之上，全力向着$n刺出。\n"NOR, me,target);
		message_vision(HIB"\n$N将「寒冰诀」发挥得淋漓尽致，身周寒光大盛！\n" NOR,me,target);
		target->receive_damage("qi", damage,me);
		target->receive_wound("qi", damage,me);
		target->receive_damage("jing", damage,me);
		target->receive_wound("jing", damage,me);
		target->add("neili",-damage);
		target->add("jingli",-damage);
		me->add("neili", -2000);
		me->add("jingli", -3000);
		message_vision(HIR"\n$n被这招乾坤一掷的猛击当胸一撞，立时口中鲜血狂喷而出！\n"NOR, me,target);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage +"，精神的外伤为"+ damage +"，内伤为"+ damage +"，杀内力"+ damage +"，杀精力"+ damage +"。\n" NOR);
	}
	else
	{
		message_vision(CYN"突然之间，白影急晃，$n向后滑出丈余，立时又回到了原地。\n"NOR, me,target);
		message_vision(CYN"$n一退一进之间，$N的这一招剑掌无从受力，只好自己承受了这道反噬掌力。\n"NOR, me,target);
		me->add("neili", -1000);
		me->add("jingli", -1000);
		me->receive_damage("qi", damage/2,target);
		me->receive_wound("qi", damage/2,target);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对自己气血的外伤为"+ damage/2 +"，内伤为"+ damage/2 +"。\n" NOR);		
	}
	
	msg = CYN "\n$N"CYN"凝聚寒冰真气于双掌之上，左掌凛冽如霜，右掌骄阳似火，正是以弱击强的「峻极神掌」";
	msg += CYN "\n只听“啪”的一声响，$N"CYN"抢上前，对着$n"CYN"迅速击出一掌，";
	msg += "$n慌忙出手，无从躲闪只好硬拼，双掌随即相交！\n"NOR;	
	message_vision(msg, me, target);
	neili = me->query("neili");
	neili2 = target->query("neili");
	me->add("neili", -1000);
	me->add("jingli", -1000);
	if( random(ap) < dp/3)
	{
		msg = "结果相拼之下，$n立占上风，将$N一下子震了开来！\n"NOR;
		message_vision(msg, me, target);
		damage = 300+ target->query_skill("force") * 3;
		damage = damage + random(damage);
		me->receive_damage("qi", damage,  target);
		me->receive_wound("qi", damage, target);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对自己气血的外伤为"+ damage +"，内伤为"+ damage +"。\n" NOR);
	}
	else if( random(neili) < neili2/3)
	{
		msg = CYN "\n$N"CYN"微微一笑，双掌陡然相交，$n"CYN"欲待再催内力，已然不及，$N的掌力如排山倒海般压到！\n"NOR;
		message_vision(msg, me, target);
		damage = me->query_skill("force") + (int)me->query("jiali") * (3+random(5));
		if(neili > neili2*2) damage *= 2;
		if(damage < 10) damage = 10;
		damage = damage + random(damage);
		target->receive_damage("qi", damage,  me);
		target->receive_wound("qi", damage, me);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage +"。\n" NOR);
	}
	else 
	{
		msg = "结果相拼之下，两人都晃了一晃，谁也没有占到好处！\n";
		message_vision(msg, me, target);
	}
}


if(me->query_skill("songshan-jian",1)>3000 && me->query_skill("songyang-zhang",1)>3000)
{
	message_vision(HIW"\n$N飞升挥剑，举剑挺刺，在半空中划出道道剑光，空中气劲激荡，阵阵寒气与烈阳交替向$n奔袭而去！！\n" NOR, me,target);
	if (me->query("jm/songshan")) damage = me->query("jiali") + me->query_skill("songshan-jian",1)*me->query("str",1)*3/150 + me->query_skill("songyang-zhang",1)*me->query("str",1)*3/150 + me->query_skill("hanbing-zhenqi",1)*me->query("con",1)*3/150 + me->query_skill("force",1) + me->query_skill("unarmed",1) + me->query_skill("sword",1);
	else damage = me->query_skill("songshan-jian",1)*me->query("str",1)/60 + me->query_skill("songyang-zhang",1)*me->query("str",1)/60 + me->query_skill("hanbing-zhenqi",1)*me->query("con",1)/60+me->query_skill("force",1)+me->query_skill("unarmed",1)+me->query_skill("sword",1)+me->query("jiali");
	damage = damage + random(damage);
	if (random(ap) > dp/3)
	{
		message_vision(HIY"\n$N将「嵩阳诀」与「寒冰诀」融会贯通，两种内力发挥得淋漓尽致！\n" NOR,me,target);
		message_vision(HIB"\n$N周身寒意与烈阳交替自如，一会寒如冰，一会热如火！\n" NOR,me,target);
		message_vision(HIC"\n$n受到这种寒热交替的内劲侵入，一时浑身冻的发抖，一时又如烈火焚身！\n" NOR,me,target);
		target->receive_damage("qi", damage,me);
		target->receive_wound("qi", damage,me);
		target->receive_damage("jing", damage,me);
		target->receive_wound("jing", damage,me);
		target->add("neili",-damage);
		target->add("jingli",-damage);
		me->add("neili", -3000);
		me->add("jingli", -1000);
		message_vision(HIR"\n$n被烈阳与寒冰内劲蹂躏的如癫如狂，一会吐出一口带冰渣的血，一会又吐出一口滚烫的鲜血！\n"NOR, me,target);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage +"，精神的外伤为"+ damage +"，内伤为"+ damage +"，杀内力"+ damage +"，杀精力"+ damage +"。\n" NOR);
	}
	else
	{
		message_vision(HIM"$n武学修为深厚，引导寒、热二气相互平衡，一寒一热流转全身，顿时精气神大振！。\n"NOR, me,target);
		me->add("neili", -1000);
		me->add("jingli", -1000);
		if (target->query("eff_qi") < target->query("max_qi") )			
		{
			addqi = target->query("max_qi") - target->query("eff_qi");
			target->add("eff_qi", addqi/2);	
			target->add("qi", addqi/2);
			message_vision(HIM"$n引导寒、热二气流转经脉，伤势似乎好了不少。\n"NOR, me,target);
			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招造成敌人气血恢复"+ addqi/2 +"。\n" NOR);
		}
		if (target->query("eff_jing") < target->query("max_jing") )			
		{
			addjing = target->query("max_jing") - target->query("eff_jing");
			target->add("eff_jing", addjing/2);	
			target->add("jing", addjing/2);
			message_vision(HIM"$n引导寒、热二气流转经脉，精神似乎好了不少。\n"NOR, me,target);
			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招造成敌人精神恢复"+ addjing/2 +"。\n" NOR);
		}		
		if (target->query("neili") < target->query("max_neili") )			
		{
			addneili = target->query("max_neili") - target->query("neili");
			target->add("neili", addneili/2);
			message_vision(HIM"$n引导寒、热二气流转经脉，损失的内力似乎回复了不少。\n"NOR, me,target);
			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招造成敌人内力恢复"+ addneili/2 +"。\n" NOR);
		}	
		if (target->query("jingli") < target->query("max_jingli") )			
		{
			addjingli = target->query("max_jingli") - target->query("jingli");
			target->add("neili", addjingli/2);
			message_vision(HIM"$n引导寒、热二气流转经脉，损失的精力似乎回复了不少。\n"NOR, me,target);
			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招造成敌人精力恢复"+ addqi/2 +"。\n" NOR);
		}						
	}

	msg = HIY"使出大嵩阳掌的绝技「阴阳掌」，双掌远远一推一拉，$n顿觉一股\n"HIB"寒气"HIY"袭上身来，登时机伶伶打了个冷战。$n只一呆，一股"HIR"炙热的掌风"HIY"跟着扑到，击得$n几乎窒息，身子晃了几晃。\n"NOR;
	message_vision(msg, me, target);
	if(random(ap) > dp/3)
	{
		if (me->query("jm/songshan")) damage = me->query("jiali") + me->query_skill("songshan-jian",1)*me->query("str",1)*3/90 + me->query_skill("songyang-zhang",1)*me->query("str",1)*3/90 + me->query_skill("hanbing-zhenqi",1)*me->query("con",1)*3/90 + me->query_skill("force",1) + me->query_skill("unarmed",1) + me->query_skill("sword",1);
		else damage = me->query_skill("songshan-jian",1)*me->query("str",1)/60 + me->query_skill("songyang-zhang",1)*me->query("str",1)/60 + me->query_skill("hanbing-zhenqi",1)*me->query("con",1)/60+me->query_skill("force",1)+me->query_skill("unarmed",1)+me->query_skill("sword",1)+me->query("jiali");
		damage = damage + random(damage);	
	  if( me->query("neili") > target->query("neili") ) 
	  {
			msg = HIR"掌力击在$n胸口，打得$n身子飞了出去。\n"NOR;
			message_vision(msg, me, target);
			target->receive_damage("qi", damage,me);
			target->receive_wound("qi", damage,me);
			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage +"。\n" NOR);
			me->add("neili", -1000);
			me->add("jingli", -1000);
	  } 
	  else
	  {
			msg = HIB"这一阴一阳两股掌力打在$n身上，$n体内真气自然而然生出相应之力，护住心脉内脏，不受损伤。但霎时间全身剧震，说不出的难受。\n"NOR;
			message_vision(msg, me, target);
			target->receive_damage("qi", damage/2,me);
			target->receive_wound("qi", damage/2,me);
			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage/2 +"，内伤为"+ damage/2 +"。\n" NOR);
			me->add("neili", -500);
	  }
	}
	else 
	{     
	  	msg=HIG "结果$p看破了$P的企图，身行后跃，避开了$P的掌力。\n" NOR;
		message_vision(msg, me, target);
 	    me->add("neili", -500);
    }	
}
	me->start_busy(1);	
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}