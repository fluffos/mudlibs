int valid_enable(string usage) { return usage=="cuff" ||  usage=="parry" ||  usage=="unarmed"; }  

int valid_learn(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
   return notify_fail("练飞血拳必须空手。\n");
    if (me->query("family/family_name")!="血河派")
   return notify_fail("你未加入血河派，无法学习本门技能。\n");
    if ((int)me->query_skill("huaxue-dafa", 1) < 100 && (int)me->query_skill("yiqiguan-riyue", 1) < 100 && (int)me->query_skill("longmen-shengong", 1) < 100)
   return notify_fail("你的内功心法火候不够，无法练飞血拳。\n");
    if ((int)me->query("max_neili") < 10000)
   return notify_fail("你的内力太弱，无法练飞血拳。\n");
    if ((int)me->query("con",1) < 30)
   return notify_fail("你的体质太弱，无法练飞血拳。\n");
    return 1;
}

string query_skill_name(int level)
{
    int i;
    for(i = sizeof(action)-1; i >= 0; i--)
   if(level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	    if (me->query("family/family_name")!="血河派")
   return notify_fail("你未加入血河派，无法练习本门技能。\n");
    if ((int)me->query("qi") < 40)
   return notify_fail("你的体力太低了。\n");
    if ((int)me->query("neili") < 30)
   return notify_fail("你的内力不够练飞血拳。\n");
    me->receive_damage("qi", 20);
        return 1;
}

string perform_action_file(string action)
{
                return __DIR__"feixue-quan/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{

		int ap,dp,level,flag,damage2;
		flag = 1;
        level = (int) me->query_skill("feixue-quan",1);  
		ap = (int) me->query("con",1) * (int) me->query_skill("feixue-quan",1);
		dp = (int) victim->query("dex",1) * (int) me->query_skill("parry",1);
		damage2 = (int) me->query_skill("feixue-quan",1);  
        if( damage_bonus < 100 ) return 0;
		if (me->query_skill("huaxue-dafa",1)<200 &&  me->query_skill("yiqiguan-riyue",1)<200 && me->query_skill("longmen-shengong",1)<100) return 0;
		if ( me->query_skill_mapped("force") != "huaxue-dafa" && me->query_skill_mapped("force") != "yiqiguan-riyue" && me->query_skill_mapped("force") != "longmen-shengong") return 0;
		if ( me->query("jiali") < 1 || me->query("neili") < 100 ) return 0;	
		if (damage2<10) damage2=10;	
		
		if ( me->query_skill_mapped("force") == "longmen-shengong" ) flag =2;
		if ( me->query_skill_mapped("force") == "huaxue-dafa" ) flag =3;
		if ( me->query_skill_mapped("force") == "yiqiguan-riyue" ) flag =1;
	if (random(6) == 2 && level > 100 && me->query("neili") > 500 && random(ap)>dp/10 && me->query("jiali")>0)
		{
        message_vision(HIY"$N双拳血光大盛，拳头血气迷漫。$n与你对了一掌，只觉得血气侵入经脉，难受至极！。\n"NOR, me, victim); 
        me->add("neili", -100 ); 
		victim->receive_wound("qi", damage2*flag+damage_bonus/2,me );
		victim->receive_damage("qi", damage2*flag+damage_bonus/2,me );
		victim->apply_condition("wuxing_poison",5*flag);
        }

	return;
}