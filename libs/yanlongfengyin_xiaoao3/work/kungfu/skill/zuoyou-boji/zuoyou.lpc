//zuoyou.c -「左右搏击」
// Modified by Venus Oct.1997
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target)
{
	int extra,damage;

	if( !target ) target = offensive_target(me);
	if( !target||!target->is_character()||!me->is_fighting(target) )
		return notify_fail("你只能对战斗中的对手使用「左右搏击」。\n");
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");	
	if( (int)me->query_skill("zuoyou-boji",1) < 300)
		return notify_fail("你目前功力还使不出「左右搏击」。\n");
    if( objectp(me->query_temp("weapon")) )
        return notify_fail("你必须空手才能使用「左右搏击」！\n");  
	if( (int)me->query("jingli") < 1000 )
		return notify_fail("你的精力不够。\n");		
    if( (int)me->query("neili") < 1000 )
        return notify_fail("你的真气不够。\n");
	if (me->query_skill_mapped("unarmed") != "zuoyou-boji")
		return notify_fail("你没正确激发该技能 。\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	extra = me->query_skill("zuoyou-boji",1);		
	me->add("neili", -300);
	me->add("jingli", -300);
	message_vision(HIC"$N出招速度突然变快，左手突然出击，出则就是两招！"NOR, me, target);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1
		me->add_temp("apply/strength", extra);
        me->add_temp("apply/attack", extra);
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
		me->add_temp("apply/strength", -extra);
        me->add_temp("apply/attack", -extra);
	message_vision(HIC"$N出招速度突然变快，右手突然出击，出则就是两招！"NOR, me, target);
		target->add_temp("apply/strength", extra);
        target->add_temp("apply/attack", extra);
	COMBAT_D->do_attack(target, target, target->query_temp("weapon"));
	COMBAT_D->do_attack(target, target, target->query_temp("weapon"));
		target->add_temp("apply/strength", -extra);
        target->add_temp("apply/attack", -extra);		
		damage = extra + random(extra*4);
		target->receive_damage("qi", damage,me);
		target->receive_wound("qi", damage,me);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage +"。\n" NOR);
		
	me->start_busy(1);
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}