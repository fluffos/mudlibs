// shen.c  庭院深深深几许

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target) {
  object weapon;
  string msg;
  int i, attack_time, ap, dp, damage;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("「庭院深深深几许」诀只能对战斗中的对手使用。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");
  if (weapon->query("weapon_prop/damage") < 10)
    return notify_fail("你使用的武器太渣渣了！\n");
  if (target && target->query_temp("apply/shade_vision"))
    return notify_fail("对方隐身了，你看不到" + target->query("name") + "。\n");
  if ((int)me->query("neili") < (int)me->query_skill("huanhua-jian", 1) * 4)
    return notify_fail("你的内力太低，无法继续使用绝招了。\n");
  if ((int)me->query("max_jingli") < 100000)
    return notify_fail("你的精力修为太低，难以震碎长剑。\n");
  if ((int)me->query("max_neili") < 200000)
    return notify_fail("你的内力修为太弱，难以使出「乱红飞过秋千去」。\n");
  if ((int)me->query("jingli") < 1000)
    return notify_fail("你的精力太低，无法控制震碎的长剑碎片。\n");
  if ((int)me->query_skill("guiyuan-dafa", 1) < 300)
    return notify_fail("你的归元大法不够深厚，不能使用「庭院深深深几许」诀。\n");
  if ((int)me->query_skill("huanhua-jian", 1) < 500)
    return notify_fail("你的浣花剑法不够娴熟，不会使用「庭院深深深几许」诀。\n");
  if (me->query_skill_mapped("force") != "guiyuan-dafa")
    return notify_fail("你未使用本门内功，不能使用绝技！\n");
  if (me->query_skill_mapped("sword") != "huanhua-jian")
    return notify_fail("你未使用浣花剑法，不能使用绝技！\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  msg = HIY "$N使出浣花剑法「庭院深深深几许」诀，招式陡然变快，疯狂的扑向对方。\n";
  message_vision(msg, me, target);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1		
  ap = me->query("xyzx_sys/level") + me->query_skill(
    "huanhua-jian",
    1
  ) + me->query_skill("sword") + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
  attack_time = (int)me->query_skill("huanhua-jian", 1) / 600;
  if (attack_time < 1) attack_time = 1;
  if (me->query("jm/huanhua")) {
    if (attack_time > 100) attack_time = 100;
  } else {
    if (attack_time > 50) attack_time = 50;
  }

  if (random(ap) > dp / 4) {
    //		me->add_temp("lianzhao", attack_time);	 //2016.6.1阿飞改，增加连招标记，用于削弱连招伤害		
    msg = HIW " 庭院深深深几许，杨柳堆烟，帘幕无重数。玉勒雕鞍游冶处，楼高不见章台路。！\n" NOR;
    message_vision(msg, me, target);
    for (i = 0; i < attack_time; i++) {
      switch (random(3)) {
        case 0: msg = CYN " 庭院深深深几许？ 杨柳堆烟，帘幕无重数！\n" NOR;
        break;
        case 1: msg = HIB " 泪眼问花花不语，乱红飞过秋千去！\n" NOR;
        break;
        case 2: msg = HIY " 今宵酒醒何处？杨柳岸、晓风残月。\n" NOR;
        break;
      }
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    }
    me->add("neili", -100 * attack_time);
    //		me->delete_temp("lianzhao");  //2016.6.1阿飞改，连招结束取消连招标记		
  } else {
    msg = "可是$n看透了$N的帘幕，并没有上当。\n" NOR;
    message_vision(msg, me, target);
  }
  message_vision(HIY "$N聚气于剑，默运内力，只听“铮”的一声，忽然间银光闪耀，$N手中长剑竟断为无数\n"
    + "截，如漫天红云般向$n激射而出！\n" NOR, me, target);
  if (random(ap) > dp / 3) {
    message_vision(HIM "雨横风狂三月暮，门掩黄昏，无计留春住。泪眼问花花不语，乱红飞过秋千处。\n" NOR, me, target);
    message_vision(HIC "$N的长剑化成碎片，如落叶般散落一地！片刻之后，狂风卷起千重叶。\n" NOR, me, target);
    damage = me->query_skill(
      "huanhua-jian",
      1
    ) + me->query_skill("force") + me->query_skill(
      "sword",
      1
    ) + weapon->query("weapon_prop/damage") * 2;
    damage = damage + random(damage);
    me->add("jingli", -500);
    if (damage < 10) damage = 10;  //2015.4 加入解决伤害为0
    if (objectp(weapon)) {
      target->receive_wound("jing", damage, me);
      target->receive_damage("qi", damage, me);
      target->receive_wound("qi", damage, me);
      if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
        me,
        HIW "该绝招对敌人气血的外伤为" + damage + "，内伤为" + damage + "，精神的内伤为" + damage + "。\n" NOR
      );
    } else {
      target->receive_wound("jing", damage / 3, me);
      target->receive_damage("qi", damage / 3, me);
      target->receive_wound("qi", damage / 3, me);
      if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
        me,
        HIW "该绝招对敌人气血的外伤为" + damage / 3 + "，内伤为" + damage / 3 + "，精神的内伤为" + damage / 3 + "。\n" NOR
      );
    }
  } else {
    message_vision(HIY "可是$n晃动身形，迅速的闪过了剑雨。\n" NOR, me, target);
  }

  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
