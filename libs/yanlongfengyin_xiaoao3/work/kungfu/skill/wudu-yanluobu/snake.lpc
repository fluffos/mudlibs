// snake.c  金蛇游身

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
// inherit F_CLEAN_UP;
inherit F_SSERVER;

int perform(object me, object target)
{
	int ap,dp,skill;
	string msg;

	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("「金蛇游身」只能对战斗中的对手使用。\n");
	if( (int)me->query_skill("wudu-yanluobu", 1) < 500 )
		return notify_fail("你的五毒烟萝步火候不够，不能使出「金蛇游身」。\n");
	if( (int)me->query_skill("wudu-shengong", 1) < 300 )
		return notify_fail("你的五毒神功火候不够，不能使出「金蛇游身」。\n");
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	
	if ((int)me->query("max_jingli") < 100000)								
		return notify_fail("你的精力修为不够。\n");
	if( (int)me->query("neili") < 1000 )
		return notify_fail("你现在内力太弱，不能使用「金蛇游身」。\n");
	if( (int)me->query("jingli") < 1000 )
		return notify_fail("你现在精力太弱，不能使用「金蛇游身」。\n");
	if ( !wizardp(me) && me->query_skill_mapped("force") != "wudu-shengong")
		return notify_fail("不使用本门内功，如何使用本门绝学!\n");	
	if (me->query_skill_mapped("dodge") != "wudu-yanluobu")
		return notify_fail("你没正确激发该技能 。\n");
	if( me->is_busy() )
		return notify_fail("你现在正忙着呢，哪有空运功？\n");
	if( target && target->is_busy() )
		return notify_fail(target->name() + "目前正手忙脚乱，你还乱转什么，赶快进攻吧！\n");
	if ( target && target->query_temp("busy_mianyi") )	//冲穴成功后免疫busy，2017.9.29阿飞添加
		return notify_fail(target->name() + "奇经八脉浑然一体，真气浩浩荡荡，点穴似乎没什么作用。\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 		
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	msg = HIC "$N身行忽的一变，使出「金蛇游身」的绝技，身法越来越快。\n只见$N飞快的绕场游走，瞻之在前，望之在后，一时间到处都是$N的身影。\n"NOR;
	message_vision(msg, me, target);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1
	skill = (int)me->query_skill("wudu-yanluobu",1);
	ap = me->query("xyzx_sys/level") + me->query_skill("wudu-yanluobu", 1) + me->query_skill("dodge") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	me->add("neili", -100);
	me->add("jingli", -500);
    if (random(ap) > dp/3)
    {
		msg = HIR"$n不由得一阵手足无措，被$N连攻数招！\n"NOR;
		message_vision(msg, me, target);
		target->start_busy((30*skill)/(skill+2000)+5);		
		tell_object(target, HIY"你陷入忙乱之中，一时无法动弹。\n"NOR);
    }
    else
    {
		msg = HIR"可是$n以静制动，紧守门户，丝毫不受$N的影响,$N自己倒累的满头大汗！\n"NOR;
		message_vision(msg, me, target);
    }
	me->start_busy(1);
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}