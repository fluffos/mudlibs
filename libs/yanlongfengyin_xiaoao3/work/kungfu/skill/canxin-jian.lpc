int valid_enable(string usage) { 
    return (usage == "sword") || (usage == "parry");
}
int valid_learn(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
    if ((int)me->query("max_neili") < 10000)
   return notify_fail("你的内力不够。\n");
    if (me->query("family/family_name")!="蜀山派")
   return notify_fail("不加入蜀山派，恐怕学不了李逍遥的绝技吧。\n");
    if ((int)me->query_skill("shushan-force", 1) < 300)
   return notify_fail("你的蜀山内功火候太浅。\n");
	if ((int)me->query("score",1) < 5000)
		return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
	if (random(100)==1) me->add("score",-5);
    return 1;
}
mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}       
int practice_skill(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
        if( (int)me->query("qi") < 30  ||  (int)me->query("neili") < 3 )
                return notify_fail("你的内力或气不够，没有办法练习残心剑法。\n");
    if (me->query("family/family_name")!="蜀山派")
   return notify_fail("这是李逍遥的绝技，想要自练不加入蜀山派是领悟不了的。\n");			
        me->receive_damage("qi", 10);
        me->add("neili", -300);
        write(HIC"天若有情天仪老，月如无恨月长圆。\n"NOR,me);
        return 1;
}
string perform_action_file(string func) 
{
  return __DIR__"canxin-jian/" + func;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
	int ap,dp,damage2;
	damage2 = (int)me->query_skill("canxin-jian",1);	
	ap = me->query_skill("canxin-jian",1);
	dp = victim->query_skill("parry",1);
    if( damage_bonus < 100 ) return 0;
	if ( me->query_skill("shushan-force",1) < 100)	 return 0;
	if ( me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "shushan-force") return 0;	
	if (damage2<10) damage2=10;	
	if(me->query("jiali") > 0
	    && me->query_skill_mapped("force") == "shushan-force"
	    && random(ap) > dp/10
		&& random(5)==0 )
	{
		victim->receive_damage("qi", damage2+damage_bonus/2 ,me);
		victim->receive_wound("qi", damage2+damage_bonus/2,me );
		me->add("neili", -100);
		switch ( random(3) )
		{
			case 0:
				message_vision(HIG"$n被剑意中的相思之苦感染，身中情毒！\n"NOR,me,victim);
				victim->apply_condition("xiangsi", 20);
				break;
			case 1:
				message_vision(HIG"一股酒气冲向$n，$n似乎有了点酒意！\n"NOR,me,victim);
				victim->apply_condition("drunk", 20);
				break;
		}
		return HIW "$N低吟一声：情难消受美人恩，仗剑江湖为红颜！\n" NOR;
	}
}

