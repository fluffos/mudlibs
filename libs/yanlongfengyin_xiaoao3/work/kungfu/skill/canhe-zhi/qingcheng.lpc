#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>
#include "/kungfu/skill/eff_msg.h";
#define QINGCHENG "「" HIY "一指倾城" NOR "」"

inherit F_SSERVER;


//string final(object me, object target, int damage);

int perform(object me, object target)
{
	int damage,damage1;
	string msg;

	int ap, dp, slv, clv;
	if( !target ) target = offensive_target(me);

	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail(QINGCHENG "只能对战斗中的对手使用。\n");
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");
	if (objectp(me->query_temp("weapon")))
		return notify_fail("你必须空手才能使用" QINGCHENG "。\n");
//	if (target && target->query_temp("apply/shade_vision")) 
//		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 
	if ((int)me->query_skill("canhe-zhi", 1) < 1000)
		return notify_fail("你的参合指修为有限，难以施展" QINGCHENG "。\n");
	if (me->query_skill_mapped("unarmed") != "canhe-zhi")
		return notify_fail("你现在没有准备使用参合指，难以施展" QINGCHENG "。\n");
	if ((int)me->query("max_neili") < 1000000)
		return notify_fail("你的内力修为不足，难以施展" QINGCHENG "。\n");
	if ((int)me->query("max_jingli") < 500000)
		return notify_fail("你的精力修为不足，难以施展" QINGCHENG "。\n");
	if ((int)me->query("neili") < 10000)
		return notify_fail("你的真气不够，难以施展" QINGCHENG "。\n");
	if ((int)me->query("jingli") < 10000)
		return notify_fail("你精神萎靡，难以施展" QINGCHENG "。\n");
	if ((int)me->query_skill("shenyuan-gong", 1) < 1000)
		return notify_fail("你的神元功火候太浅。\n");
	if ( !wizardp(me) && me->query_skill_mapped("force") != "shenyuan-gong")
		return notify_fail("不使用本门内功，如何使用本门绝学!\n"); 
	if ((int)me->query_skill("douzhuan-xingyi", 1) < 1000)
		return notify_fail("你的斗转星移火候太浅。\n");
	if (!(int)me->query("breakup"))
        return notify_fail("你任督二脉未通,无法使用[" HIR "以彼之道，还施彼身" NOR "]\n"NOR); 
	if (target && !living(target))
		return notify_fail("对方都已经这样了，用不着这么费力吧？\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
		message_vision(HBWHT "$N贯通慕容世家武学，使出了慕容世家的绝学之精髓！\n" NOR, me, target);
		
	message_vision(HIM "$N使出慕容世家参合指的绝技---【一指倾城】，无形剑气连绵不绝！\n" NOR, me, target);		
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 5, me);	//CD写法1
	msg = HIY "$N" HIY "双手合十，微微一笑，颇得拈花之意。食指并中指轻轻一弹，顿时一屡罡气电射而出，朝$n" HIY "袭去。\n" NOR;
	message_vision(msg, me, target);
	ap = me->query("xyzx_sys/level") + me->query_skill("canhe-zhi", 1) + me->query_skill("douzhuan-xingyi", 1) + me->query_skill("unarmed") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("force") + target->query_skill("parry");
	damage = me->query_skill("canhe-zhi",1) + me->query_skill("douzhuan-xingyi",1) + me->query_skill("shenyuan-gong",1);
	
	if ( random(5) == 1 )
	{
		target->add("neili", -4000);		
		msg = HIY "但见$n" HIY "也即脸露笑容，衣袖轻轻一拂，顺势裹上，顿将$N" HIY "的指力消逝殆尽。\n" NOR;
		message_vision(msg, me, target);
	}
	
	if (random(ap) > dp/3 )
	{
		me->add("neili", -400);
		target->receive_damage("jing", damage,me);
		target->receive_wound("jing", damage/2,me);
		target->receive_damage("qi", damage,me);
		target->receive_wound("qi", damage/2,me);
		msg = HIR "只听“噗嗤”一声，指力竟在$n" HIR"胸前穿了一个血肉模糊的大洞，透体而入。\n" NOR;
		message_vision(msg, me, target);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"，精神外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	}
	else
	{
		me->add("neili", -200);
		msg = CYN "$n" CYN "见$N" CYN "来势汹涌，不敢轻易招架，急忙提气跃开。\n" NOR;
		message_vision(msg, me, target);
	}

	clv = me->query_skill("canhe-zhi",1);
	slv = target->query_skill("liumai-shenjian",1);

if(me->query_skill("canhe-zhi", 1) > 2000 && me->query_skill("douzhuan-xingyi", 1) > 2000)
{
	msg = HIW "\n只见$N" HIW "十指分摊，霎时破空声骤响，数股剑气至指尖激"
	      "射而出，朝$n" HIW "径直奔去！\n" NOR;
	message_vision(msg, me, target);


	if (slv >= 2000
	        && random(5) == 0
	        && slv >= clv - 100 // 如果参合指等级比六脉神剑等级高100级以上取消特殊效果	        
	        && (target->query_skill_mapped("unarmed") == "liumai-shenjian" || target->query_skill_mapped("parry") == "liumai-shenjian"))
	{
		msg = HIY "\n但见$n" HIY "斜斜一指点出，指出如风，剑气纵横，嗤然"
		       "作响，竟将$N" HIY "的剑气全部折回，反向自己射去！\n" NOR +
		       HIR "你听到「嗤啦」一声轻响，脸上竟溅到一些血滴！\n" NOR;
		message_vision(msg, me, target);
		damage1 = target->query_skill("liumai-shenjian",1);
		damage1 = damage1 +random(damage1);
		me->receive_damage("qi", damage1,target);
		me->receive_wound("qi", damage1,target);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对自己气血的外伤为"+ damage1 +"，内伤为"+ damage1 +"。\n" NOR);
	}
	else if (random(ap) > dp/3 )
	{
		target->receive_damage("qi",damage,me);
		target->receive_wound("qi",damage/2,me);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
		msg =HIR "\n顿时只听“嗤啦”的一声，$n" HIR
		      "躲闪不及，剑气顿时穿胸而过，带出一蓬"
		      "血雨。\n" NOR;
		message_vision(msg, me, target);	  
	}
	else
	{
		msg = CYN "\n$n" CYN "见$N" CYN "来势汹涌，急忙飞身一跃而"
		       "起，避开了这一击。\n" NOR;
		message_vision(msg, me, target);	   
	}

	if (slv >= 1000
	        && random(8) == 0
	        && slv >= clv - 100  // 如果参合指等级比六脉神剑等级高100级以上取消特殊效果
	        && (target->query_skill_mapped("unarmed") == "liumai-shenjian" || target->query_skill_mapped("parry") == "liumai-shenjian"))
	{
		msg = HIY "\n忽见$n" HIY "左手小指一伸，一招「少泽剑」至指尖透出"
		       "，真气鼓荡，轻灵迅速，顿将$N" HIY "剑气逼回！\n" NOR + HIR
		       "你听到「嗤啦」一声轻响，脸上竟溅到一些血滴！\n" NOR;
		message_vision(msg, me, target);
		damage1 = target->query_skill("liumai-shenjian",1);
		damage1 = damage1 +random(damage1);	
		me->receive_damage("jing", damage1,target);
		me->receive_wound("jing", damage1/2,target);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对自己精神的外伤为"+ damage1 +"，内伤为"+ damage1/2 +"。\n" NOR);

	}
	else if (random(ap) > dp/3 )
	{

		target->receive_damage("jing",damage,me);
		target->receive_wound("jing",damage/2,me);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人精神的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
		msg =HIR "\n只听$n" HIR "一声惨嚎，被$N" HIR
		      "的剑气刺中了要害，血肉模糊，鲜血迸流不"
		      "止。\n" NOR;
		message_vision(msg, me, target);
	}
	else
	{
		msg = CYN "\n$n" CYN "见$N" CYN "来势汹涌，急忙飞身一跃而"
		       "起，避开了这一击。\n" NOR;
		message_vision(msg, me, target);	   
	}


	if (slv >= 500
	        && random(10) == 0
	        && slv >= clv - 100  // 如果参合指等级比六脉神剑等级高100级以上取消特殊效果
	        && (target->query_skill_mapped("unarmed") == "liumai-shenjian" || target->query_skill_mapped("parry") == "liumai-shenjian"))
	{
		msg = HIY "\n可电光火石之间，$n" HIY "猛然翻掌，右手陡然探出，中"
		       "指「中冲剑」向$N" HIY "一竖，登将参合剑气化于无形！\n" NOR
		       + HIR "你听到「嗤啦」一声轻响，脸上竟溅到一些血滴！\n" NOR;
		message_vision(msg, me, target);	   
		damage1 = target->query_skill("liumai-shenjian",1);
		damage1 = damage1 +random(damage1);	
		me->receive_damage("qi", damage1,target);
		me->receive_wound("qi", damage1/2,target);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对自己气血的外伤为"+ damage1 +"，内伤为"+ damage1/2 +"。\n" NOR);

	}
	else if (random(ap) > dp/3 )
	{
		target->receive_damage("qi",damage,me);
		target->receive_wound("qi",damage/2,me);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
		msg =HIR "\n$n" HIR "奋力招架，仍是不敌，$N"
		      "的" HIR "无形剑气已透体而入，鲜血飞射"
		      "，无力再战。\n" NOR;
		message_vision(msg, me, target);	  
	}
	else
	{
		msg = CYN "\n$n" CYN "见$N" CYN "来势汹涌，急忙飞身一跃而"
		       "起，避开了这一击。\n" NOR;
		message_vision(msg, me, target);	   
	}
	me->add("neili",-2000);

}

if ((int)me->query_skill("canhe-zhi", 1)> 3000 && me->query_skill("douzhuan-xingyi", 1) > 3000)
{
	msg = HIW "\n最后 $N" HIW "食指伸出，施展出参合指的精妙招式，一道气流袭向$n"
	      HIW "的胸前穴位。\n" NOR;
	message_vision(msg, me, target);	
		
	if (me->query("jm/murong")) damage = me->query_skill("canhe-zhi",1)*me->query("int",1)*3/2 + me->query_skill("douzhuan-xingyi",1)*me->query("dex",1)*3/2 + me->query_skill("shenyuan-gong",1)*me->query("int",1)*3/2 + me->query_skill("parry",1) + me->query_skill("unarmed",1) + me->query_skill("force",1)+target->query("qi")/50;
	else damage = me->query_skill("canhe-zhi",1)*me->query("int",1) + me->query_skill("douzhuan-xingyi",1)*me->query("dex",1) + me->query_skill("shenyuan-gong",1)*me->query("int",1) + me->query_skill("parry",1) + me->query_skill("unarmed",1) + me->query_skill("force",1)+target->query("qi")/80;
	damage = damage + random(damage);

	if (random(ap) > dp/3 )
	{
		me->add("neili", -3000);
		me->add("jingli", -3000);
		target->apply_condition("no_force", 20);
		target->receive_damage("qi", damage/2,me);
		target->receive_wound("qi", damage/4,me);
		target->receive_damage("jing", damage/2,me);
		target->receive_wound("jing", damage/4,me);	
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage/2 +"，内伤为"+ damage/4 +"，精神的外伤为"+ damage/2 +"，内伤为"+ damage/4 +"。\n" NOR);
		msg = HIR "$n" HIR "躲避不及，顿时觉得顿觉浑身经"
		       "脉都是一痛，手里不禁一软。\n" NOR;
		message_vision(msg, me, target);	   
	}
	else
	{
		me->add("neili",-1000);
		msg = CYN "可是$n" CYN "看破了$N" CYN "的来路，立刻腾挪躲闪，使$N"
		       CYN "的攻击没有起到作用。\n" NOR;
		message_vision(msg, me, target);	   
	}


//		if (!target->is_busy() && random(3)==1)  target->start_busy(3);
		msg = MAG "$N默运神元神功，将内力聚于手指，平平淡淡毫无花俏地点向$n的膻中穴" NOR;
		COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
		target->receive_damage("qi", damage/5,me);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage/5 +"。\n" NOR);
		msg = YEL "$N两掌竖合，掌心微虚，如莲花之开放，接着双手食指轻轻一弹，两股指风同时袭向$n" NOR;
		COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
		target->receive_damage("qi", damage/5,me);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage/5 +"。\n" NOR);
		msg = WHT "$N凌空虚点数指，数道指风合成一股剑气，直向$n攻去"NOR;
		COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
		target->receive_damage("qi", damage/5,me);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage/5 +"。\n" NOR);
		msg =RED "$N缓缓举手，五指先是箕张，再缓缓拢指合拳，霎时生出气凝河岳般的剑气狂扬" NOR;
		COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
		target->receive_damage("qi", damage/5,me);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage/5 +"。\n" NOR);
		msg = HIR "$N指风犀利，似一道无形剑气，将$n笼罩于内，$n只觉胸口一痛，全身真气狂泻而出" NOR;
		COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
		target->receive_damage("qi", damage/5,me);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage/5 +"。\n" NOR);		
		
		me->add("neili",-1000);
}
 me->start_busy(1);
	return 1;
}


void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}
