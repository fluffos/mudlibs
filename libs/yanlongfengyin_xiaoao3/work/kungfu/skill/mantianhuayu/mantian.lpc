// jinshe-jianfa perform
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;

int perform(object me, object target) {
  string msg;
  int i, extra, max;
  object weapon;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("「漫天花雨」只能在战斗中对对手使用。\n");
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "throwing")
    return notify_fail("你必须使用暗器时才能使出「漫天花雨」！\n");
  if (target && target->query_temp("apply/shade_vision"))
    return notify_fail("对方隐身了，你看不到" + target->query("name") + "。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");
  if (me->query_skill_mapped("force") != "xuantian-wuji")
    return notify_fail("没有玄天无极神功的催动无法使出「漫天花雨」！\n");
  if (me->query_skill_mapped("throwing") != "mantianhuayu")
    return notify_fail("你未准备好「漫天花雨」！\n");
  if (me->query_skill("mantianhuayu", 1) < 300)
    return notify_fail("你的漫天花雨还不够娴熟，使不出「漫天花雨」。\n");
  if (me->query_skill("xuantian-wuji", 1) < 300)
    return notify_fail("你的玄天无极神功还不够娴熟，使不出「漫天花雨」。\n");
  if ((int)me->query("jingli") < 1000)
    return notify_fail("你现在精力太弱，使不出「漫天花雨」。\n");
  if ((int)me->query("neili") < me->query_skill("mantianhuayu", 1) * 4)
    return notify_fail("你现在真气太弱，使不出「漫天花雨」。\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  extra = me->query_skill("mantianhuayu", 1);
  max = me->query_skill("mantianhuayu", 1) / 60;
  msg = BLU "\n$N纵身跃起，衣袖一挥，手中的" + weapon->name() + "同时射向$n。\n\n" NOR;
  message_vision(msg, me, target);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1		
  me->add_temp("apply/strength", -extra);
  me->add_temp("apply/attack", -extra);
  me->add_temp("apply/damage", -extra);
  if (max < 1) max = 1;
  if (me->query("jm/kunlun")) {
    if (max > 100) max = 100;
  } else {
    if (max > 50) max = 50;
  }

  me->add_temp("lianzhao", max);  //2016.6.1阿飞改，增加连招标记，用于削弱连招伤害	
  for (i = 0; i < max; i++) {
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  }

  me->add("neili", -max * 50);
  me->add_temp("apply/strength", extra);
  me->add_temp("apply/attack", extra);
  me->add_temp("apply/damage", extra);
  me->delete_temp("lianzhao");  //2016.6.1阿飞改，连招结束取消连招标记		
  me->start_busy(1);

  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
