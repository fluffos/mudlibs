int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }

int valid_learn(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  //    if ( me->query("gender") != "女性")
  //       return notify_fail("相传移风剑法乃女娲所创,从无男子练习!\n");
  if ((int)me->query("per", 1) < 25)
    return notify_fail("我移花宫俱是英俊美貌之人，怎么能教你这种污浊之人功夫呢。\n");
  if (me->query("family/family_name") != "移花宫")
    return notify_fail("你不是移花宫弟子，无法学习。\n");
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_skill("mingyu-shengong", 1) < 100)
    return notify_fail("你的冥雨神功火候太浅。\n");
  if ((int)me->query_skill("yifeng-jian", 1) >= (int)me->query_skill("sword", 1))
    return notify_fail("你的基础不够.\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (random(100) == 1) me->add("score", -5);
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  int ap, dp, damage2;
  damage2 = (int)me->query_skill("yifeng-jian", 1);
  ap = me->query_skill("yifeng-jian", 1);
  dp = victim->query_skill("parry", 1);
  if (damage_bonus < 100) return 0;
  if (me->query_skill("mingyu-shengong", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "mingyu-shengong") return 0;
  if (damage2 < 10) damage2 = 10;
  //  第六等级的伤气
  if (me->query_skill("yifeng-jian", 1) >= 1000
    && me->query_skill("mingyu-shengong", 1) >= 1000
    && random(ap) > dp / 10 && random(15) == 0) {
    victim->receive_damage("qi", damage2 * 5 + damage_bonus / 2, me);
    me->add("neili", -100);
    return WHT "$N剑带魅影，移风剑法的精髓在无形中表露无遗，登时$n全身血液顿时沸腾！！！\n" NOR;
  }

  //  第五等级的伤气
  if (me->query_skill("yifeng-jian", 1) >= 800
    && me->query_skill("mingyu-shengong", 1) >= 800
    && random(ap) > dp / 10 && random(15) == 1) {
    victim->receive_damage("qi", damage2 * 4 + damage_bonus / 2, me);
    me->add("neili", -100);
    return YEL "$N的移风剑法已经达到人剑合一的境界，随手数道剑气分刺$n数处大穴！！！\n" NOR;
  }
  //  第四等级的伤气
  if (me->query_skill("yifeng-jian", 1) >= 600
    && me->query_skill("mingyu-shengong", 1) >= 600
    && random(ap) > dp / 10 && random(15) == 2) {
    victim->receive_damage("qi", damage2 * 3 + damage_bonus / 2, me);
    me->add("neili", -100);
    return MAG "$N灵台光闪，瞬间领悟到移风剑法精髓，随手一剑妙到毫颠！！！\n" NOR;
  }

  //  第三等级的伤气
  if (me->query_skill("yifeng-jian", 1) >= 400
    && me->query_skill("mingyu-shengong", 1) >= 400
    && random(ap) > dp / 10 && random(15) == 3) {
    victim->receive_damage("qi", damage2 * 2 + damage_bonus / 2, me);
    me->add("neili", -100);
    return CYN "$N的移风剑法已入返璞归真境界，随意一剑带出一阵剑气扑向$n！！！！！\n" NOR;
  }
  // 第二等级的伤气
  if (me->query_skill("yifeng-jian", 1) >= 200
    && me->query_skill("mingyu-shengong", 1) >= 200
    && random(ap) > dp / 10 && random(15) == 4) {
    victim->receive_damage("qi", damage2 + damage_bonus / 2, me);
    me->add("neili", -100);
    return RED "$N的移风剑法已初有小成,每出一剑都带着强烈" HIR "剑气" HIW "扑向$n！！\n" NOR;
  }
}

/*	//2017.12.31阿飞改，移风剑改成正常自练方式
int practice_skill(object me)
{
    return notify_fail("移风剑法只能通过「"+HIC+"舞字决"+NOR+"」来演练。\n");
}
*/
int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("jingli") < 1000 || (int)me->query("neili") < 1000)
    return notify_fail("你的内力或精力不够，没有办法练习移风剑法！\n");
  if (me->query("family/family_name") != "移花宫")
    return notify_fail("你还是先入了日月神教再来练习。\n");
  if ((int)me->query_skill("yifeng-jian", 1) < 200)
    return notify_fail("你对移风剑理解不够透彻！\n");
  if ((int)me->query_skill("yifeng-jian", 1) > (int)me->query_skill("sword", 1))
    return notify_fail("你的剑法不够精湛！\n");
  if ((int)me->query_skill("mingyu-shengong", 1) < 200)
    return notify_fail("你对冥雨神功不了解，如何能练的了移风剑！\n");
  me->add("neili", -100);
  me->add("jingli", -100);
  write("你按著所学练了一遍移风剑。\n");
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "yifeng-jian/" + action;
}
