// Last Modified by winder on Aug. 25 2001
// 18pan.c 泰山十八盘 

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;
#define PNAME "「泰山十八盘」"
int perform(object me,object target)
{
	string msg;
	object weapon;
	int skill,ap,dp,damage;

	if (!target ) target = offensive_target(me);
	if (!target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail(PNAME"只能对战斗中的对手使用。\n");
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对。\n");
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
	if (me->query_skill_mapped("sword") != "taishan-jianfa")
		return notify_fail("你没正确激发该技能 。\n");
	if( (int)me->query_skill("taishan-jianfa",1) < 300 )
		return notify_fail("你的泰山剑法修为不够，使不出"+PNAME+"。\n");
	if( me->query("neili") < 1000 )
		return notify_fail("你的内力不够，无法运用泰山十八盘！\n");
	if( me->query("jingli") < 1000 )
		return notify_fail("你的精力不够，无法运用泰山十八盘！\n");
	if ((int)me->query("max_neili")<100000)								
		return notify_fail("你的内力修为不够。\n");
	if( me->is_busy() )
		return notify_fail("你现在正忙着呢，哪有空运功？\n");
	if( target && target->is_busy() )
		return notify_fail(target->name()+"已经自顾不暇了，放胆攻击吧！\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	msg = CYN "$N使出泰山十八盘剑法之缠剑式，一把剑闪出十八道剑影！\n";
	message_vision(msg, me, target);
	message_vision( HIY"$N右手"+weapon->name()+HIY"斜指而下，左手五指正在屈指而数，从一数到五，握而成拳，又将拇指伸出，次而食指，终至五指全展，跟着又屈拇指而屈食指，再屈中指，然后手中"+weapon->name()+HIY"剑光暴长，向$n疾刺而去。\n"NOR,me,target);	
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1
	skill = (int)me->query_skill("taishan-jianfa",1);
	ap = me->query("xyzx_sys/level") + me->query_skill("taishan-jianfa", 1) + me->query_skill("sword") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	damage = skill*2 + random(skill*4);	
	if( random(ap) > dp/3 )
	{
		msg = HIC"$N使出泰山剑法中一击必中的"+HIR "岱宗何如" +HIY"，无论$n窜高跃低，变换方位，均无从闪避，只觉得眼前一花，一股"HIR"血箭"HIY"喷涌而出。\n" NOR;
		message_vision(msg, me, target);
		target->start_busy( (30*skill)/(skill+2000) + 5);
		tell_object(target, HIY"你陷入忙乱之中，一时无法动弹。\n"NOR);
		target->receive_damage("qi",damage,me);
		target->receive_wound("qi",damage,me);
		me->add("neili", -250);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage +"。\n" NOR);
	} else
	{
		msg = HIC"可是$n看破了$N的剑招，一拧身跃出了剑影。\n" NOR;
		msg += HIY"$N却一下失去平衡，反陷入了被动。\n" NOR;
		message_vision(msg, me, target);
		me->add("neili",-100);
		me->receive_damage("qi",damage,target);
		me->receive_wound("qi",damage,target);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对自己气血的外伤为"+ damage +"，内伤为"+ damage +"。\n" NOR);
	}
	me->start_busy(1);
    return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}