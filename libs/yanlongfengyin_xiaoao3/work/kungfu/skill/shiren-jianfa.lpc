int valid_enable(string usage) { return usage == "blade" || usage == "parry"; }

string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
    int level;
    level = (int) me->query_skill("shiren-jianfa",1);

if (!userp(me) || (int)me->query_skill("shayi-xinfa", 1) > 100)
{
	if( random(30)==1 && random(level) > 300 && me->query("jiali")>100 )
	{
		return ([
		"action": HIR"「 瞬天杀! 」"+HIM"$N使出超神速的缩地加天剑拔刀术，在$n未感痛楚前想置其死地!"NOR,
		"attack":	600,
		"parry":	600,
		"dodge":	600,
		"damage":	600,
		"force":	600,
	        "skill_name" : "瞬天杀!",
		"damage_type" : "刺伤" ]);
	}
  	if( random(30)==2 && random(level) > 300 && me->query("jiali")>100 )
	{
		return ([
		"action" : HIR"「火产灵神!」"+HIY"$N把整把无限刃由刀身至刀尖燃烧,能力发挥至极限,完全焚毁对手!!"NOR,
		"attack":	600,
		"parry":	600,
		"dodge":	600,
		"damage":	600,
		"force":	600,
        	"skill_name" : "火产灵",
		"damage_type": random(2)?"刺伤":"劈伤"]);
	}
 	if( random(30)==3 && random(level) > 300 && me->query("jiali")>100 )
	{
		return ([
		"action" : HIB"「红莲腕!」"+HIY"$N在抓住对手时,用炎灵引爆手套内藏的火药"NOR,
		"attack":	600,
		"parry":	600,
		"dodge":	600,
		"damage":	600,
		"force":	600,
        	"skill_name" : "红莲腕",
		"damage_type": random(2)?"刺伤":"劈伤"]);
	}

	if( random(30)==4 && random(level) > 300 && me->query("jiali")>100 )
	{
		return ([

		"action" : HIM"「秘剑.炎灵!」"+HIY"$N以无限刃点火,向对手同时发出斩击和火烧！ "NOR,
		"attack":	600,
		"parry":	600,
		"dodge":	600,
		"damage":	600,
		"force":	600,
        	"skill_name" : "土龙闪",
		"damage_type": random(2)?"刺伤":"劈伤"]);
	}
 
 	if( random(30)==5 && random(level) > 300 && me->query("jiali")>100 )
	{
		return ([
		"action" : HIG"「影子着鬼附身!」"+HIY"$N将心之一方作用于自己,使自己相信本身天下无敌,引发所有潜能,发挥最强威力。 "NOR,
		"attack":	600,
		"parry":	600,
		"dodge":	600,
		"damage":	600,
		"force":	600,
        	"skill_name" : "影子着鬼附身",
		"damage_type": random(2)?"刺伤":"劈伤"]);
	}
  	if( random(30)==6 && random(level) > 300 && me->query("jiali")>100 )
	{
		return ([
		"action" : HIC"「背车刀!」"+HIY"$N将右手的刀于背后交给左手,利用假动作，在预料不到的地方出刀 。 "NOR,
		"attack":	600,
		"parry":	600,
		"dodge":	600,
		"damage":	600,
		"force":	600,
        	"skill_name" : "背车刀",
		"damage_type": random(2)?"刺伤":"劈伤"]);
	}
  	if( random(30)==7 && random(level) > 300 && me->query("jiali")>100 )
	{
		return ([
		"action" : HIW"「二阶堂平法!」"+HIY"$N由[一,八,十]这三字组成[平]字将剑气射出,麻痹心肺$n,并让$n无法动弹。 "NOR,
		"attack":	600,
		"parry":	600,
		"dodge":	600,
		"damage":	600,
		"force":	600,
        	"skill_name" : "二阶堂平法",
		"damage_type": random(2)?"刺伤":"劈伤"]);
	}
  	if( random(30)==8 && random(level) > 300 && me->query("jiali")>100 )
	{
		return ([
		"action" : HIC"「回天剑舞六连!」"+HIW"$N反握小太刀,运用流水招式刺出,左右再变两招,瞬间出六招。 "NOR,
		"attack":	600,
		"parry":	600,
		"dodge":	600,
		"damage":	600,
		"force":	600,
        	"skill_name" : "回天剑舞六连",
		"damage_type": random(2)?"刺伤":"劈伤"]);
	}

  	if( random(30)==9 && random(level) > 300 && me->query("jiali")>100 )
	{
		return ([
		"action" : HIG"「阴阳双飞!」"+HIW"$N双刀纵横十字 两把小太刀十字交叉做剪刀架势的攻击$n 。"NOR,
		"attack":	600,
		"parry":	600,
		"dodge":	600,
		"damage":	600,
		"force":	600,
        	"skill_name" : "阴阳双飞!",
		"damage_type": random(2)?"刺伤":"劈伤"]);
	}
}
  
    return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点

}




string perform_action_file(string action)
{
        return __DIR__"shiren-jianfa/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb)
{                                                                                                                
	int dp, ap,damage2;
	object weapon;
	weapon = me->query_temp("weapon");
        dp = (int) victim->query_skill("dodge",1);
        ap = (int) me->query_skill("shiren-jianfa",1);
		damage2 = (int)me->query_skill("shiren-jianfa",1);
		
    if( damage_bonus < 100 ) return 0;
	if ( me->query_skill("shayi-xinfa",1) < 100)	 return 0;
	if ( me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "shayi-xinfa") return 0;	
	if (damage2<10) damage2=10;	
	
	if( random(ap)>dp/10 && me->query("jiali")>0 && random(5)==1) 
	{
		victim->receive_wound("qi", damage2+damage_bonus/2,me);
		me->add("neili", -100 );
		return RED"只见$n$l上鲜血狂奔，已被"+weapon->name()+HIR"斩出的无形气劲切了开来!\n"NOR;
    }
}
       
       
	//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关       
int ob_hit(object ob, object me, int damage)
{
	object weapon = me->query_temp("weapon");
        string msg,*limbs;
        int ap,dp;
        
        limbs = ob->query("limbs");
        ap = me->query_skill("shiren-jianfa", 1);
		dp = ob->query_skill("parry", 1);
        if( me->is_busy()) return 1;
        if( damage < 100 ) return 1;
    if ((int)me->query_skill("shayi-xinfa", 1) < 10 && userp(me)) return 1;


        if (  random(ap) > dp/10
         && me->query_skill_mapped("parry") =="shiren-jianfa"
         && weapon
         && weapon->query("skill_type") == "blade"
         && me->query_skill("blade") > 150
         && random(me->query_skill("blade",1)) > 150
         && me->query("jiali")>0 )
{
         msg = HIG"$N面对$n的攻势。身形一闪，突出狠招!!!。\n"NOR;
            message_vision(msg, me, ob);
            if ( random(3) == 0 && ob->query("qi") > 50
        && ob->query("jing") > 50
        && ob->query("eff_qi") > 50
        && ob->query("eff_jing") > 50)
	{
         msg = HIR"「 瞬天杀! 」。$N使出超神速的缩地加天剑拔刀术，在$n未感痛楚前想置其死地!!。\n"NOR;
             if (!ob->is_busy()) ob->start_busy(2);
		if ((int)ob->query("qi") < 60000)
		{
		if (ob->query("qi") > ob->query("max_qi")/5)
             ob->receive_damage("qi",ob->query("qi")/15,me);
		if (ob->query("eff_qi") > ob->query("max_qi")/5)
             ob->receive_wound("qi",ob->query("eff_qi")/15,me);
		}
		else
		{
		ob->receive_damage("qi",5000,me);
		ob->receive_wound("qi",5000,me);
		}

		msg += damage_msg(damage, "瘀伤");
    }
	else  if (random(3)==1 && ob->query("qi") > 50
        && ob->query("jing") > 50
        && ob->query("eff_qi") > 50
        && ob->query("eff_jing") > 50)
	{
         msg = HIR"「火产灵神!」。$N把整把无限刃由刀身至刀尖燃烧,能力发挥至极限,完全焚毁$n!!\n"NOR;
             if (!ob->is_busy()) ob->start_busy(2);
		if ((int)ob->query("qi") < 60000)
		{
		if (ob->query("qi") > ob->query("max_qi")/5)
             ob->receive_damage("qi",ob->query("qi")/20,me);
		if (ob->query("eff_qi") > ob->query("max_qi")/5)
             ob->receive_wound("qi",ob->query("eff_qi")/20,me);
		msg += damage_msg(damage, "瘀伤");
		}
		else
		{
		ob->receive_damage("qi",4000,me);
		ob->receive_wound("qi",4000,me);
		msg += damage_msg(damage, "瘀伤");
		}
    }
	else  if (random(3)==2 && ob->query("qi") > 50
        && ob->query("jing") > 50
        && ob->query("eff_qi") > 50
        && ob->query("eff_jing") > 50)
	{
         msg = HIR"「回天剑舞六连!」。$N反握小太刀,运用流水招式刺出,左右再变两招,瞬间出六招!! \n"NOR;
             if (!ob->is_busy()) ob->start_busy(2);
		if ((int)ob->query("qi") < 60000)
		{
		if (ob->query("qi") > ob->query("max_qi")/5)
             ob->receive_damage("qi",ob->query("qi")/30,me);
		if (ob->query("eff_qi") > ob->query("max_qi")/5)
             ob->receive_wound("qi",ob->query("eff_qi")/30,me);
		msg += damage_msg(damage, "瘀伤");
		}
		else
		{
		ob->receive_damage("qi",3000,me);
		ob->receive_wound("qi",3000,me);
		msg += damage_msg(damage, "瘀伤");
		}
    }
	else
        msg = HIG"$n认得这招历害,逃了开来，还好无事!。\n"NOR;
        message_vision(msg, me, ob);
    return damage;
}
}
