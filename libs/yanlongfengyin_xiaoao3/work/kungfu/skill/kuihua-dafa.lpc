string main_skill() { return "kuihua-dafa"; }

mapping sub_skills = ([
		"pixie-jian" : 1000,
		"kuihua-xinfa" : 1000,
]);

int get_ready(object me)
{
	return 1;
}


int get_finish(object me)
{
	object ob;

	if( ! (ob = me->query_temp("weapon"))
	        || (string)ob->query("skill_type") != "sword" )
	{
		tell_object(me, "你空手舞了半天，发现不拿把剑实在难以演练。\n");
		return 0;
	}
	if (me->query("family/family_name")!="日月神教" )
	{
		tell_object(me,"你不是日月神教弟子，怎么能演练葵花大法呢。\n");
		return 0;
	}	
	if (me->query_skill_mapped("force")!= "kuihua-xinfa")
	{
		tell_object(me, "你演练完毕，只感辟邪剑法和葵花心法毫无牵连，看来必须要激发葵花心法，否则无法将其合一。\n");
		return 0;
	}
	if ( (string)me->query("gender")=="女性" )
	{
		tell_object(me, "你舞了半天，发现阴性体质实在难以演练。\n");
		return 0;
	}

	if ( (string)me->query("gender")=="男性" )
	{
		tell_object(me, "你不把那玩意割了，恐怕会遭受真气反噬。\n");
		return 0;
	}
	if ( (string)me->query("genderbak")=="男性" )
	{
		tell_object(me, "你是个假太监，不把那玩意割了，恐怕会遭受真气反噬。\n");
		return 0;
	}
	if (me->query("int",1) < 25)
	{
		tell_object(me, "你演练完毕，只感辟邪剑法和葵花心法毫无牵连，看"
		            "来依你的悟性，无法将其合一。\n");
		return 0;
	}

	if (me->query("dex",1) < 30)
	{
		tell_object(me, "你演练完毕，只觉依自己的身法灵动性，根"
		            "本无法将二者合一。\n");
		return 0;
	}
	if (me->query_skill("kuihua-dafa", 1) > 100)
	{
		tell_object(me, "你已经领悟了葵花大法，用不着再演练了。\n");
		return 0;
	}
	if ((int)me->query_skill("pixie-jian", 1) < 1000)
		return notify_fail("你的「辟邪剑法」火候太浅，没法演练高深的葵花大法。\n");
	if ((int)me->query_skill("kuihua-xinfa", 1) < 1000)
		return notify_fail("你的葵花心法太低了，没法演练高深的葵花大法。\n");
	if (me->query_skill("literate", 1) < 5000)
	{
		tell_object(me, "你觉得辟邪剑法和葵花心法都极其深奥，看"
		            "来多研究一下学问可能更有帮助。\n");
		return 0;
	}

	if ((int)me->query("max_neili") < 100000)
	{
		tell_object(me, "你觉得自己内力修为不继，无法将辟邪剑法和葵花心法二者合一。\n");
		return 0;
	}

	if (random(10000) < 9990)
	{
		tell_object(me, "你觉得有所感悟，或许再演练一次就能融会贯通，将二者合一。\n");
		return 0;
	}

	tell_object(me, HIY "\n一阵凡尘往事涌上心头，你几欲放声长叹。霎"
	            "那间，辟邪剑法和葵花心法交替着不断在\n你脑海里"
	            "闪现，终于融会贯通，合二为一。你终于通晓了葵花"
	            "大法的诀窍。\n" NOR);
	message("channel:chat", CYN"【天降奇才】"GRN + "听说"+me->query("name")+"天纵奇才，刻苦钻研葵花宝典，居然领悟了葵花大法！\n"NOR,users() );
	me->set_skill("kuihua-dafa",101);
	return 1;
}

mapping query_sub_skills()
{
	return sub_skills;
}

int valid_enable(string usage)
{
	return usage == "sword" || usage =="parry"||usage == "unarmed";
}

int valid_learn(object me)
{
	return notify_fail("葵花大法只能通过演练参悟。\n");   
}	
//2017.12.31阿飞改，葵花大法自练方式改成类似独孤模式
int practice_skill(object me)
{
    return notify_fail("葵花大法只能通过「"+HIC+"自宫诀"+NOR+"」来提升。\n");
}

