// tianmo-shengong.c 天魔神功
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit FORCE;
//inherit F_DBASE;	//这条似乎并没有什么用

public string query_type() {
  return "yin";
}
int valid_enable(string usage) { return usage == "force"; }

int valid_learn(object me) {
  mapping skl;
  string *sname;
  int i;

  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
  if (me->query("family/family_name") != "日月神教")
    return notify_fail("你不是本门中人，无法学习本门技能。\n");
  if ((int)me->query("con", 1) < 30)
    return notify_fail("你的根骨不适合学习天魔神功。\n");
  if ((int)me->query_skill(
    "force",
    1
  ) < 100 || (int)me->query_skill("force", 1) < (int)me->query_skill("tianmo-shengong", 1))
    return notify_fail("你的基本内功火候不足，不能学天魔神功。\n");
  if ((int)me->query("shen") > -50000)
    return notify_fail("学天魔神功，要心狠手辣，奸恶歹毒，你可做得不够呀！\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");

  skl = this_player()->query_skills();
  sname = keys(skl);
  for (i = 0; i < sizeof(skl); i++) {
    if (sname[i] == "tianmo-shengong") continue;
    if (sname[i] == "xixing-dafa") continue;
    if (sname[i] == "yijing-force") continue;
    if (SKILL_D(sname[i])->valid_enable("force"))
      return notify_fail("你不先散了别派内功，怎能学北冥神功？！\n");
  }
  if (random(100) == 1) me->add("score", -5);
  return 1;
}

int practice_skill(object me) {
  return notify_fail("天魔神功只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func) {
  return __DIR__ "tianmo-shengong/" + func;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  int ap, dp, damage2, maxnei;
  damage2 = (int)me->query_skill("tianmo-shengong", 1);
  ap = me->query_skill("tianmo-shengong", 1);
  dp = victim->query_skill("force", 1);
  maxnei = (int)me->query("max_neili");
  if (damage_bonus < 100) return 0;
  if (me->query_skill("tianmo-shengong", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "tianmo-shengong") return 0;
  if (damage2 < 10) damage2 = 10;
  if (me->query("jm/riyue")) maxnei = (int)me->query("max_neili") * 2;
  if (random(ap) > dp / 20 && random(6) == 0 && me->query("jiali") > 0) {
    victim->receive_damage("qi", damage2 + damage_bonus, me);
    victim->receive_wound("qi", damage2 + damage_bonus, me);
    me->add("neili", -100);
    if (me->query("neili") < maxnei) me->add("neili", damage2);
    if (victim->query("neili") > damage2) victim->add("neili", -damage2);
    return HIB "$N发挥出" + HIR + "天魔神功" NOR HIB "的吸星大法，吸走了$n的精血！！！！\n" NOR;

  }
}
