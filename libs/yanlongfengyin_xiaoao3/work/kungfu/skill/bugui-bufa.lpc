// bugui.c 不归步法
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SKILL;

string *dodge_msg = ({
  "$n一个「急转步」，随着$N的攻势飘起，从容躲过这一招。\n",
  "$n使出一招「捕风捉影」，猛然纵起丈余，结果$N扑了个空。\n",
  "$n身形一摇，幻出几个人影，一招「花影重重」躲过了$N的攻势。\n",
  "$n一招「虚无飘渺」纵身跃起，倏忽已落至$N身后。\n",
  "$n左一摇，右一晃，一招「倾灭无常」已轻松闪过。\n",
  "$n双足一点，斜斜飞起，使出「世代相随」已闪到$N身侧。\n",
});

int valid_enable(string usage) {
  return (usage == "dodge");
}

int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query("family/family_name") != "杀手楼")
    return notify_fail("你不是本门中人，无法领悟本门技能的精髓。\n");
  if ((int)me->query_skill("wuji-shengong", 1) < 100)
    return notify_fail("你的无极神功火候不够，学习不归步法会走上不归路。\n");
  return 1;
}

string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query("family/family_name") != "杀手楼")
    return notify_fail("你想死吗！居然敢偷练杀手楼武功。\n");
  if ((int)me->query("qi") < 30)
    return notify_fail("你的体力太差了，不能练不归步法。\n");
  if (me->query_skill("bugui-bufa", 1) < 30)
    return notify_fail("你的不归步法太低了，无法自行练习。\n");
  me->receive_damage("qi", 10);
  me->receive_damage("qi", 20);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "bugui-bufa/" + action;
}

//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡bug有关
int ob_hit(object ob, object me, int damage) {

  int j, ap, dp;
  ap = me->query_skill("bugui-bufa", 1) * me->query("int", 1);
  dp = ob->query_skill("dodge", 1) * ob->query("dex", 1);

  if (damage < 10) damage = 10;
  if (random(ap) > dp / 10
    && me->query_skill("wuji-shengong", 1) > 300
    && me->query_skill("bugui-bufa", 1) > 300
    && me->query_skill_mapped("dodge") == "bugui-bufa"
    && me->query_skill_mapped("force") == "wuji-shengong"
    && me->query("neili") > 1000
    && random(5) == 0) {
    message_vision(HIG "一入杀手楼，天涯不归路。不归路望归人，何处不断肠！\n" NOR, me, ob);
    j = -(damage + random(damage));
    me->add("neili", -100);
    //			me->receive_damage("qi", (me->query("jiali")/10 +100),ob );
    ob->add("neili", -(me->query("jiali") + 1000));
    //			ob->receive_damage("qi", (me->query("jiali") +100),me );
    return j;
  }

}
