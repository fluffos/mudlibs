// guxing.c  天煞孤星

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target) {
  int damage, flag;
  int ap, dp;
  string msg;
  object weapon;
  flag = 1;
  if (!target) target = offensive_target(me);
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
    return notify_fail(RED "开什么玩笑，没装备剑就想使「天煞孤星」？\n" NOR);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("「天煞孤星」只能对战斗中的对手使用。\n");
  if (target && target->query_temp("apply/shade_vision"))
    return notify_fail("对方隐身了，你看不到" + target->query("name") + "。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢，哪有空运功？\n");
  if ((int)me->query_skill("guxing-sword", 1) < 300)
    return notify_fail("你的孤星剑法的火候还不到家, 不能使用「天煞孤星」 !\n");
  if (me->query_skill_mapped("sword") != "guxing-sword")
    return notify_fail("你没有使用孤星剑法, 不能使用这一绝技 !\n");
  if ((int)me->query_skill("damo-force", 1) < 300 && (int)me->query_skill("fanyun-force", 1) < 300)
    return notify_fail("你的本门神功不够娴熟，无法施展「天煞孤星」。\n");
  if (me->query_skill_mapped("force") != "fanyun-force" && me->query_skill_mapped("force") != "damo-force")
    return notify_fail("不使用本门内功，如何能使用本门绝技。\n");
  if ((int)me->query("max_neili") < 10000)
    return notify_fail(RED "你的内力修为不足，无法施展「天煞孤星」。\n" NOR);
  if ((int)me->query("neili") < 1000)
    return notify_fail(HIC "你现在内力不够，无法施展「天煞孤星」！\n" NOR);
  if ((int)me->query("jingli") < 1000)
    return notify_fail("你的精力不够。\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  if (me->query_skill_mapped("force") == "damo-force") flag = 2;
  if (me->query_skill_mapped("force") == "fanyun-force") flag = 1;
  msg = HIC "$N手中长剑剑芒跃动，剑光暴长，幻出死亡的色彩，天煞\n" NOR;
  msg += HIC "孤星降临，$n看到一道星光闪耀，抽身后跃，只这一刹，一点\n" NOR;
  msg += HIC "星光化为寒芒直刺$n前胸，快捷无伦！\n" NOR;
  message_vision(msg, me, target);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1	
  ap = me->query("xyzx_sys/level") + me->query_skill(
    "guxing-sword",
    1
  ) + me->query_skill("sword") + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
  if (random(ap) > dp / 3) {
    damage = me->query_skill(
      "guxing-sword",
      1
    ) * 2 + me->query_skill("sword", 1) + me->query_skill("force");
    damage = damage * flag + random(damage * flag);
    target->receive_damage("qi", damage / 2, me);
    target->receive_wound("qi", damage, me);
    target->receive_damage("jing", damage / 3, me);
    target->receive_wound("jing", damage / 5, me);
    msg = HIC "$n根本没法躲避，$N的这一绝招「天煞孤星」端端正\n" NOR;
    msg += HIC "正刺透$n胸口！$n大叫一声，低头一看，胸口一道血箭飚出！\n" NOR;
    message_vision(msg, me, target);
    me->add("neili", -300);
    if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
      me,
      HIW "该绝招对敌人气血的外伤为" + damage / 2 + "，内伤为" + damage + "，精神的外伤为" + damage / 3 + "，内伤为" + damage / 5 + "。\n" NOR
    );
  } else {
    msg = HIY "可是$p轻轻一笑，一拳击在$P的剑上，长\n" NOR;
    msg += HIY "剑反弹回去，险些伤了$N自己。\n" NOR;
    message_vision(msg, me, target);
    me->add("neili", -200);
  }

  if (!target->is_fighting(me)) target->fight_ob(me);
  me->start_busy(1);
  //	if(userp(target)) target->fight_ob(me);
  //	else if( !target->is_killing(me) ) target->kill_ob(me);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
