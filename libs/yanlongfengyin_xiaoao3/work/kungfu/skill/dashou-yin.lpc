int practice_level()
{
	return 56;
}
int valid_enable(string usage)
{
	return usage == "unarmed" || usage == "parry";
}
int valid_learn(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练密宗大手印必须空手。\n");
	if ((int)me->query("max_neili") < 100000)
		return notify_fail("你的内力不够。\n");
	if (me->query_skill("unarmed", 1) <=me->query_skill("dashou-yin", 1))
		return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
	if (me->query("family/family_name")!="雪山寺")
		return notify_fail("你不是雪山寺弟子，无法学习密宗大手印。\n");
    if ((int)me->query_skill("longxiang", 1) < 100 && (int)me->query_skill("xiaowuxiang", 1) < 100)
        return notify_fail("你的雪山寺内功似乎火候太浅。\n");
	if ((int)me->query("score",1) < 5000)
		return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
	if (random(100)==1) me->add("score",-5);	
	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
		if(level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练密宗大手印必须空手。\n");
	if (me->query("family/family_name")!="雪山寺")
   return notify_fail("你不是雪山寺弟子，偷练密宗武功会招来横祸。\n");
	if ((int)me->query("qi") < 40)
		return notify_fail("你的体力不够，练不了密宗大手印。\n");
	me->receive_damage("qi", 20);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"dashou-yin/" + action;
}


int ob_hit(object ob, object me, int damage)
{
	string msg;
	int j,skill, neili, neili1;
	int level,level2,damage2;
	level = (int) me->query_skill("unarmed",1);
	level2= (int) me->query_skill("longxiang",1);
	skill = me->query_skill("longxiang", 1);
	neili = me->query("neili");
	neili1 = ob->query("neili");
	if ( level2<= 0) level2= (int) me->query_skill("xiaowuxiang",1);
	damage2= (int) ob->query("neili",1)/10;
	if (random(8)==0 && level2>=300 && me->query("neili")>200 && (me->query_skill_mapped("force") == "longxiang" || me->query_skill_mapped("force") == "xiaowuxiang"))
	{
		j = -damage/2;
		if (damage2> 5000)	damage2=5000;
		if (damage2 < 0 ) damage2=0;
		msg = HIM"$N 口中喃喃念起「降妖伏魔咒」，内力汹涌而至，一层一层的加强。$n心神一乱，内力尽然提不起来！\n"NOR;
		ob->add("neili",-damage2);
		me->add("neili",-100);
		if (random(2)==0)
		{
			msg += HIM"$N"+HIM+"默念大明六字真言，手结摩利支天愤怒印! $n心神一荡，吐出一口鲜血!"+NOR;
			if (ob->query("qi") > damage2)
			{
				ob->receive_damage("qi", damage2/2,me);
				ob->receive_wound("qi", damage2/2,me);
				me->add("neili",-100);
			}
		}

		message_vision(msg, me, ob);
		return j;
	}
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
	int ap,dp,damage2;
	damage2 = (int)me->query_skill("dashou-yin",1);	
	ap = me->query_skill("dashou-yin",1);
	dp = victim->query_skill("force",1);
    if( damage_bonus < 100 ) return 0;
	if ( me->query_skill("xiaowuxiang",1) < 100 && me->query_skill("longxiang",1) < 100)	 return 0;
	if ( me->query("jiali") < 1 || me->query("neili") < 100 || (me->query_skill_mapped("force") != "xiaowuxiang" && me->query_skill_mapped("force") != "longxiang")) return 0;	
	if (damage2<10) damage2=10;	
	if (me->query_skill_mapped("force") == "xiaowuxiang") damage2 = damage2*2 + me->query("jiali");
	if( random(ap) > dp/10 && random(6)==2 && me->query("jiali")>0 )
	{
		victim->receive_wound("qi", damage2+30+damage_bonus/2,me);
		me->add("neili",-100);
		return HIR "$N右手摆在胸前，中指微曲，拇指搭在中指侧，其余三指展开如莲花初放，念道：“叭”，只见淡淡的红光包围$n。！\n" NOR;
	}
}