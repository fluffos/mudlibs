// canyun // bren

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target)
{
	string msg;
	int extra,ap,dp;

	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("「日月同辉」只能在战斗中对对手使用。\n");
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 
	if( objectp(me->query_temp("weapon")) )
		return notify_fail("使用「日月同辉」时双手必须空着！\n");
	if( (int)me->query_skill("xingyi-zhang", 1) < 300 )
		return notify_fail("你的星移掌不够娴熟，不会使用「日月同辉」。\n");
	if( (int)me->query_skill("shenyuan-gong", 1) < 300 )
		return notify_fail("你的神元功等级不够，不能使用「日月同辉」。\n");
	if ( !wizardp(me) && me->query_skill_mapped("force") != "shenyuan-gong")
		return notify_fail("不使用本门内功，如何使用本门绝学!\n"); 
	if( (int)me->query("jingli") < 1000 )
		return notify_fail("你的精力不够。\n");	
	if ( me->query_skill_mapped("unarmed") != "xingyi-zhang")
		return notify_fail("你现在无法使用「日月同辉」进行攻击。\n");
	if( (int)me->query("neili") < 1000 )
		return notify_fail("你现在内力太弱，不能使用「日月同辉」。\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	extra = me->query_skill("xingyi-zhang", 1);
	me->add("jingli", -500);
	message_vision(CYN "\n$N双掌一搓，在双掌之间形成一个耀眼的「"HIW"气旋"CYN"」！\n" NOR,me, target);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1
	ap = me->query("xyzx_sys/level") + me->query_skill("xingyi-zhang", 1) + me->query_skill("unarmed") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");

	me->add_temp("apply/dexerity", extra);
	me->add_temp("apply/attack", extra);
	me->add_temp("apply/damage", extra);

	if (random(ap) > dp/3)
	{
		msg = HIR"$N双掌收在胸前，移形换步闪电般将「"HIW"气旋"HIR"」击向$n的檀中穴！"NOR;
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK,msg);

		msg = HIG"紧接着$N抽出左掌，身形一矮，由下而上猛袭向$n的小腹！"NOR;
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK,msg);

		msg = HIR"只见$N右掌随后而至，凌空一跃，犹如晴空霹雳拍向$n的头部！"NOR;
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK,msg);

		msg = HIY"$N在空中一个回转，携「"HIR"日月之光"HIY"」, 双掌按向$n的丹田！"NOR;
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK,msg);
		me->add("neili", -400);
	}
	else
	{
		msg = HIR"$N双掌收在胸前，移形换步闪电般将「"HIW"气旋"HIR"」击向$n的檀中穴！"NOR;
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK,msg);

		msg = HIG"紧接着$N抽出左掌，身形一矮，由下而上猛袭向$n的小腹！"NOR;
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK,msg);

		msg = HIR"只见$N右掌随后而至，凌空一跃，犹如晴空霹雳拍向$n的头部！"NOR;
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK,msg);
		
		msg = HIY"$N在空中一个回转，携「"HIR"日月之光"HIY"」, 双掌按向$n的丹田！"NOR;
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK,msg);

		msg = HIC"只见$N斜身半转，陡地拍出两掌，蓄势凌厉，直指$n左胁！"NOR;
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK,msg);

		msg = HIW"$N将神元神功发挥到极限，幻化出漫天掌影，向$n全身笼罩过去！"NOR;
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK,msg);		
		me->add("neili", -600);
	}
		me->add_temp("apply/dexerity", -extra);
		me->add_temp("apply/damage", -extra);
		me->add_temp("apply/attack", -extra);	
		message_vision(YEL "\n$N一式「日月同辉」发挥的淋漓尽致，双掌一分，气定神闲，信心倍增。 \n" NOR,me, target);
		me->start_busy(1);

	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}