int valid_learn(object me) {
  object ob;
  // 	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	   
  if (me->query("family/family_name") != "白云庵" && me->query("family/family_name") != "南海派")
    return notify_fail("你不是白云庵传人,无法修习这种玄妙剑法。\n");
  if ((int)me->query("int", 1) < 30)
    return notify_fail("飞仙剑法非悟性绝顶之人，是无法领悟的！\n");
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的真气不足，难以领悟剑法的精妙之处。\n");
  if ((int)me->query_skill("bitao-shengong", 1) < 100)
    return notify_fail("你的碧涛神功不够，学不了飞仙剑法。\n");
  if (!(ob = me->query_temp("weapon")) || (string)ob->query("skill_type") != "sword")
    return notify_fail("你必须先找一把剑才能练剑法。\n");
  if ((int)me->query("score", 1) < 10000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (random(20) == 1) me->add("score", -10);
  return 1;
}

int valid_enable(string usage) {
  return usage == "sword" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  if (random(me->query_skill(
    "feixian-jian",
    1
  )) > 399 && me->query("neili") > 150 && me->query("jiali") > 100 && random(20) > 15) {
    me->add("neili", -150);
    return ([
      "action": "" HIB "忽然$N顿悟飞仙剑法的无上剑意，使出「天外飞仙」，手中$w" HIG "紫气浩荡。\n"
      "$n" HIG "只见紫气浩荡几万里，一剑西来！这一剑妙到毫巅，根本无法抵御。\n" NOR "",
      "dodge": 1000,
      "parry": 1000,
      "attack": 1000,
      "force": 1000,
      "damage": 1000,
      "damage_type": "刺伤" ]);

  }

  return action[random(sizeof(action))];
}
/*
mapping query_action(object me, object weapon)
{
    return action[random(sizeof(action))];
}
*/
int practice_skill(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query("family/family_name") != "白云庵" && me->query("family/family_name") != "南海派")
    return notify_fail("你不是白云庵弟子,无法修习这种武功。\n");
  if ((int)me->query("int", 1) < 30)
    return notify_fail("飞仙剑法非悟性绝顶之人，是无法领悟的！\n");
  if ((int)me->query("qi") < 30)
    return notify_fail("你的气太低，再练下去会有危险的！\n");
  if ((int)me->query("neili") < 35)
    return notify_fail("你的内力不够，没有办法运用飞仙剑法。\n");
  //	       if( (string)me->query("gender") != "女性" )
  //                return notify_fail("自从白云城主消失之后，飞仙剑法就只传女不传男了。\n");   
  me->receive_damage("qi", 40);
  me->add("neili", -45);
  write("你按著所学练了一遍飞仙剑法。\n");
  return 1;
}


string perform_action_file(string action) {
  return __DIR__ "feixian-jian/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  int ap, dp, damage2;
  ap = me->query("int", 1) * me->query_skill("feixian-jian", 1);
  dp = victim->query("dex", 1) * victim->query_skill("parry", 1);
  damage2 = (int)me->query_skill("feixian-jian", 1) + (int)me->query_skill("sword", 1);
  if (damage_bonus < 100) return 0;
  if (me->query_skill("bitao-shengong", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "bitao-shengong") return 0;
  if (damage2 < 10) damage2 = 10;
  if (random(ap) > dp / 10 && random(6) == 0 && me->query("jiali") > 0) {
    victim->receive_wound("qi", damage2 + damage_bonus, me);
    victim->receive_damage("qi", damage2 + damage_bonus, me);
    me->add("neili", -100);
    return HIW "$n耳边响起" HIC "“月圆之夜”" HIM "“紫禁之巅”" HIB "“一剑西来”" HIY "“天外飞仙”！" MAG "$n已被$N的天外飞仙剑气所伤！\n" NOR;
  }
}
