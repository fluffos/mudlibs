// wuji.c 天地无极


#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;

int perform(object me, object target) {
  string msg;
  int skill, ap, dp;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("「天地无极」只能在战斗中对对手使用。\n");
  if (objectp(me->query_temp("weapon")))
    return notify_fail("你必须空手使用「天地无极」！\n");
  if (target && target->query_temp("apply/shade_vision"))
    return notify_fail("对方隐身了，你看不到" + target->query("name") + "。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");
  if (target && target->is_busy())
    return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧！\n");
  if (target && target->query_temp("busy_mianyi"))  //冲穴成功后免疫busy，2017.9.29阿飞添加
    return notify_fail(target->name() + "奇经八脉浑然一体，真气浩浩荡荡，点穴似乎没什么作用。\n");
  if ((int)me->query_skill("tianluo-diwang", 1) < 500)
    return notify_fail("你的天罗地网势不够娴熟，不会使用「天地无极」！\n");
  if ((int)me->query_skill("yunv-xinfa", 1) < 300 && (int)me->query_skill("yunv-xinjing", 1) < 300)
    return notify_fail("你的玉女心法等级不够，不能使用「天地无极」！\n");
  if (me->query_skill_mapped("force") != "yunv-xinfa" && me->query_skill_mapped("force") != "yunv-xinjing")
    return notify_fail("你所用的并非玉女心法，使不了「天地无极」！\n");
  if ((int)me->query("jingli") < 1000)
    return notify_fail("你的精力太弱，不能使用「天地无极」！\n");
  if ((int)me->query("neili") < 1000)
    return notify_fail("你的内力太少了，无法使用出「天地无极」！\n");
  if (me->query_skill_mapped("unarmed") != "tianluo-diwang")
    return notify_fail("你现在无法使用「天地无极」进行攻击。\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  ap = me->query("xyzx_sys/level") + me->query_skill(
    "tianluo-diwang",
    1
  ) + me->query_skill("unarmed") + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
  skill = (int)me->query_skill("tianluo-diwang", 1);
  msg = HIC "$N突然使出天罗地网拳法的精髓「天地无极」，天地二字尽在掌握之中。\n" NOR;
  message_vision(msg, me, target);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1	  
  if (random(ap) > dp / 3) {
    msg = RED "$n被$N掌风拳劲困在天罗地网中，动弹不得。\n" NOR;
    message_vision(msg, me, target);
    me->add("neili", -300);
    target->start_busy(5 + (30 * skill) / (skill + 2000));
    tell_object(target, HIY "你陷入忙乱之中，一时无法动弹。\n" NOR);
  } else {
    msg = HIM "$n早已看出了$N的企图，纵身一跃，破解了$N的这一招！\n" NOR;
    message_vision(msg, me, target);
    me->add("neili", -50);
  }
  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
