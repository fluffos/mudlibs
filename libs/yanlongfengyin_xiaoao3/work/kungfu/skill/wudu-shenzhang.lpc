#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>
inherit SKILL;

mapping *action = ({
([      "action": "$N脸上露出诡异的笑容，隐隐泛出绿色的双掌扫向$n的$l",
		"attack":	200,
		"parry":	200,
		"dodge":	200,
		"damage":	200,
		"force":	200,
        "damage_type": "瘀伤"
]),
([      "action": "$N突然身形旋扑向$n，双掌飞舞拍向$n的$l",
		"attack":	300,
		"parry":	300,
		"dodge":	300,
		"damage":	300,
		"force":	300,
        "damage_type": "瘀伤"
]),
([	"action": "$N将毒质运至右手，阴毒无比地抓向$n的$l",
		"attack":	400,
		"parry":	400,
		"dodge":	400,
		"damage":	400,
		"force":	400,	
	"damage_type": "瘀伤"
]),
([	"action": "$N双掌如风,连环拍向$n的$l",
		"attack":	500,
		"parry":	500,
		"dodge":	500,
		"damage":	500,
		"force":	500,
	"damage_type": "瘀伤"
]),
([	"action": "$N手上乌光一闪，黑漆漆的掌影扑向$n，右手食指突然弹出，一根冰魄银针射向$n",
		"attack":	600,
		"parry":	600,
		"dodge":	600,
		"damage":	600,
		"force":	600,
	"damage_type": "内伤"
]),
});
int valid_enable(string usage) { return usage=="unarmed" ||  usage=="parry" ||  usage=="strike"; }

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}


int valid_learn(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练五毒神掌必须空手。\n");
		    if (me->query("family/family_name")!="古墓派")
   return notify_fail("你不是古墓弟子，不能传授给你。\n");
	if ((int)me->query_skill("yunv-xinfa", 1) < 100 && (int)me->query_skill("yunv-xinjing", 1) < 100)		
		return notify_fail("你的玉女心法火候不够，无法学习五毒神掌。\n");
	if ((int)me->query("max_neili") < 60)
		return notify_fail("你的内力太弱，无法练五毒神掌");
	if ((int)me->query("score",1) < 5000)
		return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
	if (random(100)==1) me->add("score",-5);		
	return 1;
}

int practice_skill(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
	if ((int)me->query("qi") < 30)
		return notify_fail("你的体力太低了。\n");
	if ((int)me->query("neili") < 8)
		return notify_fail("你的内力不够练五毒神掌。\n");
	 if (me->query("family/family_name")!="古墓派")
   return notify_fail("你不是古墓弟子，不能练习五毒神掌。\n");
	if (me->query_skill("wudu-shenzhang", 1) < 50)
		me->receive_damage("qi", 20);
	else
		me->receive_damage("qi", 30);
	me->add("neili", -5);
	return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
	int ap,dp,damage2;
	ap = me->query_con(1);
	damage2 = (int)me->query_skill("wudu-shenzhang",1);	
	dp = victim->query_str(1);
    if( damage_bonus < 100 ) return 0;
	if ( me->query_skill("yunv-xinfa",1) < 100 && me->query_skill("yunv-xinjing",1) < 100)	 return 0;
	if ( me->query("jiali") < 1 || me->query("neili") < 100 || (me->query_skill_mapped("force") != "yunv-xinfa" && me->query_skill_mapped("force") == "yunv-xinjing")) return 0;	
	if (damage2<10) damage2=10;	

	if( random(ap) > dp/10 && me->query("jiali") > 0 && random(7)==2 )
	{
		victim->receive_wound("qi", damage2+damage_bonus/2,me );
		me->add("neili", -100 );
		victim->add("neili", -(me->query("jiali") +100) );
		return HIB "你听到「砰」一声巨响，"+victim->name()+"像泄气的皮球缓缓的瘫倒！\n" NOR;
	}

	if( random(ap) > dp/10 && me->query("jiali") > 0 && random(7)==3  )
	{
        victim->apply_condition("wuduz_poison", (me->query_skill("wudu-shenzhang")/100) + 10 +victim->query_condition("wuduz_poison"));
		me->add("neili", -100);
		message_vision(HIR "$N突然掏出一根冰魄银针向你射来!------$n大叫一声：“哎呀，不好！此针有毒！”\n" NOR, me,victim);				
	}
	
}
string perform_action_file(string action)
{
	return __DIR__"wudu-shenzhang/" + action;
}

