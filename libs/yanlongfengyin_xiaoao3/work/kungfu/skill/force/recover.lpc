// recover.c
//inherit SSERVER;
int exert(object me, object target)
{
    int n, q;
	int level,jibenforce,flag,addtime;
	int huiyuan;
    if (me != target)
        return notify_fail("你只能用内功调匀自己的气息。\n");
    if ((int)me->query("neili") < 100)
        return notify_fail("你的内力不够。\n");
	if( (int)me->query("jingli") < 100 )
		return notify_fail("你的精力不够。\n");		
	if(!me->query_skill("force"))
		return notify_fail("你尚未学过内功心法。\n"); 
	if ((int)me->query_skill("force",1)<100)
		return notify_fail("你还是先学些呼吸心法的技巧！\n");  	
    if( (int)me->query("eff_qi") < (int)me->query("max_qi") / 2 )
        return notify_fail("你已经受伤过重，只怕一运真气便有生命危险！\n");    
	if ((int)me->query("qi") >= (int)me->query("eff_qi"))      	
        return notify_fail("你现在气息充沛。\n");
	if( me->is_busy() )
		return notify_fail("你现在正忙着呢，哪有空运功？\n");	
//	if (me->query_temp("autolian"))
//		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	if ( me->query_exp_times() > 1 ) addtime = 2;
		else addtime = 1;
	if(me->query("xyhy_type")==2) huiyuan = 5/4;	//黄金会员打坐增加技能熟练度1.25倍
		else huiyuan = 1;
	q = (int)me->query("eff_qi") - (int)me->query("qi");
    n = 100 * q / me->query_skill("force");
	level = (int)me->query("xyzx_sys/level");
	jibenforce = (int)me->query_skill("force",1);
	flag = (int)me->query_skill("force", 1)/2000;	
	if ( flag < 1 ) flag = 1;
    if ( flag > 5 ) flag = 5;
    if (n < 20) n = 20;
    if ((int)me->query("neili") < n) 
	{
        q = q * (int)me->query("neili") / n;
        n = (int)me->query("neili");
    }
    me->add("neili", -n);
    me->receive_heal("qi", q);
    
    message_vision(HIY"$N深深吸了几口气，脸色看起来好多了。\n"NOR, me);
//	me->start_busy(1);	//吸气要不要设置busy还有待考虑
    if (jibenforce<(level+100)*4) me->improve_skill("force", me->query_con()*addtime*huiyuan*flag*me->query("con",1)/10000+10,0);
    return 1;
}
