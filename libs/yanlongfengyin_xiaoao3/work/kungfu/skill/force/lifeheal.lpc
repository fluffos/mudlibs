// lifeheal.c
#include <ansi.h>
int heal_target(object me, object target) {
  int flag, addtime, level, jibenforce, teshuforce;
  float huiyuan;

  string force_skill = me->query_skill_mapped("force");
  flag = (int)me->query_skill(force_skill, 1) / 1000;
  if (flag < 1) flag = 1;
  if (flag > 5) flag = 5;
  if (!target->is_character() || target->is_corpse())
    return notify_fail("看清楚一点，那并不是活物。\n");
  if (!stringp(force_skill)) return notify_fail("你所学的内功中没有这项技能。\n");
  if (me->is_fighting() || target->is_fighting())
    return notify_fail("战斗中无法做人工呼吸！\n");
  if (target && target->query_temp("apply/shade_vision"))
    return notify_fail("对方隐身了，你看不到" + target->query("name") + "。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢，哪有空运功？\n");
  //	if (me->query_temp("autolian"))
  //		return notify_fail("你正在发动自动连招！\n"); 	
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
  if ((int)me->query_skill(force_skill, 1) < 200)
    return notify_fail("你的" + to_chinese(force_skill) + "修为还不够。\n");
  if ((int)me->query("max_neili") < 1000)
    return notify_fail("你的内力修为不够。\n");
  if ((int)me->query("neili") < 1000)
    return notify_fail("你的真气不够。\n");
  if ((int)me->query("jingli") < 1000)
    return notify_fail("你的精力不够。\n");
  if (target && (int)target->query("eff_qi") >= (int)target->query("max_qi") && (int)target->query("eff_jing") >= (int)target->query("max_jing"))
    return notify_fail(target->name() + "现在很清醒，你想强行为" + (target->query("gender") == "女性" ? "她" : "他") + "做人工呼吸？恐怕会挨揍吧。\n");
  if (target && (int)target->query("eff_qi") < (int)target->query("max_qi") / 3 && (int)target->query("eff_jing") < (int)target->query("max_jing") / 3)
    return notify_fail(target->name() + "已经受伤过重，经受不起你的真气震荡！\n");
  if (target && !living(target))
    return notify_fail(target->name() + "现在都这样了，不需要你为" + (target->query("gender") == "女性" ? "她" : "他") + "做人工呼吸！你想趁人之危吗！\n");
  if (me->query_exp_times() > 1) addtime = 2;
  else addtime = 1;
  if (me->query("xyhy_type") == 2) huiyuan = 1.25;  //黄金会员打坐增加技能熟练度1.25倍
  else huiyuan = 1;
  level = (int)me->query("xyzx_sys/level");
  jibenforce = (int)me->query_skill("force", 1);
  teshuforce = (int)me->query_skill(force_skill, 1);
  message_vision(HIY "$N坐了下来运起内功，深吸了一口气，嘴对着$n的嘴，缓缓地将真气输入$n体内....\n\n"
    "过了不久，$N额头上冒出豆大的汗珠，$n深深地吐出一口气，脸色看起来红润多了。\n" NOR,
    me, target);
  target->receive_curing(
    "qi",
    10 + (int)me->query_skill("force") / 3 + target->query("max_qi") / 20
  );
  target->add("qi", 10 + (int)me->query_skill("force") / 3 + target->query("max_qi") / 20);
  target->receive_curing(
    "jing",
    10 + (int)me->query_skill("force") / 3 + target->query("max_qi") / 20
  );
  target->add("jing", 10 + (int)me->query_skill("force") / 3 + target->query("max_qi") / 20);
  if ((int)target->query("qi") > (int)target->query("eff_qi")) target->set(
    "qi",
    (int)target->query("eff_qi")
  );
  if ((int)target->query("jing") > (int)target->query("eff_jing")) target->set(
    "jing",
    (int)target->query("eff_jing")
  );
  me->add("neili", -150);
  me->set("jiali", 0);
  target->set("jiali", 0);
  me->start_busy(2);
  if (jibenforce < (level + 100) * 4) me->improve_skill(
    "force",
    me->query_con(1) * addtime * huiyuan * flag * me->query("con", 1) / 200 + 10,
    0
  );
  if (me->query_skill_mapped("force") && teshuforce < jibenforce && teshuforce < (level + 300) * 2)
    me->improve_skill(
      force_skill,
      me->query_con() * addtime * huiyuan * flag * me->query("con", 1) / 80 + 10,
      0
    );
  return 1;
}
int exert(object me, object target) {
  if (!target || target == me)
    return notify_fail("不能给自己续气！\n");
  else
    return heal_target(me, target);
}
