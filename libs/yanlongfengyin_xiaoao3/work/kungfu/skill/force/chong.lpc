#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;

int exert(object me, object target)
{
	int level;
	string force_skill=me->query_skill_mapped("force");

	if( target != me )
		return notify_fail("你只能给自己运功冲穴。\n");		
	if (!living(me))
		return notify_fail("你是个活人吗？\n");
	if (!userp(me))
		return notify_fail("你是人类吗？\n");
    if (!stringp(force_skill))
        return notify_fail("你所学的内功中没有这项技能。\n");
	if ( me->query_skill("force",1)<2000)
		return notify_fail("你的基本内功也太差劲了吧。\n");	
    if ((int)me->query_skill(force_skill, 1) < 1000)
        return notify_fail("你的"+to_chinese(force_skill)+"修为还不够。\n");
    if( (int)me->query("neili") < 10000 )
        return notify_fail("你的内力不够。\n");
    if( (int)me->query("max_neili") < 10000000 )
        return notify_fail("你的内力修为太差了。\n");
    if( (int)me->query("jingli") < 10000 )
        return notify_fail("你的精力不够。\n");
    if( (int)me->query("max_jingli") < 10000000 )
        return notify_fail("你的精力修为太差了。\n");
	if (!(int)me->query("breakup"))
        return notify_fail("你任督二脉未通，还未领悟运功冲穴的技巧。\n"NOR); 
	if ( me->query_temp("chongcooldown") )
		return notify_fail("你刚刚运功冲穴，还是休息会吧。\n");	
	if ( me->query_temp("pending/exercise"))
		return notify_fail("纳尼！打坐炼气过程中也想运功冲穴？。\n");	
	if ( me->query_temp("pending/respirate"))
		return notify_fail("纳尼！吐纳炼精过程中也想运功冲穴？。\n");		
	if( me->query_condition("no_chong") )
		return notify_fail("你的丹田被破，无法运功冲穴。\n");
	if (!me->is_busy())
		return notify_fail("你的经脉穴道很正常啊。\n");
	if (me->is_busy() && (int)me->query_busy()<6)	
		return notify_fail("你的经脉穴道淤塞的不是很厉害，用不着运功冲穴。\n");
//	if (me->query_temp("autolian"))
//		return notify_fail("你正在发动自动连招！\n"); 	
//	if ( me->query_temp("cooldown") )	//技能CD写法	2017.9.7添加
//		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
	if ( me->query_temp("busy_mianyi") )	//CD写法	2017.9.7添加
		return notify_fail("你的奇经八脉真气浩浩荡荡，用不着运功冲穴。\n");

	level = (int)me->query_skill(force_skill, 1)+(int)me->query_skill("force", 1)/2;		
	me->set_temp("chongcooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_chongcooldown", 5, me);	//CD写法1
	if (random(level)>1000)
	{
		me->add("neili", -10000);
		me->add("jingli", -10000);
		me->start_busy(1);			
		write(HIM"你运转全身功力，冲开了淤塞的经脉，浑身舒畅不已，内力贯通奇经八脉，如滔滔江水连绵不绝。\n");
		me->set_temp("busy_mianyi", 1);	//冲穴成功后免疫busy，2017.9.29阿飞添加
		call_out("del_busy_mianyi", 10+100*level/(level+5000), me);	//冲穴成功后免疫busy
	}
	else
	{
		write(HIW"你运转全身功力冲击淤塞的经脉，然而内功修为不足，功亏一篑。\n");
	}
	
	return 1;
}

void del_chongcooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("chongcooldown") )	
	{
		me->delete_temp("chongcooldown");
		tell_object(me, HIM"你长长的吐出一口气，真气缓缓退回丹田。\n"NOR);
	}	
}

void del_busy_mianyi(object me)	
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("busy_mianyi") )	
	{
		me->delete_temp("busy_mianyi");
		tell_object(me, HIR"你任督二脉中蕴含的真气缓缓退去，奇经八脉恢复平静。\n"NOR);
	}	
}

