#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;

int perform(object me, object target)
{
	object weapon;
	int damage,damage2,skill, ap, dp;

	if ( !target ) target = offensive_target(me);
	if ( !target || !target->is_character() || !me->is_fighting(target) || !living(target))
		return notify_fail(HIW"你只能在战斗中使用。\n"NOR);
	if ( playerp(me) && me->query("family/family_name") != "蜀山派" ) 
		return notify_fail("不是蜀山的不能用「御剑今生」！\n");
	if ( playerp(me) && me->query("shushan/jinsheng_perform") != 1 ) 
		return notify_fail("你还没领会「御剑今生」！\n");
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
	if ( (int)me->query("max_neili") < 200000 ) 
		return notify_fail("你的内力修为太低。\n");
	if ( (int)me->query("max_jingli") < 200000 ) 
		return notify_fail("你的精力修为太低。\n");
	if ( (int)me->query("neili") < 10000 ) 
		return notify_fail("你的内力不足。\n");
	if ( (int)me->query("jingli") < 10000 ) 
		return notify_fail("你的精力不足。\n");
	if ( (int)me->query_skill("sword", 1) < 1000 ) 
		return notify_fail("你的基本剑法等级不够，不能使用这一招！\n");
	if ( (int)me->query_skill("yujianshu", 1) < 500 ) 
		return notify_fail("你的御剑术等级不够，不能使用这一招！\n");
	if( !objectp(weapon = me->query_temp("weapon")) || weapon->query("skill_type") != "sword" ) 
		return notify_fail("你必须手持剑才能使用剑法。\n");
	if ( (int)me->query_skill("shushan-force", 1) < 500 ) 
		return notify_fail("你的蜀山心法等级不够，不能使用这一招！\n");
	if ( me->query_skill_mapped("force") != "shushan-force" ) 
		return notify_fail("没有蜀山心法无法驾驭剑气。\n");
	if (me->query_skill_mapped("sword") != "yujianshu") 
		return notify_fail("你没正确激发该技能 。\n");
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1
	ap = me->query("xyzx_sys/level") + me->query_skill("yujianshu", 1) + me->query_skill("sword") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	skill = (int)me->query_skill("yujianshu", 1);
	
	message_vision(HIC"\n$N口中默念御剑口诀，手中长剑顿时间霞光四射，一招「御剑伏魔」直斩$n！\n\n"NOR,me,target);
	if ( random(ap) > dp/3 )
	{    
		message_vision(HIC"\n$N长啸：伏魔天地间，御剑任逍遥！！！\n\n"NOR,me,target);
		damage = skill*5+random((int) me->query("max_qi"))/10;
		damage2 = skill*5+random((int) me->query("max_jing"))/10;
		target->receive_damage("qi", damage, me);
		target->receive_damage("jing", damage2, me);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，精神的外伤为"+ damage2 +"。\n" NOR);
		me->add("neili", -1000);
		me->add("jingli", -1000);
	} else
	{
		message_vision(HIB"\n$n看清$N招式来处，轻轻一跳，避开了这一剑！！！\n\n"NOR, me, target);
	}

if ( (int)me->query_skill("yujianshu", 1) > 1000 )
{
	message_vision( CYN"\n$N手腕晃动如疾风，以砍断三千尺飞流的速度，直逼$n！\n"NOR, me, target);	
	damage = (me->query_skill("sword")+me->query_skill("songhe-sword",1)+me->query("jiali")+target->query_skill("sword"))*2 + target->query("qi")/50;
	damage = damage + random(damage);
	if ( random(ap) > dp/3 ) 
	{	
		message_vision(CYN"结果$n被$N的「断水无痕」拦腰而过！\n"NOR, me, target);
		me->add("neili", -1000);
		me->add("jingli", -1000);		
		target->receive_damage("qi", damage, me);
		target->receive_wound("qi", damage, me);
		target->receive_damage("jing", damage, me);
		target->receive_wound("jing", damage, me);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage +"，精神的外伤为"+ damage +"，内伤为"+ damage +"。\n" NOR);
	}  
	else 
	{
		message_vision(HIW"但是被$n躲开了。\n"NOR, me, target);
	}
}
if ( (int)me->query_skill("yujianshu", 1) > 2000 )
{
	message_vision(HIB"\n$N眼见不敌，想起了访宁桥上那首诗，心中默念：",me,target);
	message_vision(HIG"\n\n所有的这一切都只有等待来生了......",me,target);
	message_vision(HIB"\n\n$N一念及此，身形与手中长剑化为一体直射$n～～～～～ \n\n"NOR,me,target);	
	if ( random(ap) > dp/3 ) 
	{
		me->add("neili", -1000);
		me->add("jingli", -1000);
		message_vision(HIB"\n\n$n不料$N如此决绝，竟然呆立当场，瞬间一道蓝光已在$n身上当胸穿过！！！\n"NOR, target ,me);
		if ( random(5)==0 ) 
		{
			message_vision(HIR"\n\n半空中传来一声长叹：地绝他也，天绝我也～～～～～ \n\n"NOR,me);
			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人和自己造成了昏迷。\n" NOR);
			target->unconcious();
			me->unconcious();			
		}
		else
		{
			damage = ap + random(dp);
			target->receive_damage("jing", damage, me);
			target->receive_wound("jing", damage, me);
			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人精神的外伤为"+ damage +"，内伤为"+ damage +"。\n" NOR);
		}
	} else
	{
		message_vision(HIB"\n$n一见情势不妙，拼命向后纵越，竟然在狼狈不堪之际侥幸地躲过了这拼命的一式！！！\n\n"NOR, me, target);
	}	
}	
	me->start_busy(1);
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}