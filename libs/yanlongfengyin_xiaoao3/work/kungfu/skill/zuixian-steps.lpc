// chaos-steps.c
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SKILL;

string *dodge_msg = ({
	"$n一个「醉卧云端」，躲过了$N这一招。\n",
	"$n身形向后一纵，使出一招「饮尽江河」，避过了$N的攻击。\n",
	"$n使出「千杯不倒」，恰好躲过了$N的攻势。\n"
       "但是$n身形飘忽,一招「笑看红尘」,轻轻一纵，早已避开。\n",
       "$n使出「与月共饮」,身随意转，倏地往一旁挪开了三尺，避过了这一招。\n",
       "$n一个「醉眼朦胧」,身形微晃，有惊无险地避开了$N这一招。\n"
});

int valid_enable(string usage)
{
	return (usage=="dodge");
}

int valid_learn(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if( (int)me->query("max_neili") < 5000 )
		return notify_fail("你的内力不够，没有办法练醉仙望月步。\n");
	    if (me->query("family/family_name")!="蜀山派")
   return notify_fail("你不是蜀山弟子，无法学习醉仙望月步。\n");
    if ((int)me->query_skill("shushan-force", 1) < 100)
    return notify_fail("你的蜀山内功火候不够，无法学习醉仙望月步。\n");

	return 1;
}

string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if( (int)me->query("qi") < 30
	||	(int)me->query("neili") < 3 )
		return notify_fail("你的气或内力不够，不能练醉仙望月步。\n");
		    if (me->query("family/family_name")!="蜀山派")
   return notify_fail("你不是蜀山弟子，无法练习醉仙望月步。\n");	
	me->receive_damage("qi", 30);
	me->add("neili", -3);
	return 1;
}

string perform_action_file(string action)
{
        return __DIR__"zuixian-steps/" + action;
}

	//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{

        int j,ap,dp;
		ap = me->query_skill("zuixian-steps", 1) * me->query("int",1);
		dp = ob->query_skill("dodge", 1) * ob->query("dex",1);

	if (damage <10)  damage=10;      	
      if(random(ap) > dp/10
		&& me->query_skill("shushan-force",1) > 100
		&& me->query_skill("zuixian-steps", 1) > 200
		&& me->query_skill_mapped("force") == "shushan-force"
        && me->query("neili") > 1000
		&& random(5)==0	)
        { 	
        message_vision(HIG"$N醉眼朦胧，脚步东倒西歪的，看似不可能，实则一摇一晃间就闪开了$n的攻击！\n"NOR, me, ob); 		
            j = -(damage+random(damage)); 
			me->add("neili", -100 );
			return j;        
        }  
		
}
