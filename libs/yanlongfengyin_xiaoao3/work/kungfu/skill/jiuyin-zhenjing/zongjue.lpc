// zongjue.c

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;
//inherit F_CLEAN_UP;

int check_fight(object me);
void remove_effect(object me, int amount);

int exert(object me, object target)
{
        int skill;
		
	if( target != me ) 
		return notify_fail("你只能对自己用["+HIB+"九阴总诀"+NOR+"]提升战斗力\n"NOR,);
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");
	if (me->query_skill_mapped("force") !="jiuyin-zhenjing")
		return notify_fail("你未使用九阴真经，无法使用九阴总决。\n");	
//	if (target && target->query_temp("apply/shade_vision")) 
//		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 			
	if ( (int)me->query_skill("jiuyin-zhenjing", 1) < 500)
		return notify_fail("你的九阴真经太差了。\n");
    if( (int)me->query("neili") < 1000 )
        return notify_fail("你的内力不够！\n");
    if( (int)me->query("jingli") < 1000 )
        return notify_fail("你的精力不够！\n");
    if( (int)me->query("max_neili") < 100000 )
        return notify_fail("你的内力修为太差！\n");
    if( (int)me->query("max_jingli") < 100000 )
        return notify_fail("你的精力修为太差！\n");
	if (!(int)me->query("breakup"))
		return notify_fail("你任督二脉未通,无法使用["+HIR+"「九阴总诀」"+NOR+"]\n"NOR,);
	if ( (int)me->query_temp("jiuyin") )
		return notify_fail("你已经在运用九阴总决中了。\n");	
	if ( me->query_temp("powerup") )
		return notify_fail("你已经在运别的内功中了。\n");	
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");		
	
	me->set_temp("powerup", 1);
	me->set_temp("jiuyin", 1);
    skill = (int)me->query_skill("jiuyin-zhenjing", 1)*2+(int)me->query_skill("force", 1)/2;
	me->add("neili", -200);
	me->add("jingli", -200);
        message_vision(HIR "$N" HIR "默念九阴真经的总诀："
                            "\n天之道，损有馀而补不足，是故虚胜实，不足胜有馀。"
                            "其意博，其理奥，其趣深。\n天地之像分，" 
                        HIR "阴阳之侯烈，变化之由表，死生之兆章。\n"
                        HIR "故弱之胜强，柔之胜刚，天下莫不知，莫能行。\n" NOR, me);
						
						
        me->add_temp("apply/armor", skill);
        me->add_temp("apply/attack", skill);
        me->add_temp("apply/dodge", skill);
        me->add_temp("apply/damage", skill);
        me->add_temp("apply/strength",skill);
        me->add_temp("apply/dexerity",skill);
        me->add_temp("apply/constitution",skill);
        me->add_temp("apply/intelligence",skill);
		check_fight(me);
        me->start_call_out((:call_other,__FILE__,"remove_effect",me,skill:),skill/10);
		me->start_busy(1);
        return 1;
}

int check_fight(object me)
{
	if (!me || !(int)me->query_temp("jiuyin")) return 0;
	if (me && !living(me)) return 0;
    if (me->query("qi") < 1 || me->query("eff_qi") < 1) return 0;  //解决 气血为负数 不晕不死的bug
	if (me->query("jing") < 1 || me->query("eff_jing") < 1) return 0;
	
        if (living(me)
            && me->is_fighting() && me->query("neili") > 500
            && me->query_skill_mapped("force") == "jiuyin-zhenjing")
        {
                if(me->query("qi") < (int)me->query("max_qi"))
				{
                    message_vision(HIY"$N脸色一沈又回复正常，想是正在调节内息。\n"NOR,me);
                    me->add("neili", -200);
                    me->add("eff_qi",me->query_skill("jiuyin-zhenjing",1)*me->query("con",1)+me->query("max_qi")/50);
					if (me->query("eff_qi") > me->query("max_qi")) me->set("eff_qi", me->query("max_qi"));
                    me->add("qi",me->query_skill("jiuyin-zhenjing",1)*me->query("con",1)+me->query("max_qi")/50);
					if (me->query("qi") > me->query("eff_qi")) me->set("qi", me->query("eff_qi"));
                }
				if(me->query("jing") < (int)me->query("max_jing"))
				{
                    message_vision(HIR"$N脸色一沈又回复正常，想是正在调节内息!\n"NOR,me);
                    me->add("neili", -200);
                    me->add("eff_jing",me->query_skill("jiuyin-zhenjing",1)*me->query("con",1)+me->query("max_jing")/50);
					if (me->query("eff_jing") > me->query("max_jing")) me->set("eff_jing", me->query("max_jing"));
                    me->add("jing",me->query_skill("jiuyin-zhenjing",1)*me->query("con",1)+me->query("max_jing")/50);
					if (me->query("jing") > me->query("eff_jing")) me->set("jing", me->query("eff_jing"));
                }	
				
        }
        call_out("check_fight", 5, me);
        return 1;
}       

void remove_effect(object me, int amount)
{
	   if (!me) return;
        me->delete_temp("jiuyin");
		me->set_temp("powerup");
        me->add_temp("apply/armor", -amount);
        me->add_temp("apply/attack", -amount);
        me->add_temp("apply/dodge", -amount);
        me->add_temp("apply/damage", -amount);
        me->add_temp("apply/strength",-amount);
        me->add_temp("apply/dexerity",-amount);
        me->add_temp("apply/constitution",-amount);
        me->add_temp("apply/intelligence",-amount);
        tell_object(me, "你的["+HIB+"九阴总诀"+NOR+"]运行完毕，将内力收回丹田。\n");
}