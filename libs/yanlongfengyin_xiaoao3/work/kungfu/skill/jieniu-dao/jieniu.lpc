// /kungfu/skill/gu.c 庖丁解牛
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target) {
  int damage, flag, ap, dp;
  string msg;
  object weapon;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("「庖丁解牛」只能对战斗中的对手使用。\n");
  if (target && target->query_temp("apply/shade_vision"))
    return notify_fail("对方隐身了，你看不到" + target->query("name") + "。\n");
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "blade")
    return notify_fail("你使用的武器不对。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着！\n");
  if ((int)me->query_skill("jieniu-dao", 1) < 500)
    return notify_fail("你的解牛刀法不够娴熟，不会使用「庖丁解牛」!\n");
  if ((int)me->query_skill(
    "huaxue-dafa",
    1
  ) < 300 && (int)me->query_skill(
    "yiqiguan-riyue",
    1
  ) < 300 && (int)me->query_skill("longmen-shengong", 1) < 300)
    return notify_fail("你对本门内功了解不够深刻，不会使用「庖丁解牛」!\n");
  if (me->query_skill_mapped("force") != "huaxue-dafa" && me->query_skill_mapped("force") != "yiqiguan-riyue" && me->query_skill_mapped("force") != "longmen-shengong")
    return notify_fail("你未使用本门内功，如何能使用本门绝技。\n");
  if ((int)me->query("neili") < 1000)
    return notify_fail("你现在内力太弱，不能使用「庖丁解牛」!\n");
  if ((int)me->query("jingli") < 1000)
    return notify_fail("你现在精力太弱，不能使用「庖丁解牛」!\n");
  if (me->query_skill_mapped("blade") != "jieniu-dao")
    return notify_fail("你没有激发解牛刀，无法施展「庖丁解牛」。\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  flag = 1;
  if (me->query_skill_mapped("force") == "longmen-shengong") flag = 2;
  if (me->query_skill_mapped("force") == "huaxue-dafa") flag = 1;
  if (me->query_skill_mapped("force") == "yiqiguan-riyue") flag = 3;
  msg = CYN "$N默运神功，使出「庖丁解牛」，单刀平推攻向$n。\n" NOR;
  message_vision(msg, me, target);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1

  ap = me->query("xyzx_sys/level") + me->query_skill(
    "jieniu-dao",
    1
  ) + me->query_skill("blade") + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
  damage = (int)me->query_skill(
    "jieniu-dao",
    1
  ) * flag + (int)me->query_skill("blade", 1) + (int)me->query_skill("force");
  msg = HIW "\n$N凌空飞起,手中兵器发出奇异的光芒，接着一片片如实质般刀光狂涌向对手。\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
  me->add("neili", -500);

  if (random(ap) > dp / 3) {
    damage = damage + random(damage);
    target->receive_damage("qi", damage, me);
    target->receive_wound("qi", damage / 3, me);
    me->add("neili", -300);
    msg = HIR "结果$n被$N一刀斩中，眼前一黑，伤口血涌如柱！\n" NOR;
    message_vision(msg, me, target);
    if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
      me,
      HIW "该绝招对敌人气血的外伤为" + damage + "，内伤为" + damage / 3 + "。\n" NOR
    );
  } else {
    me->add("neili", -100);
    msg = CYN "可是$p看破了$P的企图，身形一转，回击过去。\n" NOR;
    message_vision(msg, me, target);
  }

  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
