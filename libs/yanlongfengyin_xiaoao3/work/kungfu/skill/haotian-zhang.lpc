int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }

int valid_learn(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练昊天掌必须空手。\n");
  if (me->query("family/family_name") != "全真教")
    return notify_fail("你未加入全真教，无法学习本门技能。\n");
  if ((int)me->query_skill(
    "xiantian-qigong",
    1
  ) < 100 && (int)me->query_skill("tiangang-zhengqi", 1) < 100)
    return notify_fail("你的内功火候不够，无法学昊天掌。\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (random(100) == 1) me->add("score", -5);
  return 1;
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("qi") < 30)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 20)
    return notify_fail("你的内力不够练昊天掌。\n");
  if (me->query("family/family_name") != "全真教")
    return notify_fail("你未加入全真教，无法练习昊天掌。\n");
  me->receive_damage("qi", 25);
  me->add("neili", -10);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "haotian-zhang/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus) {

  int ap, dp, level, damage2;
  level = (int)me->query_skill("haotian-zhang", 1);
  ap = (int)me->query("dex", 1) * (int)me->query_skill("haotian-zhang", 1);
  dp = (int)victim->query("str", 1) * (int)me->query_skill("parry", 1);
  damage2 = (int)me->query_skill("haotian-zhang", 1);

  if (damage_bonus < 100) return 0;
  if (me->query_skill(
    "tiangang-zhengqi",
    1
  ) < 100 && me->query_skill("xiantian-qigong", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || (me->query_skill_mapped("force") != "tiangang-zhengqi" && me->query_skill_mapped("force") != "xiantian-qigong")) return 0;
  if (damage2 < 10) damage2 = 10;

  if (random(5) == 0 && level > 100 && me->query("neili") > 500 && random(ap) > dp / 10 && me->query("jiali") > 0) {
    message_vision(HIY "$N 双掌蕴含先天纯阳内劲，$n与你对了一掌，只感觉五内俱焚，不禁吐出一口鲜血！。\n" NOR, me, victim);
    me->add("neili", -(me->query("jiali") + 100));
    if (me->query_skill_mapped("force") == "xiantian-qigong") {
      //			if (!victim->is_busy()) victim->start_busy(random(3)); 
      victim->receive_wound("qi", damage2 * 2 + damage_bonus / 2, me);
      victim->receive_damage("qi", damage2 * 2 + damage_bonus / 2, me);
    } else {
      victim->receive_wound("qi", damage2 + damage_bonus / 2, me);
      victim->receive_damage("qi", damage2 + damage_bonus / 2, me);
    }

  }

  return;
}
