int valid_enable(string usage) { return (usage == "blade") || (usage == "parry"); }
int valid_learn(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if ((int)me->query("max_neili") < 100000)
        return notify_fail("你的内力不够。\n");
	if ((int)me->query_skill("blade", 1) < 1000)
        return notify_fail("你的基本刀法火候太浅。\n");
    if (me->query("family/family_name")!="杀手楼")
		return notify_fail("你未加入杀手楼，不能传授楼主高深功夫。\n");	
    if ((int)me->query_skill("wuji-shengong", 1) < 300)
		return notify_fail("你的无极神功火候不够，无法学习本门技能。\n");
	if ((int)me->query("str",1) < 30)
		return notify_fail("你的臂力不够，难以练习泣神刀。\n");  
	if ((int)me->query("score",1) < 10000)
		return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
	if (random(10)==1) me->add("score",-10);	
        return 1;
}
mapping query_action(object me, object weapon)
{
	int zhaoshu, level;
	zhaoshu = sizeof(action)-1;
	level = (int) me->query_skill("qishen-dao",1);
	if (level < 600 ) zhaoshu--;
	if (level < 500 ) zhaoshu--;
	if (level < 400 ) zhaoshu--; 
	if (level < 300 ) zhaoshu--;
	if (level < 200 ) zhaoshu--;
	if (level < 100 ) zhaoshu--;
	return action[random(zhaoshu)];
}
int practice_skill(object me)
{
        object weapon;
//			if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "blade")
                return notify_fail("你使用的武器不对。\n");
    if (me->query("family/family_name")!="杀手楼")
   return notify_fail("你未加入杀手楼，不能练习楼主高深功夫。\n");					
        if ((int)me->query("qi") < 50)
                return notify_fail("你的体力不够练泣神刀。\n");
        me->receive_damage("qi", 40);
        return 1;
}
string perform_action_file(string action)
{
        return __DIR__"qishen-dao/" + action;
}


mixed hit_ob(object me, object victim, int damage_bonus)
{
	int ap,dp,damage2;
	damage2 = (int)me->query_skill("qishen-dao",1);	
	ap = me->query_skill("qishen-dao",1);
	dp = victim->query_skill("parry",1);
    if( damage_bonus < 100 ) return 0;
	if ( me->query_skill("wuji-shengong",1) < 100)	 return 0;
	if ( me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "wuji-shengong") return 0;	
	if (damage2<10) damage2=10;	
	if(	me->query_skill("force",1) >300
	    && random(ap) > dp/10
		&& me->query_skill_mapped("force")=="wuji-shengong"
		&& random(5)==0 
		&& me->query("jiali") > 0)
	{
		victim->receive_wound("qi", damage2+damage_bonus/2,me);
		me->add("neili", -100 );
//		if (!victim->is_busy()) victim->start_busy(1);		
		return HIR "只听$n一声鬼哭狼嚎，被$N的无极神刀击中三阴穴！\n" NOR;
	}
}