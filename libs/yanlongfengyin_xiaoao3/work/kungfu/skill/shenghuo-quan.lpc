// shenghuo-quan.c 圣火拳	下乘武学100~300
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SKILL;

mapping *action = ({
  ([ "action": "$N使一招「凤凰长吟」，双手上下翻飞，击向$n的$l",
    "attack": 100,
    "parry": 100,
    "dodge": 100,
    "damage": 100,
    "force": 100,
    "skill_name": "凤凰长吟",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N左手护住胸前，右手使一招「困虎云啸」，向$n的$l插去",
    "attack": 200,
    "parry": 200,
    "dodge": 200,
    "damage": 200,
    "force": 200,
    "skill_name": "困虎云啸",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N默运内力，全身骨骼暴响，一招「卧龙天翔」打向$n的$l",
    "attack": 300,
    "parry": 300,
    "dodge": 300,
    "damage": 300,
    "force": 300,
    "skill_name": "卧龙天翔",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N左右手同时使出「双飞龙」,发出一道真气击向$n的$l",
    "attack": 300,
    "parry": 300,
    "dodge": 300,
    "damage": 300,
    "force": 300,
    "skill_name": "双飞龙",
    "damage_type": "瘀伤"
  ]),
});

int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }

int valid_learn(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练圣火拳必须空手。\n");
  if (me->query("family/family_name") != "明教")
    return notify_fail("你不是明教弟子，无法学习本教技能。\n");
  if ((int)me->query_skill("shenghuo-shengong", 1) < 100)
    return notify_fail("你的圣火神功火候不够，无法学圣火拳。\n");
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力太弱，无法练圣火拳。\n");
  return 1;
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("qi") < 30)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 20)
    return notify_fail("你的内力不够练圣火拳。\n");
  if (me->query("family/family_name") != "明教")
    return notify_fail("你不是明教弟子，无法练习本教技能。\n");
  me->receive_damage("qi", 25);
  me->add("neili", -10);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "shenghuo-quan/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus) {

  int ap, dp, level, damage2;
  level = (int)me->query_skill("shenghuo-quan", 1);
  ap = (int)me->query("dex", 1) * (int)me->query_skill("shenghuo-quan", 1);
  dp = (int)victim->query("str", 1) * (int)me->query_skill("parry", 1);
  damage2 = (int)me->query_skill("shenghuo-quan", 1);

  if (damage_bonus < 100) return 0;
  if (me->query_skill("shenghuo-shengong", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "shenghuo-shengong") return 0;
  if (damage2 < 10) damage2 = 10;

  if (random(5) == 0 && level > 100 && me->query("neili") > 500 && random(ap) > dp / 10 && me->query("jiali") > 0) {
    message_vision(HIY "$N双拳红光大作，出拳扰动，四周空气温度骤然升高。\n" NOR, me, victim);
    me->add("neili", -100);
    //         if (!victim->is_busy()) victim->start_busy(random(3));
    message_vision(CYN "$n越战越难受，似乎觉得要吐血才能缓解！。\n" NOR, me, victim);
    victim->receive_wound("qi", damage2 + damage_bonus / 2, me);
    victim->receive_damage("qi", damage2 + damage_bonus / 2, me);

  }

  return;
}
