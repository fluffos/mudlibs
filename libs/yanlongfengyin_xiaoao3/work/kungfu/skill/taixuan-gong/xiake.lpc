#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>
#define JING "「" HIW "侠客行" NOR "」"
inherit F_SSERVER;

int perform(object me, object target)
{
        int damage,damage1;
        string msg;
        int ap, dp;

    if (! target) target = offensive_target(me);
    if( !target || !target->is_character() || !me->is_fighting(target) ) 
		return notify_fail(JING "只能对战斗中的对手使用。\n");
	if( objectp(me->query_temp("weapon")) )
		return notify_fail("你必须空手才能使用！\n");	
//	if (target && target->query_temp("apply/shade_vision")) 
//		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");	
    if ((int)me->query("max_neili") < 1000000)
        return notify_fail("你内力修为不够，难以施展" JING "。\n");
    if ((int)me->query("max_jingli") < 1000000)
        return notify_fail("你精力修为不够，难以施展" JING "。\n");
    if ((int)me->query_skill("taixuan-gong", 1) < 1000)
		return notify_fail("你太玄功火候不够，难以施展" JING "。\n");
    if ((int)me->query("neili") < 10000)
		return notify_fail("你现在真气不够，难以施展" JING "。\n");
    if ((int)me->query("jingli") < 10000)
		return notify_fail("你现在精力不够，难以施展" JING "。\n");
    if (me->query_skill("force", 1) < 5000)
		return notify_fail("你基本内功不足，难以施展" JING "。\n");		
    if (me->query_skill_mapped("force") !="taixuan-gong")
		return notify_fail("你不用太玄功催动内力，难以施展" JING "。\n");
    if (me->query_skill_mapped("unarmed") !="taixuan-gong")
		return notify_fail("你未激发太玄功为拳脚，难以施展" JING "。\n");		
	if (!(int)me->query("breakup"))
        return notify_fail("你任督二脉未通,无法使用[" HIR "侠客行" NOR "]\n"NOR); 
	if ( !wizardp(me) && me->query("jm/taixuan") != 1 ) 
		return notify_fail("你还没领会「太玄功」的精髓！\n");
    if (target && !living(target))
		return notify_fail("对方都已经这样了，用不着这么费力吧？\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
		message_vision(HBWHT "$N贯通太玄经，使出了太玄功的绝学之精髓！\n" NOR, me, target);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 5, me);	//CD写法1		
        message_vision(HIM "\n$N" HIM "情不自禁的纵声长啸，霎时之间，千百种招式纷至沓来，涌"
                     "向心头。\n$N" HIM "随手挥舞，已是不按次序，但觉无论何种招式皆能随心所欲"
                     "，既不必存想内息，\n亦不须记忆招数，石壁上的千百种招式，自然而然的从心"
                     "中传向手足，尽数袭向$n" HIM "。\n" NOR, me, target);

	ap = me->query("xyzx_sys/level") + me->query_skill("taixuan-gong", 1) + me->query_skill("unarmed") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");

        // 第一招，判断对方臂力

        message_vision(HIW "\n$N" HIW "突然间只觉得右肋下‘渊液穴’上一动，一道热线沿着‘足少"
                     "阳胆经’，\n向着‘日月’、‘京门’二穴行去，\n一招‘十步杀一人’的"  + 
                     "拳法已随意使出，各种招式源源而出，将$n" HIW "笼罩。\n" NOR, me, target);
	    me->add("neili", -1000);
		me->add("jingli", -1000);
        if (random(ap*me->query("str",1)) > dp*target->query("str",1)/3)
        {
            damage1 = me->query_skill("taixuan-gong", 1)*me->query("str") + me->query("xyzx_sys/level") + me->query_skill("unarmed") + me->query_skill("force");
			damage = damage1 + random(damage1);
            msg =HIY "$n" HIY "却觉$N" HIY "这招气势恢弘，于是运力奋力抵挡。但是无奈这"
                "招威力惊人，\n$n" HIY "闷哼一声，倒退几步，顿觉内息涣散，" + "双手" + HIY 
                "上早已染满鲜血！\n" NOR;
			message_vision(msg, me, target);			
            target->receive_damage("qi",damage,me);
		    target->receive_wound("qi",damage/2,me);
            target->add("neili", -damage);
			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"，杀内力"+ damage +"。\n" NOR);
        } else
        {
            msg = HIC "$n" HIC "气贯双臂，凝神以对，竟将$N" HIC "之力卸去。\n" NOR;
			message_vision(msg, me, target);
        }
		
	if ((int)me->query_skill("taixuan-gong", 1) > 2000)
	{
        // 第二招，判断对方悟性
        message_vision(HIG "\n$N" HIW "肌肤如欲胀裂，内息不由自主的依着‘赵客缦胡缨’那套经脉运"
                     "行图谱转动，\n同时手舞足蹈，似是大欢喜，又似大苦恼。\n" NOR, me);
	    me->add("neili", -1000);
		me->add("jingli", -1000);
        if (random(ap*me->query("int",1)) > dp*target->query("int",1)/3)
        {
            damage1 = me->query_skill("taixuan-gong", 1)*me->query("int") + me->query("xyzx_sys/level") + me->query_skill("unarmed") + me->query_skill("force");
			damage = damage1 + random(damage1);
            msg =HIY "$n" HIY "冷笑一声，觉得$N" HIY "此招肤浅之极，于"
                                          "是随意招架，\n猛然间，「噗嗤」！一声，" + "一拳" +
                                          HIY "已穿透$n" HIY "的胸膛，鲜血不断涌出。\n" NOR;
			message_vision(msg, me, target);			
            target->receive_damage("qi",damage,me);
		    target->receive_wound("qi",damage/2,me);
            target->add("neili", -damage);
			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"，杀内力"+ damage +"。\n" NOR);
        } else
        {
            msg = HIC "$n" HIC "会心一笑，看出$N" HIC "这招中的破绽，随意施招竟将这招化去。\n" NOR;
			message_vision(msg, me, target);
        }
	}

	if ((int)me->query_skill("taixuan-gong", 1) > 3000)
	{
        // 第三招，判断对方根骨
        message_vision(HIB "\n‘赵客缦胡缨’既毕，接下去便是‘吴钩霜雪明’，$N" HIW "更"
                    "不思索，\n石壁上的图谱一幅幅在脑海中自然涌出，自‘银鞍照白马’直到‘谁能书阁下’，\n"
                    "一气呵成的使了出来。\n" NOR, me);
	    me->add("neili", -2000);
		me->add("jingli", -2000);
        if (random(ap*me->query("con",1)) > dp*target->query("con",1)/3)
        {
            damage1 = me->query_skill("taixuan-gong", 1)*me->query("con") + me->query("xyzx_sys/level") + me->query_skill("unarmed") + me->query_skill("force");
			damage = damage1 + random(damage1);
            msg =HIY "$n" HIY "心中一惊，但见$N" HIY "这几招奇异无比，招式变化莫测，"
                "但威力却依然不减，\n正犹豫间，$n" HIY "却已中招，顿感精力不济，浑"
                "身无力。\n" NOR;
			message_vision(msg, me, target);			
            target->receive_damage("qi",damage,me);
		    target->receive_wound("qi",damage/2,me);
            target->add("neili", -damage);
			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"，杀内力"+ damage +"。\n" NOR);

        } else
        {
            msg = HIC "$n" HIC "默运内功，内劲贯于全身，奋力抵挡住$N" HIC "这招。\n" NOR;
			message_vision(msg, me, target);
        }
	}
	
	if ((int)me->query_skill("taixuan-gong", 1) > 4000)
	{
        // 第四招，判断对方身法		
        message_vision(HIR "\n待得‘谁能书阁下’这套功夫演完，$N" HIW "只觉气息逆转"
                     "，‘不惭世上英’倒使上去。\n" NOR, me);
	    me->add("neili", -2000);
		me->add("jingli", -2000);
        if (random(ap*me->query("dex",1)) > dp*target->query("dex",1)/3)
        {
            damage1 = me->query_skill("taixuan-gong", 1)*me->query("dex") + me->query("xyzx_sys/level") + me->query_skill("unarmed") + me->query_skill("force");
			damage = damage1 + random(damage1);
            msg =HIY "$N" HIY +  "拳法奇妙无比，招式时而宛若游龙，时而"
                "宛若惊鸿，霎那间$n" HIY "已遍体鳞伤。\n$N" HIY "猛然将" + "拳风" + HIY "一"
                "转，招式陡然加快，将$n" HIY "团团围住，竟无一丝空隙！\n" NOR;
			message_vision(msg, me, target);			
            target->receive_damage("qi",damage,me);
		    target->receive_wound("qi",damage/2,me);
            target->add("neili", -damage);
			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"，杀内力"+ damage +"。\n" NOR);
        } else
        {
            msg = HIC "$n" HIC "见这招来势凶猛，身形疾退，瞬间飘出三"
                      "丈，方才躲过$N" HIC "这招。\n" NOR;
			message_vision(msg, me, target);
        }
	}        		
//		target->apply_condition("no_perform", 10);
	    me->add("neili", -1000);
		me->add("jingli", -1000);
		me->start_busy(1);
        return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}