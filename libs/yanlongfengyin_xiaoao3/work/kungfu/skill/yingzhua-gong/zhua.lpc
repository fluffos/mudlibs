// zhai.c 老鹰抓小鸡

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;

int perform(object me, object target)
{
	object  weapon2;
	int skill,damage;
	int ap,dp,comb1,comb2;
	int skill1,skill2,neili1,neili2,str1,str2;

	if (!target ) target = offensive_target(me);
	if (!target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("「老鹰抓小鸡」只能对战斗中的对手使用。\n");
	if (objectp(me->query_temp("weapon")))
		return notify_fail("你必须空手。\n");
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");
	if( me->query_skill("yingzhua-gong",1) < 300)
		return notify_fail("你的鹰抓功等级不够, 不能使用「老鹰抓小鸡」！\n");
    if((int)me->query_skill("hunyuan-yiqi",1) < 300 && (int)me->query_skill("yijing-force",1) < 300 && (int)me->query_skill("yijinjing",1) < 300 && (int)me->query_skill("damo-force",1) < 300)
        return  notify_fail("你佛门内功修为不够，不能使用这一绝技!\n");
  	if (me->query_skill_mapped("force") != "yijinjing" && me->query_skill_mapped("force") != "hunyuan-yiqi" && me->query_skill_mapped("force") != "yijing-force" && me->query_skill_mapped("force") != "damo-force") 
		return notify_fail("你未使用佛门内功, 不能使用这一绝技 !\n"); 
	if (me->query_skill_mapped("unarmed") != "yingzhua-gong")
		return notify_fail("你没正确激发该技能 。\n");
	if( (int)me->query("jingli") < 1000 )
		return notify_fail("你的精力不够。\n");	
	if( me->query("neili") < 1000 )
		return notify_fail("你的内力不够，无法使用「老鹰抓小鸡」！\n");
	if( target && !living(target))
		return notify_fail("对方都已经这样了，还抓什么，去捡好了！\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

	message_vision(CYN"\n$N鹰眼炯炯有神，瞅准$n招式破绽之处，抓向$n。\n\n"NOR,me,target);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1
	ap = me->query("xyzx_sys/level") + me->query_skill("adai-quanfa", 1) + me->query_skill("unarmed") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	skill = me->query_skill("yingzhua-gong",1);			
	skill1 = me->query_skill("yingzhua-gong",1);
	skill2 = target->query_skill("parry",1);
	neili1 = me->query("neili");
	neili2 = target->query("neili");
	str1 = me->query_str(1);
	str2 = target->query_str(1);


	if (random(ap) > dp/3)
	{		
		comb1 = str1*(neili1/10000+skill1);
		comb2 = str2*(neili2/10000+skill2);
		damage = skill+skill2 + random(skill2+skill);
		target->receive_damage("qi",damage,me);
		target->receive_wound("qi",damage,me);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage +"。\n" NOR);
		me->add("neili",-300);
		me->add("jingli",-300);
		if (objectp(weapon2 = target->query_temp("weapon")))
		{
			message_vision(HIR"$n眼睛一花，手中"+weapon2->query("name")+HIR"已被$N反手抓到。\n\n"NOR,me,target);
			if (comb1 > comb2 * 3/5 )
			{
				message_vision(HIW"$n只觉一股刚猛内劲自"+weapon2->query("name")+HIW"传了过来，手臂受到巨震，手中"+weapon2->query("name")+HIW"脱手而出！\n"NOR,me,target);
				weapon2->unequip();
				weapon2->move(environment(target));
				target->reset_action();
			} else
			{
				message_vision(HIW"$N默念“南无阿弥陀佛”，催动佛门真气注入"+weapon2->query("name")+HIW"，$n见状赶紧催动体内真气与其相抗。\n\n"NOR,me,target);
				message_vision(HIG"$N只觉$n手中的"+weapon2->query("name")+HIG"传来一阵柔和的气劲，将自己的佛音消弭于无形，只好放手，飘身退开。\n"NOR,me,target);
			}
		}
	} else
	{
		message_vision("谁知$n露出此破绽乃是诱敌，一个变招反而向$N猛攻而至。\n",me,target);
		me->add("neili",-100);
		COMBAT_D->do_attack(target,me,me->query_temp("weapon"));		
	}
	
	me->start_busy(1);	
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}