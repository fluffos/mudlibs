int valid_learn(object me) {
  object ob;
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力不够，没有办法练飞天御剑流。\n");
  if ((int)me->query_skill("shayi-xinfa", 1) < 100)
    return notify_fail("你的杀意心法火候不够。\n");
  if (me->query("family/family_name") != "飞天御剑流")
    return notify_fail("你不加入飞天门，无法学习本门技能。\n");
  if ((int)me->query_skill("feitian-yujianliu", 1) > (int)me->query_skill("huoxinliu-jianfa", 1))
    return notify_fail("你的神谷活心流火候不够，无法学。\n");

  if ((string)me->query_skill_mapped("force") != "shayi-xinfa")
    return notify_fail("飞天御剑流必须配合杀意心法才能练。\n");
  if (!(ob = me->query_temp("weapon")) || (string)ob->query("skill_type") != "blade")
    return notify_fail("你必须先找一把刀才能练飞天御剑流。\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (random(100) == 1) me->add("score", -5);
  return 1;
}

int valid_enable(string usage) { return usage == "blade" || usage == "parry"; }

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  int level;
  level = (int)me->query_skill("feitian-yujianliu", 1);

  if (random(20) == 1 && random(level) > 200 && me->query("jiali") > 100) {
    return ([
      "action": HIR "「 龙翔闪! 」" + HIM "$N一手按刀身,由下而上直抽，奇快无比，无与伦比，出刀还刀，只一瞬间之事" NOR,
      "attack": 500,
      "parry": 500,
      "dodge": 500,
      "damage": 500,
      "force": 500,
      "skill_name": "龙翔闪",
      "damage_type": "刺伤" ]);
  }
  if (random(20) == 2 && random(level) > 250 && me->query("jiali") > 100) {
    return ([
      "action": CYN "「 龙锤闪! 」" + HIY "$N手中$w" + HIY "微微颤动，刀光若有若无，刀法古朴飘逸，兼而有之" NOR,
      "attack": 500,
      "parry": 500,
      "dodge": 500,
      "damage": 500,
      "force": 500,
      "skill_name": "龙锤闪",
      "damage_type": random(2) ? "刺伤" : "劈伤" ]);
  }
  if (random(20) == 3 && random(level) > 300 && me->query("jiali") > 100) {
    return ([
      "action": HIB "「 双龙闪! 」" + HIY "$N的$w" + HIY "弥补拔刀后空隙,刀和刀鞘同时攻向$n的全身。" NOR,
      "attack": 500,
      "parry": 500,
      "dodge": 500,
      "damage": 500,
      "force": 500,
      "skill_name": "双龙闪",
      "damage_type": random(2) ? "刺伤" : "劈伤" ]);
  }

  if (random(20) == 4 && random(level) > 350 && me->query("jiali") > 100) {
    return ([

      "action": HIM "「 土龙闪! 」" + HIY "$N的$w" + HIY "向地面猛烈斩击,打碎地面石块,溅向$n的要害！ " NOR,
      "attack": 500,
      "parry": 500,
      "dodge": 500,
      "damage": 500,
      "force": 500,
      "skill_name": "土龙闪",
      "damage_type": random(2) ? "刺伤" : "劈伤" ]);
  }

  if (random(20) == 5 && random(level) > 400 && me->query("jiali") > 100) {
    return ([
      "action": HIG "「 龙巢闪! 」" + HIY "$N突然高高跃起$w" + HIY "从天而至!! $n被吓的讲不出话来了。 " NOR,
      "attack": 500,
      "parry": 500,
      "dodge": 500,
      "damage": 500,
      "force": 500,
      "skill_name": "龙巢闪",
      "damage_type": random(2) ? "刺伤" : "劈伤" ]);
  }
  if (random(20) == 6 && random(level) > 450 && me->query("jiali") > 100) {
    return ([
      "action": HIC "「 龙卷闪! 」" + HIY "$N利用旋转的离心力，极速的挥动$w" + HIY "无数的劲气向$n卷了过去。 " NOR,
      "attack": 500,
      "parry": 500,
      "dodge": 500,
      "damage": 500,
      "force": 500,
      "skill_name": "龙卷闪",
      "damage_type": random(2) ? "刺伤" : "劈伤" ]);
  }
  if (random(20) == 7 && random(level) > 500 && me->query("jiali") > 100) {
    return ([
      "action": HIW "「 飞翔龙闪! 」" + HIY "$N突然消失了！随后$w的反光出现在了$n的头上。" + HIY "$N尽然在办空使出了拔刀术。 " NOR,
      "attack": 500,
      "parry": 500,
      "dodge": 500,
      "damage": 500,
      "force": 500,
      "skill_name": "飞翔龙闪",
      "damage_type": random(2) ? "刺伤" : "劈伤" ]);
  }
  if (random(20) == 8 && random(level) > 550 && me->query("jiali") > 100) {
    return ([
      "action": HIC "「 龙椎闪! 」" + HIW "$N利用脚和腰的弹力飞身跃起,利用日光或者月光掩护向$n大力劈下 。 " NOR,
      "attack": 500,
      "parry": 500,
      "dodge": 500,
      "damage": 500,
      "force": 500,
      "skill_name": "龙椎闪",
      "damage_type": random(2) ? "刺伤" : "劈伤" ]);
  }

  if (random(20) == 9 && random(level) > 600 && me->query("jiali") > 100) {
    return ([
      "action": HIG "「 飞龙闪! 」" + HIW "$N假装高速拔刀,实则利用腕力推出刀身,使刀高速飞向$n 。 " NOR,
      "attack": 500,
      "parry": 500,
      "dodge": 500,
      "damage": 500,
      "force": 500,
      "skill_name": "飞龙闪",
      "damage_type": random(2) ? "刺伤" : "劈伤" ]);
  }

  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点

}


int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
  if ((int)me->query_skill("shayi-xinfa", 1) < 100)
    return notify_fail("你的杀意心法火候不够。\n");
  if (me->query("family/family_name") != "飞天御剑流")
    return notify_fail("你不加入飞天门，无法练习本门技能。\n");
  if (me->query_skill("blade", 1) <= me->query_skill("feitian-yujianliu", 1))
    return notify_fail("你的基础不够，无法领会更高深的技巧。\n");

  if ((string)me->query_skill_mapped("force") != "shayi-xinfa")
    return notify_fail("飞天御剑流必须配合杀意心法才能练。\n");
  if ((int)me->query("qi") < 100
    || (int)me->query("neili") < 100)
    return notify_fail("你的内力或气不够，没有办法练习飞天御剑流。\n");
  me->receive_damage("qi", 50);
  me->add("neili", -50);
  //write("你按著所学练了一遍飞天御剑流。\n");
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "feitian-yujianliu/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb) {
  int ap, dp;
  object weapon;
  int flvl, damage2;
  string msg;

  weapon = me->query_temp("weapon");
  ap = (int)me->query_skill("feitian-yujianliu", 1);
  dp = (int)victim->query_skill("dodge", 1);
  flvl = me->query("qi") / 10;
  damage2 = (int)me->query_skill("feitian-yujianliu", 1);

  if (damage_bonus < 100) return 0;
  if (me->query_skill("shayi-xinfa", 1) < 100) return 0;
  if (me->query("neili") < 100 || me->query_skill_mapped("force") != "shayi-xinfa") return 0;
  if (damage2 < 10) damage2 = 10;

  if (random(ap) > dp / 10 && random(6) == 1 && me->query("jiali") > 0) {
    msg = HIR "「 瞬天杀! 」" + HIM "$N使出超神速的缩地加天剑拔刀术，在$n未感痛楚前想置其死地!\n" NOR;
    if (random(5) == 0) msg = HIC "「背车刀!」" + HIY "$N将右手的刀于背后交给左手,利用假动作，在预料不到的地方出刀 。\n" NOR;
    if (random(5) == 1) msg = HIM "「秘剑.炎灵!」" + HIY "$N以无限刃点火,向对手同时发出斩击和火烧！ \n" NOR;
    if (random(5) == 2) msg = HIC "「回天剑舞六连!」" + HIW "$N反握小太刀,运用流水招式刺出,左右再变两招,瞬间出六招。 \n" NOR;
    if (random(5) == 3) msg = HIG "「阴阳双飞!」" + HIW "$N双刀纵横十字 两把小太刀十字交叉做剪刀架势的攻击$n 。\n" NOR;
    if (random(5) == 4) msg = HIW "「二阶堂平法!」" + HIY "$N由[一,八,十]这三字组成[平]字将剑气射出,麻痹心肺$n,并让$n无法动弹。 \n" NOR;

    if (victim->query("qi") > flvl) {
      me->add("neili", -100);
      //			if (!victim->is_busy()) victim->start_busy(1+random(3));
      victim->receive_damage("qi", damage2 + damage_bonus / 2, me);
      victim->receive_wound("qi", damage2 + damage_bonus / 2, me);
    }
    return msg;
  }

  if (random(ap) > dp / 10 && random(6) == 2 && me->query("jiali") > 0) {
    victim->receive_wound("qi", damage2 + damage_bonus / 2, me);
    me->add("neili", -100);
    return RED "只见$n$l上鲜血狂奔，已被" + weapon->name() + HIR "斩出的无形气劲切了开来!\n" NOR;
  }

}


//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡bug有关     
int ob_hit(object ob, object me, int damage) {
  object weapon = me->query_temp("weapon");
  string msg, *limbs;
  int ap, dp, j;

  limbs = ob->query("limbs");
  ap = me->query_skill("feitian-yujianliu", 1);
  dp = ob->query_skill("unarmed", 1);

  if (damage < 10) damage = 10;
  if (random(ap) > dp / 10
    && me->query_skill_mapped("blade") == "feitian-yujianliu"
    && weapon
    && weapon->query("skill_type") == "blade"
    && me->query_skill("blade") > 300
    && random(me->query_skill("blade", 1)) > 150
    && !me->is_busy()
    && me->query("neili") > 200
    && me->query("max_neili") > 900
    && random(me->query_int(1)) >= 20) {
    me->add("neili", -100);
    msg = HIM "$N面对$n的攻势。手上的刀轻轻一移，一道阳光真射在刀背上，$n被这道闪光刺的睁不开眼！。\n" NOR;
    //		if (!ob->is_busy()) ob->start_busy(3);
    j = -(damage + random(damage));
    message_vision(msg, me, ob);
    return j;
  }
}
