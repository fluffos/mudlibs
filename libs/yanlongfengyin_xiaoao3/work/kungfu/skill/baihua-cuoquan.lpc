int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }
int valid_combine(string combo) { return combo == "benlei-shou"; }

int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练百花错拳必须空手。\n");
  if (me->query("family/family_name") != "红花会")
    return notify_fail("你不是本门中人，无法学习本门技能。\n");
  if ((int)me->query_skill("honghua-shengong", 1) < 100)
    return notify_fail("你的红花神功火候不够，无法学百花拳。\n");
  if ((int)me->query("max_neili") < 1000)
    return notify_fail("你的内力太弱，无法练百花错拳。\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (random(100) == 1) me->add("score", -5);
  return 1;
}

int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query("family/family_name") != "红花会")
    return notify_fail("你不是本门中人，如何学到本门高深技能，我要告诉掌门去。\n");
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练百花错拳必须空手。\n");
  if ((int)me->query_skill("honghua-shengong", 1) < 100)
    return notify_fail("你的红花神功火候不够，无法练百花拳。\n");
  if ((int)me->query("qi") < 50)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 50)
    return notify_fail("你的内力不够练百花拳。\n");
  me->receive_damage("qi", 35);
  me->add("neili", -20);
  return 1;
}
string query_skill_name(int level) {
  int i;
  for (i = sizeof(action); i > 0; i--)
    if (level >= action[i - 1]["lvl"])
      return action[i - 1]["skill_name"];
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}

string perform_action_file(string action) {
  return __DIR__ "baihua-cuoquan/" + action;
}
mixed hit_ob(object me, object victim, int damage_bonus)

{
  int ap, dp, damage2;
  ap = (int)me->query_skill("baihua-cuoquan", 1);
  damage2 = (int)me->query_skill("baihua-cuoquan", 1);
  dp = victim->query_skill("unarmed", 1);
  if (damage_bonus < 100) return 0;
  if (me->query_skill("honghua-shengong", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "honghua-shengong") return 0;
  if (damage2 < 10) damage2 = 10;

  if (random(6) == 2 && random(ap) > dp / 10 && me->query_skill_mapped("force") == "honghua-shengong" && me->query("jiali") > 0) {
    victim->receive_wound("qi", damage2 + damage_bonus / 2, me);
    me->add("neili", -100);
    return HIY "「百花错拳!!」！$N稳扎马步，吐气开声 双拳锤向$n几处大穴!! $n吐出一口鲜血!!!\n" NOR;
  }

}
//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡bug有关
int ob_hit(object ob, object me, int damage) {

  string msg;
  int level, j, ap, dp;

  level = me->query_skill("baihua-cuoquan", 1);
  ap = me->query_skill("baihua-cuoquan", 1);
  dp = ob->query_skill("parry", 1);
  if (damage < 10) damage = 10;

  if (random(6) == 3 && random(level) > 150 && random(ap) > dp / 10 && me->query_skill_mapped("force") == "honghua-shengong" && me->query("neili") > 200) {
    msg = YEL "$N面对$n的攻势 施出「月移花影」，身形一闪，双手同时攻向$n。\n" NOR;
    msg += YEL "$n感到双眼一花，尽然不能动了!!。\n" NOR;
    if (!ob->is_busy()) ob->start_busy(3);
    me->add("neili", -100);
    j = -(damage + random(damage));
    msg += HIB "\n结果$N躲过了$n的一小半力道！\n" NOR;
    message_vision(msg, me, ob);
    return j;
  }

}
