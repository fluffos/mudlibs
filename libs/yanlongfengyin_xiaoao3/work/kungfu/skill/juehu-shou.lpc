int valid_enable(string usage) { return usage == "parry" || usage == "unarmed"; }


int valid_learn(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练三阴绝户手必须空手。\n");
  if ((int)me->query_skill("yinyun-ziqi", 1) < 300)
    return notify_fail("你的氤氲紫气火候不够，无法学三阴绝户手。\n");
  if (me->query("family/family_name") != "武当派")
    return notify_fail("你不是武当弟子，不能传授这种阴毒技能。\n");
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力太弱，无法练三阴绝户手。\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (random(100) == 1) me->add("score", -5);
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("jing") < 30)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 20)
    return notify_fail("你的内力不够练三阴绝户手。\n");
  if (me->query("family/family_name") != "武当派")
    return notify_fail("你不是武当弟子，不能练习这门阴毒技能。\n");
  me->receive_damage("jing", 25);
  me->add("shen", -10);
  me->add("neili", -10);
  return 1;
}
string perform_action_file(string action) {
  return __DIR__ "juehu-shou/" + action;
}
mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  int lv, ap, dp, damage2;
  lv = (int)me->query_skill("juehu-shou", 1);
  ap = me->query("xyzx_sys/level") + me->query_skill("juehu-shou", 1);
  dp = victim->query("xyzx_sys/level") + victim->query_skill("unarmed", 1);

  damage2 = (int)me->query_skill("juehu-shou", 1);

  if (damage_bonus < 100) return 0;
  if (me->query_skill(
    "taiji-shengong",
    1
  ) < 100 && me->query_skill("yinyun-ziqi", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || (me->query_skill_mapped("force") != "taiji-shengong" && me->query_skill_mapped("force") != "yinyun-ziqi")) return 0;
  if (damage2 < 10) damage2 = 10;
  if (me->query_skill_mapped("force") == "yinyun-ziqi") damage2 = damage2 + random(damage2) + me->query_skill(
    "yinyun-ziqi",
    1
  );
  if (random(lv) > 200
    && random(6) == 1
    && me->query("jiali") > 0
    && random(ap) > dp / 10
    && (me->query_skill_mapped("force") == "taiji-shengong" || me->query_skill_mapped("force") == "yinyun-ziqi")) {
    if (victim->query("gender") == "男性") {
      victim->receive_wound("qi", damage2 * 2 + damage_bonus / 2, me);
      me->add("neili", -100);
      message_vision(HIR "$N咬破舌尖，运起全身功力向$n下身抓去。。。\n" NOR, me, victim);
      if (me->query_skill_mapped("force") == "yinyun-ziqi" && random(3) == 2) {
        victim->set("gender", "无性");
        victim->set("genderbak", "男性");
        message_vision(HIW "$n突然觉的下体一凉，疼的大叫起来。。。随后大哭起来。。。没了！没了！!\n" NOR, me, victim);
        if (!victim->is_killing(me)) victim->kill_ob(me);
      }
    } else {
      victim->receive_wound("qi", damage2 + damage_bonus / 2, me);
      me->add("neili", -100);
      message_vision(HIW "$n被你一击命中，，不禁既羞又怒，$N竟对一女流之辈也用此下流招数！\n" NOR, me, victim);
    }
  }

}
