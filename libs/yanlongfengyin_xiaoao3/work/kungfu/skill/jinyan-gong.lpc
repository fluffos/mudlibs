
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SKILL;

string *dodge_msg = ({
        "$n身形晃动，使出一招"HIM" 出有入无 "NOR"，似左实右，忽前忽后，若有若无的闪过$N的攻击。\n",
        "$n突然身子一缩，一招"HIB"藏形匿迹"NOR"，人已在三尺之外。\n",
        "可是$n一招"HIR" 飞灵八方 "NOR"猛然纵起丈余，身形晃动，躲过了$N的攻势。\n",
        "只见$n左走三步，又向右斜跨两步，一招"HIW" 隐景舞天 "NOR"，不知怎的$n已经到了$N的身后。\n",
        "$n不住倒退，忽然身形晃动，一招"RED" 解行遁变 "NOR"转到了$N的身侧。\n",
        "$n身随意走，一招"YEL" 弃厄飞霄 "NOR"躲过了$N的凌厉攻势。\n",
        "$n脚下一点，一招"HIY" 回神转玄 "NOR"斜斜的飞出恰巧躲开了$N的进攻。\n",
        "$n一招"MAG" 乘虚御空 "NOR"侧身一让，$N这招扑了个空。\n",
});

int valid_enable(string usage) { return (usage == "dodge") ;}

int valid_learn(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if( (int)me->query("max_neili") < 10000 )
		return notify_fail("你的内力不够，没有办法练七星换位。\n");
	    if (me->query("family/family_name")!="全真教")
   return notify_fail("你不是全真教弟子，无法传授本教技能。\n");	
    if ((int)me->query_skill("tiangang-zhengqi", 1) < 100 && (int)me->query_skill("xiantian-qigong", 1) < 100)
    return notify_fail("你的本门内功火候不够，无法学习。\n");

	return 1;
}

string query_dodge_msg(string limb)
{
        return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
        if( (int)me->query("qi") < 40 )
                return notify_fail("你的体力太差了，不能练金雁功。\n");
	    if (me->query("family/family_name")!="全真教")
   return notify_fail("你不是全真教弟子，无法练习本教技能。\n");			
        me->receive_damage("qi", 30);
        return 1;
}
string perform_action_file(string action)
{
        return __DIR__"jinyan-gong/" + action;
}

	//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{

        int j,ap,dp;
		ap = me->query_skill("jinyan-gong", 1) * me->query("dex",1);
		dp = ob->query_skill("dodge", 1) * ob->query("int",1);

		if (damage <10)  damage=10;      	
		if( me->query_skill("jinyan-gong", 1) > 200
		&& (me->query_skill_mapped("force") == "xiantian-qigong" ||  me->query_skill_mapped("force") == "tiangang-zhengqi")
        && me->query("neili") > 1000
		&& random(5)==0	&& random(ap) > dp/10)
        { 
			message_vision( HIC"$N腾空而起，缩地成寸，一步踏出数丈远！$n顿时觉得$N愈来愈远，一会功夫就看不见踪影！\n"NOR, me, ob);
	//		if (!ob->is_busy()) ob->start_busy(1);		
			me->add("neili", -100 );
			j = -(damage+random(damage));             
			return j;
        }          
}

