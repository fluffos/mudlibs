int valid_enable(string usage) {
  return usage == "blade" || usage == "parry";
}
int practice_level() {
  return 100;
}

int valid_learn(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_skill("beiming-shengong", 1) < 100)
    return notify_fail("你的逍遥派内功火候太浅。\n");
  if (me->query("family/family_name") != "逍遥派")
    return notify_fail("你不是逍遥派弟子，无法学习。\n");
  if (me->query_skill("blade", 1) <= me->query_skill("ruyi-dao", 1))
    return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
  return 1;
}

int practice_skill(object me) {
  object weapon;
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
    if (!objectp(weapon = me->query_temp("secondary_weapon"))
      || (string)weapon->query("skill_type") != "blade")
      return notify_fail("你使用的武器不对。\n");
  if (me->query("family/family_name") != "逍遥派")
    return notify_fail("你不是逍遥派弟子，无法练习。\n");
  if ((int)me->query("qi") < 50)
    return notify_fail("你的体力不够练如意刀法。\n");
  me->receive_damage("qi", 25);
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}

string perform_action_file(string action) {
  return __DIR__ "ruyi-dao/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  int ap, dp, skill;
  string msg;
  object weapon;
  int lvl, level, damage2;

  lvl = me->query_skill("ruyi-dao", 1);
  level = (int)me->query_skill("beiming-shengong", 1);
  weapon = me->query_temp("weapon");
  damage2 = me->query_skill("ruyi-dao", 1) + me->query_skill("beiming-shengong", 1);
  skill = me->query_skill("ruyi-dao", 1);
  ap = me->query("xyzx_sys/level") + me->query_skill("ruyi-dao", 1);
  dp = victim->query("xyzx_sys/level") + victim->query_skill("dodge", 1);

  if (damage_bonus < 100) return 0;
  if (me->query_skill("beiming-shengong", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "beiming-shengong") return 0;
  if (damage2 < 10) damage2 = 10;

  if (random(ap) > dp / 10 && skill > 200 && me->query("jiali") > 0 && random(6) == 1) {
    if (random(skill) > 250) {
      msg = HIW "\n$N身形飘忽不定，左手握了一个刀决，身子滴溜溜地一转，已经欺到$n身前，唰地一刀。\n" NOR;
      victim->receive_damage("qi", damage2 * 2 + damage_bonus / 2, me);
      victim->receive_wound("qi", damage2 + damage_bonus / 2, me);
      me->add("neili", -100);
      //		if( !victim->is_busy() ) victim->start_busy(1);			
    } else if (random(skill) > 500) {
      msg = HIG "\n$N身形飘起，长啸一声，跨步后退，猛然倒转一刀劈向$n。\n" NOR;
      victim->receive_damage("qi", damage2 + damage_bonus / 2, me);
      victim->receive_wound("qi", damage2 * 2 + damage_bonus / 2, me);
      me->add("neili", -100);
      //		if( !victim->is_busy() ) victim->start_busy(1);			
    } else if (random(skill) > 750) {
      msg = HIM "\n$N左一刀，右一刀，刀刀不离$n的要害，突然中宫直进，直取$n的胸膛。\n" NOR;
      victim->receive_damage("qi", damage2 * 2 + damage_bonus / 2, me);
      victim->receive_wound("qi", damage2 * 2 + damage_bonus / 2, me);
      me->add("neili", -100);
      //		if( !victim->is_busy() ) victim->start_busy(1);			
    } else {
      msg = HIY "\n但见刀光一闪，刀尖已到$n身前，$n不由地手足无措。\n" NOR;
      victim->receive_damage("qi", damage2 + damage_bonus / 2, me);
      victim->receive_wound("qi", damage2 + damage_bonus / 2, me);
      me->add("neili", -100);
      //		if( !victim->is_busy() ) victim->start_busy(1);			
    }
    return msg;
  }
}
