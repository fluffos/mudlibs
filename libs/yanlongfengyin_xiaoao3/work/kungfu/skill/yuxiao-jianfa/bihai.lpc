#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>
inherit F_SSERVER;

int perform(object me, object target)
{
	string msg;
	object weapon;
	int skill, ap, dp,damage;

	if (!target ) target = offensive_target(me);
	if (!target || !target->is_character() || !me->is_fighting(target) )	
		return notify_fail("「碧海生潮曲」只能对战斗中的对手使用。\n");
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对。\n");
	if( !present("yuxiao", me)) 
		return notify_fail("你身上没有玉箫。\n");
//	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("id") != "xiao")
//		return notify_fail("你必须要使用吹奏类武器。\n");
//	if (target && target->query_temp("apply/shade_vision")) 
//		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	
	if( me->query_skill("bibo-shengong",1) < 300)
		return notify_fail("你的碧波神功等级不够, 不能使用「碧海生潮曲」！\n");
	if( me->query_skill_mapped("force") != "bibo-shengong")
		return notify_fail("不使用本门内功，如何能使用本门绝技！\n");
	if (me->query_skill_mapped("sword") != "yuxiao-jianfa")
		return notify_fail("你没正确激发该技能 。\n");	
	if( me->is_busy() )
		return notify_fail("你现在正忙着呢，哪有空运功？\n");
	if( me->query_skill("yuxiao-jianfa",1) < 300)
		return notify_fail("你的玉箫剑法等级不够, 不能使用「碧海生潮曲」！\n");
	if ((int)me->query("max_neili") < 100000)								
		return notify_fail("你的内力修为不够。\n");
	if ((int)me->query("max_jingli") < 100000)								
		return notify_fail("你的精力修为不够。\n");
	if( (int)me->query("jingli") < 1000 )
		return notify_fail("你的精力不够。\n");	
	if( me->query("neili") < 1000 )
		return notify_fail("你的内力不够，无法运用「碧海生潮曲」！\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

	skill = me->query_skill("yuxiao-jianfa",1);		
	msg = HIC "$N脚下踏着八卦方位缓缓的奏出碧海生潮曲。"+weapon->name() +"那萧声一时间如惊涛拍岸，一时间如细浪轻抚海滩。\n";
	message_vision(msg, me, target);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1
	ap = me->query("xyzx_sys/level") + me->query_skill("yuxiao-jianfa", 1) + me->query_skill("sword") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	if( random(ap) > dp/3 )
	{
		if(userp(me)) me->add("neili",-300);
		me->add("jingli",-200);
		msg = "$n不知不觉间随着萧声起舞，完全失去抵抗之力。\n" NOR;
		message_vision(msg, me, target);
		damage = me->query_skill("yuxiao-jianfa", 1)*3 + me->query_skill("bibo-shengong", 1)*2+(int)me->query_skill("sword",1);
		damage = damage + random(damage);
		target->receive_damage("jing", damage,me);
		target->receive_wound("jing", damage/2,me);
//		target->apply_condition("no_force", 20);
		if (me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	}
	else
	{
		if(userp(me)) me->add("neili",-100);
		msg = "强运内功勉强克制，几经艰难控制住心神。\n"NOR;
		message_vision(msg, me, target);
	}

	msg = HIC "$N一声清啸，剑发琴音，深吸一口气，剑附内力，一式「天外清音」，"+weapon->name()+"闪动不止，剑影如夜幕般扑向$n。\n"NOR;
	message_vision(msg, me, target);
	if (random(ap) > dp/3 )
	{
		damage = me->query_skill("yuxiao-jianfa", 1)*3 + me->query_skill("bibo-shengong", 1)*2+(int)me->query_skill("sword",1);
		damage = damage + random(damage);
		target->receive_damage("qi", damage,me);
		target->receive_wound("qi", damage,me);
		me->add("neili", -500);
		me->add("jingli",-500);
		msg = "$n顿时觉得眼前金光乱闪动，双耳嗡嗡内鸣，不知那里一阵刺痛如针扎一般！\n" NOR;
		message_vision(msg, me, target);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage +"。\n" NOR);
	}
	else
	{
		msg = "可是$n宁心静气，随手挥洒，将$N的招数撇在一边。\n"NOR;
		message_vision(msg, me, target);
		me->add("neili", -100);
	}
	
	if(!target->is_fighting(me)) target->fight_ob(me);
	me->start_busy(1);
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}