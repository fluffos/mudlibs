//cibei.c  我佛慈悲
// by godzilla 99.03.06

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target)
{
	object weapon,weapon2;
	int damage;
	int ap,dp;
	string msg;

	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("「我佛慈悲」只能在战斗中使用。\n");
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "blade")
		return notify_fail("「我佛慈悲」必须用刀才能施展。\n");
	if( (int)me->query_skill("cibei-dao", 1) < 300 )
		return notify_fail("你的「慈悲刀」不够娴熟，不会使用「我佛慈悲」。\n");
    if((int)me->query_skill("hunyuan-yiqi",1) < 300 && (int)me->query_skill("yijing-force",1) < 300 && (int)me->query_skill("yijinjing",1) < 300 && (int)me->query_skill("damo-force",1) < 300)
        return  notify_fail("你佛门内功修为不够，不能使用这一绝技!\n");
  	if (me->query_skill_mapped("force") != "yijinjing" && me->query_skill_mapped("force") != "hunyuan-yiqi" && me->query_skill_mapped("force") != "yijing-force" && me->query_skill_mapped("force") != "damo-force") 
		return notify_fail("你未使用佛门内功, 不能使用这一绝技 !\n");
	if ( me->query_skill_mapped("blade")!="cibei-dao" ) 
		return notify_fail("你未激发该技能吧！\n");	
	if( (int)me->query("shen") < 100000  )
		return notify_fail("施主，我佛慈悲。\n");	
	if( (int)me->query("max_neili") < 10000  )
		return notify_fail("你的内力修为不够。\n");	
	if( (int)me->query("neili") < 1000  )
		return notify_fail("你的内力不够。\n");
	if( (int)me->query("jingli") < 1000 )
		return notify_fail("你的精力不够。\n");	
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	msg = HIG "苦海无边，回头是岸。放下屠刀，立地成佛！\n"NOR;
	message_vision(msg, me, target);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1	
	me->add("neili", -200);
	ap = me->query("xyzx_sys/level") + me->query_skill("cibei-dao", 1) + me->query_skill("blade") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");	
	damage = me->query_skill("cibei-dao",1) + me->query_skill("blade",1);
	damage = damage + random(damage);
if( random(ap) > dp/3 )
{
		if (objectp(weapon2 = target->query_temp("weapon")))		
		{
		msg = WHT"$N将慈悲之刀竖立胸前，唱了一声：我佛慈悲！$n心中杀意大减，放弃了" + weapon2->name() + "！\n" NOR;
		message_vision(msg, me, target);
		weapon2->unequip();
		weapon2->move(environment(target));
		target->reset_action();			
		}

//	if (!target->is_busy()) target->start_busy(2+random(1));
	target->receive_damage("qi",damage*2,me);
	target->receive_wound("qi",damage/2,me);	
	message_vision(HIR"$n自觉罪孽深重，面对这一招没有还手，被砍了一道口子！\n" NOR, me, target);
	if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage*2 +"，内伤为"+ damage/2 +"。\n" NOR);
} else
{
	message_vision(HIR"$n杀心坚定不移，不为梵唱所动！\n" NOR, me, target);
	//if (!target->is_busy()) target->start_busy(1+random(1));
}
	me->start_busy(1);
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}