// snowwhip.c	寒雪鞭法	中乘武学200~600
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>
inherit SKILL;
mapping *action = ({
  ([ "name": "寒风起兮",
    "action": "$N使一招「寒风起兮」，手中$w抖得笔直向$n的$l连刺数鞭",
    "attack": 200,
    "parry": 200,
    "dodge": 200,
    "damage": 200,
    "force": 200,
    "damage_type": "刺伤"
  ]),
  ([ "name": "漫天飞雪",
    "action": "$N身形一转，一招「漫天飞雪」$w幻出满天鞭影，虚虚实实地袭向$n的$l",
    "attack": 300,
    "parry": 300,
    "dodge": 300,
    "damage": 300,
    "force": 300,
    "damage_type": "瘀伤"
  ]),
  ([ "name": "雪花翩翩",
    "action": "$N力贯$w，一招「雪花翩翩」点点鞭影飘浮不定地点向$n的$l",
    "attack": 300,
    "parry": 300,
    "dodge": 300,
    "damage": 300,
    "force": 300,
    "damage_type": "刺伤"
  ]),
  ([ "name": "积雪三尺",
    "action": "$N手中$w一抖，一招「积雪三尺」以一个怪异的角度往$n下盘卷去",
    "attack": 400,
    "parry": 400,
    "dodge": 400,
    "damage": 400,
    "force": 400,
    "damage_type": "瘀伤"
  ]),
  ([
    "name": "狂风骤雪",
    "action": "$N手中一紧，使招「狂风骤雪」，手里$w一鞭接著一鞭不停地抽向$n的$l",
    "attack": 500,
    "parry": 500,
    "dodge": 500,
    "damage": 500,
    "force": 500,
    "damage_type": "鞭伤"
  ]),
  ([ "name": "风雪交加",
    "action": "$N一招「风雪交加」手中$w舞出一片鞭影扫向$n全身",
    "attack": 600,
    "parry": 600,
    "dodge": 600,
    "damage": 600,
    "force": 600,
    "damage_type": "瘀伤"
  ]),
});
int valid_learn(object me) {
  object ob;
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("max_neili") < 1000)
    return notify_fail("你的内力不够，没有办法练寒雪鞭法, 多练些内力再来吧。\n");
  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "whip")
    return notify_fail("你必须先找一条鞭子才能练鞭法。\n");
  if (me->query("family/family_name") != "凌霄城")
    return notify_fail("你未加入凌霄城，学不了。\n");
  if ((int)me->query_skill("snow-whip", 1) < 100)
    return notify_fail("你的冰雪心法不够。\n");
  if (me->query_skill("whip", 1) <= me->query_skill("snowwhip", 1))
    return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (random(100) == 1) me->add("score", -5);
  return 1;
}
int valid_enable(string usage) {
  return usage == "whip" || usage == "parry";
}
mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}
int practice_skill(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("qi") < 30
    || (int)me->query("neili") < 5)
    return notify_fail("你的内力或气不够，没有办法练习寒雪鞭法。\n");
  if (me->query("family/family_name") != "凌霄城")
    return notify_fail("你未加入凌霄城，还敢练习城主独门技能！。\n");
  me->receive_damage("qi", 30);
  me->add("neili", -5);
  write("你按著所学练了一遍寒雪鞭法。\n");
  return 1;
}
int valid_effect(object me, object weapon, string name, int skill) {}


mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb) {
  int ap, dp, damage2;
  object weapon;
  weapon = me->query_temp("weapon");
  ap = (int)me->query_skill("snow-whip", 1);
  dp = victim->query_skill("dodge", 1);
  damage2 = (int)me->query_skill("snow-whip", 1);

  if (damage_bonus < 100) return 0;
  if (me->query_skill("bingxue-xinfa", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "bingxue-xinfa") return 0;
  if (damage2 < 10) damage2 = 10;

  if (random(8) == 3 && random(ap) > dp / 10 && me->query_skill_mapped("force") == "bingxue-xinfa") {
    me->add("neili", -50);
    victim->receive_wound("qi", damage2 + damage_bonus / 2, me);
    return HIR "只见$n$l上鲜血渗出，六点鞭痕布成六角，已被" + weapon->name() + HIR "整整齐齐的刺了六点。\n" NOR;
  }

  if (random(8) == 4 && random(ap) > dp / 10 && me->query_skill_mapped("force") == "bingxue-xinfa") {
    me->add("neili", -100);
    victim->apply_condition(
      "cold_poison",
      (me->query_skill("snow-whip")) / 300 + victim->query_condition("cold_poison")
    );
    return HIW "$n只觉得伤口一寒,一股寒气似冰箭一样的串进$n的全身。\n" NOR;
  }
}
