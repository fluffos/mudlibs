// 五毒神功
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>
inherit FORCE;

int valid_enable(string usage)
{
	return usage == "force";
}

int valid_learn(object me)
{
	mapping skl;
	string *sname;
	int i;
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");			
	if ( (int)me->query_skill("force", 1) < 100)
		return notify_fail("你的基本内功火候还不够，无法领会五毒神功。\n");
	if ( (int)me->query("con", 1) < 30)
		return notify_fail("你的体质太差，练这种毒功会反噬。\n");
	    if (me->query("family/family_name")!="五毒教")
   return notify_fail("你不是五毒教弟子，不能传授给你。\n");	
        skl = me->query_skills();
        sname = keys(skl);
        
	 for ( i=0;i<sizeof(skl);i++){
	    if(sname[i] == "wudu-shengong") continue;
		if (sname[i]=="xixing-dafa") continue;	
		if (sname[i]=="yijing-force") continue;			
            if( SKILL_D(sname[i])->valid_enable("force") )
             return notify_fail("你不先散了别派内功，怎能学五毒神功？！\n");
    }

	return 1;
}


int practice_skill(object me)
{
	return notify_fail("五毒神功只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func)
{
	return __DIR__"wudu-shengong/" + func;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
	int ap,dp,damage2;
	ap = me->query_skill("wudu-shengong",1);
	dp = victim->query_skill("forceg",1);
	damage2 = (int)me->query_skill("wudu-shengong",1);	
	
    if( damage_bonus < 100 ) return 0;
	if ( me->query_skill("wudu-shengong",1) < 100)	 return 0;
	if ( me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "wudu-shengong") return 0;	
	if (damage2<10) damage2=10;	

  if( random(ap) > dp/20
	&& me->query("jiali") > 0
	&& me->query_skill_mapped("force")=="wudu-shengong" 
	&& random(6) ==0 ) 
{
		victim->receive_wound("qi", damage2+damage_bonus/2,me );
		me->add("neili", -100);
		return HIB "$N发挥出"+HIR+"五毒神功"NOR HIB"的精髓，毒气摧毁了$n的真元！！！！\n" NOR;
	
  if ( victim->query("family/family_name")!= "五毒教" && me->query_skill("wudu-shengong",1)>100) 
  {
	 switch( random(5) ) 
	{
		case 0:
            victim->apply_condition("snake_poison", (me->query_skill("wudu-shengong"))/300 +
			victim->query_condition("snake_poison"));
			break;
		case 1:
            victim->apply_condition("zhizhu_poison", (me->query_skill("wudu-shengong"))/300 +
			victim->query_condition("zhizhu_poison"));
			break;
		case 2:
            victim->apply_condition("wugong_poison", (me->query_skill("wudu-shengong"))/300 +
			victim->query_condition("wugong_poison"));
			break;
		case 3:
            victim->apply_condition("xiezi_poison", (me->query_skill("wudu-shengong"))/300 +
			victim->query_condition("xiezi_poison"));
			break;
		case 4:
            victim->apply_condition("chanchu_poison", (me->query_skill("wudu-shengong"))/300 +
			victim->query_condition("chanchu_poison"));
			break;
	}
        return HIR "$n只觉得伤处一阵发麻，似乎中毒了。\n" NOR;
   }
}
}
