
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit FORCE;
int valid_enable(string usage)
{
    return usage == "force";
}
int valid_learn(object me)
{
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if (me->query("family/family_name")!="少林派")
		return notify_fail("你不是佛门中人，无法学习易筋内功。\n");	
	if ((int)me->query_skill("force", 1) <= (int)me->query_skill("yijing-force", 1) )
		return notify_fail("你的基本内功基础不够，再学下去会走火入魔的。\n");
	if (!me->query("jm/songshan"))
		return notify_fail(CYN"这嵩山派与我寺同处一山，欲夺取武林盟主之位，我少林表示不服。\n"CYN"这位"+RANK_D->query_respect(me)+CYN"可否先为我少林潜入嵩山派夺取其秘密？我寺将来必有厚报。\n"NOR);
	if ((int)me->query("family_score")<10)
		return notify_fail(CYN"这位"+RANK_D->query_respect(me)+CYN"对江湖不够了解啊，我寺功夫恐怕不能传授于你。\n"NOR);	
		
	return 1;
}

int practice_skill(object me)
{
    return notify_fail("易筋神功只能用学(learn)的来增加熟练度。\n");
}
string exert_function_file(string func)
{
    return __DIR__"yijing-force/" + func;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
	int lvl,ap,dp,damage2;
	ap = me->query_skill("yijing-force", 1);
	dp = victim->query_skill("force", 1);
	lvl = me->query_skill("yijing-force", 1);
	damage2 = (int)me->query_skill("yijing-force",1);	
	
    if( damage_bonus < 100 ) return 0;
	if ( me->query_skill("yijing-force",1) < 100)	 return 0;
	if ( me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "yijing-force") return 0;	
	if (damage2<10) damage2=10;	

	if (random(ap) > dp/20 && random(6)==0 && me->query("jiali") > 0)
	{
		me->add("neili", -100);
		victim->receive_damage("qi", damage2+damage_bonus/3+100+me->query("jiali"),me);
		victim->receive_wound("qi", damage2+damage_bonus/3+100+me->query("jiali"),me);	
		return HIR "易筋洗髓，乃天下内功之基石，大道至简。！\n" NOR;
	}
}
