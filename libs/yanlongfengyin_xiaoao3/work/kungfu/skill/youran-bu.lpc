// youran-bu.c  

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SKILL;
string *dodge_msg = ({
    HIM "$n漫不经心的向左迈出一步，刚好避过了这个凌厉的攻势。\n"NOR,
     YEL"可是$n恰巧往右走了一步，躲过了这一招。\n"NOR,
        WHT "但是$n身形飘忽，轻轻一纵，早已避开。\n"NOR,
         HIC"$n身随意转，倏地往一旁挪开了三尺，避过了这一招。\n"NOR,
       CYN "可是$n侧身一让，结果这一招扑了个空。\n"NOR,
       HIY "却见$n足不点地，往旁窜开数尺，躲了开去。\n"NOR,
         HIW"$n身形微晃，有惊无险地避开了这一招。\n"NOR,
});
int valid_enable(string usage) { return (usage == "dodge"); }
int practice_level(){   return 60;  }
int valid_learn(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if (me->query_skill("dodge", 1) <=me->query_skill("youran-bu", 1))
        return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
	    if (me->query("family/family_name")!="血河派")
   return notify_fail("你不加入血河派，恐怕学不了血河派技能。\n");	
    if ((int)me->query_skill("huaxue-dafa", 1) < 100 && (int)me->query_skill("yiriguan-riyue", 1) < 100 && (int)me->query_skill("longmen-shengong", 1) < 100)
    return notify_fail("你的本门内功火候不够，无法学习悠然步。\n");
    return 1;
}
string query_dodge_msg(object me,string limb)
{
        if (me) me->set_temp("fight/dodge",random(2*me->query_skill("youran-bu",1)));
        return dodge_msg[random(sizeof(dodge_msg))];
}
int practice_skill(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
        if( (int)me->query("qi") < 40 )
                return notify_fail("你的体力太差了，不能练悠然来往。\n");
	    if (me->query("family/family_name")!="血河派")
   return notify_fail("你不加入血河派，恐怕练习不了血河派技能。\n");				
        me->receive_damage("qi", 30);
        return 1;
}

string perform_action_file(string action)
{
                return __DIR__"youran-bu/" + action;
}

	//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{

        int j,ap,dp;
		ap = me->query_skill("youran-bu", 1) * me->query("con",1);
		dp = ob->query_skill("dodge", 1) * ob->query("dex",1);

	if (damage <10)  damage=10;    	
      if(random(ap) > dp/10
		&& me->query_skill("youran-bu", 1) > 300
		&& (me->query_skill_mapped("force") == "huaxue-dafa" || me->query_skill_mapped("force") == "yiqiguan-riyue" || me->query_skill_mapped("force") == "longmen-shengong")
        && me->query("neili") > 1000
		&& random(5)==0	)
        { 	
        message_vision(HIG"$N将血影身法发挥到极致，身影血气漫漫！$n受到血气侵染，出手似乎越来越无力。\n"NOR, me, ob); 		
            j = -(damage+random(damage)); 
			me->add("neili", 100 );
			return j;        
        }  
		
}
