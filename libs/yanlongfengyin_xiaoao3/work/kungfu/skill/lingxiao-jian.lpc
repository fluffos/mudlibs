int valid_learn(object me)
{
    object ob;
//		if (!wizardp(me))
	//	return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if( (int)me->query("max_neili") < 5000 )
return notify_fail("你的内力不够，没有办法练凌霄剑法。\n")      ;	
if( (int)me->query_skill("bingxue-xinfa",1) < 100 )     
return notify_fail("你的冰雪心法修为不够，没有办法练凌霄剑法。\n")      ; 
    if (me->query("family/family_name")!="凌霄城")
   return notify_fail("你不是凌霄城弟子，无法学习凌霄剑法。\n");      	
    if( !(ob = me->query_temp("weapon")) || (string)ob->query("skill_type") != "sword" )
        return notify_fail("你必须先找一把剑才能练剑法。\n");
	if ((int)me->query("score",1) < 5000)
		return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
	if (random(100)==1) me->add("score",-5);
    return 1;
}

int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }

string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int level;

	level   = (int) me->query_skill("lingxiao-jian",1);	

	if( random(10)==1 && random(level) > 300 && me->query("jiali")>100 )
	{
		return ([
		"action": HIC"$N手腕轻抖，一刹那中朝$n连刺六剑，每一剑都凭手腕颤动，幻成"+HIW"「雪花六出」"+HIC"，手法之快，实是无与伦比，出剑还剑，只一瞬间之事"NOR,
		"attack":	600,
		"parry":	600,
		"dodge":	600,
		"damage":	600,
		"force":	600,	
	    "skill_name" : "雪花六出",
		"damage_type" : "刺伤" ]);
	}
	if( random(10)==2 && random(level) > 300 && me->query("jiali")>100 )
	{
		return ([
		"action" : HIY"$N手中$w"+HIY"微微颤动，剑光若有若无，这招"+HIW"「暗香疏影」"NOR+HIY"是凌霄剑法中最精微的一招，宛若梅树在风中摇曳不定，剑法中夹杂了梅花、梅萼、梅枝、梅干的形态，古朴飘逸，兼而有之"NOR, 	
		"attack":	600,
		"parry":	600,
		"dodge":	600,
		"damage":	600,
		"force":	600,	
        "skill_name" : "暗香疏影",
		"damage_type": random(2)?"刺伤":"劈伤"]);
	}

    return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点

}


int practice_skill(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
        if( (int)me->query("qi") < 20  || (int)me->query("neili") < 10 )
return notify_fail("你的内力或气不够，没有办法练习凌霄剑法。\n"); 
    if (me->query("family/family_name")!="凌霄城")
   return notify_fail("你不是凌霄城弟子，无法练习凌霄剑法。\n");  
        me->receive_damage("qi", 15);
        me->add("neili", -5);
write("你按著所学练了一遍凌霄剑法。\n");        	
        return 1;
}

string perform_action_file(string action)
{
return __DIR__"lingxiao-jian/" + action;	
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb)
{                                                                                                                
	int ap,dp, damage2;
	object weapon;
		weapon = me->query_temp("weapon");
        ap = (int) me->query_skill("lingxiao-jian",1);
		dp = victim->query_skill("force",1);
		damage2 = (int)me->query_skill("lingxiao-jian",1);	
	
    if( damage_bonus < 100 ) return 0;
	if ( me->query_skill("bingxue-xinfa",1) < 100)	 return 0;
	if ( me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "bingxue-xinfa") return 0;	
	if (damage2<10) damage2=10;	

	if( random(8)==1 && random(ap)>dp/10 && me->query_skill_mapped("force")=="bingxue-xinfa" ) 
	{
		victim->receive_wound("qi", damage2+damage_bonus/2,me);
		me->add("neili", -100 );
		return HIR"只见$n$l上鲜血渗出，六点剑痕布成六角，已被"+weapon->name()+HIR"整整齐齐的刺了六点。\n"NOR;
    }
	
	if( random(8)==2 && random(ap)>dp/10 && me->query_skill_mapped("force")=="bingxue-xinfa" ) 
	{
		victim->apply_condition("ice_poison", (me->query_skill("lingxiao-jian"))/100 + 1 + victim->query_condition("ice_poison"));	
		me->add("neili", -100 );
		return HIW "$n只觉得伤口一寒,一股寒气似冰箭一样的串进$n的全身。\n" NOR;
	}
}
                                                                                                                                                                                                                      
