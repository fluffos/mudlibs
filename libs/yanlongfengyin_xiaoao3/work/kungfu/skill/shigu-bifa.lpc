int valid_enable(string usage) { return (usage == "club") || (usage == "parry"); }

int valid_learn(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if (me->query("family/family_name")!="梅庄")
		return notify_fail("你不加入本门，无法学习本门技能。\n");	
        if( (int)me->query("max_neili") < 10000 )
                return notify_fail("你的内力不够，没有办法练石鼓打穴笔法。\n");
        if( (int)me->query_skill("wuzheng-xinfa",1) < 100 )
                return notify_fail("你的无争心法火候不够，还不能学习石鼓打穴笔法!\n");
         return 1;
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];	//2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me)
{   
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	 
        if( (int)me->query("qi") < 30
        ||      (int)me->query("neili") < 30 )
                return notify_fail("你的内力或气不够，没有办法练习石鼓打穴笔法。\n");
	if (me->query("family/family_name")!="梅庄")
		return notify_fail("你不加入本门，无法学习本门技能。\n");	
    if (me->query_skill("wuzheng-xinfa",1)<100)
        return notify_fail("你的本门内功基础不够。\n");					
        me->receive_damage("qi", 20);
        me->add("neili", -10);
        write("你按著所学练了一遍石鼓打穴笔法。\n");
        return 1;
}

string perform_action_file(string action)
{
        return __DIR__ "shigu-bifa/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
	int ap,dp,damage2;
	damage2 = (int)me->query_skill("shigu-bifa",1);	
	ap = me->query_skill("shigu-bifa",1);
	dp = victim->query_skill("parry",1);
    if( damage_bonus < 100 ) return 0;
	if ( me->query_skill("wuzheng-xinfa",1) < 100)	 return 0;
	if ( me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "wuzheng-xinfa") return 0;	
	if (damage2<10) damage2=10;	

	if(	me->query_skill("force",1) >300
	    && random(ap) > dp/10
		&& me->query_skill_mapped("force")=="wuzheng-xinfa"
		&& random(5)==0 
		&& me->query("jiali") > 0)
	{
		victim->receive_damage("qi", damage2+damage_bonus/2 ,me);
		victim->receive_wound("qi", damage2+damage_bonus/2 ,me);		
//		if (!victim->is_busy()) victim->start_busy(1+random(3));
		me->add("neili", -100 );
		return HIR "$N栖身直上，紧贴着$n的身体，手中笔法使的精巧至极，连续击中$n的数处穴道！\n" NOR;
	}
}