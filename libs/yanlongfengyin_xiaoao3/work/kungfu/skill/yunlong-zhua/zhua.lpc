#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target)
{
	string msg;
	int flag,ap,dp,damage;
	flag = 1;
	
	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("「抓奶三招」只能对战斗中的对手使用。\n");
    if(me->is_busy())
        return notify_fail("你现在正忙着！\n");
	if( objectp(me->query_temp("weapon")))
		return notify_fail("你先放下手中的武器再说吧？！\n");
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
	if( (int)me->query_skill("yunlong-shengong", 1) < 300 )	
		return notify_fail("你的本门神功不够娴熟，无法施展云龙抓。\n");
	if( (int)me->query_skill("yunlong-zhua", 1) < 300 )
		return notify_fail("你的云龙抓不够娴熟，不会使用「抓奶三招」。\n");
	if( (int)me->query("neili") < 1000 )
		return notify_fail("你的内力不够，无法使用「抓奶三招」。\n");	
	if( (int)me->query("jingli") < 1000 )
		return notify_fail("你的精力不够，无法使用「抓奶三招」。\n");
	if(me->query_skill_mapped("force") != "yunlong-shengong" )
		return notify_fail("不使用本门内功，如何能使用本门绝技。\n");
	if (me->query_skill_mapped("unarmed") != "yunlong-zhua")
		return notify_fail("你没正确激发该技能 。\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	msg = HIB "$N下流至极，使出韦小宝的抓奶绝技,招招抓向$n的咪咪！\n"NOR;
	message_vision(msg, me, target);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1
	ap = me->query("xyzx_sys/level") + me->query_skill("yunlong-zhua", 1) + me->query_skill("unarmed") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
	if ( me->query("gender") == "男性" && target->query("gender") == "女性") flag = 10;
	if ( me->query("gender") == "女性" && target->query("gender") == "女性") flag = 3;
	if ( me->query("gender") == "女性" && target->query("gender") == "男性") flag = 5;

	if( random(ap) > dp/3 )
	{
		damage = me->query_skill("yunlong-zhua",1)*flag;
		damage = damage + random(damage);
		if (target->query("gender") == "女性") msg = HIW "$n被抓中咪咪，恼羞成怒，大骂道：$N下流胚子，受死！。\n" NOR;
		else msg = HIW "$n大笑，来呀，抓我呀！。\n" NOR;
		message_vision(msg, me, target);
		//if (!target->is_busy()) target->start_busy(5);
        target->receive_damage("qi",damage,me);
		target->receive_wound("qi",damage,me);
		me->add("neili", -500);
		me->add("jingli", -500);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage +"。\n" NOR);
	}
	else
	{
		damage = me->query_skill("yunlong-zhua",1);
		damage = damage + random(damage);
        me->receive_damage("qi",damage,target);
		me->receive_wound("qi",damage,target);
		me->add("neili",-300);
		me->add("jingli", -500);
		msg = HIC "$n轻蔑一笑，我是飞机场我怕谁。\n" NOR;
		message_vision(msg, me, target);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对自己气血的外伤为"+ damage +"，内伤为"+ damage +"。\n" NOR);
	}
	
	me->start_busy(1);
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}