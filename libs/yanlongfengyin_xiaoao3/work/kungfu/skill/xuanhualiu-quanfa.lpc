int valid_enable(string usage) {
  return usage == "cuff" || usage == "unarmed" || usage == "parry";
}
int valid_combine(string combo) {
  return combo == "enmeiryu";
}
int valid_learn(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练喧哗流拳法必须空手。\n");
  if ((int)me->query_skill("aikido", 1) < (int)me->query_skill("xuanhualiu-quanfa", 1))
    return notify_fail("你的空手道火候不够，无法学。\n");
  if (me->query("family/family_name") != "飞天御剑流")
    return notify_fail("你不是飞天门人，不能传授技能给你。\n");
  if ((int)me->query_skill("shayi-xinfa", 1) < 100)
    return notify_fail("你的杀意心法火候不够，无法学喧哗流拳法。\n");
  if ((int)me->query("max_neili") < 50000)
    return notify_fail("你的内力太弱，无法练喧哗流拳法。\n");
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}
mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  int flvl, damage2;
  string msg;
  int ap, dp;

  ap = me->query_skill("xuanhualiu-quanfa", 1);
  flvl = me->query("qi") / 10;
  damage2 = (int)me->query_skill("xuanhualiu-quanfa", 1);
  dp = (int)victim->query_skill("dodge", 1);

  if (damage_bonus < 100) return 0;
  if (me->query_skill("shayi-xinfa", 1) < 100) return 0;
  if (me->query("neili") < 100 || me->query_skill_mapped("force") != "shayi-xinfa") return 0;
  if (damage2 < 10) damage2 = 10;

  if (random(ap) > dp / 10 && random(6) == 3 && me->query("jiali") > 0) {
    msg = HIR "「二重劲!」$N以极快速的连击,在第一击后,$n没产生抵抗力时给予第二击! \n" NOR;
    if (random(3) == 0) msg = HIR "「隔空击物!」。$N将二重劲的威力传至远方攻击的$n,用以弥补远距离攻击的不足 。\n" NOR;
    if (random(3) == 1) msg = HIR "「喷射火焰!」。$N胃装油袋,用火石制的假牙点火喷出火焰,$n被极大的火焰打中!! \n" NOR;
    if (random(3) == 2) msg = HIR "「仙鹤飞腿!」。$N使出丑鬼直接传授的拳法之一踢向$n! 这踢法已独创一格!!\n" NOR;

    if (victim->query("qi") > flvl) {
      me->add("neili", -100);
      //		if (!victim->is_busy()) victim->start_busy(1+random(3));
      victim->receive_damage("qi", damage2 + damage_bonus / 2, me);
      victim->receive_wound("qi", damage2 + damage_bonus / 2, me);
    }
    return msg;
  }



  if (random(ap) > dp / 10 && me->query("jiali") > 0 && random(6) == 4) {
    victim->receive_wound("qi", damage2 + damage_bonus / 2, me);
    me->add("neili", -100);
    return RED "只见$n$l上鲜血直流，已被无形拳劲切了开来!\n" NOR;
  }

}
mapping query_action(object me, object target, object weapon) {
  int level = (int)me->query_skill("xuanhualiu-quanfa", 1);

  if (random(6) == 2 && random(level) > 300 && me->query("jiali") > 100) {
    return ([
      "action": HIG "「二重劲!」" + HIW "$N以极快速的连击,在第一击后,$n没产生抵抗力时给予第二击! 。" NOR,
      "attack": 300,
      "parry": 300,
      "dodge": 300,
      "damage": 300,
      "force": 300,
      "skill_name": "二重劲",
      "damage_type": random(2) ? "瘀伤" : "内伤" ]);
    if (!target->is_busy()) target->start_busy(1);
  }

  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点

}

int practice_skill(object me) {
  //	if (!wizardp(me))
  //	return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query_skill("shayi-xinfa", 1) < 30)
    return notify_fail("你的杀意心法火候不够。\n");
  if (me->query("family/family_name") != "飞天御剑流")
    return notify_fail("你不是飞天门人，练习不了本门技能。\n");
  if ((int)me->query("qi") < 70)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 70)
    return notify_fail("你的内力不够练喧哗流拳法。\n");
  me->receive_damage("qi", 50);
  me->add("neili", -30);
  return 1;
}
string perform_action_file(string action) {
  return __DIR__ "xuanhualiu-quanfa/" + action;
}
