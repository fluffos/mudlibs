// qimen-wuxing
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SKILL;

void create() { seteuid(getuid()); }

string type() { return "knowledge"; }

int valid_learn(object me)
{
    if (me->query("family/family_name")!="桃花岛" && me->query("family/family_name")!="玄天派")
		return notify_fail("奇门五行似乎只有桃花岛或玄天派才有研究。。。\n");	
    return 1;
}
int practice_skill(object me)
{       
        return notify_fail("奇门五行能靠学(learn)来提高。\n");
}
