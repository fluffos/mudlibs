// longxiang.c 龙象般若功	下乘武学100~300

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit FORCE;
mapping *action = (
{
([      "action" : "$N单掌一抖，运聚龙象般若功功力，呼啸着向$n的$l处拍去",
		"attack":	100,
		"parry":	100,
		"dodge":	100,
		"damage":	100,
		"force":	100,
"damage_type": "内伤"
	 ]),
([      "action" : "$N右拳横移，左掌运起龙象般若功的劲力，猛地拍向$n的$l",
		"attack":	200,
		"parry":	200,
		"dodge":	200,
		"damage":	200,
		"force":	200,
"damage_type": "内伤"
	 ]),
([      "action" : "$N吐气扬声，双拳同时运满龙象般若功功力，朝$n$l处贯去",
		"attack":	300,
		"parry":	300,
		"dodge":	300,
		"damage":	300,
		"force":	300,
"damage_type": "内伤"
	 ]),
([      "action" : "$N运足龙象般若功，双拳平推，顿时一股凌厉的罡劲直袭$n",
		"attack":	300,
		"parry":	300,
		"dodge":	300,
		"damage":	300,
		"force":	300,
"damage_type": "内伤"
	 ]),
});
int valid_enable(string usage)
{
	int lvl;
	lvl = (int)this_player()->query_skill("longxiang", 1);

	if (lvl >= 10000)
		return usage == "force" || usage == "parry" || usage == "unarmed";
	else 
		return usage == "force";
}

int valid_learn(object me)
{
	mapping skl;
	string *sname;
	int lvl = (int)me->query_skill("longxiang", 1);
	int i;
//	if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if (me->query("family/family_name")!="雪山寺")
   return notify_fail("你不是雪山寺弟子，无法学习本门技能。\n");
	if (((string)me->query("class") != "bonze") )
		return notify_fail("你不是僧人，学不了高深的龙象般若功。\n");
	if ((int)me->query_skill("force", 1) < 100)
		return notify_fail("你的基本内功火候不足，不能学龙象般若功。\n");
	if ((int)me->query("str", 1) < 30)
		return notify_fail("只有天生神力者才能修习龙象般若功。\n");	
	if ( me->query("gender") != "男性" )
		return notify_fail("龙象般若功这种刚猛的内功不是女人能学得了的！\n");	
	if ( me->query("gender") == "无性" && lvl > 49)
		return notify_fail("你无根无性，阴阳不调，难以领会高深的龙象般若功。\n");	
	if (me->query_skill("force",1)<=lvl)
		return notify_fail("你的基本内功基础不够，再学下去会走火入魔的。\n");
	skl = this_player()->query_skills();
	sname  = keys(skl);
	for (i=0; i<sizeof(skl); i++)
	{
		if (sname[i]=="xixing-dafa") continue;		
		if (sname[i]=="longxiang") continue;
		if (sname[i]=="yijing-force") continue;
		if (sname[i]=="xiaowuxiang") continue;			
		if( SKILL_D(sname[i])->valid_enable("force") )
			return notify_fail("你不先散了别派内功，怎能学龙象般若功。\n");
	}
	return 1;
}

int practice_skill(object me)
{
	return notify_fail("龙象般若功只能用学(learn)的来增加熟练度。\n");
}
mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

mapping exercise_msg(object me)
{
	return ([
            "status_msg" : "神色俨然,凝神闭目。\n",
            "start_my_msg" : "盘膝入定,凝聚体内真气,摧动内息将腹中一丝丝游气慢慢增厚。\n",
            "start_other_msg" :me->name()+"盘膝坐定,一掌向上推出,一手垂于丹田,面目极是诡异,让人心桤摇动。\n",
			"heal_my_msg" : "口吐“哼”“哈”之音，缭绕不散，愈来愈响，不一会，似龙象飞舞。\n",
			"heal_other_msg" :  me->name() + "口吐“哼”“哈”之音，声音悠长，连绵不散，不一会，如龙象奔跑。\n",
            "halt_msg" : "突然双手向胸前一合,压住腹中内息,凌空越起。\n",
            "end_my_msg" : "一周天行将下来,顿时浑身发暖,感到腹中内劲又增加一分。\n",
            "end_other_msg" : "只见"+me->name()+"头顶白气渐散,双掌向胸前一合,起身站了起来。\n",
			"hover_my_msg" : "全身骨节格格作响，犹如爆豆。过了良久，爆豆声渐轻渐稀，跟着脸上红光也渐渐淡了。\n",
			"hover_other_msg" : "只听得"+me->name()+"全身骨节格格作响，犹如爆豆。过了良久，爆豆声渐轻渐稀，跟着脸上红光也渐渐淡了。\n",	
	        ]);
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
	int layer,damage2,ap,dp;
	ap = me->query_skill("longxiang", 1) ;
	dp = victim->query_skill("force",1);
	layer = me->query_skill("longxiang", 1) / 30;
	damage2 = (int)me->query_skill("longxiang",1);	
	
    if( damage_bonus < 100 ) return 0;
	if ( me->query_skill("longxiang",1) < 100)	 return 0;
	if ( me->query("jiali") < 1 || me->query("neili") < 200 || me->query_skill_mapped("force") != "longxiang") return 0;	
	if (damage2<10) damage2=10;	

	if (layer >= 10 && random(8) == 1 && random(ap)>dp/20 )
	{
		me->add("neili",-100);
		victim->receive_wound("qi", damage2+20+damage_bonus/2,me);
		return HIY "$N" HIY "拳锋之上竟蕴藏着『" HIR "十龙十象"
		       HIY "』之力，罡劲破体，摧毁了$n" HIY "的真元！\n" NOR;
	}
	if (layer >= 20 && random(8) == 2 && random(ap)>dp/20 )
	{
		me->add("neili", -200);
		victim->receive_wound("qi", damage2*2+20+damage_bonus/2,me);
		return HIY "$N" HIY "双拳暗含龙象般若功第" + chinese_number(layer) +
		       "层功力，$n" HIY "心脉受震，喷出一口鲜血！\n" NOR;
	}

}

