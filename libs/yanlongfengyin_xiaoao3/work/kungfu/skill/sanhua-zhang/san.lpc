// san.c 「佛祖散花」
// shang 97/6

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;

int perform(object me, object target)
{

	object *ob;
	int i, skill, damage;

	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("「佛祖散花」只能在战斗中使用。\n");	
	if (objectp(me->query_temp("weapon")))
		return notify_fail("你必须空手才能使用「佛祖散花」。\n");
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
	if( (int)me->query("neili") < 1000 )
		return notify_fail("你内力不够不能使用「佛祖散花」。\n");
	if( (int)me->query("max_neili") < 200000 )
		return notify_fail("你的内力修为还不够高。\n");
	if ((int)me->query("jingli") < 1000)
		return notify_fail("你的精神太差，无法使用「佛祖散花」。\n");
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");	
	if( (int)me->query_skill("sanhua-zhang", 1) < 300 )
		return notify_fail("你的散花掌火侯还没到，「佛祖散花」使不出来。\n");
    if((int)me->query_skill("hunyuan-yiqi",1) < 300 && (int)me->query_skill("yijing-force",1) < 300 && (int)me->query_skill("yijinjing",1) < 300 && (int)me->query_skill("damo-force",1) < 300)
        return  notify_fail("你佛门内功修为不够，不能使用这一绝技!\n");
  	if (me->query_skill_mapped("force") != "yijinjing" && me->query_skill_mapped("force") != "hunyuan-yiqi" && me->query_skill_mapped("force") != "yijing-force" && me->query_skill_mapped("force") != "damo-force") 
		return notify_fail("你未使用佛门内功, 不能使用这一绝技 !\n"); 
	if (me->query_skill_mapped("unarmed") != "sanhua-zhang")
		return notify_fail("你没正确激发该技能 。\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	skill = me->query_skill("sanhua-zhang", 1);
	me->add("neili", -300);
	me->add("jingli", -300);
	message_vision( HIY "$N使出「佛祖散花」，掌风推动落下的花瓣攻向敌人。\n" NOR, me);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1
	damage = me->query_skill("sanhua-zhang", 1)*5 + me->query_skill("unarmed",1);
	ob = all_inventory(environment(me));
	for(i=0; i<sizeof(ob); i++)
	{
		if( !living(ob[i]) || ob[i]==me ) continue;
		if( !ob[i]->is_fighting(me) ) continue;
		if( ob[i]==me ) continue;
		if( !ob[i]->is_character() || ob[i]->is_corpse() ) continue;
		
		damage = random(damage)+damage;
		//if( damage > 5000 ) damage = 5001;
		ob[i]->receive_damage("qi", damage , me);
		ob[i]->receive_wound("qi", damage , me);
		tell_object(ob[i], "你觉得眼前无数花瓣飞来，挨了不少下。\n");
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对"+ i +"敌人气血的外伤为"+ damage +"，内伤为"+ damage +"。\n" NOR);
		if( !me->is_killing(ob[i]) ) me->fight_ob(ob[i]);
		if( !ob[i]->is_killing(me) ) ob[i]->fight_ob(me);
	}
	me->start_busy(1);
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}