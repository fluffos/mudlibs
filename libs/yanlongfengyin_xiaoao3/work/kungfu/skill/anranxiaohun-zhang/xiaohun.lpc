// xiaohun.c 黯然消魂
// By Kayin @ CuteRabbit Studio 99-4-16 19:18 new
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>
inherit F_SSERVER;

int perform(object me, object target)
{
	string msg;
	int extra,damage;
	int ap,dp;
	object weapon;
	
	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("「黯然消魂」只能在战斗中使用。\n");	
	if(me->is_busy())
		return notify_fail("你现在没空！！\n");
	if (objectp(weapon = me->query_temp("weapon")) || objectp(weapon = me->query_temp("secondary_weapon")))
		return notify_fail("「黯然消魂」只能空手使用。\n");
	if (target && target->query_temp("apply/shade_vision")) 
		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");
	if( (int)me->query("neili") < 1000 )
		return notify_fail("你的真气不够！\n");
	if( (int)me->query("jingli") < 1000 )
		return notify_fail("你的精力不够。\n");		
	if( (int)me->query("max_neili") < 100000 )
		return notify_fail("你的内力修为不够！\n");
	if(!me->query("couple/have_couple"))
		return notify_fail("你还没有所爱的人，无法体会深切思念一个人的感受。\n");
	if( (int)me->query_skill("anranxiaohun-zhang",1) < 500 )
		return notify_fail("你的黯然消魂掌火候不够，无法使用「黯然消魂」！\n");
	if( (int)me->query_skill("yunv-xinfa",1) < 500 )	
		return notify_fail("你的玉女心法火候不够，无法使用「黯然消魂」！\n");
	if( me->query_skill_mapped("force") != "yunv-xinfa" )
		return notify_fail("你所用的并非玉女心法，体会不了男女销魂之意！\n");
	if (me->query_skill_mapped("unarmed") != "anranxiaohun-zhang")
		return notify_fail("你没激发该技能 。\n");	
	if( me->query("jiali") < 100 )
	    return notify_fail("掌上加带内力太少无法使出。\n");	
	if( (int)me->query_skill("force",1) < 1000 )
		return notify_fail("你的内功基础不够，无法使用「黯然消魂」！\n");
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

	extra = me->query_skill("anranxiaohun-zhang",1);	
	msg = HIM "$N心如止水，心中思念着$N的爱人，无意之中使出了"HIR"“黯然消魂”！\n" NOR;
	msg += HIM   "就似傍晚的遥烟，顿时天地间产生一丝苦涩！\n" NOR;
	message_vision(msg, me, target);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1	
	me->add_temp("apply/attack", extra);
	me->add_temp("apply/damage", extra);	
	msg = HIC  "\n   黯 \n" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
	msg = HIY  "\n      然\n" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
	msg = HIW  "\n        消\n" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
	msg = HIR  "\n          魂\n" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
	msg = HIB "\n             掌\n" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
	me->add_temp("apply/attack", -extra);
	me->add_temp("apply/damage", -extra);
	msg = HIG "\n$N怒视$n,大唱一声，打出最后的一掌！就似傍晚的遥烟，顿时天地间产生一丝苦涩！\n"NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
	ap = me->query("xyzx_sys/level") + me->query_skill("anranxiaohun-zhang", 1) + me->query_skill("unarmed") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");	
	if (random(ap)>dp/3)	
		{
			damage = me->query_skill("anranxiaohun-zhang",1)*5+me->query("jiali")*5+me->query_skill("unarmed",1)+me->query_skill("force",1);
			damage = damage +random(damage);
			msg = RED"\n结果「轰」地一声，$n全身气血倒流，口中鲜血狂喷而出！\n"NOR;
			target->receive_damage("qi",damage,me);
			target->receive_wound("qi",damage,me);
			target->apply_condition("xiangsi",10);
//			if (!target->is_busy()) target->start_busy(3);
			message_vision(msg, me, target);
			if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage +"。\n" NOR);
			COMBAT_D->report_status(target);
		}
		else
		{
			msg = HIY"可是$p急中生智，伏地翻滚而出，避过了这致命一击,躲了开去。\n" NOR;
			message_vision(msg, me, target);
		}
	
	me->add("neili", -500);
	me->start_busy(1);
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}