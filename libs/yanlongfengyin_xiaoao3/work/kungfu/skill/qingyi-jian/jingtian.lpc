// jingtian.c  惊天一剑

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;

int perform(object me, object target)
{
	object weapon;
	string msg;
	int damage,ap,dp,extra;

	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("「惊天一剑」只能对战斗中的对手使用。\n");
	if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对。\n");
//	if (target && target->query_temp("apply/shade_vision")) 
//		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
	if (me->is_busy()) 
		return notify_fail("你现在正忙着呢！\n");
    if((int)me->query_skill("wuji-shengong",1)<1000)
        return notify_fail("你的无极神功不够深厚，不能使用「惊天一剑」。\n");	
	if((int)me->query_skill("qingyi-jian",1) < 1000)
		return notify_fail("你的情义剑法修为不够， 目前不能使用「惊天一剑」! \n");
	if((int)me->query_skill("wushuang-jian",1) < 1000)
		return notify_fail("你的无双剑法修为不够， 目前不能使用「惊天一剑」! \n");	
	if ( !wizardp(me) && me->query_skill_mapped("force") != "wuji-shengong")
		return notify_fail("不使用本门内功，如何使用本门绝学!\n"); 
	if (me->query_skill_mapped("sword") != "qingyi-jian")
		return notify_fail("你没正确激发该技能 。\n");
	if( (int)me->query("max_neili") < 1000000 )
		return notify_fail("你的内力修为还不够高。\n");
	if( (int)me->query("max_jingli") < 500000 )
		return notify_fail("你的精力修为还不够高。\n");
	if( (int)me->query("jingli") < 10000 )
		return notify_fail("你的精力不够了。\n");	
	if( (int)me->query("neili") < 10000 )
		return notify_fail("你的内力不够了。\n");
	if (!(int)me->query("breakup"))
        return notify_fail("你任督二脉未通,无法使用[" HIR "惊天一剑" NOR "]\n"NOR); 
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	message_vision(HBWHT "$N贯通杀手楼武学，使出了杀手楼的绝学之精髓！\n" NOR, me, target);	
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 5, me);	//CD写法1	
	message_vision(HIW  "$N神气贯通，将情义剑法八式一气呵成！\n \n"NOR, me, target);
	msg = HIY  "第一式：大悲式！\n\n$N手中$w斜指，一招「大悲式」，手中$w嗡嗡微振，幻成一条疾光刺向$n的$l。" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
	msg = HIR  "第二式：大欢式！\n\n"HIY"$N一招「大欢式」，剑意若有若无，$w淡淡地向$n的$l挥去。" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
	msg = HIR  "第三式：大离式！\n\n"HIY"$N一招「大离式」，纵身飘开数尺，运发剑气，手中$w遥摇指向$n的$l。" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
	msg = HIR  "第四式：大合式！\n\n"HIY"$N纵身向前跃起，一式「大合式」，剑光如轮疾转，霍霍斩向$n的$l。" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
	msg = HIR  "第五式：大喜式！\n\n"HIY"$N手中$w中宫直进，一式「大喜式」，带着丝丝剑气对准$n的$l刺出一剑。" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
	msg = HIR  "第六式：大怒式！\n\n"HIY"$N手中$w斜指苍天，剑芒吞吐，一式「大怒式」，对准$n的$l斜斜击出。" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
	msg = HIR  "第七式：大哀式！\n\n"HIY"$N左指凌空虚点，右手$w带出丈许雪亮剑芒，一式「大哀式」刺向$n的$l。" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
	msg = HIR  "第八式：大乐式！\n\n"HIY"$N一式「大乐式」，$w嗡嗡作响，如疾电般射向$n的胸口。" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
	me->add("neili", -1000);
	ap = me->query("xyzx_sys/level") + me->query_skill("qingyi-jian", 1) + me->query_skill("wushuang-jian", 1)+ me->query_skill("sword") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");	
	extra = me->query_skill("qingyi-jian", 1) + me->query_skill("wushuang-jian", 1);
if(me->query_skill("qingyi-jian",1) > 2000 && me->query_skill("wushuang-jian",1) > 2000)	
{
	msg = HIG"$N终于领悟八式合一，使出一式「剑心通明」，$w陡然化为纵横交错的剑网，铺天盖地向$n盖下去！\n\n"NOR;
	message_vision(msg, me, target);
	me->add_temp("apply/attack",extra);
	me->add_temp("apply/damage",extra);
	msg = HIY  "情义剑法：心剑！\n\n$N一式「心剑」，$w陡然化为纵横交错的剑网，铺天盖地向$n盖下去。" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
	msg = HIR  "无双剑法：万法！\n\n"HIY"$N随风轻轻飘落，一式「万法」，手中$w平指，缓缓拍向$n脸颊。" NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
	me->add_temp("apply/attack",-extra);
	me->add_temp("apply/damage",-extra);
	if (random(ap) > dp/3 )
	{
		damage = me->query_skill("qingyi-jian",1) + me->query_skill("wushuang-jian", 1) + me->query_skill("sword",1)+me->query_skill("wuji-shengong",1)+me->query_skill("force");
		target->receive_damage("jing", 20+damage,me );
        target->receive_wound("jing", 20+damage/2,me );
		target->receive_damage("qi", 20 + damage,me);
		target->receive_wound("qi", 20 + damage/2,me);
		msg = HIR"结果$n被$N的「心剑」剑透前心，眼前一黑，「哇」地吐出了一大口血！！\n"NOR;
		message_vision(msg, me, target);
		me->add("neili", -2000);
		me->add("jingli", -2000);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"，精神的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
	}
	else
	{
		msg = CYN"可是$p猛地向前一跃,跳出了$P的攻击范围。\n"NOR;
		message_vision(msg, me, target);
		me->add("neili", -1000);
	}
}

if(me->query_skill("qingyi-jian",1)>3000 && me->query_skill("wushuang-jian",1)>3000)	
{	
	message_vision(HIW "$N经过多年研究，融汇贯通情义剑法和无双剑法，最终领悟出情义无双终极奥义！\n"NOR, me, target);
	msg = HIG"$N身形一变，一声朗笑，使出情义无双剑法绝技「惊天一剑」，将全身劲气\n运于剑上，" + weapon->name()+ "化作一道长虹，直惯$n而去！\n\n"NOR;
	message_vision(msg, me, target);
		if (me->query("jm/shashou")) damage = me->query_skill("qingyi-jian",1)*me->query("str",1)*3/2 + (int)me->query_skill("wushuang-jian", 1)*me->query("str",1)*3/2 + me->query_skill("sword",1)+me->query_skill("wuji-shengong",1)*me->query("str",1)*3/2+me->query_skill("qishen-dao",1)*me->query("str",1)+me->query_skill("force",1)+me->query("jiali");
		else damage = me->query_skill("qingyi-jian",1)*me->query("str",1) + (int)me->query_skill("wushuang-jian", 1)*me->query("str",1) + me->query_skill("sword",1)+me->query_skill("wuji-shengong",1)*me->query("str",1)+me->query_skill("qishen-dao",1)*me->query("str",1)/2+me->query_skill("force",1)+me->query("jiali");
		damage = damage + random(damage);	
	if (random(ap) > dp/3 )
	{
		me->add_temp("apply/attack",extra*2);
		me->add_temp("apply/damage",extra*2);
		msg = HIM"「惊天一剑」！！！\n"NOR;
		COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
		me->add_temp("apply/attack",-extra*2);
		me->add_temp("apply/damage",-extra*2);			
		target->receive_damage("jing", damage,me );
        target->receive_wound("jing", damage/2,me );
		target->receive_damage("qi", damage,me);
		target->receive_wound("qi", damage/2,me);
		msg = HIC"这一剑，剑气冲天贯地！！\n"NOR;
		msg += HIC"这一剑，剑气横扫八方！！\n"NOR;
		msg += HIC"这一剑，剑气惊艳万古！！\n"NOR;
		msg += HIR"结果$n被$N的「惊天一剑」穿身而过，全身被剑气横扫，鲜血狂喷！！\n"NOR;
		message_vision(msg, me, target);
		me->add("neili", -3000);
		me->add("jingli", -5000);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"，精神的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);	
	}
	else
	{
		target->receive_damage("qi", damage/3,me);
		target->receive_wound("qi", damage/5,me);
		msg = CYN"$p猛地向前一跃,狂笑一声，自以为跳出了$P的攻击范围。\n"NOR;
		msg += CYN"结果#p低头一看，胸口一柄剑尖！！。\n"NOR;
		message_vision(msg, me, target);
		me->add("neili", -1000);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage/3 +"，内伤为"+ damage/5 +"。\n" NOR);
	}
}
  me->start_busy(1);
	return 1;

}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}