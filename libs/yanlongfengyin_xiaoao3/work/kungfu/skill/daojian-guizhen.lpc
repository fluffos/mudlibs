string main_skill() { return "daojian-guizhen"; }

mapping sub_skills = ([
  "miaojia-jian": 1000,
  "hujia-dao": 1000,
]);

int get_ready(object me) {
  return 1;
}

int get_finish(object me) {
  object ob;

  if (!(ob = me->query_temp("weapon")) || ((string)ob->query("skill_type") != "sword" && (string)ob->query("skill_type") != "blade")) {
    tell_object(me, "你空手舞了半天，发现不拿把刀或是剑实在难以演练。\n");
    return 0;
  }
  if (me->query("family/family_name") != "胡苗世家") {
    tell_object(me, "你不是关外胡家或中原苗家弟子，怎么能演练刀剑归真呢。\n");
    return 0;
  }
  if (me->query("int", 1) < 25) {
    tell_object(me, "你演练完毕，只感剑法和刀法毫无牵连，看来依你的悟性，无法将其合一。\n");
    return 0;
  }
  if (me->query("str", 1) < 25) {
    tell_object(me, "你演练完毕，只觉依自己的臂力，本无法将二者合一。\n");
    return 0;
  }
  if (me->query_skill("daojian-guizhen", 1) > 100) {
    tell_object(me, "你已经领悟了刀剑归真，用不着再演练了。\n");
    return 0;
  }
  if (me->query_skill("literate", 1) < 5000) {
    tell_object(me, "你的学问不够，难以理解苗家剑法和胡家刀法的精髓之处。\n");
    return 0;
  }
  if (me->query_skill("hujia-dao", 1) < 2000) {
    tell_object(me, "你的胡家刀法修为不足，无法将二者合一。\n");
    return 0;
  }
  if (me->query_skill("miaojia-jian", 1) < 2000) {
    tell_object(me, "你的苗家剑法修为不足，无法将二者合一。\n");
    return 0;
  }
  if (me->query_skill("lengyue-shengong", 1) < 500) {
    tell_object(me, "你的冷月神功修为不足，无法将二者合一。\n");
    return 0;
  }
  if ((int)me->query("max_neili") < 500000) {
    tell_object(me, "你觉得自己内力不够浑厚，无法将苗家剑法和胡家刀法二者合一。\n");
    return 0;
  }
  if ((int)me->query("neili") < me->query_skill("lengyue-shengong", 1)) {
    tell_object(me, "你一口真气提不上来，刚有所感悟却难以为继。\n");
    return 0;
  }
  if ((int)me->query("score", 1) < 10000) {
    tell_object(me, "你对我派毫无贡献而言，怎么可能演练本派武学呢。\n");
    return 0;
  }
  if (random(10000) < 10) {
    tell_object(me, "你觉得有所感悟，或许再演练一次就能融会贯通，将二者合一。\n");
    me->add("neili", -100);
    if (random(10) == 1) me->add("score", -10);
    return 0;
  }

  tell_object(me, HIY "\n一阵凡尘往事涌上心头，你几欲放声长叹。霎"
    "那间，苗家剑法和胡家刀法交替着不断在\n你脑海里"
    "闪现，终于融会贯通，合二为一。你终于通晓了刀剑"
    "归真的诀窍。\n" NOR);
  message(
    "channel:chat",
    CYN "【天降奇才】" GRN + "听说" + me->query("name") + "天纵奇才，刻苦钻研胡家刀与苗家剑，居然领悟了刀剑归真！\n" NOR,
    users()
  );
  me->set_skill("daojian-guizhen", 101);

  return 1;
}

mapping query_sub_skills() {
  return sub_skills;
}

int valid_enable(string usage) {
  return usage == "sword" || usage == "blade" || usage == "parry";
}

int valid_learn(object me) {
  return notify_fail("刀剑归真只能通过演练参悟。\n");
}

//2017.12.31阿飞改，刀剑归真自练方式改成类似独孤模式
int practice_skill(object me) {
  return notify_fail("刀剑归真只能通过「" + HIC + "刀剑合一" + NOR + "」来提升。\n");
}

