mixed hit_ob(object me, object victim, int damage_bonus) {
  int ap, dp, damage2;
  ap = me->query_skill("daojian-guizhen", 1) + me->query_skill("lengyue-shengong", 1);
  dp = victim->query_skill("parry", 1) + victim->query_skill("dodge", 1);
  damage2 = (int)me->query_skill("daojian-guizhen", 1);

  if (damage_bonus < 100) return 0;
  if (me->query_skill("lengyue-shengong", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "lengyue-shengong") return 0;
  if (damage2 < 10) damage2 = 10;

  if (random(ap) > dp / 10 && me->query("jiali") > 0 && random(6) == 1 && me->query_skill_mapped("force") == "lengyue-shengong") {
    victim->receive_damage("qi", damage2 * 2 + 10 + damage_bonus, me);
    victim->receive_wound("qi", damage2 * 2 + 10 + damage_bonus, me);
    me->add("neili", -100);
    return random(2) ? HIR "只听「噗嗤」一声，一股鲜血至$n"
      HIR "胸前射出。\n" NOR :

      HIR "霎时只见寒光一闪，一柱鲜血至$n"
      HIR "胸前射出。\n" NOR;
  }
}

string perform_action_file(string action) {
  return __DIR__ "daojian-guizhen/" + action;
}

int query_effect_parry(object attacker, object me) {
  int lvl;
  if (!objectp(me->query_temp("weapon")))
    return 0;

  lvl = me->query_skill("daojian-guizhen", 1);
  if (lvl < 80) return 0;
  if (lvl < 200) return 50;
  if (lvl < 280) return 80;
  if (lvl < 350) return 100;
  return 120;
}
//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡bug有关
int ob_hit(object ob, object me, int damage) {
  int ap, dp, j;
  string msg;

  dp = ob->query_skill("force", 1) + ob->query_skill("count", 1) + ob->query_skill("qimen-flee", 1);
  ap = me->query_skill("daojian-guizhen", 1);

  if ((int)me->query_skill(
    "daojian-guizhen",
    1
  ) < 100 || !living(me) || !objectp(me->query_temp("weapon")))
    return damage;

  if (damage < 10) damage = 10;
  if (random(ap) > dp / 10 && random(5) == 1 && me->query_skill_mapped("force") == "lengyue-shengong") {


    msg = HIC "$N" HIC "突然使出一招「大雪纷纷」，发出万长白芒，寒光四射，化守势为攻势，对" HIC "$n" HIC "发动反击！\n" NOR;
    ob->receive_damage("qi", me->query_skill("daojian-guizhen", 1), me);
    ob->receive_wound("qi", me->query_skill("daojian-guizhen", 1), me);
    msg += HIB "\n与此同时$n的击出的力道被削弱了一半！\n" NOR;
    me->add("neili", -100);
    j = -(damage + random(damage));
    message_vision(msg, me, ob);
    return j;
  }

}
