    "attack": 400,
    "parry": 400,
    "dodge": 400,
    "damage": 400,
    "force": 400,
    "damage_type": "割伤",
  ]),
  ([ "action": "$N一招「" HIY "黄龙转身吐须" NOR "」，朝$n疾刺出三"
    "剑，猛然间又变招为「" HIW "沙鸥掠波" NOR "」！\n自下"
