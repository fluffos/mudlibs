// xiaoyaoyou.c
// written by Xiang
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SKILL;
string *dodge_msg = ({
    "$n一个「"+GRN+"蜻蜓点水"+NOR+"」，躲过了$N这一招。\n",
    "$n身形向后一纵，使出一招「"+YEL+"细胸巧翻云"+NOR+"」，避过了$N的攻击。\n",
    "$n使出「"+HIR+"虚怀若谷"+NOR+"」，恰好躲过了$N的攻势。\n"
        "但是$n身形飘忽，轻轻一纵，早已避开。\n",
        "$n身随意转，倏地往一旁挪开了三尺，避过了这一招。\n",
});
int valid_enable(string usage) 
{ 
    return (usage == "dodge"); 
}
int practice_level(){   return 60;  }
int valid_learn(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if (me->query_skill("dodge", 1) <=me->query_skill("xiaoyaoyou", 1))
        return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
	    if (me->query("family/family_name")!="丐帮")
   return notify_fail("你不是乞丐，学不了丐帮技能。\n");
    if ((int)me->query_skill("huntian-qigong", 1) < 100)
    return notify_fail("你的浑天气功火候不够，无法学习逍遥游。\n");
    return 1;
}
string query_dodge_msg(string limb)
{
        return dodge_msg[random(sizeof(dodge_msg))];
}
int practice_skill(object me)
{
//		if (!wizardp(me))
//		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
        if( (int)me->query("qi") < 40 )
                return notify_fail("你的体力太差了，不能练逍遥游。\n");
	    if (me->query("family/family_name")!="丐帮")
   return notify_fail("你不是乞丐，练习不了丐帮技能。\n");			
        me->receive_damage("qi", 30);
        return 1;
}
string perform_action_file(string action)
{
        return __DIR__"xiaoyaoyou/" + action;
}
	//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{

        int j,ap,dp,neili,neili1;
		ap = me->query_skill("xiaoyaoyou", 1) * me->query("con",1);
		dp = ob->query_skill("dodge", 1) * ob->query("str",1);

        neili = me->query("neili");
        neili1 = ob->query("neili");

	if (damage <10)  damage=10;      	
      if(random(ap) > dp/10
		&& me->query_skill("huntian-qigong",1) > 100
		&& me->query_skill("xiaoyaoyou", 1) > 200
		&& me->query_skill_mapped("force") == "huntian-qigong"
        && me->query("neili") > 1000
		&& random(5)==0	)
        { 	
        message_vision(HIG"$N顿悟逍遥意境，将逍遥二字发挥的淋漓尽致，身形变的不可捉摸。\n"NOR, me, ob); 		
		if (!ob->is_busy()) ob->start_busy(1);
		me->add("neili", -100 );
           if(neili >= random(neili1)+damage)
		   {
              message_vision( HIC"$n被$N的随心所欲的身法惊呆了！下手顿时变得极轻。\n"NOR, me, ob);
              j = -(damage+random(damage)); 
            }           
           return j;
        }          
}
