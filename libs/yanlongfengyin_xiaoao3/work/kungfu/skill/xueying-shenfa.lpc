// xueying-shenfa
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SKILL;

mapping *action = ({
([	"action" : "$n一式「天涯海角」，身轻如燕，从$N身边横跃而过。\n",
	"dodge"  : 10
]),
([	"action" : "$n一式「血海飘香」，如一阵清风，舒缓地闪过了$N的凌厉攻势。\n",
	"dodge"  : 20
]),
([	"action" : "$n一式「血影无踪」，轻盈地一跃，一转眼间便绕到了$N的身后。\n",
	"dodge"  : 30
]),
([	"action" : "$n一式「心血来潮」，一转身间，向后飘出近一丈远\n",
	"dodge"  : 40
]),
([	"action" : "$n一式「血海茫茫」，拔地而起，在半空中一转，已落到几丈远的地方。\n",
	"dodge"  : 50
]),
([	"action" : "$n一式「血刀之影」，淼茫中防似看到红色的刀光。\n",
	"dodge"  : 60
]),
([	"action" : "$n一式「血洗情天」，双脚点地，全身化为一道白影，急速绕着$N打了几转。\n",
	"dodge"  : 70
]),
([	"action" : "$n一式「血魔之影」，漫天红影，围着$N急速地盘旋了几圈。\n",
	"dodge"  : 80
]),
([	"action" : "$n一式「血血血」，漫天红影，围着$N急速地盘旋了几圈。\n",
	"dodge"  : 90
])
});

mapping query_action(object me, object weapon)
{
	int zhaoshu, level;

	zhaoshu = sizeof(action);
	level   = (int) me->query_skill("huashan-shenfa");

	if (level < 80 )
		zhaoshu--;

	if (level < 60 )
		zhaoshu--;

	if (level < 40 )
		zhaoshu--;

	return action[random(zhaoshu)];
}

int valid_enable(string usage)
{
	return usage == "dodge" ;
}

int valid_learn(object me)
{
	//	if (!wizardp(me))
	//	return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
    if (me->query("family/family_name")!="血刀门")
   return notify_fail("你不是血刀门弟子，无法学习血影。\n");	

    if ((int)me->query_skill("xuedao-xinfa", 1) < 100)
    return notify_fail("你的血刀心法不够，无法学习血影。\n");

    return 1;
}

string query_dodge_msg(string limb)
{
	object me, ob;
	mapping action;

	me = this_player();
	action = query_action(me, ob);

	return action["action"];
}

int practice_skill(object me)
{
	//	if (!wizardp(me))
	//	return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
	if( (int)me->query("qi") < 40 )
		return notify_fail("你的体力太差了，不能练血影身法。\n");
	    if (me->query("family/family_name")!="血刀门")
   return notify_fail("你不是血刀门弟子，看不清血影。\n");	
	me->receive_damage("qi", 30);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"xueying-shenfa/" + action;
}
	//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage)
{

        int j,ap,dp;
		ap = me->query_skill("xueying-shenfa", 1) * me->query("int",1);
		dp = ob->query_skill("dodge", 1) * ob->query("dex",1);

	if (damage <10)  damage=10;  	
      if(random(ap) > dp/10
		&& me->query_skill("xuedao-xinfa",1) > 100
		&& me->query_skill("xueying-shenfa", 1) > 200
		&& me->query_skill_mapped("force") == "xuedao-xinfa"
        && me->query("neili") > 1000
		&& random(6)==0	)
        { 	
        message_vision(HIG"$N将血影身法发挥到极致，身影血气漫漫！$n受到血气侵染，出手似乎越来越无力。\n"NOR, me, ob); 		
            j = -(damage+random(damage)); 
			me->add("neili", -100 );
			return j;        
        }  
		
}
