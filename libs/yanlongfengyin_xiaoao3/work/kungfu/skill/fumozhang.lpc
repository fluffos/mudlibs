//fumozhang.c 【伏魔掌】	中乘武学200~600
//2000/11
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SKILL;

mapping *action = ({
  ([ "action": "$N前腿踢出，后腿脚尖点地，一式" HIC "「伏魔天下」" NOR "，二掌直出，攻向$n的上中下三路",
    "attack": 200,
    "parry": 200,
    "dodge": 200,
    "damage": 200,
    "force": 200,
    "neili": 80,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N左掌划一半圆，一式" HIR "「铁血丹心」" NOR "，右掌斜穿而出，疾拍$n的胸前大穴",
    "attack": 200,
    "parry": 200,
    "dodge": 200,
    "damage": 200,
    "force": 200,
    "neili": 70,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N使一式" HIM "「荡尽群魔」" NOR "，右掌上引，左掌由后而上一个甩劈，斩向$n的$l",
    "attack": 300,
    "parry": 300,
    "dodge": 300,
    "damage": 300,
    "force": 300,
    "neili": 60,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N左掌护胸，右拳凝劲后发，一式" HIY "「横空出世」" NOR "，缓缓推向$n的$l",
    "attack": 400,
    "parry": 400,
    "dodge": 400,
    "damage": 400,
    "force": 400,
    "neili": 100,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N使一式" HIG "「力拔千钧」" NOR "，全身飞速旋转，双掌一前一后，猛地拍向$n的胸口",
    "attack": 500,
    "parry": 500,
    "dodge": 500,
    "damage": 500,
    "force": 500,
    "neili": 90,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N合掌抱球，猛吸一口气，一式" HIW "「群魔伏首」" NOR "，双掌疾推向$n的肩头",
    "attack": 600,
    "parry": 600,
    "dodge": 600,
    "damage": 600,
    "force": 600,
    "neili": 60,
    "damage_type": "瘀伤"
  ]),
});

int valid_learn(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练伏魔掌必须空手。\n");
  if (me->query("family/family_name") != "蜀山派")
    return notify_fail("你不是蜀山中人，无法学习本门技能。\n");
  if ((int)me->query_skill("shushan-force", 1) < 100)
    return notify_fail("你的蜀山内功火候不够，无法学习伏魔掌。\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (random(100) == 1) me->add("score", -5);
  return 1;
}

int valid_enable(string usage) {
  return usage == "unarmed" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("jing") < 30)
    return notify_fail("你的精神无法集中了，休息一下再练吧。\n");
  if ((int)me->query("qi") < 30)
    return notify_fail("你现在手足酸软，休息一下再练吧。\n");
  if ((int)me->query("neili") < 10)
    return notify_fail("你的内力不够了。\n");
  if (me->query("family/family_name") != "蜀山派")
    return notify_fail("你不是蜀山中人，无法练习门技能。\n");
  me->receive_damage("qi", 30);
  me->add("neili", -10);

  return 1;
}
string perform_action_file(string func) {
  return __DIR__ "fumozhang/" + func;
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  int ap, dp, damage2;
  damage2 = (int)me->query_skill("fumozhang", 1);
  ap = me->query_skill("fumozhang", 1);
  dp = victim->query_skill("force", 1);
  if (damage_bonus < 100) return 0;
  if (me->query_skill("shushan-force", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "shushan-force") return 0;
  if (damage2 < 10) damage2 = 10;
  if (me->query("jiali") > 0
    && me->query_skill_mapped("force") == "shushan-force"
    && random(ap) > dp / 10
    && random(5) == 0) {
    victim->receive_wound("qi", damage2 + damage_bonus / 2, me);
    return HIR "$N大吼一声：御剑伏魔！$n被声波震的两眼发花！\n" NOR;
    //		if (!victim->is_busy()) victim->start_busy(1);
    me->add("neili", -100);

  }
}
