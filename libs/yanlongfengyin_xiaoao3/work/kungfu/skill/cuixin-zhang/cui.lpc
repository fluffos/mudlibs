#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target)
{
	int damage,ap,dp,extra,skill;
	string msg;

	if( !target ) target = offensive_target(me);
	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("「"+HIG"摧心碎魂"NOR+"」只能对战斗中的对手使用。\n");
	if (objectp(me->query_temp("weapon")))
		return notify_fail("你必须空手才能使用摧心掌。\n");
//	if (target && target->query_temp("apply/shade_vision")) 
//		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	
	if( (int)me->query_skill("cuixin-zhang", 1) < 300 )
		return notify_fail("你的摧心掌不够熟练，不会使用「"+HIG"摧心碎魂"NOR+"」。\n");
    if(me->is_busy())
        return notify_fail("你现在正忙着！\n");
	if( target && target->is_busy() )
		return notify_fail(target->name() + "已经不能动了！\n");
	if ( target && target->query_temp("busy_mianyi") )	//冲穴成功后免疫busy，2017.9.29阿飞添加
		return notify_fail(target->name() + "奇经八脉浑然一体，真气浩浩荡荡，点穴似乎没什么作用。\n");	
	if( (int)me->query_skill("lingyuan-xinfa", 1) < 300 )
		return notify_fail("你的灵元心法不够熟练，不会使用「"+HIG"摧心碎魂"NOR+"」。\n");
	if( (int)me->query_skill("lingyunbu", 1) < 300 )
		return notify_fail("你的凌云步法不够熟练，不能配合摧心掌使用「"+HIG"摧心碎魂"NOR+"」。\n");
	if ( !wizardp(me) && me->query_skill_mapped("force") != "lingyuan-xinfa")
		return notify_fail("不使用本门内功，如何使用本门绝学!\n");
	if ( me->query_skill_mapped("unarmed")!="cuixin-zhang" ) 
		return notify_fail("你没有正确激发该技能！\n");
	if( (int)me->query("max_neili") < 100000 )
		return notify_fail("你的内力修为还不够高。\n");
	if( (int)me->query("neili") < 1000 )
		return notify_fail("你的内力不够了。\n");
	if( (int)me->query("jingli") < 1000 )
		return notify_fail("你的精力不够。\n");	
	if (me->query_temp("autolian"))
		return notify_fail("你正在发动自动连招！\n"); 	
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
		
	msg = HIC "$N双手一分，施展出摧心掌之秘技"HIM+"「摧心碎魂」"+HIC"，向$n轻飘飘的拍出一掌！\n"NOR;
	message_vision(msg, me, target);
	me->set_temp("cooldown", 1);	//CD写法	2017.9.7添加
	call_out("del_cooldown", 3, me);	//CD写法1	
	ap = me->query("xyzx_sys/level") + me->query_skill("cuixin-zhang", 1) + me->query_skill("unarmed") + me->query_skill("force");
	dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");	
	extra = me->query_skill("cuixin-zhang", 1);
	skill = (int)me->query_skill("cuixin-zhang", 1);	
	damage = me->query_skill("cuixin-zhang", 1)*me->query("kar",1) + me->query_skill("unarmed",1) + me->query_skill("force",1);
	damage = damage + random(damage);
	if( random(ap) > dp/3)
	{
		target->receive_damage("qi", damage,me);
		target->receive_wound("qi", damage/2,me);
		if (userp(me) && me->query("env/no_combat_msg")<4) tell_object(me, HIW"该绝招对敌人气血的外伤为"+ damage +"，内伤为"+ damage/2 +"。\n" NOR);
		me->add("neili", -500);
		msg = HIR"$n眼见这一掌柔弱无力，也不去理睬，当$N掌力击在身上只时才感到五内具焚！！\n"NOR;
		message_vision(msg, me, target);
        me->add_temp("apply/damage", extra*3);
        me->add_temp("apply/attack", extra*3); 		
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        me->add_temp("apply/damage", -extra*3);
        me->add_temp("apply/attack", -extra*3); 		
		return 1;
	}
	else
	{
		me->add("neili",-200);
		msg = HIY"$n眼镜一亮，看出这掌中蕴涵无穷力量，连忙后退躲开！\n"NOR;
		message_vision(msg, me, target);
	}

	msg = HIM "$N手一摇，一招「一拍两散」已然隐隐击在$n的身上。\n"NOR;
	message_vision(msg, me, target);
	if( random(ap) > dp/3 )
	{
		msg = HIR "$p躲闪不及，被$N拍中身上几处穴道，顿时动弹不得。\n" NOR;
		message_vision(msg, me, target);
		target->start_busy( (100*skill)/(skill+1000)+5 );
		me->add("neili", -500);
	}
	else
	{
		me->add("neili",-300);
		msg = HIC "$p看出了$N的招式空隙，躲了过去。\n" NOR;
		message_vision(msg, me, target);
	}
	if(!target->is_fighting(me)) target->fight_ob(me);
	me->start_busy(1);
	return 1;
}

void del_cooldown(object me)	//CD写法1
{ 
	if ( !objectp(me) ) return;
	if ( me->query_temp("cooldown") )	
	{
		me->delete_temp("cooldown");
		tell_object(me, HIM"你呼出一口气，缓缓的将内力收回丹田。\n"NOR);
	}	
}