#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration)
{
    if( duration < 1 ) return 0;
    if( !living(me) ) 
	{
        message_vision(me->name() + "身体一阵颤抖，痛苦地哼了一声。\n", environment(me), me);
    }
	else 
	{
        tell_object(me, "你忽然觉得浑身经脉扭曲痛苦无比。\n");
        message("vision", me->name() + "身体一阵颤抖，痛苦地哼了一声。混身经脉疼痛欲裂,扭结成怪异的肉筋。\n", environment(me), me);
    }		
    me->receive_damage("qi",100 + random(me->query("max_qi")/100));
    me->receive_damage("jing", 100+random(me->query("max_jing")/100));
    me->receive_wound("qi",100 + random(me->query("max_qi")/100));
    me->receive_wound("jing", 100+random(me->query("max_jing")/100));
    me->apply_condition("emerald_poison", duration - 1);
    me->set_temp("die_for","绿宝石之毒发作");
    me->delete_temp("last_damage_from");
    if( duration < 1 ) return 0;
	return CND_CONTINUE;    
//	return 1;
}

string query_type(object me)
{
       return "poison";
}
