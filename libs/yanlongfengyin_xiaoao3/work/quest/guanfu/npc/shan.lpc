// shan 单正
 
inherit NPC;
string random_name();
 
void create()
{
	int jibie;
	jibie = 500;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
	set_name("单狰", ({"dan zheng"}));
	set("nickname", "泰山单家叛徒");
	set("long", 
        "泰山单家的叛徒，性如烈火，一身功夫少有敌手。\n");
	set("gender", "男性");
	set("age", 66);
	set("attitude", "peaceful");
    set("shen_type", -1);	
	set("str", 28);
	set("int", 20);
	set("con", 25);
	set("dex", 27);
	
	set("max_qi", 1800);
	set("max_jing", 1800);
	set("neili", 1800);
	set("max_neili", 1800);
	set("jiali", 100);
	set("combat_exp", 850000); 
        set("chat_chance_combat", 30);
        set("chat_msg_combat", ({
               (: perform_action, "force.powerup" :),
        }));
        set_skill("force", 500+jibie/3+random(jibie/5));
        set_skill("huntian-qigong", 500+jibie/3+random(jibie/5));
        set_skill("dodge", 500+jibie/3+random(jibie/5));
        set_skill("xiaoyaoyou", 500+jibie/3+random(jibie/5));
        set_skill("strike", 500+jibie/3+random(jibie/5));
        set_skill("tiezhang-zhangfa", 500+jibie/3+random(jibie/5));
        set_skill("parry", 500+jibie/3+random(jibie/5));
       
        map_skill("force", "huntian-qigong");
        map_skill("dodge", "xiaoyaoyou");
    
        map_skill("strike", "tiezhang-zhangfa");
  	map_skill("parry", "tiezhang-zhangfa");
  	prepare_skill("strike", "tiezhang-zhangfa");
 
        setup(); 
        carry_object("/clone/cloth/cloth")->wear();
      
        add_money("silver", 50);
}
#include "/quest/guanfu/npc/npc.h"
