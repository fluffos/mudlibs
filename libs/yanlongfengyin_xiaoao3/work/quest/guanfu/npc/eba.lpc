//  eba 恶霸
 
inherit NPC;
string random_name();
 
void create()
{
	int jibie;
	jibie = 500;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
	set_name("恶霸", ({"e ba"}));
//	set("nickname", "");
	set("long", 
        "一个危害一方的恶霸，强男霸女，无恶不做。\n");
	set("gender", "男性");
	set("age", random(20) + 25);
	set("attitude", "peaceful");
    set("shen_type", -1);	
	set("str", 25);
	set("int", 20);
	set("con", 25);
	set("dex", 27);
	
	set("max_qi", 1200);
	set("max_jing", 1200);
	set("neili", 1200);
	set("max_neili", 1200);
	set("jiali", 100);
	set("combat_exp", 380000 + random(300000)); 
	 
        set_skill("force", 500+jibie/3+random(jibie/5));
        set_skill("canhe-zhi", 500+jibie/3+random(jibie/5));
        set_skill("finger", 500+jibie/3+random(jibie/5));
        set_skill("shenyuan-gong", 500+jibie/3+random(jibie/5));
           set_skill("shaolin-shenfa", 500+jibie/3+random(jibie/5));
        set_skill("dodge", 500+jibie/3+random(jibie/5));
        set_skill("strike", 500+jibie/3+random(jibie/5));
        set_skill("sword", 500+jibie/3+random(jibie/5));
        set_skill("parry", 500+jibie/3+random(jibie/5));
        map_skill("force", "shenyuan-gong");
        map_skill("dodge", "shaolin-shenfa");
        map_skill("finger", "canhe-zhi");
  	map_skill("parry", "canhe-zhi");
 
        prepare_skill("finger", "canhe-zhi");
  	setup(); 
        carry_object("/clone/cloth/cloth")->wear();
  	add_money("silver", 50);
}
#include "/quest/guanfu/npc/npc.h"
