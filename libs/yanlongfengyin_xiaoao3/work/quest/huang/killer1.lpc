#include <ansi.h>
inherit NPC;
 
void create()
{
	int jibie;
	jibie = 120;
	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性	
    set("shen_type", -1);
	set_name("土匪", ({ "tu fei","fei"}));
	set("gender", "男性");
	set("age", 36);
	set("attitude", "peaceful");

	set("str", 28);
	set("int", 20);
	set("con", 25);
	set("dex", 27);
	
	set("max_qi", 1500);
	set("max_jing", 1500);
	set("neili", 1800);
	set("max_neili", 1800);
	set("jiali", 100);
	set("combat_exp", 800000); 
	set("chat_chance_combat", 100);
        set("chat_msg_combat", ({
                (: perform_action, "strike.diezhang" :),
         })); 
         set_skill("force", 500+jibie/3+random(jibie/5));
         set_skill("xuantian-wuji", 500+jibie/3+random(jibie/5));
         set_skill("dodge", 500+jibie/3+random(jibie/5));
  

        set_skill("kunlun-shenfa", 500+jibie/3+random(jibie/5));
        set_skill("strike", 500+jibie/3+random(jibie/5));
        set_skill("kunlun-zhang", 500+jibie/3+random(jibie/5));
        set_skill("parry", 500+jibie/3+random(jibie/5));
        set_skill("literate", 500+jibie/3+random(jibie/5));
        map_skill("force", "xuantian-wuji");
        map_skill("dodge", "kunlun-shnfa");
        map_skill("strike", "kunlun-zhang");
  	map_skill("parry", "kunlun-zhang");
        set_temp("apply/attack", 20);
        set_temp("apply/defense",50);
        set_temp("apply/armor", 50);
        set_temp("apply/damage", 220);
  	prepare_skill("strike", "kunlun-zhang");
 
        setup(); 
        carry_object("/clone/cloth/cloth")->wear();
        add_money("silver", 50);
}
#include "killer.h"
