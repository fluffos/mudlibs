//dbase.c
//增加兼容等级制升级算法 

#include <dbase.h>
inherit F_TREEMAP;

mapping dbase;
nosave mapping tmp_dbase;
nosave int exp_times = 1;
// The default_ob provides the default values of the dbase. It is set to
// be master copy of an object.
nosave mixed default_ob;

int get_levelup_exp();

mixed query_default_object()
{
	return default_ob;
}

void set_default_object(mixed ob)
{
	if( !geteuid() ) seteuid(getuid());

	default_ob = ob;
	ob->add("no_clean_up", 1);
}

mixed set(string prop, mixed data)
{
    if( !mapp(dbase) ) dbase = ([]);
    if( strsrch(prop, '/')!=-1 )
        return _set( dbase, explode(prop, "/"), data );
    return dbase[prop] = data;
}

varargs mixed query(string prop, int raw)
{
	mixed data;
	object ob;
	
	if( !mapp(dbase) )
		return 0;

	if ( prop == "combat_exp" && origin() != "local" ) 
	{
		ob = previous_object();
		if ( ob )
		{
			if ( sscanf(base_name(ob), "%*skungfu/skill/%*s") )
			{
				return (get_levelup_exp()/2*query("xyzx_sys/level"));
			}
			else if ( ob != this_object() )
				return get_levelup_exp();
		}

		/*tell_object(this_object(), "呼叫程式："+origin()+"\n");*/
	}
	
	if( undefinedp(dbase[prop]) && (strsrch(prop, '/')!=-1) ) 
		data = _query(dbase, explode(prop, "/"));
	else 
		data = dbase[prop];

	if( undefinedp(data) && default_ob ) data = default_ob->query(prop, 1);

	if( raw ) return data;

	return evaluate( data, this_object() );
}

int delete(string prop)
{
	if( !mapp(dbase) )
		return 0;
	
	if( strsrch(prop, '/')!=-1 )
		return _delete(dbase, explode(prop, "/"));
	else
	{
		map_delete(dbase, prop);
		return 1;
	}
}

//属性点的减少判定
void del_shuxingdian(object victim,int delsxd)
{
    int sxd,deled=0;
    int jz,lx,mj,fy,i;
    if(delsxd <= 0)
	return;
    sxd = victim->query("xyzx_sys/shuxingdian");
    lx = victim->query("xyzx_sys/lingxing",1);
    jz = victim->query("xyzx_sys/jingzhun",1);
    mj = victim->query("xyzx_sys/minjie",1);
    fy = victim->query("xyzx_sys/fanying",1);
    if(delsxd <= sxd)
    {
	victim->set("xyzx_sys/shuxingdian",sxd-delsxd);
	return;
    }
    else if(delsxd >= (sxd+lx+jz+mj+fy))
    {
	victim->set("xyzx_sys/shuxingdian",0);
	victim->set("xyzx_sys/lingxing",10);
	victim->set("xyzx_sys/jingzhun",10);
	victim->set("xyzx_sys/minjie",10);
	victim->set("xyzx_sys/fanying",10);
	return;
    }
    else
	victim->set("xyzx_sys/shuxingdian",0);
    delsxd -= sxd;
    i=0;
    deled = 0;
    while(delsxd>0)
    {
	delsxd--;
	i++;
	if(i%4==0)
	{
	    if(lx>0)
	    {
		lx--;
		continue;
	    }
	}
	if((i%4==1) || lx==0)
	{
	    if(jz>0)
	    {
		jz--;
		continue;
	    }
	}
	if((i%4==2) || jz==0)
	{
	    if(mj>0)
	    {
		mj--;
		continue;
	    }
	}
	if((i%4==3) || mj==0)
	{
	    if(fy>0)
	    {
		fy--;
		continue;
	    }
	}
	if(deled==0)	//四个属性均为0
	{
	    tell_object(victim,"error,should not go here!\n");
	    break;
	}
    }
    if(lx<10)
	lx=10;
    if(jz<10)
	jz=10;
    if(mj<10)
	mj=10;
    if(fy<10)
	fy=10;
    victim->set("xyzx_sys/lingxing",lx);
    victim->set("xyzx_sys/jingzhun",jz);
    victim->set("xyzx_sys/minjie",mj);
    victim->set("xyzx_sys/fanying",fy);
}

varargs mixed add(string prop, mixed data, int team)
{
	mixed old;
	string hy;
	int levup_exp,new_data,lvlupexp;
//	int osxd,nowlvl,addsxd,addjnd,getsxd,cjsxd;		//2016.6.5阿飞改，由于取消玩家升级的四维，所以这行定义无效了
	levup_exp = 0;
	new_data = 0;

	if( !mapp(dbase) || !(old = query(prop, 1)) ) return set(prop, data);
	if( functionp(old) ) error("dbase: add() - called on a function type property.\n");
	// 团队奖励共享分配
	if ( !team && TEAMD->query_team_share(this_object(), prop) )
	{
		TEAMD->team_add(this_object(), prop, data);
		return 1;
	}
	// 经验翻倍系统
	if ( prop == "combat_exp" )
	{
		if ( stringp(hy = query("xy_huiyuan")) && query("xyhy_type") == 2)
		{
			if ( sscanf(hy, "%*s年%*s月%*s日") )
			{
				if ( intp(data) && data > 0 )
				{
					data = data * XYZX_SYS_EXP_NUM;
				}
			}
		}
		else if ( intp(data) && data > 0 )
		{
			data = data * exp_times;
		}
	}
	//自动升级
	switch (prop)
	{
		case "combat_exp":
			if ( (new_data = old + data) >= LEVUP_EXP_START )
			{
				set("xyzx_sys/levup_exp", new_data - LEVUP_EXP_START + query("xyzx_sys/levup_exp", 1));
				set("combat_exp", LEVUP_EXP_START);
				// 等级提升
				lvlupexp = get_levelup_exp();
				if ( (levup_exp = query("xyzx_sys/levup_exp",1)) >= lvlupexp )
				{
					set("xyzx_sys/levup_exp", levup_exp - lvlupexp);
					//检查数据使之在设计范围内
					if ( query("xyzx_sys/levup_exp",1) > lvlupexp )
						set("xyzx_sys/levup_exp",lvlupexp);
					//等级提升
					set("xyzx_sys/level", query("xyzx_sys/level",1) + LEVEL_UP_NUM);
					//自动提升的级数
					set("xyzx_sys/auto_levup", query("xyzx_sys/auto_levup",1) + LEVEL_UP_NUM);
					tell_object(this_object(), HIG"你的"HIM"『 等 级 』"HIG"提升了！\n"NOR);
				//2016.5.20阿飞改，取消升级加点，以后升级不再提升四维属性，四维属性用于NPC调整
				/*	//等级提升增加的属性点
					//set("xyzx_sys/shuxingdian", query("xyzx_sys/shuxingdian",1) + LEVUP_SHUXD_NUM_ONE);
					// 等级每提升到被10、100、1000整除额外给属性点
					osxd = 0;
					getsxd = 0;
					nowlvl = query("xyzx_sys/level", 1);
					if ( nowlvl % 1000 == 0 ) osxd += 1000;
					else if ( nowlvl % 100 == 0 ) osxd += 200;
					else if ( nowlvl % 10 == 0 ) osxd += 50;
					if ( osxd > 0 )
					{
						getsxd = osxd / 10;
						osxd -= getsxd;
					}
					osxd += LEVUP_SHUXD_NUM_ONE;
					addsxd = osxd / 4;
					addjnd = osxd % 4;
					//检查数值，查看除以4是否为整数，如果不是，差数添加到 自由分配点数上 2015.10.24
					if (osxd - (addsxd * 4) != 0)
						cjsxd = osxd - (addsxd * 4);
					//精准提升
					set("xyzx_sys/jingzhun", query("xyzx_sys/jingzhun",1) + addsxd);
					//灵性提升
					set("xyzx_sys/lingxing", query("xyzx_sys/lingxing",1) + addsxd);
					//敏捷提升
					set("xyzx_sys/minjie", query("xyzx_sys/minjie",1) + addsxd);
					//反应提升
					set("xyzx_sys/fanying", query("xyzx_sys/fanying",1) + addsxd);
					// 技能点增加
					set("xyzx_sys/skill_dian", query("xyzx_sys/skill_dian",1) + addjnd);
					//传送升级信息给目标
					tell_object(this_object(), HIG"你的"HIM"『 等 级 』"HIG"提升了！\n" + 
					     // "增加 "HIY+chinese_number(addjnd)+" 点 "HIG"技能点。\n" + 
						HIG"你的精准提升了"+chinese_number(addsxd)+"点。\n" + 
						HIM"你的灵性提升了"+chinese_number(addsxd)+"点。\n" + 
						HIW"你的敏捷提升了"+chinese_number(addsxd)+"点。\n" + 
						HIC"你的反应提升了"+chinese_number(addsxd)+"点。\n"NOR);
					if ( getsxd > 0 )
					{
						set("xyzx_sys/shuxingdian", query("xyzx_sys/shuxingdian",1) + getsxd+cjsxd);
						tell_object(this_object(), HIY"你的属性点增加了"+chinese_number(getsxd+cjsxd)+"点。\n"NOR);
					}
					
					if ( osxd > 0 ) 
					{
						set("xyzx_sys/shuxingdian", query("xyzx_sys/shuxingdian",1) + osxd);
						tell_object(this_object(), HIG"你的"HIM"『 等 级 』"HIG"提升到了 "HIC
									+ chinese_number(nowlvl)+" 级 "HIG"！额外增加 "HIY
									+ chinese_number(osxd)+" 点 "HIG"属性点。\n"NOR);
					}*/
				}
			}
			else
				return set(prop, old + data);
			break;
		default:return set(prop, old + data);
	}
}

mapping query_entire_dbase()
{
    return dbase;
}

mixed set_temp(string prop, mixed data)
{
    if( !mapp(tmp_dbase) ) tmp_dbase = ([]);
    if( strsrch(prop, '/')!=-1 )
        return _set( tmp_dbase, explode(prop, "/"), data );
    return tmp_dbase[prop] = data;
}

varargs mixed query_temp(string prop, int raw)
{
    mixed data;

    if( !mapp(tmp_dbase) ) return 0;

    if( undefinedp(tmp_dbase[prop]) && strsrch(prop, '/') != -1 ) 
		data = _query(tmp_dbase, explode(prop, "/"));
    else
        data = tmp_dbase[prop];
    
	if( functionp(data) && !raw )
        return (*data)( this_object() );
    else 
        return data;
}
int delete_temp(string prop)
{
    if( !mapp(tmp_dbase) ) return 0;
    if( strsrch(prop, '/')!=-1 )
        return _delete(tmp_dbase, explode(prop, "/"));
    else {
        map_delete(tmp_dbase, prop);
        return 1;
    }
}

mixed add_temp(string prop, mixed data)
{
    mixed old;
    if( !mapp(tmp_dbase) || !(old = query_temp(prop, 1)) )
        return set_temp(prop, data);
    if( functionp(old) )
        error("dbase: add_temp() - called on a function type property.\n");
    return set_temp(prop, old + data);
}

mapping query_entire_temp_dbase()
{
    return tmp_dbase;
}

int query_exp_times()
{
	if ( stringp(query("xy_huiyuan")) 
		&& query("xyhy_type") == 2 )
		return XYZX_SYS_EXP_NUM;

	return exp_times;
}

void set_exp_times()
{
	object me;

	me = this_object();

	// 设置双倍奖励
	if ( time() < me->query("exp_jiacheng") 
		|| (me->query("xy_huiyuan") 
			//&& me->query("xyhy_type")  //普通会员也可以享受晚上的系统双倍了2015.10.6
			&& atoi(CHINESE_D->chinese_time(9,ctime(time()))) > 19) )
	{
		if ( interactive(me) )
			me->add("biguan_is_online", 1); // 离线时间增加加速
		exp_times = XYZX_SYS_EXP_NUM; // 设置双倍标识
	}
	else
		exp_times = 1;
}

int get_levelup_exp()
{
	object me = this_object();
	int lvl = me->query("xyzx_sys/level");
	int lvlupexp = (lvl + 1) * LEVUP_EXP;

	/*if ( 2100000000 / LEVUP_EXP <= lvl ) 
		return 2100000000;*/

	return lvlupexp;
}