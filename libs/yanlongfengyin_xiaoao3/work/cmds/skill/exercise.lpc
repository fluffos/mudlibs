// exercise.c	//打坐

#include <skill.h>
inherit F_CLEAN_UP;
int exercising(object me);
int halt_exercise(object me);
string *order = ({""HIY"", ""HIG"", ""RED"", ""MAG"", ""YEL"", ""HIC"", ""HIW"", ""HIR"",""HIB"", ""CYN"",""WHT"",""HIM"",""BLU""});

int main(object me, string arg)
{
	mapping msg;
	string force_skill=me->query_skill_mapped("force");
	int exercise_cost;
	object where;
	seteuid(getuid());
	where = environment(me);
	if ((int)me->query_skill("force",1)<100)
		return notify_fail("你还是先学些呼吸心法的技巧！\n");
	if (where->query("pigging"))
		return notify_fail("你还是专心拱猪吧！\n");
	if (me->is_busy() || me->query_temp("pending/exercise"))
		return notify_fail("你现在正忙着呢。\n");
	if ( me->query_temp("cooldown") )	//CD写法	2017.9.7添加
		return notify_fail("你处于技能冷却状态中，休息一会吧。\n");
    if( environment(me)->query("no_fight") )
        return notify_fail("这里是是非之地，不可久留，别练功了，快走吧！\n");
	if( me->is_fighting() )
		return notify_fail("战斗中不能练内功，会走火入魔。\n");
	if( !arg || !sscanf(arg, "%d", exercise_cost))
		return notify_fail("你要花多少气练功？\n");
	if (exercise_cost < 10)
		return notify_fail("你的内功还没有达到那个境界！\n");
	if( (int)me->query("qi") < exercise_cost )
		return notify_fail("你现在的气太少了，无法产生内息运行全身经脉。\n");
	if( (int)me->query("jing") * 100 / (int)me->query("max_jing") < 70 )
		return notify_fail("你现在精不够，无法控制内息的流动！\n");
//2018.2.6阿飞改，换成那种花样打坐方式	
	if (force_skill && msg = SKILL_D(force_skill)->exercise_msg(me)) 
	{
		write((order[random(13)])+("\n你"+msg["status_msg"])+ NOR);
		write((order[random(13)])+("\n你"+msg["start_my_msg"])+ NOR);
		message_vision((order[random(13)])+(msg["start_other_msg"]) + NOR,environment(me), ({me}));
	} else  
	{
		write(HIR"你坐下来运气用功，一股"HIW"内息"HIR"开始在体内流动。\n"NOR);
		message_vision(me->name()+"盘膝坐下，开始修炼内力。\n",environment(me),({me}));
	}
//	write(HIR"你坐下来运气用功，一股"HIW"内息"HIR"开始在体内流动。\n"NOR);	//换成那种花样打坐方式
//	message("vision",me->name()+"盘膝坐下，开始修炼内力。\n",environment(me),({me}));
	me->set_temp("pending/exercise", 1);
	me->set_temp("exercise_cost", exercise_cost);
	me->start_busy((: exercising :), (:halt_exercise:));
	return 1;
}
int exercising(object me)
{
	mapping msg;
	string force_skill=me->query_skill_mapped("force");
	int exercise_cost = (int)me->query_temp("exercise_cost");
    int neili_gain = (int)me->query_skill("force",1) + me->query_skill(force_skill,1);
	int level,jibenforce,teshuforce,flag,addtime;
	int huiyuan;
	object where=environment(me);
    //if (!interactive(me) && !me->query("lixian/biguan") && playerp(me) ) return 0; // 解决npc无法打坐恢复内力
	flag = (int)me->query_skill(force_skill, 1)/1000;
	if ( flag < 1 ) flag = 1;
	if ( flag > 5 ) flag = 5;
	if(me->query("xyhy_type")==2) huiyuan = 5/4;	//黄金会员打坐增加技能熟练度1.25倍
		else huiyuan = 1;
	if ( me->query_exp_times() > 1 ) addtime = 2;
		else addtime = 1;
	if (exercise_cost < 1) return 0;
    if (exercise_cost < neili_gain) neili_gain = exercise_cost;
	if (exercise_cost>2*neili_gain) neili_gain = exercise_cost/2;
	if ((int)me->query("neili") < (int)me->query("max_neili") * 2)
	me->add("neili", neili_gain);
	me->set_temp("exercise_cost", exercise_cost -= neili_gain);
	if(where->query("xuanbing")) me->add("qi", (int)neili_gain/5);
    if(where->query("hanyuchuang")) me->add("qi", (int)neili_gain/4);   
	me->add("qi", -neili_gain);
	if (exercise_cost > 0) return 1;
	
	level = (int)me->query("xyzx_sys/level");
	jibenforce = (int)me->query_skill("force",1);
	teshuforce = (int)me->query_skill(force_skill,1);	
	me->set_temp("pending/exercise", 0);
//	exercise_cost = 0;	
//2018.2.6阿飞改，换成那种花样打坐方式	
	if (force_skill && msg = SKILL_D(force_skill)->exercise_msg(me)) 
	{
		write((order[random(13)])+ ("\n你" + msg["end_my_msg"])+ NOR);
		if (!me->query("env/no_fight_msg"))
		{
			message_vision((order[random(13)])+(msg["end_other_msg"]) + NOR,environment(me), me);
			tell_object(me, HIY"你运功完毕，深深吸了口气，站了起来。\n"NOR);
		} else 
		{
			tell_object(me, HIY"你运功完毕，深深吸了口气，站了起来。\n"NOR);	
		}		
	} else  
	{
		if (!me->query("env/no_fight_msg")) message_vision(HIY"$N运功完毕，深深吸了口气，站了起来。\n"NOR, me);
		else tell_object(me, HIY"你运功完毕，深深吸了口气，站了起来。\n"NOR);
	}	
//	message_vision(HIY"$N运功完毕，深深吸了口气，站了起来。\n"NOR, me);	//2018.2.6阿飞改，换成那种花样打坐方式
	if (me->query_skill_mapped("force") && teshuforce<jibenforce && teshuforce<(level+300)*2) 
		me->improve_skill(force_skill, me->query_con()*addtime*flag*huiyuan*me->query("con",1)/500+10, 0);
    if (jibenforce<(level+300)*4) 
		me->improve_skill("force", me->query_con()*addtime*flag*huiyuan*me->query("con",1)/500+10, 0);
	if ((int)me->query("neili") < (int)me->query("max_neili") * 2) return 0;
	else 
	{
		if ((int)me->query("max_neili") > ( me->query_skill("force",1) + me->query_skill(force_skill,1) + 100)*2000 ) 			
		{
			write("你的内力修为似乎已经达到了瓶颈。\n");
			me->set("neili", (int)me->query("max_neili")*2);	
			return 0;
		} 
		else 
		{
			me->add("max_neili",100+random(me->query("con",1))*50+random(me->query_skill("force")/20));
			me->set("neili", (int)me->query("max_neili"));
			write(HIW"你的内力增加了！！\n"NOR);
			return 0;
		}
	}
}
int halt_exercise(object me)
{
	if ((int)me->query("neili") > (int)me->query("max_neili") * 2)
	me->set("neili", (int)me->query("max_neili") * 2);
	me->set_temp("pending/exercise", 0);
	return 1;
}
int help(object me)
{
        write(@HELP
指令格式 : exercise [<耗费「气」的量> 必须多于 10]
运气练功，控制体内的气在各经脉间流动，藉以训练人体肌肉骨骼的耐
力、爆发力，并且用内力的形式将能量储备下来。
HELP
        );
        return 1;
}
