// xiao_tufei.c
inherit NPC;
void create()
{
	int jibie;
	jibie = 100;
	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性
        set_name("小土匪", ({
"xiao tufei", "tufei"}));
        set("gender", "男性" );
        set("age", 22);
        set("long", "这是个胆大包天的小土匪，杀人越或货，无恶不做。\n");
        set_temp("apply/attack", 15);
        set_temp("apply/defense", 15);
        set("combat_exp", 750);
    set("shen", -150);
        set("str", 25);
        set("dex", 20);
        set("con", 18);
        set("int", 15);
        set("attitude","aggressive");
        setup();
        carry_object("/clone/cloth/cloth")->wear();
        add_money("coin", 30);
}
