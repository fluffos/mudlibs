// daobaifeng.c 刀白凤

#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create()
{
	int jibie;
	jibie = 2000;
//	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性	
	set("xyzx_sys/level", jibie);	//2017.9.1阿飞调整NPC等级为固定值，取消20%的浮动设定	
	set_name("刀白凤", ( { "dao baifeng", "dao" }));
	set("title",  "大理国王妃" );
	set("long", "她就是大理国的王妃，白族美女。\n");
	set("gender", "女性");
	set("age", 45);
	set("attitude", "peaceful");
	set("shen_type", 1);
	set("str", 30);
	set("int", 30);
	set("con", 35);
	set("dex", 30);

	set("max_qi", 5200);
	set("max_jing", 600);
	set("neili", 62000);
	set("max_neili", 2000);
	set("jiali", 2000);
	set("combat_exp", 7000000);

	set_skill("force", 500+jibie/3+random(jibie/5));             // 基本内功
	set_skill("kumu-shengong", 500+jibie/3+random(jibie/5));
	set_skill("tiannan-step", 500+jibie/3+random(jibie/5));
	set_skill("wuluo-zhang", 500+jibie/3+random(jibie/5));
	set_skill("feifeng-whip", 500+jibie/3+random(jibie/5));
	set_skill("duanjia-sword", 500+jibie/3+random(jibie/5));
	set_skill("whip", 500+jibie/3+random(jibie/5));
	set_skill("sword", 500+jibie/3+random(jibie/5));
	set_skill("jinyu-quan", 500+jibie/3+random(jibie/5));
	set_skill("unarmed", 500+jibie/3+random(jibie/5));           // 基本拳脚
	set_skill("dodge", 500+jibie/3+random(jibie/5));             // 基本躲闪
	set_skill("parry", 500+jibie/3+random(jibie/5));             // 基本招架
	set_skill("literate",500+jibie/3+random(jibie/5));           // 读书识字

	map_skill("sword"  , "duanjia-sword");
	map_skill("force"  , "kumu-shengong");
	map_skill("unarmed", "wuluo-zhang");
	map_skill("dodge"  , "tiannan-step");
	map_skill("parry"  , "wuluo-zhang");
	map_skill("whip"  , "feifeng-whip");

	setup();
	carry_object("/d/gumu/obj/yinsuo")->wield();
	carry_object("/clone/weapon/gangjian")->wield();
	carry_object("/clone/cloth/cloth")->wear();
	add_money("silver", 50);

	create_family("大理段家",18,"王妃");
}



void attempt_apprentice(object ob)
{
	string oldtitle;
	oldtitle = ob->query("title");
	if ((int)ob->query("shen") < 10000  )
	{
		command("say 我大理段氏向来行侠仗义，您请回吧！");
		return;
	}
	if ((int)ob->query_skill("kumu-shengong",1) < 300 )
	{
		command("say 你的本门内功心法太低了,还是努努力先提高一下吧!");
		return;
	}
	if (ob->query("gender")!="女性" )
	{
		command("say 我只收女弟子，你去找段郎试试吧!");
		return;
	}
	if ((int)ob->query("per", 1) < 25)
	{
		command("say 我家誉儿玉树临风，你恐怕配不上他!");
		return;
	}
	if ((int)ob->query("int", 1) < 30)
	{
		command("say 不是聪慧之人，如何能配得上我家誉儿!");
		return;
	}	
	if ((int)ob->query("dex", 1) < 30)
	{
		command("say 身法差了可学不会大理绝学！");
		return;
	}
		command("nod");
		command("say " + RANK_D->query_respect(ob) + "资质不错，或许能与我家誉儿结为一对 ！\n");
		command("recruit " + ob->query("id") );
	return;
}
