#include <room.h>
#include <ansi.h>

inherit ROOM;


void create() {
  set("short", "五级副本");
  set("long", @LONG
    这里就是冥府的入口处，再往前就是地狱了，但觉到处阴森恐怖,
令人脊背阵阵发麻，汗毛直竖。
LONG);
  set("no_fight", "1");
  set("no_steal", "1");
  set("no_sleep_room", "1");
  set("exits", ([
    "east": "/d/automap5/fuben" + (1 + random(300)),
  ]));
  //	set("no_clean_up", 0);
  setup();
}
int valid_leave(object me, string dir) {
  object *inv;
  int sizeinv;

  if (dir == "east") {
    if (me->query("xyzx_sys/level") < 5000)
      return notify_fail(HIC "就平你这点微末功夫不是去送死吗！\n" NOR);
    if (present("buzhen xiang", me))
      return notify_fail("你带着布阵箱进冥府想做什么？\n");
    inv = all_inventory(me);
    sizeinv = sizeof(inv);

    while (sizeinv--) {
      if (inv[sizeinv]->is_character())
        return notify_fail(HIG "你想给里面的怪物送点心去？\n" NOR);
    }
  }

  return ::valid_leave(me, dir);
}
