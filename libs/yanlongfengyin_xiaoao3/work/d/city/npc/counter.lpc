int accept_fight(object me)
{
        command("grin");
		command("say 后生可畏！");
        command("say 我的剑是用来杀人的，不是用来比划着玩的！");
        return 0;
}


int accept_ansuan(object who)
{
	object me=this_player();
	message_vision("$N刚想暗算，可是眼前一花，看不太清楚。\n",this_object(), who);
	me->kill_ob(who);
	return 1;
}

string ask_rename()
{
	object ob=this_player();
    write("我这儿可以打造以下兵器：\n"+
          "     剑(jian)\n"+
          "     刀(dao)\n"+
          "     棍(gun)\n"+
          "     杖(staff)\n"+
          "     鞭(whip)\n");       
    return "这位"+RANK_D->query_respect(ob)+"要造什么兵器？决定了告诉我(rename)。\n";
}

string ask_suit()
{
	object ob=this_player();
    write("我可以帮玩家免费更换儒风套装附加的门派内功技能。\n");       
    return "这位"+RANK_D->query_respect(ob)+"将你要更换套装技能的装备给我看看(show)。\n";
}


 void init()
{
        ::init();
        add_action("do_zhu","rename");
		add_action("do_show","show");
		add_action("do_change","change");
		add_action("do_killing", "kill");
}

int do_show(string arg)
{
	object obj, me;
	string suit_name;
	me = this_player();
	
	if (! arg)
		return notify_fail("你要亮出什么东西？\n");
	
	if ( !objectp(obj = present(arg, me)) )
		return notify_fail("你身上没有这种东西。\n");
	
	if (obj->query("equipped"))
		return notify_fail("你先解除" + obj->name() + "的装备再说！\n");
	
	if (obj->query("taozhuang") !=4)
		return notify_fail("我只能为儒风套装更换技能。\n");	
	suit_name = obj->query("id");
    	
	command("say 好东西，你可以更改该套装技能，请用指令格式：change 套装 to 内功。");	
	me->set_temp("suit_change", suit_name);
	obj->delete("suit_eff_skill");

	return 1;
	
}

int do_change(string arg)
{
    object me, ob;
	string gem, suit_skill;
    me = this_player();	
	
	if (!arg || arg == "")
		return notify_fail("指令格式：change 套装 to 内功\n");
	if (sscanf(arg, "%s to %s", gem, suit_skill) != 2)
		return notify_fail("指令格式：change 套装 to 内功\n");	
	if (!objectp(ob = present(gem, me)))
		return notify_fail("你想更改什么装备？\n");
	if (gem != me->query_temp("suit_change")) 
		return notify_fail("你想更改的装备不对！\n");	
	if (!me->query_temp("suit_change"))
		return notify_fail("你未获得天神允许！\n");	
	if (ob->query("taozhuang") !=4)
		return notify_fail("这不是儒风套装呢！\n");		
	if (ob->query("equipped"))
		return notify_fail(ob->name() + "正装备着呢！\n");		
	
	if (suit_skill=="hamagong")
	{
		message_vision(HIM"哈哈，成功！蛤蟆功。\n"NOR, me);
		ob->set("suit_eff_skill/hamagong", 1000);
		me->delete_temp("suit_change");
	}
	else if (suit_skill=="bitao-shengong")	
	{
		message_vision(HIM"哈哈，成功！碧涛神功。\n"NOR, me);
		ob->set("suit_eff_skill/bitao-shengong", 1000);
		me->delete_temp("suit_change");
	}
