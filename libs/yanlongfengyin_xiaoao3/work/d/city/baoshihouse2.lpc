private string* colors=({HIR,HIB,HIG,HIC,HIY,HIM,YEL});
void create()
{
    set("short","宝石仓库");
    set("long","这里是免费存放宝石的仓库，仓库的一面墙上贴着一张告示("HIW"gaoshi"NOR")\n");
    set("no_fight",1);
    set("no_steal",1);
    set("no_magic",1);
    set("no_sleep_room", "1");
    set("exits", ([
        "south" : __DIR__"openmarket",
      ]));

    set("item_desc", ([
                "gaoshi": @TEXT
                查看自己的宝石：list、cha、check、查

                存货：cun、存
                        存入全部：cun all
                        存入一个：cun 宝石中文/英文名

                取货：qu、取
                        qu 宝石中文/英文名,如要取8个佛之光宝石：qu 佛之光 或者 qu gods light
                        取绑定的宝石用qub命令。

                转存：zhuan、转         将旧仓库的的宝石转存到这里。


TEXT
                ]) );
    setup();
}

void init()
{
    add_action("do_list","list");
    add_action("do_list","cha");
    add_action("do_list","check");
    add_action("do_list","查");
    add_action("do_cun","cun");
    add_action("do_cun","存");
    add_action("do_qu","qu");
    add_action("do_qub","qub");
    add_action("do_qu","取");
    add_action("do_zhuan","zhuan");
    add_action("do_zhuan","转");
}

int do_list(string arg)
{
    object me = this_player();
    string myid = me->query("id");
    string who="你";
    object saver;
    int* baoshis;
    int* baoshis_bind;
//    string name;	//2017.3.7阿飞记录  服务器测试有问题，该值没有定义
    int i;
    string filename,tmp;

    if(arg && sizeof(arg)>0 && wizardp(me))
    {
        if(file_size("/data/baoshi/"+arg[0..0]+"/"+arg+__SAVE_EXTENSION__)>0)
        {
            myid=arg;
            who = arg;
        }
        else
        {
            write(arg+"没在仓库里放东西。\n");
            return 1;
        }
    }

    filename = "/data/baoshi/"+myid[0..0]+"/"+myid+__SAVE_EXTENSION__;

    if(file_size(filename) == -1)
    {
        printf("你没在仓库里存放任何东西。\n");
        return 1;
    }
    saver = new(SAVER);
    if(!saver || !objectp(saver))
    {
        write(HIW"物件仓库创建失败。\n");
        return 1;
    }
    saver->do_load(filename);
    write(HIY+who+"的宝石清单：\n\n"NOR);
    baoshis = saver->get_baoshi_data();
    baoshis_bind = saver->get_baoshi_bind_data();
    for(i=0;i<BAOSHI_COUNT;i++)
    {
        tmp = colors[i%7]+baoshi_names[i]+"宝石";
        tmp += "\t\t";
        if(i<7) tmp+="\t";
        tmp+="绑定：";
        tmp+=sprintf("%8d",baoshis_bind[i]);
        tmp+="颗\t\t未绑定：";
        tmp+=sprintf("%8d颗\n"NOR,baoshis[i]);
        write(tmp);
    }
    destruct(saver);
    return 1;
}

object query_present(string name)
{
    object me = this_player();
    object obj = present(name,me);
    object *objs;
    string bn;
    int i;
    if(objectp(obj))
    {
        bn = base_name(obj);
        if(strsrch(bn,"/quest/baoshi/baoshis/")==0 && obj->id("baoshi"))
            return obj;
    }
    objs = all_inventory(me);
    for(i=0;i<sizeof(objs);i++)
    {
        obj = objs[i];
        bn = base_name(obj);
//        if(!obj->id("baoshi"))
//            continue;
        if(strsrch(bn,"/quest/baoshi/baoshis/")!=0)
            continue;
        if(obj->id(name) || filter_color(obj->query("name"))==name)
            return obj;
        if(obj->id(name+" baoshi") || filter_color(obj->query("name"))==(name+"宝石"))
            return obj;
    }
    return 0;
}

int save_all_baoshi(object saver)
{
    object me = this_player();
    object obj;
    object *objs = all_inventory(me);
    int index,i;
    int *baoshis = saver->get_baoshi_data();
    int *baoshis_bind = saver->get_baoshi_bind_data();
    string bn;
    for(i=0;i<sizeof(objs);i++)
    {
        obj = objs[i];
        bn = base_name(obj);
//        if(!obj->id("baoshi"))
//            continue;
        if(strsrch(bn,"/quest/baoshi/baoshis/")!=0)
            continue;
        index=obj->query("b_lvl")-1;
        if(index<0||index>34)
            continue;
        if(obj->query("bind_master_level/"+me->query("id")))
            baoshis_bind[index]++;
        else
            baoshis[index]++;
        write("你存入一颗"+obj->query("name")+NOR"\n");
        destruct(obj);
    }
    return 1;
}

int save_baoshi(object saver,string arg)
{
    object obj = query_present(arg);
    object me = this_player();
    int index;
    int *baoshis = saver->get_baoshi_data();
    int *baoshis_bind = saver->get_baoshi_bind_data();
    if(!objectp(obj))
    {
        write("你身上没有这个东西。\n");
        return 0;
    }
    index = obj->query("b_lvl")-1;
    if(index <0 || index > 34)
    {
        write("这这这是什么东西，哪捡的，快报告巫师。\n");
        return 0;
    }
    if(obj->query("bind_master_level/"+me->query("id")))
        baoshis_bind[index]++;
    else
        baoshis[index]++;
    write("你存入一颗"+obj->query("name")+NOR"\n");
    destruct(obj);
    return 1;
}

int do_cun(string arg)
{
    object me = this_player();
    string myid = me->query("id");
    object saver;
    string filename = "/data/baoshi/"+myid[0..0]+"/"+myid+__SAVE_EXTENSION__;
    int ret=0;

    if(!arg || arg == "")
    {
        write("使用方法请look gaoshi\n");
        return 1;
    }

    saver = new(SAVER);
    if(!saver || !objectp(saver))
    {
        write(HIW"物件仓库创建失败。\n");
        return 1;
    }
    if(file_size("/data/baoshi") != -2) mkdir("/data/baoshi");
    if(file_size("/data/baoshi/"+myid[0..0]) != -2)
        mkdir("/data/baoshi/"+myid[0..0]);
    saver->do_load(filename);
    if(arg == "all")
        ret = save_all_baoshi(saver);
    else
        ret = save_baoshi(saver,arg);
    if(ret)
        saver->do_save(filename);
    destruct(saver);
    return 1;
    
}

int get_baoshi_idx(string baoshi_name)
{
    int i=0;
    for(i=0;i<BAOSHI_COUNT;i++)
    {
        if(strsrch(baoshi_names[i],baoshi_name)==0)
            return i;
        if(strsrch(baoshi_ids[i],baoshi_name)==0)
            return i;
    }
    return -1;
}

int qu_baoshi(string name,int isbind)
{
    int idx;
    int *baoshis;
    int *baoshis_bind;
    int count;
    object me = this_player();
    string myid = me->query("id");
    object obj,saver;
    string filename = "/data/baoshi/"+myid[0..0]+"/"+myid+__SAVE_EXTENSION__;
    if(file_size(filename)==-1)
    {
        write("仓库里没有任何东西。\n");
        return 1;
    }
    idx = get_baoshi_idx(name);
    if(idx == -1)
    {
        write("没有这种宝石。\n");
        return 1;
    }
    saver = new(SAVER);
    if(!saver || !objectp(saver))
    {
        write(HIW"物件仓库创建失败。\n");
        return 1;
    }
    saver->do_load(filename);
    baoshis = saver->get_baoshi_data();
    baoshis_bind = saver->get_baoshi_bind_data();
    if(isbind>0)
        count = baoshis_bind[idx];
    else
        count = baoshis[idx];
    do
    {
        if(count==0)
        {
            write("仓库里没有这种宝石。\n");
            break;
        }
        obj = new("/quest/baoshi/baoshis/"+baoshi_ids[idx]);
        if(!objectp(obj))
        {
            write("宝石克隆失败。\n");
            break;
        }
        if(me->query_encumbrance()+obj->weight() > me->query_max_encumbrance())
        {
            write("你身上的东西太多了。\n");
            destruct(obj);
            obj=0;
            break;
        }
        if(isbind>0)
            obj->set("xyzx_sys/bind_type",2);
        obj->move(me);
        if(isbind>0)
            baoshis_bind[idx]--;
        else
            baoshis[idx]--;
        saver->do_save(filename);
        write("你从仓库里取出一颗"+obj->query("name")+"\n"NOR);
    }while(0);
    destruct(saver);
    return 1;
}

int do_qu(string arg)
{
//    string bsname="";	//2017.3.7阿飞记录  服务器测试有问题，该值没有定义
//    object me = this_player();	//2017.3.7阿飞记录  服务器测试有问题，该值没有定义
    if(!arg || arg == "")
    {
        write("使用方法请look gaoshi\n");
        return 1;
    }
    qu_baoshi(arg,0);
    return 1;
}

int do_qub(string arg)
{
//    string bsname="";	//2017.3.7阿飞记录  服务器测试有问题，该值没有定义
//    object me = this_player();	//2017.3.7阿飞记录  服务器测试有问题，该值没有定义
    if(!arg || arg == "")
    {
        write("使用方法请look gaoshi\n");
        return 1;
    }
    qu_baoshi(arg,1);
    return 1;
}

int do_zhuan(string arg)
{
    object me = this_player();
    int i,a,b;
    int* baoshis;
    int* baoshis_bind;
    int ok=0;
    object saver;
    string myid = me->query("id");
    string filename = "/data/baoshi/"+myid[0..0]+"/"+myid+__SAVE_EXTENSION__;
    if(!me->query("baoshi_size") && !me->query("baoshi_size_bind"))
    {
        write("旧仓库里没有你的宝石。\n");
        return 1;
    }
    saver = new(SAVER);
    if(!saver || !objectp(saver))
    {
        write(HIW"物件仓库创建失败。\n");
        return 1;
    }
    if(file_size("/data/baoshi") != -2) mkdir("/data/baoshi");
    if(file_size("/data/baoshi/"+myid[0..0]) != -2)
        mkdir("/data/baoshi/"+myid[0..0]);
    saver->do_load(filename);
    baoshis = saver->get_baoshi_data();
    baoshis_bind = saver->get_baoshi_bind_data();
    for(i=0;i<BAOSHI_COUNT;i++)
    {
        a = me->query("baoshi_save/"+baoshi_ids[i]);
        b = me->query("baoshi_save_bind/"+baoshi_ids[i]);
        if(a == 0 && b == 0)
            continue;
        ok=1;
        if(a>0)
            baoshis[i]+=a;
        if(b>0)
            baoshis_bind[i]+=b;
        printf(colors[i%7]+baoshi_names[i]+"宝石"NOR"转存成功，绑定的：%d颗，未绑定的%d颗\n",b,a);
    }
    if(ok)
        saver->do_save(filename);
    else
        write("旧仓库里没有你的宝石。\n");
    me->delete("baoshi_size");
    me->delete("baoshi_save");
    me->delete("baoshi_size_bind");
    me->delete("baoshi_save_bind");
    destruct(saver);
    return 1;
}

