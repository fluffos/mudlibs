// chaer.c 茶博士

inherit NPC;

void create()
{
	int jibie;
	jibie = 100;
	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性
//  reload("gaoli_cha");
  set_name("茶博士", ({"cha boshi", "cha", "boshi"}));
  set("gender", "男性");
  set("combat_exp", 3000);
  set("age", 38);
  set("per", 29);
  set("attitude", "friendly");
  set("shen_type", 1);
  set_skill("unarmed", 10);
  set_skill("dodge", 40);
  set_skill("parry", 30);
 setup();
  carry_object("/clone/cloth/cloth")->wear();
}

