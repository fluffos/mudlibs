// girl.女子。

inherit NPC;

void create() {
  int jibie;
  jibie = 100;
  set("xyzx_sys/level", jibie * 8 / 10 + random(jibie * 4 / 10));  //2016.5.22阿飞调整NPC属性
  set_name("水手", ({ "shui shou", "shui", "shou" }));
  set("long", "这是在战船上工作的一个水手。\n");
  set("gender", "男性");
  set("combat_exp", 20000);
  set("age", 18);
  set("attitude", "peaceful");
  set_skill("unarmed", 10);
  set_skill("dodge", 40);
  set_skill("parry", 30);
  setup();
  carry_object("/d/gaoli/obj/sengyi")->wear();
}
