inherit NPC;
void create() {
  int jibie;
  jibie = 100;
  set("xyzx_sys/level", jibie * 8 / 10 + random(jibie * 4 / 10));  //2016.5.22阿飞调整NPC属性
  set_name("李萍", ({ "li ping" }));
  set("gender", "女性");
  set("long", "郭靖的母亲,流落在蒙古!\n");
  set("score", 5000);
  set("combat_exp", 60000);

  set("per", 30);
  set("age", 43);
  set("kee", 800);
  set("max_kee", 800);
  set("food", 250);
  set("water", 250);
  set("force", 300);
  set("max_force", 300);
  set("force_factor", 10);

  set_skill("dodge", 20);
  set_skill("force", 20);
  set_skill("parry", 20);
  set_skill("unarmed", 20);
  set_skill("whip", 20);

  setup();
  add_money("silver", 5);
  carry_object("clone/cloth/cloth")->wear();
}
