inherit NPC;

void create() {
  int jibie;
  jibie = 100;
  set("xyzx_sys/level", jibie * 8 / 10 + random(jibie * 4 / 10));  //2016.5.22????NPC??
  set_name("太监", ({ "tai jian", "tai", "jian" }));
  set("gender", "无性");
  set("age", 15 + random(60));

  set("combat_exp", 5000);
  set("shen_type", 0);

  set_skill("unarmed", 30);
  set_skill("blade", 40);
  set_skill("parry", 30);
  set_skill("dodge", 30);

  set_temp("apply/attack", 15);
  set_temp("apply/defense", 15);
  set_temp("apply/damage", 20);

  setup();
  add_money("silver", random(10));
  carry_object("d/huanggong/obj/taijianfu")->wear();
}
