//wuming.c  by:pipip
inherit NPC;
inherit F_MASTER;
#include <ansi.h>

int ask_xuanhuan();

void create() {
  int jibie;
  jibie = 8000;
  //	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性
  set("xyzx_sys/level", jibie);  //2017.9.1阿飞调整NPC等级为固定值，取消20%的浮动设定	
  set_name("无名老人", ({ "wuming laoren", "wuming", "laoren" }));
  set("gender", "男性");
  set("age", 55);
  set("long", "失去记忆的武林前辈奇人，曾经以一柄短刀连败正派四十九位高手。\n");
  set("attitude", "peaceful");
  set("shen_type", 0);
  set("str", 130);
  set("int", 60);
  set("con", 70);
  set("dex", 70);
  set("max_qi", 1200000);
  set("max_jing", 700000);
  set("jing", 700000);
  set("neili", 1500000);
  set("max_neili", 200000);
  set("jiali", 1800);
  set("combat_exp", 160000000);
  set("score", 20);
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("taoism", 500 + jibie / 3 + random(jibie / 5));
  set_skill("qimen-wuxing", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("art", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("blade", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie * 2 + random(jibie / 5));
  // set_skill("yijing-force",500+jibie/3+random(jibie/5));  2016.5.26阿飞改，灵元心法改为玄天派内功
  set_skill("lingyuan-xinfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("lingyunbu", 500 + jibie / 3 + random(jibie / 5));
  set_skill("cuixin-zhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("tianxin-blade", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "lingyuan-xinfa");
  map_skill("dodge", "lingyunbu");
  map_skill("parry", "cuixin-zhang");
  map_skill("unarmed", "cuixin-zhang");
  map_skill("blade", "tianxin-blade");
  create_family("玄天派", 1, "开山祖师");

  set("inquiry", ([
    "玄幻一斩": (: ask_xuanhuan :),
  ]));
  set("chat_chance", 2);
  set("chat_msg", ({
    "无名老人低声叹道：我到底是谁.....\n",
    "无名老人迷惑的望着你，他那一对蕴藏精光而又充满迷惑的眼睛使你觉得很不舒服。\n",
    "无名老人叹了口气道：真儿悟性体质都是上等之选，可惜戾气过重....\n",
  }));
  setup();
  carry_object("/d/xuantian/obj/cloth")->wear();
  carry_object("/d/xuantian/obj/xblade")->wield();
}

void attempt_apprentice(object ob) {
  if ((int)ob->query("xyzx_sys/level") < 1000) {
    command("say 这位" + RANK_D->query_respect(ob) + "实战能力太差了，还是去江湖上历练吧。");
    command("say 是否应该去江湖中多加磨炼。");
    return;
  }
  if ((int)ob->query_skill("dodge", 1) < 1000) {
    command("shake");
    command("say " + RANK_D->query_respect(ob) + "的轻功身法还不够矫健。");
    return;
  }
  if ((int)ob->query_skill("force", 1) < 1000) {
    command("shake");
    command("say " + RANK_D->query_respect(ob) + "的内功底子还没打好。");
    return;
  }
  if ((int)ob->query_skill("qimen-wuxing", 1) < 1000) {
    command("shake");
    command("say " + RANK_D->query_respect(ob) + "对易经五行之理还领悟的不够啊。");
    return;
  }
  if ((int)ob->query_skill("art", 1) < 1000) {
    command("shake");
    command("say " + RANK_D->query_respect(ob) + "对琴棋书画的技巧还不纯熟。");
    return;
  }
  if ((int)ob->query_skill("lingyuan-xinfa", 1) < 1000) {
    command("shake");
    command("say " + RANK_D->query_respect(ob) + "对灵元心法的领悟还不纯熟。");
    return;
  }
  if ((int)ob->query_skill("unarmed", 1) < 1000) {
    command("shake");
    command("say " + RANK_D->query_respect(ob) + "似乎还没掌握拳脚功夫的要领。");
    return;
  }
  if ((int)ob->query_skill("blade", 1) < 1000) {
    command("shake");
    command("say " + RANK_D->query_respect(ob) + "的刀刃运用还不够熟练。");
    return;
  }
  if (ob->query("str", 1) < 25) {
    command("shake");
    command("say " + RANK_D->query_respect(ob) + "悟性不足，不能领悟我的武功。");
    return;
  }
  if (ob->query("int", 1) < 25) {
    command("shake");
    command("say " + RANK_D->query_respect(ob) + "手无缚鸡之力，怎能习武？");
    return;
  }
  if ((int)ob->query("kar") < 25) {
    command("shake");
    command("say " + RANK_D->query_respect(ob) + "看上去不像福缘深厚之人。");
    return;
  }


  command("say 你既然能够到这里来，也说明你我有缘，我就收下你吧。\n");
  message(
    "vision",
    HIC "〖" HIR "江湖奇闻" HIC "〗" NOR + ":" + HIG " 听说" HIM + ob->short() + NOR HIG "找到了失踪已久的无名老人，并且成为他的关门弟子！\n" NOR,
    users()
  );
  command("recruit " + ob->query("id"));
  return;
}

int ask_xuanhuan() {
  object me, ob;
  me = this_player();
  ob = this_object();

  if (me->query_temp("jm_xuantian1") && me->query_temp("jm_xuantian2") && me->query_temp("jm_xuantian3") && (string)me->query("family/family_name") == "玄天派") {
    message_vision(HIB "无名老人说道：很好！这位" + RANK_D->query_respect(me) + "为我派清理叛徒。\n" NOR, me);
    message_vision(
      HIC "无名老人说道：看在" + RANK_D->query_respect(me) + "的忠心下，你可以去我派密室参悟玄幻一斩。” \n" NOR,
      me
    );
    me->set_temp("jm_xuantian4", 1);
  } else {
    message_vision(YEL "听说我派败类皈依了佛门......金刚伏魔圈......是可忍孰不可忍！！！\n", me);
    message_vision(YEL "无名老人说道：这位" + RANK_D->query_respect(me) + "若能替我派铲除叛徒，我必有厚报！” \n" NOR, me);
    message_vision(YEL "无名老人说道：我派原本属于血河派一脉，可惜出了三个败类，导致我派从血河派分裂出来。” \n" NOR, me);
    return 1;
  }

  return 1;
}
