void create() {
  string name, id;
  int jibie;
  jibie = 3000;
  name = first_name[random(sizeof(first_name))];

  if (random(3) > 1) {
    set("gender", "男性");
    name += name_words[random(sizeof(name_words))];
    if (random(10) > 2) name += name_words[random(sizeof(name_words))];
  } else {
    set("gender", "女性");
    name += name_wordss[random(sizeof(name_wordss))];
    if (random(10) > 2) name += name_wordss[random(sizeof(name_wordss))];
  }
  id = rnd_id[random(sizeof(rnd_id))];
  if (random(10) > 4) id += rnd_id[random(sizeof(rnd_id))];
  id += rnd_id_tail[random(sizeof(rnd_id_tail))];
  set_name(name, ({ id, "dizi" }));
  set("age", random(10) + 14);
  set("long", name + "刚拜师学艺不久，满脸稚气。\n");
  set("attitude", "peaceful");

  set("xyzx_sys/level", 1000 + random(jibie));  //2016.5.22阿飞调整NPC属性
  set("shen_type", 1 - random(3));
  set("int", random(20) + 20);
  set("con", random(20) + 20);
  set("str", random(20) + 20);
  set("dex", random(20) + 20);

  //        set("combat_exp",SET_SKILL*SET_SKILL*SET_SKILL);

  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("blade", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("beiming-shengong", 100 + jibie / 10 + random(jibie) / 10);
  set_skill("lingboweibu", 500 + jibie / 3 + random(jibie / 5));
  set_skill("zhemei-shou", 500 + jibie / 3 + random(jibie / 5));
  set_skill("ruyi-dao", 500 + jibie / 3 + random(jibie / 5));
  map_skill("dodge", "lingboweibu");
  map_skill("parry", "zhemei-shou");
  map_skill("force", "beiming-shengong");
  map_skill("unarmed", "zhemei-shou");
  map_skill("blade", "ruyi-dao");
  set("chat_chance", 20);
  set("chat_msg", ({
    (: random_move :)
  }));

  create_family("逍遥派", 3 + random(4), "弟子");
  setup();
  carry_object("/clone/cloth/long_cloth")->wear();
  carry_object("/clone/weapon/blade")->wield();
}

void just_kill(object guai, object player) {
  if (!objectp(guai) || !objectp(player)) return;
  if (environment(guai) != environment(player)) return;
  if (environment(player)->query("no_fight")) return;
  if (random(100) >= 10) {
    guai->command("haha");
    guai->command("say 江湖任逍遥，快意了恩仇，我派弟子当我行我素！！！");
  } else {
    guai->command("say 小子，你当着大爷的道了，老子想杀人就杀人！！！");
    guai->kill_ob(player);
    player->fight_ob(guai);
  }

  return;
}

void init() {
  object ob, me, get_ob;
  int level;

  me = this_object();
  ob = this_player();

  // 怪物必须是可以动作的，并只针对玩家
  if (!objectp(ob) || !living(me) || !playerp(ob)) return;
  // 见面就杀
  //me->kill_ob(ob);	//这条表示见人就杀
  call_out("just_kill", 1, me, ob);  //这条表示执行上述定义的just_kill这一段
  // command("follow "+ob->query("id"));
  // 只复制>5000级玩家状态
  if (ob->query("xyzx_sys/level") < 1000000) return;  //2016.5.28阿飞改，以后怪不在复制玩家了
  // 获得玩家总等级
  level = ob->query("xyzx_sys/level");
  // 只复制最高等级玩家
  if (me->query_temp("kill_ob_lvl") >= level) return;
  // 防止重复复制同一人
  if (objectp(get_ob = me->query_temp("fight_killer_id")) && get_ob == ob) return;
  //__________________标记目前复制状况___________________
  me->set_temp("fight_killer_id", ob);
  me->set_temp("kill_ob_lvl", level);
  //______________________标记结束_______________________
  //__________________________等级相关参数拷贝_____________________________
  me->set("xyzx_sys/level", me->query("xyzx_sys/level") + ob->query("xyzx_sys/level"));
  me->set("xyzx_sys/jingzhun", me->query("xyzx_sys/jingzhun") + ob->query("xyzx_sys/jingzhun"));
  me->set("xyzx_sys/minjie", me->query("xyzx_sys/minjie") + ob->query("xyzx_sys/minjie"));
  me->set("xyzx_sys/lingxing", me->query("xyzx_sys/lingxing") + ob->query("xyzx_sys/lingxing"));
  me->set("xyzx_sys/fanying", me->query("xyzx_sys/fanying") + ob->query("xyzx_sys/fanying"));
  //______________________________拷贝完成_________________________________
}


void die() {
  object ob, me, corpse, baoshi, env;
  string room, name;
  int m, k1, k2, k3;
  int flag, bl;
  flag = 1;
  bl = 1;

  ob = this_object();

  if (!objectp(me = ob->query_temp("last_unconcious_from")))
    me = ob->query_temp("last_damage_from");  // 绑定到最后伤害对象

    if (!objectp(me)  // 未成功绑定
    || !objectp(env = environment(ob))
      || !stringp(room = env->query("short"))) {
      ::die();
      return;
    }

  if (me) {
    m = 500 * ob->query("xyzx_sys/level") + random(10000 + 500 * ob->query("xyzx_sys/level"));
    bl = (ob->query("xyzx_sys/level", 1) + 1) / 1000 + 1;
    if (interactive(me)) {
      message(
        "party",
        HIW "【" + room + "】" + HIG + me->name(1) + HIM " 杀死了江湖游侠 " + ob->name(1) + HIM " ，奖励了 " HIC + (me->query_exp_times() * m) + HIM " 点经验和 " HIY + (m / 10) + HIM " 潜能。\n" NOR,
        users()
      );
      me->add("combat_exp", m);
      me->add("potential", m / 10);
      if (me->query("xyhy_type") == 2) flag = 5 / 4;
    }
  }

  if (objectp(corpse = CHAR_D->make_corpse(ob, me)))
    corpse->move(environment(ob));
  // 绑定到对象，冷冻一分钟
  corpse->set("valid_get_from", me->query("id"));

  k1 = 50 * flag * bl;  //装备爆率
  k2 = 50 * flag * bl;  //附魔符爆率
  k3 = 50 * flag * bl;  //宝石爆率

  if (objectp(me) && objectp(ob) && random(1000) < k1) {
    if (random(2) == 0) {
      baoshi = new("/clone/tzbox/three-box");
    } else {
      baoshi = new("/clone/tzbox/wp3-box");
    }
    name = baoshi->name(1);
    message_vision(
      HIG "\n$N在 " HIY + ob->name(1) + " 的尸体上发现了 " HIW + baoshi->name(1) + "(" + baoshi->query("id") + ")。\n" NOR,
      me
    );  //2016.6.15阿飞改，增加显示物品的id		
    message(
      "party",
      HIW "【" + room + "】" + HIM "听说 " HIG + me->name(1) + HIM " 在 " + ob->name(1) + HIM " 尸体上发现了 " HIM + baoshi->name(1) + "(" + baoshi->query("id") + ")。\n" NOR,
      users()
    );  //2016.6.15阿飞改，增加显示物品的id
    baoshi->move(corpse);
  }
  if (objectp(me) && objectp(ob) && random(1000) < k2) {
    baoshi = new("/clone/map/obj/fumo-fu");
    name = baoshi->name(1);
    message_vision(
      HIG "\n$N在 " HIY + ob->name(1) + " 的尸体上发现了 " HIW + baoshi->name(1) + "(" + baoshi->query("id") + ")。\n" NOR,
      me
    );  //2016.6.15阿飞改，增加显示物品的id		
    //		    message("party", HIW"【"+room+"】"+HIM"听说 "HIG+me->name(1)+HIM" 在 "+ob->name(1)+HIM" 尸体上发现了 "HIM+baoshi->name(1)+"("+baoshi->query("id")+")。\n"NOR,users() );  //2016.6.15阿飞改，增加显示物品的id
    baoshi->move(corpse);
  }
  if (objectp(me) && objectp(ob) && random(1000) < k3) {
    baoshi = new(random_item2[random(sizeof(random_item2))]);
    name = baoshi->name(1);
    message_vision(
      HIG "\n$N在 " HIY + ob->name(1) + " 的尸体上发现了 " HIW + baoshi->name(1) + "(" + baoshi->query("id") + ")。\n" NOR,
      me
    );  //2016.6.15阿飞改，增加显示物品的id		
    //		    message("party", HIW"【"+room+"】"+HIM"听说 "HIG+me->name(1)+HIM" 在 "+ob->name(1)+HIM" 尸体上发现了 "HIM+baoshi->name(1)+"("+baoshi->query("id")+")。\n"NOR,users() );  //2016.6.15阿飞改，增加显示物品的id
    baoshi->move(corpse);
  }


  COMBAT_D->announce(ob, "dead");
  destruct(ob);
  return;
}
