inherit ITEM;
void create()
{
        set_name(HIR"大还丹"NOR, ({ "dahuan dan","dan"}));
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {       
           set("unit", "颗"); 
                set("no_get",1);
                set("no_s",1);             
                set("no_put",1);
                set("no_give",1);
        }
    setup();
}
void init()
{
    if (environment()==this_player())
        add_action("do_eat", "eat");
}
int do_eat(string arg)
{
  object me = this_player();
    
  if (arg!="dan" && arg!="dahuan dan")   return 0;
  if(me->is_busy()) return notify_fail("你上一个动作还没有完成。\n");

  if(me->query("id")==query("value"))
  return notify_fail("这棵丹不是你练的,你吃个什么劲。\n");
    
me->add("combat_exp",50000);
me->add("max_neili",100+random(100));  message_vision(HIR"$N拿起大还丹吃了下去,感觉丹田传来一阵阵热意,内力修为好象有所增加!!!!!\n"NOR,me);
       destruct(this_object());
       return 1;
}

