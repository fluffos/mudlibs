// ZhouDian.c
// pal 1997.05.11

#include <ansi.h>
inherit NPC;
inherit F_MASTER;
//inherit F_UNIQUE;

void create()
{
	int jibie;
	jibie = 2000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
	set_name("周颠", ({ "zhou dian", "zhou", "dian", }));
	set("long",
        "他是一位疯疯颠颠的老者，身穿一件白布长袍。\n"
        "他总是慌慌张张的，先天下之急而急。\n"
	);

        set("title", HIG "明教" NOR "五散人");
        set("nickname", "没事不颠有事颠");
	set("gender", "男性");
	set("attitude", "friendly");
        set("class", "scholar");

        set("age", 46);
	set("shen_type", 1);
	set("str", 25);
	set("int", 25);
	set("con", 25);
	set("dex", 25);
	set("max_qi", 1000);
	set("max_jing", 1000);
	set("neili", 1000);
	set("max_neili", 1000);
	set("jiali", 100);
	set("combat_exp", 100000);
	set("score", 5000);

	set_skill("force", 500+jibie/3+random(jibie/5));
	set_skill("hunyuan-yiqi", 500+jibie/3+random(jibie/5));
	set_skill("dodge", 500+jibie/3+random(jibie/5));
	set_skill("shaolin-shenfa", 500+jibie/3+random(jibie/5));
	set_skill("cuff", 500+jibie/3+random(jibie/5));
	set_skill("jingang-quan", 500+jibie/3+random(jibie/5));
	set_skill("parry", 500+jibie/3+random(jibie/5));
	set_skill("buddhism", 500+jibie/3+random(jibie/5));
	set_skill("literate", 500+jibie/3+random(jibie/5));

	map_skill("force", "hunyuan-yiqi");
	map_skill("dodge", "shaolin-shenfa");
	map_skill("cuff", "jingang-quan");
	map_skill("parry", "jingang-quan");

	prepare_skill("cuff", "jingang-quan");
        create_family("明教", 37, "五散人");

	setup();

        carry_object("/d/mingjiao/obj/baipao")->wear();
}

void init()
{
	::init();

	if (interactive(this_player()) && this_player()->query_temp("fighting"))
	{
		COMBAT_D->do_attack(this_object(), this_player(), query_temp("weapon") );
		this_player()->add_temp("beat_count", 1);
	}       
}

void attempt_apprentice(object ob)
{

        if((int)this_player()->query("combat_exp") < 10000)
        {
        command("shake");
        command("say 恩，" + RANK_D->query_respect(ob) + 
"需要丰富的实战经验。\n");
                return;
      }
        if ((int)ob->query("shen") < 0) {
                command("say " + RANK_D->query_respect(ob) +
                        "有所不知，我平生最恨奸诈之人，你正气太低，我不能让你进入明教半步。");
                return;
        }
       if ((string)ob->query("family/family_name")!="明教" ) {
                command("say " + RANK_D->query_respect(ob) + "若想拜入我派，你可以先去拜徐达。");
                return;
        }        

	if ((int)ob->query_skill("shenghuo-shengong") < 300) 
	{
        command("say 你对我明教圣火神功练习的不够娴熟。");
		return;
	}
	if ((int)ob->query("score") < 1000) 
	{
        command("say 你似乎对我教还不够忠心，我还不能收你。");
		return;
	}

        command("say 哈哈！ 我明教又得一良材，望你日后康扶正义，把我明教发扬光大。");
        command("recruit " + ob->query("id"));
        if((string)ob->query("class") != "shizhe") ob->set("class", "shizhe");
		return;
}