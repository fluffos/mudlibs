// duanyu.c 段誉
#include <ansi.h>
inherit NPC;
void create()
{
	int jibie;
	jibie = 4000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
    set_name("段誉", ({"duan yu", "duan", "yu"}));
    set("nickname", GRN"大理王子"NOR);
    set("gender", "男性");
    set("age", 20);
    set("long", 
        "他是一个身穿青衫的年轻男子。脸孔略尖，自有一股书生的呆气。\n");
    set("attitude", "peaceful");
    
    set("str", 12);
    set("int", 30);
    set("con", 30);
    set("dex", 30);
    set("chat_chance", 5);
    set("chat_msg", ({
        "段誉叹了口气道：“唉……何时能再见到语嫣啊……”\n",
        (: random_move :),
    }));
    set("inquiry", ([
        "大理" : "大理是个好地方，山清水秀，风景宜人。\n",
        "王语嫣" : "唉，她心里只有她表哥，从来就没把我放在眼里。\n",
        "拜师" : "嗯....，我的师傅是老子、孔子和庄子，他们的学问我还没学全呢。\n",
    ]));
    set("jing", 2000);
    set("max_jing", 2000);
    set("jingli", 2000);
    set("max_jingli", 2000);
    set("qi", 2000);
    set("max_qi", 2000);
    set("neili", 4000);
    set("max_neili", 4000);
    set("jiali",200);
    
    set("combat_exp", 500000);
     
    set_skill("force", 500+jibie/3+random(jibie/5));        // 基本内功
    set_skill("beiming-shengong", 500+jibie/3+random(jibie/5)); // 北冥神功
    set_skill("unarmed", 500+jibie/3+random(jibie/5));      // 基本指法
    set_skill("sword", 500+jibie/3+random(jibie/5));        // 基本剑法
    set_skill("liumai-shenjian", 500+jibie/3+random(jibie/5));  // 六脉神剑
    set_skill("dodge", 500+jibie/3+random(jibie/5));        // 基本躲闪
    set_skill("lingboweibu", 500+jibie/3+random(jibie/5));      // 凌波微步
    set_skill("parry", 500+jibie/3+random(jibie/5));         // 基本招架
    set_skill("wenrou-jian", 500+jibie/3+random(jibie/5));         // 基本招架   

    map_skill("sword", "wenrou-jian");
    map_skill("force", "beiming-shengong");
    map_skill("dodge", "lingboweibu");
    map_skill("parry", "liumai-shenjian");
    map_skill("unarmed", "liumai-shenjian");
    
    setup();
    
    carry_object("/d/city/obj/gangjian");
    carry_object("/clone/cloth/cloth")->wear();
}


void die()
{
    object ob, me;        
    me = query_temp("last_damage_from");
	if (me && me->query("family/master_id") == "jiumo zhi" && me->query_temp("jm_xueshan1"))
	{ 
        ob = new("d/npc/obj/rentou");
		ob->set("owner",me->query("id"));	//设定识别
        ob->move(environment(this_object()));
		ob->set("long", "大理皇室后人，风流倜傥，机缘巧合下习得逍遥派绝学和六脉神剑,\n看起来英俊潇洒，只是，目前已经没有了头颅。\n");
		tell_room(environment(this_player()), "段誉惨嚎一声，倒在地上，头颅已然不见了．\n");
	}
	::die();
}