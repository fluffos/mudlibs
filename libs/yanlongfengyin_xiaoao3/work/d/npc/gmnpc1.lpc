void create() {
  int i, index, jibie;
  mapping mp;
  string *basic = ({
    "poison",
    "force",
    "dodge",
    "parry",
    "unarmed",
    "hand",
    "finger",
    "strike",
    "magic",
    "spells",
    "cuff",
    "claw",
    "taoism",
    "sword",
    "blade",
    "club",
    "staff",
    "hammer",
    "throwing",
    "axe",
    "whip",
    "dagger",
    "spear",
    "fork",
    "stick"
  });
  index = random(sizeof(menpai));
  mp = menpai[index];
  jibie = 10000;

  seteuid(getuid());
  set_name(HIC "劫匪阿飞" NOR, ({ "jianghu dadao", "dadao" }));
  set("title", HIY "江湖大盗" NOR);
  set("gender", "男性");
  set("age", random(30) + 20);
  set("long", "这是无恶不做的大盗，披着一件破烂蓑衣，戴着一件拉风的斗笠，神情鬼鬼祟祟的，看样子是偷了什么好东西在手。\n");
  set("attitude", "aggressive");
  set("class", "lvlin");
  set("no_suck", 1);
  //set("end_boss", 1);
  set("env/wimpy", 50);
  set("xyzx_sys/level", jibie * 8 / 10 + random(jibie * 4 / 10));  //2016.5.22阿飞调整NPC属性		

  if (!query("wugong", 1)) {
    if (mp["gender"]) set("gender", mp["gender"]);
    /*		if (mp["family"]) 
		{
			set("famile/family_name",mp["family"]);
			set("famile/generation",100);
		}*/
    if (mp["family"]) create_family(mp["family"], 100, "弟子");
    for (i = 0; i < sizeof(keys(mp)); i++) {
      if (keys(mp)[i] == "knowledge") set_skill(
        mp[keys(mp)[i]],
        500 + jibie / 2 + random(jibie / 2)
      );
      if (member_array(keys(mp)[i], basic) != -1) {
        set_skill(keys(mp)[i], 500 + jibie * 2 + random(jibie / 2));
        set_skill(mp[keys(mp)[i]], 500 + jibie / 2 + random(jibie / 2));
        map_skill(keys(mp)[i], mp[keys(mp)[i]]);
      }
    }
    set("wugong", 1);
  }

  set("chat_chance", 50);
  set("chat_msg", ({
    "劫匪阿飞嘿嘿一笑道：盗亦有道，替天行道！！！\n",
    (: random_move :),
  }));


  setup();
  if (!query("wuqi", 1)) {
    if (mp["weapon"]) carry_object(mp["weapon"])->wield();
    set("wuqi", 1);
  }
  carry_object("/clone/cloth/hanbing-jia")->wear();
  add_money("gold", 100 + random(jibie));
}

void just_kill(object guai, object player) {
  if (!objectp(guai) || !objectp(player)) return;
  if (environment(guai) != environment(player)) return;
  if (environment(player)->query("no_fight")) return;
  if (random(100) >= 30) {
    guai->command("heihei");
    guai->command("say 盗亦有道，老子看你还不错，不想打劫你，赶紧格老子的滚蛋！！！");
  } else {
    guai->command("say 小子，老子看你很不顺眼，正想找个人打劫，你就送上门了！");
    guai->kill_ob(player);
    player->fight_ob(guai);
  }

  return;
}

void init() {
  object ob, me, get_ob;
  int level;

  me = this_object();
  ob = this_player();

  // 怪物必须是可以动作的，并只针对玩家
  if (!objectp(ob) || !living(me) || !playerp(ob)) return;
  // 见面就杀
  //me->kill_ob(ob);	//这条表示见人就杀
  call_out("just_kill", 1, me, ob);  //这条表示执行上述定义的just_kill这一段
  // command("follow "+ob->query("id"));
  // 只复制>5000级玩家状态
  if (ob->query("xyzx_sys/level") < 1000000) return;  //2016.5.28阿飞改，以后怪不在复制玩家了
  // 获得玩家总等级
  level = ob->query("xyzx_sys/level");
  // 只复制最高等级玩家
  if (me->query_temp("kill_ob_lvl") >= level) return;
  // 防止重复复制同一人
  if (objectp(get_ob = me->query_temp("fight_killer_id")) && get_ob == ob) return;
  //__________________标记目前复制状况___________________
  me->set_temp("fight_killer_id", ob);
  me->set_temp("kill_ob_lvl", level);
  //______________________标记结束_______________________
  //__________________________等级相关参数拷贝_____________________________
  me->set("xyzx_sys/level", me->query("xyzx_sys/level") + ob->query("xyzx_sys/level"));
  me->set("xyzx_sys/jingzhun", me->query("xyzx_sys/jingzhun") + ob->query("xyzx_sys/jingzhun"));
  me->set("xyzx_sys/minjie", me->query("xyzx_sys/minjie") + ob->query("xyzx_sys/minjie"));
  me->set("xyzx_sys/lingxing", me->query("xyzx_sys/lingxing") + ob->query("xyzx_sys/lingxing"));
  me->set("xyzx_sys/fanying", me->query("xyzx_sys/fanying") + ob->query("xyzx_sys/fanying"));
  //______________________________拷贝完成_________________________________
}

void die() {
  object ob, me, corpse, baoshi, env;
  string room, name;
  int m, k1, k2, k3;
  int flag;

  ob = this_object();
  flag = 1;

  // 先绑定到打晕的对象上
  if (!objectp(me = ob->query_temp("last_unconcious_from")))
    me = ob->query_temp("last_damage_from");  // 绑定到最后伤害对象

    if (!objectp(me)  // 未成功绑定
    || !objectp(env = environment(ob))
      || !stringp(room = env->query("short"))) {
      ::die();
      return;
    }

  if (me) {
    m = 10000000 + random(10000000);

    if (interactive(me)) {
      message(
        "party",
        HIW "【" + room + "】" + HIG + me->name(1) + HIM " 杀死了 " + ob->name(1) + HIM " ，奖励了 " HIC + (me->query_exp_times() * m) + HIM " 点经验和 " HIY + (m / 10) + HIM " 潜能。\n" NOR,
        users()
      );
      me->add("combat_exp", m);
      me->add("potential", m / 10);
      if (me->query("xyhy_type") == 2) flag = 5 / 4;
    }
  }

  if (objectp(corpse = CHAR_D->make_corpse(ob, me)))
    corpse->move(environment(ob));

  // 绑定到对象，冷冻一分钟
  corpse->set("valid_get_from", me->query("id"));

  k1 = 300 * flag;  //装备爆率
  k2 = 300 * flag;  //混沌符爆率
  k3 = 300 * flag;  //宝石爆率

  if (objectp(me) && objectp(ob) && random(1000) < k1) {
    if (random(3) == 0) {
      baoshi = new("/clone/tzbox/five-box");
    } else if (random(3) == 1) {
      baoshi = new("/clone/tzbox/wp5-box");
    } else {
      baoshi = new("/clone/tzbox/medal-box");
    }
    name = baoshi->name(1);
    message_vision(
      HIG "\n$N在 " HIY + ob->name(1) + " 的尸体上发现了 " HIW + baoshi->name(1) + "(" + baoshi->query("id") + ")。\n" NOR,
      me
    );  //2016.6.15阿飞改，增加显示物品的id		
    message(
      "party",
      HIW "【" + room + "】" + HIM "听说 " HIG + me->name(1) + HIM " 在 " + ob->name(1) + HIM " 尸体上发现了 " HIM + baoshi->name(1) + "(" + baoshi->query("id") + ")。\n" NOR,
      users()
    );  //2016.6.15阿飞改，增加显示物品的id
    baoshi->move(corpse);
  }
  if (objectp(me) && objectp(ob) && random(1000) < k2) {
    baoshi = new("/clone/map/obj/hundun-fu");
    name = baoshi->name(1);
    message_vision(
      HIG "\n$N在 " HIY + ob->name(1) + " 的尸体上发现了 " HIW + baoshi->name(1) + "(" + baoshi->query("id") + ")。\n" NOR,
      me
    );  //2016.6.15阿飞改，增加显示物品的id		
    message(
      "party",
      HIW "【" + room + "】" + HIM "听说 " HIG + me->name(1) + HIM " 在 " + ob->name(1) + HIM " 尸体上发现了 " HIM + baoshi->name(1) + "(" + baoshi->query("id") + ")。\n" NOR,
      users()
    );  //2016.6.15阿飞改，增加显示物品的id
    baoshi->move(corpse);
  }
  if (objectp(me) && objectp(ob) && random(1000) < k3) {
    baoshi = new(random_item2[random(sizeof(random_item2))]);
    name = baoshi->name(1);
    message_vision(
      HIG "\n$N在 " HIY + ob->name(1) + " 的尸体上发现了 " HIW + baoshi->name(1) + "(" + baoshi->query("id") + ")。\n" NOR,
      me
    );  //2016.6.15阿飞改，增加显示物品的id		
    //		    message("party", HIW"【"+room+"】"+HIM"听说 "HIG+me->name(1)+HIM" 在 "+ob->name(1)+HIM" 尸体上发现了 "HIM+baoshi->name(1)+"("+baoshi->query("id")+")。\n"NOR,users() );  //2016.6.15阿飞改，增加显示物品的id
    baoshi->move(corpse);
  }


  COMBAT_D->announce(ob, "dead");
  destruct(ob);
  return;
}
