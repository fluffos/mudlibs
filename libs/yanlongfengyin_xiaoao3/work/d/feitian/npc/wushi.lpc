// wushi.c

inherit NPC;
// inherit F_SKILL;

void create()
{
	int jibie;
	jibie = 150;
	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性
	set_name("武士", ({ "wu shi", "shi" }));
	set("gender", "男性");
	set("age", random(10) + 20);
	set("str", 25);
	set("dex", 16);
	set("long", "一个充满了傲气的武士。\n");
	set("combat_exp", 50000);
	set("shen_type", 1);
	set("attitude", "peaceful");

	set_skill("unarmed", 500+jibie/3+random(jibie/5));
	set_skill("force", 500+jibie/3+random(jibie/5));
	set_skill("blade", 500+jibie/3+random(jibie/5));
	set_skill("dodge", 500+jibie/3+random(jibie/5));
	set_skill("parry", 500+jibie/3+random(jibie/5));
	set("neili", 1000); 
	set("max_neili", 1000);
	set("jiali", 10);

	setup();
	carry_object("/clone/armor/tiejia")->wear();
	carry_object("/d/feitian/obj/wushidao")->wield();
}

