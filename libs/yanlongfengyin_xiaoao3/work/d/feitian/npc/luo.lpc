#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int ask_kungfu();

void create()
{
	int jibie;
	jibie = 3000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
	set_name("悠久山安慈", ({ "youjiushan anci", "anci" }));
	set("nickname",HIC"明王"NOR);
	set("rank","十刃");
	set("gender", "男性");
	set("age", 33);
	set("dex", 43);

	set("combat_exp", 3200000);
	set("max_neili",30000);
	set("neili",30000);
	set("max_qi",30000);
	set("eff_qi",30000);
	set("qi",30000);
	set("max_jingli",30000);
	set("eff_jingli",30000);
	set("jingli",40000);

	set_skill("unarmed",500+jibie/3+random(jibie/5));
	set_skill("shayi",500+jibie/3+random(jibie/5) );
	set_skill("force", 500+jibie/3+random(jibie/5));
	set_skill("dodge", 500+jibie/3+random(jibie/5));
	set_skill("xuanhualiu-quanfa",500+jibie/3+random(jibie/5));
	set_skill("unarmed",500+jibie/3+random(jibie/5));
	set_skill("shayi-xinfa",500+jibie/3+random(jibie/5));
	set_skill("wuxing-dun",500+jibie/3+random(jibie/5));
	set_skill("shayi",500+jibie/3+random(jibie/5));
	map_skill("force","shayi-xinfa");
	map_skill("unarmed","xuanhualiu-quanfa");
	map_skill("parry","xuanhualiu-quanfa");
	map_skill("dodge","wuxing-dun");
		
	set("inquiry",([
			"三重劲" : (: ask_kungfu :),
		]));	
		
	setup();
	carry_object("/clone/cloth/cloth")->wear();
	carry_object("/clone/cloth/cloth")->wear();
}


int ask_kungfu()
{
	object me;
	mapping myparty;
	mapping myfam;

	me=this_player();
	myfam=(mapping)me->query("family");
	myparty=(mapping)me->query("party");

	if ( (!myfam || myfam["family_name"]!="飞天御剑流") && (!myparty || myparty["party_name"]!=HIG"飞天御剑流"NOR) )
	{
		command("say 我与你无缘，不会教你绝学的？");
		return 1;
	}

	if ( me->query("xyzx_sys/level",1)<2000)
	{
		command("say 你的实战经验太低，学不了我的绝学。");
		return 1;
	}		
	if ( me->query_skill("unarmed",1)<2000)
	{
		command("say 你的拳法还欠火候，学不了我的绝学。");
		return 1;
	}
	if ( me->query_skill("shayi-xinfa",1)<1000)
	{
		command("say 你的杀意心法还欠火候，学不了我的绝学。");
		return 1;
	}	
	if ( me->query_skill("xuanhualiu-quanfa",1)<2000)
	{
		command("say 你的喧哗流拳法还欠火候，学不了我的绝学。");
		return 1;
	}		
	if ( me->query("max_neili")<1000000 )
	{
		command("say 你的内力修为还欠火候，学不了我的绝学。");
		return 1;
	}
	if ( me->query("int",1)<25 )
	{
		message_vision(YEL"$N看了半天，毫无所得，想必你的资质太差了，掌握不了精髓。\n"NOR,me);
		return 1;
	}
	command("say 好吧，你看仔细了，我只演练一遍。");
	message_vision(HIY"$N走向一块巨石，微用拳劲击向石头，一声巨响石头变成了一堆粉末。\n"NOR,this_object());
	me->start_busy(1);
	me->add_temp("feitian/guanmo",1);
		
	if(me->query_temp("feitian/guanmo",1) > 1000)
	{
		message_vision(HIC"$N凝神看了半天，总算掌握了这套绝学的精髓。\n"NOR,me);
		me->set("feitian/sanchong",1);
		me->delete_temp("feitian/guanmo");
	}		

	return 1;
}
