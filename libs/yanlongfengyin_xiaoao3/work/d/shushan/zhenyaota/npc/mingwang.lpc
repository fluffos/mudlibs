//Cracked by Roath
//【蜀山剑派】dhxy-evil 2000.7.5
inherit NPC;

void create() {
  int jibie;
  jibie = 4000;
  set("xyzx_sys/level", jibie * 8 / 10 + random(jibie * 4 / 10));  //2016.5.22阿飞调整NPC属性
  set_name("镇狱明王", ({ "zhenyu mingwang", "wang" }));
  set("title", HIY "地狱鬼王" + NOR);
  set("age", 1000);
  set("attitude", "aggressive");
  set("str", 40);
  set("int", 35);
  set("con", 30);
  set("cor", 40);

  set("max_qi", 15000000);
  set("max_jing", 15000000);
  set("neili", 15000000);
  set("max_neili", 15000000);
  set("jingli", 15000000);
  set("max_jingli", 15000000);
  set("jiali", 6000);
  set("combat_exp", 2100000000);
  set("no_suck", 1);

  set_skill("force", 1000 + jibie / 5 + random(jibie / 10));
  set_skill("dodge", 1000 + jibie / 5 + random(jibie / 10));
  set_skill("parry", 1000 + jibie / 5 + random(jibie / 10));
  set_skill("unarmed", 1000 + jibie / 5 + random(jibie / 10));
  set_skill("shushan-force", 1000 + jibie / 5 + random(jibie / 10));
  set_skill("zuixian-steps", 1000 + jibie / 5 + random(jibie / 10));
  set_skill("fumozhang", 1000 + jibie / 5 + random(jibie / 10));
  map_skill("dodge", "zuixian-steps");
  map_skill("force", "shushan-force");
  map_skill("unarmed", "fumozhang");
  set("chat_chance_combat", 50);

  add_temp("apply/damage", 20);
  add_temp("apply/armor", 20);

  setup();
  carry_object("/clone/cloth/cloth")->wear();

}

void die() {
  if (environment()) {
    message("sound", "\n镇狱明王道：“我没办法了...”\n", environment());
  }
  destruct(this_object());
}
