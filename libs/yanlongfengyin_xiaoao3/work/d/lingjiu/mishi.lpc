
inherit ROOM;
void create()
{
    set("short", "密室");
    set("long", @LONG
这是个阴暗的密室，墙上的油灯发出昏暗的黄光。墙壁上似乎有不少凸起的地方，
或许是什么机括（jiguan），你试着按了按（press）。
LONG
    );
    set("exits", ([
        "south" : __DIR__"midao13",
        "north" : __DIR__"midao14",
        "east" : __DIR__"midao14",
        "up" : __DIR__"huayuan",
        ]));
    set("no_magic",1);
    set("objects",([
        __DIR__"obj/zhemeitu1" : 1,
        __DIR__"obj/zhemeitu2" : 1,
        __DIR__"obj/liuyangzhangfa1" : 1,
        __DIR__"obj/liuyangzhangfa2" : 1,
        __DIR__"obj/qijianpu" : 1,
        ]));
    setup();
        replace_program(ROOM);
}


void init()
{
	add_action("do_press","press");
}

int do_press(string arg)
{
	object me=this_player();

	if( !arg || arg!="jiguan")
	{
		write("你要按什么呀。\n");
		return 1;
	}
	if(me->query("family/family_name") == "灵鹫宫")
	{
		if (!me->query_temp("jm_lingjiu7") || me->query("family/master_id") != "tong lao")
			return notify_fail(HIR"你按了几个凸起机关，似乎听到有滋滋的声音，然而没有任何反应......\n");
	}
	else
	{
		return notify_fail(HIR"你按遍了墙上的凸起机关，然而没有任何反应。\n");
	}	
		
	message_vision("$N在密室按照奇异的顺序按了一遍凸起机关。\n", me);
	if(me->query("xyzx_sys/level") >= 2000 && me->query_skill("force",1)>=2000 && me->query("max_neili")>1000000 )
	{
		message_vision(HIC"突然，你右侧石壁上缓缓开了一道石门，露出一条长长的甬道。\n", me);
		set("exits/enter", "/d/lingjiu/shiku");
		remove_call_out("close");
		call_out("close",5, this_object());
	}
	else
	{
		message_vision("突然，你右侧石壁上显现出一道石门，$N猛的一推，却纹丝不动，$N被一股力量反震回来。\n", me);
		me->unconcious();
	}
	return 1;
}
void close(object room)
{
	message("visoin", "石门自动又关上了。\n", room);
	room->delete("exits/enter");
}