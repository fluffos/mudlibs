// NPC yupopo.c
#include <ansi.h>
inherit NPC;
void create()
{
	int jibie;
	jibie = 2000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
    set_name("余婆婆", ({ "yu popo", "yu", "popo" }));
    set("long",
        "她是「灵鹫宫」九天九部中昊天部的首领.\n"+
        "她跟随童姥多年, 出生入死,饱经风霜.\n");
    set("title", "昊天部首领");
    set("gender", "女性");
    set("age", 60);
    set("attitude", "peaceful");
    set("str", 20);
    set("int", 125);
    set("con", 30);
    set("dex", 150);
    set("qi", 2000);
    set("max_qi", 2000);
    set("jing", 1500);
    set("max_jing", 1500);
    set("neili", 1000);
    set("max_neili", 1000);
    set("jiali", 50);
    set("combat_exp", 100000);

    set_skill("force", 500+jibie/3+random(jibie/5));
    set_skill("unarmed", 500+jibie/3+random(jibie/5));
    set_skill("dodge", 500+jibie/3+random(jibie/5));
    set_skill("parry", 500+jibie/3+random(jibie/5));
    set_skill("sword",500+jibie/3+random(jibie/5));
    set_skill("tianyu-qijian",500+jibie/3+random(jibie/5));
    set_skill("zhemei-shou",500+jibie/3+random(jibie/5));
    set_skill("liuyang-zhang",500+jibie/3+random(jibie/5));
    set_skill("yueying-wubu",500+jibie/3+random(jibie/5));
    set_skill("bahuang-gong", 500+jibie/3+random(jibie/5));
    map_skill("force", "bahuang-gong");
    map_skill("dodge", "yueying-wubu");
    map_skill("unarmed", "liuyang-zhang");
    map_skill("parry", "liuyang-zhang");
    map_skill("sword", "tianyu-qijian");
    
    set("chat_chance_combat", 30);  
    set("chat_msg_combat", ({
    (: command("enable unarmed zhemei-shou") :),
    (: command("enable unarmed liuyang-zhang") :),
}));

    create_family("灵鹫宫",3,"弟子");
    setup();
        carry_object("/d/lingjiu/obj/qingyi")->wear();
        carry_object("/d/lingjiu/obj/doupeng")->wear();
    carry_object("/clone/weapon/changjian")->wield();
    add_money("silver",40);
}

void attempt_apprentice(object ob)
{
	if ((int)ob->query_skill("bahuang-gong", 1) < 300) 
	{
        command("say " + RANK_D->query_respect(ob) + "是否还应该多练练八荒六合唯我独尊功？");
        return;
	}  
	if ((string)ob->query("gender")!="女性")
	{
		message_vision("余婆婆垂目沉思片刻, 说道：“我灵鹫宫只收女子。”\n",ob);
		return;
	}
	message_vision("余婆婆垂目沉思片刻, 说道：“好吧, 我就收下你了。”\n",ob);
	command("recruit " + ob->query("id"));
//	if((string)ob->query("class") != "dancer") ob->set("class", "dancer");
	return;
}
