//mishi by suimeng 2015.3
inherit ROOM;
#include <ansi.h>
void create ()
{
  set ("short","石窟");
  set ("long", @LONG
这里是灵鹫宫后殿石窟，石壁上有不少凸起机关(jiguan)。石壁上有不少荧光石，
闪烁着光芒。只见四壁岩石打磨光滑，石壁上刻满了无数径长尺许的圆圈，每个
圈中都刻了各种各样的图形，有的是人像，有的是兽形，有的是残缺不全的文字，
更有些只是记号和线条，圆圈旁注着“甲一”、“甲二”、“子一”、“子二”等数字，
圆圈之数若不逾千，至少也有八九百个。听说这些壁画为灵鹫宫数百年前旧主人遗
下的图像，或许可以参研（canyan）灵鹫宫武学。
LONG);
  
   set("exits", ([      
   ]));
  setup();
}

void init()
{
	add_action("do_canyan", "canyan");
	add_action("do_press","press");
}

int do_press(string arg)
{
	object me=this_player();

	if( !arg || arg!="jiguan")
	{
		write("你要按什么呀。\n");
		return 1;
	}
		
	message_vision("$N在密室按照奇异的顺序按了一遍凸起机关。\n", me);
	if(me->query("xyzx_sys/level") >= 2000 && me->query_skill("force",1)>=2000 && me->query("max_neili")>1000000 )
	{
		message_vision(HIC"突然，你右侧石壁上缓缓开了一道石门，露出一条长长的甬道。\n", me);
		set("exits/out", "/d/lingjiu/mishi");
		remove_call_out("close");
		call_out("close",5, this_object());
	}
	else
	{
		message_vision("突然，你右侧石壁上显现出一道石门，$N猛的一推，却纹丝不动，$N被一股力量反震回来。\n", me);
		me->unconcious();
	}
	return 1;
}
void close(object room)
{
	message("visoin", "石门自动又关上了。\n", room);
	room->delete("exits/out");
}

int do_canyan(string arg)
{
	object me=this_player();

	string *poem = ({
		"这似乎是折梅手第一招的起手式「"HIM"寒山一带伤心碧"NOR"」，竟有如此威力",
		"这似乎是折梅手第二招的「"HIG"花开堪折直须折"NOR"」，似乎又有些不同。",
		"这似乎是折梅手第六式「"HIW"云破月来花弄影"NOR"」，为什么如此迅猛无比？？",
		"这似乎是六阳掌起手式「"HIY"云霞出海曙"NOR"」，出手之时似乎霞光....",
		"这似乎是月影舞步的「"HIB"咫尺天涯"NOR"」，一步踏出，天涯尽在咫尺！！！",
		"这似乎是天羽奇剑「"HIC"天外飞虹"NOR"」，宛若白虹贯日！！！",
		"这招「"HIC"弹梅·落雪·听花香"NOR"」似乎融汇了数种武功！！！",
		});

    if (me->is_busy() )
        return notify_fail("你现在忙着呢，哪有功夫参悟壁画...\n");
    if ( (string)me->query("family/family_name") != "灵鹫宫" || me->query("family/master_id")!="tong lao" )
        return notify_fail("你不是童姥亲传弟子，是如何进入到灵鹫宫秘密石窟的？\n");
	if (!me->query_temp("jm_lingjiu7") || me->query("family/master_id") != "tong lao")
		return notify_fail("你未获得童姥的允许，竟敢偷偷的进入灵鹫宫后殿石窟！！！\n");
	if (me->query_skill("tianyu-qijian",1) < 2000)
		return notify_fail("你的天羽奇剑太低，看不懂石壁上的符号。\n");
	if (me->query_skill("liuyang-zhang",1) < 2000)
		return notify_fail("你的六阳掌法太低，按照壁画上的招式运行太过于生涩。\n");	
	if (me->query_skill("zhemei-shou",1) < 2000)
		return notify_fail("你的折梅手法太低，按照壁画上的图文比划，一时手忙脚乱。\n");		
	if (me->query_skill("bahuang-gong",1) < 1000)
		return notify_fail("你的八荒独尊功太低，参悟壁画招式有走火入魔之危。\n");	
	if(me->query("jm/lingjiu")) 	
		return notify_fail("你已经贯通了灵鹫宫武功精髓了，这里对你来说已无堪大用。\n");	
    if (me->query("jingli") < 1000)
		return notify_fail("你疲惫难堪，还是休息会吧。\n");
    			
	tell_object(me,HIW"按着壁画图中所示，运起真气，只学得数招，身子便轻飘飘地凌虚欲起，但似乎什么地方差了一点，以致没法离地。......\n"NOR);
	message_vision("$N按圈中所绘，演练着壁画招式：" + poem[random(sizeof(poem))] + "\n", me);
	me->add("jingli",-1000);		
	me->start_busy(1);

    if( random(100000) < me->query("kar",1) )
	{
		me->set("jm/yunlong",1);
		me->add("family_score",1);
		tell_object(me,HIC"你突然醒悟道："HIY"原来八荒功可以有此等威力"HIR"！\n"NOR);
		tell_object(me,HIC"恭喜你融汇贯通了灵鹫宫武功的精髓！\n"NOR);
		message("channel:chat", HIM"【天降奇才】"HIM + "听说"+me->query("name")+"天纵奇才，在灵鹫宫石窟中居然领悟了灵鹫宫的终极奥义！\n"NOR,users());
	}
	return 1;
}             

