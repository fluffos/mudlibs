// xunpu.c 巡捕
#include <ansi.h>
inherit NPC;
void create() {
  int jibie;
  jibie = 1000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("红卫兵", ({ "hong weibing", "wei bing", "bing" }));
  set("gender", "男性");
  set("age", random(20) + 20);
  set("str", 25);
  set("dex", 16);
  set("long", "这是个维护毛主席的红卫兵，如果对毛主席不敬重，最好还是别见他的好。\n");
  set("combat_exp", 1000000);
  set("shen_type", 1);
  set("attitude", "peaceful");
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("qinnashou", 500 + jibie / 3 + random(jibie / 5));
  set_skill("changquan", 500 + jibie / 3 + random(jibie / 5));
  set_skill("shenxing-baibian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yijing-force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("qingmang-jian", 500 + jibie / 3 + random(jibie / 5));
  map_skill("unarmed", "qinnashou");
  map_skill("dodge", "shenxing-baibian");
  map_skill("parry", "changquan");
  map_skill("force", "yijing-force");
  map_skill("sword", "qingmang-jian");
  //		set_temp("apply/attack", 50);
  //		set_temp("apply/defense", 50);
  //		set_temp("apply/armor", 50);
  //		set_temp("apply/damage", 30);
  set("neili", 40000);
  set("max_neili", 20000);
  set("jingli", 40000);
  set("max_jingli", 20000);
  set("jiali", 100);
  set("chat_chance", 30);
  set("chat_msg", ({
    "\n红卫兵拍了拍胸口，说道：有我在，所有人都得敬仰毛主席！\n",
    "\n红卫兵看了你几眼，说道：可别说毛主席坏话呵，否则老子一定不会放过你！\n",
    "\n红卫兵说道：怎么今天没人唱反调？闷死老子了！\n",
    //        (: random_move :)
  }));

  setup();
  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/clone/cloth/junfu")->wear();
}

void init() {
  object ob;
  ::init();
  if (!living(this_object())) return;
  if (interactive(ob = this_player())) {
    if ((int)ob->query_condition("killer") && ((int)ob->query_temp("summon_time") + 400) < time()) {
      command("say " + ob->name() + "，你杀了人，还敢来天安门城楼？明显不把毛主席放在眼里！");
      remove_call_out("summon_ob");
      call_out("summon_ob", 1, ob);
      return;
    }
    if (!ob->query_temp("armor/cloth") && ob->query("race") == "人类"
      && ((int)ob->query_temp("summon_time") + 400) < time()) {
      command("say " + ob->name() + "，光天化日当街裸跑？明显对毛主席大不敬！");
      remove_call_out("summon_ob");
      call_out("summon_ob", 1, ob);
      return;
    }
    if (ob->query_temp("fandongpai") && ob->query("race") == "人类"
      && ((int)ob->query_temp("summon_time") + 400) < time()) {
      command("say " + ob->name() + "，纪念毛主席时居然心怀不轨？明显对毛主席不敬重！");
      remove_call_out("summon_ob");
      call_out("summon_ob", 1, ob);
      return;
    }
  }

}

void summon_ob(object ob) {
  object room;

  if (!ob || environment(ob) != environment()) return;
  //	if(ob->query_temp("armor/cloth")) return;

  if (!room = find_object("/d/city/jianyu")) room = load_object("/d/city/jianyu");

  message_vision("\n$N一把抓住$n，哼！在天安门城楼上胆敢对毛主席不尊敬，很明显是不将共产党放在眼里！\n\n", this_object(), ob);
  message_vision("$N拎着$n向监狱走去！\n", this_object(), ob);
  ob->move(room);
  ob->set_temp("summon_time", time());
  if (ob->query_temp("fandongpai")) ob->del_temp("fandongpai");
  message("vision", YEL + "\n\n当啷一声，一个赤条条的家伙被扔了进来。\n\n" + NOR, room, ({ ob }));

}
