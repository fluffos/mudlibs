//mishi by suimeng 2015.3
inherit ROOM;
#include <ansi.h>
void create() {
  set("short", "密室");
  set("long", @LONG
这里是天地会密室，靠墙是一排书架（shujia)，摆满了各种拳谱、书籍，有些秘籍是天地会多年积累。
墙角有一张木床，天地会总舵主常常在这里研读秘籍。若得到总舵主允许，可以来此钻研武学（zuanyan）。
LONG);

  set("exits", ([
  ]));
  setup();
}

void init() {
  add_action("do_zuanyan", "zuanyan");
  add_action("do_push", "push");
}

int do_push(string arg) {
  object me = this_player();

  if (!arg || arg != "shujia") {
    write("你要推什么呀。\n");
    return 1;
  }

  message_vision("$N在书架前站定，深吸一口气，两手紧握住书架。\n", me);
  if (me->query("xyzx_sys/level") >= 2000 && me->query_skill(
    "force",
    1
  ) >= 2000 && me->query("max_neili") > 1000000) {
    message_vision(HIC "$N丹田一运气，猛的一推，只见书架之后，露出一条长长的甬道。\n", me);
    set("exits/west", "/d/city2/ceting");
    remove_call_out("close");
    call_out("close", 5, this_object());
  } else {
    message_vision("$N丹田一运气，猛的一推，书架却纹丝不动，$N被一股力量反震。\n", me);
    me->unconcious();
  }
  return 1;
}
void close(object room) {
  message("visoin", "书架自动又合上了。\n", room);
  room->delete("exits/west");
}

int do_zuanyan(string arg) {
  object me = this_player();

  string *poem = ({
    "这本秘籍，似乎是「" HIM "落花十三剑" NOR "」，为什么会有这么大威力？",
    "这本秘籍，似乎是云龙爪的「" HIG "抓奶三招" NOR "」，似乎又有些不同。",
    "这本秘籍，似乎是「" HIW "云龙剑法" NOR "」，为什么如此迅猛无比？？",
    "这本秘籍，似乎是「" HIY "百花错拳" NOR "」，怎样错乱百出....",
    "这本秘籍，似乎是「" HIB "陈近南" NOR "」的武功心得，然来如此！！！",
    "这本秘籍，似乎是「" HIC "陈家洛" NOR "」对十三剑的注解，竟然如此！！！",
  });

  if (me->is_busy())
    return notify_fail("你现在忙着呢，哪有功夫翻阅书架上的秘籍...\n");
  if ((int)me->query_skill("literate", 1) < 2000)
    return notify_fail("你钻研书架上的秘籍，可能是文学功底太差，始终无法领悟其精要。\n");
  if (!me->query("jm/42book"))
    return notify_fail("我天地会之人当干一番轰天动地之事，你去挖了大清龙脉再来吧。\n");
  if (me->query("family/family_name") == "云龙门") {
    if (!me->query_temp("jm_yunlong3") || me->query("family/master_id") != "chen jinnan")
      return notify_fail("你未获得云龙门陈总舵主的同意，无权翻阅秘籍。\n");
    if (me->query_skill("yunlong-jian", 1) < 2000)
      return notify_fail("你的云龙剑法太低，恐怕也是白费功夫。\n");
    if (me->query_skill("yunlong-shou", 1) < 2000)
      return notify_fail("你的云龙手太低，恐怕也是白费功夫。\n");
    if (me->query_skill("yunlong-shengong", 1) < 1000)
      return notify_fail("你的云龙神功太低，钻研秘籍有走火入魔之危。\n");
    if (me->query("jm/yunlong"))
      return notify_fail("你已经贯通了云龙门武功精髓了，这里对你来说已无堪大用。\n");
  } else if (me->query("family/family_name") == "红花会") {
    if (!me->query_temp("jm_honghua3") || me->query("family/master_id") != "chen jialuo")
      return notify_fail("你未获得红花会陈总舵主的同意，无权翻阅秘籍。\n");
    if (me->query_skill("luohua-jian", 1) < 2000)
      return notify_fail("你的落花剑法太低，恐怕也是白费功夫。\n");
    if (me->query_skill("baihua-cuoquan", 1) < 2000)
      return notify_fail("你的百花错拳太低，恐怕也是白费功夫。\n");
    if (me->query_skill("honghua-shengong", 1) < 1000)
      return notify_fail("你的红花神功太低，钻研秘籍有走火入魔之危。\n");
    if (me->query("jm/honghua"))
      return notify_fail("你已经贯通了红花会武功精髓了，这里对你来说已无堪大用。\n");
  } else {
    return notify_fail("大胆毛贼！！竟敢入天地会密室行窃？？？\n");
  }
  if (me->query("jingli") < 1000)
    return notify_fail("你疲惫难堪，还是休息会吧。\n");

  tell_object(me, HIW "你仔细翻阅书架上的秘籍，尝试着练习了下......\n" NOR);
  message_vision("$N仔细的研究着书架上的秘籍：" + poem[random(sizeof(poem))] + "\n", me);
  me->add("jingli", -1000);
  me->start_busy(1);

  if (random(100000) < me->query("kar", 1)) {
    if (me->query("family/family_name") == "云龙门") {
      me->set("jm/yunlong", 1);
      me->add("family_score", 1);
      tell_object(me, HIC "你突然醒悟道：" HIY "原来云龙手可以有此等威力" HIR "！\n" NOR);
      tell_object(me, HIC "恭喜你融汇贯通了云龙门武功的精髓！\n" NOR);
      message(
        "channel:chat",
        HIM "【天降奇才】" HIM + "听说" + me->query("name") + "天纵奇才，在天地会密室居然领悟了云龙门的终极奥义！\n" NOR,
        users()
      );
      return 1;
    }
    if (me->query("family/family_name") == "红花会") {
      me->set("jm/honghua", 1);
      me->add("family_score", 1);
      tell_object(me, HIG "你突然醒悟道：" HIY "原来落花十三剑可以有此等威力" HIR "！\n" NOR);
      tell_object(me, HIG "恭喜你融汇贯通了红花会武功的精髓！\n" NOR);
      message(
        "channel:chat",
        HIM "【天降奇才】" HIM + "听说" + me->query("name") + "天纵奇才，在天地会密室居然领悟了红花会的终极奥义！\n" NOR,
        users()
      );
      return 1;
    }
  }
  return 1;
}
