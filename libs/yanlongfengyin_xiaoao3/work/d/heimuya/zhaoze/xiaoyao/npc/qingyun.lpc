// qingyun.c
// shilling 97.2
inherit NPC;
#include <ansi.h>
void create()
{
	int jibie;
	jibie = 500;
	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性
    set_name("青云", ({ "qingyun", "shizhe" }));
    set("long", 
        "他是掌门人的得意门生，一个十分厉害的神秘人物。\n");
    set("gender", "男性");
    set("age", 50);
    set("attitude", "peaceful");
    set("shen_type", 1);
    set("str", 35);
    set("int", 28);
    set("con", 30);
    set("dex", 28);
    
    set("max_qi", 1000);
    set("max_jing", 1000);
    set("neili", 1000);
    set("max_neili", 1000);
    set("jiali", 100);
    set("combat_exp", 200000);
    set("score", 50000);
    set_skill("blade",500+jibie/3+random(jibie/5));
    set_skill("ruyi-dao",500+jibie/3+random(jibie/5));
    set_skill("force", 500+jibie/3+random(jibie/5));
    set_skill("dodge", 500+jibie/3+random(jibie/5));
    set_skill("unarmed", 500+jibie/3+random(jibie/5));
    set_skill("parry", 500+jibie/3+random(jibie/5));
    set_skill("lingboweibu", 500+jibie/3+random(jibie/5));
    set_skill("beiming-shengong",500+jibie/3+random(jibie/5));
    set_skill("liuyang-zhang", 500+jibie/3+random(jibie/5));

    map_skill("unarmed", "liuyang-zhang");
    map_skill("dodge", "lingboweibu");
    map_skill("force", "beiming-shengong");
    map_skill("blade", "ruyi-dao");
    set("book_count", 1);
    create_family("逍遥派", 4, "弟子");
    set("title",RED "逍遥派护法使者" NOR);
    set("nickname",HIC "天使之侣" NOR);
    setup();
    carry_object("clone/cloth/cloth")->wear();
    carry_object(__DIR__"obj/blade")->wield();
}
void init()
{
    object ob;
    ::init();
    ob = this_player();
//    if (interactive(ob) || ob->query("family/master_name")!="逍遥子")
	if (interactive(ob) || ob->query("family")!="逍遥派")	//2016.6.5阿飞改，由于青云会自动杀人，所以只限定为逍遥派
    {
            command("hehe");
            command("say 你好大的胆子，本派的密室也敢闯进来 ？！\n");
            remove_call_out("kill_ob");
            call_out("kill_ob", 1, ob); 
    }
    else if(ob->query("family/master_name")=="无崖子" || ob->query("family/master_id")=="wuya zi")
    {
    command("smile");
    command("say 师弟辛苦啦，快去见师父吧，他惦记着你呢。");
    } else
    {
    command("smile");
    command("say 你是来拜见师祖的吗？");
    }		
}
