// zhang2.c
#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create()
{
	int jibie;
	jibie = 4000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
    set_name("张乘云", ({"zhang chengyun", "zhang", "chengyun"}));
    set("nickname", HIW "白猿神魔" NOR );
    set("title", "日月神教长老");
    set("gender", "男性");
    set("age", 42);
    set("shen_type", 0);
    set("long",
        "他是日月神教长老。\n");
    set("attitude", "peaceful");

    set("per", 21);
    set("str", 30);
    set("int", 30);
    set("con", 30);
    set("dex", 30);

    set("qi", 3000);
    set("max_qi", 3000);
    set("jing", 1000);
    set("max_jing", 1000);
    set("neili", 3000);
    set("max_neili", 3000);
    set("jiali", 300);

    set("combat_exp", 15000000);
    set("score", 0);

	set_skill("force", 500+jibie/3+random(jibie/5));
	set_skill("literate", 500+jibie/3+random(jibie/5));
	set_skill("staff", 500+jibie/3+random(jibie/5));
	set_skill("dodge", 500+jibie/3+random(jibie/5));
	set_skill("unarmed", 500+jibie/3+random(jibie/5));
	set_skill("parry", 500+jibie/3+random(jibie/5));
	set_skill("sword",500+jibie/3+random(jibie/5));
	set_skill("tianmo-shengong",500+jibie/3+random(jibie/5));
	set_skill("wuxue-shenfa", 500+jibie/3+random(jibie/5));
	set_skill("tianmo-quan", 500+jibie/3+random(jibie/5));
	set_skill("tianmo-jian", 500+jibie/3+random(jibie/5));
	map_skill("force", "tianmo-shengong");
	map_skill("dodge", "wuxue-shenfa");
	map_skill("parry", "tianmo-jian");
	map_skill("unarmed", "tianmo-quan");
	map_skill("sword", "tianmo-jian");

    create_family("日月神教", 3, "长老");

    setup();
    carry_object("/clone/weapon/gangjian")->wield();
	carry_object("/d/heimuya/npc/obj/gangzhang")->wield();
    carry_object("/clone/cloth/cloth")->wear();
}


void attempt_apprentice(object ob)
{
    if (ob->query("str",1) < 25) {
        command("say 我不收资质差的弟子，您请回吧！\n");
                return;
    }

    if ((int)ob->query("shen") >100000 || (int)ob->query ("shen") < -100000 ) {
        command("say 我黑木崖与世隔绝，向来不与您这种成名人物打交道，您请回吧！;\n");
                return;
        }
	command("nod");
    command("say 很好，很好，望你能将我日月神教发扬光大！。\n");
    command("recruit " + ob->query("id"));
}