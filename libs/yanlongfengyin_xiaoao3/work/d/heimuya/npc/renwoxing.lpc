// renwoxing.c

#include <ansi.h>

inherit NPC;
inherit F_MASTER;
int ask_bijian();
int ask_riyue();
void create()
{
	int jibie;
	jibie = 7000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
	set_name("任我行", ( { "ren woxing", "ren","woxing" }));
	set("title", BLU "日月神教教主"NOR );
	set("long", "只见他一张长长的脸孔，脸色雪白，更无半分血色，眉目清秀，身材甚高，一头黑发，穿的是一袭青衫。\n");
	set("gender", "男性");
	set("class", "scholar");
	set("age", 55);
	set("attitude", "friendly");
	set("shen_type", -1);
	set("str", 150);
	set("per", 27);
	set("int", 35);
	set("con", 100);
	set("dex", 100);

	set("max_qi", 500000);
	set("max_jing", 150000);
	set("neili", 5000000);
	set("max_neili", 3000);
	set("jiali", 7300);
	set("combat_exp", 90000000);
	set("score", 500000);

	set_skill("literate", 500+jibie/3+random(jibie/5));
	set_skill("force", 500+jibie/3+random(jibie/5));
	set_skill("dodge", 500+jibie/3+random(jibie/5));
	set_skill("unarmed", 500+jibie/3+random(jibie/5));
	set_skill("parry", 500+jibie/3+random(jibie/5));
	set_skill("sword", 500+jibie/3+random(jibie/5));
	set_skill("changquan", 500+jibie/3+random(jibie/5));
	set_skill("xixing-dafa", 500+jibie/3+random(jibie/5));
	set_skill("shenxing-baibian", 500+jibie/3+random(jibie/5));
	set_skill("damo-jian", 500+jibie/3+random(jibie/5));
	set_skill("taiji-jian", 500+jibie/3+random(jibie/5));
	set_skill("huifeng-jian", 500+jibie/3+random(jibie/5));
	set_skill("taishan-jianfa", 500+jibie/3+random(jibie/5));
	set_skill("hengshan-jian", 500+jibie/3+random(jibie/5));
	set_skill("luoyan-jian", 500+jibie/3+random(jibie/5));
	set_skill("huashan-jianfa", 500+jibie/3+random(jibie/5));
	set_skill("songshan-jian", 500+jibie/3+random(jibie/5));
	set_skill("qingmang-jian", 500+jibie/3+random(jibie/5));

	map_skill("dodge", "shenxing-baibian");
	map_skill("force", "xixing-dafa");
	map_skill("unarmed", "changquan");
	map_skill("sword", "qingmang-jian");
	map_skill("parry", "qingmang-jian");
	create_family("日月神教", 1, "教主");
	set("inquiry", ([
                    "比剑" :  (: ask_bijian :),
					"日月神教" : (: ask_riyue() :),
                    "黑木令" : "要拿黑木令？老夫想先看看你的剑法！\n",
	                ]) );
	setup();
	carry_object("/d/wudang/obj/bluecloth")->wear();
	carry_object("/clone/weapon/changjian")->wield();
}

void init()
{
	object ob;
	::init();
	if( interactive(ob = this_player()) && visible(ob) && !is_fighting() )
	{
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
}

void greeting(object ob)
{
	if(!ob || environment(ob) != environment()) return;
	if( (ob->query("eff_qi")*100 / ob->query("max_qi") < 10)
	    && ob->query("neili") < 1
	    && random(5) == 0
//2016.5.22阿飞改，主要是将吸星大法定义为全面兼容		
//	    && ob->query("gender") != "无性"
		&& (ob->query_skill("xixing-dafa", 1) < 1)
		&& (ob->query_skill("beiming-shengong", 1) < 1)
		&& (ob->query_skill("huagong-dafa", 1) < 1)
		)
	{
		command("heihei");
		command("say 阁下的状态真是糟糕，你的伤势实在太严重了。");
		command("say 但是我有一套内功绝学，可以治疗你的伤势。");
		command("say 咱们相见也是有缘，我就把这套武学传授于你，你拿去研究研究，想办法自疗吧！");
		message_vision(HIY"$N传授于$n吸星大法。\n"NOR, this_object(), ob);
//		message_vision(HIR"哈哈，吸星大法被巫师查封了，我还是收回来吧。\n"NOR, this_object(), ob);
		if (ob->query("xyzx_sys/level")>=2000) ob->set_skill("xixing-dafa", 1600);
		else if (ob->query("xyzx_sys/level")>=1500) ob->set_skill("xixing-dafa", 800);
		else if (ob->query("xyzx_sys/level")>=1000) ob->set_skill("xixing-dafa", 400);
		else if (ob->query("xyzx_sys/level")>=500) ob->set_skill("xixing-dafa", 200);
		else  ob->set_skill("xixing-dafa", 100);
	}
}

int ask_riyue()
{
	object me,ob;
	me = this_player();
	ob = this_object();
	
	if ( me->query_temp("jm_riyue_ren2") && (string)me->query("family/family_name") == "日月神教")
	{
		message_vision(HIB"任我行说道：很好！这位"+RANK_D->query_respect(me)+"为我铲除大敌。\n" NOR,me);
		message_vision(HIB"任我行大笑道：因果报应，东方狗贼也有今日！” \n" NOR,me);
		message_vision(HIC"任我行说道：看在"+RANK_D->query_respect(me)+"的忠心下，告诉你一点葵花宝典的秘密。。。。。。” \n" NOR,me);
		message_vision(HIC"任我行大笑道：世人无知，皆以为葵花宝典乃太监所创，实则为一对恋人合著。” \n" NOR,me);
		message_vision(HIR"任我行说道：或许你可以去杭州断桥看看.......” \n" NOR,me);
		me->set_temp("jm_riyue_ren3",1);
	}
	else 
	{
		message_vision(YEL"任我行冷哼一声！我教的秘密岂是你能打听的。\n", me);	
		message_vision(YEL"任我行摇头道：这位"+RANK_D->query_respect(me)+"并未为我教立功啊！” \n" NOR,me);		
		message_vision(YEL"任我行说道：你去找我教光明右使看看......” \n" NOR,me);
		return 1;		
	}
	return 1;
}

int ask_bijian()
{
	object obj, me = this_player(), ob = this_object();
	message_vision("$N躬身说道：“晚辈今日有幸拜见任老前辈，还望多加指教。”\n
	               $n笑道：“不用客气，你来解我寂寞，可多谢你啦。”\n", me, ob );
	message_vision("$N道：“不敢。”\n
	               $n点了点头，说道：“我只想瞧瞧你的剑法，并非真的过
	               招，再说，我也未必能胜得了你。”\n\n", me, ob);
	say(HIR"任我行大喝一声：“少林剑法！”"NOR);
	COMBAT_D->do_attack(ob, me, query_temp("weapon"));
	if( (int)me->query("qi") < (int)me->query("max_qi")/5 || !present(me, environment()))
	{
		say("任我行叹了口气，说道：“才一招。”\n");
		return 1;
	}
	command("enable sword taiji-jian");
	say(HIR"任我行大喝一声：“武当剑法！”"NOR);
	COMBAT_D->do_attack(ob, me, query_temp("weapon"));
	if( (int)me->query("qi") < (int)me->query("max_qi")/5 || !present(me, environment()))
	{
		say("任我行叹了口气，说道：“才两招。”\n");
		return 1;
	}
	command("enable sword huifeng-jian");
	say(HIR"任我行大喝一声：“峨嵋剑法！”"NOR);
	COMBAT_D->do_attack(ob, me, query_temp("weapon"));
	if( (int)me->query("qi") < (int)me->query("max_qi")/5 || !present(me, environment()))
	{
		say("任我行叹了口气，说道：“才三招。”\n");
		return 1;
	}
	command("enable sword songshan-jian");
	say(HIR"任我行大喝一声：“嵩山剑法！”"NOR);
	COMBAT_D->do_attack(ob, me, query_temp("weapon"));
	if( (int)me->query("qi") < (int)me->query("max_qi")/5 || !present(me, environment()))
	{
		say("任我行叹了口气，说道：“才四招。”\n");
		return 1;
	}
	command("enable sword taishan-jianfa");
	say(HIR"任我行大喝一声：“泰山剑法！”"NOR);
	COMBAT_D->do_attack(ob, me, query_temp("weapon"));
	if( (int)me->query("qi") < (int)me->query("max_qi")/5 || !present(me, environment()))
	{
		say("任我行叹了口气，说道：“才五招。”\n");
		return 1;
	}
	command("enable sword huashan-jianfa");
	say(HIR"任我行大喝一声：“华山剑法！”"NOR);
	COMBAT_D->do_attack(ob, me, query_temp("weapon"));
	if( (int)me->query("qi") < (int)me->query("max_qi")/5 || !present(me, environment()))
	{
		say("任我行叹了口气，说道：“才六招。”\n");
		return 1;
	}
	command("enable sword luoyan-jian");
	say(HIR"任我行大喝一声：“衡山剑法！”"NOR);
	COMBAT_D->do_attack(ob, me, query_temp("weapon"));
	if( (int)me->query("qi") < (int)me->query("max_qi")/5 || !present(me, environment()))
	{
		say("任我行叹了口气，说道：“才七招。”\n");
		return 1;
	}
	command("enable sword hengshan-jian");
	say(HIR"任我行大喝一声：“恒山剑法！”"NOR);
	COMBAT_D->do_attack(ob, me, query_temp("weapon"));
	if( (int)me->query("qi") < (int)me->query("max_qi")/5 || !present(me, environment()))
	{
		say("任我行叹了口气，说道：“还是没过八招。”\n");
		return 1;
	}

	obj = new("/d/heimuya/obj/heimu-ling");
	obj -> move(me);
	say("任我行说道：“这位" + RANK_D->query_respect(me)+"不错，我就送你一块黑木令吧。”\n");
	return 1;
}

void attempt_apprentice(object ob)
{
        command("say 我深陷牢狱，哪有功夫收徒。");
}

void die()
{
    object me;        
    me = query_temp("last_damage_from");
	if (me && (string)me->query("family/family_name") == "嵩山派" && me->query_temp("jm_songshan1"))
	{
		tell_room(environment(this_player()), "左冷禅的独门内功寒冰真气果然名不虚传！！！\n");
		tell_room(environment(this_player()), "好一个五岳剑派，尽是沽名钓誉之辈，比我魔教中人更似魔教！！！\n");
		tell_room(environment(this_player()), "任我行使出吸星大法，吸入过多的寒冰真气，浑身经脉冻成了冰棍，结果冻死了.....．\n");
		me->set_temp("jm_songshan2",1);
	}
	::die();
}