// xian.c
inherit NPC;
inherit F_MASTER;
#include <ansi.h>;
void create()
{
	int jibie;
	jibie = 4000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性	
        set_name("定闲师太", ({ "dingxian shitai", "shitai", "dingxian" }) );
        set("gender", "女性");
        set("title", HIB"恒山派第十二代掌门"NOR);
        set("class", "bonze");
        set("age", 45);
        set("attitude", "peaceful");
        set("per", 24);
        set("str", 26);
        set("con", 30);
        set("dex", 30);
        set("int", 28);

        set("neili", 2400);
        set("max_neili", 2400);
        set("jiali", 30);
        set("max_qi",2000);
        set("max_jing",1200);
        set("combat_exp", 1200000);
        set("shen_type", 1);

        set_skill("unarmed", 500+jibie/3+random(jibie/5));
        set_skill("sword", 500+jibie/3+random(jibie/5));
        set_skill("force", 500+jibie/3+random(jibie/5));
        set_skill("parry", 500+jibie/3+random(jibie/5));
        set_skill("dodge", 500+jibie/3+random(jibie/5));
        set_skill("hengshan-jian", 500+jibie/3+random(jibie/5));
        set_skill("lingxu-bu", 500+jibie/3+random(jibie/5));

        map_skill("sword", "hengshan-jian");
        map_skill("parry", "hengshan-jian");
        map_skill("dodge", "lingxu-bu");

        create_family("恒山派", 12, "掌门");
        setup();

        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/d/shaolin/obj/xuan-cloth")->wear();
}

void attempt_apprentice(object ob)
{
	string oldtitle;
	oldtitle = ob->query("title");
	if ((int)ob->query("shen") < 10000  )
	{
		command("say 我恒山派向来行侠仗义，您请回吧！");
		return;
	}
	if ((int)ob->query_skill("hengshan-jian",1) < 1000 )
	{
		command("say 你的恒山剑法太低了,还是努努力先提高一下吧!");
		return;
	}
	if ((int)ob->query("int",1) < 30 )
	{
		command("say 我恒山剑法最重悟性!");
		return;
	}
	command("nod");
	command("say " + RANK_D->query_respect(ob) + "资质不错，望你能将我恒山派发扬光大！\n");
	command("recruit " + ob->query("id") );
	return;
}