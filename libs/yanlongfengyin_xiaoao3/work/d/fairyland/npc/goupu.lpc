// goupu.c 狗仆

inherit NPC;

void create()
{
	int jibie;
	jibie = 10;
	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性	
	set_name("狗仆", ({"gou pu", "pu"}));
	set("gender", "男性");
	set("age", 35);

	set("combat_exp", 4000);
        set_skill("dodge", 20);
        set_skill("unarmed", 20);
        set_temp("apply/attack",  10);
        set_temp("apply/defense", 10);
	set("shen_type", -1);
	setup();
}
	
