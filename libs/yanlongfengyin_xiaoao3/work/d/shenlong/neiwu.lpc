//mishi by suimeng 2015.3
inherit ROOM;
#include <ansi.h>
void create() {
  set("short", "内屋");
  set("long", @LONG
一进小屋，只见墙上挂满了无数名贵的字画，书架上也堆满了平时
难得一见的各种各样的书籍。这里的秘籍似乎与外屋有所不同。你
可以尝试翻阅一番（fanyue)。
LONG);

  set("exits", ([
    "out": "/d/shenlong/xiaowu",
  ]));
  setup();
}

void init() {
  add_action("do_fanyue", "fanyue");
}

int do_fanyue(string arg) {
  object me = this_player();

  string *poem = ({
    "这本秘籍，似乎是「" HIM "化骨绵掌" NOR "」，为什么会有这么大威力？",
    "这本秘籍，似乎是「" HIG "神龙三绝唱" NOR "」，似乎又有些不同。",
    "这本秘籍，似乎是「" HIW "神龙八式" NOR "」，为什么如此迅猛无比？？",
    "这本秘籍，似乎是「" HIY "形意步" NOR "」，怎样心随意走....",
    "这本秘籍，似乎是「" HIB "神龙心法" NOR "」的修炼心得，然来如此！！！",
  });

  if (me->is_busy())
    return notify_fail("你现在忙着呢，哪有功夫翻阅书架上的秘籍...\n");
  if ((int)me->query_skill("literate", 1) < 2000)
    return notify_fail("你钻研书架上的秘籍，可能是文学功底太差，始终无法领悟其精要。\n");
  if (!me->query("jm/42book"))
    return notify_fail("你还没有替神龙教挖掘大清宝藏，洪教主恐怕不会允许你翻阅秘籍。\n");
  if (!me->query_temp("jm_shenlong5") || me->query("family/family_name") != "神龙教" || me->query("family/master_id") != "hong antong")
    return notify_fail("你未获得神龙教洪教主的同意，无权翻阅秘籍。\n");
  if (me->query_skill("shenlong-xinfa", 1) < 1000)
    return notify_fail("你的神龙心法太低，钻研秘籍有走火入魔之危。\n");
  if (me->query_skill("shedao-qigong", 1) < 2000)
    return notify_fail("你的蛇岛奇功太低，钻研这些秘籍太早了点。\n");
  if (me->query_skill("shenlong-bashi", 1) < 2000)
    return notify_fail("你的神龙八式太低，这些秘籍对你来说太深奥了。\n");
  if (me->query("jm/shenlong"))
    return notify_fail("你已经贯通了神龙教武功精髓了，这里对你来说已无堪大用。\n");
  if (me->query("jingli") < 1000)
    return notify_fail("你疲惫难堪，还是休息会吧。\n");

  tell_object(me, HIW "你仔细翻阅书架上的秘籍，尝试着练习了下......\n" NOR);
  message_vision("$N仔细的研究着书架上的秘籍：" + poem[random(sizeof(poem))] + "\n", me);
  me->add("jingli", -1000);
  me->start_busy(1);

  if (random(100000) < me->query("kar", 1)) {
    me->set("jm/shenlong", 1);
    me->add("family_score", 1);
    tell_object(me, HIY "你突然醒悟道：" HIY "原来神龙八式可以有此等威力" HIR "！\n" NOR);
    tell_object(me, HIY "恭喜你融汇贯通了神龙教武功的精髓！\n" NOR);
    message(
      "channel:chat",
      HIM "【天降奇才】" HIM + "听说" + me->query("name") + "天纵奇才，在神龙岛内屋居然领悟了神龙教的终极奥义！\n" NOR,
      users()
    );
  }
  return 1;
}
