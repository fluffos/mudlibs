
inherit NPC;

void create()
{
	int jibie;
	jibie = 6;
	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性
        set_name("蜜蜂", ({ "bee" }) );
        set("race", "野兽");
        set("age", 1);
        set("long", "一只疯狂的杀人蜂\n");

        set("limbs", ({ "头部", "身体", "尾巴" }) );
        set("verbs", ({ "bite" }) );

        set_skill("dodge", 50);
        set("combat_exp", 500);
	set("bellicosity", 3000 );

        setup();
}

