// baizhen.c

#include <ansi.h>

inherit NPC;

void create()
{
	int jibie;
	jibie = 1000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
	set_name("白振", ({ "bai zhen", "bai", "zhen"}) );
	set("title", "御前侍卫");
	set("nickname", HIY"金爪"HIB"铁钩"NOR);
	set("gender", "男性");
	set("age", 64);
	set("long","白振是嵩山派高手，三十年前就驰名武林了。\n");
	set("combat_exp", 450000);
        set("shen_type", 1);
	set("attitude", "heroism");

	set_skill("unarmed", 500+jibie/3+random(jibie/5));
	set_skill("blade", 500+jibie/3+random(jibie/5));
	set_skill("claw", 500+jibie/3+random(jibie/5));
	set_skill("parry", 500+jibie/3+random(jibie/5));
	set_skill("dodge", 500+jibie/3+random(jibie/5));
	set_skill("sougu", 500+jibie/3+random(jibie/5));
	set_skill("lingxu-bu", 500+jibie/3+random(jibie/5));
	map_skill("dodge", "lingxu-bu");
	map_skill("claw", "sougu");
	map_skill("parry", "sougu");
	prepare_skill("claw", "sougu");

	setup();
    carry_object("/clone/armor/tiejia")->wear();

	add_money("silver", 30);
}
