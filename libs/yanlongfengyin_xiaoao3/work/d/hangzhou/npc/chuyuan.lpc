// chuyuan.c

#include <ansi.h>

inherit NPC;

void create()
{
	int jibie;
	jibie = 500;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
	set_name("褚圆", ({ "chu yuan", "chu", "yuan"}) );
	set("title", "御前侍卫");
	set("gender", "男性");
	set("age", 34);
	set("long","褚圆原是和尚，法名智圆，后来犯了清规，被追缴度牒，逐出庙门，他索性还了俗，做了大内侍卫。\n");
	set("combat_exp", 350000);
        set("shen_type", -1);
	set("attitude", "heroism");

	set_skill("unarmed", 500+jibie/3+random(jibie/5));
	set_skill("sword", 500+jibie/3+random(jibie/5));
	set_skill("parry", 500+jibie/3+random(jibie/5));
	set_skill("dodge", 500+jibie/3+random(jibie/5));
	set_skill("damo-jian", 500+jibie/3+random(jibie/5));
	set_skill("shaolin-shenfa", 500+jibie/3+random(jibie/5));
	map_skill("sword", "damo-jian");
	map_skill("parry", "damo-jian");
	map_skill("dodge", "shaolin-shenfa");

	setup();
        carry_object("/clone/armor/tiejia")->wear();
        carry_object("/clone/weapon/changjian")->wield();

	add_money("silver", 10);
}
