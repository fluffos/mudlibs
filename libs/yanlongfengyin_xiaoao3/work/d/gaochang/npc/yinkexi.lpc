// zuo.c

inherit NPC;
#include <ansi.h>

void create() {
  int jibie;
  jibie = 3000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("尹克西", ({ "yin kexi", "yin", "kexi" }));
  set("title", HIY "波斯商人" NOR);
  set("gender", "男性");
  set("age", 55);
  set("attitude", "peaceful");
  set("str", 30);
  set("con", 30);
  set("dex", 30);
  set("int", 28);

  set("neili", 2240000);
  set("max_neili", 224000);
  set("jiali", 11230);
  set("max_qi", 1200000);
  set("max_jing", 521200);

  set("combat_exp", 8000000);
  set("shen_type", -1);

  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("whip", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("nianhua-zhi", 500 + jibie / 3 + random(jibie / 5));
  set_skill("riyue-bian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("fumo-jian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("shaolin-shenfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("hunyuan-yiqi", 500 + jibie / 3 + random(jibie / 5));
  map_skill("unarmed", "nianhua-zhi");
  map_skill("sword", "fumo-jian");
  map_skill("parry", "riyue-bian");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("force", "hunyuan-yiqi");
  map_skill("whip", "riyue-bian");

  setup();

  carry_object("/clone/weapon/hanbing-bian")->wield();
  carry_object("/clone/weapon/hanbing-jian")->wield();
  carry_object("/clone/cloth/baipao")->wear();
}


void die() {
  object me;
  me = query_temp("last_damage_from");
  if (me && (string)me->query("family/family_name") == "昆仑派" && me->query("family/master_id") == "he zudao" && me->query_temp("jm_kunlun2")) {
    tell_room(environment(this_player()), "尹克西临终之前，幡然醒悟，然为时已晚，只求你为少林派觉远襌师转达几句话。\n");
    tell_room(environment(this_player()), "尹克西弥留之际只断断续续的吐出几个字：...经...在...猴...中...！！！\n");
    tell_room(environment(this_player()), "尹克西气息越来越弱，连续吐出几口鲜血，头一歪，死了.....．\n");
    me->set_temp("jm_kunlun3", 1);
  }
  ::die();
}
