
inherit NPC;
#include <ansi.h>

int ask_hbd(object me, object ob);

void create()
{
	int jibie;
	jibie = 60;
	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性
        set_name("老汉", ({ "old man", "old", "man" }) );
        set("gender", "男性" );
        set("age", 63);
        set("shen_type", 1);
        set("combat_exp", 10000);
        set("str", 20);
        set("dex", 20);
        set("con", 20);
        set("int", 20);
        set("attitude", "peaceful");
        set("inquiry",([  
                "黑白道" : (: ask_hbd :),  
                               ]) );  
        setup();
        carry_object("/clone/cloth/cloth")->wear();
}

