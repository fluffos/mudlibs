// suxingh.c
// shilling 97.2
inherit NPC;
inherit F_MASTER;
string ask_me();
string ask_book();
void create()
{
	int jibie;
	jibie = 3000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
    set_name("苏星河",({"su xinghe","su"}));
    set("gender", "男性" );
    set("nickname", "聪辩老人");
    set("shen_type", 0);
    set("age",60);
    set("str", 30);
    set("con", 30);
    set("int", 45);
    set("dex", 35);
    set("per", 30);
    set("no_clean_up",1);
    set("long",
"此人就是号称聪辩老人的苏星河，据说他能言善辩， \n"
"是一个武林中的智者，而他的武功也是无人能知。\n");
    set("combat_exp", 500000);
    set("attitude", "peaceful");
    set("book_count", 1);
    set("chat_chance", 1);
    set("inquiry", ([
//        "秘密地道":(:ask_me:),
        "秘籍":(:ask_book:),
    ]) );
    set("max_qi", 3400);
    set("max_jing", 400);
    set("neili", 6500);
    set("max_neili",3500);
    set("jiali", 60);
    set_skill("force", 500+jibie/3+random(jibie/5));
    set_skill("dodge", 500+jibie/3+random(jibie/5));
    set_skill("unarmed", 500+jibie/3+random(jibie/5));
    set_skill("parry", 500+jibie/3+random(jibie/5));
    set_skill("blade", 500+jibie/3+random(jibie/5));
    set_skill("lingboweibu", 500+jibie/3+random(jibie/5));
    set_skill("beiming-shengong", 500+jibie/3+random(jibie/5));
    set_skill("ruyi-dao", 500+jibie/3+random(jibie/5));
    set_skill("zhemei-shou", 500+jibie/3+random(jibie/5));
    set_skill("literate", 500+jibie/3+random(jibie/5));
    map_skill("unarmed", "zhemei-shou");
	map_skill("parry", "zhemei-shou");
    map_skill("blade", "ruyi-dao");
    map_skill("dodge", "lingboweibu");
    map_skill("force", "beiming-shengong");

    create_family("逍遥派", 4, "弟子");
    set("title","逍遥派第四代大弟子");
    setup();
    carry_object("clone/cloth/cloth")->wear();
    carry_object("clone/weapon/blade")->wield();
}

void attempt_apprentice(object ob)
{
    if (ob->query("int",1) < 25) 
	{
        command("shake"+ ob->query("id")); 
        command("say " + RANK_D->query_respect(ob) +  "以你的悟性恐怕难以领会我逍遥派武学精妙之处？");
        return;
    }
	if (ob->query("family/family_name")!="逍遥派")
	{
        command("say 你先去找薛慕华拜师吧 ？！\n");
		return ;		
	}
	if ((int)ob->query_skill("beiming-shengong", 1) < 300) 
	{
		command("say 我逍遥派内功的源泉来自于北冥神功的心法。"); 
		command("say " + RANK_D->query_respect(ob) +  "的北冥神功是否还应该有所提高啊？");
		return;
	}
    command("say 好吧，我就收下你了，今后要多加努力啊！");
    command("recruit " + ob->query("id"));
//    ob->set("class","shaman");
	return;
 }
string ask_book()
{
    object ob;
    mapping fam; 
    ob=this_player();
    if (!(fam = ob->query("family")) 
        || fam["family_name"] != "逍遥派")
    {
        return"想要秘籍就得加入逍遥派。";
    }
    command("sigh");
    return"本派的武功秘籍藏在一个很秘密的地方，我也没去过。";
}
void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "xiaoyao");
}
mixed hit_ob(object me,object victim,int damage)
{
   if (!living(this_object()) )  return;
   switch( random(2)) { 
   case 0:
   command("exert maxsuck "+victim->query("id"));
   break;
   case 1:
   command("exert suck "+victim->query("id"));
   break;
    }
}
