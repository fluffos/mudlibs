// xiaoxilou.c

#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int ask_me();
int ask_qiushui();
int ask_yuefei();

void create()
{
	int jibie;
	jibie = 7000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
        set_name("萧西楼", ({ "xiao xilou", "xiao" }) );
        set("gender", "男性");
        set("age", 60);
        set("long", "萧西楼是浣花剑派的掌门，他是个年近六旬的老人，身板硬朗得很。\n");
        set("attitude", "peaceful");
		set("shen_type", 0);
        set("str", 50);
        set("cor", 30);
        set("int", 24);
        set("dex", 30);
        set("per",25);
        set("neili", 6000000);
        set("max_neili", 3000000);
        set("jiali", 5500);
        set("max_jing", 1100000);
        set("max_qi", 3000000);
        set("combat_exp", 300000000);
        set("score", 200000);
        set("shen",15000);

        set("inquiry", ([
                "难事" : (: ask_me :), 
                "帮忙" : (: ask_me :),
				"萧秋水" :(: ask_qiushui :),
				"岳元帅" :(: ask_yuefei :),
        ]));
        
        set_skill("cuff", 500+jibie/3+random(jibie/5));
        set_skill("strike",500+jibie/3+random(jibie/5));
        set_skill("force", 500+jibie/3+random(jibie/5));    
        set_skill("dodge", 500+jibie/3+random(jibie/5));    
        set_skill("parry", 500+jibie/3+random(jibie/5));    
        set_skill("sword", 500+jibie/3+random(jibie/5));    
        set_skill("literate",500+jibie/3+random(jibie/5));    
        set_skill("unarmed",500+jibie/3+random(jibie/5));    
        set_skill("huanhua-jian",500+jibie/3+random(jibie/5));    
        set_skill("tiexian-quan",500+jibie/3+random(jibie/5));    
        set_skill("guiyuan-dafa",500+jibie/3+random(jibie/5));    
        set_skill("feihua-wuping",500+jibie/3+random(jibie/5));    
        map_skill("force","guiyuan-dafa");
        map_skill("unarmed","tiexian-quan");
        map_skill("sword","huanhua-jian");
        map_skill("dodge","feihua-wuping");
        map_skill("parry","huanhua-jian");     
        create_family("浣花剑派", 1, "掌门人"); 
  
        setup();
        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/d/huanhua/obj/ccloth")->wear();    
}

void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	say("萧西楼叹了口气:孩子不在身边，心里挺挂念的。\n");
}

int ask_me()
{
	object me,ob;
	mapping fam;
	me=this_player();
	ob = this_object();

	if (!(fam = this_player()->query("family")) || fam["family_name"] != "浣花剑派") 
	{
		say("你并非本派弟子，不知此话从何谈起？");
		return 1;
	}

	command("sigh");
	command("say 这位"+RANK_D->query_respect(me)+",易人出门已经很长时间了。");
	command("say 你能不能帮我打听一下他的消息？");
	me->set_temp("find_ren",1);
	return 1;
}
//问萧秋水，杀唐老太太
int ask_qiushui()
{
	object me,ob;
	me = this_player();
	ob = this_object();
	
	if ( (string)me->query("family/family_name") != "浣花剑派")
	{
		tell_object(me,GRN"萧西楼说道：那是我的三公子，最爱打抱不平。\n"NOR);
		return 1;
	}

	tell_object(me,HIC"这位"+RANK_D->query_respect(me)+",我儿秋水数年前去了蜀中，至今未归......你能不能帮我打听一下他的消息？\n"NOR);
	tell_object(me,HIC"曾听江湖传闻，我儿秋水大战唐老爷子，被困于唐门地牢？？？\n"NOR);
	me->set_temp("jm_huanhua4",1);	
	return 1;
}
//问岳飞，给方天画戟，给醉月玄晶
int ask_yuefei()
{
	object me,ob;
	me = this_player();
	ob = this_object();
	
	if ( (string)me->query("family/family_name") != "浣花剑派")
	{
		tell_object(me,GRN"萧西楼冷哼一声，岳元帅的事迹也是你能随便问的！！！\n"NOR);
		return 1;
	}

	tell_object(me,HIC"这位"+RANK_D->query_respect(me)+"，昔年岳元帅发出「天下英雄令」，欲北征迎回二圣，结果......\n"NOR);
	tell_object(me,HIC"当年岳元帅气势如虹，本可收付燕云，耐尔国贼当道！！！\n"NOR);
	tell_object(me,HIC"听闻岳元帅被害之后，其神兵方天画戟杳无踪迹......\n"NOR);
	me->set_temp("jm_huanhua1",1);
	return 1;
}
int accept_object(object who, object ob)
{
	if ( ob->query("id") == "black sword" )
	{
		if ( who->query_temp("find_ren") && (string)who->query("family/family_name") == "浣花剑派")
		{
			tell_object(who,GRN"萧西楼对你由衷地表示感谢，你得到了50点潜能和200点经验。\n"NOR);
			who->add("combat_exp",200);
			who->add("potential", 50);		
			who->start_busy(2);
			who->delete_temp("find_ren");
			return 1;				
		} else
		{
			message_vision("萧西楼对$N笑道：咦，这东西怎么跑到你那里去了？我还是收起来吧！\n",who);
			return 1;
		}
	} 
	if ( ob->query("id") == "fangtian huaji" )
	{
		if ( who->query_temp("jm_huanhua1") && (string)who->query("family/family_name") == "浣花剑派")
		{
			tell_object(who,GRN"萧西楼对你由衷地表示感谢道：这位"+RANK_D->query_respect(who)+"总算不负众望，为我萧家找回了岳元帅的兵器。\n"NOR);	
			tell_object(who,GRN"萧西楼低声叹气道：我萧家满门忠烈，可惜朝廷奸相当权，未能救回岳元帅......惭愧啊...\n"NOR);	
			tell_object(who,HIC"萧西楼抚摸着方天画戟，忆往昔，怒发冲冠，壮怀激烈。。。\n"NOR);	
			tell_object(who,HIC"萧西楼抖出一个枪花，神兵微颤...没想到当年一战，神兵居然有损！！！\n"NOR);
			tell_object(who,HIC"萧西楼说道：听说世间有一种宝物，可修复神兵，若你能招来？？......似乎是醉月玄晶。\n"NOR);			
			who->set_temp("jm_huanhua2",1);
			return 1;				
		} else
		{
			message_vision("萧西楼对$N笑道：咦，这种宝物怀璧其罪，还是我收起来吧！\n",who);
			return 1;
		}
	} 
	if ( ob->query("id") == "zuiyue xuanjing" )
	{
		if ( who->query_temp("jm_huanhua2") && (string)who->query("family/family_name") == "浣花剑派")
		{
			tell_object(who,HIB"萧西楼拍了拍你的头，这位"+RANK_D->query_respect(who)+"一表人才，有此宝物必能修复岳元帅的兵器。\n"NOR);	
			tell_object(who,HIB"萧西楼说道：神兵重现，江湖有我。\n"NOR);
			if (who->query_temp("jm_huanhua5")) tell_object(who,HIM"萧西楼说道：这位"+RANK_D->query_respect(who)+"有恩我萧家，可去萧家发源地浣花溪畔感悟。\n"NOR);
			who->set_temp("jm_huanhua3",1);
			return 1;				
		} else
		{
			message_vision("萧西楼对$N笑道：咦，这种宝物怀璧其罪，还是我收起来吧！\n",who);
			return 1;
		}
	}	
	return 0;
}

void attempt_apprentice(object ob)
{
	if ((int)ob->query("xyzx_sys/level")<1000)
    {
        command("say 这位"+RANK_D->query_respect(ob)+"实战能力太差了，还是去江湖上历练吧。");
        command("say 是否应该去江湖中多加磨炼。");
		return ;
    }
     if ( ob->query_skill("guiyuan-dafa",1) < 1000 )
        {
           command("say 这位"+RANK_D->query_respect(ob)+"对我浣花派内功似乎领会的不够。");
           return ;
        }
        if ((int)ob->query("score") < 10000 ) {
                command("say 你对本门的贡献还不够,还得努力呀!");
                return;
        }
	if ((int)ob->query("int",1)<25)
    {
        command("say 这位"+RANK_D->query_respect(ob)+"悟性太差了，还是去吃点药吧。");
		return ;
    }
	if ((int)ob->query("dex",1)<25)
    {
        command("say 这位"+RANK_D->query_respect(ob)+"身法太差了，还是去吃点药吧。");
		return ;
    }	
        message_vision("萧西楼拍拍$N的头，微微点了点头。\n",ob);
        ob->set("class", "swordsman");
        ob->set("title","浣花剑派二代弟子");   
        command("recruit " + ob->query("id"));
        return;
}


