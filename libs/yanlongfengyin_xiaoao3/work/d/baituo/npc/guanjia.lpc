// woman.c
inherit NPC;
void create()
{
	int jibie;
	jibie = 100;
	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性	
	set_name("管家", ({ "guan jia","guan","jia" }) );
	set("gender", "男性" );
	set("age", 30);
	set("long", "一个老谋深算的老管家。\n");
	set("shen_type", -1);
	set("combat_exp", 20000);
	set("str", 24);
	set("dex", 22);
	set("con", 23);
	set("int", 20);
	set("attitude", "friendly");
	set("max_qi", 200);
	set("max_jing", 200);
	set("neili", 200);
	set("max_neili", 200);
	set("score", 2500);
	set_skill("force", 500+jibie/3+random(jibie/5));
	set_skill("dodge", 500+jibie/3+random(jibie/5));
	set_skill("unarmed", 500+jibie/3+random(jibie/5));
	set_skill("parry", 500+jibie/3+random(jibie/5));
	set_temp("apply/attack", 15);
	set_temp("apply/defense", 14);
	set_temp("apply/damage", 15);
	set_temp("apply/armor", 10);
	create_family("白驼山派", 4, "弟子");
	set("inquiry" ,([
	"储藏室" : "管家警惕地盯着你，说：你想偷东西吗？\n",
	]));
	setup();
	carry_object("/d/baituo/obj/baipao")->wear();
	carry_object("/d/baituo/obj/key");
}
