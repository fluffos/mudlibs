// man.c
inherit NPC;
void create() {
  int jibie;
  jibie = 60;
  set("xyzx_sys/level", jibie * 8 / 10 + random(jibie * 4 / 10));  //2016.5.22阿飞调整NPC属性	
  set_name("农民", ({ "man" }));
  set("gender", "男性");
  set("age", 29);
  set("long", "一个很健壮的壮年农民。\n");
  set("shen_type", 1);
  set("combat_exp", 2000);
  set("str", 20);
  set("dex", 18);
  set("con", 18);
  set("int", 18);
  set("attitude", "friendly");
  setup();
  carry_object("/clone/cloth/cloth")->wear();
  add_money("silver", 10);
}
