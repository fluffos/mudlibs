inherit NPC;
inherit F_MASTER;
#include <ansi.h>
int ask_wujue();

void create() {
  int jibie;
  jibie = 8000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("王重阳", ({ "wang chongyang", "wang" }));
  set("nickname", HIC "中神通" NOR);
  set("long",
    "他就是全真教开山祖师、中神通王重阳。\n"
    "身穿一件青灰色道袍，背一口七星剑。\n"
    "面色红润，看起来内功一定很高深。\n");
  set("gender", "男性");
  set("age", 70);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("str", 80);
  set("int", 30);
  set("con", 30);
  set("dex", 30);

  set("max_qi", 2128000);
  set("max_jing", 1225000);
  set("neili", 2000000);
  set("max_neili", 1000000);
  set("jiali", 3100);
  set("combat_exp", 80000000);
  set("score", 500000);


  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  //   	set_skill("tiangang-zhengqi", 500+jibie/3+random(jibie/5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("qixing-huanwei", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("jinyan-gong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("quanzhen-jianfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("xiantian-qigong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("qixing-array", 500 + jibie / 3 + random(jibie / 5));
  set_skill("taoism", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("haotian-zhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("duanyun-bian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("whip", 500 + jibie / 3 + random(jibie / 5));
  map_skill("whip", "duanyun-bian");
  map_skill("force", "xiantian-qigong");
  map_skill("dodge", "jinyan-gong");
  map_skill("unarmed", "haotian-zhang");
  map_skill("parry", "quanzhen-jianfa");
  map_skill("sword", "quanzhen-jianfa");

  create_family("全真教", 1, "开山祖师");
  set("class", "taoist");

  set("inquiry", ([
    "九阴真经": HIM "九阴真经....？？这本书我送给我师弟保管了.....\n...如果你是<一代大侠>而且能找回来送给我的话.....我会帮你稍做整理.....",
    "天下五绝": (: ask_wujue :),
  ]));
  setup();
  carry_object("/d/quanzhen/obj/qixingjian")->wield();
  carry_object("/d/quanzhen/obj/greenrobe")->wear();
}

void attempt_apprentice(object ob) {
  if ((string)ob->query("family/family_name") != "全真教" || (string)ob->query("class") != "sworder") {
    command("say 我全真乃是道家门派。");
    command("say " + RANK_D->query_respect(ob) + "若想拜我派需先入我道。");
    return;
  }
  if ((int)ob->query_skill("tiangang-zhengqi", 1) < 1000) {
    command("say 我全真教乃内家武功，最重视内功心法。");
    command("say " + RANK_D->query_respect(ob) +
      "是否还应该在天罡正气上多下点功夫？");
    return;
  }
  if ((int)ob->query("xyzx_sys/level") < 1000) {
    command("say 这位" + RANK_D->query_respect(ob) + "实战能力太差了，还是去江湖上历练吧。");
    command("say 是否应该去江湖中多加磨炼。");
    return;
  }
  if ((int)ob->query_skill("quanzhen-jianfa", 1) < 1000) {
    command("say 我全真教剑法扬名天下，天下无双。");
    command("say " + RANK_D->query_respect(ob) +
      "是否还应该在全真剑法上多下点功夫？");
    return;
  }
  if ((int)ob->query_skill("qixing-huanwei", 1) < 1000) {
    command("say 我教以轻功见长，最看中轻功。");
    command("say " + RANK_D->query_respect(ob) +
      "是否还应该在七星换位上多下点功夫？");
    return;
  }
  if ((int)ob->query("shen") < 100000) {
    command("say 学武之人，德义为先，功夫次之。");
    command("say 在德行方面，" + RANK_D->query_respect(ob) +
      "是否还做得不够？");
    return;
  }
  if (ob->query("con",) < 30) {
    command("say 我全真教武功全靠先天一口真气。");
    command("say 要能达到炉火纯青之境，根骨低不得。");
    command("say " + RANK_D->query_respect(ob) + "的体质还大有潜力可挖，还是请回吧。");
    return;
  }
  command("chat 好！好！！好！！！");
  command("chat 希望" + RANK_D->query_respect(ob) + "你能够学到我全真教的真髓！！");
  command("chat* pat " + ob->query("id"));

  command("recruit " + ob->query("id"));
  ob->set("title", HIC "全真教重阳真人传人" NOR);
}

