//全真教解密
int ask_wujue() {
  object me, ob;
  me = this_player();
  ob = this_object();

  if (me->query_temp("jm_quanzhen1") && me->query("family/master_id") == "wang chongyang") {
    message_vision(HIB "王重阳说道：当年华山论剑，天下高手齐聚华山之巅，以武论道。\n" NOR, me);
    message_vision(HIB "王重阳说道：承蒙各位高手抬举，尊吾为五绝之首！” \n" NOR, me);
    message_vision(HIB "王重阳说道：十年过去，昔日五绝之战，获益颇多！” \n" NOR, me);
    message_vision(HIC "王重阳说道：十年之约，然吾辈老矣。吾徒可代表为师去与昔日五绝切磋一二。” \n" NOR, me);
    me->set_temp("jm_quanzhen2", 1);
  } else {
    message_vision(YEL "王重阳笑道：非我嫡传弟子，如何能代表我去挑战天下五绝呢！” \n" NOR, me);
    message_vision(YEL "王重阳说道：一本九阴真经就搅的江湖动荡不安，吾徒下山去将九阴真经给寻回来吧！” \n" NOR, me);
    message_vision(YEL "再瞎叨叨，小心砍死你！！！\n", me);
    return 1;
  }

  return 1;
}

int accept_object(object me, object ob) {

  if ((string)ob->query("id") == "jiuyin zhenjing1") {
    message_vision("$N对$n说道：当年为了避免江湖动荡，而组织了华山论剑，由武功最高者获得《九阴真经》\n", this_object(), me);
    message_vision("$N对$n说道：这本武学关键之处，用梵语书写，如果修习方法不对，轻则武功尽废，重则立即毙命\n", this_object(), me);
    message_vision("$N对$n说道：你找到这半册经书，如果你能找到另外半册.........\n", this_object(), me);
    me->set_temp("tmark/jiuyin1", 1);
    return 1;
  }
  if ((string)ob->query("id") == "jiuyin zhenjing2") {
    if ((int)me->query_temp("tmark/jiuyin1") && me->query("shen") > 100000000) {
      message_vision("$N对$n说道：稍等片刻，我将这2本秘籍重新整理成册......\n", this_object(), me);
      message_vision("$N对$n说道：修炼此武学切记不可心浮气躁!!!!!!!!!\n", this_object(), me);
      message_vision("$N对$n说道：好了，这本《九阴真经》我已重新整理完毕，现在送给你！！！\n", this_object(), me);
      message_vision("$N对$n说道：<我曾经在终南山古墓留下对于九阴真经的一点心得，如果有缘，可以去参悟一下！>\n", this_object(), me);
      message_vision("$N对$n说道：希望你以后不要用此武学滥杀无辜，我本已不想涉入江湖是非，你还是速速离去吧！\n", this_object(), me);
      ob = new("/clone/book/jiuyin.lpc");
      ob->move(this_player());
      if (me->query("family/family_name") == "白驼山派") me->set_temp("jm/baituo1", 1);  //白驼山解密
      return 1;
    } else {
      message_vision("王重阳看了看$N送来的经书，说道：多谢了，此经书就暂时由我来保管吧！否则流入恶人之手..必将引起场江湖浩劫。\n", this_object(), me);
      return 1;
    }
  }
  if ((string)ob->query("id") == "jiuyin zhenjing") {
    if (me->query("family/family_name") == "全真教") {
      message_vision("$N对$n说道：当年华山论剑，就是为了这本九阴真经......\n", this_object(), me);
      message_vision("$N对$n说道：世人皆以为学得九阴真经就能独步江湖，实则忘了初心！\n", this_object(), me);
      message_vision("$N对$n说道：熙熙攘攘，皆为名利，吾派弟子切不可舍本逐末！\n", this_object(), me);
      me->set_temp("jm_quanzhen1", 1);  //全真教解密
      return 1;
    } else {
      message_vision("王重阳看了看$N送来的经书，说道：此经书就暂时由我来保管吧！否则流入恶人之手..必将引起场江湖浩劫。\n", this_object(), me);
      return 1;
    }
  }
  return 0;
}
