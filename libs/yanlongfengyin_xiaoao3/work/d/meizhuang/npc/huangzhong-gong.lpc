// huangzhong-gong.c
inherit NPC;
inherit F_MASTER;

void create()
{
	int jibie;
	jibie = 4000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
        set_name("黄钟公", ({ "huangzhong gong", "gong" }));
        set("title", "梅庄大庄主");
        set("long",
                "他就是梅庄四位庄主排行第一的黄钟公。\n"
                "身穿一件干干净净的黄色长袍。\n"
                "他已年愈六旬，身材中等，面容和蔼可亲。\n");
        set("gender", "男性");
        set("age", 62);
        set("class", "scholar");
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("str", 28);
        set("int", 28);
        set("con", 28);
        set("dex", 28);

        set("max_qi", 1000);
        set("max_jing", 1000);
        set("neili", 1000);
        set("max_neili", 1000);
        set("jiali", 100);
        set("combat_exp", 500000);
        set("shen", 15000);
        set("score", 60000);

        set_skill("force", 500+jibie/3+random(jibie/5));
        set_skill("wuzheng-xinfa", 500+jibie/3+random(jibie/5));
        set_skill("dodge", 500+jibie/3+random(jibie/5));
        set_skill("yaoming-dodge", 500+jibie/3+random(jibie/5));
        set_skill("parry", 500+jibie/3+random(jibie/5));
        set_skill("sword", 500+jibie/3+random(jibie/5));
        set_skill("wuyun-jianfa", 500+jibie/3+random(jibie/5));
        set_skill("literate", 500+jibie/3+random(jibie/5));
		set_skill("unarmed", 500+jibie/3+random(jibie/5));
		set_skill("qixian-wuxingjian", 500+jibie/3+random(jibie/5));
		set_skill("wuying-shenquan", 500+jibie/3+random(jibie/5));
		map_skill("unarmed", "wuying-shenquan");
        map_skill("force", "wuzheng-xinfa");
        map_skill("dodge", "yaoming-dodge");
        map_skill("parry", "wuyun-jianfa");
        map_skill("sword", "wuyun-jianfa");
		
        create_family("梅庄", 1, "大庄主");
        setup();
        carry_object("clone/weapon/changjian")->wield();
}

void attempt_apprentice(object ob)
{
        if ((int)ob->query_skill("wuzheng-xinfa",1) < 1000) {
                command("say 在我梅庄的内功上，" + RANK_D->query_respect(ob) +
                        "是否还应该多下点功夫？");
                return;
        }
        if ((int)ob->query_skill("force",1) < 1000) {
                command("say 你的基本内功不够娴熟。");
                return;
        }
        if ((int)ob->query("max_neili") < 100000) {

                command("say 你的内力不够深厚。");
                return;
        }		
        if ((int)ob->query("con",1) < 30) {

                command("say 七弦无形剑全靠内功，没有优秀的根骨是练不成的。");
                return;
        }		
        command("say 好吧，在下就收下你了。");
        command("recruit " + ob->query("id"));
		return;
}

