  );
  set("neili", 50000);
  set("jingli", 30000);
  set("max_neili", 50000);
  set("max_jingli", 30000);
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("cuff", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("youran-bu", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yudi-bian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("whip", 500 + jibie / 3 + random(jibie / 5));
  set_skill("jieniu-dao", 500 + jibie / 3 + random(jibie / 5));
  set_skill("blade", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yiqiguan-riyue", 500 + jibie / 3 + random(jibie / 5));
  set_skill("throwing", 500 + jibie / 3 + random(jibie / 5));
  set_skill("youren-jian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("tianhe-jian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("throwing", 500 + jibie / 3 + random(jibie / 5));
  set_skill("taoism", 500 + jibie / 3 + random(jibie / 5));
  set_skill("feixue-quan", 500 + jibie / 3 + random(jibie / 5));
