#include <ansi.h>

inherit NPC;
int ask_me();
inherit F_MASTER;
#include "xiao.h"
#include "huajob.h"
#include "cloth.h"

void create()
{
	int jibie;
	jibie = 2000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
        set_name("华危楼",({"hua weilou","hua"}));
        set("nickname",WHT"震天叟"NOR);
       set("shen_type",0);
        set("gender","男性");
        set("int",30);  
        set("con",30);
        set("str",30);
        set("dex",30);
        set("bac",40);
        set("age",40);
        set("gu",1);
        set("attitude","peaceful");
        set("combat_exp",5000000);
        set("shen",1000);
        set("long",
"英俊潇洒,但始终看不破一个情字，最后也殉情了。\n"
        );
        set("neili",20000);
        set("jingli",18000);
        set("max_neili",20000);
        set("max_jingli",18000);
        set_skill("literate",500+jibie/3+random(jibie/5));
        set_skill("cuff",500+jibie/3+random(jibie/5));
        set_skill("parry",500+jibie/3+random(jibie/5));
        set_skill("dodge",500+jibie/3+random(jibie/5));
        set_skill("jieniu-dao",500+jibie/3+random(jibie/5));
        set_skill("blade",500+jibie/3+random(jibie/5));
        set_skill("youran-bu",500+jibie/3+random(jibie/5));
        set_skill("tianhe-jian",500+jibie/3+random(jibie/5));
        set_skill("sword",500+jibie/3+random(jibie/5));
        set_skill("force",500+jibie/3+random(jibie/5));
        set_skill("taoism",500+jibie/3+random(jibie/5));
        set_skill("feixue-quan",500+jibie/3+random(jibie/5));
        set_skill("huaxue-dafa",500+jibie/3+random(jibie/5));
        map_skill("blade","jieniu-dao");
        map_skill("force","huaxue-dafa");
        map_skill("dodge","youran-bu");
        map_skill("cuff","feixue-quan");
        map_skill("sword","tianhe-jian");
        prepare_skill("cuff","feixue-quan");
        
       create_family("血河派",14,"弟子");
        setup();
        carry_object("/d/xuehepai/obj/cloth2")->wear();

       set("inquiry",([
 //                "job" : (: ask_job :),
				 "震天鼓" : (: ask_me :),
       ]));	
}

        



int ask_me()
{
           object ob;
           mapping fam;

           object me=this_player();

           fam=(mapping)me->query("family");

           if (!fam || fam["family_name"]!="血河派")
           {
                  command("say 你与本派并无瓜葛，此话从何说起？");
                  return 1;
           }
           else if (fam["master_id"]!="hua weilou")
           {
                  command("say 你不是我的弟子。");
                  return 1;
           }
           if (me->query("combat_exp")<300000)
           {
                  command("say 你的实战经验太低了。");
                  return 1;
           }
           if (!query("gu"))
           {
                 command("say 震天鼓已经被拿走了。");
                 return 1;
            }
                  command("say 好吧，我把震天鼓交给你。");
                   set("gu",0);
                  ob=new("/d/xuehepai/obj/gu");
                  ob->move(me);
                  return 1;
}
