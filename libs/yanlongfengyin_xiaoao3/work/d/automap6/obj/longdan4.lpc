inherit ITEM;
#include <ansi.h>

void init()
{
	add_action("do_eat", "eat");
	}
void create()
{
	set_name(HIR"千年火龙丹"NOR, ({"huolong dan", "dan"}));
	set("unit", "颗");
	set("long", "这是一颗千年火龙的内丹，拥有神奇的功效。\n");
	setup();
}

int do_eat(string arg)
{
	int fw1,fw2;
	object me = this_player();
	if (!id(arg))  return notify_fail("你要吃什么？\n");
	if (me->is_busy() ) return notify_fail("别急，慢慢吃，小心别噎着了。\n");
	
	if(arg=="dan")
	{
		me->add("max_neili",100);
        me->add("max_jingli",100);
		me->add("combat_exp", 1000000);
		me->add("potential",100000);	
        fw1 = (int)me->max_food_capacity();
        me->set("food", fw1);
        fw2 = (int)me->max_water_capacity();
        me->set("water", fw2);
	 	me->set("neili",me->query("max_neili")*2-1);
		me->set("jingli",me->query("max_jingli")*2-1);
	 	me->set("eff_qi",me->query("max_qi"));
		me->set("eff_jing",me->query("max_jing"));
	 	me->set("qi",me->query("max_qi"));
		me->set("jing",me->query("max_jing"));
		me->clear_condition(0);		
        message_vision(HIR"$N吃下一颗千年火龙丹，只觉一股火热之气直冲丹田，四肢百骸说不出的舒服!\n"NOR,me);
		destruct(this_object());
	}
	return 1;
}
