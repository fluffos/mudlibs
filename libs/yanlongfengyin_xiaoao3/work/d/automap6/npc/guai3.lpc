// 毒龙  20%爆火龙宝石

#include <ansi.h>

inherit NPC;


void create()
{
	int jibie;
	jibie = 3000;
	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性
	set_name(MAG"毒龙"NOR, ({ "du long" , "long" , "dragon" }));
	set("race", "野兽");
	set("long", "一条浑身发紫，丑陋不堪的巨龙，看到了你，向你扑了过来。\n");
	set("limbs", ({ "头部", "身体", "尾巴" }) );
	set("verbs", ({ "bite" , "claw"}) );
	set("attitude", "aggressive");
	set("vendetta/authority", 1);
	set("no_suck",1);
//	set("no_zhineng", 1);
//	set("is_boss", 1);
    set("env/wimpy", 50);
	set("shen_type", 0);
	set("age", 80);

	set_skill("dodge",500+jibie*2+random(jibie/5));
	set_skill("force",500+jibie*2+random(jibie/5));
	set_skill("parry",500+jibie*2+random(jibie/5));
	set_skill("unarmed",500+jibie*2+random(jibie/5));
	set_skill("spells",500+jibie*2+random(jibie/5));
	set_skill("dragon",500+jibie/2+random(jibie/5));
	set_skill("taixuan-gong",500+jibie/2+random(jibie/5));
	map_skill("unarmed", "dragon");
	map_skill("dodge", "dragon");
	map_skill("parry", "dragon");
	map_skill("force", "taixuan-gong");
	set("chat_chance_combat", 50);
	set("chat_msg_combat", ({
		(: perform_action, "unarmed.penhuo" :),
		(: perform_action, "unarmed.tuwu" :),
		(: perform_action, "unarmed.yaoyao" :),
		}) );


	setup();
	if (random(5)==0) carry_object("/d/automap6/obj/longdan"+(1+random(3)));
}


void init()
{
	object ob, me;
    
	me = this_object();
    ob = this_player();

	::init();

	// 怪物必须是可以动作的，并只针对玩家
	if ( !objectp(ob) || !living(me) || !playerp(ob) ) return;
    // 见面就打
	me->kill_ob(ob);
	// 拦路
	add_action("do_go", "go");
	// 跟随
	command("follow "+ob->query("id"));
	
}

void die()
{
	object ob, me, corpse, baoshi, env;
	string room;
	int m,k1;
	int flag;
	flag = 1;
	ob = this_object();

	// 先绑定到打晕的对象上
	if ( !objectp(me = ob->query_temp("last_unconcious_from")) )
		me = ob->query_temp("last_damage_from"); // 绑定到最后伤害对象
	if ( !objectp(me) // 未成功绑定
		|| !objectp(env=environment(ob)) 
		|| !stringp(room=env->query("short")) ) 
	{
		::die();
		return;
	}

	if ( me )
	{
		m = 1500000+random(1500000);
		
		if ( interactive(me) )
		{
			message_vision(HIG"\n你杀死了 "+ob->name(1)+HIG" ，奖励了 "HIY+(me->query_exp_times()*m)+HIG" 点经验和 "HIY+(m/10)+HIG" 潜能。\n"NOR, me);
			//message("party", HIW"【"+room+"】"+HIG+me->name(1)+HIM" 杀死了 "+ob->name(1)+HIM" ，奖励了 "HIC+(m*me->query_exp_times())+HIM" 点经验和 "HIY+(m/10)+HIM" 潜能。\n"NOR,users() );
			me->add("combat_exp",m);
			me->add("potential",m / 10);
			if ( me->query("xyhy_type") == 2 ) flag = 5/4;
		}
	}

	if ( objectp(corpse = CHAR_D->make_corpse(ob, me)) )
		corpse->move(environment(ob));
	
	k1 = 20*flag;
	if ( objectp(me) && objectp(ob) && random(100) < k1 )
	{
		baoshi = new("/clone/gem/gem");
        message_vision(HIG"\n$N在 "HIY+ob->name(1)+" 的尸体上发现了 "HIW+baoshi->name(1)+"("+baoshi->query("id")+")。\n"NOR,  me);	//2016.6.15阿飞改，增加显示物品的id	
		if (baoshi->query("level")>=7) message("party", HIW"【"+room+"】"+HIM"听说 "HIG+me->name(1)+HIM" 在 "+ob->name(1)+HIM" 尸体上发现了 "+baoshi->name(1)+HIM"。\n"NOR,users() );
		baoshi->move(corpse);
	}

	COMBAT_D->announce(ob, "dead");
	destruct(ob);
	return;
}


int do_go(string arg)
{
	object me, ob, *killer;
	
	me = this_object();
	ob = this_player();
	
	if ( !objectp(ob) ) return 0;

	killer = ob->query_enemy();
	
	if ( playerp(ob) && arrayp(killer) && sizeof(killer) > 3 && random(10) <= 5 ) 
	{
		message_vision(YEL "$N见势不好，转身要走，被$n"+YEL+"一把拦在面前。背后拉我一票兄弟还想走？没那么容易！\n"NOR, ob, me);
		if ( !ob->is_busy() ) ob->start_busy(1);
		return 1;
	}
	
	return 0;
}
