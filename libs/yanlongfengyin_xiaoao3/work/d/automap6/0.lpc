#include <room.h>
#include <ansi.h>

inherit ROOM;


void create()
{
	set("short", "龙窟副本");
	set("long", @LONG
    这里就是眠龙洞的入口处，再往前就是滚烫的岩浆了，洞口散发着炎热气息,
偶尔能听见巨大的生物吼叫声，听起来让人心惊胆颤。
LONG);
	set("no_fight", "1");
	set("no_steal", "1");
	set("no_sleep_room", "1");
	set("exits", ([
		"east" : "/d/automap6/fuben"+(1+random(500)),	                          	
		]));
//	set("no_clean_up", 0);
	setup();
}
int valid_leave(object me, string dir)
{
	object *inv;
	int sizeinv;
	
	if (dir =="east")
	{    
		if ( me->query("xyzx_sys/level") < 1000)       	
			return notify_fail(HIC"就平你这点微末功夫不是去送死吗！\n"NOR);
		if (present("buzhen xiang",me))
			return notify_fail("你带着布阵箱进眠龙洞想做什么？\n");	
		inv=all_inventory(me);
		sizeinv=sizeof(inv);
	
		while (sizeinv--)
		{
       		if (inv[sizeinv]->is_character())  
     			return notify_fail(HIG"你想给里面的怪物送点心去？\n"NOR);      		
		}		
	}

	return ::valid_leave(me, dir);
}
