
#include <ansi.h>
inherit ROOM;


void create ()
{
  set ("short","大雪山");
  set ("long", @LONG
这里是长白山大雪山，常年盖着厚厚的积雪，每遇到风起时，雪花飞舞，
周围是一片冰天雪地，而这里虽然漫天飞雪，但实则并不寒冷。山边建
有一栋茅草房，于漫天飞雪之际别有一番景致。若能在此地舞剑一番，
或许能有所思（qiwu）。    
LONG);

  set("exits", ([ 
 "southwest":__DIR__"wenquan",
         ]));
  set("outdoors","cbs");
  
  set("valid_startroom", 1);
  setup();
 
}


void init()
{
  add_action("do_qiwu", "qiwu");
}

int do_qiwu(string arg)
{
  object me=this_player();
  object weapon;
  
  string *poem = ({
		"你左手挥刀使出一招「"HIM"千山重峦"NOR"」，右手执剑使出一招「"HIB"迎门腿反劈华山"NOR"」",
		"你左手挥刀使出一招「"HIC"乱批风雪"NOR"」，右手执剑使出一招「"HIY"随形腿弄花葬剑"NOR"」",
		"你左手挥刀使出一招「"HIB"云外飞天"NOR"」，右手执剑使出一招「"HIR"冲天掌苏秦背剑"NOR"」",
		"你左手挥刀使出一招「"HIY"气贯山河"NOR"」，右手执剑使出一招「"HIC"提撩剑白鹤舒翅"NOR"」",
		"你左手挥刀使出一招「"HIR"灵狐出洞"NOR"」，右手执剑使出一招「"HIM"翻云手剑指澜关"NOR"」",
		});

    if (((!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword") || (!objectp(weapon = me->query_temp("secondary_weapon")) || (string)weapon->query("skill_type") != "blade")) && ((!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "blade") || (!objectp(weapon = me->query_temp("secondary_weapon")) || (string)weapon->query("skill_type") != "sword")))
        return notify_fail("你不拿刀和剑，恐怕不行吧。\n");			
    if(me->is_busy() )
        return notify_fail("你现在忙着呢，哪有功夫看舞刀弄剑...\n");
	if( !me->query_temp("jm_hu3") )
		return notify_fail("你未获得胡一刀的真传。\n");  
	if( !me->query_temp("jm_miao3") )
		return notify_fail("你未获得苗人凤的真传。\n"); 
	if( !me->query_temp("jm_humiao1") )
		return notify_fail("你未替闯王报仇......这袁承志仗着一身武功与闯王作对......\n"); 	
    if(me->query("family/family_name") != "胡苗世家")
	{
        tell_object(me,"你于漫天飞雪之间左手执刀，右手执剑，起舞一番，却不知所谓......\n"); 
		return 1;
	}		
	if (me->query_skill("lengyue-shengong",1) < 1000)
	{
        tell_object(me,"似乎......内功......也许.......\n"); 
        return 1;
	}
	if (me->query_skill("hubo",1) < 1000)
	{
        tell_object(me,"既要左手使刀，又要右手出剑，你似乎并未掌握这种诀窍吧......\n"); 
        return 1;
	}	
	if (me->query_skill("hujia-dao",1) < 2000)
	{
        tell_object(me,"似乎......刀法......也许.......\n"); 
        return 1;
	}
	if (me->query_skill("miaojia-jian",1) < 2000)
	{
        tell_object(me,"似乎......剑法......也许.......\n"); 
        return 1;
	}
	if (me->query_skill("daojian-guizhen",1) < 2000)
	{
        tell_object(me,"似乎......刀...剑......也许.......\n"); 
        return 1;
	}		
    if(me->query("jingli") < 1000)
	{
        tell_object(me,"你还是先休息一会儿吧。\n");     
        return 1;
	}
    if(me->query("jm/humiao")) 
	{
        tell_object(me,"你已经完全领悟了胡家刀苗家剑的精髓，不需要在这领悟了。\n");       
        return 1;
	}
			
	tell_object(me,HIW"你左手挥刀，右手执剑，在漫天飞雪之际，翩翩起舞......\n"NOR);
	message_vision("" + poem[random(sizeof(poem))] + "\n", me);
	me->add("jingli",-1000);		
	me->start_busy(1);

    if( random(100000) < me->query("kar",1) )
	{
        me->set("jm/humiao",1);
		me->add("family_score",1);
        tell_object(me,HIC"你突然醒悟道："HIY"原来这就是刀剑归真的精髓"HIR"！\n"NOR);
		tell_object(me,HIC"恭喜你融汇贯通了胡家刀苗家剑的精髓！\n"NOR);
		message("channel:chat", HIM"【天降奇才】"HIM + "听说"+me->query("name")+"天纵奇才，在长白山大雪山居然领悟了胡刀苗剑的终极奥义！\n"NOR,users() );
	}
	return 1;
}     