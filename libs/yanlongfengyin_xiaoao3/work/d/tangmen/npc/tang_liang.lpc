// tang liang.c 唐亮

#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create()
{
	int jibie;
	jibie = 2000;
//	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性
	set("xyzx_sys/level", jibie);	//2017.9.1阿飞调整NPC等级为固定值，取消20%的浮动设定	
	set_name("唐亮", ({ "tang liang", "tang" }));
	set("nickname", HIW "千手千眼" NOR);
	set("long", 
		"他是唐门第一高手，传说他可以同时发出一千种不同暗器。\n"
		"也可以同时接下一千种暗器。\n"
		"他大约五十有余，双手总是笼在袖中。\n");
	set("gender", "男性");
	set("age", 50);
    set("attitude", "peaceful");	
	set("shen_type", 1);
	set("str", 28);
	set("int", 30);
	set("con", 30);
	set("dex", 32);
	
	set("max_qi", 1000);
	set("max_jing", 3000);
	set("neili", 3000);
	set("max_neili", 3000);
	set("jiali", 100);
	set("combat_exp", 2000000);
	set("score", 100000);

	set_skill("force", 500+jibie/3+random(jibie/5));
	set_skill("biyun-xinfa",500+jibie/3+random(jibie/5));
	set_skill("dodge", 500+jibie/3+random(jibie/5));
	set_skill("qiulinshiye", 500+jibie/3+random(jibie/5));
	set_skill("strike", 500+jibie/3+random(jibie/5));
	set_skill("unarmed",500+jibie/3+random(jibie/5));
	set_skill("biye-wu", 500+jibie/3+random(jibie/5));
	set_skill("parry", 500+jibie/3+random(jibie/5));
	set_skill("throwing", 500+jibie/3+random(jibie/5));
	set_skill("liuxing-biao", 500+jibie/3+random(jibie/5));
	set_skill("literate", 500+jibie/3+random(jibie/5));

	map_skill("force", "biyun-xinfa");
	map_skill("dodge", "qiulinshiye");
	map_skill("strike", "biye-wu");
	map_skill("unarmed","bieye-wu");
	map_skill("parry", "liuxing-biao");
	map_skill("throwing", "liuxing-biao");
	
	create_family("唐门", 8 ,"精益堂堂主");
	set("class", "tangmen");

	set("chat_chance_combat", 60);
	set("chat_msg_combat", ({
		(: perform_action, "strike.meng" :),
		(: exert_function, "recover" :),
	}) );

	setup();
	carry_object("/d/tangmen/obj/zhuyebiao")->wield();
	carry_object("/d/tangmen/obj/qingduan")->wear();
}

void attempt_apprentice(object ob)
{
	if ((int)ob->query_skill("biyun-xinfa", 1) < 300) {
		command("say 唐门虽然以暗器为主，但还是要辅以内力。"); 
		command("say " + RANK_D->query_respect(ob) + 
			"是否还应该在碧云心法上多下点功夫？");
		return;
	}
	if (ob->query("dex",1) < 25)
	{
		command("say 唐门历来注重弟子的身法资质。");
		command("say 本派功夫要能熟练运用，必须要身手灵敏，身轻如燕，身法差了是不行的。");
		return;
	}
	command("say 唐门武学精深博大，你好好修习，将唐门发扬光大。");
	command("recruit " + ob->query("id"));
}
