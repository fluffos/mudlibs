        object me = this_player();
        if (me->query_temp("xunshan")) me->set_temp("xunshan/lianhua", 1);
        return;
}*/

//第1处解密
void init()
{
  add_action("do_jianwu", "jianwu");
}

int do_jianwu(string arg)
{
  object me=this_player();
  int ap;
  
  string *poem = ({
		"这道剑痕，似乎是「"HIM"阿修罗灭世"NOR"」，为什么会有这么大威力？",
		"这道剑痕，似乎是八部龙女剑其中一招「"HIG"龙女成佛"NOR"」所造成的，似乎又有些不同。",
		"这道剑痕，「"HIB"夜叉渡佛"NOR"」为什么.....？？难道因为某种内功？？？？？？",
		"这道剑痕「"HIY"天王朝圣"NOR"」，怎样逆天的内力，如此可怕....",
		"「"HIB"迦楼罗飞天"NOR"」么？？？？似乎又有些不同。为什么？",
		});

    if(me->is_busy() )
        return notify_fail("你现在忙着呢，哪有功夫舞剑哦.....\n");

    if((int)me->query_skill("literate",1) < 2000 )
        return notify_fail("你按照莲花石的剑痕起舞，一脸茫然，脑袋一片浆糊，始终无法领悟。\n");
   
    if((int)me->query_skill("huashan-jianfa", 1) < 2000)
        return notify_fail("你按照莲花石的剑痕起舞，或许本门剑法太低，完全不得要领。\n"); 
	
    if((int)me->query_skill("huashan-shenfa", 1) < 2000)
        return notify_fail("你按照莲花石的剑痕起舞，或许本门身法太低，脚步之间生涩无比。\n");
	
	if(me->query("family/family_name") != "华山派")
        return notify_fail("你看了莲花石的剑痕，这似乎是某个门派高手舞剑时留下的，到底是哪个门派呢？？？\n"); 

	if (me->query_skill("zixia-shengong",1) < 1000)
        return notify_fail("似乎......内功......也许.......紫气......\n"); 

    if(me->query("neili") < 1000)
        return notify_fail("你累的不轻，还是先休息一会儿吧。\n");     

	if (me->query_skill("babulongnv-jian",1) >= 1)
        return notify_fail("你已经完全领悟了八部龙女剑了，没必要再舞剑了。\n"); 
   	
    if(me->query("jm/babu")) 
        return notify_fail("你已经完全领悟八部龙女剑的精髓。\n");

    if(me->query("jm_babu/huashan")) 
        return notify_fail("你领悟了八部龙女留在华山的精髓，不需要在这领悟了，去其他地方看看。\n");       
    		
	ap = me->query("per",1) + me->query("kar",1);
    message_vision("$N仔细的研究着莲花石的剑痕：" + poem[random(sizeof(poem))] + "\n", me);
    tell_object(me,HIW"你仔细研究了莲花石上的剑痕，尝试着练习了下......\n"NOR);
    me->improve_skill("literate", 50+random(10));
//	me->improve_skill("huashan-jianfa", 50+random(10));
    me->add("neili",-100);	
    me->start_busy(1);
    	
    if( random(100000) < ap )
    {
        me->set("jm_babu/huashan",1);
        tell_object(me,HIG"你突然醒悟道："HIY"原来八部龙女剑可以有此等威力"HIR"！\n"NOR);
		tell_object(me,HIG"你对八部龙女剑的精髓有所领悟\n"NOR);
    }
    return 1;
}    