// Room: /d/huashan/lianhua.c

inherit ROOM;
#include <ansi.h>

void create()
{
        set("short", "莲花峰");
        set("long", @LONG
    太华西峰－又名莲花峰，也叫芙蓉峰，峰顶有一块巨石，状如莲花，
覆盖崖巅。该处由此得名。这里悬崖陡峭，壁立千仞，登临远眺，秦川
莽莽，渭、洛二水盘屈如带。峰顶有石名“摘星石”，取“手可摘星辰”之意，
以状西峰之高。登西峰极目远眺，四周群山起伏，云霞四披，周野屏开，
黄渭曲流，置身其中若入仙乡神府，万种俗念，一扫而空。
    八部龙女曾在此开洞天福地，后三圣母在此隐居，时常在峰顶翩翩
起舞(jianwu)，故此在莲花石上留有不少仙家痕迹。
LONG
        );
        set("exits", ([ /* sizeof() == 4 */
             "eastdown" : __DIR__"chengxiang",
        ]));
        set("no_clean_up", 0);
        set("outdoors", "huashan");

        setup();
        replace_program(ROOM);
}
 
