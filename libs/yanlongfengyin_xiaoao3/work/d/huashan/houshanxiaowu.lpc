

inherit ROOM;
#include <ansi.h>
void create ()
{
	set ("short","小屋");
	set ("long", @LONG
	这里就是华山派后山山谷的一处悬崖，也不知是何人再次建了两座小屋，
似乎已经有很多年未有人居住了，但是看起来并无蒙尘之扰，不知是何故？
看屋前地面似乎有不少剑痕，或许蕴含华山派失传已久的剑法......
你可以试着比划(bihua)一番。
LONG);
  
   set("exits", ([      
//       "south" : "d/xuantian/lian",
   ]));
  setup();
}

void init()
{
  add_action("do_bihua", "bihua");
}

int do_bihua(string arg)
{
  object me=this_player();
  
  string *poem = ({
		"这道剑痕，似乎是「"HIM"玉女十九式"NOR"」，为什么会有这么大威力？",
		"这道剑痕，似乎是华山剑法其中一招「"HIG"无双无对"NOR"」所造成的，似乎又有些不同。",
		"这道剑痕，「"HIB"苍松迎客"NOR"」为什么.....？？难道因为某种内功？？？？？？",
		"这道剑痕「"HIY"无边落木"NOR"」，怎样逆天的内力，如此可怕....",
		"这道剑痕「"HIB"风花雪月"NOR"」么？？？？似乎又有些不同。为什么？",
		"这道剑痕如同闪电一般，为何如此迅猛？",
		});

    if(me->is_busy() )
        return notify_fail("你现在忙着呢，哪有功夫看墙上的东西......\n");
    if(!me->query("jm/babu") )
        return notify_fail("你对五岳派不甚了解......\n");
    if(!me->query_temp("jm_huashan3") )
        return notify_fail("你未得到华山掌门的指点，如何能参悟！\n");	
    if(me->query("jm/huashan")) 
		return notify_fail("你已经完全领悟了华山派的精髓，不需要在这领悟了。\n");	
	
    if(me->query("family/family_name") != "华山派")
	{
        tell_object(me,"你看了地上的剑痕，这是什么哪派剑法造成的？？？？？。\n"); 
		return 1;
	}		
	if (me->query_skill("zixia-shengong",1) < 1000)
	{
        tell_object(me,"似乎......内功......也许.......\n"); 
        return 1;
	}
	if (me->query_skill("huashan-jianfa",1) < 2000)
	{
        tell_object(me,"似乎......剑法......也许.......\n"); 
        return 1;
	}
	if (me->query_skill("kuangfeng-jian",1) < 2000)
	{
        tell_object(me,"如此......快剑......也许.......\n"); 
        return 1;
	}
    if(me->query("jing") < 1000)
	{
        tell_object(me,"你还是先休息一会儿吧。\n");     
        return 1;
	}
	
		tell_object(me,HIW"你仔细研究了地上的剑痕，尝试着练习了下......\n"NOR);
        message_vision("$N仔细的研究着地上的剑痕：" + poem[random(sizeof(poem))] + "\n", me);
        me->add("jing",-500);		
        me->start_busy(1);

    if( random(100000) < me->query("kar",1) )
	{
        me->set("jm/huashan",1);
		me->add("family_score",1);
        tell_object(me,HIC"你突然醒悟道："HIY"原来华山派剑法可以有此等威力"HIR"！\n"NOR);
		tell_object(me,HIC"恭喜你融汇贯通了华山派武功的精髓！\n"NOR);
		message("channel:chat", HIM"【天降奇才】"HIM + "听说"+me->query("name")+"天纵奇才，在华山派后山小屋居然领悟了华山派的夺命连环三仙剑！\n"NOR,users() );
	}
	return 1;
}             

