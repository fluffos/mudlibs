// yilin.c

inherit NPC;

void create()
{
	int jibie;
	jibie = 1000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
	set_name("仪琳",({ "yi lin", "yi", "lin" }) );
        set("gender", "女性" );
        set("age", 16);
        set("long", 
"仪琳是恒山派定逸师太的心爱弟子。\n");
	set("combat_exp", 40000);
	set("shen_type", 1);
	set("class", "bonze");
        set("str", 30);
        set("dex", 30);
        set("per", 30);
        set("con", 30);
        set("int", 30);
        set("max_jing", 300);
        set("jing", 300);
        set("max_qi", 600);
        set("qi", 600);
        set_skill("sword", 500+jibie/3+random(jibie/5));
        set_skill("force", 500+jibie/3+random(jibie/5));
        set_skill("dodge", 500+jibie/3+random(jibie/5));
        set_skill("parry", 500+jibie/3+random(jibie/5));
        set("attitude", "friendly");
	create_family("恒山派", 14, "弟子");
        setup();
        carry_object("clone/cloth/cloth")->wear();
        carry_object("clone/weapon/changjian")->wield();
}


void attempt_apprentice(object ob)
{

	if ((int)ob->query("shen") < 10000  )
	{
		command("say 我恒山派向来行侠仗义，您请回吧！");
		return;
	}

	command("nod");
	command("say " + RANK_D->query_respect(ob) + "天资聪颖，正好与我在山上作伴！\n");
	command("recruit " + ob->query("id") );
	return;
}