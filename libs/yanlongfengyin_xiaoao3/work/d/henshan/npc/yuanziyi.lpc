// yuanziyi.c 袁紫衣

#include <command.h>
#include <ansi.h>

inherit NPC;
void create()
{
	int jibie;
	jibie = 3000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
        set_name("袁紫衣", ({ "yuan ziyi","ziyi","yuan"}));
        set("long",
                "她是峨嵋派一个辈份极高的老尼的关门徒弟。\n"
                "一张脸秀丽绝俗。身着一身淡紫衣裳。\n"
                "这一路上去京师她夺了好几家掌门。\n");
        set("gender", "女性");
        set("age", 18);
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("title", RED"九家半门派"HIG"总掌门"NOR);
//        set("class", "bonze");
		set("no_get",1);
		set("no_put",1);
        set("inquiry",([
                "胡斐"    : "我和胡大哥毕竟没有缘份的。",
                "掌门"    : "我就喜欢抢掌门！",
        ]));
        set("str", 30);
        set("per", 30);
        set("int", 30);
        set("con", 30);
        set("dex", 30);
	
        set("max_qi", 3500);
        set("max_jing", 1000);
        set("neili", 3500);
        set("max_neili", 3500);
        set("jingli", 1000);
        set("max_jingli", 1000);

        set("combat_exp", 1500000);
        set("score", 1000);
        set_skill("force", 500+jibie/3+random(jibie/5));
        set_skill("dodge", 500+jibie/3+random(jibie/5));
        set_skill("finger", 500+jibie/3+random(jibie/5));
        set_skill("parry", 500+jibie/3+random(jibie/5));
        set_skill("unarmed", 500+jibie/3+random(jibie/5));
        set_skill("strike", 500+jibie/3+random(jibie/5));
        set_skill("sword", 500+jibie/3+random(jibie/5));
        set_skill("claw", 500+jibie/3+random(jibie/5));
        set_skill("literate", 500+jibie/3+random(jibie/5));
        set_skill("jinding-zhang", 500+jibie/3+random(jibie/5));
        set_skill("tiangang-zhi", 500+jibie/3+random(jibie/5));
        set_skill("huifeng-jian", 500+jibie/3+random(jibie/5));
        set_skill("zhutian-bu", 500+jibie/3+random(jibie/5));
        set_skill("linji-zhuang", 500+jibie/3+random(jibie/5));
        map_skill("force","linji-zhuang");
        map_skill("unarmed","jinding-zhang");
        map_skill("dodge","zhutian-bu");
        map_skill("strike","jinding-zhang");
		map_skill("finger","tiangang-zhi");
        map_skill("sword","huifeng-jian");
        map_skill("parry","huifeng-jian");

        setup();
        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/d/emei/obj/ycloth.lpc")->wear();
}
void init()
{
	object ob;

	::init();
	if( interactive(ob=this_player()) && !is_fighting() )
	{
		remove_call_out("greeting");
		call_out("greeting", 5, ob);
	}
}

void greeting(object ob)
{
	command("say 本姑娘在这里休息，别来打搅！");
	command("kick "+ob->query("id"));
	ob->move("/d/henshan/hsroad6");
	return;
}

int accept_object(object me, object ob)
{

	if ( (string)ob->query("id") =="chuangwang baodao" )
	{
		if ( (string)me->query("family/family_name") == "胡苗世家" && me->query("family/master_id")=="hu fei" && me->query("id")==ob->query("owner") && me->query_temp("jm_hu1"))
		{
			message_vision("袁紫衣看了看说道：这就是胡家的传家之宝啊！\n", this_object(),me);
			message_vision("袁紫衣欣喜的说道：是胡大哥叫你送来的吗......难得胡大哥还记得中原结义之情。\n", this_object(),me);
			message_vision("袁紫衣说道：这位"+RANK_D->query_respect(me)+"既然是胡大哥亲传弟子，那我可要考较一番。\n", this_object(),me);
			me->set_temp("jm_hu2",1);
			return 1;
		} else
		{
			message_vision("$N对$n说道：多谢这位"+RANK_D->query_respect(me)+"，这把宝刀我就笑纳了。\n",this_object(),me);
			return 1;
		}
	}

	return 0;
}

int accept_fight(object ob)
{
    object me  = this_object();
    
    if ( !ob->query_temp("jm_hu2") ) return 1;
    remove_call_out("checking");
    call_out("checking", 1, me, ob);
//    ob->delete_temp("jm_hu2");
    
    return 1;
}
int checking(object me, object ob)
{
    int my_max_qi, his_max_qi;
    my_max_qi  = me->query("max_qi");
    his_max_qi = ob->query("max_qi");
    if (me->is_fighting()) 
    {
        call_out("checking",3, me, ob);
		return 1;
    }
    if ( !present(ob, environment()) ) return 1; 
	if (me->is_busy() && me->query_busy()>5)
	{
		message_vision("袁紫衣大怒，只是切磋武艺而已，用得着使用这种点穴功夫吗！！！\n", ob);
		return 1;
	}
    if (( (int)ob->query("qi")*100 / his_max_qi) < 50 && ob->query("family/master_id")=="hu fei" && ob->query_temp("jm_hu2")) 
    {
		message_vision("袁紫衣大怒，这位" + RANK_D->query_respect(ob) + "分明有辱胡大哥威名......\n", ob);
		ob->delete_temp("jm_hu2");
        return 1;
    }	
    if ( ((int)me->query("eff_qi")*100 / my_max_qi) < 50 && ob->query("family/master_id")=="hu fei" && ob->query_temp("jm_hu2")) 
    {
        command("say 胡大哥居然如此绝情！\n");
        message_vision("胡斐不知道从哪里得知你重伤袁紫衣，怒火中烧，孽徒竟敢伤我红颜知己！\n", ob);
		message_vision("胡斐将你开除师门了！\n", ob);
		ob->delete_temp("jm_hu2");
		command("expell "+ ob->query("id"));
		ob->add("betrayer", 1);
        ob->set("title","胡斐" + RED + "弃徒" NOR);  
        return 1;
    }	
    if (((int)me->query("qi")*100 / my_max_qi) <= 50 && ((int)me->query("eff_qi")*100 / my_max_qi) >= 50 && ob->query("family/master_id")=="hu fei" && ob->query_temp("jm_hu2")) 
    {
        command("say 青出於蓝胜於蓝，不愧是胡家弟子！\n");
        message_vision("袁紫衣神色忧郁，胡大哥今生与我有缘无分......\n", ob);
		ob->delete_temp("jm_hu2");
        ob->set_temp("jm_hu3",1);
        return 1;
    }
	
    return 1;  
}