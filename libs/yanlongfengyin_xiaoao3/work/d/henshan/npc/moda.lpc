// moda.c
inherit NPC;
inherit F_MASTER;
#include <ansi.h>;
void create()
{
	int jibie;
	jibie = 4000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
        set_name("莫大", ({ "mo da", "mo" }) );
        set("title", HIR"衡山派第十二掌门"NOR);
        set("nickname", "潇湘夜雨");
        set("gender", "男性");
        set("class", "swordsman");
        set("age", 55);
        set("attitude", "peaceful");
        set("per", 22);
        set("str", 26);
        set("con", 30);
        set("dex", 30);
        set("int", 28);

        set("neili", 2400);
        set("max_neili", 2400);
        set("jiali", 30);
        set("max_qi",2000);
        set("max_jing",1200);
        set("combat_exp", 1200000);
        set("shen_type", 1);

        set_skill("unarmed", 500+jibie/3+random(jibie/5));
        set_skill("sword", 500+jibie/3+random(jibie/5));
        set_skill("force", 500+jibie/3+random(jibie/5));
        set_skill("parry", 500+jibie/3+random(jibie/5));
        set_skill("dodge", 500+jibie/3+random(jibie/5));
        set_skill("luoyan-jian", 500+jibie/3+random(jibie/5));
        set_skill("lingxu-bu", 500+jibie/3+random(jibie/5));

        map_skill("sword", "luoyan-jian");
        map_skill("parry", "luoyan-jian");
        map_skill("dodge", "lingxu-bu");

        create_family("衡山派", 12, "掌门");
        setup();

        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/clone/cloth/cloth")->wear();
}

void attempt_apprentice(object ob)
{
	string oldtitle;
	oldtitle = ob->query("title");
	if ((int)ob->query("shen") < 10000  )
	{
		command("say 我衡山派向来行侠仗义，您请回吧！");
		return;
	}
	if ((int)ob->query("xyzx_sys/level")<1000)
    {
        command("say 这位"+RANK_D->query_respect(ob)+"实战能力太差了，还是去江湖上历练吧。");
        command("say 是否应该去江湖中多加磨炼。");
		return ;
    }	
	if ((int)ob->query_skill("luoyan-jian",1) < 1000 )
	{
		command("say 你的回风落雁剑太低了,还是努努力先提高一下吧!");
		return;
	}
	if ((int)ob->query("dex",1) < 30 )
	{
		command("say 衡山百变云雾十三式要求极高的身法!");
		return;
	}
	command("nod");
	command("say " + RANK_D->query_respect(ob) + "资质不错，望你能将我衡山派发扬光大！\n");
	command("recruit " + ob->query("id") );
	return;
}