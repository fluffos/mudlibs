// Room: /d/songshan/fawangsi.c
// Last Modified by Winder on Jul. 15 2001

inherit ROOM;

void create()
{
	set("short", "法王塔");
	set("long", @LONG
法王塔是汉明帝专为印度高僧摄摩腾和竺法兰译经传教而下令修建的，成为中国第一所菩提道场，
为"中国古寺之始"。魏明帝青龙年间改为护国寺。西晋时于寺前增建法华寺。
隋初造舍利塔，改名舍利寺。唐太宗贞观年间，敕命补修佛像，赐予庄园，改为功德寺。
玄宗开元年间，改称御容寺。代宗大历年间，重修殿堂楼阁，改名文殊师利广德法王寺。
至五代时废坏，而分为五院，仍沿袭护国、法华、舍利、功德、御容等旧称。北宋初，合称五院。
仁宗庆历年间增置殿宇、僧寮，重造佛像，改称“嵩山大法王寺”。今存毗卢殿、大雄殿及方形十五层塼塔等。
寺据嵩山之胜，为天下名刹之一。寺背依玉柱峰，三面群峰耸峙，山谷中曲涧潺流，小径蜿蜒，云雾缭绕，十分幽静。
据闻，铁剑郭嵩阳曾在此悟剑十载，观日出嵩山，骄阳永照，传下一式【嵩阳诀】。
你可以试着观日(guanri)，看能否领悟嵩阳意境。
LONG );
	set("exits", ([
		"down" : __DIR__"tayuan",
	]));
	set("objects", ([
	]));
	set("no_clean_up", 0);
	set("outdoors", "songshan");
	setup();
	replace_program(ROOM);
}


void init()
{
  add_action("do_guanri", "guanri");
}

int do_guanri(string arg)
{
  object me=this_player();
  
  string *poem = ({
		"「"HIM"旭日升騰透曙紅，光凝彩線繡長空。目隨霞起豪情湧，欲化鯤鵬傲九重。"NOR"」",
		"「"HIG"太阳初出光赫赫，千山万山如火发。一轮顷刻上天衢，逐退群星与残月。"NOR"」",
		"「"HIB"边兵春尽回，独上单于台。白日地中出，黄河天外来。"NOR"」",
		"「"HIY"忽见明霞吐海东，天鸡初唱五更中。未收夜色千山黑，渐发晨光万国红。"NOR"」",
		"「"HIC"梦断天鸡喔，起看旭日升。遥闻青海沸，瞥见彩云腾。烂锦飞千丈，金波涌万棱。扶桑真有望，放眼快先登。"NOR"」",
		"「"HIR"万瓦宵光曙，重檐夕雾收。玉花停夜烛，金壶送晓筹。日晖青琐殿，霞生结绮楼。重门应启路，通籍引王侯。"NOR"」",
		"「"HIW"绝磴千盘近紫穹，最高峰顶独梯空。天门依约开金钥，云路苍茫挂玉虹。神州回首斜阳里，九点烟横一气中。"NOR"」",
		});

    if(me->is_busy() )
        return notify_fail("你现在忙着呢，哪有功夫观日出......\n");
    if(!me->query("jm/babu") )
        return notify_fail("你对五岳派不甚了解......\n");
    if(!me->query_temp("jm_songshan3") )
        return notify_fail("你未得到嵩山掌门的指点，观日一点头绪都没有！\n");	
    if(me->query("jm/songshan")) 
		return notify_fail("你已经完全领悟了嵩山派的精髓，不需要在这领悟了。\n");	
	
    if(me->query("family/family_name") != "嵩山派")
	{
        tell_object(me,"你极目远眺，日出惊鸿，这似乎是哪一派的剑法？。\n"); 
		return 1;
	}		
	if (me->query_skill("hanbing-zhenqi",1) < 1000)
	{
        tell_object(me,"似乎......内功......也许.......\n"); 
        return 1;
	}
	if (me->query_skill("songshan-jian",1) < 2000)
	{
        tell_object(me,"似乎......剑法......也许.......\n"); 
        return 1;
	}
	if (me->query_skill("songyang-zhang",1) < 2000)
	{
        tell_object(me,"如此......掌法......也许.......\n"); 
        return 1;
	}
    if(me->query("jingli") < 1000)
	{
        tell_object(me,"你还是先休息一会儿吧。\n");     
        return 1;
	}
	
		tell_object(me,HIW"你极目远眺，观日出嵩山，引晨曦之辉，参悟嵩阳诀......\n"NOR);
        message_vision("" + poem[random(sizeof(poem))] + "\n", me);
        me->add("jingli",-500);		
        me->start_busy(1);

    if( random(100000) < me->query("kar",1) )
	{
        me->set("jm/songshan",1);
		me->add("family_score",1);
        tell_object(me,HIY"你突然醒悟道："HIY"原来嵩阳诀可以有此等威力"HIR"！\n"NOR);
		tell_object(me,HIY"恭喜你融汇贯通了嵩山派武功的精髓！\n"NOR);
		message("channel:chat", HIM"【天降奇才】"HIM + "听说"+me->query("name")+"天纵奇才，在嵩山派法王塔居然领悟了嵩山派的绝学【嵩阳诀】！\n"NOR,users() );
	}
	return 1;
}             
