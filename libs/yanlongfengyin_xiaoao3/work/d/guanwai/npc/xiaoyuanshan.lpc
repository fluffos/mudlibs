// xiaoyuanshan.c

#include <ansi.h>

inherit NPC;

void create() {
  int jibie;
  jibie = 6000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性	
  set_name("萧远山", ({ "xiao yuanshan", "xiao", "yuanshan" }));
  set("gender", "男性");
  set("nickname", HIB "黑衣僧" NOR);
  set("age", 28);
  set("long",
    "他就是丐帮前任帮主萧峰的父亲，潜伏少林数十年了。\n"
    "他身穿一件普通的黑僧袍，腰间用一条麻绳随便一系。\n"
    "他身高六尺有余，体格十分魁梧，长有一张线条粗旷、十\n"
    "分男性化的脸庞，双目如电，炯炯有神。\n");
  set("attitude", "peaceful");

  set("str", 45);
  set("int", 30);
  set("con", 30);
  set("dex", 30);

  set("qi", 4000);
  set("max_qi", 4000);
  set("jing", 1500);
  set("max_jing", 1500);
  set("neili", 4000);
  set("max_neili", 4000);
  set("jiali", 100);

  set("combat_exp", 180000);
  set("score", 20000);

  set_skill("force", 500 + jibie / 3 + random(jibie / 5));             // 基本内功
  set_skill("hunyuan-yiqi", 500 + jibie / 3 + random(jibie / 5));      // 混天气功
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));           // 基本拳脚
  set_skill("jingang-quan", 500 + jibie / 3 + random(jibie / 5));      // 降龙十八掌
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));            // 基本躲闪
  set_skill("shaolin-shenfa", 500 + jibie / 3 + random(jibie / 5));    // 逍遥游
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));             // 基本招架

  map_skill("force", "hunyuan-yiqi");
  map_skill("unarmed", "jingang-quan");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("parry", "jingang-quan");

  setup();

  carry_object("/clone/cloth/cloth")->wear();
}
