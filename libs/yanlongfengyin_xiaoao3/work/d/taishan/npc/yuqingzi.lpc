// yuqingzi.c
inherit NPC;
inherit F_MASTER;
#include <ansi.h>;
void create()
{
	int jibie;
	jibie = 2000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
        set_name("玉磬子", ({ "yuqing zi", "zi", "yuqing" }) );
        set("gender", "男性");
        set("class", "taishan");
        set("age", 45);
        set("attitude", "peaceful");
        set("str", 26);
        set("con", 30);
        set("dex", 30);
        set("int", 28);

        set("neili", 250000);
        set("max_neili", 500);
        set("jiali", 700);
        set("max_qi",22000);
        set("max_jing",13000);
        set("combat_exp", 10000000);
        set("shen_type", 1);

        set_skill("sword", 500+jibie/3+random(jibie/5));
        set_skill("force", 500+jibie/3+random(jibie/5));
        set_skill("parry", 500+jibie/3+random(jibie/5));
        set_skill("dodge", 500+jibie/3+random(jibie/5));
        set_skill("unarmed", 500+jibie/3+random(jibie/5));
        set_skill("taiji-shengong", 500+jibie/3+random(jibie/5));
        set_skill("taizu-quan", 500+jibie/3+random(jibie/5));
        set_skill("taishan-jianfa", 500+jibie/3+random(jibie/5));
        set_skill("qingmang-jian", 500+jibie/3+random(jibie/5));

        map_skill("sword", "taishan-jianfa");
        map_skill("parry", "taishan-jianfa");
        map_skill("dodge", "qingmang-jian");
        map_skill("force","taiji-shengong");
        map_skill("unarmed","taizu-quan");
        prepare_skill("unarmed", "taizu-quan");


        create_family("泰山派", 13, "弟子");
        setup();

        carry_object("/clone/weapon/changjian")->wield();
        carry_object("d/taishan/obj/daopao")->wear();
}

void attempt_apprentice(object ob)
{
	if ((int)ob->query("shen") < 10000  )
	{
		command("say 我泰山派向来行侠仗义，您请回吧！");
		return;
	}
	if ((int)ob->query_skill("sword",1) < 2000 )
	{
		command("say 你的剑法基础太低了,还是努努力先提高一下吧!");
		return;
	}
	if ((int)ob->query("str",1) < 30 )
	{
		command("say 我泰山一脉剑法大开大合，你臂力恐怕不够!");
		return;
	}		
		command("nod");
		command("say " + RANK_D->query_respect(ob) + "资质不错，望你能将我泰山派发扬光大！\n");
		command("recruit " + ob->query("id") );
	return;
}