inherit NPC;
inherit F_MASTER;
//object ob = this_object();

void create() {
  int jibie;
  jibie = 6000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("慕容博", ({ "murong bo", "murong", "bo" }));
  set("title", "姑苏慕容老爷子");
  set("nick", "以彼之道 还施彼身");
  set("long",
    "他就是天下号称以彼之道，还彼之身的姑苏慕容博。\n"
    "他脸上带着不可一世的笑容。\n");
  set("age", 57);
  set("attitude", "peaceful");
  set("shen_type", -1);
  set("str", 40);
  set("int", 40);
  set("con", 40);
  set("dex", 40);

  set("max_qi", 4500);
  set("max_jing", 4500);
  set("neili", 4500);
  set("max_neili", 4500);
  set("jiali", 0);
  set("combat_exp", 20000000);
  set("score", 50000);
  set("chat_chance_combat", 40);
  set("chat_msg_combat", ({
    (: perform_action, "parry.xingyi" :)
  }));

  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("canhe-zhi", 500 + jibie / 3 + random(jibie / 5));
  set_skill("murong-jianfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("shenyuan-gong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yanling-shenfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("douzhuan-xingyi", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("murong-daofa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("blade", 500 + jibie / 3 + random(jibie / 5));
  set_skill("xingyi-zhang", 500 + jibie / 3 + random(jibie / 5));
  map_skill("blade", "murong-daofa");
  map_skill("unarmed", "canhe-zhi");
  map_skill("force", "shenyuan-gong");
  map_skill("dodge", "yanling-shenfa");
  map_skill("parry", "douzhuan-xingyi");
  map_skill("sword", "murong-jianfa");

  prepare_skill("finger", "canhe-zhi");

  create_family("姑苏慕容", 10, "弟子");

  set("inquiry",
    ([
      "name": "我就是以彼之道，还施彼身的姑苏慕容博。\n",
      "here": "这里是少林寺的藏经楼。\n",
      "rumors": "我那慕容复儿在武林之中闯出了名头，老爷子我是真高兴呀！\n",
      "xinyuan": "我对大理的六脉神剑仰慕已久，可惜未能一观。\n",

    ]));
  setup();

  carry_object("/clone/weapon/gangjian")->wield();
}

void attempt_apprentice(object ob) {
  if (ob->query_skill("parry", 1) < 1000) {
    command("say 我姑苏慕容以彼之道、还施彼身对招架要求甚高，小兄弟似乎不宜学习。");
    command("say " + RANK_D->query_respect(ob) + "的功力不够，还是请回吧。");
    return;
  }
  if (ob->query_skill("int", 1) < 30) {
    command("say 我姑苏慕容以彼之道、还施彼身没有一定的悟性是难以领会的。");
    return;
  }
  if (ob->query_skill("dex", 1) < 30) {
    command("say 我姑苏慕容斗转星移靠的就是身法，以你这种资质难以学会。");
    return;
  }
  if (ob->query_skill("score") < 10000) {
    command("say 我慕容世家肩负燕国重任，你看起来想大宋奸细？");
    return;
  }
  if ((int)ob->query("xyzx_sys/level") < 1000) {
    command("say 这位" + RANK_D->query_respect(ob) + "实战能力太差了，还是去江湖上历练吧。");
    command("say 是否应该去江湖中多加磨炼。");
    return;
  }
  if (ob->query_skill("shenyuan-gong", 1) < 1000) {
    command("say 我姑苏慕容以彼之道、还施彼身对内功心法要求甚高，小兄弟似乎不宜学习。");
    command("say " + RANK_D->query_respect(ob) + "的功力不够，还是请回吧。");
    return;
  }

  command("say 嗯，看你还是个学武的料，我就收下你吧！");
  command("say 苍天在上，让我姑苏慕容又得一良材，为复兴我大燕多了一份力量。");
  command("chat# 朗声说道：老夫我又收一良材，大燕兴复指日可待啦！");
  command("chat* haha");
  command("recruit " + ob->query("id"));
  ob->set("title", "以彼之道 还施彼身");
}

int accept_object(object me, object ob) {

  if ((string)ob->query("id") == "liumai jianpu" && me->query("id") == ob->query("owner")) {
    if ((int)me->query_temp("jm_xueshan1")) {
      message_vision("$N对$n说道：哈哈哈！这竟然是六脉神剑剑谱，吾欲观而不可得。\n", this_object(), me);
      message_vision("$N对$n说道：这门武学果然有独到之处，练到深处，剑气纵横不可敌。\n", this_object(), me);
      message_vision("$N对$n说道：听说吾儿与那六脉神剑传人有夺妻之恨.........\n", this_object(), me);
      me->set_temp("jm_xueshan2", 1);
      return 1;
    } else {
      message_vision("$N对$n说道：非常感谢你给我送来了六脉剑谱，可是我没什么可以奖励你的。\n", this_object(), me);
      return 1;
    }
  }

  if ((string)ob->query("id") == "duanyu rentou" && me->query("id") == ob->query("owner")) {
    if ((int)me->query_temp("jm_xueshan2")) {
      message_vision("$N对$n说道：很好，待我儿学会了六脉神剑，在江湖上再无敌手......\n", this_object(), me);
      message_vision("$N对$n说道：大理皇室中人，各个下流无双，仗着权势到处拈花惹草！！！\n", this_object(), me);
      message_vision("$N对$n说道：段正淳个老匹夫，当年来曼陀罗山庄风流快活！！！\n", this_object(), me);
      message_vision("$N对$n说道：哼！！！今仇旧恨一起算！！！\n", this_object(), me);
      message_vision("$N对$n说道：你是替大轮明王来了结心愿来的，吾今日得偿所愿，你可以回去告诉明王了。\n", this_object(), me);
      me->set_temp("jm_xueshan3", 1);
      return 1;
    } else {
      message_vision("慕容博看了看手中的人头，阴沉的说道：哼！黄毛小儿，仗着皇家权势，竟敢坏吾儿大事。\n", this_object(), me);
      return 1;
    }
  }

  return 0;
}
