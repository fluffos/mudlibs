inherit NPC;
void create()
{
	int jibie;
	jibie = 100;
	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性	
	set_name("踏青妇人",({"woman"}));
        set("gender", "女性");
	set("long", "春天出来游览的妇人。\n");
   	set("combat_exp", 5000);
   
	set("age",34);

	set_skill("dodge",20);
   	set_skill("force",20);
   	set_skill("parry",20);
   	set_skill("unarmed",20);
   	set_skill("sword",20);

   	setup();
   	add_money("silver", 2);
	carry_object("/clone/cloth/cloth")->wear();
}
