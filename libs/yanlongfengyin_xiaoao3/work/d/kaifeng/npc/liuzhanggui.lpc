inherit NPC;
inherit F_DEALER;

void create() {
  int jibie;
  jibie = 100;
  set("xyzx_sys/level", jibie * 8 / 10 + random(jibie * 4 / 10));  //2016.5.22阿飞调整NPC属性	
  set_name("刘掌柜", ({ "liu zhanggui", "liu", "zhanggui" }));
  set("gender", "男性");
  set("age", 25);
  set("title", "雅琪轩老板");
  set("combat_exp", 5000);
  set("attitude", "friendly");
  set_temp("apply/attack", 120);
  set_temp("apply/defense", 120);
  set_temp("apply/armor", 120);
  set_temp("apply/damage", 130);

  set("vendor_goods", ({
    "d/kaifeng/obj/ciwan",
    "d/kaifeng/obj/luowenhai",
    "d/kaifeng/obj/bibohu",
  }));

  setup();
  carry_object("/clone/cloth/cloth")->wear();
}

void init() {
  add_action("do_buy", "buy");
  add_action("do_list", "list");
  ::init();
}
