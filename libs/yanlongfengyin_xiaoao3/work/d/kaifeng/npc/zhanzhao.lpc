inherit NPC;
inherit F_MASTER;


void create()
{
	int jibie;
	jibie = 2000;
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性	
	set_name("展昭", ({
		"zhan zhao",
		"zhao",
		"zhan",
	}));
	set("long",
		"他就是名动江湖的'玉猫',据传他的武功已与达摩祖师相差无几.\n"
		"他正在保护包大人的安全.\n"
	);


	set("nickname", "御前一品带刀侍卫");
	set("gender", "男性");
	set("attitude", "peaceful");
	set("class", "officer");

	set("age", 30);
	set("shen_type", 1);
	set("str", 50);
	set("int", 50);
	set("con", 50);
	set("dex", 50);

	set("qi", 10000);
	set("max_qi", 10000);
	set("jing", 1500);
	set("max_jing", 1500);
	set("neili", 10000);
	set("max_neili", 10000);
	set("jiali", 150);
	set("combat_exp", 12000000);
	set("score", 1000000);

    set_skill("lamaism", 500+jibie/3+random(jibie/5));
        set_skill("literate", 500+jibie/3+random(jibie/5));
        set_skill("force", 500+jibie/3+random(jibie/5));
        set_skill("parry", 500+jibie/3+random(jibie/5));
        set_skill("blade", 500+jibie/3+random(jibie/5));
        set_skill("sword", 500+jibie/3+random(jibie/5));
        set_skill("dodge", 500+jibie/3+random(jibie/5));
        set_skill("longxiang", 500+jibie/3+random(jibie/5));
        set_skill("shenkong-xing", 500+jibie/3+random(jibie/5));
        set_skill("hand", 500+jibie/3+random(jibie/5));
        set_skill("dashou-yin", 500+jibie/3+random(jibie/5));
        set_skill("mingwang-jian", 500+jibie/3+random(jibie/5));
        set_skill("xue-dao", 500+jibie/3+random(jibie/5));

        map_skill("force", "longxiang");
        map_skill("dodge", "shenkong-xing");
        map_skill("hand", "dashou-yin");
        map_skill("parry", "xue-dao");
        map_skill("blade", "xue-dao");
        map_skill("sword", "mingwang-jian");
	set("chat_chance_combat", 90);  

       set_temp("apply/attack", 200);
        set_temp("apply/defense", 200);
        set_temp("apply/armor", 500);
        set_temp("apply/damage", 250);

	setup();

	carry_object("d/kaifeng/obj/goldblade")->wield();
	carry_object("clone/cloth/yayifu")->wear();
}

