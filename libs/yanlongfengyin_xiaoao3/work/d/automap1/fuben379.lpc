// 地图源文件

#define SHORT_NAME "寂静森林"
#define LONG_NAME "这里就是传说中的寂静之森，树茂林密难见天日，四周静悄悄的充斥着\n一片死寂。看似的幽静却不知吞没了多少英雄侠士，宁静的表面下正汹涌着\n澎湃的杀机，真所谓的步步危机.....\n"


inherit ROOM;

void create() {
  set("outdoors", "automap1");
  set("short", SHORT_NAME);
  set("long", LONG_NAME);
  set("exits", ([
    "east": __DIR__ "fuben" + (1 + random(500)),
    "west": __DIR__ "fuben" + (1 + random(500)),
    "south": __DIR__ "fuben" + (1 + random(500)),
    "north": __DIR__ "fuben" + (1 + random(500)),
  ]));
  set("objects", ([
    "/d/automap1/npc/guai1": 1,
  ]));
  setup();
}

int valid_leave(object me, string dir) {
  mapping exits;
  string file_name;

  exits = this_object()->query("exits");

  if (mapp(exits) && sizeof(exits)) {
    if (!stringp(file_name = exits[dir]))
      return notify_fail("地图连接错误，请用 sos 通知管理员修改。\n");
    if (strlen(file_name) < 10)
      return notify_fail("连接的区域不正确，请用 sos 通知管理员修改。\n");
    if (!playerp(me) && base_name(this_object())[0..9] != file_name[0..9])
      return 0;
  }

  return ::valid_leave(me, dir);
}
