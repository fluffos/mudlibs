// youngboy.c  苗族少年
inherit NPC;

void create()
{
	int jibie;
	jibie = 60;
	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性
	set_name("苗族少年", ({ "young boy", "boy" }));
	set("gender", "男性");
	set("age", 20);
       set("per",30);
       set("max_qi",400);
	set("long", "一个身穿苗族服饰的英俊少年。\n");
	set("combat_exp", 8000);
	set("shen_type", 1);
       set_skill("unarmed", 30);
       set_skill("dodge", 30);
	setup();
	carry_object("/clone/cloth/cloth")->wear();
}
	
