// by victori
inherit NPC;
#include "duchong.h"
#include <ansi.h>


void create() {
  int jibie = 3000;
  set_name("人面蜘蛛", ({ "zhi zhu" }));
  set("race", "野兽");
  set("long", "一只面盆大小，长着人样脑袋的大蜘蛛。\n");
  set("age", 100);
  set("attitude", "peaceful");
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set("max_jing", 2500);
  set("max_qi", 2500);
  set("neili", 2000);
  set("max_neili", 4000);
  set("jiali", 300);

  set_skill("force", 500 + jibie * 2 + random(jibie / 5));
  set_skill("dodge", 500 + jibie * 2 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie * 2 + random(jibie / 5));
  set_skill("parry", 500 + jibie * 2 + random(jibie / 5));
  set_skill("wudu-shengong", 500 + jibie / 2 + random(jibie / 5));
  set_skill("wudu-yanluobu", 500 + jibie / 2 + random(jibie / 5));
  set_skill("qianzhu-wandushou", 500 + jibie / 2 + random(jibie / 5));
  map_skill("force", "wudu-shengong");
  map_skill("dodge", "wudu-yanluobu");
  map_skill("parry", "qianzhu-wandushou");
  map_skill("unarmed", "qianzhu-wandushou");

  set("limbs", ({ "头部", "身体", "长腿" }));
  set("verbs", ({ "bite" }));

  set_temp("apply/attack", 300);
  set_temp("apply/defense", 300);
  set_temp("apply/armor", 300);
  add_temp("apply/damage", 200);

  set("combat_exp", 5000000 + random(100) * 100000);

  set_weight(5000);
  setup();
}
