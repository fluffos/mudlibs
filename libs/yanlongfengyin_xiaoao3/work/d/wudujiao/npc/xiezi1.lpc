inherit NPC;
#include "duchong.h"
#include <ansi.h>


string *first_name = ({ "五毒", "长螯", "双头", "花斑" });
string *name_words = ({ "蝎子" });
void create() {
  int jibie = 100;
  string name;
  name = first_name[random(sizeof(first_name))];
  name += name_words[random(sizeof(name_words))];
  set_name(name, ({ "xie zi" }));
  set("race", "野兽");
  set("long", "一条半尺来长，鬼头鬼脑的小蝎子。\n");
  set("age", 100);
  set("attitude", "peaceful");
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set("max_jing", 600);
  set("max_qi", 700);

  set_skill("force", 500 + jibie * 2 + random(jibie / 5));
  set_skill("dodge", 500 + jibie * 2 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie * 2 + random(jibie / 5));
  set_skill("parry", 500 + jibie * 2 + random(jibie / 5));
  set_skill("huagong-dafa", 500 + jibie / 2 + random(jibie / 5));
  set_skill("chousui-zhang", 500 + jibie / 2 + random(jibie / 5));
  set_skill("zhaixinggong", 500 + jibie / 2 + random(jibie / 5));
  map_skill("force", "huagong-dafa");
  map_skill("dodge", "zhaixinggong");
  map_skill("parry", "chousui-zhang");
  map_skill("unarmed", "chousui-zhang");

  set("limbs", ({ "头部", "身体", "尾巴" }));
  set("verbs", ({ "bite" }));
  set_temp("apply/attack", 80);
  set_temp("apply/defense", 50);
  set_temp("apply/armor", 50);

  set("combat_exp", 100000 + random(40) * 10000);

  set_weight(5000);
  setup();
}
