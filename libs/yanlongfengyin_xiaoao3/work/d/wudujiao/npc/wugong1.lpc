// by victori
inherit NPC;
#include "duchong.h"
#include <ansi.h>


string *first_name = ({"百足", "千节", "大头", "金线"});
string *name_words = ({"蜈蚣"});
void create()
{
	int jibie = 100;
        string name;
        name = first_name[random(sizeof(first_name))];
        name += name_words[random(sizeof(name_words))];
        set_name(name,({"wu gong"}));
	set("race", "野兽");
	set("long", "一条一尺多长，鬼头鬼脑的小蜈蚣。\n");
	set("age", 100);
	set("attitude", "peaceful");
	set("xyzx_sys/level", jibie);	//2016.5.22阿飞调整NPC属性
	set("max_jing", 600);
	set("max_qi", 600);

    set_skill("force", 500+jibie*2+random(jibie/5));
    set_skill("dodge", 500+jibie*2+random(jibie/5));
    set_skill("unarmed", 500+jibie*2+random(jibie/5));
    set_skill("parry", 500+jibie*2+random(jibie/5));
    set_skill("biyun-xinfa",500+jibie/2+random(jibie/5));
    set_skill("qiulinshiye", 500+jibie/2+random(jibie/5));
    set_skill("biye-wu", 500+jibie/2+random(jibie/5));
    map_skill("force", "biyun-xinfa");
    map_skill("dodge", "qiulinshiye");
    map_skill("parry", "biye-wu");
    map_skill("unarmed", "biye-wu");

	set("limbs", ({ "头部", "身体", "尾巴" }) );
	set("verbs", ({ "bite" }) );

	set_temp("apply/attack", 80);
	set_temp("apply/defense", 80);
	set_temp("apply/armor", 80);
	set_temp("apply/damage", 80);

	set("combat_exp", 100000+random(40)*10000);
 
	set_weight(5000);
	setup();
}
