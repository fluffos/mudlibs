// Room: /d/hainan/baiyuncheng

inherit ROOM;

void create ()
{
  set ("short", "白云城");
  set ("long", @LONG
    黄河远上白云间，一片孤城万仞山。白云城坐落在群山之间，凌驾于白云之上。 
城中心树立一座白衣剑神雕像，高耸入云。任何人站立在此处，感觉渺小无比。城
中白云飘渺，常年笼罩的云雾之中。 
LONG);
set("outdoors", "hainan");
set("no_clean_up", 0);
  set("objects", ([
  __DIR__"npc/yegucheng.lpc" : 1,
]));

  set("exits", ([ 
  "south" : __DIR__"baiyunshan",
]));
set("outdoors", "hainan");
  set("item_desc", ([ 
  "白衣剑神" : "一尊陶瓷的白衣剑神，高不见顶，直入云颠之间。左手背后，右手握剑斜向右下角，其容貌秀丽端正，其神情冷傲孤寂。",
]));
setup();
replace_program(ROOM);
}
