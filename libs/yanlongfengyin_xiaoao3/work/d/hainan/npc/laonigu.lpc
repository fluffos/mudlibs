#include <ansi.h>
inherit NPC;
string *name = ({ "天聋尼", "地哑尼", });
void create() {
  int jibie;
  jibie = 2000;
  //	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性	
  set("xyzx_sys/level", jibie);  //2017.9.1阿飞调整NPC等级为固定值，取消20%的浮动设定	
  set_name(YEL + name[random(sizeof(name))] + NOR, ({ "nigu", "dashi" }));
  set("gender", "女性");
  set("age", 40 + random(40));
  set("title", YEL "白云庵传人" NOR);
  set("long", "一位面容慈祥的老尼,正拿着扫帚扫地。\n");
  //  create_family("白云庵",4,"传人");
  create_family("南海派", 4, "传人");
  set("attitude", "peaceful");
  set("combat_exp", 50000000);
  set("per", 15);
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("baihua-zhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("feixian-jian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("bitao-shengong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("qiongya-bufa", 500 + jibie / 3 + random(jibie / 5));
  map_skill("sword", "feixian-jian");
  map_skill("unarmed", "baihua-zhang");
  map_skill("parry", "feixian-jian");
  map_skill("force", "bitao-shengong");
  set("max_qi", 14000);
  set("max_jing", 54000);
  set("max_jingli", 54400);
  set("neili", 54000);
  set("max_neili", 54000);
  set("force_factor", 3);
  setup();
  carry_object("/d/hainan/obj/hui_cloth")->wear();
  carry_object("/d/hainan/obj/saozhou")->wield();
  add_money("gold", 2);
}

void attempt_apprentice(object ob) {
  if (!((string)ob->query("gender") == "女性")) {
    command("say 我们白云庵只收女徒，这位" + RANK_D->query_respect(ob) + "还是另请高就吧。\n");
    return;
  }
  if ((int)ob->query_skill("bitao-shengong", 1) < 300) {
    command("say 这位" + RANK_D->query_respect(ob) + "对我南海派的内功心法还不了解。\n");
    return;
  }
  command("say 这位" + RANK_D->query_respect(ob) + "入了我白云庵可不要后悔你可不要后悔吆。\n");
  command("recruit " + ob->query("id"));

}
