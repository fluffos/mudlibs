#include <ansi.h>

inherit NPC;

void create()
{
	int jibie;
	jibie = 500;
//	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性	
	set("xyzx_sys/level", jibie);	//2017.9.1阿飞调整NPC等级为固定值，取消20%的浮动设定	
  set_name("蒙云",({ "meng yun", "dizi","girl" }) );
  set("gender", "女性" );
  set("title",YEL+"粉金刚"+NOR);
  set("long", "白云庵弟子之一,专门看管那些偷窥的人.\n");
//   create_family("白云庵",5,"传人");
  create_family("南海派", 5, "传人");
  set("age", 15+random(10));
  set("attitude", "peaceful");
  set("str", 50);
  set("per", 50);
  set("combat_exp",34000000);
  set("neili",9500);
  set("max_neili",9500);
  set("force_factor", 100);
  set("max_jing", 14000);
  set("max_qi", 14000);
  set("max_jingli", 14000);
  set("inquiry",([
  "出去":"要想过去,先过了我这关.\n",
  ]));
  set_skill("unarmed",500+jibie/3+random(jibie/5));
  set_skill("dodge",500+jibie/3+random(jibie/5));
  set_skill("parry",500+jibie/3+random(jibie/5));
  set_skill("sword",500+jibie/3+random(jibie/5));
  set_skill("force",500+jibie/3+random(jibie/5));
  set_skill("baihua-zhang",500+jibie/3+random(jibie/5));
  set_skill("qiongya-bufa",500+jibie/3+random(jibie/5));
  set_skill("bitao-shengong",500+jibie/3+random(jibie/5));
   set_skill("feixian-jian",500+jibie/3+random(jibie/5));
  map_skill("sword","feixian-jian");
  map_skill("force","bitao-shengong");
  map_skill("dodge","qiongya-bufa");
  map_skill("parry","baihua-zhang");
  map_skill("unarmed","baihua-zhang");
  
  set("chat_chance",6);
  set("chat_msg",({
  "蒙云说道:我最恨那些无赖流氓了.\n",
  "蒙云嘿嘿一笑,到了这里,想出去就难了.\n",
  "蒙云道:要想出去,得先过了我这关.\n",
}));

  setup();
  carry_object("/d/hainan/obj/triger_cloth")->wear();
  carry_object("/d/hainan/obj/yuruyi")->wield();
}

void attempt_apprentice(object ob)
{
        if ( !((string)ob->query("gender")=="女性"))
		{
           command("say 我们白云庵只收女徒，这位" + RANK_D->query_respect(ob) + "还是另请高就吧。\n");
           return;
		}
	command("say 嘻嘻，这位" + RANK_D->query_respect(ob) + "你可不要后悔吆。\n");
	command("recruit " + ob->query("id") );
   
}