inherit ITEM;
inherit F_UNIQUE;

void init()
{
        add_action("do_canwu", "canwu");
} 
void create()
{
        set_name("伪九阴真经", ({ "jiuyin zhenjing3","zhenjing3", }));
        set_weight(500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "本");
             set("long",
        "这是一本用薄绢写成的书。上书：“九阴真经”。\n"
        "书页斐然如新，读其文似乎颇有道理，然照其修炼又觉得阴阳颠倒。\n",
        );
                set("value", 0);
                set("material", "silk");
                set("skill", ([
                        "name":       "jiuyin-zhenjing",
        "exp_required":100000,
                        "jing_cost":  40,
                        "difficulty": 20,
                        "max_skill":  100,
						"min_skill":  99
                ]) );
        }
}



int do_canwu(string arg)
{
        object me = this_player();
        object where = environment(me);
        object ob;
		string msg;
//        mapping skill;
        int hamaskill, lvl;
        int cost;

        if (arg != "jiuyin zhenjing3")
                return notify_fail("你要参悟什么？\n");
		if( where->query("no_fight") )
				return notify_fail("大庭广众之下参悟绝世武学不怕被人打劫吗？。\n");
        if (where->query("pigging"))
                return notify_fail("你还是专心拱猪吧！\n");
        if (me->is_busy())
                return notify_fail("你现在正忙着呢。\n");
        if( me->is_fighting() )
                return notify_fail("你无法在战斗中专心下来参悟真经！\n");
        if (!id(arg) || !objectp(ob = present(arg, me)))
                return notify_fail("你要参悟什么？\n");
		if ( me->query("id")!=ob->query("owner"))
			return notify_fail("这本武林秘籍是你的吗？\n");
        if ((string)me->query("gender") == "无性" )
                return notify_fail("你无根无性不足，再参悟下去恐怕经脉俱断！\n");
        if( (int)me->query_skill("literate", 1)<1000 )
                return notify_fail("你是个文盲，先学点文化(literate)吧。\n");
        if( (int)me->query_skill("hamagong", 1)<1000 )
                return notify_fail("你没有蛤蟆功做根坻，参悟这来路不明的九阴真经恐怕有走火入魔之危！\n");
        if( (int)me->query_skill("chanchu-bufa", 1)<2000 )
                return notify_fail("你的蟾蜍步法太低，参悟这来路不明的九阴真经恐怕爆走！\n");
        if ((int)me->query_skill("force", 1) < 2000)
                return notify_fail("就这么点基本内功参悟这种有疑问的九阴真经是闲死的不够快吗！\n");
        if ((int)me->query("max_neili", 1) < 100000)
                return notify_fail("你内力修为太差了，无法催动内力进入奇经八脉。\n");
        if ((int)me->query("max_jingli", 1) < 100000)
                return notify_fail("你精力修为太差了，无法进入顿悟状态。\n");
        if( !me->query_temp("jm/baituo4") )
                return notify_fail("未获得欧阳锋的指点，自行参悟肯定会走火入魔的！\n");			
        if( me->query("jm/baituo") )
                return notify_fail("你已经完全领悟了经脉逆转的运行方式，不需要再参悟了！\n");
			
        if( (int)me->query("neili") < 1000 || (int)me->query("jingli") < 1000) 
		{
                write( CYN"忽然，你觉得内息一乱，知道不好！顿时内力不受控制，全身经脉紊乱，似乎丢失了什么！\n"NOR);
				me->add("xyzx_sys/level",-1);
                me->unconcious();
                return 1;
        }

        hamaskill = me->query_skill("hamagong", 1);
        cost = hamaskill/10;
        if( cost < 100) cost = 100;
        lvl = hamaskill/100;
        if( lvl < 1) lvl = 1;

        message_vision("你专心参悟九阴真经，脸色忽青忽红，连变" + lvl + "次。\n", me);
		me->start_busy(1);
        me->add("jingli", -cost);
        me->add("neili", -cost);
		if (random(100000)<(int)me->query("con",1))
		{
			message_vision(HIB"突然你灵光一闪，头下脚上倒立，全身经脉逆转，赫然发现这伪九阴真经虽然阴阳颠倒，但阴阳依时而转，生死流转，于死地之间亦有一线生机。\n"NOR, me);
			message_vision(HIC"。恭喜你于错乱之中，返本朔源，领悟了白驼山的逆转经脉绝技！\n"NOR, me);
			message("channel:chat", HIM"【天降奇才】"HIM + "听说"+me->query("name")+"天纵奇才，参悟伪九阴真经居然领悟了白驼山的逆转经脉绝技！\n"NOR,users() );
			me->set("jm/baituo",1);
			me->add("family_score",1);
		}
		else
		{
			switch ( random(10) )
			{
			case 0: msg = RED"天之道，损有余而补不足，是故虚胜实，不足胜有余。\n" NOR;
					break;
			case 1: msg = GRN"其意博，其理奥，其趣深，天地之象分，阴阳之候列，变化之由表，死生之兆彰，不谋而遗迹自同，勿约而幽明斯契，稽其言有微，验之事不忒，诚可谓至道之宗，奉生之始矣。\n" NOR;
					break;
			case 2: msg = YEL"假若天机迅发，妙识玄通，成谋虽属乎生知，标格亦资于治训，未尝有行不由送，出不由产者亦。\n" NOR;
					break;
			case 3: msg = BLU"然刻意研精，探微索隐，或识契真要，则目牛无全，故动则有成，犹鬼神幽赞，而命世奇杰，时时间出焉。\n" NOR;
					break;
			case 4: msg = MAG"五藏六府之精气，皆上注于目而为之精。\n" NOR;
					break;
			case 5: msg = CYN"精之案为眼，骨之精为瞳子，筋之精为黑眼，血之精力络，其案气之精为白眼，肌肉之精为约束，裹撷筋骨血气之精而与脉并为系，上属于脑，后出于项中。\n" NOR;
					break;
			case 6: msg = WHT"故邪中于项，因逢其身之虚，其人深，则随眼系以入于脑，入手腼则脑转，脑转则引目系急，目系急则目眩以转矣。\n" NOR;
					break;
			case 7: msg = HIR"邪其精，其精所中不相比亦则精散，精散则视岐，视岐见两物。\n" NOR;
					break;
			case 8: msg = HIG"阴极在六，何以言九。\n" NOR;
					break;
			case 9: msg = HIY"太极生两仪，天地初刨判。六阴已极，逢七归元太素，太素西方金德，阴之清纯，寒之渊源。\n" NOR;
					break;			
			}
			message_vision(msg, me);
		}
		
        return 1;
}


int query_autoload() { return 1; }      