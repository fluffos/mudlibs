// by guoguo

inherit ITEM;
private int *allfu=({0,0,0,0,0,0,0,});


void create()
{
        set_name("优化符仓库", ({"youhuafucangku"}));
        set("total_youhuafu",0);
}

void do_save(string arg)
{
    save_object(arg);
}

void do_load(string arg)
{
    restore_object(arg);
}

int* get_youhuafu_data()
{
    if(!allfu || sizeof(allfu)==0)
        allfu=({0,0,0,0,0,0,0,});
    return allfu;
}

