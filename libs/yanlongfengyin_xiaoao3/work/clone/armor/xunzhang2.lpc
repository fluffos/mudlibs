#include <armor.h>
#include <ansi.h>

inherit MEDAL;
void create()
{
	set_name(HIY"任务勋章"NOR, ({ "renwu xunzhang","xunzhang", "medal" }) );
	set_weight(3000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "传说中神奇的任务勋章，可以提高任务时获得的经验值20%。\n");
		set("material", "medal");
		set("unit", "件");
		set("icon", "10069");
		set("value", 10000000);	
		set("armor_prop/strength", 10000);
		set("armor_prop/intelligence", 10000);	
		set("armor_prop/constitution", 10000);	
		set("armor_prop/dexerity", 10000);	
		set("armor_prop/karma", 10000);
		set("armor_prop/personality", 10000);	
		set("armor_prop/armor", 10000);
//		set("xyzx_item/pinji", 0);
		set("xyzx_save_item", 1);
		set("xyzx_sys/bind_type", 0);	
//		set("no_steal",1);
//		set("no_put",1);
//		set("no_get",1);
//		set("no_beg",1);
//		set("no_jie", 1);	//不能贴符
//		set("no_tie",1);	//不能贴符
//		set("no_zm",1);		//不能镶嵌动态宝石
//		set("no_give", 1);		//勋章不能送人
//		set("no_drop", 1);		//勋章不能丢弃
//		set("xyzx_sys/no_give", 1);		//勋章绑定后也不能送人
//		set("dtzb",1); //添加判定,非副本装备无法强化
		set("wear_msg", CYN "只见光芒四射,$N热情洋溢的将一个霞光万道的$n"CYN"挂在左胸口。\n" NOR);
		set("remove_msg", GRN "$N轻轻的一挥手，$n"GRN"幻化成一片霞雾逐渐消失不见。\n" NOR);
	}
	setup();
}
int query_autoload() { return 1; }

int wear()
{
    if (::wear())
	{
		this_player()->set_temp("renwu_exp_add", 20);	//穿上后附加任务经验提升20%效果
		return 1;
    }else
		return 0;
}
int unequip()
{
    if (::unequip())
	{  	
		this_player()->delete_temp("renwu_exp_add");
		return 1;
    }else
		return 0;
}