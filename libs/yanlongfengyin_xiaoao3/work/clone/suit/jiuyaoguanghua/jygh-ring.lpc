// 九耀光华套装：戒指

#include <armor.h>
#include <ansi.h>

inherit FINGER;
inherit F_ITEM_MAKE;

void create()
{
	int pj, lvl, armor;

	pj = random( (int) sizeof(armor_shuxing) );  //由于动态装备的属性只有7种了所以这里要改		
	lvl = random(get_system_config(DATA_CONFIG_DIR "armor/cloth.h", "ITEM_CLOTH_MAX_LEVEL"))+1;
	armor = lvl * 100/2;
	armor = armor + random(armor);
	if ( !armor || armor < 100 ) armor = 1+random(99);
	
	set_name(RED"九耀光华戒指"NOR, ({ "jiuyaoguanghua jiezhi","jiezhi", "ring" }) );
	set("long", "九曜星君为谢王母娘娘蟠桃会之请，特凝聚九曜光华，成此宝物，华彩耀目，仙气袅然，属于传说中的九耀光华套装中的一件。\n");
	set_weight(300 + (random(pj) * 100) + (random(lvl) * 100));
	set("value", 7000000);	
//	set("armor_prop/level", lvl);	//初始设定为0级
	set("armor_prop/level", 0);
	get_item_shuxing("armor", pj, lvl, 1);
	set("armor_prop/armor", armor);
	set("unit", "件");	
	set("icon", "10077");	
	set("material", "gem");
	set("owner_id",1);	
	set("dtzb",1); //添加判定,非副本装备无法强化
	set("xyzx_save_item", 1);	
	set("xyzx_sys/bind_type", 0);		
	set("xyzx_item/pinji", 5);
	set("taozhuang",25);
	set("max_level", 50);	
 //---------------------------------------------------------------
              //套装参数
    set("suit",RED"九耀光华套装"NOR);  //套装名称
    set("suit_lvl", 5);             //套装等级
    set("suit_count",10);           //套装部件数量
              //套装各部件
    set("suit_mod/armor","九耀光华铠甲");
    set("suit_mod/boots","九耀光华长靴");
    set("suit_mod/pants","九耀光华长裤");
    set("suit_mod/hand","九耀光华护手");
    set("suit_mod/head","九耀光华头盔");
    set("suit_mod/neck","九耀光华项链");
    set("suit_mod/cloth","九耀光华长衫");
    set("suit_mod/ring","九耀光华戒指");
    set("suit_mod/shield","九耀光华盾牌");
    set("suit_mod/surcoat","九耀光华披风");
    set("suit_mod/waist","九耀光华腰带");
	set("suit_mod/wrists","九耀光华护腕");
	//套装全部附加天赋效果  
	set("suit_eff/dexerity", 50000); 
	set("suit_eff/intelligence", 50000);  
	set("suit_eff/constitution", 50000);  
	set("suit_eff/strength", 50000); 
	set("suit_eff/armor", 50000); 
//	set("suit_eff/karma", 50000); 	
//	set("suit_eff/personality", 50000); 
    //套装全部附加技能效果     
//	set("suit_eff_skill/huagong-dafa", 1000);
//	set("suit_eff_skill/beiming-shengong", 1000);
//	set("suit_eff_skill/xixing-dafa", 1000);
	
 //---------------------------------------------------------------
	setup(1);
}