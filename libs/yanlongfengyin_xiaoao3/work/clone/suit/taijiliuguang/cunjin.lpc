// tielianzi.c
#include <weapon.h>
#include <ansi.h>

inherit THROWING;

void create()
{
        set_name(RED"一寸光阴一寸金"NOR, ({ "cun jin", "throwing" }) );
        if( clonep() )
                set_default_object(__FILE__);
        else {
				set("xyzx_item/pinji", 5);
				set("owner_id",1);
				set("taozhuang",15);
				set("max_level", 1);
				set("xyzx_save_item", 1);
				set("xyzx_sys/bind_type", 0);		
				set("weapon_prop/strength", 30000);
				set("weapon_prop/intelligence", 30000);	
				set("weapon_prop/constitution", 30000);	
				set("weapon_prop/dexerity", 30000);	
				set("weapon_prop/karma", 30000);
				set("weapon_prop/personality", 30000);		
				set("no_tie",1); //添加判定,暗器不能贴符
                set("unit", "些");
                set("value", 0);
                set("base_unit", "颗");
                set("base_weight", 10);
                set("base_value", 30);
                set("material", "iron");
                set("long", HIW"不属于人间的暗器，练到极致能击穿时光。\n"NOR);
                set("wield_msg", HIC"$N神情悲苦，一寸光阴一寸金，手指间阴阳之气流转！\n"NOR);
                set("unwield_msg",HIC"$N微微叹息，寸金难买寸光阴，珍惜现在。\n"NOR);
        }
        set_amount(10000);
        init_throwing(30000);
        setup();
}
int hit_ob(object me,object victim,int damage_bonus)
{
victim->apply_condition("wuxing_poison", 20);
victim->apply_condition("emerald_poison", 20);
victim->apply_condition("feng_poison", 20);
victim->apply_condition("fire_poison", 20);
victim->apply_condition("hedinghong_poison", 20);
victim->apply_condition("corpse_poison", 20);
victim->apply_condition("chilian_poison", 20);
//if( !victim->is_busy() ) victim->start_busy(1);
return damage_bonus;
}
int query_autoload() { return 1; }