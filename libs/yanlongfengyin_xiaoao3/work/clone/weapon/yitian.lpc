// yitian-jian 倚天剑
// Modifyied by Uranus

#include <weapon.h>
#include <ansi.h>

inherit SWORD;

void create()
{
        set_name(HIY HIW "倚天剑" NOR,({ "yitian jian", "yitian", "sword", "jian" }) );
        set_weight(10000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
			set("unit", "把");
			set("icon", "10016");
            set("value",15000000);
//      	set("no_drop", "这样东西不能离开你。\n");	
//			set("no_put",1);
			set("material", "steel");
			set("long", "这是天下第一利器，有“倚天不出，谁与争锋”之说，剑鞘上金丝镶着两个字“倚天”。整个剑身隐隐发出一层青气，剑未出鞘，已可见其不凡。\n");
			set("wield_msg", HIY "$N“唰”的一声抽出$n" + HIY + "挽了个剑花，但见寒芒吞吐，电闪星飞。 ....$N不由得从心底升起一股凌云豪气。\n" NOR);
			set("unwield_msg", HIW "倚天剑"HIY"幻作一道白光，「唰」地飞入剑鞘。\n" NOR);
        }
	init_sword(600,2);	
	setup();
}


int query_autoload() { return 1; }
