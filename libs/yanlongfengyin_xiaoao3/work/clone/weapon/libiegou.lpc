// tielianzi.c
#include <weapon.h>
#include <ansi.h>

inherit THROWING;

void create()
{
        set_name(HIC"离别钩"NOR, ({ "libie gou", "throwing" }) );
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "些");
                set("value", 0);
                set("base_unit", "颗");
                set("base_weight", 3000);
                set("base_value", 0);
                set("material", "iron");
                set("long", HIW"你用离别钩，只不过为了要相聚。\n"NOR);
                set("wield_msg", HIC"$N没有人知道它从何处而来，见过它的人都已经和这个世界离别了！\n"NOR);
                set("unwield_msg",HIC"$N这柄钩，无论钩住什么都会造成离别。\n"NOR);
        }
        set_amount(1000);
        init_throwing(1000);
        setup();
}
int query_autoload() { return 1; }