/**
 * @file /cmds/dev/mudinfo.lpc
 *
 * Displays runtime statistics about the running mud.
 *
 * @created 2024-02-04 - Gesslar
 * @last_modified 2026-07-13 - Gesslar
 *
 * @history
 * 2024-02-04 - Gesslar - Created
 * 2026-07-13 - Gesslar - Added help text and LPCDoc header
 */

inherit STD_CMD;

void setup() {
  usage_text = "mudinfo";
  help_text = "Reports runtime statistics about the running mud. The output "
    "lists the mud name and current boot number, the total number of loaded "
    "objects, and counts broken down by category: virtual objects, living "
    "objects, players, non-players, and rooms.";
}

mixed main(object _tp, string _arg) {
  object *obs = objects();
  string out =
  `Mud Name: ${mud_name()}\n`
  `Boot Number: ${BOOT_D->query_boot_number()}\n`
  `Objects: ${sizeof(obs)}\n`
  `Virtual: ${sizeof(filter(obs, (: virtualp :)))}\n`
  `Livings: ${sizeof(filter(obs, (: environment($1) && living($1) :)))}\n`
  `Players: ${sizeof(filter(obs, (: userp :)))}\n`
  `Non-Players: ${sizeof(filter(obs, (: environment($1) && living($1) && !userp($1) :)))}\n`
  `Rooms: ${sizeof(filter(obs, (: $1->is_room() :)))}\n`
  ;

  return out;
}
