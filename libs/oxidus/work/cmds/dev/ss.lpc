/**
 * @file /cmds/dev/ss.lpc
 * Shallow scan
 *
 * @created 2024-07-28 - Gesslar
 * @last_modified 2026-07-13 - Gesslar
 *
 * @history
 * 2024-07-28 - Gesslar - Created
 * 2026-07-13 - Gesslar - Added help text
 */

inherit STD_CMD;

void setup() {
  usage_text = "ss [<object>]\n";
  help_text =
    "Shallow scans an object, listing only its immediate (top-level) "
    "inventory without descending into nested containers. The object may be "
    "named by any resolvable reference; when omitted, the current room "
    "('here') is scanned. Each entry shows the object's file/id and its short "
    "description.";
}

mixed main(object tp, string arg) {
  object ob, *inv;

  if(!arg)
    arg = "here";

  ob = get_object(arg);
  if(!ob)
    return "No such object.";

  inv = all_inventory(ob);

  tell(tp, "Shallow scanning "+ob+"\n");
  foreach(ob in inv)
    tell(tp, "  " + ob + " (" + get_short(ob) + ")\n");

  return 1;
}
