/**
 * @file /cmds/dev/gauge.lpc
 *
 * Executes a command and reports how much CPU time it consumed.
 *
 * @created 2025-03-10 - Gesslar
 * @last_modified 2026-07-13 - Gesslar
 *
 * @history
 * 2025-03-10 - Gesslar - Created
 * 2026-07-13 - Gesslar - Moved help into setup()
 */

inherit STD_CMD;

void setup() {
  usage_text = "gauge <command>";
  help_text =
    "The gauge command will execute the given command, and will tell you how "
    "many milliseconds of CPU the command took.";
}

mixed main(
  /** @type {STD_PLAYER} */ object tp,
  string cmd
) {
  mapping before, after;
  int stime, usertime, eval_cost;

  if(!cmd)
    return "usage: gauge <command>\n";

  before = rusage();

  eval_cost = tp->force_me(cmd);
  after = rusage();
  usertime = after["utime"] - before["utime"];
  stime = after["stime"] - before["stime"];

  return sprintf(
    "%d milliseconds of system time.\n"+
    "%d milliseconds of user time.\n" +
    "%d eval cost.\n",
    stime, usertime, eval_cost);
}
