/**
 * @file /cmds/dev/mudconfig.lpc
 *
 * Lists all MUD configuration options available to the mud_config() sefun.
 *
 * @created 2024-02-19 - Gesslar
 * @last_modified 2026-07-13 - Gesslar
 *
 * @history
 * 2024-02-19 - Gesslar - Created
 * 2026-07-13 - Gesslar - Added help text and LPCDoc header
 */

#include <daemons.h>

inherit STD_CMD;

void setup() {
  usage_text = "mudconfig";

  help_text =
    "Displays the current MUD configuration as maintained by the config "
    "daemon. The full set of configuration keys and their values, which are "
    "the same values exposed through the mud_config() simul_efun, is printed "
    "in a formatted listing. This command takes no arguments.";
}

mixed main(object _tp, string _arg) {
  mapping config = CONFIG_D->get_all_config();
  string temp = pretty_map(config);

  return ({ "Current MUD Configuration", "" }) + explode(temp, "\n");
}
