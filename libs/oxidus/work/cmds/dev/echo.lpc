/**
 * @file /cmds/dev/echo.lpc
 *
 * A command to echo a message to a room.
 *
 * @created 2024-02-04 - Gesslar
 * @last_modified 2026-07-13 - Gesslar
 *
 * @history
 * 2024-02-04 - Gesslar - New base
 * 2026-07-13 - Gesslar - Moved help into setup() usage_text/help_text; modernized main()
 */

inherit STD_CMD;

void setup() {
  usage_text = "echo <message>";
  help_text =
    "This command provides a developer with the ability to print a message to "
    "everyone in the room.\n"
    "\n"
    "* The message is printed as-is\n"
    "* Colour codes are substituted\n"
    "* The message is not wrapped\n"
    "* The message is not echoed to the self, but the echoed message is confirmed\n"
    "\n"
    "Note: This will not print to anybody if you are hidden.";
}

mixed main(
  /** @type {STD_PLAYER} */ object caller,
  string str
) {
  object room = environment(caller);

  if(!str)
    return _info(caller, "Syntax: echo <argument>");

  _info(caller, `You echoed to the room:\n${str}\n`);

  tell_down(room, str, 0, caller);

  return 1;
}
