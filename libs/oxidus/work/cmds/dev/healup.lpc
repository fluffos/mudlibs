/**
 * @file /cmds/dev/healup.lpc
 * Command for developers to heal themselves and others.
 *
 * @created 2024-07-31 - Gesslar
 * @last_modified 2026-07-13 - Gesslar
 *
 * @history
 * 2024-07-31 - Gesslar - Created
 * 2026-07-13 - Gesslar - Added help text
 */

inherit STD_CMD;

void setup() {
  usage_text =
    "healup\n"
    "healup <living>\n";
  help_text =
    "Fully restores a living object. With no argument, restores yourself. With "
    "an argument, restores the named living object if it can be found. Fails if "
    "no such object exists or the target is not living.";
}

mixed main(object tp, string str) {
    /** @type {STD_BODY} */ object ob;

    if(!str)
        ob = tp;

    if(!ob)
        ob = get_object(str);

    if(!ob)
        return "No such living object found.\n";

    if(!living(ob))
        return "That object is not living.\n";

    ob->restore();

    if(ob == tp)
        return "You've restored yourself.\n";

    return "You've restored " + ob->query_name() + ".\n";
}
