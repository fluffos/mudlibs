/**
 * @file /cmds/dev/reset.lpc
 * Resets a target object
 *
 * @created 2024-07-23 - Gesslar
 * @last_modified 2026-07-13 - Gesslar
 *
 * @history
 * 2024-07-23 - Gesslar - Created
 * 2026-07-13 - Gesslar - Added help text
 */

inherit STD_CMD;

void setup() {
  usage_text =
    "reset\n"
    "reset <target>\n";

  help_text =
    "Calls the reset() function on a target object, re-running its periodic "
    "reset behaviour on demand. With no argument, the object in your current "
    "room ('here') is reset. Give a <target> to resolve and reset a specific "
    "object instead. A confirmation naming the object and its file is shown, "
    "or an error if the target cannot be found.";
}

mixed main(object _tp, string arg) {
  object ob;

  if(!arg)
    arg = "here";

  ob = get_object(arg);

  if(!objectp(ob))
    return _error("Unable to find %s.", arg);

  call_if(ob, "reset");

  return _ok("Reset called on %s (%s).", get_short(ob), file_name(ob));
}
