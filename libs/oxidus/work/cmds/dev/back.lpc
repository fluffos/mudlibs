/**
 * @file /cmds/dev/back.lpc
 * Return to your previous location.
 *
 * @created 2024-09-09 - Gesslar
 * @last_modified 2026-07-13 - Gesslar
 *
 * @history
 * 2024-09-09 - Gesslar - Created
 * 2026-07-13 - Gesslar - Added help text
 */

inherit STD_CMD;

void setup() {
  usage_text = "back";
  help_text =
    "Returns you to your previous location, the room you were in before your "
    "last move. If you have no recorded previous location, or it cannot be "
    "loaded or entered, you are not moved.";
}

mixed main(
  /** @type {STD_PLAYER} */ object tp,
  string _str
) {
  string loc = tp->query_last_location();

  if(!loc)
    return "You have no previous location to return to.";

  /** @type {STD_ROOM} */ object room;

  string e = catch(room = load_object(loc));
  if(e)
    return _error(tp, "There was a problem loading your previous location.\n%s", e);

  int result = tp->move_living(room);

  if(result)
    return "You were unable to move to your previous location.\n"
           "Reason: " + MOVE_REASON[result];

  return "You return to " + room->query_short() + ".";
}
