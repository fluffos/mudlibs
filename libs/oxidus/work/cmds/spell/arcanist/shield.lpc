 * @last_modified 2026-07-31 - Gesslar
 *
 * @history
 * 2026-07-31 - Gesslar - Created
 */

inherit STD_SPELL;

void setup() {
  set_name("shield");

  aggressive = false;
  sp_cost = 10.0;

  usage_text = "shield";
  help_text =
    "Surround yourself with inertial shielding that absorbs a portion of incoming damage until it dissipates. "
    `This spell costs ${evaluate(sp_cost)} SP.`
  ;
}

mixed use(
  /** @type {STD_BODY} */ object tp,
  string arg
) {
  if(tp->is_acting())
    return "You are already doing something.";

  if(tp->module("shielding", "shielded"))
    return "You are already shielded.";

  mapping config = ([
    "name": "inertial shielding",
    "short": "Inertial Shielding",
    "colour": "{{c3f}}",
    "mitigation_percent": 35.0,
    "health": 35.0,
    "max_health": 35.0,
  ]);

  if(!tp->add_module("shielding", config))
    return "You are already shielded.";

  apply_cost(tp, arg);
  apply_cooldown(tp, arg);

  return 1;
}
