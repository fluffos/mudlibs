/**
 * @file /cmds/action/dispose.lpc
 *
 * Command to dispose of dead bodies.
 *
 * @created 2024-08-06 - Gesslar
 * @last_modified 2024-08-06 - Gesslar
 *
 * @history
 * 2024-08-06 - Gesslar - Created
 */

inherit STD_ACT;

void setup() {
  usage_text = "dispose <corpse>";
  help_text =
    "This command will allow you to dispose of a corpse in your environment. "
    "Only corpses may be disposed of in this manner.";
}

mixed main(
  /** @type {STD_BODY} */ object tp,
  string str
) {
  /** @type {LIB_CORPSE} */ object corpse;
  string short;

  if(!str)
    return "Dispose of what?";

  if(!corpse = find_target(tp, str))
    return "You do not see that here.";

  if(!corpse->is_corpse())
    return "You cannot dispose of that.";

  short = corpse->query_short();
  if(!short)
    return "You cannot dispose of that.";

  if(!corpse->remove())
    return "You could not dispose of that.";

  tp->simple_action("Quickly and quietly, $n $vwork to dispose of the $o.", short);

  return 1;
}
