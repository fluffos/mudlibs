/**
 * @file /cmds/adm/master.lpc
 * Command to reload core system files.
 *
 * @created 2024-07-17 - Gesslar
 * @last_modified 2026-07-13 - Gesslar
 *
 * @history
 * 2024-07-17 - Gesslar - Created
 * 2026-07-13 - Gesslar - Moved help into setup()
 */

inherit STD_CMD;

private nosave nomask mixed *actions;

void setup() {
  actions = ({
    ({"Destruct simul_efun object",(: destruct(find_object(SIMUL_OB)) :)}),
    ({"Load simul_efun object",(: load_object(SIMUL_OB) :)}),
    ({"Destruct master object",(: destruct(master()) :)}),
    ({"Destruct master/security",(: destruct(load_object("/adm/obj/master/security")) :)}),
    ({"Load master/security",(: load_object("/adm/obj/master/security") :)}),
    ({"Load master object",(: load_object("/adm/obj/master") :)}),
    ({"Rehash system configuration",(: CONFIG_D->rehash_config() :)}),
    ({"Rehash help system",(: HELP_D->rehash() :)}),
  });

  usage_text = "master";
  help_text =
    "This command reloads core system files: it destructs and reloads the "
    "simul_efun object, the master object and its security, then rehashes the "
    "system configuration and help system. No argument is taken.";
}

mixed main(/** @type {STD_PLAYER} */ object _caller, string _arguments) {
  string err = "";

  if(!adminp(previous_object()))
    return _error("Access denied.");

  foreach(mixed *action in actions) {
    mixed result;

    _info(action[0]);

    result = catch(action[1]());
    if(result)
      err += result;
  }

  if(sizeof(err))
    return _error("Error when reloading system objects:\n\n"
      "%s\n"
      "Refer to {{bl1}}{{ul1}}%scatch{{res}}",
      err,
      log_dir()
    );
  else
    return _ok("System objects updated successfully.");
}
