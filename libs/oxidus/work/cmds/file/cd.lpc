/**
 * @file /cmds/file/cd.lpc
 *
 * Change to another director, or your home, developer!
 *
 * @created 2026-07-15 - Gesslar
 * @last_modified 2026-07-15 - Gesslar
 *
 * @history
 * 2026-07-15 - Gesslar - Created
 */

inherit STD_CMD;

void setup() {
  help_text =
    "Changes your working directory — the directory that the other file "
    "commands resolve relative paths against. The path may be absolute or "
    "relative to where you already are, and with no path at all you are "
    "returned to your own home directory.\n"
    "\n"
    "See also: ls, pwd\n";
}

mixed main(
  /** @type {STD_PLAYER} */ object caller,
  string str
) {
  string path;

  if(!str) {
    path = home_path(caller);
  } else {
    path = resolve_path(caller->query_env("cwd"), str);
  }

  if(!master()->valid_read(path, caller, "cd"))
    return _error("Permission denied.");

  if(!directory_exists(path))
    return _error("No such path: %s", path);

  caller->set_env("cwd", path);

  return _ok("Working directory set to: %s", path);
}
