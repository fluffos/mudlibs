/**
 * @file /cmds/file/tail.lpc
 *
 * Command to print the last 20 lines of a file.
 *
 * @created 2024-08-16 - Gesslar
 * @last_modified 2026-03-23 - Gesslar
 *
 * @history
 * 2024-08-16 - Gesslar - Created
 * 2026-03-23 - Gesslar - Updated to current conventions
 */

inherit STD_CMD;

void setup() {
  usage_text = "tail <file>";
  help_text =
    "This command prints the last 20 lines of a specified file.";
}

mixed main(
  /** @type {STD_PLAYER} */ object caller,
  string str
) {
  if(!str)
    return _usage(caller);

  string file = resolve_file(caller, str);

  if(!file_exists(file))
    return _error(caller, "No such file: %s", file);

  string *out = explode(tail(file, 20), "\n");
  out = ({ "=== " + file + " ===" }) + out;

  caller->set_env("cwf", file);

  return out;
}
