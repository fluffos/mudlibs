/**
 * @file /cmds/object/work.lpc
 *
 * Change work directory to a specific object's or your environment.
 *
 * @created 2026-05-06 - Gesslar
 * @last_modified 2026-07-13 - Gesslar
 *
 * @history
 * 2026-05-06 - Gesslar - Created
 * 2026-07-13 - Gesslar - Added help text
 */

inherit STD_CMD;

void setup() {
  usage_text =
    "work\n"
    "work <object>\n";
  help_text =
    "Sets your working directory to the source directory of an object. With "
    "no argument, it uses the directory of the object you are currently in "
    "(your environment). Given an object, it resolves that object and uses "
    "its source directory instead. This updates the 'cwd' environment value "
    "used by other object commands.";
}

mixed main(
  /** @type {STD_PLAYER} */ object tp,
  string arg
) {
  if(!arg) {
    if(!environment(tp))
      return _error("You have no environment.");

    string cwd = query_directory(environment(tp));
    if(file_size(cwd) != -2)
      return _error("No such directory: %s", cwd);

    tp->set_env("cwd", cwd);

    return _ok("Working directory → %s", cwd);
  }

  object ob = get_object(arg);
  string cwd = query_directory(ob);

  if(file_size(cwd) != -2)
    return _error("No such directory: %s", cwd);

  tp->set_env("cwd", cwd);

  return _ok("Working directory → %s", cwd);
}
