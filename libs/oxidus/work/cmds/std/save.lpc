/**
 * @file /cmds/std/save.lpc
 *
 * Command to (needlessly) save yourself.
 *
 * @created 2026-07-16 - Gesslar
 * @last_modified 2026-07-16 - Gesslar
 *
 * @history
 * 2026-07-16 - Gesslar - Created
 */

inherit STD_CMD;

void setup() {
  help_text =
    "Writes your character and everything you are carrying to disk. This is "
    "rarely necessary — you are saved at the points that matter, quitting "
    "among them — but it costs nothing to be sure.\n"
    "\n"
    "See also: quit\n";
}

mixed main(
  /** @type {STD_PLAYER} */ object caller,
  string _str
) {
  if(caller->save_body())
    return "Saved.";

  return "Could not save your data.";
}
