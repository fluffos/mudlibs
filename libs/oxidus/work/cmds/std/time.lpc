/**
 * @file /cmds/std/time.lpc
 *
 * Command to check the current game time.
 *
 * @created 2024-08-05 - Gesslar
 * @last_modified 2026-07-13 - Gesslar
 *
 * @history
 * 2024-08-05 - Gesslar - Created
 * 2026-07-13 - Gesslar - Added help text
 */

inherit STD_CMD;

void setup() {
  usage_text = "time";
  help_text =
    "Reports the current in-game time as tracked by the time daemon. The "
    "command takes no arguments.";
}

mixed main(object tp, string str) {
  return sprintf("It is now %s.\n", TIME_D->query_full_time());
}
