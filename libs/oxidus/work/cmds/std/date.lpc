/**
 * @file /cmds/std/date.lpc
 *
 * The current server date.
 *
 * @created 2026-07-18 - Gesslar
 * @last_modified 2026-07-18 - Gesslar
 *
 * @history
 * 2026-07-18 - Gesslar - Created
 */

inherit STD_CMD;

void setup() {
  help_text =
    "Reports the current date and time on the server that runs the game. "
    "This is real-world time, not the time of day in the world itself. The "
    "command takes no arguments.\n"
    "\n"
    "See also: time\n";
}

mixed main(
  /** @type {STD_PLAYER} */ object _tp,
  string _str
) {
  return `Server time: ${ldatetime()}`;
}
