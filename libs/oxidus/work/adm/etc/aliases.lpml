// Global aliases, keyed by security group. Each group maps an alias
// name to its expansion. The magic group "all" applies to every user;
// the remaining groups are defined in /adm/etc/groups.
//
// Aliases which end with space ' ' do not require a space during input, but
// the space will be auto-injected to the command system as if it had been
// there all along. *witchcraaaaft*
{
  // Aliases for all users
  all: {
    n: "go north",
    w: "go west",
    e: "go east",
    s: "go south",
    nw: "go northwest",
    ne: "go northeast",
    se: "go southeast",
    sw: "go southwest",
    u: "go up",
    d: "go down",
    l: "look $*",
    exa: "look at $*",
    h: "history $*",
    i: "inventory $*",
    "' ": "say $*",
    ": ": "emote $*",
    "\" ": "tell $*",
    color: "colour $*",
  },

  // Aliases for admins
  admin: {
    makewiz: "makedev $*",
    dewiz: "revdev $*",
    rmdev: "revdev $*",
    mkdev: "makedev $*",
  },

  // Aliases for developers
  developer: {
    link: "ln $*",
    netstat: "sockinfo $*",
    man: "help $*",
  },

  // Aliases for soul writers
  soul: {
    addemote: "edemote 1 $*",
    addsoul: "edemote 1 $*",
    mksoul: "edemote 1 $*",
    delemote: "edemote 2 $*",
    delsoul: "edemote 2 $*",
    rmsoul: "edemote 2 $*",
    rmemote: "edemote 2 $*",
  },
}
