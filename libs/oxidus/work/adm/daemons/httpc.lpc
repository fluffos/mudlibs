/**
 * @file /adm/daemons/httpc.lpc
 * General-purpose HTTP fetch daemon. Wraps the inheritable HTTP client so
 * callers can issue a one-off request without inheriting one themselves, and
 * awaits the response.
 *
 * @created 2024-07-06 - Gesslar
 * @last_modified 2026-08-29 - Gesslar
 *
 * @history
 * 2024-07-06 - Gesslar - Created
 * 2026-08-26 - Gesslar - Stabilised request identities and documented the API.
 * 2026-08-29 - Gesslar - Replaced the callback-and-serial API with an
 *                        awaitable fetch().
 */

inherit STD_HTTP_CLIENT;

void setup() {
  set_log_prefix("(HTTPC)");
  set_log_level(0);
}

/**
 * Performs an HTTP request and delivers the response.
 *
 * The promise is fulfilled with the response for every status the server
 * returned — a 404 is an answer, not a failure — and is rejected only when no
 * response was obtained: an unparseable URL, a failed hostname lookup, a
 * refused connection, or a malformed response. Use `acatch` to observe that.
 *
 * @param {string} method - The HTTP request method.
 * @param {string} url - The absolute request URL.
 * @param {mapping} [headers] - Additional request headers.
 * @param {string} [body] - The optional request body.
 * @returns {mapping} The response, carrying the "status", "headers", and
 *                    "body" keys. Each call site receives a
 *                    `promise<mapping>`.
 * @errors If the method, URL, or headers are invalid.
 * @example
 * mapping response = await HTTPC_D->fetch("GET", url, headers);
 *
 * if(response["status"]["code"] != 200)
 *   return;
 */
varargs public async mapping fetch(string method, string url, mapping headers, string body) {
  mapping server;

  assert_arg(stringp(method), 1, "Invalid method.");
  assert_arg(stringp(url), 2, "Invalid URL.");
  assert_arg(nullp(headers) || mapp(headers), 3, "Invalid headers.");

  _log(2, "Fetching %s", url);

  server = await http_request(url, method, headers, body);

  _log(3, "Fetched %s: %O", url, server["response"]["status"]);

  return server["response"];
}
