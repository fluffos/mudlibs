/**
 * @file /adm/daemons/github_issues.lpc
 *
 * Daemon to handle GitHub issues. Uses the GitHub Issues API to create issues
 * in the mud's GitHub repository.
 *
 * @created 2024-07-07 - Gesslar
 * @last_modified 2026-08-29 - Gesslar
 *
 * @history
 * 2024-07-07 - Gesslar - Created
 * 2026-07-25 - Gesslar - Some tidying and correction.
 * 2026-08-29 - Gesslar - Awaited the API response instead of correlating it
 *                        through the shutdown hook.
 */

#include <daemons.h>

inherit STD_HTTP_CLIENT;

private nomask int is_setup();
private nomask void check_token();
private nomask void process_backlog();
private nomask void process_next(string *files);
private nomask void execute_callback(mapping request, mapping response);
private nomask async void submit_issue(mapping request, string url, mapping headers, string body);
private nomask void save_pending(mapping request);

private nomask nosave int scheduled = 0;
private nosave string pending_dir = "/data/github/issues/pending";

void setup() {
  set_log_level(4);
  set_log_prefix("(GITHUB_ISSUES)");

  assure_dir(pending_dir);

  process_backlog();
}

/**
 * Create a new issue in the GitHub repository.
 *
 * @param {string} type - The type of issue to create
 * @param {string} title - The title of the issue
 * @param {string} body - The body of the issue
 * @param {mixed*} [callback] - The callback function to call when the request
 *  is complete
 * @returns {int | string} 1 if the request was submitted, or an error message
 *  string
 */

varargs mixed create_issue(string type, string title, string body, mixed *callback) {
  mapping config = mud_config("GITHUB_REPORTER");
  mapping request;
  string url;

  if(!stringp(type) || !strlen(type))
    return "Type must be a valid string";

  if(member_array(type, config["types"]) == -1)
    return `Invalid type. Available types: ${implode(config["types"], ", ")}.`;

  if(!stringp(title))
    return "Title must be a string";

  if(!stringp(body))
    return "Body must be a string";

  if(!config["owner"] || !config["repo"] || !config["token"])
    return "GitHub Issues API not setup in adm/etc/config.json";

  url =
    `https://api.github.com/repos/${config["owner"]}/${config["repo"]}/issues`;

  request = ([
    "type" : "create",
    "label" : type,
    "title" : title,
    "body" : body,
    "callback" : callback,
    "caller" : previous_object(),
  ]);

  _log(2, "Request %O", request);

  submit_issue(
    request,
    url,
    ([
      "Authorization": `token ${config["token"]}`,
      "Accept": "application/vnd.github.v3+json",
      "Content-Type": "application/json; charset=utf-8"
    ]),
    json_encode(([
      "title": title,
      "body": `\`\`\`\n${body}\n\`\`\`\n`,
      "labels": ({ type })
    ])),
  );

  return 1;
}

/**
 * Send an issue to the GitHub API and act on what comes back.
 *
 * Anything short of a created issue — a rejected request, or a response that
 * is not a 201 — is written to the pending directory for the backlog to
 * retry later.
 *
 * That includes a request that timed out, which is a deliberate choice rather
 * than an oversight. A timeout means the outcome is *unknown*, not that the
 * request failed: the POST may well have reached GitHub and created the issue
 * before the client gave up on waiting, in which case the retry files it
 * twice. Retrying anyway is still the better trade here — a duplicate issue
 * takes seconds to close, while a report dropped on the assumption that it
 * failed is invisible to everyone. Anything that cannot afford the duplicate
 * needs an idempotency key, which the GitHub issues API does not offer.
 *
 * @param {mapping} request - The issue being submitted
 * @param {string} url - The GitHub issues endpoint
 * @param {mapping} headers - The request headers, including authorisation
 * @param {string} body - The JSON-encoded issue
 */
private nomask async void submit_issue(mapping request, string url, mapping headers, string body) {
  mixed err = acatch {
    mapping server = await http_request(url, "POST", headers, body);
    mapping response = server["response"];
    mapping status = response["status"];

    if(status["code"] != 201) {
      _log(2, "Request error: %d %s\n%O",
        status["code"],
        status["message"],
        response["body"]
      );

      save_pending(request);

      return;
    }

    _log(2, "Content-Type: %O", response["headers"]["content-type"]);

    execute_callback(request, status);
  };

  if(err) {
    // A timeout lands here too, and may have succeeded remotely. See above.
    _log(2, "Failed to submit issue: %O", err);

    save_pending(request);
  }
}

/**
 * Write a request to the pending directory for the backlog to retry.
 *
 * @param {mapping} request - The issue that could not be created
 */
private nomask void save_pending(mapping request) {
  string write_to = `${pending_dir}/${time_ns()}.txt`;

  write_file(write_to, json_encode(request));

  _log(2, "Request saved to %s", write_to);
}

/**
 * Execute the callback function.
 *
 * @param {mapping} request - The request containing the callback function
 * @param {mapping} response - The response from the GitHub API
 */
void execute_callback(mapping request, mapping response) {
  mixed cb = request["callback"];
  string err;

  if(!cb || cb == "RESUBMIT")
    return;

  if(!pointerp(cb)) {
    err = catch(cb = stringp(cb) ?
      assemble_call_back(request["caller"], cb) :
      assemble_call_back(cb));

    if(err) {
      _log(2, "Invalid callback: %O (%O)", cb, err);
      return;
    }
  }

  err = catch(call_back(cb, response));

  if(err)
    _log(2, "Error calling callback: %O", err);
}

/**
 * Process the backlog of requests in the pending directory.
 *
 * Passes a list of files to process_next() to process each request.
 */
private nomask void process_backlog() {
  string *files = get_dir(`${pending_dir}/*.txt`);
  files = map(files, (: `${pending_dir}/${$1}` :));

  if(!sizeof(files))
    return;

  process_next(files);

  if(scheduled && find_call_out(scheduled) <= 0)
    return;

  scheduled = call_out(process_backlog, 60);
}

/**
 * Process the next request in the backlog.
 *
 * @param {string*} files - The list of files remaining in the
 *                          backlog to process
 */
private nomask void process_next(string *files) {
  function schedule_next = (: call_out_walltime("process_next", 5.0, $1) :);

  if(!sizeof(files)) {
    _log(2, "No files to process. Exiting.");

    return;
  }

  string file = shift(ref files);
  _log(2, "Processing file %O", file);

  if(!file_exists(file)) {
    if(sizeof(files) > 1)
      schedule_next(files);
    else
      return;
  }

  mapping request;
  string err = catch(request = load_json(file));
  if(err) {
    _log(2, "Error reading request file %s: %O", file, err);

    if(sizeof(files) > 1)
      schedule_next(files);

    return;
  }

  if(!mapp(request)) {
    _log(2, "Invalid request in %s", file);

    if(sizeof(files) > 1)
      schedule_next(files);

    return;
  }

  _log(2, "Processing request from %s", file);
  _log(2, "Request: %O", request);
  _log(2, "Resubmitting request from %s", file);

  // Do appropriate function based on its type
  err = catch {
    switch(request["type"]) {
      case "create": {
        mixed *new_request = ({
          request["label"],
          request["title"],
          request["body"],
          request["callback"]
        });

        _log(2, "Submitting create issue request: %O", new_request);

        mixed result = create_issue(new_request...);

        _log(2, "Result of submission %O", result);

        break;
      }

      default:
        _log(2, "Invalid request type: %s", request["type"]);
        break;
    }
  };

  if(err) {
    _log(2, "Error sending request: %O", err);
  } else {
    rm(file);

    if(sizeof(files) > 1)
      schedule_next(files);

    _log(2, "Request resubmitted for %s", file);
  }
}
