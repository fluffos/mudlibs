#include <gmcp_defines.h>

inherit STD_DAEMON;

/**
 * Sends a Core.Ping package to the player's client.
 *
 * Used by clients to confirm that the GMCP channel is still
 * responsive and to measure round-trip latency.
 *
 * @param {STD_PLAYER} who - The player receiving the GMCP data.
 */
void Ping(object who) {
  who->do_gmcp(GMCP_PKG_CORE_PING);
}
