/**
 * @file /adm/daemons/modules/gmcp/Comm.lpc
 *
 * GMCP module to handle Comm.* packages.
 *
 * @created 2024-10-10 - Gesslar
 * @last_modified 2026-05-02 - Gesslar
 *
 * @history
 * 2024-10-10 - Gesslar - Created
 * 2026-05-02 - Gesslar - Cleaned up file header
 */

#include <gmcp_defines.h>

inherit STD_DAEMON;

/**
 * Handles outgoing Comm.* GMCP packages and forwards them to the
 * recipient player's GMCP handler.
 *
 * Currently recognises the Text sub-package. For Text, `data` must
 * be a mapping containing at least the `channel` and `text` keys.
 * If `talker` is not present, it defaults to the string "system".
 *
 * @public
 * @param {STD_PLAYER} who - The player receiving the GMCP data.
 * @param {string} sub - The GMCP sub-package name (e.g. "Text").
 * @param {mapping} [data] - Payload for the sub-package; required
 *                           keys depend on `sub` (see description).
 * @errors If `data` does not satisfy the assertion for the Text
 *         sub-package (must be a mapping with `channel` and `text`).
 * @example
 * // Forward a text message to the player's GMCP handler
 * Channel(player, "Text", ([ "channel": "say", "text": "Hi" ]));
 */
varargs void Channel(object who, string sub, mapping data) {
  switch(sub) {
    case "Text": {
      assert((:
            mapp($(data))
        && !nullp($(data)["channel"])
        && !nullp($(data)["text"])
      :));

      if(nullp(data["talker"]))
        data["talker"] = "system";

      who->do_gmcp(GMCP_PKG_COMM_CHANNEL_TEXT, data);
      break;
    }
  }
}
