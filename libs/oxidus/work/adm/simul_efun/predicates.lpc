#include <simul_efun.h>

/**
 * Determine if an object is a room or not.
 *
 * @param {object} ob - The object to test.
 * @returns {1 as STD_ROOM} 1 if the object is a room, otherwise 0.
 */
int roomp(object ob) {
  return objectp(ob) && call_if(ob, "is_room");
}

/**
 * Determine whether the current call originated from the alarm
 * daemon on behalf of a valid object.
 *
 * Intended as a guard inside alarm callbacks: the target object can
 * confirm that it is genuinely being driven by ALARM_D rather than by
 * an arbitrary caller before acting on the alarm.
 *
 * @param {object} ob - The object the alarm pertains to.
 * @returns {1 as ALARM_D} 1 if ob is a valid object and the immediate caller
 *  is the alarm daemon, otherwise 0.
 */
int alarmp(object ob) {
  return objectp(ob) && file_name(ob) == ALARM_D;
}

/**
 * Does duck-type checking to see if the input matches an error format. error()
 * prepends string messages with '*'.
 *
 * @param {mixed} [input] - The value to test.
 * @returns {int} 1 if it looks like an error string, 0 otherwise.
 */
int errorp(mixed input) {
  return stringp(input) && input[0] == '*';

}

/**
 * Determine whether a promise has yet to settle.
 *
 * @param {promise} p - The promise to test.
 * @returns {int} 1 if the promise is still pending, 0 if it has resolved or
 *  rejected.
 */
int pendingp(promise p) {
  return promise_status(p) == PROMISE_IS_PENDING;
}

/**
 * Determine whether a promise has settled with a value.
 *
 * @param {promise} p - The promise to test.
 * @returns {int} 1 if the promise has resolved, 0 if it is still pending or
 *  has rejected.
 */
int resolvedp(promise p) {
  return promise_status(p) == PROMISE_HAS_RESOLVED;
}

/**
 * Determine whether a promise has settled with a rejection reason.
 *
 * @param {promise} p - The promise to test.
 * @returns {int} 1 if the promise has rejected, 0 if it is still pending or
 *  has resolved.
 */
int rejectedp(promise p) {
  return promise_status(p) == PROMISE_HAS_REJECTED;
}

/**
 * Determine whether a promise has settled at all, without distinguishing
 * which way it went. Use resolvedp() or rejectedp() when the outcome
 * matters.
 *
 * @param {promise} p - The promise to test.
 * @returns {int} 1 if the promise has resolved or rejected, 0 if it is still
 *  pending.
 */
int settledp(promise p) {
  return promise_status(p) != PROMISE_IS_PENDING;
}
