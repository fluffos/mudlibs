inherit STD_ROOM;

void setup() {
  set_short("Developer Workroom");
  set_long("This workroom is a place of quiet thinking and contemplation "
    "as the developer works to create the majesty that is the world.");
  set_exits(([
    "square"  : ROOM_START,
    "freezer" : ROOM_FREEZER,
    "void"    : ROOM_VOID,
  ]));

  set_light(1);
  set_no_gmcp_room_info(1);
}
