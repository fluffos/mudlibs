inherit STD_NPC;

private mixed learn(object tp, string str);
private mixed unlearn(object tp, string str);

private mixed learn_arcane(object tp);
private mixed unlearn_arcane(object tp);

void setup() {
  set_short("Madame Brille, a wizened old gnome");
  set_name("Madame Brille");
  set_id(({"madame brille","Madame Brille","brille","arcanist","gnome"}));
  set_adj(({"wizened", "old"}));
  set_race("gnome");
  set_gender("female");
  set_long(@text

Madame Brille offers the following services:

  Learn the arcane: learn arcane
Unlearn the arcane: unlearn arcane

text);

  add_command("learn", learn);
  add_command("unlearn", unlearn);
}

private mixed learn(object tp, string str) {
  if(!pcp(tp))
    return 0;

  if(str == "arcane")
    return learn_arcane(tp);
  
  return "Learn what?";
}

private mixed unlearn(object tp, string str) {
  if(!pcp(tp))
    return 0;

  if(str == "arcane")
    return unlearn_arcane(tp);

  return "Unlearn what?";
}

private mixed learn_arcane(/** @type {STD_PLAYER} */ object tp) {
  if(tp->has_path("/cmds/spell/arcanist/"))
    return "You are already familiar with the arcane.";

  tp->add_path("/cmds/spell/arcanist");

  return "You learn about the arcane and gain access to their spell library.";
}

private mixed unlearn_arcane(/** @type {STD_PLAYER} */ object tp) {
  if(!tp->has_path("/cmds/spell/arcanist/"))
    return "You don't know anything about the arcane.";

  tp->rem_path("/cmds/spell/arcanist");

  return "A haze briefly fills your mind before clearing.";
}
