inherit STD_ROOM;

void setup() {
  set_light(0);
  set_terrain("road");
}

void virtual_setup(mixed args...) {
  string file = args[0];

  set_zone("twisty_maze");
  __DIR__ "maze_daemon"->setup_exits(this_object());
  __DIR__ "maze_daemon"->setup_short(this_object(), file);
  __DIR__ "maze_daemon"->setup_long(this_object());
}
