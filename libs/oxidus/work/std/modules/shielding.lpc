/**
 * @file /std/modules/shielding.lpc
 *
 * Shielding module for livings.
 *
 * @created 2026-07-30 - Gesslar
 * @last_modified 2026-07-30 - Gesslar
 *
 * @history
 * 2026-07-30 - Gesslar - Created
 */

inherit STD_MODULE_BASE;

private nosave mapping __config = ([]);

void base_setup() {
  module_name = query_file_name();
}

/**
 *
 * @param c
 */
int start_module(mapping c) {
  // shielding needs a few things in order to be valid
  assert(stringp(c.name) && truthy(c.name), "Missing shielding name");
  assert(stringp(c.short) && truthy(c.short), "Missing shielding short");

  __config = copy(c);

  /** @type {STD_BODY} */ (owner)->simple_action(
    `${c.colour}$N $vis surrounded by a bright glow.{{res}}`
  );

  return 1;
}

void stop_module() {
  tell(
    owner,
    `${__config.colour}Your brightly glowing shielding dissipates.{{res}}\n`
  );
}

public int shielded() {
  return 1;
}

public int shield_name() {
  return __config.name;
}

public string shield_short() {
  return __config.short ?? "";
}

public string shield_colour() {
  return __config.colour ?? "";
}

public float mitigation_percent() {
  return __config.mitigation_percent ?? 0.0;
}

public float health() {
  return __config.health ?? 0.0;
}

public float max_health() {
  return __config.max_health ?? 0.0;
}

private float adjust_health(float health) {
  if(health > health()) {
    health = -health();
  } else {
    health = -health;
  }

  if(health() + health > max_health()) {
    health = max_health() - health();
  }

  __config.health += health;

  return health;
}

float mitigate_damage(float damage, string _type) {
  float diff = percent_of(mitigation_percent(), damage);
  float new_diff = adjust_health(diff);

  if(health() <= 0.0) {
    defer((:
      /** @type {STD_OBJECT} */ (owner)->remove_module_instance(this_object())
    :));
  } else {
    string mitigate_message =
      `${shield_colour()}Your ${shield_name()} absorbs some of the damage.{{res}}\n`;

    tell(owner, mitigate_message);
  }

  return -new_diff;
}

public int allows_multi() {
  return 1;
}
