inherit __DIR__ "race";

void setup() {
  __regen_rate += ([
    "hp" : 6.0,
    "sp" : 1.0,
    "mp" : 1.0,
  ]);

  __attribute_mod += ([
    "strength": 3,
    "constitution": 2,
    "dexterity": -1,
    "intelligence": -2,
    "charisma": -2,
  ]);
}

int set_up_body_parts(object _ob, mixed _args...) {
  return use_default_body_parts();
}
