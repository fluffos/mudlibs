inherit __DIR__ "race";

void setup() {
  __regen_rate += ([
    "hp" : 3.0,
    "sp" : 2.0,
    "mp" : 1.0,
  ]);

  __attribute_mod += ([
    "strength": 2,
    "constitution": 1,
    "intelligence": -1,
    "charisma": -1,
  ]);
}

int set_up_body_parts(object _ob, mixed _args...) {
  return use_default_body_parts();
}
