/**
 * @file /std/daemon/http_server.lpc
 * Inheritable HTTP server with socket lifecycle management, incremental
 * request framing, optional TLS and deflate support, and response generation.
 *
 * An inheriting server answers requests by defining `http_handle_request(fd,
 * client)`, which may be `async`: a handler that awaits a database query or an
 * outbound request before calling `send_http_response()` is dispatched exactly
 * like a synchronous one, and its rejection is answered with a 500. A request
 * still has `REQUEST_TIMEOUT` seconds to be answered, however long the handler
 * suspends for.
 *
 * @created 2024-07-05 - Gesslar
 * @last_modified 2026-08-29 - Gesslar
 *
 * @history
 * 2024-07-05 - Gesslar - Created
 * 2026-08-26 - Gesslar - Hardened connection handling and documented the API.
 * 2026-08-29 - Gesslar - Allowed asynchronous request handlers.
 */

#include <socket.h>
#include <socket_err.h>
#include <http.h>
#include <daemons.h>

inherit STD_DAEMON;
inherit EXT_HTTP;

#define MAX_REQUEST_BYTES 1048576
#define REQUEST_TIMEOUT 30

// Prototypes
protected nomask void send_http_response(int fd, mapping client);
protected nomask void close_client_connection(int fd);
protected nomask void close_all_client_connections();
protected nomask void socket_shutdown(int fd);
private nomask void remove_client(int fd);
private nomask void handle_request_failure(int fd, int id, mixed err);

// Variables
private nomask nosave int LISTEN_PORT = 8080;
private nomask nosave mapping clients = ([ ]);
private nomask nosave int client_serial;
private nomask nosave mapping standard_headers = ([]);

void mudlib_setup() {
  standard_headers = ([
    "Server": "Oxidus (FluffOS)",
    "Connection": "close",
    "Date" : (: http_time_string :),
    "Content-Length": (: http_content_length :),
  ]);

  set_log_prefix("(HTTP SERVER)");
}

/**
 * Sets the TCP port on which the server listens.
 *
 * @param {int} port - A port from 1 through 65535.
 * @returns {int} The configured port, or 0 when the value is invalid.
 */
protected nomask int set_listen_port(int port) {
  if(port < 1 || port > 65535)
    return 0;

  LISTEN_PORT = port;

  return LISTEN_PORT;
}

/**
 * Queries the TCP port on which the server listens.
 *
 * @returns {int} The configured listen port.
 */
protected nomask int query_listen_port() {
  return LISTEN_PORT;
}

/**
 * Creates, binds, and starts the HTTP listening socket.
 */
protected nomask void start_server() {
  int fd;

  fd = socket_create(get_option("tls")
    ? STREAM_TLS_BINARY
    : STREAM_BINARY, "socket_read", "socket_closed"
  );

  if(fd < 0) {
    _log(0, "Unable to create socket: %s", socket_error(fd));
    return;
  }

  if(get_option("tls")) {
    socket_set_option(fd, SO_TLS_CERT, mud_config("TLS_CERT"));
    socket_set_option(fd, SO_TLS_KEY, mud_config("TLS_KEY"));
  }

  int bind_status = socket_bind(fd, LISTEN_PORT);
  if(bind_status != EESUCCESS) {
    _log(0, "Unable to bind to port %d: %s", LISTEN_PORT, socket_error(bind_status));
    socket_close(fd);
    return;
  }

  int listen_status = socket_listen(fd, "on_socket_listen");
  if(listen_status != EESUCCESS) {
    _log(0, "Unable to listen on socket: %s", socket_error(listen_status));
    socket_close(fd);
    return;
  }

  _log(1, "Listening on port %d", LISTEN_PORT);
}

/**
 * Accepts an incoming client connection from the listening socket.
 *
 * @param {int} fd - The listening socket descriptor.
 */
protected nomask void on_socket_listen(int fd) {
  int client_fd;
  mapping client;
  string client_address;
  string client_host;
  int client_port;

  client_fd = socket_accept(fd, "socket_read", "socket_ready");
  if(client_fd < 0) {
    _log(0, "Error accepting client: %s", socket_error(client_fd));
    return;
  }
  _log(2, "Incoming connection on socket %d", client_fd);

  client_address = socket_address(client_fd);
  sscanf(client_address, "%s %d", client_host, client_port);

  client = ([
    "id": ++client_serial,
    "host": client_host,
    "port": client_port,
    "time": time_frac(),
    "http" : ([
        "request": ([ ]),
        "response": ([ ]),
    ]),
    "timeout": call_out("socket_shutdown", REQUEST_TIMEOUT, client_fd),
  ]);

  _log(2, "New connection from %s %d", client_host, client_port);

  clients[client_fd] = client;
}

/**
 * Handles a client socket becoming ready for writes.
 *
 * @param {int} fd - The ready socket descriptor.
 */
void socket_ready(int fd) {
  _log(2, SYSTEM_OK "=> Socket ready: %d{{res}}", fd);
}

/**
 * Closes every active HTTP client connection.
 */
nomask void close_all_client_connections() {
  foreach(int fd, mapping _ in clients)
    close_client_connection(fd);
}

/**
 * Closes an active HTTP client connection.
 *
 * @param {int} fd - The client socket descriptor.
 */
nomask void close_client_connection(int fd) {
  socket_shutdown(fd);
}

/**
 * Removes a client after the peer closes its socket.
 *
 * @param {int} fd - The closed socket descriptor.
 */
protected nomask void socket_closed(int fd) {
  remove_client(fd);
}

/**
 * Closes a client socket and removes its connection state.
 *
 * @param {int} fd - The socket descriptor to close.
 */
protected nomask void socket_shutdown(int fd) {
  mapping client = clients[fd];
  int result;

  if(!client)
    return;

  _log(1, "Shutting down connection: %s %d", client["host"], client["port"]);

  result = socket_close(fd);

  if(result != EESUCCESS)
    _log(0, "Error closing socket: %s", socket_error(result));
  else
    _log(3, "Removing socket: %s %d", client["host"], client["port"]);

  remove_client(fd);
}

/**
 * Removes stored state for a closed client and dispatches the shutdown hook.
 *
 * @param {int} fd - The closed socket descriptor.
 */
private nomask void remove_client(int fd) {
  mapping client = clients[fd];

  if(!client)
    return;

  remove_call_out(client["timeout"]);
  map_delete(clients, fd);
  call_if(this_object(), "http_handle_shutdown", client);
}

/**
 * Accumulates and parses bytes received from an HTTP client.
 *
 * @param {int} fd - The client socket descriptor.
 * @param {buffer} incoming - The newly received bytes.
 */
protected nomask void socket_read(int fd, buffer incoming) {
  string err;
  mapping result;
  mapping client;

  _log(1, "Incoming data on %d: %O", fd, incoming);

  if(!bufferp(incoming))
    return;

  client = clients[fd];

  if(!client) {
    _log(0, "Unknown client: %d", fd);
    return;
  }

  if(sizeof(incoming) + sizeof(client["buffer"] || "") > MAX_REQUEST_BYTES) {
    _log(1, "Request on socket %d exceeded %d bytes", fd, MAX_REQUEST_BYTES);
    client["http"]["request"] = ([ "headers": ([ ]) ]);
    client["http"]["response"] = ([
      "status": HTTP_STATUS_CONTENT_TOO_LARGE,
      "content-type": CONTENT_TYPE_TEXT_PLAIN,
    ]);
    send_http_response(fd, client);
    return;
  }

  if(client["buffer"])
    incoming = client["buffer"] + incoming;

  _log(3, "Received %d buffered bytes", sizeof(incoming));

  err = catch(result = parse_http_request(incoming));

  _log(3, "Result: %O", result);

  if(err || !mapp(result)) {
    _log(2, "Error parsing: %O", err);

    client["http"]["response"] = ([
      "status": HTTP_STATUS_BAD_REQUEST,
      "content-type": CONTENT_TYPE_TEXT_PLAIN,
    ]);

    send_http_response(fd, client);

    return;
  }

  _log(3, "Parsed: %O", result);

  if(result["buffer"]) {
    client["buffer"] = result["buffer"];
    clients[fd] = client;
    return;
  }

  map_delete(client, "buffer");
  clients[fd]["http"]["request"] = result;

  if(function_exists("http_handle_request")) {
    mixed handled;

    err = catch(handled = call_other(this_object(), "http_handle_request", fd, client));
    if(err)
      handle_request_failure(fd, client["id"], err);
    else if(promisep(handled))
      promise_catch(handled, (: handle_request_failure, fd, client["id"] :));
  } else {
    client["http"]["response"] = ([
      "status": HTTP_STATUS_NOT_IMPLEMENTED,
      "content-type": CONTENT_TYPE_TEXT_PLAIN,
    ]);

    send_http_response(fd, client);
  }
}

/**
 * Answers a client whose request handler failed.
 *
 * A synchronous handler's error arrives from the catch around the dispatch; an
 * asynchronous one's arrives later, as the rejection of the promise it
 * returned. Either way the client is owed a 500 — unless the handler already
 * answered it before failing, or the request timed out while the handler was
 * suspended, in which case the connection is gone and there is nothing left to
 * answer.
 *
 * The connection is identified by its serial rather than by its descriptor
 * alone, because a rejection that arrives after the connection ended finds a
 * descriptor the driver may already have handed to somebody else.
 *
 * @param {int} fd - The client socket descriptor.
 * @param {int} id - The serial of the connection being answered.
 * @param {mixed} err - The error or rejection reason.
 */
private nomask void handle_request_failure(int fd, int id, mixed err) {
  mapping client = clients[fd];

  _log(0, "Request handler failed: %O", err);

  if(!client || client["id"] != id)
    return;

  client["http"]["response"] = ([
    "status": HTTP_STATUS_INTERNAL_SERVER_ERROR,
    "content-type": CONTENT_TYPE_TEXT_PLAIN,
  ]);

  send_http_response(fd, client);
}

/**
 * Builds and writes an HTTP response for a client.
 *
 * Standard headers and Content-Length are generated automatically. The body
 * is optionally deflated when both peers enable that encoding.
 *
 * An asynchronous handler can outlive the connection it was answering — its
 * client may have disconnected, or the request timed out, while it was
 * suspended. The descriptor is then free for the driver to hand to somebody
 * else, so the connection's serial is checked before anything is written:
 * dropping a late response is a great deal better than delivering it to
 * whoever holds that descriptor now.
 *
 * @param {int} fd - The client socket descriptor.
 * @param {mapping} client - The client request and response state.
 */
protected nomask void send_http_response(int fd, mapping client) {
  string response = "";
  mapping headers = copy(standard_headers);
  mapping current;
  mixed body;
  string status, content_type;
  int result;

  if(fd < 0 || !client || !client["http"]["response"]["status"] ||
     !client["http"]["response"]["content-type"])
    return;

  current = clients[fd];
  if(!current || current["id"] != client["id"]) {
    _log(1, "Discarding a response for a connection that has gone: %d", fd);

    return;
  }

  body = client["http"]["response"]["body"];
  status = client["http"]["response"]["status"];

  if(body) {
    if(client["http"]["request"]["headers"]["accept-encoding"]) {
      string *accepts = client["http"]["request"]["headers"]["accept-encoding"];
      if(member_array("deflate", accepts) > -1 && get_option("deflate")) {
        headers["Content-Encoding"] = "deflate";
        body = compress(body);
        client["http"]["response"]["body"] = body;
      }
    }
  }

  _log(3, "Sending body: %O", body);

  if(!body) {
    switch(status) {
      case HTTP_STATUS_OK:
      case HTTP_STATUS_CREATED:
      case HTTP_STATUS_ACCEPTED:
      case HTTP_STATUS_NO_CONTENT:
      case HTTP_STATUS_MOVED_PERMANENTLY:
      case HTTP_STATUS_FOUND:
      case HTTP_STATUS_NOT_MODIFIED:
      case HTTP_STATUS_BAD_REQUEST:
      case HTTP_STATUS_UNAUTHORIZED:
      case HTTP_STATUS_FORBIDDEN:
      case HTTP_STATUS_NOT_FOUND:
      case HTTP_STATUS_METHOD_NOT_ALLOWED:
      case HTTP_STATUS_CONTENT_TOO_LARGE:
      case HTTP_STATUS_INTERNAL_SERVER_ERROR:
      case HTTP_STATUS_NOT_IMPLEMENTED:
      case HTTP_STATUS_BAD_GATEWAY:
      case HTTP_STATUS_SERVICE_UNAVAILABLE:
        sscanf(status, "%*d %s", body);
        break;
      default: body = status; break;
    }
  }

  content_type = client["http"]["response"]["content-type"];

  // Build the HTTP response
  headers += ([
    "Content-Type": content_type,
  ]);

  foreach(string header, mixed value in headers) {
    mixed val;

    if(valid_function(value)) {
      function f = value;
      val = f(client);
    } else
      val = value;

    switch(typeof(val)) {
      case T_STRING:
        val = val;
        break;
      case T_INT:
        val = sprintf("%d", val);
        break;
      case T_FLOAT:
        val = sprintf("%f", val);
        break;
      default:
        throw(sprintf("Invalid type for header value: %O", val));
        break;
    }

    response += sprintf("%s: %s\r\n", header, val);
  }

  response += "\r\n"; // End of headers

  response = sprintf("HTTP/1.1 %s\r\n%s", status, response);

  // Send the response
  if(bufferp(body))  {
    result = socket_write(fd, response);
    if(result != EESUCCESS) {
      _log(0, "Error writing response: %s", socket_error(result));
      socket_shutdown(fd);
      return;
    }
    _log(2, "Headers sent");
    result = socket_write(fd, body);
    if(result != EESUCCESS) {
      _log(0, "Error writing response: %s", socket_error(result));
      socket_shutdown(fd);
      return;
    }
    _log(2, "Body sent");
  } else {
    response += body;
    result = socket_write(fd, response);
    if(result != EESUCCESS) {
      _log(0, "Error writing response: %s", socket_error(result));
      socket_shutdown(fd);
      return;
    }
    _log(2, "Response sent");
  }

  // Properly close the connection
  mixed connection = client["http"]["request"]["headers"]["connection"];

  if(pointerp(connection) && member_array("close", connection) > -1) {
    _log(2, "Closing connection per client's request (%s %d)", client["host"], client["port"]);
    socket_shutdown(fd);
  } else if(get_option("close") || lower_case(headers["Connection"]) == "close") {
    _log(2, "Closing connection per server's request");
    socket_shutdown(fd);
  }
}
