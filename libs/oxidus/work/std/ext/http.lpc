/**
 * @file /std/ext/http.lpc
 * Shared HTTP parsing, encoding, response-cache, and protocol utility
 * functions.
 *
 * Four objects inherit this, and a change here reaches all of them:
 * STD_HTTP_CLIENT, STD_HTTP_SERVER, STD_WS_CLIENT — whose handshake is an
 * HTTP response, parsed by parse_response_status() and parse_headers() —
 * and DB_D, which uses parse_query() alone.
 *
 * Message framing is done in **buffer space**. find_marker() reports a byte
 * offset, while an LPC string counts a CRLF as a single character, so an
 * offset applied to a decoded string drifts by one position per CRLF that
 * precedes it. Locate a boundary in the buffer, slice the buffer, and decode
 * only the piece you need.
 *
 * @created 2024-07-05 - Gesslar
 * @last_modified 2026-08-29 - Gesslar
 *
 * @history
 * 2024-07-05 - Gesslar - Created
 * 2024-12-07 - Gesslar - Refactor HTTP module: Improve logging and buffer
 *                        handling in cache response and read cache functions.
 *                        Added integrity check for cached responses and
 *                        enhanced error handling for JSON decoding. Cleaned
 *                        up code for better readability.
 * 2026-08-26 - Gesslar - Hardened protocol framing and documented the API.
 * 2026-08-29 - Gesslar - Kept status-line and header framing in buffer space,
 *                        where find_marker() offsets are meaningful.
 */

inherit EXT_LOG;

#include <daemons.h>
#include <localtime.h>
#include <http.h>

protected nomask string url_encode(string str);
protected nomask string url_decode(string str);

protected nomask buffer to_binary(string str);
protected nomask string to_string(buffer buf);

protected nomask varargs int find_marker(mixed buf, mixed marker);
protected nomask varargs int bufsrch(buffer buf, mixed str);
protected nomask void cache_response(string file, mixed response);
protected nomask buffer read_cache(string file);
protected nomask void set_option(string key, mixed value);
protected nomask mixed get_option(string key);

nomask mapping parse_http_request(buffer buf);
nomask mapping parse_http_response(mixed str);
nomask mapping parse_http_request_line(string str);
nomask mapping parse_headers(mixed str, int keep_remainder);
nomask mixed parse_body(mixed body, string content_type);
nomask mapping parse_route(string str);
nomask mapping parse_query(string str);
nomask mapping parse_url(string str);

private nomask nosave mapping options = ([]);

/**
 * Parses a complete HTTP request from a binary receive buffer.
 *
 * Incomplete messages return their original buffer for later accumulation.
 * Unsupported transfer encoding and malformed framing return 0.
 *
 * @param {buffer} buf - The accumulated request bytes.
 * @returns {mapping | 0} The parsed request, an incomplete-buffer mapping,
 *                        or 0 for a malformed request.
 */
protected nomask mapping parse_http_request(buffer buf) {
  int header_end = find_marker(buf, "\r\n\r\n");

  if(header_end == -1)
    return ([ "buffer": buf ]);

  string head = to_string(buf[0..header_end-1]);
  buffer body_buffer = buf[header_end+4..];
  string *lines = explode(head, "\r\n");

  if(!sizeof(lines))
    return 0;

  string request_line = shift(ref lines);
  string header_block = implode(lines, "\r\n") + (sizeof(lines) ? "\r\n" : "");
  mapping request = parse_http_request_line(request_line);
  if(!request)
    return 0;

  mapping headers = parse_headers(header_block, 0);
  if(!headers || headers["transfer-encoding"])
    return 0;

  int content_length = headers["content-length"] || 0;

  if(content_length < 0)
    return 0;

  if(sizeof(body_buffer) < content_length)
    return ([ "buffer": buf ]);

  if(sizeof(body_buffer) > content_length)
    body_buffer = body_buffer[0..content_length-1];

  string body = to_string(body_buffer);

  return ([
    "request": request,
    "route": parse_route(request["path"]),
    "headers": headers,
    "body": parse_body(body, headers["content-type"]),
  ]);
}

/**
 * Parses HTTP response headers and a body from a response message.
 *
 * The status line is parsed separately, by parse_response_status(); what
 * arrives here is everything after it.
 *
 * @param {string | buffer} str - The response bytes after the status line.
 * @returns {mapping | 0} The parsed response, or 0 when framing is absent
 *                        or invalid.
 */
protected nomask mapping parse_http_response(mixed str) {
  mapping result = ([]);
  buffer buf;
  buffer body;
  string header;
  int header_end;

  // Buffer space, for the reason given in parse_response_status(): a
  // find_marker() offset counts bytes, while a decoded string counts CRLF as
  // one character.
  buf = stringp(str) ? to_binary(str) : str;

  header_end = find_marker(buf, "\r\n\r\n");
  if(header_end == -1)
    return 0;

  header = to_string(buf[0..header_end+1]);
  body = buf[header_end+4..];

  _log(1, "header: %s", header);

  result["headers"] = parse_headers(header, 0);
  if(!result["headers"])
    return 0;

  result["body"] = parse_body(body, result["headers"]["content-type"]);
  if(!result["body"])
    return 0;

  return result;
}

/**
 * Parses an HTTP request line into its method, path, and version.
 *
 * @param {string} request_line - The request line without its line ending.
 * @returns {mapping | 0} The parsed request-line fields, or 0 if invalid.
 */
protected nomask mapping parse_http_request_line(string request_line) {
  string *parts;
  mapping result = ([]);

  // Define the regex pattern for matching the HTTP method, path, and version
  string pattern = "^(GET|POST|PUT|DELETE|OPTIONS|HEAD|PATCH|TRACE|CONNECT)\\s+([^\\s]+)\\s+HTTP/(\\d\\.\\d)$";

  // Extract the method, path, and version using regex
  parts = pcre_extract(request_line, pattern);

  // Ensure parts were extracted correctly
  if(sizeof(parts) == 3) {
    result["method"] = parts[0];
    result["path"] = parts[1];
    result["version"] = parts[2];
  } else
    return 0;

  return result;
}

/**
 * Separates a request target into its route and decoded query mapping.
 *
 * @param {string} route - The HTTP request target.
 * @returns {mapping} The route path and query parameters.
 * @throws If the request target is not a valid origin-form route.
 */
protected nomask mapping parse_route(string route) {
  mapping result = ([]);
  string *parts;

  // Define the regex pattern for matching the path and optional query
  string pattern = "^(/[^?]*)(?:\\?(.*))?$";

  // Extract the path and query using regex
  parts = pcre_extract(route, pattern);

  // Ensure parts were extracted correctly
  if(sizeof(parts) >= 1) { // parts[0] is the path, parts[1] is the query if present
    result["route"] = parts[0];
    if(sizeof(parts) == 2) {
      mapping query = parse_query(parts[1]);
      result["query"] = query;
    } else
      result["query"] = "";
  } else
    throw("Bad query.");

  return result;
}

/**
 * Parses an HTTP response status line.
 *
 * @param {string | buffer} str - The accumulated response bytes or text.
 * @param {int} [keep_remainder=0] - Whether to include bytes following the
 *                                   status line.
 * @returns {mapping | 0} The status fields, or 0 while incomplete or
 *                        invalid.
 */
protected nomask mapping parse_response_status(mixed str, int keep_remainder: (: 0 :)) {
  buffer buf;
  string line;
  string message;
  mapping result = ([]);
  int line_end;
  int code;

  // Frame in buffer space. find_marker() reports a byte offset, while a
  // string counts CRLF as a single character, so slicing the decoded string
  // at that offset drifts by one position per CRLF that precedes it.
  buf = stringp(str) ? to_binary(str) : str;

  line_end = find_marker(buf, "\r\n");
  if(line_end == -1)
    return 0;

  line = to_string(buf[0..line_end-1]);
  if(sscanf(line, "HTTP/%*s %d %s", code, message) != 3 &&
     sscanf(line, "HTTP/%*s %d", code) != 2)
    return 0;

  if(code < 100 || code > 999)
    return 0;

  result["code"] = code;
  result["message"] = message || "";

  if(keep_remainder)
    result["buffer"] = buf[line_end+2..];

  return result;
}

/**
 * Parses HTTP header fields into a lower-case-keyed mapping.
 *
 * Content-Length is converted to an integer. Connection and Accept-Encoding
 * values are returned as lower-case token arrays.
 *
 * @param {string | buffer} str - The header bytes or text.
 * @param {int} keep_remainder - Whether to require the header terminator and
 *                               retain following bytes.
 * @returns {mapping | 0} The parsed headers, or 0 if invalid or incomplete.
 */
protected nomask mapping parse_headers(mixed str, int keep_remainder) {
  mapping headers = ([]);
  buffer remainder;
  string block;

  // Frame in buffer space, for the reason given in parse_response_status():
  // find_marker() offsets are bytes, and a decoded string counts CRLF as one
  // character. Only the header block itself is decoded, and only once the
  // terminator has been located.
  if(keep_remainder) {
    buffer buf = stringp(str) ? to_binary(str) : str;
    int header_end = find_marker(buf, "\r\n\r\n");

    if(header_end == -1)
      return 0;

    remainder = buf[header_end+4..];
    block = to_string(buf[0..header_end+1]);
  } else
    block = bufferp(str) ? to_string(str) : str;

  foreach(string line in explode(block, "\r\n")) {
    int separator;

    if(line == "")
      continue;

    separator = strsrch(line, ":");
    if(separator < 1)
      return 0;

    string header_name = lower_case(trim(line[0..separator-1]));
    string header_value = trim(line[separator+1..]);

    if(header_name == "content-length" && pcre_match(header_value, "^\\d+$")) {
      int length = to_int(header_value);

      if(!nullp(headers[header_name]) && headers[header_name] != length)
        return 0;

      headers[header_name] = length;
    }
    else {
      switch(header_name) {
      case "connection":
      case "accept-encoding":
        headers[header_name] = map(
          explode(header_value, ","),
          (: lower_case(trim($1)) :),
        );
        break;
      default:
        headers[header_name] = header_value;
        break;
      }
    }
  }

  if(keep_remainder)
    headers["buffer"] = remainder;

  return headers;
}

/**
 * Parses an ampersand-separated query or form payload.
 *
 * @param {string} str - The encoded parameter string.
 * @returns {mapping} The decoded parameter names and values.
 */
protected nomask mapping parse_query(string str) {
  mapping payload = ([]);
  string *args;

  args = explode(str, "&");

  if(sizeof(args)) {
    foreach(string arg in args) {
      int separator = strsrch(arg, "=");

      if(separator == -1)
        payload[url_decode(arg)] = "";
      else
        payload[url_decode(arg[0..separator-1])] = url_decode(arg[separator+1..]);
    }
  }

  return payload;
}

/**
 * Parses an HTTP entity body according to its media type.
 *
 * JSON and URL-encoded form bodies are decoded. Unknown media types remain
 * strings, and invalid JSON falls back to the original body.
 *
 * @param {string | buffer} body - The entity body.
 * @param {string | 0} content_type - The Content-Type header value, or 0 to
 *                                    auto-detect JSON objects.
 * @returns {mixed} The decoded payload or original body string.
 */
protected nomask mixed parse_body(mixed body, string content_type) {
  mixed payload;
  string type;
  string *encoding_matches;
  string err;

  _log(2, "Beginning parse_body");

  if(nullp(body) || body == "")
    return "";

  if(bufferp(body))
    body = to_string(body);

  if(!content_type)
    content_type = "auto";

  _log(2, "Content-Type: %s", content_type);

  if(!sizeof(encoding_matches = pcre_extract(content_type, "([^;]+)(?:;\\s*charset=(.*))?"))) {
    _log(2, "Failed to extract encoding from content-type: %s", content_type);
    return body;
  }

  type = encoding_matches[0];
  _log(2, "Parsing body of type %s", type);
  switch(type) {
    case CONTENT_TYPE_APPLICATION_JSON:
      err = catch(payload = json_decode(body));
      if(err) {
        _log(1, "Failed to decode JSON payload: %O", err);
        payload = body;
      } else
        _log(3, "Decoded JSON payload: %O", payload);
      break;
    case CONTENT_TYPE_APPLICATION_FORM_URLENCODED: {
      // Decode URL-encoded form data
      string *args;
      args = explode(body, "&");
      if(sizeof(args)) {
        payload = ([]);
        foreach(string arg in args) {
          int separator = strsrch(arg, "=");

          if(separator == -1)
            payload[url_decode(arg)] = "";
          else
            payload[url_decode(arg[0..separator-1])] = url_decode(arg[separator+1..]);
        }
      }
      _log(3, "Decoded form data: %O", payload);
      break;
    }
    case "auto" : {
      string *matches;

      if(sizeof(matches = pcre_extract(body, "^\\s*(\\{[\\s\\S]*\\})\\s*$"))) {
        body = matches[0];
        err = catch(payload = json_decode(body));
        if(err) {
          _log(2, "Failed to decode JSON payload: %O", err);
          payload = body;
        } else
          _log(3, "Decoded JSON payload: %O", payload);
      } else {
        payload = body;
        _log(3, "Parsed text body: %s", payload);
      }
      break;
    }
    default:
      // Just send it back
      _log(3, "Unknown content type: %s", type);
      payload = body;
      break;
  }

  _log(2, "Sizeof payload: %d", sizeof(payload));

  return payload;
}

/**
 * Percent-encodes a string as UTF-8 for use in a URL component.
 *
 * @param {string} str - The text to encode.
 * @returns {string} The percent-encoded text.
 */
protected nomask string url_encode(string str) {
  string allowed = "-_.~";
  string result = "";
  buffer bytes = to_binary(str);
  int sz = sizeof(bytes);

  for(int i = 0; i < sz; i++) {
    string character = sprintf("%c", bytes[i]);

    if(pcre_match(character, "^[a-zA-Z0-9" + allowed + "]$") == 0)
      result += sprintf("%%%02X", bytes[i]);
    else
      result += character;
  }

  return result;
}

/**
 * Decodes percent escapes and form-style plus signs in a URL component.
 *
 * @param {string} str - The encoded URL component.
 * @returns {string} The decoded text.
 */
protected nomask string url_decode(string str) {
  mixed *arrs;
  string *parts;
  int *matches;
  int sz, i;

  str = replace_string(str, "+", " ");

  // Use pcre_assoc to find percent-encoded sequences
  arrs = pcre_assoc(str, ({ "%[A-Fa-f0-9]{2}" }), ({ 1 }));

  parts = arrs[0];
  matches = arrs[1];

  sz = sizeof(parts);
  for(i = 0; i < sz; i++) {
    if(matches[i] == 1) {
      int char;
      sscanf(parts[i], "%%%x", char);
      parts[i] = sprintf("%c", char);
    }
  }

  return implode(parts, "");
}

/**
 * Parses an HTTP or WebSocket URL into connection fields.
 *
 * @param {string} str - The absolute URL to parse.
 * @returns {mapping | 0} The protocol, security, host, port, and path, or
 *                        0 if the URL or port is invalid.
 */
protected nomask mapping parse_url(string str) {
  string protocol, host, path;
  int port, secure;
  string *matches, port_string;
  mapping result = ([]);

  // Use regex to parse the URL and determine the protoco
  matches = pcre_extract(str, "^(http|ws)(s?)://([^:/]+):?(\\d+)?(/.*)?$");
  if(!sizeof(matches))
    return 0;

  protocol = matches[0];
  secure = matches[1] == "s";
  host = matches[2];
  if(sizeof(matches) >= 4)
    port_string = matches[3];
  if(sizeof(matches) >= 5)
    path = matches[4];

  if(!strlen(port_string))
    port = secure ? 443 : 80;
  else
    port = to_int(port_string);

  if(port < 1 || port > 65535)
    return 0;

  result = ([
    "protocol" : protocol + (secure ? "s" : ""),
    "secure" : secure,
    "host" : host,
    "port" : port,
    "path" : path || "/",
  ]);

  return result;
}

/**
 * Finds a byte marker in a string or buffer.
 *
 * @param {string | buffer} buf - The value to search.
 * @param {string} marker - The marker to locate.
 * @returns {int} The marker offset, or -1 when absent.
 * @errors If the searched value is neither a string nor a buffer.
 */
protected nomask varargs int find_marker(mixed buf, string marker) {
  string type = typeof(buf);

  if(stringp(buf))
    buf = to_binary(buf);

  if(bufferp(buf))
    return bufsrch(buf, to_binary(marker));

  error("Invalid buffer type: " + type);
}

/**
 * Finds a string or buffer subsequence in a buffer.
 *
 * @param {buffer} buf - The buffer to search.
 * @param {string | buffer} str - The subsequence to locate.
 * @returns {int} The subsequence offset, or -1 when absent.
 */
protected nomask varargs int bufsrch(buffer buf, mixed str) {
  int buf_sz;
  int sub_buf_sz;
  mixed sub_buf;
  int start;

  buf_sz = sizeof(buf);
  if(stringp(str))
    sub_buf = to_binary(str);
  else
    sub_buf = str;

  sub_buf_sz = sizeof(sub_buf);
  start = 0;

  if(sub_buf_sz > buf_sz || start < 0)
    return -1;

  for(int i = start; i <= buf_sz - sub_buf_sz; i++) {
    int match = 1;
    for(int j = 0; j < sub_buf_sz; j++) {
      if(buf[i+j] != sub_buf[j]) {
        match = 0;
        break;
      }
    }
    if(match)
      return i;
  }

  return -1;
}

/**
 * Formats a buffer as space-separated hexadecimal bytes.
 *
 * @param {buffer} buf - The binary data to format.
 * @returns {string} The hexadecimal representation.
 */
protected nomask string binary_to_hex(buffer buf) {
  string hex = "";
  int len = sizeof(buf);

  _log(4, "Buffer = %O", buf);

  for(int i = 0; i < len; i++)
    hex += sprintf("0x%02x ", buf[i]);

  // Remove the trailing and space
  if(len > 0)
    hex = trim(hex);

  _log(3, "Converted %d bytes to hex", sizeof(buf));
  return hex;
}

/**
 * Converts an even-length hexadecimal string to binary data.
 *
 * @param {string} hex - The hexadecimal digits to convert.
 * @returns {buffer} The converted binary data.
 */
protected nomask buffer hex_to_binary(string hex) {
  buffer binary = allocate_buffer(strlen(hex) / 2);
  int byte;

  for(int i = 0; i < strlen(hex); i += 2) {
    sscanf(hex[i..i+1], "%x", byte);
    binary[i / 2] = byte;
  }

  return binary;
}

/**
 * Appends response bytes to a temporary cache file.
 *
 * @param {string} file - The cache file path.
 * @param {buffer} response - The response bytes to append.
 */
protected nomask void cache_response(string file, buffer response) {
  int fs = file_size(file); // Current file size
  int sz, result;
  int start = fs > 0 ? fs : 0; // Start at the end of the file if it exists, otherwise at 0

  _log(3, "Writing to cache file: " + file);
  _log(3, "Filename " + file + " exists (size: %d): %s", fs, (fs > 0 ? "true" : "false"));

  // Ensure the response is a buffer
  if(!bufferp(response)) {
    _log(4, "Response is not a buffer: %O", response);
    return;
  }

  sz = sizeof(response);

  // Write the buffer to the file
  result = write_buffer(file, start, response);
  if(result != sz) {
    _log(4, "Failed to write entire buffer to file: %s (expected %d bytes, wrote %d bytes)", file, sz, result);
    return;
  }

  _log(3, "Wrote %d bytes to file: %s, new file size: %d", sz, file, file_size(file));
}

/**
 * Compares cached bytes with an in-memory response buffer.
 *
 * @param {string} file - The cache file path.
 * @param {buffer} response - The response bytes to compare.
 * @returns {int} 1 when sizes and bytes match, otherwise 0.
 */
private nomask int integrity_check(string file, buffer response) {
  buffer cached_content = (buffer)read_buffer(file, 0, file_size(file));
  if(sizeof(cached_content) != sizeof(response)) {
    _log(4, "Mismatch detected: Cached file size: %d, Response size: %d", sizeof(cached_content), sizeof(response));
    return 0;
  }

  for(int i = 0; i < min(({ sizeof(cached_content), sizeof(response) })); i++) {
    if(cached_content[i] != response[i]) {
      _log(4, "Discrepancy at byte %d: Cached file: %02x, Response: %02x", i, cached_content[i], response[i]);
      break;
    }
  }

  return 1;
}

/**
 * Reads a complete cached response into a buffer.
 *
 * An empty cache file is a legitimate empty entity body and yields a
 * zero-length buffer, which is truthy. Only a genuine failure to read the
 * body returns 0, so a caller distinguishes the two with a plain truth test.
 *
 * @param {string} file - The cache file path.
 * @returns {buffer} The cached bytes, a zero-length buffer when the file is
 *                   empty, or 0 when the file is absent or is larger than the
 *                   driver string limit.
 */
protected nomask buffer read_cache(string file) {
  int chunk_size = (int)get_config(__MAX_BYTE_TRANSFER__);
  int max = (int)get_config(__MAX_STRING_LENGTH__);
  buffer total;
  string tail;

  int curr = 0;
  int sz = file_size(file);
  int bytes_to_read;

  if(sz == -1) {
    _log(2, "Cache file does not exist: %s", file);

    return 0;
  } else if(sz == 0) {
    _log(2, "Cache file is empty: %s", file);

    return allocate_buffer(0);
  }

  tail = tail(file, 5);
  _log(3, "Tail of file (5 lines): %O", tail);

  if(sz > max) {
    _log(0, "Cache file %s is %d bytes, over the %d byte limit", file, sz, max);

    return 0;
  }

  total = allocate_buffer(sz);

  while(curr < sz) {
    bytes_to_read = min(({sz - curr, chunk_size}));

    buffer buf = (buffer)read_buffer(file, curr, bytes_to_read);
    if(!buf) // Exit loop if read_bytes fails
      break;

    _log(4, "Read buffer: %s", to_string(buf));

    write_buffer(total, curr, buf);
    _log(4, "Accumulated response: %s", to_string(total));
    curr += sizeof(buf);
  }

  _log(3, "Last 10 bytes of response: %O", identify(total[<10..]));

  _log(3, "File size: %d", sz);
  _log(3, "Bytes read: %d", sizeof(total));
  _log(3, "Integrity check: %d", integrity_check(file, total));
  return total;
}

/**
 * Formats the current time as an HTTP-date in GMT.
 *
 * @returns {string} The RFC-style HTTP date string.
 */
protected nomask string http_time_string() {
  int now = time();
  mixed *lt = localtime(now);
  int off = lt[LT_GMTOFF];

  now += off + (-1 * lt[LT_ISDST]) * 3600;
  return strftime("%a, %d %b %Y %H:%M:%S GMT", now);
}

/**
 * Calculates the byte length of a pending HTTP response body.
 *
 * @param {mapping} client - The server-side client state mapping.
 * @returns {int} The body length, 0 without a body, or -1 for an unsupported
 *                body type.
 */
protected nomask int http_content_length(mapping client) {
  mixed body;
  buffer buf;

  body = client["http"]["response"]["body"];

  if(!body)
    return 0;

  if(stringp(body))
    buf = to_binary(body);
  else if(bufferp(body))
    buf = body;

  if(!bufferp(buf))
    return -1;

  return sizeof(buf);
}

/**
 * Sets a shared HTTP stack option.
 *
 * @param {string} key - The option name.
 * @param {mixed} value - The option value.
 */
protected nomask void set_option(string key, mixed value) {
  _log(3, "Setting option %s to %O", key, value);

  options[key] = value;
}

/**
 * Queries a shared HTTP stack option.
 *
 * @param {string} key - The option name.
 * @returns {mixed} The option value, or undefined when unset.
 */
protected nomask mixed get_option(string key) {
  return options[key];
}

/**
 * Encodes a string as a UTF-8 buffer.
 *
 * @param {string} str - The string to encode.
 * @returns {buffer} The UTF-8 bytes.
 */
protected nomask buffer to_binary(string str) { return string_encode(str, "UTF-8"); }

/**
 * Decodes a UTF-8 buffer into a string.
 *
 * @param {buffer} buf - The UTF-8 bytes.
 * @returns {string} The decoded string.
 */
protected nomask string to_string(buffer buf) { return string_decode(buf, "UTF-8"); }
