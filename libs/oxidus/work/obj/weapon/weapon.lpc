/**
 * @file /obj/weapon/weapon.lpc
 *
 * Base weapon inheritable for virtual weapon items
 *
 * @created 2026-07-21 - Gesslar
 * @last_modified 2026-07-21 - Gesslar
 *
 * @history
 * 2026-07-21 - Gesslar - Created
 */

inherit STD_WEAPON;
inherit STD_VIRTUAL_OBJECT;

varargs void virtual_setup(mapping data) {
  data.mass && set_mass(data.mass);
  data.value && set_value(data.value);
  data.hands && set_hands(data.hands);
  data.dc && set_dc(data.dc);
  data.type && set_damage_type(data.type);
  data.speed && set_speed_mod(data.speed);
}
