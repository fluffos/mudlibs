@@ -26,6 +26,22 @@ private nosave nomask int lpcshell = 0;
 
 /* Functions */
 
+// The collection's shared driver build has PACKAGE_UIDS compiled in, which
+// requires both applies below on the master object or the driver exit(-1)s
+// at boot. Upstream Oxidus has no euid/uid privilege model (wizard/admin
+// ranks live in adm/obj/master/security.lpc); these are trivial fixed stubs
+// for the shared driver only.
+string get_root_uid() { return "ROOT"; }
+string get_bb_uid() { return "BACKBONE"; }
+string creator_file(string file) { return "BACKBONE"; }
+// It also has the mudlib_stats package, which asks for the author of the
+// master file and the domain of "/" once at boot and prints a warning on
+// every boot when these two are missing; ROOT and BACKBONE are the values
+// it used without them.
+string author_file(string file) { return get_root_uid(); }
+string domain_file(string file) { return get_bb_uid(); }
+
