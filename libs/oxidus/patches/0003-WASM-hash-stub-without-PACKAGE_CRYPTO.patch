diff --git a/adm/simul_efun/hash.lpc b/adm/simul_efun/hash.lpc
new file mode 100644
index 00000000..bc6529cb
--- /dev/null
+++ b/adm/simul_efun/hash.lpc
@@ -0,0 +1,13 @@
+#include <simul_efun.h>
+
+// hash() is a PACKAGE_CRYPTO efun. The collection's shared WASM driver
+// ships without crypto, and std/room/room.lpc calls hash("md4", ...)
+// from gmcp_room_info() -- that fails the whole room base class at
+// compile time, so every start location is unloadable. Only compile
+// this stub when the real efun is absent, so native builds keep using
+// efun::hash() unchanged.
+#ifndef __PACKAGE_CRYPTO__
+string hash(string algo, string data) {
+  return data || "";
+}
+#endif
