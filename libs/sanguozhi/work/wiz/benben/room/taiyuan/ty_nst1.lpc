#include <mudlib.h>
#include "/wiz/fire/fire.h"
#include <ansi.h>
inherit OUTDOOR_ROOM;
void setup(){
    set_area("ty_area");
    set_light(50);
    set_brief(""+YEL+"北大街"+NOR+"");
    set_long("    描述。\n");
    set_exits( ([
        "east" :  __DIR__+"ty_tshf.lpc",
        "west" :  __DIR__+"ty_yunyu.lpc",
        "south" : __DIR__+"ty_center.lpc",
        "north" : __DIR__+"ty_nst2.lpc"
    ]) );
}
