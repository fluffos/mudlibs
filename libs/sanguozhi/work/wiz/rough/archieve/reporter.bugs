作者: Lark
题目: Bug报告地点：/sgdomain/area/guan/huayin/vhall...
日期: Wed Dec  9 21:34:24 1998
int do_qu(string arg)
{
int x
string from
object book1
object book2
object book3
if( sscanf(arg, %s from %s, arg, from)==2 
&& arg==book
 && from==shelf
 && !query(nobook)){
message_vision($N从书架上拿下一本书.\n,this_player())
switch(x) {
case 0: book1->move(this_player())
break
case 1: book2->move(this_player())
break
case 2: book3->move(this_player())
break
}
set(nobook,1)
return 1
}
}




