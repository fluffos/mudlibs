// marry_servant.c "喜仆"
#include <mudlib.h>
#include <ansi.h>
inherit LIVING;
inherit M_ACTIONS;
inherit M_TRIGGERS;
inherit M_WANDER;
void receive_outside_msg(string str){
    receive_outside_msga(str);
}
void receive_private_msg(string str) {
    receive_outside_msga(str);
}
string *query_channel_list() {
    return ({ "plyr_gossip" });
}
object jia;
void setup() 
{
    add_id("xi pu","喜仆","pu");
    set_gender(1);
    set_proper_name("喜仆");
    set_in_room_desc("良缘堂  喜仆(xi pu)");
    set_long("一个喜气洋洋，满脸红光的喜仆。\n");
    jia=new("/sgdomain/obj/cloth/torso/changpao.lpc");
    jia->move(this_object());
    jia->do_wear();
    set_sg_rongmao(25);
 add_pattern("%s走了%s",function(string left, string right){
                 
                respond("say 恭喜，恭喜！");
});

}

