//青羽魔剑 
//by junhyun@SK 

#include <weapon.h>
//  inherit F_UNIQUE; 

inherit BLADE;
#include <ansi.h>
void create() {
  set_name(MAG "紫血狂刀" NOR, ({ "zixue blade", "blade", "dao" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一柄通体紫色的宝刀\n");
    set("unit", "柄");
    set("value", 12000);
    set("wield_msg", MAG "$N手中升起一团紫气，慢慢化作一柄宝刀！\n" NOR);
    set("unwield_msg", MAG "$N手中的宝刀化作一团紫气消失了。\n");
    set("no_sell", "你大脑有问题吧？这东西你都敢卖？\n");
    set("no_drop", "去垃圾堆丢吧，乱扔会污染环境!\n");

    set("weapon_prop/courage", 20);
  }
  init_blade(120);
  setup();
}
mixed hit_ob(object me, object victim) {
  int damage_bonus = 0;

  if ((string)me->query("family/family_name") == "轩辕古墓"
    && me->query_skill("zizhi-blade", 1) > 1)
    damage_bonus = me->query_skill("zizhi-blade", 1);
  damage_bonus = (damage_bonus + random(damage_bonus)) / 2;

  victim->receive_wound("kee", damage_bonus);
  return MAG "紫血" + NOR + HIW "狂刀" + NOR + MAG "上闪出一团紫气！\n" NOR;

}
