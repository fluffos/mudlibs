inherit ROOM;
#include <ansi.h>

void create ()
{
        set ("short", "破庙");
        set ("long", @LONG
这是一座破旧不堪的小庙宇,地上零星的撒落着一些大大
小小的香炉,看得出曾几何起这里也是香火鼎沸,可是那都是
昔日的事了.
LONG);

        //set("item_desc", ([" *** " : " *** ", ]));

        set("exits", 
        ([ //sizeof() == 4
       "east" : "/d/calvin/tianpeng/luw3",    
        ]));

        set("objects", 
        ([ //sizeof() == 1
       "/d/calvin/armor/jiezhi" : 1,
       "/d/calvin/armor/shenpao" : 1,
       "/d/calvin/armor/tianjia" : 1,
       "/d/calvin/armor/kui" : 1,
       "/d/calvin/armor/xue" : 1,
       "/d/calvin/armor/pifeng" : 1,
       "/d/calvin/armor/wan" : 1,
       "/d/calvin/armor/zhua" : 1,
       "/d/calvin/obj/rjl" : 1,
       "/d/calvin/obj/yjl" : 1,
        ]));

        set("no_clean_up", 0);
        set("sleep_room",1);
        set("if_bed",1);                             
        set("no_time", 1);
        set("no_flee", 1);
        set("alternative_die", 1);
        set("no_quit", 1);
        set("freeze", 1);
//        set("no_fight", 1);
        set("chat_room", 1);
//        set("no_magic", 1);
        set("no_upgrade_age", 1);
        set("valid_startroom", 1);
        set("freeze", 1);
        setup();
        replace_program(ROOM);
}

void init()
{       
        object me=this_player();
        if( query("done") ) return;
        if( interactive(me)) {
                remove_call_out("greeting");
                call_out("greeting",25, me);
        }
}

int greeting(object me)
{
        object *list, ob;
        int i;
        if( !me || environment(me) != this_object() ) return 1;
        tell_room(this_object(), "一阵黑色旋风吹过,你情不自禁地闭上了眼睛………\n");

        list=all_inventory(this_object());
        i=sizeof(list);
        while (i--)
        {
                ob=list[i];
                ob->move("/d/milin/qy/sc");
                message_vision("风顷刻间停住了,可是$N却到了另一个世界………\n", ob);
        }
        this_object()->set("done");
        call_out("reg", 300);
        return 1;
}
int reg()
{
        this_object()->delete("done");
        return 1;
}
