    // Item: /d/wizz/mudring/obj/ring.c

#include <ansi.h>
#include <armor.h>
inherit F_AUTOLOAD;

inherit FINGER;

void create()
{
        set_name(HIC "水晶钻戒" NOR, ({ "wedding ring", "ring" }) );
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "只");
                set("value", 100000);
            set("no_sell", "这你也要卖？不如把你自己卖了！"); 
                set("material", "gold");
                set("armor_type", "married");
                set("armor_prop/armor",0);
                set("no_give","这个也给人？");
                set("no_drop",1);
        }
        setup();
}

int query_autoload()
{
        return 1;
}

void init()
{
        object ob = this_player();

        if (environment() == ob) {
                if (ob->query("gender") == "女性") {
                        set_name(HIY "水晶钻戒" NOR, ({ "wedding ring", "ring" }) );
                        set("unit", "只");
                        set("material", "jade");
                }
                if ( (!ob->query("couple/id") || !ob->query("couple/name")) && ob->query("id")!="newtest" ) {
                        ob->delete("married");
                        call_out("lost", 1);
                        return;
                }
                set("long", "这是你"
                        + (ob->query("gender") == "女性"?"相公":"娘子")
                        + "送给你的定情信物，上面"
// 50                          + (ob->query("gender") == "女性"?"刻":"绣")
                        + "刻着一行小字：「"
                        + (ob->query("gender") == "女性"?"海枯石烂 ":"此心不变 ")
                        + ob->query("couple/name") + "」。\n");
                wear();
        }
}

void lost()
{
        object ob = environment();

        if (userp(ob))
                tell_object(ob, HIB "\n你隐约觉得有一样很重要的东西丢失了！\n\n" NOR);
        destruct(this_object());
}

int unequip()
{
        object ob = environment();

        if (userp(ob) && ob->query("couple/id") && ob->query("couple/name"))
                return notify_fail("你不能卸下你的定情信物。\n");

        return ::unequip();
}

