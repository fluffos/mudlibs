       set_skill("dodge", 366);
       set_skill("dragonfight", 200);
       set_skill("dragonforce", 180);
       set_skill("fengbo-cha", 364);
       set_skill("force", 362);
       set_skill("fork", 367);
       set_skill("literate", 200);
       set_skill("lotusforce", 354);
