inherit NPC;
inherit F_MASTER;
string expell_me(object me);


void create()
{
       set_name("家将", ({"jia jiang","jia","jiang","jiajiang"}));

        set("long","天蓬府的家将,是天蓬府弟子的启蒙老师．\n");
       set("gender", "男性");
       set("age", 30);
        set("int", 25);
       set("title", "天蓬元帅府");
       set("attitude", "peaceful");
       set("combat_exp", 700000);
       set("daoxing", 700000);
       set("class","tianpeng");
       set("per", 30);
  set_skill("force", 100);
  set_skill("dodge", 100);
  set_skill("parry", 100);
       set("max_kee", 1200);
       set("max_sen", 1200);
       set("force", 3000);
       set("max_force", 1500);
       set("force_factor", 40);
       set("max_mana", 1500);
       set("mana", 3000);
       set("mana_factor", 30);
//       map_skill("spells", "seashentong");
               set("inquiry", ([
                "下山": (: expell_me :),
                "leave": (: expell_me :),
]) );

  create_family("天蓬元帅府", 4, "弟子");

  setup();
  carry_object("/d/qujing/kusong/obj/tongjia")->wear();


}

void attempt_apprentice(object ob)
{       ob=this_player();

        if( (string)ob->query("family/family_name") == "天蓬元帅府") {
                command("say 大家同门中人，不敢当，不敢当！\n");
                return;
        }
             command("haha");
             command("recruit " + ob->query("id"));              
                       return ;
}

int recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) ) {
                ob->set("class", "tianpeng");
                ob->set("title", "天蓬元帅府第五代弟子");
        }
}

string expell_me(object me)
{       me=this_player();
        if((string)me->query("family/family_name")=="天蓬元帅府") {
                me->set_temp("tianpeng_betray", 2);
                return ("按我门规，却须受罚，你可愿意(agree)?");
        }
}
void init()
{
::init();
        add_action("do_agree", "agree");
}

int do_agree(string arg)
{
        if(this_player()->query_temp("tianpeng_betray") > 1 ) {
                message_vision("$N答道：弟子愿意。\n\n", this_player());
                this_player()->add("betray/count", 1);
                this_player()->add("betray/tianpeng", 1);
                    this_player()->set("combat_exp", this_player()->query("combat_exp")*95/100);
                if( this_player()->query_skill("tianheforce") )
                  this_player()->delete_skill("tianheforce");
                if( this_player()->query_skill("baguazhou") )
                  this_player()->delete_skill("baguazhou");
                this_player()->delete("family");
                this_player()->delete("class");
                this_player()->delete_temp("tianpeng_betray");
                this_player()->set("title", "普通百姓");
                this_player()->save();
                command("say 那你去吧！\n");
                return 1;
                }
        return 0;
}
