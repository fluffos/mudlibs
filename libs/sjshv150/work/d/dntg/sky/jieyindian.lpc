#include <room.h>
#include <ansi.h>
inherit ROOM;

void init();
void close_gate();
int do_knock(string);
int valid_leave();
string look_gate();
int do_sheng();

void create ()
{
         set ("short", "接引殿");
        set ("long", @LONG

进了南天门，已经可以看到一座座天宫放着七彩霞光，忽隐忽现
于云遮雾绕之中。里壁厢有几根大柱，柱上缠绕着金鳞耀日赤须
龙；一座白玉桥弯弯曲曲地向北延伸，东西两边各有一座大殿，
也不知是干什么用的，你可以隐约听到东边殿中有喧哗之声，似
乎人不少。
LONG);

         set("exits", ([ /* sizeof() == 3 */
                "south" : __DIR__"nantian",
                "north" : __DIR__"caihongqiao",
                "west" : __DIR__"caifengdian",
                "east" : __DIR__"jinlongdian",
        ]));

        create_door("south", "南天门", "north", DOOR_CLOSED);
        set("no_clean_up", 0);
        setup();
}

void init()
{
        add_action("do_drop", "drop");
        add_action("do_sheng", "sheng");
}

int do_sheng()
{
         object me,mouse,eagle,pig;
        string s;
        int my_exp,my_level,temp,price,price2,afford;

        me = this_player();
        mouse = present("soil mouse",me);
        eagle = present("gold eagle",me);
        pig = present("fire pig",me);
        my_exp=me->query("combat_exp");
        my_level=me->query("level");
        temp=(my_level+1)*(my_level+1)*1000;
//        if (my_exp < 1000000 || me->query("daoxing") <1000000){ 
//                tell_object(me,"你的武学和道行不够100万，暂时不能升级！\n"); return 1;
//        }
        if (mouse){
                if (me->query("mouse/use_number") >= 3){
                        if(random(2)==1){
                                message_vision(HIW"天空中一颗流星滑过。"+mouse->query("name")+"突然说道：主人，世间又有灾难降生了，我要去寻找新的需要帮助的人，有缘再见吧。\n"NOR,me);
                                message_vision("刚说完，"+mouse->query("name")+"就一阵风似的消失了。\n",me);        
                                destruct(mouse);
                                me->delete("mouse");
                                me->add_temp("apply/attack",-me->query_temp("apply/attack")*20/100);
                                me->add_temp("apply/armor",-me->query_temp("apply/armor")*30/100);
                        }
                }
        }
        if (eagle){
                if (me->query("eagle/use_number") >= 3){
                        if(random(2)==1){
                                message_vision(HIW"天空中一颗流星滑过。"+eagle->query("name")+"突然说道：主人，世间又有灾难降生了，我要去寻找新的需要帮助的人，有缘再见吧。\n"NOR,me);
                                message_vision("刚说完，"+eagle->query("name")+"就一阵风似的消失了。\n",me);        
                                destruct(eagle);
                                me->delete("eagle");
                                me->add_temp("apply/attack",-me->query_temp("apply/attack")*20/100);
                                me->add_temp("apply/armor",-me->query_temp("apply/armor")*30/100);
                        }
                }
        }
        if (pig){
                if (me->query("pig/use_number") >= 3){
                        if(random(2)==1){
                                message_vision(HIW"天空中一颗流星滑过。"+pig->query("name")+"突然说道：主人，世间又有灾难降生了，我要去寻找新的需要帮助的人，有缘再见吧。\n"NOR,me);
                                message_vision("刚说完，"+pig->query("name")+"就一阵风似的消失了。\n",me);        
                                destruct(pig);
                                me->delete("pig");
                                me->add_temp("apply/attack",-me->query_temp("apply/attack")*20/100);
                                me->add_temp("apply/armor",-me->query_temp("apply/armor")*30/100);
                        }
                }
        }
        if(my_exp>=temp){
                if (my_level<100)  price=10000*(my_level+1);              
                if (my_level>=100)  price=40000*(my_level+2);              
                price2=price/12;
                if(me->query("balance") >= price ) {
                        if(present("gold eagle",me) && me->query("eagle/use_number")<3){
                                me->add("balance",-(price*50/100+random(price*40/100)));
                                me->add("eagle/use_number",1);
                        }
                        else{
                                me->add("balance",-price);
                        }
                        if(me->query("daoxing")- price >500000){
                                if(present("soil mouse",me) && me->query("mouse/use_number")<3){
                                        me->add("daoxing",-(price2*50/100+random(price2*40/100)));
                                        me->add("mouse/use_number",1);
                                }
                                else{
                                        me->add("daoxing",-price2);
                                }
                                if(present("fire pig",me) && me->query("pig/use_number")<3){
                                        me->add("combat_exp",-(price2*50/100+random(price2*40/100)));
                                        me->add("pig/use_number",1);
                                }
                                else{
                                        me->add("combat_exp",-price2);
                                }
                        }
                                temp=me->query("scorepoint")+(my_level/10+100)*100;
                                me->set("level",my_level+1);
                                me->set("scorepoint",temp);
                                me->set("kee",me->query("max_kee"));
                                me->set("mana",me->query("max_mana"));
                                me->set("morality",me->query("level")/2);
                                message_vision("$N闭目静静的想着什么，突然人显得神采奕奕起来！\n", me);
                                printf(HIW "你的级别得到了提升，你的道德增加了。\n" NOR);
                }
                else{
                        printf(HIW"你没有足够的钱为三界捐助，升级到" HIY "%d" HIW "级的捐助费为" HIM "%d" HIW "金！\n "NOR,my_level+1,price/10000);
                }
        }
        else
                printf(HIW "你的武学不够升级成" HIY "%d" HIW "级，需要你的武学达到" HIM "%d" HIW "才行！\n" NOR,my_level+1,temp);
        return 1;
}

int do_drop()
{
         object me;
        me=this_player();
        tell_object(me,"鬼鬼祟祟的想干什么!\n");
        return 1;
}
