
inherit NPC;
inherit F_MASTER;
#include <ansi.h>
void create()
{
       set_name("渡劫金刚", ({"dujie jingang", "dujie", "jingang","master"}));
       set("long",
"\n他是佛祖如来身边的一位专管人间疾苦渡劫难的金刚，听说此人刚正不阿，性情耿直。\n");
       set("title", HIY"渡去世间疾苦的"NOR);
       set("gender", "男性");
       set("age", 30);
       set("class", "xian");
       set("attitude", "friendly");
       set("rank_info/respect", "神仙");
       set("per", 30);
        set("int", 30);
       set("max_kee", 500);
       set("max_gin", 500);
       set("max_sen", 500);
       set("force", 500);
       set("max_force", 500);
       set("force_factor", 20);
       set("max_mana", 300);
       set("mana", 300);
       set("mana_factor", 20);
       set("combat_exp", 200000);
       set("daoxing", 100000);


        set("eff_dx", 70000);
        set("nkgain", 260);

       set_skill("literate", 220);
       set_skill("unarmed", 220);
       set_skill("dodge", 220);
       set_skill("force", 220);
       set_skill("parry", 220);
       set_skill("sword", 220);
       set_skill("spells", 220);
        set_skill("buduolunhui-dafa", 220);
        set_skill("jitian-zhang", 240);
        set_skill("huxiaolunhui-force", 220);
        set_skill("jiutianhuangquan-sword", 240);
        set_skill("beidou-steps", 240);
        
        map_skill("spells", "buduolunhui-dafa");
        map_skill("unarmed", "jitian-zhang");
        map_skill("force", "huxiaolunhui-force");
        map_skill("sword", "jiutianhuangquan-sword");
        map_skill("parry", "jiutianhuangquan-sword");
        map_skill("dodge", "beidou-steps");

create_family("轮回涧", 18, "弟子");
setup();

        carry_object("/d/obj/cloth/monkcloth")->wear();
}

void attempt_apprentice(object ob)
{
//        if ( !((string)ob->query("gender")=="女性")){
        if ( ob->query("lunhui/lunhui") != 1){
           command("ah");
           command("say 施主心还存有杂念，无法看破红尘，渡劫难于万万终生，" +
RANK_D->query_respect(ob) + "还是另请高就吧。\n");
           return;
        }

        command("pat "+ob->query("id"));
        command("say 好，希望" + RANK_D->query_respect(ob) +
"多加努力，但是我门不喜与人争斗，切记切记！\n");
        command("recruit " + ob->query("id") );
        return;
}

int recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "lunhui");
}
