// 七绝披风 by Calvin
//last by koker
#include <ansi.h>
#include <armor.h>

inherit SURCOAT;
int do_wear(string arg);
void create()
{
  set_name(HIC"七绝披风"NOR, ({"qijue pifeng", "pifeng"}));
  set_weight(3000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "相传这件亮色的披风是精华台出的第一件宝物。\n");
    set("material", "leather");
    set("unit", "件");
                set("value", 2000);
                set("armor_prop/armor", 50);
                set("armor_prop/spells", 20);
                set ("armor_prop/force", 20);
                set("armor_prop/parry", 50);
  }
  setup();
}

int init()
{
        add_action("do_wear","wear");
        return 1;
}

int do_wear (string arg)
{
   object me = this_player();
   object pf = this_object();
//  string name = pf->query("name");
  
if( (int)me->query("level")< 50 )
return notify_fail("你等级不够无法穿戴它。\n");
return 0;
}
