#include <ansi.h>
inherit NPC;
inherit F_MASTER;

string *list1=({
        "yaxe","yblade","yfork","yhammer","ymace","yspear","ystaff","ystick","ysword","ywhip",
});

string *list2=({
        "axe","blade","fork","hammer","mace","spear","staff","stick","sword","whip",
});

string *list3=({
        "yarmor","yboots","ycloth","yhands","yhead","yneck","yring","yshield","ysurcoat","ywaist","ywrists",
});

string *list4=({
        "armor","boots","cloth","hands","head","neck","ring","shield","surcoat","waist","wrists",
});

void create()
{
        set_name(HIY"宝库魔龙"NOR, ({"baoku molong", "long", "molong"}));
        set("title", HIW"守卫"NOR);
        set("gender", "男性" );
        set("taskguai",1);
        set("age", 45);
        set("per", 30);
        set("str", 30);
        set("long","一条守卫着密林宝库的千年魔龙。\n");
        set("attitude", "aggressive");

        set("combat_exp", 100000000);
        set("daoxing", 100000000);

        set_skill("literate", 300);
        set_skill("unarmed", 600);
        set_skill("force", 600);
        set_skill("lengquan-force", 600);
        set_skill("dengxian-dafa", 600);
        set_skill("gouhunshu", 600);
        set_skill("bawang-qiang", 600);
        set_skill("jinglei-mace",600);
        set_skill("mace",600);
        set_skill("axe", 600);
        set_skill("dodge", 600);
        set_skill("parry", 600);
        set_skill("sanban-axe", 600);
        set_skill("bawang-qiang", 600);
        set_skill("spells", 600);
        set_skill("baguazhou", 600);
        set_skill("spear", 600);
        set_skill("yanxing-steps", 600);
        map_skill("force", "lengquan-force");
        map_skill("spells", "gouhunshu");
        map_skill("axe", "sanban-axe");
        map_skill("parry", "sanban-axe");
        map_skill("dodge", "yanxing-steps");
        map_skill("spear", "bawang-qiang");
        map_skill("mace", "jinglei-mace");

        set("max_sen", 10000);
        set("max_kee", 10000);
        set("force", 10000); 
        set("max_force", 10000);
        set("force_factor", 500);
        set("max_mana", 10000);
        set("mana", 10000);
        set("mana_factor", 500);
        set("food",10000);
        set("water",10000);
        create_family("将军府",2 , "弟子");
        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                (: perform_action, "mace","lei" :),
                (: perform_action, "axe.sanban" :),
                (: perform_action, "axe.kai" :),
                (: exert_function, "jingxin" :),
                (: cast_spell, "gouhun" :),
                (: cast_spell, "inferno" :),
        }) );
        set_temp("apply/armor", 500);
        set_temp("apply/dodge", 500);

        setup();
        carry_object("/obj/money/gold");
        carry_object("/d/obj/weapon/mace/goldjian")->wield();
}

void die()
{
        object newob1,newob2,newob3;
        int i,k,l;
        
        if(random(100)>95){
                if( environment() ) 
                        message("vision", "宝库藏龙自知大势已去，灰溜溜的逃走了，匆忙之际不小心丢下了几样东西。\n", environment());
                newob1 = new("/d/quest/zhuangbei/weapon/yweapon/"+list1[random(sizeof(list1))]);                 
                newob2 = new("/d/quest/zhuangbei/armor/yarmor/"+list3[random(sizeof(list3))]); 
                newob3 = new("/d/quest/zhuangbei/armor/"+list4[random(sizeof(list4))]); 
                newob1->move(environment(this_object()));                                               
                newob2->move(environment(this_object())); 
                newob3->move(environment(this_object())); 
                destruct(this_object());
        }       
        else if(random(100)>80){
                if( environment() ) 
                        message("vision", "宝库藏龙自知大势已去，灰溜溜的逃走了，匆忙之际不小心丢下了几样东西。\n", environment());
                newob1 = new("/d/quest/zhuangbei/weapon/yweapon/"+list1[random(sizeof(list1))]);                 
                newob2 = new("/d/quest/zhuangbei/armor/yarmor/"+list3[random(sizeof(list3))]);               
                newob1->move(environment(this_object()));                                               
                newob2->move(environment(this_object())); 
                destruct(this_object());
        }
        else if(random(100)>60){
                if( environment() ) 
                        message("vision", "宝库藏龙自知大势已去，灰溜溜的逃走了，匆忙之际不小心丢下了几样东西。\n", environment());
                newob1 = new("/d/quest/zhuangbei/weapon/"+list2[random(sizeof(list2))]);                 
                newob2 = new("/d/quest/zhuangbei/armor/yarmor/"+list3[random(sizeof(list3))]);  
                newob3 = new("/d/quest/zhuangbei/armor/"+list4[random(sizeof(list4))]);             
                newob1->move(environment(this_object()));                                               
                newob2->move(environment(this_object())); 
                newob3->move(environment(this_object())); 
                destruct(this_object());
        }
        else if(random(100)>20){
                if( environment() ) 
                        message("vision", "宝库藏龙自知大势已去，灰溜溜的逃走了，匆忙之际不小心丢下了几样东西。\n", environment());
                newob1 = new("/d/quest/zhuangbei/weapon/"+list2[random(sizeof(list2))]);                 
                newob2 = new("/d/quest/zhuangbei/armor/"+list4[random(sizeof(list4))]);             
                newob1->move(environment(this_object()));                                               
                newob2->move(environment(this_object())); 
                destruct(this_object());
        }
        else {
                if( environment() ) 
                        message("vision", "宝库藏龙自知大势已去，灰溜溜的逃走了，匆忙之际不小心丢下了几样东西。\n", environment());
                newob1 = new("/d/quest/zhuangbei/weapon/"+list2[random(sizeof(list2))]);                 
                newob2 = new("/d/quest/zhuangbei/armor/yarmor/"+list3[random(sizeof(list3))]);             
                newob1->move(environment(this_object()));                                               
                newob2->move(environment(this_object())); 
                destruct(this_object());
        }
}
