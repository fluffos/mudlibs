#include <ansi.h>
inherit NPC;

void create()
{
        set_name("仆人", ({"pu ren", "waiter"}));
        set("title", "密室");
        set("gender", "男性" );
        set("taskguai",1);
        set("age", 45);
        set("per", 30);
        set("str", 100);
        set("long","他是对这里的主人忠心耿耿的仆人。\n");
        set("attitude", "aggressive");

        set("combat_exp", 100000000);
        set("daoxing", 100000000);

        set_skill("literate", 300);
        set_skill("unarmed", 600);
        set_skill("force", 600);
        set_skill("zixia-shengong", 600);
        set_skill("taoism", 600);       
        set_skill("shushan-jianfa", 600);
        set_skill("yujianshu",600);
        set_skill("mindsword",600);
        set_skill("canxin-jian",600);   
        set_skill("dodge", 600);
        set_skill("parry", 600);        
        set_skill("spells", 600);       
        set_skill("sevensteps", 600);
        map_skill("force", "zixia-shengong");
        map_skill("spells", "taoism");          
        map_skill("parry", "shushan-jianfa");
        map_skill("dodge", "sevensteps");
        map_skill("sword", "shushan-jianfa");
        
        set("max_sen", 10000);
        set("max_kee", 10000);
        set("force", 10000); 
        set("max_force", 10000);
        set("force_factor", 500);
        set("max_mana", 10000);
        set("mana", 10000);
        set("mana_factor", 500);
        set("food",10000);
        set("water",10000);
        create_family("蜀山剑派",2 , "弟子");
        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                (: perform_action, "sword","jianhun" :),
                (: perform_action, "sword","xunlei" :),             
        }) );
        set_temp("apply/armor", 500);
        set_temp("apply/dodge", 500);

        setup();
        add_money("gold", 100); 
        carry_object("/d/obj/weapon/sword/qinghong")->wield();
        carry_object("/d/obj/armor/jinjia")->wear();
}

void init () 
{       
        object me=this_object(); 
        object who=this_player();
                 
        if(!environment(me)->query("wrx")) {
                call_out("destructing",1);
        }         
        if(userp(who)) 
        kill_ob(who); 
        ::init(); 
} 

void destructing() 
{ 
        destruct(this_object()); 
} 

void heart_beat() 
{ 
        object guai = this_object(); 
        if ( !is_fighting() 
        && query("eff_kee") >= query("max_kee") / 2         
        && query("eff_kee") <  query("max_kee") ) { 
                set("eff_kee",query("max_kee")); 
                set("eff_sen",query("max_sen")); 
        } 
        if (query("kee") < query("eff_kee")-10 ) 
            command("exert recover"); 
        if (query("sen") < query("eff_sen")-10) 
            command("exert refresh"); 
        if (query("force") < query("max_force")/10) 
            command("cast transfer"); 
        ::heart_beat(); 
} 

void die()
{
        object me=this_object(); 
        object who=this_player();
        
        who->set("getgold",1);  
}

void unconcious() 
{ 
        die(); 
} 

