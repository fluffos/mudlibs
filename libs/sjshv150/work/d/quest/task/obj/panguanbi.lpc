#include <ansi.h>
inherit ITEM;
#include <task.h>
void create()
{
        set_name("判官笔", ({"panguan bi", "bi"}));
        set_weight(80);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "崔珏勾写生死薄用的。。。。\n");
                set("unit", "个");
                set("owner_name",HIW"崔珏"NOR);
                 set("owner_id","cui jue");
        }
}

