inherit ITEM;
#include <ansi.h>

#include <task.h>
void create() {
  set_name("弹珠", ({ "tan zhu", "zhu" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "女孩玩的弹珠。\n");
    set("unit", "棵");
    set("owner_name", "女孩");
    set("owner_id", "girl");
  }
}
