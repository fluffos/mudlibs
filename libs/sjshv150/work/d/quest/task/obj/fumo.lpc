inherit ITEM;
#include <ansi.h>
#include <task.h>
void create()
{
        set_name(HIR "伏魔刀" NOR, ({"fumodao", "fumo"}));
        set_weight(30);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一把降服妖魔的宝刀。\n");
                set("unit", "把");
                 set("owner_name","宫兵");
               set("owner_id","gong bing");
        }
}


