#include <weapon.h>
inherit AXE;
#include <ansi.h>

void setname() 
{ 
        mapping name;
        name=__DIR__"name"->random_name("axe");
        set_name(HIY+name["name"]+NOR, name["id"]);                       
} 

void create()
{
        setname(); 
        set_weight(11000);
                set("unit", "把");
                set("long", "这是把沉重的大斧，有八尺多长，锋利无比。\n");
                set("value", 10000);
                set("no_drop",1);
                set("material", "gold");
                set("wield_msg", "$N拿出一把$n握在手中，眼前闪过一道寒光！\n");
                set("unwield_msg", "$N放下手中的$n。\n");                
                     set("wield_level", 40+random(200));
                if(random(20)>10)
                        set("weapon_prop/force",10+random(10));
                if(random(10)>6)
                        add("weapon_prop/attack",10+random(10));
                if(random(10)<2)
                        add("weapon_prop/constitution",3);
                if(random(20)>15)
                        set("weapon_prop/spells", 10+random(10));
                if(random(10)>7)
                        add("weapon_prop/parry",10+random(10));
                set("inset_hole",random(3));
        init_axe(100+random(60));
        setup();
}

