//斩龙决
//by junhyun@SK
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

void zhan_ok(object);

int perform(object me, object target)
{
        int damage,damagea;
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展这一招「斩龙决」？\n");
                if(me->query("family/family_name") != "方寸山三星洞")
                return notify_fail("[斩龙决]是方寸不传之密！\n");
                if(!me->is_fighting())
                return notify_fail("「斩龙决」只能在战斗中使用！\n");
                if((int)me->query("max_force") < 300 )
                return notify_fail("你的内力不够！\n");
                if((int)me->query("force") < 300 )
                return notify_fail("你的内力不足！\n");

                if((int)me->query("sen") < 100 )
                return notify_fail("你的精神不足，没法子施用外功！\n");              
                if((int)me->query_skill("liangyi-sword", 1) < 120)
                return notify_fail("你的两仪剑法不够熟练，使用这一招会有困难！\n");
                if((int)me->query_skill("qianjun-bang", 1) < 120)
                return notify_fail("你的千钧棒法不够熟练，使用这一招会有困难！\n");
                if (me->query_skill_mapped("force")!="wuxiangforce")
                return notify_fail("「斩龙决」必须配合小无相功才能使用。\n");

                if(me->query_temp("no_zhan"))
                return notify_fail("你不怕累死啊！\n");
                me->delete("env/brief_message");
                target->delete("env/brief_message");

            damagea=random((int)me->query_skill("dodge"));
if(random((int)target->query("combat_exp")) < (int)me->query("combat_exp"))
{
           message_vision(HIW"\n
$N默运无相神功，手中利剑被内力逼的嗡嗡作响。"+HIR"【斩龙决】\n"NOR,me,target);
              target->receive_damage("kee",damagea);
              target->receive_wound("kee",damagea/2);
              target->receive_damage("sen",damagea/3);
              target->start_busy(2);
              COMBAT_D->report_status(target);
}
else {
           message_vision(HIW"\n\n"NOR,me,target);
             }
           message_vision(HIW"\n
突然$N爆喝一声，手中利刃化作无尽如虹剑气，如同一条狂龙铺天盖地的卷来！\n"NOR,me,target);
                COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

           message_vision(HIB"\n
乱剑狂刃，气动不息，无数剑气幻绞一根巨大的气柱！凝结在$n的头上\n"NOR,me,target);
                COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

                message_vision(HIR"\n
“轰”的一声，气柱带着无数剑气砸了下来！卷起的狂风如浪般盖了过来\n"NOR,me,target);
                COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
               damage=(int)me->query_skill("sword")+random((int)me->query_skill("parry"));
if(random((int)target->query("combat_exp"))<(int)me->query("combat_exp"))
{
              message_vision(HIR"\n
$n躲闪不及，被无数剑气透体而过，惨不忍睹！\n"NOR,me,target);
              target->receive_damage("kee",damage/2);
              target->receive_wound("kee",damage/2);
              COMBAT_D->report_status(target);
}
else {
              message_vision(HIR"\n
$n见势不妙，急忙向一旁跳开，惊险的躲过了着致命的一击！\n"NOR,me,target);
             }
              me->receive_damage("sen", 30);
              me->add("force", -100);
              me->set_temp("no_zhan",1);
              call_out("zhan_ok",2+random(1),me);
              if( !target->is_fighting(me) ) {
              if( living(target) ) {
              if( userp(target) ) target->fight_ob(me);
              else target->kill_ob(me);
}
}
return 1;
}

void zhan_ok(object me)
{
if (!me) return;
      me->delete_temp("no_zhan");
}


