// zouxiao.c  碧箫传情  
#include <combat.h>
#include <ansi.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int damage, ap, ap1, ap2, dp, dp1, dp2, qixue, eff_qi, max_qi, qi_pcg;
  object weapon;
  weapon = me->query_temp("weapon");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁奏箫？\n");
  if (!me->is_fighting(target))
    return notify_fail("大家都很忙，没人有时间听你吹吹打打。\n");
  if (!weapon || weapon->query("music/type") != "xiao")
    return notify_fail("你手里的家伙吹不出调子。\n");
  if (me->query_skill_mapped("force") != "zhenyuan-force")
    return notify_fail("只有用镇元神功才能运力吹箫。\n");
  if ((string)me->query("family/family_name") != "五庄观")
    return notify_fail("你不是五庄观弟子,无灵感!\n");
  if (me->query_skill("xiaofeng-sword", 1) < 150)
    return notify_fail("你的晓风残月剑还得再练练。\n");
  if (me->query_skill("zouxiao", 1) < 150)
    return notify_fail("你奏箫的功夫还不够，再好好练练吧。\n");
  if (me->query_skill("fuqin", 1) < 150)
    return notify_fail("你拂琴的功夫还不够，再好好练练吧。\n");
  if (target->query_skill("literate", 1) < 50)
    return notify_fail("对他吹箫？还不如对牛弹琴呢。\n");
  if ((int)me->query("force") < 400)
    return notify_fail("你的内力还不到火候。\n");
  if ((int)me->query("kee") < 200)
    return notify_fail("你的体力已经不够了！\n");
  if ((int)me->query("sen") < 200)
    return notify_fail("你无法集中精力！\n");
  message_vision(
    HIG "\n$N拿起" + weapon->query("name") + HIG "略微沉思，对着$n奏起了一曲" + HIY "‘潇潇秋雨蝶恋花’" + HIG "，箫声凄凉，\n" NOR,
    me,
    target
  );
  message_vision(HIG "\n\n似叹息，又似哭泣，跟着箫声颤抖，发出瑟瑟断续之音，如一滴滴小雨落上树叶，又如孤蝶恋花。\n" NOR, me, target);
  me->add("sen", -50);
  me->add("kee", -50);
  me->add("force", -150);
  ap1 = (int)me->query_skill("fuqin", 1) + (int)me->query_skill("zouxiao", 1);
  ap2 = ap1 * ap1 * ap1 / 10;
  ap = ap2 + (int)me->query("combat_exp");
  damage = ap1 * ap1 / 1000;
  dp1 = (int)target->query_skill(
    "parry",
    1
  ) + (int)target->query_skill("literate", 1) + (int)target->query_skill("spells", 1);
  dp2 = dp1 * dp1 * dp1 / 100;
  dp = dp2 + (int)target->query("combat_exp");
  if (random(ap) < dp * 1 / 3) {
    message_vision(HIC "\n\n$n冲着你鄙意的冷笑道：就这点本事，也来贻笑大方？\n" NOR, me, target);
    message_vision(HIC "\n$N顿时羞愧难当。\n" NOR, me, target);
    me->start_busy(2 + random(2));
  } else if (random(ap) < dp * 2 / 5) {
    message_vision(HIC "\n\n可$n冲耳不闻，不为所动。\n" NOR, me, target);
    me->start_busy(random(3));
  } else {
    target->receive_wound("sen", damage, me);
    target->receive_damage("sen", damage, me);
    message_vision(HIC "\n\n$n听了箫声，心中莫名其妙的感到一阵酸楚，悲从中来，泪水正涔涔落下。\n" NOR, me, target);
    COMBAT_D->report_status(target);
    target->start_busy(3 + random(5));
    me->start_busy(random(3));
  }
  return 1;
}
