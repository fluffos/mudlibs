// Huxiaolunhui-force  【呼啸轮回神功】
// BY Cigar 2002.04.19 
#include <ansi.h>

inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int valid_learn(object me) { return 1; }

int practice_skill(object me) {
  return notify_fail(CYN "呼啸轮回神功只能向菩萨学习，或是从运用(exert)中增加熟练度。\n" NOR);
}
string exert_function_file(string func) {
  return CLASS_D("lunhui") + "/huxiaolunhui-force/" + func;
}

int stage(int level) {
  if (level < 30) return 1;
  else if (level < 120) return 2;
  else if (level < 180) return 3;
  else if (level < 280) return 4;
  else if (level < 380) return 5;
  else if (level < 480) return 6;
  else if (level < 600) return 7;
  else if (level < 740) return 8;
  else return 9;
}

string level_description(int level) {
  if (stage(level) < 3)
    return BLU "第" + chinese_number(stage(level)) + "度　" NOR;
  else if (stage(level) < 5)
    return HIB "第" + chinese_number(stage(level)) + "度　" NOR;
  else if (stage(level) < 7)
    return YEL "第" + chinese_number(stage(level)) + "度　" NOR;
  else if (stage(level) < 9)
    return CYN "第" + chinese_number(stage(level)) + "度　" NOR;
  else
    return HIW "第" + chinese_number(stage(level)) + "度　" NOR;
}

void skill_improved(object me) {
  int level = (int)me->query_skill("huxiaolunhui-force", 1);
  if (stage(level) == stage(level - 1) + 1) {
    if ((int)me->query("lunhui/lh-force_bonus") < stage(level)) {
      me->set("lunhui/lh-force_bonus", stage(level));
      me->set("max_force", (int)me->query("max_force") + stage(level) * 100);
      me->set("maximum_force",
        (int)me->query("maximum_force")
        +stage(level) * 100);
      me->save();
      log_file("lunhui/huxiaolunhui-force-bonus", ctime(time()) + ": "
        +me->query("name") + "(" + me->query("id") + ")"
        + " got neili " + (stage(level) * 50) + ".\n");
      message_vision(
        HIW "$N突然感觉脑中空空，忽然檀中穴真气四散开来，$N的" + HIR "呼啸轮回神功" + HIW "练就了第" + chinese_number(stage(level)) + "度意境！\n" NOR,
        me
      );

    }
  }

}
