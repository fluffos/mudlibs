int valid_learn(object me)
{
    object ob;
    
    if (me->query_skill("dangmo-xinjing",1) < me->query_skill("xuantian-sword",1))
        return notify_fail("你的荡魔心经火候不够，无法学习玄天剑法。\n");
    if ((int)me->query("max_force") < 100)
        return notify_fail("你的真气不足，难以领悟剑法的精妙之处。\n");
    
    if (!(ob = me->query_temp("weapon"))
        ||      (string)ob->query("skill_type") != "sword" )
        return notify_fail("你必须先找一把剑才能练剑法。\n");
    
    return 1;
}

int valid_enable(string usage)
{
    return usage=="sword" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
    return action[random(sizeof(action))];
}

int practice_skill(object me)
{
    if (me->query("max_force") < 100 )
        return notify_fail("你的内力修为不够深，无法练玄天剑法。\n");
    if ((int)me->query("kee") < 30)
        return notify_fail("你的气太低，再练下去会有危险的！\n");
    if ((int)me->query("force") < 5)
        return notify_fail("你的内力不够，没有办法运用玄天剑法。\n");
    me->receive_damage("kee", 30);
        me->add("force", -5);
    write("你按著所学练了一遍玄天剑法。\n");
    return 1;
}

string perform_action_file(string action)
{
        return CLASS_D("zhenwu") + "/xuantian-sword/" + action;
}

