#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
        
        object *inv, obj, obj1;
        int i, mypot,tapot;
        string str;

        object weapon;
       
        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail(RED"你要对谁施展这一招「梦幻惊神」？\n"NOR);

        if(!me->is_fighting())
                return notify_fail(RED"「梦幻惊神」只能在战斗中使用！\n"NOR);

        if(me->query("club")!="神州结义帮")
                return notify_fail(RED"你不是神州结义帮帮众，怎么能用此绝技？！\n"NOR);
        if((int)me->query("max_force") < 1000 )
                return notify_fail("你的内力不够！\n");

        if((int)me->query("force") < 600 )
                return notify_fail("你的内力不足！\n");

        if((int)me->query("sen") < 500 )
                return notify_fail("你的精神不足，没法子施用外功！\n");

        i=(int)me->query_skill("talk",1);

        if( i < 150)
                return notify_fail("你的聊天神功级别还不够，使用这一招会有困难！\n");

        if( time()-(int)me->query_temp("menghuan_end") < 4 )
                return notify_fail("你现在心有杂念，无力凝聚精神使用梦幻惊神！\n");
        message_vision(HIM"\n\n$N故摆睡姿，双目微合，脸露一丝宁静的微笑，四周顿时静寂无声，让$n感觉惧由心升。\n\n"NOR,me,target);
        message_vision(YEL"\n$n细看$N似在梦中腼腆媚笑，笑的让$n神不守舍，浑身上下没有一处自在的。\n\n"NOR,me,target);        
        mypot=(int)me->query_skill("talk");
        mypot=mypot*mypot*mypot + (int)me->query("combat_exp");

        tapot=(int)target->query_skill("unarmed");
        tapot=tapot+(int)target->query_skill("dodge")/10;
        tapot=tapot*tapot*tapot/10 + (int)target->query("combat_exp");

       
        if( random( mypot+tapot ) > tapot * 7/9 || !living(target) ) 
{       
        
         message_vision(HIR"$N睁开双目见$n魂迷之际，双掌齐发，如排山倒海之势排向$n的面门。\n\n"NOR,me, target);  
         COMBAT_D->do_attack_damage(me, target);
         target->receive_wound("kee",100 + me->query_str()+random(me->query_skill("talk")*2/5));
         COMBAT_D->report_status(target);
                
         if (target->query("eff_kee")<0 || !living(target))  
         {str=target->name()+"被"+me->name()+"的梦幻惊神排中面门而死。";
         CHANNEL_D->do_channel(me, "rumor",str);
         me->delete_temp("last_channel_msg");}
        else {if ( random(10)>3 )
              message_vision(HIY"\n紧接着$N闭目闻音，移动脚步，伸出双掌化作一道红光击向$n的腹部。\n\n"NOR,me,target);
         COMBAT_D->do_attack_damage(me, target);
         target->receive_wound("kee",100 + me->query_str()+random(me->query_skill("talk")*3/5));
         COMBAT_D->report_status(target);
              target->start_busy(1+random(2));
             }
          
}
     
         else  {message_vision(HIC"$N看破此招数的虚幻之处，早已飞身而起，远远的躲子一旁！\n"NOR, target);
              me->start_busy(2+random(2));
               }
               
        me->add("force", -50);
        me->receive_damage("sen", 50);
        me->set_temp("menghuan_end",time());
        return 1;
}
