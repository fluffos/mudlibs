#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  int attackp, defendp, damage;
  string msg, str;



  if ((int)me->query("str") < 20)
    return notify_fail("你的力量太低，不能使用绣针刺目。\n");

  if (!target) target = offensive_target(me);

  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("最温柔的一笑倾城只能对战斗中的对手使用。\n");

  if (!objectp(target))
    return notify_fail("你要吸掉谁的内力？\n");

  if (me->query_temp("sucked"))
    return notify_fail("你刚刚运过最温柔的一笑倾城!\n");

  if ((int)me->query_skill("talk", 1) < 120)
    return notify_fail("你聊天神功未成，还不会使用最温柔的一笑倾城。\n");
  if (me->query("club") != "痴心女儿帮")
    return notify_fail("你不是女儿帮，不会最温柔的一笑倾城！\n");
  if ((int)me->query("force", 1) < 1800)
    return notify_fail("你现在内力不足！\n");
  if ((int)me->query("max_force", 1) < 1800)
    return notify_fail("你内力修为不足！\n");
  //        if( objectp(me->query_temp("weapon")) )
  //                return notify_fail("你必须空手才能施用！\n");



  if ((int)me->query_skill("unarmed", 1) < 150)
    return notify_fail("你的拳脚功夫不够娴熟，不能使用 ！\n");



  if ((int)target->query("force") <= 0)
    return notify_fail(target->name() + "他已经没有任何内力了！\n");

  message_vision(HIR "$N突然眼神变得极其温柔，微微一笑,手掌轻轻的往前一送，手指向$n的不知什么部位飘去！\n" NOR,
    me, target);

  attackp = me->query_skill(
    "force",
    1
  ) + me->query_skill("unarmed", 1) + me->query_skill("talk", 1) / 2;
  defendp = target->query_skill("force") + target->query_skill("dodge");

  me->set_temp("sucked", 1);

  if (attackp / 2 + random(attackp) > defendp / 4 || !living(target)) {
    message_vision(HIY "$p一时难以闪避，只得慌乱用双手将她的手掌一夹,双手登时如被粘住一般的紧贴在手掌上。。\n" NOR, me, target);
    tell_object(me, HIB "你见" + target->name() + "如此，当即运起内力，将对方内力尽数吸来。。...\n" NOR);
    message_vision(HIY "$p似乎想说什么，可是全身无力，现出极其痛苦的表情，双手却又抽脱不开。”\n" NOR, me, target);
    tell_object(
      target, HIB "但觉手掌中微微一凉，内力源源不绝的顺着对方不住往外涌去。，\n" +
      "登时心中一惊，全然提不起真气收力，只得任对方吸取体内内力。。。\n"
      NOR);

    if (!target->is_killing(me)) target->kill_ob(me);

    target->add("force", -1 * ((int)me->query_skill("unarmed", 1) + target->query("force_factor")));
    if (target->query("force") < 1) target->set("force", 0);
    me->add("force", (int)me->query_skill("talk", 1) / 4 + target->query("force_factor"));
    if ((int)me->query("force") > 2 * ((int)me->query("max_force"))) me->set(
      "force",
      2 * ((int)me->query("max_force") - 100)
    );

    if (target->query("combat_exp") >= me->query("combat_exp")) {
      if ((int)me->query("potential") - (int)me->query("learned_points") < 110)
        me->add("potential", 2);
      me->add("combat_exp", 3);
    }
    damage = (int)me->query_skill("talk", 1) * 2 - (int)target->query("talk", 1);
    if (damage < 100) damage = 80;
    target->receive_damage("kee", damage);
    target->receive_wound("kee", damage);
    me->start_busy(2);
    if (target->query("eff_kee") < 0 || !living(target)) {
      str = target->name() + "被" + me->name() + "用" + HIR "痴心女儿帮" + HIM "的秘传绝技" + HIW "「一笑倾城」" + HIM "迷死了。听说" + target->name() + "被这秘技打死之后，还流露出色咪咪的笑容！";
      // message("channel:rumor",HIG"【"+HIR"三界神话"HIG"】"+HIM"某人："+str+"\n"NOR,users());
    }
    target->start_busy(3 + random(2));
    me->add("force", -200);
    call_out("perform3", 1, me, target);

    call_out("del_sucked", 3, me);
  } else {
    message_vision(HIY "可是$p看破了$P的企图，迅速地避开了这一笑倾城。\n" NOR, me, target);

    call_out("del_sucked", 2, me);

  }

  me->set_temp("targett", target);
  return 1;
}

void del_sucked(object me) {

  if (me->query_temp("sucked"))
    me->delete_temp("sucked");

}

int perform3(object me, object target) {

  object weapon;

  int damage;
  string msg;

  if (!target) target = offensive_target(me);

  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("你微微地一笑,缓缓收回内力，傲然而立!!\n");

  if ((int)me->query("force", 1) < 2000)
    return notify_fail("你待要再出天女散花，却发现自己的内力不够了！\n");

  msg = CYN "$N凝神息气，微微一笑,手腕疾抖，挽出千万个掌花，天女散花般的铺天盖地飞向$n。\n" NOR;
  if (!target->is_killing(me)) target->kill_ob(me);

  if (random(me->query_skill("force")) > target->query_skill("force") / 2) {
    target->start_busy((int)me->query_skill("talk", 1) / 200 + 1);

    damage = (int)me->query_skill("talk", 1);
    damage = damage + (int)me->query_skill("parry", 1);
    damage = damage + (int)me->query_skill("unarmed", 1);

    target->receive_damage("kee", damage);
    target->receive_wound("kee", damage / 3);
    me->add("force", -damage / 2);
    msg += HIR "只见$N掌花聚为一线，穿向$n,\n$n只觉一股热流穿心而过，喉头一甜，鲜血狂喷而出！\n" NOR;
  } else {
    msg += CYN "可是$p猛地向前一跃,跳出了$P的攻击范围。\n" NOR;
    me->add("force", -100);
    me->start_busy(2);
  }
  message_vision(msg, me, target);

  return 1;
}
