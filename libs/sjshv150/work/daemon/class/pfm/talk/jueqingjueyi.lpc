// qjqy.c 絕情谷奧義----絕情·絕意
// Modified by bluexuan 2001

#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target)
{
        string str;
        int kee_wound,damage,chance;
        string msg;
        object weapon;
                         
        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("別動不動就用「絕情·絕意」！\n");
        if(!me->is_fighting())
                return notify_fail("別動不動就用「絕情·絕意」！\n");
            if( me->query("club") !="绝情谷" )
               return notify_fail("絕情谷門人怎么会用「絕情·絕意」！\n");

        if((int)me->query("max_force") < 1000 )
                return notify_fail("你的内力不够！\n");

        if((int)me->query_skill("talk", 1) < 120)
                return notify_fail("你的聊天术级别还不够，使用这一招不太可能！\n");
   if((int)me->query("force") < 500 )
     return notify_fail("你的内力不足！\n");

        if((int)me->query("sen") < 300 )
                return notify_fail("你的精神不足，没法子施用外功！\n");



        msg = WHT"\n$N突然背对$n，手中映出"+HIR"绝情令"NOR"，"+WHT"令牌犹如閃电般飛出，同时左腿向前迈进使出"NOR"
"+BLINK""+HIW"☆☆☆☆☆【絕情谷奧義------絕情·絕意】☆☆☆☆☆！"NOR"
"+BLINK""+HIW" .        *                  . . . .  .   .  + .
          "NOR""+HIW"絕情谷奧義"+BLINK"    .   .  +  . . .
.                        .  .   .    .    . .
                        .    .    . +.    +  .
                                .       .   . .
        . .              .    * . . .  .  +   .
           +     ☆           .   .      +
                            .       . +  .+. .
  .                      .     . + .  . .     .      .
           .      .    .     . .   . . .
      *  "NOR""+HIR"絕情·絕意"+BLINK""+BLINK""+HIW"   .    . .  +    .  .           .
          .     .    .  +   . .  *  .       .
               . + .  .  .  .. +  .
.      .  .  .  *   .  *  . +..  .            *
 .      .   . .   .   .   . .  +   .    .            +\n"NOR;
//    me->start_busy(random(3));
    if( random(me->query("combat_exp")) > (int)target->query("combat_exp")/5
 ) {
      msg += HIW"结果$n被$N的「絕情·絕意」当胸击中，整个人如断线的风筝般飞了出去！\n"NOR;
       target->start_busy( (int)me->query_skill("talk") / 150 + 1);
        kee_wound = me->query("eff_kee")/12;
	me->receive_damage("kee", 50);
	target->add("kee", -kee_wound);	
	target->add("eff_kee", -(kee_wound));
        me->add("force", -120);
        
    }    
        else 
                msg += HIW"但是$n早已看出$N动作，此时急忙出架，
只听得“锵”的一声两人撞在一起迸发出绚烂的火花。\n"NOR;
        message_vision(msg, me, target);
        me->add("force",-100-me->query("force_factor"));
        if (target->query("eff_kee")<0 || !living(target))  
        {
 str=target->name()+"被"+me->name()+"用"+HIB"绝情谷"+HIM"的秘技"+HIW"「絕情·絕意」"+HIM"杀死了。听说"+target->name()+"死的时候脸上留着失落的表情！";
//        message("channel:rumor",HIM"【空穴来风】某人："+str+"\n"NOR,users());
    }    
        me->start_busy(random(3));
        return 1;
           }
