// BY Cigar 2002.04.08
#include <ansi.h>

inherit SSERVER;
int perform(object me, object target)
{
        string str;
        int damage;
        string msg;

        if( !target ) target = offensive_target(me);

        if( !target || !target->is_character() || !me->is_fighting(target) )
                return notify_fail(HIR"“魂牵梦绕”只能在战斗中使用。\n"NOR);

        if( objectp(me->query_temp("weapon")) )
                return notify_fail(HIR"你不空手，怎么能使出？\n"NOR);         

        if( (int)me->query_skill("talk", 1) < 120 )
                return notify_fail(HIR"你的聊天技能太差，还不能使出此绝技。\n"NOR);

        if( (int)me->query("str") < 20  )
                return notify_fail("你力量不够，不能发出“魂牵梦绕”。\n");

        if((int)me->query("kee") < 300 )
                return notify_fail("你的气血不足，没法子施用外功！\n");

            if( me->query("club") !="梦回大唐阁" )
               return notify_fail(HIG"你不是梦回大唐阁的人，怎么会阁中绝技呢？\n"NOR);  

        if( (int)me->query_skill("unarmed", 1) < 150 )
                return notify_fail(HIR"你的扑击格斗的技能不够熟练。\n"NOR);

        if( (int)me->query("force", 1) < 300 )
                return notify_fail(HIR"你现在内力太弱，不能使用「魂牵梦绕」。\n"NOR);

        msg = HIW "\n天空点点花瓣飘落，让$n诧异万分，熟知此时正是$N牵动"+HIY"魂牵梦绕"+HIW"致命一击的时候。\n"NOR;
        msg +=HIW"\n$N双目软绵，牵动六阴三阳之真气，无声无息幻出古唐朝繁市景色，牵绕在$n周围。\n"NOR;
        if( !target->is_killing(me) ) target->kill_ob(me);

        if (random(me->query_skill("force")) > target->query_skill("force")/4 )
        {
                me->start_busy(2);

      target->start_busy( (int)me->query_skill("talk") / 120 + 1);
                
                damage = (int)me->query_skill("talk", 1);
                
                damage = damage + random(damage)+100;
                
                target->receive_damage("kee", damage*2/3);
                target->receive_wound("kee", damage*2/3);
                me->add("force", -damage/2);
                
                if( damage < 220 )
                        msg += HIR"\n$n情出一处，泪水洗刷双眼，魂魄早已溶入幻境之中。\n"NOR;
       else if( damage < 360 )
                        msg += HIR"\n$n看到此幻想，顿感情、爱，交织融合，放下手中武器号啕大哭不已。\n"NOR;
        else if( damage < 500 )
                        msg += HIR"\n$n看见繁荣幻想围绕周围，似乎是层层掌影交织而成，顿感不妙！\n"NOR;
                else
                        msg += HIW"\n$n被$N牵动的六阴真气缠绕至中，百感交集油然而生，失去魂牵梦绕的情感，早已忘却身在何处。\n"NOR;
                        msg += HIW"\n$N反手牵动三阳真气，双掌齐发迅速拍向$n的面门，$n魂魄还在梦幻中，早就失去了躲闪之力。\n"NOR;              
        }
        else 
        {
                target->start_busy(1);
                msg += HIC"\n可是$p看破了$P的幻视招数，踉踉跄跄的倒退几步，躲在了一旁。\n"NOR;

                me->start_busy(2);
         }
        if (target->query("eff_kee")<0 || !living(target))  
        {
str=target->name()+"被"+me->name()+"用"+HIY"梦回唐朝"+HIM"的绝招"+HIW"“魂牵梦绕”"+HIM"拍死了。听说"+target->name()+"死的一瞬间宛如还在梦中一般！";
        message("channel:rumor",HIM"【空穴来风】某人："+str+"\n"NOR,users());
        }
        message_vision(msg, me, target);

        return 1;
}
