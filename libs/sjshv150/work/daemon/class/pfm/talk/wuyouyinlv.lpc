//helpler sk sanjie 

#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg, str;
  int extra;
  object weapon;
  if (me->query("club") != "无忧宫")
    return notify_fail("你不是无忧宫的，不会此绝技！\n");
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［无忧音律波］只能对战斗中的对手使用。\n");
  extra = (int)me->query_skill("talk", 1) + target->query("max_kee") / 5;
  if (extra < 150) return notify_fail("你的［聊天神功］不够熟练！\n");
  if ((int)me->query_skill("unarmed", 1) < 150) return notify_fail("你的［拳脚功夫］不够熟练！\n");
  msg = HIR "\n$N双臂暴长，第一招［无忧音律］，双手拢向$n！" NOR;
  if (random((int)me->query("combat_exp")) >= (int)target->query("combat_exp") / 3) {
    message_vision(msg + "\n", me, target);
    message_vision(HIC "$N躲闪不及，全身正被无优低音律罩住！ 一股青气从$N顶门喷涌而出！\n" NOR, target);
    target->receive_wound("kee", extra);
    target->receive_damage("kee", extra * 2);
    me->receive_heal("kee", extra);
    target->start_busy(2);
  } else {
    msg += HIG "可是$p连跳了几步，闪开了这阵低音律波！\n" NOR;
  }
  message_vision(msg, me, target);
  msg = HIR "\n$N双臂暴长，第二招［无忧中音律］，双手拢向$n！" NOR;
  if (random((int)me->query("combat_exp")) >= (int)target->query("combat_exp") / 2) {
    message_vision(msg + "\n", me, target);
    message_vision(HIR "$N躲闪不及，全身正被无优中低音律罩住！ 一股血气从$N脑门喷涌而出！\n" NOR, target);
    target->receive_wound("sen", extra);
    me->receive_heal("sen", extra);
  } else {
    msg += HIG "可是$p连跳了几步，闪开了这阵中音律波！\n" NOR;
  }
  message_vision(msg, me, target);
  msg = HIR "\n$N双臂暴长，第三招［无忧高音律］，双手拢向$n！" NOR;
  if (random((int)me->query("combat_exp")) >= (int)target->query("combat_exp") * 2) {
    message_vision(msg + "\n", me, target);
    message_vision(HIC "$N躲闪不及，全身正被无优低音律罩住！ 一股青气从$N顶门喷涌而出！\n" NOR, target);
    target->receive_wound("kee", extra * 2);
    me->receive_heal("kee", extra * 2);
    target->start_busy(2);
  } else {
    msg += HIG "可是$p连跳了几步，闪开了这阵高音律！\n" NOR;
  }
  message_vision(msg, me, target);
  me->start_busy(1 + random(3));
  //
  if (target->query("eff_kee") < 0 || !living(target)) {
    str = me->name() + "叹道:知音难觅!随既十二道无忧音律从" + me->name() + "的指间划出,穿过了" + target->name() + "的咽喉。听说" + target->name() + "被" + HIG "无忧宫" + HIM + "的绝招" + HIW + "「无忧音律波」" + HIM "震死了！";
    // message("channel:rumor",HIG"【"+HIR"三界神话"+HIG"】"+HIM"某人："+str+"\n"NOR,users()); 
  }
  return 1;
}
