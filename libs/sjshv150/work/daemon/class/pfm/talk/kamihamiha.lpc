#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
        string msg;
        int myexp,yourexp,lvl;
       
if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
        return notify_fail("「赛亚光束」只能对战斗中的对手使用。\n");
if( objectp(me->query_temp("weapon")) )
return notify_fail("你必须空手才能施用赛亚光束!!\n");
if(target->is_busy())
     return notify_fail(target->query("name")+"已经动弹不得了！\n");
if( (int)me->query_skill("talk",1) < 140)
    return notify_fail("你的基本功还不够纯熟!!\n");
    if( (int)me->query("max_force") <1000)
return notify_fail("你的内力还不够强,难以发射赛亚光束!!!\n");
            if( me->query("club") !="赛亚异族" )
               return notify_fail("你不是异族之人，怎么能发出赛亚光束！\n");  

        if( (int)me->query("str") < 20  )
                return notify_fail("你力量不够，不能使用此绝招。\n");

    if( (int)me->query("force") <300)
    return notify_fail("你现在内力不足,无法使出赛亚异族!!\n");
        myexp = (int) me->query("combat_exp");
        yourexp = (int) target->query("combat_exp");
      lvl = (int)me->query_skill("talk",1)/80;
    msg = HIW"\n
$N大喝一声，大幅提升自己的战斗力“卡、密、哈、米、哈”
$N全部战斗力化作一条巨大的"+HIR"「赛亚光束」激射向$n\n" NOR;
              if(random(myexp)>yourexp/4)
        {
                message_vision(msg + "\n", me, target);
        msg = HIG "
$n霎时间被一股强大的气流笼罩全身，分毫动弹不得，被「赛亚光束」打了个正着！\n" NOR;
                message_vision(msg, me, target);
            target->start_busy(lvl+random(2));
            target->add("force", -100);
        }
    else {
            message_vision(msg +"\n", me, target);
           msg = HIM "
$n看到如此强大的气流袭来，自知不敌，一个瞬间移动，跳上半空！\n" NOR;
message_vision(msg, me, target);
            me->start_busy(random(2)); }
me->add("force",-200);
        return 1;
}

