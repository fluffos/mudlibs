// by Cigar 2002.01

#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int myexp, yourexp, lvl;

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("「忘忧指」只能对战斗中的对手使用。\n");
  if (objectp(me->query_temp("weapon")))
    return notify_fail("你必须空手才能施用忘忧指!!\n");
  if (target->is_busy())
    return notify_fail(target->query("name") + "已经动弹不得了！\n");
  if ((int)me->query_skill("talk", 1) < 140)
    return notify_fail("你的基本功还不够纯熟!!\n");
  if ((int)me->query("max_force") < 1000)
    return notify_fail("你的内力还不够强,难以施展忘忧指!!!\n");
  if (me->query("club") != "忘忧谷依轩楼")
    return notify_fail("你不是忘忧谷依轩楼的人，怎么会帮中绝技！\n");

  if ((int)me->query("str") < 20)
    return notify_fail("你力量不够，不能使用此绝招。\n");

  if ((int)me->query("force") < 300)
    return notify_fail("你现在内力不足,无法使出忘忧指!!\n");
  myexp = (int)me->query("combat_exp");
  yourexp = (int)target->query("combat_exp");
  lvl = (int)me->query_skill("talk", 1) / 80;
  msg = HIW
    "\n$N突然露出一丝狡诈的眼神，抬起右手凌空一指，口中念念有词，“呼”的一响，$N的手指对着$n化作一道白光点了过来，这正是失传已久的" + HIR "「忘忧指」\n" NOR;
  if (random(myexp) > yourexp / 4) {
    message_vision(msg + "\n", me, target);
    msg = HIG "$n产生了无数的幻觉，眼前到处都是$N的手指。突然，$n感到檀中穴一震，急运内力抵制$N的指力，可是已经晚了...\n" NOR;
    message_vision(msg, me, target);
    target->start_busy(lvl + random(2));
    target->add("force", -100);
  } else {
    message_vision(msg + "\n", me, target);
    msg = HIM "可是$n深吸一口气，聚精会神的识破了$N的招数，大汗淋漓的躲过了这一招...\n" NOR;
    message_vision(msg, me, target);
    me->start_busy(random(3));
  }
  me->add("force", -200);

  return 1;
}
