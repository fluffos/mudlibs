#include <ansi.h>
#define CLUB_NAME "清风细雨楼"
#define CLUB_ID "qingfeng"
#define CLUB_CHANNEL "qingfeng"

inherit SSERVER;

int perform(object me, object target) {
  //        string str;
  object weapon;
  int kee_wound;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展这一招「清风细雨」？\n");

  if (!me->is_fighting())
    return notify_fail("「清风细雨」只能在战斗中使用！\n");

  if ((int)me->query("force") < 1800)
    return notify_fail("你的内力不够！\n");
  if ((int)me->query("combat_exp", 1) < 4000000)
    return notify_fail("你的武学不够！\n");
  if ((int)me->query("max_force", 1) < 1800)
    return notify_fail("你内力修为不足！\n");
  if (me->query("club") != "清风细雨楼")
    return notify_fail("你不是清风细雨楼的，怎么会帮中绝技！\n");
  if ((int)me->query("kee") < 300)
    return notify_fail("你的气血不足，没法子施用外功！\n");

  if ((int)me->query_skill("talk", 1) < 120)
    return notify_fail("你的聊天术级别还不够，使用这一招不太可能！\n");
  if (me->query_skill_mapped("unarmed") != "talk")
    return notify_fail("你现在无法使用「清风细雨」来攻击。\n");
  if ((int)me->query("str") < 20)
    return notify_fail("你力量不够，不能使用清风细雨。\n");
  if (random((int)me->qurey("PKS")) > 5)
    return notify_fail("你充满邪恶之气，驱动不了至灵的清风细雨楼的绝技。\n");

  //        if( time()-(int)me->query_temp("qingfengxiyu_end") < 3 )
  //                return notify_fail("绝招不可多用！\n");
  if (random(70) > (int)me->query("kar"))
    return notify_fail(HIB "你心情好差，怎么也使不出这个让人心动的绝招来。\n" NOR);
  me->delete("env/brief_message");

  message_vision(HIW
    "\n$N默默念起" + HIR "“天庭神咒”" + HIW "，顿时，乌云滚滚，天昏地暗，空中现出" + HIY "风雨" + HIW "二神，

只见他二神手持" + HIM "清风细雨楼信物" + HIW "在你上空快速的旋转起来，霎时间，周围" + HIB "恐

怖" + HIW "气氛急剧浓重起来，" + HIY "风雨" + HIW "二神那里理会现在下面的世界，只见他们手持" + HIM "清

风细雨楼信物" + HIW "化作一道" + HIG "圣光" + HIW "罩在你们周围。"



    +HIG "雨中百草，临风轻笑，更问世间情为何物... ...\n" NOR, me);

  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  kee_wound = me->query("eff_kee") / (2 + random(3));
  //        me->receive_damage("kee", 50);
  target->add("kee", -kee_wound);
  target->add("eff_kee", -kee_wound);
  me->add("force", -200);
  message_vision(HIR "$N的掌风紧跟着风雨二神的攻击压向$n的身前，$n的全身被罩在$N的掌风之中，不能动弹了！\n" NOR, me, target);
  /*
        if (target->query("eff_kee")<0 || !living(target))  
        {
str=target->name()+"被"+me->name()+"用"+HIG"清风细雨楼"+HIM"的绝招"+HIW"「清风细雨」"+HIM"震死了。听说"+target->name()+"死的无声无息，很是神秘！";
        message("channel:rumor",HIM"【空穴来风】某人："+str+"\n"NOR,users());
        }
*/
  target->start_busy((int)me->query_skill("talk") / 150 + 2);
  //        target->start_busy(3+random(2));

  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
      COMBAT_D->report_status(target);
    }
  }

  me->start_busy(2);
  return 1;
}
