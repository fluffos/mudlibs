//sanhua-zhang perform 四季散花(春夏秋冬)
#include <ansi.h>

inherit F_SSERVER;

#include "/daemon/skill/eff_msg.h";

int perform(object me, object target)
{
      string msg;
      int damage, p;                                   

      if( !target ) target = offensive_target(me);
     
      if( !target || !me->is_fighting(target) )
      return notify_fail("「四季散花」只能在战斗中对对手使用。\n");
             
      if(me->query_temp("weapon"))
      return notify_fail("你必须空手使用「四季散花」！\n");
      
                  if( me->query("club") !="碧海阁" ) 
                     return notify_fail("你不是碧海阁的，怎么会此绝技！\n");   
      if( (int)me->query_skill("talk",1) < 150 )
      return notify_fail("你的聊天神功不够娴熟，不能使用「四季散花」！\n");
      
      if( (int)me->query_skill("unarmed",1) < 200 )
      return notify_fail("你的基本功等级不够，不能使用「四季散花」！\n");  
      
      if( (int)me->query_str() < 22 )
      return notify_fail("你的臂力不够强，不能使用「四季散花」！\n");
      
      if( (int)me->query("force") < 800 )
      return notify_fail("你的内力太弱，不能使用「四季散花」！\n");
      
                                                                                 
     
      damage = (int)me->query_skill("talk", 1);
      damage = (int)me->query_skill("unarmed", 1)+damage;
      damage = (int)me->query_skill("unarmed", 1)+damage;
      
        switch(random(4)) {
        case 0:
           { msg = HIG"
\n\n$N突然面带微笑，手掌微张，掌中涌出一股劲风，恍忽是一片片嫩绿的"CYN"「芳草」"GRN"，直向$n的面颊飞去！\n\n"NOR;
                damage = damage*2/3 + random(damage/3);               
                me->set_temp("nl", -120);} break;
          
        case 1:        
          { msg = MAG"\n\n
只听$N“哎呀”一声，身行象前跌去，突然一道蓝光闪现，破空之声中几朵"WHT"「清兰」"MAG"向$n的胸前飞去！\n\n"NOR;             
                damage = damage*2/3 + random(damage/2);                
                me->set_temp("nl", -150);} break;

        case 2:        
          { msg = HIY"\n\n
突然$N双手合十，口中念念有词，$n忽然觉得眼前人影如山，忽而排山倒海，忽而忽而高山流水，
觉得一切都在离$n远去，跟着一股醉人的"GRN"「秋菊」"HIY"清香扑鼻而来．．．\n\n"NOR;           
                damage = damage*2/3 + random(damage/3);
                me->set_temp("nl", -120);} break;
        
        case 3:
         { msg = HIW"\n\n
突然$N大吼一声，顿时把$n瞎了一个激灵，之间$N在眉宇之间布满了一层薄霜，
双目冷冷的瞪着$n，接着袖袍一卷，一朵朵绽开的"MAG"「寒梅」"HIW"向$n满面扑来！\n\n"NOR;          
                damage = damage*2/3 + random(damage/2);  
                me->set_temp("nl", -100);} break;
        }
    if (random((int)me->query("combat_exp")) > (int)target->query("combat_exp")/5 &&
        random(10) > 2)
            {
                target->receive_damage("kee", damage);
                target->receive_wound("kee", damage/3);
                me->add("force", me->query_temp("nl"));
                target->start_busy(random(2));
                me->delete_temp("nl");
                p = (int)target->query("kee")*100/(int)target->query("max_kee");
                msg += damage_msg(damage, "内伤");
                msg += "( $n"+eff_status_msg(p)+" )\n";                
                } 
            else 
               {       
                me->start_busy(1+random(2));
                me->add("force", -(60+random(100))); 
                me->delete_temp("nl");
                message_vision(msg, me, target);               
                msg = CYN" 可是$p一个巧云翻身，远远的躲了开去。\n\n"NOR;
               }
            message_vision(msg, me, target);
           return 1;
       
}
