// by cigar
#include <ansi.h>

inherit SSERVER;
int perform(object me, object target) {
  string str;
  int damage;
  string msg;

  if (!target) target = offensive_target(me);

  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("优雅武功怎可偷袭他人呢。\n");

  if (objectp(me->query_temp("weapon")))
    return notify_fail("你不空手，怎么能使出？\n");

  if ((int)me->query_skill("talk", 1) < 120)
    return notify_fail("你的TALK技能太差，还不能使出此绝技。\n");

  if ((int)me->query("str") < 20)
    return notify_fail("你力量不够，不能使用天涯一击。\n");

  if ((int)me->query("kee") < 300)
    return notify_fail("你的气血不足，没法子施用外功！\n");

  if (me->query("club") != "天涯海阁")
    return notify_fail("你不是天涯海阁的人，怎么会阁中绝技呢？\n");

  if ((int)me->query_skill("unarmed", 1) < 180)
    return notify_fail("你的扑击格斗的技能不够熟练。\n");

  if ((int)me->query("force", 1) < 300)
    return notify_fail("你现在内力太弱，不能使用「天涯一击」。\n");

  msg = HIM "$N默念" + HIW "[天涯一击]" + HIM "之密论，顿感脚步加快，掌中似乎顿生缠绵之力，阳刚之气，举掌拍向$n!\n" NOR;

  if (!target->is_killing(me->query("id"))) target->kill_ob(me);

  if (random(me->query_skill("force")) > target->query_skill("force") / 4) {
    me->start_busy(2);
    //                target->start_busy(2+random(3));

    target->start_busy((int)me->query_skill("talk") / 120 + 2);

    damage = (int)me->query_skill("talk", 1);

    damage = damage + random(damage) + 100;

    target->receive_damage("kee", damage * 2 / 3);
    target->receive_wound("kee", damage * 2 / 3);
    me->add("force", -damage / 2);

    if (damage < 120)
      msg += HIR "$n顿感掌风刮面，躲闪不急，被$N的缠绵之力击中，浑身难受无比。\n" NOR;
    else if (damage < 140)
      msg += HIR "结果$n被$N的乱舞之掌一击，「啊」地一声退了两步。\n" NOR;
    else if (damage < 180)
      msg += HIC "$n见$N的掌面已经拍向面门，心中的失落之感油然而生，大呼：“我命休以”！\n" NOR;
    else
      msg += HIW "$N" + HIR "缠绵之力" + HIW "裹着" + HIY "阳刚之气" + HIW "的掌风像排山倒海之势压向$n，$n被$N的这股阴阳之力震的五脏六腑都已破碎，眼前一黑，三魂六魄早已没了踪影...\n" NOR;

  } else {
    target->start_busy(1);
    msg += CYN "可是$p看破了$P的招数，并贸然上前。\n" NOR;

    me->start_busy(2);
  }
  if (target->query("eff_kee") < 0 || !living(target)) {
    str = target->name() + "被" + me->name() + "用" + HIY "天涯海阁" + HIM "的绝招" + HIW "[天涯一击]" + HIM "拍死了。听说" + target->name() + "的尸体没有一处完整的地方！";
    message("channel:rumor", HIM "【空穴来风】某人：" + str + "\n" NOR, users());
  }
  message_vision(msg, me, target);

  return 1;
}
