// gong.c 拱猪 by angell
#include <ansi.h>
inherit SSERVER;

int exert(object me, object target)
{
        int damage, ap, dp, success;
        string msg;     

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
        return notify_fail("你想拱谁？\n");

        if( (int)me->query_skill("eating-force", 1) < 10 )
                return notify_fail("你的大食神功修为太低，强行使用对己无益。\n");
            if( (int)me->query("force") < 200 )
                return notify_fail("你的内力不足。\n");


        if( (int)me->query("per") > 10 && !me->query_temp("bianlian"))
                return notify_fail("你以为自己长的很象猪吗？\n");

        if(!me->is_fighting()||!target->is_fighting())
                return notify_fail("你有在打架吗？\n");

        msg = HIB
"\n$N趁$n不备，忽然一头向$n拱了过去！\n" NOR;
        success = 1;

        ap = me->query_skill("force");
        ap = ap * ap * ap /10 ;
        ap += (int)me->query("combat_exp");
        dp = target->query("combat_exp");
        if( random(ap + dp) < dp ) success = 0;
        
            if(success == 1 ){
                switch (random(4))
        {
             case 0:
           {
            msg += HIR "$n被撞了个正着，不由一阵气血翻涌！\n" NOR;
       damage=(int)me->query("max_force")/10+random((int)me->query("max_force")/10);
            target->receive_damage("kee", damage*4/5);
            target->receive_wound("kee",damage/5);
            break;
                   }
   case 1:
           {
            msg += HIG "$n被撞了个正着，神智都有些恍惚了！\n" NOR;
       damage=(int)me->query("max_force")/10+random((int)me->query("max_force")/10);
            target->receive_damage("sen", damage*4/5);
            target->receive_wound("sen",damage/5);
            break;
                    }
   case 2:
           {
            msg += HIY "$n被撞了个正着，一屁股跌坐在地上，半晌不能动弹！\n" NOR;
       target->start_busy(5);
            break;
                    }
   case 3:
           {
            msg += HIW "$n被撞了个正着，急忙运内力相抗！\n" NOR;
       damage=(int)me->query("max_force")/5+random((int)me->query("force")/5);
            target->add("force", -damage);
            if ((int)target->query("force")<0) target->unconcious();
            break;
                     }
            }
            } else {
                    msg +=  HIC "结果$n向旁边一闪，避了开去！\n" NOR;   
            }
                        me->improve_skill("eating-force", 1, 1);
        
        message_vision(msg, me, target);
        if( success == 1 ) COMBAT_D->report_status(target);

        if( living(target) ) target->kill_ob(me);
           me->add("force",-(100+random(50)));
        me->start_busy(3);        
        return 1;
}
