// dragongpig.c by angell
#include <ansi.h>

inherit SSERVER;

int cast(object me, object target)
{
        object *ob, where;
            int success_adj, damage_adj, skill, i;

        success_adj = 160;
        damage_adj = 80;

             if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁使用[神龙吐猪]？\n");

        if( (int)me->query_skill("fofa",1) < 50 )
                return notify_fail("这么高深的绝技是那么好学会的吗？\n");
              if( (int)me->query("force") < 150 )
                return notify_fail("你的内力不够。\n");
              if((int)me->query("mana") < 100+2*(int)me->query("mana_factor") )
                return notify_fail("你的法力不够了！\n");

        if((int)me->query("sen") < 100 )
                return notify_fail("看你魂不守舍的样子还念咒呢！\n");

        me->add("mana", -60-2*(int)me->query("mana_factor"));
        me->add("force", -100);
              me->receive_damage("sen", 50);

        if( random(me->query("max_mana")) < 100 ) {
                write("今天大概百兽开会，龙啦猪啦的都来不了了！\n");
                return 1;
        }
 skill = me->query_skill("spells");
message_vision(HIW "$N一转身，化做一条银鳞白龙，张口一吐，流沙河的黑水直冲出来！卷向在场的每一个人。\n" NOR,me,target);

  ob = all_inventory(environment(me));
        for(i=0; i<sizeof(ob); i++) {
                if( !living(ob[i]) || ob[i]==me ) continue;
                if(!me->visible(ob[i])) continue;
                if( skill/2 + random(skill/2) < (int)ob[i]->query("cps") * 2 ) continue;

        SPELL_D->attacking_cast(
                me, 
                ob[i], 
                success_adj,    
                damage_adj,     
                "shen",                 
                "",
                HIC "$n被水一冲，遍体生寒，神智都不清醒了！\n" NOR, 
                HIC "但是$n站稳脚跟，硬挺了下来。\n" NOR, 
                HIB "但是$n腾空而起，避开了这阵惊天恶浪，立刻转守为攻！\n" NOR, 
                HIB "$n口气没喘上来，自己差点晕了过去！\n" NOR
                );
            }

        SPELL_D->attacking_cast(
                me, 
                target, 
                success_adj,    
                damage_adj,     
                "kee",          
                HIM "$N又一转身，化做一只肥耳黑猪，挺鼻一拱，直撞$n。\n" NOR,
                HIR "$n被撞个正着，波，的一声吐出一口鲜血！\n" NOR, 
                YEL "$n被撞了个正着，波，的一声吐出一口鲜...橙汁！\n" NOR, 
                HIB "$n一闪身避了开来，立刻掌握了主动！\n" NOR, 
                HIB "$n感觉撞到了墙上，浑身气血一阵翻腾！\n" NOR
                );

        me->start_busy(2+random(2));
        return 3+random(5);

}
