// onlyu.c by greenwc
#include <ansi.h>

inherit SSERVER;

int cast(object me, object target) {
  int ap, dp, damage, success;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁使用onlyu？\n");

  if ((int)me->query("mana") < 100 + 2 * (int)me->query("mana_factor"))
    return notify_fail("你的法力不够！\n");

  if ((int)me->query("sen") < 200)
    return notify_fail("你无法集中精力！\n");
  if ((int)me->query_skill("fofa") < 100)
    return notify_fail("你的佛法修为还不够！\n");

  me->add("mana", -100 - 2 * (int)me->query("mana_factor"));

  if (random(me->query("max_mana")) < 100) {
    write("你试着哼了几声，但怎么也找不着调！\n");
    return 1;
  }

  ap = (int)me->query_skill("spells");
  ap = ap * ap * ap / 10;
  ap += (int)me->query("combat_exp");
  dp = (int)target->query("combat_exp");
  success = 0;
  damage = ((int)me->query_skill("spells") / 5 + random((int)me->query_skill("spells") / 5));
  message_vision(HIY "\n$N忽然跳出战圈，向$n问道：" NOR, me, target);
  message_vision(HIY "\n$n你知不知道什么是铛铛铛铛铛铛？" NOR, me, target);
  message_vision(HIY "\n铛得铛铛铛铛铛，就是" NOR, me, target);
  if (random(ap + dp) > dp) {
    success += 1;
    me->receive_wound("sen", damage / 4);
    target->receive_wound("sen", damage / 3);
    target->receive_damage("sen", damage * 2 / 3);
  }
  message_vision(HIY "\nOn——ly you——  能拌我取西经" NOR, me, target);
  if (random(ap + dp) > dp) {
    success += 1;
    me->receive_wound("sen", damage / 4);
    target->receive_wound("sen", damage / 3);
    target->receive_damage("sen", damage * 2 / 3);
  }
  message_vision(HIY "\nOn--ly you--  能杀妖和除魔" NOR, me, target);
  if (random(ap + dp) > dp) {
    success += 1;
    me->receive_wound("sen", damage / 4);
    target->receive_wound("sen", damage / 3);
    target->receive_damage("sen", damage * 2 / 3);
  }
  message_vision(HIY "\nOnly you  能保护我，让螃蟹和蚌精不能吃我" NOR, me, target);
  if (random(ap + dp) > dp) {
    success += 1;
    me->receive_wound("sen", damage / 4);
    target->receive_wound("sen", damage / 3);
    target->receive_damage("sen", damage * 2 / 3);
  }
  message_vision(HIY "\n你本领最大  就是Only you--" NOR, me, target);
  if (random(ap + dp) > dp) {
    success += 1;
    me->receive_wound("sen", damage / 4);
    target->receive_wound("sen", damage / 3);
    target->receive_damage("sen", damage * 2 / 3);
  }
  message_vision(HIY "\nOn--ly you--  别怪师傅嘀咕" NOR, me, target);
  if (random(ap + dp) > dp) {
    success += 1;
    me->receive_wound("sen", damage / 4);
    target->receive_wound("sen", damage / 3);
    target->receive_damage("sen", damage * 2 / 3);
  }
  message_vision(HIY "\n戴上金箍儿，别怕死别颤抖" NOR, me, target);
  if (random(ap + dp) > dp) {
    success += 1;
    me->receive_wound("sen", damage / 4);
    target->receive_wound("sen", damage / 3);
    target->receive_damage("sen", damage * 2 / 3);
  }
  message_vision(HIY "\n背黑锅我来，送死你去，拼全力为众生" NOR, me, target);
  if (random(ap + dp) > dp) {
    success += 1;
    me->receive_wound("sen", damage / 4);
    target->receive_wound("sen", damage / 3);
    target->receive_damage("sen", damage * 2 / 3);
  }
  message_vision(HIY "\n牺牲也值得  南无阿弥陀佛" NOR, me, target);
  if (random(ap + dp) > dp) {
    success += 1;
    me->receive_wound("sen", damage / 4);
    target->receive_wound("sen", damage / 3);
    target->receive_damage("sen", damage * 2 / 3);
  }
  message_vision(HIY "\nOn—— On——" NOR, me, target);
  if (random(ap + dp) > dp) {
    success += 1;
    me->receive_wound("sen", damage / 4);
    target->receive_wound("sen", damage / 3);
    target->receive_damage("sen", damage * 2 / 3);
  }

  if (success = 0) message_vision(HIW "\n$n哼了一声：On你妈个头哇，你有完没完呀！" NOR, me, target);
  else if (success > 5) message_vision(HIB "\n$n被烦的头痛欲裂，根本没有再战的力量了" NOR, me, target);
  else message_vision(HIB "\n$n拍了拍头，尽量想让自己保持清醒" NOR, me, target);

  if (living(target)) target->kill_ob(me);
  me->start_busy(2 + random(2));
  return 3 + random(5);
}
