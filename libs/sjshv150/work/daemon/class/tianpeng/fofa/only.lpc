// onlyu.c by greenwc
#include <ansi.h>

inherit SSERVER;

int cast(object me, object target)
{
        int ap,dp,damage,success;

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁使用六字真言？\n");

        if((int)me->query("mana") < 100+2*(int)me->query("mana_factor") )
                return notify_fail("你的法力不够！\n");

        if((int)me->query("sen") < 100 )
                return notify_fail("你无法集中精力！\n");
        
             if((int)me->query_skill("fofa") < 50 )
                return notify_fail("你的佛法修为还不够！\n");

        me->add("mana", -50-2*(int)me->query("mana_factor"));

        if( random(me->query("max_mana")) < 50 ) {
                write("你突然忘了台词，念不出六字真言！\n");
                return 1;
        }

        ap = (int)me->query_skill("spells");
        ap = ap * ap * ap /10 ;
        ap += (int)me->query("combat_exp")+(int)me->query("daoxing");
        dp = (int)target->query("combat_exp")+(int)target->query("daoxing");
             damage=((int)me->query_skill("spells")/5+random((int)me->query_skill("spells")/5));
 
           success=0;
            message_vision(HIR"\n$N忽然口宣一声佛号，面目肃然，嘴唇歙动，暗运玄功从牙缝里挤出了六个字："NOR,me,target);
            message_vision(HIR"\n唵!"NOR,me,target);
            {            
                   success += 1;
              me->receive_wound("kee", damage/5);
            target->receive_wound("kee",damage/3);
            target->receive_damage("kee",damage*2/3);
}

            message_vision(HIR"\n—嘛！"NOR,me,target);
              {            
                   success += 1;
              me->receive_wound("kee", damage/5);
            target->receive_wound("kee",damage/3);
            target->receive_damage("kee",damage*2/3);
}

            message_vision(HIR"\n——呢！"NOR,me,target);
             {            
                   success += 1;
              me->receive_wound("kee", damage/5);
            target->receive_wound("kee",damage/3);
            target->receive_damage("kee",damage*2/3);
}

            message_vision(HIR"\n———叭！"NOR,me,target);
             {            
                   success += 1;
              me->receive_wound("kee", damage/5);
            target->receive_wound("kee",damage/3);
            target->receive_damage("kee",damage*2/3);
}

            message_vision(HIR"\n————咪！"NOR,me,target);
              {            
                   success += 1;
              me->receive_wound("kee", damage/5);
            target->receive_wound("kee",damage/3);
            target->receive_damage("kee",damage*2/3);
}

            message_vision(HIR"\n—————吽！"NOR,me,target);
            {            
                   success += 1;
              me->receive_wound("kee", damage/5);
            target->receive_wound("kee",damage/3);
            target->receive_damage("kee",damage*2/3);
}

                      
            if (success=0) message_vision(HIW"\n$n哼了一声，鬼叫什么，看打！"NOR,me,target);
           else if (success > 3) message_vision(RED"\n$n被震得气血阵阵翻涌，哇的一声喷出一口鲜血！"NOR,me,target);
            else message_vision(RED"\n$n被震得倒推了数步，嘴角渗出丝丝血迹。"NOR,me,target);
            
            if( living(target) ) target->kill_ob(me);
        me->start_busy(2+random(2));
        return 3+random(5);
}
