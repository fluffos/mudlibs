#include <ansi.h>

inherit SSERVER;

int perform(object me) {
  string msg;
  object weapon, target;
  object ob;
  int skill, skill2, ap, dp, kee_wound;

  me->clean_up_enemy();
  target = me->select_opponent();

  skill = me->query_skill("hammer");
  skill2 = me->query_skill("parry");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "hammer")
    return notify_fail("不用锤，怎么能用“日暮途穷”？\n");

  if ((string)weapon->query("name") == "小流星锤")
    return notify_fail("已经分锤了，小流星锤是子锤分不得！\n");

  if (!me->is_fighting() || !living(me))
    return notify_fail("「日暮途穷」只能在战斗中使用。\n");
  if (me->query("family/family_name") != "幽凝谷")
    return notify_fail("“日暮途穷”只有幽凝山中人才可以用！\n");


  if ((int)me->query("max_force") < 600)
    return notify_fail("你的内力修为还不够高！\n");

  if ((int)me->query("force") < 200)
    return notify_fail("你现在的内力不足！\n");

  if (skill < 100)
    return notify_fail("你的基本锤法功还不行! \n");

  if (skill2 < 90)
    return notify_fail("基本功还不行! \n");

  if (me->query_skill_mapped("hammer") != "fengri-hammer")
    return notify_fail("无法使用「日暮途穷」！\n");

  /*
        if (skill<60 && me->query_str()>100)
        {
                msg = HIY "$N运气于丹田，游走于双掌，$N双手紧握"+weapon->name()+NOR+HIY"大喝一声“分”，只见"+weapon->name()+NOR+HIY"分成双锤。
                \n"HIC"$N眼望苍天，神采奕奕，口呼：“日暮途穷你奈何”，$N掌心运力，其中一锤霎时间被震的粉碎向$n飞去。
                \n"HIY"无数碎锤片铺天盖地向$n飞射而去。\n\n"NOR;
                message_vision(msg, me, target);
                ob = me->query_temp("weapon");
                         
        if( (string)weapon->query("id")!="xiao liuxing hammer")
                destruct(ob);
 
                ap = ((me->query("combat_exp"))*(me->query_spi()));
                dp = ((target->query("combat_exp"))*(target->query_spi()))/2;

                if( dp < 1 )
                        dp = 1;
                if( random(ap) > dp )
                {
                        msg = HIR "$n面前仿佛无数流星，惊愕之下，无数碎片已然打在了$n的身上，\n\n$n痛苦之极，浑身无一处不流出丝丝鲜血。\n\n"NOR;
                        message_vision(msg, me, target);
                        kee_wound = 80 + skill + random(skill*2);

                        if(kee_wound > target->query("kee")) kee_wound = (target->query("kee") + 1);
                        target->add("kee", -kee_wound);
                        target->add("eff_kee", -(kee_wound/4));
                        COMBAT_D->report_status(target, 0);
                        me->start_busy(1+random(2));
                        me->add("force",-110);
                }
                else
                {
                        msg = HIG "可$n无所畏惧，腾空而起，躲过了这片流星般的碎片。\n\n"NOR;
                        message_vision(msg, me, target);
                        me->start_busy(3);
                        me->add("force",-100);
                }

                call_out("perform_xiaohammer", 10, me);
                return 1;
        }
        else if(skill<180 && me->query_str()<100 )
        {
                msg = HIW "$N$N运气于丹田，游走于双掌，$N双手紧握"+weapon->name()+NOR+HIY"大喝一声“分”，
                \n却不料心生杂念，力道不够，居然没有震碎手中"+weapon->query("name")+HIW"。\n" NOR;
                msg += HIR "$n见到$N此状，立感精神为之一振。\n\n";
                message_vision(msg, me, target);
                me->add("force",-50);
                me->start_busy(1+random(2));
        }
*/
  else {
    msg = HIY "$N抬起左手指向$n，脚步慢慢加快，成迅雷不及掩耳之势围绕$n旋转起来。
\n" HIC "霎时间$N似雷火、似狂风、似闪电的迅猛一般腾空而起。
\n\n" HIC "$N手持" + weapon->query("name") + HIC "牵带着空中雾、云、风形成一道巨大的屏障遮住了$n周围的一切。
\n\n" HIW "          ==== 日月经天，江河行地，“日暮途穷你奈何 ...” ====
\n\n" HIY "此时的一切早已在这" + HIR "无形、缥缈" + HIY "的幻界之中，万物生灵早已形成" + HIM "“无可奈何花落去”" + HIY "之势。\n\n" NOR;
    message_vision(msg, me, target);

    ap = ((me->query("combat_exp")) * (me->query_spi()));
    dp = ((target->query("combat_exp")) * (target->query_spi())) / 2;

    if (dp < 1)
      dp = 1;
    if (random(ap) > dp / 4) {
      msg = HIR "$n在这黑暗的幻界早已迷失了自己、迷失了生存的希望，万分感慨油然而生！\n$n无可奈何之下，减慢脚步。\n\n" NOR;
      message_vision(msg, me, target);
      kee_wound = 80 + skill + random(skill * 2);

      if (kee_wound > target->query("kee")) kee_wound = (target->query("kee") + 1);
      target->add("kee", -kee_wound);
      target->add("eff_kee", -(kee_wound / 4));
      COMBAT_D->report_status(target, 0);
      me->start_busy(1 + random(2));
      me->add("force", -150);
    } else {
      msg = HIG "$n对着周围发生的一切无所用心，冷笑一声，加快脚步离开了这里！\n\n" NOR;
      message_vision(msg, me, target);
      me->start_busy(2);
      me->add("force", -100);
    }

    return 1;
  }

  return 1;
}
int perform_xiaohammer(object me) {
  object weapon, target;
  target = me->select_opponent();
  if (me->is_fighting() && living(target) && living(me) && (!objectp(weapon = me->query_temp("weapon")))) {
    object xiaohammer;
    string msg;
    int count;
    xiaohammer = new("/d/youning/obj/xiaohammer");
    xiaohammer->move(me);
    xiaohammer->wield();
    count = me->query_spi();
    me->add_temp("apply/dodge", count * 3);
    count = me->query_str();
    me->add_temp("str", count * 2);
    msg = HIY "\n$N容光焕发，心无杂念，“日月经天，江河行地”之气势顿增。\n手中小流星锤，耍的酣畅淋漓。\n\n" NOR;
    message_vision(msg, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
    me->delete_temp("apply/dodge", count * 3);
    me->delete_temp("str", count * 2);
  }
  return 1;
}
