#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  object weapon;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展这一招「修身心，悟禅道」？\n");

  if (!me->is_fighting())
    return notify_fail("「修身心，悟禅道」只能在战斗中使用！\n");
  if (me->query("family/family_name") != "南海普陀山")
    return notify_fail("「修身心，悟禅道」只有佛门中人才可以用！\n");

  if ((int)me->query("force") < 500)
    return notify_fail("你的内力不够！\n");

  if ((int)me->query("kee") < 300)
    return notify_fail("你的气血不足，没法子施用外功！\n");

  if ((int)me->query_skill("buddha-stick", 1) < 210)
    return notify_fail("你的释厄棍法级别还不够，使用这一招会有困难！\n");
  if ((int)me->query("bellicosity") > 250)
    return notify_fail("你的杀气太重，无法渡出菩萨心肠。\n");

  if (me->query_skill("lotusforce", 1) < 210)
    return notify_fail("你的内功底子不足，无法领悟出佛门「修身心，悟禅道」。\n");

  if ((string)me->query_skill_mapped("force") != "lotusforce")
    return notify_fail("「修身心，悟禅道」必须以莲台心法为底子。\n");

  if (me->query("family/family_name") != "南海普陀山")
    return notify_fail("不是佛门弟子用了此招数有损真气！\n");

  if (me->query("bonze/class") != "bonze")
    return notify_fail("你没有出家，怎么能领悟其中真谛？\n");

  if (me->query("class") != "bonze")
    return notify_fail("归依我佛门，方可领悟其中真髓。\n");

  if ((string)me->query_skill_mapped("spells") != "buddhism")
    return notify_fail("佛门必须以佛法为中心，你要多加修行。\n");

  if ((int)me->query_skill("buddhism", 1) < 210)
    return notify_fail("佛门以大成为上乘法术，你修行太差，不足以。\n");


  me->delete("env/brief_message");

  message_vision("\n$N盘膝而座，口中有词曰：“不应生住法心。不应生住非法心。不应生有所住心。\n", me);
  message_vision("\n\n所有一切众生类摄。若卵生若胎生若湿生若化生。何以故。若心有住则为非住故。\n", me);
  message_vision("\n\n若有色若无色。若有想若无想。若非有想若非无想。乃至众生界及假名说。善哉．．善哉．．．”\n\n", me);

  target->start_busy(1);
  me->set_temp("buddha_per", 6);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

  me->delete_temp("buddha_per");

  me->receive_damage("kee", 50);
  me->add("force", -150);

  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
  }

  me->start_busy(2 + random(1));
  return 1;
}
