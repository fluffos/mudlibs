#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  object weapon;
  string str;
  int qinghu, jiuyin, ini_damage_apply, times, damage;
  string desc_msg = "";
  int sword_level;

  qinghu = (int)me->query_skill("qinghu-jian", 1);
  jiuyin = (int)me->query_skill("jiuyin-force", 1);

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁用「疾·打风刃」？\n");

  if (!me->is_fighting())
    return notify_fail("「疾·打风刃」只能在战斗中使用！\n");


  sword_level = (int)(qinghu / 50);
  if (qinghu < 60)
    return notify_fail("你的青狐剑法级别还不够，使用这一招会有困难！\n");

  if (me->query("family/family_name") != "轩辕古墓")
    return notify_fail("[疾·打风刃]是古墓之密！\n");

  if (jiuyin < 60)
    return notify_fail("你的九阴真经修为不够，不能用[疾·打风刃]！\n");


  if (me->query("force_factor") > 0)
    return notify_fail("当心疾风变暴风，把你吹跑了！\n");

  if (time() - (int)me->query_temp("ji_end") < 10)
    return notify_fail("你没有召唤出疾风！\n");
  if (sword_level <= 1) desc_msg = ""; else
    desc_msg = chinese_number(sword_level);
  if (sword_level > 9) desc_msg = "";
  ini_damage_apply = me->query_temp("apply/damage");

  message_vision(HIW "
$N你双手握剑，大喝一声“疾·打风刃”霎时风起云涌，
一道道风刃平地而起，卷向$n。\n" NOR, me, target);
  damage = 1;
  //前三剑
  message_vision(HIC "\n
$N利剑一挥，三道风刃闪电般卷向$n。\n" NOR, me, target);

  me->set_temp("WX_perform", 5);
  damage = COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

  if (damage < 1) me->add_temp("apply/damage", 30);
  me->set_temp("WX_perform", 0);
  damage = COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

  if (damage < 1) { me->add_temp("apply/damage", 30); } else {
    me->set_temp("apply/damage", ini_damage_apply);
  }
  me->set_temp("WX_perform", 6);
  damage = COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

  //再两剑
  if (qinghu > 99 && jiuyin > 99) {
    message_vision(HIC "\n
$N回身又是一剑，两道风刃从脚下飞了过去\n" NOR, me);

    if (damage < 1) { me->add_temp("apply/damage", 30); } else {
      me->set_temp("apply/damage", ini_damage_apply);
    }
    me->set_temp("WX_perform", 7);
    damage = COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

    if (damage < 1) { me->add_temp("apply/damage", 30); } else {
      me->set_temp("apply/damage", ini_damage_apply);
    }
    me->set_temp("WX_perform", 8);
    damage = COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  }

  //最后两剑
  if (qinghu > 149 && jiuyin > 149) {
    message_vision(HIC "\n
$N未等招式用老，一个纵跳，空中又是一剑，风刃削向$n的脑袋。\n" NOR, me, target);

    if (damage < 1) { me->add_temp("apply/damage", 30); } else {
      me->set_temp("apply/damage", ini_damage_apply);
    }
    me->set_temp("WX_perform", 9);
    damage = COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

    if (damage < 1) { me->add_temp("apply/damage", 90); } else {
      me->set_temp("apply/damage", ini_damage_apply);
    }
    me->set_temp("WX_perform", 10);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

    if (target->query("eff_kee") < 0 || !living(target)) {
      str = target->name() + "被" + me->name() + "用古墓绝招「疾·打风刃」杀死了。听说尸体上有" + desc_msg + "十多道深可见骨的伤痕！";
      //                     message("channel:rumor",HIM"【空穴来风】某人："+str+"\n"NOR,users());
    }
  }

  me->delete_temp("WX_perform");
  me->set_temp("apply/damage", ini_damage_apply);


  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
  }

  me->set_temp("ji_end", time());
  return 1;
}
