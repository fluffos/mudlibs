#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int extra;
  object weapon;
  if (extra = me->query_skill("zizhi-blade", 1) < 100) return notify_fail("你的紫雉刀法还不够纯熟！\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［玲珑连环］只能对战斗中的对手使用。\n");
  weapon = me->query_temp("weapon");
  message_vision(HIG "\n$N刀势突转使出玄天紫雉刀的绝学--玲珑连环！！\n" NOR, me, target);
  message_vision(HIW "第一招----风玲珑，$N手中的" + weapon->name() + "如一阵疾风般攻向$n！" NOR, me, target);
  target->strat_busy(1);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  message_vision(HIC "\n第二招——花玲珑，$N手中的" + weapon->name() + "连刺五刀如一朵盛放的梅花！" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg
  );
  message_vision(HIW "\n
第三招——雪玲珑！$N手中的" + weapon->name() + "突闪一道寒光，如片片雪花！" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg
  );
  message_vision(HIC "\n
第四招——月玲珑！$N手中的" + weapon->name() + "从上至下，之劈下来，犹如一轮弯月！" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg
  );
  me->start_busy(2 + random(2));
  return 1;
}
