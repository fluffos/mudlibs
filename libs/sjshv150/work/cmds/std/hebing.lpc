// hebing.c   
  
#include <ansi.h>    
inherit F_CLEAN_UP;  

int main(object me, string arg)  
{  
                        
        object *ob_list, *ilist;                                           // 合并的所有物品                          
        object obj,base,lev_ob;                     // 生成的物品  
        int i,k,j;            
        
        if (!arg )  
                return notify_fail("你要合并什么物品？\n");  
 
        if ( arg=="baoshi" )  
                return notify_fail("你要合并什么宝石？\n");   
        if (me->is_busy())  
                return notify_fail("先忙完了你的事情再做这件事情吧！\n");
                
        if(me->query("balance")< 10000000)
                return notify_fail("你的存款不够。\n");  

        if (me->is_fighting())  
                return notify_fail("你现在正在打架，没时间做这些事情。\n"); 
        if (!( base=present (arg,me))) 
                return notify_fail("你身上没有这个物品。\n"); 
        if (!base->query("b_lvl")) 
                return notify_fail("你身上这个物品不能融合。\n"); 
        i=base->query("b_lvl");
        if (me->query("max_sen") < 1500)  
                return notify_fail("你现在的精力修为有限，无"  
                                   "法施展如此艰深的法力。\n");  
           
        if (me->query("sen") < 1000)  
                return notify_fail("你现在精神不济，无法施展法力。\n");  
                
        if(arg=="hong baoshi" || arg=="green baoshi"){         
                ilist = all_inventory(me); 
                if (!ilist) 
                        return notify_fail("你身上没有任何物品。\n"); 
                k=0; 
                j = sizeof(ilist); 
                while (j--) { 
                        if( ilist[j]->query("jz_mark") || ilist[j]->query("lev_ob") ) 
                                k++;
                        else
                                continue; 
                } 
                if(k < 2) 
                        return notify_fail("目前你还没收集到足够的物品用来合并出新东西。\n");  
                if( random(100)>15 ){
                        obj=new("/d/quest/newdomain/obj/passport1");                            
                        k=4; 
                        ilist = all_inventory(me); 
                        base = present(arg, me); 
                        for (j = 0; j<5; j++) {
                                if( ilist[j]->query("jz_mark")==1 || ilist[j]->query("lev_ob")==1 ) 
                                        destruct(ilist[j]);     
                                obj->move(me);                                                          
                        }
                                destruct(base);   
                                me->add("balance",-1000000);     
                }       
        }
        else if( i>7 && i<15 ){
                ilist = all_inventory(me); 
                if (!ilist) 
                        return notify_fail("你身上没有任何物品。\n"); 
                k=0; 
                j = sizeof(ilist); 
                while (j--) { 
                        if( ilist[j]->query("jz_mark")==2 || ilist[j]->query("lev_ob")==2 ) 
                                k++;
                        else
                                continue; 
                } 
                if(k < 2) 
                        return notify_fail("目前你还没收集到足够的物品用来合并出新东西。\n");  
                if( random(100)>40 ){
                        obj=new("/d/quest/newdomain/obj/passport2");            
                        k=4; 
                        ilist = all_inventory(me); 
                        base = present(arg, me); 
                        for (j = 0; j<5; j++) {
                                if( ilist[j]->query("jz_mark")==2 || ilist[j]->query("lev_ob")==2 ) 
                                        destruct(ilist[j]);   
                                obj->move(me);   
                        }              
                        destruct(base);
                        me->add("balance",-1500000);     
                }      
        }
        else if( i>14 && i<22 ){
                ilist = all_inventory(me); 
                if (!ilist) 
                        return notify_fail("你身上没有任何物品。\n"); 
                k=0; 
                j = sizeof(ilist); 
                while (j--) { 
                        if( ilist[j]->query("jz_mark")==3 || ilist[j]->query("lev_ob")==3 )
                                k++;
                        else  
                                continue; 
                } 
                if(k < 2) 
                        return notify_fail("目前你还没收集到足够的物品用来合并出新东西。\n");  
                if( random(100)>65 ){
                        obj=new("/d/quest/newdomain/obj/passport3");            
                        k=4; 
                        ilist = all_inventory(me); 
                        base = present(arg, me); 
                        for (j = 0; j<5; j++) {
                                if( ilist[j]->query("jz_mark")==3 || ilist[j]->query("lev_ob")==3 ) 
                                        destruct(ilist[j]);   
                                obj->move(me);   
                        }              
                        destruct(base);
                        me->add("balance",-3000000);                                                     
                }    
        }
        else if( i>21 ){
                ilist = all_inventory(me); 
                if (!ilist) 
                        return notify_fail("你身上没有任何物品。\n"); 
                k=0; 
                j = sizeof(ilist); 
                while (j--) { 
                        if( ilist[j]->query("jz_mark")==4 || ilist[j]->query("lev_ob")==4 )
                                k++;
                        else  
                                continue; 
                }              
                if(k < 2) 
                        return notify_fail("目前你还没收集到足够的物品用来合并出新东西。\n");  
                if( random(100)>90 ){
                        obj=new("/d/quest/newdomain/obj/passport4");            
                        k=4; 
                        ilist = all_inventory(me); 
                        base = present(arg, me); 
                        for (j = 0; j<5; j++) {
                                if( ilist[j]->query("jz_mark")==4 || ilist[j]->query("lev_ob")==4 )
                                        destruct(ilist[j]);   
                                obj->move(me);   
                        }              
                        destruct(base);
                        me->add("balance",-10000000);   
                }       
        }               
        message_vision(HIM "$N将一些物品摆在一起，默运神通使它们变化。\n" NOR, me);  
        ilist = all_inventory(me); 
        j = sizeof(ilist); 
        while (j--) { 
                if( ilist[j]->query("pass_level") ) 
                        k++;
                else
                        continue; 
        } 
        if(k > 0) { 
                message_vision(HIW "数道光芒闪过，似乎发生了不同寻常的事情。\n" NOR, me);  
                tell_object(me, HIC "你利用手头的物品创造了探险通行证！\n" NOR);  
        }
        else { 
                message_vision(HIG "过了半天，似乎没有任何变化，$N一脸悻悻。\n", me);  
                base = present(arg, me); 
                destruct(base);
        }             
        me->start_busy(4);  
        me->add("sen", -500);  
        return 1;          
}  
  
int help(object me)  
{  
write(@HELP  
指令格式 : combins1 <特殊物品>  
  
这个指令可以让你将某些特殊物品合并成一种新的物品，哪些才能合  
并？这就要靠你去发掘了。每次合并都会损失一些精力的上限。

HELP  
    );  
    return 1;  
}  

