#include "/doc/help.h"
#include <ansi.h>

inherit F_CLEAN_UP;

string JAIL="/d/city/kezhan";
int help(object me);

int main(object me, string arg)
{
        int online;
	object who, env;

	seteuid(geteuid(me));

        if (!arg) return notify_fail("你想要将谁送回客栈？\n");
	arg=replace_string(arg,"#"," ");
	arg=replace_string(arg,"."," ");

	who=find_player(arg);
	if(who) { //player online now.
	    online=1;
            if ( !who->query("punished") && !is_root(me) )
             return notify_fail("这个人没有被囚禁呀！。\n");
	    if(env=environment(who))
		message_vision("天空中探出一只大手将$N抓起来不见了。\n",
			who);
message("channel:chat",HIW"【监督频道】通告："HIY+who->query("name")+"("+arg+")"+HIW"被巫师"HIY+me->name(1)+HIW"用神力送回了南城客栈！\n"NOR, users()); 
	    who->move(JAIL);
            if(who->query("punished")) who->delete("punished");
	} else {
	    who=new(USER_OB);
	    who->set("id",arg);
	    if(!who->restore()) {
		write("没有"+arg+"这个玩家或文件出错。\n");
		if(who) destruct(who);
		return 1;
	    }
	    online=0;
	}
	
	who->set("startroom",JAIL);
	who->save(1);
        log_file("cmds/to_kezhan","["+ctime(time())+"]"+
		this_player()->query("id")+" send "+who->query("id")+
                " to kezhan.\n");
        write("你将"+who->query("name")+"("+arg+")送回了南城客栈。\n");

	if(!online) {
	    destruct(who);
	} 

	return 1;
}

int help(object me)
{
write(@HELP
指令格式：tokz id 

Send <id> to xyj kz.
HELP
    );
    return 1;
}
