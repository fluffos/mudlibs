// time.c
// By mudring@sjsh

#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  int i, ii, t;
  object ob;

  seteuid(getuid(me));

  if (!arg) ob = me;
  else if (wizardp(me)) {
    ob = present(arg, environment(me));
    if (!ob) ob = find_player(arg);
    if (!ob) ob = find_living(arg);
    if (!ob) return notify_fail("您要察看谁的状态？\n");
  } else return notify_fail("只有巫师才可以察看别人的状态。\n");


  if (ob->query("mud_age") == ob->query_temp("temp_mud_age"))
    ob->add("mud_age", 1);

  i = (ob->query("combat_exp") - ob->query_temp("temp_combat_exp")) * 60 / (ob->query("mud_age") - ob->query_temp("temp_mud_age"));

  ii = (ob->query("daoxing") - ob->query_temp("temp_daoxing")) * 60 / (ob->query("mud_age") - ob->query_temp("temp_mud_age"));

  t = (time() - ob->query_temp("temp_time")) / 60;
  write("现在是" HIY "三界神话" HIG "「紫藤」分站" NOR + NATURE_D->game_time() + "。\n");
  write(ob->name(1) + "这次已经连续玩了" + chinese_number(t / 60) + "小时" + chinese_number(t % 60) + "分钟。\n");
  write(ob->name(1) + "上次经验：" + ob->query_temp("temp_combat_exp") + ",现在经验：" + ob->query("combat_exp") + ",平均：" + i + "/min。\n");
  write(ob->name(1) + "上次道行：" + ob->query_temp("temp_daoxing") + ",现在道行：" + ob->query("daoxing") + ",平均：" + i + "/min。\n");

  return 1;

}

int help(object me) {
  write(@HELP
指令格式: time

这个指令让你(你)知道现在的时辰。

HELP
  );
  return 1;
}
