#include <ansi.h>
#include <mudlib.h>
inherit F_CLEAN_UP;
string query_time(int time);

string *mission;
//      "(wordeditor)", //文字编辑员    (Word editor)                     
//      "(devplaner)",  //发展策划员    (Development planer)              
//      "(areapro)",           //区域制作员     (Area production)                 
//      "(syspro)",             //系统制作员    (System production)               

int level(mixed, mixed);
string get_mission( string );
void create() { seteuid( getuid() ); }

int main(object me, string arg)
{
        string *list, hood = "", str, msg, scr, jobmsg, att,time_msg;
        int adm_n, arc_n, wiz_n, apr_n, imm_n, eld_n,mas_n, vit_n, j, k,inv=0;
        object ob,body;
       int freeze_time;        

        mission = explode(read_file(color_filter("/adm/etc/wizmission")), "\n");

        list = sort_array(SECURITY_D->query_wizlist(1), (: level :));
        list = filter_array(list, "filter_adm");
        str = HIR"★ "HIW+INTERMUD_NAME+"管理组成员： \n"NOR; 
        str +=HIC"≡≡"HIB"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"HIC
"≡≡\n"NOR;
        str +=WHT"   系统级别             ID      名字      状       态          工作动向说明 \n"NOR;
        str +=HIB"───────────────────────────────────────────\n"NOR;
        for(int i=0; i<sizeof(list); i++) {
                        switch (wizhood(list[i])) { 
                                case "(admin)": adm_n++;break;
                                case "(arch)":  arc_n++;break;
                                case "(wizard)":        wiz_n++ ;break;
                                case "(apprentice)":    apr_n++;break;
                                case "(immortal)":      imm_n++;break;
                                case "(elder)":eld_n++;break;
//                              case "(webedit)":mas_n++;break;
                        }
        }

        for(int i=0; i<sizeof(list); i++) {
                if (hood != wizhood(list[i])) {
                        hood = wizhood(list[i]);
                        switch (hood) { 
                                case "(admin)": msg =HIW"〖 总管巫师 〗"NOR;k=adm_n;break;
                                case "(arch)":  msg =HIC"〖 开发巫师 〗"NOR;k=arc_n;break;
                                case "(wizard)":        msg =HIG"〖 维护巫师 〗"NOR;k=wiz_n ;break;
                                case "(apprentice)":    msg =HIM"〖 管理巫师 〗"NOR;k=apr_n;break;
                                case "(immortal)":      msg =HIY"〖 实习巫师 〗"NOR;k=imm_n;break;
                                case "(elder)":msg =HIR"〖 在习巫师 〗"NOR;k=eld_n;break;
//                              case "(webedit)":msg =WHT"〖 网页主管 〗"NOR;k=mas_n;break;
                                }
                        j=1;
                } else {
                        msg="";
                        j++;
                }
                if ( k == 1) scr=WHT"━━━━"NOR;
                else scr=WHT"━━┳━"NOR;
/*
                switch (jobhood(list[i]) ) { 
                        case "(libpro)":        jobmsg =WHT" 地层开发 "NOR;break;
                        case "(syspro)":        jobmsg =YEL" 系统制作 "NOR;break;
                        case "(areapro)":       jobmsg =RED" 区域开发 "NOR;break;
                        case "(wordeditor)": jobmsg =BLU" 文字编辑 "NOR;break;
                        case "(none)":  jobmsg =GRN" -------- "NOR;break;
                }
*/
                if ( k!=j && k!=1 && j!=1 ) scr=WHT"  ┣━"NOR;
                if ( k==j && k!=1 && j!=1 )     scr=WHT"  ┗━"NOR;

                inv=0;
                ob=new(LOGIN_OB);
                ob->set("id", list[i]);
                ob->restore();

                if(objectp(body=find_player(list[i])) && !body->query("env/invisibility")) {
                     //By waiwai@2001/07/06
                     if(interactive(body) && (query_idle(body)) > 300 )
                     att=sprintf(HIM"在线：已发呆%5d 秒钟"NOR,query_idle(body))+"";
                                     else
                        if (!interactive(body)) att=HIR"在线：断线中．．．    "NOR;
                     else
                        if (this_player()->visible(body)) 
                        att=HIG"在线："+query_time(body->query_temp("temp_time"))+"";
                str += sprintf("%-16s%s "YEL"%-9s%-9s"NOR"%-29s %-14s \n",msg, scr, list[i],body->name(1), 
//                        att, jobmsg, get_mission( list[i] ));
                        att, get_mission( list[i] ));
                     inv=1;
                } else {att="离线："+query_time(ob->query("last_on"))+"";
                str += sprintf("%-16s%s "YEL"%-9s%-9s"NOR"%-22s %-14s \n",msg, scr, list[i],ob->query("name"), 
//                        att, jobmsg, get_mission( list[i] ));
                        att, color_filter(get_mission( list[i] )));

                destruct(ob);
                inv=0;}
        }
        str +=HIB"───────────────────────────────────────────\n"NOR;
        str += HIR"★ "HIW+INTERMUD_NAME+HIC" 目前共有 " + sizeof(list) + " 位维护管理巫师。\n"NOR; 
        
        me->start_more(str);
        return 1;
}

int level(mixed ob1, mixed ob2)
{
        if (wiz_level(ob1) != wiz_level(ob2))
                return wiz_level(ob2) - wiz_level(ob1);
        return ob1 < ob2?-1:1;
}

string get_mission( string wiz)
{
        int i;
        string wname,wmin;
        for(i=0; i<sizeof(mission); i++) {
                if( mission[i][0]=='#' || sscanf(mission[i], "%s %s",
                        wname, wmin)!=2 ) continue;
                if(wname==wiz) return wmin;
        }
//              if ( jobhood(wiz)=="(none)" )   return GRN" ---------- "NOR;
                return CYN"[任务未定]"NOR;
}

//By waiwai@2001/04/15 added.
string query_time(int time)
{
        string msg;
        int day, hour, min;
        
        time=time()-time;
        
        msg="";
        day=time/86400;
        hour=time%86400/3600;
        min=time/60%60;

        if(min<1)
                min=1;
        if(day)
                msg+=sprintf("%s天", chinese_number(day));
        if(day<10 && hour)
                msg+=sprintf("%s小时", chinese_number(hour));
        if(!day && hour<20 && min )
                msg+=sprintf("%s分", chinese_number(min));

        return msg;
}

// added by mudring@sjsh......
int filter_adm(string arg)
{
if (arg=="koker") return 0;
if (wizhood(arg) == "(admin)") return 1;
if (wizhood(arg) == "(arch)") return 1;
return 0;
}

int help(object me)
{
write(@HELP

指令格式 : wizlist

用途 : 列出目前三界神话巫师组成员系统级别以及当前工作分配状态。

HELP
     );
     return 1;
}

