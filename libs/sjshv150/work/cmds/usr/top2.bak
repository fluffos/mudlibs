
/*
*/
inherit F_SAVE
inherit F_CLEAN_UP

mapping *list = ({}) 

int remove()
void add_list(object ob)
int get_score(object ob)

string query_save_file()
{
        return "/open/topten"
}
// 大家经常在程序中能看到这个吧？
// 嘿嘿，搜索一下找找看，就知道它是干什么的了。
// 有用啊。
int remove()
{
        save()
        return 1
}
// 这个函数是在别的程序中调用的，用来去掉一些 ID 的资料
int remove_id(string id)
{       
        int i
        for( i = 0 ; i < sizeof(list) ; i++ ) {
                if( list[i]["id"] == id ) {
                        list -= ({ list[i] })
                        write(CYN"成功移除 " + HIG + id + CYN" 的资料。\n")
                        break
                        }
        }       
        save()
        return 1
}
void create()
{       
        seteuid(getuid())
        restore()
}
int sort_user(mapping user1, mapping user2)
{
        return user2["score"]-user1["score"]
}
void add_list(object ob)
{
        int i,t
        mapping my = ob->query_entire_dbase()
        mapping list1
                
        for( t = 0 ; t < sizeof(list) ; t++ ) {
                reset_eval_cost()
                if( list[t]["id"] == my["id"] || 
                file_size("/data/user/" + list[t]["id"][0..0] 
                + "/" + list[t]["id"] + ".o") < 1 
                 )
                list -= ({ list[t] })
        }
        // 这个判断本来是在上面的,不过考虑到,如果把一个player
        // 升成wiz后,他的数据还会在top里,所以把这个判断放到了
        // 后面,这样的话,不管他是不是巫师都会先删掉以前的数据
        // 然后重新处理
        if (wiz_level(ob)) return
        list1 = (
                "id"                    :       my["id"],
                "name"                  :       my["name"],
                "family_name"   :       (mapp(my["family"])?(my["family"]["family_name"]?my["family"]["family_name"]:"普通百姓"):"普通百姓"),
                "score"                 :       get_score(ob),
                ])
        list += ({ list1 })
        list = sort_array( list, (: sort_user :))
        // 为了免得整个.o的数据量太大,反正最多就是100个player
        // 所以就取到了一百
        list = list[0..99]
        save()
}                       
int main(object ob,string arg)
{
        string msg
        int i,t
        object obj
        // 当list为空时
        if( sizeof(list) < 1 ) 
                foreach ( obj in users()) 
                        add_list(obj)
        
        add_list(ob)
        
        if( !arg ) {
                if( sizeof(list) >= 10 ) i = 10
                if( sizeof(list) < 10 ) i = sizeof(list)
                }
        else {
                if( sscanf(arg,"%d",i) != 1 ) i = 10 
                if( i > 100 ) i = 100
                if( i < 10 ) i = 10
                if( i > sizeof(list) ) i = sizeof(list)
        }

        msg="\n            ┏━━  游戏高手排行榜  ━━┓   \n"
        msg +="┏━━━━┯┻━━━━━━━━━┯━━━┻┯━━━━┓\n"
    msg +="┃ 名  次 │    高        手    │ 门  派 │ 评  价 ┃\n"
    msg +="┠────┴──────────┴────┴────┨\n"

    for( t = 0 ; t < i ; t++ ) {
        if( list[t]["id"] == ob->query("id") ) msg += HBBLU + HIW
    msg +=sprintf("┃ %|6s    %8s%-10s   %|8s %|8d ┃\n"NOR,
        chinese_number(t+1),
        list[t]["name"],
        "(" + list[t]["id"] + ")",
        list[t]["family_name"],
        list[t]["score"])
    
    }

        msg +="┗━━━━━━━━━━━━━━━━━━━━━━━━━┛"
        ob->start_more(msg)

        return 1
}
int get_score(object ob)
{
        // 这个地方要大家自己改了,反正是算top值的地方
        // 如果不会改的话,那么就改成
        // return "/cmds/usr/score.c"->get_score(ob)
        // 大概如此吧,具体情况应该看看自己的MudLib了
        return SCORED->get_score(ob)
}

