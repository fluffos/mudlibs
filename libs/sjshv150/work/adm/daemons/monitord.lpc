#pragma optimize

#include <ansi.h>
#include <localtime.h>

inherit F_DBASE;

void create()
{
        seteuid(getuid());
        set("channel_id", "监控精灵");
}

void report_system_msg (string msg)
{
        mixed lt = localtime(time());
        CHANNEL_D->do_channel(this_object(), "sys", msg);
        log_file("player/sys/"+lt[LT_YEAR]+"-"+lt[LT_MON]+"-"+lt[LT_MDAY],
                "["+ctime(time())[11..18]+"] "+msg+"\n");
}

void report_system_object_msg (object ob, string msg)
{
        mixed lt = localtime(time());
        CHANNEL_D->do_channel(this_object(), "sys",
                ob->name() + "(" + capitalize(ob->query("id")) + ")" + msg);
       log_file("player/mon/"+lt[LT_YEAR]+"-"+lt[LT_MON]+"-"+lt[LT_MDAY],
                "["+ctime(time())[11..18]+"] "+ob->name()+"("+capitalize(ob->query("id"))+")"+msg+"\n");
}

void report_quest_object_msg (object ob, string msg)
{
        mixed lt = localtime(time());
        CHANNEL_D->do_channel(this_object(), "qst",
                ob->name() + "(" + capitalize(ob->query("id")) + ")" + msg);
        log_file("player/job/"+lt[LT_YEAR]+"-"+lt[LT_MON]+"-"+lt[LT_MDAY],
                "["+ctime(time())[11..18]+"] "+ob->name()+"("+capitalize(ob->query("id"))+")"+msg+"\n");
}
void report_rumor_object_msg(object ob, string msg)
{
        CHANNEL_D->do_channel(this_object(), "rumor","听说"+
                ob->name(1) + msg);
}

void report_adm_object_msg (object ob, string msg)
{
        CHANNEL_D->do_channel(this_object(), "adm",
                ob->name(1) + "(" + capitalize(ob->query("id")) + ")" + msg);
}
void report_log_object_msg (object ob, string msg, string files)
{
        mixed lt = localtime(time());
        log_file("player/job/"+files+"/"+lt[LT_YEAR]+"-"+lt[LT_MON]+"-"+lt[LT_MDAY],
                "["+ctime(time())[11..18]+"] "+ob->name()+"("+capitalize(ob->query("id"))+")"+msg+"\n");
}

