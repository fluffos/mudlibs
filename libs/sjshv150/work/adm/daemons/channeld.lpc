                        "only"     : "wiz",
                        "name"     : "任务监控",
                        "omit_log" : 1,
                ]),

        "err":  ([      "msg_speak": HIR "【错误】%s：%s\n" NOR,
                        "msg_color": HIR,
                        "only"     : "wiz",
                        "name"     : "错误",
                        "omit_log" : 1,
                ]),

        "adm":  ([      "msg_speak": WHT "【天神议事】%s：%s\n" NOR,
                        "msg_emote": WHT "【天神议事】%s" NOR,
                        "msg_color": WHT,
                        "only"     : "adm",
                        "name"     : "天神",
                        "omit_log" : 1,
