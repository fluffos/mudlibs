        "wiz":  ([      "msg_speak": HIY "【巫师】%s：%s\n" NOR,
                        "msg_emote": HIY "【巫师】%s" NOR,
                        "msg_color": HIY,
                        "name"     : "巫师",
                        "only"     : "wiz",
                        "omit_log" : 1,
                ]),


              "gwiz":  ([      "msg_speak": HIY "【网际巫师】%s：%s\n" NOR, 
                              "msg_emote": HIY "【网际巫师】%s" NOR, 
