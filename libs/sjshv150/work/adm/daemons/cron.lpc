#pragma optimize
#pragma save_binary
#define DEBUG 1

#define REBOOT_TIME 7
#include <ansi.h>
#include <command.h>
#include <globals.h>
#include <net/daemons.h>
#include <net/macros.h>

inherit F_DBASE;

nosave int LAST_HARD_DIS;
nosave int flag = 0;
nosave int line = 0;
// nosave int shutdown = 0;

void start_task();
void autosave();
void auto_clear();
void check_dns();
void check_nature();
void check_callouts();

int set_last_hard_dis();

void create()
{
        seteuid( ROOT_UID );
        set("channel_id", "三界精灵");
        CHANNEL_D->do_channel( this_object(), "sys", "三界精灵已经启动。\n"NOR);
        set_heart_beat(60);
        set_last_hard_dis();
}
int clean_up() { return 1;}
int query_last_hard_dis() {   return LAST_HARD_DIS;  }
int set_last_hard_dis()
{
        LAST_HARD_DIS = time();
        return flag;
}

private void heart_beat()
{
        call_out("start_task", 60);
}

void start_task()
{
        mixed *local;
        object npc;

        local = localtime(time());
        if ( !(local[1] % 7 )){
//              autosave();
                auto_clear();
#ifdef DEBUG
   CHANNEL_D->do_channel(this_object(), "debug","飞贼系统正常！！"); 
#endif
                "/d/npc/feizei.lpc"->choose_npc();
//              check_callouts();
        }
        if ( !(local[1] % 15 )){
#ifdef DEBUG
   CHANNEL_D->do_channel(this_object(), "debug","心魔系统正常！！");
#endif
                "/d/npc/choose.lpc"->choose_mpc();
        }
        if (local[1]==20 || local[1]==40 ){
                TASK_D->init_dynamic_quest();
// 58                  message("system",HIR"\n\n重新分布部分使命．．．．",users());
                message("system",HIR"\n\n重新分布部分使命．．．．"+HIG" ．．．部分使命分布完毕\n\n" NOR,users());
        }
        if (flag==1)
        {
/*
                DISASTER_D->disaster(0);
#ifdef DEBUG
   CHANNEL_D->do_channel(this_object(), "debug","浩劫系统正常！！"); 
#endif
*/
                TASK_D->init_dynamic_quest(1);
                flag=0; 
                set_last_hard_dis();
// 66                  message("system",HIR"\n\n重新分布所有使命．．．．"NOR,users());
                message("system",HIR"\n\n重新分布所有使命．．．．"+HIG" ．．．使命分布完毕\n\n" NOR,users());
                "/d/npc/qujing.lpc"->choose_npc();
        }
        if (local[1]==59 || ((int)time()-(int)query_last_hard_dis()) > 3720)
        {
                flag=1;
                message_system( HIR "所有使命将在一分钟后重新分布！！！   \n"NOR); 
/*
                TASK_D->init_y2k_quest();
                if(local[2]==REBOOT_TIME) {
                        if(local[6]!=6){
                                TASK_D->init_treasure();
                        CHANNEL_D->do_channel(this_object(), "wiz",BBLK+HIR"世纪宝藏"NOR+HIY"从新分布！\n\n"); 
                        }else{
                                npc = new("/obj/npc/demogorgon");
                                npc->move("/d/fy/church");
                                npc->start_shutdown();
                                npc->set("cmd_giver","系统自动");
                        }
                }
*/
        }
        if (local[1]==45 || local[1]==15 )
        {
// 95                  message_system( HIR "宝石系统重新分布！\n\n"NOR); 
#ifdef DEBUG
   CHANNEL_D->do_channel(this_object(), "debug","宝石系统正常！！"); 
#endif
                "/d/quest/baoshi/baoshid.lpc"->choose_baoshi();
        }
}
void autosave()
{
        object *users = users();
        message("system", HIR "\n 自动存档．．．", users());
        foreach(object user in users) 
                user->save();
        message("system", HIG "．．．存档完毕 \n" NOR, users());
}

void auto_clear()
{
        CHANNEL_D->do_channel( this_object(), "sys",
                sprintf("系统自动清除 " + reclaim_objects() + " 个变数。"));
        CHANNEL_D->do_channel( this_object(), "chat", 
                sprintf(HBBLU"三界神话主页:http://sanjie.0451.net"NOR)); 
//119          if (random(5)==1) rm("/log/debug.log"); //防止debug very big
}

void check_dns()
{
       mapping mud_list;
       mixed *muds;
       object dns;

       if(!dns = find_object(DNS_MASTER))
       // dns not started, not our problem
        return;
        mud_list = (mapping) DNS_MASTER->query_muds();
        muds=keys(mud_list);
        if(sizeof(muds)<= 1){ 
                destruct(dns);
                call_other(DNS_MASTER,"???");
        }
        return;
}
void check_nature()
{
       mixed *infos;
       object ob;
        int nature=0;

       infos = call_out_info();
       foreach(mixed info in infos){
                if( "/"+sprintf("%O",info[0]) == NATURE_D )
                        nature=1;
        }
        if(!nature){
                if(ob=find_object(NATURE_D)) destruct(ob);
                        call_other(NATURE_D,"???");
        }
        return;
}
void check_callouts()
{
        mixed *info;
        int i,f=0;
        string output;
        object *users, link_ob;

        info = call_out_info();
        for(i=0; i<sizeof(info); i++){
                if(info[i][2]<info[f][2]){
                        f=i;
                }
        }
        if(info[f][2] > -100) return;
        users = users();
        if( flag!=2 ){
                flag = 2;
                message_system( HIR"\n\n\n\n\n游戏出现故障，系统将在7分钟后重新启动。\n
游戏重启之前，不再另行通知。\n"NOR);
                output = sprintf("%-30O %-20s %d ",info[f][0], info[f][1],info[f][2]);
                log_file("CALLOUTS_ERR",output + ctime(time())+"\n");
                return;
        }
                message( "system", HIY"正在保存玩家数据中．．．  "NOR, users);
        foreach(object user in users){
                if( !environment(user) ) continue;
                user->save();
                link_ob = user->query_temp("link_ob");
                if( objectp(link_ob) ) link_ob->save();
        }
        // 保存所有的守护进程的数据
        reset_eval_cost();
        if (find_object(DNS_MASTER)) DNS_MASTER->send_shutdown();
/*
        if (find_object(FAMILY_D))   FAMILY_D->mud_shutdown();
        if (find_object(CLOSE_D))    CLOSE_D->mud_shutdown();
        if (find_object(DBASE_D))    DBASE_D->mud_shutdown();
*/
        log_file("nosave/CRASHES",sprintf("系统因为故障重新启动于%s\n",log_time()) );
        message( "system", HIY"  ．．．保存完毕\n"HIR"重新启动MudOS，请稍候一分钟再登录。\n\n"NOR, users);
        shutdown(0);
}

