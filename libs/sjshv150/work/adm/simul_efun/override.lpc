// By mudring@sjsh......

// override destruct
void destruct(object ob) {
  if (ob) {
    if (previous_object()) ob->remove(geteuid(previous_object()));
    else ob->remove(0);
    efun::destruct(ob);
  }
}

// override living
int living(object ob) {
  if (!ob) return 0;
  if (!ob->is_character() || ob->is_corpse()) return 0;
  if (ob && ob->query_temp("disabled"))
    return 0;
  return efun::living(ob);
}

// override efun:exec
nomask int exec(object target, object from) {
  if (!from || !target)
    return 0;

  if (!previous_object()) return 0;

  if (previous_object() != find_object(LOGIN_D) &&
    //	     previous_object() != find_object("/cmds/usr/quit") &&
    previous_object() != find_object("/cmds/wiz/update")) {
    log_file("nosave/security",
      sprintf("%s  %s(%s) want to exec (%s)%s to (%s)%s on %s.\n",
        ctime(time()),
        (string)base_name(previous_object()),
        (this_player(1) ? geteuid(this_player(1)) : "???"),
        (string)from->name(),
        (string)geteuid(from),
        (string)target->name(),
        (string)geteuid(target),
        ctime(time())));
    return 0;
  }

  from->remove_interactive();
  return efun::exec(target, from);
}

// override efun:shutdown
nomask varargs void shutdown(object who, int how) {
  if (!previous_object()) return 0;
  if (!who || !userp(who) || !wizardp(who))
    return 0;
  log_file("nosave/CRASHES", who->query("id") + " shutdown SJSH at " + ctime(time()) + "\n");
  foreach (object ob in previous_object(-1)) {
    if (wizardp(ob) && ob != who)
      log_file(
        "nosave/security",
        ob->name() + " seems to have something with the last shutdown.\n"
      );
  }
  return efun::shutdown(how);
}
