inherit ROOM;

void create()
{
        set("short", "Snow的雪屋");
        set("long", @LONG

一座用雪砖砌成的小屋。
    屋子里面干干净净,在正中有一个蒲团,天蓝色的雪正坐在上面苦思,仿佛没
意到注意到有人走了进来。
LONG
        );
     set("exits", ([ /* sizeof() == 2 */
     "north" : "/d/wiz/wizroom",
        "kz" : "/d/city/kezhan",
      ]));
     setup();
}

void init()
{
    if (this_player()->query("id") != "snow")
        message_vision("$N走了进来。\n", this_player());
    if (this_player()->query("id") != "snow")
        message_vision("天蓝色的雪抬起头,对着"+this_player()->name(1)+"点了点头,又埋首苦思去了。\n", this_player());
}

int clean_up()
{
    return 0;
}

