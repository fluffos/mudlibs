//  created by kuku  (礼物猫咪) 

inherit NPC;
#include <ansi.h>
int give_gift();

void create() {
  set_name(HIW "咪咪" NOR, ({ "mimi" }));
  set("age", 18);
  set("gender", "女性");
  set("title", HIW "小" HIR "宝" HIY "贝" NOR);
  set("long", "她本是飘梦最喜欢的小猫咪，守在飘梦的身边不离左右。这次为了庆贺新年，特奉飘梦的旨意下到凡间给大家分发礼物。\n");
  set("attitude", "peaceful");
  set("str", 50);
  set("per", 50);
  set("kar", 50);
  set("combat_exp", 20000000);
  set("daoxing", 20000000);
  set("max_force", 20000);
  set("max_mana", 20000);
  set("max_kee", 40000);
  set("max_sen", 40000);
  set("force", 40000);
  set("force_factor", 500);
  set("mana_factor", 500);
  set("mana", 8000);
  set("inquiry", ([
    "gift": (: give_gift :),
    "礼物": (: give_gift :),
  ]));
  setup();
  carry_object("/obj/loginload/skirt")->wear();
  carry_object("/obj/loginload/shoes")->wear();
}

int give_gift() {
  object ob;
  object who = this_player();
  object me = this_object();
  if (!who) return 0;
  if (who->query("combat_exp") < 200000 && (int)who->query("mud_age") < 18000) {
    message_vision("\n\n小宝贝对$N说道：你是大米吗？不是，我看挺象！\n\n" NOR, who);
    return 1;
  }
  if (who->query("lucky/newyear_time") && (who->query("lucky/newyear_time") + (24 * 60 * 60)) > time()) {
    message_vision("\n\n小宝贝疑惑的看着$N道：你刚拿了礼物，不可太贪喔，明天再来吧！\n\n" NOR, who);
    return 1;
  }
  message_vision(
    "\n\n小宝贝拱手贺道：" + HIR "节   " + HIY "日   " + BLU "快   " + HIG "乐   " + HIC "\n\n" + HIW "                万   " + HIB "事   " + HIC "如   " + HIM "意\n\n" NOR,
    who
  );
  ob = new("/d/wizz/liwu/obj/hongbao");
  ob->set("owner", who->query("id"));
  ob->move(who);
  ob->set("no_put", 1);
  who->set("lucky/newyear_time", time());
  message("channel:chat", HIR "【礼物精灵】小猫咪：" + who->query("name") + "得到了新年礼物，恭喜恭喜！\n" NOR, users());
  return 1;
}
