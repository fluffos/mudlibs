#include <ansi.h>
#include <combat.h>

inherit NPC;
int DEBUG=1; 
void create() { 
        set_name(HIY"小"HIR"宝"HIW"贝"NOR,({"cat","xiao"}));   
        set("long","一只活泼可爱的小猫咪，蓝眼睛，毛茸茸的，它是飘梦最喜欢的小东西。\n");
        set("gender","女性"); 
        set("title", HIW"超级大胖猫"NOR); 
        set("age",2);
        set("per",999); 
        set("str",30+random(10)); 
        set("cor",40); 
        set("cps",30); 
        set("max_sen",1000); 
        set("sen",1000); 
        set("max_kee",2000); 
        set("kee",2000); 
        set("max_mana",500); 
        set("combat_exp", 300); 
        set("daoxing",300); 
        setup(); 
        carry_object("/u/kuku/obj/maoyi")->wear(); 
}

void init() 
{
        object ob; 
        ob = this_player(); 
        ::init(); 
        if (userp(ob)) 
        remove_call_out("greeting"); 
        call_out("greeting", 1, ob); 
}

void greeting(object ob) 
{
        if( !ob || environment(ob) != environment() ) return; 
        if(!userp(ob)) return; 
        if(ob->query("id")=="kuku")  
        {
            command("jump kuku");  
            command("cat kuku");
        }
       else 
        {
            command("cat");
        }
}
