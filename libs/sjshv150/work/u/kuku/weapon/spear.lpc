#include <weapon.h>
inherit SPEAR;
#include "equip.h"

void setname() 
{ 
        int i; 
        string name,id; 
        string * tmp_lists;
        tmp_lists=keys(equip_prefixs); 
        i=random(sizeof(tmp_lists)); 
        name=tmp_lists[i]; 
        id=equip_prefixs[tmp_lists[i]]; 
        id+=" "; 
        switch(random(4)){
                case 0: name = name+("短枪");
                        break;
                case 1: name = name+("枪");
                        break;
                case 2: name = name+("长枪");
                        break;
                case 3: name = name+("火尖枪");
                default: break;
        }
        set_name(HIB+name+NOR, ({id + "spear","spear"}));                   
} 

void create()
{
        setname(); 
        set_weight(5500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "杆");
                set("long", "一杆精钢打制的枪。\n");
                set("value", 5000);
                set("material", "steel");
                set("wield_msg", "$N提起$n握在手中，威风凛凛。\n");
                set("unwield_msg", "$N舞了一朵枪花，将手中之物收了起来。\n");                
                if(random(20)>10)
                        set("weapon_prop/kee",200+random(500));
                if(random(10)>6)
                        add("weapon_prop/dodge",10+random(10));
                if(random(10)<2)
                        add("weapon_prop/spiritual",3);
        }
        init_spear(40+random(60));
        setup();
}

void init()
{
        add_action("do_wield","wield");
}

int do_wield(string arg) 
{  
        object ob = this_object();
        object me = this_player();
        if(arg == ob->query("id") || arg == "spear" ){
                if(me->query("level")<5){
                        write("你的等级不够，无法装备这件兵器。\n");
                        return 1;
                }  
        }   
        return 0;  
}
