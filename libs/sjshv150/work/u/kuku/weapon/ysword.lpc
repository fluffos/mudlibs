#include <weapon.h>
inherit SWORD;
#include "equip.h"

void setname() {
  int i;
  string name, id;
  string *tmp_lists;
  tmp_lists = keys(equip_prefixs);
  i = random(sizeof(tmp_lists));
  name = tmp_lists[i];
  id = equip_prefixs[tmp_lists[i]];
  id += " ";
  switch (random(4)) {
    case 0: name = name + ("剑");
    break;
    case 1: name = name + ("长剑");
    break;
    case 2: name = name + ("短剑");
    break;
    case 3: name = name + ("细剑");
    default: break;
  }
  set_name(HIY + name + NOR, ({ id + "sword", "sword" }));
}

void create() {
  setname();
  set_weight(6000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "一柄镇妖降魔的宝剑。\n");
    set("value", 10000);
    set("material", "gold");
    set("wield_msg", "$n「唰」地从剑鞘中弹出，落入$N的手中，剑尖还兀自闪个不停。\n");
    set("unwield_msg", "$N将手中的$n插入腰间，脸色更加阴沉了。\n");
    if (random(20) > 10)
      set("weapon_prop/sen", 200 + random(500));
    if (random(10) > 6)
      add("weapon_prop/attack", 10 + random(10));
    if (random(10) < 2)
      add("weapon_prop/constitution", 3);
    if (random(20) > 15)
      set("weapon_prop/force", 10 + random(10));
    if (random(10) > 8)
      add("weapon_prop/parry", 10 + random(10));
  }
  init_sword(100 + random(60));
  setup();
}

void init() {
  add_action("do_wield", "wield");
}

int do_wield(string arg) {
  object ob = this_object();
  object me = this_player();
  if (arg == ob->query("id") || arg == "sword") {
    if (me->query("level") < 50) {
      write("你的等级不够，无法装备这件兵器。\n");
      return 1;
    }
  }
  return 0;
}
