#include <weapon.h>
inherit FORK;
#include "equip.h"

void setname() 
{ 
        int i; 
        string name,id; 
        string * tmp_lists;
        tmp_lists=keys(equip_prefixs); 
        i=random(sizeof(tmp_lists)); 
        name=tmp_lists[i]; 
        id=equip_prefixs[tmp_lists[i]]; 
        id+=" "; 
        switch(random(2)){
                case 0: name = name+("叉");
                        break;
                case 1: name = name+("九股叉");
                default: break;
        }
        set_name(HIB+name+NOR, ({id + "fork","fork"}));                   
} 

void create()
{
        setname(); 
        set_weight(6000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long", "一柄锋利的钢叉。\n");
                set("value", 5000);
                set("material", "steel");
                set("wield_msg", "$N抄起一柄$n，还拿衣服擦了擦叉尖。\n");
                set("unwield_msg", "$N放下手中的$n。\n");                
                if(random(20)>10)
                        set("weapon_prop/force",10+random(10));
                if(random(10)>6)
                        add("weapon_prop/parry",10+random(10));
                if(random(10)<2)
                        add("weapon_prop/strength",3);
        }
        init_fork(40+random(60));
        setup();
}

void init()
{
        add_action("do_wield","wield");
}

int do_wield(string arg) 
{  
        object ob = this_object();
        object me = this_player();
        if(arg == ob->query("id") || arg == "fork" ){
                if(me->query("level")<5){
                        write("你的等级不够，无法装备这件兵器。\n");
                        return 1;
                }  
        }   
        return 0;  
}   
