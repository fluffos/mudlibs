#include <weapon.h>
inherit BLADE;
#include "equip.h"

void setname() {
  int i;
  string name, id;
  string *tmp_lists;
  tmp_lists = keys(equip_prefixs);
  i = random(sizeof(tmp_lists));
  name = tmp_lists[i];
  id = equip_prefixs[tmp_lists[i]];
  id += " ";
  switch (random(3)) {
    case 0: name = name + ("弯刀");
    break;
    case 1: name = name + ("刀");
    break;
    case 2: name = name + ("短刀");
    default: break;
  }
  set_name(HIB + name + NOR, ({ id + "blade", "blade" }));
}

void create() {
  setname();
  set_weight(4000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "一把寒光闪闪的圆头长刀，刀把上镶嵌有白玉。\n");
    set("value", 5000);
    set("material", "steel");
    set("wield_msg", "$N「唰」地一声抽出一把$n握在手中，顿时一股寒气扑面而来！\n");
    set("unwield_msg", "$N将手中的$n插入刀鞘。\n");
    if (random(20) > 10)
      set("weapon_prop/kee", 200 + random(500));
    if (random(10) < 2)
      add("weapon_prop/intelligence", 3);
  }
  init_blade(40 + random(60));
  if (random(10) > 6)
    add("weapon_prop/damage", this_object()->query("weapon_prop/damage") / 2);
  setup();
}

void init() {
  add_action("do_wield", "wield");
}

int do_wield(string arg) {
  object ob = this_object();
  object me = this_player();
  if (arg == ob->query("id") || arg == "blade") {
    if (me->query("level") < 5) {
      write("你的等级不够，无法装备这件兵器。\n");
      return 1;
    }
  }
  return 0;
}
