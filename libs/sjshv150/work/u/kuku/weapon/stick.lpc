#include <weapon.h>
inherit STICK;
#include "equip.h"

void setname() 
{ 
        int i; 
        string name,id; 
        string * tmp_lists;
        tmp_lists=keys(equip_prefixs); 
        i=random(sizeof(tmp_lists)); 
        name=tmp_lists[i]; 
        id=equip_prefixs[tmp_lists[i]]; 
        id+=" "; 
        switch(random(3)){
                case 0: name = name+("棍");
                        break;
                case 1: name = name+("短棍");
                        break;
                case 2: name = name+("巨棍");
                default: break;
        }
        set_name(HIB+name+NOR, ({id + "stick","stick"}));                   
} 

void create()
{
        setname(); 
        set_weight(7000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "根");
                set("long", "一根淡青色的棒子，上面有暗红流动，如同一条火蛇般绕在棒上。。\n");
                set("value", 5000);
                set("material", "iron");
                set("wield_msg", "$N「呼」地一声抽出一把$n握在手中！\n");
                set("unwield_msg", "$N放下手中的$n。\n");                
                if(random(20)>10)
                        set("weapon_prop/spells",10+random(10));
                if(random(10)>6)
                        add("weapon_prop/dodge",10+random(10));
                if(random(10)<2)
                        add("weapon_prop/spiritual",3);
        }
        init_stick(40+random(60));
        setup();
}

void init()
{
        add_action("do_wield","wield");
}

int do_wield(string arg) 
{  
        object ob = this_object();
        object me = this_player();
        if(arg == ob->query("id") || arg == "stick" ){
                if(me->query("level")<5){
                        write("你的等级不够，无法装备这件兵器。\n");
                        return 1;
                }  
        }   
        return 0;  
}   
