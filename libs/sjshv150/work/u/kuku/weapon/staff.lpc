#include <weapon.h>
inherit STAFF;
#include "equip.h"

void setname() 
{ 
        int i; 
        string name,id; 
        string * tmp_lists;
        tmp_lists=keys(equip_prefixs); 
        i=random(sizeof(tmp_lists)); 
        name=tmp_lists[i]; 
        id=equip_prefixs[tmp_lists[i]]; 
        id+=" "; 
        switch(random(2)){
                case 0: name = name+("杖");
                        break;
                case 1: name = name+("禅杖");
                default: break;
        }
        set_name(HIB+name+NOR, ({id + "staff","staff"}));                   
} 

void create()
{
        setname(); 
        set_weight(9500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "根");
                set("long", "这是一根沉重的钢制的杖，打造的相当坚实。\n");
                set("value", 5000);
                set("material", "steel");
                set("wield_msg", "$N抽出一把$n握在手中。\n");
                set("unwield_msg", "$N将手中的$n插入腰后。\n");                
                if(random(20)>10)
                        set("weapon_prop/sen", 200+random(500));                
                if(random(10)<2)
                        add("weapon_prop/intelligence",3);
        }
        init_staff(40+random(60));
        if(random(10)>6)
                add("weapon_prop/damage",this_object()->query("weapon_prop/damage")/2);
        setup();
}

void init()
{
        add_action("do_wield","wield");
}

int do_wield(string arg) 
{  
        object ob = this_object();
        object me = this_player();
        if(arg == ob->query("id") || arg == "staff" ){
                if(me->query("level")<5){
                        write("你的等级不够，无法装备这件兵器。\n");
                        return 1;
                }  
        }   
        return 0;  
}
