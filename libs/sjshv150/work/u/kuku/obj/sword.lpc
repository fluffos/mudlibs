//edited by plum

#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create() {
  set_name(HBRED "天下无双" NOR, ({ "wushuang", "sword", "jian" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long",
      "一只古剑,剑柄上刻有" + MAG "天下" NOR + HIG "无双" NOR + "的字样.\n"
      "剑身隐有红色霞光流动,看起来是一柄神兵利器.\n");
    set("no_drop", "这么好的宝物，为什么要扔掉呢？\n");
    set("no_give", "这么好的宝物，给别人? \n");
    set("no_sell", 1);
    set("no_get", 1);
    set("value", 90000);
    set("material", "blacksteel");
    set("wield_msg", HIB "\n一道眩目的" HIR "红" HIB "色剑光闪过," HIW "天下无双" HIB "已落入$N的手中.\n\n" NOR);
    set("unwield_msg", HIC "\n$N一声长啸,宝剑瞬然不见.\n\n" NOR);
  }
  init_sword(200);
  setup();
}
int query_autoload() { return 1; }
