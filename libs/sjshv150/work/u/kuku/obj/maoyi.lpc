#include <ansi.h>
#include <armor.h>
inherit CLOTH;

void create()
{
        set_name(HIR"保暖"HIW"毛衣"NOR, ({ "mao yi", "cloth" }) );
        set_weight(0); 
        if( clonep() ) 
        set_default_object(__FILE__); 
        else {  
            set("long", "一件颜色鲜艳，穿在身上非常舒适的保暖外套，是飘梦为她的小
宝贝精心编制的小毛衣。\n"); 
        set("unit", "件"); 
        set("value", 200000); 
        set("material", "cloth"); 
        set("armor_prop/armor", 1); 
        set("armor_prop/personality", 5); 
        }
        setup();
}
