// created by kuku@sjsh 2002.12
// 宝物.灵鸟

#include <ansi.h>
inherit ITEM;
inherit F_AUTOLOAD;
private int checking(object me);

void create() {
  set_name(HIM "灵" HIW "鸟" NOR, ({ "ling niao", "niao" }));
  set_weight(500);
  set("long", "此为世间少有的宝物，带着它能帮你驱凶辟邪，好处多多。\n");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("no_sell", 1);
    set("value", 0);
    set("no_give", 1);
    set("no_put", 1);
    set("no_get", 1);
    set("no_drop", 1);
    set("no_steal", 1);
    set("unit", "只");
  }
  setup();
}

void destruct_me() {
  object me = this_object();
  object who = this_player();
  message_vision(HIW "天空中一颗流星滑过。$N突然说道：主人，世间又有灾难降生了，我要去寻找新的需要帮助的人，有缘再见吧。\n" NOR, me);
  message_vision("刚说完，$N就震翅高飞，逐渐消失在远处的天边。\n", me);
  destruct(me);
  who->delete("lingniao");
}

void init() {
  object me = this_object();
  object who = this_player();
  object where = environment();
  if (!me->query("my_owner") && interactive(who))
    me->set("my_owner", who->query("id"));
  if (userp(where)) {
    if (me->query("owned")) {
      if (me->query("owned") != where->query("id")) {
        call_out("destruct_me", 1);
      }
    } else {
      me->set("owned", where->query("id"));
    }
  }
  if (me) {
    where->add_temp("apply/attack", where->query_temp("apply/attack") * 20 / 100);
  }
  add_action("do_heal", "huifu");
}

int do_heal() {
  object me = this_object();
  object who = this_player();
  object where = environment();
  if (!where->is_fighting())
    return notify_fail("你并没在战斗中。\n");
  if (where->query("lingniao/heal_number") >= 500) {
    if (random(1500) > 750)
      call_out("destruct_me", 1);
  }
  if (where) {
    if (where->query("kee") < where->query("max_kee") || where->query("sen") < where->query("max_sen") || where->query("eff_kee") < where->query("max_kee") || where->query("eff_sen") < where->query("max_sen")) {
      checking(me);
    }
  }
  return 1;
}

private int checking(object me) {
  object where = environment();
  int damage;

  if (damage < 0)
    damage = 0;
  if (damage > 0)
    damage -= damage * 20 / 100;
  where->receive_damage("kee", damage);
  where->receive_damage("sen", damage);
  if (where->query("eff_kee") <= where->query("max_kee") * 70 / 100)
    where->receive_curing("kee", (int)where->query("max_kee") * 30 / 100);
  if (where->query("eff_sen") <= where->query("max_sen") * 70 / 100)
    where->receive_curing("sen", (int)where->query("max_sen") * 30 / 100);
  tell_room(
    environment(where),
    "" + me->query("name") + HIR "张开双翼，顿时一道无形的光环笼罩在" + where->query("name") + "周围。奇怪的是，" + where->query("name") + "立刻感觉到身上的疼痛减轻了许多。\n" NOR
  );
  where->add("lingniao/heal_number", 1);
  return 1;
}

int query_autoload() { return 1; }
