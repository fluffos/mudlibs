//cracked by stey
//H_MAGIC_ITEM
#include <dbase.h> 
#include <move.h> 
#include <name.h> 

 
inherit COMBINED_ITEM; 
void cast(object me, object target); 
int do_play(string arg); 
int do_sure(string arg); 
 
void setup() 
{ 
        seteuid(getuid()); 
} 
 
init () 
{ 
  add_action("do_play", "scrollcast"); 

} 
 

 
int do_play(string arg) 
{ 
        string id,trg; 
        int remain; 
         object target; 
         object ob=this_object(); 
         object me=this_player(); 
 
 
        if (!arg) 
           return notify_fail("命令格式： scrollcast <id> at <target>\n"); 
 
          if (sscanf(arg,"%s at %s",id,trg)==2) {
           
         if(id!=ob->query("id")) { 
                tell_object(me,ob->query("long")); 
                return 1;} 
 
                target = present(trg, environment(me));
         
              if( !target )    return notify_fail("这里没有 " + trg + "。\n"); 
 
        if( target=me && target->is_fight()) 
 
              return notify_fail("你的攻击目标不对或则不在战斗中。\n"); 
        if( me->is_busy() ) 
                return notify_fail("你正忙着呢。\n"); 
        if( environment(me)->query("no_magic") || environment(me)->query("no_fight") ) 
                return notify_fail("这里不能使用魔法咒。\n"); 
 
        if( (int)me->query("mana") < 500 ) 
                return notify_fail("你的法力不够。\n"); 
        if( (int)me->query("sen") < 200 ) 
                return notify_fail("你现在神智不清。\n"); 
 
 
 
                  call_out("cast",0,me,target); 
 
            remain = ob->query_amount() -1;
             ob->set_amount(remain); 
                  if(remain <=0 ) destruct(ob);
                   return 1;  
            }
             return notify_fail("命令格式： scrollcast <id> at <target>\n"); 
                 
} 
 
 
 
 
 
object offensive_target(object me)  
{  
        int sz;  
        object *enemy;  
        object victim;  
  
        // mon 4/28/99  
        // clean_up my enemy before selecting a target.  
        me->clean_up_enemy();  
  
        enemy = me->query_enemy();  
        if( !enemy || !arrayp(enemy) ) return 0;  
  
        sz = sizeof(enemy);  
        if( sz > 4 ) sz = 4;  
  
        if( sz > 0 ) victim=enemy[random(sz)];  
        else return 0;  
          
        if(!victim) return 0;  
        if( victim->query_temp("netdead") )   {  
            if( member_array( me, victim->query_netdead_enemy() ) == -1 )  
                return 0; // can't start fight if the   
                        //victim is already netdead  
        }  
  
        return victim;  
}  

