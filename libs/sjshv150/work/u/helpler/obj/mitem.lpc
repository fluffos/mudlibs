//Cracked by Roath
// item.c

#include <dbase.h>
#include <move.h>
#include <name.h>

inherit F_CLEAN_UP;
inherit F_DBASE;
inherit F_MOVE;
inherit F_NAME;

int cast(object me, object target);

void setup()
{
        seteuid(getuid());
}

init ()
{
  add_action ("do_play", "scollcast");
  add_action ("do_sure", "analyse");
}

int do_sure()
{
      object me=this_player();
      object ob=this_object();
      int t;
      if (ob->query("sure"))
      {
        tell_object(me,ob->query("long")+ob->query("sp_long"));
        return 1;}
      if (ob->query("do_sure_id"))
      {
        tell_object(me,ob->query("long"));
        return 1;}
        if(wizardp(me) && me->query("hell_type")=="精灵族"
                       && me->query("hell_type")=="魔法师"
                       && me->query("hell_type")=="终结者")
        { 
                if( me->query("hell_type")=="精灵族") t=10;
                if( me->query("hell_type")=="魔法师") t=50;
                if( me->query("hell_type")=="终结者") t=75;
                
                if(random(100)>10 && wizardp(me))
                {
                        tell_object(me,ob->query("long")+ob->query("sp_long"));
                         ob->set("long",ob->query("long")+ob->query("sp_long"));
                         ob->set("id",ob->query("sp_id"));
                         ob->set("name",ob->query("sp_name"));
                         ob->set("sure",1);
                         
                }
                else
                 {tell_object(me,"魔法咒分析失败。\n");}
                 ob->set("do_sure_id",me->query("id"));
                 
        
             return 1;
}       

int do_play(string arg)
{ 
        string id,trg;
        int remain;
         object target;  
         object ob=this_object();
         object me=this_player();
         
         
        if(!ob->query("sure"))
         {
        tell_object(me,ob->query("long"));
        return 1;}
        
        if (!arg)   return notify_fail(@LONG  
         命令格式： scrollcast <id> at <target>         LONG);
         
          if (sscanf(arg,"%s at %d",id,trg)!=2)   return notify_fail(@LONG  
         命令格式： scrollcast <id> at <target>         LONG);
         if(id!=ob->query("id")) {
                tell_object(me,ob->query("long"));
                return 1;}
                  
                 target=present(target, environment(me)); 
   
        if( !target ) target = present(trg, me);  
             
              if( !target )    return notify_fail("这里没有 " + trg + "。\n"); 
 
        if( target=me && target->is_fight(me)) 
         
              return notify_fail("你的攻击目标不对或则不在战斗中。\n"); 
        if( me->is_busy() )  
                return notify_fail("你正忙着呢"。\n");  
        if( environment(me)->query("no_magic") || environment(me)->query("no_fight") )  
                return notify_fail("这里不能使用魔法咒。\n");  
         
        if( (int)me->query("mana") < 500 )  
                return notify_fail("你的法力不够。\n");  
        if( (int)me->query("sen") < 200 )  
                return notify_fail("你现在神智不清。\n");  
  
         if( userp(target) ||  
                    target->query_temp("netdead") ) 
                   return notify_fail("对方正在断线中，不能对其施法。\n"); 
                  
                  cast(me,target);
                  
            remain = ob->query_amount() -1;
                  if(remain <=0 ) destruct(ob);
                  else    ob->set_amount(remain); 
                  return 1;
}
