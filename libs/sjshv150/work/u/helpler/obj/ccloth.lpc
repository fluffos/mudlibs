#include <armor.h> 
#include <ansi.h> 
 
inherit CLOTH; 
 
inherit F_AUTOLOAD; 
void create() 
{ 
        set_name(HIY"沙滩背心"NOR, ({ "yanyang cloth", "cloth" }) ); 
        set("long","一件飞舞在大闹天宫所穿的神衣。"); 
        set_weight(1000); 
        if( clonep() ) 
                set_default_object(__FILE__); 
        else { 
                set("unit", "件"); 
                set("value", 2000); 
                set("material", "cloth"); 
                set("armor_prop/spells", 60); 
                set("armor_prop/dodge", 60); 
                set("armor_prop/armor", 90); 
        } 
        setup(); 
} 
string rdm(string *strs) 
{
return strs[random(sizeof(strs))]; 
} 
void init ()   
{    
  add_action ("do_wear", "chuan"); 
//
  add_action ("do_qu", "qu"); 
 
} 
int do_wear(string arg)
{
     object ob =this_object();
     object me =this_player();
     string str;
 string *color = ({ 
    RED, GRN, YEL, MAG, BLU, CYN, WHT, 
    HIR, HIG, HIY, HIB, HIM, HIC, HIW, });  
 string *nam = ({ 
    "热火", "火焰", "蓝心","艳阳" ,"月亮","水晶","灿烂", 
    "可人","美艳","动人","翡翠","钻石","可爱","明媚", });  
  string *namt = ({ 
    "礼服","背心","短背心","比肩尼","晚衣","套装","大衣", });         
             if (arg !=ob->query("id"))
             { me->command_function("wear "+arg);return 1;}
             if(ob->query("equipped"))
             return notify_fail("你已经穿着呢！\n");
             if(me->query("id")!="yanyang")
             return notify_fail("这是艳阳的专用的衣服！\n");
             str=rdm(color)+rdm(nam)+rdm(namt)+NOR;
            ob->set_name(str,({ "yanyang cloth", "cloth" }) );
         message_vision("$N穿上了一件"+ob->query("name")+"。\n",me);
         ob->wear();
       return 1;
}
int query_autoload() { return 1; } 
int do_qu(string arg)
{

     int num; 
  object cash,me; 
      me=this_player();
//
       if (me->query("id")!="yanyang")
             return notify_fail("这是艳阳的专用的！\n");
        if (!arg)
             return notify_fail("qu xx cash\n");
//
  if(sscanf(arg, "%d cash",num)!=1)   
             return notify_fail("qu xx cash\n");
        if (num <0 || num >5000)
             return notify_fail("qu xx(1-5000） cash\n");
       cash=new("/obj/money/cash");
           cash->set_amount(num);
    cash->move(me);
      tell_object(me,"你等到了"+num+"张cash\n");
     return 1;
}
