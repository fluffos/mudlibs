#include <ansi.h>
#include <dbase.h>


inherit COMBINED_ITEM; 

void create()
{
  set_name(HIW "魔法咒" NOR, ({ "magic scroll","scroll"}));
  set_weight(100);
          if( clonep() ) 
                 set_default_object(__FILE__); 
         else { 
                  set("long",HIY"这是一个具有特别魔法的魔法咒。\n"NOR); 
                 set("unit", "卷"); 
                 set("base_unit", "张"); 
                 set("base_weight", 5); 
                 set("value", 3); 
         } 

  set_amount(1);
  setup();
  
}

init () 
{ 
 
  add_action("do_sure", "analyse");
  add_action("do_sure", "fengxi");  
} 

int do_sure(string arg) 
{     object newob;
      object me=this_player(); 
      object ob=this_object(); 
      int  j,k,t,remain; 
      mixed*  file;
      string id_name; 

      if(arg !=ob->query("id")) 
      return notify_fail("你要证实什么魔法卷。\n"); 
      if (ob->query("sure")) 
      { 
        tell_object(me,ob->query("long")+ob->query("sp_long")); 
        return 1;} 
      if (ob->query("do_sure_id")) 
      { 
        tell_object(me,ob->query("long")); 
        return 1;} 
        
       if(  me->query("hell_type")!="精灵族" 
                       && me->query("hell_type")!="魔法师" 
                       && me->query("hell_type")!="终结者") 
        return notify_fail("你不具有分析魔法卷的先天能力。\n"); 
               t=95;
                if( me->query("hell_type")=="精灵族") t=10; 
                if( me->query("hell_type")=="魔法师") t=50; 
                if( me->query("hell_type")=="终结者") t=75; 
                
                if(random(100)>t) 
                { 
                         file = get_dir("/d/hellfire/magic/*.lpc", -1 ); 
                              if( !sizeof(file) ) return 0; 

     for(k=0;k<50;k++) { // try 50 times 
        j = random(sizeof(file)); 
        if( file[j][1] > 0 )  { 
          newob=new("/d/hellfire/magic/"+file[j][0]); 
          if(!newob) continue; 
          id_name = newob->query("id"); 
          if(!id_name){ destruct(newob); continue; }
          if(newob->move(me)) {
           tell_object(me,"你念起自身魔力，揭开魔法封咒，发现原来是"+newob->query("name")+"魔法咒。\n"); 
        CHANNEL_D->do_channel( this_object(), "sys", me->query("id")+"得到了"+"("+newob->query("name")+newob->query("id")+")。");  
                   remain = ob->query_amount() -1; 
                     ob->set_amount(remain); 
                  if(remain <=0 ) destruct(ob); 
               
                  return 1;  
                              }
                 
                               } 
                        } 
                        
                tell_object(me,"你念起自身魔力，解析魔法咒失败了。\n");
 
                } 
                else 
                 {tell_object(me,"你念起自身魔力，解析魔法咒失败了。\n");} 
                 
                 
           
            remain = ob->query_amount() -1;
            ob->set_amount(remain);  
                  if(remain <=0 ) destruct(ob); 
            
                  return 1; 
 
       
        
} 
 
