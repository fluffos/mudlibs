#include <ansi.h>
#include <dbase.h>
#include <skill.h>
inherit COMBINED_ITEM;


void create() {
  set_name(HIW "寒冰魔法咒" NOR, ({ "ice scroll", "" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", HIY "这是一个具有水系特别魔法的魔法咒,召唤寒冰攻击的魔法咒。\n" NOR);
    set("unit", "卷");
    set("base_unit", "张");
    set("base_weight", 5);
    set("value", 3);
    set("magic_type", "water");
  }

  //魔法系
  set_amount(1);
  setup();

}
void init() {

  object me = this_object();
  object where = environment();
  /* 
  if (userp(where)) 
  { 
    if (me->query("owned")!=where->query("id")) 
    {           
        call_out("destruct_me",1,where,me);       
    } 
 
 */

}



void invocation(object who) {
  int i, a, b, c;

  a = who->query("daoxing");
  b = (int)who->query_skill("spells") * (int)who->query_skill("spells") * (int)who->query_skill("spells");
  c = (int)who->query("mana_factor") * (int)who->query("mana_factor") * (int)who->query("mana_factor");
  i = a + b + c;

  this_object()->set("ap", i);
  return;
}
int ji_ob(object target) {
  object seal = this_object();
  object me = this_player();
  object where = environment(me);

  int damage, ap, dp, remain;

  if (me->is_busy())
    return notify_fail("你正忙着呢，无法施放寒冰魔法咒。\n");
  if (!target)
    return notify_fail("你想施放的人不在这里。\n");
  if (where->query("no_magic"))
    return notify_fail("这里不能施放寒冰魔法咒。\n");
  if (!me->is_fighting())
    return notify_fail("只有战斗中才能施放寒冰魔法咒。\n");
  if ((int)me->query("mana") < 100)
    return notify_fail("你的法力不能控制寒冰魔法咒。\n");
  if ((int)me->query("sen") < 100)
    return notify_fail("你的精神不足，很难驾驭寒冰魔法咒。\n");


  message_vision(HIC "\n$N大喊一声“着”，手一挥，施放出了一张$n。。。\n" NOR, me, seal);
  message_vision(HIC "$n「呼」地一下飞到半空，只见突起狂云，卷出一阵冰雨向$N袭去。\n" NOR, target, seal);



  ap = (int)seal->query("ap");
  dp = (int)target->query("daoxing") + (int)target->query("combat_exp");
  dp += (int)target->query_skill("dodge") * (int)target->query_skill("dodge") * (int)target->query_skill("dodge") * (int)target->query_kar() / 20;


  if (random(ap + dp) > dp) {

    damage = (int)me->query("max_mana") / 20 + random((int)me->query("eff_sen") / 15);
    damage -= (int)target->query("max_mana") / 20 + random((int)target->query("eff_sen") / 15);
    damage += (int)me->query("mana_factor") - random((int)target->query("mana_factor"));

    if (damage > 0) {
      message_vision(HIC "\n$N躲闪不及，被冰雨裹个正着，顿时成了个冰人。\n" NOR, target);
      target->start_busy(damage / 10);
    } else {
      message_vision(HIC "\n$N猛退几步，躲了过去。\n" NOR, target);
    }
  } else {
    message_vision(HIC "\n谁知被$N躲了过去。\n" NOR, target);
  }

  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else
        target->kill_ob(me);
    }
    me->kill_ob(target);
  }
  me->add("mana", -50);

  me->start_busy(2 + random(2));
  remain = seal->query_amount() - 1;
  seal->set_amount(remain);
  if (remain <= 0) destruct(seal);
  return 1;
}

int ji(string arg) {
  object seal = this_object();
  object me = this_player();
  string name, id;
  object target;
  name = seal->query("name");
  if (!arg)
    return notify_fail("你想对谁施放" + name + "？\n");
  if (sscanf(arg, "%s at %s", id, arg) == 2) {
    if (id != seal->query("id")) {
      tell_object(me, seal->query("long"));
      return 1;
    }
    target = present(arg, environment(me));
    seal->invocation(me);
    seal->ji_ob(target);
    return 1;
  }
  return notify_fail("命令格式： scrollcast <id> at <target>\n");
}
