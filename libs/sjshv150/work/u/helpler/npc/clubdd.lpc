int do_kill(string arg) {
  object who = this_player();
  object me = this_object();

  if (!arg || present(arg, environment(me)) != me) return 0;
  //allow kill others. mon 2/16/98

  message_vision("$N眼露凶光，看样子动了杀机！\n", who);
  call_out("no_kill", 1, who, me);
  return 1;
}

void no_kill(object who, object me) {
  message_vision("$N向$n摇了摇头。\n", me, who);
}

int accept_fight(object ob) {
  object me = this_object();

  message_vision("$N向$n摇了摇头：要挑战等一下再来！\n", me, ob);
  return notify_fail("看来你得再等一段时间了！\n");
}

int do_tiguan(string arg) {
  object who = this_player();
  object me = this_object();

  if (!userp(who)) {
    command("say 哪来的小猫小狗？");
    return 1;
  }
  me = this_object();
  if (geteuid(who) == me->query("clubdd/id")) {
    command("say 你是不是又迷糊了？");
    tell_object(who, "你已经是这里的老大了！\n");
    return_master();
    return 1;
  }
  if (!who->query("club")) {
    command("say 哪来的三教酒流也在这里混混？");
    message_vision("$N对$n喝道：滚！\n", who, me);
    who->move("/d/city/kezhan");
    return 1;
  }
  if (environment(me)->query("club") == who->query("club")) {
    command("hammer " + who->query("id"));
    message_vision("$N对$n喝道：没事找事干呀！\n", who, me);
    //              who->move("/d/city/kezhan");
    return 1;
  }
  who->kill_ob(me);
  me->kill_ob(who);
  me->set("kicker", who);
  who->set_temp("club_tiguan", me->query("id"));

  return 1;
}

void die() {
  object me, defier, who;

  me = this_object();
  defier = me->query("defier");
  who = this_player();
  /*
        if(!objectp(defier))
        {
                return_master();
                return;
        }
*/
  if (who == me->query("kicker") && who->query_temp("club_tiguan") == me->query("id")) {
    if (random(3) == 1) {
      who->set_temp("tiguan", environment(me));
      me->set("nick", HIR "无精打采的，受尽欺负的老大");
      command("say 好了！好了！！");
      command("say 我服！我服！！");
      fully_recover();
      me->save();
      //return_master();
      return;
    }
    command("heng " + who->query("id"));
    command("say 不服！继续来！");
    fully_recover();
    //return_master();
    return;
  }

  if (who == me->query("difier") && who->query_temp("club_fight") == me->query("id")) {
    if (random(1) != 0) {
      command("heng " + who->query("id"));
      command("say 不服！继续来！");
      fully_recover();
      //return_master();
      return;
    }
    check_result(me, defier);
  }

  return;
}

void unconcious() {
  die();
}

//
