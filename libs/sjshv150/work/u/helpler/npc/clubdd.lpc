#include <dbase.h>
#include <login.h>
#include <ansi.h>

#define clubdd_DIR DATA_DIR+"npc/clubdd/"

inherit NPC;
inherit F_SAVE;

void save_status(object me, object who, int flag);
void create_me();
void reset_me();
void start_challenge(object defier);
void check_result(object me, object defier);
void return_master();
string query_save_file();
int ask_chargehere();


void reset_me() {
  mapping skill_status, hp_status, map_status;
  string *lists, master_name, save_name;
  int i, weapon_cnt, armor_cnt;
  object *inv, master, me;

  if (!stringp(master_name = query("master")))
    return;
  if (!objectp(master = new(master_name)))
    return;
  save_name = query("save_name");
  me = this_object();

  me->set("sav_force", 0);
  me->set("max_force", 600);
  me->set("force", 2000);
  me->set("sav_mana", 0);
  me->set("max_mana", 2000);
  me->set("mana", 606);
  me->set("force_factor", 60);
  me->set("mana_factor", 60);
  me->set("combat_exp", 1000);
  me->set("wuxue_exp", 1000);
  me->set("daoxing", 1000);
  me->delete("clubdd");
  me->delete("object");
  if (mapp(map_status = me->query_skill_map())) {
    lists = keys(map_status);
    for (i = 0; i < sizeof(lists); i++) {
      me->map_skill(lists[i]);
    }
  }
  if (mapp(skill_status = me->query_skills())) {
    lists = keys(skill_status);
    for (i = 0; i < sizeof(lists); i++) {
      me->delete_skill(lists[i]);
    }
  }
  reset_eval_cost();
  hp_status = master->query_entire_dbase();
  lists = keys(hp_status);
  for (i = 0; i < sizeof(lists); i++)
    me->set(lists[i], hp_status[lists[i]]);

  delete("chat_chance_combat");
  delete("chat_msg_combat");

  if (mapp(skill_status = master->query_skills())) {
    lists = keys(skill_status);
    for (i = 0; i < sizeof(lists); i++) {
      me->set_skill(lists[i], skill_status[lists[i]]);
    }
  }
  if (mapp(map_status = master->query_skill_map())) {
    lists = keys(map_status);
    for (i = 0; i < sizeof(lists); i++) {
      me->map_skill(lists[i], map_status[lists[i]]);
    }
  }

  weapon_cnt = 0;
  armor_cnt = 0;
  inv = all_inventory(master);
  for (i = 0; i < sizeof(inv); i++) {
    if (weapon_cnt && armor_cnt)
      break;
    if (!inv[i]->query_unique() && inv[i]->query("skill_type") &&
      inv[i]->query("equipped") && !weapon_cnt) {
      me->set("object/weapon", base_name(inv[i]));
      weapon_cnt = 1;
    } else if (!inv[i]->query_unique() && !inv[i]->query("skill_type") &&
      inv[i]->query("equipped") && !armor_cnt) {
      me->set("object/armor", base_name(inv[i]));
      armor_cnt = 1;
    }
  }
  set("master", master_name);
  set("save_name", save_name);

  save();

  destruct(master);
  return;
}

void fully_recover() {
  int i;
  object weapon, armor, me, clubdd_player, *inv;
  string player_name;


  me = this_object();
  set("kee", query("max_kee"));
  set("eff_kee", query("max_kee"));
  set("sen", query("max_sen"));
  set("eff_sen", query("max_sen"));
  set("force", 2 * query("max_force"));
  set("sav_force", query("max_force"));
  set("mana", 2 * query("max_mana"));
  set("sav_mana", query("max_mana"));

  set("force_factor", me->query_skill("force") * 5 / 8);
  set("mana_factor", query("max_mana") / 20 + 1);

  if (query("clubdd")) {
    player_name = query("clubdd/id");
    if (clubdd_player = find_player(player_name))
      save_status(me, clubdd_player, 0);
    else if (clubdd_player = LOGIN_D->find_body(player_name))
      save_status(me, clubdd_player, 0);
    else {
      seteuid(player_name);
      clubdd_player = new(USER_OB);
      clubdd_player->set("id", player_name);
      if (!clubdd_player->restore()) {
        destruct(clubdd_player);
        return;
      }
      export_uid(clubdd_player);
      seteuid(getuid());
      clubdd_player->setup();
      if (clubdd_player->query("combat_exp") > me->query("combat_exp"))
        save_status(me, clubdd_player, 0);
      destruct(clubdd_player);
    }
  }
  inv = all_inventory(me);
  for (i = 0; i < sizeof(inv); i++)
    destruct(inv[i]);

  if (query("object/weapon")) {
    weapon = new(query("object/weapon"));
    if (weapon) {
      weapon->move(this_object());
      weapon->wield();
    }
  }
  if (query("object/armor")) {
    armor = new(query("object/armor"));
    if (armor) {
      armor->move(this_object());
      armor->wear();
    }
  }
  reset_action();
  return;
}

void save_status(object me, object who, int flag) {
  mapping skill_status, hp_status, map_status;
  int i, weapon_cnt, armor_cnt;
  object *inv, old_clubdd, clubdd_player;
  string *lists, clubdd_name;

  reset_eval_cost();
  hp_status = who->query_entire_dbase();

  me->set("str", hp_status["str"]);
  me->set("int", hp_status["int"]);
  me->set("con", hp_status["con"]);
  me->set("spi", hp_status["spi"]);
  me->set("cor", hp_status["cor"]);
  me->set("cps", hp_status["cps"]);
  me->set("per", hp_status["per"]);
  me->set("kar", hp_status["kar"]);

  me->set("max_kee", hp_status["max_kee"]);
  me->set("max_sen", hp_status["max_sen"]);
  me->set("max_force", hp_status["max_force"]);
  me->set("max_mana", hp_status["max_mana"]);
  me->set("combat_exp", hp_status["combat_exp"]);
  me->set("daoxing", hp_status["daoxing"]);
  me->set("gender", hp_status["gender"]);
  me->set("age", hp_status["age"]);

  if (mapp(map_status = me->query_skill_map())) {
    lists = keys(map_status);
    for (i = 0; i < sizeof(lists); i++) {
      me->map_skill(lists[i]);
    }
  }
  if (mapp(skill_status = me->query_skills())) {
    lists = keys(skill_status);
    for (i = 0; i < sizeof(lists); i++) {
      me->delete_skill(lists[i]);
    }
  }
  if (mapp(skill_status = who->query_skills())) {
    lists = keys(skill_status);
    for (i = 0; i < sizeof(lists); i++) {
      me->set_skill(lists[i], skill_status[lists[i]]);
    }
  }
  if (mapp(map_status = who->query_skill_map())) {
    lists = keys(map_status);
    for (i = 0; i < sizeof(lists); i++) {
      me->map_skill(lists[i], map_status[lists[i]]);
    }
  }

  if (flag) {
    if (who->query("clubdd")) {
      old_clubdd = new("/obj/npc/democlubdd");
      clubdd_name = who->query("clubdd/data_name");
      sscanf(clubdd_name, "/data/npc/clubdd/%s", clubdd_name);
      old_clubdd->set("save_name", clubdd_name);
      old_clubdd->set("master", who->query("clubdd/base_name"));
      old_clubdd->reset_me();
      destruct(old_clubdd);
    }
    if (me->query("clubdd")) {
      if (clubdd_player = find_player(query("clubdd/id"))) {
        clubdd_player->set("title", clubdd_player->query("clubdd/old_title"));
        if (clubdd_player->query("clubdd/family")
          != clubdd_player->query("family/family_name")) {
          if (clubdd_player->query("family/family_name"))

          {
            if (clubdd_player->query("club"))
              clubdd_player->set("title",
                sprintf("〖%s〗老大%s第%s代%s",
                  clubdd_player->query("club"),
                  clubdd_player->query("family/family_name"),
                  chinese_number(clubdd_player->query("family/generation")),
                  clubdd_player->query("family/title")));
            else
              clubdd_player->set("title",
                sprintf("%s第%s代%s",
                  clubdd_player->query("family/family_name"),
                  chinese_number(clubdd_player->query("family/generation")),
                  clubdd_player->query("family/title")));
          }
        }
      } else if (clubdd_player = LOGIN_D->find_body(query("clubdd/id"))) {
        clubdd_player->set("title", clubdd_player->query("clubdd/old_title"));
        if (clubdd_player->query("clubdd/family")
          != clubdd_player->query("family/family_name")) {
          if (clubdd_player->query("family/family_name"))

          {
            if (clubdd_player->query("club"))
              clubdd_player->set("title",
                sprintf("〖%s〗老大%s第%s代%s",
                  clubdd_player->query("club"),
                  clubdd_player->query("family/family_name"),
                  chinese_number(clubdd_player->query("family/generation")),
                  clubdd_player->query("family/title")));
            else
              clubdd_player->set("title",
                sprintf("%s第%s代%s",
                  clubdd_player->query("family/family_name"),
                  chinese_number(clubdd_player->query("family/generation")),
                  clubdd_player->query("family/title")));
          }
        }
      }
      clubdd_player->delete("clubdd");
      clubdd_player->save();
    }
    me->delete("obejct");
    me->delete("clubdd");
    who->delete("clubdd");
    weapon_cnt = 0;
    armor_cnt = 0;
    inv = all_inventory(who);
    for (i = 0; i < sizeof(inv); i++) {
      if (weapon_cnt && armor_cnt)
        break;
      if (!inv[i]->query_unique() && inv[i]->query("skill_type") &&
        inv[i]->query("equipped") && !weapon_cnt) {
        me->set("object/weapon", base_name(inv[i]));
        weapon_cnt = 1;
      } else if (!inv[i]->query_unique() && !inv[i]->query("skill_type") &&
        inv[i]->query("equipped") && !armor_cnt) {
        me->set("object/armor", base_name(inv[i]));
        armor_cnt = 1;
      }
    }
    who->set("clubdd/family", who->query("family/family_name"));
    who->set("clubdd/old_title", who->query("title"));
    who->set("clubdd/time", who->query("mud_age"));
    who->set("clubdd/base_name", query("master"));
    who->set("clubdd/data_name", query_save_file());
    who->set("clubdd/title", me->query("clubdd_title"));
    who->set("clubdd/area", query("clubdd_area"));
    who->set("title", me->query("clubdd_title"));
    me->set("clubdd/name", who->name(1));
    me->set("clubdd/id", geteuid(who));
    me->set("clubdd/long", who->long());
  }

  save();
}

//int ask_chargehere()
void start_challenge(object defier) {
  object me, *inv, master;
  int i;
  //      defier=this_player();
  master = query_temp("master");
  if (!userp(defier)) {
    return_master();
    return;
  }
  me = this_object();
  if (geteuid(defier) == me->query("clubdd/id")) {
    command("say 你是不是又迷糊了？");
    tell_object(defier, "你已经是这里的老大了！\n");
    return_master();
    return;
  }
  if (!defier->query("club") && environment(me)->query("clubb") != defier->query("club")) {
    command("say 哪来的三教酒流也在这里混混？");
    message_vision("$N对$n喝道：滚！\n", defier, me);
    defier->move("/d/city/kezhan");
    return;
  }
  fully_recover();
  message_vision("$N对$n喝道：你在这里作老大也够长时间了，也该换人了！\n",
    defier, me);
  me->command("heihei");
  message_vision("$N笑道：那就看看你有没有这本事了！\n", me);
  inv = all_inventory(defier);
  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i]->query_unique()) {
      message_vision("突然间，$n化一道白光飞去，无影无踪！\n", me, inv[i]);
      destruct(inv[i]);
    }
  }

  defier->kill_ob(me);
  me->kill_ob(defier);
  me->set("defier", defier);
  defier->set_temp("club_fight", me->query("id"));
  remove_call_out("check_result");
  call_out("check_result", 1, me, defier);
  return;
}

void check_result(object me, object defier) {
  object master;
  int my_max_kee;

  master = query_temp("master");
  if (!defier) {
    command("heng");
    command("say 就这么一点本事！");
    return_master();
    return;
  }
  if (environment(defier) != environment(me)) {
    command("heng");
    command("say 就这么一点本事！");
    return_master();
    return;
  }
  if (defier->query_temp("club_fight") != me->query("id")) {
    command("say 你们搞什么东东！");
    return_master();
    return;
  }
  my_max_kee = me->query("max_kee");
  if (((me->query("kee") * 100) / (1 + my_max_kee)) < 4 || defier->query_temp("club_fight")) {
    message_vision("$N大叫一声：厉害。说着就化做一阵烟雾遁去了！\n", me);
    CHANNEL_D->do_channel(defier, "xyj", "从此以后我就是〖"
      +me->query("clubdd_title") + HIR "〗！\n");
    save_status(me, defier, 1);
    return_master();
    return;
  }
  call_out("check_result", 1, me, defier);
  return;
}

void return_master() {
  object me, home, master;


  me = this_object();
  master = query_temp("master");
  if (!objectp(master))
    if (!objectp(master = new(query("master"))))
      return;
  home = environment(me);
  master->move(home);
  master->set_new_clubdd(master, me, master);
  destruct(this_object());
  return;
}

string query_save_file() {
  string save_name;

  save_name = query("save_name");
  if (!stringp(save_name))
    return 0;
  return clubdd_DIR + save_name;
}


int do_bandage(string arg) {
  object who = this_player();
  object me = this_object();

  if (!arg || me != present(arg, environment(me)))
    return 0;

  message_vision("$N过份殷勤地要给$n包扎伤口。\n", who, me);
  call_out("no_bandage", 2, who, me);
  return 1;
}

void no_bandage(object who, object me) {
  message_vision("$N向$n摇了摇头。\n", me, who);
}

