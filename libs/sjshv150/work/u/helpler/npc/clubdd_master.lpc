//
#include <dbase.h>

#define clubdd_OB "/u/helpler/npc/democlubdd"
//#define clubdd_ROOM "/obj/clubddroom"

inherit NPC;

string SAVE_NAME;

void set_new_clubdd(object who, object clubdd, object master);

int do_challenge() {
  object me, clubdd, defier;

  me = this_object();
  defier = this_player();
  if (me->query("clubdd_home"))

    if (me->query("clubdd_home") != base_name(environment(me))) {
      command("say 我都不在自己的地盘上，你来挑战什么？");
      return 1;
    }
  clubdd = new(clubdd_OB);
  clubdd->set("master", base_name(me));
  clubdd->set("save_name", SAVE_NAME);
  if (!clubdd->restore())
    clubdd->reset_me();
  clubdd->fully_recover();
  if (clubdd->query("clubdd"))
    set_new_clubdd(clubdd, clubdd, me);
  //      clubdd->move(environment(me));
  clubdd->set_temp("master", me);
  //      me->move(clubdd_ROOM);
  clubdd->start_challenge(defier, me);
  return 1;
}

void reload(string filename) {
  string name, id, long;
  object clubdd, me;

  SAVE_NAME = filename;
  me = this_object();
  clubdd = new(clubdd_OB);
  clubdd->set("master", base_name(me));
  clubdd->set("save_name", SAVE_NAME);
  if (!clubdd->restore())
    return;
  if (clubdd->query("clubdd"))
    set_new_clubdd(me, clubdd, me);
  destruct(clubdd);
  return;
}

void set_new_clubdd(object who, object clubdd, object master) {
  string *newid, short;
  string name, id, long;

  name = clubdd->query("clubdd/name");
  id = clubdd->query("clubdd/id");
  long = clubdd->query("clubdd/long");

  if (pointerp(newid = master->parse_command_id_list()))
    newid = ({ "clubdd " + id }) + newid;
  else newid = ({ "clubdd " + id });
  newid += ({ "clubdd" });
  if ((string)(short = query("clubdd_title")))
    short += " ";
  else short = "堂主 ";
  short += name + "(" + capitalize(newid[0]) + ")";

  who->set_temp("apply/id", newid);
  who->set_temp("apply/name", ({ name }));
  who->set_temp("apply/long", ({ long }));
  who->set_temp("apply/short", ({ short }));
  return;
}
