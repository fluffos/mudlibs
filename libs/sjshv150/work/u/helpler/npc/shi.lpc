//
#include <ansi.h>
inherit NPC;

string ask_for_present();

void create()
{
    set_name("美容师", ({ "meirong shi", "makeuper" }) );
        set("title", HIY"蛇口"+HIW" 第一快刀"NOR);
        set("gender", "男性" );

        set("age", 23);
        set("str", 100);
        set("con", 100);
        set("int", 100);
        set("per", 40);
         
        set("long",
                "蛇口第一快刀，刀刀整人.\n"
                "他正在那里搞美容。(ask makeuper about 三八)\n" );

        set("combat_exp", 8000000);
        set("attitude", "friendly");
        
        set("inquiry", ([
                
                "三八"   : (: ask_for_present :),
        ]) );

        set("qi", 5000);
        set("max_qi", 5000);
        set("jing", 5000);
        set("max_jing", 5000);
        set("neili", 5000);
        set("max_neili", 5000);
        set("jiali",300);

        set_skill("dodge", 500);
        set_skill("unarmed", 500);
        set_skill("parry", 500);
        set_skill("force",500);
        set_skill("literate",500);
        set_skill("stick", 500);




        setup();

        
        
}

void init()
{
        object ob;

        ::init();

        if( interactive(ob=this_player()) && !is_fighting())
        {
                remove_call_out("greeting");
                call_out("greeting",1,ob);
        }
}


void greeting(object ob)
{
        if(!ob || environment(ob)!=environment()) return;
     if(userp(ob)->query("gender")!="男性")
      command("say 你是来做美容的吧？\n");
}

string ask_for_present()
{ 
mapping *holiday= ({

                  ([
//
                      "name":             HIR"三八妇女节"NOR,
                      "year":             "2002",
                      "month":            "Mar",
                      "day":              "08",
                  ]),
  
                  
               
       


                        
                  });
    object me,ob;
    mapping skl, today;
    string *sname;
    int i,how=0,what_day=100,rr,t;
    string week, month, year, day, time;
    string check;
    
    sscanf(ctime(time()), "%s %s %s %s %s", week, month, day, time, year);
   if(day=="")
    sscanf(ctime(time()), "%s %s  %s %s %s", week, month, day, time,year);

me = this_player();

    for(i=0;i<sizeof(holiday);i++)
      {  today = holiday[i];
         if(today["year"]!="either")
 if(year==today["year"]&&month==today["month"]&&day==today["day"])
               what_day=i;
            else if(month==today["month"]&&day==today["day"])
               what_day=i;
      }
    if(what_day==100)
      return "今天好象不是三八节日耶！\n";
    
    
     if(me->query("gender")!="女性")
       return "三八节只有女玩家才有，除非你要变性！\n";
    if ((int)me->query("combat_exp") <200000 || (int)me->query("mud_age")<16000)
        return "嘿嘿，想用新玩家来骗我，没门！。\n";
      
    if ((int)me->query("combat_exp") >=200000 ) 
         {
                
            skl = me->query_skills();
      if(skl) sname  = keys(skl);
            for(i=0; i<sizeof(skl); i++)
                   if (skl[sname[i]] >= 10)how=how+1; 
                          if(how<3)
                            return "就你的水平？再去练一会儿！。\n";
        
          } 
     today = holiday[what_day];   

     check=year+today["name"];
          if(me->query("sen")<80 ) return "你太累了,歇歇吧.\n";                                                                                                             
//
          if( (t=(int)me->query("jjjj/time")) && !wizardp(me) && (t+300)>time())                                                                             
            return "等等再来吧,......\n";                                                                                                                               
          me->add("sen",-30);                                                                                                                                                            
          me->set("jjjj/time",time());
          rr=random(100)+1;
          if (rr>=96)
          {
                command("gongxi "+me->query("id"));
                 me->add("per",2);
                  return today["name"]+"快乐！你中奖了！\n"+"美容师给"+me->query("name")+"做一次"+HIR"大美容整形,又漂亮两点。"NOR+"。\n";  }
                  
           if (rr <96 && rr > 90 )
          {
                command("sigh "+me->query("id"));
                 me->add("per",-1);
                  return today["name"]+"快乐！你中招了！\n"+"美容师给"+me->query("name")+"做一次"+HIR"大美容整形,手术失败，又变丑了。"NOR+"。\n";  }  
                  if (rr<70)
          {
                command("gongxi "+me->query("id"));
//
                 me->add("potential",rr*10);
//
                 me->set("kee",2*((int)me->query("max_kee")));
                 me->set("sen",2*((int)me->query("max_sen")));
                 
                  return today["name"]+"快乐！\n"+"美容师给"+me->query("name")+"做一次"+HIR"脸部美容,得到了潜能"+(rr*10)+"点。"NOR+"。\n";  }             
          
 /*    if(me->query("goodday_gift")==have)
       return "每个人一份，不要这么贪心好不好！\n";

     ob = new("/d/wizz/liwu/obj/liwu888");
     ob->move(me);
     ob->set("owner",me->query("id"));

     me->set("goodday_gift",have);
     */
    
}


