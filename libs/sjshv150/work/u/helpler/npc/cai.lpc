//writed stey 
#include <ansi.h>  
inherit NPC;  
 
void create()  
{  
    set_name("足球先生", ({ "soccer","worldcup" }) );  
        set("title", HIY"世界杯"+HIW" 第一快球"NOR);  
        set("gender", "男性" );  
  
        set("age", 23);  
        set("str", 100);  
        set("con", 100);  
        set("int", 100);  
        set("per", 40);   
        set("long",  
"1.  法国            17. 德国       \n" 
"2.  塞内加尔        18. 沙特        \n"    
"3.  乌拉圭          19. 爱尔兰     \n" 
"4.  丹麦            20. 喀麦隆      \n"  
"5.  西班牙          21. 阿根廷       \n"    
"6.  斯洛文尼亚      22. 尼日利亚      \n"      
"7.  巴拉圭          23. 英格兰       \n"    
"8.  南非            24. 瑞典        \n"     
"9.  巴西            25. 意大利      \n"  
"10. 土耳其          26. 厄瓜多尔     \n" 
"11. 中国            27. 克罗地亚     \n" 
"12. 哥斯达黎加      28. 墨西哥        \n"   
"13. 韩国            29. 日本         \n" 
"14. 波兰            30. 比利时       \n"  
"15. 美国            31. 俄罗斯      \n" 
"16. 葡萄牙          32. 突尼斯       \n"    
"格式： apply <NO.1 or NO.2 or NO.3> IS <国家队序号> \n"
"命令：kaijiang 查看中奖！\n");
         
        set("kee", 5000);  
        set("max_kee", 5000);  
        set("sen", 5000);  
        set("max_sen", 5000);  
        set("force", 5000);  
        set("max_force", 5000);  
        set("max_mana", 3000);  
        set("mana",3000);  
        set("combat_exp", 8000000);  
        set("attitude", "friendly");  
         set_skill("dodge", 500);  
        set_skill("unarmed", 500);  
        set_skill("parry", 500);  
        set_skill("force",500);  
        set_skill("literate",500);  
        set_skill("stick", 500);  
  
  
        setup();  
          
          
}         
 
void init()  
{  
        object ob;  
  
        ::init();  
   add_action("do_apply", "apply");  
   add_action("do_ling", "kaijiang");  
  
  add_action("do_gamble","mai");
  add_action("do_duijiang","duijiang");  
        if( interactive(ob=this_player()) && !is_fighting())  
        {  
                remove_call_out("greeting");  
                call_out("greeting",1,ob);  
        }  
}  
  
void greeting(object ob)  
{  
        if(!ob || environment(ob)!=environment()) return;  
    
      command("say 你是来做竞猜的吧？\n");  
}   

 
int do_apply(string arg)  
{  
string type,msg;   
object me=this_player(); 
int t; 
  int afford,rank;  
     if (!this_object()->query("wwww")) 
   return notify_fail("现在不能竞猜了。\n");  
   if (me->query("lucky/worldcup_times")>15) 
   return notify_fail("你不能继续涂改了。\n"); 
             if( (t=(int)me->query_temp("jjjj/time")) && !wizardp(me) && (t+5)>time())                                                                              
                    return notify_fail("等等再写吧,......注意要不同！\n");    
   if (me->query("combat_exp")<700000 && me->query("daoxing")<300000 )   
    return notify_fail("你武学道行那么低，本来就没人听说过你，不猜也罢。\n");  
   if (!arg) return notify_fail(@LONG  
格式： apply <名次> IS <国家队序号>  
要求： 五两黄金    
 
LONG);  
  if (sscanf(arg,"%s IS %d",type,rank)!=2)   return notify_fail(@LONG  
格式： apply <名次> IS <国家队序号>  
要求： 五两黄金    
  
LONG);  
    
  if (type!="NO.1" && type!="NO.2" && type!="NO.3")  
    return notify_fail("不能设置这种类型的字眼。要NO.1 or NO.2 or NO.3\n");  
  if (rank < 1 || rank > 32)  
    return notify_fail("没有这个国家序号。\n");  
  
  if( !(afford=me->can_afford(50000)) )  {  
     write("你带的钱不够。\n");  
     return 1;   
  } else if( afford == 2 )  {  
      write("现金交易，不收银票。你带的现金不够。\n");  
      return 1;  
  }  
  
  switch (type) {  
    case "NO.1" : me->set("lucky/worldcup_a",rank);break;  
    case "NO.2" : me->set("lucky/worldcup_b",rank);break;  
    case "NO.3" : me->set("lucky/worldcup_c",rank);break;  
  }  
  
  me->add("lucky/worldcup_times",1); 
   me->set_temp("jjjj/time",time());
   message_vision("$N拿出五两金子，交给了$n。\n",me,this_object());  
   message_vision("$N说道：$n买世界杯"+type+"序号为"+rank+"国家。\n",me,this_object());  
  message_vision("$N点了点头，拿出一份卷宗写了几笔。\n",this_object());  
  me->pay_money(50000);  
  return 1;  
   
} 
 
int do_ling()  
{  
object me=this_player();  
object ob=this_object();  
int aa,bb; 
 

      if (!me->query("lucky/worldcup_a") ) 
            return notify_fail("你没选NO.1,你的奖票无效！\n"); 
      if (!me->query("lucky/worldcup_b") ) 
            return notify_fail("你没选NO.2,你的奖票无效！\n"); 
      if (!me->query("lucky/worldcup_c") ) 
            return notify_fail("你没选NO.3,你的奖票无效！\n"); 
                   
        message_vision("$n说道：$N买世界杯第一名：序号为"+me->query("lucky/worldcup_a")+"国家。\n",me,this_object());  
//
        message_vision("$n说道：$N买世界杯第二名：序号为"+me->query("lucky/worldcup_b")+"国家。\n",me,this_object());  
        message_vision("$n说道：$N买世界杯第三名：序号为"+me->query("lucky/worldcup_c")+"国家。\n",me,this_object());  
        
        if (!ob->query("okok")) 
 return notify_fail("现在不能开奖\n"); 
        if (me->query("lucky/wcup")=="get") 
        return notify_fail("你已经领过奖了！\n"); 
  
         if ((int)me->query("lucky/worldcup_a")!=9) 
                 return notify_fail("你没中！\n");   
         if ((int)me->query("lucky/worldcup_b")!=17) 
                 return notify_fail("你没中！\n"); 
         if ((int)me->query("lucky/worldcup_c")!=10) 
                 return notify_fail("你没中！\n");    
         aa= me->query("combat_exp")/50; 
         bb= me->query("doxing")/50;        
       me->add("balance",100000000);   
       me->add("combat_exp",aa); 
       me->add("daoxing",bb); 
       me->add("potential",50000); 
       me->set("lucky/wcup","get"); 
       command("chat 恭喜恭喜"+me->query("name")+"世界杯中奖!"); 
       command("chat 恭喜恭喜"+me->query("name")+"世界杯中奖!得到了一万两的黄金奖励！五万潜能！"); 
       command("chat 恭喜恭喜"+me->query("name")+"世界杯中奖!得到了"+aa+"武学！"+bb+"道行！"); 
        
       return 1; 
} 

int do_gamble(string arg)  
{  
        string type,msg;   
        object me=this_player(); 
        int t; 
        int afford,rank,money;  
     if (!this_object()->query("gamble")) 
             return notify_fail("现在不能买球了。\n");  
                 if (me->query("lucky/gamble_times")>0) 
          return notify_fail("你不能继续涂改了。\n"); 
              if( (t=(int)me->query_temp("jjjj/time")) && !wizardp(me) && (t+100)>time())                                                                              
            return notify_fail("等等再买吧,......\n");  
               if (!arg) return notify_fail(@LONG  
格式： mai <xxx> gold at <国家队序号>  
 
LONG);  
  if (sscanf(arg,"%d gold at %d",money,rank)!=2)   return notify_fail(@LONG  
格式： mai <xxx> gold at <国家队序号>  
  
LONG);    
  if ( money<100 || money>5000)
    return notify_fail("投注额在100 gold-5000gold以内。\n");     
    if( money*10000 > me->query("balance"))
  return notify_fail("你的存款不够投注额。\n");     
  if (rank < 1 || rank > 32)  
    return notify_fail("没有这个国家序号。\n");  
  me->add("lucky/gamble_times",1); 
  me->add("balance",-(money*10000)); 
   me->add("lucky/gamble_money",money); 
   me->set("lucky/gamble_winner",rank); 
             command("say 投注成功!");
            return 1;
}
int do_duijiang()  
{
         object me=this_player();
                  if (me->query("lucky/gamble_times")<1) 
              return notify_fail("你都没投注！\n");     
        if (me->query("lucky/wgamble_get")=="get") 
        return notify_fail("你已经领过奖了！\n"); 
         message_vision("$N说道：$n投注"+me->query("lucky/gamble_money")+"gold 在世界杯的一场球：序号为"+me->query("lucky/gamble_winner")+"国家为赢家。\n",this_object(),me);  
                 if ((int)me->query("lucky/gamble_winner")!=9) 
                 return notify_fail("你没中！\n");   
                        me->add("balance",((int)me->query("lucky/gamble_money"))*20000);
                      me->set("lucky/wgamble_get","get"); 
                        tell_object(me,"你赢了"+((int)me->query("lucky/gamble_money"))*2+"gold。\n");
                     command("chat 恭喜恭喜"+me->query("name")+"世界杯投注获胜!");
                     return 1;
}    
