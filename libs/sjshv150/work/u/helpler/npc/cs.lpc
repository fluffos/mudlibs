#include <ansi.h>
inherit NPC;
inherit F_SAVE;

void create() {
  set_name(HIW "武神" NOR, ({ "wu shen", "wushen" }));
  set("long", "天宫负责凡间下界的武神，他拥有很多神秘的武学功夫，你可以象他那门派比武大会奖励。\n");
  set("gender", "男性");
  set("title", HIC "纵横天界的" NOR);
  set("age", 28);
  set("per", 40);
  set("attitude", "peaceful");

  setup();
  carry_object("/d/lingtai/obj/faguan")->wear();
  remove_call_out("cccsss");
  call_out("cccsss", 30);
}

void init() {
  add_action("do_init", "init");
  add_action("do_join", "join");
  add_action("do_join_all", "join_all");
}
int answer_me() {
  command("say 小心我扁你！嘿嘿 。\n");
  return 1;
}
void cccsss() {
  object ob;
  ob = this_object();
  ob->restore();
  ob->add("cccsss/num", 1);
  ob->set("type", query("type"));
  ob->save();
  call_out("cccsss", 300);



}

string query_save_file() {
  string str = query("save_file");
  int i;

  if (str)
    return str;

  str = DATA_DIR + "ccss/ccss.o";
  for (i = 0; i < sizeof(str); i++)
    if (str[i] == ' ') str[i] = '_';

  return str;
}

void set_save_file(string str) {
  set("save_file", str);
}

void die() {
  return;
}
