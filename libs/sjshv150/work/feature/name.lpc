// name.c
// modified by mudring@sjsh......

#include <ansi.h>
#include <dbase.h>
#include <condition.h>

nosave string *my_id;

string *query_my_id() {
  return my_id;
}

void set_name(string name, string *id) {
  set("name", name);
  set("id", id[0]);
  my_id = id;
}

int id(string str) {
  string *applied_id;

  if (this_player() && !this_player()->visible(this_object())) return 0;

  if (pointerp(applied_id = query_temp("apply/id")) && sizeof(applied_id))
    if (member_array(str, applied_id) != -1)
      return 1;
    else
      return 0;

  if (pointerp(my_id) && member_array(str, my_id) != -1)
    return 1;
  else
    return 0;
}

string *parse_command_id_list() {
  string *applied_id;

  if (pointerp(applied_id = query_temp("apply/id")) && sizeof(applied_id))
    return applied_id;
  else
    return my_id;
}

varargs string name(int raw) {
  object me = this_object();
  string str, *mask;

  if (!raw && sizeof(mask = query_temp("apply/name")))
    return mask[sizeof(mask) - 1];
  if (!raw && wizardp(me)
    && intp(query("env/invisibility"))
    && query("env/invisibility") > 6) return "某人";
  if (stringp(str = query("name")))
    return str;
  return file_name(me);
}

varargs string short(int raw) {
  string title, nick, str, *mask;
  string force;
  mapping msg;

  object me = this_object();
  if (!stringp(str = query("short"))) {
    if (query("color"))
      str = query("color") + name(raw) + NOR "(" + (stringp(query("id")) ? capitalize(query("id")) : "?") + ")";
    else
      str = name(raw) + "(" + (stringp(query("id")) ? capitalize(query("id")) : "?") + ")";
  }

  if (!this_object()->is_character()) return str;

  if (!raw && sizeof(mask = query_temp("apply/short")))
    str = (string)mask[sizeof(mask) - 1];
  else {
    if (stringp(nick = query("nickname")))
      str = sprintf("「%s」%s", nick, str);

    if (stringp(title = query("title")))
      str = sprintf("%s%s%s", title, (nick ? "" : " "), str);
  }

  if (!raw) {
    if ((int)query_temp("pending/exercising")) {
      force = me->query_skill_mapped("force");
      if (force) msg = SKILL_D(force)->exercise_msg(me);
      if (!msg || undefinedp(msg["status_msg"]))
        str = name() + "正在修炼内力" NOR;
      else
        str = msg["status_msg"];
    } else if ((int)query_temp("pending/meditating"))
      str = name() + "正在修炼法力" NOR;
  }

  if (!raw) {
    if (wizardp(me)) {
      if (this_object()->query("env/wizset") == "eat") str += HIY " <吃饭中>" NOR;
      if (this_object()->query("env/wizset") == "edit") str += HIY " <修改程序中>" NOR;
      if (this_object()->query("env/wizset") == "leave") str += HIY " <暂时离开>" NOR;
      if (this_object()->query("env/wizset") == "idle") str += HIM " <发呆中>" NOR;
      if (this_object()->query("env/wizset") == "test") str += HIG " <系统测试中>" NOR;
    }
    if (userp(me)) {
      if (this_object()->is_net_dead()) {
        switch (this_object()->query("doing")) {
          case "breakup":
            str += HIY " <闭关中>" NOR;
            break;
          case "closed":
            str += HIY " <修炼中>" NOR;
            break;
          case "scheme":
            str += HIW " <计划中>" NOR;
            break;
          default:
            str += HIG " <断线中>" NOR;
        }
      }

      if (this_object()->query("wiz/test"))
        str += HIY " <系统测试>" NOR;  //By waiwai@2001/03/08 added.
        if (this_object()->is_ghost())
          str = HIB "(鬼气) " NOR + str;
      if (this_object()->query("thief"))
        str += HIG " <窃贼>" NOR;
      if (this_object()->query_condition("no_pk_time"))
        str = HIR "(通缉犯) " NOR + str;
      if (query_temp("doing_xiudao"))
        str += HIY " <修道中>" NOR;
      if (this_object()->query("env/invisibility"))
        str += HIW " <隐身中>" NOR;
      if (in_input())
        str += HIC " <输入文字中>" NOR;
      if (in_edit())
        str += HIY " <编辑档案中>" NOR;
    }
    if (interactive(this_object())
      && query_idle(this_object()) > 180 && !query_temp("ext_info")) {
      this_object()->improve_skill("idle-force", 1);
      str += HIM "<发呆" + chinese_number(query_idle(this_object()) / 60) + "分钟>" NOR;
    }
    if (this_object()->is_fighting()) str += HIW " <战斗中>" NOR;
    if (!living(this_object())) str += HIR + query("disable_type") + NOR;
  }
  return str;
}

varargs string long(int raw) {
  string str, extra, *mask;

  if (!raw && sizeof(mask = query_temp("apply/long")))
    str = mask[sizeof(mask) - 1];
  else if (!stringp(str = query("long")))
    str = short(raw) + "。\n";

  if (stringp(extra = this_object()->extra_long()))
    str += extra;

  return str;
}
