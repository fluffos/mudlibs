// tiantang.c 天堂
// by rwz
#include <ansi.h>
#include <room.h>
inherit ROOM;

void create() {
  set("short", HIC "天堂" NOR);
  set("long", @LONG
	这是传说中的天堂。
LONG
  );

  set("no_fight", 1);
  set("no_steal", 1);
  set("no_sleep_room", 1);
  set("exits", ([
    "down": __DIR__ "xiaoyuan.lpc",
  ]));
  set("objects", ([
    "/d/xiakedao/obj/jingubang": 1,
  ]));
  setup();
  replace_program(ROOM);
}
