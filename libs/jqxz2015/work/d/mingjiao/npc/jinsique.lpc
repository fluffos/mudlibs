// jinsique.c

inherit NPC;

void create() {
  set_name("金丝雀", ({ "bird" }));
  set("gender", "雌性");
  set("race", "野兽");
  set("age", 5);
  set("long", "这只金丝雀在在桃树间跳上跳下，还不时津津有味地吃几口虫子。\n");
  set("combat_exp", 5000);
  set("attitude", "peaceful");
  set("water", 200);
  set("food", 200);
  set("limbs", ({ "头部", "身体", "左脚", "右脚", "翅膀" }));
  set("verbs", ({ "bite", "claw" }));

  set("apply/attack", 10);
  set("apply/defense", 10);

  set("chat_chance", 2);
  set("chat_msg", ({
    "金丝雀吃了一口虫子。\n",
  }));

  set_skill("unarmed", 25);
  set_skill("parry", 20);
  set_skill("dodge", 20);

  setup();
}
