#include <ansi.h>
inherit NPC;

void create() {
  set_name("杨不悔", ({ "yang buhui", "yang", "buhui" }));
  set("gender", "女性");
  set("nickname", HIG "私生女" NOR);
  set("age", 17);
  set("long",
    "她是武当六侠殷梨亭的未婚妻峨眉女侠纪晓芙和明教光明左使杨逍的私生女。\n");
  set_temp("apply/defense", 5);
  set("combat_exp", 10000);
  set("shen", 100);
  set("shen_type", 1);
  set("str", 18);
  set("dex", 19);
  set("con", 16);
  set("int", 28);
  set("neili", 300);
  set("max_neili", 300);
  set("attitude", "friendly");
  set_skill("force", 30);
  set_skill("unarmed", 30);
  set_skill("dodge", 30);
  set_skill("parry", 30);
  set_skill("literate", 50);
  setup();
  carry_object("/d/city/npc/obj/pink_cloth")->wear();
  add_money("gold", 3);
}
