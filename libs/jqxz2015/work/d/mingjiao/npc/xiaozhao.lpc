// xiaozhao.c 韩小昭
#include <ansi.h>
inherit NPC;
int ask_me();
void create() {
  set_name("韩小昭", ({ "han xiaozhao", "han", "xiaozhao" }));
  set("gender", "女性");
  set("nickname", HIG "混血美女" NOR);
  set("age", 17);
  set("long",
    "她是一位漂亮的混血小姑娘。\n");
  set_temp("apply/defense", 5);
  set("combat_exp", 10000);
  set("shen", 100);
  set("shen_type", 1);
  set("str", 18);
  set("dex", 19);
  set("con", 16);
  set("int", 28);
  set("neili", 300);
  set("max_neili", 300);
  set("attitude", "friendly");
  set_skill("force", 30);
  set_skill("unarmed", 30);
  set_skill("dodge", 30);
  set_skill("parry", 30);
  set_skill("literate", 50);
  set("inquiry", ([
    "密洞": (: ask_me :),
    "明教密洞": (: ask_me :),
  ]));
  setup();
  carry_object("/clone/misc/cloth")->wear();
  add_money("silver", 10);
}
int ask_me() {
  object me, ob;
  ob = this_player();
  me = this_object();
  if (ob->query_skill("jiuyang-shengong", 1) >= 50) {
    message_vision(CYN "韩小昭想了想道：“好吧，我就随你去明教密洞逛逛。”\n" NOR, me);
    me->set_leader(ob);
  } else
    message_vision(CYN "韩小昭笑道：“你的九阳神功不足，去了也是送死啊！”\n" NOR, me);
  return 1;
}
