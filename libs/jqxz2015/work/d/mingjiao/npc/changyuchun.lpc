#include <ansi.h>
inherit F_UNIQUE;
inherit NPC;
void create() {
  seteuid(getuid());
  set_name("常遇春", ({ "chang yuchun", "chang", "yuchun" }));
  set("long", "他是一个魁梧的大汉。\n");
  set("title", "明教坛主" + WHT "常胜将军" NOR);
  set("gender", "男性");
  set("age", 27);
  set("attitude", "heroism");
  set("shen_type", 1);
  set("level", 5);
  set("str", 25);
  set("int", 24);
  set("con", 25);
  set("dex", 26);

  set("qi", 800);
  set("max_qi", 800);
  set("jing", 500);
  set("max_jing", 500);
  set("neili", 500);
  set("max_neili", 500);
  set("jiali", 10);

  set("combat_exp", 80000);
  set("score", 10000);

  set_skill("unarmed", 60);
  set_skill("dodge", 60);
  set_skill("parry", 60);
  set_skill("force", 60);
  set_skill("club", 60);
  set_skill("hunyuan-yiqi", 60);
  set_skill("shaolin-shenfa", 60);
  set_skill("zui-gun", 60);
  set_skill("changquan", 60);

  map_skill("force", "hunyuan-yiqi");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("unarmed", "changquan");
  map_skill("parry", "zui-gun");
  map_skill("club", "zui-gun");

  create_family("明教", 5, "弟子");

  set("chat_chance", 10);
  set("chat_msg", ({
    "常遇春道: 何时才能把蒙古鞑子赶出中原河山？\n",
  }));

  setup();
  carry_object("/d/baituo/obj/baipao")->wear();
  carry_object("/d/shaolin/obj/qimeigun")->wield();
  add_money("gold", 3);
}

void attempt_apprentice(object ob) {
  object letter;
  if ((string)ob->query("family/family_name") == "明教") {
    command("say 在下哪有资格收徒弟？");
    return;
  }

  message_vision("常遇春说道：这位" + RANK_D->query_respect(ob) +
    "真乃有识之士，\n我现在不能收你，只能送你上昆仑山。\n", ob);

  write(HIY "只见常遇春把齐眉棍一扫，\n
     你觉得眼前一闪，身体轻飘飘地飞了出去￣￣\n" NOR);
  letter = new("/d/mingjiao/obj/tuijianxin-1");
  letter->move(ob);
  ob->set_temp("have_letter", 1);
  ob->move("/d/mingjiao/shanmen");
}
void init() {
  object me, ob;
  me = this_object();
  ob = this_player();

  ::init();

  if (interactive(ob) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, me, ob);
  }
}
#include "mingjiao.h"
