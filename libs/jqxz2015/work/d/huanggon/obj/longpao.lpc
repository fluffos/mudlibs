// longpao.c 龙袍
#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create() {
  set_name(HIY "龙袍" NOR, ({ "longpao" }));
  set_weight(3000);
  set("long", "这是皇帝穿的龙袍。\n");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "cloth");
    set("armor_prop/armor", 10);
  }
  setup();
}
