// huangguan.c 皇冠
#include <ansi.h> 
#include <armor.h>
 
inherit HEAD;
 
void create()
{
	set_name(HIY"皇冠"NOR, ({ "crown" }) );
	set_weight(2000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("material", "steel");
		set("unit", "顶");
		set("long", "这是皇帝戴的皇冠。\n");
		set("value", 1500);
		set("armor_prop/dodge", 1);
	}
	setup();
}