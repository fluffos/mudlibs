// wangyuyan.c
#include <ansi.h>
inherit NPC;

void create() {
  set_name(HIY "皇帝" NOR, ({ "emperor" }));
  set("gender", "男性");
  set("age", 38);
  set("long",
    "他就是皇帝！\n");
  set("combat_exp", 20000);
  set("shen_type", -1);
  set("str", 23);
  set("dex", 18);
  set("con", 18);
  set("int", 20);
  set("attitude", "friendly");
  set("qi", 1000);
  set("max_qi", 1000);
  set("neili", 250);
  set("max_neili", 250);
  set_skill("force", 40);
  set_skill("unarmed", 40);
  set_skill("literate", 60);
  set_skill("parry", 40);
  set_skill("dodge", 40);
  set("inquiry", ([
    "皇帝": "见到朕，还不跪下！\n",
    "玉玺": "朕的玉玺被盗了，你能帮朕找回来吗？\n",
  ]));
  setup();
  carry_object("/d/huanggon/obj/crown")->wear();
  carry_object("/d/huanggon/obj/longpao")->wear();
  add_money("gold", 10);
}
void kill_ob(object ob) {
  object me = this_object();
  object where = environment(me);
  object zhang = present("zhang zhaozhong", where);
  set_temp("my_killer", ob);
  ::kill_ob(ob);
  if (zhang && !zhang->is_fighting()) {
    message("vision", "张召重怒道：“" + ob->name() + "，竟敢刺杀皇上，我宰死你！”\n", environment(), me);
    zhang->kill_ob(ob);
  }
}
int accept_object(object who, object ob) {
  if (!who || environment(who) != environment())
    return 0;
  if (!objectp(ob))
    return 0;
  if (!present(ob, who))
    return notify_fail("你没有这件东西。\n");

  if ((string)ob->query("name") != HIC "玉玺" NOR)
    return notify_fail("皇帝不需要这件东西。\n");
  say("皇帝接过" + HIC "玉玺" NOR + "，哈哈大笑!\n");
  ob->move(this_object());
  if ((int)who->query("meili") < 100) {
    who->add("meili", 10);
    message_vision("你的魅力提高了！\n", who);
  }
  return 1;
}
