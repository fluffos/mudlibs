// Room: /city/gongcang.c
// YZC 1995/12/04 

inherit ROOM;

void create() {
  set("short", "谷物加工厂");
  set("long", @LONG
	这是一间谷物加工厂，这里是谷子脱壳成米的地方。米厂老板是一
个一看就知道是十分精明的干瘦的中年人，老是带着一脸奸笑。你可以
看到许多人正在忙忙碌碌地工作着，门口挂著一块牌子(sign)。
LONG
  );
  set("no_fight", 1);
  set("no_beg", 1);

  set("item_desc", ([
    "sign": "现在正紧缺人手，急需雇佣一批短工来干活。\n
work     开始工作。\n",
  ]));

  set("exits", ([
    "east": __DIR__ "nanmen",
  ]));

  setup();
}
void init() {
  add_action("do_work", "work");
}
int do_work() {
  object me, ob;
  me = this_player();
  if (me->query("combat_exp") > 1000000) return notify_fail("阁下这等高手，为何不去劫富济贫？\n");
  if (me->is_busy() || me->query_temp("work"))
    return notify_fail("你正忙着呢。\n");

  if (me->query("jing") < 30 || me->query("qi") < 30)
    return notify_fail("你太累了，歇会儿吧。\n");
  else {
    me->set_temp("work", 1);
    message_vision("$N开始辛苦地工作......\n", me);
    me->receive_damage("jing", 20);
    me->receive_damage("qi", 20);
    call_out("reward", 30);
    return 1;
  }
}
void reward() {
  object ob, me = this_player();
  ob = new("/clone/money/gold");
  ob->move(me);
  me->add("combat_exp", 2);
  me->add("potential", 1);
  me->delete_temp("work");
  message_vision("$N辛苦工作，获得了酬劳\n", me);
}
