// chuanfu.c 年轻船夫
#include <ansi.h>

inherit NPC;
int chu_hai();
void goto_dao(object ob);

void create() {
  set_name("年轻船夫", ({ "young chuanfu", "chuanfu" }));
  set("gender", "男性");
  set("age", 25);
  set("long",
    "这是一个年轻船夫。他的脸上透出一丝侠义正气。他经常出海，以前曾经\n"
    "去过侠客岛。现在他拥有一艘大船可以出海。\n",
  );

  set("combat_exp", 1000000);
  set("shen_type", 1);

  set("eff_qi", 2000);
  set("qi", 2000);
  set("max_neili", 1000);
  set("neili", 1000);
  set("jiali", 100);

  set_skill("force", 200);
  set_skill("unarmed", 400);
  set_skill("dodge", 200);
  set_skill("parry", 200);
  set("inquiry", ([

    "侠客岛": "想去侠客岛喝碗腊八粥吗？\n",
    "出海": (: chu_hai :),

  ]));

  setup();
  carry_object("/clone/misc/cloth")->wear();
}

int chu_hai() {
  object ob;
  ob = this_player();
  message_vision("年轻船夫上上下下打量了$N一下：什么！出海？你不要命了？！\n"
    "年轻船夫又想了一下：不过...如果给我一两金子，或许可以考虑。\n"
    , ob);
  ob->set_temp("出海", 1);
  return 1;
}

int accept_object(object who, object ob) {
  object myenv;
  if (!(int)who->query_temp("出海")) {
    message_vision("年轻船夫笑着对$N说：无功不受禄，您还是自己留着吧！\n", who);
    return 0;
  }
  if (ob->query("money_id") && ob->value() >= 10000) {
    message_vision("年轻船夫对$N说：好！既然这位" + RANK_D->query_respect(who) +
      "如此看得起我，\n那我也拼上这条破船，舍命陪君子便了！\n", who);
    this_player()->delete_temp("出海");
    message_vision("年轻船夫一招手，叫来几个水手。\n", who);
    message_vision("水手和$N上了船，一声「起锚」船就开走了，但年轻船夫却没上船......\n", who);
    myenv = environment(who);
    who->move("/d/xiakedao/dahai");
    tell_room(myenv,
      "年轻船夫看船走了，掂着手里的金子叹道：去侠客岛？这辈子就别想回来了。\n"
      "只可惜我那几个听话的水手，这辈子算是永别了。唉！\n");
    tell_object(who, BLU "你在海上航行了很久很久.......\n" NOR);
    call_out("goto_xiake", 10, who);
    return 1;
  } else
    message_vision("年轻船夫皱眉对$N说：您给的也太少了吧？\n", who);
  return 0;
}

void goto_xiake(object ob) {
  tell_object(ob, "大船终于停在了一个小岛边。你走下船来。\n");
  ob->move("/d/xiakedao/haitan");
}
