// dagou_bang.c

#include <ansi.h>
#include <weapon.h>

inherit CLUB;

void create() {
  set_name(HIG "打狗棒" NOR, ({ "dagou bang", "bang", "stick" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("long", "玉竹杖是丐帮帮主的权利象征，俗称打狗棒。\n");
    set("value", 10000);
    set("material", "bamboo");
    set("wield_msg", "$N抽出一根青光闪闪的竹棒抓在手中。\n");
    set("unwield_msg", "$N把手中的打狗棒插回腰中。\n");
  }
  init_club(30);
  setup();
}
