inherit ROOM;
int valid_leave();
void create() {
  set("short", "全真教大殿");
  set("long", @LONG
这里是全真教大殿。
LONG
  );
  set("valid_startroom", 1);
  set("exits", ([
    "south": __DIR__ "shijie2",
    "in": __DIR__ "biguan",
  ]));

  set("objects", ([
    "/kungfu/class/quanzhen/qiu": 1,
  ]));

  setup();
}
int valid_leave(object me, string dir) {
  if (dir != "in")
    return ::valid_leave(me, dir);

  if (dir == "in" && objectp(present("qiu chuji", environment(me)))) {
    if ((string)me->query("family/family_name") == "全真教") {
      if ((me->query("gender") == "男性"))
        write("丘处机侧身让开，说道: 俊男辛苦了，师傅正等着你呢。\n");
      else if ((me->query("gender") == "女性"))
        write("丘处机侧身让开，说道：美女辛苦了，师傅正等着你呢。\n");
      return 1;
    } else
      return notify_fail(
        "丘处机喝道：里面是家师的闭关室，这位" + RANK_D->query_respect(me) + "请止步。\n");
  }
  return ::valid_leave(me, dir);
}
