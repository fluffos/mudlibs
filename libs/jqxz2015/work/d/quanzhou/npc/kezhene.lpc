// kezhene.c 柯镇恶

inherit NPC;

void create() {
  set_name("柯镇恶", ({ "ke zhene", "ke", "zhene" }));
  set("title", "江南七怪老大");
  set("gender", "男性");
  set("age", 52);
  set("long",
    "他是江南七怪的老大柯镇恶，他的双眼瞎了。\n");
  set("attitude", "heroism");
  set("shen", 1000);
  set("str", 24);
  set("int", 20);
  set("con", 23);
  set("dex", 17);
  set("food", 100);
  set("water", 100);
  set("chat_chance", 1);
  set("chat_msg", ({
    "柯镇恶叹道：“江南七怪如今只剩我一个了………”\n",
  }));

  set("inquiry", ([
    "江南七怪": "江南七怪行侠仗义，谁不敬仰？\n",
    "郭靖": "郭靖就是我们江南七怪的徒弟，如今已是旷世大侠。\n",
  ]));

  set("jing", 200);
  set("max_jing", 200);
  set("jingli", 300);
  set("max_jingli", 300);
  set("qi", 1500);
  set("max_qi", 1500);
  set("neili", 1000);
  set("max_neili", 1000);
  set("jiali", 50);

  set("combat_exp", 250000);
  set("score", 8000);

  set_skill("force", 80);
  set_skill("xiaowuxiang", 80);
  set_skill("unarmed", 70);
  set_skill("yujiamu-quan", 70);
  set_skill("staff", 80);
  set_skill("xiangmo-chu", 80);
  set_skill("dodge", 70);
  set_skill("shenkong-xing", 70);
  set_skill("parry", 70);

  map_skill("force", "xiaowuxiang");
  map_skill("dodge", "shenkong-xing");
  map_skill("staff", "xiangmo-chu");
  map_skill("parry", "xiangmo-chu");
  map_skill("unarmed", "yujiamu-quan");
  setup();
  carry_object("/clone/weapon/gangzhang")->wield();
  carry_object("/clone/misc/cloth")->wear();
}
