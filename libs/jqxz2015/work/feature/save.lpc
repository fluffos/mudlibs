// save.c

int save() {
  string file;

  if (stringp(file = this_object()->query_save_file())) {
    assure_file(file + __SAVE_EXTENSION__);
    return save_object(file);
  }
  return 0;
}

int restore() {
  string file, head;

  if (stringp(file = this_object()->query_save_file())) {
    // a save this driver wrote starts with `#`; some of the archive's data files (data/e2c_dict.o, data/board/*_b.o, a few test accounts) are
    // binary (`?adm`, `?inh`, `?clo`): restore_object() raises on them and the caught error is printed at every boot and first login.
    // A read the master denies answers 0 (not a string): then restore_object() decides, as before.
    head = read_bytes(file + __SAVE_EXTENSION__, 0, 1);
    if (stringp(head) && head != "#")
      return 0;
    return restore_object(file);
  }
  return 0;
}
