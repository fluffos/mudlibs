#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create() {
  set_name("袁承志", ({ "yuan chengzhi", "yuan", "chengzhi" }));
  set("nickname", HIG "负心郎君" NOR);
  set("long",
    "袁承志是华山派的后起之秀。\n");
  set("gender", "男性");
  set("age", 23);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("str", 26);
  set("int", 28);
  set("con", 25);
  set("dex", 29);

  set("max_qi", 1900);
  set("max_jing", 500);
  set("neili", 2500);
  set("max_neili", 1800);
  set("jiali", 50);
  set("combat_exp", 600000);
  set("score", 5000);

  set_skill("force", 160);
  set_skill("dodge", 170);
  set_skill("parry", 160);
  set_skill("sword", 180);
  set_skill("strike", 150);
  set_skill("zixia-shengong", 160);
  set_skill("jinshe-jianfa", 180);
  set_skill("huashan-shenfa", 180);
  set_skill("hunyuan-zhang", 150);

  map_skill("force", "zixia-shengong");
  map_skill("dodge", "huashan-shenfa");
  map_skill("parry", "jinshe-jianfa");
  map_skill("sword", "jinshe-jianfa");
  map_skill("strike", "hunyuan-zhang");

  prepare_skill("strike", "hunyuan-zhang");

  create_family("华山派", 19, "弟子");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "sword.suo" :),
    (: exert_function, "recover" :),
  }));
  setup();
  carry_object("/clone/misc/cloth")->wear();
  carry_object("/d/huashan/obj/jinshejian")->wield();
}
void attempt_apprentice(object ob) {
  if ((int)ob->query("shen") < 500) {
    command("say 我华山派乃是堂堂名门正派，对弟子要求极严。");
    command("say 在德行方面，" + RANK_D->query_respect(ob) +
      "是否还做得不够？");
    return;
  }

  if ((int)ob->query_int() < 25) {
    command("say 依我看" + RANK_D->query_respect(ob) + "的悟性似乎不适合学我华山派武功？");
    return;
  }

  command("say 好吧，我就收下你了。");
  command("recruit " + ob->query("id"));
  if ((string)ob->query("class") != "swordsman")
    ob->set("class", "swordsman");

  return;
}
