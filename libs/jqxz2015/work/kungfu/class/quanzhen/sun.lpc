// sun.c 孙不二

#include <ansi.h>
inherit NPC;

void create() {
  set_name("孙不二", ({ "sun buer", "sun" }));
  set("gender", "女性");
  set("age", 33);
  set("class", "quanzhen");
  set("nickname", CYN "清净散人" NOR);
  set("long",
    "她就是全真教二代弟子中唯一的女弟子孙不二孙真人。她本是\n"
    "马钰入道前的妻子，道袍上绣着一个骷髅头。\n");
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("str", 30);
  set("int", 29);
  set("con", 29);
  set("dex", 29);

  set("title", "全真七子之末");
  set("env/wimpy", 40);
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    // 	(: exert_function, "powerup" :),
    (: exert_function, "recover" :),
    (: perform_action, "strike.ju" :),
    //      (: perform_action, "sword.ding" :),
    (: perform_action, "sword.sanqing" :),

  }));

  set("qi", 4000);
  set("max_qi", 4000);
  set("jing", 1600);
  set("max_jing", 1600);
  set("neili", 6000);
  set("max_neili", 6000);
  set("jiali", 100);

  set("combat_exp", 500000);
  set("score", 300000);

  set_skill("force", 130);
  set_skill("xiantian-qigong", 130);    //先天气功
  set_skill("sword", 130);
  set_skill("quanzhen-jian", 200);  //全真剑
  set_skill("dodge", 110);
  set_skill("jinyan-gong", 170);   //金雁功
  set_skill("parry", 140);
  set_skill("unarmed", 150);
  set_skill("strike", 120);
  set_skill("haotian-zhang", 200);    //昊天掌
  set_skill("cuff", 120);
  set_skill("chunyang-quan", 180);    //纯阳拳
  set_skill("literate", 100);
  set_skill("taoism", 100);

  map_skill("force", "xiantian-qigong");
  map_skill("sword", "quanzhen-jian");
  map_skill("dodge", "jinyan-gong");
  map_skill("parry", "quanzhen-jian");
  map_skill("strike", "haotian-zhang");
  map_skill("cuff", "chunyang-quan");
  prepare_skill("cuff", "chunyang-quan");
  prepare_skill("strike", "haotian-zhang");

  create_family("全真教", 2, "弟子");

  set("inquiry", ([
    "全真教": "我全真教是天下道家玄门正宗。\n",
  ]));

  setup();

  carry_object("/d/city/obj/changjian")->wield();
  carry_object("/d/zhongnan/obj/magrobe")->wear();
}
void attempt_apprentice(object ob) {
  if ((string)ob->query("gender") != "女性") {
    command("say 贫道只收女弟子。");
    return;
  }
  if (ob->query("family/family_name") != "全真教") {
    command("say 你不是玄门清修之士，所以，请回吧。");
    return;
  }

  if ((int)ob->query_skill("xiantian-qigong", 1) < 50) {
    command("say 你的本门内功心法火候不足，难以领略更高深的武功。");
    return;
  }
  if ((int)ob->query("shen") < 1000) {
    command("say 我辈武人份当行侠仗义除暴安良，你若能多为侠义之举，当能承我衣钵。\n");
    return;
  }
  command("say 好吧，依你资质，定可传我衣钵，我就收下你这个徒弟了。");
  command("recruit " + ob->query("id"));
  command("say 从今以后你就是全真教志字辈弟子了。");

}
