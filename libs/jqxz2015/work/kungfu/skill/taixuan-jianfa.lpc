// taixuan-jianfa.c 太玄剑法

#include <ansi.h>
inherit SKILL;
string type() { return "martial"; }
string martialtype() { return "skill"; }

string *msg = ({
  "$N一招" HIC "「谁能书阁下」" NOR "，手中$w随意刺向$n的$l",
  "$N一招" HIW "「脱剑膝前横」" NOR "，手中$w划过$n的$l",
  "$N使出一式" GRN "「救赵挥金锤」" NOR "，手中$w刺向$n的$l",
  "$N一招" HIB "「赵客缦胡缨」" NOR "，手里$w直取$n的$l",
  "$N手中$w使出一式" HIG "「吴钩霜雪明」" NOR "，刺向$n的$l",
  "$N使出一式" HIY "「银鞍照白马」" NOR "，手中$w跃跃洒洒飘向$n的$l",
  "$N随意一招" HIM "「白首太玄经」" NOR "，将$w扎向$n的$l",
});

int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }
int valid_learn(object me) {
  object weapon;
  if ((int)me->query("max_neili") < 150)
    return notify_fail("你的内力太弱，无法练太玄剑法。\n");
  if ((int)me->query_skill("taixuan-gong", 1) < 30)
    return notify_fail("你的太玄功修为不足，无法练太玄剑法。\n");
  if (!(weapon = me->query_temp("weapon")) ||
    (string)weapon->query("skill_type") != "sword")
    return notify_fail("你必须先找一把剑才能练剑法。\n");
  return 1;
}
int practice_skill(object me) {
  int cost;
  cost = 40;
  if ((int)me->query("qi") < 140)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 50)
    return notify_fail("你的内力不够练太玄剑法。\n");
  if ((int)me->query_skill("taixuan-zhang", 1) > 150)
    cost = 80;
  if ((int)me->query_skill("taixuan-zhang", 1) > 250)
    cost = 160;
  me->receive_damage("qi", cost);
  me->add("neili", -50);
  return 1;
}
mapping query_action(object me, object weapon) {
  return ([
    "action": msg[random(sizeof(msg))] + NOR,
    "damage": 240 + random(100),
    "damage_type": random(2) ? "刺伤" : "割伤",
    "dodge": -25 + random(20),
    "parry": -55 + random(20),
    "force": 150 + random(80)
  ]);
}
int learn_bonus() { return 0; }
int practice_bonus() { return 0; }
int success() { return 5; }
int power_point(object me) {
  object weapon;
  if (!objectp(weapon = me->query_temp("weapon"))
  )
    return 0.8;
  else return 1.2;
}

string perform_action_file(string action) {
  return __DIR__ "taixuan-jianfa/" + action;
}
int help(object me) {
  write(HIC "\n太玄剑法：" NOR "\n");
  write(@HELP
太玄剑法源自侠客岛石壁。

HELP
  );
  return 1;
}
