//Cracked by Roath
//liefei.c 撕心裂肺 

#include <ansi.h>

inherit F_DBASE;
inherit F_SSERVER;

int perform(object me, object target) {
  string weapon;
  object weapon1;
  int lvl1, lvl2, amount;

  //	if ( userp(me) && !wizardp(me) && (me->query("family/family_name") != "桃花岛"))
  //	  	return notify_fail("你不是桃花岛弟子，无法施展「撕心裂肺」。\n");

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("「撕心裂肺」只能对战斗中的对手使用。\n");

  weapon1 = me->query_temp("weapon");
  if (objectp(weapon1))
    return notify_fail("你并非空手，如何使得「撕心裂肺」？\n");

  if (me->query_skill_mapped("force") != "jiuyin-shengong")
    return notify_fail("你使用的内功心法无法发挥「撕心裂肺」的威能。\n");

  if (userp(me) && me->query_skill("jiuyin-shengong", 1) < 120)
    return notify_fail("你的九阴神功火候未到，无法施展「撕心裂肺」！\n");

  if (me->query_skill("jiuyin-baiguzhao", 1) < 120)
    return notify_fail("你的九阴白骨爪火候未到，施展不出「撕心裂肺」！\n");

  lvl1 = me->query_skill("jiuyin-shengong", 1);

  lvl2 = me->query_skill("claw");

  amount = (lvl1 + lvl2) / 15;

  if (amount < 40) amount = 40;
  if (amount > 80) amount = 80;

  if (me->query("neili") <= amount * 4)
    return notify_fail("你的内力不够使用「撕心裂肺」！\n");

  weapon = me->query_temp("weapon");

  me->add_temp("apply/damage", amount);
  me->add_temp("apply/attack", amount * 2);
  me->add_temp("apply/dodge", amount * 2);

  message_vision(HIY "\n$N目射凶光，怒喝一声「" + HIM "你妈卖屄！" + HIY "」,双爪猛地向$n的心肠抓去！\n\n" NOR, me, target);

  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  me->start_busy(random(2));
  me->add_temp("apply/damage", -amount);
  me->add_temp("apply/attack", -amount * 2);
  me->add_temp("apply/dodge", -amount * 2);
  me->add("neili", -amount);
  return 1;
}
