// taixuan-shenfa.c 侠客岛太玄身法

#include <ansi.h>
inherit SKILL;

string *dodge_msg = ({
  "$n一式「千里不留行」，轻松闪开。\n",
  "$n使出「事了拂衣去」，$N顿时打偏了。\n",
  "$n一纵「深藏身与名」，早已避开。\n",
  "$n左手拍出，劲风到处，把$N震到一边。\n",
  "$n手臂回转，抓住$N手肘一推，将$N远远掷开。\n",
  "$n两腿轻蹬，激跃而出，竟已落在十数丈外。\n",
  "$N只觉眼前一花，只见到$n身形一幌，自己的招数居然莫名其妙就落空了。\n",
});

int valid_enable(string usage) {
  return usage == "dodge";
}

string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}
int valid_learn(object me) {
  if ((int)me->query_skill("taixuan-gong", 1) < 10)
    return notify_fail("你的太玄功火候不够，无法学习太玄身法。\n");

  return 1;
}
int practice_skill(object me) {
  if ((int)me->query("qi") < 40)
    return notify_fail("你的体力太差了，不能练太玄身法。\n");
  me->receive_damage("qi", 20);
  return 1;
}
string perform_action_file(string action) {
  return __DIR__ "taixuan-shenfa/" + action;
}
int help(object me) {
  write(HIC "\n太玄身法：" NOR "\n");
  write(@HELP

    太玄身法源自侠客岛上洞壁武功。

HELP
  );
  return 1;
}
