mapping *quest = ({
  ([ "quest": "铜钹",
    "diff": 2,
  ]),
  ([ "quest": "铁棍",
    "diff": 1,
  ]),
  ([ "quest": "粗布衣",
    "diff": 2,
  ]),
  ([ "quest": "羊肉串",
    "diff": 2,
  ]),
  ([ "quest": "大刀",
    "diff": 2,
  ]),
  ([ "quest": "军服",
    "diff": 2,
  ]),
  ([ "quest": "钢刀",
    "diff": 2,
  ]),
});
mapping query_quest() {
  return quest[random(sizeof(quest))];
}
