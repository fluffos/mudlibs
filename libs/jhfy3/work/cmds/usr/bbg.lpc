

// 节庆版 博彩步步高游戏
// bbg.c
// by naihe 04-3
// version 1.2
// 修正了几个小地方，使输入指令方便了些
// 更新了标记的方式，如果玩家有设置，才给他发信息。（即默认不发送） v1.2 05-4-21 17:10


// 这个是改编版的。由巫师设置启动时的底金并由系统无条件赠送，
// 进而由玩家进行简单博彩。玩家互动版 请参看 bubugao.c

// cmds 形式，请将本文件放置于 /cmds/usr/ 或 /cmds/std/ 下。

// P.S:  1.越写越想完善……越写越觉繁琐……各位不要见怪
//	 2.如果没有 ctime_new() 函数，请加入：
// string ctime_new(){ return ctime(time());}

#include <ansi.h>
#include <localtime.h>

// 加入简单的定时开放的功能 :)


// ---------------------  设置 ---------------------

#define		BBG_NAME		"博彩步步高 节庆版"	// 本游戏名字
#define		BBG_LOG_ON		1			// 进行游戏记录, 1=on, 0=off 建议 on
#define		BBG_LOG_FILE		"bbg_jieqingban"	// 记录文件的位置(文件名)
#define		BBG_GAME_ON		1			// 是否开放   1=on, 0=off
								// 为 0 时，游戏完全停止
#define		SPECIAL_OP_MODE_ON	1			// 特殊管理模式生效 1=on, 0=off
								// 生效时，仅能由列表中巫师开始/取消游戏
								// 否则任何巫师均可对游戏进行管理
								// 建议 on
#define		SPECIAL_OP_MODE_WIZLIST "$addisjeams$"
								// 特殊管理模式时，有效管理人员ID
								// 此内ID同时需有任意等级巫师身份方有效。
								// 注意，此值拼写规则如下：
								// 1 人时：	"$naihe$"
								// 2 人以上时：	"$naihe$spark$buwu$"

// 说明：如果希望在MUD一启动时即开始“自动开放”的检测，请将本文件由 preload 文件装载
// 否则，只能在首次载入时方开始检测
#define		BBG_AUTO_RUN_ON		1			// 自动启动游戏，1=on, 0=off  建议 off
								// 具体启动模式请自行更改
								// 参看 void auto_run_set_game()
#define		BBG_AUTO_RUN_CASE_USE		"random"	// 使用何种方案。需与 DEF_SET_GAME_CASE 内键值对应，
								// 否则默认为 “随机”
#define		BBG_AUTO_RUN_SPECIAL_DAY_ON	1		// 到了特殊日期是否开放

mapping		BBG_AUTO_RUN_SPECIAL_DAY = ([			// 特殊日期，用 mapping 是为了看起来舒服~
								// 请自行添加，数字 勿 写成：01,02 等，而写 1,2
	"1.1" : "元旦节",	"2.14" : "西方情人节",
	"4.5" : "清明节",	"5.1" : "劳动节",	"6.1" : "儿童节",	
	"8.1" : "建军节",	"9.10" : "教师节","10.1" : "国庆节",
	"12.25" : "圣诞节",
		]);

#define		BBG_AUTO_RUN_NORMAL_DAY_ON	1		// 平常时是否开放
#define		BBG_AUTO_RUN_NORMAL_DAY		"$1$2$3$4$5$6$7$"		// 平常时若开放，逢星期几开放(可多设或不设)，格式：
								// "$3$6$7$" -- 7 即星期天
#define		BBG_AUTO_RUN_TIME		"$12:5$14:5$16:5$18:5$20:5$22:5$24:5$2:5$4:5$6:5$8:5$9:39$10:5$"
								// 开放当天，开放的具体时间(可多设，至少一)，格式：
								// ({ "9:12", "19:2" })  -- 请勿写如：09, 00 等

#define		DEF_WAIT_TIME		60			// 默认等待挑战时间 (秒) 建议 60
#define		DEF_ROUND_MAX		50			// 默认回合数，至此回合即强制结束 建议 50-100


// 开始游戏时，需对游戏进行设置。
// 而，这一步骤不提供“自定义”的设置，是因为这个游戏的性质是
// “奖励型”的，如果允许巫师进行过分自由的设置，可能导致未知的意外。
// 仅提供了一些经过测试，本人认为可行的方案，可快速设置。
// 而相应的规则：初始奖金 x, 押注金 = x/10, 最高者奖励金 = x/10/3
// 如果觉得这个规则需要更改，请参看 void set_game()

#define		RANDOM_SET_NO_USE		({ })		// 随机选择方案时，不加入随机列表的方案。
								// 可留空 ({ }) 或多项。格式为 string* .
#define		START_SCORE_MAX_TIMES		4
mapping		DEF_SET_GAME_CASE = ([

	"money"	: ({ "money",		"存款",	15000000,	}),
	
	]);

// 数字图案，可自行更改，但请注意： sizeof() == 5，否则需改动相应语句。
mapping pics = ([
	"pic1" : ({ "  ●  ","  ●  ","  ●  ","  ●  ","  ●  ", }),
	"pic2" : ({ " ●● ","    ●"," ●● ","●    "," ●● ", }),
	"pic3" : ({ " ●● ","    ●"," ●● ","    ●"," ●● ", }),
	"pic4" : ({ " ●● ","● ● ","●●●","   ● ","   ● ", }),
	"pic5" : ({ " ●● ","●    "," ●● ","    ●"," ●● ", }),
	"pic6" : ({ "   ● ","  ●  "," ●● ","●  ●"," ●● ", }),
	"pic7" : ({ "●●●","    ●","   ● ","  ●  "," ●   ", }),
	"pic8" : ({ " ●● ","●  ●"," ●● ","●  ●"," ●● ", }),
	"pic9" : ({ " ●● ","●  ●"," ●● ","  ●  "," ●   ", }),
	"pic0" : ({ " ●● ","●  ●","●  ●","●  ●"," ●● ", }),
	]);

// -----------------------------------------------------


// ------------------------------------------------------------

int
	auto_run_is_checking = 0,	// 自动启动游戏的检查标记

	wait_time,			// 等待挑战时间
	round_max,			// 最大回合数
	top_player_gift,		// 最高记录额外奖励
	bet_need,			// 每回合押注所需
	start_score,			// 开始时的总奖金(系统送出)
	now_score,			// 现在的总奖金
	_top_,				// 最高点数
	*numbers,			// 玩家博彩时的数字
	round_now,			// 现在是第几回合
	round_top = 0,			// 最高记录保持了几回合

	end1;

string
	start_time,			// 开始本局的时间(用于 log)
	data_info = "--------",		// 使用何种 me->query() 的数据进行博彩
	data_info_name = "--------",	// 其中文描述
	game_now = "无游戏",		// 游戏状态
	wiz_name = "--------",		// 启动游戏的巫师名字及id
	top_player_name = "--------",	// 当前最高记录者名字及id
	now_player_name = "--------",	// 正在博彩者名字及id
	gogogo_mode,			// 博彩模式，慢/中快
	*top_pic1,			// 表示最高记录数字的“图片”1
	*top_pic2,			// 表示最高记录数字的“图片”2

	end2;

mapping ip_list = ([ ]);		// IP记录，同IP者不得参与同一局游戏

varargs string ctime_new(int t) { if( t<1 ) t = time(); return ctime(t); }

object
	top_player,			// 最高记录者
	now_player,			// 现在游戏者

	end3;

// ------------------------------------------------------------

varargs int help( mixed arg )
{
	write( "
 ------------------- 游戏说明 ---------------------

               "+BBG_NAME+"

    游戏由巫师或系统自动启动及设置奖励细节。规则：

    游戏启动后，由系统送出一定数量的各类“底金”作
  为奖金。此时任何玩家都可以加入游戏(bbg go)，需要
  注意的是，参与博彩的时候将要付出小量的“赌注”。
  “赌注”中的一部分奖励给当前最高记录者；剩下的记
  入总奖金中。

    玩家将随机摇出 9个数字，每个数字范围均为 1~9 。
  如果这 9个数字的总和超过了当前最高记录，那么，该
  玩家成为新一轮的最高记录者。在一定回合后，或一定
  时间内无人继续挑战，则当前最高记录者获胜，可得到
  全部奖金。

    直接输入 <bbg> 可以查询本次游戏的一些信息。而
  如果你觉得信息太多，不想看到这些信息的话，请输入：
                 <bbg no_msg>

    其它游戏指令介绍请输入：<bbg help cmds>

                         By 奈何(naihe) 2004.03.??
                         By 奈何(naihe) 2005.04.21 修改
 --------------------------------------------------\n");

	return 1;
}

int help_cmds()
{
	write("
 -------------------------- 指令介绍 --------------------------

  ===[ 参数 ]=============[ 说明 ]============[ 有效时机 ]===

    check(可省略)       查询游戏状态          任意时间
    go                  参与博彩(慢速)        等待挑战中
    gogo                参与博彩(中速)        等待挑战中
    gogogo              参与博彩(快速)        等待挑战中
    no_msg              设置不再接收
                          本游戏公布的信息    任意时间
    get_msg             取消上述之设置        任意时间

                            巫师指令

    start game          启动游戏              无游戏时
    cancel game         取消游戏（即作废）    游戏中
    chk time            查看现在的系统时间    任意时间

 --------------------------------------------------------------\n");
	return 1;
}    

int filter_listener( object ob )
{
        // 玩家有设置才接收。
        if ( ob->query_temp("bbg_get_msg") )
			return 1;
        return 0;
}

varargs void message_bbg( string msg, int type )
{
	object listener_list, listener;

	if( !msg )
		return;

	if( !type )
	{
		listener_list = filter_array( users(), (: filter_listener :) );
		if( !listener_list || sizeof( listener_list ) < 1 )
			return;
		foreach( listener in listener_list )
		{
			tell_object( listener , HIW"【博彩步步高】 " + msg + NOR);
		}
		return;
	}

	shout( msg );
	write( msg );
	return;
}

string get_show_now_msg();
void set_game( string inp );
void set_game2( string inp, string case_use );
string set_game_by_case( string case_use, int times );
void valid_set_game( string inp );
void valid_cancel_game( string inp );
void start_game();
void reset_settings();
void reset_player_number();
int math_player_number();
string get_numbers_msg();
void game_over();
void gogogo_start();
int get_random_num();
void gogogo_running( int t );
void gogogo_over( string msg );
void auto_run_checking();


void create()
{
	if( BBG_AUTO_RUN_ON && !auto_run_is_checking )
	{
		auto_run_is_checking = 1;
		call_out( "message_bbg", 3, HIW"【博彩步步高】 自动开始游戏的检测启动了。\n\n"NOR, 1 );
		auto_run_checking();
	}

}

void auto_run_set_game( string s )
{
	if( !BBG_AUTO_RUN_ON || !BBG_GAME_ON )
		return;
	// 如果此时已有游戏，取消
	if( game_now != "无游戏" )
		return;

	game_now = "设置中";

	if( set_game_by_case( BBG_AUTO_RUN_CASE_USE, 1 + random(3) ) == "fail" )
	{
		game_now = "无游戏";
		return;
	}

	if( s != "normal" )
		message_bbg( sprintf( 
			HIW"\n\n  ==== 今天是 [%s] ，由系统启动了一局 %s 游戏！祝所有玩家们快乐！ ====\n\n"NOR,
			s, BBG_NAME, ),
		1 );
	else
		message_bbg( sprintf(
			HIW"\n\n  ==== %s 自动启动游戏 ====\n\n"NOR,
			BBG_NAME,),
		1 );
	wiz_name = "系统(----)";
	remove_call_out( "start_game" );
	call_out( "start_game", 1);
}


// 反复检测时间以自动启动游戏
void auto_run_checking()
{
	mixed t;
	string day_msg, week_msg, time_msg, *sp_day_keys, s;
	int is_today;

	remove_call_out( "auto_run_checking" );

	// 防止作弊
	if( !BBG_AUTO_RUN_ON || !BBG_GAME_ON )
		return;

	t = localtime( time() );
	day_msg = sprintf( "%d.%d", t[ LT_MON ] +1, t[ LT_MDAY ] );
	week_msg = sprintf( "$%d$", t[ LT_WDAY ] );
	time_msg = sprintf( "$%d:%d$", t[ LT_HOUR ], t[ LT_MIN ] );

	// 检查特殊日期是否符合
	if( BBG_AUTO_RUN_SPECIAL_DAY_ON && sizeof(BBG_AUTO_RUN_SPECIAL_DAY) )
	{
		sp_day_keys = keys( BBG_AUTO_RUN_SPECIAL_DAY );
		if( member_array( day_msg, sp_day_keys ) != -1 )
		{
			is_today = 1;
			s = BBG_AUTO_RUN_SPECIAL_DAY[ day_msg ];
		}
	}

	// 不是特殊日期，那么检查星期是否符合
	if( !is_today && BBG_AUTO_RUN_NORMAL_DAY_ON )
	{
		if( strsrch( BBG_AUTO_RUN_NORMAL_DAY, week_msg ) != -1 )
		{
			is_today = 1;
			s = "normal";
		}
	}

	if( is_today && strsrch( BBG_AUTO_RUN_TIME, time_msg ) != -1 )
		auto_run_set_game( s );

	call_out( "auto_run_checking", 29 );
}


// ####################################################################
//    ##############################################################
//       ########################################################

int main( object me, string arg )
{
	int wiz, i;
	object ob;
	string t, *key;
	string day_msg, week_msg, time_msg, *sp_day_keys, s;
	mixed ttt;
	
	// 之前的CODE里给玩家设置了一些标记，删掉它们。
	me->delete( "naihe_game_data" );

	if( !userp(me) )
		return 0;

	if( !BBG_GAME_ON )
		return notify_fail( BBG_NAME +" 暂停开放，任何人不得启动或进行游戏。\n");

	if( !arg )
		arg = "check";

	if( arg == "go!" )
		arg = "!@#$%^&#%@";

	if( wizardp(me) )
		wiz = 1;
	else wiz = 0;


	// 逐个参数判断
	switch( arg )
	{
	    case "help cmds":
	    case "help cmd":
	    case "help commands":
	    case "help command":
			return help_cmds();

	    case "get_msg":
			me->set_temp( "bbg_get_msg", "YES" );
			return notify_fail("好的，你已设置“接收关于 "+BBG_NAME+" 的信息”。\n");

	    case "no_msg":
			me->delete_temp( "bbg_get_msg" );
			return notify_fail("好的，你已设置“不接收关于 "+BBG_NAME+" 的信息” 的设置。\n");

	    case "start game":
	    case "new":
	    case "start":
			if( !wiz )
				return notify_fail("本指令仅由巫师执行。\n");
			if( SPECIAL_OP_MODE_ON && strsrch( SPECIAL_OP_MODE_WIZLIST,"$"+getuid(me)+"$" ) == -1 )
				return notify_fail("本指令仅由指定巫师执行。\n");
			if( game_now != "无游戏" )
				return notify_fail("游戏非无游戏状态 ("+game_now+") ，如需重开，"
							"请先结束当前局<bbg cancel game>，或直接更新本文件。\n");
			key = keys( DEF_SET_GAME_CASE );
			if( !key || !sizeof(key) )
				return notify_fail("游戏默认的设置方案发生了意外，无法进行游戏设置。\n");

			game_now = "设置中";
			write("要开始游戏，必须先对游戏进行必要的设置，请先选择默认的设置方案。\n");
			t = HIM"--[ 方案 ]---------[ 方案名 ]--------[ 使用数据名 ]----[ 基本底金 ]--\n";
			for( i=sizeof(key)-1; i>=0; i-- )
			{
				t += sprintf( "  %-16s  %-16s  %-16s  %10d\n",
					"["+key[i]+"]", DEF_SET_GAME_CASE[key[i]][1],"\""+DEF_SET_GAME_CASE[key[i]][0]+"\"",
					DEF_SET_GAME_CASE[key[i]][2],);
			}
			t += HIY"---------------------------------------------------------------------\n"NOR+
				"请选择方案或取消(cancel)：";
			write( t );
			input_to( "set_game" );
			return 1;

		case "chk time":
			if( !wiz )
				return notify_fail("本指令仅由巫师执行。\n");

			ttt = localtime( time() );
			day_msg = sprintf( "%d.%d", ttt[ LT_MON ] +1, ttt[ LT_MDAY ] );
			week_msg = sprintf( "$%d$", ttt[ LT_WDAY ] );
			time_msg = sprintf( "$%d:%d$", ttt[ LT_HOUR ], ttt[ LT_MIN ] );
			return notify_fail( sprintf( "现在时间： %s   %s   %s\n", day_msg, week_msg, time_msg ));

	    case "cancel game":
			if( !wiz )
				return notify_fail("本指令仅由巫师执行。\n");
			if( SPECIAL_OP_MODE_ON && strsrch( SPECIAL_OP_MODE_WIZLIST,"$"+getuid(me)+"$" ) == -1 )
				return notify_fail("本指令仅由指定巫师执行。\n");
			if( game_now == "无游戏" || game_now == "设置中" )
				return notify_fail("游戏非进行状态 ("+game_now+") ，如需再次恢复无游戏，"
						"请先终止（如果正处于）设置状态，或直接更新本文件。\n");

			write("你确定要终止本局游戏吗(当前结果均作废)(y/n)？ [n]");
			input_to( "valid_cancel_game" );
			return 1;

	    case "check":
			write( get_show_now_msg() );
			return 1;

	    case "go":
			me->set_temp("bbg_gogogo_mode", "慢速");
			arg = "go!";
			break;
	    case "gogo":
			me->set_temp("bbg_gogogo_mode", "中速");
			arg = "go!";
			break;
	    case "gogogo":
			me->set_temp("bbg_gogogo_mode", "快速");
			arg = "go!";
			break;
	}

	if( arg == "go!" )
	{
		if( game_now != "等待挑战" )
			return notify_fail("游戏非 等待挑战 状态 (现在是 "+game_now+" ) ！\n");
		if( me == top_player )
			return notify_fail("你的点数现在是最领先的了！\n");
		if( me->query_temp("bbg_freetime") > time() )
			return notify_fail("你才刚博彩没多久，总要给别人一些机会吧！\n");
		t = query_ip_name(me);
		if( !undefinedp( ip_list[ t ] ) && ip_list[ t ] != getuid(me) )
			return notify_fail("这一局博彩游戏已经有与你相同IP的人参加了 ("+ip_list[t]+")。\n");
		if( me->query( data_info ) < bet_need )
			return notify_fail( sprintf( "至少需要赌注：(%s : %d gold)，你有：%d gold\n",
				data_info_name,bet_need/10000,me->query( data_info )/10000 ));

		// 参与游戏者，当然要接收游戏的信息
		me->set_temp( "bbg_get_msg", "YES" );

		if( !top_player && round_now != 1 )
		{
			message_bbg( HIY"由于之前的最高记录者发生了意外，最高记录恢复为零了！！！太幸运了！！！\n"NOR );
			_top_ = 0;
			top_player_name = "--------";
		}

		message_bbg( sprintf( NOR+WHT"%s(%s)"NOR+WHT"押下了赌注(%s : %d gold)，准备开始博取大奖！\n"NOR,
				me->query("name"), me->query("id"), data_info_name, bet_need/10000 ));

		now_score += bet_need - top_player_gift;
		message_bbg( sprintf( NOR+WHT"赌注的一部分(%d) gold %s！余下的记入总奖金，现在总奖金共 %d gold！\n"NOR,
				top_player_gift/10000,
				top_player ? "支付给之前的最高记录者 "+top_player_name +" 了"
					   : "充公了",
				now_score/10000, ));

		if( top_player )
		{
			tell_object( top_player, sprintf(HIW"你收到了步步高游戏最高记录者奖励(%s : %d gold)。\n"NOR,
				 data_info_name, top_player_gift/10000 ));
			top_player->add( data_info, top_player_gift );
		}

		ip_list[ t ] = getuid(me);
		me->add( data_info , -bet_need );

		wiz = DEF_WAIT_TIME / 3;
		if( wiz < 25 )
			wiz = 25;
		me->set_temp("bbg_freetime", time() + wiz );

		game_now = "博彩中";
		gogogo_mode = me->query_temp("bbg_gogogo_mode");
		now_player = me;
		now_player_name = sprintf( "%s(%s)", me->query("name"), getuid(me) );
		remove_call_out( "waitting_player" );
		remove_call_out( "gogogo_start" );
		call_out( "gogogo_start", 1 );
		return 1;
	}

	write("没有这个指令，请输入 <bbg help cmds> 查询。\n");
	return 1;
}

//       ########################################################
//    ##############################################################
// ####################################################################


void valid_cancel_game( string inp )
{
	object me = this_player();

	if( !me || !wizardp(me) )
		return;

	if( game_now == "无游戏" || game_now == "设置中" )
	{
		write("  这会儿游戏已经非进行状态 ("+game_now+") 了，不必取消。\n");
		return;
	}

	if( !inp || (inp!="y" && inp!="Y") )
	{
		write( "  好的，取消了作废游戏的指令，游戏继续进行。\n");
		return;
	}
	if( BBG_LOG_ON )
		log_file( BBG_LOG_FILE, sprintf(
			"    在 %s 启动的游戏被 %s 强制取消，\n"
			"    于 %s 。参与人数：%d  经过回合：%d  总奖金：%d\n",
			start_time, sprintf( "%s(%s)",me->query("name"), getuid(me) ),
			ctime_new(),sizeof( ip_list ), round_now, now_score, )
		);

	remove_call_out("waitting_player");
	remove_call_out("gogogo_start");
	remove_call_out("gogogo_running");
	remove_call_out("gogogo_over");
	remove_call_out("game_over");
	write("  好的，游戏被终止了，余下的部分被作废。游戏恢复为 无游戏 状态。\n");
	message_bbg( sprintf( HIR"\n\n    ====  %s 本局游戏被 %s"HIR"(%s) 终止了，余下的部分全部作废。 ====\n\n\n"NOR,
			BBG_NAME, me->query("name"), getuid(me) ), 
		1 );

	reset_settings();
	game_now = "无游戏";
	return;
}

string set_game_by_case( string case_use, int times )
{
	string *key;
	mixed c;

	if( !BBG_GAME_ON || game_now != "设置中" )
		return "";

	key = keys( DEF_SET_GAME_CASE );
	if( !key || !sizeof( key ) || times < 1 || times > START_SCORE_MAX_TIMES )
	{
		return "fail";
	}

	if( member_array( case_use, key ) == -1 )
		case_use = "random";
	if( case_use == "random" )
	{
		key -= RANDOM_SET_NO_USE;
		if( !key || !sizeof( key ) )
			return "fail";
		case_use = key[ random(sizeof(key)) ];
	}

	reset_settings();
	c = DEF_SET_GAME_CASE[ case_use ];
	data_info = c[0];
	data_info_name = c[1];
	start_score = c[2] * times;
	now_score = start_score;
	bet_need = start_score / 10;	
	top_player_gift = start_score / 30;
	if( bet_need < 3 )
		bet_need = 3;
	if( bet_need <= top_player_gift )
		top_player_gift = bet_need / 3;
	round_max = DEF_ROUND_MAX;
	wait_time = DEF_WAIT_TIME;

	return sprintf( "[%s] (%d倍)", data_info_name, times );
}

void set_game( string inp )
{
	object me = this_player();
	string *key;

	if( !me || !wizardp(me) )
	{
		game_now = "无游戏";
		return;
	}

	if ( !inp || inp == "cancel" || inp == "q" || inp == "Q" )
	{
		write("  好的，设置取消了。游戏恢复为 无游戏 状态。\n");
		game_now = "无游戏";
		return;
	}

	key = keys( DEF_SET_GAME_CASE );
	if( !key || !sizeof(key) || member_array( inp, key ) == -1 )
	{
		write("没有这个方案。请重新选择方案或取消(cancel)：");
		input_to( "set_game" );
		return;
	}

	write( "请为此方案设置一个基数(1~"+START_SCORE_MAX_TIMES+")或取消(cancel)：");
	input_to( "set_game2", inp );
	return;
}

void set_game2( string inp, string case_use )
{
	object me = this_player();
	int times;
	string msg;

	if( !me || !wizardp(me) || !case_use )
	{
		game_now = "无游戏";
		return;
	}

	if ( !inp || inp == "cancel" || inp == "q" || inp == "Q" )
	{
		write("  好的，设置取消了。游戏恢复为 无游戏 状态。\n");
		game_now = "无游戏";
		return;
	}
	sscanf( inp, "%d", times );
	if( times < 1 || times > START_SCORE_MAX_TIMES )
	{
		write( "设置有误。请为此方案设置一个基数(1~"+START_SCORE_MAX_TIMES+")或取消(cancel)：");
		input_to( "set_game2", case_use );
		return;
	}

	msg = set_game_by_case( case_use, times );
	if( msg == "fail" )
	{
		write("设置游戏的时候发生了意外，无法启动游戏。\n");
		game_now = "无游戏";
		return;
	}
	write( "  好的，方案是 "+msg+" .请检查设置的细节，如果确定，将开始游戏。\n");
	write( sprintf(HIM" ----------[ 请检查您的设置 ]----------
  方案：           %s
  data:            query( \"%s\" )
  基本设置底金：   %dgold  (x%d)

  实际开始底金：   %dgold
  押注需要：       %dgold
  最高记录者奖励： %dgold
  最大回合数：     %d  回合
  等待挑战时间：   %d  秒
 --------------------------------------\n"NOR,
	data_info_name, data_info, (start_score/10000) / times, times,
	start_score/10000, bet_need/10000, top_player_gift/10000, round_max, wait_time,
	));

	write("你确定吗(y/n)？ [n]");
	input_to( "valid_set_game" );
}

void valid_set_game( string inp )
{
	object me = this_player();

	if( !me || !wizardp(me) )
	{
		game_now = "无游戏";
		return;
	}

	if( !inp || (inp != "y" && inp != "Y" ) )
	{
		write("  好的，设置取消了。游戏恢复为 无游戏 状态。\n");
		game_now = "无游戏";
		return;
	}

	write("  好的，游戏将于 1 秒后启动！\n");
	wiz_name = sprintf("%s(%s)", me->query("name"), getuid(me) );
	remove_call_out("start_game");
	call_out("start_game", 1);
	return;
}


void start_game()
{
	object usr, *us;
	
	game_now = "等待挑战";

	start_time = ctime_new();

	if( BBG_LOG_ON )
		log_file( BBG_LOG_FILE, sprintf( "\n◆◆◆ %s 由 %s 启动游戏：%s(%s) : %d ◆◆◆\n",
				start_time, wiz_name, data_info_name, data_info, start_score ) );

	// 将在线玩家的“接收信息”的标记都删掉。这样可以让每个想接收信息的玩家自行设置。
	us = users();
	foreach( usr in us )
	{
		usr->delete_temp( "bbg_get_msg");
		usr->delete_temp("bbg_freetime");
	}

	message_bbg( HIW"\n\n    ==== " + BBG_NAME +" 新一局的博彩开始了！！！任何玩家均有机会获得大奖！====\n\n"
		"            =====  若你想参与游戏，请输入 <bbg get_msg> 指令才能接收信息！====\n"
		"            ==========  请输入 <help bbg> 或 <bbg> 指令查询其它信息  =========\n\n\n"NOR,
		1 );

	reset_player_number();

	message_bbg( sprintf( HIW"  ==== 第 %d 轮开始了！总奖金 (%s : %d gold) ====\n"NOR,
			round_now, data_info_name, now_score/10000, ));
	remove_call_out("waitting_player");
	call_out("waitting_player", 1, wait_time );
}


void waitting_player( int t )
{
	remove_call_out( "waitting_player" );

	if( t <= 0 )
	{
		game_over();
		return;
	}

	if( t % 10 == 0 || t == 3 )
	{
		message_bbg( sprintf( HIY"快快快！还剩 %d 秒，如果没人挑战<bbg go>，%s ！\n"NOR,
			t,
			top_player ? sprintf( "%s 将得到全部奖金了(%s : %d gold)",top_player_name,data_info_name,now_score/10000,)
				   : sprintf( "这一局的全部奖金就要作废了(%s : %d gold)", data_info_name,now_score/10000,)
			));
	}

	call_out("waitting_player", 1, t - 1);
}


void reset_settings()
{
	data_info = "--------";
	data_info_name = "--------";
	start_score = 0;
	now_score = 0;
	bet_need = 0;
	top_player_gift = 0;
	_top_ = 0;
	round_now = 1;
	round_top = 0;
	top_player = 0;
	now_player = 0;
	ip_list = ([ ]);
	top_pic1 = pics[ "pic0" ];
	top_pic2 = pics[ "pic0" ];
	top_player_name = "--------";
	now_player_name = "--------";
	wiz_name = "--------";
}


void reset_player_number()
{
	numbers = ({ 0,0,0,0,0,0,0,0,0, });
}


string get_numbers_msg()
{
	return sprintf( "%s %s %s %s %s %s %s %s %s",
		!numbers[0] ? "-" : numbers[0] + "",
		!numbers[1] ? "-" : numbers[1] + "",
		!numbers[2] ? "-" : numbers[2] + "",
		!numbers[3] ? "-" : numbers[3] + "",
		!numbers[4] ? "-" : numbers[4] + "",
		!numbers[5] ? "-" : numbers[5] + "",
		!numbers[6] ? "-" : numbers[6] + "",
		!numbers[7] ? "-" : numbers[7] + "",
		!numbers[8] ? "-" : numbers[8] + "",
	);
}

int math_player_number()
{
	int i, num;
	for(i=0;i<9;i++)
	{
		num += numbers[ i ];
	}
	return num;
}


void gogogo_start()
{
	object me = this_player();

	remove_call_out( "gogogo_start" );

	if( game_now != "博彩中" )
		return;
	if( !me || !now_player )
		return gogogo_over( "失踪了" );
	if( me != now_player )
		return gogogo_over( "有意外情况" );

	reset_player_number();

	message_bbg( sprintf(
		NOR+WHT"[%s]  [ %s ]  =  "HIR" 0"NOR+WHT" ("HIY"81"NOR+WHT")  "
		"领先记录："HIW"%d"NOR+WHT"  奖金："HIC"%d"NOR+WHT"  (%s)\n"NOR,
			now_player_name, get_numbers_msg(),_top_,
			now_score, me->query_temp( "bbg_gogogo_mode" ), 
		) );

	remove_call_out( "gogogo_running" );
	call_out( "gogogo_running", 1, 0);
}

int get_random_num()
{
	int n;

	// 之前的数回合中，总数控制为较低状态
	if( round_now < round_max / 2 )
	{
		// 有机会可得到正常的随机数
		if( !random(3) )
			n = 1+random(9);
		// 否则是控制为较低的随机数
		else
			n = 1+random(6);
	}
	else
	{
		// 之后往高方向走
		// 越接近后面的回合，越容易得到控制为较高的随机数
		if( !random( (round_max+2) - round_now) )
			n = 4+random(6);
		// 否则，得到正常的随机数
		else 
			n = 1+random(9);
	}
	return n;
}

void gogogo_running( int t )
{
	object me = this_player();
	string mode;
	int i, ttt, n;

	remove_call_out( "gogogo_running" );

	if( game_now != "博彩中" )
		return;
	if( !me || !now_player )
		return gogogo_over( "博彩者失踪" );
	if( me != now_player )
		return gogogo_over( "发生了意外" );

	mode = me->query_temp("bbg_gogogo_mode");

	switch( mode )
	{
		case "快速":
			ttt = 9;
			break;

		case "中速":
			ttt = t + 3;
			break;

		default:
			ttt = t + 1;
			break;
	}

	for( i=t; i<ttt; i++ )
		numbers[ i ] = get_random_num();

	n = math_player_number();

	// 这里显示当前的结果
	message_bbg( sprintf(
		NOR+WHT"[%s]  [ %s ]  =  "HIR"%2d"NOR+WHT" ("HIY"%2s"NOR+WHT")  "
		"领先记录："HIW"%d"NOR+WHT"  奖金："HIC"%d"NOR+WHT"  (%s)\n"NOR,
			now_player_name, get_numbers_msg(), n,
			ttt == 9 ? n > _top_ ? BLINK+HIG"WIN!"NOR : BLINK+HIR"LOST"NOR : (n + (9-ttt)*9 ) + "",
			_top_, now_score, me->query_temp( "bbg_gogogo_mode" ), 
		) );

	if( ttt < 9 )
	{
		call_out( "gogogo_running", 1, ttt );
		return;
	}

	call_out( "gogogo_over", 1, "完毕" );
}

void gogogo_over( string msg )
{
	int t;

	remove_call_out( "gogogo_over" );

	if( game_now != "博彩中" )
		return;

	// 意外情况结束的
	if( msg != "完毕" )
	{
		message_bbg( sprintf( HIY"由于%s，本轮博彩的结果无效。之前的领先记录不变！\n"NOR, msg ));
		round_top ++;
	}
	else
	{
		// 那么开始常规判断
		t = math_player_number();
		if( t > _top_ )
		{
			message_bbg( sprintf( HIG"%s的点数为 %d ，超过了现在的领先记录 %d ！\n"NOR,
				now_player_name, t, _top_ ) );
			message_bbg( sprintf( HIG"%s是现在的领先者了！！！\n"NOR, now_player_name, ));
			_top_ = t;
			top_player_name = now_player_name;
			top_player = now_player;
			round_top = 1;
			top_pic1 = pics[ "pic"+ (_top_/10) ];
			top_pic2 = pics[ "pic"+ (_top_%10) ];
		}
		else
		{
			message_bbg( sprintf( HIM"%s的点数为 %d ，没能超过现在的领先记录 %d ，博彩失败了。^0^\n"NOR,
				now_player_name, t, _top_ ));
			round_top ++;
		}
	}

	now_player = 0;
	now_player_name = "--------";

	if( round_now >= 50 )
	{
		remove_call_out( "game_over" );
		call_out( "game_over", 1 );
		return;
	}

	round_now ++;
	game_now = "等待挑战";
	message_bbg( sprintf( HIW"  ==== 第 %d 轮开始了！总奖金 (%s : %d gold) ====\n"NOR,
			round_now, data_info_name, now_score/10000, ));
	remove_call_out( "waitting_player" );
	call_out("waitting_player", 2, wait_time );
}


void game_over()
{
	if( !top_player )
	{
		if( BBG_LOG_ON )
			log_file( BBG_LOG_FILE, sprintf(
				"    在 %s 启动的游戏正常结束，无人获奖，\n"
				"    于 %s 。参与人数：%d  经过回合：%d  总奖金：%d gold\n",
				start_time, ctime_new(), sizeof( ip_list ), round_now, now_score/10000 )
			);

		message_bbg( sprintf(
			HIW"\n\n    ==== 太遗憾了！%s 这一局的全部奖金(%s : %d gold)无人获得，游戏结束了。====\n\n\n"NOR,
			BBG_NAME, data_info_name, now_score/10000),
			1 );
		reset_settings();
		game_now = "无游戏";
		return;
	}

	if( BBG_LOG_ON )
		log_file( BBG_LOG_FILE, sprintf(
			"    在 %s 启动的游戏正常结束，%s 获奖，\n"
			"    于 %s 。参与人数：%d  经过回合：%d  总奖金：%d gold\n",
			start_time, top_player_name, ctime_new(), sizeof( ip_list ), round_now, now_score/10000 )
		);
	message_bbg( sprintf(
		HIW"\n\n    ==== %s 本局游戏结束了！最终的胜利者是 %s ！====\n\n"
		"胜利者的点数是 %d ，它保持了 %d 个回合，终于在总第 %d 回合后无人挑战，而获得了胜利！\n\n"
		"  ========== 恭喜 %s 独得全部奖金(%s : %d gold)！！！游戏结束了。==========\n\n\n"NOR,
			BBG_NAME, top_player_name, _top_, round_top, round_now,
			top_player_name, data_info_name, now_score/10000 ),
			1 );
	tell_object( top_player, sprintf(HIW"恭喜你获得了奖金(%s : %d gold)。\n"NOR,data_info_name, now_score/10000) );
	top_player->add( data_info, now_score );
	reset_settings();

	remove_call_out( "game_over" );
	remove_call_out( "gogogo_start" );
	remove_call_out( "gogogo_running" );
	remove_call_out( "gogogo_over" );
	remove_call_out( "waitting_player" );

	game_now = "无游戏";
	return;
}


string get_show_now_msg()
{
	string msg, msg2, msg3;

	if( !top_pic1 || !top_pic2 || sizeof(top_pic1) != 5 || sizeof(top_pic2) != 5 )
	{
		top_pic1 = pics[ "pic0" ];
		top_pic2 = pics[ "pic0" ];
	}
	switch( game_now )
	{
		case "等待挑战":
			msg3 = HIG;
			msg2 = HIG"*********  请输入 <"HIY"bbg go"HIG"> 参与博彩！！！ *********"NOR;
			break;
		case "博彩中":
			msg3 = HIM;
			msg2 = HIR+"** "+now_player_name+HIR+" 博彩中(当前点数："+math_player_number()+")！！！请稍等 **"NOR;
			break;
		default:
			msg3 = NOR;
			msg2 = "*********            无游戏             *********";
			break;
	}

	msg = sprintf( "%s  ============================================================"NOR"
    博彩步步高 节庆版                       By naihe 2004.03

                     第 "HIY"%2d"NOR" 轮  (剩余 "HIY"%2d"NOR" 轮)
                   %s★☆★☆★☆★☆★☆★☆★
                   ☆                      ☆
                   ★"HIR"%|14dgold%s    ★
                   ☆                      ☆
                   ★☆★☆★☆★☆★☆★☆★"NOR"

       [ 押注需要 ]   |"HIC"  %s  "NOR"|   [ 现在状态 ]
   "HIY"%10dgold"NOR"     |"HIC"  %s  "NOR"|    \"%s\"
                      |"HIC"  %s  "NOR"|
       [ 您的资本 ]   |"HIC"  %s  "NOR"|   [ 彩金类型 ]
    "HIY"%10dgold"NOR"    |"HIC"  %s  "NOR"|     %s
      
    领先：%s  ( "HIC"%d"NOR" / 81 )  保持回合：%d
    巫师：%s  底金：%d gold 已参与人数：%d

       %s
  %s============================================================\n"NOR,

		msg3,
		round_now, round_max - round_now,
		msg3,
		now_score/10000,
		msg3,
		top_pic1[0] + " " + top_pic2[0],
		bet_need/10000,
		top_pic1[1] + " " + top_pic2[1],
		game_now,
		top_pic1[2] + " " + top_pic2[2],
		top_pic1[3] + " " + top_pic2[3],
		this_player()->query( data_info )/10000,
		top_pic1[4] + " " + top_pic2[4],
		data_info_name,
		top_player_name, _top_, round_top,
		wiz_name, start_score/10000, sizeof( ip_list ),
		msg2,msg3,
	);

	return msg;
}

