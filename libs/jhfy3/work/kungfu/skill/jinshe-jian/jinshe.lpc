//jinshewandao.c
#include <ansi.h>
inherit F_SSERVER;
int perform(object me, object target) {
  int damage;
  string msg;
  object weapon;

  if (!target) target = offensive_target(me);
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail(RED "施展「金蛇万道」必须拿把剑吧？\n" NOR);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("「金蛇万道」只能在战斗中使用。\n");
  if ((int)me->query_skill("jinshe-jian", 1) < 1000)
    return notify_fail(WHT "你的金蛇剑法还不到家，无法使用金蛇万道.\n" NOR);
  if ((int)me->query("max_neili") < 200000)
    return notify_fail(RED "你的内力修为不够。\n" NOR);
  if ((int)me->query("neili") < 100000) {
    return notify_fail(HIC "你的真气不够。\n" NOR);
  }
  msg = HIY "$N暗运真气，身随剑走，绵绵而上，猛然大喝一声，使出一招“金蛇万道”，这招剑法虽是一招，其中便如有千百招同时发出一般。\n" NOR;
  if (random(me->query_skill("sword")) > target->query_skill("dodge") / 2 ||
    random(me->query_skill("dodge")) > (int)target->query_skill("dodge") / 2) {
    me->start_busy(2);
    target->start_busy(random(3));
    damage = (int)me->query_skill("jinshe-jian", 1) * 2;
    damage = (damage + random(damage)) * 2;
    target->receive_damage("qi", damage);
    target->receive_wound("qi", damage);
    target->receive_damage("jing", damage);
    target->receive_wound("jing", damage);
    msg += RED "漫天剑花向$n袭来，$n大惊！猛然觉得胸口一阵刺痛！\n" NOR;
    me->add("neili", -damage / 2);
  } else {
    me->start_busy(4);
    msg += HIG "$p瞧不清敌招来路，只得疾退闪避。\n" NOR;
    me->add("neili", -5000);
  }
  message_vision(msg, me, target);
  if (!target->is_fighting(me)) target->fight_ob(me);
  //	if(userp(target)) target->fight_ob(me);
  //	else if( !target->is_killing(me) ) target->kill_ob(me);
  return 1;
}
