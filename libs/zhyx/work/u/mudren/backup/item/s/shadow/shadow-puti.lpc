#include <ansi.h>
#include <weapon.h>

inherit DAGGER;
inherit F_MINGREN_ITEMMAKE;

void create()
{
	set_name("[1;32m菩提子[2;37;0m", ({ "puti" }));
	set_weight(15000);
	set("item_make", 1);
	set("unit", "支");
	set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一支短兵。
[1;32m这是一颗晶莹如玉的菩提子，采自灵山佛祖座前，珍稀无比，
乃万年菩提树之实，功能化百劫，渡千灾，与天地同寿。[2;37;0m
短兵柄上刻着一行小字：影舞(shadow)
");
	set("value", 2100000);
	set("point", 136);
	set("materail", "magic stone");
	set("wield_msg", "$N拿出一颗[1;32m菩提子[2;37;0m，握在手中。[2;37;0m\n");
	set("unwield_msg", "$N把[1;32m菩提子[2;37;0m收回包囊。[2;37;0m\n");
	restore();
	init_dagger(apply_damage());

	setup();
}

string long() { return query("long") + item_long(); }
