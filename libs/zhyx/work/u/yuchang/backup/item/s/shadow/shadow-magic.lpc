#include <ansi.h>
#include <armor.h>

inherit CLOTH;
inherit "/feature/mingren_itemmake.lpc";

void create()
{
	set_name("[1;32m天香玉露[2;37;0m", ({ "magic" }));
	set_weight(1400);
	set("item_make", 1);
	set("unit", "张");
	set("long", "这是由[1;37m冰蚕丝[2;37;0m炼制而成的一张甲。
[1;32m这是附着在灵芝上的一滴晶莹剔透的玉露，传说采自
灵山，千年来以灵芝为母，不断的吸取着日精月华，
具有着无比神奇的功效。[2;37;0m
甲缘上刻着一行小字：影舞(shadow)
");
	set("value", 2100000);
	set("point", 173);
	set("materail", "silk");
	set("wear_msg", "$N拿出一滴$n，握在手中。[2;37;0m\n");
	set("remove_msg", "$N你把$n收回包囊。[2;37;0m\n");
	restore();
	set("armor_prop/armor", apply_armor());

	setup();
}

string long() { return query("long") + item_long(); }
