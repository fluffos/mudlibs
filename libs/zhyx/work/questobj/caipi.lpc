#include <ansi.h>
inherit ITEM;
void create()
{
    set_name(HIC"醉仙楼菜谱" NOR, ({ "caipu" }) );
    set_weight(1);
    if( clonep() )
            set_default_object(__FILE__);
    else {
            set("unit", "本");
            set("material", "stone");
            set("long", "一本醉仙楼菜谱\n");
          }
    setup();
}
