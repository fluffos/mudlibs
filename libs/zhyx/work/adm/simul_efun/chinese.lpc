
string chinese_number(int i)
{
	return CHINESE_D->chinese_number(i);
}

string to_chinese(string str)
{
	return CHINESE_D->chinese(str);
}

int is_chinese(string str)
{
	int i;

	// Original was a byte-oriented GBK lead/trail-byte-range check
	// (str[i] < 161, an i%2==0 lead-byte gate) -- this driver's
	// strings are UTF-8 codepoint-indexed, not raw GBK bytes, so that
	// check rejected every real Chinese character. Rewritten as a CJK
	// Unified Ideographs codepoint range check (see AGENTS.md's
	// yh2003-lineage write-up, e.g. yanhuangwuhun NOTES.md, for the
	// same fix in a sibling codebase).
	if( strlen(str) < 1 ) return 0;

	for( i= 0; i < strlen(str); i++)
	{
		if( str[i] < 0x4e00 || str[i] > 0x9fff ) return 0;
	}

	return 1;
}

