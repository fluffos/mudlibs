int accept_fight(object ob)
{
	object me  = this_object();
		
	if ( me->query("winner") == ob->query("id") ) 
		return notify_fail("你跟你自己打什么架？！\n");

	if (wizardp(this_player()))
		return notify_fail("巫师不能抢罗汉堂首座之位！\n");
         if (me->query("family/family_name")!="少林寺")
        return notify_fail("你不是少林寺弟子，不能争夺罗汉堂首座！\n");

	if ( me->is_fighting() ) 
		return notify_fail("已经有人正在挑战少林寺罗汉堂首座之位！\n");

	command("enable all");
	me->set("eff_qi", me->query("max_qi"));
	me->set("qi",     me->query("max_qi"));
	me->set("jing",   me->query("max_jing"));
	me->set("neili",  me->query("max_neili"));

	remove_call_out("checking");
	call_out("checking", 1, me, ob);
	
	return 1;
}

void checking(object me, object ob)
{

	object obj;
	int my_max_qi, his_max_qi;

	if (!ob) return;
	my_max_qi  = me->query("max_qi");
	his_max_qi = ob->query("max_qi");

	if (me->is_fighting(ob)) {
		if (me->query("qi") * 100 / my_max_qi < 70)
			command("exert recover");

		call_out("checking", 1, me, ob);
		return;
	}

	if ( !present(ob, environment()) ) return;

	if (( (int)me->query("qi")*100 / my_max_qi) <= 50 ) {
		command("say 恭喜" + ob->query("name") + "成为少林寺「罗汉堂首座」！\n");
		remove_call_out("do_copy");
		call_out("do_copy", 1, me, ob);
		return;
	}

	if (( (int)ob->query("qi")*100 / his_max_qi) <= 50 )
		command("say 看来" + RANK_D->query_respect(ob) + 
			"还得多加练习，方能在当今武林中出人头地！\n");
}

int do_copy(object me, object ob)
{
	object ob1, ob2;
	string mengzhu, shanshang, fae;

	seteuid(getuid());

	me->add("generation", 1);	

	me->set("name",  ob->query("name") );
	me->set("title", "第" + chinese_number(me->query("generation")) + "任「罗汉堂首座」");
	me->set("short", me->query("title") + " " + me->query("name") + "(" + capitalize(ob->query("id")) + ")");
	me->set("long", ob->long(1));

	ob->set_temp("apply/short", ({me->query("short")}));
	
	me->set("short", me->query("title") + " " + me->query("name") + "(luohantang shouzuo)");
	me->delete("title");

	remove_call_out("do_clone");
	call_out("do_clone", 0, me, ob);

	return 1;
}

