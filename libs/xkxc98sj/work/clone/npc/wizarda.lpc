// wizarda.c

inherit NPC;

int ask_name();

void create()
{
	set_name("巫师A",({ "wizarda", "wizard", "wushia", "wushi" }) );
        set("gender", "男性" );
        set("age", 27);
        set("long", "这是一个成天戴着面具的巫师。\n");

        set("str", 17);
        set("dex", 16);
        set("con", 15);
        set("int", 17);
	set("shen_type", 1);
        set_temp("apply/defense", 10);
        set("combat_exp", 100);
        set("attitude", "peaceful");

        setup();

	set("inquiry", ([
		"name": (: ask_name :),
		"rumors": "听说9月12日下午进行比武大会。",
		"here": "我很忙，有什么事待会再说吧！",
		"yuj": "闪电在吗？",
		"闪电": "闪电在吗？",
	]) );

        carry_object("/clone/misc/cloth")->wear();
}

int ask_name()
{
	object ob = this_player();

	say("巫师A赶忙掏出一个面具带上。\n");
	set("name", "某人");
	command("hehe " + ob->query("id"));
	say("某人摘下了一个面具。\n");
	set("name", "巫师A");
	say("这么喜欢隐形，不会是YUJ吧？\n");
	return 1;
}
