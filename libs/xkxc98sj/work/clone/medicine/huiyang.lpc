#include <ansi.h>
inherit COMBINED_ITEM;

void create()
{
   set_name("回阳五龙膏", ({"huiyang wulonggao", "huiyang","wulonggao", "gao"}));
   if (clonep())
      set_default_object(__FILE__);
   else {
      set("unit", "些");
      set("heal_up", 1);
      set("long","这是一包由草乌制成的崆峒派伤药。\n");
      set("base_value", 10000);
      set("base_unit", "份");
      set("base_weight", 30);
   }
   set_amount(1);
}

int init()
{
   add_action("do_eat", "fu");
}

int do_eat(string arg)
{

   if(!id(arg))
       return notify_fail("你要吃什么？\n");

   if ((int)this_player()->query("eff_qi") == 
       (int)this_player()->query("max_qi"))
           return notify_fail("你现在不需要用回阳五龙膏。\n");
   else {
        this_player()->receive_curing("qi", 100+random(100));
        message_vision("$N服下一份回阳五龙膏，脸色看起来好多了。\n", this_player());
        add_amount(-1);
        return 1;
        }
}
