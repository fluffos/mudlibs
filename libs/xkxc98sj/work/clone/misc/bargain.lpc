// bargain.c
// 地契

inherit ITEM;

void create() {
  set_name("地契", ({ "bargain", "di qi", "qi" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一张用来买商店地契，你可以在上面写(write)点什么"
      "或者签上大名(sign)。\n");
    set("unit", "张");
    set("value", 1000000);
  }
}

void init() {
  add_action("do_write", "write");
  add_action("do_sign", "sign");
}

int do_write(string arg) {
  object me = this_player();
  string type, msg, now_type;
  string *types;
  int money;

  if (!arg)
    return notify_fail("你要写些什么？\n");

  if (sscanf(arg, "%s %s", type, msg) != 2)
    return notify_fail("你要写些什么？\n");

  else {
    switch (type) {
      case "type":
        {
          if (member_array(msg, types = SHOP_D->get_types()) == -1)
            return notify_fail("允许写的类型只有：" +
              implode(types, " 和 ") + "。\n");
          else {
            set("shop/type", msg);
            return 1;
          }
        }

      case "money":
        {
          money = atoi(msg);
          if (!now_type = query("shop/type"))
            return notify_fail("你先写上要开的店铺的类型吧。\n");

          if (money < SHOP_D->query_money_required(now_type))
            return notify_fail(sort_msg(SHOP_D->chinese_type(now_typle) + "这种店铺"
              "至少得有" + MONEY_D->money_str(money) + "才能开。\n"));
          case "name":
          default: return notify_fail("没有这种类型。\n");
        }
    }
  }

  string long() {
    string msg;
  }
