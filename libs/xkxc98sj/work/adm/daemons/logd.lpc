// logd.c

#include <ansi.h>

#define CHECK_PERIOD    86400   // 每天检查一次

inherit F_DBASE;
inherit F_SAVE;

string query_save_file() { return DATA_DIR "logd"; }

void create()
{
        seteuid(ROOT_UID);
        set("channel_id", "日志精灵");
        CHANNEL_D->do_channel(this_object(), "sys",
                              "日志系统已经启动。");
        if (! restore())
        {
                set("last_check", time());
                save();
        }
        set_heart_beat(100);
}

void heart_beat()
{
        string *file;

        if (! query("last_check") ||
            time() - query("last_check") < CHECK_PERIOD)
                return;

        file = deep_file_list(LOG_DIR);
}
