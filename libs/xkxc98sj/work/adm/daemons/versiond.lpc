// versiond.c
// 01/11/21.

#include <ansi.h>

#pragma optimize
#pragma save_binary

inherit F_DBASE;
inherit F_SAVE;

#define VERSION_DIR     "/version"

#if 0
#define DEBUG_LOG(s)    tell_object(find_player("jjgod"), s)
#else
#define DEBUG_LOG(s)
#endif

#define T_DEBUG(str)    CHANNEL_D->do_channel(this_object(), "sys", str)

// 不需要构造的目录
nosave string *exclude_dir = ({ "/adm/etc/", "/adm/simul_efun/",
                                "/data/", "/dump/", "/temp/", "/binaries/",
                                "/backup/", "/log/", "/u/", "/adm/tmp/",
                                VERSION_DIR + "/" });
public  void   build_version();
private void   build_path(string path, int i);
public  string *rebuild_version(string path, int i);
public  void   copy_file(string *flist);

void create()
{
        seteuid(getuid());
        restore();

        set("channel_id", "版本精灵");
}

public void build_version()
{
        string *flist;
        string *fstat;
        mapping my;
        
        my = query_entire_dbase();
        flist = get_dir("/", -1);

        foreach (fstat in flist)
        {
                T_DEBUG(sprintf("Building: %O", fstat));

                switch (fstat[1])
                {
                case -2:
                        build_path("/" + fstat[0] + "/", 0);
                case -1:
                        continue;
                default:
                        set(fstat[0], fstat[2]);
                }
        }
        return;
}

private void build_path(string path, int i)
{
        string *flist;
        mapping my;
        string *fstat;

        my = query_entire_dbase();
        flist = get_dir(path, -1);
        
        T_DEBUG("Building: " + path);

        if (i % 100) reset_eval_cost();

        if (member_array(path, exclude_dir) != -1)
                return;
        
        foreach (fstat in flist)
        {
                switch (fstat[1])
                {
                case -2:
                        build_path(path + fstat[0] + "/", i++);
                case -1:
                        continue;
                default:
                        set((path + fstat[0])[1..<1], fstat[2]);
                }
        }
        return;
}

public string *rebuild_version(string path, int i)
{
        string *flist;
        mapping my;
        string *fstat;
        string *changed;

        my = query_entire_dbase();
        flist = get_dir(path, -1);
        changed = ({ });

        T_DEBUG("Building: " + path);

        if (i % 100) reset_eval_cost();
        
        if (member_array(path, exclude_dir) != -1)
                return ({ });

        foreach (fstat in flist)
        {
                switch (fstat[1])
                {
                case -2:
                        changed += rebuild_version(path + fstat[0] + "/", i++);
                case -1:
                        continue;
                default:
                        if (fstat[2] != query(path + fstat[0]))
                                changed += ({ path + fstat[0] });
                        set((path + fstat[0])[1..<1], fstat[2]);
                }
        }
        return changed;
}

public void copy_file(string *flist)
{
        string file;

        foreach (file in flist)
        {
                if (file_size(file) == -1)
                        continue;
                else
                {
                        assure_file(VERSION_DIR + file);
                        cp(file, VERSION_DIR + file);
                }
        }
}

string query_save_file() { return DATA_DIR + "versiond"; }

int clean_up() { return 0; }

int new_version()
{
        return set("version", time());
}

int query_version() { return query("version"); }
