// mdc.c
// Map of Domain Creator : Version 1.0

#include <ansi.h>

#define VERSION         "1.0"

inherit ITEM;
inherit F_AUTOLOAD;
inherit F_SAVE;

int query_autoload() { return 1; }

void init() {
  if (wizardp(environment())) {
    seteuid(getuid(environment()));
    add_action("do_new", "new");    // 新建工程或房间
    add_action("do_set", "set");    // 修改房间属性
    add_action("do_all", "all");    // 批量处理房间
    add_action("do_link", "link");  // 连接房间出口
    add_action("do_save", "save");  // 保存工程或房间
  }
}
