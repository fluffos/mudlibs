// /kungu/class/xueshan/baoxiang
// by dubei

inherit NPC;
inherit F_MASTER;
void create()
{
        set_name("宝象喇嘛", ({
		"baoxiang lama",
		"baoxiang",
	}));
	set("long",
                         "他就是血刀老祖的徒弟宝象喇嘛。\n"
		"一个极高极瘦的和尚,两眼甚大,湛湛有光.\n"
	); 
	set("gender", "男性");
	set("attitude", "peaceful");
	set("class", "lama");

	set("age", 39);
	set("shen", -6000);
	set("str", 32);
	set("int", 25);
	set("con", 30);
	set("dex", 32);
	set("max_qi", 2000);
            set("eff_jingli",1500);
	set("max_jing", 1500);
	set("neili", 3000);
	set("max_neili", 3000);
	set("jiali", 50);
	set("combat_exp", 650000);
            set("per",6);
	set_skill("force", 100);
	set_skill("longxiang-gong", 100);
	set_skill("dodge", 100);
	set_skill("qingshen-fa", 100);
	set_skill("cuff", 100);
	set_skill("fuhu-quan", 100);
	set_skill("parry", 100);
	set_skill("mizong-xinfa", 100);
       set_skill("hand", 100);
       set_skill("dashou-yin", 100);
	set_skill("literate", 100);
       set_skill("blade", 100);
       set_skill("xuedao-daofa", 100);
	map_skill("force", "longxiang-gong");
	map_skill("dodge", "qingshen-fa");
	map_skill("cuff", "fuhu-quan");
	map_skill("parry", "xuedao-daofa");
       map_skill("hand", "dashou-yin");
       map_skill("blade", "xuedao-daofa");
       prepare_skill("hand", "dashou-yin");
       prepare_skill("cuff", "fuhu-quan");
       create_family("密宗", 11, "血刀门弟子");

	setup();
            carry_object("/clone/armor/yellow-cloth")->wear();
            carry_object("/clone/weapon/blade")->wield(); 

}
void attempt_apprentice(object ob)
{
         mapping fam;  
         fam = ob->query("family");  

         if (!fam || fam["family_name"] != "密宗"){
                command("say "+RANK_D->query_respect(ob)+"与本派素无来往，不知此话从何谈起？");
                return;
                }       
        if ((int)ob->query_skill("longxiang-gong", 1) < 80 || (int)ob->query_skill("lamaism",1)<=60) {
                command("say 我密宗派是以龙象般若功为基础,密宗心法为辅,你还差的远呢,回去多多修炼吧。"); 
                return;
        }
              if ((int)ob->query("shen")> -120000){
                command("say 你好象没为我血刀门出过什么力，怎能收你呢？"); 
               return;
        }
        if (fam["generation"] <=11){
              command("say 我血刀门门规甚严,我怎麽能受你为徒呢！");
              return;
              }   
        command("say 我就收下你吧,希望你能在血刀门中有所作为！");
              command("recruit " + ob->query("id")); 
        ob->set("title","密宗血刀门第十二代底子");       
          
}
 
