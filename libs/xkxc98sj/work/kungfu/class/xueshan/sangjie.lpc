  set("per", 18);
  set_skill("force", 180);
  set_skill("longxiang-gong", 180);
  set_skill("dodge", 180);
  set_skill("qingshen-fa", 180);
  set_skill("cuff", 180);
  set_skill("fuhu-quan", 180);
  set_skill("parry", 180);
  set_skill("sword", 180);
  set_skill("dashou-yin", 180);
  set_skill("lamaism", 180);
  set_skill("literate", 100);
  set_skill("huoyan-dao", 180);
  set_skill("strike", 180);
  set("chat_chance_combat", 40);
  set("chat_msg_combat", ({
    (: exert_function, "fumozhou" :),
    (: perform_action, "strike.honglian" :),
    (: perform_action, "strike.xiuluo" :)
