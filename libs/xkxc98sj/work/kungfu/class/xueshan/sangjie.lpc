void init()
{
        object me, ob;
        me = this_object();
        ob = this_player();
        ::init();
        if( !me->query("waiting_mz") ) 
                ob->delete_temp("fee_paid");
        add_action("do_name","杀");        
}

string ask_me()
{
        return "没法王的手谕，我不能做这件事！\n";
}

int do_name(string target)
{
        object me, dest, *all;
        int i,j; 
        me = this_object();
        all = users();
        if(me->query("waiting_mz"))
                return notify_fail("桑结大喇嘛皱了皱眉，我正在行使法王的手谕！\n");
        if( !this_player()->query_temp("mz_kill") ) 
                return notify_fail("桑结大喇嘛说道：需要法王的旨意我才能提你报仇！\n");
        if( !target || target==" ") 
                return notify_fail("桑结大喇嘛冷笑说道：快告诉我那家伙的名字，我这就去让他知道密宗的厉害！\n");
             
              
         if(target != (string)this_player()->query_temp("die_by_from"))
            return notify_fail("桑结大喇嘛皱了皱眉，这个人好象不该杀啊！\n");
        for(i=0; i<sizeof(all); i++) {
                if( all[i]->id(target) )
                        dest = all[i];
        }  
                
        if( !dest )
                return notify_fail("桑结大喇嘛皱了皱眉，这个人目前不在游戏里面！\n");    
   
        if (dest == this_player())
                return notify_fail("桑结大喇嘛骂到：suicide -f快些。\n");    
            
        if (dest->is_ghost())
                return notify_fail("桑结大喇嘛不悦道：他已经是个死鬼了！\n");

        me->set("waiting_mz", dest->query("id"));
        me->set("target_name", target);
        me->set("hire", this_player()->name(1));  
        me->delete("chat_chance"); 
           me->delete("startroom");
        message("vision", HIY "桑结大喇嘛阴笑一声说道：既然有法王的旨意，那我就去一趟中原！\n"NOR, environment(), me );
        me->set("pursuer", 1);
              this_player()->delete_temp("faint_by");
        me->set("vendetta/authority", 1); 
             log_file("mz_kill",sprintf("%s(%s)于： %s  报仇追杀追杀%s(%s)。\n",
        this_player()->name(1), getuid(this_player()), ctime(time()),dest->name(1),getuid(dest)));
              this_player()->delete_temp("mz_kill");
        call_out("do_chase", 1, me);        
        return 1;
}

int accept_object(object who, object ob, object me, object obj)
{
 
                          
 
    if (ob->query("id")== "shou yu" && !this_object()->query("waiting_mz") ) {
                tell_object(who, "桑结大喇嘛脸色一沉：既然有法王的手谕，就告诉我是谁杀的你？\n");
                tell_object(who, "请键入：杀 目标英文名字\n");
                who->set_temp("fee_paid",1);
                return 1;
                }
 
        return 0;
}

int do_chase(object me)
{        
        object dest;
        dest = find_player(me->query("waiting_mz"));        
        if( !objectp(dest) || !environment(dest) ){
                call_out("waiting", 0, me);
                return 1;
                }        
        message_vision("$N阴笑一声转身走了出去。\n" NOR, me);
        me->move(environment(dest));
        message_vision(RED"$N面色阴沉，摇着法铃走了过来。\n" NOR, me);
        me->set_leader(dest);
        command("look " + dest->query("id"));        
        if ( !environment(me)->query("no_fight")){
                call_out("do_kill", 1, me, dest);
                return 1;
                }
        else{
                call_out("waiting", 0, me);
                return 1;
                }
        return 1;
}

int do_kill(object me, object dest)
{
        if( objectp(dest) && present(dest, environment(me))
                 && !environment(me)->query("no_fight")){
                message_vision(HIR "$N对$n说道："+RANK_D->query_rude(dest)+"，听说你杀害我密宗弟子，今特奉法王旨意，超度你上西天！\n" NOR, me, dest);
                me->set_leader(dest);
                me->kill_ob(dest);
                dest->fight_ob(me);
                call_out("checking", 0,  me);   
                }
        else call_out("waiting", 1, me);             
        return 1;
}

int waiting(object me)
{
        object dest;
        dest = find_player(me->query("waiting_mz"));        
        if ( objectp(dest) ){
                if (dest->is_ghost()){
                        me->delete("waiting_target");
                        call_out("do_back", 1, me);
                        return 1;
                        }
                else if (me->is_fighting() && present(dest, environment(me))){
                        call_out("checking", 0, me);
                        return 1;
                        }
                else if (living(me) && !environment(dest)->query("no_fight")){
                        call_out("do_chase", 0, me);
                        return 1;
                        }
        }                       
        remove_call_out("waiting");
        call_out("waiting", 10, me);
    return 1;
}

int checking(object me)
{
        object ob;

        if (me->is_fighting()) {
                call_out("checking", 1, me);
                return 1;
                }
        if( objectp(ob = present("corpse", environment(me)))
                 && ob->query("victim_id") == me->query("target_name") ){
                me->delete("waiting_mz");
                call_out("do_back", 1, me);
                return 1;
                }        
        call_out("waiting", 0, me);
        return 1;
}

