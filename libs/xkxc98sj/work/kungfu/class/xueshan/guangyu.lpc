// /kungfu/class/xueshan/guangyu 光瑜喇嘛
// by dubei

#include <ansi.h>

inherit NPC;
inherit F_MASTER;
string ask_join();
string ask_jing();
void create() {
  set_name("光瑜喇嘛", ({ "guangyu lama", "guangyu" }));
  set("long", @LONG
他是密宗的光瑜喇嘛。身穿一件黄色袈裟，头带僧帽。
LONG
  );
  set("gender", "男性");
  set("age", 35);
  set("attitude", "heroism");
  set("shen", -1500);
  set("str", 20);
  set("int", 30);
  set("con", 30);
  set("dex", 20);
  set("max_qi", 1000);
  set("max_jing", 1000);
  set("neili", 1000);
  set("max_neili", 1000);
  set("eff_jingli", 1500);
  set("jiali", 50);
  set("combat_exp", 150000);

  set_skill("lamaism", 60);
  set_skill("literate", 60);
  set_skill("force", 60);
  set_skill("longxiang-gong", 60);
  set_skill("dodge", 60);
  set_skill("qingshen-fa", 60);
  set_skill("cuff", 60);
  set_skill("fuhu-quan", 60);
  set_skill("parry", 60);
  set_skill("sword", 60);
  set_skill("mingwang-jian", 60);
  set("book_count", 3);

  map_skill("force", "longxiang-gong");
  map_skill("dodge", "qingshen-fa");
  map_skill("cuff", "fuhu-quan");
  map_skill("parry", "mingwang-jian");
  map_skill("sword", "mingwang-jian");
  prepare_skill("cuff", "fuhu-quan");
  create_family("密宗", 12, "弟子");
  set("class", "lama");
  set("inquiry", ([
    "剃度": (: ask_join :),
    "出家": (: ask_join :),
    "经书": (: ask_jing :),
  ]));
  setup();
  carry_object("/clone/armor/h-jiasha")->wear();
  carry_object("/clone/weapon/changjian")->wield();
}



void init() {
  object me, ob;
  ::init();
  ob = this_player();
  me = this_object();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_kneel", "kneel");
}
void greeting(object me) {
  mapping myfam;
  myfam = (mapping)me->query("family");


  if (!myfam)
    command("say 这位" + RANK_D->query_respect(me) + "是不是千里来投奔我大轮寺的？");

  else if (myfam["family_name"] != "密宗")
    command("say 这位" + RANK_D->query_respect(me) + "远道来我大轮寺，不知有何事情？");

  else if (myfam["generation"] <= 10 && myfam["family_name"] == "密宗")
    command("say 光瑜恭迎师祖！");

  else if (myfam["generation"] == 11 && myfam["family_name"] == "密宗")
    command("say 师叔驾到，请赶紧入寺休息。");

  else if (myfam["generation"] == 13 && myfam["family_name"] == "密宗")
    command("say 最近有没有忘记去供奉？");

  else command("say 师兄远道归来，请进！");
}

void attempt_apprentice(object ob) {
  mapping fam;

  string name, new_name;

  ob = this_player();
  fam = ob->query("family");
  if ((string)ob->query("gender") != "男性") {
    command("say 修习密宗内功需要纯阳之体。");
    command("say 这位" + RANK_D->query_respect(ob) +
      "还是请回吧！");
    return;
  }
  if (!ob->query_temp("mz_gf")) {
    command("say 这位" + RANK_D->query_respect(ob) + "如果真心加入我密宗，就先请前到大殿供奉我佛！");
    return;
  }
  if ((string)ob->query("class") != "lama") {
    command("say 我密宗戒律甚多。");
    command("say 这位" + RANK_D->query_respect(ob) +
      "还是请回吧！");
    return;
  }
  if (fam && fam["generation"] <= 12 && fam["family_name"] == "密宗") {
    command("say 我密宗门规甚严,我怎麽能收你为徒呢！");
    return;
  }

  command("smile");
  command("nod");
  name = ob->query("name");
  new_name = "名" + name[2..3];
  ob->set("name", new_name);
  // ob->set("class",lama);    
  command("say 好吧,我就收你为徒,今后法名就叫做" + new_name + "！");
  ob->set("mz_gf", (int)ob->query("age"));
  command("recruit " + ob->query("id"));

}
string ask_join() {
  object me;

  me = this_player();

  if ((string)me->query("class") == "lama")
    return "你我同是出家人,何必开此玩笑？\n";

  if ((string)me->query("gender") != "男性")
    return "施主一心向佛，真是可喜可贺，可惜本寺只收男徒。\n";
  if ((int)me->query("combat_exp", 1) >= 10000)
    return "密宗讲究从小修行,你恐怕已经无法领悟密宗更高深的心法了。\n";
  me->set_temp("mizong/join_bonze", 1);
  return "你如真心想皈依我佛，就跪下（kneel)受戒吧。\n";
}
string ask_jing() {
  mapping fam;
  object ob;

  if (!(fam = this_player()->query("family")) || fam["family_name"] != "密宗")
    return RANK_D->query_respect(this_player()) + "不是我密宗弟子，还是请回吧！";
  if (query("book_count") < 1)
    return "你来晚了，经书已经领完了。";
  add("book_count", -1);
  ob = new("/d/xueshan/obj/jing");
  ob->move(this_player());
  return "好吧，这本「密宗真经」你回去好好钻研钻研。";
}
int do_kneel() {
  object me = this_player();

  if (!me->query_temp("mizong/join_bonze"))
    return 0;

  message_vision(
    "$N双手合十，恭恭敬敬地跪了下来。\n\n"
    "$n口念密宗真言，在$N头顶轻轻地摩挲了几下，将$N的头发尽数剃去。\n\n",
    me, this_object());

  command("smile");
  me->delete_temp("mizong/join_bonze");
  me->set("class", "lama");

  return 1;
}
