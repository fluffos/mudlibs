// /kungfu/class/xueshan/zhishan
// by dubei

inherit NPC;
int ask_me(object who);
void create() {
  object ob;
  set_name("智善大喇嘛", ({ "zhishan dalama", "zhishan" }));
  set("long", @LONG
智善大喇嘛是大轮寺有道的高僧，对佛法有精深的研究。
他身穿一件黄色袈裟，头带僧帽。目光如电，似乎身怀绝技。
他同时还掌管着大轮寺的供奉。
LONG
  );
  set("gender", "男性");
  set("age", 45);
  set("attitude", "friendly");
  set("shen", 0);
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);
  set("max_qi", 3000);
  set("max_jing", 3000);
  set("neili", 3000);
  set("max_neili", 3000);
  set("jiali", 100);
  set("combat_exp", 1200000);
  set("unique", 1);
  set("per", 20);
  set("chat_chance_combat", 40);
  set("chat_msg_combat", ({
    (: exert_function, "fumozhou" :),
    (: perform_action, "hammer.dazhuan" :),
  }));
  set("eff_jingli", 1500);
  set_skill("qingshen-fa", 160);
  set_skill("literate", 80);
  set_skill("force", 160);
  set_skill("longxiang-gong", 180);
  set_skill("dodge", 160);
  set_skill("cuff", 160);
  set_skill("fuhu-quan", 160);
  set_skill("fuhu-quan", 160);
  set_skill("parry", 160);
  set_skill("dashou-yin", 160);
  set_skill("hand", 160);
  set_skill("sword", 160);
  set_skill("mingwang-jian", 160);
  set_skill("hammer", 160);
  set_skill("riyue-lun", 160);

  map_skill("force", "longxiang-gong");
  map_skill("dodge", "qingshenfa");
  map_skill("cuff", "fuhu-quan");
  map_skill("hand", "dashou-yin");
  map_skill("parry", "riyue-lun");
  map_skill("hammer", "riyue-lun");
  prepare_skill("hand", "dashou-yin");
  prepare_skill("cuff", "fuhu-quan");

  create_family("密宗", 12, "大喇嘛");
  set("class", "lama");
  set("inquiry", ([
    "供奉": (: ask_me :),
  ]));
  setup();
  if (clonep()) {
    ob = unew(BINGQI_D("yinlun"));
    if (!ob) ob = unew(BINGQI_D("falun"));
    ob->set_amount(5);
    ob->move(this_object());
    ob->wield();
    carry_object("/clone/armor/h-jiasha")->wear();
  }


}
int ask_me(object who) {
  object me;
  mapping fam;
  int t, i, j;

  me = this_player();
  fam = (mapping)me->query("family");
  t = (int)me->query("mz_scatn") * 2;
  i = (int)me->query("age");
  j = (int)me->query("mz_give");

  if (!fam || fam["family_name"] != "密宗") {
    command("say 你不是我大轮寺高僧，何谈此言呢？\n");
    return 1;
  }
  if ((int)me->query_skill("lamaism", 1) < 101) {
    message_vision("$N冷冷的对$n说道，你是什麽身份，也想来领供奉？！\n", who, me);
    return 1;
  }
  if (t > 1) {
    message_vision("$N掏出一本册子翻了翻，皱了皱眉对$n说道，你以前好象没按时供奉，按寺规要过" + t + "年后才能领取。\n", who, me);
    me->delete("mz_scatn");
    me->set("mz_give", t + i);
    me->delete("mz_number");
    me->delete("mz_gf");
    return 1;
  }
  if (t <= 0 && j <= 0) {
    who->add_money("gold", (int)me->query_skill("lamaism", 1) * 2 / 3);
    command("give " + me->query("id") + " gold");
    command("say 这是你今年的供奉，请拿去清点一下。\n");
    me->set("mz_give", i);
    me->delete("mz_number");
    me->delete("mz_gf");
    return 1;
  }
  if (j < i) {
    who->add_money("gold", (int)me->query_skill("lamaism", 1) * 2 / 3);
    command("give " + me->query("id") + " gold");
    command("say 这是你今年的供奉，请拿去清点一下。\n");
    me->set("mz_give", i);
    return 1;
  }
  command("say 供奉是一年才能领一次，时间还没到呢。\n");
  return 1;
}
