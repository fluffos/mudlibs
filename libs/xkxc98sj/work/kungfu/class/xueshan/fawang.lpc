#include <ansi.h>

inherit NPC;
inherit F_MASTER;
string ask_me();
string ask_me1();
void create()
{
              object ob;
        set_name("金轮法王", ({ "jinlun fawang", "fawang" }));
        set("long",@LONG
他是雪山寺的护教法王。在雪山寺的地位仅次与掌门人鸠摩智。
身穿一件紫红袈裟，头带僧帽。
LONG
        );
             
        set("title", HIY "密宗护教法王" NOR);
        set("gender", "男性");
        set("age", 50);
          set("attitude", "friendly");
        set("shen", -18000);
        set("str", 35);
        set("int", 30);
        set("con", 30);
        set("dex", 30);
        set("max_qi", 5000);
        set("max_jing", 2000);
        set("neili", 5500);
        set("max_neili", 5500);
        set("jiali", 100);
        set("combat_exp", 2000000);
        set("unique", 1);
              set("eff_jingli", 2500);
        set("per",18);
        set_skill("force", 200);
        set_skill("longxiang-gong", 220);
        set_skill("dodge", 200);
        set_skill("qingshen-fa", 200);
        set_skill("cuff", 200);
        set_skill("fuhu-quan", 200);
        set_skill("parry", 200);
        set_skill("sword", 200);
        set_skill("dashou-yin", 200);
        set_skill("lamaism", 200);
        set_skill("literate", 100);
        set_skill("hammer", 200);
        set_skill("riyue-lun", 200 );
        set_skill("hand", 200 );
        set("chat_chance_combat", 20);
        set("chat_msg_combat", ({
                (: exert_function, "force.fumozhou" :),
                (: perform_action, "hammer.dazhuan" :)
        }));
              set("inquiry", ([
                 "霍都"  : (: ask_me :),
                 "报仇" : (: ask_me1 :),
        ]));
        map_skill("force", "longxiang-gong");
        map_skill("dodge", "qingshen-fa");
        map_skill("cuff", "fuhu-quan");
        map_skill("parry", "riyue-lun");
        map_skill("hand", "dashou-yin");
        map_skill("hammer", "riyue-lun");
              prepare_skill("cuff", "fuhu-quan");
              prepare_skill("hand", "dashou-yin");
        create_family("密宗", 9, "护教法王");
        set("class","lama");

        setup(); 
        if (clonep()) {                
                ob = unew(BINGQI_D("jinlun"));               
                if (!ob){
                        ob = unew(BINGQI_D("falun"));
                        ob->set_amount(5);
                        }
                ob->move(this_object());
                ob->wield();
                carry_object("/clone/armor/r-jiasha")->wear();
                carry_object("/clone/armor/sengmao")->wear();
        } 
}

 

void attempt_apprentice(object ob)
{                 
        mapping fam; 

        string name, new_name;

        fam = ob->query("family");  

        if ((int)ob->query_skill("longxiang-gong", 1) < 160 || (int)ob->query_skill("lamaism",1)<=160) {
                command("say 我密宗派是以龙象般若功为基础,密宗心法为辅,你还差的远呢,回去多多修炼吧。"); 
                return;
        }
          if (ob->query_str() < 35 || ob->query_con() <30) { 
                command("say 想修炼我的日月五行轮法,必须有宏伟的体魄,你臂力和根古欠佳,怎能学此绝学?"); 
                return;
        } 
        if (fam["generation"] <=9){
              command("say 我密宗门规甚严,我怎麽能受你为徒呢！");
              return;
              }   
               
        if ((int)ob->query("shen")> -500000 || (int)ob->query("combat_exp",1) < 600000){
              command("say 我金轮法王可不收没什麽作为的弟子。"); 
             return;
             }
               if(!ob->query_temp("daerba_win")){
                     command("say 想拜我为师,需要先大赢我的大弟子达而巴。"); 
                        return;
             } 
        if (fam["generation"] <=9){
              command("say 我密宗门规甚严,我怎麽能受你为徒呢！");
              return;
              }   
              
        if ((int)ob->query("shen")> -600000 || (int)ob->query("combat_exp",1) < 600000){
              command("say 我金轮法王可不收没什麽作为的弟子。"); 
             return;
             }
         command("smile"); 
        if (fam["generation"]!= 10){
         name = ob->query("name");
          new_name = "智" + name[2..3];
         ob->set("name", new_name);
              
        command("say 你资质甚佳,今后法名就叫做" + new_name + "，并封为国师,就跟随老衲一起光大我密宗武学吧！");
               
         }    
     
         command("recruit " + ob->query("id"));
     
         
}

string ask_me()
{
        mapping fam;  

        if (!(fam = this_player()->query("family")) 
           || fam["family_name"] != "密宗")
                return RANK_D->query_respect(this_player()) + 
                "与本帮素无来往，何谈我密宗家事？"; 
              this_player()->set_temp("mz/fwask",1);
        return "这个孽徒，提他做什麽？";
}

string ask_me1()
{
        mapping fam; 

        object ob, me;
        ob = this_player();
              me = this_object();

        if (!(fam = this_player()->query("family")) 
           || fam["family_name"] != "密宗")
                return RANK_D->query_respect(this_player()) + 
                "与本帮素无来往，何谈要我密宗提你报仇？"; 

                if(!ob->query_temp("mz/fwask"))
              return "老衲已经久未出手过了......";

              if (ob->query("combat_exp",1) >=350000 || ob->query("combat_exp",1) <=200000)
              return "老衲已经久未出手过了......";

             new("/d/xueshan/obj/shouyu")->move(ob);
              this_player()->set_temp("mz_kill",1);
        return "好吧，你拿我的手谕去找桑结吧，他会提你讨个公道的。";
}
int accept_object(object who, object ob,object me)
{
        mapping fam; 
        me=this_object();
        if (!(fam = this_player()->query("family")) 
           || fam["family_name"] != "密宗"){
                command("hehe "+who->query("id"));
                command("say 你要是不想找死，就不要和老衲开这个玩笑！");
        return 0;
        } 
             if (who->query_skill("lamaism",1) <120 || who->query("combat_exp",1) < 200000 || !who->query_temp("mz/fwask")){
                         command("say 你学艺为精，那里能有本事杀了这个家伙？！");
             return 0;
        }
       if ((string)ob->query("name") != "霍都的尸体") {
               command("say 老衲对这样东西没什么兴趣……");
               return 0;
       }
       command("say 你提我杀了这个忘恩负义的家伙，很好，你有什麽要求就和老衲提吧。");  
            who->set_temp("mz_kill",1);
       return 1;
}

