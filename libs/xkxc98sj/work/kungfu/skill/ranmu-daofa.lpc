// ranmu-daofa.c 燃木刀法

#include <ansi.h>

inherit SKILL;

mapping *action = ({
  ([ "action": "$N面带微笑，一招「烈火烧身」，举$w对着$n连砍了八八六十四刀，刀气纵横，迅雷不可挡",
    "force": 200,
    "dodge": 20,
    "damage": 150,
    "lvl": 0,
    "skill_name": "烈火烧身",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N运起内功一招「点木生火」，$w上带着无比劲气，划了一个大弧，从上而下劈向$n的$l",
    "force": 300,
    "dodge": 35,
    "damage": 100,
    "lvl": 20,
    "skill_name": "点木生火",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N手臂一沉，一招「张弓望月」，双手持$w划出一道雪亮刀光，接着拦腰反切，砍向$n的$l",
    "force": 250,
    "dodge": 20,
    "damage": 150,
    "lvl": 40,
    "skill_name": "张弓望月",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N挥舞$w上劈下撩，左挡右开，使出一招「烈火腾云」，卷起阵阵刀风，齐齐罩向$n",
    "force": 300,
    "dodge": 15,
    "damage": 200,
    "lvl": 60,
    "skill_name": "烈火腾云",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N一招「火中取栗」，左脚跃步落地，手中$w单刀往前，挟着炙热的风声劈向$n的$l",
    "force": 250,
    "dodge": 15,
    "damage": 200,
    "lvl": 80,
    "skill_name": "火中取栗",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N腾空而起，半空中一招「玉石俱焚」，手中$w挥出满天流光般的刀影，向$n的全身卷去",
    "force": 260,
    "dodge": 30,
    "damage": 200,
    "lvl": 100,
    "skill_name": "玉石俱焚",
    "damage_type": "割伤"
  ]),
});


int valid_enable(string usage) { return usage == "blade" || usage == "parry"; }

int valid_learn(object me) {
  if (!me->query("family") || me->query("family/family_name") != "少林派")
    return notify_fail("你不是少林弟子，如何能用这燃木刀法？\n");

  if ((int)me->query("max_neili") < 1000)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_skill("yijin-jing", 1) < 120)
    return notify_fail("你的易筋经内功火候太浅。\n");
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("ranmu-daofa", 1);

  if (random(me->query_skill("ranmu-daofa")) > 120 &&
    me->query_skill("force") > 100 &&
    me->query("neili") > 1000 && me->query_temp("ranmu")
    && random(10) > 6) {
    me->add("neili", -150);
    return ([
      "action": HIR "$N忽然高宣一声佛号，身体急速的旋转，手中的" + me->query_temp("weapon")->query("name") + "散发出一股灼热的气流，袭向$n！\n" NOR,
      "force": 380,
      "damage": 220,
      "dodge": -10,
      "damage_type": "割伤" ]);
  }

  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("jingli") < 60)
    return notify_fail("你的精力不够练燃木刀法。\n");
  me->receive_damage("jingli", 55);
  return 1;
}
string perform_action_file(string action) {
  return __DIR__ "ranmu-daofa/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  if (userp(me) && me->query_temp("fenwo_hit") &&
    victim->query("combat_exp") >= me->query("combat_exp") / 2
    && me->query("fenwo") < me->query_skill("blade"))
    me->add("fenwo", 1);  // for rmd's fenwo pfm 
}


mapping *query_actions() { return action; }
