// Exert: Heal.c
// Date : AHA 97/06/22

#include <ansi.h>

int exert(object me, object target)
{
  if( me->is_fighting() )
      return notify_fail("在战斗中运功疗伤？找死吗？\n");

  if ((int)me->query_skill("emei-jiuyang", 1) < 20)
      return notify_fail("你的九阳功修为太低，还是好好练功吧。\n");

  if( (int)me->query("neili") < 50 ) 
      return notify_fail("你的真气不足。\n");

  if( (int)me->query("eff_qi") >= (int)me->query("max_qi") )
      return notify_fail("你现在并没有受伤！\n");

  if( (int)me->query("eff_qi") < (int)me->query("max_qi") / 3 )
      return notify_fail("你受伤太重了，只怕一运真气便会有生命危险！\n");

  write( HIW "你盘腿坐下，双手互握，气凝丹田，开始运功疗伤。\n" NOR);
  message("vision",
     me->name() + HIR"的脸越来越红，"+HIW"头顶开始出现阵阵白雾。\n"NOR
     + me->name() + "运功完毕，脸色看起来好了许多。\n",
     environment(me), me);
  
  me->receive_curing("qi", 20 + (int)me->query_skill("force")/3 );
  me->add("neili", -50);
  return 1;
}

