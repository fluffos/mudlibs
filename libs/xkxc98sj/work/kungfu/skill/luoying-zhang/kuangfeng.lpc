// kuangfeng.c  狂风绝技

#include <ansi.h>

inherit F_SSERVER;

int perform(object me, object target) {
  int i, j, z, y;
  i = me->query_skill("luoying-zhang", 1);
  j = me->query_skill("xuanfeng-tui", 1);
  z = me->query_skill("bihai-changsheng", 1);
  y = (i + j + z) / 4;


  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("狂风绝技只能对战斗中的对手使用。\n");

  if (!(me->query("thd/perform") & 4))
    return notify_fail("你虽然听说过“狂风绝技”是桃花岛看门神技，可是却未获黄岛主传授。\n");

  if (objectp(me->query_temp("weapon")))
    return notify_fail("你必须空手使用「狂风绝技」！\n");

  if (me->query_skill_prepared("strike") != "luoying-zhang"
    || me->query_skill_prepared("leg") != "xuanfeng-tui"
    || me->query_skill_mapped("strike") != "luoying-zhang"
    || me->query_skill_mapped("leg") != "xuanfeng-tui")
    return notify_fail("你现在无法使用「狂风绝技」进行攻击！\n");

  if ((int)me->query_skill("luoying-zhang", 1) < 150)
    return notify_fail("你的落英神剑掌不够娴熟，无法施展出狂风绝技。\n");

  if ((int)me->query_skill("strike", 1) < 150)
    return notify_fail("你的掌法不够娴熟，无法施展出狂风绝技。\n");

  if ((int)me->query_skill("lag", 1) < 150)
    return notify_fail("你的腿法不够娴熟，无法施展出狂风绝技。\n");

  if ((int)me->query_skill("force", 1) < 150)
    return notify_fail("你的内功不够娴熟，无法施展出狂风绝技。\n");

  if ((int)me->query_skill("xuanfeng-tui", 1) < 150)
    return notify_fail("你的旋风扫叶腿不够娴熟，无法施展出狂风绝技。\n");
  if ((int)me->query_skill("parry", 1) < 150)
    return notify_fail("你的招架不够娴熟，无法施展出狂风绝技。\n");
  if ((int)me->query_skill("bihai-chaosheng", 1) < 150)

    return notify_fail("你的碧海潮生功火候不够，无法施展出狂风绝技。\n");
  if ((int)me->query_dex() < 30)
    return notify_fail("你的身法欠佳，无法施展出狂风绝技。\n");
  if ((int)me->query_str() < 30)
    return notify_fail("你的体魄不足，无法发挥出狂风绝技的威力。\n");
  if ((int)me->query_int() < 35)
    return notify_fail("你的悟性不够，无法领悟出狂风绝技。\n");
  if ((int)me->query("max_neili") < 2500)
    return notify_fail("你的内力不够，无法施展出狂风绝技。\n");
  if ((int)me->query("neili") < 1500)
    return notify_fail("你的真气不够，无法施展出狂风绝技。\n");

  message_vision(RED "$N一声清啸，拳脚齐施，使出桃花「狂风绝技」迅捷无伦地攻向$n！\n" NOR, me, target);
  me->add("neili", -1000);
  me->add_temp("apply/strength", y);
  me->add_temp("apply/attack", y);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 2);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 2);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 2);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 2);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 2);
  me->add_temp("apply/strength", -y);
  me->add_temp("apply/attack", -y);
  me->start_busy(3);
  return 1;
}
