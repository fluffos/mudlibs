// lonely-sword.c 独孤九剑
// Written by jjgod.

inherit SKILL;

#include <ansi.h>

#define SKILL_CN_NAME   "独孤九剑"
#define SKILL_EN_NAME   "lonely-sword"

int valid_enable(string usage)
{
        return (usage == "sword");
}

int valid_learn(object me)
{
        return notify_fail(SKILL_CN_NAME + "只能通过领悟来提高。\n");
}

string perform_action_file(string action)
{
        return __DIR__ + SKILL_CN_NAME + "/" + action;
}

mapping query_action(object me, object weapon)
{
        string *skills = get_dir("/kungfu/skill/*.lpc");
        mapping *actions;

        skills = filter_array(skills, (: SKILL_D($1)->valid_enable("sword") && arrayp(SKILL_D($1)->query_actions()) :));

        actions = SKILL_D(skills[random(sizeof(skills))])->query_actions();

        return actions[random(sizeof(actions))];
}