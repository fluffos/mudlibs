// yunu-jiafa 玉女剑法
// by dubei
inherit SKILL;
#include <ansi.h>
mapping *action = ({
  ([ "action": "$N击高而下，一式「" HIG "雁行斜击" NOR "」，腾身下击，剑尖直点$n头部",
    "force": 30,
    "dodge": 50,
    "damage": 5,
    "lvl": 0,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N踏前数步，左手遥指，右手$w使一式「" HIR "浪迹天涯" NOR "」直劈$n的右肋",
    "force": 90,
    "dodge": 45,
    "damage": 5,
    "lvl": 20,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N一招「" HIG "花前月下" NOR "」，$w颤动如鲜花招展风中，来回挥削",
    "force": 70,
    "dodge": 40,
    "damage": 80,
    "lvl": 40,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N剑尖上翻，竟然指向自己的樱唇，一招「" HIR "清饮小酌" NOR "」，宛若举杯自饮一般，横扫$n的$l",
    "force": 145,
    "dodge": 35,
    "damage": 28,
    "lvl": 60,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N使出「" HIG "抚琴按箫" NOR "」，$w自横脐前，做抚琴状，随即剑出中宫，平削$n的$l",
    "force": 150,
    "dodge": 20,
    "damage": 40,
    "lvl": 80,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N横剑斜削，微微二颤，一招「" HIR "彩笔画眉" NOR "」，构成帘下梳妆之状，一脸娇羞，$w却丝毫未有停留，逼向$n的$l",
    "force": 200,
    "dodge": 25,
    "damage": 60,
    "lvl": 90,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N一招「" HIG "举案齐眉" NOR "」，双手齐握剑柄，举剑上挑，直划$n的档部",
    "force": 160,
    "dodge": 20,
    "damage": 65,
    "lvl": 100,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N向前急进两步，一招「" HIR "木兰回射" NOR "」，蓦地里挺剑反手向背后刺出，直刺$n的胸口",
    "force": 65,
    "dodge": 15,
    "damage": 15,
    "lvl": 110,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N一招「" HIG "分花拂柳" NOR "」，$w似左实右，似右实左，虚实莫辩，点向$n的喉头",
    "force": 170,
    "dodge": 10,
    "damage": 70,
    "lvl": 120,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N眼角尽是笑意，眉目含情，一招「" HIR "如影相随" NOR "」，人似清风影随$n周身，身形飘飘中剑光熠熠生辉，",
    "force": 175,
    "dodge": 5,
    "damage": 90,
    "lvl": 140,
    "damage_type": "刺伤"
  ]),
});


int valid_enable(string usage) { return (usage == "sword") || (usage == "parry"); }

int valid_learn(object me) {
  if ((int)me->query("max_neili") < 100)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_skill("yunu-xinjing", 1) < 20)
    return notify_fail("你的玉女心经功力不够。\n");
  return 1;
}

string query_skill_name(int level) {
  int i = sizeof(action);

  while (i--)
    if (level > action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {

  int i, j, level, adjust, tmp;
  object target;

  level = (int)me->query_skill("yunu-jianfa", 1);
  for (i = sizeof(action); i > 0; i--) {
    if (level > action[i - 1]["lvl"]) {
      j = NewRandom(i, 20, level / 5);
      target = offensive_target(me);
      if (me->query_temp("gumu_hebi")
        && me->query("jiali") >= 20
        && random(10) > 5) {
        return ([
          "action": HIY + action[j]["action"] + NOR,
          "force": action[j]["force"] + 60,
          "dodge": action[j]["dodge"] + 15,
          "damage": action[j]["damge"] + level / 4,
          "lvl": action[j]["lvl"],
          "weapon": random(2) ? "剑气" : "剑锋",
          "damage_type": random(2) ? "刺伤" : "割伤",
        ]);
      }

      return action[j];
    }
  }


}

int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("jingli") < 50)
    return notify_fail("你的体力不够练玉女剑法。\n");
  me->receive_damage("jingli", 50);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "yunu-jianfa/" + action;
}

mapping *query_actions() { return action; }
