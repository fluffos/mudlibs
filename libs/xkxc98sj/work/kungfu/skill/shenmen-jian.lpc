int valid_enable(string usage) { return (usage == "sword") || (usage == "parry"); }

int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 100)
		return notify_fail("你的内力不够。\n");

	if ((int)me->query_skill("yinyun-ziqi", 1) < 40)
		return notify_fail("你的氤氲紫气火候太浅。\n");

	if ((int)me->query_skill("sword", 1) < 20)
		return notify_fail("你的基本剑法火候太浅。\n");

	return 1;
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level   = (int) me->query_skill("shenmen-jian",1);
	
	for(i = sizeof(action); i > 0; i--) {
		if(level > action[i-1]["lvl"]) {
			if(random(level) >= 100){
			                return ([
				"action": action[NewRandom(i, 20, level/5)]["action"],
				"damage":level * 3 / 2,
				"damage_type": "刺伤",
				"dodge": level / 5 + random(50),
				"force": level + 80 + random(50),
				]);
			} else {
				return action[NewRandom(i, 20, level/5)];
			}
		}
	}
}
int practice_skill(object me)
{
	object weapon;

	if (!objectp(weapon = me->query_temp("weapon"))
	|| (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("jingli") < 30)
		return notify_fail("你的体力不够练神门十三剑。\n");

	me->receive_damage("jingli", 25);
	return 1;
}
mapping *query_actions() { return action; }