// unset.c

#include <ansi.h>

inherit F_CLEAN_UP;

int help();

int main(object me, string arg)
{
	if(! arg || arg=="") return help();

        if (undefinedp(me->query("env/" + arg)))
                return notify_fail("你并没有设定这个变量。\n");
        
	me->delete("env/" + arg);
	write(HIW "删除 " HIG + arg + HIW " 的设定。\n" NOR);
	return 1;
}

int help()
{
	write(@TEXT
指令格式：unset <变数名>

这个指令让你删除环境变数的设定。

修改变数设定请用 unset 指令。
TEXT
	);
	return 1;
}
