// wenxuan.c 
// by snowman@SJ 23/04/1999

#include <ansi.h>
#include <localtime.h>
inherit F_CLEAN_UP;
int help(object me);
int list(object me, int y, int m)
{
    string *note;
    string str;
    int i, j;
    
    tell_object(me, y+" 年 "+m+" 月");
    note = get_dir("/data/wenxuan/"+y+"/"+m+"/*.w");
    i = sizeof(note);
    if (!i){
            write("还没有任何文选。\n");
            return 0;
            }

    write("共有"+chinese_number(i)+"张文选。\n");
    str = "-------------------------------------------------------------------------------\n";
   for(j=0;j<i;j++)
            str += " ["+(j+1)+"] "+read_file("/data/wenxuan/"+y+"/"+m+"/"+(j+1)+".w", 1, 1);
    me->start_more(str+"-------------------------------------------------------------------------------\n");
    return 1;           
        
}

int read_note(object me, int number, int m, int y)
{
    string *note;
    int i;
    
    tell_object(me, y+" 年 "+m+" 月");
    note = get_dir("/data/wenxuan/"+y+"/"+m+"/*.w");
    i = sizeof(note);
    if (!i){
            write("还没有任何文选。\n");
            return 0;
            }
    if( number < 1 || number > i ){
            write("目前还没有你所要读的这篇文选。\n");
            return 0;
            }
       
    write("的第"+chinese_number(number)+"张文选。\n\n");
    me->start_more( " ["+number+"] "+read_file("/data/wenxuan/"+y+"/"+m+"/"+number+".w"));
    return 1;
        
}
int main(object me, string arg)
{
        string *file, str;
        int i, j, number,m,y;

        tell_object(me,HIW"《"NOR+MUD_NAME+HIW"文选大全"NOR+HIW"》"NOR"，");
        
        file = get_dir("/data/wenxuan/");
        i = sizeof(file);
        if (!i) return notify_fail("现在暂时还没有文选。\n");
        
        m = localtime(time())[LT_MON]+1;
        y = localtime(time())[LT_YEAR];
        
        if (!arg) list(me, y, m);
                
        else if(sscanf(arg, "%d %d %d", number, m, j)==3){
               if(m < 1 || m > 12) return notify_fail("有“"+chinese_number(m)+"月”这个月份吗？\n");
                if(j < 1970 || j > y ) 
                                    return notify_fail("还没有 ["+j+"] 这年的文选呢。\n");
                if(number == 0)
                     list(me, j, m);
                else read_note(me, number, m, j);
        }
        else if(sscanf(arg, "%d %d", number, m)==2){
                if(m < 1 || m > 12) return notify_fail("有“"+chinese_number(m)+"月”这个月份吗？\n");
                if(number == 0)
                     list(me, y, m);
                else read_note(me, number, m, y);
                }
        else if(arg == "all"){
                str = "目前有 ";
                while(i--) str += "["+file[i]+"年] ";
                tell_object(me, str+"的文选。\n");
        }
        else if(sscanf(arg, "%d", number)==1)
                read_note(me, number, m, y);
        
        else help(me);
        return 1;
}

int help(object me)
{
write(@HELP
指令格式：

wenxuan all                  : 列出有文选的年份。
wenxuan                      : 列出本月文选。
wenxuan <编号>               : 阅读本月此编号的文章。
wenxuan 0 <月份>             : 列出本年此月份文选。
wenxuan <编号> <月份>        : 阅读此月份此编号的文章。
wenxuan 0 <月份><年份>       : 列出此年份此月份文选。
wenxuan <编号> <月份> <年份> : 阅读此年份此月份此编号的文章。

by snowman@SJ 06/04/1999

HELP
    );
    return 1;
}
