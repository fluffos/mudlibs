// aboutme.c

#include <ansi.h>

inherit F_CLEAN_UP;
void create() { seteuid(getuid()); }

int main(object me)
{
	object link,body;

	if( objectp(link = me->query_temp("link_ob")) ) 
	{
		write("下面将设定你的个人信息，主要是自我介绍、"HIW"OICQ"NOR" 号码和签名档。\n\n");
		write("您的自我介绍： [ "WHT"finger "NOR"时显示]\n");
		if(!objectp(body=link->query_temp("body_ob")))
		return 1;
	}
	body->edit((: call_other, __FILE__, "get_profile", link :));
	return 1;
}

void get_profile(object link, string str)
{
	object body;
	link->set("profile", str);
	write("您的签名格式： [ "WHT"post "NOR"时用]\n");
	if(!objectp(body=link->query_temp("body_ob")))
		return;
	body->edit((: call_other, __FILE__, "get_signature", link :));
}

void get_signature(object link, string str)
{
	mapping tmp;
	if( strlen(str) > 400 )
		write("签名格式太长！请重新设定。\n");
	else
		link->set("signature", str);
		(link->query_temp("body_ob"))->set("signature", str);
	link->save();
	tmp=link->query("chfn");
	write("你的个人资料如下：\n\n"+
	"个人介绍："WHT+replace_color(link->query("profile"),1)+
	"签名档："WHT+replace_color(link->query("signature"),1));
	return;
}

int help()
{
write(@HELP
指令格式 : aboutme

用途：用来编辑自我介绍（finger 时看到）及签名（post 时用）。
HELP
     );
     return 1;
}
