// xpasswd.c

#include <login.h>;
#include <ansi.h>

inherit F_CLEAN_UP;

void create()
{
        seteuid(getuid());
}

int main(object me, string arg)
{
        object ob, link_ob;
        string id, password;
        
        if (! SECURITY_D->valid_grant(me, "(admin)"))
                return 0;

        if(! arg || sscanf(arg, "%s %s", id, password) != 2)
                return notify_fail("指令格式：xpasswd <id> <密码>\n");

        if(! objectp(ob = find_player(id)))
        {
                ob = new(LOGIN_OB);
                ob->set("id", id);
                if(! ob->restore())
                        return notify_fail("没有这个玩家。\n");
                else
                {                                    
                        ob->set("password", crypt(password, 0));
                        tell_object(me, HIR "玩家" NOR WHT + ob->full_name() + HIR
                                        "的密码已经更改为：" NOR WHT + password + HIR"。\n");
                        log_file("nosave/xpasswd", sprintf("%s: %s修改了%s的密码。\n",
                                                           log_time(), me->full_name(),
                                                           ob->full_name()));
                        ob->save();
                        destruct(ob);
                        return 1;
                }
        }
        link_ob = ob->query_temp("link_ob");
        if(link_ob)
        {
                link_ob->set("password", crypt(password, 0));
                link_ob->save();
                tell_object(me, HIR "玩家" NOR WHT + ob->full_name() + HIR
                                "的密码已经更改为：" NOR WHT + password + HIR "。\n");
                return 1;
        }
        else
                return notify_fail("错误，无法进行修改。\n");
        return 1;
}


int help()
{
        write(@HELP
指令格式 : xpasswd <id> <密码>

这个指令可以修改玩家的密码，请谨慎使用。

HELP
    );
    return 1;
}
