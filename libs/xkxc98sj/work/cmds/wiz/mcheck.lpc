// mcheck.c

int main(object me, string arg)
{
	int i, count;
	object *ob;
	string str="\n", tmp;
	string ip;

        if (! SECURITY_D->valid_grant(me, "(wizard)"))
                return 0;

	ob = filter_array(objects(), (: interactive :));
	ob = filter_array(ob, (:environment:));
	ob = sort_array(ob, (:strcmp(query_ip_number($2), query_ip_number($1)):));
	i = sizeof(ob);
	count = 0;
	while (i--) {
		if (query_ip_number(ob[i]) != ip) {
			if (count > 1) str += tmp;
			ip = query_ip_number(ob[i]);
			tmp = sprintf("\n%-16s", ip);
			count = 0;
		}
		tmp += sprintf("%-9s", ob[i]->query("id"));
		count++;
	}
	if (count > 1) str += tmp+"\n";
	me->start_more(str);
	return 1;
}
