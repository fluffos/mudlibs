// rchange.c
#include <ansi.h>
inherit F_CLEAN_UP;

string replace_color(string msg,int flag);
void create() { seteuid(getuid()); }

int main(object me)
{
        if (! SECURITY_D->valid_grant(me, "(wizard)"))
                return 0;

	write(HIW"－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－"NOR"
\t\t\t"+MUD_NAME+"修改管理\n
\t为了保证"+MUD_NAME+"的个人单机与总站，总站与分站能够稳定顺利及时的\n同步，请每次修改后都使用本系统进行同步更新纪录。一般的简单更新都使用本\n指令，较复杂的则使用news指令。更新原因可以使用以下数字代换："HIW"1"NOR"：修改BUG\n"HIW"2"NOR"：新增程序 "HIW"3"NOR"：调整程序 \n\n"NOR+
"请先输入修改的文件名[格式："HIW"/adm/daemons/logind.lpc"NOR"]：");
	input_to("get_filename", me);
	return 1;
}
void get_filename(string file,object me)
{
	if(file=="no"||file=="none") {
	write("\n\tok，取消修改纪录管理。
"HIW"－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－\n");
	return;
	}
	// 显示下一个的提示信息！
	write("进行此次修改的简单原因[输入"HIW"none"NOR"取消]：");
	input_to("get_reason", me,file);
	return;
}

void get_reason(string res,object me,string file)
{
	if(res=="no"||res=="none") {
	log_file("change",sprintf("%s：%s 由 %s\n",CHINESE_D->chinese_time(7,ctime(time())),file,me->name()+"["+me->query("id")+"]更新。"));
	write("此修改是否向玩家公开：["HIW"y"NOR"/"HIW"n"NOR"]");
	input_to("get_answer", me);
	return;
	}
	else {
	if (res=="1") res="修改BUG";
	else if (res=="2") res="新增程序";
	else if (res=="3") res="调整程序";
		log_file("change",sprintf("%s：%s 由 %s\n",CHINESE_D->chinese_time(7,ctime(time())),file,me->name()+"["+me->query("id")+"]"+
"更新，更新原因：["+res+"]。"));
		write("此修改是否向玩家公开：["HIW"y"NOR"/"HIW"n"NOR"]");
		input_to("get_answer", me);
		return;
	}
}

void get_answer(string ques,object me)
{
	if(ques=="n"||ques=="N") {
	write("\n\tok，修改纪录管理完毕。
"HIW"－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－\n");
	return;
	}
	else {
		write("请输入向玩家公开的内容：[输入"HIW"none"NOR"取消]");
		input_to("get_info",me);
		return;
	}
}

void get_info(string info,object me)
{
	string change=read_file("/doc/help/change");
	if(info==""||info=="none") {
		write("\n\tok，取消输入。修改纪录管理完毕。
"HIW"－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－\n"NOR);
		return;}
	else {
	if (strlen(info)>64) info=info[0..41]+"\n"+info[42..(sizeof(info))];
	change=replace_string(change,
"────────────────────────────────
[41;1;37m	【最新改进】						[2;37;0m
────────────────────────────────[2;37;0m",
"────────────────────────────────
[41;1;37m	【最新改进】						[2;37;0m
────────────────────────────────[2;37;0m\n"HIC+CHINESE_D->chinese_time(7,ctime(time()))+NOR"："HIY+info+NOR);
	write_file("/doc/help/change",change,1);
	write("\n\tok，输入完成。修改纪录管理完毕。
"HIW"－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－－\n");
	return;
	}
}

int help()
{
write(@HELP
指令格式 : rchange

用途：用来纪录对游戏的修改。
HELP
     );
     return 1;
}
