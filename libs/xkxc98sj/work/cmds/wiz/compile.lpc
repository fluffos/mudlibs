// compile.c

#include <ansi.h>

int help(object me);
inherit F_CLEAN_UP;

int main(object me, string arg) {
  string from, to;

  if (!SECURITY_D->valid_grant(me, "(wizard)"))
    return 0;

  if (!arg)
    return help(me);

  if (sscanf(arg, "%s %s", from, to) != 2)
    return help(me);

  from = resolve_path(me->query("cwd"), from);
  to = resolve_path(me->query("cwd"), to);

  if (file_size(from) <= 0)
    return notify_fail("没有这个文件。\n");

  else {
    if (file_size(to) >= 0)
      rm(to);

    generate_source(from, to);
    write("文件 " WHT + from + NOR " 已经成功编译到了文件 "
      WHT + to + NOR " 中。\n");

    return 1;
  }
}

int help(object me) {
  write(@HELP
指令格式 : compile <文件A> [<文件B>]

呼叫 LPC -> C 的编译程序，产生指定物件的原始码。
如果没有指定文件B，那么编译出来的档案将会被放在
binaries 目录。
HELP
  );
  return 1;
}
