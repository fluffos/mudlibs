// hell.c

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", HIR "第十八层地狱" NOR);
  set("long", @LONG
这里就是传说中最恐怖的地方，天上地下除了巫师收监的犯规玩家
之外无人能至。只见一片黑暗中，向上无限长，向下无限广，向前无限
远，向后无限延伸。只有黑暗中一双绿色的眼睛在闪动，你定睛一看，
原来是一名狱卒。
LONG);
  set("objects", ([
    __DIR__ "npc/yuzu": 1,
  ]));
  set("no_save", 1);
  set("no_fight", 1);
  set("no_beg", 1);
  set("no_steal", 1);
  set("no_dazuo", 1);

  setup();
}
