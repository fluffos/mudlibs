// mao.c

inherit NPC;

void create() {
  set_name("茅十八", ({ "mao shiba", "mao" }));
  set("gender", "男性");
  set("age", 32);
  set("long", "一个虬髯大汉，头上包了白布。\n");
  set("attitude", "peaceful");
  set("shen_type", 0);
  set("str", 20);
  set("int", 18);
  set("con", 22);
  set("dex", 24);

  set("max_qi", 1000);
  set("max_jing", 1000);
  set("neili", 1000);
  set("max_neili", 1000);
  set("combat_exp", 450000);


  set_skill("force", 140);
  set_skill("dodge", 140);
  set_skill("unarmed", 140);
  set_skill("blade", 140);
  set_skill("parry", 140);
  setup();
  carry_object(__DIR__ "obj/cloth")->wear();
  carry_object(__DIR__ "obj/blade")->wield();

}
