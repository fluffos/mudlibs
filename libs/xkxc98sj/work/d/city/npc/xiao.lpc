//  xiao.c

inherit NPC;
inherit F_DEALER;

void create() {
  set_name("萧老板", ({ "xiao laoban", "xiao", "laoban" }));
  set("shen_type", 1);

  set("gender", "男性");
  set("age", 40);
  set("long", "这位老板显然养尊处优，脸蛋和手掌都肥肥胖胖的。\n");
  set_skill("unarmed", 25);
  set_skill("dodge", 22);
  set_temp("apply/damage", 20);

  set("combat_exp", 9000);
  set("attitude", "friendly");
  set("vendor_goods", ({
    __DIR__ "obj/xiao",
    __DIR__ "obj/pipa",
    __DIR__ "obj/yqin",
    __DIR__ "obj/dongbula",
  }));

  setup();
  carry_object("/clone/misc/cloth")->wear();
}

void init() {
  add_action("do_list", "list");
  add_action("do_buy", "buy");
}
