inherit ROOM;
void create() {
  set("short", "山峰脚下");
  set("long", @LONG
这里四周长着许多长草，此岛名为“灵蛇岛”，岛上定然长虫特多，不
时会有毒虫窜出。在这里你只能尽往光秃的山石处落脚。往南而上是山峰顶
部，依稀可见一座茅屋座落其中。
LONG);
  set("exits", ([
    "south": __DIR__ "lsgu",
    "northup": __DIR__ "shanfeng",
  ]));
  set("objects", ([
    "/d/xingxiu/npc/snake": 1,
  ]));
  set("outdoors", "灵蛇岛");
  setup();
  replace_program(ROOM);
