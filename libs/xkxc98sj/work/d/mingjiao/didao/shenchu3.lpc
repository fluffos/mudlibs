#include <room.h>
inherit ROOM;
void create()
{ 
       set("short","树林深处");
       set("long", @LONG
这是乱树林深处。几十丈高的树木簇在一块，密实的枝叶象一蓬蓬巨伞
般伸向天空，把阳光遮得丝毫也无。你一走进这便觉得阴阴森森的，你的感
觉告诉你，得赶快离开，不能再深入了。
LONG);    
	set("exits", ([
		"east" : __DIR__"shenchu4",
                "south" : __DIR__"shenchu5",			
		"southwest" : __DIR__"shenchu2",
                "northwest" : __DIR__"shenchu1",
	]));   
	set("objects",([
		"/clone/misc/corpse" : 1,
                "/d/xingxiu/npc/snake" : random(3),
	]));
        set("outer_times", 4);
        set("outdoors", "明教光明顶");
        setup();
}

