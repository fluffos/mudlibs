#include <room.h>
inherit ROOM;
void create() {
  set("short", "秘道入口");
  set("long", @LONG
这是一条弯曲而下的秘道入口。地上铺满了极厚的软草。
甬道曲曲折折，伸手四下摸索，两边是凹凹凸凸的石壁。
LONG);
  set("exits", ([
    "out": "/d/mingjiao/wxiang",
    "north": __DIR__ "bidao2",
  ]));
  setup();
}
