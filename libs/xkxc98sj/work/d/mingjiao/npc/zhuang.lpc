// zhuang.c 庄铮 
inherit NPC;
string ask_me();
string ask_xunluo();
void create()
{
        set_name("庄铮", ({ "zhuang zheng", "zhuang", "zheng" }));
        set("gender", "男性");
        set("age", 48);
         create_family("明教",36,"弟子");
        set("long", "他是一个黑汉子，天生臂力奇大，一身皮肤被火熏又红又亮。\n");        
	set("rank_info/respect","旗主");
	set("title","明教锐金旗掌旗使");
	set("str", 40);
        set("int", 20);
        set("con", 26);
        set("dex", 22);
        set("combat_exp", 160000);
        set("attitude", "peaceful");
	set("max_qi",1000);
        set("max_jing",1000);
        set("neili",1000);
        set("max_neili",1000);
	set("jiali",30);
        set_skill("cuff", 60);
	set_skill("blade",60);
	set_skill("parry",60);
	set_skill("piaoyi-shenfa",60);
	set_skill("lieyan-dao",60);
        set_skill("dodge", 60);
	set_skill("force",60);
	set_skill("shenghuo-shengong",60);
	map_skill("force","shenghuo-shengong");
	map_skill("dodge","piaoyi-shenfa");
	map_skill("blade","lieyan-dao");
        set_skill("taizu-quan",60);
        map_skill("parry","lieyan-dao");
        map_skill("cuff","taizu-quan");
        prepare_skill("cuff","taizu-quan"); 
        set("inquiry", ([
              "打铁" : (: ask_me :),
               "画印"  : (: ask_xunluo :),
        ]));       
        set("xl", 6); 
        set("xl2", "zhuang");     
        setup();
	carry_object(BINGQI_D("blade"))->wield();
        carry_object("/d/mingjiao/obj/red-cloth")->wear();
}
string ask_me()
{
       mapping fam;
        object me;
        object ob;
        ob=this_player();
        me=this_object();
        if (!(fam = this_player()->query("family")) 
           || fam["family_name"] != "明教")
                return RANK_D->query_respect(this_player()) + 
                "与本帮素无来往，不知此话从何谈起？";
	if (ob->query_temp("marks/打1"))
		return "你不是刚问了我吗，怎么还不开始？";
        ob->set_temp("marks/打1",1);
	ob=new("/clone/weapon/da-tiechui");
	ob->move(this_player());
	write("庄铮给你一把大铁锤。\n");
        return "你别小看我们锐金旗，我们的功夫可以说太多从打铁而来，既然\n"
	       "你想参加，可要认真哟！";
}        
#include "xunluo.h";
