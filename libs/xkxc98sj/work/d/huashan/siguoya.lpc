inherit ROOM;

void create() {
  set("short", "思过崖");
  set("long", @LONG
这是华山的思过崖。危崖上有个山洞，是华山派历代弟子犯规后囚禁受罚
之所。崖上光秃秃的寸草不生，更无一株树木。这危崖自来自来相传是玉女发
钗上的一颗珍珠，当年华山派的祖师以此危崖为惩罚弟子之所，主要便因此处
无草无木，无虫无鸟，受罚的弟子在面壁思过之时，不致为外物所扰，心有旁
鹜。
LONG);
  set("exits", ([
    "enter": __DIR__ "shandong",
    "southdown": __DIR__ "xiaolu2",
  ]));
  set("outdoors", "华山");

  setup();
  replace_program(ROOM);
}
