#include <room.h>
inherit ROOM;

void create()
{
        set("short", "练功房");
	set("long", @LONG
这是华山派的练功房，厚厚的石墙上打有一排排手掌痕迹，地砖已被踩出
一个个脚印，东面是剑房。
LONG
        );
        set("no_sleep_room","1");

        set("exits",([
"west" : __DIR__"square",
            "east" : __DIR__"jianfang",
]));
        setup();
        replace_program(ROOM);
}
 
