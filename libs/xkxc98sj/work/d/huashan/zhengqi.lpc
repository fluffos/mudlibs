// zhengqi.c 正气堂
// YZC 1995/12/04

inherit ROOM;

void create()
{
        set("short", "正气堂");
	set("long", @LONG
   这是华山掌门岳不群的居所「有所不为轩」，此处是前厅，厅上挂着
「正气堂」三字匾额。厅中很宽敞，却没什么摆设，靠墙放着两把交椅，
这里是岳不群议事、授徒的地方。
LONG
        );

        set("valid_startroom", 1);
        set("no_sleep_room",1);
set("objects",([
__DIR__"npc/ning_zhongze" : 1,
__DIR__"npc/yue_buqun" : 1,
]));
        set("exits", ([
"north" : __DIR__"square",
"south" : __DIR__"zhengqi2",
        ]));

        setup();
}
