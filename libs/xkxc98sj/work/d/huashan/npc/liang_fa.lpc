// liang_fa.c 梁发

inherit NPC;
inherit F_MASTER;

void create()
{
	set_name("梁发", ({ "liang fa", "liang", "liangfa" }));
	set("long", 
"华山十四代弟子梁发，身形魁梧，精明强干，他在同门中排行第三。\n");
	set("gender", "男性");
	set("age", 26);
	set("attitude", "peaceful");
    set("vendetta_mark", "华山派");
	set("shen_type", 1);
	set("str", 24);
	set("int", 24);
	set("con", 24);
	set("dex", 24);
	
	set("max_qi", 500);
	set("max_jing", 250);
	set("neili", 500);
	set("max_neili", 500);
	set("jiali", 30);
	set("combat_exp", 70000);
	set("score", 5000);

        set_skill("sword",  70);
        set_skill("dodge",  70);
        set_skill("unarmed",70); 
        set_skill("force",  70);
        set_skill("parry",  70);
        set_skill("literate",70);
	set_skill("hunyuan-zhang", 70);
        set_skill("huashan-jianfa",  70);
        set_skill("huashan-shenfa",  70);
        set_skill("zixia-gong",70);

	map_skill("force", "zixia-gong");
	map_skill("strike", "hunyuan-zhang");
	map_skill("parry", "huashan-jianfa");
	map_skill("sword", "huashan-jianfa");
       map_skill("dodge", "huashen-shenfa");
	prepare_skill("strike", "hunyuan-zhang");
	create_family("华山派", 14, "弟子");

	setup();
	carry_object("/clone/misc/cloth")->wear();
	carry_object("/clone/weapon/changjian")->wield();
}
void attempt_apprentice(object ob)
{
        command("say 好，我就收下你，你可要为我们华山派争气。");
        command("recruit " + ob->query("id"));
        ob->set("title","华山派第十五代弟子");
}
