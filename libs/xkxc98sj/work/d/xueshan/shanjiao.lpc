inherit ROOM;
void create() {
  set("short", "雪山脚下");
  set("long", @LONG 
你走到了雪山的脚下，这里处在一处盆地，气候适合。许多藏民就在这里
安家落户。北面有个不小的藏民的村庄，密密麻麻的似乎住了不少人。那里应
该有吃住的地方。说不定还能找到什么中原找不到的东西。
LONG);
  set("exits", ([
    "northdown": __DIR__ "cunluo01",
    "westup": __DIR__ "xuelu04",

  ]));
  set("objects", ([
    __DIR__ "npc/dachou": 1,
    __DIR__ "npc/erchou": 1,
    __DIR__ "npc/sanchou": 1,
    __DIR__ "npc/sichou": 1,
    __DIR__ "npc/wuchou": 1,
  ]));
  set("outdoors", "雪山");
  setup();
}
