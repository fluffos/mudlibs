// chanshi03.c 禅室


inherit ROOM;

void create() {
  set("short", "主持禅室");
  set("long", @LONG
这里是一间明亮的禅室。正中一条书桌上摆放着很多经书，其中不乏一些
各个门派的武林秘籍。大轮明王鸠摩智不仅一身武功纵横西域，而且他的佛学，
才华也无人能出其右。
LONG);
  set("exits", ([
    "out": __DIR__ "zoul02"
  ]));
  set("objects", ([
    "/kungfu/class/xueshan/jiumozhi": 1,
    __DIR__ "npc/xlama": 1,
  ]));
  setup();
}
