 // chanshi02.c 禅室
 inherit ROOM;

void create()
{
        set("short","禅室");
        set("long",@LONG
这里是一间禅室，屋里放着关于密宗心法的经书，是大喇嘛们修炼正果的
地方，此处除了喃喃的讼经之声外，并于其他杂音。几位白眉喇嘛正在低头默
念，似乎有什么不解之出，南面的练武场传来阵阵怒吼之声，此乃密宗心法用
到融会贯通，练功时用来震气驱魔的上乘内功。
LONG);
        set("exits",([
                "south": __DIR__"lianwuchang",
                "north": __DIR__"shilu02",
        ]));

        setup();
        replace_program(ROOM);
}
