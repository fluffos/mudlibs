 // baota02.c 宝塔
#include <ansi.h>

inherit ROOM;

int do_use(string arg);
int do_jump(string arg);

void create()
{
        set("short",HIY "玲珑舍利塔"NOR);
        set("long",@LONG
这里是一座落满灰尘的塔里，那有什么舍利子呀，你不禁悻悻的踢了一脚
似乎踢在什么东西上，脚趾隐隐作痛。这里伸手不见五指，跟本找不到出路了
时间一长，你感到一阵阵头昏目眩，似乎该早点离开了。你一抬头，脑袋撞在
什么东西上了，疼的你几乎昏了过去。
LONG);
        set("exits",([
                "out": __DIR__ "xiaodao02"
        ]));
        set("no_clean_up", 0);
        setup();
       // replace_program(ROOM);
}

void init()
{
        add_action("do_use", "use");
        add_action("do_jump", "jump");
}

int do_use(string arg)
{
        object me;
        me = this_player();

        if( !arg || arg=="" ) return 0;
        if (!present("fire", me))  return 0;
        if( arg=="fire" ) {
             write("你点燃了"RED"火折"NOR"，发现头顶上有块木板塌了下来，露出了一个洞。\n");
             message("vision", HIR"突然有火光一闪，火光中你看到了点火的人是" + me->name() + "，火光随后熄灭。\n"NOR,
                    environment(me), ({me}) );
             this_player()->set_temp("marks/跳1", 1);
             return 1;
       }
}

int do_jump(string arg)
{
        object me;
        me = this_player();

        if (me->query_temp("marks/跳1") ) {
            write("你纵身跃上了天花板的洞口，抓住板壁，挣扎着爬了上去。\n");
            message("vision", me->name() + "一纵身已经跃起数尺，手攀住板壁爬了上去。\n",
                    environment(me), ({me}) );
            me->move(__DIR__"baota03");
            message("vision", "吱嘎一声，你吓了一跳，只见"+ me->name() + "鬼鬼祟祟地从地板里钻了出来。\n",
                    environment(me), ({me}) );
            this_player()->delete_temp("marks/跳1");

            return 1;
        }
        else {
            write("你想往哪儿去?!\n");
            return 1;
        }
}

