// by dubei
#include <ansi.h>

inherit ROOM;

#include <room.h>
void create() {
  set("short", "小院");
  set("long", @LONG 
这里是大轮寺的一个小侧院，院子里种植了许多中原的树木，四周寂静
无声，院墙的后面是一座陡峭的山峰，山上白雪皑皑。
LONG);
  set("exits", ([
    "north": __DIR__ "cemen",

  ]));

  setup();
  create_door("north", "小门", "south", DOOR_CLOSED);
}
void init() {
  add_action("do_pa", ({ "climb", "pa" }));
}
int do_pa(string arg) {
  object me;

  me = this_player();
  if (!arg || arg != "tree")
    return notify_fail("你要往哪到那里？\n");

  message_vision("$N扒住树枝，跃身行向上爬去。\n", me);
  me->move(__DIR__ "shushang");
  tell_room(environment(me), me->name() + "从下面爬了上来。\n", ({ me }));
  return 1;
}
