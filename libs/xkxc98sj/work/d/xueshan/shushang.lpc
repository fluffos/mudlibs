//  /d/xueshan/shushang.c 积雪小路
// by dubei
#include <ansi.h>

inherit ROOM;


void create()
{
        set("short","树上");
        set("long",@LONG 
这里是大树的顶部，周围树枝交错，能透过枝叶更加清晰的看到不远
处的一座雪山。
LONG);
           setup(); 
}
void init()
{
        add_action("do_pa", ({ "climb", "pa" })); 
             add_action("do_yue", ({"yue" }));    
}                   
int do_pa(string arg)
{
        object me;

        me=this_player();
        if ( !arg || arg != "down" )
            return notify_fail("你要往那里爬？\n");

        message_vision("$N扒住树枝，向下爬去。\n", me);  
        me->move(__DIR__"xuel01");
	tell_room(environment(me), me->name() + "从树上面爬了下来。\n", ({ me })); 
     	return 1;
}
int do_yue(string arg)
{
        object me;

        me=this_player();
        if ( !arg || arg != "wall" )
            return notify_fail("你要往哪跳？\n");

        message_vision("$N足尖一点脚下树枝，飞身向墙外跳去。\n", me);
        if ((int)me->query_skill("dodge", 1) < 120) 
           {
           message_vision(RED"忽然一阵山风吹过，$N功力不够，在空中一阵摇晃，向地上跌了下去。\n"NOR, me); 
                    me->move(__DIR__"xuel01");
                    tell_room(environment(me), me->name() + "突然从空中摔了下来。\n", ({ me }));
            me->unconcious();
            return 1;
           }
        me->move("/d/xueshan/xuanya");
	tell_room(environment(me), me->name() + "一转身行，轻轻飘落在雪地上。\n", ({ me }));
     	return 1;
}
