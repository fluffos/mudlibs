//      xuelu07.c 积雪小路

#include <ansi.h>

inherit ROOM;


void create() {
  set("short", HIW "雪路" NOR);
  set("long", @LONG 
这是一条积满雪的小路，环看四面群山被白雪覆盖，这种景象在中原是难
以得看的。
LONG);
  set("exits", ([
    "southdown": __DIR__ "xuelu05",
    "northeast": __DIR__ "xuedong",

  ]));

  setup();
}
