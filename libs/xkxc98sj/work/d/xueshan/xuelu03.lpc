//      xuelu03.c 积雪小路

#include <ansi.h>

inherit ROOM;


void create() {
  set("short", HIW "积雪小路" NOR);
  set("long", @LONG 
这是一条积满雪的小路，小路中央已经看到有马匹行人的足迹西藏人信仰
喇嘛教，每逢吉日，必然到庙宇朝拜，看来从这里上山是不会错了。
LONG);
  set("exits", ([
    "northdown": __DIR__ "xuelu02",
    "southwest": __DIR__ "xuelu04"

  ]));

  setup();
}
