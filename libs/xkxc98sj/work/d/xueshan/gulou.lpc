// gulou.c 鼓楼
// by dubei


inherit ROOM;
string gu(object);
string chui(object);
void create() {
  set("short", "鼓楼");
  set("long", @LONG
这里是大轮寺鼓楼，不知是什么原因，只有武功修为到达一定水平，密宗
心法到一定心境之人才能入内。钟楼内一面大鼓(gu)，用厚厚的牦牛皮包裹着
侧面用几百枚金钉钉牢。旁边悬挂一个鼓槌(chui)。是用来敲鼓之用。低头向
窗外一望，但见窗下有很多骸骨散落在地，不知是什么原因。
LONG);
  set("exits", ([
    "eastdown": __DIR__ "lianwuchang",
    "westdown": __DIR__ "xiaodao02"
  ]));

  setup();
}
string gu(object me) {
  return "这是一面大鼓，用厚厚的牦牛皮包裹着，侧面用几百枚金钉钉牢。\n";
}
string chui(object me) {
  return "这是一个甚是巨大的木槌，长约两尺，碗口粗细。\n";
}
void init() {
  add_action("do_strike", "qiao");
}
int do_strike(string arg) {
  object me = this_player();
  int i;

  if (!living(me)) return 0;
  if (arg != "dagu" && arg != "gu")
    return notify_fail("你要敲击什麽？\n");

  if ((int)me->query_skill("lamaism", 1) < 31)
    return notify_fail("你没有密宗心法，跑这里来击打什麽鼓呢？\n");

  if ((int)me->query_skill("hammer", 1) > 61)
    return notify_fail("你轻轻推动鼓槌敲击大鼓，但觉轻松自如，鼓声响彻四周。\n");

  if ((int)me->query_str() < 25)
    return notify_fail("你轻轻推动鼓槌敲击大鼓，只觉得手臂发麻。\n");

  if ((int)me->query("jingli") < 60)
    return notify_fail("你感觉已经无力再去敲击打鼓了。\n");

  i = me->query("str");
  me->receive_damage("jingli", 25 + random(20));
  message_vision("$N扶住鼓槌，向大鼓打去，顿时鼓声咚咚震撼着整个钟楼。\n", me);
  me->improve_skill("hammer", i);
  return 1;
}
