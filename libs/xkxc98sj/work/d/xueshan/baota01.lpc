 // baota01.c 宝塔
#include <ansi.h>

inherit ROOM;

void create()
{
        set("short",HIY "玲珑舍利塔"NOR);
        set("long",@LONG
这里是一座落满灰尘的塔里，那有什么舍利子呀，你不禁悻悻的踢了一脚
似乎踢在什么东西上，脚趾隐隐作痛。这里伸手不见五指，跟本找不到出路了
时间一长，你感到一阵阵头昏目眩，似乎该早点离开了。
LONG);
        set("exits",([
                "out": __DIR__ "xiaodao01"
        ]));

        setup();
        replace_program(ROOM);
}
