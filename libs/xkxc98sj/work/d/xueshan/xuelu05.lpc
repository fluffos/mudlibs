//      xuelu05.c 积雪小路

#include <ansi.h>

inherit ROOM;


void create() {
  set("short", HIW "积雪小路" NOR);
  set("long", @LONG 
这是一条积满雪的小路，小路中央已经看到有马匹行人的足迹西藏人信仰
喇嘛教，每逢吉日，必然到庙宇朝拜，看来从这里上山是不会错了。向北抬头
望去，是一座飘雪的山峰。再东南看去，一座入云的雪山，那里就大雪山第一
高峰了。
LONG);
  set("exits", ([
    "southeast": __DIR__ "xuelu06",
    "northup": __DIR__ "xuelu07",
    "westup": __DIR__ "shijie"

  ]));

  setup();
}
