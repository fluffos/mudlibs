// chanshi03.c 禅室


inherit ROOM;

void create() {
  set("short", "法王禅室");
  set("long", @LONG
这里是一间禅室，面积较大。四壁摆满了各种经书，其中还有不少是中原
武林难得一见的密宗佛经和武功密籍。整间禅房用黄金装饰，显得气势辉煌而
不显庸俗，室内四季温暖如春。禅桌上供奉各种供品。蒲团上一位老僧正在闭
目养神。墙上有金银铜铁铅五只法轮。金轮法王纵横西域，却仅仅凭的是一把
金轮。
LONG);
  set("exits", ([
    "eastup": __DIR__ "fatan01"
  ]));
  set("objects", ([
    "/kungfu/class/xueshan/fawang": 1,
    __DIR__ "npc/xlama": 1,
  ]));
  setup();
}
