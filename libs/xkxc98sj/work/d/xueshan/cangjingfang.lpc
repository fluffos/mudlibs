 // cangjingfang.c 藏经房

inherit ROOM;

void create()
{
        set("short","藏经房");
        set("long",@LONG
密宗讲究以佛养精，研读佛经是永无止境的，多少喇嘛耗一生之精力，在
此修炼密宗佛法。阁中藏有远自西域，天竺的手抄经书，非一般喇嘛所能领悟
的。更有解释密宗武功的经典，需要悟性，武功一流的高僧才能研读。西侧开
着一个小门，有几名红衣喇嘛把守。
LONG);
        set("exits",([
                "south": __DIR__ "chanshi01",
                "westup": __DIR__"zhonglou"
        ]));
               set("objects",([
                "/kungfu/class/xueshan/duoji" : 1,
        ]));
        setup();
        replace_program(ROOM);
}
