 // fatan03.c 法坛

#include <ansi.h>

inherit ROOM;

void create()
{
        set("short",HIW"法坛"NOR);
        set("long",@LONG
这里是大轮寺法坛，每年远在天竺的高僧都要来此研习上乘佛法，这个法
坛的面积远不如紫金法坛大，全是由白石砌成，好不庄严，四壁上写满了驱妖
降魔的梵文(fanwen)符咒。
LONG);
        set("exits",([
                "west": __DIR__"fatan05",
                "northeast": __DIR__"fatan01"
        ]));

        setup(); 
}
void init()
{
     add_action("do_study", "du"); 
        add_action("do_study", "study");
}

int do_study(string arg)
{
	object me;
       int i;

	me = this_player();
       i= me->query_skill("longxiang-gong",1)+1;
       if( arg != "fanwen") return 0;
  
	if(!living(me)) 	return 0;
	
        if (me->is_busy() || me->is_fighting()){
		write("你此刻正忙着呢,没空钻研喇嘛教意！\n");
           	return 1;
	}
	if ((int)me->query("jing") < 40 ){
		write("你太累了，无法继续学习了！\n");
              	return 1;
	}
	if ((int)me->query_skill("lamaism", 1) > 101 ){
	           write("你已经尽数领悟了此层的梵文。\n");
          return 1;
	}


	if ((int)me->query_skill("literate", 1) < 30 ){
		write("你读书写字水平不够,无法领悟此地的经文。\n");
  	return 1;
	}
            if ((int)me->query_skill("lamaism",1)<61){
              write("这层的梵文对你来说太难了。\n");
          	return 1;
	}  
            if( (int)me->query_skill("lamaism",1) > i){
               write("密宗心法需要以龙象般若功相辅相成。\n");

	  	return 1;
	} 

	  
	me->receive_damage("jing", 25+random(20));
	me->improve_skill("lamaism", i);
	message_vision("$N正专心默诵四壁上的梵文,有所心得。\n", me);
 	return 1;
} 
