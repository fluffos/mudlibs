//      shankou.c 雪地
#include <ansi.h>
inherit ROOM;
void create() {
  set("short", HIW "雪地" NOR);
  set("long", @LONG 
这里是山脚下的一块雪地，风从背后的山口吹来，你不禁感到阵阵寒意。
厚厚的积雪踩在脚下“吱吱”作响，偶尔低头看去，似乎可以看到有马匹刚刚
踩过的足迹。看来这里是通往那座庙宇的路了。
LONG);
  set("exits", ([
    "eastdown": __DIR__ "shankou",
    "northup": __DIR__ "xuedi02",
    "southup": __DIR__ "xuelu01"

  ]));

  setup();
}
