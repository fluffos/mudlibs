inherit ROOM;


void create()
{
        set("short","走廊");
        set("long",@LONG 
这里是侧殿的一条长长走廊，南面是喇嘛用膳的斋堂。大轮寺地处雪山荒
地，喇嘛们生活清苦，走廊用石砖铺地，走上去微微感到有些凹凸不平。
LONG);
        set("exits",([
                "south" : __DIR__"zhaitang",
