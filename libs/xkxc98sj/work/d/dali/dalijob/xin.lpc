//by cool.98.6.4
#include <ansi.h>
inherit ITEM;

void create() {
  set_name(RED "密函" NOR, ({ "mihan", "mi han", "secret letter" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "封");
    set("long",
      "这是一封密函，镇南王亲笔手谕，信封的很严实，封口盖着红漆印戳。\n");
    set("value", 0);
    set("material", "paper");
  }
}
void init() {
  call_out("dest", 1000);
  add_action("do_send", "songxin");
  add_action("do_look", "kan");
  add_action("do_look", "chakan");
}
int do_look(string arg) {
  int now_time, time;
  object me;

  me = this_player();
  now_time = me->query_condition("dali_songxin");
  time = me->query_temp("songxin_time");

  if (!arg) return 0;
  if ((arg == "mi han" || arg == "mihan") && me->query_temp("dali_songxin")) {
    write(
      "\n这是一封由大理国镇南王发出的密函，上面写着"
      HIR " 「" + me->query_temp("songxin_target_name") + "」 亲启。\n" NOR);
    if (now_time > time * 3 / 4) write("你现在有充足的时间去送信。\n");
    if (now_time > time / 2 && now_time <= time * 3 / 4) write("已经过去一小半时间了。\n");
    if (now_time > time / 4 && now_time <= time / 2) write("你还有一半的时间去送信。\n");
    if (now_time > time / 8 && now_time <= time / 4) write("你的时间已经不多了。\n");
    if (now_time > 0 && now_time <= time / 8) write("时间将至，任务即将失败。\n");
  } else {
    if ((arg == "mi han" || arg == "mihan") && !me->query_temp("dali_songxin"))
      write("这是一封密函，镇南王亲笔手谕，信封的很严实，封口盖着红漆印戳。\n");
  }
  return 1;

}
int do_send(string arg) {
  int i, job_time, exp, sh, pot;
  object ob;
  object me, target;
  string t_name, t_id;
  me = this_player();

  if (!arg) return notify_fail("你要送给谁？\n");
  if (!objectp(target = present(arg, environment(me)))) return notify_fail("看清楚点，你要送信的人不在这里！\n");
  t_name = target->query("name");
  t_id = target->query("id");
  job_time = (int)me->query("dali_songxin", 1);
  i = me->query_temp("killer_die");
  if (i > 3) i = 2;

  if (!target) return notify_fail("看清楚点，你要送信的人不在这里！\n");
  if (target->query("victim_user")) return notify_fail("嘿嘿，想作弊？！\n");
  if (me->query_temp("dali_songxin_late"))
    return notify_fail("你任务已经失败了，重新再领一个吧。\n");
  if (!present("secret letter", this_player()))
    return notify_fail("你身上没有携带密函。\n");
  if (!me->query_temp("dali_join"))
    return notify_fail(t_name + "道：你不是大理国的随从，怎么会送镇南王手谕的密函给我？");
  if (!me->query_temp("dali_songxin"))
    return notify_fail(t_name + "道：这是大理国镇南王府亲自交给你,要你送的？你是不是从别人那里抢来的？");
  if (me->query_temp("songxin_target_name") != t_name)
    return notify_fail(t_name + "道：这封密函不是给我的，你是不是送错了？");
  message_vision(HIY "$N擦了一把额头的汗，从怀中掏出密函交给$n说道，这是段王爷让在下送给您的密函，请您收好。\n" NOR, me, target);
  message_vision("$N交给了$n一封密函。\n", me, target);

  message_vision(HIY "$N接过信看了看，点了点头说道：这位" + RANK_D->query_respect(me) + "辛苦你了。\n" NOR, target, me);

  if ((int)me->query("combat_exp") < 300000) {
    if (!me->query_temp("songxin_zuji")) {
      exp = ((1 + random(3)) * 10 + (int)(job_time / 5));
      pot = 10 + random(me->query("max_pot") / 6);
      sh = exp * 3;
    } else {
      exp = ((1 + random(i + 1)) * 60 + (int)(job_time / 5));
      pot = 20 + random(me->query("max_pot") / (4 - i * 2));
      sh = exp * 6;
    }
  }
  if ((int)me->query("combat_exp") < 600000 && (int)me->query("combat_exp") > 300000) {

    if (!me->query_temp("songxin_zuji")) {
      exp = (1 + random(3)) * 20 + (int)(job_time / 5);
      pot = 20 + random(me->query("max_pot") / 6);
      sh = exp / 4;
    } else {
      exp = (1 + random(i * 2)) * 80 + (int)(job_time / 5);
      pot = 40 + random(me->query("max_pot") / 5 * (i + 1));
      if (pot > 200) pot = 200;
      sh = exp * 2 / 3;
    }
  }
  if ((int)me->query("combat_exp") > 600000) {

    if (!me->query_temp("songxin_zuji")) {
      exp = (1 + random(3)) * 30 + (int)(job_time / 5);
      pot = 30 + random(me->query("max_pot") / 6);
      sh = exp / 4;
    } else {
      exp = (1 + random(i * 2)) * 100 + (int)(job_time / 4);
      pot = 60 + random(me->query("max_pot") / 5 * (i + 1));
      if (pot > 200) pot = 200;
      sh = exp * 3 / 4;
    }
  }

  me->add("shen", sh);
  me->add("potential", pot);
  if (me->query("potential") > me->query("max_pot"))
    me->set("potential", me->query("max_pot"));
  me->add("combat_exp", exp);
  me->add("dali_job", 1);

  tell_object(me, HIW "好！任务完成,你被奖励了：\n" +
    chinese_number(exp) + "点实战经验\n" +
    chinese_number(pot) + "点潜能\n" +
    chinese_number(sh) + "点正神\n" +
    //            chinese_number(i)+"两白银\n"+
    "你为镇南王府做了" + me->query("dali_job") + "次工作。\n"
    NOR);
  me->clear_condition("dali_songxin");
  me->delete_temp("dali_songxin");
  me->delete_temp("songxin_time");
  me->delete_temp("songxin_target_name");
  me->delete_temp("songxin_where");
  me->delete_temp("killer_die");
  me->set_temp("songxin_ok", 1);
  me->delete_temp("songxin_zuji");
  destruct(this_object());
  return 1;
}
void dest() {
  object me;
  me = this_player();
  write("书信忽然掉落在路上不见了。\n", me);
  destruct(this_object());
}
