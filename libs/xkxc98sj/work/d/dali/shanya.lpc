// shanya.c
// bbb 1997/06/11

#include <ansi.h>

inherit ROOM;

string look_down();


void create()
{
	set("short", "山崖");
	set("long", @LONG
走出十余里，你来到无量山主峰的后山，猛听到水声响亮，便如潮水大
至一样，抬头一看，只见西北角上犹如银河倒悬，一条大瀑布从高崖上直泻
下来。这里丛林密布，山石怪异。旁边就是一深不见底的悬崖(cliff)。
LONG
	);

	set("exits", ([
		"westdown" : __DIR__"shanlu5",
	]));

	set("item_desc",([
		"cliff"		:	(: look_down :),
		"down"		:	"下面白茫茫的什么也看不见。\n"
	]));
	setup();
}


void init()
{
	add_action("do_down", "down");
}



int do_down(string arg)
{
	object me;

	me = this_player();

	message_vision(HIR "$N脚下踩一个空，「啊～～～」发出一声惨叫，向下直坠下去。\n" 
        "$N坠下百余丈，撞到崖边一棵古松上，弹了几弹，下坠的巨力却也消了。\n" NOR, me); 
        me->move(__DIR__"bankong");
	return 1;
}


string look_down()
{
	return  "下面(down)深不可测，根本看不到底，如果你要自杀，这到是个好地方。\n";
}
