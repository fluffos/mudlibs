inherit ROOM;

void create() {
  set("short", "蝴蝶泉");
  set("long", @LONG
这是在大理城北四十公里的苍山云弄峰下。沿林荫小道曲折前行，只见
古树林立，浓荫蔽天，一方清泉嵌于其间，底铺青石，泉水明澈，常有人掷
金属钱币于池不，观其缓缓旋落，阳光从树顶筛下，池底银光闪烁，倍感泉
水清冽。
LONG
  );
  set("outdoors", "dali");

  set("exits", ([
    "southwest": __DIR__ "dadao3",
    "east": __DIR__ "hth",
  ]));

