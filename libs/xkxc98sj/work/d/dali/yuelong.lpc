inherit ROOM;

void create()
{
	set("short", "玉龙雪山");
	set("long", @LONG
全山十三峰，峰峰终年披云戴雪，似一排玉柱立地擎天，并肩耸立在金
沙江东岸；如一条矫健的玉龙。从碧空蜿蜒而来，腾跃于锦绣大地之上。它
气势磅礴，洋溢着一种雄奇、壮丽的美。
以下备用：
以松而论，从下到上分布着云南松华山松、云杉、红杉、冷杉。山上的杜鹃花
就有四十多种，报春花，龙胆、山茶、兰花、百合、木兰、绿绒蒿等云南八大
名花无不具备。每当春末夏初，百花斗艳，林木苍郁，各种珍禽异兽活跃于山
间，将一座座银装素裹的雪峰映衬得分外妖娆，生机。玉龙山不仅是林木花卉
的海洋，也是药材的故乡。虫草、雪茶、雪莲、麻黄、三分三、贝母、茯苓、
重楼、木香等名贵药材，
LONG
	);
        set("outdoors", "dali");

	set("exits", ([
             "northdown" : __DIR__"ninglang",
	]));

	setup();
//	replace_program(ROOM);
}
void init()
{
            object me = this_player();
     if(me->query_temp("xuncheng"))
     {
       me->set_temp("dali_xc/yuelong",1);
      }
}
