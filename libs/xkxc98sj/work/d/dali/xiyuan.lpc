inherit ROOM;
#include <ansi.h>
void create()
{
        set("short",HIC"戏园子"NOR);
        set("long", @LONG
这是一座大理城里鼎鼎有名的戏园，台下不时地传来票友们的
叫跃，喝彩声。场中一个大戏台，台上正演的精彩，是《武松打虎》，
你也忍不住想坐下来看看戏，放松一下筋骨。
LONG
);
        set("exits", ([ 
        "south" : __DIR__"dongjie3",
	]));
        set("objects",([
	"/d/suzhou/npc/piaoyou" : 3,
]));
      setup();
	replace_program(ROOM);

}

