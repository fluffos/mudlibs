inherit ROOM;

void create()

{
       set("short", "石路");
	set("long", @LONG
这是一段石板路，路是用大青石板铺成的，铺的整整齐齐，
大路由西向东，一直通向大理皇宫，路两边都是参天大树，郁郁
葱葱，几缕阳光从树叶之间的缝隙照下来，在地上撒下点点光斑，
路边树旁，顺过去，立了一排石翁仲，几个大理国士兵站在两侧。
LONG
	);
        set("outdoors", "dali");
	set("exits", ([ 
	    "west" : __DIR__"shilu1",
	    "east" : __DIR__"shilu3",
	]));
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
