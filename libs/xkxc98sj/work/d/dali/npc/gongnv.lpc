//  gongnv.c
inherit NPC;

void create() {
  set_name("宫女", ({ "gong nv" }));
  set("gender", "女性");
  set("age", 15 + random(10));
  set("long",
    "这是大理皇宫内的一个宫女，貌美如花。\n");
  set("combat_exp", 6000);
  set("shen_type", 1);
  set("attitude", "friendly");
  setup();

  set("apply/attack", 20);
  set("apply/defense", 20);

  set_skill("unarmed", 20);
  set_skill("claw", 20);
  set_skill("parry", 20);
  set_skill("dodge", 26);
  setup();

  carry_object("/clone/misc/cloth")->wear();
}
