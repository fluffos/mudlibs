// duan2.c

#include <ansi.h>

inherit NPC;

void create() {
  set_name("段誉", ({ "duan yu", "duan" }));
  set("gender", "男性");
  set("age", 25);
  set("long", "他手里拿着书，不知道是在念叨什么，还是在想什么心事。\n");
  set("combat_exp", 350000);
  set("chat_msg_combat", ({
    (: exert_function, "recover" :),
    (: perform_action, "sword.qian" :)
  }));
  set("attitude", "friendly");
  set("rank_info/respect", "小王爷");
  set("inquiry", ([
    "name": "我就是段誉，大理国姓的段，名誉不好的誉。",
    "here": "这是我爹爹的王府，你问这干吗！",
  ]));
  setup();
  set_skill("force", 200);
  set_skill("dodge", 250);
  set_skill("parry", 250);
  set_skill("finger", 200);
  set_skill("tianlong-shengong", 200);
  set_skill("liumai-shenjian", 200);
  set_skill("lingbo-weibu", 200);
  map_skill("dodge", "lingbo-weibu");
  map_skill("finger", "liumai-shenjian");
  map_skill("force", "tianlong-shengong");
  prepare_skill("finger", "liumai-shenjian");
  carry_object(__DIR__ "obj/cloth")->wear();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(3)) {
    case 0:
      command("slogan");
    case 1:
      command("rose");
    case 2:
      break;
  }
}
