//  taijian.c
inherit NPC;

void create() {
  set_name("太监", ({ "tai jian" }));
  set("gender", "无性");
  set("age", 10 + random(30));
  set("long",
    "这是大理皇宫内的一个太监。\n");
  set("combat_exp", 10000);
  set("shen_type", 1);
  set("attitude", "friendly");
  set("inquiry", ([
    "name": "你问我名字干嘛？有什么好事啊？",
  ]));
  setup();

  set("apply/attack", 30);
  set("apply/defense", 30);

  set_skill("unarmed", 40);
  set_skill("strike", 40);
  set_skill("parry", 40);
  set_skill("dodge", 46);
  setup();

  carry_object("/clone/misc/cloth")->wear();
}
