// huasitu.c

inherit NPC;

void create()
{
	set_name("华赫艮", ({ "hua hegen", "hua","situ" }));
	set("title", "大理国司徒");
	set("gender", "男性");
	set("age", 45);
	set("str", 25);
	set("dex", 25);
	set("long", "这人紫趟脸，粗手粗脚，显是练有外门功夫。\n");
	set("combat_exp", 450000);
	set("shen_type", 1);
	set("attitude", "heroism");

	set_skill("unarmed", 100);
	set_skill("force", 100);
	set_skill("cuff",100);
	set_skill("dodge", 100);
	set_skill("parry", 100);
	set_temp("apply/attack", 70);
	set_temp("apply/defense", 70);
	set_temp("apply/armor", 70);
	set_temp("apply/damage", 20);

	set("max_qi", 800);
	set("neili", 800); 
	set("max_neili", 900);
	set("jiali", 20);

	setup();
}

int accept_fight(object me)
{
	command("say 本官不愿与江湖人动手过招了，今日也不想破例。");
	return 0;
}

int accept_object(object who, object ob)
{
	if (ob->id("axiang letter")) 
	{
		tell_object(who, "你给华赫艮一封阿祥的信。\n");
		tell_object(who, "华赫艮拆开信看了看，点头说道：“既然是阿祥写信来，我就把东西给你吧。”\n");
		destruct(ob);
		new("/d/xiangyang/obj/diggertools")->move(who);
		tell_object(who, "华赫艮给你一套盗墓工具。\n");
		return notify_fail("");
	}
	return 0;
}

