// shibi.c
// bbb 1997/06/11
inherit ROOM;

void check_trigger();
void close_passage();
void reset();
int do_push(string arg);
int do_tear(string arg);
string look_xiaoshi();
string look_dashi();

void create()
{
	set("short", "石壁");
	set("long", @LONG
大岩石(dashi)。
    小岩石(xiaoshi)
LONG
	);

	set("exits", ([
		"out" : __DIR__"shuhou",
	]));

	set("item_desc",([
		"dashi"		:	(: look_dashi :),
		"xiaoshi"	:	(: look_xiaoshi :),
	]));

	setup();
}


void init()
{
	add_action("do_push", "huang");
	add_action("do_pull", "tui");
	add_action("do_tear", "tear");
}

void check_trigger()
{
	object room;

	if( (int)query("up_trigger")==2
	&&	(int)query("down_trigger")==2
	&&	!query("exits/down") ) {
		message("vision", "岩石缓缓转动，便如一扇大门似的，"
			"转到一半，岩后露出一个洞穴。\n", this_object() );
		set("exits/enter", __DIR__"dong1");
		
		delete("poem_teared");
		delete("up_trigger");
		delete("down_trigger");
		remove_call_out("close_passage");
		call_out("close_passage", 10);
	}
}

void close_passage()
{
	object room;

	if( !query("exits/down") ) return;
	message("vision", "岩石忽然发出轧轧的声音，缓缓地移回原处，"
		"将洞口盖住了。\n", this_object() );
	delete("exits/down");
}


int do_pull(string arg)
{
	string dir;

	if( !arg || arg=="" ) return 0;

	if( arg=="dashi" && (int)query("poem_teared")==1 ) {
		write("你试着推动这块岩石，发现可以晃动......\n");
		return 1;
	}
	if( sscanf(arg, "dashi %s", dir)==1 && (int)query("poem_teared")==1 ) {
		if( dir=="right" ) {
            message_vision("$N将岩石推了推，岩石晃了晃，又移回原位。\n",
				this_player());
			add("up_trigger", 1);
			check_trigger();
			return 1;
		} else {
			write("你要将大岩石推向那个方向？\n");
			return 1;
		}
	}
}

int do_push(string arg)
{
	string dir;

	if( !arg || arg=="" ) return 0;

	if( arg=="dashi" && (int)query("poem_teared")==1 ) {
		write("你试着晃动这块岩石，发现可以推动......\n");
		return 1;
	}
	if( sscanf(arg, "dashi %s", dir)==1 && (int)query("poem_teared")==1 ) {
		if( dir=="left" ) {
            message_vision("$N将岩石往左晃，岩石动了动，又移回原位。\n",
				this_player());
			add("down_trigger", 1);
			check_trigger();
			return 1;
		} else {
			write("你要将大岩石推向那个方向？\n");
			return 1;
		}
	}
}

int do_tear(string arg)
{
	string dir;

	if( !arg || arg=="" )  return 0;

	if( arg =="cao" )  {
		write("你要除草吗？ !\n");
		return 1;
	}

	if( arg=="teng" ) {
		write("你把大小岩石间的藤蔓尽数除去。\n");
		set("poem_teared", 1);
		return 1;
	}
}

void reset()
{
	::reset();
	delete("poem_teared");
	delete("up_trigger");
	delete("down_trigger");
}

string look_xiaoshi()
{
	return
	 "很多的草藤之类缠在它的上面。\n";
}

string look_dashi()
{
	return
	"岩高齐胸，凌空置于一块小岩石之上。\n";
}



