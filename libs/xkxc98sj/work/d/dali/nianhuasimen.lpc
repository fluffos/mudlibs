inherit ROOM;

void create()
{
set("short", "拈花寺");
	set("long", @LONG
你站在一座小小的古庙前，庙门上写着‘拈花寺’三字。佛教是大理
国教。大理京城内外，大寺数十，小庙以百计，这座‘拈花寺’地处偏僻，
无甚香火，即是世居大理之人，多半也不知晓。
LONG
	);
        set("outdoors", "dali");
	set("exits", ([ /* sizeof() == 1 */
	    "enter" : __DIR__"nianhuasi",
	    "southeast" : __DIR__"road4",
           ]));
       set("objects", ([
	__DIR__"npc/shami" : 1 ]) );

	set("no_clean_up", 0);

	setup();
//	replace_program(ROOM);
}
void init()
{
            object me = this_player();
     if(me->query_temp("xuncheng"))
     {
       me->set_temp("dali_xc/nianhuasimen",1);
      }
}


