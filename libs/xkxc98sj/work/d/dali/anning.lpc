inherit ROOM;

void create()
{
	set("short", "安宁温泉");
	set("long", @LONG
这里位于昆明西郊约40公里的螳螂川畔。这里山峦叠翠、森林茂密、空
气清新、自然环境优美，螳螂川江水绕泉而过。泉水质地优良，水温在摄氏
43—45℃之间，含有人体多种疾病较好疗效的各种微量元素，被誉为“天下
第一汤”。
LONG
	);
        set("outdoors", "dali");

	set("exits", ([
          "west" : __DIR__"xgf",
	]));
set("objects", ([
	      __DIR__"npc/caihuashe" : 1,
             __DIR__"npc/dayetu" : 1,
	]));

	setup();
//	replace_program(ROOM);
}
void init()
{
            object me = this_player();
     if(me->query_temp("xuncheng"))
     {
       me->set_temp("dali_xc/anning",1);
      }
}

