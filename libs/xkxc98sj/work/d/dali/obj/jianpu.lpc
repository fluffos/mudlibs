// liumai-shenjian 剑谱

#include <armor.h>

inherit ITEM;

void create()
{
	set_name("卷轴", ({ "juan zhou", "zhou", "shu", "book" }));
                set("treasure", 1);
	set_weight(2000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "卷");
		set("long",
			"六脉神剑经\n"
			"这是一卷帛布，上面绘着一个男子，身上注明穴位，绘着六脉的运走行经。\n");
		set("value", 500);
		set("material", "steel");
		set("armor_prop/armor", 3 );
		set("skill", ([
			"name":	"liumai-shenjian",	// name of the skill
			"exp_required":	50000,	// minimum combat experience required
			"jing_cost":	10,	// jing cost every time study this
			"difficulty":	20,	// the base int to learn this skill
			"max_skill":	29	// the maximum level you can learn
		]) );
	}
}

void init()
{
	if( this_player() == environment() )
		add_action("do_study", "study");
}

int do_study(string arg)
{
	object me = this_player();

	if ( arg != "juan zhou" && arg != "zhou" )
	return notify_fail("你要学什么？\n");

	if ( me->is_fighting() 
	&& (int)me->query_skill("liumai-shenjian", 1) >= 30 
	&& (int)me->query_skill("liumai-shenjian", 1) <= 100 )
	{
		me->receive_damage("jing", 20);
		me->improve_skill("liumai-shenjian", me->query("int"));
		message_vision("$N一边战斗，一边抽空急急忙忙地拿出卷轴仔细研究。\n", me);
		return 1;
	}

	return 0;
}
