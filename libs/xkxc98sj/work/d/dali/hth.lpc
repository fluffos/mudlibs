inherit ROOM;

void create() {
  set("short", "蝴蝶会");
  set("long", @LONG
蝴蝶泉的景致美，这里一年一度的蝴蝶会更加引人。每当春末夏初，雨
季未到之前，周围田野庄稼收割将尽，田野较为干枯炎热，相对之下，蝴蝶
泉就更加显得清凉湿润，这时恰好是蝴蝶交尾产卵的季节，成了远近数十里
蝴蝶交欢的极乐世界。大量的蝴蝶，从四面八方，汇集在树荫下，花丛中，
翩翩起舞，成千上万只彩蝶，欢聚一处，使这里变得花团锦簇。
LONG
  );
  set("outdoors", "dali");

  set("exits", ([
    "east": __DIR__ "erhai",
    "west": __DIR__ "htq",
  ]));

  setup();
}
