#include <room.h>

inherit ROOM;

void create()
{
	set("short", "大理北门");
	set("long", @LONG
这是大理北城门，大理和大宋间的来往都要经过此门，往北你可看到一
条宽广笔直的石板大道，可以通向中原。城门两边的武将和士兵门认真地检
查着过往的行人，不少中原来的江洋大盗均在此落网。
LONG
	);

	set("exits", ([
		"south" : __DIR__"beijie1",
		"north" : __DIR__"dadao4",
	]));
	set("objects", ([
		__DIR__"npc/wujiang" : 1,
		__DIR__"npc/bing" : 2,
	]));
    set("outdoors", "大理");
	setup();
}
