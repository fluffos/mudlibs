inherit ROOM;
#include <ansi.h>
void create() {
  set("short", HIC "茶花园" NOR);
  set("long", @LONG
 大理茶花名满天下，这个里是一个小山坡，花园依山而建，山坡
上种满了茶花，有上等品种‘红妆素裹’，‘十八学士’，也有差
一些的‘落第秀才’，和‘抓破美人脸’。
LONG
  );
  set("exits", ([
    "northup": __DIR__ "chahuayuan2",
    "south": __DIR__ "dongjie1",
  ]));

  set("objects", ([
    "/d/dali/obj/chahua1": 1,
    "/d/dali/obj/chahua": 1,
  ]));
  setup();

}
