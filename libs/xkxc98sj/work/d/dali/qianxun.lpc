inherit ROOM;

void create()
{
	set("short", "千寻塔");
	set("long", @LONG
三塔的主塔名叫千寻塔，高六十九点一三米，为方形十六层密檐式塔，与
西安大小雁塔同是唐代的典型建筑。塔下仰望，只见塔矗云端，云移塔驻似有
倾倒之势。塔的基座呈方形，分二层，下层边长为三十三点五公尺，四周有石
栏，栏的四角柱头雕有石狮；上层边长二十一公尺，其东面正中有石照壁，上
有黔国公沐英后裔洒世阶题的“永镇山川”四个大字，庄重雄奇，颇有气魄。
LONG
	);
        set("outdoors", "大理");

	set("exits", ([
		"up" : __DIR__"ta1",
		"north" : __DIR__"zoulang2",
		"south" : __DIR__"3ta",
		"west" : __DIR__"xiaota",
	]));
	set("valid_startroom", 1);
	setup();
        "/clone/board/tianlong_b.lpc"->foo();
}
