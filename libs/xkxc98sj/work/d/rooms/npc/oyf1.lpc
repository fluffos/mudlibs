// oyf.c 欧阳锋

#include <ansi.h>

inherit NPC;


void create()
{
       set_name("欧阳锋", ({ "ouyang feng", "ouyang", "feng" }) );
       set("gender", "男性" );
       set("title", BLU "老毒物" NOR);
       create_family("白陀山庄", 1, "庄主");
       set("shen_type", -1);
       set("age", 70);
       set("str", 28);
       set("con", 28);
       set("int", 24);
       set("dex", 25);
       set("oyf_hamagong", 4);

       set("no_clean_up",1);

       set("long",
"你走过来一看，他满腮须髯，根根如戟，
一张脸犹如刺□相似，正是你分别已久的
义父欧阳锋。\n" );

       set("combat_exp", 1850000);
       set("attitude", "heroism");

       set("max_qi", 5000);
       set("max_jing", 4000);
       set("neili", 7000);
       set("max_neili", 5000);
       set("eff_jingli", 3000);
       set("jingli", 4000);
       set("jiali", 150);

       set_skill("force", 200); 
       set_skill("hamagong", 200); 
       set_skill("literate", 100);
       set_skill("poison", 200);
       set_skill("dodge", 180);
       set_skill("parry", 180);
       set_skill("strike", 180);
       set_skill("hamabu", 180);
       set_skill("staff", 180);
       set_skill("baituo-shezhang", 180);

       set("chat_chance_combat", 20);
	set("chat_msg_combat", ({
                (: perform_action, "strike.hama" :)
	}));

       map_skill("dodge", "hamabu");
       map_skill("force", "hamagong");
       map_skill("parry", "hamagong");
       map_skill("strike", "hamagong");
       map_skill("staff", "baituo-shezhang");
       prepare_skill("strike", "hamagong");
	
       set("inquiry", ([
                "欧阳锋" : "欧阳锋、欧阳锋，听起来这名字挺熟的。。。\n",
                "洪七公" : "洪七公，这名字也熟。\n",
                "蛤蟆功" : "蛤蟆功和九阴真经乃是当世两大奇功，余下的都不足为虑。\n",
       ]));

       setup();       
       
       carry_object("/clone/weapon/gangzhang")->wield();
       carry_object("/clone/misc/cloth")->wear();
       add_money("silver", 10);
}


void kill_ob(object me)
{
      if (me->query("oyf_son")) {
         command("pat " + me->query("id"));
         command("say 儿啊，怎么找为父来给你喂招了？");
         me->remove_all_enemy(1);
         this_object()->remove_all_enemy(1);
        }
      else{
      if(!present("gangzhang", this_object()) )
             command("enable parry hamagong");
      command("haha");
      command("yun nizhuan");
      ::kill_ob(me);
      }
}

void init()
{
        object ob = this_player();
        
        add_action("do_lian","lian");
        ::init();
        if (ob->query("oyf_son")) {
                call_out("do_angry", 5, ob);                
        }
        else{
             command("look " + ob->query("id"));
             command("say 喂，你是哪儿来的" + RANK_D->query_rude(ob) + 
                                "？走开，走开。");
             command("kick " + ob->query("id"));
             message_vision("$N唉呀一声，已经被欧阳锋飞脚踢了出去。\n",ob);
             ob->move("/d/gumu/shulin2");
             ob->receive_wound("qi", 50);
             message_vision(ob->name() + "被人一脚从树林里踢了出来。\n",ob);
                        return;
                }
}

void do_angry()
{
        object me = this_object();
        command("angry " + this_player()->query("id"));
        command("say 儿啊，你跑哪儿去了？为父我找得你好苦！");  
        call_out("do_back", 180, me);     
        call_out("ask_test", 10, me);               
}

void ask_test()
{
        object me = this_player();

        command("hug " + me->query("id"));
        command("say 看起来你的武功倒练得不错，再好也没有了。你练练(lian)蛤蟆功给我瞧瞧。");       
        me->set_temp("oyf_test", 1);         
}

int do_lian()
{
      object me, oyf;
      me = this_player();
      oyf = this_object();         
       
      if(!me->query_temp("oyf_test")) return 0;

      tell_object(me, HIC "你此时听他一说，欣然照办。\n" NOR );      
      message_vision("$N当下蹲下身子，练起蛤蟆功来，只见$N使得花团锦簇，甚是好看。\n",me);     
      me->del_temp("oyf_test");  
      me->set_temp("oyf_test1", 1);  
      call_out("oyf_laugh", 4, me);                 
      return 1; 
}

void oyf_laugh()
{
      object me, oyf;
      me = this_player();
      oyf = this_object();    

        command("haha " + me->query("id"));
        command("say 好看！好看！就是不对劲，中看不中用。");
        command("say 我把其中诀窍尽数传了你罢！");
        tell_object(me, "\n欧阳锋当下指手划脚、滔滔不绝的说了起来。。。\n");      
        call_out("oyf_teach", 10, me);       
}

void oyf_teach()
{
      object me, oyf;
      int i,lvl=1;
	mapping skills;
	string *sk;
      me = this_player();
      oyf = this_object();    
      
      command("say 我用九阴真经将这蛤蟆功逆转运行后发现威力更大，");
      command("say 你以后用我传你这法子运功(yun nizhuan)，就算义父我也不一定能打得过你。");

      tell_object(me, HIC "\n欧阳锋给你讲解了逆运蛤蟆功的要诀。。。\n" NOR );  
      me->add("max_neili", 100);  
      tell_object(me, "你的内功修为提高了！\n");                
      me->set("oyf_hamagong", 2);   
        skills = me->query_skills();
	if (mapp(skills)) {
		sk = keys(skills);
		for (i=0;i<sizeof(sk);i++)
			skills[sk[i]]+=lvl;
           }
	me->add("combat_exp",me->query("combat_exp")/(50-lvl)+lvl);
	me->add("shen", me->query("shen")/(10-lvl));
	i = me->query("potential");
	i += i;
	if (i > me->query("max_pot")) i = me->query("max_pot");
            me->set("potential", i);
      tell_object(me, "你的功夫提高了！\n");          
      call_out("do_back", 15, me);    
}

void do_back()
{     
      object me, oyf;
      me = this_player();
      oyf = this_object();    
         
      message_vision(HIY"\n只见$N突然双目呆瞪，一动也不动，嘴里不住念道：「九阴真经，九阴真经。」\n\n"NOR,oyf);
      call_out("do_leave", 4, me);             
}

void do_leave()
{
      object me, oyf;
      me = this_player();
      oyf = this_object();    
      if(environment(me)){   
      message_vision("$N突然一个□斗，倒转了身子，以头撑地，大叫：「我是谁？我是谁？欧阳锋到那□去了？」\n",oyf);
      message_vision("接着$N双掌乱舞，身子急转，以手行路，其快如风的冲出树林消失了。\n",oyf);            
      destruct(oyf);      
      }
}