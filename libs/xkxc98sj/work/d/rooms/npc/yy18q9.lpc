// yy18q.c 燕云十八骑

#include <ansi.h>
inherit NPC;
inherit F_UNIQUE;
#include "yy18q.h";

void create() {
  string weapon;
  set_name("侍卫", ({ "shi wei", "shi", "wei" }));
  set("title", HIY "燕云十八骑" NOR);
  set("nickname", BLU "魔" NOR);
  set("str", 40);
  set("con", 30);
  set("int", 25);
  set("dex", 30);
  set("unique", 2);
  set("location", 1);
  set("南院", 1);
  set("gender", "男性");
  set("age", 40);
  set("luohan_winner", 1);
  set("long", "
燕云十八骑个个是契丹族中顶尖儿的高手，每一人都能以一当十。
他们是南院大王萧峰的贴身卫士，萧峰重赴中原再上少林时就带着他们。
最近经常派出执行特殊任务。这名侍卫好象是师出明教。\n");
  set("combat_exp", 800000 + random(100000));
  set("shen", -100000);
  set("attitude", "heroism");
  set("max_qi", 2800);
  set("max_jing", 2000);
  set("max_jingli", 2500);
  set("eff_jingli", 2500);
  set("neili", 4000);
  set("max_neili", 4000);
  set("jiali", 50);
  set_skill("sword", 150);
  set_skill("dodge", 150);
  set_skill("force", 150);
  set_skill("blade", 150);
  set_skill("literate", 100);
  set_skill("piaoyi-shenfa", 150);
  set_skill("shenghuo-shengong", 150);
  set_skill("lieyan-dao", 150);
  set_skill("liehuo-jian", 150);
  set_skill("parry", 150);
  set_skill("yingzhua-shou", 150);
  set_skill("hand", 150);
  set_skill("strike", 150);
  set_skill("hanbing-mianzhang", 150);
  map_skill("force", "shenghuo-shengong");
  map_skill("dodge", "piaoyi-shenfa");
  map_skill("sword", "liehuo-jian");
  map_skill("parry", "liehuo-jian");
  map_skill("blade", "lieyan-dao");
  map_skill("strike", "hanbing-mianzhang");
  map_skill("hand", "yingzhua-shou");
  prepare_skill("hand", "yingzhua-shou");
  prepare_skill("strike", "hanbing-mianzhang");

  set("chat_chance", 50);
  set("chat_msg", ({ (: checking :) }));
  set("inquiry", ([
    "停": (: stop :),
    "stop": (: stop :),
    "跟": (: follow :),
    "follow": (: follow :),
    "leave": (: leave :),
    "离开": (: leave :),
    "name": (: ask_shi :),
  ]));
  weapon = random(2) ? BINGQI_D("gangjian") : BINGQI_D("blade1");
  setup();
  carry_object(ARMOR_D("armor"))->wear();
  carry_object(weapon)->wield();
  carry_object(__DIR__ "obj/jinpai");
}

int checking() {
  object master, ob, weapon;
  mixed *list;
  string force;
  int i;
  ob = this_object();
  list = users();
  i = sizeof(list);
  if ((string)ob->query("master")) {
    while (i--)
      if (list[i]->query("id") == ob->query("master")) master = list[i];
    if (!master) { dest(ob); return 0; }
    if (environment(ob) != environment(master) && living(ob)
      && !ob->is_busy() && ob->query_leader() == master) {
      message_vision("$N快步离开了。\n\n", ob);
      ob->move(environment(master));
      message_vision("$N快步走了过来。\n\n", ob);
    }
  }
  if (!ob->query("master")) return 1;
  force = master->query_skill_mapped("force");
  weapon = master->query_temp("weapon");
  if (environment(ob) == environment(master)) {
    if (!living(master)) command("get " + master->query("id"));
    if (file_size("/kungfu/skill/" + force + "/heal.lpc") <= 0 &&
      (int)master->query("eff_qi") < (int)master->query("max_qi") &&
      ob->query("neili") > 500 && !ob->is_fight() && !master->is_fight())
      command("yun lifeheal " + master->query("id"));
  }
  if (force = "shenghuo-shengong" && master->is_fighting()
    && master->query_skill("shenghuo-lingfa", 1) > 130
    && master->query_skill("shenghuo-shengong", 1) > 130
    && master->query_skill("force", 1) > 130
    && master->query("neili") > 500
    && master->query("max_neili") > 1200
    && master->query("jingli") > 300
    && master->query_skill_mapped("blade") == "shenghuo-lingfa"
    && (weapon->query("id") == "shenghuo ling" || weapon->query("id") == "tieyan ling")
    && !ob->query_temp("chuangong")
    && master->query_temp("yinfeng") <= 2
    && ob->query("neili") > 1000)
    command("yun chuangong " + master->query("id"));

  return 1;
}
