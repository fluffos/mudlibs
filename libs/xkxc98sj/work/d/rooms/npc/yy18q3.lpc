// yy18q.c 燕云十八骑

#include <ansi.h>
inherit NPC;
inherit F_UNIQUE;
#include "yy18q.h";

void create()
{
       set_name("侍卫", ({ "shi wei", "shi", "wei" }));
       set("title", HIY "燕云十八骑" NOR);
       set("nickname", HIY"乞"NOR);
       set("str", 40);
       set("con", 30);
       set("int", 25);
       set("dex", 30);
       set("unique", 2);
       set("location", 1);
       set("南院", 1);
       set("gender", "男性");
       set("age", 40);
       set("luohan_winner", 1);
       set("long","
燕云十八骑个个是契丹族中顶尖儿的高手，每一人都能以一当十。
他们是南院大王萧峰的贴身卫士，萧峰重赴中原再上少林时就带着他们。
最近经常派出执行特殊任务。这名侍卫好象是师出丐帮。\n");
       set("combat_exp", 800000 + random(100000));
       set("shen", 0); 
       set("attitude", "heroism");      
       set("max_qi", 2800);
	set("max_jing", 2000);
        set("max_jingli", 2500);
        set("eff_jingli", 2500);
	set("neili", 4000);
	set("max_neili", 4000);
	set("jiali", 50);
        set_skill("force", 150);             // 基本内功
        set_skill("huntian-qigong", 150);    // 混天气功
        set_skill("strike", 150);            // 基本掌法
        set_skill("xianglong-zhang", 150);   // 降龙十八掌
        set_skill("dodge", 150);             // 基本躲闪
        set_skill("xiaoyaoyou", 150);        // 逍遥游
        set_skill("parry", 150);             // 基本招架
        set_skill("stick", 150);             // 基本棍杖
        set_skill("dagou-bang", 150);        // 打狗棒法
        set_skill("begging", 100);           // 叫化绝活
        set_skill("checking", 100);          // 道听途说
        set_skill("bangjue", 150); 
        set_skill("fengmo-zhang", 150);
        set_skill("staff", 150);
        set_skill("liuhe-daofa", 150);
        set_skill("blade", 150);
        map_skill("force", "huntian-qigong");
        map_skill("strike", "xianglong-zhang");
        map_skill("dodge", "xiaoyaoyou");
        map_skill("parry", "xianglong-zhang");
        map_skill("staff", "fengmo-zhang");
        map_skill("blade", "liuhe-daofa");
        map_skill("stick", "dagou-bang");
        prepare_skill("strike", "xianglong-zhang");
       set("chat_chance", 50);
       set("chat_msg", ({(: checking :)}));
       set("inquiry", ([
                "停" : (: stop :),
                "stop" :  (: stop :),
                "跟" :  (: follow :),
                "follow" :  (: follow :),
                "leave" :  (: leave :),
                "离开" :  (: leave :),
                "name" :  (: ask_shi :),
       ]));
       set("chat_chance_combat", 20);
       set("chat_msg_combat", ({
                (: perform_action, "stick.chan" :),
                (: perform_action, "strike.paiyun" :),
                (: exert_function, "powerup" :),
                (: perform_action, "strike.xiao" :),
	}));
       setup();
       carry_object(ARMOR_D("armor"))->wear();
       carry_object(BINGQI_D("zhubang"))->wield();
       carry_object("/d/rooms/npc/obj/jinpai");
}

int checking()
{
    object master, ob;
    mixed *list;
    int i;
    ob = this_object();    
    list = users();
    i = sizeof(list);
    if((string)ob->query("master")){
       while(i--) 
              if(list[i]->query("id")==ob->query("master")) master = list[i];
       if(!master) {dest(ob); return 0;}
       if(environment(ob) != environment(master) && living(ob) 
          && !ob->is_busy() && ob->query_leader()==master){
              message_vision("$N快步离开了。\n\n", ob); 
              ob->move(environment(master));
              message_vision("$N快步走了过来。\n\n", ob); 
              }
       }  
    if(!ob->query("master")) return 1;
    if(environment(ob) == environment(master) && !living(master)) 
                  command("get "+master->query("id"));
    return 1;
}
