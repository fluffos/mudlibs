// 针
#include <ansi.h>
inherit ITEM;
#include "/kungfu/skill/eff_msg.h";
void create()
{
	set_name(HIW "冰魄银针" NOR, ({ "bingbo yinzhen", "zhen", "needle", "yinzhen" }));
	set_weight(1000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "枚");
		set("long", "一枚纯银的细针，针身镂刻花纹，打造得极是精致。\n");
		set("value", 20000);
		set("material", "steel");                
	}
	setup();
}

int init()
{
   add_action("do_throw", "throw");
}

int do_throw(string arg)
{
       object me, ob;
       int i, damage, p;
       string msg;

       if (!arg) return notify_fail("你要对谁下手？\n");       
       me = this_player();
       ob = present(arg, environment(me));
       if (!ob) return notify_fail("找不到这个生物。\n");
       i = ob->query_skill("dodge", 1) + ob->query_skill("parry", 1);
       i = random(i/2) - 10;
       damage = me->query_skill("throwing", 1)+me->query_str()*2;
       if( environment(me)->query("no_fight") )
                return notify_fail("你不能在这里动手。\n");
       if(me->is_busy())
                return notify_fail("你正忙着呢。\n");
       if(me->query("neili") < 500)
                return notify_fail("你的内力不够用来动手。\n");
       msg = HIW"\n$N袖袍一挥，一枚冰魄银针自袖底飞出直向$n急射而去！\n"NOR;       
       me->start_busy(2);
       me->add("neili", -100);
       me->add("jingli", -20);
       if(me->query_skill("throwing", 1) > i && random(ob->query("kar")) < 10 &&
          me->query("combat_exp") > (int)ob->query("combat_exp")/2 ) {
          msg += HIR"$n猛见银光一闪，急忙著地滚开，但听一声惨叫，结果仍是被银针刺中！\n"NOR;
          ob->apply_condition("bing_poison", 70);
          ob->receive_wound("jing", damage/2);
          ob->receive_damage("qi", damage+random(damage));
          ob->receive_wound("qi", damage); 
          p = (int)ob->query("qi")*100/(int)ob->query("max_qi");
          msg += "( $n"+eff_status_msg(p)+" )\n";
          ob->set_temp("last_damage_from", "被"+me->name()+"杀");
          }
       else {
          msg +=HIY"银针来得虽快，$n飞身後跃之势却是更快，只听嗤一声轻响，银针射$p身前的泥土之中。\n"NOR;
          ob->add("jingli", -10);
          }              
       message_vision(msg, me, ob);
       if(!ob->is_killing(me->query("id"))) ob->kill_ob(me);
       destruct(this_object());
       return 1;
}
