// hhd.c

#include <ansi.h>

inherit ITEM;
void init() {
  add_action("do_eat", "eat");
  add_action("do_eat", "fu");
}
void create() {
  set_name(HIG "人参果" NOR, ({ "renshen guo", "guo" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "好东西，看起来象一个白白胖胖的小男孩。\n");
    set("value", 5000000);
    set("unit", "枚");
    set("no_get", 1);
    set("no_drop", 1);
  }
}

int do_eat(string arg) {
  object me = this_player();
  if (!living(me)) return 0;
  if (!id(arg)) return 0;
  message_vision(
    HIG "$N吃下一枚" + this_object()->query("name") + HIG "，顿时觉得精力旺盛，甚至不再感到干渴饥饿。\n" NOR,
    me
  );
  me->reincarnate();
  destruct(this_object());
  return 1;
}
