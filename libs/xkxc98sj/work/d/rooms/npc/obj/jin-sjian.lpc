inherit ITEM;
#include "/inherit/item/embed.h"

void create()
{
	set_name(HIY "金甩箭" NOR, ({ "jin shuaijian", "shuaijian", "jian" }));
        set_weight(500);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "支");
		set("long", HIY "御赐金箭，是大辽皇帝的传令牌。\n" NOR);
		set("base_value", 50000);
                set("embed", 1);
                set("damage", 12);	
	}
        setup();
}
