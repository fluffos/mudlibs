// shan.c 落香扇

#include <weapon.h>
#include <ansi.h>

inherit DAGGER;

void create()
{
	set_name(CYN "落香扇" NOR, ({ "luoxiang shan", "luoxiang", "shan" }));
	set_weight(100);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("long", "这是把雕花的香扇，轻盈飘零，是女儿家的物品。\n");
		set("value", 1000);
                set("rigidity", 1);
		set("material", "wood");
		set("wield_msg", HIW "$N展开扇子，轻轻地扇了扇。\n" NOR);
		set("unwield_msg", HIW "$N刷的一声合上扇子，放回袖中。\n" NOR);
	}
	init_dagger(35);
	setup();
}