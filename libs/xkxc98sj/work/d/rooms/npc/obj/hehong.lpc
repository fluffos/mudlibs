#include <ansi.h>

inherit ITEM;

#define CONDITION_EAT me->add("neili", -1000)

void create()
{
   set_name(RED"鹤红丹"NOR, ({"hehong dan", "dan", "hehong"}));
   if (clonep())
      set_default_object(__FILE__);
   else {
      set("long", RED"\n这是一颗以丹顶鹤鹤顶之毒再加无数巨毒之物制成的宝丹。\n"NOR);
      set("unit", "颗");
      set("value", 100000);
      set("condition", 10);
      set("healup", ([
	"add_neili": 2000,
	"add_jingli": 2000,	
	]));
      set("drug_msg", ([
	"start_eat" : "$N张嘴服下一颗$n。\n",
	"condition_eat": HIY"你感觉腹内翻腾，一股股冷热之气透向全身！\n"NOR,	
        "finish_eat": RED "忽然一股巨疼涌上来，和你身中的怪蛇之毒相撞相碰，你开始感到全身冷热相煎，意识渐渐模糊了。。。\n" NOR,
	]));
   }
   setup();
}
