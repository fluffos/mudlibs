//room : /u/tansh/shifen.c

inherit ROOM;

int do_push();

void create()
{
    set("short","石坟");
    set("long",@LONG
一座石坟,坟前立着一块墓碑(bei).这里佳林葱茏,异卉烂漫.
LONG
	 );
     /* set("object",([
			__DIR__"npc/huangr.lpc" :     1,
	    ])); */       
	 set("no_clean_up",0);
	 set("item_desc",([
		"bei" : "
#################### 
##                ##
##       桃       ##
##       花       ##
##       岛       ##
##       女       ##
##       主       ##
##       冯       ##
##       氏       ##
##       埋       ##
##       香       ##
##       之       ##
##       冢       ##
##                ##
####################\n
"
	       ]));
	   setup();
	  // replace_program(ROOM);
}

void init()
{
  add_action("do_push","push");
}

int do_push(string arg)
{

        if( arg=="bei"
        ||  arg=="碑")
        {
                write("只见墓牌缓缓移开,露出一个石彻的地道来.\n");
                set("exits/down", __DIR__"didao");
		remove_call_out("close");
                call_out("close", 2, this_object());

                return 1;
        }
}

void close(object room)
{
        message("vision","石碑吱吱呀呀的合上了。\n", room);
        room->delete("exits/down");

}

