int accept_object(object who, object ob, object me) {

  if (!who->query("tdh_pass")) return 0;

  if (ob->query("id") != who->query_temp("tdh_wp_id")) return 0;

  if (!who->query_temp("tdh_wupin")) return 0;

  if (who->query_condition("tdh_task2") <= 0) {
    command("say 你来晚了，东西已经被会中其他兄弟找到了。");
    return 0;
  }
  command("say 好样的，这下会中的燃眉之急可解了，我会告诉香主你这次功劳的。");
  who->add("tdh_job", 1);
  who->clear_condition("tdh_task2");
  who->delete_temp("tdh_wupin");
  who->deltet_temp("tdh_fan");
  who->deltet_temp("tdh_wp_id");
  call_out("destroying", 1, ob);
  return 1;
}

void destroying(object obj) {
  destruct(obj);
  return;
}
