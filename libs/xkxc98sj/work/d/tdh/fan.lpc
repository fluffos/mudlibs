inherit NPC;

int ask_me();

void create() {
  set_name("樊纲", ({ "fan gang", "fan" }));
  set("long",
    "他就是天地会青木堂的樊纲。\n"
    "此人二十多岁年纪，身躯魁梧。多冷的天也敞着怀，露出黑森森的胸毛。\n");
  set("gender", "男性");
  set("age", 28);
  set("attitude", "peaceful");
  set("shen", 3000);
  set("str", 26);
  set("int", 30);
  set("con", 26);
  set("dex", 28);
  set("max_qi", 1000);
  set("max_jing", 1500);
  set("neili", 1500);
  set("max_neili", 1500);
  set("jiali", 50);
  set("combat_exp", 350000);


  set_skill("force", 120);
  set_skill("yijin-jing", 120);
  set_skill("dodge", 100);
  set_skill("tiyunzong", 100);
  set_skill("cuff", 130);
  set_skill("jingang-quan", 120);
  set_skill("parry", 100);
  set_skill("literate", 100);

  map_skill("force", "yijin-jing");
  map_skill("dodge", "tiyunzong");
  map_skill("cuff", "jingang-quan");
  map_skill("parry", "jingang-quan");
  prepare_skill("cuff", "jingang-quan");

  //        create_family("天地会", 青木堂, "帮众");
  set("inquiry", ([
    "任务": (: ask_me :),
  ]));

  setup();
  carry_object("/clone/armor/cloth")->wear();

}

