int ask_me() {
  object ob, me;
  mapping target;

  me = this_player();
  ob = this_object();

  if (me->query_condition("gb_mission") || me->query_condition("guanfu_task") || me->query_condition("xx_task")
    || me->query_condition("xx_task2") || me->query_condition("dali_songxin")) {
    command("say 你现在和江湖其他帮会纠葛不清，你怎麽能有时间为会中出力呢？");
    return 1;
  }
  if (me->query_condition("tdh_task1") || me->query_condition("thd_task3")) {
    command("say 你正在执行天地会青木堂的任务！");
    return 1;
  }
  if (me->query_condition("tdh_task_wait") < 0) {
    command("say 没有香主的命令，我不能交给你任务，天地会一向纪律严明。");
    return 1;
  }
  if (!me->query_temp("tdh_fan")) {
    command("say 没有香主的命令，我不能交给你任务，天地会一向纪律严明。");
    return 1;
  }
  if ((me->query_condition("tdh_task2")) > 0) {
    command("say 我不是告诉你去寻找「" + me->query_temp("tdh_wupin") + "」了吗？");
    return 1;
  }
  target = quest[random(sizeof(quest))];
  me->set_temp("tdh_wupin", target["wupin"]);
  me->apply_condition("tdh_task2", 30);
  me->set_temp("tdh_wp_id", target["wp_id"]);
  me->clear_condition("tdh_task_wait");
  command("say 会中兄弟一直在秘密筹备反清复明大业，目前急需「" + me->query_temp("tdh_wupin") + "」，你看是否能找到！");
  return 1;
}
