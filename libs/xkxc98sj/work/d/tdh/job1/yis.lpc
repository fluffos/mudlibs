#include <ansi.h>;
inherit NPC;
int ask_husong();
int ask_ok();
int ask_qiekou_1();
int ask_qiekou_2();
void create()
{
	set_name("义士", ({ "yi shi", "yi", "shi" }) );
	set("gender", "男性" );
	set("age", 22+random(20));
	set("long",
		"这位志在反清复明的义士。\n");
	set("combat_exp", 100000);
        set("shen", 900);
        set("str", 26);
        set("int", 30);
        set("con", 26);
        set("dex", 28);
        set("max_qi", 500);
        set("max_jing", 1000);
        set("neili", 2000);
        set("max_neili", 1000);
        set("jiali", 50);
        set("combat_exp", 900000);
        set("inquiry", ([
		"name" : "既然投身于反清复明，个人已经不算什麽了，名字更不重要了。",
                "护送" : (: ask_husong :),
                "到了" : (: ask_ok :),
                "门朝大海，三河合水万年流" : (: ask_qiekou_1 :),
                "青木堂" : (: ask_qiekou_2 :),
	]) );
	setup();

      carry_object("/clone/misc/cloth")->wear();
}

void init()
{	
	object ob;

	::init();
	if( interactive(ob = this_player()) && visible(ob) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
}

void greeting(object ob)
{
	if (!ob || !present(ob, environment())) return;
        if (!(int)ob->query_condition("guanfu_task")){
        message_vision("义士不太自然的向四周看了看。\n",ob);
        }
        else{
        command("look "+(string)ob->query("id"));
        command("say 地振高冈，一派溪山千古秀");
        }
          
}

int ask_husong()
{ 
       object ob,me;
       int exp, neili, d, qi;
       me = this_object();
       ob = this_player();
       exp = ob->query("combat_exp",1);
       neili = ob->query("max_neili",1);
       d = ob->query_skill("dodge",1);
       qi = ob->query("max_qi",1);
    
//       if (!(int)ob->query_condition("thdbh_task")) return 0;
//       if (!ob->query_temp("tdhbh_qiekou_ok)) return 0;
       command("nod "+(string)ob->query("id"));
       me->set_leader(ob);
       me->set("combat_exp",exp/3);
       me->set("max_neili",neili/4);
       me->set("max_qi",qi/2);
       me->set("neili",neili/4);
       me->set("dodge",d-40);
       ob->delete_temp("thdbh_qiekou_ok");
       return 1;
       
}
void unconcious()
{
        command("say 可惜我壮志为酬，却死在你这个朝廷走狗之手。。。。");
//        ::unconcious();
        ::die();
}
int ask_ok()
{    
       object ob;
       ob = this_player();
       if (!ob->query_condition("thdbh_task")) return 0;
       if (environment(ob)->query("short") != ob->query_temp("tdhbhc_tremini")){
       command("idle ");
       command("say 我们这是到哪了？难道你就想在这里撇下我不管了？");
        return 1;
       }
       ob->delete_temp("tdhbh_target"); // 义士
       ob->delete_temp("tdhbh_paths"); // u/dubei/tdh/jib1/npc/xiaoxiao
       ob->delete_temp("tdhbhs_rooms"); // d/city/bqp
       ob->delete_temp("tdhbhc_weishi"); // 扬州
       ob->delete_temp("tdhbhc_termini"); // 三清殿
       ob->delete_temp("tdhbha_termini"); // 武当
       ob->delete_temp("tdhbh_diming");
       ob->delete_temp("tdhbh_time"); 
       ob->clear_condition("tdhbh_task");
       ob->add("tdh_job",3);
      return 1;
}
