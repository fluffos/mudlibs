int ask_qiekou_1()
{
       object ob;
       ob = this_player();

//       (!(int)ob->query_condition("thdbh_task")) return 0;
//      if (arg != "门朝大海，三河合水万年流")  return 0;
      command("say 红花亭畔哪一堂");
      ob->set_temp("tdhbh_qiekou",1);
      return 1;
}
