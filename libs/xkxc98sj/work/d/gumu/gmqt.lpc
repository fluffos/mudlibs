#include <ansi.h>;
#include <room.h>;
inherit ROOM;

void create()
{
     set("short", "前厅");
     set("long", @LONG
这是入墓的第一间石室，四壁俱是坚硬的岩石，古墓内光线十分阴暗，寒
气更为逼人，和室外有天壤之别，让你瑟瑟发抖，正前方的石壁上刻着不
少文字(zi),乃拜师必读。左边通往领悟室，往右则是切磋室。
LONG        );
     set("exits", ([
         "left" : __DIR__"gmlw",
         "right" : __DIR__"gmqc",
         "east" : __DIR__"gmzt", 
         "out" : __DIR__"rukou",   
      ]));    
     set("item_desc", ([
         "zi" : HIR"\t\t\1.本派弟子不得乱杀无辜。-神者不得入门。\n"NOR
                HIR"     \t\t\2.拜师后不得轻易离开古墓。\n"NOR
                HIR"     \t\t\3.要修炼本门上乘心法，须夫妇同门。\n"NOR
                       ]));
     set("valid_startroom", 1);
        setup();
}
