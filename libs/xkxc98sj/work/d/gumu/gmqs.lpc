// Room: /u/xdd/gumu/gmqinroom.c
#include <ansi.h>;
inherit ROOM;

void create()
{
	  set("short", HIB"琴室"NOR);
	  set("long", @LONG
一张石桌(table)，一条石凳，桌上放着一把古琴(qin)，是小龙女休憩时
刻抚琴抒怀的地方。每每琴音袅袅，平淡清和，直引人心弛神往，与世无争。
LONG        );
	  set("exits", ([
			"west" : __DIR__"gmcc",         ]));
	  set("item_desc", ([
			"qin" : "这是一把年代极远的古琴, 琴风古朴, 暗蕴玄机. 琴上刻着
[ 至远 宁心 渡风 ] 六个字. \n",
			"table" : "桌上是一把古琴. \n",
		  ]));

	  setup();
}

void init()
{
	  add_action("do_play", "play");
	  add_action("do_tan", "tan");
//	  add_action("do_yanxi", "yanxi");
//	  add_action("do_nuo", "nuo");
}

int do_tan(string arg)
{
	  mapping fam;
	  object me = this_player();

	  if (arg == "qin")
{
	  if (!(fam = me->query("family")) || fam["family_name"] != "古墓派")
	  return notify_fail("你不是古墓传人，如何能领悟古墓武功？\n");

         if (me->query("jing")<30 || me->query("jingli") < 30)
	  return notify_fail("你精神恍忽, 先去歇息一会再来弹琴吧. \n");

	  message_vision("$N闭目调理一会气息, 心神宁静的抚琴而弹. \n", me);

	  if (me->query_skill("force", 1) < 60)
	  return notify_fail("你弹了半天, 琴声仿若鸦鸣, 你还是弹棉花去吧. \n");

	  if (me->query_skill("force", 1) > 100)
	  return notify_fail("你内功精湛, 弹琴已无益于你修行内力. \n");

	  message_vision("$N心随弦走, 融入琴境, 渐渐心气平和, 周身真气自然流动. \n", me);
	  write("想不到此琴一奏,居然有修习内功之效. \n");

	 
	  me->receive_damage("jingli", 10+random(15), me);
	  me->improve_skill("force", (int)(me->query_con()/3) +
							  (int)(me->query_skill("force", 1)/5) );
	  return 1;
}
	  write("你要弹什么? 弹棉花? \n");
	  return 1;
}

int do_nuo(string arg)
{
	 object me = this_player();
	 if (arg == "qin")
{
	 message_vision("$N轻轻地挪开了古琴. \n", me);
	 write("琴下的桌面上居然刻着一篇文字. \n");
	 me->set_temp("mark/qin", 2);
	 return 1;
}
	 return notify_fail("你要挪什么? \n");
}

int do_yanxi(string arg)
{
	 mapping fam;
	 object me = this_player();
	 if (arg == "table")
{
	 if (me->query_temp("mark/qin") == 2)
{
	 if (!(fam = me->query("family")) || fam["family_name"] != "古墓派")
	 return notify_fail("你不是古墓传人，如何能领悟古墓武功？\n");

	 if (me->query("gender") == "女性")
	 return notify_fail("我古墓传人，怎可去学全真剑法。\n");

	 if (me->query("qi") < 30 || me->query("jing") < 30)
	 return notify_fail("你的精神很差, 改先去休息一会. \n");

	 message_vision("$N开始研习桌上的剑法秘籍. \n", me);

	 if (me->query_skill("sword", 1) < 60)
	 return notify_fail("但你的击剑之术太过低劣,无法获得提高. \n");

	 if (me->query_skill("quanzhen-xinfa", 1) < 60)
	 return notify_fail("但全真剑法需要全真心法才可使神气合一,威力方盛. \n");

	 if (me->query_skill("quanzhen-jianfa", 1) > 100)
	 return notify_fail("你的全真剑法招数你已尽数学全, 要精进一番该多下功夫苦练才行. \n");

	 me->improve_skill("quanzhen-jianfa", (int)(me->query_int()/4) +
							 (int)(me->query_skill("literate", 1)/8) );
	 me->receive_damage("qi", 20+random(10), me);
	 me->receive_damage("jing", 20+random(10), me);
	 return 1;
}
	 return notify_fail("你对着桌上的古琴研习一番,发现它很值钱. \n");
}
	 return notify_fail("你要研习什么? \n");
}


