// Room: /u/xdd/gumu/rukou.c

#include <ansi.h> 
inherit ROOM;

void create()
{
     set("short", RED"古墓"NOR);

     set("long", @LONG
你顿了顿神，发现自己已身处深谷之中，雾气蒙蒙，寒意逼人。四
下是片不小的开阔地，一座一人高的白色球型圆冢孤立其中，墓后是阴
森森的松林古木，更平添十分凄清落寞的萧瑟之意。墓门仅齐肩高，往
内是古墓派所在。古墓传人历来不轻出江湖，但不少痴情男女仰慕杨龙
二人双剑合壁快意江湖的豪情，历尽千般磨难后终成眷属惊世恋情。不
远千里往来投拜。
LONG        );

     set("exits", ([
         "enter" : __DIR__"gmqt",
         "south" : __DIR__"xuanya",
         "north" : __DIR__"guoyuan",
         ]));
     setup();
	"/clone/board/gumu_b"->foo();
}

void init()
{  
     add_action("do_climb", "climb");
     add_action("do_pan", "pan");
}

int do_climb(string arg)
{
      object me = this_player();
      int exp;
      exp = me->query("combat_exp",1);

      if ((!arg) || (arg != "up")) return 0; 

if ((int)me->query("jingli") < 10)
  return notify_fail("你太累了，还是休息会吧。\n"); 
      if ((int)me->query("qi") < 30)
      return notify_fail("你爬的太辛苦了，还是休息会吧。\n"); 

      message_vision(GRN"$N略一提气，借助石壁上的山藤突石腾身往谷上爬去。\n", me);
      if (exp < 100000)

//      if (((int)me->query("dex") < 20)&&((int)me->query("str") < 15))
{
      message_vision(HIR"$N爬了一会，便手足乏力，只得翻身跃下，但是发现旁边有一棵树，似乎可以攀(pan)上去。\n"NOR, me);
    if (me->query_skill("dodge",1)<100)
      me->improve_skill("dodge", (int)(me->query_int()/2));
         me->receive_damage("qi", 20, me);
        me->start_busy(1);
       me->receive_damage("jingli", random(10), me);
      me->add("combat_exp", random(3));
      return 1;
}
      
     
      message_vision(GRN"$N身形上扬，转眼就到了石壁的尽头，纵身一跃，已到了深沟边沿。\n", me);
      me->move(__DIR__"shengou");
      message("vision",
              me->name() + "纵身从深沟跃了上来。\n",
              environment(me), ({me}) );

      return 1;
}     
int do_pan(string arg)
{
      object me = this_player();
      int exp;
      exp = me->query("combat_exp",1);

       if ((!arg) || (arg != "shu")) return 0;

      if (exp >30000)
      return notify_fail("你身体太沉了，非把树枝压塔不可。\n"); 
      
      message_vision(GRN"$N用手抓住树干，三下两下就爬了上去。\n", me);
      me->move(__DIR__"shengou");
      message("vision",
              me->name() + "从深谷中爬了上来。\n",
              environment(me), ({me}) );

      return 1;
} 
