// sl1.c
inherit ROOM;

void create() {
  set("short", "黑林");
  set("long", @LONG
树林里参天古木，遮蔽了大部分日光，地上积了厚厚的落叶残木，加之
不少小动物的尸体，空气中透出腐臭和抑闷。你走着走着，便迷失了道路。
LONG
  );

  set("exits", ([
    "east": __FILE__,
    "west": __DIR__ "sl2",
    "south": __DIR__ "sl3",
    "north": __DIR__ "sl4",
  ]));
  setup();
}
void to_gumu(object ob) {
  write("由于你平常走惯了这里，所以信步就走出了黑林！\n");
  ob->move(__DIR__ "shulin2");
}

void init() {
  mapping fam;
  object ob = this_player();
  fam = (mapping)ob->query("family");

  if (mapp(fam) && fam["family_name"] == "古墓派") {
    call_out("to_gumu", 1, ob);
    ob->start_busy(1);
    return;
  }

}
int valid_leave(object me, string dir) {



  if (dir == "east")
    me->add_temp("mark/steps", 1);
  if (dir == "west")
    me->add_temp("mark/steps", -1);

  if (me->query_temp("mark/steps") == 6) {
    me->move(__DIR__ "shulin2");
    me->delete_temp("mark/steps");
    return notify_fail("你精疲力尽，终於走出了黑林。\n");
  }

  if (me->query_temp("mark/steps") == -6) {
    me->move(__DIR__ "shulin1");
    me->delete_temp("mark/steps");
    return notify_fail("你累得半死，却仍是回到原地。\n");
  }

  return ::valid_leave(me, dir);
}
