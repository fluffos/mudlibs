// Room: /u/xdd/gumu/shengou.c

#include <ansi.h>

inherit ROOM;

void create()
{
     set("short", BLU "深沟"NOR);

     set("long", @LONG
穿过树林，眼前出现一道深沟(gou)，不知是深谷还是山溪的所在，
此外已无去路。
LONG        );

     set("exits", ([
            "west" : __DIR__"shulin2",
	]));    

     set("item_desc", ([
         "gou" : "深沟里烟雾弥漫，隐约中寒气凛人，间或似乎
传来飘渺人声，真是世外高人超然凡尘的好所在，你悠然神往，不自禁
产生一种跃身而下的冲动。\n",
          ]));

        set("no_clean_up", 0);
        set("outdoors", "gumu");

        setup();
}
   
void init()
{
        add_action("do_yue", "yue");
}

int do_yue(string arg)
{ 
        mapping fam;
        object me = this_player();
        int dex = me->query("dex");
  
     if ( !living(me) ) return 0;
    
     if (!(fam = this_player()->query("family")) || fam["family_name"] != "古墓派")
     { 
        if(arg !="gou" ) return 0;
        me->add_temp("mark/jump",1);
   
        if ((int)me->query("per") < 20)
        return notify_fail("你天生容貌欠佳, 恐怕今生难圆双剑合壁之美梦。\n");

        if ((int)me->query("kar") < 18)
        return notify_fail("你福缘不够，还是别多尝试，以免性命之忧。\n");

        if ((int)me->query("int") < 25)
        return notify_fail("你悟性欠佳, 恐怕今生难圆双剑合壁之美梦。\n");

//      if (me->query_skill("literate", 1) < 30)
//      return notify_fail("你的读书写字太低，入古墓无法领悟。\n");        
        
	if (me->query("dex") < 20 || me->query("str") < 15)
	return 0;

	if ((int)me->query_temp("mark/jump") >= 3)
{       me->delete_temp("mark/jump");
        message_vision("$N纵身往悬崖下跳去，摔得血肉模糊。\n", me);
        me->set_temp("last_damage_from", "摔");
        me->move(__DIR__"rukou");
        me->die();
        return 1;
}
        message("vision",
               me->name() + "纵身跳下深谷。\n",
               environment(me), ({me}) );
        write("你一闭眼, 纵身跳下深谷。\n");
        me->move(__DIR__"rukou");

        if ( dex < 20 )
{
        message("vision", 
               me->name() + "叫声未停，已啪地一声落在一个草堆上，\n" "饶是如此, " + me->name() + "仍是伤了几处。半天爬不起来。\n",
               environment(me), ({me}) );
        
	write("你啪地一声落在一个草堆上，半天爬不起来。\n");
        me->receive_damage("qi", 50);
        me->receive_wound("qi", 40);
}
        else
{
        message("vision",
               me->name() + "处惊不乱，微一提气，凭空纵高丈余，\n" "衣诀飘飘，身姿潇洒地着落在山谷中。\n",
               environment(me), ({me}) );
        write("你身姿潇洒地着落在山谷中。\n");
}
          
       return 1;
}
       message_vision("$N纵身跳下深沟，拿捏恰到好处，正好落在古墓入口前。\n", me);
       me->move(__DIR__"rukou");
       return 1;
}    





