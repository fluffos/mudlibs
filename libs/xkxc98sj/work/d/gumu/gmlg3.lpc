// Room: /u/xdd/gumu/gmlg3.c
#include <ansi.h>;
#include <room.h>;

inherit ROOM;
void create()
{
     set("short", "练功房");
     set("long", @LONG
入内又是一室，却和外间处处对称，而又处处相反，乃是后窄前宽，西圆
东角。室顶亦是刻满无数符号图形，几位古墓传人正面壁而坐。你才入此室，
身后石门已无声无息关闭，门上刻着几行字。
LONG
        );

     set("item_desc", ([
         "westwall" : "古墓剑法精髓。\n",
         "eastwall" : "古墓外功。\n",
         "frontwall" : "古墓掌法。\n",
         "backwall" : "古墓拳法。\n",
         "up" : "全真武技位震武林。\n",    
         "gate" : HIB"面壁而思，武技精进，古墓全真，威震武林。\n"NOR
                  HIR" 神 雕 侠 侣 \n"NOR
        ]));

        setup();
   }

void init()
{
     add_action("do_mianbi", "mianbi");
     add_action("do_pull", "pull");
     add_action("do_push", "push");
}

int do_mianbi(string arg)
{
	  object me = this_player();
	  mapping fam;

	  if (!(fam = me->query("family")) || fam["family_name"] != "古墓派")
	  return notify_fail("你不是古墓传人，如何能领悟古墓武功？\n");

	  if (me->query_skill("yunu-xinjing", 1) < 60)
	  return notify_fail("你对古墓内功心法的修习不够, 无法在此领悟. \n");

	  if (me->query("qi") <40  || me->query("jing") < 40 || me->query("jingli") < 40)
	  return notify_fail("你的精力太差,歇息一会再来吧. \n");

	  if ( arg == "frontwall")
{
	  if (me->query_skill("strike", 1) < 60)
	  return notify_fail("你对掌法的修炼如此之差,如何能懂的高深的武技. \n");

	  if (me->query_skill("strike", 1) > 100)
	  return notify_fail("你的掌法已入正流,无需在此领悟了. \n");

	  message_vision("$N面对前方而坐,开始修习上层掌法. 悟出不少东西\n", me);
	  me->improve_skill("strike", (int)(me->query_str()/2) +
							  (int)(me->query_skill("strike", 1)/5));
	  me->receive_damage("jingli", 15 + random(20));
          me->receive_damage("jing", 5 + random(10));
	 
	  return 1;
}

	  if ( arg == "backwall")
{
	  if (me->query_skill("cuff", 1) < 60)
	  return notify_fail("你拳法未入正流,如何修习上层武功. \n");

	  if (me->quert_skill("cuff", 1) > 100)
	  return notify_fail("你的拳法已已入正流, 此处已不足再进武技. \n");

	  message_vision("$N面壁而坐,开始修习上层拳法,获益非浅. \n", me);
	  me->improve_skill("cuff", (int)(me->query_str()/2) +
							  (int)(me->query_skill("cuff", 1)/5));
	  me->receive_damage("jingli", 15 + random(20));

	  if (me->query_skill("cuff", 1) >= 30)
{
	  if (me->query_skill("meinu-quanfa", 1) > 0)
	  return 1;

	  write("你脑中灵光一现，领悟到古墓武学美女拳法。\n");
	  me->set_skill("meinu-quanfa", 3);
	  write(RED"恭喜阁下学会美女拳法. \n"NOR);
	  me->unconcious();
}
	  return 1;
}
/*
	  if (arg == "up")
{
	  if (me->query_skill("force", 1) < 58)
	  return notify_fail("你基本内功太差,无法修习全真上层武功. \n");
	  if (me->query_skill("quanzhen-xinfa", 1) > 79)
	  return notify_fail("石壁上所载全真内功仅止于此,你已全然领悟于心. \n");
	  message_vision("$N仰面研习全真武功,端的奇妙万方,不由喜不自禁. \n", me);
	  me->improve_skill("quanzhen-xinfa", (int)(me->query_int()/2));
	  me->receive_damage("qi", 10, me);
	  me->add("combat_exp", random(5));
	  return 1;
}
*/

	 if (arg == "westwall")
{
	 if (me->query_skill("sword", 1) < 60)
	 return notify_fail("你的剑法犹如井底之蛙,还是先去外间勤加练习吧. \n");

	 if (me->query_skill("sword", 1) > 100)
	 return notify_fail("你的剑法已如青锋出炉,石壁所述尽含心胸. \n");

	 message_vision("$N面西而坐,细读石壁的剑法秘诀, 闭目而思,有些许心得. \n", me);
	 me->receive_damage("jingli", 15 + random(20));
	 me->improve_skill("sword", (int)(me->query_int()/2) +
							 (int)(me->query_skill("sword", 1)/5) );

	 if (me->query_skill("sword", 1) >= 30)
{
	 if (me->query_skill("yunu-jianfa", 1) > 0)
	 return 1;

	 me->set_skill("yunu-jianfa", 3);
	 message_vision("$N突然灵光浮现,脑海中豁然开通, 领悟出古墓武学美女剑法。\n", me);
	 write(RED"恭喜阁下学会了玉女剑法. \n"NOR);
	 me->unconcious();}
	 return 1;
}

	 if (arg == "eastwall")
{
	 if (me->query_skill("parry", 1) < 60)
	 return notify_fail("你的招架太差,先去提高基本招数吧. \n");

	 if (me->query_skill("parry", 1) > 100)
	 return notify_fail("你的招架功夫已成然不俗,石壁所述对你太浅了. \n");

	 message_vision("$N面东而坐,研习古墓招架功夫,收益不浅. \n", me);
	 me->receive_damage("jingli", 15 + random(20));
	 me->improve_skill("parry", (int)(me->query_int()/2) +
							 (int)(me->query_skill("parry", 1)/5) );
	 return 1;
}

	 write("你又没犯什么错误,面壁干什么? \n");
	 return 1;
}

int do_pull(string arg)
{
	 object me = this_player();
	 if (arg == "gate")
{
	 message_vision("$N用力吸一口气，双手贴住石门，暗用内劲，往外拉门。\n", me);
	 if (me->query_temp("mark/push") == 2)
{
	 if (me->query("neili") < 200)
{
	 me->set("neili", 0);
	 message_vision("却怎么也打不开门。\n", me);
	 return 1;
}
	  me->add("neili", -200);
	  message_vision("门被$N大力拉开了，出现了向外的通道。\n", me);
	  set("exits/out", __DIR__"room");
	  remove_call_out("shut_gate");
	  call_out("shut_gate", 13);
	  me->delete_temp("mark/push");
	  return 1;
}
	 message_vision("门丝毫不动，根本是毫无声色，看来$N没有启动机关。\n", me);
	 if (me->query("neili") < 200)
{
	 me->set("neili", 0);
	 return 1;
}
	 me->add("neili", -200);
	 return 1;
}
	 write("你要拉哪里？\n");
	 return 1;
}

int do_push(string arg)
{
	object me = this_player();

	if (arg == "雕") {
	message_vision("$N用手指按下石门上的数字 2 ，石门后发出轰隆隆的响声。\n", me);

	if (me->query_temp("mark/b") == 2) {
		me->delete_temp("mark/b");
		return 1;
	}

	if (me->query_temp("mark/c") == 2) {
	me->delete_temp("mark/c");
	return 1;
	}

	if (me->query_temp("mark/d") == 2)
	{
		me->delete_temp("mark/d");
		return 1;
	}

	if (me->query_temp("mark/push") == 2)
	{
		me->delete_temp("mark/push");
		return 1;
	}

		me->set_temp("mark/b", 2);
		return 1;
}

	if (arg == "侠")
{
		 message_vision("$N用手指按下石门上的数字 3 ，石门后发出轰隆隆的响声。\n", me);
		 if (me->query_temp("mark/c") == 2)
		 me->delete_temp("mark/c");
		 if (me->query_temp("mark/d") == 2)
		 me->delete_temp("mark/d");
		 if (me->query_temp("mark/push") == 2)
		 me->delete_temp("mark/push");
		 if (me->query_temp("mark/b") == 2)
{      me->delete_temp("mark/b");
		 me->set_temp("mark/c", 2);
}
		  return 1;
}

	if (arg == "侣")
{
		message_vision("$N用手指按下石门上的数字 4 ，石门后发出轰隆隆的响声。\n", me);
		if (me->query_temp("mark/b") == 2)
		me->delete_temp("mark/b");
		if (me->query_temp("mark/d") == 2)
		me->delete_temp("mark/d");
		if (me->query_temp("mark/push") == 2)
		me->delete_temp("mark/push");
		if (me->query_temp("mark/c") == 2)
{
		me->delete_temp("mark/c");
		me->set_temp("mark/d", 2);
}
		return 1;
}

	if (arg == "神")
{
		message_vision("$N用手指按下石门上的数字 1 ，石门后发出轰隆隆的响声。\n", me);
		if (me->query_temp("mark/b") == 2)
		me->delete_temp("mark/b");
		if (me->query_temp("mark/c") == 2)
		me->delete_temp("mark/c");
		if (me->query_temp("mark/push") == 2)
		me->delete_temp("mark/push");
		if (me->query_temp("mark/d") == 2)
{
		me->delete_temp("mark/d");
		me->set_temp("mark/push", 2);
		message_vision("石门咯咯的响了几声，接着一切平寂了。\n", me);
}
		return 1;
}
		return notify_fail("你要推哪里？\n");
}

void shut_gate()
{
// object room;
		if ( !query("exits/out")) return;
		message("vision", "石门缓缓启动，自己又重新关起来。\n", this_object());
		delete("exits/out");
}
