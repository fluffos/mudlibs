// Room: /u/xdd/gumu/xuanya

#include <ansi.h>;
#include <room.h>;
inherit ROOM;

void create()
{
     set("short", BLU"悬崖"NOR);
     set("long", @LONG
此处已是绝路，光秃秃的石壁，下面则是云雾弥漫的万丈深崖，传闻
中有个古墓弟子因受不了古墓之清苦寡欲，从此处一跃而下，了却一
生，近悬崖(xuanya)边有棵摩天大树(tree)，枝叶极盛，如大伞一张
遮掩住方圆之地。
LONG        );

     set("exits", ([
         "north" : __DIR__"rukou",
     ]));    

     set("item_desc", ([
         "xuanya" : "悬崖下只是一片云雾缭绕。跳(tiao)下去恐是有去无回。\n",
         "tree" : "如此高大的巨树,树上鸟虫聚集,似乎也是藏珍匿宝的好所在. \n", 
        ]));
          setup();
}

void init()
{
    add_action("do_tiao", "tiao");
    add_action("do_climb", "climb");
}

int do_tiao(string arg)
{ 
     object me = this_player();

     if ( arg == "xuanya")
{    if (me->query_temp("mark/jump") < 2)
{
     write(" 人生苦短，且古墓神功绝世，你再考虑一下吧. \n");
     me->add_temp("mark/jump", 1);
     return 1;
}

     message_vision(BLU"$N纵身跳下悬崖，悲呼一声，兄弟姐妹们，来生再见，回声不绝于耳。\n", me);

     if( random(me->query_dex()) > 20 )
     {
       me->move(__DIR__"gmanhe1");
       return 1;
     }

     me->set_temp("last_damage_from", "跳崖自杀");
     me->move(__DIR__"gmanhe1");
     me->delete_temp("mark/jump");
     me->die();
     return 1;
}
     write("你要跳到哪里？\n");
     return 1;
}


int do_climb(string arg)
{
     object me = this_player();
     if (arg == "tree")
{    message_vision(BLU"$N腾身往大树上爬去，"NOR, me);
     if (me->query_skill("dodge", 1) < 30)
{    message_vision("结果从树上一个筋斗掉下来。\n", me);
     me->receive_damage("qi", 20, me);
     me->receive_wound("qi", 20, me);
     return 1;
}
    message_vision("很快消失在浓荫密叶中。\n", me);
    me->move(__DIR__"tree");
    return 1;
}
    write("你想往哪爬？\n");
    return 1;
}  
