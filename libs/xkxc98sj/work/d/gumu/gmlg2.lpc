// Room: /u/xdd/gumu/gmlg2.c 
// dubei amend 98/8
#include <ansi.h>
#include <room.h>

inherit ROOM;

void create() {
  set("short", BLU "练功房二" NOR);
  set("long", @LONG
一间石室，形状甚是奇特，前(frontwall)窄后(backwall)宽，成为梯形，
东(eastwall)边半圆，西(eastwall)边却作三角型。室顶(top)石板上刻满诸
般花纹符号，均是已利器刻成，或深或浅，殊无规则。此处供古墓弟子修炼入
门外功.
LONG
  );
  set("exits", ([
    "south": __DIR__ "gmzt",
    "enter": __DIR__ "room",
  ]));
  setup();
}

void init() {
  add_action("do_xiulian", "xiulian");
  add_action("do_yanxi", "yanxi");
}

int do_yanxi(string arg) {
  mapping fam;
  object me = this_player();

  if (!(fam = me->query("family")) || fam["family_name"] != "古墓派")
    return notify_fail("你不是古墓传人，如何能领悟古墓武功？\n");

  //	  if ((int)me->query_skill("dodge", 1) < 30)
  //	  return notify_fail("你轻功太差，无法研习古墓派玉女素心功。\n");

  //	  if ((int)me->query_skill("parry", 1) < 30)
  //	  return notify_fail("你招架太差，无法研习古墓派玉女素心功。\n");

  //	  if ((int)me->query_skill("cuff", 1) < 30)
  //	  return notify_fail("你拳法太差，无法研习古墓派玉女素心功。\n");

  if ((int)me->query_skill("literate", 1) < 20)
    return notify_fail("以你目前的文化(literate)程度，难以领悟上乘内功。\n");

  //	  if ((int)me->query_skill("sword", 1) < 30)
  //	  return notify_fail("你剑法太差，无法研习古墓派玉女素心功。\n");

  if ((int)me->query_skill("force", 1) < 15)
    return notify_fail("你基本内功太差，无法研习上层内功心法。\n");

  if (arg == "top") {
    if (me->query_skill("yunu-xinjing", 1) >= 30)
      return notify_fail("玉女素心功初层你已了然于胸，不妨寻找《玉女心经》卷二吧。\n");

    if (me->query("jing") < 30)
      return notify_fail("你委实太过劳累，无法凝神继续修炼。\n");

    //	  if (me->query("potential", 1) < 1)
    //	  return 0;

    message_vision("$N仰视室顶的图纹，慢慢地头顶冒出丝丝白雾，正自领悟上乘内功。\n", me);
    me->receive_damage("jing", 15);
    me->improve_skill("yunu-xinjing", (int)(me->query_int() / 2) +
      (int)(me->query_skill("literate", 1) / 5));
    //	  me->add("potential", -1);
    return 1;
  }
  return 0;
}

int do_xiulian(string arg) {
  mapping fam;
  object me = this_player();

  if (!(fam = me->query("family")) || fam["family_name"] != "古墓派")
    return notify_fail("你不是古墓传人，如何能领悟古墓武功？\n");
  if (me->query("qi") < 30)
    return notify_fail("你该去休息了,心急吃不了烫豆腐。\n");

  if (me->query("jing") < 30)
    return notify_fail("你精力不能集中,去稍作歇息吧. \n");

  if (arg == "frontwall") {
    message_vision("$N抡掌劈向前方窄窄的石壁，蓬一声被震退数步，手臂一阵酸麻。\n", me);

    if (me->query_skill("strike", 1) > 60)
      return notify_fail("你掌力雄浑，不该再死练蛮力了。\n");

    me->receive_damage("jing", 20);
    me->improve_skill("strike", (int)(me->query_int() / 3) +
      (int)(me->query_str() / 2));
    return 1;
  }

  if (arg == "backwall") {
    message_vision("$N挥拳直击弧型后壁，石粉四溅,你也被自己的猛劲震退数步。\n", me);

    if (me->query_skill("cuff", 1) > 60)
      return notify_fail("你拳力已刚猛无比，却无甚招数。\n");

    me->receive_damage("jing", 20);
    me->improve_skill("cuff", (int)(me->query_int() / 3) +
      (int)(me->query_str() / 2));
    return 1;
  }

  if (arg == "eastwall") {
    message_vision("$N绕东面石壁踏着剑步，用心揣摩壁上剑法精髓。\n", me);

    if (me->query_skill("sword", 1) > 60)
      return notify_fail("你对石壁上所述剑法已全然掌握,无须再费力了. \n");

    me->receive_damage("jing", 20);
    me->improve_skill("sword", (int)(me->query_int() / 3) +
      (int)(me->query_skill("sword", 1) / 5));
    return 1;
  }

  if (arg == "westwall") {
    message_vision("$N虚拈手指,对着西面的三角形石壁,细心操练暗器的收发手势. \n", me);

    if (me->query_skill("throwing", 1) > 60)
      return notify_fail("你暗器收发随心,再不能提高于此. \n");

    me->receive_damage("jing", 5 + random(20));
    me->improve_skill("throwing", (int)(me->query_int() / 3) +
      (int)(me->query_skill("throwing", 1) / 5));
    return 1;
  }
  return 0;
}
