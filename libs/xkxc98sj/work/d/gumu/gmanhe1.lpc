// Room: /u/xdd/gumu/gmanhe1.c

#include <ansi.h>;
inherit ROOM;

void create()
{
     set("short", HIR"暗河"NOR);
     set("long", @LONG
原来这正是一条地下暗河，此处水声已是轰轰，声势极为骇人。你
脚下一处踏空，便有水流直冲咽喉。此潜流不知来自何处，更不知通往
何方。
LONG        );
     set("exits", ([
//       "northup" : __DIR__"gmmdao3",
         "westdown" : __DIR__"gmql1",
         ]));
	setup();
}

void init()
{
     object me;

     me = this_player();
     me->receive_damage("qi", 200, me);
     me->receive_damage("jing", 100, me); 
     message_vision(BLU"$N的真气正在流失。\n"NOR, me);
     if (me->query("qi") <= 10)
     me->die();   
}
