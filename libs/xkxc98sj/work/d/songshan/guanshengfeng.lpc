// Room: /u/swl/songshan/guanshengfeng.c

inherit ROOM;
string look_sl();

string look_sl() {
  object me, room;
  me = this_player();
  if (!(room = find_object("/d/shaolin/guangchang1")))
    room = load_object("/d/shaolin/guangchang1");
  message_vision("$N站在峰上，回首向南面的少室山望去。\n", me);
  "/cmds/std/look.lpc"->look_room(this_player(), room);
  return "";
}

void create() {
  set("short", "观胜峰");
  set("long", @LONG
站在这里，凌于瀑布之上，景色又是一番不同，处在一片山从之中，
西北是绝顶，西面是嵩山的各个山峰，南面遥遥相望的便是地处少室山的
嵩山少林寺(shaolin)，身处山中而不见归路。
LONG);
  set("exits", ([
    "northdown": __DIR__ "shanlu3",
    "eastdown": __DIR__ "gsfxia",
  ]));
  set("item_desc", ([
    "shaolin": (: look_sl :),
  ]));
  set("outdoors", "嵩山");
  setup();
}
