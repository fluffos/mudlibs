// Room: workroom.c

inherit ROOM;
#include <ansi.h>

mapping poems = ([
  "同是天涯沦落人": "相逢何必曾相识",
  "别有幽愁暗恨生": "此时无声胜有声",
  "此情可待成追忆": "只是当时已惘然",
  "何当共剪西窗烛": "却话巴山夜雨时",
  "抽刀断水水更流": "举杯销愁愁更愁",
  "蓬莱文章建安骨": "中间小谢又清发",
  "人生得意须尽欢": "莫使金樽空对月",
  "天生我材必有用": "千金散尽还复来",
  "安能摧眉折腰事权贵": "使我不得开心颜",
  "无可奈何花落去": "似曾相识燕归来",
  "为伊消得人憔悴": "衣带渐宽终不悔",
  "青山遮不住": "毕竟东流去",
  "众里寻他千百度，那人却在": "灯火阑珊处",
  "廉颇老矣": "尚能饭否",
  "蛾儿雪柳黄金缕": "笑语盈盈暗香去",
  "千里孤坟": "无处话凄凉",
  "相顾无言": "惟有泪千行",
  "明月几时有": "把酒问青天",
  "但愿人长久": "千里共婵娟",
  "谁怕": "一蓑烟雨任平生",
  "一曲新词酒一杯": "去年天气旧亭台",
  "三十功名尘与土": "八千里路云和月",
  "路漫漫其修远兮": "吾将上下而求索",
  "莫愁前路无知己": "天下谁人不识君",
  "今宵酒醒何处": "杨柳岸晓风残月",
  "流水落花春去也": "天上人间",
  "小楼昨夜又东风": "故国不堪回首月明中",
  "问君能有几多愁": "恰似一江春水向东流",
  "春花秋月何时了": "往事知多少",
  "雕阑玉砌应犹在": "只是朱颜改",
  "梦里不知身是客": "一晌贪欢",
]);

string look_table();
void create() {
  string *poem, word;

  set("short", "阿飞的工作室");
  set("long", @LONG
这里就是本泥潭的天神——阿飞同志的工作室了，嘿嘿，怎么
阿飞又不在？一定是跑出去玩了。只见这里是一个不是十分宽敞但
相当安静朴素的小屋，房间里放着一张木制的方桌(table) ，阿飞
常常在桌上做作业或者写点小程序什么的。桌旁是一张非常舒服的
单人床，阿飞常常考在床上看书，看着看着就睡着了结果忘了作业
还没做完。
LONG
  );
  set("exits", ([
    "out": "/d/wizard/wizard_room",
  ]));
  set("no_clean_up", 0);

  set("sleep_room", 1);
  set("no_fight", 1);
  set("no_kill", 1);
  set("no_steal", 1);
  set("valid_startroom", 1);

  set("item_desc", ([
    "table": (: look_table :),
    "pan": "这是一支普通的自来水笔。",
  ]));

  poem = keys(poems);
  word = poem[random(sizeof(poem))];
  set("poem", word);

  setup();
}

string look_table() {
  string msg;

  msg = "这是阿飞用来工作学习的书桌，";
  msg += query("pan") == "table" ? "桌上放着\n一支自来水笔 " WHT "(pan)" NOR "，" : "桌上的自\n来水笔被人拿走了，";
  msg += "桌上还放着一瓶墨\n水。";
  msg += "桌上的一卷白纸上写着：\n\n" WHT;
  msg += query("poem");

  if (query("words")) msg += NOR "，" WHT + query("words");

  msg += NOR "\n\n不知道谁能回答" WHT "(write)" NOR "得上来。\n";
  return msg;
}

void init() {
  add_action("do_write", "write");
}

int do_write(string arg) {
  object me = this_player();
  int i = 1 + random(10);

  if (!arg) return notify_fail("你要写什么？\n");

  else {
    message_vision(CYN "只见$N定了定神，歪着头想了好半天，突然大叫一声：“对了！我\n想到了！”\n\n" NOR, me);

    if (query("words")) message_vision(CYN "$N换了一张纸。\n" NOR, me);

    message_vision(HIC "$N提起饱蘸了墨水的自来水笔，在纸上写下了“" + arg + "”\n这几个字，"
      + "写罢，满意的点点头，心道：“这总对了吧？”\n\n" NOR, me);
    set("words", arg);

    if (arg == poems[query("poem")]) {
      tell_object(me, HIW "只听远处传来一声长笑，原来是阿飞跑了过来，只见阿飞"
        + "热泪盈眶\n的紧紧握住你的手，连声道：“知音，知音呀！”\n" NOR);
      me->add("potential", i);
      tell_object(me, WHT "阿飞给你了" + chinese_number(i) + "点潜能值的奖励。\n" NOR);
      delete("words");
      this_object()->create();
    }

    return 1;
  }
}
