#pragma save_binary
// drunk.c

inherit F_CLEAN_UP;

int update_condition(object me, int duration)
{
	int limit;

	limit = (me->query("con") + (int)me->query("max_force") / 50) * 2;

	if( duration > limit
	&&	living(me) ) {
		me->unconcious();
		return 0;
	} else if( duration > limit/2 ) {
		tell_object(me, "你觉得极度兴奋，赶快找个地方解决一下吧！\n");
		message("vision", me->name() + "摇头晃脑地站都站不稳，显然是春药的药力发作了。\n",
			environment(me), me);
	}

	me->apply_condition("slumber_drug", duration - 1);
	if( !duration ) return 0;
        me->receive_damage("sen", 5);
	return 1;
}
