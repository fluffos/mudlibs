// murong-jianfa 慕容剑法
// by zzzz

#include <ansi.h>
inherit F_SSERVER;

int perform(object me, object target)
{
      object weapon;
      int i;
      weapon = me->query_temp("weapon");  
      

       if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("「满天花雨」攻击只能对战斗中的对手使用。\n");

       if (!weapon || weapon->query("skill_type") != "sowrd"
           || me->query_skill_mapped("sword") != "murong-jianfa")
           return notify_fail("你现在无法使出「满天花雨」绝技！\n");

       if (weapon->query("unique"))
           return notify_fail("你手中乃是一柄宝剑，你无法用内力震碎！\n");

        if(me->query_skill("murong-jianfa", 1) < 150 )
                return notify_fail("你的慕容剑法火候不够，使不出「满天花雨」绝技。\n");

        if(me->query_skill("sword", 1) < 150 )
                return notify_fail("你的基本功还不够娴熟，使不出「满天花雨」绝技。\n");

        if( (int)me->query_skill("shenyuan-gong", 1) < 150 )
                return notify_fail("你的神元功等级不够，使不出「满天花雨」绝技。\n");

        if( (int)me->query_str() < 34)
                return notify_fail("你的膂力还不够强劲，使不出「满天花雨」绝技。\n");

        if( (int)me->query_int() < 34)
                return notify_fail("你的悟性不够，无法悟出「满天花雨」绝技。\n");
 
        if ( me->query_skill_mapped("force") != "shenyuan-gong")
           return notify_fail("没有神元功作为根基，是无法使出「满天花雨」绝技的！\n"); 

       if(me->query_temp("xingyi")) 
           return notify_fail("你现在正在使用「斗转星移」绝技。\n"); 

       if (me->query_temp("lianhuan"))
           return notify_fail("你现在正在使用「七剑指连环」绝技。\n"); 

       if (me->query("max_neili") < 2000)
           return notify_fail("你的内力修为不够,无法使用「满天花雨」绝技。\n");
       if (me->query("neili") < 1000)
           return notify_fail("你的内力不够,无法震碎手中长剑。\n");
       if (me->query("jingli") < 200)
           return notify_fail("你的精力不够。\n");
        me->add("neili", -500);
//        me->add("jingli", -100);        
        message_vision(HIR"\n$N运尽全身内力，震碎手中的"+weapon->name()+HIR"，$N大吼一声，无数碎片激射向$n！\n"NOR,me,target);      

//fenwo's damage depends on how many times u pfmd       
        i = me->query("fenwo");
        if(i > me->query_skill("blade")) i = me->query_skill("blade");
        i -= me->query("age");
//and it will not be over ur enable blade skill

        me->add_temp("apply/damage", i);
        me->set_temp("fenwo_hit", 1);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
        weapon->add("fenwo", 1);
        if (weapon && weapon->query("fenwo") >= (3+weapon->query("rigidity"))) {
           message_vision(HIY"\n只听“咔咔”几声，$N手中的$n"HIY"在熊熊火焰中裂成了碎片！\n"NOR,me,weapon);
           weapon->unequip();
           weapon->move(environment(me));
           weapon->set("name", "碎裂的" + weapon->query("name"));
           weapon->set("value", 49);
           weapon->set("weapon_prop", 0);
           me->reset_action();
           }
        me->add_temp("apply/damage", -i);
        me->delete_temp("fenwo_hit");
        me->start_busy(2+random(2));
        return 1;
}

