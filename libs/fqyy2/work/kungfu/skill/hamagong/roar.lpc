//群魔乱舞
#include <ansi.h>
inherit F_SSERVER;

int exert(object me, object target) {

  object *ob;
  int i;
  string msg;
  int damage, ap, dp;
  mapping myfam;
  myfam = (mapping)me->query("family");
  if ((int)me->query_skill("hamagong", 1) < 120)
    return notify_fail("你的蛤蟆功修为还不够。\n");

  if (!myfam || myfam["family_name"] != "白驼山派" || myfam["master_id"] != "ouyang feng")
    return notify_fail("只有欧阳峰的弟子才能使群魔乱舞。\n");

  if (me->query("shen") > -10000)
    return notify_fail("这种邪恶武功不是侠义道当练的。\n");
  if ((int)me->query("neili") < 500)
    return notify_fail("你的内力不够！\n");

  if ((int)target->query_skill("sun-finger", 1) > 100) {
    me->set("qi", target->query_skill("sun-finger", 1) * 3);
    me->set("eff_qi", me->query("eff_qi") * 7 / 10);
    return notify_fail(HIR "糟糕！对方会使一阳指，你还是快跑为妙！\n" NOR);
  }
  /*
        if( !target )
                  return notify_fail("你要对谁使用群魔乱舞?\n");
*/
  if (target == me) {
    if (environment(me)->query("no_fight"))
      return notify_fail("此处不宜做这等惊世之事! \n");
    msg = HIR "$N蹲下身,运起蛤蟆神功,吐气扬眉,阁阁阁三声叫喊.一股迅猛的罡气涌起,
掀起无数狂沙,向四周扩散开去!\n\n" NOR;
    message_vision(msg, me);
    me->add("neili", -350);
    ob = all_inventory(environment(me));
    ap = (int)me->query("combat_exp") + (int)me->query_skill("force") * 1000;
    for (i = 0; i < sizeof(ob); i++) {
      dp = (int)ob[i]->query("combat_exp") + (int)ob[i]->query_skill("force") * 1000;
      if (!living(ob[i]) || ob[i] == me) continue;
      if (!ob[i]->is_killing(me)) ob[i]->fight_ob(me);
      if (!me->is_killing(ob[i])) me->fight_ob(ob[i]);
      tell_object(ob[i], HIR "忽然眼前黑影狂舞，你觉得眼前一阵阴气直袭面门，全身骤然感到要被撕裂开一样！\n" NOR);
      if (ap > dp) {
        ob[i]->unconcious();
      }
      if (ap < dp) {
        ob[i]->set("qi", ((int)target->query("qi") / 2));
        ob[i]->set("neili", ((int)target->query("neili") / 2));
        me->start_busy(random(4));
      }
    }
    return 1;
  }
  if (target != me) {
    msg = HIR "$N的目光突然变得血红,然后慢慢蹲下,口中阁阁阁叫了几声,但见一片黄沙狂舞,
仿若无数恶魔的狂笑!人影一闪,消失....一股迅猛的罡气向$n压去!$n
觉得眼前一阵阴气直袭面门，全身骤然感到要被撕裂开一样！\n\n" NOR;
    message_vision(msg, me, target);
    me->add("neili", -350);
    if (!target->is_fighting(me)) {
      if (living(target)) {
        if (userp(target)) target->fight_ob(me);
        else target->kill_ob(me);
      }
    }
    ap = (int)me->query("combat_exp");
    ap = ap + (int)me->query_skill("force") * 1000;
    dp = (int)target->query("combat_exp");
    dp = dp + (int)target->query_skill("force") * 1000;
    target->start_busy(2);
    if (ap > dp) {
      target->die();
    }
    if (ap < dp) {
      me->set_temp("hamagong/luanwu", 1);
      target->set_temp("block_msg/all", 1);
      call_out("luanwu_end", random(4), me, target);
      target->set("qi", ((int)target->query("qi") / 2));
      target->set("neili", ((int)target->query("neili") / 2));
      me->start_busy(random(4));
    }
    return 1;
  }
}

void luanwu_end(object me, object target) {
  target->enable_player();
  message_vision(WHT "$N身子突然一震,仿若一下从噩梦中惊醒过来\n", target);
  target->set_temp("block_msg/all", 0);
  me->delete_temp("hamagong/luanwu");

  return;
}
