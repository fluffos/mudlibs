// yingxiong-sanzhao.c 英雄三招
// 增加不同技能级别相应的学习和能使出的招数名, by ReyGod, in 12/17/1996
//      query_skill_name() and query_action()

inherit SKILL;

mapping *action = ({
  ([ "action": "$N左手反转，轻搔$n腋底‘极泉穴’,$n全身无力，被$N摔过头顶，一摔之际，同时被拿闭了肘后‘小海穴’和腋下‘极泉穴’，已然动弹不得",
    "force": 100,
    "dodge": 10,
    "skill_name": "子胥举鼎",
    "lvl": 0,
    "damage": 200,
    "damage_type": "内伤"
  ]),
  ([ "action": "$N突然间一个筋斗，向$n的胯下钻去，左手已抓住$n的脚踝，右手刺进$n的小腹",
    "force": 500,
    "dodge": 20,
    "skill_name": "鲁达拔脚",
    "lvl": 50,
    "damage": 300,
    "damage_type": "内伤"
  ]),
  ([ "action": "$N脊背后撞，十指向$n的胸口疾抓，$n急忙缩身避让， $N突然一个倒翻筋斗，身子跃起，双腿一分，已跨在$n的肩头，双拳猛击$n的太阳穴",
    "force": 400,
    "dodge": 30,
    "skill_name": "狄青降龙",
    "lvl": 200,
    "damage": 400,
    "damage_type": "内伤"
  ]),
});

int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }

int valid_combine(string combo) { return combo == "meiren-sanzhao"; }

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练英雄三招必须空手。\n");
  if ((int)me->query_skill("shenlong-xinfa", 1) < 200)
    return notify_fail("你的神龙心法火候不够，无法学英雄三招。\n");
  if ((int)me->query("max_neili") < 1000)
    return notify_fail("你的内力太弱，无法练英雄三招。\n");
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

/* ----------------
mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}
-------------------*/

mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("yingxiong-sanzhao", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[NewRandom(i, 5, level / 5)];

}

int practice_skill(object me) {
  if (me->query("family/master_id") != "hong antong") {
    message_vision("你不是洪教主的弟子，不能练习英雄三招!! \n", me);
    return 1;
  }
  if ((int)me->query("qi") < 100)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 100)
    return notify_fail("你的内力不够练英雄三招。\n");
  me->receive_damage("qi", 50);
  me->add("neili", -30);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "yingxiong-sanzhao/" + action;
}
