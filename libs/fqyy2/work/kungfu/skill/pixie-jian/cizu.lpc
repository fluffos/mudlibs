// cishou.c 辟邪剑法--刺足

#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target) {
  object weapon, weapon2;
  int damage;
  string msg;
  int iDuo;

  weapon2 = me->query_temp("weapon");

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("辟邪剑法[刺足]只有在战斗中施用。\n");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query_skill("pixie-jian", 1) < 80)
    return notify_fail("你的辟邪剑法不够娴熟，使不出[刺足]。\n");
  if ((int)me->query_skill("kuihua-xinfa", 1) < 80)
    return notify_fail("你的葵花心法不够娴熟，使不出[刺足]。\n");

  msg = HIY "$N使出辟邪剑[刺足]，连递数个招式向$n的手足缠绕。\n" NOR;

  me->start_busy(4);

  if (random(me->query("combat_exp")) > (int)target->query("combat_exp")) {

    msg += HIR "$n顿时觉得手足运作不灵，忽然足腕一麻，";
    msg += "低头一看";
    msg += "双足竟被刺了两个血窟窿！\n";
    msg += "\n" NOR;
    damage = (int)me->query_skill(
      "pixie-jian",
      1
    ) + (int)me->query_skill("kuihua-xinfa", 1) / 2 + (int)me->query_skill("sword", 1) / 2;
    target->receive_damage("qi", damage);
    target->start_busy(2);
  } else {
    msg += "可是$p看破了$P的企图，急忙往后一跃，没有上当。\n" NOR;
  }


  message_vision(msg, me, target);

  return 1;
}
