// cixin.c  辟邪剑法「刺心」
#include <ansi.h>
inherit F_SSERVER;
int perform(object me, object target) {
  int damage;
  string msg;
  object weapon;
  if ((string)me->query("gender") != "无性")
    return notify_fail(RED "你没有自宫,发挥不出辟邪剑的最大威力!\n" NOR);
  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("「刺心」只能对战斗中的对手使用。\n");
  if ((int)me->query_skill("pixie-jian", 1) < 80)
    return notify_fail(WHT "你辟邪剑法不够娴熟，使不出「刺心」。\n" NOR);
  if ((int)me->query_skill("kuihua-xinfa", 1) < 100)
    return notify_fail(WHT "你内功修为不够，使不出「刺心」。\n" NOR);
  if ((int)me->query("max_neili") < 400)
    return notify_fail(RED "你内力修为不足，无法运足内力。\n" NOR);
  if ((int)me->query("neili") < 200)
    return notify_fail(HIC "你现在内力不够，没能将「刺心」使完！\n" NOR);
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    msg = HIC "$N右手两指做拈花状，随手一挥，两指已然刺入$n心口!\n" NOR;
  else
    msg = HIC "$N右手两指做拈花状，随手一挥，长剑嗖的一声已然刺入$n心口!\n" NOR;
  if (random(me->query_skill("force")) > target->query_skill("force") / 2 ||
    random(me->query("combat_exp")) > (int)target->query("combat_exp") / 3) {
    me->start_busy(2);
    target->start_busy(random(3));
    damage = (int)me->query_skill(
      "pixie-jian",
      1
    ) + (int)me->query_skill("kuihua-xinfa", 1) + (int)me->query_skill("sword", 1) / 2;
    damage = damage + random(damage);
    target->receive_damage("qi", damage);
    target->receive_wound("qi", damage / 2);
    me->add("neili", -damage / 5);
    msg += HIR "$n疾忙后跳，却发现$N的剑气已经穿胸而过，在$n胸口留下一个血洞！\n" NOR;
  } else {
    me->start_busy(2);
    msg += HIY "可是$p轻轻一笑，果然$P的剑式突然中路急刺，从$p的身边划过，仅差半寸。\n" NOR;
  }
  message_combatd(msg, me, target);
  return 1;
}
