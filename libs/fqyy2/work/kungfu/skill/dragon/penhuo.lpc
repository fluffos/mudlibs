//喷火

#include <ansi.h>


inherit F_SSERVER;


int perform(object me, object target) {

  int skill;
  string msg;
  object weapon;

  if (!target) target = offensive_target(me);


  if (!target
    || !target->is_character()
    || !me->is_fighting(target))

    return notify_fail("喷火只能在战斗中使用。\n");


  message_combatd(
    HIR "$N深深吸了一口气，随即一声怒吼，一团火焰喷射而出！
 $n一下之陷入的一片火海之中！\n" NOR, me, target);

  target->add("qi", -1500);
  return 1;

}
