//吐雾

#include <ansi.h>


inherit F_SSERVER;


int perform(object me, object target)
{
	
  int skill;
	string msg;
	object weapon;
	
 if( !target ) target = offensive_target(me);

	
if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		
return notify_fail("吐雾只能在战斗中使用。\n");

  
    	message_combatd(
        HIW "只见$N口一张，一团重重的浓雾喷向$n,$n一下啥也看不清了,只得采取守式，不敢妄动！\n" NOR, me, target);
	
    target->start_busy(5);           
        return 1;
  
 }