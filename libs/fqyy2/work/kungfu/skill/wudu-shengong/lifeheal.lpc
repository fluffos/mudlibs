// heal.c

#include <ansi.h>

int exert(object me, object target) {
  if (me->is_fighting() || target->is_fighting())
    return notify_fail("战斗中无法运功疗伤！\n");

  if ((int)me->query_skill("wudu-shengong", 1) < 30)
    return notify_fail("你的五毒神功修为还不够。\n");
  if ((int)me->query("neili") < 50)
    return notify_fail("你的真气不够。\n");

  if ((int)me->query("eff_qi") < (int)me->query("max_qi") / 3)
    return notify_fail("你已经受伤过重，只怕一运真气便有生命危险！\n");

  if (!target)
    return notify_fail("你要用真气为谁疗伤？\n");
  /*
	message("vision",
		HIW + me->name() + "面颊现出一片潮红，额头上沁出细细的汗珠。\n" NOR,
		environment(me), me);
*/
  message_vision(HIY "$N坐了下来运起内功，将手掌贴在$n背心，缓缓地将五毒输入$n体内....\n\n"
    , me, target);
  target->set_temp("nopoison", 1);
  target->apply_condition("yf_poison", 0);
  // target->apply_condition("nx_poison",0);
  // target->apply_condition("x2_poison",0);
  target->apply_condition("xx_poison", 0);
  target->apply_condition("ice_poison", 0);
  target->apply_condition("ss_poison", 0);
  message_vision(HIW "$N轻轻呼出一口气，将真气收归丹田，$n感觉精神好多了。\n" NOR, me, target);
  me->receive_curing("qi", 10 + (int)me->query_skill("force") / 5);
  me->add("neili", -50);
  me->set("jiali", 0);
  return 1;
}
