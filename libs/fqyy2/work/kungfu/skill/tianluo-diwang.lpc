inherit SKILL

void create() { seteuid(getuid()); }

string type() { return knowledge; }

int valid_learn(object me) {
  int lvl


  if ((int)me->query(dex) < 20)
    return notify_fail(你 的 身 法 太 差 不 能 学 习 古 墓 派 的 武 功 。 \ n)

    if ((int)me->query(int) < 26)
      return notify_fail(你 的 悟 性 太 差 不 适 合 学 习 古 墓 派 的 武 功 。 \ n)

  return 1
}

int practice_skill(object me) {
  return notify_fail(天 罗 地 网 势 只 能 通 过 练 习 (lianxi) 来 增 加 熟 练 度 。 \ n)
}
