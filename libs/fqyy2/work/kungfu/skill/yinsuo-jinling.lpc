inherit SKILL

mapping *action = ({
  ([ action: 劲 贯 $w, 突 然 之 间, 丝 带 环 绕, 像 一 条 银 蛇 扑 向 $n,
    "force": 90,
    "dodge": 40,
    "damage": 40,
    "lvl": 0,
    "damage_type": "点穴"
  ]),
  ([ action: $N 手 上 的 $w 窜 出 ， 在 $n 手 腕 上 迅 速 无 比 的 一 点 ，,
    "force": 110,
    "dodge": 30,
    "damage": 50,
    "lvl": 10,
    "damage_type": "点穴"
  ]),
  ([ action: 蓦 地 里 $N 猱 身 而 上 ， $w 绕 到 $n 的 身 后 ， 疾 点 $n 的 $l,
    "force": 140,
    "dodge": 60,
    "damage": 70,
    "lvl": 20,
    "damage_type": "点穴"
  ]),
  ([ action: $N 突 然 间 招 法 一 变 ， $w 忽 伸 忽 缩 ， 招 式 诡 奇 绝 伦 。 $n 惊 骇 之 中 方 寸 大 乱,
    "force": 180,
    "dodge": 40,
    "damage": 100,
    "lvl": 30,
    "damage_type": "点穴"
  ]),
  ([ action: $N 身 形 飘 忽 ， 有 如 鬼 魅 ， 转 了 几 转 ， 忽 然 $w 点 向 $n 的 $l 穴 道,
    "force": 230,
    "dodge": 40,
    "damage": 140,
    "lvl": 60,
    "damage_type": "点穴"
  ]),
  ([ action: $N 一 声 冷 笑 ， 纵 身 后 跃, 手 中 $w 犹 如 鬼 魅 般 点 向 $n 的 $l,
    "force": 290,
    "dodge": 50,
    "damage": 190,
    "lvl": 75,
    "damage_type": "点穴"
  ]),
  ([ action: $N 绕 着 $n 转 了 几 个 圈, 跟 着 $w 反 手 送 出, 点 向 $n 的 $l,
    "force": 360,
    "dodge": 30,
    "damage": 250,
    "lvl": 90,
    "damage_type": "点穴"
  ]),
  ([ action: $n 只 觉 眼 前 一 花 ， 似 乎 见 到 $N 身 形 一 幌 ， 但 $N 却 似 从 未 离 开, 而 $w 已 到 了 $n 眼 前,
    "force": 440,
    "dodge": 80,
    "damage": 320,
    "lvl": 100,
    "damage_type": "点穴"
  ]),
  ([ action: $N 向 后 疾 退 ， $n 紧 追 两 步 ， 突 然 间 手 腕 一 抬 ， 手 中 $w 直 点 $n 的 $l,
    "force": 530,
    "dodge": 40,
    "damage": 400,
    "lvl": 120,
    "damage_type": "点穴"
  ]),
  ([ action: $n 想 要 冲 到 $N 面 前 ， $N 手 中 $w 直 点 $n 胸 口 檀 中 穴 ！ $n 慌 忙 招 架 ， 不 想 $N 的 $w 突 然 转 向 点 向 $l,
    "force": 630,
    "dodge": 4,
    "damage": 490,
    "lvl": 140,
    "damage_type": "点穴"
  ]),
  ([ action: $N 手 中 $w 飞 舞 ， $n 眼 前 仿 佛 突 然 出 现 了 七 八 条 $w 一 齐 点 向 $n,
    "force": 740,
    "dodge": 60,
    "damage": 590,
    "lvl": 150,
    "damage_type": "点穴"
  ]),
})


int valid_enable(string usage) {
  return usage == whip
}
int valid_learn(object me) {
  object weapon int t = 1, j if ((int)me->query(max_neili) < 500)
    return notify_fail(你 的 内 力 不 足 ， 没 有 办 法 练 银 索 金 铃, 多 练 些 内 力 再 来 吧 。 \ n)

    if ((int)me->query_skill(yunu - xinjing, 1) < 50)
      return notify_fail(你 的 玉 女 心 经 火 候 太 浅 。 \ n)

      if (!objectp(weapon = me->query_temp(weapon))
        || (string)weapon->query(skill_type) != whip)
        return notify_fail(你 必 须 招 一 条 软 兵 器 才 能 练 银 索 金 铃 。 \ n) if ((int)me->query_skill(
          tianluo - diwang,
          1
        ) < 50)
          return notify_fail(你 的 天 罗 地 网 势 还 不 够 纯 熟.不 能 练 银 索 金 铃.\ n)

  return 1
}


string query_skill_name(int level) {
  int i for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= actionilvl)
  return actioniskill_name
}
mapping query_action(object me, object weapon) {
  int i, level for (i = sizeof(action); i > 0; i--)
    if (level > action0lvl)
  return actionNewRandom
}
string perform_action_file(string action) {
  if (this_player()->query_skill(yinsuo - jinling, 1) >= 50)
  return __DIR__yinsuo - jinling / +action
}
