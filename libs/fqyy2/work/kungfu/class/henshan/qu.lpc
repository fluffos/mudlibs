// qu.c
inherit NPC;
inherit F_UNIQUE;

void greeting(object);
int ask_me();
void create()
{
	set_name("曲洋", ({ "qu yang", "qu"}) );
	set("gender", "男性" );
	set("age", 45);
	set("long", "他就是日月神教十大长老之一，琴技天下无双。\n" );
	set("attitude", "friendly");
	set("shen_type", 1);
       set("title","日月神教第二代长老");
        set("per", 20);
	set("str", 23);
	set("int", 23);
	set("con", 22);
	set("dex", 29);

	set("max_qi", 1000);
	set("max_jing",1000);
	set("neili", 300);
	set("max_neili", 300);
	set("combat_exp", 20000000);
	set("score", 30000);
  set("inquiry",([
   "笑傲江湖":(:ask_me:),
     ]));
	set("jiali",50);
	set_skill("force", 900);
	set_skill("dodge", 900);
	set_skill("unarmed", 900);
	set_skill("parry", 900);
	set_skill("hammer", 900);
	set_skill("blade", 900);
	set_skill("taiji-shengong", 900);
	set_skill("tiyunzong", 900);
	set_skill("taiji-dao", 900);
 
	map_skill("force", "taiji-shengong");
	map_skill("dodge", "tiyunzong");
	map_skill("parry", "taiji-dao");
	map_skill("blade", "taiji-dao");
	create_family("日月神教",2,"长老");

	setup();
	carry_object("/clone/weapon/gangdao")->wield();
	}
     
int ask_me()
   {
      object ob=this_player();
       if((string)ob->query("family/family_name")=="日月神教")
        {
         command("say 我在外面闲散惯了，这些事不清楚，你还是去找教中兄弟吧！");
         return 1;
         }
         if((string)ob->query("family/family_name")!="衡山派")
         {
          command("say 我在外面闲散惯了，这些事不清楚。\n");
          return 1;
          }
         if(ob->query("family/master_id")=="liu zhengfeng")
         { 
           command("say 看在刘兄的份上,我可以指点你几招《笑傲江湖》。\n");
           ob->set("marks/曲洋",1);
           return 1;
           }
          else return 0;
         }    

int recognize_apprentice(object ob, object who)
 {
   if(ob->query("marks/曲洋")==1)
   return 1;
   else return 0;
   }