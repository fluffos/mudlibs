inherit NPC;
#include <ansi.h>;
string clear_title(string arg);
void delete_title(object who);
void add_title(object me, string arg);
int do_bihua(string arg);
void do_titles(object obj, int rank);
int do_halt();

string *list, tmp;
void create() {
  set_name("金庸", ({ "jin yong" }));
  set("gender", "男性");
  set("age", 75);
  set("nickname", HIR "天下公平" NOR);
  set("title", HIY "武侠宗主" NOR);
  set("long",
    "这是一位显得略胖的教书匠风度的慈祥老者，早年笔耕不惰，如今早已功成名就。\n
             如果你有所有的神书。你可以用findbook给他.\n");
  set("age", 57);
  set("attitude", "friendly");
  set("shen_type", 1);
  set("str", 40);
  set("per", 50);
  set("int", 40);
  set("con", 40);
  set("dex", 40);
  set("max_qi", 4500);
  set("max_jing", 4500);
  set("neili", 4500);
  set("max_neili", 4500);
  set("jiali", 0);
  set("combat_exp", 30000000);
  set("score", 50000);
  set_skill("strike", 200);
  set_skill("finger", 200);
  set_skill("dodge", 200);
  set_skill("force", 200);
  set_skill("parry", 210);
  set_skill("sword", 200);
  set_skill("literate", 200);
  set_skill("blade", 200);


  create_family("金庸学会", 1, "元老");

  setup();

  carry_object("/clone/misc/cloth")->wear();
  carry_object("/d/city/obj/changjian")->wield();
}


void init() {
  ::init();
  add_action("do_bihua", "bihua");
  add_action("do_kill", "kill");
  add_action("do_kill", "hit");
  add_action("do_kill", "touxi");
  add_action("do_kill", "ansuan");
  add_action("do_fight", "perform");
  add_action("do_bihua", "bihua");
  add_action("do_kill", "fight");
  add_action("do_halt", "halt");
  add_action("do_halt", "h");
  add_action("do_findbook", "findbook");
}


int do_findbook(object ob) {
  object me = this_player();
  string name, new_name;
  int exp, pot, score;

  if (present(
    "ldji",
    me
  ) && present(
    "bmxxfeng",
    me
  ) && present(
    "sdyxz",
    me
  ) && present(
    "tlbb",
    me
  ) && present(
    "lcjue",
    me
  ) && present(
    "xsfh",
    me
  ) && present(
    "fhwz",
    me
  ) && present(
    "yyblade",
    me
  ) && present(
    "bxsword",
    me
  ) && present(
    "yttlj",
    me
  ) && present("xkx", me) && present("sdxl", me) && present("sjec", me) && present("xajh", me)) {
    destruct(present("ldji", me));
    destruct(present("bmxxfeng", me));
    destruct(present("xdxyz", me));
    destruct(present("tlbb", me));
    destruct(present("lcjue", me));
    destruct(present("xsfh", me));
    destruct(present("fhwz", me));
    destruct(present("yyblade", me));
    destruct(present("bxsword", me));
    destruct(present("yttlj", me));
    destruct(present("xkx", me));
    destruct(present("sdxl", me));
    destruct(present("sjec", me));
    destruct(present("xajh", me));
    command("say 好吧，既然你帮我找到了所有的神书，难为你" +
      "如此辛苦跑来，我不会亏待你的。");
    exp = 6000 + random(4000);
    pot = exp / 5;
    score = random(5000);
    me->add("combat_exp", exp);
    me->add("potential", pot);
    me->add("score", score);
    me->add("per", 1);
    me->add("str", 1);
    me->add("int", 1);
    me->add("con", 1);
    me->add("dex", 1);
    me->add("kar", 1);
    tell_object(me, "你被奖励了：\n" +
      chinese_number(exp) + "点实战经验\n" +
      chinese_number(pot) + "点潜能\n" +
      chinese_number(score) + "点综合评价\n");
    tell_object(me, HIR "你的先天臂力提高了!\n" NOR);
    tell_object(me, HIG "你的先天悟性提高了!\n" NOR);
    tell_object(me, HIY "你的先天根骨提高了!\n" NOR);
    tell_object(me, HIB "你的先天身法提高了!\n" NOR);
    tell_object(me, HIM "你的先天福缘提高了!\n" NOR);
    tell_object(me, HIC "你的先天容貌提高了!\n" NOR);
    command("chat* haha");
  } else
    command("say 你身上哪里有所有的神书!");
  return 1;
}

int do_fight(string arg) {
  if (arg == "cimu") return notify_fail("由于[刺目]会影响别人行动能力，这里不能使用。\n");
  return 0;
}
int do_bihua(string arg) {
  object ob1, ob2;
  object old_target;

  ob1 = this_player();

  if (!arg || arg == "") return 0;

  if (arg == "gongping zi" || arg == "zi" || arg == "referee") {
    command("say " + "你不能跟我比划！\n");
    return 1;
  }

  if (this_object()->query_temp("busy"))
    return notify_fail("每次只能有两人参加比武。\n");

  if (!ob2 = present(arg, environment(ob1)))
    return notify_fail("你想跟谁比划？\n");
  if (ob1 == ob2) return notify_fail("你不能攻击自己。\n");
  if (ob1->query("max_qi") > ob1->query("qi"))
    return notify_fail("你受伤太重不能比武。\n");
  if (ob1->query("max_qi") > ob1->query("eff_qi"))
    return notify_fail("你受伤太重不能比武。\n");
  if (ob2->query("max_qi") > ob2->query("qi"))
    return notify_fail("对方受伤太重不能比武。\n");
  if (ob2->query("max_qi") > ob2->query("eff_qi"))
    return notify_fail("对方受伤太重不能比武。\n");
  // 允许玩家自比
  command("say " + "比武要裁判发令才开始！\n");
  return 1;


  if (userp(ob2) && (object)ob2->query_temp("pending/fight") != ob1) {
    message_vision("\n$N对着$n说道"
      +RANK_D->query_self(ob1)
      +ob1->name() + "领教"
      +RANK_D->query_respect(ob2) + "的高招ⅵ\n\n", ob1, ob2);
    if (objectp(old_target = ob1->query_temp("pending/fight")))
      tell_object(old_target, YEL + ob1->name() + "取消了和你比试的念头。\n" NOR);
    ob1->set_temp("pending/fight", ob2);
    tell_object(
      ob2,
      YEL "如果你愿意和对方进行比试请你也对" + ob1->name() + "(" + (string)ob1->query("id") + ")" + "下一次 bihua 指令。\n" NOR
    );

    write(YEL "由於对方是由玩家控制的人物你必须等对方同意才能进行比试。\n" NOR);
    return 1;
  }

  ob1->delete_temp("halted");
  ob2->delete_temp("halted");

  remove_call_out("check");
  call_out("check", 0, ob1, ob2);

  //      ob1->set("qi",(int)ob1->query("max_qi"));
  //      ob2->set("qi",(int)ob2->query("max_qi"));

  remove_call_out("fighting");
  call_out("fighting", 2, ob1, ob2);

  return 1;

}

void fighting(object ob1, object ob2) {
  ob1->fight_ob(ob2);
  ob2->fight_ob(ob1);
}

void check(object ob1, object ob2) {
  this_object()->set_temp("busy", 1);


  message("channel:chat", HIC "【闲聊】金庸(Jin Yong)：" + ob1->query("name") + "(" + ob1->query("id") + ")"
    + "与" + ob2->query("name") + "(" + ob2->query("id") + ")" + "现在" + WHT "比武台" NOR + HIC "上开始比武论剑！\n" NOR, users());
  call_out("observe", 1, ob1, ob2);
}


int observe(object ob1, object ob2) {

  object ob;
  int i, j, k;


  int lost, win;
  if (ob1->is_fighting()) {
    call_out("observe", 1, ob1, ob2);
    return 1;
  }

  this_object()->delete_temp("busy");
  ob1->delete_temp("pending/fight");
  ob2->delete_temp("pending/fight");

  if (!present(ob1, environment())) {
    command("chat " + ob1->query("name") + "落荒而逃了！\n");
    return 1;
  }

  if (!present(ob2, environment())) {
    command("chat " + ob2->query("name") + "落荒而逃了！\n");
    return 1;
  }

  if (ob1->query_temp("halted")) {
    ob1->delete_temp("halted");
    command("chat " + ob1->query("name") +
      "中途放弃比武！\n");
    return 1;
  }
  if (ob2->query_temp("halted")) {
    ob2->delete_temp("halted");
    command("chat " + ob2->query("name") +
      "中途放弃比武！\n");
    return 1;
  }

  if (ob1->query("qi") * 2 > ob1->query("max_qi")) {
    if (ob2->query("qi") * 2 > ob2->query("max_qi")) {
      command("chat " + ob1->query("name")
        + "与" + ob2->query("name") + "比武不分胜负！\n");
      return 1;
    }
    command("chat " + ob1->query("name")
      + "比武战胜" + ob2->query("name") + "！\n");

    ob1->set_temp("marks/win", 1);
    call_out("log_positions", 1, ob1, ob2);
  } else {
    command("chat " + ob2->query("name")
      + "比武战胜" + ob1->query("name") + "！\n");

    ob2->set_temp("marks/win", 1);
    call_out("log_positions", 1, ob1, ob2);
  }
  return 1;

}

void log_positions(object ob1, object ob2) {
  string winname, lostname, winid, lostid;
  int i, win, lost;
  object obj;
  if (ob2->query_temp("marks/win")) {
    obj = ob2;
    winid = ob2->query("id");
    winname = ob2->query("name");
    lostid = ob1->query("id");
    lostname = ob1->query("name");
  }
  if (ob1->query_temp("marks/win")) {
    obj = ob1;
    winid = ob1->query("id");
    winname = ob1->query("name");
    lostid = ob2->query("id");
    lostname = ob2->query("name");
  }
  list = explode(read_file("/data/ladder.txt"), "\n");
  lost = member_array(lostid, list);
  win = member_array(winid, list);
  tmp = "";


  if (lost < win && lost != -1) {
    list[lost] = winid;
    list[lost + 1] = winname + "\n" + lostid + "\n" + lostname;

    for (i = 0; i < sizeof(list); i++)
      if ((i == win) || (i == win + 1)) tmp += "";

    else tmp += list[i] + "\n";
  } else if (lost == -1 && win == -1) {
    for (i = 0; i < sizeof(list); i++) tmp += list[i] + "\n";
    tmp += winid + "\n" + winname + "\n" + lostid + "\n" + lostname + "\n";

  } else if (lost != -1 && win == -1) {
    list[lost] = winid;
    list[lost + 1] = winname + "\n" + lostid + "\n" + lostname;

    for (i = 0; i < sizeof(list); i++)

      tmp += list[i] + "\n";

  } else {
    for (i = 0; i < sizeof(list); i++)

      tmp += list[i] + "\n";
  }

  rm("/data/ladder.txt");
  write_file("/data/ladder.txt", tmp);
  list = explode(read_file("/data/ladder.txt"), "\n");
  win = member_array(winid, list);
  message(
    "channel:chat",
    HIC "【闲聊】金庸(Jin Yong)：恭喜" + winname + "(" + winid + ")" + "荣获" + HIY "「侠客英雄谱」" NOR + HIC "第" + chinese_number((win + 1) / 2 + 1) + "名！\n" NOR,
    users()
  );
}

int do_halt() {
  object me = this_player();
  if (me->is_fighting())
    me->set_temp("halted", 1);
  return 0;
}

int do_kill(string arg) {
  write("你只能用bihua <id>进行比划，用halt放弃。\n");
  return 1;
}
