#pragma save_binary
 
// sledge_hammer.c

#include <weapon.h>

#include <ansi.h>
inherit HAMMER;

void create()
{
    set_name(HIY "大金槌" NOR, ({ "gold hammer", "hammer" }) );
	set_weight(40000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("value", 1600);
		set("material", "steel");
        set("long", "黄霸的大槌，要挥动这样的武器非得有过人的膂力不可。\n");
		set("weapon_prop/attack", -4);
		set("weapon_prop/defense", 5);
      set("task",1);
      set("owner","黄霸");
        set("no_put_in",1); 
	}
    init_hammer(45, TWO_HANDED);
	setup();
}
