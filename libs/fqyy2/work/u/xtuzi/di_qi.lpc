#pragma save_binary

// 地契

inherit ITEM;

#include <ansi.h>
void create() {

  set_name(HIM "地契" NOR, ({ "di_qi" }));
  set_weight(600);
  set("owner", "张百万");
  set("task", 1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("long", "张百万的地契。\n");
    set("value", 100);
    set("no_put_in", 1);
  }
  setup();
}
