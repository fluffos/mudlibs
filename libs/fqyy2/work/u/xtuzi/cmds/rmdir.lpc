#pragma save_binary
#include <ansi.h>
// delall.c

inherit F_CLEAN_UP;



int main(object me, string path) {

  string dir;
  if (me != this_player(1)) return 0;
  if (!path) return notify_fail("指令格式delall <路径>\n");
  dir = resolve_path(me->query("cwd"), path);
  if (file_size(dir) != -2) return notify_fail("没有这个目录。\n");
  if (path == "/" || path == "/adm" || path == "/adm/" || path == "adm" || path == "/cmds")
    return notify_fail("这几个目录不能删除\n");
  write(FLASH + HIC + "你真的要删除" + path + "里面所有的东西吗？(Y/y)确认 (N/n)放弃\n" NOR);
  input_to("delall", me, dir);
  return 1;
}

protected int delall(string arg, object me, string dir) {
  int j;
  string *ppls;

  seteuid(geteuid(me));

  if (arg == "Y" || arg == "y") {
    ppls = get_dir(dir + "/");
    for (j = 0; j < sizeof(ppls); j++) {
      if (!rm(dir + "/" + ppls[j]))
        write(dir + "/" + ppls[j] + " \tcan't del\n");
      else write("del " + dir + "/" + ppls[j] + "\tok.\n");
    }
  } else write("放弃删除,ok.\n");
  return 1;

}

int help(object me) {
  write(@HELP
指令格式 delall <path>

删除整个目录的文件。
HELP
  );
  return 1;
}
