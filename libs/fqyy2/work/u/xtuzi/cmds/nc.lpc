// call.c
#include <ansi.h>
inherit F_CLEAN_UP;
void notice();

int main(object me, string arg) {
  if (!arg) {
    notice();
    return 1;
  } else
    remove_call_out("notice");
  return 1;

}

void notice() {
  int i;
  string line;
  line = SAVEC;
  for (i = 1; i < 5; i++) {
    line += TOPOINT(i, 70) + CLR_LINE;
  }


  line += TOPOINT(
    5,
    70
  ) + BLINK HIW "重大" NOR + TOPOINT(
    6,
    70
  ) + BLINK HIW "更新" NOR + TOPOINT(
    7,
    70
  ) + CLR_LINE + TOPOINT(
    7,
    71
  ) + HIG "请" NOR + TOPOINT(
    8,
    70
  ) + BLINK HIW "参考" NOR + TOPOINT(9, 70) + BLINK HIW "帮助" NOR + TOPOINT(40, 1);
  line += REST;
  remove_call_out("main");
  remove_call_out("notice");
  message("system", line, users());
  call_out("notice", 10, 0);
}
