#pragma save_binary

// 少林寺方丈的袈裟

inherit ITEM;

#include <ansi.h>
void create() {

  set_name(YEL "袈裟" NOR, ({ "cassock" }));
  set_weight(600);
  set("owner", "玄慈大师");
  set("task", 1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "少林寺方丈玄慈大师失散多年的袈裟。\n");
    set("value", 100);
    set("no_put_in", 1);
  }
  setup();
}
