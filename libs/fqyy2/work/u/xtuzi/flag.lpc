#pragma save_binary
 
// flag.c

#include <ansi.h>
#include <weapon.h>
inherit STAFF;

void create()
{
	set_name(YEL"镖旗"NOR, ({ "flag"}));
	set_weight(10000);
	set("task",1);
	set("owner","陈天星");
	if( clonep() )
		set_default_object(__FILE__);
	else 
		{
		set("unit", "枝");
		set("long",
			"一枝镖旗。上面大书一个字。\n"
                HIY"\t\t\镖\n"
                "\t\t\t\－－－陈天星\n"NOR);
		set("value", 1000);
		set("material", "paper");
		set("wield_msg", "$N实在是找不到武器，情急之下之后把手中的$n握在了手中。\n");
		set("unwield_msg", "$N把手中$n放了下来，总算松了口气。\n");
		}
	init_staff(40);
	setup();
}
