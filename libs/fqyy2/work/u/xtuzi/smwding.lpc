#pragma save_binary


#include <ansi.h>
inherit ITEM;

void create() {
  set_name(GRN "神木王鼎" NOR, ({ "smwding" }));
  set("owner", "丁春秋");
  set_weight(500);
  set_max_encumbrance(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", GRN "星宿派开山祖师丁春秋练化功大法的宝物。\n" NOR);
    set("value", 10000);
    set("no_put_in", 1);
    set("task", 1);
  }
}

int is_container() { return 1; }
