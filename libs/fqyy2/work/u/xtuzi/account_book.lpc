#pragma save_binary
 
// 收据

inherit ITEM;

#include <ansi.h>
void create()
{

        set_name(HIM "帐本" NOR, ({ "account_book" }));
        set_weight(600);
        set("owner","彝南柯");
        set("task",1); 
		if( clonep() )
			set_default_object(__FILE__);
		else
			{
	        set("unit", "张");
    	    set("long", "绮云镇钱庄老板彝南丢失的帐本。\n");
        	set("value", 100);
	        set("no_put_in",1); 
			}
    	    setup();
}
