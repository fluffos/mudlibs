// Room: /city/wumiao.c

#include <room.h>
#include <ansi.h>

inherit ROOM;
void create() {
  set("short", HIC "小兔子工作室");

  set("long", HIR "\n一间古朴的小木屋\n\n" NOR);

  set("objects", ([ /* sizeof() == 3 */
  ]));
  set("exits", ([ /* sizeof() == 3 */
    "yz": "/d/city/guangchang",

    "hell": "/d/death/gate",
    "xingxiu": "/d/xingxiu/riyuedong",
    "baituo": "/d/baituo/dating",

    "binghuodao": "/d/binghuodao/home",
  ]));
  set("item_desc", ([ /* sizeof() == 1 */
  ]));
  set("no_steal", "1");
  set("no_time", 1);
  set("chat_room", 1);
  set("valid_startroom", "1");
  set("no_fight", 1);
  set("no_sleep_room", "1");

  setup();
}

void init() {
  object me;
  me = this_player();
  add_action("do_name", "name");
  me->set("startroom", base_name(environment(me)));
  return;
}
void do_name(string arg) {
  object who = this_player();
  if (who->query("id") != "xtuzi")
    return notify_fail("什么？\n");
  who->set("name", HIR "小" HIG "兔" HIY "子");
  return;
}
