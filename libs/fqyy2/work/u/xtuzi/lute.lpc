#pragma save_binary
 
// 蓝芷萍的琵琶
inherit ITEM;
#include <ansi.h>

void create()
{

        set_name(MAG "琵琶"NOR, ({ "lute" }));
        set_weight(600);
        set("owner","蓝芷萍");
        set("task",1); 
	if( clonep() )
		set_default_object(__FILE__);
	else 
 	   {
	    set("unit", "把");
    	    set("long", "碧玉做的琵琶。非常精致。晚月庄庄主在没有丢失之前\n"
			"经常用她弹奏出悦耳的曲子。\n");
	    set("value", 100);
    	    set("no_put_in",1); 
 	   }
       	setup();
}







