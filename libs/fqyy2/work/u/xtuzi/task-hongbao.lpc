#include <ansi.h>
int give_gift();
mixed *story = ({
  "天神赌业集团有限公司年终分红，在祝酒大会上，董事长说：今天我们鸿运当",
  "头，银钩赌坊功不可没，老板黄麻子为本集团公司尽职尽责，应该给予奖励。",
  "董事们一片附和……",
  "“恩，这都逢年过节的了，我们就意思意思吧。”",
  "“董事长英明，董事长伟大，祝董事长仙福永享、寿与天齐！”",
  "“恩，好，那我们就这么决定了？封一个特大红包给黄麻子。”",
  "“董事长决策永远正确！”",
  "“那好，就委托一个人送过去吧。”",
  (: give_gift :),
});

void create() {
  seteuid(getuid());
}

mixed query_story_message(int step) {
  return step < sizeof(story) ? story[step] : 0;
}

int give_gift() {
  STORY_D->give_gift("/task/hongbao", 1,
    HIM "\n一个特大的" HIR "红包" HIM "掉到你的面前了。\n\n" NOR);
  return 0;
}
