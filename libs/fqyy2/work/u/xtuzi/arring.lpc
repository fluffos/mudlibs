#pragma save_binary
#include <armor.h>
#include <ansi.h>
inherit HEAD;

void create() {
  set_name(HIC "耳环" NOR, ({ "arring" }));
  set("long", "这是一串用宝石镶串成的闪亮耳环。似乎是晚月庄开山祖师瑷伦丢的\n");
  set_weight(1);
  set("owner", "瑷伦");
  set("task", 1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "串");
    set("value", 10000);
    set("material", "gold");
    set("armor_prop/armor", 10);
    set("armor_prop/personality", 5);
    set("wear_msg", "$N将$n拿出穿戴在耳朵上。\n");
  }
  setup();
}
