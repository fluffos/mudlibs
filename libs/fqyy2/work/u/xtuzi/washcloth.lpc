#pragma save_binary
// 浴巾
#include <armor.h>
#include <ansi.h>
inherit CLOTH;
void create()
{

        set_name(HIM "浴巾" NOR, ({ "washcloth" }));
        set_weight(600);
        set("owner","裸体女人");
        set("task",1); 
	if( clonep() )
        	set_default_object(__FILE__);
	else 
 	{
	set("unit", "条");
    	set("long", "这样的浴巾似乎只有澡堂子里面的女人们用的。\n");
	set("value", 100);
    	set("no_put_in",1); 
        set("material", "cloth");
        set("armor_prop/armor", 25);
	}
       	setup();
}
