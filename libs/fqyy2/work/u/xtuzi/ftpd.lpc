string join_path( string dir, string file)
{
    string tmp1,tmp2;
    if (file[0]=='/')
      tmp1=file[1..];
    else
      tmp1=file;
    if (dir[strlen(dir)-1]!='/')
      tmp2=dir+"/";
    else
      tmp2=dir;
    return tmp2+tmp1;
}

private nomask void log_ftp(string x,object socket)
{
	int no;
	string vv;
	int i;
	i=strlen(x)-1;
	while (i>0&&x[i]=='\n') i--;
	x=x[0..i];
#ifndef LOG_SEND
	if (!undefinedp(sending_info[socket]))
	  return;
#endif
	if (socket)
	  sscanf(file_name(socket),"%*s#%d",no);
	else
	  no=-1;
	if (!socket)
	  vv="";
	else
	{
	  if (undefinedp(client_info[socket]))
	  {
	    vv="("+USITE+")";
	  }
	  else
	  {
	    vv=UNAME;
	    if (!vv)
	      vv="";
	    vv+="("+USITE+")";
	  }
	}
	log_file(LOG_FILE,"["+short_time(time())+"]"+vv+": "+x+"("+no+").\n");
}

private nomask void delete_sending(object sock);

private nomask void delete_passive(object sock)
{
    object socket;
    socket=passive_info["client"];
    if (socket)
    {
        UPASV=0;
        if (USEND)
        {
            delete_sending(USEND);
            USEND=0;
        }
    }
    map_delete(passive_info,sock);
    destruct(sock);
}

private nomask void refresh_passive(object sock,object client)
{
   mapping x;
   x=passive_info[sock];
   if (!x)
   {
     passive_info[sock]=
     	([
     	"client":client,
    	"time":time(),
   	]);
   }
   else
     x["time"]=time();
}

private nomask void delete_sending(object sock)
{
	object socket;
	if (sock)
	{
		socket=SCLIENT;
		if (socket)
		{
		  UADDR=0;
		  UPORT=0;
		  UDATA=0;
		  if (UPASV)
		  {
		    delete_passive(UPASV);
		    UPASV=0;
		  }
		}
		map_delete(sending_info,sock);
		destruct(sock);
	}
}

private nomask void remove_sending()
{
	int i;
	object * s;
	s=keys(sending_info);
	for(i=0;i<sizeof(s);i++)
	    if (s[i])
	    {
    	        log_ftp("Sending abend by system",s[i]);
    	        delete_sending(s[i]);
	    }
	sending_info=([ ]);
}

private nomask void refresh_sending(object socket,object client)
{
   mapping x;
   x=sending_info[socket];
   if (!x)
     sending_info[socket]=
     	([
     	"client":client,
    	"time":time(),
   	]);
   else
     x["time"]=time();
}

private nomask void delete_client(object socket)
{
	if (socket)
	{
	    if (UDATA)
	      delete_sending(UDATA);
	    if (UPASV)
	      delete_passive(UPASV);
		map_delete(client_info,socket);
		destruct(socket);
	}
}

private nomask void remove_client()
{
	int i;
	object * s;
	s=keys(client_info);
	for(i=0;i<sizeof(s);i++)
	    if (s[i])
	    {
    	        log_ftp("Abend by system",s[i]);
    	        delete_client(s[i]);
	    }
	client_info=([ ]);
}

private nomask void refresh_client(object socket)
{
   mapping x;
   x=client_info[socket];
   if (!x)
     client_info[socket]=
     	([
    	"time":time(),
    	"login":0,
   	"idle":FTPD_TIMEOUT,
   	"pool":"",
   	"trans":0,
   	"pasv":0,
   	"ctime":time(),
   	]);
   else
     x["time"]=time();
}

private nomask void ftp_send(object socket,mixed d)
{
	if (!socket)
	  return;
#ifdef LOG_RESPOND
    if (stringp(d)&&strlen(d)>3&&d[3]==' ')
        log_ftp("Respond: "+d,socket);
#endif
	if (stringp(d))
	  d=replace_string(d,"\n","\r\n");
	socket->send(d);
}

buffer ftp_data_write(object sock)
{
    string file;
    int i1,i2,i3;
    
    reset_eval_cost();
    
    if (!sending_info[sock])
        return 0;
    
    refresh_client(SCLIENT);

    if ((STYPE&MASK_INOUT)!=OUT)
        return 0;
        
    if ((STYPE&MASK_FILE)!=FILE)
    {
	ftp_send(SCLIENT,"226 Transfer complete.\n" );
	log_ftp("Send complete, disconnected",sock);
    	delete_sending(sock);
	return 0;
    }    
    
    file=SFILE;
    i1=SPOS;

    i2=BLOCK_SIZE;
    i3=file_size(file);

    if (i3<=i1)
    {
	ftp_send(SCLIENT,"226 Transfer complete.\n" );
	log_ftp("Send complete, disconnected",sock);
    	delete_sending(sock);
	return 0;
    }

    refresh_sending(sock,0);

    if (i1+i2>i3)
	i2=i3-i1;
    SPOS=i1+i2;
    client_info[SCLIENT]["trans"]+=i2;
    return read_buffer(file,i1,i2);
}

void ftp_data_read(object sock,mixed data)
{
    if (!data)
    {
        object socket;
        int i;
        object * k=keys(passive_info);
        for(i=0;i<sizeof(k);i++)
        {
          if (k[i]->local_address()[1]==sock->local_address()[1])
            break;
        }
        if (i>=sizeof(k))
        {
            log_ftp("Error connection to passive, kickout",sock);
            destruct(sock);
            return;
        }
        socket=passive_info[k[i]]["client"];
        if (!socket||!UPASV||UDATA&&sock!=UDATA)
        {
            log_ftp("Error connection to passive, kickout",sock);
            destruct(sock);
            return;
        }
        UDATA=sock;
        refresh_passive(UPASV,0);
        USEND=ULISTEN;
        if ((STYPE&MASK_INOUT)!=IN&&USEND["data"])
        {
    	log_ftp("Sending connected",UDATA);
    	UDATA->set_write_callback( (:ftp_data_write:) );
	    if ((USEND["type"]&MASK_FILE)==FILE)
	    {
	        mixed x;
	        x=ftp_data_write(UDATA);
	        if (UDATA)
	    	    UDATA->send(x);
	    }
	    else
	        UDATA->send(replace_string(USEND["data"],"\n","\r\n"));
	    }
        return;
    }
    if (!sending_info[sock])
        return;

    refresh_client(SCLIENT);

    if ((STYPE&MASK_INOUT)!=IN)
        return;
    
    refresh_sending(sock,0);
    
    if (stringp(data))
	data = replace_string( data, "\r", "" );
    if (catch(write_buffer(SFILE,SPOS,data)))
    {
    	log_ftp("Error writing file, disconnected",sock);
    	delete_sending(sock);
    	ftp_send(SCLIENT,"452 Error writing file.\n");
    	return;
    }
    SPOS+=sizeof(data);
}

void ftp_data_close(object sock)
{
   if (!sending_info[sock])
	return;
   if ((STYPE&MASK_INOUT)!=IN)
   {
    ftp_send(SCLIENT,"226 Abort successful.\n");
	log_ftp("Sending closed by peer",sock);
	delete_sending(sock);
   }
   else
   {
	if (SAPPEND==-1)
	    ftp_send(SCLIENT,sprintf("226 Transfer complete (unique file name:%s).\n",SFILE[(strlen(SCLIENT["root"])-1)..]) );
	else
	    ftp_send(SCLIENT,"226 Transfer complete.\n" );
	log_ftp("Receiving closed by peer",sock);
	delete_sending(sock);
   }
}

private nomask void ftp_data_connection(object socket,string data,string name,int type)
{
	int ret;
	int len;
	string p;
	mapping xx;
	if (!UPASV)
	{
	if (!UADDR||!UPORT)
	{
	    ftp_send(socket,"425 Can't open data connection.\n" );
	    return;
	}
	p=sprintf("%s %d",UADDR,UPORT);
	if (type==STRING||UTYPE==ASCII)
	    ret=catch(UDATA=new(SOCKET,SKT_STYLE_CONNECT,p,(: ftp_data_read :),(: ftp_data_close:)));
	else
	    ret=catch(UDATA=new(SOCKET,SKT_STYLE_CONNECT_B,p,(: ftp_data_read :),(: ftp_data_close:)));
	if (!UDATA||ret)
	{
	    ftp_send(socket,"425 Can't build data connection.\n" );
	    return;
	}
	refresh_sending(UDATA,socket);
	xx=USEND;
    }
    else
    xx=ULISTEN;
	if (type==STRING)
	    xx["type"]=STRING|ASCII;
	else
	if (UTYPE==ASCII)
	    xx["type"]=FILE|ASCII;
	else
	    xx["type"]=FILE|BINARY;
	xx["type"]|=OUT;
	xx["data"]=data;
	if (type==STRING)
	    xx["pos"]=0;
	else
	    xx["pos"]=UREST;
	UREST=0;
	if (type==STRING)
	  len=strlen(data);
	else
	  len=file_size(data)-xx["pos"];
	if (UDATA&&UPASV)
	  USEND=xx;
	ftp_send(socket,sprintf("150 Opening %s mode data connection for %s "
		  "(%d bytes).\n",xx["type"]&BINARY?"BINARY":"ASCII", name,len));
    if (UDATA)
    {
	log_ftp("Sending connected",UDATA);
	UDATA->set_write_callback( (:ftp_data_write:) );
	if ((USEND["type"]&MASK_FILE)==FILE)
	{
	    mixed x;
	    x=ftp_data_write(UDATA);
	    if (UDATA)
	    	UDATA->send(x);
	}
	else
	    UDATA->send(replace_string(data,"\n","\r\n"));
	}
}

private nomask void ftp_read_connection(object socket,string file,int append)
{
	int ret;
	int len;
	string p;
	mapping xx;
	if (!UPASV)
	{
	if (!UADDR||!UPORT)
	{
	    ftp_send(socket,"425 Can't open data connection.\n" );
	    return;
	}
	p=sprintf("%s %d",UADDR,UPORT);
	if (UTYPE==ASCII)
	    ret=catch(UDATA=new(SOCKET,SKT_STYLE_CONNECT,p,(: ftp_data_read :),(: ftp_data_close:)));
	else
	    ret=catch(UDATA=new(SOCKET,SKT_STYLE_CONNECT_B,p,(: ftp_data_read :),(: ftp_data_close:)));
	if (!UDATA||ret)
	{
	    if (UDATA)
	      destruct(UDATA);
	    ftp_send(socket,"425 Can't build data connection.\n" );
	    return;
	}
	refresh_sending(UDATA,socket);
	xx=USEND;
    }
    else
    xx=ULISTEN;
	xx["type"]=UTYPE;
	xx["data"]=file;
	xx["append"]=append;
	len=file_size(file);
	if (append==1&&len>=0)
	    xx["pos"]=len;
	else
	    xx["pos"]=0;
	if (append!=1&&len>=0)
	{
	    catch(write_file(file,"",1));
	}
	xx["type"]|=IN;
	if (UDATA&&UPASV)
	  USEND=xx;
	log_ftp("Receiving connected",UDATA);
	ftp_send(socket,sprintf("150 Opening %s mode data connection for %s.\n",
	     xx["type"]&BINARY?"BINARY":"ASCII",file[(strlen(UROOT)-1)..]));
}

private nomask int check_valid_write( string fname, object socket)
{
	int res, l;

	/*
	 * prevent non-admin users from removing .message files
	 */
#ifdef MESSAGE_FILES
	if (SECURITY_D->get_status(UNAME)!="(admin)")
	{
		if( (l = strlen(fname)) >= strlen(MESSAGE_FILES)
		    && fname[l-strlen(MESSAGE_FILES)..l-1] == MESSAGE_FILES)
			return 0;
	}
#endif

	seteuid(UNAME);
	res = (int) MASTER_OB -> valid_write(fname, this_object(), "write_file");
	seteuid( getuid() );

#ifdef WRITE_LEVEL
#if WRITE_LEVEL == VALID_WRITE
	return res;
#elif WRITE_LEVEL == RESTRICTED_WRITE
	if (strsrch(fname, HOME_DIR( UNAME )) == 0
#ifdef PUB_DIR
		  || strsrch(fname, PUB_DIR) == 0
#endif
#ifdef FTP_DIR
		  || strsrch(fname, FTP_DIR) == 0
#endif
		  )
		return res;
	else
		return 0;
#elif WRITE_LEVEL == READ_ONLY
	return 0;
#else
	// default
	return res;
#endif
#else
	// default
	return res;
#endif
}

private nomask int check_valid_read( string fname,object socket)
{
	int res;

	seteuid(UNAME);
	res = (int) MASTER_OB -> valid_read(fname, this_object(), "read_file");
	seteuid( getuid() );

#ifdef READ_LEVEL
#if READ_LEVEL == VALID_READ
	return res;
#elif READ_LEVEL == RESTRICTED_READ
	if (strsrch(fname, HOME_DIR( UNAME )) == 0
#ifdef PUB_DIR
		  || strsrch(fname, PUB_DIR) == 0
#endif
#ifdef FTP_DIR
		  || strsrch(fname, FTP_DIR) == 0
#endif
		  )
		return res;
	else
		return 0;
#elif READ_LEVEL == WRITE_LIMIT_READ
	return check_valid_write( fname,socket);
#else
	// default
	return res;
#endif
#else
	// default
	return res;
#endif
}

private nomask int check_access(string name)
{
//  string file;

#ifdef FTP_USERS
    if (!sizeof(FTP_USERS)) return 0;
    return (member_array(name, FTP_USERS) != -1) ? 1 : 0;
#else // FTP_USERS

#ifdef ANONYMOUS_FTP
    if (ANONYMOUS(name))
        return 1;
#endif // ANONYMOUS_FTP
#ifdef GUEST_WIZARD_FTP
    return member_array(name,SECURITY_D->get_wizlist())!=-1?1:0;
#else
    return directory_exists(HOME_DIR(name));
#endif // GUEST_WIZARD_FTP
#endif // FTP_USERS
}

private nomask int check_email(string email)
{
    string name,site,lead;
    int i;
    return 0;
    if (!email)
        return 0;
    if (sscanf(email,"%s@%s",name,site)!=2)
        return 0;
    if (member_array(name,({ "none","unknown","guest","anonymous", }))!=-1)
        return 0;
    i=0;
    while (name[i]>='a'&&name[i]<='z'
         ||name[i]>='A'&&name[i]<='Z'
         ||name[i]>='0'&&name[i]<='9'
         ||name[i]=='_'
         ||name[i]=='-'
         ||name[i]=='.')
        i++;
    if (i<strlen(name))
        return 0;
    if (sscanf(site,"%s.",lead)!=1)
        return 0;
    if (member_array(lead,({ "none","unknown","guest","anonymous", }))!=-1)
        return 0;
    i=0;
    while (site[i]>='a'&&site[i]<='z'
         ||site[i]>='A'&&site[i]<='Z'
         ||site[i]>='0'&&site[i]<='9'
         ||site[i]=='_'
         ||site[i]=='-'
         ||site[i]=='.')
        i++;
    if (i<strlen(site))
        return 0;
    return 1;
}

