#define ASCII 0
#define BINARY 1
#define MASK_TYPE 1
#define STRING 0
#define FILE 2
#define MASK_FILE 2
#define OUT 0
#define IN 4
#define MASK_INOUT 4

private object ftp_sock;

private mapping client_info = ([ ]);
private mapping sending_info = ([ ]);
private mapping passive_info = ([ ]);

nosave int * bits=({ 0x80,0x40,0x20,0x10,8,4,2,1 });

