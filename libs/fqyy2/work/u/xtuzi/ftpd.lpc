*/
    return PASSWORD_D->main(name,"check",plaintext);
    
}

private nomask int * ip_to_num(string ip)
{
	string * k;
	int * v=allocate(4);
	int i;
	k=explode(ip,".");
	for(i=0;i<4&&i<sizeof(k);i++)
	{
		if (!k[i]||k[i]=="*")
		  v[i]=-1;
		else
		  sscanf(k[i],"%d",v[i]);
	}
	for(;i<4;i++)
	{
		v[i]=-1;
	}
	return v;
}

private nomask string default_ip_mask(string ip)
{
	int * k;
	int * v=allocate(4);
	int i;
	k=ip_to_num(ip);
	for(i=0;i<4;i++)
	{
		if (k[i]!=-1)
		  v[i]=255;
		else
		  v[i]=0;
	}
	return sprintf("%d.%d.%d.%d",v[0],v[1],v[2],v[3]);
}

private nomask int small_ip_group(string x1,string x2)
{
	int * p1,*p2;
	int i,j;
	if (!x2)
	  return 1;
	p1=ip_to_num(x1);
	p2=ip_to_num(x2);
	for(i=0;i<4;i++)
	{
		if (p1[i]==-1)
		  p1[i]=0;
		if (p2[i]==-1)
		  p2[i]=0;
		for(j=7;j>=0;j--)
		  if ((p1[i]&bits[j])||(p2[i]&bits[j]))
		    break;
		if (j<0)
		  continue;
		if ((p1[i]&bits[j])&&(p2[i]&bits[j]))
		  break;
		if (p1[i]&bits[j])
		  return 1;
	}
	return 0;
}

private nomask int in_ip_group(string x1,string x2,string mask)
{
	int *p1,*p2,*p3;
	int i;
	p1=ip_to_num(x1);
	p2=ip_to_num(x2);
	p3=ip_to_num(mask);
	for(i=0;i<4;i++)
	{
		if (p1[i]==-1)
		  p1[i]=0;
		if (p2[i]==-1)
		  p2[i]=0;
		if (p3[i]==-1)
		  p3[i]=0;
		if ((p1[i]&p3[i])!=p2[i])
		  break;
	}
	if (i>=4)
	  return 1;
	return 0;
}

private nomask int check_site(object socket,string name)
{
#ifdef CHECK_SITE
	string * sites,* kk;
	mixed * us;
	int i,v,ban;
	string last_mask;
	int last_stat;

	if (file_size(FTP_SITES)<=0)
	  return 1;
	sites=explode(read_file(FTP_SITES),"\n");
	sites-=({ 0,"" });
	us=({ });
	for(i=0;i<sizeof(sites);i++)
	{
		if (sites[i][0]=='#')
		  continue;
		kk=explode(replace_string(sites[i]," ",""),",");
		if (sizeof(kk)>=2)
		{
		  if (sizeof(kk)<3)
		    kk+=({ 0 });
		  us+=({ kk[0..2] });
		}
	}
	v=-1;
	last_mask=0;
	last_stat=-1;
	for(i=0;i<sizeof(us);i++)
	{
		if (us[i][0]!=name)
		  continue;
		if (!us[i][1])
		  us[i]="";
		if (us[i][1][0]=='~')
		{
		  ban=0;
		  us[i][1]=us[i][1][1..];
		}
		else
		  ban=1;
		if (!us[i][2]||us[i][2]=="")
		  us[i][2]=default_ip_mask(us[i][1]);
		if (small_ip_group(us[i][2],last_mask)
		  &&in_ip_group(USITE,us[i][1],us[i][2]))
		{
			last_mask=us[i][2];
			last_stat=ban;
		}
	}
	if (last_stat==-1)
	{
	    for(i=0;i<sizeof(us);i++)
	    {
		if (us[i][0]!="!")
		  continue;
		if (us[i][1][0]=='~')
		{
		  ban=0;
		  us[i][1]=us[i][1][1..];
		}
		else
		  ban=1;
		if (!us[i][2]||us[i][2]=="")
		  us[i][2]=default_ip_mask(us[i][1]);
		if (small_ip_group(us[i][2],last_mask)
		  &&in_ip_group(USITE,us[i][1],us[i][2]))
		{
			last_mask=us[i][2];
			last_stat=ban;
		}
	    }
	}
	if (last_stat==-1)
	  last_stat=1;
	return last_stat;
#else
    return 1;
#endif
}

private nomask string get_path(object socket,string str )
{
	string * dirlist,* dirlist1;
	int i,s;
	if ( !str || str == "" )
	    return UCWD;
	
	if (str[0]!='/')
	  str=join_path(UCWD,str);
	
	dirlist = explode( str, "/" ) - ({ 0,"", "." });
	s = sizeof(dirlist);
	for (i = 0; i < s; i++)
	{
	    /*
	     * handle ".." occurrences
	     */
	    if ( dirlist[ i ] == ".." )
	    {
		if ( i < 1 )
		{
		    /* handle ".." at root of filesystem */
		    return "/";
		}
		/*
		 * get leading portion of path name
		 */
		if ( i == 1 )
		    dirlist1 = ({ });
		else
		    dirlist1 = dirlist[ 0..i - 2 ];

		/*
		 * get trailing portion of path name, ignoring the middle
		 */
		s -= 2;
	  	if ( i <= s )
		    dirlist1 += dirlist[ i + 1 .. sizeof(dirlist) - 1];
		dirlist = dirlist1;
		i -= 2;
	    }
	}

	if ( dirlist )
		str = "/" + implode( dirlist, "/" );
	else
		str = "/";

	return str;
}

private nomask string ls( string path, int column,int all,object socket)
{
	string *files;
	int i,j,s;
	mixed *xfiles;
	mixed *stats;
	string tmp, tmp2, creator, domain;

	if ( directory_exists( path ) )
	{
	    if ( path[ strlen( path ) - 1 ] == '/' )
		path += "*";
	    else
		path += "/*";
	}

	if (column)
	{
	    xfiles = get_dir( path );

	    if (!xfiles||!(s=sizeof(xfiles)))
		return "";

        if (!all)
          files=xfiles-({ ".",".." });
        else
          files=xfiles;

	    return implode( files, "\n" ) + "\n";
	}

	xfiles = get_dir( path, -1 );
	if (!xfiles || !(s = sizeof( xfiles )))
		return "";

	files = ({ });

	creator = creator_file(path);
	if (!creator)  creator = ROOT_UID;
	creator=creator[0..7];

	domain = domain_file(path);
	if (!domain)  domain = ROOT_UID;
	domain=domain[0..7];

	i = strsrch(path, '/', -1);
	if (i >= 0)
		path = path[0..i];
		
	for (i = 0; i < s; i++)
	{
		if (!all&&((xfiles[i])[0]=="."||(xfiles[i])[0]==".."))
		  continue;

	    tmp2 = ctime((xfiles[i])[2]); /* get last modified timestamp */
	    if ((xfiles[i])[2] + SECS_IN_YEAR < time())
	    {
		/* MMM DD  YYYY */
		tmp = sprintf("%s  %s", tmp2[4..9], tmp2[20..23]);
	    }
	    else
	    {
		/* MMM DD hh:mm */
		tmp = tmp2[4..15];
	    }

	    j = (xfiles[i])[1];   /* get filesize */

	    if (j == -2)
	    {
		/* directory */
 	  	    files+=({ sprintf("drwxrwxr-x %3i %-8s %-8s %8d %s %s",
            		1,creator, domain, 0, tmp, (xfiles[i])[0])
            		});
     	 }
     	 else
     	 {
		/* file */
        	stats = stat(path + (xfiles[i])[0]);
        	files+=({ sprintf("-rw%crw-r-- %3i %-8s %-8s %8d %s %s",
                    stats[2] ? 'x' : '-', /* 'x' if loaded, else ' ' */
            	    1,creator, domain, j, tmp, (xfiles[i])[0])
            	    });
     	 }
   	}
	return implode( files, "\n")+"\n";
}

private nomask void ftp_welcome(object socket)
{
#ifdef FTPD_MAX_USERS    
    if (sizeof(client_info)>FTPD_MAX_USERS)
    {
	    ftp_send(socket,"421 Too many ftp connections active.  Try again later.\n");
	    log_ftp("Too many users, disconnected",socket);
    	delete_client(socket);
    	return;
    }
#endif
	ftp_send(socket,
	  sprintf( "220- %s FTP server(Version %s (MudOS/LPC)) ready.\n"
#ifdef ANONYMOUS_FTP
		   "220  Please login as yourself or 'anonymous'.\n",
#else
		   "220  Please login as yourself.\n",
#endif
		THE_MUD_NAME, FTPD_VERSION ) );
	log_ftp("Connected in",socket);
}

private nomask void ftp_cmd_pass(object socket,string pass)
{
    string tmp;
    if ( ULOGIN || !UNAME )
	{
	  ftp_send(socket,"503 Log in with USER first.\n" );
	  return;
	}
    if (!check_password(UNAME,pass))
    {
#ifdef ANONYMOUS_FTP
    	if (ANONYMOUS(UNAME))
	    {
		    ftp_send(socket,"530 Login failed.  Please send your complete E-mail address as password.\n" );
		    log_ftp("login fail, bad email address",socket);
	    }
	    else
#endif	
	    {
		    ftp_send(socket,"530 Login incorrect.\n" );
		    log_ftp("login incorrect, password not match",socket);
	    }
    }
    else
    {
#ifdef ANONYMOUS_FTP
        if (ANONYMOUS(UNAME))
            UEMAIL=pass;
#endif
	    ULOGIN = 1;
        if (SECURITY_D->get_status(UNAME)=="(player)"
#ifdef ANONYMOUS_FTP        
          ||ANONYMOUS(UNAME)
#endif
          )
	    {
	        UROOT = FTP_DIR;
	        UCWD="/";
	    }
	    else
	    {
    	    UROOT="/";
	        UCWD = HOME_DIR( UNAME );
	    }
#ifdef ANONYMOUS_FTP
	    if (ANONYMOUS(UNAME))
		    log_ftp("<"+pass+"> login correctly",socket);
	    else
#endif
    		log_ftp("login correctly",socket);
#ifdef LOGIN_MSG
	    tmp = read_file( LOGIN_MSG );
	    tmp = tmp[0..<2];
	    tmp = sprintf("230- %s\n",
	    	replace_string( tmp, "\n", "\n230- " ) );
#ifdef ANONYMOUS_FTP
        if (ANONYMOUS(UNAME))
    	    tmp += "230- email: "+UEMAIL+", login from: "+USITE+".\n";
	    else
#endif
	    tmp += "230- user: "+UNAME+", login from: "+USITE+".\n";
	    ftp_send(socket,tmp);
#endif
    	if ( !directory_exists( join_path(UROOT,UCWD) ) )
	    {
	        ftp_send(socket,"230 No directory! Logging in with home="
#ifdef PUB_DIR
						  PUB_DIR ".\n" );
	        UCWD = PUB_DIR;
#else
						  "/\n" );
	        UCWD = "/";
#endif
        }
        else
        {
#ifdef ANONYMOUS_FTP
	        if (ANONYMOUS(UNAME))
	            ftp_send(socket,"230 Guest login ok, access restrictions apply.\n" );
	        else
#endif
	            ftp_send(socket,sprintf("230 User %s logged in successfully.\n", UNAME));
	        UTYPE = ASCII;
	    }
    }
}

private nomask void ftp_cmd_logout(object socket)
{
	log_ftp(sprintf("logged out"),socket);
	ULOGIN=0;
	UNAME=0;
	UREST=0;
}

private nomask void ftp_cmd_user(object socket,string name)
{
    if (UNAME)
	  ftp_cmd_logout(socket);
	if ( !check_site(socket,name))
	{
		ftp_send(socket,sprintf("530 User %s: Can't login from %s.\n",
					  name, USITE));
		log_ftp(sprintf("%s refused login",name),socket);
		delete_client(socket);
	}
	else if ( !check_access(name))
	{
		ftp_send(socket,sprintf("530 User %s access denied.\n",
		  name) );
		log_ftp(sprintf("%s denied access",name),socket);
	}
	else
	{
#ifdef ANONYMOUS_FTP
		if ( name == "anonymous" || name=="ftp" )
			ftp_send(socket,"331 Guest login ok, send your complete E-mail address as password.\n" );
		else
#endif
			ftp_send(socket,sprintf(
		  		"331 Password required for %s.\n", name) );
		UNAME=name;
	}
}

private nomask void ftp_cmd_quit(object socket)
{
	ftp_send(socket, "221 Goodbye.\n" );
	ftp_cmd_logout(socket);
	log_ftp("Disconnected",socket);
	delete_client(socket);
}

private nomask void ftp_cmd_pwd(object socket)
{
	ftp_send(socket,sprintf("257 \"%s\" is the current directory.\n",UCWD));
}

private nomask void ftp_cmd_syst(object socket)
{
	ftp_send(socket,sprintf("215 MUD Type: %s\n", THE_VERSION) );
}

private nomask void ftp_cmd_port(object socket,string * param)
{
	int i,port;
	if (UPASV)
	    destruct(UPASV);
	if ( sizeof(param) < 5 )
	    ftp_send(socket,"550 Failed command.\n" );
	else
	{
	    UADDR=implode(param[0..3],"." );
            sscanf(param[4], "%d", i );
	    port = i << 8;
	    if (sizeof(param)<6)
	      i=0;
	    else
	      i=atoi(param[5]);
	    port += i;
            UPORT=port;
	    ftp_send(socket,"200 PORT command successful.\n" );
	}
}

private nomask void ftp_cmd_pasv(object socket)
{
    int ret;
    string * xx;
    mixed addr;
#ifndef LOCAL_IP
    if (!query_host_ip())
    {
	    ftp_send(socket,"502 'pasv' command not implemented.\n");
        return;
    }
#endif
    if (UDATA)
        delete_sending(UDATA);
    if (UPASV)
        destruct(UPASV);
    if (UTYPE==BINARY)
        ret = catch(UPASV=new(SOCKET, SKT_STYLE_LISTEN_B, 0,
        	(: ftp_data_read :), (: ftp_data_close :)));
    else
        ret = catch(UPASV=new(SOCKET, SKT_STYLE_LISTEN, 0,
        	(: ftp_data_read :), (: ftp_data_close :)));
    if (ret)
    {
        if (UPASV)
            destruct(UPASV);
	    ftp_send(socket,"425 Can't open data connection.\n" );
	    return;
    }
    refresh_passive(UPASV,socket);
    addr=UPASV->local_address();
    xx=explode(addr[0],".");
    xx+=({ ""+addr[1]/256,""+addr[1]%256 });
    ftp_send(socket,"227 Entering Passive Mode("+implode(xx,",")+").\n" );
}

private nomask void ftp_cmd_type(object socket,string type)
{
	if (type=="I")
	{
	    UTYPE= BINARY;
	    ftp_send(socket,"200 Type set to I.\n" );
	}
	else if (type=="A")
	{
	    UTYPE=ASCII;
            ftp_send(socket,"200 Type set to A.\n" );
	}
	else
	    ftp_send(socket,sprintf("504 Type %s not implemented.\n",type));
}

private nomask void ftp_cmd_list(object socket,string * param)
{
	string tmp,tmp2,dir;
	int all=0;
	if (sizeof(param)>=1&&param[0][0]=='-'&&strsrch(param[0],'a')>=0)
	  all=1;
	param=filter_array(param,(: $1[0]!='-' :));
	if ( sizeof( param ) >= 1 )
		dir = get_path( socket, param[0]);
	else
		dir = UCWD;
	tmp=join_path(UROOT,dir);
	if ( check_valid_read( tmp, socket) )
	{
		tmp2 = ls( tmp, 0,all,socket);
		if (tmp2 == "")
			ftp_send(socket, "550 No files found.\n");
		else
			ftp_data_connection(socket,tmp2,"ls",STRING);
	} else
		ftp_send(socket,sprintf("550 Permission denied to %s.\n",tmp));
}

private nomask void ftp_cmd_nlst(object socket,string * param)
{
	int i;
	string tmp,tmp2,dir;
	int all=0,longlist=0;
	if (sizeof(param)>=1&&param[0][0]=='-'&&strsrch(param[0],'a')>=0)
	  all=1;
	if (sizeof(param)>=1&&param[0][0]=='-'&&strsrch(param[0],'l')>=0)
	  longlist=1;
	if (longlist)
	{
	    if (all)
	      param[0]="-a";
	    else
		  param=param[1..];
	    ftp_cmd_list(socket,param);
	}
	else
	{
   	    param=filter_array(param,(: $1[0]!='-' :));
   	    i=sizeof(param);
	    if ( i >= 1 )
		dir= get_path(socket,param[0]);
	    else
		dir= UCWD;
	    tmp=join_path(UROOT,dir);
	    if ( check_valid_read( tmp,socket) )
	    {
		tmp2 = ls( tmp,1,all,socket);
		if (tmp2 == "")
		    ftp_send(socket,"550 No files found.\n" );
		else
		    ftp_data_connection(socket,tmp2,"ls",STRING);
	    }
	    else
		ftp_send(socket,sprintf("550 Permission denied to %s.\n",tmp));
	}
}

private nomask void ftp_cmd_cwd(object socket,string path)
{
	string tmp2,tmp;
	if (!path)
	    tmp2=UCWD;
	else
	    tmp2=get_path(socket,path);
	tmp=join_path(UROOT,tmp2);
	if ( check_valid_read( tmp,socket ) )
	{
	    if ( !directory_exists( tmp ) )
	    {
		ftp_send(socket,sprintf("550 %s: Not a directory.\n", tmp2));
		return;
	    }
	    log_ftp("cd to "+tmp,socket);
	    UCWD = tmp2;
#ifdef MESSAGE_FILES
	    if (file_size(join_path(tmp,MESSAGE_FILES)) > 0)
	    {
		tmp = read_file(join_path(tmp,MESSAGE_FILES));
		tmp = tmp[0..<2];
		tmp = sprintf("250- "+replace_string(tmp, "\n", "\n250- ")
		    +"\n250 CWD command successful.\n",
		    );
		ftp_send(socket,tmp);
	    }
	    else
#endif
		ftp_send(socket,"250 CWD command successful.\n");
	}
	else
	    ftp_send(socket, sprintf("550 %s: No such file or directory.\n",tmp2) );
}

