#pragma save_binary
 
#include <ansi.h>
#include <armor.h>
inherit NECK;

void create()
{
        set_name(HIM "佛珠" NOR, ({ "bead" }) );
        set_weight(700);
		set("task",1);
		set("owner","鸠摩智");
        if( clonep() )
                set_default_object(__FILE__);
        else {
				set("long","一串佛珠，可能是雪山寺鸠摩智的吧.\n");
                set("unit", "串");
                set("value", 100);
                set("material", "pearl");
                set("armor_prop/armor", 2);
                set("armor_prop/spells",2);
                set("wear_msg", "$N拿出一串$n戴在颈子上。\n");
        }
        setup();
}
