#include <ansi.h>
inherit ROOM;
void create() {
  set("short", HIM "绯雨阁" NOR);
  set("long", @LONG
这里是龙羽的寓所和办公的地方.
LONG);
  set("valid_startroom", "1");
  set("exits", ([
    "down": "/d/city/guangchang",
  ]));
  setup();
}
void init() {
  add_action("do_qu", "qu");
}
int do_qu() {
  string mask;    //the verible that record the type of weapon
  object me, weapon;
  me = this_player();
  mask = me->query("weapon/type");
  weapon = new("/d/npc/m_weapon/weapon/m_sword", 1);
  weapon->move(me);
  return 1;
}
