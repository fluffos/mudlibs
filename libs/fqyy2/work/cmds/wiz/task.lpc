#include <ansi.h>
int main(object me, string str)
{
	string output;
        me->add("jing",-5);
	output = HIB"◎  风起云涌神书榜\n" NOR;
	output += "———————————————————————————\n";
	output += TASK_D->dyn_quest_list();
	output += "———————————————————————————\n\n";

	me->start_more(output);
	return 1;
}

