#pragma save_binary
// change by alvins 10-06-99
// ann.c
//by apollo
#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  if (!arg) return notify_fail("你想宣布什么？\n");
  if (sscanf(arg, "%s", arg) == 1) {
    message("vission", HIR "【天神公告】" + arg + "\n\n\n" NOR, users());
    message("vission", HIW "【天神公告】" + arg + "\n\n\n" NOR, users());
    message("vission", HIY "【天神公告】" + arg + "\n\n\n" NOR, users());
  }
  return 1;
}
int help(object me) {
  write(@HELP
天神对MUD的改动的正式宣布，请慎用。
HELP
  );
  return 1;
}
