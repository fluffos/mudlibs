#include <ansi.h>
// 【 天尊 】小黑马(xhm)和任天平(tianping)  

inherit F_CLEAN_UP;

int main(object me, int arg) {
  shout(HIR "【江湖传闻】" MAG "江湖。。。一个充满神秘和危险的世界，太久的平静似乎预示着暴风雨来临的前夕，\n人在江湖，身不由己，总是要去面对一次一次的挑战和危机，谁又能知道明天是否依然是如此的安\n宁呢？\n\n" NOR);
  shout(HIR "【江湖传闻】" MAG "江湖上最近出现一个神秘组织，妄想消灭各门派，一统江湖。\n" NOR);
  "/feature/disaster.lpc"->disaster(0);
  return 1;
}
