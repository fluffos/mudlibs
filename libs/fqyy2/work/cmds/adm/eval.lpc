int main( object me, string arg ) 
{ 
    mixed result; 
if ( arg ) 
{ 
    string file = sprintf("/adm/tmp/a%d.lpc", time()); 
    write_file( file, "#include <ansi.h>\nmixed f()\n{\n return " 
         + arg + "\n}\n" ); 
    catch ( result = call_other( file, "f" ) ); 
    printf( "%s = %O\n", arg, result ); 
    rm ( file ); 
} 
    return 1; 
} 
