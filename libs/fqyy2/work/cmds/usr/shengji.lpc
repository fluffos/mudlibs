#include <ansi.h>

inherit F_CLEAN_UP;

mapping valid_types = ([
        "unarmed":      "拳脚",
        "cuff":      "拳法",
        "hand":      "手法",
        "strike":      "掌法",
        "claw":      "爪法",
        "finger":      "拳脚",
        "sword":        "剑法",
        "blade":        "刀法",
        "club":         "棍法",
        "staff":        "杖法",
        "throwing":     "暗器",
        "force":        "内功",
        "parry":        "招架",
        "dodge":        "轻功",
        "hammer":       "锤法",
        "axe":          "斧法",
        "whip":         "鞭法",
]);

int main(object me, string arg)
{
        string skill,target;
        int money,level,point,my_skill,master_skill;
        object master=me;
        int betrayer;
        mapping my_skl,you_skl,lrn;
        if(! arg)       return notify_fail("命令格式：shengji <武功名>\n");
        skill=arg;
        my_skl=me->query_skills();
        if(! mapp(my_skl))      my_skl=([]);
        if(undefinedp(my_skl[skill]))
                return notify_fail("你并没有学过这门武功。\n");
        if( SKILL_D(skill)->type()!="martial")
                return notify_fail("你只能升级基本武功(verify 为martial类型的)。\n");
        lrn=me->query_learned();
        if(! (point=SKILL_D(skill)->hard_point()))  point=1;
        if(! lrn) lrn=([]);
        if(lrn[skill]<(my_skl[skill]+1)*(my_skl[skill]+1)*point*point)
            return notify_fail("你还没有资格升级这项武功。\n");
        if(my_skl[skill]*my_skl[skill]*my_skl[skill]/10 >
        (int)me->query("combat_exp"))   
                return notify_fail("你的实战经验不够，无法升级这项武功。\n");
        if((int)me->query("potential")-(int)me->query("learned_points")<100)
        return notify_fail("你的潜能不够升级了！\n");
        me->add("potential",-100);
        me->improve_skill(skill,1);
        return 1;
}
int help(object me)
{
        write(@HELP
指令格式：shengji <武功名称> 
这条指令用来升级你自己的基本武功等级。
在我们的侠客行里边，增加了一种任务，奖励的是武功的技能点数,
只有通过战斗或是完成任务，你才能获得升级武功等级的机会。当
你的武功修为达到一定点数后，或者你的skills比你的师傅高，不
能再学的时候,使用skills命令会发现此项武功已变红色，说明该武
功已达到升级的条件。升级的好处是不用向师傅学习，随时随地可
以升级(前提是武功已经变红),不过这需要耗费你的100点潜能!
(如发现问题，请post或tell xtuzi) 
HELP
        );
        return 1;
}
