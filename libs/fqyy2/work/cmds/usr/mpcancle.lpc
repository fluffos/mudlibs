inherit F_CLEAN_UP;
int main(object me, string arg)
{  
      mapping quest;
      int score;     
       if( me->query_temp("mpquest_finish"))
        {
        tell_object(me,"你的门派任务已经完成了！\n", me);
        }
        else if ( mapp(quest = me->query("mpquest")) )
        {
                 tell_object(me,"你决定取消这个任务不做了。\n", me);
                 score=1+random(quest["score"]/2);
                        tell_object(me,"你对"+me->query("family/family_name")+"的忠诚度降低了"+chinese_number(score)+"点。\n");
                        me->add("faith",-score);
                        if(me->query("faith")<0)
                        me->set("faith",0);
                        me->delete("mpquest");
                        }
                else
                {
                tell_object(me,"你目前好象没有门派任务吧？\n", me);                       
                }
                return 1;
        }
