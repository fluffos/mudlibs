// score.c
#include <ansi.h>
#include <combat.h>
inherit F_CLEAN_UP;

string bar_string = "■■■■■■■■■■■■■■■■■■■■■■■■■";
string blank_string = "□□□□□□□□□□□□□□□□□□□□□□□□□";
string display_attr(int gift, int value);
string status_color(int current, int max);
string date_string(int date);
string tribar_graph(int val, int eff, int max, string color);

void create() { seteuid(ROOT_UID); }

int main(object me, string arg) {
  object ob, obt;
  mapping my;
  string line, str, skill_type;
  object weapon;
  int attack_points, dodge_points, parry_points, btmp, t, d, r;

  seteuid(getuid(me));
  btmp = 1;
  if (!arg)
    ob = me;
  else if (wizardp(me)) {
    ob = present(arg, environment(me));
    obt = find_player(arg);
    if (!obt) btmp = 0;
    if (!ob) ob = obt;
    if (!ob) ob = find_living(arg);
    if (!ob) return notify_fail("你要察看谁的状态？\n");
  } else
    return notify_fail("只有巫师能察看别人的状态。\n");
  my = ob->query_entire_dbase();

  if (objectp(weapon = ob->query_temp("weapon")))
    skill_type = weapon->query("skill_type");
  else
    skill_type = "unarmed";

  attack_points = COMBAT_D->skill_power(ob, skill_type, SKILL_USAGE_ATTACK);
  parry_points = COMBAT_D->skill_power(ob, skill_type, SKILL_USAGE_DEFENSE);
  dodge_points = COMBAT_D->skill_power(ob, "dodge", SKILL_USAGE_DEFENSE);
  if (ob->query("mud_age") > 86400) {
    t = ob->query("t");
    d = ob->query("d");
    r = ob->query("r");
  }
  write(HIC "≡" + HIY "───────────────────────────────" HIC "≡\n" NOR);
  write(NOR + RANK_D->query_rank(ob) + "" + ob->short(1) + "\n");
  write(HIY "────────────────────────────────\n" NOR);
  write(HIW "【" HIM "年岁" HIW "】" HIY + chinese_number(ob->query("age")) + "岁" + chinese_number((ob->query("mud_age") - (ob->query("age") - 14) * 86400) / 7200 + 1) + "月" + "\n");
  write(HIW "【" HIM "生日" HIW "】" HIY + CHINESE_D->chinese_date((ob->query("birthday") - 14 * 365 * 24 * 60) * 60) + "\n");
  write(HIW "【" HIM "性别" HIW "】" HIY + ob->query("gender") + "\n");
  if (mapp(my["family"])) {
    if (my["family"]["master_name"]) {
      write(HIW "【" HIM "师傅" HIW "】" HIY + my["family"]["master_name"] + "\n");
    }
  }
  if (ob->query("couple/have_couple")) {
    write(HIW "【" HIM "伴侣" HIW "】" HIY + ob->query("couple/couple_name") + "\n");
  }
  write(HIY "────────────────────────────────\n" NOR);
  write(HIW "【" HIM "臂力" HIW "】" HIY + display_attr(
    my["str"],
    ob->query_str()
  ) + HIW "【" HIM "攻击力" HIW "】" NOR + HIC + attack_points / 100 + 1 + "(+" + ob->query_temp("apply/damage") + ")\n" NOR);
  write(HIW "【" HIM "悟性" HIW "】" HIY + display_attr(
    my["int"],
    ob->query_int()
  ) + HIW "【" HIM "防御力" HIW "】" NOR + HIC + (dodge_points + (weapon ? parry_points : (parry_points / 10))) / 100 + 1 + "(+" + ob->query_temp("apply/armor") + ")\n" NOR);
  write(HIW "【" HIM "根骨" HIW "】" HIY + display_attr(
    my["con"],
    ob->query_con()
  ) + HIW "【" HIM "杀人数" HIW "】" NOR + HIR + chinese_number(my["MKS"] + my["PKS"]) + NOR + "\n" NOR);
  write(HIW "【" HIM "身法" HIW "】" HIY + display_attr(
    my["dex"],
    ob->query_dex()
  ) + HIW "【" HIM "杀死玩家数" HIW "】" NOR + HIR + chinese_number(my["PKS"]) + NOR + "\n" NOR);
  write(HIW "【" HIM "福缘" HIW "】" HIY + display_attr(
    my["kar"],
    ob->query_kar()
  ) + HIW "【" HIM "死亡次数" HIW "】" NOR + HIR + chinese_number(my["dietimes"]) + "\n" NOR);
  write(HIW "【" HIM "容貌" HIW "】" HIY + display_attr(
    my["per"],
    ob->query_per()
  ) + HIW "【" HIM "离奇死亡" HIW "】" NOR + HIR + chinese_number(my["dietimes"] - my["normal_die"]) + "\n" NOR);
  write(HIY "────────────────────────────────\n" NOR);
  write(HIW "【" HIM "精神" HIW "】" HIY + tribar_graph(
    my["jing"],
    my["eff_jing"],
    my["max_jing"],
    HIC
  ) + HIW "【" HIM "判师次数" HIW "】" NOR + HIB + chinese_number(ob->query("betrayer")) + NOR + "\n");
  write(HIW "【" HIM "气血" HIW "】" HIY + tribar_graph(
    my["qi"],
    my["eff_qi"],
    my["max_qi"],
    HIR
  ) + HIW "【" HIM "风度魅力" HIW "】" HIC + chinese_number(ob->query("meili")) + "\n");
  write(HIW "【" HIM "饮水" HIW "】" HIY + tribar_graph(
    my["water"],
    ob->max_water_capacity(),
    ob->max_water_capacity(),
    CYN
  ) + HIW "【" HIM "江湖威望" HIW "】" HIC + chinese_number(ob->query("weiwang")) + "\n");
  write(HIW "【" HIM "食物" HIW "】" HIY + tribar_graph(
    my["food"],
    ob->max_food_capacity(),
    ob->max_food_capacity(),
    YEL
  ) + HIW "【" HIM "江湖阅历" HIW "】" HIC + chinese_number(ob->query("score")) + "\n");
  write(HIY "────────────────────────────────\n" NOR);
  write(HIW "【" HIM "侠义正气" HIW "】" NOR + RED + chinese_number(ob->query("shen")) + NOR "\n");
  write(HIW "【" HIM "学习潜力" HIW "】" NOR + HIY + chinese_number(ob->query("potential") - ob->query("learned_points")) + NOR + "\n");
  write(HIW "【" HIM "实战经验" HIW "】" NOR + HIY + chinese_number(ob->query("combat_exp")) + NOR + "\n");
  write(HIC "≡" + HIY "─────────────────────风起云涌 ─────" HIC "≡\n" NOR);
  return 1;

}
string display_attr(int gift, int value) {
  if (value > gift) return sprintf(HIY "%3d" NOR, value);
  else if (value < gift) return sprintf(CYN "%3d" NOR, value);
  else return sprintf("%3d", value);
}

string status_color(int current, int max) {
  int percent;

  if (max) percent = current * 100 / max;
  else percent = 100;

  if (percent > 100) return HIC;
  if (percent >= 90) return HIG;
  if (percent >= 60) return HIY;
  if (percent >= 30) return YEL;
  if (percent >= 10) return HIR;
  return RED;
}
string tribar_graph(int val, int eff, int max, string color) {
  return color + bar_string[0..(val * 10 / max) * 2 - 1] + ((eff > val) ? blank_string[(val * 10 / max) * 2..(eff * 10 / max) * 2 - 1] : "") + NOR;
}
int help(object me) {
  write(@HELP
指令格式 : score
           score <对象名称>                   (巫师专用)

这个指令可以显示你(你)或指定对象(含怪物)的基本资料。
基本资料的设定请参阅 'help setup'。

see also : hp
HELP
  );
  return 1;
}
