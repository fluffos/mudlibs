#include <ansi.h>
#include <armor.h>

inherit BOOTS;
inherit F_AUTOLOAD;
void create() {
  set_name("布衣", ({ "cloth" }));
  set_weight(30);
  set("no_get", 1);
  set("no_drop", 0);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "cloth");
    set("armor_prop/personality", 10);
    set("armor_prop/karma", 10);
    set("armor_prop/composure", 10);
    set("armor_prop/armor", 1000);
    set("armor_prop/dodge", 50);
    set("wear_msg", "");
    set("remove_msg", "");
  }
}
