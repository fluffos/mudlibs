#include <ansi.h>

inherit NPC; 
inherit F_DEALER; 
void consider();
int ask_gift(); 
int ask_cake();
void create()
{
        set_name("精灵", ({ "spirit" }) );
        set("nickname", HIW "生辰" NOR);
        set("gender", "女性" );
         set("age", 20);
        set("long", 
"精灵楼的主人，管理着精灵楼的一切事务。\n" );
        set("attitude", "friendly");
      set("shen_type", 1);
        set("class", "swordman");
        
        set("str",21);
        set("int",28);
        set("con",40);
        set("dex",40);
        set("per",100);


        set("qi", 2000);
        set("max_qi", 2000);
        set("jing", 1000);
        set("max_jing", 1000);
        set("neili", 3000);
        set("max_neili", 3000);
        set("jiali", 100);
        
        set("combat_exp", 1000000);
        set("score", 200000);
        set("shen", 100000);
        
      set("inquiry", ([
            "精灵物语" : "“那是我最喜欢的书哦，绝对不给人！”\n", 
            "礼物" : (: ask_gift :),
            "节日礼物" : (: ask_gift :),
            "仟禧俱乐部" : (: ask_gift :), 
            "生日礼物" : (: ask_cake :),      ]));
 
      set("chat_chance",30);
      set("chat_msg", ({
            "生辰精灵拿出一本"+HIW"《精灵物语》"NOR+"，专心地读了起来。\n", 
            "生辰精灵随着光芒一闪一闪，无聊地说：“怎么没人来领礼物呢？”\n",
            "生辰精灵笑嘻嘻地说：“要节日礼物，找我就对了。”\n",      }) );
        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                (: exert_function, "shield" :),
        }) );
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
                (: exert_function, "eyes" :),
        }) ); 
        set("vendor_goods", ({
                "/clone/cake/obj/candle",//礼物的路径，自定义。
        }));
        setup();
        carry_object("/d/city/npc/cloth/moon-dress")->wear();
        carry_object("/d/city/obj/gangdao")->wield(); 
}

int ask_cake()
{ 
        object ob;
        if (this_player()->query("birthday")&&this_player()->query("mud_age")>99999)    {
            command("say 恭喜恭喜，祝你生日快乐！\n");
          ob=new("/clone/cake/obj/cake");  //礼物的路径，自定义。
          ob->move(this_player()); 
        message_vision("\n$N给了$n一个特制的生日蛋糕。\n",  this_object(),this_player());
        this_player()->delete("birthday"); 
         return 1;            }
      return 0;
}
 
int ask_gift()
{
        if ( (string)this_player()->query("id")=="xtuzi" )    {
            command("say 请进，嘻嘻。\n");
        //    this_player()->move("/clone/cake/room/spirit");
            }
            else
            {
            command("say 要礼物是吧？好吧。\n");
     //       this_player()->move(" /clone/cake/room/spirit");
        this_player()->delete("giftsp");
//            command("shake");
//            command("say 又不是什么节日，怎么能给礼物？");
            }
      return 1;
}
void init()
{ 
        add_action("do_list", "list");
        add_action("do_buy", "buy"); 
        add_action("do_faint", "18mo");
        add_action("do_faint", "kiss");
        add_action("do_faint", "taste"); 
        add_action("do_faint", "hug");
        add_action("do_faint", "beg");
}
 
void unconcious ()
{
  die ();
}  
void die()
{
        object ob;
        command("sigh");
        message_vision("\n$N背上长出一对透明的羽翼，一开一合间，$N又变得神采奕奕。\n", this_object());
        ob = new("/clone/cake/npc/spirit");  //人物的路径，自定义。目的是不死....
        ob->move(environment(this_object()));
        destruct(this_object());
} 


int do_faint()
{
        object me, ob;
        me=this_object();
        ob=this_player();
message_vision("$N脸一红，说：“哎呀，你怎么能对我做这么丢脸的事呢？”\n" NOR, me);
     message_vision("说罢，口中念了句咒语，$N眼前一黑，晕了过去。\n",ob);
        ob->set("immortal",0);
        ob->delete("immortal");
        ob->unconcious();
        return 1;
}

