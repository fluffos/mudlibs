//create by xtuzi 2001/7/8
inherit ITEM;
#include <ansi.h>
void create() {
  set_name(HIR "水" HIB "晶" HIG "球" NOR, ({ "crystal", "shuijing qiu" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "风起云涌中的宝物，流光溢彩\n" +
      "拥有它你就可以知道" HIC "(locate)" NOR "别人的位置!\n");
    set("unit", "件");
    set("value", 1000000);
  }
}

void init() {
  add_action("do_locate", "locate");
}
int do_locate(string arg) {
  object ob, where, me;
  string *exlst;
  string msg;
  mapping exits;
  if (!arg) return notify_fail("你要找谁?\n");
  ob = find_player(arg);
  me = this_player();
  me->receive_damage("jing", 10, this_object());
  if (!ob) ob = find_living(arg);
  if (!ob || wizardp(ob)) {
    tell_object(me, HIR "水" HIB "晶" HIG "球" NOR "一点反应也没有，你找错了人吧？\n");
    return 1;
  }
  where = environment(ob);
  if (!where) {
    tell_object(me, HIR "水" HIB "晶" HIG "球" NOR "一点反应也没有，你找错了人吧？\n");
    return 1;
  }
  if (!stringp(where->query("short"))) {
    tell_object(me, HIR "水" HIB "晶" HIG "球" NOR "显示：" + ob->name(1) + "好象在某个神秘人物身上！\n"); return 1;
  }
  msg = HIW + ob->name(1) + NOR "仿佛在" NOR;
  msg += random(20) < 4 ? HIG + (string)where->query("short") + NOR + "附近" : HIG "一个不清楚的地方" NOR;
  tell_object(me, HIR "水" HIB "晶" HIG "球" NOR "显示：\n" + msg + "\n");
  return 1;
}
