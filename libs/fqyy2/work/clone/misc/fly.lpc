#include <ansi.h>
inherit ITEM;

void init()
{
          add_action ("do_fly","fly");
}

void create()
{
set_name(HIY"武林飞毯"NOR, ({"flybd"}));
        set_weight(1);
             if (clonep())
                set_default_object(__FILE__);
else {
set("long", HIC"这就是风起云涌II的巫师献给玩家的一个礼物,不要看他是个毯子,用处可大呢，\n
           
*@*@*@*@*@*@*@*@*@*可以带你飞(fly)到以下地方：*@*@*@*@*@*@*@*@*@*

              ＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊
              ＊＊ 天安门(tam)      大理(dl)            泉州(qz)  ＊＊
              ＊＊ 少林(sl)         华山(hs)            灵鹫(lj)  ＊＊
              ＊＊ 武当(wd)         明教(mj)            扬州(gc)  ＊＊
              ＊＊ 星宿(xx)         雪山(xs)            峨眉(em)  ＊＊
              ＊＊ 全真(quz)        白驼山(bt)          古墓(gm)  ＊＊
              ＊＊ 苏州(sz)         归云庄(gyz)         桃花(thd) ＊＊
              ＊＊ 神龙(sld)        南阳(ny)            逍遥(xy)  ＊＊

              ＊＊ 襄阳(xyc)        红花(hh)            长安(cac)  ＊＊
              ＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊ \n"NOR      
);
                set("unit", "床");
		set("no_get", 1);
		set("no_put", 1);
		set("no_drop", 1);
             set("value", 0);
             set("material", "steel");
             set("no_drop", "这样东西不能离开你。\n");
}
                 setup();
}

  int do_fly(string arg)
{

          string pla;
          object me = this_player();
if( me->query("jing") < 10 )
               return notify_fail("你精神不够旺盛，无法使用飞毯！\n");
if( me->query_temp("pending/team"))
               return notify_fail("你正和别人组队呢！\n");				/*

if( !environment(me)->query("no_clean_up"))
{
  message_vision("只有在安全区域才能使用飞行包!!!\y"
                 ,me);
      	return 1;
}*//*

if (me->query("age") > 100)
{
  message_vision("只有小于100岁，才能使用飞行包!!!\n"
                 ,me);
      	return 1;
}*/
    if (me->is_fighting()) 
        return notify_fail("你正打的热闹着呢!\n");
    if (me->is_busy()) 
        return notify_fail("你正热闹着呢!\n");

          if (!arg)
              return notify_fail("你想飞到哪里？\n");
          if( !wizardp(me) && me->is_fighting()  ) 
          return notify_fail("这么危险，那还有时间去拿飞毯呀?\n");

          if (me->query_temp("pigging_seat"))
                return notify_fail("先离开拱猪桌才能行动。\n");
          if( environment(me)->query("light_up"))
               return notify_fail("赌场里不能使用飞行包!!\n");

//          if( !wizardp(me) && !environment(me)->query("outdoors") ) 
//          return notify_fail(HIY"\n还是到外面再用飞毯吧。\n"NOR);

          else {
          message_vision(HIY
"$N拿出武林飞毯放在地上，双手一指，口中念念有词，只见飞毯慢慢的从地上飘了起来。\n"+
"$N爬上飞毯，大喝一声“去吧”，只见飞毯腾空而去。。。\n\n"NOR, me);
}
          if(arg=="gc") pla = "/d/city/guangchang";
     else if(arg=="xx") pla = "/d/xingxiu/xxh1";
     else if(arg=="mj") pla = "/d/mingjiao/shanmen";
     else if(arg=="em") pla = "/d/emei/qingyinge";
     else if(arg=="sl") pla = "/d/shaolin/guangchang1";
     else if(arg=="lj") pla = "/d/lingjiu/damen";
     else if(arg=="dl") pla = "/d/dali/center";
     else if(arg=="xs") pla = "/d/xueshan/shanmen";
     else if(arg=="wd") pla = "/d/wudang/guangchang";
     else if(arg=="thd") pla = "/d/taohua/dating";
     else if(arg=="sld") pla = "/d/shenlong/dating";
     else if(arg=="cac") pla = "/d/changan/ca";
     else if(arg=="xy") pla = "/d/xiaoyao/qingcaop";
     else if(arg=="ny") pla = "/d/nanyang/nanyang";
     else if(arg=="hs") pla = "/d/huashan/qunxianguan";
     else if(arg=="hh") pla = "/d/hangzhou/liuhed";
     else if(arg=="tam") pla = "/d/city2/tian_anm";
     else if(arg=="quz") pla = "/d/quanzhen/damen";
     else if(arg=="bt") pla = "/d/baituo/dating";
     else if(arg=="qz") pla = "/d/quanzhou/zhongxin";
     else if(arg=="gm") pla = "/d/gumu/mumen";
     else if(arg=="sz") pla = "/d/suzhou/canlangting";
     else if(arg=="gyz") pla = "/d/guiyun/taihu";
     else if(arg=="xyc") pla = "/d/xiangyang/guangchang";

               else {
               message_vision(HIR
"飞毯飞了半天，才发觉$N要去的地方根本不存在，歪歪斜斜的好像要掉下来，\n结果$N一个跟斗从天下栽了下来，摔得鼻青脸肿！\n"NOR, me);
}
     if (me->move(pla)) {
       message_vision(HIC"\n到了！飞毯稳稳地降到地下，$N爬下飞毯，将毯收回怀中。\n"NOR,me);
if( me->query("age") <= 100 )
           me->add("jing",-10);
 else   me->add("jing",-10);
}
     return 1;
}