inherit ROOM;

// can put some book about budism here.

void create()
{
        set("short", "莫高窟");
        set("long", @LONG
这里墙壁上绘制着与佛教相关的画面，有仙女飞天，还有反弹琵琶。洞中
还有很多佛像和经书。你被这些瑰丽的文化之宝惊呆了。
LONG );
        set("exits", ([ 
             "north" : __DIR__"yueerquan",
        ]));
        set("no_clean_up", 0);
set("no_fight",1);
set("no_steal",1);
set("no_sleep_room",1);
set("no_beg",1);
        setup();
//        replace_program(ROOM);
}

void init()
{
add_action("do_mianbi","mianbi");
}
int do_mianbi(string arg)
{
object me=this_player();
int jing_cost;
if ( !arg)
                return notify_fail("你要读什么？\n");
if(arg=="仙女飞天图")
{
if ( (int)me->query_skill("literate", 1) < 1){
write("你是个文盲，先学点文化(literate)吧。\n");
return 1;
}
if ( (int)me->query_int() < 15){
write("你的悟性不够，先学点文化(literate)吧。\n");
	return 1;
	}
if ( (int)me->query_skill("literate", 1) > 250){
write("你已经领悟了仙女飞天图的精髓，没必要看美女了吧。\n");
return 1;
}
jing_cost = me->query("max_jing")/5;
	if((int)me->query("jing") < jing_cost){
write("你现在眼花缭乱，别给美女图迷惑了。\n");
		return 1;
}
	me->receive_damage("jing", jing_cost );
me->delete_temp("stone_learned");
message_vision("$N正专心研读石壁上的古怪图形。\n", me);
if ( (int)me->query_skill("literate", 1) < 250 && random(10)>3 ){
write("你对着石壁琢磨了一回儿，似有所悟。\n");
me->improve_skill("literate", me->query_int());
	me->set_temp("stone_learned",1);
		}
	return 1;
}
else
if(arg=="反弹琵琶图")
{
 if ( (int)me->query_skill("literate", 1) < 400){
write("你的读书识字等级不够，先去学点文化(literate)吧。\n");
return 1;
}
if ( (int)me->query_int() < 45){
write("你的悟性不够，先学点文化(literate)吧。\n");
 return 1;
 }
jing_cost = me->query("max_jing")/10;
if((int)me->query("jing") < jing_cost){
write("你现在眼花缭乱，别给琵琶图迷惑了。\n");
    return 1;
}
 me->receive_damage("jing", jing_cost );
 me->delete_temp("stone_learned");
message_vision("$N正专心研读石壁上的古怪图形。\n", me);
if ( (int)me->query_skill("literate", 1) > 400 &&(int)me->query_skill("literate", 1) < 1000&&random(10)>3 ){
write("你对着石壁琢磨了一回儿，似有所悟。\n");
me->improve_skill("literate", me->query_int());
;
me->set_temp("stone_learned",1);
  }
  return 1;
 }
else
return notify_fail("你要学习什么？\n");
}
