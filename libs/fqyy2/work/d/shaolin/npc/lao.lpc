#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string ask_bo();

// void consider();

void create() {
  set_name("无名老僧", ({ "wuming seng", "wuming", "seng" }));
  set("long", "他就是少林无名老僧，看起来已经是风烛残年。而且双腿残废。 \n");
  set("title", HIY "少林圣僧" NOR);
  create_family("少林派", 34, "弟子");
  set("attitude", "peaceful");
  set("age", 95);
  set("gender", "男性");
  set("shen_type", 1);
  set("no_drop", 1);
  set("chat_msg", ({
    CYN "无名僧人言到：“老纳自创之少林无影剑，举世无双。”\n" NOR,
    CYN "无名僧人言到：“老纳一身只败在独孤九剑之下，于是钻研20年终创出无敌的少林无影剑。”\n" NOR,
  }));
  set("con", 30);
  set("dex", 30);
  set("int", 30);
  set("str", 30);
  set("per", 15);
  set("kar", 10);
  set("max_jing", 1000);
  set("max_neili", 5000);
  set("max_qi", 10000);
  set("jing", 1000);
  set("neili", 5000);
  set("qi", 6000);
  set("jiali", 200);
  set("shen", 100000);
  set("combat_exp", 25000000);

  set_skill("buddhism", 800);
  set_skill("dodge", 800);
  set_skill("force", 800);
  set_skill("literate", 800);
  set_skill("parry", 800);
  set_skill("sword", 1000);
  set_skill("finger", 800);
  set_skill("wuying-jian", 1200);
  set_skill("yijinjing", 800);
  set_skill("hunyuan-yiqi", 800);
  set_skill("shaolin-shenfa", 800);
  set_skill("club", 800);
  set_skill("claw", 800);
  set_skill("yizhi-chan", 800);
  set_skill("staff", 800);

  map_skill("finger", "yizhi-chan");
  map_skill("force", "hunyuan-yiqi");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("parry", "wuying-jian");
  map_skill("sword", "wuying-jian");
  /*
	set("inquiry", ([       
           "慕容博":(:ask_bo:),
           "萧远山":"萧施主杀机过重，罪孽深重，被我留在这里了。\n",
        ]));

*/
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: perform_action, "sword.wuying" :),
    (: exert_function, "recover" :),
  }));

  setup();
  carry_object("/clone/weapon/changjian")->wield();

}
string ask_bo() {
  object me;
  me = this_player();
  if (this_player()->query("family/master_id") == "murong bo") {


    //                return RANK_D->query_respect(this_player()) +                 "施主既然已是慕容弟子，就请进吧？";
    command("say 慕容施主在里面等着你呢。");
    me->set_temp("rent_asked", 1);
    return " 冤孽，冤孽！";
  }
  if (this_player()->query("family/master_id") != "murong fu")
    return RANK_D->query_respect(this_player()) + "施主非慕容弟子，不知此话从何谈起？";
  command("say 施主既然能这么远的寻来，想来也是天意，你要找的人就在里面。");
  me->set_temp("rent_asked", 1);
  return "现在施主可以进去了。";
}




void attempt_apprentice(object who) {
  mapping who_fam;
  string name, new_name;
  name = who->query("name");
  if ((int)who->query("betrayer")) {
    command("say 依我看" + RANK_D->query_respect(who) + "你好象以前拜过别的师傅,看来我们没有缘分？!");
    command("say 我的无影剑何时才有传人呀!");
    return;
  }
  if ((int)who->query("bai_wuming") == 1) {
    command("say 我不会再收你为徒了，你还是走吧！\n");
    return;
  }
  if (!(who_fam = who->query("family")) || who_fam["family_name"] != "少林派") {
    command("say " + RANK_D->query_respect(who) + "与本派素无来往，不知此话从何谈起？");
    return;
  }
  if ((int)who->query_skill("buddhism", 1) < 200) {
    command("say 悟禅之人，德义为先，功夫的高低倒还在其次，未练武，要先学做人。");
    command("say 在禅宗心法方面，" + RANK_D->query_respect(who) +
      "是否还做得不够？");
    return;
  }
  if ((int)who->query_skill("parry", 1) < 200) {
    command("say 在基本功方面，" + RANK_D->query_respect(who) +
      "是否还做得不够？");
    return;
  }
  if ((int)who->query_skill("literate", 1) < 200) {
    command("say 万事都讲一个缘字。");
    command("say " + RANK_D->query_respect(who) + "与佛无缘，还是请回吧。");
    return;
  }
  if ((int)who->query_skill("hunyuan-yiqi", 1) < 200) {
    command("say 我少林派乃内家武功，最重视内功心法。");
    command("say " + RANK_D->query_respect(who) +
      "是否还应该在内功上多下点功夫？");
    return;
  }
  if ((int)who->query_skill("force", 1) < 200) {
    command("say 在内功方面，" + RANK_D->query_respect(who) +
      "是否还做得不够？");
    return;
  }

  if (who->query("family/generation") > 36) {
    command("say 你还是先去拜渡字辈师侄吧!");
    return;
  }
  if (who->query("family/generation") <= 36) {
    command("chat 想不到老纳在垂死之年，又觅得一个可塑之才，好！老衲就将毕生\n" "的武学都传受于你！\n");
    command("recruit " + who->query("id"));

    who->set("title", HIY "少林派之世外高僧" NOR);
    name = who->query("name");
    new_name = "渡" + name[2..3];
    who->set("name", new_name);
    who->set("bai_wuming", 1);
    command("say 从今以后你的法名叫做" + new_name + "，恭喜你荣升为少林派渡字辈弟子 !");
    command("recruit " + who->query("id"));

    return;
  }
}
