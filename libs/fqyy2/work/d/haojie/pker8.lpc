#include <ansi.h>
inherit NPC;
inherit F_MASTER;

string ask_me();

void create()
{
	set_name("紫衣杀手", ({"sha shou", "sha", "shou"}));
	set("gender", "男性");
	set("age", 30);
	set("long", "他是七杀门的杀手。\n");
	set("per", 10);
	set("attitude", "peaceful");

	set("str", 15);
	set("int", 35);
	set("con", 35);
	set("dex", 35);

	set("qi", 5000);
	set("max_qi", 5000);
	set("jing", 5000);
	set("max_jing", 5000);
	set("neili", 5000);
	set("max_neili", 5000);
	set("jiali", 40);

        set("combat_exp", 4000000);
	set("score", 0);
	set("shen_type",-20000);

	set_skill("force", 300);
	set_skill("jiuyang-shengong", 300);
	set_skill("unarmed", 300);
//	set_skill("tianxin-zhang", 100);
	set_skill("dodge", 300);
	set_skill("qiankun-danuoyi", 300);
	set_skill("sword",300);
//	set_skill("liefeng-jian",300);
	set_skill("parry", 300); 
	map_skill("force"  , "jiuyang-shengong");
	map_skill("unarmed", "tianxin-zhang");
	map_skill("dodge"  , "qiankun-danuoyi");
	map_skill("parry"  , "liefeng-jian");
	map_skill("sword"  , "liefeng-jian");
	create_family("七杀门", 2, "杀手");
	set("chat_chance_combat", 40);
	set("chat_msg_combat", ({
		(: exert_function, "recover" :),
		(: perform_action, "sword.dian" :),
		(: perform_action, "sword.jifeng" :),
	}) );   

	set ("chat_chance",30);
	set ("chat_msg", ({
		(:call_out,"random_move",0:),
	}));

	setup();
	set("haojie",1);
	carry_object("/clone/weapon/changjian")->wield();
	carry_object("/clone/misc/cloth")->wear();
}

void init()
{
	object ob;

	if ( interactive(ob=this_player()) ) {
			remove_call_out("killing");
			call_out("killing", 0, ob);
		}
}

void killing(object ob)
{
	if ( environment(this_object()) != environment(ob) ) return;
	if ( base_name(environment(ob))=="/d/city/wumiao" ) return;
	message_vision("$N对著$n喝道：「"+RANK_D->query_rude(ob)+"！今天不是你死就是我亡！」\n",this_object(),ob);
	this_object()->kill_ob(ob);
	return;
}

int random_move()
{
	mapping exits;
	string *dirs, dir, dest;

	if( !mapp(exits = environment()->query("exits")) ) return 0;
	dirs = keys(exits);
	dir = dirs[random(sizeof(dirs))];
	dest = exits[dir];
	if( domain_file(dest)!=query("domain") ) return 0;
	if( this_object()->is_fighting() ) return 0;
	command("go " + dir);
	return 1;
}
