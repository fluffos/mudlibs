#include <ansi.h>
inherit NPC;
string ask_me();

void create() {
  set_name(HIR "侠客使者" NOR, ({ "xiake shizhe", "shizhe" }));
  set("nickname", HIY "不知情愁枉少年" NOR);
  set("gender", "男性");
  set("age", 18);
  set("long", YEL "这位是〖侠客行〗的使者，向他打听“侠客行”，他会带给您想不到的惊喜。\n" NOR);
  set("shen_type", 1);
  set("combat_exp", 1000000);
  set("str", 30);
  set("dex", 30);
  set("con", 30);
  set("int", 30);
  set("per", 30);
  set("attitude", "friendly");
  set("max_qi", 100000);
  set("neili", 100000);
  set("max_neili", 100000);
  set("score", 100000);

  set("inquiry", ([
    "侠客行": (: ask_me :)
  ]));
  setup();
}

void init() {
  object ob;
  ob = this_player();
  ::init();
  if (interactive(ob) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  command("whisper " + ob->query("id") + " " HIW "欢迎光临〖风起云涌〗" + HIR + "(ask shizhe about 侠客行)\n" + NOR + HIW + "小的助您行走江湖．" NOR);
  //   command("es " + HIC"欢迎光临〖笑红尘II〗,IP: 202.114.203.100 Port: 5555 \n"NOR);
}

string ask_me() {
  object me = this_player();
  mapping fam;

  if ((int)me->query("welcomexhc"))
    return "呵呵～这就是您的不是了！小的已经对您施过法力了！";
  else {
    me->set("welcomexhc", 1);
    me->add("max_neili", 100);
    me->add("neili", 100);
    me->add("potential", 1000);
    me->add("food", 1000);
    me->add("water", 10000);
    me->add("combat_exp", 10000);
    CHANNEL_D->do_channel(
      me,
      "chat",
      sprintf(
        "在下%s今日光临〖风起云涌〗（IP: 202.114.203.100 Port: 2001）\n         现已得到侠客使者的帮助和奖励！即日起开始行走江湖了！",
        me->name(1)
      )
    );
    return "欢迎光临" NOR + HIR "〖风起云涌〗" NOR "，小的护架来迟，罪该万死！在下可助您行走江湖！\n"
      HIW "突然天空中一道" HIM "七" HIY "彩" HIR "霞" HIC "光" HIW "笼罩四方，转瞬即逝！" NOR;
  }
}
