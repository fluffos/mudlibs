inherit ITEM;
inherit F_FOOD;

void create()
{
        
	switch (random(8))
  {
	case 0:{
	set_name("五仁月饼", ({"moon cake", "mooncake", "yue bing", "yuebing"}));
	break;}
	case 1:{
	 set_name("豆沙月饼", ({"moon cake", "mooncake", "yue bing", "yuebing"}));
       break;}
	case 2: {
	set_name("双黄月饼", ({"moon cake", "mooncake", "yue bing", "yuebing"}));
       break;}
	case 3: {
	  set_name("金腿月饼", ({"moon cake", "mooncake", "yue bing", "yuebing"}));
       break;}
	case 4: {
	  set_name("莲蓉月饼", ({"moon cake", "mooncake", "yue bing", "yuebing"}));
	break;}
        case 5: {
          set_name("椰蓉月饼", ({"moon cake", "mooncake", "yue bing", "yuebing"}));
        break;}
        case 6: {
          set_name("枣泥月饼", ({"moon cake", "mooncake", "yue bing", "yuebing"}));
        break;}
        case 7: {
          set_name("七星伴月", ({"moon cake", "mooncake", "yue bing", "yuebing"}));
        break;}

	}
        set_weight(1000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "块");
                set("long", "一块精美的月饼，上面印着“中秋快乐”的图案,让人想上去啃（ken)两口。\n");
                set("food_remaining", 4);
     //           set("food_supply", 50);
                set("value", 0);
set("no_sale",1);
set("no_get",1);
set("no_put",1);
set("no_get_from",1);
set("no_steal",1);
                set("no_give","这东西不能给人!\n");
     set("no_drop","好不容易得到的怎么能仍呢!\n");
     set("no_steal","别人好不容易得到的,怎么能偷呢!\n");
		set("no_sell","拿去与大家分享不好吗？\n");
        set("no_get", 1);
        set("no_drop", 1);
        set("no_put", 1);
        set("no_beg", 1);
        set("no_steal", 1);
        }
} 
void init()
{
    add_action("do_ken","ken");
}
   int do_ken(string arg)
{
object me=this_player();
object ob=this_object();
  if(!arg||(arg!="moon cake"))
  return notify_fail("你要吃什么？\n");
else
  me->add("potential",500);
   message_vision("$N获得了500点潜能。\n",me);
    destruct(this_object());
   return 1;
}
void owner_is_killed()
{
        destruct(this_object());
}
