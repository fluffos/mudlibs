void init()
{
   add_action("do_accept","defend");
}

int do_accept(string arg)
{  
   string myop,tempstr;
   int j;
   object ob,me; 
   me=this_player();
   if (!arg) return notify_fail("你要跟谁切磋？\n");    
   ob = LOGIN_D->find_body(arg);
   if (!ob) return notify_fail("咦．．． 有这个人吗？\n");
   if (me->query("id")==arg) return notify_fail("想和你自己切磋?\n");
   tempstr=ob->query_temp("objectob");
   if (tempstr!=me->query("id")) return notify_fail("对方并没有向你挑战。\n");  
   if ( !present(ob,environment(me)) ) return notify_fail("向你挑战的人不在这里。\n");
   if ( ob->is_busy() ) return notify_fail("对方正忙着呢！\n"); 
   if ( sizeof(all_inventory(load_object(__DIR__"ground"))) >0 ) 
     {
       j=sizeof(all_inventory(load_object(__DIR__"ground")));
       while (j>0)
       {
         j=j-1;
         if (userp( all_inventory(load_object(__DIR__"ground") )[j]))
         return notify_fail("擂台上已经有人了。\n");
       }
     }  
   message_vision("$N和$n双双纵身跃上擂台,准备比武。\n",me,ob); 
   me->move(__DIR__"ground");
   ob->move(__DIR__"ground");
   me->set_temp("statusbef/qi",(int)me->query("qi"));
   me->set_temp("statusbef/eff_qi",(int)me->query("eff_qi"));
   me->set_temp("statusbef/jing",(int)me->query("jing"));
   me->set_temp("statusbef/eff_jing",(int)me->query("eff_jing"));
   me->set_temp("statusbef/neili",(int)me->query("neili"));
   me->set_temp("statusbef/jingli",(int)me->query("jingli"));
   ob->set_temp("statusbef/qi",(int)ob->query("qi"));
   ob->set_temp("statusbef/jing",(int)ob->query("jing"));
   ob->set_temp("statusbef/eff_qi",(int)ob->query("eff_qi"));
   ob->set_temp("statusbef/eff_jing",(int)ob->query("eff_jing"));
   ob->set_temp("statusbef/neili",(int)ob->query("neili"));
   ob->set_temp("statusbef/jingli",(int)ob->query("jingli"));
   ob->delete_temp("objectob");
   remove_call_out("wait_and_star");
   remove_call_out("finish_match");
   call_out("wait_and_start",2);
   return 1;
}

int wait_and_start()
{ object fan;
  object me,ob;
  object *allinv;
  allinv=all_inventory(environment(this_player()) );
 if (sizeof(allinv)<2) return 1;
  me=allinv[0];
  ob=allinv[1];
  message_vision(HIW"$N与$n比武开始！限时五分钟。\n"NOR,me,ob);
  message("system", HIC"【闲聊】金庸(Jin yong)："+me->query("name")+"与"+ob->query("name")+"比武开始！限时五分钟。\n" NOR, users());
  "/cmds/std/kill"->main(me,(string)ob->query("id"));
  "/cmds/std/kill"->main(ob,(string)me->query("id"));
   call_out("finish_match",300); 
  return 1;
}
  
int finish_match()
{  object fan;
   int i,j;
  object me,ob;
   object *allinv,*playerinv;
   j=0;
   playerinv=({});
  allinv=all_inventory(load_object(__DIR__"ground"));
// if (sizeof(allinv)<2) return 1;
   i=sizeof(allinv);
   while (i>0)
   {
   i=i-1;
   if (userp(allinv[i]))
     {
     playerinv+=({allinv[i]});
     j=j+1;
     }
   }
   if (j<2) return 1;
   me=playerinv[0];
   ob=playerinv[1];
 message( "system", HIC"【闲聊】金庸(Jin yong): "+me->query("name")+"与"+ob->query("name")+"大战三百回合，不分胜负，现各下场休息，有待来日再战。\n"NOR,users());
  me->remove_killer(ob);
  ob->remove_killer(me);
  me->move(__DIR__"undeer");
  ob->move(__DIR__"under");
   me->set("qi",me->query_temp("statusbef/qi"));
   me->set("eff_qi",me->query_temp("statusbef/eff_qi"));
   me->set("jing",me->query_temp("statusbef/jing"));
   me->set("eff_jing",me->query_temp("statusbef/eff_jing"));
   me->set("neili",me->query_temp("statusbef/neili"));
   me->set("jingli",me->query_temp("statusbef/jingli"));
   ob->set("qi",ob->query_temp("statusbef/qi"));
   ob->set("jing",ob->query_temp("statusbef/jing"));
   ob->set("eff_qi",ob->query_temp("statusbef/eff_qi"));
   ob->set("eff_jing",ob->query_temp("statusbef/eff_jing"));
   ob->set("neili",ob->query_temp("statusbef/neili"));
   ob->set("jingli",ob->query_temp("statusbef/jingli"));
  return 1;
}
  
void alternative_unc (object me)
{
  object ob = me->query_temp("last_damage_from");
  if (me->query("qi")<0) me->set("qi",10);
  if (me->query("eff_qi")<0) me->set("eff_qi",10);
  me->remove_killer(ob);
  ob->remove_killer(me);
/*
  message_vision(HIG"$n把$N打翻在地，飞起一脚，将$N踢下了擂台。\n"NOR,me,ob);
  message_vision(HIG"$n在观众的欢呼声中，高高兴兴地下场休息了。\n"NOR,me,ob);
  tell_room( __DIR__"under","\n>\n");
 me->move(__DIR__"under");
  ob->move(__DIR__"under");
*/
   me->set("qi",(int)me->query_temp("statusbef/qi"));
   me->set("eff_qi",(int)me->query_temp("statusbef/eff_qi"));
   me->set("jing",(int)me->query_temp("statusbef/jing"));
   me->set("eff_jing",(int)me->query_temp("statusbef/eff_jing"));
   me->set("neili",(int)me->query_temp("statusbef/neili"));
   me->set("jingli",(int)me->query_temp("statusbef/jingli"));
   ob->set("qi",(int)ob->query_temp("statusbef/qi"));
   ob->set("eff_qi",(int)ob->query_temp("statusbef/eff_qi"));
   ob->set("eff_jing",(int)ob->query_temp("statusbef/eff_jing"));
   ob->set("jing",(int)ob->query_temp("statusbef/jing"));
   ob->set("neili",(int)ob->query_temp("statusbef/neili"));
   ob->set("jingli",(int)ob->query_temp("statusbef/jingli"));
}

