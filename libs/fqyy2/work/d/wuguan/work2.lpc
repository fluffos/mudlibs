// work.c modified by snow
#include <ansi.h>
inherit ROOM;
void create()
{
        set("short", "赚钱工厂");
        set("long", @LONG
这是一间小小工厂，这里是玩家赚钱的地方。老板是一个一看就
知道是十分精明的干瘦的中年人，老是带着一脸奸笑。你可以看到许
多人正在忙忙碌碌的工作着，在这里只有勤劳才有收获，开小差的人
是拿不到分文的，门口挂著一块牌子(sign)。
LONG
        );
        set("no_sleep_room",1);
        set("exits", ([ /* sizeof() == 1 */
  "west" : __DIR__"xiaojs",
]));
        set("item_desc", ([
                "sign": @TEXT
现在正紧缺人手，急需雇佣一批短工来干活(赚钱啊)。
ganhuo     开始工作。
TEXT
        ]) );
    set("no_magic", 1);
        setup();
}
void init()
{
        add_action("do_work", "ganhuo");
        if (!wizardp(this_user()))
add_action("discmds",({"duanlian","ansuan","touxi","persuade","teach","exert","exercise","study","learn","sleep","kill","steal","cast","conjure","expell","fight","hit","perform","prcatice","scribe","surrender","get","drop"}));
}
 int discmds()
{
    tell_object(this_player(),"还是老老实实工作吧？！\n");
    return 1;
}
int do_work(string arg)
{
        int time;
        object me;
        me = this_player();
        time = 300/(int)me->query("str");
        if (time <15) time = 15;
        if ((int)me->query("jing")<random(30) || (int)me->query("qi")<random(30))
        {
        	message_vision("$N开始辛苦地工作......\n", me);
        	write("你突然感到头晕眼花。。。。。。\n");
        	tell_room(environment(me), RED+me->name() +"脸色看起来不大对头，斗大的汗珠从脸上滑了下来。\n哎,又是一个要钱不要命的..!\n"NOR, ({me}));
                me->unconcious();
                return 1;
         }
        if ((int)me->query("jing")<30 || (int)me->query("qi")<30) return notify_fail("你快累死了，要钱不要命了吗？\n");
        if (me->query_temp("working")) return notify_fail("加油呀！谁叫你穷呀！\n");
/*
         if ((cot>2)||me->query("combat_exp")>10000) {
        	write("老板嘿嘿一笑：我这里只收新人，大侠做义工可没工钱的哟！\n");
        	me->start_busy(5);
        	return 1;
        	}
*/
        message_vision("$N开始辛苦地工作......\n", me);
        me->set_temp("working",1);
        me->add_temp("work_times",1);
        call_out("working",2+random(time),me);
        return 1;
}
int working(object me)
{
        object ob;
        if (!me)  return 1;
        
        me->add("jing",-30);
        me->add("qi",-30);
        if((string)environment(me)->query("short")!="赚钱工厂"||me->query_temp("work_out"))
        {
        write("你工作的时候开小差，结果累了半天什么都没得到!\n");
        me->set_temp("working",0);
        me->delete_temp("work_out");
        return 1;
}
        if(random((int)me->query_temp("work_times"))>30+random(20))
        {
                if(random((int)me->query("kar"))>20)
message_vision(HIY"〖赚钱工厂〗"NOR+":"+YEL" 由于"HIW+"$N"+NOR YEL"工作勤劳，获得了老板的嘉奖!\n"NOR,me);
        	else message_vision("老板对$N说：嗯，做的不错，这是给你的奖励！\n",me);
me->add("balance",100000);
              // me->add("potential",30);
               me->delete_temp("work_times");
               me->set_temp("working",0);
               return 1;
        }
        message_vision("$N辛苦的工作终于结束了，可人也累的半死。\n", me);
           // me->add("combat_exp",random(10));
          //   me->add("potential",random(10));
me->add("balance",8000+random(2000));
message_vision("老板冷冷地对$N说：这是你的工钱,已经帮你存入钱庄。\n", me);
        me->set_temp("die_for","在赚钱工厂累");
        me->set_temp("working",0);
        return 1;
}
int valid_leave(object me, string dir)
{
       if(dir=="west")
       me->set_temp("work_out",1);
        
        return ::valid_leave(me, dir);
}
