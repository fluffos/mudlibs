
//create by xtuzi
//杀妖系统,怪的武功设定和其所使的PFM,根据各门派特点设计，可以自己修改武功种类，
//但要根据规格
#include <ansi.h>
inherit NPC;

//四样基本功夫
string *stdskillclass=({"unarmed","dodge","force","sword"});

string *shaolinskillclass  =({"jingang-quan",   "shaolin-shenfa", "yijinjing",      "wuying-jian"});
string *wudangskillclass   =({"taiji-quan",     "tiyunzong",      "taiji-shengong", "taiji-jian"});
string *daliskillclass     =({"six-finger",     "tiannan-step",   "kurong-changong","duanjia-sword"});
string *emeiskillclass     =({"jinding-zhang",  "zhutian-bu",     "linji-zhuang",   "huifeng-jian"});
string *murongskillclass   =({"canhe-zhi",      "yanling-shenfa", "shenyuan-gong",  "murong-jianfa"});
string *xueshanskillclass  =({"yujiamu-quan",   "shenkong-xing",  "xiaowuxiang",    "huoyan-dao"});
string *gaibangskillclass  =({"xianglong-zhang","xiaoyaoyou",     "huntian-qigong", "dagou-bang"});
string *taohuaskillclass   =({"luoying-zhang",  "anying-fuxiang", "bibo-shengong",  "luoying-shenjian"});
string *mingjiaoskillclass =({"qishang-quan",   "qingfu-shenfa",  "jiuyang-shengong","shenghuo-ling"});
string *gumuskillclass     =({"anranxiaohun-zhang","yunv-shenfa", "xiantian-qigong", "xuantie-sword"});
string *xiaoyaoskillclass  =({"liuyang-zhang",  "lingboweibu",    "beiming-shengong","ruyi-dao"});
string *riyueskillclass    =({"kuihua-dafa",    "kuihua-feiying", "kuihua-xinfa",    "pixie-jian"});
string *masterskillclass   =({"houquan",       "lingboweibu",    "taixuan-gong",     "hujia-daofa"});
string *quanzhenskillclass  =({"haotian-zhang","lingboweibu",    "xiantian-qigong",  "quanzhen-jian"});

int set_std_skills (int level,object ob)
{
   ob->set_skill("unarmed",level);
   ob->set_skill("finger",level);
   ob->set_skill("strike",level);
   ob->set_skill("dodge",level);
   ob->set_skill("parry",level);
   ob->set_sklll("force",level);
  }

int set_guai_skills (int level,object ob,string *str)
{
   int i;
   for (i=0;i<4;i++)
    {
      ob->set_skill(str[i],level);
      ob->map_skill(stdskillclass[i],str[i]);
      if(i==0){
       ob->map_skill("finger",str[i]);
       ob->map_skill("strike",str[i]);
          }
      if(i==3)
//激发武功
      {
      ob->map_skill("blade",str[i]);
      ob->map_skill("parry",str[0]);
//由于可能parry不能被激发为兵器武功，需要激发parry为掌法
      ob->map_skill("parry",str[i]);
      }
  }       
} 
int set_shaolin_guai (int level,object ob)
{  
   set_guai_skills(level,ob,shaolinskillclass);
   ob->set("gender","男性");
   set("chat_chance", 30);
   set("chat_msg", ({    
               (: command("get sword"):),
               (: command("wield sword"):),
   }) );
     ob->set("chat_msg_combat", ({
      (: exert_function, "force.powerup" :),
      (: exert_function, "force.roar":),
      (: perform_action, "sword.wuying":),
      (: perform_action, "sword.lidichenfo" :),
      }) );
}
int carry_shaolin_weapon()
{
     carry_object("/quest/jinyongjob/sword")->wield();
    carry_object("/quest/jinyongjob/armor")->wear();
}

int set_wudang_guai(int level,object ob)
{  
   set_guai_skills(level,ob,wudangskillclass);
   ob->set("gender","男性");
     set("chat_chance", 50);
     set("chat_msg", ({    
               (: command("get sword"):),
               (: command("wield sword"):),
               (: command("enable parry taiji-quan"):),
               (: command("enable parry taiji-jian"):),
   }) );
     ob->set("chat_msg_combat", ({
      (: exert_function, "force.powerup":),
      (: exert_function, "force.taiji":),
      (: perform_action, "sword.chan":),
      (: perform_action, "sword.chanup":),
      (: perform_action, "sword.lian":),
      (: perform_action, "sword.sui":),
    }) );


}
int carry_wudang_weapon()
{
     carry_object("/quest/jinyongjob/sword")->wield();
    carry_object("/quest/jinyongjob/armor")->wear();
}


