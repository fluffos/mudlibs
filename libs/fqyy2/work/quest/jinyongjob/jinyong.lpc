}

void init() {
  object who;
  ::init();
  add_action("do_bihua", "bihua");
  add_action("do_yun", "yun");
  add_action("do_yun", "exert");
  add_action("do_kill", "kill");
  add_action("do_kill", "hit");
  add_action("do_kill", "touxi");
  add_action("do_kill", "steal");
  add_action("do_kill", "ansuan");
  add_action("do_fight", "perform");
  add_action("do_bihua", "bihua");
  add_action("do_kill", "fight");
  add_action("do_halt", "halt");
  add_action("do_halt", "h");
  add_action("do_findbook", "findbook");

  if (interactive(who = this_player()) && !who->is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, who);
  }

}

int do_yun(string arg) {
  if (arg == "roar") {
    write(this_player()->query("name") + "，专心比武吧！\n");
    return 1;
  }
  return 0;
}

int do_findbook(object ob) {
  object me = this_player();
  string name, new_name;
  int exp, pot, score, i;
  if (present(
    "ldji",
    me
  ) && present(
    "bmxxfeng",
    me
  ) && present(
    "sdyxz",
    me
  ) && present(
    "tlbb",
    me
  ) && present(
    "lcjue",
    me
  ) && present(
    "xsfh",
    me
  ) && present(
    "fhwz",
    me
  ) && present(
    "yyblade",
    me
  ) && present(
    "bxsword",
    me
  ) && present(
    "yttlj",
    me
  ) && present("xkx", me) && present("sdxl", me) && present("sjec", me) && present("xajh", me)) {
    destruct(present("ldji", me));
    destruct(present("bmxxfeng", me));
    destruct(present("xdxyz", me));
    destruct(present("tlbb", me));
    destruct(present("lcjue", me));
    destruct(present("xsfh", me));
    destruct(present("fhwz", me));
    destruct(present("yyblade", me));
    destruct(present("bxsword", me));
    destruct(present("yttlj", me));
    destruct(present("xkx", me));
    destruct(present("sdxl", me));
    destruct(present("sdyxz", me));
    destruct(present("sjec", me));
    destruct(present("xajh", me));
    command("say 好吧，既然你帮我找到了所有的神书，难为你" +
      "如此辛苦跑来，我不会亏待你的。");
    exp = 4000 + random(6000);
    pot = exp / 5;
    score = random(5000);
    me->add("combat_exp", exp);
    me->add("potential", pot);
    //        me->add("score",score);
    tell_object(me, "你被奖励了：\n" +
      chinese_number(exp) + "点实战经验\n" +
      chinese_number(pot) + "点潜能\n");
    i = random(6);
    if (i > 4) {
      if (me->query("per") < 200) {
        me->add("per", 1); tell_object(me, HIM "以及一点容貌。\n" NOR);
      }
      //	me->add("per",0);tell_object(me,HIM"以及零点容貌。\n"NOR);
    } else if (i > 3) {
      if (me->query("dex") < 200) {
        me->add("dex", 1); tell_object(me, HIM "以及一点身法。\n" NOR);
      }
      //	me->add("dex",0);tell_object(me,HIM"以及零点身法。\n"NOR);
    } else if (i > 2) {
      if (me->query("str") < 200) {
        me->add("str", 1); tell_object(me, HIC "以及一点臂力。\n" NOR);
      }
      //	me->add("str",0);tell_object(me,HIM"以及零点臂力。\n"NOR);
    } else if (i > 1) {
      if (me->query("int") < 200) {
        me->add("int", 1); tell_object(me, HIR "以及一点悟性。\n" NOR);
      }
      //	me->add("int",0);tell_object(me,HIM"以及零点悟性。\n"NOR);
    } else if (i > 0) {
      if (me->query("con") < 200) {
        me->add("con", 1); tell_object(me, HIM "以及一点根骨。\n" NOR);
      }
      //	me->add("con",0);tell_object(me,HIM"以及零点根骨。\n"NOR);
    } else {
      if (me->query("kar") < 200) {
        me->add("kar", 1); tell_object(me, HIM "以及一点福缘。\n" NOR);
      }
      //	me->add("kar",0);tell_object(me,HIM"以及零点福缘。\n"NOR);
    }

    command("chat* haha");
    command("chat " + me->name(1) + "，难为你帮我找齐失散多年的天书，很高兴奖励你\n" HIY
      +chinese_number(exp) + HIC "点经验，" + HIY + chinese_number(pot) + HIC "点潜能!\n
另赋予你随机先天属性一点！\n");
  } else
    command("say 你身上哪里有所有的神书!");
  return 1;
}

int do_fight(string arg) {
  if (arg == "cimu") return notify_fail("由于[刺目]会影响别人行动能力，这里不能使用。\n");
  return 0;
}
int do_bihua(string arg) {
  object ob1, ob2;
  object old_target;

  ob1 = this_player();

  if (!arg || arg == "") return 0;

  if (arg == "jin yong") {
    command("say " + "你不能跟我比划！\n");
    return 1;
  }

  if (this_object()->query_temp("busy"))
    return notify_fail("每次只能有两人参加比武。\n");

  if (!ob2 = present(arg, environment(ob1)))
    return notify_fail("你想跟谁比划？\n");
  if (ob1 == ob2) return notify_fail("你不能攻击自己。\n");
  if (!userp(ob2)) return notify_fail("你只能跟玩家比划。\n");
  if (ob1->query("max_qi") > ob1->query("qi"))
    return notify_fail("你受伤太重不能比武。\n");
  if (ob1->query("max_qi") > ob1->query("eff_qi"))
    return notify_fail("你受伤太重不能比武。\n");
  if (ob2->query("max_qi") > ob2->query("qi"))
    return notify_fail("对方受伤太重不能比武。\n");
  if (ob2->query("max_qi") > ob2->query("eff_qi"))
    return notify_fail("对方受伤太重不能比武。\n");
  // 允许玩家自比
  /*   
     command("say " + "比武要裁判发令才开始！\n");
        return 1;
*/

  if (userp(ob2) && (object)ob2->query_temp("pending/fight") != ob1) {
    message_vision("\n$N对着$n说道"
      +RANK_D->query_self(ob1)
      +ob1->name() + "领教"
      +RANK_D->query_respect(ob2) + "的高招!\n\n", ob1, ob2);
    if (objectp(old_target = ob1->query_temp("pending/fight")))
      tell_object(old_target, YEL + ob1->name() + "取消了和你比试的念头。\n" NOR);
    ob1->set_temp("pending/fight", ob2);
    tell_object(
      ob2,
      YEL "如果你愿意和对方进行比试请你也对" + ob1->name() + "(" + (string)ob1->query("id") + ")" + "下一次 bihua 指令。\n" NOR
    );

    write(YEL "由於对方是由玩家控制的人物你必须等对方同意才能进行比试。\n" NOR);
    return 1;
  }

  ob1->delete_temp("halted");
  ob2->delete_temp("halted");

  //      ob1->set("qi",(int)ob1->query("max_qi"));
  //      ob2->set("qi",(int)ob2->query("max_qi"));

  remove_call_out("fighting");
  call_out("fighting", 2, ob1, ob2);

  remove_call_out("check");
  call_out("check", 2, ob1, ob2);
  return 1;
}

void fighting(object ob1, object ob2) {
  ob1->fight_ob(ob2);
  ob2->fight_ob(ob1);
}

void check(object ob1, object ob2) {
  this_object()->set_temp("busy", 1);

  message("channel:chat", HIC "【闲聊】金庸(Jin Yong)：" + ob1->query("name") + "(" + ob1->query("id") + ")"
    + "与" + ob2->query("name") + "(" + ob2->query("id") + ")" + "现在" + WHT "比武台" NOR + HIC "上开始比武论剑！\n" NOR, users());
  call_out("observe", 1, ob1, ob2);
}


int observe(object ob1, object ob2) {

  object ob;
  int i, j, k;
  int lost, win;
  if (ob1->is_fighting()) {
    call_out("observe", 1, ob1, ob2);
    return 1;
  }
  this_object()->delete_temp("busy");
  ob1->delete_temp("pending/fight");
  ob2->delete_temp("pending/fight");
  if (!present(ob1, environment())) {
    command("chat " + ob1->query("name") + "落荒而逃了！\n");
    return 1;
  }
  if (!present(ob2, environment())) {
    command("chat " + ob2->query("name") + "落荒而逃了！\n");
    return 1;
  }
  if (ob1->query_temp("halted")) {
    ob1->delete_temp("halted");
    command("chat " + ob1->query("name") +
      "中途放弃比武！\n");
    return 1;
  }
  if (ob2->query_temp("halted")) {
    ob2->delete_temp("halted");
    command("chat " + ob2->query("name") +
      "中途放弃比武！\n");
    return 1;
  }

  if (ob1->query("qi") * 2 > ob1->query("max_qi")) {
    if (ob2->query("qi") * 2 > ob2->query("max_qi")) {
      command("chat " + ob1->query("name")
        + "与" + ob2->query("name") + "比武不分胜负！\n");
      return 1;
    }
    command("chat " + ob1->query("name")
      + "比武战胜" + ob2->query("name") + "！\n");

    ob1->set_temp("marks/win", 1);
    //   call_out("log_positions",1,ob1,ob2);$
  } else {
    command("chat " + ob2->query("name")
      + "比武战胜" + ob1->query("name") + "！\n");

    ob2->set_temp("marks/win", 1);
    //  call_out("log_positions",1,ob1,ob2);
  }
  return 1;

}

void log_positions(object ob1, object ob2) {
  string winname, lostname, winid, lostid;
  int i, win, lost;
  object obj;
  if (ob2->query_temp("marks/win")) {
    obj = ob2;
    winid = ob2->query("id");
    winname = ob2->query("name");
    lostid = ob1->query("id");
    lostname = ob1->query("name");
  }
  if (ob1->query_temp("marks/win")) {
    obj = ob1;
    winid = ob1->query("id");
    winname = ob1->query("name");
    lostid = ob2->query("id");
    lostname = ob2->query("name");
  }
  list = explode(read_file("/data/ladder.txt"), "\n");
  lost = member_array(lostid, list);
  win = member_array(winid, list);
  tmp = "";


  if (lost < win && lost != -1) {
    list[lost] = winid;
    list[lost + 1] = winname + "\n" + lostid + "\n" + lostname;

    for (i = 0; i < sizeof(list); i++)
      if ((i == win) || (i == win + 1)) tmp += "";

    else tmp += list[i] + "\n";
  } else if (lost == -1 && win == -1) {
    for (i = 0; i < sizeof(list); i++) tmp += list[i] + "\n";
    tmp += winid + "\n" + winname + "\n" + lostid + "\n" + lostname + "\n";

  } else if (lost != -1 && win == -1) {
    list[lost] = winid;
    list[lost + 1] = winname + "\n" + lostid + "\n" + lostname;

    for (i = 0; i < sizeof(list); i++)

      tmp += list[i] + "\n";

  } else {
    for (i = 0; i < sizeof(list); i++)

      tmp += list[i] + "\n";
  }

  rm("/data/ladder.txt");
  write_file("/data/ladder.txt", tmp);
  list = explode(read_file("/data/ladder.txt"), "\n");
  win = member_array(winid, list);
  message(
    "channel:chat",
    HIC "【闲聊】金庸(Jin Yong)：恭喜" + winname + "(" + winid + ")" + "荣获" + HIY "「侠客英雄谱」" NOR + HIC "第" + chinese_number((win + 1) / 2 + 1) + "名！\n" NOR,
    users()
  );
}

int do_halt() {
  object me = this_player();
  if (me->is_fighting())
    me->set_temp("halted", 1);
  return 0;
}

int do_kill(string arg) {
  write("你只能用bihua <id>进行比划，用halt放弃。\n");
  return 1;
}

void greeting(object who) {
  if (!who || environment(who) != environment()) return;
  if ((int)who->query("combat_exp") < 1000) {
    switch (random(3)) {
      case 0: command("hi " + (string)who->query("id")); break;
      case 1: command("welcome " + (string)who->query("id")); break;
      case 2: command("bow " + (string)who->query("id")); break;
      case 3: command("whisper " + (string)who->query("id") + " 要领任务? 向我打听kill的消息就可以了!"); break;
    }

  } else
    say("金庸对说道:这位" + RANK_D->query_respect(who) +
      ",别来无恙啊。\n");
  if (random(40) > 20)
    command("sigh");
  return;
}

int max_skill_level(object ob) {
  int s, i = 0, maxlevel = 1;
  string *str;
  userskills = ob->query_skills();
  if (!mapp(userskills)) { maxlevel = 3; return maxlevel; }
  str = keys(userskills);

  s = sizeof(str);
  if (s < 2) return userskills[str[0]];
  while (s > 0) {
    s -= 1;
    i = userskills[str[s]];
    if (i > maxlevel) maxlevel = i;
  }
  return maxlevel;
}

int accountlevel(int turn, object ob) {
  int level;
  level = max_skill_level(ob);
  level = (int)level * (70 + turn * 4) / 100;
  if (level == 0) level = 1;
  return level;
}

string randomlocation(int i1) {
  string *str1, *str2, loca;
  int i2, temp;
  str1 = keys(allloca);
  str2 = allloca[str1[i1]];
  i2 = sizeof(str2);
  temp = random(i2);
  if (temp == 0 || temp == i2) temp = 1;
  loca = str2[0] + str2[temp];
  return loca;
}

int give_quests() {
  object guaiob;
  object me, who, tempob;
  int chooseguai, rewardpot, rewardexp, turn;
  int questbusytime, giveuptime, guailevel;
  int temp, i1;
  string guaiid;
  string *strtemp, locastr;
  me = this_object();
  who = this_player();
  giveuptime = who->query_temp("questtime2");
  questbusytime = who->query_temp("questtime1");
  turn = who->query_temp("turn");
  if (me->query_temp("pending/exercise")) {
    write("金庸正在修炼内功，可能没时间理你!\n");
    return 1;
  }
  if (who->query_temp("kill")) {
    if (time() < giveuptime) {
      message_vision("$N对$n说道：这位" + RANK_D->query_respect(who)
        + "，在下不是请您去杀掉" + who->query_temp("guainame") + "吗？\n", me, who);
      return 1;
    } else turn -= 2;
  } else {
    if (time() < questbusytime) {
      message_vision("$N看了看你,面带微笑的对$n说道：\n"
        + "这位" + RANK_D->query_respect(who) + ",坏人已经除尽，不妨先去歇息。\n"
        , me, who);
      return 1;
    }
  }

  //每十个任务一轮，用turn 做参数
  if (!turn || turn > 9) {
    who->set_temp("turn", 0);
    turn = 0;
  }
  turn = turn + 1;
  who->set_temp("turn", turn);
  guailevel = accountlevel(turn, who);
  guaiob = new(__DIR__ "questguai_n");


  guaiob->set_heart_beat(1);
  guaiob->set_temp("killername", (string)who->query("id"));

  //设置怪的jingli,neili,exp,
  //        set_guai_qi_jing(turn,who);
  guaiob->set("max_neili", guaif(turn, who));
  guaiob->set("neili", (int)(guaif(turn, who) * 6 / 5));
  guaiob->set("max_jingli", guaim(turn, who));
  guaiob->set("jingli", (int)(guaim(turn, who) * 6 / 5));
  guaiob->set("combat_exp", accountguaiexp(turn, who));
  guaiob->set("neili_factor", (int)(guailevel / 2));
  guaiob->set("jiali", (int)who->query_skill("force") / 4);
  guaiob->set("int", (int)who->query_int());
  guaiob->set("str", (int)who->query_str());
  guaiob->set("spi", (int)who->query_spi());
  guaiob->set("con", (int)who->query_con());
  guaiob->set("per", (int)who->query_per());
  guaiob->set("kar", (int)who->query_skill("kar"));
  guaiob->set("jingli_factor", (int)(guailevel / 2));
  set_guai_qi_jing(turn, guaiob);

  //set guai's "long" and "title" 
  switch (random(3)) {
    case 1:
      if (guaiob->query("combat_exp") > 100000)
        guaiob->set("long", "一个绿林高手,听说出师于星宿派，是" HIR
          +who->query("name") + NOR "的目标\n");
      else guaiob->set("long", "绿林人物" + guaiob->query("name")
        + ",听说是星宿派的高手，颇有些本领。\n");
      break;
    case 2:
      if (guaiob->query("combat_exp") > 100000)
        guaiob->set("long", "一个黑道高手,听说来自于一个神秘的组织，是" HIR
          +who->query("name") + NOR "的目标\n");
      else guaiob->set("long", "黑道人物" + guaiob->query("name")
        + "他全身散发出一丝邪气。\n");
      break;
    default:
      guaiob->set("long", "武当叛徒" + guaiob->query("name")
        + "，他混身上下杀气逼人。\n");
  }
  chooseguai = random(14);
  setguaititle(chooseguai, guaiob);
  guaiid = CYN + who->name() + HIR + "追杀的" + NOR + guaiob->query("title");
  guaiob->set("title", guaiid);
  //rewardexp and rewardpot 是杀怪后得到的qn and exp
  rewardexp = 3000 + random(1000);
  rewardpot = 1000 + random(1000);
  guaiob->set_temp("killrewardpot", rewardpot);
  guaiob->set_temp("killrewardexp", rewardexp);
  guaiob->set_temp("player", who);
  guaiob->setguaiskill(chooseguai, guailevel, guaiob);
  guaiob->check_time();
  //确定怪的位置 
  strtemp = keys(allloca);
  i1 = sizeof(strtemp);
  temp = random(i1);
  if (temp == i1) temp = 0;
  locastr = randomlocation(temp);
  tempob = load_object(locastr);
  //if we get a wrong path,these can help us 
  if (!tempob) {
    message_vision(HIR "$N发现好象并没有:" + locastr
      + "这个房间，请向通知小兔子，并再要一次任务\n" NOR, who);
    return 1;
  }
  guaiob->move(tempob);
  //设置玩家的暂时参数
  who->set_temp("questtime1", time() + 60);
  who->set_temp("questtime2", time() + 600);
  who->set_temp("guainame", guaiob->query("name"));
  who->set_temp("turn", turn);
  who->set_temp("kill", 1);
  message_vision("$N微笑着对$n说道：请这位" + RANK_D->query_respect(who)
    + "替我除掉在" + strtemp[temp] + "出没的" +
    YEL + guaiob->query("name") + "(" +
    guaiob->query("id") + ")" + NOR ", 老夫必有重谢！\n", me, who);
  return 1;
}

int accountguaiexp(int turn, object who) {
  int userexp, guaiexp;
  userexp = who->query("combat_exp");
  guaiexp = userexp * (70 + turn * 6) / 100;
  return guaiexp;
}
// guaif 计算怪的内力
int guaif(int turn, object who) {
  int userneili, guaineili;
  userneili = who->query("max_neili");
  guaineili = userneili * (70 + turn * 5) / 80;
  return guaineili;
}
int guaim(int turn, object who) {
  int userjingli, guaijingli;
  userjingli = who->query("max_jingli");
  guaijingli = userjingli * (70 + turn * 5) / 80;
  return guaijingli;
}

int set_guai_qi_jing(int turn, object guai) {
  int maxqi, maxjing;
  maxqi = 200 + (int)guai->query("max_neili") * (200 + turn * 50) / 100;

  maxjing = 200 + (int)guai->query("max_jingli") * (200 + turn * 50) * 4 / 400;
  guai->set_temp("maxqi", maxqi);
  guai->set("max_qi", maxqi);
  guai->set("eff_qi", maxqi);
  guai->set("qi", maxqi);
  guai->set("max_jing", maxjing);
  guai->set("eff_jing", maxjing);
  guai->set("jing", maxjing);
  return 1;
}
//杀怪得到的exp,与玩家的skills ,exp,turn 有关
int getexp(int turn, int level, object who) {
  int exp, userexp;
  userexp = who->query("combat_exp");
  if (turn < 1) turn = 1;
  exp = random(1000) + turn * 2000 + (userexp / 5000) * turn + (level * level / 2000) * turn * 1000;
  return exp;
}

string setguaititle(int number, object guaiob) {
  if (random(10) > 7) {
    if (guaiob->query("combat_exp") > 2000000)
      guaiob->set("title", "杀人狂魔");
    else if (guaiob->query("combat_exp") > 1000000)
      guaiob->set("title", "恶贯满盈");
    else if (guaiob->query("combat_exp") > 500000)
      guaiob->set("title", "江洋大盗");
    else if (guaiob->query("combat_exp") > 100000)
      guaiob->set("title", "大盗");
    else if (guaiob->query("combat_exp") > 50000)
      guaiob->set("title", "采花贼");
    else if (guaiob->query("combat_exp") > 10000)
      guaiob->set("title", "流氓头");
    else if (guaiob->query("combat_exp") > 5000)
      guaiob->set("title", "流氓");
    else guaiob->set("title", "小流氓");
  } else {
    switch (number) {
      case 0: guaiob->set("title", "古墓魔女"); break;
      case 1: guaiob->set("title", "峨嵋恶尼"); break;
      case 2: guaiob->set("title", "全真恶道"); break;
      case 3: guaiob->set("title", "武当贼道"); break;
      case 4: guaiob->set("title", "少林恶僧"); break;
      case 5: guaiob->set("title", "白驼淫贼"); break;
      case 6: guaiob->set("title", "丐帮叛徒"); break;
      case 7: guaiob->set("title", "华山恶龙"); break;
      case 8: guaiob->set("title", "星宿老魔"); break;
      case 9: guaiob->set("title", "明教暴徒"); break;
      case 10: guaiob->set("title", "神龙恶徒"); break;
      case 11: guaiob->set("title", "桃花岛弃徒"); break;
      case 12: guaiob->set("title", "逍遥派奸贼"); break;
      case 13: guaiob->set("title", "雪山喇嘛"); break;
      default: guaiob->set("title", "小贼"); break;
    }
  }
}




