// NPC: waiter.c 游乐场服务员
// derondog@ZLZY

inherit NPC;
#include <ansi.h>

int NUM, TIME;

void create() {
  set_name("服务员", ({ "waiter" }));
  set("gender", "男性");
  set("age", 25);
  set("long", "一个游乐场的服务员，正笑嘻嘻地看着你。\n");

  set("combat_exp", 7000);

  setup();
  carry_object("/clone/misc/cloth")->wear();
}

void init() {
  add_action("do_guess", "guess");
}

int do_guess(string arg) {
  int num, exp, pot, i;
  object me, ob;
  exp = 10000;
  me = this_player();
  ob = this_object();

  if (ob->query_temp("paid") != me->query("id"))
    return notify_fail(CYN "服务员不高兴地对" + me->name(1) + "说道：你还没交钱呢！\n" NOR);

  if (!ob->query_temp("start"))
    return notify_fail(CYN "服务员对" + me->name(1) + "笑道：别着急啊，我还没抽卡片呢！\n" NOR);

  if (!arg || !sscanf(arg, "%d", num))
    return notify_fail("猜数字的格式为" + CYN + "guess number。\n比如：guess 77\n" NOR);

  if (num < 1 || num > 100)
    return notify_fail("服务员笑了笑，说道：数字只从１到１００。\n");

  TIME++;

  if (TIME > 15) {
    message_vision(CYN "$N对$n说道：你真笨啊！猜了那么多次都猜不对。" +
      HIR "\n交钱重新来过吧。\n" NOR, ob, me);
    ob->delete_temp("paid");
    ob->delete_temp("start");
    return 1;
  }
  message_vision(CYN "$N自信地说道：" + WHT + num + "。\n", me);
  if (num - NUM >= 50)
    message_vision(CYN "$N对$n说道：" + HIR + "您猜的数字太大了。\n" NOR, ob, me);
  else if (num - NUM >= 25)
    message_vision(CYN "$N对$n说道：" + HIY + "您猜的数字大了点。\n" NOR, ob, me);
  else if (num > NUM)
    message_vision(CYN "$N对$n说道：" + HIC + "您猜的数字大了点点。\n" NOR, ob, me);
  else if (num - NUM < -50)
    message_vision(CYN "$N对$n说道：" + HIR + "您猜的数字太小了。\n" NOR, ob, me);
  else if (num - NUM < -25)
    message_vision(CYN "$N对$n说道：" + HIY + "您猜的数字小了点。\n" NOR, ob, me);
  else if (num < NUM)
    message_vision(CYN "$N对$n说道：" + HIC + "您猜的数字小了点点。\n" NOR, ob, me);
  else {
    message_vision(CYN "$N对$n说道：" + HIG + "恭喜您猜对了。\n" +
      HIW + "你一共猜了" + chinese_number(TIME) + "次。这是给你的奖励。\n" NOR, ob, me);
    ob->delete_temp("paid");
    ob->delete_temp("start");
    for (i = 0; i < TIME; i++)
      exp /= 2;
    if (exp > 1000) exp = 1000;
    pot = exp / 2 + random(exp / 2);
    tell_object(me, sprintf(HIW "你获得了：\n%d点实战经验，%d点潜能\n" NOR, exp, pot));
    me->add("combat_exp", exp);
    me->add("potential", pot);
  }
  return 1;

}

int start() {
  this_object()->set_temp("start", 1);
  message_vision(CYN "$N从盒子里抽出一张卡片，笑道：您可以开始猜了(guess)。\n" NOR, this_object());
  NUM = random(100) + 1;
  TIME = 0;
  return NUM;
}

int accept_object(object me, object ob) {
  if (me->query("combat_exp") > 100000) {
    message_vision(CYN "$N对$n说道：对不起，您已经是武林高手了，不能再玩这种游戏啦。\n" NOR, this_object(), me);
    return 0;
  }
  if (this_object()->query_temp("paid")) {
    message_vision(CYN "$N对$n说道：对不起，已经有人再玩了，请您稍等。\n" NOR, this_object(), me);
    return 0;
  }
  if (ob->query("money_id") && ob->value() >= 10000) {
    command("say 谢谢惠顾！下面我来介绍一个游戏规则：
盒子里有100张卡片，上面分别写数字1，2，3，……，100。
我会从这100张卡片里任意抽出一张，而你则开始猜(guess)这张卡上的数字是多少！
不管你猜大了还是小了，我都会告诉你，然后你继续猜，直到你猜对为止！" +
      HIG "\n我会根据你猜的次数，给你不同的奖励。" NOR);
    this_object()->set_temp("paid", me->query("id"));
    remove_call_out("start");
    call_out("start", 5);
    return 1;
  }
  return 0;
}
