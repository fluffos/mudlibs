// dealer.c 商人
// This is a inheritable object.
// Each dealer should support buy, sell, list, value 4 commands

#include <dbase.h>
#include <ansi.h>

string value_string(int value) {
  if (value < 1) value = 1;
  else if (value < 100)
    return chinese_number(value) + "文钱";
  else
    return chinese_number(value / 100) + "两白银"
      +(value % 100 ? "又" + chinese_number(value % 100) + "文钱" : "");
}

string is_vendor_good(string arg) {
  string *goods;
  object ob;
  int i;

  if (arrayp(goods = query("vendor_goods")))
    for (i = 0; i < sizeof(goods); i++)
      if (goods[i]->id(arg))
        return goods[i];
  return "";
}

int do_value(string arg) {
  object ob;
  int value;

  if (!arg || !(ob = present(arg, this_player())))
    return notify_fail("你要估什么的价？\n");

  if (ob->query("money_id"))
    return notify_fail("你没用过钱啊？\n");
  value = ob->query("value");
  if (value < 1)
    write(ob->query("name") + "一文不值！\n");
  else
    write(ob->query("name") + "值" +
      MONEY_D->price_str(value * 70 / 100) + "。\n");
  return 1;
}

int do_sell(string arg) {
  object ob;
  int value, oldnum;
  object *inv, sellbox;
  string index;
  if (!arg || !(ob = present(arg, this_player())))
    return notify_fail("你要卖什么？\n");

  if (ob->query("money_id"))
    return notify_fail("你想卖「钱」？？\n");

  if (stringp(ob->query("no_drop")))
    return notify_fail("这样东西不能卖。\n");

  if (is_vendor_good(arg) != "")
    return notify_fail("卖给你好不好？\n");

  if (ob->query("food_supply"))
    return notify_fail("剩菜剩饭留给您自己用吧。\n");
  if (ob->query("material") == "ice")
    return notify_fail("掌柜的说：冰的东西我们这里没法存放。\n");
  if (ob->query("shaolin"))
    return notify_fail("小的只有一个脑袋，可不敢买少林庙产。\n");

  if (ob->query("mingjiao"))
    return notify_fail("小的只有一个脑袋，可不敢买魔教的东西。\n");

  value = ob->query("value");
  if (value < 30)
    write(ob->query("name") + "一文不值！\n");
  else {
    message_vision("$N卖掉了一" + ob->query("unit") +
      ob->query("name") + "给$n。\n", this_player(), this_object());
    MONEY_D->pay_player(this_player(), value * 70 / 100);
    if (value < 50)
      destruct(ob);
    else  //rewrite by rabbit 2000/10/17
    {
      if (!(sellbox = present("treasure box", this_object()))) {
        sellbox = new("/clone/misc/shopbox");
        sellbox->move(this_object());
      }
      index = ob->query("name") + "(" + ob->query("id") + ")";
      ob->move(sellbox);
      if (sellbox->query_temp("goods/" + index) == 0) {
        sellbox->set_temp("goods/" + index, ob);
        sellbox->set_temp("numbers/" + index, 1);
      } else {
        oldnum = sellbox->query_temp("numbers/" + index);
        sellbox->set_temp("numbers/" + index, oldnum + 1);
      }

    }
  }
  return 1;
}

int do_list() {
  mapping goods;
  string list, *name;
  object sellbox;
  int i, turn = 0;
  string tlist;
  object me = this_player();

  if (!(sellbox = present("treasure box", this_object()))) {
    sellbox = new("/clone/misc/shopbox");
    sellbox->move(this_object());
  }

  if (!mapp(goods = sellbox->query_temp("goods")))
    return notify_fail("当铺目前没有任何货物可卖。\n");
  name = keys(goods);
  if (!sizeof(goods))
    return notify_fail("当铺目前没有任何货物可卖。\n");
  {
    list = "你可以购买下列这些东西：\n";
    //    write(list);
    i = sizeof(goods);
    while (i--) {
      if (!goods[name[i]]) {
        sellbox->delete_temp("numbers/" + name[i]);
        sellbox->delete_temp("goods/" + name[i]);
        continue;
      }
      tlist = name[i];
      ++turn;
      list += sprintf("%-3d %-30s：%-20s：还剩%s%s\n", turn, tlist,
        value_string(goods[name[i]]->query("value")),
        chinese_number(sellbox->query_temp("numbers/" + name[i])),
        goods[name[i]]->query("unit"));

    }
    me->start_more(list);
  }
  return 1;
}

int do_buy(string arg) {
  int value, val_factor, oldnum;
  string ob_file;
  object ob, sellbox;
  //	mapping fam;

  if (!(sellbox = present("treasure box", this_object()))) {
    sellbox = new("/clone/misc/shopbox");
    sellbox->move(this_object());
  }

  //      if ( (fam = this_player()->query("family")) && fam["family_name"] == "丐帮" ) 
  //		return notify_fail("你是个穷叫化，买什麽东西！\n");

  if (!arg)
    return notify_fail("你想买什么？ \n");
  else if (!(ob = present(arg, sellbox)))
    if ((ob_file = is_vendor_good(arg)) == "")
      return notify_fail("你想买什么？ \n");

  if (!ob) {
    ob = new(ob_file);
    val_factor = 10;
  } else {
    if (ob->query("equipped"))
      return notify_fail("你想买什么？ 3\n");
    val_factor = 12;
  }

  if (query_temp("busy"))
    return notify_fail("哟，抱歉啊，我这儿正忙着呢……您请稍候。\n");


  switch (MONEY_D->player_pay(this_player(), ob->query("value") * val_factor / 10)) {
    case 0:
      return notify_fail("穷光蛋，一边呆着去！\n");
    case 2:
      return notify_fail("您的零钱不够了，银票又没人找得开。\n");
    default:
      set_temp("busy", 1);
      message_vision("$N从$n那里买下了一" + ob->query("unit") +
        ob->query("name") + "。\n", this_player(), this_object());
      ob->move(this_player());
      arg = ob->query("name") + "(" + ob->query("id") + ")";
      oldnum = sellbox->query_temp("numbers/" + arg);
      if (oldnum == 1) {
        sellbox->delete_temp("numbers/" + arg);
        sellbox->delete_temp("goods/" + arg);
      }
      sellbox->set_temp("numbers/" + arg, oldnum - 1);
  }
  this_player()->start_busy(2);
  remove_call_out("enough_rest");
  call_out("enough_rest", 1);

  return 1;
}

void enough_rest() {
  delete_temp("busy");
}


void unconcious() {
  object ob = this_object();
  ob->set("qi", ob->query("max_qi"));
  ob->set("jing", ob->query("max_jing"));
  message_vision("明明$N快晕倒了,但是由于聚宝盆的法力，$N又站起来了。\n", ob);
  return;
}
