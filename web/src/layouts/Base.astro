---
import '../styles/museum.css';

interface Props {
  lang: string;
  title: string;
  description: string;
  canonical: string;
  ogLocale: string;
  siteName: string;
  jsonld: string;
  bodyClass?: string;
}
const {
  lang,
  title,
  description,
  canonical,
  ogLocale,
  siteName,
  jsonld,
  bodyClass = '',
} = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href="https://mudlibs.fluffos.info/" />
    <link rel="alternate" hreflang="zh-CN" href="https://mudlibs.fluffos.info/zh/" />
    <link rel="alternate" hreflang="x-default" href="https://mudlibs.fluffos.info/" />
    <link rel="alternate" type="text/plain" title="llms.txt" href="https://mudlibs.fluffos.info/llms.txt" />
    <link rel="alternate" type="application/json" title="games.json" href="https://mudlibs.fluffos.info/games.json" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/assets/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content="https://mudlibs.fluffos.info/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://mudlibs.fluffos.info/og-image.png" />
    <script type="application/ld+json" set:html={jsonld} />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('museum-theme');
          if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
    <link rel="stylesheet" href="/assets/pico.min.css" />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
