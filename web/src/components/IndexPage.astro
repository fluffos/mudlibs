---
import Base from '../layouts/Base.astro';
import Card from './Card.astro';
import type { MuseumIndex } from '../lib/museum';

interface Props {
  index: MuseumIndex;
}
const { index: idx } = Astro.props;
---
<Base
  lang={idx.html_lang}
  title={idx.page_title}
  description={idx.meta_desc}
  canonical={idx.canonical_url}
  ogLocale={idx.og_locale}
  siteName={idx.site_name}
  jsonld={idx.jsonld}
>
  <header>
    <div class="topbar">
      <div>
        {idx.crumb_html ? <div set:html={idx.crumb_html} /> : null}
        <p class="lang-switch">
          <a href={idx.lang_switch_href}>{idx.lang_switch_label}</a>
        </p>
      </div>
      <div class="engage" set:html={idx.engage_html} />
    </div>
    <h1>{idx.h1}</h1>
    <p class="intro" set:html={idx.intro_html} />
    <p class="stats" set:html={idx.stats_html} />
  </header>
  <main>
    <div class="controls">
      <input id="q" type="search" placeholder={idx.search_placeholder} autocomplete="off" />
      <button class="fbtn active" type="button" data-f="all">{idx.filter_all} {idx.n_total}</button>
      <button class="fbtn" type="button" data-f="playable">{idx.filter_playable} {idx.n_play}</button>
      <button class="fbtn" type="button" data-f="limited">{idx.filter_limited} {idx.n_lim}</button>
      <button class="fbtn" type="button" data-f="noboot">{idx.filter_noboot} {idx.n_no}</button>
    </div>
    {/* Fully prerendered — search engines see every card with no JS. */}
    <div class="grid" id="grid">
      {
        idx.clusters.map((cl) =>
          cl.cards.length === 1 ? (
            <Card card={cl.cards[0]} />
          ) : (
            <section class="lineage" data-lineage={cl.num}>
              <header class="lineage-head">
                <span class="lineage-num">#{cl.num}</span>
                <span class="lineage-name">{cl.name}</span>
                <span class="lineage-count">{cl.count_label}</span>
              </header>
              <div class="lineage-grid">
                {cl.cards.map((c) => <Card card={c} />)}
              </div>
            </section>
          ),
        )
      }
    </div>
  </main>
  <footer set:html={idx.footer_html} />
  <script is:inline>
    (function () {
      var q = document.getElementById('q');
      var cards = Array.prototype.slice.call(document.querySelectorAll('#grid .card'));
      var btns = Array.prototype.slice.call(document.querySelectorAll('.fbtn'));
      var groups = Array.prototype.slice.call(document.querySelectorAll('#grid .lineage'));
      var filter = 'all';
      function apply() {
        var needle = (q && q.value ? q.value : '').trim().toLowerCase();
        cards.forEach(function (c) {
          var okStatus = filter === 'all' || c.classList.contains(filter);
          var hay = c.getAttribute('data-search') || (c.textContent || '').toLowerCase();
          var okText = !needle || hay.indexOf(needle) >= 0;
          c.style.display = okStatus && okText ? '' : 'none';
        });
        groups.forEach(function (g) {
          var any = g.querySelectorAll('.card');
          var visible = 0;
          for (var i = 0; i < any.length; i++) {
            if (any[i].style.display !== 'none') visible++;
          }
          g.style.display = visible ? '' : 'none';
        });
      }
      if (q) q.addEventListener('input', apply);
      btns.forEach(function (b) {
        b.addEventListener('click', function () {
          btns.forEach(function (x) { x.classList.remove('active'); });
          b.classList.add('active');
          filter = b.getAttribute('data-f') || 'all';
          apply();
        });
      });
      document.querySelectorAll('.theme-toggle').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var cur = document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
          var next = cur === 'light' ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', next);
          try { localStorage.setItem('museum-theme', next); } catch (e) {}
        });
      });
    })();
  </script>
</Base>
