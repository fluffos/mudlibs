---
import type { MuseumCard } from '../lib/museum';
interface Props { card: MuseumCard }
const { card } = Astro.props;
const cls = ['card', card.status, card.linked ? 'linked' : ''].filter(Boolean).join(' ');
---
<div
  class={cls}
  data-search={card.search}
  data-slug={card.slug}
  data-name={card.name}
>
  <div class="card-head">
    <h2>
      {card.linked ? (
        <a class="play" href={`/${card.slug}/`}>{card.name}</a>
      ) : (
        card.name
      )}
    </h2>
    <span class={`badge ${card.status}`}>{card.icon} {card.badge}</span>
  </div>
  <p class="slug">{card.slug}</p>
  <p class="desc">{card.desc}</p>
  {card.meta_html ? <p class="meta" set:html={card.meta_html} /> : null}
</div>
